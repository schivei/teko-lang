type Shape = abstract class {
    pub tag: i64
    pub abstract fn kind(): i64
}
type Circle = class Shape {
    pub r: i64
    pub static fn make(rr: i64): Circle { Circle { tag = 1; r = rr } }
    pub override fn kind(): i64 { self.tag + self.r }
}
fn f(cond: bool): i64 | Shape { if cond { Circle::make(5) } else { 7 } }
