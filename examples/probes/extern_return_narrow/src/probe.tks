/**
 * The C11 aligned allocator, reached DIRECTLY as a C symbol (mirrors
 * `examples/probes/arena_bottom/src/bottom.tks::c_aligned_alloc`) — this probe's own comparison
 * buffers come from here, so it needs no compiler primitive beyond `extern fn` itself.
 *
 * @param alignment  the required base alignment in bytes; must be a power of two
 * @param size       the block size in bytes; C11 requires it to be a multiple of `alignment`
 * @return           the block's base address, or 0 on failure
 */
pub extern fn c_aligned_alloc(alignment: u64, size: u64): u64 = "aligned_alloc"

/**
 * The C deallocator, reached DIRECTLY as a C symbol — the counterpart of `c_aligned_alloc`.
 *
 * @param block  the base address returned by `c_aligned_alloc`; 0 is a documented no-op
 * @return       nothing
 */
pub extern fn c_free(block: u64) = "free"

/**
 * The C byte-fill primitive, reached DIRECTLY as a C symbol — how this probe puts a known byte
 * pattern into a block it owns.
 *
 * @param block  the base address to fill
 * @param value  the fill byte, passed in an `i32` as C's signature requires
 * @param count  how many bytes to fill
 * @return       `block`, as C's `memset` returns its destination
 */
pub extern fn c_memset(block: u64, value: i32, count: u64): u64 = "memset"

/**
 * The C block-compare primitive, reached DIRECTLY as a C symbol and declared `-> i32` — ITS TRUE
 * C return type, and the whole point of this probe. `examples/probes/arena_bottom/src/bottom.tks`
 * declares the SAME foreign function `-> u64` and extracts the true C `int` result by hand
 * (`% 2^32`), because at the time it was written the native backend did not narrow an
 * `extern fn`'s `i32` return: the callee may leave the upper 32 bits of the return register
 * unspecified (the SysV ABI permits it, and glibc's `memcmp` uses that permission). This probe
 * declares the return type `memcmp` actually has and reads it directly, with no manual bit
 * extraction — which only reads correctly once the native backend's
 * `apply_extern_return_narrow`/`narrow_extern_return` (`src/lir/lower.tks`) sign-extends the call
 * result from its low 32 bits before this probe ever reads it.
 *
 * @param left   the first block's base address
 * @param right  the second block's base address
 * @param count  how many bytes to compare
 * @return       0 when the two blocks are byte-identical over `count`; negative/positive
 *               otherwise, exactly as C's `memcmp` defines
 */
pub extern fn c_memcmp(left: u64, right: u64, count: u64): i32 = "memcmp"

/**
 * Fails loudly when an invariant does not hold, exiting with the invariant's own code so a
 * failure names itself — mirrors `examples/probes/arena_bottom/src/bottom.tks::demand`.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

/**
 * The block size both comparison buffers share.
 *
 * @return  256, an arbitrary but ample byte count
 */
pub fn block_bytes(): u64 {
    256
}

/**
 * Acquires one 16-byte-aligned block of `block_bytes()` and demands the allocator did not fail.
 * Exits 10 on a null block.
 *
 * @return  the block's base address
 */
pub fn acquire_block(): u64 {
    var block = c_aligned_alloc(16, block_bytes())
    demand(block != 0, 10)
    block
}

/**
 * Demands the direct `-> i32` comparison reads exactly 0 for two blocks filled with the SAME
 * byte: the equal-buffers case is the corpus-documented failure mode (a garbage-filled upper
 * half of the return register makes even a truly-equal `memcmp` look unequal). Exits 11 on a
 * false positive.
 *
 * @return  nothing
 */
pub fn demand_equal_blocks_compare_zero() {
    var left = acquire_block()
    var right = acquire_block()
    c_memset(left, 65, block_bytes())
    c_memset(right, 65, block_bytes())
    demand(c_memcmp(left, right, block_bytes()) == 0, 11)
    c_free(left)
    c_free(right)
}

/**
 * Demands the direct `-> i32` comparison reads NEGATIVE when the first block's fill byte is
 * numerically LESS than the second's, and POSITIVE the other way round — the sign of the C `int`
 * result must survive a raw call-result read undamaged. Exits 12 when the low-first comparison
 * is not negative, 13 when the high-first comparison is not positive.
 *
 * @return  nothing
 */
pub fn demand_unequal_blocks_carry_the_right_sign() {
    var left = acquire_block()
    var right = acquire_block()
    c_memset(left, 1, block_bytes())
    c_memset(right, 2, block_bytes())
    demand(c_memcmp(left, right, block_bytes()) < 0, 12)
    demand(c_memcmp(right, left, block_bytes()) > 0, 13)
    c_free(left)
    c_free(right)
}

/**
 * Runs the whole probe: the equal-buffers case, then both signed unequal-buffers cases. Every
 * demand exits with its own code on failure, so reaching the return value at all is the proof.
 *
 * @return  42 when the direct `i32` extern return reads correctly, with no manual narrowing
 */
pub fn probe_extern_return_narrow(): i32 {
    demand_equal_blocks_compare_zero()
    demand_unequal_blocks_carry_the_right_sign()
    42
}
