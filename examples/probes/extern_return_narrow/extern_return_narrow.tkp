# examples/probes/extern_return_narrow — the regression fixture for the native backend's
# `extern fn` return-value narrowing (cargo/20-extern-return-narrowing): an `extern fn` declared
# `-> i32` must have its call result cleaned to that width BEFORE anything reads it, because
# SysV/Win64 both permit the callee to leave the register's bits above the declared width
# unspecified, and glibc's `memcmp` uses that permission (the documented case
# `examples/probes/arena_bottom/src/bottom.tks:50` worked around by declaring `-> u64` and
# extracting the C `int` result by hand).
#
# This probe declares `memcmp` as its TRUE C signature, `-> i32`, and compares the raw result
# directly — equal buffers must read exactly 0, and the sign of an unequal comparison must
# survive undamaged. BEFORE `src/lir/lower.tks`'s `apply_extern_return_narrow`/
# `narrow_extern_return`, this project's equal-buffers demand (exit 11) could fail on a garbage
# upper half of the return register even though the true C `int` result IS zero.
#
#   TEKO_TARGET=x86_64-linux teko build --backend=native examples/probes/extern_return_narrow
#   ./examples/probes/extern_return_narrow/bin/extern_return_narrow     # -> 42
#
# NATIVE ONLY, for the SAME reason `arena_bottom.tkp` documents: the C backend cannot compile
# this at all (it emits its own libc prototypes, which collide with `<string.h>`'s real
# `memcmp`/`<stdlib.h>`'s real `aligned_alloc`/`free`).
name = "extern_return_narrow"
source = "src"

[artifact]
kind = "binary"
