/**
 * waitgroup_selftest — the C-owned §10 C5 probe body, reached through ONE scalar extern (the
 * thread_spawn_selftest idiom). Does add(n), spawns `n` workers each done()ing once, and wait()s;
 * returns 0 only when the barrier held (wait returned after all n done()s).
 *
 * @param n  the number of workers to add and await
 * @return   0 when the barrier held
 * @since 0.3.1 §10 C5
 */
extern fn waitgroup_selftest(n: i64): u64 = "tk_waitgroup_selftest" from "teko_rt"

/**
 * probe_waitgroup — drive a 1000-worker WaitGroup barrier and check wait() returned only after every
 * done(). Returns 42 on a held barrier, 1 otherwise.
 *
 * @return  42 when the barrier held, 1 otherwise
 * @since 0.3.1 §10 C5
 */
pub fn probe_waitgroup(): i32 {
    var rc = waitgroup_selftest(1000)
    if rc != 0 { return 1 }
    42
}
