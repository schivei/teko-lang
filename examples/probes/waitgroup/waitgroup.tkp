# §10 C5 — the `tk_waitgroup` runtime probe (manual counter + blocking wait).
#
# Proves the WaitGroup barrier: `tk_waitgroup_make`/`add`/`done`/`wait`/`end`
# (src/runtime/teko_rt.c) — an F2-resident mutex+cond counter where wait() returns only after every
# add() has been matched by a done(). Reached through ONE scalar extern into a C-owned selftest body.
#
# tk_waitgroup_selftest(1000) does add(1000), spawns 1000 workers each done()ing once, and wait()s;
# a broken counter would return early. Success -> exit 42.
#
#   TEKO_MEM_PARANOID=1 ./examples/probes/waitgroup/bin/waitgroup   # -> 42
name = "waitgroup"
source = "src"

[artifact]
kind = "binary"
