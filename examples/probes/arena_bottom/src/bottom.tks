/**
 * The C11 aligned allocator, reached DIRECTLY as a C symbol — the arena's floor. Returns a block
 * of `size` bytes whose base address is a multiple of `alignment`, or 0 when the allocator fails.
 * This declaration is the whole point of the probe: it must resolve to the C symbol
 * `aligned_alloc` with no Teko mangling and no stdlib hop, because anything the arena calls that
 * re-enters the runtime is the circularity that blocked `src/runtime/teko_rt.tks`.
 *
 * The address is carried as a plain `u64` rather than `uptr` because the checker defines no
 * `uptr <-> u64` cast (`cast_kind` admits only `Prim` and `Byte`), and an arena IS address
 * arithmetic: without a numeric carrier there is no bump pointer. A `u64` return is ABI-identical
 * to `void *` on every 64-bit target — both arrive in the integer return register — so this is a
 * faithful binding, not a workaround.
 *
 * @param alignment  the required base alignment in bytes; must be a power of two
 * @param size       the block size in bytes; C11 requires it to be a multiple of `alignment`
 * @return           the block's base address, or 0 on failure
 */
pub extern fn c_aligned_alloc(alignment: u64, size: u64): u64 = "aligned_alloc"

/**
 * The C deallocator, reached DIRECTLY as a C symbol — the counterpart of `c_aligned_alloc`. A
 * block obtained from `aligned_alloc` is released with plain `free` on every POSIX target, which
 * is exactly what the C twin's `tk_chunk_free` does today.
 *
 * @param block  the base address returned by `c_aligned_alloc`; 0 is a documented no-op
 * @return       nothing
 */
pub extern fn c_free(block: u64): void = "free"

/**
 * The C byte-fill primitive, reached DIRECTLY as a C symbol. It is the arena's WRITE bottom: the
 * only way, today, for Teko to put a known byte pattern into a raw block it owns — and therefore
 * the only way to prove the block returned by `c_aligned_alloc` is genuinely writable memory and
 * not merely a plausible-looking address. It is also the exact primitive `TEKO_MEM_PARANOID`'s
 * poison-on-free needs (the C twin writes `memset(p, 0xDD, usable)`).
 *
 * @param block  the base address to fill
 * @param value  the fill byte, passed in an `i32` as C's signature requires
 * @param count  how many bytes to fill
 * @return       `block`, as C's `memset` returns its destination
 */
pub extern fn c_memset(block: u64, value: i32, count: u64): u64 = "memset"

/**
 * The C block-compare primitive, reached DIRECTLY as a C symbol. It is the arena's READ bottom for
 * this probe: comparing a written block against a second, identically written block reads raw
 * memory without needing any new compiler primitive, so the probe can assert that what was written
 * is what is there.
 *
 * DECLARED `u64` — still CORRECT (it names the return register in full), but NO LONGER
 * NECESSARY: the reason it was declared this way originally was that the native backend did not
 * narrow an `extern fn`'s `i32` return (the callee may leave the upper 32 bits of the return
 * register unspecified — the SysV ABI permits it, and glibc's `memcmp` uses that permission — so
 * Teko read the FULL 64-bit register, and even an "equal" result was only reliably zero in its
 * low 32 bits). `lower.tks::apply_extern_return_narrow`/`narrow_extern_return` retired that gap:
 * an `extern fn` declared `-> i32` now has its call result sign-extended from its low 32 bits
 * before anything reads it, so `c_memcmp_raw` could be re-declared `-> i32` and compared directly.
 * `blocks_differ` below keeps the `u64`-plus-modulo idiom anyway (this probe predates the fix and
 * is not itself the fix's regression fixture) — do NOT copy this idiom into new code believing it
 * is still required.
 *
 * @param left   the first block's base address
 * @param right  the second block's base address
 * @param count  how many bytes to compare
 * @return       the return register in full; only its low 32 bits are the C result
 */
pub extern fn c_memcmp_raw(left: u64, right: u64, count: u64): u64 = "memcmp"

/**
 * The number of distinct values a 32-bit C `int` holds — the modulus that recovers the C result
 * from the return register's low half.
 *
 * @return  2^32
 */
pub fn int32_radix(): u64 {
    4294967296
}

/**
 * Tests whether two raw blocks hold different bytes, reading only the half of `c_memcmp_raw`'s
 * return that the ABI actually defines.
 *
 * @param left   the first block's base address
 * @param right  the second block's base address
 * @param count  how many bytes to compare
 * @return       true when the two blocks differ within `count` bytes
 */
pub fn blocks_differ(left: u64, right: u64, count: u64): bool {
    c_memcmp_raw(left, right, count) % int32_radix() != 0
}

/**
 * The chunk alignment the arena demands of every payload base: the C twin's `TK_ARENA_ALIGN`,
 * `max_align_t`'s alignment floored at 16, which is 16 on every supported target.
 *
 * @return  16, the arena's payload alignment in bytes
 */
pub fn arena_align(): u64 {
    16
}

/**
 * The default chunk payload size the arena requests from the allocator, matching the C twin's
 * `TK_REGION_DEFAULT_CHUNK`.
 *
 * @return  65536, the default chunk payload in bytes
 */
pub fn default_chunk_bytes(): u64 {
    65536
}

/**
 * The poison byte `TEKO_MEM_PARANOID` writes over a block on free, matching the C twin's
 * `memset(p, 0xDD, usable)`. Any read of a poisoned block yields this pattern instead of the value
 * that used to live there, which is what makes a wrong linearity proof fail loudly.
 *
 * @return  0xDD, the poison byte
 */
pub fn poison_byte(): i32 {
    221
}

/**
 * Fails loudly when an arena invariant does not hold, exiting with the invariant's own code so a
 * failure names itself. A message-carrying panic is not available here: the native backend refuses
 * a `str` local threaded into `panic` (`native backend N1: not a fat-pointer local`), and this
 * probe must run on the native backend, which is where the extern bridge lives.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

/**
 * Tests whether an address satisfies the arena's payload alignment, which is what makes a chunk
 * legal to hand out: a base that is not `arena_align()`-aligned would make every allocation derived
 * from it misaligned, which is undefined behaviour for the 16-byte-aligned values Teko stores in
 * arena memory.
 *
 * @param address  the address to test
 * @return         true when `address` is a multiple of `arena_align()`
 */
pub fn is_arena_aligned(address: u64): bool {
    address % arena_align() == 0
}

/**
 * Acquires one default-sized chunk and demands it is usable as an arena chunk: a non-zero base at
 * the arena's payload alignment. The block is NOT released here — the caller owns it. Exits 10 on
 * a null chunk and 11 on a misaligned one.
 *
 * @return  the chunk's base address
 */
pub fn acquire_chunk(): u64 {
    var block = c_aligned_alloc(arena_align(), default_chunk_bytes())
    demand(block != 0, 10)
    demand(is_arena_aligned(block), 11)
    block
}

/**
 * Releases a chunk acquired by `acquire_chunk`, closing the allocate/free round trip that
 * `tk_region_drop` performs on every chunk of a dropped region.
 *
 * @param block  the chunk base address to release
 * @return       nothing
 */
pub fn release_chunk(block: u64) {
    c_free(block)
}

/**
 * Fills two independently acquired chunks with the same byte and demands they compare equal — the
 * writability proof. An address that could not be written, or that aliased another live block,
 * fails one of these. Exits 12 when two live chunks share a base and 13 when a write does not land.
 *
 * @param value  the byte value to fill both chunks with
 * @return       nothing
 */
pub fn prove_chunk_is_writable(value: i32) {
    var left = acquire_chunk()
    var right = acquire_chunk()
    demand(left != right, 12)
    c_memset(left, value, default_chunk_bytes())
    c_memset(right, value, default_chunk_bytes())
    demand(!blocks_differ(left, right, default_chunk_bytes()), 13)
    release_chunk(left)
    release_chunk(right)
}

/**
 * Demands that a bump offset computed in Teko addresses real memory inside a chunk: the chunk is
 * zeroed, a sub-range at the bump offset is poisoned, and that range is compared against a
 * reference chunk poisoned from its own base. Address arithmetic done in Teko is what an arena IS,
 * so this is the load-bearing half of the bottom proof. Exits 14 when the offset misses its bytes.
 *
 * @param offset  the bump offset, in bytes, from the chunk base
 * @param count   how many bytes to poison at that offset
 * @return        nothing
 */
pub fn prove_bump_offset_addresses_memory(offset: u64, count: u64) {
    var chunk = acquire_chunk()
    var reference = acquire_chunk()
    c_memset(chunk, 0, default_chunk_bytes())
    c_memset(chunk + offset, poison_byte(), count)
    c_memset(reference, poison_byte(), count)
    demand(!blocks_differ(chunk + offset, reference, count), 14)
    demand_untouched_prefix(chunk, offset)
    release_chunk(chunk)
    release_chunk(reference)
}

/**
 * Demands that the bytes BEFORE a bump offset were left alone by the write at that offset — the
 * containment half of the bump proof, and the one that catches an offset applied in the wrong
 * direction or a length that runs backwards. A zero-length prefix is vacuously untouched, which is
 * the `offset == 0` case. Exits 15 when the poison leaked below the offset.
 *
 * @param chunk   the chunk whose prefix must still be zero
 * @param offset  the bump offset the write started at, i.e. the prefix length
 * @return        nothing
 */
pub fn demand_untouched_prefix(chunk: u64, offset: u64) {
    if offset == 0 { return }
    var zeroes = acquire_chunk()
    c_memset(zeroes, 0, default_chunk_bytes())
    demand(!blocks_differ(chunk, zeroes, offset), 15)
    release_chunk(zeroes)
}

/**
 * Demands the allocator round trip survives a release: a second acquisition after a free must
 * still yield a usable, aligned, non-zero chunk. A one-shot that happened to return one plausible
 * address would pass every other check here and fail this one. Exits 16 on a failed re-acquisition
 * and 17 when the re-acquired chunk is misaligned.
 *
 * @return  nothing
 */
pub fn prove_reacquire_after_release() {
    var first = acquire_chunk()
    release_chunk(first)
    var second = acquire_chunk()
    demand(second != 0, 16)
    demand(is_arena_aligned(second), 17)
    release_chunk(second)
}

/**
 * The arbitrary 64-bit control word `prove_word_round_trip` writes and reads back — a pattern
 * chosen to be unlikely to arise by accident from any OTHER arithmetic in this probe, so a
 * mis-addressed load could not accidentally match it.
 *
 * @return  0xDEADBEEFCAFEBABE
 */
pub fn control_word(): u64 {
    0xDEADBEEFCAFEBABE
}

/**
 * Demands that a 64-bit word written through `teko::mem::store_u64` at a Teko-computed bump offset
 * reads back byte-for-byte through `teko::mem::load_u64` — P1's whole contract (`docs/design/
 * arena-em-teko.md` §2): a raw load/store over a caller-computed address that does NOT allocate,
 * unlike `bytes_from_ptr`. The chunk is zeroed first, so a load that missed its address would read
 * zero rather than the control word by coincidence. Exits 18 on a mismatch.
 *
 * @param offset  the bump offset, in bytes, from the chunk base
 * @return        nothing
 */
pub fn prove_word_round_trip(offset: u64) {
    var chunk = acquire_chunk()
    c_memset(chunk, 0, default_chunk_bytes())
    var address = chunk + offset
    teko::mem::store_u64(address, control_word())
    demand(teko::mem::load_u64(address) == control_word(), 18)
    release_chunk(chunk)
}

/**
 * Demands that a real allocator address survives a round trip through the `u64 <-> ptr<byte>` cast
 * — P1's third gap (`docs/design/arena-em-teko.md` §2): on a 64-bit target `ptr<byte>` and `u64`
 * share representation, so the cast is a reinterpret, never a conversion, and the SAME bit
 * pattern comes back both ways. Exits 19 on a mismatch.
 *
 * @return  nothing
 */
pub fn prove_u64_ptr_byte_cast_round_trip() {
    var chunk = acquire_chunk()
    var as_ptr_byte = chunk to ptr<byte>
    var back_to_u64 = as_ptr_byte to u64
    demand(back_to_u64 == chunk, 19)
    release_chunk(chunk)
}

/**
 * Runs the whole bottom proof: the allocator round trip, chunk writability, Teko-computed bump
 * offsets landing on the right bytes — including an offset at the very tail of the chunk, which is
 * where an off-by-one in the bump arithmetic would overrun — and P1's two remaining language-gap
 * primitives (`docs/design/arena-em-teko.md` §2) a Teko arena needs to hold its own bookkeeping:
 * `teko::mem::load_u64`/`store_u64` reading back a word at a bump offset, and the `u64 <-> ptr<byte>`
 * cast round-tripping a real allocator address. Every demand exits with its own code on failure, so
 * reaching the return value at all is the proof.
 *
 * @return  42 when the arena's floor holds
 */
pub fn probe_bottom(): i32 {
    prove_reacquire_after_release()
    prove_chunk_is_writable(65)
    prove_bump_offset_addresses_memory(0, 4096)
    prove_bump_offset_addresses_memory(arena_align(), 4096)
    prove_bump_offset_addresses_memory(default_chunk_bytes() - arena_align(), arena_align())
    prove_word_round_trip(0)
    prove_word_round_trip(default_chunk_bytes() - arena_align())
    prove_u64_ptr_byte_cast_round_trip()
    42
}
