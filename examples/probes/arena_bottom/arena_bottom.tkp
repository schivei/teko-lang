# FATIA 1 — the arena BOTTOM probe (cargo/20-arena-teko).
#
# An arena written in Teko can only exist if Teko reaches the aligned allocator and the deallocator
# DIRECTLY, without routing through anything that re-enters the runtime — that circularity is what
# blocked src/runtime/teko_rt.tks (its `print` calls `teko::io::write`, which calls `tk_write`).
# This project proves exactly that bottom, and nothing else:
#
#   extern fn c_aligned_alloc(u64, u64) -> u64  = "aligned_alloc"
#   extern fn c_free(u64)               -> void = "free"
#   extern fn c_memset(u64, i32, u64)   -> u64  = "memset"
#   extern fn c_memcmp(u64, u64, u64)   -> i32  = "memcmp"
#
# It allocates 64 KB chunks at 16-byte alignment (the C twin's TK_REGION_DEFAULT_CHUNK and
# TK_ARENA_ALIGN), demands each base is non-zero and 16-aligned, writes through Teko-computed bump
# offsets, reads the writes back, frees, and re-allocates. Exit 42 = the floor holds; any other exit
# names the invariant that broke (10..17, see `demand` call sites in src/bottom.tks).
#
#   TEKO_TARGET=x86_64-linux teko build examples/probes/arena_bottom
#   ./examples/probes/arena_bottom/bin/arena_bottom     # -> 42
#
# NATIVE ONLY, by two independent facts:
#   * the VM refuses `extern fn` (vm_unsupported), and
#   * the C backend CANNOT compile this at all: it emits its own prototype for each extern symbol,
#     so binding `aligned_alloc`/`free` with a `u64` address carrier collides with the real
#     declarations in <stdlib.h> ("conflicting types for 'aligned_alloc'"). The native backend has
#     no prototypes — it emits a call to the symbol — so only it can host the arena's bottom.
name = "arena_bottom"
source = "src"

[artifact]
kind = "binary"
