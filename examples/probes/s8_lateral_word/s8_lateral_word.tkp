# examples/probes/s8_lateral_word — the 0.3.1 §8 part-2 ACCEPT fixture for the LATERAL
# machine-word coercions (docs/design/mudancas-superficie-0.3.1.md §8). On a 64-bit target
# `usize` ≡ `u64` and `size` ≡ `i64` in width AND sign — they differ only in spelling — so a
# value of one kind flows into a binding of its lateral partner WITHOUT a `to`, in BOTH
# directions: `u64 -> usize`, `usize -> u64`, `i64 -> size`, `size -> i64`. The probe drives
# each relabel through a typed VARIABLE (not a literal), plus a pre-existing `u8 -> usize`
# widen to prove the older same-sign-narrower path still holds, and returns a known exit code
# so a miscompile (a truncation where a same-width no-op was owed) is caught.
#
#   TK_RT_DIR=$PWD/src/runtime TEKO_BACKEND=c teko build examples/probes/s8_lateral_word -o out --no-verify --release
#   ./out/teko     # -> exits 42 on success; a non-42 code names the failed invariant
name = "s8_lateral_word"
source = "src"

[artifact]
kind = "binary"
