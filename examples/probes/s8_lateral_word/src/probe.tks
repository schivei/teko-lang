/**
 * relabel_u64_to_usize — a `u64` argument RETURNED as `usize` with no `to`. On the 64-bit
 * target the two are the same machine word, so this is a lossless lateral relabel the checker
 * now admits implicitly (`same_word_lateral` in the W-RULE) and the backend lowers to a
 * same-width no-op.
 *
 * @param x  a value at `u64` width
 * @return   the same value, relabelled `usize`
 */
fn relabel_u64_to_usize(x: u64): usize { return x }

/**
 * relabel_usize_to_u64 — the reverse lateral relabel, `usize` argument returned as `u64` with
 * no `to`, proving the coercion is admitted in BOTH directions.
 *
 * @param x  a value at machine-word width
 * @return   the same value, relabelled `u64`
 */
fn relabel_usize_to_u64(x: usize): u64 { return x }

/**
 * relabel_i64_to_size — the signed lateral relabel, `i64` argument returned as `size` with no
 * `to`. `size` ≡ `i64` in width and sign, so a negative value survives unchanged.
 *
 * @param x  a value at `i64` width
 * @return   the same value, relabelled `size`
 */
fn relabel_i64_to_size(x: i64): size { return x }

/**
 * relabel_size_to_i64 — the reverse signed lateral relabel, `size` argument returned as `i64`
 * with no `to`.
 *
 * @param x  a value at machine-word width
 * @return   the same value, relabelled `i64`
 */
fn relabel_size_to_i64(x: size): i64 { return x }

/**
 * widen_u8_to_usize — the PRE-EXISTING same-sign-narrower-into-wider path, kept in the probe to
 * prove the lateral addition did not disturb it: a `u8` widens implicitly into `usize`.
 *
 * @param x  a small unsigned value
 * @return   the value at machine-word width
 */
fn widen_u8_to_usize(x: u8): usize { return x }

/**
 * drive — the probe body. Each lateral relabel is driven through a typed VARIABLE (never a bare
 * literal) across BOTH implicit-coercion sites: a direct binding assignment (`var b: usize = a`,
 * the assignment rung) and a function RETURN (the `relabel_*` helpers, the return rung). Every
 * value is round-tripped against its known magnitude, so a truncation where a same-width no-op
 * was owed fails its own guard. The unsigned values exceed `u32::MAX` and the signed values are
 * large negatives, so a wrong-width lowering cannot pass by accident.
 *
 * @return  42 when every relabel is value-preserving; 1..9 name the failed invariant
 */
fn drive(): i64 {
    var a: u64 = 5000000000
    var b: usize = a
    if b != 5000000000 { return 1 }
    if relabel_u64_to_usize(a) != 5000000000 { return 2 }

    var c: usize = 4000000001
    var d: u64 = c
    if d != 4000000001 { return 3 }
    if relabel_usize_to_u64(c) != 4000000001 { return 4 }

    var e: i64 = -3000000000
    var f: size = e
    if f != -3000000000 { return 5 }
    if relabel_i64_to_size(e) != -3000000000 { return 6 }

    var g: size = -2000000001
    var h: i64 = g
    if h != -2000000001 { return 7 }
    if relabel_size_to_i64(g) != -2000000001 { return 8 }

    var small: u8 = 200
    var wide: usize = widen_u8_to_usize(small)
    if wide != 200 { return 9 }

    42
}
