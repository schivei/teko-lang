# The append COST probe (cargo/0.3.1.0-fundacao-f5-pipe).
#
# The two numbers for what gets ALLOCATED: N records through `tk_rt_append_file` against N records
# through the read-the-whole-file-back-and-rewrite-it shape `teko::process::verdict_emit` used to
# use, with the peak memory of each. Both arms verified to produce IDENTICAL output first — a
# cheaper arm that wrote less would be measuring output, not cost.
#
# A PROBE AND NOT A UNIT TEST, AND THAT IS A PROPERTY OF THE METER. `teko::mem::peak_rss` is a
# HIGH-WATER MARK. Inside the shared unit-test process the suite has already peaked far above
# anything either arm allocates, so both deltas read zero and the comparison cannot be taken at all
# — measured, as a FAILED assertion in one shard before this probe existed. A process that does
# nothing else is the only place that meter says anything.
#
# C ROUTE ONLY, AND ONLY BECAUSE OF THE CONTROL ARM. The primitive under test runs on BOTH routes,
# which `examples/probes/append_file_probe` proves. The OLD shape, however, is built out of
# `teko::io::read_file` and `teko::io::write_file`, and the own backend lowers NEITHER — measured,
# it refuses outright: "native backend N1: builtin `write_file` not yet lowered (N2)". There is no
# way to spell the control arm natively, so the comparison is a C-route reading, and saying so is
# better than quietly dropping the control.
#
# MEASURED, records of 50 bytes:
#
#     N        append grows    rewrite grows    rewrite vs previous N
#     200          0 bytes         1.2 MiB
#     400          0 bytes        13.4 MiB           11.0x
#     800          0 bytes        62.1 MiB            4.6x
#    1600          0 bytes       256.5 MiB            4.1x
#
# DOUBLING N QUADRUPLES THE REWRITE, converging on 4 = 2 squared: the quadratic signature itself,
# not an impression of one. The 11x at the low end is the arena's chunk quantization, which stops
# mattering once the growth exceeds one chunk. The append grows the process by LITERALLY ZERO bytes
# at every size — it allocates only the record, and the record is transient, where every byte the
# rewrite touches stays in the arena until the process exits (`tk_regions_free_all` runs once, at
# exit). At 1600 records the old path asks for 256 MiB to write an 80 KB file.
#
# THIS PROBE'S OWN READING at N = 800, printed on every run so the number is never stale:
#
#     APPEND  growth = 0.3 MiB (393216 bytes)     — one arena chunk being touched, not a per-record cost
#     REWRITE growth = 64.8 MiB (68026368 bytes)  — 173x, against a required margin of 8x
#
# The append's 0.3 MiB is the FIRST CHUNK the arena hands out, paid once; the standalone run above
# read 0 bytes for the same arm because its chunk was already warm. Either way the append does not
# grow with N and the rewrite does, which is the whole claim.
#
# EXIT CODES: 20 the two arms disagree; 21 the host cannot report peak_rss; 22 the rewrite did not
# out-allocate the append by the required margin; 42 all good.
#
#   TK_RT_DIR=<repo>/src/runtime TEKO_BACKEND=c teko build examples/probes/append_cost_probe
#   ./examples/probes/append_cost_probe/bin/append_cost_probe    # -> 42
name = "append_cost_probe"
source = "src"

[artifact]
kind = "binary"
