let appended = "append-cost-a.log"
let rewritten = "append-cost-b.log"

discard(appended)
discard(rewritten)

let base = teko::mem::peak_rss()
demand(base > 0, 21)

demand(append_all(appended, RECORDS), 20)
let after_append = teko::mem::peak_rss()

demand(rewrite_all(rewritten, RECORDS), 20)
let after_rewrite = teko::mem::peak_rss()

demand(file_text(appended) == file_text(rewritten), 20)

let append_growth = after_append - base
let rewrite_growth = after_rewrite - after_append

println("records              = " ~ teko::str::u64_to_str(RECORDS) ~ " of " ~ teko::str::u64_to_str(record_text(0).len + 1) ~ " bytes")
println("APPEND  growth       = " ~ mib(append_growth) ~ " MiB (" ~ teko::str::u64_to_str(append_growth) ~ " bytes)")
println("REWRITE growth       = " ~ mib(rewrite_growth) ~ " MiB (" ~ teko::str::u64_to_str(rewrite_growth) ~ " bytes)")

discard(appended)
discard(rewritten)

demand(rewrite_growth > append_growth * COST_MARGIN, 22)
exit(42)
