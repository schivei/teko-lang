fn af_unix(): i32 { 1 }

fn sock_dgram(): i32 { 2 }

fn sol_socket(): i32 { 1 }

fn so_rcvbuf(): i32 { 8 }

fn msg_dontwait(): i32 { 64 }

fn eagain(): u64 { 11 }

fn record_bytes(): u64 { 24 }

fn sockaddr_un_bytes(): u64 { 110 }

fn sun_path_offset(): u64 { 2 }

fn writer_count(): u64 { 4 }

fn records_per_writer(): u64 { 500 }

fn flood_id(): u64 { 99 }

fn small_rcvbuf_request(): u64 { 1024 }

fn flood_cap(): u64 { 20000 }

fn int32_radix(): u64 { 4294967296 }

#os("linux")
pub extern fn c_socket(domain: i32, sock_type: i32, protocol: i32): i32 = "socket"

#os("linux")
pub extern fn c_bind(fd: i32, addr: u64, addrlen: i32): i32 = "bind"

#os("linux")
pub extern fn c_sendto(fd: i32, buf: u64, len: u64, sock_flags: i32, addr: u64, addrlen: i32): i64 = "sendto"

#os("linux")
pub extern fn c_recvfrom(fd: i32, buf: u64, len: u64, sock_flags: i32, addr: u64, addrlen_ptr: u64): i64 = "recvfrom"

#os("linux")
pub extern fn c_setsockopt(fd: i32, level: i32, optname: i32, optval: u64, optlen: i32): i32 = "setsockopt"

#os("linux")
pub extern fn c_getsockopt(fd: i32, level: i32, optname: i32, optval: u64, optlen_ptr: u64): i32 = "getsockopt"

#os("linux")
pub extern fn c_close(fd: i32): i32 = "close"

#os("linux")
pub extern fn c_unlink(path: u64): i32 = "unlink"

#os("linux")
pub extern fn c_errno_location(): u64 = "__errno_location"

pub extern fn c_aligned_alloc(alignment: u64, size: u64): u64 = "aligned_alloc"

pub extern fn c_free(block: u64) = "free"

pub extern fn c_memset(block: u64, value: i32, count: u64): u64 = "memset"

pub extern fn c_memcmp_raw(left: u64, right: u64, count: u64): u64 = "memcmp"

fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

fn store_byte(address: u64, value: u64) {
    _ = c_memset(address, value to i32, 1)
}

fn byte_equals(address: u64, scratch: u64): bool {
    c_memcmp_raw(address, scratch, 1) % int32_radix() == 0
}

fn load_byte(address: u64, scratch: u64): u64 {
    var low: u64 = 0
    var high: u64 = 255
    loop {
        if low >= high { break }
        var mid = low + (high - low) / 2
        store_byte(scratch, mid)
        if byte_equals(address, scratch) { return mid }
        var less = c_memcmp_raw(address, scratch, 1) % int32_radix() >= 2147483648
        if less { high = mid - 1 } else { low = mid + 1 }
    }
    low
}

fn read_errno(): u64 {
    var scratch = c_aligned_alloc(1, 1)
    demand(scratch != 0, 60)
    var value = load_byte(c_errno_location(), scratch)
    c_free(scratch)
    value
}

fn write_path_bytes(base_addr: u64, path: str) {
    var i: u64 = 0
    loop {
        if i >= path.len { break }
        store_byte(base_addr + i, path[i] to u64)
        i = i + 1
    }
}

fn build_cstr(path: str): u64 {
    var block = c_aligned_alloc(8, path.len + 1)
    demand(block != 0, 61)
    write_path_bytes(block, path)
    store_byte(block + path.len, 0)
    block
}

fn unlink_path(path: str) {
    var cstr = build_cstr(path)
    _ = c_unlink(cstr)
    c_free(cstr)
}

fn build_sockaddr_un(path: str): u64 {
    var block = c_aligned_alloc(8, sockaddr_un_bytes())
    demand(block != 0, 62)
    _ = c_memset(block, 0, sockaddr_un_bytes())
    store_byte(block, af_unix() to u64)
    write_path_bytes(block + sun_path_offset(), path)
    block
}

fn sockaddr_len(path: str): i32 {
    (sun_path_offset() + path.len + 1) to i32
}

fn derive_pattern(id: u64, seq: u64): u64 {
    id * 1000003 + seq * 7919 + 12648430
}

fn build_record(id: u64, seq: u64): u64 {
    var block = c_aligned_alloc(8, record_bytes())
    demand(block != 0, 63)
    teko::mem::store_u64(block, id)
    teko::mem::store_u64(block + 8, seq)
    teko::mem::store_u64(block + 16, derive_pattern(id, seq))
    block
}

fn send_record(fd: i32, addr: u64, addrlen: i32, id: u64, seq: u64, sock_flags: i32): i64 {
    var buf = build_record(id, seq)
    var sent = c_sendto(fd, buf, record_bytes(), sock_flags, addr, addrlen)
    c_free(buf)
    sent
}

type RecvOutcome = struct {
    ret: i64

    id: u64

    seq: u64

    pattern: u64
}

fn recv_record(fd: i32, sock_flags: i32): RecvOutcome {
    var buf = c_aligned_alloc(8, record_bytes())
    demand(buf != 0, 64)
    var ret = c_recvfrom(fd, buf, record_bytes(), sock_flags, 0, 0)
    var id: u64 = 0
    var seq: u64 = 0
    var pattern: u64 = 0
    if ret == record_bytes() to i64 {
        id = teko::mem::load_u64(buf)
        seq = teko::mem::load_u64(buf + 8)
        pattern = teko::mem::load_u64(buf + 16)
    }
    c_free(buf)
    RecvOutcome { ret = ret; id = id; seq = seq; pattern = pattern }
}

fn reader_path(): str { "/tmp/teko_chan_dgram_ch0_reader.sock" }

fn full_path(): str { "/tmp/teko_chan_dgram_ch0_full.sock" }

type WriterSockets = struct {
    fd1: i32

    fd2: i32

    fd3: i32

    fd4: i32
}

fn open_writer_sockets(): WriterSockets {
    var a = c_socket(af_unix(), sock_dgram(), 0)
    demand(a >= 0, 32)
    var b = c_socket(af_unix(), sock_dgram(), 0)
    demand(b >= 0, 32)
    var c = c_socket(af_unix(), sock_dgram(), 0)
    demand(c >= 0, 32)
    var d = c_socket(af_unix(), sock_dgram(), 0)
    demand(d >= 0, 32)
    WriterSockets { fd1 = a; fd2 = b; fd3 = c; fd4 = d }
}

fn close_writer_sockets(w: WriterSockets) {
    demand(c_close(w.fd1) == 0, 34)
    demand(c_close(w.fd2) == 0, 34)
    demand(c_close(w.fd3) == 0, 34)
    demand(c_close(w.fd4) == 0, 34)
}

fn writer_fd_of(id: u64, w: WriterSockets): i32 {
    if id == 1 { return w.fd1 }
    if id == 2 { return w.fd2 }
    if id == 3 { return w.fd3 }
    demand(id == 4, 38)
    w.fd4
}

fn fold_fanin_record(r: RecvOutcome, expected1: u64, expected2: u64, expected3: u64, expected4: u64): Expectations {
    demand(r.pattern == derive_pattern(r.id, r.seq), 36)
    if r.id == 1 { demand(r.seq == expected1, 37); return Expectations { e1 = expected1 + 1; e2 = expected2; e3 = expected3; e4 = expected4 } }
    if r.id == 2 { demand(r.seq == expected2, 37); return Expectations { e1 = expected1; e2 = expected2 + 1; e3 = expected3; e4 = expected4 } }
    if r.id == 3 { demand(r.seq == expected3, 37); return Expectations { e1 = expected1; e2 = expected2; e3 = expected3 + 1; e4 = expected4 } }
    demand(r.id == 4, 38)
    demand(r.seq == expected4, 37)
    Expectations { e1 = expected1; e2 = expected2; e3 = expected3; e4 = expected4 + 1 }
}

type Expectations = struct {
    e1: u64

    e2: u64

    e3: u64

    e4: u64
}

fn round_robin_writer(total_sent: u64): u64 {
    total_sent % writer_count() + 1
}

fn round_robin_seq(total_sent: u64): u64 {
    total_sent / writer_count()
}

fn try_send_next(w: WriterSockets, total_sent: u64, addr: u64, addrlen: i32): bool {
    var id = round_robin_writer(total_sent)
    var seq = round_robin_seq(total_sent)
    var fd = writer_fd_of(id, w)
    var sent = send_record(fd, addr, addrlen, id, seq, msg_dontwait())
    if sent == record_bytes() to i64 { return true }
    demand(sent == -1, 33)
    demand(read_errno() == eagain(), 33)
    false
}

fn try_drain_next(reader_fd: i32, tally: Expectations): Expectations {
    var r = recv_record(reader_fd, msg_dontwait())
    if r.ret != record_bytes() to i64 { return tally }
    fold_fanin_record(r, tally.e1, tally.e2, tally.e3, tally.e4)
}

fn run_fanin_loop(w: WriterSockets, reader_fd: i32, addr: u64, addrlen: i32): Expectations {
    var target = writer_count() * records_per_writer()
    var tally = Expectations { e1 = 0; e2 = 0; e3 = 0; e4 = 0 }
    var total_sent: u64 = 0
    var total_recv: u64 = 0
    loop {
        if total_sent >= target && total_recv >= target { break }
        if total_sent < target {
            if try_send_next(w, total_sent, addr, addrlen) { total_sent++ }
        }
        var before = tally
        tally = try_drain_next(reader_fd, tally)
        if tally.e1 != before.e1 || tally.e2 != before.e2 || tally.e3 != before.e3 || tally.e4 != before.e4 {
            total_recv++
        }
    }
    tally
}

fn run_fanin_phase() {
    unlink_path(reader_path())
    var reader_fd = c_socket(af_unix(), sock_dgram(), 0)
    demand(reader_fd >= 0, 30)
    var addr = build_sockaddr_un(reader_path())
    var addrlen = sockaddr_len(reader_path())
    demand(c_bind(reader_fd, addr, addrlen) == 0, 31)

    var w = open_writer_sockets()
    var tally = run_fanin_loop(w, reader_fd, addr, addrlen)
    close_writer_sockets(w)

    demand(tally.e1 == records_per_writer(), 39)
    demand(tally.e2 == records_per_writer(), 39)
    demand(tally.e3 == records_per_writer(), 39)
    demand(tally.e4 == records_per_writer(), 39)

    demand(c_close(reader_fd) == 0, 39)
    c_free(addr)
    unlink_path(reader_path())
}

fn shrink_and_read_rcvbuf(fd: i32): u64 {
    var optblock = c_aligned_alloc(8, 8)
    demand(optblock != 0, 41)
    _ = c_memset(optblock, 0, 8)
    teko::mem::store_u64(optblock, small_rcvbuf_request())
    demand(c_setsockopt(fd, sol_socket(), so_rcvbuf(), optblock, 4) == 0, 42)

    _ = c_memset(optblock, 0, 8)
    var optlen_block = c_aligned_alloc(8, 8)
    demand(optlen_block != 0, 44)
    teko::mem::store_u64(optlen_block, 4)
    demand(c_getsockopt(fd, sol_socket(), so_rcvbuf(), optblock, optlen_block) == 0, 45)
    var granted = teko::mem::load_u64(optblock) % int32_radix()
    demand(granted > 0, 46)

    c_free(optlen_block)
    c_free(optblock)
    granted
}

fn flood_until_refused(flood_fd: i32, full_addr: u64, full_addrlen: i32): u64 {
    var accepted: u64 = 0
    loop {
        demand(accepted < flood_cap(), 50)
        var sent = send_record(flood_fd, full_addr, full_addrlen, flood_id(), accepted, msg_dontwait())
        if sent == record_bytes() to i64 {
            accepted++
        } else {
            demand(sent == -1, 48)
            demand(read_errno() == eagain(), 49)
            demand(accepted > 0, 51)
            return accepted
        }
    }
    accepted
}

fn verify_full_delivery(fd: i32, accepted: u64) {
    var i: u64 = 0
    loop {
        if i >= accepted { break }
        var r = recv_record(fd, 0)
        demand(r.ret == record_bytes() to i64, 55)
        demand(r.id == flood_id(), 56)
        demand(r.seq == i, 57)
        demand(r.pattern == derive_pattern(flood_id(), i), 58)
        i++
    }
    var leftover = recv_record(fd, msg_dontwait())
    demand(leftover.ret < 0, 52)
}

fn run_full_phase() {
    unlink_path(full_path())
    var full_fd = c_socket(af_unix(), sock_dgram(), 0)
    demand(full_fd >= 0, 40)

    var granted = shrink_and_read_rcvbuf(full_fd)
    demand(granted > 0, 46)

    var full_addr = build_sockaddr_un(full_path())
    var full_addrlen = sockaddr_len(full_path())
    demand(c_bind(full_fd, full_addr, full_addrlen) == 0, 43)

    var flood_fd = c_socket(af_unix(), sock_dgram(), 0)
    demand(flood_fd >= 0, 47)

    var accepted = flood_until_refused(flood_fd, full_addr, full_addrlen)
    verify_full_delivery(full_fd, accepted)

    demand(c_close(flood_fd) == 0, 53)
    demand(c_close(full_fd) == 0, 54)
    c_free(full_addr)
    unlink_path(full_path())
}

pub fn probe_chan_dgram(): i32 {
    run_fanin_phase()
    run_full_phase()
    42
}
