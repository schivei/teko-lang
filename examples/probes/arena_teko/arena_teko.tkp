# O ARENA EM TEKO — implementação de referência (cargo/20-arena-teko, fatias 3+).
#
# Projeto: docs/design/arena-em-teko.md. Fundo provado em examples/probes/arena_bottom.
#
# Este projeto implementa a disciplina de memória do runtime — chunks, regiões, a árvore que
# `drop_subtree` percorre, o registro que `lookup` consulta, a free-list e o modo paranoico — em
# Teko, sobre memória crua obtida da libc por `extern fn`. Ele NÃO vive em `src/` porque colocá-lo
# lá exige recompilar o compilador, e o seed correto (o binário RELEASED) não é alcançável neste
# container: todo seed em disco falha no fonte da base em `const struct: initializer is not a
# struct literal (#594)`. Como projeto próprio ele compila, roda e é testado de verdade.
#
# NATIVO SÓ. A VM recusa `extern fn` (vm_unsupported) e o backend C colide com <stdlib.h> ao emitir
# protótipo próprio para `aligned_alloc`/`free` — as duas razões estão registradas em
# examples/probes/arena_bottom/arena_bottom.tkp.
#
#   TEKO_TARGET=x86_64-linux teko build examples/probes/arena_teko
#   ./examples/probes/arena_teko/bin/arena_teko     # -> 42
#
# Exit 42 = toda invariante do arena vale. Qualquer outro exit nomeia a que quebrou; os códigos
# estão nos doc-comments de cada `demand` em src/.
name = "arena_teko"
source = "src"

[artifact]
kind = "binary"
