pub fn chunk_get(control: u64, chunk: u64, field: u64): u64 {
    ctrl_load(control, chunk + field)
}

pub fn chunk_set(chunk: u64, field: u64, value: u64) {
    store_word(chunk + field, value)
}

pub fn chunk_payload(chunk: u64): u64 {
    chunk + CHUNK_HEADER
}

pub fn chunk_try(payload: u64): u64 {
    var chunk = raw_alloc_try(CHUNK_HEADER + payload)
    if chunk == 0 { return 0 }
    chunk_set(chunk, CHUNK_NEXT, 0)
    chunk_set(chunk, CHUNK_CAP, payload)
    chunk_set(chunk, CHUNK_USED, 0)
    chunk
}

pub fn chunk_free(chunk: u64) {
    c_free(chunk)
}

pub fn chunk_free_list(control: u64, head: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        var next = chunk_get(control, chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

pub fn chunk_free_until(control: u64, head: u64, stop: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        if chunk == stop { break }
        var next = chunk_get(control, chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

pub fn chunk_fit_offset(control: u64, chunk: u64, size: u64): u64 {
    var cap = chunk_get(control, chunk, CHUNK_CAP)
    var base_off = round_up_align(chunk_get(control, chunk, CHUNK_USED))
    if base_off > cap { return cap + 1 }
    if size > cap - base_off { return cap + 1 }
    base_off
}

pub fn chunk_offset_fits(control: u64, chunk: u64, offset: u64): bool {
    offset <= chunk_get(control, chunk, CHUNK_CAP)
}
