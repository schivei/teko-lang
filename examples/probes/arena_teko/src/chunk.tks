/**
 * Reads a chunk field.
 *
 * @param control  the control block's base address, for the scratch byte the read borrows
 * @param chunk    the chunk's base address
 * @param field    the field's offset within the header
 * @return         the field's current value
 */
pub fn chunk_get(control: u64, chunk: u64, field: u64): u64 {
    ctrl_load(control, chunk + field)
}

/**
 * Writes a chunk field.
 *
 * @param chunk  the chunk's base address
 * @param field  the field's offset within the header
 * @param value  the value to store
 * @return       nothing
 */
pub fn chunk_set(chunk: u64, field: u64, value: u64) {
    store_word(chunk + field, value)
}

/**
 * The address of a chunk's payload — where its first allocation lands. A chunk base at the arena's
 * alignment yields a payload base at it too, because `CHUNK_HEADER` is a multiple of the alignment.
 *
 * @param chunk  the chunk's base address
 * @return       the payload's base address
 */
pub fn chunk_payload(chunk: u64): u64 {
    chunk + CHUNK_HEADER
}

/**
 * Allocates one chunk with `payload` usable bytes, WITHOUT failing loudly — the try shape
 * `region_alloc`'s retry needs. A fresh chunk starts unlinked and empty.
 *
 * @param payload  how many payload bytes the chunk must offer
 * @return         the chunk's base address, or 0 when the allocator refuses
 */
pub fn chunk_try(payload: u64): u64 {
    var chunk = raw_alloc_try(CHUNK_HEADER + payload)
    if chunk == 0 { return 0 }
    chunk_set(chunk, CHUNK_NEXT, 0)
    chunk_set(chunk, CHUNK_CAP, payload)
    chunk_set(chunk, CHUNK_USED, 0)
    chunk
}

/**
 * Releases one chunk. Every chunk address came from `raw_alloc_try`, so this is heap-correct: no
 * arena interior pointer ever reaches the deallocator.
 *
 * @param chunk  the chunk's base address
 * @return       nothing
 */
pub fn chunk_free(chunk: u64) {
    c_free(chunk)
}

/**
 * Releases a whole chunk list, from `head` to its end. The C twin's drop, rewind and
 * free-everything paths all walk a chunk list exactly this way, reading each `next` BEFORE freeing
 * the node that holds it.
 *
 * @param control  the control block's base address
 * @param head     the first chunk to release; 0 releases nothing
 * @return         nothing
 */
pub fn chunk_free_list(control: u64, head: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        var next = chunk_get(control, chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

/**
 * Releases every chunk of a list up to, but NOT including, a stop chunk — the rewind's shape. The
 * stop chunk is always in the chain because chunks only ever prepend; the `chunk != 0` bound makes
 * that invariant explicit rather than assumed.
 *
 * @param control  the control block's base address
 * @param head     the first chunk to release
 * @param stop     the chunk to stop before; 0 releases the whole list
 * @return         nothing
 */
pub fn chunk_free_until(control: u64, head: u64, stop: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        if chunk == stop { break }
        var next = chunk_get(control, chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

/**
 * The bump offset a request of `size` bytes would occupy in a chunk, or the chunk's capacity plus
 * one when it does not fit. Split out because the fit test and the offset are the same
 * computation, and computing them twice is how a bump allocator grows an off-by-one.
 *
 * @param control  the control block's base address
 * @param chunk    the chunk to measure
 * @param size     the already-aligned request size
 * @return         the aligned bump offset, or a value greater than the capacity when it will not fit
 */
pub fn chunk_fit_offset(control: u64, chunk: u64, size: u64): u64 {
    var cap = chunk_get(control, chunk, CHUNK_CAP)
    var base_off = round_up_align(chunk_get(control, chunk, CHUNK_USED))
    if base_off > cap { return cap + 1 }
    if size > cap - base_off { return cap + 1 }
    base_off
}

/**
 * Tests whether a bump offset returned by `chunk_fit_offset` describes a real fit.
 *
 * @param control  the control block's base address
 * @param chunk    the chunk the offset came from
 * @param offset   the offset `chunk_fit_offset` returned
 * @return         true when the request fits at that offset
 */
pub fn chunk_offset_fits(control: u64, chunk: u64, offset: u64): bool {
    offset <= chunk_get(control, chunk, CHUNK_CAP)
}
