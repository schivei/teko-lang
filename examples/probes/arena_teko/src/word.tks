pub extern fn c_aligned_alloc(alignment: u64, size: u64): u64 = "aligned_alloc"

pub extern fn c_free(block: u64) = "free"

pub extern fn c_memset(block: u64, value: i32, count: u64): u64 = "memset"

pub extern fn c_memcmp_raw(left: u64, right: u64, count: u64): u64 = "memcmp"

pub extern fn c_memcpy(dst: u64, src: u64, count: u64): u64 = "memcpy"

pub const ARENA_ALIGN: u64 = 16

pub const DEFAULT_CHUNK: u64 = 65536

pub const WORD: u64 = 8

pub const BYTE_RADIX: u64 = 256

pub const BYTE_MAX: u64 = 255

pub const INT32_RADIX: u64 = 4294967296

pub const INT32_SIGN: u64 = 2147483648

pub const ORDER_EQUAL: u64 = 0

pub const ORDER_LESS: u64 = 1

pub const ORDER_GREATER: u64 = 2

pub fn round_up_align(n: u64): u64 {
    var slack = n % ARENA_ALIGN
    if slack == 0 { return n }
    n + ARENA_ALIGN - slack
}

pub fn round_down_align(n: u64): u64 {
    n - n % ARENA_ALIGN
}

pub fn compare_bytes(left: u64, right: u64, count: u64): u64 {
    var result = c_memcmp_raw(left, right, count) % INT32_RADIX
    if result == 0 { return ORDER_EQUAL }
    if result >= INT32_SIGN { return ORDER_LESS }
    ORDER_GREATER
}

pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

pub fn raw_alloc(bytes: u64): u64 {
    var block = c_aligned_alloc(ARENA_ALIGN, round_up_align(bytes))
    demand(block != 0, 20)
    block
}

pub fn raw_alloc_try(bytes: u64): u64 {
    c_aligned_alloc(ARENA_ALIGN, round_up_align(bytes))
}

pub fn store_byte(address: u64, value: u64) {
    _ = c_memset(address, value to i32, 1)
}

pub fn load_byte(address: u64, scratch: u64): u64 {
    var low: u64 = 0
    var high: u64 = BYTE_MAX
    loop {
        if low >= high { break }
        var mid = low + (high - low) / 2
        store_byte(scratch, mid)
        var order = compare_bytes(address, scratch, 1)
        if order == ORDER_EQUAL { return mid }
        if order == ORDER_LESS { high = mid - 1 } else { low = mid + 1 }
    }
    low
}

pub fn store_word(address: u64, value: u64) {
    var rest = value
    var i: u64 = 0
    loop {
        if i >= WORD { break }
        store_byte(address + i, rest % BYTE_RADIX)
        rest = rest / BYTE_RADIX
        i++
    }
}

pub fn load_word(address: u64, scratch: u64): u64 {
    var value: u64 = 0
    var place: u64 = 1
    var i: u64 = 0
    loop {
        if i >= WORD { break }
        value = value + load_byte(address + i, scratch) * place
        if i + 1 < WORD { place = place * BYTE_RADIX }
        i++
    }
    value
}
