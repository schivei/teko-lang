/**
 * The C11 aligned allocator, reached DIRECTLY as a C symbol — the arena's floor, proven in
 * `examples/probes/arena_bottom` (`nm -u` shows `U aligned_alloc@GLIBC_2.16`). The address is
 * carried as a `u64` because the checker defines no `uptr <-> u64` cast and an arena IS address
 * arithmetic; `u64` is ABI-identical to `void *` on every 64-bit target.
 *
 * @param alignment  the required base alignment in bytes; must be a power of two
 * @param size       the block size in bytes; C11 requires it to be a multiple of `alignment`
 * @return           the block's base address, or 0 on failure
 */
pub extern fn c_aligned_alloc(alignment: u64, size: u64) -> u64 = "aligned_alloc"

/**
 * The C deallocator — the counterpart of `c_aligned_alloc`, and what `tk_chunk_free` does today.
 * Every block this arena hands to the deallocator is a base address it got from
 * `c_aligned_alloc`; no arena interior pointer ever reaches here.
 *
 * @param block  the base address to release; 0 is a documented no-op
 * @return       nothing
 */
pub extern fn c_free(block: u64) -> void = "free"

/**
 * The C byte-fill primitive — the arena's raw WRITE bottom. Every store this unit performs is a
 * one-byte `memset`, and `TEKO_MEM_PARANOID`'s poison is a bulk one (the C twin's
 * `memset(p, 0xDD, usable)`).
 *
 * @param block  the base address to fill
 * @param value  the fill byte, passed in an `i32` as C's signature requires
 * @param count  how many bytes to fill
 * @return       `block`, as C's `memset` returns its destination
 */
pub extern fn c_memset(block: u64, value: i32, count: u64) -> u64 = "memset"

/**
 * The C block-compare primitive — the arena's raw READ bottom. C specifies the return as the sign
 * of the difference of the first differing byte pair, INTERPRETED AS UNSIGNED CHAR, which is what
 * makes `load_byte`'s binary search below exact rather than approximate.
 *
 * DECLARED `u64`, NOT `i32`, ON PURPOSE. The native backend does not narrow an `extern fn`'s `i32`
 * return: the callee leaves the upper 32 bits of the return register unspecified (the SysV ABI
 * permits it, and glibc's `memcmp` uses that permission), and Teko then compares the FULL 64-bit
 * register — so `memcmp("\x07", "\xc8", 1)`, a true -193, reads as a huge POSITIVE. Measured here:
 * a plain negative `i32` local compares below zero correctly, while the same comparison on this
 * call's result fails, and still fails after an explicit `to i64`. Taking the value as `u64` and
 * extracting the low 32 bits (`compare_bytes` below) recovers the C `int` exactly, with no
 * dependence on the unspecified half.
 *
 * @param left   the first block's base address
 * @param right  the second block's base address
 * @param count  how many bytes to compare
 * @return       the return register in full; only its low 32 bits are the C result
 */
pub extern fn c_memcmp_raw(left: u64, right: u64, count: u64) -> u64 = "memcmp"

/**
 * The C block-copy primitive, used where a grown array must carry its old contents over — the
 * per-region entry table's doubling, which the C twin expresses as `realloc`.
 *
 * @param dst    the destination base address
 * @param src    the source base address
 * @param count  how many bytes to copy
 * @return       `dst`, as C's `memcpy` returns its destination
 */
pub extern fn c_memcpy(dst: u64, src: u64, count: u64) -> u64 = "memcpy"

/** The arena's payload alignment: the C twin's `TK_ARENA_ALIGN`, 16 on every supported target. */
pub const ARENA_ALIGN: u64 = 16

/** The default chunk payload the arena requests: the C twin's `TK_REGION_DEFAULT_CHUNK`. */
pub const DEFAULT_CHUNK: u64 = 65536

/** The width of the machine word every arena field occupies. */
pub const WORD: u64 = 8

/** The number of distinct values one byte holds, the radix of the word's byte decomposition. */
pub const BYTE_RADIX: u64 = 256

/** The largest value one byte can hold, the upper bound of `load_byte`'s search. */
pub const BYTE_MAX: u64 = 255

/** The number of distinct values a 32-bit C `int` holds, the modulus that recovers one. */
pub const INT32_RADIX: u64 = 4294967296

/** The smallest 32-bit value whose sign bit is set — the boundary between a C `int`'s halves. */
pub const INT32_SIGN: u64 = 2147483648

/** `compare_bytes`: the two blocks hold identical bytes. */
pub const ORDER_EQUAL: u64 = 0

/** `compare_bytes`: the left block sorts before the right one. */
pub const ORDER_LESS: u64 = 1

/** `compare_bytes`: the left block sorts after the right one. */
pub const ORDER_GREATER: u64 = 2


/**
 * Rounds a size up to the arena's payload alignment — the `(n + 15) & ~15` the C twin applies to
 * every request and to every bump offset. Expressed as arithmetic rather than bit masking because
 * the two agree exactly for a power-of-two alignment and the arithmetic form needs no cast.
 *
 * @param n  the size or offset to round
 * @return   the smallest multiple of `ARENA_ALIGN` that is at least `n`
 */
pub fn round_up_align(n: u64) -> u64 {
    let slack = n % ARENA_ALIGN
    if slack == 0 { return n }
    n + ARENA_ALIGN - slack
}

/**
 * Rounds a size DOWN to the arena's payload alignment — the `bytes & ~15` the C twin applies when
 * PARKING a freed block. Floor, never ceil: the caller's byte count is a true lower bound of the
 * block's extent, and announcing a parked block larger than it really is would let a later
 * allocation overrun the bump-adjacent neighbour.
 *
 * @param n  the size to round
 * @return   the largest multiple of `ARENA_ALIGN` that is at most `n`
 */
pub fn round_down_align(n: u64) -> u64 {
    n - n % ARENA_ALIGN
}

/**
 * Compares two raw blocks and reports the ordering as one of `ORDER_EQUAL`/`ORDER_LESS`/
 * `ORDER_GREATER` — a sign-free result, because the sign is exactly what cannot be trusted across
 * this call (see `c_memcmp_raw`). The C `int` is recovered as the low 32 bits of the return
 * register, and its sign is read from bit 31 rather than from the machine's comparison.
 *
 * @param left   the first block's base address
 * @param right  the second block's base address
 * @param count  how many bytes to compare
 * @return       `ORDER_EQUAL`, `ORDER_LESS`, or `ORDER_GREATER`
 */
pub fn compare_bytes(left: u64, right: u64, count: u64) -> u64 {
    let result = c_memcmp_raw(left, right, count) % INT32_RADIX
    if result == 0 { return ORDER_EQUAL }
    if result >= INT32_SIGN { return ORDER_LESS }
    ORDER_GREATER
}

/**
 * Fails loudly when an arena invariant does not hold, exiting with the invariant's own code so a
 * failure names itself. The native backend refuses a `str` local threaded into `panic`
 * (`N1: not a fat-pointer local`), and this unit is native-only, so codes replace messages.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

/**
 * Acquires a raw block of `bytes` bytes at the arena's payload alignment, failing loudly when the
 * allocator cannot satisfy it. This is the ONE place the whole unit obtains memory, so every
 * address it manipulates is a legal `c_free` argument. Exits 20 on an unsatisfiable request.
 *
 * @param bytes  the block size; rounded up to `ARENA_ALIGN` as C11's `aligned_alloc` requires
 * @return       the block's base address, never 0
 */
pub fn raw_alloc(bytes: u64) -> u64 {
    let block = c_aligned_alloc(ARENA_ALIGN, round_up_align(bytes))
    demand(block != 0, 20)
    block
}

/**
 * Acquires a raw block WITHOUT failing loudly — the try-then-retry shape `tk_region_alloc` needs
 * when a large chunk request fails and the exact request size may still succeed, which is what
 * keeps this arena's out-of-memory edge where the old `malloc(n)` had it.
 *
 * @param bytes  the block size; rounded up to `ARENA_ALIGN`
 * @return       the block's base address, or 0 when the allocator refuses
 */
pub fn raw_alloc_try(bytes: u64) -> u64 {
    c_aligned_alloc(ARENA_ALIGN, round_up_align(bytes))
}

/**
 * Writes one byte at an address — the whole raw store surface, from which `store_word` is built.
 *
 * @param address  where to write
 * @param value    the byte value, 0..255
 * @return         nothing
 */
pub fn store_byte(address: u64, value: u64) {
    _ = c_memset(address, value to i32, 1)
}

/**
 * Reads one byte at an address by binary-searching its value with `c_memcmp` against a scratch
 * byte. C defines `memcmp`'s result as the sign of the first differing byte pair interpreted as
 * UNSIGNED CHAR, so each comparison halves the candidate range exactly, and eight halvings pin
 * any byte.
 *
 * THE SEAM (docs/design/arena-em-teko.md, P1). This function exists only because Teko cannot read
 * a machine word at a computed address: there is no `teko::mem::load_u64` in
 * `src/checker/scope.tks::builtin_fn`, and `bytes_from_ptr` — which does read raw memory —
 * ALLOCATES its `[]byte` result, which is the very circularity that blocked
 * `src/runtime/teko_rt.tks`. Once P1 lands, `load_word` becomes one `LLoad` and this search and
 * its scratch block disappear; nothing above this line changes.
 *
 * @param address  where to read
 * @param scratch  a caller-owned raw byte the search may overwrite
 * @return         the byte value at `address`, 0..255
 */
pub fn load_byte(address: u64, scratch: u64) -> u64 {
    mut low: u64 = 0
    mut high: u64 = BYTE_MAX
    loop {
        if low >= high { break }
        let mid = low + (high - low) / 2
        store_byte(scratch, mid)
        let order = compare_bytes(address, scratch, 1)
        if order == ORDER_EQUAL { return mid }
        if order == ORDER_LESS { high = mid - 1 } else { low = mid + 1 }
    }
    low
}

/**
 * Writes a machine word at an address, little-endian — the byte order of every supported target,
 * and the order `load_word` reads back. Eight one-byte stores, because a raw multi-byte store does
 * not exist in Teko (P1); once it does, this is one `LStore`.
 *
 * @param address  where to write
 * @param value    the word to write
 * @return         nothing
 */
pub fn store_word(address: u64, value: u64) {
    mut rest = value
    mut i: u64 = 0
    loop {
        if i >= WORD { break }
        store_byte(address + i, rest % BYTE_RADIX)
        rest = rest / BYTE_RADIX
        i++
    }
}

/**
 * Reads a machine word at an address, little-endian, using one caller-owned scratch byte for the
 * whole word. The scratch is threaded in rather than allocated here so a read costs no allocation:
 * an allocator whose own reads allocate does not terminate.
 *
 * @param address  where to read
 * @param scratch  a caller-owned raw byte the read may overwrite
 * @return         the word at `address`
 */
pub fn load_word(address: u64, scratch: u64) -> u64 {
    mut value: u64 = 0
    mut place: u64 = 1
    mut i: u64 = 0
    loop {
        if i >= WORD { break }
        value = value + load_byte(address + i, scratch) * place
        if i + 1 < WORD { place = place * BYTE_RADIX }
        i++
    }
    value
}
