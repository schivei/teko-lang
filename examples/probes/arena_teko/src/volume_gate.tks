/** The chunk count must match the C twin's packing rule exactly; exit code when it does not. */
pub const E_PACKING: i32 = 71

/** A drop-and-reallocate cycle must return memory to the allocator; exit code when it does not. */
pub const E_VOLUME_LEAK: i32 = 72

/** Every block handed out under volume must be distinct and aligned; exit code otherwise. */
pub const E_VOLUME_BLOCK: i32 = 73

/** How many create-fill-drop cycles the volume proof runs. */
pub const VOLUME_CYCLES: u64 = 400

/** How many blocks each volume cycle allocates. */
pub const VOLUME_BLOCKS: u64 = 32

/** How many bytes each volume block asks for: eight to a default chunk, exactly. */
pub const VOLUME_BLOCK_BYTES: u64 = 8192

/**
 * How few cycles may land on a fresh chunk address before the run counts as leaking. A run whose
 * drops really hand memory back reuses the same addresses cycle after cycle; a run that leaked
 * would move to a fresh address every single time, so requiring most cycles to reuse separates the
 * two without depending on any particular allocator's exact recycling order.
 */
pub const VOLUME_REUSE_MAJORITY: u64 = 2

/**
 * How many allocations of `size` bytes a default chunk holds, under the C twin's rule: the request
 * is rounded up to the arena's alignment and the chunk is bump-filled from offset zero, so the
 * count is the plain floor of the capacity over the aligned size.
 *
 * @param size  the requested block size in bytes
 * @return      how many such blocks one default chunk serves, at least one
 */
pub fn blocks_per_default_chunk(size: u64): u64 {
    var aligned = round_up_align(if size == 0 { 1 } else { size })
    if aligned >= DEFAULT_CHUNK { return 1 }
    DEFAULT_CHUNK / aligned
}

/**
 * How many chunks `count` allocations of `size` bytes must occupy — the prediction the measured
 * chunk list is compared against. Predicting the count from the rule, rather than from a previous
 * run, is what makes this a comparison with the C twin's behaviour and not with itself.
 *
 * @param count  how many blocks are allocated
 * @param size   each block's requested size in bytes
 * @return       the number of chunks the region must hold afterwards
 */
pub fn predicted_chunks(count: u64, size: u64): u64 {
    var per_chunk = blocks_per_default_chunk(size)
    var whole = count / per_chunk
    if count % per_chunk == 0 { return whole }
    whole + 1
}

/**
 * Demands a fresh region's chunk list matches the prediction after `count` allocations of `size`,
 * and that every block is distinct from the one before it and lands on the arena's alignment.
 *
 * @param control  the control block's base address
 * @param count    how many blocks to allocate
 * @param size     each block's requested size in bytes
 * @return         nothing
 */
pub fn demand_packing(control: u64, count: u64, size: u64) {
    var region = region_new(control, 0)
    var previous: u64 = 0
    var i: u64 = 0
    loop {
        if i >= count { break }
        var block = region_alloc(control, region, size)
        demand(block != previous, E_VOLUME_BLOCK)
        demand(block % ARENA_ALIGN == 0, E_VOLUME_BLOCK)
        previous = block
        i++
    }
    demand(chunk_count(control, region) == predicted_chunks(count, size), E_PACKING)
    region_drop(control, region)
}

/**
 * Runs one create-fill-drop cycle and reports the first chunk's base address, so the caller can
 * see whether a dropped region's memory really goes back to the allocator.
 *
 * @param control  the control block's base address
 * @return         the address of the region's last chunk base, or 0 when it allocated none
 */
pub fn volume_cycle(control: u64): u64 {
    var region = region_new(control, 0)
    var i: u64 = 0
    loop {
        if i >= VOLUME_BLOCKS { break }
        var block = region_alloc(control, region, VOLUME_BLOCK_BYTES)
        demand(block != 0, E_VOLUME_BLOCK)
        i++
    }
    var head = region_get(control, region, REGION_HEAD)
    region_drop(control, region)
    head
}

/**
 * Demands that allocating, dropping and reallocating in volume returns memory rather than
 * accumulating it: most cycles must land on the very chunk address the first cycle used, which
 * only happens if each drop really handed its blocks back to the allocator. A leaking arena would
 * move to a fresh address every cycle and match none.
 *
 * The process's peak resident set would be the other observable, but `teko::mem::peak_rss()` does
 * not link on the native backend — it lowers to an undefined symbol `peak_rss` rather than to the
 * runtime's, so the binary fails at link time.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_volume_reclaims(control: u64) {
    var first = volume_cycle(control)
    var matched: u64 = 0
    var cycle: u64 = 1
    loop {
        if cycle >= VOLUME_CYCLES { break }
        if volume_cycle(control) == first { matched++ }
        cycle++
    }
    demand(matched * VOLUME_REUSE_MAJORITY > VOLUME_CYCLES, E_VOLUME_LEAK)
}

/**
 * Runs the volume gate: the packing prediction across the sizes where a bump allocator's rounding
 * shows — below, at and above the alignment, at a fraction of the chunk, and above the whole chunk
 * — then the drop-and-reallocate cycle that proves the memory comes back.
 *
 * @return  `GATE_OK` when the volume behaviour matches; any other exit names the invariant
 */
pub fn run_volume_gate(): i32 {
    var control = control_new()
    demand_packing(control, 100, 1)
    demand_packing(control, 100, ARENA_ALIGN)
    demand_packing(control, 100, ARENA_ALIGN + 1)
    demand_packing(control, 500, 64)
    demand_packing(control, 300, 1024)
    demand_packing(control, 200, 4096)
    demand_packing(control, 40, DEFAULT_CHUNK / 2)
    demand_packing(control, 8, DEFAULT_CHUNK)
    demand_packing(control, 8, DEFAULT_CHUNK * 3)
    demand_volume_reclaims(control)
    regions_free_all(control)
    control_free(control)
    GATE_OK
}
