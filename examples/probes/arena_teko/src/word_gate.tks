pub const GATE_OK: i32 = 42

pub const E_WORD_ROUNDTRIP: i32 = 30

pub const E_WORD_NEIGHBOUR: i32 = 31

pub const E_ROUND_UP: i32 = 32

pub const E_ROUND_DOWN: i32 = 33

pub fn demand_word_roundtrip(slot: u64, scratch: u64, value: u64) {
    store_word(slot, value)
    demand(load_word(slot, scratch) == value, E_WORD_ROUNDTRIP)
}

pub fn demand_no_neighbour_bleed(first: u64, scratch: u64) {
    var second = first + WORD
    store_word(first, 0)
    store_word(second, 0)
    store_word(first, 18446744073709551615)
    demand(load_word(second, scratch) == 0, E_WORD_NEIGHBOUR)
    store_word(second, 18446744073709551615)
    store_word(first, 0)
    demand(load_word(second, scratch) == 18446744073709551615, E_WORD_NEIGHBOUR)
}

pub fn demand_round_up(n: u64) {
    var r = round_up_align(n)
    demand(r >= n, E_ROUND_UP)
    demand(r % ARENA_ALIGN == 0, E_ROUND_UP)
    demand(r - n < ARENA_ALIGN, E_ROUND_UP)
}

pub fn demand_round_down(n: u64) {
    var r = round_down_align(n)
    demand(r <= n, E_ROUND_DOWN)
    demand(r % ARENA_ALIGN == 0, E_ROUND_DOWN)
    demand(n - r < ARENA_ALIGN, E_ROUND_DOWN)
}

pub fn demand_word_edge_values(slot: u64, scratch: u64) {
    demand_word_roundtrip(slot, scratch, 0)
    demand_word_roundtrip(slot, scratch, 1)
    demand_word_roundtrip(slot, scratch, 255)
    demand_word_roundtrip(slot, scratch, 256)
    demand_word_roundtrip(slot, scratch, 18446744073709551615)
    demand_word_roundtrip(slot, scratch, 12297829382473034410)
    demand_word_roundtrip(slot, scratch, 6148914691236517205)
    demand_word_roundtrip(slot, scratch, 18374686479671623680)
    demand_word_roundtrip(slot, scratch, 65536)
    demand_word_roundtrip(slot, scratch, 4294967296)
}

pub fn demand_alignment_rounding() {
    demand_round_up(0)
    demand_round_up(1)
    demand_round_up(ARENA_ALIGN - 1)
    demand_round_up(ARENA_ALIGN)
    demand_round_up(ARENA_ALIGN + 1)
    demand_round_up(DEFAULT_CHUNK)
    demand_round_up(DEFAULT_CHUNK + 1)
    demand_round_down(0)
    demand_round_down(1)
    demand_round_down(ARENA_ALIGN - 1)
    demand_round_down(ARENA_ALIGN)
    demand_round_down(ARENA_ALIGN + 1)
    demand_round_down(DEFAULT_CHUNK + 1)
}

pub fn run_word_gate(): i32 {
    demand_alignment_rounding()
    var block = raw_alloc(ARENA_ALIGN * 4)
    var scratch = block
    var slot = block + ARENA_ALIGN
    demand_word_edge_values(slot, scratch)
    demand_no_neighbour_bleed(slot, scratch)
    c_free(block)
    GATE_OK
}
