/** The exit code a fully passing gate reports. */
pub const GATE_OK: i32 = 42

/** A word written and read back must compare equal; exit code when it does not. */
pub const E_WORD_ROUNDTRIP: i32 = 30

/** Adjacent words must not bleed into each other; exit code when one does. */
pub const E_WORD_NEIGHBOUR: i32 = 31

/** Rounding up must land on a multiple of the alignment and never shrink; exit code on failure. */
pub const E_ROUND_UP: i32 = 32

/** Rounding down must land on a multiple of the alignment and never grow; exit code on failure. */
pub const E_ROUND_DOWN: i32 = 33

/**
 * Writes a word, reads it back, and demands the value survived — the round trip that makes every
 * chunk header and region field in this arena trustworthy. Exits `E_WORD_ROUNDTRIP` on a mismatch.
 *
 * @param slot     the address to write and read
 * @param scratch  a caller-owned raw byte the read may overwrite
 * @param value    the word to round-trip
 * @return         nothing
 */
pub fn demand_word_roundtrip(slot: u64, scratch: u64, value: u64) {
    store_word(slot, value)
    demand(load_word(slot, scratch) == value, E_WORD_ROUNDTRIP)
}

/**
 * Demands a word write does not disturb the word next to it. A store that bled one byte past its
 * width would corrupt the neighbouring header field — `used` bleeding into `cap` is exactly the
 * corruption class this arena must never have — and would be invisible to a round-trip test alone.
 *
 * @param first    the first of two adjacent word slots
 * @param scratch  a caller-owned raw byte the reads may overwrite
 * @return         nothing
 */
pub fn demand_no_neighbour_bleed(first: u64, scratch: u64) {
    var second = first + WORD
    store_word(first, 0)
    store_word(second, 0)
    store_word(first, 18446744073709551615)
    demand(load_word(second, scratch) == 0, E_WORD_NEIGHBOUR)
    store_word(second, 18446744073709551615)
    store_word(first, 0)
    demand(load_word(second, scratch) == 18446744073709551615, E_WORD_NEIGHBOUR)
}

/**
 * Demands `round_up_align` never shrinks a value and always lands on the alignment — the property
 * every bump offset and every allocation size depends on. Exits `E_ROUND_UP` on a violation.
 *
 * @param n  the value to round
 * @return   nothing
 */
pub fn demand_round_up(n: u64) {
    var r = round_up_align(n)
    demand(r >= n, E_ROUND_UP)
    demand(r % ARENA_ALIGN == 0, E_ROUND_UP)
    demand(r - n < ARENA_ALIGN, E_ROUND_UP)
}

/**
 * Demands `round_down_align` never grows a value and always lands on the alignment — the property
 * that keeps a parked block's announced size within its true extent. Exits `E_ROUND_DOWN`.
 *
 * @param n  the value to round
 * @return   nothing
 */
pub fn demand_round_down(n: u64) {
    var r = round_down_align(n)
    demand(r <= n, E_ROUND_DOWN)
    demand(r % ARENA_ALIGN == 0, E_ROUND_DOWN)
    demand(n - r < ARENA_ALIGN, E_ROUND_DOWN)
}

/**
 * Round-trips the word values that break a naive byte-splitting store: zero, one, the all-ones
 * word, the alternating patterns, and a value whose top byte is set while the rest is not.
 *
 * @param slot     the address to write and read
 * @param scratch  a caller-owned raw byte the reads may overwrite
 * @return         nothing
 */
pub fn demand_word_edge_values(slot: u64, scratch: u64) {
    demand_word_roundtrip(slot, scratch, 0)
    demand_word_roundtrip(slot, scratch, 1)
    demand_word_roundtrip(slot, scratch, 255)
    demand_word_roundtrip(slot, scratch, 256)
    demand_word_roundtrip(slot, scratch, 18446744073709551615)
    demand_word_roundtrip(slot, scratch, 12297829382473034410)
    demand_word_roundtrip(slot, scratch, 6148914691236517205)
    demand_word_roundtrip(slot, scratch, 18374686479671623680)
    demand_word_roundtrip(slot, scratch, 65536)
    demand_word_roundtrip(slot, scratch, 4294967296)
}

/**
 * Demands the alignment rounding holds across the boundaries where an off-by-one hides: exactly on
 * the alignment, one below it, one above it, and around the default chunk size.
 *
 * @return  nothing
 */
pub fn demand_alignment_rounding() {
    demand_round_up(0)
    demand_round_up(1)
    demand_round_up(ARENA_ALIGN - 1)
    demand_round_up(ARENA_ALIGN)
    demand_round_up(ARENA_ALIGN + 1)
    demand_round_up(DEFAULT_CHUNK)
    demand_round_up(DEFAULT_CHUNK + 1)
    demand_round_down(0)
    demand_round_down(1)
    demand_round_down(ARENA_ALIGN - 1)
    demand_round_down(ARENA_ALIGN)
    demand_round_down(ARENA_ALIGN + 1)
    demand_round_down(DEFAULT_CHUNK + 1)
}

/**
 * Runs the word-seam gate: alignment rounding, word round trips over the values that break a naive
 * byte split, and the neighbour-bleed check. Nothing else in this arena can be trusted until this
 * passes, because every chunk header and every region field is stored and read through it.
 *
 * @return  `GATE_OK` when the seam holds; any other exit names the invariant that broke
 */
pub fn run_word_gate(): i32 {
    demand_alignment_rounding()
    var block = raw_alloc(ARENA_ALIGN * 4)
    var scratch = block
    var slot = block + ARENA_ALIGN
    demand_word_edge_values(slot, scratch)
    demand_no_neighbour_bleed(slot, scratch)
    c_free(block)
    GATE_OK
}
