pub extern fn c_getenv(name: u64): u64 = "getenv"

pub fn spell_paranoid_var(block: u64) {
    store_byte(block, ASCII_T)
    store_byte(block + 1, ASCII_E)
    store_byte(block + 2, ASCII_K)
    store_byte(block + 3, ASCII_O)
    store_byte(block + 4, ASCII_UNDERSCORE)
    store_byte(block + 5, ASCII_M)
    store_byte(block + 6, ASCII_E)
    store_byte(block + 7, ASCII_M)
    store_byte(block + 8, ASCII_UNDERSCORE)
    store_byte(block + 9, ASCII_P)
    store_byte(block + 10, ASCII_A)
    store_byte(block + 11, ASCII_R)
    store_byte(block + 12, ASCII_A)
    store_byte(block + 13, ASCII_N)
    store_byte(block + 14, ASCII_O)
    store_byte(block + 15, ASCII_I)
    store_byte(block + 16, ASCII_D)
    store_byte(block + 17, ASCII_NUL)
}

pub fn ctrl_get(control: u64, field: u64): u64 {
    load_word(control + field, control + CTRL_SCRATCH)
}

pub fn ctrl_set(control: u64, field: u64, value: u64) {
    store_word(control + field, value)
}

pub fn ctrl_scratch(control: u64): u64 {
    control + CTRL_SCRATCH
}

pub fn ctrl_load(control: u64, address: u64): u64 {
    load_word(address, ctrl_scratch(control))
}

pub fn control_new(): u64 {
    var control = raw_alloc(CTRL_BYTES)
    _ = c_memset(control, 0, CTRL_BYTES)
    ctrl_set(control, CTRL_MAGIC, CTRL_MAGIC_VALUE)
    ctrl_set(control, CTRL_PARANOID, PARANOID_UNPROBED)
    control
}

pub fn control_is_live(control: u64): bool {
    ctrl_get(control, CTRL_MAGIC) == CTRL_MAGIC_VALUE
}

pub fn paranoid_enabled(control: u64): bool {
    var cached = ctrl_get(control, CTRL_PARANOID)
    if cached != PARANOID_UNPROBED { return cached == PARANOID_ON }
    var probed = if paranoid_env_is_set() { PARANOID_ON } else { PARANOID_OFF }
    ctrl_set(control, CTRL_PARANOID, probed)
    probed == PARANOID_ON
}

pub fn paranoid_env_is_set(): bool {
    var block = raw_alloc(PARANOID_PROBE_BYTES)
    spell_paranoid_var(block)
    var value = c_getenv(block)
    var held = false
    if value != 0 { held = load_byte(value, block + PARANOID_VAR_BYTES) != 0 }
    c_free(block)
    held
}

pub fn control_free(control: u64) {
    c_free(control)
}
