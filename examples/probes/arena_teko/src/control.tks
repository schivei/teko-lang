/**
 * The C environment reader, reached DIRECTLY as a C symbol. It takes and returns raw addresses, so
 * the oracle's probe needs no Teko string and no allocation on the arena's own path.
 *
 * @param name  the address of a NUL-terminated variable name
 * @return      the address of the NUL-terminated value, or 0 when the variable is unset
 */
pub extern fn c_getenv(name: u64) -> u64 = "getenv"

/**
 * Spells `TEKO_MEM_PARANOID`, NUL-terminated, into a raw block. Written byte by byte because Teko
 * offers no way to take the address of a rodata string literal (docs/design/arena-em-teko.md, P3),
 * and the oracle's probe must not depend on a Teko string.
 *
 * @param block  the base address of a block of at least `PARANOID_VAR_BYTES` bytes
 * @return       nothing
 */
pub fn spell_paranoid_var(block: u64) {
    store_byte(block, ASCII_T)
    store_byte(block + 1, ASCII_E)
    store_byte(block + 2, ASCII_K)
    store_byte(block + 3, ASCII_O)
    store_byte(block + 4, ASCII_UNDERSCORE)
    store_byte(block + 5, ASCII_M)
    store_byte(block + 6, ASCII_E)
    store_byte(block + 7, ASCII_M)
    store_byte(block + 8, ASCII_UNDERSCORE)
    store_byte(block + 9, ASCII_P)
    store_byte(block + 10, ASCII_A)
    store_byte(block + 11, ASCII_R)
    store_byte(block + 12, ASCII_A)
    store_byte(block + 13, ASCII_N)
    store_byte(block + 14, ASCII_O)
    store_byte(block + 15, ASCII_I)
    store_byte(block + 16, ASCII_D)
    store_byte(block + 17, ASCII_NUL)
}

/**
 * Reads a control-block field, borrowing the control block's own scratch byte for the raw read.
 *
 * @param control  the control block's base address
 * @param field    the field's offset within the block
 * @return         the field's current value
 */
pub fn ctrl_get(control: u64, field: u64) -> u64 {
    load_word(control + field, control + CTRL_SCRATCH)
}

/**
 * Writes a control-block field.
 *
 * @param control  the control block's base address
 * @param field    the field's offset within the block
 * @param value    the value to store
 * @return         nothing
 */
pub fn ctrl_set(control: u64, field: u64, value: u64) {
    store_word(control + field, value)
}

/**
 * Reads the scratch byte's address — the one raw byte every read in this arena borrows. Split out
 * as a named accessor so no call site has to know where in the control block it sits.
 *
 * @param control  the control block's base address
 * @return         the scratch byte's address
 */
pub fn ctrl_scratch(control: u64) -> u64 {
    control + CTRL_SCRATCH
}

/**
 * Reads a machine word at an address using the control block's scratch byte — the read every
 * chunk, region, entry and mark access goes through.
 *
 * @param control  the control block's base address
 * @param address  where to read
 * @return         the word at `address`
 */
pub fn ctrl_load(control: u64, address: u64) -> u64 {
    load_word(address, ctrl_scratch(control))
}

/**
 * Opens a fresh control block: one zeroed raw block holding the arena's roots, the mark stack and
 * the free bins. It is zeroed rather than field-by-field initialized because every field's initial
 * value IS zero — an empty registry, no root, generation 0, depth 0, no parked blocks — except the
 * magic sentinel and the unprobed paranoid state, which are written after.
 *
 * THE SEAM (docs/design/arena-em-teko.md, P2). In the real arena this block's address lives in one
 * module-level mutable word, because `tk_alloc` is called by generated code that carries no state.
 * Teko has module `const` and type-level `static fn`, but no mutable module state, so here the
 * address is threaded explicitly — which also makes every function below independently testable.
 *
 * @return  the control block's base address
 */
pub fn control_new() -> u64 {
    let control = raw_alloc(CTRL_BYTES)
    _ = c_memset(control, 0, CTRL_BYTES)
    ctrl_set(control, CTRL_MAGIC, CTRL_MAGIC_VALUE)
    ctrl_set(control, CTRL_PARANOID, PARANOID_UNPROBED)
    control
}

/**
 * Tests whether a control block carries its sentinel — the check a fixed-address control page
 * would use to tell a fresh mapping from a live one.
 *
 * @param control  the control block's base address
 * @return         true when the block was initialized by `control_new`
 */
pub fn control_is_live(control: u64) -> bool {
    ctrl_get(control, CTRL_MAGIC) == CTRL_MAGIC_VALUE
}

/**
 * Reads whether the memory oracle is on, probing the environment at most once and caching the
 * answer — the C twin's `static int tk_paranoid` with its `-1` unprobed state.
 *
 * The probe reads `TEKO_MEM_PARANOID` through `teko::env::var`, which allocates its result outside
 * this arena. That is why the probe happens ONCE, lazily, on the first free: it must never sit on
 * the allocation path. The allocation-free form needs the address of a NUL-terminated rodata
 * literal (docs/design/arena-em-teko.md, P3).
 *
 * @param control  the control block's base address
 * @return         true when `TEKO_MEM_PARANOID` is set to a non-empty value
 */
pub fn paranoid_enabled(control: u64) -> bool {
    let cached = ctrl_get(control, CTRL_PARANOID)
    if cached != PARANOID_UNPROBED { return cached == PARANOID_ON }
    let probed = if paranoid_env_is_set() { PARANOID_ON } else { PARANOID_OFF }
    ctrl_set(control, CTRL_PARANOID, probed)
    probed == PARANOID_ON
}

/**
 * Reads `TEKO_MEM_PARANOID` and reports whether it is set to a non-empty value — the environment
 * half of the oracle's probe, split out so the caching half above stays a pure state transition.
 *
 * It reaches `getenv` directly with a NUL-terminated name it spells into a raw block, rather than
 * through `teko::env::var`. Two reasons, and both matter: `teko::env::var` returns `str | error`,
 * and the native backend cannot lower a match on a fat-pointer receiver
 * (`fat-pointer receiver match-expression not yet lowered (N2)`); and its result would be
 * allocated, which is exactly what the arena must not depend on. This form allocates one small
 * block, frees it, and touches no Teko string at all.
 *
 * @return  true when the variable is set and non-empty
 */
pub fn paranoid_env_is_set() -> bool {
    let block = raw_alloc(PARANOID_PROBE_BYTES)
    spell_paranoid_var(block)
    let value = c_getenv(block)
    mut held = false
    if value != 0 { held = load_byte(value, block + PARANOID_VAR_BYTES) != 0 }
    c_free(block)
    held
}

/**
 * Releases a control block. Every region it still owns must already be gone — `regions_free_all`
 * is the call that guarantees it — because this only releases the block itself.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn control_free(control: u64) {
    c_free(control)
}
