pub const FREE_BIN_MAX_BYTES: u64 = 65536

pub const FREE_LARGE_SCAN: u64 = 32

pub fn free_bin_slot(control: u64, bytes: u64): u64 {
    control + CTRL_FREE_BINS + (bytes / ARENA_ALIGN - 1) * WORD
}

pub fn free_is_binnable(bytes: u64): bool {
    if bytes == 0 { return false }
    bytes <= FREE_BIN_MAX_BYTES
}

pub fn freenode_get(control: u64, node: u64, field: u64): u64 {
    ctrl_load(control, node + field)
}

pub fn free_purge(control: u64) {
    _ = c_memset(control + CTRL_FREE_BINS, 0, FREE_BINS * WORD)
    ctrl_set(control, CTRL_FREE_LARGE, 0)
}

pub fn free_take_binned(control: u64, size: u64): u64 {
    var slot = free_bin_slot(control, size)
    var node = load_word(slot, ctrl_scratch(control))
    if node == 0 { return 0 }
    store_word(slot, freenode_get(control, node, FREENODE_NEXT))
    node
}

pub fn free_block_fits(bytes: u64, size: u64): bool {
    if bytes < size { return false }
    bytes <= size * 2
}

pub fn free_take_large(control: u64, size: u64): u64 {
    var prev: u64 = 0
    var node = ctrl_get(control, CTRL_FREE_LARGE)
    var scanned: u64 = 0
    loop {
        if node == 0 { break }
        if scanned >= FREE_LARGE_SCAN { break }
        var next = freenode_get(control, node, FREENODE_NEXT)
        var bytes = freenode_get(control, node, FREENODE_BYTES)
        if free_block_fits(bytes, size) {
            if prev == 0 { ctrl_set(control, CTRL_FREE_LARGE, next) } else { store_word(prev + FREENODE_NEXT, next) }
            return node
        }
        prev = node
        node = next
        scanned++
    }
    0
}

pub fn free_take(control: u64, size: u64): u64 {
    var wanted = round_up_align(size)
    if free_is_binnable(wanted) { return free_take_binned(control, wanted) }
    free_take_large(control, wanted)
}

pub fn free_park(control: u64, block: u64, usable: u64) {
    store_word(block + FREENODE_BYTES, usable)
    if free_is_binnable(usable) {
        var slot = free_bin_slot(control, usable)
        store_word(block + FREENODE_NEXT, load_word(slot, ctrl_scratch(control)))
        store_word(slot, block)
        return
    }
    store_word(block + FREENODE_NEXT, ctrl_get(control, CTRL_FREE_LARGE))
    ctrl_set(control, CTRL_FREE_LARGE, block)
}

pub fn free_block(control: u64, block: u64, bytes: u64) {
    if block == 0 { return }
    var usable = round_down_align(bytes)
    if paranoid_enabled(control) {
        if usable > 0 { _ = c_memset(block, POISON_BYTE, usable) }
        return
    }
    if usable < FREENODE_BYTES_MIN { return }
    free_park(control, block, usable)
}
