/** The largest block a size class can hold; anything bigger goes on the large list. */
pub const FREE_BIN_MAX_BYTES: u64 = 65536

/** How far the large list is scanned before giving up, so a long list never goes quadratic. */
pub const FREE_LARGE_SCAN: u64 = 32

/**
 * The address of the free bin holding blocks of exactly `bytes` usable bytes. Class `i` holds
 * `(i + 1) * ARENA_ALIGN` bytes, so the alignment granularity and the bin granularity are the same
 * number — which is what makes a single probe an exact-size hit rather than a guess.
 *
 * @param control  the control block's base address
 * @param bytes    an already-aligned, non-zero block size within `FREE_BIN_MAX_BYTES`
 * @return         the bin slot's address
 */
pub fn free_bin_slot(control: u64, bytes: u64) -> u64 {
    control + CTRL_FREE_BINS + (bytes / ARENA_ALIGN - 1) * WORD
}

/**
 * Tests whether a block size is small enough to bin exactly.
 *
 * @param bytes  the already-aligned block size
 * @return       true when a size class exists for it
 */
pub fn free_is_binnable(bytes: u64) -> bool {
    if bytes == 0 { return false }
    bytes <= FREE_BIN_MAX_BYTES
}

/**
 * Reads a freenode field from a parked block.
 *
 * @param control  the control block's base address
 * @param node     the parked block's base address
 * @param field    the field's offset within the freenode
 * @return         the field's current value
 */
pub fn freenode_get(control: u64, node: u64, field: u64) -> u64 {
    ctrl_load(control, node + field)
}

/**
 * Empties every free list. Called wherever the chunks the parked blocks live inside are about to
 * disappear — the rewind and the termination sweep — because a parked block whose chunk is gone is
 * a dangling address, and handing it out is silent corruption.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn free_purge(control: u64) {
    _ = c_memset(control + CTRL_FREE_BINS, 0, FREE_BINS * WORD)
    ctrl_set(control, CTRL_FREE_LARGE, 0)
}

/**
 * Takes a parked block of exactly the right size class, or 0 when the class is empty. One probe,
 * because the class is exact.
 *
 * @param control  the control block's base address
 * @param size     the already-aligned request size, within `FREE_BIN_MAX_BYTES`
 * @return         a parked block's address, or 0
 */
pub fn free_take_binned(control: u64, size: u64) -> u64 {
    let slot = free_bin_slot(control, size)
    let node = load_word(slot, ctrl_scratch(control))
    if node == 0 { return 0 }
    store_word(slot, freenode_get(control, node, FREENODE_NEXT))
    node
}

/**
 * Tests whether a parked block serves a request without a split: it must be at least the request
 * and at most twice it. There are no block headers to split with, so a block is taken whole or not
 * at all, and the upper bound is what stops a huge block from serving a small request forever.
 *
 * @param bytes  the parked block's usable size
 * @param size   the already-aligned request size
 * @return       true when the block serves the request
 */
pub fn free_block_fits(bytes: u64, size: u64) -> bool {
    if bytes < size { return false }
    bytes <= size * 2
}

/**
 * Takes a parked block off the large list that fits `size` without a split — at least the request
 * and at most twice it. There are no block headers to split with, so a block is taken whole or not
 * at all, and the upper bound is what stops a huge block from serving a small request forever. The
 * scan is bounded so a long list cannot make allocation quadratic.
 *
 * @param control  the control block's base address
 * @param size     the already-aligned request size
 * @return         a parked block's address, or 0
 */
pub fn free_take_large(control: u64, size: u64) -> u64 {
    mut prev: u64 = 0
    mut node = ctrl_get(control, CTRL_FREE_LARGE)
    mut scanned: u64 = 0
    loop {
        if node == 0 { break }
        if scanned >= FREE_LARGE_SCAN { break }
        let next = freenode_get(control, node, FREENODE_NEXT)
        let bytes = freenode_get(control, node, FREENODE_BYTES)
        if free_block_fits(bytes, size) {
            if prev == 0 { ctrl_set(control, CTRL_FREE_LARGE, next) } else { store_word(prev + FREENODE_NEXT, next) }
            return node
        }
        prev = node
        node = next
        scanned++
    }
    0
}

/**
 * Reuses an explicitly freed block for a request of `size` bytes, or reports 0 when none fits. The
 * request is rounded UP to the bin granularity — never down — so a 24-byte request can never be
 * handed a 16-byte block, which would overrun its neighbour by eight bytes. The park side rounds
 * DOWN for the mirror reason; the asymmetry is the whole safety argument.
 *
 * @param control  the control block's base address
 * @param size     the request size in bytes
 * @return         a reusable block's address, or 0
 */
pub fn free_take(control: u64, size: u64) -> u64 {
    let wanted = round_up_align(size)
    if free_is_binnable(wanted) { return free_take_binned(control, wanted) }
    free_take_large(control, wanted)
}

/**
 * Parks a block on the list its size class names, so the next request of that class reuses it.
 *
 * @param control  the control block's base address
 * @param block    the block's base address
 * @param usable   the block's already-floored usable byte count
 * @return         nothing
 */
pub fn free_park(control: u64, block: u64, usable: u64) {
    store_word(block + FREENODE_BYTES, usable)
    if free_is_binnable(usable) {
        let slot = free_bin_slot(control, usable)
        store_word(block + FREENODE_NEXT, load_word(slot, ctrl_scratch(control)))
        store_word(slot, block)
        return
    }
    store_word(block + FREENODE_NEXT, ctrl_get(control, CTRL_FREE_LARGE))
    ctrl_set(control, CTRL_FREE_LARGE, block)
}

/**
 * Frees one explicitly released block. A bump arena cannot return a block to the bump, so the block
 * is PARKED for reuse instead — which is what stops the footprint from growing in a region that is
 * never dropped. The caller's byte count is a true LOWER bound of the block's extent, so it is
 * rounded DOWN: announcing a parked block larger than it really is would let a later allocation
 * overrun the bump-adjacent neighbour. A block too small to hold a freenode is simply leaked,
 * because the bump cannot shrink.
 *
 * UNDER `TEKO_MEM_PARANOID` the block is POISONED and NEVER parked. Arena reuse is invisible to a
 * sanitizer, so a wrong linearity proof would corrupt silently; with the poison, any read of a
 * freed block yields the poison byte and the gate fails loudly instead. This is the memory oracle
 * that guards the free-old decree, and it is the one that survives the death of the C runtime.
 *
 * @param control  the control block's base address
 * @param block    the block's base address; 0 is a no-op
 * @param bytes    a lower bound of the block's usable size
 * @return         nothing
 */
pub fn free_block(control: u64, block: u64, bytes: u64) {
    if block == 0 { return }
    let usable = round_down_align(bytes)
    if paranoid_enabled(control) {
        if usable > 0 { _ = c_memset(block, POISON_BYTE, usable) }
        return
    }
    if usable < FREENODE_BYTES_MIN { return }
    free_park(control, block, usable)
}
