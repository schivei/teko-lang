/** A fresh control block must carry its sentinel; exit code when it does not. */
pub const E_CONTROL_MAGIC: i32 = 50

/** Two live allocations must never share an address; exit code when they do. */
pub const E_ALLOC_ALIAS: i32 = 51

/** Every allocation must land on the arena's payload alignment; exit code when one does not. */
pub const E_ALLOC_ALIGN: i32 = 52

/** A region must reuse its current chunk until that chunk is full; exit code when it does not. */
pub const E_ALLOC_SHARES_CHUNK: i32 = 53

/** A request larger than the default chunk must get a chunk of its own; exit code otherwise. */
pub const E_ALLOC_OVERSIZE: i32 = 54

/** Handed-out memory must be writable across its whole extent; exit code when it is not. */
pub const E_ALLOC_WRITABLE: i32 = 55

/** A dropped region must leave the live-region registry; exit code when it does not. */
pub const E_DROP_UNLINK: i32 = 56

/** The root must be opened once and stay the same region; exit code when it does not. */
pub const E_ROOT_STABLE: i32 = 57

/** Every region must carry a distinct, never-reused generation; exit code when one repeats. */
pub const E_REGION_GEN: i32 = 58

/** After the termination sweep the registry and the root must both be empty; exit code otherwise. */
pub const E_FREE_ALL_EMPTY: i32 = 59

/**
 * Counts the regions currently on the live-region registry — the observable the drop and sweep
 * checks assert on, since "did the drop actually unlink it" is not visible any other way.
 *
 * @param control  the control block's base address
 * @return         how many regions the registry holds
 */
pub fn registry_count(control: u64) -> u64 {
    mut region = ctrl_get(control, CTRL_REGS)
    mut count: u64 = 0
    loop {
        if region == 0 { break }
        count++
        region = region_get(control, region, REGION_REG_NEXT)
    }
    count
}

/**
 * Tests whether a region is currently on the live-region registry.
 *
 * @param control  the control block's base address
 * @param wanted   the region to look for
 * @return         true when the registry still holds it
 */
pub fn registry_holds(control: u64, wanted: u64) -> bool {
    mut region = ctrl_get(control, CTRL_REGS)
    loop {
        if region == 0 { break }
        if region == wanted { return true }
        region = region_get(control, region, REGION_REG_NEXT)
    }
    false
}

/**
 * Counts the chunks a region holds — the observable that tells a bump that reused its chunk from
 * one that grew a new one, which is the difference between the C twin's behaviour and a plausible
 * imitation of it.
 *
 * @param control  the control block's base address
 * @param region   the region to measure
 * @return         how many chunks the region's list holds
 */
pub fn chunk_count(control: u64, region: u64) -> u64 {
    mut chunk = region_get(control, region, REGION_HEAD)
    mut count: u64 = 0
    loop {
        if chunk == 0 { break }
        count++
        chunk = chunk_get(control, chunk, CHUNK_NEXT)
    }
    count
}

/**
 * Demands a block is writable across its whole extent by filling it and reading a byte back from
 * each end — the check that catches a bump offset that ran past its chunk's capacity.
 *
 * @param control  the control block's base address
 * @param block    the block's base address
 * @param bytes    the block's size
 * @return         nothing
 */
pub fn demand_writable(control: u64, block: u64, bytes: u64) {
    _ = c_memset(block, POISON_BYTE, bytes)
    demand(load_byte(block, ctrl_scratch(control)) == 221, E_ALLOC_WRITABLE)
    demand(load_byte(block + bytes - 1, ctrl_scratch(control)) == 221, E_ALLOC_WRITABLE)
}

/**
 * Demands small allocations SHARE one chunk and never alias each other. Sharing is the whole point
 * of a bump allocator: a region that grew a chunk per allocation would pass an aliasing check and
 * still be the wrong allocator.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_small_allocs_share_a_chunk(control: u64) {
    let region = region_new(control, 0)
    let first = region_alloc(control, region, 24)
    let second = region_alloc(control, region, 24)
    let third = region_alloc(control, region, 1)
    demand(first != second, E_ALLOC_ALIAS)
    demand(second != third, E_ALLOC_ALIAS)
    demand(first % ARENA_ALIGN == 0, E_ALLOC_ALIGN)
    demand(second % ARENA_ALIGN == 0, E_ALLOC_ALIGN)
    demand(third % ARENA_ALIGN == 0, E_ALLOC_ALIGN)
    demand(second - first == ARENA_ALIGN * 2, E_ALLOC_SHARES_CHUNK)
    demand(third - second == ARENA_ALIGN * 2, E_ALLOC_SHARES_CHUNK)
    demand(chunk_count(control, region) == 1, E_ALLOC_SHARES_CHUNK)
    demand_writable(control, first, 24)
    region_drop(control, region)
}

/**
 * Demands a zero-size request still yields a distinct address — the C twin's `n -> 1`, without
 * which two zero-size allocations would alias and the caller could not tell them apart.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_zero_size_is_distinct(control: u64) {
    let region = region_new(control, 0)
    let first = region_alloc(control, region, 0)
    let second = region_alloc(control, region, 0)
    demand(first != 0, E_ALLOC_ALIAS)
    demand(first != second, E_ALLOC_ALIAS)
    region_drop(control, region)
}

/**
 * Demands a request larger than the default chunk gets a chunk sized to it, and that the ordinary
 * request after it does NOT waste that oversize chunk's tail — the prepend order the C twin relies
 * on for its rewind to be a LIFO.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_oversize_gets_its_own_chunk(control: u64) {
    let region = region_new(control, 0)
    let small = region_alloc(control, region, 32)
    let huge = region_alloc(control, region, DEFAULT_CHUNK * 2)
    demand(chunk_count(control, region) == 2, E_ALLOC_OVERSIZE)
    demand(huge != small, E_ALLOC_ALIAS)
    demand(huge % ARENA_ALIGN == 0, E_ALLOC_ALIGN)
    let head = region_get(control, region, REGION_HEAD)
    demand(chunk_get(control, head, CHUNK_CAP) == DEFAULT_CHUNK * 2, E_ALLOC_OVERSIZE)
    demand_writable(control, huge, DEFAULT_CHUNK * 2)
    region_drop(control, region)
}

/**
 * Demands a region that outgrows its chunk prepends a new one and keeps allocating — the volume
 * path, where a bump that failed to grow would either alias or run past its capacity.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_region_grows_past_one_chunk(control: u64) {
    let region = region_new(control, 0)
    let block = DEFAULT_CHUNK / 8
    mut previous: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= 20 { break }
        let got = region_alloc(control, region, block)
        demand(got != 0, E_ALLOC_ALIAS)
        demand(got != previous, E_ALLOC_ALIAS)
        demand(got % ARENA_ALIGN == 0, E_ALLOC_ALIGN)
        demand_writable(control, got, block)
        previous = got
        i++
    }
    demand(chunk_count(control, region) >= 3, E_ALLOC_OVERSIZE)
    region_drop(control, region)
}

/**
 * Demands the root is opened once and stays the same region, and that every region carries a
 * distinct generation stamp — the stamp that tells a live region from a dropped one reusing its
 * address.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_root_and_generations(control: u64) {
    let root = region_root(control)
    demand(root == region_root(control), E_ROOT_STABLE)
    demand(region_get(control, root, REGION_PARENT) == 0, E_ROOT_STABLE)
    let a = region_new(control, 0)
    let b = region_new(control, 0)
    let root_gen = region_get(control, root, REGION_GEN)
    let a_gen = region_get(control, a, REGION_GEN)
    let b_gen = region_get(control, b, REGION_GEN)
    demand(root_gen != 0, E_REGION_GEN)
    demand(a_gen > root_gen, E_REGION_GEN)
    demand(b_gen > a_gen, E_REGION_GEN)
    region_drop(control, a)
    let c = region_new(control, 0)
    demand(region_get(control, c, REGION_GEN) > b_gen, E_REGION_GEN)
    region_drop(control, b)
    region_drop(control, c)
}

/**
 * Demands a drop unlinks its region from the registry — from the head, from the middle, and from
 * the tail, because a single-linked-list removal that only handles the head is the classic way a
 * termination sweep double-frees.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_drop_unlinks_everywhere(control: u64) {
    let before = registry_count(control)
    let first = region_new(control, 0)
    let middle = region_new(control, 0)
    let last = region_new(control, 0)
    demand(registry_count(control) == before + 3, E_DROP_UNLINK)
    region_drop(control, middle)
    demand(!registry_holds(control, middle), E_DROP_UNLINK)
    demand(registry_holds(control, first), E_DROP_UNLINK)
    demand(registry_holds(control, last), E_DROP_UNLINK)
    region_drop(control, last)
    demand(!registry_holds(control, last), E_DROP_UNLINK)
    region_drop(control, first)
    demand(registry_count(control) == before, E_DROP_UNLINK)
    region_drop(control, 0)
}

/**
 * Demands the termination sweep empties the registry and forgets the root, and that a second sweep
 * is a no-op rather than a double free — the idempotence every termination edge depends on.
 *
 * @return  nothing
 */
pub fn demand_free_all_is_idempotent() {
    let control = control_new()
    let root = region_root(control)
    _ = region_alloc(control, root, 100)
    _ = region_new(control, root)
    _ = region_new(control, 0)
    demand(registry_count(control) == 3, E_FREE_ALL_EMPTY)
    regions_free_all(control)
    demand(registry_count(control) == 0, E_FREE_ALL_EMPTY)
    demand(ctrl_get(control, CTRL_ROOT) == 0, E_FREE_ALL_EMPTY)
    regions_free_all(control)
    demand(registry_count(control) == 0, E_FREE_ALL_EMPTY)
    control_free(control)
}

/**
 * Runs the arena's core gate: the word seam it stands on, then chunks, regions, allocation, drops
 * and the termination sweep. Each check asserts an observable — an address, a chunk count, a
 * registry membership, a generation ordering — rather than the mere absence of a crash.
 *
 * @return  `GATE_OK` when the core holds; any other exit names the invariant that broke
 */
pub fn run_arena_gate() -> i32 {
    let word = run_word_gate()
    if word != GATE_OK { return word }
    let control = control_new()
    demand(control_is_live(control), E_CONTROL_MAGIC)
    demand_small_allocs_share_a_chunk(control)
    demand_zero_size_is_distinct(control)
    demand_oversize_gets_its_own_chunk(control)
    demand_region_grows_past_one_chunk(control)
    demand_root_and_generations(control)
    demand_drop_unlinks_everywhere(control)
    regions_free_all(control)
    control_free(control)
    demand_free_all_is_idempotent()
    GATE_OK
}
