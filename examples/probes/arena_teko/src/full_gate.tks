/** A subtree drop must take the whole subtree; exit code when a descendant survives. */
pub const E_SUBTREE_KEEPS: i32 = 60

/** A subtree drop must take ONLY the subtree; exit code when a sibling disappears. */
pub const E_SUBTREE_TAKES_SIBLING: i32 = 61

/** A registration must be readable back; exit code when a lookup misses it. */
pub const E_REGISTER_MISS: i32 = 62

/** Re-registering an identifier must overwrite, not append; exit code otherwise. */
pub const E_REGISTER_OVERWRITE: i32 = 63

/** A lookup must climb the parent chain and a nearer binding must shadow; exit code otherwise. */
pub const E_LOOKUP_CHAIN: i32 = 64

/** A rewind must release exactly what was allocated after the checkpoint; exit code otherwise. */
pub const E_REWIND_EXTENT: i32 = 65

/** A commit must keep everything the matching push covered; exit code when it rewinds. */
pub const E_COMMIT_KEEPS: i32 = 66

/** Push and pop must stay balanced past the stack's depth; exit code when they do not. */
pub const E_MARK_DEPTH: i32 = 67

/** With the oracle off, a freed block must be reused; exit code when it is not. */
pub const E_REUSE_OFF: i32 = 68

/** With the oracle on, a freed block must be poisoned; exit code when it is not. */
pub const E_POISON_MISSING: i32 = 69

/** With the oracle on, a freed block must NEVER be reused; exit code when it is. */
pub const E_POISON_REUSED: i32 = 70

/**
 * The C environment writer, reached DIRECTLY as a C symbol, so one binary can prove both halves of
 * the memory oracle: the normal mode where a freed block is reused, and the paranoid mode where it
 * is poisoned and never reused. Two separate runs would prove the same thing, but only if the
 * harness remembers to make both — an oracle whose proof depends on the harness is weaker.
 *
 * @param name       the address of a NUL-terminated variable name
 * @param value      the address of a NUL-terminated value
 * @param overwrite  non-zero to replace an existing binding
 * @return           0 on success
 */
pub extern fn c_setenv(name: u64, value: u64, overwrite: i32) -> i32 = "setenv"

/**
 * The C environment remover, the counterpart of `c_setenv`.
 *
 * @param name  the address of a NUL-terminated variable name
 * @return      0 on success
 */
pub extern fn c_unsetenv(name: u64) -> i32 = "unsetenv"

/**
 * Counts the regions the subtree of `root` still holds on the live registry — the observable a
 * subtree drop is judged by, since "did the sweep take exactly the right regions" is invisible
 * otherwise.
 *
 * @param control  the control block's base address
 * @param root     the subtree's root
 * @return         how many live regions reach `root`
 */
pub fn subtree_live_count(control: u64, root: u64) -> u64 {
    mut region = ctrl_get(control, CTRL_REGS)
    mut count: u64 = 0
    loop {
        if region == 0 { break }
        if region_reaches(control, region, root) { count++ }
        region = region_get(control, region, REGION_REG_NEXT)
    }
    count
}

/**
 * Demands a subtree drop takes the WHOLE subtree and NOTHING else. A three-level subtree is built
 * beside an independent sibling tree; dropping the subtree's root must leave the sibling tree
 * untouched and remove every descendant, including the grandchild that is only reachable through
 * two parent hops.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_subtree_drop_is_exact(control: u64) {
    let root = region_root(control)
    let branch = region_new(control, root)
    let child = region_new(control, branch)
    let grandchild = region_new(control, child)
    let sibling = region_new(control, root)
    let cousin = region_new(control, sibling)
    let orphan = region_new(control, 0)
    _ = region_alloc(control, grandchild, 1000)
    _ = region_alloc(control, cousin, 1000)
    demand(subtree_live_count(control, branch) == 3, E_SUBTREE_KEEPS)
    region_drop_subtree(control, branch)
    demand(subtree_live_count(control, branch) == 0, E_SUBTREE_KEEPS)
    demand(!registry_holds(control, child), E_SUBTREE_KEEPS)
    demand(!registry_holds(control, grandchild), E_SUBTREE_KEEPS)
    demand(registry_holds(control, sibling), E_SUBTREE_TAKES_SIBLING)
    demand(registry_holds(control, cousin), E_SUBTREE_TAKES_SIBLING)
    demand(registry_holds(control, orphan), E_SUBTREE_TAKES_SIBLING)
    demand(registry_holds(control, root), E_SUBTREE_TAKES_SIBLING)
    region_drop_subtree(control, sibling)
    demand(!registry_holds(control, cousin), E_SUBTREE_KEEPS)
    region_drop(control, orphan)
    region_drop_subtree(control, 0)
}

/**
 * Demands the per-region registry stores, overwrites and resolves. Overwriting must not grow the
 * table — an append-instead-of-overwrite would still resolve correctly on a linear scan and would
 * leak an entry per rebinding, which no lookup test catches.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_registry_stores_and_overwrites(control: u64) {
    let region = region_new(control, 0)
    region_register(control, region, 7, 1000)
    region_register(control, region, 9, 2000)
    demand(region_lookup(control, region, 7) == 1000, E_REGISTER_MISS)
    demand(region_lookup(control, region, 9) == 2000, E_REGISTER_MISS)
    demand(region_lookup(control, region, 8) == 0, E_REGISTER_MISS)
    demand(region_get(control, region, REGION_NENTRIES) == 2, E_REGISTER_OVERWRITE)
    region_register(control, region, 7, 1001)
    demand(region_lookup(control, region, 7) == 1001, E_REGISTER_OVERWRITE)
    demand(region_get(control, region, REGION_NENTRIES) == 2, E_REGISTER_OVERWRITE)
    region_register(control, region, 0, 0)
    region_drop(control, region)
}

/**
 * Demands the entry table survives its growth steps: more registrations than the first capacity
 * must all still resolve, which is what proves the doubling carried the old contents over.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_registry_survives_growth(control: u64) {
    let region = region_new(control, 0)
    mut i: u64 = 1
    loop {
        if i > 20 { break }
        region_register(control, region, i, i * 100)
        i++
    }
    demand(region_get(control, region, REGION_NENTRIES) == 20, E_REGISTER_MISS)
    mut k: u64 = 1
    loop {
        if k > 20 { break }
        demand(region_lookup(control, region, k) == k * 100, E_REGISTER_MISS)
        k++
    }
    region_drop(control, region)
}

/**
 * Demands a lookup climbs the parent chain and that a nearer binding shadows a farther one, and
 * that a lookup on a zero region resolves to nothing rather than reading through it.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_lookup_climbs_and_shadows(control: u64) {
    let root = region_root(control)
    let middle = region_new(control, root)
    let leaf = region_new(control, middle)
    region_register(control, root, 5, 500)
    region_register(control, root, 6, 600)
    region_register(control, middle, 6, 660)
    demand(region_lookup(control, leaf, 5) == 500, E_LOOKUP_CHAIN)
    demand(region_lookup(control, leaf, 6) == 660, E_LOOKUP_CHAIN)
    demand(region_lookup(control, root, 6) == 600, E_LOOKUP_CHAIN)
    demand(region_lookup(control, leaf, 4) == 0, E_LOOKUP_CHAIN)
    demand(region_lookup(control, 0, 5) == 0, E_LOOKUP_CHAIN)
    region_drop_subtree(control, middle)
}

/**
 * Demands a rewind releases exactly what was allocated after its checkpoint: the chunk count and
 * the bump cursor must both return to what they were, and the very next allocation must land back
 * on the address the checkpoint left free.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_rewind_extent(control: u64) {
    let root = region_root(control)
    let kept = region_alloc(control, root, 64)
    let chunks_before = chunk_count(control, root)
    let used_before = chunk_get(control, region_get(control, root, REGION_HEAD), CHUNK_USED)
    checkpoint_push(control)
    mut i: u64 = 0
    loop {
        if i >= 12 { break }
        _ = region_alloc(control, root, DEFAULT_CHUNK / 2)
        i++
    }
    demand(chunk_count(control, root) > chunks_before, E_REWIND_EXTENT)
    checkpoint_pop(control)
    demand(chunk_count(control, root) == chunks_before, E_REWIND_EXTENT)
    demand(chunk_get(control, region_get(control, root, REGION_HEAD), CHUNK_USED) == used_before, E_REWIND_EXTENT)
    let after = region_alloc(control, root, 64)
    demand(after == kept + 64, E_REWIND_EXTENT)
    demand_writable(control, kept, 64)
}

/**
 * Demands a commit keeps everything its matching push covered, and that push and pop stay balanced
 * past the stack's depth: a push deeper than the stack records nothing, so its pop must not rewind
 * to a checkpoint that belongs to a shallower scope.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_commit_and_depth(control: u64) {
    let root = region_root(control)
    checkpoint_push(control)
    let live = region_alloc(control, root, 128)
    let chunks = chunk_count(control, root)
    checkpoint_commit(control)
    demand(chunk_count(control, root) == chunks, E_COMMIT_KEEPS)
    demand(ctrl_get(control, CTRL_MSP) == 0, E_COMMIT_KEEPS)
    demand_writable(control, live, 128)
    let deep_target = chunk_count(control, root)
    mut pushed: u64 = 0
    loop {
        if pushed >= MARK_SLOTS + 4 { break }
        checkpoint_push(control)
        pushed++
    }
    demand(ctrl_get(control, CTRL_MSP) == MARK_SLOTS + 4, E_MARK_DEPTH)
    mut popped: u64 = 0
    loop {
        if popped >= MARK_SLOTS + 4 { break }
        checkpoint_pop(control)
        popped++
    }
    demand(ctrl_get(control, CTRL_MSP) == 0, E_MARK_DEPTH)
    demand(chunk_count(control, root) == deep_target, E_MARK_DEPTH)
    checkpoint_pop(control)
    checkpoint_commit(control)
    demand(ctrl_get(control, CTRL_MSP) == 0, E_MARK_DEPTH)
}

/**
 * Sets or clears `TEKO_MEM_PARANOID` in this process and forces the next probe to read it again,
 * so both halves of the oracle can be proven without depending on how the harness was invoked.
 *
 * @param control  the control block's base address
 * @param wanted   true to set the variable, false to clear it
 * @return         nothing
 */
pub fn set_paranoid_env(control: u64, wanted: bool) {
    let block = raw_alloc(PARANOID_PROBE_BYTES)
    spell_paranoid_var(block)
    if wanted {
        store_byte(block + PARANOID_VAR_BYTES, ASCII_T)
        store_byte(block + PARANOID_VAR_BYTES + 1, ASCII_NUL)
        _ = c_setenv(block, block + PARANOID_VAR_BYTES, 1)
    } else {
        _ = c_unsetenv(block)
    }
    c_free(block)
    ctrl_set(control, CTRL_PARANOID, PARANOID_UNPROBED)
}

/**
 * Demands that with the oracle OFF a freed root block is parked and handed back to the next
 * request of its class — the reuse that stops a never-dropped region's footprint from growing.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_reuse_when_oracle_off(control: u64) {
    set_paranoid_env(control, false)
    demand(!paranoid_enabled(control), E_REUSE_OFF)
    let root = region_root(control)
    let block = region_alloc(control, root, 96)
    free_block(control, block, 96)
    demand(region_alloc(control, root, 96) == block, E_REUSE_OFF)
    let large = region_alloc(control, root, FREE_BIN_MAX_BYTES * 2)
    free_block(control, large, FREE_BIN_MAX_BYTES * 2)
    demand(region_alloc(control, root, FREE_BIN_MAX_BYTES * 2) == large, E_REUSE_OFF)
}

/**
 * Demands that with the oracle ON a freed root block is POISONED and NEVER handed back. This is
 * the memory oracle that guards the free-old decree: arena reuse is invisible to a sanitizer, so
 * without the poison a wrong linearity proof corrupts in silence instead of failing loudly.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn demand_poison_when_oracle_on(control: u64) {
    set_paranoid_env(control, true)
    demand(paranoid_enabled(control), E_POISON_MISSING)
    let root = region_root(control)
    let block = region_alloc(control, root, 96)
    _ = c_memset(block, 0, 96)
    free_block(control, block, 96)
    demand(load_byte(block, ctrl_scratch(control)) == 221, E_POISON_MISSING)
    demand(load_byte(block + 95, ctrl_scratch(control)) == 221, E_POISON_MISSING)
    demand(region_alloc(control, root, 96) != block, E_POISON_REUSED)
    let short = region_alloc(control, root, 8)
    _ = c_memset(short, 0, 8)
    free_block(control, short, 8)
    demand(load_byte(short, ctrl_scratch(control)) == 0, E_POISON_MISSING)
    set_paranoid_env(control, false)
}

/**
 * Runs the complete arena gate: the core, then the subtree sweep, the per-region registry, the
 * checkpoint stack, and both halves of the memory oracle. Every check asserts an observable — an
 * address, a chunk count, a registry membership, a poisoned byte — never the mere absence of a
 * crash.
 *
 * @return  `GATE_OK` when the whole arena holds; any other exit names the invariant that broke
 */
pub fn run_full_gate() -> i32 {
    let core = run_arena_gate()
    if core != GATE_OK { return core }
    let control = control_new()
    demand_subtree_drop_is_exact(control)
    demand_registry_stores_and_overwrites(control)
    demand_registry_survives_growth(control)
    demand_lookup_climbs_and_shadows(control)
    demand_rewind_extent(control)
    demand_commit_and_depth(control)
    demand_reuse_when_oracle_off(control)
    demand_poison_when_oracle_on(control)
    regions_free_all(control)
    control_free(control)
    GATE_OK
}
