/**
 * Tests whether a region's parent chain reaches `root` — the subtree's membership predicate. The
 * C twin calls this the "owner tag", and it is deliberately NOT a stored field: the parent edges
 * already encode the tree, so a subtree drop needs no extra word on every region.
 *
 * @param control  the control block's base address
 * @param region   the region to test
 * @param root     the subtree's root
 * @return         true when walking `region`'s parents arrives at `root`
 */
pub fn region_reaches(control: u64, region: u64, root: u64) -> bool {
    mut current = region
    loop {
        if current == 0 { break }
        if current == root { return true }
        current = region_get(control, current, REGION_PARENT)
    }
    false
}

/**
 * Collects every live region of `root`'s subtree onto a detached list, unlinking each from the
 * global registry as it goes, and reports that list's head.
 *
 * The two-phase shape is not stylistic. Collecting FIRST means the walk is never disturbed by the
 * unlinking it performs, and unlinking as it collects means a second sweep — or the termination
 * sweep — can never see, and double-free, a region this sweep already owns. The detached list is
 * threaded through the regions' own registry link, so it costs no allocation.
 *
 * @param control  the control block's base address
 * @param root     the subtree's root
 * @return         the head of the detached list of doomed regions, or 0 when none
 */
pub fn subtree_collect(control: u64, root: u64) -> u64 {
    mut doomed: u64 = 0
    mut current = ctrl_get(control, CTRL_REGS)
    loop {
        if current == 0 { break }
        let next = region_get(control, current, REGION_REG_NEXT)
        if region_reaches(control, current, root) {
            registry_unlink(control, current)
            region_set(current, REGION_REG_NEXT, doomed)
            doomed = current
        }
        current = next
    }
    doomed
}

/**
 * Drops `root` AND every live region whose parent chain reaches it, in one sweep — the bulk drop an
 * adopted subtree needs. Cycles among the OBJECTS those regions hold are irrelevant: nothing is
 * freed per object, the whole knot goes at once. Tolerates a zero handle; the caller MUST drop its
 * handle afterwards.
 *
 * @param control  the control block's base address
 * @param root     the subtree's root; 0 is a no-op
 * @return         nothing
 */
pub fn region_drop_subtree(control: u64, root: u64) {
    if root == 0 { return }
    mut doomed = subtree_collect(control, root)
    loop {
        if doomed == 0 { break }
        let next = region_get(control, doomed, REGION_REG_NEXT)
        region_release(control, doomed)
        doomed = next
    }
}

/**
 * The address of a region's entry slot at `index`.
 *
 * @param control  the control block's base address
 * @param region   the region whose table is indexed
 * @param index    the entry's position in the table
 * @return         the entry's base address
 */
pub fn entry_slot(control: u64, region: u64, index: u64) -> u64 {
    region_get(control, region, REGION_ENTRIES) + index * ENTRY_BYTES
}

/**
 * Finds the index of the entry bound to `type_id` in a region's OWN table, or the table's length
 * when it is not bound. A linear scan, because arena entry counts are small and a hash would cost
 * more to maintain than it saves.
 *
 * @param control  the control block's base address
 * @param region   the region whose own table is searched
 * @param type_id  the type identifier to find
 * @return         the entry's index, or the table's length when absent
 */
pub fn entry_index_of(control: u64, region: u64, type_id: u64) -> u64 {
    let count = region_get(control, region, REGION_NENTRIES)
    mut i: u64 = 0
    loop {
        if i >= count { break }
        if ctrl_load(control, entry_slot(control, region, i) + ENTRY_TYPE_ID) == type_id { return i }
        i++
    }
    count
}

/**
 * Grows a region's entry table to the next capacity — four entries the first time, then doubling.
 * The old contents are carried over and the old array released, which is what the C twin's
 * `realloc` does; the aligned allocator is used on both sides so the table stays in the same heap
 * family as every other block this arena owns.
 *
 * @param control  the control block's base address
 * @param region   the region whose table grows
 * @return         nothing
 */
pub fn entries_grow(control: u64, region: u64) {
    let old_cap = region_get(control, region, REGION_ENTRIES_CAP)
    let new_cap = if old_cap == 0 { ENTRIES_FIRST_CAP } else { old_cap * 2 }
    let old_table = region_get(control, region, REGION_ENTRIES)
    let new_table = raw_alloc(new_cap * ENTRY_BYTES)
    let used = region_get(control, region, REGION_NENTRIES) * ENTRY_BYTES
    if used > 0 { _ = c_memcpy(new_table, old_table, used) }
    c_free(old_table)
    region_set(region, REGION_ENTRIES, new_table)
    region_set(region, REGION_ENTRIES_CAP, new_cap)
}

/**
 * Binds `type_id` to `instance` in a region's OWN table. A second binding of the same identifier
 * OVERWRITES: this is a storage primitive, and a genuine duplicate-registration error belongs to
 * the dependency layer above, not to the arena. Tolerates a zero region.
 *
 * @param control   the control block's base address
 * @param region    the region to bind in; 0 is a no-op
 * @param type_id   the type identifier to bind
 * @param instance  the instance address to bind it to
 * @return          nothing
 */
pub fn region_register(control: u64, region: u64, type_id: u64, instance: u64) {
    if region == 0 { return }
    let count = region_get(control, region, REGION_NENTRIES)
    let found = entry_index_of(control, region, type_id)
    if found < count {
        store_word(entry_slot(control, region, found) + ENTRY_INSTANCE, instance)
        return
    }
    if count == region_get(control, region, REGION_ENTRIES_CAP) { entries_grow(control, region) }
    let slot = entry_slot(control, region, count)
    store_word(slot + ENTRY_TYPE_ID, type_id)
    store_word(slot + ENTRY_INSTANCE, instance)
    region_set(region, REGION_NENTRIES, count + 1)
}

/**
 * Resolves `type_id` by walking a region, then its parent, then its parent's parent, and so on —
 * so a binding made high in the tree is visible to every region beneath it, and a binding made low
 * shadows it. Reports 0 when no region in the chain binds the identifier.
 *
 * @param control  the control block's base address
 * @param region   the region to start from; 0 resolves to 0
 * @param type_id  the type identifier to resolve
 * @return         the bound instance address, or 0
 */
pub fn region_lookup(control: u64, region: u64, type_id: u64) -> u64 {
    mut current = region
    loop {
        if current == 0 { break }
        let count = region_get(control, current, REGION_NENTRIES)
        let found = entry_index_of(control, current, type_id)
        if found < count { return ctrl_load(control, entry_slot(control, current, found) + ENTRY_INSTANCE) }
        current = region_get(control, current, REGION_PARENT)
    }
    0
}
