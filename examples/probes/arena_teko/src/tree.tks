pub fn region_reaches(control: u64, region: u64, root: u64): bool {
    var current = region
    loop {
        if current == 0 { break }
        if current == root { return true }
        current = region_get(control, current, REGION_PARENT)
    }
    false
}

pub fn subtree_collect(control: u64, root: u64): u64 {
    var doomed: u64 = 0
    var current = ctrl_get(control, CTRL_REGS)
    loop {
        if current == 0 { break }
        var next = region_get(control, current, REGION_REG_NEXT)
        if region_reaches(control, current, root) {
            registry_unlink(control, current)
            region_set(current, REGION_REG_NEXT, doomed)
            doomed = current
        }
        current = next
    }
    doomed
}

pub fn region_drop_subtree(control: u64, root: u64) {
    if root == 0 { return }
    var doomed = subtree_collect(control, root)
    loop {
        if doomed == 0 { break }
        var next = region_get(control, doomed, REGION_REG_NEXT)
        region_release(control, doomed)
        doomed = next
    }
}

pub fn entry_slot(control: u64, region: u64, index: u64): u64 {
    region_get(control, region, REGION_ENTRIES) + index * ENTRY_BYTES
}

pub fn entry_index_of(control: u64, region: u64, type_id: u64): u64 {
    var count = region_get(control, region, REGION_NENTRIES)
    var i: u64 = 0
    loop {
        if i >= count { break }
        if ctrl_load(control, entry_slot(control, region, i) + ENTRY_TYPE_ID) == type_id { return i }
        i++
    }
    count
}

pub fn entries_grow(control: u64, region: u64) {
    var old_cap = region_get(control, region, REGION_ENTRIES_CAP)
    var new_cap = if old_cap == 0 { ENTRIES_FIRST_CAP } else { old_cap * 2 }
    var old_table = region_get(control, region, REGION_ENTRIES)
    var new_table = raw_alloc(new_cap * ENTRY_BYTES)
    var used = region_get(control, region, REGION_NENTRIES) * ENTRY_BYTES
    if used > 0 { _ = c_memcpy(new_table, old_table, used) }
    c_free(old_table)
    region_set(region, REGION_ENTRIES, new_table)
    region_set(region, REGION_ENTRIES_CAP, new_cap)
}

pub fn region_register(control: u64, region: u64, type_id: u64, instance: u64) {
    if region == 0 { return }
    var count = region_get(control, region, REGION_NENTRIES)
    var found = entry_index_of(control, region, type_id)
    if found < count {
        store_word(entry_slot(control, region, found) + ENTRY_INSTANCE, instance)
        return
    }
    if count == region_get(control, region, REGION_ENTRIES_CAP) { entries_grow(control, region) }
    var slot = entry_slot(control, region, count)
    store_word(slot + ENTRY_TYPE_ID, type_id)
    store_word(slot + ENTRY_INSTANCE, instance)
    region_set(region, REGION_NENTRIES, count + 1)
}

pub fn region_lookup(control: u64, region: u64, type_id: u64): u64 {
    var current = region
    loop {
        if current == 0 { break }
        var count = region_get(control, current, REGION_NENTRIES)
        var found = entry_index_of(control, current, type_id)
        if found < count { return ctrl_load(control, entry_slot(control, current, found) + ENTRY_INSTANCE) }
        current = region_get(control, current, REGION_PARENT)
    }
    0
}
