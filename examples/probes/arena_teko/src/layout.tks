/** Chunk field: the next chunk in the region's LIFO list, 0 at the end. */
pub const CHUNK_NEXT: u64 = 0

/** Chunk field: the payload's usable byte count. */
pub const CHUNK_CAP: u64 = 8

/** Chunk field: the bump cursor, i.e. how many payload bytes are already handed out. */
pub const CHUNK_USED: u64 = 16

/**
 * The chunk header's size, and therefore the payload's offset from the chunk base. The C twin's
 * `offsetof(struct tk_chunk, data)` is 32 — three words plus the padding the payload's
 * `_Alignas(TK_ARENA_ALIGN)` forces — and 32 is a multiple of `ARENA_ALIGN`, so a chunk base at
 * the arena's alignment yields a payload base at it too.
 */
pub const CHUNK_HEADER: u64 = 32

/** Region field: the current chunk, 0 while the region has never allocated (lazy head). */
pub const REGION_HEAD: u64 = 0

/**
 * Region field: the INTRUSIVE link into the global live-region registry. Distinct from
 * `REGION_PARENT`: this is the flat list of every live region, unrelated to the tree's shape.
 * Confusing the two is the mistake that makes a subtree drop free the wrong regions.
 */
pub const REGION_REG_NEXT: u64 = 8

/** Region field: the arena TREE edge; 0 for the root or a deliberately parentless region. */
pub const REGION_PARENT: u64 = 16

/** Region field: the per-region type-to-instance entry array, 0 until the first registration. */
pub const REGION_ENTRIES: u64 = 24

/** Region field: how many entries of that array are in use. */
pub const REGION_NENTRIES: u64 = 32

/** Region field: how many entries that array can hold. */
pub const REGION_ENTRIES_CAP: u64 = 40

/**
 * Region field: the unique generation stamp. Never reused, so a recycled region ADDRESS always
 * carries a fresh stamp — which is what lets a cached reference tell a live region from a dropped
 * one that happens to sit at the same address.
 */
pub const REGION_GEN: u64 = 48

/** A region header's total size: seven words rounded up to the arena's alignment. */
pub const REGION_BYTES: u64 = 64

/** Entry field: the registered type's identifier. */
pub const ENTRY_TYPE_ID: u64 = 0

/** Entry field: the registered instance's address. */
pub const ENTRY_INSTANCE: u64 = 8

/** One entry's size: a type identifier and an instance address. */
pub const ENTRY_BYTES: u64 = 16

/** The entry array's first capacity, the C twin's `entries_cap == 0 ? 4` step. */
pub const ENTRIES_FIRST_CAP: u64 = 4

/** Control field: the sentinel proving the block was initialized. */
pub const CTRL_MAGIC: u64 = 0

/** Control field: the head of the global live-region registry (the C twin's `tk_g_regs`). */
pub const CTRL_REGS: u64 = 8

/** Control field: the process root region (the C twin's `tk_g_root`), 0 until first demanded. */
pub const CTRL_ROOT: u64 = 16

/** Control field: the monotonic region-generation counter (the C twin's `tk_g_region_gen`). */
pub const CTRL_GEN: u64 = 24

/** Control field: the mark stack's depth (the C twin's `tk_arena_msp`). */
pub const CTRL_MSP: u64 = 32

/** Control field: the cached `TEKO_MEM_PARANOID` probe (the C twin's `static int tk_paranoid`). */
pub const CTRL_PARANOID: u64 = 40

/** Control field: the free list of blocks too large to bin (the C twin's `tk_free_large`). */
pub const CTRL_FREE_LARGE: u64 = 48

/**
 * Control field: one scratch byte every raw read borrows. It lives in the control block so a read
 * costs no allocation — an allocator whose own reads allocate does not terminate.
 */
pub const CTRL_SCRATCH: u64 = 56

/** Control field: the base of the mark stack (the C twin's `tk_arena_marks`). */
pub const CTRL_MARKS: u64 = 64

/** Mark field: the chunk the checkpoint was taken in. */
pub const MARK_CHUNK: u64 = 0

/** Mark field: that chunk's bump cursor at checkpoint time. */
pub const MARK_USED: u64 = 8

/** One mark's size: a chunk address and a bump cursor. */
pub const MARK_BYTES: u64 = 16

/** How many checkpoints the mark stack holds; a deeper push saves nothing, as in the C twin. */
pub const MARK_SLOTS: u64 = 64

/** Control field: the base of the size-class free bins (the C twin's `tk_free_bins`). */
pub const CTRL_FREE_BINS: u64 = 1088

/** How many size classes the free bins hold; class `i` is exactly `(i + 1) * ARENA_ALIGN` bytes. */
pub const FREE_BINS: u64 = 4096

/** The control block's total size: the scalars, the mark stack, and the free bins. */
pub const CTRL_BYTES: u64 = 33856

/** The sentinel `control_new` writes so an uninitialized block is never mistaken for a live one. */
pub const CTRL_MAGIC_VALUE: u64 = 2596069104

/** Freenode field: the next parked block of the same class. */
pub const FREENODE_NEXT: u64 = 0

/** Freenode field: the parked block's usable byte count. */
pub const FREENODE_BYTES: u64 = 8

/** The smallest block that can be parked: one that has room for a freenode's two fields. */
pub const FREENODE_BYTES_MIN: u64 = 16

/** `CTRL_PARANOID` while the environment has not been probed yet (the C twin's `-1`). */
pub const PARANOID_UNPROBED: u64 = 2

/** `CTRL_PARANOID` when `TEKO_MEM_PARANOID` is unset or empty. */
pub const PARANOID_OFF: u64 = 0

/** `CTRL_PARANOID` when `TEKO_MEM_PARANOID` is set: poison on free, and never reuse. */
pub const PARANOID_ON: u64 = 1

/** The byte `TEKO_MEM_PARANOID` writes over a freed block (the C twin's `memset(p, 0xDD, …)`). */
pub const POISON_BYTE: i32 = 221

/** How many bytes `TEKO_MEM_PARANOID` occupies once NUL-terminated. */
pub const PARANOID_VAR_BYTES: u64 = 18

/** The probe block: the NUL-terminated variable name, plus one scratch byte for the value read. */
pub const PARANOID_PROBE_BYTES: u64 = 32

/** ASCII `T`. */
pub const ASCII_T: u64 = 84

/** ASCII `E`. */
pub const ASCII_E: u64 = 69

/** ASCII `K`. */
pub const ASCII_K: u64 = 75

/** ASCII `O`. */
pub const ASCII_O: u64 = 79

/** ASCII `_`. */
pub const ASCII_UNDERSCORE: u64 = 95

/** ASCII `M`. */
pub const ASCII_M: u64 = 77

/** ASCII `P`. */
pub const ASCII_P: u64 = 80

/** ASCII `A`. */
pub const ASCII_A: u64 = 65

/** ASCII `R`. */
pub const ASCII_R: u64 = 82

/** ASCII `N`. */
pub const ASCII_N: u64 = 78

/** ASCII `I`. */
pub const ASCII_I: u64 = 73

/** ASCII `D`. */
pub const ASCII_D: u64 = 68

/** The NUL that terminates a C string. */
pub const ASCII_NUL: u64 = 0
