pub fn mark_slot(control: u64, depth: u64): u64 {
    control + CTRL_MARKS + depth * MARK_BYTES
}

pub fn checkpoint_push(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    ctrl_set(control, CTRL_MSP, depth + 1)
    if depth >= MARK_SLOTS { return }
    write_mark(control, depth)
}

pub fn write_mark(control: u64, depth: u64) {
    var head = region_get(control, region_root(control), REGION_HEAD)
    var slot = mark_slot(control, depth)
    store_word(slot + MARK_CHUNK, head)
    if head == 0 {
        store_word(slot + MARK_USED, 0)
        return
    }
    store_word(slot + MARK_USED, chunk_get(control, head, CHUNK_USED))
}

pub fn checkpoint_pop(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
    if depth - 1 >= MARK_SLOTS { return }
    free_purge(control)
    var slot = mark_slot(control, depth - 1)
    var marked_chunk = ctrl_load(control, slot + MARK_CHUNK)
    var marked_used = ctrl_load(control, slot + MARK_USED)
    var root = region_root(control)
    chunk_free_until(control, region_get(control, root, REGION_HEAD), marked_chunk)
    region_set(root, REGION_HEAD, marked_chunk)
    if marked_chunk != 0 { chunk_set(marked_chunk, CHUNK_USED, marked_used) }
}

pub fn checkpoint_commit(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
}
