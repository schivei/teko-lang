/**
 * The address of the mark stack slot at `depth`.
 *
 * @param control  the control block's base address
 * @param depth    the slot's position in the stack, below `MARK_SLOTS`
 * @return         the slot's base address
 */
pub fn mark_slot(control: u64, depth: u64): u64 {
    control + CTRL_MARKS + depth * MARK_BYTES
}

/**
 * Saves the root region's current bump position as a checkpoint. The root's chunk list is LIFO —
 * allocation PREPENDS — so a checkpoint is exactly the pair (current chunk, its bump cursor), and
 * everything allocated afterwards sits in chunks nearer the head.
 *
 * A push deeper than the stack holds saves nothing but STILL counts, so pushes and pops stay
 * balanced and a later pop can never rewind past a checkpoint that was never recorded.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn checkpoint_push(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    ctrl_set(control, CTRL_MSP, depth + 1)
    if depth >= MARK_SLOTS { return }
    write_mark(control, depth)
}

/**
 * Records the root region's current chunk and bump cursor into the mark stack slot at `depth`.
 *
 * @param control  the control block's base address
 * @param depth    the slot to write, below `MARK_SLOTS`
 * @return         nothing
 */
pub fn write_mark(control: u64, depth: u64) {
    var head = region_get(control, region_root(control), REGION_HEAD)
    var slot = mark_slot(control, depth)
    store_word(slot + MARK_CHUNK, head)
    if head == 0 {
        store_word(slot + MARK_USED, 0)
        return
    }
    store_word(slot + MARK_USED, chunk_get(control, head, CHUNK_USED))
}

/**
 * Rewinds the root region to the top checkpoint: every chunk allocated since it is released and
 * the checkpoint chunk's bump cursor is restored, bulk-freeing everything in between.
 *
 * The free lists are purged first, because a parked block may live inside a chunk this rewind is
 * about to release, and handing out a dangling address is silent corruption.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn checkpoint_pop(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
    if depth - 1 >= MARK_SLOTS { return }
    free_purge(control)
    var slot = mark_slot(control, depth - 1)
    var marked_chunk = ctrl_load(control, slot + MARK_CHUNK)
    var marked_used = ctrl_load(control, slot + MARK_USED)
    var root = region_root(control)
    chunk_free_until(control, region_get(control, root, REGION_HEAD), marked_chunk)
    region_set(root, REGION_HEAD, marked_chunk)
    if marked_chunk != 0 { chunk_set(marked_chunk, CHUNK_USED, marked_used) }
}

/**
 * Discards the top checkpoint WITHOUT rewinding, so everything allocated since the matching push
 * stays live and folds into the checkpoint below it — the counterpart of `checkpoint_pop` for a scope
 * whose allocations turned out to escape. Nothing was freed, so there is nothing to purge.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn checkpoint_commit(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
}
