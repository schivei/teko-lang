/** `region_alloc` exhausted the allocator even at the exact request size; exit code. */
pub const E_REGION_OOM: i32 = 21

/**
 * Reads a region field.
 *
 * @param control  the control block's base address, for the scratch byte the read borrows
 * @param region   the region's base address
 * @param field    the field's offset within the header
 * @return         the field's current value
 */
pub fn region_get(control: u64, region: u64, field: u64): u64 {
    ctrl_load(control, region + field)
}

/**
 * Writes a region field.
 *
 * @param region  the region's base address
 * @param field   the field's offset within the header
 * @param value   the value to store
 * @return        nothing
 */
pub fn region_set(region: u64, field: u64, value: u64) {
    store_word(region + field, value)
}

/**
 * Opens a fresh empty region as a child of `parent`, prepends it onto the global live-region
 * registry, and stamps it with a generation that is never reused. The head chunk is NOT allocated
 * here: a region that never allocates never pays for a chunk, which is the C twin's lazy head.
 *
 * @param control  the control block's base address
 * @param parent   the region's tree parent; 0 for the root or a deliberately parentless region
 * @return         the new region's base address
 */
pub fn region_new(control: u64, parent: u64): u64 {
    var region = raw_alloc(REGION_BYTES)
    region_set(region, REGION_HEAD, 0)
    region_set(region, REGION_REG_NEXT, ctrl_get(control, CTRL_REGS))
    ctrl_set(control, CTRL_REGS, region)
    region_set(region, REGION_PARENT, parent)
    region_set(region, REGION_ENTRIES, 0)
    region_set(region, REGION_NENTRIES, 0)
    region_set(region, REGION_ENTRIES_CAP, 0)
    var generation = ctrl_get(control, CTRL_GEN) + 1
    ctrl_set(control, CTRL_GEN, generation)
    region_set(region, REGION_GEN, generation)
    region
}

/**
 * The process root region, opened on first demand — the C twin's lazy `tk_g_root`. The root is the
 * tree's root, so it has no parent, and it is on the live-region registry like every other region.
 *
 * @param control  the control block's base address
 * @return         the root region's base address
 */
pub fn region_root(control: u64): u64 {
    var existing = ctrl_get(control, CTRL_ROOT)
    if existing != 0 { return existing }
    var root = region_new(control, 0)
    ctrl_set(control, CTRL_ROOT, root)
    root
}

/**
 * Hands out `size` already-aligned bytes from the region's current chunk, advancing the bump.
 *
 * @param control  the control block's base address
 * @param region   the region to allocate from; its head chunk must fit the request
 * @param offset   the bump offset `chunk_fit_offset` computed
 * @param size     the already-aligned request size
 * @return         the allocated block's base address
 */
pub fn region_bump(control: u64, region: u64, offset: u64, size: u64): u64 {
    var chunk = region_get(control, region, REGION_HEAD)
    chunk_set(chunk, CHUNK_USED, offset + size)
    chunk_payload(chunk) + offset
}

/**
 * Prepends a fresh chunk big enough for `size` and hands the request its whole base. An ordinary
 * request gets the default chunk so later small allocations share it; a request larger than the
 * default gets a chunk sized exactly to it. When the default-sized attempt fails, the exact size is
 * tried before giving up — which keeps this arena's out-of-memory edge where a plain `malloc(n)`
 * had it, so nothing that used to succeed starts failing. Exits `E_REGION_OOM` when both fail.
 *
 * @param control  the control block's base address
 * @param region   the region to extend
 * @param size     the already-aligned request size
 * @return         the allocated block's base address
 */
pub fn region_grow(control: u64, region: u64, size: u64): u64 {
    var want = if size > DEFAULT_CHUNK { size } else { DEFAULT_CHUNK }
    var chunk = chunk_try(want)
    if chunk == 0 {
        if want != size { chunk = chunk_try(size) }
    }
    demand(chunk != 0, E_REGION_OOM)
    chunk_set(chunk, CHUNK_USED, size)
    chunk_set(chunk, CHUNK_NEXT, region_get(control, region, REGION_HEAD))
    region_set(region, REGION_HEAD, chunk)
    chunk_payload(chunk)
}

/**
 * Allocates `n` bytes in `region` — the arena's central operation. A zero-size request becomes one
 * byte so it still yields a DISTINCT pointer; the request is rounded up to the arena's alignment;
 * an explicitly freed block of the right class is reused before the bump advances (root only, since
 * parked blocks live in root chunks); otherwise the current chunk bumps, or a new chunk is
 * prepended.
 *
 * @param control  the control block's base address
 * @param region   the region to allocate in
 * @param n        the requested size in bytes
 * @return         the allocated block's base address, never 0
 */
pub fn region_alloc(control: u64, region: u64, n: u64): u64 {
    var size = round_up_align(if n == 0 { 1 } else { n })
    if region == ctrl_get(control, CTRL_ROOT) {
        var reused = free_take(control, size)
        if reused != 0 { return reused }
    }
    var head = region_get(control, region, REGION_HEAD)
    if head != 0 {
        var offset = chunk_fit_offset(control, head, size)
        if chunk_offset_fits(control, head, offset) { return region_bump(control, region, offset, size) }
    }
    region_grow(control, region, size)
}

/**
 * Unlinks a region from the global live-region registry — done FIRST on every drop path, so a
 * later sweep can never see, and double-free, a region an earlier drop already owns.
 *
 * @param control  the control block's base address
 * @param region   the region to unlink
 * @return         nothing
 */
pub fn registry_unlink(control: u64, region: u64) {
    var head = ctrl_get(control, CTRL_REGS)
    if head == region {
        ctrl_set(control, CTRL_REGS, region_get(control, region, REGION_REG_NEXT))
        return
    }
    var prev = head
    loop {
        if prev == 0 { break }
        var next = region_get(control, prev, REGION_REG_NEXT)
        if next == region {
            region_set(prev, REGION_REG_NEXT, region_get(control, region, REGION_REG_NEXT))
            break
        }
        prev = next
    }
}

/**
 * Releases a region's chunks, its entry array and its header — the part of a drop that is the same
 * whether one region or a whole sweep is going. The head is cleared BEFORE the chunks are freed, so
 * a second walk over the same region frees nothing.
 *
 * @param control  the control block's base address
 * @param region   the region to release
 * @return         nothing
 */
pub fn region_release(control: u64, region: u64) {
    var head = region_get(control, region, REGION_HEAD)
    region_set(region, REGION_HEAD, 0)
    chunk_free_list(control, head)
    c_free(region_get(control, region, REGION_ENTRIES))
    region_set(region, REGION_ENTRIES, 0)
    region_set(region, REGION_NENTRIES, 0)
    region_set(region, REGION_ENTRIES_CAP, 0)
    c_free(region)
}

/**
 * Bulk-frees a region: every chunk it holds, its entry array and its header, in one call. Tolerates
 * a zero handle. The caller MUST drop its handle afterwards — the region's memory is gone, and
 * reusing the address is exactly what the generation stamp exists to detect.
 *
 * @param control  the control block's base address
 * @param region   the region to drop; 0 is a no-op
 * @return         nothing
 */
pub fn region_drop(control: u64, region: u64) {
    if region == 0 { return }
    registry_unlink(control, region)
    region_set(region, REGION_REG_NEXT, 0)
    region_release(control, region)
}

/**
 * Frees EVERY still-live region and empties the registry — the termination sweep. The whole list is
 * detached into a local FIRST and each region is freed off the local, so a re-entrant call and a
 * second call both see an empty registry and free nothing. Parked blocks are purged first, because
 * they live inside chunks this sweep is about to release.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
pub fn regions_free_all(control: u64) {
    free_purge(control)
    var region = ctrl_get(control, CTRL_REGS)
    ctrl_set(control, CTRL_REGS, 0)
    ctrl_set(control, CTRL_ROOT, 0)
    loop {
        if region == 0 { break }
        var next = region_get(control, region, REGION_REG_NEXT)
        region_release(control, region)
        region = next
    }
}
