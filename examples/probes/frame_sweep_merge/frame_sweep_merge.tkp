# The `lir::frame_sweep_inst` by-address aggregate-through-merge/return probe (native fixpoint
# blocker C2). Mirrors src/lir/frame_escape.tks: `frame_sweep_inst` matches `inst.op` and EVERY
# arm RETURNS a `FrameSet` aggregate, the `FieldAddr` arm returning an `if`-value MERGE of two
# `FrameSet`s; `frame_mark` does an in-place `[]bool` index-assign `fs[v] = true` then rewraps it
# into the returned aggregate. This isolates whether the native SIGSEGV is on the RETURN /
# TAIL-MERGE facet (the returned `FrameSet` box reclaimed with its frame) or the PAYLOAD-BIND /
# index-store facet (the `fs[v] = true` write in a reclaimed region).
#
# EXIT CODES: 42 all three marked VRegs survive; any other code is the wrong mark count.
#
#   TEKO_BACKEND=native teko build examples/probes/frame_sweep_merge
#   ./examples/probes/frame_sweep_merge/bin/frame_sweep_merge    # -> 42
name = "frame_sweep_merge"
source = "src"

[artifact]
kind = "binary"
