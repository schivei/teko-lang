type Alloca = struct {
    bytes: u32
    align: u32
}

type FieldAddr = struct {
    base_vreg: u32
    offset: u32
}

type Jump = struct {
    target: u32
    args: []u32
}

type Branch = struct {
    cond: u32
    t_target: u32
    t_args: []u32
    f_target: u32
    f_args: []u32
}

type Ret = struct {
    has_value: bool
    value: u32
}

type Other = struct {
    val: i64
}

type Op = variant Alloca | FieldAddr | Jump | Branch | Ret | Other

type Inst = struct {
    result: u32
    op: Op
}

type Block = struct {
    id: u32
    params: []u32
    insts: []Inst
}

type Func = struct {
    blocks: []Block
    next_vreg: u64
}

type FrameSet = struct {
    marked: []bool
    grew: bool
}

fn flag_at(marks: []bool, v: u32): bool {
    if v >= marks.len { return false }
    marks[v to u64]
}

fn frame_mark(set: FrameSet, v: u32): FrameSet {
    if flag_at(set.marked, v) { return set }
    if v >= set.marked.len { return set }
    var fs = set.marked
    fs[v to u64] = true
    FrameSet { marked = fs; grew = true }
}

fn block_params_of(f: Func, id: u32): []u32 | null {
    var i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if f.blocks[i].id == id { return f.blocks[i].params }
        i++
    }
    null
}

fn frame_pass_args(f: Func, set: FrameSet, target: u32, args: []u32): FrameSet {
    var params = match block_params_of(f, target) { []u32 as p => p; null => return set }
    var acc = set
    var i: u64 = 0
    loop {
        if i >= args.len || i >= params.len { break }
        if flag_at(acc.marked, args[i]) { acc = frame_mark(acc, params[i]) }
        i++
    }
    acc
}

fn frame_sweep_inst(f: Func, set: FrameSet, inst: Inst): FrameSet {
    match inst.op {
        Alloca => return frame_mark(set, inst.result)
        FieldAddr as fa => return if flag_at(set.marked, fa.base_vreg) { frame_mark(set, inst.result) } else { set }
        Jump as j => return frame_pass_args(f, set, j.target, j.args)
        Branch as br => return frame_pass_args(f, frame_pass_args(f, set, br.t_target, br.t_args), br.f_target, br.f_args)
        _ => { }
    }
    set
}

fn frame_sweep_block(f: Func, set: FrameSet, b: Block): FrameSet {
    var acc = set
    var i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        acc = frame_sweep_inst(f, acc, b.insts[i])
        i++
    }
    acc
}

fn frame_sweep(f: Func, set: FrameSet): FrameSet {
    var acc = set
    var bi: u64 = 0
    loop {
        if bi >= f.blocks.len { break }
        acc = frame_sweep_block(f, acc, f.blocks[bi])
        bi++
    }
    acc
}

fn false_marks(n: u64): []bool {
    var v: [n]bool = []
    v
}

fn frame_marks_of(f: Func): []bool {
    var set = FrameSet { marked = false_marks(f.next_vreg); grew = true }
    loop {
        if !set.grew { break }
        set = frame_sweep(f, FrameSet { marked = set.marked; grew = false })
    }
    set.marked
}

fn count_marks(marks: []bool): i64 {
    var n: i64 = 0
    var i: u64 = 0
    loop {
        if i >= marks.len { break }
        if marks[i] { n = n + 1 }
        i++
    }
    return n
}

fn a(result: u32): Inst { Inst { result = result; op = Alloca { bytes = 8; align = 8 } } }

fn fld(result: u32, vreg: u32): Inst { Inst { result = result; op = FieldAddr { base_vreg = vreg; offset = 8 } } }

fn jmp(target: u32, args: []u32): Inst { Inst { result = 0; op = Jump { target = target; args = args } } }

fn build_func(): Func {
    var b0i: []Inst = [
        a(1),
        fld(2, 1),
        a(3),
        fld(4, 3),
        jmp(10, [2, 4])
    ]
    var b1p: []u32 = [5, 6]
    var b1i: []Inst = [fld(7, 5), a(8), fld(9, 8), jmp(20, [7, 9])]
    var b2p: []u32 = [11, 12]
    var b2i: []Inst = [fld(13, 11), fld(14, 12), Inst { result = 15; op = Ret { has_value = true; value = 13 } }]

    var blocks: []Block = [
        Block { id = 0; params = []; insts = b0i },
        Block { id = 10; params = b1p; insts = b1i },
        Block { id = 20; params = b2p; insts = b2i }
    ]
    Func { blocks = blocks; next_vreg = 16 }
}

fn probe_code(): i32 {
    var marks = frame_marks_of(build_func())
    var n = count_marks(marks)
    if n == 13 { return 42 }
    return n to i32
}
