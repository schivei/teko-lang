mut xs: []i64 = []
teko::list::grow_inplace(&xs, 10)
teko::list::grow_inplace(&xs, 20)
teko::list::grow_inplace(&xs, 30)
demand(xs.len == 3, 1)
demand(xs[0] == 10, 2)
demand(xs[1] == 20, 3)
demand(xs[2] == 30, 4)

mut zs: []i64 = teko::list::with_cap(8)
demand(zs.len == 0, 5)
teko::list::grow_inplace(&zs, 7)
demand(zs.len == 1, 6)
demand(zs[0] == 7, 7)

mut ys: []i64 = []
mut i: i64 = 0
loop {
    if i >= 100000 { break }
    teko::list::grow_inplace(&ys, i)
    i = i + 1
}
demand(ys.len == 100000, 8)
demand(ys[0] == 0, 9)
demand(ys[99999] == 99999, 10)

let lit: []i64 = [3, 4, 5]
demand(lit.len == 3, 11)
demand(lit[2] == 5, 12)

let peak = teko::mem::peak_rss()
println("F3 grow_inplace probe: 100000 in-place appends OK; peak_rss=" ~ teko::str::u64_to_str(peak) ~ " bytes")
exit(42)
