/**
 * Fails loudly when a probe invariant does not hold, exiting with the invariant's own code so the
 * runner reads WHICH check failed straight from the process exit status.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}
