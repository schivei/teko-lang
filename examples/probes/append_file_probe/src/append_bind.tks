pub extern fn append_file(path: str, content: str): i32 = "tk_rt_append_file" from "teko_rt"

pub extern fn pipe_raw(): i64 = "tk_rt_pipe" from "teko_rt"

pub extern fn pipe_read_fd(packed: i64): i64 = "tk_rt_pipe_read_fd" from "teko_rt"

pub extern fn pipe_write_fd(packed: i64): i64 = "tk_rt_pipe_write_fd" from "teko_rt"

pub extern fn close_fd(fd: i64): i32 = "tk_rt_close_fd" from "teko_rt"

pub extern fn fd_fill(fd: i64, timeout_ms: i64): i64 = "tk_rt_fd_fill" from "teko_rt"

pub extern fn fd_take_byte(): i32 = "tk_rt_fd_take_byte" from "teko_rt"

pub extern fn spawn_redirected_raw(payload: str): i64 = "tk_rt_spawn_redirected" from "teko_rt"

pub extern fn wait_one_raw(raw: i64): i32 = "tk_rt_wait_one" from "teko_rt"

pub fn sep(): str { "\0" }

pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

pub fn file_text(path: str): str {
    var p = pipe_raw()
    if p < 0 { return "" }
    var r = pipe_read_fd(p)
    var w = pipe_write_fd(p)
    var head = "3" ~ sep() ~ "sh" ~ sep() ~ "-c" ~ sep() ~ ("cat " ~ path)
    var mid = "0" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ ""
    var h = spawn_redirected_raw(head ~ sep() ~ mid ~ sep() ~ "" ~ sep() ~ teko::str::i64_to_str(w) ~ sep() ~ "")
    if h < 0 { return "" }
    if close_fd(w) != 0 { return "" }
    var text = drain(r, 5000)
    var rc = wait_one_raw(h)
    if close_fd(r) != 0 { return "" }
    if rc != 0 { return "" }
    text
}

pub fn drain(fd: i64, deadline_ms: i64): str {
    var sb: str = ""
    loop {
        var n = fd_fill(fd, deadline_ms)
        if n < 0 { return "" }
        if n == 0 { break }
        var k: u64 = 0
        var bi: u64 = 0
        var buf: [1024] = []
        loop {
            if k >= (n to u64) { break }
            var b = fd_take_byte()
            if b == -1 { break }
            if bi >= 1024 {
                sb = sb ~ teko::text::str_from_utf8(buf)
                bi = 0
            }
            buf[bi] = b to byte
            bi++
            k++
        }

        if bi > 0 {
            sb = sb ~ teko::text::str_from_utf8(buf[0..bi])
        }
    }
    sb
}

pub fn record_text(k: u64): str { "r" ~ teko::str::u64_to_str(k) }

pub fn holds(hay: str, needle: str): bool { teko::str::contains(hay, needle) }

pub fn expected_bulk_len(n: u64): u64 {
    var total: u64 = 0
    var k: u64 = 0
    loop {
        if k >= n { break }
        total = total + record_text(k).len + 1
        k = k + 1
    }
    total
}
