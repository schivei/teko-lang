/**
 * The runtime symbol `teko::io::append_file` wraps — see `src/io/io.tks` for the maintained, typed
 * surface. Bound directly here (not through `teko::io`) because an external standalone project has
 * no visibility into that module's plain Teko wrapper functions; only a LOCAL `extern fn`
 * declaration, pointed at the SAME `teko_rt` symbol, reaches a runtime primitive from outside the
 * compiler's own project.
 *
 * TWO BY-VALUE `tk_str` PARAMETERS, which is exactly the shape whose ABI this probe exists to
 * exercise on both routes.
 *
 * @param path     the file to append to; created when absent
 * @param content  the bytes to append, exactly as given
 * @return         0 on success, -1 when the file could not be opened or fully written
 */
pub extern fn append_file(path: str, content: str): i32 = "tk_rt_append_file" from "teko_rt"

/**
 * Create an anonymous pipe, both descriptors packed into one `i64` — used to read a file back
 * through a `cat` child, the own backend having no `read_file` builtin to read it with.
 *
 * @return the packed descriptor pair, or a negative value when the host refused
 */
pub extern fn pipe_raw(): i64 = "tk_rt_pipe" from "teko_rt"

/**
 * The read end of a `pipe_raw` packing.
 *
 * @param packed  what `pipe_raw` returned
 * @return        the reading descriptor
 */
pub extern fn pipe_read_fd(packed: i64): i64 = "tk_rt_pipe_read_fd" from "teko_rt"

/**
 * The write end of a `pipe_raw` packing.
 *
 * @param packed  what `pipe_raw` returned
 * @return        the writing descriptor
 */
pub extern fn pipe_write_fd(packed: i64): i64 = "tk_rt_pipe_write_fd" from "teko_rt"

/**
 * Close one descriptor — the call that lets the read end reach end-of-file.
 *
 * @param fd  the descriptor to close
 * @return    0 on success, negative on failure
 */
pub extern fn close_fd(fd: i64): i32 = "tk_rt_close_fd" from "teko_rt"

/**
 * Wait under the deadline, then stage one buffer's worth of `fd` inside the runtime.
 *
 * @param fd          the descriptor to read
 * @param timeout_ms  the deadline for the wait that precedes the read
 * @return            bytes staged, 0 at end-of-file, or a negative reading
 */
pub extern fn fd_fill(fd: i64, timeout_ms: i64): i64 = "tk_rt_fd_fill" from "teko_rt"

/**
 * The next staged byte as 0..255, or -1 once the last fill is spent.
 *
 * @return the next byte, or -1
 */
pub extern fn fd_take_byte(): i32 = "tk_rt_fd_take_byte" from "teko_rt"

/**
 * Launch a child without waiting, its streams bound per the payload's descriptor or path slots.
 *
 * @param payload  the flattened spawn arguments
 * @return         the opaque handle, or a negative value when no child started
 */
pub extern fn spawn_redirected_raw(payload: str): i64 = "tk_rt_spawn_redirected" from "teko_rt"

/**
 * Block until the child `raw` names exits, and return its status.
 *
 * @param raw  the handle `spawn_redirected_raw` returned
 * @return     the child's exit status
 */
pub extern fn wait_one_raw(raw: i64): i32 = "tk_rt_wait_one" from "teko_rt"

/**
 * The NUL byte every field of a `spawn_redirected_raw` payload joins on.
 *
 * @return the one-byte separator
 */
pub fn sep(): str { "\0" }

/**
 * Fails loudly when a probe invariant does not hold, exiting with the invariant's own code.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}

/**
 * The whole content of `path`, read back through a `cat` child and a pipe.
 *
 * NOT `teko::io::read_file`: the own backend rejects that builtin ("native backend N1: builtin
 * `read_file` not yet lowered (N2)"), and this probe must run on both routes.
 *
 * @param path  the file to read
 * @return      its bytes, or "" when the child failed
 */
pub fn file_text(path: str): str {
    var p = pipe_raw()
    if p < 0 { return "" }
    var r = pipe_read_fd(p)
    var w = pipe_write_fd(p)
    var head = "3" ~ sep() ~ "sh" ~ sep() ~ "-c" ~ sep() ~ ("cat " ~ path)
    var mid = "0" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ ""
    var h = spawn_redirected_raw(head ~ sep() ~ mid ~ sep() ~ "" ~ sep() ~ teko::str::i64_to_str(w) ~ sep() ~ "")
    if h < 0 { return "" }
    if close_fd(w) != 0 { return "" }
    var text = drain(r, 5000)
    var rc = wait_one_raw(h)
    if close_fd(r) != 0 { return "" }
    if rc != 0 { return "" }
    text
}

/**
 * Drain `fd` until end-of-file, under a deadline per fill.
 *
 * @param fd           the reading end
 * @param deadline_ms  the budget for one fill
 * @return             what the writer sent, or "" when no end-of-file arrived in time
 */
pub fn drain(fd: i64, deadline_ms: i64): str {
    var acc: []byte = teko::list::empty()
    loop {
        var n = fd_fill(fd, deadline_ms)
        if n < 0 { return "" }
        if n == 0 { break }
        var k: u64 = 0
        loop {
            if k >= (n to u64) { break }
            var b = fd_take_byte()
            if b == -1 { break }
            acc = teko::list::push(acc, b to byte)
            k = k + 1
        }
    }
    match teko::text::str_from_utf8(acc) { str as s => s; error => "" }
}

/**
 * The record emitted at index `k`, carrying its own index so ORDER can be asserted and not merely
 * the line count.
 *
 * @param k  the record's index
 * @return   the record, WITHOUT a trailing newline
 */
pub fn record_text(k: u64): str { "r" ~ teko::str::u64_to_str(k) }

/**
 * Does `hay` contain `needle`?
 *
 * @param hay     the text to search
 * @param needle  what to look for
 * @return        true iff `needle` occurs in `hay`
 */
pub fn holds(hay: str, needle: str): bool { teko::str::contains(hay, needle) }

/**
 * How many bytes `n` records of `record_text` plus their newlines occupy — the size the bulk file
 * must have if not one record was lost or duplicated.
 *
 * @param n  how many records were appended
 * @return   the exact expected byte count
 */
pub fn expected_bulk_len(n: u64): u64 {
    var total: u64 = 0
    var k: u64 = 0
    loop {
        if k >= n { break }
        total = total + record_text(k).len + 1
        k = k + 1
    }
    total
}
