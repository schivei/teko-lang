var path = "append-probe.log"

demand(append_file(path, "") == 0, 10)
demand(append_file(path, "alpha\n") == 0, 10)
demand(file_text(path) == "alpha\n", 10)

demand(append_file(path, "beta\n") == 0, 11)
demand(file_text(path) == "alpha\nbeta\n", 11)

var bulk = "append-probe-bulk.log"
var k: u64 = 0
loop {
    if k >= 200 { break }
    demand(append_file(bulk, record_text(k) ~ "\n") == 0, 12)
    k = k + 1
}
var text = file_text(bulk)
demand(holds(text, "r0\nr1\n"), 12)
demand(holds(text, "\nr100\n"), 12)
demand(holds(text, "\nr199\n"), 12)
demand(text.len == expected_bulk_len(200), 12)

demand(append_file("no-such-dir-xyz/append-probe.log", "x") != 0, 13)

demand(wait_one_raw(spawn_redirected_raw("3" ~ sep() ~ "sh" ~ sep() ~ "-c" ~ sep() ~ ("rm -f " ~ path ~ " " ~ bulk) ~ sep() ~ "0" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "")) == 0, 14)

exit(42)
