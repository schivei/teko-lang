# The append_file BOTTOM probe (cargo/0.3.1.0-fundacao-f5-pipe).
#
# Proves `tk_rt_append_file` (src/runtime/teko_rt.{c,h}) — the primitive that replaced
# `teko::process::verdict_emit`'s read-the-whole-file-back-and-rewrite-it shape — lowers and behaves
# on BOTH code-generation routes, which is the condition this house puts on a new primitive.
#
# WHY THIS ONE NEEDED ITS OWN PROBE, AND IT IS AN ABI REASON, NOT A ZEAL ONE. `tk_rt_append_file`
# declares TWO by-value `tk_str` parameters. On SysV and AAPCS64 a 2-eightbyte aggregate decomposes
# into two consecutive integer registers, so the flat `(ptr, len)` spelling the native backend emits
# by default is INVISIBLY correct on Linux and macOS; the Microsoft x64 ABI passes a 16-byte
# aggregate BY REFERENCE, reads that first register as a pointer, and faults with ACCESS_VIOLATION
# (0xC0000005). That is a measured 2026-07-30 defect, not a hypothesis, and it is why the symbol is
# registered in `src/lir/lower.tks`'s `TWO_STR_BY_VALUE_ENTRIES` beside `tk_rt_write_file`, whose
# signature is identical.
#
# WHAT EACH EXIT CODE MEANS:
#
#   10  the first append created the file and wrote exactly its bytes
#   11  a second append EXTENDED the file rather than replacing it — the whole difference between
#       this primitive and `write_file`, and the one thing a mistaken `O_TRUNC` would silently break
#   12  every one of many records is present, AT ITS OWN INDEX — order and liveness, asserted before
#       any claim about cost; a test that only counted lines would pass on an append that dropped a
#       record in the middle and duplicated another
#   13  appending to a path in a directory that does not exist FAILS, and says so — a primitive that
#       swallowed that would turn a lost verdict channel into a silent success
#
# READS ITS FILE BACK THROUGH A CHILD (`cat`) AND A PIPE rather than through `teko::io::read_file`,
# because the own backend rejects that builtin outright ("native backend N1: builtin `read_file` not
# yet lowered (N2)") — the same reason `examples/probes/pipe_probe` reads its own back that way.
#
# THE ABI FORM, MEASURED IN THE EMITTED COFF ON BOTH SIDES OF THE INVERSION. Cross-built with
# `TEKO_TARGET=x86_64-windows` and read with `llvm-objdump -dr`:
#
#   WITH the `TWO_STR_BY_VALUE_ENTRIES` entry — the two aggregates are materialized on the stack and
#   their ADDRESSES travel, which is the Microsoft x64 ABI:
#
#       leaq 0x30(%rsp), %rdx ; movq %rbx, (%rdx) ; movq %rsi, 0x8(%rdx)
#       leaq 0x40(%rsp), %r8  ; movq %rax, (%r8)  ; movq %rcx, 0x8(%r8)
#       movq %rdx, %rcx       ; movq %r8, %rdx
#       callq tk_rt_append_file
#
#   WITHOUT it — the FLAT pairs, four registers, no aggregate anywhere:
#
#       movq %rbx, %rcx ; movq %rsi, %rdx ; movq %rax, %r8 ; movq %rdi, %r9
#       callq tk_rt_append_file
#
# In the second form MSVC reads RCX as a pointer to a 16-byte aggregate and dereferences the string's
# own first bytes — the ACCESS_VIOLATION. No Windows host is needed to see this; the object is.
#
#   TK_RT_DIR=<repo>/src/runtime teko build examples/probes/append_file_probe    # own backend -> 42
#   TK_RT_DIR=<repo>/src/runtime TEKO_BACKEND=c teko build examples/probes/append_file_probe  # -> 42
#   ./examples/probes/append_file_probe/bin/append_file_probe
name = "append_file_probe"
source = "src"

[artifact]
kind = "binary"
