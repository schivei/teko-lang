# §10 C0b — the `tk_memchan` runtime probe (in-process bounded-ring MPSC FIFO).
#
# Proves the first channel transport primitive: `tk_memchan_make`/`send`/`recv`/`close`/`end`
# (src/runtime/teko_rt.c) move fixed-width elements across a pthread mutex + cond-var bounded ring
# that lives in the F2 program region (so it outlives the producing task). The `chan<T>` surface does
# not exist yet, so the probe reaches the primitive the SAME way `thread_spawn` reaches
# tk_thread_spawn: ONE ordinary scalar extern into a C-owned selftest body.
#
# tk_memchan_selftest(10000) spawns a producer that sends 0..9999 (i64) through a bounded-16 ring,
# the caller thread recv's them all, and the C body asserts order + sum + a clean close/drain. Under
# TEKO_MEM_PARANOID=1 the freed blocks are poisoned and never parked, so a stray cross-arena pointer
# would corrupt. Success -> exit 42; any drift/mis-order -> exit 1.
#
#   TEKO_MEM_PARANOID=1 ./examples/probes/memchan/bin/memchan   # -> 42
name = "memchan"
source = "src"

[artifact]
kind = "binary"
