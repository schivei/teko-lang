/**
 * memchan_selftest — the C-owned §10 C0b probe body, reached through ONE scalar extern (the
 * thread_spawn_selftest idiom, since a Teko test cannot pass a `void(*)(void*)`). Spawns a producer
 * that sends 0..n-1 (i64) across a bounded in-process ring, recv's them on the caller thread, and
 * asserts order + sum + a clean close/drain.
 *
 * @param n  the number of i64 elements the producer sends
 * @return   0 when the round-trip held, a non-zero failure code otherwise
 * @since 0.3.1 §10 C0b
 */
extern fn memchan_selftest(n: i64): u64 = "tk_memchan_selftest" from "teko_rt"

/**
 * probe_memchan — drive one 10000-element producer/consumer round-trip across the bounded ring and
 * check the C body verified order + sum. Returns 42 on a clean round-trip, 1 on any drift. Run under
 * TEKO_MEM_PARANOID=1 so a stray cross-arena pointer corrupts rather than parks.
 *
 * @return  42 when the channel round-trips, 1 when the C body reported a mismatch
 * @since 0.3.1 §10 C0b
 */
pub fn probe_memchan(): i32 {
    var rc = memchan_selftest(10000)
    if rc != 0 { return 1 }
    42
}
