# The native `checker::type_array_lit` probe (native fixpoint blocker — the FIRST wall of the
# native self-build). `type_array_lit` folds an array literal's element types and cross-adopts a
# bare numeric-literal sibling into a concrete element's type via
# `match array_join_anchor(typed) { Type as anchor => adopt_array_elem_literals(typed, anchor); null => typed }`
# — a `[]TArrayElem` conveyed OUT of a `match` merge. A NATIVE-built compiler (gen2) miscompiled
# that fat-slice-through-`match`-merge, so gen2 checking any array literal whose join takes the
# `adopt` arm crashed at `type_array_lit+4519` (checker item 3/7080 of the compiler's own source).
#
# FACET: fat-slice conveyed through a `match` merge (the return/tail-merge shape degrau 5 pinned
# for a `match`-VALUE). The C route builds and runs this correctly; only a native-built compiler
# faulted. This is the pass/fail gate: the native-built compiler must build it and the built binary
# run to exit 42.
name = "native_type_array_lit"
source = "src"

[artifact]
kind = "binary"
