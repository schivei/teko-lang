/**
 * nested_slices — an array literal whose elements are THEMSELVES slices (`[]i64`), so
 * `type_array_lit`'s `array_join_anchor` returns a `Slice` anchor (the `Type` variant's `Slice`
 * case, tag 4 >= 2). A native-built compiler wrapped that `Type` into the `Type | null` fold with
 * the WRONG discriminant (the raw `Type`'s own inner tag, never the null-union's payload tag 1), so
 * the `match` fell through to its dead defensive `(ptr = 0, len = 0x80000000)` edge and the
 * following element fold dereferenced the null pointer — `type_array_lit+4519`, checker item 3/7080
 * of the compiler's own source. `xss[0][0] + xss[1][0]` reads the built slices back.
 *
 * @return  40 + 2 from the two nested slices
 */
fn nested_slices() -> i64 {
    let xss = [[40], [2]]
    return xss[0][0] + xss[1][0]
}

/**
 * str_labels — an array literal of STRING elements, so `array_join_anchor` returns a `Str` anchor
 * (the `Type` variant's `Str` case, tag 3 >= 2) — the same crashing fold on a different `Type` tag.
 * Its `.len` is folded out of the total so the probe's exit code is unaffected.
 *
 * @return  the element count of the `[]str` literal
 */
fn str_labels() -> i64 {
    let names = ["ok", "no"]
    return names.len to i64
}

/**
 * drive — combine the two crashing array-literal shapes; the `str_labels` contribution cancels so
 * the probe exits 42 (the value `nested_slices` produces) once the fold is compiled correctly.
 *
 * @return  42
 */
fn drive() -> i64 {
    let a = nested_slices()
    let b = str_labels()
    return a + b - b
}
