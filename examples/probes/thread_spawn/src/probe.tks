/**
 * thread_spawn_selftest — the C-owned §10 C0a probe body, reached through ONE scalar extern (the
 * tk_test_capture_probe idiom, since a Teko test cannot pass a `void(*)(void*)`). Spawns `n` threads,
 * each a full tk_task_begin/alloc/tk_task_end cycle joined to completion, and returns the
 * tk_names_live_count delta from the pre-spawn baseline.
 *
 * @param n  the number of threads to spawn and join
 * @return   the live-name count drift across the whole spawn/join batch (0 when arena-balanced)
 * @since 0.3.1 §10 (concurrency batch 1)
 */
extern fn thread_spawn_selftest(n: i64): u64 = "tk_thread_spawn_selftest" from "teko_rt"

/**
 * probe_thread_spawn — drive 100 arena-per-thread spawn/join cycles and check zero live-name drift.
 * Returns 42 on a balanced run (every task_begin/alloc/task_end matched across 100 independent
 * arenas), 1 on any drift. Run under TEKO_MEM_PARANOID=1 so a stray cross-arena pointer corrupts
 * rather than parks.
 *
 * @return  42 when the arenas balance, 1 when the live-name count drifted
 * @since 0.3.1 §10 (concurrency batch 1)
 */
pub fn probe_thread_spawn(): i32 {
    var drift = thread_spawn_selftest(100)
    if drift != 0 { return 1 }
    42
}
