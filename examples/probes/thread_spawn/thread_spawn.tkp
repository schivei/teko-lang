# §10 C0a — the `tk_thread_spawn` runtime probe (arena-per-thread paranoid selftest).
#
# Proves the FIRST concurrency primitive: `tk_thread_spawn`/`tk_thread_join_spawn`/`tk_thread_join`
# (src/runtime/teko_rt.c) start detached/joinable OS threads, each on its OWN sub-root arena
# (tk_task_begin/tk_task_end bracket owned by the runtime's pthread start-routine). The Teko surface
# (`spawn f(args)`) does not exist yet, so the probe reaches the primitive the SAME way the `#test`
# capture guard reaches tk_test_run: ONE ordinary scalar extern into a C-owned selftest body.
#
# tk_thread_spawn_selftest(100) spawns 100 threads, each doing tk_task_begin / 32 allocations /
# tk_task_end, JOINS them all (deterministic — a detached spawn gives the probe no finish edge), and
# returns the tk_names_live_count DELTA from the pre-spawn baseline. Under TEKO_MEM_PARANOID=1 the
# freed blocks are poisoned and never parked, so a stray cross-arena pointer would corrupt and drift
# the count. Delta 0 -> exit 42 (the success sentinel); any drift -> exit 1.
#
#   TEKO_MEM_PARANOID=1 ./examples/probes/thread_spawn/bin/thread_spawn   # -> 42
name = "thread_spawn"
source = "src"

[artifact]
kind = "binary"
