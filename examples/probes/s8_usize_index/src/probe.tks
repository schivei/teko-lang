// 0.3.1 §8 ACCEPT — `usize` at a memory/collection position (a slice subscript index).

/**
 * index — the design doc's own §8 example (`docs/design/mudancas-superficie-0.3.1.md` line 298):
 * a slice subscript whose index carries the machine-word width `usize`. `usize` is an integer, so
 * `xs[i]` is admitted; it lowers to `uint64_t` on the 64-bit target (usize ≡ u64), so the emitted
 * C is exactly what a `u64` index would have produced.
 *
 * @param xs  the slice to read
 * @param i   the position, at machine-word width
 * @return    the element at `i`
 */
fn index(xs: []i64, i: usize): i64 { return xs[i] }

/**
 * sum_all — a `usize` LOOP COUNTER walking a slice: `i` is compared against the `u64` `.len`
 * (two integers compare regardless of sign/width) and incremented (machine-word arithmetic),
 * then flows back into `index` as the `usize` argument.
 *
 * @param xs  the slice to total
 * @return    the sum of every element
 */
fn sum_all(xs: []i64): i64 {
    var i: usize = 0
    var total: i64 = 0
    loop {
        if i >= xs.len { break }
        total = total + index(xs, i)
        i++
    }
    total
}

/**
 * drive — the probe body: a direct `usize` subscript and a `usize`-counted sum, each guarded by
 * its own exit code so a failure names the invariant. Returns 42 when both hold.
 *
 * @return  42 on success; 1 or 2 on a failed invariant
 */
fn drive(): i64 {
    var lit: []i64 = [10, 20, 30]

    // direct subscript with a `usize` value
    var one: usize = 1
    if index(lit, one) != 20 { return 1 }

    // `usize` loop counter over the slice
    if sum_all(lit) != 60 { return 2 }

    42
}
