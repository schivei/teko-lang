# examples/probes/s8_usize_index — the 0.3.1 §8 ACCEPT fixture for the machine-word types
# `size`/`usize` (docs/design/mudancas-superficie-0.3.1.md §8). It proves the new `usize` kind is
# usable at a genuine MEMORY/COLLECTION position: a slice subscript index. `fn index(xs: []i64,
# i: usize): i64 { return xs[i] }` type-checks (a `usize` is an integer, so `xs[i]` is admitted),
# lowers (`usize` ≡ `u64` on the 64-bit target — the machine-word lowering table maps `Usize`→
# `uint64_t`), and RUNS. The probe also drives a `usize` LOOP COUNTER compared against a `u64`
# `.len` (the comparison is sign/width-agnostic between two integers) and incremented, exercising
# `usize` in arithmetic exactly like `u64`.
#
#   TK_RT_DIR=$PWD/src/runtime TEKO_BACKEND=c teko build examples/probes/s8_usize_index -o out --no-verify --release
#   ./out/teko     # -> exits 42 on success; a non-42 code names the failed invariant
name = "s8_usize_index"
source = "src"

[artifact]
kind = "binary"
