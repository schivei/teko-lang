# The #112 N112.0 crash-repro probe — the native self-host `assemble_sel` SIGSEGV, minimized.
#
# WHAT IT REPRODUCES. The native self-host fixpoint (gen2 == gen3) crashes boxing a slice element
# (`tk_slice_elem_box` / `tk_mem_copy`) reached from `src/build/assemble.tks::assemble_sel`, whose
# hot loop pushes a `parser::Item = { content: ItemKind; namespace: str; file: str }` into a
# `[]parser::Item`. `ItemKind` is a variant with SEVERAL aggregate cases (`Function`, `TypeDecl`, …)
# whose payloads carry FAT-ELEMENT slices (`[]Stmt`, `[][]…`, `[]str`). This probe is that shape
# reduced to its essence: a `[]Item` of an aggregate whose variant `content` field has TWO aggregate
# cases, each carrying a `[]str` (a slice whose ELEMENTS are themselves fat `{ptr,len}` values), built
# in a loop and read back.
#
# THE CONFIRMED MECHANISM (N112.0 diagnosis, NOT the design's leading hypothesis). Every box/push
# width the native backend computes here is CORRECT (array 16/32, case-struct 32, variant wrapper 24,
# `Item` 40, by-address element pointer 8) — there is NO 16-vs-24 fat-width disagreement. The fault is
# a REGION-LIFETIME / by-address-element ESCAPE bug: the per-iteration `tk_slice_elem_box` storage for
# the pushed aggregate is allocated in a scoped/loop region that is reclaimed each iteration, so the
# `[]Item` buffer's by-address element pointers ALIAS and then DANGLE (measured: element 0 and element
# 2 share one box address; a later grow-realloc reads a wild `0x5`), and the read-back aggregate copy
# (`tk_mem_copy`) faults. See `src/lir/lower.tks:1620` (`open_native_region`), which already names
# "the self-hosted `assemble_sel` gen2==gen3 crash" as this by-address-element-in-scoped-region class
# and fixes the MATCH-ARM conveyance instance; this probe exhibits a REMAINING instance triggered by a
# fat-element-slice payload in a multi-aggregate-case variant pushed in a plain loop.
#
# WHY THE #112 REP FLIP (slice 2-word -> 3-word) WILL NOT FIX THIS. The `[]str` payload here crashes,
# and `str` STAYS a 2-word `{ptr,len}` fat under #112 (str-no-widen is the owner's inviolable
# constraint). A width change that never touches `str` cannot cure a crash the `[]str` instance
# reproduces. The rep separation is orthogonal to this region-lifetime defect.
#
# STATUS: this probe SIGSEGVs (exit 139) on the OWN/native backend TODAY. It is the pre-registered gate
# for the native fixpoint crash: it must reach exit 42 once the by-address-element region-lifetime bug
# is fixed. The C route holds `[]struct` BY VALUE in the routed grow region and is immune (exit 42).
#
#   TK_RT_DIR=<repo>/src/runtime TEKO_BACKEND=native teko build examples/probes/n112_assemble_sel_crash
#   ./examples/probes/n112_assemble_sel_crash/bin/n112_assemble_sel_crash    # native: SIGSEGV today
name = "n112_assemble_sel_crash"
source = "src"

[artifact]
kind = "binary"
