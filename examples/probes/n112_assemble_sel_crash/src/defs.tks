/**
 * Param — a leaf aggregate with two `str` fields, standing in for the parser's `Param`/field nodes.
 *
 * @field pname  the parameter's name, a `str`
 * @field pty    the parameter's type spelling, a `str`
 */
pub type Param = struct {
    /** the parameter's name, a `str`. */
    pname: str
    /** the parameter's type spelling, a `str`. */
    pty: str
}

/**
 * Func — one variant case payload carrying a FAT-ELEMENT slice (`[]str`, whose elements are fat
 * `{ptr,len}` values), the shape that reproduces the native `assemble_sel` by-address-element crash.
 *
 * @field fname  the function's name, a `str`
 * @field body   a slice of `str`, a FAT-element slice (16-byte `{ptr,len}` element stride)
 */
pub type Func = struct {
    /** the function's name, a `str`. */
    fname: str
    /** a slice of `str` — a FAT-element slice (16-byte `{ptr,len}` element stride). */
    body: []str
}

/**
 * TypeDecl — a SECOND aggregate case, also carrying a fat-element `[]str`. Two DISTINCT aggregate
 * cases are load-bearing: a single aggregate case (`Func | i64`) does NOT reproduce the crash.
 *
 * @field tname  the type's name, a `str`
 * @field tbody  a slice of `str`, a FAT-element slice
 */
pub type TypeDecl = struct {
    /** the type's name, a `str`. */
    tname: str
    /** a slice of `str` — a FAT-element slice. */
    tbody: []str
}

/**
 * Kind — the variant with TWO aggregate cases plus a scalar case, mirroring `parser::ItemKind`. The
 * multi-aggregate-case shape is what makes the pushed aggregate's element box land in a reclaimed
 * scoped region.
 */
pub type Kind = variant Func | TypeDecl | i64

/**
 * Item — the pushed aggregate: a variant `content` followed by two trailing `str` fields, mirroring
 * `parser::Item = { content: ItemKind; namespace: str; file: str }`. The trailing `str` fields are
 * the read-back VICTIMS: the by-address `Item` copy reads a dangling element pointer and faults.
 *
 * @field content    the variant payload (a `Kind`)
 * @field namespace  a trailing `str` field (A3 provenance analog)
 * @field file       a trailing `str` field (W-loc analog)
 */
pub type Item = struct {
    /** the variant payload (a `Kind`). */
    content: Kind
    /** a trailing `str` field (A3 provenance analog). */
    namespace: str
    /** a trailing `str` field (W-loc analog). */
    file: str
}

/**
 * make_func — build an `Item` whose `content` is a `Func` case carrying a two-element `[]str` body.
 *
 * @param k  the iteration index, folded into the body so successive items differ
 * @return   a fresh `Item` in the `Func` case
 */
pub fn make_func(k: i64): Item {
    var f = Func { fname = "fn"; body = ["a", "b"] }
    Item { content = f; namespace = "ns"; file = "f.tks" }
}

/**
 * make_type — build an `Item` whose `content` is a `TypeDecl` case carrying a one-element `[]str`.
 *
 * @param k  the iteration index (unused in the value, present to mirror `make_func`'s signature)
 * @return   a fresh `Item` in the `TypeDecl` case
 */
pub fn make_type(k: i64): Item {
    var t = TypeDecl { tname = "T"; tbody = ["x"] }
    Item { content = t; namespace = "ns"; file = "t.tks" }
}

/**
 * demand — fail loudly with a distinct exit code when a probe invariant does not hold, so the runner
 * reads WHICH check failed straight from the process exit status.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}
