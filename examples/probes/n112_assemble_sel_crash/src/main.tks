mut one: []Item = teko::list::empty()
mut i: i64 = 0
loop {
    if i >= 12 { break }
    if i % 2 == 0 { one = teko::list::push(one, make_func(i)) }
    if i % 2 == 1 { one = teko::list::push(one, make_type(i)) }
    i = i + 1
}
mut merged: []Item = teko::list::empty()
mut k: u64 = 0
loop {
    if k >= one.len { break }
    merged = teko::list::push(merged, Item { content = one[k].content; namespace = "n"; file = "p.tks" })
    k = k + 1
}
demand(merged.len == 12, 1)
mut acc: i64 = 0
mut j: u64 = 0
loop {
    if j >= merged.len { break }
    let it = merged[j]
    acc = acc + (it.file.len to i64) + (it.namespace.len to i64)
    match it.content {
        Func as f => { acc = acc + (f.fname.len to i64) + (f.body.len to i64) }
        TypeDecl as t => { acc = acc + (t.tname.len to i64) + (t.tbody.len to i64) }
        i64 as n => { acc = acc + n }
    }
    j = j + 1
}
demand(acc == 108, 2)
exit(42)
