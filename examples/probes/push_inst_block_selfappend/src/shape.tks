type Blk = struct {
    id: u32
    insts: []i64
}

type Fn = struct {
    blocks: []Blk
}

fn new_blk(id: u32): Blk {
    Blk { id = id; insts = [] }
}

fn push_inst_block(b: Blk, inst: i64): Blk {
    Blk { id = b.id; insts = teko::list::push(b.insts, inst) }
}

fn append_inst(f: Fn, block_id: u32, inst: i64): Fn {
    var blocks = f.blocks
    var i: u64 = 0
    loop {
        if i >= blocks.len { break }
        if blocks[i].id == block_id {
            blocks[i] = push_inst_block(blocks[i], inst)
            break
        }
        i++
    }
    Fn { blocks = blocks }
}

fn build(): Fn {
    var blocks: []Blk = teko::list::empty()
    blocks = teko::list::push(blocks, new_blk(0))
    blocks = teko::list::push(blocks, new_blk(1))
    blocks = teko::list::push(blocks, new_blk(2))
    var f = Fn { blocks = blocks }
    var k: i64 = 0
    loop {
        if k >= 64 { break }
        f = append_inst(f, 0, k)
        f = append_inst(f, 1, k * 2)
        f = append_inst(f, 2, k * 3)
        k++
    }
    return f
}

fn total(f: Fn): i64 {
    var sum: i64 = 0
    var i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        var b = f.blocks[i]
        var j: u64 = 0
        loop {
            if j >= b.insts.len { break }
            sum = sum + b.insts[j]
            j++
        }
        i++
    }
    return sum
}

fn probe_code(): i32 {
    var f = build()
    if total(f) == 12096 { return 42 }
    return 1
}
