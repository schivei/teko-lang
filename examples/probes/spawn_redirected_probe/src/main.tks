let script = "cat >/dev/null; printf out-mark; printf err-mark 1>&2"
let three_stream_payload = "3" ~ sep() ~ "/bin/sh" ~ sep() ~ "-c" ~ sep() ~ script ~ sep() ~ "0" ~ sep() ~ "" ~ sep() ~ "/dev/null" ~ sep() ~ "spawnprobe.out" ~ sep() ~ "spawnprobe.err"
let h1 = spawn_redirected_raw(three_stream_payload)
demand(h1 >= 0, 10)
let rc1 = wait_one_raw(h1)
demand(rc1 == 0, 11)

let empty_argv_payload = "0" ~ sep() ~ "0" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ ""
let h2 = spawn_redirected_raw(empty_argv_payload)
demand(h2 < 0, 14)

let bad_exe_payload = "1" ~ sep() ~ "/no/such/executable-xyz-probe" ~ sep() ~ "0" ~ sep() ~ "" ~ sep() ~ "" ~ sep() ~ "spawnprobe3.out" ~ sep() ~ "spawnprobe3.err"
let h3 = spawn_redirected_raw(bad_exe_payload)
demand(h3 >= 0, 15)
let rc3 = wait_one_raw(h3)
demand(rc3 == 127, 16)

exit(42)
