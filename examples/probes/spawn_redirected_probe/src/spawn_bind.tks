/**
 * The runtime symbol `spawn_redirected` wraps — see `src/process/process.tks` for the maintained,
 * typed surface. Bound directly here (not through `teko::process`) because an external standalone
 * project has no visibility into that module's plain Teko wrapper functions; only a LOCAL `extern
 * fn` declaration, pointed at the SAME `teko_rt` symbol, reaches a runtime primitive from outside
 * the compiler's own project — the same pattern `examples/probes/arena_bottom` uses for its own
 * libc bindings.
 *
 * `payload` is `spawn_payload`'s self-describing flattening (see `src/process/process.tks` for the
 * exact shape): `<argc>` NUL `argv[0]` … `argv[argc-1]` NUL `<envc>` NUL `env[0]` … `env[envc-1]`
 * NUL `dir` NUL `in_path` NUL `out_path` NUL `err_path`.
 *
 * @param payload  the flattened spawn arguments
 * @return         the opaque handle, or a negative value when no child ever started
 */
pub extern fn spawn_redirected_raw(payload: str) -> i64 = "tk_rt_spawn_redirected" from "teko_rt"

/**
 * The runtime symbol `wait_one` wraps — see `src/process/process.tks`. Bound directly for the same
 * reason `spawn_redirected_raw` above is.
 *
 * @param raw  the handle `spawn_redirected_raw` returned
 * @return     the child's exit status, or a negative value when `raw` never named a real child
 */
pub extern fn wait_one_raw(raw: i64) -> i32 = "tk_rt_wait_one" from "teko_rt"

/**
 * The NUL byte every field of a `spawn_redirected_raw` payload joins on — see
 * `src/process/process.tks`'s `TOKEN_SEP` for why NUL is safe as a universal separator here.
 *
 * @return the one-byte separator, as a `str`
 */
pub fn sep() -> str { "\0" }

/**
 * Fails loudly when a probe invariant does not hold, exiting with the invariant's own code — the
 * same "one exit code per checked invariant" style `examples/probes/arena_bottom` uses.
 *
 * @param held  the invariant's truth value
 * @param code  the exit code identifying this invariant, used only on failure
 * @return      nothing
 */
pub fn demand(held: bool, code: i32) {
    if held { return }
    exit(code)
}
