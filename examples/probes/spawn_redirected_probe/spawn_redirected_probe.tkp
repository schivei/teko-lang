# The spawn_redirected/wait_one BOTTOM probe (cargo/0.3.1.0-harness-processos, migalha 0b/7).
#
# Proves the two native runtime primitives migalha 7 adds (src/runtime/teko_rt.{c,h}:
# tk_rt_spawn_redirected/tk_rt_wait_one) actually LOWER on the native backend and behave as
# documented, end to end:
#
#   * a child's three standard streams land in the files the PARENT named (spawn_redirected_
#     three_streams);
#   * an empty argv never forks at all, and is reported with a NEGATIVE handle before any wait
#     (spawn_failure_is_negative — TK_RT_SPAWN_FAILED, teko_rt.h);
#   * a real fork whose exec fails (a nonexistent executable) still returns a POSITIVE handle —
#     the fork succeeded — and wait_one reports the POSIX exec-failed convention (127), the same
#     reading `teko::process::run` already documents.
#
# MEASURED, NOT ASSUMED (migalha 0b): a `spawn_redirected_raw` declared with `argv: []str` (or a
# second `env: []str`) made the C route emit a call missing a slice's length argument — no `[]str`
# parameter lowers there outside the one hand-written `run`/`run_quiet` shim. A six-`str`-parameter
# signature checked but tripped the native x86-64 backend's `B1-args` gap (a call argument past the
# six-register window). Both measurements are why `src/process/process.tks`'s `spawn_redirected_raw`
# takes exactly ONE flattened `str` payload — this probe binds the SAME runtime symbol directly
# (`= "tk_rt_spawn_redirected" from "teko_rt"`), bypassing `teko::process` entirely, because an
# external standalone project has no visibility into that module's plain (non-extern) Teko wrapper
# functions — only a LOCAL `extern fn` declaration or the checker's `host_surface_fn` mirror reach a
# runtime symbol from outside the compiler's own project (the same reason arena_bottom binds its own
# libc externs directly instead of going through a stdlib namespace).
#
#   TEKO_TARGET=x86_64-linux TK_RT_DIR=<repo>/src/runtime teko build examples/probes/spawn_redirected_probe
#   ./examples/probes/spawn_redirected_probe/bin/spawn_redirected_probe     # -> 42
#
# NATIVE ONLY: the C route has no generic `extern fn` slice/arity story to fall back on either (see
# above) — this probe is native-or-nothing, same as arena_bottom.
name = "spawn_redirected_probe"
source = "src"

[artifact]
kind = "binary"
