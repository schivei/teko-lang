var connected = pipe_raw()
demand(connected >= 0, 10)
var cr = pipe_read_fd(connected)
var cw = pipe_write_fd(connected)
demand(cr >= 0 && cw >= 0 && cr != cw, 10)

var h1 = spawn_redirected_raw(shell_payload("printf pipe-mark", "", no_fd(), fd_token(cw), no_fd()))
demand(h1 >= 0, 11)
demand(close_fd(cw) == 0, 11)
demand(drain(cr, 2000) == "pipe-mark", 11)
demand(wait_one_raw(h1) == 0, 11)
demand(close_fd(cr) == 0, 11)

var idle = pipe_raw()
demand(idle >= 0, 12)
var ir = pipe_read_fd(idle)
var iw = pipe_write_fd(idle)
var h2 = spawn_redirected_raw(shell_payload("printf pipe-mark", "pipe-probe-elsewhere.out", no_fd(), no_fd(), no_fd()))
demand(h2 >= 0, 12)
demand(wait_one_raw(h2) == 0, 12)
demand(close_fd(iw) == 0, 12)
demand(drain(ir, 500) == "", 12)
demand(close_fd(ir) == 0, 12)

var eofp = pipe_raw()
demand(eofp >= 0, 13)
var er = pipe_read_fd(eofp)
var ew = pipe_write_fd(eofp)
var h3 = spawn_redirected_raw(shell_payload("printf a; printf b", "", no_fd(), fd_token(ew), no_fd()))
demand(h3 >= 0, 13)
demand(close_fd(ew) == 0, 13)
demand(drain(er, 2000) == "ab", 13)
demand(fd_fill(er, 2000) == 0, 14)
demand(fd_take_byte() == -1, 14)
demand(wait_one_raw(h3) == 0, 14)
demand(close_fd(er) == 0, 14)

var heldp = pipe_raw()
demand(heldp >= 0, 15)
var hr = pipe_read_fd(heldp)
var hw = pipe_write_fd(heldp)
var h4 = spawn_redirected_raw(shell_payload("printf half", "", no_fd(), fd_token(hw), no_fd()))
demand(h4 >= 0, 15)
demand(wait_one_raw(h4) == 0, 15)
demand(fd_fill(hr, 2000) == 4, 15)
demand(match teko::text::str_from_utf8(take_staged(teko::list::empty(), 4)) { str as s => s; error => "" } == "half", 15)
demand(fd_fill(hr, 400) == -1, 15)
demand(close_fd(hw) == 0, 15)
demand(fd_fill(hr, 2000) == 0, 15)
demand(close_fd(hr) == 0, 15)

var merged = pipe_raw()
demand(merged >= 0, 16)
var mr = pipe_read_fd(merged)
var mw = pipe_write_fd(merged)
var h5 = spawn_redirected_raw(shell_payload("printf O; printf E 1>&2", "", no_fd(), fd_token(mw), fd_token(mw)))
demand(h5 >= 0, 16)
demand(close_fd(mw) == 0, 16)
demand(drain(mr, 2000) == "OE", 16)
demand(wait_one_raw(h5) == 0, 16)
demand(close_fd(mr) == 0, 16)

var h6 = spawn_redirected_raw(shell_payload("printf path-mark", "pipe-probe-path.out", no_fd(), no_fd(), no_fd()))
demand(h6 >= 0, 17)
demand(wait_one_raw(h6) == 0, 17)

var back = pipe_raw()
demand(back >= 0, 18)
var br = pipe_read_fd(back)
var bw = pipe_write_fd(back)
var h7 = spawn_redirected_raw(shell_payload("cat pipe-probe-path.out; rm -f pipe-probe-path.out pipe-probe-elsewhere.out", "", no_fd(), fd_token(bw), no_fd()))
demand(h7 >= 0, 18)
demand(close_fd(bw) == 0, 18)
demand(drain(br, 2000) == "path-mark", 18)
demand(wait_one_raw(h7) == 0, 18)
demand(close_fd(br) == 0, 18)

demand(close_fd(-1) < 0, 19)
demand(fd_wait_readable(-1, 0) < 0, 19)
demand(fd_fill(-1, 0) == -2, 19)
demand(fd_take_byte() == -1, 19)

exit(42)
