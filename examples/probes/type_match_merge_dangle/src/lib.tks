/** A minimal declared variant whose two arms return by-name cases. */
type A = struct { x: i64 }

/** The second case of the variant. */
type B = struct { y: i64 }

/** Thing — the declared variant whose value-`match` drives `checker::type_match`. */
type Thing = variant A | B

/**
 * pick — a value-`match` over a scalar subject returning a variant: constructs the `[]TArm` the
 * checker's `type_match` folds.
 *
 * @param n  the selector
 * @return   the `A` case for 0, else the `B` case
 */
fn pick(n: i64): Thing {
    match n {
        0 => A { x = 1 }
        _ => B { y = 2 }
    }
}

/**
 * read — a value-`match` over a VARIANT subject whose arm leaves are field accesses (non-literal),
 * so `checker::type_match`'s `match match_join_anchor(typed) { Type as anchor =>
 * adopt_match_arm_literals(typed, anchor); null => typed }` takes the `adopt_match_arm_literals`
 * arm. When a NATIVE-built compiler checks this, that returned `[]TArm` reaches the arm-type fold
 * with a NULL `.ptr` and SIGSEGVs at `type_match+0xe85`.
 *
 * @param t  the variant to read
 * @return   the payload field of whichever case is present
 */
fn read(t: Thing): i64 {
    match t {
        A as a => a.x
        B as b => b.y
    }
}
