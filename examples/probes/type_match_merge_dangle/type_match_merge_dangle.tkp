# The `checker::type_match` by-address aggregate-through-merge/return probe (native fixpoint
# blocker C3 — the P1 pin). This is a compiler INPUT: when a NATIVE-built compiler (gen2) checks
# it, gen2 SIGSEGVs in its own `checker::type_match` at offset +0xe85 on `mov (%rax),%rcx` with
# rax=NULL. The NULL is `arms.ptr`, where `arms` is the `[]TArm` returned by
# `adopt_match_arm_literals` through the `match match_join_anchor(typed) { Type as anchor => ...;
# null => typed }` merge (typer.tks:3982): the fat slice is conveyed through the match MERGE and
# its `.ptr` half arrives NULL, so the arm-type fold loop dereferences base+0 = 0.
#
# FACET: RETURN / TAIL-MERGE (a `[]TArm` returned from a callee through a tail-merge, header
# reclaimed before the reader). DPS closes it by construction.
#
# The C route checks and runs this correctly (exit 0-family); only a native-built compiler faults
# on it. It is a DIAGNOSTIC input, not a regression fixture — it compiles clean via the released
# seed, so no gate reds on it.
name = "type_match_merge_dangle"
source = "src"

[artifact]
kind = "binary"
