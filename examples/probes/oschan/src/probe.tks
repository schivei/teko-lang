/**
 * oschan_selftest — the C-owned §10 C0c probe body, reached through ONE scalar extern (the
 * thread_spawn_selftest idiom). Spawns `w` writer threads each sending `r` datagram records into one
 * AF_UNIX SOCK_DGRAM reader, and verifies every record by CONTENT (writer id, sequence, and a pattern
 * derived from both) plus per-writer order.
 *
 * @param w  the number of concurrent writer threads
 * @param r  the number of records each writer sends
 * @return   0 when every record verified, a non-zero failure code otherwise
 * @since 0.3.1 §10 C0c
 */
extern fn oschan_selftest(w: i64, r: i64): u64 = "tk_oschan_selftest" from "teko_rt"

/**
 * probe_oschan — drive a 4-writer x 500-record fan-in across the AF_UNIX datagram transport and check
 * the C body verified every record by content. Returns 42 on a clean fan-in, 1 on any mismatch.
 *
 * @return  42 when the fan-in verified, 1 when the C body reported a mismatch
 * @since 0.3.1 §10 C0c
 */
pub fn probe_oschan(): i32 {
    var rc = oschan_selftest(4, 500)
    if rc != 0 { return 1 }
    42
}
