# §10 C0c — the `tk_oschan` runtime probe (AF_UNIX SOCK_DGRAM fan-in transport).
#
# Proves the OS-backed channel transport: `tk_oschan_make`/`send`/`recv`/`close`/`end`
# (src/runtime/teko_rt.c), lifted from the chan_dgram probe's syscalls — one reader socket bound to a
# key-derived abstract name, N writer threads each sendto that name, datagram-atomic records verified
# BY CONTENT (writer id, seq, and a pattern derived from both), never by count. Reached through ONE
# scalar extern into a C-owned selftest body.
#
# tk_oschan_selftest(4, 500) fans 4 writers x 500 records into one reader and verifies all three
# fields per record. Success -> exit 42; any content mismatch -> exit 1.
#
#   TEKO_MEM_PARANOID=1 ./examples/probes/oschan/bin/oschan   # -> 42
name = "oschan"
source = "src"

[artifact]
kind = "binary"
