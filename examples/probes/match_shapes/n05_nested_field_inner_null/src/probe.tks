type Inner_n = struct { v: i64 | null }
type Outer_n = struct { inner: Inner_n | null }
pub fn probe(): u64 {
    var inner_null = Outer_n { inner = Inner_n { v = null } }
    var r = match inner_null.inner {
        Inner_n as inn => match inn.v { i64 as v => v; null => 42 }
        null => 0
    }
    r to u64
}
