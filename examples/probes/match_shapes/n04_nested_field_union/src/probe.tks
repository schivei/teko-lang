type Inner_n = struct { v: i64 | null }
type Outer_n = struct { inner: Inner_n | null }
fn read_outer(o: Outer_n, fallback: i64): i64 {
    match o.inner {
        Inner_n as inn => match inn.v { i64 as v => v; null => fallback }
        null => fallback
    }
}
pub fn probe(): u64 {
    var outer_null = Outer_n { inner = null }
    read_outer(outer_null, 42) to u64
}
