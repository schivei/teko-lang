# The native by-address element-box probe (native fixpoint blocker C2 — the P1 pin, standing in
# for `lir::frame_sweep_inst`). This is a compiler INPUT: when a NATIVE-built compiler (gen2)
# native-builds it, gen2 does NOT fault in `frame_sweep_inst` (its FrameSet returns are all boxed,
# its `[]bool` is root-allocated — the return facet is handled); the by-address disease instead
# faults DEEPER, in gen2's own `backend::select_fused_branch_x86` -> `tk_slice_elem_box` ->
# `tk_region_alloc` (`mov 0x10(%rax),%rdx`, rax a stomped region pointer 0x5550...): the aggregate
# slice-ELEMENT box (NATIVE-AGG-SLICE-BY-ADDRESS, degrau 4) runs against corrupt region metadata
# left by an earlier wild write.
#
# FACET: PAYLOAD-BIND / slice-element-write / wild-write (NOT return/tail-merge). DPS does NOT
# close it; it needs a point-fix in the region-bracket / self-append (element-box lifetime) family.
#
# The C route builds and runs this correctly; only a native-built compiler faults. DIAGNOSTIC
# input, not a regression fixture.
name = "native_isel_elem_box"
source = "src"

[artifact]
kind = "binary"
