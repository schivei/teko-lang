/** Pt — a small aggregate returned by value across `if`-branches (the frame-slot value the native
 * backend conveys by address). */
type Pt = struct { x: i64; y: i64 }

/**
 * mk — return a `Pt` from either `if`-branch: two `alloca`d frame slots merged in tail position.
 *
 * @param n  the selector
 * @return   a `Pt` built from `n`
 */
fn mk(n: i64): Pt {
    if n > 0 {
        return Pt { x = n; y = n * 2 }
    }
    Pt { x = 0 - n; y = n }
}

/**
 * pick — chain of aggregate-returning `if`-branches so the lowered function has several blocks
 * with block-arguments carrying frame addresses (what `lir::frame_sweep_inst`'s guard walks).
 *
 * @param n  the selector
 * @return   a `Pt` chosen among the branches
 */
fn pick(n: i64): Pt {
    if n > 3 {
        return mk(n)
    }
    if n > 1 {
        return mk(0 - n)
    }
    mk(n * 2)
}

/**
 * drive — sum fields of the picked aggregates in a loop, the read-back after the by-address
 * conveyance.
 *
 * @param n  how many iterations
 * @return   the accumulated sum
 */
fn drive(n: i64): i64 {
    var s: i64 = 0
    var i: i64 = 0
    loop {
        if i >= n { break }
        s = s + pick(i).x + pick(i).y
        i++
    }
    return s
}
