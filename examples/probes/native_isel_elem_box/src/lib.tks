type Pt = struct { x: i64; y: i64 }

fn mk(n: i64): Pt {
    if n > 0 {
        return Pt { x = n; y = n * 2 }
    }
    Pt { x = 0 - n; y = n }
}

fn pick(n: i64): Pt {
    if n > 3 {
        return mk(n)
    }
    if n > 1 {
        return mk(0 - n)
    }
    mk(n * 2)
}

fn drive(n: i64): i64 {
    var s: i64 = 0
    var i: i64 = 0
    loop {
        if i >= n { break }
        s = s + pick(i).x + pick(i).y
        i++
    }
    return s
}
