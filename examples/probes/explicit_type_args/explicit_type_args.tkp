# examples/probes/explicit_type_args — explicit call-site type-args for generics (fn + method).
#
# Generics can now be instantiated EXPLICITLY at the call site, not only inferred from the
# arguments — for both a free FUNCTION (`id<i64>(3)`, `first<i64, str>(…)`) and an instance
# METHOD (`b.wrap<i64>(9)`). The explicit `<…>` WINS over inference and, crucially, unlocks a
# type-parameter that appears ONLY in the return type (`empty_list<i64>()`), which is uninferable
# from arguments and is a hard error without the annotation. The `<` still disambiguates against a
# comparison: a `<…>` list only commits when it closes and a `(` follows, otherwise it backtracks.
#
#   TEKO_BACKEND=c teko build examples/probes/explicit_type_args -o <out>   # -> exit 0
name = "explicit_type_args"
source = "src"

[artifact]
kind = "binary"
