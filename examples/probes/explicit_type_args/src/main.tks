// --- explicit type-args on a FUNCTION ---
if id<i64>(3) != 3 { exit(10) }
if id(4) != 4 { exit(11) }                 // bare inference still works
if first<i64, str>(7, "x") != 7 { exit(12) }

// --- a type-param that lives only in the return type (needs the explicit arg) ---
if empty_list<i64>().len != 0 { exit(13) }

// --- explicit type-args on a METHOD ---
var b = Box { v = 1 }
if b.wrap<i64>(9) != 9 { exit(14) }

// --- `<` still parses as a comparison when it is not a closed type-arg list before `(` ---
if !(3 < 8) { exit(15) }

// --- STATIC calls: the four owner/callee call-site shapes ---
// (static generic calls bind through `::`, which is not allowed in an if-scrutinee, so bind first)
var a0 = Plain::f0()                        // Tipo::func()          — neither position
var a1 = Plain::f1<i64>()                   // Tipo::func<T>()       — callee explicit (no arg to infer)
var a2 = Plain::f2(3)                       // Tipo::func(x)         — callee INFERRED from the arg
var a3 = Plain::f2<i64>(4)                  // Tipo::func<T>(x)      — callee explicit (explicit wins)
var xs = Lst<i64>::make()                   // Tipo<T>::func()       — owner explicit, retargeted factory
if a0 != 100 { exit(16) }
if a1.len != 0 { exit(17) }
if a2 != 3 { exit(18) }
if a3 != 4 { exit(19) }
if xs.size() != 0 { exit(20) }

// --- form 4: a GENERIC method on a GENERIC type (`Tipo<T>::func<T2>()` and inferred `Tipo<T>::func(x)`) ---
var g4a = Gen<i64>::g2<i64>(7)              // Tipo<T>::func<T2>()   — owner + callee both explicit
var g4b = Gen<i64>::g2(8)                   // Tipo<T>::func(x)      — callee INFERRED from the arg
var g4c = Gen<str>::g2<i64>(9)              // T != T2               — owner str, method i64
var gi = Gen<i64>::mk(5)                    // build a concrete instance to dot-call
if g4a != 7 { exit(21) }
if g4b != 8 { exit(22) }
if g4c != 9 { exit(23) }
if gi.pick<str>("hi") != 5 { exit(24) }     // instance generic method, explicit — reads owner T
if gi.pick(1 to u8) != 5 { exit(25) }       // instance generic method, INFERRED — reads owner T

exit(0)
