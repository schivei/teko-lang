// A free generic function — callable inferred (`id(3)`) or explicit (`id<i64>(3)`).
pub fn id<T>(x: T): T { x }

// Two type-parameters — explicit args bind them in declaration/appearance order.
pub fn first<A, B>(a: A, b: B): A { a }

// The type-parameter appears ONLY in the return type: uninferable from the (absent) arguments,
// so this function is callable ONLY with an explicit `<…>` (a bare `empty_list()` is an error).
pub fn empty_list<T>(): [] T { teko::list::empty() }

pub type Box = struct {
    v: i64
    // A generic INSTANCE method — the method's own type-parameter, bound explicitly at `.wrap<…>()`.
    fn wrap<U>(x: U): U { x }
}

// A NON-generic type with STATIC methods spanning the call-site matrix (all four call shapes below):
//   Plain::f0()        — non-generic method
//   Plain::f1<T>()     — generic method, no arg to infer → T only via explicit `<…>`
//   Plain::f2(x)       — generic method, T INFERRED from the argument
//   Plain::f2<T>(x)    — generic method, T EXPLICIT (explicit wins)
pub type Plain = struct {
    n: i64
    pub static fn f0(): i64 { 100 }
    pub static fn f1<T>(): [] T { teko::list::empty() }
    pub static fn f2<T>(t: T): T { t }
}

// A GENERIC type with a NON-generic static factory — `Lst<i64>::make()`: the `<i64>` binds the TYPE's
// param and retargets the factory to the mangled instance (`Lst__g__i64::make`).
pub type Lst<T> = struct {
    items: [] T
    pub static fn make(): Lst<T> { Lst { items = teko::list::empty() } }
    pub fn size(): i64 { self.items.len to i64 }
}

// A GENERIC type with GENERIC methods — the 4th call shape (`Tipo<T>::func<T2>()` and the inferred
// `Tipo<T>::func(x)`). The method carries its OWN type-param (`T2`/`U`) INSIDE a type that already binds
// `T`: the monomorph composes the two substitutions and stamps the method PER METHOD-INSTANTIATION into
// the concrete instance namespace (`Gen__g__i64::g2__g__i64`), both `T` and `T2` resolved. `pick<U>`
// additionally reads the owner `T` (returns `self.seed`) so the composed owner-binding is exercised too.
pub type Gen<T> = struct {
    seed: T
    pub static fn g2<T2>(x: T2): T2 { x }                 // generic static method on a generic type
    pub static fn mk(s: T): Gen<T> { Gen { seed = s } }   // non-generic factory (retargeted owner)
    pub fn pick<U>(u: U): T { self.seed }                 // generic instance method: owner T + method U
}
