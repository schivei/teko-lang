// A free generic function — callable inferred (`id(3)`) or explicit (`id<i64>(3)`).
pub fn id<T>(x: T): T { x }

// Two type-parameters — explicit args bind them in declaration/appearance order.
pub fn first<A, B>(a: A, b: B): A { a }

// The type-parameter appears ONLY in the return type: uninferable from the (absent) arguments,
// so this function is callable ONLY with an explicit `<…>` (a bare `empty_list()` is an error).
pub fn empty_list<T>(): [] T { teko::list::empty() }

pub type Box = struct {
    v: i64
    // A generic INSTANCE method — the method's own type-parameter, bound explicitly at `.wrap<…>()`.
    fn wrap<U>(x: U): U { x }
}
