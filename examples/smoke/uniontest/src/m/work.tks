pub type Box = struct { v: i64 }

fn ok(): Box | error { Box { v = 7 } }

fn fail(): Box | error { error { message = "boom" } }

pub fn classify_ok(): i64 {
    match ok() {
        Box as b => b.v
        error => 0
    }
}

pub fn classify_err(): i64 {
    match fail() {
        Box as b => b.v
        error => 99
    }
}
