/**
 * Arena — the same `#must_free` single-`uptr` handle shape as `mem_free_arena_ok`, here proving the
 * NEGATIVE: dropping it without `teko::mem::free` is a COMPILE error, and the new native `free`
 * lowering does not weaken that checker gate (the consume-or-fail dataflow is unchanged).
 */
#must_free
pub unsafe type Arena = struct {
    /** the raw `tk_region *` this handle owns, carried as an opaque `uptr`. */
    region: uptr
}

/**
 * run — open an `Arena` and NEVER free it: the `#must_free` consume-or-fail dataflow rejects this at
 * compile time.
 *
 * @return void
 */
pub unsafe fn run() {
    mut a = Arena { region = teko::mem::region_new() }
    teko::io::println("opened but leaked")
}
