pub extern fn memchan_make(elem_size: u64, bounds: u64): u64 = "tk_memchan_make_u" from "teko_rt"

pub extern fn memchan_send(ch: u64, elem: uptr) = "tk_memchan_send_u" from "teko_rt"

pub extern fn memchan_recv(ch: u64, out: uptr): i64 = "tk_memchan_recv_u" from "teko_rt"

pub extern fn memchan_close(ch: u64) = "tk_memchan_close_u" from "teko_rt"

pub extern fn memchan_end(ch: u64) = "tk_memchan_end_u" from "teko_rt"

pub fn producer(ch: u64, n: i64) {
    var i: i64 = 0
    loop {
        if i >= n { break }
        var v = i
        memchan_send(ch, uptr::__unwrap<i64>(v))
        i = i + 1
    }
    memchan_close(ch)
}

pub fn consume_sum(ch: u64): i64 {
    var sum: i64 = 0
    var running = true
    loop {
        if !running { break }
        var out: i64 = 0
        var r = memchan_recv(ch, uptr::__unwrap<i64>(out))
        if r == 0 { running = false } else { sum = sum + out }
    }
    sum
}
