#if(os == "linux" && arch == "x86_64")
/**
 * pick — the linux/x86_64 conjunction arm, surviving only when both axes match, returning 99.
 *
 * @return  99, the linux-and-x86_64 identifying value
 */
pub fn pick(): i64 { return 99 }
#else
/**
 * pick — the fallback arm for every other os/arch pair, returning 1.
 *
 * @return  1, the fallback value
 */
pub fn pick(): i64 { return 1 }
#endif
