Feature: marshall reject — §5 Part A opaque atomic ptr/uptr forbids parameterization, arithmetic, deref, and off-type wrap/unwrap

  Scenario: marshall_ptr_generic_rejected
    When compilation fails
    Then diagnostic = "`ptr` is an opaque atomic pointer — it takes no type argument"

  Scenario: marshall_uptr_generic_rejected
    When compilation fails
    Then diagnostic = "`uptr` is an opaque atomic pointer — it takes no type argument"

  Scenario: marshall_ptr_add_rejected
    When compilation fails
    Then diagnostic = "an opaque `ptr`/`uptr` cannot be an operand"

  Scenario: marshall_ptr_index_rejected
    When compilation fails
    Then diagnostic = "an opaque `ptr`/`uptr` cannot be an operand"

  Scenario: marshall_ptr_deref_star_rejected
    When compilation fails
    Then diagnostic = "an opaque `ptr`/`uptr` cannot be an operand"

  Scenario: marshall_wrap_on_non_ptr_rejected
    When compilation fails
    Then diagnostic = "method typing is deferred (B.29 / M.4)"

  Scenario: marshall_unwrap_non_addressable_rejected
    When compilation fails
    Then diagnostic = "requires an addressable `var` variable"
