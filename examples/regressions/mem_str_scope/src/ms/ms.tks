/**
 * score_marks — build, per loop iteration, a BLOCK-LOCAL str by concatenation and probe it with str
 * EQUALITY tests only (a comparison is a non-escaping use, so the residence oracle proves the str
 * block-local — unlike passing it to a function, which would mark it escaping). Under the scope
 * memory model (crumb C3, §9) such a str routes through `tk_str_concat_r(<loop region>, …)` and its
 * buffer dies at the iteration's exit edge, reclaimed and reused by the next iteration.
 *
 * Each iteration contributes a distinct decade weight iff its mark reads back its EXACT value, so
 * the returned sum is a positional fingerprint of every mark: a broken `_r` routing (a buffer freed
 * before its comparison) would miss a match and drop a digit, not merely leak.
 *
 * @param n  the number of iterations (marks `mark-0` … `mark-<n-1>`)
 * @return   the fingerprint sum (1 + 20 + 300 for n = 3, i.e. 321)
 */
fn score_marks(n: i64) -> i64 {
    mut score: i64 = 0
    mut i: i64 = 0
    loop {
        if i >= n { break }
        let mark = "mark-" ~ teko::i64_to_str(i)
        if mark == "mark-0" { score = score + 1 }
        if mark == "mark-1" { score = score + 20 }
        if mark == "mark-2" { score = score + 300 }
        i++
    }
    score
}

/**
 * run — the fingerprint of three per-iteration block-local marks, rendered as a str the regressor
 * asserts. `321` proves every scope-routed mark held its exact value across the region churn.
 *
 * @return  the decimal fingerprint of the three marks
 */
exp fn run() -> str {
    teko::i64_to_str(score_marks(3))
}
