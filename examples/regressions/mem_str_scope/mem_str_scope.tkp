# examples/regressions/mem_str_scope — the regressor of BLOCK-LOCAL str residence (0.3.1
# modelo-de-memoria-por-escopo §9, crumb C3). A `str` binding whose value is a `~` concat (or an
# interpolation), proven block-local by the residence oracle, is bump-allocated in its owning scope
# region via `tk_str_concat_r` and dies at that scope's exit edge. This regressor churns such a str
# per loop iteration and reads it back each time, so a use-after-drop of the scope-routed buffer
# corrupts the output instead of merely leaking.
name = "mem_str_scope"
source = "src"

[artifact]
kind = "binary"
