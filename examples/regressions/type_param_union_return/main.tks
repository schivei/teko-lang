var present = opt::first_or_null([opt::Num { n = 7 }, opt::Num { n = 3 }])
var got = match present { opt::Num as x => x.n; null => 0 - 1 }
var empty: []opt::Num = teko::list::empty()
var absent = opt::first_or_null(empty)
var got2 = match absent { opt::Num as x => x.n; null => 0 }
if got == 7 && got2 == 0 { exit(7) }
exit(1)
