/**
 * IOrd — the local total-ordering capability (a self-contained copy of teko::cmp::IOrd, since the
 * stdlib's cmp module is compiler-internal and not visible to a fixture project). A conformer writes
 * `operator __lt` and composes the reflection mixins for the other three comparators.
 *
 * @since type_param_union_return (F1 fixture)
 */
type IOrd = interface {
    /**
     * __lt — is `left` strictly less than `right`? The primitive comparator the mixins derive from.
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` orders before `right`
     */
    operator __lt(left: self, right: self): bool
    /**
     * __gt — is `left` strictly greater than `right`?
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` orders after `right`
     */
    operator __gt(left: self, right: self): bool
    /**
     * __le — is `left` less than or equal to `right`?
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` does not order after `right`
     */
    operator __le(left: self, right: self): bool
    /**
     * __ge — is `left` greater than or equal to `right`?
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` does not order before `right`
     */
    operator __ge(left: self, right: self): bool
}

/**
 * GtByLt — the reflection mixin deriving `__gt` from `__lt`, `right < left`.
 *
 * @since type_param_union_return (F1 fixture)
 */
type GtByLt = trait {
    /**
     * __gt — greater-than by reflecting less-than, `right < left`.
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` orders after `right`
     */
    operator __gt(left: self, right: self): bool { right < left }
}

/**
 * LeByLt — the reflection mixin deriving `__le` from `__lt`, `!(right < left)`.
 *
 * @since type_param_union_return (F1 fixture)
 */
type LeByLt = trait {
    /**
     * __le — less-than-or-equal by negating the swapped less-than, `!(right < left)`.
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` does not order after `right`
     */
    operator __le(left: self, right: self): bool { !(right < left) }
}

/**
 * GeByLt — the reflection mixin deriving `__ge` from `__lt`, `!(left < right)`.
 *
 * @since type_param_union_return (F1 fixture)
 */
type GeByLt = trait {
    /**
     * __ge — greater-than-or-equal by negating less-than, `!(left < right)`.
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left` does not order before `right`
     */
    operator __ge(left: self, right: self): bool { !(left < right) }
}

/**
 * Num — an `i64` wrapped as a totally-ordered value conforming `IOrd`, the concrete `T` this fixture
 * instantiates the constrained `first_or_null<T: IOrd>` at. `__lt` is native integer order; the other
 * three comparators come from the reflection mixins.
 *
 * @since type_param_union_return (F1 fixture)
 */
pub type Num = struct IOrd & GtByLt & LeByLt & GeByLt {
    /** The wrapped integer — the sole ordered datum. */
    n: i64
    /**
     * __lt — native less-than of the two wrapped integers.
     *
     * @param left   the left operand
     * @param right  the right operand
     * @return       true iff `left`'s integer is less than `right`'s
     */
    operator __lt(left: self, right: self): bool { left.n < right.n }
}

/**
 * first_or_null — the constrained-`T` union-return idiom the F1 fix unblocks: a `<T: IOrd>` whose
 * return type is `T | null`, returning `null` on an empty input and the first element otherwise. Before
 * F1 the checker rejected the return type with "an interface cannot be a variant member yet", because a
 * constrained type-param registers with a synthetic `InterfaceBody`; now it concretizes at mono to
 * `Num | null`.
 *
 * @param xs  the input array
 * @return    the first element of `xs`, or `null` when `xs` is empty
 */
pub fn first_or_null<T: IOrd>(xs: []T): T | null {
    if xs.len == 0 { return null }
    xs[0]
}
