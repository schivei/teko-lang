type IOrd = interface {
    operator __lt(left: self, right: self): bool
    operator __gt(left: self, right: self): bool
    operator __le(left: self, right: self): bool
    operator __ge(left: self, right: self): bool
}

type GtByLt = trait {
    operator __gt(left: self, right: self): bool { right < left }
}

type LeByLt = trait {
    operator __le(left: self, right: self): bool { !(right < left) }
}

type GeByLt = trait {
    operator __ge(left: self, right: self): bool { !(left < right) }
}

pub type Num = struct IOrd & GtByLt & LeByLt & GeByLt {
    n: i64
    operator __lt(left: self, right: self): bool { left.n < right.n }
}

pub fn first_or_null<T: IOrd>(xs: []T): T | null {
    if xs.len == 0 { return null }
    xs[0]
}
