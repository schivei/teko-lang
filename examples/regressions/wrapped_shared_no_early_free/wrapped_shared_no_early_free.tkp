# examples/regressions/wrapped_shared_no_early_free — the COL-F0c wrapped-refcount fixture
# (crumb 0023). Proves a wrapped object referenced by two holders (modelled as two `retain`
# calls — a collection insert plus an external binding) survives a single `release` (modelled as
# a collection `remove`): the count only drops from 2 to 1, so the object is neither freed nor
# corrupted, and the surviving (external) reference stays live and writable. The compiler holds no
# `wrapped` objects, so this path is not fixpoint-exercised. Pinned to the C backend.
name = "wrapped_shared_no_early_free"
source = "src"

[artifact]
kind = "binary"
