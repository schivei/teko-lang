// KNOWN-STOP PIN (np_oop, held-back SPELLING of chained-successor cells 6 and 8): a `match` whose
// arms are a BARE `null` and a non-null value, assigned into a `T | null` slot. Codegen stops with
// "nested bare-null optional (internal)", so this file must FAIL TO COMPILE. The day it lands, the
// pin goes red and src/np_oop/entry.tks goes back to the direct spelling instead of the writeback.
pub type Counter = class {
    /** n — the counter's current value. */
    pub n: i64
    /**
     * make — construct a Counter holding `v`.
     *
     * @param v the initial value
     * @return  a fresh Counter
     */
    pub fn make(v: i64) -> Counter { Counter { n = v } }
    /**
     * next — a fresh Counter one greater.
     *
     * @return a Counter holding n + 1
     */
    pub fn next(self) -> Counter { Counter::make(self.n + 1) }
}

let c: Counter | null = Counter::make(7)
let step: Counter | null = match c { null => null; Counter as cc => cc.next() }
exit(match step { null => 0; Counter as cc => cc.n } to i32)
