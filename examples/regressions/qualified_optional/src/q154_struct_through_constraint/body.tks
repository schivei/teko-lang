type Measurable = interface {
    /**
     * Report this value's measure.
     *
     * @return the value's measure as a signed 64-bit integer
     */
    fn measure(self) -> i64
}
type Point3 = struct Measurable {
    /** The stored width. */
    w: i64

    /**
     * Report the stored width unchanged.
     *
     * @return the stored width
     */
    pub fn measure(self) -> i64 { self.w }
}
type Doubled = struct Measurable {
    /** The stored width. */
    w: i64

    /**
     * Report twice the stored width.
     *
     * @return the stored width doubled
     */
    pub fn measure(self) -> i64 { self.w + self.w }
}
fn total2<T: Measurable>(x: T) -> i64 { return x.measure() }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: struct_through_constraint
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q154_struct_through_constraint`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Point -> Point3, total -> total2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let p = Point3 { w = 5 }
    let d = Doubled { w = 9 }
    if total2(p) != 5 { exit(1) }
    if total2(d) != 18 { exit(2) }
    exit(total2(p))
}
