 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q034_class_destruct_effects`.
 */
pub fn entry() {
    if Tracker::use_and_drop(21) != 42 { exit(1) }
}
