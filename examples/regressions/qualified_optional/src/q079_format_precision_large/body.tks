pub fn static_precision_len() -> i64 {
    let s = $"{1.0:F500}"
    s.len to i64
}
pub fn dynamic_precision_len() -> i64 {
    let spec = "F500"
    let s = $"{1.0:[spec]}"
    s.len to i64
}
pub fn check() -> i64 {
    let expected: i64 = 502
    let a = static_precision_len()
    let b = dynamic_precision_len()
    if a == expected && b == expected { 42 } else { 0 }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: format_precision_large
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q079_format_precision_large`.
 */
pub fn entry() {
    exit(check() to i32)
}
