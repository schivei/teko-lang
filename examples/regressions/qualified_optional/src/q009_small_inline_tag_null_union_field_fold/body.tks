type A = struct {
    /** the case's payload, returned by `read` on the `A` arm. */
    x: i64
}
type B = struct {
    /** the case's payload, returned by `read` on the `B` arm. */
    y: i64
}
type Op = variant A | B
type Slot = struct {
    /** the `Op | null` field — a present `Op` case or `null`. */
    f: Op | null
    /** a neighbouring scalar, so the union field carries a real offset. */
    tag: i64
}
pub fn with_a(v: i64) -> Slot { return Slot { f = A { x = v }; tag = 1 } }
pub fn with_b(v: i64) -> Slot { return Slot { f = B { y = v }; tag = 2 } }
pub fn empty_slot() -> Slot { return Slot { f = null; tag = 0 } }
pub fn read(s: Slot) -> i64 {
    match s.f {
        Op as v => match v { A as a => return a.x; B as b => return b.y }
        null => return 0
    }
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: small inline-tag null-union field (folds nullfield_variant_plain)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q009_small_inline_tag_null_union_field_fold`.
 */
pub fn entry() {
    exit((read(with_a(30)) + read(with_b(12)) + read(empty_slot())) to i32)
}
