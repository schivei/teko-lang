pub type Address = struct {
    city: str
}
pub type Timestamped = trait {
    created_at: i64
    updated_at: i64
}
pub type Tagged = trait {
    tag: str
}
pub type Profile = struct Timestamped & Tagged {
    home: Address
    name: str
}
pub type Entity = virtual class {
    pub entity_id: i64
}
pub type Account = class Entity & Timestamped {
    pub owner: str
    pub fn make_account(id: i64, owner: str, c: i64, u: i64) -> Account {
        Account { entity_id = id; owner = owner; created_at = c; updated_at = u }
    }
    pub fn created(self) -> i64 { self.created_at }
    pub fn updated(self) -> i64 { self.updated_at }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_field_derive
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q165_trait_field_derive`.
 */
pub fn entry() {
    let addr = Address { city = "Springfield" }
    let p = Profile { home = addr; name = "ana"; created_at = 1; updated_at = 9; tag = "vip" }
    if p.name != "ana" { exit(1) }
    if p.home.city != "Springfield" { exit(2) }
    if p.created_at != 1 { exit(3) }
    if p.updated_at != 9 { exit(4) }
    if p.tag != "vip" { exit(5) }
    let acc = Account::make_account(7, "bob", 100, 200)
    if acc.entity_id != 7 { exit(6) }
    if acc.owner != "bob" { exit(7) }
    if acc.created() != 100 { exit(8) }
    if acc.updated() != 200 { exit(9) }
    exit(0)
}
