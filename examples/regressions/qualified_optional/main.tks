// (#149) same-bare-name types across namespaces, in optional + variant positions.
// 5 (aa::find) + 6 (bb::spot k=3*2) + 4 (bb::make plain coexistence) + 4 (pick ok) + 3 (pick err) = 22.
//
// THE DISPATCHER (owner ruling 2026-07-25 — "um tkp pode ter vários tkr … somente um build é
// necessário"): this project hosts more than its own scenario. `TEKO_REGR_ENTRY` selects a MEMBER
// namespace's `entry()`; unset (the default) falls through to the #149 body below. Every member
// runs off THIS project's single build — the same selector the synthesized group builds use
// (`REGR_GROUP_ENTRY_VAR`, src/build/regr_group.tks), so an on-disk member and a folded snippet
// are selected identically. A member's `entry()` always diverges (`exit(…)`), so the fall-through
// below is reached only when no member was selected.
use aa
use bb
use np_oop
use native_gate

let regr_entry = match teko::env::var("TEKO_REGR_ENTRY") { str as v => v; error => "" }
if regr_entry == "np_oop" { np_oop::entry() }
if regr_entry == "native_gate_coercions" { native_gate::entry() }

mut total: i64 = 0
match aa::find(5) { aa::Thing as t => total = total + t.v; null => total = total + 100 }
match bb::spot(3) { bb::Widget as g => total = total + g.k; null => total = total + 100 }
let b = bb::make(4)
total = total + b.w
match aa::pick(4) { aa::Thing as t => total = total + t.v; error => total = total + 100 }
match aa::pick(0) { aa::Thing => total = total + 100; error => total = total + 3 }
(total) to i32
