if regr_entry == "q165_trait_field_derive" { regr_hit = true; q165_trait_field_derive::entry() }
if regr_entry == "q169_unsafe_path_segment" { regr_hit = true; q169_unsafe_path_segment::entry() }
if regr_entry == "q174_wasm_break_in_if" { regr_hit = true; q174_wasm_break_in_if::entry() }
if regr_entry == "q179_wasm_loop_count" { regr_hit = true; q179_wasm_loop_count::entry() }
if regr_entry == "q184_an_explicit_env_token_reaches_the_comp" { regr_hit = true; q184_an_explicit_env_token_reaches_the_comp::entry() }
if regr_entry == "q188_scenario_runs_with_cwd_in_its_own_scra" { regr_hit = true; q188_scenario_runs_with_cwd_in_its_own_scra::entry() }
if regr_hit { exit(0) }

// (#149) same-bare-name types across namespaces, in optional + variant positions.
// 5 (aa::find) + 6 (bb::spot k=3*2) + 4 (bb::make plain coexistence) + 4 (pick ok) + 3 (pick err) = 22.

mut total: i64 = 0
match aa::find(5) { aa::Thing as t => total = total + t.v; null => total = total + 100 }
match bb::spot(3) { bb::Widget as g => total = total + g.k; null => total = total + 100 }
let b = bb::make(4)
total = total + b.w
match aa::pick(4) { aa::Thing as t => total = total + t.v; error => total = total + 100 }
match aa::pick(0) { aa::Thing => total = total + 100; error => total = total + 3 }
(total) to i32
