use q174_wasm_break_in_if
use q179_wasm_loop_count
use q184_an_explicit_env_token_reaches_the_comp
use q188_scenario_runs_with_cwd_in_its_own_scra

let regr_entry = match teko::env::var("TEKO_REGR_ENTRY") { str as v => v; error => "" }
mut regr_hit = false
if regr_entry == "np_oop" { regr_hit = true; np_oop::entry() }
if regr_entry == "native_gate_coercions" { regr_hit = true; native_gate::entry() }
if regr_entry == "q004_nested_null_union_field_of_a_field" { regr_hit = true; q004_nested_null_union_field_of_a_field::entry() }
if regr_entry == "q009_small_inline_tag_null_union_field_fold" { regr_hit = true; q009_small_inline_tag_null_union_field_fold::entry() }
if regr_entry == "q013_recursion_through_a_variant_payload_s" { regr_hit = true; q013_recursion_through_a_variant_payload_s::entry() }
if regr_entry == "q019_width_literal_adopt" { regr_hit = true; q019_width_literal_adopt::entry() }
if regr_entry == "q024_array_literal_narrow_binding" { regr_hit = true; q024_array_literal_narrow_binding::entry() }
if regr_entry == "q028_cf4_field_len_fold" { regr_hit = true; q028_cf4_field_len_fold::entry() }
if regr_entry == "q034_class_destruct_effects" { regr_hit = true; q034_class_destruct_effects::entry() }
if regr_entry == "q037_class_identity" { regr_hit = true; q037_class_identity::entry() }
if regr_entry == "q044_closure_shadows_fn" { regr_hit = true; q044_closure_shadows_fn::entry() }
