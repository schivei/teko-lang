if regr_entry == "q058_cov_control_flow" { regr_hit = true; q058_cov_control_flow::entry() }
if regr_entry == "q064_defer_cross_block_return" { regr_hit = true; q064_defer_cross_block_return::entry() }
if regr_entry == "q068_di_singleton" { regr_hit = true; q068_di_singleton::entry() }
if regr_entry == "q075_exit_success_path" { regr_hit = true; q075_exit_success_path::entry() }
if regr_entry == "q079_format_precision_large" { regr_hit = true; q079_format_precision_large::entry() }
if regr_entry == "q089_iface_value_hetero_slice" { regr_hit = true; q089_iface_value_hetero_slice::entry() }
if regr_entry == "q093_inline_attr_parse" { regr_hit = true; q093_inline_attr_parse::entry() }
