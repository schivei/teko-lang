/**
 * FieldInfo — one field DESCRIPTOR of a type's comptime field view (§14 B5 fixture): the field's
 * declared name and whether its type is a `X | null` union. Compile-time-only descriptor — it carries no
 * runtime field value.
 *
 * @field name        the field's declared name
 * @field is_nullable true iff the field's type is a `X | null` union (§9.D)
 */
type FieldInfo = struct { name: str; is_nullable: bool }

/**
 * Point — a two-field struct the field reflection enumerates (§14 B5 fixture).
 *
 * @field x  the first coordinate
 * @field y  the second coordinate
 */
type Point = struct { x: i64; y: i64 }

/**
 * Nub — a struct with a nullable field, so the reflection reports `is_nullable` per field (§14 B5).
 *
 * @field a  a non-nullable field
 * @field b  a `i64 | null` nullable field (§9.D)
 */
type Nub = struct { a: i64; b: i64 | null }

/**
 * fields — a Family-B comptime returning the field view of `T` (§14 B5): `@fields<T>()` folds to a
 * `[]FieldInfo` descriptor slice, one per field of `T` in declaration order (name + nullability).
 *
 * @return  the field descriptors of `T`, inlined as a `[]FieldInfo` literal
 * @since comptime_fields (§14 B5 fixture)
 */
comptime fields<T>(): []FieldInfo { T.fields }

/**
 * count — the number of fields of `Point` via `@fields<Point>().len` (§14 B5).
 *
 * @return  2
 */
pub fn count(): i64 { @fields<Point>().len to i64 }

/**
 * name0 — the first field descriptor's name of `Point` (§14 B5).
 *
 * @return  "x"
 */
pub fn name0(): str { @fields<Point>()[0].name }

/**
 * name1 — the second field descriptor's name of `Point` (§14 B5).
 *
 * @return  "y"
 */
pub fn name1(): str { @fields<Point>()[1].name }

/**
 * nub_a_nullable — 1 iff `Nub`'s first field (`a: i64`) is reported nullable — it is not, so 0 (§14 B5).
 *
 * @return  0
 */
pub fn nub_a_nullable(): i64 { if @fields<Nub>()[0].is_nullable { 1 } else { 0 } }

/**
 * nub_b_nullable — 1 iff `Nub`'s second field (`b: i64 | null`) is reported nullable — it is, so 1 (§14 B5).
 *
 * @return  1
 */
pub fn nub_b_nullable(): i64 { if @fields<Nub>()[1].is_nullable { 1 } else { 0 } }
