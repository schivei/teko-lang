fn run(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}

fn run_str(name: str, got: str, want: str) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_str(got, want)
    teko::assert::scenario_ok()
}
