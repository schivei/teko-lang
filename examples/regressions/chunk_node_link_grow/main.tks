var root = teko::runtime::region_root()
var zero = teko::sys::word_ptr(0)

var c1 = teko::runtime::chunk_node_link(root, zero, cfg::CAP1)
var c1w = teko::sys::ptr_word(c1) to u64
if teko::mem::load_u64(c1w) != 0 { exit(1) }
if teko::mem::load_u64(c1w + 8) != cfg::CAP1 { exit(2) }
if teko::mem::load_u64(c1w + 16) != 0 { exit(3) }

var c2 = teko::runtime::chunk_node_link(root, c1, cfg::CAP2)
var c2w = teko::sys::ptr_word(c2) to u64
if teko::mem::load_u64(c2w) != c1w { exit(4) }
if teko::mem::load_u64(c2w + 8) != cfg::CAP2 { exit(5) }
if teko::mem::load_u64(c2w + 16) != 0 { exit(6) }

var c3 = teko::runtime::chunk_node_link(root, c2, cfg::CAP3)
var c3w = teko::sys::ptr_word(c3) to u64
if teko::mem::load_u64(c3w) != c2w { exit(7) }
if teko::mem::load_u64(c3w + 8) != cfg::CAP3 { exit(8) }
if teko::mem::load_u64(c3w + 16) != 0 { exit(9) }

if c1w == c2w { exit(10) }
if c2w == c3w { exit(11) }
if c1w == c3w { exit(12) }

exit(0)
