var two: []i32 = [1 to i32, 2 to i32]
var reader: rx::Rx<i32> = rx::make_reader<i32>(two)
var sum: i32 = 0
var running = true
loop {
    if !running { break }
    var v = reader.pop()
    match v {
        i32 as x => { sum = sum + x }
        rx::Closed => { running = false }
    }
}
if sum != 3 { exit(1) }
exit(0)
