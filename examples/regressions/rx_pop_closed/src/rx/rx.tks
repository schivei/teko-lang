pub type Closed = struct { }

pub type Rx<T> = class {
    intern vals: []T
    intern pos: u64

    pub static fn make(vs: []T): Rx<T> {
        .{ vals = vs; pos = 0 }
    }

    pub fn pop(): T | rx::Closed {
        if self.pos >= self.vals.len { return rx::Closed { } }
        var v = self.vals[self.pos]
        self.pos = self.pos + 1
        v
    }
}

pub fn make_reader<T>(vs: []T): Rx<T> {
    Rx<T>::make(vs)
}
