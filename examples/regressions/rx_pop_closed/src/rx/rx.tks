/**
 * Closed — the local mirror of the `teko::threads::Closed` sentinel (§10.2 L711): a nominal empty
 * struct standing for "the channel is closed AND drained". Copied into this self-contained fixture
 * because the `teko::threads` surface is a compiler-internal leaf, not visible to a user project.
 *
 * @since 0.3.1 §10 C1
 */
pub type Closed = struct { }

/**
 * Rx — a minimal single-reader handle over an in-memory value list, standing in for the real
 * key-resolved `chan<T>` receiver. Its sole purpose is to exercise the Gap-2 stamp: a generic method
 * `pop(): T | Closed` whose return unions the type-param `T` with the NOMINAL member `Closed`. A
 * `class` so the read cursor advances across calls.
 *
 * @param T  the element type
 * @since 0.3.1 §10 C1
 */
pub type Rx<T> = class {
    /** vals — the values this receiver will hand out, in order, before signalling Closed. */
    intern vals: []T
    /** pos — the cursor: the index of the next value `pop` returns. */
    intern pos: u64

    /**
     * make — build a receiver that will hand out `vs` in order, then Closed.
     *
     * @param vs  the values to hand out
     * @return    a fresh `Rx<T>` positioned at the first value
     */
    pub static fn make(vs: []T): Rx<T> {
        .{ vals = vs; pos = 0 }
    }

    /**
     * pop — the next value, or `Closed` once every value has been handed out. The de-risk target:
     * `Rx__g__i32.pop(): i32 | Closed` must stamp and both arms must match.
     *
     * @return  the next `T`, or `Closed` when drained
     */
    pub fn pop(): T | rx::Closed {
        if self.pos >= self.vals.len { return rx::Closed { } }
        var v = self.vals[self.pos]
        self.pos = self.pos + 1
        v
    }
}

/**
 * make_reader — the free-function factory bridge (the `to_dict` shape): builds an `Rx<T>` from a
 * value list by calling the static factory `Rx<T>::make` where `Rx` is BARE in its own namespace,
 * sidestepping the tracked qualified-cross-namespace-factory limit a caller would hit writing
 * `rx::Rx<i32>::make` directly.
 *
 * @param vs  the values the receiver will hand out in order
 * @return    a fresh `Rx<T>` positioned at the first value
 * @since 0.3.1 §10 C1
 */
pub fn make_reader<T>(vs: []T): Rx<T> {
    Rx<T>::make(vs)
}
