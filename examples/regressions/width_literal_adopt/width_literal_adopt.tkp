# Regression (cast-width-hygiene-0.3.1.md §2.5, D1 class-2 non-regression): a numeric literal
# operand sits BELOW the W-RULE — it adopts the OTHER operand's type first (context-typing,
# `.29` literal-context typing), so it never even reaches the width join. `n % 3` (n: u32) types
# with `3` adopting `u32` directly — no cast, no width join, no diagnostic.
#   n: u32 = 10  =>  n % 3 == 1
#
#   teko build examples/regressions/width_literal_adopt && ./examples/regressions/width_literal_adopt/width_literal_adopt   # -> exit 1
name = "width_literal_adopt"
source = "src"

[artifact]
kind = "binary"
