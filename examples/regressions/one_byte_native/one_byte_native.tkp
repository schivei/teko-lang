# examples/regressions/one_byte_native — o regressor do baixamento NATIVO do builtin `one_byte`
# (0.3.1.0 degrau 32).
#
# Antes desta mudanca, `native_builtin_symbol` (`src/lir/lower.tks`) nao tinha entrada para
# `one_byte`, entao a resolucao caia em `unresolved_builtin_stop` e a rota nativa parava com
# "native backend N1: builtin `one_byte` not yet lowered (N2)". A paragem matava a matriz de
# artefactos em `teko::encoding::json::parse_string` (`src/encoding/json/json.tks:218`) e com ela o
# fixpoint NATIVO, que constroi gen2/gen3 pelo backend proprio.
#
# `one_byte` devolve um `str` (valor GORDO), entao o simbolo do runtime tinha de ser o gemeo de
# comprimento por parametro de saida (`tk_one_byte_len`, `teko_rt.h`) e nao o `tk_one_byte` de
# retorno por valor que a rota C usa: o `LCall` do backend nativo le UM registo de resultado, nunca
# o par de eightbytes que a SysV/AAPCS64 devolve para um `tk_str`.
#
# O par C deste regressor vive em `examples/regressions/one_byte_c` e nao aqui: `tkr_ensure_built`
# compila um projecto UMA VEZ por ficheiro `.tkr`, com o env do PRIMEIRO cenario, entao um cenario
# de rota C no MESMO ficheiro correria o binario NATIVO com `TEKO_BACKEND=c` posto so a execucao —
# e mediria a coisa errada em silencio.
name = "one_byte_native"
source = "src"

[artifact]
kind = "binary"
