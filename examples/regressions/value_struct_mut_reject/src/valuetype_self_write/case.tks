/**
 * Ring — a `[]i32`-backed value-type (§9 ruling 4) with an `__index` operator and an instance method
 * that tries to WRITE self through the index (`self[0] = …`). A subtype of a primitive/enum/flags
 * carries a readonly, transient `self` (§13.2 ruling 8/10) — the value IS the primitive.
 */
type Ring = []i32 {
    /**
     * __index — read element `i` of the backing `[]i32` (E9 extract). Present so the value-type is
     * well-formed; unrelated to the illegal write below.
     *
     * @param left  the ring value
     * @param i     the element index
     * @return      the indexed element
     */
    operator __index(left: self, i: i32): i32 { (left to []i32)[i] }
    /**
     * poke — attempt to mutate self on a value-type (`self[0] = …`). A value-type's `self` is
     * readonly, so this is a definition error. The illegal form.
     *
     * @return  unreachable — the value-type self write is rejected
     */
    fn poke(): i32 { self[0] = 9; 0 }
}
