/**
 * Tag — a struct with one `readonly` field (`id`) and one ordinary field (§13.3). The readonly
 * field freezes after construction; the ordinary field stays mutable.
 *
 * @field id  a readonly field — set only at construction, never written afterwards
 * @field x   an ordinary mutable field
 */
type Tag = struct { readonly id: u64; x: i32 }

/**
 * ext_write_readonly — write a readonly field from OUTSIDE the type (§13.3): `t.id = 9` targets the
 * frozen `id`, which may be set only at construction. The illegal form.
 *
 * @return  unreachable — the field write is rejected
 */
fn ext_write_readonly(): i32 {
    var t = Tag { id = 1; x = 2 }
    t.id = 9
    t.x
}
