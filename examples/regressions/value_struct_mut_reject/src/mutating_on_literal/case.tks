/**
 * Counter — a mutable value-struct whose `bump` method WRITES self (`self.n = …`), so `bump` is a
 * mutating method (inferred from the body, §13.2 ruling 7 — no `mut fn` marker).
 *
 * @field n  the counter value the mutating method increments
 */
type Counter = struct {
    n: i32
    /**
     * bump — increment the receiver in place. Writing `self.n` makes `bump` a mutating method.
     *
     * @return  void — the receiver is mutated in place
     */
    fn bump() { self.n = self.n + 1 }
}

/**
 * mutating_on_literal — call the mutating `bump` on a LITERAL receiver `Counter { n = 0 }` (§13.2):
 * a literal is an immutable target, so a mutating method may not run on it. The illegal form.
 *
 * @return  unreachable — the mutating call on a literal is rejected
 */
fn mutating_on_literal(): i32 {
    Counter { n = 0 }.bump()
    0
}
