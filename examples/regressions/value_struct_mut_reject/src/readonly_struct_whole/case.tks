/**
 * Point — a `readonly struct` (§13.3): the whole-struct marker freezes EVERY field, so both `x` and
 * `y` are readonly even though neither carries the per-field marker.
 *
 * @field x  a field frozen by the whole-struct `readonly` marker
 * @field y  a field frozen by the whole-struct `readonly` marker
 */
type Point = readonly struct {
    x: i32
    y: i32
    /**
     * shift — attempt to mutate `x` from inside a `readonly struct` method. The whole-struct marker
     * propagated the freeze to every field, so `self.x = …` is rejected. The illegal form.
     *
     * @return  unreachable — the field write is rejected
     */
    fn shift() { self.x = self.x + 1 }
}
