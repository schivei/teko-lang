/**
 * Frozen — a struct whose `id` field is `readonly` and carries an instance method that tries to
 * write it through `self` (§13.3). A readonly field is frozen inside the declaring method too.
 *
 * @field id  a readonly field — never writable, not even from an own method
 */
type Frozen = struct {
    readonly id: u64
    /**
     * touch — attempt to mutate the readonly `id` from INSIDE the type (`self.id = …`). §13.3
     * freezes a readonly field internally and externally alike. The illegal form.
     *
     * @return  unreachable — the internal field write is rejected
     */
    fn touch() { self.id = 5 }
}
