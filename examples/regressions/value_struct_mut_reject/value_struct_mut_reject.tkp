# examples/regressions/value_struct_mut_reject — the item-14 REJECT host (value-struct mutability +
# readonly, §13.1-§13.3). Five illegal forms live one per namespace under src/, and the single
# failing build reports every diagnostic it finds (parse-stage and checker-stage alike, the compiler
# does not stop at the first): an external write to a readonly field, an internal `self` write to a
# readonly field, a `readonly struct` whose method writes a (whole-struct-frozen) field, a mutating
# method called on a literal receiver, and a value-type method that writes its readonly `self`. It
# has no successful build to sanitize/run (it mirrors defaults_named_reject / properties_reject).
name = "value_struct_mut_reject"
source = "src"

[artifact]
kind = "binary"
