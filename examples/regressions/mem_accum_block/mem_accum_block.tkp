# examples/regressions/mem_accum_block — the regressor of an if-arm block-local SLICE accumulator
# (0.3.1 transicao-move-on-return-e-seletor-n-niveis §1/§2, crumb A2/A3). A `mut xs = empty()` grown
# by top-of-block self-appends `xs = list::push(xs, e)` inside an `if` arm is proven block-local by
# the self-append-aware residence predicate (A2) and routed to the arm's OWN region via
# `tk_slice_push_r(<arm region>, …)` (the A3 N-level selector), so its buffer dies at the arm's exit
# edge. Churning further allocating scopes AFTER the arm recycles that freed region memory, so a
# use-after-drop would corrupt the fingerprint rather than merely leak it.
name = "mem_accum_block"
source = "src"

[artifact]
kind = "binary"
