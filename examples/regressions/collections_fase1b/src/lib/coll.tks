pub fn arr_replace_at<T>(xs: []T, at: u64, v: T): []T {
    var out: []T = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i == at { out = teko::list::push(out, v) } else { out = teko::list::push(out, xs[i]) }
        i++
    }
    out
}

pub fn arr_drop_u64_at(xs: []u64, at: u64): []u64 {
    var out: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != at { out = teko::list::push(out, xs[i]) }
        i++
    }
    out
}

pub fn arr_drop_at<T>(xs: []T, at: u64): []T {
    var out: []T = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != at { out = teko::list::push(out, xs[i]) }
        i++
    }
    out
}

pub fn arr_drop_last<T>(xs: []T): []T {
    if xs.len == 0 { return teko::list::empty() }
    arr_drop_at(xs, xs.len - 1)
}

pub fn arr_insert_at<T>(xs: []T, at: u64, v: T): []T {
    var out: []T = teko::list::empty()
    var inserted = false
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i == at {
            out = teko::list::push(out, v)
            inserted = true
        }
        out = teko::list::push(out, xs[i])
        i++
    }
    if !inserted { out = teko::list::push(out, v) }
    out
}

pub fn arr_swap<T>(xs: []T, i: u64, j: u64): []T {
    if i >= xs.len || j >= xs.len { return arr_slice(xs, 0, xs.len) }
    var swapped_i = arr_replace_at(xs, i, xs[j])
    arr_replace_at(swapped_i, j, xs[i])
}

pub fn arr_reverse<T>(xs: []T): []T {
    var out: []T = teko::list::empty()
    var i: u64 = xs.len
    loop {
        if i == 0 { break }
        i--
        out = teko::list::push(out, xs[i])
    }
    out
}

pub fn arr_slice<T>(xs: []T, from: u64, to: u64): []T {
    var out: []T = teko::list::empty()
    var hi = to
    if hi > xs.len { hi = xs.len }
    var i: u64 = from
    loop {
        if i >= hi { break }
        out = teko::list::push(out, xs[i])
        i++
    }
    out
}

pub fn sorted_insert<T: IOrd>(ref items: []T, x: T): bool {
    var arr = items.value
    var lo: u64 = 0
    var hi: u64 = arr.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if arr[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    if lo < arr.len && !(x < arr[lo]) && !(arr[lo] < x) { return false }
    items.value = arr_insert_at(arr, lo, x)
    true
}

pub fn heap_sift_up<T: IOrd>(heap: []T): []T {
    var h = heap
    if h.len == 0 { return h }
    var i = h.len - 1
    loop {
        if i == 0 { break }
        var parent = (i - 1) / 2
        if !(h[i] < h[parent]) { break }
        h = arr_swap(h, i, parent)
        i = parent
    }
    h
}

pub fn heap_pop_min<T: IOrd>(ref heap: []T): T {
    var h = heap.value
    var top = h[0]
    var last = h[h.len - 1]
    h = arr_drop_last(h)
    if h.len == 0 {
        heap.value = h
        return top
    }
    h = arr_replace_at(h, 0, last)
    var i: u64 = 0
    loop {
        var l = i * 2 + 1
        var r = i * 2 + 2
        var smallest = i
        if l < h.len && h[l] < h[smallest] { smallest = l }
        if r < h.len && h[r] < h[smallest] { smallest = r }
        if smallest == i { break }
        h = arr_swap(h, i, smallest)
        i = smallest
    }
    heap.value = h
    top
}

pub type Dictionary<K: IEq & IHash, V> = class {
    intern keys: []K
    intern hashes: []u64
    intern vals: []V

    pub static fn make(): Dictionary<K, V> {
        .{ keys = teko::list::empty(); hashes = teko::list::empty(); vals = teko::list::empty() }
    }

    pub fn len(): u64 { self.keys.len }

    pub fn is_empty(): bool { self.keys.len == 0 }

    pub fn contains(k: K): bool {
        dict_find_index(self.keys, self.hashes, k.hash(), k) < self.keys.len
    }

    pub fn insert(k: K, v: V) {
        var h = k.hash()
        var at = dict_find_index(self.keys, self.hashes, h, k)
        if at < self.keys.len {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = teko::list::push(self.keys, k)
        self.hashes = teko::list::push(self.hashes, h)
        self.vals = teko::list::push(self.vals, v)
    }

    pub fn get(k: K): V | null {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return null }
        self.vals[at]
    }

    pub fn remove(k: K): bool {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return false }
        self.keys = arr_drop_at(self.keys, at)
        self.hashes = arr_drop_u64_at(self.hashes, at)
        self.vals = arr_drop_at(self.vals, at)
        true
    }

    pub fn keys(): []K { self.keys }
}

pub fn dict_find_index<K: IEq & IHash>(keys: []K, hashes: []u64, h: u64, k: K): u64 {
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if hashes[i] == h && keys[i] == k { return i }
        i++
    }
    keys.len
}

pub type HashSet<T: IEq & IHash> = class {
    intern hashes: []u64
    intern items: []T

    pub static fn make(): HashSet<T> {
        .{ hashes = teko::list::empty(); items = teko::list::empty() }
    }

    pub fn len(): u64 { self.items.len }

    pub fn is_empty(): bool { self.items.len == 0 }

    pub fn add(x: T): bool {
        var h = x.hash()
        if dict_find_index(self.items, self.hashes, h, x) < self.items.len { return false }
        self.hashes = teko::list::push(self.hashes, h)
        self.items = teko::list::push(self.items, x)
        true
    }

    pub fn contains(x: T): bool {
        dict_find_index(self.items, self.hashes, x.hash(), x) < self.items.len
    }

    pub fn remove(x: T): bool {
        var at = dict_find_index(self.items, self.hashes, x.hash(), x)
        if at >= self.items.len { return false }
        self.hashes = arr_drop_u64_at(self.hashes, at)
        self.items = arr_drop_at(self.items, at)
        true
    }

    pub fn to_array(): []T { self.items }
}

pub type SortedSet<T: IOrd> = class {
    intern items: []T

    pub static fn make(): SortedSet<T> { .{ items = teko::list::empty() } }

    pub fn len(): u64 { self.items.len }

    pub fn is_empty(): bool { self.items.len == 0 }

    pub fn add(x: T): bool {
        var arr = self.items
        var inserted = sorted_insert(&arr, x)
        self.items = arr
        inserted
    }

    pub fn contains(x: T): bool {
        var arr = self.items
        var lo: u64 = 0
        var hi: u64 = arr.len
        loop {
            if lo >= hi { break }
            var mid = lo + (hi - lo) / 2
            if arr[mid] < x { lo = mid + 1 } else { hi = mid }
        }
        lo < arr.len && !(x < arr[lo]) && !(arr[lo] < x)
    }

    pub fn to_array(): []T { self.items }
}

pub type PriorityQueue<T: IOrd> = class {
    intern heap: []T

    pub static fn make(): PriorityQueue<T> { .{ heap = teko::list::empty() } }

    pub fn len(): u64 { self.heap.len }

    pub fn is_empty(): bool { self.heap.len == 0 }

    pub fn enqueue(x: T) {
        var h = teko::list::push(self.heap, x)
        self.heap = heap_sift_up(h)
    }

    pub fn peek(): T { self.heap[0] }

    pub fn dequeue(): T {
        var h = self.heap
        var m = heap_pop_min(&h)
        self.heap = h
        m
    }
}

pub type SortedDictionary<K: IOrd, V> = class {
    intern keys: []K
    intern vals: []V

    pub static fn make(): SortedDictionary<K, V> {
        .{ keys = teko::list::empty(); vals = teko::list::empty() }
    }

    pub fn len(): u64 { self.keys.len }

    pub fn is_empty(): bool { self.keys.len == 0 }

    pub fn contains(k: K): bool {
        var at = sorted_key_lower_bound(self.keys, k)
        at < self.keys.len && !(k < self.keys[at]) && !(self.keys[at] < k)
    }

    pub fn insert(k: K, v: V) {
        var at = sorted_key_lower_bound(self.keys, k)
        if at < self.keys.len && !(k < self.keys[at]) && !(self.keys[at] < k) {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = arr_insert_at(self.keys, at, k)
        self.vals = arr_insert_at(self.vals, at, v)
    }

    pub fn get(k: K): V | null {
        var at = sorted_key_lower_bound(self.keys, k)
        if at >= self.keys.len || k < self.keys[at] || self.keys[at] < k { return null }
        self.vals[at]
    }

    pub fn keys(): []K { self.keys }
}

pub fn sorted_key_lower_bound<K: IOrd>(keys: []K, k: K): u64 {
    var lo: u64 = 0
    var hi: u64 = keys.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if keys[mid] < k { lo = mid + 1 } else { hi = mid }
    }
    lo
}
