/**
 * twice — a Family-A macro that doubles its argument by SPLICING it twice (§14 A3): `@twice(e)` expands,
 * pre-type-check, to `(e) + (e)` with the `${x}` hole filled by the caller's intact argument node.
 *
 * @param x  the node to double
 * @since macro_expand (§14 A3 fixture)
 */
macro twice(x) {
    lowering { (${x}) + (${x}) }
}

/**
 * sum3 — a Family-A macro summing three spliced arguments: `@sum3(a, b, c)` expands to `(a)+(b)+(c)`.
 *
 * @param a  the first addend node
 * @param b  the second addend node
 * @param c  the third addend node
 * @since macro_expand (§14 A3 fixture)
 */
macro sum3(a, b, c) {
    lowering { (${a}) + (${b}) + (${c}) }
}

/**
 * quad — a Family-A macro that composes `@twice`: `@quad(e)` expands to `@twice(e) + @twice(e)`, which
 * the bounded expansion fixpoint then expands again to `((e)+(e)) + ((e)+(e))` (nested Family-A splice).
 *
 * @param x  the node to quadruple
 * @since macro_expand (§14 A3 fixture)
 */
macro quad(x) {
    lowering { @twice(${x}) + @twice(${x}) }
}

/**
 * twice_probe — `@twice(5)` expands to `(5) + (5)` = 10 (§14 A3).
 *
 * @return  10
 */
pub fn twice_probe(): i64 { @twice(5) }

/**
 * sum3_probe — `@sum3(1, 2, 3)` expands to `(1)+(2)+(3)` = 6 (§14 A3).
 *
 * @return  6
 */
pub fn sum3_probe(): i64 { @sum3(1, 2, 3) }

/**
 * quad_probe — `@quad(5)` expands (nested) to `((5)+(5)) + ((5)+(5))` = 20 (§14 A3).
 *
 * @return  20
 */
pub fn quad_probe(): i64 { @quad(5) }
