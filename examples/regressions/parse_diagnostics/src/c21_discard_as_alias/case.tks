// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: discard_as_alias
// expected diagnostic: '`_` is the write-only discard and cannot be a `let`/`mut`/`const` targ'
pub fn bad(xs: []i64) -> i64 {
    loop mut _ in xs { }
    0
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    mut xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 1)
    if bad(xs) != 0 { exit(1) }
}
