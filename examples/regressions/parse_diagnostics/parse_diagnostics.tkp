# parse_diagnostics.tkp — the PARSE-STAGE compile-fail CHANNEL (NEGATIVE FIXTURE — this project is
# asserted to FAIL).
#
# WHY IT IS A CHANNEL OF ITS OWN and not part of `diagnostics`: a parse error stops the compiler
# before the checker runs, so a checker-stage assertion can never fire in a build that fails in the
# parser, and a parse-stage assertion can never fire in a build that reaches the checker. Two stages,
# two builds — a genuine BUILD-CONFIGURATION split, not a fixture preference.
#
# Twenty-four constructs the PARSER must reject live one per namespace under `src/`, sharing this
# single failing build. See the `.tkr` header.
#
# NAMING: the member-const visibility regression this directory used to be named for MOVED to
# examples/regressions/diagnostics, because it is a CHECKER-stage assertion and this project can no
# longer reach the checker at all.
name = "parse_diagnostics"
source = "src"

[artifact]
kind = "binary"
