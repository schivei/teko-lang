/**
 * Ctr — a generic counter class whose instance method `twice` calls a SIBLING instance method
 * (`self.count()`) on `self` (gap #3, #163 follow-up). Inside the abstract template, `self.count()` is
 * typed against the ABSTRACT owner `Ctr`, so its `call_ns` names `Ctr`; the stamped `Ctr<i64>::count`
 * is emitted under the INSTANCE namespace (`Ctr__g__i64`). Before the mono `call_ns` re-key, the call
 * keyed off the abstract owner emitted a mismatched C symbol and failed to link ("undeclared
 * identifier"). `T` is a phantom type-parameter — it only marks `Ctr` as generic so `Ctr<i64>` is a
 * stamped instance, which is exactly the shape that exercises the re-key.
 */
pub type Ctr<T> = class {
    /** the seeded count value */
    intern n: i64

    /**
     * make — the static factory for a `Ctr<T>`, seeding `n = 3` so `twice` returns a NON-zero value and
     * proves the sibling dispatch actually ran (a zero would pass even if `count` returned garbage).
     *
     * @return  a fresh `Ctr<T>` with `n = 3`
     */
    pub static fn make(): Ctr<T> { .{ n = 3 } }

    /**
     * count — read the seeded count off `self` (the sibling method `twice` dispatches to).
     *
     * @return  the count value `n`
     */
    pub fn count(): i64 { self.n }

    /**
     * twice — the sibling-dispatch probe: `self.count() + self.count()`. Each `self.count()` is the
     * call the mono pass must re-key from the abstract owner `Ctr` to the instance `Ctr__g__i64`.
     *
     * @return  twice the seeded count (`3 + 3 = 6`)
     */
    pub fn twice(): i64 { self.count() + self.count() }
}

/**
 * twice_seeded — build a `Ctr<i64>` via its factory, bind it, and call `twice` on the binding. Proves
 * the sibling `self.count()` inside the stamped `Ctr__g__i64::twice` links and runs (returns 6).
 *
 * @return  6
 */
pub fn twice_seeded(): i64 {
    var c = Ctr<i64>::make()
    c.twice()
}

/**
 * twice_chained — the same probe with the factory and the sibling-dispatch method call CHAINED
 * (`Ctr<i64>::make().twice()`), the exact spelling the design names.
 *
 * @return  6
 */
pub fn twice_chained(): i64 {
    Ctr<i64>::make().twice()
}
