/** SYS_MMAP — x86_64 Linux `mmap` syscall number (9). Local `teko::sys` mirror for a standalone
 *  fixture (the `syscall*` INTRINSIC is a compiler builtin; only the number comes from here). */
#os("linux") #arch("x86_64")
pub const SYS_MMAP: i64 = 9
/** SYS_MMAP — aarch64 Linux `mmap` syscall number (222). */
#os("linux") #arch("arm64")
pub const SYS_MMAP: i64 = 222
/** SYS_MUNMAP — x86_64 Linux `munmap` syscall number (11). */
#os("linux") #arch("x86_64")
pub const SYS_MUNMAP: i64 = 11
/** SYS_MUNMAP — aarch64 Linux `munmap` syscall number (215). */
#os("linux") #arch("arm64")
pub const SYS_MUNMAP: i64 = 215
/** SYS_MPROTECT — x86_64 Linux `mprotect` syscall number (10), used to lay the stack guard page. */
#os("linux") #arch("x86_64")
pub const SYS_MPROTECT: i64 = 10
/** SYS_MPROTECT — aarch64 Linux `mprotect` syscall number (226). */
#os("linux") #arch("arm64")
pub const SYS_MPROTECT: i64 = 226
/** PROT_NONE — `mprotect` no-access protection (0), the guard page's protection. */
#os("linux")
pub const PROT_NONE: i64 = 0
/** PROT_READ — `mmap` readable protection flag (1). */
#os("linux")
pub const PROT_READ: i64 = 1
/** PROT_WRITE — `mmap` writable protection flag (2). */
#os("linux")
pub const PROT_WRITE: i64 = 2
/** MAP_PRIVATE — `mmap` private copy-on-write mapping flag (2). */
#os("linux")
pub const MAP_PRIVATE: i64 = 2
/** MAP_ANONYMOUS — `mmap` anonymous (zero-filled) mapping flag (32). */
#os("linux")
pub const MAP_ANONYMOUS: i64 = 32
