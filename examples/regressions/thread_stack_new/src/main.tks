if top == 0 { exit(2) }
teko::mem::store_u64(top - 8, 305419896)
if teko::mem::load_u64(top - 8) != 305419896 { exit(3) }
var low = top - STACK_BYTES + GUARD_BYTES
teko::mem::store_u64(low, 2596069104)
if teko::mem::load_u64(low) != 2596069104 { exit(4) }
raw_munmap(top - STACK_BYTES, STACK_BYTES)
exit(0)
