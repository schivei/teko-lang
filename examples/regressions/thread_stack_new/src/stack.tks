/** STACK_BYTES — a spawned thread's fixed stack size: 2 MiB (the glibc default thread stack). */
pub const STACK_BYTES: u64 = 2097152
/** GUARD_BYTES — the PROT_NONE guard page at the LOW end of the stack (stacks grow down toward it),
 *  so an overflow faults instead of silently corrupting the mapping below. One page. */
pub const GUARD_BYTES: u64 = 4096

/**
 * raw_mmap — map `length` bytes of anonymous private read/write memory via the raw `mmap` syscall.
 * Returns the page-aligned base, or 0 when the kernel refuses (a `[-4095, -1]` `-errno` result).
 *
 * @param length  the mapping size in bytes
 * @return        the base address, or 0 on failure
 */
pub fn raw_mmap(length: u64): u64 {
    var r = teko::sys::syscall6(sys::SYS_MMAP, 0, length to i64,
        sys::PROT_READ | sys::PROT_WRITE,
        sys::MAP_PRIVATE | sys::MAP_ANONYMOUS, -1, 0)
    if r >= -4095 && r <= -1 { return 0 }
    r to u64
}

/**
 * raw_munmap — release a mapping obtained from `raw_mmap` via the raw `munmap` syscall; the kernel
 * rounds `length` up to whole pages, so the request length unmaps exactly what was mapped, guard
 * page and all.
 *
 * @param address  the mapping's base address
 * @param length   the mapping's request length
 * @return         nothing
 */
pub fn raw_munmap(address: u64, length: u64) {
    _ = teko::sys::syscall2(sys::SYS_MUNMAP, address to i64, length to i64)
}

/**
 * thread_stack_new — allocate a spawned thread's stack (plano §4.1): one `STACK_BYTES` anonymous
 * private mapping with a `GUARD_BYTES` PROT_NONE guard laid at its LOW end (stacks grow down, so the
 * guard is what a stack overflow hits first). Returns the STACK TOP — the highest usable address, the
 * `stack_top` a future `thread_clone` (M3) hands the kernel — or 0 when the mapping fails. The
 * caller frees the whole region with `raw_munmap(stack_top - STACK_BYTES, STACK_BYTES)`.
 *
 * @return  the stack's top (highest) address, or 0 on failure
 */
pub fn thread_stack_new(): u64 {
    var blk = raw_mmap(STACK_BYTES)
    if blk == 0 { return 0 }
    _ = teko::sys::syscall3(sys::SYS_MPROTECT, blk to i64, GUARD_BYTES to i64, sys::PROT_NONE)
    blk + STACK_BYTES
}
