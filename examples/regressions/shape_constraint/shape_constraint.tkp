# examples/regressions/shape_constraint — the §9.2b shape-constraint-solver ACCEPT channel. One native
# build carries every term kind a constraint may name (form words, `service <lifetime>`, interfaces,
# concrete types and the `notnull` modifier) and the disjunction-of-conjunctions that combines them, so
# a term that stopped resolving names the scenario that broke. The REJECT twin is
# `examples/regressions/shape_constraint_reject`.

name = "shape_constraint"
source = "src"

[artifact]
kind = "binary"
