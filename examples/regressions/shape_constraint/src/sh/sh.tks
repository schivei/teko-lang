pub type Ifce = interface {
    fn f(): i64
}

pub type OutraIfce = interface {
    fn g(): i64
}

pub type K = class & Ifce {
    pub static fn make(): K { return K { } }
    pub fn f(): i64 { return 1 }
}

pub type V = struct OutraIfce {
    x: i64
    pub fn g(): i64 { return self.x }
}

pub type Chan = service singleton {
    pub static fn ctor(): self { return Chan { } }
}

pub type Fast = service transient {
    pub static fn ctor(): self { return Fast { } }
}

fn notnull_ok<T: notnull>(t: T): i64 { return 1 }

fn class_notnull_ok<T: class & notnull>(t: T): i64 { return 2 }

fn struct_form_ok<T: struct>(t: T): i64 { return 3 }

fn svc_singleton_ok<T: service singleton>(t: T): i64 { return 4 }

fn svc_bare_ok<T: service>(t: T): i64 { return 5 }

fn concrete_ok<T: str>(t: T): i64 { return 6 }

fn poly<T: class & Ifce | struct & OutraIfce | str>(t: T): i64 { return 7 }

pub fn notnull_probe(): i64 { return notnull_ok<i64>(0) }

pub fn class_notnull_probe(): i64 { return class_notnull_ok<K>(K::make()) }

pub fn struct_form_probe(): i64 { return struct_form_ok<V>(V { x = 1 }) }

pub fn svc_singleton_probe(): i64 { return svc_singleton_ok<Chan>(Chan::ctor()) }

pub fn svc_bare_probe(): i64 { return svc_bare_ok<Fast>(Fast::ctor()) }

pub fn concrete_probe(): i64 { return concrete_ok<str>("x") }

pub fn disj_class_probe(): i64 { return poly<K>(K::make()) }

pub fn disj_struct_probe(): i64 { return poly<V>(V { x = 1 }) }

pub fn disj_concrete_probe(): i64 { return poly<str>("x") }
