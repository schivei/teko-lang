/**
 * scenario_true — run a type-overload case whose probe answers a BOOL, name it, and announce it. The
 * scenario NAME carries the whole diagnosis (`<name>: assertion failed: is_true`) so the companion
 * `.tkr` demands the exact `scenario <name>: ok` line by name, never an exit code.
 *
 * @param name  the case's name, spelled identically in `type_overload.tkr`'s `Scenario:` line
 * @param got   what the case's probe answered
 * @throws      when it answered false — the panic names the case
 */
fn scenario_true(name: str, got: bool) {
    teko::assert::scenario_begin(name)
    teko::assert::is_true(got)
    teko::assert::scenario_ok()
}
