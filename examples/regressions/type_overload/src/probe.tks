pub type Pair = struct {
    a: i64
}

pub type Pair<T> = struct {
    x: T
}

pub type Pair<T, U> = struct {
    x: T
    y: U
}

pub type Box<T> = class {
    intern v: T

    pub static fn of(x: T): Box<T> { .{ v = x } }

    pub fn get(): T { self.v }

    pub fn remap(nx: T): Box<T> { .{ v = nx } }
}

pub fn arity_coexist_probe(): bool {
    var p0 = Pair { a = 7 }
    var p1 = Pair<i64> { x = 3 }
    var p2 = Pair<i64, i64> { x = 4; y = 5 }
    p0.a == 7 && p1.x == 3 && p2.x == 4 && p2.y == 5
}

pub fn dot_static_probe(): bool {
    var bi = Box<i64>::of(42)
    var bs = Box<str>::of("hi")
    bi.get() == 42 && bs.get().len == 2
}

pub fn dot_instance_probe(): bool {
    var b = Box<i64>::of(1)
    var b2 = b.remap(9)
    b2.get() == 9
}

pub fn bare_arity0_probe(): bool {
    var p = Pair { a = 11 }
    p.a == 11
}
