# examples/regressions/type_overload — the §9 B type-overload-by-arity + `.{ … }` target-typed construction
# ACCEPTANCE channel. The type-decl key is `(namespace, name, ARITY)`, so `Pair`, `Pair<T>` and
# `Pair<T,U>` are THREE distinct declarations that coexist in ONE namespace and resolve by the
# reference's SYNTACTIC arity (bare `Pair` = arity 0, `Pair<i64>` = arity 1, …). Construction is
# ALWAYS a type prefix `Pair { … }` / `Pair<i64> { … }`, or the target-typed `.{ … }` (which builds
# the context's type — the same path `List<T>::make` now takes). Each
# probe answers a BOOL that only the correctly-selected declaration/construction can make true, and
# `main.tks` announces the scenario by name. TEST = the printed token, never the exit code.
name = "type_overload"
source = "src"

[artifact]
kind = "binary"
