pub fn build_and_sum(n: i64): i64 {
    var xs: []i64 = teko::list::empty()
    var i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i)
        i = i + 1
    }
    var sum: i64 = 0
    var j: u64 = 0
    loop {
        if j >= xs.len { break }
        sum = sum + xs[j]
        j = j + 1
    }
    sum
}
