pub fn build_and_sum(n: i64): i64 {
    var xs: [n]i64 = []
    var i: i64 = 0
    loop {
        if i >= n { break }
        xs[i] = i
        i = i + 1
    }
    var sum: i64 = 0
    var j: u64 = 0
    loop {
        if j >= xs.len { break }
        sum = sum + xs[j]
        j = j + 1
    }
    sum
}
