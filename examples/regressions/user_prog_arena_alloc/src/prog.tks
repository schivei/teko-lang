/**
 * build_and_sum — allocate a `[]i64` of `n` elements (each `teko::list::push` grows the slice
 * through the runtime arena), then sum them. The ordinary-program allocation the §16 crumb I0
 * runtime-prelude injection rides: the emitted `teko.c` now carries the injected Teko arena even
 * though this project declares no `teko::runtime` of its own.
 *
 * @param n  the number of elements to allocate and sum
 * @return   the sum of the integers `0 .. n-1`
 */
pub fn build_and_sum(n: i64): i64 {
    var xs: []i64 = teko::list::empty()
    var i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i)
        i = i + 1
    }
    var sum: i64 = 0
    var j: u64 = 0
    loop {
        if j >= xs.len { break }
        sum = sum + xs[j]
        j = j + 1
    }
    sum
}
