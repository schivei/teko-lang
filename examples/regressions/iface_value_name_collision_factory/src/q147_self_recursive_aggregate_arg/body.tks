type Nest = struct {
    /** this node's own depth value, surfaced as the program exit code. */
    depth: i64
    /** the child nodes; empty for a leaf (the recursion's base case). */
    kids: []Nest
}
fn deepest(n: Nest) -> i64 {
    if n.kids.len == 0 { n.depth } else { deepest(n.kids[0]) }
}
fn keep_original(n: Nest) -> Nest {
    let d = deepest(n)
    if d > 1000000 { Nest { depth = 0; kids = teko::list::empty() } } else { n }
}
fn make(depth: i64) -> Nest {
    Nest { depth = depth; kids = teko::list::empty() }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: self_recursive_aggregate_arg
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q147_self_recursive_aggregate_arg`.
 */
pub fn entry() {
    let r = keep_original(make(7))
    exit((r.depth) to i32)
}
