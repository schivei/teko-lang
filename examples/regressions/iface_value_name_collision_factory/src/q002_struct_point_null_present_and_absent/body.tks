type Point = struct { x: i64; y: i64 }
fn sum_or(p: Point | null, fallback: i64) -> i64 {
    match p { Point as v => v.x + v.y; null => fallback }
}

/**
 * entry — F3 null-union — scalar, struct, class shapes
 *          :: struct Point | null, present and absent
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q002_struct_point_null_present_and_absent`.
 */
pub fn entry() {
    let present: Point | null = Point { x = 10; y = 20 }
    let absent: Point | null = null
    exit(sum_or(present, 0) + sum_or(absent, 12))
}
