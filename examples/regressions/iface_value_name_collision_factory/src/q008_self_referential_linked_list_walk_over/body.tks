type Node = struct { v: i64; next: Node | null }
fn sum_list(head: Node | null) -> i64 {
    mut cur = head
    mut total: i64 = 0
    loop {
        match cur {
            Node as n => { total = total + n.v; cur = n.next }
            null => break
        }
    }
    total
}

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: self-referential linked-list walk over a null-union next
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q008_self_referential_linked_list_walk_over`.
 */
pub fn entry() {
    let list = Node { v = 10; next = Node { v = 20; next = Node { v = 12; next = null } } }
    exit(sum_list(list))
}
