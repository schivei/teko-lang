type Animal2 = virtual class {
    pub name: str
    pub fn adopt(n: str) -> Animal2 { Animal2 { name = n } }
    pub virtual fn speak(self) -> str { "..." }
}
type Dog2 = class Animal2 {
    pub fn adopt_dog(n: str) -> Dog2 { Dog2 { name = n } }
    pub override fn speak(self) -> str { "Woof" }
}
type Vault = class {
    pub label: str
    pub amount: i64

    pub fn open(label: str, amount: i64) -> Vault { Vault { label = label; amount = amount } }

    pub fn split(self, take: i64) -> Vault {
        Vault { label = self.label; amount = take }
    }

    pub fn read(self) -> i64 { self.amount }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: class_invariant_construction
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q039_class_invariant_construction`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Animal -> Animal2, Dog -> Dog2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let v = Vault::open("savings", 100)
    if v.read() != 100 { exit(1) }
    if v.label != "savings" { exit(2) }
    let piece = v.split(40)
    if piece.read() != 40 { exit(3) }
    if piece.label != "savings" { exit(4) }
    let a = Animal2::adopt("Generic")
    if a.speak() != "..." { exit(5) }
    let d = Dog2::adopt_dog("Rex")
    if d.speak() != "Woof" { exit(6) }
    if d.name != "Rex" { exit(7) }
}
