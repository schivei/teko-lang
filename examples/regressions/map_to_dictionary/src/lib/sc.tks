/**
 * run — the G6 driver at TWO value instantiations. Build a `Map<i64>`, populate it (including an
 * update-in-place a→40), bridge it to a `Dictionary<StrKey, i64>` through the additive `to_dictionary()`,
 * and read every entry back through the generic dictionary (`40 + 20 + 12 + 0 = 72`, the absent `z`
 * contributing 0). Then build a `Map<str>`, bridge it to a `Dictionary<StrKey, str>`, and confirm a
 * value round-trips (adding 5). Exits `77` — proving the str-keyed `Map` and its generic `Dictionary`
 * successor agree on the bridged entries at BOTH widths (the bridge body monomorphizes per value type).
 */
pub fn run() {
    var m = Map<i64>::make()
    m.insert("a", 10)
    m.insert("b", 20)
    m.insert("c", 12)
    m.insert("a", 40)
    var d = m.to_dictionary()
    var a = match d.get(StrKey { key = "a" }) { i64 as x => x; null => 0 }
    var b = match d.get(StrKey { key = "b" }) { i64 as x => x; null => 0 }
    var c = match d.get(StrKey { key = "c" }) { i64 as x => x; null => 0 }
    var miss = match d.get(StrKey { key = "z" }) { i64 as x => x; null => 0 }
    var ms = Map<str>::make()
    ms.insert("x", "hi")
    var ds = ms.to_dictionary()
    var sv = match ds.get(StrKey { key = "x" }) { str as s => s; null => "" }
    var bonus = if sv == "hi" { 5 } else { 0 }
    exit((a + b + c + miss + bonus) to i32)
}
