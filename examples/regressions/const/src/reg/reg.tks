/**
 * Reg — a physical-register descriptor, the flat-POD struct family a backend's register consts
 * belong to (this fixture's stand-in for the compiler's own `MReg`).
 */
type Reg = struct {
    /** the ISA register number. */
    id: i64
    /** which register file the register lives in. */
    klass: i64
    /** whether the operand names a PHYSICAL register (always true for a constructed one). */
    is_phys: bool
}

/**
 * preg — the allowlisted comptime constructor of a physical-register operand (Tier 5 of the const
 * grammar): the whole body is ONE struct literal binding both parameters plus its own `is_phys`
 * literal, which is exactly the shape the checker's const canonicalization splices.
 *
 * @param id     the ISA register number
 * @param klass  which register file the register lives in
 * @return       the physical-register operand
 */
pub fn preg(id: i64, klass: i64): Reg {
    Reg { id = id; klass = klass; is_phys = true }
}

/**
 * RAX — a struct const initialized by a COMPTIME CONSTRUCTOR CALL rather than by a struct literal.
 * Its register number is spelled as an op-tree (`3 + 4`) so the canonicalization is proven to splice
 * the argument the FOLD produced, not the argument as it was written.
 */
const RAX: Reg = preg(3 + 4, 3)

/**
 * flag_score — the numeric weight of a flag field: `1` when set, `0` otherwise.
 *
 * @param b  the flag to weigh
 * @return   `1` when `b`, else `0`
 */
fn flag_score(b: bool): i64 {
    if b { 1 } else { 0 }
}

/**
 * reg_score — read every field of a register descriptor back out, the way a register allocator reads
 * its pinned operands: `id * 6 + klass + is_phys`. Any field the canonicalization dropped, reordered
 * or re-valued changes this total.
 *
 * @param r  the register descriptor to score
 * @return   `r.id * 6 + r.klass + r.is_phys`
 */
fn reg_score(r: Reg): i64 {
    r.id * 6 + r.klass + flag_score(r.is_phys)
}

/**
 * rax_score — the score of the const-materialized `RAX`, the value this regressor asserts as the
 * program's exit code: `7 * 6 + 3 + 1` = `46`.
 *
 * @return the score of the constant register descriptor
 */
pub fn rax_score(): i64 {
    reg_score(RAX)
}
