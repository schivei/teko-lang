# examples/regressions/sys_getrandom — the §16 FOURTH-CRUMB fixture: proves the `ptr_word` pointer-
# bridge intrinsic (§1.2) plus the raw-syscall `syscall3` codegen intrinsic together issue the
# x86_64 Linux `getrandom` syscall against a bump-allocated `as_cstr` buffer, this time WRITABLE (the
# kernel fills it, unlike `sys_write`'s READ-only buffer). A SELF-CONTAINED project (its own local
# copy of the `SYS_GETRANDOM` `#os("linux")`/`#arch` const pair under `src/sys/sys.tks`), because the
# real `teko::sys` lives in the COMPILER's own project (root `teko`, reserved — no user project may
# claim it) and an external standalone project has no visibility into it — the `sys_write`/
# `sys_clock_syscall` precedent. The local copy is a byte-for-byte structural mirror of
# `src/sys/sys.tks`'s `SYS_GETRANDOM` block, so building and running it exercises the identical
# `#os`/`#arch` prune mechanism the real module relies on.
name = "sys_getrandom"
source = "src"

[artifact]
kind = "binary"
