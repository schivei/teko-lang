/**
 * SYS_GETRANDOM — the x86_64 Linux syscall number for `getrandom(buf, buflen, flags)`. This is the
 * fixture's LOCAL mirror of the real `teko::sys::SYS_GETRANDOM` (`src/sys/sys.tks` in the
 * compiler's own project) — every value here is a literal Teko `const`, transcribed from the kernel
 * ABI table, NEVER imported from a C header/macro, and per-`#os`/`#arch` guarded so the §17 prune
 * (`src/build/prune.tks`) keeps exactly the definition matching the compiled target, before the
 * checker ever sees the others. x86_64 value: 318 (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_GETRANDOM: i64 = 318

/**
 * SYS_GETRANDOM — the aarch64 Linux syscall number for `getrandom(buf, buflen, flags)`. Value 278
 * (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (318) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_GETRANDOM: i64 = 278
