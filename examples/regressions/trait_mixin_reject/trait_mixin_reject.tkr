# trait_mixin_reject.tkr — the §9.4 trait-mixin REJECT channel. Four illegal trait constructs live
# one per namespace under src/, and the single failing build reports every diagnostic (parse,
# collection and signature stages all collect), one per scenario below. It has no successful build to
# run. The fold-stage and typing-stage trait rejects live in trait_fold_reject / trait_type_reject:
# a fold error (or a signature error) is a HARD boundary that would cut the downstream walk.

Feature: trait_mixin reject — the compiler rejects the illegal trait-mixin forms (§9.4)

  # (r5_bodyless_method) a trait method with no body belongs on an interface, not a mixin.
  Scenario: r5_bodyless_method — a bodyless trait method is rejected
    When compilation fails
    Then diagnostic = "a trait method must have a body"

  # (r4_trait_as_type) a trait used as a parameter type — a trait is not a type.
  Scenario: r4_trait_as_type — a trait in type position is rejected
    When compilation fails
    Then diagnostic = "is not a type — a trait is a concrete mixin"

  # (r6_self_not_contained) a body references `self._x` the trait never declares.
  Scenario: r6_self_not_contained — an undeclared `self.X` in a trait body is rejected
    When compilation fails
    Then diagnostic = "declares no member '_x'"

  # (r9_carries_interface_incomplete) a trait carries an interface it does not fully implement.
  Scenario: r9_carries_interface_incomplete — an incompletely-carried interface is rejected
    When compilation fails
    Then diagnostic = "does not implement interface 'IFoo9'"
