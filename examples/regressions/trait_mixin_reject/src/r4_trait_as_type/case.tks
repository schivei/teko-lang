/** TT — a trait used illegally as a value/param type. */
type TT = trait {
    /** k — a bodied method. @return 1 */
    fn k(): i64 { 1 }
}
/**
 * g — REJECTED: a trait is used as a parameter type, but a trait is not a type (§9.4).
 * @param x  the mis-typed parameter
 * @return   zero
 */
pub fn g(x: TT): i64 { 0 }
