# examples/regressions/trait_mixin — the §9.4 trait-mixin ACCEPT host: a trait is a self-contained
# concrete mixin (fields + bodied methods + static factories) flattened into a composer, and traits
# compose traits. Each scenario names itself and asserts its announced value, so a relapse names
# itself in both files. The program runs on BOTH backends (the native corpus + the own-vs-C
# differential), witnessing that the composition fold, `self`-resolves-to-host, the idempotent
# diamond and trait-composes-trait all lower identically:
#   * flatten + self=host (a trait field + a method reading it)          — flatten_self_host = 40
#   * a `static fn` factory returning `self` (the composing host)        — static_factory = 0
#   * the idempotent diamond (one trait reached by two paths, absorbed)  — diamond_absorb = 7
#   * trait-composes-trait (`self.v()` of a composed trait)              — compose_trait = 10
name = "trait_mixin"
source = "src"

