type Stamp = trait {
    _id: i64
    fn tag(): i64 { self._id * 10 }
}

type Post = struct Stamp { }

pub fn flatten_self_host(): i64 {
    var p = Post { _id = 4 }
    p.tag()
}

type Sealed = trait {
    static fn seven(): i64 { 7 }
}

type SealedHost = struct Sealed { }

pub fn static_factory(): i64 {
    SealedHost::seven()
}

type DiaBase = trait {
    fn k(): i64 { 7 }
}

type DiaLeft = trait & DiaBase { }

type DiaRight = trait & DiaBase { }

type Diamond = struct DiaLeft & DiaRight { }

pub fn diamond_absorb(): i64 {
    var d = Diamond { }
    d.k()
}

type VBase = trait {
    _v: i64
    fn v(): i64 { self._v }
}

type VExt = trait & VBase {
    fn twice(): i64 { self.v() * 2 }
}

type VHost = struct VExt { }

pub fn compose_trait(): i64 {
    var h = VHost { _v = 5 }
    h.twice()
}

type Greeter = trait {
    fn hello(): i64 { 42 }
}

type GreetSvc = service singleton & Greeter {
    pub static fn ctor(): GreetSvc { return GreetSvc { } }
}

pub fn service_compose(): i64 {
    return svc<GreetSvc>().hello()
}
