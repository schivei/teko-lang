fn case_pass(): null {
    teko::assert::eq_i64(1, 1)
    null
}

fn case_fail(): null {
    teko::assert::eq_i64(1, 2)
    null
}

fn run(label: str, body: func<null>) {
    teko::runtime::test_begin(label)
    match capture_panic(body) {
        str as m => {
            teko::io::eprintln(teko::str::concat("teko: deliberate panic: ", m))
            teko::runtime::test_report(1 to i32, 0 to i32)
        }
        null => teko::runtime::test_report(0 to i32, 0 to i32)
    }
}

/**
 * suite — drive the migrated harness over a two-case suite through the ordinary program (native) path:
 * open each case's channel, run its body under capture_panic, report its verdict, and print the suite
 * summary. One case passes and one fails, so the summary counts both.
 *
 * @since 0.3.1
 */
exp fn suite() {
    run("alpha", case_pass)
    run("beta", case_fail)
    teko::runtime::test_summary()
}
