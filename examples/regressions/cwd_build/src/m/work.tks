/**
 * bool_to_i64 — widen a `bool` to `i64` (`1` for `true`, `0` for `false`).
 *
 * @param b  the flag to widen
 * @return   `1` when `b`, else `0`
 */
fn bool_to_i64(b: bool) -> i64 {
    if b { 1 } else { 0 }
}

/**
 * check_ops — UTF-8 codepoint operations end to end: `is_alpha`/`is_digit`/`is_space` each
 * contribute `1` when true, and `str_slice_chars("hello", 1, 4)` slices the codepoints `"ell"`
 * (length `3`). The CWD-relative `teko build .` invocation (#64) must agree with every other
 * invocation shape on this same total.
 *
 * @return the sum `is_alpha(a) + is_digit(5) + is_space(space) + len_chars("ell")` (`6`)
 */
pub fn check_ops() -> i64 {
    let a = bool_to_i64(is_alpha(c'a'))
    let d = bool_to_i64(is_digit(c'5'))
    let s = bool_to_i64(is_space(c' '))
    let sl = len_chars(str_slice_chars("hello", 1, 4))
    a + d + s + sl
}
