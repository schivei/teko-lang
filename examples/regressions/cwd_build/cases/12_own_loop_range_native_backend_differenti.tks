// F5 backends — the own-native differential corpus (backend x target Examples; own == C, transitively, on the host AND cross to riscv64 under qemu; folds scripts/diff_c_own.sh's CORPUS and the retired riscv64-qemu lane it drove)
// case: own_loop_range_native (backend-differential — own == C, transitively)
//
// A STANDALONE case file (`Given source` from regressor.tkr), not a member namespace of a
// project: this scenario's BUILD CONFIGURATION is what it varies (own backend, a cross
// target, a post-build object check) or its statements carry a top-level `return`, so it
// cannot share a build with anything. It costs one build, exactly as it did inline.
mut s = 0
loop mut i in 0..3 {
    s = s + i
}
if s != 3 { exit(1) }

mut s2 = 0
loop mut i in 0..=3 {
    s2 = s2 + i
}
if s2 != 6 { exit(2) }

mut s3 = 0
loop mut i in 0..5 {
    if i == 2 { continue }
    s3 = s3 + i
}
if s3 != 8 { exit(3) }

mut n = 3
mut cnt = 0
loop mut i in 0..n {
    n = 100
    cnt = cnt + 1
}
if cnt != 3 { exit(4) }

exit(0)
