    let x = "hello"
    let y = "world"
    let a = "lit" ~ "eral" ~ "-fold"
    let b = x ~ " " ~ y
    let c = "pre-" ~ "fix-" ~ x ~ "-suf" ~ "-fix"

    let name = "world"
    let m1 = "foo" ~ "bar"
    let m2 = @"C:\raw" ~ "-tail"
    let m3 = """multi
line""" ~ "-tail"
    let m4 = @"""verbatim
multi""" ~ "-tail"
    let m5 = $"hi {name}" ~ "!"
    let m6 = $"""hi
{name}""" ~ "!"
    let m7 = $@"raw {name}\n" ~ "!"
    let m8 = $@"""raw
{name}""" ~ "!"
    let m9 = "pre-" ~ @"""mid
part""" ~ name ~ "-post"
    let m10 = $"no holes here" ~ "-tail"
    let m11 = $@"""no holes
multiline""" ~ "-tail"

    return a.len + b.len + c.len + m1.len + m2.len + m3.len + m4.len + m5.len + m6.len + m7.len + m8.len + m9.len + m10.len + m11.len
