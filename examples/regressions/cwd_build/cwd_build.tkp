# examples/regressions/cwd_build — the project-regressor for the #64 CWD-relative invocation
# shape (`cd <project> && teko build .`, regressor-principal-0.3.1.md §4 item 7). Folds the
# former `char_ops` fixture (`scripts/native_regressions.sh`'s default target); the runner's
# `When built in place` verb (C3) compiles this project with CWD == its own directory,
# exercising the compiler-relative (not CWD-relative) runtime resolution the #64 bug broke.
name = "cwd_build"
source = "src"

[artifact]
kind = "binary"
