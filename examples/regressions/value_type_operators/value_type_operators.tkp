# examples/regressions/value_type_operators — the §9 ACCEPT host: operator overloading + readonly
# methods on value-types (prim-backed newtypes, enums, flags). Each scenario names itself and asserts
# its own announced value, so a relapse names itself in both files. The program runs on BOTH backends
# (the native corpus + the own-vs-C differential), witnessing that a value-type operator lowers to a
# static method call and the E9 newtype<->base cast is a representation no-op through each backend:
#   * Cel + Cel via the left-owning __add (ruling 8, leg 1)          — arith_same_type = 25
#   * raw + Off via the right-owning __add (ruling 8, leg 2)         — right_side_dispatch = 15
#   * __eq/__ne over the i32 base (rulings 3/5)                      — comparison_and_counterpart = 2
#   * a readonly method on an enum value-type (ruling 12)            — enum_method = 1
#   * operator __index over a []i32-backed newtype (ruling 4)        — indexed_newtype = 30
#   * a readonly method on a flags value-type (ruling 12)            — flags_method = 1
name = "value_type_operators"
source = "src"

[artifact]
kind = "binary"
