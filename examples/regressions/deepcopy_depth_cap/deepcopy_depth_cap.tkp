# examples/regressions/deepcopy_depth_cap — the COL-F0d `deep_copy` fixture (crumb 0024). Proves
# `deep_copy` on a graph deeper than `u8::MAX` (255) RETURNS the `error` variant instead of
# truncating or silently sharing a reference at the frontier. The compiler holds no `deep_copy`
# callers, so this path is not fixpoint-exercised. Pinned to the C backend: the F0d intrinsics
# emit on the C route only (native = honest-stop).
name = "deepcopy_depth_cap"
source = "src"

[artifact]
kind = "binary"
