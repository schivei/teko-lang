type Node = class {
    pub next: Node | null

    pub static fn leaf(): Node {
        Node { next = null }
    }

    pub fn link(nxt: Node) {
        self.next = nxt
    }
}

pub fn build_chain(n: u64): Node {
    var head = Node::leaf()
    var cur = head
    var i: u64 = 1
    loop {
        if i >= n { break }
        var nxt = Node::leaf()
        cur.link(nxt)
        cur = nxt
        i++
    }
    head
}
