/**
 * Sq — an interface declaring a READ-ONLY property `squared` (a getter only, no setter). Get-only
 * makes the property read-only (§9 ruling 1); reading `s.squared` runs the getter BODY, it is not a
 * stored field.
 */
type Sq = interface {
    /** squared — the read-only computed property. */
    get squared(): i64
}

/**
 * NumSq — a CLASS implementer of `Sq`: it holds `_n` and computes `squared` as `_n * _n` in the
 * getter body, proving the getter runs code rather than reading a homonymous field.
 */
type NumSq = class & Sq {
    /** _n — the private base the getter squares. */
    _n: i64

    /**
     * make — the static factory for a `NumSq`.
     *
     * @param v  the base value
     * @return   a fresh `NumSq`
     */
    pub static fn make(v: i64): NumSq { NumSq { _n = v } }

    /**
     * squared — the getter: computes `_n * _n` (a real body, not a field read).
     *
     * @return the base squared
     */
    pub get squared(): i64 { self._n * self._n }
}

/**
 * probe — read the computed read-only property through the interface and confirm the getter body ran
 * (6 * 6 == 36), folding the result into a stable token.
 *
 * @return the fixed token when the getter computes correctly, else a FAIL token
 */
fn probe(): str {
    var s: Sq = NumSq::make(6)
    if s.squared != 36 { return "prop-readonly-getter FAIL" }
    "prop-readonly-getter OK"
}

println(probe())
