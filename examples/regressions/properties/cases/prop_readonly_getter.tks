type Sq = interface {
    get squared(): i64
}

type NumSq = class & Sq {
    _n: i64

    pub static fn make(v: i64): NumSq { NumSq { _n = v } }

    pub get squared(): i64 { self._n * self._n }
}

fn probe(): str {
    var s: Sq = NumSq::make(6)
    if s.squared != 36 { return "prop-readonly-getter FAIL" }
    "prop-readonly-getter OK"
}

println(probe())
