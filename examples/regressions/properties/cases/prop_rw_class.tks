/**
 * Cell — an interface declaring a READ-WRITE property `value` (both a getter and a setter). The
 * accessors are the contract's methods (__get_value / __set_value under the hood), so an implementer
 * must provide both. Presence of both accessors makes `value` read-write (§9 ruling 1).
 */
type Cell = interface {
    /** value — the read half of the property (getter). */
    get value(): i64
    /** value — the write half of the property (setter). */
    set value(v: i64)
}

/**
 * IntCell — a CLASS implementer of `Cell`: it backs `value` with the private field `_v` and provides
 * both accessor bodies. A class value dispatches through the interface fat pointer, so `c.value` and
 * `c.value = v` become vtable-dispatched accessor calls.
 */
type IntCell = class & Cell {
    /** _v — the private backing field the accessors read and write. */
    _v: i64

    /**
     * make — the static factory (a class literal is only legal inside the class's own methods).
     *
     * @return a fresh zeroed `IntCell`
     */
    pub static fn make(): IntCell { IntCell { _v = 0 } }

    /**
     * value — the getter: reads the backing `_v`.
     *
     * @return the stored value
     */
    pub get value(): i64 { self._v }

    /**
     * value — the setter: writes the backing `_v`.
     *
     * @param v  the new value
     */
    pub set value(v: i64) { self._v = v }
}

/**
 * probe — write a property field-like through the interface (`c.value = 7`), read it back field-like
 * (`c.value`), and fold the round-trip into a stable token; a wrong dispatch shows a FAIL token.
 *
 * @return the fixed token when the set-then-get round-trips, else a FAIL token
 */
fn probe(): str {
    var c: Cell = IntCell::make()
    c.value = 7
    if c.value != 7 { return "prop-rw-class FAIL" }
    "prop-rw-class OK"
}

println(probe())
