type Cell = interface {
    get value(): i64
    set value(v: i64)
}

type IntCell = class & Cell {
    _v: i64

    pub static fn make(): IntCell { IntCell { _v = 0 } }

    pub get value(): i64 { self._v }

    pub set value(v: i64) { self._v = v }
}

fn probe(): str {
    var c: Cell = IntCell::make()
    c.value = 7
    if c.value != 7 { return "prop-rw-class FAIL" }
    "prop-rw-class OK"
}

println(probe())
