/**
 * Sink — an interface declaring a WRITE-ONLY property `push` (a setter only, no getter). Set-only
 * makes the property write-only (§9 ruling 1); a plain method `total()` reads the accumulated state
 * (the write-only property itself may not be read).
 */
type Sink = interface {
    /** push — the write-only property: each write adds to the sink. */
    set push(v: i64)
    /** total — an ordinary contract method exposing the accumulated total. */
    fn total(): i64
}

/**
 * Adder — a CLASS implementer of `Sink`: the setter adds each written value into `_sum`, and the
 * ordinary method `total` returns it. Exercises the write-only accessor path end to end.
 */
type Adder = class & Sink {
    /** _sum — the accumulated total the setter feeds and `total` reports. */
    _sum: i64

    /**
     * make — the static factory for an `Adder`.
     *
     * @return a fresh zeroed `Adder`
     */
    pub static fn make(): Adder { Adder { _sum = 0 } }

    /**
     * push — the setter: adds the written value into `_sum`.
     *
     * @param v  the value to add
     */
    pub set push(v: i64) { self._sum = self._sum + v }

    /**
     * total — the accumulated total.
     *
     * @return `_sum`
     */
    pub fn total(): i64 { self._sum }
}

/**
 * probe — write the write-only property field-like twice through the interface (`k.push = 10`,
 * `k.push = 22`) and read the accumulated total via the ordinary method, folding it into a token.
 *
 * @return the fixed token when both writes land (10 + 22 == 32), else a FAIL token
 */
fn probe(): str {
    var k: Sink = Adder::make()
    k.push = 10
    k.push = 22
    if k.total() != 32 { return "prop-writeonly-sink FAIL" }
    "prop-writeonly-sink OK"
}

println(probe())
