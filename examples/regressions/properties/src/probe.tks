/**
 * Point — a STRUCT with a get-only property `x` backed by the private field `_x` (§9 ruling 4:
 * struct implementers use get-only, the IR-migration shape). Reading `p.x` desugars to the direct
 * method call `p.__get_x()` — a struct value dispatches statically, with NO fat pointer, so this is
 * the property path that lowers on the NATIVE backend.
 */
pub type Point = struct {
    /** _x — the private backing field the `x` getter reads. */
    _x: i64

    /**
     * make — the static factory (a struct literal round-trips through a named constructor here).
     *
     * @param v  the initial `_x`
     * @return   a fresh `Point`
     */
    pub static fn make(v: i64): Point { Point { _x = v } }

    /**
     * x — the get-only property: reads the private backing field `_x`. Written field-like as `p.x`.
     *
     * @return the backing `_x`
     */
    pub get x(): i64 { self._x }
}

/**
 * Bag — a struct whose ORDINARY methods are literally named `get` and `set`, proving `get`/`set` are
 * CONTEXTUAL keywords: in `fn get`/`fn set` member position they stay ordinary method names (only a
 * bare `get <name>(`/`set <name>(` starts an accessor), so the corpus's hundreds of real `get`/`set`
 * identifiers keep parsing.
 */
pub type Bag = struct {
    /** _n — the datum the `get`/`set` methods read. */
    _n: i64

    /**
     * make — the static factory for a `Bag`.
     *
     * @param v  the initial `_n`
     * @return   a fresh `Bag`
     */
    pub static fn make(v: i64): Bag { Bag { _n = v } }

    /**
     * get — an ordinary method literally named `get` (not an accessor — it is written `fn get`).
     *
     * @return the datum `_n`
     */
    pub fn get(): i64 { self._n }

    /**
     * set — an ordinary method literally named `set` (not an accessor — it is written `fn set`).
     *
     * @param v  an addend
     * @return   `v + _n`
     */
    pub fn set(v: i64): i64 { v + self._n }
}

/**
 * struct_getonly_probe — read a struct's get-only property `p.x` field-like and confirm it runs the
 * getter body (returns the backing `_x`) through the NATIVE direct-dispatch path.
 *
 * @return true iff `p.x` reads back the constructed value
 */
pub fn struct_getonly_probe(): bool {
    var p = Point::make(5)
    p.x == 5
}

/**
 * name_free_probe — prove `get`/`set` stay ordinary identifiers: call the methods named `get`/`set`,
 * and bind a local `get`. None of these is a property; all keep their historic meaning.
 *
 * @return true iff the ordinary `get`/`set` uses evaluate unchanged
 */
pub fn name_free_probe(): bool {
    var b = Bag::make(3)
    var get = 4
    b.get() + b.set(1) + get == 11
}
