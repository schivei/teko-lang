# examples/regressions/properties — the §9 properties (get/set accessors) ACCEPTANCE channel. An
# accessor IS a method: the parser registers it under a synthetic name (__get_<prop>/__set_<prop>),
# and the use-site desugars `a.prop`/`a.prop = v` to that method call, so every backend mechanism is
# reused with ZERO backend change. The NATIVE-route member (`main.tks` + `src/probe.tks`) exercises a
# STRUCT get-only property (direct dispatch, no fat pointer) AND proves `get`/`set` stay ordinary
# identifiers (contextual keywords). The interface members run down the C route (`cases/*.tks`, env
# TEKO_BACKEND=c): an interface property dispatches through the fat-pointer vtable, which — exactly
# like interface method dispatch and the match_universal channel — is a C-backend capability this cut
# (the native fat-pointer dispatch stays the existing N2 honest-stop). TEST = the printed token.
name = "properties"
source = "src"

[artifact]
kind = "binary"
