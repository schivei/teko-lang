# properties.tkr — the §9 properties (get/set accessors) ACCEPTANCE channel. An accessor IS a method:
# the parser flags a `get`/`set` member and registers it under a synthetic name (__get_<prop> /
# __set_<prop>), and the use-site desugars `a.prop`/`a.prop = v` to that method call — so registration,
# conformance, the vtable slot and dispatch are all reused with ZERO backend change. The two NATIVE
# members (`prop_struct_getonly`, `prop_getset_name_free`) run on the default backend: a struct's
# get-only property dispatches DIRECTLY (no fat pointer), and `get`/`set` stay ordinary identifiers
# (contextual keywords). The interface members run down the C route (env TEKO_BACKEND=c), where an
# interface value is a fat pointer whose vtable carries the accessor slots — the native backend's
# fat-pointer dispatch stays the existing N2 honest-stop, the same reason match_universal pins its
# class/interface members to C. TEST = the printed token, never the exit code (the axis law).

Feature: §9 properties — get/set accessors dispatch field-like on classes and structs

  # (prop_struct_getonly, NATIVE) a STRUCT get-only property `p.x` reads field-like through the
  # getter body via DIRECT dispatch — the property path that lowers on the native backend, and the
  # IR-migration shape (struct implementers are get-only).
  Scenario: prop_struct_getonly — a struct's get-only property reads field-like through direct dispatch
    When built and run
    Then stdout pattern = "scenario prop_struct_getonly: ok"

  # (prop_getset_name_free, NATIVE) `get`/`set` stay ORDINARY identifiers — methods literally named
  # `get`/`set` and a local `get` all keep their historic meaning, proving the contextual keyword did
  # not regress the corpus's hundreds of real `get`/`set` names.
  Scenario: prop_getset_name_free — get/set remain ordinary identifiers (contextual keyword)
    When built and run
    Then stdout pattern = "scenario prop_getset_name_free: ok"

  # (prop_rw_class, C ROUTE) a read-write property on a CLASS behind an INTERFACE value: write
  # `c.value = 7` (setter) then read `c.value` (getter), both dispatched through the fat-pointer
  # vtable, and witness the round-trip.
  Scenario: prop_rw_class — a class read-write property round-trips set-then-get through interface dispatch
    Given source = "cases/prop_rw_class.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "prop-rw-class OK"

  # (prop_readonly_getter, C ROUTE) a read-only COMPUTED property: the getter runs a body (`_n * _n`)
  # rather than reading a homonymous field, proving an accessor is a method, not a field alias.
  Scenario: prop_readonly_getter — a read-only computed property runs the getter body
    Given source = "cases/prop_readonly_getter.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "prop-readonly-getter OK"

  # (prop_writeonly_sink, C ROUTE) a write-only property: two field-like writes `k.push = …` reach the
  # setter and accumulate, read back via an ordinary contract method — the write-only accessor path.
  Scenario: prop_writeonly_sink — a write-only property accepts field-like writes through the setter
    Given source = "cases/prop_writeonly_sink.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "prop-writeonly-sink OK"
