# examples/regressions/of_len_zero_fill — the COL-F0a fixed-backing anchor-form fixture
# (crumb 0021). Proves `teko::list::of_len<i64>(n)` materializes n zero-filled slots in one pass,
# that index-assign `xs[i] = v` writes positions under a `count` watermark, and that the array is
# FIXED (`xs.len == n`, never grown). Built on the C leg (`TEKO_BACKEND=c`): the VALUE regime emits
# on the C route and the native leg honest-stops (sized-array / mem-value are N2), so the scenario
# pins the C backend. `of_len` lowers through the existing `emit_slice_of_len` materializer.
name = "of_len_zero_fill"
source = "src"

