var n: u64 = cfg::SLOTS
var xs = teko::list::of_len<i64>(n)

var zeros: u64 = 0
loop var i in 0..n {
    if xs[i] == 0 { zeros = zeros + 1 }
}
if zeros != n { exit(1) }

var count: u64 = 0
loop var i in 0..n {
    xs[i] = (i to i64) + 1
    count = count + 1
}
if count != n { exit(2) }
if xs.len != n { exit(3) }

var sum: i64 = 0
loop var i in 0..count {
    sum = sum + xs[i]
}
if sum != cfg::EXPECTED_SUM { exit(4) }

exit(0)
