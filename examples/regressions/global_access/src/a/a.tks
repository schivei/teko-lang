/**
 * ping — a `global` fn (§15): reachable bare from any namespace, and still via `a::ping`.
 * @return the witness 7
 */
global fn ping(): i32 { 7 }

/**
 * Tag — a `global` type (§15): bare-constructible from any namespace.
 * @field n a witness field
 */
global type Tag = struct { n: i32 }

/**
 * f — the arity-1 member of a cross-namespace global overload set (§15 ruling 3, distinct signatures).
 * @param x the sole argument, returned unchanged
 * @return  x
 */
global fn f(x: i32): i32 { x }

/**
 * g — an `exp global` fn: the visibility axis (exp) and the reach axis (global) compose (§15 ruling 4).
 * @return the witness 3
 */
exp global fn g(): i32 { 3 }

/**
 * cz — an `exp global comptime` (§15 ruling 4 + §14): the composition parses, checks and folds.
 * @return the compile-time witness 4
 */
exp global comptime cz(): i32 { 4 }

/**
 * cz_probe — folds the `exp global comptime` at a same-namespace call site.
 * @return @cz() = 4
 */
pub fn cz_probe(): i32 { @cz() }
