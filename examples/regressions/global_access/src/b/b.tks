/**
 * f — the arity-2 member of the global overload set whose arity-1 twin lives in namespace `a` (§15).
 * @param x the first argument
 * @param y the second argument
 * @return  x + y
 */
global fn f(x: i32, y: i32): i32 { x + y }

/**
 * run — sums every §15 access path into the single witness the ACCEPT fixture pins.
 * @return 7 + 7 + 5 + 10 + 3 + 3 + 4 = 39
 */
pub fn run(): i32 { ping() + a::ping() + Tag { n = 5 }.n + f(10) + f(1, 2) + g() + a::cz_probe() }
