/**
 * score — exercise every aggregate-returning host-FFI result shape the native backend lowers
 * through its own-register `tk_rt_*_ok` twins (0.3.1.0 degrau 34) and return a disjoint weighted
 * sum, so a mis-marshalled `(ptr, len)` in any single arm moves the number instead of passing.
 *
 * The four weights cover both branch arms of the two-block twin shape: `read_file`/`env::var`/
 * `list_dir` take their ERROR arm (the failure message travels back through the out-slots, and
 * each is compared to its exact runtime text so a wrong pointer or length fails the compare), while
 * `env::cwd` takes its SUCCESS arm (the working directory's `str` value travels back through the
 * SAME out-slots as a fat payload). `str | error` (var/cwd/read_file) and `[]str | error`
 * (list_dir) are the two Variant-returning shapes standalone native lowering builds.
 *
 * @return  60 (4 + 8 + 16 + 32) when every shape marshals correctly
 */
pub fn score() -> u64 {
    mut s: u64 = 0
    match teko::io::read_file("definitely-absent-ffi-probe.xyz") {
        str => { }
        error as e => if e.message == "cannot open file" { s = s + 4 }
    }
    match teko::env::var("TEKO_HOST_FFI_DEFINITELY_UNSET") {
        str => { }
        error as e => if e.message == "environment variable not set" { s = s + 8 }
    }
    match teko::fs::list_dir("definitely-absent-ffi-dir") {
        []str => { }
        error as e => if e.message == "cannot open directory" { s = s + 16 }
    }
    match teko::env::cwd() {
        str as c => if c.len > 0 { s = s + 32 }
        error => { }
    }
    s
}
