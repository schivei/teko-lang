/**
 * Thing — a leaf struct in namespace `b` deliberately sharing its BARE name with `a::Thing`. Carries
 * a distinct payload (22) so an ALIASED union field (finding #4) would read the wrong namespace's
 * value and fail the exit-code assertion.
 *
 * @field payload  the value read back to prove no cross-namespace aliasing (22 for `b`)
 */
type Thing = struct { payload: i64 }

/**
 * Note — a second leaf struct in namespace `b`, the `b` counterpart of `a::Note`, for the named
 * variant `Step`.
 *
 * @field mark  a value read back through the variant destructure
 */
type Note = struct { mark: i64 }

/**
 * Step — a NAMED variant `Thing | Note` in namespace `b`, sharing its bare name with `a::Step`; its
 * tag constants (`TK_TAG_B__STEP_…`) must be distinct from `a::Step`'s.
 *
 * @return  the named variant type
 */
type Step = Thing | Note

/**
 * make_thing — a present `Thing` carrying `b`'s payload 22, seated in a `Thing | error` union.
 *
 * @return  a `Thing` whose payload is 22
 */
pub fn make_thing(): Thing | error { Thing { payload = 22 } }

/**
 * read_thing — read a `Thing | error`'s payload, or -1 on the error case. The `Thing as x` destructure
 * must name `b`'s qualified union field, distinct from `a`'s.
 *
 * @param t  the union value
 * @return   the payload, or -1 on error
 */
pub fn read_thing(t: Thing | error): i64 {
    match t {
        Thing as x => x.payload
        error as e => -1
    }
}

/**
 * make_opt — a `Thing | null`, present or absent per the flag, carrying `b`'s payload 22.
 *
 * @param present  whether the value is present
 * @return         a present `Thing` (payload 22) or `null`
 */
pub fn make_opt(present: bool): Thing | null {
    if present { Thing { payload = 22 } } else { null }
}

/**
 * read_opt — read a `Thing | null`'s payload, or -1 when null.
 *
 * @param t  the optional value
 * @return   the payload, or -1 when null
 */
pub fn read_opt(t: Thing | null): i64 {
    match t {
        Thing as x => x.payload
        null => -1
    }
}

/**
 * step_note_mark — build a `Step` from a `Note` and read the mark back through the named-variant
 * destructure; the `Thing` arm returns its payload.
 *
 * @return  99 (the `Note` mark)
 */
pub fn step_note_mark(): i64 {
    var s: Step = Note { mark = 99 }
    match s {
        Thing as x => x.payload
        Note as n => n.mark
    }
}
