/**
 * Foo — a ROOT-namespace struct in a `Foo | error` union. Its C symbols must be BYTE-IDENTICAL to
 * before the fix (a root name has no `::`, so `cg_ns_c_key` is the identity): the reseed-bounding
 * invariant of finding #4.
 *
 * @field n  the value read back
 */
type Foo = struct { n: i64 }

/**
 * Bar — a ROOT-namespace struct in a `Bar | null` union, likewise unchanged by the fix.
 *
 * @field n  the value read back
 */
type Bar = struct { n: i64 }

/**
 * root_foo — read a root-namespace `Foo | error`'s value, proving root unions still work unchanged.
 *
 * @return  7
 */
pub fn root_foo(): i64 {
    var v: Foo | error = Foo { n = 7 }
    match v {
        Foo as f => f.n
        error as e => -1
    }
}

/**
 * root_bar — read a root-namespace `Bar | null`'s value, proving root optionals still work unchanged.
 *
 * @return  8
 */
pub fn root_bar(): i64 {
    var v: Bar | null = Bar { n = 8 }
    match v {
        Bar as b => b.n
        null => -1
    }
}

/**
 * builtin_union — read an `i64 | error` and a `str | null`, proving builtin/error/null union keys are
 * untouched by the namespace qualification.
 *
 * @return  5 when both builtin unions round-trip, else -1
 */
pub fn builtin_union(): i64 {
    var a: i64 | error = 5
    var b: str | null = "hi"
    var av = match a { i64 as x => x; error as e => -1 }
    var bv = match b { str as s => s.len to i64; null => -1 }
    if bv == 2 { av } else { -1 }
}

/**
 * run — execute ONE scenario: name it, assert its announced value, and print the
 * `scenario <name>: ok` line the companion `.tkr` demands by name.
 *
 * @param name  the scenario name, spelled identically in the `.tkr` `Scenario:` line
 * @param got   what the scenario probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the scenario and both values
 */
fn run(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}
