/**
 * Thing — a leaf struct in namespace `a` deliberately sharing its BARE name with `b::Thing`. Used in
 * a `Thing | error` and a `Thing | null` union so codegen must keep `a`'s and `b`'s union C symbols
 * (`tk_u_…`, tag, `.as.` field) apart by namespace; before finding #4's fix the two collided.
 *
 * @field payload  the value read back to prove no cross-namespace aliasing (11 for `a`)
 */
type Thing = struct { payload: i64 }

/**
 * Note — a second leaf struct in namespace `a`, so the named variant `Step` has two same-bare-named
 * members across `a` and `b` (`a::Note` vs `b::Note`) exercising Crumb 4's tag-stem qualification.
 *
 * @field mark  a value read back through the variant destructure
 */
type Note = struct { mark: i64 }

/**
 * Step — a NAMED variant `Thing | Note` in namespace `a`, sharing its bare name with `b::Step`. Its
 * tag constants (`TK_TAG_A__STEP_…`) must be distinct from `b::Step`'s.
 *
 * @return  the named variant type
 */
type Step = Thing | Note

/**
 * make_thing — a present `Thing` carrying `a`'s payload 11, seated in a `Thing | error` union.
 *
 * @return  a `Thing` whose payload is 11
 */
pub fn make_thing(): Thing | error { Thing { payload = 11 } }

/**
 * read_thing — read a `Thing | error`'s payload, or -1 on the error case. The `Thing as x` destructure
 * must name `a`'s qualified union field.
 *
 * @param t  the union value
 * @return   the payload, or -1 on error
 */
pub fn read_thing(t: Thing | error): i64 {
    match t {
        Thing as x => x.payload
        error as e => -1
    }
}

/**
 * make_opt — a `Thing | null`, present or absent per the flag, carrying `a`'s payload 11.
 *
 * @param present  whether the value is present
 * @return         a present `Thing` (payload 11) or `null`
 */
pub fn make_opt(present: bool): Thing | null {
    if present { Thing { payload = 11 } } else { null }
}

/**
 * read_opt — read a `Thing | null`'s payload, or -1 when null.
 *
 * @param t  the optional value
 * @return   the payload, or -1 when null
 */
pub fn read_opt(t: Thing | null): i64 {
    match t {
        Thing as x => x.payload
        null => -1
    }
}

/**
 * step_thing_mark — build a `Step` from a `Thing` and read the payload back through the named-variant
 * destructure; the `Note` arm returns its mark.
 *
 * @return  11 (the `Thing` payload)
 */
pub fn step_thing_mark(): i64 {
    var s: Step = Thing { payload = 11 }
    match s {
        Thing as x => x.payload
        Note as n => n.mark
    }
}
