# examples/regressions/wrapped_retain_release — the COL-F0c wrapped-refcount fixture (crumb 0023).
# Proves `retain`/`release` maintain a precise per-object reference count in the root-arena
# `addr -> count` dict: retaining twice then releasing once must NOT free the object, and only the
# SECOND release (count reaching zero) frees it. The compiler holds no `wrapped` objects, so this
# path is not fixpoint-exercised. Pinned to the C backend: `retain`/`release` emit on the C route.
name = "wrapped_retain_release"
source = "src"

[artifact]
kind = "binary"
