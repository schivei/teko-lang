var root = teko::runtime::region_root()
var obj = teko::runtime::region_new(root)
var obj_w = teko::sys::ptr_word(obj)

var retained: u64 = 0
loop {
    if retained >= cfg::RETAIN_COUNT { break }
    retain(obj)
    retained++
}

var released: u64 = 0
loop {
    if released >= cfg::RETAIN_COUNT - 1 { break }
    release(obj)
    released++
}

var probe1 = teko::runtime::region_new(root)
if teko::sys::ptr_word(probe1) == obj_w { exit(1) }

release(obj)

var probe2 = teko::runtime::region_new(root)
if teko::sys::ptr_word(probe2) != obj_w { exit(2) }

exit(0)
