type IEq = interface {
    operator __eq(left: self, right: self): bool
    operator __ne(left: self, right: self): bool
}

type NeByEq = trait {
    operator __ne(left: self, right: self): bool { !(left == right) }
}

type IHash = interface {
    fn hash(): u64
}

type Plain = struct IEq & NeByEq {
    n: i64
    operator __eq(left: self, right: self): bool { left.n == right.n }
}

pub fn find_index<K: IEq & IHash>(keys: []K, hashes: []u64, h: u64, k: K): u64 {
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if hashes[i] == h && keys[i] == k { return i }
        i++
    }
    keys.len
}

pub type Dict<K: IEq & IHash, V> = class {
    intern keys: []K
    intern hashes: []u64
    intern vals: []V

    pub static fn make(): Dict<K, V> {
        .{ keys = teko::list::empty(); hashes = teko::list::empty(); vals = teko::list::empty() }
    }

    pub fn insert(k: K, v: V) {
        var h = k.hash()
        var at = find_index(self.keys, self.hashes, h, k)
        if at < self.keys.len { return }
        self.keys = teko::list::push(self.keys, k)
        self.hashes = teko::list::push(self.hashes, h)
        self.vals = teko::list::push(self.vals, v)
    }
}

pub fn trip_key_gate() {
    var d = Dict<keygate::Plain, i64>::make()
    d.insert(Plain { n = 1 }, 7)
    teko::io::println("this program must never compile")
}
