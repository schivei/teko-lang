# examples/regressions/arena_wordptr — the §16 arena SUB-CRUMB C fixture: proves `word_ptr`
# (§2.1) — the INVERSE of `ptr_word` — recovers a working `ptr` from an `i64` word. A
# SELF-CONTAINED project (its own local copy of the `SYS_WRITE` `#os("linux")`/`#arch` const pair
# under `src/sys/sys.tks`), because the real `teko::sys` lives in the COMPILER's own project
# (root `teko`, reserved — no user project may claim it) and an external standalone project has
# no visibility into it — the `sys_write` precedent. The local copy is a byte-for-byte structural
# mirror of `src/sys/sys.tks`'s `SYS_WRITE` block, so building and running it exercises the
# identical `#os`/`#arch` prune mechanism the real module relies on.
name = "arena_wordptr"
source = "src"

[artifact]
kind = "binary"
