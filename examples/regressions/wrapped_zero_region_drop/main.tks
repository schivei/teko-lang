var root = teko::runtime::region_root()
var freed: u64 = 0

loop var i in 0..cfg::OBJECT_COUNT {
    var obj = teko::runtime::region_new(root)
    var obj_w = teko::sys::ptr_word(obj)
    retain(obj)
    release(obj)
    var probe = teko::runtime::region_new(root)
    if teko::sys::ptr_word(probe) == obj_w { freed = freed + 1 }
}

if freed != cfg::OBJECT_COUNT { exit(1) }
exit(0)
