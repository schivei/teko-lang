# examples/regressions/wrapped_zero_region_drop — the COL-F0c wrapped-refcount fixture (crumb
# 0023). Proves the last `release` drops an object's region ON THE SPOT — immediately, within the
# same loop iteration — rather than deferring the free to outer-scope end. Each of N objects is
# retained once and released once inside one loop iteration, and a `region_new` issued in that SAME
# iteration must already recycle the just-freed header. The compiler holds no `wrapped` objects, so
# this path is not fixpoint-exercised. Pinned to the C backend.
name = "wrapped_zero_region_drop"
source = "src"

[artifact]
kind = "binary"
