/**
 * The §9.2b HONEST-LIFETIME ruling: a transport that is not the demanded lifetime FAILS COMPILATION at
 * the instantiation point, rather than being silently redirected to singleton. A `service transient`
 * handed to a `<T: service singleton>` bound is exactly that failure.
 */

/**
 * Fast — a service declared `transient` (a new instance per resolution).
 */
pub type Fast = service transient {
    /**
     * ctor — the IService factory.
     *
     * @return Fast  a fresh instance
     */
    pub static fn ctor(): self { return Fast { } }
}

/**
 * wants_singleton — the §10.2-shaped transport bound: only a SINGLETON service satisfies it.
 *
 * @param t  the transport, which must be a singleton service
 * @return i64  the value it would announce
 */
fn wants_singleton<T: service singleton>(t: T): i64 { return 1 }

/**
 * entry — instantiating the singleton bound with a TRANSIENT service is rejected (§9.2b).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return wants_singleton<Fast>(Fast::ctor()) }
