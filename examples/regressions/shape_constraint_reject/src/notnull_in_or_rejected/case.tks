/**
 * `notnull` is a MODIFIER, not a shape-alternative: it may enter a constraint only through `&`
 * (`class & notnull`, or alone), never as a `|` disjunct. This is a GRAMMAR refusal — the parser
 * rejects it before any instantiation exists (§9.2b).
 */

/**
 * nn_or — a bound writing `notnull` as a `|` alternative: rejected at parse time.
 *
 * @param t  never bound — the build fails
 * @return i64  never — the build fails
 */
pub fn nn_or<T: notnull | str>(t: T): i64 { return 1 }
