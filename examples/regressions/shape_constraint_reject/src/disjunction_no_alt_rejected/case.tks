/**
 * A constraint is a DISJUNCTION OF CONJUNCTIONS: the type-argument must satisfy EVERY term of at
 * least ONE alternative. A struct that does not conform to the required interface satisfies neither
 * `class & Ifce` (wrong form) nor `struct & Ifce` (no conformance), so the whole bound is rejected —
 * the conjunctions really bind, no alternative leaks (§9.2b).
 */

/**
 * Ifce — the contract both alternatives require.
 */
pub type Ifce = interface {
    /** @return i64  the contract's value. */
    fn f(): i64
}

/**
 * Bare — a struct conforming to NOTHING: it fails both alternatives.
 *
 * @field y  an arbitrary payload
 */
pub type Bare = struct { y: i64 }

/**
 * two_alts — a two-alternative disjunction, each alternative a conjunction with `Ifce`.
 *
 * @param t  the value, which must satisfy one whole alternative
 * @return i64  the value it would announce
 */
fn two_alts<T: class & Ifce | struct & Ifce>(t: T): i64 { return 1 }

/**
 * entry — instantiating it with a non-conforming struct is rejected (§9.2b).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return two_alts<Bare>(Bare { y = 1 }) }
