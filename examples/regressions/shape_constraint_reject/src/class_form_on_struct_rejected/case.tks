/**
 * A FORM WORD forces the type-argument's shape. `class` admits only a class, so a `struct` handed to
 * a `<T: class>` bound is rejected (§9.2b).
 */

/**
 * P — a plain value struct: the wrong FORM for a `class` bound.
 *
 * @field x  an arbitrary payload
 */
pub type P = struct { x: i64 }

/**
 * wants_class — a bound demanding the `class` form.
 *
 * @param t  the value, which must be a class
 * @return i64  the value it would announce
 */
fn wants_class<T: class>(t: T): i64 { return 1 }

/**
 * entry — instantiating the `class` form with a struct is rejected (§9.2b).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return wants_class<P>(P { x = 1 }) }
