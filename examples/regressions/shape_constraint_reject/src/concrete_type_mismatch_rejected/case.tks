/**
 * A CONCRETE type term forces IDENTITY, not conformance: `<T: str>` admits exactly `str`, so any
 * other concrete type is rejected (§9.2b).
 */

/**
 * wants_str — a bound naming the concrete type `str`.
 *
 * @param t  the value, whose type must be exactly `str`
 * @return i64  the value it would announce
 */
fn wants_str<T: str>(t: T): i64 { return 1 }

/**
 * entry — instantiating the `str` term with `i64` is rejected (§9.2b).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return wants_str<i64>(5) }
