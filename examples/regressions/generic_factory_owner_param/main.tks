var di: lib::Dictionary<lib::StrKey, i64> = lib::to_dict<i64>("a", 41)
di.insert(lib::StrKey { key = "b" }, 1)
var a = match di.get(lib::StrKey { key = "a" }) { i64 as x => x; null => 0 }
var b = match di.get(lib::StrKey { key = "b" }) { i64 as x => x; null => 0 }
var ds: lib::Dictionary<lib::StrKey, str> = lib::to_dict<str>("x", "hello")
var sv = match ds.get(lib::StrKey { key = "x" }) { str as s => s; null => "" }
var extra = if sv == "hello" { 5 } else { 0 }
exit((a + b + extra) to i32)
