/** WORKERS — the number of contending threads (plano §8 T3: M=8). */
pub const WORKERS: i64 = 8
/** ITERS — locked increments each worker performs (plano §8 T3: K=10000). */
pub const ITERS: i64 = 10000
/** POLL_LIMIT — bounded spins the main thread waits for all workers to finish before failing. */
pub const POLL_LIMIT: i64 = 2000000000
/** MUTEX_OFF — byte offset of the futex mutex word within the shared page. */
pub const MUTEX_OFF: u64 = 0
/** COUNTER_OFF — byte offset of the shared 64-bit counter within the shared page. */
pub const COUNTER_OFF: u64 = 8
/** DONE_OFF — byte offset of the 32-bit completed-worker counter within the shared page. */
pub const DONE_OFF: u64 = 16

/**
 * raw_mmap — map `length` bytes of anonymous private read/write memory via the raw `mmap` syscall,
 * the shared page every worker's mutex/counter lives in. Returns the page-aligned base, or 0 when
 * the kernel refuses (a result in the `[-4095, -1]` `-errno` band).
 *
 * @param length  the mapping size in bytes (rounded up to whole pages by the kernel)
 * @return        the base address, or 0 on failure
 */
pub fn raw_mmap(length: u64): u64 {
    var r = teko::sys::syscall6(sys::SYS_MMAP, 0, length to i64,
        sys::PROT_READ | sys::PROT_WRITE,
        sys::MAP_PRIVATE | sys::MAP_ANONYMOUS, -1, 0)
    if r >= -4095 && r <= -1 { return 0 }
    r to u64
}

/**
 * worker — one contending thread: increment the shared counter `iters` times, each increment held
 * under the futex mutex, then bump the completed-worker word so the main thread's poll observes this
 * worker finished. `blk` reached this thread BY COPY across the spawn boundary (a scalar address into
 * the shared mmap page every thread of the process sees), so the counter it fights over is the same
 * physical word for every worker — a correct final total is the mutex's mutual-exclusion proof.
 *
 * @param blk    the shared page's base address (spawn-copied scalar)
 * @param iters  how many locked increments this worker performs
 * @return       nothing
 */
pub fn worker(blk: u64, iters: i64) {
    var mutex = blk + MUTEX_OFF
    var counter = blk + COUNTER_OFF
    var done = blk + DONE_OFF
    var i: i64 = 0
    loop {
        if i >= iters { break }
        mtx_lock(mutex)
        teko::mem::store_u64(counter, teko::mem::load_u64(counter) + 1)
        mtx_unlock(mutex)
        i = i + 1
    }
    _ = teko::sys::atomic_add_u32(done to i64, 1)
}
