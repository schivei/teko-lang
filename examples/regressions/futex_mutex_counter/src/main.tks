var blk = raw_mmap(4096)
if blk == 0 { exit(2) }
var s: i64 = 0
loop {
    if s >= WORKERS { break }
    spawn worker(blk, ITERS)
    s = s + 1
}
var tries: i64 = 0
loop {
    if tries >= POLL_LIMIT { exit(1) }
    if teko::sys::atomic_load_u32((blk + DONE_OFF) to i64) == WORKERS { break }
    tries = tries + 1
}
if teko::mem::load_u64(blk + COUNTER_OFF) == (WORKERS * ITERS) to u64 { exit(0) }
exit(1)
