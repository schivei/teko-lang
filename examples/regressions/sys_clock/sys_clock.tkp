# examples/regressions/sys_clock — the §16 C2 KEYSTONE fixture: proves the `teko::sys` module's
# per-`#os` curated constants survive the §17 prune with the LINUX literal values. A
# SELF-CONTAINED project (its own local copy of the two `CLOCK_*` `#os("linux")`/`#os("macos")`
# const pairs under `src/sys/sys.tks`), because the real `teko::sys` lives in the COMPILER's own
# project (root `teko`, reserved — no user project may claim it) and an external standalone
# project has no visibility into it — the `generic_sort`/`collections_fase1b`/`chan_dgram`
# precedent (`teko::sort`/`teko::cmp`/`teko::collections` are compiler-internal for the same
# reason). The local copy is a byte-for-byte structural mirror of `src/sys/sys.tks`, so building
# and running it exercises the identical `#os` prune mechanism the real module relies on.
name = "sys_clock"
source = "src"

[artifact]
kind = "binary"
