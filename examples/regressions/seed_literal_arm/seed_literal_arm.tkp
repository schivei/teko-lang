# examples/regressions/seed_literal_arm — o regressor comportamental da ADOPCAO CRUZADA de literal
# em braco de `match`.
#
# O defeito de origem (run 30613192858, nove pernas de artefacto vermelhas): `stage_rc_of_env`
# (src/build/project.tks) escrevia `match … { str as v => bp_parse_uint(v) to i32; error => 0 }`. O
# seed publicado v0.3.0.31-beta (commit 4e6c4e4b) nao cross-adopta o literal nu do braco `error`, e
# tipa a juncao como `i32 | i64` — recusando a funcao com "the function's final expression does not
# match its declared return type". A capacidade so entrou em c64178e9, DEPOIS do lancamento.
#
# A correccao anotou o literal (`0 to i32`). Este projecto prende que as DUAS grafias — a anotada,
# que o seed aceita, e a nua, que depende da adopcao cruzada do tip — produzem o MESMO valor na
# MESMA largura, que e a licenca de que a correccao minima nao mudou comportamento nenhum.
#
# O guarda que impede a reincidencia e o par `seed_hostile_arms_under`/
# `compiler_sources_carry_no_seed_hostile_match_arm` (src/build/fixture_guard{,_test}.tk*): ele varre
# `src/` e falha no nivel unitario. Este projecto e a metade comportamental do mesmo par.
name = "seed_literal_arm"
source = "src"

[artifact]
kind = "binary"
