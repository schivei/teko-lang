/**
 * run — open a manual region with `teko::mem::region_new` (native lowering
 * `tk_region_new(tk_region_root())`) and print a fixed line: reaching this print at all proves the
 * call lowered to the runtime primitives rather than the undefined `teko_teko__mem__region_new`
 * symbol the self-host link used to reject.
 *
 * @return void
 */
pub fn run() {
    let _r = teko::mem::region_new()
    teko::io::println("region_new ok")
}
