pub type Parsed<T> = struct { node: T; next: u64 }

pub type Leaf = struct { }

pub type Pair = struct { items: []@ValA() }

pub macro ValA() { lowering { Leaf | Pair } }

pub type Red = struct { }

pub type Blue = struct { }

pub macro ValB() { lowering { Red | Blue } }

pub type Wrap = struct { held: @ValA() }

fn kind_a(v: @ValA()): i64 {
    match v { Leaf as l => 1; Pair as p => 2 }
}

fn kind_b(v: @ValB()): i64 {
    match v { Red as r => 1; Blue as b => 2 }
}

pub fn field_readback(): i64 {
    var p = Parsed<@ValA()> { node = Leaf { }; next = 0 }
    var w = Wrap { held = p.node }
    kind_a(w.held)
}

pub fn slice_readback(): i64 {
    var empty: []@ValA() = []
    var p = Parsed<@ValA()> { node = Pair { items = empty }; next = 0 }
    var xs: []@ValA() = teko::list::empty()
    xs = teko::list::push(xs, p.node)
    xs.len to i64
}

pub fn distinct_insts(): i64 {
    var pa = Parsed<@ValA()> { node = Leaf { }; next = 0 }
    var pb = Parsed<@ValB()> { node = Red { }; next = 0 }
    kind_a(pa.node) * 10 + kind_b(pb.node)
}
