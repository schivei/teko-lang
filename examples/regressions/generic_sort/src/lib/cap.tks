pub type IEq = interface {
    operator __eq(left: self, right: self): bool
    operator __ne(left: self, right: self): bool
}

pub type IOrd = interface {
    operator __lt(left: self, right: self): bool
    operator __gt(left: self, right: self): bool
    operator __le(left: self, right: self): bool
    operator __ge(left: self, right: self): bool
}

pub type IHash = interface {
    fn hash(): u64
}

pub type NeByEq = trait {
    operator __ne(left: self, right: self): bool { !(left == right) }
}

pub type GtByLt = trait {
    operator __gt(left: self, right: self): bool { right < left }
}

pub type LeByLt = trait {
    operator __le(left: self, right: self): bool { !(right < left) }
}

pub type GeByLt = trait {
    operator __ge(left: self, right: self): bool { !(left < right) }
}

pub type StrKey = struct IEq & IHash & NeByEq & IOrd & GtByLt & LeByLt & GeByLt {
    key: str
    operator __eq(left: self, right: self): bool { left.key == right.key }
    operator __lt(left: self, right: self): bool { teko::runtime::str_compare(left.key, right.key) < 0 }
    fn hash(): u64 { teko::runtime::str_hash(self.key) }
}

pub type I64Key = struct IEq & IHash & NeByEq & IOrd & GtByLt & LeByLt & GeByLt {
    n: i64
    operator __eq(left: self, right: self): bool { left.n == right.n }
    operator __lt(left: self, right: self): bool { left.n < right.n }
    fn hash(): u64 {
        var v = self.n
        if v < 0 { return ((0 - (v + 1)) to u64) * 2 + 1 }
        (v to u64) * 2
    }
}

pub type Ver = struct IOrd & GtByLt & LeByLt & GeByLt {
    major: i64
    tag: i64
    operator __lt(left: self, right: self): bool { left.major < right.major }
}
