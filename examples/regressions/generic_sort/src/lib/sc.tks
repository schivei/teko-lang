fn ascending_i64(xs: []lib::I64Key): bool {
    var i: u64 = 1
    loop {
        if i >= xs.len { break }
        if !(xs[i - 1].n < xs[i].n) { return false }
        i++
    }
    true
}

fn checksum_i64(xs: []lib::I64Key): i64 {
    var acc: i64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        acc = acc + xs[i].n * ((i + 1) to i64)
        i++
    }
    acc
}

fn sort_i64keys(): i64 {
    var xs: []lib::I64Key = teko::list::empty()
    xs = teko::list::push(xs, lib::I64Key { n = 5 })
    xs = teko::list::push(xs, lib::I64Key { n = 1 })
    xs = teko::list::push(xs, lib::I64Key { n = 3 })
    xs = teko::list::push(xs, lib::I64Key { n = 2 })
    xs = teko::list::push(xs, lib::I64Key { n = 4 })
    var sorted = lib::sort<lib::I64Key>(xs)
    if !ascending_i64(sorted) { return -1 }
    checksum_i64(sorted)
}

fn ascending_str(xs: []lib::StrKey): bool {
    var i: u64 = 1
    loop {
        if i >= xs.len { break }
        if teko::runtime::str_compare(xs[i - 1].key, xs[i].key) > 0 { return false }
        i++
    }
    true
}

fn sort_strkeys(): bool {
    var xs: []lib::StrKey = teko::list::empty()
    xs = teko::list::push(xs, lib::StrKey { key = "c" })
    xs = teko::list::push(xs, lib::StrKey { key = "a" })
    xs = teko::list::push(xs, lib::StrKey { key = "banana" })
    xs = teko::list::push(xs, lib::StrKey { key = "apple" })
    xs = teko::list::push(xs, lib::StrKey { key = "b" })
    var sorted = lib::sort<lib::StrKey>(xs)
    ascending_str(sorted)
}

fn sort_versions_stable(): bool {
    var xs: []lib::Ver = teko::list::empty()
    xs = teko::list::push(xs, lib::Ver { major = 2; tag = 10 })
    xs = teko::list::push(xs, lib::Ver { major = 1; tag = 20 })
    xs = teko::list::push(xs, lib::Ver { major = 2; tag = 30 })
    xs = teko::list::push(xs, lib::Ver { major = 1; tag = 40 })
    xs = teko::list::push(xs, lib::Ver { major = 1; tag = 50 })
    var sorted = lib::sort<lib::Ver>(xs)
    var majors_ok = sorted[0].major == 1 && sorted[1].major == 1 && sorted[2].major == 1 && sorted[3].major == 2 && sorted[4].major == 2
    var tags_ok = sorted[0].tag == 20 && sorted[1].tag == 40 && sorted[2].tag == 50 && sorted[3].tag == 10 && sorted[4].tag == 30
    majors_ok && tags_ok
}

pub fn run_all() {
    var i64sum = sort_i64keys()
    if i64sum < 0 { exit(1) }
    if !sort_strkeys() { exit(2) }
    if !sort_versions_stable() { exit(3) }
    exit(i64sum to i32)
}
