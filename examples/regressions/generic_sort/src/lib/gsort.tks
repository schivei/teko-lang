/**
 * The fixture's self-contained copy of `teko::sort::sort<T: IOrd>` — a stable ascending merge sort
 * whose order is dispatched through the element type's `IOrd` conformance (`<=`/`<` lowering to
 * `operator __le`/`__lt` on `T`). Duplicated here because `teko::sort` is compiler-internal and not
 * visible to a user project (the capability_iface/collections_fase1b precedent). Proves the SAME
 * shape the stdlib ships: a FREE generic function over `[]T`, monomorphized per element type.
 */

/**
 * Stably merge two already-sorted `[]T` runs into one fresh sorted slice, ordering through `T: IOrd`
 * (`operator __le`, reached by `<=`). On a tie the `left` element is emitted first, giving the whole
 * sort its STABILITY. One arena-allocated output buffer, grown by `teko::list::push`; inputs are never
 * mutated.
 *
 * @param left   the left run, already sorted ascending
 * @param right  the right run, already sorted ascending
 * @return       a new slice holding every element of `left` and `right` in sorted, stable order
 */
fn merge_ord<T: IOrd>(left: []T, right: []T): []T {
    var out: []T = teko::list::empty()
    var i: u64 = 0
    var j: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if left[i] <= right[j] {
            out = teko::list::push(out, left[i])
            i++
            continue
        }
        out = teko::list::push(out, right[j])
        j++
    }
    loop { if i >= left.len { break }; out = teko::list::push(out, left[i]); i++ }
    loop { if j >= right.len { break }; out = teko::list::push(out, right[j]); j++ }
    out
}

/**
 * Top-down stable merge sort of the half-open range `xs[lo..hi)`, returning a fresh sorted slice with
 * the order dispatched through `T: IOrd`. Splits at the midpoint, sorts each half recursively, and
 * stably merges. `xs` is read only, never mutated.
 *
 * @param xs  the source slice (read only)
 * @param lo  the inclusive start of the range to sort
 * @param hi  the exclusive end of the range to sort (`lo <= hi <= xs.len`)
 * @return    a new slice holding `xs[lo..hi)` in ascending, stable order under `T: IOrd`
 */
fn msort_ord<T: IOrd>(xs: []T, lo: u64, hi: u64): []T {
    var out: []T = teko::list::empty()
    if hi - lo <= 1 {
        if hi - lo == 1 { out = teko::list::push(out, xs[lo]) }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = msort_ord(xs, lo, mid)
    var right = msort_ord(xs, mid, hi)
    merge_ord(left, right)
}

/**
 * Return a new slice holding `xs` sorted ascending, ordering ANY `IOrd`-conforming element type `T`
 * by dispatching `<=`/`<` through `T`'s `operator __le`/`__lt`. STABLE; `xs` is not mutated. The
 * fixture mirror of `teko::sort::sort<T: IOrd>`.
 *
 * @param xs  the `IOrd`-conforming elements to sort
 * @return    a new slice of `xs`'s elements in ascending, stable order under `T: IOrd`
 */
pub fn sort<T: IOrd>(xs: []T): []T {
    msort_ord(xs, 0, xs.len)
}
