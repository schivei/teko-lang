# match_universal_reject.tkr — the match-universal PHASE 1 REJECT host. Four match-over-class/interface
# violations live one per namespace under src/, and the single failing build reports all four
# diagnostics — the checker reports every diagnostic it finds rather than stopping at the first, so one
# build (cached across every scenario, `tkr_compile_fail_artifact`) pins them all. Each scenario below
# names its own. It has no successful build to sanitize/run.

Feature: match universal phase 1 reject — the checker rejects the illegal match-over-class/interface forms

  # (nonexhaustive_class_rejected) a sealed-class match covering only one of two concrete subclasses
  # with no catch-all is non-exhaustive.
  Scenario: nonexhaustive_class_rejected — a sealed class match missing a subclass with no catch-all is rejected
    When compilation fails
    Then diagnostic = "non-exhaustive `match` (cover all cases or add `_`)"

  # (when_only_class_rejected) a subclass covered ONLY by a `when`-guarded arm is not covered for
  # exhaustiveness (the guard may be false), and there is no unguarded fallback.
  Scenario: when_only_class_rejected — a guarded-only cover with no unguarded fallback is rejected
    When compilation fails
    Then diagnostic = "non-exhaustive `match` (cover all cases or add `_`)"

  # (iface_no_catchall_rejected) an interface is an OPEN set — a match naming only the known impls
  # with no catch-all is non-exhaustive.
  Scenario: iface_no_catchall_rejected — an interface match with no catch-all is rejected
    When compilation fails
    Then diagnostic = "non-exhaustive `match` (cover all cases or add `_`)"

  # (nonsubclass_arm_rejected) an arm whose left names a type that is not a subclass of the base is
  # not a legal discriminant.
  Scenario: nonsubclass_arm_rejected — an arm naming a non-subclass of the base is rejected
    When compilation fails
    Then diagnostic = "is not a subclass of"
