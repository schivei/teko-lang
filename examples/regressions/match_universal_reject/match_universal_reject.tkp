# examples/regressions/match_universal_reject — the match-universal PHASE 1 REJECT host. Four
# match-over-class/interface violations live one per namespace under src/, and the single failing build
# reports all four diagnostics, one per scenario in the .tkr: a non-exhaustive sealed-class match with
# no catch-all, a class match whose only cover of a subclass is GUARDED (`when` does not count toward
# exhaustiveness), an interface (open-set) match with no catch-all, and an arm whose left names a type
# that is not a subclass of the base. It has no successful build to sanitize/run.
name = "match_universal_reject"
source = "src"

[artifact]
kind = "binary"
