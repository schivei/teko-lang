/**
 * WoBase — an abstract base whose closed subclass set is `{WoA, WoB}`. A guarded arm does NOT count
 * toward covering its subclass (B.15), so a match whose only `WoA` cover is guarded and has no
 * unguarded fallback is non-exhaustive and must be rejected (match-universal phase 1).
 */
type WoBase = abstract class {
    /** k — a live base field. */
    pub k: i64
}

/**
 * WoA — the subclass covered ONLY by a guarded arm.
 */
type WoA = class WoBase {
    /** a — its own field. */
    pub a: i64
}

/**
 * WoB — the subclass covered by an unguarded arm.
 */
type WoB = class WoBase {
    /** b — its own field. */
    pub b: i64
}

/**
 * wo_bad — `WoA` is covered ONLY by a `when`-guarded arm and there is no unguarded catch-all, so the
 * guard could be false and leave `WoA` unmatched: the checker must reject this as non-exhaustive.
 *
 * @param x  the base-typed value
 * @return   never — the build fails
 */
fn wo_bad(x: WoBase): i64 {
    match x {
        WoA as v when v.a == 0 => 1
        WoB as w => w.b
    }
}
