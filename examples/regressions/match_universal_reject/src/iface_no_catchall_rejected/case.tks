/**
 * IcSpeaker — an INTERFACE (an OPEN set: impls may be unknown), so a match over an `IcSpeaker` value
 * REQUIRES an unguarded catch-all/bind-all. A match naming only the known impls with no catch-all is
 * non-exhaustive and must be rejected (match-universal phase 1).
 */
type IcSpeaker = interface {
    /** code — the impl's identifying value. */
    fn code(): i64
}

/**
 * IcDog — one concrete impl of `IcSpeaker`.
 */
type IcDog = class & IcSpeaker {
    /** n — its own field. */
    pub n: i64

    /**
     * code — this impl's identifying value.
     *
     * @return the field
     */
    pub fn code(): i64 { self.n }
}

/**
 * IcCat — a second concrete impl of `IcSpeaker`.
 */
type IcCat = class & IcSpeaker {
    /** m — its own field. */
    pub m: i64

    /**
     * code — this impl's identifying value.
     *
     * @return the field
     */
    pub fn code(): i64 { self.m }
}

/**
 * ic_bad — an interface (open-set) match naming both known impls but with NO catch-all: the open set
 * admits impls the match cannot see, so the checker must reject it as non-exhaustive.
 *
 * @param s  the interface-typed value
 * @return   never — the build fails
 */
fn ic_bad(s: IcSpeaker): i64 {
    match s {
        IcDog as d => 1
        IcCat as c => 2
    }
}
