/**
 * NxBase — an abstract base whose closed subclass set is `{NxA, NxB}`. A match covering only `NxA`
 * with no catch-all is non-exhaustive and must be rejected (match-universal phase 1).
 */
type NxBase = abstract class {
    /** k — a live base field. */
    pub k: i64
}

/**
 * NxA — the covered subclass.
 */
type NxA = class NxBase {
    /** a — its own field. */
    pub a: i64
}

/**
 * NxB — the UNCOVERED subclass whose omission makes the match non-exhaustive.
 */
type NxB = class NxBase {
    /** b — its own field. */
    pub b: i64
}

/**
 * nx_bad — a sealed-class match missing `NxB` and carrying no catch-all: the checker must reject it
 * as non-exhaustive.
 *
 * @param x  the base-typed value
 * @return   never — the build fails
 */
fn nx_bad(x: NxBase): i64 {
    match x {
        NxA as v => v.a
    }
}
