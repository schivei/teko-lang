/**
 * NsBase — an abstract base. An arm whose left names a type that is NOT a subclass of `NsBase` is not
 * a legal discriminant and must be rejected with a "not a subclass of" diagnostic (match-universal
 * phase 1's left-of-arm relation check).
 */
type NsBase = abstract class {
    /** k — a live base field. */
    pub k: i64
}

/**
 * NsA — a genuine subclass of `NsBase` (the legal arm).
 */
type NsA = class NsBase {
    /** a — its own field. */
    pub a: i64
}

/**
 * NsOther — an UNRELATED class, no relation to `NsBase`; naming it on the left of an `NsBase` match
 * is the rejected construct.
 */
type NsOther = class {
    /** o — its own field. */
    pub o: i64
}

/**
 * ns_bad — the `NsOther as z` arm names a type that does not subclass `NsBase`, so the checker must
 * reject it even though a catch-all is present.
 *
 * @param x  the base-typed value
 * @return   never — the build fails
 */
fn ns_bad(x: NsBase): i64 {
    match x {
        NsA as v => v.a
        NsOther as z => z.o
        _ => 0
    }
}
