# examples/regressions/overload_resolve — the project-regressor for §9 A method/function overloading.
#
# What it pins, and what it costs to break. Four resolution paths, each tagged with distinct
# arithmetic so a relapse MOVES the exit witness instead of passing in silence:
#   * A1 — resolution by positional argument TYPE. `area(3)` runs the `i64` body (9), `area(3.0)`
#     runs the `f64` body (109). Keying the call on the wrong overload changes both numbers.
#   * A2 — discrimination by parameter NAME under defaults (ruling 5 / §9 C). `mk(width = 5)` = 10,
#     `mk(height = 5)` = 15; the two signatures have IDENTICAL parameter types, so only the name
#     tells them apart — and only the name-bearing symbol suffix keeps their bodies distinct.
#   * A3 — an EXACT match beats a WIDENING one (anti-spurious-ambiguity). With `a: i32`, `pick(a)`
#     picks `pick(i32)` (1), never `pick(i64)` (2) and never an ambiguity error.
#   * A4 — an explicit cast disambiguates (ruling 4). `cast_pick(0 to u32)` runs the `u32` body (7).
#
# The witness is the sum 9 + 109 + 10 + 15 + 1 + 7 = 151. Every body's tag is chosen so no other
# combination of the eight overloads reaches it; a mis-resolution lands on a different total.
#
# The definitions THEMSELVES are never rejected (ruling 1: defining a same-named function is always
# allowed) — so this project ALSO proves the overload-set definitions compile and link, which is the
# other half of the feature.
name = "overload_resolve"
source = "src"

[artifact]
kind = "binary"
