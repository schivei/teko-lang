/**
 * area — the integer overload (A1): the square of an `i64` side.
 *
 * @param w  the side length as an integer
 * @return   `w * w`
 */
pub fn area(w: i64): i64 { w * w }

/**
 * area — the float overload (A1): the square of an `f64` side, truncated and tagged `+100` so the
 * float branch is legible in the witness total. Distinct from the integer overload by argument TYPE.
 *
 * @param w  the side length as a float
 * @return   `(w * w) to i64 + 100`
 */
pub fn area(w: f64): i64 { ((w * w) to i64) + 100 }

/**
 * mk — the width-named overload (A2). Its parameter TYPE is identical to `mk(height)`, so the
 * overloads differ ONLY by parameter name under defaults (ruling 5 / §9 C): `mk(width = 5)` selects
 * this body, and its name-bearing symbol suffix keeps it distinct from its twin at link time.
 *
 * @param width  the width, defaulting to 1
 * @return       `width * 2`
 */
pub fn mk(width: i64 = 1): i64 { width * 2 }

/**
 * mk — the height-named overload (A2): the type-identical twin of `mk(width)`, selected by
 * `mk(height = 5)`.
 *
 * @param height  the height, defaulting to 1
 * @return        `height * 3`
 */
pub fn mk(height: i64 = 1): i64 { height * 3 }

/**
 * pick — the exact-match overload (A3): an `i32` argument selects this body outright, never the
 * widened `i64` overload.
 *
 * @param x  an `i32` value
 * @return   1
 */
pub fn pick(x: i32): i64 { 1 }

/**
 * pick — the widened overload (A3): reachable from an `i64` argument, but LOSES to an exact `i32`
 * match, so `pick(a: i32)` never returns 2.
 *
 * @param x  an `i64` value
 * @return   2
 */
pub fn pick(x: i64): i64 { 2 }

/**
 * cast_pick — the `i32` overload (A4): the default target of a bare integer, but not of an explicit
 * `to u32` cast.
 *
 * @param x  an `i32` value
 * @return   100
 */
pub fn cast_pick(x: i32): i64 { 100 }

/**
 * cast_pick — the `u32` overload (A4): selected only via an explicit cast at the call site
 * (`cast_pick(0 to u32)`), which resolves the otherwise-ambiguous integer literal (ruling 4).
 *
 * @param x  a `u32` value
 * @return   7
 */
pub fn cast_pick(x: u32): i64 { 7 }

/**
 * run — exercises every §9 A resolution path once and sums each body's distinct tag into the single
 * witness number `151`, which only the correct resolution of all four paths produces.
 *
 * @return  9 + 109 + 10 + 15 + 1 + 7 = 151 when every overload resolved to the intended body
 */
pub fn run(): i64 {
    var a: i32 = 4
    var total: i64 = 0
    total = total + area(3)
    total = total + area(3.0)
    total = total + mk(width = 5)
    total = total + mk(height = 5)
    total = total + pick(a)
    total = total + cast_pick(0 to u32)
    total
}
