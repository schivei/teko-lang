pub fn area(w: i64): i64 { w * w }

pub fn area(w: f64): i64 { ((w * w) to i64) + 100 }

pub fn mk(width: i64 = 1): i64 { width * 2 }

pub fn mk(height: i64 = 1): i64 { height * 3 }

pub fn pick(x: i32): i64 { 1 }

pub fn pick(x: i64): i64 { 2 }

pub fn cast_pick(x: i32): i64 { 100 }

pub fn cast_pick(x: u32): i64 { 7 }

pub fn run(): i64 {
    var a: i32 = 4
    var total: i64 = 0
    total = total + area(3)
    total = total + area(3.0)
    total = total + mk(width := 5)
    total = total + mk(height := 5)
    total = total + pick(a)
    total = total + cast_pick(0 to u32)
    total
}
