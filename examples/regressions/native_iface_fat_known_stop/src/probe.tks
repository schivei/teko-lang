/**
 * The fat-pointer result the native backend's CALL ABI does not have: a `str`-returning VIRTUAL
 * method reached through its base. Byte-for-byte the body from
 * `examples/regressions/bulk/src/q005_base_widened_from_a_derived_class_null`, authored 2026-07-24
 * (`1201088`) and green through the C route ever since.
 *
 * The null-union is INCIDENT here, not causal, and neither is the `match` any more: the
 * `match`-VALUE producer this file used to pin landed with 0.3.1.0 degrau 5 (`lower_match_fat`).
 * What stops now is one level in — `v.speak()` dispatches through a vtable and `lower_call_fat`
 * refuses a fat result on that path. Give `speak` a `u64` return instead of `str` and the same
 * dispatch lowers.
 */
type Animal_sbmd = virtual class {
    pub name: str
    pub virtual fn speak(self) -> str { "..." }
}
type Dog_sbmd = class Animal_sbmd {
    pub fn make(n: str) -> Dog_sbmd { Dog_sbmd { name = n } }
    pub override fn speak(self) -> str { "Woof" }
}

/** speak_or — the failing surface: a `str`-valued VIRTUAL call inside a match arm. @return the greeting or `fallback` */
fn speak_or(a: Animal_sbmd | null, fallback: str) -> str {
    match a { Animal_sbmd as v => v.speak(); null => fallback }
}

/** probe — both placements: a derived instance widened to its base, and the absent one. @return 42 the day it lowers */
pub fn probe() -> u64 {
    let present: Animal_sbmd | null = Dog_sbmd::make("Rex")
    let absent: Animal_sbmd | null = null
    let r1 = speak_or(present, "?")
    let r2 = speak_or(absent, "?")
    if r1 == "Woof" && r2 == "?" { 42 to u64 } else { 1 to u64 }
}
