# examples/regressions/block_expr — the §9 E ACCEPT host (Block-B in expression position, ruling 7).
# A brace group in EXPRESSION position is a value-producing block whose TRAILING expression is its
# value, running INLINE in the enclosing frame (not a closure — no capture, no allocation). Each case
# names itself and asserts its own value (`scenario`), so a relapse names itself in both files instead
# of aliasing into a shared exit code. The same program runs on BOTH backends (native corpus + the
# own-vs-C differential), witnessing that Block-B lowers identically through the C GNU statement-expression
# and the native inline-block path:
#   * a Block-B's trailing expression is its value             — block_value_trailing_expr = 42
#   * a Block-B nests inside another Block-B                    — block_nested_value = 16
#   * a Block-B reads AND writes an enclosing var, inline       — block_runs_inline_in_frame = 84
#   * a Block-B stands in argument position                     — block_as_call_argument = 11
#   * a Block-B and §9 B construction coexist unambiguously     — block_and_construction_coexist = 5
#   * a closure body is itself a Block-B (spine anchor)         — closure_body_block_anchor = 41
#   * a closure captures by COPY — snapshot (spine anchor)      — capture_by_copy_snapshot = 11
name = "block_expr"
source = "src"

[artifact]
kind = "binary"
