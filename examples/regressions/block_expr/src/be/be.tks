type Point = struct {
    x: i64
    y: i64
}

fn bump(x: i64): i64 { x + 1 }

pub fn block_value_trailing_expr(): i64 {
    var r = { var a = 20; var b = 22; a + b }
    r
}

pub fn block_nested_value(): i64 {
    var r = { var x = { var y = 10; y + 5 }; x + 1 }
    r
}

pub fn block_runs_inline_in_frame(): i64 {
    var acc = 0
    var r = { acc = acc + 42; acc }
    r + acc
}

pub fn block_as_call_argument(): i64 {
    bump({ var z = 5; z * 2 })
}

pub fn block_and_construction_coexist(): i64 {
    var p = Point { x = 1; y = 2 }
    var q = { 1 + 1 }
    p.x + p.y + q
}

pub fn closure_body_block_anchor(): i64 {
    var f: func<i64, i64> = (x) => { var d = x * 2; d + 1 }
    f(20)
}

pub fn capture_by_copy_snapshot(): i64 {
    var n = 10
    var g: func<i64> = () => n + 1
    n = 99
    g()
}
