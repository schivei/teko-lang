/**
 * Point — a two-field struct constructed with a §9 B type-prefixed literal (`Point { … }`), used to
 * witness that construction and a leading-`{` Block-B parse UNAMBIGUOUSLY in the same function.
 *
 * @field x  the first coordinate
 * @field y  the second coordinate
 */
type Point = struct {
    /** x — the first coordinate. */
    x: i64
    /** y — the second coordinate. */
    y: i64
}

/**
 * bump — a one-argument function used to witness a Block-B standing in argument position.
 *
 * @param x  the value to increment
 * @return   `x + 1`
 */
fn bump(x: i64): i64 { x + 1 }

/**
 * block_value_trailing_expr — a Block-B's value is its TRAILING expression (§9 E, ruling 7): the two
 * inner bindings run for their bindings, then `a + b` is the block's result.
 *
 * @return  42
 */
pub fn block_value_trailing_expr(): i64 {
    var r = { var a = 20; var b = 22; a + b }
    r
}

/**
 * block_nested_value — a Block-B nests inside another Block-B; the inner block's value (`y + 5` = 15)
 * binds `x`, and the outer block's value is `x + 1`.
 *
 * @return  16
 */
pub fn block_nested_value(): i64 {
    var r = { var x = { var y = 10; y + 5 }; x + 1 }
    r
}

/**
 * block_runs_inline_in_frame — a Block-B runs INLINE in the enclosing frame (not a closure): it READS
 * and WRITES the enclosing `acc`, and that write is visible AFTER the block. `acc` becomes 42, the
 * block's value `r` is 42, and their sum is 84 — a copy-capturing closure could neither observe nor
 * persist the write.
 *
 * @return  84
 */
pub fn block_runs_inline_in_frame(): i64 {
    var acc = 0
    var r = { acc = acc + 42; acc }
    r + acc
}

/**
 * block_as_call_argument — a Block-B stands in argument position: `bump({ … })` evaluates the block to
 * 10, then `bump` returns 11.
 *
 * @return  11
 */
pub fn block_as_call_argument(): i64 {
    bump({ var z = 5; z * 2 })
}

/**
 * block_and_construction_coexist — a §9 B construction (`Point { … }`, type-prefixed) and a leading-`{`
 * Block-B (`{ 1 + 1 }`) coexist in the same function without ambiguity: a `{` with no path before it is
 * always a block. `p.x + p.y + q` = 1 + 2 + 2.
 *
 * @return  5
 */
pub fn block_and_construction_coexist(): i64 {
    var p = Point { x = 1; y = 2 }
    var q = { 1 + 1 }
    p.x + p.y + q
}

/**
 * closure_body_block_anchor — a closure body is itself a Block-B (the spine that already landed): the
 * trailing `d + 1` is the closure's result. `f(20)` computes `d = 40`, then 41.
 *
 * @return  41
 */
pub fn closure_body_block_anchor(): i64 {
    var f: func<i64, i64> = (x) => { var d = x * 2; d + 1 }
    f(20)
}

/**
 * capture_by_copy_snapshot — a closure captures its free variable BY COPY (§9 E capture semantics,
 * ratified: copy + `ref` for shared mutation). `g` snapshots `n` at 10; a later `n = 99` does NOT
 * reach the snapshot, so `g()` returns 11.
 *
 * @return  11
 */
pub fn capture_by_copy_snapshot(): i64 {
    var n = 10
    var g: func<i64> = () => n + 1
    n = 99
    g()
}
