/**
 * Circ — a struct case of the grouped inline unions this fixture exercises (§9.D a/b).
 *
 * @field r  a payload the arm reads
 */
type Circ = struct { r: i64 }

/**
 * Sq — a second struct case of the grouped inline unions (§9.D a/b).
 *
 * @field s  a payload the arm reads
 */
type Sq = struct { s: i64 }

/**
 * mk_circ — a `Circ` widened into the inline union `Circ | Sq` (a union in return position).
 *
 * @return  a `Circ` as a `Circ | Sq`
 */
fn mk_circ(): Circ | Sq { Circ { r = 5 } }

/**
 * mk_sq — a `Sq` widened into the inline union `Circ | Sq`.
 *
 * @return  a `Sq` as a `Circ | Sq`
 */
fn mk_sq(): Circ | Sq { Sq { s = 9 } }

/**
 * kind_at — the arm ordinal (1 for `Circ`, 2 for `Sq`) of the element at `i` of a GROUPED-union slice
 * `[](Circ | Sq)` (§9.D a): the grouped type in a slice-element position parses and matches per case.
 *
 * @param xs  a slice of the grouped inline union
 * @param i   the index to classify
 * @return    1 for a `Circ` element, 2 for a `Sq`
 */
fn kind_at(xs: [](Circ | Sq), i: u64): i64 {
    match xs[i] { Circ as c => 1; Sq as q => 2 }
}

/**
 * grouped_slice_probe — build a `[](Circ | Sq)` and classify its two elements: `Circ` then `Sq`, so the
 * result `1 * 10 + 2` = 12 encodes BOTH arm ordinals in order (§9.D a).
 *
 * @return  12
 */
pub fn grouped_slice_probe(): i64 {
    var xs: [](Circ | Sq) = [ mk_circ(), mk_sq() ]
    kind_at(xs, 0) * 10 + kind_at(xs, 1)
}

/**
 * slice_len — the length of a grouped-union slice passed THROUGH a signature (§9.D b): the parameter's
 * `[](Circ | Sq)` typedef name (USE) must equal the one the caller built (DECL) — byte-agreement, else
 * the seam would not link.
 *
 * @param xs  the grouped-union slice
 * @return    its element count
 */
fn slice_len(xs: [](Circ | Sq)): i64 { xs.len to i64 }

/**
 * byteagree_probe — build a `[](Circ | Sq)` in one function and consume it through `slice_len`'s
 * signature in another: the value crossing that seam proves the DECL and USE typedefs agree (§9.D b).
 *
 * @return  3
 */
pub fn byteagree_probe(): i64 {
    var xs: [](Circ | Sq) = [ mk_circ(), mk_sq(), mk_circ() ]
    slice_len(xs)
}

/**
 * single_collapse_probe — a single-member group `(Circ)` collapses to exactly `Circ` (no needless
 * union): a `Circ` value flows into a `(Circ)`-typed binding and its field reads back (§9.D a, M.5).
 *
 * @return  7
 */
pub fn single_collapse_probe(): i64 {
    var c: (Circ) = Circ { r = 7 }
    c.r
}

/**
 * null_order_probe — a `[](Circ | null)` and a `[](null | Circ)` name the SAME typedef (both
 * null-normalize), so a value of one flows into a binding of the other and interoperates (§9.D b): the
 * order the null is written does not fork the mangle.
 *
 * @return  4
 */
pub fn null_order_probe(): i64 {
    var a: [](Circ | null) = [ Circ { r = 4 }, null ]
    var b: [](null | Circ) = a
    match b[0] { Circ as c => c.r; null => 0 }
}
