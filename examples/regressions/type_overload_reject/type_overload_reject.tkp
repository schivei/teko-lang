# examples/regressions/type_overload_reject — the §9 B type-overload REJECT host. Five illegal
# type-overload/construction forms live one per namespace under src/, and the single failing build
# reports every diagnostic it finds (the compiler does not stop at the first) — one per scenario in
# the .tkr: two same-arity declarations differing only by constraint, a cross-kind same-arity pair,
# a partially-applied generic, a bare use of a generic, and a `.{ … }` with no target type. It has no
# successful build to sanitize/run (it mirrors match_universal_reject / properties_reject).
name = "type_overload_reject"
source = "src"

[artifact]
kind = "binary"
