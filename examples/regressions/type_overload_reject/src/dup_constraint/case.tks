/**
 * Marker — an empty interface used only as a type-parameter constraint atom below.
 */
type Marker = interface { }

/**
 * Foo<T> — the first arity-1 declaration of `Foo` (unconstrained).
 */
type Foo<T> = struct {
    /** x — the generic field. */
    x: T
}

/**
 * Foo<T: Marker> — a SECOND arity-1 declaration of `Foo`, differing ONLY by a constraint. Ruling 2:
 * the constraint NEVER disambiguates, so this is a same-arity duplicate and must be rejected at the
 * definition.
 */
type Foo<T: Marker> = struct {
    /** x — the generic field. */
    x: T
}
