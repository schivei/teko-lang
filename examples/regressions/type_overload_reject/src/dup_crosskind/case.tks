/**
 * Bar<T> — an arity-1 STRUCT declaration of `Bar`.
 */
type Bar<T> = struct {
    /** x — the generic field. */
    x: T
}

/**
 * Bar<T> — an arity-1 CLASS declaration of the SAME name and arity. Ruling 2: cross-kind collides
 * through the same `(namespace, name, arity)` key, so this must be rejected at the definition.
 */
type Bar<T> = class {
    /** x — the generic field. */
    intern x: T
}
