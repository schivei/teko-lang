/**
 * Qux<T> — an arity-1 generic struct with NO arity-0 sibling.
 */
type Qux<T> = struct {
    /** x — the generic field. */
    x: T
}

/**
 * bare — construct `Qux` with a BARE prefix. Ruling 7: a bare prefix is arity-0 always and never
 * borrows the arity of the generic, so with no arity-0 `Qux` this is a diagnosed error naming the fix.
 *
 * @return unreachable — the construction is rejected
 */
fn bare(): i64 {
    var q = Qux { x = 1 }
    0
}
