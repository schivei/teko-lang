/**
 * Cell — an arity-0 struct, present only so `self { … }` has a plausible shape to construct.
 */
type Cell = struct {
    /** a — the single field. */
    a: i64
}

/**
 * free_self — use `self { … }` in a FREE function, with no enclosing type. Ruling 5: `self { … }` is
 * a type-INITIALIZATION only valid inside a method, so this must be rejected.
 *
 * @return unreachable — the construction is rejected
 */
fn free_self(): i64 {
    var c = self { a = 1 }
    0
}
