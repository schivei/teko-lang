/**
 * Baz<T, U> — an arity-2 generic struct.
 */
type Baz<T, U> = struct {
    /** x — the first generic field. */
    x: T
    /** y — the second generic field. */
    y: U
}

/**
 * partial — apply `Baz` with ONE type-argument (`Baz<i64>`). Ruling 3: there is no partial
 * application, so an arity-1 reference to the arity-2 `Baz` is an arity error.
 *
 * @return unreachable — the construction is rejected
 */
fn partial(): i64 {
    var b = Baz<i64> { x = 1 }
    b.x
}
