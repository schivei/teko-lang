/**
 * Cell — an arity-0 struct, present only so `.{ … }` has a plausible shape to construct.
 */
type Cell = struct {
    /** a — the single field. */
    a: i64
}

/**
 * dot_no_target — a `.{ … }` bound to an UN-annotated `var` has no target type in its slot (§4.1).
 * The target comes ONLY from the immediate slot, never by back-flow, so this is a compile error. (It
 * replaces the retired `self { … }`-outside-a-method reject: with `self { … }` removed, that form is a
 * parse error everywhere and its dedicated reject moved to `self_ctor_removed_err`.)
 *
 * @return unreachable — the construction is rejected
 */
fn dot_no_target(): i64 {
    var c = .{ a = 1 }
    c.a
}
