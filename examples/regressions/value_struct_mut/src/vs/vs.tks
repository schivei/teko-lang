pub type Counter = struct {
    n: i64
    pub fn bump() { self.n = self.n + 1 }
}

pub type Slot = struct {
    _v: i64
    pub fn v(): i64 { return self._v }
    pub fn set_v(n: i64) { self._v = n }
}

fn reset(ref c: Counter) { c = Counter { n = 0 } }

pub fn a1_probe(): i64 {
    var c = Counter { n = 0 }
    c.bump()
    c.bump()
    return c.n
}

pub fn a2_probe(): i64 {
    var a = Counter { n = 5 }
    var b = a
    b.bump()
    return a.n * 10 + b.n
}

pub fn a3_probe(): i64 {
    var s = Slot { _v = 0 }
    s.set_v(7)
    return s.v()
}

pub fn a4_probe(): i64 {
    var c = Counter { n = 9 }
    var before = c.n
    reset(c)
    return before * 10 + c.n
}
