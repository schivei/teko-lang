/**
 * box — the base signature the reject calls exercise.
 *
 * @param w  the required leading argument
 * @param h  the first defaulted argument, default 2
 * @param d  the second defaulted argument, default 3
 * @return   `w * 100 + h * 10 + d`
 */
fn box(w: i64, h: i64 = 2, d: i64 = 3): i64 { w * 100 + h * 10 + d }

/**
 * call — the RETIRED `=` naming surface. §9 C ruling 2 seals `:=` as the only named-argument marker;
 * `box(w = 5)` is no longer a named call and cannot parse (assignment is statement-only).
 *
 * @return  unreachable — the call fails to parse
 */
fn call(): i64 { box(w = 5) }
