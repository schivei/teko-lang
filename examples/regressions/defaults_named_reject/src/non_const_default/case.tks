/**
 * side — a runtime nullary function, used as an illegal default.
 *
 * @return  42
 */
fn side(): i64 { 42 }

/**
 * f — a default that is a RUNTIME CALL, not a compile-time constant. §9 C ruling 1: a default is
 * materialized at every call site, so it must be a compile-time constant expression.
 *
 * @param x  a parameter whose default calls a runtime function — the illegal form
 * @return   unreachable — the declaration is rejected
 */
fn f(x: i64 = side()): i64 { x }
