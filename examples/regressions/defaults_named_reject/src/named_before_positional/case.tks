/**
 * box — the base signature the reject calls exercise.
 *
 * @param w  the required leading argument
 * @param h  the first defaulted argument, default 2
 * @param d  the second defaulted argument, default 3
 * @return   `w * 100 + h * 10 + d`
 */
fn box(w: i64, h: i64 = 2, d: i64 = 3): i64 { w * 100 + h * 10 + d }

/**
 * call — a POSITIONAL argument after a `:=` named one. §9 C ruling 2: once naming starts, every
 * remaining argument must be named.
 *
 * @return  unreachable — the call is rejected
 */
fn call(): i64 { box(w := 1, 2) }
