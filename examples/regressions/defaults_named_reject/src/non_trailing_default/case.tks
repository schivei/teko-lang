/**
 * f — a default-valued parameter FOLLOWED by a non-defaulted, non-`params` one. §9 C ruling 1 is
 * trailing-only: once a parameter defaults, every later parameter must default too (or be `params`).
 *
 * @param a  a defaulted leading parameter
 * @param b  a required parameter after a default — the illegal form
 * @return   unreachable — the declaration is rejected
 */
fn f(a: i64 = 1, b: i64): i64 { a + b }
