# defaults_named_reject.tkr — the §9 C REJECT host. Seven illegal defaults / `:=` named-argument
# forms live one per namespace under src/, and the single failing build reports every diagnostic it
# finds (the compiler reports all diagnostics rather than stopping at the first — parse-stage and
# checker-stage alike), one per scenario below. It has no successful build to sanitize/run. `:=` is
# the ONLY named-argument marker (ruling 2); named args are trailing and target a real parameter once
# (rulings 1 & 2); a default is a compile-time constant (ruling 1).

Feature: §9 C defaults + named-args reject — the compiler rejects the illegal defaults / `:=` forms

  # (non_trailing_default) a required parameter after a defaulted one — defaults are trailing-only
  # (ruling 1).
  Scenario: non_trailing_default — a required parameter after a default is rejected
    When compilation fails
    Then diagnostic = "defaults are trailing-only"

  # (named_before_positional) a positional argument after a `:=` named one — once naming starts,
  # every remaining argument must be named (ruling 2).
  Scenario: named_before_positional — a positional after a named argument is rejected
    When compilation fails
    Then diagnostic = "a named argument must be followed only by other named arguments"

  # (unknown_named) a `:=` naming a parameter that does not exist (ruling 2).
  Scenario: unknown_named — a `:=` naming an unknown parameter is rejected
    When compilation fails
    Then diagnostic = "unknown named argument"

  # (named_collides_positional) a `:=` naming a parameter already supplied positionally (ruling 2).
  Scenario: named_collides_positional — a named argument colliding with a positional is rejected
    When compilation fails
    Then diagnostic = "already provided positionally"

  # (missing_required) omit the required leading argument (ruling 1).
  Scenario: missing_required — a missing required argument is rejected
    When compilation fails
    Then diagnostic = "missing required argument"

  # (retired_equals_naming) the retired `=` naming surface — `box(w = 5)` no longer parses as a
  # named call, since `:=` is the only marker (ruling 2).
  Scenario: retired_equals_naming — the retired `=` naming surface fails to parse
    When compilation fails
    Then diagnostic = "expected ')' to close the argument list"

  # (non_const_default) a default that is a runtime call, not a compile-time constant (ruling 1).
  Scenario: non_const_default — a non-const default is rejected
    When compilation fails
    Then diagnostic = "must be a compile-time constant expression"
