# examples/regressions/defaults_named_reject — the §9 C REJECT host (parameter defaults + `:=` named
# arguments). Seven illegal forms live one per namespace under src/, and the single failing build
# reports every diagnostic it finds (the compiler does not stop at the first — parse-stage and
# checker-stage diagnostics are both collected): a non-trailing default, a positional after a named
# argument, an unknown named argument, a named argument colliding with a positional, a missing
# required argument, the retired `=` naming surface, and a non-const default. It has no successful
# build to sanitize/run (it mirrors type_overload_reject / properties_reject).
name = "defaults_named_reject"
source = "src"

[artifact]
kind = "binary"
