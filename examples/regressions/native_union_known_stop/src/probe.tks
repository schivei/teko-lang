/**
 * probe — the SHAPE the native backend cannot lower today, kept EXECUTABLE as a pinned known-stop.
 *
 * Byte-for-byte the body that lived at `examples/regressions/bulk/src/
 * q001_scalar_u64_null_present_and_absent`, which itself is byte-for-byte the `Given source inline`
 * block authored on 2026-07-24 (`1201088`, "popula regressor.tkr com a matriz null-union completa").
 * The code has never changed; only its address has.
 *
 * @return the sum of the two narrowed values (42 — asserted the day this promotes)
 */
pub fn probe() -> u64 {
    let present: u64 | null = 40
    let absent: u64 | null = null
    let rp = match present { u64 as v => v; null => 0 to u64 }
    let ra = match absent { u64 as v => v; null => 2 to u64 }
    rp + ra
}
