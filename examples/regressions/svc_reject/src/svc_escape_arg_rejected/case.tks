/**
 * A singleton service for the escape-arg case.
 *
 * @since 0.3.1
 */
type AClk = service singleton {
    /** @return self  a fresh instance. */
    pub static fn ctor(): AClk { return AClk { } }
    /** @return i64  the instant. */
    pub fn now(): i64 { return 1 }
}

/**
 * consume — an ordinary function taking an `AClk`.
 *
 * @param c  the service value
 * @return i64  its instant
 */
pub fn consume(c: AClk): i64 { return c.now() }

/**
 * entry — PASSING a claimed service value as an argument is rejected (§7 escape).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return consume(svc<AClk>()) }
