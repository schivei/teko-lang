/**
 * A PLAIN interface (no `& IService`) does not satisfy the `svc<T: IService>` constraint — the
 * historic crash case, now a clean compile-time type error.
 *
 * @since 0.3.1
 */
type PlainP = interface {
    /** @return i64  a value. */
    fn f(): i64
}

/**
 * entry — `svc<PlainP>(key)` over a plain interface is rejected (§7).
 *
 * @param key  a runtime key
 * @return i64  never — the build fails
 */
pub fn entry(key: str): i64 { return svc<PlainP>(key).f() }
