/**
 * A service-contract interface for the const-key-miss case.
 *
 * @since 0.3.1
 */
type MG = interface & IService {
    /** @return i64  the greeting. */
    fn greet(): i64
}

/**
 * The only provider of `MG`, keyed by its bare name `Only`.
 *
 * @since 0.3.1
 */
type Only = service singleton & MG {
    /** @return self  a fresh instance. */
    pub static fn ctor(): Only { return Only { } }
    /** @return i64  one. */
    pub fn greet(): i64 { return 1 }
}

/**
 * entry — a CONSTANT key with no registered provider is a compile-time miss (§7 D6).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return svc<MG>("Missing").greet() }
