/**
 * A plain struct is not a service and does not satisfy IService.
 *
 * @since 0.3.1
 */
type PlainS = struct {
    /** a field. */
    x: i64
}

/**
 * entry — `svc<PlainS>()` over a non-service, non-IService type is rejected (§7).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 { return svc<PlainS>().x }
