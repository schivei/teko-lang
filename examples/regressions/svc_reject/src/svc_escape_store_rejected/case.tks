/**
 * A singleton service for the escape cases.
 *
 * @since 0.3.1
 */
type SClock = service singleton {
    /** @return self  a fresh instance. */
    pub static fn ctor(): SClock { return SClock { } }
    /** @return i64  the instant. */
    pub fn now(): i64 { return 1 }
}

/**
 * entry — STORING a claimed service value into a variable by assignment is rejected (§7 escape).
 *
 * @return i64  never — the build fails
 */
pub fn entry(): i64 {
    var c = SClock::ctor()
    c = svc<SClock>()
    return c.now()
}
