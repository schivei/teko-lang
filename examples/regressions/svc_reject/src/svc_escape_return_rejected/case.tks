/**
 * A singleton service for the escape-return case.
 *
 * @since 0.3.1
 */
type RClk = service singleton {
    /** @return self  a fresh instance. */
    pub static fn ctor(): RClk { return RClk { } }
    /** @return i64  the instant. */
    pub fn now(): i64 { return 1 }
}

/**
 * entry — RETURNING a claimed service value is rejected (§7 escape).
 *
 * @return RClk  never — the build fails
 */
pub fn entry(): RClk { return svc<RClk>() }
