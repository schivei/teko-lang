# svc_reject.tkr — the §7 DI reject channel: service/svc violations, one per namespace under src/,
# reported by a single failing build. `svc_plain_interface_rejected` is the crash anti-regression: the
# historic dual-registry / ungated locator SIGSEGV'd on `svc<PlainInterface>`; it is now a clean type
# error, proving the root-cause fix (the checker's folded type table IS the sole provider registry).
# `svc_conflict_same_type_same_key_rejected_{a,b}` and `iface_static_instance_mismatch_rejected` close
# GAP-A/GAP-D of the DI-completion crumb plan (docs/design/di-completion-crumb-plan.md).

Feature: svc_reject — §7 dependency injection rejects non-IService targets, unsealed services, missing ctor, escape, and const-key misses

  Scenario: svc_plain_interface_rejected
    When compilation fails
    Then diagnostic = "svc<T> requires T to satisfy IService — a 'service' type, or an 'interface & IService'; 'PlainP' does not"

  Scenario: svc_non_iservice_rejected
    When compilation fails
    Then diagnostic = "svc<T> requires T to satisfy IService — a 'service' type, or an 'interface & IService'; 'PlainS' does not"

  Scenario: service_virtual_rejected
    When compilation fails
    Then diagnostic = "a service is always sealed; write 'type N = service <lifetime> { … }' (no 'virtual'/'abstract')"

  Scenario: service_abstract_rejected
    When compilation fails
    Then diagnostic = "a service is always sealed; write 'type N = service <lifetime> { … }' (no 'virtual'/'abstract')"

  Scenario: service_no_ctor_rejected
    When compilation fails
    Then diagnostic = "a service must conform to IService: declare 'static fn ctor(): self'"

  Scenario: svc_escape_store_rejected
    When compilation fails
    Then diagnostic = "a claimed service value is arena-bounded: it may not be stored, passed as an argument, or returned — re-claim it with svc<T>() where needed"

  Scenario: svc_escape_arg_rejected
    When compilation fails
    Then diagnostic = "a claimed service value is arena-bounded: it may not be stored, passed as an argument, or returned — re-claim it with svc<T>() where needed"

  Scenario: svc_escape_return_rejected
    When compilation fails
    Then diagnostic = "a claimed service value is arena-bounded: it may not be stored, passed as an argument, or returned — re-claim it with svc<T>() where needed"

  Scenario: svc_missing_const_key_rejected
    When compilation fails
    Then diagnostic = "svc<MG>(\"Missing\"): no service provider registered under that key"

  Scenario: svc_conflict_same_type_same_key_rejected
    When compilation fails
    Then diagnostic = "duplicate service registration for 'G' under key 'EnHi': same-type-same-key collides at compile time (distinct keys coexist)"

  Scenario: iface_static_instance_mismatch_rejected
    When compilation fails
    Then diagnostic = "'Impl' method 'kind' does not match interface"
