/**
 * maybe_text — a `str | error` producer with no environment behind it, so the two spellings below are
 * compared on the TYPING rule alone and never on what a host happens to have exported.
 *
 * @param present  true for the `str` member, false for the `error` member
 * @return         the text `"41"` when present
 * @throws         when `present` is false
 */
fn maybe_text(present: bool) -> str | error {
    if present { return "41" }
    error { message = "absent" }
}

/**
 * parse_uint — the decimal value of `s`, stopping at the first non-digit. The stand-in for
 * `bp_parse_uint`, whose `u64` return is what makes the real site's `to i32` cast an ANCHOR the bare
 * literal arm has to agree with.
 *
 * @param s  the decimal text
 * @return   the parsed value
 */
fn parse_uint(s: str) -> u64 {
    mut acc: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= s.len { break }
        let c = s[i]
        if c < b'0' || c > b'9' { break }
        acc = acc * 10 + ((c to u64) - (b'0' to u64))
        i = i + 1
    }
    acc
}

/**
 * rc_annotated — the SEED-COMPATIBLE spelling: both arms are explicitly `i32`, so the join needs no
 * cross-adoption and a compiler without it types the function exactly as the tip does.
 *
 * @param present  whether the text is there
 * @return         the parsed status, or 0
 */
fn rc_annotated(present: bool) -> i32 {
    match maybe_text(present) { str as v => parse_uint(v) to i32; error => 0 to i32 }
}

/**
 * rc_adopted — the spelling that DEPENDS on match-arm literal cross-adoption: the `error` arm is a
 * bare literal that only joins to `i32` because the tip retypes it into its concrete sibling.
 *
 * @param present  whether the text is there
 * @return         the parsed status, or 0
 */
fn rc_adopted(present: bool) -> i32 {
    match maybe_text(present) { str as v => parse_uint(v) to i32; error => 0 }
}

/**
 * width_is_i32 — proof that the join really is `i32` and not a union: a union would not bind to an
 * `i32` slot at all, and a value that had silently widened would not survive the round trip.
 *
 * @param present  whether the text is there
 * @return         the annotated spelling's value, carried through an `i32` binding
 */
fn width_is_i32(present: bool) -> i32 {
    let held: i32 = rc_annotated(present)
    held
}

/**
 * score — the exit code: the two spellings answer identically on both members of the union, and the
 * annotated one survives an `i32` binding. 41 + 0 + 41 + 0 + 41 = 123.
 *
 * @return  123 when both spellings agree on both members
 */
fn score() -> i64 {
    let total = rc_annotated(true) + rc_annotated(false) + rc_adopted(true) + rc_adopted(false) + width_is_i32(true)
    total to i64
}

println(teko::i64_to_str(score()))
