var root = teko::runtime::region_root()
var a = teko::runtime::region_new(root)
var b = teko::runtime::region_new(root)
var aw = teko::sys::ptr_word(a) to u64
var bw = teko::sys::ptr_word(b) to u64

retain(a)
retain(b)

match weak_get<u64>(a) {
    u64 => { }
    null => exit(1)
}

release(a)
release(b)

match weak_get<u64>(a) {
    u64 => exit(2)
    null => { }
}
match weak_get<u64>(b) {
    u64 => exit(3)
    null => { }
}

var p1 = teko::sys::ptr_word(teko::runtime::region_new(root)) to u64
var p2 = teko::sys::ptr_word(teko::runtime::region_new(root)) to u64
var ok = (p1 == aw && p2 == bw) || (p1 == bw && p2 == aw)
if !ok { exit(4) }

exit(0)
