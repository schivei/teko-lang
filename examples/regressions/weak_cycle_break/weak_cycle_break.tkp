# examples/regressions/weak_cycle_break — the COL-F0d `weak_get` fixture (crumb 0024). Proves the
# cycle-breaker: `a` holds a strong reference to `b` (`retain`); `b`'s back-reference to `a` is
# WEAK (`weak_get`, never a `retain`) — so releasing the external hold on `a` plus the strong
# `a`→`b` edge frees BOTH objects instead of leaking a strong two-object cycle. The compiler holds
# no `weak_get` callers, so this path is not fixpoint-exercised. Pinned to the C backend: the F0d
# intrinsics emit on the C route only (native = honest-stop).
name = "weak_cycle_break"
source = "src"

[artifact]
kind = "binary"
