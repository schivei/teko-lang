/**
 * Animal — a polymorphic base class with one exact subclass `Dog` (0.3.1 C3 — the SUB→BASE
 * widen pass of `emit_variant_wrap` must never win over an EXACT member match, no matter which
 * member the union declares FIRST). Types + helpers here; main.tks (virtual main) drives.
 */
type Animal = virtual class {
    /** the animal's display name (unused by the check, kept for shape parity). */
    pub name: str

    /**
     * make — construct a base `Animal`.
     *
     * @param n  the animal's name
     * @return   a fresh `Animal`
     */
    pub fn make(n: str) -> Animal {
        Animal { name = n }
    }

    /**
     * speak — the base's default (overridden by every subclass).
     *
     * @param self  the receiver
     * @return      the base's sound
     */
    pub virtual fn speak(self) -> str {
        "..."
    }
}

/**
 * Dog — the exact subclass under test: a `Dog` value stored into an `Animal | Dog | null`
 * union (base declared FIRST) must still wrap into the EXACT `Dog` member, never the base.
 */
type Dog = class Animal {
    /**
     * make — construct a `Dog`.
     *
     * @param n  the dog's name
     * @return   a fresh `Dog`
     */
    pub fn make(n: str) -> Dog {
        Dog { name = n }
    }

    /**
     * speak — the `Dog` override.
     *
     * @param self  the receiver
     * @return      "Woof"
     */
    pub override fn speak(self) -> str {
        "Woof"
    }
}
