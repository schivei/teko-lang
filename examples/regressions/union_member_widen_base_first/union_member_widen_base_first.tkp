# Regression: null-union C3 (0.3.1) — SUB->BASE widen must never steal an EXACT member match.
#
# `emit_variant_wrap`'s pass 1 used to fuse the EXACT-key test and the SUB->BASE widen test into
# the SAME loop iteration, so whichever member had the LOWER INDEX won — a `Dog` value stored
# into `Animal | Dog | null` (the polymorphic BASE declared BEFORE the exact subclass) was wrapped
# as `.as.Animal` (the widen arm) instead of `.as.Dog` (the exact arm), and the `match` below took
# the WRONG arm silently (exit 41, not 0). This fixture pins the base-first member order; its
# sibling `union_member_widen_sub_first` pins the mirrored (already-correct) order, so the
# ordering invariant is pinned in BOTH directions.
#
#   teko build examples/regressions/union_member_widen_base_first && ./examples/regressions/union_member_widen_base_first/union_member_widen_base_first   # → exit 0
name = "union_member_widen_base_first"
source = "src"

[artifact]
kind = "binary"
