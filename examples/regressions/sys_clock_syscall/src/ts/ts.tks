/**
 * Timespec — the C `struct timespec` as a §16 C1 `extern type … = struct` C-ABI layout: two 64-bit
 * words, header-less, so `tk_t_…Timespec`'s layout is byte-identical to libc's `struct timespec`.
 * This is the exact out-pointer shape `clock_gettime` writes through: the raw-syscall `syscall2`
 * call fills it via a `ref_word`-bridged address rather than a libc `extern fn`, but the C-ABI
 * struct itself is the same header-less layout the C1 keystone introduced.
 *
 * @field sec   seconds since the clock's epoch
 * @field nsec  nanoseconds within the second (0..999_999_999)
 * @since §16 (third syscall crumb)
 */
extern type Timespec = struct {
    /** seconds since the clock's epoch */
    sec: i64
    /** nanoseconds within the second (0..999_999_999) */
    nsec: i64
}
