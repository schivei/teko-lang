/**
 * CLOCK_MONOTONIC — the POSIX `clockid_t` naming a monotonic, never-adjusted clock: unaffected by
 * wall-clock changes, so it is the correct choice for measuring elapsed time. This is the fixture's
 * LOCAL mirror of the real `teko::sys::CLOCK_MONOTONIC` (`src/sys/sys.tks` in the compiler's own
 * project) — every value here is a literal Teko `const`, transcribed from the platform ABI, NEVER
 * imported from a C header/macro, and `#os` guarded so the §17 prune (`src/build/prune.tks`) keeps
 * exactly the definition matching the compiled target, before the checker ever sees the others.
 * Linux value: 1 (glibc `bits/time.h`'s `CLOCK_MONOTONIC`).
 *
 * @since §16
 */
#os("linux")
pub const CLOCK_MONOTONIC: i32 = 1

/**
 * SYS_CLOCK_GETTIME — the x86_64 Linux syscall number for `clock_gettime(clk_id, *tp)`, which
 * fills the caller-owned `struct timespec` at `*tp` with the current time for clock `clk_id`. This
 * is the fixture's LOCAL mirror of the real `teko::sys::SYS_CLOCK_GETTIME` (`src/sys/sys.tks` in
 * the compiler's own project) — every value here is a literal Teko `const`, transcribed from the
 * kernel ABI table, NEVER imported from a C header/macro, and per-`#os`/`#arch` guarded so the §17
 * prune (`src/build/prune.tks`) keeps exactly the definition matching the compiled target, before
 * the checker ever sees the others. x86_64 value: 228 (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_CLOCK_GETTIME: i64 = 228

/**
 * SYS_CLOCK_GETTIME — the aarch64 Linux syscall number for `clock_gettime(clk_id, *tp)`. Value 113
 * (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (228) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_CLOCK_GETTIME: i64 = 113
