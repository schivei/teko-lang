# examples/regressions/sys_clock_syscall — the §16 THIRD-CRUMB fixture: proves the `ref_word`
# pointer-bridge intrinsic (§1.2) plus the raw-syscall `syscall2` codegen intrinsic together issue
# the x86_64/aarch64 Linux `clock_gettime` syscall, WRITING DATA BACK through a struct pointer — the
# first crumb that returns a value rather than just a status code. A SELF-CONTAINED project (its own
# local copy of the `SYS_CLOCK_GETTIME`/`CLOCK_MONOTONIC` `#os("linux")`/`#arch` consts under
# `src/sys/sys.tks`, and its own `extern type Timespec = struct` under `src/ts/ts.tks`), because the
# real `teko::sys` lives in the COMPILER's own project (root `teko`, reserved — no user project may
# claim it) and an external standalone project has no visibility into it — the `sys_write`/
# `sys_exit_group` precedent. The local `sys.tks` copy is a byte-for-byte structural mirror of
# `src/sys/sys.tks`'s `SYS_CLOCK_GETTIME`/`CLOCK_MONOTONIC` blocks, so building and running it
# exercises the identical `#os`/`#arch` prune mechanism the real module relies on.
name = "sys_clock_syscall"
source = "src"

[artifact]
kind = "binary"
