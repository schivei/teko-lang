// KNOWN-STOP PIN (#265, held-back cell 1 of native_gate_coercions, examples/regressions/
// qualified_optional/src/native_gate/lib.tks): a bare `[]i64` present-wrapped into a
// `[](i64 | null)` PARAM. The surface cannot express the type at all today — `[](` is read by the
// parser as a FUNCTION type — so this file must FAIL TO PARSE. The day the parser accepts it, the
// pin's scenario goes red and the cell is promoted back into `entry()`.
// expected diagnostic: "a function type '(A, B) -> R' needs '->' before the return type"
fn sum_opt(xs: [](i64 | null)) -> i64 {
    let a = match xs[0] { null => 0; i64 as v => v }
    let b = match xs[1] { null => 0; i64 as v => v }
    a + b
}
