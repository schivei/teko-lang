/**
 * A — the DIRECT member of the union-of-unions `A | (B | C)` that the group-bind arm cannot claim: the
 * group `(B | C) as v` covers only the NESTED member, so `A` is left uncovered (§9.D c).
 *
 * @field a  an unused payload
 */
type A = struct { a: i64 }

/**
 * B — the first case of the nested anonymous union `(B | C)` (§9.D c).
 *
 * @field b  an unused payload
 */
type B = struct { b: i64 }

/**
 * C — the second case of the nested anonymous union `(B | C)` (§9.D c).
 *
 * @field c  an unused payload
 */
type C = struct { c: i64 }

/**
 * nonexhaustive — a group-bind `match` whose only arm is `(B | C) as v`: the group covers the nested
 * member but NOT the direct `A`, so the match is non-exhaustive and the compiler REJECTS it (§9.D c
 * exhaustiveness counts the direct member independently of the nested group).
 *
 * @param x  the union-of-unions subject
 * @return   unreachable — the match is rejected
 */
fn nonexhaustive(x: A | (B | C)): i64 {
    match x {
        (B | C) as v => match v {
            B as b => b.b
            C as c => c.c
        }
    }
}
