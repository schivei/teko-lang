/**
 * A — a case of the flat union `A | B | C` matched below (§9.D c).
 *
 * @field a  an unused payload
 */
type A = struct { a: i64 }

/**
 * B — a case of the flat union `A | B | C`; the first option of the illegal binding alternation (§9.D c).
 *
 * @field b  an unused payload
 */
type B = struct { b: i64 }

/**
 * C — a case of the flat union `A | B | C`; the option the illegal alternation tries to bind (§9.D c).
 *
 * @field c  an unused payload
 */
type C = struct { c: i64 }

/**
 * barealt — a match whose second arm is the BARE alternation `B | C as v`: without parentheses it is an
 * `AltPattern`, not a group-bind, so it CANNOT bind — the parentheses plus `as` are the group-bind
 * discriminator. The compiler REJECTS the binding alternation (§9.D c did not loosen the settled
 * axis rule).
 *
 * @param x  the flat-union subject
 * @return   unreachable — the binding alternation is rejected
 */
fn barealt(x: A | B | C): i64 {
    match x {
        A as a => a.a
        B | C as v => 2
    }
}
