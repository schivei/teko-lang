# examples/regressions/deepcopy_exact — the COL-F0d `deep_copy` fixture (crumb 0024). Proves
# `deep_copy` of a shallow object (a class with only primitive fields) produces an INDEPENDENT
# clone: mutating the clone's field leaves the original untouched. The compiler holds no
# `deep_copy` callers, so this path is not fixpoint-exercised. Pinned to the C backend: the F0d
# intrinsics emit on the C route only (native = honest-stop).
name = "deepcopy_exact"
source = "src"

[artifact]
kind = "binary"
