pub type IChannelKind<T> = interface {
    fn kind(): str
}

pub type Fast = service singleton & IChannelKind {
    pub static fn ctor(): self { return Fast { } }
    pub fn kind(): str { return "fast" }
}

fn wants<K: service singleton & IChannelKind<i64>>(k: K): i64 { return 1 }

pub fn entry(): i64 { return wants<Fast>(Fast::ctor()) }
