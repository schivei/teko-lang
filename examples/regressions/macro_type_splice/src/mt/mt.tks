/**
 * Elem — a Family-A macro used in a TYPE position (§14 A4): `@Elem()` expands, pre-type-check, to the
 * type `i64` (its `lowering` fragment re-parsed as a `TypeExpr`).
 *
 * @since macro_type_splice (§14 A4 fixture)
 */
macro Elem() { lowering { i64 } }

/**
 * NumOrStr — a Family-A macro that expands, in a type position, to the INLINE UNION `i64 | str` (the
 * §9.D abbreviation keystone): `w: @NumOrStr()` becomes `w: i64 | str` with no named `type`.
 *
 * @since macro_type_splice (§14 A4 fixture)
 */
macro NumOrStr() { lowering { i64 | str } }

/**
 * Box — a struct whose field type comes from `@Elem()` (§14 A4): `v: @Elem()` expands to `v: i64`.
 */
type Box = struct { v: @Elem() }

/**
 * Wrap — a struct whose field type is the macro-produced inline union `@NumOrStr()` (§9.D): `w: i64 | str`.
 */
type Wrap = struct { w: @NumOrStr() }

/**
 * Lst — a struct whose field is a SLICE of a macro type, `[]@Elem()` → `[]i64` (§14 A4): the type-macro
 * splices inside a `[]` slice element, exactly the §9.D `members: []@Type()` shape.
 */
type Lst = struct { xs: []@Elem() }

/**
 * elem_field — `Box.v` has the macro-derived type `i64`; a `Box { v = 7 }` reads back 7 (§14 A4).
 *
 * @return  7
 */
pub fn elem_field(): i64 {
    var b = Box { v = 7 }
    b.v
}

/**
 * union_field — `Wrap.w` has the macro-derived inline union `i64 | str`; a `Wrap { w = 5 }` matches the
 * `i64` arm and reads back 5 (§9.D inline-union keystone).
 *
 * @return  5
 */
pub fn union_field(): i64 {
    var wr = Wrap { w = 5 }
    match wr.w { i64 as n => n; str => -1 }
}

/**
 * slice_field — `Lst.xs` has the macro-derived slice type `[]i64`; a one-element list reads `.len` = 1
 * (§14 A4, the `[]@Type()` splice).
 *
 * @return  1
 */
pub fn slice_field(): i64 {
    var l = Lst { xs = one_elem() }
    l.xs.len to i64
}

/**
 * one_elem — the single-element `[]i64` the slice-field scenario reads.
 *
 * @return  a one-element `[]i64`
 */
fn one_elem(): []i64 {
    var s: []i64 = teko::list::empty()
    s = teko::list::push(s, 9)
    s
}
