# Regression: null-union C4 (0.3.0.30) — the box-in-arena representation round-trip.
#
# A two-member absence union `{ null, X }` whose `X` carries NO spare NULL niche and whose saturating
# payload is >= 16 bytes (`Vec2`, a large by-value struct) lowers to an 8-byte ARENA HANDLE: `NULL`
# MEANS `null` (zero heap bytes), a present construct bump-allocs one `tk_region_alloc` cell and
# stores the handle, and a match arm loads the payload back through the handle. This program
# round-trips the ABSENT (`null`) and PRESENT arms of a boxed `Vec2 | null` (16-byte struct), summing
# a distinct contribution from each arm so a miscompiled box changes the exit code. (This fixture
# formerly also covered a boxed SCALAR union, `u128 | null` — drop-128, 2026-07-24, removed the
# scalar case: no builtin scalar is >= 16 bytes once `u128`/`i128` leave the type system, so the
# ≥16-byte-scalar sub-case has no surviving construction; the ≥16-byte-STRUCT case below still
# exercises the identical box mechanism.) Native build + run must exit 19.
#
#   Vec2 box   : present 5+11=16 + absent 3         =  19
name = "repr_box"
source = "src"

[artifact]
kind = "binary"
