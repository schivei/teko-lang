/**
 * count — a Family-B comptime returning the constant 2 (§14 B3): `@count()` is folded, post-monomorph,
 * to the literal its body evaluates to. A comptime with NO parameters — the simplest fold.
 *
 * @return  2, inlined as a literal at each `@count()` call
 * @since comptime_expand (§14 B3 fixture)
 */
comptime count(): i64 { 2 }

/**
 * sum — a Family-B comptime summing two compile-time-constant arguments (§14 B3): `@sum(a, b)` binds the
 * caller's constant arguments to the parameters and folds `a + b` to the literal.
 *
 * @param a  the first addend (must be a compile-time constant)
 * @param b  the second addend (must be a compile-time constant)
 * @return   `a + b`, inlined as a literal
 * @since comptime_expand (§14 B3 fixture)
 */
comptime sum(a: i64, b: i64): i64 { a + b }

/**
 * count_probe — `@count()` folds to 2 (§14 B3).
 *
 * @return  2
 */
pub fn count_probe(): i64 { @count() }

/**
 * sum_probe — `@sum(3, 7)` binds a=3, b=7 and folds `a + b` to 10 (§14 B3).
 *
 * @return  10
 */
pub fn sum_probe(): i64 { @sum(3, 7) }

/**
 * nested_probe — `@sum(@count(), 8)` folds the nested `@count()` argument to 2 first, then folds
 * `@sum(2, 8)` to 10 — proving comptime arguments expand bottom-up before the enclosing call (§14 B3).
 *
 * @return  10
 */
pub fn nested_probe(): i64 { @sum(@count(), 8) }
