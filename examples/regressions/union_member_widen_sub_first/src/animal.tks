/**
 * Animal — a polymorphic base class with one exact subclass `Dog` (0.3.1 C3 — mirrors
 * `union_member_widen_base_first`, but with the exact subclass member declared FIRST in the
 * union, the shape that was already correct before the fix; kept as the control direction so
 * the ordering invariant is pinned both ways). Types + helpers here; main.tks drives.
 */
type Animal = virtual class {
    /** the animal's display name (unused by the check, kept for shape parity). */
    pub name: str

    /**
     * make — construct a base `Animal`.
     *
     * @param n  the animal's name
     * @return   a fresh `Animal`
     */
    pub fn make(n: str) -> Animal {
        Animal { name = n }
    }

    /**
     * speak — the base's default (overridden by every subclass).
     *
     * @param self  the receiver
     * @return      the base's sound
     */
    pub virtual fn speak(self) -> str {
        "..."
    }
}

/**
 * Dog — the exact subclass under test: a `Dog` value stored into a `Dog | Animal | null` union
 * (exact subclass declared FIRST) must wrap into the EXACT `Dog` member.
 */
type Dog = class Animal {
    /**
     * make — construct a `Dog`.
     *
     * @param n  the dog's name
     * @return   a fresh `Dog`
     */
    pub fn make(n: str) -> Dog {
        Dog { name = n }
    }

    /**
     * speak — the `Dog` override.
     *
     * @param self  the receiver
     * @return      "Woof"
     */
    pub override fn speak(self) -> str {
        "Woof"
    }
}
