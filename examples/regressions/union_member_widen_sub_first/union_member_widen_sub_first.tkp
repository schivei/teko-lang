# Regression: null-union C3 (0.3.1) — control direction of union_member_widen_base_first.
#
# `emit_variant_wrap`'s pass 1 mis-wrapped a `Dog` value stored into `Animal | Dog | null` (base
# declared before the exact subclass); this fixture mirrors that with `Dog | Animal | null` (the
# exact subclass declared FIRST), the shape that was already correct before the fix. Kept as the
# control direction so the fix's two-pass split is pinned in BOTH member orders, never just one.
#
#   teko build examples/regressions/union_member_widen_sub_first && ./examples/regressions/union_member_widen_sub_first/union_member_widen_sub_first   # → exit 0
name = "union_member_widen_sub_first"
source = "src"

[artifact]
kind = "binary"
