# examples/regressions/decode_invalid_utf8_reject — the SM-STRU32 (crumb 0025) codec fixture.
# Proves `teko::text::decode_utf8_u32` rejects ill-formed UTF-8 (an overlong 2-byte encoding of
# NUL) with `error` instead of silently decoding it. A SELF-CONTAINED project (its own local copy
# of the decode path under `src/text/text.tks`), same rationale as
# `examples/regressions/arena_loadstore`.
name = "decode_invalid_utf8_reject"
source = "src"

[artifact]
kind = "binary"
