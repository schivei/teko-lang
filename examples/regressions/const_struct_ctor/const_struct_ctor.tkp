# examples/regressions/const_struct_ctor — the project-regressor for a STRUCT const whose
# initializer is an allowlisted COMPTIME CONSTRUCTOR CALL (Tier 5 of the const grammar), the
# shape the compiler's own backends use for their physical-register consts
# (`const RAX_X86: MReg = preg(0, MRegClass::GPR)`).
#
# The const grammar admits the call, but the LIR's rodata materializer only knows how to
# serialize a struct LITERAL: before the checker canonicalized the fold's output
# (`canonicalize_const_ctors`) a surviving call died with "const struct: initializer is not a
# struct literal". This project builds and runs, so its exit code is the value the constructor
# would have returned — a const whose value drifted through the canonicalization fails here.
name = "const_struct_ctor"
source = "src"

[artifact]
kind = "binary"
