# examples/regressions/defaults_named — the §9 C ACCEPT host (parameter defaults + `:=` named
# arguments). One witness number, computed from every accept path, is printed to stdout; a relapse in
# any binding MOVES it off `33178`:
#   * defaults filled by omission — box(5)=523, box(5,7)=573, box(5,7,9)=579 (rulings 1)
#   * `:=` names a trailing param, skipping another — box(5, d := 9)=529 (ruling 2)
#   * `:=` names the middle param — box(5, h := 4)=543
#   * ALL named, reordered — box(w := 5, d := 9, h := 4)=549 (started-named -> all-named, free order)
#   * `:=` names the FIRST param — box(w := 6)=623
#   * `:=` through a METHOD dot-call — B().vol()=21, B().vol(k := 5)=35 (G2)
#   * `params` + default combined — g(7)=7200, g(7,3)=7300, g(7,3,1,2)=7303, g(7, b := 4)=7400 (C-T1)
# Sum = 523+573+579+529+543+549+623+21+35+7200+7300+7303+7400 = 33178.
name = "defaults_named"
source = "src"

[artifact]
kind = "binary"
