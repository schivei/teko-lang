/**
 * B — a fieldless class whose instance method carries a defaulted parameter, exercising a `:=` named
 * argument through a METHOD dot-call (§9 C G2 / ruling 2).
 */
type B = class {
    /** scale — the per-instance multiplier the method reads. */
    pub scale: i64
    /**
     * make — the static factory that constructs a `B` via the nominal `B { … }` (a class literal is
     * legal only inside the class's own methods).
     *
     * @return  a fresh `B` with `scale = 7`
     */
    pub static fn make(): B { B { scale = 7 } }
    /**
     * vol — the method under test: its sole non-receiver parameter defaults, so `b.vol()` fills it
     * and `b.vol(k := 5)` names it. The receiver `self` is synthetic (§4 D2).
     *
     * @param k  the multiplicand, defaulting to 3
     * @return   `k * self.scale`
     */
    pub fn vol(k: i64 = 3): i64 { k * self.scale }
}

/**
 * box — the base free function with two trailing defaults, the spine of the positional / named /
 * default cases (§9 C rulings 1 & 2). Each parameter contributes to a distinct decimal place so a
 * mis-binding MOVES the witness.
 *
 * @param w  the required leading argument (hundreds place)
 * @param h  the first defaulted argument (tens place), default 2
 * @param d  the second defaulted argument (ones place), default 3
 * @return   `w * 100 + h * 10 + d`
 */
fn box(w: i64, h: i64 = 2, d: i64 = 3): i64 { w * 100 + h * 10 + d }

/**
 * sum_i64 — the running total of a slice, used to read back what the `params` tail collected.
 *
 * @param xs  the slice to total
 * @return    the sum of every element (0 for an empty slice)
 */
fn sum_i64(xs: []i64): i64 {
    var total: i64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        total = total + xs[i]
        i++
    }
    total
}

/**
 * g — a function that is BOTH `params`-variadic AND carries a trailing default (owner ruling C-T1:
 * `params` is an inherent trailing-optional and composes with defaults / named args). Each region of
 * the witness — thousands (`a`), hundreds (`b`), the low digits (the packed tail) — reads back one
 * binding decision.
 *
 * @param a  the required leading argument (thousands place)
 * @param b  the defaulted argument (hundreds place), default 2
 * @param r  the variadic tail, whose sum lands in the low digits
 * @return   `a * 1000 + b * 100 + sum_i64(r)`
 */
fn g(a: i64, b: i64 = 2, params r: []i64): i64 { a * 1000 + b * 100 + sum_i64(r) }

/**
 * run — exercise every §9 C accept path once and sum each result into a single witness (`33178`) that
 * only the correct binding of all cases produces. A relapse in any path moves the total.
 *
 * @return  the combined witness `33178`
 */
pub fn run(): i64 {
    var total: i64 = 0
    total = total + box(5)
    total = total + box(5, 7)
    total = total + box(5, 7, 9)
    total = total + box(5, d := 9)
    total = total + box(5, h := 4)
    total = total + box(w := 5, d := 9, h := 4)
    total = total + box(w := 6)
    var b = B::make()
    total = total + b.vol()
    total = total + b.vol(k := 5)
    total = total + g(7)
    total = total + g(7, 3)
    total = total + g(7, 3, 1, 2)
    total = total + g(7, b := 4)
    total
}
