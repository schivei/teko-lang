type B = class {
    pub scale: i64
    pub static fn make(): B { B { scale = 7 } }
    pub fn vol(k: i64 = 3): i64 { k * self.scale }
}

fn box(w: i64, h: i64 = 2, d: i64 = 3): i64 { w * 100 + h * 10 + d }

fn sum_i64(xs: []i64): i64 {
    var total: i64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        total = total + xs[i]
        i++
    }
    total
}

fn g(a: i64, b: i64 = 2, params r: []i64): i64 { a * 1000 + b * 100 + sum_i64(r) }

pub fn run(): i64 {
    var total: i64 = 0
    total = total + box(5)
    total = total + box(5, 7)
    total = total + box(5, 7, 9)
    total = total + box(5, d := 9)
    total = total + box(5, h := 4)
    total = total + box(w := 5, d := 9, h := 4)
    total = total + box(w := 6)
    var b = B::make()
    total = total + b.vol()
    total = total + b.vol(k := 5)
    total = total + g(7)
    total = total + g(7, 3)
    total = total + g(7, 3, 1, 2)
    total = total + g(7, b := 4)
    total
}
