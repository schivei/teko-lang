# examples/regressions/block_expr_reject — the §9 E REJECT host (Block-B in expression position,
# ruling 7). A Block-B in VALUE position must end in a value expression: two illegal forms live one per
# namespace under src/, and the single failing build reports every diagnostic it finds, one per scenario
# in the .tkr — a trailing statement that yields no value (an assignment), and a block that DIVERGES (a
# trailing `return`). It has no successful build to sanitize/run (it mirrors match_universal_reject /
# defaults_named_reject).
name = "block_expr_reject"
source = "src"

[artifact]
kind = "binary"
