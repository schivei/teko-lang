/**
 * trailing_assign — a Block-B in VALUE position whose TRAILING statement is an assignment (§9 E,
 * ruling 7). An assignment yields no value, so the block cannot occupy value position — the same
 * contract `type_if` imposes on an `if`-as-value without an `else`.
 *
 * @return  unreachable — the binding is rejected
 */
fn call(): i64 {
    var r = { var a = 20; a = a + 1 }
    r
}
