/**
 * trailing_return — a Block-B in VALUE position that DIVERGES via a trailing `return` (§9 E, ruling 7).
 * A diverging block never falls through to a value, so it cannot occupy value position.
 *
 * @return  unreachable — the binding is rejected
 */
fn call(): i64 {
    var r = { return 5 }
    r
}
