# examples/regressions/mem_block_dies — the regressor of an `if`-ARM block-local str residence
# (0.3.1 modelo-de-memoria-por-escopo §4/§9, crumb C3). A str built inside an `if` arm and consumed
# with a non-tail, non-assign-RHS use is proven block-local and bump-allocated in the arm's region
# via `tk_str_concat_r`; it dies at the arm's exit edge. Churning further scopes AFTER the arm
# recycles that memory, so a use-after-drop would corrupt the value rather than merely leak it.
name = "mem_block_dies"
source = "src"

[artifact]
kind = "binary"
