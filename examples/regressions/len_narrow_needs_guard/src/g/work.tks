/**
 * over_u32_max — a non-constant `u64` value above `u32::MAX` (a `.len`-shaped count too
 * big for a `u32` slot). Routed through a function call (not a literal) so the checker's
 * static constant-range check (M.1, compile-time) does NOT catch it — the only remaining
 * guard is codegen's RUNTIME checked-narrow (Failure-2, `cast-width-hygiene-0.3.1.md` §4.1),
 * which must still fire.
 *
 * @return a value above `u32::MAX`
 */
pub fn over_u32_max() -> u64 {
    5000000000
}

/**
 * narrowed — the deliberately over-range narrow: `over_u32_max()` (a `u64` above
 * `u32::MAX`) forced into a `u32` slot. This is the ONE genuine narrow this fixture
 * exercises; it must panic at runtime (Failure-2's guard, not statically rejected
 * since the value is not a literal).
 *
 * @return the narrowed value, widened back to `i32` for the exit code (never reached —
 *         the cast above panics first)
 */
pub fn narrowed() -> i32 {
    let m = over_u32_max() to u32
    m to i32
}
