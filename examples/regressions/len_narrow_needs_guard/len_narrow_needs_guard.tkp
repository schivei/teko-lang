# Regression (cast-width-hygiene-0.3.1.md Failure-2 / §4.1): the C3 signature sweep widens
# internal count/length declarations to `u64` so the `.len to u32` panic edge mostly VANISHES —
# but a genuine narrow that SURVIVES (a real wire-boundary `to u32`, or here a stand-in
# u64-above-u32::MAX value routed through a non-constant function call) must still fail LOUD at
# runtime (the PHASE16 checked-cast guard, unchanged — `teko_rt.c::tk_panic_cast`, `abort()`,
# conventional exit 134). Proves the guard was never relaxed by the width-hygiene sweep.
#
#   teko build examples/regressions/len_narrow_needs_guard && ./examples/regressions/len_narrow_needs_guard/len_narrow_needs_guard   # -> abort, exit 134
name = "len_narrow_needs_guard"
source = "src"

[artifact]
kind = "binary"
