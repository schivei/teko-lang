/**
 * chk — the Degrau-0 pure-byte-logic evidence: `str ==` (str_eq), `ends_with`, `contains`, plus the
 * neighbouring ALLOCATING builtins (`concat`/`u64_to_str`/`i64_to_str`) that Degrau 0 deliberately
 * does NOT reroute yet. `result` builds ONE line carrying each builtin's ACTUAL answer/output so the
 * fixture matches the printed VALUES on STDOUT — never an exit code (a weak signal: it cannot tell a
 * crash from a pass, and wraps at 256). The C route (`rt_pure_bytes_c`) prints the SAME line from the
 * SAME source, so the two routes' stdout must be byte-identical.
 */

/**
 * bit — the ASCII digit for a boolean answer, so a predicate's ACTUAL result travels on stdout as a
 * matchable character rather than collapsing into a pass/fail exit code.
 *
 * @param b  the boolean to render
 * @return   "1" when `b`, else "0"
 */
fn bit(b: bool) -> str {
    if b { "1" } else { "0" }
}

/**
 * result — the printable evidence line: each Degrau-0 pure-byte builtin's ACTUAL answer and each
 * neighbouring allocating builtin's ACTUAL output, joined by "_" (regex-safe) so a wrong result shows
 * as a changed field on stdout. Fields, in order: str_eq true, str_eq false, ends_with hit, ends_with
 * empty-suffix, ends_with miss, contains hit, contains empty-needle, contains miss, concat, u64_to_str,
 * i64_to_str.
 *
 * @return  the "_"-joined evidence, "1_0_1_1_0_1_1_0_abc_42_-7" when every builtin agrees
 */
exp fn result() -> str {
    teko::str::concat(
        bit(teko::str::concat("ab", "c") == "abc"), "_",
        bit(teko::str::concat("ab", "d") == "abc"), "_",
        bit(teko::str::ends_with("hello world", "world")), "_",
        bit(teko::str::ends_with("hello", "")), "_",
        bit(teko::str::ends_with("hi", "hello")), "_",
        bit(teko::str::contains("hello world", "lo wo")), "_",
        bit(teko::str::contains("hello", "")), "_",
        bit(teko::str::contains("hello world", "xyz")), "_",
        teko::str::concat("ab", "", "c"), "_",
        teko::str::u64_to_str(42), "_",
        teko::str::i64_to_str(-7)
    )
}
