# examples/regressions/rt_pure_bytes_c — o ORACULO de rota C do regressor de PARIDADE dos builtins
# de logica pura de bytes do Degrau 0.
#
# O programa e o mesmo de `examples/regressions/rt_pure_bytes_native` byte a byte, e a duplicacao e
# deliberada: `tkr_ensure_built` (`src/build/regression.tks`) compila um projecto UMA VEZ por
# ficheiro `.tkr`, com o env do PRIMEIRO cenario, e a cache e chaveada na FORMA do build e nao no
# env (`regr_built_serves`). Um cenario de rota C ao lado do nativo no mesmo `.tkr` correria portanto
# o binario NATIVO com `TEKO_BACKEND=c` posto so a execucao — mediria a coisa errada em silencio — e
# dois `.tkr` na MESMA pasta escreveriam ambos em `<pasta>/bin/<nome>`, que a corrida do regressor
# pode paralelizar.
#
# O QUE ESTE LADO AFIRMA: que "rt_pure_bytes: ok" e o valor VERDADEIRO. A rota C resolve
# `str ==`/`ends_with`/`contains` para `tk_str_eq`/`tk_str_ends_with`/`tk_str_contains`
# (`src/codegen/codegen.tks`), um caminho independente do gemeo Teko que o Degrau 0 religa na rota
# nativa quando o corpo esta no corpus.
name = "rt_pure_bytes_c"
source = "src"

[artifact]
kind = "binary"
