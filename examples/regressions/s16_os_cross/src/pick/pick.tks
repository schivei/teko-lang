#os("linux")
/**
 * OS_CODE — the Linux arm of an `#os`-split const family (linux=42, macos=43, windows=44). Under the
 * C-monolith backend all three arms survive the prune and codegen emits ONE `#if <os>` `#define`
 * ladder, so the one `teko.c` cross-compiles across every OS.
 *
 * @return  42, the Linux arm's value
 */
pub const OS_CODE: i64 = 42

#os("macos")
/**
 * OS_CODE — the macOS arm of the `#os`-split const family (the `#elif defined(__APPLE__)` arm).
 *
 * @return  43, the macOS arm's value
 */
pub const OS_CODE: i64 = 43

#os("windows")
/**
 * OS_CODE — the Windows arm of the `#os`-split const family (the `#elif defined(_WIN32)` arm).
 *
 * @return  44, the Windows arm's value
 */
pub const OS_CODE: i64 = 44

#os("linux")
/**
 * os_tag — the Linux arm of an `#os`-split FUNCTION family (three bodies, one per OS). Codegen wraps
 * each body in its own `#if <os>` block onto ONE C symbol, so only the target's body compiles.
 *
 * @return  the Linux `OS_CODE` (42)
 */
pub fn os_tag(): i64 { OS_CODE }

#os("macos")
/**
 * os_tag — the macOS arm of the `#os`-split function family.
 *
 * @return  the macOS `OS_CODE` (43)
 */
pub fn os_tag(): i64 { OS_CODE }

#os("windows")
/**
 * os_tag — the Windows arm of the `#os`-split function family.
 *
 * @return  the Windows `OS_CODE` (44)
 */
pub fn os_tag(): i64 { OS_CODE }
