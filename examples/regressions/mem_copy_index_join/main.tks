var dst: [cfg::DST_LEN]byte = []
var src: []byte = [b'h', b'i', b'!']
teko::runtime::copy(dst, cfg::COPY_AT, src)

if dst[0] != 0 { exit(1) }
if dst[1] != b'h' { exit(2) }
if dst[2] != b'i' { exit(3) }
if dst[3] != b'!' { exit(4) }
if dst[4] != 0 { exit(5) }
if dst.len != cfg::DST_LEN { exit(6) }

exit(0)
