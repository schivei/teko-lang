# examples/regressions/mem_copy_index_join — the RM-C2 (crumb 0020) index-join fixture. Proves
# `teko::runtime::copy(dst, at, src)` writes `src` into `dst[at..]` with no growth. No local
# modules needed: `teko::runtime` is injected as a binary-artifact prelude.
name = "mem_copy_index_join"
source = "src"

[artifact]
kind = "binary"
