/**
 * pass_case — name a scenario, run a passing assertion through the migrated compare+scenario path,
 * then announce the case passed so its name reaches the report.
 *
 * @since 0.3.1
 */
exp fn pass_case() {
    teko::assert::scenario_begin("integrated_case")
    teko::assert::eq_i64(1 + 1, 2)
    teko::assert::scenario_ok()
}
