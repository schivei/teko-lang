# Regression (cast-width-hygiene-0.3.1.md C1, W-RULE §2.3): a mixed-width FLOAT binary op
# widens implicitly to the larger IEEE width — no explicit `to` needed, symmetric to the
# same-signedness integer case. `f32 + f64` widens the `f32` operand to `f64` (always lossless
# — every `f32` value is exactly representable in `f64`).
#   a: f32 = 1.5, b: f64 = 2.0  =>  a + b == 3.5 (computed at f64 width) -> truncated to i32 -> 3
#
#   teko build examples/regressions/width_float_widen && ./examples/regressions/width_float_widen/width_float_widen   # -> exit 3
name = "width_float_widen"
source = "src"

[artifact]
kind = "binary"
