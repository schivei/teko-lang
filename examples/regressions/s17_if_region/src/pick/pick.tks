#if(os == "windows")
/**
 * pick — the windows arm: it calls a symbol that DOES NOT EXIST. On any non-windows target this arm
 * is pruned BEFORE type-check, so the missing symbol must never reach the checker (the §17 ordering
 * guarantee). It is never built on the linux/macos regression hosts.
 *
 * @return  unreachable on non-windows targets (the arm is pruned)
 */
pub fn pick(): i64 { return windows_only_absent_symbol() }
#elseif(os == "linux")
/**
 * pick — the linux arm: the surviving definition on a linux target, returning 42.
 *
 * @return  42, the linux arm's identifying value
 */
pub fn pick(): i64 { return 42 }
#elseif(os == "macos")
/**
 * pick — the macos arm: the surviving definition on a macos target, returning 43.
 *
 * @return  43, the macos arm's identifying value
 */
pub fn pick(): i64 { return 43 }
#else
/**
 * pick — the fallback arm for every other target, returning 99.
 *
 * @return  99, the fallback arm's identifying value
 */
pub fn pick(): i64 { return 99 }
#endif
