/**
 * Counter — an arity-0 struct, present only so `.{ … }` has a plausible shape to construct.
 */
type Counter = struct {
    /** _n — the single field. */
    _n: i64
}

/**
 * no_target — a `.{ … }` bound to an UN-annotated `var` has no target type in its slot (§4.1). The
 * target comes only from the immediate slot, never by back-flow, so this is a compile error.
 *
 * @return unreachable — the construction is rejected
 */
fn no_target(): i64 {
    var c = .{ _n = 0 }
    c._n
}
