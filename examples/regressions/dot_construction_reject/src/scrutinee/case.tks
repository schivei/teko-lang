/**
 * Flag — an arity-0 struct, present only so `.{ … }` has a plausible shape to construct.
 */
type Flag = struct {
    /** on — the single field. */
    on: i64
}

/**
 * scrutinee — a `.{ … }` used as an `if` subject has no target type (an `if` scrutinee supplies no
 * expected type), so it is a compile error (§4.1). Guarantees the unconditional `.{ … }` parse opens
 * no semantic hole: a mis-placed `.{ … }` still fails the type-check.
 *
 * @return unreachable — the construction is rejected
 */
fn scrutinee(): i64 {
    if .{ on = 1 } { 1 } else { 0 }
}
