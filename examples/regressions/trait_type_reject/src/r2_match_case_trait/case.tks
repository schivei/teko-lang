/** MT — a trait used illegally as a match case (no discriminant). */
type MT = trait {
    /** k — a bodied method. @return 1 */
    fn k(): i64 { 1 }
}
/**
 * probe — REJECTED: a trait names a case in a `match`, but a trait has no discriminant (§9.4).
 * @param x  the subject
 * @return   an int
 */
pub fn probe(x: i64): i64 { match x { MT as t => 1; _ => 0 } }
