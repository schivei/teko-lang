/** CT — a trait used illegally as a generic constraint. */
type CT = trait {
    /** k — a bodied method. @return 1 */
    fn k(): i64 { 1 }
}
/**
 * f — REJECTED: a trait constrains a type parameter, but a trait is not a type (§9.4). The body
 * calls through `X` so the constraint surface is computed and the illegal atom is reported.
 * @param x  the constrained argument
 * @return   the method result
 */
pub fn f<X: CT>(x: X): i64 { x.k() }
