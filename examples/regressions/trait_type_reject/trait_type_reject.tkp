# examples/regressions/trait_type_reject — the §9.4 trait-not-a-dispatch-type REJECT host. A trait in
# a match case and a trait in a generic constraint live one per namespace under src/; each is a
# typing-stage rejection, so they live apart from the collection-stage trait rejects that would cut
# the item-body walk before these ran.
name = "trait_type_reject"
source = "src"

[artifact]
kind = "binary"
