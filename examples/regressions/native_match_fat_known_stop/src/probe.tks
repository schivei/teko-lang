/**
 * The producer the native backend's fat-pointer path does not have: a `match`-VALUE whose result is
 * `str`. Byte-for-byte the body from `examples/regressions/bulk/src/q005_base_widened_from_a_derived_class_null`,
 * authored 2026-07-24 (`1201088`) and green through the C route ever since.
 *
 * The null-union is INCIDENT here, not causal. `lower_fat_expr` (`src/lir/lower.tks`) accepts a
 * closed producer set — string literal, array literal, bound local, struct field, `if`-expression,
 * direct call — and `speak_or`'s body is none of them: it is a `match` whose value is the `str` the
 * function returns. Change the return type to `u64` and the same function lowers.
 */
type Animal_sbmd = virtual class {
    pub name: str
    pub virtual fn speak(self) -> str { "..." }
}
type Dog_sbmd = class Animal_sbmd {
    pub fn make(n: str) -> Dog_sbmd { Dog_sbmd { name = n } }
    pub override fn speak(self) -> str { "Woof" }
}

/** speak_or — the failing surface: a `str`-valued `match` in tail position. @return the greeting or `fallback` */
fn speak_or(a: Animal_sbmd | null, fallback: str) -> str {
    match a { Animal_sbmd as v => v.speak(); null => fallback }
}

/** probe — both placements: a derived instance widened to its base, and the absent one. @return 42 the day it lowers */
pub fn probe() -> u64 {
    let present: Animal_sbmd | null = Dog_sbmd::make("Rex")
    let absent: Animal_sbmd | null = null
    let r1 = speak_or(present, "?")
    let r2 = speak_or(absent, "?")
    if r1 == "Woof" && r2 == "?" { 42 to u64 } else { 1 to u64 }
}
