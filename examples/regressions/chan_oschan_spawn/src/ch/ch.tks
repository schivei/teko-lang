/**
 * oschan_make — create+bind the reader socket for a `str` channel key (abstract namespace), carrying
 * `elem_size`-byte fixed-width elements (`bounds==0` => the OS default buffer). The thin Teko binder
 * over the C0c runtime primitive (`tk_oschan_make_str`).
 *
 * @param elem_size  the fixed byte width of each element
 * @param bounds     the capacity hint, or 0 for the OS default
 * @param key        the channel key naming the reader's abstract socket
 * @return           the channel handle (an F2 pointer as a u64)
 * @since 0.3.1 §10
 */
pub extern fn oschan_make(elem_size: u64, bounds: u64, key: str): u64 = "tk_oschan_make_str" from "teko_rt"

/**
 * oschan_send — sendto one fixed-width element (read from the address `elem`) to the reader's bound
 * name; a lazily opened per-thread writer socket carries the datagram.
 *
 * @param ch    the channel handle
 * @param elem  the address of the element to send (from `uptr::__unwrap`)
 * @return      0 on accept, -1 when a bounded queue is momentarily full
 * @since 0.3.1 §10
 */
pub extern fn oschan_send(ch: u64, elem: uptr): i64 = "tk_oschan_send_u" from "teko_rt"

/**
 * oschan_recv — recvfrom the next fixed-width element into the address `out` (blocking).
 *
 * @param ch   the channel handle
 * @param out  the address to receive into (from `uptr::__unwrap`)
 * @return     1 when an element was delivered, 0 on the Closed sentinel
 * @since 0.3.1 §10
 */
pub extern fn oschan_recv(ch: u64, out: uptr): i64 = "tk_oschan_recv_u" from "teko_rt"

/**
 * oschan_close — send the zero-length CLOSED sentinel so the drained reader observes the closed edge.
 *
 * @param ch  the channel handle
 * @since 0.3.1 §10
 */
pub extern fn oschan_close(ch: u64) = "tk_oschan_close_u" from "teko_rt"

/**
 * oschan_end — close + tear down the reader and cached writer sockets.
 *
 * @param ch  the channel handle
 * @since 0.3.1 §10
 */
pub extern fn oschan_end(ch: u64) = "tk_oschan_end_u" from "teko_rt"

/**
 * producer — the spawned worker half: send `n` ascending i64 values (0..n-1) as fixed-width datagrams
 * into `ch`, then close. Each value's address is taken with `uptr::__unwrap<i64>`.
 *
 * @param ch  the channel handle (crossed the spawn boundary by copy)
 * @param n   how many values to send
 * @since 0.3.1 §10
 */
pub fn producer(ch: u64, n: i64) {
    var i: i64 = 0
    loop {
        if i >= n { break }
        var v = i
        var r = oschan_send(ch, uptr::__unwrap<i64>(v))
        i = i + 1
    }
    oschan_close(ch)
}

/**
 * consume_sum — the main-thread reader half: recv every value from `ch` until the Closed sentinel,
 * summing them.
 *
 * @param ch  the channel handle
 * @return    the sum of every value received before Closed
 * @since 0.3.1 §10
 */
pub fn consume_sum(ch: u64): i64 {
    var sum: i64 = 0
    var running = true
    loop {
        if !running { break }
        var out: i64 = 0
        var r = oschan_recv(ch, uptr::__unwrap<i64>(out))
        if r == 0 { running = false } else { sum = sum + out }
    }
    sum
}
