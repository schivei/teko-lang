match teko::fs::mkdir("spawn_basic_run") {
    error => { }
    null => { }
}
clear_file(0)
clear_file(1)
clear_file(2)
clear_file(3)
spawn worker(0, expected_msg(0))
spawn worker(1, expected_msg(1))
spawn worker(2, expected_msg(2))
spawn worker(3, expected_msg(3))
var ok0 = poll_file(0, expected_msg(0))
var ok1 = poll_file(1, expected_msg(1))
var ok2 = poll_file(2, expected_msg(2))
var ok3 = poll_file(3, expected_msg(3))
if ok0 && ok1 && ok2 && ok3 { exit(0) }
exit(1)
