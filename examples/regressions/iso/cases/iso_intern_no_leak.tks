/**
 * INTERN_KEY — the key the writer test interns and the reader test looks up. A shared constant so
 * the two simulated tests name the SAME cell; the point is whether the reader sees the writer's value.
 */
const INTERN_KEY: str = "x"

/**
 * INTERN_VAL — the value the writer test interns under `INTERN_KEY`. Any non-empty str: the reader
 * only distinguishes present (a non-empty result) from absent (the empty MISS result).
 */
const INTERN_VAL: str = "A"

/**
 * test_writer — the simulated `#test` that DIRTIES the per-task intern table: it enters under the
 * same `task_reset()` the gate applies at every `#test` boundary (E1-C3), then interns the key.
 *
 * @return void
 */
fn test_writer() {
    task_reset()
    _ = intern_put(INTERN_KEY, INTERN_VAL)
}

/**
 * test_reader — the simulated `#test` that reads the intern table WITHOUT writing it, and reports
 * MISS or HIT. It too enters under `task_reset()`, so any residue a neighbouring writer left is gone.
 *
 * @return "MISS" when the key is absent (the correct, hermetic result), else "HIT"
 */
fn test_reader() -> str {
    task_reset()
    let got = intern_get(INTERN_KEY)
    if got.len == 0 { return "MISS" }
    "HIT"
}

/**
 * reader_after_writer — the writer test THEN the reader test (order A -> B). The reader must still
 * MISS: its own entry `task_reset()` clears the value the writer just interned.
 *
 * @return the reader's verdict in this order
 */
fn reader_after_writer() -> str {
    test_writer()
    test_reader()
}

/**
 * reader_before_writer — the reader test THEN the writer test (order B -> A), the reshuffled order.
 * The reader runs first, so there is nothing to leak; the verdict must match the other order exactly.
 *
 * @return the reader's verdict in this order
 */
fn reader_before_writer() -> str {
    let verdict = test_reader()
    test_writer()
    verdict
}

/**
 * probe — run the writer/reader pair in BOTH orders and fold the two verdicts into one stdout line.
 * A hermetic reader answers MISS both times, so the expected line is stable and order-independent.
 *
 * @return the fixed token when both orders MISS, else a FAIL token naming the order that leaked
 */
fn probe() -> str {
    let ab = reader_after_writer()
    let ba = reader_before_writer()
    if ab != "MISS" { return "iso-intern-no-leak FAIL-ab" }
    if ba != "MISS" { return "iso-intern-no-leak FAIL-ba" }
    "iso-intern-no-leak MISS MISS"
}

println(probe())
