type Point3 = struct {
    x: i64
    y: i64
    fn sum(self) -> i64 { self.x + self.y }
    fn scaled(self, factor: i64) -> Point3 { Point3 { x = self.x * factor; y = self.y * factor } }
    fn origin() -> Point3 { Point3 { x = 0; y = 0 } }
    fn make(x: i64, y: i64) -> Point3 { Point3 { x = x; y = y } }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: struct_methods
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q153_struct_methods`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Point -> Point3.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let p1 = Point3 { x = 3; y = 4 }
    let p2 = p1.scaled(2)
    let p3 = Point3::origin()
    let p4 = Point3::make(10, 20)
    if p1.sum() != 7 { exit(1) }
    if p2.x != 6 { exit(2) }
    if p2.y != 8 { exit(3) }
    if p3.x != 0 { exit(4) }
    if p3.y != 0 { exit(5) }
    if p4.x != 10 { exit(6) }
    if p4.y != 20 { exit(7) }
    if p4.sum() != 30 { exit(8) }
}
