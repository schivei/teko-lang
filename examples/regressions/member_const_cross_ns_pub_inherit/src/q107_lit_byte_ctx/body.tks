pub fn byte_binding() -> i64 {
    let x: byte = 0x41
    x to i64
}
pub fn byte_slice_sum() -> i64 {
    let xs: []byte = [0x1, 0x2]
    (xs[0] to i64) + (xs[1] to i64)
}
const B: byte = 5
pub fn const_byte() -> i64 {
    B to i64
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: lit_byte_ctx
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q107_lit_byte_ctx`.
 */
pub fn entry() {
    exit(byte_binding() + byte_slice_sum() + const_byte())
}
