type Describable = interface {
    fn describe(self) -> str
}
type Named = interface Describable {
    fn name_of(self) -> str
}
type Point2 = struct Named {
    x: i64
    fn describe(self) -> str { "point" }
    fn name_of(self) -> str { "P" }
}
type Circle = class & Named {
    pub r: i64
    pub fn make(rr: i64) -> Circle { Circle { r = rr } }
    pub fn describe(self) -> str { "circle" }
    pub fn name_of(self) -> str { "C" }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: interface_conformance
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q094_interface_conformance`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Point -> Point2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let p = Point2 { x = 5 }
    if p.describe() != "point" { exit(1) }
    if p.name_of() != "P" { exit(2) }
    let c = Circle::make(2)
    if c.describe() != "circle" { exit(3) }
    if c.name_of() != "C" { exit(4) }
    if c.r != 2 { exit(5) }
}
