pub type Buf = struct {
    len: u64
    fn empty() -> Buf { Buf { len = 0 } }
}
fn source() -> Buf | error {
    error { message = "boom" }
}
pub fn make(limit: u64) -> (u64) -> Buf | error {
    let f: (u64) -> Buf | error = (max: u64) => {

        let picked = match source() {
            Buf as b => b
            error as e => {
                if max == limit { return e }
                Buf::empty()
            }
        }
        picked
    }
    f
}
pub fn run_through(f: (u64) -> Buf | error, arg: u64) -> Buf | error {
    f(arg)
}
pub fn trailing_marker() -> u64 {
    777
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: lambda_bound_error_union_wrap
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q101_lambda_bound_error_union_wrap`.
 */
pub fn entry() {
        let g = make(5)
        let direct_err = match g(5) {
            Buf as _ => 0 to u64
            error as _ => 10 to u64
        }
        let direct_ok = match g(1) {
            Buf as b => 1 to u64
            error as _ => 0 to u64
        }
        let combinator_err = match run_through(g, 5) {
            Buf as _ => 0 to u64
            error as _ => 10 to u64
        }
        let marker = trailing_marker()
    exit((direct_err + direct_ok + combinator_err + (if marker == 777 to u64 { 9 to u64 } else { 0 to u64 })) to i32)
}
