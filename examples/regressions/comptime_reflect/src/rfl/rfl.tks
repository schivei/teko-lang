/**
 * sizeof — a Family-B comptime returning the SLOT size of `T` (§14 B4): `@sizeof<T>()` binds the type
 * argument to `T`, resolves `T.size` reflection over the concrete type, and folds to the byte-width
 * literal. Explicit type argument, NO value parameter (the "needs no runtime value" comptime, §14.2).
 *
 * @return  the slot size (bytes) of `T`, inlined as a literal
 * @since comptime_reflect (§14 B4 fixture)
 */
comptime sizeof<T>(): i64 { T.size }

/**
 * typename — a Family-B comptime returning the rendered NAME of `T` (§14 B4): `@typename<T>()` resolves
 * `T.name` reflection over the concrete type argument and folds to the string literal.
 *
 * @return  the rendered name of `T`, inlined as a string literal
 * @since comptime_reflect (§14 B4 fixture)
 */
comptime typename<T>(): str { T.name }

/**
 * size_i32 — `@sizeof<i32>()` folds `T.size` over `i32` to 4 (§14 B4).
 *
 * @return  4
 */
pub fn size_i32(): i64 { @sizeof<i32>() }

/**
 * size_bool — `@sizeof<bool>()` folds `T.size` over `bool` to 1 (§14 B4).
 *
 * @return  1
 */
pub fn size_bool(): i64 { @sizeof<bool>() }

/**
 * name_i32 — `@typename<i32>()` folds `T.name` over `i32` to "i32" (§14 B4).
 *
 * @return  "i32"
 */
pub fn name_i32(): str { @typename<i32>() }
