/**
 * run — execute ONE §14 B4 comptime-reflection scenario with an integer result: name it, assert its
 * announced value, and print the `scenario <name>: ok` line the companion `comptime_reflect.tkr` demands
 * BY NAME. Every `run(...)` call in `main.tks` has exactly one matching row and vice versa.
 *
 * @param name  the scenario's name, spelled identically in the `.tkr` `Scenario:` line
 * @param got   what the scenario's probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the scenario and both values
 */
fn run(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}

/**
 * run_str — execute ONE §14 B4 comptime-reflection scenario with a string result: name it, assert its
 * announced text, and print the `scenario <name>: ok` line the companion `comptime_reflect.tkr` demands
 * BY NAME.
 *
 * @param name  the scenario's name, spelled identically in the `.tkr` `Scenario:` line
 * @param got   what the scenario's probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the scenario and both values
 */
fn run_str(name: str, got: str, want: str) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_str(got, want)
    teko::assert::scenario_ok()
}
