# examples/regressions/weak_dead — the COL-F0d `weak_get` fixture (crumb 0024). Proves `weak_get`
# reuses the COL-F0c wrap-refcount table as a non-retaining read: once a wrapped target's count
# reaches zero (freed), `weak_get` returns `null` instead of a dangling reference. The compiler
# holds no `weak_get` callers, so this path is not fixpoint-exercised. Pinned to the C backend: the
# F0d intrinsics emit on the C route only (native = honest-stop).
name = "weak_dead"
source = "src"

[artifact]
kind = "binary"
