#if(os == "linux")
/**
 * a_arm — the first arm's declaration.
 *
 * @return  1
 */
pub fn a_arm(): i64 { return 1 }
#else
/**
 * b_arm — the `#else` arm's declaration; an `#elseif` after `#else` below is rejected.
 *
 * @return  2
 */
pub fn b_arm(): i64 { return 2 }
#elseif(os == "macos")
/**
 * c_arm — an arm illegally declared after `#else`.
 *
 * @return  3
 */
pub fn c_arm(): i64 { return 3 }
#endif
