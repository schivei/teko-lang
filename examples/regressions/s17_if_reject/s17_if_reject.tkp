# examples/regressions/s17_if_reject — the §17 `#if` region REJECT host. Three malformed regions live
# one per namespace under src/, and the single failing build reports each diagnostic: a region never
# closed by `#endif`, an `#elseif` after `#else`, and a `#if()` with no predicate. It has no
# successful build to sanitize/run (it mirrors block_expr_reject).
name = "s17_if_reject"
source = "src"

[artifact]
kind = "binary"
