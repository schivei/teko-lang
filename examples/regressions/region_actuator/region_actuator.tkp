# examples/regressions/region_actuator — the scope-local ARENA routing regressor.
#
# WHAT THIS PINS. A `let`/`mut` local proven non-escaping must have its heap box appended to the
# region of the SCOPE it lives in (freed at that scope's drop), not the process root. Before the
# fix, a boxed `X | null` FIELD of a frame-local struct-init binding (`let head = Node { next =
# tail }`) fell to `tk_region_alloc(tk_region_root())` — leaked, never reclaimed. `chain2_sum`
# exercises that exact class; `build_escaping`/`escape_ok` invert it: an ESCAPING box must ride the
# root and survive its builder's frame drop plus 4096 churn cycles (proven under TEKO_MEM_PARANOID).
#
# The program sums three disjoint weights to 255 — the number the VM, the C route and the native
# route must all agree on, so a divergence in the routing shows as a wrong total, not a crash.
name = "region_actuator"
source = "src"

[artifact]
kind = "binary"
