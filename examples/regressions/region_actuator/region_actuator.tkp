# examples/regressions/region_actuator — o regressor do ACTUADOR DE REGIAO: o selector de
# roteamento deixa de ter dois niveis (moldura da funcao ou raiz) e passa a consultar a regiao do
# BLOCO DONO DO DESTINO.
#
# O projecto tem dois bracos e o segundo e o que manda. O primeiro constroi um acumulador que nasce
# no topo de um bloco, cresce por um self-append enterrado num ciclo aninhado e so e lido dentro
# desse mesmo bloco — o destino cujo dono e o bloco, portanto o que passa a ser roteado para a
# regiao dele. O segundo constroi o MESMO acumulador e entrega-o a uma ligacao de FORA: a analise de
# escape marca-o, o selector tem de RECUSAR a regiao do bloco, e o valor tem de voltar intacto
# depois de 2048 rondas posteriores abrirem e largarem regioes por cima do mesmo armazenamento.
#
# O codigo de saida e 42 so quando os quatro bracos passam; cada falha tem o seu proprio codigo
# (11 = o acumulador do bloco corrompeu-se, 12/13 = o valor escapado foi libertado, 14 = a str
# escapada foi libertada), logo uma regressao diz QUAL das metades cedeu.
name = "region_actuator"
source = "src"

[artifact]
kind = "binary"
