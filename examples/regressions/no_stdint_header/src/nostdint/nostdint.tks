pub fn check(): i64 {
    var buf: [16]u8 = []
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        if buf[i] != 0 { return 1 }
        i = i + 1
    }
    buf[7] = 42
    if buf[7] != 42 { return 2 }
    var x: u8 = 255
    if ((x to i64) + 1) != 256 { return 3 }
    var z: u32 = 4000000000
    if (z to i64) != 4000000000 { return 4 }
    var w: i32 = 0 - 2000000000
    if (w to i64) != (0 - 2000000000) { return 5 }
    0
}
