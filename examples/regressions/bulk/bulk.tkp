# bulk.tkp — the BULK channel: one project, one build, one member namespace per scenario.
#
# THE RULING THIS PROJECT IS (owner 2026-07-26): *"tenho certeza absoluta que a grande maioria das
# regressões caberiam em um ou dois projetos no máximo, o que liberaria para ti outros 7 canais
# (projetos de regressão) para utilizar em casos específicos."* A variation in SOURCE does not need a
# project of its own — it needs a FILE of its own inside one project. Only a variation in BUILD
# CONFIGURATION earns a build. Every scenario here shares the host configuration, so every scenario
# here shares ONE build; `TEKO_REGR_ENTRY` (read by `main.tks`) selects which member's `entry()` runs.
#
# WHAT IT ABSORBED, and why the merge makes the corpus STRONGER rather than merely cheaper. The five
# projects folded in here — `di_same_name_cross_ns`, `iface_value_name_collision_factory`,
# `member_const_cross_ns_pub_inherit`, `qualified_optional` and `same_bare_method_dispatch` — were
# every one of them a CROSS-NAMESPACE COMPOSITION regressor: same bare name, different namespace,
# resolved by canonical identity (issues #109/#149/#284/#290/#594). Compiling them TOGETHER puts five
# `Svc`, two `Reader` and two `Thing` declarations in one build instead of spreading them over five,
# which is exactly the arrangement in which the defect class they pin appears. Density and build
# count point the same way here.
#
# THE RENAMES, named out loud because a silent rename is how coverage disappears. The two NAMESPACE
# renames: `di_same_name_cross_ns`'s `left`/`right` are `di_left`/`di_right` and
# `same_bare_method_dispatch`'s are `sbmd_left`/`sbmd_right`. Both projects declared a `left` and a
# `right`, and a directory IS a namespace, so the four could not keep two names between them. What
# each scenario asserts — two DISTINCT namespaces sharing one bare declaration name — is untouched.
#
# The DECLARATION renames follow ONE rule (`bulk.tkr` states it in full): a bare top-level name
# declared by namespaces from DIFFERENT folded projects is suffixed with its project's tag, and a name
# whose owners all came from the SAME project is left alone. The merge may not CREATE a bare-name
# collision, because the language does not yet resolve every position canonically (structural-trait
# derivation, trait constraints, a top-level `fn` passed as a value and a top-level `const` still key
# off the bare last segment — the #284/#290 defect class); and it may not REMOVE one either, because
# an inherited collision is what several of these scenarios pin. Every collision each project already
# held survives verbatim.
name = "bulk"
source = "src"

[artifact]
kind = "binary"
