/**
 * entry — the restored `np_oop` regressive (deleted by fbeaaa87, which claimed no coverage was
 * lost): NULL-PROPAGATION OVER OOP. Every `T | null` narrowing shape a class/interface/struct
 * introduces — method call, field read, chained nullable successor, unit method in statement
 * position, interface-typed `Shape | null` vtable dispatch, and a `match` whose ARMS are the
 * objects themselves — each with its own exit code, so a regression names the shape that broke.
 *
 * A group MEMBER of the `qualified_optional` project rather than a project of its own: the owner's
 * 10-`.tkr` mandate leaves nine regressive projects, and a namespace (`qualified_optional::np_oop`)
 * is the language's own answer to hosting an unrelated fixture inside one of them without
 * colliding with it. Selected by `TEKO_REGR_ENTRY=np_oop`; runs off the project's ONE build.
 *
 * @return void — diverges with the scenario's exit code
 */
pub fn entry() {
    let c: Counter | null = Counter::make(7)
    let v1 = match c { null => 0; Counter as cc => cc.get() }
    if v1 != 7 { exit(1) }
    let none: Counter | null = null
    let v2 = match none { null => 42; Counter as cc => cc.get() }
    if v2 != 42 { exit(2) }

    let v3 = match c { null => 0; Counter as cc => cc.plus(3) }
    if v3 != 10 { exit(3) }

    let v4 = match c { null => 0; Counter as cc => cc.n }
    if v4 != 7 { exit(4) }
    let v5 = match none { null => 5; Counter as cc => cc.n }
    if v5 != 5 { exit(5) }

    let step6: Counter | null = match c { null => null; Counter as cc => cc.next() }
    let v6 = match step6 { null => 0; Counter as cc => cc.get() }
    if v6 != 8 { exit(6) }
    let step7: Counter | null = match c { null => null; Counter as cc => cc.maybe_next() }
    let v7 = match step7 { null => 0; Counter as cc => cc.n }
    if v7 != 8 { exit(7) }
    let step8: Counter | null = match none { null => null; Counter as cc => cc.next() }
    let v8 = match step8 { null => 9; Counter as cc => cc.get() }
    if v8 != 9 { exit(8) }

    match c { null => { }; Counter as cc => cc.poke() }
    match none { null => { }; Counter as cc => cc.poke() }

    // The interface half of the fixture: `Circle` conforms to `Shape`, and the vtable slot is
    // dispatched directly. The `Shape | null` cells the ORIGINAL fixture also carried (an
    // interface-typed null-union, narrowed by `match`) are HELD BACK, not dropped: `resolve` stops
    // today with "an interface cannot be a variant member yet". They are pinned as a known-stop
    // compile-fail row in this project's `.tkr`, so the day support lands the pin fails LOUDLY and
    // forces a conscious promotion back into this body.
    let circ = Circle::make(2)
    if circ.area() != 12 { exit(9) }

    let a = Counter::make(1)
    let b = Counter::make(2)
    let p11 = match none { null => b; Counter as cc => cc }
    if p11.get() != 2 { exit(11) }
    let some: Counter | null = a
    let p12 = match some { null => b; Counter as cc => cc }
    if p12.get() != 1 { exit(12) }

    let bx: Box_qopt | null = Box_qopt { v = 6 }
    let v15 = match bx { null => 0; Box_qopt as bb => bb.doubled() }
    if v15 != 12 { exit(15) }
    let v16 = match bx { null => 0; Box_qopt as bb => bb.v }
    if v16 != 6 { exit(16) }
    let nobox: Box_qopt | null = null
    let v17 = match nobox { null => 3; Box_qopt as bb => bb.doubled() }
    if v17 != 3 { exit(17) }

    exit(0)
}
