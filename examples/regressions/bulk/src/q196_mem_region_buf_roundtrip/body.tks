/**
 * A LOCAL COPY of `teko::mem::unsafe::Arena` (see `q023_arena_manual_ok/body.tks` for the same
 * shape's original regression, `src/mem/unsafe/arena.tks` for the canonical stdlib type).
 */
#must_free
pub unsafe type Arena = struct {
    /** The raw `tk_region *` this handle owns, carried as an opaque `uptr`; 0 once bulk-freed. */
    region: uptr

    /**
     * Opens a fresh manual region (a new child of the process root) and wraps its raw handle.
     *
     * @return a fresh `Arena` owning a newly opened child region
     */
    pub fn new() -> Arena {
        Arena { region = teko::mem::region_new() }
    }
}

/**
 * entry's body — `teko::mem::region_buf` (c-types-and-marshalling-0.3.1.md §7.3, crumb C5):
 * allocate `"hello\0"` (6 octets) INTO a dev-named `Arena`, read the octets back through the
 * terminator, and free the region. Exit 0 iff the round trip recovers exactly `"hello"`'s length.
 */
pub unsafe fn probe_region_buf() -> i32 {
    mut a = Arena::new()
    let buf = teko::mem::region_buf(a.region, 6, "hello")
    let read_back = teko::mem::str_from_c(buf, 6)
    teko::mem::free(a)
    if read_back.len == 5 { 0 } else { 1 }
}

/**
 * entry — F10 c-types-and-marshalling — mem_region_buf_roundtrip.
 */
pub fn entry() {
    exit(probe_region_buf())
}
