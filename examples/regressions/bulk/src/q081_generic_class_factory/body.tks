type Cell<T> = class {
    /** The held value. */
    pub v: T

    /**
     * Build a `Cell<T>` holding `x` — the generic static factory L5 delivers (`Cell<i64>::make(7)`).
     *
     * @param x  the value to hold, of the instance's concrete `T`
     * @return   a fresh `Cell<T>` holding `x`
     */
    pub fn make(x: T) -> Cell<T> { Cell { v = x } }

    /**
     * Read the held value.
     *
     * @return the held `T`, at whatever concrete type this instance was stamped to
     */
    pub fn read(self) -> T { self.v }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: generic_class_factory
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q081_generic_class_factory`.
 */
pub fn entry() {
    let ci = Cell<i64>::make(7)
    let cs = Cell<str>::make("ab")
    exit((ci.read() + (cs.read().len to i64)) to i32)
}
