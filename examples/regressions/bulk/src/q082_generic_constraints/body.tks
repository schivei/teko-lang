type Numeric = variant i64 | f64
type Textual = variant str | byte
fn identity_numeric<T: Numeric>(x: T) -> T { return x }
fn identity_numeric_or_textual<T: Numeric | Textual>(x: T) -> T { return x }
fn identity_numeric_and_numeric<T: Numeric & Numeric>(x: T) -> T { return x }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: generic_constraints
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q082_generic_constraints`.
 */
pub fn entry() {
    let a = identity_numeric(7)
    let b = identity_numeric(2.5)
    let c = identity_numeric_or_textual(7)
    let d = identity_numeric_or_textual("hi")
    let e = identity_numeric_and_numeric(9)
    if a != 7 { exit(1) }
    if b != 2.5 { exit(2) }
    if c != 7 { exit(3) }
    if d != "hi" { exit(4) }
    if e != 9 { exit(5) }
}
