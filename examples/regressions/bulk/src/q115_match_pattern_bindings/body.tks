pub type Circle_iface = struct { radius: i64 }
pub type Square_iface = struct { side: i64 }
pub type Shape_iface = variant Circle_iface | Square_iface
pub fn f1() -> i64 {
    let s: Shape_iface = Circle_iface { radius = 1 }
    match s {
        Circle_iface { radius } => radius
        Square_iface { side } => side
    }
}
pub fn f2() -> i64 {
    let s: Shape_iface = Circle_iface { radius = 2 }
    match s {
        Circle_iface as c => c.radius
        Square_iface as q => q.side
    }
}
pub fn f3() -> i64 {
    let s: Shape_iface = Square_iface { side = 3 }
    match s {
        Circle_iface { radius } => radius
        Square_iface { side } => side
    }
}
