/** A DI contract in the `di_right` namespace — same BARE name (`Face`) as `di_left::Face`. Distinct
 *  canonical name (`di_right::Face`) keeps it a separate DI provider slot (issue #284). */
type Face = interface {
    fn tag(self) -> i64
}

#singleton
/** A `#singleton` provider named `Svc_di` — the SAME bare class name as `di_left::Svc_di`. Its `n` is 2, so
 *  if the two same-bare providers collided the injected `di_right::Face` would wrongly answer 1. */
type Svc_di = class & Face {
    pub n: i64

    pub fn make() -> Svc_di { Svc_di { n = 2 } }
    pub fn tag(self) -> i64 { self.n }
}

#inject(f: Face)
/** Inject `di_right::Face`; a correct provider resolution binds `di_right::Svc_di` (its `n` is 2). Calls the
 *  instance METHOD `tag()` — a same-bare cross-namespace dispatch that only resolves to the right
 *  class once #290 keys off the canonical `di_right::Svc_di`; the earlier `f.n` field-read was the #290
 *  workaround (fields always resolved canonically via the type table). */
fn ask() -> i64 {
    f.tag()
}
