/**
 * A LOCAL COPY of `teko::c_types::c_string` + its tier-1 constructor/extractor
 * (c-types-and-marshalling-0.3.1.md §7.1/§7.2, crumb C4) — a regression fixture cannot `use` the
 * compiler's own stdlib (the house convention `c55_unsafe_field_in_safe_struct/case.tks` follows
 * too). See `staged/c_types/c_types.tks` for the canonical, fully-documented original.
 */
pub unsafe type LocalCString = struct {
    /** The base address of a NUL-terminated buffer. */
    ptr: ptr<byte>

    /** The payload length, excluding the terminator. */
    len: u64
}

/** See `teko::c_types::c_string_for_call` — tier 1, the enclosing-region constructor. */
pub unsafe fn local_cstring_for_call(s: str) -> LocalCString {
    LocalCString { ptr = teko::mem::as_cstr(s); len = s.len }
}

/** See `teko::c_types::c_string_ptr` — the single-word extraction. */
pub unsafe fn local_cstring_ptr(s: LocalCString) -> ptr<byte> {
    s.ptr
}

/**
 * The C string-length primitive, reached DIRECTLY as a C symbol — the extern this fixture's
 * round trip crosses through.
 *
 * @param s  a NUL-terminated buffer's base address
 * @return   the number of octets before the terminator
 */
pub extern fn c_strlen(s: ptr<byte>) -> u64 = "strlen"

/**
 * entry — F10 c-types-and-marshalling — c_string_roundtrip. `str` -> `c_string` -> a libc extern
 * (`strlen` via `ptr<byte>`) -> `str_from_c` -> compare. Exit 0 iff C measured the SAME length the
 * Teko `str` declares AND the octets read back through the terminator match the original.
 */
pub unsafe fn entry() {
    let original = "hello"
    let cs = local_cstring_for_call(original)
    let measured = c_strlen(local_cstring_ptr(cs))
    let read_back = teko::mem::str_from_c(local_cstring_ptr(cs), measured)
    let ok = measured == cs.len && read_back.len == original.len
    exit(if ok { 0 } else { 1 })
}
