type Base = interface {
    fn value(self) -> i64
}
#singleton
type Leaf = class & Base {
    pub v: i64

    pub fn make() -> Leaf { Leaf { v = 7 } }
    pub fn value(self) -> i64 { self.v }
}
type Composite = interface {
    fn total(self) -> i64
}
#singleton
type Sum = class & Composite {
    pub carried: i64

    pub fn make() -> Sum { Sum { carried = injected_base_value() } }
    pub fn total(self) -> i64 { self.carried + 1 }
}
#inject(base: Base)
fn injected_base_value() -> i64 {
    base.value()
}
#inject(c: Composite)
fn composed_total() -> i64 {
    c.total()
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: di_recursive
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q066_di_recursive`.
 */
pub fn entry() {
    if composed_total() != 8 { exit(1) }
}
