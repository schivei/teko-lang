pub fn build_with_cap() -> []i64 {
    mut xs: []i64 = teko::list::with_cap(3)
    xs = teko::list::push(xs, 10)
    xs = teko::list::push(xs, 20)
    xs = teko::list::push(xs, 30)
    xs
}
pub fn build_plain() -> []i64 {
    mut xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 10)
    xs = teko::list::push(xs, 20)
    xs = teko::list::push(xs, 30)
    xs
}
pub fn slices_equal(a: []i64, b: []i64) -> bool {
    if a.len != b.len { return false }
    mut i: u64 = 0
    loop {
        if i >= a.len { return true }
        if a[i] != b[i] { return false }
        i = i + 1
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: list_with_cap_matches_push
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q105_list_with_cap_matches_push`.
 */
pub fn entry() {
    let a = build_with_cap()
    let b = build_plain()
    exit(if slices_equal(a, b) { 42 } else { 1 })
}
