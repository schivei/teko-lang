pub type Date = struct { days: i32 }
pub extern fn date_from_days(d: i32) -> Date = "tk_rt_date_from_days" from "teko_rt"
pub extern fn date_year(d: Date) -> i32 = "tk_rt_date_year" from "teko_rt"
pub fn epoch_year() -> i32 { date_year(date_from_days(0)) }
pub fn y2021_year() -> i32 { date_year(date_from_days(18628)) }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: time_types
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q156_time_types`.
 */
pub fn entry() {
    exit((y2021_year() - epoch_year()))
}
