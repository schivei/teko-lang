/**
 * A LOCAL COPY of `teko::c_types`'s alias shape (`docs/design/c-types-and-marshalling-0.3.1.md`
 * §5.1, crumb C1) — a regression fixture cannot `use` the compiler's own stdlib (the house
 * convention `c55_unsafe_field_in_safe_struct/case.tks` also follows). Three of the twelve
 * aliases, chosen to span sign and width: `c_int` (i32), `c_uchar` (u8), `c_ulonglong` (u64).
 */
pub type c_int = i32

/** See `c_int`'s doc-comment — the unsigned 8-bit twin under test here. */
pub type c_uchar = u8

/** See `c_int`'s doc-comment — the 64-bit twin under test here. */
pub type c_ulonglong = u64

/**
 * A function that RECEIVES and RETURNS each alias — the §2.1 measurement this fixture exists to
 * bank: no alias to a bare PRIMITIVE existed anywhere in the corpus before this design, and the
 * resolution path (`resolve_named` -> `builtin_type`) is mechanically identical to an alias
 * targeting a slice/union/named type but was, until now, unproven.
 *
 * @param c_int i  passed straight through
 * @return c_int  the same value, unchanged
 */
pub fn round_trip_int(i: c_int) -> c_int {
    i
}

/** See `round_trip_int` — the `u8` twin. */
pub fn round_trip_uchar(u: c_uchar) -> c_uchar {
    u
}

/** See `round_trip_int` — the `u64` twin. */
pub fn round_trip_ulonglong(n: c_ulonglong) -> c_ulonglong {
    n
}

/**
 * entry — F10 c-types-and-marshalling — c_types_alias_identity. A value assigned THROUGH each
 * alias and back is unchanged, AND the alias is exactly its aliased primitive — no wider, no
 * narrower (proven by ordinary arithmetic on the round-tripped value, which would not type-check
 * against a differently-widthed alias).
 */
pub fn entry() {
    let i: c_int = 5
    let u: c_uchar = 2
    let n: c_ulonglong = 0
    let ri = round_trip_int(i)
    let ru = round_trip_uchar(u)
    let rn = round_trip_ulonglong(n)
    let total: i32 = ri + (ru to i32) + (rn to i32)
    exit(total)
}
