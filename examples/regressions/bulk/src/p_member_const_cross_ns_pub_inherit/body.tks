use sub

/**
 * entry — the `member_const_cross_ns_pub_inherit` regression (#594 crumb 7): a `pub` member const's
 * visibility REACHES across namespaces, including through an inheriting subclass declared in a
 * different namespace. `Base` lives in this project's ROOT namespace and `Sub` in `sub`, so the
 * boundary the assertion depends on is a real one — with a single namespace the claim would be
 * vacuous.
 *
 * @return void — diverges with the scenario's exit code
 */
pub fn entry() {
    let s = sub::Sub::make(7)
    if sub::reach() != 5 { exit(1) }
    if s.kind() != 7 { exit(2) }
    exit(42)
}
