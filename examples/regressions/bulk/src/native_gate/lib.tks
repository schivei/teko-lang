// native_gate_coercions (#265) — the constructs the NATIVE test gate first forced through codegen.
//
// The ORIGINAL fixture (deleted by fbeaaa87) carried three. TWO of them are `[](i64 | null)` slots
// — a bare `[]i64` present-wrapped into a slice-of-null-union PARAM, and the same into a struct
// FIELD of that type. Neither can be written at all on today's surface, and this was VERIFIED, not
// assumed: `[](` is read by the parser as a FUNCTION type ("a function type '(A, B) -> R' needs
// '->' before the return type"), and spelling the element through a type alias reaches the codegen
// stop instead ("optional/slice inner type not yet supported"). That is exactly the gap
// regressor.tkr's F3 header already declares honest. Both spellings are PINNED as known-stop
// compile-fail rows in this project's `.tkr`, so the day either one lands the pin fails LOUDLY and
// these two checks get promoted back into `entry()`.
//
// The THIRD is expressible today and is asserted for real.

/** make_ints — a bare `[]i64`, the value the present-wrap cells consume. */
fn make_ints() -> []i64 { teko::list::push(teko::list::push(teko::list::empty(), 11), 22) }

/** sum_opt — the param-slot read, over the bare `[]i64` the surface can express today. */
fn sum_opt(xs: []i64) -> i64 { xs[0] + xs[1] }

/** IntHolder — the struct whose field the pinned `[](i64 | null)` field cell would type. */
type IntHolder = struct { xs: []i64 }

/** field_sum — the field-slot twin of sum_opt: build the holder from a bare `[]i64`, read it back. */
fn field_sum() -> i64 {
    let h = IntHolder { xs = make_ints() }
    h.xs[0] + h.xs[1]
}

/** not_u8 — bitwise NOT of a `u8` zero, re-narrowed to the u8 width (0xFF == 255, never -1). */
fn not_u8() -> u8 { let m: u8 = 0; ~m }
