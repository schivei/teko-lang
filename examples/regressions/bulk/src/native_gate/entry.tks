/**
 * entry — the restored `native_gate_coercions` regressive (#265, deleted by fbeaaa87 with the same
 * false claim): the three constructs the NATIVE test gate first forced through codegen — a bare
 * `[]T` into a `[](T | null)` PARAM (element-wise present-wrap), the same into a `[](T | null)`
 * struct FIELD, and `~` on a sub-`int` unsigned prim (C integer-promotes `(u8)0` before `~`, so the
 * result must be re-narrowed to the u8 width: 255, not -1). Falling off the end exits 21.
 *
 * A group MEMBER of the `qualified_optional` project (namespace `qualified_optional::native_gate`),
 * selected by `TEKO_REGR_ENTRY=native_gate_coercions` — it runs off the project's ONE build.
 */
pub fn entry() {
    if sum_opt(make_ints()) != 33 { exit(1) }
    if field_sum() != 33 { exit(2) }
    if (not_u8() to i64) != 255 { exit(3) }

    exit(21)
}
