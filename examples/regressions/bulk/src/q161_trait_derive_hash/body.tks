pub type Item = struct Hash {
    id: i64
    name: str
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_derive_hash
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q161_trait_derive_hash`.
 */
pub fn entry() {
    let a = Item { id = 7; name = "alpha" }
    let b = Item { id = 7; name = "alpha" }
    let c = Item { id = 8; name = "alpha" }
    let d = Item { id = 7; name = "omega" }
    if a.hash() != b.hash() { exit(1) }
    if a.hash() == c.hash() { exit(2) }
    if a.hash() == d.hash() { exit(3) }
    if a.hash() != a.hash() { exit(4) }
    exit(0)
}
