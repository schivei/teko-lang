type Point_mcni = struct { x: i64; y: i64 }
fn maybe_point(present: bool) -> Point_mcni | null {
    if present { return Point_mcni { x = 21; y = 21 } }
    null
}
fn read_or(p: Point_mcni | null, fallback: i64) -> i64 {
    match p { Point_mcni as v => v.x + v.y; null => fallback }
}

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: forward an un-narrowed null-union return
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q007_forward_an_un_narrowed_null_union_retu`.
 */
pub fn entry() {
    exit(read_or(maybe_point(true), 0) + read_or(maybe_point(false), 0))
}
