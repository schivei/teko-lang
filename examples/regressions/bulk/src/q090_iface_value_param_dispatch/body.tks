type Reader_sbmd = interface {
    /**
     * read — yield the reader's value offset by `n`.
     *
     * @param n  the caller's per-read offset
     * @return   the reader's stored value plus `n`
     */
    fn read(self, n: i64) -> i64
}
type Fixed_sbmd = class & Reader_sbmd {
    /** The reader's stored base value. */
    pub v: i64

    /**
     * make — build a `Fixed_sbmd` over the base value `x`.
     *
     * @param x  the stored base value
     * @return   the constructed reader
     */
    pub fn make(x: i64) -> Fixed_sbmd { Fixed_sbmd { v = x } }

    /**
     * read — the `Reader_sbmd` contract: base value plus the caller's offset.
     *
     * @param n  the caller's per-read offset
     * @return   `self.v + n`
     */
    pub fn read(self, n: i64) -> i64 { self.v + n }
}
pub fn pull(r: Reader_sbmd, n: i64) -> i64 {
    let a = r.read(n)
    let b = r.read(n + 1)
    a + b
}
pub fn scenario_sbmd() -> i64 { pull(Fixed_sbmd::make(1), 2) }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iface_value_param_dispatch
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q090_iface_value_param_dispatch`.
 */
pub fn entry() {
    exit(scenario_sbmd())
}
