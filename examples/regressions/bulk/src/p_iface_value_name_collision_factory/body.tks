use stream

/**
 * entry — the `iface_value_name_collision_factory` regression (issue #109): a private `codec::Reader`
 * struct and a dynamic-dispatch `stream::Reader` interface share the SAME bare last segment, and a
 * bare-`Reader`-typed method param must bind in its OWNER module's namespace rather than whichever
 * same-bare declaration the resolver happens to visit first.
 *
 * @return void — diverges with the scenario's exit code
 */
pub fn entry() {
    exit(stream::scenario())
}
