type Counter2_sbmd = class {
    intern n: i64
    pub fn make() -> Counter2_sbmd { Counter2_sbmd { n = 0 } }
    pub fn bump(self) { self.n = self.n + 1 }
    pub fn set(self, v: i64) { self.n = v }
    pub fn get(self) -> i64 { self.n }
}
type Box_sbmd = class {
    pub val: i64
    pub fn make() -> Box_sbmd { Box_sbmd { val = 1 } }
}
type Point2_sbmd = struct { x: i64; y: i64 }
type Inner_sbmd = struct { z: i64 }
type Outer_sbmd = struct { inner: Inner_sbmd; w: i64 }
fn bump_local_copy(p: Point2_sbmd) -> i64 {
    mut local = p
    local.x = 999
    local.x
}
type Acc = class {
    intern total: i64
    pub fn make() -> Acc { Acc { total = 0 } }
    pub fn run(self) {
        defer { self.total = self.total + 1000 }
        mut i = 0
        loop {
            if i >= 3 { break }
            self.total = self.total + i
            i++
        }
    }
    pub fn get(self) -> i64 { self.total }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: field_assignment
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q076_field_assignment`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Counter -> Counter2_sbmd, Point -> Point2_sbmd.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let a = Counter2_sbmd::make()
    let b = a
    a.bump()
    a.bump()
    b.bump()
    if a.get() != 3 { exit(1) }
    if b.get() != 3 { exit(2) }
    a.set(42)
    if a.get() != 42 { exit(3) }
    if b.get() != 42 { exit(4) }
    let box = Box_sbmd::make()
    box.val = 100
    if box.val != 100 { exit(5) }
    mut p = Point2_sbmd { x = 1; y = 2 }
    p.x = 10
    p.y = p.y + 5
    p.x += 3
    if p.x != 13 { exit(6) }
    if p.y != 7 { exit(7) }
    let acc = Acc::make()
    acc.run()
    if acc.get() != 1003 { exit(8) }
    mut s1 = Point2_sbmd { x = 1; y = 2 }
    mut s2 = s1
    s2.x = 99
    if s1.x != 1 { exit(9) }
    if s2.x != 99 { exit(10) }
    let arg = Point2_sbmd { x = 5; y = 6 }
    let got = bump_local_copy(arg)
    if got != 999 { exit(11) }
    if arg.x != 5 { exit(12) }
    mut o1 = Outer_sbmd { inner = Inner_sbmd { z = 1 }; w = 10 }
    mut o2 = o1
    o2.inner.z = 77
    if o1.inner.z != 1 { exit(13) }
    if o2.inner.z != 77 { exit(14) }
    if o1.w != 10 { exit(15) }
    exit(0)
}
