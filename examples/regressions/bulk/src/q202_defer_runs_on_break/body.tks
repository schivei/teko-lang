/**
 * same_scope_break — a `defer` registered in the SAME loop-body block as the `break` that leaves
 * it must fire before the loop's own exit.
 *
 * @return 101 (1, then `+100` from the defer)
 */
fn same_scope_break() -> i64 {
    mut acc: i64 = 1
    loop {
        defer { acc = acc + 100 }
        break
    }
    return acc
}

/**
 * outer_scope_break — a `defer` registered in the FUNCTION's own (outer) block, with the `break`
 * written inside the loop it wraps, still fires — at the function's own later fall-through/return,
 * since `break` only crosses scopes down to & including its target loop (owner-confirmed limit).
 *
 * @return 11 (1, then `+10` from the outer defer, fired once the function itself returns)
 */
fn outer_scope_break() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    loop {
        break
    }
    return acc
}

/**
 * entry — the `break` row of the five-exits x two-scopes defer matrix (owner ruling 2026-07-29):
 * `break` already fires the pending defer in both the loop's own block and an outer one; this
 * fixture pins that as a permanent regression lock. Selected by
 * `TEKO_REGR_ENTRY=q202_defer_runs_on_break`.
 */
pub fn entry() {
    exit((same_scope_break() + outer_scope_break()) to i32)
}
