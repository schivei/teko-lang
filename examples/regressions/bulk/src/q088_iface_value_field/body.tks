type Reader_mcni = interface {
    /**
     * read — the reader's value.
     *
     * @return  the stored value
     */
    fn read(self) -> i64
}
type Fixed_mcni = class & Reader_mcni {
    /** The stored value. */
    pub v: i64

    /**
     * make — a `Fixed_mcni` over the value `x`.
     *
     * @param x  the stored value
     * @return   the constructed reader
     */
    pub fn make(x: i64) -> Fixed_mcni { Fixed_mcni { v = x } }

    /**
     * read — the `Reader_mcni` contract: the stored value.
     *
     * @return  `self.v`
     */
    pub fn read(self) -> i64 { self.v }
}
type Holder = struct {
    /** The held reader, dispatched through its contract. */
    r: Reader_mcni
}
pub fn held_value(h: Holder) -> i64 {
    h.r.read()
}
pub fn scenario_mcni() -> i64 {
    let h = Holder { r = Fixed_mcni::make(42) }
    if held_value(h) != 42 { return 1 }
    0
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iface_value_field
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q088_iface_value_field`.
 */
pub fn entry() {
    exit(scenario_mcni())
}
