/**
 * A LOCAL COPY of the `teko::c_types` shapes this fixture exercises (c-types-and-marshalling-
 * 0.3.1.md §10 C8 — the corpus adoption of `arena_teko/src/full_gate.tks`'s `setenv`/`unsetenv`,
 * migrated off the `u64`-address idiom onto `ptr<byte>` + `c_int`). See `src/c_types/c_types.tks`
 * for the canonical originals.
 */
pub type c_int = i32

/** See `teko::c_types::c_string` — the tier-1 NUL-terminated owning handle. */
pub unsafe type LocalCString = struct {
    /** The base address of a NUL-terminated buffer. */
    ptr: ptr<byte>

    /** The payload length, excluding the terminator. */
    len: u64
}

/** See `teko::c_types::c_string_for_call`. */
pub unsafe fn local_cstring_for_call(s: str) -> LocalCString {
    LocalCString { ptr = teko::mem::as_cstr(s); len = s.len }
}

/** See `teko::c_types::c_string_ptr`. */
pub unsafe fn local_cstring_ptr(s: LocalCString) -> ptr<byte> {
    s.ptr
}

/**
 * `setenv`, reached DIRECTLY as a C symbol and TYPED per §5.4.5: `name`/`value` are `ptr<byte>`
 * (NUL is EINVAL/UB — never `| null`), `overwrite`/the return are `c_int` — the two prose
 * obligations `full_gate.tks:45` carried in an `@param`/hand-rolled `i32` become types here.
 */
pub extern unsafe fn c_setenv(name: ptr<byte>, value: ptr<byte>, overwrite: c_int) -> c_int = "setenv"

/** `unsetenv`, reached DIRECTLY as a C symbol — the counterpart migration. */
pub extern unsafe fn c_unsetenv(name: ptr<byte>) -> c_int = "unsetenv"

/**
 * entry's body — `setenv` a probe variable through the typed `c_string`/`c_int` surface, confirm
 * it landed via the host `teko::env::var` surface, `unsetenv` it, and confirm it is gone. Exit 0
 * iff both the set and the unset each observed exactly what the C contract promises.
 */
pub unsafe fn probe_setenv_typed() -> i32 {
    let name = local_cstring_for_call("TEKO_C_TYPES_SETENV_TYPED_PROBE")
    let value = local_cstring_for_call("typed-ok")
    let overwrite: c_int = 1
    let set_rc = c_setenv(local_cstring_ptr(name), local_cstring_ptr(value), overwrite)
    if set_rc != 0 { return 93 }
    let seen = match teko::env::var("TEKO_C_TYPES_SETENV_TYPED_PROBE") { str as v => v; error => "" }
    if seen != "typed-ok" { return 94 }
    let unset_rc = c_unsetenv(local_cstring_ptr(name))
    if unset_rc != 0 { return 95 }
    let gone = match teko::env::var("TEKO_C_TYPES_SETENV_TYPED_PROBE") { str as v => v; error => "" }
    if gone != "" { return 96 }
    0
}

/**
 * entry — F10 c-types-and-marshalling — c_probe_setenv_typed.
 */
pub fn entry() {
    exit(probe_setenv_typed())
}
