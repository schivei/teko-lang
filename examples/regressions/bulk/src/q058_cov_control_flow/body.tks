pub fn classify_stmt_if(n: i64) -> i64 {
    mut r: i64 = 0
    if n < 0 {
        r = 1
    } else {
        if n == 0 {
            r = 2
        } else {
            r = 3
        }
    }
    r
}
pub fn classify_value_if(n: i64) -> i64 {
    let v = if n > 0 { 10 } else { 20 }
    v
}
pub fn kind_value_match(n: i64) -> i64 {
    let k = match n {
        0 => 100
        1 => 200
        _ => 300
    }
    k
}
pub fn kind_tail_match(n: i64) -> i64 {
    match n {
        2 => 7
        3 => 8
        _ => 9
    }
}
pub fn bare_if_no_else(n: i64) -> i64 {
    mut r: i64 = 0
    if n == (n / 2) * 2 {
        r = 5
    }
    r
}
pub fn multi_line_sum(n: i64) -> i64 {
    n +
    classify_stmt_if(n) +
    classify_value_if(n)
}
pub fn total_qopt() -> i64 {
    let a = classify_stmt_if(-3)
    let b = classify_value_if(4)
    let c = kind_value_match(1)
    let d = kind_tail_match(3)
    let e = bare_if_no_else(6)
    let f = multi_line_sum(2)
    a + b + c + d + e + f - 197
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: cov_control_flow
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q058_cov_control_flow`.
 */
pub fn entry() {
    exit((total_qopt()) to i32)
}
