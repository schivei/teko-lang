pub fn count_present(r: ref i32 | null) -> i32 {
    match r {
        null => 0
        Ref<i32> => 1
    }
}
pub fn use_optional_ref() -> i32 {
    mut x: i32 = 7
    count_present(&x) * 7 + count_present(null) + 20
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: ref_null_admit
