pub type UnaryFn = (u64) -> u64
fn apply(f: UnaryFn, x: u64) -> u64 {
    f(x)
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: noncapturing_lambda_lift
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q130_noncapturing_lambda_lift`.
 */
pub fn entry() {
        let triple: UnaryFn = (x: u64) => x * 3 to u64
        let a = apply(triple, 1 to u64)
        let plus_three: UnaryFn = (x: u64) => x + 3 to u64
        let b = plus_three(1 to u64)
    exit((a + b) to i32)
}
