/**
 * same_scope_panic — an unqualified `panic` call, and the `defer` guarding it, in the SAME block:
 * before the W15/#defer-nas-saidas fix this defer never ran (the `panic` call is a divergent
 * CALL, not a keyword the replay machinery recognized). `eprintln` (stderr, unbuffered) is the
 * marker — `abort()` never flushes a buffered stream, so a `println` probe would lie (§6.11.1).
 */
fn same_scope_panic() {
    eprintln("same:start")
    if true {
        defer { eprintln("same:defer") }
        panic("q204 same-scope")
    }
}

/**
 * outer_scope_panic — the SAME defect, one lexical level out: the `defer` is registered in the
 * FUNCTION's own (outer) block, and the `panic` fires from a NESTED `if` inside it — mirrors the
 * architect's own `teko_deferprobe__body` reproduction (harness doc §18.1).
 */
fn outer_scope_panic() {
    defer { eprintln("outer:defer") }
    eprintln("outer:start")
    if true {
        panic("q204 outer-scope")
    }
}

/**
 * entry — the escopo-exterior half of the `panic` row (five-exits x two-scopes defer matrix,
 * owner ruling 2026-07-29): mirrors the architect's own `teko_deferprobe__body` reproduction
 * (harness doc §18.1). Selected by `TEKO_REGR_ENTRY=q204_defer_runs_on_explicit_panic`.
 */
pub fn entry() {
    outer_scope_panic()
}

/**
 * entry_same — the mesmo-escopo half: `defer` and `panic` in the SAME block. Selected by
 * `TEKO_REGR_ENTRY=q204_defer_runs_on_explicit_panic__same`.
 */
pub fn entry_same() {
    same_scope_panic()
}
