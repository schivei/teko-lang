pub type Timestamped = trait {
    created_at: i64
    updated_at: i64
    fn age(self) -> i64 { self.updated_at - self.created_at }
    fn label(self) -> str
}
pub type Tagged = trait {
    tag_count: i64
    fn describe(self) -> str { "tagged" }
}
pub type Tagged2 = trait {
    fn describe(self) -> str { "tagged2" }
}
pub type Post = struct Timestamped & Tagged {
    title: str
    fn label(self) -> str { self.title }
}
pub type Both = struct Tagged & Tagged2 {
    n: i64
    fn describe(self) -> str { "both" }
}
pub type Svc_iface = class & Timestamped {
    name: str
    pub fn make(n: str, c: i64, u: i64) -> Svc_iface { Svc_iface { name = n; created_at = c; updated_at = u } }
    pub fn label(self) -> str { self.name }
    pub fn span(self) -> i64 { self.age() }
}
pub fn trait_plus_one(trait: i64) -> i64 { trait + 1 }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_basics
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q157_trait_basics`.
 */
pub fn entry() {
    let p = Post { title = "hello"; created_at = 10; updated_at = 25; tag_count = 3 }
    if p.created_at != 10 { exit(1) }
    if p.tag_count != 3 { exit(2) }
    if p.age() != 15 { exit(3) }
    if p.label() != "hello" { exit(4) }
    if p.describe() != "tagged" { exit(5) }
    let b = Both { n = 1; tag_count = 2 }
    if b.describe() != "both" { exit(6) }
    let s = Svc_iface::make("svc", 100, 160)
    if s.span() != 60 { exit(7) }
    if s.label() != "svc" { exit(8) }
    let t = s
    if t.span() != 60 { exit(9) }
    let trait = 41
    if trait_plus_one(trait) != 42 { exit(10) }
    exit(0)
}
