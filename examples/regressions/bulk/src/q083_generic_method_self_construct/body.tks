type Box_mcni<T> = struct {
    /** The boxed value. */
    value: T

    /**
     * Duplicate this box — constructs a NEW `Box_mcni<T>` of the same concrete `T`, proving a method body
     * may construct its own generic template type (the self-construct L4 delivers).
     *
     * @return a fresh `Box_mcni<T>` carrying a copy of this box's value
     */
    pub fn dup(self) -> Box_mcni<T> { Box_mcni { value = self.value } }

    /**
     * Read the boxed value.
     *
     * @return the boxed `T`, at whatever concrete type this instance was stamped to
     */
    pub fn get(self) -> T { self.value }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: generic_method_self_construct
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q083_generic_method_self_construct`.
 */
pub fn entry() {
    let bi = Box_mcni<i64> { value = 21 }
    let bu = Box_mcni<u8> { value = 21 }
    exit((bi.dup().get() + (bu.dup().get())) to i32)
}
