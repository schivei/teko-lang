/**
 * entry — F2 language corpus — folded EXPECT_EXIT single-file fixtures (dobrado, dir removido)
 *          :: comptime_fold_local
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q016_comptime_fold_local`.
 */
pub fn entry() {
    let a: u64 = 0xFF
    let hi = a >> 4
    let masked = a & 0x0F
    exit(hi + masked + 12)
}
