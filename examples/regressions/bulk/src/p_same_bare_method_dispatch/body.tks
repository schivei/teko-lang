use sbmd_left
use sbmd_right

/**
 * entry — the `same_bare_method_dispatch` regression (issue #290): three classes sharing the SAME
 * bare name `Svc` across three namespaces (`sbmd_left`, `sbmd_right` and the sorted-first
 * `aaa_decoy` poison decoy). An INSTANCE method call must dispatch to the canonically-namespaced
 * class, never to a readdir-order same-bare collision.
 *
 * The two namespaces were spelled `left`/`right` while this was a project of its own; they are
 * `sbmd_left`/`sbmd_right` inside the `bulk` channel because `di_same_name_cross_ns` brought its own
 * `left`/`right` pair into the same build. The property under test — distinct namespaces sharing one
 * bare name — is unchanged, and the merged build raises the number of colliding `Svc` declarations
 * from three to five.
 *
 * @return void — diverges with the scenario's exit code
 */
pub fn entry() {
    let l = sbmd_left::Svc::make(3).tag_of()
    if l != 3 { exit(1) }
    let r = sbmd_right::Svc::make(7).tag_of()
    if r != 7 { exit(2) }
    exit(l + r)
}
