type Big = struct {
    /** the first payload word. */
    a: i64
    /** the second payload word. */
    b: i64
    /** the third payload word. */
    c: i64
}
type Small = struct {
    /** the sole payload word. */
    s: i64
}
type Op_sbmd = variant Big | Small
type Holder_sbmd = struct {
    /** the boxed `Op_sbmd | null` field (an arena handle, or the NULL handle). */
    f: Op_sbmd | null
    /** a neighbouring scalar added into the result. */
    label: i64
}
pub fn make_big(v: i64) -> Holder_sbmd { return Holder_sbmd { f = Big { a = v; b = v + 1; c = v + 2 }; label = 1 } }
pub fn make_null() -> Holder_sbmd { return Holder_sbmd { f = null; label = 8 } }
pub fn read_sbmd(h: Holder_sbmd) -> i64 {
    match h.f {
        Op_sbmd as v => match v { Big as bg => return bg.a + bg.b + bg.c + h.label; Small as sm => return sm.s }
        null => return h.label
    }
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: large box-in-arena null-union field (folds nullfield_variant_boxed)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q010_large_box_in_arena_null_union_field_fo`.
 */
pub fn entry() {
    exit((read_sbmd(make_big(10)) + read_sbmd(make_null())) to i32)
}
