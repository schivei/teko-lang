type Counter2 = interface {
    /**
     * bump — advance the counter one step.
     */
    fn bump(self)

    /**
     * get — the current count.
     *
     * @return  the running count
     */
    fn get(self) -> i64
}
type Cnt = class & Counter2 {
    /** The running count. */
    pub n: i64

    /**
     * make — a fresh counter positioned at zero.
     *
     * @return  the constructed counter
     */
    pub fn make() -> Cnt { Cnt { n = 0 } }

    /**
     * bump — the `Counter2` contract: increment the stored count.
     */
    pub fn bump(self) { self.n = self.n + 1 }

    /**
     * get — the `Counter2` contract: read the stored count.
     *
     * @return  the running count
     */
    pub fn get(self) -> i64 { self.n }
}
pub fn drive(c: Counter2) -> i64 {
    c.bump()
    c.bump()
    c.bump()
    c.get()
}
pub fn scenario2() -> i64 { drive(Cnt::make()) }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iface_value_stateful_class
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q092_iface_value_stateful_class`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Counter -> Counter2, scenario -> scenario2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    exit(scenario2())
}
