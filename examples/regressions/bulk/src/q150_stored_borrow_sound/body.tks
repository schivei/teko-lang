pub fn thru(ref p: i64) -> i64 {
    ref r: i64 = p
    let a = r.value
    r.value = a + 5
    0
}
pub fn in_loop(ref p: i64) -> i64 {
    mut n = 0
    loop {
        if n >= 1 { break }
        ref r: i64 = p
        r.value = r.value + 2
        n = n + 1
    }
    0
}
pub fn in_match(ref p: i64) -> i64 {
    match p.value {
        _ => {
            ref r: i64 = p
            r.value = r.value + 3
        }
    }
    0
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: stored_borrow_sound
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q150_stored_borrow_sound`.
 */
pub fn entry() {
        mut a = 10
        let z1 = thru(a)
        mut b = 20
        let z2 = in_loop(b)
        mut c = 30
        let z3 = in_match(c)
    exit((((a + b) + c) + ((z1 + z2) + z3)) to i32)
}
