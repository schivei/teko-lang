pub extern fn fill_bytes(dst: ptr<byte>, val: i32, n: u64) -> ptr<byte> = "memset"
pub fn filled_sum() -> i32 {
    let region = teko::mem::buf_ptr(8)
    fill_bytes(region, 7, 8)
    let written = teko::mem::bytes_from_ptr(region, 8)
    mut total: i32 = 0
    mut i: u64 = 0
    loop {
        if i >= written.len { break }
        total = total + (written[i] to i32)
        i++
    }
    total
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: buf_ptr_memset_roundtrip
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q026_buf_ptr_memset_roundtrip`.
 */
pub fn entry() {
    exit(filled_sum())
}
