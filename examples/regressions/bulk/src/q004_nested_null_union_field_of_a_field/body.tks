type Inner_qopt = struct { v: i64 | null }
type Outer_qopt = struct { inner: Inner_qopt | null }
fn read_outer(o: Outer_qopt, fallback: i64) -> i64 {
    match o.inner {
        Inner_qopt as inn => match inn.v { i64 as v => v; null => fallback }
        null => fallback
    }
}

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: nested null-union field-of-a-field
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q004_nested_null_union_field_of_a_field`.
 */
pub fn entry() {
    let present = Outer_qopt { inner = Inner_qopt { v = 30 } }
    let inner_null = Outer_qopt { inner = Inner_qopt { v = null } }
    let outer_null = Outer_qopt { inner = null }
    exit(read_outer(present, 0) + read_outer(inner_null, 5) + read_outer(outer_null, 7))
}
