fn is_http_method(s: str) -> bool { return s in ["get", "post"] }
fn cmd_code(cmd: str) -> i64 {
    match cmd {
        "build" => 1
        "run" => 2
        _ => 0
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: str_in_match
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q152_str_in_match`.
 */
pub fn entry() {
    if !is_http_method("get") { exit(1) }
    if !is_http_method("post") { exit(2) }
    if is_http_method("delete") { exit(3) }
    if cmd_code("build") != 1 { exit(4) }
    if cmd_code("run") != 2 { exit(5) }
    if cmd_code("nope") != 0 { exit(6) }
    mut prefix = "po"
    prefix = prefix ~ "st"
    if !is_http_method(prefix) { exit(7) }
    mut verb = "bu"
    verb = verb ~ "ild"
    if cmd_code(verb) != 1 { exit(8) }
}
