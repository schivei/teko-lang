type Pair = struct {
    /** The first word of the pair. */
    x: i64
    /** The second word of the pair. */
    y: i64
}
type Holder_qopt = struct {
    /** A `#inline`-annotated large-union field — exercises the field parse site. */
    #inline slot: Pair | null
}
pub fn probe_inline_parse() -> i32 {
    #inline mut hot: Pair | null = Pair { x = 42; y = 0 }
    mut a: i32 = 0
    match hot {
        null => a = 100
        Pair as v => a = v.x to i32
    }
    let h: Holder_qopt = Holder_qopt { slot = null }
    mut b: i32 = 0
    match h.slot {
        null => b = 5
        Pair as v => b = (v.x to i32) + 100
    }
    a + b
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: inline_attr_parse
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q093_inline_attr_parse`.
 */
pub fn entry() {
    exit(probe_inline_parse())
}
