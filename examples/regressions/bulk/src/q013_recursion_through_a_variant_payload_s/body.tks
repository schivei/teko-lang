type Leaf_qopt = struct {
    /** the payload value returned when the fold reaches this leaf. */
    v: i64
}
type Node_qopt = struct {
    /** the next tree down, or `null` at the bottom — the recursive `Tree | null` back-edge. */
    child: Tree | null
}
type Tree = variant Leaf_qopt | Node_qopt
pub fn leaf(v: i64) -> Tree {
    return Leaf_qopt { v = v }
}
pub fn wrap(t: Tree) -> Tree {
    return Node_qopt { child = t }
}
pub fn bottom() -> Tree {
    return Node_qopt { child = null }
}
pub fn fold(t: Tree) -> i64 {
    match t {
        Leaf_qopt as l => return l.v
        Node_qopt as n => match n.child {
            Tree as c => return fold(c)
            null => return 0
        }
    }
}
pub fn scene() -> i64 {
    return fold(wrap(wrap(leaf(42))))
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: recursion through a variant payload's null-union field (folds nullfield_variant_recursive_via_variant)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q013_recursion_through_a_variant_payload_s`.
 */
pub fn entry() {
    exit(scene() to i32)
}
