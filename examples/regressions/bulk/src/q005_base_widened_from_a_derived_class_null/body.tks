type Animal_sbmd = virtual class {
    pub name: str
    pub virtual fn speak(self) -> str { "..." }
}
type Dog_sbmd = class Animal_sbmd {
    pub fn make(n: str) -> Dog_sbmd { Dog_sbmd { name = n } }
    pub override fn speak(self) -> str { "Woof" }
}
fn speak_or(a: Animal_sbmd | null, fallback: str) -> str {
    match a { Animal_sbmd as v => v.speak(); null => fallback }
}

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: base widened from a derived class, null-union
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q005_base_widened_from_a_derived_class_null`.
 */
pub fn entry() {
    let present: Animal_sbmd | null = Dog_sbmd::make("Rex")
    let absent: Animal_sbmd | null = null
    let r1 = speak_or(present, "?")
    let r2 = speak_or(absent, "?")
    exit(if r1 == "Woof" && r2 == "?" { 42 } else { 1 })
}
