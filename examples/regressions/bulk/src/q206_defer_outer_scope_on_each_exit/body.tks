/**
 * outer_return — `return`, written inside a NESTED `if`, still fires the FUNCTION-level
 * (outer-block) defer.
 *
 * @return 11
 */
fn outer_return() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    if true { return acc }
    return 0
}

/**
 * outer_break — `break`, written inside a loop wrapped by an outer-block defer, fires that defer
 * once the function itself later returns (`break` only crosses down to & including its own loop).
 *
 * @return 11
 */
fn outer_break() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    loop { break }
    return acc
}

/**
 * outer_continue — `continue`, written inside a loop wrapped by an outer-block defer, leaves that
 * defer to fire exactly once, at the function's own later return (never per iteration).
 *
 * @return 11
 */
fn outer_continue() -> i64 {
    mut acc: i64 = 1
    mut n = 0
    defer { acc = acc + 10 }
    loop {
        n = n + 1
        if n < 2 { continue }
        break
    }
    return acc
}

/**
 * outer_panic — an unqualified `panic`, written inside a NESTED `if`, fires the FUNCTION-level
 * (outer-block) defer before the process dies (the W15/#defer-nas-saidas fix's headline case —
 * the architect's own `teko_deferprobe__body` reproduction, harness doc §18.1).
 */
fn outer_panic() {
    defer { eprintln("outer-panic:defer") }
    if true { panic("q206 outer panic") }
}

/**
 * outer_exit — an unqualified `exit`, written inside a NESTED `if`, fires the FUNCTION-level
 * (outer-block) defer before the process exits — `exit`'s own ARGUMENT is evaluated AFTER the
 * replay, so the reported code (11, not 1) is itself the proof.
 *
 * @return never
 */
fn outer_exit() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    if true { exit((acc) to i32) }
    return 0
}

/**
 * entry — the OUTER-SCOPE column of the five-exits x two-scopes defer matrix (owner ruling
 * 2026-07-29): `return`/`break`/`continue` combined into one exit code (33). Selected by
 * `TEKO_REGR_ENTRY=q206_defer_outer_scope_on_each_exit`.
 */
pub fn entry() {
    exit((outer_return() + outer_break() + outer_continue()) to i32)
}

/**
 * entry_panic — the `panic` column member. Selected by
 * `TEKO_REGR_ENTRY=q206_defer_outer_scope_on_each_exit__panic`.
 */
pub fn entry_panic() {
    outer_panic()
}

/**
 * entry_exit — the `exit` column member (expected exit 11). Selected by
 * `TEKO_REGR_ENTRY=q206_defer_outer_scope_on_each_exit__exit`.
 */
pub fn entry_exit() {
    outer_exit()
    eprintln("unreachable: exit always exits")
}
