type Dog_mcni = class {
    pub name: str
    pub age: i64

    pub fn make(n: str, a: i64) -> Dog_mcni {
        Dog_mcni { name = n; age = a }
    }

    pub fn bark(self) -> str {
        self.name
    }

    pub fn is_puppy(self) -> bool {
        self.age < 1
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: class_basics
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q033_class_basics`.
 */
pub fn entry() {
    let rex = Dog_mcni::make("Rex", 3)
    if rex.bark() != "Rex" { exit(1) }
    if rex.name != "Rex" { exit(2) }
    if rex.age != 3 { exit(3) }
    if rex.is_puppy() { exit(4) }
    let pup = Dog_mcni::make("Pup", 0)
    if !pup.is_puppy() { exit(5) }
}
