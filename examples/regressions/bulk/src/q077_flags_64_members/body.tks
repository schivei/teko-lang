/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: flags_64_members
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q077_flags_64_members`.
 */
pub fn entry() {
    let top = Perm64::M63
    if !top.has(Perm64::M63) { exit(1) }
    if top.has(Perm64::M0) { exit(2) }
    let bottom = Perm64::M0
    if bottom.has(Perm64::M63) { exit(3) }
    if !bottom.has(Perm64::M0) { exit(4) }
    let combo = top.add(bottom)
    if !combo.has(Perm64::M63) { exit(5) }
    if !combo.has(Perm64::M0) { exit(6) }
    if combo.has(Perm64::M1) { exit(7) }
    exit(0)
}
