    pub fn raw_len() -> i64 { let s = @"a\nb"; s.len to i64 }
    pub fn raw_quote_len() -> i64 { let s = @"x""y"; s.len to i64 }
    pub fn multiline_len() -> i64 {
        let s = """a
b"""
        s.len to i64
    }
    pub fn multiline_escape_len() -> i64 { let s = """a\tbc"""; s.len to i64 }
    pub fn multiline_verbatim_len() -> i64 {
        let s = @"""a"b\nc"""
        s.len to i64
    }

    pub fn multiline_interp_len() -> i64 {
        let s = $"""x{1 + 1}\ny"""
        s.len to i64
    }

    pub fn verbatim_interp_len() -> i64 {
        let s = $@"x{1 + 1}\ny"
        s.len to i64
    }

    pub fn verbatim_interp_quote_len() -> i64 {
        let s = $@"a""b{1}c"
        s.len to i64
    }

    pub fn multiline_verbatim_interp_len() -> i64 {
        let s = @$"""a"b{1}c"""
        s.len to i64
    }
    pub fn brace_double_basic_len() -> i64 {
        let abc = "ab"
        let s = $"{{{abc}}}"
        s.len to i64
    }
    pub fn brace_double_text_len() -> i64 {
        let s = $"a{{b}}c"
        s.len to i64
    }
    pub fn brace_double_end_len() -> i64 {
        let s = $"a{{"
        s.len to i64
    }
    pub fn brace_double_nested_len() -> i64 {
        let abc = "ab"
        let s = $"{{{{{abc}}}}}"
        s.len to i64
    }
    pub fn brace_double_verbatim_len() -> i64 {
        let s = $@"{{x}}"
        s.len to i64
    }
    pub fn brace_double_verbatim_order_len() -> i64 {
        let s = @$"{{x}}"
        s.len to i64
    }
    pub fn brace_double_user_close3_len() -> i64 {
        let abc = "ab"
        let s = $"{abc}}}"
        s.len to i64
    }
    pub fn brace_double_user_open3_len() -> i64 {
        let abc = "ab"
        let s = $"{{{abc}"
        s.len to i64
    }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: raw_multiline_strings
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q136_raw_multiline_strings`.
 */
pub fn entry() {
    exit((raw_len() + raw_quote_len() + multiline_len() + multiline_escape_len() + multiline_verbatim_len() + multiline_interp_len() + verbatim_interp_len() + verbatim_interp_quote_len() + multiline_verbatim_interp_len() + brace_double_basic_len() + brace_double_text_len() + brace_double_end_len() + brace_double_nested_len() + brace_double_verbatim_len() + brace_double_verbatim_order_len() + brace_double_user_close3_len() + brace_double_user_open3_len()) to i32)
}
