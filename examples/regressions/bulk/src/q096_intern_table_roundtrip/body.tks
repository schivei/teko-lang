/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: intern_table_roundtrip
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q096_intern_table_roundtrip`.
 */
pub fn entry() {
        let put_ret = teko::intern_put("shape-key", "tk_u_str_u64")
        let hit = teko::intern_get("shape-key")
        let miss = teko::intern_get("absent-key")
        teko::intern_reset()
        let after_reset = teko::intern_get("shape-key")
        mut ok = put_ret == "tk_u_str_u64"
        if hit != "tk_u_str_u64" { ok = false }
        if miss != "" { ok = false }
        if after_reset != "" { ok = false }
    exit(if ok { 7 } else { 1 })
}
