type Point2_qopt = struct {
    /** the sole instance field */
    x: i64
    /** ORIGIN_X — a static member const, resolved by `Point2_qopt::ORIGIN_X` and inlined at each use. */
    pub const ORIGIN_X: i64 = 7
}
type Vault_qopt = class {
    /** the stored amount */
    pub amount: i64
    /** CAPACITY — a class-level static member const, resolved by `Vault_qopt::CAPACITY`. */
    pub const CAPACITY: i64 = 30
    /**
     * open — the canonical factory constructing a `Vault_qopt` from an amount.
     *
     * @param a  the amount to store
     * @return   a fresh `Vault_qopt`
     */
    pub fn open(a: i64) -> Vault_qopt { Vault_qopt { amount = a } }
    /**
     * read — the stored amount of this vault.
     *
     * @return the amount
     */
    pub fn read(self) -> i64 { self.amount }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: member_const_scalar
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q119_member_const_scalar`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Point -> Point2_qopt.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let p = Point2_qopt { x = 3 }
    let v = Vault_qopt::open(2)
    exit(Point2_qopt::ORIGIN_X + Vault_qopt::CAPACITY + p.x + v.read())
}
