type Service = interface {
    fn ping(self) -> i64
}
#singleton
type Bomb = class & Service {
    pub tag: i64

    pub fn make() -> Bomb { exit(9) }
    pub fn ping(self) -> i64 { self.tag }
}
#inject(svc: Service)
fn run_if(flag: bool) -> i64 {
    if flag { svc.ping() } else { 0 }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: di_lazy
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q065_di_lazy`.
 */
pub fn entry() {
    if run_if(false) != 0 { exit(1) }
}
