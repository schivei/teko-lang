pub fn empty_row_total() -> i32 {

    let leading: [][]i64 = [[], [1]]
    mut total = (leading.len to i64) - 2
    total = total + (leading[0].len to i64)
    total = total + leading[1][0]

    let ragged: [][]i64 = [[1], [], [2, 3]]
    total = total + ragged[0][0] - 1
    total = total + (ragged[1].len to i64)
    total = total + ragged[2][0] + ragged[2][1] - 4

    let flat: []i64 = []
    total = total + (flat.len to i64)

    mut i = 0
    mut sum: i64 = 0
    loop {
        if i >= leading.len { break }
        mut j = 0
        loop {
            if j >= leading[i].len { break }
            sum = sum + leading[i][j]
            j++
        }
        i++
    }
    i = 0
    loop {
        if i >= ragged.len { break }
        mut j = 0
        loop {
            if j >= ragged[i].len { break }
            sum = sum + ragged[i][j]
            j++
        }
        i++
    }
    total = total + sum - 3

    total to i32
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: nested_slice_empty_row
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q128_nested_slice_empty_row`.
 */
pub fn entry() {
    exit((empty_row_total()))
}
