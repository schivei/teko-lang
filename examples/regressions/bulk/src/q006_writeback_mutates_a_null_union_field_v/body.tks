type Box = struct { v: i64 | null }

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: writeback mutates a null-union field, value -> null -> value
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q006_writeback_mutates_a_null_union_field_v`.
 */
pub fn entry() {
    mut b = Box { v = null }
    b.v = 10
    let r1 = match b.v { i64 as x => x; null => 0 }
    b.v = null
    let r2 = match b.v { i64 as x => x; null => 32 }
    exit(r1 + r2)
}
