type A_qopt = struct {
    /** the case's payload, returned by `read_qopt` on the `A_qopt` arm. */
    x: i64
}
type B_qopt = struct {
    /** the case's payload, returned by `read_qopt` on the `B_qopt` arm. */
    y: i64
}
type Op_qopt = variant A_qopt | B_qopt
type Slot_qopt = struct {
    /** the `Op_qopt | null` field — a present `Op_qopt` case or `null`. */
    f: Op_qopt | null
    /** a neighbouring scalar, so the union field carries a real offset. */
    tag: i64
}
pub fn with_a(v: i64) -> Slot_qopt { return Slot_qopt { f = A_qopt { x = v }; tag = 1 } }
pub fn with_b(v: i64) -> Slot_qopt { return Slot_qopt { f = B_qopt { y = v }; tag = 2 } }
pub fn empty_slot() -> Slot_qopt { return Slot_qopt { f = null; tag = 0 } }
pub fn read_qopt(s: Slot_qopt) -> i64 {
    match s.f {
        Op_qopt as v => match v { A_qopt as a => return a.x; B_qopt as b => return b.y }
        null => return 0
    }
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: small inline-tag null-union field (folds nullfield_variant_plain)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q009_small_inline_tag_null_union_field_fold`.
 */
pub fn entry() {
    exit((read_qopt(with_a(30)) + read_qopt(with_b(12)) + read_qopt(empty_slot())) to i32)
}
