pub type Circle_di = struct { r: i32 }
pub type Square = struct { s: i32 }
pub type Triangle = struct { b: i32; h: i32 }
pub type Shape_di = variant Circle_di | Square | Triangle
fn area_code(sh: Shape_di) -> i32 {
    match sh {
        Circle_di as c => c.r * 10
        Square as sq => sq.s * 11
        Triangle as t => t.b * t.h
    }
}
pub fn pick_area(pick_circle: bool) -> i32 {

    let body: Shape_di = if pick_circle { Circle_di { r = 3 } } else { Square { s = 4 } }
    area_code(body)
}
pub fn pick_area_match(which: i32) -> i32 {

    let body: Shape_di = match which {
        0 => Circle_di { r = 3 }
        _ => Square { s = 4 }
    }
    area_code(body)
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: if_arm_variant_widen
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q086_if_arm_variant_widen`.
 */
pub fn entry() {
    let via_if = pick_area(true)
    let via_match = pick_area_match(0)
    exit((if via_if == via_match { via_if } else { 1 }))
}
