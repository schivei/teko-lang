type A_iface = struct {
    /** the case payload. */
    x: i64
}
type B_iface = struct {
    /** the case payload. */
    y: i64
}
type Op_iface = variant A_iface | B_iface
type Box_iface = struct {
    /** the mutated `Op_iface | null` field. */
    f: Op_iface | null
}
pub fn cycle() -> i64 {
    mut b: Box_iface = Box_iface { f = A_iface { x = 30 } }
    mut acc = 0
    match b.f {
        Op_iface as v => match v { A_iface as a => acc = acc + a.x; B_iface as bb => acc = acc + bb.y }
        null => acc = acc + 1000
    }
    b.f = null
    match b.f {
        Op_iface as v => acc = acc + 5000
        null => acc = acc + 2
    }
    b.f = B_iface { y = 10 }
    match b.f {
        Op_iface as v => match v { A_iface as a => acc = acc + 7000; B_iface as bb => acc = acc + bb.y }
        null => acc = acc + 9000
    }
    return acc
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: full mutation cycle of a null-union field (folds nullfield_variant_writeback)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q014_full_mutation_cycle_of_a_null_union_fi`.
 */
pub fn entry() {
    exit(cycle() to i32)
}
