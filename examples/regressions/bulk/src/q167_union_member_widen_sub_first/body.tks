type Animal4 = virtual class {
    /** the animal's display name (unused by the check, kept for shape parity). */
    pub name: str

    /**
     * make — construct a base `Animal4`.
     *
     * @param n  the animal's name
     * @return   a fresh `Animal4`
     */
    pub fn make(n: str) -> Animal4 {
        Animal4 { name = n }
    }

    /**
     * speak — the base's default (overridden by every subclass).
     *
     * @param self  the receiver
     * @return      the base's sound
     */
    pub virtual fn speak(self) -> str {
        "..."
    }
}
type Dog4 = class Animal4 {
    /**
     * make — construct a `Dog4`.
     *
     * @param n  the dog's name
     * @return   a fresh `Dog4`
     */
    pub fn make(n: str) -> Dog4 {
        Dog4 { name = n }
    }

    /**
     * speak — the `Dog4` override.
     *
     * @param self  the receiver
     * @return      "Woof"
     */
    pub override fn speak(self) -> str {
        "Woof"
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: union_member_widen_sub_first
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q167_union_member_widen_sub_first`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Animal -> Animal4, Dog -> Dog4.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let a: Dog4 | Animal4 | null = Dog4::make("Rex")
    match a {
        Dog4 as d => exit(0)
        Animal4 as an => exit(41)
        null => exit(42)
    }
}
