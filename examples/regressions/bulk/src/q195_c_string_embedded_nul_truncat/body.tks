/**
 * A LOCAL COPY of `teko::c_types::c_string`'s tier-1 constructor — see
 * `q194_c_string_roundtrip/body.tks` for the fuller local copy and
 * `staged/c_types/c_types.tks` for the canonical original.
 */
pub unsafe type LocalCString = struct {
    /** The base address of a NUL-terminated buffer. */
    ptr: ptr<byte>

    /** The payload length, excluding the terminator — deliberately NOT "what C will see" (§7.1). */
    len: u64
}

/** See `teko::c_types::c_string_for_call` — tier 1, the enclosing-region constructor. */
pub unsafe fn local_cstring_for_call(s: str) -> LocalCString {
    LocalCString { ptr = teko::mem::as_cstr(s); len = s.len }
}

/** The C string-length primitive, reached DIRECTLY as a C symbol. */
pub extern fn c_strlen(s: ptr<byte>) -> u64 = "strlen"

/**
 * entry — F10 c-types-and-marshalling — c_string_embedded_nul_truncates
 * (c-types-and-marshalling-0.3.1.md §7.2, PIN-1). A `str` of `"abc\0def"` (7 octets, ONE embedded
 * NUL at index 3) crosses the boundary; the exit code is what C's `strlen` measured (3), NOT
 * `.len` (7) — the owner ruling made explicit: the truncation is the developer's, and the
 * compiler does nothing about it.
 */
pub unsafe fn entry() {
    let source = "abc\0def"
    let cs = local_cstring_for_call(source)
    let measured = c_strlen(cs.ptr)
    exit(measured to i32)
}
