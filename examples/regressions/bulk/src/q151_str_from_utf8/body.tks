fn ok_len(bytes: []byte) -> i64 {
    match str_from_utf8(bytes) {
        str as s => teko::len(s) to i64
        error => 0
    }
}
fn is_err(bytes: []byte) -> i64 {
    match str_from_utf8(bytes) {
        str => 0
        error => 1
    }
}
pub fn check_utf8() -> i64 {
    let a = ok_len(bytes_of_str("hi"))
    let b = ok_len([0xC3, 0xA9])
    let c = is_err([0x80])
    let d = is_err([0xC0, 0xAF])
    a + b + c + d
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: str_from_utf8
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q151_str_from_utf8`.
 */
pub fn entry() {
    exit((check_utf8()) to i32)
}
