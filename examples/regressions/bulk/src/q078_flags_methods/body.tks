flags Perm {
    Read
    Write
    Exec
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: flags_methods
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q078_flags_methods`.
 */
pub fn entry() {
    let p = Perm::Read
    let p2 = p.add(Perm::Write)
    if !p2.has(Perm::Read) { exit(1) }
    if !p2.has(Perm::Write) { exit(2) }
    if p2.has(Perm::Exec) { exit(3) }
    let p3 = p2.remove(Perm::Read)
    if p3.has(Perm::Read) { exit(4) }
    if !p3.has(Perm::Write) { exit(5) }
    let w = Perm::Write
    if w.has(Perm::Read) { exit(6) }
    if !w.has(Perm::Write) { exit(7) }
    if w.has(Perm::Exec) { exit(8) }
    let e = Perm::Exec
    if e.has(Perm::Read) { exit(9) }
    if e.has(Perm::Write) { exit(10) }
    if !e.has(Perm::Exec) { exit(11) }
    let we = w.add(e)
    if !we.all(w.add(e)) { exit(12) }
    if we.all(w.add(Perm::Read)) { exit(13) }
    if !we.any(w) { exit(14) }
    if we.any(Perm::Read) { exit(16) }
    if !we.none(Perm::Read) { exit(17) }
    if we.none(w) { exit(18) }
    let z = Perm::Read.remove(Perm::Read)
    if !z.none(Perm::Read) { exit(19) }
    if !z.none(we) { exit(20) }
    if z.any(Perm::Read) { exit(21) }
    exit(0)
}
