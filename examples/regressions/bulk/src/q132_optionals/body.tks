pub type Box2 = struct { v: i64 }
fn mk_err() -> error | null { error { message = "x" } }
fn mk_ok() -> error | null { null }
pub fn idiom_present() -> i64 { match mk_err() { null => 0; error as e => 1 } }
pub fn idiom_null() -> i64 { match mk_ok() { null => 0; error as e => 1 } }
pub fn bind_present() -> i64 {
    let x: i64 | null = 5
    match x { null => 0; i64 as v => v }
}
fn maybe() -> i64 | null { null }
pub fn ret_null() -> i64 { match maybe() { null => 0; i64 as v => v } }
pub fn safe_present() -> i64 { let b: Box2 | null = Box2 { v = 4 }; match b { null => 8; Box2 as bb => bb.v } }
pub fn safe_none() -> i64 { let b: Box2 | null = null; match b { null => 8; Box2 as bb => bb.v } }
pub fn coalesce_present() -> i64 { let a: i64 | null = 7; match a { null => 9; i64 as v => v } }
pub fn coalesce_none() -> i64 { let a: i64 | null = null; match a { null => 9; i64 as v => v } }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: optionals
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q132_optionals`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Box -> Box2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    exit((idiom_present() + bind_present()) to i32)
}
