 * selected by `TEKO_REGR_ENTRY=q003_class_counter_null_present_and_absent`.
 */
pub fn entry() {
    let present: Counter_mcni | null = Counter_mcni::make(9)
    let absent: Counter_mcni | null = null
    exit(bump_or(present, 0) + bump_or(absent, 32))
}
