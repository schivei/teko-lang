/**
 * same_scope_return — a `defer` registered in the SAME block as the `return` that leaves it must
 * fire before the value is read (its mutation of `acc` is observable through the returned value,
 * `lower_return`'s own documented ordering).
 *
 * @return 101 (1, then `+100` from the defer, LIFO base case of one)
 */
fn same_scope_return() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 100 }
    return acc
}

/**
 * outer_scope_return — a `defer` registered in the FUNCTION's own (outer) block, with the
 * `return` written in a NESTED `if` block, still fires — `return` leaves EVERY enclosing scope
 * of its own frame, not just its immediate block.
 *
 * @return 11 (1, then `+10` from the outer defer)
 */
fn outer_scope_return() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    if true {
        return acc
    }
    return 0
}

/**
 * entry — the `return` row of the five-exits x two-scopes defer matrix (owner ruling 2026-07-29):
 * `return` already fires the pending defer in both the same block and an outer one; this fixture
 * pins that as a permanent regression lock. Selected by `TEKO_REGR_ENTRY=q201_defer_runs_on_return`.
 */
pub fn entry() {
    exit((same_scope_return() + outer_scope_return()) to i32)
}
