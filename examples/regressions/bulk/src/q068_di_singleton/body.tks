type Counter = interface {
    fn get(self) -> i64
    fn bump(self)
}
#singleton
type Ticker_qopt = class & Counter {
    pub n: i64

    pub fn make() -> Ticker_qopt { Ticker_qopt { n = 0 } }
    pub fn get(self) -> i64 { self.n }
    pub fn bump(self) { self.n = self.n + 1 }
}
#inject(a: Counter, b: Counter)
fn shared_counter() -> i64 {
    a.bump()
    b.get()
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: di_singleton
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q068_di_singleton`.
 */
pub fn entry() {
    if shared_counter() != 1 { exit(1) }
}
