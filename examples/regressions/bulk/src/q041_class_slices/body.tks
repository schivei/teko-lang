type Shape_sbmd = interface {
    fn area(self) -> i64
}
type Circle_sbmd = class & Shape_sbmd {
    pub r: i64
    pub fn make(rr: i64) -> Circle_sbmd { Circle_sbmd { r = rr } }
    pub fn area(self) -> i64 { self.r * self.r * 3 }
}
type Square_sbmd = class & Shape_sbmd {
    pub side: i64
    pub fn make(s: i64) -> Square_sbmd { Square_sbmd { side = s } }
    pub fn area(self) -> i64 { self.side * self.side }
}
type Point_sbmd = class {
    pub x: i64
    pub y: i64
    pub fn make(xx: i64, yy: i64) -> Point_sbmd { Point_sbmd { x = xx; y = yy } }
    pub fn sum(self) -> i64 { self.x + self.y }
}
type PointGroup = struct { members: []Point_sbmd }
pub fn sum_points(pts: []Point_sbmd) -> i64 {
    mut total: i64 = 0
    mut i: u64 = 0
    loop {
        if i >= pts.len { break }
        total = total + pts[i].sum()
        i++
    }
    total
}
pub fn make_points(a: i64, b: i64) -> []Point_sbmd {
    [Point_sbmd::make(a, 0), Point_sbmd::make(b, 0)]
}
pub fn total_area_sbmd(shapes: []Shape_sbmd) -> i64 {
    mut sum: i64 = 0
    mut i: u64 = 0
    loop {
        if i >= shapes.len { break }
        sum = sum + shapes[i].area()
        i++
    }
    sum
}
pub fn check_construct_index_len() -> i64 {
    let pts: []Point_sbmd = [Point_sbmd::make(1, 2), Point_sbmd::make(3, 4)]
    if pts.len != 2 { return 1 }
    if pts[0].sum() != 3 { return 2 }
    if pts[1].sum() != 7 { return 3 }
    0
}
pub fn check_nested() -> i64 {
    let row0: []Point_sbmd = [Point_sbmd::make(1, 1), Point_sbmd::make(2, 2)]
    let row1: []Point_sbmd = [Point_sbmd::make(3, 3)]
    let grid: [][]Point_sbmd = [row0, row1]
    if grid.len != 2 { return 4 }
    if grid[0].len != 2 { return 5 }
    if grid[1].len != 1 { return 6 }
    if grid[0][1].sum() != 4 { return 7 }
    if grid[1][0].sum() != 6 { return 8 }
    0
}
pub fn check_field() -> i64 {
    let g = PointGroup { members = make_points(2, 3) }
    if g.members.len != 2 { return 9 }
    if g.members[1].sum() != 3 { return 10 }
    0
}
pub fn check_param_return() -> i64 {
    if sum_points(make_points(4, 5)) != 9 { return 11 }
    0
}
pub fn check_covariant_upcast() -> i64 {
    let circles: []Circle_sbmd = [Circle_sbmd::make(1), Circle_sbmd::make(2)]
    let shapes: []Shape_sbmd = circles
    if total_area_sbmd(shapes) != 15 { return 12 }
    let mixed: []Shape_sbmd = [Circle_sbmd::make(1), Square_sbmd::make(3)]
    if total_area_sbmd(mixed) != 12 { return 13 }
    0
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: class_slices
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q041_class_slices`.
 */
pub fn entry() {
    let r1 = check_construct_index_len()
    if r1 != 0 { exit(r1) }
    let r2 = check_nested()
    if r2 != 0 { exit(r2) }
    let r3 = check_field()
    if r3 != 0 { exit(r3) }
    let r4 = check_param_return()
    if r4 != 0 { exit(r4) }
    let r5 = check_covariant_upcast()
    if r5 != 0 { exit(r5) }
    exit(0)
}
