type Named = interface {
    /**
     * tag — the implementer's identifying number.
     *
     * @return  the tag value
     */
    fn tag(self) -> i64
}
type Alpha = class & Named {
    /**
     * make — construct an `Alpha`.
     *
     * @return  the constructed value
     */
    pub fn make() -> Alpha { Alpha { } }

    /**
     * tag — the `Named` contract for `Alpha`.
     *
     * @return  10
     */
    pub fn tag(self) -> i64 { 10 }
}
type Beta = class & Named {
    /**
     * make — construct a `Beta`.
     *
     * @return  the constructed value
     */
    pub fn make() -> Beta { Beta { } }

    /**
     * tag — the `Named` contract for `Beta`.
     *
     * @return  20
     */
    pub fn tag(self) -> i64 { 20 }
}
pub fn pick_di(b: bool) -> Named {
    if b { return Alpha::make() }
    Beta::make()
}
pub fn scenario_di() -> i64 {
    if pick_di(true).tag() != 10 { return 1 }
    if pick_di(false).tag() != 20 { return 2 }
    0
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iface_value_return
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q091_iface_value_return`.
 */
pub fn entry() {
    exit(scenario_di())
}
