type Animal3 = virtual class {
    pub name: str

    pub fn make(n: str) -> Animal3 {
        Animal3 { name = n }
    }

    pub virtual fn speak(self) -> str {
        "..."
    }
}
pub fn hear(a: Animal3) -> str {
    a.speak()
}
pub fn pick_iface(dog: bool) -> Animal3 {
    if dog {
        return Dog3::make("Rex")
    }
    Cat::make("Milo")
}
pub fn check_binding() -> i64 {
    let a: Animal3 = Dog3::make("Rex")
    if a.speak() != "Woof" { return 1 }
    let b: Animal3 = Cat::make("Milo")
    if b.speak() != "Meow" { return 2 }
    0
}
pub fn check_param() -> i64 {
    let a: Animal3 = Dog3::make("Rex")
    if hear(a) != "Woof" { return 3 }
    let b: Animal3 = Cat::make("Milo")
    if hear(b) != "Meow" { return 4 }
    0
}
pub fn check_return() -> i64 {
    let a = pick_iface(true)
    if a.speak() != "Woof" { return 5 }
    let b = pick_iface(false)
    if b.speak() != "Meow" { return 6 }
    0
}
type Dog3 = class Animal3 {
    pub fn make(n: str) -> Dog3 {
        Dog3 { name = n }
    }

    pub override fn speak(self) -> str {
        "Woof"
    }
}
type Cat = class Animal3 {
    pub fn make(n: str) -> Cat {
        Cat { name = n }
    }

    pub override fn speak(self) -> str {
        "Meow"
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: class_upcast
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q042_class_upcast`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Animal -> Animal3, Dog -> Dog3.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let r1 = check_binding()
    if r1 != 0 { exit(r1) }
    let r2 = check_param()
    if r2 != 0 { exit(r2) }
    let r3 = check_return()
    if r3 != 0 { exit(r3) }
    exit(0)
}
