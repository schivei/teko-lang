/**
 * entry — F2 language corpus — folded EXPECT_EXIT single-file fixtures (dobrado, dir removido)
 *          :: comptime_fold_interp_hex
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q015_comptime_fold_interp_hex`.
 */
pub fn entry() {
    let a: u64 = 0xFF
    if $"{a:X}" != "FF" { exit(1) }
    if $"{a:x}" != "ff" { exit(2) }
    if $"{a:b}" != "11111111" { exit(3) }
    if $"{a}" != "255" { exit(4) }
    if $"0x{a:X} = {a}" != "0xFF = 255" { exit(5) }
    let n: i64 = -1234567
    if $"{n:n}" != "-1,234,567" { exit(6) }
    if $"{n}" != "-1234567" { exit(7) }
    let w: i64 = 42
    if $"{w:d5}" != "00042" { exit(8) }
    exit(0)
}
