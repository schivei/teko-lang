pub extern fn write(s: str) -> void = "tk_write" from "teko_rt"
pub type WFn = (str) -> u64
fn call_it(write: WFn) -> u64 {
    write("hello")
}
fn nested_shadow(write: WFn) -> u64 {
    let inner: WFn = (s: str) => {
        let write: WFn = (s2: str) => 4 to u64
        write(s)
    }
    if write("outer") != 1 to u64 { return 0 to u64 }
    inner("inner")
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: closure_shadows_fn
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q044_closure_shadows_fn`.
 */
pub fn entry() {
        let f1: WFn = (s: str) => 1 to u64
        let bit0 = call_it(f1)
        let write: WFn = (s: str) => 2 to u64
        let bit1 = write("ignored")
        let f2: WFn = (s: str) => 1 to u64
        let bit2 = nested_shadow(f2)
    exit((bit0 + bit1 + bit2) to i32)
}
