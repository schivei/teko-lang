pub type Node2 = class {
    /** value — this node's payload, summed by `sum2`. */
    pub value: i64
    /** next — the optional forward link; null at the tail. */
    pub next: Node2 | null

    /**
     * make — construct a tail node whose link is null.
     *
     * @param v the node's value
     * @return  a fresh tail Node2
     */
    pub fn make(v: i64) -> Node2 {
        Node2 { value = v; next = null }
    }

    /**
     * set_next — link `n` after `self`, writing a present class-optional.
     *
     * @param n the node to link after self
     */
    pub fn set_next(self, n: Node2) {
        self.next = n
    }
}
pub fn sum2(head: Node2) -> i64 {
    mut total = 0
    mut cur = head.next
    total = total + head.value
    mut steps = 0
    loop {
        if steps >= 8 { break }
        let add = match cur { null => 0; Node2 as n => n.value }
        total = total + add
        cur = match cur { null => null; Node2 as n => n.next }
        steps = steps + 1
    }
    total
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: selfref_class_optional
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q148_selfref_class_optional`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Node -> Node2, sum -> sum2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
        let a = Node2::make(1)
        let b = Node2::make(2)
        let c = Node2::make(3)
        a.set_next(b)
        b.set_next(c)
    exit((sum2(a)) to i32)
}
