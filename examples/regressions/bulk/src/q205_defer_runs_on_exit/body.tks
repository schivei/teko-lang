/**
 * same_scope_exit — an unqualified `exit` call, and the `defer` guarding it, in the SAME block.
 * `exit`'s own ARGUMENT is evaluated AFTER the replay fires (the fixed ordering, W15/
 * #defer-nas-saidas — mirrors `lower_return`'s "defer mutates the value the exit reads
 * afterward"), so the reported exit CODE itself proves the defer ran: 101, not 1.
 *
 * @return never — the process exits with `acc`'s post-defer value
 */
fn same_scope_exit() -> i64 {
    mut acc: i64 = 1
    if true {
        defer { acc = acc + 100 }
        exit((acc) to i32)
    }
    return 0
}

/**
 * outer_scope_exit — the SAME defect, one lexical level out: the `defer` is registered in the
 * FUNCTION's own (outer) block, and the `exit` fires from a NESTED `if` inside it.
 *
 * @return never — the process exits with `acc`'s post-defer value (11, not 1)
 */
fn outer_scope_exit() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 10 }
    if true {
        exit((acc) to i32)
    }
    return 0
}

/**
 * entry — the escopo-exterior half of the `exit` row (five-exits x two-scopes defer matrix,
 * owner ruling 2026-07-29). Expected exit 11. Selected by
 * `TEKO_REGR_ENTRY=q205_defer_runs_on_exit`.
 */
pub fn entry() {
    outer_scope_exit()
    eprintln("unreachable: exit always exits")
}

/**
 * entry_same — the mesmo-escopo half. Expected exit 101. Selected by
 * `TEKO_REGR_ENTRY=q205_defer_runs_on_exit__same`.
 */
pub fn entry_same() {
    same_scope_exit()
    eprintln("unreachable: exit always exits")
}
