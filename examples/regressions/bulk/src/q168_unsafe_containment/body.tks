pub unsafe type Raw = struct {
    /** A raw address, carried as a plain integer (U3 gives this a real raw-memory shape). */
    addr: i64
}
pub unsafe type Wrapper = struct {
    /** The wrapped raw handle. */
    m: Raw
}
pub unsafe type Carriers = struct {
    /** A slice of raw handles. */
    many: []Raw
    /** An optional raw handle. */
    maybe: Raw | null
    /** A typed pointer to a raw handle's shape. */
    addr: ptr<Raw>
}
pub unsafe fn make_raw(addr: i64) -> Raw {
    Raw { addr = addr }
}
pub unsafe fn raw_addr(r: Raw) -> i64 {
    r.addr
}
pub unsafe fn make_wrapper(addr: i64) -> Wrapper {
    Wrapper { m = make_raw(addr) }
}
pub unsafe fn wrapper_addr(addr: i64) -> i64 {
    raw_addr(make_wrapper(addr).m)
}
pub unsafe fn dup_addr(addr: i64) -> i64 {
    let w = make_wrapper(addr)
    raw_addr(w.m)
}
pub type Box3<T> = struct {
    /** The boxed value, at whatever concrete type this instance is stamped to. */
    value: T
}
pub unsafe fn echo_nested_box(b: Box3<Box3<Raw>>) -> Box3<Box3<Raw>> {
    b
}
pub unsafe fn echo_box(b: Box3<Raw>) -> Box3<Raw> {
    b
}
pub unsafe fn box_addr_of(addr: i64) -> i64 {
    let boxed = echo_box(Box3<Raw> { value = make_raw(addr) })
    let nested = echo_nested_box(Box3<Box3<Raw>> { value = boxed })
    raw_addr(nested.value.value)
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: unsafe_containment
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q168_unsafe_containment`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Box -> Box3.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    if wrapper_addr(11) != 11 { exit(1) }
    if dup_addr(23) != 23 { exit(2) }
    if box_addr_of(17) != 17 { exit(3) }
    exit(42)
}
