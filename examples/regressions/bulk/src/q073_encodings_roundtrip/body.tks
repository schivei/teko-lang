type Base64Alphabet = struct {
    /**
     * The character standing for 6-bit value 62 (`+` standard, `-` URL-safe).
     */
    char62: byte
    /**
     * The character standing for 6-bit value 63 (`/` standard, `_` URL-safe).
     */
    char63: byte
    /**
     * Whether `encode` emits trailing `=` padding and `decode` requires/consumes it.
     */
    padded: bool
}
pub fn standard_alphabet() -> Base64Alphabet {
    Base64Alphabet { char62 = b'+'; char63 = b'/'; padded = true }
}
pub fn url_safe_alphabet() -> Base64Alphabet {
    Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = true }
}
pub fn url_safe_no_pad_alphabet() -> Base64Alphabet {
    Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = false }
}
fn base64_char_of(alphabet: Base64Alphabet, sextet: u32) -> byte {
    if sextet < 26 { return (b'A' to u32 + sextet) to byte }
    if sextet < 52 { return (b'a' to u32 + (sextet - 26)) to byte }
    if sextet < 62 { return (b'0' to u32 + (sextet - 52)) to byte }
    if sextet == 62 { return alphabet.char62 }
    alphabet.char63
}
fn encode_full_group(out: []byte, alphabet: Base64Alphabet, b0: byte, b1: byte, b2: byte) -> []byte {
    let n0 = b0 to u32
    let n1 = b1 to u32
    let n2 = b2 to u32
    mut o = out
    o = teko::list::push(o, base64_char_of(alphabet, n0 >> 2))
    o = teko::list::push(o, base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4)))
    o = teko::list::push(o, base64_char_of(alphabet, ((n1 & 0xF) << 2) | (n2 >> 6)))
    o = teko::list::push(o, base64_char_of(alphabet, n2 & 0x3F))
    o
}
fn encode_tail_group(out: []byte, alphabet: Base64Alphabet, b0: byte, has_b1: bool, b1: byte) -> []byte {
    let n0 = b0 to u32
    mut o = out
    o = teko::list::push(o, base64_char_of(alphabet, n0 >> 2))
    if has_b1 {
        let n1 = b1 to u32
        o = teko::list::push(o, base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4)))
        o = teko::list::push(o, base64_char_of(alphabet, (n1 & 0xF) << 2))
        if alphabet.padded { o = teko::list::push(o, b'=') }
        return o
    }
    o = teko::list::push(o, base64_char_of(alphabet, (n0 & 0x3) << 4))
    if alphabet.padded {
        o = teko::list::push(o, b'=')
        o = teko::list::push(o, b'=')
    }
    o
}
pub fn encode(data: []byte, alphabet: Base64Alphabet) -> str {
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    let full_groups = data.len / 3
    loop {
        if i >= full_groups { break }
        let base = i * 3
        out = encode_full_group(out, alphabet, data[base], data[base + 1], data[base + 2])
        i++
    }
    let remainder = data.len - (full_groups * 3)
    if remainder == 1 {
        out = encode_tail_group(out, alphabet, data[full_groups * 3], false, 0 to byte)
    } else if remainder == 2 {
        out = encode_tail_group(out, alphabet, data[full_groups * 3], true, data[(full_groups * 3) + 1])
    }
    str(out)
}
pub fn encode_standard(data: []byte) -> str {
    encode(data, standard_alphabet())
}
pub fn encode_url_safe(data: []byte) -> str {
    encode(data, url_safe_alphabet())
}
pub fn encode_url_safe_no_pad(data: []byte) -> str {
    encode(data, url_safe_no_pad_alphabet())
}
fn base64_value_of(alphabet: Base64Alphabet, c: byte) -> u32 | error {
    if c >= b'A' && c <= b'Z' { return (c to u32) - (b'A' to u32) }
    if c >= b'a' && c <= b'z' { return (c to u32) - (b'a' to u32) + 26 }
    if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) + 52 }
    if c == alphabet.char62 { return 62 to u32 }
    if c == alphabet.char63 { return 63 to u32 }
    error { message = "base64: invalid character in input" }
}
type Base64Trimmed = struct {
    /**
     * The input with trailing `=` padding characters removed.
     */
    body: []byte
    /**
     * The count of trailing `=` characters that were removed (0, 1, or 2).
     */
    pad_count: u64
}
fn trim_base64_padding(input: []byte, alphabet: Base64Alphabet) -> Base64Trimmed | error {
    if !alphabet.padded {
        return Base64Trimmed { body = input; pad_count = 0 }
    }
    if input.len == 0 {
        return Base64Trimmed { body = input; pad_count = 0 }
    }
    if input.len % 4 != 0 {
        return error { message = "base64: padded input length must be a multiple of 4" }
    }
    mut pad: u64 = 0
    if input[input.len - 1] == b'=' { pad = 1 }
    if pad == 1 && input.len >= 2 && input[input.len - 2] == b'=' { pad = 2 }
    Base64Trimmed { body = bytes_slice_view(input, 0, input.len - pad); pad_count = pad }
}
fn bytes_slice_view(data: []byte, from: u64, to: u64) -> []byte {
    mut out: []byte = teko::list::empty()
    mut i = from
    loop {
        if i >= to { break }
        out = teko::list::push(out, data[i])
        i++
    }
    out
}
fn decode_full_quantum(out: []byte, alphabet: Base64Alphabet, c0: byte, c1: byte, c2: byte, c3: byte) -> []byte | error {
    let v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
    let v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
    let v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
    let v3 = match base64_value_of(alphabet, c3) { u32 as v => v; error as e => return e }
    mut o = out
    o = teko::list::push(o, ((v0 << 2) | (v1 >> 4)) to byte)
    o = teko::list::push(o, (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte)
    o = teko::list::push(o, (((v2 << 6) | v3) & 0xFF) to byte)
    o
}
fn decode_tail_quantum(out: []byte, alphabet: Base64Alphabet, c0: byte, c1: byte, has_c2: bool, c2: byte) -> []byte | error {
    let v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
    let v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
    mut o = out
    o = teko::list::push(o, ((v0 << 2) | (v1 >> 4)) to byte)
    if has_c2 {
        let v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
        o = teko::list::push(o, (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte)
    }
    o
}
fn decode_trailing_quantum(out: []byte, alphabet: Base64Alphabet, trimmed: Base64Trimmed, start: u64) -> []byte | error {
    let body = trimmed.body
    if trimmed.pad_count == 0 {
        return decode_full_quantum(out, alphabet, body[start], body[start + 1], body[start + 2], body[start + 3])
    }
    if trimmed.pad_count == 1 {
        return decode_tail_quantum(out, alphabet, body[start], body[start + 1], true, body[start + 2])
    }
    decode_tail_quantum(out, alphabet, body[start], body[start + 1], false, 0 to byte)
}
fn validate_unpadded_length(body_len: u64) -> error | null {
    if body_len % 4 == 1 { return error { message = "base64: invalid unpadded input length" } }
    null
}
fn decode_unpadded_tail(out: []byte, alphabet: Base64Alphabet, body: []byte, full_quantums: u64) -> []byte | error {
    let start = full_quantums * 4
    let remainder = body.len - start
    if remainder == 0 { return out }
    if remainder == 2 { return decode_tail_quantum(out, alphabet, body[start], body[start + 1], false, 0 to byte) }
    decode_tail_quantum(out, alphabet, body[start], body[start + 1], true, body[start + 2])
}
fn decode_full_quantums(out: []byte, alphabet: Base64Alphabet, body: []byte, full_quantums: u64) -> []byte | error {
    mut o = out
    mut i: u64 = 0
    loop {
        if i >= full_quantums { break }
        let base = i * 4
        let next = match decode_full_quantum(o, alphabet, body[base], body[base + 1], body[base + 2], body[base + 3]) { []byte as b => b; error as e => return e }
        o = next
        i++
    }
    o
}
pub fn decode(text: str, alphabet: Base64Alphabet) -> []byte | error {
    let input = bytes_of_str(text)
    let trimmed = match trim_base64_padding(input, alphabet) { Base64Trimmed as t => t; error as e => return e }
    if !alphabet.padded {
        match validate_unpadded_length(trimmed.body.len) { null => { }; error as e => return e }
    }
    let body = trimmed.body
    let has_trailing = alphabet.padded && trimmed.pad_count > 0
    let full_quantums = body.len / 4
    mut out = match decode_full_quantums(teko::list::empty(), alphabet, body, full_quantums) { []byte as b => b; error as e => return e }
    if has_trailing {
        return decode_trailing_quantum(out, alphabet, trimmed, full_quantums * 4)
    }
    decode_unpadded_tail(out, alphabet, body, full_quantums)
}
pub fn decode_standard(text: str) -> []byte | error {
    decode(text, standard_alphabet())
}
pub fn decode_url_safe(text: str) -> []byte | error {
    decode(text, url_safe_alphabet())
}
pub fn decode_url_safe_no_pad(text: str) -> []byte | error {
    decode(text, url_safe_no_pad_alphabet())
}
type CsvRow = struct {
    /**
     * The record's field values, in column order.
     */
    fields: []str
}
fn needs_quoting(field: str) -> bool {
    let bytes = bytes_of_str(field)
    mut i: u64 = 0
    loop {
        if i >= bytes.len { break }
        let b = bytes[i]
        if b == b',' || b == b'"' || b == b'\n' || b == b'\r' { return true }
        i++
    }
    false
}
fn append_quoted_field(out: []byte, field: str) -> []byte {
    let bytes = bytes_of_str(field)
    mut o = teko::list::push(out, b'"')
    mut i: u64 = 0
    loop {
        if i >= bytes.len { break }
        let b = bytes[i]
        o = teko::list::push(o, b)
        if b == b'"' { o = teko::list::push(o, b'"') }
        i++
    }
    teko::list::push(o, b'"')
}
fn append_field(out: []byte, field: str) -> []byte {
    if needs_quoting(field) { return append_quoted_field(out, field) }
    mut o = out
    let bytes = bytes_of_str(field)
    mut i: u64 = 0
    loop {
        if i >= bytes.len { break }
        o = teko::list::push(o, bytes[i])
        i++
    }
    o
}
fn append_row(out: []byte, row: CsvRow) -> []byte {
    mut o = out
    mut i: u64 = 0
    loop {
        if i >= row.fields.len { break }
        if i > 0 { o = teko::list::push(o, b',') }
        o = append_field(o, row.fields[i])
        i++
    }
    o = teko::list::push(o, b'\r')
    teko::list::push(o, b'\n')
}
pub fn write_csv(rows: []CsvRow) -> str {
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        out = append_row(out, rows[i])
        i++
    }
    str(out)
}
type FieldStep = struct {
    /**
     * The field's unquoted/unescaped text.
     */
    text: str
    /**
     * The offset in the input just past this field (before any `,`/record-terminator).
     */
    next: u64
}
fn parse_quoted_field(input: []byte, pos: u64) -> FieldStep | error {
    mut i = pos + 1
    mut out: []byte = teko::list::empty()
    loop {
        if i >= input.len { return error { message = "csv: unterminated quoted field" } }
        let b = input[i]
        if b != b'"' {
            out = teko::list::push(out, b)
            i++
            continue
        }
        let is_escaped_quote = i + 1 < input.len && input[i + 1] == b'"'
        if is_escaped_quote {
            out = teko::list::push(out, b'"')
            i = i + 2
            continue
        }
        return FieldStep { text = str(out); next = i + 1 }
    }
    error { message = "csv: unreachable" }
}
fn is_field_boundary(input: []byte, pos: u64) -> bool {
    if pos >= input.len { return true }
    let b = input[pos]
    b == b',' || b == b'\r' || b == b'\n'
}
fn parse_unquoted_field(input: []byte, pos: u64) -> FieldStep {
    mut i = pos
    loop {
        if is_field_boundary(input, i) { break }
        i++
    }
    FieldStep { text = str_slice_bytes_view(input, pos, i); next = i }
}
fn str_slice_bytes_view(data: []byte, from: u64, to: u64) -> str {
    mut out: []byte = teko::list::empty()
    mut i = from
    loop {
        if i >= to { break }
        out = teko::list::push(out, data[i])
        i++
    }
    str(out)
}
fn parse_field(input: []byte, pos: u64) -> FieldStep | error {
    if pos < input.len && input[pos] == b'"' { return parse_quoted_field(input, pos) }
    parse_unquoted_field(input, pos)
}
fn consume_record_terminator(input: []byte, pos: u64) -> u64 {
    if pos >= input.len { return pos }
    if input[pos] == b'\r' && pos + 1 < input.len && input[pos + 1] == b'\n' { return pos + 2 }
    pos + 1
}
fn parse_row(input: []byte, pos: u64) -> RowStep | error {
    mut fields: []str = teko::list::empty()
    mut i = pos
    loop {
        let step = match parse_field(input, i) { FieldStep as s => s; error as e => return e }
        fields = teko::list::push(fields, step.text)
        i = step.next
        if i >= input.len || input[i] == b'\r' || input[i] == b'\n' { break }
        i = i + 1
    }
    let after = consume_record_terminator(input, i)
    RowStep { row = CsvRow { fields = fields }; next = after }
}
type RowStep = struct {
    /**
     * The parsed record.
     */
    row: CsvRow
    /**
     * The offset in the input just past this record's terminator.
     */
    next: u64
}
pub fn parse_csv(text: str) -> []CsvRow | error {
    let input = bytes_of_str(text)
    if input.len == 0 {
        let no_rows: []CsvRow = teko::list::empty()
        return no_rows
    }
    mut rows: []CsvRow = teko::list::empty()
    mut pos: u64 = 0
    loop {
        if pos >= input.len { break }
        let step = match parse_row(input, pos) { RowStep as s => s; error as e => return e }
        rows = teko::list::push(rows, step.row)
        pos = step.next
    }
    rows
}
fn bool_to_i64(b: bool) -> i64 {
    if b { 1 } else { 0 }
}
fn bytes_equal_iface(a: []byte, b: []byte) -> bool {
    if a.len != b.len { return false }
    mut i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}
fn base64_checks() -> i64 {
    let c1 = bool_to_i64(encode_standard(bytes_of_str("Man")) == "TWFu")
    let c2 = bool_to_i64(encode_standard(teko::list::empty()) == "")
    let decoded = match decode_standard("TWFu") {
        []byte as v => v
        error => teko::list::empty()
    }
    let c3 = bool_to_i64(bytes_equal_iface(decoded, bytes_of_str("Man")))
    let raw = bytes_of_str("foobar")
    let round_tripped = match decode_url_safe_no_pad(encode_url_safe_no_pad(raw)) {
        []byte as v => v
        error => teko::list::empty()
    }
    let c4 = bool_to_i64(bytes_equal_iface(round_tripped, raw))
    c1 + c2 + c3 + c4
}
fn url_checks() -> i64 {
    let c1 = bool_to_i64(percent_encode("hello world!") == "hello%20world%21")
    let c2 = bool_to_i64(encode_form_component("john doe") == "john+doe")
    let decoded = match percent_decode("hello%20world%21") {
        str as s => s
        error => ""
    }
    let c3 = bool_to_i64(decoded == "hello world!")
    let fields = match parse_form("name=john+doe&q=a%2Bb") {
        []FormField as f => f
        error => teko::list::empty()
    }
    let c4 = bool_to_i64(fields.len == 2 && fields[0].value == "john doe" && fields[1].value == "a+b")
    c1 + c2 + c3 + c4
}
fn csv_checks() -> i64 {
    mut fields: []str = teko::list::empty()
    fields = teko::list::push(fields, "hello, world")
    fields = teko::list::push(fields, "plain")
    let row = CsvRow { fields = fields }
    mut rows: []CsvRow = teko::list::empty()
    rows = teko::list::push(rows, row)
    let written = write_csv(rows)
    let c1 = bool_to_i64(written == "\"hello, world\",plain\r\n")

    let parsed = match parse_csv("a,b,c\r\n1,2,3\r\n") {
        []CsvRow as r => r
        error => teko::list::empty()
    }
    let c2 = bool_to_i64(parsed.len == 2 && parsed[0].fields[0] == "a" && parsed[1].fields[2] == "3")

    let round_tripped = match parse_csv(written) {
        []CsvRow as r => r
        error => teko::list::empty()
    }
    let c3 = bool_to_i64(round_tripped.len == 1 && round_tripped[0].fields[0] == "hello, world")

    let rejected = match parse_csv("\"unterminated") {
        []CsvRow => false
        error => true
    }
    let c4 = bool_to_i64(rejected)
    c1 + c2 + c3 + c4
}
pub fn check_ops() -> i64 {
    base64_checks() + url_checks() + csv_checks()
}
fn is_unreserved(b: byte) -> bool {
    if b >= b'A' && b <= b'Z' { return true }
    if b >= b'a' && b <= b'z' { return true }
    if b >= b'0' && b <= b'9' { return true }
    b == b'-' || b == b'_' || b == b'.' || b == b'~'
}
fn hex_upper_nibble(nibble: u32) -> byte {
    if nibble < 10 { return (b'0' to u32 + nibble) to byte }
    (b'A' to u32 + (nibble - 10)) to byte
}
fn append_percent_escape(out: []byte, b: byte) -> []byte {
    let v = b to u32
    mut o = out
    o = teko::list::push(o, b'%')
    o = teko::list::push(o, hex_upper_nibble(v >> 4))
    o = teko::list::push(o, hex_upper_nibble(v & 0xF))
    o
}
fn encode_with(text: str, space_as_plus: bool) -> str {
    let input = bytes_of_str(text)
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= input.len { break }
        let b = input[i]
        if space_as_plus && b == b' ' {
            out = teko::list::push(out, b'+')
        } else if is_unreserved(b) {
            out = teko::list::push(out, b)
        } else {
            out = append_percent_escape(out, b)
        }
        i++
    }
    str(out)
}
pub fn percent_encode(text: str) -> str {
    encode_with(text, false)
}
pub fn encode_form_component(text: str) -> str {
    encode_with(text, true)
}
fn hex_digit_value_of(c: byte) -> u32 | error {
    if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) }
    if c >= b'a' && c <= b'f' { return (c to u32) - (b'a' to u32) + 10 }
    if c >= b'A' && c <= b'F' { return (c to u32) - (b'A' to u32) + 10 }
    error { message = "url: invalid hex digit in percent-escape" }
}
type PercentEscapeStep = struct {
    /**
     * The byte the `%XX` escape decoded to.
     */
    value: byte
    /**
     * The offset in the input just past the 3-byte `%XX` escape.
     */
    next: u64
}
fn decode_percent_escape(input: []byte, pos: u64) -> PercentEscapeStep | error {
    if pos + 2 >= input.len { return error { message = "url: truncated percent-escape" } }
    let hi = match hex_digit_value_of(input[pos + 1]) { u32 as v => v; error as e => return e }
    let lo = match hex_digit_value_of(input[pos + 2]) { u32 as v => v; error as e => return e }
    PercentEscapeStep { value = ((hi << 4) | lo) to byte; next = pos + 3 }
}
fn decode_with(text: str, plus_as_space: bool) -> str | error {
    let input = bytes_of_str(text)
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= input.len { break }
        let b = input[i]
        if b == b'%' {
            let step = match decode_percent_escape(input, i) { PercentEscapeStep as s => s; error as e => return e }
            out = teko::list::push(out, step.value)
            i = step.next
            continue
        }
        if plus_as_space && b == b'+' {
            out = teko::list::push(out, b' ')
        } else {
            out = teko::list::push(out, b)
        }
        i++
    }
    str_from_utf8(out)
}
pub fn percent_decode(text: str) -> str | error {
    decode_with(text, false)
}
pub fn decode_form_component(text: str) -> str | error {
    decode_with(text, true)
}
type FormField = struct {
    /**
     * The decoded field name.
     */
    key: str
    /**
     * The decoded field value (empty when the field had no `=value` part).
     */
    value: str
}
fn split_form_segments(body: str) -> []str {
    let input = bytes_of_str(body)
    mut segments: []str = teko::list::empty()
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= input.len { break }
        if input[i] == b'&' || input[i] == b';' {
            segments = teko::list::push(segments, str_slice_chars(body, start to i64, i to i64))
            start = i + 1
        }
        i++
    }
    segments = teko::list::push(segments, str_slice_chars(body, start to i64, input.len to i64))
    segments
}
fn split_key_value(segment: str) -> FormField {
    let input = bytes_of_str(segment)
    mut i: u64 = 0
    loop {
        if i >= input.len { break }
        if input[i] == b'=' {
            return FormField { key = str_slice_chars(segment, 0, i to i64); value = str_slice_chars(segment, (i + 1) to i64, input.len to i64) }
        }
        i++
    }
    FormField { key = segment; value = "" }
}
fn decode_form_segment(segment: str) -> FormField | error {
    let raw = split_key_value(segment)
    let key = match decode_form_component(raw.key) { str as s => s; error as e => return e }
    let value = match decode_form_component(raw.value) { str as s => s; error as e => return e }
    FormField { key = key; value = value }
}
pub fn parse_form(body: str) -> []FormField | error {
    if body.len == 0 {
        let no_fields: []FormField = teko::list::empty()
        return no_fields
    }
    let segments = split_form_segments(body)
    mut fields: []FormField = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= segments.len { break }
        let field = match decode_form_segment(segments[i]) { FormField as f => f; error as e => return e }
        fields = teko::list::push(fields, field)
        i++
    }
    fields
}
pub fn encode_form(fields: []FormField) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= fields.len { break }
        if i > 0 { out = concat(out, "&") }
        out = concat(out, encode_form_component(fields[i].key), "=", encode_form_component(fields[i].value))
        i++
    }
    out
}

