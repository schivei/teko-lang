/**
 * arena_budget_sum — F2 language corpus, batch 2 continuation (0.3.1 SW1 crumb `#453`): a fn
 * carrying `#arena_size(4096)`, the additive, non-`unsafe` per-function arena-budget directive.
 * Its own frame region opens as an INDEPENDENT tree root (`tk_region_new(NULL)`), never a child
 * of the shared process root — the owner's isolate-boundary ruling (2026-07-27): a function that
 * declares its own arena is its own isolation boundary, "como se fosse outro programa" (as if it
 * were another program), exactly like a future isolate's. The workload below (an 8-element list,
 * summed) allocates well under the declared 4096-byte budget: sizing accuracy is the DEVELOPER's
 * job by ruling — the compiler only wires the declared number through, it never infers one.
 *
 * @return the deterministic sum the driver checks (0+1+…+7 == 28)
 */
#arena_size(4096)
pub fn arena_budget_sum() -> i64 {
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= 8 { break }
        xs = teko::list::push(xs, i)
        i = i + 1
    }
    mut total: i64 = 0
    mut j: u64 = 0
    loop {
        if j >= xs.len { break }
        total = total + xs[j]
        j = j + 1
    }
    total
}

/**
 * entry — F2 language corpus — batch 2 (0.3.1 SW1 crumb `#453`) :: arena_size_directive_ok
 *
 * Selected by `TEKO_REGR_ENTRY=q200_arena_size_directive_ok`; a MEMBER NAMESPACE of this
 * project, running off its single shared build.
 */
pub fn entry() {
    exit(arena_budget_sum())
}
