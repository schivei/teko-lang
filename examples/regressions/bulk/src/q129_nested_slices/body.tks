pub fn nested_total() -> i32 {

    let rows: [][]i64 = [[1], [2, 3]]
    mut total = rows[0][0] + rows[1][1] + (rows.len to i64) + (rows[1].len to i64)

    let grid: [][]u8 = [[200, 100], [7]]
    mut y: u8 = grid[0][0]
    y <<= 9
    total = total + ((y to i64) - 140)

    mut acc: [][]i64 = [[10]]
    acc = teko::list::push(acc, [20, 30])
    total = total + acc[1][1] - 28

    let joined: [][]i64 = [..rows, ..acc]
    total = total + (joined.len to i64) - 3

    mut i = 0
    mut sum = 0
    loop {
        if i >= joined.len { break }
        mut j = 0
        loop {
            if j >= joined[i].len { break }
            sum = sum + joined[i][j]
            j++
        }
        i++
    }
    total = total + sum - 65

    total to i32
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: nested_slices
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q129_nested_slices`.
 */
pub fn entry() {
    exit((nested_total()))
}
