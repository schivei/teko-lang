type Sink = interface {
    fn absorb(self, a: i64, b: i64, keep: i64) -> i64
}
type Bin = struct Sink {
    tag: i64
    /**
     * absorb — return `tag + keep`, discarding the first two arguments (their types come by
     * position from Sink::absorb). Demonstrates two `_` discard parameters in a row.
     *
     * @param keep  the one argument this implementation keeps
     * @return      the sum of the bin's tag and the kept argument
     */
    fn absorb(self, _, _, keep: i64) -> i64 { self.tag + keep }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: discard_param_impl
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q071_discard_param_impl`.
 */
pub fn entry() {
    let b = Bin { tag = 3 }
    if b.absorb(10, 20, 4) != 7 { exit(1) }
    if b.absorb(100, 200, 5) != 8 { exit(2) }
    exit(0)
}
