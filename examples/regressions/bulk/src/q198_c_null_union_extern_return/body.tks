/**
 * `extern fn … -> ptr<byte> | null = "getenv"` (c-types-and-marshalling-0.3.1.md §5.4, crumb C2b)
 * — the ONE null-union shape the extern boundary may cross, ratified [PIN-3]. This is
 * `regressor.tkr:87-89`'s escalated FFI pin, authored at last: the checker FORCES the `match`
 * before the value is usable, for BOTH a variable this program set and one it never did.
 *
 * @param name  the variable name, NUL-terminated
 * @return      the value's address when set, `null` when the variable is unset
 */
pub extern fn c_getenv(name: ptr<byte>) -> ptr<byte> | null = "getenv"

/**
 * entry's body — set one variable, leave a second one deliberately unset, and `match` both
 * `c_getenv` results. Exit 0 iff the SET variable's `null` arm never fires and the UNSET
 * variable's non-null arm never fires (i.e. both arms resolve to exactly the branch the C
 * contract predicts); a nonzero, invariant-naming exit otherwise.
 */
pub fn probe_null_union() -> i32 {
    match teko::env::set_var("TEKO_C_TYPES_NULL_UNION_PROBE_SET", "1") { error => return 90; _ => { } }
    let set_name = teko::mem::as_cstr("TEKO_C_TYPES_NULL_UNION_PROBE_SET")
    let unset_name = teko::mem::as_cstr("TEKO_C_TYPES_NULL_UNION_PROBE_UNSET")
    match c_getenv(set_name) {
        ptr<byte> as p => { }
        null => return 91
    }
    match c_getenv(unset_name) {
        ptr<byte> as p => return 92
        null => { }
    }
    0
}

/**
 * entry — F10 c-types-and-marshalling — c_null_union_extern_return.
 */
pub fn entry() {
    exit(probe_null_union())
}
