pub type Version = struct Ord {
    major: i64
    tag: str
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_derive_ord
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q163_trait_derive_ord`.
 */
pub fn entry() {
    let a = Version { major = 1; tag = "a" }
    let b = Version { major = 2; tag = "a" }
    let c = Version { major = 1; tag = "b" }
    let d = Version { major = 1; tag = "a" }
    if a.compare(b) >= 0 { exit(1) }
    if b.compare(a) <= 0 { exit(2) }
    if a.compare(c) >= 0 { exit(3) }
    if c.compare(a) <= 0 { exit(4) }
    if a.compare(d) != 0 { exit(5) }
    if a.compare(a) != 0 { exit(6) }
    exit(0)
}
