pub fn check_static() -> i64 {
    let pi = 3.14159
    let n = 255
    let big = 1234567
    let quarter = 0.25
    if $"{pi:F2}" != "3.14" { return 1 }
    if $"{pi:E3}" != "3.142e+00" { return 2 }
    if $"{pi:G4}" != "3.142" { return 3 }
    if $"{n:D5}" != "00255" { return 4 }
    if $"{n:X}" != "FF" { return 5 }
    if $"{n:x}" != "ff" { return 6 }
    if $"{n:b}" != "11111111" { return 7 }
    if $"{big:N}" != "1,234,567" { return 8 }
    if $"{pi:N2}" != "3.14" { return 9 }
    if $"{quarter:P1}" != "25.0%" { return 10 }
    0
}
pub fn check_dynamic() -> i64 {
    let pi = 3.14159
    let n = 255
    let big = 1234567
    let quarter = 0.25
    let f2 = "F2"
    let e3 = "E3"
    let g4 = "G4"
    let d5 = "D5"
    let x_up = "X"
    let x_lo = "x"
    let bin = "b"
    let grp = "N"
    let n2 = "N2"
    let p1 = "P1"
    if $"{pi:[f2]}" != "3.14" { return 101 }
    if $"{pi:[e3]}" != "3.142e+00" { return 102 }
    if $"{pi:[g4]}" != "3.142" { return 103 }
    if $"{n:[d5]}" != "00255" { return 104 }
    if $"{n:[x_up]}" != "FF" { return 105 }
    if $"{n:[x_lo]}" != "ff" { return 106 }
    if $"{n:[bin]}" != "11111111" { return 107 }
    if $"{big:[grp]}" != "1,234,567" { return 108 }
    if $"{pi:[n2]}" != "3.14" { return 109 }
    if $"{quarter:[p1]}" != "25.0%" { return 110 }
    0
}
pub fn check_coercion_edges() -> i64 {
    let neg1 = -1
    let u10 = 10 to u64
    if $"{neg1:X}" != "FFFFFFFFFFFFFFFF" { return 201 }
    if $"{neg1:b}" != "1111111111111111111111111111111111111111111111111111111111111111" { return 202 }
    if $"{u10:D3}" != "010" { return 203 }
    if $"{u10:X}" != "A" { return 204 }
    0
}
pub fn check_sbmd() -> i64 {
    let s = check_static()
    if s != 0 { return s }
    let d = check_dynamic()
    if d != 0 { return d }
    let c = check_coercion_edges()
    if c != 0 { return c }
    42
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: format_spec_families
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q080_format_spec_families`.
 */
pub fn entry() {
    exit(check_sbmd() to i32)
}
