type Weighable = interface {
    fn measure(self) -> i64
}
type Priced = interface {
    fn measure(self) -> i64
}
type OnlyFirst = class & Weighable {
    pub v: i64
    pub fn make(x: i64) -> OnlyFirst { OnlyFirst { v = x } }
    pub fn measure(self) -> i64 { self.v + 1 }
}
type OnlySecond = class & Priced {
    pub v: i64
    pub fn make(x: i64) -> OnlySecond { OnlySecond { v = x } }
    pub fn measure(self) -> i64 { self.v + 2 }
}
fn probe<T: Weighable | Priced>(x: T) -> i64 { return x.measure() }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: constrained_or_dispatch
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q057_constrained_or_dispatch`.
 */
pub fn entry() {
    let first = OnlyFirst::make(10)
    let second = OnlySecond::make(20)
    if probe(first) != 11 { exit(1) }
    if probe(second) != 22 { exit(2) }
    exit(0)
}
