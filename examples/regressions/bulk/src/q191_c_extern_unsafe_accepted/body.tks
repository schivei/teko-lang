/**
 * `pub extern unsafe fn … = "sym"` (C0, c-types-and-marshalling-0.3.1.md §4) — the frontier's
 * spelling PARSES, CHECKS, LINKS, and RUNS, pinning the doc-comment correction at
 * `src/parser/parse_decl.tks::consume_unsafe_modifier`: `extern` is consumed FIRST, `unsafe` is
 * consumed second and threads `is_unsafe` through to the `Function` node unchanged. No prior
 * fixture in this tree marked a raw-libc extern `unsafe`, so this is the first proof that the
 * marker survives all the way to a linked, running binary.
 */
pub extern unsafe fn c_abs(x: i32) -> i32 = "abs"

/**
 * entry — F10 c-types-and-marshalling — c_extern_unsafe_accepted.
 */
pub fn entry() {
    let negated: i32 = -42
    exit(c_abs(negated))
}
