type Node_mcni = struct {
    /** the cell's payload value, folded by `sum_mcni`. */
    val: i64
    /** the following cell, or `null` at the tail — the recursive `Node_mcni | null` back-edge. */
    next: Node_mcni | null
}
pub fn cons(val: i64, rest: Node_mcni | null) -> Node_mcni {
    return Node_mcni { val = val; next = rest }
}
pub fn build3() -> Node_mcni {
    return cons(10, cons(20, cons(12, null)))
}
pub fn sum_mcni(n: Node_mcni | null) -> i64 {
    match n {
        Node_mcni as cell => return cell.val + sum_mcni(cell.next)
        null => return 0
    }
}

/**
 * entry — F3 null-union — folded from the retired nullfield_variant_* dirs (dobrado, dir removido)
 *          :: self-referential list through a boxed null-union field (folds nullfield_variant_recursive)
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q012_self_referential_list_through_a_boxed`.
 */
pub fn entry() {
    exit(sum_mcni(build3()) to i32)
}
