pub type Config = struct Clone & Default & Eq {
    flag: bool
    count: i64
    ratio: f64
    name: str
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_derive_clone_default
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q159_trait_derive_clone_default`.
 */
pub fn entry() {
    let a = Config { flag = true; count = 42; ratio = 2.5; name = "prod" }
    let cloned = a.clone()
    if !a.eq(cloned) { exit(1) }
    if cloned.flag != true { exit(2) }
    if cloned.count != 42 { exit(3) }
    if cloned.ratio != 2.5 { exit(4) }
    if cloned.name != "prod" { exit(5) }
    let z = Config::default()
    if z.flag != false { exit(6) }
    if z.count != 0 { exit(7) }
    if z.ratio != 0.0 { exit(8) }
    if z.name != "" { exit(9) }
    if !z.eq(Config::default()) { exit(10) }
    exit(0)
}
