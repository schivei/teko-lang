type Meta_iface = struct { tag: u8; code: i32; flag: bool }
const M: Meta_iface = Meta_iface { tag = 3 to u8; code = 100; flag = true }
fn meta_tag() -> i32 {
    M.tag to i32
}
fn meta_code() -> i32 {
    M.code
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: const_agg_struct_rodata
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q052_const_agg_struct_rodata`.
 */
pub fn entry() {
    exit(meta_tag() + meta_code() + (if M.flag { 1 } else { 0 }))
}
