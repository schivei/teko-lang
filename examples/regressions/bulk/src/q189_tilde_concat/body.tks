/**
 * entry — F2 language corpus :: tilde_concat.
 *
 * Unfolded from a `Given source` case file into a MEMBER NAMESPACE of this project, so it runs off
 * the project's single build instead of paying for one of its own. The ONLY edit is the fixture's
 * top-level `return <sum>`, now `exit((<sum>) to i32)`: a top-level `return` is exactly what
 * `snippet_stmts_have_return` refuses to fold, and in a virtual main the two spell the same exit.
 * Every other line is byte-identical to the case file — several of them are multi-line string
 * literals whose CONTENT is measured by the assertion, so re-indenting them would change the answer.
 */
pub fn entry() {
    let x = "hello"
    let y = "world"
    let a = "lit" ~ "eral" ~ "-fold"
    let b = x ~ " " ~ y
    let c = "pre-" ~ "fix-" ~ x ~ "-suf" ~ "-fix"

    let name = "world"
    let m1 = "foo" ~ "bar"
    let m2 = @"C:\raw" ~ "-tail"
    let m3 = """multi
line""" ~ "-tail"
    let m4 = @"""verbatim
multi""" ~ "-tail"
    let m5 = $"hi {name}" ~ "!"
    let m6 = $"""hi
{name}""" ~ "!"
    let m7 = $@"raw {name}\n" ~ "!"
    let m8 = $@"""raw
{name}""" ~ "!"
    let m9 = "pre-" ~ @"""mid
part""" ~ name ~ "-post"
    let m10 = $"no holes here" ~ "-tail"
    let m11 = $@"""no holes
multiline""" ~ "-tail"

    exit((a.len + b.len + c.len + m1.len + m2.len + m3.len + m4.len + m5.len + m6.len + m7.len + m8.len + m9.len + m10.len + m11.len) to i32)
}
