type Counter_sbmd = class {
    value: i64
    fn make(v: i64) -> Counter_sbmd { Counter_sbmd { value = v } }
    fn destruct(self) -> void { }
    pub fn use_and_drop(v: i64) -> i64 {
        let c = Counter_sbmd::make(v)
        if c.value > 1000 { exit(9) }
        42
    }
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: class_destruction
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q035_class_destruction`.
 */
pub fn entry() {
    if Counter_sbmd::use_and_drop(21) != 42 { exit(1) }
}
