/**
 * A LOCAL COPY of `teko::mem::unsafe::Arena` (see `q023_arena_manual_ok/body.tks`).
 */
#must_free
pub unsafe type Arena = struct {
    /** The raw `tk_region *` this handle owns, carried as an opaque `uptr`; 0 once bulk-freed. */
    region: uptr

    /**
     * Opens a fresh manual region (a new child of the process root) and wraps its raw handle.
     *
     * @return a fresh `Arena` owning a newly opened child region
     */
    pub fn new() -> Arena {
        Arena { region = teko::mem::region_new() }
    }
}

/**
 * A LOCAL COPY of `teko::c_types::c_string`'s tier-2 constructor (c-types-and-marshalling-0.3.1.md
 * §7.2, crumb C6) — see `staged/c_types/c_types.tks` for the canonical, fully-documented original.
 */
pub unsafe fn local_cstring_in_arena(a: Arena, s: str) -> ptr<byte> {
    teko::mem::region_buf(a.region, s.len + 1, s)
}

/**
 * entry's body — the TIER-2 lifetime differential (§10 C6): build a `c_string` INSIDE `a` (a
 * region that OUTLIVES the `adopt` block below) from within that block, let the block's own
 * enclosing region bulk-drop at its closing brace, and read the octets back AFTER the block —
 * proving they survived past where a tier-1 (`c_string_for_call`, enclosing-region) construction
 * would have died. Needs no C stub: the differential is entirely in WHICH region owns the bytes.
 *
 * @return i32  0 iff the octets read back after the block still match the original length
 */
pub unsafe fn probe_outlives() -> i32 {
    mut a = Arena::new()
    mut cs_ptr: ptr<byte> = teko::mem::as_cstr("")
    mut cs_len: u64 = 0
    adopt {
        let payload = "outlives the block"
        cs_ptr = local_cstring_in_arena(a, payload)
        cs_len = payload.len
    }
    let read_back = teko::mem::str_from_c(cs_ptr, cs_len + 1)
    let ok = read_back.len == cs_len
    teko::mem::free(a)
    if ok { 0 } else { 1 }
}

/**
 * entry — F10 c-types-and-marshalling — c_string_outlives_enclosing_region.
 */
pub fn entry() {
    exit(probe_outlives())
}
