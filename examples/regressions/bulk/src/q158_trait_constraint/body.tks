pub type Measurable_mcni = trait {
    fn size(self) -> i64
    fn doubled(self) -> i64 { self.size() * 2 }
}
pub type Named2 = interface {
    fn label(self) -> str
}
pub type Box2_mcni = class & Measurable_mcni {
    w: i64
    pub fn make(x: i64) -> Box2_mcni { Box2_mcni { w = x } }
    pub fn size(self) -> i64 { self.w }
}
pub type Bag = class & Measurable_mcni & Named2 {
    items: i64
    pub fn make(n: i64) -> Bag { Bag { items = n } }
    pub fn size(self) -> i64 { self.items * 3 }
    pub fn label(self) -> str { "bag" }
}
pub type Tag = struct Measurable_mcni {
    n: i64
    fn size(self) -> i64 { self.n }
}
pub fn total2<T: Measurable_mcni>(x: T) -> i64 { x.size() + x.doubled() }
pub fn tagged_total<T: Measurable_mcni & Named2>(x: T) -> i64 {
    if x.label() == "bag" { return x.size() }
    x.doubled()
}
pub fn hold<T: Measurable_mcni>(x: T) -> T { x }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_constraint
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q158_trait_constraint`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Box -> Box2_mcni, Named -> Named2, total -> total2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let b = Box2_mcni::make(5)
    if total2(b) != 15 { exit(1) }
    let g = Bag::make(4)
    if total2(g) != 36 { exit(2) }
    if tagged_total(g) != 12 { exit(3) }
    let t = Tag { n = 9 }
    let held = hold(t)
    if held.n != 9 { exit(4) }
    exit(0)
}
