use di_left
use di_right

/**
 * entry — the `di_same_name_cross_ns` regression (issue #284): two DI providers of the SAME bare
 * class name (`Svc_di`) in DIFFERENT namespaces, each a `#singleton` implementing a same-bare
 * interface (`di_left::Face` / `di_right::Face`), both injected. Pre-#284 the checker keyed
 * `di_type_id`, the `__di_materialize_<Impl>` symbol and the provider slot by the BARE last segment,
 * so the two collided — a conservative "ambiguous DI registration" error, a symbol clash, or a wrong
 * resolution. Keying by the FULL canonical (namespace-qualified) name makes them DISTINCT.
 *
 * TWO RENAMES, both forced by the merge and neither of them cosmetic. The namespaces were `left` and
 * `right` while this was a project of its own; a directory IS a namespace and
 * `same_bare_method_dispatch` brought its own `left`/`right` pair into the same build, so they are
 * `di_left`/`di_right` here. The class was `Svc`; `same_bare_method_dispatch` pins THREE same-bare
 * `Svc` classes and holding all five in one build stops the compiler with "method `tag` not found in
 * `Svc`'s class chain" — the #290 defect class, still open for a five-way collision. This channel
 * therefore reproduces the pre-merge arrangement (two `Svc_di` here, three `Svc` there) rather than
 * inventing a collision no project ever pinned; the five-way case is REPORTED, not silently created.
 * What this scenario asserts — two DISTINCT namespaces sharing ONE bare class name, each resolving
 * its own — is untouched.
 *
 * @return void — diverges with the scenario's exit code
 */
pub fn entry() {
    if di_left::ask() != 1 { exit(1) }
    if di_right::ask() != 2 { exit(2) }
    exit(42)
}
