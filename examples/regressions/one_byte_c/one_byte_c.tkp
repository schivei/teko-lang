# examples/regressions/one_byte_c — o ORACULO de rota C do regressor de `one_byte`
# (0.3.1.0 degrau 32).
#
# O programa e o mesmo de `examples/regressions/one_byte_native` byte a byte, e a duplicacao e
# deliberada: `tkr_ensure_built` (`src/build/regression.tks`) compila um projecto UMA VEZ por
# ficheiro `.tkr`, com o env do PRIMEIRO cenario, e a cache e chaveada na FORMA do build e nao no
# env (`regr_built_serves`). Um cenario de rota C ao lado do nativo no mesmo `.tkr` correria
# portanto o binario NATIVO com `TEKO_BACKEND=c` posto so a execucao — mediria a coisa errada em
# silencio — e dois `.tkr` na MESMA pasta escreveriam ambos em `<pasta>/bin/<nome>`, que a corrida
# do regressor pode paralelizar.
#
# O QUE ESTE LADO AFIRMA: que 255 e o valor VERDADEIRO e nao o que o baixamento nativo calhou de
# produzir. A rota C resolve `one_byte` para `tk_one_byte` (`src/codegen/codegen.tks:4334`), um
# caminho independente do gemeo `tk_one_byte_len` que o backend nativo passou a usar.
name = "one_byte_c"
source = "src"

[artifact]
kind = "binary"
