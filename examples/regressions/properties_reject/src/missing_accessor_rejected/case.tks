/**
 * RwCell — an interface declaring a READ-WRITE property `value` (both a getter and a setter). An
 * implementer must provide BOTH accessors; omitting one is a conformance failure.
 */
type RwCell = interface {
    /** value — the read half of the property (getter). */
    get value(): i64
    /** value — the write half of the property (setter). */
    set value(v: i64)
}

/**
 * HalfImp — a BROKEN implementer of `RwCell`: it provides the getter but NOT the required setter, so
 * conformance must fail — the setter accessor is a required contract method the class does not supply.
 */
type HalfImp = class & RwCell {
    /** _v — the private backing field the getter reads. */
    _v: i64

    /**
     * make — the static factory for a `HalfImp`.
     *
     * @return a fresh zeroed `HalfImp`
     */
    pub static fn make(): HalfImp { HalfImp { _v = 0 } }

    /**
     * value — the getter (the setter is intentionally missing, so the class does not conform).
     *
     * @return the backing `_v`
     */
    pub get value(): i64 { self._v }
}
