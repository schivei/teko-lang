/**
 * WoCell — an interface declaring a WRITE-ONLY property `value` (a setter only). Reading it must be
 * rejected: a set-only property is write-only (§9 ruling 1).
 */
type WoCell = interface {
    /** value — the write-only property (setter only). */
    set value(v: i64)
}

/**
 * WoImp — a class implementer of `WoCell` providing the required setter over a backing field.
 */
type WoImp = class & WoCell {
    /** _v — the private backing field the setter writes. */
    _v: i64

    /**
     * make — the static factory for a `WoImp`.
     *
     * @return a fresh zeroed `WoImp`
     */
    pub static fn make(): WoImp { WoImp { _v = 0 } }

    /**
     * value — the setter for the write-only property.
     *
     * @param v  the new value
     */
    pub set value(v: i64) { self._v = v }
}

/**
 * read_wo — READ a write-only property, the rejected construct: `w.value` has no getter, so the
 * checker must reject it as write-only.
 *
 * @param w  the write-only-property carrier
 * @return   never — the build fails
 */
fn read_wo(w: WoCell): i64 {
    w.value
}
