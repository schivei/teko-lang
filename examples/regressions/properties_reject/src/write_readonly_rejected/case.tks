/**
 * RoCell — an interface declaring a READ-ONLY property `value` (a getter only). Writing it must be
 * rejected: a get-only property is read-only (§9 ruling 1).
 */
type RoCell = interface {
    /** value — the read-only property (getter only). */
    get value(): i64
}

/**
 * RoImp — a class implementer of `RoCell` providing the required getter over a backing field.
 */
type RoImp = class & RoCell {
    /** _v — the private backing field the getter reads. */
    _v: i64

    /**
     * make — the static factory for a `RoImp`.
     *
     * @return a fresh zeroed `RoImp`
     */
    pub static fn make(): RoImp { RoImp { _v = 0 } }

    /**
     * value — the getter for the read-only property.
     *
     * @return the backing `_v`
     */
    pub get value(): i64 { self._v }
}

/**
 * write_ro — WRITE a read-only property, the rejected construct: `r.value = 3` has no setter, so the
 * checker must reject it as read-only.
 *
 * @param r  the read-only-property carrier
 */
fn write_ro(r: RoCell) {
    r.value = 3
}
