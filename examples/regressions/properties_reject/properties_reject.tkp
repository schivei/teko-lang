# examples/regressions/properties_reject — the §9 properties REJECT host. Four property violations
# live one per namespace under src/, and the single failing build reports all four diagnostics — the
# compiler reports every diagnostic it finds (parse AND checker) rather than stopping at the first, so
# one build pins them all, one per scenario in the .tkr: writing a read-only property, reading a
# write-only property, an implementer missing a required accessor, and a getter with no return type.
# It has no successful build to sanitize/run.
name = "properties_reject"
source = "src"

[artifact]
kind = "binary"
