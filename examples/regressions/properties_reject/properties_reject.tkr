# properties_reject.tkr — the §9 properties REJECT host. Four property violations live one per
# namespace under src/, and the single failing build reports all four diagnostics (parse AND checker
# — the compiler reports every diagnostic it finds rather than stopping at the first), one per
# scenario below. It has no successful build to sanitize/run. Read-only/write-only enforcement emerges
# from the two use-site desugars (a read of a getter-less property is write-only, a write of a
# setter-less property is read-only); a missing accessor is caught by ordinary method conformance
# (the accessor IS a method); a getter with no return type is a parse-shape error.

Feature: §9 properties reject — the compiler rejects the illegal property forms

  # (write_readonly_rejected) writing a get-only property has no setter to dispatch — read-only.
  Scenario: write_readonly_rejected — writing a read-only property is rejected
    When compilation fails
    Then diagnostic = "property 'value' is read-only — it has a getter but no setter"

  # (read_writeonly_rejected) reading a set-only property has no getter to dispatch — write-only.
  Scenario: read_writeonly_rejected — reading a write-only property is rejected
    When compilation fails
    Then diagnostic = "property 'value' is write-only — it has a setter but no getter"

  # (missing_accessor_rejected) an implementer of a read-write property that supplies only the getter
  # fails conformance — the setter accessor is a required contract method it does not provide.
  Scenario: missing_accessor_rejected — an implementer missing a required accessor is rejected
    When compilation fails
    Then diagnostic = "missing setter for property 'value'"

  # (getter_no_return_rejected) a getter must declare a return type; the bare `get value()` is a
  # parse-shape error.
  Scenario: getter_no_return_rejected — a getter with no return type is rejected
    When compilation fails
    Then diagnostic = "a getter must declare a return type"
