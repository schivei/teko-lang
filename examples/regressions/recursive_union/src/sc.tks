/**
 * run — execute ONE §9.D recursive-inline-union scenario: name it, assert its announced value, and
 * print the `scenario <name>: ok` line the companion `recursive_union.tkr` demands BY NAME. Every
 * `run(...)` call in `main.tks` has exactly one matching row and vice versa.
 *
 * @param name  the scenario's name, spelled identically in the `.tkr` `Scenario:` line
 * @param got   what the scenario's probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the scenario and both values
 */
fn run(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}
