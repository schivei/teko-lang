/**
 * SYS_MMAP — the x86_64 Linux syscall number for `mmap(addr, length, prot, flags, fd, offset)`.
 * This is the fixture's LOCAL mirror of the real `teko::sys::SYS_MMAP` (`src/sys/sys.tks` in the
 * compiler's own project) — every value here is a literal Teko `const`, transcribed from the
 * kernel ABI table, NEVER imported from a C header/macro, and per-`#os`/`#arch` guarded so the
 * §17 prune (`src/build/prune.tks`) keeps exactly the definition matching the compiled target,
 * before the checker ever sees the others. x86_64 value: 9
 * (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_MMAP: i64 = 9

/**
 * SYS_MMAP — the aarch64 Linux syscall number for `mmap(addr, length, prot, flags, fd, offset)`.
 * Value 222 (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (9) — the
 * reason this constant cannot be a single cross-arch definition and must carry its own
 * `#arch("aarch64")` block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_MMAP: i64 = 222

/**
 * SYS_MUNMAP — the x86_64 Linux syscall number for `munmap(addr, length)`. Value 11
 * (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_MUNMAP: i64 = 11

/**
 * SYS_MUNMAP — the aarch64 Linux syscall number for `munmap(addr, length)`. Value 215 (the
 * `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (11) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_MUNMAP: i64 = 215

/**
 * PROT_READ — the `mmap`/`mprotect` protection flag requesting that the mapped pages be
 * readable. The `PROT_*`/`MAP_*` flags are the Linux `asm-generic/mman-common.h` values,
 * identical on every architecture (unlike the `SYS_*` syscall numbers above), so each carries a
 * single `#os("linux")` guard with no `#arch` split. Value: 1.
 *
 * @since §16
 */
#os("linux")
pub const PROT_READ: i64 = 1

/**
 * PROT_WRITE — the `mmap`/`mprotect` protection flag requesting that the mapped pages be
 * writable. Value: 2.
 *
 * @since §16
 */
#os("linux")
pub const PROT_WRITE: i64 = 2

/**
 * MAP_PRIVATE — the `mmap` flag requesting a private copy-on-write mapping; REQUIRED — Linux
 * rejects a mapping request naming neither `MAP_PRIVATE` nor `MAP_SHARED`. Value: 2.
 *
 * @since §16
 */
#os("linux")
pub const MAP_PRIVATE: i64 = 2

/**
 * MAP_ANONYMOUS — the `mmap` flag requesting a mapping not backed by any file: the kernel
 * zero-fills the pages instead of reading them from `fd`, which must then be ignored (by
 * convention passed as `-1`). Value: `0x20` (32).
 *
 * @since §16
 */
#os("linux")
pub const MAP_ANONYMOUS: i64 = 0x20
