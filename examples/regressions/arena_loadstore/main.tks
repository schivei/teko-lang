var addr = teko::sys::syscall6(sys::SYS_MMAP, 0, 4096, sys::PROT_READ | sys::PROT_WRITE, sys::MAP_PRIVATE | sys::MAP_ANONYMOUS, -1, 0)
if addr <= 0 { exit(1) }
var uaddr = addr to u64
teko::mem::store_u64(uaddr, 0x1122334455667788 to u64)
var got = teko::mem::load_u64(uaddr)
var freed = teko::sys::syscall2(sys::SYS_MUNMAP, addr, 4096)
if got == 0x1122334455667788 to u64 && freed == 0 { exit(0) }
exit(1)
