var b = bytes_of_str("Hello, world! Ação café 中文 😀")
var cps = match text::decode_utf8_u32(b) { []u32 as c => c; error => exit(1) }
var back = match text::encode_u32_utf8(cps) { []byte as bs => bs; error => exit(1) }
if back.len != b.len { exit(1) }
var i: u64 = 0
loop {
    if i >= b.len { break }
    if back[i] != b[i] { exit(1) }
    i++
}
exit(0)
