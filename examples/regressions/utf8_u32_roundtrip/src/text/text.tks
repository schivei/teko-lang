type Lead = struct {
    cont: u64
    lo: byte
    hi: byte
}

pub fn valid_utf8(s: []byte): bool {
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        var b = s[i]
        if b <= 0x7F { i++; continue }

        var lead = match b {
            0xC2 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC3 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC4 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC5 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC6 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC7 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC8 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xC9 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCA => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCB => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCC => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCD => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCE => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xCF => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD0 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD1 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD2 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD3 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD4 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD5 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD6 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD7 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD8 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xD9 => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDA => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDB => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDC => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDD => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDE => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xDF => Lead { cont = 1; lo = 0x80; hi = 0xBF }
            0xE0 => Lead { cont = 2; lo = 0xA0; hi = 0xBF }
            0xE1 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE2 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE3 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE4 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE5 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE6 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE7 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE8 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xE9 => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xEA => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xEB => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xEC => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xED => Lead { cont = 2; lo = 0x80; hi = 0x9F }
            0xEE => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xEF => Lead { cont = 2; lo = 0x80; hi = 0xBF }
            0xF0 => Lead { cont = 3; lo = 0x90; hi = 0xBF }
            0xF1 => Lead { cont = 3; lo = 0x80; hi = 0xBF }
            0xF2 => Lead { cont = 3; lo = 0x80; hi = 0xBF }
            0xF3 => Lead { cont = 3; lo = 0x80; hi = 0xBF }
            0xF4 => Lead { cont = 3; lo = 0x80; hi = 0x8F }
            _ => return false
        }

        if s.len - i <= lead.cont { return false }
        if s[i + 1] < lead.lo || s[i + 1] > lead.hi { return false }

        var k: u64 = 2
        loop {
            if k > lead.cont { break }
            var cb = s[i + k]
            if cb < 0x80 || cb > 0xBF { return false }
            k++
        }
        i = i + lead.cont + 1
    }
    true
}

fn utf8_codepoint_count(b: []byte): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        if ((b[i] to u32) & 0xC0) != 0x80 { n++ }
        i++
    }
    n
}

fn utf8_lead_len(lead: byte): u64 {
    if lead <= 0x7F { return 0 }
    if lead <= 0xDF { return 1 }
    if lead <= 0xEF { return 2 }
    3
}

fn utf8_lead_mask(extra: u64): u32 {
    if extra == 0 { return 0x7F }
    if extra == 1 { return 0x1F }
    if extra == 2 { return 0x0F }
    0x07
}

fn utf8_decode_one(b: []byte, i: u64, extra: u64): u32 {
    var cp: u32 = (b[i] to u32) & utf8_lead_mask(extra)
    var j: u64 = 1
    loop {
        if j > extra { break }
        cp = (cp << 6) | ((b[i + j] to u32) & 0x3F)
        j++
    }
    cp
}

pub fn decode_utf8_u32(b: []byte): []u32 | error {
    if !valid_utf8(b) { return error { message = "invalid utf-8 sequence" } }
    var n = utf8_codepoint_count(b)
    var cps: [n]u32 = []
    var i: u64 = 0
    var k: u64 = 0
    loop {
        if i >= b.len { break }
        var extra = utf8_lead_len(b[i])
        cps[k] = utf8_decode_one(b, i, extra)
        i = i + extra + 1
        k++
    }
    cps
}

fn utf8_cp_reject(cp: u32): error | null {
    if cp >= 0xD800 && cp <= 0xDFFF { return error { message = "surrogate not a scalar value" } }
    if cp > 0x10FFFF { return error { message = "codepoint exceeds U+10FFFF" } }
    null
}

fn utf8_cp_len(cp: u32): u64 {
    if cp <= 0x7F { return 1 }
    if cp <= 0x7FF { return 2 }
    if cp <= 0xFFFF { return 3 }
    4
}

fn utf8_lead_byte(cp: u32, elen: u64): byte {
    if elen == 1 { return cp to byte }
    if elen == 2 { return (0xC0 | (cp >> 6)) to byte }
    if elen == 3 { return (0xE0 | (cp >> 12)) to byte }
    (0xF0 | (cp >> 18)) to byte
}

fn utf8_cont_byte(cp: u32, elen: u64, j: u64): byte {
    var shift = (elen - 1 - j) * 6
    (0x80 | ((cp >> shift) & 0x3F)) to byte
}

pub fn encode_u32_utf8(cps: []u32): []byte | error {
    var total: u64 = 0
    var i: u64 = 0
    loop {
        if i >= cps.len { break }
        match utf8_cp_reject(cps[i]) { null => { }; error as e => return e }
        total = total + utf8_cp_len(cps[i])
        i++
    }
    var out: [total]byte = []
    var k: u64 = 0
    i = 0
    loop {
        if i >= cps.len { break }
        var cp = cps[i]
        var elen = utf8_cp_len(cp)
        out[k] = utf8_lead_byte(cp, elen)
        var j: u64 = 1
        loop {
            if j >= elen { break }
            out[k + j] = utf8_cont_byte(cp, elen, j)
            j++
        }
        k = k + elen
        i++
    }
    out
}
