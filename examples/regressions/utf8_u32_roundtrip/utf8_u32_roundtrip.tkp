# examples/regressions/utf8_u32_roundtrip — the SM-STRU32 (crumb 0025) codec fixture. Proves
# `teko::text::encode_u32_utf8(teko::text::decode_utf8_u32(b)) == b` for a mix of ASCII, 2/3-byte
# BMP, and 4-byte astral UTF-8 text. A SELF-CONTAINED project (its own local copy of the codec
# pair under `src/text/text.tks`), same rationale as `examples/regressions/arena_loadstore`: the
# real `teko::text` lives in the COMPILER's own project (root `teko`, reserved) and an external
# standalone project has no visibility into it.
name = "utf8_u32_roundtrip"
source = "src"

[artifact]
kind = "binary"
