type Reader = interface {
    /**
     * read — yield the reader's value offset by `n`.
     *
     * @param n  the caller's per-read offset
     * @return   the reader's stored value plus `n`
     */
    fn read(self, n: i64) -> i64
}
type SReader = struct Reader {
    /** The stored base value. */
    v: i64

    /**
     * read — the `Reader` contract for the struct.
     *
     * @param n  the caller's per-read offset
     * @return   `self.v + n`
     */
    fn read(self, n: i64) -> i64 { self.v + n }
}
pub fn pull_g<T: Reader>(r: T, n: i64) -> i64 {
    let a = r.read(n)
    let b = r.read(n + 1)
    a + b
}
pub fn scenario() -> i64 { pull_g(SReader { v = 1 }, 2) }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iface_constraint_struct_ok
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q087_iface_constraint_struct_ok`.
 */
pub fn entry() {
    exit(scenario())
}
