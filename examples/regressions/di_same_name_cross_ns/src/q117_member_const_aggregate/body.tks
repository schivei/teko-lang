type Meta = struct {
    /** a one-byte tag at offset 0 */
    tag: u8
    /** a four-byte code at offset 4 */
    code: i32
}
type Registry = struct {
    /** an unrelated instance field */
    slot: i64
    /** DEFAULT — a Tier-A aggregate static member const, resolved by `Registry::DEFAULT`. */
    pub const DEFAULT: Meta = Meta { tag = 2 to u8; code = 40 }
}
fn default_tag() -> i32 {
    let d = Registry::DEFAULT
    d.tag to i32
}
fn default_code() -> i32 {
    let d = Registry::DEFAULT
    d.code
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: member_const_aggregate
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q117_member_const_aggregate`.
 */
pub fn entry() {
    exit(default_tag() + default_code())
}
