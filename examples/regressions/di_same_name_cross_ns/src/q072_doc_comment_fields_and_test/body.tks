pub type Point = struct {
    /**
     * The x coordinate.
     */
    x: i64
    /**
     * The y coordinate.
     */
    y: i64
}
pub type Vector = class {
    /**
     * The horizontal component.
     */
    pub dx: i64
    /**
     * The vertical component.
     */
    pub dy: i64

    /**
     * Build a Vector from its two components.
     *
     * @param dx  the horizontal component
     * @param dy  the vertical component
     * @return    the constructed Vector
     */
    pub fn make(dx: i64, dy: i64) -> Vector { Vector { dx = dx; dy = dy } }
}
pub fn total(p: Point, v: Vector) -> i64 {
    p.x + p.y + v.dx + v.dy
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: doc_comment_fields_and_test
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q072_doc_comment_fields_and_test`.
 */
pub fn entry() {
    let p = Point { x = 1; y = 2 }
    let v = Vector::make(3, 4)
    exit(total(p, v) - 10)
}
