/**
 * A `5 to u32` on a u32 binding is CLASS-2 redundant (`cast-width-hygiene-0.3.1.md` §4/§9):
 * the bare literal `5` already adopts `u32` from the binding's annotation
 * (literal-context typing, `.29`), so the explicit `to u32` was always a no-op — swept by C4
 * (the D1 diagnostic covers class 1/3 only; a bare-literal cast like this one is deleted at the
 * source rather than promoted to a live error, since its redundancy depends on the binding's
 * own context, not a structurally-provable invariant `type_cast` alone can see).
 *
 * @return 5
 */
pub fn redundant_cast() -> i64 {
    let x: u32 = 5
    x to i64
}
