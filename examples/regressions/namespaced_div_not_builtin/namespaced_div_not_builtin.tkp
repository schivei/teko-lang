# Regression #265: a USER function named `div` in a namespace (here `mathx::div`, i64->i64) must
# lower to its OWN mangled C symbol, never confused with an unqualified bare-name match. (The
# reserved arithmetic builtin this guard historically protected against — `tk_div`, the retired
# VM's own wide i128 `/` lowering — was itself removed with the surface, drop-128 2026-07-24; the
# namespace-resolution guard this fixture exercises still stands on its own merits.) The native
# test gate cc-compiles such a call for the first time; a bare-name match that ignored the
# namespace would emit the wrong symbol and cc would reject it.
#
#   teko run   examples/regressions/namespaced_div_not_builtin   # VM     → exit 7
#   teko build examples/regressions/namespaced_div_not_builtin && ./examples/regressions/namespaced_div_not_builtin/namespaced_div_not_builtin   # native → exit 7
name = "namespaced_div_not_builtin"
source = "src"

[artifact]
kind = "binary"
