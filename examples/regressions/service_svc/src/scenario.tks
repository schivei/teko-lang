/**
 * scenario — run ONE §7 DI case: announce it by name, assert its value, close it. Each `scenario(…)`
 * call in `main.tks` has exactly one `Scenario:` row in `service_svc.tkr`, addressed by name.
 *
 * @param name  the case's name, spelled identically in `service_svc.tkr`
 * @param got   what the case's probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the case, the expected and the got value
 */
fn scenario(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}
