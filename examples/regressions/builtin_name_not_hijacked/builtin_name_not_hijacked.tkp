# examples/regressions/builtin_name_not_hijacked — the project-regressor for the symbol-prefix
# ruling (owner, 2026-07-27): user code is emitted as `teko_*`, builtins stay `tk_*`, and the
# choice between them is made by the callee's ORIGIN NAMESPACE, never by its bare name.
#
# What it pins, and what it costs to break:
#   * a user `arena_push`/`one_byte` called UNQUALIFIED from its own namespace runs ITS OWN BODY.
#     Both names are in the emitter's builtin tables, and both backends used to key that table by
#     the call's LAST SEGMENT: the checker accepted the user function with the user's arity, then
#     codegen emitted `tk_arena_push()` / `tk_one_byte()` — the runtime twin. The body never ran,
#     with no warning and no error. The exit code below reads back both bodies' arithmetic, so a
#     relapse cannot be silent.
#   * an `extern fn` still emits its declared C symbol VERBATIM. `getpid` is spelled exactly
#     `getpid` in the object file — if the `teko_` prefix ever reached the extern path, this
#     project would not link at all.
name = "builtin_name_not_hijacked"
source = "src"

[artifact]
kind = "binary"
