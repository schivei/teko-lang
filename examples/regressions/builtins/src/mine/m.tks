/**
 * A user function whose bare name is the runtime's root-region checkpoint builtin
 * (`tk_arena_push`). The runtime twin takes no argument and returns nothing, so a hijacked call
 * cannot produce this body's value.
 *
 * @param control  an observable input the runtime twin has no parameter for
 * @return         `control + 7`
 */
pub fn arena_push(control: u64): u64 { control + 7 }

/**
 * A user function whose bare name is the runtime's single-byte-to-str builtin (`tk_one_byte`).
 * The runtime twin returns a `str`, so a hijacked call cannot produce this body's `u64`.
 *
 * @param b  the byte to weigh
 * @return   the byte's value plus one
 */
pub fn one_byte(b: byte): u64 { (b to u64) + 1 }

/**
 * Calls both colliding functions UNQUALIFIED, from their own namespace — the single-segment
 * callee path that the old last-segment keying treated as addressable, and therefore hijacked.
 *
 * @return  42 when both user bodies ran
 */
pub fn drive(): u64 { arena_push(3) + one_byte(31 to byte) }
