/**
 * The libc `getpid` — an `extern fn` whose declared C symbol MUST be emitted verbatim. A `teko_`
 * prefix or a namespace mangle on this call would leave the object file with an undefined
 * reference and the project would not link.
 *
 * @return  this process's id, always positive
 */
pub extern fn getpid(): i32 = "getpid" from "c"
