# The DEP half of the crossmodule project-regressor (0.3.1 regressor-principal §4 item 2).
#
# A `kind = "package"` library that exports one `pub` and one `exp` scalar module-level
# const (namespace "m1", the manifest name — src/build/discover.tks: a file directly
# under `source` gets the bare root namespace). `teko build` on this dir emits
# `m1-0.0.0.tkl` (project.tks Artifact::Package), the ZIP the consumer's `packages/`
# directory provisions. Built by the `Background: Given dependency` runner crumb (C4) when
# `../crossmodule.tkr` runs under `teko test .` — never stand-alone, and never by the
# generic `examples/regressions/*/` sanitizer/build-all loops (this dir has no top-level
# `.tkp` of its own; the parent `crossmodule/` root's own manifest is `kind = "binary"`).
name = "m1"
source = "src"

[artifact]
kind = "package"
