# examples/regressions/mem_loop_per_iter — the regressor of an accumulator DECLARED in an outer block
# and GROWN in an inner loop (0.3.1 transicao-move-on-return-e-seletor-n-niveis §2, crumb A3). The
# A3 N-level selector routes the grow to the DECLARING scope's region (R_decl, the outer arm), NEVER
# the inner loop's per-iteration arena — so the buffer lives across every iteration and is READ after
# the loop breaks. A naive innermost-region routing (or a break that dropped the enclosing arm region)
# would free the buffer per-iteration / at the loop break and corrupt the post-loop read (UAF).
name = "mem_loop_per_iter"
source = "src"

[artifact]
kind = "binary"
