# examples/regressions/mem_accum_return — the detector that the self-append predicate does NOT
# over-classify (0.3.1 transicao-move-on-return-e-seletor-n-niveis §1b, port 2/4). An accumulator
# built by self-appends and RETURNED escapes its frame, so the block-local proof (A2) must keep it
# EXCLUDED from Scope residence: it is a `Caller`-tier value that is moved/leaked to the caller, never
# freed at the building block's exit. The caller reads the returned slice back exactly — a value
# wrongly proven block-local would have died at the callee's block exit (UAF), corrupting it.
name = "mem_accum_return"
source = "src"

[artifact]
kind = "binary"
