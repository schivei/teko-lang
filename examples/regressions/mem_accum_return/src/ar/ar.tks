/** Wrapped — a struct that RETAINS a slice built by a call (the parse_function AST shape). */
type Wrapped = struct { items: []i64; tag: i64 }

/**
 * build — grow a slice accumulator by self-appends and RETURN it. The return makes the accumulator
 * ESCAPE its frame, so the self-append-aware block-local proof (A2) must keep it EXCLUDED from Scope
 * residence — the buffer survives past this function's exit rather than dying at the building block's
 * edge. A predicate that wrongly proved it block-local would free it here (UAF at the caller's read).
 *
 * @param n  the number of elements to grow
 * @return   the freshly built slice [0, 3, 6, …, 3*(n-1)], escaping to the caller
 */
fn build(n: i64) -> []i64 {
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    xs
}

/**
 * make — build a one-element slice by a call, or error on a negative count (the error-propagation
 * source that retain_wrap threads into a retained local).
 *
 * @param n  the element value
 * @return   the slice [n*3], or error when n < 0
 */
fn make(n: i64) -> []i64 | error {
    if n < 0 { return error { message = "neg" } }
    mut xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, n * 3)
    xs
}

/**
 * retain_wrap — the parse_function move-on-return pattern (mem_move_retain_struct, M2a): build a slice
 * via a CALL, RETAIN it in a local via error-propagation, and wrap that field in a RETURNED struct
 * used after the call. A scratch struct forces this function to open a frame region and enter it, so
 * WITHOUT the conveyance bracket the retained `blk` materializes in the frame `_tkfr` and the returned
 * struct's `items` pointer dangles after the frame drop (UAF/corruption). The bracket routes `blk` to
 * `_tkrr`, so the returned struct reads back exactly.
 *
 * @param n  the element count to build
 * @return   a Wrapped whose `items` is the retained, moved slice, or error on a negative count
 */
fn retain_wrap(n: i64) -> Wrapped | error {
    let scratch = Wrapped { items = teko::list::empty(); tag = 0 }
    let blk = match make(n) { []i64 as x => x; error as e => return e }
    if scratch.tag > 99 { return error { message = "never" } }
    Wrapped { items = blk; tag = n }
}

/**
 * churn — allocate and free scopes AFTER capturing the returned slice, recycling any region memory
 * a wrongly-scoped accumulator would have been freed into. A use-after-free would read these bytes.
 *
 * @param n  the number of churn iterations
 * @return   the count of churn iterations whose scratch fingerprinted exactly
 */
fn churn(n: i64) -> i64 {
    mut hits: i64 = 0
    mut i: i64 = 0
    loop {
        if i >= n { break }
        mut zs: []i64 = teko::list::empty()
        zs = teko::list::push(zs, i)
        if zs[0 to u64] == i { hits = hits + 1 }
        i++
    }
    hits
}

/**
 * run — capture the returned accumulator AND the retain-wrap struct, churn recycling scopes, then
 * fingerprint the captured slices. `25` (1 + 4 accumulator + 10 churn + 10 retain-wrap read) proves
 * the returned accumulator AND the retained-then-wrapped slice were NOT freed at the callee's exit.
 *
 * @param n  the accumulator element count
 * @return   the decimal fingerprint
 */
exp fn run(n: i64) -> i64 {
    let xs = build(n)
    let hits = churn(10)
    mut fp: i64 = 0
    if xs[0 to u64] == 0 { fp = fp + 1 }
    if xs[(n - 1) to u64] == (n - 1) * 3 { fp = fp + 4 }
    match retain_wrap(n) {
        Wrapped as w => { if w.items[0 to u64] == n * 3 { fp = fp + 10 } }
        error => { }
    }
    fp + hits
}
