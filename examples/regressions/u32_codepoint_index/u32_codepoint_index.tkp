# examples/regressions/u32_codepoint_index — the SM-STRU32 (crumb 0025) codec fixture. Proves
# `teko::text::str_to_u32(s)` gives an O(1)-indexable codepoint view: for an ASCII string every
# codepoint equals the byte at the same index. A SELF-CONTAINED project (its own local copy of the
# codec pair under `src/text/text.tks`), same rationale as `examples/regressions/arena_loadstore`.
name = "u32_codepoint_index"
source = "src"

