# examples/regressions/sys_exit_group — the §16 FIRST-PROOF fixture: proves the raw-syscall
# codegen intrinsic (`teko::sys::syscall1`) issues the x86_64 Linux `exit_group` syscall and the
# kernel honours it. A SELF-CONTAINED project (its own local copy of the `SYS_EXIT_GROUP`
# `#os("linux")`/`#arch` const pair under `src/sys/sys.tks`), because the real `teko::sys` lives in
# the COMPILER's own project (root `teko`, reserved — no user project may claim it) and an external
# standalone project has no visibility into it — the `sys_clock` precedent. The local copy is a
# byte-for-byte structural mirror of `src/sys/sys.tks`'s `SYS_EXIT_GROUP` block, so building and
# running it exercises the identical `#os`/`#arch` prune mechanism the real module relies on.
name = "sys_exit_group"
source = "src"

[artifact]
kind = "binary"
