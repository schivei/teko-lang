/**
 * build — an ESCAPING accumulator: `xs` is grown by top-of-block self-appends inside a loop, then
 * RETURNED. The checker marks `xs` escaping (`checker::fn_escaping_vars`, it is returned), so its
 * binding routes through `lower_binding_conveyed` (which never registers a `decl_name` —
 * `register_scope_decl_name` only runs on the NON-escaping path) and its self-append assign routes
 * through `lower_assign_conveyed` (`emit_region_leaves` detours the runtime's current region all the
 * way down to the conveyance anchor `rr`, root through NP5, BEFORE the grow call runs).
 *
 * `enter_self_append_region`'s own bracket must NOT override that detour: `xs` is unregistered
 * (`native_scope_region_of` returns `null`, since escaping bindings never register) and escaping, so
 * it must emit NO bracket, leaving the outer `rr` detour in effect — the grown buffer lands at root.
 * Before the fix, the `null` case fell back UNCONDITIONALLY to `stack[0]` (the FRAME region `fr`),
 * which OVERRODE the `rr` detour: the buffer landed in `fr` instead, and `emit_region_drops` freed
 * `fr` at THIS function's own return — the exact edge the returned buffer needed to survive. A
 * confirmed heap-corruption UAF (double-free), not merely a leak.
 *
 * @param n  how many elements to grow
 * @return   the grown slice, its elements `0, 3, 6, …, (n-1)*3`
 */
fn build(n: i64): []i64 {
    var xs: []i64 = teko::list::empty()
    var i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    xs
}

/**
 * build_nested — the SAME escaping-accumulator shape as `build`, but the self-appends run INSIDE a
 * nested `if` arm (NP5 opens its OWN region for that arm) rather than directly in the function body.
 * Proves the escaping-vs-registered check in `enter_self_append_region` fires regardless of lexical
 * nesting depth: `xs` is still unregistered (its binding is at the FUNCTION body level, escaping,
 * never decl_name-registered) and still escaping, so the self-append inside the nested arm must
 * ALSO skip the `stack[0]` fallback and let the (already-open, from the escaping binding's own
 * conveyance) `rr` detour stand.
 *
 * @param n  how many elements to grow (only entered when `n > 0`)
 * @return   the grown slice, its elements `0, 5, 10, …, (n-1)*5`, or empty when `n <= 0`
 */
fn build_nested(n: i64): []i64 {
    var xs: []i64 = teko::list::empty()
    if n > 0 {
        var i: i64 = 0
        loop {
            if i >= n { break }
            xs = teko::list::push(xs, i * 5)
            i++
        }
    }
    xs
}

/**
 * fingerprint — sum every element of `xs` plus its length, so a corrupted, truncated, or
 * prematurely-freed buffer reads back a WRONG number (not just a crash) — the same "assert the
 * exact fingerprint, not just non-crash" discipline the rest of the `mem_*` family uses.
 *
 * @param xs  the slice to fingerprint
 * @return    the sum of every element plus the length
 */
fn fingerprint(xs: []i64): i64 {
    var sum: i64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        sum = sum + xs[i]
        i++
    }
    sum + (xs.len to i64)
}

var a = fingerprint(build(6))
var b = fingerprint(build_nested(4))
teko::io::println($"fp={a + b}")
