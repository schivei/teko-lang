/**
 * builder — an ESCAPING, checker-proven-linear (frees_old) accumulator: born empty
 * (`teko::list::empty()`), grown purely by self-appends inside a loop, and returned as the sole tail
 * expression — the exact shape `checker::assign_frees_old` requires (a single empty birth, no other
 * writes, every non-final read consumed by a self-append base). Exercises `lower_assign_frees_old`'s
 * free-old copy-grow, itself bracketed by `enter_self_append_region`/`leave_self_append_region` (the
 * escaping+unregistered arm this fixture targets).
 *
 * @param n  how many elements to grow (n > 0)
 * @return   the grown slice, its elements `0, 4, 8, …, (n-1)*4`
 */
fn builder(n: i64) -> []i64 {
    mut out: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, i * 4)
        i++
    }
    out
}

/**
 * churn — allocate and free further scratch AFTER `mid`'s own if-arm has closed, recycling its freed
 * region before the accumulator built inside that arm is read back. Exists so a use-after-free of the
 * accumulator (rather than a merely-untouched dangling pointer) reads OVERWRITTEN bytes, giving a
 * deterministic wrong fingerprint pre-fix instead of a lucky pass.
 *
 * @param n  the number of churn iterations
 * @return   the count of churn iterations whose scratch accumulator fingerprinted exactly
 */
fn churn(n: i64) -> i64 {
    mut hits: i64 = 0
    mut i: i64 = 0
    loop {
        if i >= n { break }
        mut zs: []i64 = teko::list::empty()
        zs = teko::list::push(zs, i * 7)
        if zs[0 to u64] == i * 7 { hits = hits + 1 }
        i++
    }
    hits
}

/**
 * mid — call `builder` from INSIDE an open `if`-arm (NP5's own `NativeRegionFrame` for that arm),
 * while `bx` (the local `builder`'s return is stored into) is NEVER itself read in an escaping
 * position — only via the non-escaping index/length COMPARISONS below — so `bx`'s own binding and
 * its reassignment inside the arm carry NO conveyance bracket (`binding_conveys_escape` is false for
 * it) and `builder(n)` runs with the if-arm's own region genuinely CURRENT: the nested-caller depth
 * the confirmed UAF needs (mirrors `copy_relocs_to_current_region_x86` called from
 * `copy_encoded_func_to_current_region_x86` inside `fold_encoded_funcs_x86`'s own open scope,
 * `src/build/project.tks:3313`). The if-arm CLOSES (dropping its own region) before `bx` is ever
 * read: pre-fix, `builder`'s escaping self-append landed in exactly that region (the
 * `enter_self_append_region` escaping+unregistered arm emitted no bracket at all, so the grow simply
 * followed whatever `bx`'s own assignment left current — the if-arm — which the arm's own close then
 * reclaimed); post-fix it always lands at root, surviving the drop intact.
 *
 * @param n  how many elements `builder` grows (n > 0)
 * @return   the fingerprint: 6 churn hits + 10 (length matches) + 1 (last element matches) = 17
 */
fn mid(n: i64) -> i64 {
    mut bx: []i64 = teko::list::empty()
    if n > 0 {
        bx = builder(n)
    }
    let churn_hits = churn(n)
    mut fp: i64 = churn_hits
    if bx.len == n to u64 { fp = fp + 10 }
    if bx[(n - 1) to u64] == (n - 1) * 4 { fp = fp + 1 }
    fp
}

/**
 * outer — the outermost link of the `outer() → mid() → builder()` chain the confirmed UAF needs (see
 * `mid`'s own doc): a plain forwarding call, so the non-root nesting `builder` is called under is
 * established entirely by `mid`'s own open if-arm, never by how `outer` itself gets invoked.
 *
 * @param n  forwarded to `mid`
 * @return   `mid(n)`'s fingerprint
 */
fn outer(n: i64) -> i64 {
    mid(n)
}

let fp = outer(6)
teko::io::println($"fp={fp}")
