/**
 * churn — open and close allocating scopes AFTER the accumulator arm, each an if-arm-scoped slice
 * accumulator that dies at its own exit edge (the native scope-memory port's NP5: `lower_if_stmt`
 * opens a fresh region per arm) and recycles the memory the earlier arm freed. A use-after-drop of
 * the earlier arm's accumulator would read THIS churn's recycled bytes — the heisenbug NP5 exists
 * to kill by construction (a self-append's free-old-on-grow only parks a block when it grows at
 * root; NP5 makes every non-escaping accumulator grow IN a region instead).
 *
 * @param n  the number of churn iterations
 * @return   the count of churn iterations whose block-local accumulator fingerprinted exactly
 */
fn churn(n: i64): i64 {
    var hits: i64 = 0
    var i: i64 = 0
    loop {
        if i >= n { break }
        var ys: []i64 = teko::list::empty()
        ys = teko::list::push(ys, i)
        ys = teko::list::push(ys, i + 100)
        if ys[0 to u64] == i { hits = hits + 1 }
        if ys[1 to u64] == i + 100 { hits = hits + 1 }
        i++
    }
    hits
}

/**
 * accumulate — build a BLOCK-LOCAL slice accumulator inside an `if` arm via top-of-block self-appends
 * and fingerprint its elements with non-escaping index comparisons. NP5 opens ONE lexical region for
 * the arm on entry (`open_native_region`); `xs`'s self-appends grow there (its own declaring scope,
 * so the N-level selector — `native_scope_region_of` — is a no-op here, since decl scope == current
 * scope); the region drops (`close_native_region`) at the arm's own exit, AFTER this fingerprint
 * reads every element.
 *
 * @param on  whether to enter the accumulating arm
 * @return    7 when the arm-scoped accumulator read back exactly, else 0
 */
fn accumulate(on: bool): i64 {
    var fp: i64 = 0
    if on {
        var xs: []i64 = teko::list::empty()
        xs = teko::list::push(xs, 10)
        xs = teko::list::push(xs, 20)
        xs = teko::list::push(xs, 30)
        if xs[0 to u64] == 10 { fp = fp + 1 }
        if xs[1 to u64] == 20 { fp = fp + 2 }
        if xs[2 to u64] == 30 { fp = fp + 4 }
    }
    fp
}

/**
 * run — fingerprint the arm-scoped accumulator (7) plus the post-arm churn hit count (8 = 4 churn
 * iterations, 2 hits each). `15` (7 + 8) proves the arm accumulator held across every self-append and
 * its own read, then its region was reclaimed and recycled by the churn without corrupting either.
 *
 * @return the decimal fingerprint
 */
fn run(): i64 {
    accumulate(true) + churn(4)
}

var fp = run()
teko::io::println($"fp={fp}")
