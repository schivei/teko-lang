/**
 * churn — allocate and free further scopes after the accumulator read, recycling the outer arm's
 * region memory once it dies (NP5's per-iteration loop-body region: `lower_loop` opens a FRESH
 * region at the top of `#Bhead`, so the same emitted instructions re-open a new arena on every
 * iteration, including these churn iterations). Exists so a use-after-drop of the accumulator
 * would read recycled bytes.
 *
 * @param n  the number of churn iterations
 * @return   the count of churn iterations whose scratch accumulator fingerprinted exactly
 */
fn churn(n: i64) -> i64 {
    mut hits: i64 = 0
    mut i: i64 = 0
    loop {
        if i >= n { break }
        mut zs: []i64 = teko::list::empty()
        zs = teko::list::push(zs, i)
        if zs[0 to u64] == i { hits = hits + 1 }
        i++
    }
    hits
}

/**
 * grow_in_loop — declare a slice accumulator in an OUTER `if` arm and grow it in an INNER loop, then
 * fingerprint it AFTER the loop with non-escaping index comparisons. NP5's N-level selector
 * (`native_scope_region_of`, driven by `register_scope_decl_name` registering `xs` on the arm's own
 * `NativeRegionFrame` at its binding site) routes each grow to the outer arm's region (R_decl), NOT
 * the inner loop's per-iteration region — so the buffer survives every iteration. WITHOUT the
 * selector, the self-append would grow into whatever the inner loop's own per-iteration region
 * happens to be (NP5's own new region, opened fresh each pass): the SAME buffer pointer read back on
 * the NEXT iteration's self-append (`xs = push(xs, …)`, `xs` on BOTH sides) would then be reading
 * memory a PRIOR iteration's `close_native_region` already dropped — the exact heisenbug UAF this
 * crumb kills by construction.
 *
 * @param n  the number of elements to grow
 * @return   the fingerprint (11) when the last element and length read back exactly, else lower
 */
fn grow_in_loop(n: i64) -> i64 {
    mut fp: i64 = 0
    if n > 0 {
        mut xs: []i64 = teko::list::empty()
        mut i: i64 = 0
        loop {
            if i >= n { break }
            xs = teko::list::push(xs, i * 2)
            i++
        }
        if xs[(n - 1) to u64] == (n - 1) * 2 { fp = fp + 1 }
        if xs.len == n to u64 { fp = fp + 10 }
    }
    fp
}

/**
 * run — fingerprint the loop-grown accumulator (11) plus the post-read churn hit count. `17` (11 +
 * 6 churn hits) proves the accumulator held across every iteration and the post-loop read, then its
 * outer region was reclaimed and recycled without corrupting the fingerprint.
 *
 * @return the decimal fingerprint
 */
fn run() -> i64 {
    grow_in_loop(6) + churn(6)
}

let fp = run()
teko::io::println($"fp={fp}")
