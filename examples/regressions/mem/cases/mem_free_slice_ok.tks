/**
 * build — a heap `[]u64` grown by `teko::list::push`, the shape `teko::mem::free`'s slice arm
 * reclaims with `tk_free_block`.
 *
 * @return a fresh five-element `[]u64`
 */
fn build(): []u64 {
    var xs: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 5 { break }
        xs = teko::list::push(xs, i)
        i++
    }
    xs
}

/**
 * run — build a slice, print it, `mem::free` it (park the block + scrub to empty), then build again
 * and print: the second build reuses the parked block without corruption.
 *
 * @return void
 */
pub fn run() {
    var a = build()
    teko::io::println($"a len={a.len} sum={a[0] + a[1] + a[2] + a[3] + a[4]}")
    teko::mem::free(a)
    var b = build()
    teko::io::println($"b len={b.len} sum={b[0] + b[1] + b[2] + b[3] + b[4]}")
    teko::mem::free(b)
}

run()
