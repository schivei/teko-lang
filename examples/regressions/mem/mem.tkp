# examples/regressions/mem — the SCOPE-MEMORY channel (0.3.1 modelo-de-memoria-por-escopo +
# transicao-move-on-return). Five C-route MEMBERS share one build (env C, fixed by the first
# scenario): block-local str residence (`ms`, `mb`), the move-on-return accumulators (`ab`, `ar`, `lp`
# — folded from the move-on-return cargo, `ar` carrying the parse_function repro mem_move_retain_struct)
# and a peak-RSS REAL-RECLAIM oracle (`rec`). The fingerprint members prove VALUES survive the region
# churn; `rec` proves the churn is actually RECLAIMED (a fingerprint reads back correctly on a
# leak-everything backend too). The native-route positives (`teko::mem::free`/`region_new`) and the
# `#must_free` leak REJECTION ride as `Given source` cases, each its own build (env/success/failure
# differ from the shared C-route corpus) — `mem_accum_block_native`/`mem_loop_per_iter_native`
# (native scope-memory port NP5) join this same `Given source` family, exercising lower.tks's own
# `open_native_region`/`native_scope_region_of` rather than codegen.tks's C-route twin.
name = "mem"
source = "src"

[artifact]
kind = "binary"
