/**
 * churn — build a block-local str per iteration and probe it with a str EQUALITY test (a
 * non-escaping use, so each `spin-<i>` is proven block-local and routes through the loop region,
 * dropped at the iteration's exit edge). The churn recycles that freed region memory AFTER the arm
 * scope of `tag_in_arm` has closed, so a use-after-drop of the arm-scoped str would read this
 * churn's recycled bytes.
 *
 * @param n  the number of churn iterations
 * @return   the count of iterations whose block-local str matched its expected value
 */
fn churn(n: i64): i64 {
    var hits: i64 = 0
    var i: i64 = 0
    loop {
        if i >= n { break }
        var spin = "spin-" ~ teko::i64_to_str(i)
        if spin == "spin-0" { hits = hits + 1 }
        if spin == "spin-1" { hits = hits + 1 }
        i++
    }
    hits
}

/**
 * tag_in_arm — build a BLOCK-LOCAL str inside an `if` arm (one of the five lexical scopes treated
 * identically by the model) and probe it with a str EQUALITY test, a non-escaping use the oracle
 * proves block-local. The arm-scoped str is bump-allocated in the arm's region via
 * `tk_str_concat_r` and dies at the arm's exit edge; the following churn recycles that memory. The
 * arm match must land — proving the arm-scoped str was fully consumed before its region died.
 *
 * @param on  whether to enter the value-bearing arm
 * @return    7 when the arm-scoped str read back exactly, plus the churn hit count (2)
 */
fn tag_in_arm(on: bool): i64 {
    var hit: i64 = 0
    if on {
        var tag = "arm-" ~ "value"
        if tag == "arm-value" { hit = 7 }
    }
    hit + churn(2)
}

/**
 * run — enter the arm, fingerprint the arm-scoped str plus the post-arm churn, and render the total.
 * `9` (7 arm + 2 churn) proves the arm-scoped str held its exact value even though its region died
 * at the arm's exit and was recycled by the churn.
 *
 * @return  the decimal fingerprint
 */
exp fn run(): str {
    teko::i64_to_str(tag_in_arm(true))
}
