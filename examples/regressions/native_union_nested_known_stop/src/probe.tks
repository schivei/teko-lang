/**
 * The nesting the native backend cannot build: a null-union FIELD inside a struct that is itself a
 * member of another null-union. Byte-for-byte the body from
 * `examples/regressions/bulk/src/q004_nested_null_union_field_of_a_field`, authored 2026-07-24
 * (`1201088`) and green through the C route ever since.
 */
type Inner_qopt = struct { v: i64 | null }
type Outer_qopt = struct { inner: Inner_qopt | null }

/** read_outer — narrow both levels, falling back at either. @return the inner value or `fallback` */
fn read_outer(o: Outer_qopt, fallback: i64) -> i64 {
    match o.inner {
        Inner_qopt as inn => match inn.v { i64 as v => v; null => fallback }
        null => fallback
    }
}

/** probe — the three placements: both present, inner null, outer null. @return 42 the day it lowers */
pub fn probe() -> u64 {
    let present = Outer_qopt { inner = Inner_qopt { v = 30 } }
    let inner_null = Outer_qopt { inner = Inner_qopt { v = null } }
    let outer_null = Outer_qopt { inner = null }
    (read_outer(present, 0) + read_outer(inner_null, 5) + read_outer(outer_null, 7)) to u64
}
