#arch("x86_64")
/**
 * TAG — the x86_64 arm of a §16 TARGET-CONDITIONAL const: a `(namespace, name)` family with two
 * pairwise-disjoint `#arch` arms. Under the C-monolith backend BOTH arms survive the prune and
 * codegen emits ONE C `#if` ladder of `#define`s (never a folded single-arch literal), so the one
 * `teko.c` cross-compiles across every arch — the root-cause fix for the arm64 first-alloc SIGSEGV
 * (`docs/design/plano-s16-arch-cross-emit.md`). x86_64 identifying value: 64.
 *
 * @return  64, the x86_64 arm's value
 */
pub const TAG: i64 = 64

#arch("arm64")
/**
 * TAG — the arm64 arm of the §16 target-conditional const family (the `#elif` arm of the emitted
 * ladder). DIFFERENT value from the x86_64 arm (65 vs 64), so a cross-compiled arm64 binary selecting
 * this arm proves the ladder — not a hard-baked x86_64 number — reaches the arm.
 *
 * @return  65, the arm64 arm's value
 */
pub const TAG: i64 = 65
