pub const ARENA_ALIGN: u64 = 16

pub const DEFAULT_CHUNK: u64 = 65536

pub const WORD: u64 = 8

pub const CHUNK_NEXT: u64 = 0

pub const CHUNK_CAP: u64 = 8

pub const CHUNK_USED: u64 = 16

pub const CHUNK_HEADER: u64 = 32

pub const REGION_HEAD: u64 = 0

pub const REGION_REG_NEXT: u64 = 8

pub const REGION_PARENT: u64 = 16

pub const REGION_ENTRIES: u64 = 24

pub const REGION_NENTRIES: u64 = 32

pub const REGION_ENTRIES_CAP: u64 = 40

pub const REGION_GEN: u64 = 48

pub const REGION_BYTES: u64 = 64

pub const ENTRY_TYPE_ID: u64 = 0

pub const ENTRY_INSTANCE: u64 = 8

pub const ENTRY_BYTES: u64 = 16

pub const ENTRIES_FIRST_CAP: u64 = 4

pub const CTRL_MAGIC: u64 = 0

pub const CTRL_REGS: u64 = 8

pub const CTRL_ROOT: u64 = 16

pub const CTRL_GEN: u64 = 24

pub const CTRL_MSP: u64 = 32

pub const CTRL_FREE_LARGE: u64 = 40

pub const CTRL_META_SLAB: u64 = 48

pub const CTRL_META_CURSOR: u64 = 56

pub const CTRL_META_END: u64 = 64

pub const CTRL_HDR_FREE: u64 = 72

pub const CTRL_PROGRAM: u64 = 80

pub const CTRL_PARANOID: u64 = 88

pub const CTRL_MARKS: u64 = 128

pub const MARK_CHUNK: u64 = 0

pub const MARK_USED: u64 = 8

pub const MARK_BYTES: u64 = 16

pub const MARK_SLOTS: u64 = 64

pub const CTRL_FREE_BINS: u64 = 1152

pub const FREE_BINS: u64 = 4096

pub const CTRL_CUR_SP: u64 = 33920

pub const CTRL_CUR_STACK: u64 = 33928

pub const CUR_STACK_SLOTS: u64 = 64

pub const CTRL_BYTES: u64 = 34448

pub const CTRL_MAGIC_VALUE: u64 = 2596069104

pub const FREENODE_NEXT: u64 = 0

pub const FREENODE_BYTES: u64 = 8

pub const FREENODE_BYTES_MIN: u64 = 16

pub const FREE_BIN_MAX_BYTES: u64 = 65536

pub const FREE_LARGE_SCAN: u64 = 32

pub const AR_META_SLAB: u64 = 65536

pub const AR_SLAB_LINK: u64 = 0

pub const AR_SLAB_SIZE: u64 = 8

pub const AR_SLAB_HEADER: u64 = 16

pub const AR_OOM_CODE: i64 = 137

pub const PARANOID_OFF: u64 = 0

pub const PARANOID_ON: u64 = 1

pub const POISON_BYTE: u64 = 221

pub const POISON_WORD: u64 = 15987178197214944733

pub const WRITABLE_PATTERN: u64 = 12297829382473034410

pub fn round_up_align(n: u64): u64 {
    var slack = n % ARENA_ALIGN
    if slack == 0 { return n }
    n + ARENA_ALIGN - slack
}

pub fn round_down_align(n: u64): u64 {
    n - n % ARENA_ALIGN
}

pub fn load_word(address: u64): u64 {
    teko::mem::load_u64(address)
}

pub fn store_word(address: u64, value: u64) {
    teko::mem::store_u64(address, value)
}

pub fn raw_mmap(length: u64): u64 {
    var result = teko::sys::syscall6(sys::SYS_MMAP, 0, length to i64,
        sys::PROT_READ | sys::PROT_WRITE, sys::MAP_PRIVATE | sys::MAP_ANONYMOUS, -1, 0)
    if result >= -4095 && result <= -1 { return 0 }
    result to u64
}

pub fn raw_munmap(address: u64, length: u64) {
    _ = teko::sys::syscall2(sys::SYS_MUNMAP, address to i64, length to i64)
}

pub fn raw_oom() {
    _ = teko::sys::syscall1(sys::SYS_EXIT_GROUP, AR_OOM_CODE)
}

pub fn ctrl_get(control: u64, field: u64): u64 {
    load_word(control + field)
}

pub fn ctrl_set(control: u64, field: u64, value: u64) {
    store_word(control + field, value)
}

pub fn meta_slab_new(slab_bytes: u64): u64 {
    var slab = raw_mmap(slab_bytes)
    if slab == 0 { raw_oom() }
    store_word(slab + AR_SLAB_LINK, 0)
    store_word(slab + AR_SLAB_SIZE, slab_bytes)
    slab
}

pub fn meta_alloc(control: u64, bytes: u64): u64 {
    var size = round_up_align(bytes)
    var cursor = ctrl_get(control, CTRL_META_CURSOR)
    var end = ctrl_get(control, CTRL_META_END)
    if cursor + size > end {
        var need = AR_SLAB_HEADER + size
        var slab_bytes = if need > AR_META_SLAB { round_up_align(need) } else { AR_META_SLAB }
        var slab = meta_slab_new(slab_bytes)
        store_word(slab + AR_SLAB_LINK, ctrl_get(control, CTRL_META_SLAB))
        ctrl_set(control, CTRL_META_SLAB, slab)
        cursor = slab + AR_SLAB_HEADER
        ctrl_set(control, CTRL_META_END, slab + slab_bytes)
    }
    ctrl_set(control, CTRL_META_CURSOR, cursor + size)
    cursor
}

pub fn header_alloc(control: u64): u64 {
    var recycled = ctrl_get(control, CTRL_HDR_FREE)
    if recycled != 0 {
        ctrl_set(control, CTRL_HDR_FREE, load_word(recycled))
        return recycled
    }
    meta_alloc(control, REGION_BYTES)
}

pub fn header_free(control: u64, region: u64) {
    store_word(region, ctrl_get(control, CTRL_HDR_FREE))
    ctrl_set(control, CTRL_HDR_FREE, region)
}

pub fn control_new(): u64 {
    var slab = meta_slab_new(AR_META_SLAB)
    var control = slab + AR_SLAB_HEADER
    ctrl_set(control, CTRL_MAGIC, CTRL_MAGIC_VALUE)
    ctrl_set(control, CTRL_META_SLAB, slab)
    ctrl_set(control, CTRL_META_CURSOR, round_up_align(control + CTRL_BYTES))
    ctrl_set(control, CTRL_META_END, slab + AR_META_SLAB)
    control
}

pub fn control_is_live(control: u64): bool {
    ctrl_get(control, CTRL_MAGIC) == CTRL_MAGIC_VALUE
}

pub fn paranoid_set(control: u64, on: bool) {
    ctrl_set(control, CTRL_PARANOID, if on { PARANOID_ON } else { PARANOID_OFF })
}

pub fn paranoid_enabled(control: u64): bool {
    ctrl_get(control, CTRL_PARANOID) == PARANOID_ON
}

pub fn control_free(control: u64) {
    regions_free_all(control)
    var slab = ctrl_get(control, CTRL_META_SLAB)
    loop {
        if slab == 0 { break }
        var next = load_word(slab + AR_SLAB_LINK)
        var size = load_word(slab + AR_SLAB_SIZE)
        raw_munmap(slab, size)
        slab = next
    }
}

pub fn chunk_get(chunk: u64, field: u64): u64 {
    load_word(chunk + field)
}

pub fn chunk_set(chunk: u64, field: u64, value: u64) {
    store_word(chunk + field, value)
}

pub fn chunk_payload(chunk: u64): u64 {
    chunk + CHUNK_HEADER
}

pub fn chunk_try(payload: u64): u64 {
    var chunk = raw_mmap(CHUNK_HEADER + payload)
    if chunk == 0 { return 0 }
    chunk_set(chunk, CHUNK_NEXT, 0)
    chunk_set(chunk, CHUNK_CAP, payload)
    chunk_set(chunk, CHUNK_USED, 0)
    chunk
}

pub fn chunk_free(chunk: u64) {
    raw_munmap(chunk, CHUNK_HEADER + chunk_get(chunk, CHUNK_CAP))
}

pub fn chunk_free_list(head: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        var next = chunk_get(chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

pub fn chunk_free_until(head: u64, stop: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        if chunk == stop { break }
        var next = chunk_get(chunk, CHUNK_NEXT)
        chunk_free(chunk)
        chunk = next
    }
}

pub fn chunk_fit_offset(chunk: u64, size: u64): u64 {
    var cap = chunk_get(chunk, CHUNK_CAP)
    var base_off = round_up_align(chunk_get(chunk, CHUNK_USED))
    if base_off > cap { return cap + 1 }
    if size > cap - base_off { return cap + 1 }
    base_off
}

pub fn chunk_offset_fits(chunk: u64, offset: u64): bool {
    offset <= chunk_get(chunk, CHUNK_CAP)
}

pub fn region_get(region: u64, field: u64): u64 {
    load_word(region + field)
}

pub fn region_set(region: u64, field: u64, value: u64) {
    store_word(region + field, value)
}

pub fn region_new(control: u64, parent: u64): u64 {
    var region = header_alloc(control)
    region_set(region, REGION_HEAD, 0)
    region_set(region, REGION_REG_NEXT, ctrl_get(control, CTRL_REGS))
    ctrl_set(control, CTRL_REGS, region)
    region_set(region, REGION_PARENT, parent)
    region_set(region, REGION_ENTRIES, 0)
    region_set(region, REGION_NENTRIES, 0)
    region_set(region, REGION_ENTRIES_CAP, 0)
    var generation = ctrl_get(control, CTRL_GEN) + 1
    ctrl_set(control, CTRL_GEN, generation)
    region_set(region, REGION_GEN, generation)
    region
}

pub fn region_root(control: u64): u64 {
    var existing = ctrl_get(control, CTRL_ROOT)
    if existing != 0 { return existing }
    var root = region_new(control, 0)
    ctrl_set(control, CTRL_ROOT, root)
    root
}

pub fn cur_slot(control: u64, depth: u64): u64 {
    control + CTRL_CUR_STACK + depth * WORD
}

pub fn cur_current(control: u64): u64 {
    var sp = ctrl_get(control, CTRL_CUR_SP)
    if sp > 0 && sp <= CUR_STACK_SLOTS {
        var region = load_word(cur_slot(control, sp - 1))
        if region != 0 { return region }
    }
    region_root(control)
}

pub fn cur_enter(control: u64, child: u64) {
    var sp = ctrl_get(control, CTRL_CUR_SP)
    if sp < CUR_STACK_SLOTS { store_word(cur_slot(control, sp), child) }
    ctrl_set(control, CTRL_CUR_SP, sp + 1)
}

pub fn cur_leave(control: u64) {
    var sp = ctrl_get(control, CTRL_CUR_SP)
    if sp == 0 { return }
    ctrl_set(control, CTRL_CUR_SP, sp - 1)
}

pub fn cur_alloc(control: u64, n: u64): u64 {
    region_alloc(control, cur_current(control), n)
}

pub fn region_bump(region: u64, offset: u64, size: u64): u64 {
    var chunk = region_get(region, REGION_HEAD)
    chunk_set(chunk, CHUNK_USED, offset + size)
    chunk_payload(chunk) + offset
}

pub fn region_grow(control: u64, region: u64, size: u64): u64 {
    var want = if size > DEFAULT_CHUNK { size } else { DEFAULT_CHUNK }
    var chunk = chunk_try(want)
    if chunk == 0 {
        if want != size { chunk = chunk_try(size) }
    }
    if chunk == 0 { raw_oom() }
    chunk_set(chunk, CHUNK_USED, size)
    chunk_set(chunk, CHUNK_NEXT, region_get(region, REGION_HEAD))
    region_set(region, REGION_HEAD, chunk)
    chunk_payload(chunk)
}

pub fn region_alloc(control: u64, region: u64, n: u64): u64 {
    var size = round_up_align(if n == 0 { 1 } else { n })
    if region == ctrl_get(control, CTRL_ROOT) {
        var reused = free_take(control, size)
        if reused != 0 { return reused }
    }
    var head = region_get(region, REGION_HEAD)
    if head != 0 {
        var offset = chunk_fit_offset(head, size)
        if chunk_offset_fits(head, offset) { return region_bump(region, offset, size) }
    }
    region_grow(control, region, size)
}

pub fn registry_unlink(control: u64, region: u64) {
    var head = ctrl_get(control, CTRL_REGS)
    if head == region {
        ctrl_set(control, CTRL_REGS, region_get(region, REGION_REG_NEXT))
        return
    }
    var prev = head
    loop {
        if prev == 0 { break }
        var next = region_get(prev, REGION_REG_NEXT)
        if next == region {
            region_set(prev, REGION_REG_NEXT, region_get(region, REGION_REG_NEXT))
            break
        }
        prev = next
    }
}

pub fn region_release(control: u64, region: u64) {
    var head = region_get(region, REGION_HEAD)
    region_set(region, REGION_HEAD, 0)
    chunk_free_list(head)
    region_set(region, REGION_ENTRIES, 0)
    region_set(region, REGION_NENTRIES, 0)
    region_set(region, REGION_ENTRIES_CAP, 0)
    header_free(control, region)
}

pub fn region_drop(control: u64, region: u64) {
    if region == 0 { return }
    registry_unlink(control, region)
    region_set(region, REGION_REG_NEXT, 0)
    region_release(control, region)
}

pub fn regions_free_all(control: u64) {
    free_purge(control)
    var region = ctrl_get(control, CTRL_REGS)
    ctrl_set(control, CTRL_REGS, 0)
    ctrl_set(control, CTRL_ROOT, 0)
    ctrl_set(control, CTRL_PROGRAM, 0)
    loop {
        if region == 0 { break }
        var next = region_get(region, REGION_REG_NEXT)
        region_release(control, region)
        region = next
    }
}

pub fn region_reaches(region: u64, root: u64): bool {
    var current = region
    loop {
        if current == 0 { break }
        if current == root { return true }
        current = region_get(current, REGION_PARENT)
    }
    false
}

pub fn subtree_collect(control: u64, root: u64): u64 {
    var doomed: u64 = 0
    var current = ctrl_get(control, CTRL_REGS)
    loop {
        if current == 0 { break }
        var next = region_get(current, REGION_REG_NEXT)
        if region_reaches(current, root) {
            registry_unlink(control, current)
            region_set(current, REGION_REG_NEXT, doomed)
            doomed = current
        }
        current = next
    }
    doomed
}

pub fn region_drop_subtree(control: u64, root: u64) {
    if root == 0 { return }
    var doomed = subtree_collect(control, root)
    loop {
        if doomed == 0 { break }
        var next = region_get(doomed, REGION_REG_NEXT)
        region_release(control, doomed)
        doomed = next
    }
}

pub fn entry_slot(region: u64, index: u64): u64 {
    region_get(region, REGION_ENTRIES) + index * ENTRY_BYTES
}

pub fn entry_index_of(region: u64, type_id: u64): u64 {
    var count = region_get(region, REGION_NENTRIES)
    var i: u64 = 0
    loop {
        if i >= count { break }
        if load_word(entry_slot(region, i) + ENTRY_TYPE_ID) == type_id { return i }
        i++
    }
    count
}

pub fn words_copy(dst: u64, src: u64, word_count: u64) {
    var i: u64 = 0
    loop {
        if i >= word_count { break }
        store_word(dst + i * WORD, load_word(src + i * WORD))
        i++
    }
}

pub fn entries_grow(control: u64, region: u64) {
    var old_cap = region_get(region, REGION_ENTRIES_CAP)
    var new_cap = if old_cap == 0 { ENTRIES_FIRST_CAP } else { old_cap * 2 }
    var old_table = region_get(region, REGION_ENTRIES)
    var new_table = meta_alloc(control, new_cap * ENTRY_BYTES)
    var used_words = region_get(region, REGION_NENTRIES) * ENTRY_BYTES / WORD
    if used_words > 0 { words_copy(new_table, old_table, used_words) }
    region_set(region, REGION_ENTRIES, new_table)
    region_set(region, REGION_ENTRIES_CAP, new_cap)
}

pub fn region_register(control: u64, region: u64, type_id: u64, instance: u64) {
    if region == 0 { return }
    var count = region_get(region, REGION_NENTRIES)
    var found = entry_index_of(region, type_id)
    if found < count {
        store_word(entry_slot(region, found) + ENTRY_INSTANCE, instance)
        return
    }
    if count == region_get(region, REGION_ENTRIES_CAP) { entries_grow(control, region) }
    var slot = entry_slot(region, count)
    store_word(slot + ENTRY_TYPE_ID, type_id)
    store_word(slot + ENTRY_INSTANCE, instance)
    region_set(region, REGION_NENTRIES, count + 1)
}

pub fn region_lookup(region: u64, type_id: u64): u64 {
    var current = region
    loop {
        if current == 0 { break }
        var count = region_get(current, REGION_NENTRIES)
        var found = entry_index_of(current, type_id)
        if found < count { return load_word(entry_slot(current, found) + ENTRY_INSTANCE) }
        current = region_get(current, REGION_PARENT)
    }
    0
}

pub fn mark_slot(control: u64, depth: u64): u64 {
    control + CTRL_MARKS + depth * MARK_BYTES
}

pub fn write_mark(control: u64, depth: u64) {
    var head = region_get(region_root(control), REGION_HEAD)
    var slot = mark_slot(control, depth)
    store_word(slot + MARK_CHUNK, head)
    if head == 0 {
        store_word(slot + MARK_USED, 0)
        return
    }
    store_word(slot + MARK_USED, chunk_get(head, CHUNK_USED))
}

pub fn checkpoint_push(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    ctrl_set(control, CTRL_MSP, depth + 1)
    if depth >= MARK_SLOTS { return }
    write_mark(control, depth)
}

pub fn checkpoint_pop(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
    if depth - 1 >= MARK_SLOTS { return }
    free_purge(control)
    var slot = mark_slot(control, depth - 1)
    var marked_chunk = load_word(slot + MARK_CHUNK)
    var marked_used = load_word(slot + MARK_USED)
    var root = region_root(control)
    chunk_free_until(region_get(root, REGION_HEAD), marked_chunk)
    region_set(root, REGION_HEAD, marked_chunk)
    if marked_chunk != 0 { chunk_set(marked_chunk, CHUNK_USED, marked_used) }
}

pub fn checkpoint_commit(control: u64) {
    var depth = ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ctrl_set(control, CTRL_MSP, depth - 1)
}

pub fn free_bin_slot(control: u64, bytes: u64): u64 {
    control + CTRL_FREE_BINS + (bytes / ARENA_ALIGN - 1) * WORD
}

pub fn free_is_binnable(bytes: u64): bool {
    if bytes == 0 { return false }
    bytes <= FREE_BIN_MAX_BYTES
}

pub fn freenode_get(node: u64, field: u64): u64 {
    load_word(node + field)
}

pub fn free_purge(control: u64) {
    var i: u64 = 0
    loop {
        if i >= FREE_BINS { break }
        store_word(control + CTRL_FREE_BINS + i * WORD, 0)
        i++
    }
    ctrl_set(control, CTRL_FREE_LARGE, 0)
}

pub fn free_take_binned(control: u64, size: u64): u64 {
    var slot = free_bin_slot(control, size)
    var node = load_word(slot)
    if node == 0 { return 0 }
    store_word(slot, freenode_get(node, FREENODE_NEXT))
    node
}

pub fn free_block_fits(bytes: u64, size: u64): bool {
    if bytes < size { return false }
    bytes <= size * 2
}

pub fn free_take_large(control: u64, size: u64): u64 {
    var prev: u64 = 0
    var node = ctrl_get(control, CTRL_FREE_LARGE)
    var scanned: u64 = 0
    loop {
        if node == 0 { break }
        if scanned >= FREE_LARGE_SCAN { break }
        var next = freenode_get(node, FREENODE_NEXT)
        var bytes = freenode_get(node, FREENODE_BYTES)
        if free_block_fits(bytes, size) {
            if prev == 0 { ctrl_set(control, CTRL_FREE_LARGE, next) } else { store_word(prev + FREENODE_NEXT, next) }
            return node
        }
        prev = node
        node = next
        scanned++
    }
    0
}

pub fn free_take(control: u64, size: u64): u64 {
    var wanted = round_up_align(size)
    if free_is_binnable(wanted) { return free_take_binned(control, wanted) }
    free_take_large(control, wanted)
}

pub fn free_park(control: u64, block: u64, usable: u64) {
    store_word(block + FREENODE_BYTES, usable)
    if free_is_binnable(usable) {
        var slot = free_bin_slot(control, usable)
        store_word(block + FREENODE_NEXT, load_word(slot))
        store_word(slot, block)
        return
    }
    store_word(block + FREENODE_NEXT, ctrl_get(control, CTRL_FREE_LARGE))
    ctrl_set(control, CTRL_FREE_LARGE, block)
}

pub fn poison_block(block: u64, usable: u64) {
    var i: u64 = 0
    loop {
        if i >= usable { break }
        store_word(block + i, POISON_WORD)
        i = i + WORD
    }
}

pub fn free_block(control: u64, block: u64, bytes: u64) {
    if block == 0 { return }
    var usable = round_down_align(bytes)
    if paranoid_enabled(control) {
        if usable > 0 { poison_block(block, usable) }
        return
    }
    if usable < FREENODE_BYTES_MIN { return }
    free_park(control, block, usable)
}
