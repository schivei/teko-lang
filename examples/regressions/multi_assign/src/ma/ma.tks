/**
 * div — integer quotient and remainder returned as a §9 F multiple return `(i32, i32)`. The `( )`
 * appear only in the signature and are lowered to a synthesized by-value aggregate struct; there is no
 * first-class tuple value.
 *
 * @param a  the dividend
 * @param b  the divisor
 * @return   the quotient and the remainder
 */
pub fn div(a: i32, b: i32): (i32, i32) {
    return (a / b, a % b)
}

/**
 * parallel — a parallel multiple assignment `var a, b = 3, 7`, types inferred per position.
 *
 * @return  `a * 10 + b` = 37
 */
pub fn parallel(): i64 {
    var a, b = 3, 7
    a * 10 + b
}

/**
 * parallel_reads_before_bind — the parallel form evaluates every right-hand value BEFORE binding any
 * target (fresh temps), so `var y2, x2 = x, y` reads the source pair first and binds positionally.
 *
 * @return  `x2 * 10 + y2` = 21 (`y2` = `x` = 1, `x2` = `y` = 2)
 */
pub fn parallel_reads_before_bind(): i64 {
    var x, y = 1, 2
    var y2, x2 = x, y
    x2 * 10 + y2
}

/**
 * shared_annotation — one shared `: u8` annotation applies to every parallel target.
 *
 * @return  `(a to i64) + (b to i64)` = 255, both bound as `u8`
 */
pub fn shared_annotation(): i64 {
    var a, b: u8 = 200, 55
    (a to i64) + (b to i64)
}

/**
 * decomp_skip — an exact-length array decomposition with a `_` discard `var [a, _, c] = xs`.
 *
 * @return  `a + c` = 40
 */
pub fn decomp_skip(): i64 {
    var xs: []i64 = [10, 20, 30]
    var [a, _, c] = xs
    a + c
}

/**
 * decomp_rest — an array decomposition with a `..` skip-range `var [h, .., p, q] = xs`, binding the
 * head and the two-element tail across a skipped middle.
 *
 * @return  `h * 100 + p * 10 + q` = 145
 */
pub fn decomp_rest(): i64 {
    var xs: []i64 = [1, 2, 3, 4, 5]
    var [h, .., p, q] = xs
    h * 100 + p * 10 + q
}

/**
 * decomp_rest_zero_middle — a `..` skip-range that skips ZERO middle elements still satisfies the
 * minimum head+tail length `var [h, .., t] = xs` over a two-element source.
 *
 * @return  `h * 10 + t` = 12
 */
pub fn decomp_rest_zero_middle(): i64 {
    var xs: []i64 = [1, 2]
    var [h, .., t] = xs
    h * 10 + t
}

