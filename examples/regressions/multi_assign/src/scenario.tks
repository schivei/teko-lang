/**
 * scenario — run ONE case of the §9 F multiple-assignment / array-decomposition / multiple-return
 * corpus: name it, assert its value, announce it.
 *
 * `teko::assert::eq_i64` reports the expected AND the got value, so a failure needs no lookup table;
 * `teko::assert::scenario_ok` announces `scenario <name>: ok`, the line the companion
 * `multi_assign.tkr` demands BY NAME, row by row. Every `scenario(...)` call in `main.tks` has exactly
 * one matching row, and vice versa — a name living on only one side would be a silent gap.
 *
 * @param name  the case's name, spelled identically in `multi_assign.tkr`'s `Scenario:` line
 * @param got   what the case's probe returned
 * @param want  what it must return
 * @throws      when they differ — the panic names the case, the expected value and the got value
 */
fn scenario(name: str, got: i64, want: i64) {
    teko::assert::scenario_begin(name)
    teko::assert::eq_i64(got, want)
    teko::assert::scenario_ok()
}
