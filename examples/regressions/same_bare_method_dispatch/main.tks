// THE DISPATCHER (owner ruling 2026-07-25 — "um tkp pode ter vários tkr … somente um build é
// necessário"; and "está proibido inline code em tkr"): this project hosts its OWN regression and
// the scenarios unfolded out of regressor.tkr's `Given source inline` blocks — one MEMBER NAMESPACE
// each under `src/`. `TEKO_REGR_ENTRY` selects which member's `entry()` runs, and every member runs
// off THIS project's SINGLE build (`RegrBuilt` compiles a project's `.tkp` at most once per `.tkr`).
// It is the same selector the synthesized group builds use (`REGR_GROUP_ENTRY_VAR`,
// src/build/regr_group.tks), so an on-disk member and a folded snippet are selected identically.
//
// `regr_hit` is why the `exit(0)` below is not dead code, and it is not cosmetic: a member's body is
// a virtual main, and a virtual main that simply RUNS OFF THE END exits 0. Without the flag such a
// member would fall through into this project's own body and report ITS exit code instead — which
// is exactly the bug this dispatcher was first written with, caught by the gate. With no selector
// set, `regr_hit` stays false and the project's own scenario runs, unchanged.
use left
use right
use q005_base_widened_from_a_derived_class_null
use q010_large_box_in_arena_null_union_field_fo
use q015_comptime_fold_interp_hex
use q020_width_rule_mixed_sign_peer_ok
use q025_assert_native
use q030_chars
use q035_class_destruction
use q041_class_slices
use q045_collections_list
use q050_comptime_fold_scalar
use q055_const_scalar_inline
use q060_crypto_hash_kat
use q065_di_lazy
use q071_discard_param_impl
use q076_field_assignment
use q080_format_spec_families
use q085_global_print
use q090_iface_value_param_dispatch
use q095_interface_dispatch
use q099_iter_protocol
use q105_list_with_cap_matches_push
use q110_lit_redundant_cast
use q116_mem_free
use q120_member_const_trait_fold
use q125_native_lir_exit
use q130_noncapturing_lambda_lift
use q135_own_match_pattern_binding_no_collision
use q140_ref_param_write_through
use q145_repr_niche
use q150_stored_borrow_sound
use q160_trait_derive_eq
use q164_trait_dispatch
use q170_unsafe_rawbuf_roundtrip
use q175_wasm_continue_step
use q180_wasm_panic_hook
use q185_d1_boundary_widen_cast_compiles

let regr_entry = match teko::env::var("TEKO_REGR_ENTRY") { str as v => v; error => "" }
mut regr_hit = false
if regr_entry == "q005_base_widened_from_a_derived_class_null" { regr_hit = true; q005_base_widened_from_a_derived_class_null::entry() }
if regr_entry == "q010_large_box_in_arena_null_union_field_fo" { regr_hit = true; q010_large_box_in_arena_null_union_field_fo::entry() }
if regr_entry == "q015_comptime_fold_interp_hex" { regr_hit = true; q015_comptime_fold_interp_hex::entry() }
if regr_entry == "q020_width_rule_mixed_sign_peer_ok" { regr_hit = true; q020_width_rule_mixed_sign_peer_ok::entry() }
if regr_entry == "q025_assert_native" { regr_hit = true; q025_assert_native::entry() }
if regr_entry == "q030_chars" { regr_hit = true; q030_chars::entry() }
if regr_entry == "q035_class_destruction" { regr_hit = true; q035_class_destruction::entry() }
if regr_entry == "q041_class_slices" { regr_hit = true; q041_class_slices::entry() }
if regr_entry == "q045_collections_list" { regr_hit = true; q045_collections_list::entry() }
if regr_entry == "q050_comptime_fold_scalar" { regr_hit = true; q050_comptime_fold_scalar::entry() }
if regr_entry == "q055_const_scalar_inline" { regr_hit = true; q055_const_scalar_inline::entry() }
if regr_entry == "q060_crypto_hash_kat" { regr_hit = true; q060_crypto_hash_kat::entry() }
if regr_entry == "q065_di_lazy" { regr_hit = true; q065_di_lazy::entry() }
if regr_entry == "q071_discard_param_impl" { regr_hit = true; q071_discard_param_impl::entry() }
if regr_entry == "q076_field_assignment" { regr_hit = true; q076_field_assignment::entry() }
if regr_entry == "q080_format_spec_families" { regr_hit = true; q080_format_spec_families::entry() }
if regr_entry == "q085_global_print" { regr_hit = true; q085_global_print::entry() }
if regr_entry == "q090_iface_value_param_dispatch" { regr_hit = true; q090_iface_value_param_dispatch::entry() }
if regr_entry == "q095_interface_dispatch" { regr_hit = true; q095_interface_dispatch::entry() }
if regr_entry == "q099_iter_protocol" { regr_hit = true; q099_iter_protocol::entry() }
if regr_entry == "q105_list_with_cap_matches_push" { regr_hit = true; q105_list_with_cap_matches_push::entry() }
if regr_entry == "q110_lit_redundant_cast" { regr_hit = true; q110_lit_redundant_cast::entry() }
if regr_entry == "q116_mem_free" { regr_hit = true; q116_mem_free::entry() }
if regr_entry == "q120_member_const_trait_fold" { regr_hit = true; q120_member_const_trait_fold::entry() }
if regr_entry == "q125_native_lir_exit" { regr_hit = true; q125_native_lir_exit::entry() }
if regr_entry == "q130_noncapturing_lambda_lift" { regr_hit = true; q130_noncapturing_lambda_lift::entry() }
if regr_entry == "q135_own_match_pattern_binding_no_collision" { regr_hit = true; q135_own_match_pattern_binding_no_collision::entry() }
if regr_entry == "q140_ref_param_write_through" { regr_hit = true; q140_ref_param_write_through::entry() }
if regr_entry == "q145_repr_niche" { regr_hit = true; q145_repr_niche::entry() }
if regr_entry == "q150_stored_borrow_sound" { regr_hit = true; q150_stored_borrow_sound::entry() }
if regr_entry == "q160_trait_derive_eq" { regr_hit = true; q160_trait_derive_eq::entry() }
if regr_entry == "q164_trait_dispatch" { regr_hit = true; q164_trait_dispatch::entry() }
if regr_entry == "q170_unsafe_rawbuf_roundtrip" { regr_hit = true; q170_unsafe_rawbuf_roundtrip::entry() }
if regr_entry == "q175_wasm_continue_step" { regr_hit = true; q175_wasm_continue_step::entry() }
if regr_entry == "q180_wasm_panic_hook" { regr_hit = true; q180_wasm_panic_hook::entry() }
if regr_entry == "q185_d1_boundary_widen_cast_compiles" { regr_hit = true; q185_d1_boundary_widen_cast_compiles::entry() }
if regr_hit { exit(0) }


let l = left::Svc::make(3).tag_of()
if l != 3 { exit(1) }

let r = right::Svc::make(7).tag_of()
if r != 7 { exit(2) }

exit(l + r)
