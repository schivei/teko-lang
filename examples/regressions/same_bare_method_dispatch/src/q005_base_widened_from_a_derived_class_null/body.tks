type Animal = virtual class {
    pub name: str
    pub virtual fn speak(self) -> str { "..." }
}
type Dog = class Animal {
    pub fn make(n: str) -> Dog { Dog { name = n } }
    pub override fn speak(self) -> str { "Woof" }
}
fn speak_or(a: Animal | null, fallback: str) -> str {
    match a { Animal as v => v.speak(); null => fallback }
}

/**
 * entry — F3 null-union — nesting, base/widen, writeback, forward, recursion
 *          :: base widened from a derived class, null-union
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q005_base_widened_from_a_derived_class_null`.
 */
pub fn entry() {
    let present: Animal | null = Dog::make("Rex")
    let absent: Animal | null = null
    let r1 = speak_or(present, "?")
    let r2 = speak_or(absent, "?")
    exit(if r1 == "Woof" && r2 == "?" { 42 } else { 1 })
}
