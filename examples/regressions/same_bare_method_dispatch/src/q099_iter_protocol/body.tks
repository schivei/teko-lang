pub type IntIter = () -> i64 | null
pub type RangeCursor = struct { next: i64; hi: i64 }
pub fn range(ref cur: RangeCursor) -> IntIter {
    let it: IntIter = () => {
        if cur.next >= cur.hi { return null }
        let v = cur.next
        cur = RangeCursor { next = v + 1; hi = cur.hi }
        v
    }
    it
}
pub fn map(src: IntIter, f: (i64) -> i64) -> IntIter {
    let mapped: IntIter = () => {
        let nx = src()
        match nx {
            i64 as v => f(v)
            null => null
        }
    }
    mapped
}
pub fn filter(src: IntIter, keep: (i64) -> bool) -> IntIter {
    let filtered: IntIter = () => {
        mut result: i64 | null = null
        loop {
            let nx = src()
            match nx {
                i64 as v => {
                    if keep(v) { result = v; break }
                }
                null => break
            }
        }
        result
    }
    filtered
}
pub type TakeCursor = struct { left: i64 }
pub fn take(src: IntIter, ref cur: TakeCursor) -> IntIter {
    let taken: IntIter = () => {
        if cur.left <= 0 { return null }
        let nx = src()
        match nx {
            i64 as v => { cur = TakeCursor { left = cur.left - 1 }; v }
            null => null
        }
    }
    taken
}
pub type SkipCursor = struct { left: i64 }
pub fn skip(src: IntIter, ref cur: SkipCursor) -> IntIter {
    let skipped: IntIter = () => {
        loop {
            if cur.left <= 0 { break }
            let dropped = src()
            match dropped {
                i64 => cur = SkipCursor { left = cur.left - 1 }
                null => { cur = SkipCursor { left = 0 }; return null }
            }
        }
        src()
    }
    skipped
}
pub type ChainCursor = struct { first_done: bool }
pub fn chain(a: IntIter, b: IntIter, ref cur: ChainCursor) -> IntIter {
    let ch: IntIter = () => {
        if cur.first_done == false {
            let na = a()
            match na {
                i64 as x => return x
                null => cur = ChainCursor { first_done = true }
            }
        }
        b()
    }
    ch
}
pub fn fold(src: IntIter, init: i64, step: (i64, i64) -> i64) -> i64 {
    mut acc = init
    loop {
        let nx = src()
        match nx {
            i64 as v => acc = step(acc, v)
            null => break
        }
    }
    acc
}
pub fn sum(src: IntIter) -> i64 {
    mut total: i64 = 0
    loop {
        let nx = src()
        match nx {
            i64 as v => total = total + v
            null => break
        }
    }
    total
}
pub fn collect(src: IntIter) -> []i64 {
    mut out: []i64 = teko::list::empty()
    loop {
        let nx = src()
        match nx {
            i64 as v => out = teko::list::push(out, v)
            null => break
        }
    }
    out
}
pub fn counting_identity(ref cell: i64) -> (i64) -> i64 {
    let c: (i64) -> i64 = (x: i64) => { cell = cell + 1; x }
    c
}
pub fn is_even(x: i64) -> bool { x % 2 == 0 }
pub fn times_ten(x: i64) -> i64 { x * 10 }
pub fn add(a: i64, x: i64) -> i64 { a + x }
pub fn check_sources() -> i64 {
    mut rc = RangeCursor { next = 0; hi = 4 }
    let collected = collect(range(rc))
    if collected.len != 4 { return 1 }
    if collected[0] != 0 { return 2 }
    if collected[3] != 3 { return 3 }
    0
}
pub fn check_laziness() -> i64 {
    mut count_cell = 0
    let ticking = counting_identity(count_cell)
    mut rc = RangeCursor { next = 0; hi = 1000 }
    mut tc = TakeCursor { left = 2 }
    let result = collect(take(map(range(rc), ticking), tc))
    if result.len != 2 { return 11 }
    if result[0] != 0 { return 12 }
    if result[1] != 1 { return 13 }
    if count_cell != 2 { return 14 }
    0
}
pub fn check_adapters() -> i64 {
    mut rc = RangeCursor { next = 0; hi = 6 }
    let evens = collect(filter(range(rc), is_even))
    if evens.len != 3 { return 21 }
    if evens[2] != 4 { return 22 }
    mut rc2 = RangeCursor { next = 0; hi = 5 }
    mut sc = SkipCursor { left = 2 }
    let after_skip = collect(skip(range(rc2), sc))
    if after_skip.len != 3 { return 23 }
    if after_skip[0] != 2 { return 24 }
    mut ra = RangeCursor { next = 0; hi = 2 }
    mut rb = RangeCursor { next = 10; hi = 12 }
    mut cc = ChainCursor { first_done = false }
    let chained = collect(chain(range(ra), range(rb), cc))
    if chained.len != 4 { return 25 }
    if chained[3] != 11 { return 26 }
    0
}
pub fn check_pipeline() -> i64 {
    mut rc = RangeCursor { next = 0; hi = 6 }
    let total = fold(map(filter(range(rc), is_even), times_ten), 0, add)
    if total != 60 { return 31 }
    mut rc2 = RangeCursor { next = 1; hi = 5 }
    if sum(range(rc2)) != 10 { return 32 }
    0
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: iter_protocol
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q099_iter_protocol`.
 */
pub fn entry() {
    let sources_result = check_sources()
    if sources_result != 0 { exit(sources_result) }
    let laziness_result = check_laziness()
    if laziness_result != 0 { exit(laziness_result) }
    let adapters_result = check_adapters()
    if adapters_result != 0 { exit(adapters_result) }
    let pipeline_result = check_pipeline()
    if pipeline_result != 0 { exit(pipeline_result) }
}
