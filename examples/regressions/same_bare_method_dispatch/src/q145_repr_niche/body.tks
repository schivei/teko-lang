type Node = class {
    /** The payload carried by a present node. */
    pub value: i32

    /**
     * Construct a present node.
     *
     * @param v  the payload value
     * @return   a live `Node` handle
     */
    pub fn make(v: i32) -> Node {
        Node { value = v }
    }
}
pub fn probe_class_niche() -> i32 {
    let present: Node | null = Node::make(7)
    mut a: i32 = 0
    match present {
        null => a = 100
        Node as n => a = n.value
    }
    let absent: Node | null = null
    mut b: i32 = 0
    match absent {
        null => b = 3
        Node as n => b = n.value + 100
    }
    a + b
}
pub fn probe_str_niche() -> i32 {
    let s: str | null = "ok"
    mut a: i32 = 0
    match s {
        null => a = 50
        str as v => a = (v.len) to i32
    }
    let none: str | null = null
    mut b: i32 = 0
    match none {
        null => b = 6
        str as v => b = (v.len) to i32 + 50
    }
    a + b
}
pub fn probe_error_niche() -> i32 {
    let ok: null | error = null
    mut a: i32 = 0
    match ok {
        null => a = 5
        error => a = 40
    }
    let bad: null | error = error { message = "x" }
    mut b: i32 = 0
    match bad {
        null => b = 60
        error => b = 8
    }
    a + b
}
pub fn probe_tagged_scalar() -> i32 {
    let present: i32 | null = 9
    mut a: i32 = 0
    match present {
        null => a = 70
        i32 as v => a = v
    }
    let absent: i32 | null = null
    mut b: i32 = 0
    match absent {
        null => b = 4
        i32 as v => b = v + 70
    }
    a + b
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: repr_niche
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q145_repr_niche`.
 */
pub fn entry() {
    exit(probe_class_niche() + probe_str_niche() + probe_error_niche() + probe_tagged_scalar())
}
