pub type Renderable = trait {
    fn render(self) -> str
    fn width(self, pad: i64) -> i64
    fn badge(self) -> str { "[R]" }
}
pub type Tagged = interface {
    fn tag(self) -> str
}
pub type Label = class & Renderable {
    text: str
    pub fn make(t: str) -> Label { Label { text = t } }
    pub fn render(self) -> str { self.text }
    pub fn width(self, pad: i64) -> i64 { 4 + pad }
}
pub type Button = class & Renderable & Tagged {
    caption: str
    pub fn make(c: str) -> Button { Button { caption = c } }
    pub fn render(self) -> str { self.caption }
    pub fn width(self, pad: i64) -> i64 { 10 + pad }
    pub fn tag(self) -> str { "button" }
}
pub fn draw(r: Renderable) -> str { r.render() }
pub fn pick(which: i64) -> Renderable {
    if which == 0 { return Label::make("lbl") }
    return Button::make("btn")
}
pub fn total_width(items: []Renderable, pad: i64) -> i64 {
    mut sum: i64 = 0
    mut i: u64 = 0
    loop {
        if i >= items.len { break }
        let it = items[i]
        sum = sum + it.width(pad)
        i++
    }
    sum
}

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: trait_dispatch
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q164_trait_dispatch`.
 */
pub fn entry() {
    let lbl = Label::make("hi")
    let r: Renderable = lbl
    if r.render() != "hi" { exit(1) }
    if r.width(3) != 7 { exit(2) }
    if draw(lbl) != "hi" { exit(3) }
    let p = pick(1)
    if p.render() != "btn" { exit(4) }
    let q = pick(0)
    if q.render() != "lbl" { exit(5) }
    let btn = Button::make("ok")
    let items: []Renderable = [lbl, btn]
    if total_width(items, 1) != 16 { exit(6) }
    let t: Tagged = btn
    if t.tag() != "button" { exit(7) }
    let br: Renderable = btn
    if br.render() != "ok" { exit(8) }
    if r.badge() != "[R]" { exit(9) }
    exit(0)
}
