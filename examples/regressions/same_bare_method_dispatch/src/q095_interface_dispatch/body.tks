type Shape2 = interface {
    fn area(self) -> i64
    fn grown(self, extra: i64) -> i64
}
type NamedShape = interface Shape2 {
    fn shape_name(self) -> str
}
type Circle2 = class & Shape2 {
    pub r: i64
    pub fn make(rr: i64) -> Circle2 { Circle2 { r = rr } }
    pub fn area(self) -> i64 { self.r * self.r * 3 }
    pub fn grown(self, extra: i64) -> i64 { self.area() + extra }
}
type Square2 = class & NamedShape {
    pub side: i64
    pub fn make(s: i64) -> Square2 { Square2 { side = s } }
    pub fn area(self) -> i64 { self.side * self.side }
    pub fn grown(self, extra: i64) -> i64 { self.area() + extra }
    pub fn shape_name(self) -> str { "square" }
}
type Speaker = interface {
    fn speak(self) -> str
}
type Animal2 = virtual class & Speaker {
    pub legs: i64
    pub fn make_animal(n: i64) -> Animal2 { Animal2 { legs = n } }
    pub virtual fn speak(self) -> str { "..." }
}
type Dog2 = class Animal2 {
    pub fn make_dog() -> Dog2 { Dog2 { legs = 4 } }
    pub override fn speak(self) -> str { "woof" }
}
fn shape_area(s: Shape2) -> i64 { s.area() }
fn pick_shape(which: i64) -> Shape2 {
    if which == 0 { return Circle2::make(1) }
    return Square2::make(5)
}
fn total_area2(shapes: []Shape2) -> i64 {
    mut sum: i64 = 0
    mut i: u64 = 0
    loop {
        if i >= shapes.len { break }
        let s = shapes[i]
        sum = sum + s.area()
        i++
    }
    sum
}
fn hold_shape<T: Shape2>(x: T) -> T { return x }
fn measure<T: Shape2>(x: T, extra: i64) -> i64 { return x.area() + x.grown(extra) }

/**
 * entry — F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)
 *          :: interface_dispatch
 *
 * Unfolded from a `Given source inline` block of regressor.tkr (owner ruling: no inline code in a
 * `.tkr`). It is a MEMBER NAMESPACE of this project and runs off the project's single build,
 * selected by `TEKO_REGR_ENTRY=q095_interface_dispatch`.
 *
 * Renamed to keep this project's bare TOP-LEVEL names unique: Animal -> Animal2, Circle -> Circle2, Dog -> Dog2, Shape -> Shape2, Square -> Square2, total_area -> total_area2.
 * A bare name declared twice in one project is resolved by several compiler passes without
 * consulting the namespace (the #284/#290 defect class), so the fold must not create the clash.
 */
pub fn entry() {
    let c = Circle2::make(2)
    let s: Shape2 = c
    if s.area() != 12 { exit(1) }
    if s.grown(5) != 17 { exit(2) }
    if shape_area(c) != 12 { exit(3) }
    let p = pick_shape(1)
    if p.area() != 25 { exit(4) }
    let q = pick_shape(0)
    if q.area() != 3 { exit(5) }
    let sq = Square2::make(3)
    let shapes: []Shape2 = [c, sq]
    if total_area2(shapes) != 21 { exit(6) }
    let n: NamedShape = sq
    if n.area() != 9 { exit(7) }
    if n.shape_name() != "square" { exit(8) }
    let d = Dog2::make_dog()
    let sp: Speaker = d
    if sp.speak() != "woof" { exit(9) }
    let a = Animal2::make_animal(2)
    let sa: Speaker = a
    if sa.speak() != "..." { exit(10) }
    let held = hold_shape(c)
    if held.area() != 12 { exit(11) }
    if shape_area(held) != 12 { exit(12) }
    if measure(c, 5) != 29 { exit(13) }
    if measure(sq, 2) != 20 { exit(14) }
    exit(0)
}
