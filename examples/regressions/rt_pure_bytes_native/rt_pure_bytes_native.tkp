# examples/regressions/rt_pure_bytes_native — a rota NATIVA (o backend por omissao, sem env
# declarado) do regressor de PARIDADE dos builtins de LOGICA PURA DE BYTES do Degrau 0.
#
# O QUE PRENDE. O Degrau 0 (mapa docs/design/nativo-sem-teko-rt.md) religa `str ==`/`ends_with`/
# `contains` ao gemeo Teko (`teko::runtime::str_eq`/`str_ends_with`/`str_contains`) QUANDO o corpo
# esta no corpus — o proprio compilador. Um programa STANDALONE como este NAO carrega
# `src/runtime/teko_rt.tks`, entao `runtime_twin_symbol` devolve `null` e a rota nativa mantem o
# `tk_str_*` de `teko_rt.c`: este par prova que a religacao NAO regrediu o baixamento nativo dos
# builtins, medindo a rota nativa contra o oraculo de rota C (`rt_pure_bytes_c`) sobre a MESMA fonte.
#
# `concat`/`u64_to_str`/`i64_to_str` sao Degrau 1 (alocam arena — `teko::list::push`) e por isso NAO
# foram religados; entram aqui so para provar que continuam a bater entre as rotas.
#
# UM SO FICHEIRO POR CONFIGURACAO DE PROJECTO: o par de rota C esta em
# `examples/regressions/rt_pure_bytes_c/rt_pure_bytes_c.tkr`, porque a cache de build de um `.tkr` e
# chaveada na FORMA do build e nao no env (`regr_built_serves`, `src/build/regression.tks`).
name = "rt_pure_bytes_native"
source = "src"

[artifact]
kind = "binary"
