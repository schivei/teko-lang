/**
 * chk — the Degrau-0 pure-byte-logic checks: `str ==`/`!=` (str_eq), `ends_with`, `contains`, plus
 * the neighbouring ALLOCATING builtins (`concat`/`u64_to_str`/`i64_to_str`) that Degrau 0 deliberately
 * does NOT reroute yet. Every check drives one bare `teko::str::…` builtin and returns a DISTINCT
 * non-zero code the moment its answer is wrong, so a failure names which builtin moved; `0` means all
 * agreed. The C route (`rt_pure_bytes_c`) runs the SAME source, so the two routes' exit codes must match.
 */

/**
 * run — every pure-byte and neighbouring builtin check, in order. Each `if` inverts a KNOWN answer so
 * only a wrong result returns; the trailing `0` is reached only when all twelve agreed.
 *
 * @return  `0` when every builtin answered correctly, else the code of the first that did not (1-12)
 */
exp fn run() -> i64 {
    if !teko::str::ends_with("hello world", "world") { return 1 }
    if teko::str::ends_with("hello world", "worldx") { return 2 }
    if !teko::str::ends_with("hello", "") { return 3 }
    if teko::str::ends_with("hi", "hello") { return 4 }
    if !teko::str::contains("hello world", "lo wo") { return 5 }
    if teko::str::contains("hello world", "xyz") { return 6 }
    if !teko::str::contains("hello", "") { return 7 }
    if "abc" != teko::str::concat("ab", "c") { return 8 }
    if "abc" == teko::str::concat("ab", "d") { return 9 }
    if "" != teko::str::concat("", "") { return 10 }
    if teko::str::u64_to_str(42) != "42" { return 11 }
    if teko::str::i64_to_str(-7) != "-7" { return 12 }
    0
}
