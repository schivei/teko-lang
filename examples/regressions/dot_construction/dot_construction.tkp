# examples/regressions/dot_construction — the §4.1 `.{ … }` target-typed construction ACCEPTANCE
# channel. `.{ … }` builds the CONTEXT's expected type: a `static fn … : self` tail and `return`,
# an annotated binding, a call argument, a nested field, and a generic self-return (phantom-stamped
# per width). Each probe answers a BOOL only the correctly-targeted construction makes true, and
# `main.tks` announces the scenario by name. TEST = the printed token, never the exit code. The
# NOMINAL `Name { … }` form coexists and is checked in the same host (nominal_still_ok).
name = "dot_construction"
source = "src"

[artifact]
kind = "binary"
