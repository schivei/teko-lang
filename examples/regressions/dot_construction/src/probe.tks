pub type Counter = struct {
    _n: i64

    pub static fn zero(): self { .{ _n = 0 } }

    pub static fn one(): self { return .{ _n = 1 } }

    pub fn n(): i64 { self._n }
}

pub type Outer = struct {
    inner: Counter
}

pub type Cell<T> = struct {
    _v: T

    pub static fn of(v: T): self { .{ _v = v } }

    pub fn v(): T { self._v }
}

pub fn take(c: Counter): i64 { c.n() }

pub fn dot_static_self_probe(): bool {
    var c = Counter::zero()
    c.n() == 0
}

pub fn dot_return_stmt_probe(): bool {
    var c = Counter::one()
    c.n() == 1
}

pub fn dot_binding_annotated_probe(): bool {
    var b: Counter = .{ _n = 7 }
    b.n() == 7
}

pub fn dot_arg_probe(): bool {
    take(.{ _n = 5 }) == 5
}

pub fn dot_field_nested_probe(): bool {
    var o = Outer { inner = .{ _n = 3 } }
    o.inner.n() == 3
}

pub fn dot_generic_self_probe(): bool {
    var gi = Cell<i64>::of(9)
    var gs = Cell<str>::of("hi")
    gi.v() == 9 && gs.v().len == 2
}

pub fn nominal_still_ok_probe(): bool {
    var c = Counter { _n = 4 }
    var g = Cell<i64> { _v = 2 }
    c.n() == 4 && g.v() == 2
}
