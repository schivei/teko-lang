/**
 * Counter — a value-struct whose retired `self { … }` construction (in `zero`) must be a compile
 * error, while its `self`-as-receiver (`n`) and `self`-as-type (`same`) uses stay valid — proving
 * §4.1 retired only the construction form of `self`, not the receiver or the type.
 */
type Counter = struct {
    /** _n — the backing count. */
    _n: i64

    /**
     * zero — attempts the RETIRED `self { … }` construction; this is now a compile error (§4.1). The
     * target-typed replacement is `.{ _n = 0 }`.
     *
     * @return unreachable — the construction form is rejected
     */
    pub static fn zero(): self { self { _n = 0 } }

    /**
     * n — reads `self._n`: `self` as a RECEIVER stays valid.
     *
     * @return the backing count
     */
    pub fn n(): i64 { self._n }

    /**
     * same — returns `self`: `self` as a return TYPE (and as the receiver value) stays valid.
     *
     * @return the receiver itself
     */
    pub fn same(): self { self }
}
