/**
 * r2_div — a multiple-return function whose value must be DESTRUCTURED, never bound whole.
 *
 * @param a x
 * @param b y
 * @return q, r
 */
fn r2_div(a: i32, b: i32): (i32, i32) { return (a / b, a % b) }
/**
 * r2_value_position — binding a multiple-return value to a SINGLE name is illegal (§9 F, ruling 3):
 * there is no first-class tuple value to capture.
 */
fn r2_value_position() {
    var t = r2_div(17, 5)
}
