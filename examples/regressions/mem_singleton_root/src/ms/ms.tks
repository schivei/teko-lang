/**
 * anchor_tag — a HEAP str built by concatenation (not a static literal), the value the `#singleton`
 * binding holds. Concatenation routes through the runtime's fresh-buffer builder, so the anchor is a
 * genuine allocated value whose residence the oracle decides — root, because the binding is
 * `#singleton`.
 *
 * @return  the str "root-anchor"
 */
fn anchor_tag() -> str {
    "root" ~ "-anchor"
}

/**
 * churn — open and close allocating scopes AROUND the singleton read. Each loop iteration is a
 * lexical scope that allocates a fresh list; under the scope memory model its arena dies at the
 * iteration's exit edge. The churn exists to prove the singleton anchor is NOT collected by any of
 * these scope exits — a scope-resident anchor would be at risk, a root-resident one is not.
 *
 * @return  the accumulated sum of the churned elements (used so the loop is not dead code)
 */
fn churn() -> i64 {
    mut acc: i64 = 0
    mut i: i64 = 0
    loop {
        if i >= 8 { break }
        let scratch = teko::list::push(teko::list::empty(), i)
        acc = acc + scratch[0 to u64]
        i++
    }
    acc
}

/**
 * probe — declare a `#singleton` str binding, churn allocating scopes, then read the binding back.
 * The `#singleton` forces the anchor to root residence, so it survives the churn and reads back its
 * exact value.
 *
 * @return  the anchor str, unchanged by the surrounding scope churn
 */
exp fn probe() -> str {
    #singleton let anchor = anchor_tag()
    _ = churn()
    anchor
}
