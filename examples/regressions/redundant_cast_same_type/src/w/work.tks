/**
 * `x to u32` where `x` is already `u32` — a provable no-op (D1 class 1,
 * `cast-width-hygiene-0.3.1.md` §4/§9). Ratified as a DIRECT compile ERROR, no warn phase
 * (owner ruling 2026-07-24) — the corpus can never grow a second no-op cast unnoticed.
 *
 * @return never — this is a compile-time rejection
 */
pub fn probe() -> i64 {
    let x: u32 = 5
    (x to u32) to i64
}
