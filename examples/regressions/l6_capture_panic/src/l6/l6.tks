fn boom(): null {
    panic("deliberate boom")
    null
}

fn quiet(): null {
    var x = 1 + 1
    _ = x
    null
}

/**
 * run_probes — drive `capture_panic` over a panicking and a returning body, printing which arm each
 * took: the panic is caught (message recovered) without unwinding past the frame, and a clean body
 * yields null.
 *
 * @since 0.3.1
 */
exp fn run_probes() {
    match capture_panic(boom) {
        str as m => teko::io::println(teko::str::concat("caught: ", m))
        null => teko::io::println("no-catch")
    }
    match capture_panic(quiet) {
        str => teko::io::println("unexpected-catch")
        null => teko::io::println("clean-return")
    }
}
