var blk = raw_mmap(4096)
if blk == 0 { exit(2) }
var s: i64 = 0
loop {
    if s >= WORKERS { break }
    spawn worker(blk, WORKERS)
    s = s + 1
}
var tries: i64 = 0
loop {
    if tries >= POLL_LIMIT { exit(1) }
    if teko::sys::atomic_load_u32((blk + PASSED_OFF) to i64) == WORKERS { break }
    tries = tries + 1
}
exit(0)
