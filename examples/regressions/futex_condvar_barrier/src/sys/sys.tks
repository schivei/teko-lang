/** SYS_MMAP — x86_64 Linux `mmap` syscall number (9). Local mirror of `teko::sys` for a standalone
 *  fixture; the `teko::sys::syscall*`/`atomic_*` INTRINSICS are compiler builtins, only the numbers
 *  come from here. */
#os("linux") #arch("x86_64")
pub const SYS_MMAP: i64 = 9
/** SYS_MMAP — aarch64 Linux `mmap` syscall number (222). */
#os("linux") #arch("arm64")
pub const SYS_MMAP: i64 = 222
/** SYS_FUTEX — x86_64 Linux `futex` syscall number (202), the wait/wake primitive under the mutex. */
#os("linux") #arch("x86_64")
pub const SYS_FUTEX: i64 = 202
/** SYS_FUTEX — aarch64 Linux `futex` syscall number (98). */
#os("linux") #arch("arm64")
pub const SYS_FUTEX: i64 = 98
/** PROT_READ — `mmap` readable protection flag (1). */
#os("linux")
pub const PROT_READ: i64 = 1
/** PROT_WRITE — `mmap` writable protection flag (2). */
#os("linux")
pub const PROT_WRITE: i64 = 2
/** MAP_PRIVATE — `mmap` private copy-on-write mapping flag (2). */
#os("linux")
pub const MAP_PRIVATE: i64 = 2
/** MAP_ANONYMOUS — `mmap` anonymous (not file-backed, zero-filled) mapping flag (32). */
#os("linux")
pub const MAP_ANONYMOUS: i64 = 32
/** FUTEX_WAIT — `futex` op blocking while the word equals the expected value (0). */
#os("linux")
pub const FUTEX_WAIT: i64 = 0
/** FUTEX_WAKE — `futex` op waking up to `val` waiters (1). */
#os("linux")
pub const FUTEX_WAKE: i64 = 1
/** FUTEX_PRIVATE_FLAG — process-private futex modifier (128); OR'd into the op. */
#os("linux")
pub const FUTEX_PRIVATE_FLAG: i64 = 128
