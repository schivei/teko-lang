/** WORKERS — the number of threads meeting at the barrier. */
pub const WORKERS: i64 = 8
/** POLL_LIMIT — bounded spins the main thread waits for all workers to clear the barrier. */
pub const POLL_LIMIT: i64 = 2000000000
/** MUTEX_OFF — byte offset of the futex mutex word within the shared page. */
pub const MUTEX_OFF: u64 = 0
/** SEQ_OFF — byte offset of the condvar sequence word within the shared page. */
pub const SEQ_OFF: u64 = 8
/** ARRIVED_OFF — byte offset of the 64-bit arrived-count within the shared page. */
pub const ARRIVED_OFF: u64 = 16
/** PASSED_OFF — byte offset of the 32-bit barrier-cleared count within the shared page. */
pub const PASSED_OFF: u64 = 24

/**
 * raw_mmap — map `length` bytes of anonymous private read/write memory via the raw `mmap` syscall,
 * the shared page holding the mutex, condvar sequence and barrier counters. Returns the page-aligned
 * base, or 0 when the kernel refuses.
 *
 * @param length  the mapping size in bytes
 * @return        the base address, or 0 on failure
 */
pub fn raw_mmap(length: u64): u64 {
    var r = teko::sys::syscall6(teko::sys::SYS_MMAP, 0, length to i64,
        teko::sys::PROT_READ | teko::sys::PROT_WRITE,
        teko::sys::MAP_PRIVATE | teko::sys::MAP_ANONYMOUS, -1, 0)
    if r >= -4095 && r <= -1 { return 0 }
    r to u64
}

/**
 * worker — one thread meeting at the condvar barrier: under the CANONICAL `teko::runtime::mtx_lock`,
 * register arrival; the LAST to arrive `teko::runtime::cv_broadcast`s the release, every earlier
 * arrival `teko::runtime::cv_wait`s (re-testing the arrived-count predicate on each wake) until the
 * count reaches `n`. After clearing, bump the passed word so the main thread's poll observes this
 * worker got through — a full count proves every waiter was released by the broadcast (a lost wakeup
 * would hang the poll to its bound and fail).
 *
 * @param blk  the shared page's base address (spawn-copied scalar)
 * @param n    the barrier's participant count
 * @return     nothing
 */
pub fn worker(blk: u64, n: i64) {
    var m = blk + MUTEX_OFF
    var seq = blk + SEQ_OFF
    var arrived = blk + ARRIVED_OFF
    var passed = blk + PASSED_OFF
    teko::runtime::mtx_lock(m)
    var a = teko::mem::load_u64(arrived) + 1
    teko::mem::store_u64(arrived, a)
    if a == n to u64 {
        teko::runtime::cv_broadcast(seq)
    } else {
        loop {
            if teko::mem::load_u64(arrived) == n to u64 { break }
            teko::runtime::cv_wait(seq, m)
        }
    }
    teko::runtime::mtx_unlock(m)
    _ = teko::sys::atomic_add_u32(passed to i64, 1)
}
