# Regression (cast-width-hygiene-0.3.1.md §3, D5): `str.len` is canonically `u64`
# (`typer.tks` types it `Prim{U64}`) — binding it directly to a `u64` slot needs NO cast at all,
# the policy this doc's C3 signature sweep exists to make the corpus-wide default.
#   s = "abc"  =>  s.len == 3 (u64, no cast)
#
#   teko build examples/regressions/len_is_u64_nocast && ./examples/regressions/len_is_u64_nocast/len_is_u64_nocast   # -> exit 3
name = "len_is_u64_nocast"
source = "src"

[artifact]
kind = "binary"
