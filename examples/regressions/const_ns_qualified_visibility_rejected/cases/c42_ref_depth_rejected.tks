// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: ref_depth_rejected
//
// A STANDALONE case file, not a namespace of this project's folded build. Its diagnostic
// comes from a checker PRE-WALK pass, which stops at the FIRST error instead of collecting
// every one — so folding it into the shared build would mask all 37 diagnostics behind this
// one. It costs its own build until the pre-walk passes collect like the item walk does.
// expected diagnostic: 'a reference cannot target another reference (`Ref<Re'
/**
 * deep — a `ref ref T` parameter: a reference to a reference exceeds the depth-1 reference cap of
 * this version (raising the cap to 2 rides the transitive-escape spine).
 *
 * @param r  a doubly-referenced integer (rejected)
 * @return  never — a compile error (EXPECT_COMPILE_FAIL)
 */
fn deep(ref r: ref i64) -> i64 { 0 }

/**
 * probe — present so the module has a public entry; references `deep` so it is checked.
 *
 * @return never — see `deep`
 */
pub fn probe() -> i64 { mut x: i64 = 1; deep(&x) }

(probe()) to i32
