pub type A = struct { a: i64 }
pub type B = struct { b: i64 }

fn sum_grouped(xs: [](A | B)): i64 {
    var total: i64 = 0
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        total = total + match xs[i] { A as v => v.a; B as v => v.b }
        i++
    }
    total
}

fn precedence_check(x: []A | B): i64 {
    match x { B as v => v.b; _ => -1 }
}

pub fn entry(): i64 {
    var g: [](A | B) = [A { a = 1 }, B { b = 2 }]
    var s1 = sum_grouped(g)
    var s2 = precedence_check(B { b = 5 })
    s1 + s2
}
