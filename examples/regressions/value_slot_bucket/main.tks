var m: u64 = 5
var slots = teko::list::of_len<i64>(m)
var token: u64 = 0

loop var i in 0..m {
    var p = teko::mem::place(big::make(i to i64))
    var before = teko::mem::read(p).a
    teko::mem::write(p, big::make((i to i64) + 100))
    var after = teko::mem::read(p).a
    if before != (i to i64) { exit(1) }
    if after != (i to i64) + 100 { exit(2) }
    slots[i] = teko::sys::ptr_word(p)
    token = token + 1
}
if token != m { exit(3) }

loop var i in 0..m {
    if slots[i] <= 0 { exit(4) }
}

loop var i in 0..m {
    loop var j in 0..m {
        if i != j {
            if slots[i] == slots[j] { exit(5) }
        }
    }
}

exit(0)
