# examples/regressions/value_slot_bucket — the COL-F0a bucket-mark fixture (crumb 0021). Proves the
# SEALED life model: reassigning a VALUE slot (`teko::mem::write`) does ZERO mid-region reclaim —
# the write overwrites the slot in place and nothing is freed; the region's bump only grows (every
# `place` returns a fresh, distinct address) and the physical bytes leave only at the region's bulk
# drop. The compiler never runs the VALUE `set` path itself, so this is not fixpoint-exercised.
# Pinned to the C backend: `place`/`write`/`read` emit on the C route and the native leg
# honest-stops (N2).
name = "value_slot_bucket"
source = "src"

[artifact]
kind = "binary"
