# examples/regressions/const_slice_of_str — o regressor de projecto para um const AGREGADO cujo
# elemento e FAT: `[]str`, `[][]str` e um struct com campo `[]str`. E a forma que as tabelas de
# simbolos do proprio compilador usam (`ONE_STR_BY_VALUE_ENTRIES` e irmas, em `src/lir/lower.tks`).
#
# Sem a materializacao por membro fat, a rota NATIVA para honestamente em `const_slice_image` com
# "const aggregate: slice element is pointer/slice-bearing -> Tier-B (T-B), not crumb 6 (#594)" e
# nenhum binario e produzido. A rota C nunca chegava la: `inline_aggregate_consts` substitui cada
# referencia pelo clone do inicializador, entao o `[]str` vira expressao inline em C.
#
# O codigo de saida le de volta comprimentos E conteudo em todos os tres niveis, entao um `.len`
# dobrado (o bug de passada do `const_slice_len`, que dividia por 8 em vez de 16), uma folha
# trocada ou uma relocacao no deslocamento errado movem o numero.
name = "const_slice_of_str"
source = "src"

[artifact]
kind = "binary"
