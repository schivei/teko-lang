/**
 * TABLE — um const `[]str`: a forma exacta das tabelas de simbolos do proprio compilador
 * (`ONE_STR_BY_VALUE_ENTRIES` e irmas). Cada elemento e um valor FAT `{ptr, len}`, entao a imagem em
 * rodata e um blob de tres slots de 16 bytes, tres relocacoes e tres folhas.
 */
const TABLE: []str = ["alpha", "beta", "gamma"]

/**
 * GRID — um const `[][]str`: o elemento e ele proprio uma slice de elementos fat, entao as folhas
 * aninham. Prende os simbolos de folha aninhados (`.Lconst_GRID.<i>.<j>`) e a recursao que os produz.
 */
const GRID: [][]str = [["a", "bb"], ["ccc"]]

/**
 * Desc — um descritor com um campo `[]str` (um membro fat cuja folha e ela propria portadora de
 * ponteiros) e um campo escalar.
 */
type Desc = struct {
    /** as etiquetas do descritor. */
    tags: []str
    /** o peso do descritor. */
    rank: i64
}

/**
 * DESC — um const de struct cujo campo fat aponta para uma folha que TAMBEM carrega relocacoes.
 * Antes desta mudanca a folha de um campo era sempre plana (`relocs = []`).
 */
const DESC: Desc = Desc { tags = ["x", "yy", "zzz"]; rank = 5 }

/**
 * table_score — le `TABLE` de volta: a contagem de elementos, o comprimento do primeiro e do ultimo
 * elemento, e a igualdade do do meio. `3 + 5 + 5 + 10` = 23.
 *
 * @return a contribuicao de `TABLE` para o codigo de saida
 */
fn table_score() -> i64 {
    mut n: i64 = TABLE.len to i64
    n = n + (TABLE[0].len to i64)
    n = n + (TABLE[2].len to i64)
    if TABLE[1] == "beta" { n = n + 10 }
    n
}

/**
 * grid_score — le `GRID` de volta em ambos os niveis: a contagem exterior, a contagem de cada linha,
 * e o conteudo de duas celulas. `2 + 2 + 1 + 10 + 20` = 35.
 *
 * @return a contribuicao de `GRID` para o codigo de saida
 */
fn grid_score() -> i64 {
    mut n: i64 = GRID.len to i64
    n = n + (GRID[0].len to i64)
    n = n + (GRID[1].len to i64)
    if GRID[0][1] == "bb" { n = n + 10 }
    if GRID[1][0] == "ccc" { n = n + 20 }
    n
}

/**
 * desc_score — le `DESC` de volta: o campo escalar, a contagem do campo fat e o conteudo da ultima
 * etiqueta. `5 + 3 + 10` = 18.
 *
 * @return a contribuicao de `DESC` para o codigo de saida
 */
fn desc_score() -> i64 {
    mut n: i64 = DESC.rank
    n = n + (DESC.tags.len to i64)
    if DESC.tags[2] == "zzz" { n = n + 10 }
    n
}

/**
 * names_it — teste de pertenca linear sobre `TABLE` com indice VARIAVEL. Le a mesma imagem em rodata
 * por outro caminho de baixamento (`lower_index_fat`, sem dobragem em tempo de compilacao), entao
 * prende o passo do elemento e o `.len` independentemente do fold de indice constante.
 *
 * @param s  a cadeia a procurar
 * @return   verdadeiro sse `TABLE` contem `s`
 */
fn names_it(s: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= TABLE.len { break }
        if TABLE[i] == s { return true }
        i++
    }
    false
}

/**
 * membership_score — a pertenca por indice variavel: `gamma` esta na tabela, `delta` nao. `20`.
 *
 * @return a contribuicao do teste de pertenca para o codigo de saida
 */
fn membership_score() -> i64 {
    mut n: i64 = 0
    if names_it("gamma") { n = n + 20 }
    if names_it("delta") { n = n + 40 }
    n
}

/**
 * score — a soma das quatro leituras, o codigo de saida que o cenario prende: `23 + 35 + 18 + 20` = 96.
 *
 * @return o codigo de saida do cenario
 */
pub fn score() -> i64 {
    table_score() + grid_score() + desc_score() + membership_score()
}
