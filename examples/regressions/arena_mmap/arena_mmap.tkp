# examples/regressions/arena_mmap — the §16 arena-over-mmap keystone sub-crumb D fixture
# (`docs/design/plano-s16-arena-mmap.md` §7 crumb D). The behavioural proof for the Teko arena core
# that will replace the hand-written C arena: it replays `examples/probes/arena_teko`'s group-0..5
# asserts (the word seam; distinct 16-aligned pointers sharing a chunk; a >64 KB exclusive chunk;
# drop reclaim + idempotent sweep; subtree sweep; register/lookup; free-list ceil/floor; checkpoint
# push/pop/commit past depth 64; paranoid poison + never-reuse) RE-TARGETED to the C leg and to the
# mmap `fundo` — the libc `c_aligned_alloc`/`c_free` of the native-leg probe is gone, replaced by
# raw `mmap`/`munmap` (`teko::sys::syscall6`/`syscall2`) and the raw word seam
# (`teko::mem::load_u64`/`store_u64`), and a META-POOL sub-allocates the fixed-size metadata the
# kernel's one-page minimum mapping cannot. PLUS a non-vacuous META-POOL header-reuse assert: a
# drop-then-new region reuses the SAME header address (exit 74 if the header free-list is disabled).
# Exit 42 on all-pass.
#
# A SELF-CONTAINED project (its own local `src/sys/sys.tks` copy of the `SYS_*`/`PROT_*`/`MAP_*`
# consts), because the real `teko::sys` lives in the COMPILER's own reserved-root `teko` project an
# external standalone project has no visibility into — the `sys_mmap`/`sys_write` precedent. The
# `teko::sys::syscall*` and `teko::mem::load_u64`/`store_u64` INTRINSICS are compiler builtins, so a
# standalone project reaches them under their `teko::`-rooted names; only the numbers/flags come
# from the local mirror.
name = "arena_mmap"
source = "src"

[artifact]
kind = "binary"
