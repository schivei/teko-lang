var piece0: []byte = [b'a', b'b', b'c']
var piece1: []byte = [b'1', b'2']
var piece2: []byte = [b'X', b'Y', b'Z', b'!']

var total: u64 = piece0.len + piece1.len + piece2.len
var final: [total]byte = []

var k: u64 = 0
teko::runtime::copy(final, k, piece0)
k = k + piece0.len
teko::runtime::copy(final, k, piece1)
k = k + piece1.len
teko::runtime::copy(final, k, piece2)
k = k + piece2.len

if k != total { exit(1) }
if final.len != total { exit(2) }
if final.len != cfg::EXPECT.len { exit(3) }

loop var i in 0..final.len {
    if final[i] != cfg::EXPECT[i] { exit(4) }
}

exit(0)
