# examples/regressions/value_place_once — the COL-F0a VALUE-regime fixture (crumb 0021, D56). Proves
# `teko::mem::place<T>(region, v)` writes a large value-struct ONCE into the EXPLICITLY-PASSED region
# (the collection's own region, not the incidental enclosing lexical region) and returns a stable
# pointer, that a forced grow of the pointer INDEX copies pointers only, and that each placed value is
# still DEREFERENCEABLE after the grow (residence holds). The compiler never `place`s a large
# VALUE-struct itself (it inlines scalars and references objects), so this path is not
# fixpoint-exercised. Pinned to the C backend: `place`/`read` emit on the C route and the native leg
# honest-stops (N2).
name = "value_place_once"
source = "src"

[artifact]
kind = "binary"
