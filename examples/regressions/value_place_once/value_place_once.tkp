# examples/regressions/value_place_once — the COL-F0a VALUE-regime fixture (crumb 0021). Proves
# `teko::mem::place<T>(v)` writes a large value-struct ONCE into the collection's region and returns
# a stable pointer, and that a forced grow of the pointer INDEX copies pointers only — the placed
# values are never recopied (their addresses are unchanged after the index grows). The compiler
# never `place`s a large VALUE-struct itself (it inlines scalars and references objects), so this
# path is not fixpoint-exercised. Pinned to the C backend: `place`/`read` emit on the C route and
# the native leg honest-stops (N2).
name = "value_place_once"
source = "src"

[artifact]
kind = "binary"
