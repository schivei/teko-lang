var n: u64 = 4
var idx = teko::list::of_len<i64>(n)
var check: i64 = 0
var placed: u64 = 0

loop var i in 0..n {
    var p = teko::mem::place(big::make(i to i64))
    var back = teko::mem::read(p)
    check = check + back.a + back.h
    idx[i] = teko::sys::ptr_word(p)
    placed = placed + 1
}
if placed != n { exit(1) }
if check != 40 { exit(2) }

var idx2 = teko::list::of_len<i64>(n * 2)
loop var i in 0..n {
    idx2[i] = idx[i]
}
loop var i in 0..n {
    if idx2[i] != idx[i] { exit(3) }
    if idx2[i] <= 0 { exit(4) }
}

exit(0)
