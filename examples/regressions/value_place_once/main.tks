var n: u64 = 4
var reg = teko::runtime::region_new(teko::runtime::region_root())
var idx = teko::list::of_len<i64>(n)
var check: i64 = 0
var placed: u64 = 0

loop var i in 0..n {
    var p = teko::mem::place(reg, big::make(i to i64))
    var back = teko::mem::read(p)
    check = check + back.a + back.h
    idx[i] = teko::sys::ptr_word(p)
    placed = placed + 1
}
if placed != n { exit(1) }
if check != 40 { exit(2) }

var idx2 = teko::list::of_len<i64>(n * 2)
loop var i in 0..n {
    idx2[i] = idx[i]
}

var after: i64 = 0
loop var i in 0..n {
    if idx2[i] != idx[i] { exit(3) }
    if idx2[i] <= 0 { exit(4) }
    match teko::sys::word_ptr(idx2[i]).__wrap<big::Big>() {
        big::Big as b => { after = after + b.a + b.h }
        error => exit(5)
        null => exit(6)
    }
}
if after != check { exit(7) }

exit(0)
