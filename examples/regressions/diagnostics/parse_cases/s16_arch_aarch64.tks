#arch("aarch64")
/**
 * X — a const guarded by a MISSPELLED arch value (`aarch64`, the canonical spelling is `arm64`).
 * §16 crumb 0 rejects it at PARSE time with a located "did you mean" hint, so the silent
 * prune-to-nothing that hid the original `#arch("aarch64")` bug can never recur.
 *
 * @return  never — the file fails to compile
 */
pub const X: i64 = 1
