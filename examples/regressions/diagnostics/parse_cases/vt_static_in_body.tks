/** Bad — a value-type body may not declare a `static` method: write a separate free function (§9 ruling 10). */
type Bad = i32 {
    /** mk — a `static` method, which a value-type body may not declare: the located parse error under test. */
    static fn mk(): Bad { 0 to Bad }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
