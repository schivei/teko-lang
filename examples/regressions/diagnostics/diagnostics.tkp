# diagnostics.tkp — the CHECKER-STAGE compile-fail CHANNEL (NEGATIVE FIXTURE — this project is
# asserted to FAIL).
#
# The name is the channel's job, not a fixture's: this is the `diagnostics` project the 0.3.1
# all-diagnostics ruling describes — one source file per rejected construct, ONE build, N scenarios
# pinning N diagnostics. It was called `const_ns_qualified_visibility_rejected` after the first
# rejection folded into it, which stopped describing it thirty-six rejections ago.
#
# Its two named regressions:
#   * `src/main.tks` + `src/m1/consts.tks` — a namespace-qualified VALUE reference `m1::PRIV` to a
#     `private` module-level const declared in another namespace (#594 crumb 8c / issue #613).
#   * `src/leakbase.tks` + `src/leaksub/sub.tks` — a `private` member const read through an
#     inheriting subclass declared in ANOTHER namespace (#594 crumb 7). It moved here from
#     `parse_diagnostics`, which became the PARSE-stage host.
#
# Around them, thirty-five further rejected constructs live one per namespace under `src/`. They all
# share THIS ONE failing build: the compiler's item walk reports every diagnostic it finds, and the
# runner checks a `Given source`-less compile-fail scenario against the project's cached failing
# build. Sixty-five per-scenario builds became two, plus seven that provably cannot fold — see the
# `.tkr` header for the measurement.
name = "diagnostics"
source = "src"

[artifact]
kind = "binary"
