/** Bad — an operator whose operands are BOTH raw primitives; at least one must be `self` (§9 ruling 1). */
type Bad = i32 {
    /** __add — no `self` operand: rejected at definition. */
    operator __add(left: i32, right: i32): self { (left + right) to Bad }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
