/** CIEq — a complete equality contract, so the failure below is about the implementer. */
type CIEq = interface {
    /** __eq — equality. */
    operator __eq(left: self, right: self): bool
    /** __ne — the mandated counterpart. */
    operator __ne(left: self, right: self): bool
}
/** BadEq — a struct claiming CIEq but providing only `__eq`, no `__ne`, no NeByEq mixin (§9.4 D1). */
type BadEq = struct CIEq {
    /** x — the compared datum. */
    x: i32
    /** __eq — the sole operator BadEq provides; its counterpart is missing. */
    operator __eq(left: self, right: self): bool { left.x == right.x }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
