/** Cel — a body-carrying i32-backed value-type. It is NOMINAL (unlike a transparent alias), so it does
    NOT resolve-through to `i32`: using a `Cel` where an `i32` is annotated needs the explicit `to i32`. */
type Cel = i32 {
    /** __add — same-type add (the body is what makes `Cel` a nominal newtype rather than an alias). */
    operator __add(left: self, right: self): self { (left to i32 + right to i32) to Cel }
}
/** entry — assigns a `Cel` into an `i32` slot WITHOUT the explicit cast, which the nominal type rejects. */
pub fn entry() {
    var n: i32 = 20 to Cel
    exit(n)
}
