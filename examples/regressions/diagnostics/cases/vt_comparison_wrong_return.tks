/** Bad — a comparison operator whose return type is `self`, but a comparison must return `bool` (§9 ruling 3). */
type Bad = i32 {
    /** __eq — WRONG: returns `self` instead of `bool`. */
    operator __eq(left: self, right: self): self { left }
    /** __ne — the correct counterpart, so only the wrong return is under test. */
    operator __ne(left: self, right: self): bool { left to i32 != right to i32 }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
