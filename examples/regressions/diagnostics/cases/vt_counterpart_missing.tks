/** Bad — a value-type declaring `__lt` without its mandated `__ge` counterpart (§9 ruling 5). */
type Bad = i32 {
    /** __lt — the comparison whose counterpart `__ge` is missing. */
    operator __lt(left: self, right: self): bool { left to i32 < right to i32 }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
