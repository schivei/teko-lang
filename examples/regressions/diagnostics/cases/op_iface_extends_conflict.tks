/** IAlpha — declares `rank(): i32`. */
type IAlpha = interface {
    /** rank — the alpha ranking, returning `i32`. */
    fn rank(): i32
}
/** IBeta — declares `rank(): str`, a DIFFERENT signature from IAlpha::rank. */
type IBeta = interface {
    /** rank — the beta ranking, returning `str`. */
    fn rank(): str
}
/** IBoth — extends both, fusing two conflicting `rank` signatures (§9.4 G8). */
type IBoth = interface & IAlpha & IBeta {
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
