/** WrongRet — a struct whose `__eq` illegally returns `self` instead of `bool` (§9 ruling 3). */
type WrongRet = struct {
    /** x — the compared datum. */
    x: i32
    /** __eq — a comparison operator with the WRONG return type (`self` where `bool` is required). */
    operator __eq(left: self, right: self): self { left }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
