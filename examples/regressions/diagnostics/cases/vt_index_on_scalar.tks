/** Bad — a SCALAR newtype declaring `operator __index`, allowed only on an indexed carrier (§9 ruling 4). */
type Bad = i32 {
    /** __index — illegal here: the backing `i32` is not an indexed type. */
    operator __index(left: self, i: i32): i32 { left to i32 }
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
