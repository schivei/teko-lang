/**
 * bad — a plain function that tries to declare a `_` discard parameter; the checker rejects it
 * because a plain function's author controls the signature and must name the parameter (owner
 * refinement 2026-07-15).
 *
 * @param x  the kept argument
 * @return   never — the checker rejects this signature
 * @example expected diagnostic: `a `_` discard parameter is only allowed when impleme`
 */
pub fn bad(x: i64, _): i64 { x }

/**
 * deep — a `ref ref T` parameter: a reference to a reference exceeds the depth-1 reference cap of
 * this version (raising the cap to 2 rides the transitive-escape spine).
 *
 * @param r  a doubly-referenced integer (rejected)
 * @return   never — a compile error (EXPECT_COMPILE_FAIL)
 * @example expected diagnostic: ``a reference cannot target another reference (`Ref<Re``
 */
fn deep(ref r: ref i64): i64 { 0 }

/**
 * probe — present so the module has a public entry; references `deep` so it is checked.
 *
 * @return  never — see `deep`
 */
pub fn probe(): i64 { var x: i64 = 1; deep(&x) }

/**
 * A LOCAL COPY of `teko::c_types::c_string` (c-types-and-marshalling-0.3.1.md §7.1, crumb C4) —
 * see `staged/c_types/c_types.tks` for the canonical original.
 */
pub unsafe type LocalCString = struct {
    /** The base address of a NUL-terminated buffer. */
    ptr: ptr<byte>

    /** The payload length, excluding the terminator. */
    len: u64
}

/**
 * REJECTED: a non-`unsafe fn` naming the unsafe-typed `LocalCString` in its OWN signature — U2's
 * fn-signature containment gate (`reject_unsafe_signature_contagion`), and the checker's SIGNATURE
 * walk this file's other two constructs already exercise (`func_type` fails to collect
 * `takes_handle`'s signature, HARD boundary). Calls are UNCOLORED (a plain `pub fn` may still CALL
 * an `unsafe fn`); what it may not do is NAME an unsafe type in its own parameter/return list,
 * which is exactly what this declaration attempts.
 *
 * @param h  a handle whose type this safe signature may not name
 * @return   never — the checker rejects this signature
 * @example expected diagnostic: `safe fn 'takes_handle' names unsafe type in its signature`
 */
pub fn takes_handle(h: LocalCString): u64 {
    h.len
}

if bad(1, 2) != probe() { exit(1) }
