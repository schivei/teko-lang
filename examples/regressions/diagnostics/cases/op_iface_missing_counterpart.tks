/** IHalf — an interface listing `__eq` without its mandated counterpart `__ne` (§9.4 D1). */
type IHalf = interface {
    /** __eq — equality, whose counterpart `__ne` this contract illegally omits. */
    operator __eq(left: self, right: self): bool
}
/** entry — the rejected construct's statement half. */
pub fn entry() { exit(0) }
