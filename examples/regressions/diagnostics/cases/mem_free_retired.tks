/** §6 REJECT: `teko::mem::free` was retired in 0.3.1 — the region drop reclaims the value. */
pub fn leaks(): i64 {
    mut xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 1)
    teko::mem::free(xs)
    0
}
/** entry — the rejected construct's statement half. */
pub fn entry() { (leaks()) to i32 }
