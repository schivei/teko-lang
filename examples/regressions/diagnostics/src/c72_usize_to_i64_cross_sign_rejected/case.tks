/**
 * REJECTED (§8 part 2): a `usize` (unsigned machine word) value assigned to an `i64` binding
 * WITHOUT a `to`. Same WIDTH, but opposite SIGN — a `usize` above `i64::MAX` would reinterpret as
 * negative — so this is NOT a lateral relabel (`same_word_lateral` pairs `usize` only with `u64`,
 * never with the signed `i64`/`size`). It demands an explicit `to`.
 *
 * @example expected diagnostic: `value type does not match annotation`
 */
pub fn entry() {
    var u: usize = 5000000000
    var s: i64 = u
    exit(1)
}
