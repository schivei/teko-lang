/**
 * Inner — the nested class whose field the rejected statement below reaches through its owner.
 */
type Inner = class {
    /** the flag the rejected statement below tries to write two levels deep. */
    pub v: bool
    /**
     * of — build the inner object.
     *
     * @return the new inner object
     */
    pub fn of(): Inner {
        Inner { v = true }
    }
}

/**
 * Outer — the owning class, one level above `Inner`.
 */
type Outer = class {
    /** the nested object the rejected statement below walks through. */
    pub inner: Inner
    /**
     * of — build the outer object.
     *
     * @return the new outer object
     */
    pub fn of(): Outer {
        Outer { inner = Inner::of() }
    }
}

/**
 * probe — a field write TWO levels below a `let` handle. The protection is not a first-field rule:
 * the guard walks the whole receiver chain `o.inner.v` back to its root `o`, so a `let` protects at
 * every depth. This shape compiled silently before the ruling.
 *
 * @return the nested flag as an integer, if this ever built
 */
pub fn probe(): i64 {
    var o = Outer::of()
    o.inner.v = false
    if o.inner.v { 1 } else { 0 }
}

/** entry — the rejected construct's statement half. */
pub fn entry() {
    (probe()) to i32
}
