// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: iface_value_struct_rejected
// expected diagnostic: 'a `struct` value cannot be used as the interface'
type Reader = interface {
    /**
     * read — the reader's value.
     *
     * @return  the stored value
     */
    fn read(self) -> i64
}
type SReader = struct Reader {
    /** The stored value. */
    v: i64

    /**
     * read — the `Reader` contract for the struct.
     *
     * @return  `self.v`
     */
    fn read(self) -> i64 { self.v }
}
pub fn pull(r: Reader) -> i64 {
    r.read()
}
pub fn scenario() -> i64 { pull(SReader { v = 7 }) }
/** entry — the rejected construct's statement half. */
pub fn entry() {
    exit(scenario())
}
