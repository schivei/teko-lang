/**
 * REJECTED (§8 part 2): a `usize` value assigned to a `u32` binding WITHOUT a `to`. `usize` is a
 * 64-bit machine word, so `usize -> u32` is a NARROWING that can drop bits — the lateral
 * exception (`same_word_lateral`) covers only the equal-width `u64`/`i64` partners, never a
 * narrower target, so this stays an honest stop demanding an explicit `to`.
 *
 * @example expected diagnostic: `value type does not match annotation`
 */
pub fn entry() {
    var wide: usize = 5000000000
    var narrow: u32 = wide
    exit(1)
}
