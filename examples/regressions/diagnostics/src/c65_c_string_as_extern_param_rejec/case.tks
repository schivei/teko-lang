/**
 * A LOCAL COPY of `teko::c_types::c_string` (c-types-and-marshalling-0.3.1.md §7.4, crumb C4) —
 * see `staged/c_types/c_types.tks` for the canonical original. A plain (post-§6, non-`unsafe`)
 * nominal struct carrying an opaque `uptr` address word.
 */
pub type LocalCString = struct {
    /** The base address of a NUL-terminated buffer, as an opaque `uptr`. */
    addr: uptr

    /** The payload length, excluding the terminator. */
    len: u64
}

/**
 * REJECTED: `c_string` (any nominal struct without an `ExternBody`) can NEVER be an extern
 * parameter — C7.1a's `extern_type_ok` admits a `Named` only when its declaration IS an
 * `extern type` handle. This pins §3/§7.1's forcing constraint so a later refactor cannot
 * quietly "enable" a struct crossing the boundary: the ONLY hop is the single word
 * `c_string_ptr`/`local_cstring_ptr` extracts, never the struct itself.
 *
 * @example expected diagnostic: an `extern` function parameter must be a primitive (int/float/
 *          bool), `byte`, `ptr`, `uptr`, or an `extern type` handle (C7.1a)
 */
pub extern fn c_takes_handle_directly(h: LocalCString): u64 = "some_c_fn"
