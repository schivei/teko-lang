// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: must_free_leak
// expected diagnostic: '`#must_free` value `h` is dropped without being freed on this path — c'
#must_free
pub type FileHandle = class {
    /** An opaque descriptor number (a stand-in for a real OS handle). */
    pub fd: i64

    /**
     * Opens a handle around the given descriptor number.
     *
     * @param fd the descriptor number to wrap
     * @return   the constructed handle
     */
    pub fn open(fd: i64): FileHandle {
        FileHandle { fd = fd }
    }
}
pub fn leaks_the_handle(): i64 {
    var h = FileHandle::open(1)
    1
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    (leaks_the_handle()) to i32
}
