// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: adopt_break_unknown_label
// expected diagnostic: '`break`/`continue` to an unknown loop label (no enclosing loop carries'
pub fn bad_label(): i64 {
    OUTER: loop {
        adopt {
            break NOSUCHLABEL
        }
        break OUTER
    }
    0
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    if bad_label() != 0 { exit(1) }
}
