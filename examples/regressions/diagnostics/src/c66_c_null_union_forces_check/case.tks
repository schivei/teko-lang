/**
 * `extern fn … -> ptr<byte> | null = "getenv"` (c-types-and-marshalling-0.3.1.md §5.4.1, crumb
 * C2b) — the before/after of [PIN-3]'s whole value: the checker FORCES a `match` before the
 * result is usable. See `q198_c_null_union_extern_return/body.tks` (bulk channel) for the ACCEPT
 * twin that matches both arms correctly.
 */
pub extern fn c_getenv_bare(name: ptr<byte>) -> ptr<byte> | null = "getenv"

/**
 * REJECTED: using `c_getenv_bare`'s result directly, as a bare `ptr<byte>`, WITHOUT matching the
 * `null` arm first — the identical shape `acquire_chunk`'s hand-written `demand(block != 0, 10)`
 * (`arena_bottom/src/bottom.tks:152-157`) had to enforce manually, now a compile error instead.
 *
 * @example expected diagnostic: `value type does not match annotation`
 */
pub fn dereference_without_check(name: ptr<byte>) -> u64 {
    let value: ptr<byte> = c_getenv_bare(name)
    teko::mem::bytes_from_ptr(value, 1).len
}
