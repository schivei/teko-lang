// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: adopt_break_outside_loop
// expected diagnostic: '`break`/`continue` outside a loop'
pub fn bad_break() -> i64 {
    adopt {
        break
    }
    0
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    if bad_break() != 0 { exit(1) }
}
