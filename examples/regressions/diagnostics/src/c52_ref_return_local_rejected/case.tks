/**
 * bad — the F1 diagnostics fixture `ref_return_local_rejected`. A `-> ref T` return is rejected
 * outright: return-by-reference was removed in 0.3.1 (§3), so `ref` survives parameter-only.
 * Expected diagnostic: "a function cannot return a reference (`ref T`) — return-by-reference was".
 *
 * @return a bare local reference — never reached; the declaration itself fails to compile
 */
fn bad() -> ref i64 {
    mut x: i64 = 5
    & x
}

/**
 * probe — calls the rejected `bad` so the diagnostic fires on a reachable call path.
 *
 * @return `bad()`'s value — never reached
 */
pub fn probe() -> i64 { bad() }

/** entry — the rejected construct's statement half. */
pub fn entry() {
    (probe()) to i32
}
