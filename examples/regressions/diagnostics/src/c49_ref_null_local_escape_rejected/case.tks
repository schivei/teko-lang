/**
 * leak — the F1 diagnostics fixture `ref_null_local_escape_rejected`. A `-> ref T | null` return
 * is rejected outright: return-by-reference was removed in 0.3.1 (§3), so `ref` survives
 * parameter-only, whether bare or wrapped in the `| null` absence union.
 * Expected diagnostic: "a function cannot return a reference (`ref T`) — return-by-reference was".
 *
 * @param p  the reference parameter the body would otherwise pass down
 * @return   the parameter reference widened to `| null` — never reached
 */
fn leak(ref p: i32) -> ref i32 | null {
    p
}

/**
 * leak_probe — the rejected construct's expression half.
 *
 * @return a constant placeholder — never reached
 */
pub fn leak_probe() -> i32 {
    mut x: i32 = 1
    0
}

/** entry — the rejected construct's statement half. */
pub fn entry() {
    exit(leak_probe())
}
