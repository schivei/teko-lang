/**
 * REJECTED (§8 part 2): a `size` (signed machine word) value assigned to a `u64` binding WITHOUT
 * a `to`. Same WIDTH, opposite SIGN — a negative `size` would reinterpret as a huge unsigned
 * value — so it is not a lateral relabel (`same_word_lateral` pairs `size` only with `i64`, never
 * with the unsigned `u64`/`usize`). It demands an explicit `to`.
 *
 * @example expected diagnostic: `value type does not match annotation`
 */
pub fn entry() {
    var s: size = -3000000000
    var u: u64 = s
    exit(1)
}
