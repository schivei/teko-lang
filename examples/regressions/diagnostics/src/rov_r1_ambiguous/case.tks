/**
 * g — the i32 overload of an ambiguous set (§9 A REJECT R1). Defining a same-named function is
 * ALWAYS allowed (ruling 1); only a call the argument types cannot disambiguate is rejected.
 *
 * @param x  an i32 value
 * @return   1
 */
pub fn g(x: i32): i64 { 1 }

/**
 * g — the u32 overload: same arity, a distinct parameter type, equally reachable from a bare integer
 * literal that adopts either width.
 *
 * @param x  a u32 value
 * @return   2
 */
pub fn g(x: u32): i64 { 2 }

/**
 * entry — the ambiguous call site: the literal `0` adopts i32 or u32 with NO exact match, so neither
 * overload is a unique best and the CALL is rejected (ruling 3) — never the two definitions.
 */
pub fn entry() { (g(0)) to i32 }
