/**
 * A LOCAL COPY of `teko::c_types::c_string` (c-types-and-marshalling-0.3.1.md §7.1, crumb C4) —
 * see `staged/c_types/c_types.tks` for the canonical original.
 */
pub unsafe type LocalCString = struct {
    /** The base address of a NUL-terminated buffer. */
    ptr: ptr<byte>

    /** The payload length, excluding the terminator. */
    len: u64
}

/**
 * A SAFE (non-`unsafe`) struct wrapping the unsafe-typed `LocalCString` through plain composition
 * — REJECTED by U2's field-contagion gate (`reject_unsafe_field_contagion`), the SAME gate
 * `c55_unsafe_field_in_safe_struct` pins, because a `c_string` field is nominally `unsafe` (§9.2:
 * an alias would have been silently inert here, which is why `c_string` is a nominal struct).
 *
 * @example expected diagnostic: `struct/class 'Wrapper' has an unsafe-typed field 'ha`
 */
pub type Wrapper = struct {
    /** The wrapped, unsafe-typed handle — the contagion violation. */
    handle: LocalCString
}
