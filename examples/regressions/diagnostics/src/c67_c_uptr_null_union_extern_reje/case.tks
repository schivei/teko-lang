/**
 * REJECTED: `extern fn … -> uptr | null` — pins §5.4.3's representational exclusion so nobody
 * later adds a fictional `Uptr` niche arm. `Uptr` has no spare bit-pattern (`0` is ordinary data
 * for an integer, not a hole), so it is NOT niche-able (`cg_type_is_niche_able` has no `Uptr`
 * arm) and `extern_null_union_ok` (this design's crumb C2b, checker-local mirror of the niche
 * predicate) admits ONLY `ptr<T> | null` — never `uptr | null`. Nullability at the C boundary is
 * spelled `ptr<T> | null`, always (the owner ruling this fixture is the negative half of).
 *
 * @example expected diagnostic: an `extern` function return must be a primitive (int/float/bool),
 *          `byte`, `ptr`, `uptr`, an `extern type` handle, or absent (C7.1a)
 */
pub extern fn c_region_new_or_null(): uptr | null = "some_c_allocator"
