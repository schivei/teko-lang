/**
 * Named — a class whose public field a `let` handle may READ but not WRITE.
 */
type Named = class {
    /** the field the rejected statement below tries to write from outside. */
    pub name: str
    /**
     * of — build a named object.
     *
     * @param n  the initial name
     * @return   the new object
     */
    pub fn of(n: str) -> Named {
        Named { name = n }
    }
}

/**
 * probe — a DIRECT field write through a `let` class handle. A class is a reference type, so this
 * write used to skip the mutable-root guard entirely and compile: `let` bit structs and was
 * transparent to classes. `let` now protects fields at every level, for classes exactly as for
 * structs — writing is the privilege of the declaring type's own methods.
 *
 * @return the name's length, if this ever built
 */
pub fn probe() -> i64 {
    let a = Named::of("a")
    a.name = "b"
    a.name.len to i64
}

/** entry — the rejected construct's statement half. */
pub fn entry() {
    (probe()) to i32
}
