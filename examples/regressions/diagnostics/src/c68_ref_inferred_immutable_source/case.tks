/**
 * Ch — the referent of the rejected reference binding below.
 */
type Ch = struct {
    /** the field the alias would have written through. */
    open: bool
}

/**
 * probe — an UN-ANNOTATED `ref r = c` over an IMMUTABLE `let` source. It used to compile into a
 * silent COPY: the reference-ness survived only inside a `Ref<>`-wrapped annotation, so with no
 * annotation the checker saw a plain `mut` binding, snapshotted `c`, and reported nothing at all.
 * The inferred path now takes the SAME mutable-source rule as `ref r: Ch = c` and stops honestly.
 *
 * @return the aliased flag as an integer, if this ever built
 */
pub fn probe(): i64 {
    var c = Ch { open = true }
    ref r = c
    if r.open { 1 } else { 0 }
}

/** entry — the rejected construct's statement half. */
pub fn entry() {
    (probe()) to i32
}
