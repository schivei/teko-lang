/**
 * A LOCAL COPY of `teko::c_types::c_int` (c-types-and-marshalling-0.3.1.md §5.1, crumb C1) — see
 * `src/c_types/c_types.tks` for the canonical original.
 */
pub type c_int = i32

/**
 * REJECTED: assigning an `i64` to a `c_int` binding without a cast. `type c_int = i32` is
 * TRANSPARENT (`resolve.tks:794`) — `c_int` IS `i32`, no wider and no narrower — so this proves
 * the alias carries no implicit widen of its own; the same rejection an `i64 -> i32` binding
 * would get on the bare primitive.
 *
 * @example expected diagnostic: `value type does not match annotation`
 */
pub fn entry() {
    let wide: i64 = 9000000000
    let narrow: c_int = wide
    exit(1)
}
