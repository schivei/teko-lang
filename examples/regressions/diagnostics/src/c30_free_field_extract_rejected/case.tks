// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: free_field_extract_rejected
// expected diagnostic: 'cannot free `obj` — it is aliased (another binding still holds it); `m'
type Bag = class {
    /** The owned heap buffer. */
    pub items: []i64

    /**
     * Builds a bag around a one-element buffer.
     *
     * @param seed the sole element
     * @return     the constructed bag
     */
    pub fn make(seed: i64): Bag {
        var xs: []i64 = teko::list::empty()
        xs = teko::list::push(xs, seed)
        Bag { items = xs }
    }
}
pub fn run(): i64 {
    var obj = Bag::make(7)
    var y = obj.items
    teko::mem::free(obj)
    y[0]
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    (run()) to i32
}
