/**
 * A LOCAL COPY of the U3 (`teko::mem::unsafe`, issue #334) `RawBuf` shape — the unsafe-typed
 * leaf this fixture's negative case wraps in a SAFE struct without the `unsafe` modifier
 * (AC#4). See `unsafe_rawbuf_roundtrip/src/rawbuf/rawbuf.tks` for the same shape's positive
 * (accepted) counterpart.
 */
pub unsafe type RawBuf = struct {
    /** The buffer's raw base address. */
    ptr: ptr<byte>

    /** The buffer's length in bytes. */
    len: u64
}

/**
 * A SAFE (non-`unsafe`) struct wrapping the unsafe-typed `RawBuf` through plain composition —
 * REJECTED by U2's field-contagion gate (`reject_unsafe_field_contagion`), since `Wrapper` does not
 * itself carry the `unsafe` modifier. This is the sole purpose of this fixture: the checker must
 * refuse to compile it (AC#4), never run.
 *
 * The rejection comes from `validate_type_decls`, a SOFT pre-walk pass: it validates an
 * already-complete type table and registers nothing, so it collects this diagnostic and the build
 * carries on to report every other declaration's too (issue #68). That is why this case is a
 * NAMESPACE of the shared failing build rather than a `cases/*.tks` paying for its own.
 *
 * @example expected diagnostic: `struct/class 'Wrapper' has an unsafe-typed field 'bu`
 */
pub type Wrapper = struct {
    /** The wrapped, unsafe-typed buffer — the contagion violation. */
    buf: RawBuf
}
