// F1 diagnostics — folded EXPECT_COMPILE_FAIL single-file fixtures (dobrado, dir removido)
// case: free_aliased_rejected
// expected diagnostic: 'cannot free `xs` — it is aliased (another binding still holds it); `me'
pub fn run(): i64 {
    var xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 10)
    xs = teko::list::push(xs, 20)
    var y = xs
    teko::mem::free(xs)
    y[0]
}
/** entry — the rejected construct's statement half. */
pub fn entry() {
    (run()) to i32
