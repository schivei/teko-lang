/**
 * h — the `str` overload of a set no integer argument fits (§9 A REJECT R3). Defining the overloads
 * is always allowed (ruling 1).
 *
 * @param x  a string value
 * @return   1
 */
pub fn h(x: str): i64 { 1 }

/**
 * h — the `bool` overload: the other member of the set, equally unreachable from an integer.
 *
 * @param x  a bool value
 * @return   2
 */
pub fn h(x: bool): i64 { 2 }

/**
 * entry — the call `h(3)`: the integer literal fits neither `str` nor `bool`, so no overload matches
 * and the call is rejected at the call site.
 */
pub fn entry() { (h(3)) to i32 }
