/**
 * Arena — a standalone copy of the stdlib `teko::mem::unsafe::Arena` shape: a `#must_free`
 * single-`uptr`-field handle. `checker::is_region_handle_name` routes `teko::mem::free` on it to the
 * bulk-drop `tk_region_drop_subtree` arm (a fixture is its own project and cannot `use` the
 * compiler's own stdlib, so the shape is copied).
 */
#must_free
pub unsafe type Arena = struct {
    /** the raw `tk_region *` this handle owns, carried as an opaque `uptr`; 0 once bulk-freed. */
    region: uptr
}

/**
 * run — open an `Arena` over a fresh manual region, then `teko::mem::free` it: the native
 * region-handle arm lowers to `tk_region_drop_subtree(a.region)` plus a scrub of the field to 0.
 * Reaching the second print proves the free lowered and ran (not the undefined
 * `teko_teko__mem__free` symbol).
 *
 * @return void
 */
pub unsafe fn run() {
    mut a = Arena { region = teko::mem::region_new() }
    teko::io::println("arena opened")
    teko::mem::free(a)
    teko::io::println("arena freed")
}
