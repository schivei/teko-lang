/** A7 — one trait providing `k`. */
type A7 = trait {
    /** k — one body. @return 1 */
    fn k(): i64 { 1 }
}
/** B7 — another trait providing a DIFFERENT `k`. */
type B7 = trait {
    /** k — a different body. @return 2 */
    fn k(): i64 { 2 }
}
/** H7 — REJECTED: composes two traits whose `k` bodies differ (§9.4 no absorb). */
type H7 = struct A7 & B7 { }
