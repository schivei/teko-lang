/**
 * opaque_zero — zero with no literal form, produced by a mutable variable, so `teko::one_byte`'s
 * argument reaches lowering as a COMPUTED value rather than being comptime-folded away.
 *
 * @return 0, with no literal form
 */
fn opaque_zero() -> u64 {
    mut n: u64 = 1
    n = n - 1
    n
}

/**
 * shift — the byte `b` shifted by `off` positions, through `u64`, so the result is born of a sum and
 * not a literal.
 *
 * @param b    the starting byte
 * @param off  the offset to add (always `opaque_zero()` here)
 * @return     the shifted byte
 */
fn shift(b: byte, off: u64) -> byte {
    ((b to u64) + off) to byte
}

/**
 * single_byte_weight — the minimal case: ONE `teko::one_byte` call read back by length and content.
 *
 * @param off  the fold-opaque offset
 * @return     3 when the one-byte `str` has length 1 and content `A`, else 0
 */
fn single_byte_weight(off: u64) -> i64 {
    let s = teko::one_byte(shift(b'A', off))
    if s.len != 1 { return 0 }
    if s[0] != b'A' { return 0 }
    3
}

/**
 * escape_accum_weight — the exact shape of `teko::encoding::json::parse_string`: a `str` accumulated
 * one `teko::one_byte` at a time.
 *
 * @param off  the fold-opaque offset
 * @return     12 when the three escape bytes come out in order and value, else 0
 */
fn escape_accum_weight(off: u64) -> i64 {
    mut out = ""
    out = out ~ teko::one_byte(shift(b'"', off))
    out = out ~ teko::one_byte(shift(b'\\', off))
    out = out ~ teko::one_byte(shift(0x0C to byte, off))
    if out.len != 3 { return 0 }
    if out[0] != b'"' { return 0 }
    if out[1] != b'\\' { return 0 }
    if out[2] != (0x0C to byte) { return 0 }
    12
}

/**
 * utf8_pair_weight — two `teko::one_byte` results joined in the SAME expression, the two-byte pair of
 * a UTF-8 code point (U+00E9).
 *
 * @param off  the fold-opaque offset
 * @return     16 when the pair has length 2 and the two right bytes, else 0
 */
fn utf8_pair_weight(off: u64) -> i64 {
    let two = teko::one_byte(shift(0xC3 to byte, off)) ~ teko::one_byte(shift(0xA9 to byte, off))
    if two.len != 2 { return 0 }
    if two[0] != (0xC3 to byte) { return 0 }
    if two[1] != (0xA9 to byte) { return 0 }
    16
}

/**
 * from_slice_weight — `teko::one_byte`'s argument comes from a slice INDEX inside a loop, so the byte
 * arrives in a register loaded from memory.
 *
 * @param off  the fold-opaque offset
 * @return     32 when the two slice bytes reconstruct in the accumulated `str`, else 0
 */
fn from_slice_weight(off: u64) -> i64 {
    mut src: []byte = teko::list::empty()
    src = teko::list::push(src, shift(b'n', off))
    src = teko::list::push(src, shift(b'l', off))
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= src.len { break }
        out = out ~ teko::one_byte(src[i])
        i++
    }
    if out.len != 2 { return 0 }
    if out[0] != b'n' { return 0 }
    if out[1] != b'l' { return 0 }
    32
}

/**
 * two_live_weight — TWO one-byte `str`s live at once, each read after the other was produced, so a
 * shared length slot or result register would let the first read the second's value.
 *
 * @param off  the fold-opaque offset
 * @return     64 when both values keep their own byte and length, else 0
 */
fn two_live_weight(off: u64) -> i64 {
    let a = teko::one_byte(shift(b'a', off))
    let b = teko::one_byte(shift(b'z', off))
    if a[0] != b'a' { return 0 }
    if b[0] != b'z' { return 0 }
    if a.len != 1 { return 0 }
    if b.len != 1 { return 0 }
    64
}

/**
 * nul_byte_weight — `teko::one_byte(0)`: the one-byte NUL `str`, whose length is the 1 the runtime
 * returns through the out-slot, not the 0 a NUL-terminated read would give.
 *
 * @param off  the fold-opaque offset
 * @return     128 when the `str` has length 1 and byte 0, else 0
 */
fn nul_byte_weight(off: u64) -> i64 {
    let s = teko::one_byte(shift(0 to byte, off))
    if s.len != 1 { return 0 }
    if s[0] != (0 to byte) { return 0 }
    128
}

/**
 * score — the sum of the six disjoint weights, 255 when all pass; no partial sum reaches 255.
 *
 * @return 255 when `one_byte`'s lowering is correct in all six shapes
 */
fn score() -> i64 {
    let off = opaque_zero()
    single_byte_weight(off) + escape_accum_weight(off) + utf8_pair_weight(off) + from_slice_weight(off) + two_live_weight(off) + nul_byte_weight(off)
}

println(teko::i64_to_str(score()))
