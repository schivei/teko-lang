/**
 * Animal_sbmd — a virtual base whose `speak` returns a fat (`str`) result, the shape whose
 * interface-dispatch lowering the native backend does not yet have.
 */
type Animal_sbmd = virtual class {
    /** the animal's name. */
    pub name: str
    /**
     * speak — the virtual, `str`-returning method whose vtable-dispatched fat result stops lowering.
     *
     * @param self  the receiver
     * @return      the default greeting
     */
    pub virtual fn speak(): str { "..." }
}

/**
 * Dog_sbmd — a derived class overriding `speak`, so a base-typed handle dispatches to the override.
 */
type Dog_sbmd = class Animal_sbmd {
    /**
     * make — construct a `Dog_sbmd` with a name.
     *
     * @param n  the name
     * @return   the dog
     */
    pub fn make(n: str): Dog_sbmd { Dog_sbmd { name = n } }
    /**
     * speak — the override whose `str` result is dispatched through the base's vtable.
     *
     * @param self  the receiver
     * @return      "Woof"
     */
    pub override fn speak(): str { "Woof" }
}

/**
 * speak_or — the failing surface: a `str`-valued VIRTUAL call inside a match arm.
 *
 * @param a         the animal, present or absent
 * @param fallback  the greeting returned when absent
 * @return          the greeting or `fallback`
 */
fn speak_or(a: Animal_sbmd | null, fallback: str): str {
    match a { Animal_sbmd as v => v.speak(); null => fallback }
}

/**
 * probe — both placements: a derived instance widened to its base, and the absent one.
 *
 * @return 42 the day the fat interface-dispatch result lowers
 */
fn probe(): u64 {
    var present: Animal_sbmd | null = Dog_sbmd::make("Rex")
    var absent: Animal_sbmd | null = null
    var r1 = speak_or(present, "?")
    var r2 = speak_or(absent, "?")
    if r1 == "Woof" && r2 == "?" { 42 to u64 } else { 1 to u64 }
}

exit(probe())
