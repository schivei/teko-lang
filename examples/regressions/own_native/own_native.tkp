# own_native.tkp — the OWN-BACKEND CORPUS channel: one project, one program, one build per target.
#
# The 0.3.1 channel ruling (owner 2026-07-26) says a variation in SOURCE needs a separate FILE inside
# one project, and only a variation in BUILD CONFIGURATION earns a separate build. This project is the
# other half of that rule: its source never varies, its TARGET does. The same program is built for the
# host and for the cross targets that still exist, one `.tkr` per configuration that needs its own
# build, and every scenario of a configuration runs off that configuration's ONE build.
#
# It carries the corpus the retired `scripts/diff_c_own.sh` drove (F2/F5/F9 of regressor.tkr). The C
# emitter is gone, so no scenario here differs against a second backend: each asserts its own
# exit/stdout, and a cross row additionally asserts that the EMITTED OBJECT is well-formed for the
# target it named. A configuration whose target the compiler no longer has left with it.
name = "own_native"
source = "src"

[artifact]
kind = "binary"
