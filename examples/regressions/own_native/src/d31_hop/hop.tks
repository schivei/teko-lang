use own_native::d31_reg

/**
 * HopTbl — an alias of an alias, and BOTH links are QUALIFIED: `d31_hop::HopTbl` resolves to
 * `d31_reg::Tbl` which resolves to `[]Reg`. Proves the fat walk keeps chasing the chain across
 * namespace hops instead of stopping at the first qualified link (0.3.1.0 degrau 31).
 */
pub type HopTbl = d31_reg::Tbl

/**
 * HopText — the `str` twin of `HopTbl`: a two-hop, twice-qualified alias chain ending in the other
 * fat builtin.
 */
pub type HopText = d31_reg::Text
