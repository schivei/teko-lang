/**
 * Thing — the OTHER same-bare-name public type (coexists with `aa::Thing` via the #109 canonical
 * type table: distinct `tk_t_` typedefs, distinct identities).
 */
pub type Thing = struct {
    /** the payload value under test, distinct from `aa::Thing`'s own `v`. */
    w: i64
}

/**
 * Widget — a distinct-bare-name type used in OPTIONAL position from THIS namespace too (its
 * canonical name is `own_native::bb::Widget` — the `tk_opt_` mangle must stay a valid C
 * identifier).
 */
pub type Widget = struct {
    /** the payload value under test. */
    k: i64
}

/**
 * make — build a `bb::Thing` over the base value `x`, exercising plain same-bare-name coexistence.
 *
 * @param x  the payload value
 * @return   `Thing { w = x }`
 */
pub fn make(x: i64) -> Thing {
    Thing { w = x }
}

/**
 * spot — the optional former over `Widget`.
 *
 * @param x  the candidate value; positive values produce a `Widget` with `k = x * 2`
 * @return   `Widget { k = x * 2 }` when `x > 0`, else `null`
 */
pub fn spot(x: i64) -> Widget | null {
    if x > 0 { Widget { k = x * 2 } } else { null }
}
