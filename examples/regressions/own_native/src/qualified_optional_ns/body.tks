use aa
use bb

/**
 * scenario — the `qualified_optional` regression (issues #109/#149): same-bare-name types
 * (`aa::Thing` / `bb::Thing`) coexisting across namespaces in OPTIONAL and NAMED-VARIANT position.
 * Each namespace's canonical optional/tag emission must stay distinct; with one namespace the two
 * same-bare types would simply collide.
 *
 * The result is the sum of five independent readings, so a regression names the shape that broke:
 * 5 from `aa::find`, 6 from `bb::spot` (k = 3 * 2), 4 from `bb::make` (plain coexistence), 4 from
 * the `aa::pick` success arm and 3 from its error arm — 22 in total.
 *
 * Migrated here from `bulk`'s `p_qualified_optional` (cargo/0.3.1-dissolver-bulk, 2026-07-29): the
 * scenario needs its own member namespaces (`aa`/`bb`), which `bulk` used to host as directories of
 * one shared build — this project's `src/` can host them exactly the same way.
 *
 * @return the sum of the five readings (22 on success)
 */
pub fn scenario() -> i64 {
    mut total: i64 = 0
    match aa::find(5) { aa::Thing as t => total = total + t.v; null => total = total + 100 }
    match bb::spot(3) { bb::Widget as g => total = total + g.k; null => total = total + 100 }
    let b = bb::make(4)
    total = total + b.w
    match aa::pick(4) { aa::Thing as t => total = total + t.v; error => total = total + 100 }
    match aa::pick(0) { aa::Thing => total = total + 100; error => total = total + 3 }
    total
}
