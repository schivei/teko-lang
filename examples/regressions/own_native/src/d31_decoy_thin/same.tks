/**
 * Same — the THIN half of the same-bare-name decoy pair. Bears the SAME bare name as
 * `d31_decoy_fat::Same` and is deliberately NOT fat: a parameter annotated `d31_decoy_thin::Same`
 * must be bound as a scalar even though a same-bare cousin one namespace over is a slice alias
 * (0.3.1.0 degrau 31, the inversion half).
 */
pub type Same = struct {
    /** the first scalar member */
    x: i64
    /** the second scalar member */
    y: i64
}
