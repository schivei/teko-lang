/**
 * host_ffi — the own-native probe for the aggregate-returning host FFI (0.3.1.0 degrau 34/35),
 * folded into the umbrella own-native project so it costs no extra build (owner ruling: reuse an
 * existing regression project, never a new `.tkp`).
 *
 * WHAT IT PINS. `teko::env::var`/`env::cwd`/`io::read_file`/`fs::list_dir` each return a struct
 * wider than one register (`tk_ffi_sres` is 40 bytes → SysV MEMORY class → SRET; `tk_ffi_slres`
 * likewise), and the native backend's `LCall` captures ONE result register — so the generic call
 * path handed the callee no SRET pointer and it wrote its result over garbage (measured: gen2
 * SIGSEGV'd in `tk_rt_getenv` at startup). The fix routes each to an own-register `tk_rt_*_ok` twin
 * (`teko_rt.{c,h}`) carrying the ok/err flag as a single-register `bool` and the active case's
 * `(ptr, len)` through two out-parameters. This standalone project reaches the surface through the
 * checker's host-surface builtins (`builtin_hostffi_variant_symbol`), the SAME twin lowering the
 * compiler's own `extern fn` declarations take.
 */

/**
 * score — exercise every Variant-returning host FFI shape and return a disjoint weighted sum, so a
 * mis-marshalled `(ptr, len)` in any single arm moves the number instead of passing. `read_file`/
 * `env::var`/`list_dir` take their ERROR arm and each compares the runtime's exact failure message
 * (a wrong out-slot pointer or length fails the compare and drops the weight); `env::cwd` takes its
 * SUCCESS arm (the working directory's `str` value marshals back through the same out-slots).
 *
 * @return  60 (4 + 8 + 16 + 32) when every shape marshals correctly
 */
pub fn score(): i64 {
    var s: i64 = 0
    match teko::io::read_file("definitely-absent-ffi-probe.xyz") {
        str => { }
        error as e => if e.message == "cannot open file" { s = s + 4 }
    }
    match teko::env::var("TEKO_HOST_FFI_DEFINITELY_UNSET") {
        str => { }
        error as e => if e.message == "environment variable not set" { s = s + 8 }
    }
    match teko::fs::list_dir("definitely-absent-ffi-dir") {
        []str => { }
        error as e => if e.message == "cannot open directory" { s = s + 16 }
    }
    match teko::env::cwd() {
        str as c => if c.len > 0 { s = s + 32 }
        error => { }
    }
    s
}

/**
 * error_union_score — exercise the `null | error` (0.3.1 `Variant{Null,Error}`) host FFI shapes
 * through the SAME no-`use`-import fallback path `score()` above exercises for the `str | error`
 * shapes: `teko::checker::host_error_optional` (`src/checker/scope.tks`), consulted only when no
 * local extern declaration for the callee is in scope (the compiler's own project always resolves
 * through its discovered externs first — `scope.tks` doc-comment). This is the O2 crumb of the
 * `checker::Optional` retirement (`docs/design/retirar-optional-para-null-union-uptr-0.3.1.md`
 * §3.1): `host_error_optional` used to return `Optional{Error}`, now `Variant{Null,Error}`. `mkdir`/
 * `write_file` each take BOTH arms — the SUCCESS (`null`) arm on a fresh path this probe owns, the
 * FAILURE (`error`) arm on a path whose parent directory does not exist, each comparing the
 * runtime's exact failure message — so a mis-migrated fallback return moves this number instead of
 * passing quietly. `remove_file` cleans up what this probe created (its own success arm), leaving
 * no debris.
 *
 * @return  63 (1 + 2 + 4 + 8 + 16 + 32) when every arm marshals and narrows correctly
 * @since 0.3.1 (retire-Optional O2)
 */
pub fn error_union_score(): i64 {
    var s: i64 = 0
    match teko::fs::mkdir("host_ffi_error_union_probe_dir") {
        null => { s = s + 1 }
        error => { }
    }
    match teko::fs::mkdir("host_ffi_error_union_probe_dir/definitely-absent-parent/leaf") {
        null => { }
        error as e => if e.message == "cannot create directory" { s = s + 2 }
    }
    match teko::io::write_file("host_ffi_error_union_probe_dir/probe.txt", "retire-optional O2") {
        null => { s = s + 4 }
        error => { }
    }
    match teko::io::write_file("definitely-absent-ffi-dir/probe.txt", "unreachable") {
        null => { }
        error as e => if e.message == "cannot open file for writing" { s = s + 8 }
    }
    match teko::fs::remove_file("host_ffi_error_union_probe_dir/probe.txt") {
        null => { s = s + 16 }
        error => { }
    }
    match teko::fs::remove_file("host_ffi_error_union_probe_dir") {
        null => { s = s + 32 }
        error => { }
    }
    s
}
