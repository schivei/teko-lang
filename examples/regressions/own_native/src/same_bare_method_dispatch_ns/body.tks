use sbmd_left
use sbmd_right

/**
 * scenario — the `same_bare_method_dispatch` regression (issue #290): classes sharing the SAME
 * bare name `Svc` across three namespaces (`sbmd_left`, `sbmd_right` and the sorted-first
 * `aaa_decoy` poison decoy, which is never referenced here — only its presence in the build
 * matters). An INSTANCE method call must dispatch to the canonically-namespaced class, never to a
 * readdir-order same-bare collision.
 *
 * Migrated here from `bulk`'s `p_same_bare_method_dispatch` (cargo/0.3.1-dissolver-bulk,
 * 2026-07-29): the scenario needs its own member namespaces (`sbmd_left`/`sbmd_right`), which
 * `bulk` used to host as directories of one shared build — this project's `src/` can host them
 * exactly the same way.
 *
 * @return the sum of the two dispatched tags (10 on success)
 */
pub fn scenario(): i64 {
    var l = sbmd_left::Svc::make(3).tag_of()
    if l != 3 { return -1 }
    var r = sbmd_right::Svc::make(7).tag_of()
    if r != 7 { return -1 }
    l + r
}
