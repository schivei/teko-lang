/**
 * Thing — same bare name as `bb::Thing` (the #109 cross-namespace coexistence). Its canonical
 * `Named.name` is `own_native::aa::Thing`; used in OPTIONAL position (`tk_opt_` path) and as a
 * member of the named variant `Res` (`tk_tag_`/`TK_TAG_` paths) — the three #149 emission sites.
 */
pub type Thing = struct {
    /** the payload value under test. */
    v: i64
}

/**
 * Res — a NAMED VARIANT whose tag enum typedef carries the canonical decl name (collapsed), and
 * whose constants carry the BARE name: `typedef enum tk_tag_…__aa__Res { TK_TAG_RES_THING,
 * TK_TAG_RES_ERROR }`.
 */
pub type Res = Thing | error

/**
 * find — the optional former over a canonical `Named` (the original `::`-leak site).
 *
 * @param x  the candidate value; positive values produce a `Thing`
 * @return   `Thing { v = x }` when `x > 0`, else `null`
 */
pub fn find(x: i64): Thing | null {
    if x > 0 { Thing { v = x } } else { null }
}

/**
 * pick — a fallible pick; `match` over `Res` exercises the `TK_TAG_` constant-reference prefix.
 *
 * @param ok  the candidate value; positive values succeed
 * @return    `Thing { v = ok }` when `ok > 0`, else an `error`
 */
pub fn pick(ok: i64): Res {
    if ok > 0 { Thing { v = ok } } else { error { message = "empty pick" } }
}

/**
 * ck1_ns_probe — a function whose BARE name `ck1_ns_probe` is shared with `bb::ck1_ns_probe`, so a
 * qualified call `aa::ck1_ns_probe(...)` proves `lookup_call`/`call_ns` resolve the base hash-index
 * bucket for this name through the `call_binding_matches` namespace predicate (CK1.2, design
 * docs/design/ck1-scoped-hash-maps-0.3.1.md §8). The `aa` arm adds 1.
 *
 * @param x  the probe input
 * @return   `x + 1` — distinct from the `bb` arm, so a wrong-namespace pick would be observable
 */
pub fn ck1_ns_probe(x: i64): i64 {
    x + 1
}
