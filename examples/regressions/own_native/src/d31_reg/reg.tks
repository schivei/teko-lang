/**
 * Reg — a two-field record with a FAT first member, so a `[]Reg` element's stride and a `Reg`
 * value's own layout both exercise the 16-byte `{ptr, len}` image the qualified-alias probes read
 * back (0.3.1.0 degrau 31).
 */
pub type Reg = struct {
    /** the entry's name — the fat member */
    name: str
    /** a scalar following the fat member, so a bad fat width shifts THIS field's offset */
    tag: i64
}

/**
 * Tbl — a `pub` alias of a SLICE, declared in a namespace so every reference to it from another
 * namespace is necessarily a QUALIFIED path. This is the shape the self-host's own
 * `checker::TypeTable` has, and the shape that made `typeexpr_is_fat_named` give up (degrau 31).
 */
pub type Tbl = []Reg

/**
 * Text — a `pub` alias of `str`, the other fat builtin, declared in the same namespace for the same
 * reason: reached from elsewhere it can only be spelled qualified.
 */
pub type Text = str
