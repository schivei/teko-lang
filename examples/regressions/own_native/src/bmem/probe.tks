/**
 * bmem — the 0.3.1 backend-memoria regression probes: programs whose CORRECT run proves the fused
 * per-function native emit (`encode_module_fused_x86`, project.tks) emits every function correctly
 * while scoping each function's isel/regalloc/encode scratch to its own region and dropping it after
 * folding. Each probe returns `true` on success; `main.tks` names it through `scenario_true`, and
 * `own_native.tkr` demands the matching `scenario <name>: ok` line on STDOUT.
 *
 * The whole own-native corpus is compiled through the fused loop, so these probes ride the SAME
 * per-function scoping as every other function here; they add the SHAPES §8 of the design names —
 * two functions, a call chain, 64+ small functions, shared rodata, a loop-carried value — each with
 * a known result no partial fold can reach by accident.
 *
 * (0.3.1 C6.3, `docs/design/native-lowering-oom-por-funcao-0.3.1.md`) `bmem_lambda`/
 * `bmem_lambdas_many` extend this family to the LOWERING fusion: every `fn` in this project is now
 * lowered AND encoded inside its OWN scoped region (not just encoded, Tier 1's scope), so a lifted
 * closure's thunk id has to be reserved from the RUNNING whole-program count threaded across item
 * windows (E5) rather than reset per item — and `bmem_rodata_shared` above already exercises E4 the
 * same way, since `bm_lit_a`/`bm_lit_b` are two DIFFERENT items whose shared literal must dedup
 * across their two region drops. Volume (hundreds of items, at self-host scale) is the FIXPOINT
 * ritual's job (§7/§8 `lmem_fixpoint`), not this project's — these probes prove the invariant holds
 * ACROSS item boundaries, which is the part a single-item program cannot exercise at all.
 *
 * @since 0.3.1
 */

/**
 * opaque_zero — zero with NO literal form, so a probe's arithmetic is not comptime-folded away
 * before the native lowering sees the call (the same fold-opacity mould `own_arith_exit` uses).
 *
 * @return  0, produced through a mutable local
 */
fn opaque_zero(): i64 {
    var n: i64 = 1
    n = n - 1
    n
}

/**
 * bm_a — the first of two trivial functions bmem_two_fns sums, offset by the fold-opaque `o` so the
 * call survives to the native backend as a real function call.
 *
 * @param o  the fold-opaque zero offset
 * @return   3 + o
 */
fn bm_a(o: i64): i64 { 3 + o }

/**
 * bm_b — the second of the two functions bmem_two_fns sums.
 *
 * @param o  the fold-opaque zero offset
 * @return   4 + o
 */
fn bm_b(o: i64): i64 { 4 + o }

/**
 * bmem_two_fns — TWO functions each emitted through their own scratch region, summed. Proves the
 * fused loop folds both functions' bytes and per-function symbols into the root accumulators
 * correctly (§8 bmem_two_fns).
 *
 * @return  true when bm_a + bm_b totals the known 7
 */
pub fn bmem_two_fns(): bool {
    var o = opaque_zero()
    bm_a(o) + bm_b(o) == 7
}

/**
 * bm_g — the callee at the bottom of the call chain (bmem_call_chain): a `call` relocation from
 * bm_f targets this function's symbol, so its `str` name must survive the caller's region drop (E1).
 *
 * @param x  the incoming value
 * @return   x + 1
 */
fn bm_g(x: i64): i64 { x + 1 }

/**
 * bm_f — the middle of the call chain: calls bm_g, so bm_f's encoded relocs reference bm_g across a
 * function boundary, and the module reloc rebase by `.text` base must stay correct between functions.
 *
 * @param x  the incoming value
 * @return   bm_g(x) + 10
 */
fn bm_f(x: i64): i64 { bm_g(x) + 10 }

/**
 * bmem_call_chain — `bmem_call_chain` → bm_f → bm_g, a call reloc that crosses functions. Proves
 * `RelocX86.sym` (E1) survives the per-function region drop and the `.text` rebase is correct
 * between functions (§8 bmem_call_chain).
 *
 * @return  true when the chained result is the known 11
 */
pub fn bmem_call_chain(): bool {
    bm_f(opaque_zero()) == 11
}

/**
 * bm_s00 — one of the 64 small functions bmem_many_small sums, each emitted through its own scratch
 * region so the fused loop drops ~64 regions for this family alone (obs "regions ≈ functions").
 *
 * @param o  the fold-opaque zero offset
 * @return   0 + o
 */
fn bm_s00(o: i64): i64 { 0 + o }

