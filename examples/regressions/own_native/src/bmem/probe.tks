/**
 * bmem_many_small — sum 64 small functions (bm_s00..bm_s63), each of which the fused loop encodes in
 * its OWN scratch region. Proves no cross-function name/byte leak across 64+ region drops and that
 * the count of dropped regions tracks the count of functions (§8 bmem_many_small).
 *
 * @return  true when the 64 functions total the known 2016
 */
pub fn bmem_many_small(): bool {
    var o = opaque_zero()
    bm_s00(o) + bm_s01(o) + bm_s02(o) + bm_s03(o) + bm_s04(o) + bm_s05(o) + bm_s06(o) + bm_s07(o) + bm_s08(o) + bm_s09(o) + bm_s10(o) + bm_s11(o) + bm_s12(o) + bm_s13(o) + bm_s14(o) + bm_s15(o) + bm_s16(o) + bm_s17(o) + bm_s18(o) + bm_s19(o) + bm_s20(o) + bm_s21(o) + bm_s22(o) + bm_s23(o) + bm_s24(o) + bm_s25(o) + bm_s26(o) + bm_s27(o) + bm_s28(o) + bm_s29(o) + bm_s30(o) + bm_s31(o) + bm_s32(o) + bm_s33(o) + bm_s34(o) + bm_s35(o) + bm_s36(o) + bm_s37(o) + bm_s38(o) + bm_s39(o) + bm_s40(o) + bm_s41(o) + bm_s42(o) + bm_s43(o) + bm_s44(o) + bm_s45(o) + bm_s46(o) + bm_s47(o) + bm_s48(o) + bm_s49(o) + bm_s50(o) + bm_s51(o) + bm_s52(o) + bm_s53(o) + bm_s54(o) + bm_s55(o) + bm_s56(o) + bm_s57(o) + bm_s58(o) + bm_s59(o) + bm_s60(o) + bm_s61(o) + bm_s62(o) + bm_s63(o) == 2016
}

/**
 * bm_lit_a — a function returning a string LITERAL that lives in `.rodata` (Group B), shared with
 * bm_lit_b. The rodata is carried by-reference through the whole pipeline and NEVER enters a scratch
 * region (§2 exception E2).
 *
 * @return  the shared rodata literal
 */
fn bm_lit_a(): str { "bmem_shared_rodata_literal" }

/**
 * bm_lit_b — a second function returning the SAME string literal as bm_lit_a, so both reference the
 * shared rodata datum.
 *
 * @return  the shared rodata literal
 */
fn bm_lit_b(): str { "bmem_shared_rodata_literal" }

/**
 * bmem_rodata_shared — two functions returning the SAME string literal. Proves rodata stays in
 * Group B (loaded by-reference, never in a scratch region) and its sharing survives the per-function
 * scoping (§8 bmem_rodata_shared).
 *
 * @return  true when both functions yield equal, correctly-sized rodata
 */
pub fn bmem_rodata_shared(): bool {
    var a = bm_lit_a()
    var b = bm_lit_b()
    a == b && a.len == (26 to u64)
}

/**
 * bmem_loop_fn — a function with a `loop` and a loop-carried accumulator, whose regalloc builds the
 * largest per-function scratch (the interval set across the back-edge). Proves that scratch is
 * scoped-and-dropped without altering the emitted bytes or the computed value (§8 bmem_loop_fn).
 *
 * @return  true when the loop sums 0..9 to the known 45
 */
pub fn bmem_loop_fn(): bool {
    var o = opaque_zero()
    var acc: i64 = 0
    var i: i64 = 0
    loop {
        if i >= 10 { break }
        acc = acc + i + o
        i = i + 1
    }
    acc == 45
}

/**
 * bm_close_a — a closure over `base`, created and lifted inside its OWN item (function). Its
 * lifted thunk's id is reserved from the whole-program running count (E5), not from a per-item
 * count reset to zero — `bmem_lambda` calls the returned closure from a DIFFERENT item than this
 * one, so a wrong id would either call the wrong thunk (a wrong result) or collide with another
 * item's thunk symbol (a duplicate-symbol link failure).
 *
 * @param base  the value the returned closure adds to its argument
 * @return      a closure carrying `base`
 */
fn bm_close_a(base: i64): (i64): i64 {
    (n: i64) => { base + n }
}

/**
 * bmem_lambda — ONE lifted closure, created in `bm_close_a`'s own scoped region and called from a
 * different item's. Proves the lifted thunk's symbol survives its OWNING item's region drop and the
 * caller's `LCallIndirect` resolves it correctly (E5, §8 `lmem_lambda`).
 *
 * @return  true when the closure applied to 4 yields the known 7
 */
pub fn bmem_lambda(): bool {
    var f = bm_close_a(3)
    f(4) == 7
}

/**
 * bm_close_b — one of several closure-creating functions `bmem_lambdas_many` calls, each its OWN
 * item, so their lifted thunks' ids are reserved from DIFFERENT points of the running whole-program
 * count. Preceded in this file by `bmem_lambda` above and `bm_close_a`, both of which already
 * contributed lifted functions, so this family's ids start mid-count rather than at zero — the id
 * threading has to survive items that came before it, not just count its own siblings.
 *
 * @param base  the value the returned closure adds to its argument
 * @return      a closure carrying `base`
 */
fn bm_close_b(base: i64): (i64): i64 {
    (n: i64) => { base + n }
}

/**
 * bm_close_c — see `bm_close_b`; a second closure-creating item, its own lifted thunk id one past
 * `bm_close_b`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 2
 * @return      a closure carrying `base`
 */
fn bm_close_c(base: i64): (i64): i64 {
    (n: i64) => { base + n * 2 }
}

/**
 * bm_close_d — see `bm_close_b`; a third closure-creating item, its own lifted thunk id one past
 * `bm_close_c`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 3
 * @return      a closure carrying `base`
 */
fn bm_close_d(base: i64): (i64): i64 {
    (n: i64) => { base + n * 3 }
}

/**
 * bm_close_e — see `bm_close_b`; a fourth closure-creating item, its own lifted thunk id one past
 * `bm_close_d`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 4
 * @return      a closure carrying `base`
 */
fn bm_close_e(base: i64): (i64): i64 {
    (n: i64) => { base + n * 4 }
}

/**
 * bm_close_f — see `bm_close_b`; a fifth closure-creating item, its own lifted thunk id one past
 * `bm_close_e`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 5
 * @return      a closure carrying `base`
 */
fn bm_close_f(base: i64): (i64): i64 {
    (n: i64) => { base + n * 5 }
}

/**
 * bm_close_g — see `bm_close_b`; a sixth closure-creating item, its own lifted thunk id one past
 * `bm_close_f`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 6
 * @return      a closure carrying `base`
 */
fn bm_close_g(base: i64): (i64): i64 {
    (n: i64) => { base + n * 6 }
}

/**
 * bm_close_h — see `bm_close_b`; a seventh closure-creating item, its own lifted thunk id one past
 * `bm_close_g`'s in the running whole-program count.
 *
 * @param base  the value the returned closure adds to `n` times 7
 * @return      a closure carrying `base`
 */
fn bm_close_h(base: i64): (i64): i64 {
    (n: i64) => { base + n * 7 }
}

/**
 * bmem_lambdas_many — SEVEN lifted closures, each created inside a DIFFERENT item's own scoped
 * region, applied and summed. Proves no two items' lifted thunks collide on the same id (E5) across
 * several region drops — the volume-at-self-host-scale case (hundreds of items) is the FIXPOINT
 * ritual's job (§7/§8 `lmem_fixpoint`); this proves the invariant that makes it safe (§8
 * `lmem_lambdas_many`).
 *
 * @return  true when the seven closures sum to the known total, 308
 */
pub fn bmem_lambdas_many(): bool {
    var o = opaque_zero()
    var a = bm_close_b(1 + o)
    var b = bm_close_c(2 + o)
    var c = bm_close_d(3 + o)
    var d = bm_close_e(4 + o)
    var e = bm_close_f(5 + o)
    var f = bm_close_g(6 + o)
    var g = bm_close_h(7 + o)
    a(10) + b(10) + c(10) + d(10) + e(10) + f(10) + g(10) == 308
}
