/**
 * scenario — the restored `native_gate_coercions` regressive (#265, deleted by `fbeaaa87` with a
 * false no-coverage-lost claim): the three constructs the NATIVE test gate first forced through
 * codegen — a bare `[]T` into a `[](T | null)` PARAM (element-wise present-wrap), the same into a
 * `[](T | null)` struct FIELD, and `~` on a sub-`int` unsigned prim (C integer-promotes `(u8)0`
 * before `~`, so the result must be re-narrowed to the u8 width: 255, not -1).
 *
 * Migrated here from `bulk`'s `native_gate` (cargo/0.3.1-dissolver-bulk, 2026-07-29): the two
 * `[](i64 | null)` cells this fixture originally exercised are STILL an honest, unmet gap (`[](` is
 * read by the parser as a FUNCTION type, and the alias spelling reaches codegen's "optional/slice
 * inner type not yet supported" stop) — pinned separately, at zero build cost, in
 * `examples/regressions/parse_diagnostics`; only the third, expressible construct is asserted here.
 *
 * @return 21 on success (falling off the end, matching the original fixture's own asserted value)
 */
pub fn scenario(): i64 {
    if sum_opt(make_ints()) != 33 { return -1 }
    if field_sum() != 33 { return -1 }
    if (not_u8() to i64) != 255 { return -1 }
    21
}
