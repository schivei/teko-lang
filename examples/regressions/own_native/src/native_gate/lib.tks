/**
 * make_ints — a bare `[]i64`, the value the present-wrap cells consume (`native_gate_coercions`,
 * #265: the constructs the NATIVE test gate first forced through codegen).
 *
 * @return a two-element `[]i64` (`[11, 22]`)
 */
fn make_ints(): []i64 { teko::list::push(teko::list::push(teko::list::empty(), 11), 22) }

/**
 * sum_opt — the param-slot read, over the bare `[]i64` the surface can express today. The pinned
 * `[](i64 | null)` PARAM slot this was meant to exercise cannot be spelled at all on today's
 * surface — verified, not assumed: `[](` is read by the parser as a FUNCTION type ("a function
 * type '(A, B): R' needs '->' before the return type"), and spelling the element through a type
 * alias reaches the codegen stop instead ("optional/slice inner type not yet supported"), exactly
 * the gap this project's own F3 corpus already documents as an honest gap.
 *
 * @param xs  the two-element `[]i64` under test
 * @return    `xs[0] + xs[1]`
 */
fn sum_opt(xs: []i64): i64 { xs[0] + xs[1] }

/** IntHolder — the struct whose field the pinned `[](i64 | null)` field cell would type. */
type IntHolder = struct {
    /** the bare `[]i64` field the field-slot cell would otherwise carry as `[](i64 | null)`. */
    xs: []i64
}

/**
 * field_sum — the field-slot twin of `sum_opt`: build the holder from a bare `[]i64`, read it
 * back.
 *
 * @return `h.xs[0] + h.xs[1]`
 */
fn field_sum(): i64 {
    var h = IntHolder { xs = make_ints() }
    h.xs[0] + h.xs[1]
}

/**
 * not_u8 — bitwise NOT of a `u8` zero, re-narrowed to the u8 width (C integer-promotes `(u8)0`
 * before `~`, so the result must be re-narrowed: 0xFF == 255, never -1).
 *
 * @return the `u8` value `255`
 */
fn not_u8(): u8 { var m: u8 = 0; ~m }
