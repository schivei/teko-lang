/**
 * probe — a numeric null-union reached through the const-inliner's widen, the shape whose native
 * lowering `cargo/0.3.1.0-null-adopt` closed (`lower_cast` routes a `Variant`-targeted cast through
 * `lower_value_into_type` instead of asking `prim_kind_of` for a `Variant`'s absent machine class).
 * Byte-for-byte the body authored 2026-07-24 (`1201088`), unchanged since and green through the C
 * route the whole time; a wrapper written with the wrong tag shows up as a wrong SUM, not a stop.
 *
 * @return the sum of the two narrowed values (42)
 */
pub fn probe() -> u64 {
    let present: u64 | null = 40
    let absent: u64 | null = null
    let rp = match present { u64 as v => v; null => 0 to u64 }
    let ra = match absent { u64 as v => v; null => 2 to u64 }
    rp + ra
}
