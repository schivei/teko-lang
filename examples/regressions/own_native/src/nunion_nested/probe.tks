/**
 * Inner_qopt — the inner struct whose single field is itself a null-union (`i64 | null`), the leaf of
 * the two-level nesting this member pins.
 */
type Inner_qopt = struct {
    /** the inner value, present or absent. */
    v: i64 | null
}

/**
 * Outer_qopt — the outer struct whose field is a null-union OVER the inner struct, so a null-union
 * struct nests inside another null-union field — the shape the native placement-coercion stop was
 * first measured on (0.3.1.0 degrau 25).
 */
type Outer_qopt = struct {
    /** the inner struct, present or absent. */
    inner: Inner_qopt | null
}

/**
 * read_outer — narrow both levels, falling back at either.
 *
 * @param o         the outer value
 * @param fallback  the value returned when either level is absent
 * @return          the inner value, or `fallback`
 */
fn read_outer(o: Outer_qopt, fallback: i64): i64 {
    match o.inner {
        Inner_qopt as inn => match inn.v { i64 as v => v; null => fallback }
        null => fallback
    }
}

/**
 * probe — the three placements: both present (30), the inner level `null` (fallback 5), the outer
 * level `null` (fallback 7), summing to 42. Byte-for-byte the body authored 2026-07-24 (`1201088`),
 * green through the C route the whole time; a wrapper written at either level with the wrong tag
 * shows up as a WRONG SUM, not as a stop.
 *
 * @return 42 when both nesting levels round-trip
 */
pub fn probe(): u64 {
    var present = Outer_qopt { inner = Inner_qopt { v = 30 } }
    var inner_null = Outer_qopt { inner = Inner_qopt { v = null } }
    var outer_null = Outer_qopt { inner = null }
    (read_outer(present, 0) + read_outer(inner_null, 5) + read_outer(outer_null, 7)) to u64
}
