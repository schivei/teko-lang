/**
 * f_arith — the fold-opaque MUL/ADD probe. `n` is a `mut` local, so const-folding may not collapse
 * the expression at compile time and the native backend must actually emit the two arithmetic
 * instructions.
 *
 * @return 42, the value `main.tks` pins
 */
fn f_arith() -> i64 { mut n = 3; n * 10 + 12 }

/**
 * f_sub — the fold-opaque MUL/SUB probe, the subtraction twin of `f_arith` and opaque for the same
 * reason: `n` is a `mut` local.
 *
 * @return 42, the value `main.tks` pins
 */
fn f_sub() -> i64 { mut n = 3; n * 20 - 18 }

/**
 * f_defer — a `defer` registered INSIDE a match arm must run when that arm's scope ends and its
 * write must be visible to the enclosing function afterwards.
 *
 * @return 101 — the initial 1 plus the deferred arm's +100
 */
fn f_defer() -> i64 {
    mut s = 1
    let x = 1
    match x {
        1 => { defer { s = s + 100 } }
        _ => { }
    }
    s
}

/**
 * f_exit_code — the smallest possible exit-code probe: a literal return the whole vertical must
 * carry from the emitter to the process status.
 *
 * @return 42
 */
fn f_exit_code() -> i64 { 42 }

/**
 * f_exit_zero — the SUCCESS status, pinned separately from `f_exit_code` because zero is the value
 * a broken vertical is most likely to produce by accident.
 *
 * @return 0
 */
fn f_exit_zero() -> i64 { 0 }

/**
 * f_if_exit — an `if`/`else` whose BOTH arms diverge with `return`, so the function has no
 * fall-through tail for the emitter to reach.
 *
 * @return 1 — the then-arm, since 5 > 3
 */
fn f_if_exit() -> i64 { if 5 > 3 { return 1 } else { return 2 } }

/**
 * f_if_value_rhs_shadow — a value-`if` whose arm SHADOWS an outer `x` and whose enclosing block then
 * REASSIGNS that outer `x`. The shadow must not alias the outer binding, so the reassignment is the
 * value observed at the end.
 *
 * @return 7 — the reassigned outer `x` (the shadowed 99 cancels out through `seen - seen`)
 */
fn f_if_value_rhs_shadow() -> i64 {
    mut x = 1
    mut seen = 0
    if 1 == 1 {
        let y = if 1 == 1 { let x = 99; x } else { 0 }
        seen = y
        x = 7
    }
    x + seen - seen
}

/**
 * f_logical_not — logical negation over a `bool` local and over two comparison expressions, each
 * guarding an early return so a mis-lowered `!` is observable as a wrong exit code.
 *
 * @return 7 — reached only when all three negations evaluate correctly
 */
fn f_logical_not() -> i64 {
    mut b = true
    if !b { return 1 }
    if !(1 < 2) { return 2 }
    if !(2 < 1) { return 7 }
    0
}

/**
 * f_loop_nested_range — LABELLED control flow across nested range loops: `continue OUTER` from the
 * inner loop must resume the OUTER loop's next iteration, and `break OUTER` must leave both.
 *
 * @return 0 when the accumulated sum is the expected 4, else 1
 */
fn f_loop_nested_range() -> i64 {
    mut sum = 0
    OUTER: loop mut i in 0..3 {
        loop mut j in 0..3 {
            if j == 2 { continue OUTER }
            if i == 2 { break OUTER }
            sum = sum + i + j
        }
    }
    if sum != 4 { return 1 }
    0
}

/**
 * f_loop_range_native — the four range-loop laws in one body: an exclusive range, an inclusive
 * range, `continue` inside a range, and a bound that is SNAPSHOT at loop entry (writing `n` inside
 * the body must not extend the iteration count).
 *
 * @return 0 when all four hold, else 1/2/3/4 naming the one that failed
 */
fn f_loop_range_native() -> i64 {
    mut s = 0
    loop mut i in 0..3 { s = s + i }
    if s != 3 { return 1 }
    mut s2 = 0
    loop mut i in 0..=3 { s2 = s2 + i }
    if s2 != 6 { return 2 }
    mut s3 = 0
    loop mut i in 0..5 { if i == 2 { continue }; s3 = s3 + i }
    if s3 != 8 { return 3 }
    mut n = 3
    mut cnt = 0
    loop mut i in 0..n { n = 100; cnt = cnt + 1 }
    if cnt != 3 { return 4 }
    0
}

/**
 * f_match_arm_reassign_vs_shadow — a match arm that REASSIGNS an outer local beside an arm that
 * SHADOWS it. The two must not share a slot: the taken arm decides which of the two effects the
 * caller observes.
 *
 * @return 6 — 5 from the reassigning arm plus 1 from the untouched outer binding
 */
fn f_match_arm_reassign_vs_shadow() -> i64 {
    let k1 = 1
    mut a = 1
    match k1 { 1 => { a = 5 }; _ => { mut a = 99; a = a + 1 } }
    let k0 = 0
    mut b = 1
    match k0 { 1 => { b = 5 }; _ => { mut b = 99; b = b + 1 } }
    a + b
}

/**
 * f_match_exit — a value-`match` used as the function's tail expression, so the arm's value is the
 * returned one.
 *
 * @return 7 — the arm selected by subject 0
 */
fn f_match_exit() -> i64 { let k = 0; match k { 0 => 7; _ => 9 } }

/**
 * f_match_reassign_then_shadow — one arm that first REASSIGNS the outer `x` and then SHADOWS it. The
 * shadow's later writes must not reach the outer binding the function returns.
 *
 * @return 3 — the reassignment, never the shadow's 100
 */
fn f_match_reassign_then_shadow() -> i64 {
    let k = 1
    mut x = 1
    match k { 1 => { x = 3; mut x = 99; x = x + 1 }; _ => { } }
    x
}

/**
 * f_value_if_rhs_reassign — a value-`if` whose arm REASSIGNS the outer local it also reads, so the
 * write must be visible both to the arm's own value and to the enclosing function.
 *
 * @return 5 — the reassigned `x` (the arm's value cancels through `seen - seen`)
 */
fn f_value_if_rhs_reassign() -> i64 {
    mut x = 1
    mut seen = 0
    if 1 == 1 { let y = if 1 == 1 { x = 5; x } else { 0 }; seen = y }
    x + seen - seen
}

/**
 * f_null_union_reassign_to_null — (B-S1) the own backend must coerce into a null-union at EVERY
 * placement that declares a type, not only at the binding. `x = null` after a `T | null` binding
 * used to write a raw `const 0` into the VReg the following `match` then read as the wrapper's base
 * address — a load from address 0.
 *
 * @return 42 — 40 from the null arm plus 2 from the re-assigned value arm
 */
fn f_null_union_reassign_to_null() -> i64 {
    mut x: i64 | null = 5
    x = null
    let a = match x { i64 as v => v; null => 40 }
    x = 2
    let b = match x { i64 as v => v; null => 0 }
    a + b
}

/**
 * LayoutPair — the STRUCT control of the class-layout probe. It is the arm of the native lowering's
 * layout collector that already worked, so a fix that broke it fails here instead of passing
 * quietly.
 */
type LayoutPair = struct {
    /** small — the leading 4-byte field, the one a wrong stride reads back wrong. */
    small: i32

    /** big — the 8-byte field the leading one must not overlap. */
    big: i64

    /** flag — the trailing 1-byte field, the one a wrong total size drops. */
    flag: bool
}

/**
 * LayoutBase — an ABSTRACT base whose fields are the PREFIX of every derived instance, which is
 * what field-flattening composition means for the emitted object.
 */
type LayoutBase = abstract class {
    /** small — the inherited 4-byte field. */
    pub small: i32

    /** big — the inherited 8-byte field. */
    pub big: i64
}

/**
 * LayoutLeaf — the concrete leaf: `LayoutBase`'s two fields followed by its own two. An overlapping
 * or reordered slot shows up as a wrong read-back, never as a compile error.
 */
type LayoutLeaf = class LayoutBase {
    /** flag — the leaf's own 1-byte field, placed after the inherited prefix. */
    pub flag: bool

    /** extra — the leaf's own 8-byte field. */
    pub extra: i64

    /**
     * make — the static factory, naming the INHERITED fields alongside its own.
     *
     * @param s  the inherited small field
     * @param b  the inherited big field
     * @param f  the own flag field
     * @param e  the own extra field
     * @return   a fresh LayoutLeaf
     */
    pub fn make(s: i32, b: i64, f: bool, e: i64) -> LayoutLeaf { LayoutLeaf { small = s; big = b; flag = f; extra = e } }

    /**
     * total — sums an INHERITED field with an OWN one, so a slot shared between the two halves of
     * the flattened layout yields a wrong sum.
     *
     * @return small + big + extra
     */
    pub fn total(self) -> i64 { self.small + self.big + self.extra }
}

/**
 * f_class_layout_effective_fields — a `ClassBody` must register the layout of its EFFECTIVE
 * instance fields. The native lowering collected a layout for a `StructBody` only; a `ClassBody`
 * fell through the catch-all arm of `collect_struct_layout_decl` and registered NOTHING, so EVERY
 * class instantiation died at compile time with "no layout registered for struct `…`" — one class
 * in one namespace, with no same-name type anywhere, was enough to trigger it.
 *
 * @return 0 when the struct control and every inherited and own field read back the value they were
 *         constructed with, else 1..8 naming the one that failed
 */
fn f_class_layout_effective_fields() -> i64 {
    let pair = LayoutPair { small = 3; big = 7; flag = true }
    if pair.small != 3 { return 1 }
    if pair.big != 7 { return 2 }
    if !pair.flag { return 3 }
    let leaf = LayoutLeaf::make(2, 13, true, 17)
    if leaf.small != 2 { return 4 }
    if leaf.big != 13 { return 5 }
    if !leaf.flag { return 6 }
    if leaf.extra != 17 { return 7 }
    if leaf.total() != 32 { return 8 }
    0
}

/**
 * LpShade — a plain declared `enum`, whose value is its integer CARRIER rather than an address.
 * A slice of these is the non-primitive half of the register-value element set the native list
 * builtin lowers.
 */
type LpShade = enum { Dim; Mid; Bright }

/**
 * f_list_push_scalar_loop — the canonical accumulation the whole compiler is written in:
 * `loop { xs = teko::list::push(xs, …) }` growing an empty list, then read back by index. It
 * exercises the runtime's amortized grow (the in-place live-tail hit AND the geometric copy-grow,
 * since eight pushes cross several doublings) through the native lowering's `(ptr, len, &item,
 * sizeof, &out_len)` call shape.
 *
 * @return 0 when the length and every element read back as pushed, else 1..3 naming the failure
 */
fn f_list_push_scalar_loop() -> i64 {
    mut xs: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= 8 { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    if xs.len != 8 { return 1 }
    mut sum: u64 = 0
    mut j: u64 = 0
    loop {
        if j >= xs.len { break }
        sum = sum + xs[j]
        j++
    }
    if sum != 84 { return 2 }
    if xs[7] != 21 { return 3 }
    0
}

/**
 * f_list_push_value_semantics — a push RETURNS a new list and never mutates its base: two pushes
 * onto the SAME base must produce two independent lists, and the base itself must keep its own
 * length. This is the assertion the runtime's in-place live-tail cache is most likely to break, so
 * it is pinned separately from the plain accumulation.
 *
 * @return 0 when both branches and the shared base read back independently, else 1..5
 */
fn f_list_push_value_semantics() -> i64 {
    let base = teko::list::push(teko::list::push(teko::list::empty(), 10), 20)
    let left = teko::list::push(base, 30)
    let right = teko::list::push(base, 40)
    if base.len != 2 { return 1 }
    if left.len != 3 { return 2 }
    if right.len != 3 { return 3 }
    if left[2] != 30 { return 4 }
    if right[2] != 40 { return 5 }
    0
}

/**
 * f_list_push_fo_widths — the `teko::mem::push_fo` DECREE (the free-old-on-grow runtime entry) over
 * a NARROW element: a `[]u32` element is four bytes wide, so the `sizeof` the lowering hands the
 * runtime must be the ELEMENT's width and not the register's, or the buffer reads back shifted.
 *
 * @return 0 when the decreed chain reads back as pushed, else 1..3 naming the failure
 */
fn f_list_push_fo_widths() -> i64 {
    mut xs: []u32 = teko::list::empty()
    mut i: u32 = 0
    loop {
        if i >= 6 { break }
        xs = teko::mem::push_fo(xs, i + 100)
        i++
    }
    if xs.len != 6 { return 1 }
    if xs[0] != 100 { return 2 }
    if xs[5] != 105 { return 3 }
    0
}

/**
 * f_list_push_bool_and_enum — the two remaining register-value element classes: a `bool` (a
 * one-byte carrier) and a declared `enum` (its integer carrier). A slice of either must round-trip
 * through the grow with its own width.
 *
 * @return 0 when both slices read back as pushed, else 1..4 naming the failure
 */
fn f_list_push_bool_and_enum() -> i64 {
    mut marks: []bool = teko::list::empty()
    marks = teko::list::push(marks, true)
    marks = teko::list::push(marks, false)
    marks = teko::list::push(marks, true)
    if marks.len != 3 { return 1 }
    if !marks[0] { return 2 }
    if marks[1] { return 3 }
    mut shades: []LpShade = teko::list::empty()
    shades = teko::list::push(shades, LpShade::Bright)
    shades = teko::list::push(shades, LpShade::Dim)
    if shades[0] != LpShade::Bright { return 4 }
    0
}

/**
 * f_list_empty_has_no_elements — a bare `teko::list::empty()` is the (null, 0) pair: its length is
 * zero with no runtime call at all, and pushing onto it starts a fresh buffer rather than growing
 * whatever the previous list left in the allocator's live-tail cache.
 *
 * @return 0 when the empty list is empty and the fresh push holds only its own item, else 1..3
 */
fn f_list_empty_has_no_elements() -> i64 {
    let e: []u64 = teko::list::empty()
    if e.len != 0 { return 1 }
    let one = teko::list::push(e, 7)
    if one.len != 1 { return 2 }
    if one[0] != 7 { return 3 }
    0
}

/**
 * sc_yes — an opaque `true` the const-folder cannot see through, so the short-circuit rows below
 * measure the LOWERING and not the folder.
 *
 * @param n  a seed the caller varies so the call is never folded to a literal
 * @return   true whenever `n` is zero or positive
 */
fn sc_yes(n: i64) -> bool { n >= 0 }

/**
 * sc_no — the opaque `false` twin of `sc_yes`, opaque for the same reason.
 *
 * @param n  a seed the caller varies so the call is never folded to a literal
 * @return   false whenever `n` is zero or positive
 */
fn sc_no(n: i64) -> bool { n < 0 }

/**
 * sc_trap — a division by `d` that TRAPS when `d` is zero. It is the right operand of the two
 * short-circuit rows that must never evaluate their right side: a lowering that evaluates both
 * operands kills the process instead of returning a wrong number, which is the loudest possible
 * failure for exactly the miscompile a bitwise `IAnd` would have introduced.
 *
 * @param d  the divisor
 * @return   true when 10/d is positive
 */
fn sc_trap(d: i64) -> bool { (10 / d) > 0 }

/**
 * f_short_circuit_and_or — the truth table of `&&` and `||` plus their SHORT-CIRCUIT guarantee.
 * The native lowering routed both operators into the integer opcode table (`bool` rides the
 * integer family of `lbinop_of`'s float/int split) and honest-stopped there, so no program using
 * a logical operator could be built natively at all — the compiler's own source first among them.
 * They now lower to a branch whose right-operand block is entered only when the left operand did
 * not already decide the result.
 *
 * @return 0 when every row of the table holds and neither trap row evaluated its right operand,
 *         else the number of the first failing row
 */
fn f_short_circuit_and_or() -> i64 {
    if !(sc_yes(1) && sc_yes(2)) { return 1 }
    if sc_yes(1) && sc_no(2) { return 2 }
    if sc_no(1) && sc_yes(2) { return 3 }
    if sc_no(1) && sc_no(2) { return 4 }
    if !(sc_yes(1) || sc_no(2)) { return 5 }
    if !(sc_no(1) || sc_yes(2)) { return 6 }
    if sc_no(1) || sc_no(2) { return 7 }
    if !(sc_yes(1) && sc_yes(2) && sc_yes(3)) { return 8 }
    if sc_no(1) && sc_trap(0) { return 9 }
    if !(sc_yes(1) || sc_trap(0)) { return 10 }
    if !(sc_yes(1) && sc_no(2) || sc_yes(3)) { return 11 }
    0
}

/**
 * BoxPt — the pushed AGGREGATE element. Two 8-byte fields, so a mistaken 8-byte-wide copy of the
 * instance would carry `x` and lose `y`.
 */
type BoxPt = struct {
    /** x — the iteration counter, straight. */
    x: i64

    /** y — the iteration counter times ten, so a stale copy is visible in two independent fields. */
    y: i64
}

/**
 * BoxCounter — the CLASS arm of the same claim: a class instance is laid out by the same collector
 * a struct is, so a push must box it with the same width.
 */
type BoxCounter = class {
    /** seen — the value this instance was constructed with. */
    pub seen: i64

    /**
     * make — the static factory (a class literal reads better through one named producer).
     *
     * @param v  the value to record
     * @return   a fresh BoxCounter holding `v`
     */
    pub fn make(v: i64) -> BoxCounter { BoxCounter { seen = v } }
}

/**
 * push_pts — accumulate `n` distinct `BoxPt` instances through `teko::list::push`, ONE PER LOOP
 * ITERATION. This is the shape degrau 4 closed: the native backend's value for a struct is the
 * address of an `alloca`, and an `alloca` is one frame slot per INSTRUCTION, so a push that stored
 * that address directly would store the SAME address `n` times.
 *
 * @param n  how many elements to accumulate
 * @return   the accumulated list
 */
fn push_pts(n: i64) -> []BoxPt {
    mut ps: []BoxPt = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        ps = teko::list::push(ps, BoxPt { x = i; y = i * 10 })
        i++
    }
    ps
}

/**
 * f_push_aggregate_in_loop — a push of a STRUCT inside a loop must yield `n` DISTINCT elements.
 * Without degrau 4's fresh per-execution box the program did not compile at all (the native backend
 * honest-stopped on the aggregate element), and the naive stand-in it refused — pushing the
 * `alloca`'s address as-is — makes every element read back as a copy of the LAST one, which is
 * exactly what the element-by-element check below catches.
 *
 * @return 0 when every element carries its own iteration's values, else the number of the failing
 *         check
 */
fn f_push_aggregate_in_loop() -> i64 {
    let ps = push_pts(4)
    if ps.len != 4 { return 1 }
    mut i: i64 = 0
    loop {
        if i >= 4 { break }
        if ps[i].x != i { return 2 }
        if ps[i].y != i * 10 { return 3 }
        i++
    }
    if ps[0].x == ps[3].x { return 4 }
    if ps[0].y == ps[3].y { return 5 }
    0
}

/**
 * f_push_aggregate_copies_the_item — a pushed aggregate is a COPY: mutating the source binding
 * after the push must not reach the element the list holds. The address model without a box shares
 * one frame slot between the binding and the list, so the mutation would be visible through the
 * list too.
 *
 * @return 0 when the pushed element kept the values it was pushed with, else the failing check
 */
fn f_push_aggregate_copies_the_item() -> i64 {
    mut p = BoxPt { x = 1; y = 2 }
    mut ps: []BoxPt = teko::list::empty()
    ps = teko::list::push(ps, p)
    p.x = 99
    p.y = 98
    if ps.len != 1 { return 1 }
    if ps[0].x != 1 { return 2 }
    if ps[0].y != 2 { return 3 }
    0
}

/**
 * f_push_class_in_loop — the CLASS arm of `f_push_aggregate_in_loop`: a class instance pushed once
 * per iteration must read back as its own iteration's value, through a method as well as a field.
 *
 * @return 0 when every element carries its own iteration's value, else the number of the failing
 *         check
 */
fn f_push_class_in_loop() -> i64 {
    mut cs: []BoxCounter = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= 3 { break }
        cs = teko::list::push(cs, BoxCounter::make(i * 7))
        i++
    }
    if cs.len != 3 { return 1 }
    if cs[0].seen != 0 { return 2 }
    if cs[1].seen != 7 { return 3 }
    if cs[2].seen != 14 { return 4 }
    0
}

/**
 * fat_match_word — a `str`-valued `match` in TAIL position, the exact producer the native backend
 * had no arm for: `lower_fat_expr`'s closed producer set accepted a literal, an array literal, a
 * bound local, a struct field, an `if`-expression and a direct call, and a match-value was none of
 * them.
 *
 * @param n  the subject
 * @return   the word naming `n`, `"many"` past the named ones
 */
fn fat_match_word(n: i64) -> str {
    match n {
        0 => "zero"
        1 => "one"
        2 => "two"
        _ => "many"
    }
}

/**
 * fat_match_digits — a `[]T`-valued `match`, the SLICE half of the same producer: the merge carries
 * a (ptr, len) pair, so an arm whose slice has a different length must not reach the merge with the
 * length of a sibling arm.
 *
 * @param n  the subject
 * @return   a slice whose length and contents both depend on the arm taken
 */
fn fat_match_digits(n: i64) -> []i64 {
    match n {
        1 => [7]
        2 => [7, 8]
        _ => [7, 8, 9]
    }
}

/**
 * fat_match_with_reassign — a `str`-valued `match` whose arms also RE-ASSIGN an enclosing scalar.
 * The reassigned scalar rides the merge as a block-param AFTER the ptr/len pair, so a merge that
 * mis-ordered its params would return the wrong string, the wrong count, or both.
 *
 * @param n  the subject
 * @return   the count the arm assigned plus the LENGTH of the string it produced, so a merge that
 *           dropped either half is visible in the sum
 */
fn fat_match_with_reassign(n: i64) -> i64 {
    mut count: i64 = 0
    let word = match n {
        1 => { count = 10; "a" }
        _ => { count = 20; "bb" }
    }
    count + (word.len to i64)
}

/**
 * f_fat_match_value — the fat `match`-value producer, in both its `str` and its `[]T` shape and
 * with a scalar threaded through the merge beside the pair (0.3.1.0 degrau 5).
 *
 * The `str` shapes are checked through `.len` and a BYTE, not through `!=` on two strings: the
 * native backend has no `str` comparison yet (`"`str` has no single PrimKind"`), and a corpus
 * member must claim its own subject only.
 *
 * @return 0 when every shape returns its own arm's value, else the number of the failing check
 */
fn f_fat_match_value() -> i64 {
    if fat_match_word(0).len != 4 { return 1 }
    if fat_match_word(0)[0] != b'z' { return 2 }
    if fat_match_word(2).len != 3 { return 3 }
    if fat_match_word(2)[0] != b't' { return 4 }
    if fat_match_word(9).len != 4 { return 11 }
    if fat_match_word(9)[0] != b'm' { return 12 }
    if fat_match_word(1)[2] != b'e' { return 13 }
    if fat_match_digits(1).len != 1 { return 5 }
    if fat_match_digits(2).len != 2 { return 6 }
    if fat_match_digits(5).len != 3 { return 7 }
    if fat_match_digits(2)[1] != 8 { return 8 }
    if fat_match_with_reassign(1) != 11 { return 9 }
    if fat_match_with_reassign(4) != 22 { return 10 }
    0
}

/**
 * fat_variant_digits — a variant whose ACTIVE member is a `[]T` of a caller-chosen length. The
 * construction is what degrau 6 is about: the wrapper must keep the slice's LENGTH beside its
 * pointer, or nothing downstream can recover it.
 *
 * @param n  the element count to build
 * @return   the `n` first triples
 * @throws   when `n` is zero
 */
fn fat_variant_digits(n: i64) -> []i64 | error {
    if n == 0 { return error { message = "empty" } }
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    return xs
}

/**
 * fat_variant_digits_len — the LENGTH a slice member reports once bound out of the variant by a
 * `[]T` pattern. THE CHECK THAT PROVES THE FIX: a wrapper that stored only the pointer binds an
 * `xs` whose `.len` is whatever sat past it, so a per-call length is the assertion a lossy
 * construction cannot satisfy by luck.
 *
 * @param n  the element count to ask for
 * @return   the bound slice's length, or -1 for the error case
 */
fn fat_variant_digits_len(n: i64) -> i64 {
    match fat_variant_digits(n) {
        []i64 as xs => xs.len to i64
        error => 0 - 1
    }
}

/**
 * fat_variant_digits_sum — the sum of a bound slice member's own elements, walked through the
 * bound LENGTH. Pins the CONTENTS beside the length: a binding that recovered a plausible length
 * but the wrong pointer would still read the wrong elements.
 *
 * @param n  the element count to ask for
 * @return   the sum of the bound slice's elements, or -1 for the error case
 */
fn fat_variant_digits_sum(n: i64) -> i64 {
    match fat_variant_digits(n) {
        []i64 as xs => {
            mut acc: i64 = 0
            mut i: u64 = 0
            loop {
                if i >= xs.len { break }
                acc = acc + xs[i]
                i++
            }
            acc
        }
        error => 0 - 1
    }
}

/**
 * fat_variant_word — a variant whose active member is a `str`, the case a pattern selects BY NAME
 * (`str as s`) rather than by the slice shape. Same wrapper, other half of the same hole.
 *
 * @param n  the switch selecting the word
 * @return   a word whose length depends on `n`
 * @throws   when `n` is zero
 */
fn fat_variant_word(n: i64) -> str | error {
    if n == 0 { return error { message = "empty" } }
    if n == 1 { return "a" }
    return "abcde"
}

/**
 * fat_variant_word_len — the LENGTH a `str` member reports once bound out of the variant.
 *
 * @param n  the switch selecting the word
 * @return   the bound string's length, or -1 for the error case
 */
fn fat_variant_word_len(n: i64) -> i64 {
    match fat_variant_word(n) {
        str as s => s.len to i64
        error => 0 - 1
    }
}

/**
 * fat_null_union_word — a null-BEARING union whose present member is a `str`: the third
 * construction path into the same wrapper (a fixed tag 0/1, no case name at all).
 *
 * @param n  the switch selecting presence
 * @return   a three-byte word, or `null`
 */
fn fat_null_union_word(n: i64) -> str | null {
    if n == 0 { return null }
    return "xyz"
}

/**
 * f_variant_fat_member — a variant member that is FAT (`str`/`[]T`) keeps its LENGTH across the
 * wrapper (0.3.1.0 degrau 6, the uniform 24-byte `{tag; ptr; len}`).
 *
 * Every check reads a length or a byte that only a wrapper carrying BOTH halves can answer: the
 * per-call slice lengths, the sum walked through one of them, the two `str` lengths, a byte behind
 * the bound pointer, and the null union's present case. The error/`null` arms are asserted too, so
 * a tag test that drifted when the wrapper widened is visible as a wrong arm rather than as a wrong
 * length.
 *
 * The strings are compared through `.len` and a BYTE, never with `!=` on two strings: the native
 * backend has no `str` comparison yet, and a corpus member must claim its own subject only.
 *
 * @return 0 when every shape recovers its own length and contents, else the number of the failing
 *         check
 */
fn f_variant_fat_member() -> i64 {
    if fat_variant_digits_len(3) != 3 { return 1 }
    if fat_variant_digits_len(7) != 7 { return 2 }
    if fat_variant_digits_len(0) != 0 - 1 { return 3 }
    if fat_variant_digits_sum(4) != 18 { return 4 }
    if fat_variant_word_len(1) != 1 { return 5 }
    if fat_variant_word_len(2) != 5 { return 6 }
    if fat_variant_word_len(0) != 0 - 1 { return 7 }
    match fat_null_union_word(1) {
        str as s => {
            if s.len != 3 { return 8 }
            if s[2] != b'z' { return 9 }
        }
        null => { return 10 }
    }
    match fat_variant_word(2) {
        str as s => { if s[4] != b'e' { return 11 } }
        error => { return 12 }
    }
    0
}

/**
 * str_eq_word — a `str` produced by a CALL, so the equality's operands are not both literals the
 * folder could have collapsed before the backend ever saw them.
 *
 * @param n  the switch selecting the word
 * @return   the word naming `n`
 */
fn str_eq_word(n: i64) -> str {
    if n == 0 { return "alpha" }
    if n == 1 { return "alphb" }
    ""
}

/**
 * f_str_equality — `str == str` and `str != str` lowered natively (0.3.1.0 degrau 7).
 *
 * The native backend had NO string comparison: `lower_compare` asked `prim_kind_of` for the
 * operand's single machine kind and a `str` has none (it is two words), so every `==` between
 * strings honest-stopped. The lowering now calls the runtime's own `tk_str_eq` with the two
 * ABI-flattened pairs.
 *
 * The rows that matter beyond "equal is equal": two DIFFERENT strings of the SAME length (a
 * length-only comparison would call them equal), two strings that differ in the LAST byte only (a
 * prefix comparison would call them equal), two equal strings held in different buffers (a pointer
 * comparison would call them different), and the empty pair (whose pointer is null).
 *
 * @return 0 when every comparison answers correctly, else the number of the failing check
 */
fn f_str_equality() -> i64 {
    let a = "alpha"
    let b = str_eq_word(0)
    let c = str_eq_word(1)
    if !(a == b) { return 1 }
    if a != b { return 2 }
    if a == c { return 3 }
    if !(a != c) { return 4 }
    if a == "alph" { return 5 }
    if a == "alphaa" { return 6 }
    if !("" == str_eq_word(9)) { return 7 }
    if "" != str_eq_word(9) { return 8 }
    if "" == a { return 9 }
    0
}

/**
 * DvCircle — a nominal case of the declared variant `DvShape`, carrying one integer field.
 */
type DvCircle = struct {
    /** r — the circle's radius, the value a `DvCircle` arm must read back. */
    r: i64
}

/**
 * DvSquare — the second nominal case of `DvShape`, with a DIFFERENT field name from `DvCircle` so
 * an arm that read the wrong case's payload cannot compile by accident.
 */
type DvSquare = struct {
    /** s — the square's side, the value a `DvSquare` arm must read back. */
    s: i64
}

/**
 * DvTri — the third nominal case, present so the corpus can enter a LAST arm that is neither the
 * first-arm-wins degenerate nor a two-case coin flip.
 */
type DvTri = struct {
    /** t — the triangle's base, the value a `DvTri` arm must read back. */
    t: i64
}

/**
 * DvShape — a DECLARED variant (`type X = variant …`) over three nominal cases.
 *
 * This is the shape the native backend miscompiled in silence: a declared variant reaches the
 * lowering as a nominal `Named`, not as the `checker::Variant` an inline `A | B` arrives as, so
 * no tag+payload wrapper was built and every bind pattern answered "always matches" — handing every
 * value to the FIRST arm with no diagnostic at all.
 */
type DvShape = variant DvCircle | DvSquare | DvTri

/**
 * dv_pick — a `DvShape` chosen by ordinal, so the case is decided at RUN time and no arm can be
 * folded away before the backend sees it.
 *
 * @param n  0 for a circle, 1 for a square, anything else for a triangle
 * @return   the constructed shape
 */
fn dv_pick(n: i64) -> DvShape {
    if n == 0 { return DvCircle { r = 7 } }
    if n == 1 { return DvSquare { s = 9 } }
    DvTri { t = 11 }
}

/**
 * f_declared_variant_arms — every arm of a declared-variant `match` is entered by the case that
 * belongs to it, and the value each arm BINDS is that case's own payload.
 *
 * THE BOUND VALUE IS PART OF THE CLAIM. An arm test that always answers true sends every subject to
 * the first arm, and the whole-value bind it pairs with reads the unwrapped payload at offset 0 —
 * so a check that only counted which arm ran would pass for the first case and lie about the rest.
 * Each arm therefore asserts the payload it must see, and every arm — first, middle and LAST — is
 * entered by its own case.
 *
 * @return 0 when every case runs its own arm with its own payload, else the number of the failing
 *         check
 */
fn f_declared_variant_arms() -> i64 {
    match dv_pick(0) {
        DvCircle as c => { if c.r != 7 { return 1 } }
        DvSquare as s => { return 2 }
        DvTri as t => { return 3 }
    }
    match dv_pick(1) {
        DvCircle as c => { return 4 }
        DvSquare as s => { if s.s != 9 { return 5 } }
        DvTri as t => { return 6 }
    }
    match dv_pick(2) {
        DvCircle as c => { return 7 }
        DvSquare as s => { return 8 }
        DvTri as t => { if t.t != 11 { return 9 } }
    }
    0
}

/**
 * dv_arm_code — the arm a declared-variant subject selects, as a match-VALUE rather than as a
 * statement: the value shape merges its arms through a block argument, a different lowering from
 * the statement shape, and it reads the SAME tag.
 *
 * @param n  the ordinal `dv_pick` switches on
 * @return   1 for a circle, 2 for a square, 3 for a triangle
 */
fn dv_arm_code(n: i64) -> i64 {
    match dv_pick(n) {
        DvCircle as c => 1
        DvSquare as s => 2
        DvTri as t => 3
    }
}

/**
 * f_declared_variant_match_value — the match-VALUE and the BINDINGLESS/field-pattern spellings of a
 * declared-variant arm select the same case the bind-pattern spelling does.
 *
 * A bindingless case (`DvSquare =>`) and a field destructure (`DvCircle { r }`) resolve their case
 * through paths of their own, so each is claimed here: the first used to inherit the same
 * always-matches degeneration, and the second used to honest-stop outright ("field match pattern
 * over a non-variant subject") because a declared variant never looked like a variant at all.
 *
 * @return 0 when every spelling picks its own case, else the number of the failing check
 */
fn f_declared_variant_match_value() -> i64 {
    if dv_arm_code(0) != 1 { return 1 }
    if dv_arm_code(1) != 2 { return 2 }
    if dv_arm_code(2) != 3 { return 3 }
    match dv_pick(2) {
        DvCircle => { return 4 }
        DvSquare => { return 5 }
        DvTri => { }
    }
    match dv_pick(0) {
        DvCircle { r } => { if r != 7 { return 6 } }
        DvSquare { s } => { return 7 }
        DvTri { t } => { return 8 }
    }
    match dv_pick(1) {
        DvCircle { r } => { return 9 }
        DvSquare { s } => { if s != 9 { return 10 } }
        DvTri { t } => { return 11 }
    }
    0
}

/**
 * DvBoxOrErr — a declared variant mixing NOMINAL cases with the built-in `error` case: the two
 * families resolve a case by different rules (a nominal by name, `error` by keyword), and a table
 * that dropped the non-nominal member would mis-tag every case declared after it.
 */
type DvBoxOrErr = variant DvCircle | DvSquare | error

/**
 * dv_or_err — a `DvBoxOrErr` chosen by ordinal.
 *
 * @param n  0 for the error case, 1 for a circle, anything else for a square
 * @return   the constructed value, or its `error` case
 */
fn dv_or_err(n: i64) -> DvBoxOrErr {
    if n == 0 { return error { message = "dv" } }
    if n == 1 { return DvCircle { r = 7 } }
    DvSquare { s = 9 }
}

/**
 * dv_maybe_circle — the INLINE `T | null` union next to the declared family, so the corpus claims a
 * `null` case mixed with a nominal one as well as an `error` case.
 *
 * @param n  0 for the absent case, anything else for a circle
 * @return   the circle, or `null`
 */
fn dv_maybe_circle(n: i64) -> DvCircle | null {
    if n == 0 { return null }
    DvCircle { r = 7 }
}

/**
 * f_declared_variant_error_and_null — the `error` case of a declared variant, and the `null` case of
 * a union, each entered by its own value while the nominal cases beside them keep their own arms.
 *
 * @return 0 when every case runs its own arm with its own payload, else the number of the failing
 *         check
 */
fn f_declared_variant_error_and_null() -> i64 {
    match dv_or_err(0) {
        error as e => { }
        DvCircle as c => { return 1 }
        DvSquare as s => { return 2 }
    }
    match dv_or_err(1) {
        error as e => { return 3 }
        DvCircle as c => { if c.r != 7 { return 4 } }
        DvSquare as s => { return 5 }
    }
    match dv_or_err(2) {
        error as e => { return 6 }
        DvCircle as c => { return 7 }
        DvSquare as s => { if s.s != 9 { return 8 } }
    }
    match dv_maybe_circle(0) {
        null => { }
        DvCircle as c => { return 9 }
    }
    match dv_maybe_circle(1) {
        null => { return 10 }
        DvCircle as c => { if c.r != 7 { return 11 } }
    }
    0
}

/**
 * pad_word — an interpolated, non-const-foldable prefix ("n=<n>") right-padded with spaces to
 * `width`. Mirrors `src/backend/objfile_ar.tks`'s own `ar_pad_right` shape (0.3.1.0 degrau 9): a
 * loop-carried `mut str` reassigned through `teko::str::concat`, seeded from a string
 * interpolation passed as the CALL's own argument — a genuine function parameter, so the checker's
 * const-folder cannot collapse it into a plain literal before the native lowering ever sees it.
 *
 * @param n      the value interpolated into the prefix
 * @param width  the minimum total width to pad to
 * @return       the padded text
 */
fn pad_word(n: i64, width: u64) -> str {
    mut out = $"n={n}"
    loop {
        if out.len >= width { break }
        out = teko::str::concat(out, " ")
    }
    out
}

/**
 * self_interp_loop — `out = $"{out}"` reassigned across a loop's own back-edge: the minimal
 * reproduction of 0.3.1.0 degrau 9's honest stop. The loop-merge machinery needs the
 * reassignment's RIGHT-hand side (an interpolation reading the SAME loop-carried local) through
 * `lower_fat_expr`, which had no `TInterp` arm.
 *
 * @param n  the iteration count
 * @return   `"a"` re-wrapped in its own interpolation `n` times (the content never changes; only
 *           the lowering path is under test)
 */
fn self_interp_loop(n: i64) -> str {
    mut out = "a"
    mut i: i64 = 0
    loop {
        if i >= n { break }
        out = $"{out}"
        i = i + 1
    }
    out
}

/**
 * f_interp_fat_positions — string interpolation exercised in every FAT position 0.3.1.0 degrau 9
 * closed: a call ARGUMENT (`pad_word`'s own caller), a loop-carried self-reassignment
 * (`self_interp_loop`), a MULTI-hole/multi-piece interpolation checked by both its content and its
 * LENGTH (a plausible length with the wrong bytes would still be caught by the byte check), and
 * the `teko::str::concat` builtin folded over more than two arguments (`lower_concat_call`'s own
 * loop, beside the 2-ary shape `pad_word` already exercises).
 *
 * @return 0 when every position lowers correctly, else the number of the failing check
 */
fn f_interp_fat_positions() -> i64 {
    let p = pad_word(7, 6 to u64)
    if p.len != 6 { return 1 }
    if p != "n=7   " { return 2 }
    let s = self_interp_loop(3)
    if s.len != 1 { return 3 }
    if s != "a" { return 4 }
    let x: i64 = 12
    let y = "mid"
    let multi = $"x={x}-{y}-end"
    if multi.len != 12 { return 5 }
    if multi != "x=12-mid-end" { return 6 }
    let joined = teko::str::concat("a", "b", "c", "d")
    if joined.len != 4 { return 7 }
    if joined != "abcd" { return 8 }
    0
}

/**
 * FatHolder — a struct with a leading `str` field, at offset 0. 0.3.1.0 raiz-comum §5.1: before
 * the R3 crumb, a struct's fat field was constructed with its LENGTH half never written, so
 * `.len` read back whatever the fresh `alloca` happened to hold (measured 0) instead of the
 * field's true length.
 */
type FatHolder = struct { name: str; n: i64 }

/**
 * FatHolderShift — the same fat field, SECOND (offset 8, not 0), so the fix's correctness does
 * not depend on the field's position within the struct.
 */
type FatHolderShift = struct { n: i64; name: str }

/**
 * FatSliceHolder — a struct with a `[]i64` (fat, non-`str`) field: `is_fat_type` covers `Slice`
 * too, and so does the defect it names (0.3.1.0 raiz-comum §5.4).
 */
type FatSliceHolder = struct { xs: []i64; n: i64 }

/**
 * f_fat_field_roundtrip — construct a struct with a fat `str` field at offset 0, read its
 * length and content back.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_roundtrip() -> i64 {
    let h = FatHolder { name = "abcde"; n = 7 }
    if h.n != 7 { return 1 }
    if h.name.len != 5 { return 2 }
    if h.name != "abcde" { return 3 }
    0
}

/**
 * f_fat_field_offset_shift — the same construction with the fat field at a non-zero offset.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_offset_shift() -> i64 {
    let h = FatHolderShift { n = 7; name = "abcde" }
    if h.n != 7 { return 1 }
    if h.name.len != 5 { return 2 }
    if h.name != "abcde" { return 3 }
    0
}

/**
 * f_fat_field_reassign — reassign a struct's `str` field and reread its length (0.3.1.0
 * raiz-comum §5.2: measured to keep the OLD length before R3, since the plain assignment path
 * wrote only the pointer half).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_reassign() -> i64 {
    mut h = FatHolder { name = "abcde"; n = 7 }
    h.name = "xy"
    if h.name.len != 2 { return 1 }
    if h.name != "xy" { return 2 }
    0
}

/**
 * f_fat_field_len — the length of a `str` argument, as `i64`.
 *
 * @param s  the string to measure
 * @return   its byte length
 */
fn f_fat_field_len(s: str) -> i64 { s.len to i64 }

/**
 * f_fat_field_as_argument — pass a struct's `str` field as a call argument (0.3.1.0 raiz-comum
 * §5.3): the READ side (`lower_fat_field`) was already correct before R3 — it was the WRITE
 * side that left the length half unset, so this probe exercises the reader against the
 * now-correctly-written field.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_as_argument() -> i64 {
    let h = FatHolder { name = "abcde"; n = 7 }
    if f_fat_field_len(h.name) != 5 { return 1 }
    0
}

/**
 * f_fat_slice_field — a struct's `[]i64` field: length and index read.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_field() -> i64 {
    let h = FatSliceHolder { xs = [10, 20, 30]; n = 1 }
    if h.xs.len != 3 { return 1 }
    if h.xs[2] != 30 { return 2 }
    0
}

/**
 * f_fat_slice_literal_index — a `[]str` array literal's store and index read: each element's
 * OWN `.len` and content, not just the outer slice's element count (0.3.1.0 degrau 10 /
 * raiz-comum §5.5 — measured to build with a silently corrupted stride before the fix, and to
 * honest-stop at the first index read once only the push side closed).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_literal_index() -> i64 {
    let xs: []str = ["one", "two", "three"]
    if xs.len != 3 { return 1 }
    if xs[0].len != 3 { return 2 }
    if xs[0] != "one" { return 3 }
    if xs[1] != "two" { return 4 }
    if xs[2] != "three" { return 5 }
    0
}

/**
 * f_fat_slice_push_in_loop — push `str` elements onto a `[]str` inside a loop, mirroring
 * `global_symbol_names`' own shape (the function 0.3.1.0 degrau 10 was measured in), each
 * element read back BY ITS OWN LENGTH afterward — a plausible length with the wrong bytes would
 * still be caught by the content check.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_push_in_loop() -> i64 {
    let names: []str = ["alpha", "beta", "gamma", "delta"]
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        out = teko::list::push(out, names[i])
        i++
    }
    if out.len != 4 { return 1 }
    if out[0].len != 5 { return 2 }
    if out[0] != "alpha" { return 3 }
    if out[3] != "delta" { return 4 }
    0
}

/**
 * f_str_contains_and_ends_with — `teko::str::contains`/`ends_with`, both `(str, str) -> bool`
 * (0.3.1.0 degrau 11 / raiz-comum §R5): before this degrau, `call_symbol` had no resolution for
 * either bare name, so a reached call honest-stopped ("builtin `contains` not yet lowered") —
 * first surfaced through `teko::assert::str_contains`'s own body, which every `.tkt` test file in
 * this project calls. A bool result needs no out-parameter-length twin — it fits the ordinary
 * single result register every scalar call already captures.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_contains_and_ends_with() -> i64 {
    if !teko::str::contains("hello world", "lo wo") { return 1 }
    if teko::str::contains("hello world", "xyz") { return 2 }
    if !teko::str::contains("hello", "") { return 3 }
    if !teko::str::ends_with("hello world", "world") { return 4 }
    if teko::str::ends_with("hello world", "worldx") { return 5 }
    if !teko::str::ends_with("hello", "") { return 6 }
    0
}

/**
 * f_str_slice_family — `teko::str::slice`/`slice_to`/`slice_from`, all `str`-returning (0.3.1.0
 * degrau 11 / raiz-comum §R5): before this degrau, each honest-stopped the same way `contains`
 * did. Unlike the predicate pair above, a `str` result IS fat, so each resolves to the runtime's
 * out-parameter-length twin (`tk_str_slice_len`/`tk_str_slice_to_len`/`tk_str_slice_from_len`)
 * through the SAME `lower_len_out_call` shape 0.3.1.0 degrau 9 built for `tk_str_concat_len`.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_slice_family() -> i64 {
    let s = "hello world"
    let mid = teko::str::slice(s, 6, 11)
    if mid.len != 5 { return 1 }
    if mid != "world" { return 2 }
    let head = teko::str::slice_to(s, 5)
    if head.len != 5 { return 3 }
    if head != "hello" { return 4 }
    let tail = teko::str::slice_from(s, 6)
    if tail.len != 5 { return 5 }
    if tail != "world" { return 6 }
    0
}

/**
 * AliasCorpusS — an alias of `str` (0.3.1.0 raiz A, crumb R0): the layout predicate
 * (`typeexpr_is_fat`) used to answer this ANNOTATION directly, matching neither its `[]T` nor its
 * bare-`str` arm, while the store predicate (`is_fat_type`) always saw the field VALUE's resolved
 * type — `str` — through the alias. `AliasCorpusHolder` measures the two predicates' disagreement
 * on the SAME field (raiz-comum memo §7-quater.3-bis).
 */
type AliasCorpusS = str

/**
 * AliasCorpusHolder — the aliased field FIRST, a plain `i64` sibling SECOND — exactly the byte
 * range `field_layout_size`'s 8-vs-16-byte disagreement let the fat field's length half spill
 * into.
 */
type AliasCorpusHolder = struct { s: AliasCorpusS; n: i64 }

/**
 * f_alias_fat_field — construct `AliasCorpusHolder` with a 5-byte aliased `str` field and a
 * sibling `n` set to a value distinct from that length, then assert every half reads back
 * correctly: the aliased field's `.len` and content, AND that the sibling was not corrupted by
 * the aliased field's own store.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_alias_fat_field() -> i64 {
    let h = AliasCorpusHolder { s = "abcde"; n = 41 }
    if h.n != 41 { return 1 }
    if h.s.len != 5 { return 2 }
    if h.s != "abcde" { return 3 }
    0
}

/**
 * OwnedFatCorpus — a GENERIC struct whose FIRST field is a bare type-parameter `T` and whose second
 * is a plain `i64` sibling (0.3.1.0 raiz A — fat-field layout unification). When `T` is stamped fat
 * (`OwnedFatCorpus<str>`), the field's SYNTACTIC annotation the old layout predicate read (`T`, a
 * name no type table registers) answered THIN — 8 bytes — while the store wrote the full 16-byte
 * `{ptr, len}` slot the value's RESOLVED `Str` type calls for, spilling the length half onto the
 * sibling. Sizing the field off `field_is_fat_resolved` (`typeexpr_is_fat` OR `is_fat_type` of the
 * resolved declared type) makes the two agree.
 */
type OwnedFatCorpus<T> = struct { value: T; sibling: i64 }

/**
 * f_owned_fat_field — construct `OwnedFatCorpus<str>` with a 5-byte fat first field and a sibling set
 * to a value distinct from that length, then assert every half reads back correctly: the fat field's
 * `.len` and content, AND that the sibling was not overwritten by the fat field's own store. The
 * layout==store witness for a bare-`T` fat field, the class the self-host's native crash belonged to.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_owned_fat_field() -> i64 {
    let h = OwnedFatCorpus<str> { value = "abcde"; sibling = 41 }
    if h.sibling != 41 { return 1 }
    if h.value.len != 5 { return 2 }
    if h.value != "abcde" { return 3 }
    0
}

/**
 * f_int_to_str — `teko::u64_to_str`/`teko::i64_to_str`, both `(iNN) -> str` (fat) (0.3.1.0 degrau
 * 12 / raiz-comum §R5): before this degrau, `native_builtin_symbol` had no entry for either bare
 * name, so a DIRECT call honest-stopped ("builtin `u64_to_str` not yet lowered") — first surfaced
 * through `teko::backend::reg_ref`'s own body, on the compiler's own self-build. The runtime's
 * out-parameter-length twins (`tk_u64_to_str_len`/`tk_i64_to_str_len`) already existed (built at
 * degrau 9) and were already reachable through `$"…{n}…"` STRING INTERPOLATION's own hardcoded
 * call — this fixture calls both builtins BARE, the path that was missing, and checks the
 * returned DIGITS (not merely that the build succeeds), including the two signed extremes whose
 * magnitude computation is the one place `tk_i64_to_str` could overflow if done naively.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_int_to_str() -> i64 {
    if teko::u64_to_str(0) != "0" { return 1 }
    if teko::u64_to_str(42) != "42" { return 2 }
    let u64_max: u64 = 18446744073709551615
    if teko::u64_to_str(u64_max) != "18446744073709551615" { return 3 }
    if teko::i64_to_str(0) != "0" { return 4 }
    if teko::i64_to_str(42) != "42" { return 5 }
    if teko::i64_to_str(-42) != "-42" { return 6 }
    let i64_max: i64 = 9223372036854775807
    if teko::i64_to_str(i64_max) != "9223372036854775807" { return 7 }
    let i64_min: i64 = -9223372036854775808
    if teko::i64_to_str(i64_min) != "-9223372036854775808" { return 8 }
    0
}

/**
 * gcd_subtract — Euclidean GCD by repeated subtraction, structured to mirror
 * a dominator-tree intersection's own shape EXACTLY: the function's
 * LAST statement is a bare `loop { … }` that never `break`s — every exit is an inner `return` —
 * around two NESTED loops that each DO `break`, one per "finger" walked toward the other. This is
 * the shape that stopped native lowering at 0.3.1.0 degrau 13: `lower_tail_non_expr`
 * (`src/lir/lower.tks`) treated a non-`return`-terminated tail as an internal invariant break,
 * when `lower_loop` always reports `terminated=false` for ANY loop (break or not) — the checker
 * itself makes NO claim about a non-expression tail (`check_trailing_value`'s own doc: "the guard
 * against false-rejecting a body that ends in a diverging loop/if/match"), trusting the programmer
 * exactly as the C emitter already does (`cg_stmt_c_terminates` + `__builtin_unreachable()`,
 * `codegen.tks:8659-9013`).
 *
 * @param x  the first operand (positive)
 * @param y  the second operand (positive)
 * @return   gcd(x, y)
 */
fn gcd_subtract(x: i64, y: i64) -> i64 {
    mut a = x
    mut b = y
    loop {
        if a == b { return a }
        loop { if a <= b { break }; a = a - b }
        loop { if b <= a { break }; b = b - a }
    }
}

/**
 * f_loop_tail_no_break — `gcd_subtract`'s own breakless-loop-tail shape, exercised by VALUE (not
 * merely "does it compile"): three GCD pairs, including the x==y edge (the outer loop's FIRST
 * iteration already satisfies `a == b`, so the two inner loops never run at all).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_loop_tail_no_break() -> i64 {
    if gcd_subtract(30, 18) != 6 { return 1 }
    if gcd_subtract(17, 5) != 1 { return 2 }
    if gcd_subtract(9, 9) != 9 { return 3 }
    0
}

/**
 * strip_leading_hash_lines — `gcd_subtract`'s breakless-loop-tail shape, one axis over
 * (scalar -> FAT): the LAST statement is a bare `loop { … }` that never `break`s, every exit an
 * inner `return`, but this function returns `str` instead of `i64` — the exact shape
 * `src/build/regression.tks::snippet_chunk_skip_attr_lines` uses in the compiler's own source.
 * Degrau 13 closed the scalar axis (`lower_tail_non_expr` falling back to `diverging_tail_value`);
 * the FAT axis (`lower_tail_non_expr_fat`) honest-stopped unconditionally until 0.3.1.0 degrau 20,
 * because a fat-typed if-expr-arm/function-body tail that only diverges through inner `return`s
 * never actually produces a (ptr, len) pair of its own to fall through with.
 *
 * Strips every leading line that starts with `#` (one per line, `\n`-terminated) off `text`,
 * returning whatever remains.
 *
 * @param text  the input, `\n`-joined lines
 * @return      `text` with every leading `#`-prefixed line removed
 */
fn strip_leading_hash_lines(text: str) -> str {
    mut rest = text
    loop {
        if rest.len == 0 || rest[0] != b'#' { return rest }
        mut k: u64 = 0
        loop {
            if k >= rest.len { break }
            if rest[k] == b'\n' { break }
            k = k + 1
        }
        if k >= rest.len { return "" }
        rest = teko::str::slice(rest, k + 1, rest.len)
    }
}

/**
 * f_fat_loop_tail_no_break — `strip_leading_hash_lines`'s own breakless-loop-tail shape,
 * exercised by VALUE (not merely "does it compile"): no leading `#` line, one, two consecutive
 * ones, an all-`#` input with no trailing newline (the `return ""` exit), and the empty string
 * (the FIRST loop iteration already satisfies the exit test, mirroring `f_loop_tail_no_break`'s
 * own x==y edge).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_loop_tail_no_break() -> i64 {
    if strip_leading_hash_lines("hello") != "hello" { return 1 }
    if strip_leading_hash_lines("#a\nhello") != "hello" { return 2 }
    if strip_leading_hash_lines("#a\n#b\nhello") != "hello" { return 3 }
    if strip_leading_hash_lines("#a") != "" { return 4 }
    if strip_leading_hash_lines("") != "" { return 5 }
    0
}

/** GBox<T> — a one-field generic wrapper, the shape `parser::Parsed<T>` (asm_parse's own return
 * payload) is: a plain generic struct, never a variant/enum in its own right. */
type GBox<T> = struct { value: T }

/**
 * make_gbox_i64 — a `GBox<i64> | error` producer: the exact union shape
 * `parser::parse_main_file` returns (`Parsed<MainFile> | error`), instantiated with `i64` so this
 * fixture needs no second file.
 *
 * @param ok  true to construct the payload, false to return the error arm
 * @return    `GBox<i64>` when `ok`, else an `error`
 */
fn make_gbox_i64(ok: bool) -> GBox<i64> | error {
    if !ok { return error { message = "no" } }
    GBox<i64> { value = 99 }
}

/**
 * make_gbox_str — the SAME generic union, instantiated with `str` instead — a second
 * instantiation of `GBox`'s base, exercised alongside `make_gbox_i64` to prove the case-name
 * resolution reads the SUBJECT'S OWN member list rather than remembering the last instance seen.
 *
 * @param ok  true to construct the payload, false to return the error arm
 * @return    `GBox<str>` when `ok`, else an `error`
 */
fn make_gbox_str(ok: bool) -> GBox<str> | error {
    if !ok { return error { message = "no" } }
    GBox<str> { value = "hi" }
}

/**
 * f_generic_variant_match — a `match` over a `Generic<T> | error` union: the exact shape
 * `teko::build::asm_parse` needed (`parser::Parsed<parser::MainFile> as x => x.node; error as e =>
 * return e`, 0.3.1.0 degrau 14). A generic instance's RESOLVED case is a mangled instance name
 * (`GBox__g__i64`), never the pattern's bare base (`GBox`) — the case-name lookup must recover the
 * base from the mangled name, not compare it verbatim. Two DIFFERENT instantiations (`i64`, `str`)
 * plus the `error` arm, checked by VALUE.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_generic_variant_match() -> i64 {
    match make_gbox_i64(true) {
        GBox<i64> as b => { if b.value != 99 { return 1 } }
        error => return 2
    }
    match make_gbox_i64(false) {
        GBox<i64> as b => return 3
        error as e => { if e.message != "no" { return 4 } }
    }
    match make_gbox_str(true) {
        GBox<str> as b => { if b.value != "hi" { return 5 } }
        error => return 6
    }
    match make_gbox_str(false) {
        GBox<str> as b => return 7
        error as e => { if e.message != "no" { return 8 } }
    }
    0
}

/**
 * f_last_index_of — `teko::str::last_index_of(str, str) -> u64 | error` (0.3.1.0 degrau 15 /
 * raiz-comum §R5): before this degrau, `native_builtin_symbol` had no entry for this bare name at
 * all, so a reached call honest-stopped ("builtin `last_index_of` not yet lowered") — first
 * surfaced through `teko::build::basename`'s own body. Unlike the degrau 11/12 families
 * (`bool`/`str` results), this builtin's REAL C ABI (`tk_rt_last_index_of`) returns a genuine
 * 2-eightbyte `{bool ok; uint64_t value}` struct, and its DECLARED Teko return type is a
 * `u64 | error` VARIANT — neither fat nor a plain scalar — so it needed its own bool-branch +
 * variant-wrapper construction (`lower_last_index_of_call`), not a resolver-table entry alone.
 * Checked by VALUE across the found/not-found/empty-needle/repeated-match axes, plus the
 * not-found arm's own message (empty, per this builtin's own "not-found is the only failure"
 * contract).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_last_index_of() -> i64 {
    match teko::str::last_index_of("hello world", "o") {
        u64 as i => { if i != 7 { return 1 } }
        error => return 2
    }
    match teko::str::last_index_of("hello world", "xyz") {
        u64 as i => return 3
        error as e => { if e.message != "" { return 4 } }
    }
    match teko::str::last_index_of("hello world", "") {
        u64 as i => { if i != 11 { return 5 } }
        error => return 6
    }
    match teko::str::last_index_of("aaa", "a") {
        u64 as i => { if i != 2 { return 7 } }
        error => return 8
    }
    0
}

/**
 * f_str_of_bytes — `teko::str_of_bytes([]byte) -> str` (fat) (0.3.1.0 degrau 16 / raiz-comum §R5):
 * found immediately after closing degrau 15's own `last_index_of` gap, while enumerating
 * `native_builtin_symbol`'s remaining holes — `str`/`str_of_bytes` (ONE checker registration, two
 * spellings, `checker/scope.tks`) had no entry either, first surfaced through
 * `teko::build::sanitize_ident`'s own body. Unlike `last_index_of`, this builtin's shape fits the
 * ESTABLISHED out-parameter-length molde exactly (`tk_str_of_bytes_len`, the SAME
 * `lower_len_out_call` shape `builtin_str_slice_symbol`/`builtin_int_to_str_symbol` already use) —
 * a resolver-table entry alone, no new lowering arm. Checked by VALUE, including the empty-slice
 * edge (a zero-length `str`, not a null/garbage pointer).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_of_bytes() -> i64 {
    let bs: []byte = [b'h', b'i', b'!']
    let s = str_of_bytes(bs)
    if s.len != 3 { return 1 }
    if s != "hi!" { return 2 }
    let empty: []byte = []
    let es = str_of_bytes(empty)
    if es.len != 0 { return 3 }
    if es != "" { return 4 }
    0
}

/**
 * f_host_info — `teko::os`/`teko::arch`/`teko::env::version`, all `() -> str` (fat), plus
 * `teko::mem::peak_rss() -> u64` (plain scalar) (0.3.1.0 degrau 17 / raiz-comum §R5): found while
 * closing degrau 15/16's own sibling search — the compiler's own `teko::build::target_os` calls
 * `os`/`arch` bare, immediately past the `str_of_bytes` gap. The three `str`-returning ones fit
 * the SAME out-parameter-length molde `str_of_bytes` does (`tk_rt_os_len`/`tk_rt_arch_len`/
 * `tk_rt_version_len`); `peak_rss` fits the ordinary scalar path directly (a whole 64-bit
 * register, no out-parameter needed at all). Checked against the KNOWN closed sets these
 * compile-time-constant strings draw from (never a host-specific literal, so the fixture stays
 * portable across the hosts this backend targets), a plausibly-bounded version-string LENGTH
 * (this project's own `own_native.tkp` declares no `version` field, so `teko::env::version()`
 * legitimately returns EMPTY here — the same on BOTH routes; measured, not assumed — so the
 * check is an upper bound, not "non-empty"), and a plausibly-bounded peak RSS (`u64` can never
 * read negative — the sanity check is an UPPER bound instead, ruling out a garbage/uninitialized
 * read).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_host_info() -> i64 {
    let os = teko::os()
    if os != "linux" && os != "macos" && os != "windows" && os != "unknown" { return 1 }
    let arch = teko::arch()
    if arch != "x86_64" && arch != "arm64" && arch != "unknown" { return 2 }
    let ver = teko::env::version()
    if ver.len > 64 { return 3 }
    let rss = teko::mem::peak_rss()
    if rss > 1099511627776 { return 4 }
    0
}

/**
 * RdPoint — the aggregate `ref`-deref target `f_ref_deref_assign` exercises: this backend
 * represents a struct VALUE as the address of its own storage (§ NATIVE-AGG-SLICE-BY-ADDRESS), so
 * writing `p.value = RdPoint { … }` through a `Ref<RdPoint>` must `memcpy` the new instance's bytes
 * into the handle's pointee storage rather than store the new instance's OWN address there — the
 * one write shape a struct/class field assignment never needed (a field's aggregate half is a
 * BOXED pointer slot; a reference's is not).
 *
 * @field x  the first coordinate
 * @field y  the second coordinate
 */
type RdPoint = struct { x: i64; y: i64 }

/**
 * rd_bump_scalar — write THROUGH a scalar `Ref<u64>` handle (0.3.1.0 degrau 18): `n.value` is
 * read back before being incremented, so a stale/garbage load (rather than the caller's true
 * current value) would drift the result away from the fixture's own expectation.
 *
 * @param n  the caller's counter, incremented in place
 */
fn rd_bump_scalar(ref n: u64) -> void {
    n.value = n.value + 1
}

/**
 * rd_bump_point — write THROUGH an aggregate `Ref<RdPoint>` handle: the new value is built from
 * the CURRENT one (`p.x`/`p.y`, read through the same handle) and stored back whole, proving both
 * that a read through the handle sees the caller's live fields and that the write lands on the
 * caller's OWN storage (not a fresh, disconnected copy).
 *
 * @param p  the caller's point, replaced in place
 */
fn rd_bump_point(ref p: RdPoint) -> void {
    p.value = RdPoint { x = p.x + 1; y = p.y * 2 }
}

/**
 * rd_set_msg — write THROUGH a FAT `Ref<str>` handle: a `mut str` local is UNCONDITIONALLY
 * frame-slot-bound the moment it is declared (the list-builtin degrau, independent of `ref`), so
 * the auto-ref call site must pass THAT slot's address — not the string's own content pointer —
 * or the write lands on the wrong memory entirely.
 *
 * @param s  the caller's message, replaced in place
 * @param v  the new message
 */
fn rd_set_msg(ref s: str, v: str) -> void {
    s.value = v
}

/**
 * rd_tick_fn — the EXACT shape of `teko::build::checker_tick_fn` (0.3.1.0 degrau 18's own
 * blocking construct): two `ref` parameters captured by a returned LAMBDA, each written through
 * `.value =` on every call. The caller's two `mut` locals must observe every write made through
 * the closure, arbitrarily long after `rd_tick_fn` itself has returned.
 *
 * @param last   the caller's tick counter, updated to the latest `n`
 * @param total  the caller's total counter, updated to the latest `m`
 * @return       a closure the caller invokes per tick
 */
fn rd_tick_fn(ref last: u64, ref total: u64) -> (u64, u64) -> void {
    (n: u64, m: u64) => {
        last.value = n
        total.value = m
    }
}

/**
 * rd_loop_sum — write THROUGH a scalar `Ref<u64>` handle from INSIDE a `loop`, stressing the
 * merge machinery a scalar reference's own address must survive unchanged across (its ADDRESS is
 * loop-invariant; only the memory it points to changes on each iteration).
 *
 * @param acc  the caller's running sum, accumulated in place
 * @param n    the exclusive upper bound of the `0..n` range summed
 */
fn rd_loop_sum(ref acc: u64, n: u64) -> void {
    mut i: u64 = 0
    loop {
        if i >= n { break }
        acc.value = acc.value + i
        i = i + 1
    }
}

/**
 * f_ref_deref_assign — reference deref-assignment (0.3.1.0 degrau 18): `ref` parameters and the
 * `.value =` write-through they admit, across every memory shape this backend gives a value
 * (scalar, aggregate, fat) plus the CAPTURED-BY-A-RETURNED-CLOSURE shape the compiler's own
 * `checker_tick_fn` needed to self-build. Every check compares against the VALUE the write was
 * supposed to produce (never merely "did it compile") — a write that reached the wrong address
 * would silently corrupt one of these checks instead of leaving it looking like a pass.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_ref_deref_assign() -> i64 {
    mut n: u64 = 5
    rd_bump_scalar(n)
    if n != 6 { return 1 }
    rd_bump_scalar(n)
    if n != 7 { return 2 }
    mut p = RdPoint { x = 1; y = 2 }
    rd_bump_point(p)
    if p.x != 2 { return 3 }
    if p.y != 4 { return 4 }
    rd_bump_point(p)
    if p.x != 3 { return 5 }
    if p.y != 8 { return 6 }
    mut s: str = "a"
    rd_set_msg(s, "hello")
    if s.len != 5 { return 7 }
    if s != "hello" { return 8 }
    rd_set_msg(s, "hi")
    if s.len != 2 { return 9 }
    if s != "hi" { return 10 }
    mut last: u64 = 0
    mut total: u64 = 0
    let tick = rd_tick_fn(last, total)
    tick(3, 10)
    if last != 3 { return 11 }
    if total != 10 { return 12 }
    tick(7, 20)
    if last != 7 { return 13 }
    if total != 20 { return 14 }
    mut acc: u64 = 0
    rd_loop_sum(acc, 5)
    if acc != 10 { return 15 }
    0
}

/**
 * f_static_format_spec — a STATIC interpolation format spec (`$"{v:F2}"`), whose LEADING
 * character selects one of `emit_interp`'s own ten runtime `tk_fmt_*` families (`codegen.tks`,
 * the oracle this backend's lowering mirrors) (0.3.1.0 degrau 19): before this degrau,
 * `lower_interp_hole_fat`'s `TFSpecStatic` arm honest-stopped UNCONDITIONALLY ("static
 * interpolation format spec not yet lowered"), first surfaced through the compiler's own
 * `teko::build::arith_cast_rate_line` (`{pct:F2}%`).
 *
 * `pct` there is `f64`, and a FLOAT static spec DOES lower correctly at this backend's own N1
 * stage (measured directly: `$"{x:F2}"` on an `f64` produces a `call @tk_fmt_f_len(...)` LIR
 * shape identical in kind to the integer families below, `lwt_lowers_static_float_family_spec_…`
 * in `src/lir/lower_test.tkt`) — but it cannot yet RUN here: every float value still
 * honest-stops at the pre-existing, unrelated `isel x86-64: B1-fp` epic the moment it needs an
 * XMM register, regardless of format specs. This fixture, which MUST build and run on both
 * routes, therefore checks every INTEGER-hole family the static spec accepts: `d` (zero-padded
 * decimal, explicit AND default width), `x`/`X` (hex, both cases), `b` (binary), and `n`
 * (thousands separator on an int) — plus the two coercion edges `codegen.tks`'s own dispatch
 * commits to (a SIGNED negative value through the ALWAYS-`uint64_t` `x`/`b` cast, and an
 * UNSIGNED value through the ALWAYS-`int64_t` `d` cast) — every one BY VALUE, expected strings
 * cross-checked against `examples/regressions/bulk/src/q080_format_spec_families/body.tks`
 * (the SAME families, proven correct on the native routes already).
 *
 * Every hole is a `mut` local, never reassigned — the SAME fold-opaque idiom `f_arith` itself
 * established at the top of this file — so the check exercises the RUNTIME lowering and not the
 * comptime folder, which already renders every one of these integer families byte-identical on
 * a bare literal (`checker::comptime_fold`'s own `cf_static_spec_ok`).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_static_format_spec() -> i64 {
    mut n: i64 = 255
    if $"{n:D5}" != "00255" { return 1 }
    if $"{n:D}" != "255" { return 2 }
    if $"{n:X}" != "FF" { return 3 }
    if $"{n:x}" != "ff" { return 4 }
    if $"{n:b}" != "11111111" { return 5 }
    mut big: i64 = 1234567
    if $"{big:N}" != "1,234,567" { return 6 }
    mut neg: i64 = -1
    if $"{neg:X}" != "FFFFFFFFFFFFFFFF" { return 7 }
    if $"{neg:b}" != "1111111111111111111111111111111111111111111111111111111111111111" { return 8 }
    mut u: u64 = 10
    if $"{u:D3}" != "010" { return 9 }
    if $"{u:X}" != "A" { return 10 }
    0
}

/**
 * f_dynamic_format_spec — a DYNAMIC interpolation format spec (`$"{v:[spec]}"`, the spec text
 * itself a RUNTIME `str` argument), the sibling of `f_static_format_spec` this degrau closed in
 * the SAME wagon: `lower_interp_hole_fat`'s `TFSpecDynamic` arm honest-stopped the same way, and
 * closes the same way — `lower_interp_hole_dynamic_fat` flattens the hole's value plus the spec
 * string's (ptr, len) pair through one of the three `tk_fmt_dyn_*_len` twins, split only by the
 * hole's own numeric family. This project's own source never writes a dynamic spec (searched:
 * `examples/regressions/bulk`'s own `q080_format_spec_families` is the only user in the whole
 * tree, and it targets the native routes only), so THIS fixture is the first to exercise it
 * natively — the same INTEGER-family subset `f_static_format_spec` covers (the float family
 * being blocked by the SAME pre-existing `B1-fp` epic, not a gap of this degrau's own), each
 * spec string itself a `mut` local so neither the VALUE nor the SPEC TEXT can be folded away.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_dynamic_format_spec() -> i64 {
    mut n: i64 = 255
    mut spec_d5: str = "D5"
    if $"{n:[spec_d5]}" != "00255" { return 1 }
    mut spec_x_up: str = "X"
    if $"{n:[spec_x_up]}" != "FF" { return 2 }
    mut spec_x_lo: str = "x"
    if $"{n:[spec_x_lo]}" != "ff" { return 3 }
    mut spec_b: str = "b"
    if $"{n:[spec_b]}" != "11111111" { return 4 }
    mut big: i64 = 1234567
    mut spec_n: str = "N"
    if $"{big:[spec_n]}" != "1,234,567" { return 5 }
    mut u: u64 = 10
    if $"{u:[spec_x_up]}" != "A" { return 6 }
    0
}

/**
 * ces_char_word — a `char` produced by a CALL, so the equality's operands are not both literals
 * the folder could have collapsed before the backend ever saw them (mirrors `str_eq_word`'s own
 * reasoning, one line up in this file, for the `char` sibling).
 *
 * @param n  the switch selecting the codepoint (0 = `a`, 1 = `b`, anything else = `a` again)
 * @return   the selected codepoint
 */
fn ces_char_word(n: i64) -> char {
    if n == 0 { return c'a' }
    if n == 1 { return c'b' }
    c'a'
}

/**
 * f_char_and_slice_equality — `char ==`/`!=` and `[]T ==`/`!=` lowered natively (0.3.1.0
 * igualdade-char-slice), mirroring `f_str_equality`'s own shape one function above.
 *
 * `char` had NO comparison at all: the C route's raw `==` rejected a `tk_char` struct outright
 * (`invalid operands to binary ==`), and the native route's `lower_compare` asked `prim_kind_of`
 * for `char`'s PrimKind and found none (a `char` here is a `{ptr,len}` VIEW, not a fixed-width
 * scalar). `[]T == []T` had the SAME hole for every element type — even `[]i64` — because
 * `emit_compare`'s content-equality detour only ever checked for `str`.
 *
 * `[]T` NOW COMPARES BY VALUE, mirroring **Go** (owner ruling 2026-07-29): same length AND every
 * element equal, element-by-element — Go compares a slice by value with no ceremony, and Teko has
 * no derived `PartialEq` a Rust-shaped alternative would need. This corpus member does NOT
 * construct its `[]T` operands by returning an array LITERAL across a function boundary — that
 * crosses an UNRELATED, pre-existing native-backend gap (an array literal's backing store is a
 * STACK alloca in the producing function's own frame, which a SUBSEQUENT call is free to reuse,
 * dangling the first result's content the moment a second fat-returning call runs before the
 * first is dereferenced; found while writing this fixture, reported rather than fixed here, since
 * it is not a comparison defect — a bare `.len` read or a same-function-scope compare never
 * triggers it, which is why every operand below is either a same-function local or a `char`
 * (a plain scalar in this backend, never stack-escaped).
 *
 * The rows mirror `f_str_equality`'s own list, generalized to two more shapes: two EQUAL values,
 * two DIFFERENT values (last element only, so a prefix-only compare would lie), a shorter vs a
 * longer value (so a length-only compare would still need the content check to fail correctly),
 * the empty pair, and multi-byte content (`café🐝` — U+00E9 then U+1F41D, 2 and 4 UTF-8 bytes) so
 * a byte-width assumption cannot silently pass.
 *
 * @return 0 when every comparison answers correctly, else the number of the failing check
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn f_char_and_slice_equality() -> i64 {
    if !(ces_char_word(0) == ces_char_word(0)) { return 1 }
    if ces_char_word(0) == ces_char_word(1) { return 2 }
    if ces_char_word(0) != ces_char_word(0) { return 3 }
    if !(ces_char_word(0) != ces_char_word(1)) { return 4 }
    if !(c'é' == c'é') { return 5 }
    if c'é' == c'🐝' { return 6 }
    if !(c'é' != c'🐝') { return 7 }

    let ints_a = [1, 2, 3]
    let ints_b = [1, 2, 3]
    let ints_c = [1, 2, 4]
    let ints_d = [1, 2, 3, 4]
    let ints_empty_1: []i64 = []
    let ints_empty_2: []i64 = []
    if !(ints_a == ints_b) { return 8 }
    if ints_a == ints_c { return 9 }
    if ints_a == ints_d { return 10 }
    if !(ints_a != ints_c) { return 11 }
    if !(ints_empty_1 == ints_empty_2) { return 12 }
    if ints_empty_1 == ints_a { return 13 }

    let strs_a = ["café🐝", "beta"]
    let strs_b = ["café🐝", "beta"]
    let strs_c = ["café🐝", "betb"]
    let strs_d = ["café🐝", "beta", "gamma"]
    let strs_empty_1: []str = []
    let strs_empty_2: []str = []
    if !(strs_a == strs_b) { return 14 }
    if strs_a == strs_c { return 15 }
    if strs_a == strs_d { return 16 }
    if !(strs_a != strs_c) { return 17 }
    if !(strs_empty_1 == strs_empty_2) { return 18 }
    if strs_empty_1 == strs_a { return 19 }

    let chars_a = [c'c', c'a', c'f', c'é', c'🐝']
    let chars_b = [c'c', c'a', c'f', c'é', c'🐝']
    let chars_c = [c'c', c'a', c'f', c'e']
    if !(chars_a == chars_b) { return 20 }
    if chars_a == chars_c { return 21 }
    if !(chars_a != chars_c) { return 22 }
    0
}

/**
 * f_bytes_of_str — `teko::text::bytes_of_str(str) -> []byte` (fat, zero-copy) (0.3.1.0 degrau 21 /
 * raiz-comum §R5): `native_builtin_symbol` had no entry for this bare name at all, so a reached
 * call honest-stopped ("builtin `bytes_of_str` not yet lowered") — first surfaced through this
 * project's own standalone probe (`docs/memory/text-bytes-escape-hatch-0.3.1.0.md`), not through
 * the compiler's own self-build. Fits the ESTABLISHED out-parameter-length molde exactly
 * (`tk_bytes_of_str_len`, the SAME `lower_len_out_call` shape `builtin_str_of_bytes_symbol`
 * already uses for its own reverse direction) — a resolver-table entry alone, no new lowering arm.
 *
 * Checked by VALUE with `café🐝` (an accented letter, 2 UTF-8 bytes, plus an emoji, 4 bytes,
 * beside two 1-byte ASCII letters) — the sonda this whole lane's docs measure by, so a
 * length/boundary bug cannot hide behind an all-ASCII fixture — plus the empty-string edge (a
 * zero-length view, not a null/garbage pointer).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_bytes_of_str() -> i64 {
    let s = "café🐝"
    let bs = teko::text::bytes_of_str(s)
    if bs.len != 9 { return 1 }
    if str_of_bytes(bs) != s { return 2 }
    let empty = ""
    let ebs = teko::text::bytes_of_str(empty)
    if ebs.len != 0 { return 3 }
    0
}

/**
 * f_str_from_utf8 — `teko::text::str_from_utf8([]byte) -> str | error` (0.3.1.0 degrau 21 /
 * raiz-comum §R5): the fat-payload sibling of degrau 15's `last_index_of` (`u64 | error`) — its
 * runtime ABI (`tk_ffi_sres`, three eightbytes) does not fit this backend's single-result-register
 * `LCall` either, so it needed its own bool-branch + variant-wrapper construction
 * (`lower_str_from_utf8_call`), not a resolver-table entry alone; the ok arm writes a FAT member
 * straight into the wrapper (no boxing — `store_fat_variant_payload_pair`), the error arm boxes an
 * `error { message = … }` the SAME way `last_index_of`'s own not-found arm does.
 *
 * Checked by VALUE across the round-trip (`café🐝`, matching `f_bytes_of_str`'s own sonda so the
 * two fixtures reconcile: `bytes_of_str(s).len == 9` and this round-trip's own decoded `str` equals
 * `s` byte for byte) and the invalid-UTF-8 arm (a lone continuation byte with no lead byte, and a
 * lead byte missing its continuation) — each asserting the EXACT "invalid UTF-8" message the
 * runtime's own `tk_rt_str_from_utf8` constant carries, not merely that the call failed.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_from_utf8() -> i64 {
    let s = "café🐝"
    let bs = teko::text::bytes_of_str(s)
    match teko::text::str_from_utf8(bs) {
        str as r => { if r != s { return 1 } }
        error => return 2
    }
    let lone_continuation: []byte = [0x80 to byte, 0x41 to byte]
    match teko::text::str_from_utf8(lone_continuation) {
        str => return 3
        error as e => { if e.message != "invalid UTF-8" { return 4 } }
    }
    let truncated_lead: []byte = [0x41 to byte, 0xE2 to byte, 0x82 to byte]
    match teko::text::str_from_utf8(truncated_lead) {
        str => return 5
        error as e => { if e.message != "invalid UTF-8" { return 6 } }
    }
    0
}

/**
 * f_error_diagnostic_fields — the six readable fields of the built-in `error` (0.3.1.0 degrau
 * 22).
 *
 * Asserts by VALUE what the C route already guarantees through `tk_error_make`: an
 * `error { message = … }` literal has `line`/`col` at `0` and `file`/`expected`/`actual` empty.
 * Before this degrau the native backend modeled only `message`, and reading `line` was a
 * compile-time stop; a grown layout WITHOUT zeroing the other five fields would have read
 * garbage from the fresh frame slot instead — so this fixture asserts the ZERO, not merely that
 * it compiled.
 *
 * The variant-wrapped arm exercises the interaction with the degrau 15/21 24-byte uniform
 * wrapper: the 72-byte payload is boxed by ADDRESS, so the wrapper itself never grows.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_error_diagnostic_fields() -> i64 {
    let e = error { message = "x" }
    if e.line != 0 { return 1 }
    if e.col != 0 { return 2 }
    if e.file != "" { return 3 }
    if e.expected != "" { return 4 }
    if e.actual != "" { return 5 }
    if e.message != "x" { return 6 }
    match mk_error_union() {
        str => return 7
        error as w => {
            if w.line != 0 { return 8 }
            if w.message != "y" { return 9 }
        }
    }
    0
}

/**
 * mk_error_union — a `str | error` that always takes the error member, to exercise the `error`
 * payload boxed inside the 24-byte variant wrapper.
 *
 * @return str|error  always the `error` member
 * @throws  always
 */
fn mk_error_union() -> str | error { error { message = "y" } }

/**
 * f_err_loc — `teko::error::err_loc(error, u32, u32) -> error` (E2, 0.3.1.0 degrau 22): a COPY of
 * its `error` argument with `line`/`col` overwritten.
 *
 * Asserts the adorned copy's three fields by VALUE, AND that the source `error` was NOT mutated
 * (`orig.line`/`orig.col` still `0` after the call) — `tk_error_loc` (`teko_rt.h`) returns a
 * modified copy on the C route, and this backend represents an `error` value by the ADDRESS of
 * its slot, so adorning in place would have mutated the caller's own binding, diverging from the
 * C route silently.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_err_loc() -> i64 {
    let orig = error { message = "boom" }
    let adorned = teko::error::err_loc(orig, 7, 3)
    if adorned.line != 7 { return 1 }
    if adorned.col != 3 { return 2 }
    if adorned.message != "boom" { return 3 }
    if orig.line != 0 { return 4 }
    if orig.col != 0 { return 5 }
    0
}

/**
 * f_err_typed — `teko::error::err_typed(error, str, str) -> error` (E2, 0.3.1.0 degrau 22): a
 * COPY of its `error` argument with `expected`/`actual` overwritten (the fat-field twin of
 * `err_loc`'s two scalar fields).
 *
 * Chains `err_typed(err_loc(e, l, c), exp, act)` — the ONE site in the compiler where the two
 * compose (`surface_at`) — so `line` survives THROUGH the second adornment, and asserts that the
 * `err_loc`-adorned source was NOT further mutated by `err_typed`.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_err_typed() -> i64 {
    let orig = teko::error::err_loc(error { message = "mismatch" }, 11, 4)
    let adorned = teko::error::err_typed(orig, "i64", "str")
    if adorned.expected != "i64" { return 1 }
    if adorned.actual != "str" { return 2 }
    if adorned.line != 11 { return 3 }
    if adorned.message != "mismatch" { return 4 }
    if orig.expected != "" { return 5 }
    if orig.actual != "" { return 6 }
    0
}

/**
 * takes_bool_arg — a variant-member comparison used as a CALL ARGUMENT position: the comparison's
 * bool result flows into an ordinary parameter, exercising the SAME lowering an `if`/`let` site
 * uses but through a call-argument slot.
 *
 * @param b  the already-computed comparison result
 * @return   1 when `b` is true, else 0
 */
fn takes_bool_arg(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

/**
 * eq_null_ret — a variant-member comparison used as a function RETURN position: the comparison's
 * bool result is the function's own trailing (return) value.
 *
 * @param a  an `i32 | null` value to test against `null`
 * @return   whether `a` currently holds `null`
 */
fn eq_null_ret(a: i32 | null) -> bool {
    a == null
}

/**
 * f_variant_member_compare — the `a != null` / `a == null` combinatorics (`i32 | null`,
 * cargo/0.3.1.0-null-adopt): `if`, `let`, call-argument, and return position, over both a PRESENT
 * and an ABSENT (`null`) value, plus the numeric-literal sibling (`a != 5` / `a == 5`) — the same
 * root (`adopt_binop_operands`'s literal retyping) and the same backend lowering (a tagged union's
 * `.tag`/`.as.<key>` comparison) close both.
 *
 * Migrated here from `regressor.tkr`'s `cases/variant_member_compare.tks` (cargo/0.3.1-dissolver-
 * bulk, 2026-07-29): the scenario is a LANGUAGE gap (fails identically on both backend routes, no
 * differential oracle), not a term used in the compiler's OWN product source, so it never actually
 * satisfied the regressor's rule 1 (a regression of a term used in the compiler's own Teko sources
 * lives strictly in `regressor.tkr`) — it sat at the project root only because its two better homes
 * were both unavailable at the time (`bulk` was broken, and this project's own exit-code budget was
 * full). Both obstacles are gone: `bulk` is dissolved and this project's budget now runs past 56.
 *
 * @return 0 on success; a distinct non-zero code names which check diverged
 */
fn f_variant_member_compare() -> i64 {
    let some: i32 | null = 7
    let none: i32 | null = null

    if some == null { return 1 }
    if some != null { } else { return 2 }
    if none != null { return 3 }
    if none == null { } else { return 4 }

    let l1: bool = some != null
    if !l1 { return 5 }
    let l2: bool = none == null
    if !l2 { return 6 }

    if takes_bool_arg(some != null) != 1 { return 7 }
    if takes_bool_arg(none == null) != 1 { return 8 }

    if eq_null_ret(some) { return 9 }
    if !eq_null_ret(none) { return 10 }

    if some != 7 { return 11 }
    if some == 7 { } else { return 12 }

    0
}

/**
 * wide_product — a `u32 * u32` multiply widened through `u64` BEFORE the multiply, so the result
 * cannot overflow the narrower operand width (0.3.1.0 D1 boundary-widen-cast).
 *
 * @param a  the first `u32` factor, cast to `u64` before the multiply
 * @param b  the second `u32` factor, multiplied at `u64` width
 * @return   the full-width `u64` product
 */
fn wide_product(a: u32, b: u32) -> u64 { (a to u64) * b }

/**
 * f_d1_boundary_widen_cast_compiles — a `u32 to u64` widening cast used as the LHS of a multiply
 * against a bare `u32` RHS compiles and lowers correctly (0.3.1.0 D1 audit, migrated from `bulk`'s
 * `q185_d1_boundary_widen_cast_compiles`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the low byte of the product is wrong
 */
fn f_d1_boundary_widen_cast_compiles() -> i64 {
    if (wide_product(7 to u32, 6 to u32) & 255) != 42 { return 1 }
    0
}

/**
 * spread_di — a `u32`-to-`i64` cast pair used identically at an ARITHMETIC site (the subtraction)
 * and a COMPARISON site (the `<`) over the SAME two operands — the D1 audit's parity check: before
 * the shared predicate, the arithmetic site compiled and the comparison site was a hard error.
 *
 * @param a  the minuend/left comparison operand, cast to `i64`
 * @param b  the subtrahend/right comparison operand, cast to `i64`
 * @return   42 when the subtraction is negative AND the comparison agrees it is; else 0
 */
fn spread_di(a: u32, b: u32) -> i64 {
    let d = (a to i64) - (b to i64)
    if d < 0 && (a to i64) < (b to i64) { return 42 }
    0
}

/**
 * f_d1_cast_pair_parity — the arithmetic-site/comparison-site D1 cast pair agree over the same
 * operands (0.3.1.0 D1 audit, migrated from `bulk`'s `q186_d1_cast_pair_parity_between_arith_and`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 42 on success (matching the original fixture's own asserted value)
 */
fn f_d1_cast_pair_parity() -> i64 {
    spread_di(1 to u32, 2 to u32)
}

/**
 * bump_through — forwards an exclusive `ref` PARAMETER into a second, LOCAL `ref` binding over the
 * SAME referent type, then writes through the forwarded ref. The LEGITIMATE `ref`-to-`ref` forward
 * (same referent type) must keep compiling — the shape the original wagon shipped without a
 * fixture for, which is why the missing `type_eq` check went unnoticed (0.3.1.0 audit A-S3/B-S3).
 *
 * @param p  the caller's `i64` referent, forwarded through a second local `ref`
 */
fn bump_through(ref p: i64) -> void {
    ref q: i64 = p
    q = 42
}

/**
 * probe_mcni — drives `bump_through` over a local `mut` and reads back the write-through.
 *
 * @return the referent's value after `bump_through` (42 on success)
 */
fn probe_mcni() -> i64 {
    mut n: i64 = 1
    bump_through(n)
    n
}

/**
 * f_ref_forwarding_same_referent_compiles — a `ref` parameter forwarded into a second local `ref`
 * over the same referent type compiles and writes through correctly (migrated from `bulk`'s
 * `q187_ref_forwarding_same_referent_compiles`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 42 on success (matching the original fixture's own asserted value)
 */
fn f_ref_forwarding_same_referent_compiles() -> i64 {
    probe_mcni()
}

/**
 * f_tilde_concat — the `~` string-concatenation operator over every string-literal FORM this
 * corpus spells: plain, raw (`@"..."`), verbatim-multiline (`@"""..."""`), interpolated (`$"..."`),
 * interpolated-multiline, raw-interpolated (`$@"..."`), and combinations with no interpolation
 * holes at all — each concatenated with a plain literal so the operator's own lowering runs at
 * every producer shape (migrated from `bulk`'s `q189_tilde_concat`, cargo/0.3.1-dissolver-bulk
 * 2026-07-29). Several of the literals below are multi-line: their CONTENT is measured by this
 * check, so re-indenting them changes the expected sum.
 *
 * @return 0 on success, 1 if the summed length of every concatenation disagrees with the fixture's
 *         own measured total (198)
 */
fn f_tilde_concat() -> i64 {
    let x = "hello"
    let y = "world"
    let a = "lit" ~ "eral" ~ "-fold"
    let b = x ~ " " ~ y
    let c = "pre-" ~ "fix-" ~ x ~ "-suf" ~ "-fix"

    let name = "world"
    let m1 = "foo" ~ "bar"
    let m2 = @"C:\raw" ~ "-tail"
    let m3 = """multi
line""" ~ "-tail"
    let m4 = @"""verbatim
multi""" ~ "-tail"
    let m5 = $"hi {name}" ~ "!"
    let m6 = $"""hi
{name}""" ~ "!"
    let m7 = $@"raw {name}\n" ~ "!"
    let m8 = $@"""raw
{name}""" ~ "!"
    let m9 = "pre-" ~ @"""mid
part""" ~ name ~ "-post"
    let m10 = $"no holes here" ~ "-tail"
    let m11 = $@"""no holes
multiline""" ~ "-tail"

    let total = a.len + b.len + c.len + m1.len + m2.len + m3.len + m4.len + m5.len + m6.len + m7.len + m8.len + m9.len + m10.len + m11.len
    if total != 198 { return 1 }
    0
}

/**
 * grow_bridge — grow `x` by appending `v`, mutating `x` IN-PLACE through the exclusive mutable
 * reference `ref x` (0.3.1 adoption — a byte-identical LOCAL copy of `teko::list::grow`; the
 * compiler-tree stdlib symbol is not addressable from a user project, so the fixture re-declares
 * the contract). Write-through preserves value semantics: `push` is a checker builtin whose
 * argument typing does not yet auto-deref a bare `ref` argument, so the read stays explicit
 * `x.value` (still legal — only the `Ref<T>` type name is hidden, not the accessor).
 *
 * @param x  the target slice, referenced mutably and exclusively (`ref x`)
 * @param v  the element to append, of the slice's concrete `T`
 */
fn grow_bridge<T>(ref x: []T, v: T) -> void {
    x.value = teko::list::push(x.value, v)
}

/**
 * f_list_grow_bridge — a generic `ref`-taking helper grows a slice write-through, in place
 * (migrated from `bulk`'s `q190_list_grow_bridge`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_list_grow_bridge() -> i64 {
    mut x: []i64 = [1, 2]
    grow_bridge(x, 3)
    if x.len != 3 { return 1 }
    if x[0] != 1 { return 1 }
    if x[1] != 2 { return 1 }
    if x[2] != 3 { return 1 }
    0
}

/**
 * arena_budget_sum — a fn carrying `#arena_size(4096)`, the additive, non-`unsafe` per-function
 * arena-budget directive (0.3.1 SW1 crumb `#453`). Its own frame region opens as an INDEPENDENT
 * tree root (`tk_region_new(NULL)`), never a child of the shared process root — the owner's
 * isolate-boundary ruling (2026-07-27): a function that declares its own arena is its own isolation
 * boundary, "como se fosse outro programa" (as if it were another program). The workload below (an
 * 8-element list, summed) allocates well under the declared 4096-byte budget: sizing accuracy is
 * the DEVELOPER's job by ruling — the compiler only wires the declared number through, it never
 * infers one.
 *
 * @return the deterministic sum the driver checks (0+1+…+7 == 28)
 */
#arena_size(4096)
fn arena_budget_sum() -> i64 {
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= 8 { break }
        xs = teko::list::push(xs, i)
        i = i + 1
    }
    mut total: i64 = 0
    mut j: u64 = 0
    loop {
        if j >= xs.len { break }
        total = total + xs[j]
        j = j + 1
    }
    total
}

/**
 * f_arena_size_directive_ok — `#arena_size(N)` wires an independent per-function arena budget
 * through to the runtime, and ordinary list accumulation inside it still round-trips correctly
 * (migrated from `bulk`'s `q200_arena_size_directive_ok`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the accumulated sum disagrees with the expected 28
 */
fn f_arena_size_directive_ok() -> i64 {
    if arena_budget_sum() != 28 { return 1 }
    0
}

/**
 * pub extern unsafe fn c_abs — the frontier's spelling PARSES, CHECKS, LINKS, and RUNS (0.3.1.0
 * C0, c-types-and-marshalling-0.3.1.md §4), pinning the doc-comment correction at
 * `src/parser/parse_decl.tks::consume_unsafe_modifier`: `extern` is consumed FIRST, `unsafe` is
 * consumed second and threads `is_unsafe` through to the `Function` node unchanged. Migrated from
 * `bulk`'s `q191_c_extern_unsafe_accepted` (cargo/0.3.1-dissolver-bulk, 2026-07-29) — the first
 * fixture in this tree to mark a raw-libc extern `unsafe` and prove the marker survives to a
 * linked, running binary.
 *
 * @param x  the value to negate before taking its absolute value
 * @return   `abs(x)`, computed by the linked libc symbol
 */
pub extern unsafe fn c_abs(x: i32) -> i32 = "abs"

/**
 * f_c_extern_unsafe_accepted — `pub extern unsafe fn … = "sym"` parses, checks, links and runs
 * (migrated from `bulk`'s `q191_c_extern_unsafe_accepted`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the linked `abs` call disagrees with the expected magnitude
 */
fn f_c_extern_unsafe_accepted() -> i64 {
    let negated: i32 = -42
    if c_abs(negated) != 42 { return 1 }
    0
}

/** A LOCAL COPY of `teko::c_types`'s `c_int` alias (`docs/design/c-types-and-marshalling-0.3.1.md`
    §5.1, crumb C1) — a regression fixture cannot `use` the compiler's own stdlib. */
pub type c_int = i32

/** See `c_int`'s doc-comment — the unsigned 8-bit twin under test here. */
pub type c_uchar = u8

/** See `c_int`'s doc-comment — the 64-bit twin under test here. */
pub type c_ulonglong = u64

/**
 * round_trip_int — receives and returns the `c_int` alias unchanged — the §2.1 measurement this
 * fixture exists to bank: no alias to a bare PRIMITIVE existed anywhere in the corpus before this
 * design, and the resolution path (`resolve_named` -> `builtin_type`) is mechanically identical to
 * an alias targeting a slice/union/named type but was, until now, unproven.
 *
 * @param i  passed straight through
 * @return   the same value, unchanged
 */
fn round_trip_int(i: c_int) -> c_int {
    i
}

/** See `round_trip_int` — the `u8` twin. */
fn round_trip_uchar(u: c_uchar) -> c_uchar {
    u
}

/** See `round_trip_int` — the `u64` twin. */
fn round_trip_ulonglong(n: c_ulonglong) -> c_ulonglong {
    n
}

/**
 * f_c_types_alias_identity — a value assigned THROUGH each of three `c_types` aliases (spanning
 * sign and width: `c_int`/`c_uchar`/`c_ulonglong`) and back is unchanged, and each alias is exactly
 * its aliased primitive — no wider, no narrower (migrated from `bulk`'s
 * `q192_c_types_alias_identity`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the round-tripped total disagrees with the expected 7
 */
fn f_c_types_alias_identity() -> i64 {
    let i: c_int = 5
    let u: c_uchar = 2
    let n: c_ulonglong = 0
    let ri = round_trip_int(i)
    let ru = round_trip_uchar(u)
    let rn = round_trip_ulonglong(n)
    let total: i32 = ri + ru + (rn to i32)
    if total != 7 { return 1 }
    0
}

/**
 * f_qualified_optional_cross_ns — same-bare-name types (`aa::Thing`/`bb::Thing`) coexist across
 * namespaces in optional and named-variant position (issues #109/#149; migrated from `bulk`'s
 * `p_qualified_optional`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 22
 */
fn f_qualified_optional_cross_ns() -> i64 {
    if qualified_optional_ns::scenario() != 22 { return 1 }
    0
}

/**
 * f_member_const_cross_ns_pub_inherit — a `pub` member const reaches across namespaces through an
 * inheriting subclass declared in a DIFFERENT namespace (issue #594 crumb 7; migrated from `bulk`'s
 * `p_member_const_cross_ns_pub_inherit`, cargo/0.3.1-dissolver-bulk 2026-07-29). `Base` lives in
 * this project's ROOT namespace and `Sub` in `sub`, so the boundary the assertion depends on is a
 * real one — with a single namespace the claim would be vacuous.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_member_const_cross_ns_pub_inherit() -> i64 {
    let s = sub::Sub::make(7)
    if sub::reach() != 5 { return 1 }
    if s.kind() != 7 { return 2 }
    0
}

/**
 * f_same_bare_method_dispatch — classes sharing the SAME bare name `Svc` across namespaces
 * (`sbmd_left`, `sbmd_right`, plus the sorted-first `aaa_decoy` poison decoy) dispatch an INSTANCE
 * method to the canonically-namespaced class, never to a readdir-order same-bare collision (issue
 * #290; migrated from `bulk`'s `p_same_bare_method_dispatch`, cargo/0.3.1-dissolver-bulk
 * 2026-07-29).
 *
 * @return 0 on success, 1 if the dispatched tags disagree with the expected sum (10)
 */
fn f_same_bare_method_dispatch() -> i64 {
    if same_bare_method_dispatch_ns::scenario() != 10 { return 1 }
    0
}

/**
 * f_native_gate_coercions — the restored `native_gate_coercions` regressive (#265; migrated from
 * `bulk`'s `native_gate`, cargo/0.3.1-dissolver-bulk 2026-07-29): a bare `[]T` into a `[](T | null)`
 * PARAM (element-wise present-wrap), the same into a struct FIELD, and `~` on a sub-`int` unsigned
 * prim, re-narrowed to its own width.
 *
 * @return 0 on success, 1 if the scenario's own falling-off-the-end value disagrees with 21
 */
fn f_native_gate_coercions() -> i64 {
    if native_gate::scenario() != 21 { return 1 }
    0
}

/** Point_iface — a plain two-field struct, the F3 null-union matrix's STRUCT shape. */
type Point_iface = struct {
    /** the point's first coordinate. */
    x: i64
    /** the point's second coordinate. */
    y: i64
}

/**
 * sum_or — narrow a `Point_iface | null`, summing its two fields when present.
 *
 * @param p         the value to narrow
 * @param fallback  the value to use when `p` is `null`
 * @return          `p.x + p.y` when present, else `fallback`
 */
fn sum_or(p: Point_iface | null, fallback: i64) -> i64 {
    match p { Point_iface as v => v.x + v.y; null => fallback }
}

/**
 * f_null_union_struct_present_and_absent — the F3 null-union matrix's STRUCT shape, both a
 * present and an absent (`null`) value narrowed through the same `match` (migrated from `bulk`'s
 * `q002_struct_point_null_present_and_absent`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_null_union_struct_present_and_absent() -> i64 {
    let present: Point_iface | null = Point_iface { x = 10; y = 20 }
    let absent: Point_iface | null = null
    if sum_or(present, 0) + sum_or(absent, 12) != 42 { return 1 }
    0
}

/** Counter_mcni — a one-field class with an instance method, the F3 null-union matrix's CLASS shape. */
type Counter_mcni = class {
    /** the counter's current value. */
    pub n: i64

    /**
     * make — build a `Counter_mcni` at value `v`.
     *
     * @param v  the initial value
     * @return   a fresh `Counter_mcni`
     */
    pub fn make(v: i64) -> Counter_mcni { Counter_mcni { n = v } }

    /**
     * bump — the instance method a null-union narrow must be able to dispatch through.
     *
     * @param self  the receiver
     * @return      `self.n + 1`
     */
    pub fn bump(self) -> i64 { self.n + 1 }
}

/**
 * bump_or — narrow a `Counter_mcni | null`, dispatching its instance method when present.
 *
 * @param c         the value to narrow
 * @param fallback  the value to use when `c` is `null`
 * @return          `c.bump()` when present, else `fallback`
 */
fn bump_or(c: Counter_mcni | null, fallback: i64) -> i64 {
    match c { Counter_mcni as v => v.bump(); null => fallback }
}

/**
 * f_null_union_class_present_and_absent — the F3 null-union matrix's CLASS shape, both a present
 * and an absent (`null`) value narrowed through the same `match`, dispatching an instance method on
 * the present arm (migrated from `bulk`'s `q003_class_counter_null_present_and_absent`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_null_union_class_present_and_absent() -> i64 {
    let present: Counter_mcni | null = Counter_mcni::make(9)
    let absent: Counter_mcni | null = null
    if bump_or(present, 0) + bump_or(absent, 32) != 42 { return 1 }
    0
}

/** Point_mcni — a plain two-field struct, distinct from `Point_iface` (the FORWARD shape's own type). */
type Point_mcni = struct {
    /** the point's first coordinate. */
    x: i64
    /** the point's second coordinate. */
    y: i64
}

/**
 * maybe_point — returns a null-union WITHOUT narrowing it first: the caller receives the raw
 * `Point_mcni | null` and must narrow it itself (the "forward an un-narrowed return" shape).
 *
 * @param present  when true, returns a present `Point_mcni`; else `null`
 * @return         `Point_mcni { x = 21; y = 21 }` when `present`, else `null`
 */
fn maybe_point(present: bool) -> Point_mcni | null {
    if present { return Point_mcni { x = 21; y = 21 } }
    null
}

/**
 * read_or — narrow a `Point_mcni | null`, summing its two fields when present.
 *
 * @param p         the value to narrow
 * @param fallback  the value to use when `p` is `null`
 * @return          `p.x + p.y` when present, else `fallback`
 */
fn read_or(p: Point_mcni | null, fallback: i64) -> i64 {
    match p { Point_mcni as v => v.x + v.y; null => fallback }
}

/**
 * f_forward_un_narrowed_null_union_return — a function's null-union RETURN value is forwarded to
 * its caller un-narrowed, and narrowing happens only at the call site — both over a present and an
 * absent value (migrated from `bulk`'s `q007_forward_an_un_narrowed_null_union_retu`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_forward_un_narrowed_null_union_return() -> i64 {
    if read_or(maybe_point(true), 0) + read_or(maybe_point(false), 0) != 42 { return 1 }
    0
}

/**
 * f_match_value_literal_join — a `match`-as-value whose arms mix a CASE-bound concrete leaf with
 * a bare numeric-literal leaf: `type_match`'s literal cross-adoption (mirroring `type_if`'s own,
 * `src/checker/typer.tks`) must retype the literal leaf at the concrete sibling's type instead of
 * defaulting it to `i64`, so the whole match joins to ONE scalar type rather than an accidental
 * `i32 | i64` union no int-position accepts. Covers the reported shape (`i32 as n => n; null =>
 * 0`, both the present and the absent leg), the arm order REVERSED (the literal arm first), and a
 * literal that does NOT fit the anchor (which must still form a genuine union, never silently
 * collapse to the anchor's type).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_match_value_literal_join() -> i64 {
    let present: i32 | null = 7
    let r = match present { i32 as n => n; null => 0 }
    if r != 7 { return 1 }
    let absent: i32 | null = null
    let s = match absent { i32 as n => n; null => 0 }
    if s != 0 { return 2 }
    let reordered: i32 | null = 3
    let t = match reordered { null => 0; i32 as n => n }
    if t != 3 { return 3 }
    let misfit: u8 | null = null
    let u: u8 | i64 = match misfit { u8 as n => n; null => 999 }
    let uval = match u { u8 as x => x to i64; i64 as y => y }
    if uval != 999 { return 4 }
    0
}

/**
 * f_array_lit_literal_join — an ARRAY LITERAL whose elements mix a typed concrete leaf with a
 * bare numeric-literal leaf: `type_array_lit`'s literal cross-adoption (the exact twin of
 * `type_match`'s, `src/checker/typer.tks`) must retype the literal leaf at the concrete sibling's
 * type instead of defaulting it to `i64`, so the array joins to ONE element type rather than an
 * accidental `i32 | i64` union no int-position accepts. Covers the reported shape (`[n, 0]`) and
 * the order REVERSED (`[0, n]`).
 *
 * A literal that does NOT fit the anchor (e.g. `[u8_val, 999]`) is deliberately NOT exercised
 * here: the resulting `[]<u8 | i64>` needs a slice whose ELEMENT is a general (non-null) variant,
 * which neither backend can build today — the C route honest-stops at codegen
 * ("optional/slice inner type not yet supported") on `[a, b]` for ANY two concretely-typed
 * siblings, with no literal involved at all, so a misfit-literal case here would fail the whole
 * corpus for a reason that has nothing to do with this fix. Confirmed by an out-of-tree probe
 * instead: the checker still builds the genuine `u8 | i64` union (unchanged from before this
 * fix) rather than silently collapsing it into `u8`.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_array_lit_literal_join() -> i64 {
    let n: i32 = 7
    let xs = [n, 0]
    if xs[0] != 7 { return 1 }
    if xs[1] != 0 { return 2 }
    let ys = [0, n]
    if ys[0] != 0 { return 3 }
    if ys[1] != 7 { return 4 }
    0
}

/**
 * dv_shape_or_err — a bare `DvShape` case constructed DIRECTLY into a `DvShape | error` slot: the
 * exact shape 0.3.1.0 degrau 23 closes (`checker::func_type`'s own `-> Type | error`, `Type` itself
 * a named variant). `DvShape` is a UNION MEMBER here, not the function's own bare return type, so a
 * bare `DvCircle`/`DvSquare`/`DvTri` flows past TWO levels of union before reaching a case a `match`
 * can bind by name: this level's own tag (is it the `DvShape` case or `error`?), then `DvShape`'s
 * OWN tag (which of its three cases?).
 *
 * @param n  0 for the error case, 1 for a circle, 2 for a square, anything else for a triangle
 * @return   the constructed value, or its `error` case
 */
fn dv_shape_or_err(n: i64) -> DvShape | error {
    if n == 0 { return error { message = "dv nested" } }
    if n == 1 { return DvCircle { r = 5 } }
    if n == 2 { return DvSquare { s = 6 } }
    DvTri { t = 7 }
}

/**
 * f_declared_variant_nested_alias — 0.3.1.0 degrau 23: a bare case constructed straight into an
 * OUTER slot whose union member is ITSELF a declared variant (`DvShape`) is tagged, and read back,
 * by its OWN case — not by the leaf's raw bytes misread as the alias's own tag.
 *
 * THE MISCOMPILATION THIS CLOSES, IN TWO LAYERS. The native backend used to fail to even COMPILE
 * this shape ("value's type is not a member of its declared variant (internal)" —
 * `variant_member_index_of`/`variant_member_type_matches` matched a `Named` member by EXACT name
 * only, so a value nested one alias deep never matched). Widening that match to recurse into the
 * alias's own members closed the compile-time stop, but on its own would have left a DEEPER wrong
 * answer standing: it would have stored the leaf's OWN raw address as the outer payload directly,
 * so a later `match` against the alias's OWN cases (`DvCircle`/`DvSquare`/`DvTri`) would have read
 * the leaf struct's own first FIELD as if it were the alias's tag — a SILENT wrong branch, not a
 * stop, confirmed by disassembling the equivalent two-level scratch repro. The fix instead builds
 * a NESTED wrapper (the alias's own tag+payload) and boxes THAT as the outer payload, so both
 * levels read back correctly.
 *
 * @return 0 when every case round-trips through both match levels, else the number of the failing
 *         check
 */
fn f_declared_variant_nested_alias() -> i64 {
    match dv_shape_or_err(0) {
        error as e => { if e.message != "dv nested" { return 1 } }
        DvShape as s => { return 2 }
    }
    match dv_shape_or_err(1) {
        error as e => { return 3 }
        DvShape as s => match s {
            DvCircle as c => { if c.r != 5 { return 4 } }
            DvSquare as sq => { return 5 }
            DvTri as t => { return 6 }
        }
    }
    match dv_shape_or_err(2) {
        error as e => { return 7 }
        DvShape as s => match s {
            DvCircle as c => { return 8 }
            DvSquare as sq => { if sq.s != 6 { return 9 } }
            DvTri as t => { return 10 }
        }
    }
    match dv_shape_or_err(3) {
        error as e => { return 11 }
        DvShape as s => match s {
            DvCircle as c => { return 12 }
            DvSquare as sq => { return 13 }
            DvTri as t => { if t.t != 7 { return 14 } }
        }
    }
    0
}

/**
 * array_lit_i64_a — the FIRST of a pair of scalar-element array-literal producers
 * (`array_lit_return_escape`, 0.3.1.0 array-literal-escape): a fresh `[]i64` built and returned
 * directly, never touching `teko::list::push`.
 *
 * @return a 3-element `[]i64`
 */
fn array_lit_i64_a() -> []i64 { [10, 20, 30] }

/**
 * array_lit_i64_b — the SECOND scalar-element array-literal producer: called right after
 * `array_lit_i64_a`, before that first call's result is read, so its own callee frame is the one
 * whose reuse must not corrupt the first result (0.3.1.0 array-literal-escape).
 *
 * @return a 3-element `[]i64`, disjoint from `array_lit_i64_a`'s
 */
fn array_lit_i64_b() -> []i64 { [40, 50, 60] }

/**
 * array_lit_str_a — the FAT-element twin of `array_lit_i64_a`: each element is itself a
 * `{ptr, len}` pair, so its storage carries two words per slot instead of one.
 *
 * @return a 3-element `[]str`
 */
fn array_lit_str_a() -> []str { ["un", "deux", "trois"] }

/**
 * array_lit_str_b — the FAT-element twin of `array_lit_i64_b`, called immediately after
 * `array_lit_str_a` and before that call's result is read.
 *
 * @return a 3-element `[]str`, disjoint from `array_lit_str_a`'s
 */
fn array_lit_str_b() -> []str { ["one", "two", "three"] }

/**
 * array_lit_i64_empty — the empty array literal, returned directly: its backing storage is
 * zero bytes wide, the degenerate case the same escape fix must not regress (an empty literal's
 * pointer is never dereferenced, since every read of it is guarded by `.len`).
 *
 * @return an empty `[]i64`
 */
fn array_lit_i64_empty() -> []i64 { [] }

/**
 * f_array_lit_return_escape — a function that RETURNS a fresh array literal must hand the caller
 * storage that survives past the callee's own frame (0.3.1.0 array-literal-escape): the native
 * backend once built an array literal's backing bytes in an `alloca`, the CALLEE's OWN frame slot,
 * so a SECOND call issued before the FIRST call's result was read reused that same stack memory —
 * the first result silently read back the second call's bytes, no crash, no stop. Exercises the
 * scalar (`[]i64`) element case, the FAT (`[]str`) element case, and the empty literal, each pair
 * of producer calls issued before either result is read.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_array_lit_return_escape() -> i64 {
    let ia = array_lit_i64_a()
    let ib = array_lit_i64_b()
    if ia.len != 3 { return 1 }
    if ia[0] != 10 { return 2 }
    if ia[1] != 20 { return 3 }
    if ia[2] != 30 { return 4 }
    if ib.len != 3 { return 5 }
    if ib[0] != 40 { return 6 }
    if ib[1] != 50 { return 7 }
    if ib[2] != 60 { return 8 }
    let sa = array_lit_str_a()
    let sb = array_lit_str_b()
    if sa.len != 3 { return 9 }
    if sa[0] != "un" { return 10 }
    if sa[1] != "deux" { return 11 }
    if sa[2] != "trois" { return 12 }
    if sb.len != 3 { return 13 }
    if sb[0] != "one" { return 14 }
    if sb[1] != "two" { return 15 }
    if sb[2] != "three" { return 16 }
    let e = array_lit_i64_empty()
    if e.len != 0 { return 17 }
    0
}

/**
 * Arm64BigLeaf — the innermost 64-byte layer of the deliberately huge nested local
 * `Arm64BigFrame` (below, 0.3.1 A4-bigframe): eight `i64` filler fields, with no meaning beyond
 * their own byte width.
 */
type Arm64BigLeaf = struct {
    /** a — filler field 1 of 8, 8 bytes. */
    a: i64
    /** b — filler field 2 of 8, 8 bytes. */
    b: i64
    /** c — filler field 3 of 8, 8 bytes. */
    c: i64
    /** d — filler field 4 of 8, 8 bytes. */
    d: i64
    /** e — filler field 5 of 8, 8 bytes. */
    e: i64
    /** f — filler field 6 of 8, 8 bytes. */
    f: i64
    /** g — filler field 7 of 8, 8 bytes. */
    g: i64
    /** h — filler field 8 of 8, 8 bytes; the field every checksum below reads back. */
    h: i64
}

/**
 * zero_arm64_big_leaf — a zeroed `Arm64BigLeaf` with `n` written into `h`, so the checksum that
 * reads it back is sensitive to which nesting level's copy a wrong lowering would drop.
 *
 * @param n  the marker value written to `h`
 * @return   the assembled leaf
 */
fn zero_arm64_big_leaf(n: i64) -> Arm64BigLeaf {
    Arm64BigLeaf { a = 0; b = 0; c = 0; d = 0; e = 0; f = 0; g = 0; h = n }
}

/**
 * Arm64BigMid — the middle 512-byte layer of `Arm64BigFrame`: eight `Arm64BigLeaf` fields.
 */
type Arm64BigMid = struct {
    /** a — nested leaf 1 of 8, 64 bytes. */
    a: Arm64BigLeaf
    /** b — nested leaf 2 of 8, 64 bytes. */
    b: Arm64BigLeaf
    /** c — nested leaf 3 of 8, 64 bytes. */
    c: Arm64BigLeaf
    /** d — nested leaf 4 of 8, 64 bytes. */
    d: Arm64BigLeaf
    /** e — nested leaf 5 of 8, 64 bytes. */
    e: Arm64BigLeaf
    /** f — nested leaf 6 of 8, 64 bytes. */
    f: Arm64BigLeaf
    /** g — nested leaf 7 of 8, 64 bytes. */
    g: Arm64BigLeaf
    /** h — nested leaf 8 of 8, 64 bytes. */
    h: Arm64BigLeaf
}

/**
 * zero_arm64_big_mid — a zeroed `Arm64BigMid` whose eight leaves all carry marker `n`.
 *
 * @param n  the marker value threaded into every nested leaf
 * @return   the assembled mid-layer struct
 */
fn zero_arm64_big_mid(n: i64) -> Arm64BigMid {
    let z = zero_arm64_big_leaf(n)
    Arm64BigMid { a = z; b = z; c = z; d = z; e = z; f = z; g = z; h = z }
}

/**
 * Arm64BigFrame — a deliberately huge (4096-byte) nested-struct local shape (0.3.1
 * A4-bigframe): eight `Arm64BigMid` fields. A single `f_arm64_bigframe_locals` local of this
 * type already exceeds the arm64 STP/LDP pair's signed 7-bit scaled field (504 bytes); a SECOND
 * one's own frame-slot offset (4096 bytes) exceeds the ADD-immediate's inline 12-bit field (4095)
 * too — the exact shape the compiler's own growing `error` struct (0.3.1.0 degrau 22, six fields
 * instead of one) tripped over on the arm64-macos encoder (`A4-bigframe`,
 * `src/backend/encode_arm64.tks`).
 */
type Arm64BigFrame = struct {
    /** a — nested mid-layer 1 of 8, 512 bytes. */
    a: Arm64BigMid
    /** b — nested mid-layer 2 of 8, 512 bytes. */
    b: Arm64BigMid
    /** c — nested mid-layer 3 of 8, 512 bytes. */
    c: Arm64BigMid
    /** d — nested mid-layer 4 of 8, 512 bytes. */
    d: Arm64BigMid
    /** e — nested mid-layer 5 of 8, 512 bytes. */
    e: Arm64BigMid
    /** f — nested mid-layer 6 of 8, 512 bytes. */
    f: Arm64BigMid
    /** g — nested mid-layer 7 of 8, 512 bytes. */
    g: Arm64BigMid
    /** h — nested mid-layer 8 of 8, 512 bytes. */
    h: Arm64BigMid
}

/**
 * zero_arm64_big_frame — a zeroed `Arm64BigFrame` whose every nested leaf carries marker `n`.
 *
 * @param n  the marker value threaded into every nested leaf
 * @return   the assembled 4096-byte struct
 */
fn zero_arm64_big_frame(n: i64) -> Arm64BigFrame {
    let z = zero_arm64_big_mid(n)
    Arm64BigFrame { a = z; b = z; c = z; d = z; e = z; f = z; g = z; h = z }
}

/**
 * check_arm64_bigframe_one — a 4096-byte nested-struct local, ALONE in its own frame (0.3.1
 * A4-bigframe): the frame (local + FP/LR + callee-saved area) exceeds the arm64 STP/LDP pair's
 * signed 7-bit scaled field (504 bytes) by a wide margin — the exact shape the compiler's own
 * growing `error` struct (0.3.1.0 degrau 22, six fields instead of one) tripped over on the
 * arm64-macos encoder (`A4-bigframe`, `src/backend/encode_arm64.tks`). Reads a marker field back
 * from both the first and the last nesting level, so a copy that silently drops a level shows up
 * as a wrong checksum, not merely as "it built".
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn check_arm64_bigframe_one() -> i64 {
    let one = zero_arm64_big_frame(1)
    if one.a.a.h != 1 { return 1 }
    if one.h.h.h != 1 { return 2 }
    0
}

/**
 * check_arm64_bigframe_two — `check_arm64_bigframe_one`'s twin, with its OWN distinct marker,
 * called from a separate frame (0.3.1 A4-bigframe) so the corpus never holds two aggregate
 * call-return locals live in the SAME frame at once (a distinct, pre-existing aggregate
 * call-return aliasing gap this scenario does not exercise or claim to fix).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn check_arm64_bigframe_two() -> i64 {
    let two = zero_arm64_big_frame(2)
    if two.a.a.h != 2 { return 3 }
    if two.h.h.h != 2 { return 4 }
    0
}

/**
 * f_arm64_bigframe_locals — two INDEPENDENT 4096-byte-local frames (0.3.1 A4-bigframe),
 * `check_arm64_bigframe_one`/`_two`, each pinning the same large-frame shape from a distinct
 * marker value: the compiler's own corpus proof that the arm64 encoder's big-frame sequence
 * (prologue/epilogue STR/LDR + `MFrameAddr`'s chained ADD, `src/backend/encode_arm64.tks`)
 * handles a frame well past the STP/LDP field's 504-byte ceiling.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_arm64_bigframe_locals() -> i64 {
    let a = check_arm64_bigframe_one()
    if a != 0 { return a }
    check_arm64_bigframe_two()
}

/**
 * DivGuardHolder — a struct carrying one `i64` field, the receiver `f_compound_rem_assign_field`
 * writes THROUGH via a compound `%=`: the div-by-zero guard (`teko::lir::lower_div_zero_guard`)
 * must reach a struct-field compound assignment exactly like a plain local (both route through
 * `teko::lir::store_assign_value`), and a struct receiver is the shape that path is exercised
 * under.
 */
type DivGuardHolder = struct { v: i64 }

/**
 * f_div_signed_i32_value — the div-by-zero guard's "ok" (nonzero-divisor) path on a SIGNED `i32`
 * `/`: `lower_div_zero_guard` must fall straight through to the ordinary `IDivS` with the exact
 * same quotient a guardless division would give, over both a positive and a negative dividend (so
 * `IDivS`'s truncating-toward-zero rounding is exercised, not just the unsigned-adjacent positive
 * case). `n` is a `mut` local so the divisor is fold-opaque (the checker cannot constant-fold it
 * away, the same "own_arith_exit" rationale above): a real `IDivS` reaches the guard, not a
 * compile-time-collapsed literal.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_div_signed_i32_value() -> i64 {
    mut n: i32 = 4
    let q1: i32 = 100 to i32 / n
    if q1 != 25 { return 1 }
    n = 3
    let q2: i32 = -100 to i32 / n
    if q2 != -33 { return 2 }
    0
}

/**
 * f_div_unsigned_u32_value — the guard's "ok" path on an UNSIGNED `u32` `/`: `lower_div_zero_guard`
 * emits the SAME zero-check ahead of `IDivU` (never `IDivS`) so an unsigned dividend near
 * `u32::MAX` still divides in the unsigned domain, not sign-extended.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_div_unsigned_u32_value() -> i64 {
    mut n: u32 = 7 to u32
    let q: u32 = 4294967295 to u32 / n
    if q != 613566756 to u32 { return 1 }
    0
}

/**
 * f_rem_signed_i32_value — the guard's "ok" path on a SIGNED `i32` `%` (`IRemS`): the remainder's
 * sign follows the DIVIDEND (Teko's truncating `%`, mirroring C), over both a positive and a
 * negative dividend.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_rem_signed_i32_value() -> i64 {
    mut n: i32 = 9
    let r1: i32 = 100 to i32 % n
    if r1 != 1 { return 1 }
    n = 9
    let r2: i32 = -100 to i32 % n
    if r2 != -1 { return 2 }
    0
}

/**
 * f_rem_unsigned_u32_value — the guard's "ok" path on an UNSIGNED `u32` `%` (`IRemU`).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_rem_unsigned_u32_value() -> i64 {
    mut n: u32 = 9 to u32
    let r: u32 = 4294967295 to u32 % n
    if r != 3 to u32 { return 1 }
    0
}

/**
 * f_div_signed_i64_value — the guard's "ok" path at the WIDE `i64` `/` width, the SAME width the
 * guard's zero-materialization (`const_int_inst`) must match bit-for-bit against, over both a
 * positive and a negative dividend.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_div_signed_i64_value() -> i64 {
    mut n: i64 = 4
    let q1 = 100 / n
    if q1 != 25 { return 1 }
    n = 3
    let q2 = -100 / n
    if q2 != -33 { return 2 }
    0
}

/**
 * f_div_unsigned_u64_value — the guard's "ok" path at the WIDE `u64` `/` width, over a dividend
 * past `i64::MAX` (only meaningful in the unsigned domain — `IDivU`, never `IDivS`).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_div_unsigned_u64_value() -> i64 {
    let u64_max: u64 = 18446744073709551615
    mut n: u64 = 7 to u64
    let q: u64 = u64_max / n
    if q != 2635249153387078802 to u64 { return 1 }
    0
}

/**
 * f_rem_signed_i64_value — the guard's "ok" path at the WIDE `i64` `%` width, over both a
 * positive and a negative dividend.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_rem_signed_i64_value() -> i64 {
    mut n: i64 = 9
    let r1 = 100 % n
    if r1 != 1 { return 1 }
    n = 9
    let r2 = -100 % n
    if r2 != -1 { return 2 }
    0
}

/**
 * f_rem_unsigned_u64_value — the guard's "ok" path at the WIDE `u64` `%` width, over a dividend
 * past `i64::MAX` (only meaningful in the unsigned domain — `IRemU`, never `IRemS`).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_rem_unsigned_u64_value() -> i64 {
    let u64_max: u64 = 18446744073709551615
    mut n: u64 = 9 to u64
    let r: u64 = u64_max % n
    if r != 6 to u64 { return 1 }
    0
}

/**
 * f_compound_div_assign_value — the guard's "ok" path reached through a COMPOUND `/=` on a plain
 * `mut` local (`teko::lir::lower_assign_simple`'s own call to `lower_div_zero_guard`, a SEPARATE
 * call site from the plain-`/` one `f_div_signed_i64_value` exercises).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_compound_div_assign_value() -> i64 {
    mut x: i64 = 100
    mut n: i64 = 3
    x /= n
    if x != 33 { return 1 }
    0
}

/**
 * f_compound_rem_assign_field_value — the guard's "ok" path reached through a COMPOUND `%=` on a
 * STRUCT FIELD (`teko::lir::store_assign_value`'s own call to `lower_div_zero_guard`, the THIRD
 * and last call site — distinct from both the plain-`/` and the local-`/=` ones above).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_compound_rem_assign_field_value() -> i64 {
    mut h = DivGuardHolder { v = 107 }
    mut n: i64 = 10
    h.v %= n
    if h.v != 7 { return 1 }
    0
}

/**
 * f64_bits_of — the raw IEEE-754 bit pattern (as `u64`) of one of THREE runtime-selected `f64`
 * magnitudes, including a NEGATIVE one (the sign bit set) — built from a plain integer `tag`
 * rather than an `f64` literal/ALU op/compare, since every other path onto an `f64` value is the
 * SEPARATE `B1-fp` honest-stop family (`isel_x86_64.tks`) this fixture does not exercise; only
 * `f64_bits`/`f64_from_bits` (0.3.1.0 degrau 24) themselves are under test here.
 *
 * @param tag  0 selects 3.0's bits, 1 selects 2.0's, anything else selects -2.0's
 * @return     the selected magnitude's bit pattern
 */
fn f64_bits_of(tag: i64) -> u64 {
    if tag == 0 { return 4613937818241073152 }
    if tag == 1 { return 4611686018427387904 }
    13835058055282163712
}

/**
 * f_f64_bits_roundtrip — 0.3.1.0 degrau 24: `teko::f64_bits`/`teko::f64_from_bits` round-trip
 * THREE runtime bit patterns through `f64` and back, with every producer VALUE kept LIVE AT THE
 * SAME TIME as its siblings (`a`/`b`/`c` are all still needed when the LAST `f64_bits` reads its
 * own value back) — the exact shape that would have SILENTLY read the WRONG value back had either
 * builtin lowered to a real call to its `tk_f64_bits`/`tk_f64_from_bits` runtime twin instead: with
 * no `f64`-class argument/return handling yet (`pin_args_x86`/`select_call_result_x86`, both still
 * GPR-only pending `B1-fp`), a real call would have carried the value through the single physical
 * XMM0 register, so a SECOND live `f64` would silently clobber the first the moment it was
 * produced — a measured scratch repro confirmed exactly that corruption. The fix instead lowers
 * both builtins as one raw GPR/FPR-crossing move (`IToFBits`/`FToIBits`, 0.3.1.0 degrau 27) into a
 * FRESH result VReg — never a call, and never the ORIGINAL same-VReg-id alias either (see
 * `f_f64_bitcast_arith`'s own doc for why the alias shape was itself unsound) — so ordinary
 * register allocation, which already keeps any number of plain values alive correctly, carries
 * every one of `a`/`b`/`c` to its own read-back untouched.
 *
 * @return 0 when every one of the three round-trips (and the negative sign bit) reads back
 *         correctly, else the number of the failing check
 */
fn f_f64_bits_roundtrip() -> i64 {
    let a = teko::f64_from_bits(f64_bits_of(0))
    let b = teko::f64_from_bits(f64_bits_of(1))
    let c = teko::f64_from_bits(f64_bits_of(2))
    let ba = teko::f64_bits(a)
    let bb = teko::f64_bits(b)
    let bc = teko::f64_bits(c)
    if ba != f64_bits_of(0) { return 1 }
    if bb != f64_bits_of(1) { return 2 }
    if bc != f64_bits_of(2) { return 3 }
    if (bc & 0x8000000000000000) == 0 { return 4 }
    if (ba & 0x8000000000000000) != 0 { return 5 }
    0
}

/**
 * f_f64_bitcast_arith — 0.3.1.0 degrau 27: real `f64` ARITHMETIC (`+`/`-`/`*`/`/`) performed
 * directly on a `teko::f64_from_bits` result, then read back through `teko::f64_bits` — the exact
 * shape `checker::comptime_fold::float_binop` uses (`teko::f64_from_bits(lf.bits)` fed straight
 * into `x + y`), and the shape `f_f64_bits_roundtrip` above does NOT cover: chaining `f64_bits`
 * straight back onto a fresh `f64_from_bits` result never forces the value through an FPR-only
 * consumer, so THAT fixture stayed green even under the ORIGINAL same-VReg-id alias
 * (`lower_f64_bitcast_call`, degrau 24) — the alias reused the operand's OWN VReg unchanged, and a
 * VReg's register FILE is fixed by its DEFINING instruction (here, an integer load), so the alias
 * silently stayed a GPR value end to end. The moment a float ALU op (`select_falu_x86`) consumes
 * that SAME VReg id as an FPR operand, the native register allocator (`regalloc.tks`) sees ONE
 * numeric id touched by two DIFFERENT register classes, splits it into two intervals that still
 * share one `vid`, and `subst_find`'s id-only substitution (no class check) picks the wrong one for
 * at least one occurrence — the measured SIGSEGV: the native self-build crashing while lowering
 * `checker::float_binop` itself, the first compiler function in item order to do real `f64`
 * arithmetic through this pair. `IToFBits`/`FToIBits` (one real `MFMovX86`/`MFMov` GPR/FPR move
 * into a fresh result VReg) fix it.
 *
 * @return 0 when every one of the four arithmetic results reads back the exact expected bit
 *         pattern, else the number of the failing check
 */
fn f_f64_bitcast_arith() -> i64 {
    let x = teko::f64_from_bits(f64_bits_of(0))
    let y = teko::f64_from_bits(f64_bits_of(1))
    let sum = teko::f64_bits(x + y)
    let diff = teko::f64_bits(x - y)
    let prod = teko::f64_bits(x * y)
    let quot = teko::f64_bits(x / y)
    if sum != 4617315517961601024 { return 1 }
    if diff != 4607182418800017408 { return 2 }
    if prod != 4618441417868443648 { return 3 }
    if quot != 4609434218613702656 { return 4 }
    0
}

/**
 * HolderD25 — a struct whose fields are null-bearing unions of DIFFERENT payload shapes: a SCALAR
 * member and a FAT (`str`) one, so a wrapper written at the wrong offset shows up as the wrong
 * field rather than as a coincidentally-right value (0.3.1.0 degrau 25).
 */
type HolderD25 = struct {
    /** n — the SCALAR union member's slot. */
    n: i64 | null
    /** s — the FAT union member's slot (its wrapper carries both the ptr and the len half). */
    s: str | null
}

/**
 * ShapeD25 — a DECLARED variant, the inner union a `ShapeD25 | null` placement must wrap its bare
 * case into before storing it as the outer union's payload (0.3.1.0 degrau 25).
 */
type ShapeD25 = variant CircD25 | SqD25

/** CircD25 — `ShapeD25`'s first case (tag 0). */
type CircD25 = struct {
    /** r — the circle's radius, the value the round-trip reads back. */
    r: i64
}

/** SqD25 — `ShapeD25`'s second case (tag 1) — a DIFFERENT tag, so a dropped inner wrapper cannot
    coincide with the right answer. */
type SqD25 = struct {
    /** side — the square's side, the value the round-trip reads back. */
    side: i64
}

/** CarrierD25 — a struct whose ONE field is a null-bearing union over a declared variant. */
type CarrierD25 = struct {
    /** sh — the nested-union slot. */
    sh: ShapeD25 | null
}

/** BoxD25 — a class whose instance field is a null-bearing union: the EFFECTIVE-field half of the
    declared-field-type table (`collect_field_decls`'s `ClassBody` arm). */
type BoxD25 = class {
    /** k — the null-bearing union instance field. */
    pub k: i64 | null

    /**
     * make — the static factory a class literal is only constructible through.
     *
     * @param v  the value (or `null`) the instance's union field is built at
     * @return   a fresh `BoxD25`
     */
    pub fn make(v: i64 | null) -> BoxD25 { BoxD25 { k = v } }
}

/**
 * d25_scalar_of — the scalar union field's value, or `-1` when it is absent.
 *
 * @param h  the holder to read
 * @return   `h.n`'s payload, or `-1` for the absent case
 */
fn d25_scalar_of(h: HolderD25) -> i64 { match h.n { null => 0 - 1; i64 as v => v } }

/**
 * d25_text_len_of — the FAT union field's LENGTH, or `-1` when it is absent. A wrapper whose length
 * half was never written reads back as `0`, which is neither answer.
 *
 * @param h  the holder to read
 * @return   `h.s`'s length, or `-1` for the absent case
 */
fn d25_text_len_of(h: HolderD25) -> i64 { match h.s { null => 0 - 1; str as t => t.len to i64 } }

/**
 * d25_text_head_of — the FAT union field's FIRST BYTE, or `-1` when it is absent: the pointer half
 * has to point at the real bytes, not merely be non-zero.
 *
 * @param h  the holder to read
 * @return   `h.s`'s first byte, or `-1` for the absent case
 */
fn d25_text_head_of(h: HolderD25) -> i64 { match h.s { null => 0 - 1; str as t => t[0] to i64 } }

/**
 * d25_arg_or — narrow a null-bearing union passed as a CALL ARGUMENT. Both a bare `null` and a bare
 * `i64` reach this parameter unwrapped unless the caller coerces them into it.
 *
 * @param x         the argument to narrow
 * @param fallback  the answer for the absent case
 * @return          `x`'s payload, or `fallback`
 */
fn d25_arg_or(x: i64 | null, fallback: i64) -> i64 { match x { null => fallback; i64 as v => v } }

/**
 * d25_box_or — narrow a CLASS instance's null-bearing union field.
 *
 * @param b         the instance to read
 * @param fallback  the answer for the absent case
 * @return          `b.k`'s payload, or `fallback`
 */
fn d25_box_or(b: BoxD25, fallback: i64) -> i64 { match b.k { null => fallback; i64 as v => v } }

/**
 * d25_shape_side_of — narrow a `ShapeD25 | null` field through BOTH levels: the outer null-union's
 * present case, then the inner declared variant's own case. A missing inner wrapper makes the inner
 * `match` read the bare case struct's first field as `ShapeD25`'s tag, so NEITHER inner arm is
 * taken and the value falls through.
 *
 * @param c  the carrier to read
 * @return   the case's own measurement, or `-1` for the absent case, or `-2` when the inner `match`
 *           selected no arm at all
 */
fn d25_shape_side_of(c: CarrierD25) -> i64 {
    match c.sh {
        null => 0 - 1
        ShapeD25 as s => match s {
            CircD25 as cc => cc.r
            SqD25 as sq => sq.side
            _ => 0 - 2
        }
    }
}

/**
 * f_union_placement_field_and_argument — 0.3.1.0 degrau 25: a value placed into a UNION-typed struct
 * field, class field or call argument is coerced into that union's tag+payload wrapper, whether the
 * value is a bare `null`, a bare scalar, a bare `str`, or a bare case of a nested declared variant.
 *
 * Before the fix a bare `null` in a struct field honest-stopped the whole build (`native backend N1:
 * a \`null\` in this position needs the null-union wrapper the placement does not declare a type
 * for`) and every OTHER row here compiled and SIGSEGV'd or answered wrong — the raw value was
 * written into a slot a later `match` reads as the wrapper's base address.
 *
 * @return 0 when every placement round-trips, else the number of the failing check
 */
fn f_union_placement_field_and_argument() -> i64 {
    let absent = HolderD25 { n = null; s = null }
    let present = HolderD25 { n = 41; s = "abcde" }
    if d25_scalar_of(absent) != 0 - 1 { return 1 }
    if d25_text_len_of(absent) != 0 - 1 { return 2 }
    if d25_scalar_of(present) != 41 { return 3 }
    if d25_text_len_of(present) != 5 { return 4 }
    if d25_text_head_of(present) != 97 { return 5 }
    if d25_arg_or(null, 7) != 7 { return 6 }
    if d25_arg_or(13, 7) != 13 { return 7 }
    if d25_box_or(BoxD25::make(null), 3) != 3 { return 8 }
    if d25_box_or(BoxD25::make(19), 3) != 19 { return 9 }
    0
}

/**
 * f_union_placement_nested_variant — 0.3.1.0 degrau 25: a bare case placed into a `<variant> | null`
 * slot gets its OWN inner wrapper built before the outer union stores it, so both `match` levels
 * read a real tag. The twin `lower_variant_construct` was given in degrau 23 and
 * `lower_null_union_construct` was not.
 *
 * The two cases carry DIFFERENT tags (0 and 1) and different field values, so a dropped inner
 * wrapper cannot pass by coincidence; `-2` distinguishes "the inner match took no arm" from "the
 * inner match took the wrong one".
 *
 * @return 0 when both cases round-trip through both levels, else the number of the failing check
 */
fn f_union_placement_nested_variant() -> i64 {
    if d25_shape_side_of(CarrierD25 { sh = null }) != 0 - 1 { return 1 }
    if d25_shape_side_of(CarrierD25 { sh = SqD25 { side = 23 } }) != 23 { return 2 }
    if d25_shape_side_of(CarrierD25 { sh = CircD25 { r = 29 } }) != 29 { return 3 }
    let bound: ShapeD25 | null = SqD25 { side = 31 }
    match bound {
        null => return 4
        ShapeD25 as s => match s { CircD25 => return 5; SqD25 as sq => if sq.side != 31 { return 6 }; _ => return 7 }
    }
    0
}

/**
 * d26_push_str — append every byte of `s` onto `dst` ONE AT A TIME through `teko::mem::push_fo`
 * (0.3.1.0 degrau 26). This is the per-byte chain `teko::mem::append_fo` was introduced to replace
 * (#148 R2), kept here as an INDEPENDENT ORACLE: it reaches a DIFFERENT runtime entry
 * (`tk_slice_push_fo`, not `tk_append_bytes_fo`) and never calls `append_fo` at all, so a buffer
 * built through it agrees with an `append_fo`-built one only when the bulk append is genuinely
 * correct — no shared code path can make the two agree by accident.
 *
 * @param dst  the buffer to append onto
 * @param s    the fragment whose UTF-8 bytes are appended, in order
 * @return     the grown buffer
 */
fn d26_push_str(dst: []byte, s: str) -> []byte {
    let src = teko::text::bytes_of_str(s)
    mut out = dst
    mut i: u64 = 0
    loop {
        if i >= src.len { break }
        out = teko::mem::push_fo(out, src[i])
        i++
    }
    out
}

/**
 * d26_push_run — `seed` appended onto `dst` `times` times, byte at a time through the per-byte
 * oracle (`d26_push_str`) (0.3.1.0 degrau 26).
 *
 * @param dst    the buffer to append onto
 * @param seed   the fragment repeated
 * @param times  how many times `seed` is appended
 * @return       the grown buffer
 */
fn d26_push_run(dst: []byte, seed: str, times: i64) -> []byte {
    mut out = dst
    mut i: i64 = 0
    loop {
        if i >= times { break }
        out = d26_push_str(out, seed)
        i++
    }
    out
}

/**
 * d26_append_repeat — the LINEAR BUILDER CHAIN `teko::codegen::cb` is written in: one `[]byte`
 * threaded through a bracketed run of `teko::mem::append_fo` calls, each taking the buffer the
 * previous call returned (0.3.1.0 degrau 26). With `times` large enough the chain crosses several
 * geometric copy-grows, so the free-old (`_fo`) path — the one that frees the superseded buffer —
 * actually runs rather than being asserted about.
 *
 * @param seed   the fragment repeated between the brackets
 * @param times  how many times `seed` is appended
 * @return       `"["`, then `seed` `times` times, then `"]"`, as bytes
 */
fn d26_append_repeat(seed: str, times: i64) -> []byte {
    mut b: []byte = teko::list::empty()
    b = teko::mem::append_fo(b, "[")
    mut i: i64 = 0
    loop {
        if i >= times { break }
        b = teko::mem::append_fo(b, seed)
        i++
    }
    teko::mem::append_fo(b, "]")
}

/**
 * d26_push_repeat — `d26_append_repeat`'s content built by the per-byte oracle instead, so the two
 * can be compared without either one being the specification (0.3.1.0 degrau 26).
 *
 * @param seed   the fragment repeated between the brackets
 * @param times  how many times `seed` is appended
 * @return       `"["`, then `seed` `times` times, then `"]"`, as bytes
 */
fn d26_push_repeat(seed: str, times: i64) -> []byte {
    let fresh: []byte = teko::list::empty()
    let opened = d26_push_str(fresh, "[")
    d26_push_str(d26_push_run(opened, seed, times), "]")
}

/**
 * f_append_fo_bulk_bytes — 0.3.1.0 degrau 26: `teko::mem::append_fo([]byte, str) -> []byte` (the
 * `#148 R2` bulk byte-append, free-old on grow BY DECREE) lowers to the runtime's own
 * `tk_append_bytes_fo` through the out-parameter-length convention. Before the fix the own backend
 * had no lowering for it at all and the native self-build stopped at `teko::codegen::cb`, the
 * compiler's own byte-buffer append.
 *
 * Checked BY VALUE, never by length alone: the fragment is `café🐝` (an accented letter, 2 UTF-8
 * bytes, plus a 4-byte emoji, beside two 1-byte ASCII letters — this lane's own sonda), so a
 * length taken from the WRONG operand or a `&out_len` slot never loaded back cannot hide behind an
 * all-ASCII fixture; the content is read back through `str_of_bytes`, so swapped arguments show up
 * as reversed text rather than as a coincidentally-right length. The EMPTY fragment is its own row:
 * the runtime short-circuits `n == 0` by handing the SAME pointer back, which is the one path that
 * appends nothing and must still leave a readable buffer behind.
 *
 * @return 0 when every append round-trips, else the number of the failing check
 */
fn f_append_fo_bulk_bytes() -> i64 {
    mut b: []byte = teko::list::empty()
    b = teko::mem::append_fo(b, "café🐝")
    if b.len != 9 { return 1 }
    if str_of_bytes(b) != "café🐝" { return 2 }
    b = teko::mem::append_fo(b, "")
    if b.len != 9 { return 3 }
    if str_of_bytes(b) != "café🐝" { return 4 }
    b = teko::mem::append_fo(b, "!")
    if b.len != 10 { return 5 }
    if str_of_bytes(b) != "café🐝!" { return 6 }
    0
}

/**
 * f_append_fo_grow_chain — 0.3.1.0 degrau 26: a linear builder chain long enough to cross several
 * copy-grows, compared against the per-byte `push_fo` oracle that builds the same content through a
 * DIFFERENT runtime entry (`d26_push_str`). The comparison is what makes the row independent of any
 * expected string written by hand: only a bulk append that keeps every prefix, appends at the right
 * offset and returns the right length can agree with a buffer grown one byte at a time.
 *
 * @return 0 when the two builders agree on length and on content, else the number of the failing
 *         check
 */
fn f_append_fo_grow_chain() -> i64 {
    let fragments: i64 = 40
    let built = d26_append_repeat("xy", fragments)
    let oracle = d26_push_repeat("xy", fragments)
    if oracle.len != 82 { return 1 }
    if built.len != oracle.len { return 2 }
    if str_of_bytes(built) != str_of_bytes(oracle) { return 3 }
    0
}

/**
 * f_append_fo_interleaved_buffers — 0.3.1.0 degrau 26: TWO independent builder chains grown
 * ALTERNATELY, each compared against its own per-byte oracle. The runtime's in-place fast path is
 * keyed by the buffer's own pointer and length, so a bulk append that ignored either — appending
 * into whichever buffer the live-tail cache happened to hold last — would splice the two chains into
 * each other. One buffer alone cannot show that; two alternating ones can, which is why this row is
 * separate from the single-chain one above.
 *
 * @return 0 when both chains match their oracles, else the number of the failing check
 */
fn f_append_fo_interleaved_buffers() -> i64 {
    let rounds: i64 = 12
    mut a: []byte = teko::list::empty()
    mut b: []byte = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= rounds { break }
        a = teko::mem::append_fo(a, "aa")
        b = teko::mem::append_fo(b, "bbb")
        i++
    }
    if a.len != 24 { return 1 }
    if b.len != 36 { return 2 }
    let fresh_a: []byte = teko::list::empty()
    let fresh_b: []byte = teko::list::empty()
    if str_of_bytes(a) != str_of_bytes(d26_push_run(fresh_a, "aa", rounds)) { return 3 }
    if str_of_bytes(b) != str_of_bytes(d26_push_run(fresh_b, "bbb", rounds)) { return 4 }
    0
}

/**
 * CastWidenHolder — a struct with one wide integer field, the target `f_implicit_widen_targets`
 * writes a NARROWER value into. The implicit-widening rung had to be added to the field-assignment
 * ladder as well as the plain-local one (`coerce_value_into` is now the single ladder both use), and
 * a struct field is the shape that proves the field path took it.
 */
type CastWidenHolder = struct {
    /** The wide slot a narrower value widens into with no `to` written. */
    wide: i64
}

/**
 * cast_widen_consumer — a function whose parameter is WIDER than the argument its caller passes, so
 * the implicit widening has to reach the argument site too, not only assignments and bindings.
 *
 * @param v  the wide parameter a narrower argument widens into
 * @return   `v` unchanged
 */
fn cast_widen_consumer(v: i64) -> i64 { v }

/**
 * f_cast_narrow_in_range_keeps_value — the FIT side of the narrowing guard (0.3.1 aridade numérica):
 * a `to` whose operand lands inside the destination's own range must answer with that exact value.
 *
 * Measured wrong before the guard landed, on the native route only: `300 to u8` answered **300** — a
 * `u8` holding a number no `u8` represents, because the native backend lowered every narrowing `to`
 * to a bare `Trunc` and `Trunc` selects a 32-BIT move, which never reaches the 8-bit width. The
 * in-range values here are the other half of that proof: the guard must not have replaced a wrong
 * answer with a panic on values that were always fine.
 *
 * @return 0 when every in-range narrow keeps its value, else the number of the failing check
 */
fn f_cast_narrow_in_range_keeps_value() -> i64 {
    mut a: u64 = 44
    if (a to u8) != 44 to u8 { return 1 }
    a = 255
    if (a to u8) != 255 to u8 { return 2 }
    mut b: u64 = 65535
    if (b to u16) != 65535 to u16 { return 3 }
    mut c: i64 = 2147483647
    if (c to i32) != 2147483647 to i32 { return 4 }
    0
}

/**
 * f_cast_narrow_negative_keeps_sign — a SIGNED narrowing whose value fits must keep its SIGN.
 *
 * Measured wrong before the guard landed, native route only: `-5 to i32` answered **4294967291** and
 * `-5 to i8` the same, because the 32-bit move `Trunc` selected zero-extends the low half where the
 * sign had to survive. Now the conversion carries no width instruction at all — a value that fits
 * both types already has one shared 64-bit two's-complement pattern — so the sign cannot be lost.
 *
 * @return 0 when every in-range signed narrow keeps its value and sign, else the failing check
 */
fn f_cast_narrow_negative_keeps_sign() -> i64 {
    mut a: i64 = -5
    if (a to i32) != -5 to i32 { return 1 }
    if (a to i16) != -5 to i16 { return 2 }
    if (a to i8) != -5 to i8 { return 3 }
    mut b: i64 = -2147483648
    if (b to i32) != -2147483648 to i32 { return 4 }
    0
}

/**
 * f_cast_same_width_sign_change_keeps_value — an EQUAL-WIDTH `to` across the sign boundary
 * (`i64` → `u64`) on a value both types represent.
 *
 * Measured wrong before the guard landed, native route only: `2^40 to u64` from an `i64` answered
 * **0**. Equal widths are not a widen, so the old lowering still picked `Trunc`, and the 32-bit move
 * erased the whole top half of a value that needed no conversion whatsoever.
 *
 * @return 0 when the equal-width conversion is the identity it must be, else the failing check
 */
fn f_cast_same_width_sign_change_keeps_value() -> i64 {
    mut a: i64 = 1099511627776
    if (a to u64) != 1099511627776 to u64 { return 1 }
    mut b: u64 = 1099511627776
    if (b to i64) != 1099511627776 { return 2 }
    mut c: i64 = 0
    if (c to u64) != 0 to u64 { return 3 }
    0
}

/**
 * f_cast_widen_keeps_value — the widening `to`, which never needed a guard and must not have gained
 * one: the guard is skipped exactly when `checker::cast_is_lossless_widen` says the destination holds
 * every source value, so a widen still costs no compare and no branch.
 *
 * @return 0 when every widening `to` keeps its value, else the number of the failing check
 */
fn f_cast_widen_keeps_value() -> i64 {
    mut a: u8 = 200 to u8
    let wide_unsigned: u64 = a to u64
    if wide_unsigned != 200 to u64 { return 1 }
    mut b: i32 = -5 to i32
    let wide_signed: i64 = b to i64
    if wide_signed != -5 { return 2 }
    mut c: u32 = 4294967295 to u32
    let wide_peer: i64 = c to i64
    if wide_peer != 4294967295 { return 3 }
    0
}

/**
 * f_implicit_widen_owner_snippet — the owner's own program, verbatim in shape (owner 2026-07-29):
 * an `i32` flows into an `i64` through a compound `+=`, a compound `*=`, and a plain `=`, with no
 * `to` written anywhere. All three were REJECTED before this ("assigned value does not match the
 * target type") while `b + a` — the same two widths, one regime over — already compiled.
 *
 * @return 0 when all three forms compile and compute the stated values, else the failing check
 */
fn f_implicit_widen_owner_snippet() -> i64 {
    mut a: i32 = 1000
    mut b: i64 = 1
    b += a
    if b != 1001 { return 1 }
    b = 3
    b *= a
    if b != 3000 { return 2 }
    b = a
    if b != 1000 { return 3 }
    0
}

/**
 * f_implicit_widen_boundary_values — the implicit widening at each source type's EXTREME, where a
 * lost bit would be visible: `u32::MAX` into both `u64` and `i64` (the W-RULE's mixed-sign peer case
 * — lossless only because the signed side is strictly wider), and `i32::MIN` into `i64`.
 *
 * @return 0 when every boundary value survives the implicit widening, else the failing check
 */
fn f_implicit_widen_boundary_values() -> i64 {
    mut a: u32 = 4294967295 to u32
    mut wide: u64 = 0 to u64
    wide = a
    if wide != 4294967295 to u64 { return 1 }
    mut signed_wide: i64 = 0
    signed_wide = a
    if signed_wide != 4294967295 { return 2 }
    mut b: i32 = -2147483648 to i32
    signed_wide = b
    if signed_wide != -2147483648 { return 3 }
    mut c: u8 = 255 to u8
    wide = c
    if wide != 255 to u64 { return 4 }
    0
}

/**
 * f_implicit_widen_targets — the implicit widening at every target site the ladder now serves: an
 * annotated `let`, a struct FIELD assignment, a slice ELEMENT assignment, and a call ARGUMENT. The
 * rungs used to be open-coded per site, so a rung added to one was a rung missing from the others;
 * this pins that they all took it.
 *
 * @return 0 when each target site widens the narrower value, else the number of the failing check
 */
fn f_implicit_widen_targets() -> i64 {
    mut n: i32 = 7
    let bound: i64 = n
    if bound != 7 { return 1 }
    mut h = CastWidenHolder { wide = 0 }
    h.wide = n
    if h.wide != 7 { return 2 }
    mut xs: []i64 = teko::list::push(teko::list::empty(), 0)
    xs[0] = n
    if xs[0] != 7 { return 3 }
    if cast_widen_consumer(n) != 7 { return 4 }
    0
}

/**
 * ElemShade — a plain declared `enum` used as a slice ELEMENT type, so degrau 28's element write is
 * measured over an integer CARRIER that is not a primitive: `is_register_value_type` has to answer
 * "yes" for it or the write would take the aggregate arm and store a boxed address into a slot the
 * read loads as a carrier.
 */
type ElemShade = enum { Off; Warm; Hot }

/**
 * ElemPt — the AGGREGATE slice element degrau 28's element write boxes. Two 8-byte fields, so a copy
 * sized at one machine word would carry `x` and lose `y`.
 */
type ElemPt = struct {
    /** x — the value the element was written with. */
    x: i64

    /** y — a second, independent witness of the same write. */
    y: i64
}

/**
 * d28_zeros — a `teko::list::push`-GROWN buffer of `n` zeros, so degrau 28's element write is
 * measured over a runtime-grown buffer as well as over an array literal's boxed one. The two are the
 * same `[]i64` to the checker and different memory to the backend, and only a write that reads the
 * receiver's own `{ptr, len}` pair lands correctly in both.
 *
 * @param n  how many zero elements to grow
 * @return   the grown buffer
 */
fn d28_zeros(n: i64) -> []i64 {
    mut ys: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        ys = teko::list::push(ys, 0)
        i++
    }
    ys
}

/**
 * f_slice_elem_store_boundaries — 0.3.1.0 degrau 28: the element WRITE `xs[i] = v`, which the native
 * backend refused outright ("slice element index-assignment not yet lowered") until this degrau, over
 * the THREE indices a store gets wrong independently — the FIRST (offset 0, where a stride bug
 * hides), a MIDDLE one, and the LAST (where an off-by-one guard writes past the buffer).
 *
 * Every write is read back through the element it named AND its SIBLINGS are re-checked, so a store
 * that landed one slot away fails here instead of passing on the element it corrupted. The second
 * half repeats it over a DYNAMIC index (a loop counter) into a `push`-grown buffer, which is the
 * runtime-multiply address path rather than the folded-constant one.
 *
 * @return 0 when every write is read back at its own index, else the number of the failing check
 */
fn f_slice_elem_store_boundaries() -> i64 {
    mut xs: []i64 = [10, 20, 30, 40, 50]
    xs[0] = 11
    if xs[0] != 11 { return 1 }
    if xs[1] != 20 { return 2 }
    xs[2] = 33
    if xs[2] != 33 { return 3 }
    if xs[1] != 20 { return 4 }
    if xs[3] != 40 { return 5 }
    xs[4] = 55
    if xs[4] != 55 { return 6 }
    if xs[3] != 40 { return 7 }
    if xs[0] != 11 { return 8 }
    if xs.len != 5 { return 9 }
    mut ys = d28_zeros(5)
    mut i: i64 = 0
    loop {
        if i >= 5 { break }
        ys[i] = i * 7 + 1
        i++
    }
    i = 0
    loop {
        if i >= 5 { break }
        if ys[i] != i * 7 + 1 { return 10 }
        i++
    }
    if ys.len != 5 { return 11 }
    0
}

/**
 * D27_TENTH_F32 — `0.1` held as an `f32`, whose EXACT binary64 value (`0.10000000149011612`) is the
 * one text a correct `f32`-to-text path must produce. A single-precision register read at double
 * width produces something else entirely, which is what made this constant the sonda of the family
 * (0.3.1.0 degrau 27).
 */
const D27_TENTH_F32: f32 = 0.1

/**
 * D27_HALVES_F32 — `2.5` held as an `f32`: exactly representable in BOTH widths, so its text is the
 * same (`2.5`) whichever width the value physically has. It is the control against `D27_TENTH_F32`:
 * a path that renders this one right and that one wrong is reading the register at the wrong width,
 * not mis-rounding (0.3.1.0 degrau 27).
 */
const D27_HALVES_F32: f32 = 2.5

/**
 * d27_ftoa_of — one of FIVE runtime-selected `f64` values rendered through `teko::ftoa`, chosen by
 * `tag` so the value reaching `ftoa` is a RUNTIME value and not a literal the front end could fold
 * into the call's own result (0.3.1.0 degrau 27). `f_ftoa_literal_text` covers the literal direction
 * separately, on purpose: the two travel by different roads (a `LConstFloat` bit pattern on the own
 * backend, a spelled C constant on the C route) and only asserting both certifies the pair.
 *
 * @param tag  which value to render: 0 → `+0.0`, 1 → `-0.0`, 2 → `1.0`, 3 → `-2.5`, 4 → `1/3`
 * @return     the value's `%.17g` text
 */
fn d27_ftoa_of(tag: i64) -> str {
    mut zero: f64 = 0.0
    mut minus_one: f64 = -1.0
    mut one: f64 = 1.0
    mut two_and_a_half: f64 = 2.5
    mut three: f64 = 3.0
    if tag == 0 { return teko::ftoa(zero) }
    if tag == 1 { return teko::ftoa(minus_one * zero) }
    if tag == 2 { return teko::ftoa(one) }
    if tag == 3 { return teko::ftoa(minus_one * two_and_a_half) }
    teko::ftoa(one / three)
}

/**
 * d27_infinity — a POSITIVE infinity produced at RUNTIME by overflowing binary64 multiplication, so
 * the value is not a literal any constant folder could have spelled (0.3.1.0 degrau 27).
 *
 * @return  `+inf`
 */
fn d27_infinity() -> f64 {
    mut huge: f64 = 1.0e308
    mut ten: f64 = 10.0
    huge * ten
}

/**
 * d27_not_a_number — a NaN produced at RUNTIME as `inf - inf`, the shortest arithmetic route to one
 * that needs no NaN literal (which the language's surface has none of) (0.3.1.0 degrau 27).
 *
 * @return  a NaN
 */
fn d27_not_a_number() -> f64 {
    d27_infinity() - d27_infinity()
}

/**
 * f_ftoa_runtime_text — 0.3.1.0 degrau 27: `teko::ftoa(f64) -> str`, the `%.17g` host renderer, was
 * the stop that blocked the native self-host (`teko::codegen::cb_f64_literal` renders every float
 * literal the C route emits through it). Now lowered to `tk_ftoa_len` through the out-parameter-length
 * convention.
 *
 * Asserted BY TEXT, never by "it compiled": each value is one a float formatter is known to get
 * wrong, and each expected string is the one the C ROUTE prints for the same program (the oracle,
 * measured). `+0.0` and `-0.0` differ ONLY in the sign bit and `%.17g` renders neither with a
 * fractional part, so they are the pair that catches a renderer that lost the sign; `1.0` renders as
 * `1` with no `.0`, which is the shape that reads back as a C INTEGER and is why the literal
 * direction needed its own fix; `1/3` is the many-digit case that catches a short-cut renderer.
 *
 * @return 0 when every value renders exactly, else the number of the failing check
 */
fn f_ftoa_runtime_text() -> i64 {
    if d27_ftoa_of(0) != "0" { return 1 }
    if d27_ftoa_of(1) != "-0" { return 2 }
    if d27_ftoa_of(2) != "1" { return 3 }
    if d27_ftoa_of(3) != "-2.5" { return 4 }
    if d27_ftoa_of(4) != "0.33333333333333331" { return 5 }
    0
}

/**
 * f_slice_elem_store_widths — degrau 28's element write at every ELEMENT CLASS the store's width can
 * be picked wrong for: a four-byte `i32`, a one-byte `u8` and `byte`, a `bool`, an `f64` (the float
 * store, a different register file) and a declared `enum`'s integer carrier. A store emitted at the
 * wrong width writes into the neighbouring element, so each check reads its own element AND a
 * neighbour.
 *
 * @return 0 when every element class is written at its own width, else the failing check
 */
fn f_slice_elem_store_widths() -> i64 {
    mut a: []i32 = [1 to i32, 2 to i32, 3 to i32]
    a[1] = 77 to i32
    if a[1] != 77 to i32 { return 1 }
    if a[0] != 1 to i32 { return 2 }
    if a[2] != 3 to i32 { return 3 }
    mut b: []u8 = [1 to u8, 2 to u8, 3 to u8]
    b[2] = 250 to u8
    if b[2] != 250 to u8 { return 4 }
    if b[1] != 2 to u8 { return 5 }
    mut c: []byte = [0 to byte, 0 to byte, 0 to byte]
    c[1] = 200 to byte
    if c[1] != 200 to byte { return 6 }
    if c[0] != 0 to byte { return 7 }
    if c[2] != 0 to byte { return 8 }
    mut d: []bool = [false, false, true]
    d[0] = true
    if !d[0] { return 9 }
    if d[1] { return 10 }
    if !d[2] { return 11 }
    mut e: []f64 = [1.0, 2.0, 3.0]
    e[2] = 2.5
    if e[2] != 2.5 { return 12 }
    if e[0] != 1.0 { return 13 }
    mut f: []ElemShade = [ElemShade::Off, ElemShade::Off, ElemShade::Off]
    f[1] = ElemShade::Hot
    if f[1] != ElemShade::Hot { return 14 }
    if f[0] != ElemShade::Off { return 15 }
    if f[2] != ElemShade::Off { return 16 }
    0
}

/**
 * f_ftoa_literal_text — 0.3.1.0 degrau 27: the LITERAL direction of the same renderer. A float
 * literal reaches the own backend as a `LConstFloat` BIT PATTERN and reaches the C route as a
 * SPELLED C constant, so the two roads can disagree — and they did. Measured on the base of this
 * degrau:
 *
 * - `-0.0` printed `-0` through the own backend and `0` through the C route: `%.17g` renders it as
 *   `-0`, which C reads as the `int` zero and converts to `+0.0`, dropping the sign bit before any
 *   conversion happens (`codegen.tks::cb_f64_literal`, fixed here with `c_double_spelling`);
 * - `1.0e400` did not COMPILE through the C route at all (`error: 'inf' undeclared`) while the own
 *   backend built and ran it, because `inf` is not a C constant (fixed here by emitting `<math.h>`'s
 *   own `INFINITY`).
 *
 * The extreme magnitudes are here for the round trip itself: `%.17g` is exact for binary64, so a
 * renderer or a re-parse that lost a digit changes these texts.
 *
 * @return 0 when every literal renders exactly, else the number of the failing check
 */
fn f_ftoa_literal_text() -> i64 {
    if teko::ftoa(0.0) != "0" { return 1 }
    if teko::ftoa(-0.0) != "-0" { return 2 }
    if teko::ftoa(1.0) != "1" { return 3 }
    if teko::ftoa(-2.5) != "-2.5" { return 4 }
    if teko::ftoa(1.0e300) != "1.0000000000000001e+300" { return 5 }
    if teko::ftoa(5.0e-324) != "4.9406564584124654e-324" { return 6 }
    if teko::ftoa(1.0e400) != "inf" { return 7 }
    0
}

/**
 * f_slice_elem_compound_ops — the COMPOUND element write `xs[i] op= v`, degrau 28's twin of the plain
 * one. It shares `store_assign_value` with a struct field's own compound write, so it must LOAD the
 * current element, apply the arithmetic and store the result back at the SAME address — a store that
 * recomputed the address from a re-lowered index, or that skipped the load, is visible as a wrong
 * value here. Run at index 0, a middle index and the last index, and over a dynamic index too.
 *
 * @return 0 when every compound operator reads and writes the element it names, else the failing check
 */
fn f_slice_elem_compound_ops() -> i64 {
    mut xs: []i64 = [10, 20, 30, 40, 45]
    xs[0] += 5
    if xs[0] != 15 { return 1 }
    if xs[1] != 20 { return 2 }
    xs[1] -= 6
    if xs[1] != 14 { return 3 }
    xs[2] *= 3
    if xs[2] != 90 { return 4 }
    xs[3] /= 4
    if xs[3] != 10 { return 5 }
    xs[4] %= 7
    if xs[4] != 3 { return 6 }
    if xs[0] != 15 { return 7 }
    mut i: i64 = 2
    xs[i] += 10
    if xs[2] != 100 { return 8 }
    if xs[1] != 14 { return 9 }
    if xs[3] != 10 { return 10 }
    0
}

/**
 * f_ftoa_nonfinite_text — 0.3.1.0 degrau 27: the two non-finite classes ARE representable on this
 * surface (an overflowing multiplication reaches `+inf`, `inf - inf` reaches a NaN) and so they are
 * covered rather than skipped.
 *
 * The infinities are pinned to their exact texts (`inf`/`-inf`, what `%g` is required to print). The
 * NaN is pinned only by its SUFFIX: a NaN's sign bit and payload are the host libc's business, and
 * glibc prints `-nan` for `inf - inf` where another conforming libc may print `nan` — this corpus
 * runs on glibc, on musl AND on the Microsoft CRT, so asserting the exact spelling would pin a
 * platform, not a behavior. The suffix still fails loudly for a renderer that printed a number, an
 * empty string, or `0`, and it forces three bytes of text ON ITS OWN — a three-byte suffix cannot
 * match a shorter string — which is the claim the old numbered check 4 spelled a second time.
 *
 * WHY EVERY CLAIM IS AN ASSERTION AND NO LONGER A NUMBERED `return`. The suffix check FAILED on
 * `windows-x86_64` in three independent samples, and everything this fixture could say was
 * `expected 0, got 3` — the number of the check, never the text that failed it. TWO different faults
 * produce that same number, and they belong to different owners: the Microsoft CRT spelling a NaN its
 * own way (a libc fact, this fixture's business), or a value that is NOT the NaN built here reaching
 * `teko::ftoa` (a compiler fact, the backend's business). The TEXT tells them apart — `-nan(ind)` is
 * a spelling, `0` or `1.5e+300` is a wrong value — so every claim here is an assertion that QUOTES
 * what it saw, and one CI run answers the question instead of a widened claim guessing at it.
 *
 * THE BITS ARE DELIBERATELY NOT REPORTED, and that is a measurement, not an omission. Building the
 * report through `teko::f64_bits` was tried first and MEASURED WRONG on the own backend (2026-07-31,
 * Linux/x86-64, teko 0.3.0.31-beta): asked for the bits of a local produced by `inf - inf`, the own
 * backend answered `0x4024000000000000` — the bits of `10.0`, the last `f64` constant the PRODUCING
 * function touched — where the C route answers `0xFFF8000000000000`, while `teko::ftoa` of that same
 * local answered `-nan` correctly on both routes. A fixture that printed those bits would accuse the
 * value of a defect that belongs to the instrument reading it.
 *
 * THE CASE NAMES ITSELF because these assertions run inside the probe, i.e. BEFORE `scenario()`
 * evaluates its argument and names the case — without this line the panic would report an assertion
 * with no case attached, which is the addressability hole `scenario()` exists to close. The spelling
 * is the one `main.tks` and `own_native.tkr` both already use.
 *
 * @return 0 — every claim is an assertion now, so a failing one panics with what it SAW instead of
 *         returning a number a reader has to look up
 */
fn f_ftoa_nonfinite_text() -> i64 {
    teko::assert::scenario_begin("ftoa_nonfinite_text")
    mut minus_one: f64 = -1.0
    teko::assert::eq_str(teko::ftoa(d27_infinity()), "inf")
    teko::assert::eq_str(teko::ftoa(minus_one * d27_infinity()), "-inf")
    let nan_text = teko::ftoa(d27_not_a_number())
    teko::assert::str_contains(nan_text, "nan")
    0
}

/**
 * f_slice_elem_store_fat — the FAT element write (`[]str`, `[][]i64`): the element slot IS a two-word
 * `{ptr, len}` pair, so a write that stored ONE machine word would leave the reader taking whatever
 * length the slot held before — the raiz-comum §5.2 silence, asked of an element instead of a field.
 * Each element is therefore read back by LENGTH and by CONTENT, and the nested case's replacement
 * slice has a DIFFERENT length from the one it replaces so a kept-old-length bug cannot hide.
 *
 * @return 0 when every fat element carries the pointer AND the length it was written with, else the
 *         failing check
 */
fn f_slice_elem_store_fat() -> i64 {
    mut ss: []str = ["a", "bb", "ccc"]
    ss[1] = "dddd"
    if ss[1].len != 4 { return 1 }
    if ss[1] != "dddd" { return 2 }
    if ss[0] != "a" { return 3 }
    if ss[2] != "ccc" { return 4 }
    ss[0] = ""
    if ss[0].len != 0 { return 5 }
    if ss[2].len != 3 { return 6 }
    ss[2] = teko::str::concat("ee", "fff")
    if ss[2] != "eefff" { return 7 }
    if ss[2].len != 5 { return 8 }
    mut nested: [][]i64 = [[1, 2], [3, 4]]
    nested[0] = [7, 8, 9]
    if nested[0].len != 3 { return 9 }
    if nested[0][0] != 7 { return 10 }
    if nested[0][2] != 9 { return 11 }
    if nested[1].len != 2 { return 12 }
    if nested[1][1] != 4 { return 13 }
    0
}

/**
 * f_f64_g17_agrees_with_ftoa — 0.3.1.0 degrau 27: `teko::f64_g17` is the SECOND name the checker
 * registers for the same `%.17g` host renderer, and it was stopping for exactly the same reason
 * `ftoa` was. It is now lowered to its own runtime twin (`tk_f64_g17_len`), so the two reach
 * DIFFERENT runtime symbols and can only agree when both lowerings are right.
 *
 * Each value is checked twice: against `ftoa`'s output on the same value (the cross-check, which no
 * hand-written expectation can make vacuous) and against the pinned text (which catches the case
 * where both renderers are wrong the same way).
 *
 * @return 0 when both renderers agree and match the pinned text, else the number of the failing check
 */
fn f_f64_g17_agrees_with_ftoa() -> i64 {
    mut i: i64 = 0
    loop {
        if i > 4 { break }
        if teko::f64_g17(d27_f64_case(i)) != d27_ftoa_of(i) { return 1 }
        i++
    }
    if teko::f64_g17(d27_f64_case(1)) != "-0" { return 2 }
    if teko::f64_g17(d27_f64_case(4)) != "0.33333333333333331" { return 3 }
    0
}

/**
 * f_slice_elem_store_aggregate — the AGGREGATE element write. This backend holds a `[]struct` as a
 * slice of ADDRESSES and its value for an instance is the address of an `alloca` — ONE frame slot per
 * INSTRUCTION — so a write that stored that address as-is would make every element written in a loop
 * point at the same slot, and a later mutation of the source binding would reach the element. The
 * write boxes into fresh per-EXECUTION storage instead (`tk_slice_elem_box`, the same copy a push
 * makes), which these checks pin: distinct elements after a loop of writes, and a source mutated
 * AFTER the write that must not be visible through the element.
 *
 * @return 0 when each written element owns its own copy, else the failing check
 */
fn f_slice_elem_store_aggregate() -> i64 {
    mut ps: []ElemPt = [ElemPt { x = 0; y = 0 }, ElemPt { x = 0; y = 0 }, ElemPt { x = 0; y = 0 }]
    mut i: i64 = 0
    loop {
        if i >= 3 { break }
        ps[i] = ElemPt { x = i + 1; y = (i + 1) * 10 }
        i++
    }
    if ps[0].x != 1 { return 1 }
    if ps[0].y != 10 { return 2 }
    if ps[1].x != 2 { return 3 }
    if ps[1].y != 20 { return 4 }
    if ps[2].x != 3 { return 5 }
    if ps[2].y != 30 { return 6 }
    if ps[0].x == ps[2].x { return 7 }
    mut src = ElemPt { x = 9; y = 90 }
    ps[1] = src
    src.x = 111
    src.y = 222
    if ps[1].x != 9 { return 8 }
    if ps[1].y != 90 { return 9 }
    if ps[0].x != 1 { return 10 }
    if ps[2].x != 3 { return 11 }
    0
}

/**
 * d27_f64_case — the VALUE `d27_ftoa_of` renders for the same `tag`, so the two renderers can be
 * compared on identical inputs without either one's text being the specification for the other
 * (0.3.1.0 degrau 27).
 *
 * @param tag  which value: 0 → `+0.0`, 1 → `-0.0`, 2 → `1.0`, 3 → `-2.5`, 4 → `1/3`
 * @return     the value
 */
fn d27_f64_case(tag: i64) -> f64 {
    mut zero: f64 = 0.0
    mut minus_one: f64 = -1.0
    mut one: f64 = 1.0
    mut two_and_a_half: f64 = 2.5
    mut three: f64 = 3.0
    if tag == 0 { return zero }
    if tag == 1 { return minus_one * zero }
    if tag == 2 { return one }
    if tag == 3 { return minus_one * two_and_a_half }
    one / three
}

/**
 * f_float_hole_natural_form — 0.3.1.0 degrau 27: a NO-FORMAT-SPEC interpolation hole over a float
 * (`$"{x}"`) used to be its own honest stop (`float interpolation hole not yet lowered`) even though
 * the C route renders it through the very builtin this degrau lowered — `tk_ftoa((double)(x))`, its
 * natural-form arm. The sibling is closed here through the SAME `tk_ftoa_len` twin.
 *
 * Each hole is compared against a DIRECT `teko::ftoa` call on the same value: the two travel
 * different lowering paths (the interpolation hole builder versus the builtin call resolver) and meet
 * at one runtime symbol, so agreement is evidence and not a restated expectation.
 *
 * @return 0 when every hole matches its direct-call twin and the pinned text, else the failing check
 */
fn f_float_hole_natural_form() -> i64 {
    mut i: i64 = 0
    loop {
        if i > 4 { break }
        let x = d27_f64_case(i)
        if $"{x}" != teko::ftoa(x) { return 1 }
        i++
    }
    let negative_zero = d27_f64_case(1)
    if $"[{negative_zero}]" != "[-0]" { return 2 }
    let a_third = d27_f64_case(4)
    if $"{a_third}" != "0.33333333333333331" { return 3 }
    0
}

/**
 * f_slice_elem_foreach_writeback — `loop v in xs { v = … }` over a `mut` container, which the parser
 * desugars to the element write itself (`loop_slice_writeback`, "the ratified element-assignment
 * primitive"). Until degrau 28 the desugaring hit the very stop this function's own writes did, so a
 * mutable for-each — one of the language's ordinary loop spellings — could not be built natively at
 * all. Covered over a scalar container and a FAT one, each read back element by element.
 *
 * @return 0 when the write-back reaches every element of both containers, else the failing check
 */
fn f_slice_elem_foreach_writeback() -> i64 {
    mut xs: []i64 = [1, 2, 3, 4]
    loop v in xs { v = v * 10 }
    if xs[0] != 10 { return 1 }
    if xs[1] != 20 { return 2 }
    if xs[2] != 30 { return 3 }
    if xs[3] != 40 { return 4 }
    if xs.len != 4 { return 5 }
    mut ss: []str = ["a", "bb"]
    loop s in ss { s = s ~ "!" }
    if ss[0] != "a!" { return 6 }
    if ss[1] != "bb!" { return 7 }
    if ss[1].len != 3 { return 8 }
    0
}

/**
 * f_f32_text_is_its_own_value — 0.3.1.0 degrau 27, and the DEFECT this degrau's sibling search found:
 * an `f32` rendered to text through ANY of the four routes must produce the exact binary64 value of
 * the single-precision number, because every `tk_*` renderer declares a `double` parameter while an
 * `f32` physically holds single precision.
 *
 * Measured on the base, against the C route on the same program: `$"{f:F2}"` over `f: f32 = 2.5`
 * printed `2.50` through C and `0.10` through the own backend; `$"{f:G}"` printed `2.5` and
 * `4.65274e-310`; `$"{f:F4}"` over `0.1` printed `0.1000` and `0.0000`. A wrong VALUE with no
 * diagnostic, in code that had been green since degrau 19 — the widening the C route gets from `cc`'s
 * implicit `(double)` conversion had no counterpart in the own backend's lowering
 * (`widen_hole_to_f64`).
 *
 * The two constants are a matched pair: `2.5` is exactly representable in both widths (so its text is
 * width-independent) and `0.1` is not (so its text names the width it was read at). A route that
 * gets `2.5` right and `0.1` wrong read the register at the wrong width.
 *
 * @return 0 when every route renders the `f32`'s own value, else the number of the failing check
 */
fn f_f32_text_is_its_own_value() -> i64 {
    let tenth = D27_TENTH_F32
    let halves = D27_HALVES_F32
    if teko::ftoa(tenth) != "0.10000000149011612" { return 1 }
    if teko::f64_g17(tenth) != "0.10000000149011612" { return 2 }
    if $"{tenth}" != "0.10000000149011612" { return 3 }
    if teko::ftoa(halves) != "2.5" { return 4 }
    if $"{halves}" != "2.5" { return 5 }
    if $"{halves:F2}" != "2.50" { return 6 }
    if $"{tenth:F4}" != "0.1000" { return 7 }
    if $"{halves:G}" != "2.5" { return 8 }
    if $"{halves:E3}" != "2.500e+00" { return 9 }
    if $"{halves:N2}" != "2.50" { return 10 }
    if $"{halves:P1}" != "250.0%" { return 11 }
    if $"{halves:[d27_dynamic_spec()]}" != "2.500" { return 12 }
    if $"{tenth:[d27_dynamic_spec()]}" != "0.100" { return 13 }
    0
}

/**
 * f_float_hole_bare_literal_stays_runtime — the OWNER invariant for numeric interpolation
 * (2026-08-02): the render of an `f32`/`f64` (and of `dec`/`bigint`) hole to text is deferred to the
 * RUNTIME renderer and is NEVER folded to a string literal at compile time, because a compile-time
 * fold of a float would diverge from the runtime's own result (rounding, precision, FPU mode) and so
 * break both correctness and the fixpoint.
 *
 * A BARE float LITERAL sitting directly in the hole (`$"{2.5}"`) is the PUREST fold target the layer
 * can face — the hole expression is itself the constant a fold would render — and the sibling
 * `f_f32_text_is_its_own_value` only ever interpolates a `let`-bound const, never a raw literal. The
 * fold declines every float family (`cf_is_const_literal` excludes a float number literal), so the
 * value travels the same `tk_ftoa_len`/`tk_fmt_f_len` runtime path a runtime float does. Proven two
 * ways per value: agreement with a DIRECT `teko::ftoa` call on the same literal (the interpolation
 * hole builder and the builtin call resolver are different lowerings meeting at one runtime symbol,
 * so agreement is evidence and not a restated expectation) and, for the exactly-representable `2.5`
 * whose text is unambiguous, agreement with the pinned form.
 *
 * @return 0 when every bare-literal hole matches its runtime twin and pinned text, else the failing check
 */
fn f_float_hole_bare_literal_stays_runtime() -> i64 {
    if $"{2.5}" != teko::ftoa(2.5) { return 1 }
    if $"{0.1}" != teko::ftoa(0.1) { return 2 }
    if $"{2.5}" != "2.5" { return 3 }
    if $"{2.5:F2}" != "2.50" { return 4 }
    0
}

/**
 * oobr_grown — a `teko::list::push`-GROWN buffer holding `1 … n`, so the element READ's bounds guard
 * is measured against a length the RECEIVER carries at runtime rather than one an array literal fixed
 * at compile time. The two are the same `[]i64` to the checker and different memory to the backend, and
 * a guard that read the wrong length half would reject the last element of exactly one of them.
 *
 * @param n  how many elements to grow
 * @return   the grown buffer, holding 1 through n in order
 */
fn oobr_grown(n: i64) -> []i64 {
    mut ys: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        ys = teko::list::push(ys, i + 1)
        i++
    }
    ys
}

/**
 * f_slice_elem_read_boundaries — the element READ `xs[i]` now carries a bounds guard (0.3.1.0
 * leitura-fora-de-fronteira), and this pins that the guard did not break the GOOD path: the FIRST
 * index (offset 0), a MIDDLE one and the LAST (the index an off-by-one guard rejects), over a
 * CONSTANT index and over a DYNAMIC one, on an array literal's boxed buffer and on a `push`-grown one.
 *
 * The last index is the load-bearing half. A guard written `index <= len` would let the read walk one
 * element past the buffer, and a guard written `index < len - 1` would panic on the last element of
 * every well-formed program — both are invisible to a test that only reads element 0.
 *
 * @return 0 when every in-bounds index reads its own element, else the number of the failing check
 */
fn f_slice_elem_read_boundaries() -> i64 {
    let xs: []i64 = [10, 20, 30, 40, 50]
    if xs[0] != 10 { return 1 }
    if xs[2] != 30 { return 2 }
    if xs[4] != 50 { return 3 }
    mut i: i64 = 0
    loop {
        if i >= 5 { break }
        if xs[i] != (i + 1) * 10 { return 4 }
        i++
    }
    let ys = oobr_grown(5)
    if ys[0] != 1 { return 5 }
    if ys[4] != 5 { return 6 }
    i = 0
    mut sum: i64 = 0
    loop {
        if i >= ys.len to i64 { break }
        sum = sum + ys[i]
        i++
    }
    if sum != 15 { return 7 }
    0
}

/**
 * f_slice_elem_read_widths — the guarded element READ at every ELEMENT CLASS whose load width can be
 * picked wrong: a four-byte `i32`, a one-byte `u8` and `byte`, a `bool`, an `f64` (a different register
 * file) and a declared `enum`'s integer carrier. The guard sits between the index and the address, so a
 * guard that clobbered the index or the base would read the neighbouring element instead — each check
 * therefore reads its own element AND a neighbour.
 *
 * @return 0 when every element class reads back at its own width, else the failing check
 */
fn f_slice_elem_read_widths() -> i64 {
    let a: []i32 = [1 to i32, 2 to i32, 3 to i32]
    if a[1] != 2 to i32 { return 1 }
    if a[2] != 3 to i32 { return 2 }
    let b: []u8 = [1 to u8, 250 to u8, 3 to u8]
    if b[1] != 250 to u8 { return 3 }
    if b[0] != 1 to u8 { return 4 }
    let c: []byte = [0 to byte, 200 to byte, 7 to byte]
    if c[1] != 200 to byte { return 5 }
    if c[2] != 7 to byte { return 6 }
    let d: []bool = [false, true, false]
    if !d[1] { return 7 }
    if d[2] { return 8 }
    let e: []f64 = [1.5, 2.5, 3.5]
    if e[1] != 2.5 { return 9 }
    if e[2] != 3.5 { return 10 }
    let g: []ElemShade = [ElemShade::Off, ElemShade::Hot, ElemShade::Warm]
    if g[1] != ElemShade::Hot { return 11 }
    if g[2] != ElemShade::Warm { return 12 }
    0
}

/**
 * f_slice_elem_read_fat — the FAT arm of the guarded element read (`lower_index_fat`): a `[]str` and a
 * `[][]i64` element, each checked by LENGTH and by CONTENT. This arm changed shape as well as gaining a
 * guard — its receiver is now lowered as a FAT producer, because the LENGTH half is what the guard
 * needs — so a receiver whose two halves came apart would read a valid pointer with somebody else's
 * length, which is the failure a length-only check would miss.
 *
 * @return 0 when every fat element reads back both halves, else the failing check
 */
fn f_slice_elem_read_fat() -> i64 {
    let ss: []str = ["alpha", "be", "c"]
    if ss[0] != "alpha" { return 1 }
    if ss[0].len != 5 { return 2 }
    if ss[2] != "c" { return 3 }
    if ss[2].len != 1 { return 4 }
    let nn: [][]i64 = [[1, 2, 3], [4], [5, 6]]
    if nn[0].len != 3 { return 5 }
    if nn[1].len != 1 { return 6 }
    if nn[2].len != 2 { return 7 }
    if nn[0][2] != 3 { return 8 }
    if nn[2][1] != 6 { return 9 }
    mut i: i64 = 0
    mut total: i64 = 0
    loop {
        if i >= 3 { break }
        total = total + ss[i].len to i64
        i++
    }
    if total != 8 { return 10 }
    0
}

/**
 * f_slice_elem_read_nested — the guarded fat read CHAINED: `nn[i][j]` whose inner receiver is itself an
 * index, so the outer subscript's guard runs against a length that the inner subscript's own guarded
 * read produced. Both indices are dynamic, so neither address folds, and each row is walked to its own
 * LAST element — the index an off-by-one guard rejects, now nested one level deeper.
 *
 * @return 0 when every element of every row is reached, else the failing check
 */
fn f_slice_elem_read_nested() -> i64 {
    let nn: [][]i64 = [[1, 2, 3], [4], [5, 6]]
    mut r: i64 = 0
    mut total: i64 = 0
    loop {
        if r >= nn.len to i64 { break }
        mut c: i64 = 0
        loop {
            if c >= nn[r].len to i64 { break }
            total = total + nn[r][c]
            c++
        }
        r++
    }
    if total != 21 { return 1 }
    if nn[nn.len to i64 - 1][1] != 6 { return 2 }
    0
}

/**
 * d27_dynamic_spec — the format spec of the DYNAMIC-spec rows, returned from a function so the spec
 * text is a runtime value and the hole takes the `tk_fmt_dyn_f64_len` path rather than the static one
 * (0.3.1.0 degrau 27).
 *
 * @return  `"F3"`, three fixed decimal places
 */
fn d27_dynamic_spec() -> str { "F3" }

/**
 * f_str_index_in_bounds — `str[i]`, the OTHER guarded read path (`lower_index_str`, distinct from
 * `lower_index_slice` — the finding named both). Its receiver already arrived as a fat value, so only
 * the guard is new here; what this pins is that the byte load still reads the byte the C route reads,
 * at index 0, in the middle and at the LAST byte of a literal, of a concatenation and of a multi-byte
 * string whose bytes are not its characters.
 *
 * @return 0 when every in-bounds byte matches, else the failing check
 */
fn f_str_index_in_bounds() -> i64 {
    let s = "abc"
    if s[0] to i64 != 97 { return 1 }
    if s[1] to i64 != 98 { return 2 }
    if s[2] to i64 != 99 { return 3 }
    let t = "ab" ~ "cd"
    if t.len != 4 { return 4 }
    if t[3] to i64 != 100 { return 5 }
    mut i: i64 = 0
    mut sum: i64 = 0
    loop {
        if i >= t.len to i64 { break }
        sum = sum + t[i] to i64
        i++
    }
    if sum != 394 { return 6 }
    let u = "é"
    if u.len != 2 { return 7 }
    if u[0] to i64 != 195 { return 8 }
    if u[1] to i64 != 169 { return 9 }
    0
}

/**
 * D30Sq — a plain by-value struct used as a NAMED payload of a null-bearing union, so degrau 30's
 * `null` arm is measured over a member that is neither a primitive nor a fat value. Its single field
 * is the witness the present arm reads back.
 */
type D30Sq = struct {
    /** side — the value the present case was constructed with. */
    side: i64
}

/**
 * D30Holder — a struct whose FIELD is a two-member null union, so the `null` arm is measured over a
 * subject that came out of a field read rather than out of a call.
 */
type D30Holder = struct {
    /** inner — the null-bearing field the `null` arm reads. */
    inner: i64 | null
}

/**
 * D30Nest — a struct whose field is a null union whose PAYLOAD is itself a struct, the shape degrau
 * 25 closed on the construction side and degrau 30 re-measures from the match side.
 */
type D30Nest = struct {
    /** deep — the null-bearing field whose payload is a by-value struct. */
    deep: D30Sq | null
}

/**
 * d30_three_i64 — the THREE-member null-bearing union at its simplest: an `i64` payload, an absence
 * case and an error case, selected by the sign of `n`. The RETURN placement of a bare `null` into a
 * three-member union is the construction half degrau 30 had to land together with the `null` arm.
 *
 * @param n  positive selects the payload, zero selects absence, negative selects the error
 * @return   `n * 2` for a positive `n`, absent for zero
 * @throws   for a negative `n`
 */
fn d30_three_i64(n: i64) -> i64 | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    n * 2
}

/**
 * d30_three_str — the same three-member union with a FAT payload, so the present arm binds the
 * (ptr, len) pair through `bind_fat_case_payload` rather than a single word.
 *
 * @param n  positive selects the payload, zero selects absence, negative selects the error
 * @return   a three-byte string for a positive `n`, absent for zero
 * @throws   for a negative `n`
 */
fn d30_three_str(n: i64) -> str | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    "abc"
}

/**
 * d30_three_slice — the same three-member union with a `[]i64` payload, the OTHER fat shape, whose
 * present arm must answer both a `.len` and an element read.
 *
 * @param n  positive selects the payload, zero selects absence, negative selects the error
 * @return   a two-element buffer for a positive `n`, absent for zero
 * @throws   for a negative `n`
 */
fn d30_three_slice(n: i64) -> []i64 | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    [n, n + 1]
}

/**
 * d30_three_named — the same three-member union with a NAMED struct payload, so the present arm
 * reads the payload back through the boxed address rather than out of the wrapper's own word.
 *
 * @param n  positive selects the payload, zero selects absence, negative selects the error
 * @return   a `D30Sq` of side `n` for a positive `n`, absent for zero
 * @throws   for a negative `n`
 */
fn d30_three_named(n: i64) -> D30Sq | null | error {
    if n == 0 { return null }
    if n < 0 { return error { message = "d30 negative" } }
    D30Sq { side = n }
}

/**
 * d30_two_i64 — the TWO-member null union, the arity that already worked, kept beside the three so a
 * regression that fixed one by breaking the other cannot pass.
 *
 * @param n  non-zero selects the payload, zero selects absence
 * @return   `n * 3` for a non-zero `n`, absent for zero
 */
fn d30_two_i64(n: i64) -> i64 | null {
    if n == 0 { return null }
    n * 3
}

/**
 * d30_read_arg — the ARGUMENT placement of a null union: the caller passes either a bare `null` or a
 * bare `i64` into a `i64 | null` parameter, so the wrapper is built at the CALL SITE
 * (`lower_arg_into_param`) rather than at a return.
 *
 * @param x  the null-bearing argument
 * @return   the payload when present, else 7
 */
fn d30_read_arg(x: i64 | null) -> i64 {
    match x {
        i64 as v => v
        null => 7
    }
}

/**
 * f_d30_null_arm_three_member — 0.3.1.0 degrau 30, and the exact shape the native self-host stopped
 * on: a `null` match arm over a THREE-member `i64 | null | error`. The pre-degrau-30 lowering tested
 * the literal tag `0` under a two-member guard, so this arm honest-stopped with "`null` match pattern
 * not yet lowered"; the `return null` that feeds it stopped one step earlier with "value's type is not
 * a member of its declared variant". The compiler's own `codegen::emit_variant_wrap` is this shape
 * over `[]byte | null | error`.
 *
 * All three arms are read back, and the two non-null arms are read back TOO: an arity fix that made
 * the `null` arm fire for every tag would satisfy an absence-only test.
 *
 * @return 0 when every arm answers its own case, else the failing check
 */
fn f_d30_null_arm_three_member() -> i64 {
    if d30_read_three(3) != 6 { return 1 }
    if d30_read_three(0) != 7 { return 2 }
    if d30_read_three(-1) != 9 { return 3 }
    if d30_read_three(1) != 2 { return 4 }
    if d30_read_two(3) != 9 { return 5 }
    if d30_read_two(0) != 7 { return 6 }
    0
}

/**
 * d30_read_three — the payload/absent/error readback of `d30_three_i64`, payload arm FIRST.
 *
 * @param n  the selector handed to `d30_three_i64`
 * @return   the doubled payload, 7 for absent, 9 for the error
 */
fn d30_read_three(n: i64) -> i64 {
    match d30_three_i64(n) {
        i64 as v => v
        null => 7
        error => 9
    }
}

/**
 * d30_read_two — the payload/absent readback of `d30_two_i64`, the arity-two control.
 *
 * @param n  the selector handed to `d30_two_i64`
 * @return   the tripled payload, or 7 for absent
 */
fn d30_read_two(n: i64) -> i64 {
    match d30_two_i64(n) {
        i64 as v => v
        null => 7
    }
}

/**
 * f_d30_null_arm_orders — 0.3.1.0 degrau 30: the ARM ORDER axis. The `null` arm written FIRST and
 * written LAST must select the same case, at arity two and at arity three, because the tag it tests
 * comes from the union's own member list and not from the arm's position. A lowering that read the
 * arm order instead would answer one order right and the other wrong.
 *
 * @return 0 when both orders agree at both arities, else the failing check
 */
fn f_d30_null_arm_orders() -> i64 {
    if d30_read_three_nullfirst(3) != 6 { return 1 }
    if d30_read_three_nullfirst(0) != 7 { return 2 }
    if d30_read_three_nullfirst(-1) != 9 { return 3 }
    if d30_read_two_nullfirst(3) != 9 { return 4 }
    if d30_read_two_nullfirst(0) != 7 { return 5 }
    if d30_read_three_nullfirst(3) != d30_read_three(3) { return 6 }
    if d30_read_three_nullfirst(0) != d30_read_three(0) { return 7 }
    if d30_read_three_nullfirst(-1) != d30_read_three(-1) { return 8 }
    0
}

/**
 * d30_read_three_nullfirst — the arity-three readback with the `null` arm written FIRST.
 *
 * @param n  the selector handed to `d30_three_i64`
 * @return   the doubled payload, 7 for absent, 9 for the error
 */
fn d30_read_three_nullfirst(n: i64) -> i64 {
    match d30_three_i64(n) {
        null => 7
        i64 as v => v
        error => 9
    }
}

/**
 * d30_read_two_nullfirst — the arity-two readback with the `null` arm written FIRST.
 *
 * @param n  the selector handed to `d30_two_i64`
 * @return   the tripled payload, or 7 for absent
 */
fn d30_read_two_nullfirst(n: i64) -> i64 {
    match d30_two_i64(n) {
        null => 7
        i64 as v => v
    }
}

/**
 * f_d30_null_arm_fat_payload — 0.3.1.0 degrau 30 over the two FAT payload shapes. A `str` and a
 * `[]i64` payload each occupy the wrapper's (ptr@8, len@16) pair, so the present arm has to bind both
 * halves while the absent arm must not read either. The `.len` and an element read are both asserted:
 * a bind that took only the pointer half answers a garbage length with no diagnostic.
 *
 * @return 0 when both fat payloads read back whole, else the failing check
 */
fn f_d30_null_arm_fat_payload() -> i64 {
    if d30_read_three_str(3) != 3 { return 1 }
    if d30_read_three_str(0) != 7 { return 2 }
    if d30_read_three_str(-1) != 9 { return 3 }
    if d30_read_three_slice(3) != 7 { return 4 }
    if d30_read_three_slice(0) != 7 { return 5 }
    if d30_read_three_slice(-1) != 9 { return 6 }
    if d30_read_three_slice_len(4) != 2 { return 7 }
    0
}

/**
 * d30_read_three_str — the `str`-payload readback: the present arm's own byte count, so a bind that
 * lost the length half cannot pass.
 *
 * @param n  the selector handed to `d30_three_str`
 * @return   the payload's byte length, 7 for absent, 9 for the error
 */
fn d30_read_three_str(n: i64) -> i64 {
    match d30_three_str(n) {
        str as s => s.len to i64
        null => 7
        error => 9
    }
}

/**
 * d30_read_three_slice — the `[]i64`-payload readback: the sum of the two elements, so both the
 * pointer and the length halves have to be right.
 *
 * @param n  the selector handed to `d30_three_slice`
 * @return   the two elements' sum, 7 for absent, 9 for the error
 */
fn d30_read_three_slice(n: i64) -> i64 {
    match d30_three_slice(n) {
        []i64 as xs => xs[0] + xs[1]
        null => 7
        error => 9
    }
}

/**
 * d30_read_three_slice_len — the `[]i64`-payload readback by LENGTH alone, the half a pointer-only
 * bind silently corrupts.
 *
 * @param n  the selector handed to `d30_three_slice`
 * @return   the payload's element count, 0 for absent or the error
 */
fn d30_read_three_slice_len(n: i64) -> i64 {
    match d30_three_slice(n) {
        []i64 as xs => xs.len to i64
        null => 0
        error => 0
    }
}

/**
 * f_d30_null_arm_named_payload — 0.3.1.0 degrau 30 over a NAMED struct payload at arity three, plus
 * the NESTING axis degrau 25 opened: a null union whose payload is a struct, read out of a FIELD that
 * is itself a null union (`D30Nest.deep`). A wrapper that stored the bare struct's own address where
 * the tag belongs reads the struct's FIRST FIELD as the tag and matches no arm at all.
 *
 * @return 0 when every named payload reads back its own field, else the failing check
 */
fn f_d30_null_arm_named_payload() -> i64 {
    if d30_read_three_named(3) != 3 { return 1 }
    if d30_read_three_named(0) != 7 { return 2 }
    if d30_read_three_named(-1) != 9 { return 3 }
    if d30_read_nested(5) != 5 { return 4 }
    if d30_read_nested(0) != 7 { return 5 }
    0
}

/**
 * d30_read_three_named — the named-struct-payload readback at arity three.
 *
 * @param n  the selector handed to `d30_three_named`
 * @return   the payload's `side`, 7 for absent, 9 for the error
 */
fn d30_read_three_named(n: i64) -> i64 {
    match d30_three_named(n) {
        D30Sq as s => s.side
        null => 7
        error => 9
    }
}

/**
 * d30_read_nested — the NESTED shape: a `D30Sq | null` FIELD built from a bare `null` or a bare
 * struct, then matched. Both the field's construction and the field's `null` arm are exercised.
 *
 * @param n  non-zero builds the present case, zero builds absence
 * @return   the payload's `side`, or 7 for absent
 */
fn d30_read_nested(n: i64) -> i64 {
    let nn = D30Nest { deep = if n == 0 { null } else { D30Sq { side = n } } }
    match nn.deep {
        D30Sq as s => s.side
        null => 7
    }
}

/**
 * f_d30_null_placement_field_arg_local — 0.3.1.0 degrau 30 across the PLACEMENTS a bare `null` can
 * reach: a struct FIELD, a call ARGUMENT, a `let` LOCAL and a RETURN. Each routes through
 * `lower_value_into_type` and each used to need its own guard; the degrau-25 finding was that two of
 * them (field and argument) walked past the honest stop into a raw `const 0` the callee then read as
 * a wrapper address.
 *
 * @return 0 when every placement round-trips, else the failing check
 */
fn f_d30_null_placement_field_arg_local() -> i64 {
    if d30_read_field(4) != 4 { return 1 }
    if d30_read_field(0) != 7 { return 2 }
    if d30_read_arg(4) != 4 { return 3 }
    if d30_read_arg(null) != 7 { return 4 }
    if d30_read_local(4) != 4 { return 5 }
    if d30_read_local(0) != 7 { return 6 }
    0
}

/**
 * d30_read_field — the FIELD placement: a `i64 | null` struct field built from a bare `null` or a
 * bare `i64`, then matched.
 *
 * @param n  non-zero builds the present case, zero builds absence
 * @return   the field's payload, or 7 for absent
 */
fn d30_read_field(n: i64) -> i64 {
    let h = D30Holder { inner = if n == 0 { null } else { n } }
    match h.inner {
        i64 as v => v
        null => 7
    }
}

/**
 * d30_read_local — the LOCAL placement: an annotated `let` of null-union type bound from a bare
 * `null` or a bare `i64`, then matched.
 *
 * @param n  non-zero binds the present case, zero binds absence
 * @return   the local's payload, or 7 for absent
 */
fn d30_read_local(n: i64) -> i64 {
    let l: i64 | null = if n == 0 { null } else { n }
    match l {
        i64 as v => v
        null => 7
    }
}

/**
 * f_d30_null_placement_assign — 0.3.1.0 degrau 30 on the ASSIGN placement at arity three: a `mut`
 * local of `i64 | null | error` initialized from a bare `null` and then RE-ASSIGNED a bare `i64` and
 * a bare `error`. The initializer and each assignment build a wrapper independently, so a tag written
 * at one index and read at another shows up here and nowhere else.
 *
 * @return 0 when every assignment lands on its own case, else the failing check
 */
fn f_d30_null_placement_assign() -> i64 {
    if d30_assign_three(6) != 6 { return 1 }
    if d30_assign_three(0) != 7 { return 2 }
    if d30_assign_three(-1) != 9 { return 3 }
    0
}

/**
 * d30_assign_three — the assign placement: absence first, then the payload, then the error, each
 * written into the SAME `mut` slot of a three-member null union.
 *
 * @param n  positive assigns the payload, zero leaves absence, negative assigns the error
 * @return   the payload, 7 for absent, 9 for the error
 */
fn d30_assign_three(n: i64) -> i64 {
    mut l: i64 | null | error = null
    if n != 0 { l = n }
    if n < 0 { l = error { message = "d30 negative" } }
    match l {
        i64 as v => v
        null => 7
        error => 9
    }
}

/**
 * f_d30_null_compare_eq — 0.3.1.0 degrau 30's already-generic sibling, certified rather than changed:
 * `a == null` / `a != null` over a null-bearing union reads the `Null` member's INDEX
 * (`variant_index_of_member_type`), so it was arity-blind before this degrau. Pinned here so a future
 * change to the shared tag machinery cannot break the comparison while the match arms still pass.
 *
 * @return 0 when both operators agree with the match arms, else the failing check
 */
fn f_d30_null_compare_eq() -> i64 {
    if d30_cmp_two(8) != 1 { return 1 }
    if d30_cmp_two(0) != 7 { return 2 }
    if d30_cmp_three(8) != 1 { return 3 }
    if d30_cmp_three(0) != 7 { return 4 }
    0
}

/**
 * d30_cmp_two — `== null` and `!= null` over the arity-two union, both operators on the same value.
 *
 * @param n  non-zero selects the payload, zero selects absence
 * @return   7 when absent, 1 when present, 9 when the two operators disagree
 */
fn d30_cmp_two(n: i64) -> i64 {
    let a: i64 | null = if n == 0 { null } else { n }
    if a == null { return 7 }
    if a != null { return 1 }
    9
}

/**
 * d30_cmp_three — `== null` over the arity-THREE union, the axis the match arm had to be taught.
 *
 * @param n  positive selects the payload, zero selects absence
 * @return   7 when absent, else 1
 */
fn d30_cmp_three(n: i64) -> i64 {
    let a = d30_three_i64(n)
    if a == null { return 7 }
    1
}

/**
 * f_d30_null_union_of_slice — 0.3.1.0 degrau 30 over a union whose payload is a `[]i64` reached
 * through a LOCAL rather than a return, so the fat payload's construction and its `null` arm are
 * measured on the binding path as well as the return path.
 *
 * @return 0 when the buffer reads back whole, else the failing check
 */
fn f_d30_null_union_of_slice() -> i64 {
    if d30_local_slice(3) != 6 { return 1 }
    if d30_local_slice(0) != 7 { return 2 }
    if d30_local_slice_len(3) != 2 { return 3 }
    if d30_local_slice_len(0) != 0 { return 4 }
    0
}

/**
 * d30_local_slice — a `[]i64 | null` LOCAL bound from a bare buffer or a bare `null`, read back by
 * element sum.
 *
 * @param n  non-zero binds the buffer, zero binds absence
 * @return   the two elements' sum, or 7 for absent
 */
fn d30_local_slice(n: i64) -> i64 {
    let xs: []i64 | null = if n == 0 { null } else { [n, n] }
    match xs {
        []i64 as v => v[0] + v[1]
        null => 7
    }
}

/**
 * d30_local_slice_len — the same local read back by LENGTH, the half a pointer-only bind corrupts.
 *
 * @param n  non-zero binds the buffer, zero binds absence
 * @return   the buffer's element count, or 0 for absent
 */
fn d30_local_slice_len(n: i64) -> i64 {
    let xs: []i64 | null = if n == 0 { null } else { [n, n] }
    match xs {
        []i64 as v => v.len to i64
        null => 0
    }
}

/**
 * f_d30_null_arm_exhaustive_selection — 0.3.1.0 degrau 30 by INVERSION: instead of asking each arm
 * for its own answer, walk every selector once and COUNT how many times each arm fired. A lowering
 * whose `null` arm tested a tag nothing ever stores would leave the absent count at zero; one whose
 * `null` arm matched every tag would drive it to three. Only a correct pairing of writer and reader
 * gives one of each.
 *
 * @return 0 when each arm fires exactly once over the three selectors, else the failing check
 */
fn f_d30_null_arm_exhaustive_selection() -> i64 {
    mut present = 0
    mut absent = 0
    mut failed = 0
    mut i = -1
    loop {
        if i > 1 { break }
        match d30_three_i64(i) {
            i64 => present++
            null => absent++
            error => failed++
        }
        i++
    }
    if present != 1 { return 1 }
    if absent != 1 { return 2 }
    if failed != 1 { return 3 }
    if present + absent + failed != 3 { return 4 }
    0
}

/**
 * f_d30_null_arm_wrong_arm_guard — 0.3.1.0 degrau 30's negative half: for EVERY selector, the two
 * arms that must NOT fire are asserted not to have fired, by reading a value only the correct arm can
 * produce. This is what separates "the `null` arm compiles" from "the `null` arm selects absence" —
 * the distinction three silent wrong values in this lane were caught by.
 *
 * @return 0 when no arm answers another arm's case, else the failing check
 */
fn f_d30_null_arm_wrong_arm_guard() -> i64 {
    if d30_arm_tag(2) != 1 { return 1 }
    if d30_arm_tag(0) != 2 { return 2 }
    if d30_arm_tag(-2) != 3 { return 3 }
    if d30_arm_tag(2) == d30_arm_tag(0) { return 4 }
    if d30_arm_tag(0) == d30_arm_tag(-2) { return 5 }
    if d30_arm_tag(2) == d30_arm_tag(-2) { return 6 }
    0
}

/**
 * d30_arm_tag — which ARM fired, as a number independent of the payload's own value: 1 present,
 * 2 absent, 3 error. Reading the arm identity rather than the payload is what makes the wrong-arm
 * guard above unable to pass by coincidence.
 *
 * @param n  the selector handed to `d30_three_i64`
 * @return   1 for the payload arm, 2 for the `null` arm, 3 for the error arm
 */
fn d30_arm_tag(n: i64) -> i64 {
    match d30_three_i64(n) {
        i64 => 1
        null => 2
        error => 3
    }
}

/**
 * D29_TENTH_F64 — `0.1` at binary64, the value that is NOT exactly representable in
 * either width and whose text therefore NAMES the width the register was read at
 * (0.3.1.0 degrau 29). Its `f32` sibling `D29_TENTH_F32` holds the same decimal at
 * single precision and renders differently, which is the whole probe.
 */
const D29_TENTH_F64: f64 = 0.1

/**
 * D29_TENTH_F32 — `0.1` at binary32, the single-precision half of the matched pair.
 */
const D29_TENTH_F32: f32 = 0.1

/**
 * D29_HALVES_F64 — `2.5` at binary64: exactly representable in BOTH widths, so it is
 * the CONTROL against `D29_TENTH_F64`. A route that computes with `2.5` correctly and
 * with `0.1` wrongly is reading the register at the wrong width, not mis-rounding.
 */
const D29_HALVES_F64: f64 = 2.5

/**
 * D29_HALVES_F32 — `2.5` at binary32, the control's single-precision half.
 */
const D29_HALVES_F32: f32 = 2.5

/**
 * d29_f64_runtime — one of four RUNTIME `f64` values selected by `tag`, so the value
 * reaching an arithmetic instruction is a value in a REGISTER and not a literal the
 * front end could fold into the result. Degrau 27 measured that literals and runtime
 * values travel different roads (a `LConstFloat` bit pattern versus a spelled C
 * constant), so every arithmetic assertion below is made twice — once over these and
 * once over the `D29_*` consts.
 *
 * @param tag  which value: 0 -> `0.1`, 1 -> `2.5`, 2 -> `-7.25`, anything else -> `0.0`
 * @return     the selected value
 */
fn d29_f64_runtime(tag: i64) -> f64 {
    mut tenth: f64 = 0.1
    mut halves: f64 = 2.5
    mut neg: f64 = -7.25
    mut zero: f64 = 0.0
    if tag == 0 { return tenth }
    if tag == 1 { return halves }
    if tag == 2 { return neg }
    zero
}

/**
 * d29_f32_runtime — the single-precision twin of `d29_f64_runtime`, the same four
 * decimals held as `f32`. Kept as its own function rather than a narrowing of the
 * other so the value is born single and never passes through a double register.
 *
 * @param tag  which value: 0 -> `0.1`, 1 -> `2.5`, 2 -> `-7.25`, anything else -> `0.0`
 * @return     the selected value
 */
fn d29_f32_runtime(tag: i64) -> f32 {
    mut tenth: f32 = 0.1
    mut halves: f32 = 2.5
    mut neg: f32 = -7.25
    mut zero: f32 = 0.0
    if tag == 0 { return tenth }
    if tag == 1 { return halves }
    if tag == 2 { return neg }
    zero
}

/**
 * f_d29_f64_arith_values — 0.3.1.0 degrau 29: the `f64` arithmetic the arm64 encoder
 * refused outright until this degrau (`A4-fp: float-op / FPR encoding deferred`), now
 * asserted by VALUE rather than by "it compiled".
 *
 * Every expected text is the one the C ROUTE prints for this same program, measured
 * before the assertion was written. `+`, `-` and `/` over `0.1` are the load-bearing
 * ones: their results have seventeen significant digits, so a single bit read at the
 * wrong width or a mnemonic swapped for its sibling changes the text. `*` gives the
 * exactly-representable `0.25`, which is the control — a route that gets only the
 * control right is not computing, it is guessing.
 *
 * `%` is NOT covered because the surface does not admit it: `a % b` over floats is
 * rejected by the checker (`bitwise/remainder needs an integer (not a float — B.38)`),
 * measured on this compiler.
 *
 * @return 0 when every result matches the C route's text, else the failing check's number
 */
fn f_d29_f64_arith_values() -> i64 {
    let a = d29_f64_runtime(0)
    let b = d29_f64_runtime(1)
    if teko::ftoa(a + b) != "2.6000000000000001" { return 1 }
    if teko::ftoa(a - b) != "-2.3999999999999999" { return 2 }
    if teko::ftoa(a * b) != "0.25" { return 3 }
    if teko::ftoa(a / b) != "0.040000000000000001" { return 4 }
    if teko::ftoa(a + a + a) != "0.30000000000000004" { return 5 }
    if teko::ftoa(D29_TENTH_F64 + D29_HALVES_F64) != "2.6000000000000001" { return 6 }
    if teko::ftoa(D29_TENTH_F64 - D29_HALVES_F64) != "-2.3999999999999999" { return 7 }
    if teko::ftoa(D29_TENTH_F64 * D29_HALVES_F64) != "0.25" { return 8 }
    if teko::ftoa(D29_TENTH_F64 / D29_HALVES_F64) != "0.040000000000000001" { return 9 }
    let neg = d29_f64_runtime(2)
    if teko::ftoa(neg + b) != "-4.75" { return 10 }
    if teko::ftoa(neg * b) != "-18.125" { return 11 }
    0
}

/**
 * f_d29_f32_arith_values — the SAME five operations at binary32, and this is the twin
 * that catches a register read at the wrong width. `0.1f + 2.5f` is
 * `2.5999999046325684` while `0.1 + 2.5` at binary64 is `2.6000000000000001`: a
 * backend that computed the single-precision program in `D` registers would produce
 * the f64 text here and still "compile". `0.1f * 2.5f` is `0.25` in BOTH widths, so
 * the pair `*`/`+` separates a width bug from an arithmetic bug.
 *
 * The last two checks are the two conversion directions the width flags decide:
 * widening a single to double must give the single's exact value
 * (`0.10000000149011612`), and narrowing the double `0.1` must give that SAME value —
 * which is the proof that the `f32` literal road (`FMOV` + `FCVT Sd, Dn`) and the
 * runtime `f32` road end at the same number.
 *
 * @return 0 when every result matches the C route's text, else the failing check's number
 */
fn f_d29_f32_arith_values() -> i64 {
    let a = d29_f32_runtime(0)
    let b = d29_f32_runtime(1)
    if teko::ftoa(a + b) != "2.5999999046325684" { return 1 }
    if teko::ftoa(a - b) != "-2.4000000953674316" { return 2 }
    if teko::ftoa(a * b) != "0.25" { return 3 }
    if teko::ftoa(a / b) != "0.039999999105930328" { return 4 }
    if teko::ftoa(a + a + a) != "0.30000001192092896" { return 5 }
    if teko::ftoa(D29_TENTH_F32 + D29_HALVES_F32) != "2.5999999046325684" { return 6 }
    if teko::ftoa(D29_TENTH_F32 - D29_HALVES_F32) != "-2.4000000953674316" { return 7 }
    if teko::ftoa(D29_TENTH_F32 * D29_HALVES_F32) != "0.25" { return 8 }
    if teko::ftoa(D29_TENTH_F32 / D29_HALVES_F32) != "0.039999999105930328" { return 9 }
    if teko::ftoa(a to f64) != "0.10000000149011612" { return 10 }
    if teko::ftoa((D29_TENTH_F64 to f32) to f64) != "0.10000000149011612" { return 11 }
    let neg = d29_f32_runtime(2)
    if teko::ftoa(neg + b) != "-4.75" { return 12 }
    if teko::ftoa(neg * b) != "-18.125" { return 13 }
    0
}

/**
 * f_d29_float_compare_ordered — 0.3.1.0 degrau 29: the six float comparisons at BOTH
 * widths, over ORDERED operands. On AArch64 these are one `FCMP` plus a condition
 * code, and the condition is not the integer one: `<` tests `lo` (C clear) and `<=`
 * tests `ls`, because the signed `lt`/`le` read TRUE on an `FCMP`'s unordered result.
 * These rows pin the ordered half; `f_d29_float_compare_unordered` pins the half that
 * distinguishes the two choices.
 *
 * `+0.0 == -0.0` is here on purpose: IEEE says the two zeros compare EQUAL even though
 * their bit patterns differ, so a comparison lowered as a bit test rather than an
 * `FCMP` fails exactly here.
 *
 * @return 0 when every comparison agrees with IEEE, else the failing check's number
 */
fn f_d29_float_compare_ordered() -> i64 {
    let a = d29_f64_runtime(0)
    let b = d29_f64_runtime(1)
    if !(a < b) { return 1 }
    if !(a <= b) { return 2 }
    if a > b { return 3 }
    if a >= b { return 4 }
    if a == b { return 5 }
    if !(a != b) { return 6 }
    if !(b <= b) { return 7 }
    if !(b >= b) { return 8 }
    if !(b == b) { return 9 }
    let c = d29_f32_runtime(0)
    let d = d29_f32_runtime(1)
    if !(c < d) { return 10 }
    if !(c <= d) { return 11 }
    if c > d { return 12 }
    if c >= d { return 13 }
    if c == d { return 14 }
    if !(c != d) { return 15 }
    let neg = d29_f64_runtime(2)
    if !(neg < a) { return 16 }
    if !(a > neg) { return 17 }
    let zero = d29_f64_runtime(3)
    let minus_zero = d29_f64_runtime(2) * zero
    if !(zero == minus_zero) { return 18 }
    if !(zero <= minus_zero) { return 19 }
    if !(zero >= minus_zero) { return 20 }
    if zero < minus_zero { return 21 }
    0
}

/**
 * f_d29_float_compare_unordered — the NaN half of the comparison family, and the reason
 * the arm64 selection may not reuse the integer conditions. An `FCMP` whose operand is
 * a NaN sets `N=0 Z=0 C=1 V=1`; the signed `lt` (`N!=V`) and `le` (`Z==1 || N!=V`) both
 * read TRUE on that, so `nan < x` would be true. `lo` (`C==0`) and `ls`
 * (`C==0 || Z==1`) read FALSE, which is what IEEE requires.
 *
 * All four relational comparisons must be FALSE against a NaN, `==` must be false
 * (including against itself) and `!=` must be TRUE. The NaN is produced by runtime
 * arithmetic (`inf - inf`) so no folder can spell it, and the surface admits it —
 * `f_ftoa_nonfinite_text` already renders one. It is NOT produced by dividing by zero:
 * `x / 0.0` traps on this surface (`teko: deliberate panic: division by zero`, measured
 * on this compiler), so the overflowing multiplication is the only spelling available.
 *
 * @return 0 when every NaN comparison follows IEEE, else the failing check's number
 */
fn f_d29_float_compare_unordered() -> i64 {
    let nan = d29_nan()
    let b = d29_f64_runtime(1)
    if nan < b { return 1 }
    if nan <= b { return 2 }
    if nan > b { return 3 }
    if nan >= b { return 4 }
    if b < nan { return 5 }
    if b <= nan { return 6 }
    if b > nan { return 7 }
    if b >= nan { return 8 }
    if nan == nan { return 9 }
    if !(nan != nan) { return 10 }
    if nan == b { return 11 }
    if !(nan != b) { return 12 }
    let nan32 = nan to f32
    let d = d29_f32_runtime(1)
    if nan32 < d { return 13 }
    if nan32 <= d { return 14 }
    if nan32 > d { return 15 }
    if nan32 >= d { return 16 }
    if nan32 == nan32 { return 17 }
    if !(nan32 != nan32) { return 18 }
    0
}

/**
 * d29_positive_infinity — a POSITIVE infinity produced at RUNTIME by overflowing
 * binary64 multiplication, so no folder can have spelled it. Division by zero is not an
 * alternative: `x / 0.0` traps on this surface.
 *
 * @return `+inf`
 */
fn d29_positive_infinity() -> f64 {
    mut huge: f64 = 1.0e308
    mut ten: f64 = 10.0
    huge * ten
}

/**
 * d29_nan — a NaN produced at RUNTIME by `inf - inf`, the infinity itself produced by
 * an overflowing binary64 multiplication so that no constant folder can have spelled
 * either one (the same construction `d27_infinity` uses).
 *
 * @return a NaN
 */
fn d29_nan() -> f64 {
    let pinf = d29_positive_infinity()
    pinf - pinf
}

/**
 * f_d29_int_float_casts — 0.3.1.0 degrau 29: `int -> float` and `float -> int` in both
 * directions at both widths, the family whose AArch64 words carry TWO independent width
 * fields (`sf` for the integer end, `type` for the float end). A single-width
 * conversion instruction cannot express three of the four combinations, which is why
 * `MCvt` gained `src_wide`/`dst_wide` in this degrau.
 *
 * The load-bearing row is `16777217 to f32`: binary32 has 24 significand bits, so the
 * value rounds to `16777216` while the same integer converted to `f64` is exact. A
 * conversion that produced a double where a single was asked for renders `16777217`
 * here and passes every other check in this function.
 *
 * `float -> int` truncates toward zero in both directions of sign (`-7.25 -> -7`, not
 * `-8`), which is what `FCVTZS` means and what the C route does.
 *
 * @return 0 when every conversion matches the C route, else the failing check's number
 */
fn f_d29_int_float_casts() -> i64 {
    if d29_f64_runtime(2) to i64 != -7 { return 1 }
    if d29_f64_runtime(1) to i64 != 2 { return 2 }
    if d29_f64_runtime(0) to i64 != 0 { return 3 }
    if d29_f32_runtime(2) to i64 != -7 { return 4 }
    if d29_f32_runtime(1) to i64 != 2 { return 5 }
    if d29_f32_runtime(0) to i64 != 0 { return 6 }
    mut n: i64 = -9
    if teko::ftoa(n to f64) != "-9" { return 7 }
    if teko::ftoa((n to f32) to f64) != "-9" { return 8 }
    mut big: i64 = 16777217
    if teko::ftoa(big to f64) != "16777217" { return 9 }
    if teko::ftoa((big to f32) to f64) != "16777216" { return 10 }
    if (big to f64) to i64 != 16777217 { return 11 }
    if (big to f32) to i64 != 16777216 { return 12 }
    mut small: i64 = 3
    if teko::ftoa(small to f64) != "3" { return 13 }
    if teko::ftoa((small to f32) to f64) != "3" { return 14 }
    0
}

/**
 * f_d29_float_negate_signed_zero — 0.3.1.0 degrau 29: unary float negate at both
 * widths, and the value that catches every implementation that spells it `0.0 - x`.
 * AArch64 has a REAL `FNEG` (unlike the x86 twin, which flips the sign bit through a
 * GPR), and it is the true IEEE negate: `-(+0.0)` is `-0.0`, whose `%.17g` text is
 * `-0`, while `0.0 - 0.0` is `+0.0` and renders `0`. Degrau 27 measured this exact
 * sign loss on the literal road, so both spellings are asserted side by side.
 *
 * @return 0 when every negation keeps its sign, else the failing check's number
 */
fn f_d29_float_negate_signed_zero() -> i64 {
    let zero = d29_f64_runtime(3)
    let minus_one = d29_f64_runtime(2)
    if teko::ftoa(-zero) != "-0" { return 1 }
    if teko::ftoa(zero - zero) != "0" { return 2 }
    if teko::ftoa(minus_one * zero) != "-0" { return 3 }
    if teko::ftoa(- -zero) != "0" { return 4 }
    let halves = d29_f64_runtime(1)
    if teko::ftoa(-halves) != "-2.5" { return 5 }
    if teko::ftoa(- -halves) != "2.5" { return 6 }
    let tenth = d29_f64_runtime(0)
    if teko::ftoa(-tenth) != "-0.10000000000000001" { return 7 }
    let zero32 = d29_f32_runtime(3)
    if teko::ftoa(-zero32) != "-0" { return 8 }
    let halves32 = d29_f32_runtime(1)
    if teko::ftoa(-halves32) != "-2.5" { return 9 }
    let tenth32 = d29_f32_runtime(0)
    if teko::ftoa(-tenth32) != "-0.10000000149011612" { return 10 }
    let nan = d29_nan()
    let pinf = d29_positive_infinity()
    if teko::ftoa(pinf) != "inf" { return 11 }
    if teko::ftoa(-pinf) != "-inf" { return 12 }
    if nan == nan { return 13 }
    0
}

/**
 * d29_fp_sum8 — eight `f64` parameters summed, so a call site must fill the WHOLE
 * AAPCS64 float argument window (`v0`..`v7`) and the callee must read all eight back
 * out of it. An argument classified into the wrong register file, or a class index
 * counted against the integer window, lands a wrong number here rather than failing to
 * build.
 *
 * @param p0  the first float argument (v0)
 * @param p1  the second float argument (v1)
 * @param p2  the third float argument (v2)
 * @param p3  the fourth float argument (v3)
 * @param p4  the fifth float argument (v4)
 * @param p5  the sixth float argument (v5)
 * @param p6  the seventh float argument (v6)
 * @param p7  the eighth float argument (v7)
 * @return    the sum of all eight
 */
fn d29_fp_sum8(p0: f64, p1: f64, p2: f64, p3: f64, p4: f64, p5: f64, p6: f64, p7: f64) -> f64 {
    p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7
}

/**
 * d29_mixed_abi — four integer and four float parameters INTERLEAVED, because AAPCS64
 * classifies the two files INDEPENDENTLY: the integers fill `x0`..`x3` and the floats
 * fill `v0`..`v3` regardless of their positions in the signature. A backend that
 * counted one shared index would read a float out of an integer register.
 *
 * @param i0  the first integer argument (x0)
 * @param f0  the first float argument (v0)
 * @param i1  the second integer argument (x1)
 * @param f1  the second float argument (v1)
 * @param i2  the third integer argument (x2)
 * @param f2  the third float argument (v2)
 * @param i3  the fourth integer argument (x3)
 * @param f3  the fourth float argument (v3)
 * @return    the integer part of `i0*1000 + i1*100 + i2*10 + i3` plus the truncated float sum
 */
fn d29_mixed_abi(i0: i64, f0: f64, i1: i64, f1: f64, i2: i64, f2: f64, i3: i64, f3: f64) -> i64 {
    let ints = i0 * 1000 + i1 * 100 + i2 * 10 + i3
    let floats = f0 + f1 + f2 + f3
    ints + (floats to i64)
}

/**
 * d29_f32_sum4 — four `f32` parameters summed, the SINGLE-precision half of the
 * argument-window twin: the same `v0`..`v3` registers carry `s` views instead of `d`
 * ones, and the sum must be computed at single precision.
 *
 * @param p0  the first float argument (s0)
 * @param p1  the second float argument (s1)
 * @param p2  the third float argument (s2)
 * @param p3  the fourth float argument (s3)
 * @return    the single-precision sum
 */
fn d29_f32_sum4(p0: f32, p1: f32, p2: f32, p3: f32) -> f32 {
    p0 + p1 + p2 + p3
}

/**
 * f_d29_float_registers_and_return — 0.3.1.0 degrau 29: floats crossing a CALL in
 * floating-point registers, in and out. The AAPCS64 rule under test is that the two
 * register files are classified independently (`v0`..`v7` for floats, `x0`..`x7` for
 * integers) and that the result comes back in `d0`/`s0` rather than `x0`.
 *
 * The eight-argument row fills the float window exactly; the mixed row interleaves the
 * two files; the `f32` row repeats the exercise at single precision, where the sum's
 * text differs from the `f64` sum of the same decimals — which is what proves the
 * arguments travelled as singles and not as doubles.
 *
 * @return 0 when every call returns the C route's value, else the failing check's number
 */
fn f_d29_float_registers_and_return() -> i64 {
    let t = d29_f64_runtime(0)
    let h = d29_f64_runtime(1)
    if teko::ftoa(d29_fp_sum8(t, t, t, t, t, t, t, t)) != "0.79999999999999993" { return 1 }
    if teko::ftoa(d29_fp_sum8(h, h, h, h, h, h, h, h)) != "20" { return 2 }
    if teko::ftoa(d29_fp_sum8(t, h, t, h, t, h, t, h)) != "10.399999999999999" { return 3 }
    if d29_mixed_abi(1, h, 2, h, 3, h, 4, h) != 1244 { return 4 }
    if d29_mixed_abi(9, t, 8, t, 7, t, 6, t) != 9876 { return 5 }
    let t32 = d29_f32_runtime(0)
    let h32 = d29_f32_runtime(1)
    if teko::ftoa(d29_f32_sum4(t32, t32, t32, t32) to f64) != "0.40000000596046448" { return 6 }
    if teko::ftoa(d29_f32_sum4(h32, h32, h32, h32) to f64) != "10" { return 7 }
    if teko::ftoa(d29_f32_sum4(t32, h32, t32, h32) to f64) != "5.1999998092651367" { return 8 }
    0
}

/**
 * d29_scale — a one-argument float function whose only purpose is to BE a call, so a
 * caller holding many live floats across it must park them where a call cannot clobber
 * them (`v8`..`v15`, callee-saved) or spill them to the frame.
 *
 * @param x  the value to scale
 * @return   `x * 2.0`
 */
fn d29_scale(x: f64) -> f64 {
    mut two: f64 = 2.0
    x * two
}

/**
 * f_d29_float_spill_across_call — 0.3.1.0 degrau 29: MORE live floats across a call
 * than the ABI has callee-saved float registers, which is the case the arm64 allocator
 * used to refuse outright (`regalloc: FPR-value spill not yet supported`). AAPCS64
 * preserves only the low halves of `v8`..`v15` across a call, so sixteen values live
 * over one forces the allocator past that window and into the frame.
 *
 * A spilled float now travels through one `MFSpill` (`STR/LDR Dt, [sp, #off]`), and the
 * assertion is the VALUE: a spill that stored the double but reloaded a single, or that
 * addressed the wrong slot, changes the sum. The final sum is asserted at seventeen
 * digits precisely so a lost low bit cannot hide.
 *
 * @return 0 when the sum survives the spills, else 1
 */
fn f_d29_float_spill_across_call() -> i64 {
    let a = d29_f64_runtime(0)
    let b = d29_f64_runtime(1)
    let v00 = a + b
    let v01 = a - b
    let v02 = a * b
    let v03 = a / b
    let v04 = v00 + a
    let v05 = v01 + a
    let v06 = v02 + a
    let v07 = v03 + a
    let v08 = v00 * b
    let v09 = v01 * b
    let v10 = v02 * b
    let v11 = v03 * b
    let v12 = v04 - b
    let v13 = v05 - b
    let v14 = v06 - b
    let v15 = v07 - b
    let scaled = d29_scale(a)
    let left = v00 + v01 + v02 + v03 + v04 + v05 + v06 + v07
    let right = v08 + v09 + v10 + v11 + v12 + v13 + v14 + v15
    if teko::ftoa(left + right + scaled) != "-6.3049999999999988" { return 1 }
    0
}

/**
 * D29Widths — a struct holding one value of EACH float width side by side, so a field
 * read/write goes through the `S` and `D` memory forms (`LDR/STR St` and `Dt`) rather
 * than through registers only. The two fields are adjacent on purpose: a store that
 * used the wrong width would overwrite its neighbour, and the sibling read catches it.
 */
type D29Widths = struct {
    /**
     * narrow — the binary32 field, transferred by `LDR/STR St` (scale 4).
     */
    narrow: f32
    /**
     * wide — the binary64 field, transferred by `LDR/STR Dt` (scale 8). NOT spelled
     * `double`: the C route emits a struct field's Teko name VERBATIM, so a field named
     * after a C keyword produces `double double;` and the generated C does not compile
     * (measured on this compiler, 0.3.1.0 degrau 29).
     */
    wide: f64
}

/**
 * f_d29_float_memory_widths — 0.3.1.0 degrau 29: floats crossing MEMORY at both
 * widths. The `S`/`D` load and store forms were the other half of the `A4-fp` stop
 * (`load_form`/`store_form` raised it for exactly those two widths), and their
 * immediate is SCALED BY THE ACCESS SIZE — 4 for a single, 8 for a double — so a form
 * that reused the other width's scale addresses the wrong byte.
 *
 * Struct fields cover the adjacent-neighbour case; the two slices cover the strided
 * one, where an element read at the wrong width lands halfway into its neighbour.
 *
 * @return 0 when every value survives its round trip through memory, else the failing check's number
 */
fn f_d29_float_memory_widths() -> i64 {
    mut w = D29Widths { narrow = d29_f32_runtime(0); wide = d29_f64_runtime(0) }
    if teko::ftoa(w.narrow to f64) != "0.10000000149011612" { return 1 }
    if teko::ftoa(w.wide) != "0.10000000000000001" { return 2 }
    w.narrow = d29_f32_runtime(1)
    if teko::ftoa(w.narrow to f64) != "2.5" { return 3 }
    if teko::ftoa(w.wide) != "0.10000000000000001" { return 4 }
    w.wide = d29_f64_runtime(2)
    if teko::ftoa(w.wide) != "-7.25" { return 5 }
    if teko::ftoa(w.narrow to f64) != "2.5" { return 6 }
    mut ds: []f64 = [1.0, 2.0, 3.0]
    ds[1] = d29_f64_runtime(0)
    if teko::ftoa(ds[0]) != "1" { return 7 }
    if teko::ftoa(ds[1]) != "0.10000000000000001" { return 8 }
    if teko::ftoa(ds[2]) != "3" { return 9 }
    mut ss: []f32 = [1.0, 2.0, 3.0]
    ss[2] = d29_f32_runtime(0)
    if teko::ftoa(ss[0] to f64) != "1" { return 10 }
    if teko::ftoa(ss[1] to f64) != "2" { return 11 }
    if teko::ftoa(ss[2] to f64) != "0.10000000149011612" { return 12 }
    if teko::ftoa(ds[1] + ss[2] to f64) != "0.20000000149011612" { return 13 }
    0
}

/**
 * GvfFn — the first case of the `GvfDecl` variant: a struct payload WIDER than a variant wrapper's
 * inline area, so a slot holding it is held BY ADDRESS. Its own first field is a `str`, whose
 * pointer word is exactly what a mis-wrapped variant read reports as a (garbage) tag.
 */
type GvfFn = struct {
    /** an identifying name, wide enough to make the payload by-address. */
    name: str
    /** a payload word. */
    a: i64
}

/**
 * GvfTy — the second `GvfDecl` case, structurally distinct from `GvfFn` so a `match` that read the
 * wrong tag would answer the wrong arm.
 */
type GvfTy = struct {
    /** an identifying name. */
    name: str
    /** a payload word. */
    b: i64
}

/**
 * GvfCo — the third `GvfDecl` case, completing a three-arm exhaustive `match`.
 */
type GvfCo = struct {
    /** an identifying name. */
    name: str
    /** a payload word. */
    c: i64
}

/**
 * GvfDecl — a declared variant whose cases are aggregates held BY ADDRESS
 * (`NATIVE-AGG-SLICE-BY-ADDRESS`): a slot holding a `GvfDecl` carries the address of a `{tag,
 * payload}` wrapper, and a `match` reads the tag through that address.
 */
type GvfDecl = variant GvfFn | GvfTy | GvfCo

/**
 * GvfParsed — a GENERIC container whose payload field `node` is a type PARAMETER. Instantiated at
 * `GvfDecl` (a variant), the stamped instance `GvfParsed__g__GvfDecl` loses the field's declaring
 * namespace, so the native backend's field-type resolution used to answer "no declared type" and
 * store `node` UNWRAPPED — the exact `parser::Parsed<parser::Decl>` shape the self-host parser
 * builds, whose corrupted tag drove `build::assemble_sel` into the dead exhaustiveness edge.
 */
type GvfParsed<T> = struct {
    /** the parsed node — a type-parameter field, a variant at this instantiation. */
    node: T
    /** a resume cursor, the non-variant field proving the struct itself is well-formed. */
    next: u64
}

/**
 * gvf_case_digit — build a `GvfParsed<GvfDecl>` whose `node` is the `GvfDecl` case selected by `k`,
 * then read `node` back and fold the case to its digit — ALL IN ONE FRAME, so the placement this
 * probes is the WRAPPER-building itself (`store_struct_field`'s union arm). Without the fix the
 * generic instance field `node` was stored UNWRAPPED — a pointer to the bare case payload — so
 * `match node` read the payload's first word (a `str`'s ptr, a garbage tag), took no arm and fell to
 * the dead exhaustiveness edge; the digit it must fold is `k` itself.
 *
 * @param k  1 for `GvfFn`, 2 for `GvfTy`, anything else for `GvfCo`
 * @return   `1`/`2`/`3` — the digit of the case `k` selects, read back through the generic field
 */
fn gvf_case_digit(k: i64) -> i64 {
    mut p = GvfParsed<GvfDecl> { node = GvfCo { name = "co"; c = 3 }; next = 3 }
    if k == 1 { p = GvfParsed<GvfDecl> { node = GvfFn { name = "fn"; a = 1 }; next = 1 } }
    if k == 2 { p = GvfParsed<GvfDecl> { node = GvfTy { name = "ty"; b = 2 }; next = 2 } }
    match p.node {
        GvfFn as f => 1
        GvfTy as t => 2
        GvfCo as c => 3
    }
}

/**
 * f_generic_variant_field — folds one digit per `GvfDecl` case (`gvf_case_digit`) into a base-10
 * accumulator. A native backend that stored the generic instance field `node` unwrapped reads a
 * garbage tag, takes no arm and crashes on the dead edge; the correct answer is `1`, `2`, `3`.
 *
 * @return 123 — `GvfFn`→1, `GvfTy`→2, `GvfCo`→3, in construction order
 */
fn f_generic_variant_field() -> i64 {
    mut acc: i64 = 0
    mut k: i64 = 1
    loop {
        if k > 3 { break }
        acc = acc * 10 + gvf_case_digit(k)
        k = k + 1
    }
    acc
}

/**
 * f_native_union_scalar — the native lowering of a numeric null-union reached through the const
 * inliner's widen (folded from the retired `native_union_known_stop` project, CLOSED by
 * cargo/0.3.1.0-null-adopt). It is a MEMBER of this channel now that it lowers: one build, no extra
 * cost, asserting the value the C route always produced.
 *
 * @return the scalar null-union sum (42)
 */
fn f_native_union_scalar() -> i64 {
    nunion::probe() to i64
}

/**
 * f_native_union_nested — the native lowering of a null-union struct nested inside another
 * null-union field (folded from the retired `native_union_nested_known_stop` project, CLOSED by
 * 0.3.1.0 degrau 25). A wrapper written at either nesting level with the wrong tag shows up as a
 * wrong SUM, not a stop.
 *
 * @return the two-level nested null-union sum (42)
 */
fn f_native_union_nested() -> i64 {
    nunion_nested::probe() to i64
}

/**
 * f_one_byte_score — the native lowering of `teko::one_byte(byte) -> str` across six disjoint call
 * shapes (folded from the retired `one_byte_native` project). The weights (3, 12, 16, 32, 64, 128)
 * sum to 255 and no partial sum reaches it, so a call shape that misses names itself in the score;
 * the C-route oracle for the same 255 rides as `cases/one_byte_c.tks`.
 *
 * @return 255 when all six `one_byte` call shapes read back their own byte and length
 */
fn f_one_byte_score() -> i64 {
    ob::score()
}

/**
 * f_null_birth_null_type — retire-Optional O1 (`typer.tks:type_nulllit`,
 * `docs/design/retirar-optional-para-null-union-uptr-0.3.1.md` §2.1): a bare `null` literal's
 * `.type` is now the concrete `Null{}`, not the retired `Optional{inner=Void}` sentinel. Emission
 * is DESTINATION-driven (§2.2: `from_is_bare_null`/`null_widens_into` already treat both
 * representations identically), so the flip must be behavior-invisible at every slot a bare `null`
 * reaches — this pins the birth type itself across the slot classes the pre-existing corpus
 * already exercises piecemeal (`f_null_union_reassign_to_null`'s REASSIGNMENT,
 * `f_d30_null_placement_field_arg_local`'s FIELD/ARGUMENT/RETURN, `f_null_union_struct_present_and_absent`'s
 * struct-typed union member) in ONE place named after the crumb that changed the birth type, so a
 * regression here points straight at `type_nulllit` rather than a name that predates it.
 *
 * @return 0 on success, a distinct non-zero code per failing slot class
 */
fn f_null_birth_null_type() -> i64 {
    // slot class: a `mut` union-member local, bound present then reassigned to a bare `null`
    mut reassigned: i64 | null = 5
    reassigned = null
    let r = match reassigned { i64 => 1; null => 0 }
    if r != 0 { return 1 }

    // slot class: a standalone annotated `let`, bound directly to a bare `null`
    let bound: i64 | null = null
    let b = match bound { i64 => 1; null => 0 }
    if b != 0 { return 2 }

    // slot class: a bare `null` ARGUMENT into a struct-typed null-union parameter, and its RETURN
    let absent: Point_iface | null = null
    if sum_or(absent, 12) != 12 { return 3 }
    if sum_or(null, 7) != 7 { return 4 }
    0
}

/**
 * f_null_narrow_match — retire-Optional O1: `match x { null => …; T as t => … }` over a union
 * whose member list used to be reached only through the `Optional`-sugar path (`T?`, now retired —
 * `docs/design/retirar-optional-para-null-union-uptr-0.3.1.md` §2/§7 R-6) still exhausts (every arm
 * reachable, no missing-case diagnostic) and BINDS (the `T as t` arm's payload reads back
 * correctly) now that a bare `null` is born `Null{}` instead of the sentinel. The fuller arity/order
 * matrix lives in the 0.3.1.0 degrau-30 family (`f_d30_null_arm_three_member`,
 * `f_d30_null_arm_orders`, `f_d30_null_arm_exhaustive_selection`); this is the O1-named anchor.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_null_narrow_match() -> i64 {
    let present: i64 | null = 9
    let bound = match present { i64 as v => v; null => -1 }
    if bound != 9 { return 1 }
    let absent: i64 | null = null
    let missing = match absent { i64 as v => v; null => -1 }
    if missing != -1 { return 2 }
    // arm order reversed: the `null` arm first must still bind the concrete case second
    let reordered = match present { null => -1; i64 as v => v }
    if reordered != 9 { return 3 }
    0
}

/**
 * f_null_narrow_ifguard — retire-Optional O4 (`docs/design/retirar-optional-para-null-union-uptr-0.3.1.md`
 * §6): a `when`-GUARDED match arm combined with `T | null` union narrowing over a migrated union
 * still narrows and exhausts correctly now that `check_pattern`/`exhaustive`'s Optional-specific
 * arms are deleted (`src/checker/match.tks`) and route purely through the generic `Null`-member
 * Variant machinery. A guarded arm does NOT count for exhaustiveness (M.1) — the null arm plus an
 * UNGUARDED present arm still cover the union on their own, so the guard's pass/fail is purely a
 * runtime fallthrough concern, never a compile-time coverage one.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_null_narrow_ifguard() -> i64 {
    let big: i64 | null = 9
    let a = match big {
        i64 as v when v > 5 => v * 2
        i64 as v => v
        null => -1
    }
    if a != 18 { return 1 }
    let small: i64 | null = 3
    let b = match small {
        i64 as v when v > 5 => v * 2
        i64 as v => v
        null => -1
    }
    if b != 3 { return 2 }
    let absent: i64 | null = null
    let c = match absent {
        i64 as v when v > 5 => v * 2
        i64 as v => v
        null => -1
    }
    if c != -1 { return 3 }
    0
}

/**
 * f_empty_slice_sentinel_untouched — retire-Optional O4: proves the SEPARATE `Slice{Void}`
 * empty-slice sentinel (`teko::list::empty()`'s type — `type_eq`'s Slice arm and
 * `type_has_sentinel`'s Slice arm, BOTH left untouched by this crumb, alongside their Optional
 * arms in the SAME two functions) still unifies with any concrete slice and lets a `push` fix its
 * element type, including one level of nesting. A DIFFERENT sentinel from `Optional`'s `Void`
 * inner entirely — the negative-half proof that O4 did not over-delete.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_empty_slice_sentinel_untouched() -> i64 {
    let e: []i64 = teko::list::empty()
    if e.len != 0 { return 1 }
    let one = teko::list::push(e, 11)
    if one.len != 1 { return 2 }
    if one[0] != 11 { return 3 }
    let nested: [][]i64 = teko::list::empty()
    if nested.len != 0 { return 4 }
    0
}

/**
 * match_arm_null_widen — the MATCH ARM sub-position of native-N1-null-widen (O1 retirement): one
 * arm's own tail is a NESTED `match` whose every arm is, itself, a bare `null` literal — the
 * checker's `type_join` collapses that nested match's OWN inferred type to bare `Null`, not the
 * outer `i64 | null` the OUTER match's other (real-valued) arms fix as its type. The value the
 * placement's coercion sees is therefore `Null`-typed but NOT literally a `TNullLit`, the exact
 * shape `teko::checker::check_must_free_locals_stmt`'s own nested `match` tail exposed on the
 * native fixpoint.
 *
 * @param tag  0 takes the real-value arm, 1 the null-collapsed nested arm, anything else the other
 *             real-value arm
 * @return     9, `null`, or -1 depending on `tag`
 */
fn match_arm_null_widen(tag: i64) -> i64 | null {
    match tag {
        0 => 9
        1 => match tag { 0 => null; _ => null }
        _ => -1
    }
}

/**
 * if_branch_null_widen — the IF/`when` BRANCH sub-position of native-N1-null-widen: the `then`
 * branch's own tail is a NESTED `if`/`else` whose every branch is a bare `null` literal, so that
 * nested `if`'s OWN inferred type collapses to bare `Null` the same way `match_arm_null_widen`'s
 * nested match does — the outer `if`'s type is fixed to `i64 | null` by its `else` branch's real
 * value alone.
 *
 * @param flag  true takes the null-collapsed nested branch, false the real-value `else`
 * @return      `null` when `flag`, else 13
 */
fn if_branch_null_widen(flag: bool) -> i64 | null {
    if flag {
        if flag { null } else { null }
    } else {
        13
    }
}

/**
 * assign_null_widen — the ASSIGNMENT right-hand-side sub-position of native-N1-null-widen: a
 * mutable `i64 | null` local is reassigned from a NESTED `if`/`else` whose every branch is `null`
 * (the same collapsed-to-bare-`Null` shape) on one path, and a real `i64` on the other — the
 * assignment's own declared type (`i64 | null`) is the union the RHS's collapsed `Null` type must
 * be widened into.
 *
 * @param tag  0 takes the null-widening assignment, anything else the real-value one
 * @return     the local's final value: `null` when `tag == 0`, else 21
 */
fn assign_null_widen(tag: i64) -> i64 | null {
    mut x: i64 | null = 0
    if tag == 0 {
        x = if tag == 0 { null } else { null }
    } else {
        x = 21
    }
    x
}

/**
 * unwrap_or_native_null_widen — read an `i64 | null` back: the payload when present, or `sentinel`
 * when absent — the shared reader `f_null_widen_native_subpositions` funnels every case through.
 *
 * @param v         the union value to read
 * @param sentinel  the value to report when `v` is absent
 * @return          `v`'s payload, or `sentinel`
 */
fn unwrap_or_native_null_widen(v: i64 | null, sentinel: i64) -> i64 {
    match v {
        i64 as n => n
        null => sentinel
    }
}

/**
 * f_null_widen_native_subpositions — native-N1-null-widen (O1 retirement): a bare `null` reached
 * through the THREE sub-positions whose expected `T | null` union is INFERRED/propagated from
 * context rather than declared directly at the placement — a MATCH ARM (`match_arm_null_widen`), an
 * IF/`when` BRANCH (`if_branch_null_widen`), and an ASSIGNMENT right-hand side
 * (`assign_null_widen`). Each source's null value reaches its placement as a `Null`-typed
 * `match`/`if` sub-expression, not a bare `TNullLit`, so the fixture exercises exactly the
 * `lower_null_absent_widened` widen `lower_value_into_type`'s coercion now performs at each site,
 * both the null-producing AND the real-value path of each.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_null_widen_native_subpositions() -> i64 {
    if unwrap_or_native_null_widen(match_arm_null_widen(0), -101) != 9 { return 1 }
    if unwrap_or_native_null_widen(match_arm_null_widen(1), -101) != -101 { return 2 }
    if unwrap_or_native_null_widen(match_arm_null_widen(2), -101) != -1 { return 3 }
    if unwrap_or_native_null_widen(if_branch_null_widen(true), -102) != -102 { return 4 }
    if unwrap_or_native_null_widen(if_branch_null_widen(false), -102) != 13 { return 5 }
    if unwrap_or_native_null_widen(assign_null_widen(0), -103) != -103 { return 6 }
    if unwrap_or_native_null_widen(assign_null_widen(1), -103) != 21 { return 7 }
    0
}

/**
 * GfcBox — a single-field generic struct used to prove a generic FUNCTION may construct a generic
 * TYPE from its OWN still-abstract type-param (`GfcBox<T>` built inside `gfc_wrap<T>`). Before
 * fix/generic-stamping the construction inside the generic body left the phantom `GfcBox__g__T`
 * un-concretized — the monomorph pass reported "internal: generic instance `GfcBox__g__T` was not
 * stamped"; it now re-mangles the phantom through the bound `T` (`resolve::subst_instance_name`).
 */
type GfcBox<T> = struct { v: T }

/**
 * gfc_wrap — THE regression: a generic free function whose body constructs the generic type
 * `GfcBox<T>` from the function's own type-param `T`. Monomorphizing `gfc_wrap<i64>` / `gfc_wrap<u8>`
 * must concretize the construction node to `GfcBox__g__i64` / `GfcBox__g__u8` (each per its instance),
 * never a shared or leftover `GfcBox__g__T`.
 *
 * @param x  the value to wrap
 * @return   a `GfcBox<T>` holding `x`
 */
fn gfc_wrap<T>(x: T) -> GfcBox<T> { GfcBox<T>{ v = x } }

/**
 * gfc_seed_i / gfc_seed_u — explicit WRITTEN `GfcBox<i64>` / `GfcBox<u8>` uses so `instantiate_types`
 * stamps those concrete instance decls, exactly the shape the compiler's own static-factory
 * workaround relies on (the type argument concrete at a written site). The generic FUNCTION's
 * construction node concretizes to these same stamps.
 *
 * @param n  the value to wrap
 * @return   the concrete `GfcBox` instance holding `n`
 */
fn gfc_seed_i(n: i64) -> GfcBox<i64> { GfcBox<i64>{ v = n } }
fn gfc_seed_u(n: u8) -> GfcBox<u8> { GfcBox<u8>{ v = n } }

/**
 * f_generic_fn_constructs_generic — a generic function constructing a generic type from its OWN
 * type-param, monomorphized at two distinct instances (`i64`, `u8`) so each construction node must
 * concretize to its own stamp; a leftover `GfcBox__g__T` would mistype or crash the native emit.
 *
 * @return 42 — `gfc_wrap(40).v` (i64, 40) + `gfc_wrap(2 to u8).v` (u8, 2) + the two zero-valued seeds
 */
fn f_generic_fn_constructs_generic() -> i64 {
    let a = gfc_wrap(40)
    let b = gfc_wrap(2 to u8)
    let si = gfc_seed_i(0)
    let su = gfc_seed_u(0 to u8)
    a.v + (b.v to i64) + si.v + (su.v to i64)
}

/**
 * CK1_SHADOWED — a module-level `const` whose name a local `let` re-uses in `f_ck1_shadow_local`, so
 * the case can prove a local binding shadows a same-named global. Part of the CK1 scoped-hash-maps
 * regression guard (design docs/design/ck1-scoped-hash-maps-0.3.1.md §8, fixture 1).
 */
const CK1_SHADOWED: i64 = 100

/**
 * CK1_ALPHA — one of three same-prefixed module-level consts `f_ck1_many_globals_resolve` reads by
 * bare name, so the case proves the `lookup_binding` hash index re-tests exact bytes and returns the
 * right global among several. Part of the CK1 regression guard (design §8).
 */
const CK1_ALPHA: i64 = 11

/**
 * CK1_BETA — the second of the three CK1 discrimination consts (see `CK1_ALPHA`).
 */
const CK1_BETA: i64 = 22

/**
 * CK1_GAMMA — the third of the three CK1 discrimination consts (see `CK1_ALPHA`).
 */
const CK1_GAMMA: i64 = 33

/**
 * f_ck1_shadow_local — a local `let CK1_SHADOWED = 7` shadows the module-level `const CK1_SHADOWED`
 * (100). `lookup_binding` scans the mutable local `bindings` tail-first BEFORE the sealed globals, so
 * the local must win — the property the CK1 hash-index rewrite of the GLOBAL scan must not disturb
 * (design §8, fixture 1). Returns true iff the local (7), not the global (100), resolves.
 *
 * @return true iff the local binding shadows the same-named global const
 */
fn f_ck1_shadow_local() -> bool {
    let CK1_SHADOWED: i64 = 7
    CK1_SHADOWED == 7
}

/**
 * f_ck1_global_via_index — a bare reference to the module-level `const CK1_BETA` with no local of that
 * name, so `lookup_binding` falls through the local scan and resolves the global through the sealed
 * `base_index` hash lookup — the exact CK1.1 code path. Returns true iff the index resolves the global
 * to its value (22).
 *
 * @return true iff the bare global name resolves through the base index to 22
 */
fn f_ck1_global_via_index() -> bool {
    CK1_BETA == 22
}

/**
 * f_ck1_many_globals_resolve — three same-prefixed globals read by bare name, so each resolves through
 * the `base_index` hash bucket and the exact-name re-test picks the right one. A collision or a wrong
 * max-position pick would return the wrong value and fail the case (design §8, fixture 3's property —
 * the max-position pick is also unit-tested in `src/checker/nidx_test.tkt`).
 *
 * @return true iff CK1_ALPHA, CK1_BETA and CK1_GAMMA each resolve to their own value
 */
fn f_ck1_many_globals_resolve() -> bool {
    CK1_ALPHA == 11 && CK1_BETA == 22 && CK1_GAMMA == 33
}

/**
 * f_ck1_ns_call — two functions of the SAME bare name `ck1_ns_probe` live in DIFFERENT namespaces
 * (`aa` adds 1, `bb` adds 100). The base hash-index bucket for `ck1_ns_probe` holds both, so a
 * qualified call must pick by namespace through `call_binding_matches` — the exact CK1.2 code path
 * (`lookup_call`/`call_ns` routed through `call_base_pos`, design §8, fixture 2). A wrong-namespace
 * pick would return the other arm's value and fail the case.
 *
 * @return true iff `aa::ck1_ns_probe(10)` resolves to 11 and `bb::ck1_ns_probe(10)` to 110
 */
fn f_ck1_ns_call() -> bool {
    aa::ck1_ns_probe(10) == 11 && bb::ck1_ns_probe(10) == 110
}

/**
 * f_ck1_type_same_bare — two types of the SAME last segment `Thing` coexist across namespaces
 * (`aa::Thing` carries field `v`, `bb::Thing` carries field `w`). Resolving each QUALIFIED type
 * reference goes through `resolve_qualified_type_reg`/`type_table_find`, which probe the `by_last`
 * hash index keyed on `str_hash("Thing")` and re-check the qualifier — the CK1.4 code path (design
 * §8, fixture 4). If the index conflated the two same-bare types, the field read would resolve
 * against the wrong declaration.
 *
 * @return true iff `aa::Thing { v = 5 }.v` is 5 and `bb::Thing { w = 9 }.w` is 9
 */
fn f_ck1_type_same_bare() -> bool {
    let t1 = aa::Thing { v = 5 }
    let t2 = bb::Thing { w = 9 }
    t1.v == 5 && t2.w == 9
}
