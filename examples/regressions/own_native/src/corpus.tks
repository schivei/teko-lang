/**
 * f_arith — the fold-opaque MUL/ADD probe. `n` is a `mut` local, so const-folding may not collapse
 * the expression at compile time and the native backend must actually emit the two arithmetic
 * instructions.
 *
 * @return 42, the value `main.tks` pins
 */
fn f_arith() -> i64 { mut n = 3; n * 10 + 12 }

/**
 * f_sub — the fold-opaque MUL/SUB probe, the subtraction twin of `f_arith` and opaque for the same
 * reason: `n` is a `mut` local.
 *
 * @return 42, the value `main.tks` pins
 */
fn f_sub() -> i64 { mut n = 3; n * 20 - 18 }

/**
 * f_defer — a `defer` registered INSIDE a match arm must run when that arm's scope ends and its
 * write must be visible to the enclosing function afterwards.
 *
 * @return 101 — the initial 1 plus the deferred arm's +100
 */
fn f_defer() -> i64 {
    mut s = 1
    let x = 1
    match x {
        1 => { defer { s = s + 100 } }
        _ => { }
    }
    s
}

/**
 * f_exit_code — the smallest possible exit-code probe: a literal return the whole vertical must
 * carry from the emitter to the process status.
 *
 * @return 42
 */
fn f_exit_code() -> i64 { 42 }

/**
 * f_exit_zero — the SUCCESS status, pinned separately from `f_exit_code` because zero is the value
 * a broken vertical is most likely to produce by accident.
 *
 * @return 0
 */
fn f_exit_zero() -> i64 { 0 }

/**
 * f_if_exit — an `if`/`else` whose BOTH arms diverge with `return`, so the function has no
 * fall-through tail for the emitter to reach.
 *
 * @return 1 — the then-arm, since 5 > 3
 */
fn f_if_exit() -> i64 { if 5 > 3 { return 1 } else { return 2 } }

/**
 * f_if_value_rhs_shadow — a value-`if` whose arm SHADOWS an outer `x` and whose enclosing block then
 * REASSIGNS that outer `x`. The shadow must not alias the outer binding, so the reassignment is the
 * value observed at the end.
 *
 * @return 7 — the reassigned outer `x` (the shadowed 99 cancels out through `seen - seen`)
 */
fn f_if_value_rhs_shadow() -> i64 {
    mut x = 1
    mut seen = 0
    if 1 == 1 {
        let y = if 1 == 1 { let x = 99; x } else { 0 }
        seen = y
        x = 7
    }
    x + seen - seen
}

/**
 * f_logical_not — logical negation over a `bool` local and over two comparison expressions, each
 * guarding an early return so a mis-lowered `!` is observable as a wrong exit code.
 *
 * @return 7 — reached only when all three negations evaluate correctly
 */
fn f_logical_not() -> i64 {
    mut b = true
    if !b { return 1 }
    if !(1 < 2) { return 2 }
    if !(2 < 1) { return 7 }
    0
}

/**
 * f_loop_nested_range — LABELLED control flow across nested range loops: `continue OUTER` from the
 * inner loop must resume the OUTER loop's next iteration, and `break OUTER` must leave both.
 *
 * @return 0 when the accumulated sum is the expected 4, else 1
 */
fn f_loop_nested_range() -> i64 {
    mut sum = 0
    OUTER: loop mut i in 0..3 {
        loop mut j in 0..3 {
            if j == 2 { continue OUTER }
            if i == 2 { break OUTER }
            sum = sum + i + j
        }
    }
    if sum != 4 { return 1 }
    0
}

/**
 * f_loop_range_native — the four range-loop laws in one body: an exclusive range, an inclusive
 * range, `continue` inside a range, and a bound that is SNAPSHOT at loop entry (writing `n` inside
 * the body must not extend the iteration count).
 *
 * @return 0 when all four hold, else 1/2/3/4 naming the one that failed
 */
fn f_loop_range_native() -> i64 {
    mut s = 0
    loop mut i in 0..3 { s = s + i }
    if s != 3 { return 1 }
    mut s2 = 0
    loop mut i in 0..=3 { s2 = s2 + i }
    if s2 != 6 { return 2 }
    mut s3 = 0
    loop mut i in 0..5 { if i == 2 { continue }; s3 = s3 + i }
    if s3 != 8 { return 3 }
    mut n = 3
    mut cnt = 0
    loop mut i in 0..n { n = 100; cnt = cnt + 1 }
    if cnt != 3 { return 4 }
    0
}

/**
 * f_match_arm_reassign_vs_shadow — a match arm that REASSIGNS an outer local beside an arm that
 * SHADOWS it. The two must not share a slot: the taken arm decides which of the two effects the
 * caller observes.
 *
 * @return 6 — 5 from the reassigning arm plus 1 from the untouched outer binding
 */
fn f_match_arm_reassign_vs_shadow() -> i64 {
    let k1 = 1
    mut a = 1
    match k1 { 1 => { a = 5 }; _ => { mut a = 99; a = a + 1 } }
    let k0 = 0
    mut b = 1
    match k0 { 1 => { b = 5 }; _ => { mut b = 99; b = b + 1 } }
    a + b
}

/**
 * f_match_exit — a value-`match` used as the function's tail expression, so the arm's value is the
 * returned one.
 *
 * @return 7 — the arm selected by subject 0
 */
fn f_match_exit() -> i64 { let k = 0; match k { 0 => 7; _ => 9 } }

/**
 * f_match_reassign_then_shadow — one arm that first REASSIGNS the outer `x` and then SHADOWS it. The
 * shadow's later writes must not reach the outer binding the function returns.
 *
 * @return 3 — the reassignment, never the shadow's 100
 */
fn f_match_reassign_then_shadow() -> i64 {
    let k = 1
    mut x = 1
    match k { 1 => { x = 3; mut x = 99; x = x + 1 }; _ => { } }
    x
}

/**
 * f_value_if_rhs_reassign — a value-`if` whose arm REASSIGNS the outer local it also reads, so the
 * write must be visible both to the arm's own value and to the enclosing function.
 *
 * @return 5 — the reassigned `x` (the arm's value cancels through `seen - seen`)
 */
fn f_value_if_rhs_reassign() -> i64 {
    mut x = 1
    mut seen = 0
    if 1 == 1 { let y = if 1 == 1 { x = 5; x } else { 0 }; seen = y }
    x + seen - seen
}

/**
 * f_null_union_reassign_to_null — (B-S1) the own backend must coerce into a null-union at EVERY
 * placement that declares a type, not only at the binding. `x = null` after a `T | null` binding
 * used to write a raw `const 0` into the VReg the following `match` then read as the wrapper's base
 * address — a load from address 0.
 *
 * @return 42 — 40 from the null arm plus 2 from the re-assigned value arm
 */
fn f_null_union_reassign_to_null() -> i64 {
    mut x: i64 | null = 5
    x = null
    let a = match x { i64 as v => v; null => 40 }
    x = 2
    let b = match x { i64 as v => v; null => 0 }
    a + b
}

/**
 * LayoutPair — the STRUCT control of the class-layout probe. It is the arm of the native lowering's
 * layout collector that already worked, so a fix that broke it fails here instead of passing
 * quietly.
 */
type LayoutPair = struct {
    /** small — the leading 4-byte field, the one a wrong stride reads back wrong. */
    small: i32

    /** big — the 8-byte field the leading one must not overlap. */
    big: i64

    /** flag — the trailing 1-byte field, the one a wrong total size drops. */
    flag: bool
}

/**
 * LayoutBase — an ABSTRACT base whose fields are the PREFIX of every derived instance, which is
 * what field-flattening composition means for the emitted object.
 */
type LayoutBase = abstract class {
    /** small — the inherited 4-byte field. */
    pub small: i32

    /** big — the inherited 8-byte field. */
    pub big: i64
}

/**
 * LayoutLeaf — the concrete leaf: `LayoutBase`'s two fields followed by its own two. An overlapping
 * or reordered slot shows up as a wrong read-back, never as a compile error.
 */
type LayoutLeaf = class LayoutBase {
    /** flag — the leaf's own 1-byte field, placed after the inherited prefix. */
    pub flag: bool

    /** extra — the leaf's own 8-byte field. */
    pub extra: i64

    /**
     * make — the static factory, naming the INHERITED fields alongside its own.
     *
     * @param s  the inherited small field
     * @param b  the inherited big field
     * @param f  the own flag field
     * @param e  the own extra field
     * @return   a fresh LayoutLeaf
     */
    pub fn make(s: i32, b: i64, f: bool, e: i64) -> LayoutLeaf { LayoutLeaf { small = s; big = b; flag = f; extra = e } }

    /**
     * total — sums an INHERITED field with an OWN one, so a slot shared between the two halves of
     * the flattened layout yields a wrong sum.
     *
     * @return small + big + extra
     */
    pub fn total(self) -> i64 { self.small + self.big + self.extra }
}

/**
 * f_class_layout_effective_fields — a `ClassBody` must register the layout of its EFFECTIVE
 * instance fields. The native lowering collected a layout for a `StructBody` only; a `ClassBody`
 * fell through the catch-all arm of `collect_struct_layout_decl` and registered NOTHING, so EVERY
 * class instantiation died at compile time with "no layout registered for struct `…`" — one class
 * in one namespace, with no same-name type anywhere, was enough to trigger it.
 *
 * @return 0 when the struct control and every inherited and own field read back the value they were
 *         constructed with, else 1..8 naming the one that failed
 */
fn f_class_layout_effective_fields() -> i64 {
    let pair = LayoutPair { small = 3; big = 7; flag = true }
    if pair.small != 3 { return 1 }
    if pair.big != 7 { return 2 }
    if !pair.flag { return 3 }
    let leaf = LayoutLeaf::make(2, 13, true, 17)
    if leaf.small != 2 { return 4 }
    if leaf.big != 13 { return 5 }
    if !leaf.flag { return 6 }
    if leaf.extra != 17 { return 7 }
    if leaf.total() != 32 { return 8 }
    0
}

/**
 * LpShade — a plain declared `enum`, whose value is its integer CARRIER rather than an address.
 * A slice of these is the non-primitive half of the register-value element set the native list
 * builtin lowers.
 */
type LpShade = enum { Dim; Mid; Bright }

/**
 * f_list_push_scalar_loop — the canonical accumulation the whole compiler is written in:
 * `loop { xs = teko::list::push(xs, …) }` growing an empty list, then read back by index. It
 * exercises the runtime's amortized grow (the in-place live-tail hit AND the geometric copy-grow,
 * since eight pushes cross several doublings) through the native lowering's `(ptr, len, &item,
 * sizeof, &out_len)` call shape.
 *
 * @return 0 when the length and every element read back as pushed, else 1..3 naming the failure
 */
fn f_list_push_scalar_loop() -> i64 {
    mut xs: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= 8 { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    if xs.len != 8 { return 1 }
    mut sum: u64 = 0
    mut j: u64 = 0
    loop {
        if j >= xs.len { break }
        sum = sum + xs[j]
        j++
    }
    if sum != 84 { return 2 }
    if xs[7] != 21 { return 3 }
    0
}

/**
 * f_list_push_value_semantics — a push RETURNS a new list and never mutates its base: two pushes
 * onto the SAME base must produce two independent lists, and the base itself must keep its own
 * length. This is the assertion the runtime's in-place live-tail cache is most likely to break, so
 * it is pinned separately from the plain accumulation.
 *
 * @return 0 when both branches and the shared base read back independently, else 1..5
 */
fn f_list_push_value_semantics() -> i64 {
    let base = teko::list::push(teko::list::push(teko::list::empty(), 10), 20)
    let left = teko::list::push(base, 30)
    let right = teko::list::push(base, 40)
    if base.len != 2 { return 1 }
    if left.len != 3 { return 2 }
    if right.len != 3 { return 3 }
    if left[2] != 30 { return 4 }
    if right[2] != 40 { return 5 }
    0
}

/**
 * f_list_push_fo_widths — the `teko::mem::push_fo` DECREE (the free-old-on-grow runtime entry) over
 * a NARROW element: a `[]u32` element is four bytes wide, so the `sizeof` the lowering hands the
 * runtime must be the ELEMENT's width and not the register's, or the buffer reads back shifted.
 *
 * @return 0 when the decreed chain reads back as pushed, else 1..3 naming the failure
 */
fn f_list_push_fo_widths() -> i64 {
    mut xs: []u32 = teko::list::empty()
    mut i: u32 = 0
    loop {
        if i >= 6 { break }
        xs = teko::mem::push_fo(xs, i + 100)
        i++
    }
    if xs.len != 6 { return 1 }
    if xs[0] != 100 { return 2 }
    if xs[5] != 105 { return 3 }
    0
}

/**
 * f_list_push_bool_and_enum — the two remaining register-value element classes: a `bool` (a
 * one-byte carrier) and a declared `enum` (its integer carrier). A slice of either must round-trip
 * through the grow with its own width.
 *
 * @return 0 when both slices read back as pushed, else 1..4 naming the failure
 */
fn f_list_push_bool_and_enum() -> i64 {
    mut marks: []bool = teko::list::empty()
    marks = teko::list::push(marks, true)
    marks = teko::list::push(marks, false)
    marks = teko::list::push(marks, true)
    if marks.len != 3 { return 1 }
    if !marks[0] { return 2 }
    if marks[1] { return 3 }
    mut shades: []LpShade = teko::list::empty()
    shades = teko::list::push(shades, LpShade::Bright)
    shades = teko::list::push(shades, LpShade::Dim)
    if shades[0] != LpShade::Bright { return 4 }
    0
}

/**
 * f_list_empty_has_no_elements — a bare `teko::list::empty()` is the (null, 0) pair: its length is
 * zero with no runtime call at all, and pushing onto it starts a fresh buffer rather than growing
 * whatever the previous list left in the allocator's live-tail cache.
 *
 * @return 0 when the empty list is empty and the fresh push holds only its own item, else 1..3
 */
fn f_list_empty_has_no_elements() -> i64 {
    let e: []u64 = teko::list::empty()
    if e.len != 0 { return 1 }
    let one = teko::list::push(e, 7)
    if one.len != 1 { return 2 }
    if one[0] != 7 { return 3 }
    0
}

/**
 * sc_yes — an opaque `true` the const-folder cannot see through, so the short-circuit rows below
 * measure the LOWERING and not the folder.
 *
 * @param n  a seed the caller varies so the call is never folded to a literal
 * @return   true whenever `n` is zero or positive
 */
fn sc_yes(n: i64) -> bool { n >= 0 }

/**
 * sc_no — the opaque `false` twin of `sc_yes`, opaque for the same reason.
 *
 * @param n  a seed the caller varies so the call is never folded to a literal
 * @return   false whenever `n` is zero or positive
 */
fn sc_no(n: i64) -> bool { n < 0 }

/**
 * sc_trap — a division by `d` that TRAPS when `d` is zero. It is the right operand of the two
 * short-circuit rows that must never evaluate their right side: a lowering that evaluates both
 * operands kills the process instead of returning a wrong number, which is the loudest possible
 * failure for exactly the miscompile a bitwise `IAnd` would have introduced.
 *
 * @param d  the divisor
 * @return   true when 10/d is positive
 */
fn sc_trap(d: i64) -> bool { (10 / d) > 0 }

/**
 * f_short_circuit_and_or — the truth table of `&&` and `||` plus their SHORT-CIRCUIT guarantee.
 * The native lowering routed both operators into the integer opcode table (`bool` rides the
 * integer family of `lbinop_of`'s float/int split) and honest-stopped there, so no program using
 * a logical operator could be built natively at all — the compiler's own source first among them.
 * They now lower to a branch whose right-operand block is entered only when the left operand did
 * not already decide the result.
 *
 * @return 0 when every row of the table holds and neither trap row evaluated its right operand,
 *         else the number of the first failing row
 */
fn f_short_circuit_and_or() -> i64 {
    if !(sc_yes(1) && sc_yes(2)) { return 1 }
    if sc_yes(1) && sc_no(2) { return 2 }
    if sc_no(1) && sc_yes(2) { return 3 }
    if sc_no(1) && sc_no(2) { return 4 }
    if !(sc_yes(1) || sc_no(2)) { return 5 }
    if !(sc_no(1) || sc_yes(2)) { return 6 }
    if sc_no(1) || sc_no(2) { return 7 }
    if !(sc_yes(1) && sc_yes(2) && sc_yes(3)) { return 8 }
    if sc_no(1) && sc_trap(0) { return 9 }
    if !(sc_yes(1) || sc_trap(0)) { return 10 }
    if !(sc_yes(1) && sc_no(2) || sc_yes(3)) { return 11 }
    0
}

/**
 * BoxPt — the pushed AGGREGATE element. Two 8-byte fields, so a mistaken 8-byte-wide copy of the
 * instance would carry `x` and lose `y`.
 */
type BoxPt = struct {
    /** x — the iteration counter, straight. */
    x: i64

    /** y — the iteration counter times ten, so a stale copy is visible in two independent fields. */
    y: i64
}

/**
 * BoxCounter — the CLASS arm of the same claim: a class instance is laid out by the same collector
 * a struct is, so a push must box it with the same width.
 */
type BoxCounter = class {
    /** seen — the value this instance was constructed with. */
    pub seen: i64

    /**
     * make — the static factory (a class literal reads better through one named producer).
     *
     * @param v  the value to record
     * @return   a fresh BoxCounter holding `v`
     */
    pub fn make(v: i64) -> BoxCounter { BoxCounter { seen = v } }
}

/**
 * push_pts — accumulate `n` distinct `BoxPt` instances through `teko::list::push`, ONE PER LOOP
 * ITERATION. This is the shape degrau 4 closed: the native backend's value for a struct is the
 * address of an `alloca`, and an `alloca` is one frame slot per INSTRUCTION, so a push that stored
 * that address directly would store the SAME address `n` times.
 *
 * @param n  how many elements to accumulate
 * @return   the accumulated list
 */
fn push_pts(n: i64) -> []BoxPt {
    mut ps: []BoxPt = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        ps = teko::list::push(ps, BoxPt { x = i; y = i * 10 })
        i++
    }
    ps
}

/**
 * f_push_aggregate_in_loop — a push of a STRUCT inside a loop must yield `n` DISTINCT elements.
 * Without degrau 4's fresh per-execution box the program did not compile at all (the native backend
 * honest-stopped on the aggregate element), and the naive stand-in it refused — pushing the
 * `alloca`'s address as-is — makes every element read back as a copy of the LAST one, which is
 * exactly what the element-by-element check below catches.
 *
 * @return 0 when every element carries its own iteration's values, else the number of the failing
 *         check
 */
fn f_push_aggregate_in_loop() -> i64 {
    let ps = push_pts(4)
    if ps.len != 4 { return 1 }
    mut i: i64 = 0
    loop {
        if i >= 4 { break }
        if ps[i].x != i { return 2 }
        if ps[i].y != i * 10 { return 3 }
        i++
    }
    if ps[0].x == ps[3].x { return 4 }
    if ps[0].y == ps[3].y { return 5 }
    0
}

/**
 * f_push_aggregate_copies_the_item — a pushed aggregate is a COPY: mutating the source binding
 * after the push must not reach the element the list holds. The address model without a box shares
 * one frame slot between the binding and the list, so the mutation would be visible through the
 * list too.
 *
 * @return 0 when the pushed element kept the values it was pushed with, else the failing check
 */
fn f_push_aggregate_copies_the_item() -> i64 {
    mut p = BoxPt { x = 1; y = 2 }
    mut ps: []BoxPt = teko::list::empty()
    ps = teko::list::push(ps, p)
    p.x = 99
    p.y = 98
    if ps.len != 1 { return 1 }
    if ps[0].x != 1 { return 2 }
    if ps[0].y != 2 { return 3 }
    0
}

/**
 * f_push_class_in_loop — the CLASS arm of `f_push_aggregate_in_loop`: a class instance pushed once
 * per iteration must read back as its own iteration's value, through a method as well as a field.
 *
 * @return 0 when every element carries its own iteration's value, else the number of the failing
 *         check
 */
fn f_push_class_in_loop() -> i64 {
    mut cs: []BoxCounter = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= 3 { break }
        cs = teko::list::push(cs, BoxCounter::make(i * 7))
        i++
    }
    if cs.len != 3 { return 1 }
    if cs[0].seen != 0 { return 2 }
    if cs[1].seen != 7 { return 3 }
    if cs[2].seen != 14 { return 4 }
    0
}

/**
 * fat_match_word — a `str`-valued `match` in TAIL position, the exact producer the native backend
 * had no arm for: `lower_fat_expr`'s closed producer set accepted a literal, an array literal, a
 * bound local, a struct field, an `if`-expression and a direct call, and a match-value was none of
 * them.
 *
 * @param n  the subject
 * @return   the word naming `n`, `"many"` past the named ones
 */
fn fat_match_word(n: i64) -> str {
    match n {
        0 => "zero"
        1 => "one"
        2 => "two"
        _ => "many"
    }
}

/**
 * fat_match_digits — a `[]T`-valued `match`, the SLICE half of the same producer: the merge carries
 * a (ptr, len) pair, so an arm whose slice has a different length must not reach the merge with the
 * length of a sibling arm.
 *
 * @param n  the subject
 * @return   a slice whose length and contents both depend on the arm taken
 */
fn fat_match_digits(n: i64) -> []i64 {
    match n {
        1 => [7]
        2 => [7, 8]
        _ => [7, 8, 9]
    }
}

/**
 * fat_match_with_reassign — a `str`-valued `match` whose arms also RE-ASSIGN an enclosing scalar.
 * The reassigned scalar rides the merge as a block-param AFTER the ptr/len pair, so a merge that
 * mis-ordered its params would return the wrong string, the wrong count, or both.
 *
 * @param n  the subject
 * @return   the count the arm assigned plus the LENGTH of the string it produced, so a merge that
 *           dropped either half is visible in the sum
 */
fn fat_match_with_reassign(n: i64) -> i64 {
    mut count: i64 = 0
    let word = match n {
        1 => { count = 10; "a" }
        _ => { count = 20; "bb" }
    }
    count + (word.len to i64)
}

/**
 * f_fat_match_value — the fat `match`-value producer, in both its `str` and its `[]T` shape and
 * with a scalar threaded through the merge beside the pair (0.3.1.0 degrau 5).
 *
 * The `str` shapes are checked through `.len` and a BYTE, not through `!=` on two strings: the
 * native backend has no `str` comparison yet (`"`str` has no single PrimKind"`), and a corpus
 * member must claim its own subject only.
 *
 * @return 0 when every shape returns its own arm's value, else the number of the failing check
 */
fn f_fat_match_value() -> i64 {
    if fat_match_word(0).len != 4 { return 1 }
    if fat_match_word(0)[0] != b'z' { return 2 }
    if fat_match_word(2).len != 3 { return 3 }
    if fat_match_word(2)[0] != b't' { return 4 }
    if fat_match_word(9).len != 4 { return 11 }
    if fat_match_word(9)[0] != b'm' { return 12 }
    if fat_match_word(1)[2] != b'e' { return 13 }
    if fat_match_digits(1).len != 1 { return 5 }
    if fat_match_digits(2).len != 2 { return 6 }
    if fat_match_digits(5).len != 3 { return 7 }
    if fat_match_digits(2)[1] != 8 { return 8 }
    if fat_match_with_reassign(1) != 11 { return 9 }
    if fat_match_with_reassign(4) != 22 { return 10 }
    0
}

/**
 * fat_variant_digits — a variant whose ACTIVE member is a `[]T` of a caller-chosen length. The
 * construction is what degrau 6 is about: the wrapper must keep the slice's LENGTH beside its
 * pointer, or nothing downstream can recover it.
 *
 * @param n  the element count to build
 * @return   the `n` first triples
 * @throws   when `n` is zero
 */
fn fat_variant_digits(n: i64) -> []i64 | error {
    if n == 0 { return error { message = "empty" } }
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= n { break }
        xs = teko::list::push(xs, i * 3)
        i++
    }
    return xs
}

/**
 * fat_variant_digits_len — the LENGTH a slice member reports once bound out of the variant by a
 * `[]T` pattern. THE CHECK THAT PROVES THE FIX: a wrapper that stored only the pointer binds an
 * `xs` whose `.len` is whatever sat past it, so a per-call length is the assertion a lossy
 * construction cannot satisfy by luck.
 *
 * @param n  the element count to ask for
 * @return   the bound slice's length, or -1 for the error case
 */
fn fat_variant_digits_len(n: i64) -> i64 {
    match fat_variant_digits(n) {
        []i64 as xs => xs.len to i64
        error => 0 - 1
    }
}

/**
 * fat_variant_digits_sum — the sum of a bound slice member's own elements, walked through the
 * bound LENGTH. Pins the CONTENTS beside the length: a binding that recovered a plausible length
 * but the wrong pointer would still read the wrong elements.
 *
 * @param n  the element count to ask for
 * @return   the sum of the bound slice's elements, or -1 for the error case
 */
fn fat_variant_digits_sum(n: i64) -> i64 {
    match fat_variant_digits(n) {
        []i64 as xs => {
            mut acc: i64 = 0
            mut i: u64 = 0
            loop {
                if i >= xs.len { break }
                acc = acc + xs[i]
                i++
            }
            acc
        }
        error => 0 - 1
    }
}

/**
 * fat_variant_word — a variant whose active member is a `str`, the case a pattern selects BY NAME
 * (`str as s`) rather than by the slice shape. Same wrapper, other half of the same hole.
 *
 * @param n  the switch selecting the word
 * @return   a word whose length depends on `n`
 * @throws   when `n` is zero
 */
fn fat_variant_word(n: i64) -> str | error {
    if n == 0 { return error { message = "empty" } }
    if n == 1 { return "a" }
    return "abcde"
}

/**
 * fat_variant_word_len — the LENGTH a `str` member reports once bound out of the variant.
 *
 * @param n  the switch selecting the word
 * @return   the bound string's length, or -1 for the error case
 */
fn fat_variant_word_len(n: i64) -> i64 {
    match fat_variant_word(n) {
        str as s => s.len to i64
        error => 0 - 1
    }
}

/**
 * fat_null_union_word — a null-BEARING union whose present member is a `str`: the third
 * construction path into the same wrapper (a fixed tag 0/1, no case name at all).
 *
 * @param n  the switch selecting presence
 * @return   a three-byte word, or `null`
 */
fn fat_null_union_word(n: i64) -> str | null {
    if n == 0 { return null }
    return "xyz"
}

/**
 * f_variant_fat_member — a variant member that is FAT (`str`/`[]T`) keeps its LENGTH across the
 * wrapper (0.3.1.0 degrau 6, the uniform 24-byte `{tag; ptr; len}`).
 *
 * Every check reads a length or a byte that only a wrapper carrying BOTH halves can answer: the
 * per-call slice lengths, the sum walked through one of them, the two `str` lengths, a byte behind
 * the bound pointer, and the null union's present case. The error/`null` arms are asserted too, so
 * a tag test that drifted when the wrapper widened is visible as a wrong arm rather than as a wrong
 * length.
 *
 * The strings are compared through `.len` and a BYTE, never with `!=` on two strings: the native
 * backend has no `str` comparison yet, and a corpus member must claim its own subject only.
 *
 * @return 0 when every shape recovers its own length and contents, else the number of the failing
 *         check
 */
fn f_variant_fat_member() -> i64 {
    if fat_variant_digits_len(3) != 3 { return 1 }
    if fat_variant_digits_len(7) != 7 { return 2 }
    if fat_variant_digits_len(0) != 0 - 1 { return 3 }
    if fat_variant_digits_sum(4) != 18 { return 4 }
    if fat_variant_word_len(1) != 1 { return 5 }
    if fat_variant_word_len(2) != 5 { return 6 }
    if fat_variant_word_len(0) != 0 - 1 { return 7 }
    match fat_null_union_word(1) {
        str as s => {
            if s.len != 3 { return 8 }
            if s[2] != b'z' { return 9 }
        }
        null => { return 10 }
    }
    match fat_variant_word(2) {
        str as s => { if s[4] != b'e' { return 11 } }
        error => { return 12 }
    }
    0
}

/**
 * str_eq_word — a `str` produced by a CALL, so the equality's operands are not both literals the
 * folder could have collapsed before the backend ever saw them.
 *
 * @param n  the switch selecting the word
 * @return   the word naming `n`
 */
fn str_eq_word(n: i64) -> str {
    if n == 0 { return "alpha" }
    if n == 1 { return "alphb" }
    ""
}

/**
 * f_str_equality — `str == str` and `str != str` lowered natively (0.3.1.0 degrau 7).
 *
 * The native backend had NO string comparison: `lower_compare` asked `prim_kind_of` for the
 * operand's single machine kind and a `str` has none (it is two words), so every `==` between
 * strings honest-stopped. The lowering now calls the runtime's own `tk_str_eq` with the two
 * ABI-flattened pairs.
 *
 * The rows that matter beyond "equal is equal": two DIFFERENT strings of the SAME length (a
 * length-only comparison would call them equal), two strings that differ in the LAST byte only (a
 * prefix comparison would call them equal), two equal strings held in different buffers (a pointer
 * comparison would call them different), and the empty pair (whose pointer is null).
 *
 * @return 0 when every comparison answers correctly, else the number of the failing check
 */
fn f_str_equality() -> i64 {
    let a = "alpha"
    let b = str_eq_word(0)
    let c = str_eq_word(1)
    if !(a == b) { return 1 }
    if a != b { return 2 }
    if a == c { return 3 }
    if !(a != c) { return 4 }
    if a == "alph" { return 5 }
    if a == "alphaa" { return 6 }
    if !("" == str_eq_word(9)) { return 7 }
    if "" != str_eq_word(9) { return 8 }
    if "" == a { return 9 }
    0
}

/**
 * DvCircle — a nominal case of the declared variant `DvShape`, carrying one integer field.
 */
type DvCircle = struct {
    /** r — the circle's radius, the value a `DvCircle` arm must read back. */
    r: i64
}

/**
 * DvSquare — the second nominal case of `DvShape`, with a DIFFERENT field name from `DvCircle` so
 * an arm that read the wrong case's payload cannot compile by accident.
 */
type DvSquare = struct {
    /** s — the square's side, the value a `DvSquare` arm must read back. */
    s: i64
}

/**
 * DvTri — the third nominal case, present so the corpus can enter a LAST arm that is neither the
 * first-arm-wins degenerate nor a two-case coin flip.
 */
type DvTri = struct {
    /** t — the triangle's base, the value a `DvTri` arm must read back. */
    t: i64
}

/**
 * DvShape — a DECLARED variant (`type X = variant …`) over three nominal cases.
 *
 * This is the shape the native backend miscompiled in silence: a declared variant reaches the
 * lowering as a nominal `Named`, not as the `checker::Variant` an inline `A | B` arrives as, so
 * no tag+payload wrapper was built and every bind pattern answered "always matches" — handing every
 * value to the FIRST arm with no diagnostic at all.
 */
type DvShape = variant DvCircle | DvSquare | DvTri

/**
 * dv_pick — a `DvShape` chosen by ordinal, so the case is decided at RUN time and no arm can be
 * folded away before the backend sees it.
 *
 * @param n  0 for a circle, 1 for a square, anything else for a triangle
 * @return   the constructed shape
 */
fn dv_pick(n: i64) -> DvShape {
    if n == 0 { return DvCircle { r = 7 } }
    if n == 1 { return DvSquare { s = 9 } }
    DvTri { t = 11 }
}

/**
 * f_declared_variant_arms — every arm of a declared-variant `match` is entered by the case that
 * belongs to it, and the value each arm BINDS is that case's own payload.
 *
 * THE BOUND VALUE IS PART OF THE CLAIM. An arm test that always answers true sends every subject to
 * the first arm, and the whole-value bind it pairs with reads the unwrapped payload at offset 0 —
 * so a check that only counted which arm ran would pass for the first case and lie about the rest.
 * Each arm therefore asserts the payload it must see, and every arm — first, middle and LAST — is
 * entered by its own case.
 *
 * @return 0 when every case runs its own arm with its own payload, else the number of the failing
 *         check
 */
fn f_declared_variant_arms() -> i64 {
    match dv_pick(0) {
        DvCircle as c => { if c.r != 7 { return 1 } }
        DvSquare as s => { return 2 }
        DvTri as t => { return 3 }
    }
    match dv_pick(1) {
        DvCircle as c => { return 4 }
        DvSquare as s => { if s.s != 9 { return 5 } }
        DvTri as t => { return 6 }
    }
    match dv_pick(2) {
        DvCircle as c => { return 7 }
        DvSquare as s => { return 8 }
        DvTri as t => { if t.t != 11 { return 9 } }
    }
    0
}

/**
 * dv_arm_code — the arm a declared-variant subject selects, as a match-VALUE rather than as a
 * statement: the value shape merges its arms through a block argument, a different lowering from
 * the statement shape, and it reads the SAME tag.
 *
 * @param n  the ordinal `dv_pick` switches on
 * @return   1 for a circle, 2 for a square, 3 for a triangle
 */
fn dv_arm_code(n: i64) -> i64 {
    match dv_pick(n) {
        DvCircle as c => 1
        DvSquare as s => 2
        DvTri as t => 3
    }
}

/**
 * f_declared_variant_match_value — the match-VALUE and the BINDINGLESS/field-pattern spellings of a
 * declared-variant arm select the same case the bind-pattern spelling does.
 *
 * A bindingless case (`DvSquare =>`) and a field destructure (`DvCircle { r }`) resolve their case
 * through paths of their own, so each is claimed here: the first used to inherit the same
 * always-matches degeneration, and the second used to honest-stop outright ("field match pattern
 * over a non-variant subject") because a declared variant never looked like a variant at all.
 *
 * @return 0 when every spelling picks its own case, else the number of the failing check
 */
fn f_declared_variant_match_value() -> i64 {
    if dv_arm_code(0) != 1 { return 1 }
    if dv_arm_code(1) != 2 { return 2 }
    if dv_arm_code(2) != 3 { return 3 }
    match dv_pick(2) {
        DvCircle => { return 4 }
        DvSquare => { return 5 }
        DvTri => { }
    }
    match dv_pick(0) {
        DvCircle { r } => { if r != 7 { return 6 } }
        DvSquare { s } => { return 7 }
        DvTri { t } => { return 8 }
    }
    match dv_pick(1) {
        DvCircle { r } => { return 9 }
        DvSquare { s } => { if s != 9 { return 10 } }
        DvTri { t } => { return 11 }
    }
    0
}

/**
 * DvBoxOrErr — a declared variant mixing NOMINAL cases with the built-in `error` case: the two
 * families resolve a case by different rules (a nominal by name, `error` by keyword), and a table
 * that dropped the non-nominal member would mis-tag every case declared after it.
 */
type DvBoxOrErr = variant DvCircle | DvSquare | error

/**
 * dv_or_err — a `DvBoxOrErr` chosen by ordinal.
 *
 * @param n  0 for the error case, 1 for a circle, anything else for a square
 * @return   the constructed value, or its `error` case
 */
fn dv_or_err(n: i64) -> DvBoxOrErr {
    if n == 0 { return error { message = "dv" } }
    if n == 1 { return DvCircle { r = 7 } }
    DvSquare { s = 9 }
}

/**
 * dv_maybe_circle — the INLINE `T | null` union next to the declared family, so the corpus claims a
 * `null` case mixed with a nominal one as well as an `error` case.
 *
 * @param n  0 for the absent case, anything else for a circle
 * @return   the circle, or `null`
 */
fn dv_maybe_circle(n: i64) -> DvCircle | null {
    if n == 0 { return null }
    DvCircle { r = 7 }
}

/**
 * f_declared_variant_error_and_null — the `error` case of a declared variant, and the `null` case of
 * a union, each entered by its own value while the nominal cases beside them keep their own arms.
 *
 * @return 0 when every case runs its own arm with its own payload, else the number of the failing
 *         check
 */
fn f_declared_variant_error_and_null() -> i64 {
    match dv_or_err(0) {
        error as e => { }
        DvCircle as c => { return 1 }
        DvSquare as s => { return 2 }
    }
    match dv_or_err(1) {
        error as e => { return 3 }
        DvCircle as c => { if c.r != 7 { return 4 } }
        DvSquare as s => { return 5 }
    }
    match dv_or_err(2) {
        error as e => { return 6 }
        DvCircle as c => { return 7 }
        DvSquare as s => { if s.s != 9 { return 8 } }
    }
    match dv_maybe_circle(0) {
        null => { }
        DvCircle as c => { return 9 }
    }
    match dv_maybe_circle(1) {
        null => { return 10 }
        DvCircle as c => { if c.r != 7 { return 11 } }
    }
    0
}

/**
 * pad_word — an interpolated, non-const-foldable prefix ("n=<n>") right-padded with spaces to
 * `width`. Mirrors `src/backend/objfile_ar.tks`'s own `ar_pad_right` shape (0.3.1.0 degrau 9): a
 * loop-carried `mut str` reassigned through `teko::str::concat`, seeded from a string
 * interpolation passed as the CALL's own argument — a genuine function parameter, so the checker's
 * const-folder cannot collapse it into a plain literal before the native lowering ever sees it.
 *
 * @param n      the value interpolated into the prefix
 * @param width  the minimum total width to pad to
 * @return       the padded text
 */
fn pad_word(n: i64, width: u64) -> str {
    mut out = $"n={n}"
    loop {
        if out.len >= width { break }
        out = teko::str::concat(out, " ")
    }
    out
}

/**
 * self_interp_loop — `out = $"{out}"` reassigned across a loop's own back-edge: the minimal
 * reproduction of 0.3.1.0 degrau 9's honest stop. The loop-merge machinery needs the
 * reassignment's RIGHT-hand side (an interpolation reading the SAME loop-carried local) through
 * `lower_fat_expr`, which had no `TInterp` arm.
 *
 * @param n  the iteration count
 * @return   `"a"` re-wrapped in its own interpolation `n` times (the content never changes; only
 *           the lowering path is under test)
 */
fn self_interp_loop(n: i64) -> str {
    mut out = "a"
    mut i: i64 = 0
    loop {
        if i >= n { break }
        out = $"{out}"
        i = i + 1
    }
    out
}

/**
 * f_interp_fat_positions — string interpolation exercised in every FAT position 0.3.1.0 degrau 9
 * closed: a call ARGUMENT (`pad_word`'s own caller), a loop-carried self-reassignment
 * (`self_interp_loop`), a MULTI-hole/multi-piece interpolation checked by both its content and its
 * LENGTH (a plausible length with the wrong bytes would still be caught by the byte check), and
 * the `teko::str::concat` builtin folded over more than two arguments (`lower_concat_call`'s own
 * loop, beside the 2-ary shape `pad_word` already exercises).
 *
 * @return 0 when every position lowers correctly, else the number of the failing check
 */
fn f_interp_fat_positions() -> i64 {
    let p = pad_word(7, 6 to u64)
    if p.len != 6 { return 1 }
    if p != "n=7   " { return 2 }
    let s = self_interp_loop(3)
    if s.len != 1 { return 3 }
    if s != "a" { return 4 }
    let x: i64 = 12
    let y = "mid"
    let multi = $"x={x}-{y}-end"
    if multi.len != 12 { return 5 }
    if multi != "x=12-mid-end" { return 6 }
    let joined = teko::str::concat("a", "b", "c", "d")
    if joined.len != 4 { return 7 }
    if joined != "abcd" { return 8 }
    0
}

/**
 * FatHolder — a struct with a leading `str` field, at offset 0. 0.3.1.0 raiz-comum §5.1: before
 * the R3 crumb, a struct's fat field was constructed with its LENGTH half never written, so
 * `.len` read back whatever the fresh `alloca` happened to hold (measured 0) instead of the
 * field's true length.
 */
type FatHolder = struct { name: str; n: i64 }

/**
 * FatHolderShift — the same fat field, SECOND (offset 8, not 0), so the fix's correctness does
 * not depend on the field's position within the struct.
 */
type FatHolderShift = struct { n: i64; name: str }

/**
 * FatSliceHolder — a struct with a `[]i64` (fat, non-`str`) field: `is_fat_type` covers `Slice`
 * too, and so does the defect it names (0.3.1.0 raiz-comum §5.4).
 */
type FatSliceHolder = struct { xs: []i64; n: i64 }

/**
 * f_fat_field_roundtrip — construct a struct with a fat `str` field at offset 0, read its
 * length and content back.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_roundtrip() -> i64 {
    let h = FatHolder { name = "abcde"; n = 7 }
    if h.n != 7 { return 1 }
    if h.name.len != 5 { return 2 }
    if h.name != "abcde" { return 3 }
    0
}

/**
 * f_fat_field_offset_shift — the same construction with the fat field at a non-zero offset.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_offset_shift() -> i64 {
    let h = FatHolderShift { n = 7; name = "abcde" }
    if h.n != 7 { return 1 }
    if h.name.len != 5 { return 2 }
    if h.name != "abcde" { return 3 }
    0
}

/**
 * f_fat_field_reassign — reassign a struct's `str` field and reread its length (0.3.1.0
 * raiz-comum §5.2: measured to keep the OLD length before R3, since the plain assignment path
 * wrote only the pointer half).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_reassign() -> i64 {
    mut h = FatHolder { name = "abcde"; n = 7 }
    h.name = "xy"
    if h.name.len != 2 { return 1 }
    if h.name != "xy" { return 2 }
    0
}

/**
 * f_fat_field_len — the length of a `str` argument, as `i64`.
 *
 * @param s  the string to measure
 * @return   its byte length
 */
fn f_fat_field_len(s: str) -> i64 { s.len to i64 }

/**
 * f_fat_field_as_argument — pass a struct's `str` field as a call argument (0.3.1.0 raiz-comum
 * §5.3): the READ side (`lower_fat_field`) was already correct before R3 — it was the WRITE
 * side that left the length half unset, so this probe exercises the reader against the
 * now-correctly-written field.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_field_as_argument() -> i64 {
    let h = FatHolder { name = "abcde"; n = 7 }
    if f_fat_field_len(h.name) != 5 { return 1 }
    0
}

/**
 * f_fat_slice_field — a struct's `[]i64` field: length and index read.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_field() -> i64 {
    let h = FatSliceHolder { xs = [10, 20, 30]; n = 1 }
    if h.xs.len != 3 { return 1 }
    if h.xs[2] != 30 { return 2 }
    0
}

/**
 * f_fat_slice_literal_index — a `[]str` array literal's store and index read: each element's
 * OWN `.len` and content, not just the outer slice's element count (0.3.1.0 degrau 10 /
 * raiz-comum §5.5 — measured to build with a silently corrupted stride before the fix, and to
 * honest-stop at the first index read once only the push side closed).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_literal_index() -> i64 {
    let xs: []str = ["one", "two", "three"]
    if xs.len != 3 { return 1 }
    if xs[0].len != 3 { return 2 }
    if xs[0] != "one" { return 3 }
    if xs[1] != "two" { return 4 }
    if xs[2] != "three" { return 5 }
    0
}

/**
 * f_fat_slice_push_in_loop — push `str` elements onto a `[]str` inside a loop, mirroring
 * `global_symbol_names`' own shape (the function 0.3.1.0 degrau 10 was measured in), each
 * element read back BY ITS OWN LENGTH afterward — a plausible length with the wrong bytes would
 * still be caught by the content check.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_slice_push_in_loop() -> i64 {
    let names: []str = ["alpha", "beta", "gamma", "delta"]
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        out = teko::list::push(out, names[i])
        i++
    }
    if out.len != 4 { return 1 }
    if out[0].len != 5 { return 2 }
    if out[0] != "alpha" { return 3 }
    if out[3] != "delta" { return 4 }
    0
}

/**
 * f_str_contains_and_ends_with — `teko::str::contains`/`ends_with`, both `(str, str) -> bool`
 * (0.3.1.0 degrau 11 / raiz-comum §R5): before this degrau, `call_symbol` had no resolution for
 * either bare name, so a reached call honest-stopped ("builtin `contains` not yet lowered") —
 * first surfaced through `teko::assert::str_contains`'s own body, which every `.tkt` test file in
 * this project calls. A bool result needs no out-parameter-length twin — it fits the ordinary
 * single result register every scalar call already captures.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_contains_and_ends_with() -> i64 {
    if !teko::str::contains("hello world", "lo wo") { return 1 }
    if teko::str::contains("hello world", "xyz") { return 2 }
    if !teko::str::contains("hello", "") { return 3 }
    if !teko::str::ends_with("hello world", "world") { return 4 }
    if teko::str::ends_with("hello world", "worldx") { return 5 }
    if !teko::str::ends_with("hello", "") { return 6 }
    0
}

/**
 * f_str_slice_family — `teko::str::slice`/`slice_to`/`slice_from`, all `str`-returning (0.3.1.0
 * degrau 11 / raiz-comum §R5): before this degrau, each honest-stopped the same way `contains`
 * did. Unlike the predicate pair above, a `str` result IS fat, so each resolves to the runtime's
 * out-parameter-length twin (`tk_str_slice_len`/`tk_str_slice_to_len`/`tk_str_slice_from_len`)
 * through the SAME `lower_len_out_call` shape 0.3.1.0 degrau 9 built for `tk_str_concat_len`.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_slice_family() -> i64 {
    let s = "hello world"
    let mid = teko::str::slice(s, 6, 11)
    if mid.len != 5 { return 1 }
    if mid != "world" { return 2 }
    let head = teko::str::slice_to(s, 5)
    if head.len != 5 { return 3 }
    if head != "hello" { return 4 }
    let tail = teko::str::slice_from(s, 6)
    if tail.len != 5 { return 5 }
    if tail != "world" { return 6 }
    0
}

/**
 * AliasCorpusS — an alias of `str` (0.3.1.0 raiz A, crumb R0): the layout predicate
 * (`typeexpr_is_fat`) used to answer this ANNOTATION directly, matching neither its `[]T` nor its
 * bare-`str` arm, while the store predicate (`is_fat_type`) always saw the field VALUE's resolved
 * type — `str` — through the alias. `AliasCorpusHolder` measures the two predicates' disagreement
 * on the SAME field (raiz-comum memo §7-quater.3-bis).
 */
type AliasCorpusS = str

/**
 * AliasCorpusHolder — the aliased field FIRST, a plain `i64` sibling SECOND — exactly the byte
 * range `field_layout_size`'s 8-vs-16-byte disagreement let the fat field's length half spill
 * into.
 */
type AliasCorpusHolder = struct { s: AliasCorpusS; n: i64 }

/**
 * f_alias_fat_field — construct `AliasCorpusHolder` with a 5-byte aliased `str` field and a
 * sibling `n` set to a value distinct from that length, then assert every half reads back
 * correctly: the aliased field's `.len` and content, AND that the sibling was not corrupted by
 * the aliased field's own store.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_alias_fat_field() -> i64 {
    let h = AliasCorpusHolder { s = "abcde"; n = 41 }
    if h.n != 41 { return 1 }
    if h.s.len != 5 { return 2 }
    if h.s != "abcde" { return 3 }
    0
}

/**
 * f_int_to_str — `teko::u64_to_str`/`teko::i64_to_str`, both `(iNN) -> str` (fat) (0.3.1.0 degrau
 * 12 / raiz-comum §R5): before this degrau, `native_builtin_symbol` had no entry for either bare
 * name, so a DIRECT call honest-stopped ("builtin `u64_to_str` not yet lowered") — first surfaced
 * through `teko::backend::reg_ref`'s own body, on the compiler's own self-build. The runtime's
 * out-parameter-length twins (`tk_u64_to_str_len`/`tk_i64_to_str_len`) already existed (built at
 * degrau 9) and were already reachable through `$"…{n}…"` STRING INTERPOLATION's own hardcoded
 * call — this fixture calls both builtins BARE, the path that was missing, and checks the
 * returned DIGITS (not merely that the build succeeds), including the two signed extremes whose
 * magnitude computation is the one place `tk_i64_to_str` could overflow if done naively.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_int_to_str() -> i64 {
    if teko::u64_to_str(0) != "0" { return 1 }
    if teko::u64_to_str(42) != "42" { return 2 }
    let u64_max: u64 = 18446744073709551615
    if teko::u64_to_str(u64_max) != "18446744073709551615" { return 3 }
    if teko::i64_to_str(0) != "0" { return 4 }
    if teko::i64_to_str(42) != "42" { return 5 }
    if teko::i64_to_str(-42) != "-42" { return 6 }
    let i64_max: i64 = 9223372036854775807
    if teko::i64_to_str(i64_max) != "9223372036854775807" { return 7 }
    let i64_min: i64 = -9223372036854775808
    if teko::i64_to_str(i64_min) != "-9223372036854775808" { return 8 }
    0
}

/**
 * gcd_subtract — Euclidean GCD by repeated subtraction, structured to mirror
 * `teko::backend::idom_intersect`'s (`src/backend/stackify.tks`) own shape EXACTLY: the function's
 * LAST statement is a bare `loop { … }` that never `break`s — every exit is an inner `return` —
 * around two NESTED loops that each DO `break`, one per "finger" walked toward the other. This is
 * the shape that stopped native lowering at 0.3.1.0 degrau 13: `lower_tail_non_expr`
 * (`src/lir/lower.tks`) treated a non-`return`-terminated tail as an internal invariant break,
 * when `lower_loop` always reports `terminated=false` for ANY loop (break or not) — the checker
 * itself makes NO claim about a non-expression tail (`check_trailing_value`'s own doc: "the guard
 * against false-rejecting a body that ends in a diverging loop/if/match"), trusting the programmer
 * exactly as the C emitter already does (`cg_stmt_c_terminates` + `__builtin_unreachable()`,
 * `codegen.tks:8659-9013`).
 *
 * @param x  the first operand (positive)
 * @param y  the second operand (positive)
 * @return   gcd(x, y)
 */
fn gcd_subtract(x: i64, y: i64) -> i64 {
    mut a = x
    mut b = y
    loop {
        if a == b { return a }
        loop { if a <= b { break }; a = a - b }
        loop { if b <= a { break }; b = b - a }
    }
}

/**
 * f_loop_tail_no_break — `gcd_subtract`'s own breakless-loop-tail shape, exercised by VALUE (not
 * merely "does it compile"): three GCD pairs, including the x==y edge (the outer loop's FIRST
 * iteration already satisfies `a == b`, so the two inner loops never run at all).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_loop_tail_no_break() -> i64 {
    if gcd_subtract(30, 18) != 6 { return 1 }
    if gcd_subtract(17, 5) != 1 { return 2 }
    if gcd_subtract(9, 9) != 9 { return 3 }
    0
}

/**
 * strip_leading_hash_lines — `gcd_subtract`'s breakless-loop-tail shape, one axis over
 * (scalar -> FAT): the LAST statement is a bare `loop { … }` that never `break`s, every exit an
 * inner `return`, but this function returns `str` instead of `i64` — the exact shape
 * `src/build/regression.tks::snippet_chunk_skip_attr_lines` uses in the compiler's own source.
 * Degrau 13 closed the scalar axis (`lower_tail_non_expr` falling back to `diverging_tail_value`);
 * the FAT axis (`lower_tail_non_expr_fat`) honest-stopped unconditionally until 0.3.1.0 degrau 20,
 * because a fat-typed if-expr-arm/function-body tail that only diverges through inner `return`s
 * never actually produces a (ptr, len) pair of its own to fall through with.
 *
 * Strips every leading line that starts with `#` (one per line, `\n`-terminated) off `text`,
 * returning whatever remains.
 *
 * @param text  the input, `\n`-joined lines
 * @return      `text` with every leading `#`-prefixed line removed
 */
fn strip_leading_hash_lines(text: str) -> str {
    mut rest = text
    loop {
        if rest.len == 0 || rest[0] != b'#' { return rest }
        mut k: u64 = 0
        loop {
            if k >= rest.len { break }
            if rest[k] == b'\n' { break }
            k = k + 1
        }
        if k >= rest.len { return "" }
        rest = teko::str::slice(rest, k + 1, rest.len)
    }
}

/**
 * f_fat_loop_tail_no_break — `strip_leading_hash_lines`'s own breakless-loop-tail shape,
 * exercised by VALUE (not merely "does it compile"): no leading `#` line, one, two consecutive
 * ones, an all-`#` input with no trailing newline (the `return ""` exit), and the empty string
 * (the FIRST loop iteration already satisfies the exit test, mirroring `f_loop_tail_no_break`'s
 * own x==y edge).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_fat_loop_tail_no_break() -> i64 {
    if strip_leading_hash_lines("hello") != "hello" { return 1 }
    if strip_leading_hash_lines("#a\nhello") != "hello" { return 2 }
    if strip_leading_hash_lines("#a\n#b\nhello") != "hello" { return 3 }
    if strip_leading_hash_lines("#a") != "" { return 4 }
    if strip_leading_hash_lines("") != "" { return 5 }
    0
}

/** GBox<T> — a one-field generic wrapper, the shape `parser::Parsed<T>` (asm_parse's own return
 * payload) is: a plain generic struct, never a variant/enum in its own right. */
type GBox<T> = struct { value: T }

/**
 * make_gbox_i64 — a `GBox<i64> | error` producer: the exact union shape
 * `parser::parse_main_file` returns (`Parsed<MainFile> | error`), instantiated with `i64` so this
 * fixture needs no second file.
 *
 * @param ok  true to construct the payload, false to return the error arm
 * @return    `GBox<i64>` when `ok`, else an `error`
 */
fn make_gbox_i64(ok: bool) -> GBox<i64> | error {
    if !ok { return error { message = "no" } }
    GBox<i64> { value = 99 }
}

/**
 * make_gbox_str — the SAME generic union, instantiated with `str` instead — a second
 * instantiation of `GBox`'s base, exercised alongside `make_gbox_i64` to prove the case-name
 * resolution reads the SUBJECT'S OWN member list rather than remembering the last instance seen.
 *
 * @param ok  true to construct the payload, false to return the error arm
 * @return    `GBox<str>` when `ok`, else an `error`
 */
fn make_gbox_str(ok: bool) -> GBox<str> | error {
    if !ok { return error { message = "no" } }
    GBox<str> { value = "hi" }
}

/**
 * f_generic_variant_match — a `match` over a `Generic<T> | error` union: the exact shape
 * `teko::build::asm_parse` needed (`parser::Parsed<parser::MainFile> as x => x.node; error as e =>
 * return e`, 0.3.1.0 degrau 14). A generic instance's RESOLVED case is a mangled instance name
 * (`GBox__g__i64`), never the pattern's bare base (`GBox`) — the case-name lookup must recover the
 * base from the mangled name, not compare it verbatim. Two DIFFERENT instantiations (`i64`, `str`)
 * plus the `error` arm, checked by VALUE.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_generic_variant_match() -> i64 {
    match make_gbox_i64(true) {
        GBox<i64> as b => { if b.value != 99 { return 1 } }
        error => return 2
    }
    match make_gbox_i64(false) {
        GBox<i64> as b => return 3
        error as e => { if e.message != "no" { return 4 } }
    }
    match make_gbox_str(true) {
        GBox<str> as b => { if b.value != "hi" { return 5 } }
        error => return 6
    }
    match make_gbox_str(false) {
        GBox<str> as b => return 7
        error as e => { if e.message != "no" { return 8 } }
    }
    0
}

/**
 * f_last_index_of — `teko::str::last_index_of(str, str) -> u64 | error` (0.3.1.0 degrau 15 /
 * raiz-comum §R5): before this degrau, `native_builtin_symbol` had no entry for this bare name at
 * all, so a reached call honest-stopped ("builtin `last_index_of` not yet lowered") — first
 * surfaced through `teko::build::basename`'s own body. Unlike the degrau 11/12 families
 * (`bool`/`str` results), this builtin's REAL C ABI (`tk_rt_last_index_of`) returns a genuine
 * 2-eightbyte `{bool ok; uint64_t value}` struct, and its DECLARED Teko return type is a
 * `u64 | error` VARIANT — neither fat nor a plain scalar — so it needed its own bool-branch +
 * variant-wrapper construction (`lower_last_index_of_call`), not a resolver-table entry alone.
 * Checked by VALUE across the found/not-found/empty-needle/repeated-match axes, plus the
 * not-found arm's own message (empty, per this builtin's own "not-found is the only failure"
 * contract).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_last_index_of() -> i64 {
    match teko::str::last_index_of("hello world", "o") {
        u64 as i => { if i != 7 { return 1 } }
        error => return 2
    }
    match teko::str::last_index_of("hello world", "xyz") {
        u64 as i => return 3
        error as e => { if e.message != "" { return 4 } }
    }
    match teko::str::last_index_of("hello world", "") {
        u64 as i => { if i != 11 { return 5 } }
        error => return 6
    }
    match teko::str::last_index_of("aaa", "a") {
        u64 as i => { if i != 2 { return 7 } }
        error => return 8
    }
    0
}

/**
 * f_str_of_bytes — `teko::str_of_bytes([]byte) -> str` (fat) (0.3.1.0 degrau 16 / raiz-comum §R5):
 * found immediately after closing degrau 15's own `last_index_of` gap, while enumerating
 * `native_builtin_symbol`'s remaining holes — `str`/`str_of_bytes` (ONE checker registration, two
 * spellings, `checker/scope.tks`) had no entry either, first surfaced through
 * `teko::build::sanitize_ident`'s own body. Unlike `last_index_of`, this builtin's shape fits the
 * ESTABLISHED out-parameter-length molde exactly (`tk_str_of_bytes_len`, the SAME
 * `lower_len_out_call` shape `builtin_str_slice_symbol`/`builtin_int_to_str_symbol` already use) —
 * a resolver-table entry alone, no new lowering arm. Checked by VALUE, including the empty-slice
 * edge (a zero-length `str`, not a null/garbage pointer).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_of_bytes() -> i64 {
    let bs: []byte = [b'h', b'i', b'!']
    let s = str_of_bytes(bs)
    if s.len != 3 { return 1 }
    if s != "hi!" { return 2 }
    let empty: []byte = []
    let es = str_of_bytes(empty)
    if es.len != 0 { return 3 }
    if es != "" { return 4 }
    0
}

/**
 * f_host_info — `teko::os`/`teko::arch`/`teko::env::version`, all `() -> str` (fat), plus
 * `teko::mem::peak_rss() -> u64` (plain scalar) (0.3.1.0 degrau 17 / raiz-comum §R5): found while
 * closing degrau 15/16's own sibling search — the compiler's own `teko::build::target_os` calls
 * `os`/`arch` bare, immediately past the `str_of_bytes` gap. The three `str`-returning ones fit
 * the SAME out-parameter-length molde `str_of_bytes` does (`tk_rt_os_len`/`tk_rt_arch_len`/
 * `tk_rt_version_len`); `peak_rss` fits the ordinary scalar path directly (a whole 64-bit
 * register, no out-parameter needed at all). Checked against the KNOWN closed sets these
 * compile-time-constant strings draw from (never a host-specific literal, so the fixture stays
 * portable across the hosts this backend targets), a plausibly-bounded version-string LENGTH
 * (this project's own `own_native.tkp` declares no `version` field, so `teko::env::version()`
 * legitimately returns EMPTY here — the same on BOTH routes; measured, not assumed — so the
 * check is an upper bound, not "non-empty"), and a plausibly-bounded peak RSS (`u64` can never
 * read negative — the sanity check is an UPPER bound instead, ruling out a garbage/uninitialized
 * read).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_host_info() -> i64 {
    let os = teko::os()
    if os != "linux" && os != "macos" && os != "windows" && os != "unknown" { return 1 }
    let arch = teko::arch()
    if arch != "x86_64" && arch != "arm64" && arch != "unknown" { return 2 }
    let ver = teko::env::version()
    if ver.len > 64 { return 3 }
    let rss = teko::mem::peak_rss()
    if rss > 1099511627776 { return 4 }
    0
}

/**
 * RdPoint — the aggregate `ref`-deref target `f_ref_deref_assign` exercises: this backend
 * represents a struct VALUE as the address of its own storage (§ NATIVE-AGG-SLICE-BY-ADDRESS), so
 * writing `p.value = RdPoint { … }` through a `Ref<RdPoint>` must `memcpy` the new instance's bytes
 * into the handle's pointee storage rather than store the new instance's OWN address there — the
 * one write shape a struct/class field assignment never needed (a field's aggregate half is a
 * BOXED pointer slot; a reference's is not).
 *
 * @field x  the first coordinate
 * @field y  the second coordinate
 */
type RdPoint = struct { x: i64; y: i64 }

/**
 * rd_bump_scalar — write THROUGH a scalar `Ref<u64>` handle (0.3.1.0 degrau 18): `n.value` is
 * read back before being incremented, so a stale/garbage load (rather than the caller's true
 * current value) would drift the result away from the fixture's own expectation.
 *
 * @param n  the caller's counter, incremented in place
 */
fn rd_bump_scalar(ref n: u64) -> void {
    n.value = n.value + 1
}

/**
 * rd_bump_point — write THROUGH an aggregate `Ref<RdPoint>` handle: the new value is built from
 * the CURRENT one (`p.x`/`p.y`, read through the same handle) and stored back whole, proving both
 * that a read through the handle sees the caller's live fields and that the write lands on the
 * caller's OWN storage (not a fresh, disconnected copy).
 *
 * @param p  the caller's point, replaced in place
 */
fn rd_bump_point(ref p: RdPoint) -> void {
    p.value = RdPoint { x = p.x + 1; y = p.y * 2 }
}

/**
 * rd_set_msg — write THROUGH a FAT `Ref<str>` handle: a `mut str` local is UNCONDITIONALLY
 * frame-slot-bound the moment it is declared (the list-builtin degrau, independent of `ref`), so
 * the auto-ref call site must pass THAT slot's address — not the string's own content pointer —
 * or the write lands on the wrong memory entirely.
 *
 * @param s  the caller's message, replaced in place
 * @param v  the new message
 */
fn rd_set_msg(ref s: str, v: str) -> void {
    s.value = v
}

/**
 * rd_tick_fn — the EXACT shape of `teko::build::checker_tick_fn` (0.3.1.0 degrau 18's own
 * blocking construct): two `ref` parameters captured by a returned LAMBDA, each written through
 * `.value =` on every call. The caller's two `mut` locals must observe every write made through
 * the closure, arbitrarily long after `rd_tick_fn` itself has returned.
 *
 * @param last   the caller's tick counter, updated to the latest `n`
 * @param total  the caller's total counter, updated to the latest `m`
 * @return       a closure the caller invokes per tick
 */
fn rd_tick_fn(ref last: u64, ref total: u64) -> (u64, u64) -> void {
    (n: u64, m: u64) => {
        last.value = n
        total.value = m
    }
}

/**
 * rd_loop_sum — write THROUGH a scalar `Ref<u64>` handle from INSIDE a `loop`, stressing the
 * merge machinery a scalar reference's own address must survive unchanged across (its ADDRESS is
 * loop-invariant; only the memory it points to changes on each iteration).
 *
 * @param acc  the caller's running sum, accumulated in place
 * @param n    the exclusive upper bound of the `0..n` range summed
 */
fn rd_loop_sum(ref acc: u64, n: u64) -> void {
    mut i: u64 = 0
    loop {
        if i >= n { break }
        acc.value = acc.value + i
        i = i + 1
    }
}

/**
 * f_ref_deref_assign — reference deref-assignment (0.3.1.0 degrau 18): `ref` parameters and the
 * `.value =` write-through they admit, across every memory shape this backend gives a value
 * (scalar, aggregate, fat) plus the CAPTURED-BY-A-RETURNED-CLOSURE shape the compiler's own
 * `checker_tick_fn` needed to self-build. Every check compares against the VALUE the write was
 * supposed to produce (never merely "did it compile") — a write that reached the wrong address
 * would silently corrupt one of these checks instead of leaving it looking like a pass.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_ref_deref_assign() -> i64 {
    mut n: u64 = 5
    rd_bump_scalar(n)
    if n != 6 { return 1 }
    rd_bump_scalar(n)
    if n != 7 { return 2 }
    mut p = RdPoint { x = 1; y = 2 }
    rd_bump_point(p)
    if p.x != 2 { return 3 }
    if p.y != 4 { return 4 }
    rd_bump_point(p)
    if p.x != 3 { return 5 }
    if p.y != 8 { return 6 }
    mut s: str = "a"
    rd_set_msg(s, "hello")
    if s.len != 5 { return 7 }
    if s != "hello" { return 8 }
    rd_set_msg(s, "hi")
    if s.len != 2 { return 9 }
    if s != "hi" { return 10 }
    mut last: u64 = 0
    mut total: u64 = 0
    let tick = rd_tick_fn(last, total)
    tick(3, 10)
    if last != 3 { return 11 }
    if total != 10 { return 12 }
    tick(7, 20)
    if last != 7 { return 13 }
    if total != 20 { return 14 }
    mut acc: u64 = 0
    rd_loop_sum(acc, 5)
    if acc != 10 { return 15 }
    0
}

/**
 * f_static_format_spec — a STATIC interpolation format spec (`$"{v:F2}"`), whose LEADING
 * character selects one of `emit_interp`'s own ten runtime `tk_fmt_*` families (`codegen.tks`,
 * the oracle this backend's lowering mirrors) (0.3.1.0 degrau 19): before this degrau,
 * `lower_interp_hole_fat`'s `TFSpecStatic` arm honest-stopped UNCONDITIONALLY ("static
 * interpolation format spec not yet lowered"), first surfaced through the compiler's own
 * `teko::build::arith_cast_rate_line` (`{pct:F2}%`).
 *
 * `pct` there is `f64`, and a FLOAT static spec DOES lower correctly at this backend's own N1
 * stage (measured directly: `$"{x:F2}"` on an `f64` produces a `call @tk_fmt_f_len(...)` LIR
 * shape identical in kind to the integer families below, `lwt_lowers_static_float_family_spec_…`
 * in `src/lir/lower_test.tkt`) — but it cannot yet RUN here: every float value still
 * honest-stops at the pre-existing, unrelated `isel x86-64: B1-fp` epic the moment it needs an
 * XMM register, regardless of format specs. This fixture, which MUST build and run on both
 * routes, therefore checks every INTEGER-hole family the static spec accepts: `d` (zero-padded
 * decimal, explicit AND default width), `x`/`X` (hex, both cases), `b` (binary), and `n`
 * (thousands separator on an int) — plus the two coercion edges `codegen.tks`'s own dispatch
 * commits to (a SIGNED negative value through the ALWAYS-`uint64_t` `x`/`b` cast, and an
 * UNSIGNED value through the ALWAYS-`int64_t` `d` cast) — every one BY VALUE, expected strings
 * cross-checked against `examples/regressions/bulk/src/q080_format_spec_families/body.tks`
 * (the SAME families, proven correct on the C/VM routes already).
 *
 * Every hole is a `mut` local, never reassigned — the SAME fold-opaque idiom `f_arith` itself
 * established at the top of this file — so the check exercises the RUNTIME lowering and not the
 * comptime folder, which already renders every one of these integer families byte-identical on
 * a bare literal (`checker::comptime_fold`'s own `cf_static_spec_ok`).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_static_format_spec() -> i64 {
    mut n: i64 = 255
    if $"{n:D5}" != "00255" { return 1 }
    if $"{n:D}" != "255" { return 2 }
    if $"{n:X}" != "FF" { return 3 }
    if $"{n:x}" != "ff" { return 4 }
    if $"{n:b}" != "11111111" { return 5 }
    mut big: i64 = 1234567
    if $"{big:N}" != "1,234,567" { return 6 }
    mut neg: i64 = -1
    if $"{neg:X}" != "FFFFFFFFFFFFFFFF" { return 7 }
    if $"{neg:b}" != "1111111111111111111111111111111111111111111111111111111111111111" { return 8 }
    mut u: u64 = 10
    if $"{u:D3}" != "010" { return 9 }
    if $"{u:X}" != "A" { return 10 }
    0
}

/**
 * f_dynamic_format_spec — a DYNAMIC interpolation format spec (`$"{v:[spec]}"`, the spec text
 * itself a RUNTIME `str` argument), the sibling of `f_static_format_spec` this degrau closed in
 * the SAME wagon: `lower_interp_hole_fat`'s `TFSpecDynamic` arm honest-stopped the same way, and
 * closes the same way — `lower_interp_hole_dynamic_fat` flattens the hole's value plus the spec
 * string's (ptr, len) pair through one of the three `tk_fmt_dyn_*_len` twins, split only by the
 * hole's own numeric family. This project's own source never writes a dynamic spec (searched:
 * `examples/regressions/bulk`'s own `q080_format_spec_families` is the only user in the whole
 * tree, and it targets the C/VM routes only), so THIS fixture is the first to exercise it
 * natively — the same INTEGER-family subset `f_static_format_spec` covers (the float family
 * being blocked by the SAME pre-existing `B1-fp` epic, not a gap of this degrau's own), each
 * spec string itself a `mut` local so neither the VALUE nor the SPEC TEXT can be folded away.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_dynamic_format_spec() -> i64 {
    mut n: i64 = 255
    mut spec_d5: str = "D5"
    if $"{n:[spec_d5]}" != "00255" { return 1 }
    mut spec_x_up: str = "X"
    if $"{n:[spec_x_up]}" != "FF" { return 2 }
    mut spec_x_lo: str = "x"
    if $"{n:[spec_x_lo]}" != "ff" { return 3 }
    mut spec_b: str = "b"
    if $"{n:[spec_b]}" != "11111111" { return 4 }
    mut big: i64 = 1234567
    mut spec_n: str = "N"
    if $"{big:[spec_n]}" != "1,234,567" { return 5 }
    mut u: u64 = 10
    if $"{u:[spec_x_up]}" != "A" { return 6 }
    0
}

/**
 * ces_char_word — a `char` produced by a CALL, so the equality's operands are not both literals
 * the folder could have collapsed before the backend ever saw them (mirrors `str_eq_word`'s own
 * reasoning, one line up in this file, for the `char` sibling).
 *
 * @param n  the switch selecting the codepoint (0 = `a`, 1 = `b`, anything else = `a` again)
 * @return   the selected codepoint
 */
fn ces_char_word(n: i64) -> char {
    if n == 0 { return c'a' }
    if n == 1 { return c'b' }
    c'a'
}

/**
 * f_char_and_slice_equality — `char ==`/`!=` and `[]T ==`/`!=` lowered natively (0.3.1.0
 * igualdade-char-slice), mirroring `f_str_equality`'s own shape one function above.
 *
 * `char` had NO comparison at all: the C route's raw `==` rejected a `tk_char` struct outright
 * (`invalid operands to binary ==`), and the native route's `lower_compare` asked `prim_kind_of`
 * for `char`'s PrimKind and found none (a `char` here is a `{ptr,len}` VIEW, not a fixed-width
 * scalar). `[]T == []T` had the SAME hole for every element type — even `[]i64` — because
 * `emit_compare`'s content-equality detour only ever checked for `str`.
 *
 * `[]T` NOW COMPARES BY VALUE, mirroring **Go** (owner ruling 2026-07-29): same length AND every
 * element equal, element-by-element — Go compares a slice by value with no ceremony, and Teko has
 * no derived `PartialEq` a Rust-shaped alternative would need. This corpus member does NOT
 * construct its `[]T` operands by returning an array LITERAL across a function boundary — that
 * crosses an UNRELATED, pre-existing native-backend gap (an array literal's backing store is a
 * STACK alloca in the producing function's own frame, which a SUBSEQUENT call is free to reuse,
 * dangling the first result's content the moment a second fat-returning call runs before the
 * first is dereferenced; found while writing this fixture, reported rather than fixed here, since
 * it is not a comparison defect — a bare `.len` read or a same-function-scope compare never
 * triggers it, which is why every operand below is either a same-function local or a `char`
 * (a plain scalar in this backend, never stack-escaped).
 *
 * The rows mirror `f_str_equality`'s own list, generalized to two more shapes: two EQUAL values,
 * two DIFFERENT values (last element only, so a prefix-only compare would lie), a shorter vs a
 * longer value (so a length-only compare would still need the content check to fail correctly),
 * the empty pair, and multi-byte content (`café🐝` — U+00E9 then U+1F41D, 2 and 4 UTF-8 bytes) so
 * a byte-width assumption cannot silently pass.
 *
 * @return 0 when every comparison answers correctly, else the number of the failing check
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn f_char_and_slice_equality() -> i64 {
    if !(ces_char_word(0) == ces_char_word(0)) { return 1 }
    if ces_char_word(0) == ces_char_word(1) { return 2 }
    if ces_char_word(0) != ces_char_word(0) { return 3 }
    if !(ces_char_word(0) != ces_char_word(1)) { return 4 }
    if !(c'é' == c'é') { return 5 }
    if c'é' == c'🐝' { return 6 }
    if !(c'é' != c'🐝') { return 7 }

    let ints_a = [1, 2, 3]
    let ints_b = [1, 2, 3]
    let ints_c = [1, 2, 4]
    let ints_d = [1, 2, 3, 4]
    let ints_empty_1: []i64 = []
    let ints_empty_2: []i64 = []
    if !(ints_a == ints_b) { return 8 }
    if ints_a == ints_c { return 9 }
    if ints_a == ints_d { return 10 }
    if !(ints_a != ints_c) { return 11 }
    if !(ints_empty_1 == ints_empty_2) { return 12 }
    if ints_empty_1 == ints_a { return 13 }

    let strs_a = ["café🐝", "beta"]
    let strs_b = ["café🐝", "beta"]
    let strs_c = ["café🐝", "betb"]
    let strs_d = ["café🐝", "beta", "gamma"]
    let strs_empty_1: []str = []
    let strs_empty_2: []str = []
    if !(strs_a == strs_b) { return 14 }
    if strs_a == strs_c { return 15 }
    if strs_a == strs_d { return 16 }
    if !(strs_a != strs_c) { return 17 }
    if !(strs_empty_1 == strs_empty_2) { return 18 }
    if strs_empty_1 == strs_a { return 19 }

    let chars_a = [c'c', c'a', c'f', c'é', c'🐝']
    let chars_b = [c'c', c'a', c'f', c'é', c'🐝']
    let chars_c = [c'c', c'a', c'f', c'e']
    if !(chars_a == chars_b) { return 20 }
    if chars_a == chars_c { return 21 }
    if !(chars_a != chars_c) { return 22 }
    0
}

/**
 * f_bytes_of_str — `teko::text::bytes_of_str(str) -> []byte` (fat, zero-copy) (0.3.1.0 degrau 21 /
 * raiz-comum §R5): `native_builtin_symbol` had no entry for this bare name at all, so a reached
 * call honest-stopped ("builtin `bytes_of_str` not yet lowered") — first surfaced through this
 * project's own standalone probe (`docs/memory/text-bytes-escape-hatch-0.3.1.0.md`), not through
 * the compiler's own self-build. Fits the ESTABLISHED out-parameter-length molde exactly
 * (`tk_bytes_of_str_len`, the SAME `lower_len_out_call` shape `builtin_str_of_bytes_symbol`
 * already uses for its own reverse direction) — a resolver-table entry alone, no new lowering arm.
 *
 * Checked by VALUE with `café🐝` (an accented letter, 2 UTF-8 bytes, plus an emoji, 4 bytes,
 * beside two 1-byte ASCII letters) — the sonda this whole lane's docs measure by, so a
 * length/boundary bug cannot hide behind an all-ASCII fixture — plus the empty-string edge (a
 * zero-length view, not a null/garbage pointer).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_bytes_of_str() -> i64 {
    let s = "café🐝"
    let bs = teko::text::bytes_of_str(s)
    if bs.len != 9 { return 1 }
    if str_of_bytes(bs) != s { return 2 }
    let empty = ""
    let ebs = teko::text::bytes_of_str(empty)
    if ebs.len != 0 { return 3 }
    0
}

/**
 * f_str_from_utf8 — `teko::text::str_from_utf8([]byte) -> str | error` (0.3.1.0 degrau 21 /
 * raiz-comum §R5): the fat-payload sibling of degrau 15's `last_index_of` (`u64 | error`) — its
 * runtime ABI (`tk_ffi_sres`, three eightbytes) does not fit this backend's single-result-register
 * `LCall` either, so it needed its own bool-branch + variant-wrapper construction
 * (`lower_str_from_utf8_call`), not a resolver-table entry alone; the ok arm writes a FAT member
 * straight into the wrapper (no boxing — `store_fat_variant_payload_pair`), the error arm boxes an
 * `error { message = … }` the SAME way `last_index_of`'s own not-found arm does.
 *
 * Checked by VALUE across the round-trip (`café🐝`, matching `f_bytes_of_str`'s own sonda so the
 * two fixtures reconcile: `bytes_of_str(s).len == 9` and this round-trip's own decoded `str` equals
 * `s` byte for byte) and the invalid-UTF-8 arm (a lone continuation byte with no lead byte, and a
 * lead byte missing its continuation) — each asserting the EXACT "invalid UTF-8" message the
 * runtime's own `tk_rt_str_from_utf8` constant carries, not merely that the call failed.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_str_from_utf8() -> i64 {
    let s = "café🐝"
    let bs = teko::text::bytes_of_str(s)
    match teko::text::str_from_utf8(bs) {
        str as r => { if r != s { return 1 } }
        error => return 2
    }
    let lone_continuation: []byte = [0x80 to byte, 0x41 to byte]
    match teko::text::str_from_utf8(lone_continuation) {
        str => return 3
        error as e => { if e.message != "invalid UTF-8" { return 4 } }
    }
    let truncated_lead: []byte = [0x41 to byte, 0xE2 to byte, 0x82 to byte]
    match teko::text::str_from_utf8(truncated_lead) {
        str => return 5
        error as e => { if e.message != "invalid UTF-8" { return 6 } }
    }
    0
}

/**
 * f_error_diagnostic_fields — the six readable fields of the built-in `error` (0.3.1.0 degrau
 * 22).
 *
 * Asserts by VALUE what the C route already guarantees through `tk_error_make`: an
 * `error { message = … }` literal has `line`/`col` at `0` and `file`/`expected`/`actual` empty.
 * Before this degrau the native backend modeled only `message`, and reading `line` was a
 * compile-time stop; a grown layout WITHOUT zeroing the other five fields would have read
 * garbage from the fresh frame slot instead — so this fixture asserts the ZERO, not merely that
 * it compiled.
 *
 * The variant-wrapped arm exercises the interaction with the degrau 15/21 24-byte uniform
 * wrapper: the 72-byte payload is boxed by ADDRESS, so the wrapper itself never grows.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_error_diagnostic_fields() -> i64 {
    let e = error { message = "x" }
    if e.line != 0 { return 1 }
    if e.col != 0 { return 2 }
    if e.file != "" { return 3 }
    if e.expected != "" { return 4 }
    if e.actual != "" { return 5 }
    if e.message != "x" { return 6 }
    match mk_error_union() {
        str => return 7
        error as w => {
            if w.line != 0 { return 8 }
            if w.message != "y" { return 9 }
        }
    }
    0
}

/**
 * mk_error_union — a `str | error` that always takes the error member, to exercise the `error`
 * payload boxed inside the 24-byte variant wrapper.
 *
 * @return str|error  always the `error` member
 * @throws  always
 */
fn mk_error_union() -> str | error { error { message = "y" } }

/**
 * f_err_loc — `teko::error::err_loc(error, u32, u32) -> error` (E2, 0.3.1.0 degrau 22): a COPY of
 * its `error` argument with `line`/`col` overwritten.
 *
 * Asserts the adorned copy's three fields by VALUE, AND that the source `error` was NOT mutated
 * (`orig.line`/`orig.col` still `0` after the call) — `tk_error_loc` (`teko_rt.h`) returns a
 * modified copy on the C route, and this backend represents an `error` value by the ADDRESS of
 * its slot, so adorning in place would have mutated the caller's own binding, diverging from the
 * C route silently.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_err_loc() -> i64 {
    let orig = error { message = "boom" }
    let adorned = teko::error::err_loc(orig, 7, 3)
    if adorned.line != 7 { return 1 }
    if adorned.col != 3 { return 2 }
    if adorned.message != "boom" { return 3 }
    if orig.line != 0 { return 4 }
    if orig.col != 0 { return 5 }
    0
}

/**
 * f_err_typed — `teko::error::err_typed(error, str, str) -> error` (E2, 0.3.1.0 degrau 22): a
 * COPY of its `error` argument with `expected`/`actual` overwritten (the fat-field twin of
 * `err_loc`'s two scalar fields).
 *
 * Chains `err_typed(err_loc(e, l, c), exp, act)` — the ONE site in the compiler where the two
 * compose (`surface_at`) — so `line` survives THROUGH the second adornment, and asserts that the
 * `err_loc`-adorned source was NOT further mutated by `err_typed`.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_err_typed() -> i64 {
    let orig = teko::error::err_loc(error { message = "mismatch" }, 11, 4)
    let adorned = teko::error::err_typed(orig, "i64", "str")
    if adorned.expected != "i64" { return 1 }
    if adorned.actual != "str" { return 2 }
    if adorned.line != 11 { return 3 }
    if adorned.message != "mismatch" { return 4 }
    if orig.expected != "" { return 5 }
    if orig.actual != "" { return 6 }
    0
}

/**
 * takes_bool_arg — a variant-member comparison used as a CALL ARGUMENT position: the comparison's
 * bool result flows into an ordinary parameter, exercising the SAME lowering an `if`/`let` site
 * uses but through a call-argument slot.
 *
 * @param b  the already-computed comparison result
 * @return   1 when `b` is true, else 0
 */
fn takes_bool_arg(b: bool) -> i32 {
    if b { 1 } else { 0 }
}

/**
 * eq_null_ret — a variant-member comparison used as a function RETURN position: the comparison's
 * bool result is the function's own trailing (return) value.
 *
 * @param a  an `i32 | null` value to test against `null`
 * @return   whether `a` currently holds `null`
 */
fn eq_null_ret(a: i32 | null) -> bool {
    a == null
}

/**
 * f_variant_member_compare — the `a != null` / `a == null` combinatorics (`i32 | null`,
 * cargo/0.3.1.0-null-adopt): `if`, `let`, call-argument, and return position, over both a PRESENT
 * and an ABSENT (`null`) value, plus the numeric-literal sibling (`a != 5` / `a == 5`) — the same
 * root (`adopt_binop_operands`'s literal retyping) and the same backend lowering (a tagged union's
 * `.tag`/`.as.<key>` comparison) close both.
 *
 * Migrated here from `regressor.tkr`'s `cases/variant_member_compare.tks` (cargo/0.3.1-dissolver-
 * bulk, 2026-07-29): the scenario is a LANGUAGE gap (fails identically on both backend routes, no
 * differential oracle), not a term used in the compiler's OWN product source, so it never actually
 * satisfied the regressor's rule 1 (a regression of a term used in the compiler's own Teko sources
 * lives strictly in `regressor.tkr`) — it sat at the project root only because its two better homes
 * were both unavailable at the time (`bulk` was broken, and this project's own exit-code budget was
 * full). Both obstacles are gone: `bulk` is dissolved and this project's budget now runs past 56.
 *
 * @return 0 on success; a distinct non-zero code names which check diverged
 */
fn f_variant_member_compare() -> i64 {
    let some: i32 | null = 7
    let none: i32 | null = null

    if some == null { return 1 }
    if some != null { } else { return 2 }
    if none != null { return 3 }
    if none == null { } else { return 4 }

    let l1: bool = some != null
    if !l1 { return 5 }
    let l2: bool = none == null
    if !l2 { return 6 }

    if takes_bool_arg(some != null) != 1 { return 7 }
    if takes_bool_arg(none == null) != 1 { return 8 }

    if eq_null_ret(some) { return 9 }
    if !eq_null_ret(none) { return 10 }

    if some != 7 { return 11 }
    if some == 7 { } else { return 12 }

    0
}

/**
 * wide_product — a `u32 * u32` multiply widened through `u64` BEFORE the multiply, so the result
 * cannot overflow the narrower operand width (0.3.1.0 D1 boundary-widen-cast).
 *
 * @param a  the first `u32` factor, cast to `u64` before the multiply
 * @param b  the second `u32` factor, multiplied at `u64` width
 * @return   the full-width `u64` product
 */
fn wide_product(a: u32, b: u32) -> u64 { (a to u64) * b }

/**
 * f_d1_boundary_widen_cast_compiles — a `u32 to u64` widening cast used as the LHS of a multiply
 * against a bare `u32` RHS compiles and lowers correctly (0.3.1.0 D1 audit, migrated from `bulk`'s
 * `q185_d1_boundary_widen_cast_compiles`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the low byte of the product is wrong
 */
fn f_d1_boundary_widen_cast_compiles() -> i64 {
    if (wide_product(7 to u32, 6 to u32) & 255) != 42 { return 1 }
    0
}

/**
 * spread_di — a `u32`-to-`i64` cast pair used identically at an ARITHMETIC site (the subtraction)
 * and a COMPARISON site (the `<`) over the SAME two operands — the D1 audit's parity check: before
 * the shared predicate, the arithmetic site compiled and the comparison site was a hard error.
 *
 * @param a  the minuend/left comparison operand, cast to `i64`
 * @param b  the subtrahend/right comparison operand, cast to `i64`
 * @return   42 when the subtraction is negative AND the comparison agrees it is; else 0
 */
fn spread_di(a: u32, b: u32) -> i64 {
    let d = (a to i64) - (b to i64)
    if d < 0 && (a to i64) < (b to i64) { return 42 }
    0
}

/**
 * f_d1_cast_pair_parity — the arithmetic-site/comparison-site D1 cast pair agree over the same
 * operands (0.3.1.0 D1 audit, migrated from `bulk`'s `q186_d1_cast_pair_parity_between_arith_and`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 42 on success (matching the original fixture's own asserted value)
 */
fn f_d1_cast_pair_parity() -> i64 {
    spread_di(1 to u32, 2 to u32)
}

/**
 * bump_through — forwards an exclusive `ref` PARAMETER into a second, LOCAL `ref` binding over the
 * SAME referent type, then writes through the forwarded ref. The LEGITIMATE `ref`-to-`ref` forward
 * (same referent type) must keep compiling — the shape the original wagon shipped without a
 * fixture for, which is why the missing `type_eq` check went unnoticed (0.3.1.0 audit A-S3/B-S3).
 *
 * @param p  the caller's `i64` referent, forwarded through a second local `ref`
 */
fn bump_through(ref p: i64) -> void {
    ref q: i64 = p
    q = 42
}

/**
 * probe_mcni — drives `bump_through` over a local `mut` and reads back the write-through.
 *
 * @return the referent's value after `bump_through` (42 on success)
 */
fn probe_mcni() -> i64 {
    mut n: i64 = 1
    bump_through(n)
    n
}

/**
 * f_ref_forwarding_same_referent_compiles — a `ref` parameter forwarded into a second local `ref`
 * over the same referent type compiles and writes through correctly (migrated from `bulk`'s
 * `q187_ref_forwarding_same_referent_compiles`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 42 on success (matching the original fixture's own asserted value)
 */
fn f_ref_forwarding_same_referent_compiles() -> i64 {
    probe_mcni()
}

/**
 * f_tilde_concat — the `~` string-concatenation operator over every string-literal FORM this
 * corpus spells: plain, raw (`@"..."`), verbatim-multiline (`@"""..."""`), interpolated (`$"..."`),
 * interpolated-multiline, raw-interpolated (`$@"..."`), and combinations with no interpolation
 * holes at all — each concatenated with a plain literal so the operator's own lowering runs at
 * every producer shape (migrated from `bulk`'s `q189_tilde_concat`, cargo/0.3.1-dissolver-bulk
 * 2026-07-29). Several of the literals below are multi-line: their CONTENT is measured by this
 * check, so re-indenting them changes the expected sum.
 *
 * @return 0 on success, 1 if the summed length of every concatenation disagrees with the fixture's
 *         own measured total (198)
 */
fn f_tilde_concat() -> i64 {
    let x = "hello"
    let y = "world"
    let a = "lit" ~ "eral" ~ "-fold"
    let b = x ~ " " ~ y
    let c = "pre-" ~ "fix-" ~ x ~ "-suf" ~ "-fix"

    let name = "world"
    let m1 = "foo" ~ "bar"
    let m2 = @"C:\raw" ~ "-tail"
    let m3 = """multi
line""" ~ "-tail"
    let m4 = @"""verbatim
multi""" ~ "-tail"
    let m5 = $"hi {name}" ~ "!"
    let m6 = $"""hi
{name}""" ~ "!"
    let m7 = $@"raw {name}\n" ~ "!"
    let m8 = $@"""raw
{name}""" ~ "!"
    let m9 = "pre-" ~ @"""mid
part""" ~ name ~ "-post"
    let m10 = $"no holes here" ~ "-tail"
    let m11 = $@"""no holes
multiline""" ~ "-tail"

    let total = a.len + b.len + c.len + m1.len + m2.len + m3.len + m4.len + m5.len + m6.len + m7.len + m8.len + m9.len + m10.len + m11.len
    if total != 198 { return 1 }
    0
}

/**
 * grow_bridge — grow `x` by appending `v`, mutating `x` IN-PLACE through the exclusive mutable
 * reference `ref x` (0.3.1 adoption — a byte-identical LOCAL copy of `teko::list::grow`; the
 * compiler-tree stdlib symbol is not addressable from a user project, so the fixture re-declares
 * the contract). Write-through preserves value semantics: `push` is a checker builtin whose
 * argument typing does not yet auto-deref a bare `ref` argument, so the read stays explicit
 * `x.value` (still legal — only the `Ref<T>` type name is hidden, not the accessor).
 *
 * @param x  the target slice, referenced mutably and exclusively (`ref x`)
 * @param v  the element to append, of the slice's concrete `T`
 */
fn grow_bridge<T>(ref x: []T, v: T) -> void {
    x.value = teko::list::push(x.value, v)
}

/**
 * f_list_grow_bridge — a generic `ref`-taking helper grows a slice write-through, in place
 * (migrated from `bulk`'s `q190_list_grow_bridge`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_list_grow_bridge() -> i64 {
    mut x: []i64 = [1, 2]
    grow_bridge(x, 3)
    if x.len != 3 { return 1 }
    if x[0] != 1 { return 1 }
    if x[1] != 2 { return 1 }
    if x[2] != 3 { return 1 }
    0
}

/**
 * arena_budget_sum — a fn carrying `#arena_size(4096)`, the additive, non-`unsafe` per-function
 * arena-budget directive (0.3.1 SW1 crumb `#453`). Its own frame region opens as an INDEPENDENT
 * tree root (`tk_region_new(NULL)`), never a child of the shared process root — the owner's
 * isolate-boundary ruling (2026-07-27): a function that declares its own arena is its own isolation
 * boundary, "como se fosse outro programa" (as if it were another program). The workload below (an
 * 8-element list, summed) allocates well under the declared 4096-byte budget: sizing accuracy is
 * the DEVELOPER's job by ruling — the compiler only wires the declared number through, it never
 * infers one.
 *
 * @return the deterministic sum the driver checks (0+1+…+7 == 28)
 */
#arena_size(4096)
fn arena_budget_sum() -> i64 {
    mut xs: []i64 = teko::list::empty()
    mut i: i64 = 0
    loop {
        if i >= 8 { break }
        xs = teko::list::push(xs, i)
        i = i + 1
    }
    mut total: i64 = 0
    mut j: u64 = 0
    loop {
        if j >= xs.len { break }
        total = total + xs[j]
        j = j + 1
    }
    total
}

/**
 * f_arena_size_directive_ok — `#arena_size(N)` wires an independent per-function arena budget
 * through to the runtime, and ordinary list accumulation inside it still round-trips correctly
 * (migrated from `bulk`'s `q200_arena_size_directive_ok`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the accumulated sum disagrees with the expected 28
 */
fn f_arena_size_directive_ok() -> i64 {
    if arena_budget_sum() != 28 { return 1 }
    0
}

/**
 * pub extern unsafe fn c_abs — the frontier's spelling PARSES, CHECKS, LINKS, and RUNS (0.3.1.0
 * C0, c-types-and-marshalling-0.3.1.md §4), pinning the doc-comment correction at
 * `src/parser/parse_decl.tks::consume_unsafe_modifier`: `extern` is consumed FIRST, `unsafe` is
 * consumed second and threads `is_unsafe` through to the `Function` node unchanged. Migrated from
 * `bulk`'s `q191_c_extern_unsafe_accepted` (cargo/0.3.1-dissolver-bulk, 2026-07-29) — the first
 * fixture in this tree to mark a raw-libc extern `unsafe` and prove the marker survives to a
 * linked, running binary.
 *
 * @param x  the value to negate before taking its absolute value
 * @return   `abs(x)`, computed by the linked libc symbol
 */
pub extern unsafe fn c_abs(x: i32) -> i32 = "abs"

/**
 * f_c_extern_unsafe_accepted — `pub extern unsafe fn … = "sym"` parses, checks, links and runs
 * (migrated from `bulk`'s `q191_c_extern_unsafe_accepted`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the linked `abs` call disagrees with the expected magnitude
 */
fn f_c_extern_unsafe_accepted() -> i64 {
    let negated: i32 = -42
    if c_abs(negated) != 42 { return 1 }
    0
}

/** A LOCAL COPY of `teko::c_types`'s `c_int` alias (`docs/design/c-types-and-marshalling-0.3.1.md`
    §5.1, crumb C1) — a regression fixture cannot `use` the compiler's own stdlib. */
pub type c_int = i32

/** See `c_int`'s doc-comment — the unsigned 8-bit twin under test here. */
pub type c_uchar = u8

/** See `c_int`'s doc-comment — the 64-bit twin under test here. */
pub type c_ulonglong = u64

/**
 * round_trip_int — receives and returns the `c_int` alias unchanged — the §2.1 measurement this
 * fixture exists to bank: no alias to a bare PRIMITIVE existed anywhere in the corpus before this
 * design, and the resolution path (`resolve_named` -> `builtin_type`) is mechanically identical to
 * an alias targeting a slice/union/named type but was, until now, unproven.
 *
 * @param i  passed straight through
 * @return   the same value, unchanged
 */
fn round_trip_int(i: c_int) -> c_int {
    i
}

/** See `round_trip_int` — the `u8` twin. */
fn round_trip_uchar(u: c_uchar) -> c_uchar {
    u
}

/** See `round_trip_int` — the `u64` twin. */
fn round_trip_ulonglong(n: c_ulonglong) -> c_ulonglong {
    n
}

/**
 * f_c_types_alias_identity — a value assigned THROUGH each of three `c_types` aliases (spanning
 * sign and width: `c_int`/`c_uchar`/`c_ulonglong`) and back is unchanged, and each alias is exactly
 * its aliased primitive — no wider, no narrower (migrated from `bulk`'s
 * `q192_c_types_alias_identity`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the round-tripped total disagrees with the expected 7
 */
fn f_c_types_alias_identity() -> i64 {
    let i: c_int = 5
    let u: c_uchar = 2
    let n: c_ulonglong = 0
    let ri = round_trip_int(i)
    let ru = round_trip_uchar(u)
    let rn = round_trip_ulonglong(n)
    let total: i32 = ri + ru + (rn to i32)
    if total != 7 { return 1 }
    0
}

/**
 * f_qualified_optional_cross_ns — same-bare-name types (`aa::Thing`/`bb::Thing`) coexist across
 * namespaces in optional and named-variant position (issues #109/#149; migrated from `bulk`'s
 * `p_qualified_optional`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 22
 */
fn f_qualified_optional_cross_ns() -> i64 {
    if qualified_optional_ns::scenario() != 22 { return 1 }
    0
}

/**
 * f_member_const_cross_ns_pub_inherit — a `pub` member const reaches across namespaces through an
 * inheriting subclass declared in a DIFFERENT namespace (issue #594 crumb 7; migrated from `bulk`'s
 * `p_member_const_cross_ns_pub_inherit`, cargo/0.3.1-dissolver-bulk 2026-07-29). `Base` lives in
 * this project's ROOT namespace and `Sub` in `sub`, so the boundary the assertion depends on is a
 * real one — with a single namespace the claim would be vacuous.
 *
 * @return 0 on success, a distinct non-zero code per failing check
 */
fn f_member_const_cross_ns_pub_inherit() -> i64 {
    let s = sub::Sub::make(7)
    if sub::reach() != 5 { return 1 }
    if s.kind() != 7 { return 2 }
    0
}

/**
 * f_same_bare_method_dispatch — classes sharing the SAME bare name `Svc` across namespaces
 * (`sbmd_left`, `sbmd_right`, plus the sorted-first `aaa_decoy` poison decoy) dispatch an INSTANCE
 * method to the canonically-namespaced class, never to a readdir-order same-bare collision (issue
 * #290; migrated from `bulk`'s `p_same_bare_method_dispatch`, cargo/0.3.1-dissolver-bulk
 * 2026-07-29).
 *
 * @return 0 on success, 1 if the dispatched tags disagree with the expected sum (10)
 */
fn f_same_bare_method_dispatch() -> i64 {
    if same_bare_method_dispatch_ns::scenario() != 10 { return 1 }
    0
}

/**
 * f_native_gate_coercions — the restored `native_gate_coercions` regressive (#265; migrated from
 * `bulk`'s `native_gate`, cargo/0.3.1-dissolver-bulk 2026-07-29): a bare `[]T` into a `[](T | null)`
 * PARAM (element-wise present-wrap), the same into a struct FIELD, and `~` on a sub-`int` unsigned
 * prim, re-narrowed to its own width.
 *
 * @return 0 on success, 1 if the scenario's own falling-off-the-end value disagrees with 21
 */
fn f_native_gate_coercions() -> i64 {
    if native_gate::scenario() != 21 { return 1 }
    0
}

/** Point_iface — a plain two-field struct, the F3 null-union matrix's STRUCT shape. */
type Point_iface = struct {
    /** the point's first coordinate. */
    x: i64
    /** the point's second coordinate. */
    y: i64
}

/**
 * sum_or — narrow a `Point_iface | null`, summing its two fields when present.
 *
 * @param p         the value to narrow
 * @param fallback  the value to use when `p` is `null`
 * @return          `p.x + p.y` when present, else `fallback`
 */
fn sum_or(p: Point_iface | null, fallback: i64) -> i64 {
    match p { Point_iface as v => v.x + v.y; null => fallback }
}

/**
 * f_null_union_struct_present_and_absent — the F3 null-union matrix's STRUCT shape, both a
 * present and an absent (`null`) value narrowed through the same `match` (migrated from `bulk`'s
 * `q002_struct_point_null_present_and_absent`, cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_null_union_struct_present_and_absent() -> i64 {
    let present: Point_iface | null = Point_iface { x = 10; y = 20 }
    let absent: Point_iface | null = null
    if sum_or(present, 0) + sum_or(absent, 12) != 42 { return 1 }
    0
}

/** Counter_mcni — a one-field class with an instance method, the F3 null-union matrix's CLASS shape. */
type Counter_mcni = class {
    /** the counter's current value. */
    pub n: i64

    /**
     * make — build a `Counter_mcni` at value `v`.
     *
     * @param v  the initial value
     * @return   a fresh `Counter_mcni`
     */
    pub fn make(v: i64) -> Counter_mcni { Counter_mcni { n = v } }

    /**
     * bump — the instance method a null-union narrow must be able to dispatch through.
     *
     * @param self  the receiver
     * @return      `self.n + 1`
     */
    pub fn bump(self) -> i64 { self.n + 1 }
}

/**
 * bump_or — narrow a `Counter_mcni | null`, dispatching its instance method when present.
 *
 * @param c         the value to narrow
 * @param fallback  the value to use when `c` is `null`
 * @return          `c.bump()` when present, else `fallback`
 */
fn bump_or(c: Counter_mcni | null, fallback: i64) -> i64 {
    match c { Counter_mcni as v => v.bump(); null => fallback }
}

/**
 * f_null_union_class_present_and_absent — the F3 null-union matrix's CLASS shape, both a present
 * and an absent (`null`) value narrowed through the same `match`, dispatching an instance method on
 * the present arm (migrated from `bulk`'s `q003_class_counter_null_present_and_absent`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_null_union_class_present_and_absent() -> i64 {
    let present: Counter_mcni | null = Counter_mcni::make(9)
    let absent: Counter_mcni | null = null
    if bump_or(present, 0) + bump_or(absent, 32) != 42 { return 1 }
    0
}

/** Point_mcni — a plain two-field struct, distinct from `Point_iface` (the FORWARD shape's own type). */
type Point_mcni = struct {
    /** the point's first coordinate. */
    x: i64
    /** the point's second coordinate. */
    y: i64
}

/**
 * maybe_point — returns a null-union WITHOUT narrowing it first: the caller receives the raw
 * `Point_mcni | null` and must narrow it itself (the "forward an un-narrowed return" shape).
 *
 * @param present  when true, returns a present `Point_mcni`; else `null`
 * @return         `Point_mcni { x = 21; y = 21 }` when `present`, else `null`
 */
fn maybe_point(present: bool) -> Point_mcni | null {
    if present { return Point_mcni { x = 21; y = 21 } }
    null
}

/**
 * read_or — narrow a `Point_mcni | null`, summing its two fields when present.
 *
 * @param p         the value to narrow
 * @param fallback  the value to use when `p` is `null`
 * @return          `p.x + p.y` when present, else `fallback`
 */
fn read_or(p: Point_mcni | null, fallback: i64) -> i64 {
    match p { Point_mcni as v => v.x + v.y; null => fallback }
}

/**
 * f_forward_un_narrowed_null_union_return — a function's null-union RETURN value is forwarded to
 * its caller un-narrowed, and narrowing happens only at the call site — both over a present and an
 * absent value (migrated from `bulk`'s `q007_forward_an_un_narrowed_null_union_retu`,
 * cargo/0.3.1-dissolver-bulk 2026-07-29).
 *
 * @return 0 on success, 1 if the summed readings disagree with the expected 42
 */
fn f_forward_un_narrowed_null_union_return() -> i64 {
    if read_or(maybe_point(true), 0) + read_or(maybe_point(false), 0) != 42 { return 1 }
    0
}

/**
 * f_match_value_literal_join — a `match`-as-value whose arms mix a CASE-bound concrete leaf with
 * a bare numeric-literal leaf: `type_match`'s literal cross-adoption (mirroring `type_if`'s own,
 * `src/checker/typer.tks`) must retype the literal leaf at the concrete sibling's type instead of
 * defaulting it to `i64`, so the whole match joins to ONE scalar type rather than an accidental
 * `i32 | i64` union no int-position accepts. Covers the reported shape (`i32 as n => n; null =>
 * 0`, both the present and the absent leg), the arm order REVERSED (the literal arm first), and a
 * literal that does NOT fit the anchor (which must still form a genuine union, never silently
 * collapse to the anchor's type).
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_match_value_literal_join() -> i64 {
    let present: i32 | null = 7
    let r = match present { i32 as n => n; null => 0 }
    if r != 7 { return 1 }
    let absent: i32 | null = null
    let s = match absent { i32 as n => n; null => 0 }
    if s != 0 { return 2 }
    let reordered: i32 | null = 3
    let t = match reordered { null => 0; i32 as n => n }
    if t != 3 { return 3 }
    let misfit: u8 | null = null
    let u: u8 | i64 = match misfit { u8 as n => n; null => 999 }
    let uval = match u { u8 as x => x to i64; i64 as y => y }
    if uval != 999 { return 4 }
    0
}

/**
 * f_array_lit_literal_join — an ARRAY LITERAL whose elements mix a typed concrete leaf with a
 * bare numeric-literal leaf: `type_array_lit`'s literal cross-adoption (the exact twin of
 * `type_match`'s, `src/checker/typer.tks`) must retype the literal leaf at the concrete sibling's
 * type instead of defaulting it to `i64`, so the array joins to ONE element type rather than an
 * accidental `i32 | i64` union no int-position accepts. Covers the reported shape (`[n, 0]`) and
 * the order REVERSED (`[0, n]`).
 *
 * A literal that does NOT fit the anchor (e.g. `[u8_val, 999]`) is deliberately NOT exercised
 * here: the resulting `[]<u8 | i64>` needs a slice whose ELEMENT is a general (non-null) variant,
 * which neither backend can build today — the C route honest-stops at codegen
 * ("optional/slice inner type not yet supported") on `[a, b]` for ANY two concretely-typed
 * siblings, with no literal involved at all, so a misfit-literal case here would fail the whole
 * corpus for a reason that has nothing to do with this fix. Confirmed by an out-of-tree probe
 * instead: the checker still builds the genuine `u8 | i64` union (unchanged from before this
 * fix) rather than silently collapsing it into `u8`.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_array_lit_literal_join() -> i64 {
    let n: i32 = 7
    let xs = [n, 0]
    if xs[0] != 7 { return 1 }
    if xs[1] != 0 { return 2 }
    let ys = [0, n]
    if ys[0] != 0 { return 3 }
    if ys[1] != 7 { return 4 }
    0
}

/**
 * dv_shape_or_err — a bare `DvShape` case constructed DIRECTLY into a `DvShape | error` slot: the
 * exact shape 0.3.1.0 degrau 23 closes (`checker::func_type`'s own `-> Type | error`, `Type` itself
 * a named variant). `DvShape` is a UNION MEMBER here, not the function's own bare return type, so a
 * bare `DvCircle`/`DvSquare`/`DvTri` flows past TWO levels of union before reaching a case a `match`
 * can bind by name: this level's own tag (is it the `DvShape` case or `error`?), then `DvShape`'s
 * OWN tag (which of its three cases?).
 *
 * @param n  0 for the error case, 1 for a circle, 2 for a square, anything else for a triangle
 * @return   the constructed value, or its `error` case
 */
fn dv_shape_or_err(n: i64) -> DvShape | error {
    if n == 0 { return error { message = "dv nested" } }
    if n == 1 { return DvCircle { r = 5 } }
    if n == 2 { return DvSquare { s = 6 } }
    DvTri { t = 7 }
}

/**
 * f_declared_variant_nested_alias — 0.3.1.0 degrau 23: a bare case constructed straight into an
 * OUTER slot whose union member is ITSELF a declared variant (`DvShape`) is tagged, and read back,
 * by its OWN case — not by the leaf's raw bytes misread as the alias's own tag.
 *
 * THE MISCOMPILATION THIS CLOSES, IN TWO LAYERS. The native backend used to fail to even COMPILE
 * this shape ("value's type is not a member of its declared variant (internal)" —
 * `variant_member_index_of`/`variant_member_type_matches` matched a `Named` member by EXACT name
 * only, so a value nested one alias deep never matched). Widening that match to recurse into the
 * alias's own members closed the compile-time stop, but on its own would have left a DEEPER wrong
 * answer standing: it would have stored the leaf's OWN raw address as the outer payload directly,
 * so a later `match` against the alias's OWN cases (`DvCircle`/`DvSquare`/`DvTri`) would have read
 * the leaf struct's own first FIELD as if it were the alias's tag — a SILENT wrong branch, not a
 * stop, confirmed by disassembling the equivalent two-level scratch repro. The fix instead builds
 * a NESTED wrapper (the alias's own tag+payload) and boxes THAT as the outer payload, so both
 * levels read back correctly.
 *
 * @return 0 when every case round-trips through both match levels, else the number of the failing
 *         check
 */
fn f_declared_variant_nested_alias() -> i64 {
    match dv_shape_or_err(0) {
        error as e => { if e.message != "dv nested" { return 1 } }
        DvShape as s => { return 2 }
    }
    match dv_shape_or_err(1) {
        error as e => { return 3 }
        DvShape as s => match s {
            DvCircle as c => { if c.r != 5 { return 4 } }
            DvSquare as sq => { return 5 }
            DvTri as t => { return 6 }
        }
    }
    match dv_shape_or_err(2) {
        error as e => { return 7 }
        DvShape as s => match s {
            DvCircle as c => { return 8 }
            DvSquare as sq => { if sq.s != 6 { return 9 } }
            DvTri as t => { return 10 }
        }
    }
    match dv_shape_or_err(3) {
        error as e => { return 11 }
        DvShape as s => match s {
            DvCircle as c => { return 12 }
            DvSquare as sq => { return 13 }
            DvTri as t => { if t.t != 7 { return 14 } }
        }
    }
    0
}

/**
 * array_lit_i64_a — the FIRST of a pair of scalar-element array-literal producers
 * (`array_lit_return_escape`, 0.3.1.0 array-literal-escape): a fresh `[]i64` built and returned
 * directly, never touching `teko::list::push`.
 *
 * @return a 3-element `[]i64`
 */
fn array_lit_i64_a() -> []i64 { [10, 20, 30] }

/**
 * array_lit_i64_b — the SECOND scalar-element array-literal producer: called right after
 * `array_lit_i64_a`, before that first call's result is read, so its own callee frame is the one
 * whose reuse must not corrupt the first result (0.3.1.0 array-literal-escape).
 *
 * @return a 3-element `[]i64`, disjoint from `array_lit_i64_a`'s
 */
fn array_lit_i64_b() -> []i64 { [40, 50, 60] }

/**
 * array_lit_str_a — the FAT-element twin of `array_lit_i64_a`: each element is itself a
 * `{ptr, len}` pair, so its storage carries two words per slot instead of one.
 *
 * @return a 3-element `[]str`
 */
fn array_lit_str_a() -> []str { ["un", "deux", "trois"] }

/**
 * array_lit_str_b — the FAT-element twin of `array_lit_i64_b`, called immediately after
 * `array_lit_str_a` and before that call's result is read.
 *
 * @return a 3-element `[]str`, disjoint from `array_lit_str_a`'s
 */
fn array_lit_str_b() -> []str { ["one", "two", "three"] }

/**
 * array_lit_i64_empty — the empty array literal, returned directly: its backing storage is
 * zero bytes wide, the degenerate case the same escape fix must not regress (an empty literal's
 * pointer is never dereferenced, since every read of it is guarded by `.len`).
 *
 * @return an empty `[]i64`
 */
fn array_lit_i64_empty() -> []i64 { [] }

/**
 * f_array_lit_return_escape — a function that RETURNS a fresh array literal must hand the caller
 * storage that survives past the callee's own frame (0.3.1.0 array-literal-escape): the native
 * backend once built an array literal's backing bytes in an `alloca`, the CALLEE's OWN frame slot,
 * so a SECOND call issued before the FIRST call's result was read reused that same stack memory —
 * the first result silently read back the second call's bytes, no crash, no stop. Exercises the
 * scalar (`[]i64`) element case, the FAT (`[]str`) element case, and the empty literal, each pair
 * of producer calls issued before either result is read.
 *
 * @return i64  0 on success, a distinct non-zero code per failing check
 */
fn f_array_lit_return_escape() -> i64 {
    let ia = array_lit_i64_a()
    let ib = array_lit_i64_b()
    if ia.len != 3 { return 1 }
    if ia[0] != 10 { return 2 }
    if ia[1] != 20 { return 3 }
    if ia[2] != 30 { return 4 }
    if ib.len != 3 { return 5 }
    if ib[0] != 40 { return 6 }
    if ib[1] != 50 { return 7 }
    if ib[2] != 60 { return 8 }
    let sa = array_lit_str_a()
    let sb = array_lit_str_b()
    if sa.len != 3 { return 9 }
    if sa[0] != "un" { return 10 }
    if sa[1] != "deux" { return 11 }
    if sa[2] != "trois" { return 12 }
    if sb.len != 3 { return 13 }
    if sb[0] != "one" { return 14 }
    if sb[1] != "two" { return 15 }
    if sb[2] != "three" { return 16 }
    let e = array_lit_i64_empty()
    if e.len != 0 { return 17 }
    0
}

/**
 * f64_bits_of — the raw IEEE-754 bit pattern (as `u64`) of one of THREE runtime-selected `f64`
 * magnitudes, including a NEGATIVE one (the sign bit set) — built from a plain integer `tag`
 * rather than an `f64` literal/ALU op/compare, since every other path onto an `f64` value is the
 * SEPARATE `B1-fp` honest-stop family (`isel_x86_64.tks`) this fixture does not exercise; only
 * `f64_bits`/`f64_from_bits` (0.3.1.0 degrau 24) themselves are under test here.
 *
 * @param tag  0 selects 3.0's bits, 1 selects 2.0's, anything else selects -2.0's
 * @return     the selected magnitude's bit pattern
 */
fn f64_bits_of(tag: i64) -> u64 {
    if tag == 0 { return 4613937818241073152 }
    if tag == 1 { return 4611686018427387904 }
    13835058055282163712
}

/**
 * f_f64_bits_roundtrip — 0.3.1.0 degrau 24: `teko::f64_bits`/`teko::f64_from_bits` round-trip
 * THREE runtime bit patterns through `f64` and back, with every producer VALUE kept LIVE AT THE
 * SAME TIME as its siblings (`a`/`b`/`c` are all still needed when the LAST `f64_bits` reads its
 * own value back) — the exact shape that would have SILENTLY read the WRONG value back had either
 * builtin lowered to a real call to its `tk_f64_bits`/`tk_f64_from_bits` runtime twin instead: with
 * no `f64`-class argument/return handling yet (`pin_args_x86`/`select_call_result_x86`, both still
 * GPR-only pending `B1-fp`), a real call would have carried the value through the single physical
 * XMM0 register, so a SECOND live `f64` would silently clobber the first the moment it was
 * produced — a measured scratch repro confirmed exactly that corruption. The fix instead lowers
 * both builtins as a bare VReg alias (no call at all), so ordinary register allocation — which
 * already keeps any number of plain integer values alive correctly — carries every one of
 * `a`/`b`/`c` to its own read-back untouched.
 *
 * @return 0 when every one of the three round-trips (and the negative sign bit) reads back
 *         correctly, else the number of the failing check
 */
fn f_f64_bits_roundtrip() -> i64 {
    let a = teko::f64_from_bits(f64_bits_of(0))
    let b = teko::f64_from_bits(f64_bits_of(1))
    let c = teko::f64_from_bits(f64_bits_of(2))
    let ba = teko::f64_bits(a)
    let bb = teko::f64_bits(b)
    let bc = teko::f64_bits(c)
    if ba != f64_bits_of(0) { return 1 }
    if bb != f64_bits_of(1) { return 2 }
    if bc != f64_bits_of(2) { return 3 }
    if (bc & 0x8000000000000000) == 0 { return 4 }
    if (ba & 0x8000000000000000) != 0 { return 5 }
    0
}
