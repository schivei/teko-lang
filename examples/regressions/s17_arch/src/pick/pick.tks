#arch("x86_64")
/**
 * pick — the x86_64 arch guard: the surviving definition on an x86_64 target, returning 64.
 *
 * @return  64, the x86_64 arm's identifying value
 */
pub fn pick(): i64 { return 64 }

#arch("arm64")
/**
 * pick — the arm64 arch guard: the surviving definition on an arm64 target, returning 65.
 *
 * @return  65, the arm64 arm's identifying value
 */
pub fn pick(): i64 { return 65 }
