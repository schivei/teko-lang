/**
 * Node — an ABSTRACT polymorphic base with three concrete subclasses, matched with ONE named arm
 * plus an unguarded BIND-ALL that catches every other subclass (match-universal phase 1: a bind-all
 * `Node as rest` is a legal catch-all over an open remainder).
 */
type Node = abstract class {
    /** id — the node's identifier, live on the base. */
    pub id: i64
}

/**
 * Leaf — the concrete subclass the named arm selects.
 */
type Leaf = class Node {
    /** payload — the leaf's own datum. */
    pub payload: i64

    /**
     * make — the static factory for a `Leaf`.
     *
     * @param i  the id
     * @param p  the payload
     * @return   a fresh `Leaf`
     */
    pub static fn make(i: i64, p: i64): Leaf { Leaf { id = i; payload = p } }
}

/**
 * Fork — a concrete subclass caught by the bind-all, not the named arm.
 */
type Fork = class Node {
    /** span — the fork's own datum. */
    pub span: i64

    /**
     * make — the static factory for a `Fork`.
     *
     * @param i  the id
     * @param s  the span
     * @return   a fresh `Fork`
     */
    pub static fn make(i: i64, s: i64): Fork { Fork { id = i; span = s } }
}

/**
 * classify — select `Leaf` by name and catch every other subclass with an unguarded BIND-ALL that
 * binds the whole base value. The bind-all is what makes the match exhaustive here.
 *
 * @param n  the base-typed node
 * @return   the leaf's payload, or the caught node's id
 */
fn classify(n: Node): i64 {
    match n {
        Leaf as l => l.payload
        Node as rest => rest.id
    }
}

/**
 * probe — a `Leaf` reaches the named arm, a `Fork` falls to the bind-all; fold both into a stable
 * token so a mis-routed arm shows as a FAIL token.
 *
 * @return the fixed token when both route correctly, else a FAIL token
 */
fn probe(): str {
    var l: Node = Leaf::make(1, 42)
    var f: Node = Fork::make(7, 99)
    if classify(l) != 42 { return "mu-class-bind-all FAIL-leaf" }
    if classify(f) != 7 { return "mu-class-bind-all FAIL-fork" }
    "mu-class-bind-all OK"
}

println(probe())
