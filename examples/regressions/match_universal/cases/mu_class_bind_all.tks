type Node = abstract class {
    pub id: i64
}

type Leaf = class Node {
    pub payload: i64

    pub static fn make(i: i64, p: i64): Leaf { Leaf { id = i; payload = p } }
}

type Fork = class Node {
    pub span: i64

    pub static fn make(i: i64, s: i64): Fork { Fork { id = i; span = s } }
}

fn classify(n: Node): i64 {
    match n {
        Leaf as l => l.payload
        Node as rest => rest.id
    }
}

fn probe(): str {
    var l: Node = Leaf::make(1, 42)
    var f: Node = Fork::make(7, 99)
    if classify(l) != 42 { return "mu-class-bind-all FAIL-leaf" }
    if classify(f) != 7 { return "mu-class-bind-all FAIL-fork" }
    "mu-class-bind-all OK"
}

println(probe())
