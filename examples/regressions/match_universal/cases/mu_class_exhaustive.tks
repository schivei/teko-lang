/**
 * Shape — an ABSTRACT polymorphic base. A `match` over a `Shape`-typed value is a CLOSED set: its
 * concrete subclasses are the whole discriminand space, so covering each one is exhaustive with NO
 * catch-all (match-universal phase 1).
 */
type Shape = abstract class {
    /** k — a discriminator field carried by every shape (kept live so the base is non-empty). */
    pub k: i64
}

/**
 * Circ — a concrete leaf subclass of `Shape`. Its `tk_vt_Circ_Shape` vtable identifies it inside a
 * base-typed fat pointer, which is what the `Circ as c` arm compares against.
 */
type Circ = class Shape {
    /** r — the circle's radius. */
    pub r: i64

    /**
     * make — the static factory (a class literal is only legal inside the class's own methods).
     *
     * @param v  the radius
     * @return   a fresh `Circ`
     */
    pub static fn make(v: i64): Circ { Circ { k = 1; r = v } }
}

/**
 * Sq — the second concrete leaf subclass of `Shape`.
 */
type Sq = class Shape {
    /** w — the square's side. */
    pub w: i64

    /**
     * make — the static factory for a `Sq`.
     *
     * @param v  the side
     * @return   a fresh `Sq`
     */
    pub static fn make(v: i64): Sq { Sq { k = 2; w = v } }
}

/**
 * area — discriminate a `Shape` over its CLOSED subclass set with NO catch-all: covering `Circ` and
 * `Sq` is exhaustive. Each arm binds the concrete subclass and reads its own field.
 *
 * @param sh  the base-typed shape
 * @return    the shape's area
 */
fn area(sh: Shape): i64 {
    match sh {
        Circ as c => c.r * c.r
        Sq as q => q.w + q.w
    }
}

/**
 * probe — build one `Circ` and one `Sq` behind a `Shape` handle and fold their areas into a stable
 * stdout token; a wrong discrimination shows up as a FAIL token naming the arm.
 *
 * @return the fixed token when both areas read back, else a FAIL token
 */
fn probe(): str {
    var a: Shape = Circ::make(5)
    var b: Shape = Sq::make(3)
    if area(a) != 25 { return "mu-class-exhaustive FAIL-circ" }
    if area(b) != 6 { return "mu-class-exhaustive FAIL-sq" }
    "mu-class-exhaustive OK"
}

println(probe())
