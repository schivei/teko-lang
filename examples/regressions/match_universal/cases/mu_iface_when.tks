/**
 * Speaker — an INTERFACE (an OPEN set: impls may live anywhere), so a `match` over a `Speaker` value
 * REQUIRES an unguarded catch-all. Each concrete impl is identified by its `tk_vt_<Impl>_Speaker`
 * vtable inside the interface fat pointer (match-universal phase 1).
 */
type Speaker = interface {
    /** code — the impl's identifying value. */
    fn code(): i64
}

/**
 * Dog — a concrete class implementing `Speaker`, discriminated by name AND by a `when` value guard.
 */
type Dog = class & Speaker {
    /** n — the dog's datum. */
    pub n: i64

    /**
     * make — the static factory for a `Dog`.
     *
     * @param v  the datum
     * @return   a fresh `Dog`
     */
    pub static fn make(v: i64): Dog { Dog { n = v } }

    /**
     * code — this impl's identifying value.
     *
     * @return `10 + n`
     */
    pub fn code(): i64 { 10 + self.n }
}

/**
 * Cat — a second concrete class implementing `Speaker`, caught by the required catch-all here.
 */
type Cat = class & Speaker {
    /** m — the cat's datum. */
    pub m: i64

    /**
     * make — the static factory for a `Cat`.
     *
     * @param v  the datum
     * @return   a fresh `Cat`
     */
    pub static fn make(v: i64): Cat { Cat { m = v } }

    /**
     * code — this impl's identifying value.
     *
     * @return `20 + m`
     */
    pub fn code(): i64 { 20 + self.m }
}

/**
 * tag — discriminate a `Speaker` value: a GUARDED `Dog` arm (the `when` is the value guard), an
 * unguarded `Dog` arm, and the mandatory unguarded catch-all for the open interface set.
 *
 * @param s  the interface-typed speaker
 * @return   3 for a zero-`n` dog, 1 for any other dog, 9 otherwise
 */
fn tag(s: Speaker): i64 {
    match s {
        Dog as d when d.n == 0 => 3
        Dog as d => 1
        _ => 9
    }
}

/**
 * probe — a zero dog hits the guarded arm, a non-zero dog the unguarded `Dog` arm, a cat the
 * catch-all; fold the three verdicts into a stable token.
 *
 * @return the fixed token when all three route correctly, else a FAIL token
 */
fn probe(): str {
    var d0: Speaker = Dog::make(0)
    var d1: Speaker = Dog::make(5)
    var c: Speaker = Cat::make(0)
    if tag(d0) != 3 { return "mu-iface-when FAIL-guarded" }
    if tag(d1) != 1 { return "mu-iface-when FAIL-dog" }
    if tag(c) != 9 { return "mu-iface-when FAIL-catchall" }
    "mu-iface-when OK"
}

println(probe())
