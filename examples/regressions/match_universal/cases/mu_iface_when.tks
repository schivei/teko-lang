type Speaker = interface {
    fn code(): i64
}

type Dog = class & Speaker {
    pub n: i64

    pub static fn make(v: i64): Dog { Dog { n = v } }

    pub fn code(): i64 { 10 + self.n }
}

type Cat = class & Speaker {
    pub m: i64

    pub static fn make(v: i64): Cat { Cat { m = v } }

    pub fn code(): i64 { 20 + self.m }
}

fn tag(s: Speaker): i64 {
    match s {
        Dog as d when d.n == 0 => 3
        Dog as d => 1
        _ => 9
    }
}

fn probe(): str {
    var d0: Speaker = Dog::make(0)
    var d1: Speaker = Dog::make(5)
    var c: Speaker = Cat::make(0)
    if tag(d0) != 3 { return "mu-iface-when FAIL-guarded" }
    if tag(d1) != 1 { return "mu-iface-when FAIL-dog" }
    if tag(c) != 9 { return "mu-iface-when FAIL-catchall" }
    "mu-iface-when OK"
}

println(probe())
