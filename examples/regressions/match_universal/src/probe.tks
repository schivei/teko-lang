/**
 * MuOne — the first arm of the inertness variant: a one-field struct owned by `MuTri`. The phase-1
 * change must leave a `variant` match discriminating exactly as before, so this anchor stays native.
 */
pub type MuOne = struct {
    /** v — the payload the `MuOne` arm carries. */
    v: i64
}

/**
 * MuTwo — the second arm of the inertness variant: a one-field struct owned by `MuTri`.
 */
pub type MuTwo = struct {
    /** v — the payload the `MuTwo` arm carries. */
    v: i64
}

/**
 * MuTri — a NAMED `variant` over two struct arms. Phase 1 adds class/interface discrimination WITHOUT
 * touching the variant axis, so this match must lower byte-for-byte as it did before the change.
 */
pub type MuTri = variant MuOne | MuTwo

/**
 * variant_probe — discriminate a `MuTri` with a `variant` match (the inertness anchor). Builds a
 * `MuOne` and a `MuTwo`, matches each, and confirms the arm payloads read back — proving the
 * variant/enum match path is unchanged by the match-universal class/interface extension.
 *
 * @return true iff both arms select and read their own payload
 */
pub fn variant_probe(): bool {
    var a: MuTri = MuOne { v = 7 }
    var b: MuTri = MuTwo { v = 9 }
    var ra = match a {
        MuOne as o => o.v
        MuTwo as w => w.v + 100
    }
    var rb = match b {
        MuOne as o => o.v + 100
        MuTwo as w => w.v
    }
    ra == 7 && rb == 9
}
