pub type MuOne = struct {
    v: i64
}

pub type MuTwo = struct {
    v: i64
}

pub type MuTri = variant MuOne | MuTwo

pub fn variant_probe(): bool {
    var a: MuTri = MuOne { v = 7 }
    var b: MuTri = MuTwo { v = 9 }
    var ra = match a {
        MuOne as o => o.v
        MuTwo as w => w.v + 100
    }
    var rb = match b {
        MuOne as o => o.v + 100
        MuTwo as w => w.v
    }
    ra == 7 && rb == 9
}
