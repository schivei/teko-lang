# match_universal.tkr — the match-universal PHASE 1 acceptance channel. `match` becomes a UNIVERSAL
# discriminator: on top of the existing variant/enum axes it now discriminates a sealed CLASS
# hierarchy and an INTERFACE value, additively (`variant` stays fully alive). The variant member is
# NATIVE (the inertness anchor — the variant match must lower exactly as before); the class/interface
# members run down the C route (env TEKO_BACKEND=c), where a base-class/interface value is a fat
# pointer discriminated by its `.vtable` word. The native backend carries no per-object vtable, so its
# fat-pointer dispatch stays the existing N2 honest-stop; that is why these members pin the C route.
# TEST = the printed token, never the exit code (the axis law).

Feature: match universal phase 1 — `match` discriminates class hierarchies and interfaces, additively

  # (mu_variant_match_inert, NATIVE) the phase's inertness anchor: a NAMED `variant` match still
  # selects each arm and reads its payload, proving the class/interface extension left the variant/enum
  # axis byte-identical. NATIVE by construction — no env is declared, so it runs on the default backend.
  Scenario: mu_variant_match_inert — a variant match still discriminates and binds unchanged
    When built and run
    Then stdout pattern = "scenario mu_variant_match_inert: ok"

  # (mu_class_exhaustive, C ROUTE) a `match` over an ABSTRACT base class covers its CLOSED concrete
  # subclass set (`Circ`, `Sq`) with NO catch-all and is accepted as exhaustive; each arm binds the
  # concrete subclass off the base fat pointer and reads its own field.
  Scenario: mu_class_exhaustive — a sealed class hierarchy match is exhaustive with every subclass covered
    Given source = "cases/mu_class_exhaustive.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "mu-class-exhaustive OK"

  # (mu_class_bind_all, C ROUTE) one named arm plus an unguarded BIND-ALL over the base catches every
  # other subclass — the bind-all is the legal catch-all of an open remainder.
  Scenario: mu_class_bind_all — a bind-all over the base catches the remaining subclasses
    Given source = "cases/mu_class_bind_all.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "mu-class-bind-all OK"

  # (mu_iface_when, C ROUTE) an INTERFACE match (an OPEN set) discriminates its impls with a `when`
  # value guard on one arm and the mandatory unguarded catch-all for the open remainder.
  Scenario: mu_iface_when — an interface match discriminates impls with a `when` guard and a catch-all
    Given source = "cases/mu_iface_when.tks"
    Given env = ["TEKO_BACKEND=c"]
    When built and run
    Then stdout pattern = "mu-iface-when OK"
