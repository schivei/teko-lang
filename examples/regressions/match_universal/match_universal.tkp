# examples/regressions/match_universal — the match-universal PHASE 1 acceptance channel. `match`
# discriminates over a sealed CLASS hierarchy and over an INTERFACE value, additively, with `variant`
# fully alive. The NATIVE-route member (`main.tks` + `src/mu/probe.tks`) is a VARIANT match that must
# keep lowering byte-for-byte (the phase's inertness anchor). The class/interface members run down the
# C route (`cases/*.tks`, env TEKO_BACKEND=c): the native backend carries no per-object vtable, so a
# base-class/interface discriminator is a C-backend capability this phase (the native fat-pointer
# dispatch stays the existing N2 honest-stop). TEST = the printed token, never the exit code.
name = "match_universal"
source = "src"

