use teko::checker
use teko::lexer
use teko::parser

/**
 * is_concat_builtin_call — recognizes the checker's OWN `teko::str::concat`/`teko::string::concat`
 * builtin (the LEGISLATED public string-building API, `checker/scope.tks`'s "concat" — resolved
 * by BARE LAST SEGMENT, so any namespace prefix ending in it matches, the same shape
 * `is_list_builtin_call` recognizes its own family by). The checker leaves NO declaration behind
 * for it (`call_ns` stays empty, C7.1a's sibling gap), so without this check it would fall through
 * to the plain mangler and target a symbol no function ever defines (0.3.1.0 degrau 9).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names the concat builtin
 */
fn is_concat_builtin_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "concat"
}

/**
 * lower_concat_call — `teko::str::concat`/`teko::string::concat`(a, b, …): fold the built
 * argument list pairwise through the runtime's out-parameter-length concat (`lower_len_out_call`,
 * `tk_str_concat_len`) — the same unrolled chain `lower_interp_fat` builds over its pieces/holes.
 * The checker's variadic call-site desugar (`checker/scope.tks`'s own doc on `concat`: "N trailing
 * str args… OR an existing []str straight through") packs N EXPLICIT trailing `str` args into ONE
 * `checker::TArrayLit` argument (measured: every call in this project's own source uses that
 * literal spelling — `grep`'d, none pass an existing slice), so `cl.args[0]`'s KIND, not its
 * arity, is what tells the two shapes apart: a `TArrayLit` is the closed, compile-time-known-count
 * shape this degrau unrolls; anything else is the pass-through spelling, which needs a genuine
 * runtime fold over a length known only at RUN time and honest-stops instead of being guessed at.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `str`)
 * @param cl   the call node (its own, checker-packed argument list)
 * @return     the folded (ptr, len) pair — `(0, 0)` for zero elements
 * @throws     when the call's argument is not a `TArrayLit` (the pass-through `[]str` spelling,
 *             out of this degrau's closed shape) or contains a spread element, or propagated from
 *             lowering an element
 */
fn lower_concat_call(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    if cl.args.len == 0 { return lower_list_empty(ctx, e) }
    match cl.args[0].kind {
        checker::TArrayLit as al => lower_concat_elements(ctx, e, al.elements)
        _ => error { message = "native backend N1: `teko::str::concat` over an existing []str slice is not yet lowered (N2)" }
    }
}

/**
 * lower_concat_elements — the pairwise fold `lower_concat_call` runs over a `concat` call's
 * checker-packed element list, once it is known to be the closed (compile-time-known-count)
 * shape.
 *
 * @param ctx       the lowering context
 * @param e         the call expression (its source position)
 * @param elements  the packed argument list, in call order
 * @return          the folded (ptr, len) pair — `(0, 0)` for zero elements
 * @throws          when an element is a spread (`...xs`, a runtime-length contribution this
 *                   degrau's closed shape does not cover), or propagated from lowering an element
 */
fn lower_concat_elements(ctx: LowerCtx, e: checker::TExpr, elements: []checker::TArrayElem) -> LoweredFat | error {
    if elements.len == 0 { return lower_list_empty(ctx, e) }
    if elements[0].is_spread { return error { message = "native backend N1: a spread argument to `teko::str::concat` is not yet lowered (N2)" } }
    mut acc = match lower_fat_expr(ctx, elements[0].expr) { LoweredFat as x => x; error as err => return err }
    mut i: u64 = 1
    loop {
        if i >= elements.len { break }
        if elements[i].is_spread { return error { message = "native backend N1: a spread argument to `teko::str::concat` is not yet lowered (N2)" } }
        let arg = match lower_fat_expr(acc.ctx, elements[i].expr) { LoweredFat as x => x; error as err => return err }
        acc = lower_len_out_call(arg.ctx, "tk_str_concat_len", four_args(acc.ptr, acc.len, arg.ptr, arg.len), e)
        i++
    }
    acc
}

/**
 * is_append_fo_call — recognizes the checker's OWN `teko::mem::append_fo` builtin (the `#148 R2`
 * BULK byte-append, `([]byte, str) -> []byte`, free-old on grow BY DECREE). Resolved by BARE LAST
 * SEGMENT, because that is how the checker itself resolves it: `append_fo` lives in `scope.tks`'s
 * `builtin_fn` table, which keys on the last path segment ALONE, so any prefix ending in the name
 * reaches the same builtin — the SAME shape `is_concat_builtin_call` recognizes its own family by,
 * and for the same reason. A user-DECLARED `append_fo` never reaches here: `lookup_call` wins over
 * the builtin fallback, so the checker leaves a non-empty `call_ns` behind and every call site of
 * this predicate tests `call_ns.len == 0` first (0.3.1.0 degrau 26).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names the bulk byte-append builtin
 */
fn is_append_fo_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "append_fo"
}

/**
 * lower_append_fo_call — `teko::mem::append_fo(dst: []byte, src: str) -> []byte`: the runtime's own
 * bulk byte-append (`tk_append_bytes_fo`, `teko_rt.h`), reached through the ESTABLISHED
 * out-parameter-length convention (`lower_len_out_call`) with both arguments ABI-flattened to their
 * (ptr, len) pairs — `four_args`, byte for byte the shape `lower_concat_elements` already passes to
 * `tk_str_concat_len`, because the two runtime entries take the identical five operands
 * (`a.ptr, a.len, b.ptr, b.len, &out_len`). No runtime entry was added and no new ABI shape was
 * invented: `tk_append_bytes_fo` has been in `teko_rt.c` since `#148 R2` for the retired C emitter's
 * own `cb`, which is the very call site that stopped the native self-build here
 * (`teko::codegen::cb`).
 *
 * **Design reference: Go's `append`.** Its contract is the one this builtin already implements and
 * the one the free-old (`_fo`) decree needs: the RESULT is the only slice valid after the call, the
 * input's buffer may have been grown in place or replaced by a larger copy, and nothing may read
 * the old buffer afterwards. `tk_append_bytes_fo` measures exactly that — in place when `dst` is the
 * live tail with spare capacity, a geometric copy-grow otherwise, and on the copy path the old
 * buffer is dead (parked for reuse; `TEKO_MEM_PARANOID` poisons it instead, so a violated decree
 * fails the gate loudly). Zig's answer — an explicit allocator argument, the CALLER freeing the old
 * buffer — was checked against our surface and does NOT fit it: no allocator value reaches a Teko
 * builtin call, and `teko::mem::free` is a SEPARATE builtin this backend does not lower at all yet
 * (measured, `docs/memory/0.3.1.0-linux-native-first-stop.md`'s degrau-26 family table). Go's
 * one-value-in, one-value-out spelling is what `b = teko::mem::append_fo(b, s)` already is.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `[]byte`)
 * @param cl   the call node (`args[0]` the destination buffer, `args[1]` the appended `str`)
 * @return     the grown buffer as its (ptr, len) pair
 * @throws     on a malformed call (an arity the checker's own fixed signature forbids), or
 *             propagated from lowering either argument as a fat-pointer producer
 */
fn lower_append_fo_call(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    if cl.args.len != 2 { return error { message = "native backend N1: `teko::mem::append_fo` expects (bytes, str) (internal)" } }
    let dst = match lower_fat_expr(ctx, cl.args[0]) { LoweredFat as x => x; error as err => return err }
    let src = match lower_fat_expr(dst.ctx, cl.args[1]) { LoweredFat as x => x; error as err => return err }
    lower_len_out_call(src.ctx, "tk_append_bytes_fo", four_args(dst.ptr, dst.len, src.ptr, src.len), e)
}

/**
 * lower_list_builtin — the checker's OWN generic growth-builtin family (`is_list_builtin_call`:
 * `teko::list::empty`, `teko::list::push`, `teko::mem::push_fo`, `teko::list::with_cap`) lowered to
 * its runtime backing. These calls leave NO declaration behind for the mangler to resolve, so
 * without this arm `call_symbol` honest-stopped on every one of them — the single step that kept
 * the own backend from compiling any program that grows a list, the compiler itself included.
 *
 * `empty()` needs no runtime at all (the empty slice IS the (null, 0) pair); `push`/`push_fo` route
 * to the amortized runtime grow (`slice_push_symbol`), the SAME entry points the retired C emitter
 * targeted, so one buffer-growth policy serves both producers.
 *
 * @param ctx  the lowering context
 * @param e    the builtin call expression (its type carries the concretized `[]T`)
 * @param cl   the call node
 * @return     the grown/empty slice as its (ptr, len) pair
 * @throws     for `teko::list::with_cap` (no compiler source calls it, and its sentinel result type
 *             carries no element width to size the buffer with — a NAMED stop rather than a guess),
 *             or propagated from lowering the base/item
 */
fn lower_list_builtin(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    let last = cl.callee.segments[cl.callee.segments.len - 1].name
    if last == "empty" { return lower_list_empty(ctx, e) }
    if last == "push" || last == "push_fo" { return lower_list_push(ctx, e, cl, slice_push_symbol(last)) }
    error { message = "native backend N1: `teko::list::with_cap` has no native lowering yet (N2)" }
}

/**
 * slice_push_symbol — the runtime grow entry a push spelling targets: the plain amortized
 * `tk_slice_push` for `teko::list::push`, and the free-old-on-grow `tk_slice_push_fo` for the
 * `teko::mem::push_fo` DECREE (the caller asserts the base is a linear chain, so the superseded
 * buffer is parked at the grow). The region-scoped third variant (`tk_slice_push_r`) is NOT
 * selectable here: this backend has no S1 region frames to grow into, so every push is a root push.
 *
 * @param last  the callee path's last segment (`push` or `push_fo`)
 * @return      the runtime symbol the `LCall` targets
 */
fn slice_push_symbol(last: str) -> str {
    if last == "push_fo" { return "tk_slice_push_fo" }
    "tk_slice_push"
}

/**
 * lower_list_empty — `teko::list::empty()`: the empty slice's (ptr, len) pair is a pair of zero
 * constants, with no runtime call and no element type needed. The retired C emitter required a
 * CONCRETE element type here only because it had to spell a struct literal's typename; the own
 * backend's fat pair is type-erased, so a bare sentinel `empty()` lowers just as well as an
 * annotated one.
 *
 * @param ctx  the lowering context
 * @param e    the `empty()` call expression (its source position)
 * @return     the (null, 0) pair
 */
fn lower_list_empty(ctx: LowerCtx, e: checker::TExpr) -> LoweredFat {
    let p = ctx_alloc(ctx)
    let with_ptr = ctx_append(p.ctx, const_int_inst(p.vreg, 0, e.line, e.col))
    let l = ctx_alloc(with_ptr)
    let with_len = ctx_append(l.ctx, const_int_inst(l.vreg, 0, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = p.vreg; len = l.vreg }
}

/**
 * lower_list_push — `teko::list::push(base, item)` / `teko::mem::push_fo(base, item)`: the
 * value-semantics grow-by-one, lowered to the runtime's amortized copy-grow. The runtime takes the
 * item BY ADDRESS and returns the length through an out-parameter (`lower_len_out_call`), so the
 * caller reserves a frame slot sized to the element, stores the item into it, and passes its
 * address + byte size:
 *
 *   `<sym>(base.ptr, base.len, &item, sizeof(elem), &out_len)` -> the grown buffer's pointer
 *
 * A FAT element (`str`/`[]T`, `is_fat_type`) delegates to `lower_fat_element_push`: its item slot
 * holds the two-word `{ptr, len}` pair, at the SAME stride the array literal's store and the index
 * load now share (`elem_byte_stride`, 0.3.1.0 degrau 10). Every other element delegates to
 * `lower_scalar_element_push`.
 *
 * @param ctx  the lowering context
 * @param e    the push call expression (its type is the result `[]T`)
 * @param cl   the call node (`args[0]` the base slice, `args[1]` the item)
 * @param sym  the runtime grow symbol (`slice_push_symbol`)
 * @return     the grown slice's (ptr, len) pair
 * @throws     on a malformed call, on an aggregate element whose byte width this backend cannot pin
 *             (`push_box_bytes`), or propagated from lowering the base/item
 */
fn lower_list_push(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall, sym: str) -> LoweredFat | error {
    if cl.args.len != 2 { return error { message = "native backend N1: `teko::list::push` expects (slice, item) (internal)" } }
    let elem = match push_elem_type(e, cl) { checker::Type as t => t; error as err => return err }
    let base = match lower_fat_expr(ctx, cl.args[0]) { LoweredFat as x => x; error as err => return err }
    if is_fat_type(elem) { return lower_fat_element_push(base, cl.args[1], sym, e) }
    lower_scalar_element_push(base, elem, cl.args[1], sym, e)
}

/**
 * lower_scalar_element_push — the non-fat arm of `lower_list_push`: the item is COERCED INTO THE
 * ELEMENT TYPE (`lower_value_into_type`), never merely lowered — a push is a placement like a
 * binding, an assignment or a return, and a placement into a union slot must build the uniform
 * tag+payload wrapper; lowering the item plainly stored the bare case and left the tag to whatever
 * the fresh storage happened to hold, so reading the element back took an arbitrary arm. That was
 * measurable before degrau 8 on the only union element that reached here at all (a `[]T | error`):
 * the element read back took the `error` arm, silently.
 *
 * A REGISTER-VALUE element (`is_register_value_type`: a primitive or an enum's carrier) is stored
 * into the item slot as it lowers. An AGGREGATE element is BOXED first (`push_box_bytes` /
 * `box_aggregate_value`): what the slice holds for it is an ADDRESS, and the address this backend
 * lowers an aggregate to is a per-INSTRUCTION frame slot, so the aggregate is copied into fresh
 * per-EXECUTION runtime storage and THAT address is pushed (NATIVE-AGG-SLICE-BY-ADDRESS).
 *
 * @param base  the base slice's already-lowered (ptr, len) pair
 * @param elem  the concrete (non-fat) element type
 * @param item  the item expression
 * @param sym   the runtime grow symbol
 * @param e     the push call expression (its source position)
 * @return      the grown slice's (ptr, len) pair
 * @throws      on an aggregate element whose byte width this backend cannot pin
 *              (`push_box_bytes`), or propagated from lowering the item
 */
fn lower_scalar_element_push(base: LoweredFat, elem: checker::Type, item: checker::TExpr, sym: str, e: checker::TExpr) -> LoweredFat | error {
    let box_bytes = match push_box_bytes(elem, base.ctx) { u32 as n => n; error as err => return err }
    let elem_lt = ltype_of(elem, base.ctx.enums)
    if ltype_size(elem_lt) == 0 { return error { message = "native backend N1: `teko::list::push` of a `void`-sized element (internal)" } }
    let lowered = match lower_value_into_type(base.ctx, elem, item) { Lowered as x => x; error as err => return err }
    let boxed = box_aggregate_value(lowered, box_bytes, e)
    let slot = reserve_item_slot(boxed.ctx, ltype_size(elem_lt), ltype_align(elem_lt), e)
    let with_store = ctx_append(slot.ctx, store_inst(slot.vreg, boxed.vreg, elem_lt, e.line, e.col))
    let esz = ctx_alloc(with_store)
    let with_esz = ctx_append(esz.ctx, const_int_inst(esz.vreg, ltype_size(elem_lt) to i64, e.line, e.col))
    lower_len_out_call(with_esz, sym, push_head_args(base, slot.vreg, esz.vreg), e)
}
