use teko::list
use teko::checker

/**
 * region_alloc_store_init — copy the `init` value into the freshly bump-allocated slot at `dst`,
 * the native twin of the C route's `*p = init`: a fat element stores its `{ptr, len}` pair, an
 * aggregate element is bit-copied with `tk_mem_copy` (the same runtime touch every aggregate place
 * copy uses — no LIR memcpy op exists), and a register-class element is a single `store`.
 *
 * @param ctx       the lowering context (positioned after the alloc)
 * @param elem      the element type `T`
 * @param init      the `init` argument expression
 * @param dst       the allocated slot's address VReg
 * @param size_vreg the element-size VReg (reused as `tk_mem_copy`'s width)
 * @param e         the call expression (source position)
 * @return          the advanced context, or a propagated error
 */
fn region_alloc_store_init(ctx: LowerCtx, elem: checker::Type, init: checker::TExpr, dst: u32, size_vreg: u32, e: checker::TExpr) -> LowerCtx | error {
    if is_fat_type(elem) {
        let fo = match lower_fat_expr(ctx, init) { LoweredFat as x => x; error as err => return err }
        return store_fat_slot(fo.ctx, dst, fo, e.line, e.col)
    }
    match aggregate_box_bytes(elem, ctx) {
        u32 => {
            let src = match lower_expr(ctx, init) { Lowered as x => x; error as err => return err }
            ctx_append(src.ctx, void_call_inst("tk_mem_copy", teko::list::push(two_args(dst, src.vreg), size_vreg), false, e.line, e.col))
        }
        null => {
            let v = match lower_expr(ctx, init) { Lowered as x => x; error as err => return err }
            ctx_append(v.ctx, store_inst(dst, v.vreg, ltype_of(elem, ctx.enums), e.line, e.col))
        }
    }
}

/**
 * lower_region_alloc_call — `teko::mem::region_alloc(region: uptr, init: T) -> ptr<T>`: bump-alloc
 * `sizeof(T)` bytes in `region`, copy `init` there, and return the `ptr<T>`. Mirrors
 * `emit_region_alloc` (`codegen.tks:3821`): `p = tk_region_alloc((tk_region*)region, sizeof(T)); *p
 * = init; p`. `sizeof(T)` is `region_alloc_elem_size` of the element read off `e.type` (as the C
 * route reads `p.inner`). Reuses `tk_region_alloc` (`teko_rt.h:150`); adds no runtime.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `ptr<T>`, whence `T`)
 * @param c    the typed call (args[0] = region uptr, args[1] = init)
 * @return     the advanced context + the pointer's VReg, or a propagated error
 * @throws     when `e.type` is not `ptr<T>` (a checker invariant break) or the arity is not 2
 * @since 0.3.1
 */
fn lower_region_alloc_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 2 { return error { message = "native backend N1: `region_alloc` expects exactly two arguments (internal)" } }
    let elem = match region_alloc_elem(e.type) { checker::Type as t => t; error as err => return err }
    let region = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let size = region_alloc_elem_size(elem, region.ctx)
    let szc = ctx_alloc(region.ctx)
    let with_sz = ctx_append(szc.ctx, const_int_inst(szc.vreg, size to i64, e.line, e.col))
    let ptr = ctx_alloc(with_sz)
    let alloc_args = two_args(region.vreg, szc.vreg)
    let with_alloc = ctx_append(ptr.ctx, call_inst(ptr.vreg, "tk_region_alloc", alloc_args, false, e.line, e.col))
    let stored = match region_alloc_store_init(with_alloc, elem, c.args[1], ptr.vreg, szc.vreg, e) { LowerCtx as cc => cc; error as err => return err }
    Lowered { ctx = stored; vreg = ptr.vreg }
}

/**
 * is_mem_free_call — recognizes `teko::mem::free`: the type-directed manual deallocation
 * (`call_ns == "teko::mem"`, `typer.tks:933`). Intercepted in `lower_call` before `call_symbol`,
 * else it emits the undefined symbol `teko_teko__mem__free` — the measured cause of the link gap.
 *
 * @param c  the typed call
 * @return   true iff `c` names `teko::mem::free`
 * @since 0.3.1
 */
fn is_mem_free_call(c: checker::TCall) -> bool {
    is_mem_ns_builtin(c, "free")
}

/**
 * lower_mem_free_call — `teko::mem::free(x) -> void`: reclaim `x`'s heap block and SCRUB the
 * binding, branching on the type of `x` (the checker proved it a mutable variable of a heap type).
 * Mirrors `emit_mem_free`/`emit_region_free` (`codegen.tks:3932-3993`):
 *
 *   * `[]E`           → `tk_free_block(x.ptr, x.len*sizeof(E))`, then scrub `x` to the empty slice;
 *   * region-handle   → `tk_region_drop_subtree(x.<field>)`, then scrub `x.<field>` to 0, where
 *                       `<field>` is `checker::region_handle_field_name` (the same structural probe
 *                       the C route uses, gated by `checker::is_region_handle_name`).
 *
 * The class arm (`tk_region_drop(x->__region)`) has NO native equivalent: the native backend keeps
 * NO per-object `tk_region *` on a class instance (`class_instance_fields` deliberately omits it —
 * native class storage is region-scoped, not per-object freed), so a class `free` cannot mirror the
 * C route without pulling in per-object region retention (residency work, out of this lane). It is a
 * NAMED honest-stop until that arrives; the self-host frees no class instance, so the link is
 * unaffected.
 *
 * The scrub is a write-back to `x`'s place (`lower_addr_of_place` + store), NOT an extra: without it
 * a post-free read (which `#must_free` permits on paths the consume-dataflow does not cover) would
 * return the parked buffer, diverging from C and corrupting `tk_free_block`'s free-list. Reuses
 * `tk_free_block`/`tk_region_drop_subtree` (`teko_rt.h`); adds no runtime.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `void`)
 * @param c    the typed call (args[0] = the mutable place to free)
 * @return     the advanced context (no result VReg — void), or a propagated error
 * @throws     when `arg.type` is neither a slice nor a region handle (a class arm honest-stop, or a
 *             checker-gated shape reaching here as an internal break)
 * @since 0.3.1
 */
fn lower_mem_free_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 { return error { message = "native backend N1: `free` expects exactly one argument (internal)" } }
    let arg = c.args[0]
    match arg.type {
        checker::Slice as sl => lower_free_slice(ctx, arg, sl, e)
        checker::Named as nm => lower_free_named(ctx, arg, nm, e)
        _ => error { message = "native backend N1: `mem::free` on a non-heap type (internal — checker must gate)" }
    }
}

/**
 * lower_free_slice — `mem::free`'s `[]E` arm: park the backing buffer for same-size reuse with
 * `tk_free_block(x.ptr, x.len*sizeof(E))`, then scrub `x` to the empty slice `{0, 0}` written back
 * to its frame slot. Mirrors `emit_mem_free`'s slice arm (`codegen.tks:3935-3947`).
 *
 * @param ctx  the lowering context
 * @param arg  the slice place being freed (a mutable fat local)
 * @param sl   the slice type (its `element` gives the `sizeof(E)` stride)
 * @param e    the call expression (source position)
 * @return     the advanced context (void), or a propagated error
 */
fn lower_free_slice(ctx: LowerCtx, arg: checker::TExpr, sl: checker::Slice, e: checker::TExpr) -> Lowered | error {
    let fo = match lower_fat_expr(ctx, arg) { LoweredFat as x => x; error as err => return err }
    let esz = ltype_size(ltype_of(sl.element, ctx.enums))
    let szc = ctx_alloc(fo.ctx)
    let with_sz = ctx_append(szc.ctx, const_int_inst(szc.vreg, esz to i64, e.line, e.col))
    let bytes = ctx_alloc(with_sz)
    let with_bytes = ctx_append(bytes.ctx, bin_inst(bytes.vreg, LBinOp::IMul, fo.len, szc.vreg, e.line, e.col))
    let with_free = ctx_append(with_bytes, void_call_inst("tk_free_block", two_args(fo.ptr, bytes.vreg), false, e.line, e.col))
    let slot = match lower_addr_of_place(with_free, arg) { Lowered as x => x; error as err => return err }
    let zp = ctx_alloc(slot.ctx)
    let with_zp = ctx_append(zp.ctx, const_int_inst(zp.vreg, 0, e.line, e.col))
    let zl = ctx_alloc(with_zp)
    let with_zl = ctx_append(zl.ctx, const_int_inst(zl.vreg, 0, e.line, e.col))
    let scrubbed = store_fat_slot(with_zl, slot.vreg, LoweredFat { ctx = with_zl; ptr = zp.vreg; len = zl.vreg }, e.line, e.col)
    Lowered { ctx = scrubbed; vreg = 0 to u32 }
}

/**
 * lower_free_named — `mem::free`'s `Named` dispatch: a region handle
 * (`checker::is_region_handle_name`) takes the bulk-drop arm; a class instance is the NAMED
 * honest-stop the native backend owes (no per-object region — see `lower_mem_free_call`).
 *
 * @param ctx  the lowering context
 * @param arg  the place being freed
 * @param nm   the named type of `arg`
 * @param e    the call expression (source position)
 * @return     the advanced context (void), or a propagated error / honest-stop
 */
fn lower_free_named(ctx: LowerCtx, arg: checker::TExpr, nm: checker::Named, e: checker::TExpr) -> Lowered | error {
    if checker::is_region_handle_name(nm.name, ctx.table) { return lower_free_region_handle(ctx, arg, nm, e) }
    error { message = teko::str::concat("native backend N1: `mem::free` of the class instance `", teko::str::concat(nm.name, "` is not lowered in the native backend — a native class carries no per-object region to drop (N2)")) }
}

/**
 * lower_free_region_handle — `mem::free`'s region-handle arm: bulk-drop the handle's whole child
 * subtree with `tk_region_drop_subtree(x.<field>)`, then scrub `x.<field>` to 0 so a later read
 * never re-uses the freed `tk_region *`. Mirrors `emit_region_free` (`codegen.tks:3983-3993`); the
 * handle's sole `uptr` field is `checker::region_handle_field_name` (the same probe that routed
 * here) and its byte offset comes from the registered struct layout.
 *
 * @param ctx  the lowering context
 * @param arg  the handle place being freed (a mutable local of `nm`)
 * @param nm   the handle's named type
 * @param e    the call expression (source position)
 * @return     the advanced context (void), or a propagated error
 */
fn lower_free_region_handle(ctx: LowerCtx, arg: checker::TExpr, nm: checker::Named, e: checker::TExpr) -> Lowered | error {
    let field = checker::region_handle_field_name(nm.name, ctx.table)
    let name = match named_type_name(arg.type) { str as s => s; error as err => return err }
    let layout = match find_struct_layout(ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    let off = match field_offset_of(layout, field) { u32 as o => o; error as err => return err }
    let base = match lower_addr_of_place(ctx, arg) { Lowered as x => x; error as err => return err }
    let faddr = ctx_alloc(base.ctx)
    let with_faddr = ctx_append(faddr.ctx, field_addr_inst(faddr.vreg, base.vreg, off, e.line, e.col))
    let handle = ctx_alloc(with_faddr)
    let with_load = ctx_append(handle.ctx, load_inst(handle.vreg, faddr.vreg, LType::Ptr, e.line, e.col))
    let drop_args = teko::list::push(teko::list::empty(), handle.vreg)
    let with_drop = ctx_append(with_load, void_call_inst("tk_region_drop_subtree", drop_args, false, e.line, e.col))
    let zero = ctx_alloc(with_drop)
    let with_zero = ctx_append(zero.ctx, const_int_inst(zero.vreg, 0, e.line, e.col))
    let scrubbed = ctx_append(with_zero, store_inst(faddr.vreg, zero.vreg, LType::Ptr, e.line, e.col))
    Lowered { ctx = scrubbed; vreg = 0 to u32 }
}
