use teko::checker
use teko::lexer
use teko::parser

/**
 * cast_fit_bounds — the interval a `src`-typed operand must land inside to reach `dst` without
 * losing its value, with the ends the SOURCE cannot leave dropped. An UNSIGNED source never
 * goes below zero, so its floor check is deleted; that is the whole difference between the two
 * carriers the C route names `_s` and `_u`.
 *
 * @param src  the cast operand's PrimKind
 * @param dst  the cast target's PrimKind
 * @return     the interval to guard, with tautological ends already removed
 */
fn cast_fit_bounds(src: checker::PrimKind, dst: checker::PrimKind) -> CastFitBounds {
    let raw = if prim_is_signed_int(dst) { cast_signed_dst_bounds(dst) } else { cast_unsigned_dst_bounds(dst) }
    if prim_is_signed_int(src) { return raw }
    CastFitBounds { has_floor = false; floor = 0; has_ceil = raw.has_ceil; ceil = raw.ceil }
}

/**
 * lower_cast_bound_guard — ONE end of the fit interval: materialize `bound`, compare the
 * operand against it with `op`, and trap into `tk_panic_cast` when the comparison fails.
 *
 * @param ctx    the lowering context
 * @param value  the already-lowered operand VReg to range-check
 * @param op     the comparison that must HOLD (`ICmpGeS` for a floor, `ICmpLeS`/`ICmpLeU` for
 *               a ceiling — the U-variant when the source is unsigned, so a `u64` above
 *               `I64_MAX` is not read as a negative number)
 * @param bound  the interval end, as the LIR's i64 register carrier
 * @param line   the source line of the cast expression
 * @param col    the source column of the cast expression
 * @return       the advanced context, emitting into the block where the bound is proven
 */
fn lower_cast_bound_guard(ctx: LowerCtx, value: u32, op: LBinOp, bound: i64, line: u32, col: u32) -> LowerCtx {
    let b = ctx_alloc(ctx)
    let with_bound = ctx_append(b.ctx, const_int_inst(b.vreg, bound, line, col))
    let c = ctx_alloc(with_bound)
    let with_cmp = ctx_append(c.ctx, bin_inst(c.vreg, op, value, b.vreg, line, col))
    lower_trap_unless(with_cmp, c.vreg, "tk_panic_cast", line, col)
}

/**
 * lower_cast_fit_guard — the compiler-organized guard that makes a NARROWING integer `to` cast
 * fail loud instead of answering with a different number (owner ruling 2026-07-29: *"Uma rule
 * para cast (implícito ou explícito), não pode truncar [...] deve ser feito em runtime (e
 * panicar se overflow)"*). No cast truncates. A `to` whose operand does not fit its destination
 * PANICS; a `to` whose operand does fit keeps its value exactly.
 *
 * WHAT THIS REPAIRS, measured. The guard is not new law — it is `docs/design/cast-width-
 * hygiene-0.3.1.md` §4.1's PHASE16 "checked, fail-loud, no silent truncation" contract, which
 * the C route has honoured all along (`codegen.tks`'s `emit_cast` routes a lossy int->int cast
 * through the runtime's `tk_to_<dst>_<carrier>`, which calls `tk_panic_cast`). This backend had
 * no equivalent: it emitted a bare `Trunc`, and `Trunc` selects a 32-BIT move on both isels.
 * Three wrong answers followed, each a native-only divergence from the C route:
 * `300 to u8` answered 300 (a `u8` holding a value no `u8` represents — the 32-bit move never
 * reaches the 8-bit width), `2^40 to u64` from an `i64` answered 0 (equal widths still picked
 * `Trunc`), and `-5 to i32` answered 4294967291 (the 32-bit move zero-extends where the sign
 * had to survive). All three now panic or keep their value.
 *
 * WHY NO CONVERSION INSTRUCTION IS LEFT BEHIND. Once the guard proves the operand lands inside
 * the destination's own interval, the conversion is the IDENTITY: a value representable in both
 * types has the SAME 64-bit two's-complement bit pattern under both, so there is nothing for an
 * extend or a truncate to change. `lower_int_cast` therefore hands the operand's own VReg
 * straight back, which is also why neither isel needs a new case for this.
 *
 * @param ctx   the lowering context, positioned right after the operand is lowered
 * @param value the already-lowered operand VReg
 * @param src   the cast operand's PrimKind
 * @param dst   the cast target's PrimKind
 * @param line  the source line of the cast expression
 * @param col   the source column of the cast expression
 * @return      the advanced context; unchanged when the pair is a lossless widen (the checker's
 *              `cast_is_lossless_widen` is the single source of truth both routes ask)
 */
fn lower_cast_fit_guard(ctx: LowerCtx, value: u32, src: checker::PrimKind, dst: checker::PrimKind, line: u32, col: u32) -> LowerCtx {
    if checker::cast_is_lossless_widen(src, dst) { return ctx }
    let bounds = cast_fit_bounds(src, dst)
    let ceil_op = if prim_is_signed_int(src) { LBinOp::ICmpLeS } else { LBinOp::ICmpLeU }
    let floored = if bounds.has_floor { lower_cast_bound_guard(ctx, value, LBinOp::ICmpGeS, bounds.floor, line, col) } else { ctx }
    if !bounds.has_ceil { return floored }
    lower_cast_bound_guard(floored, value, ceil_op, bounds.ceil, line, col)
}

/**
 * lower_int_cast — the whole int->int (and `byte`/enum-ordinal) `to` cast: guard the fit, then
 * reuse the operand's own VReg as the result. See `lower_cast_fit_guard` for why the guard is
 * the entire conversion and no extend/truncate instruction survives it.
 *
 * @param operand  the already-lowered operand
 * @param src      the cast operand's PrimKind
 * @param dst      the cast target's PrimKind
 * @param line     the source line of the cast expression
 * @param col      the source column of the cast expression
 * @return         the operand's VReg, reachable only on the path where it fits `dst`
 */
fn lower_int_cast(operand: Lowered, src: checker::PrimKind, dst: checker::PrimKind, line: u32, col: u32) -> Lowered {
    Lowered { ctx = lower_cast_fit_guard(operand.ctx, operand.vreg, src, dst, line, col); vreg = operand.vreg }
}

/** prim_width_of — the bit width of an integer/float PrimKind (bool = 1). Local copy of
    the width table (type.tks's is private to teko::checker). */
fn prim_width_of(k: checker::PrimKind) -> u32 {
    if k == checker::PrimKind::U8 || k == checker::PrimKind::I8 { return 8 }
    if k == checker::PrimKind::U16 || k == checker::PrimKind::I16 { return 16 }
    if k == checker::PrimKind::U32 || k == checker::PrimKind::I32 { return 32 }
    if k == checker::PrimKind::U64 || k == checker::PrimKind::I64 { return 64 }
    if k == checker::PrimKind::F32 { return 32 }
    if k == checker::PrimKind::F64 { return 64 }
    1
}

/**
 * The prefix EVERY symbol that user code declares is emitted under (owner ruling 2026-07-27):
 * user code is `teko_*`, the runtime's builtins are `tk_*`, so the two families are disjoint by
 * construction. `src/codegen/codegen.tks` carries the identical constant for the C backend, and
 * `cgt_mangle_parity_c_and_native` proves the two manglers agree byte for byte.
 */
const TEKO_USER_PREFIX: str = "teko_"

/** mangle_ns — a namespace with every `:` byte rewritten to `_`. */
fn mangle_ns(ns: str) -> str {
    mut xs: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= ns.len { break }
        let ch = if ns[i] == b':' { b'_' } else { ns[i] }
        xs = teko::list::push(xs, ch)
        i++
    }
    str(xs)
}

/** escape_c_keyword — a bare identifier with a trailing `_` when it collides with a C
    keyword (mirrors codegen's cb_ident / cg_is_c_keyword so the symbol matches the C
    definition). */
fn escape_c_keyword(name: str) -> str {
    if is_c_keyword(name) { return teko::str::concat(name, "_") }
    name
}

/** is_c_keyword — the reserved C identifiers a mangled symbol must escape (the same set
    the C backend's cg_is_c_keyword guards). */
fn is_c_keyword(s: str) -> bool {
    s == "bool" || s == "int" || s == "char" || s == "short" || s == "long" ||
    s == "float" || s == "double" || s == "void" || s == "unsigned" || s == "signed" ||
    s == "const" || s == "volatile" || s == "register" || s == "auto" || s == "static" ||
    s == "struct" || s == "union" || s == "enum" || s == "return" || s == "default" ||
    s == "goto" || s == "break" || s == "continue" || s == "case" || s == "switch" ||
    s == "do" || s == "for" || s == "while" || s == "if" || s == "else" || s == "sizeof" ||
    s == "typedef" || s == "extern" || s == "inline" || s == "restrict"
}
