/**
 * emit_region_drops — emit a `tk_region_drop_u(<region_vreg>)` for EVERY region open on
 * `ctx.region_stack`, innermost (top) to outermost (the frame) — the FREE half of the pair
 * `open_frame_region`'s `tk_region_enter_u` opened, reactivated at NP4 (suppressed at NP3). Emitted
 * SEPARATELY from, and strictly AFTER, `emit_region_leaves` on the SAME exit edge, and after the
 * return value is fully computed/boxed (`own_returned_value`/the fat ptr's own construction) — a
 * region is only dropped once nothing that still needs it is about to be read. By NP3b's own
 * completeness (`binding_conveys_escape`, blind on `ctx.escaping`) every ESCAPING value was already
 * conveyed OUT of this region (into `rr`, the conveyance anchor) at the site it was produced, so the
 * drop only ever reclaims scratch that never left the frame — the residence-rule split (owner law,
 * `modelo-de-memoria-por-escopo-0.3.1.md:§0`): escaping → the caller's region (untouched here);
 * non-escaping → dies at scope end (THIS call). Innermost-first mirrors `emit_region_leaves`' own
 * order and the C route's own `cg_drop_all_regions` (`codegen.tks`) — a would-be parent-before-child
 * drop is avoided by construction (only one entry — the frame — exists on `ctx.region_stack` until
 * NP5 adds block/loop/arm regions, which will push more before this ever runs).
 *
 * @param ctx   the lowering context at the return edge, AFTER the return value's own construction
 * @param line  the source line to stamp the emitted calls with
 * @param col   the source column to stamp
 * @return      the context with the `drop` calls appended
 * @since 0.3.1
 */
fn emit_region_drops(ctx: LowerCtx, line: u32, col: u32) -> LowerCtx {
    mut cur = ctx
    mut i = ctx.region_stack.len
    loop {
        if i == 0 { break }
        i = i - 1
        cur = ctx_append(cur, void_call_inst("tk_region_drop_u", one_region_arg(ctx.region_stack[i].region_vreg), false, line, col))
    }
    cur
}

/**
 * binding_conveys_escape — the BLIND rule (0.3.1 move-on-return M2, Mechanism 1 — native dialect,
 * twin of the C route's homonymous predicate, `codegen.tks`): the RHS of a binding/assign of name
 * `name` must be wrapped in a conveyance bracket (`emit_region_leaves` … `emit_region_enters`) iff
 * `name` is in the enclosing function's `fn_escaping_vars` set. It does NOT detect "contains a
 * call" — bracketing a pure RHS is inert, and sub-detecting would be UAF (a retained call-result
 * that materializes in the frame/block region a later `tk_region_drop_u` frees before the escaping
 * use — the `parse_function` pattern, `fechamento-…:29-48`). Over-bracketing is leak-safe (`rr` — the
 * conveyance anchor — dominates every use). The only residual UAF path is escape-analysis
 * SUB-marking, the load-bearing precondition M2 already assumes (`escape.tks`: doubt → escaping).
 *
 * @param escaping  the function's `ctx.escaping` set (a superset of the truly-escaping names)
 * @param name      the binding/assign LHS name
 * @return          true iff the RHS must be bracketed to convey a retained result to `rr`
 * @since 0.3.1
 */
fn binding_conveys_escape(escaping: []str, name: str) -> bool {
    contains_str(escaping, name)
}

/**
 * pop_region_stack — `stack` with its TOP frame removed (region-stack twin of a defer-stack
 * truncation): rebuilt by an O(depth) copy, since this dialect has no in-place array mutation and no
 * slice-range operator to truncate with. `stack.len` is bounded by `checker::TK_REGION_STACK_CAP`
 * (`residence.tks`, 64), so this stays cheap. A no-op (returns `stack` unchanged) when `stack` is
 * already empty — callers that need the "invariant broken" case NAMED (`close_native_region`) check
 * `stack.len == 0` themselves before calling.
 *
 * @param stack  the open lexical-region stack
 * @return       `stack` minus its top entry
 * @since 0.3.1
 */
fn pop_region_stack(stack: []NativeRegionFrame) -> []NativeRegionFrame {
    if stack.len == 0 { return stack }
    mut acc: []NativeRegionFrame = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i + 1 >= stack.len { break }
        acc = teko::list::push(acc, stack[i])
        i++
    }
    acc
}

/**
 * region_stack_with_top_decl — `stack` rebuilt with its TOP frame's `decl_name` replaced by `name`
 * (the N-level selector's REGISTRATION half, §1/§7): a fresh non-escaping local binding registers
 * itself as the accumulator its ENCLOSING lexical scope declares, so a later self-append inside a
 * NESTED scope (an inner loop/if-arm) can route its growth back HERE (`native_scope_region_of`)
 * instead of the nested scope's own shorter-lived region — the fix `mem_loop_per_iter` pins. A no-op
 * (returns `stack` unchanged) when `stack` is empty (no open scope to register into — a lambda body,
 * which opens no frame region under this degrau).
 *
 * @param stack  the open lexical-region stack
 * @param name   the freshly bound local's name
 * @return       `stack` with its top frame's `decl_name` replaced by `name`
 * @since 0.3.1
 */
fn region_stack_with_top_decl(stack: []NativeRegionFrame, name: str) -> []NativeRegionFrame {
    if stack.len == 0 { return stack }
    let top = stack[stack.len - 1]
    let popped = pop_region_stack(stack)
    teko::list::push(popped, NativeRegionFrame { region_vreg = top.region_vreg; decl_name = name; is_loop = top.is_loop })
}

/**
 * register_scope_decl_name — `lower_binding`'s own registration call: mark `name` as the
 * `Scope`-tier accumulator this binding's ENCLOSING open region declares
 * (`region_stack_with_top_decl`), so a self-append of `name` from inside a nested scope routes its
 * growth back here instead of dying with the nested scope. Overwrites whatever `decl_name` the
 * top frame held before (a scope with more than one non-escaping local only tracks its LAST-bound
 * name this way; an earlier one's self-append, if any, falls back to the FRAME via
 * `native_scope_region_of`'s `null` case — leak-safe, never UAF, per the SAFETY INVARIANT).
 *
 * @param ctx   the lowering context, positioned right after `name` is decided (before its RHS lowers)
 * @param name  the freshly bound local's name
 * @return      the context with its `region_stack`'s top frame's `decl_name` set to `name`
 * @since 0.3.1
 */
fn register_scope_decl_name(ctx: LowerCtx, name: str) -> LowerCtx {
    ctx_with_regions(ctx, region_stack_with_top_decl(ctx.region_stack, name))
}

/**
 * region_current_vreg — the VReg of the handle of the CURRENT region (the top of
 * `ctx.region_stack`): the region `tk_alloc`/`tk_slice_push`/`tk_slice_elem_box` bump-allocate from
 * RIGHT NOW, and the parent a nested scope's own `tk_region_new_u` opens against. When the stack is
 * empty (before the frame opens, or a value-form site with no live frame), emits a fresh
 * `tk_region_root_u()` call and returns ITS VReg — the twin of the C route's
 * `cg_enclosing_region_expr` (`codegen.tks:8052`), which falls back to `tk_region_root()` on an
 * empty stack. Allocates the root VReg on demand (only emits `tk_region_root_u` when actually
 * needed), matching `open_frame_region`'s own `rr` — but this call never touches `ctx.region_stack`
 * itself (a fallback root handle is not a NEW open region, just a value to parent one against or to
 * allocate directly into).
 *
 * @param ctx  the lowering context (its `region_stack`)
 * @return     the context (possibly with a fallback `tk_region_root_u` emitted) + the current
 *             region's VReg
 * @since 0.3.1
 */
fn region_current_vreg(ctx: LowerCtx) -> Lowered {
    if ctx.region_stack.len > 0 { return Lowered { ctx = ctx; vreg = ctx.region_stack[ctx.region_stack.len - 1].region_vreg } }
    let r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, call_inst(r.vreg, "tk_region_root_u", teko::list::empty(), false, 0, 0)); vreg = r.vreg }
}

/**
 * open_native_region — open a lexical region (NP5, §5/§7): emit `bl = tk_region_new_u(<current>)`
 * (`region_current_vreg`, so a NESTED scope parents against its own enclosing scope, not root) and
 * `void tk_region_enter_u(bl)`, push a `NativeRegionFrame` onto `ctx.region_stack`, and return the
 * grown context. Called on the entry of every `{}`/if-arm/when-arm block and, PER ITERATION, a
 * loop's own body — twin of the C route's `emit_block_region` open (`codegen.tks:8302-8304`), a
 * VReg in place of the textual `_tkbr<n>` name (§2a). Every `tk_alloc`/slice-grow/box a statement
 * inside this scope emits now bump-allocates from `bl` — UNLESS a self-append's N-level selector
 * (`native_scope_region_of`) or an escaping RHS's conveyance bracket detours it elsewhere.
 *
 * @param ctx        the lowering context
 * @param decl_name  the `Scope`-tier accumulator this scope declares at its top, or "" if none yet
 *                    (registered later, per binding, by `register_scope_decl_name`)
 * @param is_loop    is this region a loop body (dropped PER ITERATION by `close_loop_body`, not once)?
 * @param line       the source line to stamp the emitted calls with
 * @param col        the source column to stamp
 * @return           the context with the region opened, entered, and pushed
 * @since 0.3.1
 */
fn open_native_region(ctx: LowerCtx, decl_name: str, is_loop: bool, line: u32, col: u32) -> LowerCtx | error {
    let cur = region_current_vreg(ctx)
    let bl = ctx_alloc(cur.ctx)
    let with_new = ctx_append(bl.ctx, call_inst(bl.vreg, "tk_region_new_u", one_region_arg(cur.vreg), false, line, col))
    let entered = ctx_append(with_new, void_call_inst("tk_region_enter_u", one_region_arg(bl.vreg), false, line, col))
    ctx_with_regions(entered, teko::list::push(entered.region_stack, NativeRegionFrame { region_vreg = bl.vreg; decl_name = decl_name; is_loop = is_loop }))
}

/**
 * close_native_region — close the region on the TOP of `ctx.region_stack` at a scope's own exit
 * edge (NP5, §5/§7): emit `void tk_region_leave()` and `void tk_region_drop_u(<top>.region_vreg)`,
 * then pop it (`pop_region_stack`). Twin of the C route's `emit_block_region` close
 * (`codegen.tks:8311`). Every ESCAPING value this scope's statements produced was already conveyed
 * OUT (to `rr`, by `binding_conveys_escape`'s brackets) before this ever runs — this drop only ever
 * reclaims scratch that never left the scope (the residence-rule split, `modelo-…:§0`).
 *
 * @param ctx   the lowering context (its `region_stack` expected non-empty)
 * @param line  the source line to stamp the emitted calls with
 * @param col   the source column to stamp
 * @return      the context with the top region left, dropped, and popped
 * @throws      a NAMED internal error when `ctx.region_stack` is already empty (an invariant break —
 *              every call site opens exactly one region before it can reach this close)
 * @since 0.3.1
 */
fn close_native_region(ctx: LowerCtx, line: u32, col: u32) -> LowerCtx | error {
    if ctx.region_stack.len == 0 {
        return error { message = "native backend N1: close_native_region with no open region (internal invariant break)" }
    }
    let top = ctx.region_stack[ctx.region_stack.len - 1]
    let left = ctx_append(ctx, void_call_inst("tk_region_leave", teko::list::empty(), false, line, col))
    let dropped = ctx_append(left, void_call_inst("tk_region_drop_u", one_region_arg(top.region_vreg), false, line, col))
    ctx_with_regions(dropped, pop_region_stack(ctx.region_stack))
}

/**
 * close_native_regions_to — close every region open ABOVE `base` on `ctx.region_stack`, innermost
 * (top) first, repeating `close_native_region` — the BOUNDED unwind `break`/`continue` need: only the
 * regions opened INSIDE the loop being exited (the loop's own per-iteration body, and any nested
 * if/when-arm regions between the jump site and the loop body) close; every region open BEFORE the
 * loop (`base` = its own `region_base`, `LoopTargets`) stays open, exactly like `replay_defers(ctx,
 * defer_base)` only fires the defers registered since the loop's own entry.
 *
 * @param ctx   the lowering context
 * @param base  the target depth (`ctx.region_stack.len` this call leaves behind)
 * @param line  the source line to stamp the emitted calls with
 * @param col   the source column to stamp
 * @return      the context with every region above `base` left, dropped, and popped
 * @throws      propagated from `close_native_region` (unreachable in practice — `base` is always
 *              a depth this scope actually passed through on the way in)
 * @since 0.3.1
 */
fn close_native_regions_to(ctx: LowerCtx, base: u64, line: u32, col: u32) -> LowerCtx | error {
    mut cur = ctx
    loop {
        if cur.region_stack.len <= base { break }
        cur = match close_native_region(cur, line, col) { LowerCtx as c => c; error as err => return err }
    }
    cur
}

/**
 * native_scope_region_of — the N-level selector (§1/§7): the VReg of the region of the scope that
 * DECLARED the `Scope`-tier accumulator `name` — walk `stack` top (innermost) to base (outermost)
 * looking for the `NativeRegionFrame` whose `decl_name == name`, and return its `region_vreg`, so a
 * self-append of `name` from inside a NESTED scope (an inner loop/if-arm) grows the buffer THERE
 * instead of the nested scope's own shorter-lived region (else the buffer would die per-iteration —
 * UAF, the exact heisenbug this crumb kills). Returns `null` when `name` was never registered as a
 * declarant on `stack` (`register_scope_decl_name` never ran for it, or it is declared at a scope
 * this self-append is not lexically inside) — the caller falls back to the FRAME (leak-safe; never
 * the innermost/current, which could easily be the WRONG, too-short-lived choice). Twin of the C
 * route's `scope_region_of` (`transicao-…:372`), a VReg in place of the textual `_tkbr` name.
 *
 * @param stack  the open lexical-region stack
 * @param name   the self-append target's name
 * @return       the declaring scope's region VReg, or `null` if unresolved
 * @since 0.3.1
 */
fn native_scope_region_of(stack: []NativeRegionFrame, name: str) -> u32 | null {
    mut i: u64 = stack.len
    loop {
        if i == 0 { break }
        i = i - 1
        if stack[i].decl_name == name { return stack[i].region_vreg }
    }
    null
}
