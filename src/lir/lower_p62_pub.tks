use teko::checker

pub type LoweredFunction = struct { func: LFunc; rodata: []LRodata; lifted: []LFunc }

/**
 * LowerPrelude — the whole-program lowering context, computed ONCE and residing in the caller's
 * root (Group B, `docs/design/native-lowering-oom-por-funcao-0.3.1.md` §2b): the seed module
 * (registered layouts + interned aggregate-const rodata) plus every table each per-item lowering
 * step reads. Extracted from `lower_program` (0.3.1 C6.1) so the fused native emit driver in
 * `project.tks` can compute it once and thread it through a per-item scoped region loop instead of
 * `lower_program`'s own single whole-module pass. No field is per-item.
 *
 * @since 0.3.1 C6.1
 */
pub type LowerPrelude = struct {
//
// module — the seed module: registered struct layouts and the interned aggregate-const
// rodata, before any function has lowered. `funcs` is empty.
//
    module: LModule
// layouts — the program's struct-layout table, read by every item.
    layouts: []LStructLayout
// enums — the program's declared-enum table, read by every item.
    enums: []LEnumInfo
// externs — the program's `extern fn` table, read by every item.
    externs: []LExternFn
// variants — the program's variant-definition table, read by every item.
    variants: []LVariantDef
// ref_fns — the program's `Ref<T>` reference-function table, read by every item.
    ref_fns: []LRefFnInfo
// field_decls — the program's declared-field-type table, read by every item.
    field_decls: []LFieldDecls
// table — the program's type table, `typeexpr_is_fat`'s alias resolver for every item.
    table: checker::TypeTable
}

/**
 * lower_prelude — the whole-program setup extracted from `lower_program` (register every declared
 * struct's layout, collect every declared enum's members, intern every Tier-A aggregate const's
 * byte image into rodata) so it can be shared by both `lower_program`'s own loop and the fused
 * native emit driver's per-item scoped loop. Runs `fat_divergence_guard` (whole-program, reads only
 * `prog`); `frame_escape_guard` does NOT run here — the fused driver runs it per-item, inside each
 * item's own scoped window (`docs/design/native-lowering-oom-por-funcao-0.3.1.md` §2c).
 *
 * @param prog          the whole typed program to lower
 * @param flat_symbols  the static/shared-archive carve-out (KP16, `emit_static_lib`) — unused by
 *                       this setup itself (it only affects a function's OWN symbol, per item), kept
 *                       for signature symmetry with `lower_program`/`lower_item_function`
 * @return              the whole-program context, or the `error` arm when a declared aggregate has
 *                       no representable layout
 * @since 0.3.1 C6.1
 */
pub fn lower_prelude(prog: checker::TProgram, flat_symbols: bool) -> LowerPrelude | error {
    let table = checker::type_table_of(prog)
    match fat_divergence_guard(prog, table, checker::type_table_rekeyed(table)) { error as e => return e; null => { } }
    let enums = collect_enums(prog)
    let dtable = declared_type_table(prog)
    let layouts = match collect_struct_layouts(prog, enums, table, dtable) { []LStructLayout as ls => ls; error as e => return e }
    let externs = collect_externs(prog)
    let variants = collect_variant_defs(prog)
    let ref_fns = collect_ref_fns(prog)
    let field_decls = match collect_field_decls(prog) { []LFieldDecls as fd => fd; error as e => return e }
    let m = match intern_aggregate_consts(register_layouts(empty_module(), layouts), prog.items, layouts, variants, enums) { LModule as x => x; error as e => return e }
    LowerPrelude { module = m; layouts = layouts; enums = enums; externs = externs; variants = variants; ref_fns = ref_fns; field_decls = field_decls; table = table }
}

/**
 * lower_program — the module entry: register every declared struct's layout
 * (A1-3, #382), collect every declared enum's members (A1-5, #382), intern every
 * Tier-A aggregate const's byte image into rodata (#594 crumb 6), lower every
 * top-level function, and gather the loose top-level statements into a
 * synthesized `main` (the VIRTUAL-MAIN the C backend also builds), returning
 * `int 0` if the statements fall through. Type/use declarations otherwise carry
 * no code. Mirrors the loop of tk_emit_c over prog.items.
 *
 * @param checker::TProgram prog  the whole typed program to lower
 * @param bool flat_symbols  the static/shared-archive carve-out (KP16, `emit_static_lib`):
 *                           when true, every top-level function's LIR symbol drops
 *                           `TEKO_USER_PREFIX` (`mangle_fn_symbol`'s `flat`), because the whole
 *                           lowered module IS the published contract a real host `ar`/`nm`/`ld`
 *                           resolves — measured on `examples/toolchain/ar_link_run`, whose
 *                           archived symbol must be `ar_link_run__add`, not
 *                           `teko_ar_link_run__add`. Defaults to `false` (an ordinary binary,
 *                           where every user symbol stays disjoint from the runtime's `tk_*`
 *                           builtins).
 * @return LModule | error  the built module (functions + rodata/globals/
 *                          layouts, every lifted closure/thunk folded in,
 *                          A1-7 #382); the `error` arm when a declared
 *                          aggregate has no representable layout, or when any
 *                          function or the virtual main fails to lower
 */
pub fn lower_program(prog: checker::TProgram, flat_symbols: bool = false) -> LModule | error {
    let prelude = match lower_prelude(prog, flat_symbols) { LowerPrelude as x => x; error as e => return e }
    mut m = prelude.module
    mut loose: []checker::TStatement = teko::list::empty()
    mut lifted: []LFunc = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        let step = match lower_item(m, loose, prog.items[i], prelude.layouts, prelude.enums, lifted, prelude.externs, flat_symbols, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { LowerItemOut as x => x; error as err => return err }
        m = step.module
        loose = step.loose
        lifted = step.lifted
        i++
    }
    let vmain = match lower_virtual_main(loose, prelude.layouts, prelude.enums, m.rodata, lifted, prelude.externs, flat_symbols, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { LoweredFunction as x => x; error as err => return err }
    let whole = fold_lifted_funcs(add_func(with_rodata(m, vmain.rodata), vmain.func), vmain.lifted)
    match frame_escape_guard(whole) { error as e => return e; null => { } }
    whole
}
