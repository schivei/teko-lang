use teko::checker
use teko::lexer
use teko::parser

/**
 * lower_nested_variant_construct — `lower_variant_construct`'s alias-recursion arm: find the
 * `Named` member of `v` whose OWN declared expansion covers `value`'s type
 * (`find_nested_alias_member`), recursively build `value`'s wrapper AGAINST THAT EXPANSION
 * (`lower_variant_construct` again, so nesting resolves to any depth), then wrap the INNER
 * wrapper's own address as THIS level's payload — boxed like any other aggregate payload
 * (`store_scalar_variant_payload_value`, `pty` = the alias's OWN name, so `aggregate_box_bytes`
 * sees a declared variant and boxes the uniform 24 bytes rather than copying the inner wrapper's
 * own address raw, which a loop-nested construction would otherwise alias across iterations
 * exactly as `store_scalar_variant_payload`'s doc already describes for a plain aggregate).
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param checker::Variant v  the declared variant `value` is placed into
 * @param checker::TExpr value  the bare case value being wrapped
 * @return Lowered  the OUTER wrapper's alloca'd base address
 * @throws  propagated from the inner recursive construction, or when `value`'s type names no
 *          member of `v` directly or through any alias member's own expansion
 * @since 0.3.1.0 (degrau 23 — nested named-variant construction, #382)
 */
fn lower_nested_variant_construct(ctx: LowerCtx, v: checker::Variant, value: checker::TExpr) -> Lowered | error {
    match find_nested_alias_member(v.members, value.type, ctx.variants) {
        NestedAliasMember as nm => {
            let inner = match lower_variant_construct(ctx, nm.expansion, value) { Lowered as x => x; error as e => return e }
            let base = ctx_alloc(inner.ctx)
            let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), value.line, value.col))
            let tagged = store_variant_tag(with_alloca, base.vreg, nm.index to i64, value.line, value.col)
            store_scalar_variant_payload_value(base.vreg, checker::Named { name = nm.name }, Lowered { ctx = tagged.ctx; vreg = inner.vreg }, value)
        }
        null => error { message = "native backend N1: value's type is not a member of its declared variant (internal)" }
    }
}

/**
 * find_nested_alias_member — the FIRST member of `members` whose OWN declared expansion (as a
 * registered variant, `find_variant_def`) covers `value_ty` (`variant_any_member_matches`), or
 * `null` when none does. `lower_variant_construct`'s alias-recursion arm's own lookup, tried only
 * after `direct_variant_member_index` has already answered `null`.
 *
 * @param []checker::Type members  the variant's declared members, in order
 * @param checker::Type value_ty  the value's own resolved type
 * @param []LVariantDef variants  the program's declared-variant table
 * @return NestedAliasMember?  the first covering alias member, or `null`
 * @since 0.3.1.0 (degrau 23 — nested named-variant construction, #382)
 */
fn find_nested_alias_member(members: []checker::Type, value_ty: checker::Type, variants: []LVariantDef) -> NestedAliasMember | null {
    mut i: u64 = 0
    loop {
        if i >= members.len { break }
        match nested_alias_member_at(members[i], i to u32, value_ty, variants) {
            NestedAliasMember as nm => return nm
            null => { }
        }
        i++
    }
    null
}

/**
 * nested_alias_member_at — is `member` (declared at `index` within its owning variant) a `Named`
 * alias whose OWN declared expansion covers `value_ty`? `find_nested_alias_member`'s per-member
 * probe, split out so its loop stays a single readable line.
 *
 * @param checker::Type member  one member of the OUTER variant's declared members
 * @param u32 index  `member`'s own declared position
 * @param checker::Type value_ty  the value's own resolved type
 * @param []LVariantDef variants  the program's declared-variant table
 * @return NestedAliasMember?  `member`'s own alias info when it covers `value_ty`, else `null`
 * @since 0.3.1.0 (degrau 23 — nested named-variant construction, #382)
 */
fn nested_alias_member_at(member: checker::Type, index: u32, value_ty: checker::Type, variants: []LVariantDef) -> NestedAliasMember | null {
    match member {
        checker::Named as mn => match find_variant_def(variants, mn.name) {
            LVariantDef as def => nested_alias_member_if_covers(index, mn.name, def.ty, value_ty, variants)
            null => null
        }
        _ => null
    }
}

/**
 * nested_alias_member_if_covers — `NestedAliasMember { index; name; variant = inner }` when
 * `inner`'s own members cover `value_ty` (`variant_any_member_matches`), else `null`. The final
 * yes/no step `nested_alias_member_at` delegates to once it has resolved the candidate alias's own
 * declared expansion.
 *
 * @param u32 index  the alias member's own declared position within the OUTER variant
 * @param str name  the alias's own canonical name
 * @param checker::Variant inner  the alias's own declared expansion
 * @param checker::Type value_ty  the value's own resolved type
 * @param []LVariantDef variants  the program's declared-variant table
 * @return NestedAliasMember?  the populated result when `inner` covers `value_ty`, else `null`
 * @since 0.3.1.0 (degrau 23 — nested named-variant construction, #382)
 */
fn nested_alias_member_if_covers(index: u32, name: str, inner: checker::Variant, value_ty: checker::Type, variants: []LVariantDef) -> NestedAliasMember | null {
    if variant_any_member_matches(inner.members, value_ty, variants) { return NestedAliasMember { index = index; name = name; expansion = inner } }
    null
}

/**
 * store_scalar_variant_payload_value — `store_scalar_variant_payload`'s ALREADY-LOWERED twin:
 * store `vo` (a value some earlier lowering step already produced, e.g. a recursively-built INNER
 * wrapper's own base address) as the SINGLE-WORD payload at `variant_payload_offset()`, boxing it
 * exactly like a freshly-lowered aggregate would (`box_aggregate_value`) — the same reason
 * `store_fat_variant_payload_pair` exists beside `store_fat_variant_payload` for a runtime call's
 * own out-parameter pair (0.3.1.0 degrau 21).
 *
 * @param u32 base  the wrapper's alloca'd base-address VReg
 * @param checker::Type pty  the payload's declared type (fixes its machine class + box width)
 * @param Lowered vo  the already-lowered payload value (and its advanced context)
 * @param checker::TExpr pos  the expression to stamp the emitted instructions' source position with
 * @return Lowered  the wrapper's base address
 * @throws  propagated from `variant_payload_box_bytes` when `pty` is a non-register aggregate
 *          whose whole-type width this backend does not pin
 * @since 0.3.1.0 (degrau 23 — nested named-variant construction, #382)
 */
fn store_scalar_variant_payload_value(base: u32, pty: checker::Type, vo: Lowered, pos: checker::TExpr) -> Lowered | error {
    let box_bytes = match variant_payload_box_bytes(pty, vo.ctx) { u32 as n => n; error as err => return err }
    let owned = box_aggregate_value(vo, box_bytes, pos)
    let paddr = ctx_alloc(owned.ctx)
    let with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, base, variant_payload_offset(), pos.line, pos.col))
    let with_pstore = ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, ltype_of(pty, vo.ctx.enums), pos.line, pos.col))
    Lowered { ctx = with_pstore; vreg = base }
}

/**
 * variant_wrapper_bytes — the byte width of EVERY variant/optional wrapper this backend builds:
 * 24, the `{ i32 tag@0; ptr@8; len@16 }` shape, whatever the active case is.
 *
 * THE OWNER'S RULING OF 2026-07-28, and it is a decision, not a measurement. The wrapper used to be
 * sized PER CONSTRUCTION (`8 + ltype_size(payload)`), which gave 16 bytes for the cases this
 * backend can build — one tag word and ONE payload word. A `str`/`[]T` member does not fit in one
 * word, so its LENGTH was dropped at construction and every reader of that member got a pointer
 * with a garbage length beside it. ONE SHAPE, ONE SET OF OFFSETS: a member narrower than the
 * pointer+length pair simply leaves the length half unwritten, and the 8 bytes it wastes are the
 * price of never again having a case whose offsets differ from its siblings'.
 *
 * The two rejected alternatives, recorded so they are not re-proposed: BOXING the fat payload
 * behind one word (it would deepen the by-address aggregate model that is already marked for
 * demolition — `NATIVE-AGG-SLICE-BY-ADDRESS`), and sizing the wrapper PER MEMBER (a variable
 * payload offset is exactly the extra surface on which four separate degraus of this lane have
 * already had a case fall through a `_ =>`).
 *
 * @return u32  the wrapper's size in bytes, for every variant and every case
 * @since 0.3.1.0 (degrau 6 — the uniform 24-byte wrapper)
 */
fn variant_wrapper_bytes() -> u32 { 24 to u32 }

/**
 * variant_payload_offset — the byte offset of the wrapper's payload word: a scalar member's
 * value, an aggregate member's address, or the POINTER half of a fat member's pair. Immediately
 * past the `i32` tag, at the pointer alignment every payload shape is happy with.
 *
 * @return u32  the payload word's offset within the wrapper
 * @since 0.3.1.0 (degrau 6 — the uniform 24-byte wrapper)
 */
fn variant_payload_offset() -> u32 { 8 to u32 }

/**
 * variant_payload_len_offset — the byte offset of the wrapper's LENGTH half, written and read
 * ONLY for a fat (`str`/`[]T`) member and reserved-but-unwritten for every other one. The half
 * whose absence is degrau 6.
 *
 * @return u32  the length half's offset within the wrapper
 * @since 0.3.1.0 (degrau 6 — the uniform 24-byte wrapper)
 */
fn variant_payload_len_offset() -> u32 { 16 to u32 }

/**
 * variant_wrapper_align — the tag+payload wrapper's alignment: the pointer's own 8, since the
 * uniform shape always reserves a pointer and a length whether or not the active case fills them.
 * Shared by every variant construction (null-bearing or general).
 *
 * @return u32  the wrapper's alignment in bytes
 * @since 0.3.1.0 (degrau 6 — the uniform 24-byte wrapper)
 */
fn variant_wrapper_align() -> u32 { ltype_align(LType::Ptr) }

/**
 * store_variant_tag — store `index` as the wrapper's `i32` tag word (offset 0), leaving the
 * payload slot's bytes unspecified (a tag-only construction — the null-union's absent case —
 * never reads them back).
 *
 * @param LowerCtx ctx  the lowering context to append the store's instructions into
 * @param u32 base  the wrapper's alloca'd base-address VReg
 * @param i64 index  the tag value to store
 * @param u32 line  the source line to stamp the emitted instructions with
 * @param u32 col  the source column to stamp the emitted instructions with
 * @return Lowered  the wrapper's base address, unchanged
 */
fn store_variant_tag(ctx: LowerCtx, base: u32, index: i64, line: u32, col: u32) -> Lowered {
    let tagr = ctx_alloc(ctx)
    let with_tag = ctx_append(tagr.ctx, const_int_inst(tagr.vreg, index, line, col))
    let addr = ctx_alloc(with_tag)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, 0, line, col))
    let with_store = ctx_append(with_addr, store_inst(addr.vreg, tagr.vreg, LType::I32, line, col))
    Lowered { ctx = with_store; vreg = base }
}

/**
 * store_variant_payload — store `index` as the wrapper's tag (`store_variant_tag`) then the
 * lowered payload `e` into the wrapper, in the shape the payload's declared type asks for: a FAT
 * member writes BOTH halves (`store_fat_variant_payload`), every other member writes the single
 * payload word (`store_scalar_variant_payload`). Generalizes the null-union's hard-coded tag `1`
 * to an arbitrary member INDEX, so the SAME store serves both the null-union's single present
 * case and any case of a general (2+ non-null-member) variant (#382, degrau N2).
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param u32 base  the wrapper's alloca'd base-address VReg
 * @param i64 index  the payload's own member index (the case being constructed)
 * @param checker::Type pty  the payload's declared type (NOT its machine class — the fat members
 *                           share `LType::Ptr` with the address-shaped ones)
 * @param checker::TExpr e  the payload value to lower and store
 * @return Lowered  the wrapper's base address
 * @throws  propagated from lowering `e`
 */
fn store_variant_payload(ctx: LowerCtx, base: u32, index: i64, pty: checker::Type, e: checker::TExpr) -> Lowered | error {
    let tagged = store_variant_tag(ctx, base, index, e.line, e.col)
    if is_fat_type(pty) { return store_fat_variant_payload(tagged.ctx, base, e) }
    store_scalar_variant_payload(tagged.ctx, base, pty, e)
}

/**
 * variant_payload_box_bytes — how many bytes of an aggregate payload the wrapper must OWN, or 0
 * when the payload needs no copy (a register value: it is stored by VALUE, not by address, so no
 * `alloca` can outlive it and there is nothing to box).
 *
 * A non-register payload whose whole-type width this backend does NOT pin (an interface, an
 * optional, a closure) is the SAME question `push_box_bytes` already answers for a slice element,
 * so it gets the SAME answer: an honest stop (`unsized_aggregate_push_stop`), never a silent 0. A
 * silent 0 there would store the payload's raw `alloca` address unboxed — exactly the per-
 * INSTRUCTION-frame-slot hazard `store_scalar_variant_payload` exists to close — which would trade a
 * loud stop the self-build has never actually reached for a wrong answer nobody could see coming.
 *
 * @param pty  the payload's declared type
 * @param ctx  the lowering context (its registered layouts and declared-variant table)
 * @return     the payload's byte width, or 0 when no copy is made
 * @throws     `unsized_aggregate_push_stop` for a non-register aggregate whose whole-type width is
 *             not pinned
 */
fn variant_payload_box_bytes(pty: checker::Type, ctx: LowerCtx) -> u32 | error {
    if is_register_value_type(pty, ctx.enums) { return 0 to u32 }
    match aggregate_box_bytes(pty, ctx) {
        u32 as n => n
        null => unsized_aggregate_push_stop(aggregate_form_name(pty))
    }
}
