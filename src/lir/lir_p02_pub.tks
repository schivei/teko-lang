

/**
 * ConstImage — the complete rodata materialization of ONE aggregate const (#594 T-B6): the bytes of
 * the main blob, its internal pointer relocations (one per slice/pointer field, empty for a Tier-A
 * flat aggregate), and the LEAF rodata entries its pointer slots reference (one target array per
 * slice field; empty for Tier-A). A Tier-A aggregate (crumb 6) returns empty `relocs`/`leaves` and is
 * byte-identical to the previous path; a Tier-B aggregate (an ABI descriptor) returns one reloc + one
 * leaf per slice field.
 *
 * @since #594 T-B6
 */
pub type ConstImage = struct {
    /**
     * bytes — the main blob's bytes (pointer slots zero-init, `len`/scalars inline).
     */
    bytes: []byte
    /**
     * relocs — the blob's internal relocations (a pointer slot's byte offset -> the leaf's symbol).
     */
    relocs: []LDataReloc
    /**
     * leaves — the target arrays' rodata entries, to intern BEFORE the main blob.
     */
    leaves: []LRodata
}

/**
 * FatMemberImage — the 16-byte image of one FAT MEMBER (`[]T`/`str`) of an aggregate const, plus the
 * relocation and the leaf entries its pointer slot needs (#594 T-B6; 0.3.1.0 degrau const-slice): the
 * slot bytes (8 zero + the element count inline), the `LDataReloc` for the pointer slot, and every
 * `LRodata` leaf the member's target array pulls in. The producer writes `slot_bytes` at the member's
 * blob offset and accumulates `reloc`/`leaves` into the owning `ConstImage`.
 *
 * A MEMBER, not merely a field: the same image serves a fat STRUCT FIELD (`const D: Desc = Desc {
 * name = "abcde"; … }`, its slot at the field's layout offset) and a fat SLICE ELEMENT (`const T:
 * []str = ["a", "b"]`, its slot at `index * fat_slot_bytes()`), because the two shapes materialize
 * identically — a zeroed pointer slot, a count, a relocation and a target leaf.
 *
 * `leaves` is a LIST rather than a single entry because a fat member's target can itself hold fat
 * members (a `[][]str` element, a `[]str` field): the member's own leaf comes LAST, after the nested
 * leaves it depends on, so the interning order stays a pure function of declaration order.
 *
 * @since #594 T-B6 (fields); 0.3.1.0 degrau const-slice (elements + nested leaves)
 */
pub type FatMemberImage = struct {
    /**
     * slot_bytes — the member's 16-byte image (8 zero pointer bytes + the element count as 8 LE bytes).
     */
    slot_bytes: []byte
    /**
     * reloc — the pointer slot's relocation (offset within the blob -> the leaf symbol).
     */
    reloc: LDataReloc
    /**
     * leaves — the member's target-array rodata entries: every nested leaf first, its own leaf last.
     */
    leaves: []LRodata
}

/** LGlobal — one mutable/immutable top-level datum: its symbol, machine class, and
    initializer image. No A1-4 lowering produces one yet (top-level consts are a later
    construct); the field exists now so `LModule` widens only once (A1-4, #382). */
pub type LGlobal = struct { symbol: str; ty: LType; bytes: []byte }

/** LModule — the whole lowered program: its functions, its rodata + global tables, and the
    struct-layout table (A1-3/A1-4, #382). */
pub type LModule = struct { funcs: []LFunc; rodata: []LRodata; globals: []LGlobal; layouts: []LStructLayout }

/** empty_module — a module with no functions/rodata/globals/layouts (the lowering seed). */
pub fn empty_module() -> LModule {
    LModule { funcs = teko::list::empty(); rodata = teko::list::empty(); globals = teko::list::empty(); layouts = teko::list::empty() }
}

/** new_func — a fresh LFunc with an empty single block (#B0) reserving VRegs
    0..n_params for the parameters. `next_vreg` starts past the params so the first
    lowered value gets a clean id. */
pub fn new_func(symbol: str, n_params: u32, param_types: []LType, ret_type: LType) -> LFunc {
    let entry = LBlock { id = 0; params = teko::list::empty(); insts = teko::list::empty() }
    LFunc {
        symbol = symbol
        n_params = n_params
        param_types = param_types
        ret_type = ret_type
        blocks = teko::list::push(teko::list::empty(), entry)
        next_vreg = n_params
    }
}

/**
 * EXIT_STATUS_MASK — the low byte of a process status: the ONLY part of an exit code every
 * supported platform reports IDENTICALLY. POSIX `exit(3)`/`wait(2)` expose `status & 0377`, while
 * Windows hands back all 32 bits of `ExitProcess`, so the same program used to report 235 on Linux
 * and 20203 on Windows. Owner ruling 2026-07-30 makes the normalization the LANGUAGE's job, never
 * the programmer's, so every process-exit door masks with THIS constant.
 *
 * The C-route door masks in the runtime instead (`TK_EXIT_STATUS_MASK`, `src/runtime/teko_rt.h`)
 * because a `main` that RETURNS never calls `tk_exit`; the two values are the same byte, and the
 * own-backend spelling exists because a natively emitted process entry links no C runtime at all.
 *
 * @see append_exit_status_mask
 * @since cargo/0.3.1-saida-equalizada
 */
pub const EXIT_STATUS_MASK: i64 = 0xFF

/** const_int_inst — a `%r = const.<t> val` instruction. */
pub fn const_int_inst(result: u32, val: i64, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LConstInt { val = val }; line = line; col = col }
}

/**
 * const_float_inst — a `%r = const.<t> 0x<bits>` instruction.
 *
 * @param result  the VReg the literal materializes into
 * @param bits    the literal's exact f64 IEEE bit pattern
 * @param wide    the literal's declared machine width (true `f64`, false `f32`)
 * @param line    the source line, for diagnostics
 * @param col     the source column, for diagnostics
 * @return        the built instruction
 */
pub fn const_float_inst(result: u32, bits: u64, wide: bool, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LConstFloat { bits = bits; wide = wide }; line = line; col = col }
}

/** bin_inst — a `%r = <op> a, b` instruction. */
pub fn bin_inst(result: u32, op: LBinOp, a: u32, b: u32, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LBin { op = op; a = a; b = b }; line = line; col = col }
}

/** un_inst — a `%r = <op> a` instruction. */
pub fn un_inst(result: u32, op: LUnOp, a: u32, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LUn { op = op; a = a }; line = line; col = col }
}

/** param_inst — a `%r = param <index>` instruction. */
pub fn param_inst(result: u32, index: u32, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LParam { index = index }; line = line; col = col }
}

/**
 * call_inst — a value-producing `%r = call @sym(args)` instruction.
 *
 * @param result    the VReg the call's return value is stored into
 * @param symbol    the callee's already-mangled symbol name
 * @param args      the (already-lowered) argument VRegs, in ABI order
 * @param variadic  whether the callee's variadic marker is set
 * @param line      the source line (propagated for the `.tsym` map)
 * @param col       the source column (propagated for the `.tsym` map)
 * @param ret_type  the machine class the RESULT comes back in (`LCall.ret_type`); defaults to
 *                  `I64`, the integer-register class every pointer/integer/`bool` result shares,
 *                  so ONLY a float-returning call has to name it (0.3.1.0 degrau 27)
 * @return LInst  the built instruction
 */
pub fn call_inst(result: u32, symbol: str, args: []u32, variadic: bool, line: u32, col: u32, ret_type: LType = teko::lir::LType::I64) -> LInst {
    LInst { result = result; has_result = true; op = LCall { symbol = symbol; args = args; variadic = variadic; ret_type = ret_type }; line = line; col = col }
}

/**
 * void_call_inst — a `call @sym(args)` instruction that yields no value (a statement-level call or
 * a diverging builtin like `tk_exit`).
 *
 * @param symbol    the callee's already-mangled symbol name
 * @param args      the (already-lowered) argument VRegs, in ABI order
 * @param variadic  whether the callee's variadic marker is set
 * @param line      the source line (propagated for the `.tsym` map)
 * @param col       the source column (propagated for the `.tsym` map)
 * @return LInst  the built instruction, with `ret_type = Void` (there is no result to place)
 */
pub fn void_call_inst(symbol: str, args: []u32, variadic: bool, line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LCall { symbol = symbol; args = args; variadic = variadic; ret_type = LType::Void }; line = line; col = col }
}

/** ret_inst — a `ret %v` terminator. */
pub fn ret_inst(value: u32, line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LRet { has_value = true; value = value }; line = line; col = col }
}

/** ret_void_inst — a `ret` (void) terminator. */
pub fn ret_void_inst(line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LRet { has_value = false; value = 0 }; line = line; col = col }
}

/** jump_inst — an unconditional `jump #Btarget(args)` terminator carrying block-args (the
    SSA-lite merge). */
pub fn jump_inst(target: u32, args: []u32, line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LJump { target = target; args = args }; line = line; col = col }
}

/** branch_inst — a conditional `branch %cond, #Bt(targs), #Bf(fargs)` terminator. */
pub fn branch_inst(cond: u32, t_target: u32, t_args: []u32, f_target: u32, f_args: []u32, line: u32, col: u32) -> LInst {
    LInst {
        result = 0; has_result = false
        op = LBranch { cond = cond; t_target = t_target; t_args = t_args; f_target = f_target; f_args = f_args }
        line = line; col = col
    }
}

/** alloca_inst — a `%r = alloca <bytes>, align <align>` instruction (A1-3, #382). */
pub fn alloca_inst(result: u32, bytes: u32, align: u32, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LAlloca { bytes = bytes; align = align }; line = line; col = col }
}

/** field_addr_inst — a `%r = field_addr %base, <offset>` instruction: the address `offset`
    bytes past `base` (A1-3, #382). */
pub fn field_addr_inst(result: u32, base: u32, offset: u32, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LFieldAddr { base = base; offset = offset }; line = line; col = col }
}

/** load_inst — a `%r = load.<ty> %addr` instruction (A1-3, #382). */
pub fn load_inst(result: u32, addr: u32, ty: LType, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LLoad { addr = addr; ty = ty }; line = line; col = col }
}

/** store_inst — a `store.<ty> %addr, %value` instruction; yields no value (A1-3, #382). */
pub fn store_inst(addr: u32, value: u32, ty: LType, line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LStore { addr = addr; value = value; ty = ty }; line = line; col = col }
}

/** global_addr_inst — a `%r = global_addr @<symbol>` instruction: the address of a rodata/
    global entry (A1-4, #382). */
pub fn global_addr_inst(result: u32, symbol: str, line: u32, col: u32) -> LInst {
    LInst { result = result; has_result = true; op = LGlobalAddr { symbol = symbol }; line = line; col = col }
}

/**
 * call_indirect_inst — a value-producing `%r = call.indirect %target(args)`
 * instruction (A1-6, #382).
 *
 * @param u32 result    the VReg the call's return value is stored into
 * @param u32 target    the VReg holding the callee's address
 * @param []u32 args    the (already-lowered) argument VRegs, in order
 * @param bool variadic whether the callee's variadic marker is set
 * @param u32 line      the source line (propagated for the `.tsym` map)
 * @param u32 col       the source column (propagated for the `.tsym` map)
 * @param LType ret_type  the machine class the RESULT comes back in (`LCall.ret_type`); defaults
 *                  to `I64` so only a float-returning indirect call has to name it
 * @return LInst  the built instruction
 */
pub fn call_indirect_inst(result: u32, target: u32, args: []u32, variadic: bool, line: u32, col: u32, ret_type: LType = teko::lir::LType::I64) -> LInst {
    LInst { result = result; has_result = true; op = LCallIndirect { target = target; args = args; variadic = variadic; ret_type = ret_type }; line = line; col = col }
}

/**
 * void_call_indirect_inst — a `call.indirect %target(args)` instruction that
 * yields no value (a statement-level interface/closure call) (A1-6, #382).
 *
 * @param u32 target    the VReg holding the callee's address
 * @param []u32 args    the (already-lowered) argument VRegs, in order
 * @param bool variadic whether the callee's variadic marker is set
 * @param u32 line      the source line (propagated for the `.tsym` map)
 * @param u32 col       the source column (propagated for the `.tsym` map)
 * @return LInst  the built instruction
 */
pub fn void_call_indirect_inst(target: u32, args: []u32, variadic: bool, line: u32, col: u32) -> LInst {
    LInst { result = 0; has_result = false; op = LCallIndirect { target = target; args = args; variadic = variadic; ret_type = LType::Void }; line = line; col = col }
}
