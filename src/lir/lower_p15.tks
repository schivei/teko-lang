use teko::checker
use teko::lexer
use teko::parser

/**
 * lower_last_index_of_error_arm — the NOT-FOUND arm's wrapper build: tag = the `error` member's
 * declared index, payload = a fresh, boxed `error { message = "" }` — mirrors the C route's own
 * `emit_host_ffi` doc ("u64res carries no message — not-found is the only failure"). Built by
 * hand (an empty `tk_str` stored through `store_fat_slot`, then boxed through the SAME
 * `variant_payload_box_bytes`/`box_aggregate_value` pair every OTHER aggregate payload uses)
 * rather than through a synthesized `checker::TExpr` + `lower_struct_init` round trip: this
 * backend has no established precedent for fabricating a typed-AST node outside the checker, and
 * the manual build reuses the exact same boxing primitives with no less rigor.
 *
 * @param ctx      the lowering context, positioned in the not-found arm's own block
 * @param wrapper  the wrapper's alloca'd base address (already reserved, 24 bytes)
 * @param index    the `error` member's declared tag index
 * @param e        the call expression (source position only, threaded to `box_aggregate_value`)
 * @return         the advanced context; `wrapper` is the arm's own result
 * @throws         propagated from `variant_payload_box_bytes` (never actually thrown for `error`
 *                 — its layout is always registered — kept honest rather than assumed)
 * @since 0.3.1.0 degrau 15; degrau 22 grew the manual build to zero the five diagnostic fields
 *        the grown `error_struct_layout` now reserves alongside `message`
 */
fn lower_last_index_of_error_arm(ctx: LowerCtx, wrapper: u32, index: i64, e: checker::TExpr) -> LowerCtx | error {
    let tagged = store_variant_tag(ctx, wrapper, index, e.line, e.col)
    let layout = error_struct_layout()
    let base = ctx_alloc(tagged.ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, layout.size, layout.align, e.line, e.col))
    let zero_ptr = ctx_alloc(with_alloca)
    let with_zero_ptr = ctx_append(zero_ptr.ctx, const_int_inst(zero_ptr.vreg, 0, e.line, e.col))
    let zero_len = ctx_alloc(with_zero_ptr)
    let with_zero_len = ctx_append(zero_len.ctx, const_int_inst(zero_len.vreg, 0, e.line, e.col))
    let empty_msg = LoweredFat { ctx = with_zero_len; ptr = zero_ptr.vreg; len = zero_len.vreg }
    let with_msg = store_fat_slot(empty_msg.ctx, base.vreg, empty_msg, e.line, e.col)
    let with_zeroed = zero_error_diagnostics(with_msg, base.vreg, layout, 1, e.line, e.col)
    let box_bytes = match variant_payload_box_bytes(checker::Error { }, with_zeroed) { u32 as n => n; error as err => return err }
    let owned = box_aggregate_value(Lowered { ctx = with_zeroed; vreg = base.vreg }, box_bytes, e)
    let paddr = ctx_alloc(owned.ctx)
    let with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, wrapper, variant_payload_offset(), e.line, e.col))
    ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, LType::Ptr, e.line, e.col))
}

/**
 * lower_last_index_of_call — `teko::str::last_index_of(hay, needle) -> u64 | error` (0.3.1.0
 * degrau 15): the runtime's real ABI (`tk_rt_last_index_of`) returns a 2-eightbyte
 * `{bool ok; uint64_t value}` struct this backend's `LCall` cannot capture (it reads ONE result
 * register, `select_call_result_x86`/`select_call_result_arm64`) — so a dedicated runtime twin
 * (`tk_rt_last_index_of_ok`, `teko_rt.c`/`.h`) carries the found/not-found flag as its OWN
 * single-register `bool` return and the found index through a hidden `uint64_t *` out-parameter,
 * mirroring the SAME out-slot convention `lower_len_out_call` already uses for a fat result's
 * length half. The narrowed `bool` (its C ABI defines only the low byte, `extern_return_narrow`'s
 * own doc) then branches — mirrors `lower_coalesce`'s present/absent shape — into the found/
 * not-found arm, each building the SAME uniform 24-byte variant wrapper
 * (`variant_wrapper_bytes`) every OTHER variant construction in this backend builds, merged
 * through ONE block-arg: the wrapper's base address, this call's own result.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `u64 | error`)
 * @param c    the call node (its two `str` arguments)
 * @return     the advanced context + the wrapper's base-address VReg
 * @throws     when the call's own arity is not two, when `e.type` is not the expected variant, or
 *             propagated from lowering either argument
 * @since 0.3.1.0 degrau 15
 */
fn lower_last_index_of_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `last_index_of` expects exactly two str arguments (internal)" }
    }
    let members = match last_index_of_variant_members(e) { []checker::Type as m => m; error as err => return err }
    let ok_index = match variant_member_index_of(members, checker::Prim { kind = checker::PrimKind::U64 }, ctx.variants) { u32 as x => x; error as err => return err }
    let err_index = match variant_member_index_of(members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    let hay = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    let needle = match lower_fat_expr(hay.ctx, c.args[1]) { LoweredFat as x => x; error as err => return err }
    let slot = ctx_alloc(needle.ctx)
    let with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(LType::I64), ltype_align(LType::I64), e.line, e.col))
    let call_args = teko::list::push(four_args(hay.ptr, hay.len, needle.ptr, needle.len), slot.vreg)
    let called = ctx_alloc(with_slot)
    let with_call = ctx_append(called.ctx, call_inst(called.vreg, "tk_rt_last_index_of_ok", call_args, false, e.line, e.col))
    let ok = narrow_extern_return(Lowered { ctx = with_call; vreg = called.vreg }, ExternNarrow { width = 8; is_signed = false }, e.line, e.col)
    let thenb = alloc_block(ok.ctx.func)
    let elseb = alloc_block(thenb.func)
    let mergeb = alloc_block(elseb.func)
    let mp = add_block_param(mergeb.func, mergeb.block_id)
    let br = branch_inst(ok.vreg, thenb.block_id, teko::list::empty(), elseb.block_id, teko::list::empty(), e.line, e.col)
    let ctx1 = ctx_append(ctx_with(ok.ctx, mp.func, ok.ctx.block_id, ok.ctx.env), br)
    let then_ctx = ctx_goto(ctx1, thenb.block_id)
    let loaded = ctx_alloc(then_ctx)
    let with_load = ctx_append(loaded.ctx, load_inst(loaded.vreg, slot.vreg, LType::I64, e.line, e.col))
    let then_base = ctx_alloc(with_load)
    let then_alloca = ctx_append(then_base.ctx, alloca_inst(then_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    let then_built = lower_last_index_of_ok_arm(then_alloca, then_base.vreg, ok_index to i64, loaded.vreg, e.line, e.col)
    let then_func = close_arm_to(then_built, mergeb.block_id, teko::list::push(teko::list::empty(), then_base.vreg), e.line, e.col)
    let else_ctx = ctx_with(ctx1, then_func, elseb.block_id, ctx1.env)
    let err_base = ctx_alloc(else_ctx)
    let err_alloca = ctx_append(err_base.ctx, alloca_inst(err_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    let else_built = match lower_last_index_of_error_arm(err_alloca, err_base.vreg, err_index to i64, e) { LowerCtx as x => x; error as err2 => return err2 }
    let else_func = close_arm_to(else_built, mergeb.block_id, teko::list::push(teko::list::empty(), err_base.vreg), e.line, e.col)
    Lowered { ctx = ctx_with(ctx1, else_func, mergeb.block_id, ctx1.env); vreg = mp.vreg }
}

/**
 * is_str_from_utf8_call — recognizes `teko::text::str_from_utf8`'s bare last segment: the SECOND
 * host-FFI VARIANT-result builtin this N1 subset lowers directly (0.3.1.0 degrau 21), the fat-
 * payload sibling of degrau 15's `last_index_of` (`is_last_index_of_call`) — its `str | error`
 * return is neither fat (`is_fat_type` only accepts a BARE `str`/`[]T` result, never one wrapped
 * in a variant) nor an ordinary single-register scalar, so `lower_call` intercepts it BEFORE
 * `call_symbol`'s plain resolver table, the same early-interception shape `last_index_of` uses.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `str_from_utf8`
 */
fn is_str_from_utf8_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "str_from_utf8"
}

/**
 * ffi_result_variant_members — the declared members of an aggregate-returning host-FFI call's
 * result variant (`str | error`, `[]str | error`, `error | null`), read straight off the call
 * expression's resolved type. The checker's own `extern fn` / builtin tables are the SOLE
 * producers of these shapes — a non-`Variant` result reaching here is an invariant the checker
 * breaks, not this backend. Shared by `str_from_utf8` and the whole `tk_rt_*_ok` twin family
 * (0.3.1.0 degrau 34).
 *
 * @param e  the call expression (its type is the host primitive's declared result variant)
 * @return   the variant's own members, in declared order
 * @throws   when `e.type` is not a `Variant` (an internal invariant break)
 */
fn ffi_result_variant_members(e: checker::TExpr) -> []checker::Type | error {
    match e.type {
        checker::Variant as v => v.members
        _ => error { message = "native backend N1: a host-FFI call's result is not a variant (internal)" }
    }
}

/**
 * load_ptr_len_out_slots — read the `(ptr, len)` pair a runtime call wrote into two SEPARATE
 * out-parameter slots, as opposed to `load_fat_slot`'s single contiguous 16-byte frame slot: the
 * shape `lower_str_from_utf8_call`'s bool-branch construction reads back in EITHER arm, since the
 * runtime twin (`tk_rt_str_from_utf8_ok`) writes the ACTIVE case's `(ptr, len)` into the SAME two
 * slots regardless of which one it turned out to be — the ok value on success, the "invalid
 * UTF-8" message on failure.
 *
 * @param LowerCtx ctx  the lowering context
 * @param u32 ptr_slot  the pointer half's alloca'd slot address
 * @param u32 len_slot  the length half's alloca'd slot address
 * @param u32 line  the source line to stamp the emitted instructions with
 * @param u32 col  the source column to stamp the emitted instructions with
 * @return LoweredFat  the advanced context + the loaded `(ptr, len)` pair
 */
fn load_ptr_len_out_slots(ctx: LowerCtx, ptr_slot: u32, len_slot: u32, line: u32, col: u32) -> LoweredFat {
    let pr = ctx_alloc(ctx)
    let with_pr = ctx_append(pr.ctx, load_inst(pr.vreg, ptr_slot, LType::Ptr, line, col))
    let lr = ctx_alloc(with_pr)
    let with_lr = ctx_append(lr.ctx, load_inst(lr.vreg, len_slot, LType::I64, line, col))
    LoweredFat { ctx = with_lr; ptr = pr.vreg; len = lr.vreg }
}

/**
 * lower_ffi_fat_ok_arm — the SUCCESS arm's wrapper build for a fat-payload host-FFI result
 * (`str | error`'s `str`, `[]str | error`'s `[]str`): tag = the fat member's declared index,
 * payload = the loaded `(ptr, len)` pair written straight into the wrapper's own fat payload slot
 * (`store_fat_variant_payload_pair`) — no boxing, a fat member being one the uniform 24-byte
 * wrapper already reserves both halves for (degrau 6). A `[]str` slice's element layout IS an array
 * of `tk_str`, so the runtime's `(entries, count)` pair is the fat payload unchanged.
 *
 * @param ctx      the lowering context, positioned in the ok arm's own block, past its own load
 * @param wrapper  the wrapper's alloca'd base address (already reserved, 24 bytes)
 * @param index    the fat member's declared tag index
 * @param ptr      the value's pointer half, already loaded out of the runtime's out-slot
 * @param len      the value's length half, already loaded out of the runtime's out-slot
 * @param line     the source line to stamp the emitted instructions with
 * @param col      the source column to stamp the emitted instructions with
 * @return         the advanced context; `wrapper` is the arm's own result
 */
fn lower_ffi_fat_ok_arm(ctx: LowerCtx, wrapper: u32, index: i64, ptr: u32, len: u32, line: u32, col: u32) -> LowerCtx {
    let tagged = store_variant_tag(ctx, wrapper, index, line, col)
    store_fat_variant_payload_pair(tagged.ctx, wrapper, ptr, len, line, col)
}

/**
 * lower_ffi_error_arm — the FAILURE arm's wrapper build for any aggregate-returning host-FFI
 * result: tag = the `error` member's declared index, payload = a boxed `error { message = … }`
 * carrying the runtime's own failure text, already loaded out of the two out-slots the twin writes
 * its message into (the `tk_rt_*_ok` family writes the failure message there instead of a value) —
 * built by hand through the SAME `error_struct_layout`/`store_fat_slot`/`box_aggregate_value`
 * primitives `lower_last_index_of_error_arm` uses, differing only in WHERE the message's
 * `(ptr, len)` pair comes from (a real load here, a hardcoded empty pair there — `last_index_of`'s
 * own "not-found is the only failure"). Shared by `str_from_utf8` and the whole twin family.
 *
 * @param ctx      the lowering context, positioned in the error arm's own block, past its own load
 * @param wrapper  the wrapper's alloca'd base address (already reserved, 24 bytes)
 * @param index    the `error` member's declared tag index
 * @param msg_ptr  the failure message's pointer half, already loaded out of the runtime's out-slot
 * @param msg_len  the failure message's length half, already loaded out of the runtime's out-slot
 * @param e        the call expression (source position only, threaded to `box_aggregate_value`)
 * @return         the advanced context; `wrapper` is the arm's own result
 * @throws         propagated from `variant_payload_box_bytes` (never actually thrown for `error`
 *                 — its layout is always registered — kept honest rather than assumed)
 * @since 0.3.1.0 degrau 21; degrau 22 grew the manual build to zero the five diagnostic fields
 *        the grown `error_struct_layout` now reserves alongside `message`; degrau 34 shared it
 *        across the env/io/fs twin family
 */
fn lower_ffi_error_arm(ctx: LowerCtx, wrapper: u32, index: i64, msg_ptr: u32, msg_len: u32, e: checker::TExpr) -> LowerCtx | error {
    let tagged = store_variant_tag(ctx, wrapper, index, e.line, e.col)
    let layout = error_struct_layout()
    let base = ctx_alloc(tagged.ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, layout.size, layout.align, e.line, e.col))
    let msg = LoweredFat { ctx = with_alloca; ptr = msg_ptr; len = msg_len }
    let with_msg = store_fat_slot(with_alloca, base.vreg, msg, e.line, e.col)
    let with_zeroed = zero_error_diagnostics(with_msg, base.vreg, layout, 1, e.line, e.col)
    let box_bytes = match variant_payload_box_bytes(checker::Error { }, with_zeroed) { u32 as n => n; error as err => return err }
    let owned = box_aggregate_value(Lowered { ctx = with_zeroed; vreg = base.vreg }, box_bytes, e)
    let paddr = ctx_alloc(owned.ctx)
    let with_paddr = ctx_append(paddr.ctx, field_addr_inst(paddr.vreg, wrapper, variant_payload_offset(), e.line, e.col))
    ctx_append(with_paddr, store_inst(paddr.vreg, owned.vreg, LType::Ptr, e.line, e.col))
}

/**
 * lower_str_from_utf8_call — `teko::text::str_from_utf8(bytes) -> str | error` (0.3.1.0 degrau
 * 21): the runtime's real ABI (`tk_ffi_sres`, `{bool ok; tk_str value; tk_str err}` — 40 bytes,
 * SysV MEMORY class → SRET) is wider than this backend's `LCall` can capture (it reads ONE result
 * register, `select_call_result_x86`/`select_call_result_arm64`), so a dedicated runtime twin
 * (`tk_rt_str_from_utf8_ok`, `teko_rt.c`/`.h`) carries the found/failed flag as its OWN
 * single-register `bool` return and the ACTIVE case's `(ptr, len)` pair through two out-parameters.
 * The whole branch-and-build is now the shared `lower_ffi_fat_or_error_call` (degrau 34), routed
 * here with the `str` ok member; the one `[]byte` argument lowers as a fat pair like any other.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `str | error`)
 * @param c    the call node (its one `[]byte` argument)
 * @return     the advanced context + the wrapper's base-address VReg
 * @throws     when the call's own arity is not one, when `e.type` is not the expected variant, or
 *             propagated from lowering the argument
 * @since 0.3.1.0 degrau 21
 */
fn lower_str_from_utf8_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `str_from_utf8` expects exactly one []byte argument (internal)" }
    }
    lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_str_from_utf8_ok", checker::Str { })
}

