use teko::checker
use teko::lexer
use teko::parser

/**
 * store_assign_aggregate_ref — the AGGREGATE arm of `lower_assign_ref_deref`: `memcpy` the new
 * value's OWN bytes (its already-lowered address, `lower_value_into_type`) into the handle's
 * pointee storage, sized to the WHOLE-TYPE byte width `aggregate_box_bytes` already computes for
 * degrau 4's push-boxing (the same question — "how many bytes IS a value of this type, so a
 * container that holds it BY ADDRESS can own a copy" — asked of a REFERENCE'S pointee instead of
 * a slice's pushed element). No LIR memcpy op exists (degrau 4's own reasoning for the runtime
 * touch applies unchanged): `tk_mem_copy` is the one-line runtime entry. A compound `op=` is
 * refused — no arithmetic operator applies to an aggregate, mirroring `store_assign_fat_ref`'s
 * SAME refusal for a fat target.
 *
 * @param ctx   the lowering context
 * @param addr  the `Ref<T>` handle's own value (the address to write through)
 * @param a     the typed assignment (kind `RefDeref`, an aggregate `bound`)
 * @return      the context with the copy appended, or an honest stop
 * @throws      for a compound `op=`, for an aggregate this backend pins no whole-type byte width
 *              for (`unsized_aggregate_ref_stop`), or propagated from lowering the value
 */
fn store_assign_aggregate_ref(ctx: LowerCtx, addr: u32, a: checker::TAssign) -> LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign {
        return error { message = "native backend N1: compound assignment to an aggregate reference has no arithmetic form (internal)" }
    }
    let width = match aggregate_box_bytes(a.bound, ctx) { u32 as n => n; null => return unsized_aggregate_ref_stop(a.bound) }
    let vo = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
    let wr = ctx_alloc(vo.ctx)
    let with_width = ctx_append(wr.ctx, const_int_inst(wr.vreg, width to i64, a.value.line, a.value.col))
    let args = teko::list::push(two_args(addr, vo.vreg), wr.vreg)
    let inst = void_call_inst("tk_mem_copy", args, false, a.value.line, a.value.col)
    LowerStmtOut { ctx = ctx_append(with_width, inst); terminated = false }
}

/**
 * unsized_aggregate_ref_stop — the NAMED honest stop for `store_assign_aggregate_ref`: a
 * reference deref-assignment whose target is an aggregate this backend cannot pin a WHOLE-TYPE
 * byte width for (`aggregate_form_name`'s two still-open forms — an optional, a closure).
 *
 * @param t  the aggregate type this backend assigns no whole-type byte width
 * @return   the honest stop, always
 */
fn unsized_aggregate_ref_stop(t: checker::Type) -> error {
    error { message = teko::str::concat("native backend N1: a reference deref-assignment whose target is ", teko::str::concat(aggregate_form_name(t), " — this copies the new value's bytes directly into the handle's pointee storage, which needs a byte width the type alone fixes (N2)")) }
}

/**
 * fat_compound_stop — the NAMED refusal EVERY fat (`str`/`[]T`) assignment target shares: no
 * arithmetic operator applies to a two-word `{ptr, len}` value, so a compound `op=` has no form to
 * lower at all. ONE function, because the four fat targets — a `Ref<T>` handle, a struct/class
 * field, a mutable local and a slice element — otherwise carry four independently-worded refusals,
 * which is the shape that decays into three worded and one silent.
 *
 * @param target  the target's description, as the message spells it
 * @return        the honest stop, always
 */
fn fat_compound_stop(target: str) -> error {
    error { message = teko::str::concat("native backend N1: compound assignment to ", teko::str::concat(target, " has no arithmetic form (internal)")) }
}

/**
 * store_fat_through_addr — write a `str`/`[]T` value's BOTH halves through an already-computed
 * address (`store_fat_slot`, the SAME memory shape a mutable fat local's own frame slot holds).
 *
 * The single tail of every fat assignment whose target is reached BY ADDRESS: a `Ref<T>` handle
 * (`lower_assign_ref_deref`), a struct/class field (`lower_assign_field`), a mutable fat local's
 * frame slot (`lower_assign_fat`) and a slice element (`store_assign_elem`). Writing ONE machine
 * word at such an address — which the plain `store_assign_value` does — stores the pointer half
 * only and leaves every later reader taking whatever length the slot happened to hold already,
 * silently (0.3.1.0 raiz-comum §5.2).
 *
 * @param ctx     the lowering context, positioned after the target's address is computed
 * @param addr    the target slot's address VReg
 * @param a       the typed assignment (a `str`/`[]T` `bound`)
 * @param target  the target's description for the compound-op refusal (`fat_compound_stop`)
 * @return        the context with both halves stored
 * @throws        for a compound `op=`, or propagated from lowering the value as a fat producer
 */
fn store_fat_through_addr(ctx: LowerCtx, addr: u32, a: checker::TAssign, target: str) -> LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign { return fat_compound_stop(target) }
    let fo = match lower_fat_expr(ctx, a.value) { LoweredFat as x => x; error as err => return err }
    LowerStmtOut { ctx = store_fat_slot(fo.ctx, addr, fo, a.value.line, a.value.col); terminated = false }
}

/**
 * lower_assign_simple — `name = e` rebinds the env to the newly-lowered value (an SSA-lite shadow,
 * exactly like a `let`); `name op= e` reads the CURRENT vreg, applies the arithmetic op, and
 * rebinds to the result. The plain `=` path lowers through `lower_value_into_type` against the
 * target's DECLARED type (`a.bound`), so re-assigning into a `T | null` local rebuilds the
 * tag+payload wrapper the binding established — assigning the raw value would leave a later
 * `match` reading a payload as a base address. A compound `op=` needs a `PrimKind` and so can
 * never target a union.
 *
 * A str/slice target is written THROUGH ITS FRAME SLOT (`lower_assign_fat`): a fat local's value is
 * a PAIR, and rebinding only the pointer half — which is what the scalar path did, since
 * `lenv_reassign` refuses to rewrite a fat binding in place — silently kept the OLD length, so
 * `loop { xs = teko::list::push(xs, …) }` read back its original length forever (list-builtin
 * degrau).
 *
 * An address-taken `mut` scalar target (`lenv_lookup_scalar_slot`, 0.3.1.0 degrau 18) is ALSO
 * written THROUGH ITS FRAME SLOT rather than by rebinding the env: a plain SSA rebind
 * (`ctx_reassign`) would be invisible to a read made through the escaped `Ref<T>` handle, and — the
 * other direction — a write made through that SAME handle must be visible to a later PLAIN read of
 * the name. `store_assign_value` (a struct-field write's own tail) already implements exactly
 * this shape (a plain `=` through `lower_value_into_type`, a compound `op=` via load-compute-store)
 * against an arbitrary address, reused verbatim.
 *
 * @param LowerCtx ctx  the lowering context to append the assignment's instructions into
 * @param checker::TAssign a  the typed assignment (kind `Simple`)
 * @return LowerStmtOut | error  the context with the name re-bound, or an honest stop
 * @throws  when the name is unbound, the compound operator/type has no LIR op, or propagated
 *          from lowering the value
 */
fn lower_assign_simple(ctx: LowerCtx, a: checker::TAssign) -> LowerStmtOut | error {
    if is_fat_type(a.bound) { return lower_assign_fat(ctx, a) }
    let slot = lenv_lookup_scalar_slot(ctx.env, a.name)
    if slot.found { return store_assign_value(ctx, slot.slot, slot.ty, a) }
    if aggregate_local_is_aliased(ctx, a) { return aliased_aggregate_write_through(ctx, a) }
    if a.op == lexer::TokenKind::Assign {
        let raw = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
        let vo = own_bound_value(raw, a.value)
        return LowerStmtOut { ctx = ctx_reassign(vo.ctx, a.name, vo.vreg); terminated = false }
    }
    let cur = lenv_lookup(ctx.env, a.name)
    if !cur.found { return error { message = teko::str::concat("native backend N1: unbound local `", a.name, "` (internal)") } }
    let vo = match lower_expr(ctx, a.value) { Lowered as x => x; error as err => return err }
    let k = match prim_kind_of(a.bound, ctx.enums, "range bound") { checker::PrimKind as p => p; error as err => return err }
    let plain = match plain_op_of_compound(a.op) { lexer::TokenKind as t => t; error as err => return err }
    let op = match lbinop_of(plain, k) { LBinOp as o => o; error as err => return err }
    let guarded = if is_int_div_or_rem(op) { lower_div_zero_guard(vo.ctx, vo.vreg, a.value.line, a.value.col) } else { vo.ctx }
    let r = ctx_alloc(guarded)
    let inst = bin_inst(r.vreg, op, cur.vreg, vo.vreg, a.value.line, a.value.col)
    LowerStmtOut { ctx = ctx_reassign(ctx_append(r.ctx, inst), a.name, r.vreg); terminated = false }
}

/**
 * aggregate_local_is_aliased — is `a`'s target an AGGREGATE local some `ref` binding in this
 * function aliases (`ctx.addr_taken`, fed by `addr_taken_ref_binding`)? Only then does a plain
 * `name = e` owe a write-through instead of the ordinary SSA-lite rebind.
 *
 * @param ctx  the lowering context (its `addr_taken` set and declared-enum table)
 * @param a    the typed assignment (kind `Simple`)
 * @return     whether this target must be written through rather than rebound
 * @since      0.3.1 (own-backend `ref`-binding placement gap)
 */
fn aggregate_local_is_aliased(ctx: LowerCtx, a: checker::TAssign) -> bool {
    contains_str(ctx.addr_taken, a.name) && !is_register_value_type(a.bound, ctx.enums)
}

/**
 * aliased_aggregate_write_through — `name = e` on an AGGREGATE local a `ref` aliases: copy the new
 * value's bytes INTO the local's existing storage and leave the env binding alone, so the name and
 * every reference to it keep naming the SAME cell.
 *
 * The ordinary path rebinds the name to the new value's own fresh storage (an SSA-lite shadow),
 * which is invisible through an alias by construction — `mut d = Ch { open = true }; ref r = d;
 * d = Ch { open = false }` left `r` reading the bytes of the FIRST literal for ever, where the C
 * route, which holds `d` inline and assigns it field for field, answered `false`. It is the SAME
 * "only memory survives" rule a mutable fat local (`bind_mutable_fat`) and an address-taken scalar
 * (`bind_addr_taken_scalar`) already obey, at the one shape that had no reason to obey it until a
 * `ref` could name an aggregate local.
 *
 * `store_assign_aggregate_ref` is reused verbatim: writing the whole of an aggregate through an
 * already-computed address is exactly what a `ref` DEREF-assignment does, and an aggregate local's
 * own VReg IS that address (§ NATIVE-AGG-SLICE-BY-ADDRESS).
 *
 * @param ctx  the lowering context
 * @param a    the typed assignment (kind `Simple`, an aggregate `bound`)
 * @return     the context with the copy appended, the binding unchanged
 * @throws     when the name is unbound (an internal invariant break), or propagated from
 *             `store_assign_aggregate_ref`
 * @since      0.3.1 (own-backend `ref`-binding placement gap)
 */
fn aliased_aggregate_write_through(ctx: LowerCtx, a: checker::TAssign) -> LowerStmtOut | error {
    let cur = lenv_lookup(ctx.env, a.name)
    if !cur.found { return error { message = teko::str::concat("native backend N1: unbound aliased local `", a.name, "` (internal)") } }
    store_assign_aggregate_ref(ctx, cur.vreg, a)
}

/**
 * lower_assign_fat — `name = e` where `name` is a str/slice local: lower the value through the FAT
 * path and store BOTH halves into the local's frame slot, so every later read (in this block, in
 * the next loop iteration, after the enclosing `if`) sees the new pointer AND the new length.
 *
 * A fat target that is not slot-bound honest-stops by name: a fat PARAMETER and an immutable `let`
 * both live in a VReg pair that no merge threads, so writing one would produce exactly the stale
 * length this function exists to remove. Only `mut` locals (`bind_mutable_fat`) are assignable
 * targets in Teko, so the stop is unreachable from well-typed source and stands as an invariant
 * guard (list-builtin degrau).
 *
 * @param ctx  the lowering context
 * @param a    the typed assignment (kind `Simple`, a str/slice `bound`)
 * @return     the context with both halves stored
 * @throws     for a compound `op=` on a fat local (no arithmetic operator applies to a slice), for
 *             a non-slot fat target, or propagated from lowering the value
 */
fn lower_assign_fat(ctx: LowerCtx, a: checker::TAssign) -> LowerStmtOut | error {
    let slot = lenv_lookup_fat_slot(ctx.env, a.name)
    if !slot.found {
        return error { message = teko::str::concat("native backend N1: `", a.name, "` is assigned but is not a mutable fat local (internal)") }
    }
    if is_frees_old_self_append(ctx, a) { return lower_assign_frees_old(ctx, slot.slot, a) }
    if checker::assign_is_self_append(a) { return lower_assign_plain_self_append(ctx, slot.slot, a) }
    store_fat_through_addr(ctx, slot.slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
}

/**
 * SelfAppendBracket — the outcome of `enter_self_append_region`: the (possibly bracketed) context +
 * whether a bracket was actually opened, so the matching `leave_self_append_region` knows whether to
 * emit its own closing call.
 * @since 0.3.1
 */
type SelfAppendBracket = struct { ctx: LowerCtx; opened: bool }

