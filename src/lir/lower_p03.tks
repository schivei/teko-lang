use teko::checker
use teko::lexer
use teko::parser

/**
 * lbinop_int — the integer LBinOp for an operator token, the signed/unsigned variant chosen
 * by `signed`. Covers the arithmetic subset (`+ - * / %`), the bitwise operators (`& | ^`),
 * and the shifts: `<<` is signedness-agnostic (IShl), while `>>` picks the arithmetic
 * (IShrS) or logical (IShrU) right shift by `signed` — the shift's result carries the LEFT
 * operand's type, so `signed` there is the shifted value's signedness, exactly as the
 * checker types it.
 *
 * @param op      the binary operator token
 * @param signed  true when the result's integer type is signed (selects IDivS/IRemS/IShrS
 *                over the IDivU/IRemU/IShrU variants)
 * @return        the integer LBinOp the operator lowers to
 * @throws        when the token is not an integer arithmetic/bitwise/shift operator
 */
fn lbinop_int(op: lexer::TokenKind, signed: bool) -> LBinOp | error {
    match op {
        lexer::TokenKind::Plus => LBinOp::IAdd
        lexer::TokenKind::Minus => LBinOp::ISub
        lexer::TokenKind::Star => LBinOp::IMul
        lexer::TokenKind::Slash => if signed { LBinOp::IDivS } else { LBinOp::IDivU }
        lexer::TokenKind::Percent => if signed { LBinOp::IRemS } else { LBinOp::IRemU }
        lexer::TokenKind::Amp => LBinOp::IAnd
        lexer::TokenKind::Pipe => LBinOp::IOr
        lexer::TokenKind::Caret => LBinOp::IXor
        lexer::TokenKind::Shl => LBinOp::IShl
        lexer::TokenKind::Shr => if signed { LBinOp::IShrS } else { LBinOp::IShrU }
        _ => error { message = "native backend N1: integer operator not yet lowered (N2)" }
    }
}

/**
 * is_int_div_or_rem — true for the four integer division/remainder `LBinOp` variants
 * (`IDivS`/`IDivU`/`IRemS`/`IRemU`) — the opcodes a zero divisor corrupts on EITHER real
 * target (x86-64 traps on `idiv`/`div` by ISA accident, arm64's `SDIV`/`UDIV` defines a
 * SILENT zero result) unless the compiler itself guards the divisor first.
 *
 * @param op  the `LBinOp` to classify
 * @return    whether `op` is an integer divide or remainder
 */
fn is_int_div_or_rem(op: LBinOp) -> bool {
    op == LBinOp::IDivS || op == LBinOp::IDivU || op == LBinOp::IRemS || op == LBinOp::IRemU
}

/**
 * lower_div_zero_guard — the compiler-organized division/remainder-by-zero guard (owner
 * ruling 2026-07-29: an ISA ACCIDENT is never a guard — x86-64's `idiv`/`div` `#DE` trap and
 * arm64's architecturally-defined "`SDIV`/`UDIV` by zero yields 0" must agree BY
 * CONSTRUCTION, not by the coincidence of whichever host ISA happens to compile the
 * program). Lowered ONCE, in the target-neutral LIR — every caller (`lower_binary`'s plain
 * `/`/`%`, `lower_assign_simple`/`store_assign_value`'s compound `/=`/`%=`) reaches this
 * SAME shape, so `isel_x86_64`/`isel_arm64` select it through their existing, already-tested
 * compare/branch/call machinery (the SAME idiom `lower_logical`'s `&&`/`||` and every
 * `if`/`match` condition already lowers to) — neither backend needs its OWN div-by-zero
 * special case.
 *
 * Compares the divisor against a materialized zero (`ICmpNe`, fused into the branch exactly
 * like any other condition), continuing into a fresh "ok" block when nonzero; a zero divisor
 * branches into a fresh "trap" block that calls the runtime's `tk_panic_div0` — the SAME
 * symbol `teko_rt.h`'s `tk_div_*`/`tk_mod_*` helpers already call on the C route, so both
 * routes panic with the identical message and exit status — then closes with a JUMP TO
 * ITSELF: a dead terminator (the call never returns) that keeps the block well-formed
 * without inventing a placeholder return value the enclosing function's own type may not
 * even have room for (unlike `terminate_diverging_stmt`, which needs exactly that and
 * refuses a fat return type — this guard fires inside arbitrary EXPRESSION lowering, where a
 * fat-returning function must still compile).
 *
 * @param ctx      the lowering context, positioned right after the divisor is lowered
 * @param divisor  the already-lowered divisor VReg to guard
 * @param line     the source line of the division/remainder expression
 * @param col      the source column of the division/remainder expression
 * @return         the advanced context, now emitting into the "ok" block — the divisor is
 *                 proven nonzero on every path that reaches it
 */
fn lower_div_zero_guard(ctx: LowerCtx, divisor: u32, line: u32, col: u32) -> LowerCtx {
    let z = ctx_alloc(ctx)
    let with_zero = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    let c = ctx_alloc(with_zero)
    let with_cmp = ctx_append(c.ctx, bin_inst(c.vreg, LBinOp::ICmpNe, divisor, z.vreg, line, col))
    lower_trap_unless(with_cmp, c.vreg, "tk_panic_div0", line, col)
}

/**
 * lower_trap_unless — the compare-then-trap skeleton EVERY compiler-organized runtime guard
 * shares: continue into a fresh "ok" block when `cond` holds, and branch into a fresh "trap"
 * block that calls `panic_symbol` when it does not. Extracted so the division-by-zero guard
 * (`lower_div_zero_guard`) and the cast fit guard (`lower_cast_fit_guard`) cannot drift — a
 * guard whose trap block were built one way here and another way there is exactly the pair of
 * twins that decays into one of them being fixed and the other not.
 *
 * The trap block closes with a JUMP TO ITSELF: a dead terminator (the `_Noreturn` runtime call
 * never comes back) that keeps the block well-formed without inventing a placeholder return
 * value the enclosing function's own type may not even have room for. Both guards fire inside
 * arbitrary EXPRESSION lowering, where a fat-returning function must still compile.
 *
 * @param ctx           the lowering context, positioned right after `cond` is computed
 * @param cond          the VReg holding the "everything is fine" condition (nonzero = fine)
 * @param panic_symbol  the `_Noreturn` runtime symbol the trap block calls (`tk_panic_div0`,
 *                      `tk_panic_cast`) — the SAME symbol the C route's own helper calls, so
 *                      both routes panic with the identical message and exit status
 * @param line          the source line of the guarded expression
 * @param col           the source column of the guarded expression
 * @return              the advanced context, now emitting into the "ok" block — `cond` is
 *                      proven true on every path that reaches it
 */
fn lower_trap_unless(ctx: LowerCtx, cond: u32, panic_symbol: str, line: u32, col: u32) -> LowerCtx {
    lower_trap_unless_with(ctx, cond, panic_symbol, teko::list::empty(), line, col)
}

/**
 * lower_trap_unless_with — `lower_trap_unless` for a panic entry that takes ARGUMENTS: the same
 * compare-then-trap skeleton, with `args` handed to the `_Noreturn` runtime call inside the trap
 * block. The POSITIONED panics need it (`tk_panic_oob_at(line, col)`, the entry the C route's own
 * index guard calls), and the argumentless ones (`tk_panic_div0`, `tk_panic_cast`) are the same
 * function with an empty list — one skeleton, so a guard added later cannot be built a second way.
 *
 * The argument VRegs must be materialized by the CALLER, before `cond` is computed: they are read
 * inside the trap block, which the branch reaches from this block, so a value produced after the
 * branch would not dominate its use.
 *
 * @param ctx           the lowering context, positioned right after `cond` is computed
 * @param cond          the VReg holding the "everything is fine" condition (nonzero = fine)
 * @param panic_symbol  the `_Noreturn` runtime symbol the trap block calls
 * @param args          the already-materialized argument VRegs, in the runtime entry's own order
 * @param line          the source line of the guarded expression
 * @param col           the source column of the guarded expression
 * @return              the advanced context, now emitting into the "ok" block
 */
fn lower_trap_unless_with(ctx: LowerCtx, cond: u32, panic_symbol: str, args: []u32, line: u32, col: u32) -> LowerCtx {
    let okb = alloc_block(ctx.func)
    let trapb = alloc_block(okb.func)
    let br = branch_inst(cond, okb.block_id, teko::list::empty(), trapb.block_id, teko::list::empty(), line, col)
    let branched = ctx_append(ctx_with(ctx, trapb.func, ctx.block_id, ctx.env), br)
    let trap_ctx = ctx_goto(branched, trapb.block_id)
    let called = ctx_append(trap_ctx, void_call_inst(panic_symbol, args, false, line, col))
    let trap_closed = ctx_append(called, jump_inst(trapb.block_id, teko::list::empty(), line, col))
    ctx_with(trap_closed, trap_closed.func, okb.block_id, branched.env)
}

/**
 * lunop_of — the LUnOp for a prefix operator token given the operand's PrimKind. `-` picks
 * FNeg/INeg by family; `~` (bitwise one's-complement, integer-only per the checker) picks
 * INot. `!` (logical-not) is NOT handled here — it is intercepted in lower_unary and lowered
 * to a logical `operand == 0` (see lower_logical_not), so `!` never reaches the bitwise
 * LUnOp::INot (the F1c miscompile is gone); `~`, a genuine one's-complement, DOES.
 *
 * @param op  the prefix operator token
 * @param k   the operand's PrimKind (selects the float/int family for `-`)
 * @return    the negation LUnOp for `-` (INeg/FNeg), or INot for `~`
 * @throws    for any operator other than `-`/`~` (`!` is handled by lower_unary)
 */
pub fn lunop_of(op: lexer::TokenKind, k: checker::PrimKind) -> LUnOp | error {
    match op {
        lexer::TokenKind::Minus => if prim_is_float_kind(k) { LUnOp::FNeg } else { LUnOp::INeg }
        lexer::TokenKind::Tilde => LUnOp::INot
        _ => error { message = "native backend N1: unary operator not yet lowered (N2)" }
    }
}

/**
 * cast_unop_of — the conversion LUnOp for a numeric `to` cast between two FLOAT-INVOLVED
 * machine classes: int->float = IToF, float->int = FToI, float->float = FToF. The int->int
 * family never reaches here: it carries no conversion instruction at all
 * (`lower_int_cast` — a value proven to FIT its destination already holds the destination's
 * own 64-bit two's-complement bit pattern), so there is no `Trunc` opcode left for an
 * integer `to` to select.
 *
 * @param src  the cast operand's PrimKind (at least one of the pair is a float)
 * @param dst  the cast target's PrimKind
 * @return     the conversion LUnOp for the float-involved pair
 * @throws     when BOTH ends are integers — that pair belongs to `lower_int_cast` and must
 *             never reach an opcode choice here, so the invariant break stops loudly instead
 *             of silently selecting an extend that would drop the guard with it
 */
fn cast_unop_of(src: checker::PrimKind, dst: checker::PrimKind) -> LUnOp | error {
    let src_f = prim_is_float_kind(src)
    let dst_f = prim_is_float_kind(dst)
    if src_f && dst_f { return LUnOp::FToF }
    if src_f { return LUnOp::FToI }
    if dst_f { return LUnOp::IToF }
    error { message = "native backend: an int->int `to` cast carries no conversion opcode — it is lowered by `lower_int_cast` (the fit guard), never by `cast_unop_of`" }
}

/** The lowest value an `i8` destination represents — the `to i8` guard's floor. */
const CAST_FLOOR_I8: i64 = -128
/** The highest value an `i8` destination represents — the `to i8` guard's ceiling. */
const CAST_CEIL_I8: i64 = 127
/** The lowest value an `i16` destination represents — the `to i16` guard's floor. */
const CAST_FLOOR_I16: i64 = -32768
/** The highest value an `i16` destination represents — the `to i16` guard's ceiling. */
const CAST_CEIL_I16: i64 = 32767
/** The lowest value an `i32` destination represents — the `to i32` guard's floor. */
const CAST_FLOOR_I32: i64 = -2147483648
/** The highest value an `i32` destination represents — the `to i32` guard's ceiling. */
const CAST_CEIL_I32: i64 = 2147483647
/** The highest value an `i64` destination represents — the `to i64` guard's ceiling. */
const CAST_CEIL_I64: i64 = 9223372036854775807
/** The lowest value ANY unsigned destination represents — every unsigned guard's floor. */
const CAST_FLOOR_UNSIGNED: i64 = 0
/** The highest value a `u8`/`byte` destination represents — the `to u8` guard's ceiling. */
const CAST_CEIL_U8: i64 = 255
/** The highest value a `u16` destination represents — the `to u16` guard's ceiling. */
const CAST_CEIL_U16: i64 = 65535
/** The highest value a `u32` destination represents — the `to u32` guard's ceiling. */
const CAST_CEIL_U32: i64 = 4294967295

/**
 * The half-open interval a narrowing `to`'s operand must land inside for the conversion to be
 * value-preserving. Either end may be ABSENT: a bound the source type cannot reach is not a
 * check, it is a tautology, and emitting it would cost a compare and a branch per cast to
 * prove something the type system already proved.
 */
type CastFitBounds = struct {
    /** Whether the operand must be compared against `floor` at all. */
    has_floor: bool
    /** The lowest value the destination represents, as the LIR's i64 register carrier. */
    floor: i64
    /** Whether the operand must be compared against `ceil` at all. */
    has_ceil: bool
    /** The highest value the destination represents, as the LIR's i64 register carrier. */
    ceil: i64
}

/**
 * cast_signed_dst_bounds — the fit interval for a SIGNED destination, as the LIR i64 carrier
 * holds it. `i64` has no ceiling to check from a signed source (the carrier IS an i64) and no
 * floor either, which is why only the narrower three carry both ends.
 *
 * @param dst  the signed destination PrimKind
 * @return     the destination's own representable interval
 */
fn cast_signed_dst_bounds(dst: checker::PrimKind) -> CastFitBounds {
    if dst == checker::PrimKind::I8 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I8; has_ceil = true; ceil = CAST_CEIL_I8 } }
    if dst == checker::PrimKind::I16 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I16; has_ceil = true; ceil = CAST_CEIL_I16 } }
    if dst == checker::PrimKind::I32 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_I32; has_ceil = true; ceil = CAST_CEIL_I32 } }
    CastFitBounds { has_floor = false; floor = 0; has_ceil = true; ceil = CAST_CEIL_I64 }
}

/**
 * cast_unsigned_dst_bounds — the fit interval for an UNSIGNED destination. The floor is always
 * zero (a negative value never fits an unsigned type — the case the C route's `tk_to_u*_s`
 * helpers reject first). `u64`'s ceiling is `U64_MAX`, which the LIR's i64 register carrier
 * cannot spell, and it never needs to: a `u64` destination is only ever narrowing from a
 * SIGNED source (an unsigned source is at most 64 bits wide, hence always a lossless widen),
 * and every non-negative i64 fits a u64. So `u64` carries the floor alone.
 *
 * @param dst  the unsigned destination PrimKind
 * @return     the destination's own representable interval
 */
fn cast_unsigned_dst_bounds(dst: checker::PrimKind) -> CastFitBounds {
    if dst == checker::PrimKind::U8 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U8 } }
    if dst == checker::PrimKind::U16 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U16 } }
    if dst == checker::PrimKind::U32 { return CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = true; ceil = CAST_CEIL_U32 } }
    CastFitBounds { has_floor = true; floor = CAST_FLOOR_UNSIGNED; has_ceil = false; ceil = 0 }
}

