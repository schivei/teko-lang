use teko::checker
use teko::lexer
use teko::parser

/**
 * element_addr_at — `base + index * stride` for an index ALREADY in a VReg: a NON-constant index
 * multiplies through an ordinary `IMul` then `IAdd`s onto `base`, because `LFieldAddr.offset` only
 * ever carries a compile-time constant, so a runtime-computed byte offset is plain integer
 * arithmetic on the address VReg instead (the plan's §2.1 resolution).
 *
 * The index arrives as a VReg rather than as an expression so that the element WRITE and the
 * element READ — both of which must lower their index exactly once, because the bounds guard and
 * the address both read it — compute the very same address. Two open-coded copies of a stride
 * multiply are two chances for a write to land one element away from where the read looks.
 *
 * @param ctx     the lowering context, positioned after `index` is lowered
 * @param base    the buffer's base address VReg
 * @param index   the already-lowered element index VReg
 * @param stride  the element's byte stride inside the buffer (`elem_byte_stride`)
 * @param line    the source line of the subscript
 * @param col     the source column of the subscript
 * @return        the element's address
 */
fn element_addr_at(ctx: LowerCtx, base: u32, index: u32, stride: u32, line: u32, col: u32) -> Lowered {
    let sc = ctx_alloc(ctx)
    let with_stride = ctx_append(sc.ctx, const_int_inst(sc.vreg, stride to i64, line, col))
    let mr = ctx_alloc(with_stride)
    let with_mul = ctx_append(mr.ctx, bin_inst(mr.vreg, LBinOp::IMul, index, sc.vreg, line, col))
    let ar = ctx_alloc(with_mul)
    Lowered { ctx = ctx_append(ar.ctx, bin_inst(ar.vreg, LBinOp::IAdd, base, mr.vreg, line, col)); vreg = ar.vreg }
}

/**
 * index_addr — the element address for `recv[index]` whose index is ALREADY lowered into
 * `index_vreg`: `const_index_addr` when `index` is a literal integer (the whole byte offset folds
 * into a single instruction), else `element_addr_at`'s runtime stride arithmetic.
 *
 * The index is handed in as a VReg instead of being lowered here because every caller bounds-checks
 * it first (`guarded_index_addr`), and an index expression lowered a second time for the address
 * would EVALUATE a second time — a side-effecting index would run twice, and the address could even
 * be computed from a different number than the one the guard proved in range.
 *
 * @param ctx         the lowering context, positioned after the index is lowered and checked
 * @param base        the buffer's base address VReg
 * @param index       the index expression, consulted only for its literal-or-not shape
 * @param index_vreg  the already-lowered index VReg
 * @param stride      the element's byte stride inside the buffer (`elem_byte_stride`)
 * @param line        the source line of the subscript
 * @param col         the source column of the subscript
 * @return            the element's address
 */
fn index_addr(ctx: LowerCtx, base: u32, index: checker::TExpr, index_vreg: u32, stride: u32, line: u32, col: u32) -> Lowered {
    match index.kind {
        checker::TNumber as n => if n.is_float { element_addr_at(ctx, base, index_vreg, stride, line, col) } else { const_index_addr(ctx, base, parser::numint_to_i64(n.value), stride, line, col) }
        _ => element_addr_at(ctx, base, index_vreg, stride, line, col)
    }
}

/**
 * guarded_index_addr — the BOUNDS-CHECKED element address of a READ subscript, the sibling of the
 * element write's own guarded address (`lower_assign_index`, 0.3.1.0 degrau 28). It closes the read
 * half of the same hole: `lower_index_slice`/`lower_index_fat`/`lower_index_str` computed an element
 * address with NO guard at all, so `xs[5]` on a three-element slice read whatever byte followed the
 * buffer and printed it, exit 0, while the C route's `emit_index` panicked at the same subscript —
 * a silent wrong VALUE, which under the oracle rule is a native bug until proven otherwise.
 *
 * The index is lowered EXACTLY ONCE and shared by the guard and the address (`index_addr` takes the
 * VReg): re-lowering it would evaluate a side-effecting index expression twice, and could address a
 * different element than the one the guard cleared. The trap calls the SAME positioned
 * `tk_panic_oob_at(line, col)` the C route's read guard and this backend's write guard both call, so
 * all three locate an out-of-bounds subscript with an identical message and position.
 *
 * @param ctx     the lowering context
 * @param base    the receiver's buffer base address VReg (a fat value's ptr half)
 * @param len     the receiver's already-lowered length VReg (its fat value's len half)
 * @param index   the index expression
 * @param stride  the element's byte stride inside the buffer (`elem_byte_stride`)
 * @param line    the source line of the subscript
 * @param col     the source column of the subscript
 * @return        the element's address, reached only when the index is inside `len`
 * @throws        propagated from lowering the index expression
 */
fn guarded_index_addr(ctx: LowerCtx, base: u32, len: u32, index: checker::TExpr, stride: u32, line: u32, col: u32) -> Lowered | error {
    let io = match lower_expr(ctx, index) { Lowered as x => x; error as err => return err }
    let checked = lower_index_bounds_guard(io.ctx, io.vreg, len, line, col)
    index_addr(checked, base, index, io.vreg, stride, line, col)
}

/**
 * lower_index — `recv[index]`: a `str` receiver (A1-4, #382) indexes its BYTE at the fat pointer's
 * ptr half (element class I8, stride 1); a `[]T` receiver indexes its Slice element. Either way the
 * index is BOUNDS-CHECKED first (`guarded_index_addr`) and the address is then folded when `index`
 * is a constant, else computed via `element_addr_at`'s runtime multiply.
 *
 * @param ctx  the lowering context
 * @param e    the index expression
 * @param ix   the index node (its receiver picks the `str` or the `[]T` arm)
 * @return     the indexed value
 * @throws     propagated from the arm the receiver's type selects
 */
fn lower_index(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex) -> Lowered | error {
    match ix.receiver.type {
        checker::Str => lower_index_str(ctx, e, ix)
        _ => lower_index_slice(ctx, e, ix)
    }
}

/**
 * lower_index_str — `recv[index]` on a `str` receiver: the byte at `index` in its rodata/
 * fat-pointer content (A1-4, #382), BOUNDS-CHECKED against the receiver's own length half
 * (`guarded_index_addr`) exactly as the C route's `emit_index` checks its `str` subscript.
 *
 * @param ctx  the lowering context
 * @param e    the index expression (its type is `byte`)
 * @param ix   the index node (its receiver is a `str`)
 * @return     the indexed byte
 * @throws     propagated from lowering the receiver or the index
 */
fn lower_index_str(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex) -> Lowered | error {
    let ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    let elem_ty = LType::I8
    let addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, ltype_size(elem_ty), e.line, e.col) { Lowered as x => x; error as err => return err }
    let r = ctx_alloc(addr_out.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr_out.vreg, elem_ty, e.line, e.col)); vreg = r.vreg }
}

/**
 * elem_byte_stride — the byte width ONE element of type `t` occupies inside a slice buffer: the
 * two-word `{ptr, len}` pair `fat_slot_bytes()` already names for a FAT element (`str`/`[]T`),
 * matching the runtime's `tk_str{ptr;len}` layout every route agrees on (`teko_rt.h`), else the
 * ordinary scalar machine width. ONE function answers this for the array literal's store
 * (`store_array_elem`), the index load (`lower_index_fat`/`lower_index_slice`), and the push's
 * `sizeof` argument (`lower_scalar_element_push`/`lower_fat_element_push`), so the three sites the
 * 0.3.1.0 degrau 10 honest stop named can never disagree about the number.
 *
 * @param t      the element type
 * @param enums  the program's declared-enum table (`ltype_of`'s own requirement)
 * @return       the element's byte stride inside a slice buffer
 */
fn elem_byte_stride(t: checker::Type, enums: []LEnumInfo) -> u32 {
    if is_fat_type(t) { return fat_slot_bytes() }
    ltype_size(ltype_of(t, enums))
}

/**
 * elem_byte_align — the natural alignment of one slice element: a FAT element aligns like its
 * pointer half (`ltype_align(LType::Ptr)`, matching `alloc_fat_slot`'s own mutable-fat-local frame
 * slot), else the ordinary scalar alignment.
 *
 * @param t      the element type
 * @param enums  the program's declared-enum table
 * @return       the element's byte alignment
 */
fn elem_byte_align(t: checker::Type, enums: []LEnumInfo) -> u32 {
    if is_fat_type(t) { return ltype_align(LType::Ptr) }
    ltype_align(ltype_of(t, enums))
}

/**
 * lower_index_fat — the FAT arm of a slice-element read (`recv[index]` on a `[]str`/`[][]T`
 * receiver): the element's address (`guarded_index_addr`, at the two-word `elem_byte_stride` every
 * fat-element site now shares), read back through the SAME `{ptr, len}` load a mutable fat local's
 * frame slot uses (`load_fat_slot`) — the element's storage IS that shape (0.3.1.0 degrau 10).
 *
 * The receiver is lowered as a FAT producer, not as a plain address: the LENGTH half is what the
 * bounds guard needs, the same reason `lower_assign_index`'s write reaches for it.
 *
 * @param ctx  the lowering context
 * @param e    the index expression (its type is the fat element type)
 * @param ix   the index node (its receiver is a `[]T` of fat elements)
 * @return     the element's (ptr, len) pair
 * @throws     propagated from lowering the receiver/index, or when the receiver is not a slice
 */
fn lower_index_fat(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex) -> LoweredFat | error {
    let ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    match slice_element_type(ix.receiver.type) { checker::Type => { }; error as err => return err }
    let addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, fat_slot_bytes(), e.line, e.col) { Lowered as x => x; error as err => return err }
    load_fat_slot(addr_out.ctx, addr_out.vreg, e.line, e.col)
}

/**
 * lower_index_slice — `recv[index]` on a `[]T` receiver of NON-fat elements (a fat-element
 * receiver's index instead reaches `lower_index_fat`, via `lower_fat_expr`'s own `TIndex` arm):
 * lower the receiver to its `{ptr, len}` pair, BOUNDS-CHECK the index against that length and take
 * the element's address (`guarded_index_addr` — folded when `index` is constant), then load its
 * value. An AGGREGATE element is held BY ADDRESS (NATIVE-AGG-SLICE-BY-ADDRESS), so the load reads
 * the element's stored pointer; the guard covers it identically, and it is the shape that used to
 * SEGFAULT rather than merely read garbage when the index was out of range.
 *
 * @param ctx  the lowering context
 * @param e    the index expression (its type is the element type)
 * @param ix   the index node (its receiver is a `[]T` of non-fat elements)
 * @return     the element's value
 * @throws     propagated from lowering the receiver/index, or when the receiver is not a slice
 */
fn lower_index_slice(ctx: LowerCtx, e: checker::TExpr, ix: checker::TIndex) -> Lowered | error {
    let ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    match slice_element_type(ix.receiver.type) { checker::Type => { }; error as err => return err }
    let elem_ty = ltype_of(e.type, ro.ctx.enums)
    let addr_out = match guarded_index_addr(ro.ctx, ro.ptr, ro.len, ix.index, elem_byte_stride(e.type, ro.ctx.enums), e.line, e.col) { Lowered as x => x; error as err => return err }
    let r = ctx_alloc(addr_out.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr_out.vreg, elem_ty, e.line, e.col)); vreg = r.vreg }
}

/**
 * lower_array_lit — `[e0, e1, …]`: alloca `elements.len * stride` bytes (the element's byte
 * stride — `elem_byte_stride`, the two-word `{ptr, len}` pair for a FAT element, 0.3.1.0 degrau
 * 10), store each element at its constant offset, then BOX the whole filled buffer into fresh
 * per-EXECUTION runtime storage (`box_aggregate_value` / `tk_slice_elem_box`) and hand back
 * THAT address instead of the alloca's.
 *
 * WHY THE BOX (0.3.1.0 array-literal-escape). An alloca is a per-INSTRUCTION frame slot: it dies
 * with the enclosing function's own frame, exactly like every other aggregate this backend
 * addresses (NATIVE-AGG-SLICE-BY-ADDRESS, the same reasoning `lower_scalar_element_push` and the
 * variant-construction path already box under). An array literal's fat VALUE (0.3.1.0 degrau 10)
 * is that alloca's bare address — so `return [e0, e1, …]` handed the caller a pointer into a
 * frame that was about to unwind, silently reused by the very next call's own frame (measured:
 * two functions each returning a fresh array literal, called back to back before the first
 * result is read, read back the SECOND call's values through the FIRST result — no crash, no
 * stop, just the wrong bytes). The C emitter (`codegen::emit_array_lit`) never had this bug
 * because its fast path allocates through `malloc`, never a C-stack local; boxing here makes
 * the two routes agree unconditionally, matching the oracle rather than only the return edge —
 * a literal used and dropped within its own frame pays one extra copy, in exchange for every
 * literal being safe to return, store, or otherwise outlive its birth frame.
 *
 * The length/fat-pointer wrapping (`.len`, slicing, spreads) is A1-4's concern; a spread element
 * (`..xs`) is out of the A1-3 subset (its length isn't known until then).
 *
 * @param ctx  the lowering context
 * @param e    the array-literal expression (its type is the resulting `[]T`)
 * @param al   the typed array-literal node (its elements, in order)
 * @return     the boxed buffer's address (the literal's fat-pointer ptr half)
 * @throws     when `e.type` is not a slice, or propagated from lowering an element
 */
fn lower_array_lit(ctx: LowerCtx, e: checker::TExpr, al: checker::TArrayLit) -> Lowered | error {
    let elem_t = match slice_element_type(e.type) { checker::Type as t => t; error as err => return err }
    let stride = elem_byte_stride(elem_t, ctx.enums)
    let total = (al.elements.len to u32) * stride
    let base = ctx_alloc(ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, total, elem_byte_align(elem_t, ctx.enums), e.line, e.col))
    let filled = match store_array_elements(with_alloca, base.vreg, elem_t, al.elements, stride, e.line, e.col) { Lowered as x => x; error as err => return err }
    emit_elem_box(filled, total, e.line, e.col)
}

