use teko::checker
use teko::lexer

/**
 * lower_index_bounds_guard — trap unless `index < len`, the bounds check EVERY subscript this
 * backend lowers goes through: the element write (`lower_assign_index`) and, since the read half was
 * measured to diverge, the element read too (`guarded_index_addr`). An UNSIGNED compare (`ICmpLtU`)
 * so a negative index is the huge value it already is in the carrier and fails the same test, which
 * is exactly what the C route's `(uint64_t)` cast of the index buys there. The trap calls the
 * runtime's POSITIONED `tk_panic_oob_at(line, col)` — the same entry, the same message and the same
 * status the C route's index guard produces, so the two routes locate an out-of-bounds subscript
 * identically.
 *
 * @param ctx    the lowering context, positioned after the index is lowered
 * @param index  the already-lowered index VReg
 * @param len    the receiver slice's already-lowered length VReg
 * @param line   the source line of the subscript
 * @param col    the source column of the subscript
 * @return       the advanced context, now emitting into the in-bounds block
 */
fn lower_index_bounds_guard(ctx: LowerCtx, index: u32, len: u32, line: u32, col: u32) -> LowerCtx {
    let lr = ctx_alloc(ctx)
    let with_line = ctx_append(lr.ctx, const_int_inst(lr.vreg, line to i64, line, col))
    let cr = ctx_alloc(with_line)
    let with_col = ctx_append(cr.ctx, const_int_inst(cr.vreg, col to i64, line, col))
    let ok = ctx_alloc(with_col)
    let with_cmp = ctx_append(ok.ctx, bin_inst(ok.vreg, LBinOp::ICmpLtU, index, len, line, col))
    lower_trap_unless_with(with_cmp, ok.vreg, "tk_panic_oob_at", two_args(lr.vreg, cr.vreg), line, col)
}

/**
 * store_assign_elem — the element store of `lower_assign_index`, split by what the slice HOLDS for
 * an element of that type, which is the same three-way split every container placement in this
 * backend makes:
 *
 * - a FAT element (`[]str`, `[][]T`) is a two-word `{ptr, len}` pair in the buffer, so both halves
 *   are written (`store_fat_through_addr` — the very tail the field, the local and the reference
 *   write through);
 * - a REGISTER-VALUE element (`is_register_value_type`: a primitive, a `byte`, an `enum` carrier) is
 *   the datum itself, and `store_assign_value` writes it at the element's machine width — the same
 *   function a struct field's write ends in, so a compound `op=` reads the CURRENT element, applies
 *   the arithmetic and stores the result, with the division guard included;
 * - an AGGREGATE element is held BY ADDRESS (NATIVE-AGG-SLICE-BY-ADDRESS), so it is boxed into fresh
 *   per-EXECUTION storage first (`store_assign_aggregate_elem`).
 *
 * @param ctx   the lowering context, positioned after the element's address is computed
 * @param addr  the element's address VReg
 * @param a     the typed assignment (kind `Index`, `a.bound` the element type)
 * @return      the context with the element store appended, or an honest stop
 * @throws      propagated from the arm the element shape selects
 */
fn store_assign_elem(ctx: LowerCtx, addr: u32, a: checker::TAssign) -> LowerStmtOut | error {
    if is_fat_type(a.bound) { return store_fat_through_addr(ctx, addr, a, "a str/slice element") }
    if is_register_value_type(a.bound, ctx.enums) { return store_assign_value(ctx, addr, ltype_of(a.bound, ctx.enums), a) }
    store_assign_aggregate_elem(ctx, addr, a)
}

/**
 * store_assign_aggregate_elem — the AGGREGATE arm of `store_assign_elem`: copy the new value into
 * fresh per-EXECUTION runtime storage (`box_aggregate_value` / `tk_slice_elem_box`) and store THAT
 * address into the element slot — byte for byte what `lower_scalar_element_push` already does for a
 * pushed aggregate (degrau 4), asked of an element that already exists instead of one being
 * appended.
 *
 * Storing the value's own lowered address instead would store an `alloca` — ONE frame slot per
 * INSTRUCTION, not per EXECUTION — so a write inside a loop would leave every element pointing at
 * the same slot, and a later mutation of the source binding would reach the element the C route
 * copied away from it. A compound `op=` is refused: no arithmetic operator applies to an aggregate,
 * the same refusal `store_assign_aggregate_ref` makes for a reference's aggregate pointee.
 *
 * @param ctx   the lowering context, positioned after the element's address is computed
 * @param addr  the element's address VReg
 * @param a     the typed assignment (kind `Index`, an aggregate `bound`)
 * @return      the context with the boxed address stored
 * @throws      for a compound `op=`, for an aggregate this backend pins no whole-type byte width
 *              for (`unsized_aggregate_elem_stop`), or propagated from lowering the value
 */
fn store_assign_aggregate_elem(ctx: LowerCtx, addr: u32, a: checker::TAssign) -> LowerStmtOut | error {
    if a.op != lexer::TokenKind::Assign {
        return error { message = "native backend N1: compound assignment to an aggregate slice element has no arithmetic form (internal)" }
    }
    let width = match aggregate_box_bytes(a.bound, ctx) { u32 as n => n; null => return unsized_aggregate_elem_stop(a.bound) }
    let vo = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
    let boxed = box_aggregate_value(vo, width, a.value)
    let elem_lt = ltype_of(a.bound, ctx.enums)
    LowerStmtOut { ctx = ctx_append(boxed.ctx, store_inst(addr, boxed.vreg, elem_lt, a.value.line, a.value.col)); terminated = false }
}

/**
 * unsized_aggregate_elem_stop — the NAMED honest stop for `store_assign_aggregate_elem`: an element
 * write whose element is an aggregate this backend cannot pin a WHOLE-TYPE byte width for
 * (`aggregate_form_name`'s two still-open forms — an optional, a closure). The SAME two forms
 * `unsized_aggregate_push_stop` names for a push, because it is the same missing number.
 *
 * @param t  the aggregate element type this backend assigns no whole-type byte width
 * @return   the honest stop, always
 */
fn unsized_aggregate_elem_stop(t: checker::Type) -> error {
    error { message = teko::str::concat("native backend N1: an element write whose element is ", aggregate_form_name(t), " — this backend holds aggregate slice elements BY ADDRESS and boxes the written value into fresh storage, which needs a byte width the element type alone fixes (N2)") }
}

/** texpr_kind_name — a short spelling of a typed expression's kind for the honest-stop
    message. Takes the whole TExpr (TExprKind is private to teko::checker) and matches its
    `.kind`. */
fn texpr_kind_name(e: checker::TExpr) -> str {
    match e.kind {
        checker::TNumber => "number"
        checker::TVar => "variable"
        checker::TStrLit => "string literal"
        checker::TByteLit => "byte literal"
        checker::TCharLit => "char literal"
        checker::TBoolLit => "bool literal"
        checker::TNullLit => "null literal"
        checker::TBinary => "binary op"
        checker::TUnary => "unary op"
        checker::TCompare => "comparison"
        checker::TCall => "call"
        checker::TIfExpr => "if-expression"
        checker::TMatchExpr => "match-expression"
        checker::TCast => "cast"
        checker::TFieldAccess => "field access"
        checker::TStructInit => "struct literal"
        checker::TIndex => "index"
        checker::TInterp => "string interpolation"
        checker::TInExpr => "in-expression"
        checker::TPathExpr => "enum member"
        checker::TArrayLit => "array literal"
        checker::TLambda => "lambda"
        checker::TBorrow => "borrow"
    }
}

/** tstmt_kind_name — a short spelling of a TStatement for the honest-stop message. */
fn tstmt_kind_name(s: checker::TStatement) -> str {
    match s {
        checker::TBinding => "binding"
        checker::TAssign => "assignment"
        checker::TReturn => "return"
        checker::TLoopStmt => "loop"
        checker::TBreakStmt => "break"
        checker::TContinueStmt => "continue"
        checker::TExprStmt => "expression statement"
        checker::TDeferStmt => "defer"
        checker::TAdoptStmt => "adopt"
    }
}

/** lower_block — lower a statement block into the current function/block, threading the env
    and stopping at the first terminator (a return closes the block; nothing after it is
    reachable in the N1 straight-line subset). */
fn lower_block(ctx: LowerCtx, body: []checker::TStatement) -> LowerCtx | error {
    mut cur = ctx
    mut i: u64 = 0
    loop {
        if i >= body.len { break }
        let out = match lower_stmt(cur, body[i]) { LowerStmtOut as x => x; error as err => return err }
        cur = out.ctx
        if out.terminated { return cur }
        i++
    }
    cur
}

/**
 * lower_fn_body — lower a function/lambda body, auto-returning its TRAILING
 * expression as the body's `LRet` value when the body falls through (no
 * explicit `return` on every path) and the function/lambda's return machine
 * class is non-void (#421 — mirrors the C backend's `emit_block_tail` /
 * `emit_exprstmt_tail`: "a block's trailing NORMAL value is the function's
 * value"). A `void`-returning function/lambda, or an empty body, lowers every
 * statement plainly (`lower_block`) and leaves the fall-through case to the
 * caller's own implicit-void-return close (`close_function`/
 * `close_lambda_body`). Reuses `lower_block_value`'s "last statement is the
 * tail value" walk, so a trailing `if`/`match` EXPRESSION in tail position
 * already resolves through the SAME machinery an if-expression arm uses — no
 * duplicated control-flow logic. The trailing value is coerced into `ctx.ret_type` (the
 * function/lambda's own DECLARED return type, threaded via `LowerCtx` — `lower_block_value`'s
 * `target_ty`) exactly like an explicit `return` (`lower_return`), so a bare case value falling
 * through as the trailing tail of a `T | error`-returning body is wrapped into the uniform
 * tag+payload shape too (#382, degrau N2).
 *
 * @param LowerCtx ctx  the lowering context
 * @param []checker::TStatement body  the function/lambda's statement list
 * @param LType ret_ty  the function/lambda's return machine class
 * @param u32 line  the source line to propagate onto a synthesized `ret`
 * @param u32 col  the source column to propagate onto a synthesized `ret`
 * @return LowerCtx | error  the context after lowering every statement, its
 *                           block already closed with the `LRet` when a
 *                           trailing value was auto-returned. When the body
 *                           has a pending defer, it fires (from index 0,
 *                           LIFO) AFTER the trailing value is computed but
 *                           BEFORE the auto-`ret` (A1-2, #382 — mirrors the
 *                           C backend's value-arm ordering: tail into
 *                           `sink` first, then its defers,
 *                           `codegen.tks:4742-4749` — a defer here can still
 *                           observe every body-local, but never affects the
 *                           already-captured trailing value).
 * @implNote a fat (`str`/`[]T`) `ctx.ret_type` routes the whole body through `lower_fn_body_fat`
 *           instead — the trailing tail's length half stores through the hidden out-slot exactly
 *           like an explicit fat `return` (call-gordo degrau, #382 N2).
 * @implNote NP4 (UAF fix): the prefix statements lower under the frame region UNCHANGED
 *           (`lower_block_prefix`); the tail statement lowers through `lower_fn_tail`, which
 *           BRACKETS its own construction in leave/enter when it is an expression-statement — so
 *           any `tk_alloc` the tail's aggregate/array-literal construction performs (a struct
 *           field's `[]T`/`str`/nested boxed aggregate) lands at `rr` DIRECTLY, before
 *           `own_returned_value`'s box ever runs. `own_returned_value`'s box only memcpy's the
 *           OUTER aggregate's OWN bytes (`tk_slice_elem_box` is shallow) — it is right ONLY
 *           because every POINTER field it copies already points at `rr`-resident storage by the
 *           time it runs; relying on it alone to re-home a FRAME-resident nested allocation
 *           (the pre-fix shape) was the confirmed UAF. `emit_region_drops`, run AFTER
 *           `own_returned_value`'s box, then never touches the value the `LRet` carries.
 */
fn lower_fn_body(ctx: LowerCtx, body: []checker::TStatement, ret_ty: LType, line: u32, col: u32) -> LowerCtx | error {
    if body.len == 0 || ltype_is_void(ret_ty) { return lower_block(ctx, body) }
    if is_fat_type(ctx.ret_type) { return lower_fn_body_fat(ctx, body, line, col) }
    let pre = match lower_block_prefix(ctx, body) { LowerStmtOut as x => x; error as err => return err }
    if pre.terminated { return pre.ctx }
    let tail = match lower_fn_tail(pre.ctx, body[body.len - 1], ret_ty, ctx.ret_type, line, col) { LowerBlockValue as x => x; error as err => return err }
    if tail.terminated { return tail.ctx }
    let replayed = match replay_defers(tail.ctx, 0) { LowerCtx as c => c; error as err => return err }
    let left = emit_region_leaves(replayed, line, col)
    let owned = own_returned_value(Lowered { ctx = left; vreg = tail.vreg }, line, col)
    let dropped = emit_region_drops(owned.ctx, line, col)
    ctx_append(dropped, ret_inst(owned.vreg, line, col))
}
