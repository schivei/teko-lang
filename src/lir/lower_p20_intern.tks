use teko::checker

/**
 * ASSERT_SEED_PREFIX — the symbol prefix `assert_seed_symbol` builds every
 * `teko::assert::<name>` call's C-seed symbol from (`src/assert/assert.h`).
 */
const ASSERT_SEED_PREFIX: str = "teko__assert__"

/**
 * assert_seed_fat_arity — the leading by-value `tk_str` count of the
 * `teko__assert__` seed entry `sym` names, or 0 when `sym` is not one.
 *
 * Splits the symbol back into the bare assertion name and asks the checker's own
 * signature table (`checker::assert_fat_arg_arity`) rather than re-listing which
 * assertions take a `str`: the family is enumerated once, in
 * `checker::assert_builtin_fn`, and every consumer that has ever kept a private
 * copy of that list has drifted from it.
 *
 * THE PREFIX TEST ALLOCATES NOTHING, and that is a measured requirement rather
 * than a preference. This runs once per lowered call — hundreds of thousands of
 * times over a coverage build of the own-backend corpus — and the first shape of
 * it cut the tail with `teko::str::slice_from` and rebuilt the symbol with
 * `teko::str::concat` BEFORE knowing whether the prefix even matched, so every
 * call in the program leaked two fresh heap strings into the arena: the gate's
 * `teko` process reached `anon-rss 14488300 kB` and was OOM-killed. The byte loop
 * answers `false` for every non-assertion symbol without touching the allocator,
 * and only a genuine hit pays for the slice.
 *
 * @param str sym  the resolved C symbol
 * @return u64  the count of leading by-value `tk_str` parameters (0, 1 or 2)
 */
fn assert_seed_fat_arity(sym: str) -> u64 {
    if !has_assert_seed_prefix(sym) { return 0 }
    checker::assert_fat_arg_arity(teko::str::slice_from(sym, ASSERT_SEED_PREFIX.len))
}

/**
 * has_assert_seed_prefix — does `sym` begin with `ASSERT_SEED_PREFIX` and carry at least one byte
 * after it? A local byte-level prefix test, because this compiler has no `teko::str::starts_with`
 * builtin — only `ends_with`/`contains` — and the same reason `build::project`'s own `bp_prefix`
 * exists.
 *
 * @param str sym  the resolved C symbol
 * @return bool  true iff `sym` is `ASSERT_SEED_PREFIX` followed by a non-empty name
 */
fn has_assert_seed_prefix(sym: str) -> bool {
    if sym.len <= ASSERT_SEED_PREFIX.len { return false }
    mut i: u64 = 0
    loop {
        if i >= ASSERT_SEED_PREFIX.len { break }
        if sym[i] != ASSERT_SEED_PREFIX[i] { return false }
        i++
    }
    true
}

/**
 * takes_one_str_by_value — does the runtime entry `sym` declare exactly one LEADING by-value
 * `tk_str` parameter? Covers EVERY `src/runtime/teko_rt.h` entry whose FIRST parameter is a
 * by-value `tk_str` and whose SECOND (if any) is not — a faithful transcription of the header.
 *
 * WHY THE WHOLE HEADER AND NOT THE REACHED SUBSET. A runtime symbol reaches this backend through
 * TWO seams, and the second one is open-ended: the builtin tables (`native_builtin_symbol`,
 * `builtin_str_query_symbol`, …) name a closed set, but a plain `extern fn f(s: str) = "tk_…"`
 * declaration names ANY symbol in the header, and this compiler's own source already carries such
 * declarations (`src/assert/assert.tks`'s `tk_assert_scenario_set`, `src/process/process.tks`'s
 * `tk_rt_spawn_redirected`, the coverage sink's `tk_cov_merge`). Listing only the reached subset is
 * what made this table wrong twice; listing the header makes the answer independent of which seam
 * asked. Entries whose RETURN is itself an aggregate are listed too — their return travels through
 * a hole this table does not own (`LCall` captures one result register, on every target alike), and
 * an argument answer that is right the day the return is fixed costs nothing now.
 *
 * @param str sym  the resolved runtime symbol
 * @return bool  true iff `sym` declares exactly one leading by-value `tk_str` parameter
 */
fn takes_one_str_by_value(sym: str) -> bool {
    sym == "tk_print" || sym == "tk_println" || sym == "tk_eprint" || sym == "tk_eprintln" ||
    sym == "tk_write" || sym == "tk_ewrite" || sym == "tk_panic_str" ||
    sym == "tk_assert_scenario_set" || sym == "tk_test_begin" || sym == "tk_cov_merge" ||
    sym == "tk_rt_spawn_redirected" || sym == "tk_float_parse" || sym == "tk_as_ptr" ||
    sym == "tk_cstr_dup" || sym == "tk_str_len" || sym == "tk_str_hash" ||
    sym == "tk_str_len_chars" || sym == "tk_str_chars" || sym == "tk_char_at" ||
    sym == "tk_str_of_bytes" || sym == "tk_bytes_of_str" || sym == "tk_intern_get" ||
    sym == "tk_str_slice" || sym == "tk_str_slice_to" || sym == "tk_str_slice_from" ||
    sym == "tk_str_slice_chars" || sym == "tk_rt_read_file" || sym == "tk_rt_getenv" ||
    sym == "tk_rt_chdir" || sym == "tk_rt_mkdir" || sym == "tk_rt_remove_file" ||
    sym == "tk_rt_list_dir" || sym == "tk_rt_write_file_bytes" ||
    sym == "tk_journal_open" || sym == "tk_journal_append" || sym == "tk_journal_arm"
}

/**
 * takes_two_strs_by_value — does the runtime entry `sym` declare two LEADING by-value `tk_str`
 * parameters? Covers EVERY `src/runtime/teko_rt.h` entry whose FIRST TWO parameters are both
 * by-value `tk_str`, transcribed from the header.
 *
 * @param str sym  the resolved runtime symbol
 * @return bool  true iff `sym` declares two leading by-value `tk_str` parameters
 */
fn takes_two_strs_by_value(sym: str) -> bool {
    sym == "tk_str_eq" || sym == "tk_str_contains" || sym == "tk_str_ends_with" ||
    sym == "tk_rt_last_index_of_ok" || sym == "tk_str_cmp" || sym == "tk_str_concat" ||
    sym == "tk_intern_put" || sym == "tk_rt_write_file" || sym == "tk_rt_append_file" ||
    sym == "tk_rt_setenv" || sym == "tk_rt_last_index_of" || sym == "tk_rt_rename"
}

/**
 * lower_str_arg_call — lower a call to a single-`tk_str`-argument runtime
 * builtin (`is_str_arg_builtin`): the ONE argument through `lower_fat_expr`
 * (its (ptr, len) pair, the A1-4 fat-pointer PRODUCER set — a literal, an
 * array literal, or a `let`-bound fat local), emitted as a two-operand void
 * `LCall` (`ptr` then `len`, matching `tk_str`'s field order). A call whose
 * argument is not one of those closed producers (e.g. an interpolation or
 * another call's result) propagates `lower_fat_expr`'s own NAMED N2
 * honest-stop unchanged — never a fabricated/garbage-ABI call.
 *
 * @param LowerCtx ctx  the lowering context
 * @param checker::TExpr e  the call expression (its source position)
 * @param str sym  the resolved runtime symbol (`is_str_arg_builtin` true)
 * @param checker::TCall c  the call node (its single argument)
 * @return Lowered | error  the advanced context + a dummy 0 VReg (every
 *                          `is_str_arg_builtin` target is void/`_Noreturn`),
 *                          or a NAMED internal/N2 honest-stop
 */
fn lower_str_arg_call(ctx: LowerCtx, e: checker::TExpr, sym: str, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = teko::str::concat("native backend N1: `", sym, "` expects exactly one str argument (internal)") }
    }
    let fo = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    let inst = void_call_inst(sym, two_args(fo.ptr, fo.len), false, e.line, e.col)
    Lowered { ctx = ctx_append(fo.ctx, inst); vreg = 0 }
}

// LoweredArgs — the context after lowering an argument list + the VRegs, ABI-FLATTENED, in
// order. A fat (`str`/`[]T`) argument contributes TWO consecutive VRegs (ptr then len,
// `lower_arg_vregs`'s contract) — so `vregs.len` is the call's actual incoming register
// count, not necessarily `args.len`.

/**
 * lower_args — lower every argument expression left-to-right, ABI-FLATTENING each one into
 * its incoming register(s) and COERCING it into its parameter's declared type
 * (`lower_arg_into_param`).
 *
 * @param LowerCtx ctx  the lowering context
 * @param []checker::TExpr args  the argument list to lower
 * @param []checker::Type params  the callee's declared parameter types (`callee_param_types`)
 * @return LoweredArgs | error  the advanced context + the lowered, flattened VRegs, in order
 */
fn lower_args(ctx: LowerCtx, args: []checker::TExpr, params: []checker::Type) -> LoweredArgs | error {
    lower_args_from(ctx, args, params, 0)
}

/**
 * lower_args_from — lower `args[start..]` left-to-right, ABI-FLATTENING each one into its
 * incoming register(s) (A1-6, #382 — `lower_args` is the `start=0` case; the
 * interface-dispatch path additionally needs the TAIL of an arg list, the receiver at index 0
 * having already been lowered separately). A fat (`str`/`[]T`) argument contributes its
 * (ptr, len) pair (`lower_arg_vregs`) — the SAME two-register contract `lower_function`'s
 * `bind_param` expects on the receiving end, so a caller and callee compiled by this backend
 * never disagree on a fat argument's register count.
 *
 * Each argument is COERCED into its parameter's declared type (`lower_arg_into_param`) — the
 * parameter list is indexed by the argument's OWN position, so the interface-dispatch path's
 * `start=1` still pairs `args[i]` with `params[i]` (its `params[0]` is the receiver).
 *
 * @param LowerCtx ctx  the lowering context
 * @param []checker::TExpr args  the full argument list
 * @param []checker::Type params  the callee's declared parameter types (`callee_param_types`)
 * @param u64 start  the first index to lower (0 lowers every argument)
 * @return LoweredArgs | error  the advanced context + the lowered, flattened VRegs, in order
 */
fn lower_args_from(ctx: LowerCtx, args: []checker::TExpr, params: []checker::Type, start: u64) -> LoweredArgs | error {
    mut cur = ctx
    mut vregs: []u32 = teko::list::empty()
    mut i: u64 = start
    loop {
        if i >= args.len { break }
        let one = match lower_arg_into_param(cur, param_type_at(params, i), args[i]) { LoweredArgs as x => x; error as err => return err }
        cur = one.ctx
        vregs = append_vregs(vregs, one.vregs)
        i++
    }
    LoweredArgs { ctx = cur; vregs = vregs }
}
