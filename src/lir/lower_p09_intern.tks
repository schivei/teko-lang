use teko::checker
use teko::lexer
use teko::parser

/**
 * lower_unary — lower a prefix-unary expression. `!` (logical-not) lowers to a
 * LOGICAL-not (`operand == 0`) via lower_logical_not; every other prefix operator
 * lowers the operand then emits the LUn chosen by the operand's PrimKind.
 *
 * @param LowerCtx ctx  the lowering context to append the expression's instructions into
 * @param checker::TExpr e  the unary expression (carries its source line/col and type)
 * @param checker::TUnary u  the unary node (the operator token and its operand)
 * @return Lowered  the appended context plus the VReg holding the unary's value
 * @throws  when the operand's type is out of the arithmetic subset, or the operator
 *          is a prefix form not yet lowered (N2)
 */
fn lower_unary(ctx: LowerCtx, e: checker::TExpr, u: checker::TUnary) -> Lowered | error {
    let ao = match lower_expr(ctx, u.operand) { Lowered as x => x; error as err => return err }
    if is_logical_not(u.op) { return lower_logical_not(ao, e.line, e.col) }
    let k = match prim_kind_of(u.operand.type, ctx.enums, "unary operand") { checker::PrimKind as p => p; error as err => return err }
    let op = match lunop_of(u.op, k) { LUnOp as o => o; error as err => return err }
    let r = ctx_alloc(ao.ctx)
    let inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    let raw = Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
    narrow_unary_float_to_result(ctx, e, k, raw)
}

/**
 * narrow_unary_float_to_result — append the `FToF` narrowing a float unary owes when its
 * OPERAND is an `f64` but its own resolved type is `f32`, and nothing otherwise.
 *
 * MEASURED DEFECT, and it is a silently WRONG VALUE (0.3.1.0 degrau 29). `mut n: f32 = -7.25`
 * reaches here as a `TUnary` whose OPERAND literal is typed `f64` — the expected `f32` is not
 * propagated through the minus — while the unary expression itself is the declared `f32`. Without
 * this narrowing the `FNeg` result is an `f64` value that every later width-sensitive decision then
 * read at single width: on x86-64 the following `n to f64` was selected as a NARROWING (its
 * direction is read off the operand's recorded width, which said `f64`) and the value handed to
 * `tk_ftoa` was the 64 bits `0xc01d0000c0e80000` — the f64 `-7.25`'s upper half with the f32
 * `-7.25` merged into its lower half. Measured against the C route on the same program:
 * `-7.2500028745271266` against `-7.25`, and `0` when the value crossed a call. The positive
 * literal `mut n: f32 = 7.25` was already correct, because there the literal ITSELF resolves to
 * `f32` and `lower_number` reads its width from its own type.
 *
 * The repair belongs here rather than at the cast site because the value is wrong BEFORE any cast:
 * an `f32` variable was holding a double. `lower_int_to_f32` already owns the same narrowing for
 * the integer-source direction and both now share `narrow_float_to_f32`.
 *
 * @param ctx  the lowering context (its declared-enum table, which `prim_kind_of` consults)
 * @param e    the unary expression, carrying its own resolved type
 * @param operand_kind  the operand's PrimKind (already resolved by the caller)
 * @param done  the already-emitted unary result
 * @return  the result narrowed to `f32`, or `done` unchanged when no narrowing is owed
 */
fn narrow_unary_float_to_result(ctx: LowerCtx, e: checker::TExpr, operand_kind: checker::PrimKind, done: Lowered) -> Lowered {
    if !prim_is_float_kind(operand_kind) { return done }
    if operand_kind == checker::PrimKind::F32 { return done }
    match prim_kind_of(e.type, ctx.enums, "unary result") {
        checker::PrimKind as p => if p == checker::PrimKind::F32 { narrow_float_to_f32(done, e) } else { done }
        error => done
    }
}

/**
 * narrow_float_to_f32 — append one `FToF` that narrows an already-lowered `f64` value to `f32`.
 *
 * `FToF` carries no direction of its own: every backend reads it off the OPERAND's recorded width
 * (`is_same_width_float_cast`'s own doc), so this is the narrowing form exactly when the operand is
 * a double — which both callers guarantee.
 *
 * @param ao  the already-lowered `f64` value
 * @param e   the expression the instruction takes its source position from
 * @return    the narrowed `f32` value
 */
fn narrow_float_to_f32(ao: Lowered, e: checker::TExpr) -> Lowered {
    let narrow = ctx_alloc(ao.ctx)
    let to_f32 = un_inst(narrow.vreg, LUnOp::FToF, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(narrow.ctx, to_f32); vreg = narrow.vreg }
}

/**
 * is_logical_not — is this prefix operator token the `!` (logical-not) operator?
 *
 * @param lexer::TokenKind op  the prefix operator token
 * @return bool  true only for `!` (Bang)
 */
fn is_logical_not(op: lexer::TokenKind) -> bool {
    match op { lexer::TokenKind::Bang => true; _ => false }
}

/**
 * lower_logical_not — emit a LOGICAL-not of an already-lowered operand: `operand == 0`
 * (a `const 0` plus an `ICmpEq`). `!` is bool-only in Teko (checker-enforced), so the
 * operand is always `0`/`1` and this yields the clean complement (`1==0 → 0`, `0==0 → 1`).
 * This is NOT a bitwise one's-complement (LUnOp::INot): `INot 1 = 0xFFFFFFFE` is still
 * nonzero, so a conditional branch (which tests nonzero) would take the then-arm for BOTH
 * `!true` and `!false` — the F1c miscompile this replaces. For a non-bool truthy int the
 * `==0` semantics remain the correct logical-not.
 *
 * @param Lowered ao  the already-lowered operand (its context and value VReg)
 * @param u32 line  the source line to stamp the emitted instructions with
 * @param u32 col  the source column to stamp the emitted instructions with
 * @return Lowered  the appended context plus the VReg holding the logical-not's `0`/`1`
 */
fn lower_logical_not(ao: Lowered, line: u32, col: u32) -> Lowered {
    let z = ctx_alloc(ao.ctx)
    let with_zero = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    let r = ctx_alloc(with_zero)
    let inst = bin_inst(r.vreg, LBinOp::ICmpEq, ao.vreg, z.vreg, line, col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

/**
 * lower_cast — a numeric `to` cast: lower the inner value, then convert it. An int->int pair (which
 * includes `byte` and an enum ordinal) routes to `lower_int_cast`, where the conversion is a RUNTIME
 * FIT GUARD and no truncation — no cast may answer with a different number than it was given. A
 * float-involved pair emits the conversion LUn `cast_unop_of` chooses. Only numeric casts are in the
 * N1 subset; a cast to/from a non-
 * primitive honest-stops — EXCEPT a `Variant`-targeted cast, which is never a user `to` (the
 * checker restricts `to` to numeric/char/bool): it is the synthetic widening node the const inliner
 * (`widen_inlined_const`, #630) wraps a variant const's collapsed case-member initializer in when a
 * `let`-bound scalar-const reference's declared type (`e.type`, the union) differs from its
 * substituted initializer's narrower member type — the SAME shape the C backend's `emit_cast`
 * routes through `cg_cast_target_is_variant`/`emit_as`. This backend's placement-aware analog is
 * `lower_value_into_type`, so a `Variant` target routes there instead of `prim_kind_of`, which has
 * no single machine class for a union to answer with. A `ptr<byte> <-> u64` pair (P1, `arena-em-
 * teko.md` §2 — the arena address-carrier cast `checker::cast_kind_of_ptr` admits) is caught
 * BEFORE `prim_kind_of` too, by `is_u64_ptr_byte_reinterpret_cast`: `prim_kind_of` has no
 * `PrimKind` for `Ptr` at all, and none is needed — on a 64-bit target the two share
 * representation, so the already-lowered operand IS the result, with no instruction emitted (the
 * pointer/address twin of `is_same_width_float_cast`).
 *
 * @param LowerCtx ctx  the lowering context
 * @param checker::TExpr e  the cast expression (its resolved `.type` is the cast's target)
 * @param checker::TCast c  the cast node (`c.expr` is the operand)
 * @return Lowered | error  the lowered (converted, or union-coerced) value
 * @throws  propagated from lowering the operand, or when neither side resolves to a single
 *          machine class (a non-`Variant`, non-primitive cast target/source)
 */
fn lower_cast(ctx: LowerCtx, e: checker::TExpr, c: checker::TCast) -> Lowered | error {
    match variant_type_of(e.type, ctx.variants) {
        checker::Variant => return lower_value_into_type(ctx, e.type, c.expr)
        null => { }
    }
    let ao = match lower_expr(ctx, c.expr) { Lowered as x => x; error as err => return err }
    if is_u64_ptr_byte_reinterpret_cast(c.expr.type, e.type) { return ao }
    let src = match prim_kind_of(c.expr.type, ctx.enums, "cast source") { checker::PrimKind as p => p; error as err => return err }
    let dst = match prim_kind_of(e.type, ctx.enums, "cast target") { checker::PrimKind as p => p; error as err => return err }
    if is_same_width_float_cast(src, dst) { return ao }
    if is_int_to_narrow_float_cast(src, dst) { return lower_int_to_f32(ao, e) }
    if !prim_is_float_kind(src) && !prim_is_float_kind(dst) { return lower_int_cast(ao, src, dst, e.line, e.col) }
    let op = match cast_unop_of(src, dst) { LUnOp as o => o; error as err => return err }
    let r = ctx_alloc(ao.ctx)
    let inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

/**
 * is_int_to_narrow_float_cast — is this `to` cast an integer-to-`f32` cast?
 *
 * @param checker::PrimKind src  the cast operand's PrimKind
 * @param checker::PrimKind dst  the cast target's PrimKind
 * @return bool  true iff the source is an integer and the target is `f32`
 */
fn is_int_to_narrow_float_cast(src: checker::PrimKind, dst: checker::PrimKind) -> bool {
    !prim_is_float_kind(src) && dst == checker::PrimKind::F32
}

/**
 * lower_int_to_f32 — an `int to f32` cast, as the PAIR `IToF` (int -> f64) then `FToF`
 * (f64 -> f32).
 *
 * `LUnOp::IToF` names no destination width, and every backend reads it as the widest one
 * (x86's `CVTSI2SD`, arm64's `SCVTF`), so asking it for an `f32`
 * directly would silently hand back a double that everything downstream then read at single
 * width. Decomposing here keeps `IToF` honest about the ONE thing it means and reuses the
 * `FToF` narrowing that already exists — and the two-step result is bit-identical to a direct
 * single convert for every value, since IEEE double holds every i64 rounding decision an
 * i64->f32 conversion needs.
 *
 * @param Lowered ao  the already-lowered integer operand
 * @param checker::TExpr e  the cast expression (for its source position)
 * @return Lowered  the narrowed `f32` value
 */
fn lower_int_to_f32(ao: Lowered, e: checker::TExpr) -> Lowered {
    let wide = ctx_alloc(ao.ctx)
    let to_f64 = un_inst(wide.vreg, LUnOp::IToF, ao.vreg, e.line, e.col)
    narrow_float_to_f32(Lowered { ctx = ctx_append(wide.ctx, to_f64); vreg = wide.vreg }, e)
}

/**
 * is_same_width_float_cast — is this `to` cast a float-to-float cast between the SAME width
 * (`f32 to f32`, `f64 to f64`)?
 *
 * Such a cast lowers to NO instruction at all: the value already is what the cast asks for, and
 * emitting an `FToF` for it would be actively harmful, because `FToF` carries no direction of its
 * own — a backend reads the direction off the OPERAND's width, so an identity `FToF` reads as
 * "convert to the other width" and silently changes the value. This is the float twin of the
 * int-to-int same-width case, which `cast_int_unop_of` sends to the harmless identity `Trunc`;
 * there is no float identity `LUnOp` to send this one to, so the honest lowering is none.
 *
 * @param checker::PrimKind src  the cast operand's PrimKind
 * @param checker::PrimKind dst  the cast target's PrimKind
 * @return bool  true iff both sides are floats of the same width
 */
fn is_same_width_float_cast(src: checker::PrimKind, dst: checker::PrimKind) -> bool {
    prim_is_float_kind(src) && prim_is_float_kind(dst) && prim_width_of(src) == prim_width_of(dst)
}

/**
 * is_u64_type — is `t` the resolved primitive `u64`?
 *
 * @param checker::Type t  the type to test
 * @return bool  true iff `t` is `Prim{kind = PrimKind::U64}`
 * @since 0.3.1
 */
fn is_u64_type(t: checker::Type) -> bool {
    match t {
        checker::Prim as p => p.kind == checker::PrimKind::U64
        _ => false
    }
}

/**
 * is_ptr_byte_type — is `t` the resolved `ptr<byte>` type (never the opaque `ptr`, never a
 * `ptr<T>` of any other element)?
 *
 * @param checker::Type t  the type to test
 * @return bool  true iff `t` is `Ptr{inner = Byte{}}`
 * @since 0.3.1
 */
fn is_ptr_byte_type(t: checker::Type) -> bool {
    match t {
        checker::Ptr as p => match p.inner {
            checker::Type as inner => match inner { checker::Byte => true; _ => false }
            null => false
        }
        _ => false
    }
}

/**
 * is_u64_ptr_byte_reinterpret_cast — is this `to` cast a same-bit-pattern move between the arena
 * address carrier `u64` and `ptr<byte>` (`arena-em-teko.md` §2, P1 — the address-carrier
 * decision `checker::cast_kind_of_ptr` admits)? Such a cast lowers to NO instruction: on a
 * 64-bit target `u64` and `ptr<byte>` share representation, so the already-lowered operand IS
 * the result — the pointer/address twin of `is_same_width_float_cast`.
 *
 * @param checker::Type src  the cast operand's resolved type
 * @param checker::Type dst  the cast target's resolved type
 * @return bool  true iff one side is `u64` and the other is `ptr<byte>`, in either direction
 * @since 0.3.1
 */
fn is_u64_ptr_byte_reinterpret_cast(src: checker::Type, dst: checker::Type) -> bool {
    (is_u64_type(src) && is_ptr_byte_type(dst)) || (is_ptr_byte_type(src) && is_u64_type(dst))
}
