use teko::list
use teko::checker

/**
 * error_struct_layout — the built-in `error` type's synthetic `LStructLayout`: the SIX fields the
 * C route's `tk_error` already carries (`src/runtime/teko_rt.h:77-101`), in the SAME order, with
 * the SAME classes and widths — `message`@0, `file`@16, `line`@32, `col`@36, `expected`@40,
 * `actual`@56; 72 bytes total, alignment 8.
 *
 * PORQUE SEIS E NÃO UM (0.3.1.0 degrau 22). The checker permits constructing exactly ONE field
 * (`type_struct_lit`, `typer.tks:2513`, only `error { message = <str> }`) but permits READING all
 * six (`type_field_access`, `typer.tks:2110-2128`), and the compiler itself exercises that
 * asymmetry in seven lines across three files (`collect.tks:56`, `typer.tks:3253/6130/6131/6134`,
 * `diagnostics.tks:38/39`). A one-field layout made those reads an honest compile-time stop
 * (`` unknown field `line` on struct `error` ``); this layout closes that stop by matching the C
 * route's oracle field-for-field, so both backends agree on the SAME `error` shape.
 *
 * THE FIVE NON-CONSTRUCTIBLE FIELDS STILL NEED ZEROING AT EVERY CONSTRUCTION SITE — this
 * function only registers the SHAPE; `zero_error_diagnostics` is the half of this crumb that
 * keeps the shape from leaking uninitialized `alloca` bytes.
 *
 * @return LStructLayout  the registered `error` layout
 * @since 0.3.1 (own-backend `error` construction, degrau N2 — the `message` field only);
 *        0.3.1.0 degrau 22 (the five diagnostic fields)
 */
fn error_struct_layout() -> LStructLayout {
    let names = error_field_names()
    let types = error_field_types()
    layout_of_sized(error_struct_name(), names, types, error_field_sizes(types), error_field_aligns(types))
}

/**
 * zero_error_diagnostics — write zero into every `error` field the construction site did NOT
 * itself write, starting at `from_index` (0.3.1.0 degrau 22): `error { message = … }` is the
 * ONLY constructible shape (`typer.tks:2513`), so `store_struct_fields` writes 16 of the 72
 * bytes a grown `error` slot now reserves and leaves the other 56 untouched. An `alloca` is not
 * zeroed by this backend (`store_struct_field`'s own doc names this exact class of defect,
 * already caught once on a fat field's length half) — without this pass, `const_type_located`
 * (and any other reader of `.line`/`.col`/`.file`/`.expected`/`.actual`) would read whatever
 * garbage bytes the fresh frame slot happened to hold. The C route guarantees the same zeroing
 * through `tk_error_make`.
 *
 * A FAT field (`str`, `Ptr`-classed here) needs BOTH its pointer and length halves zeroed; a
 * scalar field (`line`/`col`, `I32`) needs only its own word.
 *
 * @param ctx         the lowering context
 * @param base        the `error` slot's base-address VReg
 * @param layout      the registered `error` layout (`error_struct_layout()`)
 * @param from_index  the index of the first field to zero (1 — right after `message`)
 * @param line        the source line to stamp the emitted instructions with
 * @param col         the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 */
fn zero_error_diagnostics(ctx: LowerCtx, base: u32, layout: LStructLayout, from_index: u64, line: u32, col: u32) -> LowerCtx {
    mut cur = ctx
    mut i = from_index
    loop {
        if i >= layout.field_types.len { break }
        cur = zero_error_field(cur, base, layout, i, line, col)
        i++
    }
    cur
}

/**
 * zero_error_field — zero the ONE `error` field at `layout`'s index `i`: a FAT field
 * (`zero_fat_field_at`) or a plain scalar (`zero_scalar_field_at`), split on the field's own
 * registered machine class — a `zero_error_diagnostics` helper.
 *
 * @param ctx     the lowering context
 * @param base    the `error` slot's base-address VReg
 * @param layout  the registered `error` layout
 * @param i       the field's index within `layout`
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 */
fn zero_error_field(ctx: LowerCtx, base: u32, layout: LStructLayout, i: u64, line: u32, col: u32) -> LowerCtx {
    let off = layout.field_offsets[i]
    match layout.field_types[i] {
        Ptr => zero_fat_field_at(ctx, base, off, line, col)
        _ => zero_scalar_field_at(ctx, base, off, layout.field_types[i], line, col)
    }
}

/**
 * zero_fat_field_at — write a zero `{ptr, len}` pair at `base + offset` (a FAT `str` field's
 * complete zero value — the same `(NULL, 0)` pair the C route's `tk_error_make` assigns via
 * `(tk_str){0}`), through the SAME `store_fat_slot` shape `store_struct_field`'s own fat branch
 * writes a real value with.
 *
 * @param ctx     the lowering context
 * @param base    the `error` slot's base-address VReg
 * @param offset  the field's byte offset within the slot
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 */
fn zero_fat_field_at(ctx: LowerCtx, base: u32, offset: u32, line: u32, col: u32) -> LowerCtx {
    let zp = ctx_alloc(ctx)
    let with_zp = ctx_append(zp.ctx, const_int_inst(zp.vreg, 0, line, col))
    let zl = ctx_alloc(with_zp)
    let with_zl = ctx_append(zl.ctx, const_int_inst(zl.vreg, 0, line, col))
    let addr = ctx_alloc(with_zl)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, offset, line, col))
    store_fat_slot(with_addr, addr.vreg, LoweredFat { ctx = with_addr; ptr = zp.vreg; len = zl.vreg }, line, col)
}

/**
 * zero_scalar_field_at — write a zero machine word of class `ty` at `base + offset` (a scalar
 * diagnostic field's zero value — `line`/`col` read back as `0`, matching the C route's
 * `tk_error_make` zero-initialization).
 *
 * @param ctx     the lowering context
 * @param base    the `error` slot's base-address VReg
 * @param offset  the field's byte offset within the slot
 * @param ty      the field's registered machine class
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 */
fn zero_scalar_field_at(ctx: LowerCtx, base: u32, offset: u32, ty: LType, line: u32, col: u32) -> LowerCtx {
    let z = ctx_alloc(ctx)
    let with_z = ctx_append(z.ctx, const_int_inst(z.vreg, 0, line, col))
    let addr = ctx_alloc(with_z)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, offset, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, z.vreg, ty, line, col))
}

/**
 * copy_error_value — reserve a fresh `error` slot (sized/aligned per the registered layout) and
 * copy `src`'s own six fields into it byte for byte, through the runtime `tk_mem_copy` this
 * backend's aggregate-reference assignment already uses (`store_assign_aggregate_ref`, degrau
 * 18) — no LIR memcpy op exists, so this is the SAME one-line runtime touch, not a new one.
 *
 * PORQUE UMA CÓPIA E NÃO UMA MUTAÇÃO. `tk_error_loc`/`tk_error_types` (`teko_rt.h`) receive the
 * `error` BY VALUE and return a modified COPY: `let b = err_loc(a, 7, 3)` leaves `a.line` at `0`
 * on the C route. In this backend an `error` value IS the address of its slot
 * (§ NATIVE-AGG-SLICE-BY-ADDRESS), so adorning it in place would mutate the caller's `a` and the
 * two routes would diverge silently, with no stop at all.
 *
 * @param ctx     the lowering context
 * @param src     the source `error`'s base-address VReg
 * @param layout  the registered `error` layout (its `size` is the copy width)
 * @param e       the call expression (source position only)
 * @return Lowered  the advanced context plus the new slot's base-address VReg
 */
fn copy_error_value(ctx: LowerCtx, src: u32, layout: LStructLayout, e: checker::TExpr) -> Lowered {
    let dst = ctx_alloc(ctx)
    let with_alloca = ctx_append(dst.ctx, alloca_inst(dst.vreg, layout.size, layout.align, e.line, e.col))
    let width = ctx_alloc(with_alloca)
    let with_width = ctx_append(width.ctx, const_int_inst(width.vreg, layout.size to i64, e.line, e.col))
    let args = teko::list::push(two_args(dst.vreg, src), width.vreg)
    let with_copy = ctx_append(with_width, void_call_inst("tk_mem_copy", args, false, e.line, e.col))
    Lowered { ctx = with_copy; vreg = dst.vreg }
}

/** find_struct_layout — the registered LStructLayout named `name`, or a NAMED internal
    error (the checker guarantees every Named struct type was declared, so a miss here is
    an invariant break, not a user error). */
fn find_struct_layout(layouts: []LStructLayout, name: str) -> LStructLayout | error {
    mut i: u64 = 0
    loop {
        if i >= layouts.len { break }
        if layouts[i].name == name { return layouts[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: no layout registered for struct `", name, "` (internal)") }
}

/** field_offset_of — the byte offset of `field` within `layout`, or a NAMED internal error
    (the checker guarantees the field exists on the struct — a miss here is an invariant
    break). */
fn field_offset_of(layout: LStructLayout, field: str) -> u32 | error {
    mut i: u64 = 0
    loop {
        if i >= layout.field_names.len { break }
        if layout.field_names[i] == field { return layout.field_offsets[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: unknown field `", field, "` on struct `", layout.name, "` (internal)") }
}

/**
 * field_type_of — the machine class of `field` within `layout`, or a NAMED
 * internal error (mirrors `field_offset_of`; a `match` FieldPattern destructure
 * reads a field it did not itself type-check, so it needs the LOAD width
 * straight out of the layout table — A1-5, #382).
 *
 * @param LStructLayout layout  the struct's registered layout
 * @param str field  the field name to look up
 * @return LType  `field`'s registered machine class
 * @throws  when `field` is not registered on `layout` (an internal invariant
 *          break)
 */
fn field_type_of(layout: LStructLayout, field: str) -> LType | error {
    mut i: u64 = 0
    loop {
        if i >= layout.field_names.len { break }
        if layout.field_names[i] == field { return layout.field_types[i] }
        i++
    }
    error { message = teko::str::concat("native backend N1: unknown field `", field, "` on struct `", layout.name, "` (internal)") }
}

/**
 * lower_struct_init — `Name { f = v, … }`: alloca a slot sized/aligned per the struct's
 * registered layout, then store each field's lowered value at its offset (declared order). The
 * struct's "value" is its alloca'd BASE ADDRESS (a Ptr VReg) — the memory model every aggregate
 * in the A1-3 subset shares (§5.1: the interp is an exit-code oracle, not a byte-accurate
 * simulator; A2+ isel reads the real byte layout off LStructLayout, not off this VReg's class).
 *
 * The `error` branch (0.3.1.0 degrau 22) additionally zeros every field the literal itself did
 * NOT write (`zero_error_diagnostics`): `error { message = … }` is the only constructible shape,
 * so the other five of the SIX registered fields would otherwise leak whatever garbage the fresh
 * `alloca` held.
 *
 * @param ctx  the lowering context
 * @param e    the struct-literal expression (its resolved type names the layout)
 * @param si   the struct-init node (the field names/values actually written)
 * @return Lowered  the advanced context plus the new slot's base-address VReg
 * @throws  propagated from resolving the struct's name/layout, or from storing a field's value
 */
fn lower_struct_init(ctx: LowerCtx, e: checker::TExpr, si: checker::TStructInit) -> Lowered | error {
    let name = match named_type_name(e.type) { str as s => s; error as err => return err }
    let layout = match find_struct_layout(ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    let base = ctx_alloc(ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, layout.size, layout.align, e.line, e.col))
    let stored = match store_struct_fields(with_alloca, base.vreg, layout, si.field_names, si.field_vals, e.line, e.col) { Lowered as l => l; error as err => return err }
    match e.type {
        checker::Error => Lowered { ctx = zero_error_diagnostics(stored.ctx, base.vreg, layout, si.field_names.len, e.line, e.col); vreg = base.vreg }
        _ => stored
    }
}
