use teko::checker
use teko::lexer
use teko::parser

fn lvt_variant_named_error(name: str): @Type() {
    var members: []@Type() = teko::list::empty()
    members = teko::list::push(members, checker::Named { name = name })
    members = teko::list::push(members, checker::Error { })
    checker::Variant { members = members }
}

fn lvt_box_layout(): LStructLayout {
    layout_of("Box", teko::list::push(teko::list::empty(), "v"), teko::list::push(teko::list::empty(), LType::I64))
}

fn lvt_layouts(): []LStructLayout {
    teko::list::push(teko::list::push(teko::list::empty(), lvt_box_layout()), error_struct_layout())
}

fn lvt_box_init(value: i64): checker::TExpr {
    var names = teko::list::push(teko::list::empty(), "v")
    var vals = teko::list::push(teko::list::empty(), lwt_num_i64(value))
    checker::TExpr { kind = checker::TStructInit { field_names = names; field_vals = vals }; type = checker::Named { name = "Box" }; line = 0; col = 0 }
}

fn lvt_error_lit(msg: str): checker::TExpr {
    var names = teko::list::push(teko::list::empty(), "message")
    var vals = teko::list::push(teko::list::empty(), lwt_strlit(msg))
    checker::TExpr { kind = checker::TStructInit { field_names = names; field_vals = vals }; type = checker::Error { }; line = 0; col = 0 }
}

#test
fn lvt_lower_return_wraps_named_case_into_declared_variant() {
    var ret_ty = lvt_variant_named_error("Box")
    var body = teko::list::push(teko::list::empty(), lwt_ret(lvt_box_init(7)))
    var f = lwt_fn("mk_ok", "teko::demo", teko::list::empty(), ret_ty, body)
    var lf = match lower_function(f, checker::tt_empty(), lvt_layouts()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "alloca 24, align 8")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "= const 0")
    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "store.ptr")
}

#test
fn lvt_lower_fn_body_trailing_wraps_bare_error_into_declared_variant() {
    var ret_ty = lvt_variant_named_error("Box")
    var body = teko::list::push(teko::list::empty(), lwt_exprstmt(lvt_error_lit("boom")))
    var f = lwt_fn("mk_err", "teko::demo", teko::list::empty(), ret_ty, body)
    var lf = match lower_function(f, checker::tt_empty(), lvt_layouts()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "alloca 24, align 8")
    teko::assert::str_contains(text, "= const 1")
    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "ret %")
}

#test
fn lvt_lower_value_into_variant_passes_through_an_already_wrapped_value() {
    var ret_ty = lvt_variant_named_error("Box")
    var callee = lwt_call(lwt_path1("mk_ok"), "teko::demo", teko::list::empty(), ret_ty)
    var body = teko::list::push(teko::list::empty(), lwt_ret(callee))
    var f = lwt_fn("forward", "teko::demo", teko::list::empty(), ret_ty, body)
    var lf = match lower_function(f, checker::tt_empty(), lvt_layouts()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "call @")
    teko::assert::str_contains(text, "ret %")
}

#test
fn lvt_named_type_name_still_honest_stops_on_non_struct_receiver() {
    var recv = checker::TExpr { kind = checker::TNumber { is_float = false; value = parser::numint_of_i64(0); fval = 0.0 }; type = checker::Slice { element = lwt_prim(checker::PrimKind::I64) }; line = 0; col = 0 }
    var fa = checker::TExpr { kind = checker::TFieldAccess { receiver = recv; field = "bogus" }; type = lwt_prim(checker::PrimKind::I64); line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(fa), "native backend N1: field/index access on a non-struct receiver not yet lowered (N2)")
}

fn lvt_declared_shape_items(): []@TItem() {
    var items: []@TItem() = teko::list::push(teko::list::empty(), lwt_struct_decl("Box", teko::list::push(teko::list::empty(), lwt_field("v", "i64"))))
    items = teko::list::push(items, lwt_struct_decl("Cup", teko::list::push(teko::list::empty(), lwt_field("w", "i64"))))
    var members = teko::list::push(teko::list::push(teko::list::empty(), "Box"), "Cup")
    teko::list::push(items, lwt_variant_decl("Shape", members))
}

fn lvt_program_text(items: []@TItem()): str {
    match lower_program(checker::TProgram { items = items }) {
        LModule as m => print_lmodule(m)
        error as e => teko::str::concat("ERR: ", e.message)
    }
}

#test
fn lvt_declared_variant_match_tests_the_tag_of_every_arm() {
    var subject = checker::TExpr { kind = checker::TVar { name = "s"; is_func = false; func_ns = "" }; type = checker::Named { name = "Shape" }; line = 0; col = 0 }
    var arms = teko::list::push(teko::list::empty(), lwt_arm(lwt_bind_pattern("Box", "b"), teko::list::push(teko::list::empty(), lwt_ret(lwt_num_i64(1)))))
    arms = teko::list::push(arms, lwt_arm(lwt_bind_pattern("Cup", "c"), teko::list::push(teko::list::empty(), lwt_ret(lwt_num_i64(2)))))
    var body = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_match_value(subject, arms, checker::PrimKind::I64)))
    var params = teko::list::push(teko::list::empty(), lwt_param("s", "Shape"))
    var items = teko::list::push(lvt_declared_shape_items(), lwt_fn_item("arm_of", "teko::demo", params, lwt_prim(checker::PrimKind::I64), body))
    var text = lvt_program_text(items)
    teko::assert::str_contains(text, "icmpeq")
    teko::assert::str_contains(text, "= const 0")
    teko::assert::str_contains(text, "= const 1")
    teko::assert::str_contains(text, "load.i32")
}

#test
fn lvt_variant_member_named_matches_a_generic_instance_by_its_base() {
    teko::assert::is_true(variant_member_named(checker::Named { name = "Parsed__g__MainFile" }, "Parsed"))
    teko::assert::is_true(!variant_member_named(checker::Named { name = "Parsed__g__MainFile" }, "MainFile"))
}

#test
fn lvt_find_variant_member_resolves_a_generic_instance_case() {
    var members: []@Type() = teko::list::empty()
    members = teko::list::push(members, checker::Named { name = "Parsed__g__MainFile" })
    members = teko::list::push(members, checker::Error { })
    var vm = match find_variant_member(members, "Parsed") { VariantMember as x => x; error as err => return }
    teko::assert::is_true(vm.index == 0)
}

#test
fn lvt_find_variant_member_refuses_an_ambiguous_shared_generic_base() {
    var members: []@Type() = teko::list::empty()
    members = teko::list::push(members, checker::Named { name = "Box__g__i64" })
    members = teko::list::push(members, checker::Named { name = "Box__g__str" })
    teko::assert::is_true(match find_variant_member(members, "Box") { error => true; _ => false })
}

#test
fn lvt_declared_variant_return_wraps_the_case_into_the_uniform_wrapper() {
    var body = teko::list::push(teko::list::empty(), lwt_ret(lvt_box_init(7)))
    var items = teko::list::push(lvt_declared_shape_items(), lwt_fn_item("mk", "teko::demo", teko::list::empty(), checker::Named { name = "Shape" }, body))
    var text = lvt_program_text(items)
    teko::assert::str_contains(text, "alloca 24, align 8")
    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "store.ptr")
}
