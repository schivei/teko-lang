

/**
 * block_params_of — the block-argument VRegs of the block whose id is `id`, or `null` when `f` has
 * no such block.
 *
 * @param f   the lowered function
 * @param id  the block id to find
 * @return    the block's parameter VRegs, or `null`
 */
fn block_params_of(f: LFunc, id: u32) -> []u32 | null {
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if f.blocks[i].id == id { return f.blocks[i].params }
        i++
    }
    null
}

/**
 * frame_mark — flag VReg `v` as holding a frame address, reporting growth when it was not already
 * flagged (which is what drives `frame_marks_of`'s fixpoint to a stop).
 *
 * @param set  the flags so far
 * @param v    the VReg to flag
 * @return     the flags with `v` set
 */
fn frame_mark(set: FrameSet, v: u32) -> FrameSet {
    if flag_at(set.marked, v) { return set }
    if v >= set.marked.len { return set }
    mut fs = set.marked
    fs[v to u64] = true
    FrameSet { marked = fs; grew = true }
}

/**
 * flag_at — the flag of VReg `v`, or false when `v` is outside the flag vector. A VReg beyond
 * `next_vreg` cannot have been defined by this function's own `alloca`, so false is the right
 * answer as well as the safe one.
 *
 * @param marks  the flag vector
 * @param v      the VReg id
 * @return       true iff `v` is flagged
 */
fn flag_at(marks: []bool, v: u32) -> bool {
    if v >= marks.len { return false }
    marks[v to u64]
}

/**
 * false_marks — a flag vector of `n` false entries, one per VReg the function allocated.
 *
 * @param n  how many VRegs the function allocated (`LFunc.next_vreg`)
 * @return   the all-false vector
 */
fn false_marks(n: u32) -> []bool {
    mut fs: []bool = teko::list::empty()
    mut i: u32 = 0
    loop {
        if i >= n { break }
        fs = teko::list::push(fs, false)
        i++
    }
    fs
}
