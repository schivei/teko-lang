use teko::checker
use teko::lexer
use teko::parser

/**
 * lwt_agg_fat_array_slot_offsets_are_ptr_aligned — `const WORDS: []str = ["a", "bb", "ccc"]`
 * exercises `const_fat_array_image`/`const_image_absorb` directly (the coordinator-flagged
 * locus, `lower_const.tks:441`): three ODD-LENGTH string leaves (1/2/3 bytes) precede the
 * array's OWN 48-byte slot blob, and each slot's rebased relocation offset — 0, 16, 32 — is
 * exactly `index * fat_slot_bytes()`, every one already a multiple of `fat_slot_align` (8), NOW
 * proven by construction (`ptr_align_up(img.bytes.len)`) rather than by the caller's own
 * arithmetic. Native-rodata-const-align regression.
 *
 * @return void
 */
#test
fn lwt_agg_fat_array_slot_offsets_are_ptr_aligned() {
    let elems = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), lwt_strlit("a")), lwt_strlit("bb")), lwt_strlit("ccc"))
    let cd: checker::TItem = checker::TConstDecl { name = "WORDS"; namespace = ""; ty = checker::Slice { element = checker::Str { } }; init = lwt_str_array_lit(elems); vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0 }
    mut items: []checker::TItem = teko::list::push(teko::list::empty(), cd)
    let m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.rodata.len == 4)
    teko::assert::is_true(m.rodata[0].symbol == ".Lconst_WORDS.0")
    teko::assert::is_true(m.rodata[1].symbol == ".Lconst_WORDS.1")
    teko::assert::is_true(m.rodata[2].symbol == ".Lconst_WORDS.2")
    teko::assert::is_true(m.rodata[3].symbol == ".Lconst_WORDS")
    teko::assert::is_true(m.rodata[3].bytes.len == 48)
    teko::assert::is_true(m.rodata[3].relocs.len == 3)
    teko::assert::is_true(m.rodata[3].relocs[0].offset == (0 to u32))
    teko::assert::is_true(m.rodata[3].relocs[1].offset == (16 to u32))
    teko::assert::is_true(m.rodata[3].relocs[2].offset == (32 to u32))
    teko::assert::is_true(m.rodata[3].relocs[0].target == ".Lconst_WORDS.0")
    teko::assert::is_true(m.rodata[3].relocs[1].target == ".Lconst_WORDS.1")
    teko::assert::is_true(m.rodata[3].relocs[2].target == ".Lconst_WORDS.2")
}

/**
 * lwt_one_field_fat_layout — a single-fat-field struct layout `struct <name> { s: <fat> }` whose
 * ONLY field `s` is Ptr-classed and allotted `size` bytes (native-rodata-const-align size-check
 * fixtures). A `size` of 8 models the mis-sized layout the size check must flag (a fat field needs
 * `fat_slot_bytes()` = 16); a `size` of 16 models the correct layout.
 *
 * @param name  the struct type's name
 * @param size  the byte size the layout allots (8 = under-sized, 16 = correct)
 * @return      the one-field layout
 */
fn lwt_one_field_fat_layout(name: str, size: u32) -> LStructLayout {
    LStructLayout {
        name = name; size = size; align = 8 to u32
        field_names = teko::list::push(teko::list::empty(), "s")
        field_offsets = teko::list::push(teko::list::empty(), 0 to u32)
        field_types = teko::list::push(teko::list::empty(), LType::Ptr)
    }
}

/**
 * lwt_one_str_field_init — the struct-literal initializer `{ s = "x" }`, whose sole field's VALUE
 * is a `str` (fat — `is_fat_type` true), for the size-check fixtures.
 *
 * @return the one-field struct-literal initializer
 */
fn lwt_one_str_field_init() -> checker::TStructInit {
    checker::TStructInit {
        field_names = teko::list::push(teko::list::empty(), "s")
        field_vals = teko::list::push(teko::list::empty(), lwt_strlit("x"))
    }
}

/**
 * lwt_const_size_check_flags_undersized_fat_field — the native-rodata-const-align size diagnostic
 * (`check_struct_fat_spans`, the pure core `TEKO_NATIVE_CONST_SIZE_CHECK` gates): a struct whose fat
 * field is allotted only 8 bytes FIRES (a fat `{ptr, len}` slot needs 16 — the exact "fat field
 * sized 8 instead of 16" mismatch that shifts every following field and misaligns a later pointer),
 * while the same field allotted 16 bytes passes clean. The check is env-INDEPENDENT here — this
 * exercises the detection core directly, no environment variable involved.
 *
 * @return void
 */
#test
fn lwt_const_size_check_flags_undersized_fat_field() {
    let si = lwt_one_str_field_init()
    let fired = match check_struct_fat_spans("KBAD", lwt_one_field_fat_layout("Bad", 8 to u32), si) { error => true; null => false }
    teko::assert::is_true(fired)
    let clean = match check_struct_fat_spans("KGOOD", lwt_one_field_fat_layout("Good", 16 to u32), si) { error => false; null => true }
    teko::assert::is_true(clean)
}

/**
 * lwt_typed_var — a `TVar` of an ARBITRARY resolved type `ty` (A1-5, #382 — a
 * `match` subject is not always a scalar/Named the other `lwt_*_var`
 * helpers cover; a `Variant`-typed subject needs this general form).
 *
 * @param str name  the variable's name
 * @param checker::Type ty  the variable's resolved type
 * @return checker::TExpr  the typed `TVar` node
 */
fn lwt_typed_var(name: str, ty: checker::Type) -> checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = false; func_ns = "" }; type = ty; line = 0; col = 0 }
}

/**
 * lwt_wildcard_pattern — a bare `_` pattern (A1-5, #382).
 *
 * @return parser::Pattern  the wildcard pattern node
 */
fn lwt_wildcard_pattern() -> parser::Pattern { parser::WildcardPattern { } }

/**
 * lwt_int_pattern — an integer-literal pattern `v` (A1-5, #382).
 *
 * @param i64 v  the literal's integer value
 * @return parser::Pattern  the literal pattern node
 */
fn lwt_int_pattern(v: i64) -> parser::Pattern {
    parser::LiteralPattern { value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }; line = 0; col = 0 } }
}

/**
 * lwt_str_pattern — a string-literal pattern `text` (A1-5, #382).
 *
 * @param str text  the literal's own text
 * @return parser::Pattern  the literal pattern node
 */
fn lwt_str_pattern(text: str) -> parser::Pattern {
    parser::LiteralPattern { value = parser::Expr { kind = parser::StrLit { text = text }; line = 0; col = 0 } }
}

/**
 * lwt_bind_pattern — `case as binding` (a variant case-select + payload bind),
 * or `case` (no binding) when `binding` is empty (A1-5, #382).
 *
 * @param str case_name  the pattern's case name
 * @param str binding  the name to bind the payload to (empty = no binding)
 * @return parser::Pattern  the bind pattern node
 */
fn lwt_bind_pattern(case_name: str, binding: str) -> parser::Pattern {
    parser::BindPattern { type_name = lwt_path1(case_name); has_binding = binding != ""; binding = binding; is_slice = false; slice_type = null; type_args = teko::list::empty() }
}

/**
 * lwt_arm — an UNGUARDED match arm over `pat`, whose body is `body` (A1-5,
 * #382).
 *
 * @param parser::Pattern pat  the arm's pattern
 * @param []checker::TStatement body  the arm's statement block
 * @return checker::TArm  the typed arm node
 */
fn lwt_arm(pat: parser::Pattern, body: []checker::TStatement) -> checker::TArm {
    checker::TArm { pattern = pat; has_when = false; guard = lwt_num_i64(0); body = body }
}

/**
 * lwt_guarded_arm — a `when`-guarded match arm over `pat` (A1-5, #382).
 *
 * @param parser::Pattern pat  the arm's pattern
 * @param checker::TExpr guard  the `when` guard condition
 * @param []checker::TStatement body  the arm's statement block
 * @return checker::TArm  the typed arm node
 */
fn lwt_guarded_arm(pat: parser::Pattern, guard: checker::TExpr, body: []checker::TStatement) -> checker::TArm {
    checker::TArm { pattern = pat; has_when = true; guard = guard; body = body }
}

/**
 * lwt_match_value — a VALUE-producing `TMatchExpr` over `subject`/`arms`, typed
 * `k` (A1-5, #382).
 *
 * @param checker::TExpr subject  the match's subject expression
 * @param []checker::TArm arms  the match's arms, in order
 * @param checker::PrimKind k  the match expression's own resolved primitive
 *                             type
 * @return checker::TExpr  the typed `TMatchExpr` node
 */
fn lwt_match_value(subject: checker::TExpr, arms: []checker::TArm, k: checker::PrimKind) -> checker::TExpr {
    checker::TExpr { kind = checker::TMatchExpr { subject = subject; arms = arms }; type = lwt_prim(k); line = 0; col = 0 }
}

/**
 * lwt_variant2 — an inline `checker::Variant` of two NOMINAL (`Named`) cases,
 * in order (A1-5, #382).
 *
 * @param str a  the first case's Named type name
 * @param str b  the second case's Named type name
 * @return checker::Type  the inline `Variant` type
 */
fn lwt_variant2(a: str, b: str) -> checker::Type {
    checker::Variant { members = teko::list::push(teko::list::push(teko::list::empty(), checker::Named { name = a }), checker::Named { name = b }) }
}

/**
 * lwt_circle_layout — `struct Circle { radius: i64 }`'s registered layout
 * (A1-5, #382).
 *
 * @return LStructLayout  Circle's resolved layout
 */
fn lwt_circle_layout() -> LStructLayout {
    layout_of("Circle", teko::list::push(teko::list::empty(), "radius"), teko::list::push(teko::list::empty(), LType::I64))
}

#test
fn lwt_lowers_match_enum_member_pattern_via_registered_ordinal() {
    let subject = lwt_typed_var("c", checker::Named { name = "Color" })
    let arm0 = lwt_arm(lwt_bind_pattern("Red", ""), teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_num_i64(10))))
    let arm1 = lwt_arm(lwt_wildcard_pattern(), teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_num_i64(0))))
    let arms = teko::list::push(teko::list::push(teko::list::empty(), arm0), arm1)
    let match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    let params = teko::list::push(teko::list::empty(), lwt_param("c", "Color"))
    let body = teko::list::push(teko::list::empty(), lwt_ret(match_expr))
    let f = lwt_fn("pick_color", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    let enums = teko::list::push(teko::list::empty(), LEnumInfo { name = "Color"; members = teko::list::push(teko::list::push(teko::list::empty(), "Red"), "Green") })
    let lf = match lower_function(f, teko::list::empty(), teko::list::empty(), enums) { LoweredFunction as r => r.func; error as err => return }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = const 0")
    teko::assert::str_contains(text, "%3 = icmpeq %0, %2")
    teko::assert::str_contains(text, "branch %3, #B2(), #B3()")
    teko::assert::str_contains(text, "  #B3:\n    jump #B4()")
}

/**
 * An `==` comparison between two enum-typed operands resolves through `prim_kind_of`'s `I32`
 * ordinal carrier (`enum_carrier_ltype`, #594 T-B) instead of the "non-primitive arithmetic
 * operand" honest stop — the exact shape measured on the compiler's OWN native self-host
 * corpus (`reg_class == MRegClass::FPR`, hundreds of sites across `src/backend/*`).
 *
 * @return void
 */
#test
fn lwt_prim_kind_of_resolves_enum_equality_comparison() {
    let a = lwt_typed_var("a", checker::Named { name = "Color" })
    let b = lwt_typed_var("b", checker::Named { name = "Color" })
    let cmp = lwt_cmp(a, teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::EqEq, b)))
    let params = teko::list::push(teko::list::push(teko::list::empty(), lwt_param("a", "Color")), lwt_param("b", "Color"))
    let body = teko::list::push(teko::list::empty(), lwt_ret(cmp))
    let f = lwt_fn("colors_eq", "teko::demo", params, checker::Prim { kind = checker::PrimKind::Bool }, body)
    let lf = match lower_function(f, teko::list::empty(), teko::list::empty(), lwt_color_enums()) { LoweredFunction as r => r.func; error as err => return }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = icmpeq %0, %1")
}

