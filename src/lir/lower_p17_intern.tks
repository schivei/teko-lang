use teko::checker
use teko::parser

/**
 * is_err_loc_call — recognizes `teko::error::err_loc`'s bare last segment: one of the two
 * `error`-diagnostic-adornment builtins this N1 subset lowers directly (0.3.1.0 degrau 22).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `err_loc`
 */
fn is_err_loc_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "err_loc"
}

/**
 * is_err_typed_call — recognizes `teko::error::err_typed`'s bare last segment: `err_loc`'s
 * fat-field twin (0.3.1.0 degrau 22).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `err_typed`
 */
fn is_err_typed_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "err_typed"
}

/**
 * store_error_scalar_field — overwrite ONE already-registered scalar `error` field (`line`/`col`)
 * at `base` with an already-lowered value — the shared write `lower_err_loc_call`'s two
 * overwrites both use.
 *
 * @param base    the destination `error` slot's base-address VReg
 * @param layout  the registered `error` layout
 * @param field   the field's name (`"line"` or `"col"`)
 * @param value   the already-lowered new value (its own `ctx` is the base to append onto)
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 * @throws  when `field` is not registered on `layout` (an internal invariant break)
 */
fn store_error_scalar_field(base: u32, layout: LStructLayout, field: str, value: Lowered, line: u32, col: u32) -> LowerCtx | error {
    let off = match field_offset_of(layout, field) { u32 as o => o; error as err => return err }
    let ty = match field_type_of(layout, field) { LType as t => t; error as err => return err }
    let addr = ctx_alloc(value.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, off, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, value.vreg, ty, line, col))
}

/**
 * store_error_fat_field — overwrite ONE already-registered FAT `error` field (`expected`/
 * `actual`) at `base` with an already-lowered `(ptr, len)` pair — the shared write
 * `lower_err_typed_call`'s two overwrites both use.
 *
 * @param base    the destination `error` slot's base-address VReg
 * @param layout  the registered `error` layout
 * @param field   the field's name (`"expected"` or `"actual"`)
 * @param fo      the already-lowered new `(ptr, len)` pair (its own `ctx` is the base to append
 *                onto)
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return LowerCtx  the advanced context
 * @throws  when `field` is not registered on `layout` (an internal invariant break)
 */
fn store_error_fat_field(base: u32, layout: LStructLayout, field: str, fo: LoweredFat, line: u32, col: u32) -> LowerCtx | error {
    let off = match field_offset_of(layout, field) { u32 as o => o; error as err => return err }
    let addr = ctx_alloc(fo.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, off, line, col))
    store_fat_slot(with_addr, addr.vreg, fo, line, col)
}

/**
 * lower_err_loc_call — `teko::error::err_loc(e, line, col)` (E2): a copy of `e` with `line` and
 * `col` overwritten.
 *
 * PORQUE BAIXADO E NÃO RESOLVIDO POR SÍMBOLO. `tk_error_loc` is `static inline` in `teko_rt.h`
 * with no linkable symbol in `teko_rt.c`, so `native_builtin_symbol` has no entry to resolve it;
 * and a runtime twin would return 72 bytes by value, which this backend's `LCall` — reading ONE
 * result register — cannot capture. Intercepted in `lower_call`, the SAME molde
 * `lower_last_index_of_call` (degrau 15) and `lower_str_from_utf8_call` (degrau 21) already use.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `error`, its source position stamps the emitted
 *             instructions)
 * @param c    the call node (three arguments: the error, the new line, the new column)
 * @return Lowered | error  the advanced context plus the adorned copy's base-address VReg
 * @throws  propagated from lowering an argument, or when the call's own arity is not 3 (an
 *          invariant break — `checker::scope.tks`'s `err_loc` signature already fixed it)
 */
fn lower_err_loc_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 3 {
        return error { message = "native backend N1: `err_loc` expects exactly three arguments (internal)" }
    }
    let src = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let layout = error_struct_layout()
    let dst = copy_error_value(src.ctx, src.vreg, layout, e)
    let lo = match lower_expr(dst.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    let with_line = match store_error_scalar_field(dst.vreg, layout, "line", lo, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    let co = match lower_expr(with_line, c.args[2]) { Lowered as x => x; error as err => return err }
    let with_col = match store_error_scalar_field(dst.vreg, layout, "col", co, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    Lowered { ctx = with_col; vreg = dst.vreg }
}

/**
 * lower_err_typed_call — `teko::error::err_typed(e, expected, actual)` (E2): a copy of `e` with
 * `expected` and `actual` overwritten — `err_loc`'s fat-field twin (two `str` fields instead of
 * two scalars), reusing `copy_error_value` exactly the same way.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `error`, its source position stamps the emitted
 *             instructions)
 * @param c    the call node (three arguments: the error, the expected type text, the actual type
 *             text)
 * @return Lowered | error  the advanced context plus the adorned copy's base-address VReg
 * @throws  propagated from lowering an argument, or when the call's own arity is not 3 (an
 *          invariant break — `checker::scope.tks`'s `err_typed` signature already fixed it)
 */
fn lower_err_typed_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 3 {
        return error { message = "native backend N1: `err_typed` expects exactly three arguments (internal)" }
    }
    let src = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let layout = error_struct_layout()
    let dst = copy_error_value(src.ctx, src.vreg, layout, e)
    let expected = match lower_fat_expr(dst.ctx, c.args[1]) { LoweredFat as x => x; error as err => return err }
    let with_expected = match store_error_fat_field(dst.vreg, layout, "expected", expected, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    let actual = match lower_fat_expr(with_expected, c.args[2]) { LoweredFat as x => x; error as err => return err }
    let with_actual = match store_error_fat_field(dst.vreg, layout, "actual", actual, e.line, e.col) { LowerCtx as x => x; error as err => return err }
    Lowered { ctx = with_actual; vreg = dst.vreg }
}

/**
 * is_f64_bitcast_call — recognizes `teko::f64_bits`/`teko::f64_from_bits`'s bare last segment:
 * the ONE pair of IEEE-754 bit-reinterpretation builtins this N1 subset lowers as a single raw
 * `LUn` move rather than a runtime `LCall` (0.3.1.0 degrau 24 — `lower_call`'s own doc says why).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `f64_bits` or `f64_from_bits`
 */
fn is_f64_bitcast_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    if segs.len == 0 { return false }
    let last = segs[segs.len - 1].name
    last == "f64_bits" || last == "f64_from_bits"
}

/**
 * lower_f64_bitcast_call — `f64_from_bits(x)`/`f64_bits(x)`: one raw `LUn` move
 * (`IToFBits`/`FToIBits`) across the GPR/FPR register-file boundary, with no arithmetic.
 *
 * A bare VReg alias (the ORIGINAL degrau-24 shape) is UNSOUND here: a VReg's register FILE is
 * fixed by its OWN defining instruction, so reusing the operand's id at a float-typed consumer
 * makes ONE numeric id carry two register classes — `regalloc.tks`'s `subst_find` (id-only, no
 * class check) then rewrites both occurrences to whichever interval colored first, so float math
 * reads a wrong-class register (the measured SIGSEGV lowering `checker::float_binop`). Emitting a
 * real move into a FRESH result VReg fixes it.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (for its source position)
 * @param c    the call node (its one argument and its callee, to pick the direction)
 * @return Lowered | error  the advanced context plus the reinterpreted value's fresh VReg, or a
 *                          NAMED internal error when the call's arity is not 1
 */
fn lower_f64_bitcast_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `f64_bits`/`f64_from_bits` expects exactly one argument (internal)" }
    }
    let ao = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let segs = c.callee.segments
    let op = if segs.len > 0 && segs[segs.len - 1].name == "f64_from_bits" { LUnOp::IToFBits } else { LUnOp::FToIBits }
    let r = ctx_alloc(ao.ctx)
    let inst = un_inst(r.vreg, op, ao.vreg, e.line, e.col)
    Lowered { ctx = ctx_append(r.ctx, inst); vreg = r.vreg }
}

/**
 * is_float_parse_call — recognizes `teko::float::parse`'s bare last segment:
 * the IEEE-754 string-to-double parser builtin.
 *
 * `teko::float::parse(str) -> f64` is intercepted in `lower_call` BEFORE
 * `call_symbol` because the result comes back in XMM0/D0 and LCall records no
 * result class, so the native backend's result-register selector would
 * silently corrupt the float value by reading from the integer register. The
 * lowering routes through `tk_rt_float_parse_bits` which returns the IEEE-754
 * payload as a u64 (general-purpose register), and the u64 is bitcasted back.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `parse`
 */
fn is_float_parse_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "parse"
}

/**
 * lower_float_parse_call — `teko::float::parse(str) -> f64`: intercept the
 * call and route through `tk_rt_float_parse_bits`, which wraps the standard
 * float parser and returns IEEE-754 bits as a u64. The u64 result is then
 * bitcasted back to f64 on the assignment side.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is f64)
 * @param c    the call node (one argument: a str)
 * @return Lowered | error  the advanced context plus the call result VReg, or
 *                          a NAMED internal error when the call's arity is not 1
 */
fn lower_float_parse_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `float::parse` expects exactly one argument (internal)" }
    }
    let fo = match lower_fat_expr(ctx, c.args[0]) { LoweredFat as x => x; error as err => return err }
    let rr = ctx_alloc(fo.ctx)
    let with_call = ctx_append(rr.ctx, call_inst(rr.vreg, "tk_rt_float_parse_bits", two_args(fo.ptr, fo.len), false, e.line, e.col))
    Lowered { ctx = with_call; vreg = rr.vreg }
}

/**
 * is_bytes_from_ptr_call — recognizes `teko::mem::bytes_from_ptr`'s bare last segment: the
 * slice-lift builtin that constructs a `[]byte` fat value from a raw pointer and a byte count.
 *
 * `bytes_from_ptr(ptr<byte>, u64) -> []byte` is intercepted in `lower_call_fat` BEFORE
 * `call_symbol` because no runtime call is needed — the fat result is simply the two already-
 * lowered arguments bound together as a `(ptr, len)` pair.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `bytes_from_ptr`
 */
fn is_bytes_from_ptr_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "bytes_from_ptr"
}

/**
 * lower_bytes_from_ptr_call — `teko::mem::bytes_from_ptr(ptr, len) -> []byte`: identity fat-
 * lift. Constructs the fat slice directly from the two already-lowered scalar arguments, with no
 * runtime call at all — the SAME no-ABI-call shortcut `lower_f64_bitcast_call` takes, though that
 * one still needs a real machine instruction to cross the GPR/FPR register-file boundary, where
 * this one needs none at all (a fat pointer is already just its two scalar halves).
 *
 * @param ctx  the lowering context
 * @param c    the call node (two arguments: ptr<byte> and u64 len)
 * @return LoweredFat | error  the advanced context plus the (ptr, len) pair, or a NAMED
 *                             internal error when the call's arity is not 2
 */
fn lower_bytes_from_ptr_call(ctx: LowerCtx, c: checker::TCall) -> LoweredFat | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `bytes_from_ptr` expects exactly two arguments (internal)" }
    }
    let ptr_lowered = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let len_lowered = match lower_expr(ptr_lowered.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    LoweredFat { ctx = len_lowered.ctx; ptr = ptr_lowered.vreg; len = len_lowered.vreg }
}
