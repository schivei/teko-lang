/** push_inst_block — a fresh block with `inst` appended to its instruction stream. */
fn push_inst_block(b: LBlock, inst: LInst) -> LBlock {
    LBlock { id = b.id; params = b.params; insts = teko::list::push(b.insts, inst) }
}

// append_inst — `f` with `inst` appended to the block whose id is `block_id`
// (N1 threads a single block, id 0 — but LOWERING itself builds multi-block
// functions long before isel mirrors them, so this runs once per LIR
// instruction of every function).
// MUTATES `blocks[i]` IN PLACE (an index-assign onto the local `blocks`,
// which aliases the SAME underlying buffer as `f.blocks` — slice value
// semantics copy the {ptr,len} header, not the array) INSTEAD OF rebuilding
// the whole `blocks` list every call. The old rebuild re-pushed a SHALLOW
// STRUCT COPY of every untouched block (`nb = b`), so its `insts` fat
// pointer kept aliasing the SAME instruction buffer across every one of
// those O(blocks) rebuilds — and the outer `blocks` self-append is
// checker-proven free-old-safe, so each rebuild PARKED the previous
// generation's array while an aliased `insts` pointer it carried could still
// be some LATER generation's live push-cache tail — the wild-write chase
// (`TEKO_NATIVE_PUSH_REDZONE`) caught this exact shape, ONE LEVEL BELOW the
// isel-side twins (`append_minst`/`append_minst_x86`) it was first fixed in:
// LOWERING builds `LFunc`/`LBlock` before isel ever mirrors them, so this
// site trips first.

/** with_next_vreg — return a copy of `f` with a new VReg counter. */
fn with_next_vreg(f: LFunc, next_vreg: u32) -> LFunc {
    LFunc { symbol = f.symbol; n_params = f.n_params; param_types = f.param_types; ret_type = f.ret_type; blocks = f.blocks; next_vreg = next_vreg }
}
fn set_block_param(f: LFunc, block_id: u32, vreg: u32) -> LFunc {
    mut blocks = f.blocks
    mut i: u64 = 0
    loop {
        if i >= blocks.len { break }
        if blocks[i].id == block_id {
            blocks[i] = LBlock { id = blocks[i].id; params = teko::list::push(blocks[i].params, vreg); insts = blocks[i].insts }
            break
        }
        i++
    }
    LFunc { symbol = f.symbol; n_params = f.n_params; param_types = f.param_types; ret_type = f.ret_type; blocks = blocks; next_vreg = f.next_vreg }
}

/**
 * align_up — round `v` up to the next multiple of `a` (a no-op when `v` already fits, or
 * when `a` is 0/1 — the zero-size Void case never grows the running offset).
 *
 * @param u32 v  the value to round
 * @param u32 a  the alignment (a power of two, or 0/1 for none)
 * @return u32  `v` rounded up to a multiple of `a`
 */
fn align_up(v: u32, a: u32) -> u32 {
    if a <= 1 { return v }
    let rem = v % a
    if rem == 0 { return v }
    v + (a - rem)
}
