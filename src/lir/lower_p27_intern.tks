use teko::list
use teko::checker
use teko::parser

/**
 * close_lambda_body — fire any still-pending defer (from index 0, LIFO) and
 * append the implicit void return when the lifted body's current block did
 * not already terminate (mirrors `close_function`). A NON-void lambda's
 * block is already terminated by the time this runs — `lower_fn_body`
 * auto-returns its trailing expression (#421) — so this only ever fires for
 * a `void`-returning lambda's fall-through (A1-7 #382; defer replay A1-2
 * #382).
 *
 * @param LowerCtx ctx  the lifted body's lowering context, after its
 *                      statements have been lowered
 * @param u32 line  the source line to propagate onto a synthesized `ret`
 * @param u32 col  the source column to propagate onto a synthesized `ret`
 * @return LowerCtx | error  the closed context (its `.func` is the closed
 *                           function; its `.rodata`/`.lifted` carry forward
 *                           any growth the fall-through defer replay made),
 *                           or a NAMED internal error when a pending defer
 *                           fails to lower
 */
fn close_lambda_body(ctx: LowerCtx, line: u32, col: u32) -> LowerCtx | error {
    if block_terminated(ctx.func, ctx.block_id) { return ctx }
    let replayed = match replay_defers(ctx, 0) { LowerCtx as c => c; error as err => return err }
    ctx_append(replayed, ret_void_inst(line, col))
}

// LoweredLambda — a lifted lambda body's (placeholder-symbol) `LFunc` + the
// rodata/lifted tables it (and everything lowered before it) grew (A1-7,
// #382 — mirrors `LoweredFunction`, plus the lifted-function table so a
// NESTED lambda inside this one's own body is not lost).

/**
 * build_lambda_lfunc — lower a lambda's OWN body into an independent
 * `LFunc`: env-first parameters (`materialize_lambda_params`), each capture
 * bound by loading it off the env parameter (`bind_lambda_captures`), then
 * the body statements (`lower_fn_body` — a NON-void lambda auto-returns its
 * trailing expression, #421), closed like a function (`close_lambda_body`).
 * Built with a PLACEHOLDER symbol — the caller (`lower_lambda`) renames it
 * once its final lifted id is known (A1-7, #382).
 *
 * @param checker::TLambda lam  the lambda node to lower
 * @param LStructLayout env_layout  the env aggregate's resolved layout
 * @param LowerCtx ctx  the ENCLOSING lowering context (its layouts/rodata/
 *                      enums/lifted tables seed the lifted body's own; its
 *                      OWN func/env/block_id are NOT reused)
 * @param u32 line  the source line to propagate onto every synthesized inst
 * @param u32 col  the source column to propagate onto every synthesized
 *                 inst
 * @return LoweredLambda | error  the built (placeholder-named) LFunc + the
 *                                grown rodata/lifted tables, or an error
 *                                when the body fails to lower
 */
fn build_lambda_lfunc(lam: checker::TLambda, env_layout: LStructLayout, ctx: LowerCtx, line: u32, col: u32) -> LoweredLambda | error {
    let fat_ret = is_fat_type(lam.ret)
    let ptypes = lambda_param_ltypes(lam.params, ctx.enums)
    let env_first = env_first_param_types(ptypes)
    let all_ptypes = if fat_ret { teko::list::push(env_first, LType::Ptr) } else { env_first }
    let seed0 = new_func("", all_ptypes.len to u32, all_ptypes, ltype_of(lam.ret, ctx.enums))
    let seed = materialize_lambda_params(seed0, lam, line, col)
    let slot_reg = (lam.params.len + 1) to u32
    let seeded = if fat_ret {
        ParamSeed { func = append_inst(seed.func, 0, param_inst(slot_reg, slot_reg, line, col)); env = seed.env }
    } else {
        seed
    }
    let ctx0 = LowerCtx {
        func = seeded.func; block_id = 0; env = seeded.env
        layouts = ctx.layouts; rodata = ctx.rodata; enums = ctx.enums; lifted = ctx.lifted
        variants = ctx.variants
        defers = teko::list::empty(); loop_targets = teko::list::empty(); externs = ctx.externs
        flat_symbols = ctx.flat_symbols; ret_type = lam.ret
        has_ret_len_slot = fat_ret; ret_len_slot = if fat_ret { slot_reg } else { 0 }
        ref_fns = ctx.ref_fns; field_decls = ctx.field_decls; addr_taken = collect_addr_taken_locals(lam.body, ctx.ref_fns, ctx.enums); table = ctx.table
        region_stack = teko::list::empty(); escaping = teko::list::empty(); frees_old_names = teko::list::empty(); bracket_depth = 0
    }
    let with_captures = match bind_lambda_captures(ctx0, env_layout, lam.captures, line, col) { LowerCtx as c => c; error as err => return err }
    let done = match lower_fn_body(with_captures, lam.body, ltype_of(lam.ret, ctx.enums), line, col) { LowerCtx as c => c; error as err => return err }
    let closed = match close_lambda_body(done, line, col) { LowerCtx as c => c; error as err => return err }
    LoweredLambda { func = closed.func; rodata = closed.rodata; lifted = closed.lifted }
}

/**
 * lower_lambda — a closure LITERAL (`TLambda`): build the env aggregate
 * from the ENCLOSING scope's captures (`build_lambda_env`), lower the
 * lambda's OWN body into a lifted `LFunc` (`build_lambda_lfunc`) — its FINAL
 * id is `built.lifted.len` (reserved AFTER any nested lambda inside its own
 * body, so ids never collide), so it is renamed (`rename_lfunc`) only now —
 * then build the closure literal `{fn=lifted, env}` — mirrors the C
 * backend's `(tk_closure){ &__tkclo_<id>, env }` (`codegen.tks:5177-5178`)
 * (A1-7, #382).
 *
 * @param LowerCtx ctx  the lowering context (the ENCLOSING scope)
 * @param checker::TExpr e  the lambda expression (for its source position)
 * @param checker::TLambda lam  the lambda node to lower
 * @return Lowered | error  the advanced context + the closure literal's base
 *                          address, or an error when the body fails to
 *                          lower
 */
fn lower_lambda(ctx: LowerCtx, e: checker::TExpr, lam: checker::TLambda) -> Lowered | error {
    let env_layout = lambda_env_layout(lam.captures, ctx.enums)
    let envo = match build_lambda_env(ctx, env_layout, lam.captures, e.line, e.col) { Lowered as x => x; error as err => return err }
    let built = match build_lambda_lfunc(lam, env_layout, envo.ctx, e.line, e.col) { LoweredLambda as x => x; error as err => return err }
    let id = built.lifted.len
    let fn_sym = lift_lambda_symbol(id)
    let named = rename_lfunc(built.func, fn_sym)
    let ctx2 = ctx_with_lifted(ctx_with_rodata(envo.ctx, built.rodata), teko::list::push(built.lifted, named))
    build_closure_literal(ctx2, fn_sym, envo.vreg, e.line, e.col)
}

// lower_stmt — lower one statement, extending the env on a `let` and signaling block
// termination on a `return`. Mirrors emit_stmt over the subset; out-of-subset statements
// honest-stop.

/**
 * lower_binding — `let x = e`: a str/slice-typed binding (A1-4, #382) lowers `e` through the FAT
 * path and binds (ptr, len); every other binding lowers `e` through `lower_value_into_type`
 * (coercion-aware, C6/C7 null-union) and binds the single result VReg plainly.
 *
 * A MUTABLE fat binding (`mut xs: []T = …`) binds a 16-byte FRAME SLOT instead of the VReg pair
 * (`lenv_bind_fat_slot`): only memory survives the merge a later reassignment sits behind
 * (list-builtin degrau). A `mut` SCALAR binding whose ADDRESS escapes into a `ref<T>` call
 * argument SOMEWHERE in this function (`ctx.addr_taken`, `collect_addr_taken_locals` — 0.3.1.0
 * degrau 18) binds a one-word FRAME SLOT the same way, for the same reason: only memory survives
 * a write made through the escaped handle.
 *
 * A `Reference`-bound binding (`ref r [: T] = d`) takes NEITHER of those paths and is answered
 * first, by `bind_reference_local`: it is the identity axis, not a value, and the ordinary path
 * would copy it.
 *
 * A binding whose name ESCAPES this function (`binding_conveys_escape`, NP3b) runs its whole RHS
 * lowering (whichever of the three branches below it takes) inside a conveyance bracket
 * (`lower_binding_conveyed`): a retained call-result must land at `rr` — the conveyance anchor, root
 * through NP5, the caller's own region at the NP6 move — not the frame/block region a later
 * `tk_region_drop_u` reclaims. This is delegated AFTER `bind_target_name`/the `Reference` check, so
 * a destructuring target's own honest-stop and an identity `ref` binding are unaffected.
 *
 * @param LowerCtx ctx  the lowering context to append the binding's instructions into
 * @param checker::TBinding b  the typed binding statement
 * @return LowerStmtOut | error  the context with the name bound, or an honest stop
 * @throws  when the target is a destructuring pattern (out of the N1 subset), or propagated
 *          from lowering the value
 * @implNote NP5: a NON-escaping binding registers `name` as its enclosing open region's own
 *           `decl_name` (`register_scope_decl_name`, the N-level selector's registration half,
 *           §1/§7) BEFORE its RHS lowers — so a LATER self-append of `name` from inside a nested
 *           scope (an inner loop/if-arm) routes its growth back to THIS scope
 *           (`native_scope_region_of`) instead of dying with the nested one. An escaping binding
 *           skips this: its value is conveyed to `rr` regardless of scope, never block-routed.
 */
fn lower_binding(ctx: LowerCtx, b: checker::TBinding) -> LowerStmtOut | error {
    let name = match bind_target_name(b.target) { str as s => s; error as err => return err }
    match b.bound { checker::Reference => return bind_reference_local(ctx, b, name); _ => { } }
    if binding_conveys_escape(ctx.escaping, name) { return lower_binding_conveyed(ctx, b, name) }
    lower_binding_direct(register_scope_decl_name(ctx, name), b, name)
}

/**
 * lower_binding_conveyed — `lower_binding`'s escaping arm (NP3b): `emit_region_leaves` (detour the
 * runtime's current region to the conveyance anchor `rr`), run `lower_binding_direct` unchanged so
 * ITS call-result(s) materialize at `rr`, then `emit_region_enters` (restore the frame/block region
 * for every statement that follows). `ctx.region_stack` is read but never rewritten by either half
 * (the region-axis twin of a bare defer replay, §2d) — `out.ctx.region_stack` is the SAME list
 * `ctx.region_stack` was, so the restore is exact.
 *
 * NESTED escaping binding (`ctx.bracket_depth > 0`, e.g. an escaping `let` INSIDE a match/if arm
 * that is itself part of an OUTER escaping binding's RHS): skips the leave/enter entirely and just
 * runs `lower_binding_direct` on `ctx` UNCHANGED. The outer bracket already moved `current` down to
 * the SAME conveyance anchor for this whole subtree; re-leaving/re-entering here would
 * `tk_region_enter_u` the FRAME region back in mid-span, so anything the OUTER bracket's RHS still
 * has left to lower after this nested binding would wrongly land back in the frame — exactly the
 * shape `tk_region_drop_u` would free out from under the outer binding's own escaping value (the C
 * route's `dctx.bracket_depth == 0` re-bracket guard, mirrored via `ctx.bracket_depth` here since the
 * native backend has no `dctx` — see the field's own doc on `LowerCtx`).
 *
 * @param ctx   the lowering context, positioned to lower `b`'s RHS
 * @param b     the typed binding statement (its LHS name already known to escape)
 * @param name  the bound name (`bind_target_name(b.target)`, computed once by the caller)
 * @return      the context with the name bound through the bracket, or an honest stop
 * @throws      propagated from `lower_binding_direct`
 * @since 0.3.1
 */
fn lower_binding_conveyed(ctx: LowerCtx, b: checker::TBinding, name: str) -> LowerStmtOut | error {
    if ctx.bracket_depth > 0 { return lower_binding_direct(ctx, b, name) }
    let left = emit_region_leaves(ctx, b.value.line, b.value.col)
    let marked = ctx_with_bracket_depth(left, 1)
    let out = match lower_binding_direct(marked, b, name) { LowerStmtOut as x => x; error as err => return err }
    let entered = emit_region_enters(out.ctx, b.value.line, b.value.col)
    LowerStmtOut { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); terminated = out.terminated }
}

/**
 * lower_binding_direct — `lower_binding`'s own body, minus the `Reference`/conveyance dispatch
 * (extracted so the bracket in `lower_binding_conveyed` can run it unchanged, NP3b): a str/slice-
 * typed binding (A1-4, #382) lowers `e` through the FAT path and binds (ptr, len); every other
 * binding lowers `e` through `lower_value_into_type` (coercion-aware, C6/C7 null-union) and binds
 * the single result VReg plainly.
 *
 * A MUTABLE fat binding (`mut xs: []T = …`) binds a 16-byte FRAME SLOT instead of the VReg pair
 * (`lenv_bind_fat_slot`): only memory survives the merge a later reassignment sits behind
 * (list-builtin degrau). A `mut` SCALAR binding whose ADDRESS escapes into a `ref<T>` call
 * argument SOMEWHERE in this function (`ctx.addr_taken`, `collect_addr_taken_locals` — 0.3.1.0
 * degrau 18) binds a one-word FRAME SLOT the same way, for the same reason: only memory survives
 * a write made through the escaped handle.
 *
 * @param LowerCtx ctx  the lowering context to append the binding's instructions into
 * @param checker::TBinding b  the typed binding statement (its `bound` never `Reference`)
 * @param name  the bound name (`bind_target_name(b.target)`, computed once by the caller)
 * @return LowerStmtOut | error  the context with the name bound, or an honest stop
 * @throws  propagated from lowering the value
 */
fn lower_binding_direct(ctx: LowerCtx, b: checker::TBinding, name: str) -> LowerStmtOut | error {
    if is_fat_type(b.bound) {
        let fo = match lower_fat_expr(ctx, b.value) { LoweredFat as x => x; error as err => return err }
        if b.kind == parser::BindKind::Mut { return bind_mutable_fat(fo, name, b.value.line, b.value.col) }
        return LowerStmtOut { ctx = ctx_bind_fat(fo.ctx, name, fo.ptr, fo.len); terminated = false }
    }
    let raw = match lower_value_into_type(ctx, b.bound, b.value) { Lowered as x => x; error as err => return err }
    let lo = own_bound_value(raw, b.value)
    if needs_scalar_slot(lo.ctx, name, b.bound) { return bind_addr_taken_scalar(lo, name, b.bound, b.value.line, b.value.col) }
    LowerStmtOut { ctx = ctx_bind(lo.ctx, name, lo.vreg); terminated = false }
}

/**
 * needs_scalar_slot — must the local `name`, of declared type `ty`, be reified into a one-word
 * frame slot at its binding site? Only when its address is taken somewhere in this function AND it
 * is a REGISTER value, which is the only shape that has no address without the slot.
 *
 * The register-value half of the question used to be implicit — `ctx.addr_taken` held register
 * values and nothing else — and stopped being so when a `ref` binding over an AGGREGATE source
 * started contributing to that same set (`addr_taken_ref_binding`): an aggregate is already its own
 * address and must stay ordinarily bound, its debt being paid at the REASSIGNMENT instead
 * (`aliased_aggregate_write_through`).
 *
 * @param ctx   the lowering context (its `addr_taken` set and declared-enum table)
 * @param name  the local's name
 * @param ty    the local's declared type
 * @return      whether the binding site owes this local a scalar frame slot
 * @since       0.3.1 (own-backend `ref`-binding placement gap)
 */
fn needs_scalar_slot(ctx: LowerCtx, name: str, ty: checker::Type) -> bool {
    contains_str(ctx.addr_taken, name) && is_register_value_type(ty, ctx.enums)
}
