
/**
 * is_str_arg_builtin — is `sym` one of the seven io sinks `lower_str_arg_call` was written for
 * (`IO_STR_SINK_ENTRIES`: the six `(tk_str) -> void` writers plus `_Noreturn tk_panic_str`)?
 *
 * A ROUTING QUESTION, NOT AN ABI ONE, and that distinction is the whole reason it is no longer
 * spelled `fat_arg_builtin_arity(sym) == 1`. Its truth sends a call into `lower_str_arg_call`,
 * which demands ONE argument drawn from `lower_fat_expr`'s closed producer set and emits a void
 * call — a shape that fits the io group and nothing else. The ARITY table, by contrast, describes
 * the callee's C signature and must span every by-value-`tk_str` entry of both seed headers; the
 * two coincided only while that table listed nothing but this group, and completing it separated
 * them. An arity-keyed spelling would now drag `tk_str_len`, `tk_rt_getenv` and every
 * `teko__assert__` entry onto a lowering that was never written for them.
 *
 * @param str sym  the resolved runtime symbol (`call_symbol`'s result)
 * @return bool  true iff `sym` is one of the seven io sinks
 */
pub fn is_str_arg_builtin(sym: str) -> bool {
    sym == "tk_print" || sym == "tk_println" || sym == "tk_eprint" ||
    sym == "tk_eprintln" || sym == "tk_write" || sym == "tk_ewrite" ||
    sym == "tk_panic_str"
}
