

/** print_op — the operation text (no result prefix). */
fn print_op(op: LOp) -> str {
    match op {
        LConstInt as c => print_const_int(c)
        LConstFloat as c => print_const_float(c)
        LBin as b => print_bin(b)
        LUn as u => print_un(u)
        LCall as c => print_call(c)
        LParam as p => print_param(p)
        LRet as r => print_ret(r)
        LJump as j => print_jump(j)
        LBranch as br => print_branch(br)
        LAlloca as a => print_alloca(a)
        LFieldAddr as fa => print_field_addr(fa)
        LLoad as l => print_load(l)
        LStore as s => print_store(s)
        LGlobalAddr as g => print_global_addr(g)
        LCallIndirect as ci => print_call_indirect(ci)
        LFuncAddr as fa => print_func_addr(fa)
    }
}

/** print_inst — one instruction as its full `    <prefix><op>` line (4-space
    body indent). */
fn print_inst(inst: LInst) -> str {
    teko::str::concat("    ", result_prefix(inst), print_op(inst.op))
}

/** print_block — a block header `  #Bn:` (with block-args when present) followed by
    its instructions, one per line. */
fn print_block(b: LBlock) -> str {
    mut out = teko::str::concat("  #B", teko::u64_to_str(b.id to u64))
    if b.params.len != 0 { out = teko::str::concat(out, "(", print_args(b.params), ")") }
    out = teko::str::concat(out, ":\n")
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        out = teko::str::concat(out, print_inst(b.insts[i]), "\n")
        i++
    }
    out
}

/** print_sig_params — the `%0: i64, %1: i64` parameter list of a function header:
    each parameter's VReg id (0..n_params) with its machine type. */
fn print_sig_params(f: LFunc) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= f.param_types.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, vreg_ref(i to u32), ": ", ltype_name(f.param_types[i]))
        i++
    }
    out
}

/** print_func — a full function: `func @sym(params) -> ret {` + its blocks + `}`. */
fn print_func(f: LFunc) -> str {
    mut out = teko::str::concat("func @", f.symbol, "(", print_sig_params(f), ") -> ", ltype_name(f.ret_type), " {\n")
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        out = teko::str::concat(out, print_block(f.blocks[i]))
        i++
    }
    teko::str::concat(out, "}\n")
}

/** print_layout — one struct-layout header line: `layout <name>: size=<N> align=<N>
    { <field>@<offset>, … }` (A1-3, #382). */
fn print_layout(l: LStructLayout) -> str {
    mut out = teko::str::concat("layout ", l.name, ": size=", teko::u64_to_str(l.size to u64), " align=", teko::u64_to_str(l.align to u64), " {")
    mut i: u64 = 0
    loop {
        if i >= l.field_names.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, l.field_names[i], "@", teko::u64_to_str(l.field_offsets[i] to u64))
        i++
    }
    teko::str::concat(out, "}\n")
}

/** print_layouts — every registered struct layout, one header line each, in table order
    (empty for a module with no aggregates — byte-identical to N1's output). */
fn print_layouts(m: LModule) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= m.layouts.len { break }
        out = teko::str::concat(out, print_layout(m.layouts[i]))
        i++
    }
    out
}

/** print_rodata_bytes — a rodata entry's raw bytes as a `[b0, b1, …]` decimal list — binary-
    safe (no C-string escaping needed) and fully deterministic (A1-4, #382). */
fn print_rodata_bytes(bytes: []byte) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= bytes.len { break }
        if i > 0 { out = teko::str::concat(out, ", ") }
        out = teko::str::concat(out, teko::u64_to_str(bytes[i] to u64))
        i++
    }
    out
}

/** print_rodata_entry — one rodata header line: `rodata <symbol>: [<bytes>]` (A1-4, #382). */
fn print_rodata_entry(r: LRodata) -> str {
    teko::str::concat("rodata ", r.symbol, ": [", print_rodata_bytes(r.bytes), "]\n")
}

/** print_rodata_section — every interned rodata entry, one header line each, in table order
    (empty for a module with no interned strings — byte-identical to A1-3's output)
    (A1-4, #382). */
fn print_rodata_section(m: LModule) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= m.rodata.len { break }
        out = teko::str::concat(out, print_rodata_entry(m.rodata[i]))
        i++
    }
    out
}

/** print_global_entry — one global header line: `global <symbol>: <ty> [<bytes>]`
    (A1-4, #382). */
fn print_global_entry(g: LGlobal) -> str {
    teko::str::concat("global ", g.symbol, ": ", ltype_name(g.ty), " [", print_rodata_bytes(g.bytes), "]\n")
}

/** print_globals_section — every declared global, one header line each, in table order
    (empty for a module with no globals — A1-4, #382). */
fn print_globals_section(m: LModule) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= m.globals.len { break }
        out = teko::str::concat(out, print_global_entry(m.globals[i]))
        i++
    }
    out
}

/** print_lmodule — the whole module as stable text: its struct-layout table, its rodata
    table, its globals table (each section empty when unused — byte-identical to A1-3's
    output for a module with no aggregates/strings), then every function in declaration
    order, blank-line separated. This is the artifact the diff/fixpoint gate reads. */
pub fn print_lmodule(m: LModule) -> str {
    mut out = print_layouts(m)
    out = teko::str::concat(out, print_rodata_section(m))
    out = teko::str::concat(out, print_globals_section(m))
    mut i: u64 = 0
    loop {
        if i >= m.funcs.len { break }
        if i > 0 { out = teko::str::concat(out, "\n") }
        out = teko::str::concat(out, print_func(m.funcs[i]))
        i++
    }
    out
}

