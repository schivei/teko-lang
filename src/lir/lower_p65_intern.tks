use teko::checker
use teko::parser

fn struct_layout_of_field(te: parser::TypeExpr, known: []LStructLayout) -> LStructLayout | null {
    // Struct layouts are keyed by CANONICAL (qualified) name — `find_struct_layout` is called at
    // field-access time with `named_type_name(arg.type)`, a `resolve_named`-qualified name. A field
    // whose annotation is itself written QUALIFIED (`decl: parser::TypeDecl`, `sig: checker::TFuncSig`
    // — pervasive across the self-hosted compiler's own parser/checker structs) must therefore be
    // looked up by its FULL path name; the bare single-segment lookup alone matched only a
    // root-namespace type (canonical == bare), so every non-root nested struct-by-value field fell
    // through to `null` and was under-sized to the 8-byte `Ptr` fallback (`field_size_of`), placing
    // every LATER field at the wrong offset and truncating the field's own inline extent — the
    // wrong-OFFSET base a `tk_slice_elem_box`/by-address copy then read garbage from (the native
    // `resolve_named`/`assemble_sel` SIGSEGV, arch-independent because this layout math is shared).
    // The C leg is immune: it lets `cc` lay every struct out. Try the qualified path first, then the
    // bare segment — purely additive, so no name that matched before stops matching.
    match te {
        parser::NamedType as nt => match find_known_struct_layout(known, path_name_of(nt.path)) {
            LStructLayout as l => l
            null => match single_segment_name(nt.path) {
                str as bare => find_known_struct_layout(known, bare)
                null => null
            }
        }
        _ => null
    }
}

/**
 * named_type_name_of — the bare name of a single-segment Named type annotation
 * (`Point`, not `a::Point`); `null` for a multi-segment path or any other
 * TypeExpr shape (#414, #382).
 *
 * @param parser::TypeExpr te  the syntactic type annotation
 * @return str?  the single segment's name, or `null`
 */
fn named_type_name_of(te: parser::TypeExpr) -> str | null {
    match te {
        parser::NamedType as nt => single_segment_name(nt.path)
        _ => null
    }
}

/**
 * single_segment_name — `p`'s lone segment name, or `null` when `p` has zero or
 * more than one segment (#414, #382).
 *
 * @param parser::Path p  the path to inspect
 * @return str?  `p`'s single segment's name, or `null`
 */
fn single_segment_name(p: parser::Path) -> str | null {
    if p.segments.len != 1 { return null }
    p.segments[0].name
}

/**
 * path_last_segment_name — `p`'s LAST segment name, or `null` for the degenerate zero-segment path.
 *
 * The deliberate sibling of `single_segment_name`, NOT a widening of it. The two answer different
 * questions and their callers need opposite answers: `named_type_name_of` (hence
 * `is_ref_param_ann`) must keep rejecting a qualified path, because the `Ref<T>` wrapper it probes
 * for is compiler-SYNTHESIZED single-segment (`src/parser/parse_type.tks`) and a user type
 * legitimately named `Ref` in some namespace must never be mistaken for it and silently auto-ref'd.
 * The fat-pointer walk, by contrast, must accept a qualified path — see `typeexpr_is_fat_named`.
 *
 * @param parser::Path p  the path to inspect
 * @return str?  `p`'s last segment's name, or `null` for a segment-less path
 * @since 0.3.1.0 degrau 31
 */
fn path_last_segment_name(p: parser::Path) -> str | null {
    if p.segments.len == 0 { return null }
    p.segments[p.segments.len - 1].name
}

/**
 * path_qualifier_of — `p`'s QUALIFIER: the segments BEFORE the last, joined with `::` (`checker::
 * TypeTable` → `"checker"`, `teko::checker::TypeTable` → `"teko::checker"`). A bare or segment-less
 * path has no qualifier and answers `""`, the value `checker::type_table_find_path` reads as "this
 * probe is bare".
 *
 * @param parser::Path p  the path to inspect
 * @return str  the qualifier, or `""` when `p` carries at most one segment
 * @since 0.3.1.0 degrau 31
 */
fn path_qualifier_of(p: parser::Path) -> str {
    if p.segments.len < 2 { return "" }
    mut out = p.segments[0].name
    mut i: u64 = 1
    loop {
        if i + 1 >= p.segments.len { break }
        out = teko::str::concat(out, "::", p.segments[i].name)
        i++
    }
    out
}

/**
 * find_known_struct_layout — the entry of `layouts` named `name`, or `null`
 * when none matches (a NULLABLE sibling of `find_struct_layout`: a
 * forward-referenced or non-struct field type is a routine "not (yet)
 * known" outcome here, not an internal invariant break) (#414, #382).
 *
 * @param []LStructLayout layouts  the struct-layout table to search
 * @param str name  the struct name to look up
 * @return LStructLayout?  the matching entry, or `null`
 */
fn find_known_struct_layout(layouts: []LStructLayout, name: str) -> LStructLayout | null {
    mut i: u64 = 0
    loop {
        if i >= layouts.len { break }
        if layouts[i].name == name { return layouts[i] }
        i++
    }
    null
}

/**
 * field_size_of — a field's byte size: the BY-ADDRESS width of a nested aggregate field when
 * `nested` is present (`nested_by_address_size`), else `ft`'s scalar `ltype_size` (#414, #382).
 *
 * A nested struct/class field is NOT stored inline in this backend's memory model: `store_struct_field`
 * boxes the value into fresh runtime storage (`own_embedded_value`) and writes its ADDRESS, and
 * `lower_field_access` reads that word back as a `Ptr`. The slot therefore holds a pointer and must be
 * pointer-WIDE, never the pointee's inline size — which is only coincidentally >= a pointer for the
 * self-hosted compiler's own (large) nested structs and is SMALLER for a nested generic instance like
 * `Box<Box<i32>>`'s `Box<i32>` field (4 bytes). Sizing that field 4 truncated the stored pointer on the
 * outer struct's whole-value copy (`named_layout_bytes`, the return/box copy) and the next read
 * dereferenced the truncated word — the nested-generic native SIGSEGV.
 *
 * @param LType ft  the field's machine class (`ltype_of_typeexpr`'s mapping)
 * @param LStructLayout? nested  the field's nested struct layout, when known
 * @return u32  the field's byte size
 */
fn field_size_of(ft: LType, nested: LStructLayout | null) -> u32 {
    match nested {
        LStructLayout as l => nested_by_address_size(l)
        null => ltype_size(ft)
    }
}

/**
 * nested_by_address_size — the slot width a nested aggregate field occupies: at least a pointer, since
 * the field holds the ADDRESS of a boxed copy (`store_struct_field`/`lower_field_access`). The
 * pointee's own inline size is the floor's UPPER bound, preserved so no already-correct layout (every
 * self-hosted nested struct is wider than a pointer) shrinks; only a sub-pointer instance is widened.
 *
 * @param l  the nested field type's resolved layout
 * @return   `max(l.size, sizeof(Ptr))`
 */
fn nested_by_address_size(l: LStructLayout) -> u32 {
    let ptr = ltype_size(LType::Ptr)
    if l.size > ptr { return l.size }
    ptr
}

/**
 * field_align_of — a field's byte alignment: the BY-ADDRESS alignment of a nested aggregate field when
 * `nested` is present (`nested_by_address_align`, at least pointer alignment for the same reason
 * `field_size_of` clamps its size), else `ft`'s scalar `ltype_align` (#414, #382).
 *
 * @param LType ft  the field's machine class (`ltype_of_typeexpr`'s mapping)
 * @param LStructLayout? nested  the field's nested struct layout, when known
 * @return u32  the field's byte alignment
 */
fn field_align_of(ft: LType, nested: LStructLayout | null) -> u32 {
    match nested {
        LStructLayout as l => nested_by_address_align(l)
        null => ltype_align(ft)
    }
}

/**
 * nested_by_address_align — the alignment a nested aggregate field's pointer slot needs: at least
 * pointer alignment, since the slot holds an address (`field_size_of`'s size clamp, on the alignment
 * axis). A wider pointee keeps its own stricter alignment.
 *
 * @param l  the nested field type's resolved layout
 * @return   `max(l.align, alignof(Ptr))`
 */
fn nested_by_address_align(l: LStructLayout) -> u32 {
    let ptr = ltype_align(LType::Ptr)
    if l.align > ptr { return l.align }
    ptr
}

/**
 * visited_name_has — is `name` already present in `visited` — the alias-chain recursion guard
 * `typeexpr_is_fat_named` threads (mirrors `checker::str_set_has`'s job, kept local since that
 * helper is private to the checker module).
 *
 * @param visited  the alias names already entered on this chain
 * @param name     the name to test
 * @return         whether `name` already appears in `visited`
 */
fn visited_name_has(visited: []str, name: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= visited.len { break }
        if visited[i] == name { return true }
        i++
    }
    false
}

/**
 * typeexpr_is_fat_named — is a single-segment NAMED annotation `nt` fat, resolved THROUGH any
 * alias chain? A bare `str` answers directly; any other name is looked up in `table`
 * (`checker::type_table_find`, tolerant of BOTH `TypeTable` shapes this compiler builds — a
 * bare-name declaration and `checker::type_table_of`'s canonical-name re-collection). When the
 * found declaration is a transparent `AliasBody` (`type S = str`), the SAME question is asked of
 * the alias's own right-hand-side annotation instead (`typeexpr_is_fat_walk`), recursively, until
 * a non-alias answer is reached. A name the table does not know at all — a generic type-
 * PARAMETER (`T`), never registered as a type — answers `false`, the same answer the old
 * syntactic-only check always gave a non-`str` name, so a generic struct's still-untested layout
 * path (`layout_of_fields`'s own doc-comment: "collapse to Ptr … harmless, since no A1-3 fixture
 * instantiates one") is unaffected. A name found but NOT an alias (a struct/class/enum/trait/
 * variant/extern/interface) answers `false` too — those are sized by their OWN layout or a plain
 * scalar word, never the `{ptr, len}` image.
 *
 * A QUALIFIED annotation is resolved too, and that is the whole of 0.3.1.0 degrau 31. Until then
 * this asked `single_segment_name` and gave up on any multi-segment path, so a parameter annotated
 * with a qualified alias of a fat type — `vt_table: checker::TypeTable`, where `TypeTable` is
 * `[]TypeReg` — was bound as a SCALAR while every caller passed the two-word `{ptr, len}` image and
 * every later read asked the SEMANTIC `is_fat_type`. Measured on the base compiler, that split cost
 * two distinct failures and only one of them was loud: a fat PARAMETER honest-stopped (`native
 * backend N1: \`vt_table\` is not a fat-pointer local`, the self-host's own stop), while a fat FIELD
 * silently reserved 8 bytes for a 16-byte store and read the following field's bytes back as a
 * length — the same live miscompilation this predicate was introduced to close for BARE aliases,
 * still open for qualified ones. The lookup is `checker::type_table_find_path`, which resolves the
 * qualifier against BOTH `TypeTable` shapes and falls back to the namespace-blind `type_table_find`.
 *
 * @param nt       the named annotation (bare or QUALIFIED)
 * @param table    the program's type table
 * @param visited  the alias names already entered on this chain (`visited_name_has`'s recursion
 *                 guard — the checker already rejects a cyclic alias before lowering ever runs, so
 *                 this is a defensive backstop, never a live path, mirroring `type_reaches_ref`'s
 *                 own guard in `checker/borrow.tks`)
 * @return         whether `nt`, resolved through any alias, denotes `str` or `[]T`
 */
fn typeexpr_is_fat_named(nt: parser::NamedType, table: checker::TypeTable, visited: []str) -> bool {
    let name = match path_last_segment_name(nt.path) { str as s => s; null => return false }
    if name == "str" { return true }
    if visited_name_has(visited, name) { return false }
    match checker::type_table_find_path(table, path_qualifier_of(nt.path), name) {
        parser::TypeDecl as td => typeexpr_is_fat_decl_body(td.body, table, teko::list::push(visited, name))
        error => false
    }
}
