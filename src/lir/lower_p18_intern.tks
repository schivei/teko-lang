use teko::checker
use teko::parser

/**
 * is_buf_ptr_call — recognizes `teko::mem::buf_ptr`'s bare last segment: the arena bump-allocate
 * builtin that allocates `len` bytes in ROOT (0.3.1.0 degrau 26).
 *
 * `teko::mem::buf_ptr(len: u64) -> ptr<byte>` is intercepted BEFORE the plain `call_symbol`
 * resolver table because `buf_ptr` returns a RAW `ptr<byte>` with NO lifetime tracking of its
 * own — the checker/backend cannot see whether the caller retains it past the innermost open
 * scope (the exact shape a `{}`/if-arm/loop-iteration region NP5 opens would free out from under,
 * a confirmed native-runtime UAF measured on `theory/heisenbug-fix`'s first NP5 push, CI run
 * 30946284244: gen1 self-host regressed from item 6616/6616+link to a SIGSEGV at item 3518,
 * `cg_name_reaches_byvalue`). Routing this ONE builtin to root is leak-safe (root is never
 * dropped mid-function) and sidesteps that hazard entirely; giving `buf_ptr` its own tracked
 * lifetime (so it COULD route to the enclosing scope) is deferred to the later memory program /
 * route B — out of this crumb's scope.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `buf_ptr`
 */
fn is_buf_ptr_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "buf_ptr"
}

/**
 * lower_buf_ptr_call — `teko::mem::buf_ptr(len: u64) -> ptr<byte>`: allocate `len` bytes into
 * ROOT (via `tk_region_root_u()`) and return the pointer. This is the enclosing-region twin of C
 * codegen's `emit_buf_ptr` MINUS the enclosing-region routing (`is_buf_ptr_call`'s own doc):
 * `buf_ptr`'s raw, untracked-lifetime pointer routinely outlives the innermost lexical scope, so
 * routing it to `region_current_vreg` (NP5's per-arm/per-iteration region) is UNSOUND — that
 * region's own `close_native_region`/`close_loop_body` drop would free the buffer while a caller
 * still holds it. Root is NEVER dropped mid-function, so this is leak-safe by construction
 * (never UAF) — the residual "buf_ptr leaks past its natural scope" cost is the SAME one this
 * builtin has always carried, not a new one.
 *
 * The runtime call is:
 *   `ptr<byte> result = tk_region_alloc(tk_region_root(), (size_t)(len))`
 *
 * We lower this to two `LCall` instructions:
 *   1. Call `tk_region_root_u()` to get the root region handle
 *   2. Call `tk_region_alloc(region, len)` to allocate within that region
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `ptr<byte>`, its source position stamps the
 *             emitted instructions)
 * @param c    the call node (its one `u64` argument: the allocation size)
 * @return Lowered | error  the advanced context plus the allocated pointer's VReg
 * @throws  when the call's arity is not 1 (an invariant break — `checker::scope.tks`'s `buf_ptr`
 *          signature already fixed it), or propagated from lowering the argument
 */
fn lower_buf_ptr_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `buf_ptr` expects exactly one u64 argument (internal)" }
    }
    // Lower the length argument
    let len_lowered = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }

    // Call tk_region_root_u() to get the ROOT region (leak-safe: never UAF, buf_ptr's raw
    // pointer routinely outlives the innermost lexical scope).
    let region_vreg = ctx_alloc(len_lowered.ctx)
    let with_region_call = ctx_append(region_vreg.ctx, call_inst(region_vreg.vreg, "tk_region_root_u", teko::list::empty(), false, e.line, e.col))

    // Call tk_region_alloc(region, len) to allocate
    let result_vreg = ctx_alloc(with_region_call)
    let alloc_args = two_args(region_vreg.vreg, len_lowered.vreg)
    let with_alloc_call = ctx_append(result_vreg.ctx, call_inst(result_vreg.vreg, "tk_region_alloc", alloc_args, false, e.line, e.col))

    Lowered { ctx = with_alloc_call; vreg = result_vreg.vreg }
}

/**
 * is_load_u64_call — recognizes `teko::mem::load_u64`'s bare last segment: P1's raw memory-READ
 * primitive over an already-computed address (`arena-em-teko.md` §2). No `call_ns` stamp is
 * needed to intercept this call — there is only ONE fixed signature, so the recognition key is
 * the bare last path segment, exactly like `bytes_from_ptr`/`buf_ptr`.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `load_u64`
 * @since 0.3.1
 */
fn is_load_u64_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "load_u64"
}

/**
 * lower_load_u64_call — `teko::mem::load_u64(addr: u64) -> u64`: read ONE 64-bit word at the
 * caller-computed address. Lowers directly to `LLoad{addr, ty=I64}` (`lir.tks:151`) — the SAME
 * instruction every struct field read already emits — with NO runtime call: the argument's own
 * VReg IS the address, because a raw `u64` address carries no field offset to add on top (P1's
 * whole point — a load/store that does not allocate, unlike `bytes_from_ptr`).
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its type is `u64`, its source position stamps the load)
 * @param c    the call node (its one `u64` argument: the address)
 * @return Lowered | error  the advanced context plus the loaded word's VReg
 * @throws  when the call's arity is not 1 (an invariant break — `checker::scope.tks`'s
 *          `load_u64` signature already fixed it), or propagated from lowering the argument
 * @since 0.3.1
 */
fn lower_load_u64_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 1 {
        return error { message = "native backend N1: `load_u64` expects exactly one u64 argument (internal)" }
    }
    let addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let r = ctx_alloc(addr.ctx)
    let with_load = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, LType::I64, e.line, e.col))
    Lowered { ctx = with_load; vreg = r.vreg }
}

/**
 * is_store_u64_call — recognizes `teko::mem::store_u64`'s bare last segment: P1's raw memory-
 * WRITE twin of `load_u64`.
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `store_u64`
 * @since 0.3.1
 */
fn is_store_u64_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "store_u64"
}

/**
 * lower_store_u64_call — `teko::mem::store_u64(addr: u64, v: u64) -> void`: write ONE 64-bit
 * word to the caller-computed address. Lowers directly to `LStore{addr, value, ty=I64}`
 * (`lir.tks:155`) with no runtime call — the twin of `lower_load_u64_call`.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (`-> void`; its source position stamps the store)
 * @param c    the call node (two `u64` arguments: address, then value, in that order)
 * @return Lowered | error  the advanced context plus VReg 0 (void has no result, the same
 *                          convention every other void call in this file follows)
 * @throws  when the call's arity is not 2 (an invariant break — `checker::scope.tks`'s
 *          `store_u64` signature already fixed it), or propagated from lowering either argument
 * @since 0.3.1
 */
fn lower_store_u64_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 2 {
        return error { message = "native backend N1: `store_u64` expects exactly two u64 arguments (internal)" }
    }
    let addr = match lower_expr(ctx, c.args[0]) { Lowered as x => x; error as err => return err }
    let value = match lower_expr(addr.ctx, c.args[1]) { Lowered as x => x; error as err => return err }
    let with_store = ctx_append(value.ctx, store_inst(addr.vreg, value.vreg, LType::I64, e.line, e.col))
    Lowered { ctx = with_store; vreg = 0 to u32 }
}

/**
 * is_mem_ns_builtin — whether `c` is the `teko::mem` builtin whose last path segment is `name`. The
 * checker stamps every `teko::mem::*` region builtin with `call_ns == "teko::mem"` (`typer.tks`),
 * so the recognition key is the (namespace, last-segment) pair rather than the bare path — unlike
 * `buf_ptr`, whose `call_ns` is empty. Interception in `lower_call` runs BEFORE `call_symbol`, or
 * the call falls into the mangler and emits an undefined `teko_teko__mem__<name>` symbol.
 *
 * @param c     the typed call (its `callee` path + `call_ns`)
 * @param name  the builtin's last-segment name (`region_new`/`region_alloc`/`free`)
 * @return      true iff `c` names `teko::mem::<name>`
 */
fn is_mem_ns_builtin(c: checker::TCall, name: str) -> bool {
    let segs = c.callee.segments
    c.call_ns == "teko::mem" && segs.len > 0 && segs[segs.len - 1].name == name
}

/**
 * is_region_new_call — recognizes `teko::mem::region_new`: the manual region opener with no
 * arguments that the C route emits as `(uintptr_t)tk_region_new(tk_region_root())`
 * (`codegen.tks:4166`). Stamped by the checker with `call_ns == "teko::mem"` (`typer.tks:964`), so
 * it is recognized by the (namespace, last-segment) pair and intercepted in `lower_call` BEFORE
 * `call_symbol`, else it falls into the mangler and emits the undefined symbol
 * `teko_teko__mem__region_new`.
 *
 * @param c  the typed call (its `callee` + `call_ns`)
 * @return   true iff `c` names `teko::mem::region_new`
 * @since 0.3.1
 */
fn is_region_new_call(c: checker::TCall) -> bool {
    is_mem_ns_builtin(c, "region_new")
}

/**
 * lower_region_new_call — `teko::mem::region_new() -> uptr`: open a fresh child region of the
 * process root and return its opaque handle. Mirrors the C route's inline
 * `(uintptr_t)tk_region_new(tk_region_root())` (`codegen.tks:4166`) with two chained `LCall`s, in
 * the mould of `lower_buf_ptr_call`: `tk_region_root()` then `tk_region_new(root)`. The result is a
 * `uptr` in an integer register — no special result class. Reuses the existing runtime primitives
 * (`teko_rt.h:149,153`); adds no runtime.
 *
 * @param ctx  the lowering context
 * @param e    the call expression (its position stamps the instructions; its type is `uptr`)
 * @param c    the typed call (zero arguments)
 * @return     the advanced context + the handle's VReg, or a propagated error
 * @since 0.3.1
 */
fn lower_region_new_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    if c.args.len != 0 { return error { message = "native backend N1: `region_new` takes no arguments (internal)" } }
    let root = ctx_alloc(ctx)
    let with_root = ctx_append(root.ctx, call_inst(root.vreg, "tk_region_root", teko::list::empty(), false, e.line, e.col))
    let result = ctx_alloc(with_root)
    let new_args = teko::list::push(teko::list::empty(), root.vreg)
    let with_new = ctx_append(result.ctx, call_inst(result.vreg, "tk_region_new", new_args, false, e.line, e.col))
    Lowered { ctx = with_new; vreg = result.vreg }
}

/**
 * is_region_alloc_call — recognizes `teko::mem::region_alloc`: bump-allocate ONE `T` into the
 * caller-chosen region (`call_ns == "teko::mem"`, `typer.tks:1001`). Intercepted in `lower_call`
 * before `call_symbol` for the same reason as `is_region_new_call`.
 *
 * @param c  the typed call
 * @return   true iff `c` names `teko::mem::region_alloc`
 * @since 0.3.1
 */
fn is_region_alloc_call(c: checker::TCall) -> bool {
    is_mem_ns_builtin(c, "region_alloc")
}

/**
 * region_alloc_elem — the element type `T` of a `teko::mem::region_alloc`'s `ptr<T>` result type,
 * read off the call expression exactly as `emit_region_alloc` reads `p.inner` (`codegen.tks:3822`).
 *
 * @param ety  the call expression's resolved type (`ptr<T>`)
 * @return     `T`, or a NAMED internal error when the checker's `ptr<T>` invariant is broken
 */
fn region_alloc_elem(ety: checker::Type) -> checker::Type | error {
    match ety {
        checker::Ptr as p => match p.inner { checker::Type as t => t; null => error { message = "native backend N1: `region_alloc` result is an opaque ptr (internal — checker must set ptr<T>)" } }
        _ => error { message = "native backend N1: `region_alloc` result is not a ptr type (internal)" }
    }
}

/**
 * region_alloc_elem_size — the byte width `tk_region_alloc` must bump for one `elem`: a fat
 * (`str`/`[]T`) element is the 16-byte `{ptr, len}` slot, an aggregate element is its registered
 * layout size, and any register-class element is its machine width. Mirrors the C route's
 * `sizeof(T)`.
 *
 * @param elem  the element type `T`
 * @param ctx   the lowering context (for the aggregate layout lookup + enum set)
 * @return      the element's byte width
 */
fn region_alloc_elem_size(elem: checker::Type, ctx: LowerCtx) -> u32 {
    if is_fat_type(elem) { return fat_slot_bytes() }
    match aggregate_box_bytes(elem, ctx) {
        u32 as b => b
        null => ltype_size(ltype_of(elem, ctx.enums))
    }
}
