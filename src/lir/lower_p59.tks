use teko::checker
use teko::lexer
use teko::parser

/**
 * enter_self_append_region — the N-level selector's runtime realization (§1/§7): emit
 * `tk_region_enter_u(<R_decl>)` around a self-append's own grow call, so the helper bare
 * `tk_slice_push`/`tk_slice_push_fo` — which bump-allocates from WHATEVER `tk_region_current()` is
 * — materializes the grown buffer in the accumulator's DECLARING scope instead of the innermost
 * currently-open one. Three cases, by `native_scope_region_of(ctx.region_stack, name)`:
 *
 * - REGISTERED (a `u32` target, `native_scope_region_of` resolved a declaring `NativeRegionFrame`):
 *   bracket to it. The real N-level fix (`mem_loop_per_iter` — an accumulator declared in an outer
 *   arm, grown in an inner loop, must not die per-iteration).
 * - UNREGISTERED (`null`) AND `name` ESCAPES this function (`binding_conveys_escape`): emit NO
 *   bracket (`opened=false`). An escaping self-append's assignment already runs inside
 *   `lower_assign_conveyed`'s own OUTER bracket (`emit_region_leaves`, detouring the runtime's
 *   current region all the way down to the conveyance anchor `rr`, root through NP5) — that detour
 *   is what makes the grown buffer survive the frame drop. A `stack[0]` (frame) fallback here would
 *   OVERRIDE that detour with `tk_region_enter_u(fr)`, landing the buffer back in `fr` — which
 *   `emit_region_drops` frees at the very return this self-append's value is escaping THROUGH: a
 *   confirmed double-free/heap-corruption UAF (measured on `theory/heisenbug-fix`, CI run
 *   30947982111, gen1 SIGSEGV in `emit_call`; the C route never makes this mistake —
 *   `cg_self_append_escapes`, `codegen.tks:8020`, threads `dctx.rr` for exactly this case, reserving
 *   its own `scope_region_of` selector for the non-escaping route only). This native twin now
 *   mirrors that split.
 * - UNREGISTERED AND NOT escaping: bracket to the FRAME (`ctx.region_stack[0]`) — leak-safe (the
 *   frame outlives every use inside this function), never UAF; a non-escaping accumulator whose
 *   `decl_name` registration was overwritten by a LATER binding in the same scope (only the
 *   last-bound name per scope is tracked, `register_scope_decl_name`) still just leaks wider than
 *   optimal (a peak-memory cost, not a crash) — a known, accepted follow-up, NOT this crumb's fix.
 * - Empty `ctx.region_stack`: no bracket (unreachable in practice — a self-append only lowers
 *   inside a function body, which always has an open frame region by the time it lowers).
 *
 * @param ctx   the lowering context
 * @param name  the self-append target's name
 * @param line  the source line to stamp the emitted call with
 * @param col   the source column to stamp
 * @return      the (possibly bracketed) context + whether a bracket was opened
 * @since 0.3.1
 */
fn enter_self_append_region(ctx: LowerCtx, name: str, line: u32, col: u32) -> SelfAppendBracket {
    match native_scope_region_of(ctx.region_stack, name) {
        u32 as target => SelfAppendBracket { ctx = ctx_append(ctx, void_call_inst("tk_region_enter_u", one_region_arg(target), false, line, col)); opened = true }
        null => {
            if binding_conveys_escape(ctx.escaping, name) {
                SelfAppendBracket { ctx = ctx; opened = false }
            } else {
                if ctx.region_stack.len > 0 {
                    let fr_vreg = ctx.region_stack[0].region_vreg
                    SelfAppendBracket { ctx = ctx_append(ctx, void_call_inst("tk_region_enter_u", one_region_arg(fr_vreg), false, line, col)); opened = true }
                } else {
                    SelfAppendBracket { ctx = ctx; opened = false }
                }
            }
        }
    }
}

/**
 * leave_self_append_region — the CLOSE half of `enter_self_append_region`'s bracket: emit
 * `tk_region_leave()` to pop the detour back to whatever region was current before, restoring it for
 * every statement that follows the grow call. A no-op when `opened` is false (no matching enter ran).
 *
 * @param ctx     the lowering context, positioned right after the grow call
 * @param opened  whether `enter_self_append_region` actually opened a bracket
 * @param line    the source line to stamp the emitted call with
 * @param col     the source column to stamp
 * @return        the context with the bracket closed (or unchanged, when nothing was opened)
 * @since 0.3.1
 */
fn leave_self_append_region(ctx: LowerCtx, opened: bool, line: u32, col: u32) -> LowerCtx {
    if !opened { return ctx }
    ctx_append(ctx, void_call_inst("tk_region_leave", teko::list::empty(), false, line, col))
}

/**
 * lower_assign_plain_self_append — lower a self-append `xs = teko::list::push(xs, item)` whose
 * accumulator the checker did NOT prove a linear chain (`is_frees_old_self_append`'s twin for the
 * PLAIN, non-`_fo`, grow symbol): the N-level selector's bracket
 * (`enter_self_append_region`/`leave_self_append_region`) wraps the SAME `tk_slice_push` call
 * `store_fat_through_addr`'s generic FAT path would otherwise reach unbracketed via
 * `lower_fat_expr`/`lower_call_fat`/`lower_list_builtin` — routing its growth to the accumulator's
 * DECLARING scope (§1) rather than whatever scope happens to be innermost at the assign site (the
 * `mem_loop_per_iter` fix). Mirrors `lower_assign_frees_old` exactly, one axis over (the grow symbol).
 *
 * @param ctx   the lowering context
 * @param slot  the accumulator's fat frame slot (the store target)
 * @param a     the typed self-append assignment (its `a.value` is the `list::push` call)
 * @return      the context with the bracketed grow + store appended, or an honest stop
 * @throws      when `a.value` is not the expected push call (internal — unreachable, since
 *              `checker::assign_is_self_append(a)` already guarantees it), or propagated from
 *              lowering the growth call
 * @since 0.3.1
 */
fn lower_assign_plain_self_append(ctx: LowerCtx, slot: u32, a: checker::TAssign) -> LowerStmtOut | error {
    match a.value.kind {
        checker::TCall as c => {
            let br = enter_self_append_region(ctx, a.name, a.value.line, a.value.col)
            let fo = match lower_list_push(br.ctx, a.value, c, "tk_slice_push") { LoweredFat as x => x; error as err => return err }
            let left = leave_self_append_region(fo.ctx, br.opened, a.value.line, a.value.col)
            LowerStmtOut { ctx = store_fat_slot(left, slot, fo, a.value.line, a.value.col); terminated = false }
        }
        _ => store_fat_through_addr(ctx, slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
    }
}

/**
 * is_frees_old_self_append — is `a` a self-append `xs = teko::list::push(xs, …)` whose accumulator
 * `xs` the checker PROVED a linear chain (`ctx.frees_old_names`, from `checker::fn_frees_old_vars`)?
 * When so, the copy-grow may park the superseded buffer for reuse — the exact upgrade the C emitter
 * makes at `codegen.tks:9068`. The native backend, unlike the C emitter, has no per-assign body at
 * the push site, so it consults the precomputed set instead of re-deriving the proof.
 *
 * @param ctx  the lowering context (its precomputed `frees_old_names` oracle)
 * @param a    the typed assignment
 * @return     whether this self-append may free-old on grow
 * @since 0.3.1 (native free-old parity, #148)
 */
fn is_frees_old_self_append(ctx: LowerCtx, a: checker::TAssign) -> bool {
    checker::assign_is_self_append(a) && contains_str(ctx.frees_old_names, a.name)
}

/**
 * lower_assign_frees_old — lower a PROVEN-LINEAR self-append `xs = teko::list::push(xs, item)` with
 * the free-old grow symbol (`tk_slice_push_fo`) instead of the plain `tk_slice_push`, then store the
 * grown pair back through the accumulator's frame slot. Behaviour is IDENTICAL to the plain push
 * (same returned buffer + length); the only difference is the runtime parks the superseded buffer on
 * a copy-grow, which the `assign_frees_old` proof makes safe. Mirrors `emit_assign`'s `@fo` arm
 * (`codegen.tks:9068`) one axis over (a slot store vs a C lvalue assign).
 *
 * @param ctx   the lowering context
 * @param slot  the accumulator's fat frame slot (the store target)
 * @param a     the typed self-append assignment (its `a.value` is the `list::push` call)
 * @return      the context with the free-old grow + store appended, or an honest stop
 * @throws      when `a.value` is not the expected push call (internal), or propagated from lowering
 * @since 0.3.1 (native free-old parity, #148)
 * @implNote NP5: the grow call is bracketed by `enter_self_append_region`/`leave_self_append_region`
 *           (the N-level selector, §1/§7), so the free-old-on-grow parks the SUPERSEDED buffer only
 *           after the runtime's own current region is the accumulator's DECLARING scope — the exact
 *           bracket that kills the heisenbug this crumb exists for: WITHOUT it, a self-append inside
 *           a nested loop/if-arm scope would free-old-park into whatever region is innermost at the
 *           call site, which a later `tk_region_drop_u` could free out from under a stale pre-grow
 *           pointer someone still held (`tk_free_block` only parks at `tk_cur_rsp == 0`; a free-old
 *           INSIDE a live, correctly-routed region never parks a block anything else can reach).
 */
fn lower_assign_frees_old(ctx: LowerCtx, slot: u32, a: checker::TAssign) -> LowerStmtOut | error {
    match a.value.kind {
        checker::TCall as c => {
            let br = enter_self_append_region(ctx, a.name, a.value.line, a.value.col)
            let fo = match lower_list_push(br.ctx, a.value, c, "tk_slice_push_fo") { LoweredFat as x => x; error as err => return err }
            let left = leave_self_append_region(fo.ctx, br.opened, a.value.line, a.value.col)
            LowerStmtOut { ctx = store_fat_slot(left, slot, fo, a.value.line, a.value.col); terminated = false }
        }
        _ => store_fat_through_addr(ctx, slot, a, teko::str::concat("the str/slice local `", a.name, "`"))
    }
}

/**
 * lower_assign_field — `recv.field = e` / `recv.field op= e`: lower the receiver to its base
 * address, compute the field's address via its registered layout offset, then store. A FAT field
 * (`a.bound`, 0.3.1.0 raiz A — R3) delegates to `store_fat_through_addr`, which writes both halves
 * of its `{ptr, len}` pair — writing the single word `store_assign_value` writes left `h.name.len`
 * reading whatever the field's PREVIOUS length happened to be, silently (raiz-comum §5.2). Before
 * that write, `check_store_fat_span` re-asserts the SAME under-size guard `store_struct_fields`
 * already runs on the struct-literal path (raiz A — R4): a fat value landing in a field whose
 * registered layout span is under `fat_slot_bytes()` would let the 16-byte `{ptr, len}` store
 * overrun into the next field, so the guard honest-stops NAMING the struct and field instead of
 * leaving the overrun to surface as a heap corruption at teardown. Every other field delegates to
 * `store_assign_value` (a compound op first loads the current value, applies it, then stores the
 * result).
 *
 * @param ctx  the lowering context
 * @param a    the typed assignment (kind `Field`; `a.target` is the typed field access)
 * @return     the context with the field store appended, or an honest stop
 * @throws     when the target is not a field access, the receiver's type is not a laid-out
 *             nominal, the field is unknown, the field's layout span under-sizes a fat store, or
 *             propagated from lowering the value
 */
fn lower_assign_field(ctx: LowerCtx, a: checker::TAssign) -> LowerStmtOut | error {
    let fa = match a.target.kind { checker::TFieldAccess as f => f; _ => return error { message = "native backend N1: field-assignment target is not a field access (internal)" } }
    let ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    let name = match named_type_name(fa.receiver.type) { str as s => s; error as err => return err }
    let layout = match find_struct_layout(ro.ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    let off = match field_offset_of(layout, fa.field) { u32 as o => o; error as err => return err }
    let addr = ctx_alloc(ro.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, ro.vreg, off, a.target.line, a.target.col))
    if is_fat_type(a.bound) {
        let decl = find_field_decl_type(with_addr.field_decls, layout.name, fa.field)
        match check_store_fat_span(with_addr, layout, fa.field, decl, a.value) { error as err => return err; null => { } }
        return store_fat_through_addr(with_addr, addr.vreg, a, "a str/slice field")
    }
    store_assign_value(with_addr, addr.vreg, ltype_of(a.bound, ro.ctx.enums), a)
}

/**
 * store_assign_value — the shared tail of a field assignment: a plain `=` stores the lowered RHS
 * directly (coerced into the field's DECLARED type first, `lower_value_into_type` — a `T | null`
 * field stores the wrapper's address, never a bare payload); a compound op loads the CURRENT field
 * value first, applies the arithmetic, then stores the result.
 *
 * @param LowerCtx ctx  the lowering context to append the store's instructions into
 * @param u32 addr  the already-computed field address VReg
 * @param LType field_ty  the field's machine class (the store's width)
 * @param checker::TAssign a  the typed assignment (kind `Field`)
 * @return LowerStmtOut | error  the context with the store appended, or an honest stop
 * @throws  when the compound operator/type has no LIR op, or propagated from lowering the value
 */
fn store_assign_value(ctx: LowerCtx, addr: u32, field_ty: LType, a: checker::TAssign) -> LowerStmtOut | error {
    if a.op == lexer::TokenKind::Assign {
        let raw = match lower_value_into_type(ctx, a.bound, a.value) { Lowered as x => x; error as err => return err }
        let vo = own_embedded_value(raw, a.value)
        return LowerStmtOut { ctx = ctx_append(vo.ctx, store_inst(addr, vo.vreg, field_ty, a.value.line, a.value.col)); terminated = false }
    }
    let cr = ctx_alloc(ctx)
    let with_load = ctx_append(cr.ctx, load_inst(cr.vreg, addr, field_ty, a.value.line, a.value.col))
    let vo = match lower_expr(with_load, a.value) { Lowered as x => x; error as err => return err }
    let k = match prim_kind_of(a.bound, ctx.enums, "range bound") { checker::PrimKind as p => p; error as err => return err }
    let plain = match plain_op_of_compound(a.op) { lexer::TokenKind as t => t; error as err => return err }
    let op = match lbinop_of(plain, k) { LBinOp as o => o; error as err => return err }
    let guarded = if is_int_div_or_rem(op) { lower_div_zero_guard(vo.ctx, vo.vreg, a.value.line, a.value.col) } else { vo.ctx }
    let rr = ctx_alloc(guarded)
    let with_bin = ctx_append(rr.ctx, bin_inst(rr.vreg, op, cr.vreg, vo.vreg, a.value.line, a.value.col))
    LowerStmtOut { ctx = ctx_append(with_bin, store_inst(addr, rr.vreg, field_ty, a.value.line, a.value.col)); terminated = false }
}

/**
 * lower_assign_index — `xs[i] = e` / `xs[i] op= e`: the slice element WRITE, the sibling of
 * `lower_index_slice`/`lower_index_fat`'s element READ (0.3.1.0 degrau 28). Before it existed the
 * whole statement honest-stopped ("slice element index-assignment not yet lowered"), which is the
 * primitive `loop <name> in <slice>`'s own desugaring writes with (`parser::loop_head`) and the
 * ordinary way Teko fills a buffer, so no program that writes an element could be built natively.
 *
 * The receiver is lowered as a FAT producer, not as a plain address: the LENGTH half is what the
 * bounds guard needs. Then the index is lowered EXACTLY ONCE (`element_addr_at` takes the VReg, so
 * the guard and the address read the same value — re-lowering it would evaluate a side-effecting
 * index expression twice, and could even guard a different number than it wrote at), the guard traps
 * through the SAME positioned `tk_panic_oob_at` the C route's own `emit_index_assign` calls, and the
 * store splits by element shape (`store_assign_elem`).
 *
 * @param ctx  the lowering context
 * @param a    the typed assignment (kind `Index`; `a.target` is the typed `TIndex` LHS and
 *             `a.bound` the slice's element type)
 * @return     the context with the element store appended, or an honest stop
 * @throws     when the target is not a subscript or its receiver is not a slice, and propagated
 *             from lowering the receiver, the index or the value
 */
fn lower_assign_index(ctx: LowerCtx, a: checker::TAssign) -> LowerStmtOut | error {
    let ix = match a.target.kind { checker::TIndex as ti => ti; _ => return error { message = "native backend N1: index-assignment target is not a subscript (internal)" } }
    match slice_element_type(ix.receiver.type) { checker::Type => { }; error as err => return err }
    let ro = match lower_fat_expr(ctx, ix.receiver) { LoweredFat as x => x; error as err => return err }
    let io = match lower_expr(ro.ctx, ix.index) { Lowered as x => x; error as err => return err }
    let checked = lower_index_bounds_guard(io.ctx, io.vreg, ro.len, a.target.line, a.target.col)
    let stride = elem_byte_stride(a.bound, checked.enums)
    let addr = element_addr_at(checked, ro.ptr, io.vreg, stride, a.target.line, a.target.col)
    store_assign_elem(addr.ctx, addr.vreg, a)
}

