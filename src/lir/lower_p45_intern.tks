use teko::checker
use teko::parser

/**
 * lower_match_stmt — a `match` used as a STATEMENT (a Void-typed `TMatchExpr`,
 * embedded via `TExprStmt` — mirrors an if-statement): a merge block with ZERO
 * block-args, each arm jumping to it after running for effect; the dead-code
 * fallback past the last arm also jumps there unconditionally (A1-5, #382).
 *
 * @param LowerCtx ctx  the lowering context positioned right after the subject
 * @param checker::TExpr e  the match expression (its `.type` is Void)
 * @param checker::TMatchExpr m  the typed match (subject already lowered; only
 *                               `.arms` used)
 * @param MatchSubj subj  the match's already-lowered subject
 * @return Lowered  the advanced context (positioned at the merge block); `vreg`
 *                  unused
 * @throws  when any arm fails to lower
 *
 * @implNote C1-6 audit: the final context is sourced from `chain` (the
 *           fold's result, carrying every arm's rodata and lifted-closure
 *           growth), never the stale pre-lowering `ctx` — mirrors the
 *           `lower_coalesce` fix. A scalar an arm re-assigns is threaded
 *           through the merge as a block-param (`add_merge_scalar_params`),
 *           mirroring `lower_if_stmt`, EXCEPT a name any arm's PATTERN also
 *           binds is excluded (`reassigned_scalars_for_match`, review round
 *           1 Finding 2) (#389 F1).
 */
fn lower_match_stmt(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr, subj: MatchSubj) -> Lowered | error {
    let names = reassigned_scalars_for_match(m.arms, ctx.env)
    let indices = merge_scalar_indices(ctx.env, names)
    let mergeb = alloc_block(ctx.func)
    let merged = add_merge_scalar_params(mergeb.func, mergeb.block_id, ctx.env, names)
    let base_ctx = ctx_with(ctx, merged.func, ctx.block_id, ctx.env)
    let chain = match lower_match_arms_stmt(base_ctx, e, m.arms, subj, mergeb.block_id, names) { LowerCtx as c => c; error as err => return err }
    let closed = append_inst(chain.func, chain.block_id, jump_inst(mergeb.block_id, arm_scalar_args(chain.env, indices), e.line, e.col))
    Lowered { ctx = ctx_with(chain, closed, mergeb.block_id, merged.env); vreg = 0 }
}

/**
 * lower_match — a `match` used as either a VALUE (`e.type` is not Void) or a
 * STATEMENT (`e.type` is Void). Lowers the subject ONCE, then a linear TEST
 * CHAIN: each arm's pattern test branches into its own body block on success,
 * or falls through to the NEXT arm's test on failure; mirrors `lower_if_expr`'s
 * value/void split (A1-5, #382).
 *
 * @param LowerCtx ctx  the lowering context to lower the whole match into
 * @param checker::TExpr e  the match expression node
 * @param checker::TMatchExpr m  the typed match (subject + arms)
 * @return Lowered  the advanced context + the match's result VReg (unused for a
 *                  statement)
 * @throws  when the subject, any pattern test, or any arm body fails to lower
 */
fn lower_match(ctx: LowerCtx, e: checker::TExpr, m: checker::TMatchExpr) -> Lowered | error {
    let so = match lower_match_subject_conveyed(ctx, m) { MatchSubjOut as x => x; error as err => return err }
    if type_is_void(e.type) { return lower_match_stmt(so.ctx, e, m, so.subj) }
    lower_match_value(so.ctx, e, m, so.subj)
}

/**
 * match_arm_binds_escaping — does any arm of this match bind (`as x`, or a field-destructure
 * `Ty { f; g }`) a name that the enclosing function's escape analysis (`ctx.escaping`) proved
 * OUTLIVES the frame? A bind pattern's `x` ALIASES the subject's payload, and a field pattern's
 * `f`/`g` alias interior boxed pointers OF that payload — so when any such alias escapes (is stored
 * into an outer accumulator, returned, or captured), the SUBJECT'S OWN construction must be
 * conveyed to `rr` too, exactly as an escaping `let x = <subject>` would be. Without this the
 * subject (a `match CALL { … }` result) materializes in the FRAME region and the arm's escaping
 * alias dangles the instant `emit_region_drops` reclaims it — the confirmed `assemble_sel` /
 * `parse_type_body` merged-program UAF (`match asm_lex_and_parse(…) { []Item as items => { one =
 * items } }`, the parser→checker boundary).
 *
 * @param arms      the match's typed arms
 * @param escaping  the enclosing function's `ctx.escaping` set (`checker::fn_escaping_vars`)
 * @return          true iff at least one arm binds a name that escapes
 * @since 0.3.1.0 (native-region-lifetime)
 */
fn match_arm_binds_escaping(arms: []checker::TArm, escaping: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= arms.len { break }
        match arms[i].pattern {
            parser::BindPattern as bp => { if bp.has_binding && contains_str(escaping, bp.binding) { return true } }
            parser::FieldPattern as fp => {
                mut j: u64 = 0
                loop { if j >= fp.fields.len { break }; if contains_str(escaping, fp.fields[j]) { return true }; j++ }
            }
            _ => { }
        }
        i++
    }
    false
}

/**
 * lower_match_subject_conveyed — lower the match subject, wrapping it in a conveyance BRACKET
 * (`emit_region_leaves` … `emit_region_enters`, NP3b) exactly when an arm binds an escaping alias
 * of it (`match_arm_binds_escaping`) and we are not already inside an outer bracket
 * (`ctx.bracket_depth == 0`). The bracket detours the runtime's current region down to the
 * conveyance anchor `rr` for the subject's evaluation ONLY, so a subject that ALLOCATES (a call
 * result, an aggregate construction) materializes at `rr` and survives the frame drop; the re-enter
 * restores the frame/block region so the arm bodies keep bump-allocating their own scratch there.
 * The mirror of `lower_binding_conveyed` for the anonymous "binding" a `match … { X as x => … }`
 * arm makes of the subject. A subject with no escaping arm alias, or one already under an outer
 * bracket, is lowered bare (the outer bracket already moved `current` to the same anchor —
 * re-leaving would wrongly re-enter the frame mid-span). Inert (a leave/enter around a
 * non-allocating bare-var subject copies nothing) and leak-safe when over-applied, matching the
 * BLIND discipline `binding_conveys_escape` already uses.
 *
 * @param ctx  the lowering context positioned at the match
 * @param m    the typed match (its `subject` and `arms`)
 * @return     the advanced context + the subject descriptor, its `ctx` back under the frame region
 * @throws     propagated from `lower_match_subject`
 * @since 0.3.1.0 (native-region-lifetime)
 */
fn lower_match_subject_conveyed(ctx: LowerCtx, m: checker::TMatchExpr) -> MatchSubjOut | error {
    if ctx.bracket_depth > 0 || !match_arm_binds_escaping(m.arms, ctx.escaping) {
        return lower_match_subject(ctx, m.subject)
    }
    let left = emit_region_leaves(ctx, m.subject.line, m.subject.col)
    let marked = ctx_with_bracket_depth(left, 1)
    let s = match lower_match_subject(marked, m.subject) { MatchSubjOut as x => x; error as err => return err }
    let entered = emit_region_enters(s.ctx, m.subject.line, m.subject.col)
    MatchSubjOut { ctx = ctx_with_bracket_depth(entered, ctx.bracket_depth); subj = s.subj }
}

/** is_fat_type — is `t` a fat-pointer-VALUED type (`str` or `[]T`)? Selects the
    ptr+len lowering path (`lower_fat_expr`/`lenv_bind_fat`) over the plain scalar one
    (A1-4, #382). */
fn is_fat_type(t: checker::Type) -> bool {
    match t {
        checker::Str => true
        checker::Slice => true
        _ => false
    }
}

// LoweredFat — the result of lowering a fat-pointer-VALUED expression: the updated context
// + its ptr VReg + its len VReg (A1-4, #382 — the plan's two-VReg `FatVReg` threading).

/**
 * lower_call_fat — lower a DIRECT call's fat (`str`/`[]T`) RESULT to its (ptr, len) pair: the
 * caller allocates an 8-byte out-slot for the length half (`ret_len_out_slot`'s own mirror on the
 * CALL side), passes its address as ONE EXTRA argument appended AFTER the call's own
 * ABI-flattened args, then reads the length back out of that slot once the call returns — its
 * ptr half arrives in the call's ordinary single result VReg, unchanged. This is the caller-side
 * half of the SAME hidden-out-parameter contract `lower_function`'s `bind_ret_len_slot` reserves
 * on the callee side: both sides agree because both are lowered by this SAME backend (mirrors
 * `bind_fat_param`'s "a caller and callee compiled by this backend never disagree" doc) — no true
 * platform-ABI register pair (SysV's RAX:RDX) is needed, since a fat-returning Teko function is
 * never called from outside this backend's own output.
 *
 * A closure-call or interface-dispatch receiver honest-stops by name (their own vtable/thunk
 * calling convention does not yet reserve this hidden slot on the callee side) — this degrau
 * closes only the PLAIN direct-call producer, the shape the corpus probe measured actually
 * reaching this site (#382 N2, call-gordo degrau).
 *
 * The `teko::list::*`/`teko::mem::push_fo` GROWTH-BUILTIN family, the `teko::str::concat`/
 * `teko::string::concat` STRING-BUILDING builtin and the `teko::mem::append_fo` BULK BYTE-APPEND are
 * intercepted BEFORE the hidden-out-slot convention is applied (`lower_list_builtin`,
 * `lower_concat_call`, `lower_append_fo_call`): those calls target the runtime's OWN fixed C ABI
 * (`tk_slice_push`, `tk_str_concat`, `tk_append_bytes_fo`), which owes this backend no hidden
 * length register — their length travels back through an explicit `uint64_t *out_len` argument
 * instead (list-builtin degrau; concat: 0.3.1.0 degrau 9; append_fo: 0.3.1.0 degrau 26).
 *
 * @param ctx  the lowering context
 * @param e    the fat-typed call expression (its type is `str`/`[]T`)
 * @param cl   the call node
 * @return     the (ptr, len) pair
 * @throws     when the call is a closure/interface-dispatch call (a NAMED, narrower honest stop
 *             than `lower_fat_expr`'s generic one), or propagated from resolving/lowering
 */
fn lower_call_fat(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    if cl.is_closure_call { return lower_closure_call_fat(ctx, e, cl) }
    if cl.is_iface_dispatch { return error { message = "native backend N1: fat-pointer interface-dispatch result not yet lowered (N2)" } }
    if cl.call_ns.len == 0 && is_list_builtin_call(cl.callee) { return lower_list_builtin(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_concat_builtin_call(cl.callee) { return lower_concat_call(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_append_fo_call(cl.callee) { return lower_append_fo_call(ctx, e, cl) }
    if cl.call_ns.len == 0 && is_bytes_from_ptr_call(cl.callee) { return lower_bytes_from_ptr_call(ctx, cl) }
    let sym = match call_symbol(cl, ctx.externs, ctx.flat_symbols) { str as s => s; error as err => return err }
    let effective = match fat_extern_len_twin(sym) { str as t => t; null => sym }
    let lo = match lower_args(ctx, cl.args, callee_param_types(cl)) { LoweredArgs as x => x; error as err => return err }
    lower_len_out_call(lo.ctx, effective, lo.vregs, e)
}

/**
 * fat_extern_len_twin — the out-parameter-length twin symbol for a host primitive that returns a
 * plain fat `tk_str` BY VALUE, reached through an `extern fn` declaration (`find_extern_symbol`
 * resolves the RAW C symbol, e.g. `tk_rt_version`). `lower_len_out_call` reserves a length out-slot
 * and appends its address as the call's last argument, then reads the length back — the exact
 * convention the `_len` twins honour (they write `*out_len` and return the pointer), but a
 * by-value-returning primitive IGNORES that extra argument and never writes the slot, so the
 * length comes back as garbage and a downstream `str::concat` allocates a wild size and OOMs
 * (measured: gen2's `str::concat("teko ", version())` startup banner, 0.3.1.0 degrau 35).
 *
 * Keyed on the BY-VALUE symbol name, so the BUILTIN resolution path is untouched: it already hands
 * back the `_len` spelling (`builtin_host_info_symbol` → `tk_rt_version_len`), which is not a key
 * here and passes through unchanged. Only the extern path, which resolves the by-value name, is
 * remapped. The three host-info strings already ship their twins (`tk_rt_{os,arch,version}_len`);
 * degrau 35 adds the remaining self-host-reached ones (`tk_rt_read_line_len`/`tk_rt_read_stdin_len`/
 * `tk_assert_scenario_prefix_len`/`tk_test_scope_len`, `teko_rt.{c,h}`).
 *
 * @param str sym  the resolved C symbol (`call_symbol`'s result)
 * @return str | null  the `_len` twin to call instead, or `null` when `sym` needs no remap
 * @since 0.3.1.0 degrau 35
 */
fn fat_extern_len_twin(sym: str) -> str | null {
    if sym == "tk_rt_version" { return "tk_rt_version_len" }
    if sym == "tk_rt_os" { return "tk_rt_os_len" }
    if sym == "tk_rt_arch" { return "tk_rt_arch_len" }
    if sym == "tk_rt_read_line" { return "tk_rt_read_line_len" }
    if sym == "tk_rt_read_stdin" { return "tk_rt_read_stdin_len" }
    if sym == "tk_assert_scenario_prefix" { return "tk_assert_scenario_prefix_len" }
    if sym == "tk_test_scope" { return "tk_test_scope_len" }
    null
}
