    teko::assert::str_contains(text, "call @teko_teko__demo__take(%0, %1)")
}

fn lwt_if_value_typed(cond: checker::TExpr, then_blk: []@TStatement(), else_blk: []@TStatement(), ty: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = true; else_blk = else_blk }; type = ty; line = 0; col = 0 }
}

#test
fn lwt_lowers_str_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    var cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))])
    var then_blk = [lwt_exprstmt(lwt_strlit("a"))]
    var else_blk = [lwt_exprstmt(lwt_strlit("bb"))]
    var if_str = lwt_if_value_typed(cond, then_blk, else_blk, checker::Str { })
    var s_bind = lwt_bind_typed("s", if_str, checker::Str { })
    var len_access = lwt_len_field(lwt_typed_var("s", checker::Str { }))
    var body = [s_bind, lwt_ret(len_access)]
    var f = lwt_fn("str_if_value", "teko::demo", [], lwt_prim(checker::PrimKind::U64), body)
    var lfo = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "rodata .Lstr0: [97]")
    teko::assert::str_contains(text, "rodata .Lstr1: [98, 98]")
    teko::assert::str_contains(text, "  #B1:\n    %5 = global_addr @.Lstr0\n    %6 = const 1\n    jump #B3(%5, %6)")
    teko::assert::str_contains(text, "  #B2:\n    %7 = global_addr @.Lstr1\n    %8 = const 2\n    jump #B3(%7, %8)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

#test
fn lwt_lowers_slice_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    var cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))])
    var one_elem = [lwt_num_i64(10)]
    var two_elems = [lwt_num_i64(20), lwt_num_i64(30)]
    var then_blk = [lwt_exprstmt(lwt_array_lit(one_elem, checker::PrimKind::I64))]
    var else_blk = [lwt_exprstmt(lwt_array_lit(two_elems, checker::PrimKind::I64))]
    var slice_ty = checker::Slice { element = lwt_prim(checker::PrimKind::I64) }
    var if_slice = lwt_if_value_typed(cond, then_blk, else_blk, slice_ty)
    var xs_bind = lwt_bind_typed("xs", if_slice, slice_ty)
    var len_access = lwt_len_field(lwt_typed_var("xs", slice_ty))
    var body = [xs_bind, lwt_ret(len_access)]
    var f = lwt_fn("slice_if_value", "teko::demo", [], lwt_prim(checker::PrimKind::U64), body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    %5 = alloca 8, align 8\n    %6 = const 10\n    %7 = field_addr %5, 0\n    store.i64 %7, %6\n    %8 = const 8\n    %9 = call @tk_slice_elem_box(%5, %8)\n    %10 = const 1\n    jump #B3(%9, %10)")
    teko::assert::str_contains(text, "%11 = alloca 16, align 8")
    teko::assert::str_contains(text, "%18 = const 2\n    jump #B3(%17, %18)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

#test
fn lwt_honest_stop_on_fat_if_without_else_as_a_value() {
    var cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::Lt, lwt_num_i64(2))])
    var then_blk = [lwt_exprstmt(lwt_strlit("a"))]
    var ifexpr = checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = then_blk }; type = checker::Str { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(lwt_len_field(ifexpr)), "if-without-else used as a fat value not yet lowered")
}

#test
fn lwt_lowers_str_returning_function_stores_length_through_hidden_out_slot() {
    var body = [lwt_ret(lwt_strlit("hi"))]
    var f = lwt_fn("make_str", "teko::demo", [], checker::Str { }, body)
    var lfo = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "func @teko_teko__demo__make_str(%0: ptr): ptr {")
    teko::assert::str_contains(text, "%0 = param 0")
    teko::assert::str_contains(text, "%1 = global_addr @.Lstr0")
    teko::assert::str_contains(text, "%2 = const 2")
    teko::assert::str_contains(text, "store.i64 %0, %2")
    teko::assert::str_contains(text, "ret %1")
}

#test
fn lwt_lowers_str_call_result_allocates_out_slot_and_loads_the_length_back() {
    var call = lwt_call(lwt_path1("make_str"), "teko::demo", [], checker::Str { })
    var text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "%0 = alloca 8, align 8")
    teko::assert::str_contains(text, "%1 = call @teko_teko__demo__make_str(%0)")
    teko::assert::str_contains(text, "%2 = load.i64 %0")
}

#test
fn lwt_lowers_fat_closure_call_result_with_hidden_out_slot() {
    var fty = lwt_func_type([], checker::Str { })
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lwt_fn_value("make_str", "teko::demo", fty), fty)))
    var call = lwt_closure_call("f", [], fty, checker::Str { })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_len_field(call))))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "func @.Lclofn0(%0: ptr, %1: ptr): ptr {")
    teko::assert::str_contains(text, "call @teko_teko__demo__make_str(%1)")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "call.indirect")
    teko::assert::str_contains(text, "load.i64")
}

#test
fn lwt_honest_stop_on_fat_iface_dispatch_result() {
    var recv = lwt_num_i64(1)
    var call = lwt_iface_call("Speaker", "speak", 0, [recv], checker::Str { })
    teko::assert::str_contains(lwt_lower_expr_text(call), "fat-pointer interface-dispatch result not yet lowered")
}

fn lwt_slice_of(k: checker::PrimKind): @Type() { checker::Slice { element = lwt_prim(k) } }

fn lwt_list_empty_call(k: checker::PrimKind): checker::TExpr {
    lwt_call(lwt_path2("list", "empty"), "", [], lwt_slice_of(k))
}

fn lwt_push_call(ns: str, name: str, recv: checker::TExpr, item: checker::TExpr, k: checker::PrimKind): checker::TExpr {
    var args = [recv, item]
    lwt_call(lwt_path2(ns, name), "", args, lwt_slice_of(k))
}

#test
fn lwt_lowers_list_push_to_the_runtime_grow() {
    var recv = lwt_list_empty_call(checker::PrimKind::I64)
    var call = lwt_push_call("list", "push", recv, lwt_num_i64(7), checker::PrimKind::I64)
    var text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "call @tk_slice_push(")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "store.i64")
    teko::assert::str_contains(text, "load.i64")
}

#test
fn lwt_lowers_push_fo_to_the_free_old_grow() {
