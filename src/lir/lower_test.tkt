}

#test
fn lwt_lowers_list_push_element_size_from_the_element_class() {
    var recv = lwt_list_empty_call(checker::PrimKind::U32)
    var call = lwt_push_call("list", "push", recv, lwt_num(7, checker::PrimKind::U32), checker::PrimKind::U32)
