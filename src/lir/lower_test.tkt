    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "const 4")
}

#test
fn lwt_lowers_list_empty_to_a_null_pair() {
    var text = lwt_lower_expr_text(lwt_len_field(lwt_list_empty_call(checker::PrimKind::I64)))
    teko::assert::str_contains(text, "const 0")
    teko::assert::is_true(!teko::str::contains(text, "call @"))
}

fn lwt_aggregate_push_call(tname: str): checker::TExpr {
    var p_slice = checker::Slice { element = checker::Named { name = tname } }
    var recv = lwt_call(lwt_path2("list", "empty"), "", [], p_slice)
    var names = ["x", "y"]
    var vals = [lwt_num_i64(1), lwt_num_i64(2)]
    var args = [recv, lwt_struct_init(tname, names, vals)]
    lwt_len_field(lwt_call(lwt_path2("list", "push"), "", args, p_slice))
}

#test
fn lwt_boxes_an_aggregate_element_push() {
    var text = lwt_lower_expr_text_with(lwt_aggregate_push_call("Point"), lwt_one_layout(lwt_point_layout()))
    teko::assert::str_contains(text, "const 16")
    teko::assert::str_contains(text, "call @tk_slice_elem_box(")
    teko::assert::str_contains(text, "call @tk_slice_push(")
    teko::assert::str_contains(text, "const 8")
}

#test
fn lwt_honest_stop_on_unsized_aggregate_element_push() {
    var text = lwt_lower_expr_text(lwt_aggregate_push_call("P"))
    teko::assert::str_contains(text, "no registered layout")
    teko::assert::str_contains(text, "boxes each pushed item into fresh storage")
}

#test
fn lwt_lowers_fat_element_push_at_the_two_word_stride() {
    var str_slice = checker::Slice { element = checker::Str { } }
    var recv = lwt_call(lwt_path2("list", "empty"), "", [], str_slice)
    var args = [recv, lwt_strlit("hi")]
    var call = lwt_call(lwt_path2("list", "push"), "", args, str_slice)
