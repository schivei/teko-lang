fn lwt_in_expr(lhs: checker::TExpr, elems: []checker::TExpr): checker::TExpr {
    checker::TExpr { kind = checker::TInExpr { lhs = lhs; elems = elems }; type = lwt_prim(checker::PrimKind::Bool); line = 0; col = 0 }
}

#test
fn lwt_lowers_in_expr_as_an_eq_chain_ored_together() {
    var elems = [lwt_num_i64(1), lwt_num_i64(2)]
    var text = lwt_lower_expr_text(lwt_in_expr(lwt_num_i64(1), elems))
    teko::assert::str_contains(text, "icmpeq")
    teko::assert::str_contains(text, "ior")
}

fn lwt_iface_call(iface: str, method: str, slot: u32, args: []checker::TExpr, ret: @Type()): checker::TExpr {
    checker::TExpr {
        kind = checker::TCall { overload_suffix = "";
            callee = lwt_path2(iface, method); args = args; call_ns = ""
            is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = true; iface_slot = slot; type_args = []; ret_extra = [] }
        type = ret; line = 0; col = 0
    }
}

#test
fn lwt_lowers_iface_dispatch_call_via_vtable_load_and_indirect_call() {
    var recv = lwt_num_i64(1000)
    var extra = lwt_num_i64(7)
    var args = [recv, extra]
    var call = lwt_iface_call("Speaker", "speak", 2, args, lwt_prim(checker::PrimKind::I64))
    var text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "%0 = const 1000")
    teko::assert::str_contains(text, "%1 = field_addr %0, 0")
    teko::assert::str_contains(text, "%2 = load.ptr %1")
    teko::assert::str_contains(text, "%3 = field_addr %0, 8")
    teko::assert::str_contains(text, "%4 = load.ptr %3")
    teko::assert::str_contains(text, "%5 = field_addr %4, 16")
    teko::assert::str_contains(text, "%6 = load.ptr %5")
    teko::assert::str_contains(text, "%7 = const 7")
    teko::assert::str_contains(text, "%8 = call.indirect %6(%2, %7)")
}

#test
fn lwt_lowers_void_iface_dispatch_call_as_a_valueless_indirect_call() {
    var recv = lwt_num_i64(2000)
    var args = [recv]
    var call = lwt_iface_call("Speaker", "speak", 0, args, checker::Void { })
    var text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "call.indirect %6(%2)")
    teko::assert::is_true(!teko::str::contains(text, "= call.indirect"))
}

fn lwt_func_type(params: []@Type(), ret: @Type()): @Type() {
    checker::Func { params = params; ret = ret; variadic = false; param_names = []; n_required = params.len; defaults = []; ret_extra = [] }
}

fn lwt_bind_typed(name: str, e: checker::TExpr, ty: @Type()): @TStatement() {
    checker::TBinding { kind = parser::BindKind::Var; target = parser::SimpleName { name = name }; bound = ty; value = e }
}

fn lwt_fn_value(name: str, ns: str, ty: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = true; func_ns = ns }; type = ty; line = 0; col = 0 }
}

fn lwt_closure_call(name: str, args: []checker::TExpr, callee_ty: @Type(), ret: @Type()): checker::TExpr {
    checker::TExpr {
        kind = checker::TCall { overload_suffix = "";
            callee = lwt_path1(name); args = args; call_ns = ""
            is_closure_call = true; callee_type = callee_ty; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }
        type = ret; line = 0; col = 0
    }
}

#test
fn lwt_lowers_fn_value_and_closure_call_via_a_thunk() {
    var fty = lwt_func_type([lwt_prim(checker::PrimKind::I64), lwt_prim(checker::PrimKind::I64)], lwt_prim(checker::PrimKind::I64))
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lwt_fn_value("add", "teko::demo", fty), fty)))
    var cargs = [lwt_num_i64(2), lwt_num_i64(3)]
    var call = lwt_closure_call("f", cargs, fty, lwt_prim(checker::PrimKind::I64))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [call], checker::Void { }))))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "funcaddr @.Lclofn0")
    teko::assert::str_contains(text, "func @.Lclofn0(%0: ptr, %1: i64, %2: i64): i64 {")
    teko::assert::str_contains(text, "call @teko_teko__demo__add(%1, %2)")
    teko::assert::str_contains(text, "call.indirect")
}

fn lwt_lambda_param(name: str, ty: @Type()): checker::TLambdaParam {
    checker::TLambdaParam { name = name; type = ty }
}

fn lwt_capture(name: str, ty: @Type()): checker::TCapture {
    checker::TCapture { name = name; type = ty; by_ref = false }
}

fn lwt_lambda_types(params: []checker::TLambdaParam): []@Type() {
    var out: []@Type() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        out = teko::list::push(out, params[i].type)
        i++
    }
    out
}

fn lwt_lambda(params: []checker::TLambdaParam, body: []@TStatement(), captures: []checker::TCapture, ret: @Type()): checker::TExpr {
    checker::TExpr {
        kind = checker::TLambda { params = params; body = body; captures = captures; ret = ret; lift_id = 0 }
        type = lwt_func_type(lwt_lambda_types(params), ret); line = 0; col = 0
    }
}

#test
fn lwt_lowers_capturing_lambda_literal_and_closure_call() {
    var i64ty = lwt_prim(checker::PrimKind::I64)
    var lam_body = [lwt_ret(lwt_bin(lexer::TokenKind::Plus, lwt_var("x", checker::PrimKind::I64), lwt_var("captured", checker::PrimKind::I64), checker::PrimKind::I64))]
    var params = [lwt_lambda_param("x", i64ty)]
    var captures = [lwt_capture("captured", i64ty)]
    var lam = lwt_lambda(params, lam_body, captures, i64ty)
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind("captured", lwt_num_i64(41), checker::PrimKind::I64)))
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lam, lam.type)))
    var call = lwt_closure_call("f", [lwt_num_i64(1)], lam.type, i64ty)
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [call], checker::Void { }))))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "funcaddr @.Lclo0")
    teko::assert::str_contains(text, "func @.Lclo0(%0: ptr, %1: i64): i64 {")
    teko::assert::str_contains(text, "field_addr %0, 0")
    teko::assert::str_contains(text, "iadd %1,")
    teko::assert::str_contains(text, "call.indirect")
}

#test
fn lwt_lowers_defer_fires_before_a_void_lambdas_fall_through_return() {
    var s_plus_100 = lwt_bin(lexer::TokenKind::Plus, lwt_var("s", checker::PrimKind::I64), lwt_num_i64(100), checker::PrimKind::I64)
    var defer_body = [lwt_simple_assign("s", lexer::TokenKind::Assign, s_plus_100, checker::PrimKind::I64)]
    var lam_body = [lwt_bind("s", lwt_num_i64(1), checker::PrimKind::I64), lwt_defer(defer_body)]
    var lam = lwt_lambda([], lam_body, [], checker::Void { })
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lam, lam.type)))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "const 100")
    teko::assert::str_contains(text, "iadd")
}

#test
fn lwt_lowers_continue_jumps_back_to_the_loop_head() {
    var body = [lwt_loop("", [lwt_continue("")])]
    var f = lwt_fn("k", "teko::demo", [], checker::Void { }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    jump #B1()")
}

#test
fn lwt_defer_inside_else_arm_fires_only_on_that_arms_own_branch() {
    var s_plus_100 = lwt_bin(lexer::TokenKind::Plus, lwt_var("s", checker::PrimKind::I64), lwt_num_i64(100), checker::PrimKind::I64)
    var defer_body = [lwt_simple_assign("s", lexer::TokenKind::Assign, s_plus_100, checker::PrimKind::I64)]
    var cond = lwt_cmp(lwt_var("x", checker::PrimKind::I64), [lwt_cmp_term(lexer::TokenKind::Gt, lwt_num_i64(0))])
    var else_blk = [lwt_defer(defer_body)]
    var ifstmt = lwt_if_stmt(cond, [], true, else_blk)
    var tail_ret = lwt_ret(lwt_var("s", checker::PrimKind::I64))
    var body = [lwt_bind("s", lwt_num_i64(1), checker::PrimKind::I64), lwt_exprstmt(ifstmt), tail_ret]
    var params = [lwt_param("x", "i64")]
    var f = lwt_fn("else_arm_scoped", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    jump #B3(%1)")
    teko::assert::str_contains(text, "  #B2:\n    %5 = const 100\n    %6 = iadd %1, %5\n    jump #B3(%6)")
    teko::assert::str_contains(text, "  #B3(%4):\n    ret %4\n}")
}

#test
fn lwt_lowers_loop_leaves_a_fat_local_unpromoted() {
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("s", lwt_strlit("hi"), checker::Str { })))
    items = teko::list::push(items, lwt_item(lwt_loop("", [lwt_break("")])))
    var len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::I64))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [len_access], checker::Void { }))))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "%1 = const 2")
    teko::assert::str_contains(text, "    jump #B1()\n  #B1:\n    jump #B2()\n  #B2:\n    call @tk_exit(%1)")
}

#test
fn lwt_fat_local_reassign_honest_stops_on_later_fat_use() {
    var s_bind = lwt_bind_typed("s", lwt_strlit("hello"), checker::Str { })
    var reassign = lwt_simple_assign("s", lexer::TokenKind::Assign, lwt_strlit("hi"), checker::PrimKind::I64)
    var len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::U64))
    var body = [s_bind, reassign, lwt_ret(len_access)]
    var f = lwt_fn("fat_reassign_then_len", "teko::demo", [], lwt_prim(checker::PrimKind::U64), body)
    var out = match lower_function(f, checker::tt_empty()) { LoweredFunction => "ok"; error as e => e.message }
    teko::assert::str_contains(out, "`s` is not a fat-pointer local")
}

fn lwt_slice_param(name: str, elem_tname: str): parser::Param {
    parser::Param { name = name; has_type = true; type_ann = parser::SliceType { element = lwt_named_te(elem_tname) }; is_params = false; has_default = false; default_expr = parser::no_expr() }
}

#test
fn lwt_lowers_str_param_len_reads_the_fat_length_with_no_memory_traffic() {
    var params = [lwt_param("s", "str")]
    var len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::U64))
    var body = [lwt_ret(len_access)]
    var f = lwt_fn("str_param_len", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "(%0: ptr, %1: i64): i64")
    teko::assert::str_contains(text, "%0 = param 0")
    teko::assert::str_contains(text, "%1 = param 1")
    teko::assert::str_contains(text, "ret %1")
    teko::assert::is_true(!teko::str::contains(text, "load."))
}

#test
fn lwt_lowers_slice_param_len_reads_the_fat_length_with_no_memory_traffic() {
    var params = [lwt_slice_param("xs", "i64")]
    var len_access = lwt_field_access(lwt_typed_var("xs", checker::Slice { element = lwt_prim(checker::PrimKind::I64) }), "len", lwt_prim(checker::PrimKind::U64))
    var body = [lwt_ret(len_access)]
