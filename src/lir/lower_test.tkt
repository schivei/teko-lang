    var f = lwt_fn("stray_break", "teko::demo", [], checker::Void { }, body)
    var out = match lower_function(f, checker::tt_empty()) { LoweredFunction => "ok"; error as e => e.message }
    teko::assert::str_contains(out, "break/continue outside a loop")
}

