    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "(%0: ptr, %1: i64): i64")
    teko::assert::str_contains(text, "ret %1")
    teko::assert::is_true(!teko::str::contains(text, "load."))
}

#test
fn lwt_calling_a_str_param_forwards_both_ptr_and_len() {
    var params = [lwt_param("s", "str")]
    var forward = lwt_call(lwt_path1("take"), "teko::demo", [lwt_typed_var("s", checker::Str { })], lwt_prim(checker::PrimKind::U64))
    var body = [lwt_ret(forward)]
    var f = lwt_fn("forward_str_param", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
