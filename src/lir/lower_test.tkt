}

fn lwt_count_substr(text: str, needle: str): u64 {
    var remaining = text
    var count: u64 = 0
    loop {
        match teko::str::last_index_of(remaining, needle) {
            u64 as pos => { count = count + 1; remaining = teko::str::slice_to(remaining, pos) }
            error => break
        }
    }
    count
}

fn lwt_region_ctx(bracket_depth: u32, region_vreg: u32): LowerCtx {
    LowerCtx {
        func = new_func("t", 0, [], LType::I64); block_id = 0; env = empty_lenv()
        layouts = []; rodata = []; enums = []; lifted = []
        variants = []
        defers = []; loop_targets = []; externs = []
        flat_symbols = false; ret_type = checker::Prim { kind = checker::PrimKind::I64 }
        has_ret_len_slot = false; ret_len_slot = 0
        ref_fns = []; field_decls = []; addr_taken = []; table = checker::tt_empty()
        region_stack = [NativeRegionFrame { region_vreg = region_vreg; decl_name = ""; is_loop = false }]
        escaping = []; frees_old_names = []; bracket_depth = bracket_depth
    }
}

#test
fn lwt_fn_body_plain_auto_return_tail_conveys_nested_pointer_field_before_the_frame_drops() {
    var items_field = lwt_slice_field("items", "i32")
    var foo_decl = lwt_struct_decl("Foo", [items_field])
    var elems = [lwt_num(1, checker::PrimKind::I32), lwt_num(2, checker::PrimKind::I32), lwt_num(3, checker::PrimKind::I32)]
    var array_lit = lwt_array_lit(elems, checker::PrimKind::I32)
    var field_names = ["items"]
    var field_vals = [array_lit]
    var si = lwt_struct_init("Foo", field_names, field_vals)
    var body = [lwt_exprstmt(si)]
    var make_fn = lwt_fn_item("make", "teko::demo", [], checker::Named { name = "Foo" }, body)
    var items = [foo_decl, make_fn]
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::is_true(lwt_count_substr(text, "call @tk_slice_elem_box(") == (2 to u64))
    teko::assert::is_true(lwt_count_substr(text, "call @tk_region_leave()") == (2 to u64))
    var last_box_pos = match teko::str::last_index_of(text, "call @tk_slice_elem_box(") { u64 as p => p; error => { teko::assert::is_true(false); return } }
    var before_last_box = teko::str::slice_to(text, last_box_pos)
    var array_box_pos = match teko::str::last_index_of(before_last_box, "call @tk_slice_elem_box(") { u64 as p => p; error => { teko::assert::is_true(false); return } }
    var before_array_box = teko::str::slice_to(text, array_box_pos)
    teko::assert::is_true(teko::str::contains(before_array_box, "call @tk_region_leave()"))
    var drop_pos = match teko::str::last_index_of(text, "call @tk_region_drop_u(") { u64 as p => p; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(drop_pos > last_box_pos)
}

#test
fn lwt_lower_block_value_if_arm_tail_stays_unbracketed() {
    var ctx0 = lwt_region_ctx(0, 7)
    var body = [lwt_exprstmt(lwt_num_i64(42))]
    var out = match lower_block_value(ctx0, body, LType::I64, checker::Prim { kind = checker::PrimKind::I64 }) { LowerBlockValue as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(add_func(empty_module(), out.ctx.func))
    teko::assert::is_false(teko::str::contains(text, "tk_region_leave"))
    teko::assert::is_false(teko::str::contains(text, "tk_region_enter_u"))
}

#test
fn lwt_lower_conveyed_tail_expr_stmt_brackets_and_restores_bracket_depth() {
    var ctx0 = lwt_region_ctx(0, 7)
    var es = checker::TExprStmt { expr = lwt_num_i64(42) }
    var out = match lower_conveyed_tail_expr_stmt(ctx0, es, LType::I64, checker::Prim { kind = checker::PrimKind::I64 }, 0, 0) { LowerBlockValue as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(out.ctx.bracket_depth == (0 to u32))
    var text = print_lmodule(add_func(empty_module(), out.ctx.func))
    teko::assert::is_true(lwt_count_substr(text, "call @tk_region_leave()") == (1 to u64))
    teko::assert::is_true(lwt_count_substr(text, "call @tk_region_enter_u(") == (1 to u64))
}

#test
fn lwt_lower_conveyed_tail_expr_stmt_skips_bracket_when_already_nested() {
    var ctx0 = lwt_region_ctx(1, 7)
    var es = checker::TExprStmt { expr = lwt_num_i64(42) }
    var out = match lower_conveyed_tail_expr_stmt(ctx0, es, LType::I64, checker::Prim { kind = checker::PrimKind::I64 }, 0, 0) { LowerBlockValue as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(out.ctx.bracket_depth == (1 to u32))
    var text = print_lmodule(add_func(empty_module(), out.ctx.func))
    teko::assert::is_false(teko::str::contains(text, "tk_region_leave"))
    teko::assert::is_false(teko::str::contains(text, "tk_region_enter_u"))
}
