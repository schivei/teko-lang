fn lwt_field(name: str, tname: str): parser::Field {
    parser::Field { name = name; type_ann = lwt_named_te(tname); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
}

fn lwt_struct_decl(name: str, fields: []parser::Field): @TItem() {
    parser::TypeDecl {
        name = name; type_params = []; type_constraints = []
        body = parser::StructBody { fields = fields; methods = []; implements = []; consts = []; is_readonly = false }
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        line = 0; col = 0
   ; is_global = false }
}

fn lwt_two_fields(a: parser::Field, b: parser::Field): []parser::Field {
    [a, b]
}

fn lwt_three_fields(a: parser::Field, b: parser::Field, c: parser::Field): []parser::Field {
    teko::list::push(lwt_two_fields(a, b), c)
}

fn lwt_nested_struct_layout_program(): checker::TProgram {
    var point = lwt_struct_decl("Point", lwt_two_fields(lwt_field("x", "i64"), lwt_field("y", "i64")))
    var line = lwt_struct_decl("Line", lwt_three_fields(lwt_field("a", "byte"), lwt_field("p", "Point"), lwt_field("c", "byte")))
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, point)
    items = teko::list::push(items, line)
    checker::TProgram { items = items }
}

#test
fn nested_struct_by_value_field_layout_accounts_for_the_inner_structs_real_width() {
    var m = match lower_program(lwt_nested_struct_layout_program()) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Point: size=16 align=8 {x@0, y@8}")
    teko::assert::str_contains(text, "layout Line: size=32 align=8 {a@0, p@8, c@24}")
}

fn lwt_enum_decl(name: str, members: []str): @TItem() {
    parser::TypeDecl {
        name = name; type_params = []; type_constraints = []
        body = parser::EnumBody { members = members; methods = [] }
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        line = 0; col = 0
   ; is_global = false }
}

fn lwt_two_members(a: str, b: str): []str {
    [a, b]
}

fn lwt_five_members(a: str, b: str, c: str, d: str, e: str): []str {
    teko::list::push(teko::list::push(teko::list::push(lwt_two_members(a, b), c), d), e)
}

fn lwt_enum_carrier_layout_program(): checker::TProgram {
    var cls = lwt_enum_decl("Cls", lwt_two_members("GPR", "FPR"))
    var wide = lwt_enum_decl("Wide", lwt_five_members("A", "B", "C", "D", "E"))
    var reg = lwt_struct_decl("Reg", lwt_three_fields(lwt_field("id", "u32"), lwt_field("cls", "Cls"), lwt_field("phys", "byte")))
    var both = lwt_struct_decl("Both", lwt_two_fields(lwt_field("w", "Wide"), lwt_field("big", "i64")))
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, cls)
    items = teko::list::push(items, wide)
    items = teko::list::push(items, reg)
    items = teko::list::push(items, both)
    checker::TProgram { items = items }
}

#test
fn an_enum_typed_field_occupies_its_four_byte_integer_carrier_not_a_pointer() {
    var m = match lower_program(lwt_enum_carrier_layout_program()) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Reg: size=12 align=4 {id@0, cls@4, phys@8}")
    teko::assert::str_contains(text, "layout Both: size=16 align=8 {w@0, big@8}")
}

fn lwt_class_decl(name: str, kind: parser::ClassKind, has_base: bool, base_name: str, fields: []parser::Field): @TItem() {
    parser::TypeDecl {
        name = name; type_params = []; type_constraints = []
        body = parser::ClassBody {
            kind = kind; has_base = has_base; base_name = base_name
            has_base_binding = false; base_binding_name = ""; implements = []
            fields = fields; methods = []; consts = []
            is_service = false; service_lifetime = parser::ServiceLifetime::Singleton
        }
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        line = 0; col = 0
   ; is_global = false }
}

fn lwt_class_layout_program(): checker::TProgram {
    var pair = lwt_struct_decl("Pair", lwt_two_fields(lwt_field("small", "i32"), lwt_field("big", "i64")))
    var root = lwt_class_decl("Root", parser::ClassKind::Virtual, false, "", lwt_two_fields(lwt_field("tag", "i32"), lwt_field("weight", "i64")))
    var leaf = lwt_class_decl("Leaf", parser::ClassKind::Sealed, true, "Root", lwt_two_fields(lwt_field("flag", "byte"), lwt_field("extra", "i64")))
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, pair)
    items = teko::list::push(items, root)
    items = teko::list::push(items, leaf)
    checker::TProgram { items = items }
}

#test
fn a_class_registers_the_layout_of_its_effective_instance_fields() {
    var m = match lower_program(lwt_class_layout_program()) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Pair: size=16 align=8 {small@0, big@8}")
    teko::assert::str_contains(text, "layout Root: size=16 align=8 {tag@0, weight@8}")
    teko::assert::str_contains(text, "layout Leaf: size=32 align=8 {tag@0, weight@8, flag@16, extra@24}")
}

#test
fn lwt_virtual_main_returns_the_trailing_top_level_expressions_value() {
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind("x", lwt_num_i64(40), checker::PrimKind::I64)))
    var tail = lwt_bin(lexer::TokenKind::Plus, lwt_var("x", checker::PrimKind::I64), lwt_num_i64(2), checker::PrimKind::I64)
    items = teko::list::push(items, lwt_item(lwt_exprstmt(tail)))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "iadd ")
    teko::assert::str_contains(text, "ret %2")
    teko::assert::is_true(!teko::str::contains(text, "const 0"))
}

fn lwt_path(names: []str): parser::Path {
    var segs: []parser::Segment = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        segs = teko::list::push(segs, parser::Segment { name = names[i] })
        i++
    }
    parser::Path { segments = segs }
}

fn lwt_bare_call(names: []str, ns: str): checker::TCall {
    checker::TCall { overload_suffix = "";
        callee = lwt_path(names); args = []; call_ns = ns
        is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }
}

fn lwt_externs(ns: str, name: str, symbol: str): []LExternFn {
    [LExternFn { namespace = ns; name = name; c_symbol = symbol }]
}

#test
fn lwt_call_symbol_keys_on_the_origin_namespace() {
    var user = lwt_bare_call(["arena_push"], "probe::mine")
    var builtin = lwt_bare_call(["arena_push"], "")
    var no_ext: []LExternFn = []
    teko::assert::is_true(match call_symbol(user, no_ext) { str as s => s == "teko_probe__mine__arena_push"; error => false })
    teko::assert::is_true(match call_symbol(builtin, no_ext) { str as s => s == "tk_arena_push"; error => false })
}

#test
fn lwt_call_symbol_leaves_an_extern_verbatim() {
    var ext = lwt_bare_call(["sys", "getpid"], "probe::sys")
    var table = lwt_externs("probe::sys", "getpid", "getpid")
    teko::assert::is_true(match call_symbol(ext, table) { str as s => s == "getpid"; error => false })
}

#test
fn lwt_call_symbol_resolves_the_assert_seed() {
    var names: []str = ["teko"]
    names = teko::list::push(names, "assert")
    names = teko::list::push(names, "is_true")
    var no_ext: []LExternFn = []
    teko::assert::is_true(match call_symbol(lwt_bare_call(names, ""), no_ext) { str as s => s == "teko__assert__is_true"; error => false })
}

#test
fn lwt_call_symbol_resolves_runtime_string_builtins() {
    var no_ext: []LExternFn = []
    teko::assert::is_true(match call_symbol(lwt_bare_call(["str_slice_chars"], ""), no_ext) { str as s => s == "tk_str_slice_chars_len"; error => false })
    teko::assert::is_true(match call_symbol(lwt_bare_call(["bytes_of_str"], ""), no_ext) { str as s => s == "tk_bytes_of_str_len"; error => false })
    teko::assert::is_true(match call_symbol(lwt_bare_call(["one_byte"], ""), no_ext) { str as s => s == "tk_one_byte_len"; error => false })
}

#test
fn lwt_call_symbol_resolves_str_contains_and_ends_with() {
    var contains = lwt_bare_call(["contains"], "")
    var ends_with = lwt_bare_call(["ends_with"], "")
    var no_ext: []LExternFn = []
    teko::assert::is_true(match call_symbol(contains, no_ext) { str as s => s == "tk_str_contains"; error => false })
    teko::assert::is_true(match call_symbol(ends_with, no_ext) { str as s => s == "tk_str_ends_with"; error => false })
}

#test
fn lwt_call_symbol_resolves_str_slice_family() {
    var slice = lwt_bare_call(["slice"], "")
    var slice_to = lwt_bare_call(["slice_to"], "")
    var slice_from = lwt_bare_call(["slice_from"], "")
