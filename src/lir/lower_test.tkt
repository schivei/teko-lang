use teko::checker
use teko::lexer
use teko::parser

fn lwt_prim(k: checker::PrimKind): @Type() { checker::Prim { kind = k } }

fn lwt_num(v: i64, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_num_i64(v: i64): checker::TExpr { lwt_num(v, checker::PrimKind::I64) }

fn lwt_fnum(v: f64): checker::TExpr {
    checker::TExpr { kind = checker::TNumber { is_float = true; value = parser::numint_of_u64(0); fval = v }; type = lwt_prim(checker::PrimKind::F64); line = 0; col = 0 }
}

fn lwt_var(name: str, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = false; func_ns = "" }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_bin(op: lexer::TokenKind, l: checker::TExpr, r: checker::TExpr, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TBinary { op = op; left = l; right = r }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_unary(op: lexer::TokenKind, operand: checker::TExpr, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TUnary { op = op; operand = operand }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_cast(inner: checker::TExpr, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TCast { expr = inner }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_cmp_term(op: lexer::TokenKind, e: checker::TExpr): checker::TCmpTerm { checker::TCmpTerm { op = op; operand = e } }

fn lwt_cmp(first: checker::TExpr, terms: []checker::TCmpTerm): checker::TExpr {
    checker::TExpr { kind = checker::TCompare { first = first; rest = terms }; type = lwt_prim(checker::PrimKind::Bool); line = 0; col = 0 }
}

fn lwt_if_stmt(cond: checker::TExpr, then_blk: []@TStatement(), has_else: bool, else_blk: []@TStatement()): checker::TExpr {
    checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = has_else; else_blk = else_blk }; type = checker::Void { }; line = 0; col = 0 }
}

fn lwt_if_value(cond: checker::TExpr, then_blk: []@TStatement(), else_blk: []@TStatement(), k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = true; else_blk = else_blk }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_seg(s: str): parser::Segment { parser::Segment { name = s } }
fn lwt_path1(s: str): parser::Path { parser::Path { segments = [lwt_seg(s)] } }

fn lwt_path2(a: str, b: str): parser::Path {
    parser::Path { segments = [lwt_seg(a), lwt_seg(b)] }
}

fn lwt_call(path: parser::Path, ns: str, args: []checker::TExpr, ret: @Type()): checker::TExpr {
    checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = path; args = args; call_ns = ns; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = []; ret_extra = [] }
        type = ret; line = 0; col = 0
    }
}

fn lwt_named_te(s: str): @TypeExpr() { parser::NamedType { path = lwt_path1(s); args = [] } }

fn lwt_param(name: str, tname: str): parser::Param {
    parser::Param { name = name; has_type = true; type_ann = lwt_named_te(tname); is_params = false; has_default = false; default_expr = parser::no_expr() }
}

fn lwt_ret(e: checker::TExpr): @TStatement() { checker::TReturn { has_value = true; value = e; values = [] } }
fn lwt_bind(name: str, e: checker::TExpr, k: checker::PrimKind): @TStatement() {
    checker::TBinding { kind = parser::BindKind::Var; target = parser::SimpleName { name = name }; bound = lwt_prim(k); value = e }
}
fn lwt_exprstmt(e: checker::TExpr): @TStatement() { checker::TExprStmt { expr = e } }

fn lwt_loop(label: str, body: []@TStatement()): @TStatement() {
    checker::TLoopStmt { label = label; init = []; body = body }
}

fn lwt_break(label: str): @TStatement() { checker::TBreakStmt { label = label } }

fn lwt_continue(label: str): @TStatement() { checker::TContinueStmt { label = label } }

fn lwt_defer(body: []@TStatement()): @TStatement() { checker::TDeferStmt { body = body } }

fn lwt_simple_assign(name: str, op: lexer::TokenKind, value: checker::TExpr, k: checker::PrimKind): @TStatement() {
    checker::TAssign { kind = parser::AssignKind::Simple; name = name; op = op; bound = lwt_prim(k); value = value; deref = false; target = checker::no_texpr() }
}

fn lwt_fn(name: str, ns: str, params: []parser::Param, ret: @Type(), body: []@TStatement()): checker::TFunction {
    checker::TFunction { overload_suffix = "";
        name = name; type_params = []; type_constraints = []
        namespace = ns; params = params; return_type = ret; body = body
        vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none()
        file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = []; guard = parser::pred_true() }
}

fn lwt_fn_item(name: str, ns: str, params: []parser::Param, ret: @Type(), body: []@TStatement()): @TItem() {
    lwt_fn(name, ns, params, ret, body)
}

fn lwt_lower_expr_text(e: checker::TExpr): str {
    lwt_lower_expr_text_with(e, [])
}

fn lwt_lower_expr_text_with(e: checker::TExpr, layouts: []LStructLayout): str {
    var f0 = new_func("t", 0, [], LType::I64)
    var ctx0 = LowerCtx {
        func = f0; block_id = 0; env = empty_lenv()
        layouts = layouts; rodata = []; enums = []; lifted = []
        variants = []
        defers = []; loop_targets = []; externs = []
        flat_symbols = false; ret_type = checker::Prim { kind = checker::PrimKind::I64 }
        has_ret_len_slot = false; ret_len_slot = 0
        ref_fns = []; field_decls = []; addr_taken = []; table = checker::tt_empty()
        region_stack = []; escaping = []; frees_old_names = []; bracket_depth = 0
    }
    var lo = match lower_expr(ctx0, e) { Lowered as x => x; error as err => return teko::str::concat("ERR: ", err.message) }
    var m0 = with_rodata(add_func(empty_module(), lo.ctx.func), lo.ctx.rodata)
    print_lmodule(lwt_fold_lifted(m0, lo.ctx.lifted))
}

fn lwt_fold_lifted(m: LModule, lifted: []LFunc): LModule {
    var cur = m
    var i: u64 = 0
    loop {
        if i >= lifted.len { break }
        cur = add_func(cur, lifted[i])
        i++
    }
    cur
}

fn lwt_lower_expr_text_with_enums(e: checker::TExpr, enums: []LEnumInfo): str {
    var f0 = new_func("t", 0, [], LType::I64)
    var ctx0 = LowerCtx {
        func = f0; block_id = 0; env = empty_lenv()
        layouts = []; rodata = []; enums = enums; lifted = []
        variants = []
        defers = []; loop_targets = []; externs = []
        flat_symbols = false; ret_type = checker::Prim { kind = checker::PrimKind::I64 }
        has_ret_len_slot = false; ret_len_slot = 0
        ref_fns = []; field_decls = []; addr_taken = []; table = checker::tt_empty()
        region_stack = []; escaping = []; frees_old_names = []; bracket_depth = 0
    }
    var lo = match lower_expr(ctx0, e) { Lowered as x => x; error as err => return teko::str::concat("ERR: ", err.message) }
    var m0 = with_rodata(add_func(empty_module(), lo.ctx.func), lo.ctx.rodata)
    print_lmodule(lwt_fold_lifted(m0, lo.ctx.lifted))
}

fn lwt_color_enums(): []LEnumInfo {
    [LEnumInfo { name = "Color"; members = ["Red", "Green"]; carrier = LType::I32; is_register = true; is_newtype = false }]
}

#test
fn lwt_ltype_of_maps_prims_to_machine_classes() {
    teko::assert::is_true(match ltype_of(lwt_prim(checker::PrimKind::I64), []) { I64 => true; _ => false })
    teko::assert::is_true(match ltype_of(lwt_prim(checker::PrimKind::U32), []) { I32 => true; _ => false })
    teko::assert::is_true(match ltype_of(lwt_prim(checker::PrimKind::I8), []) { I8 => true; _ => false })
    teko::assert::is_true(match ltype_of(lwt_prim(checker::PrimKind::F64), []) { F64 => true; _ => false })
    teko::assert::is_true(match ltype_of(lwt_prim(checker::PrimKind::Bool), []) { I8 => true; _ => false })
}

#test
fn lwt_is_register_value_type_treats_byte_as_scalar() {
    teko::assert::is_true(is_register_value_type(checker::Byte { }, []))
}

#test
fn lwt_variant_member_named_accepts_primitive_case_names() {
    teko::assert::is_true(variant_member_named(checker::Prim { kind = checker::PrimKind::U32 }, "u32"))
    teko::assert::is_true(variant_member_named(checker::Byte { }, "byte"))
    teko::assert::is_true(variant_member_named(checker::Char { }, "char"))
}

#test
fn lwt_push_aggregate_size_accepts_registered_named_structs() {
    var layout = LStructLayout { name = "Pair16"; size = 16 to u32; align = 8 to u32; field_names = []; field_offsets = []; field_types = [] }
    var layouts = [layout]
    var ctx0 = LowerCtx {
        func = new_func("t", 0, [], LType::I64); block_id = 0; env = empty_lenv()
        layouts = layouts; rodata = []; enums = []; lifted = []
        variants = []
        defers = []; loop_targets = []; externs = []
        flat_symbols = false; ret_type = checker::Prim { kind = checker::PrimKind::I64 }
        has_ret_len_slot = false; ret_len_slot = 0
        ref_fns = []; field_decls = []; addr_taken = []; table = checker::tt_empty()
        region_stack = []; escaping = []; frees_old_names = []; bracket_depth = 0
    }
    teko::assert::is_true(match aggregate_box_bytes(checker::Named { name = "Pair16" }, ctx0) { u32 as n => n == (16 to u32); null => false })
}

#test
fn lwt_variant_case_of_bind_pattern_resolves_slice_by_kind() {
    var members: []@Type() = teko::list::empty()
    members = teko::list::push(members, lwt_prim(checker::PrimKind::U32))
    members = teko::list::push(members, checker::Slice { element = lwt_prim(checker::PrimKind::U32) })
    var pat = parser::BindPattern { type_name = parser::Path { segments = [] }; has_binding = true; binding = "xs"; is_slice = true; slice_type = parser::SliceType { element = parser::NamedType { path = lwt_path1("u32"); args = [] } }; type_args = [] }
    teko::assert::is_true(match variant_case_of_bind_pattern(members, pat) { VariantMember as vm => vm.index == (1 to u32); error => false })
}

fn lwt_binop_is(op: lexer::TokenKind, k: checker::PrimKind, want: LBinOp): bool {
    match lbinop_of(op, k) { LBinOp as o => o == want; error => false }
}

fn lwt_unop_is(op: lexer::TokenKind, k: checker::PrimKind, want: LUnOp): bool {
    match lunop_of(op, k) { LUnOp as o => o == want; error => false }
}

#test
fn lwt_lbinop_of_picks_signedness_and_family() {
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Plus, checker::PrimKind::I64, LBinOp::IAdd))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Slash, checker::PrimKind::I32, LBinOp::IDivS))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Slash, checker::PrimKind::U32, LBinOp::IDivU))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Percent, checker::PrimKind::I64, LBinOp::IRemS))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Plus, checker::PrimKind::F64, LBinOp::FAdd))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::AndAnd, checker::PrimKind::Bool, LBinOp::IAnd))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::OrOr, checker::PrimKind::Bool, LBinOp::IOr))
}

#test
fn lwt_lbinop_of_maps_bitwise_and_shift() {
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Amp, checker::PrimKind::I64, LBinOp::IAnd))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Pipe, checker::PrimKind::U32, LBinOp::IOr))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Caret, checker::PrimKind::I16, LBinOp::IXor))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Shl, checker::PrimKind::I64, LBinOp::IShl))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Shr, checker::PrimKind::I64, LBinOp::IShrS))
    teko::assert::is_true(lwt_binop_is(lexer::TokenKind::Shr, checker::PrimKind::U64, LBinOp::IShrU))
}

#test
fn lwt_lbinop_of_rejects_out_of_subset() {
    teko::assert::is_true(match lbinop_of(lexer::TokenKind::AndAnd, checker::PrimKind::I64) { LBinOp => false; error => true })
}

#test
fn lwt_lunop_of_picks_negation_family() {
    teko::assert::is_true(lwt_unop_is(lexer::TokenKind::Minus, checker::PrimKind::I64, LUnOp::INeg))
    teko::assert::is_true(lwt_unop_is(lexer::TokenKind::Minus, checker::PrimKind::F64, LUnOp::FNeg))
    teko::assert::is_true(lwt_unop_is(lexer::TokenKind::Tilde, checker::PrimKind::I64, LUnOp::INot))
    teko::assert::is_true(lwt_unop_is(lexer::TokenKind::Tilde, checker::PrimKind::U8, LUnOp::INot))
    teko::assert::is_true(match lunop_of(lexer::TokenKind::Bang, checker::PrimKind::Bool) { LUnOp => false; error => true })
}

#test
fn lwt_lowers_logical_not_to_icmpeq_zero() {
    var cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::Lt, lwt_num_i64(2))])
    var e = lwt_unary(lexer::TokenKind::Bang, cond, checker::PrimKind::Bool)
    var text = lwt_lower_expr_text(e)
    teko::assert::str_contains(text, "%3 = const 0")
    teko::assert::str_contains(text, "%4 = icmpeq %2, %3")
    teko::assert::is_true(!teko::str::contains(text, "inot"))
}

#test
fn lwt_lowers_unary_neg() {
    var e = lwt_unary(lexer::TokenKind::Minus, lwt_num_i64(42), checker::PrimKind::I64)
    teko::assert::str_contains(lwt_lower_expr_text(e), "%1 = ineg %0")
}

#test
fn lwt_lowers_unary_bitnot() {
    var e = lwt_unary(lexer::TokenKind::Tilde, lwt_num_i64(5), checker::PrimKind::I64)
    var text = lwt_lower_expr_text(e)
    teko::assert::str_contains(text, "%1 = inot %0")
    teko::assert::is_true(!teko::str::contains(text, "icmpeq"))
}

#test
fn lwt_lowers_bitwise_ops() {
    var a = lwt_num_i64(6)
    var b = lwt_num_i64(3)
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Amp, a, b, checker::PrimKind::I64)), "%2 = iand %0, %1")
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Pipe, a, b, checker::PrimKind::I64)), "%2 = ior %0, %1")
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Caret, a, b, checker::PrimKind::I64)), "%2 = ixor %0, %1")
}

#test
fn lwt_lowers_shift_ops_pick_signedness() {
    var a = lwt_num_i64(8)
    var amt = lwt_num_i64(2)
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Shl, a, amt, checker::PrimKind::I64)), "%2 = ishl %0, %1")
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Shr, a, amt, checker::PrimKind::I64)), "%2 = ishrs %0, %1")
    var ua = lwt_num(8, checker::PrimKind::U64)
    var uamt = lwt_num(2, checker::PrimKind::U64)
    teko::assert::str_contains(lwt_lower_expr_text(lwt_bin(lexer::TokenKind::Shr, ua, uamt, checker::PrimKind::U64)), "%2 = ishru %0, %1")
}

#test
fn lwt_lowers_cast_i64_to_i32_guards_the_fit() {
    var e = lwt_cast(lwt_num_i64(42), checker::PrimKind::I32)
    var text = lwt_lower_expr_text(e)
    teko::assert::is_true(!teko::str::contains(text, "trunc"))
    teko::assert::str_contains(text, "const -2147483648")
    teko::assert::str_contains(text, "const 2147483647")
    teko::assert::str_contains(text, "icmpges")
    teko::assert::str_contains(text, "icmples")
    teko::assert::str_contains(text, "tk_panic_cast")
}

#test
fn lwt_lowers_cast_u64_to_u8_guards_only_the_ceiling() {
    var e = lwt_cast(lwt_num(300, checker::PrimKind::U64), checker::PrimKind::U8)
    var text = lwt_lower_expr_text(e)
    teko::assert::str_contains(text, "const 255")
    teko::assert::str_contains(text, "icmpleu")
    teko::assert::str_contains(text, "tk_panic_cast")
    teko::assert::is_true(!teko::str::contains(text, "icmpges"))
}

#test
fn lwt_lowers_cast_i32_to_i64_retracks_width() {
    var inner = lwt_num(5, checker::PrimKind::I32)
    var text = lwt_lower_expr_text(lwt_cast(inner, checker::PrimKind::I64))
    teko::assert::is_true(!teko::str::contains(text, "tk_panic_cast"))
    teko::assert::is_true(!teko::str::contains(text, "sext"))
    teko::assert::is_true(!teko::str::contains(text, "trunc"))
    teko::assert::str_contains(text, "ior")
}

#test
fn lwt_lowers_unsigned_ge_comparison() {
    var e = lwt_cmp(lwt_num(3, checker::PrimKind::U32), [lwt_cmp_term(lexer::TokenKind::Ge, lwt_num(5, checker::PrimKind::U32))])
    teko::assert::str_contains(lwt_lower_expr_text(e), "%2 = icmpgeu %0, %1")
}

#test
fn lwt_lowers_eq_and_ne_comparisons() {
    var eq = lwt_cmp(lwt_num_i64(3), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(3))])
    teko::assert::str_contains(lwt_lower_expr_text(eq), "icmpeq %0, %1")
    var ne = lwt_cmp(lwt_num_i64(3), [lwt_cmp_term(lexer::TokenKind::Ne, lwt_num_i64(3))])
    teko::assert::str_contains(lwt_lower_expr_text(ne), "icmpne %0, %1")
}

#test
fn lwt_lowers_float_eq_comparison() {
    var e = lwt_cmp(lwt_fnum(1.5), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_fnum(2.5))])
    teko::assert::str_contains(lwt_lower_expr_text(e), "fcmpeq %0, %1")
}

#test
fn lwt_lowers_chain_comparison_ands_adjacent_terms() {
    var a = lwt_num_i64(1)
    var b = lwt_num_i64(2)
    var c = lwt_num_i64(3)
    var terms = [lwt_cmp_term(lexer::TokenKind::Lt, b), lwt_cmp_term(lexer::TokenKind::Lt, c)]
    var text = lwt_lower_expr_text(lwt_cmp(a, terms))
    teko::assert::str_contains(text, "icmplts %0, %1")
    teko::assert::str_contains(text, "icmplts %1, %3")
    teko::assert::str_contains(text, "branch")
    teko::assert::str_contains(text, "jump #B")
}

#test
fn lwt_if_stmt_value_if_rhs_reassign_threads_the_outer_merge() {
    var inner_cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))])
    var inner_then = [lwt_simple_assign("x", lexer::TokenKind::Assign, lwt_num_i64(5), checker::PrimKind::I64), lwt_exprstmt(lwt_var("x", checker::PrimKind::I64))]
    var inner_else = [lwt_exprstmt(lwt_num_i64(0))]
    var inner_if = lwt_if_value(inner_cond, inner_then, inner_else, checker::PrimKind::I64)
    var outer_then = [lwt_bind("y", inner_if, checker::PrimKind::I64)]
    var outer_cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))])
    var ifstmt = lwt_if_stmt(outer_cond, outer_then, false, [])
    var body = [lwt_bind("x", lwt_num_i64(1), checker::PrimKind::I64), lwt_exprstmt(ifstmt), lwt_ret(lwt_var("x", checker::PrimKind::I64))]
    var f = lwt_fn("nested_value_if_rhs", "teko::demo", [], checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B4:\n    %10 = const 5\n    jump #B6(%10, %10)")
    teko::assert::str_contains(text, "  #B5:\n    %11 = const 0\n    jump #B6(%11, %0)")
    teko::assert::str_contains(text, "  #B6(%8, %9):\n    jump #B3(%9)")
    teko::assert::str_contains(text, "  #B2:\n    jump #B3(%0)")
    teko::assert::str_contains(text, "  #B3(%4):\n    ret %4")
}

#test
fn lwt_match_stmt_threads_both_the_reassigned_and_the_pattern_shadowed_name() {
    var subject = lwt_var("k", checker::PrimKind::I64)
    var arm0 = lwt_arm(lwt_bind_pattern("A", "x"), [])
    var arm1_body = [lwt_simple_assign("x", lexer::TokenKind::Assign, lwt_num_i64(99), checker::PrimKind::I64), lwt_simple_assign("y", lexer::TokenKind::Assign, lwt_num_i64(20), checker::PrimKind::I64)]
    var arm1 = lwt_arm(lwt_wildcard_pattern(), arm1_body)
    var arms = [arm0, arm1]
    var match_stmt = checker::TExpr { kind = checker::TMatchExpr { subject = subject; arms = arms }; type = checker::Void { }; line = 0; col = 0 }
    var tail = lwt_ret(lwt_bin(lexer::TokenKind::Plus, lwt_var("x", checker::PrimKind::I64), lwt_var("y", checker::PrimKind::I64), checker::PrimKind::I64))
    var body = [lwt_bind("x", lwt_num_i64(1), checker::PrimKind::I64), lwt_bind("y", lwt_num_i64(10), checker::PrimKind::I64), lwt_exprstmt(match_stmt), tail]
    var params = [lwt_param("k", "i64")]
    var f = lwt_fn("shadow_and_clean_reassign", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "#B1(%3, %4):")
    teko::assert::str_contains(text, "jump #B1(%1, %2)")
    teko::assert::str_contains(text, "jump #B1(%5, %6)")
    teko::assert::str_contains(text, "ret %7")
}

#test
fn lwt_honest_stop_on_if_without_else_as_a_value() {
    var cond = lwt_cmp(lwt_num_i64(1), [lwt_cmp_term(lexer::TokenKind::Lt, lwt_num_i64(2))])
    var then_blk = [lwt_exprstmt(lwt_num_i64(1))]
    var ifexpr = checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = then_blk }; type = lwt_prim(checker::PrimKind::I64); line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(ifexpr), "if-without-else used as a value not yet lowered")
}

#test
fn lwt_println_arity_mismatch_honest_stops() {
    var args = [lwt_strlit("a"), lwt_strlit("b")]
    var call = lwt_call(lwt_path1("println"), "", args, checker::Void { })
    teko::assert::str_contains(lwt_lower_expr_text(call), "expects exactly one str argument")
}

#test
fn lwt_println_of_a_direct_call_producer_lowers_through_the_hidden_out_slot() {
    var inner = lwt_call(lwt_path1("mk_str"), "teko::demo", [], checker::Str { })
    var call = lwt_call(lwt_path1("println"), "", [inner], checker::Void { })
    var text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "%0 = alloca 8, align 8")
    teko::assert::str_contains(text, "%1 = call @teko_teko__demo__mk_str(%0)")
    teko::assert::str_contains(text, "%2 = load.i64 %0")
    teko::assert::str_contains(text, "call @tk_println(%1, %2)")
}

#test
fn lwt_lowers_direct_teko_call_with_mangle() {
    var args = [lwt_num_i64(40), lwt_num_i64(2)]
    var call = lwt_call(lwt_path1("add"), "teko::demo", args, checker::Prim { kind = checker::PrimKind::I64 })
    teko::assert::str_contains(lwt_lower_expr_text(call), "%2 = call @teko_teko__demo__add(%0, %1)")
}

fn lwt_extern_fn(name: str, ns: str, sym: str): @TItem() {
    checker::TFunction { overload_suffix = "";
        name = name; type_params = []; type_constraints = []
        namespace = ns; params = []; return_type = lwt_prim(checker::PrimKind::I32)
        body = []
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        file = ""; line = 0; col = 0; is_test = false; is_extern = true; c_symbol = sym; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = []; guard = parser::pred_true() }
}

#test
fn lwt_extern_call_targets_the_declared_c_symbol() {
    var items: []@TItem() = [lwt_extern_fn("c_getpid", "p", "getpid")]
    var call = lwt_call(lwt_path1("c_getpid"), "p", [], checker::Prim { kind = checker::PrimKind::I32 })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(call)))
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "call @getpid()")
    teko::assert::is_true(!teko::str::contains(text, "p__c_getpid"))
}

#test
fn lwt_extern_call_i32_return_is_narrowed() {
    var items: []@TItem() = [lwt_extern_fn("c_memcmp", "p", "memcmp")]
    var call = lwt_call(lwt_path1("c_memcmp"), "p", [], checker::Prim { kind = checker::PrimKind::I32 })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(call)))
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "call @memcmp()")
    teko::assert::str_contains(text, "const 32")
    teko::assert::str_contains(text, "= ishl ")
    teko::assert::str_contains(text, "= ishrs ")
    teko::assert::is_true(!teko::str::contains(text, "ishru"))
}

fn lwt_extern_fn_ret(name: str, ns: str, sym: str, ret: @Type()): @TItem() {
    checker::TFunction { overload_suffix = "";
        name = name; type_params = []; type_constraints = []
        namespace = ns; params = []; return_type = ret
        body = []
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        file = ""; line = 0; col = 0; is_test = false; is_extern = true; c_symbol = sym; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = []; guard = parser::pred_true() }
}

#test
fn lwt_extern_call_u64_return_is_not_narrowed() {
    var items: []@TItem() = [lwt_extern_fn_ret("c_aligned_alloc", "p", "aligned_alloc", checker::Prim { kind = checker::PrimKind::U64 })]
    var call = lwt_call(lwt_path1("c_aligned_alloc"), "p", [], checker::Prim { kind = checker::PrimKind::U64 })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(call)))
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "call @aligned_alloc()")
    teko::assert::is_true(!teko::str::contains(text, "ishl"))
}

#test
fn lwt_extern_call_void_return_is_not_narrowed() {
    var items: []@TItem() = [lwt_extern_fn_ret("c_free", "p", "free", checker::Void { })]
    var call = lwt_call(lwt_path1("c_free"), "p", [], checker::Void { })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(call)))
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "call @free()")
    teko::assert::is_true(!teko::str::contains(text, "ishl"))
}

fn lwt_item(s: @TStatement()): @TItem() { s }

fn lwt_const(name: str, init: checker::TExpr): @TItem() {
    checker::TConstDecl { name = name; namespace = ""; ty = lwt_prim(checker::PrimKind::I64); init = init; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; guard = parser::pred_true() }
}

#test
fn lwt_scalar_const_inlines_and_leaves_no_global() {
    var use_expr = lwt_bin(lexer::TokenKind::Plus, lwt_var("K", checker::PrimKind::I64), lwt_num_i64(1), checker::PrimKind::I64)
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_const("K", lwt_num_i64(41)))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [use_expr], checker::Void { }))))
    var inlined = match checker::inline_consts(checker::TProgram { items = items }) { checker::TProgram as p => p; error as err => { teko::assert::is_true(false); return } }
    var m = match lower_program(inlined) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.globals.len == 0)
    var text = print_lmodule(m)
    teko::assert::is_true(!teko::str::contains(text, "K"))
    teko::assert::str_contains(text, "const 42")
}

#test
fn lwt_agg_slice_const_materializes_one_rodata_entry() {
    var elems = [lwt_num_i64(10), lwt_num_i64(20)]
    var slice_ty = checker::Slice { element = lwt_prim(checker::PrimKind::I64) }
    var cd: @TItem() = checker::TConstDecl { name = "NUMS"; namespace = ""; ty = slice_ty; init = lwt_array_lit(elems, checker::PrimKind::I64); vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; guard = parser::pred_true() }
    var i64_ty = lwt_prim(checker::PrimKind::I64)
    var idx_bind: @TStatement() = checker::TBinding { kind = parser::BindKind::Var; target = parser::SimpleName { name = "idx" }; bound = i64_ty; value = lwt_num_i64(0) }
    var use0 = lwt_index(lwt_typed_var("NUMS", slice_ty), lwt_typed_var("idx", i64_ty), i64_ty)
    var use1 = lwt_index(lwt_typed_var("NUMS", slice_ty), lwt_typed_var("idx", i64_ty), i64_ty)
    var sum = lwt_bin(lexer::TokenKind::Plus, use0, use1, checker::PrimKind::I64)
    var items: []@TItem() = [cd]
    items = teko::list::push(items, lwt_item(idx_bind))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [sum], checker::Void { }))))
    var inlined = match checker::inline_consts(checker::TProgram { items = items }) { checker::TProgram as p => p; error as err => { teko::assert::is_true(false); return } }
    var m = match lower_program(inlined) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.globals.len == 0)
    teko::assert::is_true(m.rodata.len == 1)
    teko::assert::is_true(m.rodata[0].symbol == ".Lconst_NUMS")
    teko::assert::is_true(m.rodata[0].relocs.len == 0)
    teko::assert::is_true(m.rodata[0].bytes.len == 16)
    teko::assert::is_true(m.rodata[0].bytes[0] == (10 to byte))
    teko::assert::is_true(m.rodata[0].bytes[8] == (20 to byte))
    teko::assert::str_contains(print_lmodule(m), "global_addr @.Lconst_NUMS")
}

fn lwt_variant_decl(name: str, members: []str): @TItem() {
    var mtes: []@TypeExpr() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= members.len { break }
        mtes = teko::list::push(mtes, lwt_named_te(members[i]))
        i++
    }
    parser::TypeDecl {
        name = name; type_params = []; type_constraints = []
        body = parser::VariantBody { type_expr = parser::UnionType { members = mtes } }
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none()
        line = 0; col = 0
   ; is_global = false }
}

#test
fn lwt_agg_empty_variant_const_interns_its_tag_image() {
    var members = ["RetA", "RetB", "RetC"]
    var items: []@TItem() = [lwt_variant_decl("Op", members)]
    var init = lwt_struct_init("RetC", [], [])
    var cd: @TItem() = checker::TConstDecl { name = "R"; namespace = ""; ty = checker::Named { name = "Op" }; init = init; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; guard = parser::pred_true() }
    items = teko::list::push(items, cd)
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.globals.len == 0)
    teko::assert::is_true(m.rodata.len == 1)
    teko::assert::is_true(m.rodata[0].symbol == ".Lconst_R")
    teko::assert::is_true(m.rodata[0].bytes.len == 24)
    teko::assert::is_true(m.rodata[0].bytes[0] == (2 to byte))
    teko::assert::is_true(m.rodata[0].bytes[1] == (0 to byte))
    teko::assert::is_true(m.rodata[0].bytes[2] == (0 to byte))
    teko::assert::is_true(m.rodata[0].bytes[3] == (0 to byte))
    teko::assert::is_true(lwt_all_zero_from(m.rodata[0].bytes, 4))
}

fn lwt_all_zero_from(bytes: []byte, start: u64): bool {
    var i = start
    loop {
        if i >= bytes.len { break }
        if bytes[i] != (0 to byte) { return false }
        i++
    }
    true
}

fn lwt_slice_field(name: str, elem_tname: str): parser::Field {
    parser::Field { name = name; type_ann = parser::SliceType { element = lwt_named_te(elem_tname) }; vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
}

#test
fn lwt_agg_struct_fat_field_slot_is_8byte_aligned() {
    var decl = lwt_struct_decl("M3", lwt_two_fields(lwt_field("flag", "byte"), lwt_slice_field("xs", "i64")))
    var elems = [lwt_num_i64(10), lwt_num_i64(20), lwt_num_i64(30)]
    var xs_lit = lwt_array_lit(elems, checker::PrimKind::I64)
    var fnames = ["flag", "xs"]
    var fvals = [lwt_num_i64(7), xs_lit]
    var si = lwt_struct_init("M3", fnames, fvals)
    var cd: @TItem() = checker::TConstDecl { name = "K3"; namespace = ""; ty = checker::Named { name = "M3" }; init = si; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; guard = parser::pred_true() }
    var items: []@TItem() = [decl]
    items = teko::list::push(items, cd)
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.rodata.len == 2)
    teko::assert::is_true(m.rodata[0].symbol == ".Lconst_K3.xs")
    teko::assert::is_true(m.rodata[1].symbol == ".Lconst_K3")
    teko::assert::is_true(m.rodata[1].bytes.len == 24)
    teko::assert::is_true(m.rodata[1].bytes[0] == (7 to byte))
    teko::assert::is_true(m.rodata[1].relocs.len == 1)
    teko::assert::is_true(m.rodata[1].relocs[0].offset == (8 to u32))
    teko::assert::is_true(m.rodata[1].relocs[0].offset % (8 to u32) == (0 to u32))
    teko::assert::is_true(m.rodata[1].relocs[0].target == ".Lconst_K3.xs")
}

fn lwt_str_array_lit(elems: []checker::TExpr): checker::TExpr {
    var es: []checker::TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= elems.len { break }
        es = teko::list::push(es, lwt_array_elem(elems[i]))
        i++
    }
    checker::TExpr { kind = checker::TArrayLit { elements = es }; type = checker::Slice { element = checker::Str { } }; line = 0; col = 0 }
}

#test
fn lwt_agg_fat_array_slot_offsets_are_ptr_aligned() {
    var elems = [lwt_strlit("a"), lwt_strlit("bb"), lwt_strlit("ccc")]
    var cd: @TItem() = checker::TConstDecl { name = "WORDS"; namespace = ""; ty = checker::Slice { element = checker::Str { } }; init = lwt_str_array_lit(elems); vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; guard = parser::pred_true() }
    var items: []@TItem() = [cd]
    var m = match lower_program(checker::TProgram { items = items }) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.rodata.len == 4)
    teko::assert::is_true(m.rodata[0].symbol == ".Lconst_WORDS.0")
    teko::assert::is_true(m.rodata[1].symbol == ".Lconst_WORDS.1")
    teko::assert::is_true(m.rodata[2].symbol == ".Lconst_WORDS.2")
    teko::assert::is_true(m.rodata[3].symbol == ".Lconst_WORDS")
    teko::assert::is_true(m.rodata[3].bytes.len == 48)
    teko::assert::is_true(m.rodata[3].relocs.len == 3)
    teko::assert::is_true(m.rodata[3].relocs[0].offset == (0 to u32))
    teko::assert::is_true(m.rodata[3].relocs[1].offset == (16 to u32))
    teko::assert::is_true(m.rodata[3].relocs[2].offset == (32 to u32))
    teko::assert::is_true(m.rodata[3].relocs[0].target == ".Lconst_WORDS.0")
    teko::assert::is_true(m.rodata[3].relocs[1].target == ".Lconst_WORDS.1")
    teko::assert::is_true(m.rodata[3].relocs[2].target == ".Lconst_WORDS.2")
}

fn lwt_one_field_fat_layout(name: str, size: u32): LStructLayout {
    LStructLayout {
        name = name; size = size; align = 8 to u32
        field_names = ["s"]
        field_offsets = [0 to u32]
        field_types = [LType::Ptr]
    }
}

fn lwt_one_str_field_init(): checker::TStructInit {
    checker::TStructInit {
        field_names = ["s"]
        field_vals = [lwt_strlit("x")]
    }
}

#test
fn lwt_const_size_check_flags_undersized_fat_field() {
    var si = lwt_one_str_field_init()
    var fired = match check_struct_fat_spans("KBAD", lwt_one_field_fat_layout("Bad", 8 to u32), si) { error => true; null => false }
    teko::assert::is_true(fired)
    var clean = match check_struct_fat_spans("KGOOD", lwt_one_field_fat_layout("Good", 16 to u32), si) { error => false; null => true }
    teko::assert::is_true(clean)
}

fn lwt_typed_var(name: str, ty: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = false; func_ns = "" }; type = ty; line = 0; col = 0 }
}

fn lwt_wildcard_pattern(): @Pattern() { parser::WildcardPattern { } }

fn lwt_int_pattern(v: i64): @Pattern() {
    parser::LiteralPattern { value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }; line = 0; col = 0 } }
}

fn lwt_str_pattern(text: str): @Pattern() {
    parser::LiteralPattern { value = parser::Expr { kind = parser::StrLit { text = text }; line = 0; col = 0 } }
}

fn lwt_bind_pattern(case_name: str, binding: str): @Pattern() {
    parser::BindPattern { type_name = lwt_path1(case_name); has_binding = binding != ""; binding = binding; is_slice = false; slice_type = null; type_args = [] }
}

fn lwt_arm(pat: @Pattern(), body: []@TStatement()): checker::TArm {
    checker::TArm { pattern = pat; has_when = false; guard = lwt_num_i64(0); body = body }
}

fn lwt_guarded_arm(pat: @Pattern(), guard: checker::TExpr, body: []@TStatement()): checker::TArm {
    checker::TArm { pattern = pat; has_when = true; guard = guard; body = body }
}

fn lwt_match_value(subject: checker::TExpr, arms: []checker::TArm, k: checker::PrimKind): checker::TExpr {
    checker::TExpr { kind = checker::TMatchExpr { subject = subject; arms = arms }; type = lwt_prim(k); line = 0; col = 0 }
}

fn lwt_variant2(a: str, b: str): @Type() {
    checker::Variant { members = [checker::Named { name = a }, checker::Named { name = b }] }
}

fn lwt_circle_layout(): LStructLayout {
    layout_of("Circle", ["radius"], [LType::I64])
}

#test
fn lwt_lowers_match_enum_member_pattern_via_registered_ordinal() {
    var subject = lwt_typed_var("c", checker::Named { name = "Color" })
    var arm0 = lwt_arm(lwt_bind_pattern("Red", ""), [lwt_exprstmt(lwt_num_i64(10))])
    var arm1 = lwt_arm(lwt_wildcard_pattern(), [lwt_exprstmt(lwt_num_i64(0))])
    var arms = [arm0, arm1]
    var match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    var params = [lwt_param("c", "Color")]
    var body = [lwt_ret(match_expr)]
    var f = lwt_fn("pick_color", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var enums = [LEnumInfo { name = "Color"; members = ["Red", "Green"]; carrier = LType::I32; is_register = true; is_newtype = false }]
    var lf = match lower_function(f, checker::tt_empty(), [], [], enums) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = const 0")
    teko::assert::str_contains(text, "%3 = icmpeq %0, %2")
    teko::assert::str_contains(text, "branch %3, #B2(), #B3()")
    teko::assert::str_contains(text, "  #B3:\n    jump #B4()")
}

#test
fn lwt_prim_kind_of_resolves_enum_equality_comparison() {
    var a = lwt_typed_var("a", checker::Named { name = "Color" })
    var b = lwt_typed_var("b", checker::Named { name = "Color" })
    var cmp = lwt_cmp(a, [lwt_cmp_term(lexer::TokenKind::EqEq, b)])
    var params = [lwt_param("a", "Color"), lwt_param("b", "Color")]
    var body = [lwt_ret(cmp)]
    var f = lwt_fn("colors_eq", "teko::demo", params, checker::Prim { kind = checker::PrimKind::Bool }, body)
    var lf = match lower_function(f, checker::tt_empty(), [], [], lwt_color_enums()) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = icmpeq %0, %1")
}

const LWT_ENUM_WIDEN_CAST_LIR: str = "func @teko_teko__demo__color_ordinal(%0: i32): i64 {\n  #B0:\n    %0 = param 0\n    ret %0\n}\n"

#test
fn lwt_prim_kind_of_resolves_enum_to_int_cast_emits_no_conversion() {
    var inner = lwt_typed_var("c", checker::Named { name = "Color" })
    var e = lwt_cast(inner, checker::PrimKind::I64)
    var params = [lwt_param("c", "Color")]
    var body = [lwt_ret(e)]
    var f = lwt_fn("color_ordinal", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty(), [], [], lwt_color_enums()) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::is_true(text == LWT_ENUM_WIDEN_CAST_LIR)
    teko::assert::is_false(teko::str::contains(text, "sext"))
    teko::assert::is_false(teko::str::contains(text, "zext"))
    teko::assert::is_false(teko::str::contains(text, "trunc"))
}

const LWT_ENUM_NARROW_CAST_LIR: str = "func @teko_teko__demo__as_color(%0: i64): i32 {\n  #B0:\n    %0 = param 0\n    %1 = const -2147483648\n    %2 = icmpges %0, %1\n    branch %2, #B1(), #B2()\n  #B1:\n    %3 = const 2147483647\n    %4 = icmples %0, %3\n    branch %4, #B3(), #B4()\n  #B2:\n    call @tk_panic_cast()\n    jump #B2()\n  #B3:\n    ret %0\n  #B4:\n    call @tk_panic_cast()\n    jump #B4()\n}\n"

#test
fn lwt_prim_kind_of_resolves_int_to_enum_cast_guards_the_fit() {
    var inner = lwt_var("n", checker::PrimKind::I64)
    var e = checker::TExpr { kind = checker::TCast { expr = inner }; type = checker::Named { name = "Color" }; line = 0; col = 0 }
    var params = [lwt_param("n", "i64")]
    var body = [lwt_ret(e)]
    var f = lwt_fn("as_color", "teko::demo", params, checker::Named { name = "Color" }, body)
    var lf = match lower_function(f, checker::tt_empty(), [], [], lwt_color_enums()) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::is_true(text == LWT_ENUM_NARROW_CAST_LIR)
    teko::assert::is_true(teko::str::contains(text, "icmpges"))
    teko::assert::is_true(teko::str::contains(text, "icmples"))
    teko::assert::is_true(teko::str::contains(text, "call @tk_panic_cast()"))
    teko::assert::is_false(teko::str::contains(text, "trunc"))
    teko::assert::is_false(teko::str::contains(text, "sext"))
    teko::assert::is_false(teko::str::contains(text, "zext"))
}

#test
fn lwt_prim_kind_of_still_honest_stops_a_non_enum_named_type() {
    var left = lwt_num_i64(1)
    var right = lwt_num_i64(2)
    var bin = checker::TExpr { kind = checker::TBinary { op = lexer::TokenKind::Plus; left = left; right = right }; type = checker::Named { name = "Circle" }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text_with_enums(bin, lwt_color_enums()), "non-enum named-type")
}

#test
fn lwt_lowers_match_when_guard_falls_through_to_next_arm() {
    var subject = lwt_var("x", checker::PrimKind::I64)
    var guard = lwt_cmp(subject, [lwt_cmp_term(lexer::TokenKind::Gt, lwt_num_i64(0))])
    var arm0 = lwt_guarded_arm(lwt_int_pattern(1), guard, [lwt_exprstmt(lwt_num_i64(100))])
    var arm1 = lwt_arm(lwt_wildcard_pattern(), [lwt_exprstmt(lwt_num_i64(0))])
    var arms = [arm0, arm1]
    var match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    var params = [lwt_param("x", "i64")]
    var body = [lwt_ret(match_expr)]
    var f = lwt_fn("guarded_pick", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "branch %3, #B2(), #B3()")
    teko::assert::str_contains(text, "branch %5, #B4(), #B3()")
    teko::assert::str_contains(text, "  #B4:\n    %6 = const 100\n    jump #B1(%6)")
    teko::assert::str_contains(text, "  #B3:\n    jump #B5()")
}

#test
fn lwt_lowers_match_variant_case_binds_the_payload() {
    var subject = lwt_typed_var("s", lwt_variant2("Circle", "Square"))
    var payload = lwt_field_access(lwt_typed_var("c", checker::Named { name = "Circle" }), "radius", lwt_prim(checker::PrimKind::I64))
    var arm0 = lwt_arm(lwt_bind_pattern("Circle", "c"), [lwt_exprstmt(payload)])
    var arms = [arm0]
    var match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    var params = [lwt_param("s", "Shape")]
    var body = [lwt_ret(match_expr)]
    var f = lwt_fn("read_case", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty(), lwt_one_layout(lwt_circle_layout())) { LoweredFunction as r => r.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = field_addr %0, 0")
    teko::assert::str_contains(text, "%3 = load.i32 %2")
    teko::assert::str_contains(text, "%5 = icmpeq %3, %4")
    teko::assert::str_contains(text, "%6 = field_addr %0, 8")
    teko::assert::str_contains(text, "%7 = load.ptr %6")
    teko::assert::str_contains(text, "%8 = field_addr %7, 0")
    teko::assert::str_contains(text, "%9 = load.i64 %8")
    teko::assert::str_contains(text, "jump #B1(%9)")
    teko::assert::str_contains(text, "  #B1(%1):\n    ret %1")
}

#test
fn lwt_lowers_match_string_arm_via_byte_compare() {
    var subject = lwt_strlit("hi")
    var arm0 = lwt_arm(lwt_str_pattern("hi"), [lwt_exprstmt(lwt_num_i64(1))])
    var arm1 = lwt_arm(lwt_wildcard_pattern(), [lwt_exprstmt(lwt_num_i64(0))])
    var arms = [arm0, arm1]
    var match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    var text = lwt_lower_expr_text(match_expr)
    teko::assert::str_contains(text, "rodata .Lstr0: [104, 105]")
    teko::assert::str_contains(text, "global_addr @.Lstr0")
    teko::assert::str_contains(text, "load.i8")
    teko::assert::is_true(teko::str::contains(text, "icmpeq"))
    teko::assert::str_contains(text, "branch")
}

#test
fn lwt_defer_inside_match_value_arm_fires_only_on_that_arms_own_branch() {
    var s_plus_100 = lwt_bin(lexer::TokenKind::Plus, lwt_var("s", checker::PrimKind::I64), lwt_num_i64(100), checker::PrimKind::I64)
    var defer_body = [lwt_simple_assign("s", lexer::TokenKind::Assign, s_plus_100, checker::PrimKind::I64)]
    var subject = lwt_var("x", checker::PrimKind::I64)
    var arm0_body = [lwt_defer(defer_body), lwt_exprstmt(lwt_var("s", checker::PrimKind::I64))]
    var arm0 = lwt_arm(lwt_int_pattern(1), arm0_body)
    var arm1 = lwt_arm(lwt_wildcard_pattern(), [lwt_exprstmt(lwt_var("s", checker::PrimKind::I64))])
    var arms = [arm0, arm1]
    var match_expr = lwt_match_value(subject, arms, checker::PrimKind::I64)
    var body = [lwt_bind("s", lwt_num_i64(1), checker::PrimKind::I64), lwt_ret(match_expr)]
    var params = [lwt_param("x", "i64")]
    var f = lwt_fn("match_value_arm_scoped", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty()) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B2:\n    %6 = const 100\n    %7 = iadd %1, %6\n    jump #B1(%1, %7)")
    teko::assert::str_contains(text, "  #B3:\n    jump #B4()")
    teko::assert::str_contains(text, "  #B4:\n    jump #B1(%1, %1)")
    teko::assert::str_contains(text, "  #B1(%2, %3):\n    ret %2\n  #B2:")
}

fn lwt_point_layout(): LStructLayout {
    var names = ["x", "y"]
    var types = [LType::I64, LType::I64]
    layout_of("Point", names, types)
}

fn lwt_one_layout(l: LStructLayout): []LStructLayout { [l] }

fn lwt_named_var(name: str, tname: str): checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = false; func_ns = "" }; type = checker::Named { name = tname }; line = 0; col = 0 }
}

fn lwt_struct_init(tname: str, field_names: []str, field_vals: []checker::TExpr): checker::TExpr {
    checker::TExpr { kind = checker::TStructInit { field_names = field_names; field_vals = field_vals }; type = checker::Named { name = tname }; line = 0; col = 0 }
}

fn lwt_field_access(recv: checker::TExpr, field: str, ft: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TFieldAccess { receiver = recv; field = field }; type = ft; line = 0; col = 0 }
}

#test
fn lwt_lowers_struct_init_via_registered_layout() {
    var names = ["x", "y"]
    var vals = [lwt_num_i64(3), lwt_num_i64(4)]
    var si = lwt_struct_init("Point", names, vals)
    var text = lwt_lower_expr_text_with(si, lwt_one_layout(lwt_point_layout()))
    teko::assert::str_contains(text, "%0 = alloca 16, align 8")
    teko::assert::str_contains(text, "%2 = field_addr %0, 0")
    teko::assert::str_contains(text, "store.i64 %2, %1")
    teko::assert::str_contains(text, "%4 = field_addr %0, 8")
    teko::assert::str_contains(text, "store.i64 %4, %3")
}

fn lwt_array_elem(e: checker::TExpr): checker::TArrayElem { checker::TArrayElem { is_spread = false; expr = e } }

fn lwt_array_lit(elems: []checker::TExpr, k: checker::PrimKind): checker::TExpr {
    var es: []checker::TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= elems.len { break }
        es = teko::list::push(es, lwt_array_elem(elems[i]))
        i++
    }
    checker::TExpr { kind = checker::TArrayLit { elements = es }; type = checker::Slice { element = lwt_prim(k) }; line = 0; col = 0 }
}

fn lwt_index(recv: checker::TExpr, index: checker::TExpr, et: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TIndex { receiver = recv; index = index }; type = et; line = 0; col = 0 }
}

#test
fn lwt_lowers_array_literal_and_constant_index() {
    var elems = [lwt_num_i64(10), lwt_num_i64(20), lwt_num_i64(30)]
    var arr = lwt_array_lit(elems, checker::PrimKind::I64)
    var ix = lwt_index(arr, lwt_num_i64(1), lwt_prim(checker::PrimKind::I64))
    var text = lwt_lower_expr_text(ix)
    teko::assert::str_contains(text, "%0 = alloca 24, align 8")
    teko::assert::str_contains(text, "%4 = field_addr %0, 8")
    teko::assert::str_contains(text, "store.i64 %4, %3")
    teko::assert::str_contains(text, "%7 = const 24")
    teko::assert::str_contains(text, "%8 = call @tk_slice_elem_box(%0, %7)")
    teko::assert::str_contains(text, "%9 = const 3")
    teko::assert::str_contains(text, "%10 = const 1")
    teko::assert::str_contains(text, "%13 = icmpltu %10, %9")
    teko::assert::str_contains(text, "call @tk_panic_oob_at(%11, %12)")
    teko::assert::str_contains(text, "%14 = field_addr %8, 8")
    teko::assert::str_contains(text, "%15 = load.i64 %14")
}

const LWT_SLICE_DYNAMIC_INDEX_GUARDED_LIR: str = "func @t(): i64 {\n  #B0:\n    %0 = alloca 16, align 8\n    %1 = const 10\n    %2 = field_addr %0, 0\n    store.i64 %2, %1\n    %3 = const 20\n    %4 = field_addr %0, 8\n    store.i64 %4, %3\n    %5 = const 16\n    %6 = call @tk_slice_elem_box(%0, %5)\n    %7 = const 2\n    %8 = const 0\n    %9 = const 0\n    %10 = iadd %8, %9\n    %11 = const 0\n    %12 = const 0\n    %13 = icmpltu %10, %7\n    branch %13, #B1(), #B2()\n  #B1:\n    %14 = const 8\n    %15 = imul %10, %14\n    %16 = iadd %6, %15\n    %17 = load.i64 %16\n  #B2:\n    call @tk_panic_oob_at(%11, %12)\n    jump #B2()\n}\n"

#test
fn lwt_lowers_slice_index_with_an_unfoldable_index_guards_then_strides() {
    var elems = [lwt_num_i64(10), lwt_num_i64(20)]
    var arr = lwt_array_lit(elems, checker::PrimKind::I64)
    var sum = lwt_bin(lexer::TokenKind::Plus, lwt_num_i64(0), lwt_num_i64(0), checker::PrimKind::I64)
    var text = lwt_lower_expr_text(lwt_index(arr, sum, lwt_prim(checker::PrimKind::I64)))
    teko::assert::is_true(text == LWT_SLICE_DYNAMIC_INDEX_GUARDED_LIR)
    teko::assert::str_contains(text, "%6 = call @tk_slice_elem_box(%0, %5)")
    teko::assert::str_contains(text, "%10 = iadd %8, %9")
    teko::assert::str_contains(text, "%13 = icmpltu %10, %7")
    teko::assert::str_contains(text, "branch %13, #B1(), #B2()")
    teko::assert::str_contains(text, "call @tk_panic_oob_at(%11, %12)")
    teko::assert::str_contains(text, "%14 = const 8")
    teko::assert::str_contains(text, "%15 = imul %10, %14")
    teko::assert::str_contains(text, "%16 = iadd %6, %15")
    teko::assert::str_contains(text, "%17 = load.i64 %16")
    teko::assert::is_false(teko::str::contains(text, "field_addr %6"))
}

fn lwt_field_assign(recv: checker::TExpr, field: str, op: lexer::TokenKind, value: checker::TExpr, bound: @Type()): @TStatement() {
    var target = lwt_field_access(recv, field, bound)
    checker::TAssign { kind = parser::AssignKind::Field; name = ""; op = op; bound = bound; value = value; deref = false; target = target }
}

#test
fn lwt_lowers_plain_field_assignment_via_registered_layout() {
    var p = lwt_named_var("p", "Point")
    var assign = lwt_field_assign(p, "x", lexer::TokenKind::Assign, lwt_num_i64(9), lwt_prim(checker::PrimKind::I64))
    var params = [lwt_param("p", "Point")]
    var body = [assign, lwt_ret(lwt_num_i64(0))]
    var f = lwt_fn("write_x", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty(), lwt_one_layout(lwt_point_layout())) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%1 = field_addr %0, 0")
    teko::assert::str_contains(text, "%2 = const 9")
    teko::assert::str_contains(text, "store.i64 %1, %2")
}

#test
fn lwt_lowers_compound_field_assignment_reads_then_writes() {
    var p = lwt_named_var("p", "Point")
    var assign = lwt_field_assign(p, "x", lexer::TokenKind::PlusEq, lwt_num_i64(5), lwt_prim(checker::PrimKind::I64))
    var params = [lwt_param("p", "Point")]
    var body = [assign, lwt_ret(lwt_num_i64(0))]
    var f = lwt_fn("bump_x", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    var lf = match lower_function(f, checker::tt_empty(), lwt_one_layout(lwt_point_layout())) { LoweredFunction as x => x.func; error as err => return }
    var text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "%2 = load.i64 %1")
    teko::assert::str_contains(text, "iadd ")
    teko::assert::str_contains(text, "store.i64 %1, %4")
}

#test
fn lwt_lowers_compound_simple_assignment_reads_then_rebinds() {
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind("x", lwt_num_i64(4), checker::PrimKind::I64)))
    var assign = checker::TAssign { kind = parser::AssignKind::Simple; name = "x"; op = lexer::TokenKind::StarEq; bound = lwt_prim(checker::PrimKind::I64); value = lwt_num_i64(3); deref = false; target = checker::no_texpr() }
    items = teko::list::push(items, lwt_item(assign))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", [lwt_var("x", checker::PrimKind::I64)], checker::Void { }))))
    var prog = checker::TProgram { items = items }
    var m = match lower_program(prog) { LModule as x => x; error as err => return }
    var text = print_lmodule(m)
    teko::assert::str_contains(text, "%2 = imul %0, %1")
    teko::assert::str_contains(text, "call @tk_exit(%2)")
}

#test
fn lwt_lowers_byte_literal() {
    var bl = checker::TExpr { kind = checker::TByteLit { value = 200 to byte }; type = checker::Byte { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(bl), "%0 = const 200")
}

#test
fn lwt_lowers_bool_literal_true_and_false() {
    var bt = checker::TExpr { kind = checker::TBoolLit { value = true }; type = lwt_prim(checker::PrimKind::Bool); line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(bt), "%0 = const 1")
    var bf = checker::TExpr { kind = checker::TBoolLit { value = false }; type = lwt_prim(checker::PrimKind::Bool); line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(bf), "%0 = const 0")
}

#test
fn lwt_lowers_null_literal_as_a_zero_ptr_const() {
    var nl = checker::TExpr { kind = checker::TNullLit { }; type = checker::Null { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(nl), "%0 = const 0")
}

#test
fn lwt_lowers_path_expr_to_its_resolved_value() {
    var pe = checker::TExpr { kind = checker::TPathExpr { enum_name = "Color"; member = "Green"; ordinal = 1; value = 1 to u64 }; type = checker::Named { name = "Color" }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(pe), "%0 = const 1")
}

#test
fn lwt_lowers_char_literal_multibyte_to_its_codepoint() {
    var cl = checker::TExpr { kind = checker::TCharLit { bytes = "é" }; type = checker::Char { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(cl), "%0 = const 233")
}

fn lwt_strlit(text: str): checker::TExpr {
    checker::TExpr { kind = checker::TStrLit { text = text }; type = checker::Str { }; line = 0; col = 0 }
}

fn lwt_len_field(recv: checker::TExpr): checker::TExpr {
    checker::TExpr { kind = checker::TFieldAccess { receiver = recv; field = "len" }; type = lwt_prim(checker::PrimKind::U64); line = 0; col = 0 }
}

#test
fn lwt_lowers_str_len_reads_the_fat_length_with_no_memory_traffic() {
    var text = lwt_lower_expr_text(lwt_len_field(lwt_strlit("hello")))
    teko::assert::str_contains(text, "%1 = const 5")
    teko::assert::is_true(!teko::str::contains(text, "load."))
}

fn lwt_index_of(recv: checker::TExpr, index: checker::TExpr, et: @Type()): checker::TExpr {
    checker::TExpr { kind = checker::TIndex { receiver = recv; index = index }; type = et; line = 0; col = 0 }
}

const LWT_STR_INDEX_GUARDED_BYTE_CAST_LIR: str = "rodata .Lstr0: [97, 98, 99]\nfunc @t(): i64 {\n  #B0:\n    %0 = global_addr @.Lstr0\n    %1 = const 3\n    %2 = const 0\n    %3 = const 0\n    %4 = const 0\n    %5 = icmpltu %2, %1\n    branch %5, #B1(), #B2()\n  #B1:\n    %6 = field_addr %0, 0\n    %7 = load.i8 %6\n  #B2:\n    call @tk_panic_oob_at(%3, %4)\n    jump #B2()\n}\n"

#test
fn lwt_lowers_str_index_guards_then_loads_the_byte_off_rodata() {
    var ix = lwt_index_of(lwt_strlit("abc"), lwt_num_i64(0), checker::Byte { })
    var text = lwt_lower_expr_text(lwt_cast(ix, checker::PrimKind::I32))
    teko::assert::is_true(text == LWT_STR_INDEX_GUARDED_BYTE_CAST_LIR)
    teko::assert::str_contains(text, "rodata .Lstr0: [97, 98, 99]")
    teko::assert::str_contains(text, "global_addr @.Lstr0")
    teko::assert::str_contains(text, "icmpltu %2, %1")
    teko::assert::str_contains(text, "branch %5, #B1(), #B2()")
    teko::assert::str_contains(text, "call @tk_panic_oob_at(%3, %4)")
    teko::assert::str_contains(text, "field_addr %0, 0")
    teko::assert::str_contains(text, "load.i8")
    teko::assert::is_false(teko::str::contains(text, "zext"))
    teko::assert::is_false(teko::str::contains(text, "sext"))
    teko::assert::is_false(teko::str::contains(text, "trunc"))
}

const LWT_STR_INDEX_DYNAMIC_GUARDED_LIR: str = "rodata .Lstr0: [97, 98, 99]\nfunc @t(): i64 {\n  #B0:\n    %0 = global_addr @.Lstr0\n    %1 = const 3\n    %2 = const 0\n    %3 = const 0\n    %4 = iadd %2, %3\n    %5 = const 0\n    %6 = const 0\n    %7 = icmpltu %4, %1\n    branch %7, #B1(), #B2()\n  #B1:\n    %8 = const 1\n    %9 = imul %4, %8\n    %10 = iadd %0, %9\n    %11 = load.i8 %10\n  #B2:\n    call @tk_panic_oob_at(%5, %6)\n    jump #B2()\n}\n"

#test
fn lwt_lowers_str_index_with_an_unfoldable_index_guards_then_strides() {
    var sum = lwt_bin(lexer::TokenKind::Plus, lwt_num_i64(0), lwt_num_i64(0), checker::PrimKind::I64)
    var ix = lwt_index_of(lwt_strlit("abc"), sum, checker::Byte { })
    var text = lwt_lower_expr_text(lwt_cast(ix, checker::PrimKind::I32))
    teko::assert::is_true(text == LWT_STR_INDEX_DYNAMIC_GUARDED_LIR)
    teko::assert::str_contains(text, "%4 = iadd %2, %3")
    teko::assert::str_contains(text, "icmpltu %4, %1")
    teko::assert::str_contains(text, "branch %7, #B1(), #B2()")
    teko::assert::str_contains(text, "call @tk_panic_oob_at(%5, %6)")
    teko::assert::str_contains(text, "%9 = imul %4, %8")
    teko::assert::str_contains(text, "%10 = iadd %0, %9")
    teko::assert::str_contains(text, "load.i8 %10")
    teko::assert::is_false(teko::str::contains(text, "field_addr"))
}

fn lwt_interp(pieces: []str, holes: []checker::TExpr): checker::TExpr {
    var specs: []checker::TFSpec = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= holes.len { break }
        specs = teko::list::push(specs, checker::TFSpec { kind = checker::TFSpecNone { } })
        i++
    }
    checker::TExpr { kind = checker::TInterp { pieces = pieces; holes = holes; specs = specs }; type = checker::Str { }; line = 0; col = 0 }
}

#test
fn lwt_lowers_interpolation_as_nested_str_concat_calls() {
    var pieces = ["n=", ""]
    var holes = [lwt_num_i64(7)]
    var text = lwt_lower_expr_text(lwt_interp(pieces, holes))
    teko::assert::str_contains(text, "rodata .Lstr0: [110, 61]")
    teko::assert::str_contains(text, "global_addr @.Lstr0")
    teko::assert::str_contains(text, "call @tk_i64_to_str_len(")
    teko::assert::str_contains(text, "call @tk_str_concat_len(")
}

fn lwt_bare_pieces(): []str {
    ["", ""]
}

fn lwt_interp_static(hole: checker::TExpr, spec: str): checker::TExpr {
    var specs = [checker::TFSpec { kind = checker::TFSpecStatic { s = spec } }]
    var holes = [hole]
    checker::TExpr { kind = checker::TInterp { pieces = lwt_bare_pieces(); holes = holes; specs = specs }; type = checker::Str { }; line = 0; col = 0 }
}

fn lwt_interp_dynamic(hole: checker::TExpr, spec_arg: checker::TExpr): checker::TExpr {
    var args = [spec_arg]
    var specs = [checker::TFSpec { kind = checker::TFSpecDynamic { args = args } }]
    var holes = [hole]
    checker::TExpr { kind = checker::TInterp { pieces = lwt_bare_pieces(); holes = holes; specs = specs }; type = checker::Str { }; line = 0; col = 0 }
}

