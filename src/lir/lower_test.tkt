/** lwt_in_expr — `lhs in [elems]`, always bool-typed (A1-4, #382). */
fn lwt_in_expr(lhs: checker::TExpr, elems: []checker::TExpr) -> checker::TExpr {
    checker::TExpr { kind = checker::TInExpr { lhs = lhs; elems = elems }; type = lwt_prim(checker::PrimKind::Bool); line = 0; col = 0 }
}

#test
fn lwt_lowers_in_expr_as_an_eq_chain_ored_together() {
    let elems = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(1)), lwt_num_i64(2))
    let text = lwt_lower_expr_text(lwt_in_expr(lwt_num_i64(1), elems))
    teko::assert::str_contains(text, "icmpeq")
    teko::assert::str_contains(text, "ior")
}

/** lwt_named_opt_var — a `TVar` of `Named?` type — the safe-field-access receiver shape
    (A1-4, #382). */
fn lwt_named_opt_var(name: str, tname: str) -> checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = false; func_ns = "" }; type = checker::Optional { inner = checker::Named { name = tname } }; line = 0; col = 0 }
}

/** lwt_safe_field_access — `recv?.field` of resolved (unwrapped) field type `ft` — its
    `.type` is `ft` widened into `Optional` (A1-4, #382). */
fn lwt_safe_field_access(recv: checker::TExpr, field: str, ft: checker::Type) -> checker::TExpr {
    checker::TExpr { kind = checker::TSafeFieldAccess { receiver = recv; field = field }; type = checker::Optional { inner = ft }; line = 0; col = 0 }
}

#test
fn lwt_lowers_safe_field_access_via_branch_and_merge() {
    let p = lwt_named_opt_var("p", "Point")
    let sfa = lwt_safe_field_access(p, "y", lwt_prim(checker::PrimKind::I64))
    let params = teko::list::push(teko::list::empty(), lwt_param("p", "Point"))
    let body = teko::list::push(teko::list::empty(), lwt_ret(sfa))
    let f = lwt_fn("read_y_opt", "teko::demo", params, checker::Optional { inner = checker::Prim { kind = checker::PrimKind::I64 } }, body)
    let lf = match lower_function(f, lwt_one_layout(lwt_point_layout())) { LoweredFunction as r => r.func; error as err => return }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "branch %0, #B1(), #B2()")
    teko::assert::str_contains(text, "  #B1:\n    %2 = field_addr %0, 8\n    %3 = load.i64 %2\n    jump #B3(%3)")
    teko::assert::str_contains(text, "  #B2:\n    %4 = const 0\n    jump #B3(%4)")
    teko::assert::str_contains(text, "  #B3(%1):\n    ret %1")
}

/**
 * lwt_iface_call — a dynamic contract-method `TCall`
 * (`is_iface_dispatch=true`): `args[0]` is the receiver, `slot` its vtable
 * index.
 *
 * @param str iface  the contract's canonical name (the callee path's first
 *                   segment)
 * @param str method  the dispatched method's name (the callee path's second
 *                     segment)
 * @param u32 slot  the method's vtable slot
 * @param []checker::TExpr args  the call's arguments (`args[0]` is the
 *                                receiver)
 * @param checker::Type ret  the call's resolved return type
 * @return checker::TExpr  the built interface-dispatch call node
 *
 * @since #382 A1-6
 */
fn lwt_iface_call(iface: str, method: str, slot: u32, args: []checker::TExpr, ret: checker::Type) -> checker::TExpr {
    checker::TExpr {
        kind = checker::TCall {
            callee = lwt_path2(iface, method); args = args; call_ns = ""
            is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = true; iface_slot = slot
        }
        type = ret; line = 0; col = 0
    }
}

#test
fn lwt_lowers_iface_dispatch_call_via_vtable_load_and_indirect_call() {
    let recv = lwt_num_i64(1000)
    let extra = lwt_num_i64(7)
    let args = teko::list::push(teko::list::push(teko::list::empty(), recv), extra)
    let call = lwt_iface_call("Speaker", "speak", 2, args, lwt_prim(checker::PrimKind::I64))
    let text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "%0 = const 1000")
    teko::assert::str_contains(text, "%1 = field_addr %0, 0")
    teko::assert::str_contains(text, "%2 = load.ptr %1")
    teko::assert::str_contains(text, "%3 = field_addr %0, 8")
    teko::assert::str_contains(text, "%4 = load.ptr %3")
    teko::assert::str_contains(text, "%5 = field_addr %4, 16")
    teko::assert::str_contains(text, "%6 = load.ptr %5")
    teko::assert::str_contains(text, "%7 = const 7")
    teko::assert::str_contains(text, "%8 = call.indirect %6(%2, %7)")
}

#test
fn lwt_lowers_void_iface_dispatch_call_as_a_valueless_indirect_call() {
    let recv = lwt_num_i64(2000)
    let args = teko::list::push(teko::list::empty(), recv)
    let call = lwt_iface_call("Speaker", "speak", 0, args, checker::Void { })
    let text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "call.indirect %6(%2)")
    teko::assert::is_true(!teko::str::contains(text, "= call.indirect"))
}

/**
 * lwt_func_type — a resolved `Func` signature (A1-7, #382 — the type a
 * closure-typed local/expression carries).
 *
 * @param []checker::Type params  the signature's parameter types, in order
 * @param checker::Type ret  the signature's return type
 * @return checker::Type  the built `Func` type
 */
fn lwt_func_type(params: []checker::Type, ret: checker::Type) -> checker::Type {
    checker::Func { params = params; ret = ret; variadic = false; param_names = teko::list::empty(); n_required = params.len; defaults = teko::list::empty() }
}

/**
 * lwt_bind_typed — a `let` binding of an ARBITRARY resolved type `ty` (A1-7,
 * #382 — `lwt_bind` only covers a primitive-typed binding; a closure literal
 * binds at its own `Func` type).
 *
 * @param str name  the bound name
 * @param checker::TExpr e  the bound value
 * @param checker::Type ty  the binding's resolved type
 * @return checker::TStatement  the built `let` binding
 */
fn lwt_bind_typed(name: str, e: checker::TExpr, ty: checker::Type) -> checker::TStatement {
    checker::TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = name }; bound = ty; value = e }
}

/**
 * lwt_fn_value — a bare top-level function used as a VALUE
 * (`TVar.is_func=true`, A1-7, #382).
 *
 * @param str name  the referenced function's own (unqualified) name
 * @param str ns  the referenced function's declaring namespace
 * @param checker::Type ty  the reference's resolved `Func` type
 * @return checker::TExpr  the built fn-as-value node
 */
fn lwt_fn_value(name: str, ns: str, ty: checker::Type) -> checker::TExpr {
    checker::TExpr { kind = checker::TVar { name = name; is_func = true; func_ns = ns }; type = ty; line = 0; col = 0 }
}

/**
 * lwt_closure_call — a call through a LOCAL closure value
 * (`TCall.is_closure_call=true`, A1-7, #382).
 *
 * @param str name  the local closure variable's name
 * @param []checker::TExpr args  the call's arguments
 * @param checker::Type callee_ty  the closure's own resolved `Func` type
 * @param checker::Type ret  the call's resolved return type
 * @return checker::TExpr  the built closure-call node
 */
fn lwt_closure_call(name: str, args: []checker::TExpr, callee_ty: checker::Type, ret: checker::Type) -> checker::TExpr {
    checker::TExpr {
        kind = checker::TCall {
            callee = lwt_path1(name); args = args; call_ns = ""
            is_closure_call = true; callee_type = callee_ty; is_iface_dispatch = false; iface_slot = 0
        }
        type = ret; line = 0; col = 0
    }
}

#test
fn lwt_lowers_fn_value_and_closure_call_via_a_thunk() {
    let fty = lwt_func_type(teko::list::push(teko::list::push(teko::list::empty(), lwt_prim(checker::PrimKind::I64)), lwt_prim(checker::PrimKind::I64)), lwt_prim(checker::PrimKind::I64))
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lwt_fn_value("add", "teko::demo", fty), fty)))
    let cargs = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(2)), lwt_num_i64(3))
    let call = lwt_closure_call("f", cargs, fty, lwt_prim(checker::PrimKind::I64))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", teko::list::push(teko::list::empty(), call), checker::Void { }))))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "funcaddr @.Lclofn0")
    teko::assert::str_contains(text, "func @.Lclofn0(%0: ptr, %1: i64, %2: i64) -> i64 {")
    teko::assert::str_contains(text, "call @teko_teko__demo__add(%1, %2)")
    teko::assert::str_contains(text, "call.indirect")
}

/**
 * lwt_lambda_param — one declared lambda parameter (A1-7, #382).
 *
 * @param str name  the parameter's name
 * @param checker::Type ty  the parameter's resolved type
 * @return checker::TLambdaParam  the built parameter node
 */
fn lwt_lambda_param(name: str, ty: checker::Type) -> checker::TLambdaParam {
    checker::TLambdaParam { name = name; type = ty }
}

/**
 * lwt_capture — one captured (free) variable (A1-7, #382 — always by-copy;
 * `by_ref` only ever flips for a `Ref<T>`-typed capture, irrelevant to the
 * lowering's own machine-class mapping).
 *
 * @param str name  the captured variable's name
 * @param checker::Type ty  the captured variable's resolved type
 * @return checker::TCapture  the built capture node
 */
fn lwt_capture(name: str, ty: checker::Type) -> checker::TCapture {
    checker::TCapture { name = name; type = ty; by_ref = false }
}

/**
 * lwt_lambda_types — the resolved type of each declared lambda parameter, in
 * order (A1-7, #382 — feeds `lwt_func_type` so a lambda literal's own `Func`
 * type matches its declared parameters).
 *
 * @param []checker::TLambdaParam params  the lambda's declared parameters
 * @return []checker::Type  each parameter's resolved type, in order
 */
fn lwt_lambda_types(params: []checker::TLambdaParam) -> []checker::Type {
    mut out: []checker::Type = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= params.len { break }
        out = teko::list::push(out, params[i].type)
        i++
    }
    out
}

/**
 * lwt_lambda — a closure LITERAL node (`TLambda`, A1-7, #382).
 *
 * @param []checker::TLambdaParam params  the lambda's declared parameters
 * @param []checker::TStatement body  the lambda's body statements
 * @param []checker::TCapture captures  the lambda's captured-variable list
 * @param checker::Type ret  the lambda's resolved return type
 * @return checker::TExpr  the built lambda-literal node
 */
fn lwt_lambda(params: []checker::TLambdaParam, body: []checker::TStatement, captures: []checker::TCapture, ret: checker::Type) -> checker::TExpr {
    checker::TExpr {
        kind = checker::TLambda { params = params; body = body; captures = captures; ret = ret; lift_id = 0 }
        type = lwt_func_type(lwt_lambda_types(params), ret); line = 0; col = 0
    }
}

#test
fn lwt_lowers_capturing_lambda_literal_and_closure_call() {
    let i64ty = lwt_prim(checker::PrimKind::I64)
    let lam_body = teko::list::push(teko::list::empty(), lwt_ret(lwt_bin(lexer::TokenKind::Plus, lwt_var("x", checker::PrimKind::I64), lwt_var("captured", checker::PrimKind::I64), checker::PrimKind::I64)))
    let params = teko::list::push(teko::list::empty(), lwt_lambda_param("x", i64ty))
    let captures = teko::list::push(teko::list::empty(), lwt_capture("captured", i64ty))
    let lam = lwt_lambda(params, lam_body, captures, i64ty)
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind("captured", lwt_num_i64(41), checker::PrimKind::I64)))
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lam, lam.type)))
    let call = lwt_closure_call("f", teko::list::push(teko::list::empty(), lwt_num_i64(1)), lam.type, i64ty)
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", teko::list::push(teko::list::empty(), call), checker::Void { }))))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "funcaddr @.Lclo0")
    teko::assert::str_contains(text, "func @.Lclo0(%0: ptr, %1: i64) -> i64 {")
    teko::assert::str_contains(text, "field_addr %0, 0")
    teko::assert::str_contains(text, "iadd %1,")
    teko::assert::str_contains(text, "call.indirect")
}

/**
 * lwt_lowers_defer_fires_before_a_void_lambdas_fall_through_return —
 * A1-2, #382: a bodyless-return (`void`) lambda literal `() => { let s=1;
 * defer { s = s + 100 } }` closes via `close_lambda_body`'s own
 * fall-through, which must fire the pending defer before its implicit
 * void `ret`, exactly like a `void` function's own fall-through.
 */
#test
fn lwt_lowers_defer_fires_before_a_void_lambdas_fall_through_return() {
    let s_plus_100 = lwt_bin(lexer::TokenKind::Plus, lwt_var("s", checker::PrimKind::I64), lwt_num_i64(100), checker::PrimKind::I64)
    let defer_body = teko::list::push(teko::list::empty(), lwt_simple_assign("s", lexer::TokenKind::Assign, s_plus_100, checker::PrimKind::I64))
    let lam_body = teko::list::push(teko::list::push(teko::list::empty(), lwt_bind("s", lwt_num_i64(1), checker::PrimKind::I64)), lwt_defer(defer_body))
    let lam = lwt_lambda(teko::list::empty(), lam_body, teko::list::empty(), checker::Void { })
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lam, lam.type)))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "const 100")
    teko::assert::str_contains(text, "iadd")
}

/**
 * lwt_interp_runs_function_trailing_expression_as_return_value — #421, the
 * interp-oracle side: `fn f() -> i32 { 42 }` (no explicit `return`) lowered
 * via `lower_function` and run through `interp_lmodule` yields exit code 42
 * — before the fix the fall-through body closed with a valueless `ret`, so
 * the interp's `is_return` outcome carried 0, not 42.
 *
 * IT ADDRESSES THE FUNCTION THROUGH `mangle_fn_symbol`, NOT BY THE BARE NAME, and that is not
 * ceremony. `lower_function` keys the emitted function by the MANGLED symbol, so a literal `"f"`
 * stops resolving the moment the mangler moves — which is exactly what the `teko_*` user prefix
 * did. Computing the address from the mangler is not tautological here: the SUBJECT of this test
 * is the interpreter's return value, and the symbol is only how the function is reached.
 */
#test
fn lwt_interp_runs_function_trailing_expression_as_return_value() {
    let body = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_num(42, checker::PrimKind::I32)))
    let f = lwt_fn("f", "", teko::list::empty(), checker::Prim { kind = checker::PrimKind::I32 }, body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => return }
    let m = add_func(empty_module(), lf)
    teko::assert::is_true(interp_lmodule(m, mangle_fn_symbol("", "f"), teko::list::empty()) == (42))
}

/**
 * lwt_lowers_continue_jumps_back_to_the_loop_head — A1-2, #382:
 * `loop { continue }` — the continue is the body's only statement,
 * terminating the head block with a self-jump back to itself (`#B1: jump
 * #B1()`), exercising `lower_continue`'s target-head resolution separately
 * from `lower_break`'s target-exit one.
 */
#test
fn lwt_lowers_continue_jumps_back_to_the_loop_head() {
    let body = teko::list::push(teko::list::empty(), lwt_loop("", teko::list::push(teko::list::empty(), lwt_continue(""))))
    let f = lwt_fn("k", "teko::demo", teko::list::empty(), checker::Void { }, body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => return }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    jump #B1()")
}

/**
 * lwt_defer_inside_else_arm_fires_only_on_that_arms_own_branch — PR #553
 * follow-up nit, UPDATED for #389 F1b item 1: the ELSE-arm mirror of
 * `lwt_defer_inside_if_arm_fires_only_on_that_arms_own_branch`: `let s=1; if
 * x>0 { } else { defer { s = s + 100 } }; return s` — the `defer` registers
 * ONLY inside the ELSE arm, never the empty THEN arm. The THEN arm (`#B1`,
 * empty) jumps its own untouched `s` straight to the merge, `#B3(%1)`; the
 * ELSE arm (`#B2`) fires the defer — LIFO, from the defer-delta base THIS arm
 * itself started at — as part of ITS OWN close, then jumps its POST-defer `s`,
 * `#B3(%6)` (`%6 = iadd %1, %5`), `close_arm_replaying_defers` re-sampling the
 * scalar arg from its post-replay env. `s` is THREADED as the merge param
 * `#B3(%4)` and the tail reads it, `ret %4` — proving the ELSE arm's defer
 * write reaches the merge (F1b's `TDeferStmt` descent scopes EITHER arm
 * identically, not just the THEN side). Before F1b the merge carried ZERO
 * params and the tail read the STALE pre-defer `s` (`ret %1`) — the OLD golden
 * shape encoded that same-class silent merge-drop; the defer is still never
 * replayed a second time at the merge (its original PR #553 scope fix).
 *
 * @return void
 */
#test
fn lwt_defer_inside_else_arm_fires_only_on_that_arms_own_branch() {
    let s_plus_100 = lwt_bin(lexer::TokenKind::Plus, lwt_var("s", checker::PrimKind::I64), lwt_num_i64(100), checker::PrimKind::I64)
    let defer_body = teko::list::push(teko::list::empty(), lwt_simple_assign("s", lexer::TokenKind::Assign, s_plus_100, checker::PrimKind::I64))
    let cond = lwt_cmp(lwt_var("x", checker::PrimKind::I64), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::Gt, lwt_num_i64(0))))
    let else_blk = teko::list::push(teko::list::empty(), lwt_defer(defer_body))
    let ifstmt = lwt_if_stmt(cond, teko::list::empty(), true, else_blk)
    let tail_ret = lwt_ret(lwt_var("s", checker::PrimKind::I64))
    let body = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), lwt_bind("s", lwt_num_i64(1), checker::PrimKind::I64)), lwt_exprstmt(ifstmt)), tail_ret)
    let params = teko::list::push(teko::list::empty(), lwt_param("x", "i64"))
    let f = lwt_fn("else_arm_scoped", "teko::demo", params, checker::Prim { kind = checker::PrimKind::I64 }, body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => return }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    jump #B3(%1)")
    teko::assert::str_contains(text, "  #B2:\n    %5 = const 100\n    %6 = iadd %1, %5\n    jump #B3(%6)")
    teko::assert::str_contains(text, "  #B3(%4):\n    ret %4\n}")
}

/**
 * lwt_lowers_loop_leaves_a_fat_local_unpromoted — A1-2, #382: `let s = "hi";
 * loop { break }; exit(s.len)` — `s` is the ONLY name live at the loop's
 * entry, but it is a FAT (str) binding, so `promote_env` leaves it
 * UNPROMOTED: both the head and exit blocks stay zero-arg, and `s.len`
 * still resolves with NO memory traffic (the fat length VReg threads
 * through the loop untouched, exactly as it was before it).
 */
#test
fn lwt_lowers_loop_leaves_a_fat_local_unpromoted() {
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("s", lwt_strlit("hi"), checker::Str { })))
    items = teko::list::push(items, lwt_item(lwt_loop("", teko::list::push(teko::list::empty(), lwt_break("")))))
    let len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::I64))
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_call(lwt_path1("exit"), "", teko::list::push(teko::list::empty(), len_access), checker::Void { }))))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "%1 = const 2")
    teko::assert::str_contains(text, "    jump #B1()\n  #B1:\n    jump #B2()\n  #B2:\n    call @tk_exit(%1)")
}

#test
/**
 * lwt_fat_local_reassign_honest_stops_on_later_fat_use — #389 F1b item 3
 * review finding 1: `let s = "hello"; s = "hi"; return s.len` must HONEST-STOP,
 * NOT silently return the STALE pre-reassignment length. `lower_assign_simple`'s
 * `=` path always lowers the RHS through the plain (scalar) `lower_expr`, so a
 * reassignment of a fat-typed name only ever supplies a fresh PTR VReg, never a
 * fresh length — `lenv_reassign` must therefore NEVER update a fat binding's
 * `vregs` slot in place (that would pair the NEW ptr with the OLD `len_vregs`
 * entry, a silent stale-length miscompile); it falls back to the pre-item3
 * append (a fresh SCALAR entry, `has_len=false`), so `lenv_lookup_fat`'s
 * newest-first scan for `s` hits that scalar entry and reports `has_len=false`,
 * and `lower_len_field` -> `lower_fat_expr` -> `lower_var_fat` honest-stops with
 * the SAME NAMED error a fat reassignment produced before item-3 ever touched
 * `lenv_reassign` — refusing the program instead of returning a wrong answer.
 *
 * @return void
 */
fn lwt_fat_local_reassign_honest_stops_on_later_fat_use() {
    let s_bind = lwt_bind_typed("s", lwt_strlit("hello"), checker::Str { })
    let reassign = lwt_simple_assign("s", lexer::TokenKind::Assign, lwt_strlit("hi"), checker::PrimKind::I64)
    let len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::U64))
    let body = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), s_bind), reassign), lwt_ret(len_access))
    let f = lwt_fn("fat_reassign_then_len", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let out = match lower_function(f) { LoweredFunction => "ok"; error as e => e.message }
    teko::assert::str_contains(out, "`s` is not a fat-pointer local")
}

/** lwt_slice_param — a `[]<elem_tname>`-typed `parser::Param` (the fat-parameter
    counterpart of `lwt_param`, which only builds a `NamedType` — a fat parameter's
    annotation is `parser::SliceType`, per `typeexpr_is_fat`). */
fn lwt_slice_param(name: str, elem_tname: str) -> parser::Param {
    parser::Param { name = name; has_type = true; type_ann = parser::SliceType { element = lwt_named_te(elem_tname) }; is_params = false; has_default = false; default_expr = parser::no_expr() }
}

/**
 * lwt_lowers_str_param_len_reads_the_fat_length_with_no_memory_traffic — the
 * degrau-4 regression: `fn f(s: str) -> u64 { return s.len }` used to
 * HONEST-STOP with "`s` is not a fat-pointer local (internal)" because
 * `lower_function` bound EVERY parameter through the scalar `lenv_bind` — a
 * `str`/`[]T` parameter carried only its PTR half into the env, so `s.len`
 * could never resolve. A fat-typed parameter now binds through
 * `bind_fat_param`/`lenv_bind_fat` with BOTH its ptr (VReg 0) and len (VReg 1)
 * incoming registers, so `.len` reads the length register directly — the
 * SAME "no memory traffic" proof `lwt_lowers_str_len_reads_the_fat_length_with_no_memory_traffic`
 * pins for a fat `let` local, but here for the PARAMETER path.
 *
 * @return void
 */
#test
fn lwt_lowers_str_param_len_reads_the_fat_length_with_no_memory_traffic() {
    let params = teko::list::push(teko::list::empty(), lwt_param("s", "str"))
    let len_access = lwt_field_access(lwt_typed_var("s", checker::Str { }), "len", lwt_prim(checker::PrimKind::U64))
    let body = teko::list::push(teko::list::empty(), lwt_ret(len_access))
    let f = lwt_fn("str_param_len", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "(%0: ptr, %1: i64) -> i64")
    teko::assert::str_contains(text, "%0 = param 0")
    teko::assert::str_contains(text, "%1 = param 1")
    teko::assert::str_contains(text, "ret %1")
    teko::assert::is_true(!teko::str::contains(text, "load."))
}

/**
 * lwt_lowers_slice_param_len_reads_the_fat_length_with_no_memory_traffic — the
 * `[]T` sibling of the `str` param fixture above: a `[]i64` parameter ALSO
 * binds fat (ptr@0, len@1) and `.len` resolves with no memory traffic.
 *
 * @return void
 */
#test
fn lwt_lowers_slice_param_len_reads_the_fat_length_with_no_memory_traffic() {
    let params = teko::list::push(teko::list::empty(), lwt_slice_param("xs", "i64"))
    let len_access = lwt_field_access(lwt_typed_var("xs", checker::Slice { element = lwt_prim(checker::PrimKind::I64) }), "len", lwt_prim(checker::PrimKind::U64))
    let body = teko::list::push(teko::list::empty(), lwt_ret(len_access))
    let f = lwt_fn("slice_param_len", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "(%0: ptr, %1: i64) -> i64")
    teko::assert::str_contains(text, "ret %1")
    teko::assert::is_true(!teko::str::contains(text, "load."))
}

/**
 * lwt_calling_a_str_param_forwards_both_ptr_and_len — the CALL-SITE half of the
 * degrau-4 fix: a function that just forwards its own `str` parameter as an
 * argument to another Teko function must push BOTH the ptr and the len
 * VReg — a caller/callee arity mismatch on a fat argument is not a compile
 * error, it is a garbage length silently read at the callee. `lower_args_from`
 * (via `lower_arg_vregs`) now flattens a fat argument into its (ptr, len) pair,
 * matching `bind_fat_param`'s receiving-end contract exactly.
 *
 * @return void
 */
#test
fn lwt_calling_a_str_param_forwards_both_ptr_and_len() {
    let params = teko::list::push(teko::list::empty(), lwt_param("s", "str"))
    let forward = lwt_call(lwt_path1("take"), "teko::demo", teko::list::push(teko::list::empty(), lwt_typed_var("s", checker::Str { })), lwt_prim(checker::PrimKind::U64))
    let body = teko::list::push(teko::list::empty(), lwt_ret(forward))
    let f = lwt_fn("forward_str_param", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "call @teko_teko__demo__take(%0, %1)")
}

/**
 * lwt_if_value_typed — a value-producing `TIfExpr` node of an ARBITRARY resolved type `ty`
 * (the fat-typed counterpart of `lwt_if_value`, which only covers a `PrimKind` result —
 * degrau 5, cargo/20-degrau5-if-gordo).
 *
 * @param cond      the if's condition
 * @param then_blk  the then-arm's statement block
 * @param else_blk  the else-arm's statement block
 * @param ty        the if-expression's resolved type
 * @return          the built value-producing `TIfExpr` node (always has an else)
 */
fn lwt_if_value_typed(cond: checker::TExpr, then_blk: []checker::TStatement, else_blk: []checker::TStatement, ty: checker::Type) -> checker::TExpr {
    checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = true; else_blk = else_blk }; type = ty; line = 0; col = 0 }
}

/**
 * lwt_lowers_str_if_value_merges_both_ptr_and_len_at_the_fat_merge — the degrau-5 proof at
 * the LIR level: `let s = if cond { "a" } else { "bb" }; return s.len` used to HONEST-STOP
 * with "fat-pointer receiver `if-expression` not yet lowered (N2)" because `lower_fat_expr`'s
 * closed producer set had no `if`-expression arm. `lower_if_fat` now merges BOTH the ptr and
 * the len through a two-block-param merge (`#B3(%3, %4)`, ptr FIRST then len). A merge that
 * only carried the ptr would still COMPILE (the checker cannot see a fat-pointer ABI
 * mismatch) and silently read a garbage length past the binding — exactly the failure mode
 * no compile-only test catches, so this fixture asserts each arm's OWN literal length
 * ("a" -> 1, "bb" -> 2) reaches the merge's SECOND param, and that `s.len` past the binding
 * reads that merge param directly, with no memory traffic.
 *
 * @return void
 */
#test
fn lwt_lowers_str_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("a")))
    let else_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("bb")))
    let if_str = lwt_if_value_typed(cond, then_blk, else_blk, checker::Str { })
    let s_bind = lwt_bind_typed("s", if_str, checker::Str { })
    let len_access = lwt_len_field(lwt_typed_var("s", checker::Str { }))
    let body = teko::list::push(teko::list::push(teko::list::empty(), s_bind), lwt_ret(len_access))
    let f = lwt_fn("str_if_value", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "rodata .Lstr0: [97]")
    teko::assert::str_contains(text, "rodata .Lstr1: [98, 98]")
    teko::assert::str_contains(text, "  #B1:\n    %5 = global_addr @.Lstr0\n    %6 = const 1\n    jump #B3(%5, %6)")
    teko::assert::str_contains(text, "  #B2:\n    %7 = global_addr @.Lstr1\n    %8 = const 2\n    jump #B3(%7, %8)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

/**
 * lwt_lowers_slice_if_value_merges_both_ptr_and_len_at_the_fat_merge — the `[]T` sibling of
 * the `str` fixture above: `let xs = if cond { [10] } else { [20, 30] }; return xs.len` also
 * merges through a two-param fat merge, each arm's OWN element count (1 vs 2) reaching the
 * merge's SECOND param — the array-literal producer's own alloca+store sequence is unchanged
 * (`lower_array_lit_fat`'s doc), only the `if`-merge threading is new (degrau 5).
 *
 * @return void
 */
#test
fn lwt_lowers_slice_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))))
    let one_elem = teko::list::push(teko::list::empty(), lwt_num_i64(10))
    let two_elems = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(20)), lwt_num_i64(30))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_array_lit(one_elem, checker::PrimKind::I64)))
    let else_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_array_lit(two_elems, checker::PrimKind::I64)))
    let slice_ty = checker::Slice { element = lwt_prim(checker::PrimKind::I64) }
    let if_slice = lwt_if_value_typed(cond, then_blk, else_blk, slice_ty)
    let xs_bind = lwt_bind_typed("xs", if_slice, slice_ty)
    let len_access = lwt_len_field(lwt_typed_var("xs", slice_ty))
    let body = teko::list::push(teko::list::push(teko::list::empty(), xs_bind), lwt_ret(len_access))
    let f = lwt_fn("slice_if_value", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    %5 = alloca 8, align 8\n    %6 = const 10\n    %7 = field_addr %5, 0\n    store.i64 %7, %6\n    %8 = const 8\n    %9 = call @tk_slice_elem_box(%5, %8)\n    %10 = const 1\n    jump #B3(%9, %10)")
    teko::assert::str_contains(text, "%11 = alloca 16, align 8")
    teko::assert::str_contains(text, "%18 = const 2\n    jump #B3(%17, %18)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

/**
 * lwt_honest_stop_on_fat_if_without_else_as_a_value — the FAT-value mirror of
 * `lwt_honest_stop_on_if_without_else_as_a_value`: an `if` with no `else` used as a fat
 * (`str`/`[]T`) value is out of the N1 subset exactly like its scalar sibling — `lower_if_fat`
 * honest-stops before touching any block/merge machinery (degrau 5).
 *
 * @return void
 */
#test
fn lwt_honest_stop_on_fat_if_without_else_as_a_value() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::Lt, lwt_num_i64(2))))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("a")))
    let ifexpr = checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = then_blk }; type = checker::Str { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(lwt_len_field(ifexpr)), "if-without-else used as a fat value not yet lowered")
}

/**
 * lwt_lowers_str_returning_function_stores_length_through_hidden_out_slot — the call-gordo
 * degrau's CALLEE-side proof: a `fn` declared `-> str` reserves ONE hidden TRAILING parameter
 * register past its (zero, here) declared ones (`%0 = param 0`), and its `return "hi"` stores
 * the literal's length (2) through that slot (`store.i64 %0, %2`) before the ordinary
 * single-VReg `LRet` carries the ptr half (`ret %1`) — `bind_ret_len_slot`'s own contract.
 *
 * @return void
 */
#test
fn lwt_lowers_str_returning_function_stores_length_through_hidden_out_slot() {
    let body = teko::list::push(teko::list::empty(), lwt_ret(lwt_strlit("hi")))
    let f = lwt_fn("make_str", "teko::demo", teko::list::empty(), checker::Str { }, body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "func @teko_teko__demo__make_str(%0: ptr) -> ptr {")
    teko::assert::str_contains(text, "%0 = param 0")
    teko::assert::str_contains(text, "%1 = global_addr @.Lstr0")
    teko::assert::str_contains(text, "%2 = const 2")
    teko::assert::str_contains(text, "store.i64 %0, %2")
    teko::assert::str_contains(text, "ret %1")
}

/**
 * lwt_lowers_str_call_result_allocates_out_slot_and_loads_the_length_back — the call-gordo
 * degrau's CALLER-side proof: `make_str().len` (a direct `TCall` receiver `lower_fat_expr`
 * previously honest-stopped on, "fat-pointer receiver `call` not yet lowered") now allocates
 * an 8-byte out-slot (`%0 = alloca 8, align 8`), passes its address as the call's ONE (here,
 * only) argument (`%1 = call @teko_teko__demo__make_str(%0)`), and loads the length back out
 * of it afterward (`%2 = load.i64 %0`) — `lower_call_fat`'s own caller-side contract, the
 * mirror of the callee-side fixture above.
 *
 * @return void
 */
#test
fn lwt_lowers_str_call_result_allocates_out_slot_and_loads_the_length_back() {
    let call = lwt_call(lwt_path1("make_str"), "teko::demo", teko::list::empty(), checker::Str { })
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "%0 = alloca 8, align 8")
    teko::assert::str_contains(text, "%1 = call @teko_teko__demo__make_str(%0)")
    teko::assert::str_contains(text, "%2 = load.i64 %0")
}

/**
 * lwt_lowers_fat_closure_call_result_with_hidden_out_slot — a closure-call whose result is fat
 * now lowers through the same hidden out-slot caller contract as direct fat calls: the call site
 * allocates an 8-byte slot, passes it as the trailing argument to `call.indirect`, then loads
 * the length back (`load.i64`) for the surrounding `.len` read.
 *
 * @return void
 */
#test
fn lwt_lowers_fat_closure_call_result_with_hidden_out_slot() {
    let fty = lwt_func_type(teko::list::empty(), checker::Str { })
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lwt_fn_value("make_str", "teko::demo", fty), fty)))
    let call = lwt_closure_call("f", teko::list::empty(), fty, checker::Str { })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_len_field(call))))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "func @.Lclofn0(%0: ptr, %1: ptr) -> ptr {")
    teko::assert::str_contains(text, "call @teko_teko__demo__make_str(%1)")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "call.indirect")
    teko::assert::str_contains(text, "load.i64")
}

/**
 * lwt_honest_stop_on_fat_iface_dispatch_result — the interface-dispatch sibling of
 * `lwt_honest_stop_on_fat_closure_call_result`: a vtable-dispatched method whose result is fat
 * also honest-stops by name instead of mismatching the callee-side hidden-slot convention
 * (call-gordo degrau, #382 N2).
 *
 * @return void
 */
#test
fn lwt_honest_stop_on_fat_iface_dispatch_result() {
    let recv = lwt_num_i64(1)
    let call = lwt_iface_call("Speaker", "speak", 0, teko::list::push(teko::list::empty(), recv), checker::Str { })
    teko::assert::str_contains(lwt_lower_expr_text(call), "fat-pointer interface-dispatch result not yet lowered")
}

/**
 * lwt_slice_of — a `[]T` slice type over the primitive kind `k` (the list-builtin fixtures'
 * element type).
 *
 * @param k  the element's primitive kind
 * @return   the `[]k` slice type
 */
fn lwt_slice_of(k: checker::PrimKind) -> checker::Type { checker::Slice { element = lwt_prim(k) } }

/**
 * lwt_list_empty_call — a `teko::list::empty()` builtin call node typed as `[]k` (the checker
 * CONCRETIZES a sentinel base to the result element type before the backend ever sees it).
 *
 * @param k  the element's primitive kind
 * @return   the typed `empty()` call
 */
fn lwt_list_empty_call(k: checker::PrimKind) -> checker::TExpr {
    lwt_call(lwt_path2("list", "empty"), "", teko::list::empty(), lwt_slice_of(k))
}

/**
 * lwt_push_call — a growth-builtin call node `<ns>::<name>(base, item)` typed as `[]k`, the shape
 * `type_list_builtin` leaves behind for `teko::list::push` and `teko::mem::push_fo`.
 *
 * @param ns    the callee path's namespace segment (`list` or `mem`)
 * @param name  the callee path's last segment (`push` or `push_fo`)
 * @param base  the base slice argument
 * @param item  the pushed item argument
 * @param k     the element's primitive kind
 * @return      the typed push call
 */
fn lwt_push_call(ns: str, name: str, base: checker::TExpr, item: checker::TExpr, k: checker::PrimKind) -> checker::TExpr {
    let args = teko::list::push(teko::list::push(teko::list::empty(), base), item)
    lwt_call(lwt_path2(ns, name), "", args, lwt_slice_of(k))
}

/**
 * lwt_lowers_list_push_to_the_runtime_grow — `teko::list::push(empty(), 7)` lowers to the runtime's
 * amortized grow: the empty base is the (null, 0) constant pair, the item is stored into its own
 * frame slot, and `tk_slice_push` is called with `(ptr, len, &item, sizeof, &out_len)`, the length
 * arriving through the out-slot rather than through this backend's Teko-only hidden return register
 * (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_list_push_to_the_runtime_grow() {
    let base = lwt_list_empty_call(checker::PrimKind::I64)
    let call = lwt_push_call("list", "push", base, lwt_num_i64(7), checker::PrimKind::I64)
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "call @tk_slice_push(")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "store.i64")
    teko::assert::str_contains(text, "load.i64")
}

/**
 * lwt_lowers_push_fo_to_the_free_old_grow — the `teko::mem::push_fo` DECREE targets the
 * free-old-on-grow runtime entry, not the plain one: the two spellings must never collapse onto one
 * symbol, since only the decreed chain may park its superseded buffer (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_push_fo_to_the_free_old_grow() {
    let base = lwt_list_empty_call(checker::PrimKind::I64)
    let call = lwt_push_call("mem", "push_fo", base, lwt_num_i64(7), checker::PrimKind::I64)
    teko::assert::str_contains(lwt_lower_expr_text(lwt_len_field(call)), "call @tk_slice_push_fo(")
}

/**
 * lwt_lowers_list_push_element_size_from_the_element_class — the `sizeof` operand is the ELEMENT's
 * machine width, not the register width the item happens to be lowered into: a `[]u32` push stores
 * 4 bytes and tells the runtime 4, so the buffer the index load walks with a 4-byte stride agrees
 * with the buffer the grow wrote (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_list_push_element_size_from_the_element_class() {
    let base = lwt_list_empty_call(checker::PrimKind::U32)
    let call = lwt_push_call("list", "push", base, lwt_num(7, checker::PrimKind::U32), checker::PrimKind::U32)
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "alloca 4, align 4")
    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "const 4")
}

/**
 * lwt_lowers_list_empty_to_a_null_pair — a bare `teko::list::empty()` needs no runtime call and no
 * element type: its (ptr, len) pair is two zero constants, so `empty().len` folds to `const 0` with
 * no memory traffic at all (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_list_empty_to_a_null_pair() {
    let text = lwt_lower_expr_text(lwt_len_field(lwt_list_empty_call(checker::PrimKind::I64)))
    teko::assert::str_contains(text, "const 0")
    teko::assert::is_true(!teko::str::contains(text, "call @"))
}

/**
 * lwt_aggregate_push_call — the `teko::list::push(empty(), p)` fixture whose ELEMENT is the nominal
 * type `tname`, read through `.len` so the whole fat lowering runs (0.3.1.0 degrau 4).
 *
 * @param tname  the nominal element type's name
 * @return       the push call's `.len` field access, ready to lower
 */
fn lwt_aggregate_push_call(tname: str) -> checker::TExpr {
    let p_slice = checker::Slice { element = checker::Named { name = tname } }
    let base = lwt_call(lwt_path2("list", "empty"), "", teko::list::empty(), p_slice)
    let names = teko::list::push(teko::list::push(teko::list::empty(), "x"), "y")
    let vals = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(1)), lwt_num_i64(2))
    let args = teko::list::push(teko::list::push(teko::list::empty(), base), lwt_struct_init(tname, names, vals))
    lwt_len_field(lwt_call(lwt_path2("list", "push"), "", args, p_slice))
}

/**
 * lwt_boxes_an_aggregate_element_push — a push whose element is a `struct`/`class` instance copies
 * the instance into FRESH per-execution storage and pushes THAT address
 * (NATIVE-AGG-SLICE-BY-ADDRESS, 0.3.1.0 degrau 4). This backend's value for an aggregate is the
 * address of an `alloca` — one frame slot per INSTRUCTION — so pushing it as-is would make
 * `loop { out = push(out, T { … }) }` read back as N copies of the last item. The boxed width is
 * the element's REGISTERED LAYOUT size (16 for the two-`i64` `Point`), and the slice element itself
 * stays one 8-byte address, which is what the array-literal store and the index load already agree on.
 *
 * @return void
 */
#test
fn lwt_boxes_an_aggregate_element_push() {
    let text = lwt_lower_expr_text_with(lwt_aggregate_push_call("Point"), lwt_one_layout(lwt_point_layout()))
    teko::assert::str_contains(text, "const 16")
    teko::assert::str_contains(text, "call @tk_slice_elem_box(")
    teko::assert::str_contains(text, "call @tk_slice_push(")
    teko::assert::str_contains(text, "const 8")
}

/**
 * lwt_honest_stop_on_unsized_aggregate_element_push — the stop degrau 4 NARROWED rather than
 * removed: an aggregate the backend can pin no whole-type byte width for (here a nominal with no
 * registered layout) still stops by name, because the box's width is what makes the copy correct.
 *
 * @return void
 */
#test
fn lwt_honest_stop_on_unsized_aggregate_element_push() {
    let text = lwt_lower_expr_text(lwt_aggregate_push_call("P"))
    teko::assert::str_contains(text, "no registered layout")
    teko::assert::str_contains(text, "boxes each pushed item into fresh storage")
}

/**
 * lwt_lowers_fat_element_push_at_the_two_word_stride — a push onto `[]str` (0.3.1.0 raiz-comum §6
 * R4, closing the degrau 10 stop this test used to assert by name): the pushed item's `{ptr, len}`
 * pair is stored BY VALUE into a 16-byte item slot (`fat_slot_bytes()`, the SAME shape a mutable
 * fat local's own frame slot uses), and the runtime grow's `sizeof` argument is 16 — the two-word
 * stride the array literal's store and the index load also use now, so the three sites the honest
 * stop used to name can never disagree about the number again.
 *
 * @return void
 */
#test
fn lwt_lowers_fat_element_push_at_the_two_word_stride() {
    let str_slice = checker::Slice { element = checker::Str { } }
    let base = lwt_call(lwt_path2("list", "empty"), "", teko::list::empty(), str_slice)
    let args = teko::list::push(teko::list::push(teko::list::empty(), base), lwt_strlit("hi"))
    let call = lwt_call(lwt_path2("list", "push"), "", args, str_slice)
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "alloca 16, align 8")
    teko::assert::str_contains(text, "const 16")
    teko::assert::str_contains(text, "call @tk_slice_push(")
}

/**
 * lwt_honest_stop_on_break_outside_a_loop — a bare `break` with no
 * enclosing `loop` on its lowering path is a checker invariant break
 * (M.1) — `find_loop_target` honest-stops by name rather than resolving
 * to a bogus target (A1-2, #382).
 */
#test
fn lwt_honest_stop_on_break_outside_a_loop() {
    let body = teko::list::push(teko::list::empty(), lwt_break(""))
    let f = lwt_fn("stray_break", "teko::demo", teko::list::empty(), checker::Void { }, body)
    let out = match lower_function(f) { LoweredFunction => "ok"; error as e => e.message }
    teko::assert::str_contains(out, "break/continue outside a loop")
}

/**
 * lwt_honest_stop_on_continue_outside_a_loop — the same invariant guard as
 * `lwt_honest_stop_on_break_outside_a_loop`, exercised through
 * `lower_continue`'s own call site (A1-2, #382).
 */
#test
fn lwt_honest_stop_on_continue_outside_a_loop() {
    let body = teko::list::push(teko::list::empty(), lwt_continue(""))
    let f = lwt_fn("stray_continue", "teko::demo", teko::list::empty(), checker::Void { }, body)
    let out = match lower_function(f) { LoweredFunction => "ok"; error as e => e.message }
    teko::assert::str_contains(out, "break/continue outside a loop")
}

/** lwt_field — one `struct` field: `name: <tname>`, an all-public struct field (#414, #382). */
fn lwt_field(name: str, tname: str) -> parser::Field {
    parser::Field { name = name; type_ann = lwt_named_te(tname); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
}

/** lwt_struct_decl — a `struct <name> { <fields> }` TypeDecl, wrapped as a `checker::TItem`
    (#414, #382). */
fn lwt_struct_decl(name: str, fields: []parser::Field) -> checker::TItem {
    parser::TypeDecl {
        name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }
        vis = parser::Visibility::Pub; has_doc = false; doc = ""
        line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""
        is_unsafe = false; must_free = false
    }
}

/**
 * lwt_two_fields — a two-element `[]parser::Field` list, in order (#414, #382).
 *
 * @param parser::Field a  the first field
 * @param parser::Field b  the second field
 * @return []parser::Field  `[a, b]`
 */
fn lwt_two_fields(a: parser::Field, b: parser::Field) -> []parser::Field {
    teko::list::push(teko::list::push(teko::list::empty(), a), b)
}

/**
 * lwt_three_fields — a three-element `[]parser::Field` list, in order (#414, #382).
 *
 * @param parser::Field a  the first field
 * @param parser::Field b  the second field
 * @param parser::Field c  the third field
 * @return []parser::Field  `[a, b, c]`
 */
fn lwt_three_fields(a: parser::Field, b: parser::Field, c: parser::Field) -> []parser::Field {
    teko::list::push(lwt_two_fields(a, b), c)
}

/**
 * lwt_nested_struct_layout_program — `struct Point { x: i64; y: i64 }` (declared
 * first, so its layout is already KNOWN) followed by `struct Line { a: byte; p:
 * Point; c: byte }`, whose middle field is Point BY VALUE (#414, #382).
 *
 * @return checker::TProgram  the two-struct program
 */
fn lwt_nested_struct_layout_program() -> checker::TProgram {
    let point = lwt_struct_decl("Point", lwt_two_fields(lwt_field("x", "i64"), lwt_field("y", "i64")))
    let line = lwt_struct_decl("Line", lwt_three_fields(lwt_field("a", "byte"), lwt_field("p", "Point"), lwt_field("c", "byte")))
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, point)
    items = teko::list::push(items, line)
    checker::TProgram { items = items }
}

/**
 * nested_struct_by_value_field_layout_accounts_for_the_inner_structs_real_width
 * — #414, #382: `Line`'s middle field `p: Point` (a struct BY VALUE, size 16
 * align 8) must widen `Line` to size 32 (`a`@0 padded to 8 for `p`, `p`@8
 * spans its own 16 bytes, `c`@24 padded to the struct's own 8-byte
 * alignment) — the OLD `ltype_of_typeexpr`-only mapping collapsed `p` to a
 * bare `Ptr` (8 bytes), under-sizing `Line` to 24 and misplacing `c`@16.
 */
#test
fn nested_struct_by_value_field_layout_accounts_for_the_inner_structs_real_width() {
    let m = match lower_program(lwt_nested_struct_layout_program()) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Point: size=16 align=8 {x@0, y@8}")
    teko::assert::str_contains(text, "layout Line: size=32 align=8 {a@0, p@8, c@24}")
}

/**
 * lwt_enum_decl — an `enum <name> { <members> }` TypeDecl, wrapped as a `checker::TItem`: the
 * enum counterpart of `lwt_struct_decl`, so a layout assertion can place an enum-typed FIELD
 * next to scalar fields and read the carrier width straight off the offsets.
 *
 * @param name     the enum's declared name
 * @param members  the member spellings, in declared (ordinal) order
 * @return         the declaration, as a typed top-level item
 * @since #594 T-B (the enum carrier)
 */
fn lwt_enum_decl(name: str, members: []str) -> checker::TItem {
    parser::TypeDecl {
        name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        body = parser::EnumBody { members = members }
        vis = parser::Visibility::Pub; has_doc = false; doc = ""
        line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""
        is_unsafe = false; must_free = false
    }
}

/**
 * lwt_two_members — a two-element `[]str` member list, in order.
 *
 * @param a  the first member spelling
 * @param b  the second member spelling
 * @return   `[a, b]`
 * @since #594 T-B (the enum carrier)
 */
fn lwt_two_members(a: str, b: str) -> []str {
    teko::list::push(teko::list::push(teko::list::empty(), a), b)
}

/**
 * lwt_five_members — a five-element `[]str` member list, in order: the WIDER enum of the
 * carrier test, present to prove the carrier does NOT grow with the member count.
 *
 * @param a  the first member spelling
 * @param b  the second member spelling
 * @param c  the third member spelling
 * @param d  the fourth member spelling
 * @param e  the fifth member spelling
 * @return   `[a, b, c, d, e]`
 * @since #594 T-B (the enum carrier)
 */
fn lwt_five_members(a: str, b: str, c: str, d: str, e: str) -> []str {
    teko::list::push(teko::list::push(teko::list::push(lwt_two_members(a, b), c), d), e)
}

/**
 * lwt_enum_carrier_layout_program — the enum-carrier layout fixture, shaped to make every part
 * of the decision observable in ONE dump:
 *
 *   `enum Cls { GPR; FPR }`                         — two members
 *   `enum Wide { A; B; C; D; E }`                   — five members, same carrier
 *   `struct Reg { id: u32; cls: Cls; phys: byte }`  — the `MReg` shape of `minst.tks`
 *   `struct Both { w: Wide; big: i64 }`             — an enum ahead of an 8-aligned field
 *
 * @return the four-declaration program
 * @since #594 T-B (the enum carrier)
 */
fn lwt_enum_carrier_layout_program() -> checker::TProgram {
    let cls = lwt_enum_decl("Cls", lwt_two_members("GPR", "FPR"))
    let wide = lwt_enum_decl("Wide", lwt_five_members("A", "B", "C", "D", "E"))
    let reg = lwt_struct_decl("Reg", lwt_three_fields(lwt_field("id", "u32"), lwt_field("cls", "Cls"), lwt_field("phys", "byte")))
    let both = lwt_struct_decl("Both", lwt_two_fields(lwt_field("w", "Wide"), lwt_field("big", "i64")))
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, cls)
    items = teko::list::push(items, wide)
    items = teko::list::push(items, reg)
    items = teko::list::push(items, both)
    checker::TProgram { items = items }
}

/**
 * an_enum_typed_field_occupies_its_four_byte_integer_carrier_not_a_pointer — #594 T-B: an
 * `enum`-typed field used to fall through `ltype_of_typeexpr`'s total `Ptr` fallback and
 * register as an 8-byte pointer, which (a) mis-stated the size, align and EVERY later offset of
 * any struct containing one, and (b) made the aggregate-const serializer reject the field as
 * "pointer/slice-bearing" (the `MReg`/`reg_class` stop).
 *
 * The asserted numbers are the C emitter's, not this backend's invention: `codegen.tks` emits a
 * Teko `enum` as a plain C `enum`, and `cc` gives that 4 bytes at align 4, so
 * `struct { u32 id; Cls cls; bool phys }` measures `size=12 align=4 {id@0, cls@4, phys@8}` —
 * exactly what `Reg` asserts here. `Wide` (five members) shares `Cls`'s carrier: the width is
 * FIXED, not a function of the member count (that rule belongs to `flags`, which is a bitset).
 * `Both` proves the carrier interacts with alignment like any other 4-byte scalar — `w`@0, then
 * four bytes of padding before the 8-aligned `big`@8.
 */
#test
fn an_enum_typed_field_occupies_its_four_byte_integer_carrier_not_a_pointer() {
    let m = match lower_program(lwt_enum_carrier_layout_program()) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Reg: size=12 align=4 {id@0, cls@4, phys@8}")
    teko::assert::str_contains(text, "layout Both: size=16 align=8 {w@0, big@8}")
}

/**
 * lwt_class_decl — a `<kind> class [Base] { <fields> }` TypeDecl, wrapped as a
 * `checker::TItem`: the class counterpart of `lwt_struct_decl`, with no methods, no consts and
 * no interface list, so a layout assertion over it sees the FIELDS and nothing else.
 *
 * @param name       the class's declared name
 * @param kind       Sealed, Abstract or Virtual
 * @param has_base   does this class extend `base_name`?
 * @param base_name  the base class's name (read only when `has_base`)
 * @param fields     the class's OWN instance fields, in declared order
 * @return           the declaration, as a typed top-level item
 */
fn lwt_class_decl(name: str, kind: parser::ClassKind, has_base: bool, base_name: str, fields: []parser::Field) -> checker::TItem {
    parser::TypeDecl {
        name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        body = parser::ClassBody {
            kind = kind; has_base = has_base; base_name = base_name
            has_base_binding = false; base_binding_name = ""; implements = teko::list::empty()
            fields = fields; methods = teko::list::empty(); consts = teko::list::empty()
        }
        vis = parser::Visibility::Pub; has_doc = false; doc = ""
        line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""
        is_unsafe = false; must_free = false
    }
}

/**
 * lwt_class_layout_program — `struct Pair { small: i32; big: i64 }` (the control that must keep
 * its layout), `virtual class Root { tag: i32; weight: i64 }`, and `class Leaf Root { flag:
 * byte; extra: i64 }`, whose instance carries Root's fields as a prefix of its own.
 *
 * @return  the three-declaration program
 */
fn lwt_class_layout_program() -> checker::TProgram {
    let pair = lwt_struct_decl("Pair", lwt_two_fields(lwt_field("small", "i32"), lwt_field("big", "i64")))
    let root = lwt_class_decl("Root", parser::ClassKind::Virtual, false, "", lwt_two_fields(lwt_field("tag", "i32"), lwt_field("weight", "i64")))
    let leaf = lwt_class_decl("Leaf", parser::ClassKind::Sealed, true, "Root", lwt_two_fields(lwt_field("flag", "byte"), lwt_field("extra", "i64")))
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, pair)
    items = teko::list::push(items, root)
    items = teko::list::push(items, leaf)
    checker::TProgram { items = items }
}

/**
 * a_class_registers_the_layout_of_its_effective_instance_fields — a `ClassBody` used to fall
 * through `collect_struct_layout_decl`'s catch-all arm and register NO layout at all, so every
 * class instantiation honest-stopped with "no layout registered for struct `…`". A class now
 * registers exactly like a struct: `Root` from its own fields, `Leaf` from the base's fields
 * FIRST (the field-flattening prefix the checker and the C emitter already fixed) and its own
 * after. `Pair` is the struct control — a fix that broke the struct arm fails here too.
 */
#test
fn a_class_registers_the_layout_of_its_effective_instance_fields() {
    let m = match lower_program(lwt_class_layout_program()) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "layout Pair: size=16 align=8 {small@0, big@8}")
    teko::assert::str_contains(text, "layout Root: size=16 align=8 {tag@0, weight@8}")
    teko::assert::str_contains(text, "layout Leaf: size=32 align=8 {tag@0, weight@8, flag@16, extra@24}")
}

/**
 * lwt_virtual_main_returns_the_trailing_top_level_expressions_value — #423,
 * #382: `let x = 40; x + 2` (no explicit `exit`/`return`) — the loose
 * top-level statement list's TRAILING non-void expression becomes the
 * program's exit code, exactly like a non-void function body's own
 * trailing-expression auto-return (#421). Before the fix, `close_virtual_main`
 * unconditionally emitted `const 0; ret` here, discarding the `42` value.
 */
#test
fn lwt_virtual_main_returns_the_trailing_top_level_expressions_value() {
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind("x", lwt_num_i64(40), checker::PrimKind::I64)))
    let tail = lwt_bin(lexer::TokenKind::Plus, lwt_var("x", checker::PrimKind::I64), lwt_num_i64(2), checker::PrimKind::I64)
    items = teko::list::push(items, lwt_item(lwt_exprstmt(tail)))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => return }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "iadd ")
    teko::assert::str_contains(text, "ret %2")
    teko::assert::is_true(!teko::str::contains(text, "const 0"))
}

/**
 * A callee path over the given segment names.
 *
 * @param names  the path segments, root first
 * @return       the parsed-shape path `call_symbol` reads
 */
fn lwt_path(names: []str) -> parser::Path {
    mut segs: []parser::Segment = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        segs = teko::list::push(segs, parser::Segment { name = names[i] })
        i++
    }
    parser::Path { segments = segs }
}

/**
 * A call node over a path and a resolved namespace, for the symbol-resolution tests.
 *
 * @param names  the callee path's segments
 * @param ns     the resolved namespace ("" when the checker resolved no declaration)
 * @return       the call node
 */
fn lwt_bare_call(names: []str, ns: str) -> checker::TCall {
    checker::TCall {
        callee = lwt_path(names); args = teko::list::empty(); call_ns = ns
        is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0
    }
}

/**
 * A one-entry extern table.
 *
 * @param ns      the extern's declaring namespace
 * @param name    the extern's Teko name
 * @param symbol  the declared foreign C symbol
 * @return        the table `call_symbol` consults
 */
fn lwt_externs(ns: str, name: str, symbol: str) -> []LExternFn {
    teko::list::push(teko::list::empty(), LExternFn { namespace = ns; name = name; c_symbol = symbol })
}

/**
 * Assert `call_symbol` decides by ORIGIN NAMESPACE, never by bare name: a call the checker
 * resolved to a user declaration gets the `teko_` mangle even when its bare name is a builtin's
 * (the `arena_push` hijack), while the same bare name with no resolved namespace still gets the
 * runtime twin. This is the native half of the disjointness the prefix ruling buys.
 */
#test
fn lwt_call_symbol_keys_on_the_origin_namespace() {
    let user = lwt_bare_call(teko::list::push(teko::list::empty(), "arena_push"), "probe::mine")
    let builtin = lwt_bare_call(teko::list::push(teko::list::empty(), "arena_push"), "")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(user, no_ext) { str as s => s == "teko_probe__mine__arena_push"; error => false })
    teko::assert::is_true(match call_symbol(builtin, no_ext) { str as s => s == "tk_arena_push"; error => false })
}

/**
 * Assert an `extern fn` still lowers to its declared foreign symbol VERBATIM — no `teko_` prefix,
 * no namespace mangle. This is the invariant that keeps `getpid`/`aligned_alloc`/`free`/`memcmp`
 * linkable, and it holds because `find_extern_symbol` is consulted BEFORE the mangler.
 */
#test
fn lwt_call_symbol_leaves_an_extern_verbatim() {
    let ext = lwt_bare_call(teko::list::push(teko::list::push(teko::list::empty(), "sys"), "getpid"), "probe::sys")
    let table = lwt_externs("probe::sys", "getpid", "getpid")
    teko::assert::is_true(match call_symbol(ext, table) { str as s => s == "getpid"; error => false })
}

/**
 * Assert a `teko::assert` call the program does NOT declare resolves to the C assert seed's
 * `teko__assert__*` symbol on the native tail too — before this, the native backend had no assert
 * resolution at all and emitted the bare `is_true`, which links against nothing.
 */
#test
fn lwt_call_symbol_resolves_the_assert_seed() {
    mut names: []str = teko::list::push(teko::list::empty(), "teko")
    names = teko::list::push(names, "assert")
    names = teko::list::push(names, "is_true")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(lwt_bare_call(names, ""), no_ext) { str as s => s == "teko__assert__is_true"; error => false })
}

#test
fn lwt_call_symbol_resolves_runtime_string_builtins() {
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(lwt_bare_call(teko::list::push(teko::list::empty(), "str_slice_chars"), ""), no_ext) { str as s => s == "tk_str_slice_chars_len"; error => false })
    teko::assert::is_true(match call_symbol(lwt_bare_call(teko::list::push(teko::list::empty(), "bytes_of_str"), ""), no_ext) { str as s => s == "tk_bytes_of_str_len"; error => false })
    teko::assert::is_true(match call_symbol(lwt_bare_call(teko::list::push(teko::list::empty(), "one_byte"), ""), no_ext) { str as s => s == "tk_one_byte_len"; error => false })
}

/**
 * Assert `call_symbol` resolves the two `str` PREDICATE builtins (`contains`/`ends_with`) to
 * their plain runtime symbol (0.3.1.0 degrau 11): before this, either bare name fell through to
 * `unresolved_builtin_stop` — first surfaced through `teko::assert::str_contains`'s own body,
 * which every `.tkt` test file in this project calls via the injected assert seed.
 */
#test
fn lwt_call_symbol_resolves_str_contains_and_ends_with() {
    let contains = lwt_bare_call(teko::list::push(teko::list::empty(), "contains"), "")
    let ends_with = lwt_bare_call(teko::list::push(teko::list::empty(), "ends_with"), "")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(contains, no_ext) { str as s => s == "tk_str_contains"; error => false })
    teko::assert::is_true(match call_symbol(ends_with, no_ext) { str as s => s == "tk_str_ends_with"; error => false })
}

/**
 * Assert `call_symbol` resolves the three `str`-returning SLICE builtins (`slice`/`slice_to`/
 * `slice_from`) to their runtime OUT-PARAMETER-LENGTH twin, not the real two-eightbyte `tk_str`
 * return `codegen.tks` targets (0.3.1.0 degrau 11) — `lower_call_fat`'s own generic tail
 * (`lower_args` + `lower_len_out_call`) supplies the hidden length out-slot once the symbol
 * resolves, mirroring `tk_str_concat_len`'s own shape (0.3.1.0 degrau 9).
 */
#test
fn lwt_call_symbol_resolves_str_slice_family() {
    let slice = lwt_bare_call(teko::list::push(teko::list::empty(), "slice"), "")
    let slice_to = lwt_bare_call(teko::list::push(teko::list::empty(), "slice_to"), "")
    let slice_from = lwt_bare_call(teko::list::push(teko::list::empty(), "slice_from"), "")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(slice, no_ext) { str as s => s == "tk_str_slice_len"; error => false })
    teko::assert::is_true(match call_symbol(slice_to, no_ext) { str as s => s == "tk_str_slice_to_len"; error => false })
    teko::assert::is_true(match call_symbol(slice_from, no_ext) { str as s => s == "tk_str_slice_from_len"; error => false })
}

/**
 * Assert a `teko::str::slice(s, start, end)` call actually LOWERS to the out-parameter-length
 * twin, not merely that `call_symbol` names it — `lower_call_fat`'s generic tail (`lower_args` +
 * `lower_len_out_call`) must also flatten the `str` receiver into its (ptr, len) pair and append
 * the hidden length out-slot as the call's LAST argument (0.3.1.0 degrau 11).
 */
#test
fn lwt_lowers_str_slice_as_the_out_parameter_length_twin() {
    let args = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), lwt_strlit("hello world")), lwt_num(6, checker::PrimKind::U64)), lwt_num(11, checker::PrimKind::U64))
    let call = lwt_call(lwt_path1("slice"), "", args, checker::Str { })
    let text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "rodata .Lstr0:")
    teko::assert::str_contains(text, "call @tk_str_slice_len(")
}

/**
 * Assert `call_symbol` resolves the two INTEGER-TO-STRING builtins (`i64_to_str`/`u64_to_str`) to
 * their runtime OUT-PARAMETER-LENGTH twin (0.3.1.0 degrau 12): before this, either bare name fell
 * through to `unresolved_builtin_stop` — first surfaced through `teko::backend::reg_ref`'s own
 * `teko::u64_to_str(r.id to u64)` call, on the compiler's own self-build. The runtime twins
 * (`tk_i64_to_str_len`/`tk_u64_to_str_len`) already existed (0.3.1.0 degrau 9) and were already
 * reachable through `$"…{n}…"` interpolation's own hardcoded call — only the DIRECT-call
 * resolution was missing.
 */
#test
fn lwt_call_symbol_resolves_int_to_str_family() {
    let i64_call = lwt_bare_call(teko::list::push(teko::list::empty(), "i64_to_str"), "")
    let u64_call = lwt_bare_call(teko::list::push(teko::list::empty(), "u64_to_str"), "")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(i64_call, no_ext) { str as s => s == "tk_i64_to_str_len"; error => false })
    teko::assert::is_true(match call_symbol(u64_call, no_ext) { str as s => s == "tk_u64_to_str_len"; error => false })
}

/**
 * Assert a DIRECT `teko::u64_to_str(n)` call actually LOWERS to the out-parameter-length twin,
 * not merely that `call_symbol` names it — `lower_call_fat`'s generic tail (`lower_args` +
 * `lower_len_out_call`) must reserve the hidden length out-slot and append it as the call's LAST
 * argument, the same shape `lwt_lowers_str_slice_as_the_out_parameter_length_twin` already proves
 * for the `str`-returning slice family (0.3.1.0 degrau 12).
 */
#test
fn lwt_lowers_u64_to_str_as_the_out_parameter_length_twin() {
    let args = teko::list::push(teko::list::empty(), lwt_num(42, checker::PrimKind::U64))
    let call = lwt_call(lwt_path1("u64_to_str"), "", args, checker::Str { })
    let text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "call @tk_u64_to_str_len(")
}

/**
 * A native builtin call whose declared return type is `bool` (`teko::str::contains`) has its raw
 * result narrowed the SAME way a DECLARED `extern fn`'s does: a shift-left by 56 then an
 * UNSIGNED shift-right by 56 — the low-byte, zero-extending round trip `extern_return_narrow`
 * gives every `bool` return since 0.3.1.0 degrau 11. Before this fix,
 * `apply_native_c_return_narrow` (then `apply_extern_return_narrow`) narrowed only a DECLARED
 * `extern`'s result: a runtime builtin's raw `bool` reached `LBranch` untouched, which a garbage
 * upper byte can silently flip `false` into `true` — measured at
 * `teko::str::ends_with("hello world", "worldx")`.
 */
#test
fn lwt_native_builtin_bool_return_is_narrowed() {
    let args = teko::list::push(teko::list::push(teko::list::empty(), lwt_strlit("hello world")), lwt_strlit("lo"))
    let call = lwt_call(lwt_path1("contains"), "", args, checker::Prim { kind = checker::PrimKind::Bool })
    let text = lwt_lower_expr_text(call)
    teko::assert::str_contains(text, "call @tk_str_contains(")
    teko::assert::str_contains(text, "const 56")
    teko::assert::str_contains(text, "= ishl ")
    teko::assert::str_contains(text, "= ishru ")
}

/**
 * Assert `call_symbol`'s static/shared-archive carve-out (`flat = true`, `mangle_fn_symbol`'s
 * `flat`): a Teko-Teko call inside a `flat_symbols` module resolves WITHOUT `TEKO_USER_PREFIX` —
 * the SAME bare mangle a `flat`-lowered function's own declared symbol carries
 * (`lwt_lower_program_flat_symbols_strips_the_user_prefix`), so the two never drift apart inside
 * one static/shared archive.
 */
#test
fn lwt_call_symbol_flat_strips_the_user_prefix() {
    let user = lwt_bare_call(teko::list::push(teko::list::empty(), "add"), "ar_link_run")
    let no_ext: []LExternFn = teko::list::empty()
    teko::assert::is_true(match call_symbol(user, no_ext, true) { str as s => s == "ar_link_run__add"; error => false })
}

/**
 * Assert `lower_program`'s static/shared-archive carve-out (`flat_symbols = true`,
 * `emit_static_lib`'s own argument): a top-level function's LIR symbol drops
 * `TEKO_USER_PREFIX` entirely, publishing exactly the archived symbol a real host
 * `ar`/`nm`/`ld` must resolve. This is the regression `examples/toolchain/ar_link_run` measures
 * end to end (KP16's static archive) — before this fix, the archive published
 * `teko_ar_link_run__add` where the real contract is `ar_link_run__add`, and the consumer's
 * `extern long long ar_link_run__add(...)` never linked.
 *
 * @return void
 */
#test
fn lwt_lower_program_flat_symbols_strips_the_user_prefix() {
    let body = teko::list::push(teko::list::empty(), lwt_ret(lwt_num_i64(42)))
    let f = lwt_fn_item("add", "ar_link_run", teko::list::empty(), lwt_prim(checker::PrimKind::I64), body)
    let items = teko::list::push(teko::list::empty(), f)
    let m = match lower_program(checker::TProgram { items = items }, true) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m.funcs[0].symbol == "ar_link_run__add")
}

/**
 * Assert a Teko-Teko call between two functions inside the SAME `flat_symbols` module resolves
 * to the SAME flat spelling the callee's own declaration carries — the general (multi-function)
 * case `lwt_lower_program_flat_symbols_strips_the_user_prefix`'s single-function fixture cannot
 * exercise: a static/shared archive with internal calls between its own project functions must
 * keep the call site and the callee's definition consistent, or the archived object never links
 * against itself.
 *
 * @return void
 */
#test
fn lwt_lower_program_flat_symbols_keeps_internal_calls_consistent() {
    let helper_body = teko::list::push(teko::list::empty(), lwt_ret(lwt_num_i64(1)))
    let helper = lwt_fn_item("helper", "ar_link_run", teko::list::empty(), lwt_prim(checker::PrimKind::I64), helper_body)
    let call = lwt_call(lwt_path1("helper"), "ar_link_run", teko::list::empty(), lwt_prim(checker::PrimKind::I64))
    let caller_body = teko::list::push(teko::list::empty(), lwt_ret(call))
    let caller = lwt_fn_item("caller", "ar_link_run", teko::list::empty(), lwt_prim(checker::PrimKind::I64), caller_body)
    mut items = teko::list::push(teko::list::empty(), helper)
    items = teko::list::push(items, caller)
    let m = match lower_program(checker::TProgram { items = items }, true) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "call @ar_link_run__helper()")
    teko::assert::is_true(!teko::str::contains(text, "teko_ar_link_run__helper"))
}

/**
 * A NEGATIVE const serializes to its two's-complement byte image, and this test exists because the
 * absence of one is what let the defect ship.
 *
 * `lo_byte` used to convert THROUGH `u64` before masking — a shape that is correct in C, where a
 * conversion reinterprets the bits, and fatal in Teko, where the cast is CHECKED: `to u64` on a
 * negative `i64` is an impossible conversion, not a reinterpretation. It panicked with
 * `84:7: teko: deliberate panic: impossible conversion`, and it stayed invisible until enough
 * consts serialized for a negative one to be reached — the compiler's own self-host hit it at
 * `consteval 490/490`, not at 1.
 *
 * `-1` is the case the old doc-comment CLAIMED to handle (`~0` serializes to `0xFF`) and did not.
 * `-256` pins the byte boundary: the low byte is zero while every byte above it is the sign fill,
 * so a mask applied at the wrong width shows up here and nowhere else.
 *
 * @return void
 */
#test
fn lwt_serialize_le_of_a_negative_value_is_twos_complement() {
    let ones = serialize_le(-1, 8)
    teko::assert::is_true(ones.len == 8)
    mut i: u64 = 0
    loop {
        if i >= ones.len { break }
        teko::assert::is_true(ones[i] == (0xFF to byte))
        i++
    }
    let boundary = serialize_le(-256, 8)
    teko::assert::is_true(boundary[0] == (0 to byte))
    teko::assert::is_true(boundary[1] == (0xFF to byte))
    teko::assert::is_true(boundary[7] == (0xFF to byte))
}

/**
 * A POSITIVE const serializes little-endian, and a value wider than its declared width truncates —
 * the control arm for the negative case above, so a fix that broke the ordinary path fails here
 * instead of passing quietly.
 *
 * @return void
 */
#test
fn lwt_serialize_le_of_a_positive_value_is_little_endian_and_truncates() {
    let full = serialize_le(0x0102, 8)
    teko::assert::is_true(full[0] == (0x02 to byte))
    teko::assert::is_true(full[1] == (0x01 to byte))
    teko::assert::is_true(full[2] == (0 to byte))
    let narrow = serialize_le(0x0102, 1)
    teko::assert::is_true(narrow.len == 1)
    teko::assert::is_true(narrow[0] == (0x02 to byte))
}

/**
 * lwt_match_value_typed — a VALUE-producing `TMatchExpr` of an ARBITRARY resolved type, the fat
 * counterpart of `lwt_match_value` (which only covers a `PrimKind` result) (0.3.1.0 degrau 5).
 *
 * @param subject  the match's subject expression
 * @param arms     the match's arms, in order
 * @param ty       the match expression's own resolved type
 * @return         the typed `TMatchExpr` node
 */
fn lwt_match_value_typed(subject: checker::TExpr, arms: []checker::TArm, ty: checker::Type) -> checker::TExpr {
    checker::TExpr { kind = checker::TMatchExpr { subject = subject; arms = arms }; type = ty; line = 0; col = 0 }
}

/**
 * lwt_lowers_str_match_value_merges_both_ptr_and_len_at_the_fat_merge — the degrau-5 proof at the
 * LIR level: `let s = match n { 1 => "a"; _ => "bb" }; return s.len` used to HONEST-STOP with
 * "fat-pointer receiver `match-expression` not yet lowered (N2)", because `lower_fat_expr`'s closed
 * producer set had no match-value arm — the shape every `str`-returning function whose body is a
 * match takes. `lower_match_fat` now merges BOTH halves through a two-block-param merge, ptr FIRST
 * then len, exactly as the `if`-expression producer does.
 *
 * A merge that carried only the ptr would still COMPILE and read a garbage length past the binding,
 * so the fixture asserts each arm's OWN literal length ("a" -> 1, "bb" -> 2) reaches the merge's
 * SECOND param, and that `s.len` reads that param with no memory traffic.
 *
 * @return void
 */
#test
fn lwt_lowers_str_match_value_merges_both_ptr_and_len_at_the_fat_merge() {
    let arm1 = lwt_arm(lwt_int_pattern(1), teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("a"))))
    let arm2 = lwt_arm(lwt_wildcard_pattern(), teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("bb"))))
    let arms = teko::list::push(teko::list::push(teko::list::empty(), arm1), arm2)
    let mx = lwt_match_value_typed(lwt_num_i64(1), arms, checker::Str { })
    let s_bind = lwt_bind_typed("s", mx, checker::Str { })
    let len_access = lwt_len_field(lwt_typed_var("s", checker::Str { }))
    let body = teko::list::push(teko::list::push(teko::list::empty(), s_bind), lwt_ret(len_access))
    let f = lwt_fn("str_match_value", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "rodata .Lstr0: [97]")
    teko::assert::str_contains(text, "rodata .Lstr1: [98, 98]")
    teko::assert::str_contains(text, "global_addr @.Lstr0")
    teko::assert::str_contains(text, "global_addr @.Lstr1")
    teko::assert::str_contains(text, "#B1(%1, %2):\n    ret %2")
}

/**
 * lwt_slice_variant — an inline `checker::Variant` of a `[]T` case and the `error` case: the
 * `T | error` shape the compiler's own source is written in, with a FAT member (0.3.1.0 degrau 6).
 *
 * @param checker::Type elem  the slice member's element type
 * @return checker::Type  the inline `Variant` type
 */
fn lwt_slice_variant(elem: checker::Type) -> checker::Type {
    mut members: []checker::Type = teko::list::empty()
    members = teko::list::push(members, checker::Slice { element = elem })
    members = teko::list::push(members, checker::Error { })
    checker::Variant { members = members }
}

/**
 * lwt_slice_bind_pattern — a `[]T as x` slice pattern: no type path at all, `is_slice` set — the
 * one pattern shape that carries no case NAME to resolve a variant member by.
 *
 * @param str binding  the name to bind the slice case to
 * @return parser::Pattern  the slice bind pattern
 */
fn lwt_slice_bind_pattern(binding: str) -> parser::Pattern {
    parser::BindPattern { type_name = parser::Path { segments = teko::list::empty() }; has_binding = true; binding = binding; is_slice = true; slice_type = null; type_args = teko::list::empty() }
}

/**
 * lwt_variant_construct_of_a_slice_reserves_the_uniform_wrapper — the CONSTRUCTION half of degrau 6:
 * `fn mk() -> []i64 | error { return [10, 20] }` allocates the uniform 24-byte wrapper and writes
 * BOTH halves of the fat member — the pointer at offset 8 and the LENGTH at offset 16.
 *
 * The length store is the whole claim. The wrapper used to be `8 + one payload word` = 16 bytes, so
 * the slice's length had nowhere to go and was dropped where the value was built; every reader
 * downstream then had a pointer and a guess.
 *
 * @return void
 */
#test
fn lwt_variant_construct_of_a_slice_reserves_the_uniform_wrapper() {
    let elems = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(10)), lwt_num_i64(20))
    let body = teko::list::push(teko::list::empty(), lwt_ret(lwt_array_lit(elems, checker::PrimKind::I64)))
    let f = lwt_fn("mk", "teko::demo", teko::list::empty(), lwt_slice_variant(lwt_prim(checker::PrimKind::I64)), body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "alloca 24, align 8")
    teko::assert::str_contains(text, "store.i32")
    teko::assert::str_contains(text, "field_addr %0, 8")
    teko::assert::str_contains(text, "store.ptr")
    teko::assert::str_contains(text, "field_addr %0, 16")
    teko::assert::str_contains(text, "store.i64")
}

/**
 * lwt_slice_pattern_binds_both_halves_of_the_fat_member — the PATTERN half of degrau 6: a `[]T as xs`
 * arm over a `[]i64 | error` subject selects the slice member's tag (index 0, resolved by KIND since
 * the pattern carries no path) and binds `xs` as a FAT local — the pointer from offset 8 and the
 * length from offset 16 — so `xs.len` reads the wrapper's own length instead of a register that was
 * never written.
 *
 * @return void
 */
#test
fn lwt_slice_pattern_binds_both_halves_of_the_fat_member() {
    let subject = lwt_typed_var("r", lwt_slice_variant(lwt_prim(checker::PrimKind::I64)))
    let len_access = lwt_len_field(lwt_typed_var("xs", checker::Slice { element = lwt_prim(checker::PrimKind::I64) }))
    let arm0 = lwt_arm(lwt_slice_bind_pattern("xs"), teko::list::push(teko::list::empty(), lwt_exprstmt(len_access)))
    let arms = teko::list::push(teko::list::empty(), arm0)
    let mx = lwt_match_value(subject, arms, checker::PrimKind::U64)
    let params = teko::list::push(teko::list::empty(), lwt_param("r", "Res"))
    let body = teko::list::push(teko::list::empty(), lwt_ret(mx))
    let f = lwt_fn("read_slice_case", "teko::demo", params, lwt_prim(checker::PrimKind::U64), body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lfo.func))
    teko::assert::str_contains(text, "field_addr %0, 0")
    teko::assert::str_contains(text, "load.i32")
    teko::assert::str_contains(text, "icmpeq")
    teko::assert::str_contains(text, "field_addr %0, 8")
    teko::assert::str_contains(text, "load.ptr")
    teko::assert::str_contains(text, "field_addr %0, 16")
    teko::assert::str_contains(text, "load.i64")
}

/**
 * lwt_alias_decl — a `type <name> = <alias>` TypeDecl, wrapped as a `checker::TItem` — the
 * AliasBody shape `typeexpr_is_fat`'s alias chain walks (`lwt_struct_decl`'s StructBody
 * counterpart).
 *
 * @param name   the alias's own declared name
 * @param alias  the alias's right-hand-side annotation
 * @return       the alias type declaration, as a program item
 */
fn lwt_alias_decl(name: str, alias: parser::TypeExpr) -> checker::TItem {
    parser::TypeDecl {
        name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        body = parser::AliasBody { alias = alias }
        vis = parser::Visibility::Pub; has_doc = false; doc = ""
        line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""
        is_unsafe = false; must_free = false
    }
}

/**
 * lwt_fat_predicate_probe_table — the type table `lwt_fat_predicates_agree` resolves every probe
 * annotation against: `AliasStr` (a single alias of `str`), `AliasStrTwice` (an alias OF an
 * alias), `AliasSlice` (an alias of `[]i64`), and `Point` (a plain nominal struct — the "directo,
 * not fat" nominal control the earlier R0 draft named).
 *
 * @return the program's type table over exactly these four declarations
 */
fn lwt_fat_predicate_probe_table() -> checker::TypeTable {
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_alias_decl("AliasStr", lwt_named_te("str")))
    items = teko::list::push(items, lwt_alias_decl("AliasStrTwice", lwt_named_te("AliasStr")))
    items = teko::list::push(items, lwt_alias_decl("AliasSlice", parser::SliceType { element = lwt_named_te("i64") }))
    items = teko::list::push(items, lwt_struct_decl("Point", teko::list::push(teko::list::push(teko::list::empty(), lwt_field("x", "i32")), lwt_field("y", "i32"))))
    checker::type_table_of(checker::TProgram { items = items })
}

/**
 * lwt_assert_fat_predicate_agrees — one row of the R0 gate: `typeexpr_is_fat`, asked about the
 * SYNTACTIC annotation `te`, must answer exactly what `is_fat_type` answers about the RESOLVED
 * type `t` an annotation of that shape denotes.
 *
 * @param table  the probe's type table (`lwt_fat_predicate_probe_table`)
 * @param te     the syntactic annotation under test
 * @param t      the semantic type `te` is expected to resolve to
 * @return       void — fails the enclosing `#test` when the two predicates disagree
 */
fn lwt_assert_fat_predicate_agrees(table: checker::TypeTable, te: parser::TypeExpr, t: checker::Type) {
    teko::assert::is_true(typeexpr_is_fat(te, table) == is_fat_type(t))
}

/**
 * lwt_fat_predicates_agree — the R0 gate (0.3.1.0 raiz A): `is_fat_type` (the SEMANTIC predicate,
 * over a RESOLVED `checker::Type`) and `typeexpr_is_fat` (the SYNTACTIC predicate, over the
 * WRITTEN annotation) must answer the SAME question the same way, for a direct type, a type
 * ALIASED once, a type aliased TWICE, an aliased `[]T` slice, an OPTIONAL of an aliased type, and
 * a handful of definitely-not-fat controls (a scalar, a nominal struct, `ptr<T>`).
 *
 * This is crumb R0's own portal, named in `docs/memory/raiz-comum-dos-degraus-0.3.1.0.md`: a
 * layout built from one predicate and a store built from the other disagreeing on the SAME field
 * is exactly the silent alias miscompilation measured there (§7-quater.3-bis) — `type S = str;
 * struct H { s: S; n: i32 }` read `h.s.len` back as its sibling `n`'s own byte value on the
 * native route, `5` on the C route, because `field_layout_size` asked the (then purely syntactic)
 * `typeexpr_is_fat` and reserved 8 bytes for `s`, while `store_struct_field` asked the semantic
 * `is_fat_type` on the field's resolved type and wrote the full 16-byte image there. Making the
 * two predicates agree BY CONSTRUCTION (`typeexpr_is_fat` now walks the SAME alias chain a
 * resolved `checker::Type` already collapsed through) is what makes this assertion pass;
 * reintroducing a THIRD, independently-maintained fat-or-not rule anywhere in this file is what
 * would make it fail again — the ONE thing this gate exists to catch.
 *
 * @return void
 */
#test
fn lwt_fat_predicates_agree() {
    let table = lwt_fat_predicate_probe_table()
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("str"), checker::Str { })
    lwt_assert_fat_predicate_agrees(table, parser::SliceType { element = lwt_named_te("i64") }, checker::Slice { element = lwt_prim(checker::PrimKind::I64) })
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("AliasStr"), checker::Str { })
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("AliasStrTwice"), checker::Str { })
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("AliasSlice"), checker::Slice { element = lwt_prim(checker::PrimKind::I64) })
    lwt_assert_fat_predicate_agrees(table, parser::OptionalType { inner = lwt_named_te("AliasStr") }, checker::Optional { inner = checker::Str { } })
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("byte"), checker::Byte { })
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("i32"), lwt_prim(checker::PrimKind::I32))
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("bool"), lwt_prim(checker::PrimKind::Bool))
    lwt_assert_fat_predicate_agrees(table, lwt_named_te("Point"), checker::Named { name = "Point" })
    lwt_assert_fat_predicate_agrees(table, parser::NamedType { path = lwt_path1("ptr"); args = teko::list::push(teko::list::empty(), lwt_named_te("i32")) }, checker::Ptr { inner = lwt_prim(checker::PrimKind::I32) })
}

#test
/**
 * lwt_fat_arg_arity_names_every_by_value_str_entry — the ABI-arity table
 * (`fat_arg_builtin_arity`) answers 1 for the seven `(tk_str) -> void`/`_Noreturn`
 * entries, 2 for the four whose first two parameters are by-value `tk_str`, and 0 for the
 * family the RUNTIME declares flattened (`teko_rt.h`'s `(const tk_byte *ptr, uint64_t len, …)`
 * shape) — the distinction the x86 isel turns into by-reference passing on Win64 and which is
 * invisible on SysV, where both spellings are the same ABI.
 *
 * @return void
 */
fn lwt_fat_arg_arity_names_every_by_value_str_entry() {
    teko::assert::is_true(fat_arg_builtin_arity("tk_println") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_print") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_eprint") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_eprintln") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_write") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_ewrite") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_panic_str") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_eq") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_contains") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_ends_with") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_last_index_of_ok") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_concat_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_slice_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_of_bytes_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_slice_str_eq") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_exit") == 0)
}

#test
/**
 * lwt_two_pair_entries_are_not_single_str_builtins — the dispatch guardrail: the four
 * two-`tk_str` entries must NOT satisfy `is_str_arg_builtin`, whose truth routes a call into
 * `lower_str_arg_call` (one argument, void result). A table that answered `true` for
 * `tk_str_eq` would lower every string comparison as a one-argument void print.
 *
 * @return void
 */
fn lwt_two_pair_entries_are_not_single_str_builtins() {
    teko::assert::is_false(is_str_arg_builtin("tk_str_eq"))
    teko::assert::is_false(is_str_arg_builtin("tk_str_contains"))
    teko::assert::is_false(is_str_arg_builtin("tk_str_ends_with"))
    teko::assert::is_false(is_str_arg_builtin("tk_rt_last_index_of_ok"))
    teko::assert::is_true(is_str_arg_builtin("tk_println"))
    teko::assert::is_false(is_str_arg_builtin("tk_str_concat_len"))
}

#test
/**
 * lwt_fat_arg_arity_spans_the_assert_seed — the ABI-arity table answers for the SECOND
 * hand-written C seed too (`src/assert/assert.{c,h}`), not only the runtime.
 *
 * WHAT IT PINS. `teko__assert__scenario_begin(tk_str)` is one leading by-value aggregate, the four
 * `(tk_str, bool)` narrowing assertions are one each, and the seven `(tk_str, tk_str)` /
 * `([]byte, []byte)` pairs are two. A `0` for any of them puts the flat `(ptr, len)` form in
 * RCX/RDX for an MSVC-built callee that reads RCX as a POINTER to the struct — measured 2026-07-30
 * as `examples/regressions/own_native` faulting with ACCESS_VIOLATION (0xC0000005) on its FIRST
 * case, `own_arith_exit`, without writing a byte, because `scenario()` opens with
 * `scenario_begin(name)`.
 *
 * THE SCALAR ASSERTIONS MUST STAY 0: they take no aggregate, so a non-zero answer would
 * re-materialize a pair that does not exist and shift every later argument down a register.
 *
 * @return void
 */
fn lwt_fat_arg_arity_spans_the_assert_seed() {
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__scenario_begin") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__is_present") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__is_absent") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__is_ok") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__is_error") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__eq_str") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__ne_str") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__str_contains") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__str_absent") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__str_starts_with") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__str_ends_with") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__bytes_eq") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__is_true") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__scenario_ok") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__eq_i64") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__eq_f64") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__len_eq") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__not_an_assertion") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("teko__assert__") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("scenario_begin") == 0)
}

#test
/**
 * lwt_fat_arg_arity_transcribes_the_whole_runtime_header — the arity table answers for EVERY
 * `teko_rt.h` entry with a leading by-value `tk_str`, not only the ones a builtin table names.
 *
 * WHY THE WHOLE HEADER. A runtime symbol reaches the backend through two seams, and the second is
 * open-ended: `extern fn f(s: str) = "tk_…" from "teko_rt"` names ANY symbol in the header, and this
 * compiler's own source carries such declarations — `src/assert/assert.tks` binds
 * `tk_assert_scenario_set`, `src/process/process.tks` binds `tk_rt_spawn_redirected`, the coverage
 * sink binds `tk_cov_merge`. Each was passed the flat `(ptr, len)` pair on Win64 while its
 * MSVC-built callee expected a pointer; measured on the emitted object, `teko_extprobe__probe`
 * loaded RCX/RDX with the pair for `tk_assert_scenario_set` before this table was completed.
 *
 * THE FLATTENED TWINS MUST STAY 0: `teko_rt.h` deliberately declares a second spelling of the same
 * operations taking `(const tk_byte *ptr, uint64_t len, …)`, and those take no aggregate at all.
 *
 * @return void
 */
fn lwt_fat_arg_arity_transcribes_the_whole_runtime_header() {
    teko::assert::is_true(fat_arg_builtin_arity("tk_assert_scenario_set") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_test_begin") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_cov_merge") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_spawn_redirected") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_float_parse") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_len") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_hash") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_char_at") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_read_file") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_getenv") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_chdir") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_mkdir") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_remove_file") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_list_dir") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_write_file_bytes") == 1)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_cmp") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_concat") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_intern_put") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_write_file") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_setenv") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_rt_last_index_of") == 2)
    teko::assert::is_true(fat_arg_builtin_arity("tk_i64_to_str_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_str_slice_to_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_fmt_dyn_f64_len") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_slice_push") == 0)
    teko::assert::is_true(fat_arg_builtin_arity("tk_set_args") == 0)
}

#test
/**
 * lwt_assert_seed_entries_are_not_single_str_builtins — the dispatch guardrail for the widened
 * arity table: an assert-seed entry with ONE leading by-value `tk_str` must NOT satisfy
 * `is_str_arg_builtin`, whose truth routes a call into `lower_str_arg_call` — a lowering written
 * for the io group alone, whose argument must be one of `lower_fat_expr`'s closed producers. Had
 * the predicate stayed spelled `fat_arg_builtin_arity(sym) == 1`, widening the table would have
 * dragged `scenario_begin` onto that path and honest-stopped every corpus that names a scenario.
 *
 * @return void
 */
fn lwt_assert_seed_entries_are_not_single_str_builtins() {
    teko::assert::is_false(is_str_arg_builtin("teko__assert__scenario_begin"))
    teko::assert::is_false(is_str_arg_builtin("teko__assert__is_present"))
    teko::assert::is_false(is_str_arg_builtin("teko__assert__eq_str"))
}

#test
/**
 * lwt_runtime_twin_reroute_gates_on_the_twins_present — the Degrau-0 reroute DECISION: a pure-byte
 * builtin (`str ==`/`ends_with`/`contains`) resolves to the mangled `teko::runtime::<twin>` body ONLY
 * when that twin is declared in the program (`collect_runtime_twins`'s set), and keeps the C `tk_*`
 * symbol otherwise. This is the gate that lets a STANDALONE program (no `teko_rt.tks`) still link
 * against `teko_rt.c` while the compiler's OWN native build sheds `tk_str_eq`/`tk_str_ends_with`/
 * `tk_str_contains`. Asserted here directly because the full native self-host that exercises the
 * present-twin arm end to end is a separate, memory-heavy gate.
 *
 * @return void
 */
fn lwt_runtime_twin_reroute_gates_on_the_twins_present() {
    let none: []str = teko::list::empty()
    let eq = teko::list::push(teko::list::empty(), "str_eq")
    let ends = teko::list::push(teko::list::empty(), "str_ends_with")
    let cont = teko::list::push(teko::list::empty(), "str_contains")
    teko::assert::is_true(str_eq_symbol(none) == "tk_str_eq")
    teko::assert::is_true(str_eq_symbol(eq) == "teko_teko__runtime__str_eq")
    teko::assert::is_true(match runtime_twin_symbol("ends_with", none) { null => true; _ => false })
    teko::assert::is_true(match runtime_twin_symbol("ends_with", ends) { str as s => s == "teko_teko__runtime__str_ends_with"; null => false })
    teko::assert::is_true(match runtime_twin_symbol("contains", cont) { str as s => s == "teko_teko__runtime__str_contains"; null => false })
    teko::assert::is_true(match runtime_twin_symbol("not_a_builtin", eq) { null => true; _ => false })
}
