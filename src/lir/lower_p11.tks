use teko::checker
use teko::lexer
use teko::parser

/**
 * lower_char_compare — `a == b` / `a != b` over two `char` operands. UNLIKE `str`/`[]T`, `char`
 * needs NO runtime call: both operands already reach here as plain scalar VRegs (`lower_expr`,
 * same as any integer) carrying their DECODED codepoint (`lower_char_lit` decodes a literal at
 * lowering time; a call/local/field of type `char` reads the same scalar back), and codepoint
 * equality already is byte/content equality (the lexer never emits two different encodings of
 * the same codepoint). So this is a direct `ICmpEq`/`ICmpNe` over the two scalars — the SAME shape
 * `lower_compare`'s own generic chain would have built, had `prim_kind_of` known a `PrimKind` for
 * `char` (it deliberately does not: see `is_char_type`'s doc for why routing here instead is
 * correct rather than a workaround).
 *
 * @param LowerCtx ctx  the lowering context to append the comparison's instructions into
 * @param checker::TExpr e  the comparison expression (its source position)
 * @param checker::TCompare cmp  the comparison node (its `first` operand is a `char`)
 * @return Lowered  the advanced context + the bool VReg of the equality
 * @throws  for a CHAINED char comparison (`a == b == c`), for an ordered operator, or propagated
 *          from lowering either operand
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn lower_char_compare(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare) -> Lowered | error {
    if cmp.rest.len != 1 { return error { message = "native backend N1: a CHAINED `char` comparison (`a == b == c`) is not lowered (N2)" } }
    let pred = match char_cmp_predicate(cmp.rest[0].op) { LBinOp as p => p; error as err => return err }
    let lo = match lower_expr(ctx, cmp.first) { Lowered as x => x; error as err => return err }
    let ro = match lower_expr(lo.ctx, cmp.rest[0].operand) { Lowered as x => x; error as err => return err }
    let r = ctx_alloc(ro.ctx)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, pred, lo.vreg, ro.vreg, e.line, e.col)); vreg = r.vreg }
}

/**
 * char_cmp_predicate — the direct `ICmpEq`/`ICmpNe` for a `char == `/`!=` term (no runtime call
 * to normalize, unlike `runtime_eq_predicate` — the two operands are ALREADY the bool-deciding
 * scalars, not a runtime call's raw return register).
 *
 * @param lexer::TokenKind op  the comparison operator token
 * @return LBinOp  `ICmpEq` for `==`, `ICmpNe` for `!=`
 * @throws  for an ORDERED operator (`<`, `<=`, `>`, `>=`) — out of the closed subset this
 *          increment draws (mirrors `str`'s own equality-only scope)
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn char_cmp_predicate(op: lexer::TokenKind) -> LBinOp | error {
    match op {
        lexer::TokenKind::EqEq => LBinOp::ICmpEq
        lexer::TokenKind::Ne => LBinOp::ICmpNe
        _ => error { message = "native backend N1: an ORDERED `char` comparison (`<`/`<=`/`>`/`>=`) is not lowered (N2)" }
    }
}

/**
 * LSliceEqPlan — the runtime call `[]T == []T` needs for one element shape: which fixed-ABI
 * predicate to call, and whether that call ALSO needs a trailing `sizeof(T)` argument (the
 * generic `memcmp` route, `tk_slice_eq_bytes`, is generic over element width; the float/char/str
 * routes each bake the element width into their own dedicated predicate). Mirrors the C route's
 * `CgSliceEqPlan` (`codegen.tks`) — the two backends agree on WHICH runtime symbol answers each
 * element shape, only the calling convention around it (struct-by-value vs ABI-flattened) differs.
 */
pub type LSliceEqPlan = struct {
    /** the runtime predicate's C symbol. */
    rtfn: str
    /** whether the call needs a trailing element-size argument. */
    needs_size: bool
}

/**
 * slice_elem_of — the element type of a `[]T` operand about to take `lower_slice_compare`.
 * Reached ONLY after `lower_compare` already matched `is_fat_type` and NOT `is_str_type` on this
 * same operand, so the fallback arm below is unreachable in practice; it is still written total
 * (Teko `match` requires exhaustiveness) rather than assumed.
 *
 * @param checker::Type t  the operand's resolved type (a `Slice` by the caller's own precondition)
 * @return checker::Type  `t`'s element type, or `Void` when `t` is not in fact a `Slice`
 *                        (unreachable given the precondition)
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn slice_elem_of(t: checker::Type) -> checker::Type {
    match t { checker::Slice as sl => sl.element; _ => checker::Void { } }
}

/**
 * slice_eq_plan — the `LSliceEqPlan` for a `[]T`'s element type `elem`, mirroring Go's
 * slice-by-value comparison (owner ruling 2026-07-29, naming Go over Rust's derived `PartialEq`
 * — Teko has no derived traits, and Go compares a slice by value with no ceremony): same length
 * AND every element equal. An integer/`bool`/`byte` element is POD (no interior pointer, no
 * padding in a packed array of it) so the generic `memcmp` route is exact; a float element needs
 * per-element `==` (`memcmp` would call `-0.0`/`0.0` distinct and `NaN` self-equal, both wrong);
 * a `str` element is a `{ptr,len}` VIEW whose address differs even for equal content, so it gets
 * its own dedicated per-element predicate (`tk_slice_str_eq`). See `cg_slice_eq_plan`
 * (`codegen.tks`) for the C route's full reasoning — this is its native twin, but NOT a
 * byte-for-byte mirror: a `char` ELEMENT takes the generic `memcmp` route HERE, unlike the C
 * route's own dedicated `tk_slice_char_eq`, because the two backends give `char` a DIFFERENT
 * physical representation. The C route's `char` is always a `{ptr,len}` VIEW (`tk_char`,
 * `teko_rt.h`); this backend's `char` is a plain DECODED CODEPOINT SCALAR everywhere
 * (`lower_char_lit`, `lower_char_compare`) — there is no view to dereference, so a packed array of
 * `char` elements here is already a packed array of codepoint integers, and codepoint-equality
 * (`memcmp`) already IS the correct per-element answer. Naming the SAME runtime symbol for two
 * backends whose representations for that element disagreed would be the bug this comment exists
 * to head off.
 *
 * EVERY OTHER ELEMENT SHAPE is an HONEST STOP, not a silent wrong answer: this backend does not
 * (yet) know how to lower it by value, and the checker's own `is_comparable` admits it anyway (it
 * only asks `type_eq`, not "and both backends can lower it") — this is where that gap surfaces,
 * loudly, naming the element type.
 *
 * @param checker::Type elem  the slice's resolved element type
 * @return LSliceEqPlan  the plan for that element shape
 * @throws  when `elem` is a shape this backend does not yet close (see above)
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn slice_eq_plan(elem: checker::Type) -> LSliceEqPlan | error {
    match elem {
        checker::Char => LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
        checker::Str => LSliceEqPlan { rtfn = "tk_slice_str_eq"; needs_size = false }
        checker::Byte => LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
        checker::Prim as p => slice_eq_plan_prim(p.kind)
        _ => error { message = teko::str::concat("native backend N1: `[]T == []T` is not lowered yet for element type `", checker::type_render(elem), "` (N2 — only numeric/bool/byte/char/str elements compare by value)") }
    }
}

/**
 * slice_eq_plan_prim — the `LSliceEqPlan` for a `Prim`-typed element: the float kinds get their
 * own per-element-`==` predicate, every integer/bool kind shares the generic `memcmp` route.
 *
 * @param checker::PrimKind k  the element's `PrimKind`
 * @return LSliceEqPlan  the plan for that kind
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn slice_eq_plan_prim(k: checker::PrimKind) -> LSliceEqPlan {
    if k == checker::PrimKind::F32 { return LSliceEqPlan { rtfn = "tk_slice_f32_eq"; needs_size = false } }
    if k == checker::PrimKind::F64 { return LSliceEqPlan { rtfn = "tk_slice_f64_eq"; needs_size = false } }
    LSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
}

/**
 * SliceEqArgs — the outcome of building `[]T == []T`'s runtime-call argument list: the advanced
 * context (a `needs_size` plan materializes one extra `const` instruction) plus the ordered VReg
 * argument list.
 */
pub type SliceEqArgs = struct { ctx: LowerCtx; args: []u32 }

/**
 * slice_eq_call_args — the ABI-flattened arguments of `[]T == []T`'s runtime call: `a.ptr, a.len,
 * b.ptr, b.len`, plus a trailing `sizeof(elem)` constant when `plan.needs_size` (the generic
 * `memcmp` route needs the element width; the dedicated float/char/str predicates bake it in).
 *
 * @param LowerCtx ctx  the lowering context to append the size constant into (when needed)
 * @param LoweredFat a  the left operand's (ptr, len) pair
 * @param LoweredFat b  the right operand's (ptr, len) pair
 * @param checker::Type elem  the slice's element type (its `ltype_of` width is the `sizeof`)
 * @param LSliceEqPlan plan  the plan chosen for `elem`
 * @param []LEnumInfo enums  the program's declared-enum table (`ltype_of`'s own required input)
 * @param u32 line  the source line to stamp the size constant with
 * @param u32 col  the source column to stamp the size constant with
 * @return SliceEqArgs  the (possibly advanced) context plus the ordered argument VRegs
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn slice_eq_call_args(ctx: LowerCtx, a: LoweredFat, b: LoweredFat, elem: checker::Type, plan: LSliceEqPlan, enums: []LEnumInfo, line: u32, col: u32) -> SliceEqArgs {
    mut args: []u32 = teko::list::empty()
    args = teko::list::push(args, a.ptr)
    args = teko::list::push(args, a.len)
    args = teko::list::push(args, b.ptr)
    args = teko::list::push(args, b.len)
    if !plan.needs_size { return SliceEqArgs { ctx = ctx; args = args } }
    let esz = ltype_size(ltype_of(elem, enums)) to i64
    let r = ctx_alloc(ctx)
    let with_c = ctx_append(r.ctx, const_int_inst(r.vreg, esz, line, col))
    SliceEqArgs { ctx = with_c; args = teko::list::push(args, r.vreg) }
}

/**
 * lower_slice_compare — `a == b` / `a != b` over two `[]T` operands, lowered to the runtime
 * predicate `slice_eq_plan` chose for `T`. Mirrors `lower_str_compare`'s shape exactly (ABI-
 * flattened operands, a `bool`-return call, the same zero-compare normalization) — only the
 * callee symbol and its argument count (the `needs_size` plans append one more) differ.
 *
 * @param LowerCtx ctx  the lowering context to append the call's instructions into
 * @param checker::TExpr e  the comparison expression (its source position)
 * @param checker::TCompare cmp  the comparison node (its `first` operand is a `[]T`)
 * @return Lowered  the advanced context + the bool VReg of the equality
 * @throws  for a CHAINED slice comparison (`a == b == c`), for an ordered operator, for an
 *          element shape `slice_eq_plan` does not close, or propagated from lowering either
 *          operand as a fat-pointer producer
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn lower_slice_compare(ctx: LowerCtx, e: checker::TExpr, cmp: checker::TCompare) -> Lowered | error {
    if cmp.rest.len != 1 { return error { message = "native backend N1: a CHAINED `[]T` comparison (`a == b == c`) is not lowered (N2)" } }
    let pred = match runtime_eq_predicate(cmp.rest[0].op, "[]T") { LBinOp as p => p; error as err => return err }
    let elem = slice_elem_of(cmp.first.type)
    let plan = match slice_eq_plan(elem) { LSliceEqPlan as p => p; error as err => return err }
    let a = match lower_fat_expr(ctx, cmp.first) { LoweredFat as x => x; error as err => return err }
    let b = match lower_fat_expr(a.ctx, cmp.rest[0].operand) { LoweredFat as x => x; error as err => return err }
    let built = slice_eq_call_args(b.ctx, a, b, elem, plan, ctx.enums, e.line, e.col)
    let called = ctx_alloc(built.ctx)
    let with_call = ctx_append(called.ctx, call_inst(called.vreg, plan.rtfn, built.args, false, e.line, e.col))
    let clean = runtime_eq_narrow(Lowered { ctx = with_call; vreg = called.vreg }, e.line, e.col)
    let zero = ctx_alloc(clean.ctx)
    let with_zero = ctx_append(zero.ctx, const_int_inst(zero.vreg, 0, e.line, e.col))
    let r = ctx_alloc(with_zero)
    Lowered { ctx = ctx_append(r.ctx, bin_inst(r.vreg, pred, clean.vreg, zero.vreg, e.line, e.col)); vreg = r.vreg }
}

/**
 * runtime_eq_narrow — the cleanup EVERY `bool`-returning runtime equality call needs (`tk_str_eq`,
 * `tk_slice_str_eq`, `tk_slice_char_eq`, `tk_slice_eq_bytes`, `tk_slice_f32_eq`, `tk_slice_f64_eq`):
 * zero-extend the LOW BYTE and discard everything above it.
 *
 * NOT decoration — it is the difference between an answer and a coin flip. A C `bool` return only
 * defines the low byte of the result register; each of these predicates' own body returns a
 * `bool`-typed expression, so the bits above that byte carry whatever the comparison left behind.
 * Testing the WHOLE register against zero therefore answered "equal" for two values that differ —
 * measured exactly that way, for `tk_str_eq`, before this narrowing was first added (degrau 7).
 * `extern_return_narrow` documents the same hole for a declared `extern fn` returning `bool` and
 * leaves it open there; every call site built on this helper closes it for itself.
 *
 * @param Lowered called  the already-appended call, its VReg holding the raw return register
 * @param u32 line  the source line to stamp the narrowing instruction with
 * @param u32 col  the source column to stamp the narrowing instruction with
 * @return Lowered  the advanced context + the narrowed (0/1) VReg
 * @since 0.3.1.0 (degrau 7 — string equality; generalized igualdade-char-slice)
 */
fn runtime_eq_narrow(called: Lowered, line: u32, col: u32) -> Lowered {
    narrow_extern_return(called, ExternNarrow { width = 8; is_signed = false }, line, col)
}

/**
 * runtime_eq_predicate — how a `bool`-returning runtime equality call's answer is turned into the
 * operator's own bool: `==` is "the answer is not zero", `!=` is "the answer is zero". Shared by
 * every fat-operand equality (`str`, `[]T`) — `char` needs no runtime call, so it has its own
 * direct `char_cmp_predicate` instead.
 *
 * @param lexer::TokenKind op  the comparison operator token
 * @param str shape  which fat shape is asking (`"str"` or `"[]T"`), named in the honest stop below
 * @return LBinOp  the predicate to compare the call's result against zero with
 * @throws  for an ORDERED operator (`<`, `<=`, `>`, `>=`) on the named shape
 * @since 0.3.1.0 (degrau 7 — string equality; generalized igualdade-char-slice)
 */
fn runtime_eq_predicate(op: lexer::TokenKind, shape: str) -> LBinOp | error {
    match op {
        lexer::TokenKind::EqEq => LBinOp::ICmpNe
        lexer::TokenKind::Ne => LBinOp::ICmpEq
        _ => error { message = teko::str::concat("native backend N1: an ORDERED `", shape, "` comparison (`<`/`<=`/`>`/`>=`) is not lowered (N2)") }
    }
}

