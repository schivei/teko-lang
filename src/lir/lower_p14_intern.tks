use teko::list
use teko::checker
use teko::parser

/**
 * lower_call_args — lower a call's whole argument list, taking the ADDRESS of any argument at a
 * `ref<T>` parameter position instead of its value (0.3.1.0 degrau 18: `checker::typer.tks`'s own
 * call-site AUTO-REF, `f(x)` into a `ref<T>` param — the checker keeps the argument's bare type
 * and leaves the address-of to codegen; the C route's `emit_call` emits `&x`, this is this
 * backend's OWN emission of that same contract). A callee with NO `ref` parameter (`find_ref_flags`
 * returns `null` — the overwhelming majority of calls) falls straight through to the plain
 * `lower_args`, unchanged.
 *
 * Every argument is additionally COERCED into its PARAMETER's declared type
 * (`callee_param_types`, degrau 25) — a call argument is a placement like a binding or a return,
 * and until this the own backend was the only one that did not treat it as one.
 *
 * @param ctx  the lowering context
 * @param c    the call node
 * @return     the advanced context + the ABI-flattened argument VRegs, in order
 * @throws     propagated from lowering any argument, or from `lower_addr_of_arg`
 */
fn lower_call_args(ctx: LowerCtx, c: checker::TCall) -> LoweredArgs | error {
    let params = callee_param_types(c)
    if c.callee.segments.len == 0 { return lower_args(ctx, c.args, params) }
    let last = c.callee.segments[c.callee.segments.len - 1].name
    match find_ref_flags(ctx.ref_fns, c.call_ns, last) {
        []bool as rf => lower_args_ref_aware(ctx, c.args, rf, params, 0)
        null => lower_args(ctx, c.args, params)
    }
}

/**
 * callee_param_types — the callee's DECLARED parameter types, in order, as the checker resolved
 * them (`TCall.callee_type`, the `Func` the checker attaches to a direct, closure or
 * interface-dispatch call); an EMPTY list for a call whose callee the checker left untyped (a
 * builtin, a generic instantiation) and for a VARIADIC callee, whose trailing arguments do not
 * correspond one-to-one with its declared parameters.
 *
 * An empty list means "coerce nothing", which is what every argument did before degrau 25 — so a
 * call shape this cannot answer for keeps its previous behaviour rather than guessing a placement.
 *
 * @param c  the call node
 * @return   the callee's parameter types, positionally parallel to `c.args`, or an empty list
 */
fn callee_param_types(c: checker::TCall) -> []checker::Type {
    match c.callee_type {
        checker::Func as f => if f.variadic { teko::list::empty() } else { f.params }
        _ => teko::list::empty()
    }
}

/**
 * param_type_at — the declared type of the parameter at index `i`, or `null` past the end of the
 * declared list (an argument `callee_param_types` cannot place).
 *
 * @param params  the callee's declared parameter types
 * @param i       the argument index
 * @return        the parameter's declared type, or `null`
 */
fn param_type_at(params: []checker::Type, i: u64) -> checker::Type | null {
    if i >= params.len { return null }
    params[i]
}

/**
 * lower_arg_into_param — lower ONE call argument COERCED into its parameter's declared type: a
 * UNION parameter (`union_field_placement` — the same predicate the struct-field placement uses,
 * since both ask "does this slot hold a tag+payload wrapper?") takes `lower_value_into_type` and
 * contributes its single wrapper-address word; every other parameter lowers exactly as
 * `lower_arg_vregs` already does, including a fat argument's (ptr, len) pair.
 *
 * @param ctx    the lowering context
 * @param decl   the parameter's declared type, or `null` when the callee's is unknown
 * @param arg    the argument expression
 * @return       the advanced context + the argument's VReg(s), in ABI order
 * @throws       propagated from lowering (or coercing) the argument
 */
fn lower_arg_into_param(ctx: LowerCtx, decl: checker::Type | null, arg: checker::TExpr) -> LoweredArgs | error {
    match union_field_placement(ctx, decl) {
        checker::Type as bound => {
            let lo = match lower_value_into_type(ctx, bound, arg) { Lowered as x => x; error as err => return err }
            LoweredArgs { ctx = lo.ctx; vregs = single_arg(lo.vreg) }
        }
        null => lower_arg_vregs(ctx, arg)
    }
}

/**
 * lower_args_ref_aware — `lower_args_from`'s ref-aware twin: at index `i`, when `rf[i]` is
 * true and `args[i]` needs auto-ref (`arg_needs_auto_ref`), lower the argument's ADDRESS
 * (`lower_addr_of_arg`) instead of its value; every other position lowers exactly as
 * `lower_arg_vregs` already does. `i >= rf.len` (a callee param this call's own arity check
 * already fixed the count of) is never a `ref` position, so it always takes the plain path.
 *
 * @param ctx     the lowering context
 * @param args    the full argument list
 * @param rf      the callee's `ref_flags` (`find_ref_flags`'s hit)
 * @param params  the callee's declared parameter types (`callee_param_types`), for the coercion
 *                every non-`ref` position takes
 * @param i       the next argument index to lower
 * @return        the advanced context + the ABI-flattened argument VRegs, in order
 * @throws        propagated from lowering any argument, or from `lower_addr_of_arg`
 */
fn lower_args_ref_aware(ctx: LowerCtx, args: []checker::TExpr, rf: []bool, params: []checker::Type, i: u64) -> LoweredArgs | error {
    if i >= args.len { return LoweredArgs { ctx = ctx; vregs = teko::list::empty() } }
    let is_ref_pos = i < rf.len && rf[i] && arg_needs_auto_ref(args[i])
    let one = match if is_ref_pos { lower_addr_of_arg(ctx, args[i]) } else { lower_arg_into_param(ctx, param_type_at(params, i), args[i]) } { LoweredArgs as x => x; error as err => return err }
    let rest = match lower_args_ref_aware(one.ctx, args, rf, params, i + 1) { LoweredArgs as x => x; error as err => return err }
    LoweredArgs { ctx = rest.ctx; vregs = append_vregs(one.vregs, rest.vregs) }
}

/**
 * lower_addr_of_arg — the ADDRESS of an auto-ref call argument. The checker admits exactly ONE
 * shape here (`checker::typer.tks`'s own auto-ref gate): a bare reference to a `mut` LOCAL
 * variable — never a field, an index, or a nested expression, since only a named lvalue can be
 * referenced. Splits three ways, one per memory model this backend already gives a `mut` local:
 *
 * - a FAT (`str`/`[]T`) local is UNCONDITIONALLY frame-slot-bound the moment it is declared
 *   `mut` (`bind_mutable_fat`, the list-builtin degrau — no `ref` involvement needed to earn
 *   that shape), so its address already exists: `lenv_lookup_fat_slot`'s hit IS it. Lowering the
 *   argument plainly (`lower_expr`/`lower_var`) would instead give the STRING'S OWN ptr VALUE —
 *   the content pointer, not the address of the `{ptr,len}` pair holding it — which is exactly
 *   the "passed a value where an address was needed" shape this whole degrau exists to fix, one
 *   level removed;
 * - an AGGREGATE-typed local (`struct`/`class`/a declared `Variant` —
 *   `!is_register_value_type`) is, in this backend's own memory model, ALREADY represented BY
 *   its address (§ NATIVE-AGG-SLICE-BY-ADDRESS) — the local's own VReg IS the address to pass,
 *   no different from any other read of it;
 * - a REGISTER-value local (every primitive, `byte`, an `enum`) has no address of its own UNLESS
 *   `collect_addr_taken_locals` already reified it into a memory slot at its binding site — which
 *   it always has, for every name this exact function reaches, because that pre-pass finds this
 *   SAME call site before any statement of the enclosing function lowers.
 *
 * @param ctx  the lowering context
 * @param arg  the argument expression (checker-proved: a bare `TVar` naming a `mut` local)
 * @return     the advanced context + the argument's address, as a single-VReg `LoweredArgs`
 * @throws     when `arg` is not a bound local `TVar` (an internal invariant break — the checker
 *             never admits any other shape here), or when a fat/register-value local is not
 *             found in its expected memory shape (an internal invariant break, never in
 *             well-typed source)
 */
fn lower_addr_of_arg(ctx: LowerCtx, arg: checker::TExpr) -> LoweredArgs | error {
    let lo = match lower_addr_of_place(ctx, arg) { Lowered as x => x; error as err => return err }
    LoweredArgs { ctx = lo.ctx; vregs = single_arg(lo.vreg) }
}

/**
 * lower_addr_of_place — the backend's ONE address-of primitive: the address of the storage the
 * bound local `place` names, in whichever of the three memory shapes this backend gives that local
 * (the three cases `lower_addr_of_arg`'s doc above enumerates one by one).
 *
 * It is shared by the TWO positions the surface can spell an address at — a `ref<T>` call ARGUMENT
 * (`lower_addr_of_arg`) and a `Reference`-bound PLACEMENT (`lower_value_into_reference`) — because
 * the two had drifted apart and only the argument was right: the argument position took the address
 * while the binding position handed the place to `own_bound_value`, which COPIED it, so
 * `ref r: Ch = d` bound a second 16-byte frame slot and a `tk_mem_copy` where the C route bound
 * `&d`. One primitive, one rule, both positions.
 *
 * @param ctx    the lowering context
 * @param place  the place expression (checker-proved: a bare `TVar` naming a `mut` local)
 * @return       the advanced context + the place's address in a single VReg
 * @throws       when `place` is not a bound local `TVar` (an internal invariant break — the checker
 *               never admits any other shape here), or when a fat/register-value local is not found
 *               in its expected memory shape (an internal invariant break, never in well-typed
 *               source)
 * @since        0.3.1 (own-backend `ref`-binding placement gap)
 */
fn lower_addr_of_place(ctx: LowerCtx, place: checker::TExpr) -> Lowered | error {
    let v = match place.kind { checker::TVar as vv => vv; _ => return error { message = "native backend N1: an address-of place must be a bound local (internal)" } }
    if is_fat_type(place.type) {
        let fslot = lenv_lookup_fat_slot(ctx.env, v.name)
        if !fslot.found { return error { message = teko::str::concat("native backend N1: `", teko::str::concat(v.name, "` is a fat `ref` target but is not a mutable fat local (internal)")) } }
        return Lowered { ctx = ctx; vreg = fslot.slot }
    }
    if !is_register_value_type(place.type, ctx.enums) { return lower_expr(ctx, place) }
    let slot = lenv_lookup_scalar_slot(ctx.env, v.name)
    if !slot.found { return error { message = teko::str::concat("native backend N1: `", teko::str::concat(v.name, "` is address-taken but was not reified to a slot (internal)")) } }
    Lowered { ctx = ctx; vreg = slot.slot }
}

/**
 * lower_call_fat_as_scalar — `lower_call`'s fat-result arm: `lower_call_fat`'s (ptr, len) pair,
 * keeping only the ptr half as this SCALAR call site's own single VReg (the len half is still
 * computed — the callee's hidden out-slot argument is never optional — just unread here, mirroring
 * how a fat local's ptr VReg alone still resolves under `lenv_lookup`'s plain, non-fat scan).
 *
 * @param ctx  the lowering context
 * @param e    the fat-typed call expression
 * @param c    the call node
 * @return     the advanced context + the call's ptr-half VReg
 * @throws     propagated from `lower_call_fat`
 */
fn lower_call_fat_as_scalar(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall) -> Lowered | error {
    let fo = match lower_call_fat(ctx, e, c) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = fo.ctx; vreg = fo.ptr }
}

/**
 * is_last_index_of_call — recognizes `teko::str::last_index_of`'s bare last segment: the ONE
 * host-FFI VARIANT-result builtin this N1 subset lowers directly (0.3.1.0 degrau 15). Its
 * `u64 | error` return is neither fat (`is_fat_type` — only `str`/`[]T` qualify) nor an ordinary
 * single-register scalar, so `lower_call` intercepts it BEFORE `call_symbol`'s plain resolver
 * table — the same early-interception shape `lower_call_fat` already uses for the growth-builtin/
 * `concat` families (`is_list_builtin_call`/`is_concat_builtin_call`).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee`'s bare last segment names `last_index_of`
 */
fn is_last_index_of_call(callee: parser::Path) -> bool {
    let segs = callee.segments
    segs.len > 0 && segs[segs.len - 1].name == "last_index_of"
}

/**
 * last_index_of_variant_members — `last_index_of`'s declared `u64 | error` return type's own
 * members, read straight off the call expression's resolved type (the checker's own builtin
 * table, `checker/scope.tks:649-654`, is the SOLE producer of this shape — a different shape
 * reaching here would be an invariant the checker breaks, not this backend).
 *
 * @param e  the call expression (its type is `last_index_of`'s declared return type)
 * @return   the variant's own two members, in declared order
 * @throws   when `e.type` is not a `Variant` (an internal invariant break)
 */
fn last_index_of_variant_members(e: checker::TExpr) -> []checker::Type | error {
    match e.type {
        checker::Variant as v => v.members
        _ => error { message = "native backend N1: `last_index_of`'s result is not a variant (internal)" }
    }
}

/**
 * lower_last_index_of_ok_arm — the FOUND arm's wrapper build: tag = the `u64` member's declared
 * index, payload = `value` (the byte index this call found) — a register value, so no boxing is
 * needed (`variant_payload_box_bytes`'s own 0-byte case, `store_scalar_variant_payload`'s doc).
 *
 * @param ctx      the lowering context, positioned in the found arm's own block
 * @param wrapper  the wrapper's alloca'd base address (already reserved, 24 bytes)
 * @param index    the `u64` member's declared tag index
 * @param value    the found byte index, already loaded out of the runtime's out-slot
 * @param line     the source line to stamp the emitted instructions with
 * @param col      the source column to stamp the emitted instructions with
 * @return         the advanced context; `wrapper` is the arm's own result
 */
fn lower_last_index_of_ok_arm(ctx: LowerCtx, wrapper: u32, index: i64, value: u32, line: u32, col: u32) -> LowerCtx {
    let tagged = store_variant_tag(ctx, wrapper, index, line, col)
    let addr = ctx_alloc(tagged.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, wrapper, variant_payload_offset(), line, col))
    ctx_append(with_addr, store_inst(addr.vreg, value, LType::I64, line, col))
}
