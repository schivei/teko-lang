use teko::checker

/**
 * lower_null_union_construct — build the own backend's uniform tag+payload wrapper for a value
 * coerced into a null-bearing two-member union (`null_union_shape`'s doc): allocate the uniform
 * `{ i32 tag@0; ptr@8; len@16 }` (`variant_wrapper_bytes` — the fixed layout
 * `lower_variant_tag_eq_test`/`bind_case_payload` read), then store `shape.null_index` for a
 * `Null`-typed value, or `shape.payload_index` plus the lowered payload for any other value.
 *
 * KEYED BY `e.type`, NOT `e.kind` (native-N1-null-widen, O1 retirement): a bare `TNullLit` and a
 * `match`/`if` sub-expression whose OWN inferred type collapsed to bare `Null` (every one of its
 * arms is, recursively, `null` — `checker::resolve.type_join`'s bare-null-only join) are the SAME
 * absence value from this coercion's point of view, and both are widened by
 * `lower_null_absent_widened` — the mirror of the C route's `emit_as_r`, which builds the wrapper
 * from the EXPECTED type rather than the source node's own kind (`codegen.tks:6816-6829`).
 *
 * A payload that is ITSELF a union takes the nested arm (`lower_null_union_nested_present`) — the
 * TWIN of the split degrau 23 gave `lower_variant_construct`, and the twin that had NOT diverged
 * along with it. `SqD25 { … }` placed into a `ShapeD25 | null` slot (`ShapeD25 = variant CircD25 |
 * SqD25`) used to store the bare `SqD25` struct's own address as the payload, so a later
 * `match s { CircD25 …; SqD25 … }` read that struct's FIRST FIELD as `ShapeD25`'s tag, matched no
 * arm, and fell through the whole `match` with no diagnostic — measured against a C route that
 * answered correctly. It is exactly degrau 23's defect on the null-bearing axis.
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param NullUnionShape shape  the union's non-null member type plus BOTH members' declared
 *                              indices; the payload type drives the payload's SHAPE (a fat member
 *                              writes both halves, a union member an inner wrapper, any other one
 *                              word)
 * @param checker::TExpr e  the value being coerced (a `TNullLit`, a `Null`-typed `match`/`if`
 *                          sub-expression, or an expression of the payload type)
 * @return Lowered  the wrapper's alloca'd base address
 * @throws  propagated from lowering a non-null payload expression, or a `Null`-typed sub-tree's own
 *          effects
 * @since 0.3.1 (null-union C7 own-backend gap); 0.3.1.0 degrau 25 (the nested
 *        union payload); 0.3.1.0 degrau 30 (the looked-up tags); native-N1-null-widen
 *        (O1 retirement — a non-literal `Null`-typed sub-tree)
 */
fn lower_null_union_construct(ctx: LowerCtx, shape: NullUnionShape, e: checker::TExpr) -> Lowered | error {
    match e.type {
        checker::Null => return lower_null_absent_widened(ctx, shape.null_index, e)
        _ => { }
    }
    if payload_needs_inner_wrapper(ctx, shape.payload, e) { return lower_null_union_nested_present(ctx, shape, e) }
    let base = ctx_alloc(ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    store_variant_payload(with_alloca, base.vreg, shape.payload_index to i64, shape.payload, e)
}

/**
 * lower_variant_absent — the ABSENT construction shared by every null-bearing union, at every
 * arity: the uniform wrapper with tag `index` and no payload written (absence carries none).
 * `lower_null_absent_widened`'s two callers (`lower_null_union_construct`'s `Null` arm and
 * `lower_variant_null_construct`'s only arm) both reduce to it through that shared widen, so a
 * two-member `T | null` and a three-member `T | null | error` build the SAME bytes and differ only
 * in the index they were handed.
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param i64 index  the `Null` member's declared index (`variant_null_member_index`)
 * @param checker::TExpr e  the `null`-typed value being widened (for its source position)
 * @return Lowered  the wrapper's alloca'd base address
 * @since 0.3.1.0 (degrau 25 — extracted so the present arms can each pick their own shape; degrau
 *        30 — the index became a parameter so any arity shares it)
 */
fn lower_variant_absent(ctx: LowerCtx, index: i64, e: checker::TExpr) -> Lowered {
    let base = ctx_alloc(ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    store_variant_tag(with_alloca, base.vreg, index, e.line, e.col)
}

/**
 * lower_null_absent_widened — the shared `Null`-typed widen `lower_null_union_construct` and
 * `lower_variant_null_construct` both reduce to: a bare `TNullLit` carries no side effects of its
 * own, so its absence wrapper (`lower_variant_absent`) is built directly, over the UNCHANGED `ctx`,
 * without lowering `e` at all (the pre-existing fast path — no extra instruction is emitted for the
 * overwhelmingly common case of a literal `null`). Any OTHER `Null`-typed `e` (a `match`/`if`
 * sub-expression whose every arm is, recursively, `null` — `checker::resolve.type_join`'s
 * bare-null-only join) is lowered IN PLACE first (`lower_expr` — its own nested arms carry the SAME
 * narrow `Null` target type this backend already threads down at every match/if arm and tail
 * position, so each leaf `null` literal reduces harmlessly through `lower_null_lit`'s plain zero
 * constant), then the resulting register is discarded and the SAME absence wrapper is tagged over
 * the ADVANCED context — `e`'s own control flow and side effects (an early `return` nested inside
 * one of its arms, a call with side effects) run exactly once, in their original position, before
 * the ABSENT tag is written.
 *
 * @param LowerCtx ctx  the lowering context to append `e`'s instructions (when any), then the
 *                      wrapper's, into
 * @param u32 index  the `Null` member's declared index (`shape.null_index`/`variant_null_member_index`)
 * @param checker::TExpr e  the `Null`-typed value being widened into the union — a `TNullLit`, or a
 *                          collapsed `match`/`if` sub-expression
 * @return Lowered  the wrapper's alloca'd base address
 * @throws  propagated from lowering a non-literal `e`
 * @since native-N1-null-widen (O1 retirement — the native-lowering gap O1 exposed at
 *        `teko::checker::check_must_free_locals_stmt`'s own nested `match` tail)
 */
fn lower_null_absent_widened(ctx: LowerCtx, index: u32, e: checker::TExpr) -> Lowered | error {
    match e.kind {
        checker::TNullLit => lower_variant_absent(ctx, index to i64, e)
        _ => {
            let lowered = match lower_expr(ctx, e) { Lowered as x => x; error as err => return err }
            lower_variant_absent(lowered.ctx, index to i64, e)
        }
    }
}

/**
 * payload_needs_inner_wrapper — is `payload` itself a union (an inline `A | B`, or a nominal naming
 * a declared `variant`) that `e` is NOT already a value of? Then `e` is a bare CASE of that inner
 * union and needs its own wrapper built before this level can store it — the same question
 * `lower_variant_construct`'s DIRECT-vs-NESTED split answers on the general-variant axis.
 *
 * @param ctx      the lowering context (its declared-`variant` table expands a nominal union)
 * @param payload  the enclosing union's non-null member type
 * @param e        the value being placed into the payload
 * @return         whether an inner wrapper must be built for `e` first
 * @since 0.3.1.0 (degrau 25 — the nested union payload)
 */
fn payload_needs_inner_wrapper(ctx: LowerCtx, payload: checker::Type, e: checker::TExpr) -> bool {
    match expand_named_variant(payload, ctx.variants) {
        checker::Variant => match expand_named_variant(e.type, ctx.variants) { checker::Variant => false; _ => true }
        _ => false
    }
}

/**
 * lower_null_union_nested_present — the NESTED-payload arm of `lower_null_union_construct`: build
 * `e`'s own wrapper against the payload union first (`lower_value_into_type`, so nesting resolves to
 * any depth), then store THAT wrapper's address as this level's payload, boxed at the payload
 * union's own registered width (`store_scalar_variant_payload_value`) exactly as
 * `lower_nested_variant_construct` boxes its own inner wrapper.
 *
 * @param ctx    the lowering context to append the construction's instructions into
 * @param shape  the enclosing union's shape; its payload member is itself a union
 * @param e      the bare case value being placed into the payload
 * @return Lowered  the OUTER wrapper's alloca'd base address
 * @throws  propagated from the inner construction, or when the payload union's width is not pinned
 * @since 0.3.1.0 (degrau 25 — the nested union payload; degrau 30 — the looked-up tag)
 */
fn lower_null_union_nested_present(ctx: LowerCtx, shape: NullUnionShape, e: checker::TExpr) -> Lowered | error {
    let inner = match lower_value_into_type(ctx, shape.payload, e) { Lowered as x => x; error as err => return err }
    let base = ctx_alloc(inner.ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    let tagged = store_variant_tag(with_alloca, base.vreg, shape.payload_index to i64, e.line, e.col)
    store_scalar_variant_payload_value(base.vreg, shape.payload, Lowered { ctx = tagged.ctx; vreg = inner.vreg }, e)
}

/**
 * lower_variant_construct — build the own backend's uniform tag+payload wrapper for a bare case
 * `value` flowing into a GENERAL (non-null-bearing) declared variant `v`. A DIRECT member (`value`'s
 * type IS one of `v`'s own members, `direct_variant_member_index`) stores `value`'s own natural
 * representation at the found index — the pre-degrau-23 behavior, unchanged. A NESTED member
 * (`value`'s type belongs to a `Named`-alias member's OWN declared expansion, not to `v` directly —
 * degrau 23, #382: `P{}` flowing into `-> Outer | error`, `Outer = variant P | Q`) instead RECURSES
 * (`lower_nested_variant_construct`): a raw leaf address stored directly at the alias's OWN position
 * would have discarded WHICH of the alias's own members `value` is — a later `match` against the
 * alias's own members would then have read the leaf's own bytes as if they were ITS tag (a silent
 * WRONG ANSWER, not a stop — confirmed by disassembling the two-level `Outer = variant P | Q`
 * repro: the inner match's tag test read the boxed `P`/`Q` struct's own first field).
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param checker::Variant v  the declared variant `value` is placed into
 * @param checker::TExpr value  the bare case value being wrapped
 * @return Lowered  the wrapper's alloca'd base address
 * @throws  propagated from lowering `value`, or when its type names no member of `v` (directly or
 *          through one level — or several — of named-alias nesting)
 * @since 0.3.1 (own-backend general variant construction, degrau N2; degrau 23 widened it to a
 *        nested named-variant alias member, #382)
 */
fn lower_variant_construct(ctx: LowerCtx, v: checker::Variant, value: checker::TExpr) -> Lowered | error {
    match direct_variant_member_index(v.members, value.type) {
        u32 as index => build_variant_wrapper(ctx, index to i64, value.type, value)
        null => lower_nested_variant_construct(ctx, v, value)
    }
}

/**
 * build_variant_wrapper — alloca the uniform 24-byte wrapper and store `index`/`value` as its
 * tag/payload (`store_variant_payload`): the DIRECT-member construction `lower_variant_construct`
 * shares with its own alias-recursion arm's innermost wrapper (`lower_nested_variant_construct`).
 *
 * @param LowerCtx ctx  the lowering context to append the construction's instructions into
 * @param i64 index  the matched member's declared tag index
 * @param checker::Type pty  the payload's declared type (fixes its machine class + box width)
 * @param checker::TExpr value  the payload value to lower and store
 * @return Lowered  the wrapper's alloca'd base address
 * @throws  propagated from lowering `value`
 * @since 0.3.1.0 (degrau 23 — factored out of `lower_variant_construct`, #382)
 */
fn build_variant_wrapper(ctx: LowerCtx, index: i64, pty: checker::Type, value: checker::TExpr) -> Lowered | error {
    let base = ctx_alloc(ctx)
    let with_alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), value.line, value.col))
    store_variant_payload(with_alloca, base.vreg, index, pty, value)
}

/**
 * direct_variant_member_index — `value_ty`'s index among `members`, DIRECT membership only (no
 * alias recursion): a `Named` member matches by exact canonical name (`variant_named_directly`),
 * every other kind by its own KIND. The base case `lower_variant_construct` falls back from into
 * its alias-recursion arm (`lower_nested_variant_construct`) when this answers `null`.
 *
 * @param []checker::Type members  the variant's declared members, in order
 * @param checker::Type value_ty  the value's own resolved type
 * @return u32?  the matching member's declared index, or `null` when none matches DIRECTLY
 * @since 0.3.1.0 (degrau 23 — split out of the pre-degrau-23 `variant_member_type_matches`, #382)
 */
fn direct_variant_member_index(members: []checker::Type, value_ty: checker::Type) -> u32 | null {
    mut i: u64 = 0
    loop {
        if i >= members.len { break }
        if variant_member_direct_match(members[i], value_ty) { return i to u32 }
        i++
    }
    null
}

/**
 * variant_member_direct_match — does variant member `member` match a value of type `value_ty`
 * WITHOUT recursing into a `Named` member's own declared expansion? The exact predicate
 * `variant_member_type_matches` used before degrau 23 widened its `Named` arm; kept separate
 * because the construction side needs to tell "matched directly" (store `value` as-is) apart from
 * "matched through an alias" (`lower_nested_variant_construct` must build a NESTED wrapper
 * instead) — a distinction the recursive, boolean-only `variant_member_type_matches` collapses on
 * purpose, since its own callers (comparison) only ever need the yes/no answer.
 *
 * @param checker::Type member  one of the variant's declared members
 * @param checker::Type value_ty  the value's own resolved type
 * @return bool  whether `member` is DIRECTLY the case `value_ty` belongs to
 */
fn variant_member_direct_match(member: checker::Type, value_ty: checker::Type) -> bool {
    match member {
        checker::Named as mn => variant_named_directly(mn.name, value_ty)
        checker::Error => match value_ty { checker::Error => true; _ => false }
        checker::Prim as mp => match value_ty { checker::Prim as vp => mp.kind == vp.kind; _ => false }
        checker::Str => match value_ty { checker::Str => true; _ => false }
        checker::Byte => match value_ty { checker::Byte => true; _ => false }
        checker::Slice => match value_ty { checker::Slice => true; _ => false }
        _ => false
    }
}

/**
 * NestedAliasMember — a `v.members` slot whose OWN declared expansion (not `v` directly) covers
 * the value being constructed: its declared index within `v.members` (`lower_variant_construct`'s
 * OUTER tag), its own canonical name (so the OUTER payload can be boxed at the alias's uniform
 * 24-byte width, `aggregate_box_bytes`'s `Named` arm expanding it back to a `Variant`), and its own
 * expanded member list (what the INNER wrapper is recursively built against).
 */
type NestedAliasMember = struct {
// index — the alias member's own declared position within the OUTER `v.members`.
    index: u32
// name — the alias's own canonical name (its declared-variant table key).
    name: str
// expansion — the alias's own declared expansion, the INNER wrapper's own member list.
    expansion: checker::Variant
}
