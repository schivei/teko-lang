use teko::checker
use teko::lexer
use teko::parser

/**
 * store_struct_fields — lower each field value in turn, storing it at its layout offset from
 * `base` (`store_struct_field`) and COERCED into that field's own declared type
 * (`find_field_decl_type` over `ctx.field_decls`, keyed by the layout's own declaration name);
 * the result VReg is `base` itself (the struct's address, unchanged by the stores).
 *
 * @param ctx  the lowering context to append the stores into
 * @param base  the struct slot's alloca'd base-address VReg
 * @param layout  the struct's registered layout (its name is the declared-field-type lookup key)
 * @param field_names  the field names the literal actually writes, in written order
 * @param field_vals  the values written, parallel to `field_names`
 * @param line  the literal's source line
 * @param col  the literal's source column
 * @return Lowered  the advanced context plus `base`
 * @throws  when a written field is not registered on `layout`, or propagated from storing a value
 */
fn store_struct_fields(ctx: LowerCtx, base: u32, layout: LStructLayout, field_names: []str, field_vals: []checker::TExpr, line: u32, col: u32) -> Lowered | error {
    mut cur = ctx
    mut i: u64 = 0
    loop {
        if i >= field_names.len { break }
        let off = match field_offset_of(layout, field_names[i]) { u32 as o => o; error as err => return err }
        let decl = find_field_decl_type(ctx.field_decls, layout.name, field_names[i])
        match check_store_fat_span(cur, layout, field_names[i], decl, field_vals[i]) { error as err => return err; null => { } }
        cur = match store_struct_field(cur, base, off, decl, field_vals[i], line, col) { LowerCtx as c => c; error as err => return err }
        i++
    }
    Lowered { ctx = cur; vreg = base }
}

/**
 * find_field_decl_type — the DECLARED type of `field` on the declaration named `sname`, or `null`
 * when the program's field-declaration table (`collect_field_decls`) holds no resolved type for it
 * — a synthetic layout with no declaration behind it (the `error` type, a closure env), or an
 * annotation that did not resolve (a generic type parameter). A `null` answer means "place the
 * value with no coercion", which is what every field store did before this table existed.
 *
 * @param decls  the program's declared-field-type table
 * @param sname  the declaration's canonical name (the layout's own key)
 * @param field  the field name to look up
 * @return  the field's declared type, or `null` when the table names none
 */
fn find_field_decl_type(decls: []LFieldDecls, sname: str, field: str) -> checker::Type | null {
    mut i: u64 = 0
    loop {
        if i >= decls.len { break }
        if decls[i].name == sname { return field_type_in_decls(decls[i], field) }
        i++
    }
    null
}

/**
 * field_type_in_decls — `field`'s resolved declared type within ONE declaration's entry, or `null`
 * when the entry does not name it or resolved it to the `Void` "did not resolve" marker
 * (`field_decls_of`).
 *
 * @param fd  the declaration's declared-field-type entry
 * @param field  the field name to look up
 * @return  the field's declared type, or `null`
 */
fn field_type_in_decls(fd: LFieldDecls, field: str) -> checker::Type | null {
    mut i: u64 = 0
    loop {
        if i >= fd.field_names.len { break }
        if fd.field_names[i] == field {
            match fd.field_types[i] { checker::Void => return null; _ => return fd.field_types[i] }
        }
        i++
    }
    null
}

/**
 * union_field_placement — the field's declared type WHEN that type is a union whose slot holds a
 * tag+payload wrapper (an inline `A | B` or a nominal `Named` naming a declared `variant`,
 * `expand_named_variant`); `null` for every other declared type, and for a field the
 * declared-field-type table names none for.
 *
 * Splitting this out is what keeps the store site's THREE shapes from colliding: a union field
 * always holds ONE word (the wrapper's address), so it must be decided BEFORE the fat-pointer
 * arm — a `str | null` field is not fat even though a `str` value flowing into it is.
 *
 * @param ctx  the lowering context (its declared-`variant` table expands a nominal union)
 * @param decl  the field's declared type, or `null` when the table names none
 * @return  the declared type when it is a union placement, else `null`
 */
fn union_field_placement(ctx: LowerCtx, decl: checker::Type | null) -> checker::Type | null {
    let d = match decl { checker::Type as t => t; null => return null }
    match expand_named_variant(d, ctx.variants) { checker::Variant => d; _ => null }
}

/**
 * store_struct_field — store ONE struct-literal field value at `base + offset`, in the ONE shape
 * the field's DECLARED type calls for:
 *
 * - a UNION field (`union_field_placement`) holds the tag+payload wrapper's ADDRESS, so the value
 *   is COERCED into the union first (`lower_value_into_type`, the same routine a binding, an
 *   assignment and a return already place their values through) and its single word is stored;
 * - a FAT field (`value.type`, 0.3.1.0 raiz A — R3) lowers through the fat-pointer producer path
 *   and writes BOTH halves of its `{ptr, len}` pair (`store_fat_slot`, the SAME shape the
 *   array-literal's fat element and a mutable fat local's frame slot both use);
 * - every other field lowers plainly and writes its single machine word.
 *
 * Before the FAT arm, EVERY field wrote one machine word (`ltype_of(field_vals[i].type)`, always
 * 8 bytes for `str`/`[]T` — `ltype_of` collapses both to `Ptr`), so a struct's `str`/`[]T`
 * field's LENGTH half was never written: `lower_fat_field`'s own 16-byte read (#594 T-B6)
 * then read whatever garbage the fresh `alloca` happened to hold at `off+8`, measured to read
 * back `.len == 0` — silently, not a compile-time stop (0.3.1.0 raiz-comum, §5.1-5.4).
 *
 * Before the UNION arm (0.3.1.0 degrau 25) the same class of defect sat on the union axis: a bare
 * `null` written into a `T | null` field honest-stopped (`lower_null_lit`) and a bare `T` was
 * stored UNWRAPPED, which a later `match` read as the wrapper's base address — measured as a
 * SIGSEGV where the C route answered correctly.
 *
 * The UNION arm then OWNS its wrapper (`box_aggregate_value_at`, `variant_wrapper_bytes`), the same
 * per-EXECUTION copy every other embedded aggregate takes (`own_embedded_value`). The 24-byte wrapper
 * `lower_value_into_type` hands back is a per-INSTRUCTION frame `alloca` — even the pass-through
 * `lower_expr` arm of `lower_value_into_variant` returns one, since `SomeVariant{…}` is variant-typed
 * yet builds a FRESH wrapper — so a field pointed straight at it aliased ONE slot across every
 * iteration of a construction loop and dangled once the building frame unwound. Measured: a
 * `[]parser::Item` whose element `Item{content = decl}` the assembler builds per file read every
 * element's `content` back as the LAST one's, then `checker::type_item` matched a reused slot's bits
 * (`NATIVE-AGG-SLICE-BY-ADDRESS`). The wrapper's own PAYLOAD is already boxed at construction
 * (`store_scalar_variant_payload`, degrau 8), so owning the 24-byte wrapper is the whole of it.
 *
 * @param ctx  the lowering context to append the store into
 * @param base  the struct slot's alloca'd base-address VReg
 * @param offset  the field's byte offset within the slot
 * @param decl  the field's declared type, or `null` when the table names none
 * @param value  the value written into the field
 * @param line  the literal's source line
 * @param col  the literal's source column
 * @return LowerCtx  the advanced context
 * @throws  propagated from lowering (or coercing) `value`
 */
fn store_struct_field(ctx: LowerCtx, base: u32, offset: u32, decl: checker::Type | null, value: checker::TExpr, line: u32, col: u32) -> LowerCtx | error {
    match union_field_placement(ctx, decl) {
        checker::Type as bound => {
            let uo = match lower_value_into_type(ctx, bound, value) { Lowered as x => x; error as err => return err }
            let owned = box_aggregate_value_at(uo, variant_wrapper_bytes(), line, col)
            let uaddr = ctx_alloc(owned.ctx)
            let with_uaddr = ctx_append(uaddr.ctx, field_addr_inst(uaddr.vreg, base, offset, line, col))
            return ctx_append(with_uaddr, store_inst(uaddr.vreg, owned.vreg, LType::Ptr, line, col))
        }
        null => { }
    }
    if is_fat_type(value.type) {
        let fo = match lower_fat_expr(ctx, value) { LoweredFat as x => x; error as err => return err }
        let addr = ctx_alloc(fo.ctx)
        let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, offset, line, col))
        return store_fat_slot(with_addr, addr.vreg, fo, line, col)
    }
    let raw = match lower_expr(ctx, value) { Lowered as x => x; error as err => return err }
    let vo = own_embedded_value(raw, value)
    let addr = ctx_alloc(vo.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, base, offset, line, col))
    ctx_append(with_addr, store_inst(addr.vreg, vo.vreg, ltype_of(value.type, vo.ctx.enums), line, col))
}

/** lower_field_access — `recv.field` on a struct receiver: lower the receiver to its base
    address, compute the field's address via its registered layout offset, then load its
    value. `.len` on a str/slice receiver (A1-4, #382) reads the receiver's ALREADY-CARRIED
    length VReg instead — no memory traffic. `Ref<T>.value` on a NON-fat `T` (`is_ref_deref`)
    dereferences the handle directly (`lower_ref_deref_read`) — a FAT `T` reaches this backend
    through `lower_fat_field`'s OWN `Ref<T>.value` arm instead, never this one. */
fn lower_field_access(ctx: LowerCtx, e: checker::TExpr, fa: checker::TFieldAccess) -> Lowered | error {
    if fa.field == "len" && is_fat_type(fa.receiver.type) { return lower_len_field(ctx, fa) }
    if is_ref_deref(fa) { return lower_ref_deref_read(ctx, e, fa) }
    let ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    let name = match named_type_name(fa.receiver.type) { str as s => s; error as err => return err }
    let layout = match find_struct_layout(ro.ctx.layouts, name) { LStructLayout as l => l; error as err => return err }
    let off = match field_offset_of(layout, fa.field) { u32 as o => o; error as err => return err }
    let addr = ctx_alloc(ro.ctx)
    let with_addr = ctx_append(addr.ctx, field_addr_inst(addr.vreg, ro.vreg, off, e.line, e.col))
    let r = ctx_alloc(with_addr)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, addr.vreg, ltype_of(e.type, r.ctx.enums), e.line, e.col)); vreg = r.vreg }
}

/**
 * is_ref_deref — is `fa` a `Ref<T>.value` dereference (the ONE field a `Reference` receiver
 * exposes, `checker::type_field_access`'s own gate)? Shared by `lower_field_access` (a scalar
 * or aggregate `T`) and `lower_fat_field` (a fat `T`) so the two agree on which receiver shape
 * this is, rather than each re-deriving it.
 *
 * @param fa  the field access to classify
 * @return    whether `fa.receiver` is `Reference`-typed and `fa.field` is `"value"`
 */
fn is_ref_deref(fa: checker::TFieldAccess) -> bool {
    fa.field == "value" && match fa.receiver.type { checker::Reference => true; _ => false }
}

/**
 * lower_ref_deref_read — `recv.value` on a `Reference` receiver, `T` NOT fat: the handle's own
 * value already IS the address to read (no `field_addr` computation, unlike a struct field —
 * the handle is not itself a struct). A REGISTER-value `T` (`is_register_value_type` — every
 * primitive, `byte`, an `enum`) is genuinely stored AT that address and must be LOADED; an
 * AGGREGATE `T` (`struct`/`class`/a declared `Variant`) is, in this backend's own
 * memory model, already represented BY its address (§ NATIVE-AGG-SLICE-BY-ADDRESS) — the SAME
 * address `Ref<T>` itself carries — so the deref is a passthrough of the handle's own VReg, not
 * a load: loading eight bytes FROM that address would read whatever the pointee's OWN first
 * field holds, not the pointee's address.
 *
 * @param ctx  the lowering context
 * @param e    the field-access expression (its type is `T`, the referenced type)
 * @param fa   the field access (`fa.receiver` is `Reference`-typed, `fa.field` is `"value"`)
 * @return     the dereferenced value
 * @throws     propagated from lowering the receiver
 */
fn lower_ref_deref_read(ctx: LowerCtx, e: checker::TExpr, fa: checker::TFieldAccess) -> Lowered | error {
    let ro = match lower_expr(ctx, fa.receiver) { Lowered as x => x; error as err => return err }
    if !is_register_value_type(e.type, ro.ctx.enums) { return Lowered { ctx = ro.ctx; vreg = ro.vreg } }
    let r = ctx_alloc(ro.ctx)
    Lowered { ctx = ctx_append(r.ctx, load_inst(r.vreg, ro.vreg, ltype_of(e.type, r.ctx.enums), e.line, e.col)); vreg = r.vreg }
}

/** lower_len_field — `recv.len` on a str/slice receiver: the length half of the receiver's
    already-lowered fat pair, read directly (no `load` — A1-4, #382, §2.3). */
fn lower_len_field(ctx: LowerCtx, fa: checker::TFieldAccess) -> Lowered | error {
    let fo = match lower_fat_expr(ctx, fa.receiver) { LoweredFat as x => x; error as err => return err }
    Lowered { ctx = fo.ctx; vreg = fo.len }
}

/** slice_element_type — the element type of a `[]T` (Slice) type; any other receiver shape
    (a `str`'s fat pointer arrives with A1-4) is out of the A1-3 subset. */
fn slice_element_type(t: checker::Type) -> checker::Type | error {
    match t {
        checker::Slice as s => s.element
        _ => error { message = "native backend N1: index receiver is not a slice (N2)" }
    }
}

/**
 * const_index_addr — a CONSTANT index folds directly into a static byte offset (`index * stride`),
 * a single `field_addr` with no runtime multiply. The fold survives the bounds guard
 * (`guarded_index_addr`) because the guard needs the index in a REGISTER, not in the address: the
 * literal is materialized once for the compare and the address stays one instruction.
 *
 * @param ctx        the lowering context, positioned after the index is checked
 * @param base       the buffer's base address VReg
 * @param idx_value  the literal index
 * @param stride     the element's byte stride inside the buffer (`elem_byte_stride`)
 * @param line       the source line of the subscript
 * @param col        the source column of the subscript
 * @return           the element's address
 */
fn const_index_addr(ctx: LowerCtx, base: u32, idx_value: i64, stride: u32, line: u32, col: u32) -> Lowered {
    let offset = (idx_value * stride) to u32
    let r = ctx_alloc(ctx)
    Lowered { ctx = ctx_append(r.ctx, field_addr_inst(r.vreg, base, offset, line, col)); vreg = r.vreg }
}

