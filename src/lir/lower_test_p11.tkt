use teko::checker
use teko::lexer
use teko::parser

/**
 * lwt_lowers_str_if_value_merges_both_ptr_and_len_at_the_fat_merge — the degrau-5 proof at
 * the LIR level: `let s = if cond { "a" } else { "bb" }; return s.len` used to HONEST-STOP
 * with "fat-pointer receiver `if-expression` not yet lowered (N2)" because `lower_fat_expr`'s
 * closed producer set had no `if`-expression arm. `lower_if_fat` now merges BOTH the ptr and
 * the len through a two-block-param merge (`#B3(%3, %4)`, ptr FIRST then len). A merge that
 * only carried the ptr would still COMPILE (the checker cannot see a fat-pointer ABI
 * mismatch) and silently read a garbage length past the binding — exactly the failure mode
 * no compile-only test catches, so this fixture asserts each arm's OWN literal length
 * ("a" -> 1, "bb" -> 2) reaches the merge's SECOND param, and that `s.len` past the binding
 * reads that merge param directly, with no memory traffic.
 *
 * @return void
 */
#test
fn lwt_lowers_str_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("a")))
    let else_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("bb")))
    let if_str = lwt_if_value_typed(cond, then_blk, else_blk, checker::Str { })
    let s_bind = lwt_bind_typed("s", if_str, checker::Str { })
    let len_access = lwt_len_field(lwt_typed_var("s", checker::Str { }))
    let body = teko::list::push(teko::list::push(teko::list::empty(), s_bind), lwt_ret(len_access))
    let f = lwt_fn("str_if_value", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "rodata .Lstr0: [97]")
    teko::assert::str_contains(text, "rodata .Lstr1: [98, 98]")
    teko::assert::str_contains(text, "  #B1:\n    %5 = global_addr @.Lstr0\n    %6 = const 1\n    jump #B3(%5, %6)")
    teko::assert::str_contains(text, "  #B2:\n    %7 = global_addr @.Lstr1\n    %8 = const 2\n    jump #B3(%7, %8)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

/**
 * lwt_lowers_slice_if_value_merges_both_ptr_and_len_at_the_fat_merge — the `[]T` sibling of
 * the `str` fixture above: `let xs = if cond { [10] } else { [20, 30] }; return xs.len` also
 * merges through a two-param fat merge, each arm's OWN element count (1 vs 2) reaching the
 * merge's SECOND param — the array-literal producer's own alloca+store sequence is unchanged
 * (`lower_array_lit_fat`'s doc), only the `if`-merge threading is new (degrau 5).
 *
 * @return void
 */
#test
fn lwt_lowers_slice_if_value_merges_both_ptr_and_len_at_the_fat_merge() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::EqEq, lwt_num_i64(1))))
    let one_elem = teko::list::push(teko::list::empty(), lwt_num_i64(10))
    let two_elems = teko::list::push(teko::list::push(teko::list::empty(), lwt_num_i64(20)), lwt_num_i64(30))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_array_lit(one_elem, checker::PrimKind::I64)))
    let else_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_array_lit(two_elems, checker::PrimKind::I64)))
    let slice_ty = checker::Slice { element = lwt_prim(checker::PrimKind::I64) }
    let if_slice = lwt_if_value_typed(cond, then_blk, else_blk, slice_ty)
    let xs_bind = lwt_bind_typed("xs", if_slice, slice_ty)
    let len_access = lwt_len_field(lwt_typed_var("xs", slice_ty))
    let body = teko::list::push(teko::list::push(teko::list::empty(), xs_bind), lwt_ret(len_access))
    let f = lwt_fn("slice_if_value", "teko::demo", teko::list::empty(), lwt_prim(checker::PrimKind::U64), body)
    let lf = match lower_function(f) { LoweredFunction as x => x.func; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(add_func(empty_module(), lf))
    teko::assert::str_contains(text, "  #B1:\n    %5 = alloca 8, align 8\n    %6 = const 10\n    %7 = field_addr %5, 0\n    store.i64 %7, %6\n    %8 = const 8\n    %9 = call @tk_slice_elem_box(%5, %8)\n    %10 = const 1\n    jump #B3(%9, %10)")
    teko::assert::str_contains(text, "%11 = alloca 16, align 8")
    teko::assert::str_contains(text, "%18 = const 2\n    jump #B3(%17, %18)")
    teko::assert::str_contains(text, "  #B3(%3, %4):\n    ret %4")
}

/**
 * lwt_honest_stop_on_fat_if_without_else_as_a_value — the FAT-value mirror of
 * `lwt_honest_stop_on_if_without_else_as_a_value`: an `if` with no `else` used as a fat
 * (`str`/`[]T`) value is out of the N1 subset exactly like its scalar sibling — `lower_if_fat`
 * honest-stops before touching any block/merge machinery (degrau 5).
 *
 * @return void
 */
#test
fn lwt_honest_stop_on_fat_if_without_else_as_a_value() {
    let cond = lwt_cmp(lwt_num_i64(1), teko::list::push(teko::list::empty(), lwt_cmp_term(lexer::TokenKind::Lt, lwt_num_i64(2))))
    let then_blk = teko::list::push(teko::list::empty(), lwt_exprstmt(lwt_strlit("a")))
    let ifexpr = checker::TExpr { kind = checker::TIfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = then_blk }; type = checker::Str { }; line = 0; col = 0 }
    teko::assert::str_contains(lwt_lower_expr_text(lwt_len_field(ifexpr)), "if-without-else used as a fat value not yet lowered")
}

/**
 * lwt_lowers_str_returning_function_stores_length_through_hidden_out_slot — the call-gordo
 * degrau's CALLEE-side proof: a `fn` declared `-> str` reserves ONE hidden TRAILING parameter
 * register past its (zero, here) declared ones (`%0 = param 0`), and its `return "hi"` stores
 * the literal's length (2) through that slot (`store.i64 %0, %2`) before the ordinary
 * single-VReg `LRet` carries the ptr half (`ret %1`) — `bind_ret_len_slot`'s own contract.
 *
 * @return void
 */
#test
fn lwt_lowers_str_returning_function_stores_length_through_hidden_out_slot() {
    let body = teko::list::push(teko::list::empty(), lwt_ret(lwt_strlit("hi")))
    let f = lwt_fn("make_str", "teko::demo", teko::list::empty(), checker::Str { }, body)
    let lfo = match lower_function(f) { LoweredFunction as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(with_rodata(add_func(empty_module(), lfo.func), lfo.rodata))
    teko::assert::str_contains(text, "func @teko_teko__demo__make_str(%0: ptr) -> ptr {")
    teko::assert::str_contains(text, "%0 = param 0")
    teko::assert::str_contains(text, "%1 = global_addr @.Lstr0")
    teko::assert::str_contains(text, "%2 = const 2")
    teko::assert::str_contains(text, "store.i64 %0, %2")
    teko::assert::str_contains(text, "ret %1")
}

/**
 * lwt_lowers_str_call_result_allocates_out_slot_and_loads_the_length_back — the call-gordo
 * degrau's CALLER-side proof: `make_str().len` (a direct `TCall` receiver `lower_fat_expr`
 * previously honest-stopped on, "fat-pointer receiver `call` not yet lowered") now allocates
 * an 8-byte out-slot (`%0 = alloca 8, align 8`), passes its address as the call's ONE (here,
 * only) argument (`%1 = call @teko_teko__demo__make_str(%0)`), and loads the length back out
 * of it afterward (`%2 = load.i64 %0`) — `lower_call_fat`'s own caller-side contract, the
 * mirror of the callee-side fixture above.
 *
 * @return void
 */
#test
fn lwt_lowers_str_call_result_allocates_out_slot_and_loads_the_length_back() {
    let call = lwt_call(lwt_path1("make_str"), "teko::demo", teko::list::empty(), checker::Str { })
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "%0 = alloca 8, align 8")
    teko::assert::str_contains(text, "%1 = call @teko_teko__demo__make_str(%0)")
    teko::assert::str_contains(text, "%2 = load.i64 %0")
}

/**
 * lwt_lowers_fat_closure_call_result_with_hidden_out_slot — a closure-call whose result is fat
 * now lowers through the same hidden out-slot caller contract as direct fat calls: the call site
 * allocates an 8-byte slot, passes it as the trailing argument to `call.indirect`, then loads
 * the length back (`load.i64`) for the surrounding `.len` read.
 *
 * @return void
 */
#test
fn lwt_lowers_fat_closure_call_result_with_hidden_out_slot() {
    let fty = lwt_func_type(teko::list::empty(), checker::Str { })
    mut items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, lwt_item(lwt_bind_typed("f", lwt_fn_value("make_str", "teko::demo", fty), fty)))
    let call = lwt_closure_call("f", teko::list::empty(), fty, checker::Str { })
    items = teko::list::push(items, lwt_item(lwt_exprstmt(lwt_len_field(call))))
    let prog = checker::TProgram { items = items }
    let m = match lower_program(prog) { LModule as x => x; error as err => { teko::assert::is_true(false); return } }
    let text = print_lmodule(m)
    teko::assert::str_contains(text, "func @.Lclofn0(%0: ptr, %1: ptr) -> ptr {")
    teko::assert::str_contains(text, "call @teko_teko__demo__make_str(%1)")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "call.indirect")
    teko::assert::str_contains(text, "load.i64")
}

/**
 * lwt_honest_stop_on_fat_iface_dispatch_result — the interface-dispatch sibling of
 * `lwt_honest_stop_on_fat_closure_call_result`: a vtable-dispatched method whose result is fat
 * also honest-stops by name instead of mismatching the callee-side hidden-slot convention
 * (call-gordo degrau, #382 N2).
 *
 * @return void
 */
#test
fn lwt_honest_stop_on_fat_iface_dispatch_result() {
    let recv = lwt_num_i64(1)
    let call = lwt_iface_call("Speaker", "speak", 0, teko::list::push(teko::list::empty(), recv), checker::Str { })
    teko::assert::str_contains(lwt_lower_expr_text(call), "fat-pointer interface-dispatch result not yet lowered")
}

/**
 * lwt_slice_of — a `[]T` slice type over the primitive kind `k` (the list-builtin fixtures'
 * element type).
 *
 * @param k  the element's primitive kind
 * @return   the `[]k` slice type
 */
fn lwt_slice_of(k: checker::PrimKind) -> checker::Type { checker::Slice { element = lwt_prim(k) } }

/**
 * lwt_list_empty_call — a `teko::list::empty()` builtin call node typed as `[]k` (the checker
 * CONCRETIZES a sentinel base to the result element type before the backend ever sees it).
 *
 * @param k  the element's primitive kind
 * @return   the typed `empty()` call
 */
fn lwt_list_empty_call(k: checker::PrimKind) -> checker::TExpr {
    lwt_call(lwt_path2("list", "empty"), "", teko::list::empty(), lwt_slice_of(k))
}

/**
 * lwt_push_call — a growth-builtin call node `<ns>::<name>(base, item)` typed as `[]k`, the shape
 * `type_list_builtin` leaves behind for `teko::list::push` and `teko::mem::push_fo`.
 *
 * @param ns    the callee path's namespace segment (`list` or `mem`)
 * @param name  the callee path's last segment (`push` or `push_fo`)
 * @param base  the base slice argument
 * @param item  the pushed item argument
 * @param k     the element's primitive kind
 * @return      the typed push call
 */
fn lwt_push_call(ns: str, name: str, base: checker::TExpr, item: checker::TExpr, k: checker::PrimKind) -> checker::TExpr {
    let args = teko::list::push(teko::list::push(teko::list::empty(), base), item)
    lwt_call(lwt_path2(ns, name), "", args, lwt_slice_of(k))
}

/**
 * lwt_lowers_list_push_to_the_runtime_grow — `teko::list::push(empty(), 7)` lowers to the runtime's
 * amortized grow: the empty base is the (null, 0) constant pair, the item is stored into its own
 * frame slot, and `tk_slice_push` is called with `(ptr, len, &item, sizeof, &out_len)`, the length
 * arriving through the out-slot rather than through this backend's Teko-only hidden return register
 * (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_list_push_to_the_runtime_grow() {
    let base = lwt_list_empty_call(checker::PrimKind::I64)
    let call = lwt_push_call("list", "push", base, lwt_num_i64(7), checker::PrimKind::I64)
    let text = lwt_lower_expr_text(lwt_len_field(call))
    teko::assert::str_contains(text, "call @tk_slice_push(")
    teko::assert::str_contains(text, "alloca 8, align 8")
    teko::assert::str_contains(text, "store.i64")
    teko::assert::str_contains(text, "load.i64")
}

/**
 * lwt_lowers_push_fo_to_the_free_old_grow — the `teko::mem::push_fo` DECREE targets the
 * free-old-on-grow runtime entry, not the plain one: the two spellings must never collapse onto one
 * symbol, since only the decreed chain may park its superseded buffer (list-builtin degrau).
 *
 * @return void
 */
#test
fn lwt_lowers_push_fo_to_the_free_old_grow() {
    let base = lwt_list_empty_call(checker::PrimKind::I64)
    let call = lwt_push_call("mem", "push_fo", base, lwt_num_i64(7), checker::PrimKind::I64)
    teko::assert::str_contains(lwt_lower_expr_text(lwt_len_field(call)), "call @tk_slice_push_fo(")
}

