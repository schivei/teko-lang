use teko::checker
use teko::lexer
use teko::parser

/** teko::lir (lower_const) — aggregate-const serialization: the #594 T-B6 const-image
    producer for lower. Const-folding of scalar initializer trees, the little-endian byte
    writers, struct/array/variant blob serialization (fat MEMBERS — struct fields AND slice
    elements — plus leaf symbols into a ConstImage), variant-table collection, and the rodata
    interning entry points (`serialize_const` / `intern_aggregate_consts`) that `lower_program`
    drives. */

/**
 * const_rodata_symbol — the deterministic rodata symbol a module-level AGGREGATE const materializes
 * under (#594 crumb 6): `.Lconst_<name>`. The `.Lconst_` prefix never collides with a string
 * literal's `.Lstr<N>` symbol, and a reference site re-derives the exact same name from the const's
 * name alone (`find_const_rodata`), so no per-const symbol table needs threading through lowering.
 *
 * @param name  the const's declared name
 * @return      its rodata symbol
 */
fn const_rodata_symbol(name: str) -> str {
    teko::str::concat(".Lconst_", name)
}

/**
 * const_leaf_symbol — the deterministic rodata symbol of the target array of the slice field
 * `field_name` of the aggregate const `const_name` (#594 T-B6): `.Lconst_<const_name>.<field_name>`
 * — a PURE FUNCTION of (const name, field name), NEVER of a global intern counter. The `.Lconst_`
 * prefix never collides with a string literal's `.Lstr<N>` nor with the main blob `.Lconst_<const_
 * name>` (the leaf carries one extra `.` + field). Since each `(const, field)` is unique and the name
 * does not depend on traversal order, the same `.tks` always yields the same symbols, so
 * `LDataReloc.target`, the writers' cumulative bases and rebased offsets stay identical
 * across generations (fixpoint-safe).
 *
 * @param const_name  the owning aggregate const's name
 * @param field_name  the slice field's name
 * @return            the leaf's rodata symbol
 * @since #594 T-B6
 */
fn const_leaf_symbol(const_name: str, field_name: str) -> str {
    teko::str::concat(const_rodata_symbol(const_name), teko::str::concat(".", field_name))
}

/**
 * ltype_is_ptr — true iff a machine class is the pointer class (`Ptr`), the shape a struct field's
 * layout takes when the field is itself pointer/slice-bearing (a `str`, `[]T`, `char`, nested Named,
 * or `ptr<T>`) — the Tier-B signal the aggregate serializer rejects (#594 crumb 6).
 *
 * @param t  the machine class
 * @return   whether it is the pointer class
 */
fn ltype_is_ptr(t: LType) -> bool {
    match t { Ptr => true; _ => false }
}

/**
 * ltype_is_float — true iff a machine class is an IEEE float class (`F32`/`F64`) (#594 crumb
 * 6). The Tier-A serializer materializes integer/bool/byte fields only; a float field is a documented
 * Tier-A follow-up and honest-stops.
 *
 * @param t  the machine class
 * @return   whether it is a float class
 */
fn ltype_is_float(t: LType) -> bool {
    match t { F32 => true; F64 => true; _ => false }
}

/**
 * lo_byte — the little-endian byte of `v` at bit offset `shift` (a multiple of 8): shift right, take
 * the low 8 bits (#594 crumb 6). `v` is the value's raw i64 two's-complement register bits (drop-128,
 * 2026-07-24 — the fold carrier is i64; no machine class is ever wider than i64/8 bytes now that
 * `u64`/`i64` are removed from the surface).
 *
 * THE MASK HAPPENS IN i64 SPACE, BEFORE ANY CONVERSION, and that ordering is the whole point. This
 * line used to read `(((v >> shift) to u64) & 0xFF) to byte`, whose doc-comment claimed that
 * "truncating through `u64` yields the correct two's-complement byte for a negative `v`". That is
 * true in C, where a conversion REINTERPRETS the bits. Teko's cast is CHECKED: `to u64` on a
 * negative `i64` is not a reinterpretation, it is an impossible conversion, and it panicked —
 * `84:7: teko: deliberate panic: impossible conversion`, reached the moment enough consts
 * serialized to hit a negative one. The comment described a language this is not.
 *
 * Masking first is correct for EVERY `i64` including `i64::MIN`: `>>` on a signed value is
 * arithmetic, so the sign fill is already in place, and `& 0xFF` then yields 0..255 — a value every
 * later conversion accepts. `~0` still serializes to `0xFF`, and `i64::MIN >> 56` still yields
 * `0x80`, which is what a machine store of that width writes.
 *
 * The `shift >= 64` arm is a defensive invariant (unreachable today, since no field's
 * `ltype_size` exceeds 8 bytes) rather than a live path — kept in case a wider machine class is ever
 * reintroduced, in which case its byte would be the sign-extension fill (all-ones for a negative `v`,
 * all-zeros otherwise), exactly what storing a narrower register into a wider slot does.
 *
 * @param v      the i64 value being serialized
 * @param shift  the bit offset of the wanted byte (0, 8, 16, …)
 * @return       the extracted byte
 */
fn lo_byte(v: i64, shift: u32) -> byte {
    if shift >= 64 { return if v < 0 { 0xFF to byte } else { 0 to byte } }
    ((v >> shift) & 0xFF) to byte
}

/**
 * serialize_le — the little-endian byte image of the i64 value `v` in `nbytes` bytes (#594 crumb
 * 6). A field/element wider than its value truncates to its declared width, exactly as a machine
 * store of that width would; a field WIDER than i64 sign-extends (`lo_byte`'s `shift >= 64` case).
 *
 * @param v       the folded scalar value
 * @param nbytes  the target width in bytes (the machine class's size)
 * @return        the little-endian byte image
 */
fn serialize_le(v: i64, nbytes: u32) -> []byte {
    mut out: []byte = teko::list::empty()
    mut k: u32 = 0
    loop {
        if k >= nbytes { break }
        out = teko::list::push(out, lo_byte(v, k * 8))
        k++
    }
    out
}

/**
 * const_fold_unary — fold a const unary operator over an already-folded operand (#594 crumb 6): unary
 * `-` (negation) or `~` (bitwise complement, computed as the two's-complement identity `-v - 1` so the
 * fold uses ONLY i64 `+`/`-`, the sole arithmetic the native backend lowers today — `*`/`/` are
 * deferred to a helper, see `isel_arm64.tks` §6.3). The result is the fold's i64 register carrier
 * (drop-128, 2026-07-24) and truncates/sign-extends to the field's width at serialization.
 *
 * @param op  the unary operator token kind
 * @param v   the folded operand value
 * @return    the folded result
 * @throws    when `op` is not a const-admissible unary operator
 */
fn const_fold_unary(op: lexer::TokenKind, v: i64) -> i64 | error {
    match op {
        lexer::TokenKind::Tilde => ((0) - v) - (1)
        lexer::TokenKind::Minus => (0) - v
        _ => error { message = "const aggregate: non-const unary operator in initializer (#594)" }
    }
}

/**
 * const_fold_binary — fold a const binary operator over two already-folded operands (#594 crumb 6).
 * Only `+` and `-` fold here: they are the i64 arithmetic the native self-build definitely lowers
 * (`lir_print.tks` performs `*`/`/`/`%` on a u64 magnitude precisely because signed multiply/divide/
 * shift are deferred to a helper-call, `isel_arm64.tks` §6.3). The remaining const-grammar operators
 * (`* / % & | ^ << >>`) are a documented Tier-A follow-up — they honest-stop rather than emit an op
 * the backend cannot yet materialize (the required Tier-A shapes use literal/cast fields, no
 * arithmetic).
 *
 * @param op  the binary operator token kind
 * @param a   the folded left operand
 * @param b   the folded right operand
 * @return    the folded result
 * @throws    for any operator beyond `+`/`-` (a Tier-A const-fold follow-up)
 */
fn const_fold_binary(op: lexer::TokenKind, a: i64, b: i64) -> i64 | error {
    match op {
        lexer::TokenKind::Plus => a + b
        lexer::TokenKind::Minus => a - b
        _ => error { message = "const aggregate: const-fold of this operator (only `+`/`-` today) is a Tier-A follow-up (#594)" }
    }
}

/**
 * const_fold_int — fold a scalar (integer/bool/byte/enum-member) const initializer expression to its
 * raw i64 register value (#594 crumb 6; drop-128, 2026-07-24): a numeric/byte/bool literal, an
 * `Enum::Member` path, a cast (representation-preserving here — the target width truncates/
 * sign-extends only at serialization), or a unary/binary arithmetic tree over such leaves. A FLOAT
 * value, a `char` (fat runtime image), or a nested const reference is a documented Tier-A follow-up
 * and honest-stops.
 *
 * An `Enum::Member` folds to the checker's ALREADY-RESOLVED `TPathExpr.value` — the ordinal for a
 * plain enum, `1 << ordinal` for a `flags` one. That is the exact same source `lower_path_expr` reads
 * when it materializes the member into a register, so a member written into a const's rodata image
 * and the same member computed at runtime are bit-for-bit the same value. Folding it here (rather
 * than re-deriving an ordinal from the enum table) is what keeps the two from drifting.
 *
 * @param e  the field/element initializer expression
 * @return   the folded i64 value
 * @throws   when `e` is a float, a char, or a form beyond the integer const-fold subset
 */
fn const_fold_int(e: checker::TExpr) -> i64 | error {
    match e.kind {
        checker::TNumber as n => if n.is_float { error { message = "const aggregate: float value materialization is a Tier-A follow-up (#594)" } } else { parser::numint_to_i64(n.value) }
        checker::TByteLit as b => b.value to i64
        checker::TBoolLit as bo => if bo.value { 1 } else { 0 }
        checker::TPathExpr as p => p.value to i64
        checker::TCharLit => error { message = "const aggregate: char value is fat (Tier-B, T-B) (#594)" }
        checker::TCast as c => const_fold_int(c.expr)
        checker::TUnary as u => const_fold_unary_expr(u)
        checker::TBinary as b => const_fold_binary_expr(b)
        _ => error { message = teko::str::concat("const aggregate: unsupported initializer form `", texpr_kind_name(e), "` (Tier-A follow-up / Tier-B, T-B) (#594)") }
    }
}

/**
 * const_fold_unary_expr — fold a unary const initializer subtree: fold the operand, then apply the
 * operator (#594 crumb 6).
 *
 * @param u  the typed unary expression
 * @return   the folded i64 value
 * @throws   when the operand or the operator is outside the integer const-fold subset
 */
fn const_fold_unary_expr(u: checker::TUnary) -> i64 | error {
    let v = match const_fold_int(u.operand) { i64 as x => x; error as e => return e }
    const_fold_unary(u.op, v)
}

/**
 * const_fold_binary_expr — fold a binary const initializer subtree: fold both operands, then apply
 * the operator (#594 crumb 6).
 *
 * @param b  the typed binary expression
 * @return   the folded i64 value
 * @throws   when an operand or the operator is outside the integer const-fold subset
 */
fn const_fold_binary_expr(b: checker::TBinary) -> i64 | error {
    let a = match const_fold_int(b.left) { i64 as x => x; error as e => return e }
    let c = match const_fold_int(b.right) { i64 as x => x; error as e => return e }
    const_fold_binary(b.op, a, c)
}

/**
 * const_is_flat_scalar — true iff a slice element type is a flat, non-pointer scalar the aggregate
 * serializer can materialize (#594 crumb 6): a primitive (int/float/bool) or a `byte`. A `char`
 * (fat), a nested slice/str, or a named aggregate is pointer-bearing (Tier-B, T-B) and rejected.
 *
 * @param t  the slice element type
 * @return   whether it is a materializable flat scalar
 */
fn const_is_flat_scalar(t: checker::Type) -> bool {
    match t {
        checker::Prim => true
        checker::Byte => true
        _ => false
    }
}

/**
 * zeros_bytes — an all-zero byte buffer of length `n` (#594 crumb 6): the struct-blob canvas a flat
 * POD const overwrites at each field's layout offset, so padding bytes stay zero.
 *
 * @param n  the buffer length
 * @return   `n` zero bytes
 */
fn zeros_bytes(n: u64) -> []byte {
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, 0 to byte)
        i++
    }
    out
}

/**
 * append_bytes — the concatenation of two byte buffers (#594 crumb 6): the slice serializer grows the
 * blob one element image at a time.
 *
 * @param a  the buffer accumulated so far
 * @param b  the bytes to append
 * @return   `a` followed by `b`
 */
fn append_bytes(a: []byte, b: []byte) -> []byte {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * write_bytes_at — a copy of `buf` with `src` overwriting the window `[off, off + src.len)` (#594
 * crumb 6): the struct serializer places each field's little-endian image at its layout offset while
 * leaving padding zero. The window is always in bounds (a field's offset+size never exceeds the
 * struct's size), so out-of-range source indices never occur.
 *
 * @param buf  the buffer being filled (length = the struct's size)
 * @param off  the field's byte offset
 * @param src  the field's little-endian image
 * @return     `buf` with `src` written at `off`
 */
fn write_bytes_at(buf: []byte, off: u64, src: []byte) -> []byte {
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= buf.len { break }
        let within = i >= off && i < off + src.len
        out = teko::list::push(out, if within { src[i - off] } else { buf[i] })
        i++
    }
    out
}

/**
 * const_str_bytes — the rodata image of a `str` aggregate const: its raw UTF-8 bytes (#594 crumb 6).
 * The initializer must be a string literal (the only const-legal `str` producer); anything else
 * honest-stops.
 *
 * @param init  the const's checked initializer
 * @return      the UTF-8 byte image
 * @throws      when the initializer is not a string literal
 */
fn const_str_bytes(init: checker::TExpr) -> []byte | error {
    match init.kind {
        checker::TStrLit as s => str_to_bytes(s.text)
        _ => error { message = "const str: initializer is not a string literal (Tier-A follow-up) (#594)" }
    }
}

/**
 * const_array_bytes — the rodata image of a `[]T` FLAT-SCALAR array literal: each element folded to
 * its i64 value and serialized at the SAME element stride the indexer uses (`elem_byte_stride`), so
 * a later `[i]`/`.len` read agrees byte-for-byte on both engines (#594 crumb 6). A spread element is
 * not statically materializable and honest-stops.
 *
 * @param element  the slice's element type (a flat scalar — a fat element goes to `const_fat_array_image`)
 * @param a        the typed array literal
 * @param enums    the program's declared-enum table (an enum element strides at its integer width)
 * @return         the concatenated element images
 * @throws         when an element is a spread or is not a foldable flat scalar
 */
fn const_array_bytes(element: checker::Type, a: checker::TArrayLit, enums: []LEnumInfo) -> []byte | error {
    let stride = elem_byte_stride(element, enums)
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        match const_reject_spread(a, i) { error as e => return e; null => { } }
        let v = match const_fold_int(a.elements[i].expr) { i64 as x => x; error as e => return e }
        out = append_bytes(out, serialize_le(v, stride))
        i++
    }
    out
}

/**
 * const_reject_spread — the spread guard both array serializers share: a `..xs` element carries no
 * statically known length, so it is not materializable into rodata and honest-stops.
 *
 * @param a  the typed array literal
 * @param i  the element index being serialized
 * @return   `null` when the element is an ordinary value
 * @throws   when the element at `i` is a spread
 */
fn const_reject_spread(a: checker::TArrayLit, i: u64) -> null | error {
    if a.elements[i].is_spread { return error { message = "const slice: spread element not statically materializable (#594)" } }
    null
}

/**
 * const_elem_key — the leaf-symbol key of the slice element at `index`: its decimal index (0.3.1.0
 * degrau const-slice). A PURE function of the index, so `const_leaf_symbol(const_name,
 * const_elem_key(i))` names the same symbol on every generation — the fixpoint requirement every
 * other leaf symbol already meets.
 *
 * @param index  the element's position in the array literal
 * @return       the key to build the element's leaf symbol from
 * @since 0.3.1.0 degrau const-slice
 */
fn const_elem_key(index: u64) -> str {
    teko::u64_to_str(index)
}

/**
 * const_nested_owner — the owner name a fat member's NESTED leaves are keyed under: the owner's own
 * name joined to the member's key (0.3.1.0 degrau const-slice). A `[][]str` const `T` names its outer
 * element leaves `.Lconst_T.0`, `.Lconst_T.1`, … and the inner leaves of element 0 `.Lconst_T.0.0`,
 * `.Lconst_T.0.1`, … — every symbol a pure function of the declaration path, never of a counter.
 *
 * @param owner       the owning aggregate's name (as `const_leaf_symbol` keys it)
 * @param member_key  the member's own key (a field name or an element index)
 * @return            the owner name to key the member's nested leaves under
 * @since 0.3.1.0 degrau const-slice
 */
fn const_nested_owner(owner: str, member_key: str) -> str {
    teko::str::concat(owner, teko::str::concat(".", member_key))
}

/**
 * const_array_literal — the array literal an aggregate `[]T` const is initialized by (#594 crumb 6).
 * The only const-legal `[]T` producer; anything else honest-stops.
 *
 * @param init  the const's checked initializer
 * @return      the typed array-literal node
 * @throws      when the initializer is not an array literal
 */
fn const_array_literal(init: checker::TExpr) -> checker::TArrayLit | error {
    match init.kind {
        checker::TArrayLit as a => a
        _ => error { message = "const slice: initializer is not an array literal (Tier-A follow-up) (#594)" }
    }
}

/**
 * const_fat_array_image — the rodata image of a `[]T` array literal whose ELEMENTS are themselves FAT
 * (`[]str`, `[][]T`) (0.3.1.0 degrau const-slice): a blob of `n * fat_slot_bytes()` bytes holding one
 * zeroed pointer slot + inline element count per element, one `LDataReloc` per slot, and each
 * element's target leaf (plus any leaf that target itself pulls in).
 *
 * The slot stride is `fat_slot_bytes()`, the SAME 16 bytes `elem_byte_stride` hands the runtime
 * indexer for a fat element (`lower_index_fat`) and `const_slice_len` divides the blob by — so the
 * const's `.len` and its `[i]` reads land on the identical bytes the C route's inlined literal builds.
 *
 * @param const_name  the owning const's name (for each element's deterministic leaf symbol)
 * @param element     the slice's (fat) element type
 * @param a           the typed array literal
 * @param enums       the program's declared-enum table
 * @return            the slot blob + one reloc per element + every leaf
 * @throws            when an element is a spread, or its own target is not materializable
 * @since 0.3.1.0 degrau const-slice
 */
fn const_fat_array_image(const_name: str, element: checker::Type, a: checker::TArrayLit, enums: []LEnumInfo) -> ConstImage | error {
    mut img = const_image_flat(teko::list::empty())
    mut i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        match const_reject_spread(a, i) { error as e => return e; null => { } }
        let slot_off = ptr_align_up(img.bytes.len to u32)
        let member = match const_fat_member(const_name, const_elem_key(i), slot_off, element, a.elements[i].expr, enums) { FatMemberImage as x => x; error as e => return e }
        img = const_image_absorb(img, member)
        i++
    }
    img
}

/**
 * fat_slot_align — the byte alignment every fat pointer slot's own START needs (#0.3.1.0
 * native-rodata-const-align): the pointer width (`ltype_size(LType::Ptr)`, 8) macOS `ld` enforces
 * on every `ARM64_RELOC_UNSIGNED` (`Abs64`) rodata relocation site.
 *
 * @return u32  the fat pointer slot's required byte alignment
 * @since 0.3.1.0 native-rodata-const-align
 */
fn fat_slot_align() -> u32 {
    ltype_size(LType::Ptr)
}

/**
 * ptr_align_up — `v` rounded up to `fat_slot_align`'s boundary (#0.3.1.0 native-rodata-const-align):
 * the offset a fat pointer slot may legally start at.
 *
 * @param v  the running byte offset to round
 * @return u32  `v` rounded up to the next `fat_slot_align`-aligned offset
 * @since 0.3.1.0 native-rodata-const-align
 */
fn ptr_align_up(v: u32) -> u32 {
    align_up(v, fat_slot_align())
}

/**
 * pad_bytes_to_ptr_align — `bytes` zero-extended until its length is `fat_slot_align`-aligned
 * (#0.3.1.0 native-rodata-const-align): the sibling of `zero_pad_to` (a fixed target width) for a
 * running accumulator whose target is "the next pointer-alignment boundary", not a constant.
 *
 * @param bytes  the buffer to pad
 * @return []byte  `bytes`, zero-padded up to the next `fat_slot_align`-aligned length
 * @since 0.3.1.0 native-rodata-const-align
 */
fn pad_bytes_to_ptr_align(bytes: []byte) -> []byte {
    zero_pad_to(bytes, ptr_align_up(bytes.len to u32))
}

/**
 * const_image_absorb — append one fat member's slot bytes, relocation and leaves to the array image
 * accumulated so far (0.3.1.0 degrau const-slice), FIRST padding the image to `fat_slot_align` so
 * the slot lands exactly at the caller's own `member.reloc.offset` (`slot_off`, computed by
 * `const_fat_array_image` from this SAME padded running length — #0.3.1.0
 * native-rodata-const-align). Every fat slot is `fat_slot_bytes()` (16) wide today, already a
 * multiple of `fat_slot_align` (8), so this pad is a no-op for the current corpus; it keeps the
 * invariant true BY CONSTRUCTION rather than by the caller's own arithmetic, so a future
 * non-uniform member width cannot silently reintroduce an unaligned slot.
 *
 * @param img     the image accumulated over the preceding elements
 * @param member  the element's slot image, relocation and leaves
 * @return        the image grown by that element
 * @since 0.3.1.0 degrau const-slice; padded 0.3.1.0 native-rodata-const-align
 */
fn const_image_absorb(img: ConstImage, member: FatMemberImage) -> ConstImage {
    ConstImage {
        bytes = append_bytes(pad_bytes_to_ptr_align(img.bytes), member.slot_bytes)
        relocs = teko::list::push(img.relocs, member.reloc)
        leaves = append_rodata(img.leaves, member.leaves)
    }
}

/**
 * append_rodata — the concatenation of two rodata-entry lists, order preserved (0.3.1.0 degrau
 * const-slice): the leaf accumulator every aggregate image grows through.
 *
 * @param a  the entries accumulated so far
 * @param b  the entries to append
 * @return   `a` followed by `b`
 * @since 0.3.1.0 degrau const-slice
 */
fn append_rodata(a: []LRodata, b: []LRodata) -> []LRodata {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * const_slice_image — the complete rodata image of a `[]T` aggregate const (#594 crumb 6; 0.3.1.0
 * degrau const-slice): a FLAT-SCALAR element array is the crumb-6 byte image with empty
 * relocs/leaves; a FAT element array (`[]str`, `[][]T`) is a blob of `{ptr = 0, len = count}` slots
 * with one relocation and one leaf per element (`const_fat_array_image`).
 *
 * The remaining element families — a `char` (fat but not `str`/`[]T`), a named struct/class/variant,
 * a `ptr<T>` — still honest-stop: their elements are held BY ADDRESS in a slice buffer
 * (NATIVE-AGG-SLICE-BY-ADDRESS), and rodata carries no address a per-execution box could be given.
 *
 * @param const_name  the owning const's name (for each fat element's deterministic leaf symbol)
 * @param element     the slice's element type
 * @param init        the const's checked initializer
 * @param enums       the program's declared-enum table (an enum element strides at its integer width)
 * @return            the slice's blob + its relocations + its leaves
 * @throws            when the initializer is not an array literal, an element is a spread, or the
 *                    element type is neither a flat scalar nor a fat `str`/`[]T`
 */
fn const_slice_image(const_name: str, element: checker::Type, init: checker::TExpr, enums: []LEnumInfo) -> ConstImage | error {
    let a = match const_array_literal(init) { checker::TArrayLit as x => x; error as e => return e }
    if const_is_flat_scalar(element) {
        return match const_array_bytes(element, a, enums) { []byte as b => const_image_flat(b); error as e => return e }
    }
    if is_fat_type(element) { return const_fat_array_image(const_name, element, a, enums) }
    error { message = "const aggregate: slice element is pointer/slice-bearing -> Tier-B (T-B), not crumb 6 (#594)" }
}

/**
 * struct_init_value — the initializer expression a `TStructInit` binds to the field named `field`
 * (#594 crumb 6). The checker guarantees a flat struct const names every field, so a miss is an
 * invariant break, not a user error.
 *
 * @param si     the typed struct-literal initializer
 * @param field  the layout field's name
 * @return       the value expression bound to `field`
 * @throws       when the initializer binds no such field (internal invariant break)
 */
fn struct_init_value(si: checker::TStructInit, field: str) -> checker::TExpr | error {
    mut i: u64 = 0
    loop {
        if i >= si.field_names.len { break }
        if si.field_names[i] == field { return si.field_vals[i] }
        i++
    }
    error { message = teko::str::concat("const struct: initializer binds no field `", field, "` (internal)") }
}

/**
 * const_struct_field_bytes — the little-endian image of one flat struct field, folding its
 * initializer to its layout width (#594 crumb 6): reject a pointer-bearing field (Tier-B, T-B) and a
 * float field (a documented Tier-A follow-up), else serialize the folded integer/bool/byte value.
 *
 * @param layout  the struct's resolved layout (for the field's machine class + size)
 * @param si      the struct-literal initializer (source of each field's value)
 * @param j       the layout field index being serialized
 * @return        the field's little-endian byte image
 * @throws        when the field is pointer-bearing, a float, or its value is not foldable
 */
fn const_struct_field_bytes(layout: LStructLayout, si: checker::TStructInit, j: u64) -> []byte | error {
    let lt = layout.field_types[j]
    if ltype_is_ptr(lt) { return error { message = teko::str::concat("const aggregate: field `", layout.field_names[j], "` is pointer/slice-bearing -> Tier-B (T-B), not crumb 6 (#594)") } }
    if ltype_is_float(lt) { return error { message = teko::str::concat("const aggregate: float field `", layout.field_names[j], "` materialization is a Tier-A follow-up (#594)") } }
    let vexpr = match struct_init_value(si, layout.field_names[j]) { checker::TExpr as x => x; error as e => return e }
    let v = match const_fold_int(vexpr) { i64 as x => x; error as e => return e }
    serialize_le(v, ltype_size(lt))
}

/**
 * const_fat_target_image — the complete rodata image of a fat member's TARGET array (#594 T-B6;
 * 0.3.1.0 degrau const-slice): a `str` member's raw UTF-8 (`const_str_bytes`, always flat), a `[]T`
 * member's element images at the indexer's stride (`const_slice_image`, itself flat or slot-bearing
 * depending on the element). The SAME stride a later `[i]` folds against and the same bytes a
 * standalone const of that type would intern, so the leaf and any read agree byte-for-byte.
 *
 * @param owner      the name the target's OWN nested leaves are keyed under (`const_nested_owner`)
 * @param member_ty  the member's checked type (`Str`/`Slice`)
 * @param vexpr      the member's initializer (a string/array literal)
 * @param enums      the program's declared-enum table (an enum element strides at its integer width)
 * @return           the target array's bytes + its own relocations + its own nested leaves
 * @throws           when the member is not a str/slice (internal), or the initializer is not materializable
 * @since #594 T-B6; 0.3.1.0 degrau const-slice (nested leaves)
 */
fn const_fat_target_image(owner: str, member_ty: checker::Type, vexpr: checker::TExpr, enums: []LEnumInfo) -> ConstImage | error {
    match member_ty {
        checker::Str => match const_str_bytes(vexpr) { []byte as b => const_image_flat(b); error as e => return e }
        checker::Slice as s => const_slice_image(owner, s.element, vexpr, enums)
        _ => error { message = "const aggregate: fat member is neither str nor slice (internal) (#594)" }
    }
}

/**
 * const_fat_member — the 16-byte image of a FAT MEMBER (`[]T`/`str`) of an aggregate const, with the
 * pointer slot zero and the element count inline in the high slot (#594 T-B6; 0.3.1.0 degrau
 * const-slice): `{ slot_bytes = <8 zero> ++ serialize_le(count, POINTER_SIZE), reloc =
 * data_reloc(slot_off, leaf_sym), leaves = <nested leaves> ++ [LRodata{ leaf_sym, target bytes,
 * target relocs }] }`.
 *
 * ONE producer for both member families: a fat struct FIELD (`slot_off` = the field's layout offset,
 * `member_key` = the field name) and a fat slice ELEMENT (`slot_off` = `index * fat_slot_bytes()`,
 * `member_key` = the decimal index). `count` is the element count (`const_fat_len`) — the SAME value
 * `lower_len_field`/`lower_const_fat` compute, so a `.len` read agrees. The leaf symbol is
 * `const_leaf_symbol(owner, member_key)`, a pure function of the declaration path, so every
 * generation emits the identical symbol (fixpoint-safe).
 *
 * @param owner       the owning aggregate's name (for the leaf symbol)
 * @param member_key  the member's key — a field name, or an element index (`const_elem_key`)
 * @param slot_off    the member's byte offset in the owning blob (the pointer slot's offset)
 * @param member_ty   the member's checked type (`Slice`/`Str`)
 * @param vexpr       the member's initializer (a string/array literal)
 * @param enums       the program's declared-enum table (an enum element strides at its integer width)
 * @return            the 16-byte slot image, the relocation, and every leaf it pulls in
 * @throws            when the initializer is not materializable (non-literal, spread, or ptr element)
 * @since #594 T-B6; 0.3.1.0 degrau const-slice (elements + nested leaves)
 */
fn const_fat_member(owner: str, member_key: str, slot_off: u32, member_ty: checker::Type, vexpr: checker::TExpr, enums: []LEnumInfo) -> FatMemberImage | error {
    let target = match const_fat_target_image(const_nested_owner(owner, member_key), member_ty, vexpr, enums) { ConstImage as x => x; error as e => return e }
    let count = match const_fat_len(member_ty, target.bytes.len to u32, enums) { u32 as c => c; error as e => return e }
    let leaf_sym = const_leaf_symbol(owner, member_key)
    let ptr_size = ltype_size(LType::Ptr)
    let slot = append_bytes(zeros_bytes(ptr_size to u64), serialize_le(count to i64, ptr_size))
    FatMemberImage {
        slot_bytes = slot
        reloc = data_reloc(slot_off, leaf_sym)
        leaves = teko::list::push(target.leaves, LRodata { symbol = leaf_sym; bytes = target.bytes; relocs = target.relocs })
    }
}

/**
 * const_struct_blob — the complete rodata image of a struct aggregate const (#594 crumb 6 + T-B6): a
 * zero-filled buffer of the struct's size with each SCALAR field's little-endian value written at its
 * layout offset (declared order, natural alignment) and each FAT field (`[]T`/`str`) written as its
 * 16-byte `{ptr=0, len=count}` slot plus a `LDataReloc` + its leaves (`const_fat_member`). Padding
 * stays zero, so a later `.field`/`.len`/`[i]` read recovers the exact value on both engines. A flat
 * Tier-A struct yields empty `relocs`/`leaves` (byte-identical to crumb 6); an ABI descriptor yields
 * one reloc per slice field, plus that field's leaf and any leaf the leaf itself pulls in.
 *
 * @param const_name  the owning const's name (for each fat field's deterministic leaf symbol)
 * @param layout      the struct's resolved layout (size + per-field offset/class)
 * @param si          the typed struct-literal initializer
 * @param enums       the program's declared-enum table (a fat field's enum element stride)
 * @return            the struct blob + its internal relocations + its leaf entries
 * @throws            when a non-fat pointer field (Tier-B), a float field, or a non-foldable value occurs
 * @since #594 crumb 6 + T-B6
 */
fn const_struct_blob(const_name: str, layout: LStructLayout, si: checker::TStructInit, enums: []LEnumInfo) -> ConstImage | error {
    mut img = ConstImage { bytes = zeros_bytes(layout.size to u64); relocs = teko::list::empty(); leaves = teko::list::empty() }
    mut j: u64 = 0
    loop {
        if j >= layout.field_names.len { break }
        img = match const_struct_field_into(img, const_name, layout, si, j, enums) { ConstImage as x => x; error as e => return e }
        j++
    }
    img
}

/**
 * const_struct_field_into — write ONE struct field into the blob accumulated so far: a FAT field
 * (`[]T`/`str`) contributes its 16-byte slot at the field's layout offset plus a relocation and its
 * leaves (`const_fat_member`); every other field contributes its little-endian scalar image
 * (`const_struct_field_bytes`).
 *
 * @param img         the blob + relocations + leaves accumulated over the preceding fields
 * @param const_name  the owning const's name (for the field's deterministic leaf symbol)
 * @param layout      the struct's resolved layout (size + per-field offset/class)
 * @param si          the typed struct-literal initializer
 * @param j           the layout field index being written
 * @param enums       the program's declared-enum table (a fat field's enum element stride)
 * @return            the image grown by that field
 * @throws            when the field is Tier-B, a float, or its value is not materializable
 * @since 0.3.1.0 degrau const-slice (the per-field extraction)
 */
fn const_struct_field_into(img: ConstImage, const_name: str, layout: LStructLayout, si: checker::TStructInit, j: u64, enums: []LEnumInfo) -> ConstImage | error {
    let field_name = layout.field_names[j]
    let fieldoff = layout.field_offsets[j]
    let vexpr = match struct_init_value(si, field_name) { checker::TExpr as x => x; error as e => return e }
    if !is_fat_type(vexpr.type) {
        let fb = match const_struct_field_bytes(layout, si, j) { []byte as x => x; error as e => return e }
        return ConstImage { bytes = write_bytes_at(img.bytes, fieldoff to u64, fb); relocs = img.relocs; leaves = img.leaves }
    }
    let member = match const_fat_member(const_name, field_name, fieldoff, vexpr.type, vexpr, enums) { FatMemberImage as x => x; error as e => return e }
    ConstImage {
        bytes = write_bytes_at(img.bytes, fieldoff to u64, member.slot_bytes)
        relocs = teko::list::push(img.relocs, member.reloc)
        leaves = append_rodata(img.leaves, member.leaves)
    }
}

/**
 * const_struct_bytes — the complete rodata image of a `Named` struct aggregate const (#594 crumb 6 +
 * T-B6): resolve its registered layout and materialize its struct-literal initializer via
 * `const_struct_blob`, threading the const's own name (for each fat field's deterministic leaf
 * symbol).
 *
 * @param const_name  the const's declared name (for each fat field's leaf symbol)
 * @param name        the struct type's canonical name
 * @param init        the const's checked initializer
 * @param layouts     the program's struct-layout table
 * @param enums       the program's declared-enum table (a fat field's enum element stride)
 * @return            the struct blob + its relocations + its leaves
 * @throws            when the layout is unknown, the initializer is not a struct literal (the message
 *                    names the const, its type and its source position), or a field is Tier-B
 * @since #594 crumb 6 + T-B6
 */
fn const_struct_bytes(const_name: str, name: str, init: checker::TExpr, layouts: []LStructLayout, enums: []LEnumInfo) -> ConstImage | error {
    let layout = match find_struct_layout(layouts, name) { LStructLayout as l => l; error as e => return e }
    match init.kind {
        checker::TStructInit as si => const_struct_blob(const_name, layout, si, enums)
        _ => error { message = $"const struct: the initializer of '{const_name}' (type '{name}') at {init.line}:{init.col} is not a struct literal — the checker's const-constructor canonicalization (`canonicalize_const_ctors`) did not reduce it (Tier-A follow-up) (#594)" }
    }
}

/**
 * const_variant_tag_bytes — the FULL-WIDTH image of an EMPTY-CASE variant member (#594 crumb 9b):
 * the case's declared index serialized little-endian at the variant runtime image's `tag@0` slot,
 * zero-padded out to `variant_wrapper_bytes()`. An initializer that binds payload fields is a
 * non-empty case whose payload serialization is a further follow-up and honest-stops (the
 * `MRet {}` targets §6.4 requires are all payload-free empty cases).
 *
 * THE PADDING IS THE POINT (0.3.1.0 degrau 6). The image used to be the four tag bytes alone,
 * which serves every READ a tag-only case gets today — and it made the const the ONE variant image
 * in the program narrower than the wrapper every other variant value has. One shape, one width, at
 * rest in rodata exactly as on the frame.
 *
 * @param si     the member's struct-literal initializer (must bind no field for an empty case)
 * @param index  the member's declared index (its runtime tag)
 * @return       the wrapper-width image: the little-endian tag, then zeroes
 * @throws       when the initializer binds any payload field (a non-empty case)
 */
fn const_variant_tag_bytes(si: checker::TStructInit, index: u32) -> []byte | error {
    if si.field_names.len > 0 { return error { message = "const variant: non-empty payload case materialization is a Tier-A follow-up (#594)" } }
    zero_pad_to(serialize_le(index to i64, ltype_size(LType::I32)), variant_wrapper_bytes())
}

/**
 * zero_pad_to — `bytes` extended with zeroes until it is `width` bytes long (returned unchanged
 * when it is already that wide or wider).
 *
 * @param bytes  the image to pad
 * @param width  the target byte width
 * @return       the padded image
 * @since 0.3.1.0 (degrau 6 — the uniform 24-byte wrapper)
 */
fn zero_pad_to(bytes: []byte, width: u32) -> []byte {
    mut out = bytes
    loop {
        if out.len >= width { break }
        out = teko::list::push(out, 0 to byte)
    }
    out
}

/**
 * find_variant_def — the registered variant whose name's last segment matches `name`'s (#594 crumb
 * 9b), or null when `name` is not a declared variant. A declared type resolves to a QUALIFIED
 * `Named` (`ns::Op`) while `collect_variant_defs` stores the DECLARED spelling (`Op`), so the match
 * is by last segment — the same bare-vs-qualified reconciliation `find_enum_info` uses.
 *
 * ONE probe serves EVERY consumer — the const serializer's tag image (`const_named_bytes`) and the
 * construction/match expansion (`expand_named_variant`) — so the tag a rodata image carries and the
 * tag a `match` arm compares against can never come from two different lookups.
 *
 * @param variants  the program's variant table
 * @param name      the declared type name to look up (possibly qualified)
 * @return          the matching variant definition, or null
 */
fn find_variant_def(variants: []LVariantDef, name: str) -> LVariantDef | null {
    let bare = checker::name_last_segment(name)
    mut i: u64 = 0
    loop {
        if i >= variants.len { break }
        if checker::name_last_segment(variants[i].name) == bare { return variants[i] }
        i++
    }
    null
}

/**
 * const_variant_bytes — the rodata image of an EMPTY-CASE variant aggregate const (#594 crumb 9b):
 * the constructed member's declared tag as a little-endian I32 at offset 0 (the `tag@0` half of the
 * variant runtime image, §5.3), with no payload. The initializer's own type names the member being
 * constructed; its index among the variant's declared members (`variants`) is the tag a later `match`
 * compares against (`lower_variant_case_test`), so both engines agree on the case byte-for-byte. A
 * member carrying payload fields honest-stops (payload materialization is a further follow-up beyond
 * the payload-free `MRet {}` §6.4 targets).
 *
 * @param info  the const's declared variant (its expanded members, in tag order)
 * @param init  the const's checked initializer (an empty-case member construction)
 * @return      the 4-byte little-endian tag image
 * @throws      when the initializer is not an empty member construction, or names no member
 */
fn const_variant_bytes(info: LVariantDef, init: checker::TExpr) -> []byte | error {
    let case_name = match named_type_name(init.type) { str as s => s; error as e => return e }
    let vm = match find_variant_member(info.ty.members, checker::name_last_segment(case_name)) { VariantMember as x => x; error as e => return e }
    let index = vm.index
    match init.kind {
        checker::TStructInit as si => const_variant_tag_bytes(si, index)
        _ => error { message = "const variant: initializer is not a member construction (Tier-A follow-up) (#594)" }
    }
}

/**
 * const_image_flat — a `ConstImage` wrapping a Tier-A flat byte image with EMPTY relocations and
 * leaves (#594 T-B6): a `str`/`[]T`/variant-tag const carries no internal pointer, so it is
 * byte-identical to the crumb-6 path.
 *
 * @param bytes  the flat rodata byte image
 * @return       a `ConstImage` with `relocs`/`leaves` empty
 * @since #594 T-B6
 */
fn const_image_flat(bytes: []byte) -> ConstImage {
    ConstImage { bytes = bytes; relocs = teko::list::empty(); leaves = teko::list::empty() }
}

/**
 * const_named_bytes — the complete rodata image of a `Named`-typed aggregate const (#594 crumb 6/9b +
 * T-B6): a declared `variant` materializes its empty-case tag (`const_variant_bytes`, flat), any other
 * `Named` is a struct materialized via `const_struct_bytes` (flat for a POD struct, or blob + relocs +
 * leaves for a pointer-bearing descriptor). A `variant`-typed const's declared type resolves to a
 * nominal `Named`, so this dispatch — variant table first, struct layout otherwise — is where the two
 * families part.
 *
 * @param const_name  the const's declared name (for each fat field's leaf symbol)
 * @param name        the const's declared type name (possibly qualified)
 * @param init        the const's checked initializer
 * @param layouts     the program's struct-layout table
 * @param variants    the program's variant table
 * @param enums       the program's declared-enum table (a fat field's enum element stride)
 * @return            the const's complete rodata image
 * @throws            a Tier-A-follow-up / Tier-B (T-B) honest-stop for an unmaterializable aggregate
 * @since #594 crumb 6/9b + T-B6
 */
fn const_named_bytes(const_name: str, name: str, init: checker::TExpr, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo) -> ConstImage | error {
    match find_variant_def(variants, name) {
        LVariantDef as info => match const_variant_bytes(info, init) { []byte as b => const_image_flat(b); error as e => return e }
        null => const_struct_bytes(const_name, name, init, layouts, enums)
    }
}

/**
 * serialize_const — the complete rodata image of an aggregate const, dispatched on its resolved value
 * type (#594 crumb 6 + T-B6; 0.3.1.0 degrau const-slice): a `str` (raw UTF-8), a `[]T` (flat-scalar
 * bytes, or fat `{ptr, len}` slots), a flat-POD or pointer-bearing struct, or an empty-case `variant`
 * (its tag image, #594 crumb 9b). A `str`/flat-`[]T`/flat-struct/variant returns its bytes with EMPTY
 * `relocs`/`leaves` (byte-identical to crumb 6); a pointer-bearing aggregate — a struct with a
 * slice/`str` FIELD (the ABI descriptors) or a slice with a `str`/`[]T` ELEMENT (the runtime-symbol
 * tables) — returns the blob with zeroed pointer slots, one `LDataReloc` per fat member, and each
 * target array's leaf. The `_` arm (neither Str/Slice/Named) still honest-stops (no const in the corpus
 * reaches it).
 *
 * @param cd       the residual typed const declaration (its name, type + checked initializer)
 * @param layouts  the program's struct-layout table
 * @param variants the program's variant table
 * @param enums    the program's declared-enum table (an enum field/element's integer width)
 * @return         the const's complete rodata image (bytes + internal relocs + leaves)
 * @throws         a Tier-A-follow-up / Tier-B (T-B) honest-stop for an unmaterializable aggregate form
 * @since #594 crumb 6 (bytes) + T-B6 (relocs + leaves)
 */
fn serialize_const(cd: checker::TConstDecl, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo) -> ConstImage | error {
    match cd.ty {
        checker::Str => match const_str_bytes(cd.init) { []byte as b => const_image_flat(b); error as e => return e }
        checker::Slice as s => const_slice_image(cd.name, s.element, cd.init, enums)
        checker::Named as n => const_named_bytes(cd.name, n.name, cd.init, layouts, variants, enums)
        _ => error { message = "const aggregate: pointer/slice-bearing value is Tier-B (T-B), not crumb 6 (#594)" }
    }
}

/**
 * intern_aggregate_const_decl — materialize one residual TConstDecl into rodata (#594 crumb 6 + T-B6):
 * a scalar const (already inlined + dropped by `inline_consts`) is a defensive skip; a Tier-A aggregate
 * interns ONE entry (empty relocs); a pointer-bearing aggregate (an ABI descriptor) interns first each
 * target-array LEAF entry (in field order, deterministic symbols) and THEN the main blob with its
 * `LDataReloc`s. The leaves-before-blob order is deterministic (declared field order), so cumulative
 * bases and rebased offsets stay stable across generations (writers' determinism requirement).
 *
 * @param m        the module accumulated so far
 * @param cd       the residual typed const declaration
 * @param layouts  the program's struct-layout table
 * @param variants the program's variant table
 * @param enums    the program's declared-enum table (an enum field/element's integer width)
 * @return         the module with the const's leaves + blob appended (unchanged for a scalar const)
 * @throws         a Tier-A-follow-up / Tier-B (T-B) honest-stop for an unmaterializable aggregate
 * @since #594 crumb 6 + T-B6
 */
fn intern_aggregate_const_decl(m: LModule, cd: checker::TConstDecl, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo) -> LModule | error {
    if const_decl_is_scalar(cd.ty) { return m }
    let img = match serialize_const(cd, layouts, variants, enums) { ConstImage as x => x; error as e => return e }
    mut cur = m
    mut i: u64 = 0
    loop {
        if i >= img.leaves.len { break }
        cur = add_rodata(cur, img.leaves[i])
        i++
    }
    add_rodata(cur, LRodata { symbol = const_rodata_symbol(cd.name); bytes = img.bytes; relocs = img.relocs })
}

/**
 * intern_aggregate_const_item — fold one program item into the module's rodata: an aggregate
 * TConstDecl interns its byte image, every other item is a no-op (#594 crumb 6).
 *
 * @param m        the module accumulated so far
 * @param it       the program item to fold
 * @param layouts  the program's struct-layout table
 * @param variants the program's variant table
 * @param enums    the program's declared-enum table (an enum field/element's integer width)
 * @return         the module with `it`'s rodata contribution (unchanged for a non-const item)
 * @throws         a Tier-A-follow-up / Tier-B (T-B) honest-stop for an unmaterializable aggregate
 */
fn intern_aggregate_const_item(m: LModule, it: checker::TItem, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo) -> LModule | error {
    match it {
        checker::TConstDecl as cd => intern_aggregate_const_decl(m, cd, layouts, variants, enums)
        _ => m
    }
}

/**
 * intern_aggregate_consts — intern every Tier-A aggregate const's byte image into the module's rodata
 * BEFORE any function lowers (#594 crumb 6), so each const gets ONE rodata entry, at a stable symbol,
 * that every reference site (function body OR virtual main) resolves against `m.rodata`. `m.globals`
 * stays empty — an aggregate const lives in rodata, never in a global, so no globals honest-stop is
 * reachable.
 *
 * @param m        the module (layouts registered, rodata still empty)
 * @param items    the typed program's top-level items
 * @param layouts  the program's struct-layout table
 * @param variants the program's variant table
 * @param enums    the program's declared-enum table (an enum field/element's integer width)
 * @return         the module with one rodata entry per Tier-A aggregate const
 * @throws         a Tier-A-follow-up / Tier-B (T-B) honest-stop for an unmaterializable aggregate
 */
fn intern_aggregate_consts(m: LModule, items: []checker::TItem, layouts: []LStructLayout, variants: []LVariantDef, enums: []LEnumInfo) -> LModule | error {
    mut cur = m
    mut i: u64 = 0
    loop {
        if i >= items.len { break }
        cur = match intern_aggregate_const_item(cur, items[i], layouts, variants, enums) { LModule as x => x; error as e => return e }
        i++
    }
    cur
}

/**
 * collect_variant_defs — the name + EXPANDED union type of every `variant` type declaration in
 * `prog`, in program order (#594 crumb 9b; expanded since the declared-variant match-arm fix).
 *
 * A `variant`-typed value's declared type resolves to a NOMINAL `Named` (`resolve_named` keeps user
 * types nominal), never to the `checker::Variant` an inline `A | B` arrives as — so every
 * union-shaped decision in this backend needs the members recovered here: the tag a const's rodata
 * image carries (`const_variant_bytes`), the wrapper a value is constructed into
 * (`lower_value_into_type`) and the tag a `match` arm tests (`lower_bind_pattern_test`) all read
 * THIS table, through `expand_named_variant`.
 *
 * The body is expanded by the checker's OWN resolver (`checker::resolve_type`, the same call
 * `checker::expand_variant` makes), over a table keyed the way that resolver reads names
 * (`declared_type_table`) — so a member's resolved type here is the CANONICAL member type the
 * checker itself would name (`ns::Circle`, not a bare `Circle`), including its canonical ordering (a
 * `null`-bearing union is null-first). A non-variant type declaration contributes no entry.
 *
 * @param prog  the whole typed program to scan
 * @return      every declared variant's name + expanded union type, in program order
 */
fn collect_variant_defs(prog: checker::TProgram) -> []LVariantDef {
    let table = declared_type_table(prog)
    mut out: []LVariantDef = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = collect_variant_def_item(out, prog.items[i], table)
        i++
    }
    out
}

/**
 * declared_type_table — the program's type declarations as a `checker::TypeTable` keyed the way
 * `checker::resolve_type` reads it: each entry's `name` is the declaration's BARE name and its
 * `namespace` is that name's qualifier.
 *
 * WHY NOT `checker::type_table_of`. That helper keys every entry by the declaration's name AS IT
 * STANDS in the typed program — which is the CANONICAL `ns::Name` — with an empty namespace. The
 * resolver's own R3 rule matches a bare reference as `entry.name == last && entry.namespace ==
 * ref_ns`, so against such a table a member written `Circle` resolves to nothing and the whole
 * variant body silently falls back to unqualified nominal members. Splitting the canonical name
 * back into (namespace, bare) is what makes the resolver answer with canonical member names.
 *
 * @param prog  the whole typed program
 * @return      the program's declarations, keyed (bare name, namespace)
 * @since 0.3.1.0 (the declared-variant match-arm miscompilation)
 */
fn declared_type_table(prog: checker::TProgram) -> checker::TypeTable {
    mut out: checker::TypeTable = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = push_declared_type_reg(out, prog.items[i])
        i++
    }
    out
}

/**
 * push_declared_type_reg — `acc` extended with `it`'s registration when it is a type declaration,
 * unchanged otherwise.
 *
 * @param acc  the table accumulated so far
 * @param it   the program item to fold
 * @return     `acc`, with `it`'s registration appended when applicable
 */
fn push_declared_type_reg(acc: checker::TypeTable, it: checker::TItem) -> checker::TypeTable {
    match it {
        parser::TypeDecl as td => teko::list::push(acc, checker::TypeReg {
            name = checker::name_last_segment(td.name); namespace = checker::name_qualifier(td.name)
            file = ""; vis = td.vis; decl = td
        })
        _ => acc
    }
}

/**
 * collect_variant_def_item — accumulate `it`'s variant definition onto `acc`, unchanged for every
 * other item kind (#594 crumb 9b).
 *
 * @param acc    the variant table accumulated so far
 * @param it     the program item to fold
 * @param table  the program's type table, for the body's expansion
 * @return       `acc`, with `it`'s variant definition appended when applicable
 */
fn collect_variant_def_item(acc: []LVariantDef, it: checker::TItem, table: checker::TypeTable) -> []LVariantDef {
    match it {
        parser::TypeDecl as td => collect_variant_def_decl(acc, td, table)
        _ => acc
    }
}

/**
 * collect_variant_def_decl — accumulate `td`'s expanded union onto `acc` when its body is a
 * `VariantBody`; unchanged for any other type-declaration shape (struct/class/enum/…).
 *
 * @param acc    the variant table accumulated so far
 * @param td     the type declaration to fold
 * @param table  the program's type table, for the body's expansion
 * @return       `acc`, with `td`'s variant definition appended when applicable
 */
fn collect_variant_def_decl(acc: []LVariantDef, td: parser::TypeDecl, table: checker::TypeTable) -> []LVariantDef {
    match td.body {
        parser::VariantBody as vb => teko::list::push(acc, LVariantDef { name = td.name; ty = variant_body_expanded(vb, checker::name_qualifier(td.name), table) })
        _ => acc
    }
}

/**
 * collect_field_decls — the DECLARED field types of every field-shaped type declaration in `prog`,
 * in program order: the checker-typed companion of `collect_struct_layouts` (degrau 25, #382).
 *
 * Keyed by the SAME canonical declaration name the layout table is keyed by (`td.name`, the key
 * `find_struct_layout` probes), so one struct-literal store site resolves its offset and its
 * DECLARED field type out of two tables that can never disagree about which declaration they
 * describe. A `class` contributes its EFFECTIVE instance fields (`class_instance_fields` — the same
 * base-first flattening `push_class_layout` registers), so a field inherited from a base coerces
 * exactly like one declared on the class itself.
 *
 * @param prog  the whole typed program to scan
 * @return      every field-shaped declaration's declared field types, in program order
 * @throws      propagated from a class's base-chain walk (an unknown or non-class base — an
 *              invariant the checker already enforces)
 */
fn collect_field_decls(prog: checker::TProgram) -> []LFieldDecls | error {
    let dtable = declared_type_table(prog)
    let ctable = checker::type_table_of(prog)
    mut out: []LFieldDecls = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = match collect_field_decls_item(out, prog.items[i], dtable, ctable) {
            []LFieldDecls as next => next
            error as e => return e
        }
        i++
    }
    out
}

/**
 * collect_field_decls_item — accumulate `it`'s declared field types onto `acc` when it is a
 * field-shaped type declaration, unchanged for every other item kind.
 *
 * @param acc     the field-declaration table accumulated so far
 * @param it      the typed top-level item to inspect
 * @param dtable  the (bare name, namespace)-keyed table `checker::resolve_type` reads
 * @param ctable  the canonically-keyed table a class's base-chain walk reads
 * @return        `acc`, extended with `it`'s declared field types when it declares any
 * @throws        propagated from a class's base-chain walk
 */
fn collect_field_decls_item(acc: []LFieldDecls, it: checker::TItem, dtable: checker::TypeTable, ctable: checker::TypeTable) -> []LFieldDecls | error {
    match it {
        parser::TypeDecl as td => collect_field_decls_decl(acc, td, dtable, ctable)
        _ => acc
    }
}

/**
 * collect_field_decls_decl — accumulate `td`'s declared field types onto `acc` when its body is
 * field-shaped (a `struct`'s own fields, a `class`'s effective instance fields); unchanged for any
 * other declaration shape (enum/flags/variant/alias/interface/trait).
 *
 * @param acc     the field-declaration table accumulated so far
 * @param td      the type declaration to fold
 * @param dtable  the (bare name, namespace)-keyed table `checker::resolve_type` reads
 * @param ctable  the canonically-keyed table a class's base-chain walk reads
 * @return        `acc`, with `td`'s declared field types appended when applicable
 * @throws        propagated from a class's base-chain walk
 */
fn collect_field_decls_decl(acc: []LFieldDecls, td: parser::TypeDecl, dtable: checker::TypeTable, ctable: checker::TypeTable) -> []LFieldDecls | error {
    match td.body {
        parser::StructBody as sb => teko::list::push(acc, field_decls_of(td.name, sb.fields, dtable))
        parser::ClassBody as cb => {
            let fields = match class_instance_fields(td.name, cb, ctable) { []parser::Field as fs => fs; error as e => return e }
            teko::list::push(acc, field_decls_of(td.name, fields, dtable))
        }
        _ => acc
    }
}

/**
 * field_decls_of — one declaration's `LFieldDecls`: each field's syntactic annotation resolved
 * through the checker's OWN resolver (`checker::resolve_type`, over the declaring namespace), in
 * declared order.
 *
 * An annotation that does not resolve (a generic type parameter, a forward reference a synthesized
 * fixture never declared) contributes the `Void` marker, which `find_field_decl_type` reports as
 * "no declared type" — the store site then lowers the value plainly, exactly as it did before this
 * table existed. Resolution never fails the whole build for a field whose type only ever mattered
 * to a placement that does not need coercion.
 *
 * @param name    the declaration's canonical (declaring) name — the lookup key
 * @param fields  the declaration's fields, in declared order
 * @param dtable  the (bare name, namespace)-keyed table `checker::resolve_type` reads
 * @return        the declaration's field names + resolved declared field types, parallel and in order
 */
fn field_decls_of(name: str, fields: []parser::Field, dtable: checker::TypeTable) -> LFieldDecls {
    let ns = checker::name_qualifier(name)
    mut names: []str = teko::list::empty()
    mut types: []checker::Type = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= fields.len { break }
        names = teko::list::push(names, fields[i].name)
        types = teko::list::push(types, resolved_field_type(fields[i].type_ann, ns, dtable))
        i++
    }
    LFieldDecls { name = name; field_names = names; field_types = types }
}

/**
 * resolved_field_type — a field annotation as a resolved `checker::Type`, or the `Void` marker when
 * it does not resolve (`field_decls_of`'s "no declared type" answer).
 *
 * @param te      the field's syntactic type annotation
 * @param ns      the namespace the field was declared in
 * @param dtable  the (bare name, namespace)-keyed table `checker::resolve_type` reads
 * @return        the resolved declared type, or `Void` when the annotation does not resolve
 */
fn resolved_field_type(te: parser::TypeExpr, ns: str, dtable: checker::TypeTable) -> checker::Type {
    match checker::resolve_type(te, dtable, ns) {
        checker::Type as t => t
        error => unresolved_named_fallback(te)
    }
}

/**
 * unresolved_named_fallback — the `resolved_field_type` answer for an annotation `checker::resolve_type`
 * could not resolve. A monomorphize pass stamps a generic type instance (`Parsed__g__Decl`) with a
 * BARE instance name — no namespace qualifier — and rewrites its `node: T` field to the concrete
 * spelling `type_to_texpr` produces, which is itself BARE (`Decl`, not `parser::Decl`). Resolving that
 * bare name against the field's (empty) declaring namespace then fails, and the pre-fix answer was
 * `Void` — "place with no coercion" — so a variant-typed instance field was stored UNWRAPPED: the slot
 * held a pointer to the bare payload, and a later `match` read `*(payload)` as the tag (a `str`'s ptr
 * word, garbage), took no arm, and fell to the dead exhaustiveness edge (`NATIVE-AGG-SLICE-BY-ADDRESS`
 * boxing then propagated the sentinel).
 *
 * A NAMED annotation is handed back as a bare `checker::Named` so the ONE consumer that needs the
 * declared type — `union_field_placement`'s `expand_named_variant` — can still recognize a declared
 * variant, whose whole lookup chain (`find_variant_def`) already matches by LAST SEGMENT, exactly the
 * name-tolerant reconciliation the C route's `cg_named_is_variant` uses. A name that is NOT a declared
 * variant expands to itself, `union_field_placement` returns `null`, and the store takes the same
 * uncoerced path it did before — so this only ever ADDS the wrapper a variant field always needed.
 * Any non-named annotation stays `Void` (its placement never needed a declared type).
 *
 * @param te  the annotation `resolve_type` could not resolve
 * @return    a bare `Named` for a named annotation, else the `Void` "no declared type" marker
 */
fn unresolved_named_fallback(te: parser::TypeExpr) -> checker::Type {
    match te {
        parser::NamedType as nt => checker::Named { name = type_path_joined(nt.path) }
        _ => checker::Void { }
    }
}

/**
 * type_path_joined — a type path's segment names joined by `::`, the spelling a nominal
 * `checker::Named` carries. A single-segment path (`Decl`) round-trips to its bare name.
 *
 * @param p  the type path to render
 * @return   the segment names joined by `::`
 */
fn type_path_joined(p: parser::Path) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        if i > 0 { out = teko::str::concat(out, "::") }
        out = teko::str::concat(out, p.segments[i].name)
        i++
    }
    out
}

/**
 * variant_body_expanded — a variant body's union type-expr as a resolved `checker::Variant`: the
 * checker's own `resolve_type` over the program's type table, with a NOMINAL fallback
 * (`nominal_member_types`) when the body does not resolve — a synthesized fixture whose case names
 * are not themselves declared types is the shape that reaches it.
 *
 * The fallback preserves the member COUNT and ORDER, which is the load-bearing property: an index
 * is a runtime tag, so a member silently dropped here would mis-tag every case after it.
 *
 * @param vb     the variant declaration's body
 * @param ns     the namespace the variant was declared in (its members are written there)
 * @param table  the program's type table
 * @return       the expanded union (members in declared tag order)
 */
fn variant_body_expanded(vb: parser::VariantBody, ns: str, table: checker::TypeTable) -> checker::Variant {
    let resolved = match checker::resolve_type(vb.type_expr, table, ns) {
        checker::Type as t => t
        error => return checker::Variant { members = nominal_member_types(vb.type_expr) }
    }
    match resolved {
        checker::Variant as v => v
        _ => checker::Variant { members = nominal_member_types(vb.type_expr) }
    }
}

/**
 * nominal_member_types — each member of a union type-expr as a bare nominal `checker::Named`, in
 * source order: the resolution-free fallback of `variant_body_expanded`. A member that is not a
 * `NamedType` still contributes an (empty-named, unnameable) entry, so the member COUNT — and with
 * it every later member's tag — survives.
 *
 * @param te  the variant body's type-expr (a union of member types)
 * @return    one nominal member type per declared member, in order
 */
fn nominal_member_types(te: parser::TypeExpr) -> []checker::Type {
    match te {
        parser::UnionType as ut => union_member_types(ut.members)
        _ => teko::list::empty()
    }
}

/**
 * union_member_types — one bare `checker::Named` per member of a union type-expr, in order, named by
 * the member path's last segment (the empty string for a non-named member — a name no pattern can
 * spell, so it is never selected by accident).
 *
 * @param members  the union's member type-exprs
 * @return         one nominal member type per member, in order
 */
fn union_member_types(members: []parser::TypeExpr) -> []checker::Type {
    mut out: []checker::Type = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= members.len { break }
        out = teko::list::push(out, checker::Named { name = union_member_name(members[i]) })
        i++
    }
    out
}

/**
 * union_member_name — a union member type-expr's case name: a `NamedType`'s path last segment, or
 * the empty string for any other shape.
 *
 * @param te  the member type-expr
 * @return    the member's case name, or `""`
 */
fn union_member_name(te: parser::TypeExpr) -> str {
    match te {
        parser::NamedType as nt => type_path_last_name(nt.path)
        _ => ""
    }
}

/**
 * type_path_last_name — the last segment's name of a type-path (`a::B` -> `B`), or the empty string
 * for a segment-less path (an internal invariant break the caller never produces) (#594 crumb 9b).
 *
 * @param p  the type path
 * @return   the path's last segment name
 */
fn type_path_last_name(p: parser::Path) -> str {
    if p.segments.len == 0 { return "" }
    p.segments[p.segments.len - 1].name
}
