use teko::checker

pub type LoweredFat = struct { ctx: LowerCtx; ptr: u32; len: u32 }

/**
 * lower_fat_expr — lower a `str`/`[]T`-typed expression to its (ptr, len) pair. The CLOSED set of
 * fat-pointer PRODUCERS: a string literal (fresh rodata), an array literal (fresh alloca + a
 * compile-time-known element count), a local bound via `lenv_bind_fat` (a `let` of str/slice
 * type), a struct field of fat type (`lower_fat_field`), an `if`-expression whose result is fat
 * (`lower_if_fat`, degrau 5), a `match`-VALUE whose result is fat (`lower_match_fat`, 0.3.1.0
 * degrau 5), a DIRECT call whose own result is fat (`lower_call_fat`; measured via a corpus probe
 * to be the shape that actually reaches this site — a closure-call/interface-dispatch receiver is
 * `lower_call_fat`'s OWN narrower named stop, not this one), a string interpolation
 * (`lower_interp_fat`: pieces/holes concatenated through the runtime's out-parameter-length twins,
 * `lower_len_out_call`, closed at 0.3.1.0 degrau 9), and — closed at 0.3.1.0 degrau 10 — an index
 * into a slice of FAT elements (`[]str`/`[][]T`, `lower_index_fat`: the element's two-word
 * `{ptr, len}` pair, read back at the SAME stride the array literal's store and the push's
 * `sizeof` now share, `elem_byte_stride`). Any other producer (a deeper field/index chain over a
 * fat result, …) honest-stops — those arrive with a wider fat-pointer ABI in a later phase (A1-4,
 * #382; if-expression producer: degrau 5, cargo/20-degrau5-if-gordo; call producer: call-gordo
 * degrau, #382 N2; interpolation producer: 0.3.1.0 degrau 9; index producer: 0.3.1.0 degrau 10).
 *
 * @param ctx  the lowering context
 * @param e    the fat-typed (`str`/`[]T`) expression to lower
 * @return     the (ptr, len) pair
 * @throws     when `e`'s kind is outside the closed producer set documented above
 */
pub fn lower_fat_expr(ctx: LowerCtx, e: checker::TExpr) -> LoweredFat | error {
    match e.kind {
        checker::TStrLit as s => lower_str_lit_fat(ctx, e, s)
        checker::TArrayLit as al => lower_array_lit_fat(ctx, e, al)
        checker::TVar as v => lower_var_fat(ctx, e, v)
        checker::TFieldAccess as fa => lower_fat_field(ctx, fa)
        checker::TIfExpr as f => lower_if_fat(ctx, e, f)
        checker::TMatchExpr as mx => lower_match_fat(ctx, e, mx)
        checker::TCall as cl => lower_call_fat(ctx, e, cl)
        checker::TInterp as ip => lower_interp_fat(ctx, e, ip)
        checker::TIndex as ix => lower_index_fat(ctx, e, ix)
        _ => error { message = teko::str::concat("native backend N1: fat-pointer receiver `", texpr_kind_name(e), "` not yet lowered (N2)") }
    }
}
