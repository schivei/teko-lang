use teko::checker
use teko::lexer
use teko::parser
pub fn lower_fat_expr(ctx: LowerCtx, e: checker::TExpr) -> LoweredFat | error {
    match e.kind {
        checker::TStrLit as s => lower_str_lit_fat(ctx, e, s)
        checker::TArrayLit as al => lower_array_lit_fat(ctx, e, al)
        checker::TVar as v => lower_var_fat(ctx, e, v)
        checker::TFieldAccess as fa => lower_fat_field(ctx, fa)
        checker::TIfExpr as f => lower_if_fat(ctx, e, f)
        checker::TCall as cl => lower_call_fat(ctx, e, cl)
        _ => error { message = teko::str::concat("native backend N1: fat-pointer receiver `", texpr_kind_name(e), "` not yet lowered (N2)") }
    }
}

/**
 * lower_call_fat — lower a DIRECT call's fat (`str`/`[]T`) RESULT to its (ptr, len) pair: the
 * caller allocates an 8-byte out-slot for the length half (`ret_len_out_slot`'s own mirror on the
 * CALL side), passes its address as ONE EXTRA argument appended AFTER the call's own
 * ABI-flattened args, then reads the length back out of that slot once the call returns — its
 * ptr half arrives in the call's ordinary single result VReg, unchanged. This is the caller-side
 * half of the SAME hidden-out-parameter contract `lower_function`'s `bind_ret_len_slot` reserves
 * on the callee side: both sides agree because both are lowered by this SAME backend (mirrors
 * `bind_fat_param`'s "a caller and callee compiled by this backend never disagree" doc) — no true
 * platform-ABI register pair (SysV's RAX:RDX) is needed, since a fat-returning Teko function is
 * never called from outside this backend's own output.
 *
 * A closure-call or interface-dispatch receiver honest-stops by name (their own vtable/thunk
 * calling convention does not yet reserve this hidden slot on the callee side) — this degrau
 * closes only the PLAIN direct-call producer, the shape the corpus probe measured actually
 * reaching this site (#382 N2, call-gordo degrau).
 *
 * The `teko::list::*`/`teko::mem::push_fo` GROWTH-BUILTIN family is intercepted BEFORE the
 * hidden-out-slot convention is applied (`lower_list_builtin`): those calls target the runtime's
 * OWN fixed C ABI (`tk_slice_push`), which owes this backend no hidden length register — its
 * length travels through an explicit `uint64_t *out_len` argument instead (list-builtin degrau).
 *
 * @param ctx  the lowering context
 * @param e    the fat-typed call expression (its type is `str`/`[]T`)
 * @param cl   the call node
 * @return     the (ptr, len) pair
 * @throws     when the call is a closure/interface-dispatch call (a NAMED, narrower honest stop
 *             than `lower_fat_expr`'s generic one), or propagated from resolving/lowering
 */
fn lower_call_fat(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    if cl.is_closure_call { return error { message = "native backend N1: fat-pointer closure-call result not yet lowered (N2)" } }
    if cl.is_iface_dispatch { return error { message = "native backend N1: fat-pointer interface-dispatch result not yet lowered (N2)" } }
    if cl.call_ns.len == 0 && is_list_builtin_call(cl.callee) { return lower_list_builtin(ctx, e, cl) }
    let sym = match call_symbol(cl, ctx.externs, ctx.flat_symbols) { str as s => s; error as err => return err }
    let lo = match lower_args(ctx, cl.args) { LoweredArgs as x => x; error as err => return err }
    let slot = ctx_alloc(lo.ctx)
    let with_slot = ctx_append(slot.ctx, alloca_inst(slot.vreg, ltype_size(LType::I64), ltype_align(LType::I64), e.line, e.col))
    let all_args = teko::list::push(lo.vregs, slot.vreg)
    let called = ctx_alloc(with_slot)
    let with_call = ctx_append(called.ctx, call_inst(called.vreg, sym, all_args, false, e.line, e.col))
    let lenr = ctx_alloc(with_call)
    let with_len = ctx_append(lenr.ctx, load_inst(lenr.vreg, slot.vreg, LType::I64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = called.vreg; len = lenr.vreg }
}

/**
 * lower_list_builtin — the checker's OWN generic growth-builtin family (`is_list_builtin_call`:
 * `teko::list::empty`, `teko::list::push`, `teko::mem::push_fo`, `teko::list::with_cap`) lowered to
 * its runtime backing. These calls leave NO declaration behind for the mangler to resolve, so
 * without this arm `call_symbol` honest-stopped on every one of them — the single step that kept
 * the own backend from compiling any program that grows a list, the compiler itself included.
 *
 * `empty()` needs no runtime at all (the empty slice IS the (null, 0) pair); `push`/`push_fo` route
 * to the amortized runtime grow (`slice_push_symbol`), the SAME entry points the retired C emitter
 * targeted, so one buffer-growth policy serves both producers.
 *
 * @param ctx  the lowering context
 * @param e    the builtin call expression (its type carries the concretized `[]T`)
 * @param cl   the call node
 * @return     the grown/empty slice as its (ptr, len) pair
 * @throws     for `teko::list::with_cap` (no compiler source calls it, and its sentinel result type
 *             carries no element width to size the buffer with — a NAMED stop rather than a guess),
 *             or propagated from lowering the base/item
 */
fn lower_list_builtin(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall) -> LoweredFat | error {
    let last = cl.callee.segments[cl.callee.segments.len - 1].name
    if last == "empty" { return lower_list_empty(ctx, e) }
    if last == "push" || last == "push_fo" { return lower_list_push(ctx, e, cl, slice_push_symbol(last)) }
    error { message = "native backend N1: `teko::list::with_cap` has no native lowering yet (N2)" }
}

/**
 * slice_push_symbol — the runtime grow entry a push spelling targets: the plain amortized
 * `tk_slice_push` for `teko::list::push`, and the free-old-on-grow `tk_slice_push_fo` for the
 * `teko::mem::push_fo` DECREE (the caller asserts the base is a linear chain, so the superseded
 * buffer is parked at the grow). The region-scoped third variant (`tk_slice_push_r`) is NOT
 * selectable here: this backend has no S1 region frames to grow into, so every push is a root push.
 *
 * @param last  the callee path's last segment (`push` or `push_fo`)
 * @return      the runtime symbol the `LCall` targets
 */
fn slice_push_symbol(last: str) -> str {
    if last == "push_fo" { return "tk_slice_push_fo" }
    "tk_slice_push"
}

/**
 * lower_list_empty — `teko::list::empty()`: the empty slice's (ptr, len) pair is a pair of zero
 * constants, with no runtime call and no element type needed. The retired C emitter required a
 * CONCRETE element type here only because it had to spell a struct literal's typename; the own
 * backend's fat pair is type-erased, so a bare sentinel `empty()` lowers just as well as an
 * annotated one.
 *
 * @param ctx  the lowering context
 * @param e    the `empty()` call expression (its source position)
 * @return     the (null, 0) pair
 */
fn lower_list_empty(ctx: LowerCtx, e: checker::TExpr) -> LoweredFat {
    let p = ctx_alloc(ctx)
    let with_ptr = ctx_append(p.ctx, const_int_inst(p.vreg, 0, e.line, e.col))
    let l = ctx_alloc(with_ptr)
    let with_len = ctx_append(l.ctx, const_int_inst(l.vreg, 0, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = p.vreg; len = l.vreg }
}

/**
 * lower_list_push — `teko::list::push(base, item)` / `teko::mem::push_fo(base, item)`: the
 * value-semantics grow-by-one, lowered to the runtime's amortized copy-grow. The runtime takes the
 * item BY ADDRESS and returns the length through an out-parameter, so the caller reserves two frame
 * slots — one sized to the element, one to the `u64` length — stores the item into the first, and
 * loads the new length back out of the second once the call returns:
 *
 *   `<sym>(base.ptr, base.len, &item, sizeof(elem), &out_len)` -> the grown buffer's pointer
 *
 * The element is restricted to a REGISTER VALUE (`is_register_value_type`): a primitive or an
 * enum's carrier. The coercion `lower_value_into_type` performs for a declared-type placement (the
 * union wrapper a bare case needs when it flows into a `[]Variant`) is therefore not reachable
 * here — a variant element is an aggregate and stops first (`aggregate_element_push_stop`) — so the
 * item lowers plainly.
 *
 * @param ctx  the lowering context
 * @param e    the push call expression (its type is the result `[]T`)
 * @param cl   the call node (`args[0]` the base slice, `args[1]` the item)
 * @param sym  the runtime grow symbol (`slice_push_symbol`)
 * @return     the grown slice's (ptr, len) pair
 * @throws     on a malformed call, on a FAT element type (`fat_element_push_stop`), on an
 *             AGGREGATE element type (`aggregate_element_push_stop`), or propagated from lowering
 *             the base/item
 */
fn lower_list_push(ctx: LowerCtx, e: checker::TExpr, cl: checker::TCall, sym: str) -> LoweredFat | error {
    if cl.args.len != 2 { return error { message = "native backend N1: `teko::list::push` expects (slice, item) (internal)" } }
    let elem = match push_elem_type(e, cl) { checker::Type as t => t; error as err => return err }
    if is_fat_type(elem) { return fat_element_push_stop() }
    if !is_register_value_type(elem, ctx.enums) { return aggregate_element_push_stop() }
    let elem_lt = ltype_of(elem, ctx.enums)
    if ltype_size(elem_lt) == 0 { return error { message = "native backend N1: `teko::list::push` of a `void`-sized element (internal)" } }
    let base = match lower_fat_expr(ctx, cl.args[0]) { LoweredFat as x => x; error as err => return err }
    let item = match lower_expr(base.ctx, cl.args[1]) { Lowered as x => x; error as err => return err }
    let slots = reserve_push_slots(item.ctx, item.vreg, elem_lt, e)
    let args = push_call_args(base.ptr, base.len, slots.item_slot, slots.esz, slots.len_slot)
    let called = ctx_alloc(slots.ctx)
    let with_call = ctx_append(called.ctx, call_inst(called.vreg, sym, args, false, e.line, e.col))
    let lenr = ctx_alloc(with_call)
    let with_len = ctx_append(lenr.ctx, load_inst(lenr.vreg, slots.len_slot, LType::I64, e.line, e.col))
    LoweredFat { ctx = with_len; ptr = called.vreg; len = lenr.vreg }
}

/**
 * fat_element_push_stop — the NAMED honest stop for pushing onto a slice whose ELEMENT is itself
 * fat (`[]str`, `[][]T`). Such an element's machine image is two words, not the one word
 * `ltype_of` reports for it, and the element WIDTH is a whole-backend fact: the array literal's
 * store stride, the index load, and this push's `sizeof` argument must pick the same number or the
 * buffer is read back shifted. Widening all three (and giving `lower_fat_expr` an index producer to
 * read the pair back with) is its own degrau; refusing here keeps the scalar-element push honest
 * instead of emitting a call that agrees with nothing.
 *
 * @return  the honest stop, always
 */
fn fat_element_push_stop() -> error {
    error { message = "native backend N1: a push onto a slice of FAT elements (`[]str`/`[][]T`) needs the two-word element stride the array-literal store and the index load do not carry yet (N2)" }
}

/**
 * aggregate_element_push_stop — the NAMED honest stop for pushing an AGGREGATE element (a
 * `struct`/`class` instance, a variant wrapper, an `Optional`, a closure). This backend's value for
 * such a type is the ADDRESS of an alloca, and an alloca is ONE frame slot reserved per
 * INSTRUCTION, not per execution: the canonical `loop { out = push(out, T { … }) }` would push the
 * SAME address every iteration, so the finished list would read back as N copies of the last item.
 * Storing the element BY VALUE instead (a layout-sized stride the array-literal store and the index
 * load would have to adopt too, and a deep copy for the aggregate FIELDS that are themselves
 * addresses) is the next degrau; a silently aliasing push is not an acceptable stand-in for it.
 *
 * @return  the honest stop, always
 */
fn aggregate_element_push_stop() -> error {
    error { message = "native backend N1: a push whose element is an AGGREGATE (`struct`/`class`/variant/optional/closure) needs slice elements held BY VALUE — this backend's aggregate value is the address of a per-INSTRUCTION frame slot, so a push in a loop would store the same address every iteration (N2)" }
}

/**
 * is_register_value_type — is a value of type `t` a SELF-CONTAINED register value, as opposed to
 * the address of a frame slot this backend may reuse? True for the primitives (every integer,
 * float, `bool`, `byte`) and for a declared `enum` (its integer carrier); false for every
 * aggregate, whose `Ptr` machine class is an ADDRESS rather than the value itself. The distinction
 * is invisible in `ltype_of` — a struct and a `ptr<T>` are both `Ptr` there — but it is exactly
 * what decides whether a value may be COPIED INTO A CONTAINER that outlives its producing
 * statement.
 *
 * @param t      the element type to classify
 * @param enums  the program's declared-enum table (an enum's carrier IS a register value)
 * @return       true iff a value of `t` is the whole datum, not a pointer to it
 */
fn is_register_value_type(t: checker::Type, enums: []LEnumInfo) -> bool {
    match t {
        checker::Prim => true
        checker::Named as n => match find_enum_info(enums, n.name) { LEnumInfo => true; null => false }
        _ => false
    }
}

/**
 * push_elem_type — the CONCRETE element type of a push call. The call's own `.type` answers it
 * directly in the ordinary case, but `type_assign` may overwrite that type with the sentinel
 * (`[]<Void>`) when `push(xs, i)` is assigned back into a sentinel-typed `xs`, so the base
 * argument's concretized slice type and finally the item's own type are consulted in turn. Mirrors
 * the retired C emitter's `get_push_elem` fallback chain exactly — one recovery rule, so the two
 * producers can never disagree about which element a given push grows.
 *
 * @param e   the push call expression
 * @param cl  the call node
 * @return    the element type the pushed buffer holds
 * @throws    when neither the call, its base, nor its item carries a concrete type (internal)
 */
fn push_elem_type(e: checker::TExpr, cl: checker::TCall) -> checker::Type | error {
    match e.type {
        checker::Slice as sl => match sl.element { checker::Void => { }; _ => return sl.element }
        _ => return error { message = "native backend N1: `teko::list::push` result is not a slice (internal)" }
    }
