use teko::checker
use teko::lexer
use teko::parser

/**
 * close_virtual_main — fire any still-pending top-level defer (from index 0,
 * LIFO, A1-2, #382) and, when the body did not already terminate, append
 * either `ret %v` (`tail.vreg`, when the loose top-level statements' trailing
 * expression supplied one, #423) or `%r = const 0; ret %r` (no trailing
 * value).
 *
 * @param LowerMainTail tail  the lowered loose top-level statements' outcome
 * @return LowerCtx | error  the closed context, or a NAMED internal error
 *                           when a pending defer fails to lower
 */
fn close_virtual_main(tail: LowerMainTail) -> LowerCtx | error {
    if block_terminated(tail.ctx.func, tail.ctx.block_id) { return tail.ctx }
    let replayed = match replay_defers(tail.ctx, 0) { LowerCtx as c => c; error as err => return err }
    if tail.has_value { return ctx_append(replayed, ret_inst(tail.vreg, 0, 0)) }
    let r = ctx_alloc(replayed)
    let c0 = ctx_append(r.ctx, const_int_inst(r.vreg, 0, 0, 0))
    ctx_append(c0, ret_inst(r.vreg, 0, 0))
}

/**
 * NATIVE_ENTRY_VMAIN_SYMBOL — the internal symbol `wrap_native_entry` renames the synthesized
 * virtual-main `LFunc` to, once its own platform-ABI entry stub takes the bare `"main"` name.
 * Never producible by `mangle_fn_symbol`: every real user symbol is either `TEKO_USER_PREFIX`-
 * decorated or, under `flat`, `<ns>__<name>` — both shapes require a non-empty escaped name
 * segment, never this literal's leading double underscore — so a real program's own function
 * can never collide with it.
 */
const NATIVE_ENTRY_VMAIN_SYMBOL: str = "__teko_native_vmain"

/**
 * native_entry_rename_vmain — `funcs` with the synthesized virtual-main (the exact,
 * un-namespaced `"main"` symbol `lower_virtual_main` builds) renamed to
 * `NATIVE_ENTRY_VMAIN_SYMBOL`, every other function unchanged.
 *
 * @param funcs  the lowered module's whole-program function table
 * @return       `funcs` with the virtual-main renamed, or a NAMED internal error when no
 *               function is named `"main"`
 */
fn native_entry_rename_vmain(funcs: []LFunc) -> []LFunc | error {
    mut out: []LFunc = teko::list::empty()
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= funcs.len { break }
        let f = funcs[i]
        if f.symbol == "main" {
            found = true
            out = teko::list::push(out, rename_lfunc(f, NATIVE_ENTRY_VMAIN_SYMBOL))
        } else {
            out = teko::list::push(out, f)
        }
        i++
    }
    if !found { return error { message = "native backend: wrap_native_entry — no `main` entry function found in the lowered module (internal)" } }
    out
}

/**
 * append_exit_status_mask — append `%m = const EXIT_STATUS_MASK; %s = %code and %m` to `f`'s entry
 * block and return the masked VReg. This is the OWN-BACKEND process-exit door: the platform ABI
 * hands `main`'s return value straight to the C runtime's `exit`, which is where POSIX truncates to
 * a byte and Windows does not, so the entry stub normalizes the code ITSELF and both platforms
 * report the same number (owner ruling 2026-07-30). Target-neutral by construction — one `IAnd`
 * over the shared LIR, lowered by whichever backend consumes the module, exactly like the
 * division-by-zero guard.
 *
 * @param f     the function whose entry block receives the two instructions
 * @param code  the VReg holding the raw, unnormalized exit code
 * @return      the advanced function plus the VReg holding `code & EXIT_STATUS_MASK`
 * @see         EXIT_STATUS_MASK
 */
fn append_exit_status_mask(f: LFunc, code: u32) -> FreshVReg {
    let maskreg = alloc_vreg(f)
    let with_mask = append_inst(maskreg.func, 0, const_int_inst(maskreg.vreg, EXIT_STATUS_MASK, 0, 0))
    let status = alloc_vreg(with_mask)
    let with_and = append_inst(status.func, 0, bin_inst(status.vreg, LBinOp::IAnd, code, maskreg.vreg, 0, 0))
    FreshVReg { func = with_and; vreg = status.vreg }
}

/**
 * native_entry_stub — the platform-ABI `"main"` `LFunc` itself: bind the two incoming
 * `argc`/`argv` registers, call `tk_set_args(argc, argv)`, call the renamed virtual-main with no
 * arguments, NORMALIZE its result to a platform-uniform exit code (`append_exit_status_mask`), and
 * return that. Built directly over the raw `LFunc`/`append_inst`/`alloc_vreg` primitives (no
 * `LowerCtx` needed — there is no checker AST behind this synthesized body, only a fixed
 * instruction sequence).
 *
 * The mask belongs HERE rather than at the virtual-main's own `ret`s because the stub is the single
 * choke point: a loose top-level `return n`, the trailing-expression exit code and the fall-through
 * `return 0` all reach the process through this one forwarded value.
 *
 * @return the entry stub `LFunc`
 */
fn native_entry_stub() -> LFunc {
    let ptypes = teko::list::push(teko::list::push(teko::list::empty(), LType::I32), LType::Ptr)
    let fn0 = new_func("main", 2, ptypes, LType::I32)
    let with_argc = append_inst(fn0, 0, param_inst(0, 0, 0, 0))
    let with_argv = append_inst(with_argc, 0, param_inst(1, 1, 0, 0))
    mut set_args_args: []u32 = teko::list::empty()
    set_args_args = teko::list::push(set_args_args, 0)
    set_args_args = teko::list::push(set_args_args, 1)
    let with_set = append_inst(with_argv, 0, void_call_inst("tk_set_args", set_args_args, false, 0, 0))
    let called = alloc_vreg(with_set)
    let with_call = append_inst(called.func, 0, call_inst(called.vreg, NATIVE_ENTRY_VMAIN_SYMBOL, teko::list::empty(), false, 0, 0))
    let status = append_exit_status_mask(with_call, called.vreg)
    append_inst(status.func, 0, ret_inst(status.vreg, 0, 0))
}
