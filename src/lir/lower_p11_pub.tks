/**
 * LSliceEqPlan — the runtime call `[]T == []T` needs for one element shape: which fixed-ABI
 * predicate to call, and whether that call ALSO needs a trailing `sizeof(T)` argument (the
 * generic `memcmp` route, `tk_slice_eq_bytes`, is generic over element width; the float/char/str
 * routes each bake the element width into their own dedicated predicate). Mirrors the C route's
 * `CgSliceEqPlan` (`codegen.tks`) — the two backends agree on WHICH runtime symbol answers each
 * element shape, only the calling convention around it (struct-by-value vs ABI-flattened) differs.
 */
pub type LSliceEqPlan = struct {
// the runtime predicate's C symbol.
    rtfn: str
// whether the call needs a trailing element-size argument.
    needs_size: bool
}

/**
 * SliceEqArgs — the outcome of building `[]T == []T`'s runtime-call argument list: the advanced
 * context (a `needs_size` plan materializes one extra `const` instruction) plus the ordered VReg
 * argument list.
 */
pub type SliceEqArgs = struct { ctx: LowerCtx; args: []u32 }
