
/**
 * LRefFnInfo — one top-level function's `ref<T>` PARAMETER-position table (0.3.1.0 degrau 18):
 * `ref_flags[i]` is true iff the function's `i`-th declared parameter is written `ref name: T`.
 * Built ONCE for the whole program (`collect_ref_fns`) and consulted by EVERY call site
 * (`find_ref_flags`), so a caller and a `ref` parameter's own binder never disagree about which
 * positions auto-ref.
 */
pub type LRefFnInfo = struct { ns: str; name: str; ref_flags: []bool }
