use teko::checker
use teko::lexer
use teko::parser

/**
 * is_ffi_aggregate_return_symbol — is `sym` one of the host primitives whose true C ABI returns an
 * aggregate wider than one register (`tk_ffi_sres`/`tk_ffi_ures`/`tk_ffi_slres`, all >16 bytes →
 * SysV MEMORY class → SRET)? These cannot ride the generic call path on the native backend, whose
 * `LCall` captures ONE result register (an un-set-up SRET pointer makes the callee write over
 * garbage and the caller SIGSEGVs — measured: gen2 crashed in `tk_rt_getenv` at startup). Keyed on
 * the RESOLVED C symbol, so it is collision-free — the symbol names the exact primitive.
 *
 * @param str sym  the resolved C symbol (`call_symbol`'s result)
 * @return bool  true iff `sym` is routed to `lower_ffi_aggregate_return_call`
 * @since 0.3.1.0 degrau 34
 */
fn is_ffi_aggregate_return_symbol(sym: str) -> bool {
    sym == "tk_rt_getenv" || sym == "tk_rt_getcwd" || sym == "tk_rt_read_file" ||
    sym == "tk_rt_list_dir" || sym == "tk_rt_setenv" || sym == "tk_rt_chdir" ||
    sym == "tk_rt_mkdir" || sym == "tk_rt_remove_file" || sym == "tk_rt_write_file" ||
    sym == "tk_rt_write_file_bytes"
}

/**
 * lower_ffi_aggregate_return_call — route a host-FFI call whose true C ABI returns an aggregate to
 * its own-register `tk_rt_*_ok` twin lowering: the `T | error` fat-payload shape
 * (`lower_ffi_fat_or_error_call`, `str` for env::var/env::cwd/io::read_file, `[]str` for
 * fs::list_dir) and the `error | null` shape (`lower_ffi_ures_call`, the writers/mutators). Called
 * only for a `sym` `is_ffi_aggregate_return_symbol` already accepted, so the final fallthrough is an
 * internal invariant break, never a real outcome (0.3.1.0 degrau 34).
 *
 * @param LowerCtx ctx  the lowering context
 * @param checker::TExpr e  the call expression (its type is the primitive's declared result variant)
 * @param checker::TCall c  the call node (its fat arguments)
 * @param str sym  the resolved C symbol (`call_symbol`'s result)
 * @return Lowered | error  the advanced context + the wrapper's base-address VReg, or a propagated
 *                          error from the shape's own lowering
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_aggregate_return_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, sym: str) -> Lowered | error {
    if sym == "tk_rt_getenv" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_getenv_ok", checker::Str { }) }
    if sym == "tk_rt_getcwd" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_getcwd_ok", checker::Str { }) }
    if sym == "tk_rt_read_file" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_read_file_ok", checker::Str { }) }
    if sym == "tk_rt_list_dir" { return lower_ffi_fat_or_error_call(ctx, e, c, "tk_rt_list_dir_ok", checker::Slice { element = checker::Str { } }) }
    if sym == "tk_rt_setenv" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_setenv_ok") }
    if sym == "tk_rt_chdir" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_chdir_ok") }
    if sym == "tk_rt_mkdir" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_mkdir_ok") }
    if sym == "tk_rt_remove_file" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_remove_file_ok") }
    if sym == "tk_rt_write_file" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_write_file_ok") }
    if sym == "tk_rt_write_file_bytes" { return lower_ffi_ures_call(ctx, e, c, "tk_rt_write_file_bytes_ok") }
    error { message = "native backend N1: unroutable aggregate-return host symbol (internal)" }
}

/**
 * FfiArgs — the flattened `(ptr, len)` VReg pairs of a host-FFI call's fat arguments, plus the
 * advanced context. Every aggregate-returning host primitive the twin family covers takes only
 * `str`/`[]byte` (fat) arguments, so `lower_ffi_fat_args` flattens each to two operands.
 */
type FfiArgs = struct {
    /** the lowering context advanced past every argument's own instructions */
    ctx: LowerCtx
    /** the flattened operands: each fat argument's `(ptr, len)`, in signature order */
    vregs: []u32
}

/**
 * lower_ffi_fat_args — lower each of `c`'s arguments (all `str`/`[]byte`, i.e. fat) into its
 * flattened `(ptr, len)` pair, accumulated left-to-right into one VReg list. The twin symbols take
 * these as SEPARATE scalar register operands (never a by-value `tk_str`), so the flat pair IS their
 * C ABI on every target (`fat_arg_builtin_arity` answers 0 for them).
 *
 * @param ctx  the lowering context
 * @param c    the call node whose arguments are lowered
 * @return     the advanced context + the flattened operand list
 * @throws     propagated from lowering any argument
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_fat_args(ctx: LowerCtx, c: checker::TCall) -> FfiArgs | error {
    mut cur = ctx
    mut vregs: []u32 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= c.args.len { break }
        let f = match lower_fat_expr(cur, c.args[i]) { LoweredFat as x => x; error as err => return err }
        cur = f.ctx
        vregs = teko::list::push(teko::list::push(vregs, f.ptr), f.len)
        i++
    }
    FfiArgs { ctx = cur; vregs = vregs }
}

/**
 * FfiOutSlots — the two out-parameter slots a `tk_rt_*_ok` twin writes its active case's
 * `(ptr, len)` into, plus the context advanced past their allocas and the twin's own narrowed
 * `bool` result (`ok`).
 */
type FfiOutSlots = struct {
    /** the `bool` result of the twin call, already narrowed to its 1-byte C width */
    ok: Lowered
    /** the pointer-half out-slot's alloca'd address */
    out_ptr: u32
    /** the length-half out-slot's alloca'd address */
    out_len: u32
}

/**
 * lower_ffi_twin_call — reserve the two `(ptr, len)` out-slots, append their addresses after the
 * call's flattened fat operands, call the `tk_rt_*_ok` twin, and narrow its `bool` result. The
 * shared front half of every aggregate-returning host-FFI lowering (`str | error`, `[]str | error`,
 * `error | null`); the arms that read the out-slots back differ per result shape.
 *
 * @param ctx     the lowering context
 * @param c       the call node whose fat arguments precede the out-slots
 * @param symbol  the `tk_rt_*_ok` twin's C symbol
 * @param line    the source line to stamp the emitted instructions with
 * @param col     the source column to stamp the emitted instructions with
 * @return        the narrowed `bool` result + the two out-slot addresses
 * @throws        propagated from lowering the arguments
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_twin_call(ctx: LowerCtx, c: checker::TCall, symbol: str, line: u32, col: u32) -> FfiOutSlots | error {
    let lo = match lower_ffi_fat_args(ctx, c) { FfiArgs as x => x; error as err => return err }
    let out_ptr = ctx_alloc(lo.ctx)
    let with_out_ptr = ctx_append(out_ptr.ctx, alloca_inst(out_ptr.vreg, ltype_size(LType::Ptr), ltype_align(LType::Ptr), line, col))
    let out_len = ctx_alloc(with_out_ptr)
    let with_out_len = ctx_append(out_len.ctx, alloca_inst(out_len.vreg, ltype_size(LType::I64), ltype_align(LType::I64), line, col))
    let call_args = teko::list::push(teko::list::push(lo.vregs, out_ptr.vreg), out_len.vreg)
    let called = ctx_alloc(with_out_len)
    let with_call = ctx_append(called.ctx, call_inst(called.vreg, symbol, call_args, false, line, col))
    let ok = narrow_extern_return(Lowered { ctx = with_call; vreg = called.vreg }, ExternNarrow { width = 8; is_signed = false }, line, col)
    FfiOutSlots { ok = ok; out_ptr = out_ptr.vreg; out_len = out_len.vreg }
}

/**
 * FfiBranch — the three-block skeleton (`then`/`else`/`merge`) plus the merge block-arg an FFI
 * result's two arms build into: each arm builds a 24-byte variant wrapper and jumps to `merge`
 * carrying its base address, so the call's own result is the merged block parameter.
 */
type FfiBranch = struct {
    /** the context after the conditional branch, positioned to enter the `then` arm */
    ctx1: LowerCtx
    /** the `then` (success) arm's block id */
    thenb: u32
    /** the `else` (failure) arm's block id */
    elseb: u32
    /** the `merge` block id both arms jump to */
    mergeb: u32
    /** the merge block parameter — the built wrapper's base address, this call's result */
    merge_param: u32
}

/**
 * lower_ffi_open_branch — emit the conditional branch on a twin's `bool` result and allocate the
 * `then`/`else`/`merge` blocks and the merge block-arg, so the shape all three FFI result families
 * share is written once. `true` enters `then`.
 *
 * @param ok    the twin call's narrowed `bool` result (its context is the branch's source block)
 * @param line  the source line to stamp the branch with
 * @param col   the source column to stamp the branch with
 * @return      the block skeleton positioned to enter the `then` arm
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_open_branch(ok: Lowered, line: u32, col: u32) -> FfiBranch {
    let thenb = alloc_block(ok.ctx.func)
    let elseb = alloc_block(thenb.func)
    let mergeb = alloc_block(elseb.func)
    let mp = add_block_param(mergeb.func, mergeb.block_id)
    let br = branch_inst(ok.vreg, thenb.block_id, teko::list::empty(), elseb.block_id, teko::list::empty(), line, col)
    let ctx1 = ctx_append(ctx_with(ok.ctx, mp.func, ok.ctx.block_id, ok.ctx.env), br)
    FfiBranch { ctx1 = ctx1; thenb = thenb.block_id; elseb = elseb.block_id; mergeb = mergeb.block_id; merge_param = mp.vreg }
}

/**
 * lower_ffi_error_else_arm — the FAILURE arm shared by every aggregate-returning host-FFI result:
 * position into the `else` block, load the error message's `(ptr, len)` out of the twin's out-slots,
 * build a boxed `error` wrapper (`lower_ffi_error_arm`), and jump to `merge` carrying it.
 *
 * @param br       the open branch skeleton (its `ctx1`/`elseb`/`mergeb`/env)
 * @param out_ptr  the message-pointer out-slot's address
 * @param out_len  the message-length out-slot's address
 * @param err_index the `error` member's declared tag index
 * @param e        the call expression (source position + threaded to the error box)
 * @return         the function after the `else` arm closes into `merge`
 * @throws         propagated from `lower_ffi_error_arm`
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_error_else_arm(br: FfiBranch, out_ptr: u32, out_len: u32, err_index: u32, e: checker::TExpr) -> LFunc | error {
    let else_ctx = ctx_with(br.ctx1, br.ctx1.func, br.elseb, br.ctx1.env)
    let loaded = load_ptr_len_out_slots(else_ctx, out_ptr, out_len, e.line, e.col)
    let base = ctx_alloc(loaded.ctx)
    let alloca = ctx_append(base.ctx, alloca_inst(base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    let built = match lower_ffi_error_arm(alloca, base.vreg, err_index to i64, loaded.ptr, loaded.len, e) { LowerCtx as x => x; error as err => return err }
    close_arm_to(built, br.mergeb, teko::list::push(teko::list::empty(), base.vreg), e.line, e.col)
}

/**
 * lower_ffi_fat_or_error_call — the `T | error` shape where `T` is a FAT member (`str` for
 * env::var/env::cwd/io::read_file, `[]str` for fs::list_dir): call the twin, branch on its `bool`,
 * build the success wrapper from the loaded `(ptr, len)` fat payload (`lower_ffi_fat_ok_arm`) and
 * the failure wrapper from the SAME out-slots read as an error message (`lower_ffi_error_else_arm`),
 * merged through one block-arg (degrau 34). A `[]str`'s payload is the runtime's `(entries, count)`
 * pair stored unchanged — a slice's element layout IS an array of `tk_str`.
 *
 * @param ctx        the lowering context
 * @param e          the call expression (its type is `T | error`)
 * @param c          the call node (its fat arguments)
 * @param ok_symbol  the `tk_rt_*_ok` twin's C symbol
 * @param ok_member  the fat member's type (`checker::Str` or `checker::Slice`) — selects its index
 * @return           the advanced context + the wrapper's base-address VReg
 * @throws           when `e.type` is not the expected variant, or propagated from the arguments
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_fat_or_error_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, ok_symbol: str, ok_member: checker::Type) -> Lowered | error {
    let members = match ffi_result_variant_members(e) { []checker::Type as m => m; error as err => return err }
    let ok_index = match variant_member_index_of(members, ok_member, ctx.variants) { u32 as x => x; error as err => return err }
    let err_index = match variant_member_index_of(members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    let slots = match lower_ffi_twin_call(ctx, c, ok_symbol, e.line, e.col) { FfiOutSlots as x => x; error as err => return err }
    let br = lower_ffi_open_branch(slots.ok, e.line, e.col)
    let then_ctx = ctx_goto(br.ctx1, br.thenb)
    let then_loaded = load_ptr_len_out_slots(then_ctx, slots.out_ptr, slots.out_len, e.line, e.col)
    let then_base = ctx_alloc(then_loaded.ctx)
    let then_alloca = ctx_append(then_base.ctx, alloca_inst(then_base.vreg, variant_wrapper_bytes(), variant_wrapper_align(), e.line, e.col))
    let then_built = lower_ffi_fat_ok_arm(then_alloca, then_base.vreg, ok_index to i64, then_loaded.ptr, then_loaded.len, e.line, e.col)
    let then_func = close_arm_to(then_built, br.mergeb, teko::list::push(teko::list::empty(), then_base.vreg), e.line, e.col)
    let after_then = ctx_with(br.ctx1, then_func, br.ctx1.block_id, br.ctx1.env)
    let br_then = FfiBranch { ctx1 = after_then; thenb = br.thenb; elseb = br.elseb; mergeb = br.mergeb; merge_param = br.merge_param }
    let else_func = match lower_ffi_error_else_arm(br_then, slots.out_ptr, slots.out_len, err_index, e) { LFunc as x => x; error as err => return err }
    Lowered { ctx = ctx_with(after_then, else_func, br.mergeb, after_then.env); vreg = br.merge_param }
}

/**
 * lower_ffi_ures_call — the `error | null` shape (fs::mkdir/remove_file, env::chdir/set_var,
 * io::write_file/write_file_bytes): call the twin, branch on its `bool` (`true` = SUCCESS, no
 * error), build the SUCCESS arm as the union's own `null` absence wrapper (`lower_variant_absent`)
 * and the FAILURE arm as a boxed error read from the out-slots (`lower_ffi_error_else_arm`), merged
 * through one block-arg (degrau 34).
 *
 * @param ctx        the lowering context
 * @param e          the call expression (its type is `error | null`)
 * @param c          the call node (its fat arguments)
 * @param ok_symbol  the `tk_rt_*_ok` twin's C symbol
 * @return           the advanced context + the wrapper's base-address VReg
 * @throws           when `e.type` is not `error | null`, or propagated from the arguments
 * @since 0.3.1.0 degrau 34
 */
fn lower_ffi_ures_call(ctx: LowerCtx, e: checker::TExpr, c: checker::TCall, ok_symbol: str) -> Lowered | error {
    let v = match e.type { checker::Variant as x => x; _ => return error { message = "native backend N1: a host-FFI `error | null` call's result is not a variant (internal)" } }
    let null_index = match variant_null_member_index(v) { u32 as x => x; null => return error { message = "native backend N1: a host-FFI `error | null` call declares no `null` member (internal)" } }
    let err_index = match variant_member_index_of(v.members, checker::Error { }, ctx.variants) { u32 as x => x; error as err => return err }
    let slots = match lower_ffi_twin_call(ctx, c, ok_symbol, e.line, e.col) { FfiOutSlots as x => x; error as err => return err }
    let br = lower_ffi_open_branch(slots.ok, e.line, e.col)
    let then_ctx = ctx_goto(br.ctx1, br.thenb)
    let then_absent = lower_variant_absent(then_ctx, null_index to i64, e)
    let then_func = close_arm_to(then_absent.ctx, br.mergeb, teko::list::push(teko::list::empty(), then_absent.vreg), e.line, e.col)
    let after_then = ctx_with(br.ctx1, then_func, br.ctx1.block_id, br.ctx1.env)
    let br_then = FfiBranch { ctx1 = after_then; thenb = br.thenb; elseb = br.elseb; mergeb = br.mergeb; merge_param = br.merge_param }
    let else_func = match lower_ffi_error_else_arm(br_then, slots.out_ptr, slots.out_len, err_index, e) { LFunc as x => x; error as err => return err }
    Lowered { ctx = ctx_with(after_then, else_func, br.mergeb, after_then.env); vreg = br.merge_param }
}
