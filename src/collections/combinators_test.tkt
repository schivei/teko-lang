#test
fn arr_insert_at_i64() {
    var xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 1)
    xs = teko::list::push(xs, 2)
    xs = teko::list::push(xs, 3)
    var ins = arr_insert_at(xs, 1, 9)
    teko::assert::is_true(ins.len == 4)
    teko::assert::is_true(ins[0] == 1 && ins[1] == 9 && ins[2] == 2 && ins[3] == 3)
    var app = arr_insert_at(xs, 99, 7)
    teko::assert::is_true(app.len == 4 && app[3] == 7)
}

#test
fn arr_insert_at_str() {
    var xs: []str = teko::list::empty()
    xs = teko::list::push(xs, "a")
    xs = teko::list::push(xs, "c")
    var ins = arr_insert_at(xs, 1, "b")
    teko::assert::is_true(ins.len == 3)
    teko::assert::is_true(ins[0] == "a" && ins[1] == "b" && ins[2] == "c")
}

#test
fn arr_swap_reverse_slice() {
    var xs: []i64 = teko::list::empty()
    xs = teko::list::push(xs, 1)
    xs = teko::list::push(xs, 2)
    xs = teko::list::push(xs, 3)
    var sw = arr_swap(xs, 0, 2)
    teko::assert::is_true(sw[0] == 3 && sw[1] == 2 && sw[2] == 1)
    var sw_oob = arr_swap(xs, 0, 9)
    teko::assert::is_true(sw_oob.len == 3 && sw_oob[0] == 1)
    var rev = arr_reverse(xs)
    teko::assert::is_true(rev[0] == 3 && rev[1] == 2 && rev[2] == 1)
    var sl = arr_slice(xs, 1, 3)
    teko::assert::is_true(sl.len == 2 && sl[0] == 2 && sl[1] == 3)
    var empty = arr_slice(xs, 2, 1)
    teko::assert::is_true(empty.len == 0)
}
