/**
 * sdt_unwrap_str — collapse a `SortedDictionary<…, str>::get` optional to a plain `str`, substituting
 * `"?"` for the null (missing-key) case.
 *
 * @param got  the optional returned by a `<…, str>` lookup
 * @return     the value, or `"?"` when `got` is null
 */
fn sdt_unwrap_str(got: str | null): str { match got { str as v => v; null => "?" } }

#test
/**
 * sorteddict_i64key_str_orders — a `SortedDictionary<teko::cmp::I64Key, str>` keeps its keys ascending
 * across out-of-order inserts, updates a present key's value in place (no growth), and looks up by
 * binary search.
 */
fn sorteddict_i64key_str_orders() {
    var d = SortedDictionary<teko::cmp::I64Key, str>::make()
    d.insert(teko::cmp::I64Key { n = 3 }, "c")
    d.insert(teko::cmp::I64Key { n = 1 }, "a")
    d.insert(teko::cmp::I64Key { n = 2 }, "b")
    d.insert(teko::cmp::I64Key { n = 2 }, "B")
    var ks = d.keys()
    teko::assert::is_true(ks.len == 3)
    teko::assert::is_true(ks[0].n == 1 && ks[1].n == 2 && ks[2].n == 3)
    teko::assert::is_true(sdt_unwrap_str(d.get(teko::cmp::I64Key { n = 2 })) == "B")
    teko::assert::is_true(d.contains(teko::cmp::I64Key { n = 1 }))
    teko::assert::is_false(d.contains(teko::cmp::I64Key { n = 9 }))
}

#test
/**
 * sorteddict_strkey_i64_orders — the SECOND instantiation `SortedDictionary<teko::cmp::StrKey, i64>`,
 * ordering keys lexicographically across out-of-order inserts.
 */
fn sorteddict_strkey_i64_orders() {
    var e = SortedDictionary<teko::cmp::StrKey, i64>::make()
    e.insert(teko::cmp::StrKey { key = "b" }, 2)
    e.insert(teko::cmp::StrKey { key = "a" }, 1)
    e.insert(teko::cmp::StrKey { key = "c" }, 3)
    var ek = e.keys()
    teko::assert::is_true(ek.len == 3)
    teko::assert::is_true(ek[0].key == "a" && ek[1].key == "b" && ek[2].key == "c")
}
