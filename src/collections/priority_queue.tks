/**
 * teko::collections::PriorityQueue<T: IOrd> — a growable, reference-semantic MIN-priority queue: a
 * binary min-heap over `<` (dispatched through `T: IOrd`), so `enqueue` is O(log n) and `dequeue`
 * removes and returns the SMALLEST element in O(log n). The single owned `heap` array holds the heap
 * in the standard implicit layout (children of `i` at `2i+1`/`2i+2`); `enqueue` appends then sifts up
 * (`heap_sift_up`), `dequeue` pops the root and sifts down (`heap_pop_min`).
 *
 * @since 0.3.1
 * @see teko::cmp::IOrd, SortedSet
 */
pub type PriorityQueue<T: IOrd> = class {
    /** The binary min-heap array (implicit layout: children of `i` at `2i+1`/`2i+2`). */
    intern heap: []T

    /**
     * Build an empty `PriorityQueue<T>` — the generic static factory.
     *
     * @return a fresh, empty priority queue at the caller's concrete `T`
     */
    pub static fn make(): PriorityQueue<T> { .{ heap = teko::list::empty() } }

    /**
     * The number of elements currently queued.
     *
     * @return the element count
     */
    pub fn len(): u64 { self.heap.len }

    /**
     * Whether the queue holds no elements.
     *
     * @return `true` iff `len() == 0`
     */
    pub fn is_empty(): bool { self.heap.len == 0 }

    /**
     * Enqueue `x`, restoring the heap property upward; reference semantics. Duplicates are allowed
     * (a priority queue is a multiset, unlike `SortedSet`).
     *
     * @param x  the element to enqueue
     */
    pub fn enqueue(x: T) {
        var h = teko::list::push(self.heap, x)
        self.heap = heap_sift_up(h)
    }

    /**
     * The minimum element WITHOUT removing it; reference semantics. The queue MUST be non-empty — an
     * empty `peek` is a fail-loud bounds violation (M.1), so the caller guards with `is_empty()`.
     *
     * @return the current minimum element
     */
    pub fn peek(): T { self.heap[0] }

    /**
     * Remove and return the minimum element, restoring the heap property downward; reference
     * semantics. The queue MUST be non-empty — an empty `dequeue` is a fail-loud bounds violation
     * (M.1), so the caller guards with `is_empty()`. The result is a bare `T` rather than `T | null`
     * because a type parameter constrained by an interface (`T: IOrd`) may not yet stand as a union
     * member (the interface-in-union honest stop); the empty case is guarded, not unioned.
     *
     * @return the removed minimum element
     */
    pub fn dequeue(): T {
        var h = self.heap
        var m = heap_pop_min(&h)
        self.heap = h
        m
    }
}
