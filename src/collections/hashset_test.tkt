#test
/**
 * hashset_strkey_membership — a `HashSet<teko::cmp::StrKey>` add / idempotent-add / contains / remove
 * cycle: a duplicate `add` is a no-op returning `false`, and remove reports present/absent.
 */
fn hashset_strkey_membership() {
    var s = HashSet<teko::cmp::StrKey>::make()
    teko::assert::is_true(s.add(teko::cmp::StrKey { key = "x" }))
    teko::assert::is_true(s.add(teko::cmp::StrKey { key = "y" }))
    teko::assert::is_false(s.add(teko::cmp::StrKey { key = "x" }))
    teko::assert::is_true(s.len() == 2)
    teko::assert::is_true(s.contains(teko::cmp::StrKey { key = "x" }))
    teko::assert::is_false(s.contains(teko::cmp::StrKey { key = "q" }))
    teko::assert::is_true(s.remove(teko::cmp::StrKey { key = "x" }))
    teko::assert::is_false(s.contains(teko::cmp::StrKey { key = "x" }))
    teko::assert::is_true(s.len() == 1)
}

#test
/**
 * hashset_i64key_membership — the SECOND instantiation `HashSet<teko::cmp::I64Key>`, proving the set
 * monomorphizes per element type; a duplicate add is a no-op.
 */
fn hashset_i64key_membership() {
    var t = HashSet<teko::cmp::I64Key>::make()
    teko::assert::is_true(t.add(teko::cmp::I64Key { n = 7 }))
    teko::assert::is_false(t.add(teko::cmp::I64Key { n = 7 }))
    teko::assert::is_true(t.add(teko::cmp::I64Key { n = -1 }))
    teko::assert::is_true(t.contains(teko::cmp::I64Key { n = 7 }))
    teko::assert::is_true(t.contains(teko::cmp::I64Key { n = -1 }))
    teko::assert::is_true(t.len() == 2)
}
