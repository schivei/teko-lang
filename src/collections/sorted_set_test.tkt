#test
/**
 * sortedset_i64key_orders — a `SortedSet<teko::cmp::I64Key>` keeps its elements ascending across
 * out-of-order inserts, a duplicate `add` is a no-op returning `false`, and membership is by binary
 * search.
 */
fn sortedset_i64key_orders() {
    var s = SortedSet<teko::cmp::I64Key>::make()
    teko::assert::is_true(s.add(teko::cmp::I64Key { n = 5 }))
    teko::assert::is_true(s.add(teko::cmp::I64Key { n = 1 }))
    teko::assert::is_true(s.add(teko::cmp::I64Key { n = 3 }))
    teko::assert::is_false(s.add(teko::cmp::I64Key { n = 3 }))
    var arr = s.to_array()
    teko::assert::is_true(arr.len == 3)
    teko::assert::is_true(arr[0].n == 1 && arr[1].n == 3 && arr[2].n == 5)
    teko::assert::is_true(s.contains(teko::cmp::I64Key { n = 3 }))
    teko::assert::is_false(s.contains(teko::cmp::I64Key { n = 4 }))
}

#test
/**
 * sortedset_strkey_orders — the SECOND instantiation `SortedSet<teko::cmp::StrKey>`, ordering
 * lexicographically across out-of-order inserts.
 */
fn sortedset_strkey_orders() {
    var u = SortedSet<teko::cmp::StrKey>::make()
    var _a = u.add(teko::cmp::StrKey { key = "c" })
    var _b = u.add(teko::cmp::StrKey { key = "a" })
    var _c = u.add(teko::cmp::StrKey { key = "b" })
    var sa = u.to_array()
    teko::assert::is_true(sa.len == 3)
    teko::assert::is_true(sa[0].key == "a" && sa[1].key == "b" && sa[2].key == "c")
}
