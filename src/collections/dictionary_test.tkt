/**
 * dt_unwrap_i64 — collapse a `Dictionary<…, i64>::get` optional to a plain `i64`, substituting `-1`
 * for the null (missing-key) case, so a round-trip assertion reads without an inline match.
 *
 * @param got  the optional returned by a `<…, i64>` lookup
 * @return     the value, or `-1` when `got` is null
 */
fn dt_unwrap_i64(got: i64 | null): i64 { match got { i64 as v => v; null => -1 } }

/**
 * dt_unwrap_str — collapse a `Dictionary<…, str>::get` optional to a plain `str`, substituting `"?"`.
 *
 * @param got  the optional returned by a `<…, str>` lookup
 * @return     the value, or `"?"` when `got` is null
 */
fn dt_unwrap_str(got: str | null): str { match got { str as v => v; null => "?" } }

#test
/**
 * dictionary_strkey_i64_roundtrip — a `Dictionary<teko::cmp::StrKey, i64>` insert / update-not-grow /
 * get / contains / remove round-trip: a re-inserted key updates in place (no growth), an absent key
 * is not found, and remove reports present/absent.
 */
fn dictionary_strkey_i64_roundtrip() {
    var d = Dictionary<teko::cmp::StrKey, i64>::make()
    teko::assert::is_true(d.is_empty())
    d.insert(teko::cmp::StrKey { key = "a" }, 1)
    d.insert(teko::cmp::StrKey { key = "b" }, 2)
    d.insert(teko::cmp::StrKey { key = "a" }, 9)
    teko::assert::is_true(d.len() == 2)
    teko::assert::is_true(dt_unwrap_i64(d.get(teko::cmp::StrKey { key = "a" })) == 9)
    teko::assert::is_true(dt_unwrap_i64(d.get(teko::cmp::StrKey { key = "b" })) == 2)
    teko::assert::is_true(d.contains(teko::cmp::StrKey { key = "a" }))
    teko::assert::is_false(d.contains(teko::cmp::StrKey { key = "z" }))
    teko::assert::is_true(d.remove(teko::cmp::StrKey { key = "a" }))
    teko::assert::is_false(d.remove(teko::cmp::StrKey { key = "a" }))
    teko::assert::is_true(d.len() == 1)
}

#test
/**
 * dictionary_i64key_str_roundtrip — the SECOND instantiation `Dictionary<teko::cmp::I64Key, str>`
 * (a negative key exercising the sign-safe hash), proving the map monomorphizes per key/value type.
 */
fn dictionary_i64key_str_roundtrip() {
    var e = Dictionary<teko::cmp::I64Key, str>::make()
    e.insert(teko::cmp::I64Key { n = 5 }, "five")
    e.insert(teko::cmp::I64Key { n = -3 }, "neg")
    teko::assert::is_true(e.len() == 2)
    teko::assert::is_true(dt_unwrap_str(e.get(teko::cmp::I64Key { n = 5 })) == "five")
    teko::assert::is_true(dt_unwrap_str(e.get(teko::cmp::I64Key { n = -3 })) == "neg")
    teko::assert::is_false(e.contains(teko::cmp::I64Key { n = 0 }))
}
