#test
fn priorityqueue_i64key_dequeues_min_first() {
    var q = PriorityQueue<teko::cmp::I64Key>::make()
    q.enqueue(teko::cmp::I64Key { n = 5 })
    q.enqueue(teko::cmp::I64Key { n = 1 })
    q.enqueue(teko::cmp::I64Key { n = 3 })
    q.enqueue(teko::cmp::I64Key { n = 2 })
    q.enqueue(teko::cmp::I64Key { n = 4 })
    var order: []i64 = teko::list::empty()
    loop {
        if q.is_empty() { break }
        order = teko::list::push(order, q.dequeue().n)
    }
    teko::assert::is_true(order.len == 5)
    teko::assert::is_true(order[0] == 1 && order[1] == 2 && order[2] == 3 && order[3] == 4 && order[4] == 5)
}

#test
fn priorityqueue_strkey_peeks_min() {
    var r = PriorityQueue<teko::cmp::StrKey>::make()
    r.enqueue(teko::cmp::StrKey { key = "m" })
    r.enqueue(teko::cmp::StrKey { key = "a" })
    r.enqueue(teko::cmp::StrKey { key = "z" })
    teko::assert::is_true(r.peek().key == "a")
    teko::assert::is_true(r.len() == 3)
    teko::assert::is_true(r.dequeue().key == "a")
    teko::assert::is_true(r.len() == 2)
}
