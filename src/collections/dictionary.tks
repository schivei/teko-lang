/**
 * teko::collections::Dictionary<K: IEq & IHash, V> — a growable, reference-semantic hash map from an
 * ARBITRARY key type `K` (constrained to be equatable AND hashable) to `V` values — the generic
 * successor to the str-keyed `Map<V>`. The representation is the SAME three parallel owned arrays
 * (`keys`/`hashes`/`vals`) `Map<V>` proves, re-grown on each mutation: a single `[]Entry<K,V>` would
 * need a nested generic construct parameterized by the owner's type-params (still ill-resolved on the
 * generic stack), so parallel arrays of `K`/`u64`/`V` sidestep that and are a standard hash-map shape.
 *
 * `IHash.hash()` buckets a key (its cached `u64` compared before the full key for cheap collision
 * rejection); `IEq.__eq` disambiguates a hash tie. Both dispatch through the key's interface contract
 * (`hash` via the #254 method-over-`T` path, `==` via the 9-ops generic-operator path), monomorphized
 * per concrete `K` — the real dispatch the retired structural traits never had. `Map<V>` is NOT
 * removed (`teko::env` depends on it); `Dictionary` is the additive generalization.
 *
 * @since 0.3.1
 * @see teko::cmp::IHash, teko::cmp::IEq, Map
 */
pub type Dictionary<K: IEq & IHash, V> = class {
    /** The keys, in insertion order — parallel to `hashes` and `vals`. */
    intern keys: []K
    /** Each key's cached hash, compared before the full key for cheap collision rejection. */
    intern hashes: []u64
    /** The values, parallel to `keys` (the value for `keys[i]` is `vals[i]`). */
    intern vals: []V

    /**
     * Build an empty `Dictionary<K, V>` — the generic static factory.
     *
     * @return a fresh, empty `Dictionary<K, V>` at the caller's concrete key/value types
     */
    pub static fn make(): Dictionary<K, V> {
        .{ keys = teko::list::empty(); hashes = teko::list::empty(); vals = teko::list::empty() }
    }

    /**
     * The number of distinct keys currently held.
     *
     * @return the entry count
     */
    pub fn len(): u64 { self.keys.len }

    /**
     * Whether the dictionary holds no entries.
     *
     * @return `true` iff `len() == 0`
     */
    pub fn is_empty(): bool { self.keys.len == 0 }

    /**
     * Whether `k` is a key in the dictionary.
     *
     * @param k  the key to test
     * @return   `true` iff `k` is present
     */
    pub fn contains(k: K): bool {
        dict_find_index(self.keys, self.hashes, k.hash(), k) < self.keys.len
    }

    /**
     * Insert or update the value for `k`. A present key's value is overwritten in place (the entry
     * count is unchanged); otherwise a new entry is appended. Every alias observes the change
     * (reference semantics).
     *
     * @param k  the key to insert or update
     * @param v  the value to associate with `k`
     */
    pub fn insert(k: K, v: V) {
        var h = k.hash()
        var at = dict_find_index(self.keys, self.hashes, h, k)
        if at < self.keys.len {
            self.vals = arr_replace_at(self.vals, at, v)
            return
        }
        self.keys = teko::list::push(self.keys, k)
        self.hashes = teko::list::push(self.hashes, h)
        self.vals = teko::list::push(self.vals, v)
    }

    /**
     * The value associated with `k`, or `null` when `k` is absent — the null-propagating lookup
     * (`V?`, the disjoint-domain null path, never an `error` union).
     *
     * @param k  the key to look up
     * @return   the associated value, or `null` if `k` is not present
     */
    pub fn get(k: K): V | null {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return null }
        self.vals[at]
    }

    /**
     * Remove the entry for `k` if present, in place. Removing an absent key is a no-op. Returns
     * whether an entry was actually removed.
     *
     * @param k  the key to remove
     * @return   `true` iff an entry for `k` existed and was removed
     */
    pub fn remove(k: K): bool {
        var at = dict_find_index(self.keys, self.hashes, k.hash(), k)
        if at >= self.keys.len { return false }
        self.keys = arr_drop_at(self.keys, at)
        self.hashes = arr_drop_u64_at(self.hashes, at)
        self.vals = arr_drop_at(self.vals, at)
        true
    }

    /**
     * A fixed-size `[]K` snapshot of the dictionary's current keys, in insertion order — the door to
     * iterate its entries (loop over the keys, `get` each). The returned array is an independent
     * value; later mutations do not change it.
     *
     * @return the current keys as a `[]K` value snapshot
     */
    pub fn keys(): []K { self.keys }
}

/**
 * Find the index of key `k` (whose precomputed hash is `h`) in the parallel `keys`/`hashes` arrays,
 * or `keys.len` when absent — the generalization of `Map`'s `map_find_index` from `str` to any
 * `K: IEq & IHash`. The cheap `u64` hash is compared first, rejecting a non-matching key without an
 * `__eq` call; an equal hash falls through to `keys[i] == k` (the generic `==` dispatch over `K: IEq`),
 * keeping collisions correct. A FREE generic function (not a private method) per the sibling-link rule.
 *
 * @param keys    the key array
 * @param hashes  the parallel cached-hash array (`hashes[i]` is `hash()` of `keys[i]`)
 * @param h       the precomputed hash of the sought key
 * @param k       the sought key
 * @return        the index of `k` in `keys`, or `keys.len` if `k` is absent
 */
pub fn dict_find_index<K: IEq & IHash>(keys: []K, hashes: []u64, h: u64, k: K): u64 {
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        if hashes[i] == h && keys[i] == k { return i }
        i++
    }
    keys.len
}
