/**
 * This file tests teko::collections::Map<V>::to_dictionary (G6, on the F3 phantom-owner factory fix):
 * the additive bridge from the str-keyed `Map<V>` to the generic `Dictionary<teko::cmp::StrKey, V>`, at
 * TWO value instantiations (i64 + str, proving the bridge body monomorphizes per value width). Each test
 * populates a `Map`, bridges it with `to_dictionary()`, and reads every entry back through the generic
 * `Dictionary` — the same entries, plus the null path for an absent key — while the original `Map` still
 * answers its own `get` (the bridge is a snapshot, `Map` is NOT consumed). Pure Teko, runs natively.
 *
 * @param got       the optional value returned by `Dictionary<StrKey, i64>::get`
 * @param fallback  the value returned when `got` is null
 * @return          the wrapped value, or `fallback` if `got` is null
 */
fn unwrap_dict_i64(got: i64 | null, fallback: i64): i64 {
    match got {
        i64 as v => v
        null => fallback
    }
}

/**
 * Unwrap a `Dictionary<StrKey, str>::get` result (a `str?`) to a plain str, substituting `fallback` for
 * the null (missing-key) case — the str-instantiation twin of `unwrap_dict_i64`.
 *
 * @param got       the optional value returned by `Dictionary<StrKey, str>::get`
 * @param fallback  the value returned when `got` is null
 * @return          the wrapped value, or `fallback` if `got` is null
 */
fn unwrap_dict_str(got: str | null, fallback: str): str {
    match got {
        str as v => v
        null => fallback
    }
}

#test
/**
 * Map<i64> bridges to Dictionary<StrKey, i64>: every entry round-trips (including a key updated in
 * place), an absent key is null through the dictionary, and the original Map still answers its own get.
 */
fn map_to_dictionary_i64_preserves_entries() {
    var m = Map<i64>::make()
    m.insert("a", 10)
    m.insert("b", 20)
    m.insert("c", 12)
    m.insert("a", 40)
    var d = m.to_dictionary()
    teko::assert::is_true(unwrap_dict_i64(d.get(teko::cmp::StrKey { key = "a" }), -1) == 40)
    teko::assert::is_true(unwrap_dict_i64(d.get(teko::cmp::StrKey { key = "b" }), -1) == 20)
    teko::assert::is_true(unwrap_dict_i64(d.get(teko::cmp::StrKey { key = "c" }), -1) == 12)
    teko::assert::is_true(unwrap_dict_i64(d.get(teko::cmp::StrKey { key = "z" }), -1) == -1)
    teko::assert::is_true(m.len() == 3)
    teko::assert::is_true(unwrap_dict_i64(m.get("a"), -1) == 40)
}

#test
/**
 * Map<str> bridges to Dictionary<StrKey, str> — the second value instantiation, proving the bridge body
 * monomorphizes per value width and is not i64-specific.
 */
fn map_to_dictionary_str_preserves_entries() {
    var m = Map<str>::make()
    m.insert("x", "hi")
    m.insert("y", "yo")
    var d = m.to_dictionary()
    teko::assert::is_true(unwrap_dict_str(d.get(teko::cmp::StrKey { key = "x" }), "") == "hi")
    teko::assert::is_true(unwrap_dict_str(d.get(teko::cmp::StrKey { key = "y" }), "") == "yo")
    teko::assert::is_true(unwrap_dict_str(d.get(teko::cmp::StrKey { key = "n" }), "") == "")
}
