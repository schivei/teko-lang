/** teko::runtime::print — write `s` to stdout verbatim (no newline, no NUL). */
exp extern fn print(s: str) = "tk_print" from "teko_rt"

/** teko::runtime::println — `print(s)` followed by a newline. */
exp extern fn println(s: str) = "tk_println" from "teko_rt"

/** teko::runtime::write — write `s` to stdout verbatim (no newline, no NUL). */
exp extern fn write(s: str) = "tk_write" from "teko_rt"

/** teko::runtime::ewrite — write `s` to stderr verbatim (no newline, no NUL). */
exp extern fn ewrite(s: str) = "tk_ewrite" from "teko_rt"

/** teko::runtime::eprint — write `s` to stderr verbatim (no newline, no NUL). */
exp extern fn eprint(s: str) = "tk_eprint" from "teko_rt"

/** teko::runtime::eprintln — `eprint(s)` followed by a newline. */
exp extern fn eprintln(s: str) = "tk_eprintln" from "teko_rt"

exp fn float_parse(s: str): f64 {
    teko::float::parse(s)
}

exp fn str_concat(a: str, b: str): str {
    var xs: []byte = []
    var i: u64 = 0
    loop { if i >= a.len { break }; xs = [..xs, a[i]]; i++ }
    var j: u64 = 0
    loop { if j >= b.len { break }; xs = [..xs, b[j]]; j++ }
    str(xs)
}

/** teko::runtime::u64_to_str — `v`'s decimal digits ("0" when `v` is zero). */
exp fn u64_to_str(v: u64): str {
    if v == 0 { return "0" }
    var digits: []byte = []
    var n = v
    loop {
        if n == 0 { break }
        digits = [..digits, (b'0' to u64 + n % 10) to byte]
        n = n / 10
    }
    var xs: []byte = []
    var k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = [..xs, digits[k]] }
    str(xs)
}

exp fn i64_to_str(v: i64): str {
    if v >= 0 { return u64_to_str(v to u64) }
    var mag = ((-(v + 1)) to u64) + 1
    str_concat("-", u64_to_str(mag))
}

exp fn str_of_bytes(bytes: []byte): str {
    var xs: []byte = []
    var i: u64 = 0
    loop { if i >= bytes.len { break }; xs = [..xs, bytes[i]]; i++ }
    str(xs)
}

exp fn one_byte(c: byte): str {
    var xs: []byte = []
    xs = [..xs, c]
    str(xs)
}

exp fn concat(params pieces: []str): str {
    var acc = ""
    var i: u64 = 0
    loop { if i >= pieces.len { break }; acc = str_concat(acc, pieces[i]); i++ }
    acc
}

exp fn ftoa(x: f64): str {
    teko::fmt::f64_g17(x)
}

fn pad_left(body: str, width: i64, pad: byte): str {
    var have = body.len to i64
    if have >= width { return body }
    var xs: []byte = []
    var i = have
    loop { if i >= width { break }; xs = [..xs, pad]; i++ }
    str_concat(str(xs), body)
}

fn group_thousands(digits: str): str {
    var n = digits.len to i64
    var xs: []byte = []
    var i = 0
    loop {
        if i >= n { break }
        var remaining = n - i
        if i > 0 && remaining % 3 == 0 { xs = [..xs, b','] }
        xs = [..xs, digits[i to u64]]
        i++
    }
    str(xs)
}

fn to_radix(x: u64, radix: u64, alphabet: str): str {
    if x == 0 { return "0" }
    var digits: []byte = []
    var n = x
    loop {
        if n == 0 { break }
        digits = [..digits, alphabet[n % radix]]
        n = n / radix
    }
    var xs: []byte = []
    var k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = [..xs, digits[k]] }
    str(xs)
}

/** teko::runtime::fmt_d — `x` as decimal, zero-padded on the left to `width` (sign included). */
exp fn fmt_d(x: i64, width: i64): str {
    if x >= 0 { return pad_left(i64_to_str(x), width, b'0') }
    var mag = ((-(x + 1)) to u64) + 1
    var padded = pad_left(u64_to_str(mag), width - 1, b'0')
    str_concat("-", padded)
}

/** teko::runtime::fmt_x_upper — `x` as upper-case hexadecimal, no `0x` prefix, no padding. */
exp fn fmt_x_upper(x: u64): str { to_radix(x, 16, "0123456789ABCDEF") }

/** teko::runtime::fmt_x_lower — `x` as lower-case hexadecimal, no `0x` prefix, no padding. */
exp fn fmt_x_lower(x: u64): str { to_radix(x, 16, "0123456789abcdef") }

/** teko::runtime::fmt_b — `x` as binary, no `0b` prefix, no padding. */
exp fn fmt_b(x: u64): str { to_radix(x, 2, "0123456789ABCDEF") }

/** teko::runtime::fmt_n_i — `x` as decimal with a comma every three digits. */
exp fn fmt_n_i(x: i64): str {
    if x >= 0 { return group_thousands(u64_to_str(x to u64)) }
    var mag = ((-(x + 1)) to u64) + 1
    str_concat("-", group_thousands(u64_to_str(mag)))
}

/** teko::runtime::fmt_f — `x` rounded to `prec` fractional digits, fixed-point. */
exp fn fmt_f(x: f64, prec: i64): str { ftoa(x) }

/** teko::runtime::fmt_e — `x` in scientific notation with `prec` fractional mantissa digits. */
exp fn fmt_e(x: f64, prec: i64): str { ftoa(x) }

/** teko::runtime::fmt_g — `x` in the shorter of fixed/scientific with `prec` significant digits. */
exp fn fmt_g(x: f64, prec: i64): str { ftoa(x) }

/** teko::runtime::fmt_n_f — `x` as fixed-point with `prec` fractional digits and thousands
 * separators. */
exp fn fmt_n_f(x: f64, prec: i64): str { ftoa(x) }

/** teko::runtime::fmt_p — `x * 100` as fixed-point text with `prec` fractional digits, followed
 * by `%`. */
exp fn fmt_p(x: f64, prec: i64): str { ftoa(x) }

/** teko::runtime::fmt_dyn_f64 — dynamic-spec float formatting, dispatching on the spec's first
 * byte (case-insensitive: `f`/`e`/`g`/`n`/`p`); an empty/unknown spec falls back to `ftoa`. */
exp fn fmt_dyn_f64(x: f64, spec: str): str {
    if spec.len == 0 { return ftoa(x) }
    var prec = fmt_parse_prec(spec, 6)
    var fc = fmt_lead_lower(spec)
    if fc == b'f' { return fmt_f(x, prec) }
    if fc == b'e' { return fmt_e(x, prec) }
    if fc == b'g' { return fmt_g(x, prec) }
    if fc == b'n' { return fmt_n_f(x, prec) }
    if fc == b'p' { return fmt_p(x, prec) }
    ftoa(x)
}

/** teko::runtime::fmt_dyn_i64 — dynamic-spec signed-integer formatting (`d`/`x`/`X`/`b`/`n`); an
 * empty/unknown spec falls back to decimal. */
exp fn fmt_dyn_i64(x: i64, spec: str): str {
    if spec.len == 0 { return i64_to_str(x) }
    var prec = fmt_parse_prec(spec, 0)
    var fc = fmt_lead_lower(spec)
    if fc == b'd' { return fmt_d(x, if prec > 0 { prec } else { 1 }) }
    if fc == b'x' {
        if spec[0] == b'X' { return fmt_x_upper(x to u64) }
        return fmt_x_lower(x to u64)
    }
    if fc == b'b' { return fmt_b(x to u64) }
    if fc == b'n' { return fmt_n_i(x) }
    i64_to_str(x)
}

/** teko::runtime::fmt_dyn_u64 — dynamic-spec unsigned-integer formatting (`d`/`x`/`X`/`b`/`n`);
 * an empty/unknown spec falls back to decimal. */
exp fn fmt_dyn_u64(x: u64, spec: str): str {
    if spec.len == 0 { return u64_to_str(x) }
    var prec = fmt_parse_prec(spec, 0)
    var fc = fmt_lead_lower(spec)
    if fc == b'd' { return fmt_d(x to i64, if prec > 0 { prec } else { 1 }) }
    if fc == b'x' {
        if spec[0] == b'X' { return fmt_x_upper(x) }
        return fmt_x_lower(x)
    }
    if fc == b'b' { return fmt_b(x) }
    if fc == b'n' { return fmt_n_i(x to i64) }
    u64_to_str(x)
}

fn fmt_lead_lower(spec: str): byte {
    var c = spec[0]
    if c >= b'A' && c <= b'Z' { return (c to u64 + 32) to byte }
    c
}

fn fmt_parse_prec(spec: str, def: i64): i64 {
    var i = 0 to u64
    loop { if i >= spec.len { break }; var c = spec[i]; if c >= b'0' && c <= b'9' { break }; i++ }
    if i >= spec.len { return def }
    var p = 0
    loop {
        if i >= spec.len { break }
        var c = spec[i]
        if c < b'0' || c > b'9' { break }
        if p < 10000 { p = p * 10 + (c to i64 - 48) }
        if p > 10000 { p = 10000 }
        i++
    }
    p
}

exp fn str_eq(a: str, b: str): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop { if i >= a.len { break }; if a[i] != b[i] { return false }; i++ }
    true
}

/** teko::runtime::str_hash — the FNV-1a hash of `s`'s bytes. */
exp fn str_hash(s: str): u64 {
    var h: u64 = 14695981039346656037
    var i: u64 = 0
    loop { if i >= s.len { break }; h = (h ^ (s[i] to u64)) * 1099511628211; i++ }
    h
}

/** teko::runtime::str_compare — lexicographic byte compare: -1 (a < b), 0 (equal), 1 (a > b). */
exp fn str_compare(a: str, b: str): i64 {
    var n = if a.len < b.len { a.len } else { b.len }
    var i: u64 = 0
    loop {
        if i >= n { break }
        if (a[i] to u64) < (b[i] to u64) { return -1 }
        if (a[i] to u64) > (b[i] to u64) { return 1 }
        i++
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    0
}

exp fn str_slice(s: str, start: u64, end: u64): str {
    if start > end || end > s.len { panic("string slice out of range") }
    var xs: []byte = []
    var i = start
    loop { if i >= end { break }; xs = [..xs, s[i]]; i++ }
    str(xs)
}

exp fn str_slice_to(s: str, end: u64): str {
    str_slice(s, 0, end)
}

exp fn str_slice_from(s: str, start: u64): str {
    str_slice(s, start, s.len)
}

exp fn str_len(s: str): u64 {
    s.len
}

exp fn str_ends_with(s: str, suffix: str): bool {
    if suffix.len > s.len { return false }
    var start = s.len - suffix.len
    var i: u64 = 0
    loop { if i >= suffix.len { break }; if s[start + i] != suffix[i] { return false }; i++ }
    true
}

exp fn str_contains(s: str, needle: str): bool {
    if needle.len == 0 { return true }
    if needle.len > s.len { return false }
    var last = s.len - needle.len
    var i: u64 = 0
    loop {
        if i > last { break }
        var matched = true
        var j: u64 = 0
        loop { if j >= needle.len { break }; if s[i + j] != needle[j] { matched = false; break }; j++ }
        if matched { return true }
        i++
    }
    false
}

exp fn f64_g17(x: f64): str {
    teko::fmt::f64_g17(x)
}

exp extern fn rt_abort() = "abort" from "c"

/** teko::runtime::panic — write "teko: deliberate panic: <msg>" to stderr, then a stack trace,
 * then abort. Diverges. */
exp fn panic(msg: str) {
    ewrite(teko::str::concat("teko: deliberate panic: ", msg, "\n"))
    rt_abort()
}

/** teko::runtime::panic_div0 — the division-by-zero panic. Diverges. */
exp fn panic_div0() { panic("division by zero") }

/** teko::runtime::panic_oob — the index-out-of-bounds panic. Diverges. */
exp fn panic_oob() { panic("index out of bounds") }

/** teko::runtime::panic_cast — the impossible-narrowing-conversion panic. Diverges. */
exp fn panic_cast() { panic("impossible conversion") }

/** teko::runtime::panic_overflow — the integer-overflow panic. Diverges. */
exp fn panic_overflow() { panic("integer overflow") }

/** teko::runtime::panic_oob_at — the out-of-bounds panic, prefixed with `"line:col: "`.
 * Diverges. */
exp fn panic_oob_at(line: u32, col: u32) {
    ewrite(teko::str::concat(teko::u64_to_str(line to u64), ":", teko::u64_to_str(col to u64)))
    ewrite(": ")
    panic_oob()
}

exp fn div(a: i64, b: i64): i64 {
    if b == 0 { panic_div0() }
    a / b
}

exp fn mod(a: i64, b: i64): i64 {
    if b == 0 { panic_div0() }
    a % b
}

exp fn to_u8(v: i64): u8 {
    if v < 0 || v > 255 { panic_cast() }
    v to u8
}
