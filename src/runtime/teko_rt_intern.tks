
/**
 * Left-pad `body` with `pad` bytes until its total length reaches `width`.
 *
 * Used by the zero-padded integer format (`$"{n:D5}"`). A `body` already at or beyond
 * `width` is returned unchanged; the padding is prepended, so a signed value's `-` is NOT
 * kept in front of the zeros (matching C's `%0*d`, whose padding placement is handled by the
 * caller when a sign is present — see `fmt_d`).
 *
 * @param body   the already-rendered digit text
 * @param width  the minimum total width to pad `body` up to
 * @param pad    the single byte used for each padding position
 * @return       `body` left-padded with `pad` to at least `width` bytes
 */
fn pad_left(body: str, width: i64, pad: byte) -> str {
    let have = body.len to i64
    if have >= width { return body }
    mut xs: []byte = teko::list::empty()
    mut i = have
    loop { if i >= width { break }; xs = teko::list::push(xs, pad); i++ }
    str_concat(str(xs), body)
}

/**
 * Insert a comma between every group of three decimal digits of `digits`, right-aligned.
 *
 * `digits` is the plain (sign-free) decimal text; the caller re-attaches any sign. Grouping
 * starts from the least-significant digit, so "1234567" becomes "1,234,567". A digit run of
 * three or fewer is returned unchanged.
 *
 * @param digits  the sign-free decimal digit text to group
 * @return        `digits` with a comma inserted after each group of three, from the right
 */
fn group_thousands(digits: str) -> str {
    let n = digits.len to i64
    mut xs: []byte = teko::list::empty()
    mut i = 0
    loop {
        if i >= n { break }
        let remaining = n - i
        if i > 0 && remaining % 3 == 0 { xs = teko::list::push(xs, b',') }
        xs = teko::list::push(xs, digits[i to u64])
        i++
    }
    str(xs)
}

/**
 * Render the unsigned magnitude of `x` in base `radix` (2..=16) using `alphabet` for digits.
 *
 * The hex and binary format families lower to this: base 16 with an upper- or lower-case
 * digit alphabet, or base 2. Zero renders as a single "0". No sign is emitted (the families
 * that use this take an already-unsigned value).
 *
 * @param x         the unsigned magnitude to render
 * @param radix     the numeric base, 2 through 16
 * @param alphabet  the 16-byte digit table (index 0..radix-1 selects the digit byte)
 * @return          the base-`radix` text of `x`
 */
fn to_radix(x: u64, radix: u64, alphabet: str) -> str {
    if x == 0 { return "0" }
    mut digits: []byte = teko::list::empty()
    mut n = x
    loop {
        if n == 0 { break }
        digits = teko::list::push(digits, alphabet[n % radix])
        n = n / radix
    }
    mut xs: []byte = teko::list::empty()
    mut k = digits.len
    loop { if k == 0 { break }; k = k - 1; xs = teko::list::push(xs, digits[k]) }
    str(xs)
}

/**
 * Lower-case the leading byte of a dynamic format spec (ASCII A–Z → a–z), for the
 * case-insensitive family dispatch in the `fmt_dyn_*` helpers.
 *
 * @param spec  the runtime spec string (assumed non-empty by the callers)
 * @return      the spec's first byte, lower-cased if it was an upper-case ASCII letter
 */
fn fmt_lead_lower(spec: str) -> byte {
    let c = spec[0]
    if c >= b'A' && c <= b'Z' { return (c to u64 + 32) to byte }
    c
}

/**
 * Parse the optional trailing decimal precision out of a dynamic format spec (e.g. "F2" → 2).
 *
 * Skips the leading non-digit family byte(s), then reads the digit run. A spec with no digits
 * yields `def`. The accumulator is clamped at 10000 (matching the C twin's FMT_PREC_MAX) so a
 * pathologically long digit run cannot overflow.
 *
 * @param spec  the runtime spec string
 * @param def   the precision to use when the spec carries no digits
 * @return      the parsed precision, or `def` when absent
 */
fn fmt_parse_prec(spec: str, def: i64) -> i64 {
    mut i = 0 to u64
    loop { if i >= spec.len { break }; let c = spec[i]; if c >= b'0' && c <= b'9' { break }; i++ }
    if i >= spec.len { return def }
    mut p = 0
    loop {
        if i >= spec.len { break }
        let c = spec[i]
        if c < b'0' || c > b'9' { break }
        if p < 10000 { p = p * 10 + (c to i64 - 48) }
        if p > 10000 { p = 10000 }
        i++
    }
    p
}
