/**
 * tk_arena_control_get — read this flow-of-control's arena CONTROL-block address (0 until first
 * init). The ONE mutable process word P2 requires (`docs/design/plano-s16-arena-mmap.md` §1.3),
 * kept in the maintained-C F1 seam (`teko_rt.c`) so the Teko arena core needs NO module-mutable
 * language surface. Allocation-free.
 *
 * @return  the CONTROL address, or 0 when the arena has not been initialized on this task yet
 */
extern fn tk_arena_control_get(): u64 = "tk_arena_control_get" from "teko_rt"

/**
 * tk_arena_control_set — install this flow-of-control's arena CONTROL-block address, once, lazily,
 * on the first-touch path. The write half of the P2 seam. Allocation-free.
 *
 * @param addr  the mmap'd CONTROL-block address to record
 * @return      nothing
 */
extern fn tk_arena_control_set(addr: u64) = "tk_arena_control_set" from "teko_rt"

/**
 * tk_arena_paranoid — the cached `TEKO_MEM_PARANOID` probe, read through the maintained-C seam so
 * the arena core needs no computed `str` on its own path (§1.2 forbids one). Probed once, lazily.
 *
 * @return  1 when `TEKO_MEM_PARANOID` is set to a non-empty value, else 0
 */
extern fn tk_arena_paranoid(): u64 = "tk_arena_paranoid" from "teko_rt"

/** The arena's payload alignment: the C twin's `TK_ARENA_ALIGN`, 16 on every supported target. */
const ARENA_ALIGN: u64 = 16

/** The default chunk payload the arena requests: the C twin's `TK_REGION_DEFAULT_CHUNK`. */
const DEFAULT_CHUNK: u64 = 65536

/** The width of the machine word every arena field occupies. */
const WORD: u64 = 8

/** Chunk field: the next chunk in the region's LIFO list, 0 at the end. */
const CHUNK_NEXT: u64 = 0

/** Chunk field: the payload's usable byte count. */
const CHUNK_CAP: u64 = 8

/** Chunk field: the bump cursor, i.e. how many payload bytes are already handed out. */
const CHUNK_USED: u64 = 16

/**
 * The chunk header's size, and therefore the payload's offset from the chunk base. The C twin's
 * `offsetof(struct tk_chunk, data)` is 32, and 32 is a multiple of `ARENA_ALIGN`, so a page-aligned
 * mmap base yields a payload base on the arena's alignment.
 */
const CHUNK_HEADER: u64 = 32

/** Region field: the current chunk, 0 while the region has never allocated (lazy head). */
const REGION_HEAD: u64 = 0

/** Region field: the INTRUSIVE link into the global live-region registry (distinct from the tree). */
const REGION_REG_NEXT: u64 = 8

/** Region field: the arena TREE edge; 0 for the root or a deliberately parentless region. */
const REGION_PARENT: u64 = 16

/** Region field: the per-region type-to-instance entry array, 0 until the first registration. */
const REGION_ENTRIES: u64 = 24

/** Region field: how many entries of that array are in use. */
const REGION_NENTRIES: u64 = 32

/** Region field: how many entries that array can hold. */
const REGION_ENTRIES_CAP: u64 = 40

/** Region field: the unique generation stamp, never reused, so a recycled address reads as fresh. */
const REGION_GEN: u64 = 48

/** A region header's total size: seven words rounded up to the arena's alignment. */
const REGION_BYTES: u64 = 64

/** Entry field: the registered type's identifier. */
const ENTRY_TYPE_ID: u64 = 0

/** Entry field: the registered instance's address. */
const ENTRY_INSTANCE: u64 = 8

/** One entry's size: a type identifier and an instance address. */
const ENTRY_BYTES: u64 = 16

/** The entry array's first capacity, the C twin's `entries_cap == 0 ? 4` step. */
const ENTRIES_FIRST_CAP: u64 = 4

/** Control field: the sentinel proving the block was initialized. */
const CTRL_MAGIC: u64 = 0

/** Control field: the head of the global live-region registry (the C twin's `tk_g_regs`). */
const CTRL_REGS: u64 = 8

/** Control field: the process root region (the C twin's `tk_g_root`), 0 until first demanded. */
const CTRL_ROOT: u64 = 16

/** Control field: the monotonic region-generation counter (the C twin's `tk_g_region_gen`). */
const CTRL_GEN: u64 = 24

/** Control field: the mark stack's depth (the C twin's `tk_arena_msp`). */
const CTRL_MSP: u64 = 32

/** Control field: the free list of blocks too large to bin (the C twin's `tk_free_large`). */
const CTRL_FREE_LARGE: u64 = 40

/** Control field: the head META-POOL slab, threaded through each slab's link word for teardown. */
const CTRL_META_SLAB: u64 = 48

/** Control field: the META-POOL bump cursor — the next free address in the current slab. */
const CTRL_META_CURSOR: u64 = 56

/** Control field: the exclusive end address of the current META-POOL slab. */
const CTRL_META_END: u64 = 64

/**
 * Control field: the head of the region-header free-list — the META-POOL keystone. A freed 64 B
 * header is threaded onto this single-linked list through its own first word so a later
 * `region_new` reuses the SAME cell, mirroring `malloc/free` so the flip does not grow steady-state
 * metadata (§3).
 */
const CTRL_HDR_FREE: u64 = 72

/** Control field: the process PROGRAM region singleton (the C twin's `tk_region_program`). */
const CTRL_PROGRAM: u64 = 80

/** Control field: the base of the mark stack (the C twin's `tk_arena_marks`). */
const CTRL_MARKS: u64 = 128

/** Mark field: the chunk the checkpoint was taken in. */
const MARK_CHUNK: u64 = 0

/** Mark field: that chunk's bump cursor at checkpoint time. */
const MARK_USED: u64 = 8

/** One mark's size: a chunk address and a bump cursor. */
const MARK_BYTES: u64 = 16

/** How many checkpoints the mark stack holds; a deeper push saves nothing, as in the C twin. */
const MARK_SLOTS: u64 = 64

/** Control field: the base of the size-class free bins (the C twin's `tk_free_bins`). */
const CTRL_FREE_BINS: u64 = 1152

/** How many size classes the free bins hold; class `i` is exactly `(i + 1) * ARENA_ALIGN` bytes. */
const FREE_BINS: u64 = 4096

/** The control block's total size: the scalars, the mark stack, and the free bins. */
const CTRL_BYTES: u64 = 33920

/** The sentinel `ar_control` writes so an uninitialized mapping is never mistaken for a live one. */
const CTRL_MAGIC_VALUE: u64 = 2596069104

/** Freenode field: the next parked block of the same class. */
const FREENODE_NEXT: u64 = 0

/** Freenode field: the parked block's usable byte count. */
const FREENODE_BYTES: u64 = 8

/** The smallest block that can be parked: one that has room for a freenode's two fields. */
const FREENODE_BYTES_MIN: u64 = 16

/** The largest block a size class can hold; anything bigger goes on the large list. */
const FREE_BIN_MAX_BYTES: u64 = 65536

/** How far the large list is scanned before giving up, so a long list never goes quadratic. */
const FREE_LARGE_SCAN: u64 = 32

/** The META-POOL slab size: 64 KB (16 pages), bump-allocated for fixed-size metadata (§3). */
const AR_META_SLAB: u64 = 65536

/** A META-POOL slab's link word offset: threads the slab list for teardown; the cells start after. */
const AR_SLAB_LINK: u64 = 0

/** A META-POOL slab's reserved header, before the first bump cell; holds the slab-list link word. */
const AR_SLAB_HEADER: u64 = 16

/** The exit code the raw OOM path issues via `exit_group`, when even mmap of the exact size fails. */
const AR_OOM_CODE: i64 = 137

/** The word `TEKO_MEM_PARANOID` poison writes over a freed block: eight `0xDD` bytes. */
const AR_POISON_WORD: u64 = 15987178197214944733

/**
 * Rounds a size up to the arena's payload alignment — the `(n + 15) & ~15` the C twin applies to
 * every request and bump offset, in arithmetic so it needs no cast.
 *
 * @param n  the size or offset to round
 * @return   the smallest multiple of `ARENA_ALIGN` that is at least `n`
 */
fn ar_align_up(n: u64): u64 {
    var slack = n % ARENA_ALIGN
    if slack == 0 { return n }
    n + ARENA_ALIGN - slack
}

/**
 * Rounds a size DOWN to the arena's payload alignment — the floor the C twin applies when PARKING a
 * freed block, never a ceil: the caller's byte count is a true lower bound of the block's extent.
 *
 * @param n  the size to round
 * @return   the largest multiple of `ARENA_ALIGN` that is at most `n`
 */
fn ar_align_down(n: u64): u64 {
    n - n % ARENA_ALIGN
}

/**
 * Reads one machine word at a computed address — the whole raw READ surface, one non-allocating
 * `LLoad` (P1, `teko::mem::load_u64`). An allocator whose own reads allocate does not terminate.
 *
 * @param address  where to read
 * @return         the word at `address`
 */
fn ar_load(address: u64): u64 {
    teko::mem::load_u64(address)
}

/**
 * Writes one machine word at a computed address — the whole raw WRITE surface, one non-allocating
 * `LStore` (P1, `teko::mem::store_u64`).
 *
 * @param address  where to write
 * @param value    the word to write
 * @return         nothing
 */
fn ar_store(address: u64, value: u64) {
    teko::mem::store_u64(address, value)
}

/**
 * Maps `length` bytes of anonymous private read/write memory through the raw `mmap` syscall — the
 * arena's ONLY memory source, replacing `posix_memalign`/`malloc` wholesale. The kernel returns a
 * page-aligned address (so at least 16-aligned, subsuming `TK_ARENA_ALIGN`) or a value in the
 * `[-4095, -1]` `-errno` error band.
 *
 * @param length  the mapping size in bytes; the kernel rounds it up to whole pages
 * @return        the page-aligned base address, or 0 when the kernel refuses
 */
fn ar_mmap(length: u64): u64 {
    var result = teko::sys::syscall6(teko::sys::SYS_MMAP, 0, length to i64,
        teko::sys::PROT_READ | teko::sys::PROT_WRITE,
        teko::sys::MAP_PRIVATE | teko::sys::MAP_ANONYMOUS, -1, 0)
    if result >= -4095 && result <= -1 { return 0 }
    result to u64
}

/**
 * Releases a mapping obtained from `ar_mmap` through the raw `munmap` syscall. The kernel rounds the
 * length up to whole pages, so passing the unrounded request length unmaps exactly the pages the
 * matching `ar_mmap` obtained.
 *
 * @param address  the mapping's base address (page-aligned, as `mmap` returned)
 * @param length   the mapping's request length
 * @return         nothing
 */
fn ar_munmap(address: u64, length: u64) {
    _ = teko::sys::syscall2(teko::sys::SYS_MUNMAP, address to i64, length to i64)
}

/**
 * Fails an unsatisfiable allocation the RAW way (§1.2): `exit_group` with a static code, never
 * `panic(msg)` — a computed panic string would re-enter the arena it is failing inside.
 *
 * @return  nothing (the process terminates)
 */
fn ar_oom() {
    _ = teko::sys::syscall1(teko::sys::SYS_EXIT_GROUP, AR_OOM_CODE)
}

/**
 * Reads a CONTROL-block field.
 *
 * @param control  the control block's base address
 * @param field    the field's offset within the block
 * @return         the field's current value
 */
fn ar_ctrl_get(control: u64, field: u64): u64 {
    ar_load(control + field)
}

/**
 * Writes a CONTROL-block field.
 *
 * @param control  the control block's base address
 * @param field    the field's offset within the block
 * @param value    the value to store
 * @return         nothing
 */
fn ar_ctrl_set(control: u64, field: u64, value: u64) {
    ar_store(control + field, value)
}

/**
 * Maps a fresh META-POOL slab and returns its base, its link word cleared to 0 (end-of-list). A
 * mapping failure is fatal — the arena cannot make progress without metadata storage.
 *
 * @param slab_bytes  the slab mapping size (`AR_META_SLAB`, or larger for an oversized cell)
 * @return            the slab's base address, never 0
 */
fn ar_meta_slab_new(slab_bytes: u64): u64 {
    var slab = ar_mmap(slab_bytes)
    if slab == 0 { ar_oom() }
    ar_store(slab + AR_SLAB_LINK, 0)
    slab
}

/**
 * Bump-allocates a fixed-size metadata cell of `bytes` from the META-POOL, growing by another slab
 * when the current one is exhausted. A cell larger than a slab's bump capacity gets its own
 * exactly-sized slab. This is the mmap-specific keystone (§3): the kernel's minimum mapping is one
 * page, so one mmap per 64 B header would be a 64x footprint blow-up — the META-POOL sub-allocates
 * them instead, keeping the metadata footprint at the malloc baseline.
 *
 * @param control  the control block's base address
 * @param bytes    the cell size in bytes; rounded up to the arena's alignment
 * @return         the cell's base address
 */
fn ar_meta_alloc(control: u64, bytes: u64): u64 {
    var size = ar_align_up(bytes)
    var cursor = ar_ctrl_get(control, CTRL_META_CURSOR)
    var end = ar_ctrl_get(control, CTRL_META_END)
    if cursor + size > end {
        var need = AR_SLAB_HEADER + size
        var slab_bytes = if need > AR_META_SLAB { ar_align_up(need) } else { AR_META_SLAB }
        var slab = ar_meta_slab_new(slab_bytes)
        ar_store(slab + AR_SLAB_LINK, ar_ctrl_get(control, CTRL_META_SLAB))
        ar_ctrl_set(control, CTRL_META_SLAB, slab)
        cursor = slab + AR_SLAB_HEADER
        ar_ctrl_set(control, CTRL_META_END, slab + slab_bytes)
    }
    ar_ctrl_set(control, CTRL_META_CURSOR, cursor + size)
    cursor
}

/**
 * Obtains a 64 B region header — from the header free-list when it is non-empty, else a fresh
 * META-POOL cell. Reusing a freed header is the reuse `region_drop` feeds, and the property the
 * fixture's META-POOL assert demands: a drop-then-new region lands on the SAME header address.
 *
 * @param control  the control block's base address
 * @return         a region header's base address
 */
fn ar_header_alloc(control: u64): u64 {
    var recycled = ar_ctrl_get(control, CTRL_HDR_FREE)
    if recycled != 0 {
        ar_ctrl_set(control, CTRL_HDR_FREE, ar_load(recycled))
        return recycled
    }
    ar_meta_alloc(control, REGION_BYTES)
}

/**
 * Returns a region header to the free-list, threading it through the header's own first word so the
 * next `region_new` reuses this exact cell — the malloc/free footprint mirror (§3). Disabling this
 * push (leaking the header) is what the fixture's non-vacuous META-POOL assert catches.
 *
 * @param control  the control block's base address
 * @param region   the header to reclaim
 * @return         nothing
 */
fn ar_header_free(control: u64, region: u64) {
    ar_store(region, ar_ctrl_get(control, CTRL_HDR_FREE))
    ar_ctrl_set(control, CTRL_HDR_FREE, region)
}

/**
 * Reaches this task's CONTROL block, mapping the META-POOL and carving the CONTROL block from the
 * front of its first slab on first touch. The one mutable process word (the CONTROL address) lives
 * in the maintained-C P2 seam; every other root lives inside the mapped block, read and written as
 * words — which is what breaks the bootstrap circularity (§1). The mapping is zero-filled by the
 * kernel, so every root field starts at its correct zero; only the sentinel and the META-POOL
 * cursor need writing.
 *
 * @return  the CONTROL block's base address
 */
fn ar_control(): u64 {
    var existing = tk_arena_control_get()
    if existing != 0 { return existing }
    var slab = ar_meta_slab_new(AR_META_SLAB)
    var control = slab + AR_SLAB_HEADER
    ar_ctrl_set(control, CTRL_MAGIC, CTRL_MAGIC_VALUE)
    ar_ctrl_set(control, CTRL_META_SLAB, slab)
    ar_ctrl_set(control, CTRL_META_CURSOR, ar_align_up(control + CTRL_BYTES))
    ar_ctrl_set(control, CTRL_META_END, slab + AR_META_SLAB)
    tk_arena_control_set(control)
    control
}

/**
 * Reads a chunk field.
 *
 * @param chunk  the chunk's base address
 * @param field  the field's offset within the header
 * @return       the field's current value
 */
fn ar_chunk_get(chunk: u64, field: u64): u64 {
    ar_load(chunk + field)
}

/**
 * Writes a chunk field.
 *
 * @param chunk  the chunk's base address
 * @param field  the field's offset within the header
 * @param value  the value to store
 * @return       nothing
 */
fn ar_chunk_set(chunk: u64, field: u64, value: u64) {
    ar_store(chunk + field, value)
}

/**
 * The address of a chunk's payload — where its first allocation lands, on the arena's alignment
 * because `CHUNK_HEADER` is a multiple of it and the mmap base is page-aligned.
 *
 * @param chunk  the chunk's base address
 * @return       the payload's base address
 */
fn ar_chunk_payload(chunk: u64): u64 {
    chunk + CHUNK_HEADER
}

/**
 * Maps one chunk with `payload` usable bytes from its OWN mmap (§3: chunk payloads are exclusive
 * mappings, munmap'd on drop), WITHOUT failing loudly — the try shape `ar_region_grow`'s retry
 * needs. A fresh chunk starts unlinked and empty.
 *
 * @param payload  how many payload bytes the chunk must offer
 * @return         the chunk's base address, or 0 when the kernel refuses
 */
fn ar_chunk_try(payload: u64): u64 {
    var chunk = ar_mmap(CHUNK_HEADER + payload)
    if chunk == 0 { return 0 }
    ar_chunk_set(chunk, CHUNK_NEXT, 0)
    ar_chunk_set(chunk, CHUNK_CAP, payload)
    ar_chunk_set(chunk, CHUNK_USED, 0)
    chunk
}

/**
 * Unmaps one chunk. Its mapping was `CHUNK_HEADER + cap` bytes, so that is the length handed to
 * `munmap`; the kernel rounds it up to the same whole pages `ar_chunk_try` mapped.
 *
 * @param chunk  the chunk's base address
 * @return       nothing
 */
fn ar_chunk_free(chunk: u64) {
    ar_munmap(chunk, CHUNK_HEADER + ar_chunk_get(chunk, CHUNK_CAP))
}

/**
 * Unmaps a whole chunk list, from `head` to its end, reading each `next` BEFORE unmapping the node
 * that holds it — the shape every drop, rewind and free-all path walks.
 *
 * @param head  the first chunk to release; 0 releases nothing
 * @return      nothing
 */
fn ar_chunk_free_list(head: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        var next = ar_chunk_get(chunk, CHUNK_NEXT)
        ar_chunk_free(chunk)
        chunk = next
    }
}

/**
 * Unmaps every chunk of a list up to, but NOT including, a stop chunk — the rewind's shape. The stop
 * chunk is always in the chain because chunks only ever prepend.
 *
 * @param head  the first chunk to release
 * @param stop  the chunk to stop before; 0 releases the whole list
 * @return      nothing
 */
fn ar_chunk_free_until(head: u64, stop: u64) {
    var chunk = head
    loop {
        if chunk == 0 { break }
        if chunk == stop { break }
        var next = ar_chunk_get(chunk, CHUNK_NEXT)
        ar_chunk_free(chunk)
        chunk = next
    }
}

/**
 * The bump offset a request of `size` bytes would occupy in a chunk, or the chunk's capacity plus
 * one when it does not fit — the fit test and the offset in one computation, so they can never
 * disagree by one.
 *
 * @param chunk  the chunk to measure
 * @param size   the already-aligned request size
 * @return       the aligned bump offset, or a value greater than the capacity when it will not fit
 */
fn ar_chunk_fit_offset(chunk: u64, size: u64): u64 {
    var cap = ar_chunk_get(chunk, CHUNK_CAP)
    var base_off = ar_align_up(ar_chunk_get(chunk, CHUNK_USED))
    if base_off > cap { return cap + 1 }
    if size > cap - base_off { return cap + 1 }
    base_off
}

/**
 * Tests whether a bump offset returned by `ar_chunk_fit_offset` describes a real fit.
 *
 * @param chunk   the chunk the offset came from
 * @param offset  the offset `ar_chunk_fit_offset` returned
 * @return        true when the request fits at that offset
 */
fn ar_chunk_offset_fits(chunk: u64, offset: u64): bool {
    offset <= ar_chunk_get(chunk, CHUNK_CAP)
}

/**
 * Reads a region field.
 *
 * @param region  the region's base address
 * @param field   the field's offset within the header
 * @return        the field's current value
 */
fn ar_region_get(region: u64, field: u64): u64 {
    ar_load(region + field)
}

/**
 * Writes a region field.
 *
 * @param region  the region's base address
 * @param field   the field's offset within the header
 * @param value   the value to store
 * @return        nothing
 */
fn ar_region_set(region: u64, field: u64, value: u64) {
    ar_store(region + field, value)
}

/**
 * Opens a fresh empty region as a child of `parent`, prepends it onto the live-region registry, and
 * stamps it with a never-reused generation. The header comes from the META-POOL (a reused cell when
 * one is free); the head chunk is NOT mapped here — a region that never allocates never pays for a
 * chunk, the C twin's lazy head.
 *
 * @param control  the control block's base address
 * @param parent   the region's tree parent; 0 for the root or a deliberately parentless region
 * @return         the new region's base address
 */
fn ar_region_new_w(control: u64, parent: u64): u64 {
    var region = ar_header_alloc(control)
    ar_region_set(region, REGION_HEAD, 0)
    ar_region_set(region, REGION_REG_NEXT, ar_ctrl_get(control, CTRL_REGS))
    ar_ctrl_set(control, CTRL_REGS, region)
    ar_region_set(region, REGION_PARENT, parent)
    ar_region_set(region, REGION_ENTRIES, 0)
    ar_region_set(region, REGION_NENTRIES, 0)
    ar_region_set(region, REGION_ENTRIES_CAP, 0)
    var generation = ar_ctrl_get(control, CTRL_GEN) + 1
    ar_ctrl_set(control, CTRL_GEN, generation)
    ar_region_set(region, REGION_GEN, generation)
    region
}

/**
 * The process root region, opened on first demand — the C twin's lazy `tk_g_root`. The root has no
 * parent and rides the live-region registry like every other region.
 *
 * @param control  the control block's base address
 * @return         the root region's base address
 */
fn ar_region_root_w(control: u64): u64 {
    var existing = ar_ctrl_get(control, CTRL_ROOT)
    if existing != 0 { return existing }
    var root = ar_region_new_w(control, 0)
    ar_ctrl_set(control, CTRL_ROOT, root)
    root
}

/**
 * The process PROGRAM region, opened on first demand — the C twin's `tk_region_program`, a
 * parentless singleton that outlives any one task's rewind. Held in the CONTROL block.
 *
 * @param control  the control block's base address
 * @return         the program region's base address
 */
fn ar_region_program_w(control: u64): u64 {
    var existing = ar_ctrl_get(control, CTRL_PROGRAM)
    if existing != 0 { return existing }
    var program = ar_region_new_w(control, 0)
    ar_ctrl_set(control, CTRL_PROGRAM, program)
    program
}

/**
 * Hands out `size` already-aligned bytes from the region's current chunk, advancing the bump.
 *
 * @param region  the region to allocate from; its head chunk must fit the request
 * @param offset  the bump offset `ar_chunk_fit_offset` computed
 * @param size    the already-aligned request size
 * @return        the allocated block's base address
 */
fn ar_region_bump(region: u64, offset: u64, size: u64): u64 {
    var chunk = ar_region_get(region, REGION_HEAD)
    ar_chunk_set(chunk, CHUNK_USED, offset + size)
    ar_chunk_payload(chunk) + offset
}

/**
 * Prepends a fresh chunk big enough for `size` and hands the request its whole base. An ordinary
 * request gets a default chunk so later small allocations share it; a request larger than the
 * default gets a chunk sized exactly to it, with a retry at the exact size when the default-sized
 * attempt fails — which keeps this arena's out-of-memory edge where a plain allocator's was. Exits
 * the RAW way when both fail.
 *
 * @param control  the control block's base address
 * @param region   the region to extend
 * @param size     the already-aligned request size
 * @return         the allocated block's base address
 */
fn ar_region_grow(control: u64, region: u64, size: u64): u64 {
    var want = if size > DEFAULT_CHUNK { size } else { DEFAULT_CHUNK }
    var chunk = ar_chunk_try(want)
    if chunk == 0 {
        if want != size { chunk = ar_chunk_try(size) }
    }
    if chunk == 0 { ar_oom() }
    ar_chunk_set(chunk, CHUNK_USED, size)
    ar_chunk_set(chunk, CHUNK_NEXT, ar_region_get(region, REGION_HEAD))
    ar_region_set(region, REGION_HEAD, chunk)
    ar_chunk_payload(chunk)
}

/**
 * Allocates `n` bytes in `region` — the arena's central operation. A zero-size request becomes one
 * byte so it still yields a DISTINCT pointer; the request is rounded up to the alignment; an
 * explicitly freed block of the right class is reused before the bump advances (root only, since
 * parked blocks live in root chunks); otherwise the current chunk bumps, or a new chunk is prepended.
 *
 * @param control  the control block's base address
 * @param region   the region to allocate in
 * @param n        the requested size in bytes
 * @return         the allocated block's base address, never 0
 */
fn ar_region_alloc_w(control: u64, region: u64, n: u64): u64 {
    var size = ar_align_up(if n == 0 { 1 } else { n })
    if region == ar_ctrl_get(control, CTRL_ROOT) {
        var reused = ar_free_take(control, size)
        if reused != 0 { return reused }
    }
    var head = ar_region_get(region, REGION_HEAD)
    if head != 0 {
        var offset = ar_chunk_fit_offset(head, size)
        if ar_chunk_offset_fits(head, offset) { return ar_region_bump(region, offset, size) }
    }
    ar_region_grow(control, region, size)
}

/**
 * Unlinks a region from the live-region registry — done FIRST on every drop path, so a later sweep
 * can never see, and double-free, a region an earlier drop already owns.
 *
 * @param control  the control block's base address
 * @param region   the region to unlink
 * @return         nothing
 */
fn ar_registry_unlink(control: u64, region: u64) {
    var head = ar_ctrl_get(control, CTRL_REGS)
    if head == region {
        ar_ctrl_set(control, CTRL_REGS, ar_region_get(region, REGION_REG_NEXT))
        return
    }
    var prev = head
    loop {
        if prev == 0 { break }
        var next = ar_region_get(prev, REGION_REG_NEXT)
        if next == region {
            ar_region_set(prev, REGION_REG_NEXT, ar_region_get(region, REGION_REG_NEXT))
            break
        }
        prev = next
    }
}

/**
 * Releases a region's chunks and returns its header to the META-POOL free-list — the part of a drop
 * shared by a single drop and a whole sweep. The head is cleared BEFORE the chunks are unmapped, so
 * a second walk over the same region frees nothing. The entry array is a META-POOL cell (leak-
 * bounded, O(regions)); it is dropped by clearing the reference, not returned to a per-cell free.
 *
 * @param control  the control block's base address
 * @param region   the region to release
 * @return         nothing
 */
fn ar_region_release(control: u64, region: u64) {
    var head = ar_region_get(region, REGION_HEAD)
    ar_region_set(region, REGION_HEAD, 0)
    ar_chunk_free_list(head)
    ar_region_set(region, REGION_ENTRIES, 0)
    ar_region_set(region, REGION_NENTRIES, 0)
    ar_region_set(region, REGION_ENTRIES_CAP, 0)
    ar_header_free(control, region)
}

/**
 * Bulk-frees a region: every chunk it holds and its header, in one call. Tolerates a zero handle.
 * The caller MUST drop its handle afterwards — the header is back on the free-list and the next
 * `region_new` may hand the same address out under a fresh generation stamp.
 *
 * @param control  the control block's base address
 * @param region   the region to drop; 0 is a no-op
 * @return         nothing
 */
fn ar_region_drop_w(control: u64, region: u64) {
    if region == 0 { return }
    ar_registry_unlink(control, region)
    ar_region_set(region, REGION_REG_NEXT, 0)
    ar_region_release(control, region)
}

/**
 * Tests whether a region's parent chain reaches `root` — the subtree's membership predicate, read
 * from the parent edges rather than a stored owner tag.
 *
 * @param region  the region to test
 * @param root    the subtree's root
 * @return        true when walking `region`'s parents arrives at `root`
 */
fn ar_region_reaches(region: u64, root: u64): bool {
    var current = region
    loop {
        if current == 0 { break }
        if current == root { return true }
        current = ar_region_get(current, REGION_PARENT)
    }
    false
}

/**
 * Collects every live region of `root`'s subtree onto a detached list, unlinking each from the
 * registry as it goes, and reports that list's head. Collecting FIRST keeps the walk undisturbed by
 * the unlinking; unlinking as it collects keeps a second sweep from double-freeing. The detached
 * list threads through the regions' own registry link, so it costs no allocation.
 *
 * @param control  the control block's base address
 * @param root     the subtree's root
 * @return         the head of the detached doomed-region list, or 0 when none
 */
fn ar_subtree_collect(control: u64, root: u64): u64 {
    var doomed: u64 = 0
    var current = ar_ctrl_get(control, CTRL_REGS)
    loop {
        if current == 0 { break }
        var next = ar_region_get(current, REGION_REG_NEXT)
        if ar_region_reaches(current, root) {
            ar_registry_unlink(control, current)
            ar_region_set(current, REGION_REG_NEXT, doomed)
            doomed = current
        }
        current = next
    }
    doomed
}

/**
 * Drops `root` AND every live region whose parent chain reaches it, in one sweep — the bulk drop an
 * adopted subtree needs. Tolerates a zero handle; the caller MUST drop its handle afterwards.
 *
 * @param control  the control block's base address
 * @param root     the subtree's root; 0 is a no-op
 * @return         nothing
 */
fn ar_region_drop_subtree_w(control: u64, root: u64) {
    if root == 0 { return }
    var doomed = ar_subtree_collect(control, root)
    loop {
        if doomed == 0 { break }
        var next = ar_region_get(doomed, REGION_REG_NEXT)
        ar_region_release(control, doomed)
        doomed = next
    }
}

/**
 * The address of a region's entry slot at `index`.
 *
 * @param region  the region whose table is indexed
 * @param index   the entry's position in the table
 * @return        the entry's base address
 */
fn ar_entry_slot(region: u64, index: u64): u64 {
    ar_region_get(region, REGION_ENTRIES) + index * ENTRY_BYTES
}

/**
 * Finds the index of the entry bound to `type_id` in a region's OWN table, or the table's length
 * when it is not bound. A linear scan, because arena entry counts are small.
 *
 * @param region   the region whose own table is searched
 * @param type_id  the type identifier to find
 * @return         the entry's index, or the table's length when absent
 */
fn ar_entry_index_of(region: u64, type_id: u64): u64 {
    var count = ar_region_get(region, REGION_NENTRIES)
    var i: u64 = 0
    loop {
        if i >= count { break }
        if ar_load(ar_entry_slot(region, i) + ENTRY_TYPE_ID) == type_id { return i }
        i++
    }
    count
}

/**
 * Copies `word_count` machine words from `src` to `dst`, front to back — the raw carry-over the
 * entry table's doubling needs, with no allocation of its own (the destination is already mapped).
 *
 * @param dst         the destination base address
 * @param src         the source base address
 * @param word_count  how many words to copy
 * @return            nothing
 */
fn ar_words_copy(dst: u64, src: u64, word_count: u64) {
    var i: u64 = 0
    loop {
        if i >= word_count { break }
        ar_store(dst + i * WORD, ar_load(src + i * WORD))
        i++
    }
}

/**
 * Grows a region's entry table to the next capacity — four entries the first time, then doubling —
 * carrying the old contents over into a fresh META-POOL cell. The old cell is leak-bounded (one per
 * region growth, O(regions)); it is not returned to a per-cell free, matching the design's
 * leak-bounded entry-array policy (§3).
 *
 * @param control  the control block's base address
 * @param region   the region whose table grows
 * @return         nothing
 */
fn ar_entries_grow(control: u64, region: u64) {
    var old_cap = ar_region_get(region, REGION_ENTRIES_CAP)
    var new_cap = if old_cap == 0 { ENTRIES_FIRST_CAP } else { old_cap * 2 }
    var old_table = ar_region_get(region, REGION_ENTRIES)
    var new_table = ar_meta_alloc(control, new_cap * ENTRY_BYTES)
    var used_words = ar_region_get(region, REGION_NENTRIES) * ENTRY_BYTES / WORD
    if used_words > 0 { ar_words_copy(new_table, old_table, used_words) }
    ar_region_set(region, REGION_ENTRIES, new_table)
    ar_region_set(region, REGION_ENTRIES_CAP, new_cap)
}

/**
 * Binds `type_id` to `instance` in a region's OWN table. A second binding of the same identifier
 * OVERWRITES — this is a storage primitive; a genuine duplicate-registration error belongs to the
 * dependency layer above. Tolerates a zero region.
 *
 * @param control   the control block's base address
 * @param region    the region to bind in; 0 is a no-op
 * @param type_id   the type identifier to bind
 * @param instance  the instance address to bind it to
 * @return          nothing
 */
fn ar_region_register_w(control: u64, region: u64, type_id: u64, instance: u64) {
    if region == 0 { return }
    var count = ar_region_get(region, REGION_NENTRIES)
    var found = ar_entry_index_of(region, type_id)
    if found < count {
        ar_store(ar_entry_slot(region, found) + ENTRY_INSTANCE, instance)
        return
    }
    if count == ar_region_get(region, REGION_ENTRIES_CAP) { ar_entries_grow(control, region) }
    var slot = ar_entry_slot(region, count)
    ar_store(slot + ENTRY_TYPE_ID, type_id)
    ar_store(slot + ENTRY_INSTANCE, instance)
    ar_region_set(region, REGION_NENTRIES, count + 1)
}

/**
 * Resolves `type_id` by walking a region, then its parent, then its parent's parent — so a binding
 * high in the tree is visible beneath it, and a low binding shadows it. Reports 0 when no region in
 * the chain binds the identifier.
 *
 * @param region   the region to start from; 0 resolves to 0
 * @param type_id  the type identifier to resolve
 * @return         the bound instance address, or 0
 */
fn ar_region_lookup_w(region: u64, type_id: u64): u64 {
    var current = region
    loop {
        if current == 0 { break }
        var count = ar_region_get(current, REGION_NENTRIES)
        var found = ar_entry_index_of(current, type_id)
        if found < count { return ar_load(ar_entry_slot(current, found) + ENTRY_INSTANCE) }
        current = ar_region_get(current, REGION_PARENT)
    }
    0
}

/**
 * The address of the mark stack slot at `depth`.
 *
 * @param control  the control block's base address
 * @param depth    the slot's position in the stack, below `MARK_SLOTS`
 * @return         the slot's base address
 */
fn ar_mark_slot(control: u64, depth: u64): u64 {
    control + CTRL_MARKS + depth * MARK_BYTES
}

/**
 * Records the root region's current chunk and bump cursor into the mark stack slot at `depth`.
 *
 * @param control  the control block's base address
 * @param depth    the slot to write, below `MARK_SLOTS`
 * @return         nothing
 */
fn ar_write_mark(control: u64, depth: u64) {
    var head = ar_region_get(ar_region_root_w(control), REGION_HEAD)
    var slot = ar_mark_slot(control, depth)
    ar_store(slot + MARK_CHUNK, head)
    if head == 0 {
        ar_store(slot + MARK_USED, 0)
        return
    }
    ar_store(slot + MARK_USED, ar_chunk_get(head, CHUNK_USED))
}

/**
 * Saves the root region's current bump position as a checkpoint. A push deeper than the stack holds
 * saves nothing but STILL counts, so pushes and pops stay balanced and a later pop can never rewind
 * past a checkpoint that was never recorded.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
fn ar_checkpoint_push_w(control: u64) {
    var depth = ar_ctrl_get(control, CTRL_MSP)
    ar_ctrl_set(control, CTRL_MSP, depth + 1)
    if depth >= MARK_SLOTS { return }
    ar_write_mark(control, depth)
}

/**
 * Rewinds the root region to the top checkpoint: every chunk mapped since it is unmapped and the
 * checkpoint chunk's bump cursor restored. The free lists are purged first, because a parked block
 * may live inside a chunk this rewind is about to release.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
fn ar_checkpoint_pop_w(control: u64) {
    var depth = ar_ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ar_ctrl_set(control, CTRL_MSP, depth - 1)
    if depth - 1 >= MARK_SLOTS { return }
    ar_free_purge(control)
    var slot = ar_mark_slot(control, depth - 1)
    var marked_chunk = ar_load(slot + MARK_CHUNK)
    var marked_used = ar_load(slot + MARK_USED)
    var root = ar_region_root_w(control)
    ar_chunk_free_until(ar_region_get(root, REGION_HEAD), marked_chunk)
    ar_region_set(root, REGION_HEAD, marked_chunk)
    if marked_chunk != 0 { ar_chunk_set(marked_chunk, CHUNK_USED, marked_used) }
}

/**
 * Discards the top checkpoint WITHOUT rewinding, so everything mapped since the matching push stays
 * live and folds into the checkpoint below it. Nothing was freed, so there is nothing to purge.
 *
 * @param control  the control block's base address
 * @return         nothing
 */
fn ar_checkpoint_commit_w(control: u64) {
    var depth = ar_ctrl_get(control, CTRL_MSP)
    if depth == 0 { return }
    ar_ctrl_set(control, CTRL_MSP, depth - 1)
}

/**
 * The address of the free bin holding blocks of exactly `bytes` usable bytes. Class `i` holds
 * `(i + 1) * ARENA_ALIGN` bytes, so a single probe is an exact-size hit rather than a guess.
 *
 * @param control  the control block's base address
 * @param bytes    an already-aligned, non-zero block size within `FREE_BIN_MAX_BYTES`
 * @return         the bin slot's address
 */
fn ar_free_bin_slot(control: u64, bytes: u64): u64 {
    control + CTRL_FREE_BINS + (bytes / ARENA_ALIGN - 1) * WORD
}

/**
 * Tests whether a block size is small enough to bin exactly.
 *
 * @param bytes  the already-aligned block size
 * @return       true when a size class exists for it
 */
fn ar_free_is_binnable(bytes: u64): bool {
    if bytes == 0 { return false }
    bytes <= FREE_BIN_MAX_BYTES
}

/**
 * Reads a freenode field from a parked block.
 *
 * @param node   the parked block's base address
 * @param field  the field's offset within the freenode
 * @return       the field's current value
 */
fn ar_freenode_get(node: u64, field: u64): u64 {
    ar_load(node + field)
}

/**
 * Empties every free list — called wherever the chunks the parked blocks live inside are about to
 * disappear (the rewind and the termination sweep), because a parked block whose chunk is gone is a
 * dangling address. The bins are zeroed word by word rather than by a bulk memset, which the arena
 * core forbids itself (it would re-enter a foreign allocator).
 *
 * @param control  the control block's base address
 * @return         nothing
 */
fn ar_free_purge(control: u64) {
    var i: u64 = 0
    loop {
        if i >= FREE_BINS { break }
        ar_store(control + CTRL_FREE_BINS + i * WORD, 0)
        i++
    }
    ar_ctrl_set(control, CTRL_FREE_LARGE, 0)
}

/**
 * Takes a parked block of exactly the right size class, or 0 when the class is empty. One probe,
 * because the class is exact.
 *
 * @param control  the control block's base address
 * @param size     the already-aligned request size, within `FREE_BIN_MAX_BYTES`
 * @return         a parked block's address, or 0
 */
fn ar_free_take_binned(control: u64, size: u64): u64 {
    var slot = ar_free_bin_slot(control, size)
    var node = ar_load(slot)
    if node == 0 { return 0 }
    ar_store(slot, ar_freenode_get(node, FREENODE_NEXT))
    node
}

/**
 * Tests whether a parked block serves a request without a split: at least the request and at most
 * twice it. There are no block headers to split with, so a block is taken whole or not at all, and
 * the upper bound stops a huge block from serving a small request forever.
 *
 * @param bytes  the parked block's usable size
 * @param size   the already-aligned request size
 * @return       true when the block serves the request
 */
fn ar_free_block_fits(bytes: u64, size: u64): bool {
    if bytes < size { return false }
    bytes <= size * 2
}

/**
 * Takes a parked block off the large list that fits `size` without a split, scanning a bounded
 * prefix so a long list cannot make allocation quadratic.
 *
 * @param control  the control block's base address
 * @param size     the already-aligned request size
 * @return         a parked block's address, or 0
 */
fn ar_free_take_large(control: u64, size: u64): u64 {
    var prev: u64 = 0
    var node = ar_ctrl_get(control, CTRL_FREE_LARGE)
    var scanned: u64 = 0
    loop {
        if node == 0 { break }
        if scanned >= FREE_LARGE_SCAN { break }
        var next = ar_freenode_get(node, FREENODE_NEXT)
        var bytes = ar_freenode_get(node, FREENODE_BYTES)
        if ar_free_block_fits(bytes, size) {
            if prev == 0 { ar_ctrl_set(control, CTRL_FREE_LARGE, next) } else { ar_store(prev + FREENODE_NEXT, next) }
            return node
        }
        prev = node
        node = next
        scanned++
    }
    0
}

/**
 * Reuses an explicitly freed block for a request of `size` bytes, or reports 0 when none fits. The
 * request is rounded UP to the bin granularity — never down — so a 24-byte request can never be
 * handed a 16-byte block. The park side rounds DOWN for the mirror reason; the asymmetry is the
 * whole safety argument.
 *
 * @param control  the control block's base address
 * @param size     the request size in bytes
 * @return         a reusable block's address, or 0
 */
fn ar_free_take(control: u64, size: u64): u64 {
    var wanted = ar_align_up(size)
    if ar_free_is_binnable(wanted) { return ar_free_take_binned(control, wanted) }
    ar_free_take_large(control, wanted)
}

/**
 * Parks a block on the list its size class names, so the next request of that class reuses it.
 *
 * @param control  the control block's base address
 * @param block    the block's base address
 * @param usable   the block's already-floored usable byte count
 * @return         nothing
 */
fn ar_free_park(control: u64, block: u64, usable: u64) {
    ar_store(block + FREENODE_BYTES, usable)
    if ar_free_is_binnable(usable) {
        var slot = ar_free_bin_slot(control, usable)
        ar_store(block + FREENODE_NEXT, ar_load(slot))
        ar_store(slot, block)
        return
    }
    ar_store(block + FREENODE_NEXT, ar_ctrl_get(control, CTRL_FREE_LARGE))
    ar_ctrl_set(control, CTRL_FREE_LARGE, block)
}

/**
 * Poisons a freed block with `0xDD` bytes — the memory oracle's mark. The usable extent is a
 * multiple of the alignment (so a multiple of the word), so the poison is written a word at a time.
 *
 * @param block   the block's base address
 * @param usable  the already-floored usable byte count
 * @return        nothing
 */
fn ar_poison(block: u64, usable: u64) {
    var i: u64 = 0
    loop {
        if i >= usable { break }
        ar_store(block + i, AR_POISON_WORD)
        i = i + WORD
    }
}

/**
 * Frees one explicitly released block. A bump arena cannot return a block to the bump, so the block
 * is PARKED for reuse instead, which stops the footprint growing in a region that is never dropped.
 * The caller's byte count is a true LOWER bound of the extent, so it is rounded DOWN. A block too
 * small to hold a freenode is leaked, because the bump cannot shrink.
 *
 * UNDER `TEKO_MEM_PARANOID` the block is POISONED and NEVER parked (§4.2): arena reuse is invisible
 * to a sanitizer, so a wrong linearity proof would corrupt silently; with the poison, any read of a
 * freed block yields the poison byte and a gate fails loudly instead.
 *
 * @param control  the control block's base address
 * @param block    the block's base address; 0 is a no-op
 * @param bytes    a lower bound of the block's usable size
 * @return         nothing
 */
fn ar_free_block(control: u64, block: u64, bytes: u64) {
    if block == 0 { return }
    var usable = ar_align_down(bytes)
    if tk_arena_paranoid() == 1 {
        if usable > 0 { ar_poison(block, usable) }
        return
    }
    if usable < FREENODE_BYTES_MIN { return }
    ar_free_park(control, block, usable)
}

/**
 * region_alloc — allocate `n` bytes in region `r` (C ABI: `void* tk_region_alloc(void*, uint64_t)`).
 * The hottest arena entry point: bridges the incoming region handle and the outgoing block address
 * across the `ptr`/`u64` boundary while all arithmetic stays in `u64`.
 *
 * @param r  the region handle to allocate in
 * @param n  the requested size in bytes
 * @return   the allocated block, never null
 */
pub fn region_alloc(r: ptr, n: u64): ptr {
    var control = ar_control()
    var address = ar_region_alloc_w(control, teko::sys::ptr_word(r) to u64, n)
    teko::sys::word_ptr(address to i64)
}

/**
 * region_new — open a fresh child region of `parent` (C ABI: `tk_region* tk_region_new(tk_region*)`).
 *
 * @param parent  the tree parent handle; a null handle opens a parentless region
 * @return        the new region handle
 */
pub fn region_new(parent: ptr): ptr {
    var control = ar_control()
    teko::sys::word_ptr(ar_region_new_w(control, teko::sys::ptr_word(parent) to u64) to i64)
}

/**
 * region_drop — bulk-free region `r` (C ABI: `void tk_region_drop(tk_region*)`). A null handle is a
 * no-op.
 *
 * @param r  the region handle to drop
 * @return   nothing
 */
pub fn region_drop(r: ptr) {
    ar_region_drop_w(ar_control(), teko::sys::ptr_word(r) to u64)
}

/**
 * region_drop_subtree — bulk-free `r` and every live region whose parent chain reaches it (C ABI:
 * `void tk_region_drop_subtree(tk_region*)`), the adopt bulk-drop. A null handle is a no-op.
 *
 * @param r  the subtree root handle
 * @return   nothing
 */
pub fn region_drop_subtree(r: ptr) {
    ar_region_drop_subtree_w(ar_control(), teko::sys::ptr_word(r) to u64)
}

/**
 * region_root — this task's root region, opened on first demand (C ABI: `tk_region* tk_region_root()`).
 *
 * @return  the root region handle
 */
pub fn region_root(): ptr {
    teko::sys::word_ptr(ar_region_root_w(ar_control()) to i64)
}

/**
 * region_current — the region default allocation bump-allocates from RIGHT NOW (C ABI: `tk_region*
 * tk_region_current()`). This core has no enter/leave current-region stack, so with no child window
 * open the current region is the root — the honest single-frame model until crumb E wires the stack.
 *
 * @return  the current region handle
 */
pub fn region_current(): ptr {
    teko::sys::word_ptr(ar_region_root_w(ar_control()) to i64)
}

/**
 * region_program — the process PROGRAM region singleton (C ABI: `tk_region* tk_region_program()`),
 * a parentless region that outlives any one task's rewind.
 *
 * @return  the program region handle
 */
pub fn region_program(): ptr {
    teko::sys::word_ptr(ar_region_program_w(ar_control()) to i64)
}

/**
 * arena_push — save the root region's current bump position as a checkpoint (C ABI: `void
 * tk_arena_push()`), the test-gate rewind's open bracket.
 *
 * @return  nothing
 */
pub fn arena_push() {
    ar_checkpoint_push_w(ar_control())
}

/**
 * arena_pop — rewind the root region to the top checkpoint, unmapping everything since it (C ABI:
 * `void tk_arena_pop()`).
 *
 * @return  nothing
 */
pub fn arena_pop() {
    ar_checkpoint_pop_w(ar_control())
}

/**
 * arena_commit — discard the top checkpoint WITHOUT rewinding, folding its allocations into the
 * scope below (C ABI: `void tk_arena_commit()`).
 *
 * @return  nothing
 */
pub fn arena_commit() {
    ar_checkpoint_commit_w(ar_control())
}

/**
 * region_register — bind `tid` to instance `inst` in region `r`'s OWN table (C ABI: `void
 * tk_region_register(tk_region*, uint64_t, void*)`), the DI registry write.
 *
 * @param r     the region handle to bind in; a null handle is a no-op
 * @param tid   the type identifier to bind
 * @param inst  the instance handle to bind it to
 * @return      nothing
 */
pub fn region_register(r: ptr, tid: u64, inst: ptr) {
    ar_region_register_w(ar_control(), teko::sys::ptr_word(r) to u64, tid, teko::sys::ptr_word(inst) to u64)
}

/**
 * region_lookup — resolve `tid` by walking `r` and its parent chain (C ABI: `void*
 * tk_region_lookup(tk_region*, uint64_t)`), the `svc`-scope DI read; a null handle when unbound.
 *
 * @param r    the region handle to start from
 * @param tid  the type identifier to resolve
 * @return     the bound instance handle, or a null handle
 */
pub fn region_lookup(r: ptr, tid: u64): ptr {
    teko::sys::word_ptr(ar_region_lookup_w(teko::sys::ptr_word(r) to u64, tid) to i64)
}
