// src/process/process.tks  (namespace teko::process)
// C7.5: real extern-fn declarations for the teko::process host surface.
//
// The runtime symbol is implemented in src/runtime/teko_rt.c and declared in
// teko_rt.h. The codegen intercepts calls to `run` by last-segment name (the
// CG_FFI_RUN path in codegen.c) and lowers the []str slice to the two-word
// (ptr + len) ABI that tk_rt_run expects — no special lowering is needed here.
//
// The VM rejects extern fn calls with vm_unsupported; callers that need
// `process::run` at test time must compile with `teko build` rather than
// interpreting with `teko run` (C7.1a contract).

/**
 * run — fork/exec `args[0]` with the given argument vector and wait for it to exit.
 *
 * The returned status is the CHILD's: 0–255 for a child that exited, 128+signo for one killed by a
 * signal (so an aborting child reports 134, the same number `sh` would report for it).
 *
 * `TK_RT_SPAWN_FAILED` (-1, src/runtime/teko_rt.h) means something else entirely — the runtime never
 * got a child running (`args` empty, or the spawn/fork/wait failed). It is NEGATIVE on purpose: no
 * child status can be, so "I could not run it" is distinguishable from every code a child could
 * produce. It used to be 127, which is simultaneously `sh`'s command-not-found, the POSIX
 * exec-failed convention, and a legal choice for a child — three diagnoses wearing one number, and
 * a CI failure reading `exit 127` was therefore unanswerable.
 *
 * The codegen CG_FFI_RUN path splits the `[]str` slice into (ptr, len) before calling `tk_rt_run`.
 *
 * @param args  the argument vector; `args[0]` is the executable
 * @return      the child's exit status, or `TK_RT_SPAWN_FAILED` when no child ran
 */
pub extern fn run(args: []str) -> i32 = "tk_rt_run" from "teko_rt"

/**
 * run_quiet — the same contract as `run`, with the child's stdout/stderr redirected to the null
 * device.
 *
 * (issue #73) Used by the build backend's cc flag-family probe — compiling a throwaway empty
 * translation unit to test whether the host cc accepts clang-only flags — so a deliberately-rejected
 * flag does not leak an "unrecognized option" diagnostic into the user's build output.
 *
 * @param args  the argument vector; `args[0]` is the executable
 * @return      the child's exit status, or `TK_RT_SPAWN_FAILED` when no child ran
 */
pub extern fn run_quiet(args: []str) -> i32 = "tk_rt_run_quiet" from "teko_rt"
