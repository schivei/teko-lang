/** teko::env::args — the process argv, as owned strings. */
exp extern fn args(): []str = "tk_rt_args" from "teko_rt"

/** teko::env::version — the build's version string. */
exp extern fn version(): str = "tk_rt_version" from "teko_rt"

/** teko::env::var — the value of the environment variable `name`.
 * @return the value, or an error when unset. */
exp extern fn var(name: str): str | error = "tk_rt_getenv" from "teko_rt"

/** teko::env::cwd — the current working directory as an owned absolute path. */
exp extern fn cwd(): str | error = "tk_rt_getcwd" from "teko_rt"

/** teko::env::set_var — set the environment variable `name` to `value`. */
exp extern fn set_var(name: str, value: str): error | null = "tk_rt_setenv" from "teko_rt"

/** teko::env::chdir — change the process working directory to `path`. */
exp extern fn chdir(path: str): error | null = "tk_rt_chdir" from "teko_rt"

/** teko::env::nproc — the number of logical CPUs granted to this process (always >= 1). */
exp extern fn nproc(): u64 = "tk_nproc" from "teko_rt"
