fn is_valid(bytes: []byte): bool {
    match str_from_utf8(bytes) {
        str => true
        error => false
    }
}

#test
fn accepts_valid_utf8() {
    teko::assert::is_true(is_valid([0x68, 0x65, 0x6C, 0x6C, 0x6F]))
    teko::assert::is_true(is_valid([0x63, 0x61, 0x66, 0xC3, 0xA9]))
    teko::assert::is_true(is_valid([0xE2, 0x82, 0xAC]))
    teko::assert::is_true(is_valid([0xF0, 0x9F, 0xA6, 0xB4]))
    teko::assert::is_true(is_valid(teko::list::empty()))
}

#test
fn rejects_malformed_utf8() {
    teko::assert::is_false(is_valid([0x80]))
    teko::assert::is_false(is_valid([0xC0, 0xAF]))
    teko::assert::is_false(is_valid([0xED, 0xA0, 0x80]))
    teko::assert::is_false(is_valid([0xE2, 0x82]))
    teko::assert::is_false(is_valid([0xC1, 0x80]))
    teko::assert::is_false(is_valid([0xF4, 0x90, 0x80, 0x80]))
    teko::assert::is_false(is_valid([0xE2, 0x28, 0xAC]))
}
