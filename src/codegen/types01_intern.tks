/** teko::codegen types (split 1/2 from codegen.tks — mechanical, pure reorg, no logic changes). */
use teko::checker
use teko::lexer
use teko::parser

type CgMode = enum { Program; TestPlain; TestCov; TestAnalyze; ProgramCov }

/**
 * CovCtx — the coverage-instrumentation context threaded through TestCov body emission (#265).
 *
 * Carries whether line/branch `tk_cov_*_at` calls are emitted and the OWNING production fn's
 * `prog.items` index (so interior line/branch marks key on the same `fn` the static floor walk
 * queries — `line_coverage`/`branch_coverage` in the interpreter's Teko twin use `i to u64`). `on == false` is the
 * default for every non-TestCov path (via `cov_off()`) → NO `tk_cov_*` emitted → byte-identical
 * output → the gen1==gen2 fixpoint is structurally untouched.
 *
 * @see emit_function_cov  the entry that constructs a live CovCtx (cov_idx >= 0)
 * @see line_coverage  the static walk whose `fn` index this MUST match
 * @since #265
 */
type CovCtx = struct {
    /** whether to emit `tk_cov_line_at`/`tk_cov_branch_at` (true only under CgMode::TestCov). */
    on: bool
    /** the owning production fn's `prog.items` index — the `fn` key interior marks attribute to. */
    fn_idx: u64
}

/**
 * The result of emitting one vtable's dispatch thunks (#291): the grown output buffer paired with
 * the grown set of thunk symbols already defined. A named struct is the seed-compatible way to
 * return two values from `cg_emit_vtable_thunks` (the seed rejects bare tuple return types), so the
 * thunk-emission phase can thread BOTH the buffer and the dedup set through its pair walk.
 */
type TThunkEmit = struct {
    /** the output byte buffer with this vtable's not-yet-seen instance-method thunks appended. */
    buf: []byte
    /** the dedup set of `cb_vtthunk_name` symbols, grown with the thunks emitted for this vtable. */
    emitted: []str
}

/**
 * CgNameTable — an open-addressed, linear-probed `str` -> item-index table: the DERIVED lookup
 * acceleration behind `cg_find_decl` / `cg_find_decl_exact` / `cg_find_function`.
 *
 * The table stores a SLOT (the item's index in `prog.items`, biased by one so `0` reads as "free"),
 * never a decl value, so it costs one machine word per bucket and can never disagree with the items
 * it indexes about WHICH decl a hit denotes. Buckets are three parallel arrays rather than one array
 * of a bucket struct, mirroring `teko::collections::Map`'s representation for the same reason: a
 * flat scalar array is the shape the emitter's own lowering handles best.
 *
 * FIRST-WINS is the whole contract. `cg_table_build` inserts keys in `prog.items` order and refuses
 * to overwrite an occupied key, so a probe returns the FIRST item carrying that key — exactly what
 * the linear scans it replaces returned. That is what keeps the emitted C byte-identical.
 *
 * @since cargo/20-codegen-perf
 */
type CgNameTable = struct {
    /** `capacity - 1`, the all-ones mask that folds a hash into a bucket. */
    mask: u64
    /** Each occupied bucket's cached FNV-1a key hash, compared before the full key. */
    hashes: []u64
    /** Each occupied bucket's key; `""` in a free bucket. */
    keys: []str
    /** Each bucket's item index BIASED BY ONE; `0` means the bucket is free. */
    slots: []u64
}

/**
 * CgIndex — the three derived name tables codegen resolves every type/function reference through,
 * built ONCE per emission from the final `prog.items` and threaded inside `CgProg`.
 *
 * @since cargo/20-codegen-perf
 */
type CgIndex = struct {
    /** Canonical decl name ("ns::Name" as declared) -> the first `TypeDecl` item carrying it. */
    exact: CgNameTable
    /** Bare last segment of a decl name -> the first `TypeDecl` item whose name ends in it. */
    last: CgNameTable
    /** `namespace ~ "::" ~ name` -> the first `TFunction` item carrying that pair. */
    fns: CgNameTable
    /**
     * The same-last-segment CHAIN, one entry per item: for a `TypeDecl` at index `i`, the index
     * (biased by one) of the NEXT declaration sharing its bare last segment, or `0` at the end of
     * the chain. Entered through `last`, it enumerates exactly the same-bare cousins, in item
     * order, that a namespace-precise resolution has to discriminate between.
     */
    same_last_next: []u64
}

/**
 * CgProg — codegen's view of the program under emission: the checked items PLUS the derived name
 * index over them.
 *
 * WHY THIS TYPE EXISTS. The file header already records that Teko has no module-level mutable state,
 * so codegen THREADS the program into every helper that needs it. That threading was carrying the
 * items alone, which made each name resolution a full scan of `items` — and with ~1.7M resolutions
 * over ~6k items on a self-build, that scan was 76% of the entire pass (gprof, cargo/20). Widening
 * the threaded value to carry the index alongside the items keeps the functional style and turns
 * every one of those scans into a hash probe, with no change to WHICH decl is resolved.
 *
 * The `items` field is named and typed exactly as `checker::TProgram`'s, so every `prog.items` read
 * in this file reads the same slice it always did.
 *
 * @since cargo/20-codegen-perf
 */
type CgProg = struct {
    /** The checked program's items, in declaration order — the emission's single source of truth. */
    items: []checker::TItem
    /** The derived name index over `items`; empty tables make every lookup fall back to a scan. */
    ix: CgIndex
}

/**
 * The physical storage class chosen for a resolved union type: `Niche` (bare value, `NULL` /
 * `{ptr=NULL}` means `null`, no tag word — C3), `InlineTag` (`{ uint8_t tag; payload }`, in-frame,
 * max-size, zero-indirection — a saturating payload < 16 bytes, or an `#inline`-forced slot), or
 * `BoxInArena` (an 8-byte handle into the arena, `NULL` = `null` = zero heap, a bump-alloc cell on a
 * non-null construct — a saturating payload ≥ 16 bytes, default). This is the LAYOUT dial only,
 * orthogonal to the union's semantic category (base §6.4 Fact 4).
 *
 * @since 0.3.0.30 (null-union C4)
 */
type UnionRepr = enum { Niche; InlineTag; BoxInArena }

/**
 * A recognized TAGGED-variant/member operand pairing in an equality/inequality comparison term.
 * `subj_expr` is the operand whose resolved type is a `Variant` with neither a null NICHE nor a
 * BOX-in-arena representation (REBOOT_PLAN §202/C3/C4 — either of those stores the runtime value
 * as a bare pointer/fat handle with no `.tag` word, so it already compares correctly through the
 * plain `==`/`!=`/`tk_str_eq` fallback and never needs this path). `member` is its comparison
 * partner, already narrowed by the checker (`adopt_binop_operands`/`retype_literal`, C6/C2b) to
 * exactly one of `subj_expr`'s own union members — `null` itself, or a numeric literal's sole
 * fitting member.
 */
type CgVariantMemberCmp = struct {
    /** The operand whose type is the tagged `Variant`. */
    subj_expr: checker::TExpr
    /** The variant's resolved member list (for the tag-constant prefix). */
    variant_type: checker::Variant
    /** The comparison partner, already resolved to one of `variant_type`'s members. */
    member: checker::TExpr
}

// AST struct-vs-kind DESCEND. The .tks parser/typed AST models `Expr`/`TExpr`/… as
// `struct { kind: <variant>; … }`, but the corpus matches such a value DIRECTLY against the
// variant's cases (`match e { Number => … }`). If `subjT` is a NAMED struct with a `kind` field
// of a VARIANT type and `pat` selects a CASE of that variant, return the variant type V and
// whether the kind field is boxed, so the match lowers on `<subj>.kind` (deref if boxed). The C
// twin uses out-params + a bool; here we return `CgKindDescend?` — `null` means "do not descend".
// (C: `cg_kind_descend`.)
type CgKindDescend = struct { var_type: checker::Type; boxed: bool }

/**
 * RegionFrame — one active per-block arena region on the codegen stack (innermost LAST), the codegen
 * twin of codegen.c's cg_block_region. Each scope-introducing block (loop body / if-arm / match-arm /
 * bare block) opens its OWN region `_tkbr<len>` for its provably-block-local allocations, dropped at
 * every exit edge. SAFETY IS ABSOLUTE — a binding is block-routed ONLY when `binding_is_block_local`
 * proves it; otherwise it falls back to the frame/root (W8 = a leak, never a UAF).
 *
 * @since 0.3.1 (A3) `decls` realizes the N-level slice selector: the names of the block-local slice
 *              accumulators DECLARED in this region's block. A self-append `xs = push(xs, item)`
 *              consults `scope_region_of` to route its grown buffer to the region of `xs`'s DECLARING
 *              scope (R_decl), never an inner loop's region — the buffer of an accumulator grown in an
 *              inner loop must live in the outer declaring block, else it dies per-iteration (UAF).
 */
type RegionFrame = struct {
    /** the C variable name of this region (`_tkbr<len>`). */
    name: str
    /** the loop label this region ties to (""  when unlabeled / not a loop), for labeled break/continue. */
    label: str
    /** true for a LOOP-body region (a valid break/continue target); false for an arm/bare-block region
     *  (a break/continue CROSSES it but never STOPS at it). */
    is_loop: bool
    /** the in-scope defer count (dctx.defers.len) at this block's entry — the boundary below which
     *  defers belong to ENCLOSING scopes (structural parity with the C twin's cg_block_region.defer_base). */
    defer_base: u64
    /** (A3) the block-local slice accumulator names declared at the TOP of this region's block; a
     *  self-append of one routes its grown buffer HERE (R_decl), matched by name in `scope_region_of`. */
    decls: []str
}

/**
 * LoopDeferFrame — one active LOOP scope's defer + region boundary, captured at the loop's body entry.
 * A break/continue fires every defer registered at index ≥ the TARGET loop's `defer_base` (the scopes
 * it crosses) LIFO, and drops every region opened at index ≥ the TARGET loop's `region_base` (the
 * regions opened INSIDE the loop body). A loop opens a RegionFrame only when it has a block-local, so
 * loop boundaries ride this SEPARATE stack rather than the RegionFrame stack (the region-less-aware
 * twin). `label` ties the frame to its loop.
 *
 * @since 0.3.1 `region_base` is the RegionFrame-stack depth (regions.len) at the loop's body entry —
 *              the boundary above which regions were opened INSIDE this loop. break/continue drop
 *              exactly `regions[region_base..]`, so an ENCLOSING arm region (opened OUTSIDE the loop,
 *              below `region_base`) is never wrongly dropped by a region-less inner loop's break — the
 *              UAF an accumulator declared in an outer arm and grown in an inner loop would otherwise hit.
 */
type LoopDeferFrame = struct {
    /** the loop label ("" when unlabeled), matched by `break LABEL` / `continue LABEL`. */
    label: str
    /** the in-scope defer count (dctx.defers.len) at the loop's body entry. */
    defer_base: u64
    /** the RegionFrame-stack depth (regions.len) at the loop's body entry — the drop boundary. */
    region_base: u64
}

/**
 * DeferCtx — the threaded defer + coverage state (W9.3; the functional twin of the C's
 * g_cg_defers/g_cg_ndefers statics). One bundle so the whole emit path threads a SINGLE extra param.
 * A TDeferStmt appends to `defers` (emits nothing); a scope-block fires `[base, len)` LIFO at its exit
 * edge (fall-through / break / continue / return). (#265 Track A) `cov` rides this SAME thread — it
 * already reaches emit_stmt AND emit_expr_ctx AND every value-form if/match — so a single field
 * instruments every line/branch chokepoint (the A2/A3/A4 marks) with NO new call-site plumbing.
 */
type DeferCtx = struct {
    /** the live stack of registered TDeferStmt nodes (push order; `.len` == the C's ndefers). */
    defers: []checker::TStatement
    /** the active loop-scope defer-base stack (for break/continue target firing). */
    loops: []LoopDeferFrame
    /** the coverage-instrumentation context; `cov.on == false` (the default) emits zero `tk_cov_*`. */
    cov: CovCtx
    /** (0.3.1 move-on-return A4/M1) the return-region C variable name (`_tkrr`, else "") — the region
     *  an ESCAPING allocation routes to so it survives the frame drop. Rides DeferCtx BECAUSE it must
     *  reach a self-append/binding deep inside a sub-scope UNSTRIPPED (unlike `frame`, which emit_block
     *  clears to "" for sub-scopes): an escaping accumulator grown in a loop of a framed function must
     *  still route to `_tkrr`, never the entered `_tkfr` it would fall into via the current region. */
    rr: str
    /** (0.3.1 move-on-return M2, Mechanism 1) the count of conveyance brackets (`tk_region_enter(_tkrr)`)
     *  currently OPEN at this emit point. A binding/assign whose name escapes wraps its RHS in
     *  `enter(_tkrr) … leave()` so a retained call-result materializes in `_tkrr` (§2a). A `return`/
     *  `break`/`continue` reached WHILE brackets are open must emit `bracket_depth` balancing leaves
     *  BEFORE its own frame leave/drops — the per-edge unwind, mirroring the defer/region-drop machinery
     *  so no exit edge leaves the current-region stack unbalanced (§2c). */
    bracket_depth: u64
}
