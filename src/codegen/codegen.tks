}

fn emit_release(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: release expects one argument (internal)" } }
    var out = cb_fn_name(buf, "teko::runtime", "wrap_release")
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ")")
}

fn weak_get_non_null_member(members: []@Type()): @Type() | error {
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { checker::Null => { }; _ => return members[i] }
        i++
    }
    error { message = "codegen: weak_get result variant has no non-null member (internal)" }
}

fn weak_get_target_type(expected: @Type()): @Type() | error {
    match expected {
        checker::Variant as v => weak_get_non_null_member(v.members)
        _ => error { message = "codegen: weak_get result is not a nullable variant (internal)" }
    }
}

fn emit_weak_get(buf: Cb, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: weak_get expects one argument (internal)" } }
    var ttype = match weak_get_target_type(e.type) { (@Type()) as t => t; error as err => return err }
    var v = fresh_named("_wg", buf.len to i64)
    var out = cb(buf, "({ void *")
    out = cb(out, v)
    out = cb(out, " = (void *)")
    out = cb_fn_name(out, "teko::runtime", "wrap_weak_get")
    out = cb(out, "((void *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ")); ")
    out = cb(out, v)
    out = cb(out, " == 0 ? ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Null { }, "0") { Cb as o => o; error as err => return err }
    out = cb(out, " : ")
    var tcbuf = match emit_type(cb_new(), prog, ttype) { Cb as o => o; error as err => return err }
    var tc = str(cb_flat(tcbuf))
    var tarm = $"*({tc} *){v}"
    out = match emit_variant_wrap_str(out, prog, e.type, ttype, tarm) { Cb as o => o; error as err => return err }
    cb(out, "; })")
}

type DcFieldPlan = struct { is_class: bool; nullable: bool; class_name: str }

type DcScan = struct { classes: []str }

fn dc_scan_add(s: DcScan, name: str): DcScan {
    if cg_str_in(s.classes, name) { return s }
    DcScan { classes = teko::list::push(s.classes, name) }
}

fn cg_dc_is_call(cl: checker::TCall): bool {
    if cl.call_ns != "" { return false }
    if cl.args.len != 1 { return false }
    if cl.callee.segments.len == 0 { return false }
    cl.callee.segments[cl.callee.segments.len - 1].name == "deep_copy"
}

fn cg_dc_scan_expr(s: DcScan, e: checker::TExpr): DcScan {
    var s2 = s
    match e.kind {
        checker::TBinary as b => { s2 = cg_dc_scan_expr(s2, b.left); s2 = cg_dc_scan_expr(s2, b.right) }
        checker::TUnary as u => { s2 = cg_dc_scan_expr(s2, u.operand) }
        checker::TCompare as cm => {
            s2 = cg_dc_scan_expr(s2, cm.first)
            var i = 0
            loop { if i >= cm.rest.len { break }; s2 = cg_dc_scan_expr(s2, cm.rest[i].operand); i++ }
        }
        checker::TCall as cl => {
            var i = 0
            loop { if i >= cl.args.len { break }; s2 = cg_dc_scan_expr(s2, cl.args[i]); i++ }
            if cg_dc_is_call(cl) {
                match cl.args[0].type { checker::Named as n => s2 = dc_scan_add(s2, n.name); _ => { } }
            }
        }
        checker::TIfExpr as f => {
            s2 = cg_dc_scan_expr(s2, f.cond)
            s2 = cg_dc_scan_block(s2, f.then_blk)
            s2 = cg_dc_scan_block(s2, f.else_blk)
        }
        checker::TMatchExpr as m => {
            s2 = cg_dc_scan_expr(s2, m.subject)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s2 = cg_dc_scan_expr(s2, m.arms[i].guard) }
                s2 = cg_dc_scan_block(s2, m.arms[i].body)
                i++
            }
        }
        checker::TCast as ct => { s2 = cg_dc_scan_expr(s2, ct.expr) }
        checker::TFieldAccess as fa => { s2 = cg_dc_scan_expr(s2, fa.receiver) }
        checker::TStructInit as si => { var i = 0; loop { if i >= si.field_vals.len { break }; s2 = cg_dc_scan_expr(s2, si.field_vals[i]); i++ } }
        checker::TIndex as ix => { s2 = cg_dc_scan_expr(s2, ix.receiver); s2 = cg_dc_scan_expr(s2, ix.index) }
        checker::TInExpr as ie => { s2 = cg_dc_scan_expr(s2, ie.lhs); var i = 0; loop { if i >= ie.elems.len { break }; s2 = cg_dc_scan_expr(s2, ie.elems[i]); i++ } }
        checker::TLambda as lam => { s2 = cg_dc_scan_block(s2, lam.body) }
        checker::TBlockExpr as blk => { s2 = cg_dc_scan_block(s2, blk.body) }
        _ => { }
    }
    s2
}

fn cg_dc_scan_block(s: DcScan, stmts: []@TStatement()): DcScan {
    var s2 = s
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => { s2 = cg_dc_scan_expr(s2, b.value) }
            checker::TAssign as a => {
                s2 = cg_dc_scan_expr(s2, a.value)
                if parser::assign_has_target(a.kind) { s2 = cg_dc_scan_expr(s2, a.target) }
            }
            checker::TReturn as r => { if r.has_value { s2 = cg_dc_scan_expr(s2, r.value) } }
            checker::TLoopStmt as l => { s2 = cg_dc_scan_block(s2, l.init); s2 = cg_dc_scan_block(s2, l.body) }
            checker::TExprStmt as es => { s2 = cg_dc_scan_expr(s2, es.expr) }
            checker::TDeferStmt as d => { s2 = cg_dc_scan_block(s2, d.body) }
            checker::TAdoptStmt as a2 => { s2 = cg_dc_scan_block(s2, a2.body) }
            checker::TBlockStmt as b2 => { s2 = cg_dc_scan_block(s2, b2.body) }
            _ => { }
        }
        i++
    }
    s2
}

fn cg_dc_scan_program(prog: CgProg): []str {
    var s = DcScan { classes = teko::list::empty() }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { s = cg_dc_scan_block(s, f.body) }
            (@TStatement()) as st => { s = cg_dc_scan_block(s, teko::list::push(teko::list::empty(), st)) }
            _ => { }
        }
        i++
    }
    s.classes
}

fn cg_dc_plan_nullable(prog: CgProg, members: []@Type()): DcFieldPlan | error {
    if members.len != 2 { return error { message = "codegen: deep_copy only supports a `Class | null` union for reference fields (internal)" } }
    var has_null = false
    var cls = ""
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] {
            checker::Null => has_null = true
            checker::Named as n => {
                if !cg_is_class_named(prog, n.name) { return error { message = "codegen: deep_copy only supports a class reference in a nullable union (internal)" } }
                cls = n.name
            }
            _ => return error { message = "codegen: deep_copy only supports a class reference in a nullable union (internal)" }
        }
        i++
    }
    if !has_null || cls == "" { return error { message = "codegen: deep_copy union member combination unsupported (internal)" } }
    DcFieldPlan { is_class = true; nullable = true; class_name = cls }
}

fn cg_dc_plan_type(prog: CgProg, t: @Type()): DcFieldPlan | error {
    match t {
        checker::Prim => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Byte => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Char => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Str => DcFieldPlan { is_class = false; nullable = false; class_name = "" }
        checker::Named as n => {
            if !cg_is_class_named(prog, n.name) { return error { message = $"codegen: deep_copy does not support field type '{n.name}' (internal)" } }
            if cg_is_polymorphic_base(prog, n.name) { return error { message = $"codegen: deep_copy does not support polymorphic class '{n.name}' yet (internal)" } }
            DcFieldPlan { is_class = true; nullable = false; class_name = n.name }
        }
        checker::Variant as v => cg_dc_plan_nullable(prog, v.members)
        _ => error { message = "codegen: deep_copy does not support this field type (internal)" }
    }
}

fn cg_dc_plan_field(prog: CgProg, ref_ns: str, te: @TypeExpr()): DcFieldPlan | error {
    cg_dc_plan_type(prog, cg_te_to_type_ns(prog, ref_ns, te))
}

fn cg_dc_class_fields(prog: CgProg, cls: str): []parser::Field | error {
    match cg_find_decl(prog, cls) {
        parser::TypeDecl as d => match d.body {
            parser::ClassBody as cb2 => checker::effective_class_fields(cb2, cg_type_table(prog))
            _ => error { message = $"codegen: deep_copy target '{cls}' is not a class (internal)" }
        }
        error => error { message = $"codegen: deep_copy cannot find class '{cls}' (internal)" }
    }
}

fn cg_dc_close(prog: CgProg, seen: []str, work: []str): []str | error {
    if work.len == 0 { return seen }
    var cls = work[0]
    var rest: []str = teko::list::empty()
    var wi = 1
    loop { if wi >= work.len { break }; rest = teko::list::push(rest, work[wi]); wi++ }
    if cg_str_in(seen, cls) { return cg_dc_close(prog, seen, rest) }
    var fields = match cg_dc_class_fields(prog, cls) { []parser::Field as fs => fs; error as e => return e }
    var ref_ns = checker::name_qualifier(cls)
    var seen2 = teko::list::push(seen, cls)
    var work2 = rest
    var fi = 0
    loop {
        if fi >= fields.len { break }
        var plan = match cg_dc_plan_field(prog, ref_ns, fields[fi].type_ann) { DcFieldPlan as p => p; error as e => return e }
        if plan.is_class && !cg_str_in(seen2, plan.class_name) && !cg_str_in(work2, plan.class_name) {
            work2 = teko::list::push(work2, plan.class_name)
        }
        fi++
    }
    cg_dc_close(prog, seen2, work2)
}

fn cg_dc_helper_name(buf: Cb, cls: str): Cb {
    cb_tysym(cb(buf, "tk_dc_"), cls)
}

fn cg_dc_emit_proto(buf: Cb, cls: str): Cb {
    var out = cb(buf, "static ")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *")
    out = cg_dc_helper_name(out, cls)
    out = cb(out, "(tk_region *, ")
    out = mangle_type_name(out, "", cls)
    cb(out, " *, uint8_t, uint8_t *);\n")
}

fn cg_dc_emit_field_copy(buf: Cb, prog: CgProg, ref_ns: str, f: parser::Field): Cb | error {
    var plan = match cg_dc_plan_field(prog, ref_ns, f.type_ann) { DcFieldPlan as p => p; error as e => return e }
    if !plan.is_class {
        var out = cb(buf, "_o->")
        out = cb_str(out, f.name)
        out = cb(out, " = _s->")
        out = cb_str(out, f.name)
        return cb(out, ";\n")
    }
    if !plan.nullable {
        var out = cb(buf, "_o->")
        out = cb_str(out, f.name)
        out = cb(out, " = ")
        out = cg_dc_helper_name(out, plan.class_name)
        out = cb(out, "(_r, _s->")
        out = cb_str(out, f.name)
        return cb(out, ", _d + 1, _e);\n")
    }
    var out = cb(buf, "_o->")
    out = cb_str(out, f.name)
    out = cb(out, " = (_s->")
    out = cb_str(out, f.name)
    out = cb(out, " == NULL) ? NULL : ")
    out = cg_dc_helper_name(out, plan.class_name)
    out = cb(out, "(_r, _s->")
    out = cb_str(out, f.name)
    out = cb(out, ", _d + 1, _e);\n")
    out
}

fn cg_dc_emit_body(buf: Cb, prog: CgProg, cls: str): Cb | error {
    var fields = match cg_dc_class_fields(prog, cls) { []parser::Field as fs => fs; error as e => return e }
    var ref_ns = checker::name_qualifier(cls)
    var out = cb(buf, "static ")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *")
    out = cg_dc_helper_name(out, cls)
    out = cb(out, "(tk_region *_r, ")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *_s, uint8_t _d, uint8_t *_e) {\n")
    out = cb(out, "if (_s == NULL) { return NULL; }\n")
    out = cb(out, "if (*_e || _d >= 255) { *_e = 1; return NULL; }\n")
    out = cb(out, "tk_region *_nr = ")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionNew))
    out = cb(out, "(_r);\n")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *_o = (")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *)")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc))
    out = cb(out, "(_nr, (size_t)sizeof(")
    out = mangle_type_name(out, "", cls)
    out = cb(out, "));\n")
    var fi = 0
    loop {
        if fi >= fields.len { break }
        out = match cg_dc_emit_field_copy(out, prog, ref_ns, fields[fi]) { Cb as o => o; error as err => return err }
        fi++
    }
    out = cb(out, "_o->__region = _nr;\n")
    out = cb(out, "if (*_e) { return NULL; }\n")
    cb(out, "return _o;\n}\n")
}

fn cg_emit_deep_copy_helpers(buf: Cb, prog: CgProg): Cb | error {
    var seeds = cg_dc_scan_program(prog)
    if seeds.len == 0 { return buf }
    var classes = match cg_dc_close(prog, teko::list::empty(), seeds) { []str as cs => cs; error as e => return e }
    var out = buf
    var pi = 0
    loop { if pi >= classes.len { break }; out = cg_dc_emit_proto(out, classes[pi]); pi++ }
    var bi = 0
    loop {
        if bi >= classes.len { break }
        out = match cg_dc_emit_body(out, prog, classes[bi]) { Cb as o => o; error as err => return err }
        bi++
    }
    out
}

fn emit_deep_copy(buf: Cb, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: deep_copy expects one argument (internal)" } }
    var cls = match c.args[0].type { checker::Named as n => n.name; _ => return error { message = "codegen: deep_copy only supports a class argument (internal)" } }
    if !cg_is_class_named(prog, cls) { return error { message = $"codegen: deep_copy only supports a class argument (got '{cls}') (internal)" } }
    if cg_is_polymorphic_base(prog, cls) { return error { message = $"codegen: deep_copy does not support polymorphic class '{cls}' yet (internal)" } }
    var v = fresh_named("_dc", buf.len to i64)
    var ev = fresh_named("_dce", buf.len to i64)
    var out = cb(buf, "({ uint8_t ")
    out = cb(out, ev)
    out = cb(out, " = 0; ")
    out = mangle_type_name(out, "", cls)
    out = cb(out, " *")
    out = cb(out, v)
    out = cb(out, " = ")
    out = cg_dc_helper_name(out, cls)
    out = cb(out, "(")
    out = cb(out, cg_enclosing_region_expr(regions))
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ", 0, &")
    out = cb(out, ev)
    out = cb(out, "); ")
    out = cb(out, ev)
    out = cb(out, " ? ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Error { }, "(tk_error){0}") { Cb as o => o; error as err => return err }
    out = cb(out, " : ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Named { name = cls }, v) { Cb as o => o; error as err => return err }
    cb(out, "; })")
}

fn emit_ptr_unwrap_seam(buf: Cb, addr_c: str, tag_c: str): Cb {
    buf
}

fn emit_ptr_wrap_guard(buf: Cb, addr_c: str, tag_c: str): Cb {
    cb(buf, "1")
}

fn emit_ptr_unwrap(buf: Cb, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: ptr::__unwrap expects one argument (internal)" } }
    var a = fresh_named("_pu", buf.len to i64)
    var out = cb(buf, "({ void *")
    out = cb(out, a)
    out = cb(out, " = (void *)(&(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ")); ")
    out = emit_ptr_unwrap_seam(out, a, "")
    out = cb(out, "(")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb(out, a)
    cb(out, "; })")
}

fn emit_ref_word(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: ref_word expects one argument (internal)" } }
    var out = cb(buf, "((int64_t)(uintptr_t)&(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, "))")
}

fn emit_ptr_wrap(buf: Cb, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.args.len != 1 { return error { message = "codegen: __wrap expects one (receiver) argument (internal)" } }
    if c.type_args.len != 1 { return error { message = "codegen: __wrap expects one type argument (internal)" } }
    var ttype = c.type_args[0]
    var addr = fresh_named("_pw", buf.len to i64)
    var out = cb(buf, "({ void *")
    out = cb(out, addr)
    out = cb(out, " = (void *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); ")
    out = cb(out, addr)
    out = cb(out, " == 0 ? ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Null { }, "0") { Cb as o => o; error as err => return err }
    out = cb(out, " : (")
    out = emit_ptr_wrap_guard(out, addr, "")
    out = cb(out, " ? ")
    var tcbuf = match emit_type(cb_new(), prog, ttype) { Cb as o => o; error as err => return err }
    var tc = str(cb_flat(tcbuf))
    var tarm = $"*({tc} *){addr}"
    out = match emit_variant_wrap_str(out, prog, e.type, ttype, tarm) { Cb as o => o; error as err => return err }
    out = cb(out, " : ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Error { }, "(tk_error){0}") { Cb as o => o; error as err => return err }
    cb(out, "); })")
}

fn emit_as_cstr(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var v = $"_ac{buf.len}"
    var out = cb(buf, $"({{ tk_str {v}_s = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    var region = cg_enclosing_region_expr(regions)
    out = cb(out, $"); uint8_t *{v} = (uint8_t *)")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc))
    cb(out, $"({region}, (size_t)({v}_s.len + 1)); for (uint64_t {v}_i = 0; {v}_i < {v}_s.len; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} {v}[{v}_s.len] = 0; {v}; }})")
}

fn emit_str_from_c(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var v = $"_sfc{buf.len}"
    var out = cb(buf, $"({{ const uint8_t *{v}_p = (const uint8_t *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, $"); uint64_t {v}_max = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, $"); uint64_t {v}_n = 0; if ({v}_p != NULL) {{ while ({v}_n < {v}_max && {v}_p[{v}_n] != 0) {{ {v}_n++; }} }} uint8_t *{v}_buf = (uint8_t *)malloc({v}_n ? {v}_n : 1); if (!{v}_buf) abort(); for (uint64_t {v}_i = 0; {v}_i < {v}_n; {v}_i++) {{ {v}_buf[{v}_i] = {v}_p[{v}_i]; }} (tk_str){{ {v}_buf, {v}_n }}; }})")
}

fn emit_region_buf(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var v = $"_rb{buf.len}"
    var out = cb(buf, $"({{ tk_region *{v}_r = (tk_region *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, $"); uint64_t {v}_len = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, $"); tk_str {v}_s = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, $"); uint8_t *{v} = (uint8_t *)")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc))
    cb(out, $"({v}_r, (size_t){v}_len); uint64_t {v}_cn = ({v}_s.len < {v}_len) ? {v}_s.len : {v}_len; for (uint64_t {v}_i = 0; {v}_i < {v}_cn; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} if ({v}_cn < {v}_len) {{ {v}[{v}_cn] = 0; }} else if ({v}_len > 0) {{ {v}[{v}_len - 1] = 0; }} {v}; }})")
}

fn emit_ptr_word(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "((int64_t)(uintptr_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, "))")
}

fn emit_word_ptr(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "((void *)(uintptr_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, "))")
}

fn emit_load_u64(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "((uint64_t)*(volatile uint64_t *)(uintptr_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, "))")
}

fn emit_store_u64(buf: Cb, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "(*(volatile uint64_t *)(uintptr_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ") = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, "))")
}

fn emit_iface_call(buf: Cb, prog: CgProg, ret_type: @Type(), c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var p = c.callee
    var f = match c.callee_type { checker::Func as ff => ff; _ => return error { message = "codegen: malformed interface-dispatch node (internal)" } }
    if p.segments.len < 2 || c.args.len == 0 || c.args.len != f.params.len {
        return error { message = "codegen: malformed interface-dispatch node (internal)" }
    }
    var iface_raw = p.segments[p.segments.len - 2].name
    var iface = match cg_find_decl(prog, iface_raw) { parser::TypeDecl as d => d.name; error => iface_raw }
    var t = fresh_named("_tid", buf.len to i64)
    var iface_t = checker::Named { name = iface }
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, iface_t) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, t)
    out = cb(out, " = ")
    out = match emit_as_r(out, prog, ret_type, iface_t, c.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "; ((")
    out = match emit_type(out, prog, f.ret) { Cb as o => o; error as err => return err }
    out = cb(out, " (*)(void *")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        out = cb(out, ", ")
        out = match emit_type(out, prog, f.params[pi]) { Cb as o => o; error as err => return err }
        pi++
    }
    out = cb(out, "))")
    out = cb(out, t)
    out = cb(out, ".vtable[")
    out = cb(out, teko::u64_to_str(c.iface_slot to u64))
    out = cb(out, "])(")
    out = cb(out, t)
    out = cb(out, ".data")
    var ai: u64 = 1
    loop {
        if ai >= c.args.len { break }
        out = cb(out, ", ")
        out = match emit_as_r(out, prog, ret_type, f.params[ai], c.args[ai], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        ai++
    }
    cb(out, "); })")
}

fn cg_call_bare_name(c: checker::TCall): str {
    var segs = c.callee.segments
    if segs.len == 0 { return "" }
    segs[segs.len - 1].name
}

fn cg_call_is_user_declared(prog: CgProg, c: checker::TCall): bool {
    if c.call_ns.len == 0 { return false }
    match cg_find_function(prog, c.call_ns, cg_call_bare_name(c)) {
        checker::TFunction as f => !f.is_extern
        error => false
    }
}

fn emit_concat_fold(buf: Cb, prog: CgProg, arg: checker::TExpr, str_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var cs = $"_cs{buf.len}"
    var ci = $"_ci{buf.len}"
    var ca = $"_ca{buf.len}"
    var step = if str_region.len > 0 { $"{ca} = tk_str_concat_r({str_region}, {ca}, {cs}.ptr[{ci}]);" } else { $"{ca} = tk_str_concat({ca}, {cs}.ptr[{ci}]);" }
    var o = cb(buf, "({ ")
    o = match emit_type(o, prog, arg.type) { Cb as r => r; error as err => return err }
    o = cb(o, $" {cs} = ")
    o = match emit_expr_ctx(o, prog, checker::Void { }, arg, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
    o = cb(o, $"; tk_str {ca} = (tk_str){{0,0}}; for (uint64_t {ci} = 0; {ci} < {cs}.len; {ci}++) {{ {step} }} {ca}; }})")
    o
}

fn cg_is_concat_bridge(prog: CgProg, c: checker::TCall): bool {
    if cg_call_is_user_declared(prog, c) { return false }
    var p = c.callee
    if p.segments.len == 0 { return false }
    if c.args.len != 1 { return false }
    if p.segments[p.segments.len - 1].name != "concat" { return false }
    (p.segments.len == 1) || (p.segments[0].name == "teko")
}

fn cg_bound_is_str(t: @Type()): bool {
    match t { checker::Str => true; _ => false }
}

fn emit_svc_slot_call(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, scope: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var sname = match e.type { checker::Named as nm => nm.name; _ => return error { message = "codegen: a service ctor call must have a named type" } }
    var id = checker::svc_type_id(sname)
    var rN = fresh_named("_svcr", buf.len to i64)
    var hN = fresh_named("_svch", buf.len to i64)
    var out = cb(buf, "({ tk_region *")
    out = cb(out, rN)
    out = cb(out, " = ")
    out = cb(out, scope)
    out = cb(out, "; void *")
    out = cb(out, hN)
    out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionLookup)); out = cb(out, "(")
    out = cb(out, rN)
    out = cb(out, ", ")
    out = cb_str(out, teko::u64_to_str(id))
    out = cb(out, "ULL); ")
    out = cb(out, hN)
    out = cb(out, " ? (")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb(out, hN)
    out = cb(out, " : ({ ")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    var vN = fresh_named("_svcv", buf.len to i64)
    out = cb(out, " ")
    out = cb(out, vN)
    out = cb(out, " = ")
    out = match emit_call_inner(out, prog, ret_type, e, c, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "; "); out = cb(out, cg_arena_sym(CgArenaSym::RegionRegister)); out = cb(out, "(")
    out = cb(out, rN)
    out = cb(out, ", ")
    out = cb_str(out, teko::u64_to_str(id))
    out = cb(out, "ULL, (void *)")
    out = cb(out, vN)
    out = cb(out, "); ")
    out = cb(out, vN)
    cb(out, "; }); })")
}

fn svc_scope_expr(lifetime: parser::ServiceLifetime, regions: []RegionFrame): str {
    match lifetime {
        parser::ServiceLifetime::Singleton => teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
        parser::ServiceLifetime::Scoped => cg_enclosing_region_expr(regions)
        parser::ServiceLifetime::Transient => ""
    }
}

fn cg_service_ctor_lifetime(prog: CgProg, c: checker::TCall): parser::ServiceLifetime | null {
    if c.args.len != 0 { return null }
    var segs = c.callee.segments
    if segs.len < 2 { return null }
    if !teko::runtime::str_eq(segs[segs.len - 1].name, "ctor") { return null }
    var owner = segs[segs.len - 2].name
    match cg_find_decl(prog, owner) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => if cb.is_service { cb.service_lifetime } else { null }
            _ => null
        }
        error => null
    }
}

fn emit_call(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    match cg_service_ctor_lifetime(prog, c) {
        parser::ServiceLifetime as lt => {
            var scope = svc_scope_expr(lt, regions)
            if scope.len > 0 { return emit_svc_slot_call(buf, prog, ret_type, e, c, scope, escaping, regions, fn_body, dctx) }
        }
        null => { }
    }
    emit_call_inner(buf, prog, ret_type, e, c, escaping, regions, fn_body, dctx)
}

fn emit_call_inner(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if c.is_iface_dispatch { return emit_iface_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    if c.is_closure_call { return emit_closure_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_unwrap" { return emit_ptr_unwrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_wrap" { return emit_ptr_wrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ref_word" { return emit_ref_word(buf, prog, c, escaping, regions, fn_body, dctx) }
    var p = c.callee
    var user_declared = cg_call_is_user_declared(prog, c)
    var is_pushfo = !user_declared && p.segments.len >= 2 && p.segments[p.segments.len - 2].name == "mem" &&
    p.segments[p.segments.len - 1].name == "push_fo"
    if is_pushfo || (!user_declared && p.segments.len >= 2 && p.segments[0].name == "teko" &&
        p.segments[p.segments.len - 2].name == "list") {
        var llast = p.segments[p.segments.len - 1].name
        if llast == "empty" {
            return emit_list_empty(buf, e)
        }
        if llast == "push" || is_pushfo {
            return emit_list_push(buf, prog, e, c, escaping, regions, fn_body, dctx, if is_pushfo { "@fo" } else { "" })
        }
        if llast == "with_cap" {
            return emit_list_with_cap(buf, prog, e, c, escaping, regions, fn_body, dctx, "")
        }
        if llast == "grow_inplace" {
            return emit_list_grow_inplace(buf, prog, c, escaping, regions, fn_body, dctx)
        }
    }
    if cg_is_mem_value_call(p, user_declared) {
        var vlast = p.segments[p.segments.len - 1].name
        if vlast == "place" { return emit_place(buf, prog, e, c, escaping, regions, fn_body, dctx) }
        if vlast == "read" { return emit_read(buf, prog, c, escaping, regions, fn_body, dctx) }
        if vlast == "write" { return emit_write(buf, prog, c, escaping, regions, fn_body, dctx) }
    }
    if p.segments.len >= 1 && !user_declared {
        var pe = p.segments[p.segments.len - 1].name
        if pe == "err_loc" {
            var oe = cb(buf, "tk_error_loc(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            oe = cb(oe, ", (uint32_t)(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            oe = cb(oe, "), (uint32_t)(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            return cb(oe, "))")
        }
        if pe == "err_typed" {
            var oe = cb(buf, "tk_error_types(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            oe = cb(oe, ", ")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            oe = cb(oe, ", ")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            return cb(oe, ")")
        }
        var addr = (p.segments.len == 1) || (p.segments[0].name == "teko")
        if addr && pe == "append_fo" && c.args.len == 2 {
            var ab = $"_ab{buf.len}"
            var asr = $"_as{buf.len + 1}"
            var al = $"_al{buf.len + 2}"
            var ap = $"_ap{buf.len + 3}"
            var o = cb(buf, "({ ")
            o = match cg_slice_typename(o, checker::Byte { }) { Cb as r => r; error as err => return err }
            o = cb(o, " "); o = cb(o, ab); o = cb(o, " = ")
            o = match emit_as(o, prog, checker::Slice { element = checker::Byte { } }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            o = cb(o, "; tk_str "); o = cb(o, asr); o = cb(o, " = ")
            o = match emit_as(o, prog, checker::Str { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            o = cb(o, "; uint64_t "); o = cb(o, al); o = cb(o, "; uint8_t *"); o = cb(o, ap)
            o = cb(o, " = (uint8_t *)tk_append_bytes_fo("); o = cb(o, ab); o = cb(o, ".ptr, "); o = cb(o, ab); o = cb(o, ".len, "); o = cb(o, asr); o = cb(o, ".ptr, "); o = cb(o, asr); o = cb(o, ".len, &"); o = cb(o, al)
            o = cb(o, "); (")
            o = match cg_slice_typename(o, checker::Byte { }) { Cb as r => r; error as err => return err }
            o = cb(o, "){ .ptr = "); o = cb(o, ap); o = cb(o, ", .len = "); o = cb(o, al)
            return cb(o, " }; })")
        }
        if addr && (pe == "str" || pe == "str_of_bytes") && c.args.len == 1 {
            var sb = $"_sb{buf.len}"
            var o = cb(buf, "({ ")
            o = match emit_type(o, prog, c.args[0].type) { Cb as r => r; error as err => return err }
            o = cb(o, " ")
            o = cb(o, sb)
            o = cb(o, " = ")
            o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            o = cb(o, "; tk_str_of_bytes((tk_str){ (const tk_byte *)")
            o = cb(o, sb)
            o = cb(o, ".ptr, ")
            o = cb(o, sb)
            return cb(o, ".len }); })")
        }
        if addr && pe == "concat" && c.args.len == 1 {
            return emit_concat_fold(buf, prog, c.args[0], "", escaping, regions, fn_body, dctx)
        }
    }
    if p.segments.len >= 1 {
        var l = p.segments[p.segments.len - 1].name
        var addr2 = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        if addr2 {
            if l == "read_file" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_read_file", escaping, regions, fn_body, dctx) }
            if l == "var" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getenv", escaping, regions, fn_body, dctx) }
            if l == "write_file" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_write_file", escaping, regions, fn_body, dctx) }
            if l == "write_file_bytes" { return emit_host_ffi(buf, prog, e, c, "ures_byteslice", "tk_rt_write_file_bytes", escaping, regions, fn_body, dctx) }
            if l == "chdir" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_chdir", escaping, regions, fn_body, dctx) }
            if l == "mkdir" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_mkdir", escaping, regions, fn_body, dctx) }
            if l == "remove_file" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_remove_file", escaping, regions, fn_body, dctx) }
            if l == "cwd" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getcwd", escaping, regions, fn_body, dctx) }
            if l == "set_var" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_setenv", escaping, regions, fn_body, dctx) }
            if l == "list_dir" { return emit_host_ffi(buf, prog, e, c, "slres", "tk_rt_list_dir", escaping, regions, fn_body, dctx) }
            if l == "last_index_of" { return emit_host_ffi(buf, prog, e, c, "u64res", "tk_rt_last_index_of", escaping, regions, fn_body, dctx) }
            if l == "args" { return emit_host_ffi(buf, prog, e, c, "args", "tk_rt_args", escaping, regions, fn_body, dctx) }
            if l == "run" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run", escaping, regions, fn_body, dctx) }
            if l == "run_quiet" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run_quiet", escaping, regions, fn_body, dctx) }
            if l == "bytes_from_ptr" { return emit_host_ffi(buf, prog, e, c, "bytes", "tk_bytes_from_ptr", escaping, regions, fn_body, dctx) }
            if l == "str_from_utf8" { return emit_host_ffi(buf, prog, e, c, "sres_byteslice", "tk_rt_str_from_utf8", escaping, regions, fn_body, dctx) }
            if l == "buf_ptr" { return emit_buf_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "byte_ptr" { return emit_byte_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "as_cstr" { return emit_as_cstr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "str_from_c" { return emit_str_from_c(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "region_buf" { return emit_region_buf(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "ptr_word" { return emit_ptr_word(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "word_ptr" { return emit_word_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "load_u64" { return emit_load_u64(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "store_u64" { return emit_store_u64(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "retain" { return emit_retain(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "release" { return emit_release(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "weak_get" { return emit_weak_get(buf, prog, e, c, escaping, regions, fn_body, dctx) }
            if l == "deep_copy" { return emit_deep_copy(buf, prog, e, c, escaping, regions, fn_body, dctx) }
        }
    }
    var builtin = ""
    var has_builtin = false
    if p.segments.len >= 1 {
        var last = p.segments[p.segments.len - 1].name
        var addressable = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        var assert_sym = if c.call_ns.len == 0 { cg_assert_c_symbol(p) } else { "" }
        if assert_sym.len != 0 { builtin = assert_sym; has_builtin = true }
        else if addressable {
            if last == "print" { builtin = "tk_print"; has_builtin = true }
            else if last == "println" { builtin = "tk_println"; has_builtin = true }
            else if last == "panic" { builtin = "tk_panic_str"; has_builtin = true }
            else if last == "exit" { builtin = "tk_exit"; has_builtin = true }
            else if last == "write" { builtin = "tk_write"; has_builtin = true }
            else if last == "ewrite" { builtin = "tk_ewrite"; has_builtin = true }
            else if last == "eprint" { builtin = "tk_eprint"; has_builtin = true }
            else if last == "eprintln" { builtin = "tk_eprintln"; has_builtin = true }
            else if last == "read_line" { builtin = "tk_rt_read_line"; has_builtin = true }
            else if last == "stdin_eof" { builtin = "tk_rt_stdin_eof"; has_builtin = true }
            else if last == "read_stdin" { builtin = "tk_rt_read_stdin"; has_builtin = true }
            else if last == "parse" { builtin = "tk_float_parse"; has_builtin = true }
            else if last == "fdiv" { builtin = "tk_fdiv"; has_builtin = true }
            else if last == "f64_bits" { builtin = "tk_f64_bits"; has_builtin = true }
            else if last == "f64_from_bits" { builtin = "tk_f64_from_bits"; has_builtin = true }
            else if last == "syscall0" { builtin = "tk_syscall0"; has_builtin = true }
            else if last == "syscall1" { builtin = "tk_syscall1"; has_builtin = true }
            else if last == "syscall2" { builtin = "tk_syscall2"; has_builtin = true }
            else if last == "syscall3" { builtin = "tk_syscall3"; has_builtin = true }
            else if last == "syscall4" { builtin = "tk_syscall4"; has_builtin = true }
            else if last == "syscall5" { builtin = "tk_syscall5"; has_builtin = true }
            else if last == "syscall6" { builtin = "tk_syscall6"; has_builtin = true }
            else if last == "thread_clone" { builtin = "tk_thread_clone"; has_builtin = true }
            else if last == "atomic_cas_u32" { builtin = "tk_atomic_cas_u32"; has_builtin = true }
            else if last == "atomic_xchg_u32" { builtin = "tk_atomic_xchg_u32"; has_builtin = true }
            else if last == "atomic_add_u32" { builtin = "tk_atomic_add_u32"; has_builtin = true }
            else if last == "atomic_load_u32" { builtin = "tk_atomic_load_u32"; has_builtin = true }
            else if last == "cov_reset" { builtin = "tk_cov_reset"; has_builtin = true }
            else if last == "cov_mark" { builtin = "tk_cov_mark"; has_builtin = true }
            else if last == "cov_distinct" { builtin = "tk_cov_distinct"; has_builtin = true }
            else if last == "cov_is_marked" { builtin = "tk_cov_is_marked"; has_builtin = true }
            else if last == "cov_branches_on" { builtin = "tk_cov_branches_on"; has_builtin = true }
            else if last == "cov_branch_reset" { builtin = "tk_cov_branch_reset"; has_builtin = true }
            else if last == "cov_enter" { builtin = "tk_cov_enter"; has_builtin = true }
            else if last == "cov_leave" { builtin = "tk_cov_leave"; has_builtin = true }
            else if last == "cov_branch" { builtin = "tk_cov_branch"; has_builtin = true }
            else if last == "cov_branch_hit" { builtin = "tk_cov_branch_hit"; has_builtin = true }
            else if last == "cov_lines_on" { builtin = "tk_cov_lines_on"; has_builtin = true }
            else if last == "cov_line_reset" { builtin = "tk_cov_line_reset"; has_builtin = true }
            else if last == "cov_line" { builtin = "tk_cov_line"; has_builtin = true }
            else if last == "cov_line_hit" { builtin = "tk_cov_line_hit"; has_builtin = true }
            else if last == "arena_push" { builtin = cg_arena_sym(CgArenaSym::ArenaPush); has_builtin = true }
            else if last == "arena_pop" { builtin = cg_arena_sym(CgArenaSym::ArenaPop); has_builtin = true }
            else if last == "arena_commit" { builtin = cg_arena_sym(CgArenaSym::ArenaCommit); has_builtin = true }
            else if last == "task_reset" { builtin = "tk_task_reset"; has_builtin = true }
            else if last == "intern_get" { builtin = "tk_intern_get"; has_builtin = true }
            else if last == "intern_put" { builtin = "tk_intern_put"; has_builtin = true }
            else if last == "intern_reset" { builtin = "tk_intern_reset"; has_builtin = true }
            else if last == "panic_div0" { builtin = "tk_panic_div0"; has_builtin = true }
            else if last == "panic_oob" { builtin = "tk_panic_oob"; has_builtin = true }
            else if last == "panic_cast" { builtin = "tk_panic_cast"; has_builtin = true }
            else if last == "panic_overflow" { builtin = "tk_panic_overflow"; has_builtin = true }
            else if last == "one_byte" { builtin = "tk_one_byte"; has_builtin = true }
            else if last == "str_concat" { builtin = "tk_str_concat"; has_builtin = true }
            else if last == "str_hash" { builtin = "tk_str_hash"; has_builtin = true }
            else if last == "str_compare" { builtin = "tk_str_cmp"; has_builtin = true }
            else if last == "slice" { builtin = "tk_str_slice"; has_builtin = true }
            else if last == "slice_to" { builtin = "tk_str_slice_to"; has_builtin = true }
            else if last == "slice_from" { builtin = "tk_str_slice_from"; has_builtin = true }
            else if last == "len" { builtin = "tk_str_len"; has_builtin = true }
            else if last == "bytes_of_str" { builtin = "tk_bytes_of_str"; has_builtin = true }
            else if last == "chars" { builtin = "tk_str_chars"; has_builtin = true }
            else if last == "len_chars" { builtin = "tk_str_len_chars"; has_builtin = true }
            else if last == "char_at" { builtin = "tk_char_at"; has_builtin = true }
            else if last == "str_slice_chars" { builtin = "tk_str_slice_chars"; has_builtin = true }
            else if last == "is_alpha" && c.call_ns.len == 0 { builtin = "tk_is_alpha"; has_builtin = true }
            else if last == "is_digit" && c.call_ns.len == 0 { builtin = "tk_is_digit"; has_builtin = true }
            else if last == "is_space" && c.call_ns.len == 0 { builtin = "tk_is_space"; has_builtin = true }
            else if last == "to_lower" && c.call_ns.len == 0 { builtin = "tk_to_lower"; has_builtin = true }
            else if last == "to_upper" && c.call_ns.len == 0 { builtin = "tk_to_upper"; has_builtin = true }
            else if last == "ends_with" { builtin = "tk_str_ends_with"; has_builtin = true }
            else if last == "contains" { builtin = "tk_str_contains"; has_builtin = true }
            else if last == "i64_to_str" { builtin = "tk_i64_to_str"; has_builtin = true }
            else if last == "u64_to_str" { builtin = "tk_u64_to_str"; has_builtin = true }
            else if last == "ftoa" { builtin = "tk_ftoa"; has_builtin = true }
            else if last == "fmt_f" { builtin = "tk_fmt_f"; has_builtin = true }
            else if last == "fmt_e" { builtin = "tk_fmt_e"; has_builtin = true }
            else if last == "fmt_g" { builtin = "tk_fmt_g"; has_builtin = true }
            else if last == "fmt_p" { builtin = "tk_fmt_p"; has_builtin = true }
            else if last == "fmt_n_f" { builtin = "tk_fmt_n_f"; has_builtin = true }
            else if last == "fmt_d" { builtin = "tk_fmt_d"; has_builtin = true }
            else if last == "fmt_x_upper" { builtin = "tk_fmt_x_upper"; has_builtin = true }
            else if last == "fmt_x_lower" { builtin = "tk_fmt_x_lower"; has_builtin = true }
            else if last == "fmt_b" { builtin = "tk_fmt_b"; has_builtin = true }
            else if last == "fmt_n_i" { builtin = "tk_fmt_n_i"; has_builtin = true }
            else if last == "fmt_dyn_f64" { builtin = "tk_fmt_dyn_f64"; has_builtin = true }
            else if last == "fmt_dyn_i64" { builtin = "tk_fmt_dyn_i64"; has_builtin = true }
            else if last == "fmt_dyn_u64" { builtin = "tk_fmt_dyn_u64"; has_builtin = true }
            else if last == "f64_g17" { builtin = "tk_f64_g17"; has_builtin = true }
            else if last == "as_ptr" { builtin = "tk_as_ptr"; has_builtin = true }
            else if last == "os" { builtin = "tk_rt_os"; has_builtin = true }
            else if last == "arch" { builtin = "tk_rt_arch"; has_builtin = true }
            else if last == "version" { builtin = "tk_rt_version"; has_builtin = true }
            else if last == "peak_rss" { builtin = "tk_peak_rss"; has_builtin = true }
        }
    }
    var out = buf
    var cf_res = if c.call_ns.len != 0 {
        cg_find_function(prog, c.call_ns, p.segments[p.segments.len - 1].name)
    } else { error { message = "codegen: no resolved namespace" } }
    if has_builtin {
        out = cb(out, builtin)
    } else if c.call_ns.len != 0 {
        var is_extern_call = false
        var ext_symbol = ""
        match cf_res {
            checker::TFunction as cf => { if cf.is_extern { is_extern_call = true; ext_symbol = cf.c_symbol } }
            error => { }
        }
        if is_extern_call {
            out = cb(out, ext_symbol)
        } else {
            out = cb_fn_name(out, c.call_ns, p.segments[p.segments.len - 1].name, c.overload_suffix)
        }
    } else {
        out = cb_ident(out, p.segments[p.segments.len - 1].name)
    }
    out = cb(out, "(")
    var j = 0
    loop {
        if j >= c.args.len { break }
        if j > 0 { out = cb(out, ", ") }
        var wrapped = false
        match cf_res {
            checker::TFunction as cf => {
                if j < cf.params.len {
                    var cf_ref_ns = cg_fn_ref_ns(prog, cf.namespace)
                    var is_self_recv = if j != 0 { false } else { match cg_struct_self_recv(prog, cf) { str => true; null => false } }
                    match cf.params[j].type_ann {
                        parser::NamedType as nt => {
                            var pn = nt.path.segments[nt.path.segments.len - 1].name
                            if is_self_recv {
                                out = match cg_emit_self_addr(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            } else if pn == "Ref" {
                                var arg_is_ref = match c.args[j].type { checker::Reference => true; _ => false }
                                if !arg_is_ref { out = cb(out, "&") }
                                out = match emit_expr_ctx(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            } else {
                                out = match emit_as_r(out, prog, ret_type, checker::Named { name = cg_canon_name_ns(prog, nt.path, cf_ref_ns) }, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            }
                            wrapped = true
                        }
                        parser::SliceType as slt => {
                            var exp_slice = cg_slice_param_type(prog, slt, c.args[j].type)
                            out = match emit_as_r(out, prog, ret_type, exp_slice, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            wrapped = true
                        }
                        parser::UnionType => {
                            var exp_union = cg_te_to_type_ns(prog, cf_ref_ns, cf.params[j].type_ann)
                            out = match emit_as_r(out, prog, ret_type, exp_union, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            wrapped = true
                        }
                        _ => { }
                    }
                }
            }
            error => { }
        }
        if !wrapped {
            out = match emit_expr_ctx(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        }
        j++
    }
    cb(out, ")")
}

fn cg_emit_nn_guard(buf: Cb, prog: CgProg, recv: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "(")
    out = match emit_type(out, prog, recv.type) { Cb as o => o; error as err => return err }
    out = cb(out, ")tk_nn((void *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, recv, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "), ")
    out = cb(out, teko::u64_to_str(recv.line to u64))
    out = cb(out, ", ")
    out = cb(out, teko::u64_to_str(recv.col to u64))
    cb(out, ")")
}

fn emit_field_access(buf: Cb, prog: CgProg, fa: checker::TFieldAccess, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var is_slice = match fa.receiver.type { checker::Slice => true; _ => false }
    if is_slice && fa.field == "len" {
        var o = cb(buf, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        return cb(o, ".len)")
    }
    var is_error = match fa.receiver.type { checker::Error => true; _ => false }
    if is_error {
        var oe = cb(buf, "((")
        oe = match emit_expr_ctx(oe, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        oe = cb(oe, ").")
        oe = cb_str(oe, fa.field)
        return cb(oe, ")")
    }
    var is_ref = match fa.receiver.type { checker::Reference => true; _ => false }
    if is_ref && fa.field == "value" {
        var or = cb(buf, "(*(")
        or = match emit_expr_ctx(or, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        return cb(or, "))")
    }
    var is_class_recv = match fa.receiver.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class_recv {
        var recv_poly_base = match fa.receiver.type {
            checker::Named as nm => cg_is_polymorphic_base(prog, nm.name)
            _ => false
        }
        if recv_poly_base {
            var bname = match fa.receiver.type { checker::Named as nm => nm.name; _ => "" }
            var ob = cb(buf, "((*((")
            ob = mangle_type_name(ob, "", bname)
            ob = cb(ob, " *)(")
            ob = match emit_expr_ctx(ob, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            ob = cb(ob, ").data)).")
            ob = cb_str(ob, fa.field)
            return cb(ob, ")")
        }
        var oc = cb(buf, "((*")
        oc = match cg_emit_nn_guard(oc, prog, fa.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        oc = cb(oc, ").")
        oc = cb_str(oc, fa.field)
        return cb(oc, ")")
    }
    var fa_boxed = match fa.receiver.type {
        checker::Named as nm => match cg_find_struct_field_type(prog, nm.name, fa.field) {
            (@TypeExpr()) as fte => cg_field_boxed(prog, nm.name, fte)
            null => false
        }
        _ => false
    }
    var out = cb(buf, "(")
    if fa_boxed { out = cb(out, "*") }
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ".")
    out = cb_str(out, fa.field)
    cb(out, "))")
}

fn cg_expr_diverges(e: checker::TExpr): bool {
    match e.kind {
        checker::TCall as c => checker::tcall_is_diverging_builtin(c)
        _ => false
    }
}

fn emit_index(buf: Cb, prog: CgProg, e: checker::TExpr, ix: checker::TIndex, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    match ix.receiver.type {
        checker::Slice as srt => {
            var elem = match srt.element {
                checker::Void => return error { message = "codegen: indexing an untyped empty slice (internal: checker should reject)" }
                _ => srt.element
            }
            var lstmp = $"_ls{buf.len}"
            var litmp = $"_li{buf.len + 1}"
            var so = cb(buf, "({ ")
            so = match emit_type(so, prog, elem) { Cb as o => o; error as err => return err }
            so = cb(so, " const *")
            so = cb(so, lstmp)
            so = cb(so, " = (")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            so = cb(so, ").ptr; uint64_t ")
            so = cb(so, litmp)
            so = cb(so, " = (uint64_t)(")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            so = cb(so, "); ")
            so = cb(so, litmp)
            so = cb(so, " < (")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            so = cb(so, ").len ? ")
            so = cb(so, lstmp)
            so = cb(so, "[")
            so = cb(so, litmp)
            so = cb(so, "]")
            so = cb(so, " : (tk_panic_oob_at(")
            so = cb(so, teko::u64_to_str(e.line to u64))
            so = cb(so, ", ")
            so = cb(so, teko::u64_to_str(e.col to u64))
            so = cb(so, "), (")
            so = match emit_type(so, prog, elem) { Cb as o => o; error as err => return err }
            return cb(so, "){0}); })")
        }
        checker::Str => { }
        _ => return error { message = "codegen: indexing a non-string value not yet supported" }
    }
    var stmp = $"_s{buf.len}"
    var itmp = $"_i{buf.len + 1}"
    var out = cb(buf, "({ tk_str ")
    out = cb(out, stmp)
    out = cb(out, " = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "; uint64_t ")
    out = cb(out, itmp)
    out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); ")
    out = cb(out, itmp)
    out = cb(out, " < ")
    out = cb(out, stmp)
    out = cb(out, ".len ? ")
    out = cb(out, stmp)
    out = cb(out, ".ptr[")
    out = cb(out, itmp)
    out = cb(out, "]")
    var z = cb(out, " : (tk_panic_oob_at(")
    z = cb(z, teko::u64_to_str(e.line to u64))
    z = cb(z, ", ")
    z = cb(z, teko::u64_to_str(e.col to u64))
    cb(z, "), (tk_byte)0); })")
}

fn emit_in(buf: Cb, prog: CgProg, ie: checker::TInExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if ie.elems.len == 0 {
        var z = cb(buf, "({ (void)(")
        z = match emit_expr_ctx(z, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        return cb(z, "); 0; })")
    }
    var tmp = $"_inv{buf.len}"
    var str_in = match ie.lhs.type { checker::Str => true; _ => false }
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, ie.lhs.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, " = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "; ")
    var i = 0
    loop {
        if i >= ie.elems.len { break }
        if i > 0 { out = cb(out, " || ") }
        if str_in {
            out = cb(out, "tk_str_eq(")
            out = cb(out, tmp)
            out = cb(out, ", ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ")")
        } else {
            out = cb(out, "(")
            out = cb(out, tmp)
            out = cb(out, " == ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ")")
        }
        i++
    }
    cb(out, "; })")
}

fn emit_slice_of_len(buf: Cb, prog: CgProg, e: checker::TExpr, s: checker::TSliceOfLen, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var elem = s.element
    var lenN = $"_oln{buf.len}"
    var ptrN = $"_olp{buf.len + 1}"
    var out = cb(buf, "({ uint64_t ")
    out = cb(out, lenN)
    out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, s.size, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); ")
    out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
    out = cb(out, " *")
    out = cb(out, ptrN)
    out = cb(out, " = (")
    out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
    out = cb(out, " *)")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc))
    out = cb(out, "(")
    out = cb(out, cg_enclosing_region_expr(regions))
    out = cb(out, ", ")
    out = cb(out, lenN)
    out = cb(out, " * sizeof(")
    out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
    out = cb(out, ")); memset(")
    out = cb(out, ptrN)
    out = cb(out, ", 0, ")
    out = cb(out, lenN)
    out = cb(out, " * sizeof(")
    out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
    out = cb(out, ")); (")
    out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
    out = cb(out, "){ .ptr = ")
    out = cb(out, ptrN)
    out = cb(out, ", .len = ")
    out = cb(out, lenN)
    if cg_slice_rep_has_cap(elem) {
        out = cb(out, ", .cap = ")
        out = cb(out, lenN)
    }
    cb(out, " }; })")
}

fn emit_array_lit(buf: Cb, prog: CgProg, e: checker::TExpr, a: checker::TArrayLit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var elem = match e.type { checker::Slice as s => s.element; _ => return error { message = "codegen: array literal is not a slice type (internal)" } }
    if a.elements.len == 0 {
        var z = cb(buf, "(")
        z = match cg_slice_typename(z, elem) { Cb as o => o; error as err => return err }
        return cb(z, "){ .ptr = 0, .len = 0 }")
    }
    var has_spread = false
    var si: u64 = 0
    loop {
        if si >= a.elements.len { break }
        if a.elements[si].is_spread { has_spread = true; break }
        si++
    }
    if !has_spread {
        var pN = $"_arr{buf.len}"
        var out = cb(buf, "({ ")
        out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
        out = cb(out, " *"); out = cb(out, pN); out = cb(out, " = malloc(")
        out = cb_u64_digits(out, a.elements.len)
        out = cb(out, " * sizeof(")
        out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
        out = cb(out, ")); if (!"); out = cb(out, pN); out = cb(out, ") abort(); ")
        var i: u64 = 0
        loop {
            if i >= a.elements.len { break }
            out = cb(out, pN); out = cb(out, "["); out = cb_u64_digits(out, i); out = cb(out, "] = ")
            out = match emit_as(out, prog, elem, a.elements[i].expr, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, "; ")
            i++
        }
        out = cb(out, "(")
        out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
        out = cb(out, "){ .ptr = "); out = cb(out, pN); out = cb(out, ", .len = ")
        out = cb_u64_digits(out, a.elements.len)
        if cg_slice_rep_has_cap(elem) {
            out = cb(out, ", .cap = ")
            out = cb_u64_digits(out, a.elements.len)
        }
        return cb(out, " }; })")
    }
    var tag = buf.len
    var accN = $"_sarr{tag}"
    var capN = $"_scap{tag}"
    var out = cb(buf, "({ ")
    out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
    out = cb(out, " "); out = cb(out, accN); out = cb(out, " = { .ptr = 0, .len = 0 }; uint64_t "); out = cb(out, capN); out = cb(out, " = 0; ")
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var ae = a.elements[i]
        var spN = $"_spp{tag}_{i}"
        if ae.is_spread {
            var subN = $"_ssub{tag}_{i}"
            var jN = $"_sj{tag}_{i}"
            out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
            out = cb(out, " "); out = cb(out, subN); out = cb(out, " = ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ae.expr, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, "; ")
            out = cb(out, "for (uint64_t "); out = cb(out, jN); out = cb(out, " = 0; ")
            out = cb(out, jN); out = cb(out, " < "); out = cb(out, subN); out = cb(out, ".len; ")
            out = cb(out, jN); out = cb(out, "++) { ")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, " *"); out = cb(out, spN); out = cb(out, " = (")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "*)tk_slice_push("); out = cb(out, accN); out = cb(out, ".ptr, "); out = cb(out, accN); out = cb(out, ".len, &")
            out = cb(out, subN); out = cb(out, ".ptr["); out = cb(out, jN); out = cb(out, "], sizeof(")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "), &"); out = cb(out, capN); out = cb(out, "); if (!"); out = cb(out, spN); out = cb(out, ") abort(); ")
            out = cb(out, accN); out = cb(out, " = (")
            out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "){ .ptr = "); out = cb(out, spN); out = cb(out, ", .len = "); out = cb(out, capN); out = cb(out, " }; } ")
        } else {
            var tmpN = $"_sitm{tag}_{i}"
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, " "); out = cb(out, tmpN); out = cb(out, " = ")
            out = match emit_as(out, prog, elem, ae.expr, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, "; ")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, " *"); out = cb(out, spN); out = cb(out, " = (")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "*)tk_slice_push("); out = cb(out, accN); out = cb(out, ".ptr, "); out = cb(out, accN); out = cb(out, ".len, &")
            out = cb(out, tmpN); out = cb(out, ", sizeof(")
            out = match emit_type(out, prog, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "), &"); out = cb(out, capN); out = cb(out, "); if (!"); out = cb(out, spN); out = cb(out, ") abort(); ")
            out = cb(out, accN); out = cb(out, " = (")
            out = match cg_slice_typename(out, elem) { Cb as o => o; error as err => return err }
            out = cb(out, "){ .ptr = "); out = cb(out, spN); out = cb(out, ", .len = "); out = cb(out, capN); out = cb(out, " }; ")
        }
        i++
    }
    var z = cb(out, accN)
    cb(z, "; })")
}

fn emit_piece_lit(buf: Cb, piece: str): Cb {
    var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
    out = cb_cstr_escaped(out, piece)
    out = cb(out, "\", ")
    out = cb_i64(out, piece.len to i64)
    cb(out, " }")
}

fn fmt_family_takes_prec(fc_low: byte, is_flt: bool): bool {
    if fc_low == 120 { return false }
    if fc_low == 98 { return false }
    if fc_low == 110 && !is_flt { return false }
    true
}
fn emit_interp(buf: Cb, prog: CgProg, in: checker::TInterp, str_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var nsegs = in.pieces.len + in.holes.len
    var out = buf
    var concat_open = if str_region.len > 0 { teko::str::concat("tk_str_concat_r(", str_region, ", ") } else { "tk_str_concat(" }
    var s = 1
    loop { if s >= nsegs { break }; out = cb(out, concat_open); s++ }
    var k = 0
    loop {
        if k >= nsegs { break }
        if k >= 1 { out = cb(out, ", ") }
        if k % 2 == 0 {
            out = emit_piece_lit(out, in.pieces[k / 2])
        } else {
            var hi = k / 2
            var h = in.holes[hi]
            if hi < in.specs.len {
                var sp = in.specs[hi]
                match sp.kind {
                    checker::TFSpecStatic as fs => {
                        var spec = fs.s
                        var fc0 = if spec.len > 0 { spec[0] } else { 102 to byte }
                        var fc_low = if fc0 >= 65 && fc0 <= 90 { (fc0 to u64 + 32) to byte } else { fc0 }
                        var prec = 0
                        var has_prec = false
                        var si = 1 to u64
                        loop {
                            if si >= spec.len { break }
                            var ch = spec[si]
                            if ch >= 48 && ch <= 57 { prec = prec * 10 + (ch to i64 - 48); has_prec = true }
                            si++
                        }
                        if !has_prec { prec = if fc_low == 100 { 1 } else { 6 } }
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var prec_str = teko::i64_to_str(prec)
                        if fc_low == 102 { out = cb(out, "tk_fmt_f((double)(") }
                        else if fc_low == 101 { out = cb(out, "tk_fmt_e((double)(") }
                        else if fc_low == 103 { out = cb(out, "tk_fmt_g((double)(") }
                        else if fc_low == 112 { out = cb(out, "tk_fmt_p((double)(") }
                        else if fc_low == 100 { out = cb(out, "tk_fmt_d((int64_t)(") }
                        else if fc_low == 120 && spec.len > 0 && spec[0] == 88 { out = cb(out, "tk_fmt_x_upper((uint64_t)(") }
                        else if fc_low == 120 { out = cb(out, "tk_fmt_x_lower((uint64_t)(") }
                        else if fc_low == 98 { out = cb(out, "tk_fmt_b((uint64_t)(") }
                        else if fc_low == 110 && is_flt { out = cb(out, "tk_fmt_n_f((double)(") }
                        else if fc_low == 110 { out = cb(out, "tk_fmt_n_i((int64_t)(") }
                        else { return error { message = "codegen: unrecognized format spec" } }
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                        if fmt_family_takes_prec(fc_low, is_flt) {
                            out = cb(out, "), ")
                            out = cb(out, prec_str)
                            out = cb(out, ")")
                        } else {
                            out = cb(out, "))")
                        }
                    }
                    checker::TFSpecDynamic as fd => {
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var is_sint = match h.type { checker::Prim as p => cg_prim_is_signed_int(p.kind); _ => false }
                        if is_flt { out = cb(out, "tk_fmt_dyn_f64((double)(") }
                        else if is_sint { out = cb(out, "tk_fmt_dyn_i64((int64_t)(") }
                        else { out = cb(out, "tk_fmt_dyn_u64((uint64_t)(") }
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                        out = cb(out, "), ")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, fd.args[0], escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                        out = cb(out, ")")
                    }
                    _ => {
                        match h.type {
                            checker::Str => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
                            checker::Char => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
                            checker::Prim as p => {
                                if p.kind == checker::PrimKind::Bool {
                                    out = cb(out, "(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                    out = cb(out, " ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
                                } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                                    out = cb(out, "tk_ftoa((double)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                    out = cb(out, "))")
                                } else if cg_prim_is_signed_int(p.kind) {
                                    out = cb(out, "tk_i64_to_str((int64_t)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                    out = cb(out, "))")
                                } else {
                                    out = cb(out, "tk_u64_to_str((uint64_t)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                    out = cb(out, "))")
                                }
                            }
                            checker::Byte => {
                                out = cb(out, "tk_u64_to_str((uint64_t)(")
                                out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                out = cb(out, "))")
                            }
                            checker::Error => {
                                out = cb(out, "(")
                                out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                                out = cb(out, ").message")
                            }
                            _ => return error { message = "codegen: interpolation hole type not supported" }
                        }
                    }
                }
            } else {
                match h.type {
                    checker::Str => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
                    checker::Char => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
                    checker::Prim as p => {
                        if p.kind == checker::PrimKind::Bool {
                            out = cb(out, "(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            out = cb(out, " ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
                        } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                            out = cb(out, "tk_ftoa((double)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            out = cb(out, "))")
                        } else if cg_prim_is_signed_int(p.kind) {
                            out = cb(out, "tk_i64_to_str((int64_t)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            out = cb(out, "))")
                        } else {
                            out = cb(out, "tk_u64_to_str((uint64_t)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                            out = cb(out, "))")
                        }
                    }
                    checker::Byte => {
                        out = cb(out, "tk_u64_to_str((uint64_t)(")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                        out = cb(out, "))")
                    }
                    checker::Error => {
                        out = cb(out, "(")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                        out = cb(out, ").message")
                    }
                    _ => return error { message = "codegen: interpolation hole type not supported" }
                }
            }
        }
        if k >= 1 { out = cb(out, ")") }
        k++
    }
    out
}

fn cg_find_struct_field_type(prog: CgProg, sname: str, fname: str): @TypeExpr() | null {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => {
                if d.name == sname || checker::name_last_segment(d.name) == checker::name_last_segment(sname) {
                    match d.body {
                        parser::StructBody as sb => {
                            var j = 0
                            loop {
                                if j >= sb.fields.len { break }
                                if sb.fields[j].name == fname { return sb.fields[j].type_ann }
                                j++
                            }
                        }
                        parser::ClassBody as cb2 => {
                            var table = cg_type_table(prog)
                            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return null }
                            var j = 0
                            loop {
                                if j >= fields.len { break }
                                if fields[j].name == fname { return fields[j].type_ann }
                                j++
                            }
                        }
                        parser::ExternStructBody as esb => {
                            var j = 0
                            loop {
                                if j >= esb.fields.len { break }
                                if esb.fields[j].name == fname { return esb.fields[j].type_ann }
                                j++
                            }
                        }
                        _ => { }
                    }
                }
            }
            _ => { }
        }
        i++
    }
    null
}

fn emit_struct_init(buf: Cb, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    return emit_struct_init_framed(buf, prog, e, si, "", escaping, regions, fn_body, dctx)
}

fn emit_struct_init_framed(buf: Cb, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var is_class = match e.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class {
        var id = buf.len to i64
        var rN = fresh_named("_clsr", id)
        var pN = fresh_named("_clsp", id)
        var out = cb(buf, "({ tk_region *")
        out = cb(out, rN)
        out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "(")
        out = cb(out, cg_enclosing_region_expr_framed(regions, frame))
        out = cb(out, "); ")
        out = match e.type { checker::Named as nm => mangle_type_name(out, "", nm.name); _ => out }
        out = cb(out, " *")
        out = cb(out, pN)
        out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc)); out = cb(out, "(")
        out = cb(out, rN)
        out = cb(out, ", sizeof(*")
        out = cb(out, pN)
        out = cb(out, ")); *")
        out = cb(out, pN)
        out = cb(out, " = ")
        out = match emit_struct_init_literal(out, prog, e, si, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        out = cb(out, "; ")
        out = cb(out, pN)
        out = cb(out, "->__region = ")
        out = cb(out, rN)
        out = cb(out, "; ")
        out = cb(out, pN)
        return cb(out, "; })")
    }
    emit_struct_init_literal(buf, prog, e, si, frame, escaping, regions, fn_body, dctx)
}

fn emit_struct_init_literal(buf: Cb, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var name = match e.type {
        checker::Named as nm => nm.name
        checker::Error => {
            if si.field_vals.len != 1 { return error { message = "codegen: error value must have exactly the `message` field (internal)" } }
            var oe = cb(buf, "tk_error_make(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, si.field_vals[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
            return cb(oe, ")")
        }
        _ => return error { message = "codegen: struct literal with a non-named type not yet supported" }
    }
    var out = cb(buf, "(")
    out = mangle_type_name(out, "", name)
    out = cb(out, "){ ")
    var i = 0
    loop {
        if i >= si.field_names.len { break }
        if i > 0 { out = cb(out, ", ") }
        out = cb(out, ".")
        out = cb_str(out, si.field_names[i])
        out = cb(out, " = ")
        var fv = si.field_vals[i]
        var fte_opt = cg_find_struct_field_type(prog, name, si.field_names[i])
        var boxed = match fte_opt {
            (@TypeExpr()) as fte => cg_field_boxed(prog, name, fte)
            null => false
        }
        var bxid = out.len to i64
        var bxN = fresh_named("_bx", bxid)
        if boxed {
            out = cb(out, "({ ")
            match fte_opt { (@TypeExpr()) as fte => { out = match emit_type_expr(out, prog, fte, checker::name_qualifier(name)) { Cb as o => o; error as err => return err } }; null => { } }
            out = cb(out, " *"); out = cb(out, bxN)
            if frame.len > 0 {
                out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc)); out = cb(out, "("); out = cb(out, frame); out = cb(out, ", sizeof *"); out = cb(out, bxN); out = cb(out, "); *"); out = cb(out, bxN); out = cb(out, " = ")
            } else {
                out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::Alloc)); out = cb(out, "(sizeof *"); out = cb(out, bxN); out = cb(out, "); *"); out = cb(out, bxN); out = cb(out, " = ")
            }
        }
        var emitted: bool = match fv.kind {
            checker::TNullLit => false
            _ => match fv.type {
                checker::Slice as sl => match sl.element {
                    checker::Void => {
                        match fte_opt {
                            (@TypeExpr()) as fte => match fte {
                                parser::SliceType as st => {
                                    out = cb(out, "(")
                                    out = match emit_type_expr(out, prog, fte, checker::name_qualifier(name)) { Cb as o => o; error as err => return err }
                                    out = cb(out, "){ .ptr = 0, .len = 0 }")
                                    true
                                }
                                _ => false
                            }
                            null => false
                        }
                    }
                    _ => false
                }
                _ => false
            }
        }
        if !emitted {
            var exp_t: @Type() = checker::Void { }
            match fte_opt {
                (@TypeExpr()) as fte => match fte {
                    parser::NamedType as nt => { exp_t = checker::Named { name = cg_canon_name_ns(prog, nt.path, checker::name_qualifier(name)) } }
                    parser::SliceType as st => match st.element {
                        parser::NamedType as ent => {
                            var elem = ent.path.segments[ent.path.segments.len - 1].name
                            if !cg_is_prim_name(elem) { exp_t = checker::Slice { element = checker::Named { name = cg_canon_name_ns(prog, ent.path, checker::name_qualifier(name)) } } }
                        }
                        _ => { }
                    }
                    parser::UnionType as ut => match cg_te_to_type_ns(prog, checker::name_qualifier(name), parser::UnionType { members = ut.members }) {
                        checker::Variant as va => { exp_t = checker::Variant { members = va.members } }
                        _ => { }
                    }
                    _ => { }
                }
                null => { }
            }
            match exp_t {
                checker::Void => { out = match emit_expr_ctx(out, prog, checker::Void { }, fv, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
                _ => { out = match emit_as_r_in(out, prog, checker::Void { }, exp_t, fv, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err } }
            }
        }
        if boxed { out = cb(out, "; "); out = cb(out, bxN); out = cb(out, "; })") }
        i++
    }
    cb(out, " }")
}

fn emit_strlit(buf: Cb, s: checker::TStrLit): Cb | error {
    var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
    out = cb_cstr_escaped(out, s.text)
    out = cb(out, "\", ")
    out = cb_i64(out, s.text.len to i64)
    cb(out, " }")
}

fn emit_bytestrlit(buf: Cb, s: checker::TByteStrLit): Cb | error {
    var out = cb(buf, "(tk_slice_byte){ (tk_byte *)\"")
    out = cb_cstr_escaped(out, s.text)
    out = cb(out, "\", ")
    out = cb_i64(out, s.text.len to i64)
    cb(out, " }")
}

fn emit_charlit(buf: Cb, ch: checker::TCharLit): Cb | error {
    var out = cb(buf, "(tk_char){ (uint8_t *)\"")
    out = cb_cstr_escaped(out, ch.bytes)
    out = cb(out, "\", ")
    out = cb_i64(out, ch.bytes.len to i64)
    cb(out, " }")
}

fn is_void_type(t: @Type()): bool {
    match t { checker::Void => true; _ => false }
}

fn fresh_tmp_name(buf_len: i64): str {
    var nm = cb(cb_new(), "_tk")
    nm = cb_i64(nm, buf_len)
    str(cb_flat(nm))
}

fn emit_stmt_value(buf: Cb, prog: CgProg, ret_type: @Type(), s: @TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement()): Cb | error {
    match s {
        checker::TReturn => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TBreakStmt => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TContinueStmt => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TExprStmt as es => {
            if is_void_type(es.expr.type) {
                return emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
            }
            var out = emit_cov_lines(buf, dctx.cov, cov_collect_expr(es.expr, teko::list::empty()), indent)
            out = cb(out, indent)
            out = cb(out, sink)
            out = cb(out, " = ")
            out = match emit_as_r(out, prog, ret_type, slot, es.expr, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            cb(out, ";\n")
        }
        _ => emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
    }
}

fn emit_branch_value(buf: Cb, prog: CgProg, ret_type: @Type(), body: []@TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64
    if !want_block {
        var defer_floor = dctx.defers.len
        var cur = dctx
        var out = buf
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, indent, "", escaping, regions, fn_body, cur, teko::list::empty(), false) { Cb as o => o; error as err => return err } }
            }
            i++
        }
        if body.len > 0 {
            out = match emit_stmt_value(out, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regions, fn_body, cur, teko::list::empty()) { Cb as o => o; error as err => return err }
        }
        if cur.defers.len > defer_floor {
            out = match emit_defers(out, cur.defers, defer_floor, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
        }
        return out
    }
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, body)
    var region = fresh_named("_tkbr", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "("); out = cb(out, cg_enclosing_region_expr(regions)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true) })
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, indent, "", escaping, regs2, fn_body, cur, body, true) { Cb as o => o; error as err => return err } }
        }
        i++
    }
    if body.len > 0 {
        out = match emit_stmt_value(out, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regs2, fn_body, cur, body) { Cb as o => o; error as err => return err }
    }
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

fn emit_if_value(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, f: checker::TIfExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if !f.has_else { return error { message = "codegen: if-without-else used as a value not yet supported" } }
    var tmp = fresh_tmp_name(buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, "; if (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ") {\n")
    out = emit_cov_branch(out, dctx.cov, e.line, e.col, 0, "    ")
    out = match emit_branch_value(out, prog, ret_type, f.then_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "} else {\n")
    out = emit_cov_branch(out, dctx.cov, e.line, e.col, 1, "    ")
    out = match emit_branch_value(out, prog, ret_type, f.else_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "} ")
    out = cb(out, tmp)
    cb(out, "; })")
}

fn fresh_named(prefix: str, n: i64): str {
    var nm = cb(cb_new(), prefix)
    nm = cb_i64(nm, n)
    str(cb_flat(nm))
}

fn cg_var_nmem(prog: CgProg, v: @Type()): i64 {
    match v {
        checker::Variant as va => va.members.len to i64
        checker::Named as nm => match cg_find_variant_decl(prog, nm.name) {
            parser::TypeDecl as d => match d.body {
                parser::VariantBody as vb => match vb.type_expr {
                    parser::UnionType as u => u.members.len to i64
                    _ => 0
                }
                _ => 0
            }
            error => 0
        }
        _ => 0
    }
}

fn cg_var_mkey(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_key_str(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(nm.name))
        }
        _ => error { message = "codegen: cg_var_mkey on a non-variant type (internal)" }
    }
}

fn cg_var_mkey_bare(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_bare_key(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey_bare on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey_bare on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_bare_str(members[i])
        }
        _ => error { message = "codegen: cg_var_mkey_bare on a non-variant type (internal)" }
    }
}

fn cg_case_key_qualified(prog: CgProg, variantT: @Type(), pat: @Pattern()): str | error {
    var bare = match cg_emit_case_key_str(pat) { str as s => s; error as e => return e }
    var n = cg_var_nmem(prog, variantT)
    var i = 0
    loop {
        if i >= n { break }
        var mb = match cg_var_mkey_bare(prog, variantT, i) { str as s => s; error => "" }
        if mb == bare { return cg_var_mkey(prog, variantT, i) }
        i++
    }
    bare
}

fn cg_var_mtype(prog: CgProg, v: @Type(), i: i64): @Type() {
    match v {
        checker::Variant as va => va.members[i]
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error => return checker::Void { } }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return checker::Void { } }
                _ => return checker::Void { }
            }
            match members[i] {
                parser::NamedType as nt => checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) }
                _ => checker::Void { }
            }
        }
        _ => checker::Void { }
    }
}

fn cg_is_variant_type(prog: CgProg, mt: @Type()): bool {
    match mt {
        checker::Variant => true
        checker::Named as nm => cg_named_is_variant(prog, nm.name)
        _ => false
    }
}

fn cg_member_reached_via_subclass(prog: CgProg, mt: @Type(), vkey: str): bool {
    match mt {
        checker::Named as mn => cg_is_polymorphic_base(prog, mn.name) && vkey != mn.name && cg_is_class_named(prog, vkey) && cg_subclass_reaches(prog, vkey, mn.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
        _ => false
    }
}

fn cg_var_reaches(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, depth - 1) { return true }
        }
        if cg_member_reached_via_subclass(prog, mt, vkey) { return true }
        i++
    }
    false
}

fn cg_var_reaches_exact(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches_exact(prog, mt, vkey, depth - 1) { return true }
        }
        i++
    }
    false
}

fn cg_narrow_variant_widens_into(prog: CgProg, from: @Type(), to: @Type()): bool {
    if !cg_is_variant_type(prog, to) { return false }
    var n = cg_var_nmem(prog, from)
    if n == 0 { return false }
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, from, i) { str as s => s; error => return false }
        if !cg_var_reaches(prog, to, mk, 16) { return false }
        i++
    }
    true
}

fn cg_wrap_open(buf: Cb, v: @Type(), mkey: str): Cb | error {
    match v {
        checker::Variant as va => {
            var out = cb(buf, "(")
            out = match cg_variant_typename(out, va) { Cb as o => o; error as err => return err }
            out = cb(out, "){ .tag = TK_TAG_U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                out = cb(out, "_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => return err }
                out = cb_upper(out, kj)
                j++
            }
            out = cb(out, "_")
            out = cb_upper(out, mkey)
            out = cb(out, ", .as.")
            out = cb_str(out, mkey)
            return cb(out, " = ")
        }
        checker::Named as nm => {
            var out = cb(buf, "(")
            out = mangle_type_name(out, "", nm.name)
            out = cb(out, "){ .tag = TK_TAG_")
            out = cb_upper(out, cg_ns_c_key(nm.name))
            out = cb(out, "_")
            out = cb_upper(out, mkey)
            out = cb(out, ", .as.")
            out = cb_str(out, mkey)
            return cb(out, " = ")
        }
        _ => error { message = "codegen: cg_wrap_open on a non-variant type (internal)" }
    }
}

fn emit_variant_wrap(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => return cb(buf, "0")
                    _ => {
                        if cg_mangle_eq(expected, value.type) { return emit_expr_ret(buf, prog, ret_type, value) }
                        return cg_emit_box_construct(buf, prog, ret_type, bx, value, "", escaping, regions, fn_body, dctx)
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    match emit_variant_wrap_exact_pass(buf, prog, ret_type, expected, value, vkey, n) {
        Cb as o => return o
        error as e => return e
        null => { }
    }
    match emit_variant_wrap_widen_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) {
        Cb as o => return o
        error as e => return e
        null => { }
    }
    match emit_variant_wrap_transitive_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) {
        Cb as o => return o
        error as e => return e
        null => { }
    }
    error { message = "codegen: emit_variant_wrap on an unreachable case (internal — caller must guard with cg_var_reaches)" }
}

fn emit_variant_wrap_exact_pass(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64): Cb | null | error {
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var out = match cg_wrap_open(buf, expected, vkey) { Cb as o => o; error as err => return err }
            out = match emit_expr_ret(out, prog, ret_type, value) { Cb as o => o; error as err => return err }
            return cb(out, " }")
        }
        i++
    }
    null
}

fn emit_variant_wrap_widen_pass(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | null | error {
    var w = 0
    loop {
        if w >= n { break }
        var wmt = cg_var_mtype(prog, expected, w)
        if cg_member_reached_via_subclass(prog, wmt, vkey) {
            var wmk = match cg_var_mkey(prog, expected, w) { str as s => s; error => "" }
            var sout = match cg_wrap_open(buf, expected, wmk) { Cb as o => o; error as err => return err }
            sout = match emit_as_r(sout, prog, ret_type, wmt, value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            return cb(sout, " }")
        }
        w++
    }
    null
}

fn emit_variant_wrap_transitive_pass(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | null | error {
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var out = match cg_wrap_open(buf, expected, mk) { Cb as o => o; error as err => return err }
                out = match emit_variant_wrap(out, prog, ret_type, mt, value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                return cb(out, " }")
            }
        }
        j++
    }
    null
}

fn emit_variant_wrap_str(buf: Cb, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str): Cb | error {
    var vkey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var out = match cg_wrap_open(buf, expected, vkey) { Cb as o => o; error as err => return err }
            out = cb(out, cexpr)
            return cb(out, " }")
        }
        i++
    }
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var out = match cg_wrap_open(buf, expected, mk) { Cb as o => o; error as err => return err }
                out = match emit_variant_wrap_str(out, prog, mt, vtype, cexpr) { Cb as o => o; error as err => return err }
                return cb(out, " }")
            }
        }
        j++
    }
    error { message = "codegen: emit_variant_wrap_str on an unreachable case (internal — caller must guard with cg_var_reaches)" }
}

fn cg_emit_union_present_str(buf: Cb, prog: CgProg, uni: @Type(), mem: @Type(), cexpr: str): Cb | error {
    var va = match uni { checker::Variant as v => v; _ => return cb(buf, cexpr) }
    match cg_union_niche_member(prog, va) {
        (@Type()) as _gt9 => return cb(buf, cexpr)
        null => { }
    }
    emit_variant_wrap_str(buf, prog, uni, mem, cexpr)
}

fn cg_emit_ffi_ures(buf: Cb, prog: CgProg, result_ty: @Type(), ures_tmp: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var nulllit = checker::TExpr { kind = checker::TNullLit { }; type = result_ty; line = 0; col = 0 }
    var o = cb(buf, ures_tmp)
    o = cb(o, ".ok ? ")
    o = match emit_as_r(o, prog, result_ty, result_ty, nulllit, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
    o = cb(o, " : ")
    var errcexpr = teko::str::concat("tk_error_make(", ures_tmp, ".err)")
    cg_emit_union_present_str(o, prog, result_ty, checker::Error { }, errcexpr)
}

fn cg_wrap_elem_str(buf: Cb, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str): Cb | error {
    match expected {
        checker::Named as en => match cg_wrap_elem_str_contract(buf, prog, en, vtype, cexpr) {
            Cb as o => return o
            null => { }
            error as e => return e
        }
        _ => { }
    }
    var ukey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var wrappable = match expected {
        checker::Variant => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        checker::Named => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        _ => false
    }
    if wrappable {
        return emit_variant_wrap_str(buf, prog, expected, vtype, cexpr)
    }
    cb(buf, cexpr)
}

fn cg_wrap_elem_str_contract(buf: Cb, prog: CgProg, en: checker::Named, vtype: @Type(), cexpr: str): Cb | null | error {
    if !(cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name)) { return null }
    match vtype {
        checker::Named as vn => {
            if !cg_is_class_named(prog, vn.name) { return null }
            var o = cb(buf, "(")
            o = mangle_type_name(o, "", en.name)
            o = cb(o, "){ .data = (void *)(")
            o = cb(o, cexpr)
            o = cb(o, "), .vtable = tk_vt_")
            o = cb_tysym(o, vn.name)
            o = cb(o, "_")
            o = cb_tysym(o, en.name)
            cb(o, " }")
        }
        _ => null
    }
}

fn emit_host_ffi(buf: Cb, prog: CgProg, e: checker::TExpr, c: checker::TCall, kind: str, rtfn: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var t = $"_h{buf.len}"
    var str_t = checker::Str { }
    var err_t = checker::Error { }

    if kind == "args" {
        var o = cb(buf, "({ uint64_t ")
        o = cb(o, t)
        o = cb(o, "n; tk_str *")
        o = cb(o, t)
        o = cb(o, "p = ")
        o = cb(o, rtfn)
        o = cb(o, "(&")
        o = cb(o, t)
        o = cb(o, "n); (")
        o = match cg_slice_typename(o, str_t) { Cb as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, "p, .len = ")
        o = cb(o, t)
        return cb(o, "n }; })")
    }
    if kind == "bytes" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ tk_ffi_bytes ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, ", ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, "); (")
        o = match cg_slice_typename(o, byte_t) { Cb as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, ".ptr, .len = ")
        o = cb(o, t)
        return cb(o, ".len }; })")
    }
    if kind == "run" {
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, str_t) { Cb as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, "; ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, ".ptr, ")
        o = cb(o, t)
        return cb(o, ".len); })")
    }

    if kind == "ures_byteslice" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { Cb as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_ures ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, ", ")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = match cg_emit_ffi_ures(o, prog, e.type, teko::str::concat(t, "r"), escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        return cb(o, "; })")
    }

    if kind == "sres_byteslice" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { Cb as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_sres ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = cb(o, t)
        o = cb(o, "r.ok ? ")
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}r.value") { Cb as r => r; error as err => return err }
        o = cb(o, " : ")
        o = match emit_variant_wrap_str(o, prog, e.type, err_t, teko::str::concat("tk_error_make(", $"{t}r", ".err)")) { Cb as r => r; error as err => return err }
        return cb(o, "; })")
    }

    var resty = if kind == "sres" { "tk_ffi_sres" } else if kind == "ures" { "tk_ffi_ures" } else if kind == "slres" { "tk_ffi_slres" } else { "tk_ffi_u64res" }
    var o = cb(buf, "({ ")
    o = cb(o, resty)
    o = cb(o, " ")
    o = cb(o, t)
    o = cb(o, " = ")
    o = cb(o, rtfn)
    o = cb(o, "(")
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { o = cb(o, ", ") }
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        i++
    }
    o = cb(o, "); ")

    if kind == "ures" {
        o = match cg_emit_ffi_ures(o, prog, e.type, t, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
        return cb(o, "; })")
    }

    o = cb(o, t)
    o = cb(o, ".ok ? ")
    if kind == "sres" {
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}.value") { Cb as r => r; error as err => return err }
    } else if kind == "u64res" {
        o = match emit_variant_wrap_str(o, prog, e.type, checker::Prim { kind = checker::PrimKind::U64 }, $"{t}.value") { Cb as r => r; error as err => return err }
    } else {
        var slice_t = checker::Slice { element = checker::Str { } }
        var sx = teko::str::concat("(tk_slice_str){ .ptr = ", t, teko::str::concat(".ptr, .len = ", t, ".len }"))
        o = match emit_variant_wrap_str(o, prog, e.type, slice_t, sx) { Cb as r => r; error as err => return err }
    }
    o = cb(o, " : ")
    var eexpr = if kind == "u64res" { "tk_error_make((tk_str){0})" } else { teko::str::concat("tk_error_make(", t, ".err)") }
    o = match emit_variant_wrap_str(o, prog, e.type, err_t, eexpr) { Cb as r => r; error as err => return err }
    return cb(o, "; })")
}

fn cg_mangle_eq(a: @Type(), b: @Type()): bool {
    var ea = cg_mangle_errors(a)
    var eb = cg_mangle_errors(b)
    if ea || eb { return ea && eb }
    cg_mangle_bytes_eq(a, b)
}

fn cg_mangle_errors(t: @Type()): bool {
    match t {
        checker::Prim => false
        checker::Byte => false
        checker::Char => false
        checker::Str => false
        checker::Error => false
        checker::Named => false
        checker::Slice as sl => match sl.element {
            checker::Void => true
            _ => cg_mangle_errors(sl.element)
        }
        _ => true
    }
}

fn cg_mangle_bytes_eq(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => cg_mangle_type_matches_name(b, na.name)
        checker::Slice as sa => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice as sb => cg_mangle_bytes_eq(sa.element, sb.element)
            _ => false
        }
        _ => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice => false
            _ => cg_leaf_literal_eq(a, b)
        }
    }
}

fn cg_leaf_literal_eq(a: @Type(), b: @Type()): bool {
    match cg_opt_mangle_str(a) {
        str as sa => match cg_opt_mangle_str(b) { str as sb => sa == sb; error => false }
        error => false
    }
}

fn cg_mangle_type_matches_name(t: @Type(), name: str): bool {
    var start = cg_name_last_segment_offset(name)
    var end = cg_mangle_consume(t, name, start)
    end >= 0 && (end to u64) == name.len
}

fn cg_mangle_consume(t: @Type(), name: str, off: u64): i64 {
    match t {
        checker::Slice as sl => {
            var o2 = cg_match_literal(name, off, "slice_")
            if o2 < 0 { -1 } else { cg_mangle_consume(sl.element, name, o2 to u64) }
        }
        checker::Named as nm => cg_match_segment(name, off, nm.name)
        _ => match cg_opt_mangle_str(t) {
            str as lit => cg_match_literal(name, off, lit)
            error => -1
        }
    }
}

fn cg_match_literal(name: str, off: u64, lit: str): i64 {
    if off + lit.len > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= lit.len { break }
        if name[off + i] != lit[i] { return -1 }
        i++
    }
    (off + lit.len) to i64
}

fn cg_match_segment(name: str, off: u64, other: str): i64 {
    var s = cg_name_last_segment_offset(other)
    var seglen = other.len - s
    if off + seglen > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= seglen { break }
        if name[off + i] != other[s + i] { return -1 }
        i++
    }
    (off + seglen) to i64
}

fn cg_name_last_segment_offset(name: str): u64 {
    var last_sep: i64 = -1
    var i: u64 = 0
    loop {
        if i + 1 >= name.len { break }
        if name[i] == b':' && name[i + 1] == b':' { last_sep = i to i64 }
        i++
    }
    if last_sep < 0 { 0 } else { (last_sep to u64) + 2 }
}

fn emit_as(buf: Cb, prog: CgProg, expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    emit_as_r(buf, prog, checker::Void { }, expected, value, escaping, regions, fn_body, dctx)
}

fn cg_slice_param_type(prog: CgProg, slt: parser::SliceType, arg_type: @Type()): @Type() {
    match slt.element {
        parser::NamedType as nt => checker::Slice { element = checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) } }
        _ => arg_type
    }
}

fn cg_emit_inline_null(buf: Cb, expected: @Type()): Cb | error {
    var o = match cg_wrap_open(buf, expected, "null") { Cb as r => r; error as e => return e }
    cb(o, "0 }")
}

fn cg_value_already_boxed(prog: CgProg, bx: @Type(), vt: @Type()): bool {
    match vt {
        checker::Variant as vv => match cg_union_box_member(prog, vv) {
            (@Type()) as vbx => cg_mangle_eq(bx, vbx)
            null => false
        }
        _ => false
    }
}

fn cg_emit_box_construct(buf: Cb, prog: CgProg, ret_type: @Type(), inner: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var bxN = fresh_named("_ubx", buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, inner) { Cb as o => o; error as e => return e }
    out = cb(out, " *")
    out = cb(out, bxN)
    out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc)); out = cb(out, "(")
    out = cb(out, if box_region.len > 0 { box_region } else { teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()") })
    out = cb(out, ", sizeof(")
    out = match emit_type(out, prog, inner) { Cb as o => o; error as e => return e }
    out = cb(out, ")); *")
    out = cb(out, bxN)
    out = cb(out, " = ")
    out = match emit_as_r_in(out, prog, ret_type, inner, value, box_region, escaping, regions, fn_body, dctx) { Cb as o => o; error as e => return e }
    out = cb(out, "; ")
    out = cb(out, bxN)
    cb(out, "; })")
}

fn emit_as_r(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    emit_as_r_in(buf, prog, ret_type, expected, value, "", escaping, regions, fn_body, dctx)
}

fn emit_as_r_in(buf: Cb, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if cg_is_bytes_str_reinterpret(expected, value.type) {
        var reint = checker::TExpr { kind = checker::TCast { expr = value }; type = expected; line = value.line; col = value.col }
        return emit_bytes_str_reinterpret(buf, prog, reint, value, escaping, regions, fn_body, dctx)
    }
    match expected {
        checker::Reference => {
            match value.type {
                checker::Reference => return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                _ => {
                    var o = cb(buf, "&")
                    return emit_expr_ctx(o, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match value.kind {
                    checker::TNullLit => return cg_emit_niche_null(buf, prog, nx)
                    _ => return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => return cb(buf, "0")
                    _ => {
                        if cg_value_already_boxed(prog, bx, value.type) { return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx) }
                        return cg_emit_box_construct(buf, prog, ret_type, bx, value, box_region, escaping, regions, fn_body, dctx)
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as iva => match value.kind {
            checker::TNullLit => if cg_variant_has_null(iva) { return cg_emit_inline_null(buf, expected) }
            _ => { }
        }
        _ => { }
    }
    match expected {
        checker::Slice as sexp => {
            match sexp.element {
                checker::Void => { }
                _ => {
                    var val_sentinel = match value.type {
                        checker::Slice as svt => match svt.element { checker::Void => true; _ => false }
                        _ => false
                    }
                    if val_sentinel {
                        var so = cb(buf, "(")
                        so = match cg_slice_typename(so, sexp.element) { Cb as o => o; error as err => return err }
                        return cb(so, "){ .ptr = 0, .len = 0 }")
                    }
                    var concrete_diff = match value.type {
                        checker::Slice as svt => match svt.element {
                            checker::Void => false
                            _ => !cg_mangle_eq(sexp.element, svt.element)
                        }
                        _ => false
                    }
                    if concrete_diff {
                        var elemU = match value.type { checker::Slice as svt => svt.element; _ => checker::Void { } }
                        var T = sexp.element
                        var U = elemU
                        var baseN = buf.len to i64
                        var sv = fresh_named("_cv", baseN)
                        var rp = fresh_named("_cp", baseN + 1)
                        var ri = fresh_named("_ci", baseN + 2)
                        var o = cb(buf, "({ ")
                        o = match cg_slice_typename(o, U) { Cb as r => r; error as err => return err }
                        o = cb(o, " "); o = cb(o, sv); o = cb(o, " = ")
                        o = match emit_expr_ctx(o, prog, ret_type, value, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
                        o = cb(o, "; ")
                        o = match emit_type(o, prog, T) { Cb as r => r; error as err => return err }
                        o = cb(o, " *"); o = cb(o, rp); o = cb(o, " = (")
                        o = match emit_type(o, prog, T) { Cb as r => r; error as err => return err }
                        o = cb(o, " *)malloc("); o = cb(o, sv); o = cb(o, ".len * sizeof(")
                        o = match emit_type(o, prog, T) { Cb as r => r; error as err => return err }
                        o = cb(o, ")); if ("); o = cb(o, rp); o = cb(o, " == 0 && "); o = cb(o, sv); o = cb(o, ".len) abort(); ")
                        o = cb(o, "for (uint64_t "); o = cb(o, ri); o = cb(o, " = 0; "); o = cb(o, ri); o = cb(o, " < "); o = cb(o, sv); o = cb(o, ".len; "); o = cb(o, ri); o = cb(o, " += 1) { ")
                        o = cb(o, rp); o = cb(o, "["); o = cb(o, ri); o = cb(o, "] = ")
                        var elem = teko::str::concat(sv, teko::str::concat(".ptr[", teko::str::concat(ri, "]")))
                        o = match cg_wrap_elem_str(o, prog, T, U, elem) { Cb as r => r; error as err => return err }
                        o = cb(o, "; } (")
                        o = match cg_slice_typename(o, T) { Cb as r => r; error as err => return err }
                        o = cb(o, "){ .ptr = "); o = cb(o, rp); o = cb(o, ", .len = "); o = cb(o, sv); o = cb(o, ".len }; })")
                        return o
                    }
                    return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Named as en => {
            if cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name) {
                match value.type {
                    checker::Named as vn => {
                        if cg_is_class_named(prog, vn.name) {
                            var io = cb(buf, "(")
                            io = mangle_type_name(io, "", en.name)
                            io = cb(io, "){ .data = ")
                            if cg_is_polymorphic_base(prog, vn.name) {
                                io = cb(io, "(")
                                io = match emit_expr_ctx(io, prog, ret_type, value, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
                                io = cb(io, ").data")
                            } else {
                                io = cb(io, "(void *)(")
                                io = match emit_expr_ctx(io, prog, ret_type, value, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
                                io = cb(io, ")")
                            }
                            io = cb(io, ", .vtable = tk_vt_")
                            io = cb_tysym(io, vn.name)
                            io = cb(io, "_")
                            io = cb_tysym(io, en.name)
                            return cb(io, " }")
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Named as ben => {
            if cg_is_polymorphic_base(prog, ben.name) {
                match value.type {
                    checker::Named as bvn => {
                        if cg_is_class_named(prog, bvn.name) {
                            var is_strict_sub = bvn.name != ben.name && cg_subclass_reaches(prog, bvn.name, ben.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
                            var is_raw_self = bvn.name == ben.name && match value.kind { checker::TStructInit => true; _ => false }
                            if is_strict_sub || is_raw_self {
                                var bo = cb_tysym(cb(buf, "(tk_base_"), ben.name)
                                bo = cb(bo, "){ .data = (void *)(")
                                bo = match emit_expr_ctx(bo, prog, ret_type, value, escaping, regions, fn_body, dctx) { Cb as r => r; error as err => return err }
                                bo = cb_tysym(cb(cb_tysym(cb(bo, "), .vtable = tk_vt_"), bvn.name), "_"), ben.name)
                                return cb(bo, " }")
                            }
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    var vt_is_variant = match value.type { checker::Variant => true; checker::Named as vn => cg_named_is_variant(prog, vn.name); _ => false }
    if vt_is_variant && !cg_mangle_eq(value.type, expected) && cg_narrow_variant_widens_into(prog, value.type, expected) {
        var widened = checker::TExpr { kind = value.kind; type = expected; line = value.line; col = value.col }
        match value.kind {
            checker::TIfExpr as f => return emit_if_value(buf, prog, ret_type, widened, f, escaping, regions, fn_body, dctx)
            checker::TMatchExpr as m => return emit_match_value(buf, prog, ret_type, widened, m, escaping, regions, fn_body, dctx)
            _ => { }
        }
    }
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    if vkey == "" { return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx) }
    var is_variant_slot = match expected { checker::Variant => true; checker::Named => true; _ => false }
    if is_variant_slot {
        if cg_var_reaches(prog, expected, vkey, 16) {
            return emit_variant_wrap(buf, prog, ret_type, expected, value, escaping, regions, fn_body, dctx)
        }
    }
    emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
}

fn cg_emit_lit_pattern(buf: Cb, lit: parser::Expr): Cb | error {
    match lit.kind {
        parser::Number as n => {
            if n.is_float { return cb_f64_literal(buf, n.fval) }
            cb_numint(buf, n.value)
        }
        parser::ByteLit as b => cb_i64(buf, b.value to i64)
        parser::StrLit as sl => {
            var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
            out = cb_cstr_escaped(out, sl.text)
            out = cb(out, "\", ")
            out = cb_i64(out, sl.text.len to i64)
            cb(out, " }")
        }
        _ => error { message = "codegen: unsupported literal in a pattern (parser emits only number/byte/str)" }
    }
}

fn cg_emit_tag_prefix(buf: Cb, variantT: @Type()): Cb | error {
    var out = cb(buf, "TK_TAG_")
    match variantT {
        checker::Variant as va => {
            out = cb(out, "U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                out = cb(out, "_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => return err }
                out = cb_upper(out, kj)
                j++
            }
            cb(out, "_")
        }
        checker::Named as nm => { out = cb_upper(out, cg_ns_c_key(nm.name)); cb(out, "_") }
        _ => error { message = "codegen: tag prefix over a non-variant subject (internal)" }
    }
}

fn cg_emit_case_key_str(pat: @Pattern()): str | error {
    match pat {
        parser::BindPattern as bp => {
            if bp.is_slice {
                match bp.slice_type {
                    null => error { message = "codegen: slice pattern without a slice type (internal)" }
                    (@TypeExpr()) as st => cg_member_key_texpr_bare_str(st)
                }
            } else if bp.type_args.len > 0 {
                cg_case_name_escaped(cg_texpr_inst_name(cg_path_last(bp.type_name), bp.type_args))
            } else { cg_case_name_escaped(cg_path_last(bp.type_name)) }
        }
        parser::FieldPattern as fp => cg_case_name_escaped(cg_path_last(fp.type_name))
        parser::GroupBindPattern as gp => cg_group_case_key(gp)
        _ => error { message = "codegen: case key over a non-bind/field pattern (internal)" }
    }
}

fn cg_group_case_key(gp: parser::GroupBindPattern): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= gp.options.len { break }
        var k = match cg_emit_case_key_str(gp.options[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

fn cg_case_name_escaped(name: str): str {
    if cg_is_c_keyword(name) { teko::str::concat(name, "_") } else { name }
}

fn emit_pat_test(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, variantT: @Type()): Cb | error {
    match pat {
        parser::WildcardPattern => cb(buf, "1")
        parser::LiteralPattern as lp => {
            var is_str_lit = match lp.value.kind { parser::StrLit => true; _ => false }
            if is_str_lit {
                var out = cb(buf, "tk_str_eq(")
                out = cb(out, subj)
                out = cb(out, ", ")
                out = match cg_emit_lit_pattern(out, lp.value) { Cb as o => o; error as err => return err }
                return cb(out, ")")
            }
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, " == ")
            out = match cg_emit_lit_pattern(out, lp.value) { Cb as o => o; error as err => return err }
            cb(out, ")")
        }
        parser::RangePattern as rp => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, " >= ")
            out = match cg_emit_lit_pattern(out, rp.lo) { Cb as o => o; error as err => return err }
            out = cb(out, " && ")
            out = cb(out, subj)
            out = cb(out, " <= ")
            out = match cg_emit_lit_pattern(out, rp.hi) { Cb as o => o; error as err => return err }
            cb(out, ")")
        }
        parser::AltPattern as ap => {
            var out = cb(buf, "(")
            var i = 0
            loop {
                if i >= ap.options.len { break }
                if i > 0 { out = cb(out, " || ") }
                out = match emit_pat_test(out, prog, ap.options[i], subj, variantT) { Cb as o => o; error as err => return err }
                i++
            }
            cb(out, ")")
        }
        parser::BindPattern as bp0 => {
            var bind_whole = match variantT {
                checker::Named as nm => (!bp0.is_slice) && (cg_path_last(bp0.type_name) == checker::name_last_segment(nm.name))
                _ => false
            }
            if bind_whole { return cb(buf, "1") }
            var is_enum = match variantT { checker::Named as nm => cg_named_is_enum(prog, nm.name); _ => false }
            if is_enum {
                var ename = match variantT { checker::Named as nm => checker::name_last_segment(nm.name); _ => "" }
                var oe = cb(buf, "(")
                oe = cb(oe, subj)
                oe = cb(oe, " == TK_E_")
                oe = cb_upper(oe, ename)
                oe = cb(oe, "_")
                var cke = match cg_emit_case_key_str(pat) { str as s => s; error as err => return err }
                oe = cb_upper(oe, cke)
                return cb(oe, ")")
            }
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { Cb as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::FieldPattern => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { Cb as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::NullPattern => {
            if cg_var_reaches(prog, variantT, "null", 16) {
                var out = cb(buf, "(")
                out = cb(out, subj)
                out = cb(out, ".tag == ")
                out = match cg_emit_tag_prefix(out, variantT) { Cb as o => o; error as err => return err }
                out = cb_upper(out, "null")
                return cb(out, ")")
            }
            error { message = "codegen: `null` pattern over a non-optional subject (internal)" }
        }
        parser::GroupBindPattern => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { Cb as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::MacroPattern => error { message = "internal: an unexpanded @Type() macro reached codegen — it should be expanded by the Family-A pre-pass" }
    }
}

type CgKindDescend = struct { var_type: @Type(); boxed: bool }

fn cg_kind_descend(prog: CgProg, subjT: @Type(), pat: @Pattern()): CgKindDescend | null {
    var sname = match subjT { checker::Named as nm => nm.name; _ => return null }
    match pat {
        parser::BindPattern => { }
        parser::FieldPattern => { }
        _ => return null
    }
    var d = match cg_find_decl(prog, sname) { parser::TypeDecl as dd => dd; error => return null }
    var sb = match d.body { parser::StructBody as s => s; _ => return null }
    var kfte: @TypeExpr() | null = null
    var i = 0
    loop {
        if i >= sb.fields.len { break }
        if sb.fields[i].name == "kind" { kfte = sb.fields[i].type_ann; break }
        i++
    }
    var fte = match kfte { null => return null; (@TypeExpr()) as t => t }
    var vname = match fte { parser::NamedType as nt => cg_canon_name(prog, cg_path_last(nt.path)); _ => return null }
    if !cg_named_is_variant(prog, vname) { return null }
    var v = checker::Named { name = vname }
    var key = match cg_case_key_qualified(prog, v, pat) { str as s => s; error => return null }
    if !cg_var_reaches(prog, v, key, 2) { return null }
    CgKindDescend { var_type = v; boxed = cg_field_boxed(prog, sname, fte) }
}

fn cg_kind_derived_subj(subj: str, boxed: bool): str {
    var o: Cb = cb_new()
    if boxed { o = cb(o, "(*") }
    o = cb(o, "(")
    o = cb(o, subj)
    o = cb(o, ").kind")
    if boxed { o = cb(o, ")") }
    str(cb_flat(o))
}

fn cg_fatptr_subject_name(prog: CgProg, subjT: @Type()): str | null {
    match subjT {
        checker::Named as nm => {
            if cg_is_polymorphic_base(prog, nm.name) || cg_is_interface_named(prog, nm.name) || cg_is_trait_named(prog, nm.name) { return nm.name }
            null
        }
        _ => null
    }
}

fn cg_emit_fatptr_pat_test(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, subjname: str): Cb | error {
    match pat {
        parser::WildcardPattern => cb(buf, "1")
        parser::BindPattern as bp => {
            if bp.is_slice { return error { message = "codegen: a slice pattern cannot discriminate a class/interface subject (internal)" } }
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) { return cb(buf, "1") }
            var canon = cg_canon_name(prog, sub_last)
            var o = cb(buf, "((")
            o = cb(o, subj)
            o = cb(o, ").vtable == tk_vt_")
            o = cb_tysym(o, canon)
            o = cb(o, "_")
            o = cb_tysym(o, subjname)
            cb(o, ")")
        }
        _ => error { message = "codegen: unsupported pattern over a class/interface subject (internal)" }
    }
}

fn cg_emit_fatptr_pat_binds(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, subjname: str, indent: str): Cb | error {
    match pat {
        parser::BindPattern as bp => {
            if !bp.has_binding { return buf }
            var o = cb(buf, indent)
            o = cb(o, "auto ")
            o = cb_str(o, bp.binding)
            o = cb(o, " = ")
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) {
                o = cb(o, subj)
                return cb(o, ";\n")
            }
            var canon = cg_canon_name(prog, sub_last)
            o = cb(o, "(")
            o = mangle_type_name(o, "", canon)
            o = cb(o, " *)((")
            o = cb(o, subj)
            cb(o, ").data);\n")
        }
        _ => buf
    }
}

fn cg_emit_pat_test(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type()): Cb | error {
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            return cg_emit_pat_test(buf, prog, pat, ds, kd.var_type)
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match pat {
                    parser::NullPattern => return cg_emit_niche_is_null(buf, subj, nx)
                    parser::WildcardPattern => return cb(buf, "1")
                    parser::BindPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    parser::FieldPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    parser::GroupBindPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt10 => {
                match pat {
                    parser::NullPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " == 0)") }
                    parser::WildcardPattern => return cb(buf, "1")
                    parser::BindPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    parser::FieldPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    parser::GroupBindPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => return cg_emit_fatptr_pat_test(buf, prog, pat, subj, sname)
        null => { }
    }
    emit_pat_test(buf, prog, pat, subj, subjT)
}

fn emit_pat_binds(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str): Cb | error {
    match pat {
        parser::BindPattern as bp => {
            if bp.has_binding {
                var out = cb(buf, indent)
                out = cb(out, "auto ")
                out = cb_str(out, bp.binding)
                out = cb(out, " = ")
                out = cb(out, subj)
                out = cb(out, ".as.")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
                out = cb_str(out, ck)
                cb(out, ";\n")
            } else { buf }
        }
        parser::FieldPattern as fp => {
            var out = buf
            var i = 0
            loop {
                if i >= fp.fields.len { break }
                out = cb(out, indent)
                out = cb(out, "auto ")
                out = cb_str(out, fp.fields[i])
                out = cb(out, " = ")
                out = cb(out, subj)
                out = cb(out, ".as.")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
                out = cb_str(out, ck)
                out = cb(out, ".")
                out = cb_str(out, fp.fields[i])
                out = cb(out, ";\n")
                i++
            }
            out
        }
        parser::GroupBindPattern as gp => {
            var out = cb(buf, indent)
            out = cb(out, "auto ")
            out = cb_str(out, gp.binding)
            out = cb(out, " = ")
            out = cb(out, subj)
            out = cb(out, ".as.")
            var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
            out = cb_str(out, ck)
            cb(out, ";\n")
        }
        _ => buf
    }
}

fn cg_emit_pat_binds(buf: Cb, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str): Cb | error {
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            return cg_emit_pat_binds(buf, prog, pat, ds, kd.var_type, indent)
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as _gt11 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            var o = cb(buf, indent)
                            o = cb(o, "auto ")
                            o = cb_str(o, nbp.binding)
                            o = cb(o, " = ")
                            o = cb(o, subj)
                            return cb(o, ";\n")
                        }
                        return buf
                    }
                    parser::GroupBindPattern as ngp => {
                        var o = cb(buf, indent)
                        o = cb(o, "auto ")
                        o = cb_str(o, ngp.binding)
                        o = cb(o, " = ")
                        o = cb(o, subj)
                        return cb(o, ";\n")
                    }
                    _ => return buf
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt12 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            var o = cb(buf, indent)
                            o = cb(o, "auto ")
                            o = cb_str(o, nbp.binding)
                            o = cb(o, " = (*(")
                            o = cb(o, subj)
                            return cb(o, "));\n")
                        }
                        return buf
                    }
                    parser::GroupBindPattern as bgp => {
                        var o = cb(buf, indent)
                        o = cb(o, "auto ")
                        o = cb_str(o, bgp.binding)
                        o = cb(o, " = (*(")
                        o = cb(o, subj)
                        return cb(o, "));\n")
                    }
                    _ => return buf
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => return cg_emit_fatptr_pat_binds(buf, prog, pat, subj, sname, indent)
        null => { }
    }
    match pat {
        parser::BindPattern as bp => {
            var bind_whole = match subjT {
                checker::Named as nm => (!bp.is_slice) && (cg_path_last(bp.type_name) == checker::name_last_segment(nm.name))
                _ => false
            }
            if bind_whole {
                if bp.has_binding {
                    var o = cb(buf, indent); o = cb(o, "auto "); o = cb_str(o, bp.binding)
                    o = cb(o, " = "); o = cb(o, subj); return cb(o, ";\n")
                }
                return buf
            }
        }
        _ => { }
    }
    emit_pat_binds(buf, prog, pat, subj, subjT, indent)
}

fn cg_block_diverges(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && cg_block_diverges(f.then_blk) && cg_block_diverges(f.else_blk)
            checker::TMatchExpr as m => {
                if m.arms.len == 0 { return false }
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if !cg_block_diverges(m.arms[i].body) { return false }
                    i++
                }
                true
            }
            _ => false
        }
        _ => false
    }
}

fn cg_block_diverges_jump(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && (cg_block_diverges_jump(f.then_blk) || cg_block_diverges_jump(f.else_blk))
            checker::TMatchExpr as m => {
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if cg_block_diverges_jump(m.arms[i].body) { return true }
                    i++
                }
                false
            }
            _ => false
        }
        _ => false
    }
}

fn emit_arm_value(buf: Cb, prog: CgProg, ret_type: @Type(), match_e: checker::TExpr, body: []@TStatement(), sink: str, ci: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if cg_block_diverges_jump(body) {
        return error { message = "codegen: break/continue inside a `match` used as a sub-expression not yet supported" }
    }
    if cg_block_diverges(body) {
        var out = buf
        var cur = dctx
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false) { Cb as o => o; error as err => return err } }
            }
            i++
        }
        var last = body[body.len - 1]
        return match last {
            checker::TExprStmt as es => match es.expr.kind {
                checker::TIfExpr as _ => emit_exprstmt_tail(out, es.expr, false, prog, ret_type, ci, "", escaping, fn_body, cur)
                checker::TMatchExpr as _ => emit_exprstmt_tail(out, es.expr, false, prog, ret_type, ci, "", escaping, fn_body, cur)
                _ => emit_stmt(out, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false)
            }
            _ => emit_stmt(out, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false)
        }
    }
    var defer_floor = dctx.defers.len
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64
    var region = if want_block { fresh_named("_tkbr", buf.len to i64) } else { "" }
    var regs2 = if want_block { teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true) }) } else { regions }
    var cur_blk = if want_block { body } else { teko::list::empty() }
    var out = buf
    if want_block {
        out = cb(out, ci); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "("); out = cb(out, cg_enclosing_region_expr(regions)); out = cb(out, ");\n")
    }
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, ci, "", escaping, regs2, fn_body, cur, cur_blk, want_block) { Cb as o => o; error as err => return err } }
        }
        i++
    }
    if body.len == 0 { return error { message = "codegen: empty match arm body in value position" } }
    var fall = cg_append_direct_defers(dctx.defers, body)
    var last = body[body.len - 1]
    match last {
        checker::TExprStmt as es => {
            out = emit_cov_lines(out, dctx.cov, cov_collect_expr(es.expr, teko::list::empty()), ci)
            out = cb(out, ci)
            out = cb(out, sink)
            out = cb(out, " = (")
            if cg_expr_diverges(es.expr) {
                out = match emit_expr_ctx(out, prog, checker::Void { }, es.expr, escaping, regs2, fn_body, cur) { Cb as o => o; error as err => return err }
                out = cb(out, ", (")
                out = match emit_type(out, prog, match_e.type) { Cb as o => o; error as err => return err }
                out = cb(out, "){0}")
            } else {
                out = match emit_as_r(out, prog, ret_type, match_e.type, es.expr, escaping, regs2, fn_body, cur) { Cb as o => o; error as err => return err }
            }
            out = cb(out, ");")
            if want_block {
                if fall.len > defer_floor {
                    out = cb(out, "\n")
                    out = match emit_defers(out, fall, defer_floor, prog, ci, escaping, fn_body) { Cb as o => o; error as err => return err }
                    out = cb(out, ci); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;")
                } else {
                    out = cb(out, " "); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;")
                }
                cb(out, " break;\n")
            } else if fall.len > defer_floor {
                out = cb(out, "\n")
                out = match emit_defers(out, fall, defer_floor, prog, ci, escaping, fn_body) { Cb as o => o; error as err => return err }
                out = cb(out, ci); out = cb(out, "break;\n")
                out
            } else {
                cb(out, " break;\n")
            }
        }
        _ => error { message = "codegen: non-value trailing statement in a match arm used as a value" }
    }
}

fn emit_match_value(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, m: checker::TMatchExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var subj = fresh_named("_s", buf.len to i64)
    var res = fresh_named("_r", buf.len to i64 + 1)
    var subjT = m.subject.type
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, m.subject.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); ")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, res)
    out = cb(out, " = {0}; do {\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, "    if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { Cb as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, "        ") { Cb as o => o; error as err => return err }
        var ci = "        "
        if arm.has_when {
            out = cb(out, "        if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = "            "
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        out = match emit_arm_value(out, prog, ret_type, e, arm.body, res, ci, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        if arm.has_when { out = cb(out, "        }\n") }
        out = cb(out, "    }\n")
        i++
    }
    out = cb(out, "    } while (0); ")
    out = cb(out, res)
    cb(out, "; })")
}

fn emit_match_tail(buf: Cb, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var subj = fresh_named("_s", buf.len to i64)
    var done = teko::str::concat(fresh_named("tk_mt", buf.len to i64 + 1), "_done")
    var subjT = m.subject.type
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    out = cb(out, inner)
    out = match emit_type(out, prog, m.subject.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, inner)
        out = cb(out, "if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { Cb as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, inner2) { Cb as o => o; error as err => return err }
        var ci = inner2
        if arm.has_when {
            out = cb(out, inner2)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = cb_indent_deeper(inner2)
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        var tarm_base = dctx.defers.len
        out = match emit_block_tail(out, arm.body, in_main, prog, ret_type, ci, "", escaping, fn_body, dctx) { Cb as o => o; error as err => return err }
        var tarm_term = if arm.body.len > 0 { cg_stmt_c_terminates(arm.body[arm.body.len - 1]) } else { false }
        if !tarm_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, arm.body), tarm_base, prog, ci, escaping, fn_body) { Cb as o => o; error as err => return err } }
        out = cb(out, ci)
        out = cb(out, "goto ")
        out = cb(out, done)
        out = cb(out, ";\n")
        if arm.has_when { out = cb(out, inner2); out = cb(out, "}\n") }
        out = cb(out, inner)
        out = cb(out, "}\n")
        i++
    }
    out = cb(out, inner)
    out = cb(out, done)
    out = cb(out, ": ;\n")
    out = match emit_match_tail_fallthrough_return(out, prog, ret_type, in_main, inner) { Cb as o => o; error as err => return err }
    out = cb(out, indent)
    cb(out, "}\n")
}

fn emit_match_tail_fallthrough_return(buf: Cb, prog: CgProg, ret_type: @Type(), in_main: bool, inner: str): Cb | error {
    if in_main { return buf }
    if is_void_type(ret_type) { return buf }
    var out = cb(buf, inner)
    out = cb(out, "return (")
    out = match emit_type(out, prog, ret_type) { Cb as o => o; error as err => return err }
    cb(out, "){0};\n")
}

fn emit_match_stmt(buf: Cb, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    var subj = fresh_named("_s", buf.len to i64)
    var done = teko::str::concat(fresh_named("tk_m", buf.len to i64 + 1), "_done")
    var subjT = m.subject.type
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    out = cb(out, inner)
    out = match emit_type(out, prog, m.subject.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, inner)
        out = cb(out, "if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { Cb as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, inner2) { Cb as o => o; error as err => return err }
        var ci = inner2
        if arm.has_when {
            out = cb(out, inner2)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = cb_indent_deeper(inner2)
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        out = match emit_block_region(out, arm.body, in_main, prog, ret_type, ci, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        out = cb(out, ci)
        out = cb(out, "goto ")
        out = cb(out, done)
        out = cb(out, ";\n")
        if arm.has_when { out = cb(out, inner2); out = cb(out, "}\n") }
        out = cb(out, inner)
        out = cb(out, "}\n")
        i++
    }
    out = cb(out, inner)
    out = cb(out, done)
    out = cb(out, ": ;\n")
    out = cb(out, indent)
    cb(out, "}\n")
}

fn emit_number(buf: Cb, prog: CgProg, e: checker::TExpr, n: checker::TNumber): Cb | error {
    match e.type {
        checker::Byte => {
            var o = cb(buf, "((uint8_t)")
            o = cb_numint(o, n.value)
            return cb(o, ")")
        }
        _ => { }
    }
    match e.type {
        checker::Named as nm => {
            if cg_named_is_flags(prog, nm.name) {
                var o = cb(buf, "((")
                o = mangle_type_name(o, "", nm.name)
                o = cb(o, ")")
                o = cb_numint(o, n.value)
                return cb(o, ")")
            }
        }
        _ => { }
    }
    var k = match e.type {
        checker::Prim as p => p.kind
        _ => return error { message = "codegen: numeric literal with a non-primitive type not yet supported" }
    }
    if n.is_float {
        match k {
            checker::PrimKind::F64 => return cb_f64_literal(buf, n.fval)
            checker::PrimKind::F32 => {
                var o = cb(buf, "(float)(")
                o = cb_f64_literal(o, n.fval)
                return cb(o, ")")
            }
            _ => return error { message = "codegen: float literal with a non-float type not yet supported" }
        }
    }
    var out = cb(buf, "((")
    out = match emit_prim(out, k) { Cb as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb_numint(out, n.value)
    cb(out, ")")
}

fn emit_expr(buf: Cb, prog: CgProg, e: checker::TExpr): Cb | error {
    emit_expr_ctx(buf, prog, checker::Void { }, e, teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty())
}
fn emit_expr_ret(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr): Cb | error {
    emit_expr_ctx(buf, prog, ret_type, e, teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty())
}
fn emit_expr_ctx(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    match e.kind {
        checker::TNumber as n => emit_number(buf, prog, e, n)
        checker::TVar as v => if v.is_func {
            cb(cb_fn_name(cb(buf, "(tk_closure){ (void*)&"), v.func_ns, v.name), ", (void*)0 }")
        } else if cg_var_is_struct_self(prog, e, v) {
            cb(cb_ident(cb(buf, "(*"), v.name), ")")
        } else if checker::is_cond_const(v.func_ns, v.name, prog.cond_consts) {
            cb(buf, cond_const_c_symbol(v.func_ns, v.name))
        } else {
            cb_ident(buf, v.name)
        }
        checker::TBinary as b => emit_binary(buf, prog, e, b, escaping, regions, fn_body, dctx)
        checker::TUnary as u => emit_unary(buf, prog, u, escaping, regions, fn_body, dctx)
        checker::TCompare as c => emit_compare(buf, prog, c, escaping, regions, fn_body, dctx)
        checker::TCast as c => emit_cast(buf, prog, e, c, escaping, regions, fn_body, dctx)
        checker::TCall as cl => emit_call(buf, prog, ret_type, e, cl, escaping, regions, fn_body, dctx)
        checker::TFieldAccess as fa => emit_field_access(buf, prog, fa, escaping, regions, fn_body, dctx)
        checker::TStructInit as si => emit_struct_init(buf, prog, e, si, escaping, regions, fn_body, dctx)
        checker::TStrLit as s => emit_strlit(buf, s)
        checker::TByteStrLit as bs => emit_bytestrlit(buf, bs)
        checker::TByteLit as by => cb_i64(buf, by.value to i64)
        checker::TCharLit as ch => emit_charlit(buf, ch)
        checker::TBoolLit as bl => cb(buf, if bl.value { "true" } else { "false" })
        checker::TIfExpr as f => emit_if_value(buf, prog, ret_type, e, f, escaping, regions, fn_body, dctx)
        checker::TMatchExpr as m => emit_match_value(buf, prog, ret_type, e, m, escaping, regions, fn_body, dctx)
        checker::TNullLit => match e.type {
            checker::Null => cb(buf, "0")
            _ => error { message = "codegen: a bare `null` needs a known optional type from context (use it where a `T?` is expected)" }
        }
        checker::TIndex as ix => emit_index(buf, prog, e, ix, escaping, regions, fn_body, dctx)
        checker::TInterp as in => emit_interp(buf, prog, in, "", escaping, regions, fn_body, dctx)
        checker::TInExpr as ie => emit_in(buf, prog, ie, escaping, regions, fn_body, dctx)
        checker::TArrayLit as a => emit_array_lit(buf, prog, e, a, escaping, regions, fn_body, dctx)
        checker::TSliceOfLen as s => emit_slice_of_len(buf, prog, e, s, escaping, regions, fn_body, dctx)
        checker::TPathExpr as pe => {
            if cg_named_is_flags(prog, pe.enum_name) {
                var out = mangle_type_name(buf, "", pe.enum_name)
                out = cb(out, "_")
                cb_upper(out, pe.member)
            } else {
                var out = cb(buf, "TK_E_")
                out = cb_upper(out, checker::name_last_segment(pe.enum_name))
                out = cb(out, "_")
                cb_upper(out, pe.member)
            }
        }
        checker::TLambda as lam => emit_lambda(buf, prog, e, lam, escaping, regions, fn_body, dctx)
        checker::TBorrow as b => emit_borrow(buf, prog, ret_type, b, escaping, regions, fn_body, dctx)
        checker::TBlockExpr as blk => emit_block_expr(buf, prog, ret_type, e, blk, escaping, regions, fn_body, dctx)
    }
}

fn emit_block_expr(buf: Cb, prog: CgProg, ret_type: @Type(), e: checker::TExpr, blk: checker::TBlockExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var tmp = fresh_tmp_name(buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, e.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, ";\n")
    out = match emit_branch_value(out, prog, ret_type, blk.body, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    cb(out, "; })")
}

fn emit_borrow(buf: Cb, prog: CgProg, ret_type: @Type(), b: checker::TBorrow, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = cb(buf, "&")
    emit_expr_ctx(out, prog, ret_type, b.operand, escaping, regions, fn_body, dctx)
}

fn lam_fn_name(id: u64): str { teko::str::concat("__tkclo_", teko::u64_to_str(id)) }

fn emit_lambda(buf: Cb, prog: CgProg, e: checker::TExpr, lam: checker::TLambda, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if lam.captures.len == 0 {
        var out = cb(buf, "(tk_closure){ (void*)&")
        out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
        return cb(out, ", (void*)0 }")
    }
    var out = cb(buf, "({ __tkenv_")
    out = cb(out, teko::u64_to_str(lam.lift_id))
    out = cb(out, " *_tke = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc)); out = cb(out, "("); out = cb(out, cg_closure_env_region(dctx)); out = cb(out, ", sizeof(__tkenv_")
    out = cb(out, teko::u64_to_str(lam.lift_id))
    out = cb(out, ")); ")
    var i = 0
    loop {
        if i >= lam.captures.len { break }
        out = cb(out, "_tke->")
        out = cb_ident(out, lam.captures[i].name)
        out = cb(out, " = ")
        out = cb_ident(out, lam.captures[i].name)
        out = cb(out, "; ")
        i++
    }
    out = cb(out, "(tk_closure){ (void*)&")
    out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
    cb(out, ", (void*)_tke }; })")
}

type RegionFrame = struct {
    name: str
    label: str
    is_loop: bool
    defer_base: u64
    decls: []str
}

fn scope_region_of(regions: []RegionFrame, name: str): str {
    var k = regions.len
    loop {
        if k == 0 { break }
        var r = regions[k - 1]
        if str_list_has(r.decls, name) { return r.name }
        k = k - 1
    }
    ""
}

fn cg_bound_is_slice(t: @Type()): bool {
    match t { checker::Slice => true; _ => false }
}

fn cg_self_append_escapes(escaping: []str, dctx: DeferCtx, a: checker::TAssign): bool {
    if dctx.rr.len == 0 { return false }
    if !checker::assign_is_self_append(a) { return false }
    if !str_list_has(escaping, a.name) { return false }
    cg_bound_is_slice(a.bound)
}

fn cg_slice_grow_elem_matches(bound: @Type(), vtype: @Type()): bool {
    match bound {
        checker::Slice as bs => match vtype {
            checker::Slice as vs => cg_mangle_eq(bs.element, vs.element)
            _ => false
        }
        _ => false
    }
}

fn cg_binding_grows_escaping_slice(escaping: []str, dctx: DeferCtx, b: checker::TBinding): bool {
    if dctx.rr.len == 0 { return false }
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if !str_list_has(escaping, name) { return false }
    if !cg_bound_is_slice(b.bound) { return false }
    if !cg_slice_grow_elem_matches(b.bound, b.value.type) { return false }
    match b.value.kind {
        checker::TCall as c => cg_call_is_slice_grow(c)
        _ => false
    }
}

fn cg_call_is_slice_grow(c: checker::TCall): bool {
    var segs = c.callee.segments
    if segs.len < 2 { return false }
    var last = segs[segs.len - 1].name
    var prev = segs[segs.len - 2].name
    (prev == "list" && (last == "push" || last == "with_cap")) || (prev == "mem" && last == "push_fo")
}

fn str_list_has(xs: []str, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == name { return true }
        i = i + 1
    }
    false
}

fn cg_block_slice_accums(prog: CgProg, escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool): []str {
    var acc: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(escaping, fn_body, body, is_value, b) {
                    match b.target {
                        parser::SimpleName as sn => { acc = teko::list::push(acc, sn.name) }
                        parser::DestructurePattern => { }
                    }
                }
            }
            _ => { }
        }
        i = i + 1
    }
    acc
}

fn cg_binding_is_block_local_slice(escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool, b: checker::TBinding): bool {
    match b.bound {
        checker::Slice => checker::binding_is_block_local(escaping, fn_body, body, is_value, b)
        _ => false
    }
}

fn cg_enclosing_region_expr(regions: []RegionFrame): str {
    if regions.len > 0 { return regions[regions.len - 1].name }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

fn cg_enclosing_region_expr_framed(regions: []RegionFrame, frame: str): str {
    if regions.len > 0 { return regions[regions.len - 1].name }
    if frame != "" { return frame }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

type LoopDeferFrame = struct {
    label: str
    defer_base: u64
    region_base: u64
}

type DeferCtx = struct {
    defers: []@TStatement()
    loops: []LoopDeferFrame
    cov: CovCtx
    rr: str
    bracket_depth: u64
}

fn dctx_empty(): DeferCtx {
    DeferCtx { defers = teko::list::empty(); loops = teko::list::empty(); cov = cov_off(); rr = ""; bracket_depth = 0 }
}

fn emit_defers(buf: Cb, defers: []@TStatement(), defer_floor: u64, prog: CgProg, indent: str, escaping: []str, fn_body: []@TStatement()): Cb | error {
    var out = buf
    var i = defers.len
    loop {
        if i <= defer_floor { break }
        i = i - 1
        match defers[i] {
            checker::TDeferStmt as d => {
                var j: u64 = 0
                loop {
                    if j >= d.body.len { break }
                    out = match emit_stmt(out, d.body[j], false, prog, checker::Void { }, indent, "", escaping, teko::list::empty(), fn_body, dctx_empty(), teko::list::empty(), false) { Cb as o => o; error as err => return err }
                    j++
                }
            }
            _ => { }
        }
    }
    out
}

fn dctx_register(dctx: DeferCtx, s: @TStatement()): DeferCtx {
    DeferCtx { defers = teko::list::push(dctx.defers, s); loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth }
}

fn cg_append_direct_defers(defers: []@TStatement(), body: []@TStatement()): []@TStatement() {
    var out = defers
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { out = teko::list::push(out, body[i]) }
            _ => { }
        }
        i++
    }
    out
}

fn cg_target_defer_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.defer_base }
        k = k - 1
    }
    0
}

fn cg_target_region_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.region_base }
        k = k - 1
    }
    0
}

fn cg_drop_regions_from(buf: Cb, indent: str, regions: []RegionFrame, defer_floor: u64): Cb {
    var out = buf
    var k = regions.len
    loop {
        if k <= defer_floor { break }
        var r = regions[k - 1]
        out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, r.name); out = cb(out, "); "); out = cb(out, r.name); out = cb(out, " = NULL;\n")
        k = k - 1
    }
    out
}

fn cg_drop_all_regions(buf: Cb, indent: str, regions: []RegionFrame): Cb {
    var out = buf
    var k = regions.len
    loop {
        if k == 0 { break }
        var r = regions[k - 1]
        out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, r.name); out = cb(out, "); "); out = cb(out, r.name); out = cb(out, " = NULL;\n")
        k = k - 1
    }
    out
}

fn cg_binding_routes_box_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    match b.bound {
        checker::Variant as va => match cg_union_box_member(prog, va) {
            (@Type()) as _gt13 => match b.value.kind {
                checker::TNullLit => false
                _ => !cg_mangle_eq(b.bound, b.value.type)
            }
            null => false
        }
        _ => false
    }
}

fn cg_binding_routes_str_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    if !cg_bound_is_str(b.bound) { return false }
    match b.value.kind {
        checker::TInterp => true
        checker::TCall as bc => cg_is_concat_bridge(prog, bc)
        _ => false
    }
}

fn cg_block_has_block_local(prog: CgProg, escaping: []str, fn_body: []@TStatement(), block: []@TStatement(), is_value: bool): bool {
    var i: u64 = 0
    loop {
        if i >= block.len { break }
        match block[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(escaping, fn_body, block, is_value, b) { return true }
                if checker::binding_is_block_local(escaping, fn_body, block, is_value, b) {
                    if cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b) || cg_binding_routes_str_to_local_region(prog, b) { return true }
                }
            }
            _ => { }
        }
        i++
    }
    false
}

fn emit_block(buf: Cb, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    var out = buf
    var cur = dctx
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }
            _ => {
                out = match emit_stmt(out, s, in_main, prog, ret_type, indent, "", escaping, regions, fn_body, cur, cur_block, cur_block_is_value) { Cb as o => o; error as err => return err }
            }
        }
        i++
    }
    out
}

fn emit_block_region(buf: Cb, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, body)
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, false) && regions.len < 64
    if !want_block {
        var out = match emit_block(buf, body, in_main, prog, ret_type, indent, escaping, regions, fn_body, dctx, teko::list::empty(), false) { Cb as o => o; error as err => return err }
        return emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body)
    }
    var region = fresh_named("_tkbr", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, false) })
    out = match emit_block(out, body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, body, false) { Cb as o => o; error as err => return err }
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

fn emit_exprstmt_tail(buf: Cb, x: checker::TExpr, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    match x.kind {
        checker::TIfExpr as f => {
            var bh = emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent)
            if !f.has_else { return emit_if_stmt(bh, f, x.line, x.col, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, dctx, teko::list::empty(), false) }
            var out = cb(bh, indent)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
            out = cb(out, ") {\n")
            var inner = cb_indent_deeper(indent)
            out = emit_cov_branch(out, dctx.cov, x.line, x.col, 0, inner)
            var then_base = dctx.defers.len
            out = match emit_block_tail(out, f.then_blk, in_main, prog, ret_type, inner, "", escaping, fn_body, dctx) { Cb as o => o; error as err => return err }
            var then_term = if f.then_blk.len > 0 { cg_stmt_c_terminates(f.then_blk[f.then_blk.len - 1]) } else { false }
            if !then_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, f.then_blk), then_base, prog, inner, escaping, fn_body) { Cb as o => o; error as err => return err } }
            out = cb(out, indent)
            out = cb(out, "} else {\n")
            out = emit_cov_branch(out, dctx.cov, x.line, x.col, 1, inner)
            var else_base = dctx.defers.len
            out = match emit_block_tail(out, f.else_blk, in_main, prog, ret_type, inner, "", escaping, fn_body, dctx) { Cb as o => o; error as err => return err }
            var else_term = if f.else_blk.len > 0 { cg_stmt_c_terminates(f.else_blk[f.else_blk.len - 1]) } else { false }
            if !else_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, f.else_blk), else_base, prog, inner, escaping, fn_body) { Cb as o => o; error as err => return err } }
            out = cb(out, indent)
            cb(out, "}\n")
        }
        checker::TMatchExpr as m => emit_match_tail(emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent), prog, x, m, in_main, ret_type, indent, escaping, fn_body, dctx)
        _ => {
            var bl = emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent)
            if is_void_type(x.type) {
                var out = cb(bl, indent)
                out = match emit_expr_ctx(out, prog, checker::Void { }, x, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
                out = cb(out, ";\n")
                return emit_defers(out, dctx.defers, 0, prog, indent, escaping, fn_body)
            }
            var out = match emit_defers(bl, dctx.defers, 0, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
            if !in_main {
                var cleanup = match cg_class_cleanup_text(prog, escaping, fn_body, true, x) { str as c => c; error as e => return e }
                if cleanup.len > 0 { out = cb(out, indent); out = cb(out, cleanup); out = cb(out, "\n") }
            }
            if !in_main {
                out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
                out = cg_return_frame_exit(out, indent, frame, dctx)
            }
            out = cb(out, indent)
            if in_main {
                out = cb(out, CG_MAIN_RETURN_OPEN)
                out = match emit_expr_ctx(out, prog, checker::Void { }, x, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
                return cb(out, CG_MAIN_RETURN_CLOSE)
            }
            out = cb(out, "return ")
            out = match emit_as_r(out, prog, ret_type, ret_type, x, escaping, teko::list::empty(), fn_body, dctx) { Cb as o => o; error as err => return err }
            cb(out, ";\n")
        }
    }
}

fn emit_block_tail(buf: Cb, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = buf
    var cur = dctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }
            _ => {
                out = match emit_stmt(out, s, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, cur, teko::list::empty(), false) { Cb as o => o; error as err => return err }
            }
        }
        i++
    }
    if body.len == 0 { return out }
    var last = body[body.len - 1]
    match last {
        checker::TDeferStmt => out
        checker::TExprStmt as es => emit_exprstmt_tail(out, es.expr, in_main, prog, ret_type, indent, frame, escaping, fn_body, cur)
        _ => emit_stmt(out, last, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, cur, teko::list::empty(), false)
    }
}

fn emit_if_stmt(buf: Cb, f: checker::TIfExpr, line: u32, col: u32, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    var out = cb(buf, indent)
    out = cb(out, "if (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, ") {\n")
    var inner = cb_indent_deeper(indent)
    out = emit_cov_branch(out, dctx.cov, line, col, 0, inner)
    out = match emit_block_region(out, f.then_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    if f.has_else {
        out = cb(out, indent)
        out = cb(out, "} else {\n")
        out = emit_cov_branch(out, dctx.cov, line, col, 1, inner)
        out = match emit_block_region(out, f.else_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    } else if dctx.cov.on {
        out = cb(out, indent)
        out = cb(out, "} else {\n")
        out = emit_cov_branch(out, dctx.cov, line, col, 1, inner)
    }
    out = cb(out, indent)
    cb(out, "}\n")
}

fn emit_binding(buf: Cb, prog: CgProg, ret_type: @Type(), b: checker::TBinding, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return error { message = "codegen: destructuring binding not yet supported" }
    }
    if name == "_" {
        var dout = cb(buf, indent)
        dout = cb(dout, "(void)(")
        dout = match emit_as_r(dout, prog, ret_type, b.bound, b.value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        return cb(dout, ");\n")
    }
    var out = cb(buf, indent)
    if b.kind == parser::BindKind::Const { out = cb(out, "const ") }
    out = match emit_type(out, prog, b.bound) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb_ident(out, name)
    out = cb(out, " = ")
    if cg_binding_grows_escaping_slice(escaping, dctx, b) {
        match b.value.kind {
            checker::TCall as c => {
                var last = c.callee.segments[c.callee.segments.len - 1].name
                if last == "with_cap" {
                    out = match emit_list_with_cap(out, prog, b.value, c, escaping, regions, fn_body, dctx, dctx.rr) { Cb as o => o; error as err => return err }
                } else {
                    out = match emit_list_push(out, prog, b.value, c, escaping, regions, fn_body, dctx, dctx.rr) { Cb as o => o; error as err => return err }
                }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if regions.len > 0 && cur_block.len > 0 && cg_same_named_struct(b.bound, b.value.type) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        match b.value.kind {
            checker::TStructInit as si => {
                out = match emit_struct_init_framed(out, prog, b.value, si, regions[regions.len - 1].name, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if regions.len > 0 && cur_block.len > 0 && cg_binding_routes_str_to_local_region(prog, b) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        var str_region = regions[regions.len - 1].name
        match b.value.kind {
            checker::TInterp as bin => {
                out = match emit_interp(out, prog, bin, str_region, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            checker::TCall as bc => {
                if cg_is_concat_bridge(prog, bc) {
                    out = match emit_concat_fold(out, prog, bc.args[0], str_region, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                    return cb(out, ";\n")
                }
            }
            _ => { }
        }
    }
    if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_same_named_struct(b.bound, b.value.type) {
        match b.value.kind {
            checker::TStructInit as si => {
                out = match emit_struct_init_framed(out, prog, b.value, si, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    var box_region = if regions.len > 0 && cur_block.len > 0 && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) && cg_binding_routes_box_to_local_region(prog, b) {
        regions[regions.len - 1].name
    } else if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_binding_routes_box_to_local_region(prog, b) {
        frame
    } else {
        ""
    }
    out = match emit_as_r_in(out, prog, ret_type, b.bound, b.value, box_region, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ";\n")
}

fn emit_assign_lvalue(buf: Cb, prog: CgProg, a: checker::TAssign): Cb | error {
    match a.kind {
        parser::AssignKind::Field => emit_expr(buf, prog, a.target)
        _ => {
            if a.deref {
                var out = cb(buf, "(*")
                out = cb_ident(out, a.name)
                cb(out, ")")
            } else {
                cb_ident(buf, a.name)
            }
        }
    }
}

fn emit_index_assign(buf: Cb, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var ix = match a.target.kind { checker::TIndex as ti => ti; _ => return error { message = "codegen: index-assign target is not a subscript (internal)" } }
    var elem = match ix.receiver.type { checker::Slice as sl => sl.element; _ => return error { message = "codegen: index-assign receiver is not a slice (internal)" } }
    var wstmp = $"_ws{buf.len}"
    var witmp = $"_wi{buf.len + 1}"
    var out = cb(buf, indent)
    out = cb(out, "{ ")
    out = match emit_type(out, prog, ix.receiver.type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, wstmp)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); uint64_t ")
    out = cb(out, witmp)
    out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, "); if (")
    out = cb(out, witmp)
    out = cb(out, " < ")
    out = cb(out, wstmp)
    out = cb(out, ".len) { ")
    out = match emit_index_store_body(out, prog, ret_type, a, wstmp, witmp, elem, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, " } else { tk_panic_oob_at(")
    out = cb(out, teko::u64_to_str(a.target.line to u64))
    out = cb(out, ", ")
    out = cb(out, teko::u64_to_str(a.target.col to u64))
    cb(out, "); }\n }\n")
}

fn emit_index_store_body(buf: Cb, prog: CgProg, ret_type: @Type(), a: checker::TAssign, wstmp: str, witmp: str, elem: @Type(), escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match elem { checker::Prim as p => p; _ => return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        if !cg_prim_is_int(prim.kind) { return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        var tag = match prim_int_tag(prim.kind) { str as t => t; error => return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        var so = emit_index_slot(buf, wstmp, witmp)
        so = cb(so, " = ")
        so = cb(so, fn_prefix)
        so = cb(so, tag)
        so = cb(so, "(")
        so = emit_index_slot(so, wstmp, witmp)
        so = cb(so, ", ")
        so = match emit_expr_ctx(so, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        return cb(so, ");")
    }
    var op = match assignop_c(a.op) { str as s => s; error as err => return err }
    var out = emit_index_slot(buf, wstmp, witmp)
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    out = match emit_as_r(out, prog, ret_type, elem, a.value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ";")
}

fn emit_index_slot(buf: Cb, wstmp: str, witmp: str): Cb {
    var out = cb(buf, wstmp)
    out = cb(out, ".ptr[")
    out = cb(out, witmp)
    cb(out, "]")
}

fn emit_assign(buf: Cb, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var is_index = match a.kind { parser::AssignKind::Index => true; _ => false }
    if is_index { return emit_index_assign(buf, prog, ret_type, a, indent, escaping, regions, fn_body, dctx) }
    var op = match assignop_c(a.op) { str as s => s; error as err => return err }
    var out = cb(buf, indent)
    if checker::assign_frees_old(fn_body, a) {
        match a.value.kind {
            checker::TCall as c => {
                out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
                out = cb(out, " = ")
                out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, "@fo") { Cb as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if checker::assign_routes_to_frame(escaping, a) {
        var accum_region = scope_region_of(regions, a.name)
        var target = if accum_region.len > 0 { accum_region } else { frame }
        if target.len > 0 {
            match a.value.kind {
                checker::TCall as c => {
                    out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
                    out = cb(out, " = ")
                    out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, target) { Cb as o => o; error as err => return err }
                    return cb(out, ";\n")
                }
                _ => { }
            }
        }
    }
    if cg_self_append_escapes(escaping, dctx, a) {
        match a.value.kind {
            checker::TCall as c => {
                out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
                out = cb(out, " = ")
                out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, dctx.rr) { Cb as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match a.bound {
            checker::Prim as p => p
            _ => return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        if !cg_prim_is_int(prim.kind) {
            return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        var tag = match prim_int_tag(prim.kind) {
            str as t => t
            error => return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
        out = cb(out, " = ")
        out = cb(out, fn_prefix)
        out = cb(out, tag)
        out = cb(out, "(")
        out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
        out = cb(out, ", ")
        out = match emit_expr_ctx(out, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        out = cb(out, ")")
        return cb(out, ";\n")
    }
    if a.op == lexer::TokenKind::SlashEq || a.op == lexer::TokenKind::PercentEq {
        return emit_div_mod_assign(out, prog, a, escaping, regions, fn_body, dctx)
    }
    out = match emit_assign_lvalue(out, prog, a) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    out = match emit_as_r(out, prog, ret_type, a.bound, a.value, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ";\n")
}

fn emit_return(buf: Cb, prog: CgProg, r: checker::TReturn, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var out = match emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
    out = cg_drop_all_regions(out, indent, regions)
    var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
    var cleanup = if r.has_value {
        match cg_class_cleanup_text(prog, escaping, fn_body, true, r.value) { str as c => c; error as e => return e }
    } else {
        match cg_class_cleanup_text(prog, escaping, fn_body, false, no_tail) { str as c => c; error as e => return e }
    }
    if cleanup.len > 0 { out = cb(out, indent); out = cb(out, cleanup); out = cb(out, "\n") }
    out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
    out = cg_return_frame_exit(out, indent, frame, dctx)
    out = cb(out, indent)
    if !r.has_value {
        if in_main { return cb(out, "return 0;\n") }
        return cb(out, "return;\n")
    }
    var ret_regions: []RegionFrame = teko::list::empty()
    if in_main {
        out = cb(out, CG_MAIN_RETURN_OPEN)
        out = match emit_expr_ctx(out, prog, checker::Void { }, r.value, escaping, ret_regions, fn_body, dctx) { Cb as o => o; error as err => return err }
        return cb(out, CG_MAIN_RETURN_CLOSE)
    }
    out = cb(out, "return ")
    out = match emit_as_r(out, prog, ret_type, ret_type, r.value, escaping, ret_regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ";\n")
}

fn emit_loop(buf: Cb, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    if l.init.len == 0 { return emit_loop_while(buf, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx) }
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    var inner = cb_indent_deeper(indent)
    out = match emit_block(out, l.init, in_main, prog, ret_type, inner, escaping, regions, fn_body, dctx, teko::list::empty(), false) { Cb as o => o; error as err => return err }
    out = match emit_loop_while(out, l, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    out = cb(out, indent)
    out = cb(out, "}\n")
    out
}

fn emit_loop_while(buf: Cb, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var labeled = l.label.len > 0
    var out = cb(buf, indent)
    out = cb(out, "while (1) {\n")
    var inner = cb_indent_deeper(indent)
    if labeled { out = cb(out, inner); out = cb(out, "tk_lbl_"); out = cb_str(out, l.label); out = cb(out, "_cont: ;\n") }
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, l.body)
    var dctx2 = DeferCtx { defers = dctx.defers; loops = teko::list::push(dctx.loops, LoopDeferFrame { label = l.label; defer_base = defer_floor; region_base = regions.len }); cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth }
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, l.body, false) && regions.len < 64
    var region = if want_block { fresh_named("_tkbr", out.len to i64) } else { "" }
    var regs2 = regions
    if want_block {
        out = cb(out, inner); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
        regs2 = teko::list::push(regions, RegionFrame { name = region; label = l.label; is_loop = true; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, l.body, false) })
    }
    var cur_blk = if want_block { l.body } else { teko::list::empty() }
    out = match emit_block(out, l.body, in_main, prog, ret_type, inner, escaping, regs2, fn_body, dctx2, cur_blk, false) { Cb as o => o; error as err => return err }
    out = match emit_defers(out, fall, defer_floor, prog, inner, escaping, fn_body) { Cb as o => o; error as err => return err }
    if want_block { out = cb(out, inner); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n") }
    out = cb(out, indent)
    out = cb(out, "}\n")
    if labeled { out = cb(out, indent); out = cb(out, "tk_lbl_"); out = cb_str(out, l.label); out = cb(out, "_break: ;\n") }
    out
}

fn cb_indent_deeper(indent: str): str {
    var xs: []byte = teko::list::empty()
    var i = 0
    loop {
        if i >= indent.len { break }
        xs = teko::list::push(xs, indent[i])
        i++
    }
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    str(xs)
}

fn cov_push_line(acc: []u32, line: u32): []u32 {
    if line == 0 { return acc }
    var i: u64 = 0
    loop { if i >= acc.len { break }; if acc[i] == line { return acc }; i = i + 1 }
    teko::list::push(acc, line)
}

fn cov_collect_expr(e: checker::TExpr, acc: []u32): []u32 {
    var a0 = cov_push_line(acc, e.line)
    match e.kind {
        checker::TBinary as b => cov_collect_expr(b.right, cov_collect_expr(b.left, a0))
        checker::TUnary as u => cov_collect_expr(u.operand, a0)
        checker::TCompare as c => {
            var a = cov_collect_expr(c.first, a0)
            var i = 0
            loop { if i >= c.rest.len { break }; a = cov_collect_expr(c.rest[i].operand, a); i++ }
            a
        }
        checker::TCall as c => {
            var a = a0
            var i = 0
            loop { if i >= c.args.len { break }; a = cov_collect_expr(c.args[i], a); i++ }
            a
        }
        checker::TCast as c => cov_collect_expr(c.expr, a0)
        checker::TFieldAccess as fa => cov_collect_expr(fa.receiver, a0)
        checker::TIndex as ix => cov_collect_expr(ix.index, cov_collect_expr(ix.receiver, a0))
        checker::TStructInit as si => {
            var a = a0
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cov_collect_expr(si.field_vals[i], a); i++ }
            a
        }
        checker::TInterp as in => {
            var a = a0
            var i = 0
            loop {
                if i >= in.holes.len { break }
                a = cov_collect_expr(in.holes[i], a)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = cov_collect_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cov_collect_expr(ie.lhs, a0)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cov_collect_expr(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = a0
            var i = 0
            loop { if i >= al.elements.len { break }; a = cov_collect_expr(al.elements[i].expr, a); i++ }
            a
        }
        checker::TIfExpr as f => cov_collect_expr(f.cond, a0)
        checker::TMatchExpr as m => {
            var a = cov_collect_expr(m.subject, a0)
            var i = 0
            loop { if i >= m.arms.len { break }; if m.arms[i].has_when { a = cov_collect_expr(m.arms[i].guard, a) }; i++ }
            a
        }
        _ => a0
    }
}

fn stmt_cov_lines(s: @TStatement()): []u32 {
    var acc: []u32 = teko::list::empty()
    match s {
        checker::TBinding as b => cov_collect_expr(b.value, acc)
        checker::TAssign as a => {
            var av = cov_collect_expr(a.value, acc)
            if parser::assign_has_target(a.kind) { cov_collect_expr(a.target, av) } else { av }
        }
        checker::TReturn as r => if r.has_value { cov_collect_expr(r.value, acc) } else { acc }
        checker::TExprStmt as es => cov_collect_expr(es.expr, acc)
        _ => acc
    }
}

fn emit_cov_lines(buf: Cb, ctx: CovCtx, lines: []u32, indent: str): Cb {
    if !ctx.on { return buf }
    var out = buf
    var i: u64 = 0
    loop { if i >= lines.len { break }; out = emit_cov_line(out, ctx, lines[i], indent); i = i + 1 }
    out
}

fn emit_stmt(buf: Cb, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    var b0 = emit_cov_lines(buf, dctx.cov, stmt_cov_lines(s), indent)
    if dctx.rr.len > 0 && dctx.bracket_depth == 0 && cg_conveys_escape_deep(escaping, s) {
        var ob = cb(b0, indent); ob = cb(ob, cg_arena_sym(CgArenaSym::RegionEnter)); ob = cb(ob, "("); ob = cb(ob, dctx.rr); ob = cb(ob, ");\n")
        var d2 = cg_dctx_bracket(dctx)
        var ob2 = match emit_stmt_dispatch(ob, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, d2, cur_block, cur_block_is_value) { Cb as o => o; error as err => return err }
        ob2 = cb(ob2, indent); ob2 = cb(ob2, cg_arena_sym(CgArenaSym::RegionLeave)); ob2 = cb(ob2, "();\n")
        return ob2
    }
    emit_stmt_dispatch(b0, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
}

fn emit_stmt_dispatch(b0: Cb, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): Cb | error {
    match s {
        checker::TBinding as b => emit_binding(b0, prog, ret_type, b, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
        checker::TAssign as a => emit_assign(b0, prog, ret_type, a, indent, frame, escaping, regions, fn_body, dctx)
        checker::TReturn as r => emit_return(b0, prog, r, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TExprStmt as es => {
            match es.expr.kind {
                checker::TIfExpr as f => emit_if_stmt(b0, f, es.expr.line, es.expr.col, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                checker::TMatchExpr as m => emit_match_stmt(b0, prog, es.expr, m, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                _ => emit_expr_stmt_default(b0, es.expr, prog, escaping, regions, fn_body, dctx, indent)
            }
        }
        checker::TLoopStmt as l => emit_loop(b0, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBreakStmt as b => {
            var out = match emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, b.label), prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
            out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
            out = cg_drop_regions_from(out, indent, regions, cg_target_region_base(dctx.loops, b.label))
            out = cb(out, indent)
            if b.label.len > 0 { out = cb(out, "goto tk_lbl_"); out = cb_str(out, b.label); cb(out, "_break;\n") }
            else { cb(out, "break;\n") }
        }
        checker::TContinueStmt as c => {
            var out = match emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, c.label), prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
            out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
            out = cg_drop_regions_from(out, indent, regions, cg_target_region_base(dctx.loops, c.label))
            out = cb(out, indent)
            if c.label.len > 0 { out = cb(out, "goto tk_lbl_"); out = cb_str(out, c.label); cb(out, "_cont;\n") }
            else { cb(out, "continue;\n") }
        }
        checker::TDeferStmt => b0
        checker::TAdoptStmt as a => emit_adopt(b0, a, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBlockStmt as b => emit_block_region(b0, b.body, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TSpawn as sp => emit_spawn(b0, sp, prog, escaping, regions, fn_body, dctx, indent)
    }
}

fn cg_spawn_arg_is_fat(t: @Type()): bool {
    match t {
        checker::Str => true
        checker::Slice => true
        _ => false
    }
}

fn cg_ctype_text(prog: CgProg, t: @Type()): str | error {
    var b = match emit_type(cb_new(), prog, t) { Cb as o => o; error as e => return e }
    str(cb_flat(b))
}

fn cg_spawn_target_name(buf: Cb, prog: CgProg, c: checker::TCall): Cb {
    var last = cg_path_last(c.callee)
    match cg_find_function(prog, c.call_ns, last) {
        checker::TFunction as cf => if cf.is_extern { cb(buf, cf.c_symbol) } else { cb_fn_name(buf, c.call_ns, last, c.overload_suffix) }
        error => cb_fn_name(buf, c.call_ns, last, c.overload_suffix)
    }
}

fn emit_spawn_thunks(buf: Cb, prog: CgProg, spawns: []checker::TSpawn): Cb | error {
    var out = buf
    var i: u64 = 0
    loop {
        if i >= spawns.len { break }
        out = match emit_spawn_thunk_one(out, prog, spawns[i]) { Cb as o => o; error as e => return e }
        i = i + 1
    }
    out
}

fn emit_spawn_thunk_one(buf: Cb, prog: CgProg, sp: checker::TSpawn): Cb | error {
    var c = match sp.call.kind { checker::TCall as tc => tc; _ => return error { message = "internal: spawn target is not a call at codegen" } }
    var k = sp.id
    var args = c.args
    var out = cb(buf, $"typedef struct {{ ")
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        out = match emit_type(out, prog, args[i].type) { Cb as o => o; error as e => return e }
        out = cb(out, $" a{i}; ")
        i = i + 1
    }
    if args.len == 0 { out = cb(out, "char _pad; ") }
    out = cb(out, $"}} tk_spawn_ctx_{k};\n")
    out = cb(out, $"static tk_spawn_ctx_{k} *tk_spawn_pack_{k}(")
    if args.len == 0 { out = cb(out, "void") }
    i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { out = cb(out, ", ") }
        out = match emit_type(out, prog, args[i].type) { Cb as o => o; error as e => return e }
        out = cb(out, $" a{i}")
        i = i + 1
    }
    out = cb(out, $") {{\n    size_t _need = sizeof(tk_spawn_ctx_{k});\n")
    i = 0
    loop {
        if i >= args.len { break }
        if cg_spawn_arg_is_fat(args[i].type) {
            var bytes_expr = match cg_spawn_fat_bytes(prog, args[i].type, i) { str as s => s; error as e => return e }
            out = cb(out, $"    _need += 15u + {bytes_expr};\n")
        }
        i = i + 1
    }
    out = cb(out, $"    char *_blk = (char *)malloc(_need ? _need : 1); if (!_blk) tk_panic(\"out of memory\");\n")
    out = cb(out, $"    tk_spawn_ctx_{k} *_c = (tk_spawn_ctx_{k} *)_blk;\n")
    out = cb(out, $"    char *_tail = _blk + sizeof(tk_spawn_ctx_{k}); (void)_tail;\n")
    i = 0
    loop {
        if i >= args.len { break }
        out = match emit_spawn_pack_field(out, prog, args[i].type, i) { Cb as o => o; error as e => return e }
        i = i + 1
    }
    out = cb(out, "    return _c;\n}\n")
    out = cb(out, $"static void tk_spawn_tramp_{k}(void *_raw) {{\n    tk_spawn_ctx_{k} *_c = (tk_spawn_ctx_{k} *)_raw; (void)_c;\n    ")
    out = cg_spawn_target_name(out, prog, c)
    out = cb(out, "(")
    i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { out = cb(out, ", ") }
        out = cb(out, $"_c->a{i}")
        i = i + 1
    }
    out = cb(out, ");\n    free(_raw);\n}\n")
    out
}

fn cg_spawn_fat_bytes(prog: CgProg, t: @Type(), i: u64): str | error {
    match t {
        checker::Str => $"(size_t)a{i}.len"
        checker::Slice as sl => {
            var elem = match cg_ctype_text(prog, sl.element) { str as s => s; error as e => return e }
            $"(size_t)a{i}.len * sizeof({elem})"
        }
        _ => error { message = "internal: cg_spawn_fat_bytes on a non-fat spawn argument" }
    }
}

fn emit_spawn_pack_field(buf: Cb, prog: CgProg, t: @Type(), i: u64): Cb | error {
    match t {
        checker::Str => cb(buf, $"    _tail = (char *)(((uintptr_t)_tail + 15u) & ~(uintptr_t)15u); memcpy(_tail, (const void *)a{i}.ptr, (size_t)a{i}.len); _c->a{i}.ptr = (const tk_byte *)_tail; _c->a{i}.len = a{i}.len; _tail += a{i}.len;\n")
        checker::Slice as sl => {
            var elem = match cg_ctype_text(prog, sl.element) { str as s => s; error as e => return e }
            cb(buf, $"    {{ size_t _n = (size_t)a{i}.len * sizeof({elem}); _tail = (char *)(((uintptr_t)_tail + 15u) & ~(uintptr_t)15u); memcpy(_tail, (const void *)a{i}.ptr, _n); _c->a{i}.ptr = ({elem} *)_tail; _c->a{i}.len = a{i}.len; _tail += _n; }}\n")
        }
        _ => cb(buf, $"    _c->a{i} = a{i};\n")
    }
}

fn emit_spawn(buf: Cb, sp: checker::TSpawn, prog: CgProg, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, indent: str): Cb | error {
    var c = match sp.call.kind { checker::TCall as tc => tc; _ => return error { message = "internal: spawn target is not a call at codegen" } }
    var k = sp.id
    var out = cb(buf, indent)
    out = cb(out, $"{{ tk_spawn_ctx_{k} *_sc = tk_spawn_pack_{k}(")
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { out = cb(out, ", ") }
        out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx) { Cb as o => o; error as e => return e }
        i = i + 1
    }
    out = cb(out, $"); tk_thread_spawn(tk_spawn_tramp_{k}, _sc); }}\n")
    out
}

fn emit_expr_stmt_default(buf: Cb, expr: checker::TExpr, prog: CgProg, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, indent: str): Cb | error {
    var b1 = if checker::texpr_diverges(expr) {
        match emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
    } else { buf }
    var out = cb(b1, indent)
    out = match emit_expr_ctx(out, prog, checker::Void { }, expr, escaping, regions, fn_body, dctx) { Cb as o => o; error as err => return err }
    cb(out, ";\n")
}

fn emit_adopt(buf: Cb, a: checker::TAdoptStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): Cb | error {
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, a.body)
    var region = fresh_named("_tkad", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = "); out = cb(out, cg_arena_sym(CgArenaSym::RegionNew)); out = cb(out, "("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = teko::list::empty() })
    out = match emit_block(out, a.body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, a.body, false) { Cb as o => o; error as err => return err }
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { Cb as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDropSubtree)); out = cb(out, "("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

fn cg_expr_calls_self(e: checker::TExpr, ns: str, name: str): bool {
    match e.kind {
        checker::TCall as c => {
            if !c.is_closure_call && !c.is_iface_dispatch && c.call_ns == ns && cg_path_last(c.callee) == name { return true }
            var i = 0
            loop { if i >= c.args.len { break }; if cg_expr_calls_self(c.args[i], ns, name) { return true }; i++ }
            false
        }
        checker::TBinary as b => cg_expr_calls_self(b.left, ns, name) || cg_expr_calls_self(b.right, ns, name)
        checker::TUnary as u => cg_expr_calls_self(u.operand, ns, name)
        checker::TCompare as c => {
            if cg_expr_calls_self(c.first, ns, name) { return true }
            var i = 0
            loop { if i >= c.rest.len { break }; if cg_expr_calls_self(c.rest[i].operand, ns, name) { return true }; i++ }
            false
        }
        checker::TIfExpr as f => cg_expr_calls_self(f.cond, ns, name) || cg_block_calls_self(f.then_blk, ns, name) || cg_block_calls_self(f.else_blk, ns, name)
        checker::TMatchExpr as m => {
            if cg_expr_calls_self(m.subject, ns, name) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when && cg_expr_calls_self(m.arms[i].guard, ns, name) { return true }
                if cg_block_calls_self(m.arms[i].body, ns, name) { return true }
                i++
            }
            false
        }
        checker::TCast as c => cg_expr_calls_self(c.expr, ns, name)
        checker::TFieldAccess as fa => cg_expr_calls_self(fa.receiver, ns, name)
        checker::TStructInit as si => {
            var i = 0
            loop { if i >= si.field_vals.len { break }; if cg_expr_calls_self(si.field_vals[i], ns, name) { return true }; i++ }
            false
        }
        checker::TIndex as ix => cg_expr_calls_self(ix.receiver, ns, name) || cg_expr_calls_self(ix.index, ns, name)
        checker::TInterp as ip => {
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                if cg_expr_calls_self(ip.holes[i], ns, name) { return true }
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; if cg_expr_calls_self(fd.args[k], ns, name) { return true }; k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            false
        }
        checker::TInExpr as ie => {
            if cg_expr_calls_self(ie.lhs, ns, name) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if cg_expr_calls_self(ie.elems[i], ns, name) { return true }; i++ }
            false
        }
        checker::TArrayLit as al => {
            var i = 0
            loop { if i >= al.elements.len { break }; if cg_expr_calls_self(al.elements[i].expr, ns, name) { return true }; i++ }
            false
        }
        checker::TLambda as lam => cg_block_calls_self(lam.body, ns, name)
        checker::TBlockExpr as blk => cg_block_calls_self(blk.body, ns, name)
        _ => false
    }
}

fn cg_block_calls_self(stmts: []@TStatement(), ns: str, name: str): bool {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => if cg_expr_calls_self(b.value, ns, name) { return true }
            checker::TAssign as a => { if cg_expr_calls_self(a.value, ns, name) { return true }; if parser::assign_has_target(a.kind) { if cg_expr_calls_self(a.target, ns, name) { return true } } }
            checker::TReturn as r => if r.has_value && cg_expr_calls_self(r.value, ns, name) { return true }
            checker::TLoopStmt as l => { if cg_block_calls_self(l.init, ns, name) { return true }; if cg_block_calls_self(l.body, ns, name) { return true } }
            checker::TExprStmt as es => if cg_expr_calls_self(es.expr, ns, name) { return true }
            checker::TDeferStmt as d => if cg_block_calls_self(d.body, ns, name) { return true }
            checker::TAdoptStmt as a => if cg_block_calls_self(a.body, ns, name) { return true }
            checker::TBlockStmt as b => if cg_block_calls_self(b.body, ns, name) { return true }
            _ => { }
        }
        i++
    }
    false
}

fn cg_fn_is_self_recursive(f: checker::TFunction): bool {
    if f.is_extern { return false }
    cg_block_calls_self(f.body, f.namespace, f.name)
}

fn cg_fn_ref_ns(prog: CgProg, ns: str): str {
    if prog.ix.exact.slots.len != 0 {
        if cg_table_get(prog.ix.exact, ns) != 0 { return checker::name_qualifier(ns) }
        return ns
    }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == ns { return checker::name_qualifier(ns) } }
            _ => { }
        }
        i++
    }
    ns
}

fn emit_function_sig(buf: Cb, prog: CgProg, f: checker::TFunction): Cb | error {
    var out = buf
    if cg_fn_is_self_recursive(f) { out = cb(out, "__attribute__((noinline)) ") }
    if f.is_extern { out = cb(out, "extern ") }
    out = match emit_type(out, prog, f.return_type) { Cb as o => o; error as err => return err }
    out = cb(out, " ")
    if f.is_extern {
        out = cb(out, f.c_symbol)
    } else {
        out = cb_fn_name(out, f.namespace, f.name, f.overload_suffix)
    }
    out = cb(out, "(")
    if f.params.len == 0 {
        out = cb(out, "void")
    } else {
        var ref_ns = cg_fn_ref_ns(prog, f.namespace)
        var self_is_ref = match cg_struct_self_recv(prog, f) { str => true; null => false }
        var i: u64 = 0
        loop {
            if i >= f.params.len { break }
            if i > 0 { out = cb(out, ", ") }
            out = match emit_type_expr(out, prog, f.params[i].type_ann, ref_ns) { Cb as o => o; error as err => return err }
            out = cb(out, " ")
            if i == 0 && self_is_ref { out = cb(out, "*") }
            out = cb_ident(out, f.params[i].name)
            i++
        }
    }
    cb(out, ")")
}

fn cg_stmt_c_terminates(s: @TStatement()): bool {
    match s {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TMatchExpr => false
            checker::TIfExpr => false
            _ => true
        }
        _ => false
    }
}

fn cg_same_named_struct(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => match b {
            checker::Named as nb => teko::runtime::str_eq(na.name, nb.name)
            _ => false
        }
        _ => false
    }
}

fn fn_body_has_frame_local(prog: CgProg, escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if checker::binding_is_frame_local(escaping, b) && (cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b)) { return true }
                if checker::binding_is_frame_local_slice(escaping, b) { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

fn emit_function(buf: Cb, prog: CgProg, f: checker::TFunction): Cb | error {
    emit_function_cov(buf, prog, f, -1)
}

fn cg_frame_region_parent_expr(f: checker::TFunction): str {
    if f.has_arena_size { return "NULL" }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

fn cg_rr_init_expr(): str { teko::str::concat(cg_arena_sym(CgArenaSym::RegionCurrent), "()") }

fn cg_tkfr_init_expr(f: checker::TFunction, use_rr: bool): str {
    var region_new = cg_arena_sym(CgArenaSym::RegionNew)
    if !use_rr { return teko::str::concat(region_new, "(", cg_frame_region_parent_expr(f), ")") }
    teko::str::concat(region_new, "(_tkrr)")
}

fn cg_tkfr_drop_active(entered: bool): bool { true }

fn binding_conveys_escape(escaping: []str, name: str): bool {
    str_list_has(escaping, name)
}

fn cg_target_name(t: @BindTarget()): str {
    match t {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => ""
    }
}

fn cg_dctx_bracket(dctx: DeferCtx): DeferCtx {
    DeferCtx { defers = dctx.defers; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth + 1 }
}

fn cg_conveys_escape_deep(escaping: []str, s: @TStatement()): bool {
    match s {
        checker::TBinding as b => binding_conveys_escape(escaping, cg_target_name(b.target))
        checker::TAssign as a => binding_conveys_escape(escaping, a.name)
        checker::TExprStmt as es => cg_expr_arm_has_escaping_write(escaping, es.expr)
        _ => false
    }
}

fn cg_expr_arm_has_escaping_write(escaping: []str, e: checker::TExpr): bool {
    match e.kind {
        checker::TIfExpr as f => cg_block_has_escaping_write(escaping, f.then_blk) || (f.has_else && cg_block_has_escaping_write(escaping, f.else_blk))
        checker::TMatchExpr as m => cg_arms_have_escaping_write(escaping, m.arms)
        _ => false
    }
}

fn cg_arms_have_escaping_write(escaping: []str, arms: []checker::TArm): bool {
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        if cg_block_has_escaping_write(escaping, arms[i].body) { return true }
        i = i + 1
    }
    false
}

fn cg_block_has_escaping_write(escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => { if binding_conveys_escape(escaping, cg_target_name(b.target)) { return true } }
            checker::TAssign as a => { if binding_conveys_escape(escaping, a.name) { return true } }
            checker::TExprStmt as es => { if cg_expr_arm_has_escaping_write(escaping, es.expr) { return true } }
            checker::TLoopStmt as l => { if cg_block_has_escaping_write(escaping, l.init) || cg_block_has_escaping_write(escaping, l.body) { return true } }
            _ => { }
        }
        i = i + 1
    }
    false
}

fn cg_emit_bracket_unwind(buf: Cb, indent: str, n: u64): Cb {
    var out = buf
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionLeave)); out = cb(out, "();\n")
        i = i + 1
    }
    out
}

fn cg_frame_exit(buf: Cb, indent: str, frame: str, entered: bool): Cb {
    var out = buf
    if entered { out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionLeave)); out = cb(out, "();\n") }
    if cg_tkfr_drop_active(entered) { out = cb(out, indent); out = cb(out, cg_arena_sym(CgArenaSym::RegionDrop)); out = cb(out, "("); out = cb(out, frame); out = cb(out, ");\n") }
    out
}

fn cg_return_frame_exit(buf: Cb, indent: str, frame: str, dctx: DeferCtx): Cb {
    if dctx.rr.len > 0 { return cg_frame_exit(buf, indent, "_tkfr", true) }
    if frame.len > 0 { return cg_frame_exit(buf, indent, frame, false) }
    buf
}

fn cg_closure_env_region(dctx: DeferCtx): str {
    if dctx.bracket_depth > 0 && dctx.rr.len > 0 { return dctx.rr }
    teko::str::concat(cg_arena_sym(CgArenaSym::RegionRoot), "()")
}

fn cg_emit_arena_presize(buf: Cb, n: u64): Cb {
    var out = cb(buf, "    (void)")
    out = cb(out, cg_arena_sym(CgArenaSym::RegionAlloc))
    out = cb(out, "(_tkfr, ")
    var sized = cb_u64_digits(out, n)
    cb(sized, ");\n")
}

fn emit_function_cov(buf: Cb, prog: CgProg, f: checker::TFunction, cov_idx: i64): Cb | error {
    var out = match emit_function_sig(buf, prog, f) { Cb as o => o; error as err => return err }
    out = cb(out, " {\n")
    if cov_idx >= 0 { out = cb(cb_u64_digits(cb(out, "    tk_cov_mark("), cov_idx to u64), ");\n") }
    var fbody = f.body
    var cov = if cov_idx >= 0 { CovCtx { on = true; fn_idx = cov_idx to u64 } } else { cov_off() }
    var escaping = checker::fn_escaping_vars(f)
    var want_frame = fn_body_has_frame_local(prog, escaping, fbody) || f.has_arena_size
    var frame: str = if want_frame { "_tkfr" } else { "" }
    var use_rr = want_frame && !f.has_arena_size
    var rr: str = if use_rr { "_tkrr" } else { "" }
    var dctx = DeferCtx { defers = teko::list::empty(); loops = teko::list::empty(); cov = cov; rr = rr; bracket_depth = 0 }
    if use_rr { out = cb(out, "    tk_region *_tkrr = "); out = cb(out, cg_rr_init_expr()); out = cb(out, ";\n") }
    if want_frame {
        out = cb(out, "    tk_region *_tkfr = "); out = cb(out, cg_tkfr_init_expr(f, use_rr)); out = cb(out, ";\n")
        if use_rr { out = cb(out, "    "); out = cb(out, cg_arena_sym(CgArenaSym::RegionEnter)); out = cb(out, "(_tkfr);\n") }
        if f.has_arena_size { out = cg_emit_arena_presize(out, f.arena_size) }
    }
    out = match emit_block_tail(out, fbody, false, prog, f.return_type, "    ", frame, escaping, fbody, dctx) { Cb as o => o; error as err => return err }
    var tail_is_expr = if fbody.len > 0 { match fbody[fbody.len - 1] { checker::TExprStmt => true; _ => false } } else { false }
    var tail_term = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
    if !tail_is_expr && !tail_term {
        var fn_defers = cg_append_direct_defers(dctx.defers, fbody)
        out = match emit_defers(out, fn_defers, 0, prog, "    ", escaping, fbody) { Cb as o => o; error as err => return err }
    }
    if !tail_term {
        var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
        var cleanup = match cg_class_cleanup_text(prog, escaping, fbody, false, no_tail) { str as c => c; error as e => return e }
        if cleanup.len > 0 { out = cb(out, "    "); out = cb(out, cleanup); out = cb(out, "\n") }
    }
    if want_frame {
        var tail_terminates = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
        if !tail_terminates { out = cg_frame_exit(out, "    ", "_tkfr", use_rr) }
    }
    var needs_unreachable = match f.return_type {
        checker::Void => false
        _ => if fbody.len > 0 { !cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { true }
    }
    if needs_unreachable { out = cb(out, "    __builtin_unreachable();\n") }
    cb(out, "}\n\n")
}

fn cb_upper(buf: Cb, s: str): Cb {
    var out = buf
    var i = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c >= b'a' && c <= b'z' {
            out = cb_byte(out, (c to i64 - b'a' to i64 + b'A' to i64) to byte)
        } else {
            out = cb_byte(out, c)
        }
        i++
    }
    out
}

fn variant_member_name(m: @TypeExpr()): str | error {
    match m {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => error { message = "codegen: a variant member must be a named type" }
    }
}

fn flags_carrier_ctype(n: u64): str {
    if n <= 8 { return "uint8_t" }
    if n <= 16 { return "uint16_t" }
    if n <= 32 { return "uint32_t" }
    "uint64_t"
}

fn emit_flags_member_const(buf: Cb, type_name: str, member: str, ordinal: u64): Cb {
    var out = cb(buf, "static const ")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, " ")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, "_")
    out = cb_upper(out, member)
    out = cb(out, " = (")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, ")(((uint64_t)1) << ")
    out = cb_i64(out, ordinal to i64)
    cb(out, ");\n")
}

fn emit_newtype_typedef(buf: Cb, prog: CgProg, d: parser::TypeDecl, nb: parser::NewtypeBody): Cb | error {
    var o = cb(buf, "typedef ")
    o = match emit_type_expr(o, prog, nb.backing, checker::name_qualifier(d.name)) { Cb as x => x; error as err => return err }
    o = cb(o, " ")
    o = mangle_type_name(o, "", d.name)
    cb(o, ";\n\n")
}

fn emit_flags_typedef(buf: Cb, d: parser::TypeDecl, fb: parser::FlagsBody): Cb {
    var out = cb(buf, "typedef ")
    out = cb(out, flags_carrier_ctype(fb.members.len))
    out = cb(out, " ")
    out = mangle_type_name(out, "", d.name)
    out = cb(out, ";\n")
    var mi: u64 = 0
    loop {
        if mi >= fb.members.len { break }
        out = emit_flags_member_const(out, d.name, fb.members[mi], mi)
        mi++
    }
    cb(out, "\n")
}

fn emit_type_decl(buf: Cb, prog: CgProg, d: parser::TypeDecl): Cb | error {
    match d.body {
        parser::StructBody as sb => {
            var out = cb(buf, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            out = cb(out, "    tk_struct_hdr __hdr;\n")
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                out = cb(out, "    ")
                out = match emit_type_expr(out, prog, sb.fields[i].type_ann, checker::name_qualifier(d.name)) { Cb as o => o; error as err => return err }
                out = cb(out, " ")
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { out = cb(out, "*") }
                out = cb_str(out, sb.fields[i].name)
                out = cb(out, ";\n")
                i++
            }
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::ClassBody as cb2 => {
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error as err => return err }
            var out = cb(buf, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= fields.len { break }
                out = cb(out, "    ")
                out = match emit_type_expr(out, prog, fields[i].type_ann, checker::name_qualifier(d.name)) { Cb as o => o; error as err => return err }
                out = cb(out, " ")
                if cg_field_boxed(prog, d.name, fields[i].type_ann) { out = cb(out, "*") }
                out = cb_str(out, fields[i].name)
                out = cb(out, ";\n")
                i++
            }
            out = cb(out, "    tk_region *__region;\n")
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::InterfaceBody => {
            buf
        }
        parser::TraitBody => {
            buf
        }
        parser::VariantBody as vb => {
            var members = match vb.type_expr {
                parser::UnionType as u => u.members
                _ => return error { message = "codegen: a variant body must be a union of members" }
            }
            var out = cb(buf, "typedef enum tk_tag_")
            out = cb_tysym(out, d.name)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= members.len { break }
                var mk = match cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(d.name)) { str as s => s; error as err => return err }
                out = cb(out, "    TK_TAG_")
                out = cb_upper(out, cg_ns_c_key(d.name))
                out = cb(out, "_")
                out = cb_upper(out, mk)
                if i + 1 < members.len { out = cb(out, ",") }
                out = cb(out, "\n")
                i++
            }
            out = cb(out, "} tk_tag_")
            out = cb_tysym(out, d.name)
            out = cb(out, ";\n\n")
            out = cb(out, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n    tk_tag_")
            out = cb_tysym(out, d.name)
            out = cb(out, " tag;\n    union {\n")
            var j = 0
            loop {
                if j >= members.len { break }
                var mem = members[j]
                var mk = match cg_member_key_texpr_str(prog, mem, checker::name_qualifier(d.name)) { str as s => s; error as err => return err }
                out = cb(out, "        ")
                out = match emit_type_expr(out, prog, mem, checker::name_qualifier(d.name)) { Cb as o => o; error as err => return err }
                out = cb(out, " ")
                out = cb_str(out, mk)
                out = cb(out, ";\n")
                j++
            }
            out = cb(out, "    } as;\n} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::EnumBody as eb => {
            var out = cb(buf, "typedef enum ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= eb.members.len { break }
                out = cb(out, "    TK_E_")
                out = cb_upper(out, checker::name_last_segment(d.name))
                out = cb(out, "_")
                out = cb_upper(out, eb.members[i])
                if i + 1 < eb.members.len { out = cb(out, ",") }
                out = cb(out, "\n")
                i++
            }
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::AliasBody => {
            buf
        }
        parser::NewtypeBody as nb => match emit_newtype_typedef(buf, prog, d, nb) { Cb as x => x; error as err => return err }
        parser::FlagsBody as fb => emit_flags_typedef(buf, d, fb)
        parser::ExternBody => {
            var o = cb(buf, "typedef void *")
            o = mangle_type_name(o, "", d.name)
            cb(o, ";\n\n")
        }
        parser::ExternStructBody as esb => match emit_extern_struct_typedef(buf, prog, d, esb) { Cb as x => x; error as err => return err }
    }
}

fn emit_extern_struct_typedef(buf: Cb, prog: CgProg, d: parser::TypeDecl, esb: parser::ExternStructBody): Cb | error {
    var out = cb(buf, "typedef struct ")
    out = mangle_type_name(out, "", d.name)
    out = cb(out, " {\n")
    var i = 0
    loop {
        if i >= esb.fields.len { break }
        out = cb(out, "    ")
        out = match emit_type_expr(out, prog, esb.fields[i].type_ann, checker::name_qualifier(d.name)) { Cb as o => o; error as err => return err }
        out = cb(out, " ")
        out = cb_str(out, esb.fields[i].name)
        out = cb(out, ";\n")
        i++
    }
    out = cb(out, "} ")
    out = mangle_type_name(out, "", d.name)
    cb(out, ";\n\n")
}

type CgTypeSet = struct {
    inners: []@Type()
    opt_keys: []str
    slices: []@Type()
    slice_keys: []str
    variants: []@Type()
    variant_keys: []str
}

fn cg_opt_key(t: @Type()): str {
    match cg_opt_mangle(cb_new(), t) { Cb as o => str(cb_flat(o)); error => "" }
}
fn cg_slice_add(set: CgTypeSet, elem: @Type()): CgTypeSet {
    var key = cg_opt_key(elem)
    if key == "" { return set }
    var i = 0
    loop {
        if i >= set.slice_keys.len { break }
        if set.slice_keys[i] == key { return set }
        i++
    }
    CgTypeSet { inners = set.inners; opt_keys = set.opt_keys; slices = teko::list::push(set.slices, elem); slice_keys = teko::list::push(set.slice_keys, key); variants = set.variants; variant_keys = set.variant_keys }
}
fn cg_variant_key(t: @Type()): str {
    match t {
        checker::Variant as v => match cg_variant_typename(cb_new(), v) { Cb as o => str(cb_flat(o)); error => "" }
        _ => ""
    }
}
fn cg_variant_add(set: CgTypeSet, t: @Type()): CgTypeSet {
    var key = cg_variant_key(t)
    if key == "" { return set }
    var i = 0
    loop {
        if i >= set.variant_keys.len { break }
        if set.variant_keys[i] == key { return set }
        i++
    }
    CgTypeSet { inners = set.inners; opt_keys = set.opt_keys; slices = set.slices; slice_keys = set.slice_keys; variants = teko::list::push(set.variants, t); variant_keys = teko::list::push(set.variant_keys, key) }
}
fn cg_collect_type_opts(set: CgTypeSet, t: @Type()): CgTypeSet {
    match t {
        checker::Slice as sl => match sl.element {
            checker::Void => set
            _ => cg_slice_add(cg_collect_type_opts(set, sl.element), sl.element)
        }
        checker::Variant as va => {
            var s = set
            var i = 0
            loop {
                if i >= va.members.len { break }
                s = cg_collect_type_opts(s, va.members[i])
                i++
            }
            cg_variant_add(s, t)
        }
        _ => set
    }
}
fn cg_collect_expr_opts(set: CgTypeSet, e: checker::TExpr): CgTypeSet {
    var s = cg_collect_type_opts(set, e.type)
    match e.kind {
        checker::TBinary as b => { s = cg_collect_expr_opts(s, b.left); s = cg_collect_expr_opts(s, b.right) }
        checker::TUnary as u => { s = cg_collect_expr_opts(s, u.operand) }
        checker::TCompare as c => {
            s = cg_collect_expr_opts(s, c.first)
            var i = 0
            loop { if i >= c.rest.len { break }; s = cg_collect_expr_opts(s, c.rest[i].operand); i++ }
        }
        checker::TCall as cl => { var i = 0; loop { if i >= cl.args.len { break }; s = cg_collect_expr_opts(s, cl.args[i]); i++ } }
        checker::TIfExpr as f => {
            s = cg_collect_expr_opts(s, f.cond)
            s = cg_collect_block_opts(s, f.then_blk)
            s = cg_collect_block_opts(s, f.else_blk)
        }
        checker::TMatchExpr as m => {
            s = cg_collect_expr_opts(s, m.subject)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cg_collect_expr_opts(s, m.arms[i].guard) }
                s = cg_collect_block_opts(s, m.arms[i].body)
                i++
            }
        }
        checker::TCast as c => { s = cg_collect_expr_opts(s, c.expr) }
        checker::TFieldAccess as fa => { s = cg_collect_expr_opts(s, fa.receiver) }
        checker::TStructInit as si => { var i = 0; loop { if i >= si.field_vals.len { break }; s = cg_collect_expr_opts(s, si.field_vals[i]); i++ } }
        checker::TIndex as ix => { s = cg_collect_expr_opts(s, ix.receiver); s = cg_collect_expr_opts(s, ix.index) }
        checker::TInterp as in => {
            var i = 0
            loop {
                if i >= in.holes.len { break }
                s = cg_collect_expr_opts(s, in.holes[i])
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; s = cg_collect_expr_opts(s, fd.args[k]); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
        }
        checker::TInExpr as ie => { s = cg_collect_expr_opts(s, ie.lhs); var i = 0; loop { if i >= ie.elems.len { break }; s = cg_collect_expr_opts(s, ie.elems[i]); i++ } }
        checker::TLambda as lam => {
            var i = 0
            loop { if i >= lam.params.len { break }; s = cg_collect_type_opts(s, lam.params[i].type); i++ }
            s = cg_collect_type_opts(s, lam.ret)
            s = cg_collect_block_opts(s, lam.body)
        }
        checker::TBlockExpr as blk => { s = cg_collect_block_opts(s, blk.body) }
        _ => { }
    }
    s
}
fn cg_collect_block_opts(set: CgTypeSet, stmts: []@TStatement()): CgTypeSet {
    var s = set
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => { s = cg_collect_type_opts(s, b.bound); s = cg_collect_expr_opts(s, b.value) }
            checker::TAssign as a => { s = cg_collect_type_opts(s, a.bound); s = cg_collect_expr_opts(s, a.value); if parser::assign_has_target(a.kind) { s = cg_collect_expr_opts(s, a.target) } }
            checker::TReturn as r => { if r.has_value { s = cg_collect_expr_opts(s, r.value) } }
            checker::TLoopStmt as l => { s = cg_collect_block_opts(s, l.init); s = cg_collect_block_opts(s, l.body) }
            checker::TExprStmt as es => { s = cg_collect_expr_opts(s, es.expr) }
            checker::TDeferStmt as d => { s = cg_collect_block_opts(s, d.body) }
            checker::TAdoptStmt as a => { s = cg_collect_block_opts(s, a.body) }
            checker::TBlockStmt as b => { s = cg_collect_block_opts(s, b.body) }
            _ => { }
        }
        i++
    }
    s
}
fn cg_te_to_type_ns(prog: CgProg, ref_ns: str, te: @TypeExpr()): @Type() {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if last == "u8" { checker::Prim { kind = checker::PrimKind::U8 } }
            else if last == "u16" { checker::Prim { kind = checker::PrimKind::U16 } }
            else if last == "u32" { checker::Prim { kind = checker::PrimKind::U32 } }
            else if last == "u64" { checker::Prim { kind = checker::PrimKind::U64 } }
            else if last == "i8" { checker::Prim { kind = checker::PrimKind::I8 } }
            else if last == "i16" { checker::Prim { kind = checker::PrimKind::I16 } }
            else if last == "i32" { checker::Prim { kind = checker::PrimKind::I32 } }
            else if last == "i64" { checker::Prim { kind = checker::PrimKind::I64 } }
            else if last == "f32" { checker::Prim { kind = checker::PrimKind::F32 } }
            else if last == "f64" { checker::Prim { kind = checker::PrimKind::F64 } }
            else if last == "bool" { checker::Prim { kind = checker::PrimKind::Bool } }
            else if last == "usize" { checker::Prim { kind = checker::PrimKind::Usize } }
            else if last == "size" { checker::Prim { kind = checker::PrimKind::Size } }
            else if last == "byte" { checker::Byte { } }
            else if last == "str" { checker::Str { } }
            else if last == "error" { checker::Error { } }
            else if last == "void" { checker::Void { } }
            else if last == "()" { checker::Void { } }
            else if last == "null" { checker::Null { } }
            else if last == "uptr" { checker::Uptr { } }
            else if last == "Ref" { if nt.args.len > 0 { checker::Reference { inner = cg_te_to_type_ns(prog, ref_ns, nt.args[0]) } } else { checker::Reference { inner = checker::Void { } } } }
            else if last == "ptr" { checker::Ptr { inner = null } }
            else { checker::Named { name = cg_te_canonical_name(prog, ref_ns, nt.path, last) } }
        }
        parser::SliceType as st => checker::Slice { element = cg_te_to_type_ns(prog, ref_ns, st.element) }
        parser::SizedArrayType as sa => checker::Slice { element = cg_te_to_type_ns(prog, ref_ns, sa.element) }
        parser::UnionType as ut => {
            var mn = ut.members.len
            var mem: [mn]@Type() = []
            var i = 0
            loop {
                if i >= ut.members.len { break }
                mem[i] = cg_te_to_type_ns(prog, ref_ns, ut.members[i])
                i++
            }
            checker::Variant { members = cg_union_normalize_null(mem) }
        }
        parser::FunctionType => checker::Func { params = teko::list::empty(); ret = checker::Void { }; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = teko::list::empty() }
        parser::MacroType => checker::Void { }
    }
}

fn cg_te_canonical_name(prog: CgProg, ref_ns: str, path: parser::Path, last: str): str {
    match cg_find_decl_ns(prog, path, ref_ns) {
        parser::TypeDecl as d => d.name
        error => last
    }
}

fn cg_register_decl_field_types(set: CgTypeSet, prog: CgProg, d: parser::TypeDecl): CgTypeSet {
    var ref_ns = checker::name_qualifier(d.name)
    match d.body {
        parser::StructBody as sb => cg_register_field_list(set, prog, ref_ns, sb.fields)
        parser::VariantBody as vb => cg_register_variant_body(set, prog, ref_ns, vb.type_expr)
        parser::AliasBody as alb => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, alb.alias))
        _ => set
    }
}

fn cg_register_field_list(set: CgTypeSet, prog: CgProg, ref_ns: str, fields: []parser::Field): CgTypeSet {
    var s = set
    var fi = 0
    loop {
        if fi >= fields.len { break }
        s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, fields[fi].type_ann))
        fi++
    }
    s
}

fn cg_register_variant_body(set: CgTypeSet, prog: CgProg, ref_ns: str, te: @TypeExpr()): CgTypeSet {
    match te {
        parser::UnionType as ut => {
            var s = set
            var mi = 0
            loop {
                if mi >= ut.members.len { break }
                s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, ut.members[mi]))
                mi++
            }
            s
        }
        _ => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, te))
    }
}

fn cg_emit_inline_variant_typedef(buf: Cb, prog: CgProg, v: checker::Variant): Cb | error {
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt14 => return buf
        null => { }
    }
    match cg_union_box_member(prog, v) {
        (@Type()) as _gt15 => return buf
        null => { }
    }
    var out = cb(buf, "typedef enum tk_tag")
    var a = 0
    loop {
        if a >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[a]) { Cb as o => o; error as err => return err }
        a++
    }
    out = cb(out, " {\n")
    var i = 0
    loop {
        if i >= v.members.len { break }
        out = cb(out, "    TK_TAG_U")
        var j = 0
        loop {
            if j >= v.members.len { break }
            out = cb(out, "_")
            var kj = match cg_member_key_str(v.members[j]) { str as s => s; error as err => return err }
            out = cb_upper(out, kj)
            j++
        }
        out = cb(out, "_")
        var ki = match cg_member_key_str(v.members[i]) { str as s => s; error as err => return err }
        out = cb_upper(out, ki)
        if i + 1 < v.members.len { out = cb(out, ",") }
        out = cb(out, "\n")
        i++
    }
    out = cb(out, "} tk_tag")
    var b = 0
    loop {
        if b >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[b]) { Cb as o => o; error as err => return err }
        b++
    }
    out = cb(out, ";\n")
    out = cb(out, "typedef struct ")
    out = match cg_variant_typename(out, v) { Cb as o => o; error as err => return err }
    out = cb(out, " {\n    ")
    out = match cg_union_tag_ctype(out, v) { Cb as o => o; error as err => return err }
    out = cb(out, " tag;\n    union {\n")
    var m = 0
    loop {
        if m >= v.members.len { break }
        out = cb(out, "        ")
        out = match emit_type(out, prog, v.members[m]) { Cb as o => o; error as err => return err }
        out = cb(out, " ")
        out = match cg_member_key(out, v.members[m]) { Cb as o => o; error as err => return err }
        out = cb(out, ";\n")
        m++
    }
    out = cb(out, "    } as;\n} ")
    out = match cg_variant_typename(out, v) { Cb as o => o; error as err => return err }
    cb(out, ";\n")
}

type CgEmitted = struct { names: []str; opt_keys: []str; uvar_keys: []str }

fn cg_str_in(xs: []str, s: str): bool {
    var i = 0
    loop { if i >= xs.len { break }; if xs[i] == s { return true }; i++ }
    false
}
fn cg_find_decl_exact(prog: CgProg, name: str): parser::TypeDecl | error {
    if prog.ix.exact.slots.len != 0 { return cg_decl_at(prog, cg_table_get(prog.ix.exact, name)) }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == name { return d } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such type decl" }
}
fn cg_named_emitted_precise(prog: CgProg, em: CgEmitted, name: str): bool {
    if checker::name_qualifier(name) != "" {
        match cg_find_decl_exact(prog, name) {
            parser::TypeDecl as dd => {
                var gate = match dd.body { parser::StructBody => true; parser::VariantBody => true; _ => false }
                if gate { return cg_str_in(em.names, name) }
            }
            error => { }
        }
    }
    cg_named_emitted(em, name)
}
fn cg_named_emitted(em: CgEmitted, name: str): bool {
    var want = checker::name_last_segment(name)
    var i = 0
    loop {
        if i >= em.names.len { break }
        if checker::name_last_segment(em.names[i]) == want { return true }
        i++
    }
    false
}
fn cg_uvar_emitted_key(em: CgEmitted, set: CgTypeSet, key: str): bool {
    var i = 0
    var present = false
    loop {
        if i >= set.variant_keys.len { break }
        if set.variant_keys[i] == key { present = true; break }
        i++
    }
    if !present { return true }
    cg_str_in(em.uvar_keys, key)
}
fn cg_type_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, t: @Type()): bool {
    match t {
        checker::Named as nm => if cg_is_class_named(prog, nm.name) { true } else { cg_named_emitted_precise(prog, em, nm.name) }
        checker::Variant as va => cg_uvar_emitted_key(em, set, cg_variant_key(t))
        checker::Slice => true
        _ => true
    }
}
fn cg_is_builtin_scalar(last: str): bool {
    last == "u8" || last == "u16" || last == "u32" || last == "u64" ||
    last == "i8" || last == "i16" || last == "i32" || last == "i64" ||
    last == "f32" || last == "f64" || last == "bool" || last == "byte" ||
    last == "usize" || last == "size" ||
    last == "str" || last == "error" || last == "ptr" || last == "uptr" ||
    last == "Ref"
}
fn cg_texpr_union_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, ut: parser::UnionType, owner_ns: str): bool {
    if !cg_texpr_union_has_null(ut) {
        return cg_uvar_emitted_key(em, set, match cg_variant_typename_texpr(cb_new(), prog, ut, owner_ns) { Cb as o => str(cb_flat(o)); error => "" })
    }
    var resolved = cg_te_to_type_ns(prog, owner_ns, parser::UnionType { members = ut.members })
    var va = match resolved { checker::Variant as v => v; _ => return cg_uvar_emitted_key(em, set, match cg_variant_typename_texpr(cb_new(), prog, ut, owner_ns) { Cb as o => str(cb_flat(o)); error => "" }) }
    match cg_union_niche_member(prog, va) { (@Type()) as _gt16 => return true; null => { } }
    match cg_union_box_member(prog, va) { (@Type()) as _gt17 => return true; null => { } }
    cg_uvar_emitted_key(em, set, cg_variant_key(va))
}
fn cg_texpr_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, te: @TypeExpr(), owner_ns: str): bool {
    match te {
        parser::NamedType as nt => {
            var stem = nt.path.segments[nt.path.segments.len - 1].name
            if cg_is_builtin_scalar(stem) { return true }
            if cg_is_class_named(prog, stem) { return true }
            if nt.args.len > 0 { return cg_named_emitted(em, cg_texpr_inst_name(stem, nt.args)) }
            var want = match cg_find_decl_ns(prog, nt.path, owner_ns) { parser::TypeDecl as dd => dd.name; error => stem }
            cg_named_emitted_precise(prog, em, want)
        }
        parser::SliceType => true
        parser::SizedArrayType => true
        parser::UnionType as ut => cg_texpr_union_ready(prog, em, set, ut, owner_ns)
        parser::FunctionType => true
        parser::MacroType => false
    }
}
fn cg_named_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, d: parser::TypeDecl): bool {
    var owner_ns = checker::name_qualifier(d.name)
    match d.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { i++ } else {
                    if !cg_texpr_ready(prog, em, set, sb.fields[i].type_ann, owner_ns) { return false }
                    i++
                }
            }
            true
        }
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => {
                var i = 0
                loop {
                    if i >= u.members.len { break }
                    if !cg_texpr_ready(prog, em, set, u.members[i], owner_ns) { return false }
                    i++
                }
                true
            }
            _ => true
        }
        parser::ClassBody as cb2 => {
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return true }
            var i = 0
            loop {
                if i >= fields.len { break }
                if !cg_texpr_ready(prog, em, set, fields[i].type_ann, owner_ns) { return false }
                i++
            }
            true
        }
        _ => true
    }
}

fn cg_named_decls(prog: CgProg): []parser::TypeDecl {
    var named: []parser::TypeDecl = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { named = teko::list::push(named, d) }
            _ => { }
        }
        i++
    }
    named
}

fn cg_emit_types_ordered(buf: Cb, prog: CgProg): Cb | error {
    var set = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                set = cg_collect_type_opts(set, f.return_type)
                set = cg_collect_block_opts(set, f.body)
            }
            (@TStatement()) as st => { set = cg_collect_block_opts(set, teko::list::push(teko::list::empty(), st)) }
            _ => { }
        }
        i++
    }
    var td = 0
    loop {
        if td >= prog.items.len { break }
        match prog.items[td] {
            parser::TypeDecl as d => { set = cg_register_decl_field_types(set, prog, d) }
            _ => { }
        }
        td++
    }
    var named = cg_named_decls(prog)

    var out = buf
    var em0 = CgEmitted { names = teko::list::empty(); opt_keys = teko::list::empty(); uvar_keys = teko::list::empty() }
    var enum_count: u64 = 0
    var ei = 0
    loop {
        if ei >= named.len { break }
        var is_enum_or_flags = match named[ei].body {
            parser::EnumBody => true
            parser::FlagsBody => true
            _ => false
        }
        if is_enum_or_flags {
            out = match emit_type_decl(out, prog, named[ei]) { Cb as o => o; error as err => return err }
            em0 = CgEmitted { names = teko::list::push(em0.names, named[ei].name); opt_keys = em0.opt_keys; uvar_keys = em0.uvar_keys }
            enum_count = enum_count + 1
        }
        ei++
    }
    if enum_count > 0 { out = cb(out, "\n") }
    var fv = 0
    loop {
        if fv >= set.variants.len { break }
        match set.variants[fv] {
            checker::Variant as va => {
                out = cb(out, "typedef struct ")
                out = match cg_variant_typename(out, va) { Cb as o => o; error as err => return err }
                out = cb(out, " ")
                out = match cg_variant_typename(out, va) { Cb as o => o; error as err => return err }
                out = cb(out, ";\n")
            }
            _ => { }
        }
        fv++
    }
    if set.variants.len > 0 { out = cb(out, "\n") }

    var k = 0
    loop {
        if k >= set.slices.len { break }
        match set.slices[k] { Char => { k++; continue }; _ => { } }
        match set.slices[k] { Byte => { k++; continue }; _ => { } }
        out = cb(out, "typedef struct { ")
        out = match emit_type(out, prog, set.slices[k]) { Cb as o => o; error as err => return err }
        out = cb(out, " *ptr; uint64_t len; uint64_t cap; } ")
        out = match cg_slice_typename(out, set.slices[k]) { Cb as o => o; error as err => return err }
        out = cb(out, ";\n")
        k++
    }
    if set.slices.len > 0 { out = cb(out, "\n") }

    var em = em0
    var remaining = named.len + set.variants.len - enum_count
    var progress = true
    loop {
        if remaining == 0 { break }
        if !progress { break }
        progress = false
        var ni = 0
        loop {
            if ni >= named.len { break }
            var d = named[ni]
            if cg_str_in(em.names, d.name) { ni++ } else {
                if !cg_named_ready(prog, em, set, d) { ni++ } else {
                    out = match emit_type_decl(out, prog, d) { Cb as o => o; error as err => return err }
                    em = CgEmitted { names = teko::list::push(em.names, d.name); opt_keys = em.opt_keys; uvar_keys = em.uvar_keys }
                    remaining = remaining - 1
                    progress = true
                    ni++
                }
            }
        }
        var vi = 0
        loop {
            if vi >= set.variants.len { break }
            var vt = set.variants[vi]
            var vkey = set.variant_keys[vi]
            if cg_str_in(em.uvar_keys, vkey) { vi++ } else {
                var ready = true
                match vt {
                    checker::Variant as va => {
                        var m = 0
                        loop {
                            if m >= va.members.len { break }
                            if !cg_type_ready(prog, em, set, va.members[m]) { ready = false; break }
                            m++
                        }
                    }
                    _ => { }
                }
                if !ready { vi++ } else {
                    match vt {
                        checker::Variant as va => { out = match cg_emit_inline_variant_typedef(out, prog, va) { Cb as o => o; error as err => return err } }
                        _ => { }
                    }
                    em = CgEmitted { names = em.names; opt_keys = em.opt_keys; uvar_keys = teko::list::push(em.uvar_keys, vkey) }
                    remaining = remaining - 1
                    progress = true
                    vi++
                }
            }
        }
    }
    if remaining > 0 { return error { message = "codegen: cyclic value-type dependency (a recursive type must pass through a slice or a boxed reference)" } }
    out
}

fn fmt_indent(buf: Cb, depth: u64): Cb {
    var b = buf
    var k: u64 = 0
    loop {
        if k >= depth { break }
        b = cb(b, "    ")
        k = k + 1
    }
    b
}

fn cg_format_c(src: str): []byte {
    var out: Cb = cb_new()
    var depth: u64 = 0
    var stk = ""
    var line_start = true
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        var c = src[i]
        if c == b'#' && line_start {
            loop {
                if i >= src.len { break }
                if src[i] == b'\n' { break }
                out = cb_byte(out, src[i])
                i = i + 1
            }
            out = cb(out, "\n")
            if i < src.len { i = i + 1 }
            line_start = true
        } else if c == b'/' && i + 1 < src.len && src[i + 1] == b'/' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            loop {
                if i >= src.len { break }
                if src[i] == b'\n' { break }
                out = cb_byte(out, src[i])
                i = i + 1
            }
            out = cb(out, "\n")
            if i < src.len { i = i + 1 }
            line_start = true
        } else if c == b'"' || c == b'\'' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            var q = c
            out = cb_byte(out, c)
            i = i + 1
            loop {
                if i >= src.len { break }
                if src[i] == q { break }
                if src[i] == b'\\' && i + 1 < src.len {
                    out = cb_byte(out, src[i])
                    out = cb_byte(out, src[i + 1])
                    i = i + 2
                } else {
                    out = cb_byte(out, src[i])
                    i = i + 1
                }
            }
            if i < src.len && src[i] == q {
                out = cb_byte(out, q)
                i = i + 1
            }
        } else if c == b' ' || c == b'\t' || c == b'\n' || c == b'\r' {
            loop {
                if i >= src.len { break }
                var w = src[i]
                if w != b' ' && w != b'\t' && w != b'\n' && w != b'\r' { break }
                i = i + 1
            }
            var suppress = i < src.len && (src[i] == b'}' || src[i] == b'{' || src[i] == b';')
            if !line_start && !suppress && out.len > 0 && cb_last(out) != b' ' { out = cb(out, " ") }
        } else if c == b'{' {
            var is_block = out.len > 0 && cb_last(out) == b')'
            if line_start { out = fmt_indent(out, depth) } else { out = cb(out, " ") }
            out = cb(out, "{\n")
            stk = teko::str::concat(stk, if is_block { "B" } else { "b" })
            depth = depth + 1
            line_start = true
            i = i + 1
        } else if c == b'}' {
            var was_block = stk.len > 0 && stk[stk.len - 1] == b'B'
            if depth > 0 { depth = depth - 1 }
            if stk.len > 0 { stk = teko::str::slice_to(stk, stk.len - 1) }
            if !line_start { out = cb(out, "\n") }
            out = fmt_indent(out, depth)
            out = cb(out, "}")
            if depth == 0 && was_block { out = cb(out, "\n\n"); line_start = true }
            else { line_start = false }
            i = i + 1
        } else if c == b';' {
            out = cb(out, ";")
            var brace_top = stk.len == 0 || stk[stk.len - 1] == b'B' || stk[stk.len - 1] == b'b'
            if brace_top { out = cb(out, "\n"); line_start = true }
            else {
                if out.len > 0 && cb_last(out) != b' ' { out = cb(out, " ") }
                line_start = false
            }
            i = i + 1
        } else if c == b'(' || c == b'[' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            stk = teko::str::concat(stk, if c == b'(' { "(" } else { "[" })
            out = cb_byte(out, c)
            i = i + 1
        } else if c == b')' || c == b']' {
            if stk.len > 0 { stk = teko::str::slice_to(stk, stk.len - 1) }
            out = cb_byte(out, c)
            i = i + 1
        } else {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            out = cb_byte(out, c)
            i = i + 1
        }
    }
    cb_flat(cb(out, "\n"))
}

type StampAcc = struct { next: u64; next_spawn: u64; fns: []checker::TFunction; lams: []checker::TLambda; spawns: []checker::TSpawn }
type LiftResult = struct { prog: checker::TProgram; lams: []checker::TLambda; spawns: []checker::TSpawn }

fn cg_lift_lambdas(prog: CgProg): LiftResult {
    var acc = StampAcc { next = 0; next_spawn = 0; fns = teko::list::empty(); lams = teko::list::empty(); spawns = teko::list::empty() }
    var items: []@TItem() = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                var nb = cg_lift_block(f.body, acc)
                items = teko::list::push(items, checker::TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = nb; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = f.ret_extra; guard = f.guard })
            }
            (@TStatement()) as ts => {
                var ns = cg_lift_stmt(ts, acc)
                items = teko::list::push(items, ns)
            }
            _ => items = teko::list::push(items, prog.items[i])
        }
        i++
    }
    var j = 0
    loop { if j >= acc.fns.len { break }; items = teko::list::push(items, acc.fns[j]); j++ }
    LiftResult { prog = checker::TProgram { items = items }; lams = acc.lams; spawns = acc.spawns }
}
fn cg_lift_block(stmts: []@TStatement(), ref acc: StampAcc): []@TStatement() {
    var out: []@TStatement() = teko::list::empty()
    var i = 0
    loop { if i >= stmts.len { break }; out = teko::mem::push_fo(out, cg_lift_stmt(stmts[i], acc)); i++ }
    out
}
fn cg_lift_stmt(s: @TStatement(), ref acc: StampAcc): @TStatement() {
    match s {
        checker::TBinding as b => checker::TBinding { kind = b.kind; target = b.target; bound = b.bound; value = cg_lift_expr(b.value, acc) }
        checker::TAssign as a => checker::TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = cg_lift_expr(a.value, acc); deref = a.deref; target = if parser::assign_has_target(a.kind) { cg_lift_expr(a.target, acc) } else { a.target } }
        checker::TReturn as r => checker::TReturn { has_value = r.has_value; value = if r.has_value { cg_lift_expr(r.value, acc) } else { r.value }; values = teko::list::empty() }
        checker::TLoopStmt as l => checker::TLoopStmt { label = l.label; init = cg_lift_block(l.init, acc); body = cg_lift_block(l.body, acc) }
        checker::TExprStmt as es => checker::TExprStmt { expr = cg_lift_expr(es.expr, acc) }
        checker::TDeferStmt as d => checker::TDeferStmt { body = cg_lift_block(d.body, acc) }
        checker::TAdoptStmt as a => checker::TAdoptStmt { name = a.name; body = cg_lift_block(a.body, acc) }
        checker::TBlockStmt as b => checker::TBlockStmt { body = cg_lift_block(b.body, acc) }
        checker::TBreakStmt => s
        checker::TContinueStmt => s
        checker::TSpawn as sp => {
            var k = acc.next_spawn
            acc = StampAcc { next = acc.next; next_spawn = k + 1; fns = acc.fns; lams = acc.lams; spawns = acc.spawns }
            var stamped = checker::TSpawn { call = cg_lift_expr(sp.call, acc); id = k }
            acc = StampAcc { next = acc.next; next_spawn = acc.next_spawn; fns = acc.fns; lams = acc.lams; spawns = teko::list::push(acc.spawns, stamped) }
            stamped
        }
    }
}
fn cg_lift_expr(e: checker::TExpr, ref acc: StampAcc): checker::TExpr {
    match e.kind {
        checker::TLambda as lam => {
            var id = acc.next
            acc = StampAcc { next = id + 1; next_spawn = acc.next_spawn; fns = acc.fns; lams = acc.lams; spawns = acc.spawns }
            var nbody = cg_lift_block(lam.body, acc)
            var newfns = acc.fns
            var newlams = acc.lams
            var stamped = checker::TLambda { params = lam.params; body = nbody; captures = lam.captures; ret = lam.ret; lift_id = id }
            if lam.captures.len == 0 {
                var ps: []parser::Param = teko::list::empty()
                var pi = 0
                loop { if pi >= lam.params.len { break }; ps = teko::list::push(ps, parser::Param { name = lam.params[pi].name; has_type = true; type_ann = checker::type_to_texpr(lam.params[pi].type); is_params = false; has_default = false; default_expr = parser::no_expr() }); pi++ }
                newfns = teko::list::push(newfns, checker::TFunction { overload_suffix = ""; name = lam_fn_name(id); type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = ps; return_type = lam.ret; body = nbody; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() })
            } else {
                newlams = teko::list::push(newlams, stamped)
            }
            acc = StampAcc { next = acc.next; next_spawn = acc.next_spawn; fns = newfns; lams = newlams; spawns = acc.spawns }
            checker::TExpr { kind = stamped; type = e.type; line = e.line; col = e.col }
        }
        checker::TBinary as b => checker::TExpr { kind = checker::TBinary { op = b.op; left = cg_lift_expr(b.left, acc); right = cg_lift_expr(b.right, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TUnary as u => checker::TExpr { kind = checker::TUnary { op = u.op; operand = cg_lift_expr(u.operand, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TCompare as c => {
            var terms: []checker::TCmpTerm = teko::list::empty()
            var i = 0
            loop { if i >= c.rest.len { break }; terms = teko::list::push(terms, checker::TCmpTerm { op = c.rest[i].op; operand = cg_lift_expr(c.rest[i].operand, acc) }); i++ }
            checker::TExpr { kind = checker::TCompare { first = cg_lift_expr(c.first, acc); rest = terms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCall as cl => {
            var args: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= cl.args.len { break }; args = teko::list::push(args, cg_lift_expr(cl.args[i], acc)); i++ }
            checker::TExpr { kind = checker::TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIfExpr as f => checker::TExpr { kind = checker::TIfExpr { cond = cg_lift_expr(f.cond, acc); then_blk = cg_lift_block(f.then_blk, acc); has_else = f.has_else; else_blk = cg_lift_block(f.else_blk, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TMatchExpr as m => {
            var arms: []checker::TArm = teko::list::empty()
            var i = 0
            loop { if i >= m.arms.len { break }; var a = m.arms[i]; arms = teko::list::push(arms, checker::TArm { pattern = a.pattern; has_when = a.has_when; guard = if a.has_when { cg_lift_expr(a.guard, acc) } else { a.guard }; body = cg_lift_block(a.body, acc) }); i++ }
            checker::TExpr { kind = checker::TMatchExpr { subject = cg_lift_expr(m.subject, acc); arms = arms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCast as ct => checker::TExpr { kind = checker::TCast { expr = cg_lift_expr(ct.expr, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TFieldAccess as fa => checker::TExpr { kind = checker::TFieldAccess { receiver = cg_lift_expr(fa.receiver, acc); field = fa.field }; type = e.type; line = e.line; col = e.col }
        checker::TStructInit as si => {
            var vals: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= si.field_vals.len { break }; vals = teko::list::push(vals, cg_lift_expr(si.field_vals[i], acc)); i++ }
            checker::TExpr { kind = checker::TStructInit { field_names = si.field_names; field_vals = vals }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIndex as ix => checker::TExpr { kind = checker::TIndex { receiver = cg_lift_expr(ix.receiver, acc); index = cg_lift_expr(ix.index, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TInterp as in => {
            var holes: []checker::TExpr = teko::list::empty()
            var specs: []checker::TFSpec = teko::list::empty()
            var i = 0
            loop {
                if i >= in.holes.len { break }
                holes = teko::list::push(holes, cg_lift_expr(in.holes[i], acc))
                if i < in.specs.len {
                    var sp = in.specs[i]
                    var lifted_sp = match sp.kind {
                        checker::TFSpecDynamic as fd => {
                            var args: []checker::TExpr = teko::list::empty()
                            var k = 0
                            loop { if k >= fd.args.len { break }; args = teko::list::push(args, cg_lift_expr(fd.args[k], acc)); k++ }
                            checker::TFSpec { kind = checker::TFSpecDynamic { args = args } }
                        }
                        _ => sp
                    }
                    specs = teko::list::push(specs, lifted_sp)
                }
                i++
            }
            checker::TExpr { kind = checker::TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = e.type; line = e.line; col = e.col }
        }
        checker::TInExpr as ie => {
            var elems: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= ie.elems.len { break }; elems = teko::list::push(elems, cg_lift_expr(ie.elems[i], acc)); i++ }
            checker::TExpr { kind = checker::TInExpr { lhs = cg_lift_expr(ie.lhs, acc); elems = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TArrayLit as a => {
            var elems: []checker::TArrayElem = teko::list::empty()
            var i = 0
            loop { if i >= a.elements.len { break }; elems = teko::list::push(elems, checker::TArrayElem { is_spread = a.elements[i].is_spread; expr = cg_lift_expr(a.elements[i].expr, acc) }); i++ }
            checker::TExpr { kind = checker::TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TBlockExpr as blk => checker::TExpr { kind = checker::TBlockExpr { body = cg_lift_block(blk.body, acc) }; type = e.type; line = e.line; col = e.col }
        _ => e
    }
}

fn cg_emit_lambda_decls(buf: Cb, prog: CgProg, lams: []checker::TLambda, protos_only: bool): Cb | error {
    var out = buf
    var li = 0
    loop {
        if li >= lams.len { break }
        var lam = lams[li]
        var ids = teko::u64_to_str(lam.lift_id)
        if protos_only {
            out = cb(out, "typedef struct { ")
            var ci = 0
            loop {
                if ci >= lam.captures.len { break }
                out = match emit_type(out, prog, lam.captures[ci].type) { Cb as o => o; error as e => return e }
                out = cb(out, " ")
                out = cb_ident(out, lam.captures[ci].name)
                out = cb(out, "; ")
                ci++
            }
            out = cb(out, teko::str::concat("} __tkenv_", ids, ";\n"))
        }
        out = match emit_type(out, prog, lam.ret) { Cb as o => o; error as e => return e }
        out = cb(out, " ")
        out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
        out = cb(out, "(void *envp")
        var pi = 0
        loop {
            if pi >= lam.params.len { break }
            out = cb(out, ", ")
            out = match emit_type(out, prog, lam.params[pi].type) { Cb as o => o; error as e => return e }
            out = cb(out, " ")
            out = cb_ident(out, lam.params[pi].name)
            pi++
        }
        out = cb(out, ")")
        if protos_only {
            out = cb(out, ";\n")
        } else {
            out = cb(out, " {\n")
            out = cb(out, teko::str::concat("    __tkenv_", ids, " *_e = envp;\n"))
            var ui = 0
            loop {
                if ui >= lam.captures.len { break }
                out = cb(out, "    ")
                out = match emit_type(out, prog, lam.captures[ui].type) { Cb as o => o; error as e => return e }
                out = cb(out, " ")
                out = cb_ident(out, lam.captures[ui].name)
                out = cb(out, " = _e->")
                out = cb_ident(out, lam.captures[ui].name)
                out = cb(out, ";\n")
                ui++
            }
            out = match emit_block_tail(out, lam.body, false, prog, lam.ret, "    ", "", teko::list::empty(), lam.body, dctx_empty()) { Cb as o => o; error as e => return e }
            out = cb(out, "}\n")
        }
        li++
    }
    out
}

fn cb_vtthunk_name(buf: Cb, cd_name: str, idd_name: str, method: str): Cb {
    cb_ident(cb(cb_tysym(cb(cb_tysym(cb(buf, "tk_vtthunk_"), cd_name), "__"), idd_name), "__"), method)
}

fn cg_emit_vtthunk_def(buf: Cb, prog: CgProg, cd_name: str, idd_name: str, mns: str, method: str): Cb | error {
    var f = match cg_find_function(prog, mns, method) { checker::TFunction as tf => tf; error => return error { message = "codegen: vtable thunk cannot resolve its concrete method (internal)" } }
    if f.params.len == 0 { return error { message = "codegen: vtable thunk method has no receiver parameter (internal)" } }
    var out = match emit_type(buf, prog, f.return_type) { Cb as o => o; error as err => return err }
    out = cb_vtthunk_name(cb(out, " "), cd_name, idd_name, method)
    out = cb(out, "(void *self")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        out = cb(out, ", ")
        out = match emit_type_expr(out, prog, f.params[pi].type_ann, f.namespace) { Cb as o => o; error as err => return err }
        out = cb(out, " ")
        out = cb_ident(out, f.params[pi].name)
        pi++
    }
    var returns_void = match f.return_type { checker::Void => true; _ => false }
    out = cb(out, ") { ")
    out = cb(out, if returns_void { "" } else { "return " })
    out = cb_fn_name(out, mns, method)
    out = cb(out, "(")
    out = match cg_emit_vtthunk_receiver(out, prog, cd_name, f.params[0].type_ann, f.namespace) { Cb as o => o; error as err => return err }
    var ai: u64 = 1
    loop {
        if ai >= f.params.len { break }
        out = cb(out, ", ")
        out = cb_ident(out, f.params[ai].name)
        ai++
    }
    cb(out, "); }\n")
}

fn cg_emit_vtthunk_receiver(buf: Cb, prog: CgProg, cd_name: str, recv_ann: @TypeExpr(), recv_ns: str): Cb | error {
    var thunk_base = cg_vtthunk_base_name(recv_ann)
    if thunk_base.len > 0 && cg_is_polymorphic_base(prog, thunk_base) {
        var out = cb_tysym(cb(buf, "(tk_base_"), thunk_base)
        out = cb(out, "){ .data = self, .vtable = ")
        out = cb_tysym(cb(cb_tysym(cb(out, "tk_vt_"), cd_name), "_"), thunk_base)
        return cb(out, " }")
    }
    var out = cb(buf, "(")
    out = match emit_type_expr(out, prog, recv_ann, recv_ns) { Cb as o => o; error as err => return err }
    cb(out, ")self")
}

fn cg_vtthunk_base_name(recv_ann: @TypeExpr()): str {
    match recv_ann {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => ""
    }
}

fn cg_method_is_instance(m: parser::Function): bool {
    m.params.len > 0 && !m.params[0].has_type
}

fn cg_emit_vtable_slot(buf: Cb, prog: CgProg, cd_name: str, idd_name: str, m: parser::Function): Cb | error {
    if cg_method_is_instance(m) {
        return cb_vtthunk_name(cb(buf, "(void *)&"), cd_name, idd_name, m.name)
    }
    var mns = match cg_find_method_ns(prog, cd_name, m.name) {
        str as ns2 => ns2
        null => return error { message = "codegen: conforming class is missing a vtable method's stamped function (internal)" }
    }
    cb_fn_name(cb(buf, "(void *)&"), mns, m.name)
}

fn cg_pair_is_iface_vtable(cd: parser::TypeDecl, idd: parser::TypeDecl, vt_table: checker::TypeTable): bool {
    var idd_is_iface = match idd.body { parser::InterfaceBody => true; _ => false }
    idd_is_iface && checker::type_conforms_to(cd.name, idd.name, vt_table)
}

fn cg_class_is_abstract(cd: parser::TypeDecl): bool {
    match cd.body {
        parser::ClassBody as cb => match cb.kind { parser::ClassKind::Abstract => true; _ => false }
        _ => false
    }
}

fn cg_pair_is_base_vtable(prog: CgProg, cd: parser::TypeDecl, idd: parser::TypeDecl): bool {
    var idd_is_poly_base = cg_is_polymorphic_base(prog, idd.name)
    var cd_is_instantiable_self = cd.name == idd.name && !cg_class_is_abstract(cd)
    var cd_is_a = cd_is_instantiable_self || cg_subclass_reaches(prog, cd.name, idd.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
    idd_is_poly_base && cd_is_a
}

fn cg_emit_vtable_def(buf: Cb, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function): Cb | error {
    var b = cb_tysym(cb(cb_tysym(cb(buf, "static void *const tk_vt_"), cd_name), "_"), idd_name)
    b = cb(b, "[] = {")
    if method_list.len == 0 { b = cb(b, " (void *)0") }
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        b = cb(b, if i == 0 { " " } else { ", " })
        b = match cg_emit_vtable_slot(b, prog, cd_name, idd_name, method_list[i]) { Cb as o => o; error as err => return err }
        i++
    }
    cb(b, " };\n")
}

fn cg_emit_vtable_thunks(buf: Cb, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function, emitted: []str): TThunkEmit | error {
    var b = buf
    var seen = emitted
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        var m = method_list[i]
        i++
        if !cg_method_is_instance(m) { continue }
        var key = str(cb_flat(cb_vtthunk_name(cb_new(), cd_name, idd_name, m.name)))
        if cg_str_in(seen, key) { continue }
        var mns = match cg_find_method_ns(prog, cd_name, m.name) {
            str as ns2 => ns2
            null => return error { message = "codegen: conforming class is missing a vtable method's stamped function (internal)" }
        }
        b = match cg_emit_vtthunk_def(b, prog, cd_name, idd_name, mns, m.name) { Cb as o => o; error as err => return err }
        seen = teko::list::push(seen, key)
    }
    TThunkEmit { buf = b; emitted = seen }
}

fn cg_emit_vtables_and_thunks(buf: Cb, prog: CgProg): Cb | error {
    var vt_table = cg_type_table(prog)
    var b = match cg_emit_vtable_protos(buf, prog, vt_table) { Cb as o => o; error as err => return err }
    b = match cg_emit_all_vtthunks(b, prog, vt_table) { Cb as o => o; error as err => return err }
    cg_emit_all_vtable_defs(b, prog, vt_table)
}

fn cg_emit_vtable_protos(buf: Cb, prog: CgProg, vt_table: checker::TypeTable): Cb | error {
    var b = buf
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) { b = cb(cb_tysym(cb(cb_tysym(cb(b, "static void *const tk_vt_"), cd.name), "_"), idd.name), "[];\n") }
                                if cg_pair_is_base_vtable(prog, cd, idd) { b = cb(cb_tysym(cb(cb_tysym(cb(b, "static void *const tk_vt_"), cd.name), "_"), idd.name), "[];\n") }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

fn cg_emit_all_vtthunks(buf: Cb, prog: CgProg, vt_table: checker::TypeTable): Cb | error {
    var b = buf
    var emitted: []str = teko::list::empty()
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: interface method list failed (internal)" } }
                                    var r = match cg_emit_vtable_thunks(b, prog, cd.name, idd.name, ms, emitted) { TThunkEmit as e => e; error as err => return err }
                                    b = r.buf; emitted = r.emitted
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: base method list failed (internal)" } }
                                    var r = match cg_emit_vtable_thunks(b, prog, cd.name, idd.name, bms, emitted) { TThunkEmit as e => e; error as err => return err }
                                    b = r.buf; emitted = r.emitted
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

fn cg_emit_all_vtable_defs(buf: Cb, prog: CgProg, vt_table: checker::TypeTable): Cb | error {
    var b = buf
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: interface method list failed (internal)" } }
                                    b = match cg_emit_vtable_def(b, prog, cd.name, idd.name, ms) { Cb as o => o; error as err => return err }
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: base method list failed (internal)" } }
                                    b = match cg_emit_vtable_def(b, prog, cd.name, idd.name, bms) { Cb as o => o; error as err => return err }
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

type SyscallUse = struct {
    s0: bool
    s1: bool
    s2: bool
    s3: bool
    s4: bool
    s5: bool
    s6: bool
    clone: bool
    atomics: bool
}

fn cg_syscall_use_none(): SyscallUse {
    SyscallUse { s0 = false; s1 = false; s2 = false; s3 = false; s4 = false; s5 = false; s6 = false; clone = false; atomics = false }
}

fn cg_mark_syscall_call(prog: CgProg, c: checker::TCall, used: SyscallUse): SyscallUse {
    if cg_call_is_user_declared(prog, c) { return used }
    var p = c.callee
    var qualifier_ok = p.segments.len == 1 || p.segments[0].name == "teko"
    if !qualifier_ok { return used }
    var last = p.segments[p.segments.len - 1].name
    if last == "syscall0" { return SyscallUse { s0 = true; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall1" { return SyscallUse { s0 = used.s0; s1 = true; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall2" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = true; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall3" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = true; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall4" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = true; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall5" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = true; s6 = used.s6; clone = used.clone; atomics = used.atomics } }
    if last == "syscall6" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = true; clone = used.clone; atomics = used.atomics } }
    if last == "thread_clone" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = true; atomics = used.atomics } }
    if last == "atomic_cas_u32" || last == "atomic_xchg_u32" || last == "atomic_add_u32" || last == "atomic_load_u32" { return SyscallUse { s0 = used.s0; s1 = used.s1; s2 = used.s2; s3 = used.s3; s4 = used.s4; s5 = used.s5; s6 = used.s6; clone = used.clone; atomics = true } }
    used
}

fn cg_scan_syscall_expr(prog: CgProg, e: checker::TExpr, used: SyscallUse): SyscallUse {
    match e.kind {
        checker::TLambda as lam => cg_scan_syscall_block(prog, lam.body, used)
        checker::TBinary as b => cg_scan_syscall_expr(prog, b.right, cg_scan_syscall_expr(prog, b.left, used))
        checker::TUnary as u => cg_scan_syscall_expr(prog, u.operand, used)
        checker::TCompare as c => {
            var acc = cg_scan_syscall_expr(prog, c.first, used)
            var i = 0
            loop { if i >= c.rest.len { break }; acc = cg_scan_syscall_expr(prog, c.rest[i].operand, acc); i++ }
            acc
        }
        checker::TCall as cl => {
            var acc = cg_mark_syscall_call(prog, cl, used)
            var i = 0
            loop { if i >= cl.args.len { break }; acc = cg_scan_syscall_expr(prog, cl.args[i], acc); i++ }
            acc
        }
        checker::TIfExpr as f => {
            var acc = cg_scan_syscall_block(prog, f.then_blk, cg_scan_syscall_expr(prog, f.cond, used))
            cg_scan_syscall_block(prog, f.else_blk, acc)
        }
        checker::TMatchExpr as m => {
            var acc = cg_scan_syscall_expr(prog, m.subject, used)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var a = m.arms[i]
                if a.has_when { acc = cg_scan_syscall_expr(prog, a.guard, acc) }
                acc = cg_scan_syscall_block(prog, a.body, acc)
                i++
            }
            acc
        }
        checker::TCast as ct => cg_scan_syscall_expr(prog, ct.expr, used)
        checker::TFieldAccess as fa => cg_scan_syscall_expr(prog, fa.receiver, used)
        checker::TStructInit as si => {
            var acc = used
            var i = 0
            loop { if i >= si.field_vals.len { break }; acc = cg_scan_syscall_expr(prog, si.field_vals[i], acc); i++ }
            acc
        }
        checker::TIndex as ix => cg_scan_syscall_expr(prog, ix.index, cg_scan_syscall_expr(prog, ix.receiver, used))
        checker::TInterp as in => {
            var acc = used
            var i = 0
            loop {
                if i >= in.holes.len { break }
                acc = cg_scan_syscall_expr(prog, in.holes[i], acc)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; acc = cg_scan_syscall_expr(prog, fd.args[k], acc); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            acc
        }
        checker::TInExpr as ie => {
            var acc = cg_scan_syscall_expr(prog, ie.lhs, used)
            var i = 0
            loop { if i >= ie.elems.len { break }; acc = cg_scan_syscall_expr(prog, ie.elems[i], acc); i++ }
            acc
        }
        checker::TArrayLit as a => {
            var acc = used
            var i = 0
            loop { if i >= a.elements.len { break }; acc = cg_scan_syscall_expr(prog, a.elements[i].expr, acc); i++ }
            acc
        }
        checker::TBlockExpr as blk => cg_scan_syscall_block(prog, blk.body, used)
        _ => used
    }
}

fn cg_scan_syscall_stmt(prog: CgProg, s: @TStatement(), used: SyscallUse): SyscallUse {
    match s {
        checker::TBinding as b => cg_scan_syscall_expr(prog, b.value, used)
        checker::TAssign as a => {
            var acc = cg_scan_syscall_expr(prog, a.value, used)
            if parser::assign_has_target(a.kind) { acc = cg_scan_syscall_expr(prog, a.target, acc) }
            acc
        }
        checker::TReturn as r => if r.has_value { cg_scan_syscall_expr(prog, r.value, used) } else { used }
        checker::TLoopStmt as l => cg_scan_syscall_block(prog, l.body, cg_scan_syscall_block(prog, l.init, used))
        checker::TExprStmt as es => cg_scan_syscall_expr(prog, es.expr, used)
        checker::TDeferStmt as d => cg_scan_syscall_block(prog, d.body, used)
        checker::TAdoptStmt as a => cg_scan_syscall_block(prog, a.body, used)
        checker::TBlockStmt as b => cg_scan_syscall_block(prog, b.body, used)
        checker::TBreakStmt => used
        checker::TContinueStmt => used
        checker::TSpawn as sp => cg_scan_syscall_expr(prog, sp.call, used)
    }
}

fn cg_scan_syscall_block(prog: CgProg, stmts: []@TStatement(), used: SyscallUse): SyscallUse {
    var acc = used
    var i = 0
    loop { if i >= stmts.len { break }; acc = cg_scan_syscall_stmt(prog, stmts[i], acc); i++ }
    acc
}

fn cg_scan_syscall_arities(prog: CgProg): SyscallUse {
    var used = cg_syscall_use_none()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if !f.is_extern { used = cg_scan_syscall_block(prog, f.body, used) } }
            (@TStatement()) as ts => { used = cg_scan_syscall_stmt(prog, ts, used) }
            _ => { }
        }
        i++
    }
    used
}

fn cg_emit_syscall_helper_text(arity: u64): str {
    if arity == 0 to u64 {
        return "static inline long tk_syscall0(long n) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 1 to u64 {
        return "static inline long tk_syscall1(long n, long a1) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 2 to u64 {
        return "static inline long tk_syscall2(long n, long a1, long a2) {\n    long ret;\n    __asm__ volatile (\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 3 to u64 {
        return "static inline long tk_syscall3(long n, long a1, long a2, long a3) {\n    long ret;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 4 to u64 {
        return "static inline long tk_syscall4(long n, long a1, long a2, long a3, long a4) {\n    long ret; register long r10 __asm__(\"r10\") = a4;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 5 to u64 {
        return "static inline long tk_syscall5(long n, long a1, long a2, long a3, long a4, long a5) {\n    long ret; register long r10 __asm__(\"r10\") = a4; register long r8 __asm__(\"r8\") = a5;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10), \"r\"(r8) : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    if arity == 6 to u64 {
        return "static inline long tk_syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6) {\n    long ret;\n    register long r10 __asm__(\"r10\") = a4;\n    register long r8  __asm__(\"r8\")  = a5;\n    register long r9  __asm__(\"r9\")  = a6;\n    __asm__ volatile (\"syscall\"\n        : \"=a\"(ret)\n        : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10), \"r\"(r8), \"r\"(r9)\n        : \"rcx\", \"r11\", \"memory\");\n    return ret;\n}\n"
    }
    ""
}

fn cg_emit_syscall_helper_text_aarch64(arity: u64): str {
    if arity == 0 to u64 {
        return "static inline long tk_syscall0(long n) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\");\n    __asm__ volatile (\"svc #0\" : \"=r\"(x0) : \"r\"(x8) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 1 to u64 {
        return "static inline long tk_syscall1(long n, long a1) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 2 to u64 {
        return "static inline long tk_syscall2(long n, long a1, long a2) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 3 to u64 {
        return "static inline long tk_syscall3(long n, long a1, long a2, long a3) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 4 to u64 {
        return "static inline long tk_syscall4(long n, long a1, long a2, long a3, long a4) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 5 to u64 {
        return "static inline long tk_syscall5(long n, long a1, long a2, long a3, long a4, long a5) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    register long x4 __asm__(\"x4\") = a5;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4) : \"memory\");\n    return x0;\n}\n"
    }
    if arity == 6 to u64 {
        return "static inline long tk_syscall6(long n, long a1, long a2, long a3, long a4, long a5, long a6) {\n    register long x8 __asm__(\"x8\") = n;\n    register long x0 __asm__(\"x0\") = a1;\n    register long x1 __asm__(\"x1\") = a2;\n    register long x2 __asm__(\"x2\") = a3;\n    register long x3 __asm__(\"x3\") = a4;\n    register long x4 __asm__(\"x4\") = a5;\n    register long x5 __asm__(\"x5\") = a6;\n    __asm__ volatile (\"svc #0\" : \"+r\"(x0) : \"r\"(x8), \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4), \"r\"(x5) : \"memory\");\n    return x0;\n}\n"
    }
    ""
}

fn cg_syscall_use_any(used: SyscallUse): bool {
    used.s0 || used.s1 || used.s2 || used.s3 || used.s4 || used.s5 || used.s6
}

fn cg_emit_syscall_helpers_x86_64(buf: Cb, used: SyscallUse): Cb {
    var out = buf
    if used.s0 { out = cb(out, cg_emit_syscall_helper_text(0 to u64)) }
    if used.s1 { out = cb(out, cg_emit_syscall_helper_text(1 to u64)) }
    if used.s2 { out = cb(out, cg_emit_syscall_helper_text(2 to u64)) }
    if used.s3 { out = cb(out, cg_emit_syscall_helper_text(3 to u64)) }
    if used.s4 { out = cb(out, cg_emit_syscall_helper_text(4 to u64)) }
    if used.s5 { out = cb(out, cg_emit_syscall_helper_text(5 to u64)) }
    if used.s6 { out = cb(out, cg_emit_syscall_helper_text(6 to u64)) }
    out
}

fn cg_emit_syscall_helpers_aarch64(buf: Cb, used: SyscallUse): Cb {
    var out = buf
    if used.s0 { out = cb(out, cg_emit_syscall_helper_text_aarch64(0 to u64)) }
    if used.s1 { out = cb(out, cg_emit_syscall_helper_text_aarch64(1 to u64)) }
    if used.s2 { out = cb(out, cg_emit_syscall_helper_text_aarch64(2 to u64)) }
    if used.s3 { out = cb(out, cg_emit_syscall_helper_text_aarch64(3 to u64)) }
    if used.s4 { out = cb(out, cg_emit_syscall_helper_text_aarch64(4 to u64)) }
    if used.s5 { out = cb(out, cg_emit_syscall_helper_text_aarch64(5 to u64)) }
    if used.s6 { out = cb(out, cg_emit_syscall_helper_text_aarch64(6 to u64)) }
    out
}

fn cg_emit_syscall_helpers(buf: Cb, used: SyscallUse): Cb {
    if !cg_syscall_use_any(used) { return buf }
    var out = cb(buf, "#if defined(__x86_64__) || defined(__amd64__)\n")
    out = cb(out, "/* teko section 16 raw-syscall intrinsic (x86_64 Linux); emitted only for arities the program uses */\n")
    out = cg_emit_syscall_helpers_x86_64(out, used)
    out = cb(out, "#elif defined(__aarch64__) || defined(__arm64__)\n")
    out = cb(out, "/* teko section 16 raw-syscall intrinsic (aarch64 Linux); emitted only for arities the program uses */\n")
    out = cg_emit_syscall_helpers_aarch64(out, used)
    out = cb(out, "#else\n")
    out = cb(out, "#error \"teko section 16: the raw-syscall intrinsic is validated for x86_64 and aarch64 Linux only (docs/design/plano-s16-syscall-intrinsic.md section 2 and 2.5)\"\n")
    cb(out, "#endif\n\n")
}

fn cond_const_c_symbol(ns: str, name: str): str {
    var b: Cb = cb(cb_new(), "tk_const_")
    if ns.len != 0 {
        var i: u64 = 0
        loop {
            if i >= ns.len { break }
            if ns[i] == b':' { b = cb_byte(b, b'_') } else { b = cb_byte(b, ns[i]) }
            i = i + 1
        }
        b = cb(b, "__")
    }
    str(cb_flat(cb_ident(b, name)))
}

fn cc_axis_atom_cond(e: parser::PEq): str | error {
    if e.axis == "os" {
        if e.value == "linux" { return "defined(__linux__)" }
        if e.value == "macos" { return "defined(__APPLE__)" }
        if e.value == "windows" { return "defined(_WIN32)" }
    }
    if e.axis == "arch" {
        if e.value == "x86_64" { return "(defined(__x86_64__) || defined(__amd64__))" }
        if e.value == "arm64" { return "(defined(__aarch64__) || defined(__arm64__))" }
    }
    error { message = teko::str::concat("codegen section 16: cannot render a C #if condition for axis '", teko::str::concat(e.axis, teko::str::concat("' value '", teko::str::concat(e.value, "'")))) }
}

fn guard_to_c_cond(p: parser::Pred): str | error {
    match p.kind {
        parser::PTrue => "1"
        parser::PEq as e => cc_axis_atom_cond(e)
        parser::PFlag => error { message = "codegen section 16: a target-conditional const cannot depend on a build flag (`#if(<flag>)`) — only os/arch guards ladder" }
        parser::PNot as n => {
            var inner = match guard_to_c_cond(n.inner) { str as s => s; error as e => return e }
            teko::str::concat("(!(", teko::str::concat(inner, "))"))
        }
        parser::PAnd as a => {
            var l = match guard_to_c_cond(a.left) { str as s => s; error as e => return e }
            var r = match guard_to_c_cond(a.right) { str as s => s; error as e => return e }
            teko::str::concat("((", teko::str::concat(l, teko::str::concat(") && (", teko::str::concat(r, "))"))))
        }
        parser::POr as o => {
            var l = match guard_to_c_cond(o.left) { str as s => s; error as e => return e }
            var r = match guard_to_c_cond(o.right) { str as s => s; error as e => return e }
            teko::str::concat("((", teko::str::concat(l, teko::str::concat(") || (", teko::str::concat(r, "))"))))
        }
    }
}

fn cg_cond_const_arm_value(init: checker::TExpr): str | error {
    match init.kind {
        checker::TNumber as n => if n.is_float { error { message = "codegen section 16: a target-conditional const arm must be an integer literal, not a float" } } else { str(cb_flat(cb_numint(cb_new(), n.value))) }
        _ => error { message = "codegen section 16: a target-conditional const arm must be an integer literal" }
    }
}

fn cg_emit_one_cond_ladder(buf: Cb, prog: CgProg, fam: checker::ConstQName): Cb | error {
    var sym = cond_const_c_symbol(fam.namespace, fam.name)
    var out = buf
    var first = true
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TConstDecl as cd => {
                if cd.namespace == fam.namespace && cd.name == fam.name {
                    var cond = match guard_to_c_cond(cd.guard) { str as s => s; error as e => return e }
                    var val = match cg_cond_const_arm_value(cd.init) { str as s => s; error as e => return e }
                    out = cb(out, if first { "#if " } else { "#elif " })
                    out = cb(out, cond)
                    out = cb(out, "\n#define ")
                    out = cb(out, sym)
                    out = cb(out, " ")
                    out = cb(out, val)
                    out = cb(out, "\n")
                    first = false
                }
            }
            _ => { }
        }
        i = i + 1
    }
    cb(out, "#endif\n")
}

fn cg_emit_cond_const_ladder(buf: Cb, prog: CgProg): Cb | error {
    var fams = prog.cond_consts
    if fams.len == 0 { return buf }
    var out = buf
    var f: u64 = 0
    loop {
        if f >= fams.len { break }
        out = match cg_emit_one_cond_ladder(out, prog, fams[f]) { Cb as o => o; error as e => return e }
        f = f + 1
    }
    cb(out, "\n")
}

fn cg_emit_global_target_guard(buf: Cb): Cb {
    var b = cb(buf, "#if !( (defined(__linux__) && (defined(__x86_64__) || defined(__amd64__) || defined(__aarch64__) || defined(__arm64__))) || (defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))) || (defined(_WIN32) && (defined(__x86_64__) || defined(__amd64__))) )\n")
    b = cb(b, "#error \"unsupported (os,arch)\"\n")
    cb(b, "#endif\n\n")
}

fn cg_fn_guard_cond(guard: parser::Pred): str | error {
    if !checker::pred_is_target_guard(guard) { return "" }
    guard_to_c_cond(guard)
}

fn cg_emit_fn_proto_guarded(buf: Cb, prog: CgProg, f: checker::TFunction): Cb | error {
    if f.is_extern && f.from_lib == "teko_rt" { return buf }
    var gc = match cg_fn_guard_cond(f.guard) { str as s => s; error as e => return e }
    var out = buf
    if gc.len != 0 { out = cb(cb(cb(out, "#if "), gc), "\n") }
    out = match emit_function_sig(out, prog, f) { Cb as o => o; error as err => return err }
    out = cb(out, ";\n")
    if f.is_extern && f.from_lib.len > 0 && gc == "defined(_WIN32)" {
        out = cb(cb(cb(out, "#pragma comment(lib, \""), f.from_lib), "\")\n")
    }
    if gc.len != 0 { out = cb(out, "#endif\n") }
    out
}

fn cg_emit_fn_def_guarded(buf: Cb, prog: CgProg, f: checker::TFunction, mode: CgMode): Cb | error {
    if f.is_extern { return buf }
    var gc = match cg_fn_guard_cond(f.guard) { str as s => s; error as e => return e }
    var out = buf
    if gc.len != 0 { out = cb(cb(cb(out, "#if "), gc), "\n") }
    out = match emit_function_mode(out, prog, f, mode) { Cb as o => o; error as err => return err }
    if gc.len != 0 { out = cb(out, "#endif\n") }
    out
}

fn cg_emit_thread_clone_helper_text_x86_64(): str {
    "static long tk_thread_clone(long entry, long stack_top, long arg, long ctid_addr, long flags) {\n    void **sp = (void **)stack_top;\n    *(--sp) = (void *)arg;\n    *(--sp) = (void *)entry;\n    long ret;\n    register long r10 __asm__(\"r10\") = ctid_addr;\n    register long r8 __asm__(\"r8\") = 0;\n    __asm__ volatile (\n        \"syscall\\n\\t\"\n        \"testq %%rax, %%rax\\n\\t\"\n        \"jnz 1f\\n\\t\"\n        \"popq %%rax\\n\\t\"\n        \"popq %%rdi\\n\\t\"\n        \"callq *%%rax\\n\\t\"\n        \"movq $60, %%rax\\n\\t\"\n        \"xorq %%rdi, %%rdi\\n\\t\"\n        \"syscall\\n\\t\"\n        \"1:\\n\\t\"\n        : \"=a\"(ret)\n        : \"a\"(56L), \"D\"(flags), \"S\"(sp), \"d\"(0L), \"r\"(r10), \"r\"(r8)\n        : \"rcx\", \"r11\", \"memory\", \"cc\");\n    return ret;\n}\n"
}

fn cg_emit_thread_clone_helper(buf: Cb, want: bool): Cb {
    if !want { return buf }
    var out = cb(buf, "#if defined(__x86_64__) || defined(__amd64__)\n")
    out = cb(out, "/* teko section 10 raw thread-spawn intrinsic (x86_64 Linux); emitted only if the program spawns */\n")
    out = cb(out, cg_emit_thread_clone_helper_text_x86_64())
    out = cb(out, "#elif defined(__aarch64__) || defined(__arm64__)\n")
    out = cb(out, "#error \"teko section 10 aarch64 thread_clone not yet validated on this host (docs/design/plano-s10-multithread-nativo.md section 3.4)\"\n")
    out = cb(out, "#else\n")
    out = cb(out, "#error \"teko section 10: thread_clone is validated for x86_64 Linux only (docs/design/plano-s10-multithread-nativo.md section 3)\"\n")
    cb(out, "#endif\n\n")
}

fn cg_emit_atomic_helpers_text(): str {
    "static inline long tk_atomic_cas_u32(long addr, long expected, long desired) {\n    unsigned int e = (unsigned int)expected;\n    __atomic_compare_exchange_n((unsigned int *)(unsigned long)addr, &e, (unsigned int)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);\n    return (long)(unsigned long)e;\n}\nstatic inline long tk_atomic_xchg_u32(long addr, long value) {\n    return (long)(unsigned long)__atomic_exchange_n((unsigned int *)(unsigned long)addr, (unsigned int)value, __ATOMIC_SEQ_CST);\n}\nstatic inline long tk_atomic_add_u32(long addr, long delta) {\n    return (long)(unsigned long)__atomic_fetch_add((unsigned int *)(unsigned long)addr, (unsigned int)delta, __ATOMIC_SEQ_CST);\n}\nstatic inline long tk_atomic_load_u32(long addr) {\n    return (long)(unsigned long)__atomic_load_n((unsigned int *)(unsigned long)addr, __ATOMIC_SEQ_CST);\n}\n"
}

fn cg_emit_atomic_helpers(buf: Cb, want: bool): Cb {
    if !want { return buf }
    var out = cb(buf, "/* teko section 10 atomic RMW intrinsics (futex mutex/condvar substrate); emitted only if the program uses one */\n")
    cb(out, cg_emit_atomic_helpers_text())
}

fn tk_emit_c(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::Program)
}

pub fn tk_emit_c_export(prog0: checker::TProgram): str | error {
    var body_c = match tk_emit_c_mode(prog0, CgMode::Program) { str as s => s; error as e => return e }
    var wrappers = match cg_c_export_wrappers_text(prog0) { str as s => s; error as e => return e }
    teko::str::concat(body_c, wrappers)
}

pub fn tk_emit_c_test(prog0: checker::TProgram, cov: bool): str | error {
    tk_emit_c_mode(prog0, if cov { CgMode::TestCov } else { CgMode::TestPlain })
}

pub fn tk_emit_c_cov(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::ProgramCov)
}

pub fn tk_emit_c_test_analyze(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::TestAnalyze)
}

fn tk_emit_c_mode(prog0: checker::TProgram, mode: CgMode): str | error {
    var prog_ag = match checker::inline_aggregate_consts(prog0) { checker::TProgram as p => p; error as e => return e }
    var _lr = cg_lift_lambdas(cg_prog_of(prog_ag))
    var prog = cg_prog_of(_lr.prog)
    var cap_lams = _lr.lams
    var spawn_sites = _lr.spawns
    var b: Cb = cb_new()
    b = cb(b, "// generated by teko (F2 backend) — do not edit\n")
    b = cb(b, "#include <stdint.h>\n")
    b = cb(b, "#include <stdbool.h>\n")
    b = cb(b, "#include <stdlib.h>\n")
    b = cb(b, "#include <math.h>\n")
    b = cb(b, "#include <string.h>\n")
    b = cb(b, "#include \"teko_rt.h\"\n")
    b = cb(b, "#include \"assert.h\"\n\n")

    b = cb(b, "#pragma GCC diagnostic ignored \"-Wincompatible-pointer-types\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wint-conversion\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wimplicit-function-declaration\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wimplicit-int\"\n\n")

    b = cg_emit_global_target_guard(b)
    var sc_used = cg_scan_syscall_arities(prog)
    b = cg_emit_syscall_helpers(b, sc_used)
    b = match cg_emit_cond_const_ladder(b, prog) { Cb as o => o; error as err => return err }
    b = cg_emit_arena_provider_ladder(b)
    b = cg_emit_thread_clone_helper(b, sc_used.clone)
    b = cg_emit_atomic_helpers(b, sc_used.atomics)

    var fw = 0
    loop {
        if fw >= prog.items.len { break }
        match prog.items[fw] {
            parser::TypeDecl as d => {
                match d.body {
                    parser::StructBody => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    parser::VariantBody => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    parser::ClassBody as fcb => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                        match fcb.kind {
                            parser::ClassKind::Sealed => { }
                            _ => { b = cb(cb_tysym(cb(b, "typedef struct { void *data; void *const *vtable; } tk_base_"), d.name), ";\n") }
                        }
                    }
                    parser::InterfaceBody => {
                        b = cb(b, "typedef struct { void *data; void *const *vtable; } ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    parser::ExternStructBody => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    _ => { }
                }
            }
            _ => { }
        }
        fw++
    }
    b = cb(b, "\n")
    b = match cg_emit_types_ordered(b, prog) { Cb as o => o; error as err => return err }

    var pi = 0
    loop {
        if pi >= prog.items.len { break }
        match prog.items[pi] {
            checker::TFunction as f => { b = match cg_emit_fn_proto_guarded(b, prog, f) { Cb as o => o; error as err => return err } }
            _ => { }
        }
        pi++
    }
    b = cb(b, "\n")
    b = match cg_emit_deep_copy_helpers(b, prog) { Cb as o => o; error as err => return err }
    b = match cg_emit_vtables_and_thunks(b, prog) { Cb as o => o; error as err => return err }
    b = cb(b, "\n")
    b = match cg_emit_lambda_decls(b, prog, cap_lams, true) { Cb as o => o; error as err => return err }
    b = cb(b, "\n")
    b = match emit_spawn_thunks(b, prog, spawn_sites) { Cb as o => o; error as err => return err }
    b = cb(b, "\n")

    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { b = match cg_emit_fn_def_guarded(b, prog, f, mode) { Cb as o => o; error as err => return err } }
            parser::TypeDecl => { }
            parser::UseDecl => { }
            (@TStatement()) as _gb3 => { }
            checker::TConstDecl => { }
        }
        i++
    }
    b = match cg_emit_lambda_decls(b, prog, cap_lams, false) { Cb as o => o; error as err => return err }

    b = match emit_mode_main(b, prog, mode) { Cb as o => o; error as err => return err }
    str(cg_format_c(str(cb_flat(b))))
}

fn emit_mode_main(buf: Cb, prog: CgProg, mode: CgMode): Cb | error {
    match mode {
        CgMode::Program => emit_program_main(buf, prog)
        CgMode::ProgramCov => emit_program_main_cov(buf, prog)
        _ => emit_test_main(buf, prog, mode)
    }
}

fn emit_program_main(buf: Cb, prog: CgProg): Cb | error {
    emit_program_main_body(buf, prog, false)
}

fn emit_program_main_cov(buf: Cb, prog: CgProg): Cb | error {
    emit_program_main_body(buf, prog, true)
}

fn emit_program_main_body(buf: Cb, prog: CgProg, cov: bool): Cb | error {
    var b = buf
    var last_stmt = prog.items.len
    var li: u64 = 0
    loop {
        if li >= prog.items.len { break }
        match prog.items[li] {
            (@TStatement()) as _gb4 => { last_stmt = li }
            _ => { }
        }
        li++
    }
    if cov { b = cb(b, "static void __tk_cov_atexit_dump(void) { const char *dp = getenv(\"TEKO_TKCOV\"); if (dp) tk_cov_dump(dp); }\n") }
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    if cov {
        b = cb(b, "    tk_cov_reset(); tk_cov_branch_reset(); tk_cov_branches_on(true);\n")
        b = cb(b, "    tk_cov_line_reset(); tk_cov_lines_on(true);\n")
        b = cb(b, "    atexit(__tk_cov_atexit_dump);\n")
    }
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            checker::TFunction => { }
            parser::TypeDecl => { }
            parser::UseDecl => { }
            checker::TConstDecl => { }
            (@TStatement()) as s => {
                if j == last_stmt {
                    var tail = teko::list::push(teko::list::empty(), s)
                    b = match emit_block_tail(b, tail, true, prog, checker::Void { }, "    ", "", teko::list::empty(), teko::list::empty(), dctx_empty()) { Cb as o => o; error as err => return err }
                } else {
                    b = match emit_stmt(b, s, true, prog, checker::Void { }, "    ", "", teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty(), teko::list::empty(), false) { Cb as o => o; error as err => return err }
                }
            }
        }
        j++
    }
    b = cb(b, "    return 0;\n")
    b = cb(b, "}\n")
    b
}

fn emit_test_main(buf: Cb, prog: CgProg, mode: CgMode): Cb | error {
    if mode == CgMode::TestAnalyze { return emit_test_main_analyze(buf, prog) }
    var b = buf
    var cov = mode == CgMode::TestCov
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    if cov {
        b = cb(b, "    tk_cov_reset();\n")
        b = cb(b, "    tk_cov_branch_reset(); tk_cov_branches_on(true);\n")
        b = cb(b, "    tk_cov_line_reset(); tk_cov_lines_on(true);\n")
    }
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { b = emit_test_call(b, f, i, cov) }
            }
            _ => { }
        }
        i++
    }
    if cov {
        b = cb(b, "    tk_cov_branches_on(false); tk_cov_lines_on(false);\n")
        b = cb(b, "    { const char *dp = getenv(\"TEKO_TKCOV\"); if (dp) tk_cov_dump(dp); }\n")
    }
    b = emit_test_main_close(b)
    b = cb(b, "}\n")
    b
}

fn emit_test_main_analyze(buf: Cb, prog: CgProg): Cb | error {
    var b = cb(buf, "extern int snprintf(char *, size_t, const char *, ...);\n")
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    b = cb(b, "    tk_cov_branches_on(true);\n")
    b = cb(b, "    tk_cov_lines_on(true);\n")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { b = emit_test_call_analyze(b, f, i) }
            }
            _ => { }
        }
        i++
    }
    b = emit_test_main_close(b)
    b = cb(b, "}\n")
    b
}

fn emit_test_main_close(buf: Cb): Cb {
    var b = cb(buf, "    tk_test_summary();\n    ")
    b = cb_fn_name(b, "teko::journal", "note_test_end")
    b = cb(b, "();\n")
    cb(b, "    return tk_test_any_failed() ? 1 : 0;\n")
}

fn cb_journal_tkstr_lit(buf: Cb, label: str): Cb {
    var b = cb(buf, "(tk_str){ (const tk_byte *)\"")
    b = cb_cstr_escaped(b, label)
    b = cb(b, "\", ")
    cb_u64_digits(b, label.len)
}

fn cb_journal_call1(buf: Cb, name: str, label: str): Cb {
    var b = cb_journal_tkstr_lit(cb(cb_fn_name(buf, "teko::journal", name), "("), label)
    cb(b, " });\n")
}

fn cb_journal_call_exited(buf: Cb, label: str, code_expr: str): Cb {
    var b = cb_journal_tkstr_lit(cb(cb_fn_name(buf, "teko::journal", "note_test_exited"), "("), label)
    cb(b, teko::str::concat(" }, ", code_expr, ");\n"))
}

fn emit_test_call(buf: Cb, f: checker::TFunction, idx: u64, cov: bool): Cb {
    var b = cb(buf, "    if (tk_test_shard_take()) {\n")
    b = cb(b, "    "); b = cb(b, cg_arena_sym(CgArenaSym::ArenaPush)); b = cb(b, "();\n")
    b = emit_test_channel_open(b, f)
    if cov { b = cb(cb_u64_digits(cb(b, "    tk_cov_enter("), idx), ");\n") }
    b = emit_test_captured_call(b, f)
    if cov { b = cb(b, "    tk_cov_leave();\n") }
    b = cb(b, "    "); b = cb(b, cg_arena_sym(CgArenaSym::ArenaPop)); b = cb(b, "();\n")
    b = cb(b, "    }\n")
    b
}

fn emit_test_captured_call(buf: Cb, f: checker::TFunction): Cb {
    var label = test_label_of(f)
    var b = cb(buf, "    { tk_test_outcome teko_journal_rv = tk_test_run(&")
    b = cb_fn_name(b, f.namespace, f.name, f.overload_suffix)
    b = cb(b, ");\n    if (teko_journal_rv.how == TK_TEST_OK) { ")
    b = cb_journal_call1(b, "note_test_ok", label)
    b = cb(b, "    } else if (teko_journal_rv.how == TK_TEST_EXITED) { ")
    b = cb_journal_call_exited(b, label, "teko_journal_rv.code")
    b = cb(b, "    } else { ")
    b = cb_journal_call1(b, "note_test_panicked", label)
    b = cb(b, "    }\n    tk_test_report(teko_journal_rv);\n    }\n")
    b
}

fn emit_test_channel_open(buf: Cb, f: checker::TFunction): Cb {
    var label = test_label_of(f)
    var b = cb(buf, "    tk_test_begin((tk_str){ (const tk_byte *)\"")
    b = cb_cstr_escaped(b, label)
    b = cb(b, "\", ")
    b = cb_u64_digits(b, label.len)
    b = cb(b, " });\n")
    cb_journal_call1(b, "note_test_begin", label)
}

fn test_label_of(f: checker::TFunction): str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

fn emit_test_call_analyze(buf: Cb, f: checker::TFunction, idx: u64): Cb {
    var b = cb(buf, "    "); b = cb(b, cg_arena_sym(CgArenaSym::ArenaPush)); b = cb(b, "();\n")
    b = emit_test_channel_open(b, f)
    b = cb(b, "    tk_cov_reset(); tk_cov_branch_reset(); tk_cov_line_reset();\n")
    b = cb(cb_u64_digits(cb(b, "    tk_cov_enter("), idx), ");\n")
    b = emit_test_captured_call(b, f)
    b = cb(b, "    tk_cov_leave();\n")
    b = cb(b, "    { const char *d = getenv(\"TEKO_ANALYZE_DIR\"); if (d) { char p[1024]; snprintf(p, sizeof p, \"%s/")
    b = cb_u64_digits(b, idx)
    b = cb(b, ".tkcov\", d); tk_cov_dump(p); } }\n")
    b = cb(b, "    "); b = cb(b, cg_arena_sym(CgArenaSym::ArenaPop)); b = cb(b, "();\n")
    b
}

fn mode_instruments_cov(mode: CgMode): bool {
    match mode {
        CgMode::TestCov => true
        CgMode::TestAnalyze => true
        CgMode::ProgramCov => true
        _ => false
    }
}

fn emit_function_mode(buf: Cb, prog: CgProg, f: checker::TFunction, mode: CgMode): Cb | error {
    if !mode_instruments_cov(mode) { return emit_function(buf, prog, f) }
    if f.is_test || f.namespace == "teko::coverage" { return emit_function(buf, prog, f) }
    emit_function_cov(buf, prog, f, fn_items_index(prog, f) to i64)
}

fn fn_items_index(prog: CgProg, f: checker::TFunction): u64 {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as g => {
                if g.namespace == f.namespace && g.name == f.name && g.line == f.line { return i }
            }
            _ => { }
        }
        i++
    }
    0
}

fn tk_emit_tsym(prog: checker::TProgram): str {
    var b: Cb = cb_new()
    b = cb(b, "# teko symbol map (.tsym v1): <c-symbol>\\t<teko-name>\\t<file>:<line>\n")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                b = cb_fn_name(b, f.namespace, f.name, f.overload_suffix)
                b = cb(b, "\t")
                if f.namespace.len != 0 {
                    b = cb(b, f.namespace)
                    b = cb(b, "::")
                }
                b = cb(b, f.name)
                b = cb(b, "\t")
                b = cb(b, f.file)
                b = cb(b, ":")
                b = cb_u64_digits(b, f.line to u64)
                b = cb(b, "\n")
            }
            _ => { }
        }
        i = i + 1
    }
    str(cb_flat(b))
}
