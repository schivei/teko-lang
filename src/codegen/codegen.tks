// src/codegen/codegen.tks   (namespace 'teko::codegen')
//
// THE CANONICAL ORIGINAL of the C backend: lower a CHECKED typed program (TProgram)
// to C source text. The host `cc` then compiles that text to the first native Teko
// binary (M0). This is the Teko pair of src/codegen/codegen_c.{c,h} — the only
// namespace that was C-only; this file closes the gap (it feeds self-hosting).
//
// Lowering design (M0 = integer arithmetic + let + return -> running native binary):
//   * types  : Type -> C type text (U8..U64 -> uintN_t, I8..I64 -> intN_t,
//              Bool -> bool, byte -> uint8_t, void -> void, Str -> tk_str). Everything
//              else = "not yet supported".
//   * exprs  : TNumber -> literal; TVar -> identifier; TBinary -> (L op R);
//              TUnary -> (op X); TCompare -> chained && of adjacent C comparisons;
//              TCast -> ((Ctype)(inner)); TCall -> name(args…); TFieldAccess ->
//              (recv.field); TStrLit -> tk_str compound literal (explicit length);
//              TByteLit -> decimal octet. TIfExpr/TMatchExpr AS A VALUE = not yet supported.
//   * stmts  : TBinding -> Ctype x = v; TAssign -> x op= v; TReturn -> early exit in
//              main / `return v;` in a fn; TExprStmt -> expr; TLoopStmt -> while(1){…}
//              (labeled: + tk_lbl_<NAME>_cont/_break goto-targets — M.5);
//              TBreakStmt/TContinueStmt -> break;/continue; (labeled: goto tk_lbl_<NAME>_break/_cont;).
//   * program: each TFunction -> a C function; the loose top-level statements (the
//              VIRTUAL-MAIN) -> int main(void){ … return 0; } with early-return.
//
// COVERAGE RULE (M.3 — honesty): every unsupported node FAILS with a clear message;
// codegen never emits broken C, never crashes. The barrier is named, not silent (M.1).
//
// HOW THIS DIFFERS FROM THE C (faithful, not literal — Teko is cleaner):
//   * The C growable `cbuf` (malloc/realloc + NUL, abort-on-OOM) is SCAFFOLDING for
//     what Teko does natively: the C-source under construction is a `[]byte` grown by
//     `teko::list::push` (the one true intrinsic — core.tks). The append helpers take a
//     buffer and RETURN the grown buffer (the emit/* functional convention — tkb_buf.tks),
//     instead of mutating a `cbuf*` through a pointer.
//   * The C `bool ok + const char **err` plumbing collapses into `[]byte | error`
//     (native variant — B.14): the FIRST error short-circuits via `return e`, exactly
//     as the C's `if (!…) return false` chain did. `T | error` IS the C's TK_RESULT.
//   * The C `seg_is(span, lit)` (memcmp a non-NUL span) is just `==` on `str` here.
//   * The C operator lookup tables that return `const char *` (NULL == unsupported) are
//     `str | error` here — the NULL sentinel becomes an honest error case.

use teko::checker
use teko::lexer
use teko::parser

/** CgMode — which `main()` the codegen entry emits (issue #265, lever D of #249). `Program`
    (default) is today's virtual-main over the loose top-level statements — byte-for-byte the
    historical emission, so the FIXPOINT `gen1.c==gen2.c` is untouched. `TestPlain` emits a
    test-gate main that calls each `#test` in `prog.items` order (native gate, no coverage).
    `TestCov` adds the `tk_cov_*` prologue/brackets (coverage sinks) — zero-cost when unused,
    because those calls are simply absent from the emitted C under `Program`/`TestPlain`.
    `TestAnalyze` (0.3.0.29) emits the SAME production-fn instrumentation as `TestCov`, but a
    per-test ISOLATION harness: between every `#test` it resets all three sinks, runs the test,
    and dumps THAT test's id-set to `$TEKO_ANALYZE_DIR/<idx>.tkcov` — one compile answers the
    whole-suite stale/redundant question (`teko test . --analyzer`). `ProgramCov` (0.3.1 C-cov)
    emits the SAME production-fn instrumentation as `TestCov`, but `Program`'s ORDINARY
    virtual-main (byte-identical to `Program`'s statement body, only wrapped with the sink
    reset/enable calls and an `atexit`-registered dump) — a fully functional `teko` CLI that also
    feeds the regression tier's coverage back into `fe.prog` (`build_regression_cov_exe`,
    `src/build/project.tks`). Never used for the release build, so the fixpoint is untouched. */
type CgMode = enum { Program; TestPlain; TestCov; TestAnalyze; ProgramCov }

/**
 * CovCtx — the coverage-instrumentation context threaded through TestCov body emission (#265).
 *
 * Carries whether line/branch `tk_cov_*_at` calls are emitted and the OWNING production fn's
 * `prog.items` index (so interior line/branch marks key on the same `fn` the static floor walk
 * queries — `line_coverage`/`branch_coverage` in teko::coverage use `i to u64`). `on == false` is the
 * default for every non-TestCov path (via `cov_off()`) → NO `tk_cov_*` emitted → byte-identical
 * output → the gen1==gen2 fixpoint is structurally untouched.
 *
 * @see emit_function_cov  the entry that constructs a live CovCtx (cov_idx >= 0)
 * @see line_coverage  the static walk whose `fn` index this MUST match
 * @since #265
 */
type CovCtx = struct {
    /** whether to emit `tk_cov_line_at`/`tk_cov_branch_at` (true only under CgMode::TestCov). */
    on: bool
    /** the owning production fn's `prog.items` index — the `fn` key interior marks attribute to. */
    fn_idx: u64
}

/**
 * The result of emitting one vtable's dispatch thunks (#291): the grown output buffer paired with
 * the grown set of thunk symbols already defined. A named struct is the seed-compatible way to
 * return two values from `cg_emit_vtable_thunks` (the seed rejects bare tuple return types), so the
 * thunk-emission phase can thread BOTH the buffer and the dedup set through its pair walk.
 */
type TThunkEmit = struct {
    /** the output byte buffer with this vtable's not-yet-seen instance-method thunks appended. */
    buf: []byte
    /** the dedup set of `cb_vtthunk_name` symbols, grown with the thunks emitted for this vtable. */
    emitted: []str
}

/**
 * cov_off — the no-instrumentation CovCtx (every Program/TestPlain path and every ordinary caller).
 *
 * @return a CovCtx with `on = false` → emit_cov_line/emit_cov_branch emit ZERO bytes.
 * @since #265
 */
fn cov_off(): CovCtx { CovCtx { on = false; fn_idx = 0 } }

/**
 * emit_cov_line — under an active CovCtx, append a `tk_cov_line_at(<fn_idx>, <line>)` mark keyed
 * on the OWNING production fn. No-op when `ctx.on` is false (byte-identical) or `line == 0`
 * (unpositioned — the runtime tk_cov_line_at also guards a 0 line).
 *
 * @param buf     the emission buffer
 * @param ctx     the coverage context (on/off + owning fn index)
 * @param line    the source line of the statement being emitted (0 = skip)
 * @param indent  the current C indentation
 * @return        the buffer with the mark appended, or `buf` unchanged when off
 * @since #265
 */
fn emit_cov_line(buf: []byte, ctx: CovCtx, line: u32, indent: str): []byte {
    if !ctx.on { return buf }
    if line == 0 { return buf }
    var b = cb(cb(buf, indent), "tk_cov_line_at(")
    b = cb(cb_u64_digits(b, ctx.fn_idx), "ULL, ")
    cb(cb_u64_digits(b, line to u64), ");\n")
}

/**
 * emit_cov_branch — under an active CovCtx, append one `tk_cov_branch_at(<fn_idx>, line, col,
 * outcome)` mark for a taken branch outcome. No-op when off → byte-identical.
 *
 * @param buf     the emission buffer
 * @param ctx     the coverage context
 * @param line    the branch site's source line (the if/match expr's `e.line`)
 * @param col     the branch site's column (`e.col`) — part of the packed branch id
 * @param outcome 0/1 for `if` (then/else), the arm index for `match`
 * @param indent  the C indentation of the branch body
 * @return        the buffer with the mark appended, or `buf` unchanged when off
 * @since #265
 */
fn emit_cov_branch(buf: []byte, ctx: CovCtx, line: u32, col: u32, outcome: u64, indent: str): []byte {
    if !ctx.on { return buf }
    var b = cb(cb(buf, indent), "tk_cov_branch_at(")
    b = cb(cb_u64_digits(b, ctx.fn_idx), "ULL, ")
    b = cb(cb_u64_digits(b, line to u64), ", ")
    b = cb(cb_u64_digits(b, col to u64), ", ")
    cb(cb_u64_digits(b, outcome), ");\n")
}

// ---------------------------------------------------------------------------
// The growable C-source buffer == a `[]byte`. These mirror cbuf's cb/cb_str/cb_i64/
// cb_cstr_escaped. Each APPENDS to `buf` and returns the grown buffer (functional).
// ---------------------------------------------------------------------------

// cb — append a str (its UTF-8 bytes) to the C-source buffer. (C: `cb`.)
// (#148 R2) lowered to teko::mem::append_fo: ONE memcpy per fragment (was a per-byte push loop —
// millions of calls on a self-build) and FREE-OLD on every grow. THE DECREE that makes free-old
// sound: the emitter buffer is threaded LINEARLY through every emit fn (`out = cb(out, …)` /
// take-buf-return-grown) — no alias of an intermediate buffer ever survives a grow. Enforced by
// convention in this file and guarded by TEKO_MEM_PARANOID (poison + never reuse → any violation
// fails the 659-test gate loudly).
fn cb(buf: []byte, s: str): []byte {
    teko::mem::append_fo(buf, s)
}

// cb_str — append a str span. In C this appended a tk_str's raw bytes (no NUL); in
// Teko a str IS already a {ptr,len} view, so this is identical to `cb`. (C: `cb_str`.)
fn cb_str(buf: []byte, s: str): []byte { cb(buf, s) }

// cb_byte — append a single byte. (No direct C name — folds the C `tmp[0]=c; cb(b,tmp)`
// one-char path into a native byte push.)
// (#148 R3 DECREE) the emitter buffer is threaded linearly through every emit fn (take-buf-
// return-grown, same ownership argument as cb/append_fo) — a copy-grow frees the old buffer.
fn cb_byte(buf: []byte, x: byte): []byte { teko::mem::push_fo(buf, x) }

// cb_i64 — append an i64 as decimal text. (C: `cb_i64`, which used snprintf("%PRId64").)
// Teko has no snprintf, so the decimal render is spelled out: emit the sign, then the
// digits high-to-low. Self-contained — no dependency on the lexer's number path.
fn cb_i64(buf: []byte, v: i64): []byte {
    if v == 0 { return cb_byte(buf, b'0') }
    var b = buf
    var n = v
    if n < 0 { b = cb_byte(b, b'-'); n = -n }   // -n is safe for the M0 magnitudes codegen emits
    // collect digits low-to-high into a scratch list, then emit reversed.
    var digits: []byte = teko::list::empty()   // byte builder (indexed below — needs a concrete element)
    loop {
        if n == 0 { break }
        var d = (n % 10) to byte   // 0..9
        digits = teko::list::push(digits, (b'0' to i64 + (d to i64)) to byte)
        n = n / 10
    }
    var i = digits.len
    loop {
        if i == 0 { break }
        b = cb_byte(b, digits[i - 1])   // reverse: most-significant first
        i--
    }
    b
}

/**
 * cb_to_str — `<a><b>` as a fresh str: append `a` then `b` to a scratch buffer and materialize it
 * once, so a caller that needs the concatenation as a plain `str` (not a buffer) does not thread
 * one through by hand.
 *
 * @param a  the first fragment
 * @param b  the second fragment
 * @return   `a ~ b` materialized as a `str`
 */
fn cb_to_str(a: str, b: str): str { str(cb(cb(teko::list::empty(), a), b)) }

/**
 * cb_u64_digits — append the decimal MAGNITUDE of an unsigned 64-bit value (no sign) (drop-128,
 * 2026-07-24 — replaces `cb_u64_digits`; the widest integer carrier is now u64, so this covers
 * every literal, not just a below-128-bit subset). The digits are spelled out high-to-low
 * (collect low-to-high, emit reversed).
 *
 * @param buf  the emission buffer
 * @param v    the magnitude to append
 * @return     the buffer with the decimal digits appended
 */
fn cb_u64_digits(buf: []byte, v: u64): []byte {
    if v == 0 { return cb_byte(buf, b'0') }
    var b = buf
    var n = v
    var digits: []byte = teko::list::empty()   // byte builder (indexed below — needs a concrete element)
    loop {
        if n == 0 { break }
        var d = (n % 10) to byte   // 0..9
        digits = teko::list::push(digits, (b'0' to i64 + (d to i64)) to byte)
        n = n / 10
    }
    var i = digits.len
    loop {
        if i == 0 { break }
        b = cb_byte(b, digits[i - 1])   // reverse: most-significant first
        i--
    }
    b
}

/**
 * cb_u64_c_expr — a u64 MAGNITUDE as a C constant EXPRESSION, `<dec>ULL` (drop-128, 2026-07-24 —
 * replaces `cb_u64_c_expr`'s two-halves shift form: the widest carrier is now u64, which —
 * unlike u64 — DOES have a native C decimal-literal form, so no shift composition is needed).
 *
 * @param buf  the emission buffer
 * @param v    the magnitude to append
 * @return     the buffer with the `<dec>ULL` expression appended
 */
fn cb_u64_c_expr(buf: []byte, v: u64): []byte {
    cb(cb_u64_digits(buf, v), "ULL")
}

/**
 * cb_numint — append a `parser::NumInt` literal value as a C constant expression: the sign is
 * already explicit on the carrier (drop-128, 2026-07-24 — replaces `cb_i64`, whose negative
 * case had to reinterpret a signed i64's raw bits into u64 first since the OLD carrier could
 * hold a directly-negative value with no separate sign flag; `NumInt` never needs that
 * reinterpretation; #299).
 *
 * @param buf  the emission buffer
 * @param v    the sign-magnitude literal value to append
 * @return     the buffer with the constant expression appended (`-(...)` when negative)
 */
fn cb_numint(buf: []byte, v: parser::NumInt): []byte {
    if v.neg {
        var b = cb(buf, "-(")
        b = cb_u64_c_expr(b, v.mag)
        return cb(b, ")")
    }
    cb_u64_c_expr(buf, v.mag)
}

/**
 * F64_EXPONENT_SHIFT — the bit position of the IEEE-754 binary64 biased exponent field.
 */
const F64_EXPONENT_SHIFT: u64 = 52 to u64
/**
 * F64_EXPONENT_MASK — the IEEE-754 binary64 biased exponent field, once shifted down: all-ones
 * denotes a non-finite value (infinity when the significand is zero, NaN otherwise).
 */
const F64_EXPONENT_MASK: u64 = 2047 to u64
/**
 * F64_SIGNIFICAND_MASK — the IEEE-754 binary64 significand field, the 52 low bits.
 */
const F64_SIGNIFICAND_MASK: u64 = 4503599627370495 to u64
/**
 * F64_SIGN_SHIFT — the bit position of the IEEE-754 binary64 sign bit.
 */
const F64_SIGN_SHIFT: u64 = 63 to u64

/**
 * cb_f64_literal — append `v` as a C expression of type `double` holding EXACTLY `v`'s bits.
 *
 * The `%.17g` text alone is NOT that expression, and believing it was cost two measured defects
 * (0.3.1.0 degrau 27, found while lowering `ftoa` for the native backend — this function is the very
 * site the native self-host stopped at):
 *
 * - a `%.17g` rendering with NO `.`, `e` or `E` in it is an INTEGER constant in C. `-0.0` renders as
 *   `-0`, which C reads as the `int` zero and then converts to `+0.0` — the sign bit silently gone.
 *   Measured: `mut a: f64 = -0.0` printed `-0` through the own backend (which carries the literal as
 *   bits and never spells it) and `0` through this route.
 * - `inf`/`-inf`/`nan` are not C constants at ALL. A source literal that overflows binary64
 *   (`1.0e400`) emitted `tk_ftoa((inf))`, and the generated program did not COMPILE: *"error: 'inf'
 *   undeclared"*. The own backend built and ran the same program.
 *
 * So the spelling is decided from the value's IEEE class, never from its text alone: a non-finite
 * value takes `<math.h>`'s own `INFINITY`/`NAN` macros (already included by the prologue, and the
 * portable C spelling — a NaN's PAYLOAD is not preserved, which no language guarantees and Teko does
 * not expose), and a finite value takes the `%.17g` text forced into floating-point form
 * (`c_double_spelling`). `%.17g` round-trips binary64 exactly, so the finite case is bit-exact.
 *
 * @param buf  the emission buffer
 * @param v    the literal value to append
 * @return     the buffer with a `double`-typed C expression for `v` appended
 */
fn cb_f64_literal(buf: []byte, v: f64): []byte {
    var bits = teko::f64_bits(v)
    if f64_bits_are_finite(bits) { return cb(buf, c_double_spelling(teko::ftoa(v))) }
    if f64_bits_are_nan(bits) { return cb(buf, "NAN") }
    if f64_bits_are_negative(bits) { return cb(buf, "(-INFINITY)") }
    cb(buf, "INFINITY")
}

/**
 * f64_bits_are_finite — is the binary64 value carried by `bits` finite (neither infinity nor NaN)?
 * True exactly when the biased exponent field is not all-ones.
 *
 * @param bits  the value's IEEE-754 binary64 bit pattern (`teko::f64_bits`)
 * @return      true iff the value is finite
 */
fn f64_bits_are_finite(bits: u64): bool {
    ((bits >> F64_EXPONENT_SHIFT) & F64_EXPONENT_MASK) != F64_EXPONENT_MASK
}

/**
 * f64_bits_are_nan — is the binary64 value carried by `bits` a NaN? True exactly when the biased
 * exponent field is all-ones AND the significand is non-zero (an all-ones exponent with a zero
 * significand is an infinity).
 *
 * @param bits  the value's IEEE-754 binary64 bit pattern (`teko::f64_bits`)
 * @return      true iff the value is a NaN
 */
fn f64_bits_are_nan(bits: u64): bool {
    !f64_bits_are_finite(bits) && (bits & F64_SIGNIFICAND_MASK) != 0 to u64
}

/**
 * f64_bits_are_negative — is the binary64 value carried by `bits` signed negative? Read off the SIGN
 * BIT alone, so it answers true for `-0.0` as well — which is the whole reason this family exists.
 *
 * @param bits  the value's IEEE-754 binary64 bit pattern (`teko::f64_bits`)
 * @return      true iff the sign bit is set
 */
fn f64_bits_are_negative(bits: u64): bool {
    (bits >> F64_SIGN_SHIFT) != 0 to u64
}

/**
 * c_double_spelling — `text` (a `%.17g` rendering of a FINITE binary64 value) forced into a spelling
 * C reads as a `double` rather than as an `int`: a `.0` is appended when the rendering carries no
 * decimal point and no exponent marker.
 *
 * `%.17g` drops the fractional part of an integral value (`1.0` renders as `1`, `-0.0` as `-0`). For
 * every value but zero that reads back as the same NUMBER anyway, since C converts the integer
 * constant to `double` at the assignment; for `-0.0` it does not, because the `int` `-0` IS `0` and
 * the sign is lost before any conversion happens. Appending `.0` fixes the sign case and changes no
 * other value: an integral `%.17g` rendering plus `.0` denotes the same real number, and a binary64
 * that `%.17g` renders integrally is exactly representable.
 *
 * @param text  the `%.17g` rendering of a finite value
 * @return      the same value as a C floating-point constant
 */
fn c_double_spelling(text: str): str {
    if has_c_float_marker(text) { return text }
    teko::str::concat(text, ".0")
}

/**
 * has_c_float_marker — does `text` already carry a character that makes a C numeric constant
 * FLOATING-POINT rather than integer: a decimal point or an exponent marker?
 *
 * @param text  the numeric constant text
 * @return      true iff `text` contains `.`, `e` or `E`
 */
fn has_c_float_marker(text: str): bool {
    var i: u64 = 0 to u64
    loop {
        if i >= text.len { break }
        var ch = text[i]
        if ch == b'.' || ch == b'e' || ch == b'E' { return true }
        i++
    }
    false
}

// cb_cstr_escaped — append `s` C-escaped, INSIDE an already-open C string literal. The
// bytes are raw (may contain NUL, quotes, newlines) — see TStrLit. We never rely on
// length here; the caller emits the explicit byte count separately (M.1).
// (C: `cb_cstr_escaped`.)
fn cb_cstr_escaped(buf: []byte, s: str): []byte {
    var b = buf
    var i = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c == b'\\' { b = cb(b, "\\\\") }
        else if c == b'"' { b = cb(b, "\\\"") }
        else if c == b'\n' { b = cb(b, "\\n") }
        else if c == b'\t' { b = cb(b, "\\t") }
        else if c == b'\r' { b = cb(b, "\\r") }
        else if c < 0x20 || c >= 0x7F {
            // 3-digit octal — fixed width dodges the hex "run-on digit" hazard.
            b = cb_byte(b, b'\\')
            b = cb_byte(b, (b'0' to i64 + ((c to i64 / 64) % 8)) to byte)   // octal hundreds
            b = cb_byte(b, (b'0' to i64 + ((c to i64 / 8) % 8)) to byte)   // octal tens
            b = cb_byte(b, (b'0' to i64 + (c to i64 % 8)) to byte)   // octal ones
        }
        else { b = cb_byte(b, c) }
        i++
    }
    b
}

// (C7.1k) tk_emit_meta — the build-metadata C appended to EVERY binary by the backend (after
// tk_emit_c), so the artifact carries its identity on every OS. An `@(#)`-marked string literal,
// readable by what(1) / `strings`: "@(#)<name> <version>[-<suffix>] | <description>". (The macOS
// build additionally embeds an Info.plist section; Windows VERSIONINFO + a Linux ELF note follow.)
// (C: `tk_emit_meta`.)
pub fn tk_emit_meta(name: str, version: str, suffix: str, description: str): str {
    var b: []byte = teko::list::empty()
    b = cb(b, "\n/* build metadata (teko C7.1k) — what(1)/strings-readable */\n")
    b = cb(b, "__attribute__((used)) static const char tk_build_meta[] = \"@(#)")
    b = cb_cstr_escaped(b, name)
    b = cb(b, " ")
    b = cb_cstr_escaped(b, version)
    if suffix != "" { b = cb(b, "-"); b = cb_cstr_escaped(b, suffix) }
    if description != "" { b = cb(b, " | "); b = cb_cstr_escaped(b, description) }
    b = cb(b, "\";\n")
    str(b)
}

// ---------------------------------------------------------------------------
// Types -> C type text.
// ---------------------------------------------------------------------------

/**
 * emit_prim — a `PrimKind` -> its C fixed-width type name. (C: `emit_prim`.)
 *
 * @param buf  the growable output buffer
 * @param k    the prim kind to emit
 * @return     the grown buffer
 */
fn emit_prim(buf: []byte, k: checker::PrimKind): []byte | error {
    match k {
        checker::PrimKind::U8 => cb(buf, "uint8_t")
        checker::PrimKind::U16 => cb(buf, "uint16_t")
        checker::PrimKind::U32 => cb(buf, "uint32_t")
        checker::PrimKind::U64 => cb(buf, "uint64_t")
        checker::PrimKind::I8 => cb(buf, "int8_t")
        checker::PrimKind::I16 => cb(buf, "int16_t")
        checker::PrimKind::I32 => cb(buf, "int32_t")
        checker::PrimKind::I64 => cb(buf, "int64_t")
        checker::PrimKind::F32 => cb(buf, "float")
        checker::PrimKind::F64 => cb(buf, "double")
        checker::PrimKind::Bool => cb(buf, "bool")
        checker::PrimKind::Usize => cb(buf, "uint64_t")   // (§8) unsigned machine word ≡ u64 on 64-bit (byte-identical C)
        checker::PrimKind::Size => cb(buf, "int64_t")   // (§8) signed machine word ≡ i64 on 64-bit (byte-identical C)
    }
}

// ---------------------------------------------------------------------------
// W4c — NAME MANGLING for named aggregate types.
// A named aggregate `T` in namespace `N` -> the C identifier
//   tk_t_<N with :: -> __>__<T>      (for the bare root ns, just tk_t_<T>).
// ONE helper used by BOTH the type-decl emitter and emit_type's Named case so a
// declaration and its references always agree. NOTE: the semantic Named carries only the
// BARE name (resolve.tks drops the namespace) and the typed item carries no namespace
// either, so both call sites pass an EMPTY namespace and mangle by bare name alone —
// consistent for decl + ref (the "keep it simple and consistent" rule). The namespace
// parameter is honored (`::` -> `__`) for the day the typed item carries provenance.
// (C: `mangle_type_name`.)
// ---------------------------------------------------------------------------
// (#109 W3) append a (canonical) type NAME to a C-symbol buffer, collapsing each "::" → "__" so a
// canonical "teko::emit::Reader" becomes the valid identifier fragment "teko__emit__Reader". The ONE
// place the "::"→"__" rule lives — used by mangle_type_name AND every direct tk_base_/tk_vt_ concat, so
// a decl and its every reference (fat-pointer/vtable included) agree on the same C symbol.
fn cb_tysym(buf: []byte, name: str): []byte {
    var out = buf
    var i = 0
    loop {
        if i >= name.len { break }
        if i + 1 < name.len && name[i] == b':' && name[i + 1] == b':' {
            out = cb(out, "__")
            i = i + 2
        } else {
            out = cb_byte(out, name[i])
            i++
        }
    }
    out
}

/**
 * A canonical type name rendered as a C-identifier fragment: each `::` collapsed to `__` (the str
 * twin of `cb_tysym`), so `"teko::encoding::toml::KeyStep"` becomes the valid, namespace-unique
 * fragment `"teko__encoding__toml__KeyStep"`. A name with no `::` (a root-namespace or builtin name)
 * is returned byte-for-byte unchanged, which is why every existing root-namespace union keeps its
 * historic C symbol.
 *
 * @param name  a canonical (possibly `::`-qualified) type name
 * @return      the name with every `::` rewritten to `__`
 */
fn cg_ns_c_key(name: str): str { str(cb_tysym(teko::list::empty(), name)) }

/**
 * The prefix EVERY LINKER SYMBOL that user code declares is emitted under (owner ruling
 * 2026-07-27): user code is `teko_*`, the runtime's builtins are `tk_*`, and the two families are
 * therefore disjoint by construction — no user function, in any namespace and under any name, can
 * be spelled the same as a runtime symbol. `src/lir/lower.tks` carries the identical constant for
 * the native backend, and `cgt_mangle_parity_c_and_native` proves the two agree byte for byte.
 *
 * Two surfaces deliberately do NOT carry it:
 *   * an `extern fn` — it exists to name the LITERAL foreign symbol (`getpid`, `aligned_alloc`), so
 *     both backends resolve the extern table BEFORE reaching a mangler;
 *   * the reverse-FFI `abi = "c"` export — its C symbol is a published contract with the consuming
 *     C program (`cg_c_export_symbol`), already project-root-prefixed by construction;
 *   * `main`, the C entry point, which is emitted literally.
 * Generated TYPE names (`tk_t_`, `tk_opt_`, `tk_slice_`, …) are out of scope too: a C typedef has no
 * linkage, so a clash there is a `cc` error rather than a silent substitution.
 */
const TEKO_USER_PREFIX: str = "teko_"

/**
 * The C typedef name a user TYPE is emitted under: `tk_t_` + the mangled namespace + `__` + the
 * mangled bare name. The canonical NAME may itself read `ns::Name`, which `cb_tysym` flattens to
 * `ns__Name` (#109 W3).
 *
 * This one does NOT carry `TEKO_USER_PREFIX`, and deliberately so. The prefix ruling governs the
 * LINKER SYMBOL space, where a user function silently became a runtime function; a C typedef has no
 * linkage at all, lives only inside the generated translation unit, and shares that space with the
 * rest of the generated type family (`tk_opt_`, `tk_slice_`, `tk_u_`, `tk_tag_`, `tk_base_`,
 * `tk_vt_`). A name clash there is a `cc` redefinition error — loud, never a silent substitution.
 *
 * @param buf        the emit buffer
 * @param namespace  the type's declaring namespace ("" for a root-less type)
 * @param name       the type's canonical name
 * @return           the buffer with the typedef name appended
 */
fn mangle_type_name(buf: []byte, namespace: str, name: str): []byte {
    var out = cb(buf, "tk_t_")
    if namespace.len > 0 {
        out = cb_tysym(out, namespace)
        out = cb(out, "__")
    }
    cb_tysym(out, name)
}

/**
 * The C symbol a top-level user FUNCTION is emitted under: `TEKO_USER_PREFIX` + the namespace with
 * every `:` rewritten to `_` + `__` + the bare (keyword-escaped) name.
 *
 * The prefix is what makes user symbols and runtime builtins DISJOINT BY CONSTRUCTION (owner ruling
 * 2026-07-27): everything user code declares is `teko_*`, everything the runtime provides is `tk_*`,
 * so no user function — whatever it is named, in whatever namespace — can ever be spelled the same
 * as a builtin. The namespace mangle on top of it keeps same-named functions across namespaces (and
 * libc clashes like `div`) apart. An empty namespace (a lifted lambda) yields just the prefix + the
 * bare name. Definition, prototype and resolved call all go through here, so they agree by
 * construction; `main` is the one deliberate exception and is emitted literally, never through this.
 *
 * @param buf     the emit buffer
 * @param ns      the function's declaring namespace ("" for a lifted lambda)
 * @param name    the function's bare name
 * @param suffix  the §9 A overload suffix appended verbatim after the bare name ("" for the sole
 *                declaration of a `(ns, name)`, which is the whole non-overloaded corpus — so the
 *                historic symbol is reproduced byte-for-byte; the checker guarantees it is C-legal)
 * @return        the buffer with the C symbol appended
 */
fn cb_fn_name(buf: []byte, ns: str, name: str, suffix: str = ""): []byte {
    var out = cb(buf, TEKO_USER_PREFIX)
    if ns.len != 0 {
        var i = 0
        loop {
            if i >= ns.len { break }
            if ns[i] == b':' { out = cb_byte(out, b'_') } else { out = cb_byte(out, ns[i]) }
            i++
        }
        out = cb(out, "__")
    }
    out = cb_ident(out, name)
    if suffix.len != 0 { out = cb(out, suffix) }
    out
}

/**
 * CG_TABLE_MIN_CAP — the smallest bucket count `cg_table_cap` ever hands back, so a program with a
 * handful of declarations still probes a real (never zero-sized) open-addressed table and the
 * `cap - 1` mask is always a valid all-ones word.
 *
 * @since cargo/20-codegen-perf
 */
const CG_TABLE_MIN_CAP: u64 = 16

/**
 * CG_TABLE_LOAD_NUMERATOR — the entry-count multiplier that fixes the table's maximum load factor
 * (capacity >= NUMERATOR x entries, rounded up to a power of two). At 2 the table is at most half
 * full, which bounds linear probing to a small constant AND guarantees a free bucket exists, so
 * `cg_table_get`'s probe walk always terminates on an empty slot rather than wrapping forever.
 *
 * @since cargo/20-codegen-perf
 */
const CG_TABLE_LOAD_NUMERATOR: u64 = 2

/**
 * CG_MAIN_RETURN_OPEN — the C text that OPENS the virtual-main `return` carrying a process exit
 * code (the C route's own exit-code door). It wraps the historical `(int)` cast in the runtime
 * normalizer `tk_exit_status` (`TK_EXIT_STATUS_MASK`, `src/runtime/teko_rt.h`), so a `main` that
 * returns 20203 leaves the process with 235 on EVERY platform instead of 235 on POSIX and 20203
 * on Windows (owner ruling 2026-07-30). The libc `main`-to-`exit` handoff is the reason the mask
 * cannot live in `tk_exit` alone: a `return` never calls it.
 *
 * @since cargo/0.3.1-saida-equalizada
 */
const CG_MAIN_RETURN_OPEN: str = "return tk_exit_status((int)("

/**
 * CG_MAIN_RETURN_CLOSE — the C text that CLOSES `CG_MAIN_RETURN_OPEN`: one paren for the `(int)`
 * cast's operand group, one for the `tk_exit_status` call, then the statement terminator. Paired
 * with the opener in a named const so the two never drift apart across the emission sites that
 * use them (`emit_exprstmt_tail`'s W5a tail value and `emit_return`'s explicit `return n`).
 *
 * @since cargo/0.3.1-saida-equalizada
 */
const CG_MAIN_RETURN_CLOSE: str = "));\n"

/**
 * CgNameTable — an open-addressed, linear-probed `str` -> item-index table: the DERIVED lookup
 * acceleration behind `cg_find_decl` / `cg_find_decl_exact` / `cg_find_function`.
 *
 * The table stores a SLOT (the item's index in `prog.items`, biased by one so `0` reads as "free"),
 * never a decl value, so it costs one machine word per bucket and can never disagree with the items
 * it indexes about WHICH decl a hit denotes. Buckets are three parallel arrays rather than one array
 * of a bucket struct, mirroring `teko::collections::Map`'s representation for the same reason: a
 * flat scalar array is the shape the emitter's own lowering handles best.
 *
 * FIRST-WINS is the whole contract. `cg_table_build` inserts keys in `prog.items` order and refuses
 * to overwrite an occupied key, so a probe returns the FIRST item carrying that key — exactly what
 * the linear scans it replaces returned. That is what keeps the emitted C byte-identical.
 *
 * @since cargo/20-codegen-perf
 */
type CgNameTable = struct {
    /** `capacity - 1`, the all-ones mask that folds a hash into a bucket. */
    mask: u64
    /** Each occupied bucket's cached FNV-1a key hash, compared before the full key. */
    hashes: []u64
    /** Each occupied bucket's key; `""` in a free bucket. */
    keys: []str
    /** Each bucket's item index BIASED BY ONE; `0` means the bucket is free. */
    slots: []u64
}

/**
 * CgIndex — the three derived name tables codegen resolves every type/function reference through,
 * built ONCE per emission from the final `prog.items` and threaded inside `CgProg`.
 *
 * @since cargo/20-codegen-perf
 */
type CgIndex = struct {
    /** Canonical decl name ("ns::Name" as declared) -> the first `TypeDecl` item carrying it. */
    exact: CgNameTable
    /** Bare last segment of a decl name -> the first `TypeDecl` item whose name ends in it. */
    last: CgNameTable
    /** `namespace ~ "::" ~ name` -> the first `TFunction` item carrying that pair. */
    fns: CgNameTable
    /**
     * The same-last-segment CHAIN, one entry per item: for a `TypeDecl` at index `i`, the index
     * (biased by one) of the NEXT declaration sharing its bare last segment, or `0` at the end of
     * the chain. Entered through `last`, it enumerates exactly the same-bare cousins, in item
     * order, that a namespace-precise resolution has to discriminate between.
     */
    same_last_next: []u64
}

/**
 * CgProg — codegen's view of the program under emission: the checked items PLUS the derived name
 * index over them.
 *
 * WHY THIS TYPE EXISTS. The file header already records that Teko has no module-level mutable state,
 * so codegen THREADS the program into every helper that needs it. That threading was carrying the
 * items alone, which made each name resolution a full scan of `items` — and with ~1.7M resolutions
 * over ~6k items on a self-build, that scan was 76% of the entire pass (gprof, cargo/20). Widening
 * the threaded value to carry the index alongside the items keeps the functional style and turns
 * every one of those scans into a hash probe, with no change to WHICH decl is resolved.
 *
 * The `items` field is named and typed exactly as `checker::TProgram`'s, so every `prog.items` read
 * in this file reads the same slice it always did.
 *
 * @since cargo/20-codegen-perf
 */
type CgProg = struct {
    /** The checked program's items, in declaration order — the emission's single source of truth. */
    items: []@TItem()
    /** The derived name index over `items`; empty tables make every lookup fall back to a scan. */
    ix: CgIndex
}

/**
 * Round `entries` up to the power-of-two bucket count that holds them under the table's load factor.
 *
 * @param entries  the number of keys the table must hold
 * @return         the bucket count: a power of two, at least `CG_TABLE_MIN_CAP`, and at least
 *                 `CG_TABLE_LOAD_NUMERATOR * entries`
 * @since cargo/20-codegen-perf
 */
fn cg_table_cap(entries: u64): u64 {
    var want = entries * CG_TABLE_LOAD_NUMERATOR
    var cap = CG_TABLE_MIN_CAP
    loop {
        if cap >= want { break }
        cap = cap * 2
    }
    cap
}

/**
 * A `[]u64` of `n` zeroes — the fresh backing array for a table's hash or slot column.
 *
 * @param n  the element count
 * @return   `n` zeroes
 * @since cargo/20-codegen-perf
 */
fn cg_zeros(n: u64): []u64 {
    var out: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, 0 to u64)
        i++
    }
    out
}

/**
 * A `[]str` of `n` empty strings — the fresh backing array for a table's key column.
 *
 * @param n  the element count
 * @return   `n` empty strings
 * @since cargo/20-codegen-perf
 */
fn cg_blanks(n: u64): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, "")
        i++
    }
    out
}

/**
 * Build a `CgNameTable` from parallel key/slot columns, keeping the FIRST slot offered for any
 * repeated key so a probe reproduces the scan order it replaces.
 *
 * @param keys_in   the keys, in `prog.items` order
 * @param slots_in  each key's item index biased by one, parallel to `keys_in`
 * @return          the populated open-addressed table
 * @since cargo/20-codegen-perf
 */
fn cg_table_build(keys_in: []str, slots_in: []u64): CgNameTable {
    var cap = cg_table_cap(keys_in.len)
    var mask = cap - 1
    var hashes = cg_zeros(cap)
    var keys = cg_blanks(cap)
    var slots = cg_zeros(cap)
    var n: u64 = 0
    loop {
        if n >= keys_in.len { break }
        var key = keys_in[n]
        var h = teko::runtime::str_hash(key)
        var at = h & mask
        loop {
            if slots[at] == 0 {
                hashes[at] = h
                keys[at] = key
                slots[at] = slots_in[n]
                break
            }
            if hashes[at] == h && keys[at] == key { break }
            at = (at + 1) & mask
        }
        n++
    }
    CgNameTable { mask = mask; hashes = hashes; keys = keys; slots = slots }
}

/**
 * cg_table_bucket_of — the bucket `key` occupies, or the capacity when the key is absent.
 *
 * The chain builder needs the BUCKET (a stable per-key cell it can thread a tail pointer through),
 * where every other caller wants the slot; keeping the two apart is what lets the chain be built in
 * one forward pass over the items with no second hash table.
 *
 * @param t    the table to probe
 * @param key  the key to locate
 * @return     the bucket index, or `t.mask + 1` when `key` is absent
 * @since cargo/20-codegen-perf
 */
fn cg_table_bucket_of(t: CgNameTable, key: str): u64 {
    var miss = t.mask + 1
    if t.slots.len == 0 { return miss }
    var h = teko::runtime::str_hash(key)
    var at = h & t.mask
    loop {
        if t.slots[at] == 0 { return miss }
        if t.hashes[at] == h && t.keys[at] == key { return at }
        at = (at + 1) & t.mask
    }
    miss
}

/**
 * The item index (biased by one) `key` maps to, or `0` when the key is absent or the table is empty.
 *
 * An EMPTY table answers `0` for every key, which is what makes the index optional: a `CgProg` built
 * without one degrades to the linear scans, never to a wrong answer.
 *
 * @param t    the table to probe
 * @param key  the key to look up
 * @return     the item index biased by one, or `0` on a miss
 * @since cargo/20-codegen-perf
 */
fn cg_table_get(t: CgNameTable, key: str): u64 {
    if t.slots.len == 0 { return 0 to u64 }
    var h = teko::runtime::str_hash(key)
    var at = h & t.mask
    loop {
        if t.slots[at] == 0 { return 0 to u64 }
        if t.hashes[at] == h && t.keys[at] == key { return t.slots[at] }
        at = (at + 1) & t.mask
    }
    0 to u64
}

/**
 * cg_index_of — build the three name tables over `items` in one pass.
 *
 * @param items  the checked program's items, in declaration order
 * @return       the index every `CgProg` carries
 * @since cargo/20-codegen-perf
 */
fn cg_index_of(items: []@TItem()): CgIndex {
    var exact_k: []str = teko::list::empty()
    var exact_v: []u64 = teko::list::empty()
    var last_k: []str = teko::list::empty()
    var last_v: []u64 = teko::list::empty()
    var fn_k: []str = teko::list::empty()
    var fn_v: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            parser::TypeDecl as d => {
                exact_k = teko::list::push(exact_k, d.name)
                exact_v = teko::list::push(exact_v, i + 1)
                last_k = teko::list::push(last_k, checker::name_last_segment(d.name))
                last_v = teko::list::push(last_v, i + 1)
            }
            checker::TFunction as f => {
                fn_k = teko::list::push(fn_k, cg_fn_key(f.namespace, f.name))
                fn_v = teko::list::push(fn_v, i + 1)
            }
            _ => { }
        }
        i++
    }
    var last_table = cg_table_build(last_k, last_v)
    CgIndex {
        exact = cg_table_build(exact_k, exact_v)
        last = last_table
        fns = cg_table_build(fn_k, fn_v)
        same_last_next = cg_same_last_chain(items.len, last_table, last_k, last_v)
    }
}

/**
 * cg_same_last_chain — thread every declaration to the next one sharing its bare last segment.
 *
 * One forward pass over the (already collected) last-segment keys, carrying a per-bucket TAIL so the
 * chain comes out in item order: the head lives in the `last` table and each link lands in the entry
 * of the declaration it follows.
 *
 * @param items_len   the program's item count (the chain array's length)
 * @param last_table  the built last-segment table, which owns the chain heads
 * @param last_k      each declaration's bare last segment, in item order
 * @param last_v      each declaration's item index biased by one, parallel to `last_k`
 * @return            the chain: `[i]` is the next same-last declaration after item `i`, biased by
 *                    one, or `0`
 * @since cargo/20-codegen-perf
 */
fn cg_same_last_chain(items_len: u64, last_table: CgNameTable, last_k: []str, last_v: []u64): []u64 {
    var chain = cg_zeros(items_len)
    var tail = cg_zeros(last_table.mask + 2)
    var n: u64 = 0
    loop {
        if n >= last_k.len { break }
        var bucket = cg_table_bucket_of(last_table, last_k[n])
        if tail[bucket] != 0 { chain[tail[bucket] - 1] = last_v[n] }
        tail[bucket] = last_v[n]
        n++
    }
    chain
}

/**
 * The function table's key for a (namespace, name) pair.
 *
 * The key is not required to be injective: `cg_find_function` re-checks the namespace and name of
 * the item a probe returns and falls back to its scan when they disagree, so a contrived name
 * carrying "::" costs a slow lookup rather than a wrong one.
 *
 * @param ns    the function's namespace
 * @param name  the function's name
 * @return      the composed table key
 * @since cargo/20-codegen-perf
 */
fn cg_fn_key(ns: str, name: str): str { teko::str::concat(ns, "::", name) }

/**
 * cg_prog_of — widen a checked program into codegen's threaded view, building its name index.
 *
 * @param p  the checked, monomorphized, lambda-lifted program about to be emitted
 * @return   the threaded view: the same items plus the index over them
 * @since cargo/20-codegen-perf
 */
fn cg_prog_of(p: checker::TProgram): CgProg {
    CgProg { items = p.items; ix = cg_index_of(p.items) }
}

/**
 * cg_prog_bare — codegen's threaded view WITHOUT an index, for the entry points that only walk the
 * items once and would pay more to build the index than the walk itself costs.
 *
 * @param p  the checked program
 * @return   the threaded view with empty tables (every lookup falls back to a scan)
 * @since cargo/20-codegen-perf
 */
fn cg_prog_bare(p: checker::TProgram): CgProg {
    var empty: CgNameTable = CgNameTable {
        mask = 0 to u64
        hashes = teko::list::empty()
        keys = teko::list::empty()
        slots = teko::list::empty()
    }
    var ix = CgIndex { exact = empty; last = empty; fns = empty; same_last_next = teko::list::empty() }
    CgProg { items = p.items; ix = ix }
}

/**
 * cg_type_table — the checker's type-registry view of the threaded program, for the checker helpers
 * (`effective_class_fields`, ...) that take a `TypeTable`.
 *
 * @param prog  codegen's threaded program view
 * @return      the checker's type table over the same items
 * @since cargo/20-codegen-perf
 */
fn cg_type_table(prog: CgProg): checker::TypeTable {
    checker::type_table_of(checker::TProgram { items = prog.items })
}

// ---------------------------------------------------------------------------
// W5b — VARIANT-DECL lookup (the .tks twin of the C's g_cg_prog static + scans).
//
// The C stashes the program in a file-scope `static tk_tprogram g_cg_prog` and scans its
// TYPE_DECL items. Teko has NO module-level mutable state (modules hold only `use` + decls;
// loose statements live only in main.tks), so the FUNCTIONAL mirror THREADS the program
// `prog` into the helpers that need it — the same functional-vs-static divergence the file
// header already notes (cbuf*→[]byte, err**→|error). The scans use the SAME tag/field
// spellings as emit_type_decl so wrap + decl agree byte-for-byte.
// ---------------------------------------------------------------------------

// cg_path_last — the bare last segment of a path (cases/types match by their final
// identifier). (C: `cg_path_last`.)
fn cg_path_last(p: parser::Path): str {
    if p.segments.len == 0 { "" } else { p.segments[p.segments.len - 1].name }
}

// cg_find_variant_decl — the TypeDecl for a VARIANT named `name` (its body is a union of
// named members), or a `not found` error. (C: `cg_find_variant_decl`, which returned NULL.)
fn cg_find_variant_decl(prog: CgProg, name: str): parser::TypeDecl | error {
    // (#109 W3) delegate bare-or-canonical name resolution to cg_find_decl (single source of truth),
    // then require a VariantBody. cg_find_decl matches exact ns::Name OR bare last-segment.
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => {
            match d.body { parser::VariantBody => return d; _ => { } }
        }
        error => { }
    }
    error { message = "codegen: not a declared variant" }
}

// (#109 W3) canonicalize a (possibly BARE) type name to its declared "ns::Name" so a DIRECT type
// typedef reference (`tk_t_<canonical>`) matches its definition. A name codegen builds by hand from
// a syntactic path segment (e.g. a struct-init field's slot type) is bare; the declared type name is
// canonical. Non-declared names (primitives `i64`, type-params `T`, `__g__` instances) have no decl
// and pass through unchanged. Delegates to cg_find_decl (last-segment aware) — the single source of
// truth every codegen predicate agrees on for bare→decl resolution.
fn cg_canon_name(prog: CgProg, name: str): str {
    match cg_find_decl(prog, name) { parser::TypeDecl as d => d.name; error => name }
}

/**
 * cg_canon_name_ns — the CANONICAL decl name for a syntactic type PATH, resolved in the referencing
 * namespace `ref_ns`. A bare `Reader` written in `teko::io` binds `teko::io::Reader`, NOT a
 * same-last-segment cousin in another namespace (`teko::emit::Reader`, the #109 collision) — so an
 * expected-slot type built for a call arg / struct field carries the RIGHT decl, and the
 * class->interface upcast wrap (emit_as CONTRACT slot) fires against the real contract. Falls back
 * to the ns-agnostic canonicaliser when no ns-precise decl matches (an imported type declared in
 * another namespace), preserving the pre-existing no-collision behavior.
 *
 * @param prog    the typed program
 * @param path    the syntactic type path (its last segment names the type)
 * @param ref_ns  the namespace the path is written in (the callee fn's / struct decl's namespace)
 * @return        the canonical decl name, or the ns-agnostic canonicalisation on no ns-precise hit
 */
fn cg_canon_name_ns(prog: CgProg, path: parser::Path, ref_ns: str): str {
    match cg_find_decl_ns(prog, path, ref_ns) {
        parser::TypeDecl as d => d.name
        error => cg_canon_name(prog, path.segments[path.segments.len - 1].name)
    }
}

// cg_named_is_variant — is the NAMED type `name` a (declared) variant? (C: `cg_named_is_variant`.)
fn cg_named_is_variant(prog: CgProg, name: str): bool {
    match cg_find_variant_decl(prog, name) { parser::TypeDecl => true; error => false }
}

// cg_named_is_enum — is the NAMED type `name` a (declared) enum? (C: `cg_named_is_enum`.)
fn cg_named_is_enum(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => match d.body { parser::EnumBody => true; _ => false }
        error => false
    }
}

// (C8.4) cg_named_is_flags — is the NAMED type `name` a (declared) flags? A flags member is a
// pre-emitted C constant `tk_t_<Name>_<MEMBER>` (power-of-2 unsigned int), not a C enum constant.
// (C: `cg_named_is_flags`.)
fn cg_named_is_flags(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as d => match d.body { parser::FlagsBody => true; _ => false }
        error => false
    }
}

/**
 * cg_decl_at — the `TypeDecl` an index probe's biased slot denotes, or an error when the slot is
 * free or (defensively) does not hold a type declaration.
 *
 * @param prog  codegen's threaded program view
 * @param slot  an item index biased by one, as returned by `cg_table_get`
 * @return      the declaration at that item, or a `not found` error
 * @throws      when `slot` is `0` (a probe miss) or the item is not a `TypeDecl`
 * @since cargo/20-codegen-perf
 */
fn cg_decl_at(prog: CgProg, slot: u64): parser::TypeDecl | error {
    if slot == 0 { return error { message = "codegen: no such type decl" } }
    match prog.items[slot - 1] {
        parser::TypeDecl as d => d
        _ => error { message = "codegen: no such type decl" }
    }
}

/**
 * cg_find_decl_scan — the ORDER-DEFINING linear resolution of a type name, kept as the index's
 * reference semantics and as the fallback for an unindexed `CgProg`.
 *
 * (#152) EXACT pass first — a canonical query can never be stolen by a same-bare cousin that merely
 * appears earlier (discovery order differs per platform). Then the legacy bare last-segment fallback
 * (unique in the no-collision case). ns-sensitive callers (emit_type_expr) use `cg_find_decl_ns` to
 * disambiguate a same-bare-name collision.
 *
 * @param prog  codegen's threaded program view
 * @param name  the type name to resolve, canonical or bare
 * @return      the first matching declaration in item order
 * @throws      when no declaration matches by exact name or by last segment
 */
fn cg_find_decl_scan(prog: CgProg, name: str): parser::TypeDecl | error {
    var e = 0
    loop {
        if e >= prog.items.len { break }
        match prog.items[e] {
            parser::TypeDecl as d => { if d.name == name { return d } }
            _ => { }
        }
        e++
    }
    var want = checker::name_last_segment(name)
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if checker::name_last_segment(d.name) == want { return d } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such type decl" }
}

/**
 * cg_find_decl — any TYPE_DECL (struct/variant/enum/alias) named `name`, or a `not found` error.
 * (C: `cg_find_decl`, which returned NULL.)
 *
 * Resolution is `cg_find_decl_scan`'s, reached through the threaded index: the exact table answers
 * the canonical pass and the last-segment table answers the bare fallback, each holding the FIRST
 * item carrying that key, so the decl this returns is the one the scan returned. An unindexed
 * `CgProg` runs the scan itself.
 *
 * @param prog  codegen's threaded program view
 * @param name  the type name to resolve, canonical or bare
 * @return      the resolved declaration
 * @throws      when no declaration matches by exact name or by last segment
 */
fn cg_find_decl(prog: CgProg, name: str): parser::TypeDecl | error {
    if prog.ix.exact.slots.len == 0 { return cg_find_decl_scan(prog, name) }
    var hit = cg_table_get(prog.ix.exact, name)
    if hit != 0 { return cg_decl_at(prog, hit) }
    cg_decl_at(prog, cg_table_get(prog.ix.last, checker::name_last_segment(name)))
}

// (#109 W3) resolve a SYNTACTIC type path to its decl using the referencing namespace `ref_ns`,
// against the CANONICAL decl names — so a bare `Reader` in teko::emit binds emit::Reader (not
// teko::io::Reader). Pass 1: a qualified path matches by last-segment + a decl-ns the qualifier
// selects; a bare path matches its OWN-ns (ref_ns) decl. Pass 2 (fallback): any last-segment match.
fn cg_find_decl_ns(prog: CgProg, path: parser::Path, ref_ns: str): parser::TypeDecl | error {
    // (#109 W3) the last segment may itself be a CANONICAL "ns::Name" stuffed into ONE segment —
    // this is what type_to_texpr/mono_named_texpr produce for a resolved Named (e.g. a method's
    // synthetic receiver `self: teko::checker::Sq`). Strip it to the bare last-segment for matching,
    // and lift any embedded "::"-qualifier into `qual` so ns precision is preserved.
    var last_raw = path.segments[path.segments.len - 1].name
    var last = checker::name_last_segment(last_raw)
    var embedded_qual = checker::name_qualifier(last_raw)   // "" when last_raw is already bare
    var qualified = path.segments.len > 1 || embedded_qual.len > 0
    var qual = ""
    if path.segments.len > 1 {
        var q: u64 = 0
        loop {
            if q >= path.segments.len - 1 { break }
            if q == 0 { qual = path.segments[q].name } else { qual = qual ~ "::" ~ path.segments[q].name }
            q++
        }
    } else {
        qual = embedded_qual
    }
    if prog.ix.same_last_next.len == 0 { return cg_find_decl_ns_scan(prog, last, qual, ref_ns, qualified) }
    var cur = cg_table_get(prog.ix.last, last)
    var head = cur
    loop {
        if cur == 0 { break }
        match prog.items[cur - 1] {
            parser::TypeDecl as d => { if cg_decl_ns_matches(d, qual, ref_ns, qualified) { return d } }
            _ => { }
        }
        cur = prog.ix.same_last_next[cur - 1]
    }
    cg_decl_at(prog, head)
}

/**
 * cg_decl_ns_matches — does declaration `d` satisfy the namespace side of a ns-precise resolution?
 *
 * A QUALIFIED reference binds a decl whose namespace is the written qualifier or ends in it (so a
 * partially-written `emit::Reader` still reaches `teko::emit::Reader`); a BARE reference binds its
 * own namespace's decl.
 *
 * @param d          the candidate declaration (already known to share the reference's last segment)
 * @param qual       the reference's namespace qualifier (empty for a bare reference)
 * @param ref_ns     the namespace the reference is written in
 * @param qualified  whether the reference carried a qualifier at all
 * @return           true iff `d` is the namespace-precise binding for the reference
 * @since cargo/20-codegen-perf
 */
fn cg_decl_ns_matches(d: parser::TypeDecl, qual: str, ref_ns: str, qualified: bool): bool {
    var dns = checker::name_qualifier(d.name)
    if !qualified { return dns == ref_ns }
    dns == qual || teko::runtime::str_ends_with(dns, "::" ~ qual)
}

/**
 * cg_find_decl_ns_scan — the ORDER-DEFINING linear form of the namespace-precise resolution, kept as
 * the chain walk's reference semantics and as the fallback for an unindexed `CgProg`.
 *
 * @param prog       codegen's threaded program view
 * @param last       the reference's bare last segment
 * @param qual       the reference's namespace qualifier (empty for a bare reference)
 * @param ref_ns     the namespace the reference is written in
 * @param qualified  whether the reference carried a qualifier at all
 * @return           the ns-precise declaration, else the first last-segment match
 * @throws           when no declaration carries that last segment at all
 */
fn cg_find_decl_ns_scan(prog: CgProg, last: str, qual: str, ref_ns: str, qualified: bool): parser::TypeDecl | error {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => {
                if checker::name_last_segment(d.name) == last && cg_decl_ns_matches(d, qual, ref_ns, qualified) { return d }
            }
            _ => { }
        }
        i++
    }
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            parser::TypeDecl as d => { if checker::name_last_segment(d.name) == last { return d } }
            _ => { }
        }
        j++
    }
    error { message = "codegen: no such type decl" }
}

// (W10b.CLASS increment 3) is `name` a class (as opposed to a struct/enum/…)? A class is a
// REFERENCE type — every use lowers to a pointer (emit_type_expr), so field access through one
// needs a deref (`->`, i.e. `(*recv).field`) instead of a struct's plain `.field`.
/**
 * cg_is_struct_named — is `name` a declared value `struct` (as opposed to a class/interface/…)? The
 * value-type twin of `cg_is_class_named`, and the gate for the item-14 fat-struct receiver ABI: only a
 * VALUE struct passes its receiver as a header pointer, because a class is already a pointer.
 *
 * @param prog  the typed program (decl lookup)
 * @param name  the resolved type name
 * @return      true iff `name`'s decl body is a StructBody
 * @since item-14
 */
/**
 * cg_var_is_struct_self — is this variable reference the `self` receiver of a VALUE-STRUCT method,
 * i.e. the one name this backend holds as a pointer while the checker types it as the struct itself
 * (item-14 §13.2)?
 *
 * No function-level context is threaded to answer it, and none is needed: `self` is a keyword, so it
 * binds ONLY as a method receiver, and a `self` whose resolved type is a value struct can therefore
 * only be a value-struct method's receiver. A CLASS method's `self` has a class type and is excluded,
 * because a class value is already a pointer here and the field-access path derefs it on its own.
 *
 * @param prog  the typed program (decl lookup)
 * @param e     the variable's typed expression node (carries the resolved type)
 * @param v     the variable node
 * @return      true iff `v` is a value-struct `self` and must be dereferenced
 * @since item-14
 */
/**
 * cg_expr_is_addressable — is this typed expression a C LVALUE, so `&` may be taken of it directly?
 * True for the storage-shaped nodes (a variable, a field read, an index read) and for a struct literal
 * (a C compound literal IS an lvalue, C99 §6.5.2.5). Everything else — a call result above all — is a
 * temporary with no address, so a receiver of that shape must be spilled first.
 *
 * @param e  the expression under test
 * @return   true iff `&(<e>)` is legal C
 * @since item-14
 */
fn cg_expr_is_addressable(e: checker::TExpr): bool {
    match e.kind {
        checker::TVar => true
        checker::TFieldAccess => true
        checker::TIndex => true
        checker::TStructInit => true
        _ => false
    }
}

/**
 * cg_emit_self_addr — emit the RECEIVER of a value-struct method call as the header pointer its ABI
 * now takes (item-14 §13.2).
 *
 * An ADDRESSABLE receiver emits `&(<recv>)`, so the callee writes through the caller's own
 * materialization — this is what makes an in-place mutation STICK, and it is the whole point of the
 * item. A non-addressable receiver (a call result, e.g. `mk().bump()`) has no storage to write back
 * to, so it is spilled into a temporary whose address is passed instead: the mutation lands on the
 * temporary and is discarded, which is the correct meaning of mutating a value nobody kept.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for the inner emission)
 * @param recv      the receiver expression
 * @param escaping  the enclosing function's escaping-name set
 * @param regions   the active region stack
 * @param fn_body   the enclosing function body
 * @param dctx      the defer context
 * @return          `buf` followed by a `tk_t_<mangle> *`-valued expression
 * @since item-14
 */
fn cg_emit_self_addr(buf: []byte, prog: CgProg, ret_type: @Type(), recv: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if cg_expr_is_addressable(recv) {
        var oa = cb(buf, "&(")
        oa = match emit_expr_ctx(oa, prog, ret_type, recv, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(oa, ")")
    }
    var tN = fresh_named("_rcv", buf.len to i64)
    var ot = cb(buf, "({ ")
    ot = match emit_type(ot, prog, recv.type) { []byte as o => o; error as err => return err }
    ot = cb(ot, " ")
    ot = cb(ot, tN)
    ot = cb(ot, " = ")
    ot = match emit_expr_ctx(ot, prog, ret_type, recv, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    ot = cb(ot, "; &")
    ot = cb(ot, tN)
    cb(ot, "; })")
}

fn cg_var_is_struct_self(prog: CgProg, e: checker::TExpr, v: checker::TVar): bool {
    if !teko::runtime::str_eq(v.name, "self") { return false }
    match e.type {
        checker::Named as nm => cg_is_struct_named(prog, nm.name)
        _ => false
    }
}

fn cg_is_struct_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::StructBody => true; _ => false }
        error => false
    }
}

/**
 * cg_struct_self_recv — the value-struct type `f`'s implicit `self` receiver names, or `null` when `f`
 * is not a value-struct instance method (item-14 §13.2).
 *
 * `self` is the fixed name the PARSER injects for a method's receiver (`parse_decl.tks`, the only
 * parameter it leaves untyped) and `self` is a keyword, so no user parameter can wear that name — the
 * check is exact rather than heuristic. The checker later fills the receiver's annotation in, which is
 * why the type is read here rather than the (by-then always-true) `has_type` flag.
 *
 * A CLASS receiver returns `null` on purpose: a class value is ALREADY a pointer in this backend
 * (`emit_struct_init_framed` arena-allocates and yields `tk_t_X *`), so its mutation already sticks
 * through `(*self)` and it needs no second indirection.
 *
 * @param prog  the typed program (decl lookup)
 * @param f     the function under emission
 * @return      the receiver's struct type name, or `null`
 * @since item-14
 */
fn cg_struct_self_recv(prog: CgProg, f: checker::TFunction): str | null {
    if f.params.len == 0 { return null }
    if !teko::runtime::str_eq(f.params[0].name, "self") { return null }
    var nt = match f.params[0].type_ann { parser::NamedType as x => x; _ => return null }
    if nt.path.segments.len == 0 { return null }
    var nm = nt.path.segments[nt.path.segments.len - 1].name
    if !cg_is_struct_named(prog, nm) { return null }
    nm
}

fn cg_is_class_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::ClassBody => true; _ => false }
        error => false
    }
}

// (W10b.D3) is `name` an interface (a contract)? A contract-typed value lowers to the fat
// pointer `{ data, vtable }` typedef; upcasts and dynamic method calls key off this probe.
fn cg_is_interface_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::InterfaceBody => true; _ => false }
        error => false
    }
}

/**
 * (TR1) Is `name` a `trait` declared in this program? A trait VALUE lowers to the SAME
 * `{ data, vtable }` fat pointer as an interface value (W10b.D3), so upcast + dynamic-dispatch
 * codegen key off this probe exactly as they do off `cg_is_interface_named`.
 *
 * @param prog the typed program
 * @param name the (bare or canonical) contract name
 * @return true iff `name` names a `TraitBody` decl
 */
fn cg_is_trait_named(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body { parser::TraitBody => true; _ => false }
        error => false
    }
}

// (#98) is `name` a POLYMORPHIC BASE — a non-sealed class (`abstract`/`virtual`)? A base-typed
// value lowers to the SAME fat pointer `{ data, vtable }` as an interface value (a companion
// `tk_base_<name>` typedef), so a Sub→Base upcast + base-typed dispatch reuse the D3 machinery.
fn cg_is_polymorphic_base(prog: CgProg, name: str): bool {
    match cg_find_decl(prog, name) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => match cb.kind { parser::ClassKind::Sealed => false; _ => true }
            _ => false
        }
        error => false
    }
}

/**
 * SUBCLASS_CHAIN_DEPTH_LIMIT — defensive cap on the subclass-chain hops `cg_subclass_reaches`
 * will walk before giving up. 64 is far deeper than any real inheritance chain; the bound only
 * exists so a cyclic/corrupt base chain terminates instead of recursing forever.
 */
const SUBCLASS_CHAIN_DEPTH_LIMIT: i64 = 64

// (#98) does class `sub` reach ANCESTOR class `want` through the base chain (transitively)?
// Codegen mirror of the checker's subclass_reaches — used to decide when a class value at a
// base-typed slot is a STRICT-subclass upcast (needs the fat-pointer wrap). Hop-bounded.
fn cg_subclass_reaches(prog: CgProg, sub: str, want: str, depth: i64): bool {
    if depth <= 0 { return false }
    match cg_find_decl(prog, sub) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => {
                if !cb.has_base { return false }
                // (#109 W3) `cb.base_name` is the BARE source `extends` name; `want` may be the
                // CANONICAL "ns::Name" of a base-typed slot — compare by bare last-segment.
                // (#152) EXACT when BOTH qualified (base_name arrives canonical from canon_class_bases); bare-compat otherwise.
                if checker::name_qualifier(cb.base_name) != "" && checker::name_qualifier(want) != "" {
                    if cb.base_name == want { return true }
                } else {
                    if checker::name_last_segment(cb.base_name) == checker::name_last_segment(want) { return true }
                }
                cg_subclass_reaches(prog, cb.base_name, want, depth - 1)
            }
            _ => false
        }
        error => false
    }
}

// (W10b.CLASS increment 4) SOUNDNESS GUARD: does expression `e` read `name` ANYWHERE, with NO
// exemptions? This is DELIBERATELY NOT escape.tks's `mark_expr` — that walker's "a scalar field
// off a bare local is a safe stack-member copy" refinement is sound for an ordinary STRUCT
// (which lives ON THE C STACK, so the struct binding itself always survives a frame-region drop —
// only ITS recursive-back-edge fields are heap pointers), but is UNSOUND for a CLASS instance
// (which is ALWAYS heap/region-resident — `d.age` after `tk_region_drop(d->__region)` would read
// FREED memory). So the destruction hook cannot reuse the escaping SET alone: it additionally
// requires that the binding is not referenced ANYWHERE in the SPECIFIC tail/return expression
// that runs immediately after the injected cleanup (earlier, non-tail statements are unaffected —
// they execute in original order, BEFORE the function-exit cleanup). Unhandled/complex shapes
// (TIfExpr/TMatchExpr/TLambda — nested blocks) conservatively answer `true` (assume referenced) —
// always SAFE, it only means less aggressive cleanup, never a use-after-free.
fn cg_expr_refs_name(e: checker::TExpr, name: str): bool {
    match e.kind {
        checker::TVar as v => v.name == name
        checker::TNumber => false
        checker::TStrLit => false
        checker::TByteLit => false
        checker::TCharLit => false
        checker::TBoolLit => false
        checker::TNullLit => false
        checker::TPathExpr => false
        checker::TBinary as b => cg_expr_refs_name(b.left, name) || cg_expr_refs_name(b.right, name)
        checker::TUnary as u => cg_expr_refs_name(u.operand, name)
        checker::TCompare as c => {
            if cg_expr_refs_name(c.first, name) { true } else {
                var i = 0
                var found = false
                loop { if i >= c.rest.len { break }; if cg_expr_refs_name(c.rest[i].operand, name) { found = true; break }; i++ }
                found
            }
        }
        checker::TCall as c => {
            var i = 0
            var found = false
            loop { if i >= c.args.len { break }; if cg_expr_refs_name(c.args[i], name) { found = true; break }; i++ }
            found
        }
        checker::TCast as ct => cg_expr_refs_name(ct.expr, name)
        checker::TFieldAccess as fa => cg_expr_refs_name(fa.receiver, name)
        checker::TIndex as ix => cg_expr_refs_name(ix.receiver, name) || cg_expr_refs_name(ix.index, name)
        checker::TInterp as ip => {
            var i = 0
            var found = false
            loop { if i >= ip.holes.len { break }; if cg_expr_refs_name(ip.holes[i], name) { found = true; break }; i++ }
            found
        }
        checker::TInExpr as ie => {
            if cg_expr_refs_name(ie.lhs, name) { true } else {
                var i = 0
                var found = false
                loop { if i >= ie.elems.len { break }; if cg_expr_refs_name(ie.elems[i], name) { found = true; break }; i++ }
                found
            }
        }
        checker::TStructInit as si => {
            var i = 0
            var found = false
            loop { if i >= si.field_vals.len { break }; if cg_expr_refs_name(si.field_vals[i], name) { found = true; break }; i++ }
            found
        }
        checker::TArrayLit as al => {
            var i = 0
            var found = false
            loop { if i >= al.elements.len { break }; if cg_expr_refs_name(al.elements[i].expr, name) { found = true; break }; i++ }
            found
        }
        // TIfExpr / TMatchExpr / TLambda contain nested BLOCKS (statement lists), not just
        // sub-expressions — conservatively assume referenced (safe: skips cleanup, never a UAF).
        _ => true
    }
}

// (W10b.CLASS increment 4) does `class_name` declare a `destruct(self) -> void` method (own or
// inherited — `type_struct_methods` stamps EVERY effective method under the OWNING class's own
// namespace, so searching for a TFunction named "destruct" whose namespace's last segment is
// `class_name` finds it either way)? Returns that method's mangled NAMESPACE (for cb_fn_name) or
// null if the class isn't destructible. Scoped assumption: one class of a given bare name per
// program (a name collision across namespaces both with a `destruct` is not disambiguated here).
fn cg_find_destruct_ns(prog: CgProg, class_name: str): str | null {
    cg_find_method_ns(prog, class_name, "destruct")
}

// (W10b.D3, generalized from increment 4's destruct lookup) does `class_name` provide a method
// named `method` (own or inherited — `type_struct_methods` stamps EVERY effective method under
// the OWNING class's own namespace, so searching for a TFunction named `method` whose namespace's
// last segment is `class_name` finds it either way)? Returns that method's mangled NAMESPACE (for
// cb_fn_name) or null. Scoped assumption: one class of a given bare name per program (a name
// collision across namespaces is not disambiguated here). Mirror of codegen.c::cg_find_method_ns.
fn cg_find_method_ns(prog: CgProg, class_name: str, method: str): str | null {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as tf => {
                if tf.name == method {
                    if tf.namespace == class_name { return tf.namespace }
                    if teko::str::ends_with(tf.namespace, "::" ~ class_name) { return tf.namespace }
                }
            }
            _ => { }
        }
        i++
    }
    null
}

/**
 * Is this binding's initializer a BORROWED VIEW of another region's storage — i.e. a value
 * that aliases memory the class-cleanup hook must NOT drop? A `let slot = slots[i]` reads the
 * class POINTER already stored in the slice's backing array, so `slot` and the slice element
 * are the SAME pointer sharing one `__region`. Dropping `slot->__region` at scope exit would
 * free storage the slice still owns (a use-after-free the moment the slice is read again), so
 * the cleanup hook skips a binding whose initializer indexes a slice: the slice owns the
 * region, the local only borrows it.
 *
 * @param b  the top-level `let`/`mut` binding under consideration
 * @return   true when the initializer is a slice-element read (an aliasing borrow); false when
 *           the binding owns its object (a fresh construction, call result, or field read)
 * @since #325
 */
fn cg_binding_is_slice_element_borrow(b: checker::TBinding): bool {
    match b.value.kind {
        checker::TIndex as ix => match ix.receiver.type { checker::Slice => true; _ => false }
        _ => false
    }
}

/**
 * Emit THE DESTRUCTION HOOK text: for every TOP-LEVEL `let`/`mut` binding that owns a CLASS
 * object, a call to its `destruct()` (if declared) followed by a drop of its own per-object
 * arena region (`__region`, set at construction — emit_struct_init_framed). (W10b.CLASS
 * increment 4.) A binding qualifies only when it is a simple name (not `_`, not `const`), NOT
 * in the escaping set (provably frame-local — never returned/aliased outward), NOT referenced
 * in `tail_expr` (the exit edge's OWN return/tail value, evaluated AFTER this cleanup), NOT a
 * borrowed view of a slice's storage (cg_binding_is_slice_element_borrow — the slice owns that
 * region), and of a CLASS type. Scoped to TOP-LEVEL bindings only (a nested-block local is a
 * further extension, not yet covered). Called at every one of a function's exit edges
 * (emit_return / emit_exprstmt_tail's tail-value-return / emit_function's fall-through),
 * mirroring exactly where the frame region itself gets dropped.
 *
 * `has_tail`/`tail_expr` is a plain pair, NOT `checker::TExpr | null` — a nullable wrapping the
 * compiler's own large recursive TExpr type hits a latent self-host codegen gap unrelated to
 * this feature; the has-flag pair sidesteps it, matching the codebase's has_X/X convention.
 *
 * @param prog       the whole typed program (resolves a bound name to its class decl + destruct)
 * @param escaping   names that escape the frame (returned/aliased outward — never dropped here)
 * @param fn_body    the function's top-level statements, scanned for droppable class bindings
 * @param has_tail   whether `tail_expr` carries the exit edge's own return/tail value
 * @param tail_expr  the exit edge's return/tail value (consulted only when `has_tail`)
 * @return           the C cleanup text, or an error propagated from a name/symbol lookup
 * @since #122 (W10b.CLASS)
 */
fn cg_class_cleanup_text(prog: CgProg, escaping: []str, fn_body: []@TStatement(), has_tail: bool, tail_expr: checker::TExpr): str | error {
    var out: []byte = teko::list::empty()
    var i = 0
    loop {
        if i >= fn_body.len { break }
        match fn_body[i] {
            checker::TBinding as b => {
                var name = match b.target { parser::SimpleName as sn => sn.name; parser::DestructurePattern => "" }
                var referenced_in_tail = has_tail && cg_expr_refs_name(tail_expr, name)
                var is_borrow = cg_binding_is_slice_element_borrow(b)
                if name.len > 0 && name != "_" && b.kind != parser::BindKind::Const && !cg_str_in(escaping, name) && !referenced_in_tail && !is_borrow {
                    var cname = match b.bound { checker::Named as nm => nm.name; _ => "" }
                    if cname.len > 0 && cg_is_class_named(prog, cname) {
                        match cg_find_destruct_ns(prog, cname) {
                            str as ns => {
                                out = cb_fn_name(out, ns, "destruct")
                                out = cb(out, "(")
                                out = cb_ident(out, name)
                                out = cb(out, "); ")
                            }
                            null => { }
                        }
                        out = cb(out, "tk_region_drop(")
                        out = cb_ident(out, name)
                        out = cb(out, "->__region); ")
                    }
                }
            }
            _ => { }
        }
        i++
    }
    str(out)
}

/**
 * cg_find_function_scan — the ORDER-DEFINING linear resolution of a top-level function, kept as the
 * function table's reference semantics and as the fallback for an unindexed `CgProg`.
 *
 * @param prog  codegen's threaded program view
 * @param ns    the namespace the function is declared in
 * @param name  the function's name
 * @return      the first matching function in item order
 * @throws      when no function carries that (namespace, name) pair
 */
fn cg_find_function_scan(prog: CgProg, ns: str, name: str): checker::TFunction | error {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such function" }
}

/**
 * cg_find_function — the top-level FUNCTION `name` in namespace `ns`, or a `not found` error.
 * (For call-arg wrapping — emit_call needs the callee's parameter types to wrap a bare case arg
 * into a variant param via emit_as.) (C: `cg_find_function`, which returned NULL.)
 *
 * The probe's hit is VERIFIED against the queried pair before it is returned, so the composed table
 * key never has to be injective: a mismatch simply falls through to `cg_find_function_scan`.
 *
 * @param prog  codegen's threaded program view
 * @param ns    the namespace the function is declared in
 * @param name  the function's name
 * @return      the resolved function
 * @throws      when no function carries that (namespace, name) pair
 */
fn cg_find_function(prog: CgProg, ns: str, name: str): checker::TFunction | error {
    if prog.ix.fns.slots.len == 0 { return cg_find_function_scan(prog, ns, name) }
    var hit = cg_table_get(prog.ix.fns, cg_fn_key(ns, name))
    if hit == 0 { return error { message = "codegen: no such function" } }
    match prog.items[hit - 1] {
        checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
        _ => { }
    }
    cg_find_function_scan(prog, ns, name)
    error { message = "codegen: no such function" }
}

// cg_is_prim_name — is `name` a builtin scalar (prim/byte/str/error), i.e. carries no user
// decl? (C: `cg_is_prim_name`; same set as cg_is_builtin_scalar.)
fn cg_is_prim_name(name: str): bool { cg_is_builtin_scalar(name) }

// =========================================================================
// AUTO-BOX recursive value-type back-edges. A struct field whose (named) type can reach BACK
// to the enclosing type through BY-VALUE embedding (struct field / optional inner / variant
// member / inline-union member — a SLICE is a pointer, not a by-value edge) closes an
// infinite-size cycle in C. Such a field is emitted as a heap POINTER (tk_alloc) instead of an
// inline value: construction mallocs+copies the child, field-access derefs. Mirrors the C twin.
// A VISITED set of type names (here a `[]str` threaded by return — the functional twin of the C
// stack buffer + len/cap) dedups the reachability walk so a CYCLIC type graph is explored in
// O(V+E) (a naive depth-bounded DFS revisits exponentially on cycles → codegen hangs).
// (C: `cg_nameset`/`cg_nameset_seen`/`cg_nameset_mark`.)
// =========================================================================
fn cg_nameset_seen(seen: []str, n: str): bool { cg_str_in(seen, n) }

// cg_te_reaches_byvalue — does this type-expr's BY-VALUE content reach the named type `to`?
// (C: `cg_te_reaches_byvalue`.)
fn cg_te_reaches_byvalue(prog: CgProg, te: @TypeExpr(), to: str, seen: []str): bool {
    match te {
        parser::NamedType as nt => {
            var stem = nt.path.segments[nt.path.segments.len - 1].name
            if cg_is_prim_name(stem) { return false }
            // (#122) a CLASS is a REFERENCE type — every use lowers to a POINTER (emit_type_expr),
            // so a class-named edge (`C`, `C?`, `C` inside a variant) is a POINTER edge, not a
            // by-value one; it can NEVER close a by-value size cycle. Treat it like a slice. Without
            // this, a self-referencing class-optional field (`next: Node?` on class `Node`) is
            // wrongly flagged boxed → the field becomes `tk_opt_Node *` while every construct/read
            // site emits it by value (`tk_opt_Node`), and cc rejects the pointer/value mismatch.
            if cg_is_class_named(prog, stem) { return false }
            // (S4) a generic-type USE reaches its concrete instance `Box__g__i64`, not the template.
            var y = if nt.args.len == 0 { stem } else { cg_texpr_inst_name(stem, nt.args) }
            if checker::name_last_segment(y) == checker::name_last_segment(to) { return true }   // (#109 W3) `to` (the decl name) is canonical; `y` a bare syntactic segment — compare bare
            cg_name_reaches_byvalue(prog, y, to, seen)
        }
        parser::UnionType as ut => {
            var i = 0
            loop {
                if i >= ut.members.len { break }
                if cg_te_reaches_byvalue(prog, ut.members[i], to, seen) { return true }
                i++
            }
            false
        }
        parser::SliceType => false   // a slice is a pointer — not a by-value edge
        parser::FunctionType => false   // (W10a) a function pointer — not a by-value aggregate edge
        parser::MacroType => false
    }
}
// cg_name_reaches_byvalue — does named type `from` reach named type `to` through by-value edges?
// (visited-set guarded). (C: `cg_name_reaches_byvalue`.)
fn cg_name_reaches_byvalue(prog: CgProg, from: str, to: str, seen: []str): bool {
    if cg_nameset_seen(seen, from) { return false }   // already explored this node
    var seen2 = teko::list::push(seen, from)
    var d = match cg_find_decl(prog, from) { parser::TypeDecl as dd => dd; error => return false }
    match d.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                if cg_te_reaches_byvalue(prog, sb.fields[i].type_ann, to, seen2) { return true }
                i++
            }
            false
        }
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => {
                var i = 0
                loop {
                    if i >= u.members.len { break }
                    if cg_te_reaches_byvalue(prog, u.members[i], to, seen2) { return true }
                    i++
                }
                false
            }
            _ => false
        }
        _ => false   // enum/alias — no by-value aggregate edges
    }
}
/**
 * cg_field_boxed — is the struct `sname`'s field of declared type `fte` a recursive back-edge that
 * must be stored as a heap POINTER to keep the C struct finite? True when `fte` is a NAMED type OR an
 * INLINE-TAG union (a by-value-embedded union — NOT a niche/box-optional, which is already a handle)
 * whose by-value content reaches BACK to `sname`. A slice / function type is already a pointer and
 * never boxes. This is the finitizing indirection a §9.D retired variant needs: an inline union that
 * carries itself by value through a member's struct field is boxed exactly as the named variant it
 * replaced already was, anchored on the forward-declarable `tk_u_<keys>` typedef. (C: `cg_field_boxed`.)
 *
 * @param prog   the typed program (field / representation resolution)
 * @param sname  the enclosing struct's canonical name (the back-edge target)
 * @param fte    the field's syntactic type annotation
 * @return       true iff the field must be emitted as a boxed heap pointer
 */
fn cg_field_boxed(prog: CgProg, sname: str, fte: @TypeExpr()): bool {
    var is_box_candidate = match fte {
        parser::NamedType => true
        parser::UnionType as ut => cg_union_field_inline_tag(prog, sname, ut)
        _ => false
    }
    if !is_box_candidate { return false }
    cg_te_reaches_byvalue(prog, fte, sname, teko::list::empty())
}

/**
 * cg_union_field_inline_tag — is the inline-union field type `ut` (resolved in `sname`'s namespace)
 * stored BY VALUE as an `{ tag; union }` inline-tag struct — as opposed to a niche or box-in-arena
 * OPTIONAL, which is already an 8-byte handle? Only an inline-tag union embedded by value can close a
 * by-value size cycle, so only it is a boxing candidate; the two-member `{ null, X }` niche/box optionals
 * carry their own pointer indirection (`cg_union_box_member` / `cg_union_niche_member`) and must NOT be
 * double-boxed here. A multi-member union that merely lists a `Null` case (e.g. a retired `Type`) is
 * inline-tag, not a two-member optional, so it correctly boxes.
 *
 * @param prog   the typed program (union representation classification)
 * @param sname  the enclosing struct's canonical name (its namespace resolves the member paths)
 * @param ut     the inline-union field type
 * @return       true iff `ut` resolves to the by-value inline-tag representation
 */
fn cg_union_field_inline_tag(prog: CgProg, sname: str, ut: parser::UnionType): bool {
    match cg_te_to_type_ns(prog, checker::name_qualifier(sname), parser::UnionType { members = ut.members }) {
        checker::Variant as va => match union_repr_class(prog, va, false) {
            UnionRepr::InlineTag => true
            _ => false
        }
        _ => false
    }
}

// cg_variant_has_member — does variant decl `d` have a member whose bare name is `member`?
// (The member name is the union FIELD name and the UPPERCASE tag suffix.) (C: `cg_variant_has_member`.)
fn cg_variant_has_member(d: parser::TypeDecl, member: str): bool {
    var members = match d.body {
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => u.members
            _ => return false
        }
        _ => return false
    }
    var i = 0
    loop {
        if i >= members.len { break }
        match variant_member_name(members[i]) {
            str as mn => { if mn == member { return true } }
            error => { }
        }
        i++
    }
    false
}

// emit_type — a resolved Type -> C type text. STR -> tk_str; a Named aggregate references
// its mangled typedef (decl + ref agree via mangle_type_name). The remaining structured
// types stay the honest "not yet supported" barrier (M.3). (C: `emit_type`.)
fn emit_type(buf: []byte, prog: CgProg, t: @Type()): []byte | error {
    match t {
        checker::Prim as p => emit_prim(buf, p.kind)
        checker::Byte => cb(buf, "uint8_t")
        // CHAR — a UTF-8 codepoint; runtime layout == the byte-slice `tk_char` (teko_rt.h),
        // the SAME {uint8_t*,uint64_t} shape as tk_slice_byte. Distinct only by the checker tag.
        checker::Char => cb(buf, "tk_char")
        // VOID is the return-only marker (M.3): a `-> void` function lowers to C `void`.
        // The checker (Z2a) forbids void as a value/binding/variant member, so reaching
        // here is always a Func.ret position.
        checker::Void => cb(buf, "void")
        checker::Str => cb(buf, "tk_str")
        // SLICE (`[]T`) — the generated tk_slice_<elem> struct. The sentinel/untyped slice
        // (element = the Void marker, from teko::list::empty()) never reaches here on its own —
        // emit_as wraps it to a concrete slot type, exactly like a bare `null` optional.
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => cg_slice_typename(buf, sl.element)
        }
        // W4c — a Named aggregate -> its mangled typedef name (the bare name; resolve
        // drops the namespace). decl + ref agree via mangle_type_name.
        // (W10b.CLASS increment 3) a CLASS is a REFERENCE type — every use (locals, call-arg
        // types read off .type, …) lowers to a pointer, same rule as emit_type_expr.
        checker::Named as nm => {
            // (#98) a POLYMORPHIC-BASE-typed slot is the fat pointer `tk_base_<name>` (data +
            // vtable), NOT the raw object pointer — so a Sub→Base upcast + base-typed dispatch
            // reuse the D3 fat pointer. (An interface-typed slot is likewise its fat typedef.)
            if cg_is_polymorphic_base(prog, nm.name) { cb_tysym(cb(buf, "tk_base_"), nm.name) }
            else if cg_is_class_named(prog, nm.name) { cb(mangle_type_name(buf, "", nm.name), " *") }
            else { mangle_type_name(buf, "", nm.name) }
        }
        // VARIANT (`A | B | …`) — the generated tk_u_<keys> tagged-union struct (B-cg2). Its
        // typedef is stamped in the prelude. A Named variant decl is reached via Named, not here.
        checker::Variant as va => match cg_union_niche_member(prog, va) {
            (@Type()) as x => emit_type(buf, prog, x)
            null => match cg_union_box_member(prog, va) {
                (@Type()) as bx => cb(match emit_type(buf, prog, bx) { []byte as o => o; error as e => return e }, " *")
                null => cg_variant_typename(buf, va)
            }
        }
        // (W10a) a function/closure VALUE type `(A, B) -> R` lowers to the uniform runtime
        // `tk_closure { void *fn; void *env; }` (teko_rt.h). The per-signature C type is only
        // needed at the CALL site (a cast on `.fn`), never as a storage type — so one struct
        // serves every function type.
        checker::Func => cb(buf, "tk_closure")
        // `error` — the runtime tk_error struct (E2-NATIVE; teko_rt.h). Full diagnostic fields.
        checker::Error => cb(buf, "tk_error")
        // (C7.1a) opaque FFI transport types — `ptr` is a bare `void *`, `uptr` a word-size
        // unsigned. Never dereferenced in Teko; only crosses the extern boundary.
        // (S-mem) `ptr<T>` → `<T> *`; opaque ptr (null inner) → `void *`.
        checker::Ptr as p => match p.inner {
            null => cb(buf, "void *")
            (@Type()) as t => cb(match emit_type(buf, prog, t) { []byte as o => o; error as e => return e }, " *")
        }
        checker::Uptr => cb(buf, "uintptr_t")
        // (MEM-1b) Ref<T> → a bare `<T> *` today ("C pointer without `*`/`&`"; struct wrapper waits for W9+ metadata).
        checker::Reference as r => cb(match emit_type(buf, prog, r.inner) { []byte as o => o; error as e => return e }, " *")
        checker::Null => cb(buf, "uint8_t")
    }
}

// (W10a) the C function-pointer SIGNATURE for a closure call's cast: `R (*)(A, B)`. Built from the
// callee's resolved Func type so `((R(*)(A,B))f.fn)(args)` invokes the code pointer with the right
// ABI. Empty params → `(void)`. `with_env` prepends a leading `void *` (the env-first ABI used by a
// CAPTURING closure). (C: `cg_emit_fnptr_sig`.)
fn cg_emit_fnptr_sig_ex(buf: []byte, prog: CgProg, t: @Type(), with_env: bool): []byte | error {
    match t {
        checker::Func as f => {
            var out = match emit_type(buf, prog, f.ret) { []byte as o => o; error as e => return e }
            out = cb(out, " (*)(")
            var first = true
            if with_env { out = cb(out, "void *"); first = false }
            if f.params.len == 0 {
                if first { out = cb(out, "void") }
            } else {
                var i = 0
                loop {
                    if i >= f.params.len { break }
                    if !first { out = cb(out, ", ") }
                    first = false
                    out = match emit_type(out, prog, f.params[i]) { []byte as o => o; error as e => return e }
                    i++
                }
            }
            cb(out, ")")
        }
        _ => error { message = "codegen: closure call on a non-function type (internal)" }
    }
}

// (W10) emit a CLOSURE CALL through a `tk_closure` value as a GNU statement-expression that evaluates
// each argument ONCE and DISPATCHES on `env`: a NON-capturing closure / named-fn value (env == NULL)
// calls with the no-env ABI `R(params)`; a CAPTURING closure (env != NULL) calls with the env-first
// ABI `R(void*, params)`. The callee is a local of function type (its name is the callee's last seg).
fn emit_closure_call(buf: []byte, prog: CgProg, ret_type: @Type(), c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var nm = c.callee.segments[c.callee.segments.len - 1].name
    var out = cb(buf, "({ ")
    // bind each argument to a temp (single evaluation, preserving side effects).
    var j = 0
    loop {
        if j >= c.args.len { break }
        out = match emit_type(out, prog, c.args[j].type) { []byte as o => o; error as e => return e }
        out = cb(out, " ")
        out = cb(out, teko::str::concat("_tca", teko::u64_to_str(j to u64)))
        out = cb(out, " = ")
        out = match emit_expr_ctx(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        out = cb(out, "; ")
        j++
    }
    out = cb(out, "tk_closure _tcf = ")
    out = cb_ident(out, nm)
    out = cb(out, "; _tcf.env ? ((")
    out = match cg_emit_fnptr_sig_ex(out, prog, c.callee_type, true) { []byte as o => o; error as e => return e }
    out = cb(out, ")_tcf.fn)(_tcf.env")
    var k = 0
    loop { if k >= c.args.len { break }; out = cb(out, ", "); out = cb(out, teko::str::concat("_tca", teko::u64_to_str(k to u64))); k++ }
    out = cb(out, ") : ((")
    out = match cg_emit_fnptr_sig_ex(out, prog, c.callee_type, false) { []byte as o => o; error as e => return e }
    out = cb(out, ")_tcf.fn)(")
    var m = 0
    loop { if m >= c.args.len { break }; if m > 0 { out = cb(out, ", ") }; out = cb(out, teko::str::concat("_tca", teko::u64_to_str(m to u64))); m++ }
    cb(out, "); })")
}

// OPTIONAL `T?` C REPRESENTATION (REBOOT_PLAN §202). Each distinct optional inner type maps to a
// generated struct `tk_opt_<innerMangle>` = `{ bool present; <innerCtype> value; }`. The mangle
// suffix is a deterministic function of the inner type so the typedef + every use agree. `error`
// lowers to its message tk_str, so `error?` is `tk_opt_error`. (C: `cg_opt_typename`/`cg_opt_mangle`.)
fn cg_opt_typename(buf: []byte, inner: @Type()): []byte | error {
    cg_opt_mangle(cb(buf, "tk_opt_"), inner)
}
/**
 * The C typedef NAME `tk_slice_<elemMangle>` for the SLICE value layer (F3 Model A, fixed+copy): a
 * `[]T` lowers to the generated struct `{ <elemC> *ptr; uint64_t len; uint64_t cap; }` — the
 * three-word rep whose `cap` (reserved backing, in elements) sidesteps the global push cache for the
 * in-place grow (`tk_slice_grow_inplace`). Reuses the optional element mangle for the suffix, so decl
 * + every use agree byte-for-byte. The designated `{ .ptr = …, .len = … }` construction sites leave
 * `cap` zero-initialised (an empty/push-built slice reports cap 0 and copy-grows on first append);
 * `emit_array_lit`/`emit_list_with_cap` seed the real backing cap (F3.2).
 *
 * @param buf   the output buffer to append the typename to
 * @param elem  the resolved slice element type, driving the mangle suffix
 * @return      the buffer with `tk_slice_<mangle>` appended
 * @throws      when `elem` has no representable mangle (`cg_opt_mangle`'s untyped-empty / unsupported cases)
 */
fn cg_slice_typename(buf: []byte, elem: @Type()): []byte | error {
    cg_opt_mangle(cb(buf, "tk_slice_"), elem)
}
/**
 * Does the `tk_slice_<elem>` C typedef carry the Model A `cap` third word (F3)? TRUE for every
 * GENERATED slice typedef (the 3-word `{ptr,len,cap}` rep), FALSE for the two pre-declared runtime
 * VIEW types `[]byte`/`[]char` (`tk_slice_byte`/`tk_slice_char`, kept at their 2-word `{ptr,len}`
 * shape because they cross the runtime ABI seam a `cap` slot would widen — the uniform 3-word view
 * rep is the #112 native-rep remainder). Construction seeds `.cap` only when this holds, so a
 * `[]byte`/`[]char` literal never names a member its typedef lacks.
 *
 * @param elem  the resolved slice element type
 * @return      true iff the element's slice typedef is the 3-word `{ptr,len,cap}` rep (not a view type)
 */
fn cg_slice_rep_has_cap(elem: @Type()): bool {
    match elem { checker::Byte => false; checker::Char => false; _ => true }
}
// The deterministic mangle SUFFIX for an optional inner type (used in tk_opt_<suffix>).
fn cg_opt_mangle(buf: []byte, inner: @Type()): []byte | error {
    match inner {
        checker::Prim as p => match p.kind {
            checker::PrimKind::U8 => cb(buf, "u8"); checker::PrimKind::U16 => cb(buf, "u16")
            checker::PrimKind::U32 => cb(buf, "u32"); checker::PrimKind::U64 => cb(buf, "u64")
            checker::PrimKind::I8 => cb(buf, "i8"); checker::PrimKind::I16 => cb(buf, "i16")
            checker::PrimKind::I32 => cb(buf, "i32"); checker::PrimKind::I64 => cb(buf, "i64")
            checker::PrimKind::F32 => cb(buf, "f32"); checker::PrimKind::F64 => cb(buf, "f64")
            checker::PrimKind::Bool => cb(buf, "bool")
            // (§8) machine words mangle to their 64-bit twin's key so a `[]usize` shares the u64
            // typedef and emits byte-identical C (usize ≡ u64 / size ≡ i64 on 64-bit).
            checker::PrimKind::Usize => cb(buf, "u64"); checker::PrimKind::Size => cb(buf, "i64")
        }
        checker::Byte => cb(buf, "byte")
        checker::Char => cb(buf, "char")
        checker::Str => cb(buf, "str")
        checker::Error => cb(buf, "error")
        checker::Null => cb(buf, "null")
        checker::Named as nm => cb_tysym(buf, nm.name)
        // NESTED SLICE (#81) — a `[]T` in an element/inner position mangles to `slice_<elem>`
        // (the SAME key cg_member_key_str already uses for a slice variant member), so `[][]T`
        // lowers to tk_slice_slice_<elem> and every use agrees with the collected typedef.
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => cg_opt_mangle(cb(buf, "slice_"), sl.element)
        }
        checker::Variant as va => {
            var out = cb(buf, "u")
            var i = 0
            loop {
                if i >= va.members.len { break }
                out = cb(out, "_")
                out = match cg_member_key(out, va.members[i]) { []byte as o => o; error as e => return e }
                i++
            }
            out
        }
        _ => error { message = "codegen: optional/slice inner type not yet supported" }
    }
}

// ---------------------------------------------------------------------------
// B-cg2 — VARIANT codegen (the `T | error` sum types the corpus uses pervasively).
// ---------------------------------------------------------------------------

// cg_opt_mangle_str — the resolved-type mangle SUFFIX as a STRING (the str twin of
// cg_opt_mangle, which appends to a buffer). Used to compose member keys via str concat.
fn cg_opt_mangle_str(inner: @Type()): str | error {
    match inner {
        checker::Prim as p => match p.kind {
            checker::PrimKind::U8 => "u8"; checker::PrimKind::U16 => "u16"
            checker::PrimKind::U32 => "u32"; checker::PrimKind::U64 => "u64"
            checker::PrimKind::I8 => "i8"; checker::PrimKind::I16 => "i16"
            checker::PrimKind::I32 => "i32"; checker::PrimKind::I64 => "i64"
            checker::PrimKind::F32 => "f32"; checker::PrimKind::F64 => "f64"
            checker::PrimKind::Bool => "bool"
            // (§8) machine words share their 64-bit twin's key (usize ≡ u64 / size ≡ i64).
            checker::PrimKind::Usize => "u64"; checker::PrimKind::Size => "i64"
        }
        checker::Byte => "byte"
        checker::Char => "char"
        checker::Str => "str"
        checker::Error => "error"
        checker::Null => "null"
        checker::Named as nm => cg_ns_c_key(nm.name)
        // NESTED SLICE (#81) — the str twin of cg_opt_mangle's Slice arm: `slice_<elem>`.
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => { var elem_s = match cg_opt_mangle_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", elem_s) }
        }
        checker::Variant as va => cg_union_mangle_str(va)
        _ => error { message = "codegen: optional/slice inner type not yet supported" }
    }
}

/**
 * cg_union_mangle_str — the `u_<member keys>` inner mangle suffix of a resolved anonymous union, the str
 * twin of `cg_opt_mangle`'s §9.D `Variant` arm: `u` then, per member in SOURCE ORDER, `_` + the member's
 * key (`cg_member_key_str`, which adds the C-keyword `_` guard). Byte-identical to `cg_variant_typename`'s
 * `tk_u_<keys>` minus the `tk_` prefix, so a `[](A | B)` typedef name agrees whichever path emits it.
 *
 * @param va  the resolved anonymous union (already null-first normalized at build)
 * @return    the `u_<keys>` suffix, or a member-key mangle error
 * @throws    when a member's key cannot be mangled (untyped empty slice/optional element)
 * @since     §9.D capability (b)
 */
fn cg_union_mangle_str(va: checker::Variant): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= va.members.len { break }
        var k = match cg_member_key_str(va.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

// cg_is_c_keyword — does `s` collide with a C(23) keyword? A variant member KEY (a union
// FIELD identifier) or a user identifier that spells a C keyword (`bool bool;`) is invalid, so
// it gets a trailing `_`. (C: `cg_is_c_keyword`.)
fn cg_is_c_keyword(s: str): bool {
    s == "bool" || s == "int" || s == "char" || s == "short" || s == "long" ||
    s == "float" || s == "double" || s == "void" || s == "unsigned" || s == "signed" ||
    s == "const" || s == "volatile" || s == "register" || s == "auto" || s == "static" ||
    s == "struct" || s == "union" || s == "enum" || s == "return" || s == "default" ||
    s == "goto" || s == "break" || s == "continue" || s == "case" || s == "switch" ||
    s == "do" || s == "for" || s == "while" || s == "if" || s == "else" || s == "sizeof" ||
    s == "typedef" || s == "extern" || s == "inline" || s == "restrict"
}

// cb_ident — emit a user IDENTIFIER (variable / parameter / binding / assignment target),
// escaping a C keyword with a trailing `_` (e.g. a parameter named `signed` → `signed_`).
// Applied at the definition AND every use so they agree. (C: `cb_ident`.)
fn cb_ident(buf: []byte, name: str): []byte {
    var out = cb_str(buf, name)
    if cg_is_c_keyword(name) { cb(out, "_") } else { out }
}

// cg_member_key_str — a variant member's C-IDENTIFIER-SAFE KEY (str) for a RESOLVED member
// type: the spelling used for BOTH the tag constant (TK_TAG_<V>_<UPPER key>) and the union
// field (.as.<key>). Extends cg_opt_mangle_str with the SLICE member (`slice_<elem>`), so
// EVERY member kind maps to a key. A key that collides with a C keyword (`bool`) gets a
// trailing `_` so the union field, the `.as.<key>` construction, and the destructure agree.
// (C: `cg_member_key`.)
fn cg_member_key_str(m: @Type()): str | error {
    var k = match m {
        checker::Slice as sl => match sl.element {
            checker::Void => return error { message = "codegen: an untyped slice variant member needs a known element type (internal)" }
            _ => { var inner_s = match cg_opt_mangle_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        }
        _ => match cg_opt_mangle_str(m) { str as s => s; error as e => return e }
    }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

/**
 * Report whether a resolved variant member's mangled KEY collides with a C keyword — the
 * allocation-free predicate that drives the trailing-`_` escape in the buffer-emitting
 * `cg_member_key`. Only a bare leaf key can be a keyword: a composite member (`Slice`) always
 * carries a `slice_` prefix, so it never collides; a `Prim` yields a
 * keyword only for `Bool` (`bool`), a `Char` yields `char`, and a `Named` is tested against its
 * last path segment. Mirrors `cg_is_c_keyword(cg_member_key_str(m))` byte-for-byte without
 * building the key string.
 *
 * @param m  the resolved member type whose emitted key is examined
 * @return   true when the key equals a C keyword and thus needs a trailing `_`
 */
fn cg_member_key_is_c_keyword(m: @Type()): bool {
    match m {
        checker::Prim as p => match p.kind {
            checker::PrimKind::Bool => true
            _ => false
        }
        checker::Char => true
        checker::Named as nm => cg_is_c_keyword(cg_ns_c_key(nm.name))
        _ => false
    }
}

/**
 * Append a resolved variant member's C-identifier-safe KEY directly to `buf`, with ZERO
 * throwaway `str` (AL4a-1): the key text is written straight into the byte buffer via
 * `cg_opt_mangle` (which already handles the `slice_<elem>` member shape), then a trailing `_`
 * is appended when the key collides with a C keyword so the union field, the `.as.<key>`
 * construction, and the destructure all agree. Byte-identical to the retired build-then-append
 * path (`cb(buf, cg_member_key_str(m))`).
 *
 * @param buf  the C-symbol byte buffer to append to
 * @param m    the resolved member type whose key is emitted
 * @return     the extended buffer
 * @throws     when the member is an untyped empty slice/optional with no known element type
 */
fn cg_member_key(buf: []byte, m: @Type()): []byte | error {
    var out = match cg_opt_mangle(buf, m) { []byte as o => o; error as e => return e }
    if cg_member_key_is_c_keyword(m) { cb(out, "_") } else { out }
}

/**
 * The PRE-namespace-qualification (bare) mangle suffix of a resolved inner type, str form. A user
 * `Named` reduces to its last path segment (no `::`→`__` collapse), exactly as the resolved mangle
 * did before cross-namespace qualification; every other arm is byte-identical to `cg_opt_mangle_str`
 * (builtins, `error`, `null` and the structural `slice_`/`u_` prefixes never carry a namespace).
 * This is the SELECTION key a match pattern's bare source spelling agrees with, so a pattern can be
 * matched to the resolved subject member it names without resolving the pattern's namespace.
 *
 * @param inner  the resolved inner type
 * @return       the bare mangle suffix
 * @throws       when the inner type is an untyped empty slice/optional with no known element type
 */
fn cg_opt_mangle_bare_str(inner: @Type()): str | error {
    match inner {
        checker::Named as nm => checker::name_last_segment(nm.name)
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: an untyped empty slice needs a known element type from context (internal)" }
            _ => { var elem_s = match cg_opt_mangle_bare_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", elem_s) }
        }
        checker::Variant as va => cg_union_mangle_bare_str(va)
        _ => cg_opt_mangle_str(inner)
    }
}

/**
 * The `u_<member keys>` bare (pre-qualification) mangle suffix of a resolved anonymous union — the
 * bare twin of `cg_union_mangle_str`, composing each member's `cg_member_bare_key`. Used to match a
 * grouped/nested-union pattern to the resolved subject member it names.
 *
 * @param va  the resolved anonymous union
 * @return    the bare `u_<keys>` suffix
 * @throws    when a member's bare key cannot be mangled
 */
fn cg_union_mangle_bare_str(va: checker::Variant): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= va.members.len { break }
        var k = match cg_member_bare_key(va.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

/**
 * A resolved variant member's bare (pre-namespace-qualification) C-identifier-safe key: the SELECTION
 * counterpart of `cg_member_key_str`, keeping a user `Named` member at its last path segment. The
 * keyword-escape and `slice_` prefix are identical to `cg_member_key_str`, so a bare-vs-bare compare
 * against a pattern's case key selects the same member it did before qualification.
 *
 * @param m  the resolved member type whose bare key is produced
 * @return   the bare member key
 * @throws   when the member is an untyped empty slice with no known element type
 */
fn cg_member_bare_key(m: @Type()): str | error {
    var k = match m {
        checker::Slice as sl => match sl.element {
            checker::Void => return error { message = "codegen: an untyped slice variant member needs a known element type (internal)" }
            _ => { var inner_s = match cg_opt_mangle_bare_str(sl.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        }
        _ => match cg_opt_mangle_bare_str(m) { str as s => s; error as e => return e }
    }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

/**
 * Append the deterministic C type NAME of an INLINE variant `A | B | …` directly to `buf`, with
 * ZERO throwaway `str` (AL4a-1): emit `tk_u`, then for each member in SOURCE ORDER emit `_`
 * followed by that member's key straight into the buffer. Byte-identical to the retired
 * build-then-append path that composed the whole name with `teko::str::concat`.
 *
 * @param buf  the C-symbol byte buffer to append to
 * @param v    the inline variant whose `tk_u_<keys>` name is emitted
 * @return     the extended buffer
 * @throws     when a member's key cannot be mangled (untyped empty slice/optional element)
 */
fn cg_variant_typename(buf: []byte, v: checker::Variant): []byte | error {
    var out = cb(buf, "tk_u")
    var i = 0
    loop {
        if i >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[i]) { []byte as o => o; error as e => return e }
        i++
    }
    out
}

/**
 * cg_variant_has_null — does the resolved union carry a `null` member (an absence union)? Gates the
 * C3 representation split: a null-bearing union takes the niche/`uint8`-tag rail; a null-FREE
 * `A | B | C` keeps its legacy 4-byte enum tag (mangle byte-stability, base §6.3).
 *
 * @param v  the resolved union type
 * @return   true iff a `Null` member is present
 */
fn cg_variant_has_null(v: checker::Variant): bool {
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] { checker::Null => return true; _ => { } }
        i++
    }
    false
}

/**
 * cg_union_normalize_null — canonicalize a codegen-resolved union's member order so `null`, if
 * present, is FIRST (mirroring the checker's `union_normalize_null`), collapsing any repeated `null`
 * to a single leading one. A null-free member list is returned unchanged. Keeps a union resolved by
 * the codegen-local `cg_te_to_type_ns` byte-identical to the checker-resolved one (same tk_u_ keys,
 * same tag constants), so a signature/arg-position union agrees with its emitted typedef.
 *
 * @param members  the codegen-resolved union members (source order)
 * @return         the members with any `Null` moved to (a single) index 0
 */
fn cg_union_normalize_null(members: []@Type()): []@Type() {
    var has_null = false
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { checker::Null => has_null = true; _ => { } }
        i++
    }
    if !has_null { return members }
    var out: []@Type() = teko::list::push(teko::list::empty(), checker::Null { })
    var j = 0
    loop {
        if j >= members.len { break }
        match members[j] { checker::Null => { }; _ => out = teko::list::push(out, members[j]) }
        j++
    }
    out
}

/**
 * cg_type_is_niche_able — does a resolved type carry a spare NULL bit-pattern usable as the `null`
 * niche of a two-member absence union? True for a class handle (a bare `tk_t_C *` pointer), `ptr<T>`,
 * `Ref<T>`, and the fat `str`/`error` values (whose `.ptr` is never NULL for a live value); false for
 * scalars, value structs, slices, closures, interfaces, and polymorphic bases (their fat vtable
 * pointer is a separate, later concern).
 *
 * @param prog  the typed program (class resolution for a `Named` member)
 * @param x     the candidate niche-carrying member type
 * @return      true iff `x` may be emitted bare with `NULL` meaning `null`
 */
fn cg_type_is_niche_able(prog: CgProg, x: @Type()): bool {
    match x {
        checker::Ptr => true
        checker::Reference => true
        checker::Str => true
        checker::Error => true
        checker::Named as nm => cg_is_class_named(prog, nm.name) && !cg_is_polymorphic_base(prog, nm.name)
        _ => false
    }
}

/**
 * cg_union_niche_member — for a two-member absence union `{ null, X }`, return `X` when it carries a
 * spare NULL bit-pattern so codegen may emit `X` BARE with `NULL` (or a `{ptr=NULL}` fat value)
 * meaning `null` and NO tag word; return `null` when the union must be tagged (a saturating payload,
 * a value struct, or more than two members). The niche classes are: a `Named` class handle, `Ptr`,
 * `Reference`, and `error`/`Str` (fat `{ptr,len}` whose `ptr` is never NULL for a live value).
 *
 * NOTE (divergence from the design signature, reported to the integrator): (1) the design writes
 * `cg_union_niche_member(v)`; a `Named` niche must distinguish a CLASS handle (a pointer, niche-able)
 * from a by-value struct (no NULL niche), which needs the program, so `prog` is threaded in. (2) the
 * design return is `checker::Type | null | error`; there is no failing path here, so the return is
 * the plain two-case `checker::Type | null` — `null` = tagged, a member = niche.
 *
 * @param prog  the typed program (class/interface resolution for a `Named` member)
 * @param v     the resolved union type (its members already null-first normalized)
 * @return      the niche-carrying member `X`, or `null` if the union must be tagged
 * @see         cg_union_tag_ctype (the inline `uint8`-tag path this gates)
 * @since 0.3.0.30 (null-union C3)
 */
fn cg_union_niche_member(prog: CgProg, v: checker::Variant): @Type() | null {
    if v.members.len != 2 { return null }
    var null_count = 0
    var other: @Type() | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            checker::Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return null }
    var x = match other { (@Type()) as t => t; null => return null }
    if cg_type_is_niche_able(prog, x) { return x }
    null
}

/**
 * cg_niche_is_fat — is the niche member a fat value (`str`/`error`), whose null pattern zeroes an
 * inner pointer field, versus a bare pointer handle whose null pattern is a zero word?
 *
 * @param x  the niche-carrying member type
 * @return   true for `str`/`error`; false for a class/`ptr`/`Ref` pointer handle
 */
fn cg_niche_is_fat(x: @Type()): bool {
    match x { checker::Str => true; checker::Error => true; _ => false }
}

/**
 * cg_niche_null_accessor — the C member-accessor chain whose zero encodes `null` for a niche member:
 * `""` for a bare pointer handle (the word itself), `.ptr` for a `str` (its `{ptr,len}` head), and
 * `.message.ptr` for an `error` (its leading `tk_str message`'s head). A live value never has this
 * pointer NULL (base §6.2), so its zero is the reserved `null` bit-pattern.
 *
 * @param x  the niche-carrying member type
 * @return   the accessor suffix to append to the subject before the `== 0` / `!= 0` test
 */
fn cg_niche_null_accessor(x: @Type()): str {
    match x {
        checker::Str => ".ptr"
        checker::Error => ".message.ptr"
        _ => ""
    }
}

/**
 * cg_emit_niche_null — emit the C value that MEANS `null` for a niche member `x`: a bare `0` for a
 * pointer handle (class/`ptr`/`Ref`), or a zero-filled compound literal `(<X>){0}` for a fat
 * `str`/`error` value (its `.ptr` becomes NULL).
 *
 * @param buf   the emit buffer
 * @param prog  the typed program (to spell the fat value's C type)
 * @param x     the niche-carrying member type
 * @return      `buf` with the null value appended, or an error
 * @throws      error when the fat member's C type cannot be emitted
 */
fn cg_emit_niche_null(buf: []byte, prog: CgProg, x: @Type()): []byte | error {
    if cg_niche_is_fat(x) {
        var o = cb(buf, "(")
        o = match emit_type(o, prog, x) { []byte as r => r; error as e => return e }
        return cb(o, "){0}")
    }
    cb(buf, "0")
}

/**
 * cg_emit_niche_is_null — emit the boolean test that niche subject `subj` currently holds `null`:
 * `(subj == 0)` for a pointer handle, `(subj.ptr == 0)` for a fat `str`/`error` value.
 *
 * @param buf   the emit buffer
 * @param subj  the C subject expression (the bare niche value)
 * @param x     the niche-carrying member type
 * @return      `buf` with the boolean test appended
 */
fn cg_emit_niche_is_null(buf: []byte, subj: str, x: @Type()): []byte {
    var o = cb(buf, "(")
    o = cb(o, subj)
    o = cb(o, cg_niche_null_accessor(x))
    cb(o, " == 0)")
}

/**
 * cg_emit_niche_not_null — emit the boolean test that niche subject `subj` currently holds the
 * present member `x` (non-null): `(subj != 0)` for a pointer handle, `(subj.ptr != 0)` for a fat
 * `str`/`error` value.
 *
 * @param buf   the emit buffer
 * @param subj  the C subject expression (the bare niche value)
 * @param x     the niche-carrying member type
 * @return      `buf` with the boolean test appended
 */
fn cg_emit_niche_not_null(buf: []byte, subj: str, x: @Type()): []byte {
    var o = cb(buf, "(")
    o = cb(o, subj)
    o = cb(o, cg_niche_null_accessor(x))
    cb(o, " != 0)")
}

/**
 * cg_union_tag_ctype — append the C type of a null-bearing tagged union's discriminant: a `uint8_t`
 * (the owner's 1-byte `0b00000000`), REPLACING the legacy 4-byte `enum tk_tag_<keys>` for any union
 * carrying a `null` member. A null-FREE `A | B | C` keeps its existing `tk_tag_<keys>` enum tag
 * (mangle byte-stability, base §6.3).
 *
 * @param buf  the emit buffer
 * @param v    the resolved null-bearing union
 * @return     `buf` with `uint8_t` (null-bearing) or `tk_tag_<keys>` (null-free) appended, or an error
 * @throws     error when a member key cannot be mangled
 * @since 0.3.0.30 (null-union C3)
 */
fn cg_union_tag_ctype(buf: []byte, v: checker::Variant): []byte | error {
    if cg_variant_has_null(v) { return cb(buf, "uint8_t") }
    var out = cb(buf, "tk_tag")
    var i = 0
    loop {
        if i >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[i]) { []byte as o => o; error as e => return e }
        i++
    }
    out
}

/**
 * The physical storage class chosen for a resolved union type: `Niche` (bare value, `NULL` /
 * `{ptr=NULL}` means `null`, no tag word — C3), `InlineTag` (`{ uint8_t tag; payload }`, in-frame,
 * max-size, zero-indirection — a saturating payload < 16 bytes, or an `#inline`-forced slot), or
 * `BoxInArena` (an 8-byte handle into the arena, `NULL` = `null` = zero heap, a bump-alloc cell on a
 * non-null construct — a saturating payload ≥ 16 bytes, default). This is the LAYOUT dial only,
 * orthogonal to the union's semantic category (base §6.4 Fact 4).
 *
 * @since 0.3.0.30 (null-union C4)
 */
type UnionRepr = enum { Niche; InlineTag; BoxInArena }

/**
 * cg_type_min_bytes — a conservative compile-time LOWER BOUND on the C storage size (in bytes) of a
 * resolved value type, used only to classify a union member as saturating-large (≥ 16 bytes → box)
 * versus small (< 16 → inline-tag). A `Prim` is its bit-width in bytes (at most 8 — 64 bits is the
 * language's widest scalar); `byte`/`char` are one byte; the fat `str`/`error`/slice values are two words (16); a pointer/handle/closure
 * is one word (8); a by-value struct is the sum of its field lower bounds (the walk stops at a class
 * handle / slice / pointer, one word, so a recursive back-edge never diverges); an unknown shape
 * defaults to one word. Over/under-approximation only shifts a borderline member between two valid
 * representations — never miscompiles a value.
 *
 * @param prog  the typed program (struct-field resolution for a `Named` by-value aggregate)
 * @param x     the resolved member type whose size lower bound is wanted
 * @return      a lower bound, in bytes, on `x`'s C storage size
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_type_min_bytes(prog: CgProg, x: @Type()): u64 {
    cg_type_min_bytes_d(prog, x, 0)
}

/**
 * cg_prim_min_bytes — the byte size of a scalar `Prim`: its bit width divided by 8, floored at one
 * byte so a sub-byte `bool` still occupies a whole byte. No prim reaches the 16-byte box threshold:
 * `u64`/`i64`/`f64` are the widest at 8 bytes.
 *
 * @param k  the primitive kind
 * @return   the primitive's C storage size in bytes (≥ 1)
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_prim_min_bytes(k: checker::PrimKind): u64 {
    var bits = checker::prim_width(k) to u64
    if bits < (8 to u64) { return 1 to u64 }
    bits / (8 to u64)
}

/**
 * cg_type_min_bytes_d — the depth-bounded worker behind `cg_type_min_bytes`. A `Named` by-value
 * struct sums its field lower bounds; the `depth` cap (4) and the one-word treatment of every
 * pointer/handle/slice keep the walk finite over a recursive value graph.
 *
 * @param prog   the typed program (struct-field resolution)
 * @param x      the resolved type whose size lower bound is wanted
 * @param depth  the current struct-nesting depth (a by-value struct beyond the cap counts as one word)
 * @return       a lower bound, in bytes, on `x`'s C storage size
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_type_min_bytes_d(prog: CgProg, x: @Type(), depth: u64): u64 {
    match x {
        checker::Prim as p => cg_prim_min_bytes(p.kind)
        checker::Byte => 1 to u64
        checker::Char => 4 to u64
        checker::Str => 16 to u64
        checker::Error => 16 to u64
        checker::Slice => 16 to u64
        checker::Ptr => 8 to u64
        checker::Uptr => 8 to u64
        checker::Reference => 8 to u64
        checker::Func => 16 to u64
        checker::Null => 1 to u64
        checker::Named as nm => cg_named_min_bytes(prog, nm.name, depth)
        _ => 8 to u64
    }
}

/**
 * cg_named_min_bytes — the size lower bound of a `Named` type: a CLASS/enum/interface/base is a
 * one-word handle or small scalar; a by-value STRUCT is the sum of its resolved field lower bounds
 * (below the depth cap), which is what makes a large aggregate cross the 16-byte box threshold.
 *
 * @param prog   the typed program (decl + field resolution)
 * @param name   the canonical `Named` type name
 * @param depth  the current struct-nesting depth
 * @return       a lower bound, in bytes, on the named type's C storage size
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_named_min_bytes(prog: CgProg, name: str, depth: u64): u64 {
    if cg_is_class_named(prog, name) { return 8 to u64 }
    if cg_named_is_enum(prog, name) { return 4 to u64 }
    if depth >= (4 to u64) { return 8 to u64 }
    var d = match cg_find_decl(prog, name) { parser::TypeDecl as dd => dd; error => return 8 to u64 }
    var sb = match d.body { parser::StructBody as s => s; _ => return 8 to u64 }
    var total = 0 to u64
    var i = 0
    loop {
        if i >= sb.fields.len { break }
        var ft = cg_te_to_type_ns(prog, checker::name_qualifier(name), sb.fields[i].type_ann)
        total = total + cg_type_min_bytes_d(prog, ft, depth + (1 to u64))
        i++
    }
    total
}

/**
 * cg_union_box_member — for a two-member absence union `{ null, X }`, return `X` when it is the
 * BOX-IN-ARENA class: `X` carries NO spare NULL niche (so `cg_union_niche_member` declined it) AND
 * EITHER it is SELF-RECURSIVE (`X` embeds this very union by value, so an inline layout has no finite
 * size and MUST box — the finitizing indirection a recursive value type demands) OR its saturating
 * payload is ≥ 16 bytes (a fat `str`/slice, a large by-value struct — no PRIM reaches 16 since 64
 * bits is the language's widest scalar). Such an `X` is stored as an 8-byte
 * handle into the arena (`NULL` = `null` = zero heap; a `tk_region_alloc` cell on a non-null
 * construct); return `null` for any smaller, non-recursive, niche-able member (those stay niche or
 * inline-tag). Mirrors `cg_union_niche_member`'s two-member/one-null shape gate, and closes the
 * struct-FIELD recursion gap the local/param/return null-union C5 rails already box (`.30` nullfield).
 *
 * @param prog  the typed program (niche + size + recursion classification)
 * @param v     the resolved union type (its members already null-first normalized)
 * @return      the boxed member `X`, or `null` when the union is not a box-in-arena union
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_union_box_member(prog: CgProg, v: checker::Variant): @Type() | null {
    if v.members.len != 2 { return null }
    var null_count = 0
    var other: @Type() | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            checker::Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return null }
    var x = match other { (@Type()) as t => t; null => return null }
    if cg_type_is_niche_able(prog, x) { return null }
    if cg_union_inline_recursive(prog, checker::Variant { members = v.members }, x) { return x }
    if cg_type_min_bytes(prog, x) >= (16 to u64) { return x }
    null
}

/**
 * union_repr_class — classify how a resolved union is stored: `Niche` (bare, C3), `BoxInArena`
 * (8-byte handle, saturating ≥ 16B default — C4), or `InlineTag` (`{uint8;payload}`, saturating < 16B
 * or an `#inline`-forced slot). The single source of truth the union emitter consults so every emit
 * site agrees on one physical shape per (type, forced-inline) pair.
 *
 * NOTE (divergence from the design signature, reported to the integrator): the design writes
 * `union_repr_class(v, forced_inline, table)`; a `Named` member's niche/size classification needs the
 * typed PROGRAM (class-vs-struct + field resolution), so `prog` is threaded in place of the checker
 * `table`, exactly as `cg_union_niche_member` diverged in C3.
 *
 * @param prog            the typed program (member niche + size classification)
 * @param v               the resolved union type
 * @param forced_inline   true iff an `#inline` attribute rides the binding/field storing this union
 * @return                the physical representation class
 * @since 0.3.0.30 (null-union C4)
 */
fn union_repr_class(prog: CgProg, v: checker::Variant, forced_inline: bool): UnionRepr {
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt4 => return UnionRepr::Niche
        null => { }
    }
    if forced_inline { return UnionRepr::InlineTag }
    match cg_union_box_member(prog, v) {
        (@Type()) as _gt5 => return UnionRepr::BoxInArena
        null => { }
    }
    UnionRepr::InlineTag
}

/**
 * cg_union_inline_recursive — would inline-forcing the union `union_t` be SELF-RECURSIVE (hence of no
 * finite size)? True when the candidate payload `x` transitively EMBEDS `union_t` BY VALUE, through
 * either a struct FIELD or a VARIANT MEMBER; a slice/pointer/class handle is an indirection that
 * finitizes the type and stops the walk. Walking variant members (not only struct fields) catches the
 * recursion when the payload is itself a variant whose member is a struct that carries the union back
 * (e.g. `Ptr.inner: Type | null` where `Type` is a variant with a `Ptr` member) — a size-16 fall-back
 * would MISS such a case for a small-min-byte variant, Inline it, and produce an infinite C value type.
 * The visited-name set guarantees termination over a finite type graph without a fixed depth cap.
 *
 * @param prog     the typed program (struct-field + variant-member resolution)
 * @param union_t  the resolved union whose inline-forcing is being validated
 * @param x        the resolved type currently being walked (initially the boxed payload member)
 * @return         true iff `x` embeds `union_t` by value (inline-forcing would not terminate)
 * @since 0.3.0.30 (null-union C4)
 */
fn cg_union_inline_recursive(prog: CgProg, union_t: @Type(), x: @Type()): bool {
    cg_union_inline_recursive_seen(prog, union_t, x, teko::list::empty())
}

/**
 * cg_union_inline_recursive_seen — the visited-guarded worker behind `cg_union_inline_recursive`. A
 * NAMED type already on the `seen` path yields false (that node was explored and carried no back-edge
 * to `union_t`); a class handle is a pointer indirection that finitizes the walk; a struct descends
 * its fields, a variant its members.
 *
 * @param prog     the typed program (decl + field/member resolution)
 * @param union_t  the resolved union being validated
 * @param x        the resolved type currently being walked
 * @param seen     the canonical names already on this walk (cycle guard)
 * @return         true iff `x` embeds `union_t` by value
 * @since 0.3.1 (null-union C6 variant-payload recursion)
 */
fn cg_union_inline_recursive_seen(prog: CgProg, union_t: @Type(), x: @Type(), seen: []str): bool {
    if cg_mangle_eq(union_t, x) { return true }
    var nm = match x { checker::Named as n => n; _ => return false }
    if cg_is_class_named(prog, nm.name) { return false }
    if cg_nameset_seen(seen, nm.name) { return false }
    var seen2 = teko::list::push(seen, nm.name)
    var d = match cg_find_decl(prog, nm.name) { parser::TypeDecl as dd => dd; error => return false }
    var ns = checker::name_qualifier(nm.name)
    match d.body {
        parser::StructBody as sb => cg_union_recur_in_fields(prog, union_t, ns, sb.fields, seen2)
        parser::VariantBody as vb => cg_union_recur_in_members(prog, union_t, ns, vb, seen2)
        _ => false
    }
}

/**
 * cg_union_recur_in_fields — does any struct FIELD of the walked type embed `union_t` by value?
 *
 * @param prog     the typed program (field-type resolution)
 * @param union_t  the resolved union being validated
 * @param ns       the owning struct's namespace (resolves bare field type names)
 * @param fields   the struct's fields
 * @param seen     the canonical names already on this walk (cycle guard)
 * @return         true iff a field's by-value content reaches `union_t`
 * @since 0.3.1 (null-union C6 variant-payload recursion)
 */
fn cg_union_recur_in_fields(prog: CgProg, union_t: @Type(), ns: str, fields: []parser::Field, seen: []str): bool {
    var i = 0
    loop {
        if i >= fields.len { break }
        var ft = cg_te_to_type_ns(prog, ns, fields[i].type_ann)
        if cg_union_inline_recursive_seen(prog, union_t, ft, seen) { return true }
        i++
    }
    false
}

/**
 * cg_union_recur_in_members — does any VARIANT MEMBER of the walked type embed `union_t` by value? A
 * variant's C layout embeds its largest member by value, so a member that carries the union back
 * closes a value-type cycle exactly as a struct field does.
 *
 * @param prog     the typed program (member-type resolution)
 * @param union_t  the resolved union being validated
 * @param ns       the owning variant's namespace (resolves bare member type names)
 * @param vb       the variant body
 * @param seen     the canonical names already on this walk (cycle guard)
 * @return         true iff a member's by-value content reaches `union_t`
 * @since 0.3.1 (null-union C6 variant-payload recursion)
 */
fn cg_union_recur_in_members(prog: CgProg, union_t: @Type(), ns: str, vb: parser::VariantBody, seen: []str): bool {
    var u = match vb.type_expr { parser::UnionType as ut => ut; _ => return false }
    var i = 0
    loop {
        if i >= u.members.len { break }
        var mt = cg_te_to_type_ns(prog, ns, u.members[i])
        if cg_union_inline_recursive_seen(prog, union_t, mt, seen) { return true }
        i++
    }
    false
}

/**
 * inline_attr_eligible — validate an `#inline` attribute applied to a binding or field of type `t`.
 * Legal ONLY when `t` is a boxed-by-default sum: a `Variant` whose saturating max payload is ≥ 16
 * bytes and carries no niche (the `BoxInArena` class), so `#inline` meaningfully flips it back to the
 * in-frame inline-tag. Each ineligible class is rejected with a DISTINCT reason (never a silent
 * no-op): a non-sum type; a niche-able sum (already one word); a self-recursive sum (MUST box — an
 * inline self-recursive sum has no finite size); and a sum whose payload is already < 16 bytes
 * (already inline). General scope, owner-ratified (D10).
 *
 * NOTE (divergence from the design signature, reported to the integrator): the design writes
 * `inline_attr_eligible(t, table) -> null | error`; the niche/size/recursion classification reuses the
 * codegen helpers that already take the typed PROGRAM (`cg_union_niche_member` / `cg_union_box_member`
 * / `cg_union_inline_recursive`), so `prog` is threaded in place of the checker `table`, and the
 * seed-safe legacy `error?` return is used (null = eligible, an error = the ineligible reason) — the
 * same C3 divergence as `variant_member_admissible`.
 *
 * @param prog  the typed program (member niche + size + recursion resolution)
 * @param t     the resolved type the `#inline` attribute is applied to
 * @return      null when `#inline` is legal; an error naming the ineligible class
 * @throws      error on any of the four ineligible classes (non-sum / niche-able / recursive / small)
 * @since 0.3.0.30 (null-union C4)
 */
fn inline_attr_eligible(prog: CgProg, t: @Type()): error | null {
    var v = match t {
        checker::Variant as va => va
        _ => return error { message = "`#inline` applies only to a boxed union (sum) type — this is not a sum" }
    }
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt6 => return error { message = "`#inline` is a no-op here: this union is already niche-optimal (one word, no tag)" }
        null => { }
    }
    match cg_union_box_member(prog, v) {
        (@Type()) as bx => {
            if cg_union_inline_recursive(prog, t, bx) {
                return error { message = "`#inline` cannot apply to a self-recursive union — it MUST box (an inline self-recursive sum has no finite size)" }
            }
            null
        }
        null => error { message = "`#inline` is a no-op here: this union's payload is already < 16 bytes (inline)" }
    }
}

// cg_emit_variant_ctype — emit the C TYPE for any variant-shaped resolved type: a Named
// variant decl → its mangled tk_t_<Name>; an inline `A | B | …` → its tk_u_<keys>. (C: `cg_emit_variant_ctype`.)
fn cg_emit_variant_ctype(buf: []byte, v: @Type()): []byte | error {
    match v {
        checker::Named as nm => mangle_type_name(buf, "", nm.name)
        checker::Variant as va => cg_variant_typename(buf, va)
        _ => error { message = "codegen: cg_emit_variant_ctype on a non-variant type (internal)" }
    }
}

/**
 * The mangle SUFFIX of a SYNTACTIC nested anonymous union member `(B | C | …)`: `u` then, per member
 * in SOURCE order, `_` followed by that member's namespace-qualified key. Byte-identical to the
 * resolved-type `cg_opt_mangle`'s `Variant` arm (both `u_<keys>`, the same `::`→`__` qualification and
 * keyword-escape via `cg_member_key_texpr_str`), so a nested union member `A | (B | C)` names ONE
 * typedef whether the DECL or a USE emits it (§9.D). A nested union bearing `null` is refused: the
 * type-expr path has no resolution seam to null-normalize, and the resolved path already owns every
 * null-bearing union — the §9.D sweep threads this edge only when a nested null-bearing member appears.
 *
 * @param prog    the typed program, for resolving each member path to its canonical decl name
 * @param ut      the syntactic nested union type-expr
 * @param ref_ns  the namespace the union is written in (for canonicalizing bare member paths)
 * @return        its `u_<keys>` mangle suffix
 * @throws        when the nested union bears `null`, or a member's key cannot be mangled
 * @since         §9.D capability (c)
 */
fn cg_union_texpr_mangle_str(prog: CgProg, ut: parser::UnionType, ref_ns: str): str | error {
    if cg_texpr_union_has_null(ut) {
        return error { message = "codegen: a nested union member bearing `null` is not yet mangled on the type-expr path (§9.D sweep follow-up)" }
    }
    var out = "u"
    var i = 0
    loop {
        if i >= ut.members.len { break }
        var k = match cg_member_key_texpr_str(prog, ut.members[i], ref_ns) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

/**
 * The SYNTACTIC mangle suffix as a STRING (str twin of `cg_opt_mangle_texpr`). A user `NamedType`
 * resolves its path to the canonical decl name in `ref_ns` and collapses `::`→`__` (`cg_ns_c_key`),
 * agreeing byte-for-byte with the resolved `cg_opt_mangle_str`; builtins and the structural `slice_`
 * prefix are unchanged.
 *
 * @param prog    the typed program, for resolving a bare path to its canonical decl name
 * @param te      the syntactic inner type-expr
 * @param ref_ns  the namespace the type-expr is written in
 * @return        the qualified mangle suffix
 * @throws        when the inner type-expr kind is not yet supported
 */
fn cg_opt_mangle_texpr_str(prog: CgProg, te: @TypeExpr(), ref_ns: str): str | error {
    match te {
        parser::NamedType as nt => cg_ns_c_key(cg_canon_name_ns(prog, nt.path, ref_ns))
        parser::SliceType as st => { var inner_s = match cg_opt_mangle_texpr_str(prog, st.element, ref_ns) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        parser::UnionType as ut => cg_union_texpr_mangle_str(prog, ut, ref_ns)
        _ => error { message = "codegen: optional inner type-expr not yet supported" }
    }
}

/**
 * A SYNTACTIC member's namespace-qualified key (str). A C-keyword key (`bool`) gets a trailing `_`
 * so the union field, construction, and destructure agree.
 *
 * @param prog    the typed program, for canonicalizing a bare member path
 * @param m       the syntactic member type-expr
 * @param ref_ns  the namespace the member is written in
 * @return        the qualified, keyword-escaped member key
 * @throws        when the member's key cannot be mangled
 */
fn cg_member_key_texpr_str(prog: CgProg, m: @TypeExpr(), ref_ns: str): str | error {
    var k = match cg_opt_mangle_texpr_str(prog, m, ref_ns) { str as s => s; error as e => return e }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

/**
 * The bare (pre-namespace-qualification) SYNTACTIC mangle suffix: a user `NamedType` reduces to its
 * source last path segment with no canonicalization. This is the SELECTION spelling a match pattern's
 * bare source path agrees with, used to match a pattern to the named-variant member it references.
 *
 * @param te  the syntactic inner type-expr
 * @return    the bare mangle suffix
 * @throws    when the inner type-expr kind is not yet supported
 */
fn cg_opt_mangle_texpr_bare_str(te: @TypeExpr()): str | error {
    match te {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        parser::SliceType as st => { var inner_s = match cg_opt_mangle_texpr_bare_str(st.element) { str as s => s; error as e => return e }; teko::str::concat("slice_", inner_s) }
        parser::UnionType as ut => cg_union_texpr_mangle_bare_str(ut)
        _ => error { message = "codegen: optional inner type-expr not yet supported" }
    }
}

/**
 * The `u_<keys>` bare (pre-qualification) mangle suffix of a syntactic nested union — the bare twin of
 * `cg_union_texpr_mangle_str`, composing each member's `cg_member_key_texpr_bare_str`.
 *
 * @param ut  the syntactic nested union type-expr
 * @return    the bare `u_<keys>` suffix
 * @throws    when the nested union bears `null`, or a member's key cannot be mangled
 */
fn cg_union_texpr_mangle_bare_str(ut: parser::UnionType): str | error {
    if cg_texpr_union_has_null(ut) {
        return error { message = "codegen: a nested union member bearing `null` is not yet mangled on the type-expr path (§9.D sweep follow-up)" }
    }
    var out = "u"
    var i = 0
    loop {
        if i >= ut.members.len { break }
        var k = match cg_member_key_texpr_bare_str(ut.members[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

/**
 * A SYNTACTIC member's bare (pre-qualification) key (str) — the SELECTION twin of
 * `cg_member_key_texpr_str`, keeping a user `NamedType` at its source last segment. A C-keyword key
 * (`bool`) gets a trailing `_`, matching the qualified path's escape.
 *
 * @param m  the syntactic member type-expr
 * @return   the bare, keyword-escaped member key
 * @throws   when the member's key cannot be mangled
 */
fn cg_member_key_texpr_bare_str(m: @TypeExpr()): str | error {
    var k = match cg_opt_mangle_texpr_bare_str(m) { str as s => s; error as e => return e }
    if cg_is_c_keyword(k) { teko::str::concat(k, "_") } else { k }
}

/**
 * cg_texpr_union_has_null — does a SYNTACTIC union type-expr carry a `null` member (the `null`
 * type-atom, a single-segment argument-free `NamedType` named "null")? Gates whether the
 * field/signature-position emitter routes through the C3 resolved representation.
 *
 * @param ut  the syntactic union type-expr
 * @return    true iff one of its members is the `null` atom
 */
fn cg_texpr_union_has_null(ut: parser::UnionType): bool {
    var i = 0
    loop {
        if i >= ut.members.len { break }
        match ut.members[i] {
            parser::NamedType as nt => {
                if nt.args.len == 0 && nt.path.segments.len == 1 && nt.path.segments[0].name == "null" { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

/**
 * The SYNTACTIC twin of `cg_variant_typename` — the inline-union `tk_u_<keys>` C type name from a
 * `UnionType` type-expr (a signature/field position), each member key namespace-qualified so a union
 * of same-bare-named types in different namespaces names distinct typedefs.
 *
 * @param buf     the C-symbol byte buffer to append to
 * @param prog    the typed program, for canonicalizing bare member paths
 * @param te      the syntactic union type-expr
 * @param ref_ns  the namespace the union is written in
 * @return        the buffer with `tk_u_<keys>` appended
 * @throws        when a member's key cannot be mangled
 */
fn cg_variant_typename_texpr(buf: []byte, prog: CgProg, te: parser::UnionType, ref_ns: str): []byte | error {
    var out = cb(buf, "tk_u")
    var i = 0
    loop {
        if i >= te.members.len { break }
        out = cb(out, "_")
        out = cb(out, match cg_member_key_texpr_str(prog, te.members[i], ref_ns) { str as s => s; error as e => return e })
        i++
    }
    out
}

// emit_type_expr — a SYNTACTIC type-expr (parser TypeExpr) -> C type text. Needed for
// type-decl member positions (struct field annotations, variant member types), where the
// typed item carries the SYNTACTIC body, not the resolved Type. A NamedType's last path
// segment is either a built-in name (u8..f64/bool/byte/str -> its C type) or a user type
// (-> its mangled typedef). Slice/union/optional members are honest barriers (later
// waves). (C: `emit_type_expr`.)
// (S4) a type-expr → its mangle fragment, matching checker::type_mangle (prim/str/byte/named → the
// name, slice_/opt_ prefixes, a nested generic use → its own instance name). So the instance name a
// generic USE emits agrees byte-for-byte with the stamped decl's name.
fn cg_texpr_mangle(te: @TypeExpr()): str {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if nt.args.len == 0 { last } else { cg_texpr_inst_name(last, nt.args) }
        }
        parser::SliceType as st => teko::str::concat("slice_", cg_texpr_mangle(st.element))
        parser::UnionType as ut => cg_union_texpr_inst_mangle(ut)
        parser::FunctionType => "func"   // (W10a) matches checker type_mangle's Func fragment
        parser::MacroType => ""
    }
}

/**
 * cg_union_texpr_inst_mangle — the codegen twin of the checker's `variant_mangle`: the STRUCTURE-
 * ENCODING generic-instance fragment of an inline union type-arg. `u`, then (if the union lists `null`)
 * `_null`, then per NON-null member IN SOURCE ORDER `_` + that member's `cg_texpr_mangle`. The null-first
 * order mirrors `union_normalize_null`, so a `Base<A | B>` USE names the same `Base__g__u_A_B` the
 * checker's `generic_inst_name` stamped — replacing the old lossy constant `"variant"` that collapsed
 * every inline union to one `Base__g__variant` stamp (a 2-unions-per-base collision, the §9.D blocker).
 *
 * @param ut  the inline-union type-arg
 * @return    the `u[_null]_<member fragments>` instance fragment
 */
fn cg_union_texpr_inst_mangle(ut: parser::UnionType): str {
    var out = "u"
    if cg_texpr_union_has_null(ut) { out = teko::str::concat(out, "_null") }
    var i = 0
    loop {
        if i >= ut.members.len { break }
        if !cg_texpr_member_is_null(ut.members[i]) {
            out = teko::str::concat(out, teko::str::concat("_", cg_texpr_mangle(ut.members[i])))
        }
        i++
    }
    out
}

/**
 * cg_texpr_member_is_null — is a syntactic union member the bare `null` case (a single-segment `null`
 * `NamedType`)? The null-first gate of `cg_union_texpr_inst_mangle`, mirroring `cg_texpr_union_has_null`.
 *
 * @param m  the syntactic union member
 * @return   true iff `m` is the bare `null` member
 */
fn cg_texpr_member_is_null(m: @TypeExpr()): bool {
    match m {
        parser::NamedType as nt => nt.args.len == 0 && nt.path.segments.len == 1 && nt.path.segments[0].name == "null"
        _ => false
    }
}
// `<base>__g__<arg0>[__<arg1>…]` over type-arg exprs (matches checker::generic_inst_name).
fn cg_texpr_inst_name(stem: str, args: []@TypeExpr()): str {
    var out = teko::str::concat(stem, "__g__")
    var i = 0
    loop {
        if i >= args.len { break }
        if i > 0 { out = teko::str::concat(out, "__") }
        out = teko::str::concat(out, cg_texpr_mangle(args[i]))
        i++
    }
    out
}

/**
 * cg_emit_slice_type_expr — emit the C typedef name for a SYNTACTIC slice `[]T` in a signature/field
 * position (the extracted `emit_type_expr` slice arm). A plain element keeps the fast texpr suffix
 * (`tk_slice_<elem>`); a UNION element (`[](A | B)`, §9.D b) resolves to the null-normalized
 * `checker::Slice{Variant}` and reuses the resolved slice typedef (`cg_slice_typename` → `cg_opt_mangle`'s
 * §9.D `Variant` arm), so a `[]union` USE names the same `tk_slice_u_<keys>` the DECL collected — one
 * canonicalizer (`cg_union_normalize_null`), byte-agreement by construction (mirroring the top-level
 * `UnionType` idiom).
 *
 * @param buf     the C-symbol byte buffer to append to
 * @param prog    the codegen program (decls for union resolution)
 * @param st      the slice type expression
 * @param ref_ns  the referencing namespace (for union resolution)
 * @return        the extended buffer, or a mangle error
 * @throws        when a union element's member key cannot be mangled
 * @since         §9.D capability (b)
 */
fn cg_emit_slice_type_expr(buf: []byte, prog: CgProg, st: parser::SliceType, ref_ns: str): []byte | error {
    match st.element {
        parser::UnionType => match cg_te_to_type_ns(prog, ref_ns, st) {
            checker::Slice as sl => cg_slice_typename(buf, sl.element)
            _ => cg_opt_mangle_texpr(cb(buf, "tk_slice_"), prog, st.element, ref_ns)
        }
        _ => cg_opt_mangle_texpr(cb(buf, "tk_slice_"), prog, st.element, ref_ns)
    }
}

fn emit_type_expr(buf: []byte, prog: CgProg, te: @TypeExpr(), ref_ns: str): []byte | error {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if last == "u8" { return cb(buf, "uint8_t") }
            else if last == "u16" { return cb(buf, "uint16_t") }
            else if last == "u32" { return cb(buf, "uint32_t") }
            else if last == "u64" { return cb(buf, "uint64_t") }
            else if last == "i8" { return cb(buf, "int8_t") }
            else if last == "i16" { return cb(buf, "int16_t") }
            else if last == "i32" { return cb(buf, "int32_t") }
            else if last == "i64" { return cb(buf, "int64_t") }
            else if last == "f32" { return cb(buf, "float") }
            else if last == "f64" { return cb(buf, "double") }
            else if last == "bool" { return cb(buf, "bool") }
            else if last == "usize" { return cb(buf, "uint64_t") }   // (§8) unsigned machine word ≡ u64 on 64-bit (a NUMBER — distinct from `uptr`, the opaque address → uintptr_t)
            else if last == "size" { return cb(buf, "int64_t") }   // (§8) signed machine word ≡ i64 on 64-bit
            else if last == "byte" { return cb(buf, "uint8_t") }
            else if last == "char" { return cb(buf, "tk_char") }   // UTF-8 codepoint (byte-slice layout)
            else if last == "str" { return cb(buf, "tk_str") }
            else if last == "error" { return cb(buf, "tk_error") }   // error → runtime tk_error struct (E2-NATIVE)
            else if last == "ptr" { if nt.args.len > 0 { return cb(match emit_type_expr(buf, prog, nt.args[0], ref_ns) { []byte as o => o; error as e => return e }, " *") } else { return cb(buf, "void *") } }   // ptr<T> → <T> * ; ptr → void *
            else if last == "uptr" { return cb(buf, "uintptr_t") }   // (C7.1a) opaque word-size unsigned
            else if last == "Ref" { if nt.args.len > 0 { return cb(match emit_type_expr(buf, prog, nt.args[0], ref_ns) { []byte as o => o; error as e => return e }, " *") } else { return error { message = "`Ref<T>` needs a type argument" } } }   // (MEM-1b) Ref<T> → <T> *
            // (#109 W3) resolve the SYNTACTIC path to its canonical decl in `ref_ns` — so a bare
            // `Reader` in teko::emit binds emit::Reader (not io::Reader), and the decl's CANONICAL
            // name (`teko::emit::Reader`) drives every mangle, matching the decl-side typedef.
            var cdname = match cg_find_decl_ns(prog, nt.path, ref_ns) { parser::TypeDecl as d => d.name; error => last }
            // a TRANSPARENT alias (`type Name = <type-expr>`) emits NO C type of its own — resolve
            // through to the aliased type-expr at every use site. Matches the checker.
            match cg_find_decl_ns(prog, nt.path, ref_ns) {
                parser::TypeDecl as ad => match ad.body {
                    parser::AliasBody as alb => return emit_type_expr(buf, prog, alb.alias, ref_ns)
                    _ => { }
                }
                error => { }
            }
            // (S4) a generic-type USE `Box<i64>` → the concrete instance typedef `tk_t_Box__g__i64`
            // (the mangled name matches checker::generic_inst_name, so decl + ref agree).
            if nt.args.len > 0 { return mangle_type_name(buf, "", cg_texpr_inst_name(last, nt.args)) }
            // (W10b.CLASS increment 3) a CLASS is a REFERENCE type → a POINTER everywhere.
            // (#98) a POLYMORPHIC-BASE-typed annotation is the fat pointer `tk_base_<name>` (data +
            // vtable), matching cg_emit_c_type. (#109 W3) mangle the CANONICAL cdname (":: → __").
            if cg_is_polymorphic_base(prog, cdname) { return cb_tysym(cb(buf, "tk_base_"), cdname) }
            match cg_find_decl_ns(prog, nt.path, ref_ns) {
                parser::TypeDecl as cd => match cd.body {
                    parser::ClassBody => return cb(mangle_type_name(buf, "", cdname), " *")
                    _ => { }
                }
                error => { }
            }
            // a user-defined named aggregate -> its mangled typedef name (matches emit_type).
            mangle_type_name(buf, "", cdname)
        }
        parser::SliceType as st => cg_emit_slice_type_expr(buf, prog, st, ref_ns)
        // INLINE union `A | B | …` in a signature/field position → the generated tk_u_<keys>
        // tagged-union struct (B-cg2); the typedef is stamped in the prelude. (C: emit_type_expr TEXPR_UNION arm.)
        parser::UnionType as ut => {
            if !cg_texpr_union_has_null(ut) { return cg_variant_typename_texpr(buf, prog, ut, ref_ns) }
            match cg_te_to_type_ns(prog, ref_ns, te) {
                checker::Variant as va => match cg_union_niche_member(prog, va) {
                    (@Type()) as x => emit_type(buf, prog, x)
                    null => match cg_union_box_member(prog, va) {
                        (@Type()) as bx => cb(match emit_type(buf, prog, bx) { []byte as o => o; error as e => return e }, " *")
                        null => cg_variant_typename(buf, va)
                    }
                }
                _ => cg_variant_typename_texpr(buf, prog, ut, ref_ns)
            }
        }
        // (W10a) a function-type field/param annotation → the uniform `tk_closure` (teko_rt.h).
        parser::FunctionType => cb(buf, "tk_closure")
        parser::MacroType => error { message = "internal: an unexpanded @Type() macro reached codegen — it should be expanded by the Family-A pre-pass (§14 A4)" }
    }
}

/**
 * The deterministic optional-mangle SUFFIX for a SYNTACTIC inner type-expr (the struct-field /
 * member position twin of `cg_opt_mangle`), emitted straight into `buf`. A user `NamedType` resolves
 * its path to the canonical decl name in `ref_ns` and collapses `::`→`__`, so a `[]T`/`T?` over a
 * namespaced element names the same `tk_slice_`/`tk_opt_` typedef the resolved path collects. Must
 * agree byte-for-byte with `cg_opt_mangle`.
 *
 * @param buf     the C-symbol byte buffer to append to
 * @param prog    the typed program, for canonicalizing a bare path
 * @param te      the syntactic inner type-expr
 * @param ref_ns  the namespace the type-expr is written in
 * @return        the extended buffer
 * @throws        when the inner type-expr kind is not yet supported
 */
fn cg_opt_mangle_texpr(buf: []byte, prog: CgProg, te: @TypeExpr(), ref_ns: str): []byte | error {
    match te {
        parser::NamedType as nt => cb_tysym(buf, cg_canon_name_ns(prog, nt.path, ref_ns))
        _ => error { message = "codegen: optional inner type-expr not yet supported" }
    }
}

// ---------------------------------------------------------------------------
// Operator token kind -> C operator text. The C returned `const char *` with NULL ==
// unsupported; here the NULL sentinel is an honest `str | error` (M.3).
// ---------------------------------------------------------------------------

// binop_c — a binary operator token -> its C spelling. (C: `binop_c`.)
fn binop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Plus => "+"
        lexer::TokenKind::Minus => "-"
        lexer::TokenKind::Star => "*"
        lexer::TokenKind::Slash => "/"
        lexer::TokenKind::Percent => "%"
        lexer::TokenKind::Amp => "&"
        lexer::TokenKind::Pipe => "|"
        lexer::TokenKind::Caret => "^"
        lexer::TokenKind::Shl => "<<"
        lexer::TokenKind::Shr => ">>"
        lexer::TokenKind::AndAnd => "&&"
        lexer::TokenKind::OrOr => "||"
        _ => error { message = "codegen: binary operator not yet supported" }
    }
}

// unop_c — a unary prefix operator token -> its C spelling. (C: `unop_c`.)
fn unop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Minus => "-"
        lexer::TokenKind::Tilde => "~"
        lexer::TokenKind::Bang => "!"
        _ => error { message = "codegen: unary operator not yet supported" }
    }
}

// cmpop_c — a comparison operator token -> its C spelling. (C: `cmpop_c`.)
fn cmpop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::EqEq => "=="
        lexer::TokenKind::Ne => "!="
        lexer::TokenKind::Lt => "<"
        lexer::TokenKind::Le => "<="
        lexer::TokenKind::Gt => ">"
        lexer::TokenKind::Ge => ">="
        _ => error { message = "codegen: comparison operator not yet supported" }
    }
}

// assignop_c — an assignment operator token -> its C spelling. (C: `assignop_c`.)
fn assignop_c(op: lexer::TokenKind): str | error {
    match op {
        lexer::TokenKind::Assign => "="
        lexer::TokenKind::PlusEq => "+="
        lexer::TokenKind::MinusEq => "-="
        lexer::TokenKind::StarEq => "*="
        lexer::TokenKind::SlashEq => "/="
        lexer::TokenKind::PercentEq => "%="
        lexer::TokenKind::AmpEq => "&="
        lexer::TokenKind::PipeEq => "|="
        lexer::TokenKind::CaretEq => "^="
        lexer::TokenKind::ShlEq => "<<="
        lexer::TokenKind::ShrEq => ">>="
        _ => error { message = "codegen: assignment operator not yet supported" }
    }
}

// ---------------------------------------------------------------------------
// F3 GUARDS (M.1 — fail loud): the prim helpers that pick the right runtime guard.
// Integer prims only; bool is never a guard target.
// ---------------------------------------------------------------------------

/**
 * cg_prim_is_float — the IEEE float prims (F32/F64). (type.tks: `prim_is_float`.) Mirrors the
 * `type.tks` predicate but stays local so the F3 logic is self-contained; exhaustive over the
 * native prim set (u8..u64/i8..i64 + the floats f32/f64, drop-128 2026-07-24). (C twin:
 * `cg_prim_is_float`.)
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is a float
 */
fn cg_prim_is_float(k: checker::PrimKind): bool { checker::prim_is_float(k) }

/**
 * cg_prim_is_int — the integer prims (U8..U64, I8..I64). NOT bool, NOT float.
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is an integer
 */
fn cg_prim_is_int(k: checker::PrimKind): bool { checker::prim_is_int(k) }

/**
 * cg_assert_c_symbol — the C symbol for an INJECTED `teko::assert::<name>` call, or "" when the call
 * is not a `teko::assert::*` builtin.
 *
 * The injected assertions are recognized by the checker as builtins WITHOUT a resolved namespace
 * (empty `call_ns`), so a standalone project that does not itself define `teko::assert` would
 * otherwise emit the BARE last segment (`is_true(...)`) — undeclared C, breaking the native test
 * gate. This keys on the same shape the lowering does (`segments[0] == "teko"` and
 * `segments[len-2] == "assert"`) and emits the `teko__assert__<name>` symbol the assert seed
 * (src/assert/assert.{c,h}) defines/declares.
 *
 * The caller only consults this when `call_ns` is empty; a project that DEFINES its own
 * `teko::assert` resolves the call with a namespace and keeps the resolved-user-call lowering
 * (`cb_fn_name` → the same mangled symbol), so the emitted C is byte-unchanged for the compiler's own
 * corpus and the FIXPOINT is intact.
 *
 * WHICH names are assertions is asked of `checker::assert_builtin_name`, never re-listed here — see
 * that function for the drift this collapse ends.
 *
 * @param callee  the call's callee path (parser::Path)
 * @return        "teko__assert__<name>" for an injected assertion under `teko::assert`, else ""
 * @since #168
 */
fn cg_assert_c_symbol(callee: parser::Path): str {
    var segs = callee.segments
    if segs.len < 2 { return "" }
    if segs[0].name != "teko" { return "" }
    if segs[segs.len - 2].name != "assert" { return "" }
    if checker::assert_builtin_name(segs[segs.len - 1].name) {
        return teko::str::concat("teko__assert__", segs[segs.len - 1].name)
    }
    ""
}

/**
 * cg_prim_is_signed_int — the SIGNED integer prims (I8..I64). (type.tks: `prim_is_signed`.)
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is a signed integer
 */
fn cg_prim_is_signed_int(k: checker::PrimKind): bool { checker::prim_is_signed(k) }

/**
 * cg_int_width — bit-width ordinal (8/16/32/64) for narrowing analysis; ints only.
 *
 * @param k  the prim kind to measure
 * @return   its bit width, or 0 for a non-integer prim
 */
fn cg_int_width(k: checker::PrimKind): i64 {
    match k {
        checker::PrimKind::U8 => 8
        checker::PrimKind::I8 => 8
        checker::PrimKind::U16 => 16
        checker::PrimKind::I16 => 16
        checker::PrimKind::U32 => 32
        checker::PrimKind::I32 => 32
        checker::PrimKind::U64 => 64
        checker::PrimKind::I64 => 64
        checker::PrimKind::Usize => 64   // (§8) machine word — 64-bit
        checker::PrimKind::Size => 64   // (§8) machine word — 64-bit
        _ => 0
    }
}

/**
 * prim_div_tag — the tag ("u8".."i64", "f32"/"f64") naming a div/mod (or cast) helper, e.g.
 * `tk_div_u32` / `tk_div_f64` / `tk_to_i16`. Bool has no tag (never a guard target); the C
 * returned NULL for Bool, here that is an honest `str | error`. (C: `prim_div_tag`.)
 *
 * @param k  the prim kind to tag
 * @return   the runtime-helper suffix
 * @throws   when `k` is `Bool` (no div/cast helper exists)
 */
fn prim_div_tag(k: checker::PrimKind): str | error {
    match k {
        checker::PrimKind::U8 => "u8"
        checker::PrimKind::U16 => "u16"
        checker::PrimKind::U32 => "u32"
        checker::PrimKind::U64 => "u64"
        checker::PrimKind::I8 => "i8"
        checker::PrimKind::I16 => "i16"
        checker::PrimKind::I32 => "i32"
        checker::PrimKind::I64 => "i64"
        checker::PrimKind::F32 => "f32"
        checker::PrimKind::F64 => "f64"
        checker::PrimKind::Bool => error { message = "codegen: bool has no div/cast helper tag" }
        // (§8) machine words reuse their 64-bit twin's div/cast helpers (usize ≡ u64 / size ≡ i64).
        checker::PrimKind::Usize => "u64"
        checker::PrimKind::Size => "i64"
    }
}

/**
 * prim_int_tag — the integer-target tag ("u8".."i64") naming a cast helper; error for
 * non-ints (float/bool). Reuses `prim_div_tag` once integer-ness is established.
 *
 * @param k  the prim kind to tag
 * @return   the runtime-helper suffix
 * @throws   when `k` is not an integer
 */
fn prim_int_tag(k: checker::PrimKind): str | error {
    if cg_prim_is_int(k) { return prim_div_tag(k) }
    error { message = "codegen: cast to a non-integer type not yet supported" }
}

/**
 * prim_float_tag — the float-source suffix ("f32"/"f64") for a float->int cast helper
 * (`tk_to_<dst>_from_<fsrc>`); error for non-floats.
 *
 * @param k  the prim kind to tag
 * @return   the float-source suffix
 * @throws   when `k` is not a float
 */
fn prim_float_tag(k: checker::PrimKind): str | error {
    match k {
        checker::PrimKind::F32 => "f32"
        checker::PrimKind::F64 => "f64"
        _ => error { message = "codegen: not a float source type" }
    }
}

/**
 * cast_may_lose — may an INT->INT cast `src`->`dst` lose data, and therefore need a runtime fit
 * guard? True when SOME value of the source type falls outside the destination's representable
 * range: a true narrowing at equal signedness, an unsigned source into a signed destination of the
 * same-or-smaller width (the destination spends one bit on the sign), or ANY signed source into an
 * unsigned destination (a negative value never fits).
 *
 * Delegates to the checker's `cast_is_lossless_widen`, of which this is the exact complement, so
 * the two EMISSION routes ask ONE width table. It used to carry its own copy, and the native route
 * carried none — the divergence that let `300 to u8` answer 300 natively while the C route
 * correctly panicked.
 *
 * @param src  the cast operand's PrimKind
 * @param dst  the cast target's PrimKind
 * @return     whether the pair needs the fail-loud runtime range check
 * @see        checker::cast_is_lossless_widen — the single source of truth this negates
 */
pub fn cast_may_lose(src: checker::PrimKind, dst: checker::PrimKind): bool {
    !checker::cast_is_lossless_widen(src, dst)
}

// ---------------------------------------------------------------------------
// Expressions -> C expression text. The C threaded `cbuf *b` + `const char **err` and
// returned bool; here each helper takes `buf` and returns the grown `[]byte | error`
// (the buffer carries the result; the error short-circuits the walk).
// ---------------------------------------------------------------------------

// emit_div_mod — the F3 (M.1) `/` and `%` path: a checked runtime helper (tk_div_*/
// tk_mod_*) that PANICS on a zero divisor instead of UB/SIGFPE. Single-eval — each
// operand emitted once, passed by value. The helper width comes from the node's result
// prim. (C: inlined inside emit_expr's TK_TEXPR_BINARY `/` `%` branch.)
// NOTE (W5b threading): the C reaches the stashed program via a file-scope `static
// g_cg_prog`; Teko has no module-level mutable state, so the FUNCTIONAL mirror THREADS the
// read-only `prog` through the expr/stmt chain (the same functional-vs-static divergence the
// file header notes for cbuf*→[]byte and err**→|error). It is needed only at the variant
// frontier (emit_as / the match emitters), but the chain that can reach those carries it.
fn emit_div_mod(buf: []byte, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var prim = match e.type {
        checker::Prim as p => p
        _ => return error { message = "codegen: division/modulo on a non-primitive type not yet supported" }
    }
    // `%` is invalid on floats (no C float modulo operator). Ruling §5: error.
    if b.op == lexer::TokenKind::Percent && cg_prim_is_float(prim.kind) {
        return error { message = "codegen: modulo on a float type is not allowed" }
    }
    var tag = match prim_div_tag(prim.kind) {
        str as t => t
        error => return error { message = "codegen: division/modulo on a non-numeric type not yet supported" }
    }
    var out = buf
    if b.op == lexer::TokenKind::Slash { out = cb(out, "tk_div_") } else { out = cb(out, "tk_mod_") }
    out = cb(out, tag)
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")")
}

/**
 * emit_div_mod_assign — F3 (M.1)'s compound-assignment twin of `emit_div_mod`: `/=`/`%=`
 * rewritten as `lvalue = tk_div_<w>(lvalue, rhs)` / `tk_mod_<w>(lvalue, rhs)`, the SAME
 * zero-divisor-panicking runtime helper the binary `/`/`%` operator already routes through.
 * Without this rewrite the raw C `/=`/`%=` compound operator falls straight to hardware
 * division — an x86-64 SIGFPE by ISA accident, never the deliberate panic the plain-operator
 * form already guarantees — exactly the gap `emit_assign`'s `<<=`/`>>=` rewrite already closed
 * for the UB-prone raw shift (#61). Safe to evaluate the lvalue twice: the assign-statement
 * grammar (`parse_stmt`) admits only two lvalue shapes here — a bare identifier, or (when
 * `a.deref`) a `Ref<T>` handle's `(*name)` dereference — both pure, side-effect-free symbol
 * lookups (the same justification the `<<=`/`>>=` rewrite already relies on).
 *
 * @param buf       the output buffer to append into (already carries the statement's indent)
 * @param prog      the whole checked+lowered program (threaded to `emit_assign_lvalue`)
 * @param a         the typed compound assignment (`op` is `/=` or `%=`)
 * @param escaping  the enclosing function's escaping-name set (threaded to `emit_expr_ctx`)
 * @param regions   the enclosing region-frame stack (threaded to `emit_expr_ctx`)
 * @param fn_body   the enclosing function's own statement list (threaded to `emit_expr_ctx`)
 * @param dctx      the enclosing defer context (threaded to `emit_expr_ctx`)
 * @return          `buf` with the rewritten statement appended, or a propagated error
 * @throws          when the target's declared type is not primitive/numeric, or `%=` targets
 *                  a float (no C float modulo operator)
 */
fn emit_div_mod_assign(buf: []byte, prog: CgProg, a: checker::TAssign, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var prim = match a.bound {
        checker::Prim as p => p
        _ => return error { message = "codegen: division/modulo-assign on a non-primitive type not yet supported" }
    }
    if a.op == lexer::TokenKind::PercentEq && cg_prim_is_float(prim.kind) {
        return error { message = "codegen: modulo-assign on a float type is not allowed" }
    }
    var tag = match prim_div_tag(prim.kind) {
        str as t => t
        error => return error { message = "codegen: division/modulo-assign on a non-numeric type not yet supported" }
    }
    var fn_prefix = if a.op == lexer::TokenKind::SlashEq { "tk_div_" } else { "tk_mod_" }
    var out = match emit_assign_lvalue(buf, prog, a) { []byte as o => o; error as err => return err }
    out = cb(out, " = ")
    out = cb(out, fn_prefix)
    out = cb(out, tag)
    out = cb(out, "(")
    out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ")")
    cb(out, ";\n")
}

// emit_arith — C7.15: the `+`, `-`, `*` path for INTEGER prims.
// Routes through tk_add_*/tk_sub_*/tk_mul_* helpers (teko_rt.h C7.15 block).
// When TEKO_OVERFLOW_DEBUG is set these call tk_panic_overflow() on overflow;
// without it they compile to the plain C operator — zero overhead.
// Float +,-,* fall through to emit_binary's plain-C path (float overflow ≠ panic).
// (C: the `if (bop == TK_TOKEN_PLUS || …)` block inside TK_TEXPR_BINARY.)
fn emit_arith(buf: []byte, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var prim = match e.type {
        checker::Prim as p => p
        _ => return error { message = "codegen: arithmetic on a non-primitive type not yet supported" }
    }
    if !cg_prim_is_int(prim.kind) {
        return error { message = "codegen: emit_arith called on non-integer type" }
    }
    var tag = match prim_int_tag(prim.kind) {
        str as t => t
        error => return error { message = "codegen: arithmetic on a non-integer primitive" }
    }
    var fn_prefix = if b.op == lexer::TokenKind::Plus { "tk_add_" }
    else if b.op == lexer::TokenKind::Minus { "tk_sub_" }
    else { "tk_mul_" }
    var out = cb(buf, fn_prefix)
    out = cb(out, tag)
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")")
}

// emit_shift — #49: the `<<`/`>>` path for INTEGER prims. Routes through tk_shl_*/
// tk_shr_* helpers (teko_rt.h) that mask the shift count by (width - 1) instead of
// leaving an out-of-range count as plain C UB — a DEFINED result. Bitwise/float shift is checker-rejected, so
// a non-integer result type reaching here is an internal invariant break.
// (C: the `if (bop == TK_TOKEN_SHL || bop == TK_TOKEN_SHR)` block inside TK_TEXPR_BINARY.)
fn emit_shift(buf: []byte, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var prim = match e.type {
        checker::Prim as p => p
        _ => return error { message = "codegen: shift on a non-integer type not yet supported" }
    }
    if !cg_prim_is_int(prim.kind) {
        return error { message = "codegen: shift on a non-integer type not yet supported" }
    }
    var tag = match prim_int_tag(prim.kind) {
        str as t => t
        error => return error { message = "codegen: shift on a non-integer type not yet supported" }
    }
    var fn_prefix = if b.op == lexer::TokenKind::Shl { "tk_shl_" } else { "tk_shr_" }
    var out = cb(buf, fn_prefix)
    out = cb(out, tag)
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")")
}

// emit_binary — a TBinary. `/` and `%` go through emit_div_mod; `+`, `-`, `*`
// on integer prims go through emit_arith (C7.15 overflow guards); `<<`, `>>` on
// integer prims go through emit_shift (#49 width-masked count); everything else
// emits plain C `(L op R)`. (C: TK_TEXPR_BINARY branch of emit_expr.)
fn emit_binary(buf: []byte, prog: CgProg, e: checker::TExpr, b: checker::TBinary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if b.op == lexer::TokenKind::Slash || b.op == lexer::TokenKind::Percent {
        return emit_div_mod(buf, prog, e, b, escaping, regions, fn_body, dctx)
    }
    // C7.15 — +,-,* on integer prims: route through overflow-guarded helpers.
    if b.op == lexer::TokenKind::Plus || b.op == lexer::TokenKind::Minus || b.op == lexer::TokenKind::Star {
        var is_int_prim = match e.type {
            checker::Prim as p => cg_prim_is_int(p.kind)
            _ => false
        }
        if is_int_prim { return emit_arith(buf, prog, e, b, escaping, regions, fn_body, dctx) }
    }
    // #49 — <<,>> on integer prims: route through width-masked shift helpers.
    if b.op == lexer::TokenKind::Shl || b.op == lexer::TokenKind::Shr {
        return emit_shift(buf, prog, e, b, escaping, regions, fn_body, dctx)
    }
    var op = match binop_c(b.op) { str as s => s; error as err => return err }
    var out = cb(buf, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.left, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, b.right, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")")
}

/** emit_unary — a TUnary -> `(op X)`. Bitwise NOT (`~`) on an integer prim TRUNCATES back to the
    operand's C type (`(uint8_t)(~x)`): C promotes a sub-int operand to `int` before `~`, so `~(u8)0`
    is `-1` (all 32 bits), not the width-masked `255` the declared type requires — the cast re-narrows to the
    declared width (#265: exposed the first time the u8 `~` test ran natively).
    Other unaries (`-`, `!`) need no mask — their result already fits the operand width. */
fn emit_unary(buf: []byte, prog: CgProg, u: checker::TUnary, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var op = match unop_c(u.op) { str as s => s; error as err => return err }
    var mask_type = cg_bnot_mask_type(u)
    var out = cb(buf, "(")
    match mask_type {
        checker::Prim as p => { out = cb(out, "("); out = match emit_type(out, prog, checker::Prim { kind = p.kind }) { []byte as o => o; error as err => return err }; out = cb(out, ")(") }
        _ => { }
    }
    out = cb(out, op)
    out = match emit_expr_ctx(out, prog, checker::Void { }, u.operand, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    match mask_type { checker::Prim => { out = cb(out, ")") }; _ => { } }
    cb(out, ")")
}

/** cg_bnot_mask_type — the integer-prim type whose width a `~x` result must be truncated to, else
    `Void` (no mask). ONLY the sub-`int` widths (u8/u16/i8/i16) need it: C integer-promotes them to
    `int` before `~`, so the result carries bits above the declared width (`~(u8)0 == -1`). i32/u32
    and wider are already computed at their own width by C, so `~` needs no re-narrowing there. */
fn cg_bnot_mask_type(u: checker::TUnary): @Type() {
    if u.op != lexer::TokenKind::Tilde { return checker::Void { } }
    match u.operand.type {
        checker::Prim as p => if cg_prim_is_subint(p.kind) { checker::Prim { kind = p.kind } } else { checker::Void { } }
        _ => checker::Void { }
    }
}

/** cg_prim_is_subint — a signed/unsigned integer prim NARROWER than C `int` (u8/u16/i8/i16), the
    widths C integer-promotes before a bitwise op, so a `~` result needs an explicit re-narrow. */
fn cg_prim_is_subint(k: checker::PrimKind): bool {
    k == checker::PrimKind::U8 || k == checker::PrimKind::U16 || k == checker::PrimKind::I8 || k == checker::PrimKind::I16
}

/**
 * CgCmpRoute — which lowering an `==`/`!=` comparison TERM takes, chosen by an operand's
 * resolved type (`cg_cmp_route_of`). `Plain` is the raw C operator (a scalar prim or an
 * already-`==`-legal nominal); `StrEq`/`CharEq`/`SliceEq` are the three content-equality
 * detours a `{ptr,len}`-shaped operand needs, because C's own `==` on a struct either refuses to
 * compile (`str`/`[]T`) or silently compares the wrong thing (a `char`'s VIEW address, not its
 * codepoint). A TAGGED-variant/member pairing (`a == null` / `a != 5` over `a: i32 | null`) is
 * NOT one of these routes — it is recognized separately, by `cg_variant_member_cmp`, and takes
 * priority over this dispatch entirely (see `emit_compare`'s doc for why).
 */
pub type CgCmpRoute = enum { Plain; StrEq; CharEq; SliceEq }

/**
 * cg_cmp_route_of — the `CgCmpRoute` a comparison operand's OWN type takes. `str`/`char`/`[]T`
 * are the three `{ptr,len}`-shaped types (B.19/B.8): C's raw `==` either fails to compile on the
 * struct (`str`/`[]T`) or silently compares the VIEW's address instead of its content (`char`),
 * so each routes to its own runtime content-equality call. Every other type (a scalar prim, a
 * `Variant`, or a nominal the checker already proved `==`-comparable) keeps the plain C operator —
 * a `Variant` operand's tagged/member comparison is recognized and dispatched BEFORE this route
 * ever runs (`cg_variant_member_cmp`, checked first in `emit_compare`).
 *
 * @param t  an operand's resolved type
 * @return   the route that operand's type takes
 */
fn cg_cmp_route_of(t: @Type()): CgCmpRoute {
    match t {
        checker::Str => CgCmpRoute::StrEq
        checker::Char => CgCmpRoute::CharEq
        checker::Slice => CgCmpRoute::SliceEq
        _ => CgCmpRoute::Plain
    }
}

/**
 * A recognized TAGGED-variant/member operand pairing in an equality/inequality comparison term.
 * `subj_expr` is the operand whose resolved type is a `Variant` with neither a null NICHE nor a
 * BOX-in-arena representation (REBOOT_PLAN §202/C3/C4 — either of those stores the runtime value
 * as a bare pointer/fat handle with no `.tag` word, so it already compares correctly through the
 * plain `==`/`!=`/`tk_str_eq` fallback and never needs this path). `member` is its comparison
 * partner, already narrowed by the checker (`adopt_binop_operands`/`retype_literal`, C6/C2b) to
 * exactly one of `subj_expr`'s own union members — `null` itself, or a numeric literal's sole
 * fitting member.
 */
type CgVariantMemberCmp = struct {
    /** The operand whose type is the tagged `Variant`. */
    subj_expr: checker::TExpr
    /** The variant's resolved member list (for the tag-constant prefix). */
    variant_type: checker::Variant
    /** The comparison partner, already resolved to one of `variant_type`'s members. */
    member: checker::TExpr
}

/**
 * cg_tagged_variant_side — is `e`'s type a TAGGED `Variant` (REBOOT_PLAN §202/C3/C4)? A niche or
 * box-in-arena union's runtime value has no `.tag` word (the null pattern IS the pointer's own
 * zero, or a fat value's zeroed head field), so only the true tagged `{ uint8_t tag; union {…} as; }`
 * shape needs the `.tag`/`.as.<key>` comparison this module builds.
 *
 * @param prog  the checked program (class/interface/size resolution `cg_union_niche_member` and
 *              `cg_union_box_member` need)
 * @param e     the candidate operand
 * @return      `e.type`'s `Variant` payload when it is tagged, else `null`
 */
fn cg_tagged_variant_side(prog: CgProg, e: checker::TExpr): checker::Variant | null {
    match e.type {
        checker::Variant as v => {
            match cg_union_niche_member(prog, v) { (@Type()) as _gt7 => return null; null => { } }
            match cg_union_box_member(prog, v) { (@Type()) as _gt8 => return null; null => { } }
            v
        }
        _ => null
    }
}

/**
 * cg_variant_member_cmp — recognize an equality/inequality comparison TERM as a tagged-variant-vs-
 * member comparison (`a == null` / `a != 5` over `a: i32 | null`): exactly one of `prev`/`opnd`
 * resolves to a tagged `Variant` (`cg_tagged_variant_side`); the other is its member partner.
 * Neither side being a tagged variant answers `null` — the ordinary `==`/`!=`/`tk_str_eq` fallback
 * already handles a niche/box variant and a plain non-variant pairing alike.
 *
 * @param prog  the checked program
 * @param prev  the comparison term's left-hand (already-adopted) operand
 * @param opnd  the comparison term's right-hand (already-adopted) operand
 * @return      the recognized pairing, or `null` when neither/both sides are a tagged variant
 */
fn cg_variant_member_cmp(prog: CgProg, prev: checker::TExpr, opnd: checker::TExpr): CgVariantMemberCmp | null {
    var opnd_is_variant = match opnd.type { checker::Variant => true; _ => false }
    var prev_is_variant = match prev.type { checker::Variant => true; _ => false }
    if opnd_is_variant && prev_is_variant { return null }
    if !opnd_is_variant {
        match cg_tagged_variant_side(prog, prev) {
            checker::Variant as v => return CgVariantMemberCmp { subj_expr = prev; variant_type = v; member = opnd }
            null => { }
        }
    }
    if !prev_is_variant {
        match cg_tagged_variant_side(prog, opnd) {
            checker::Variant as v => return CgVariantMemberCmp { subj_expr = opnd; variant_type = v; member = prev }
            null => { }
        }
    }
    null
}

/**
 * cg_variant_member_payload_comparable — may `t` (a tagged variant's resolved member) be compared
 * with plain C `==`/`!=` once its `.tag` already matches? True for a numeric `Prim` (never `Bool`,
 * which `cast_kind`/`number_fits_member` already exclude from literal adoption) and `Byte`
 * (`uint8_t`) — the only member kinds a numeric-literal adoption (C2b's `union_sole_numeric_member`)
 * ever produces. Any other member kind (a fat `Str`/`Error`, a by-value `Named` struct, `Slice`,
 * `Char`, …) has NO defined C `==` and is not yet supported here.
 *
 * @param t  the tagged variant's resolved member type (never `Null` — the caller handles that
 *           tag-only case before asking)
 * @return   true iff `t`'s C representation is plain-`==`-comparable
 */
fn cg_variant_member_payload_comparable(t: @Type()): bool {
    match t {
        checker::Prim as p => p.kind != checker::PrimKind::Bool
        checker::Byte => true
        _ => false
    }
}

/**
 * emit_content_eq — emit one `==`/`!=` TERM whose operand type took a non-`Plain` `CgCmpRoute`:
 * dispatch to the runtime call that route's element shape needs.
 *
 * @param buf       the C source buffer to append to
 * @param prog      the typed program (element-type lookups for the `[]T` route)
 * @param route     the non-`Plain` route chosen for this term (`cg_cmp_route_of`)
 * @param op        the comparison operator token (`==`/`!=` only — the caller already filtered)
 * @param lhs       the left operand
 * @param rhs       the right operand
 * @return          the appended buffer
 * @throws          propagated from emitting either operand, or from `emit_slice_eq` when the
 *                  `[]T` element is a shape this codegen does not close (see its own doc)
 */
fn emit_content_eq(buf: []byte, prog: CgProg, route: CgCmpRoute, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match route {
        CgCmpRoute::StrEq => emit_runtime_eq_call(buf, prog, "tk_str_eq", op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::CharEq => emit_runtime_eq_call(buf, prog, "tk_char_eq", op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::SliceEq => emit_slice_eq(buf, prog, op, lhs, rhs, escaping, regions, fn_body, dctx)
        CgCmpRoute::Plain => error { message = "codegen: emit_content_eq called with the Plain route (internal)" }
    }
}

/**
 * emit_runtime_eq_call — `a == b` / `a != b` as a direct call to a fixed-ABI runtime predicate
 * that takes BOTH operands by value (`tk_str_eq`/`tk_char_eq` — a `str`/`char` is passed as an
 * ordinary C struct argument in the C route, no ABI flattening needed; contrast the native
 * route's `lower_str_compare`/`lower_char_compare`, which DO flatten, because that backend's
 * calling convention has no struct-by-value argument).
 *
 * @param buf    the C source buffer to append to
 * @param prog   the typed program
 * @param rtfn   the runtime predicate's C symbol (`tk_str_eq` or `tk_char_eq`)
 * @param op     the comparison operator token (`==`/`!=`)
 * @param lhs    the left operand
 * @param rhs    the right operand
 * @return       the appended buffer
 * @throws       propagated from emitting either operand
 */
fn emit_runtime_eq_call(buf: []byte, prog: CgProg, rtfn: str, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var out = cb(buf, "(")
    if op == lexer::TokenKind::Ne { out = cb(out, "!") }
    out = cb(out, rtfn)
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, lhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ", ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, rhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, "))")
}

/**
 * CgSliceEqPlan — the runtime call `[]T == []T` needs for one element shape: which fixed-ABI
 * predicate to call, and whether that predicate ALSO needs a `sizeof(T)` argument (the
 * POD/`memcmp` route, `tk_slice_eq_bytes`, is generic over element width; the float/char/str
 * routes are each one dedicated, element-width-baked-in predicate).
 */
pub type CgSliceEqPlan = struct {
    /** the runtime predicate's C symbol. */
    rtfn: str
    /** whether the call needs a trailing `sizeof(<elem>)` argument. */
    needs_size: bool
}

/**
 * cg_slice_eq_plan — the `CgSliceEqPlan` for a `[]T`'s element type `elem`, mirroring Go's
 * slice-by-value comparison (owner ruling 2026-07-29, naming Go over Rust's derived
 * `PartialEq` — Teko has no derived traits, and Go compares a slice by value with no ceremony):
 * same length AND every element equal. An integer/`bool`/`byte` element is POD (no interior
 * pointer, no padding in a packed array of it) so `tk_slice_eq_bytes` (`memcmp`) is exact; a
 * float element needs `==` per element (`memcmp` would call `-0.0`/`0.0` distinct and `NaN`
 * self-equal, both wrong); `char`/`str` elements are `{ptr,len}` views whose ADDRESS differs even
 * for equal content, so each gets its own dedicated per-element predicate.
 *
 * EVERY OTHER ELEMENT SHAPE (a nested `[]T`, a `Named` struct/class, `T?`, a variant, a function
 * value, `ptr`/`uptr`/`ref<T>`, `error`) is an HONEST STOP, not a silent wrong answer: this
 * codegen does not (yet) know how to compare it by value, and the checker's own `is_comparable`
 * admits it anyway (it only asks `type_eq`, not "and codegen can lower it") — this is where that
 * gap surfaces, loudly, naming the element type.
 *
 * @param elem  the slice's resolved element type
 * @return      the plan for that element shape
 * @throws      when `elem` is a shape this codegen does not yet close (see above)
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn cg_slice_eq_plan(elem: @Type()): CgSliceEqPlan | error {
    match elem {
        checker::Char => CgSliceEqPlan { rtfn = "tk_slice_char_eq"; needs_size = false }
        checker::Str => CgSliceEqPlan { rtfn = "tk_slice_str_eq"; needs_size = false }
        checker::Byte => CgSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
        checker::Prim as p => cg_slice_eq_plan_prim(p.kind)
        _ => error { message = teko::str::concat("codegen: `[]T == []T` is not lowered yet for element type `", checker::type_render(elem), "` (only numeric/bool/byte/char/str elements compare by value)") }
    }
}

/**
 * cg_slice_eq_plan_prim — the `CgSliceEqPlan` for a `Prim`-typed element: the float kinds get
 * their own per-element-`==` predicate, every integer/bool kind shares the generic `memcmp` route.
 *
 * @param k  the element's `PrimKind`
 * @return   the plan for that kind
 */
fn cg_slice_eq_plan_prim(k: checker::PrimKind): CgSliceEqPlan {
    if k == checker::PrimKind::F32 { return CgSliceEqPlan { rtfn = "tk_slice_f32_eq"; needs_size = false } }
    if k == checker::PrimKind::F64 { return CgSliceEqPlan { rtfn = "tk_slice_f64_eq"; needs_size = false } }
    CgSliceEqPlan { rtfn = "tk_slice_eq_bytes"; needs_size = true }
}

/**
 * cg_slice_elem_of — the element type of a `[]T` operand about to take the `SliceEq` route.
 * Reached ONLY after `cg_cmp_route_of` already matched `checker::Slice` on this same operand, so
 * the fallback arm below is unreachable in practice; it is still written total (Teko `match`
 * requires exhaustiveness) rather than assumed.
 *
 * @param t  the operand's resolved type (a `Slice` by the caller's own precondition)
 * @return   `t`'s element type, or `Void` when `t` is not in fact a `Slice` (unreachable given
 *           the precondition)
 */
fn cg_slice_elem_of(t: @Type()): @Type() {
    match t { checker::Slice as sl => sl.element; _ => checker::Void { } }
}

/**
 * emit_slice_eq — `a == b` / `a != b` over two `[]T` operands: bind both to locals (single-eval —
 * each is otherwise emitted twice, once for the runtime call's `.ptr` and once for its `.len`),
 * then call the runtime predicate `cg_slice_eq_plan` chose for `T`, passing the trailing
 * `sizeof(T)` argument iff that plan needs it.
 *
 * @param buf       the C source buffer to append to
 * @param prog      the typed program (element-type lookups, C type names)
 * @param op        the comparison operator token (`==`/`!=`)
 * @param lhs       the left `[]T` operand
 * @param rhs       the right `[]T` operand
 * @return          the appended buffer
 * @throws          propagated from `cg_slice_eq_plan` (an unclosed element shape) or from
 *                  emitting either operand
 * @since 0.3.1.0 (igualdade-char-slice)
 */
fn emit_slice_eq(buf: []byte, prog: CgProg, op: lexer::TokenKind, lhs: checker::TExpr, rhs: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var elem = cg_slice_elem_of(lhs.type)
    var plan = match cg_slice_eq_plan(elem) { CgSliceEqPlan as p => p; error as err => return err }
    var t = $"_teq{buf.len}"
    var out = cb(buf, "(")
    if op == lexer::TokenKind::Ne { out = cb(out, "!") }
    out = cb(out, "({ ")
    out = match emit_type(out, prog, lhs.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, t)
    out = cb(out, "a = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, lhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; ")
    out = match emit_type(out, prog, rhs.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, t)
    out = cb(out, "b = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, rhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; ")
    out = cb(out, plan.rtfn)
    out = cb(out, "(")
    out = cb(out, t)
    out = cb(out, "a.ptr, ")
    out = cb(out, t)
    out = cb(out, "a.len, ")
    out = cb(out, t)
    out = cb(out, "b.ptr, ")
    out = cb(out, t)
    out = cb(out, "b.len")
    if plan.needs_size {
        out = cb(out, ", sizeof(")
        out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
        out = cb(out, ")")
    }
    out = cb(out, "); })")
    cb(out, ")")
}

/**
 * cg_emit_variant_member_cmp — emit the boolean test for a recognized tagged-variant/member
 * equality (`==`) or inequality (`!=`) comparison: single-evaluates the variant side into a fresh
 * temp (a GNU statement-expression, mirroring `emit_coalesce`/`emit_safe_field_access`'s single-eval
 * shape), then tests its `.tag` against the member's tag constant — and, when the member is a
 * payload-comparable non-`null` member (`cg_variant_member_payload_comparable`), additionally
 * compares the `.as.<key>` payload once the tag already matches (`null` carries no payload, so a
 * `null` member stops at the tag test).
 *
 * @param buf       the emit buffer
 * @param prog      the checked program (tag/member-key mangling)
 * @param cmp       the recognized variant/member pairing
 * @param eq        true for `==`, false for `!=`
 * @param escaping  the region-escape set threaded to the variant/member emitters
 * @param regions   the active region stack
 * @param fn_body   the enclosing function's statements (defer resolution)
 * @param dctx      the defer-lowering context
 * @return          `buf` with the boolean test appended, or an error
 * @throws          when the variant's C type or a member's key cannot be emitted, or the non-`null`
 *                  member has no defined payload comparison (`cg_variant_member_payload_comparable`)
 */
fn cg_emit_variant_member_cmp(buf: []byte, prog: CgProg, cmp: CgVariantMemberCmp, eq: bool, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var is_null_member = match cmp.member.type { checker::Null => true; _ => false }
    if !is_null_member && !cg_variant_member_payload_comparable(cmp.member.type) {
        return error { message = "codegen: comparing a tagged union to a non-null, non-numeric member is not yet supported" }
    }
    var tmp = fresh_named("_vm", buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, cmp.subj_expr.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, cmp.subj_expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); (")
    out = cb(out, tmp)
    out = cb(out, ".tag ")
    out = cb(out, if eq { "== " } else { "!= " })
    out = match cg_emit_tag_prefix(out, checker::Variant { members = cmp.variant_type.members }) { []byte as o => o; error as err => return err }
    var mk = match cg_member_key_str(cmp.member.type) { str as s => s; error as err => return err }
    out = cb_upper(out, mk)
    if is_null_member { return cb(out, "); })") }
    out = cb(out, if eq { " && " } else { " || " })
    out = cb(out, tmp)
    out = cb(out, ".as.")
    out = match cg_member_key(out, cmp.member.type) { []byte as o => o; error as err => return err }
    out = cb(out, if eq { " == (" } else { " != (" })
    out = match emit_expr_ctx(out, prog, checker::Void { }, cmp.member, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")); })")
}

/**
 * emit_compare — a `TCompare` -> chained `a<b<c` => `((a<b) && (b<c))` over ADJACENT operands. A
 * lone subject (no `rest`) is degenerate: emit it bare. An `==`/`!=` term is checked in TWO stages,
 * in order: first, is one side a TAGGED variant and the other its own retyped member
 * (`cg_variant_member_cmp`) — `a == null` / `a != 5` over `a: i32 | null` — which detours through
 * `cg_emit_variant_member_cmp`'s `.tag`(+`.as.<key>`) test; only once that answers `null` does the
 * term fall to the ordinary route dispatch, where an operand type of `str`/`char`/`[]T`
 * (`cg_cmp_route_of`) detours through `emit_content_eq` instead of the raw C operator — see each
 * function's own doc for why (C: `TK_TEXPR_COMPARE`).
 *
 * @param buf       the C source buffer to append to
 * @param prog      the typed program
 * @param c         the comparison node (its `first` operand plus the ADJACENT-term chain)
 * @param escaping  the enclosing escape set (threaded through to operand emission)
 * @param regions   the enclosing region-frame stack (threaded through to operand emission)
 * @param fn_body   the enclosing function's body (threaded through to operand emission)
 * @param dctx      the enclosing defer context (threaded through to operand emission)
 * @return          the appended buffer
 * @throws          propagated from emitting an operand, from `cmpop_c` on an unmapped operator,
 *                  from `cg_emit_variant_member_cmp` on an unsupported member payload, or from
 *                  `emit_content_eq`/`emit_slice_eq` on an unclosed element shape
 */
fn emit_compare(buf: []byte, prog: CgProg, c: checker::TCompare, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if c.rest.len == 0 { return emit_expr_ctx(buf, prog, checker::Void { }, c.first, escaping, regions, fn_body, dctx) }
    var out = cb(buf, "(")
    var prev = c.first
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var term = c.rest[i]
        var op = match cmpop_c(term.op) { str as s => s; error as err => return err }
        if i > 0 { out = cb(out, " && ") }
        out = match emit_compare_term(out, prog, prev, term, op, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        prev = term.operand
        i++
    }
    cb(out, ")")
}

/**
 * emit_compare_term — `emit_compare`'s per-ADJACENT-TERM dispatch, pulled out to keep that loop
 * flat. Checked in TWO stages, in order: first, is this an `==`/`!=` term where one side is a
 * TAGGED variant and the other its own retyped member (`cg_variant_member_cmp`) — `a == null` /
 * `a != 5` over `a: i32 | null` — which routes to `cg_emit_variant_member_cmp`'s `.tag`(+`.as.<key>`)
 * test; only once that answers `null` does the term fall to the ordinary `CgCmpRoute` dispatch
 * (`cg_cmp_route_of`), which detours a `str`/`char`/`[]T` operand through `emit_content_eq` instead
 * of the raw C operator (see each function's own doc for why).
 *
 * @param buf       the C source buffer to append to
 * @param prog      the typed program
 * @param prev      the term's left-hand (already-adopted) operand
 * @param term      the comparison term (operator + right-hand operand)
 * @param op        `term.op` already mapped to its C operator text (`cmpop_c`)
 * @param escaping  the enclosing escape set (threaded through to operand emission)
 * @param regions   the enclosing region-frame stack (threaded through to operand emission)
 * @param fn_body   the enclosing function's body (threaded through to operand emission)
 * @param dctx      the enclosing defer context (threaded through to operand emission)
 * @return          the appended buffer
 * @throws          propagated from `cg_emit_variant_member_cmp`, from `emit_content_eq` on an
 *                  unclosed `[]T` element shape, or from emitting either operand
 */
fn emit_compare_term(buf: []byte, prog: CgProg, prev: checker::TExpr, term: checker::TCmpTerm, op: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var is_eq = term.op == lexer::TokenKind::EqEq || term.op == lexer::TokenKind::Ne
    var vm_cmp = if is_eq { cg_variant_member_cmp(prog, prev, term.operand) } else { null }
    match vm_cmp {
        CgVariantMemberCmp as cmp => return cg_emit_variant_member_cmp(buf, prog, cmp, term.op == lexer::TokenKind::EqEq, escaping, regions, fn_body, dctx)
        null => { }
    }
    var prev_route = cg_cmp_route_of(prev.type)
    var opnd_route = cg_cmp_route_of(term.operand.type)
    var route = if prev_route != CgCmpRoute::Plain { prev_route } else { opnd_route }
    if route != CgCmpRoute::Plain && is_eq {
        return emit_content_eq(buf, prog, route, term.op, prev, term.operand, escaping, regions, fn_body, dctx)
    }
    var out = cb(buf, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, prev, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, term.operand, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ")")
}

/**
 * cg_cast_target_is_variant — does a cast node's target type `t` name a variant (an inline `A | B` or a
 * declared variant)? A cast whose target is a variant is never a user `x to T` — the checker restricts
 * `to` to numeric/char/bool — so it can only be the synthetic widening node the const inliner
 * (`widen_inlined_const`, #630) wraps a variant const's case-member initializer in, and emit_cast routes
 * it through emit_as to wrap the member into the variant's tag+union representation.
 *
 * @param prog  the typed program, to resolve a declared Named target to its variant decl
 * @param t     the cast's target type (the cast node's resolved `.type`)
 * @return      true iff `t` is an inline or declared variant
 * @since #630
 */
fn cg_cast_target_is_variant(prog: CgProg, t: @Type()): bool {
    match t {
        checker::Variant => true
        checker::Named as nm => cg_named_is_variant(prog, nm.name)
        _ => false
    }
}

/**
 * emit_cast — a `TCast`. F3 (M.1): a narrowing `x to T` is range-checked at runtime via
 * `tk_to_<dst>_<carrier>` and PANICS if the value does not fit `T`. Widening / same-type casts
 * where no loss is possible emit the plain C cast (no needless guard). Single-eval: the operand is
 * emitted once. Four routes, in order: a variant target defers to `emit_as`; a `char` source
 * decodes through `tk_char_to_u32`; float->int is ALWAYS guarded (`tk_to_<dst>_from_<fsrc>`);
 * int->int is guarded IFF `cast_may_lose`. Both guarded routes carry the (C1.7-CAST) positioned
 * wrapper — a GNU statement-expression setting `_tk_cast_loc_line`/`_tk_cast_loc_col` so
 * `tk_panic_cast` can print the source position — whenever the node has one.
 *
 * The int->int carrier is picked by SOURCE signedness so it holds the source losslessly: signed ->
 * `int64_t` ("_s"), unsigned -> `uint64_t` ("_u"). Sixty-four bits suffice because that IS the
 * language's widest integer (128-bit primitives, integer and float, are gone — owner ruling
 * 2026-07-30; wider arithmetic is `teko::numeric::bigint`/`dec`).
 *
 * @param buf       the C output buffer to grow
 * @param prog      the typed program (target-type and variant resolution)
 * @param e         the cast expression node (its `.type` is the target; its line/col drive the
 *                  positioned wrapper)
 * @param c         the cast payload (its `expr` is the operand)
 * @param escaping  the names whose values escape the current frame
 * @param regions   the active region frames
 * @param fn_body   the enclosing function's statements
 * @param dctx      the pending-defer context
 * @return          `buf` followed by the cast's C expression
 * @throws          when the target is not an emittable cast destination (a non-integer guard
 *                  target, a non-float source tag) or the operand fails to emit
 */
fn emit_cast(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCast, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var inner = c.expr
    if cg_cast_target_is_variant(prog, e.type) { return emit_as(buf, prog, e.type, inner, escaping, regions, fn_body, dctx) }
    // Extract source/dest prims when both sides are primitive (else: a plain C cast).
    var dst_opt = match e.type { checker::Prim as p => p.kind; _ => checker::PrimKind::Bool }
    var src_opt = match inner.type { checker::Prim as p => p.kind; _ => checker::PrimKind::Bool }
    var prim_both = match e.type {
        checker::Prim => match inner.type { checker::Prim => true; _ => false }
        _ => false
    }
    var dst = dst_opt
    var src = src_opt

    // (UTF-8 increment 1) `char to u32`/u64/i64 — DECODE the codepoint via the runtime
    // tk_char_to_u32, then a plain C cast to the (possibly wider/signed) target. The checker
    // already restricted the target; the decoded value always fits. (C: emit_expr CAST char branch.)
    match inner.type {
        checker::Char => {
            var out = cb(buf, "((")
            out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }   // target rides the node's .type
            out = cb(out, ")tk_char_to_u32(")
            out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            return cb(out, "))")
        }
        _ => { }
    }

    // float -> int: ALWAYS guarded (ruling §5: truncate toward zero; panic on
    // NaN/inf/out-of-range). Helper: tk_to_<dst>_from_<fsrc>. Single-eval.
    // (C1.7-CAST) When the cast node carries a position, wrap in a GNU statement-expression
    // that sets _tk_cast_loc_line/_tk_cast_loc_col before the call so tk_panic_cast prints it.
    if prim_both && cg_prim_is_float(src) && cg_prim_is_int(dst) {
        var dtag = match prim_int_tag(dst) { str as t => t; error as err => return err }
        var fsrc = match prim_float_tag(src) { str as t => t; error as err => return err }
        if e.line != 0 {
            var out = cb(buf, "({ _tk_cast_loc_line = ")
            out = cb(out, teko::u64_to_str(e.line to u64))
            out = cb(out, "; _tk_cast_loc_col = ")
            out = cb(out, teko::u64_to_str(e.col to u64))
            out = cb(out, "; tk_to_")
            out = cb(out, dtag)
            out = cb(out, "_from_")
            out = cb(out, fsrc)
            out = cb(out, "(")
            out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            return cb(out, "); })")
        }
        var out = cb(buf, "tk_to_")
        out = cb(out, dtag)
        out = cb(out, "_from_")
        out = cb(out, fsrc)
        out = cb(out, "(")
        out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(out, ")")
    }
    if prim_both && cg_prim_is_int(src) && cg_prim_is_int(dst) && cast_may_lose(src, dst) {
        var dtag = match prim_int_tag(dst) { str as t => t; error as err => return err }
        if e.line != 0 {
            var out = cb(buf, "({ _tk_cast_loc_line = ")
            out = cb(out, teko::u64_to_str(e.line to u64))
            out = cb(out, "; _tk_cast_loc_col = ")
            out = cb(out, teko::u64_to_str(e.col to u64))
            out = cb(out, "; tk_to_")
            out = cb(out, dtag)
            if cg_prim_is_signed_int(src) { out = cb(out, "_s(") } else { out = cb(out, "_u(") }
            out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            return cb(out, "); })")
        }
        var out = cb(buf, "tk_to_")
        out = cb(out, dtag)
        if cg_prim_is_signed_int(src) { out = cb(out, "_s(") } else { out = cb(out, "_u(") }
        out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(out, ")")
    }
    // Everything else (int->float widen, float->float narrow, widening int->int,
    // same-type) is a lossless-or-precision-allowed plain C cast.
    var out = cb(buf, "((")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }   // target rides the node's .type
    out = cb(out, ")(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, inner, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, "))")
}

// emit_list_empty — `teko::list::empty()`. If the call's OWN type is a concrete slice, emit the
// empty literal `(tk_slice_<elem>){ .ptr = 0, .len = 0 }`; else an honest error (it should have
// been wrapped to a slot type by emit_as). (C: the `empty` arm of the teko::list branch.)
fn emit_list_empty(buf: []byte, e: checker::TExpr): []byte | error {
    match e.type {
        checker::Slice as sl => match sl.element {
            checker::Void => error { message = "codegen: teko::list::empty() needs a known slice type from context (annotate the binding)" }
            _ => {
                var o = cb(buf, "(")
                o = match cg_slice_typename(o, sl.element) { []byte as r => r; error as err => return err }
                cb(o, "){ .ptr = 0, .len = 0 }")
            }
        }
        _ => error { message = "codegen: teko::list::empty() needs a known slice type from context (annotate the binding)" }
    }
}

// get_push_elem — resolve the concrete element type of a push call, handling the
// case where type_assign overwrote the call's `.type` to the sentinel. Tries e.type
// first; falls back to args[0] (concretized base slice), then args[1] (item). (C: inline.)
fn get_push_elem(e: checker::TExpr, c: checker::TCall): @Type() | error {
    match e.type {
        checker::Slice as sl => {
            match sl.element { checker::Void => { }; _ => return sl.element }
        }
        _ => return error { message = "codegen: teko::list::push result is not a slice (internal)" }
    }
    if c.args.len != 2 { return error { message = "codegen: teko::list::push result is not a concrete slice (internal)" } }
    match c.args[0].type {
        checker::Slice as base_sl => match base_sl.element { checker::Void => { }; _ => return base_sl.element }
        _ => { }
    }
    var it = c.args[1].type
    match it {
        checker::Slice as is_sl => match is_sl.element { checker::Void => return error { message = "codegen: teko::list::push result is not a concrete slice (internal)" }; _ => { } }
        _ => { }
    }
    it
}

// emit_list_push — `teko::list::push(base, item)`. The push result type (the node's `.type`) is
// `[]elem`. type_assign may overwrite the call's type to the sentinel when assigning push(xs,i)
// back to a sentinel-typed xs; get_push_elem recovers the element. Lower to an inline
// copy-append GNU stmt-expr. (C: the `push` arm.)
fn emit_list_push(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, frame: str): []byte | error {
    var elem = match get_push_elem(e, c) { (@Type()) as t => t; error as err => return err }
    var bN = $"_sb{buf.len}"
    var iN = $"_si{buf.len + 1}"
    var pN = $"_sp{buf.len + 2}"
    var lN = $"_sl{buf.len + 3}"
    // `teko::list::push(base, item)` → the AMORTIZED runtime grow (tk_slice_push): geometric growth
    // with an alias-safe live-tail cache so a linear `b = push(b, x)` chain is O(1) amortized (value
    // semantics preserved). Replaces the old malloc+copy-every-push (O(n) per push → O(n²) on a buffer).
    var out = cb(buf, "({ ")
    out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " "); out = cb(out, bN); out = cb(out, " = ")
    // Use emit_as so a sentinel empty() base-arg is lowered to the concrete empty literal.
    out = match emit_as(out, prog, checker::Slice { element = elem }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; ")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " "); out = cb(out, iN); out = cb(out, " = ")
    out = match emit_as(out, prog, elem, c.args[1], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; uint64_t "); out = cb(out, lN); out = cb(out, "; ")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " *"); out = cb(out, pN); out = cb(out, " = (")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    // (S2 Level-1/-2) the routing selector rides `frame`: "" → root tk_slice_push; "@fo" → the
    // free-old-on-grow tk_slice_push_fo (a checker-PROVEN linear chain — #148 Level-2); anything
    // else → tk_slice_push_r growing into that frame region variable.
    var is_fo = frame == "@fo"
    out = cb(out, if is_fo { " *)tk_slice_push_fo(" } else if frame.len > 0 { " *)tk_slice_push_r(" } else { " *)tk_slice_push(" }); out = cb(out, bN); out = cb(out, ".ptr, "); out = cb(out, bN); out = cb(out, ".len, &"); out = cb(out, iN)
    out = cb(out, ", sizeof(")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, "), &"); out = cb(out, lN); if frame.len > 0 && !is_fo { out = cb(out, ", "); out = cb(out, frame) }; out = cb(out, "); (")
    out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
    out = cb(out, "){ .ptr = "); out = cb(out, pN); out = cb(out, ", .len = "); out = cb(out, lN); out = cb(out, " }; })")
    out
}

/**
 * emit_list_with_cap — `teko::list::with_cap(n)` (enabling primitive — staged off; no compiler
 * source calls this yet). Requires the call's OWN `.type` to already be a concrete slice: like
 * `emit_list_empty`, an un-annotated sentinel reaching here is an honest codegen error rather than
 * a guess. Lowers to a GNU statement-expression that allocates a len-0, `n`-capacity buffer via
 * `tk_slice_with_cap`/`tk_slice_with_cap_r` (routed by `frame`, mirroring `emit_list_push`'s root-
 * vs-frame selector) and wraps the fresh pointer in the slice struct literal.
 *
 * @param buf       the output buffer to append to
 * @param prog      the typed program (for emit_type)
 * @param e         the call's own typed expr (carries the concretized slice type)
 * @param c         the call node (`c.args[0]` is the `u64` capacity)
 * @param escaping  the escaping-binding set threaded through nested expr emission
 * @param regions   the open S1 region stack
 * @param fn_body   the enclosing function's statements (for nested expr emission)
 * @param dctx      the defer context threaded through nested expr emission
 * @param frame     `""` for the root region; else a frame region variable name
 * @return          the emitted C, or `error` on a context-less sentinel / malformed call
 */
fn emit_list_with_cap(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, frame: str): []byte | error {
    var elem = match e.type {
        checker::Slice as sl => match sl.element {
            checker::Void => return error { message = "codegen: teko::list::with_cap() needs a known slice type from context (annotate the binding)" }
            _ => sl.element
        }
        _ => return error { message = "codegen: teko::list::with_cap() needs a known slice type from context (annotate the binding)" }
    }
    if c.args.len != 1 { return error { message = "codegen: teko::list::with_cap result has the wrong arity (internal)" } }
    var is_r = frame.len > 0
    var wN = $"_wp{buf.len}"
    var capN = $"_wc{buf.len}"
    var out = cb(buf, "({ uint64_t ")
    out = cb(out, capN); out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); ")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " *"); out = cb(out, wN); out = cb(out, " = (")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, if is_r { " *)tk_slice_with_cap_r(sizeof(" } else { " *)tk_slice_with_cap(sizeof(" })
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, "), "); out = cb(out, capN)
    if is_r { out = cb(out, ", "); out = cb(out, frame) }
    out = cb(out, "); (")
    out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
    out = cb(out, "){ .ptr = "); out = cb(out, wN); out = cb(out, ", .len = 0")
    if cg_slice_rep_has_cap(elem) { out = cb(out, ", .cap = "); out = cb(out, capN) }
    out = cb(out, " }; })")
    out
}

/**
 * emit_list_grow_inplace — `teko::list::grow_inplace(ref x, v)` (F3.3, the ref-push win path). Emits
 * the in-place append primitive `tk_slice_grow_inplace(<header ptr>, &<item>, sizeof(<elem>),
 * tk_region_current())`. The first argument is the exclusive `ref []T` — a `Reference` value that
 * lowers to the slice header pointer `tk_slice_<elem> *`, so emitting it bare yields the address
 * `tk_slice_grow_inplace` mutates. The item is spilled to a temporary whose address is taken, exactly
 * as `emit_list_push` spills its item. Yields a `void` GNU statement-expression: the whole append is
 * a header mutation with NO push cache and NO defensive copy (the cap lives in the header).
 *
 * @param buf       the output buffer to append to
 * @param prog      the typed program (for emit_type)
 * @param c         the call node (`c.args[0]` the `ref []T`, `c.args[1]` the item)
 * @param escaping  the escaping-binding set threaded through nested expr emission
 * @param regions   the open S1 region stack
 * @param fn_body   the enclosing function's statements (for nested expr emission)
 * @param dctx      the defer context threaded through nested expr emission
 * @return          the emitted C, or `error` on a malformed call / non-reference receiver
 */
fn emit_list_grow_inplace(buf: []byte, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if c.args.len != 2 { return error { message = "codegen: teko::list::grow_inplace has the wrong arity (internal)" } }
    var elem = match c.args[0].type {
        checker::Reference as r => match r.inner { checker::Slice as sl => sl.element; _ => return error { message = "codegen: teko::list::grow_inplace receiver is not a `ref []T` (internal)" } }
        _ => return error { message = "codegen: teko::list::grow_inplace receiver is not a reference (internal)" }
    }
    var iN = $"_gi{buf.len}"
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " "); out = cb(out, iN); out = cb(out, " = ")
    out = match emit_as(out, prog, elem, c.args[1], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; tk_slice_grow_inplace((void *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "), &"); out = cb(out, iN); out = cb(out, ", sizeof(")
    out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
    out = cb(out, "), tk_region_current()); })")
    out
}

/**
 * C7.19 (#169 D0) — `teko::mem::buf_ptr(len)` lowers to a direct arena bump-allocation:
 * `(uint8_t *)tk_region_alloc(<enclosing region>, (size_t)(len))`. Reuses whichever S1 region is
 * open at the call site (a block region, else the function frame, else the process root — the
 * same rule `emit_struct_init_framed` uses for a frame-local box), so the returned `ptr<byte>`'s
 * storage is bulk-freed exactly when that region drops. No runtime forwarder is needed: the arena
 * primitive is already a plain two-argument C call, so this is inlined rather than routed through
 * `emit_host_ffi` (which exists for FIXED-ABI struct-returning FFI bottoms, not this).
 */
fn emit_buf_ptr(buf: []byte, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var out = cb(buf, "(uint8_t *)tk_region_alloc(")
    out = cb(out, cg_enclosing_region_expr(regions))
    out = cb(out, ", (size_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, "))")
}


/**
 * emit_ptr_unwrap_seam — the §5 Part A backend seam for `__unwrap`'s tag/gen registration. Part A
 * emits NOTHING (returns `buf` unchanged): the reinterpret trusts the address by vacuity. Doc 1
 * (Part B) replaces this body with `tk_ptr_track(<addr_c>, <tag_c>);` — the ONLY edit `__unwrap`'s
 * backend needs to light up the side-table. The seam signature is FINAL so Doc 1 changes one body,
 * not a signature; `tag_c` is passed already (empty placeholder in Part A) so it cannot shift later.
 *
 * @param buf     the output byte buffer
 * @param addr_c  the C expression naming the unwrapped address (the `void *` temp)
 * @param tag_c   the comp-time tag materialization of `T` (empty in Part A, ignored)
 * @return        `buf` unchanged (Part A: empty seam)
 * @since 0.3.1 (§5 Part A)
 */
fn emit_ptr_unwrap_seam(buf: []byte, addr_c: str, tag_c: str): []byte {
    buf
}

/**
 * emit_ptr_wrap_guard — the §5 Part A backend seam for `__wrap`'s liveness/tag guard. Part A emits
 * the literal `1` (constant-true), so the `T`-arm is always taken and the `error`-arm — emitted and
 * compiled — is DEAD. Doc 1 (Part B) replaces this body with `tk_ptr_check(<addr_c>, <tag_c>)`, at
 * which point the `error`-arm becomes reachable (a dead arena or a divergent tag yields `error`).
 * The seam signature is FINAL; `tag_c` rides already (empty placeholder in Part A) so Doc 1 changes
 * one body, not a signature.
 *
 * @param buf     the output byte buffer
 * @param addr_c  the C expression naming the wrapped address (the `void *` temp)
 * @param tag_c   the comp-time tag materialization of `T` (empty in Part A, ignored)
 * @return        `buf` with the constant-true guard `1` appended (Part A)
 * @since 0.3.1 (§5 Part A)
 */
fn emit_ptr_wrap_guard(buf: []byte, addr_c: str, tag_c: str): []byte {
    cb(buf, "1")
}

/**
 * emit_ptr_unwrap — lower `ptr::__unwrap<T>(x)` / `uptr::__unwrap<T>(x)` (§5 Part A): the infallible
 * reinterpret that takes the ADDRESS of the addressable argument and yields the opaque word. Emits a
 * GNU statement-expression `({ void *__a = (void *)(&(<x>)); <seam> (<opaque-C-type>)__a; })` — the
 * seam (`emit_ptr_unwrap_seam`) is empty in Part A. The yield casts the `void *` to the result's C
 * representation (`void *` for `ptr`, `uintptr_t` for `uptr`).
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param e         the `__unwrap` call TExpr (its `.type` is `ptr`/`uptr`)
 * @param c         the typed call (args[0] = the addressable value; type_args[0] = `T`)
 * @param escaping  the escaping-binding set
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body (defer context)
 * @param dctx      the defer context
 * @return          `buf` with the reinterpret stmt-expr appended, or a codegen error
 * @throws          when the call's arity is not 1 (internal — the checker guarantees it)
 * @since 0.3.1 (§5 Part A)
 */
fn emit_ptr_unwrap(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if c.args.len != 1 { return error { message = "codegen: ptr::__unwrap expects one argument (internal)" } }
    var a = fresh_named("_pu", buf.len to i64)
    var out = cb(buf, "({ void *")
    out = cb(out, a)
    out = cb(out, " = (void *)(&(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ")); ")
    out = emit_ptr_unwrap_seam(out, a, "")
    out = cb(out, "(")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb(out, a)
    cb(out, "; })")
}

/**
 * emit_ptr_wrap — lower `p.__wrap<T>()` (§5 Part A): the fallible recovery of the value behind the
 * opaque word into the union `T | error | null`. Emits a GNU statement-expression whose three arms
 * are built in the union's C representation via `emit_variant_wrap_str`:
 *   `({ void *__a = (void *)(<p>);
 *       __a == 0 ? <null-arm> : ( <guard> ? <*(T*)__a> : <error-arm> ); })`
 * The `null`-arm (address 0) is LIVE. The guard seam (`emit_ptr_wrap_guard`) is the literal `1` in
 * Part A, so the `error`-arm — emitted and compiled — is DEAD until Doc 1 lights the seam.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param e         the `__wrap` call TExpr (its `.type` is the `T | error | null` union)
 * @param c         the typed call (args[0] = the receiver; type_args[0] = `T`)
 * @param escaping  the escaping-binding set
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body (defer context)
 * @param dctx      the defer context
 * @return          `buf` with the wrap stmt-expr appended, or a codegen error
 * @throws          when the call's arity/type-arg count is not 1 (internal — the checker guarantees it)
 * @since 0.3.1 (§5 Part A)
 */
fn emit_ptr_wrap(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if c.args.len != 1 { return error { message = "codegen: __wrap expects one (receiver) argument (internal)" } }
    if c.type_args.len != 1 { return error { message = "codegen: __wrap expects one type argument (internal)" } }
    var ttype = c.type_args[0]
    var addr = fresh_named("_pw", buf.len to i64)
    var out = cb(buf, "({ void *")
    out = cb(out, addr)
    out = cb(out, " = (void *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); ")
    out = cb(out, addr)
    out = cb(out, " == 0 ? ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Null { }, "0") { []byte as o => o; error as err => return err }
    out = cb(out, " : (")
    out = emit_ptr_wrap_guard(out, addr, "")
    out = cb(out, " ? ")
    var tcbuf = match emit_type(teko::list::empty(), prog, ttype) { []byte as o => o; error as err => return err }
    var tc = str(tcbuf)
    var tarm = $"*({tc} *){addr}"
    out = match emit_variant_wrap_str(out, prog, e.type, ttype, tarm) { []byte as o => o; error as err => return err }
    out = cb(out, " : ")
    out = match emit_variant_wrap_str(out, prog, e.type, checker::Error { }, "(tk_error){0}") { []byte as o => o; error as err => return err }
    cb(out, "); })")
}

/**
 * `teko::mem::as_cstr(s: str) -> ptr<byte>` (c-types-and-marshalling-0.3.1.md §7.3/§9.5, crumb
 * C3+C7) — a fresh NUL-terminated copy of `s`'s bytes, bump-allocated into the ENCLOSING region
 * (mirroring `emit_buf_ptr`'s allocation site, not `malloc`): the octets are copied byte-by-byte
 * (no C standard-library string routine is pulled into the generated program's includes) and the
 * final octet, one past `s.len`, is written `0`. Bulk-freed with the enclosing region, so — unlike
 * the runtime's OLD `tk_cstr_dup` — no call site of this builtin can outlive its own frame without
 * the developer choosing a longer-lived region explicitly (the `c_string_in_arena` tier).
 *
 * @param []byte buf  the output buffer
 * @param CgProg prog  the typed program (for arg emission)
 * @param checker::TCall c  the typed call (args[0] = the `str` to copy)
 * @param []str escaping  the escape-analysis frame set
 * @param []RegionFrame regions  the open region-frame stack
 * @param []checker::TStatement fn_body  the enclosing function body (defer context)
 * @param DeferCtx dctx  the defer context
 * @return []byte | error  the buffer with the copy-and-terminate stmt-expr appended, or a codegen error
 */
fn emit_as_cstr(buf: []byte, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var v = $"_ac{buf.len}"
    var out = cb(buf, $"({{ tk_str {v}_s = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    var region = cg_enclosing_region_expr(regions)
    cb(out, $"); uint8_t *{v} = (uint8_t *)tk_region_alloc({region}, (size_t)({v}_s.len + 1)); for (uint64_t {v}_i = 0; {v}_i < {v}_s.len; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} {v}[{v}_s.len] = 0; {v}; }})")
}

/**
 * `teko::mem::str_from_c(p: ptr<byte>, max: u64) -> str` (c-types-and-marshalling-0.3.1.md §6,
 * crumb C2) — the BOUNDED inbound C-string scan: reads AT MOST `max` octets from `p`, stopping at
 * the first `0`, and copies the result into a fresh Teko `str`. TOTAL on every input (`p` null or
 * `max == 0` both short-circuit to the empty `str` with no read at all; no `0` in `[0, max)` yields
 * exactly `max` octets — truncation, not a panic). Inlined as a GNU statement-expression, exactly
 * like `emit_buf_ptr`: no runtime forwarder exists for this shape.
 *
 * @param []byte buf  the output buffer
 * @param CgProg prog  the typed program (for arg emission)
 * @param checker::TCall c  the typed call (args[0] = `p`, args[1] = `max`)
 * @param []str escaping  the escape-analysis frame set
 * @param []RegionFrame regions  the open region-frame stack
 * @param []checker::TStatement fn_body  the enclosing function body (defer context)
 * @param DeferCtx dctx  the defer context
 * @return []byte | error  the buffer with the bounded-scan stmt-expr appended, or a codegen error
 */
fn emit_str_from_c(buf: []byte, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var v = $"_sfc{buf.len}"
    var out = cb(buf, $"({{ const uint8_t *{v}_p = (const uint8_t *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, $"); uint64_t {v}_max = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, $"); uint64_t {v}_n = 0; if ({v}_p != NULL) {{ while ({v}_n < {v}_max && {v}_p[{v}_n] != 0) {{ {v}_n++; }} }} uint8_t *{v}_buf = (uint8_t *)malloc({v}_n ? {v}_n : 1); if (!{v}_buf) abort(); for (uint64_t {v}_i = 0; {v}_i < {v}_n; {v}_i++) {{ {v}_buf[{v}_i] = {v}_p[{v}_i]; }} (tk_str){{ {v}_buf, {v}_n }}; }})")
}

/**
 * `teko::mem::region_buf(region: uptr, len: u64, init: str) -> ptr<byte>`
 * (c-types-and-marshalling-0.3.1.md §7.3, crumb C5) — the NAMED-region twin of `buf_ptr`:
 * bump-allocates `len` contiguous octets into the CALLER-CHOSEN region (`tk_region_alloc`, not the
 * enclosing one), copies at most `len` octets of `init` into the front of that buffer, and writes a
 * NUL terminator at the first octet `init` did not fill (or at the buffer's final octet, when
 * `init` fills the whole span) — the tier-2 allocation `c_string_in_arena` needs. Inlined as a GNU
 * statement-expression; no runtime forwarder exists for this shape either.
 *
 * @param []byte buf  the output buffer
 * @param CgProg prog  the typed program (for arg emission)
 * @param checker::TCall c  the typed call (args[0] = the region `uptr`, args[1] = `len`, args[2] = `init`)
 * @param []str escaping  the escape-analysis frame set
 * @param []RegionFrame regions  the open region-frame stack
 * @param []checker::TStatement fn_body  the enclosing function body (defer context)
 * @param DeferCtx dctx  the defer context
 * @return []byte | error  the buffer with the named-region alloc-and-terminate stmt-expr appended, or a codegen error
 */
fn emit_region_buf(buf: []byte, prog: CgProg, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var v = $"_rb{buf.len}"
    var out = cb(buf, $"({{ tk_region *{v}_r = (tk_region *)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, $"); uint64_t {v}_len = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, $"); tk_str {v}_s = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, $"); uint8_t *{v} = (uint8_t *)tk_region_alloc({v}_r, (size_t){v}_len); uint64_t {v}_cn = ({v}_s.len < {v}_len) ? {v}_s.len : {v}_len; for (uint64_t {v}_i = 0; {v}_i < {v}_cn; {v}_i++) {{ {v}[{v}_i] = {v}_s.ptr[{v}_i]; }} if ({v}_cn < {v}_len) {{ {v}[{v}_cn] = 0; }} else if ({v}_len > 0) {{ {v}[{v}_len - 1] = 0; }} {v}; }})")
}


// (W10b.D3) a DYNAMIC contract-method call through an interface value's vtable, as a GNU
// statement-expression: bind the receiver ONCE (args[0] — a class instance is upcast on the fly
// by emit_as, an interface value passes through), then cast slot `iface_slot`'s code pointer to
// the method's concrete C signature — `R (*)(void *, params…)`, the receiver riding as the
// ABI-identical `void *` data word — and call it. Rides emit_closure_call's cast-and-call scheme
// (the tk_closure machinery the plan's D3 row names). Mirror of codegen.c::emit_iface_call.
fn emit_iface_call(buf: []byte, prog: CgProg, ret_type: @Type(), c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var p = c.callee
    var f = match c.callee_type { checker::Func as ff => ff; _ => return error { message = "codegen: malformed interface-dispatch node (internal)" } }
    if p.segments.len < 2 || c.args.len == 0 || c.args.len != f.params.len {
        return error { message = "codegen: malformed interface-dispatch node (internal)" }
    }
    // (#109 W3) the callee path segment is the interface's BARE name; canonicalize it to the
    // declared "ns::Iface" so the fat-pointer typedef (`tk_t_<canonical>`) and the (class,iface)
    // vtable ref (`tk_vt_<Class>_<canonical>`) both key off the SAME C symbol their definitions use.
    var iface_raw = p.segments[p.segments.len - 2].name
    var iface = match cg_find_decl(prog, iface_raw) { parser::TypeDecl as d => d.name; error => iface_raw }
    var t = fresh_named("_tid", buf.len to i64)
    var iface_t = checker::Named { name = iface }
    var out = cb(buf, "({ ")
    // (#98) the receiver temp's C type is the fat-pointer typedef of the dispatch target — the
    // interface typedef `tk_t_<iface>` OR, for a base-class dispatch, `tk_base_<base>`. Route
    // through emit_type (not raw mangle_type_name, which would emit the base's OBJECT struct).
    out = match emit_type(out, prog, iface_t) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, t)
    out = cb(out, " = ")
    out = match emit_as_r(out, prog, ret_type, iface_t, c.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; ((")
    out = match emit_type(out, prog, f.ret) { []byte as o => o; error as err => return err }
    out = cb(out, " (*)(void *")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        out = cb(out, ", ")
        out = match emit_type(out, prog, f.params[pi]) { []byte as o => o; error as err => return err }
        pi++
    }
    out = cb(out, "))")
    out = cb(out, t)
    out = cb(out, ".vtable[")
    out = cb(out, teko::u64_to_str(c.iface_slot to u64))
    out = cb(out, "])(")
    out = cb(out, t)
    out = cb(out, ".data")
    var ai: u64 = 1
    loop {
        if ai >= c.args.len { break }
        out = cb(out, ", ")
        out = match emit_as_r(out, prog, ret_type, f.params[ai], c.args[ai], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        ai++
    }
    cb(out, "); })")
}

/**
 * The last path segment of a call's callee — the BARE name every builtin table is keyed by.
 *
 * @param c  the checked call
 * @return   the bare name, or "" for the (internal) empty path
 */
fn cg_call_bare_name(c: checker::TCall): str {
    var segs = c.callee.segments
    if segs.len == 0 { return "" }
    segs[segs.len - 1].name
}

/**
 * Did this call resolve to a Teko DECLARATION written in the program, as opposed to an injected
 * builtin? The answer keys on the ORIGIN NAMESPACE, never on the bare name: the checker fills
 * `TCall.call_ns` only when `lookup_call` found a real declaration, and leaves it empty when the
 * name fell through to `builtin_fn`. So a non-empty `call_ns` IS the proof that user code — not the
 * runtime — owns the symbol, and every bare-name builtin table below must stand down.
 *
 * Two kinds of callee carry a namespace and are still NOT a user declaration, so the emitted
 * program is asked for the body rather than trusting `call_ns` alone:
 *   * an `extern fn` — it exists precisely to name a foreign C symbol, and the host-FFI lifters
 *     (`emit_host_ffi`) are the machinery that adapts the runtime's fixed-ABI result into the
 *     program's own result type;
 *   * the surviving `teko::mem` marshalling builtins (`as_cstr`/`str_from_c`/`region_buf`/…) — the
 *     checker stamps them with a SYNTHETIC `call_ns` of `"teko::mem"` even though no such function
 *     is declared anywhere.
 * Every real declaration IS in `prog.items`: a method and a stamped generic instance are hoisted to
 * top-level `TFunction`s under their own namespace, which is the very reason `cb_fn_name` can name
 * them. So "found, with a body" is the whole test.
 *
 * @param prog  codegen's threaded program view
 * @param c     the checked call
 * @return      true when user code declared the callee, so no builtin interception may fire
 */
fn cg_call_is_user_declared(prog: CgProg, c: checker::TCall): bool {
    if c.call_ns.len == 0 { return false }
    match cg_find_function(prog, c.call_ns, cg_call_bare_name(c)) {
        checker::TFunction as f => !f.is_extern
        error => false
    }
}

/**
 * Emit a `TCall`: the callee path becomes a C identifier joined by `__` and prefixed `teko_`
 * (`cb_fn_name`), an injected builtin becomes its `tk_*` runtime twin, and an `extern fn` becomes
 * its declared foreign symbol verbatim. The two families are DISJOINT BY CONSTRUCTION — user code
 * is `teko_*`, the runtime is `tk_*` — and the choice between them is made by
 * `cg_call_is_user_declared` (the origin namespace), never by the bare name.
 *
 * @param buf       the emit buffer
 * @param prog      codegen's threaded program view
 * @param ret_type  the type the call's result lands in (drives arg wrapping)
 * @param e         the whole call expression
 * @param c         the checked call
 * @param escaping  the names escaping the enclosing frame
 * @param regions   the enclosing region frames
 * @param fn_body   the enclosing function's statements
 * @param dctx      the enclosing defer context
 * @return          the buffer with the call appended
 * @throws          when a part of the call has no lowering (an unknown builtin, a bad signature)
 */
/**
 * emit_concat_fold — lower the variadic `teko::string::concat(pieces: []str)` bridge to the inline
 * C fold that reduces the packed `[]str` via the 2-arg `tk_str_concat` primitive (a slice-taking
 * runtime signature is impossible — `teko_rt.h` cannot name the per-program `tk_slice_str` typedef).
 * Extracted from `emit_call` so BOTH the general call path and the block-local binding path share one
 * emitter, differing only in the residence of the result (0.3.1 modelo-de-memoria §9, crumb C3).
 *
 * When `str_region` is empty the fold uses the root builder `tk_str_concat` — byte-identical to the
 * pre-C3 emission (the leak-until-process output). When `str_region` names an open scope region, each
 * accumulator is bump-allocated in that region via `tk_str_concat_r` and dies at the region's exit
 * edge, so a str concatenated inside a `{}` participates in death-by-scope. Routing to a scope is
 * UAF-free by construction: the caller gates it on `binding_is_block_local`, which proves every use
 * of the result lands inside the region's lifetime.
 *
 * @param buf         the output byte buffer to append to
 * @param prog        the typed program (for the slice-element type of the packed `[]str` arg)
 * @param arg         the single packed `[]str` argument the checker desugared the pieces into
 * @param str_region  the C expression of the region the result resides in, or "" for the root builder
 * @param escaping    the frame's escaping-name set, threaded into the argument emission
 * @param regions     the active block-region stack, threaded into the argument emission
 * @param fn_body     the enclosing function body (escape context for the argument)
 * @param dctx        the defer/coverage context threaded into the argument emission
 * @return            the buffer with the concat fold appended
 * @throws            when the argument type or expression fails to emit
 */
fn emit_concat_fold(buf: []byte, prog: CgProg, arg: checker::TExpr, str_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var cs = $"_cs{buf.len}"
    var ci = $"_ci{buf.len}"
    var ca = $"_ca{buf.len}"
    var step = if str_region.len > 0 { $"{ca} = tk_str_concat_r({str_region}, {ca}, {cs}.ptr[{ci}]);" } else { $"{ca} = tk_str_concat({ca}, {cs}.ptr[{ci}]);" }
    var o = cb(buf, "({ ")
    o = match emit_type(o, prog, arg.type) { []byte as r => r; error as err => return err }
    o = cb(o, $" {cs} = ")
    o = match emit_expr_ctx(o, prog, checker::Void { }, arg, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
    o = cb(o, $"; tk_str {ca} = (tk_str){{0,0}}; for (uint64_t {ci} = 0; {ci} < {cs}.len; {ci}++) {{ {step} }} {ca}; }})")
    o
}

/**
 * cg_is_concat_bridge — whether a call is the variadic `teko::string::concat(pieces: []str)` bridge
 * (the desugar of a `~` chain). Mirrors the `emit_call` guard EXACTLY (not user-declared, addressed
 * from `teko` or a single bare segment, last segment `concat`, exactly one packed `[]str` argument),
 * so the block-local str routing in `emit_binding` intercepts precisely the calls the general path
 * would otherwise fold with the root builder.
 *
 * @param prog  the typed program (for the user-declared query)
 * @param c     the call node
 * @return      true iff `c` is the variadic concat bridge
 * @since 0.3.1
 */
fn cg_is_concat_bridge(prog: CgProg, c: checker::TCall): bool {
    if cg_call_is_user_declared(prog, c) { return false }
    var p = c.callee
    if p.segments.len == 0 { return false }
    if c.args.len != 1 { return false }
    if p.segments[p.segments.len - 1].name != "concat" { return false }
    (p.segments.len == 1) || (p.segments[0].name == "teko")
}

/**
 * cg_bound_is_str — whether a binding's declared type is the primitive `str` (the only heap-str tier
 * whose block-local residence the C3 str-scope routing tightens). A `str?`/variant-wrapped str is NOT
 * matched — that value needs a wrap through `emit_as_r_in`, so it stays on the general path.
 *
 * @param t  the binding's declared type
 * @return   true iff `t` is exactly `str`
 * @since 0.3.1
 */
fn cg_bound_is_str(t: @Type()): bool {
    match t { checker::Str => true; _ => false }
}

/**
 * svc_scope_expr — THE §7 PART-A BACKEND SEAM: the C expression naming the arena region a service of
 * `lifetime` is materialized into and cached under. The direct analogue of `emit_ptr_wrap_guard` (§5):
 * Part A fills it with the simplest thing that is CORRECT, and Doc 1 §8 replaces the body — two lines,
 * no change to this signature, to the typer, to any type, or to any fixture.
 *
 * PART A (here, now):
 *   * `Singleton` — `tk_region_root()`, the task's root region: one materialization for the whole run,
 *     which is exactly what "singleton" means at this phase.
 *   * `Scoped`    — the enclosing frame/block region (`cg_enclosing_region_expr`), so the instance dies
 *     with the scope that claimed it.
 *   * `Transient` — `""`, the empty expression, meaning NO SLOT: every claim builds fresh, so there is
 *     nothing to look up and nothing to register.
 *
 * DOC 1 §8 (Part B, deliberately NOT done here): `Singleton` becomes the THREAD's root slot and
 * `Scoped` a THREAD sub-root. That is the per-thread arena binding, and it is the ONLY thing this
 * function hides from the rest of the backend — `svc_type_id` (the slot tag) and every caller stay
 * untouched across that swap.
 *
 * @param lifetime  the service's declared lifetime
 * @param regions   the active block/frame region stack (the `Scoped` answer reads its innermost entry)
 * @return          the C expression of the caching region, or `""` when the lifetime caches nothing
 * @since §7 Part A
 */
/**
 * emit_svc_slot_call — emit a caching service materialization: look the instance up in `scope` under
 * the service's deterministic slot tag (`svc_type_id`), and call the `ctor()` factory ONLY on a miss,
 * registering the result so the next claim finds it (§7 Part A).
 *
 * A service is a sealed CLASS, so its value is already a pointer in this backend — the same width the
 * arena registry stores — which is why the slot needs no boxing and the hit path is a plain cast.
 * Registration is always into the region `scope` names; `tk_region_lookup` is the half that walks UP
 * the parent chain, so a `Scoped` claim still finds an ancestor's instance when one exists.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type, threaded into the factory call
 * @param e         the call's typed expression node (carries the service type)
 * @param c         the `ctor()` call to guard
 * @param scope     the region C expression from `svc_scope_expr` (never empty here)
 * @param escaping  the frame's escaping-name set
 * @param regions   the active region stack
 * @param fn_body   the enclosing function body
 * @param dctx      the defer/coverage context
 * @return          the buffer with the slot-guarded materialization appended
 * @throws          when the service type or the factory call fails to emit
 * @since §7 Part A
 */
fn emit_svc_slot_call(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, scope: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var sname = match e.type { checker::Named as nm => nm.name; _ => return error { message = "codegen: a service ctor call must have a named type (§7)" } }
    var id = checker::svc_type_id(sname)
    var rN = fresh_named("_svcr", buf.len to i64)
    var hN = fresh_named("_svch", buf.len to i64)
    var out = cb(buf, "({ tk_region *")
    out = cb(out, rN)
    out = cb(out, " = ")
    out = cb(out, scope)
    out = cb(out, "; void *")
    out = cb(out, hN)
    out = cb(out, " = tk_region_lookup(")
    out = cb(out, rN)
    out = cb(out, ", ")
    out = cb_str(out, teko::u64_to_str(id))
    out = cb(out, "ULL); ")
    out = cb(out, hN)
    out = cb(out, " ? (")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb(out, hN)
    out = cb(out, " : ({ ")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    var vN = fresh_named("_svcv", buf.len to i64)
    out = cb(out, " ")
    out = cb(out, vN)
    out = cb(out, " = ")
    out = match emit_call_inner(out, prog, ret_type, e, c, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; tk_region_register(")
    out = cb(out, rN)
    out = cb(out, ", ")
    out = cb_str(out, teko::u64_to_str(id))
    out = cb(out, "ULL, (void *)")
    out = cb(out, vN)
    out = cb(out, "); ")
    out = cb(out, vN)
    cb(out, "; }); })")
}

fn svc_scope_expr(lifetime: parser::ServiceLifetime, regions: []RegionFrame): str {
    match lifetime {
        parser::ServiceLifetime::Singleton => "tk_region_root()"
        parser::ServiceLifetime::Scoped => cg_enclosing_region_expr(regions)
        parser::ServiceLifetime::Transient => ""
    }
}

/**
 * cg_service_ctor_lifetime — the lifetime of the service whose `ctor()` factory this call targets, or
 * `null` when the call is not a service materialization (§7).
 *
 * A service's `ctor()` is the IService contract factory and the SOLE way an instance comes into being
 * (`svc<T>()` inlines to exactly this call, `svc_ctor_texpr`), so recognising it here is what lets the
 * lifetime — a property of the DECLARATION — reach the emission without threading a new field through
 * the typed AST and the `.tkb` wire.
 *
 * @param prog  the typed program (decl lookup)
 * @param c     the call under emission
 * @return      the target service's lifetime, or `null`
 * @since §7 Part A
 */
fn cg_service_ctor_lifetime(prog: CgProg, c: checker::TCall): parser::ServiceLifetime | null {
    if c.args.len != 0 { return null }
    var segs = c.callee.segments
    if segs.len < 2 { return null }
    if !teko::runtime::str_eq(segs[segs.len - 1].name, "ctor") { return null }
    var owner = segs[segs.len - 2].name
    match cg_find_decl(prog, owner) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => if cb.is_service { cb.service_lifetime } else { null }
            _ => null
        }
        error => null
    }
}

/**
 * emit_call — a call in expression position. The §7 gate runs FIRST: a SERVICE materialization routes
 * through the lifetime's arena slot (look the instance up in the region `svc_scope_expr` names, build
 * and register only on a miss), because a `Singleton`/`Scoped` claim must reuse the cached instance
 * rather than construct a second one. A `Transient` service names no region and falls straight through
 * to the ordinary emission, building fresh — which is what transient means.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type
 * @param e         the call's typed expression node
 * @param c         the call node
 * @param escaping  the frame's escaping-name set
 * @param regions   the active region stack
 * @param fn_body   the enclosing function body
 * @param dctx      the defer/coverage context
 * @return          the buffer with the call appended
 * @throws          when the call fails to emit
 */
fn emit_call(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match cg_service_ctor_lifetime(prog, c) {
        parser::ServiceLifetime as lt => {
            var scope = svc_scope_expr(lt, regions)
            if scope.len > 0 { return emit_svc_slot_call(buf, prog, ret_type, e, c, scope, escaping, regions, fn_body, dctx) }
        }
        null => { }
    }
    emit_call_inner(buf, prog, ret_type, e, c, escaping, regions, fn_body, dctx)
}

fn emit_call_inner(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, c: checker::TCall, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    // (W10b.D3) a DYNAMIC contract-method call dispatches through the receiver's vtable —
    // FIRST, before any builtin name-sniffing below could collide with a method name.
    if c.is_iface_dispatch { return emit_iface_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    // (#107) a CLOSURE call (the checker resolved the callee to an in-scope local/param/let-bound
    // function VALUE, not a namespace fn) ALSO goes first, before any of the builtin/host-FFI
    // name-sniffing blocks below: those match by BARE last-segment name only (`write`, `print`,
    // `len`, …) with no scope awareness, so a closure-typed binding sharing one of those reserved
    // names (e.g. a `write: WFn` param in a namespace that also has an extern `write`) would
    // otherwise be hijacked into the builtin/extern call instead of calling the closure VALUE —
    // the checker already proved `is_closure_call` (scope.tks::lookup_call scans innermost-first,
    // so the local always wins over the namespace fn); codegen just has to respect that verdict.
    if c.is_closure_call { return emit_closure_call(buf, prog, ret_type, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_unwrap" { return emit_ptr_unwrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    if c.call_ns == "teko::__ptr_wrap" { return emit_ptr_wrap(buf, prog, e, c, escaping, regions, fn_body, dctx) }
    var p = c.callee
    var user_declared = cg_call_is_user_declared(prog, c)
    // teko::list::empty / push — the SLICE (collection) builtins, FIXED+COPY. `empty()`
    // (sentinel) is normally wrapped by emit_as into a concrete slot literal; reaching here
    // directly means a context-less empty (honest error). `push(base, item)` lowers to an
    // inline copy-append GNU stmt-expr (alloc len+1 via malloc/abort — M.1 — copy the old
    // elements, append a COPY of item, yield the fresh tk_slice_<elem>). (C: the teko::list branch.)
    // (#148 R3) teko::mem::push_fo(base, item) — push with FREE-OLD BY DECREE: the CALLER asserts
    // the base is a linear chain (the old buffer is unreferenced after the grow), so the grow
    // routes "@fo" → tk_slice_push_fo, which parks the superseded buffer on the free-list.
    // Typing/semantics are teko::list::push's; only the allocation strategy differs. (C twin: the
    // same shared push emitter, selected via g_cg_push_frame = "@fo".)
    var is_pushfo = !user_declared && p.segments.len >= 2 && p.segments[p.segments.len - 2].name == "mem" &&
    p.segments[p.segments.len - 1].name == "push_fo"
    if is_pushfo || (!user_declared && p.segments.len >= 2 && p.segments[0].name == "teko" &&
        p.segments[p.segments.len - 2].name == "list") {
        var llast = p.segments[p.segments.len - 1].name
        if llast == "empty" {
            return emit_list_empty(buf, e)
        }
        if llast == "push" || is_pushfo {
            // (S2 Level-1) the general call path never frame-routes ("" = root); a frame-local
            // self-append `xs = push(xs, …)` is emitted directly by emit_assign with `_tkfr`.
            return emit_list_push(buf, prog, e, c, escaping, regions, fn_body, dctx, if is_pushfo { "@fo" } else { "" })
        }
        if llast == "with_cap" {
            return emit_list_with_cap(buf, prog, e, c, escaping, regions, fn_body, dctx, "")
        }
        if llast == "grow_inplace" {
            return emit_list_grow_inplace(buf, prog, c, escaping, regions, fn_body, dctx)
        }
    }
    // E2 (native): err_loc/err_typed adorn an error VALUE with diagnostic position/types.
    // `error` is now the full tk_error struct (E2-NATIVE), so these call tk_error_loc /
    // tk_error_types (teko_rt.h) which return a modified copy.
    if p.segments.len >= 1 && !user_declared {
        var pe = p.segments[p.segments.len - 1].name
        if pe == "err_loc" {
            // tk_error_loc(e, line, col) — returns a copy with line/col set.
            var oe = cb(buf, "tk_error_loc(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            oe = cb(oe, ", (uint32_t)(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            oe = cb(oe, "), (uint32_t)(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            return cb(oe, "))")
        }
        if pe == "err_typed" {
            // tk_error_types(e, expected, actual) — returns a copy with expected/actual set.
            var oe = cb(buf, "tk_error_types(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            oe = cb(oe, ", ")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            oe = cb(oe, ", ")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, c.args[2], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            return cb(oe, ")")
        }
        // Phase 3 — `str`/`str_of_bytes` (([]byte) -> str). A []byte lowers to the generated struct
        // tk_slice_byte {uint8_t*,uint64_t}, a DISTINCT C type from tk_str — BRIDGE the slice to a
        // tk_str at the call site (single-eval via a temp), then tk_str_of_bytes COPIES it. Mirrors codegen.c.
        var addr = (p.segments.len == 1) || (p.segments[0].name == "teko")
        // (#148 R2) teko::mem::append_fo(dst: []byte, src: str) -> []byte — BULK append with
        // free-old BY DECREE (linear builder chains only; TEKO_MEM_PARANOID is the guard).
        // Bridge like str(): single-eval temps, then the runtime call over raw {ptr,len} pairs.
        if addr && pe == "append_fo" && c.args.len == 2 {
            var ab = $"_ab{buf.len}"
            var asr = $"_as{buf.len + 1}"
            var al = $"_al{buf.len + 2}"
            var ap = $"_ap{buf.len + 3}"
            var o = cb(buf, "({ ")
            o = match cg_slice_typename(o, checker::Byte { }) { []byte as r => r; error as err => return err }
            o = cb(o, " "); o = cb(o, ab); o = cb(o, " = ")
            o = match emit_as(o, prog, checker::Slice { element = checker::Byte { } }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            o = cb(o, "; tk_str "); o = cb(o, asr); o = cb(o, " = ")
            o = match emit_as(o, prog, checker::Str { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            o = cb(o, "; uint64_t "); o = cb(o, al); o = cb(o, "; uint8_t *"); o = cb(o, ap)
            o = cb(o, " = (uint8_t *)tk_append_bytes_fo("); o = cb(o, ab); o = cb(o, ".ptr, "); o = cb(o, ab); o = cb(o, ".len, "); o = cb(o, asr); o = cb(o, ".ptr, "); o = cb(o, asr); o = cb(o, ".len, &"); o = cb(o, al)
            o = cb(o, "); (")
            o = match cg_slice_typename(o, checker::Byte { }) { []byte as r => r; error as err => return err }
            o = cb(o, "){ .ptr = "); o = cb(o, ap); o = cb(o, ", .len = "); o = cb(o, al)
            return cb(o, " }; })")
        }
        if addr && (pe == "str" || pe == "str_of_bytes") && c.args.len == 1 {
            var sb = $"_sb{buf.len}"
            var o = cb(buf, "({ ")
            o = match emit_type(o, prog, c.args[0].type) { []byte as r => r; error as err => return err }
            o = cb(o, " ")
            o = cb(o, sb)
            o = cb(o, " = ")
            o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            o = cb(o, "; tk_str_of_bytes((tk_str){ (const tk_byte *)")
            o = cb(o, sb)
            o = cb(o, ".ptr, ")
            o = cb(o, sb)
            return cb(o, ".len }); })")
        }
        // `concat(params pieces: []str) -> str` (== teko::string::concat, the LEGISLATED "+"
        // never concatenates" primitive) — after the checker's params desugar, the call always
        // arrives here with EXACTLY ONE arg (a []str, whether packed from N pieces or passed
        // through). BRIDGE: fold the tk_slice_str via the existing 2-arg tk_str_concat primitive
        // in an inline C loop (avoids needing a slice-taking runtime C signature — teko_rt.h
        // can't reference tk_slice_str, a per-program generated typedef). Mirrors codegen.c.
        if addr && pe == "concat" && c.args.len == 1 {
            return emit_concat_fold(buf, prog, c.args[0], "", escaping, regions, fn_body, dctx)
        }
    }
    if p.segments.len >= 1 {
        var l = p.segments[p.segments.len - 1].name
        var addr2 = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        if addr2 {
            if l == "read_file" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_read_file", escaping, regions, fn_body, dctx) }
            if l == "var" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getenv", escaping, regions, fn_body, dctx) }
            if l == "write_file" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_write_file", escaping, regions, fn_body, dctx) }
            if l == "write_file_bytes" { return emit_host_ffi(buf, prog, e, c, "ures_byteslice", "tk_rt_write_file_bytes", escaping, regions, fn_body, dctx) }   // C7.12: []byte → file
            if l == "chdir" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_chdir", escaping, regions, fn_body, dctx) }
            if l == "mkdir" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_mkdir", escaping, regions, fn_body, dctx) }
            if l == "remove_file" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_remove_file", escaping, regions, fn_body, dctx) }   // (issue #79) delete a file (idempotent)
            if l == "cwd" { return emit_host_ffi(buf, prog, e, c, "sres", "tk_rt_getcwd", escaping, regions, fn_body, dctx) }
            if l == "set_var" { return emit_host_ffi(buf, prog, e, c, "ures", "tk_rt_setenv", escaping, regions, fn_body, dctx) }
            if l == "list_dir" { return emit_host_ffi(buf, prog, e, c, "slres", "tk_rt_list_dir", escaping, regions, fn_body, dctx) }
            if l == "last_index_of" { return emit_host_ffi(buf, prog, e, c, "u64res", "tk_rt_last_index_of", escaping, regions, fn_body, dctx) }
            if l == "args" { return emit_host_ffi(buf, prog, e, c, "args", "tk_rt_args", escaping, regions, fn_body, dctx) }
            if l == "run" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run", escaping, regions, fn_body, dctx) }
            if l == "run_quiet" { return emit_host_ffi(buf, prog, e, c, "run", "tk_rt_run_quiet", escaping, regions, fn_body, dctx) }   // (issue #73) cc flag-family probe
            if l == "bytes_from_ptr" { return emit_host_ffi(buf, prog, e, c, "bytes", "tk_bytes_from_ptr", escaping, regions, fn_body, dctx) }   // (C7.1a) ptr+len -> []byte (slice-lift)
            if l == "str_from_utf8" { return emit_host_ffi(buf, prog, e, c, "sres_byteslice", "tk_rt_str_from_utf8", escaping, regions, fn_body, dctx) }   // ROUND 0: ([]byte) -> str | error
            if l == "buf_ptr" { return emit_buf_ptr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "as_cstr" { return emit_as_cstr(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "str_from_c" { return emit_str_from_c(buf, prog, c, escaping, regions, fn_body, dctx) }
            if l == "region_buf" { return emit_region_buf(buf, prog, c, escaping, regions, fn_body, dctx) }
        }
    }
    var builtin = ""
    var has_builtin = false
    if p.segments.len >= 1 {
        var last = p.segments[p.segments.len - 1].name
        var addressable = !user_declared && ((p.segments.len == 1) || (p.segments[0].name == "teko"))
        var assert_sym = if c.call_ns.len == 0 { cg_assert_c_symbol(p) } else { "" }
        if assert_sym.len != 0 { builtin = assert_sym; has_builtin = true }
        else if addressable {
            if last == "print" { builtin = "tk_print"; has_builtin = true }
            else if last == "println" { builtin = "tk_println"; has_builtin = true }
            else if last == "panic" { builtin = "tk_panic_str"; has_builtin = true }   // panic(str) — diverges (no `never` type)
            else if last == "exit" { builtin = "tk_exit"; has_builtin = true }   // exit(<int>) — diverges
            // host output FFI bottoms (scope.c) — (str) -> void. write=stdout; e*=stderr.
            else if last == "write" { builtin = "tk_write"; has_builtin = true }   // (str) -> void (stdout)
            else if last == "ewrite" { builtin = "tk_ewrite"; has_builtin = true }   // (str) -> void (stderr)
            else if last == "eprint" { builtin = "tk_eprint"; has_builtin = true }   // (str) -> void (stderr)
            else if last == "eprintln" { builtin = "tk_eprintln"; has_builtin = true }   // (str) -> void (stderr + '\n')
            else if last == "read_line" { builtin = "tk_rt_read_line"; has_builtin = true }
            else if last == "stdin_eof" { builtin = "tk_rt_stdin_eof"; has_builtin = true }
            else if last == "read_stdin" { builtin = "tk_rt_read_stdin"; has_builtin = true }
            else if last == "parse" { builtin = "tk_float_parse"; has_builtin = true }   // teko::float::parse(str) -> f64
            else if last == "fdiv" { builtin = "tk_fdiv"; has_builtin = true }   // (f64,f64) -> f64
            else if last == "f64_bits" { builtin = "tk_f64_bits"; has_builtin = true }   // (f64) -> u64
            else if last == "f64_from_bits" { builtin = "tk_f64_from_bits"; has_builtin = true }   // (u64) -> f64
            // D3 — test-coverage sink (host side-channel): marks executed production fns.
            else if last == "cov_reset" { builtin = "tk_cov_reset"; has_builtin = true }   // () -> void
            else if last == "cov_mark" { builtin = "tk_cov_mark"; has_builtin = true }   // (u64) -> void
            else if last == "cov_distinct" { builtin = "tk_cov_distinct"; has_builtin = true }   // () -> u64
            else if last == "cov_is_marked" { builtin = "tk_cov_is_marked"; has_builtin = true }   // (u64) -> bool
            // D3-branch — branch-coverage sink (only records when ON; off by default).
            else if last == "cov_branches_on" { builtin = "tk_cov_branches_on"; has_builtin = true }   // (bool) -> void
            else if last == "cov_branch_reset" { builtin = "tk_cov_branch_reset"; has_builtin = true }   // () -> void
            else if last == "cov_enter" { builtin = "tk_cov_enter"; has_builtin = true }   // (u64) -> void
            else if last == "cov_leave" { builtin = "tk_cov_leave"; has_builtin = true }   // () -> void
            else if last == "cov_branch" { builtin = "tk_cov_branch"; has_builtin = true }   // (u32,u32,u64) -> void
            else if last == "cov_branch_hit" { builtin = "tk_cov_branch_hit"; has_builtin = true }   // (u64,u32,u32,u64) -> bool
            else if last == "cov_lines_on" { builtin = "tk_cov_lines_on"; has_builtin = true }   // (bool) -> void
            else if last == "cov_line_reset" { builtin = "tk_cov_line_reset"; has_builtin = true }   // () -> void
            else if last == "cov_line" { builtin = "tk_cov_line"; has_builtin = true }   // (u32) -> void
            else if last == "cov_line_hit" { builtin = "tk_cov_line_hit"; has_builtin = true }   // (u64,u32) -> bool
            else if last == "arena_push" { builtin = "tk_arena_push"; has_builtin = true }   // (#109 test-gate memory) () -> void
            else if last == "arena_pop" { builtin = "tk_arena_pop"; has_builtin = true }   // () -> void
            else if last == "arena_commit" { builtin = "tk_arena_commit"; has_builtin = true }
            else if last == "task_reset" { builtin = "tk_task_reset"; has_builtin = true }
            else if last == "intern_get" { builtin = "tk_intern_get"; has_builtin = true }
            else if last == "intern_put" { builtin = "tk_intern_put"; has_builtin = true }
            else if last == "intern_reset" { builtin = "tk_intern_reset"; has_builtin = true }
            // diverging runtime panic helpers (the corpus calls these by bare name)
            else if last == "panic_div0" { builtin = "tk_panic_div0"; has_builtin = true }
            else if last == "panic_oob" { builtin = "tk_panic_oob"; has_builtin = true }
            else if last == "panic_cast" { builtin = "tk_panic_cast"; has_builtin = true }
            else if last == "panic_overflow" { builtin = "tk_panic_overflow"; has_builtin = true }
            // str/byte STDLIB surface (Phase 3) — the unqualified helpers the corpus calls, recognized
            // by the checker and lowered to their tk_ runtime twins (a fresh tk_str; OOM-panics, M.1).
            // (`str`/`str_of_bytes` are bridged specially ABOVE — a []byte lowers to tk_slice_byte, a
            // DISTINCT C type from tk_str. In a CALL `str` is this builtin, not the str TYPE.)
            else if last == "one_byte" { builtin = "tk_one_byte"; has_builtin = true }   // (byte) -> str
            else if last == "str_concat" { builtin = "tk_str_concat"; has_builtin = true }   // (str, str) -> str — internal 2-arg primitive, unchanged
            else if last == "str_hash" { builtin = "tk_str_hash"; has_builtin = true }
            else if last == "str_compare" { builtin = "tk_str_cmp"; has_builtin = true }
            // "concat"/"concat3" are NOT here — `concat3` REMOVED (2026-07-01); the PUBLIC
            // variadic `concat(params pieces: []str)` (== `teko::string::concat`, the LEGISLATED
            // "+` never concatenates" primitive — TEKO_LEGISLATION.md) is bridged specially
            // ABOVE (folds a packed []str slice via tk_str_concat), since a builtin-dispatch
            // name-substitution can't accept a slice argument directly.
            else if last == "slice" { builtin = "tk_str_slice"; has_builtin = true }   // str::slice(str,u64,u64) -> str
            else if last == "slice_to" { builtin = "tk_str_slice_to"; has_builtin = true }   // (str,u64) -> str
            else if last == "slice_from" { builtin = "tk_str_slice_from"; has_builtin = true }   // (str,u64) -> str
            else if last == "len" { builtin = "tk_str_len"; has_builtin = true }   // (str) -> u64
            else if last == "bytes_of_str" { builtin = "tk_bytes_of_str"; has_builtin = true }   // (str) -> []byte
            else if last == "chars" { builtin = "tk_str_chars"; has_builtin = true }   // (str) -> []char
            else if last == "len_chars" { builtin = "tk_str_len_chars"; has_builtin = true }   // (str) -> i64
            // ROUND 0: UTF-8 codepoint operations
            else if last == "char_at" { builtin = "tk_char_at"; has_builtin = true }   // (str, i64) -> char
            else if last == "str_slice_chars" { builtin = "tk_str_slice_chars"; has_builtin = true }   // (str, i64, i64) -> str
            // Guard with call_ns.len==0 so lexer.tks private is_alpha/is_digit (which take
            // byte not char) are NOT lowered to the tk_ builtin (mirrors codegen.c guard).
            else if last == "is_alpha" && c.call_ns.len == 0 { builtin = "tk_is_alpha"; has_builtin = true }   // (char) -> bool
            else if last == "is_digit" && c.call_ns.len == 0 { builtin = "tk_is_digit"; has_builtin = true }   // (char) -> bool
            else if last == "is_space" && c.call_ns.len == 0 { builtin = "tk_is_space"; has_builtin = true }   // (char) -> bool
            else if last == "to_lower" && c.call_ns.len == 0 { builtin = "tk_to_lower"; has_builtin = true }   // (char) -> char
            else if last == "to_upper" && c.call_ns.len == 0 { builtin = "tk_to_upper"; has_builtin = true }   // (char) -> char
            else if last == "ends_with" { builtin = "tk_str_ends_with"; has_builtin = true }   // (str,str) -> bool
            else if last == "contains" { builtin = "tk_str_contains"; has_builtin = true }   // (str,str) -> bool
            // (last_index_of returns u64|error → lifted by emit_host_ffi above, not here)
            else if last == "i64_to_str" { builtin = "tk_i64_to_str"; has_builtin = true }   // (i64) -> str
            else if last == "u64_to_str" { builtin = "tk_u64_to_str"; has_builtin = true }   // (u64) -> str
            else if last == "ftoa" { builtin = "tk_ftoa"; has_builtin = true }   // (f64) -> str
            else if last == "fmt_f" { builtin = "tk_fmt_f"; has_builtin = true }   // (f64, i64) -> str
            else if last == "fmt_e" { builtin = "tk_fmt_e"; has_builtin = true }   // (f64, i64) -> str
            else if last == "fmt_g" { builtin = "tk_fmt_g"; has_builtin = true }   // (f64, i64) -> str
            else if last == "fmt_p" { builtin = "tk_fmt_p"; has_builtin = true }   // (f64, i64) -> str
            else if last == "fmt_n_f" { builtin = "tk_fmt_n_f"; has_builtin = true }   // (f64, i64) -> str
            else if last == "fmt_d" { builtin = "tk_fmt_d"; has_builtin = true }   // (i64, i64) -> str
            else if last == "fmt_x_upper" { builtin = "tk_fmt_x_upper"; has_builtin = true }   // (u64) -> str
            else if last == "fmt_x_lower" { builtin = "tk_fmt_x_lower"; has_builtin = true }   // (u64) -> str
            else if last == "fmt_b" { builtin = "tk_fmt_b"; has_builtin = true }   // (u64) -> str
            else if last == "fmt_n_i" { builtin = "tk_fmt_n_i"; has_builtin = true }   // (i64) -> str
            else if last == "fmt_dyn_f64" { builtin = "tk_fmt_dyn_f64"; has_builtin = true }   // (f64, str) -> str
            else if last == "fmt_dyn_i64" { builtin = "tk_fmt_dyn_i64"; has_builtin = true }   // (i64, str) -> str
            else if last == "fmt_dyn_u64" { builtin = "tk_fmt_dyn_u64"; has_builtin = true }   // (u64, str) -> str
            else if last == "f64_g17" { builtin = "tk_f64_g17"; has_builtin = true }   // (f64) -> str (host float renderer)
            else if last == "as_ptr" { builtin = "tk_as_ptr"; has_builtin = true }   // (str) -> ptr (raw bytes; borrows, pair with `.len`)
            else if last == "os" { builtin = "tk_rt_os"; has_builtin = true }   // () -> str (host OS — C7.1f)
            else if last == "arch" { builtin = "tk_rt_arch"; has_builtin = true }
            else if last == "version" { builtin = "tk_rt_version"; has_builtin = true }   // () -> str (build version — CLI --version)
            else if last == "peak_rss" { builtin = "tk_peak_rss"; has_builtin = true }   // (#148) () -> u64 — peak RSS in bytes
            // (err_loc/err_typed handled at the top of this fn — they call tk_error_loc /
            //  tk_error_types on the full tk_error struct — E2-NATIVE. Mirrors codegen.c.)
        }
    }
    var out = buf
    // Resolve the callee FIRST (when a namespaced user call) so we know its C name AND whether it
    // is an `extern` (C7.1a): an extern lowers to its raw C symbol, with NO namespace mangling.
    var cf_res = if c.call_ns.len != 0 {
        cg_find_function(prog, c.call_ns, p.segments[p.segments.len - 1].name)
    } else { error { message = "codegen: no resolved namespace" } }
    if has_builtin {
        out = cb(out, builtin)
    } else if c.call_ns.len != 0 {
        var is_extern_call = false
        var ext_symbol = ""
        match cf_res {
            checker::TFunction as cf => { if cf.is_extern { is_extern_call = true; ext_symbol = cf.c_symbol } }
            error => { }
        }
        if is_extern_call {
            out = cb(out, ext_symbol)   // C7.1a: the raw foreign C symbol
        } else {
            // (#49) a resolved USER call -> the SAME namespace-mangled C name emit_function_sig gives
            // the definition (teko::checker::type_eq -> teko__checker__type_eq), so def + call agree
            // and same-named functions across namespaces never collide.
            out = cb_fn_name(out, c.call_ns, p.segments[p.segments.len - 1].name, c.overload_suffix)
        }
    } else {
        // No resolved namespace (a builtin, or a name not carried) -> the bare
        // (keyword-escaped) last segment. (A closure call never reaches here — the (#107)
        // is_closure_call guard at the top of emit_call already returned via emit_closure_call.)
        out = cb_ident(out, p.segments[p.segments.len - 1].name)
    }
    // A resolved USER call: wrap each arg into its parameter type (emit_as) so a bare case value
    // (e.g. `Prim{…}` passed where a `Type` variant is expected) lands in the variant rep — the arg
    // keeps its case type (type_call no longer clobbers widened args). For a NAMED param only
    // (variant/struct/enum); other param shapes emit plainly, as before. When there's no resolved
    // function (builtins / call_ns empty), emit all args plainly.
    out = cb(out, "(")
    var j = 0
    loop {
        if j >= c.args.len { break }
        if j > 0 { out = cb(out, ", ") }
        var wrapped = false
        match cf_res {
            checker::TFunction as cf => {
                if j < cf.params.len {
                    var cf_ref_ns = cg_fn_ref_ns(prog, cf.namespace)
                    /* (item-14 §13.2) the value-struct receiver rides as the HEADER POINTER — the same
                       auto-`&` the `Ref<T>` parameter below performs, injected for `self`. */
                    var is_self_recv = if j != 0 { false } else { match cg_struct_self_recv(prog, cf) { str => true; null => false } }
                    match cf.params[j].type_ann {
                        parser::NamedType as nt => {
                            var pn = nt.path.segments[nt.path.segments.len - 1].name
                            // (MEM-1b-ii) a `Ref<T>` param: AUTO-REF a non-reference arg of the pointed
                            // type (`&x`); forward an already-reference arg plainly. NOT emit_as_r (Ref
                            // is not a user variant). `&` takes the address of the `mut` lvalue (the
                            // checker proved it's a `mut` variable).
                            if is_self_recv {
                                /* (item-14 §13.2) the receiver of a value-struct method — the header
                                   pointer, the auto-`ref` twin of the `Ref<T>` case just below. */
                                out = match cg_emit_self_addr(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            } else if pn == "Ref" {
                                var arg_is_ref = match c.args[j].type { checker::Reference => true; _ => false }
                                if !arg_is_ref { out = cb(out, "&") }
                                out = match emit_expr_ctx(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            } else {
                                out = match emit_as_r(out, prog, ret_type, checker::Named { name = cg_canon_name_ns(prog, nt.path, cf_ref_ns) }, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            }
                            wrapped = true
                        }
                        parser::SliceType as slt => {
                            var exp_slice = cg_slice_param_type(prog, slt, c.args[j].type)
                            out = match emit_as_r(out, prog, ret_type, exp_slice, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            wrapped = true
                        }
                        parser::UnionType => {
                            var exp_union = cg_te_to_type_ns(prog, cf_ref_ns, cf.params[j].type_ann)
                            out = match emit_as_r(out, prog, ret_type, exp_union, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            wrapped = true
                        }
                        _ => { }
                    }
                }
            }
            error => { }
        }
        if !wrapped {
            out = match emit_expr_ctx(out, prog, ret_type, c.args[j], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        }
        j++
    }
    cb(out, ")")
}

// emit_field_access — a TFieldAccess -> `(recv.field)`. (C: TK_TEXPR_FIELD_ACCESS branch.)
// W5-idx — `.len`: a `str` lowers to the runtime tk_str's `.len` member (`(recv).len`); a
// slice's `.len` reads its tk_slice_<elem> `.len` member (same {ptr,len} shape as tk_str -> u64).
fn emit_field_access(buf: []byte, prog: CgProg, fa: checker::TFieldAccess, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var is_slice = match fa.receiver.type { checker::Slice => true; _ => false }
    if is_slice && fa.field == "len" {
        var o = cb(buf, "(")   // `.len` of a tk_slice_<elem> — same {ptr,len} shape as tk_str -> u64
        o = match emit_expr_ctx(o, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(o, ".len)")
    }
    // E2 (native): error values are now the full tk_error struct (E2-NATIVE), so
    // field access reads the real struct fields. Mirrors codegen.c.
    var is_error = match fa.receiver.type { checker::Error => true; _ => false }
    if is_error {
        var oe = cb(buf, "((")
        oe = match emit_expr_ctx(oe, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        oe = cb(oe, ").")
        oe = cb_str(oe, fa.field)
        return cb(oe, ")")
    }
    // (MEM-1b-ii) `Ref<T>.value` deref — the reference lowers to a bare `<T> *`, so `.value` reads
    // `(*recv)`. (The receiver `r` is itself the pointer; `.value` is its dereference.)
    var is_ref = match fa.receiver.type { checker::Reference => true; _ => false }
    if is_ref && fa.field == "value" {
        var or = cb(buf, "(*(")
        or = match emit_expr_ctx(or, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(or, "))")
    }
    // (W10b.CLASS increment 3) a class receiver is ALWAYS a pointer (reference semantics) —
    // `recv.field` needs a deref first (`(*recv).field`, i.e. C's `recv->field`).
    var is_class_recv = match fa.receiver.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class_recv {
        // (#98) a POLYMORPHIC-BASE-typed receiver is the fat pointer `tk_base_<B>` (data + vtable), not
        // a raw object pointer — extract `.data`, cast to the base's raw `tk_t_<B> *`, then deref:
        // `((*((tk_t_<B> *)(<recv>).data)).<field>)`. A plain (raw-pointer) class receiver stays
        // `((*(<recv>)).<field>)`.
        var recv_poly_base = match fa.receiver.type {
            checker::Named as nm => cg_is_polymorphic_base(prog, nm.name)
            _ => false
        }
        if recv_poly_base {
            var bname = match fa.receiver.type { checker::Named as nm => nm.name; _ => "" }
            var ob = cb(buf, "((*((")
            ob = mangle_type_name(ob, "", bname)
            ob = cb(ob, " *)(")
            ob = match emit_expr_ctx(ob, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            ob = cb(ob, ").data)).")
            ob = cb_str(ob, fa.field)
            return cb(ob, ")")
        }
        var oc = cb(buf, "((*(")
        oc = match emit_expr_ctx(oc, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        oc = cb(oc, ")).")
        oc = cb_str(oc, fa.field)
        return cb(oc, ")")
    }
    // auto-box: reading a recursive back-edge field derefs the heap pointer.
    var fa_boxed = match fa.receiver.type {
        checker::Named as nm => match cg_find_struct_field_type(prog, nm.name, fa.field) {
            (@TypeExpr()) as fte => cg_field_boxed(prog, nm.name, fte)
            null => false
        }
        _ => false
    }
    var out = cb(buf, "(")
    if fa_boxed { out = cb(out, "*") }
    out = cb(out, "(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, fa.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ".")
    out = cb_str(out, fa.field)
    cb(out, "))")
}

/**
 * `cg_expr_diverges` — is a call-shaped sub-expression a diverging `panic`/`exit` call in a VALUE
 * position (a `??` fallback's right side, or a `match` arm's tail)? Delegates the "is this
 * actually the injected builtin, not a same-named user function/closure the resolver bound
 * instead" test to `checker::tcall_is_diverging_builtin` — the single place that test is made —
 * rather than re-deriving it from the bare callee name here. In a VALUE position a true positive
 * lowers to `(<call>, (T){0})`: the call is `_Noreturn` (`tk_panic_str`/`tk_exit`), so the
 * zero-of-T is unreachable but keeps the C `?:`/expr well-typed. Narrower than the checker's
 * `texpr_diverges` on purpose — its two call sites only ever need to test a bare call, never a
 * nested `match`/`if`.
 *
 * @param e  the typed sub-expression
 * @return   true iff `e` is a call the resolver bound to the injected `panic`/`exit` builtin
 */
fn cg_expr_diverges(e: checker::TExpr): bool {
    match e.kind {
        checker::TCall as c => checker::tcall_is_diverging_builtin(c)
        _ => false
    }
}

// emit_index — W5-idx `recv[index]`. A `str` receiver lowers to a BOUNDS-CHECKED byte access
// as a GNU statement-expression (single-eval of recv + idx, then the guard):
//   ({ tk_str _sN = <recv>; uint64_t _iN = <idx>; _iN < _sN.len ? _sN.ptr[_iN]
//                                              : (tk_panic_oob(), (tk_byte)0); })
// tk_panic_oob is declared in teko_rt.h (the generated TU's runtime header) — an out-of-bounds
// index PANICS with the standard out-of-range message (M.1). A slice receiver uses the
// SAME bounds-checked shape, with the element C type substituted for tk_byte and reading
// `(recv).ptr[i]` with a `(tk_panic_oob(), (<elem>){0})` fallback. (C: the TK_TEXPR_INDEX branch.)
fn emit_index(buf: []byte, prog: CgProg, e: checker::TExpr, ix: checker::TIndex, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    // slice subscript: the SAME bounds-checked stmt-expr as str, with the element type
    // substituted for tk_byte and a 0-of-element fallback after the panic.
    match ix.receiver.type {
        checker::Slice as srt => {
            var elem = match srt.element {
                checker::Void => return error { message = "codegen: indexing an untyped empty slice (internal: checker should reject)" }
                _ => srt.element
            }
            var lstmp = $"_ls{buf.len}"
            var litmp = $"_li{buf.len + 1}"
            var so = cb(buf, "({ ")
            so = match emit_type(so, prog, elem) { []byte as o => o; error as err => return err }
            so = cb(so, " const *")
            so = cb(so, lstmp)
            so = cb(so, " = (")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            so = cb(so, ").ptr; uint64_t ")
            so = cb(so, litmp)
            so = cb(so, " = (uint64_t)(")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            so = cb(so, "); ")
            so = cb(so, litmp)
            so = cb(so, " < (")
            so = match emit_expr_ctx(so, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            so = cb(so, ").len ? ")
            so = cb(so, lstmp)
            so = cb(so, "[")
            so = cb(so, litmp)
            so = cb(so, "]")
            so = cb(so, " : (tk_panic_oob_at(")   // (C1.7) positioned OOB — node line:col
            so = cb(so, teko::u64_to_str(e.line to u64))
            so = cb(so, ", ")
            so = cb(so, teko::u64_to_str(e.col to u64))
            so = cb(so, "), (")
            so = match emit_type(so, prog, elem) { []byte as o => o; error as err => return err }
            return cb(so, "){0}); })")
        }
        checker::Str => { }
        _ => return error { message = "codegen: indexing a non-string value not yet supported" }
    }
    // Unique temp names (the buffer length is the functional uniquifier — see emit_if_value).
    var stmp = $"_s{buf.len}"
    var itmp = $"_i{buf.len + 1}"   // +1 so it differs from stmp
    var out = cb(buf, "({ tk_str ")
    out = cb(out, stmp)
    out = cb(out, " = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; uint64_t ")
    out = cb(out, itmp)
    out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); ")
    out = cb(out, itmp)
    out = cb(out, " < ")
    out = cb(out, stmp)
    out = cb(out, ".len ? ")
    out = cb(out, stmp)
    out = cb(out, ".ptr[")
    out = cb(out, itmp)
    out = cb(out, "]")
    var z = cb(out, " : (tk_panic_oob_at(")   // (C1.7) positioned OOB — node line:col
    z = cb(z, teko::u64_to_str(e.line to u64))
    z = cb(z, ", ")
    z = cb(z, teko::u64_to_str(e.col to u64))
    cb(z, "), (tk_byte)0); })")
}

// emit_in — Phase 2: `<lhs> in [ e0, e1, … ]` -> bool. The lhs is EVALUATED ONCE (single-eval),
// bound to a temp via a GNU statement-expression, then compared to each element with `==` OR'd
// together (true iff the lhs equals any element). The node's `.type` is bool.
//   ({ <CtypeOfLhs> _invN = <lhs>; (_invN == <e0>) || (_invN == <e1>) || …; })
// A STR lhs routes each comparison through tk_str_eq instead (a tk_str is a {ptr,len} struct —
// C `==` is invalid on it; content equality, mirroring emit_compare's str branch):
//   ({ tk_str _invN = <lhs>; tk_str_eq(_invN, <e0>) || tk_str_eq(_invN, <e1>) || …; })
// The temp `_inv<buf.len>` uses the buffer length as the functional uniquifier (see emit_index).
// The EMPTY set `x in []` still EVALUATES the lhs once (single-eval), then yields false — so a
// side-effecting lhs still runs once, even for `[]`. (C: the TK_TEXPR_IN branch of emit_expr.)
fn emit_in(buf: []byte, prog: CgProg, ie: checker::TInExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if ie.elems.len == 0 {
        var z = cb(buf, "({ (void)(")
        z = match emit_expr_ctx(z, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(z, "); 0; })")
    }
    var tmp = $"_inv{buf.len}"
    var str_in = match ie.lhs.type { checker::Str => true; _ => false }
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, ie.lhs.type) { []byte as o => o; error as err => return err }   // the lhs's resolved C type
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, " = ")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ie.lhs, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "; ")
    var i = 0
    loop {
        if i >= ie.elems.len { break }
        if i > 0 { out = cb(out, " || ") }
        if str_in {
            out = cb(out, "tk_str_eq(")
            out = cb(out, tmp)
            out = cb(out, ", ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ")")
        } else {
            out = cb(out, "(")
            out = cb(out, tmp)
            out = cb(out, " == ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ie.elems[i], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ")")
        }
        i++
    }
    cb(out, "; })")
}

// emit_array_lit — `[ e0, e1, … ]` (Increment B+) -> a `tk_slice_<elem>` value. Empty `[]` is the
// concrete empty literal. Plain elements: allocate N slots, fill by index via emit_as.
// Spread elements (`..xs`): when present, build via tk_slice_push into a dynamic accumulator
// (mirrors the slow path in the C twin codegen.c — see its TK_TEXPR_ARRAY / has_spread branch).
fn emit_array_lit(buf: []byte, prog: CgProg, e: checker::TExpr, a: checker::TArrayLit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var elem = match e.type { checker::Slice as s => s.element; _ => return error { message = "codegen: array literal is not a slice type (internal)" } }
    if a.elements.len == 0 {
        var z = cb(buf, "(")
        z = match cg_slice_typename(z, elem) { []byte as o => o; error as err => return err }
        return cb(z, "){ .ptr = 0, .len = 0 }")
    }
    // detect any spread element
    var has_spread = false
    var si: u64 = 0
    loop {
        if si >= a.elements.len { break }
        if a.elements[si].is_spread { has_spread = true; break }
        si++
    }
    if !has_spread {
        // fast path: all plain elements — allocate once, fill by index
        var pN = $"_arr{buf.len}"
        var out = cb(buf, "({ ")
        out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
        out = cb(out, " *"); out = cb(out, pN); out = cb(out, " = malloc(")
        out = cb_u64_digits(out, a.elements.len)
        out = cb(out, " * sizeof(")
        out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
        out = cb(out, ")); if (!"); out = cb(out, pN); out = cb(out, ") abort(); ")
        var i: u64 = 0
        loop {
            if i >= a.elements.len { break }
            out = cb(out, pN); out = cb(out, "["); out = cb_u64_digits(out, i); out = cb(out, "] = ")
            out = match emit_as(out, prog, elem, a.elements[i].expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, "; ")
            i++
        }
        out = cb(out, "(")
        out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
        out = cb(out, "){ .ptr = "); out = cb(out, pN); out = cb(out, ", .len = ")
        out = cb_u64_digits(out, a.elements.len)
        if cg_slice_rep_has_cap(elem) {
            out = cb(out, ", .cap = ")
            out = cb_u64_digits(out, a.elements.len)
        }
        return cb(out, " }; })")
    }
    // slow path: has spread — build incrementally via tk_slice_push
    // acc = accumulator slice; cap = capacity passed to tk_slice_push by reference
    var tag = buf.len
    var accN = $"_sarr{tag}"
    var capN = $"_scap{tag}"
    var out = cb(buf, "({ ")
    out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
    out = cb(out, " "); out = cb(out, accN); out = cb(out, " = { .ptr = 0, .len = 0 }; uint64_t "); out = cb(out, capN); out = cb(out, " = 0; ")
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var ae = a.elements[i]
        var spN = $"_spp{tag}_{i}"
        if ae.is_spread {
            // spread: evaluate sub-slice, loop and push each item
            var subN = $"_ssub{tag}_{i}"
            var jN = $"_sj{tag}_{i}"
            out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
            out = cb(out, " "); out = cb(out, subN); out = cb(out, " = ")
            out = match emit_expr_ctx(out, prog, checker::Void { }, ae.expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, "; ")
            out = cb(out, "for (uint64_t "); out = cb(out, jN); out = cb(out, " = 0; ")
            out = cb(out, jN); out = cb(out, " < "); out = cb(out, subN); out = cb(out, ".len; ")
            out = cb(out, jN); out = cb(out, "++) { ")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, " *"); out = cb(out, spN); out = cb(out, " = (")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "*)tk_slice_push("); out = cb(out, accN); out = cb(out, ".ptr, "); out = cb(out, accN); out = cb(out, ".len, &")
            out = cb(out, subN); out = cb(out, ".ptr["); out = cb(out, jN); out = cb(out, "], sizeof(")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "), &"); out = cb(out, capN); out = cb(out, "); if (!"); out = cb(out, spN); out = cb(out, ") abort(); ")
            out = cb(out, accN); out = cb(out, " = (")
            out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "){ .ptr = "); out = cb(out, spN); out = cb(out, ", .len = "); out = cb(out, capN); out = cb(out, " }; } ")
        } else {
            // plain element: evaluate into a temp, push
            var tmpN = $"_sitm{tag}_{i}"
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, " "); out = cb(out, tmpN); out = cb(out, " = ")
            out = match emit_as(out, prog, elem, ae.expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, "; ")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, " *"); out = cb(out, spN); out = cb(out, " = (")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "*)tk_slice_push("); out = cb(out, accN); out = cb(out, ".ptr, "); out = cb(out, accN); out = cb(out, ".len, &")
            out = cb(out, tmpN); out = cb(out, ", sizeof(")
            out = match emit_type(out, prog, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "), &"); out = cb(out, capN); out = cb(out, "); if (!"); out = cb(out, spN); out = cb(out, ") abort(); ")
            out = cb(out, accN); out = cb(out, " = (")
            out = match cg_slice_typename(out, elem) { []byte as o => o; error as err => return err }
            out = cb(out, "){ .ptr = "); out = cb(out, spN); out = cb(out, ", .len = "); out = cb(out, capN); out = cb(out, " }; ")
        }
        i++
    }
    var z = cb(out, accN)
    cb(z, "; })")
}

// emit_interp — $"…{expr}…" (self-host parity). Lower to nested tk_str_concat over the piece
// literals and the holes: pieces[0] ++ str(holes[0]) ++ pieces[1] ++ … . A piece literal is the
// SAME (tk_str){…} emission as TStrLit. A `str` hole is the str expr directly; an INTEGER hole is
// wrapped in i64_to_str/u64_to_str (by the hole's signedness) — the runtime builders. Concats nest
// left-to-right (accumulator order).
fn emit_piece_lit(buf: []byte, piece: str): []byte {
    var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
    out = cb_cstr_escaped(out, piece)
    out = cb(out, "\", ")
    out = cb_i64(out, piece.len to i64)
    cb(out, " }")
}

/**
 * Whether the static format-spec family for `fc_low` accepts a precision/width second
 * argument in its `tk_fmt_*` runtime signature.
 *
 * The hex (`x`/`X`), binary (`b`), and integer-thousands (`n` on a non-float hole) helpers
 * take ONLY the value — `tk_fmt_x_upper(v)` / `tk_fmt_x_lower(v)` / `tk_fmt_b(v)` /
 * `tk_fmt_n_i(v)`. Every other family (`f`/`e`/`g`/`p`/`d`, and `n` on a float) takes a
 * second precision-or-width argument. Emitting the second argument for a one-argument helper
 * makes the generated C fail to compile (too many arguments).
 *
 * @param fc_low  the spec's normalized (lowercased) leading format character
 * @param is_flt  true when the hole's static type is a float (f32/f64)
 * @return        true iff the selected `tk_fmt_*` runtime helper takes a precision/width arg
 */
fn fmt_family_takes_prec(fc_low: byte, is_flt: bool): bool {
    if fc_low == 120 { return false }
    if fc_low == 98 { return false }
    if fc_low == 110 && !is_flt { return false }
    true
}
/**
 * emit_interp — lower a `$"…{expr}…"` interpolation to the nested-`tk_str_concat` fold over its
 * piece literals and holes, optionally routing the fold through the
 * scope-region builder `tk_str_concat_r(str_region, …)` (0.3.1 modelo-de-memoria §9, crumb C3).
 *
 * When `str_region` is empty the fold uses the root builder `tk_str_concat` (the historical,
 * leak-until-process output) — byte-identical to the pre-C3 emission. When `str_region` names an
 * open scope region (the block that OWNS a provably block-local str binding), each accumulator is
 * bump-allocated in that region and dies at the region's exit edge, so an interpolated str produced
 * inside a `{}` participates in death-by-scope. Routing to a scope is UAF-free by construction:
 * `binding_is_block_local` proves every use of the result lands inside the region's lifetime.
 *
 * @param buf         the output byte buffer to append to
 * @param prog        the typed program (type/name lowering for the holes)
 * @param in          the typed interpolation (pieces, holes and their format specs)
 * @param str_region  the C expression of the region the result resides in, or "" for the root builder
 * @param escaping    the frame's escaping-name set, threaded into hole emission
 * @param regions     the active block-region stack, threaded into hole emission
 * @param fn_body     the enclosing function body (escape context for the holes)
 * @param dctx        the defer/coverage context threaded into hole emission
 * @return            the buffer with the interpolation fold appended
 * @throws            when a hole expression or an unrecognized format spec fails to emit
 */
fn emit_interp(buf: []byte, prog: CgProg, in: checker::TInterp, str_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var nsegs = in.pieces.len + in.holes.len
    var out = buf
    var concat_open = if str_region.len > 0 { teko::str::concat("tk_str_concat_r(", str_region, ", ") } else { "tk_str_concat(" }
    var s = 1
    loop { if s >= nsegs { break }; out = cb(out, concat_open); s++ }
    var k = 0
    loop {
        if k >= nsegs { break }
        if k >= 1 { out = cb(out, ", ") }
        if k % 2 == 0 {
            out = emit_piece_lit(out, in.pieces[k / 2])
        } else {
            var hi = k / 2
            var h = in.holes[hi]
            if hi < in.specs.len {
                var sp = in.specs[hi]
                match sp.kind {
                    checker::TFSpecStatic as fs => {
                        var spec = fs.s
                        var fc0 = if spec.len > 0 { spec[0] } else { 102 to byte }
                        var fc_low = if fc0 >= 65 && fc0 <= 90 { (fc0 to u64 + 32) to byte } else { fc0 }
                        var prec = 0
                        var has_prec = false
                        var si = 1 to u64
                        loop {
                            if si >= spec.len { break }
                            var ch = spec[si]
                            if ch >= 48 && ch <= 57 { prec = prec * 10 + (ch to i64 - 48); has_prec = true }
                            si++
                        }
                        if !has_prec { prec = if fc_low == 100 { 1 } else { 6 } }
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var prec_str = teko::i64_to_str(prec)
                        if fc_low == 102 { out = cb(out, "tk_fmt_f((double)(") }
                        else if fc_low == 101 { out = cb(out, "tk_fmt_e((double)(") }
                        else if fc_low == 103 { out = cb(out, "tk_fmt_g((double)(") }
                        else if fc_low == 112 { out = cb(out, "tk_fmt_p((double)(") }
                        else if fc_low == 100 { out = cb(out, "tk_fmt_d((int64_t)(") }
                        else if fc_low == 120 && spec.len > 0 && spec[0] == 88 { out = cb(out, "tk_fmt_x_upper((uint64_t)(") }
                        else if fc_low == 120 { out = cb(out, "tk_fmt_x_lower((uint64_t)(") }
                        else if fc_low == 98 { out = cb(out, "tk_fmt_b((uint64_t)(") }
                        else if fc_low == 110 && is_flt { out = cb(out, "tk_fmt_n_f((double)(") }
                        else if fc_low == 110 { out = cb(out, "tk_fmt_n_i((int64_t)(") }
                        else { return error { message = "codegen: unrecognized format spec" } }
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                        if fmt_family_takes_prec(fc_low, is_flt) {
                            out = cb(out, "), ")
                            out = cb(out, prec_str)
                            out = cb(out, ")")
                        } else {
                            out = cb(out, "))")
                        }
                    }
                    checker::TFSpecDynamic as fd => {
                        var is_flt = match h.type { checker::Prim as p => p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64; _ => false }
                        var is_sint = match h.type { checker::Prim as p => cg_prim_is_signed_int(p.kind); _ => false }
                        if is_flt { out = cb(out, "tk_fmt_dyn_f64((double)(") }
                        else if is_sint { out = cb(out, "tk_fmt_dyn_i64((int64_t)(") }
                        else { out = cb(out, "tk_fmt_dyn_u64((uint64_t)(") }
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                        out = cb(out, "), ")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, fd.args[0], escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                        out = cb(out, ")")
                    }
                    _ => {   // FSpecNone (explicit) — natural form
                        match h.type {
                            checker::Str => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
                            checker::Char => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
                            checker::Prim as p => {
                                if p.kind == checker::PrimKind::Bool {
                                    out = cb(out, "(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                    out = cb(out, " ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
                                } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                                    out = cb(out, "tk_ftoa((double)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                    out = cb(out, "))")
                                } else if cg_prim_is_signed_int(p.kind) {
                                    out = cb(out, "tk_i64_to_str((int64_t)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                    out = cb(out, "))")
                                } else {
                                    out = cb(out, "tk_u64_to_str((uint64_t)(")
                                    out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                    out = cb(out, "))")
                                }
                            }
                            checker::Byte => {
                                out = cb(out, "tk_u64_to_str((uint64_t)(")
                                out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                out = cb(out, "))")
                            }
                            checker::Error => {
                                out = cb(out, "(")
                                out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                                out = cb(out, ").message")
                            }
                            _ => return error { message = "codegen: interpolation hole type not supported" }
                        }
                    }
                }
            } else {   // no spec at all — natural form
                match h.type {
                    checker::Str => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
                    checker::Char => { out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
                    checker::Prim as p => {
                        if p.kind == checker::PrimKind::Bool {
                            out = cb(out, "(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            out = cb(out, " ? (tk_str){ (const tk_byte *)\"true\", 4 } : (tk_str){ (const tk_byte *)\"false\", 5 })")
                        } else if p.kind == checker::PrimKind::F32 || p.kind == checker::PrimKind::F64 {
                            out = cb(out, "tk_ftoa((double)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            out = cb(out, "))")
                        } else if cg_prim_is_signed_int(p.kind) {
                            out = cb(out, "tk_i64_to_str((int64_t)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            out = cb(out, "))")
                        } else {
                            out = cb(out, "tk_u64_to_str((uint64_t)(")
                            out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                            out = cb(out, "))")
                        }
                    }
                    checker::Byte => {
                        out = cb(out, "tk_u64_to_str((uint64_t)(")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                        out = cb(out, "))")
                    }
                    checker::Error => {
                        out = cb(out, "(")
                        out = match emit_expr_ctx(out, prog, checker::Void { }, h, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                        out = cb(out, ").message")
                    }
                    _ => return error { message = "codegen: interpolation hole type not supported" }
                }
            }
        }
        if k >= 1 { out = cb(out, ")") }
        k++
    }
    out
}

// cg_find_struct_field_type — look up the declared TypeExpr of field `fname` in the aggregate
// named `sname` from the program's type declarations. Returns the TypeExpr? (null if absent).
// (#122) A CLASS (ClassBody) shares the struct field layout, so its fields are looked up here
// too — otherwise a class field's null/sentinel initializer (`f = null`, `f = []`) never finds
// its declared `T?`/`[]T` slot type and falls through to the raw-`null` codegen error. Classes
// use the EFFECTIVE (base-inherited) field set so an optional field declared on an ancestor is
// found from a derived class's construction — matching emit_type_decl's class body.
// (C: cg_find_struct_field_type.)
fn cg_find_struct_field_type(prog: CgProg, sname: str, fname: str): @TypeExpr() | null {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => {
                if d.name == sname || checker::name_last_segment(d.name) == checker::name_last_segment(sname) {
                    match d.body {
                        parser::StructBody as sb => {
                            var j = 0
                            loop {
                                if j >= sb.fields.len { break }
                                if sb.fields[j].name == fname { return sb.fields[j].type_ann }
                                j++
                            }
                        }
                        parser::ClassBody as cb2 => {
                            var table = cg_type_table(prog)
                            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return null }
                            var j = 0
                            loop {
                                if j >= fields.len { break }
                                if fields[j].name == fname { return fields[j].type_ann }
                                j++
                            }
                        }
                        _ => { }
                    }
                }
            }
            _ => { }
        }
        i++
    }
    null
}

// emit_struct_init — W4c `Name { f = v, … }` -> a C compound literal in DECLARED field
// order:  (tk_t_<MANGLE>){ .<field> = <val>, … }. The checker already reordered
// field_names/field_vals into the struct's declared order (expr.tks), so the emitted
// fields follow the declared order. The node's `.type` is Named (a user struct -> mangle its name) or Error
// (`error { message = … }`). E2-NATIVE: `error` is now the runtime tk_error struct
// (teko_rt.h); `error { message = s }` emits tk_error_make(s) which fills the other
// diagnostic fields with zero defaults (C1.3 additive). (C: TK_TEXPR_STRUCT_INIT branch.)
fn emit_struct_init(buf: []byte, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    return emit_struct_init_framed(buf, prog, e, si, "", escaping, regions, fn_body, dctx)
}

/**
 * emit_struct_init with the auto-box ALLOCATOR parameterized (MEM Step 1). `frame` is the region a
 * proven-local binding chose (its per-function frame region, or an open block region), or "" for
 * the process root.
 *
 * When `frame` is "" the DIRECT box of a recursive back-edge rides `tk_alloc` (root → leaked, the
 * safe default, byte-identical to the pre-MEM-Step-1 output). When `frame` is a region var the
 * direct box rides `tk_region_alloc(<frame>, …)` so it is BULK-FREED when that region drops at the
 * function's / block's exit edge — used ONLY for a binding the escape check PROVED local
 * (escape.tks). A field value's OWN union-box payload (an `X | null` field) also rides `frame`
 * (emit_struct_init_literal threads it into emit_as_r_in), so a recursive node's `.next`/child box
 * dies with the node it lives in. A NESTED struct-init field VALUE (`Outer { inner = Inner {…} }`)
 * still resets to root (emit_struct_init passes ""): mixing frame + root in one value is SAFE (root
 * cells just leak), so soundness holds while the frame frees the provable subset.
 *
 * (W10b.CLASS increment 3) a CLASS instance is ARENA-PER-OBJECT: construction allocates a FRESH
 * child region (`tk_region_new`, parented to the enclosing region) and the object itself
 * (`tk_region_alloc`), then copies the ordinary compound-literal value into it — the whole
 * expression's VALUE is the resulting POINTER (reference semantics: shared identity, no copy on
 * bind/pass/return — matches emit_type_expr's unconditional class → pointer lowering). The object's
 * region is a genuine per-object arena; nothing yet drops it independently of whatever ancestor
 * region eventually drops (an honest, scoped-down deferral — see the PR notes).
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program (representation / field-type lookups)
 * @param e         the struct-init expression node (carries the resolved named/class type)
 * @param si        the typed struct-init (ordered field names + values)
 * @param frame     the region interior boxes ride, or "" for the process root
 * @param escaping  the enclosing function's escaping-name set (frame routing)
 * @param regions   the active block/frame region stack
 * @param fn_body   the enclosing function body (defer / frame-locality queries)
 * @param dctx      the enclosing defer context
 * @return          the buffer with the compound literal (or per-object class construct) appended
 * @throws          error propagated from emitting a field type or a field value
 */
fn emit_struct_init_framed(buf: []byte, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var is_class = match e.type {
        checker::Named as nm => cg_is_class_named(prog, nm.name)
        _ => false
    }
    if is_class {
        var id = buf.len to i64
        var rN = fresh_named("_clsr", id)
        var pN = fresh_named("_clsp", id)
        var out = cb(buf, "({ tk_region *")
        out = cb(out, rN)
        out = cb(out, " = tk_region_new(")
        out = cb(out, cg_enclosing_region_expr_framed(regions, frame))
        out = cb(out, "); ")
        out = match e.type { checker::Named as nm => mangle_type_name(out, "", nm.name); _ => out }
        out = cb(out, " *")
        out = cb(out, pN)
        out = cb(out, " = tk_region_alloc(")
        out = cb(out, rN)
        out = cb(out, ", sizeof(*")
        out = cb(out, pN)
        out = cb(out, ")); *")
        out = cb(out, pN)
        out = cb(out, " = ")
        out = match emit_struct_init_literal(out, prog, e, si, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        out = cb(out, "; ")
        out = cb(out, pN)
        out = cb(out, "->__region = ")   // (W10b.CLASS increment 4) retain the region handle ON the object itself
        out = cb(out, rN)
        out = cb(out, "; ")
        out = cb(out, pN)
        return cb(out, "; })")
    }
    emit_struct_init_literal(buf, prog, e, si, frame, escaping, regions, fn_body, dctx)
}

/**
 * Emit the RAW `(tk_t_<Name>){ .f = v, … }` compound literal (unwrapped) — used directly for a
 * struct value, and as the inner value copied into a class's arena-allocated box.
 *
 * Each field value is auto-boxed into `frame` when its declared type is a recursive by-value
 * back-edge (the `_bx` path) OR when a wrap routes it through `emit_as_r_in` and that wrap boxes a
 * union payload (the `_ubx` path). BOTH ride `frame` — the region the enclosing frame-local /
 * block-local binding chose — so a linked-list / tree node's interior box dies with the node it
 * lives in (a struct value's interior heap dies exactly when the struct value dies). `frame == ""`
 * (a struct-init that was NOT proven local) keeps every interior box on the process root (the safe
 * default; a leak, never a UAF).
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program (field-type / representation lookups)
 * @param e         the struct-init expression node (carries the resolved named type)
 * @param si        the typed struct-init (ordered field names + values)
 * @param frame     the region name interior boxes ride, or `""` for the process root
 * @param escaping  the enclosing function's escaping-name set (frame routing)
 * @param regions   the active block/frame region stack
 * @param fn_body   the enclosing function body (defer / frame-locality queries)
 * @param dctx      the enclosing defer context
 * @return          the buffer with the compound literal appended
 * @throws          error propagated from emitting a field type or a field value
 */
fn emit_struct_init_literal(buf: []byte, prog: CgProg, e: checker::TExpr, si: checker::TStructInit, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var name = match e.type {
        checker::Named as nm => nm.name
        // E2-NATIVE: `error { message = s }` → tk_error_make(s); the checker ensures exactly
        // one `message` field. The other diagnostic fields default to zero (C1.3 additive).
        checker::Error => {
            if si.field_vals.len != 1 { return error { message = "codegen: error value must have exactly the `message` field (internal)" } }
            var oe = cb(buf, "tk_error_make(")
            oe = match emit_expr_ctx(oe, prog, checker::Void { }, si.field_vals[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
            return cb(oe, ")")
        }
        _ => return error { message = "codegen: struct literal with a non-named type not yet supported" }
    }
    var out = cb(buf, "(")
    out = mangle_type_name(out, "", name)
    out = cb(out, "){ ")
    var i = 0
    loop {
        if i >= si.field_names.len { break }
        if i > 0 { out = cb(out, ", ") }
        out = cb(out, ".")
        out = cb_str(out, si.field_names[i])
        out = cb(out, " = ")
        // Look up the declared field type once: it drives both the sentinel/null literal forms
        // AND auto-boxing of a recursive back-edge field. (C: emit_struct_init.)
        var fv = si.field_vals[i]
        var fte_opt = cg_find_struct_field_type(prog, name, si.field_names[i])
        // auto-box: a recursive back-edge field stores a heap pointer — malloc + copy the child
        // value into it (`({ T *_bxN = tk_alloc(sizeof *_bxN); *_bxN = (val); _bxN; })`). The
        // unique id is the buffer length (the functional uniquifier).
        var boxed = match fte_opt {
            (@TypeExpr()) as fte => cg_field_boxed(prog, name, fte)
            null => false
        }
        var bxid = out.len to i64
        var bxN = fresh_named("_bx", bxid)
        if boxed {
            out = cb(out, "({ ")
            match fte_opt { (@TypeExpr()) as fte => { out = match emit_type_expr(out, prog, fte, checker::name_qualifier(name)) { []byte as o => o; error as err => return err } }; null => { } }
            out = cb(out, " *"); out = cb(out, bxN)
            // MEM Step 1: frame-local boxes ride the frame region (`tk_region_alloc(<frame>, …)`),
            // freed at the function's exit edge; everything else rides root `tk_alloc` (safe leak).
            if frame.len > 0 {
                out = cb(out, " = tk_region_alloc("); out = cb(out, frame); out = cb(out, ", sizeof *"); out = cb(out, bxN); out = cb(out, "); *"); out = cb(out, bxN); out = cb(out, " = ")
            } else {
                out = cb(out, " = tk_alloc(sizeof *"); out = cb(out, bxN); out = cb(out, "); *"); out = cb(out, bxN); out = cb(out, " = ")
            }
        }
        // Sentinel fields emit a concrete literal directly (emit_expr can't, the type being unknown):
        //   * an empty() into a `[]T` field → (tk_slice_<elem>){ .ptr = 0, .len = 0 }
        var emitted: bool = match fv.kind {
            checker::TNullLit => false
            _ => match fv.type {
                checker::Slice as sl => match sl.element {
                    checker::Void => {
                        match fte_opt {
                            (@TypeExpr()) as fte => match fte {
                                parser::SliceType as st => {
                                    out = cb(out, "(")
                                    out = match emit_type_expr(out, prog, fte, checker::name_qualifier(name)) { []byte as o => o; error as err => return err }
                                    out = cb(out, "){ .ptr = 0, .len = 0 }")
                                    true
                                }
                                _ => false
                            }
                            null => false
                        }
                    }
                    _ => false
                }
                _ => false
            }
        }
        if !emitted {
            // Build the expected resolved type from the field's type-expr and route through emit_as so a
            // bare case value WRAPS into a variant field (`.kind = <wrap>`), and a `[]case` slice REBUILDS
            // into a `[]variant` field (covariant). emit_as passes a non-variant slot (struct/enum/alias,
            // matching slice) straight through.
            //   * NAMED field          → expected = Named{last segment}
            //   * SLICE-of-user-named  → expected = Slice{element = Named{elem last segment}} (NOT a prim)
            // Other field shapes keep the plain emit.
            // `Void` is the "no expected slot" sentinel (mirrors the C `tk_type exp = {.tag = VOID}`):
            // emit plainly when nothing was built.
            var exp_t: @Type() = checker::Void { }
            match fte_opt {
                (@TypeExpr()) as fte => match fte {
                    parser::NamedType as nt => { exp_t = checker::Named { name = cg_canon_name_ns(prog, nt.path, checker::name_qualifier(name)) } }
                    parser::SliceType as st => match st.element {
                        parser::NamedType as ent => {
                            var elem = ent.path.segments[ent.path.segments.len - 1].name
                            if !cg_is_prim_name(elem) { exp_t = checker::Slice { element = checker::Named { name = cg_canon_name_ns(prog, ent.path, checker::name_qualifier(name)) } } }
                        }
                        _ => { }
                    }
                    parser::UnionType as ut => match cg_te_to_type_ns(prog, checker::name_qualifier(name), parser::UnionType { members = ut.members }) {
                        checker::Variant as va => { exp_t = checker::Variant { members = va.members } }
                        _ => { }
                    }
                    _ => { }
                }
                null => { }
            }
            match exp_t {
                checker::Void => { out = match emit_expr_ctx(out, prog, checker::Void { }, fv, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
                _ => { out = match emit_as_r_in(out, prog, checker::Void { }, exp_t, fv, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err } }
            }
        }
        if boxed { out = cb(out, "; "); out = cb(out, bxN); out = cb(out, "; })") }
        i++
    }
    cb(out, " }")
}

// emit_strlit — a TStrLit -> a tk_str compound literal with an EXPLICIT length. The
// decoded bytes may contain NUL, so we never lean on strlen/sizeof (M.1). (C: TK_TEXPR_STR.)
fn emit_strlit(buf: []byte, s: checker::TStrLit): []byte | error {
    var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
    out = cb_cstr_escaped(out, s.text)
    out = cb(out, "\", ")
    out = cb_i64(out, s.text.len to i64)
    cb(out, " }")
}

// emit_charlit — a TCharLit -> a tk_char {ptr,len} compound literal over the codepoint's static
// UTF-8 bytes (same explicit-length form as TStrLit; the bytes are read-only). (C: TK_TEXPR_CHAR.)
fn emit_charlit(buf: []byte, ch: checker::TCharLit): []byte | error {
    var out = cb(buf, "(tk_char){ (uint8_t *)\"")
    out = cb_cstr_escaped(out, ch.bytes)
    out = cb(out, "\", ")
    out = cb_i64(out, ch.bytes.len to i64)
    cb(out, " }")
}

// ---------------------------------------------------------------------------
// W5a — `if`-as-a-VALUE + IMPLICIT trailing-return.
// ---------------------------------------------------------------------------

// is_void_type — true iff a resolved Type is `void`. (C: `e->type.tag == TK_TYPE_VOID`.)
fn is_void_type(t: @Type()): bool {
    match t { checker::Void => true; _ => false }
}

// fresh_tmp_name — a fresh, UNIQUE temp name `_tk<len>` as its OWN bytes, where `len` is the
// CURRENT length of the C-source buffer. Using the buffer length as the uniquifier is purely
// functional (no global counter) and guaranteed distinct: every append grows the buffer, and
// a NESTED statement-expr is emitted only after the outer one has appended bytes, so its name
// strictly differs. The name is returned standalone (not appended) so it can be spelled at
// BOTH the declaration and the trailing read. (C: `snprintf(tmp, "_tk%zu", b->len)`.)
fn fresh_tmp_name(buf_len: i64): str {
    var nm = cb(teko::list::empty(), "_tk")
    nm = cb_i64(nm, buf_len)
    str(nm)
}

// emit_stmt_value — emit ONE branch statement in VALUE position: its trailing value is
// assigned to `sink`. A RETURN/break/continue inside a branch DIVERGES, but an `if` used as a
// SUB-expression cannot express that as a value, so it is an honest barrier here (a divergent
// branch stops the value flow). A value-carrying expr
// statement -> `<sink> = <expr>;`. Anything else (void expr-stmt, loop, binding, assign) ->
// emitted normally (no value). (C: `emit_stmt_value`.)
// `escaping`/`regions`/`fn_body` thread the enclosing block-region context: a non-tail statement
// that is itself a value-position sub-expression (or a nested if/match) gets the live context so it
// can open its own arm region — and a TBinding non-tail block-local routes to the arm region opened
// by emit_branch_value. The TAIL value (the `sink =` line) is emitted with cur_block_is_value=TRUE
// so a binding flowing into it is NOT block-local (routes to the enclosing region — the W9 trap).
fn emit_stmt_value(buf: []byte, prog: CgProg, ret_type: @Type(), s: @TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement()): []byte | error {
    match s {
        checker::TReturn => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TBreakStmt => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TContinueStmt => error { message = "codegen: control flow inside an `if` used as a sub-expression not yet supported" }
        checker::TExprStmt as es => {
            if is_void_type(es.expr.type) {
                // A non-value statement in an if-value branch: thread ret_type so an embedded return wraps.
                // Frameless (frame="") but the block-region context rides so a nested value-if opens a region.
                return emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
            }
            var out = emit_cov_lines(buf, dctx.cov, cov_collect_expr(es.expr, teko::list::empty()), indent)
            out = cb(out, indent)
            out = cb(out, sink)
            out = cb(out, " = ")
            // wrap the branch value into the if's RESULT type (`slot`) — a bare case / `[]case` / null
            // lands in the variant/optional/slice result; emit_as_r threads ret_type so a diverging
            // value-form-match arm inside the branch (`… => return e`) wraps into the FUNCTION's slot.
            // The tail value rides the ENCLOSING region context (regions threaded) so a value-if nested
            // in the tail can open its own region; a binding flowing in here is excluded by is_value=true.
            out = match emit_as_r(out, prog, ret_type, slot, es.expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            cb(out, ";\n")
        }
        _ => emit_stmt(buf, s, false, prog, ret_type, indent, "", escaping, regions, fn_body, dctx, cur_block, true)
    }
}

// emit_branch_value — emit a BRANCH block (the `if`-value then/else): all but the last
// statement normally, the LAST via emit_stmt_value (its trailing value -> `sink`). An empty
// branch yields nothing (the checker forbids a value-typed empty branch). (C: `emit_branch_value`.)
// S2/W9: when the branch has a provably BLOCK-LOCAL binding (queried with is_value=TRUE — the
// predicate EXCLUDES any binding flowing into the tail value / used as an assign-RHS), open the
// branch's OWN `_tkbr<len>` region for those NON-tail block-locals and drop it at the branch's exit.
// CRITICAL ORDERING (the W9 trap): the tail value flows to `sink` (an ENCLOSING temp) via
// emit_stmt_value FIRST, THEN the region drops — so the yielded value is fully materialized into the
// enclosing region before its non-tail siblings are freed (never a UAF). No block-local binding ⇒ no
// region ⇒ byte-identical to the pre-W9 value-branch output. (C: `emit_branch_value`.)
fn emit_branch_value(buf: []byte, prog: CgProg, ret_type: @Type(), body: []@TStatement(), slot: @Type(), sink: str, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64
    if !want_block {
        // No block-local binding: emit exactly as the pre-W9 path (no region), but with live context.
        // (W9.3) If the branch has its OWN top-level `defer`, register it and fire it AFTER the tail is
        // captured into `sink`, then drop the base so nothing leaks into later branches/functions.
        var defer_floor = dctx.defers.len
        var cur = dctx
        var out = buf
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, indent, "", escaping, regions, fn_body, cur, teko::list::empty(), false) { []byte as o => o; error as err => return err } }
            }
            i++
        }
        if body.len > 0 {
            out = match emit_stmt_value(out, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regions, fn_body, cur, teko::list::empty()) { []byte as o => o; error as err => return err }
        }
        if cur.defers.len > defer_floor {
            out = match emit_defers(out, cur.defers, defer_floor, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
        }
        return out
    }
    // Open the value-arm region (named `_tkbr<len>` — the deterministic out.len uniquifier).
    var defer_floor = dctx.defers.len   // (W9.3) defer scope base for this value-arm
    var fall = cg_append_direct_defers(dctx.defers, body)
    var region = fresh_named("_tkbr", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = tk_region_new("); out = cb(out, cg_enclosing_region_expr(regions)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true) })
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        // Non-tail statements: cur_block=body + is_value=true so block-locals route. Accumulate the
        // branch's direct defers incrementally (a defer emits nothing inline).
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, indent, "", escaping, regs2, fn_body, cur, body, true) { []byte as o => o; error as err => return err } }
        }
        i++
    }
    if body.len > 0 {
        // Materialize the TAIL value into `sink` (enclosing) BEFORE the region drop (W9 ordering).
        out = match emit_stmt_value(out, prog, ret_type, body[body.len - 1], slot, sink, indent, escaping, regs2, fn_body, cur, body) { []byte as o => o; error as err => return err }
    }
    // (W9.3) Tail is in the enclosing `sink`; fire THIS value-arm's defers (LIFO) BEFORE dropping its
    // region (idempotent + nulled for overlap safety).
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, "tk_region_drop("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

// emit_if_value — lower an `if` USED AS A SUB-VALUE to a GNU statement-expression:
//   ({ <Ctype> _tkN; if (<cond>) { <then…> } else { <else…> } _tkN; })
// Each branch assigns its trailing value to `_tkN`; `<Ctype>` is the if-node's resolved
// branch type. clang/gcc accept stmt-exprs under the host cc (the codebase already targets
// cc -std=c23). (The `if` yields the taken branch's
// trailing NORMAL value; a divergent branch is an honest stop — see emit_stmt_value.)
// (C: `emit_if_value`.)
fn emit_if_value(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, f: checker::TIfExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if !f.has_else { return error { message = "codegen: if-without-else used as a value not yet supported" } }
    // The temp name is `_tk<buflen>` frozen at the CURRENT length (the buffer is about to
    // grow). Capture it once and reuse it for the declaration AND the trailing read, so both
    // spell the same identifier.
    // S2/W9: `escaping`/`regions`/`fn_body` thread the enclosing block-region context so each branch
    // can open its OWN arm region for its block-local NON-tail bindings (emit_branch_value). The C
    // twin reads the same from its live globals (g_cg_escaping/g_cg_block_stack/g_cg_fn_body).
    var tmp = fresh_tmp_name(buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, "; if (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ") {\n")
    out = emit_cov_branch(out, dctx.cov, e.line, e.col, 0, "    ")
    out = match emit_branch_value(out, prog, ret_type, f.then_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "} else {\n")
    out = emit_cov_branch(out, dctx.cov, e.line, e.col, 1, "    ")
    out = match emit_branch_value(out, prog, ret_type, f.else_blk, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "} ")
    out = cb(out, tmp)
    cb(out, "; })")
}

// ---------------------------------------------------------------------------
// W5b — VARIANT-VALUE WRAPPING + MATCH lowering.
// ---------------------------------------------------------------------------

// fresh_named — a fresh temp `<prefix><len>` (a sibling of fresh_tmp_name for the match
// subject/result temps `_s<len>` / `_r<len>`). (C: `snprintf(subj, "_s%zu", b->len)`.)
fn fresh_named(prefix: str, n: i64): str {
    var nm = cb(teko::list::empty(), prefix)
    nm = cb_i64(nm, n)
    str(nm)
}

// ---- variant-wrap helpers (uniform over an INLINE `tk_u_…` and a NAMED variant decl) ----
// cg_var_nmem — member COUNT of a variant slot (inline Variant OR a named variant decl).
// (C: `cg_var_nmem`.)
fn cg_var_nmem(prog: CgProg, v: @Type()): i64 {
    match v {
        checker::Variant as va => va.members.len to i64
        checker::Named as nm => match cg_find_variant_decl(prog, nm.name) {
            parser::TypeDecl as d => match d.body {
                parser::VariantBody as vb => match vb.type_expr {
                    parser::UnionType as u => u.members.len to i64
                    _ => 0
                }
                _ => 0
            }
            error => 0
        }
        _ => 0
    }
}

/**
 * Member `i`'s namespace-qualified C key. An inline `Variant` reads the resolved member's
 * `cg_member_key_str`; a `Named` variant reads the decl's `i`-th member type-expr, canonicalized in
 * the variant DECL's own namespace (`name_qualifier(nm.name)`), so a named-variant member of a
 * same-bare-named type in another namespace stays distinct.
 *
 * @param prog  the typed program
 * @param v     the variant type (inline or a named variant decl)
 * @param i     the member index
 * @return      the member's qualified C key
 * @throws      when `v` is not a variant, or the member key cannot be mangled
 */
fn cg_var_mkey(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_key_str(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(nm.name))
        }
        _ => error { message = "codegen: cg_var_mkey on a non-variant type (internal)" }
    }
}

/**
 * Member `i`'s bare (pre-namespace-qualification) C key — the SELECTION twin of `cg_var_mkey`, used
 * to match a match-arm pattern's bare source spelling to the subject member it names. An inline
 * `Variant` reads `cg_member_bare_key`; a `Named` variant reads the decl member's bare texpr key.
 *
 * @param prog  the typed program
 * @param v     the variant type (inline or a named variant decl)
 * @param i     the member index
 * @return      the member's bare C key
 * @throws      when `v` is not a variant, or the member key cannot be mangled
 */
fn cg_var_mkey_bare(prog: CgProg, v: @Type(), i: i64): str | error {
    match v {
        checker::Variant as va => cg_member_bare_key(va.members[i])
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error as e => return e }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return error { message = "codegen: cg_var_mkey_bare on a non-union variant body (internal)" } }
                _ => return error { message = "codegen: cg_var_mkey_bare on a non-variant decl (internal)" }
            }
            cg_member_key_texpr_bare_str(members[i])
        }
        _ => error { message = "codegen: cg_var_mkey_bare on a non-variant type (internal)" }
    }
}

/**
 * The namespace-qualified case key a match arm must emit for `pat` over the resolved subject variant
 * `variantT`: the SINGLE SOURCE OF TRUTH that keeps a pattern's `.as.<case>` / `TK_TAG_…_<CASE>` in
 * agreement with the union field/tag the subject's own members named. The pattern's bare source
 * spelling (`cg_emit_case_key_str`) selects the matching subject member by a bare-vs-bare compare
 * (`cg_var_mkey_bare`), then that member's QUALIFIED key (`cg_var_mkey`) is emitted — so the
 * disambiguation comes from the subject's resolved type, never from where the pattern is written
 * (which may see two same-bare-named types). A key with no matching member (a builtin `error`/`null`
 * or an enum member, whose bare and qualified keys coincide) falls through to the bare spelling.
 *
 * @param prog      the typed program
 * @param variantT  the resolved subject variant type (inline or a named variant decl)
 * @param pat       the match-arm pattern selecting a member
 * @return          the qualified case key
 * @throws          when the pattern's bare key cannot be computed
 */
fn cg_case_key_qualified(prog: CgProg, variantT: @Type(), pat: @Pattern()): str | error {
    var bare = match cg_emit_case_key_str(pat) { str as s => s; error as e => return e }
    var n = cg_var_nmem(prog, variantT)
    var i = 0
    loop {
        if i >= n { break }
        var mb = match cg_var_mkey_bare(prog, variantT, i) { str as s => s; error => "" }
        if mb == bare { return cg_var_mkey(prog, variantT, i) }
        i++
    }
    bare
}

// cg_var_mtype — member i AS a Type for recursion: an inline member passes through; a NAMED
// member → a Named type (its last path segment); anything else → a Void sentinel (not a
// recursable variant). (C: `cg_var_mtype`.)
fn cg_var_mtype(prog: CgProg, v: @Type(), i: i64): @Type() {
    match v {
        checker::Variant as va => va.members[i]
        checker::Named as nm => {
            var vd = match cg_find_variant_decl(prog, nm.name) { parser::TypeDecl as d => d; error => return checker::Void { } }
            var members = match vd.body {
                parser::VariantBody as vb => match vb.type_expr { parser::UnionType as u => u.members; _ => return checker::Void { } }
                _ => return checker::Void { }
            }
            match members[i] {
                parser::NamedType as nt => checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) }
                _ => checker::Void { }
            }
        }
        _ => checker::Void { }
    }
}

// cg_is_variant_type — is `mt` a (named or inline) variant? (C: `cg_is_variant_type`.)
fn cg_is_variant_type(prog: CgProg, mt: @Type()): bool {
    match mt {
        checker::Variant => true
        checker::Named as nm => cg_named_is_variant(prog, nm.name)
        _ => false
    }
}

/**
 * cg_member_reached_via_subclass — does a variant member of type `mt` reach `vkey` through
 * SUB→BASE polymorphism: `mt` is a polymorphic base class and `vkey` names a STRICT subclass of
 * it? (0.3.1, null-union F3 "base/widen": a `Base | null` slot constructed directly from a
 * DERIVED-class expression, e.g. `let a: Animal | null = Dog::make(…)`, needs this so the member's
 * key search recognizes the upcast the value actually needs — mirrors the plain `expected: Named`
 * SUB→BASE branch of `emit_as_r`, extended to a variant MEMBER instead of the whole slot.)
 *
 * @param prog  the typed program
 * @param mt    a variant member's type
 * @param vkey  the value's own member key (its class name)
 * @return      true when `mt` is a polymorphic base `vkey` strictly subclasses
 * @since 0.3.1
 */
fn cg_member_reached_via_subclass(prog: CgProg, mt: @Type(), vkey: str): bool {
    match mt {
        checker::Named as mn => cg_is_polymorphic_base(prog, mn.name) && vkey != mn.name && cg_is_class_named(prog, vkey) && cg_subclass_reaches(prog, vkey, mn.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
        _ => false
    }
}

/**
 * cg_var_reaches — does variant `v` (TRANSITIVELY, depth bound 16) contain a member whose key ==
 * `vkey`, OR whose type is a polymorphic base `vkey` strictly subclasses
 * (`cg_member_reached_via_subclass`, 0.3.1 "base/widen")? (C: `cg_var_reaches`.)
 *
 * @param prog   the typed program
 * @param v      the variant type being searched
 * @param vkey   the member key being searched for (a case/class name)
 * @param depth  the remaining transitive-recursion budget (bounded, never unbounded)
 * @return       true when `v` reaches `vkey`, directly or through a nested/subclassed member
 * @since 0.3.0.29
 */
fn cg_var_reaches(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, depth - 1) { return true }
        }
        if cg_member_reached_via_subclass(prog, mt, vkey) { return true }
        i++
    }
    false
}

/**
 * cg_var_reaches_exact — like `cg_var_reaches`, but WITHOUT the SUB→BASE widen case
 * (`cg_member_reached_via_subclass`): does variant `v` (transitively, depth bound 16) contain a
 * member whose key equals `vkey` EXACTLY? Used by callers whose wrap implementation has no widen
 * pass of its own (e.g. `emit_variant_wrap_str`, called from `cg_wrap_elem_str`), so the
 * reachability guard never promises an upcast the callee cannot actually emit.
 *
 * @param prog   the typed program
 * @param v      the variant type being searched
 * @param vkey   the member key being searched for (a case/class name)
 * @param depth  the remaining transitive-recursion budget (bounded, never unbounded)
 * @return       true when `v` reaches `vkey` through an exact key match, directly or nested
 * @since 0.3.1
 */
fn cg_var_reaches_exact(prog: CgProg, v: @Type(), vkey: str, depth: i64): bool {
    if depth <= 0 { return false }
    var n = cg_var_nmem(prog, v)
    var i = 0
    loop {
        if i >= n { break }
        var k = match cg_var_mkey(prog, v, i) { str as s => s; error => "" }
        if k == vkey { return true }
        var mt = cg_var_mtype(prog, v, i)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches_exact(prog, mt, vkey, depth - 1) { return true }
        }
        i++
    }
    false
}

// cg_narrow_variant_widens_into — is `from` a VARIANT (inline `tk_u_…` OR a named variant decl)
// EVERY member of which is reachable in the WIDER variant slot `to`? This is the codegen-side
// widening test for an if/match arm JOIN whose inferred type is a NARROW member-pair union while
// the binding/param/return slot is the WIDER annotated variant (fix/selfhost-arm-join-widen). It
// mirrors the checker's widens_into member-by-member rule using the codegen reachability walk
// (cg_var_reaches), so no TypeTable is needed here. `to` must itself be a variant slot; a `from`
// with no members (or a non-variant) answers false so the caller falls through to the plain path.
// (C: `cg_narrow_variant_widens_into`.)
fn cg_narrow_variant_widens_into(prog: CgProg, from: @Type(), to: @Type()): bool {
    if !cg_is_variant_type(prog, to) { return false }
    var n = cg_var_nmem(prog, from)
    if n == 0 { return false }
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, from, i) { str as s => s; error => return false }
        if !cg_var_reaches(prog, to, mk, 16) { return false }
        i++
    }
    true
}

// cg_wrap_open — emit `(<variantCType>){ .tag = <TAG for member key `mkey`>, .as.<mkey> = `
// (no closing `}`). Inline `tk_u_…` vs named-decl tag spelling. (C: `cg_wrap_open`.)
fn cg_wrap_open(buf: []byte, v: @Type(), mkey: str): []byte | error {
    match v {
        checker::Variant as va => {
            var out = cb(buf, "(")
            out = match cg_variant_typename(out, va) { []byte as o => o; error as err => return err }
            out = cb(out, "){ .tag = TK_TAG_U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                out = cb(out, "_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => return err }
                out = cb_upper(out, kj)
                j++
            }
            out = cb(out, "_")
            out = cb_upper(out, mkey)
            out = cb(out, ", .as.")
            out = cb_str(out, mkey)
            return cb(out, " = ")
        }
        checker::Named as nm => {
            var out = cb(buf, "(")
            out = mangle_type_name(out, "", nm.name)
            out = cb(out, "){ .tag = TK_TAG_")
            out = cb_upper(out, cg_ns_c_key(nm.name))
            out = cb(out, "_")
            out = cb_upper(out, mkey)
            out = cb(out, ", .as.")
            out = cb_str(out, mkey)
            return cb(out, " = ")
        }
        _ => error { message = "codegen: cg_wrap_open on a non-variant type (internal)" }
    }
}

/**
 * emit_variant_wrap — wrap `value` (a bare case) into the variant `expected`, DIRECTLY or
 * TRANSITIVELY. A value that is a case of a NESTED variant member is routed through that member
 * (Named → (Type){…} → (Type|error){…}), recursing. The DIRECT pass also matches a member that is
 * a polymorphic BASE class `value`'s own class strictly subclasses
 * (`cg_member_reached_via_subclass`, 0.3.1 "base/widen" — e.g. `Animal | null` constructed from a
 * `Dog` value): that arm wraps `value` via `emit_as_r` (not a bare `emit_expr_ret`) so the
 * SUB→BASE upcast fires INSIDE the `.as.<member>` slot, matching the member's actual C
 * representation (`tk_base_<Base>`, not the raw subclass struct). PRECONDITION: value's key is
 * reachable in `expected` (the caller guards with `cg_var_reaches` and otherwise emits plainly);
 * `T? | error` is an illegal type here, so reachability is a separate predicate rather than a
 * `null` result. (C: `emit_variant_wrap`.)
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for a diverging value inside `value`)
 * @param expected  the target variant type `value` wraps into
 * @param value     the case value being wrapped
 * @param escaping  the escaping-binding set (region model)
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body
 * @param dctx      the enclosing defer context
 * @return          `buf` with the wrapped compound literal appended, or an error
 * @throws          when `value`'s key is unreachable in `expected` (an internal caller-guard bug)
 */
fn emit_variant_wrap(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => return cb(buf, "0")
                    _ => {
                        if cg_mangle_eq(expected, value.type) { return emit_expr_ret(buf, prog, ret_type, value) }
                        return cg_emit_box_construct(buf, prog, ret_type, bx, value, "", escaping, regions, fn_body, dctx)
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    match emit_variant_wrap_exact_pass(buf, prog, ret_type, expected, value, vkey, n) {
        []byte as o => return o
        error as e => return e
        null => { }
    }
    match emit_variant_wrap_widen_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) {
        []byte as o => return o
        error as e => return e
        null => { }
    }
    match emit_variant_wrap_transitive_pass(buf, prog, ret_type, expected, value, vkey, n, escaping, regions, fn_body, dctx) {
        []byte as o => return o
        error as e => return e
        null => { }
    }
    error { message = "codegen: emit_variant_wrap on an unreachable case (internal — caller must guard with cg_var_reaches)" }
}

/**
 * emit_variant_wrap_exact_pass — the DIRECT-EXACT pass of `emit_variant_wrap` (0.3.1 C3): scans
 * every member of `expected` for one whose key equals `vkey` exactly, and wraps `value` into it
 * via `emit_expr_ret`. This pass runs to completion BEFORE the SUB→BASE widen pass ever looks at
 * a member, so an exact key always wins over a widenable base member, whichever the union
 * declares first — the ordering bug this pass's isolation fixes.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for a diverging value inside `value`)
 * @param expected  the target variant type `value` wraps into
 * @param value     the case value being wrapped
 * @param vkey      `value`'s own member key
 * @param n         `expected`'s member count
 * @return          the wrapped buffer, or `null` when no member's key equals `vkey` exactly
 * @since 0.3.1
 */
fn emit_variant_wrap_exact_pass(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64): []byte | null | error {
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var out = match cg_wrap_open(buf, expected, vkey) { []byte as o => o; error as err => return err }
            out = match emit_expr_ret(out, prog, ret_type, value) { []byte as o => o; error as err => return err }
            return cb(out, " }")
        }
        i++
    }
    null
}

/**
 * emit_variant_wrap_widen_pass — the SUB→BASE widen pass of `emit_variant_wrap` (0.3.1
 * "base/widen"): runs only AFTER `emit_variant_wrap_exact_pass` finds nothing, scanning for a
 * member that is a polymorphic BASE class `vkey` strictly subclasses
 * (`cg_member_reached_via_subclass`), and wrapping `value` into it via `emit_as_r` (not a bare
 * `emit_expr_ret`) so the SUB→BASE upcast fires INSIDE the `.as.<member>` slot, matching the
 * member's actual C representation (`tk_base_<Base>`, not the raw subclass struct).
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for a diverging value inside `value`)
 * @param expected  the target variant type `value` wraps into
 * @param value     the case value being wrapped
 * @param vkey      `value`'s own member key
 * @param n         `expected`'s member count
 * @param escaping  the escaping-binding set (region model)
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body
 * @param dctx      the enclosing defer context
 * @return          the wrapped buffer, or `null` when no member is a base `vkey` subclasses
 * @since 0.3.1
 */
fn emit_variant_wrap_widen_pass(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | null | error {
    var w = 0
    loop {
        if w >= n { break }
        var wmt = cg_var_mtype(prog, expected, w)
        if cg_member_reached_via_subclass(prog, wmt, vkey) {
            var wmk = match cg_var_mkey(prog, expected, w) { str as s => s; error => "" }
            var sout = match cg_wrap_open(buf, expected, wmk) { []byte as o => o; error as err => return err }
            sout = match emit_as_r(sout, prog, ret_type, wmt, value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            return cb(sout, " }")
        }
        w++
    }
    null
}

/**
 * emit_variant_wrap_transitive_pass — the TRANSITIVE pass of `emit_variant_wrap`: scans for a
 * member that is itself a variant transitively reaching `vkey` (`cg_var_reaches`), and recurses
 * `emit_variant_wrap` into that member (Named → `(Type){…}` → `(Type|error){…}`). Runs only
 * after the exact and widen passes both find nothing.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for a diverging value inside `value`)
 * @param expected  the target variant type `value` wraps into
 * @param value     the case value being wrapped
 * @param vkey      `value`'s own member key
 * @param n         `expected`'s member count
 * @param escaping  the escaping-binding set (region model)
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body
 * @param dctx      the enclosing defer context
 * @return          the wrapped buffer, or `null` when no member transitively reaches `vkey`
 * @since 0.3.1
 */
fn emit_variant_wrap_transitive_pass(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, vkey: str, n: i64, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | null | error {
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var out = match cg_wrap_open(buf, expected, mk) { []byte as o => o; error as err => return err }
                out = match emit_variant_wrap(out, prog, ret_type, mt, value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                return cb(out, " }")
            }
        }
        j++
    }
    null
}

// emit_variant_wrap_str — like emit_variant_wrap but wraps a C-EXPRESSION STRING `cexpr` of
// resolved type `vtype` (the []U→[]T element-wise slice rebuild wraps each element, a C lvalue,
// not an AST node). IDENTICAL pass-1-direct / pass-2-transitive structure; where emit_variant_wrap
// emits the value AST node, this emits the literal string `cexpr`. PRECONDITION: vtype's key is
// reachable in `expected` (caller guards with cg_var_reaches, otherwise emits the bare element —
// `T? | error` is illegal here, so reachability is a separate predicate). (C: `emit_variant_wrap_str`.)
fn emit_variant_wrap_str(buf: []byte, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str): []byte | error {
    var vkey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var n = cg_var_nmem(prog, expected)
    // pass 1 — DIRECT: vtype's key matches a member of `expected`.
    var i = 0
    loop {
        if i >= n { break }
        var mk = match cg_var_mkey(prog, expected, i) { str as s => s; error => "" }
        if mk == vkey {
            var out = match cg_wrap_open(buf, expected, vkey) { []byte as o => o; error as err => return err }
            out = cb(out, cexpr)
            return cb(out, " }")
        }
        i++
    }
    // pass 2 — TRANSITIVE: route through a member variant that reaches vkey.
    var j = 0
    loop {
        if j >= n { break }
        var mt = cg_var_mtype(prog, expected, j)
        if cg_is_variant_type(prog, mt) {
            if cg_var_reaches(prog, mt, vkey, 16) {
                var mk = match cg_var_mkey(prog, expected, j) { str as s => s; error => "" }
                var out = match cg_wrap_open(buf, expected, mk) { []byte as o => o; error as err => return err }
                out = match emit_variant_wrap_str(out, prog, mt, vtype, cexpr) { []byte as o => o; error as err => return err }   // recurse into the member variant
                return cb(out, " }")
            }
        }
        j++
    }
    // unreachable given the caller's cg_var_reaches guard.
    error { message = "codegen: emit_variant_wrap_str on an unreachable case (internal — caller must guard with cg_var_reaches)" }
}

/**
 * cg_emit_union_present_str — wrap a present member C-EXPRESSION STRING `cexpr` (of static type
 * `mem`) into the absence/sum slot `uni`, using the slot's PHYSICAL representation. A niche union
 * stores the present member BARE (the member itself carries the representation, e.g. `error | null`
 * ≡ `tk_error`); any other sum embeds the member behind its inline-tag through `emit_variant_wrap_str`.
 * This is the string-position dual of `emit_as_r`'s present-value wrapping, for FFI result arms
 * whose value is a runtime C expression rather than a typed `TExpr`.
 *
 * @param buf    the output byte buffer
 * @param prog   the typed program (union representation classification)
 * @param uni    the target absence slot (a null-union `Variant`)
 * @param mem    the static type of the present member being wrapped
 * @param cexpr  the C expression string producing the present member value
 * @return       the buffer with the representation-correct wrapped value appended
 * @throws       error when the inline-tag wrap is asked for an unreachable member (via emit_variant_wrap_str)
 * @since 0.3.1 (null-union C6 — FFI `error | null` result arms)
 */
fn cg_emit_union_present_str(buf: []byte, prog: CgProg, uni: @Type(), mem: @Type(), cexpr: str): []byte | error {
    var va = match uni { checker::Variant as v => v; _ => return cb(buf, cexpr) }
    match cg_union_niche_member(prog, va) {
        (@Type()) as _gt9 => return cb(buf, cexpr)
        null => { }
    }
    emit_variant_wrap_str(buf, prog, uni, mem, cexpr)
}

/**
 * cg_emit_ffi_ures — emit a fixed-ABI unit-result (`tk_ffi_ures`) bound to `ures_tmp` as the Teko
 * `error | null` return value, in the return type's physical representation: the `.ok` branch is the
 * union's `null` (routed through `emit_as_r` so a niche stores its sentinel, a box stores 0, an
 * inline-tag stores its null wrap), the failure branch wraps the `tk_str` `.err` message via
 * `tk_error_make` into the union's present `error` member. Replaces the hardcoded `.present`/`.value`
 * optional shape that only fit the pre-pivot `error?` former.
 *
 * @param buf        the output byte buffer
 * @param prog       the typed program (representation classification + expression lowering)
 * @param result_ty  the Teko result type (`error | null`)
 * @param ures_tmp   the C temp name holding the bound `tk_ffi_ures`
 * @param escaping   the escaping-locals set threaded from the enclosing emit
 * @param regions    the active region frames
 * @param fn_body    the enclosing function body (defer/region resolution)
 * @param dctx       the defer context
 * @return           the buffer with the `.ok ? <null> : <error>` ternary appended
 * @throws           error propagated from the null/error arm emission
 * @since 0.3.1 (null-union C6 — FFI `error | null` result arms)
 */
fn cg_emit_ffi_ures(buf: []byte, prog: CgProg, result_ty: @Type(), ures_tmp: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var nulllit = checker::TExpr { kind = checker::TNullLit { }; type = result_ty; line = 0; col = 0 }
    var o = cb(buf, ures_tmp)
    o = cb(o, ".ok ? ")
    o = match emit_as_r(o, prog, result_ty, result_ty, nulllit, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
    o = cb(o, " : ")
    var errcexpr = teko::str::concat("tk_error_make(", ures_tmp, ".err)")
    cg_emit_union_present_str(o, prog, result_ty, checker::Error { }, errcexpr)
}

/**
 * cg_wrap_elem_str — wraps a C-EXPRESSION STRING `cexpr` (a `[]U` element of static type `vtype`)
 * into the slice element target `T` (= `expected`), for the `emit_as` slice-covariance rebuild.
 * Uniform with `emit_as`'s value-position wrapping: `T` OPTIONAL present-wraps
 * (`(tk_opt_<inner>){ .present = true, .value = <recurse into inner> }`); `T` a CONTRACT
 * (interface/trait) the element conforms to (W10b.D3) upcasts into the fat pointer
 * (`.data`/`.vtable`), exactly like `emit_as`'s value-position upcast; `T` a VARIANT the
 * element's key reaches EXACTLY variant-wraps via `emit_variant_wrap_str` (guarded with
 * `cg_var_reaches_exact`, not the widened `cg_var_reaches`, since `emit_variant_wrap_str` has no
 * SUB→BASE widen pass of its own); otherwise `cexpr` is emitted bare. (C: `cg_wrap_elem_str`.)
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program
 * @param expected  the slice element target type `T`
 * @param vtype     the source element's static type `U`
 * @param cexpr     the C-expression string for the element value
 * @return          `buf` with the wrapped element appended
 */
fn cg_wrap_elem_str(buf: []byte, prog: CgProg, expected: @Type(), vtype: @Type(), cexpr: str): []byte | error {
    match expected {
        checker::Named as en => match cg_wrap_elem_str_contract(buf, prog, en, vtype, cexpr) {
            []byte as o => return o
            null => { }
            error as e => return e
        }
        _ => { }
    }
    var ukey = match cg_member_key_str(vtype) { str as s => s; error => "" }
    var wrappable = match expected {
        checker::Variant => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        checker::Named => ukey != "" && cg_var_reaches_exact(prog, expected, ukey, 16)
        _ => false
    }
    if wrappable {
        return emit_variant_wrap_str(buf, prog, expected, vtype, cexpr)
    }
    cb(buf, cexpr)
}

/**
 * cg_wrap_elem_str_contract — the CONTRACT branch of `cg_wrap_elem_str` (W10b.D3): when `en` is
 * an interface/trait and `vtype` is a conforming class, upcasts `cexpr` into `en`'s fat pointer
 * (`.data`/`.vtable`) — how a homogeneous `[]Circle` value covariant-rebuilds into a `[]Shape`
 * slot. Returns `null` when `en`/`vtype` do not form a contract-upcast pair, so the caller falls
 * through to the variant/bare cases.
 *
 * @param buf    the output byte buffer
 * @param prog   the typed program
 * @param en     the target named type (tested for interface/trait)
 * @param vtype  the source element's static type
 * @param cexpr  the C-expression string for the element value
 * @return       `buf` with the upcast fat pointer appended, or `null` when not a contract upcast
 */
fn cg_wrap_elem_str_contract(buf: []byte, prog: CgProg, en: checker::Named, vtype: @Type(), cexpr: str): []byte | null | error {
    if !(cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name)) { return null }
    match vtype {
        checker::Named as vn => {
            if !cg_is_class_named(prog, vn.name) { return null }
            var o = cb(buf, "(")
            o = mangle_type_name(o, "", en.name)
            o = cb(o, "){ .data = (void *)(")
            o = cb(o, cexpr)
            o = cb(o, "), .vtable = tk_vt_")
            o = cb_tysym(o, vn.name)
            o = cb(o, "_")
            o = cb_tysym(o, en.name)
            cb(o, " }")
        }
        _ => null
    }
}

// emit_host_ffi — lift a host-FFI primitive's fixed-ABI result (teko_rt.h) into the program's
// result type. The runtime can't name the generated sum/optional/slice structs (its header is
// included before them), so codegen builds them here: call the primitive, then construct
// `e.type` from the result's header-knowable fields (`error` is its message str). Single-eval —
// the result struct is bound to one temp, then both arms read it. `kind` selects the shape:
// "sres"(str|error) "ures"(error?) "slres"([]str|error) "u64res"(u64|error) "args" "run".
// (C: `emit_host_ffi`.)
fn emit_host_ffi(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, kind: str, rtfn: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var t = $"_h{buf.len}"   // unique temp per call site
    var str_t = checker::Str { }
    var err_t = checker::Error { }

    // args() -> []str : ({ uint64_t _hNn; tk_str *_hNp = tk_rt_args(&_hNn); (tk_slice_str){…}; })
    if kind == "args" {
        var o = cb(buf, "({ uint64_t ")
        o = cb(o, t)
        o = cb(o, "n; tk_str *")
        o = cb(o, t)
        o = cb(o, "p = ")
        o = cb(o, rtfn)
        o = cb(o, "(&")
        o = cb(o, t)
        o = cb(o, "n); (")
        o = match cg_slice_typename(o, str_t) { []byte as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, "p, .len = ")
        o = cb(o, t)
        return cb(o, "n }; })")
    }
    // (C7.1a) bytes_from_ptr(ptr,u64) -> []byte : a fixed-ABI tk_ffi_bytes {ptr,len} lifted to the
    // generated tk_slice_byte (same {ptr,len} layout; the runtime can't name the generated slice).
    if kind == "bytes" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ tk_ffi_bytes ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, ", ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "); (")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, ".ptr, .len = ")
        o = cb(o, t)
        return cb(o, ".len }; })")
    }
    // run([]str) -> i32 : the primitive takes ptr+len (no generated slice type). Single-eval argv.
    if kind == "run" {
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, str_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, ".ptr, ")
        o = cb(o, t)
        return cb(o, ".len); })")
    }

    // C7.12 — ures_byteslice: write_file_bytes(path: str, data: []byte) -> error?.
    // The C function takes (path, ptr, len); the Teko []byte slice carries both in a struct,
    // so we bind the slice to a temp and pass .ptr + .len separately.
    if kind == "ures_byteslice" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_ures ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, ", ")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = match cg_emit_ffi_ures(o, prog, e.type, teko::str::concat(t, "r"), escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // ROUND 0 — sres_byteslice: str_from_utf8(bytes: []byte) -> str | error. The C function
    // takes (ptr, len); the Teko []byte slice carries both in a struct. Same VARIANT-wrap shape
    // as the generic "sres" branch below, but the single arg is a []byte split into ptr+len
    // (mirrors "ures_byteslice"'s arg handling, wrapping a str|error result instead of error?).
    if kind == "sres_byteslice" {
        var byte_t = checker::Byte { }
        var o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_sres ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = cb(o, t)
        o = cb(o, "r.ok ? ")
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}r.value") { []byte as r => r; error as err => return err }
        o = cb(o, " : ")
        o = match emit_variant_wrap_str(o, prog, e.type, err_t, teko::str::concat("tk_error_make(", $"{t}r", ".err)")) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // The struct-returning host FFI: bind the fixed-ABI result, then lift per result shape.
    var resty = if kind == "sres" { "tk_ffi_sres" } else if kind == "ures" { "tk_ffi_ures" } else if kind == "slres" { "tk_ffi_slres" } else { "tk_ffi_u64res" }
    var o = cb(buf, "({ ")
    o = cb(o, resty)
    o = cb(o, " ")
    o = cb(o, t)
    o = cb(o, " = ")
    o = cb(o, rtfn)
    o = cb(o, "(")
    var i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { o = cb(o, ", ") }
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        i++
    }
    o = cb(o, "); ")

    if kind == "ures" {
        o = match cg_emit_ffi_ures(o, prog, e.type, t, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // VARIANT results: ok → wrap the value arm ; !ok → wrap the error arm (a tk_error).
    o = cb(o, t)
    o = cb(o, ".ok ? ")
    if kind == "sres" {
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}.value") { []byte as r => r; error as err => return err }
    } else if kind == "u64res" {
        o = match emit_variant_wrap_str(o, prog, e.type, checker::Prim { kind = checker::PrimKind::U64 }, $"{t}.value") { []byte as r => r; error as err => return err }
    } else {
        var slice_t = checker::Slice { element = checker::Str { } }
        // cexpr has literal braces → built via concat ($-interpolation has no brace escape).
        var sx = teko::str::concat("(tk_slice_str){ .ptr = ", t, teko::str::concat(".ptr, .len = ", t, ".len }"))
        o = match emit_variant_wrap_str(o, prog, e.type, slice_t, sx) { []byte as r => r; error as err => return err }
    }
    o = cb(o, " : ")
    // E2-NATIVE: wrap the runtime's `.err` tk_str (message) into a full tk_error via tk_error_make.
    // u64res carries no message (not-found is the only failure) → empty message tk_error_make.
    var eexpr = if kind == "u64res" { "tk_error_make((tk_str){0})" } else { teko::str::concat("tk_error_make(", t, ".err)") }
    o = match emit_variant_wrap_str(o, prog, e.type, err_t, eexpr) { []byte as r => r; error as err => return err }
    return cb(o, "; })")
}

/**
 * Report whether two resolved types produce the SAME generated C type name — the byte-free twin
 * of the retired `cg_type_mangle_eq`, which built two throwaway mangle strings only to compare
 * them (AL4a-2, following the `qualify_eq` precedent). It decides `mangle(a) == mangle(b)`
 * byte-for-byte WITHOUT allocating, mirroring `cg_opt_mangle`/`cg_opt_key` exactly: a type whose
 * mangle would error (an inline `Variant`, a `Void`-inner optional/slice, an unsupported shape)
 * has the empty key `""`, so two such types compare equal and an erroring type never equals a
 * well-formed one. This is MANGLE-equality, NOT `type_eq`: two DISTINCT types can share a C name
 * (the #109 bare-last-segment case — `teko::io::Reader` and `teko::emit::Reader` both mangle to
 * `Reader`), and this predicate returns true for them exactly as the string compare did.
 *
 * @param a  the first resolved type
 * @param b  the second resolved type
 * @return   true iff the two types mangle to the identical C type name
 */
fn cg_mangle_eq(a: @Type(), b: @Type()): bool {
    var ea = cg_mangle_errors(a)
    var eb = cg_mangle_errors(b)
    if ea || eb { return ea && eb }
    cg_mangle_bytes_eq(a, b)
}

/**
 * Report whether a type's mangle would ERROR (making its `cg_opt_key` the empty string `""`),
 * mirroring the error arms of `cg_opt_mangle` precisely: an inline `Variant` and any unsupported
 * shape error, and a `Slice` errors when its element is the `Void` sentinel or itself errors.
 * Every leaf (`Prim`, `Byte`, `Char`, `Str`, `Error`, `Named`) mangles cleanly.
 *
 * @param t  the resolved type
 * @return   true iff `cg_opt_mangle` would return an error for `t`
 */
fn cg_mangle_errors(t: @Type()): bool {
    match t {
        checker::Prim => false
        checker::Byte => false
        checker::Char => false
        checker::Str => false
        checker::Error => false
        checker::Named => false
        checker::Slice as sl => match sl.element {
            checker::Void => true
            _ => cg_mangle_errors(sl.element)
        }
        _ => true
    }
}

/**
 * Compare the mangles of two types already known to mangle cleanly, byte-for-byte and without
 * allocating. `Slice` prepends `slice_` and recurses; a `Named` mangles to its bare last path
 * segment; every other leaf mangles to a fixed literal. Because a `Named`'s arbitrary segment text
 * can coincide with a composite's rendered form (`Named "slice_str"` and `[]str` both yield
 * `slice_str`), any comparison that touches a `Named` is routed through
 * `cg_mangle_type_matches_name`, which folds the other side's WHOLE mangle against the segment
 * bytes — giving true byte-identity with the old string compare, not a mere constructor match.
 *
 * @param a  the first resolved type (mangles cleanly)
 * @param b  the second resolved type (mangles cleanly)
 * @return   true iff `mangle(a)` equals `mangle(b)` byte-for-byte
 */
fn cg_mangle_bytes_eq(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => cg_mangle_type_matches_name(b, na.name)
        checker::Slice as sa => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice as sb => cg_mangle_bytes_eq(sa.element, sb.element)
            _ => false
        }
        _ => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice => false
            _ => cg_leaf_literal_eq(a, b)
        }
    }
}

/**
 * Compare two FIXED leaf types (`Prim`, `Byte`, `Char`, `Str`, `Error`) by their mangle literal.
 * These literals are compile-time constants (no allocation) and never error, so the `str`
 * comparison is a pure byte compare of two literals.
 *
 * @param a  the first fixed-leaf type
 * @param b  the second fixed-leaf type
 * @return   true iff both mangle to the same fixed literal
 */
fn cg_leaf_literal_eq(a: @Type(), b: @Type()): bool {
    match cg_opt_mangle_str(a) {
        str as sa => match cg_opt_mangle_str(b) { str as sb => sa == sb; error => false }
        error => false
    }
}

/**
 * Report whether a cleanly-mangling type's full mangle equals the bare last segment of `name`,
 * byte-for-byte and allocation-free. Walks `t` while advancing a cursor over `name`'s last
 * `::`-segment: a match holds exactly when the walk consumes the segment to its end and no further.
 *
 * @param t     the resolved type whose mangle is folded against the segment
 * @param name  the (possibly canonical) name whose bare last segment is the target text
 * @return      true iff `mangle(t)` equals `name`'s last segment byte-for-byte
 */
fn cg_mangle_type_matches_name(t: @Type(), name: str): bool {
    var start = cg_name_last_segment_offset(name)
    var end = cg_mangle_consume(t, name, start)
    end >= 0 && (end to u64) == name.len
}

/**
 * Advance an allocation-free cursor over `name` by matching the mangle of `t` against the bytes at
 * `off`, returning the new offset or `-1` on any mismatch/overrun. `Slice` consumes `slice_` then
 * recurses on its element; a `Named` matches its own bare last segment; every fixed leaf matches
 * its literal. Mirrors the exact byte sequence `cg_opt_mangle` would emit.
 *
 * @param t     the cleanly-mangling type to consume
 * @param name  the byte source the cursor walks
 * @param off   the current cursor offset into `name`
 * @return      the offset just past `mangle(t)`, or `-1` on mismatch
 */
fn cg_mangle_consume(t: @Type(), name: str, off: u64): i64 {
    match t {
        checker::Slice as sl => {
            var o2 = cg_match_literal(name, off, "slice_")
            if o2 < 0 { -1 } else { cg_mangle_consume(sl.element, name, o2 to u64) }
        }
        checker::Named as nm => cg_match_segment(name, off, nm.name)
        _ => match cg_opt_mangle_str(t) {
            str as lit => cg_match_literal(name, off, lit)
            error => -1
        }
    }
}

/**
 * Match the literal `lit` against `name` starting at `off`, returning `off + lit.len` on an exact
 * byte match or `-1` on mismatch/overrun. Allocation-free.
 *
 * @param name  the byte source
 * @param off   the cursor offset to match at
 * @param lit   the literal expected at `off`
 * @return      the offset just past `lit`, or `-1` if it does not match there
 */
fn cg_match_literal(name: str, off: u64, lit: str): i64 {
    if off + lit.len > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= lit.len { break }
        if name[off + i] != lit[i] { return -1 }
        i++
    }
    (off + lit.len) to i64
}

/**
 * Match the bare last segment of `other` against `name` starting at `off`, returning the offset
 * just past it on an exact byte match or `-1` otherwise. The `Named`-leaf twin of
 * `cg_match_literal`: it compares the segment in place (from `other`'s last-segment offset)
 * without materializing it.
 *
 * @param name   the byte source the cursor walks
 * @param off    the cursor offset to match at
 * @param other  the name whose bare last segment is the expected text
 * @return       the offset just past the segment, or `-1` if it does not match there
 */
fn cg_match_segment(name: str, off: u64, other: str): i64 {
    var s = cg_name_last_segment_offset(other)
    var seglen = other.len - s
    if off + seglen > name.len { return -1 }
    var i: u64 = 0
    loop {
        if i >= seglen { break }
        if name[off + i] != other[s + i] { return -1 }
        i++
    }
    (off + seglen) to i64
}

/**
 * The byte offset at which `name`'s bare last `::`-segment begins — `0` for a bare name,
 * `<last "::"> + 2` for a canonical `ns::Name`. The allocation-free offset form of
 * `checker::name_last_segment` (which copies the segment out); mirrors its `::`-scan exactly so
 * the two agree byte-for-byte.
 *
 * @param name  the (possibly canonical) name to scan
 * @return      the offset where the bare last segment starts
 */
fn cg_name_last_segment_offset(name: str): u64 {
    var last_sep: i64 = -1
    var i: u64 = 0
    loop {
        if i + 1 >= name.len { break }
        if name[i] == b':' && name[i + 1] == b':' { last_sep = i to i64 }
        i++
    }
    if last_sep < 0 { 0 } else { (last_sep to u64) + 2 }
}

// emit_as — emit `value` into a slot whose EXPECTED type is `expected`. When `expected` is
// a (named) variant and `value`'s type is one of its case members, WRAP the value into the
// variant's `tag + union` representation:
//   (tk_t_<Variant>){ .tag = TK_TAG_<UPPER Variant>_<UPPER member>, .as.<member> = <value> }
// else emit the value plainly. The tag suffix + union field are spelled EXACTLY as
// emit_type_decl spells them (cb_upper tag; the member's bare name field), so wrap + decl
// agree. This synthesizes the tag + union carrier — the W4c-deferred variant-value layer. (C: `emit_as`.)
// emit_as — wrap `value` into `expected` (the ret_type-less convenience form: most callers are not
// in a return context, so a diverging value-form-match arm inside `value` cannot occur). The C uses
// a `g_cg_ret_type` STATIC for that; here ret_type is THREADED (Teko has no module-mutable), so a
// return-context caller (binding/assign/return/tail/arm sink) uses emit_as_r to pass it down.
fn emit_as(buf: []byte, prog: CgProg, expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    emit_as_r(buf, prog, checker::Void { }, expected, value, escaping, regions, fn_body, dctx)
}

/** cg_slice_param_type — the expected `checker::Slice` for a `[]…` PARAM (or a `[]…` struct FIELD)
    whose annotation is `slt`, used by emit_as to coerce a bare-slice ARG (#265). A `[]…` slot never
    reaches emit_as via the Named param branch, so this is the seam that routes it there.
    A `NamedType` element → the canonical `Slice { Named }` so a covariant `[]Case`→`[]Variant` arg
    (e.g. `[]Return`→`[]@Statement()`) rebuilds element-wise. Any other element → the arg's own type
    (emit_as no-ops when the mangle matches). The checker keeps such widening args NARROW
    (arg_keeps_narrow_type), so the element mismatch is visible here. `arg_type` is the argument's
    resolved slice type. */
fn cg_slice_param_type(prog: CgProg, slt: parser::SliceType, arg_type: @Type()): @Type() {
    match slt.element {
        parser::NamedType as nt => checker::Slice { element = checker::Named { name = cg_canon_name(prog, nt.path.segments[nt.path.segments.len - 1].name) } }
        _ => arg_type
    }
}

/**
 * cg_emit_box_construct — emit the BOX-IN-ARENA construction of a non-null union payload: bump-alloc
 * one arena cell for `inner`, copy the coerced value into it, and yield the cell handle, as a GNU
 * statement-expression `({ <inner> *_ubxN = tk_region_alloc(<region>, sizeof(<inner>)); *_ubxN =
 * (<value>); _ubxN; })`. The result is the 8-byte handle stored in a boxed `T | null` slot; the
 * `null` case never calls this (it emits a bare `0`, zero heap). When `box_region` is empty the
 * cell rides the root region; otherwise it rides the caller-selected local region.
 *
 * @param prog      the typed program
 * @param ret_type  the enclosing return type (threaded for a diverging value-form inside `value`)
 * @param inner     the resolved boxed payload type `X` of the `X | null` union
 * @param value     the resolved payload expression being boxed
 * @param box_region the chosen region name, or `""` for the root region
 * @param escaping  the escaping-binding set (region model)
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body (defer/region resolution)
 * @param dctx      the defer context
 * @return          `buf` with the box-construct statement-expression appended, or an error
 * @throws          error when the inner type or the payload value cannot be emitted
 * @since 0.3.0.30 (null-union C4)
 */
/**
 * cg_emit_inline_null — emit the INLINE-TAG `null` value of a null-bearing union that is neither
 * niche nor box: `(tk_u_<keys>){ .tag = …_NULL, .as.null = 0 }`. The niche/box null (a zero word or
 * handle) is emitted by its own `emit_as_r` arm; a bare-null LITERAL reaching the inline-tag rail
 * carries the sentinel `null`-optional type (not the union), so the value-key reachability wrap
 * cannot key it — this is the seam that lets an inline-tag `T | null` local be reassigned `= null`,
 * a `-> T | null` return one, and a `null` be written into an inline-tag struct field.
 *
 * @param buf       the emit buffer
 * @param expected  the null-bearing inline-tag union slot type
 * @return          `buf` with the inline-tag null compound literal appended
 * @throws          when the union typename cannot be emitted
 * @since 0.3.0.30 (nullfield)
 */
fn cg_emit_inline_null(buf: []byte, expected: @Type()): []byte | error {
    var o = match cg_wrap_open(buf, expected, "null") { []byte as r => r; error as e => return e }
    cb(o, "0 }")
}

/**
 * cg_value_already_boxed — is `vt` ALREADY a box-optional whose boxed payload mangles identically to
 * `bx` (the target `X | null`'s payload `X`)? True only for another `X | null` value — an existing heap
 * handle to pass through unchanged; FALSE for the bare payload `X` (including an inline union widening
 * INTO the optional), which must be boxed. This distinguishes the pass-through case from the widen-and-
 * box case that a raw `cg_mangle_eq(expected, value.type)` conflated: an inline `X | null` and its inner
 * inline union `X` both have an erroring (empty-key) mangle, so `cg_mangle_eq` reported them equal and
 * the payload was copied straight into the pointer slot instead of being boxed.
 *
 * @param prog  the typed program (box-member classification)
 * @param bx    the target box-optional's payload type `X`
 * @param vt    the source value's resolved type
 * @return      true iff `vt` is itself a box-optional whose payload mangles identically to `bx`
 */
fn cg_value_already_boxed(prog: CgProg, bx: @Type(), vt: @Type()): bool {
    match vt {
        checker::Variant as vv => match cg_union_box_member(prog, vv) {
            (@Type()) as vbx => cg_mangle_eq(bx, vbx)
            null => false
        }
        _ => false
    }
}

fn cg_emit_box_construct(buf: []byte, prog: CgProg, ret_type: @Type(), inner: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var bxN = fresh_named("_ubx", buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, inner) { []byte as o => o; error as e => return e }
    out = cb(out, " *")
    out = cb(out, bxN)
    out = cb(out, " = tk_region_alloc(")
    out = cb(out, if box_region.len > 0 { box_region } else { "tk_region_root()" })
    out = cb(out, ", sizeof(")
    out = match emit_type(out, prog, inner) { []byte as o => o; error as e => return e }
    out = cb(out, ")); *")
    out = cb(out, bxN)
    out = cb(out, " = ")
    out = match emit_as_r_in(out, prog, ret_type, inner, value, box_region, escaping, regions, fn_body, dctx) { []byte as o => o; error as e => return e }
    out = cb(out, "; ")
    out = cb(out, bxN)
    cb(out, "; })")
}

/**
 * Wraps `value` into its `expected` type's C representation — variant (niche/box/inline), optional
 * present-wrap, or (0.3.1 — owner ruling 2026-07-24) a `ref` BINDING'S `Reference` target: a bare
 * (non-`Reference`) `value` is the mutable-source alias path `type_ref_binding_value` (checker)
 * already validated, so it is address-taken here (`&value`); an already-`Reference` `value` is the
 * forwarding path (another reference) and emits plainly. Falls through to a plain expression emit
 * when `expected` needs no wrapping at all.
 *
 * @param buf       the output byte buffer
 * @param prog      the typed program (representation classification)
 * @param ret_type  the enclosing function's return type (threaded for a diverging sub-value)
 * @param expected  the target type `value` is wrapped into
 * @param value     the typed value to wrap
 * @param escaping  the enclosing function's escaping-name set (frame routing)
 * @param regions   the active block/frame region stack
 * @param fn_body   the enclosing function's body (frame-locality queries)
 * @param dctx      the enclosing `defer` context
 * @return          the buffer with the representation-correct wrapped value appended
 */
fn emit_as_r(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    emit_as_r_in(buf, prog, ret_type, expected, value, "", escaping, regions, fn_body, dctx)
}

fn emit_as_r_in(buf: []byte, prog: CgProg, ret_type: @Type(), expected: @Type(), value: checker::TExpr, box_region: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match expected {
        checker::Reference => {
            match value.type {
                checker::Reference => return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                _ => {
                    var o = cb(buf, "&")
                    return emit_expr_ctx(o, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
        }
        _ => { }
    }
    match expected {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match value.kind {
                    checker::TNullLit => return cg_emit_niche_null(buf, prog, nx)
                    _ => return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as bx => {
                match value.kind {
                    checker::TNullLit => return cb(buf, "0")
                    _ => {
                        if cg_value_already_boxed(prog, bx, value.type) { return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx) }
                        return cg_emit_box_construct(buf, prog, ret_type, bx, value, box_region, escaping, regions, fn_body, dctx)
                    }
                }
            }
            null => { }
        }
        _ => { }
    }
    match expected {
        checker::Variant as iva => match value.kind {
            checker::TNullLit => if cg_variant_has_null(iva) { return cg_emit_inline_null(buf, expected) }
            _ => { }
        }
        _ => { }
    }
    // SLICE slot: the sentinel/untyped empty slice (teko::list::empty(), element = Void) becomes
    // this slot's concrete empty literal; a concrete slice value passes through.
    match expected {
        checker::Slice as sexp => {
            match sexp.element {
                checker::Void => { }   // sentinel expected — fall through (should not occur at a real slot)
                _ => {
                    var val_sentinel = match value.type {
                        checker::Slice as svt => match svt.element { checker::Void => true; _ => false }
                        _ => false
                    }
                    if val_sentinel {
                        var so = cb(buf, "(")
                        so = match cg_slice_typename(so, sexp.element) { []byte as o => o; error as err => return err }
                        return cb(so, "){ .ptr = 0, .len = 0 }")
                    }
                    // COVARIANT `[]U` → `[]T` (e.g. `push(empty(), Prim)` = []Prim flowing into a []Type
                    // slot): tk_slice_U and tk_slice_T are DISTINCT C structs, so REBUILD element-wise,
                    // wrapping each U into T (the same case→variant wrap emit_variant_wrap_str does, on
                    // each C element lvalue). A same-mangle element passes straight through.
                    var concrete_diff = match value.type {
                        checker::Slice as svt => match svt.element {
                            checker::Void => false   // sentinel handled above
                            _ => !cg_mangle_eq(sexp.element, svt.element)
                        }
                        _ => false
                    }
                    if concrete_diff {
                        var elemU = match value.type { checker::Slice as svt => svt.element; _ => checker::Void { } }
                        var T = sexp.element
                        var U = elemU
                        // unique temp names from the buffer length (the functional uniquifier).
                        var baseN = buf.len to i64
                        var sv = fresh_named("_cv", baseN)
                        var rp = fresh_named("_cp", baseN + 1)
                        var ri = fresh_named("_ci", baseN + 2)
                        var o = cb(buf, "({ ")
                        o = match cg_slice_typename(o, U) { []byte as r => r; error as err => return err }
                        o = cb(o, " "); o = cb(o, sv); o = cb(o, " = ")
                        o = match emit_expr_ctx(o, prog, ret_type, value, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
                        o = cb(o, "; ")
                        o = match emit_type(o, prog, T) { []byte as r => r; error as err => return err }
                        o = cb(o, " *"); o = cb(o, rp); o = cb(o, " = (")
                        o = match emit_type(o, prog, T) { []byte as r => r; error as err => return err }
                        o = cb(o, " *)malloc("); o = cb(o, sv); o = cb(o, ".len * sizeof(")
                        o = match emit_type(o, prog, T) { []byte as r => r; error as err => return err }
                        o = cb(o, ")); if ("); o = cb(o, rp); o = cb(o, " == 0 && "); o = cb(o, sv); o = cb(o, ".len) abort(); ")
                        o = cb(o, "for (uint64_t "); o = cb(o, ri); o = cb(o, " = 0; "); o = cb(o, ri); o = cb(o, " < "); o = cb(o, sv); o = cb(o, ".len; "); o = cb(o, ri); o = cb(o, " += 1) { ")
                        o = cb(o, rp); o = cb(o, "["); o = cb(o, ri); o = cb(o, "] = ")
                        var elem = teko::str::concat(sv, teko::str::concat(".ptr[", teko::str::concat(ri, "]")))
                        // wrap each U-element into T: present-wrap when T is OPTIONAL, variant-wrap when
                        // U's key reaches the T variant, else the bare element (cg_wrap_elem_str — the
                        // twin of the C helper; mirrors emit_as's value-position wrapping per element).
                        o = match cg_wrap_elem_str(o, prog, T, U, elem) { []byte as r => r; error as err => return err }
                        o = cb(o, "; } (")
                        o = match cg_slice_typename(o, T) { []byte as r => r; error as err => return err }
                        o = cb(o, "){ .ptr = "); o = cb(o, rp); o = cb(o, ", .len = "); o = cb(o, sv); o = cb(o, ".len }; })")
                        return o
                    }
                    return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
                }
            }
        }
        _ => { }
    }
    // (W10b.D3) CONTRACT (interface) slot: a CLASS instance upcasts into the fat pointer — the
    // object pointer rides `data`, the (class, contract) static vtable rides `vtable`. An
    // already-contract-typed value falls through and is emitted plainly (same C typedef).
    match expected {
        checker::Named as en => {
            if cg_is_interface_named(prog, en.name) || cg_is_trait_named(prog, en.name) {
                match value.type {
                    checker::Named as vn => {
                        if cg_is_class_named(prog, vn.name) {
                            var io = cb(buf, "(")
                            io = mangle_type_name(io, "", en.name)
                            io = cb(io, "){ .data = ")
                            // (#98) if the value is ALREADY a base fat pointer (`tk_base_<vn>`, a
                            // polymorphic base that ALSO implements this interface), its object
                            // pointer already lives in `.data` — extract it (`(<v>).data`) rather
                            // than `(void *)(<v>)` (which would cast the whole two-word struct).
                            if cg_is_polymorphic_base(prog, vn.name) {
                                io = cb(io, "(")
                                io = match emit_expr_ctx(io, prog, ret_type, value, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
                                io = cb(io, ").data")
                            } else {
                                io = cb(io, "(void *)(")
                                io = match emit_expr_ctx(io, prog, ret_type, value, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
                                io = cb(io, ")")
                            }
                            io = cb(io, ", .vtable = tk_vt_")
                            io = cb_tysym(io, vn.name)
                            io = cb(io, "_")
                            io = cb_tysym(io, en.name)
                            return cb(io, " }")
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    // (#98) SUB→BASE upcast: a raw class instance upcasts into the base's fat pointer `tk_base_<B>`
    // — the object pointer rides `.data`, the (subclass, base) static vtable rides `.vtable`.
    // Fires when `expected` is a polymorphic base B and the value is either a STRICT subclass of B
    // (`Dog`→`Animal`) OR a RAW construction of B itself (a factory's `return B{}` into the base
    // ret slot) — a value ALREADY of the base fat-pointer type (a bound base local: TVar/field/etc)
    // passes through unwrapped (its C rep is already `tk_base_<B>`). The concrete class picks the
    // vtable, so a subclass override dispatches correctly through the base value.
    match expected {
        checker::Named as ben => {
            if cg_is_polymorphic_base(prog, ben.name) {
                match value.type {
                    checker::Named as bvn => {
                        if cg_is_class_named(prog, bvn.name) {
                            var is_strict_sub = bvn.name != ben.name && cg_subclass_reaches(prog, bvn.name, ben.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
                            var is_raw_self = bvn.name == ben.name && match value.kind { checker::TStructInit => true; _ => false }
                            if is_strict_sub || is_raw_self {
                                var bo = cb_tysym(cb(buf, "(tk_base_"), ben.name)
                                bo = cb(bo, "){ .data = (void *)(")
                                bo = match emit_expr_ctx(bo, prog, ret_type, value, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
                                bo = cb_tysym(cb(cb_tysym(cb(bo, "), .vtable = tk_vt_"), bvn.name), "_"), ben.name)
                                return cb(bo, " }")
                            }
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    // (fix/selfhost-arm-join-widen) ARM-JOIN WIDEN: an `if`/`match` USED AS A VALUE whose two arms
    // are DIFFERENT members of a WIDER annotated variant. The checker's type_join infers the NARROW
    // member-pair union (`A | B`) as the if/match's type; the slot `expected` is the WIDER variant.
    // Emitting the if/match plainly would type its C temp as the narrow `tk_u_A_B` and land it in the
    // wider `tk_t_Expected` slot — `cc` rejects the incompatible struct. Re-emit the if/match with its
    // node type RETAGGED to `expected`, so emit_if_value/emit_match_value type the temp as `expected`
    // AND each arm's trailing value wraps into it (case → wider variant, via emit_stmt_value/
    // emit_arm_value → emit_as_r). Guarded on EVERY narrow member reaching `expected` (a true widen).
    var vt_is_variant = match value.type { checker::Variant => true; checker::Named as vn => cg_named_is_variant(prog, vn.name); _ => false }
    if vt_is_variant && !cg_mangle_eq(value.type, expected) && cg_narrow_variant_widens_into(prog, value.type, expected) {
        var widened = checker::TExpr { kind = value.kind; type = expected; line = value.line; col = value.col }
        match value.kind {
            checker::TIfExpr as f => return emit_if_value(buf, prog, ret_type, widened, f, escaping, regions, fn_body, dctx)
            checker::TMatchExpr as m => return emit_match_value(buf, prog, ret_type, widened, m, escaping, regions, fn_body, dctx)
            _ => { }
        }
    }
    // VARIANT slot wrap (B-cg2) — DIRECT or TRANSITIVE (case→variant→variant). The member is
    // identified by RESOLVED-TYPE equality (the value's KEY == a reachable member's key), so a
    // non-named member (error/prim/slice) wraps too. When the value's key isn't reachable in
    // `expected` (it IS the whole variant, or `expected` isn't a variant), the value is emitted
    // plainly. (C: the variant arm of emit_as via emit_variant_wrap.)
    var vkey = match cg_member_key_str(value.type) { str as s => s; error => "" }
    if vkey == "" { return emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx) }
    var is_variant_slot = match expected { checker::Variant => true; checker::Named => true; _ => false }
    if is_variant_slot {
        if cg_var_reaches(prog, expected, vkey, 16) {
            return emit_variant_wrap(buf, prog, ret_type, expected, value, escaping, regions, fn_body, dctx)
        }
    }
    emit_expr_ctx(buf, prog, ret_type, value, escaping, regions, fn_body, dctx)
}

// cg_emit_lit_pattern — emit an AST LITERAL pattern bound as a C constant comparable to the
// subject temp `_s` (which already has the subject's C type, so a bare C number/byte literal
// compares correctly at the subject's width/sign).
// A str literal is a (tk_str){…} compound literal with an EXPLICIT length (same form as
// TStrLit — the bytes may hold NUL); the CALLER must compare it via tk_str_eq, never `==`
// (see emit_pat_test). (C: `cg_emit_lit_pattern`.)
fn cg_emit_lit_pattern(buf: []byte, lit: parser::Expr): []byte | error {
    // descend to the variant `.kind` — `Expr` is `struct { kind: ExprKind }` in the .tks model
    // (the C twin's tk_expr is a tagged union, so its cg_emit_lit_pattern matches `lit` directly —
    // a known parser-AST model divergence between the C bootstrap and the self-host corpus).
    match lit.kind {
        parser::Number as n => {
            if n.is_float { return cb_f64_literal(buf, n.fval) }
            cb_numint(buf, n.value)
        }
        parser::ByteLit as b => cb_i64(buf, b.value to i64)
        parser::StrLit as sl => {
            var out = cb(buf, "(tk_str){ (const tk_byte *)\"")
            out = cb_cstr_escaped(out, sl.text)
            out = cb(out, "\", ")
            out = cb_i64(out, sl.text.len to i64)
            cb(out, " }")
        }
        _ => error { message = "codegen: unsupported literal in a pattern (parser emits only number/byte/str)" }
    }
}

// cg_emit_tag_prefix — emit a variant tag-constant PREFIX up to and including the second `_`
// (`TK_TAG_<NAME>_` for a named variant, `TK_TAG_U_<UPPER keys…>_` for an inline union), so a
// case suffix can be appended. `variantT` is the subject's variant type. (C: `cg_emit_tag_prefix`.)
fn cg_emit_tag_prefix(buf: []byte, variantT: @Type()): []byte | error {
    var out = cb(buf, "TK_TAG_")
    match variantT {
        checker::Variant as va => {
            out = cb(out, "U")
            var j = 0
            loop {
                if j >= va.members.len { break }
                out = cb(out, "_")
                var kj = match cg_member_key_str(va.members[j]) { str as s => s; error as err => return err }
                out = cb_upper(out, kj)
                j++
            }
            cb(out, "_")
        }
        checker::Named as nm => { out = cb_upper(out, cg_ns_c_key(nm.name)); cb(out, "_") }
        _ => error { message = "codegen: tag prefix over a non-variant subject (internal)" }
    }
}

/**
 * A BIND/FIELD pattern's BARE case key (the union field name + the UPPERCASE tag-suffix source), the
 * pattern's source spelling with no namespace qualification. A non-slice case uses its path-last
 * identifier (== the bare member key for named/error/prim); a slice case (`[]T as x`) uses
 * `slice_<elem>`. This is the SELECTION spelling `cg_case_key_qualified` matches against the subject's
 * bare member keys before emitting the member's qualified key; it must therefore stay bare.
 *
 * @param pat  the bind/field/group pattern
 * @return     the bare case key
 * @throws     when `pat` is neither a bind, field, nor grouped-bind pattern
 */
fn cg_emit_case_key_str(pat: @Pattern()): str | error {
    match pat {
        parser::BindPattern as bp => {
            if bp.is_slice {
                match bp.slice_type {
                    null => error { message = "codegen: slice pattern without a slice type (internal)" }
                    (@TypeExpr()) as st => cg_member_key_texpr_bare_str(st)
                }
            } else if bp.type_args.len > 0 {
                // (W9.4) `Gen<i64> as x` — the case is the STAMPED instance `Gen__g__i64`, matching the
                // variant typedef's member key (the decl was normalized to the bare stamped name).
                cg_case_name_escaped(cg_texpr_inst_name(cg_path_last(bp.type_name), bp.type_args))
            } else { cg_case_name_escaped(cg_path_last(bp.type_name)) }
        }
        parser::FieldPattern as fp => cg_case_name_escaped(cg_path_last(fp.type_name))
        parser::GroupBindPattern as gp => cg_group_case_key(gp)
        _ => error { message = "codegen: case key over a non-bind/field pattern (internal)" }
    }
}

/**
 * cg_group_case_key — the tag KEY of a `GroupBindPattern`'s nested union member (§9.D c): `u` then, per
 * option in source order, `_` + the option's case key. Byte-identical to `cg_member_key`'s `u_<keys>`
 * over the resolved nested `Variant` member (the same escaping via `cg_case_name_escaped`), so the arm's
 * tag test and bind name the exact tag constant the subject's union decl emitted for that member.
 *
 * @param gp  the grouped bind pattern
 * @return    the nested member's `u_<keys>` tag key, or an option-key error
 * @throws    when an option is not a bare case-name pattern
 * @since     §9.D capability (c)
 */
fn cg_group_case_key(gp: parser::GroupBindPattern): str | error {
    var out = "u"
    var i = 0
    loop {
        if i >= gp.options.len { break }
        var k = match cg_emit_case_key_str(gp.options[i]) { str as s => s; error as e => return e }
        out = teko::str::concat(out, teko::str::concat("_", k))
        i++
    }
    out
}

// cg_case_name_escaped — keyword-escape a case name (the union FIELD identifier + tag-suffix
// source): a `bool` case → `bool_`, so the destructure `.as.bool_` and tag `TK_TAG_..._BOOL_`
// match the field/tag definitions (cg_member_key escapes the field+tag; the pattern side must
// agree). Mirrors the C `cb_ident` keyword-escape applied in `cg_emit_case_key`.
fn cg_case_name_escaped(name: str): str {
    if cg_is_c_keyword(name) { teko::str::concat(name, "_") } else { name }
}

// emit_pat_test — emit the boolean TEST that `_s` (`subj`) matches `pat`. `variantT` is the
// subject's variant type (a Named variant decl or an inline Variant), needed to spell a case's
// tag constant; it is a scalar/void type for a non-variant subject. Mirrors pat_match's
// decisions (binds are separate). (C: `emit_pat_test`.)
fn emit_pat_test(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, variantT: @Type()): []byte | error {
    match pat {
        parser::WildcardPattern => cb(buf, "1")
        parser::LiteralPattern as lp => {
            // A STR literal pattern tests via tk_str_eq (a tk_str is a {ptr,len} struct — C `==`
            // is invalid on it; content equality, mirroring emit_compare's str branch).
            var is_str_lit = match lp.value.kind { parser::StrLit => true; _ => false }
            if is_str_lit {
                var out = cb(buf, "tk_str_eq(")
                out = cb(out, subj)
                out = cb(out, ", ")
                out = match cg_emit_lit_pattern(out, lp.value) { []byte as o => o; error as err => return err }
                return cb(out, ")")
            }
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, " == ")
            out = match cg_emit_lit_pattern(out, lp.value) { []byte as o => o; error as err => return err }
            cb(out, ")")
        }
        parser::RangePattern as rp => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, " >= ")
            out = match cg_emit_lit_pattern(out, rp.lo) { []byte as o => o; error as err => return err }
            out = cb(out, " && ")
            out = cb(out, subj)
            out = cb(out, " <= ")
            out = match cg_emit_lit_pattern(out, rp.hi) { []byte as o => o; error as err => return err }
            cb(out, ")")
        }
        parser::AltPattern as ap => {
            var out = cb(buf, "(")
            var i = 0
            loop {
                if i >= ap.options.len { break }
                if i > 0 { out = cb(out, " || ") }
                out = match emit_pat_test(out, prog, ap.options[i], subj, variantT) { []byte as o => o; error as err => return err }
                i++
            }
            cb(out, ")")
        }
        parser::BindPattern as bp0 => {
            // Binding the WHOLE variant value (`TypeExpr as t` where the subject IS the TypeExpr
            // variant — common over an optional `TypeExpr?`): NOT a case-select. The value already
            // IS that variant, so the test is unconditionally true (any gating .present check is
            // upstream); the bind copies the whole value (cg_emit_pat_binds).
            var bind_whole = match variantT {
                // (#109 W3) the pattern's type name is BARE; the variant's `nm.name` is CANONICAL
                // "ns::Type" — compare by bare last-segment so `Type as t` over an optional `Type?`
                // is still recognized as a WHOLE-value bind (not a spurious case-select of member "Type").
                checker::Named as nm => (!bp0.is_slice) && (cg_path_last(bp0.type_name) == checker::name_last_segment(nm.name))
                _ => false
            }
            if bind_whole { return cb(buf, "1") }
            // An ENUM subject has no tag+union: a member pattern tests value equality against the
            // enum constant `TK_E_<ENUM>_<MEMBER>` (matches emit_type_decl's enum emission).
            var is_enum = match variantT { checker::Named as nm => cg_named_is_enum(prog, nm.name); _ => false }
            if is_enum {
                var ename = match variantT { checker::Named as nm => checker::name_last_segment(nm.name); _ => "" }   // (#109 W3) BARE enum name for the TK_E_ constant
                var oe = cb(buf, "(")
                oe = cb(oe, subj)
                oe = cb(oe, " == TK_E_")
                oe = cb_upper(oe, ename)
                oe = cb(oe, "_")
                var cke = match cg_emit_case_key_str(pat) { str as s => s; error as err => return err }
                oe = cb_upper(oe, cke)
                return cb(oe, ")")
            }
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { []byte as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::FieldPattern => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { []byte as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::NullPattern => {
            if cg_var_reaches(prog, variantT, "null", 16) {
                var out = cb(buf, "(")
                out = cb(out, subj)
                out = cb(out, ".tag == ")
                out = match cg_emit_tag_prefix(out, variantT) { []byte as o => o; error as err => return err }
                out = cb_upper(out, "null")
                return cb(out, ")")
            }
            error { message = "codegen: `null` pattern over a non-optional subject (internal)" }
        }
        parser::GroupBindPattern => {
            var out = cb(buf, "(")
            out = cb(out, subj)
            out = cb(out, ".tag == ")
            out = match cg_emit_tag_prefix(out, variantT) { []byte as o => o; error as err => return err }
            var ck = match cg_case_key_qualified(prog, variantT, pat) { str as s => s; error as err => return err }
            out = cb_upper(out, ck)
            cb(out, ")")
        }
        parser::MacroPattern => error { message = "internal: an unexpanded @Type() macro reached codegen — it should be expanded by the Family-A pre-pass (§9.D CR3)" }
    }
}

// AST struct-vs-kind DESCEND. The .tks parser/typed AST models `Expr`/`TExpr`/… as
// `struct { kind: <variant>; … }`, but the corpus matches such a value DIRECTLY against the
// variant's cases (`match e { Number => … }`). If `subjT` is a NAMED struct with a `kind` field
// of a VARIANT type and `pat` selects a CASE of that variant, return the variant type V and
// whether the kind field is boxed, so the match lowers on `<subj>.kind` (deref if boxed). The C
// twin uses out-params + a bool; here we return `CgKindDescend?` — `null` means "do not descend".
// (C: `cg_kind_descend`.)
type CgKindDescend = struct { var_type: @Type(); boxed: bool }

fn cg_kind_descend(prog: CgProg, subjT: @Type(), pat: @Pattern()): CgKindDescend | null {
    var sname = match subjT { checker::Named as nm => nm.name; _ => return null }
    match pat {
        parser::BindPattern => { }
        parser::FieldPattern => { }
        _ => return null
    }
    var d = match cg_find_decl(prog, sname) { parser::TypeDecl as dd => dd; error => return null }
    var sb = match d.body { parser::StructBody as s => s; _ => return null }
    // find a field named `kind` whose type-ann is a NAMED type.
    var kfte: @TypeExpr() | null = null
    var i = 0
    loop {
        if i >= sb.fields.len { break }
        if sb.fields[i].name == "kind" { kfte = sb.fields[i].type_ann; break }
        i++
    }
    var fte = match kfte { null => return null; (@TypeExpr()) as t => t }
    var vname = match fte { parser::NamedType as nt => cg_canon_name(prog, cg_path_last(nt.path)); _ => return null }
    if !cg_named_is_variant(prog, vname) { return null }
    var v = checker::Named { name = vname }
    // the pattern must select a CASE of V (not a field-destructure of the struct itself).
    var key = match cg_case_key_qualified(prog, v, pat) { str as s => s; error => return null }
    if !cg_var_reaches(prog, v, key, 2) { return null }
    CgKindDescend { var_type = v; boxed = cg_field_boxed(prog, sname, fte) }
}

// cg_kind_derived_subj — the descended subject string: boxed → `(*(SUBJ).kind)`, unboxed →
// `(SUBJ).kind`. Mirrors the C snprintf `%s(%s).kind%s` with `(*`/`)` around when boxed.
fn cg_kind_derived_subj(subj: str, boxed: bool): str {
    var o: []byte = teko::list::empty()
    if boxed { o = cb(o, "(*") }
    o = cb(o, "(")
    o = cb(o, subj)
    o = cb(o, ").kind")
    if boxed { o = cb(o, ")") }
    str(o)
}

/**
 * cg_fatptr_subject_name — the canonical name a fat-pointer match SUBJECT discriminates against, or
 * null when `subjT` is not a fat pointer. A `match` over a polymorphic BASE class or an INTERFACE/
 * TRAIT value lowers on the subject's `.vtable` word: each concrete subclass/impl owns a distinct
 * `tk_vt_<Concrete>_<Subject>` array (W10b.D3 / #98), so an arm's test compares `.vtable` against
 * that symbol and its bind extracts the object pointer from `.data` (match-universal phase 1, C
 * backend). Every other subject kind carries no `.vtable` and answers null.
 *
 * @param prog   the typed program (kind oracles)
 * @param subjT  the subject's resolved type
 * @return       the subject's canonical fat-pointer name, or null
 */
fn cg_fatptr_subject_name(prog: CgProg, subjT: @Type()): str | null {
    match subjT {
        checker::Named as nm => {
            if cg_is_polymorphic_base(prog, nm.name) || cg_is_interface_named(prog, nm.name) || cg_is_trait_named(prog, nm.name) { return nm.name }
            null
        }
        _ => null
    }
}

/**
 * cg_emit_fatptr_pat_test — the arm TEST for a fat-pointer (base-class/interface/trait) match
 * subject (match-universal phase 1, C backend). A bind-all naming the subject itself matches
 * unconditionally; every other bind names a concrete subclass/impl, discriminated by comparing the
 * subject's `.vtable` word against that concrete's `tk_vt_<Concrete>_<Subject>` array. A wildcard
 * `_` passes through to the unconditional `1`.
 *
 * @param buf       the output buffer
 * @param prog      the typed program
 * @param pat       the arm pattern
 * @param subj      the subject temp name
 * @param subjname  the subject's canonical fat-pointer name
 * @return          the buffer with the boolean test appended
 * @throws          on a slice/field/alt pattern, which cannot discriminate a fat pointer
 */
fn cg_emit_fatptr_pat_test(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, subjname: str): []byte | error {
    match pat {
        parser::WildcardPattern => cb(buf, "1")
        parser::BindPattern as bp => {
            if bp.is_slice { return error { message = "codegen: a slice pattern cannot discriminate a class/interface subject (internal)" } }
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) { return cb(buf, "1") }
            var canon = cg_canon_name(prog, sub_last)
            var o = cb(buf, "((")
            o = cb(o, subj)
            o = cb(o, ").vtable == tk_vt_")
            o = cb_tysym(o, canon)
            o = cb(o, "_")
            o = cb_tysym(o, subjname)
            cb(o, ")")
        }
        _ => error { message = "codegen: unsupported pattern over a class/interface subject (internal)" }
    }
}

/**
 * cg_emit_fatptr_pat_binds — the arm BINDS for a fat-pointer match subject (match-universal phase 1,
 * C backend). A bind-all naming the subject binds the whole fat pointer (still the subject type); a
 * concrete arm `Sub as x` binds the raw object pointer extracted from `.data`, cast to the concrete
 * class's `tk_t_<Sub> *` so field/method access reads the subclass instance. A bindless pattern
 * introduces nothing.
 *
 * @param buf       the output buffer
 * @param prog      the typed program
 * @param pat       the arm pattern
 * @param subj      the subject temp name
 * @param subjname  the subject's canonical fat-pointer name
 * @param indent    the arm-body indentation
 * @return          the buffer with the binding declarations appended
 */
fn cg_emit_fatptr_pat_binds(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, subjname: str, indent: str): []byte | error {
    match pat {
        parser::BindPattern as bp => {
            if !bp.has_binding { return buf }
            var o = cb(buf, indent)
            o = cb(o, "auto ")
            o = cb_str(o, bp.binding)
            o = cb(o, " = ")
            var sub_last = cg_path_last(bp.type_name)
            if sub_last == checker::name_last_segment(subjname) {
                o = cb(o, subj)
                return cb(o, ";\n")
            }
            var canon = cg_canon_name(prog, sub_last)
            o = cb(o, "(")
            o = mangle_type_name(o, "", canon)
            o = cb(o, " *)((")
            o = cb(o, subj)
            cb(o, ").data);\n")
        }
        _ => buf
    }
}

/**
 * cg_emit_pat_test — emit the TOP-LEVEL boolean test that `subj` matches `pat`, handling an
 * OPTIONAL subject (REBOOT_PLAN §202). For a niche-encoded optional a `null` pattern tests the
 * niche, a bind/field/group-bind tests "not the niche"; for a box-encoded (nullable-pointer)
 * optional `null` ⇒ `(subj == 0)` and a bind/field/group-bind ⇒ `(subj != 0)`. A §9.D group-bind
 * `(A | B) as v` over such an optional binds the WHOLE present union, so it tests presence exactly
 * like a bare bind. For a non-optional subject it delegates to `emit_pat_test`. Mirrors the C twin.
 *
 * @param subj   the subject temp name (a niche value or nullable pointer when optional)
 * @param subjT  the subject's resolved type
 * @param pat    the arm pattern under test
 * @param prog   the codegen program (type/decl lookups)
 * @param buf    the output byte buffer being appended to
 * @return       `buf` with the boolean test appended
 * @throws       when an inner case key or tag prefix cannot be emitted
 */
fn cg_emit_pat_test(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type()): []byte | error {
    // AST descend: `match e { Number => }` over `e: Expr = struct{kind: ExprKind}` lowers on e.kind.
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            return cg_emit_pat_test(buf, prog, pat, ds, kd.var_type)
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as nx => {
                match pat {
                    parser::NullPattern => return cg_emit_niche_is_null(buf, subj, nx)
                    parser::WildcardPattern => return cb(buf, "1")
                    parser::BindPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    parser::FieldPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    parser::GroupBindPattern => return cg_emit_niche_not_null(buf, subj, nx)
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt10 => {
                match pat {
                    parser::NullPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " == 0)") }
                    parser::WildcardPattern => return cb(buf, "1")
                    parser::BindPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    parser::FieldPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    parser::GroupBindPattern => { var o = cb(buf, "("); o = cb(o, subj); return cb(o, " != 0)") }
                    _ => { }
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => return cg_emit_fatptr_pat_test(buf, prog, pat, subj, sname)
        null => { }
    }
    emit_pat_test(buf, prog, pat, subj, subjT)
}

/**
 * Emit the BINDINGS a pattern introduces (BIND `as x`, FIELD fields) at the top of the arm block (in
 * scope for the guard and the body). The `.as.<case>` union field is named by the subject member's
 * NAMESPACE-QUALIFIED key (`cg_case_key_qualified` over `subjT`), so the destructure reads the same
 * field the union declared for a namespaced member. Scalar/Alt/Wildcard patterns bind nothing; C23
 * `auto` gives each binding the exact C type without a field-type lookup.
 *
 * @param buf     the output byte buffer being appended to
 * @param prog    the codegen program (for resolving the subject member's qualified key)
 * @param pat     the arm pattern whose bindings are emitted
 * @param subj    the subject temp name
 * @param subjT   the subject's resolved variant type (names the qualified `.as.` field)
 * @param indent  the leading whitespace for each emitted binding line
 * @return        `buf` with the binding declarations appended
 * @throws        when a case key cannot be emitted
 */
fn emit_pat_binds(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str): []byte | error {
    match pat {
        parser::BindPattern as bp => {
            if bp.has_binding {
                var out = cb(buf, indent)
                out = cb(out, "auto ")
                out = cb_str(out, bp.binding)
                out = cb(out, " = ")
                out = cb(out, subj)
                out = cb(out, ".as.")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
                out = cb_str(out, ck)
                cb(out, ";\n")
            } else { buf }
        }
        parser::FieldPattern as fp => {
            var out = buf
            var i = 0
            loop {
                if i >= fp.fields.len { break }
                out = cb(out, indent)
                out = cb(out, "auto ")
                out = cb_str(out, fp.fields[i])
                out = cb(out, " = ")
                out = cb(out, subj)
                out = cb(out, ".as.")
                var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
                out = cb_str(out, ck)
                out = cb(out, ".")
                out = cb_str(out, fp.fields[i])
                out = cb(out, ";\n")
                i++
            }
            out
        }
        parser::GroupBindPattern as gp => {
            var out = cb(buf, indent)
            out = cb(out, "auto ")
            out = cb_str(out, gp.binding)
            out = cb(out, " = ")
            out = cb(out, subj)
            out = cb(out, ".as.")
            var ck = match cg_case_key_qualified(prog, subjT, pat) { str as s => s; error as err => return err }
            out = cb_str(out, ck)
            cb(out, ";\n")
        }
        _ => buf
    }
}

/**
 * cg_emit_pat_binds — emit the TOP-LEVEL bindings a pattern introduces, handling an OPTIONAL
 * subject (REBOOT_PLAN §202). For a niche-encoded optional the present value IS `subj`, so a
 * bind/group-bind names it directly; for a box-encoded (nullable-pointer) optional the present
 * value is `(*(subj))`, so a bind/group-bind names the dereference. A §9.D group-bind `(A | B) as v`
 * binds the WHOLE present union under `v` (its inner cases are then matched on that value), exactly
 * mirroring a bare `T as v`. For a non-optional subject it delegates to `emit_pat_binds`. Mirrors the C twin.
 *
 * @param subj    the subject temp name (a niche value or nullable pointer when optional)
 * @param subjT   the subject's resolved type
 * @param pat     the arm pattern whose bindings are emitted
 * @param indent  the leading whitespace for each emitted binding line
 * @param prog    the codegen program (type/decl lookups)
 * @param buf     the output byte buffer being appended to
 * @return        `buf` with the binding declarations appended
 * @throws        when an inner case key cannot be emitted
 */
fn cg_emit_pat_binds(buf: []byte, prog: CgProg, pat: @Pattern(), subj: str, subjT: @Type(), indent: str): []byte | error {
    // AST descend (mirror cg_emit_pat_test): a case pattern over `Expr`/`TExpr` binds off `.kind`.
    match cg_kind_descend(prog, subjT, pat) {
        CgKindDescend as kd => {
            var ds = cg_kind_derived_subj(subj, kd.boxed)
            return cg_emit_pat_binds(buf, prog, pat, ds, kd.var_type, indent)
        }
        null => { }
    }
    match subjT {
        checker::Variant as nva => match cg_union_niche_member(prog, nva) {
            (@Type()) as _gt11 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            var o = cb(buf, indent)
                            o = cb(o, "auto ")
                            o = cb_str(o, nbp.binding)
                            o = cb(o, " = ")
                            o = cb(o, subj)
                            return cb(o, ";\n")
                        }
                        return buf
                    }
                    parser::GroupBindPattern as ngp => {
                        var o = cb(buf, indent)
                        o = cb(o, "auto ")
                        o = cb_str(o, ngp.binding)
                        o = cb(o, " = ")
                        o = cb(o, subj)
                        return cb(o, ";\n")
                    }
                    _ => return buf
                }
            }
            null => { }
        }
        _ => { }
    }
    match subjT {
        checker::Variant as bva => match cg_union_box_member(prog, bva) {
            (@Type()) as _gt12 => {
                match pat {
                    parser::BindPattern as nbp => {
                        if nbp.has_binding {
                            var o = cb(buf, indent)
                            o = cb(o, "auto ")
                            o = cb_str(o, nbp.binding)
                            o = cb(o, " = (*(")
                            o = cb(o, subj)
                            return cb(o, "));\n")
                        }
                        return buf
                    }
                    parser::GroupBindPattern as bgp => {
                        var o = cb(buf, indent)
                        o = cb(o, "auto ")
                        o = cb_str(o, bgp.binding)
                        o = cb(o, " = (*(")
                        o = cb(o, subj)
                        return cb(o, "));\n")
                    }
                    _ => return buf
                }
            }
            null => { }
        }
        _ => { }
    }
    match cg_fatptr_subject_name(prog, subjT) {
        str as sname => return cg_emit_fatptr_pat_binds(buf, prog, pat, subj, sname, indent)
        null => { }
    }
    match pat {
        parser::BindPattern as bp => {
            var bind_whole = match subjT {
                checker::Named as nm => (!bp.is_slice) && (cg_path_last(bp.type_name) == checker::name_last_segment(nm.name))   // (#109 W3) BARE compare (pattern bare vs canonical variant name)
                _ => false
            }
            if bind_whole {
                if bp.has_binding {
                    var o = cb(buf, indent); o = cb(o, "auto "); o = cb_str(o, bp.binding)
                    o = cb(o, " = "); o = cb(o, subj); return cb(o, ";\n")
                }
                return buf
            }
        }
        _ => { }
    }
    emit_pat_binds(buf, prog, pat, subj, subjT, indent)
}

// cg_block_diverges — does a typed block DIVERGE (exit via return/break/continue on every
// path)? True when its trailing statement is a return/break/continue, or a trailing if-with-
// else / match whose every branch / arm diverges. Mirrors the checker's tblock_diverges so a
// diverging arm body lowers as real control flow, not a value commit. (C: `cg_block_diverges`.)
fn cg_block_diverges(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && cg_block_diverges(f.then_blk) && cg_block_diverges(f.else_blk)
            checker::TMatchExpr as m => {
                if m.arms.len == 0 { return false }
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if !cg_block_diverges(m.arms[i].body) { return false }
                    i++
                }
                true
            }
            _ => false
        }
        _ => false
    }
}

// cg_block_diverges_jump — does a block diverge via a `break`/`continue` (NOT a `return`)? Such
// a jump can't escape a GNU stmt-expr, so a match used as a SUB-expression honest-stops on it.
// A `return` divergence is fine. (C: `cg_block_diverges_jump`.)
fn cg_block_diverges_jump(stmts: []@TStatement()): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TIfExpr as f => f.has_else && (cg_block_diverges_jump(f.then_blk) || cg_block_diverges_jump(f.else_blk))
            checker::TMatchExpr as m => {
                var i = 0
                loop {
                    if i >= m.arms.len { break }
                    if cg_block_diverges_jump(m.arms[i].body) { return true }
                    i++
                }
                false
            }
            _ => false
        }
        _ => false
    }
}

// emit_arm_value — emit an arm body BLOCK in VALUE position. All-but-last statements emit
// normally; the trailing value flows into `sink`, wrapped to the match result type via emit_as,
// then `break` commits. A `return`-DIVERGING arm (`=> return e` — THE dominant idiom) emits real
// control flow (a `return …;` leaves the whole function) and never commits to `sink`. A break/
// continue divergence is an HONEST STOP (it can't escape a stmt-expr). (C: `emit_arm_value`.)
fn emit_arm_value(buf: []byte, prog: CgProg, ret_type: @Type(), match_e: checker::TExpr, body: []@TStatement(), sink: str, ci: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if cg_block_diverges_jump(body) {
        return error { message = "codegen: break/continue inside a `match` used as a sub-expression not yet supported" }
    }
    if cg_block_diverges(body) {
        // `return`-divergence: emit every statement as-is; the trailing `return e` (or a diverging
        // trailing if/match) leaves the ENCLOSING FUNCTION — so its value wraps into the FUNCTION's
        // return type (ret_type, the C's g_cg_ret_type), NOT the match result type. No `sink =` /
        // `break`. No arm region here (the arm never commits to `sink`; a `return` inside drops all
        // active regions via the region-stack helpers). (C: emit_arm_value's diverging branch.)
        var out = buf
        var cur = dctx   // (W9.3) accumulate this arm's direct defers so the trailing `return e` fires [0, …) correctly
        var i = 0
        loop {
            if i + 1 >= body.len { break }
            match body[i] {
                checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
                _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false) { []byte as o => o; error as err => return err } }
            }
            i++
        }
        var last = body[body.len - 1]
        return match last {
            checker::TExprStmt as es => match es.expr.kind {
                checker::TIfExpr as _ => emit_exprstmt_tail(out, es.expr, false, prog, ret_type, ci, "", escaping, fn_body, cur)
                checker::TMatchExpr as _ => emit_exprstmt_tail(out, es.expr, false, prog, ret_type, ci, "", escaping, fn_body, cur)
                _ => emit_stmt(out, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false)
            }
            _ => emit_stmt(out, last, false, prog, ret_type, ci, "", escaping, regions, fn_body, cur, teko::list::empty(), false)
        }
    }
    // Value form: all-but-last normally; the trailing value → `sink` (wrapped), then `break`.
    // ret_type is the FUNCTION's return type (not Void): a non-last statement may itself be a
    // `return e` (e.g. `_ => { if cond { return error{…} }; v }`), and that `return` must wrap its
    // value into the fn's return slot — a Void slot left an error returned bare.
    // S2/W9: when the arm body has a provably BLOCK-LOCAL binding (is_value=TRUE → the predicate
    // EXCLUDES any binding flowing into the tail value / assign-RHS), open the arm's OWN `_tkbr<len>`
    // region for those NON-tail block-locals. ORDERING (W9 trap): the tail value is materialized into
    // `sink` (enclosing) FIRST, then the region drops BEFORE the `break`. No block-local ⇒ no region ⇒
    // byte-identical to the pre-W9 value-arm output. (C: emit_arm_value.)
    var defer_floor = dctx.defers.len   // (W9.3) defer scope base for this value-arm
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, true) && regions.len < 64
    var region = if want_block { fresh_named("_tkbr", buf.len to i64) } else { "" }
    var regs2 = if want_block { teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, true) }) } else { regions }
    var cur_blk = if want_block { body } else { teko::list::empty() }
    var out = buf
    if want_block {
        out = cb(out, ci); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = tk_region_new("); out = cb(out, cg_enclosing_region_expr(regions)); out = cb(out, ");\n")
    }
    var cur = dctx
    var i = 0
    loop {
        if i + 1 >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { cur = dctx_register(cur, body[i]) }
            _ => { out = match emit_stmt(out, body[i], false, prog, ret_type, ci, "", escaping, regs2, fn_body, cur, cur_blk, want_block) { []byte as o => o; error as err => return err } }
        }
        i++
    }
    if body.len == 0 { return error { message = "codegen: empty match arm body in value position" } }
    var fall = cg_append_direct_defers(dctx.defers, body)   // (W9.3) this value-arm's direct defers
    var last = body[body.len - 1]
    match last {
        checker::TExprStmt as es => {
            out = emit_cov_lines(out, dctx.cov, cov_collect_expr(es.expr, teko::list::empty()), ci)
            out = cb(out, ci)
            out = cb(out, sink)
            out = cb(out, " = (")
            // A trailing diverging expr (`=> panic(…)` / `exit(…)` — _Noreturn void, not a `return`)
            // can't be assigned to the sink. Emit `(panic(…), (T){0})`: the call diverges, the
            // zero-of-T makes the assignment type-check (unreachable). Mirrors the `??` fallback.
            // The tail rides the ENCLOSING region context (regs2 is is_value=true → block-locals
            // excluded, so a binding read here routes to the enclosing region, never `_tkbr<len>`).
            if cg_expr_diverges(es.expr) {
                out = match emit_expr_ctx(out, prog, checker::Void { }, es.expr, escaping, regs2, fn_body, cur) { []byte as o => o; error as err => return err }
                out = cb(out, ", (")
                out = match emit_type(out, prog, match_e.type) { []byte as o => o; error as err => return err }
                out = cb(out, "){0}")   // sink's `( … )` closes it
            } else {
                out = match emit_as_r(out, prog, ret_type, match_e.type, es.expr, escaping, regs2, fn_body, cur) { []byte as o => o; error as err => return err }
            }
            out = cb(out, ");")
            if want_block {
                // (W9.3) Tail is materialized into `sink`. Fire THIS value-arm's defers (LIFO) if any —
                // on their own lines (only when present, so the no-defer output stays byte-identical to
                // the pre-W9.3 inline form) — BEFORE dropping the arm region on `break`.
                if fall.len > defer_floor {
                    out = cb(out, "\n")
                    out = match emit_defers(out, fall, defer_floor, prog, ci, escaping, fn_body) { []byte as o => o; error as err => return err }
                    out = cb(out, ci); out = cb(out, "tk_region_drop("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;")
                } else {
                    // No defers: keep the original inline ` tk_region_drop(…)` form (byte-identical to pre-W9.3).
                    out = cb(out, " tk_region_drop("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;")
                }
                cb(out, " break;\n")
            } else if fall.len > defer_floor {
                // (W9.3) No region, but this value-arm registered defers: the tail is now in `sink`, so fire
                // the arm's defers (LIFO) INSIDE the arm's `{ … }` scope (where the arm-locals are still
                // declared), BEFORE the `break`, then the base resets when this arm's frame unwinds.
                out = cb(out, "\n")
                out = match emit_defers(out, fall, defer_floor, prog, ci, escaping, fn_body) { []byte as o => o; error as err => return err }
                out = cb(out, ci); out = cb(out, "break;\n")
                out
            } else {
                cb(out, " break;\n")
            }
        }
        _ => error { message = "codegen: non-value trailing statement in a match arm used as a value" }
    }
}

/**
 * Emit a match used as a VALUE: a GNU statement-expression yielding the matched arm's body value.
 *
 * The selection structure is the same as the tail/stmt forms, but the trailing value is committed
 * with `_r = <body>; break;` inside a `do {…} while (0)`:
 * `({ <SubjCType> _sN = (<subject>); <ResultCType> _rN = {0}; do { if (<test0>) { <binds0>
 * [if (<guard0>)] { <arm body → _rN; break;> } } … } while (0); _rN; })`. The non-`else` `if`
 * chain gives the first-match-with-guard order; a failed guard falls through to the next arm.
 * Exhaustiveness is checker-guaranteed, so the chain always commits before the `while (0)` exits —
 * but C cannot prove it, so `_rN` is zero-initialized (`= {0}`, universal C zero-init for scalar,
 * struct and union) to make the fallthrough read well-defined; the winning arm overwrites it, so
 * behaviour is unchanged. Without the zero-init the read is UB that `zig cc -O2` exploited into the
 * #281 self-build miscompile.
 *
 * @param buf       the C-source byte buffer being built
 * @param prog      the typed program, for type/expression emission
 * @param ret_type  the enclosing function's return type, threaded to the value arms
 * @param e         the match expression's typed node (its `type` is the result type)
 * @param m         the typed match: subject and arms
 * @param escaping  the enclosing block-region escape set threaded to subject/guards/arms
 * @param regions   the enclosing region-frame stack for arm-local bindings
 * @param fn_body   the enclosing function body, for block-locality analysis
 * @param dctx      the defer context threaded through the arms
 * @return          the buffer with the value-match statement-expression appended
 * @throws          the first emission error from a subject, guard, pattern or arm body
 */
fn emit_match_value(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, m: checker::TMatchExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    // S2/W9: `escaping`/`regions`/`fn_body` thread the enclosing block-region context so each value-arm
    // can open its OWN arm region for its block-local NON-tail bindings (emit_arm_value). The subject
    // and guards are emitted in the SAME enclosing context (the C twin reads its live globals there).
    var subj = fresh_named("_s", buf.len to i64)
    var res = fresh_named("_r", buf.len to i64 + 1)
    var subjT = m.subject.type
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, m.subject.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); ")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, res)
    out = cb(out, " = {0}; do {\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, "    if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { []byte as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, "        ") { []byte as o => o; error as err => return err }
        var ci = "        "
        if arm.has_when {
            out = cb(out, "        if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = "            "
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        out = match emit_arm_value(out, prog, ret_type, e, arm.body, res, ci, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        if arm.has_when { out = cb(out, "        }\n") }
        out = cb(out, "    }\n")
        i++
    }
    out = cb(out, "    } while (0); ")
    out = cb(out, res)
    cb(out, "; })")
}

/**
 * Emit a match in TAIL position: each winning arm `return`s its body, as an `if` chain inside a
 * brace block holding the subject temp.
 *
 * The FIRST winning arm runs its block and then `goto`s a unique commit label past the chain, so
 * the search stops at the first match. The `goto` is essential: a tail match in
 * a `-> void` fn has arm bodies that do NOT diverge (no implicit `return`), so without the commit
 * jump MULTIPLE arms would fall through and all fire. A failed `when` guard naturally falls through
 * to the next arm (the goto is INSIDE the guard block). `ret_type` threads the fn return type so a
 * tail arm body that yields a case value into a variant return slot is wrapped (emit_as). The
 * `_done:` label emits a defensive zero return for non-void functions so the checker-exhaustive
 * chain can never fall off the function end (`-Wreturn-type`).
 *
 * @param buf       the C-source byte buffer being built
 * @param prog      the typed program, for type/expression emission
 * @param e         the match expression's typed node
 * @param m         the typed match: subject and arms
 * @param in_main   true iff this tail match is directly in `main`
 * @param ret_type  the enclosing function's return type, threaded to the arm bodies
 * @param indent    the current indentation for the emitted brace block
 * @param escaping  the enclosing block-region escape set threaded to arm statements
 * @param fn_body   the enclosing function body, for block-locality analysis
 * @param dctx      the defer context threaded through the arms
 * @return          the buffer with the tail-match brace block appended
 * @throws          the first emission error from a subject, guard, pattern or arm body
 */
fn emit_match_tail(buf: []byte, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var subj = fresh_named("_s", buf.len to i64)
    var done = teko::str::concat(fresh_named("tk_mt", buf.len to i64 + 1), "_done")
    var subjT = m.subject.type
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    out = cb(out, inner)
    out = match emit_type(out, prog, m.subject.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, inner)
        out = cb(out, "if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { []byte as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, inner2) { []byte as o => o; error as err => return err }
        var ci = inner2
        if arm.has_when {
            out = cb(out, inner2)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = cb_indent_deeper(inner2)
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        var tarm_base = dctx.defers.len
        out = match emit_block_tail(out, arm.body, in_main, prog, ret_type, ci, "", escaping, fn_body, dctx) { []byte as o => o; error as err => return err }
        var tarm_term = if arm.body.len > 0 { cg_stmt_c_terminates(arm.body[arm.body.len - 1]) } else { false }
        if !tarm_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, arm.body), tarm_base, prog, ci, escaping, fn_body) { []byte as o => o; error as err => return err } }
        out = cb(out, ci)
        out = cb(out, "goto ")
        out = cb(out, done)
        out = cb(out, ";\n")
        if arm.has_when { out = cb(out, inner2); out = cb(out, "}\n") }
        out = cb(out, inner)
        out = cb(out, "}\n")
        i++
    }
    out = cb(out, inner)
    out = cb(out, done)
    out = cb(out, ": ;\n")
    out = match emit_match_tail_fallthrough_return(out, prog, ret_type, in_main, inner) { []byte as o => o; error as err => return err }
    out = cb(out, indent)
    cb(out, "}\n")
}

/**
 * Emit a defensive `return` at the tail-match `_done:` label so a non-void function cannot
 * fall off its end. Every tail arm diverges (returns), and the checker guarantees the match is
 * exhaustive, so the label is only reachable on the C-visible fallthrough that exhaustiveness
 * rules out — but C cannot prove it, yielding `-Wreturn-type`. A zero-initialized return of the
 * function's return type makes the fallthrough well-defined without changing behaviour. `main`
 * (`in_main`) and `-> void` functions need nothing: the former has an implicit `return 0` epilogue
 * and the latter can legally fall off its end.
 *
 * @param buf       the C-source byte buffer being built
 * @param prog      the typed program, for `emit_type`
 * @param ret_type  the enclosing function's return type, threaded from `emit_match_tail`
 * @param in_main   true iff this tail match is directly in `main` (no explicit return needed)
 * @param inner     the indentation for the returned statement inside the tail-match brace block
 * @return          the buffer with the defensive return appended (unchanged for void/main)
 * @throws          the `emit_type` error if the return type cannot be emitted
 */
fn emit_match_tail_fallthrough_return(buf: []byte, prog: CgProg, ret_type: @Type(), in_main: bool, inner: str): []byte | error {
    if in_main { return buf }
    if is_void_type(ret_type) { return buf }
    var out = cb(buf, inner)
    out = cb(out, "return (")
    out = match emit_type(out, prog, ret_type) { []byte as o => o; error as err => return err }
    cb(out, "){0};\n")
}

// emit_match_stmt — STATEMENT form: a match whose result is DISCARDED (run each winning arm
// body for effect). An `if` chain inside a brace block; the FIRST winning arm runs its block and
// then `goto`s a unique commit label past the chain. The commit uses a GOTO (not a `do {…}
// while(0)` + break) precisely because an arm body is a BLOCK that may contain `break`/`continue`
// targeting an ENCLOSING loop — those must be real C break/continue, never swallowed by a wrapper
// (the arm's flow propagates through). (C: `emit_match_stmt`.)
fn emit_match_stmt(buf: []byte, prog: CgProg, e: checker::TExpr, m: checker::TMatchExpr, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    var subj = fresh_named("_s", buf.len to i64)
    var done = teko::str::concat(fresh_named("tk_m", buf.len to i64 + 1), "_done")   // unique commit label (str concat — no `+` on str)
    var subjT = m.subject.type   // for optional / variant pattern lowering
    var inner = cb_indent_deeper(indent)
    var inner2 = cb_indent_deeper(inner)
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    out = cb(out, inner)
    out = match emit_type(out, prog, m.subject.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, subj)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, m.subject, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ");\n")
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var arm = m.arms[i]
        out = cb(out, inner)
        out = cb(out, "if (")
        out = match cg_emit_pat_test(out, prog, arm.pattern, subj, subjT) { []byte as o => o; error as err => return err }
        out = cb(out, ") {\n")
        out = match cg_emit_pat_binds(out, prog, arm.pattern, subj, subjT, inner2) { []byte as o => o; error as err => return err }
        var ci = inner2
        if arm.has_when {
            out = cb(out, inner2)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, arm.guard, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ") {\n")
            ci = cb_indent_deeper(inner2)
        }
        out = emit_cov_branch(out, dctx.cov, e.line, e.col, i to u64, ci)
        // run the arm body BLOCK for effect (value discarded); break/continue/return inside it
        // propagate via C's own semantics. Thread ret_type so `return null` inside an arm
        // wraps null correctly into the enclosing function's return slot.
        // S2 — the arm body gets its OWN arm region for its block-local bindings (emit_block_region),
        // dropped at the arm's fall-through / via the region stack on break/continue/return.
        out = match emit_block_region(out, arm.body, in_main, prog, ret_type, ci, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        out = cb(out, ci)
        out = cb(out, "goto ")
        out = cb(out, done)
        out = cb(out, ";\n")
        if arm.has_when { out = cb(out, inner2); out = cb(out, "}\n") }
        out = cb(out, inner)
        out = cb(out, "}\n")
        i++
    }
    out = cb(out, inner)
    out = cb(out, done)
    out = cb(out, ": ;\n")
    out = cb(out, indent)
    cb(out, "}\n")
}

// emit_expr — the expression dispatch (the C's emit_expr switch). Unsupported value
// nodes fail with an honest message (M.3). (C: `emit_expr`.)
/**
 * emit_number — a `TNumber` literal. The node's resolved prim (`e.type`) decides width and
 * float-kind (N1/N2). Float literals emit a round-trippable double, cast to the right C float
 * type (f64 plain; f32 `(float)`). Integer literals emit the decimal value cast to the prim's C
 * type, so the literal carries the right width. (C: the `TK_TEXPR_NUMBER` branch of `emit_expr`.)
 *
 * @param buf   the growable output buffer
 * @param prog  the checked program (context for a flags-typed literal)
 * @param e     the enclosing typed expression (its resolved `.type`)
 * @param n     the number literal node
 * @return      the grown buffer
 */
fn emit_number(buf: []byte, prog: CgProg, e: checker::TExpr, n: checker::TNumber): []byte | error {
    // A numeric literal adopted to `byte` via literal-adoption (e.g. `c < 0x20` where c: byte).
    match e.type {
        checker::Byte => {
            var o = cb(buf, "((uint8_t)")
            o = cb_numint(o, n.value)
            return cb(o, ")")
        }
        _ => { }
    }
    // (#63) A FLAGS-typed number literal — the checker's fabricated zero in the any/none
    // lowering (type_flags_method, typer.tks) — is a NAMED type whose decl is `flags`. Emit it
    // cast to the flags' own typedef'd carrier (`tk_t_<Name>`, the SAME uint chosen by member
    // count as the flags typedef itself emits — FlagsBody above), reusing that carrier via its
    // typedef name instead of re-deriving uint8_t/uint16_t/… a second time (#50).
    match e.type {
        checker::Named as nm => {
            if cg_named_is_flags(prog, nm.name) {
                var o = cb(buf, "((")
                o = mangle_type_name(o, "", nm.name)
                o = cb(o, ")")
                o = cb_numint(o, n.value)
                return cb(o, ")")
            }
        }
        _ => { }
    }
    var k = match e.type {
        checker::Prim as p => p.kind
        _ => return error { message = "codegen: numeric literal with a non-primitive type not yet supported" }
    }
    if n.is_float {
        match k {
            checker::PrimKind::F64 => return cb_f64_literal(buf, n.fval)
            checker::PrimKind::F32 => {
                var o = cb(buf, "(float)(")
                o = cb_f64_literal(o, n.fval)
                return cb(o, ")")
            }
            _ => return error { message = "codegen: float literal with a non-float type not yet supported" }
        }
    }
    // integer literal: `((Ctype)<decimal>)`.
    var out = cb(buf, "((")
    out = match emit_prim(out, k) { []byte as o => o; error as err => return err }
    out = cb(out, ")")
    out = cb_numint(out, n.value)
    cb(out, ")")
}

// emit_expr — a TExpr -> C expression text. `ret_type` threads the ENCLOSING FUNCTION's return
// type (the functional twin of the C's `g_cg_ret_type` static): a value-form `match` whose arm
// DIVERGES via `return e` wraps that value into the FUNCTION return type, not the match-result
// type (emit_arm_value). Every other expr ignores it. (C: `emit_expr`.)
fn emit_expr(buf: []byte, prog: CgProg, e: checker::TExpr): []byte | error {
    emit_expr_ctx(buf, prog, checker::Void { }, e, teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty())
}
// emit_expr_ret — emit_expr carrying the enclosing function return type for value-form match
// diverging arms. (S2/W9: the region/escape context defaults empty — a caller with NO enclosing
// block region, e.g. a sub-expression of a frameless construct, gets no value-arm region.)
fn emit_expr_ret(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr): []byte | error {
    emit_expr_ctx(buf, prog, ret_type, e, teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty())
}
// emit_expr_ctx — the real dispatch. S2/W9: `escaping`/`regions`/`fn_body` thread the enclosing
// block-region context (the functional twin of the C's g_cg_escaping/g_cg_block_stack/g_cg_fn_body
// globals) so a value-position `if`/`match` REACHED FROM HERE can open its OWN arm region for its
// block-local NON-tail bindings (emit_if_value/emit_match_value → emit_branch_value/emit_arm_value).
// Every other expr just forwards the context unchanged. (C: `emit_expr` — globals, no threading.)
fn emit_expr_ctx(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match e.kind {
        checker::TNumber as n => emit_number(buf, prog, e, n)
        // (W10a) a bare top-level-fn reference used as a VALUE → a `tk_closure` literal carrying the
        // C function's address (env = NULL; named fns capture nothing). A plain local emits its name.
        checker::TVar as v => if v.is_func {
            cb(cb_fn_name(cb(buf, "(tk_closure){ (void*)&"), v.func_ns, v.name), ", (void*)0 }")
        } else if cg_var_is_struct_self(prog, e, v) {
            /* (item-14 §13.2) inside a value-struct method `self` IS the header pointer, so every use
               of it derefs. One rule covers every position uniformly: `self.x` becomes `((*self).x)`
               (a write through the caller's materialization — the mutation sticks), while passing or
               returning `self` yields `(*self)`, a COPY, which is exactly value semantics. */
            cb(cb_ident(cb(buf, "(*"), v.name), ")")
        } else {
            cb_ident(buf, v.name)
        }
        checker::TBinary as b => emit_binary(buf, prog, e, b, escaping, regions, fn_body, dctx)
        checker::TUnary as u => emit_unary(buf, prog, u, escaping, regions, fn_body, dctx)
        checker::TCompare as c => emit_compare(buf, prog, c, escaping, regions, fn_body, dctx)
        checker::TCast as c => emit_cast(buf, prog, e, c, escaping, regions, fn_body, dctx)
        checker::TCall as cl => emit_call(buf, prog, ret_type, e, cl, escaping, regions, fn_body, dctx)
        checker::TFieldAccess as fa => emit_field_access(buf, prog, fa, escaping, regions, fn_body, dctx)
        checker::TStructInit as si => emit_struct_init(buf, prog, e, si, escaping, regions, fn_body, dctx)
        checker::TStrLit as s => emit_strlit(buf, s)
        checker::TByteLit as by => cb_i64(buf, by.value to i64)   // byte == uint8_t; emit its decimal value (0..255)
        checker::TCharLit as ch => emit_charlit(buf, ch)   // char — a tk_char {ptr,len} compound literal over its static UTF-8 bytes
        // bool literal (W2) — FULL support: bool already flows through both backends, so
        // emit the C `true`/`false` keyword (C type is `bool`). (C: TK_TEXPR_BOOL branch.)
        checker::TBoolLit as bl => cb(buf, if bl.value { "true" } else { "false" })
        checker::TIfExpr as f => emit_if_value(buf, prog, ret_type, e, f, escaping, regions, fn_body, dctx)   // W5a — `if` as a value (GNU stmt-expr)
        checker::TMatchExpr as m => emit_match_value(buf, prog, ret_type, e, m, escaping, regions, fn_body, dctx)   // W5b — `match` as a value (GNU stmt-expr)
        // null / ?. / ?? — the OPTIONAL value model (REBOOT_PLAN §202/§203; tk_opt_<inner>).
        // A bare `null` in raw expression position has the SENTINEL optional type: it cannot be
        // emitted alone — its concrete type comes from the destination slot via emit_as.
        checker::TNullLit => match e.type {
            checker::Null => cb(buf, "0")
            _ => error { message = "codegen: a bare `null` needs a known optional type from context (use it where a `T?` is expected)" }
        }
        checker::TIndex as ix => emit_index(buf, prog, e, ix, escaping, regions, fn_body, dctx)   // W5-idx — subscript recv[index] (str + slice, bounds-checked)
        checker::TInterp as in => emit_interp(buf, prog, in, "", escaping, regions, fn_body, dctx)
        checker::TInExpr as ie => emit_in(buf, prog, ie, escaping, regions, fn_body, dctx)   // Phase 2 — `<lhs> in [ … ]` membership (single-eval, OR of `==`)
        checker::TArrayLit as a => emit_array_lit(buf, prog, e, a, escaping, regions, fn_body, dctx)   // [ e0, e1, … ] (Increment B+) — build a tk_slice_<elem>
        checker::TPathExpr as pe => {
            // Enum::Member → C enum constant `TK_E_<UPPER enum>_<UPPER member>`.
            // Flags::Member → pre-emitted C constant `tk_t_<Name>_<UPPER member>` (power-of-2).
            if cg_named_is_flags(prog, pe.enum_name) {
                // (C8.4) flags member: reference the pre-emitted constant tk_t_<Name>_<UPPER member>
                var out = mangle_type_name(buf, "", pe.enum_name)
                out = cb(out, "_")
                cb_upper(out, pe.member)
            } else {
                var out = cb(buf, "TK_E_")
                out = cb_upper(out, checker::name_last_segment(pe.enum_name))   // (#109 W3) BARE enum name — the C enum constant is TK_E_<UPPER bare enum>_<UPPER member>, consistent decl+use
                out = cb(out, "_")
                cb_upper(out, pe.member)
            }
        }
        // (W10) a closure LITERAL → a `tk_closure` value. The body was lifted to a top-level C
        // function `__tkclo_<lift_id>` by the cg_stamp_lambdas pre-pass. A NON-capturing lambda has
        // env = NULL and the lifted fn is `R(params)` (W10a-compatible call cast). A CAPTURING lambda
        // allocates its env struct and uses the env-first ABI (handled below).
        checker::TLambda as lam => emit_lambda(buf, prog, e, lam, escaping, regions, fn_body, dctx)
        checker::TBorrow as b => emit_borrow(buf, prog, ret_type, b, escaping, regions, fn_body, dctx)
        checker::TBlockExpr as blk => emit_block_expr(buf, prog, ret_type, e, blk, escaping, regions, fn_body, dctx)
    }
}

/**
 * emit_block_expr — lower a Block-B in value position (§9 E, ruling 7) to a GNU statement-expression
 * `({ <Ctype> _tkN; <stmts…>; _tkN = <tail>; _tkN; })`, the same idiom `emit_if_value` uses. The
 * block runs INLINE in the enclosing frame; its trailing statement's value is materialized into the
 * temp `_tkN` (of the block's own resolved type) via `emit_branch_value`, which threads the
 * block-region / defer context so a block-local aggregate binding opens its own arm region and the
 * tail is captured into the temp BEFORE that region drops (S2/W9 ordering, shared with if/match
 * value arms). The temp is then the stmt-expr's value.
 *
 * @param buf       the code buffer being appended to
 * @param prog      the typed program (namespaces + resolved function table)
 * @param ret_type  the enclosing function's return type, threaded to the tail emitter
 * @param e         the block expression (its `.type` is the trailing value's C type)
 * @param blk       the typed Block-B node
 * @param escaping  the enclosing function's frame-escape set (block-region context)
 * @param regions   the open block-region stack
 * @param fn_body   the enclosing function body (block-locality denominator)
 * @param dctx      the defer context threaded through the block
 * @return          `buf` with the GNU statement-expression appended, or a propagated error
 * @throws          propagated from emitting the block's type or any of its statements
 * @since           §9 E
 */
fn emit_block_expr(buf: []byte, prog: CgProg, ret_type: @Type(), e: checker::TExpr, blk: checker::TBlockExpr, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var tmp = fresh_tmp_name(buf.len to i64)
    var out = cb(buf, "({ ")
    out = match emit_type(out, prog, e.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    out = cb(out, ";\n")
    out = match emit_branch_value(out, prog, ret_type, blk.body, e.type, tmp, "    ", escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, tmp)
    cb(out, "; })")
}

/**
 * Lower a safe borrow `&x` (`TBorrow`, AL wave F1.4) to its C address-of form: emit `&` then the
 * operand expression. This is byte-identical to the auto-ref `&` the call path already emits for a
 * `Ref<T>` parameter (see `emit_call`) — a borrow just makes that address-of explicit as a
 * first-class expression. The `Reference` type already lowers to `<T> *`, so a ref-bind local
 * `mut y = &x` is a pointer initialized with `&x`, and any `y.value` read / write-through lowers
 * through the existing RefDeref path. Zero new representation.
 *
 * @param buf      the code buffer being appended to
 * @param prog     the typed program (namespaces + resolved function table)
 * @param ret_type the enclosing function's return type, threaded to the operand emitter
 * @param b        the typed borrow node (`&operand`)
 * @param escaping the names escaping the current scope (region threading)
 * @param regions  the live region frames
 * @param fn_body  the enclosing function body statements
 * @param dctx     the defer context
 * @return         the buffer with `&<operand>` appended
 * @throws         error propagated from emitting the borrow's operand expression
 * @since 0.x (#AL/F1.4)
 */
fn emit_borrow(buf: []byte, prog: CgProg, ret_type: @Type(), b: checker::TBorrow, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var out = cb(buf, "&")
    emit_expr_ctx(out, prog, ret_type, b.operand, escaping, regions, fn_body, dctx)
}

// (W10) the lifted C function name for a lambda with the given stamp id: `__tkclo_<id>`.
fn lam_fn_name(id: u64): str { teko::str::concat("__tkclo_", teko::u64_to_str(id)) }

// (W10) emit a closure literal. Non-capturing → `(tk_closure){ &__tkclo_<id>, (void*)0 }`. Capturing
// → allocate + fill the env struct, then `(tk_closure){ &__tkclo_<id>, env }` (env-first ABI).
fn emit_lambda(buf: []byte, prog: CgProg, e: checker::TExpr, lam: checker::TLambda, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if lam.captures.len == 0 {
        var out = cb(buf, "(tk_closure){ (void*)&")
        out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
        return cb(out, ", (void*)0 }")
    }
    // CAPTURING: allocate the env (`__tkenv_<id>`), fill each capture (by-copy value, or the Ref cell
    // for a by_ref capture), and build the closure. Uses a GNU statement-expression so the env pointer
    // is materialized once. The env is region-allocated (root region — sound; escape promotes it).
    var out = cb(buf, "({ __tkenv_")
    out = cb(out, teko::u64_to_str(lam.lift_id))
    out = cb(out, " *_tke = tk_region_alloc("); out = cb(out, cg_closure_env_region(dctx)); out = cb(out, ", sizeof(__tkenv_")
    out = cb(out, teko::u64_to_str(lam.lift_id))
    out = cb(out, ")); ")
    var i = 0
    loop {
        if i >= lam.captures.len { break }
        out = cb(out, "_tke->")
        out = cb_ident(out, lam.captures[i].name)
        out = cb(out, " = ")
        out = cb_ident(out, lam.captures[i].name)   // by-copy snapshot, or the Ref pointer for a by_ref capture
        out = cb(out, "; ")
        i++
    }
    out = cb(out, "(tk_closure){ (void*)&")
    out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
    cb(out, ", (void*)_tke }; })")
}

/**
 * RegionFrame — one active per-block arena region on the codegen stack (innermost LAST), the codegen
 * twin of codegen.c's cg_block_region. Each scope-introducing block (loop body / if-arm / match-arm /
 * bare block) opens its OWN region `_tkbr<len>` for its provably-block-local allocations, dropped at
 * every exit edge. SAFETY IS ABSOLUTE — a binding is block-routed ONLY when `binding_is_block_local`
 * proves it; otherwise it falls back to the frame/root (W8 = a leak, never a UAF).
 *
 * @since 0.3.1 (A3) `decls` realizes the N-level slice selector: the names of the block-local slice
 *              accumulators DECLARED in this region's block. A self-append `xs = push(xs, item)`
 *              consults `scope_region_of` to route its grown buffer to the region of `xs`'s DECLARING
 *              scope (R_decl), never an inner loop's region — the buffer of an accumulator grown in an
 *              inner loop must live in the outer declaring block, else it dies per-iteration (UAF).
 */
type RegionFrame = struct {
    /** the C variable name of this region (`_tkbr<len>`). */
    name: str
    /** the loop label this region ties to (""  when unlabeled / not a loop), for labeled break/continue. */
    label: str
    /** true for a LOOP-body region (a valid break/continue target); false for an arm/bare-block region
     *  (a break/continue CROSSES it but never STOPS at it). */
    is_loop: bool
    /** the in-scope defer count (dctx.defers.len) at this block's entry — the boundary below which
     *  defers belong to ENCLOSING scopes (structural parity with the C twin's cg_block_region.defer_base). */
    defer_base: u64
    /** (A3) the block-local slice accumulator names declared at the TOP of this region's block; a
     *  self-append of one routes its grown buffer HERE (R_decl), matched by name in `scope_region_of`. */
    decls: []str
}

/**
 * scope_region_of — the name→declaring-region map that realizes the A3 N-level slice selector (§2).
 * Walks the open region stack INNERMOST→OUTERMOST and returns the C variable name of the FIRST region
 * whose block declared `name` as a block-local slice accumulator; returns "" when none does (the
 * caller then falls back to the frame `_tkfr`, a leak-safe default since frame ⊒ block ⊒ uses).
 *
 * The innermost→outermost walk is load-bearing: an accumulator declared in an OUTER block but grown in
 * an INNER loop is matched at the OUTER frame (the inner loop's region does not carry `name` in its
 * `decls`), so the grown buffer lives across every iteration and dies at the outer block's exit — never
 * per-iteration (the UAF the naive innermost-region routing would open). Determinism over the region
 * stack means the C and native engines agree by construction (the C-vs-native unification).
 *
 * @param regions  the open region-frame stack (innermost last)
 * @param name     the self-append accumulator's name
 * @return         the declaring region's C variable name, or "" when unresolved (frame fallback)
 * @since 0.3.1
 */
fn scope_region_of(regions: []RegionFrame, name: str): str {
    var k = regions.len
    loop {
        if k == 0 { break }
        var r = regions[k - 1]
        if str_list_has(r.decls, name) { return r.name }
        k = k - 1
    }
    ""
}

/**
 * cg_bound_is_slice — whether a declared/assigned type is a `Slice` (`[]T`), the shape whose grown
 * buffer the move-on-return routing tracks.
 *
 * @param t  the type to test
 * @return   true iff `t` is a `Slice`
 * @since 0.3.1
 */
fn cg_bound_is_slice(t: @Type()): bool {
    match t { checker::Slice => true; _ => false }
}

/**
 * cg_self_append_escapes — whether assign `a` is an ESCAPING slice self-append that must route its
 * grown buffer to the return region `_tkrr` (0.3.1 move-on-return A4/M1). True iff a `_tkrr` is open
 * (`dctx.rr`), `a` is a self-append `xs = list::push(xs, e)`, `xs` ESCAPES the frame, and `xs` is a
 * slice. The non-escaping twin routes to the frame/block region (`assign_routes_to_frame`); this arm
 * catches the escaping accumulator that must OUTLIVE the frame — in M1 `_tkrr == root` (leak-safe), in
 * M2 `_tkrr == the caller's region` (the move). A `_tkfr`-entered function would otherwise land this
 * buffer in the frame region and free it at the return edge (UAF).
 *
 * @param escaping  the function's escaping-name set
 * @param dctx      the defer context (carries `rr`, the `_tkrr` name or "")
 * @param a         the assign
 * @return          true iff `a` routes to `_tkrr`
 * @since 0.3.1
 */
fn cg_self_append_escapes(escaping: []str, dctx: DeferCtx, a: checker::TAssign): bool {
    if dctx.rr.len == 0 { return false }
    if !checker::assign_is_self_append(a) { return false }
    if !str_list_has(escaping, a.name) { return false }
    cg_bound_is_slice(a.bound)
}

/**
 * cg_slice_grow_elem_matches — does a slice-growing binding's NATURAL push element (the concrete
 * element `type_list_builtin` fixed the push call's own `.type` to, taken from the pushed ITEM's
 * type when the base was the sentinel `empty()`) mangle-equal the binding's DECLARED slice element?
 * True for the ordinary case (`let xs: []T = push(empty(), <a T>)`); false when the declared slot
 * is a WIDER variant than the pushed case (`let xs: []Variant = push(empty(), <a case of Variant>)`,
 * 0.3.1 covariant-slice-push) — `cg_binding_grows_escaping_slice`'s fast path must not fire there:
 * `emit_list_push` grows a buffer typed by the NATURAL (narrow) element, which mismatches the WIDER
 * declared slot's `tk_slice_` struct as a `let` initializer ("invalid initializer"); the caller must
 * fall through to `emit_as_r_in`'s element-wise covariant rebuild instead, which wraps each pushed
 * case into the wider variant.
 *
 * @param bound  the binding's declared type (a `Slice`, already proven by the caller)
 * @param vtype  the push call's own resolved type (always a `Slice`, by `type_list_builtin`)
 * @return       true iff both slices' elements mangle to the identical C element type
 * @since 0.3.1
 */
fn cg_slice_grow_elem_matches(bound: @Type(), vtype: @Type()): bool {
    match bound {
        checker::Slice as bs => match vtype {
            checker::Slice as vs => cg_mangle_eq(bs.element, vs.element)
            _ => false
        }
        _ => false
    }
}

/**
 * cg_binding_grows_escaping_slice — whether binding `b` builds an escaping slice via a `list::push` /
 * `list::with_cap` / `mem::push_fo` call whose result OUTLIVES the frame (0.3.1 move-on-return A4/M1).
 * Such a bare slice grow follows the current region and, once M2 enters `_tkfr`, would die at the
 * return edge; routing it to `_tkrr` names it as escaping (M1: root; M2: the caller's region — the move).
 * Guarded by `cg_slice_grow_elem_matches`: a push whose NATURAL element is NARROWER than `b`'s declared
 * (wider-variant) slot needs the element-wise covariant rebuild `emit_as_r_in` provides, not this
 * bare-grow fast path — see that helper's doc for the "invalid initializer" defect it closes.
 *
 * @param escaping  the function's escaping-name set
 * @param dctx      the defer context (carries `rr`)
 * @param b         the binding
 * @return          true iff `b`'s slice-grow value routes to `_tkrr`
 * @since 0.3.1
 */
fn cg_binding_grows_escaping_slice(escaping: []str, dctx: DeferCtx, b: checker::TBinding): bool {
    if dctx.rr.len == 0 { return false }
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if !str_list_has(escaping, name) { return false }
    if !cg_bound_is_slice(b.bound) { return false }
    if !cg_slice_grow_elem_matches(b.bound, b.value.type) { return false }
    match b.value.kind {
        checker::TCall as c => cg_call_is_slice_grow(c)
        _ => false
    }
}

/**
 * cg_call_is_slice_grow — whether call `c` is a slice-growing intrinsic: `teko::list::push`,
 * `teko::list::with_cap`, or `teko::mem::push_fo` (the calls that bump-allocate a fresh slice buffer).
 *
 * @param c  the call
 * @return   true iff `c` grows a slice
 * @since 0.3.1
 */
fn cg_call_is_slice_grow(c: checker::TCall): bool {
    var segs = c.callee.segments
    if segs.len < 2 { return false }
    var last = segs[segs.len - 1].name
    var prev = segs[segs.len - 2].name
    (prev == "list" && (last == "push" || last == "with_cap")) || (prev == "mem" && last == "push_fo")
}

/**
 * str_list_has — linear membership test over a `[]str` (the A3 decls list is short, one entry per
 * block-local accumulator).
 *
 * @param xs     the list to search
 * @param name   the sought name
 * @return       true iff `name` occurs in `xs`
 * @since 0.3.1
 */
fn str_list_has(xs: []str, name: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == name { return true }
        i = i + 1
    }
    false
}

/**
 * cg_block_slice_accums — the names of the TOP-LEVEL block-local slice accumulators declared in block
 * `body` (A3). A binding qualifies iff it binds a `Slice`-typed SimpleName that `binding_is_block_local`
 * proves stays inside the block: its grown buffer is then routed to this block's region (R_decl) and
 * reclaimed at the block's exit edge. A slice that ESCAPES (return / capture) fails the proof and is
 * excluded — it stays on the leak-safe frame/root path, never region-scoped.
 *
 * @param prog       the typed program (unused today; kept for signature parity with the region helpers)
 * @param escaping   the function's escaping-name set
 * @param fn_body    the whole enclosing function body (the block-local proof's total-reads denominator)
 * @param body       the block whose top-level slice accumulators are collected
 * @param is_value   does `body` yield a value (its tail escapes)?
 * @return           the declared block-local slice accumulator names
 * @since 0.3.1
 */
fn cg_block_slice_accums(prog: CgProg, escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool): []str {
    var acc: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(escaping, fn_body, body, is_value, b) {
                    match b.target {
                        parser::SimpleName as sn => { acc = teko::list::push(acc, sn.name) }
                        parser::DestructurePattern => { }
                    }
                }
            }
            _ => { }
        }
        i = i + 1
    }
    acc
}

/**
 * cg_binding_is_block_local_slice — whether binding `b` is a `Slice`-typed block-local (A3): the shape
 * that earns a per-block region for its self-append accumulator buffer. Both the region-opening
 * decision (`cg_block_has_block_local`) and the decls map (`cg_block_slice_accums`) consult this ONE
 * predicate, so a region is opened exactly when — and only when — an accumulator will route into it.
 *
 * @param escaping   the function's escaping-name set
 * @param fn_body    the whole enclosing function body
 * @param body       the block `b` is declared at the top of
 * @param is_value   does `body` yield a value?
 * @param b          the typed binding
 * @return           true iff `b` is a block-local slice binding
 * @since 0.3.1
 */
fn cg_binding_is_block_local_slice(escaping: []str, fn_body: []@TStatement(), body: []@TStatement(), is_value: bool, b: checker::TBinding): bool {
    match b.bound {
        checker::Slice => checker::binding_is_block_local(escaping, fn_body, body, is_value, b)
        _ => false
    }
}

// (S2 — arena parent-ptr tree, 2026-07-01) the C EXPRESSION TEXT for the region a NEW
// `tk_region_new(...)` call should name as its parent: the innermost open block region if any,
// else the process root. Twin of the C `cg_enclosing_region_expr` for call sites that never see a
// live frame (VALUE-form if/match arms — C clears g_cg_frame="" before descending into those, so
// omitting the frame branch here is not a divergence, it is the SAME invariant expressed
// functionally instead of via a cleared global).
fn cg_enclosing_region_expr(regions: []RegionFrame): str {
    if regions.len > 0 { regions[regions.len - 1].name } else { "tk_region_root()" }
}
// The STATEMENT-form twin (if-stmt/match-stmt arms, loop bodies): these run WITHOUT a frame-clear
// in C (only the value-form arms clear it), so `frame` may still be live — fall back to it before
// the process root.
fn cg_enclosing_region_expr_framed(regions: []RegionFrame, frame: str): str {
    if regions.len > 0 { regions[regions.len - 1].name } else if frame != "" { frame } else { "tk_region_root()" }
}

/**
 * LoopDeferFrame — one active LOOP scope's defer + region boundary, captured at the loop's body entry.
 * A break/continue fires every defer registered at index ≥ the TARGET loop's `defer_base` (the scopes
 * it crosses) LIFO, and drops every region opened at index ≥ the TARGET loop's `region_base` (the
 * regions opened INSIDE the loop body). A loop opens a RegionFrame only when it has a block-local, so
 * loop boundaries ride this SEPARATE stack rather than the RegionFrame stack (the region-less-aware
 * twin). `label` ties the frame to its loop.
 *
 * @since 0.3.1 `region_base` is the RegionFrame-stack depth (regions.len) at the loop's body entry —
 *              the boundary above which regions were opened INSIDE this loop. break/continue drop
 *              exactly `regions[region_base..]`, so an ENCLOSING arm region (opened OUTSIDE the loop,
 *              below `region_base`) is never wrongly dropped by a region-less inner loop's break — the
 *              UAF an accumulator declared in an outer arm and grown in an inner loop would otherwise hit.
 */
type LoopDeferFrame = struct {
    /** the loop label ("" when unlabeled), matched by `break LABEL` / `continue LABEL`. */
    label: str
    /** the in-scope defer count (dctx.defers.len) at the loop's body entry. */
    defer_base: u64
    /** the RegionFrame-stack depth (regions.len) at the loop's body entry — the drop boundary. */
    region_base: u64
}

/**
 * DeferCtx — the threaded defer + coverage state (W9.3; the functional twin of the C's
 * g_cg_defers/g_cg_ndefers statics). One bundle so the whole emit path threads a SINGLE extra param.
 * A TDeferStmt appends to `defers` (emits nothing); a scope-block fires `[base, len)` LIFO at its exit
 * edge (fall-through / break / continue / return). (#265 Track A) `cov` rides this SAME thread — it
 * already reaches emit_stmt AND emit_expr_ctx AND every value-form if/match — so a single field
 * instruments every line/branch chokepoint (the A2/A3/A4 marks) with NO new call-site plumbing.
 */
type DeferCtx = struct {
    /** the live stack of registered TDeferStmt nodes (push order; `.len` == the C's ndefers). */
    defers: []@TStatement()
    /** the active loop-scope defer-base stack (for break/continue target firing). */
    loops: []LoopDeferFrame
    /** the coverage-instrumentation context; `cov.on == false` (the default) emits zero `tk_cov_*`. */
    cov: CovCtx
    /** (0.3.1 move-on-return A4/M1) the return-region C variable name (`_tkrr`, else "") — the region
     *  an ESCAPING allocation routes to so it survives the frame drop. Rides DeferCtx BECAUSE it must
     *  reach a self-append/binding deep inside a sub-scope UNSTRIPPED (unlike `frame`, which emit_block
     *  clears to "" for sub-scopes): an escaping accumulator grown in a loop of a framed function must
     *  still route to `_tkrr`, never the entered `_tkfr` it would fall into via the current region. */
    rr: str
    /** (0.3.1 move-on-return M2, Mechanism 1) the count of conveyance brackets (`tk_region_enter(_tkrr)`)
     *  currently OPEN at this emit point. A binding/assign whose name escapes wraps its RHS in
     *  `enter(_tkrr) … leave()` so a retained call-result materializes in `_tkrr` (§2a). A `return`/
     *  `break`/`continue` reached WHILE brackets are open must emit `bracket_depth` balancing leaves
     *  BEFORE its own frame leave/drops — the per-edge unwind, mirroring the defer/region-drop machinery
     *  so no exit edge leaves the current-region stack unbalanced (§2c). */
    bracket_depth: u64
}

// dctx_empty — the no-defers context (function entry / frameless sub-expression with no enclosing defers).
fn dctx_empty(): DeferCtx {
    DeferCtx { defers = teko::list::empty(); loops = teko::list::empty(); cov = cov_off(); rr = ""; bracket_depth = 0 }
}

// (W9.3) emit_defers — emit the deferred blocks at index ≥ `base` in LIFO order (innermost / most-recent
// first), each body statement via emit_stmt at the exit edge's `indent`. The functional twin of the C's
// emit_defers (which walks g_cg_defers[base..ndefers) backwards). A defer body never contains a return/
// break/continue/defer (checker-enforced), so each body statement emits with NO active region/defer
// scope of its own (regions/dctx empty) — exactly matching the C twin's emit_stmt at base context.
fn emit_defers(buf: []byte, defers: []@TStatement(), defer_floor: u64, prog: CgProg, indent: str, escaping: []str, fn_body: []@TStatement()): []byte | error {
    var out = buf
    var i = defers.len
    loop {
        if i <= defer_floor { break }
        i = i - 1
        match defers[i] {
            checker::TDeferStmt as d => {
                var j: u64 = 0
                loop {
                    if j >= d.body.len { break }
                    out = match emit_stmt(out, d.body[j], false, prog, checker::Void { }, indent, "", escaping, teko::list::empty(), fn_body, dctx_empty(), teko::list::empty(), false) { []byte as o => o; error as err => return err }
                    j++
                }
            }
            _ => { }
        }
    }
    out
}

// (W9.3) dctx_register — return `dctx` with statement `s` pushed onto the defer stack (used when a
// TDeferStmt is reached). Mirrors the C `g_cg_defers[g_cg_ndefers++] = s` registration (emits nothing).
fn dctx_register(dctx: DeferCtx, s: @TStatement()): DeferCtx {
    DeferCtx { defers = teko::list::push(dctx.defers, s); loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth }
}

// (W9.3) cg_append_direct_defers — append every TOP-LEVEL TDeferStmt in `body` (source order) onto
// `defers`. A block's fall-through fires its OWN direct defers `[base, base+count)` — reached only
// after the whole block ran, so ALL its direct defers are registered. The caller (emit_function /
// emit_exprstmt_tail tail-if branch / emit_match_tail arm) builds the full list with this, then fires
// `emit_defers([base, len))`. Same defer NODES as emit_block_tail's incremental accumulation, so the
// fired bytes match the C twin's emit_defers exactly. (C: g_cg_ndefers after the block emits.)
fn cg_append_direct_defers(defers: []@TStatement(), body: []@TStatement()): []@TStatement() {
    var out = defers
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TDeferStmt => { out = teko::list::push(out, body[i]) }
            _ => { }
        }
        i++
    }
    out
}

// (W9.3) cg_target_defer_base — the defer base of the break/continue TARGET loop (innermost matching
// `label`; bare label → innermost loop). Defers at index ≥ this base belong to the scopes the jump
// crosses (the target loop body inclusive + any arms inside it). Falls back to 0 if no match (the
// checker guarantees a break/continue is inside a loop — defensive). (C: cg_target_defer_base.)
fn cg_target_defer_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.defer_base }
        k = k - 1
    }
    0
}

/**
 * cg_target_region_base — the RegionFrame-stack depth at the entry of the break/continue TARGET loop
 * (the innermost loop for a bare jump, or the labeled loop for `break LABEL`). Regions at index ≥ this
 * base were opened INSIDE the target loop body and must drop on the jump; regions below it ENCLOSE the
 * loop and must NOT (the sibling of `cg_target_defer_base`).
 *
 * @param loops  the active loop-scope frame stack
 * @param label  the jump's target label ("" = innermost loop)
 * @return       the target loop's `region_base` (0 when no matching frame — drop nothing)
 * @since 0.3.1
 */
fn cg_target_region_base(loops: []LoopDeferFrame, label: str): u64 {
    var k = loops.len
    loop {
        if k == 0 { break }
        var lf = loops[k - 1]
        var is_target = if label.len == 0 { true } else { lf.label == label }
        if is_target { return lf.region_base }
        k = k - 1
    }
    0
}

/**
 * cg_drop_regions_from — drop (innermost-first) every region opened INSIDE the target loop body: the
 * frames at index ≥ `base` (the target loop's `region_base`). For break/continue the jump exits/
 * continues that loop, so every region opened inside it — the loop's own per-iteration region plus any
 * nested arm/loop regions — must drop; an ENCLOSING region below `base` is left intact (never the
 * accumulator's outer declaring region). Each handle is nulled so an overlapping edge re-drop is a
 * no-op (tk_region_drop is NULL-tolerant).
 *
 * @param buf      the output buffer
 * @param indent   the current indentation
 * @param regions  the open region-frame stack
 * @param base     the target loop's `region_base` (regions at index ≥ this drop)
 * @return         the buffer with the drops appended
 * @since 0.3.1
 */
fn cg_drop_regions_from(buf: []byte, indent: str, regions: []RegionFrame, defer_floor: u64): []byte {
    var out = buf
    var k = regions.len
    loop {
        if k <= defer_floor { break }
        var r = regions[k - 1]
        out = cb(out, indent); out = cb(out, "tk_region_drop("); out = cb(out, r.name); out = cb(out, "); "); out = cb(out, r.name); out = cb(out, " = NULL;\n")
        k = k - 1
    }
    out
}

// cg_drop_all_regions — drop EVERY active loop-body region (innermost-first). For a `return` edge
// (which leaves all enclosing loops) before the frame-region drop + the return value.
fn cg_drop_all_regions(buf: []byte, indent: str, regions: []RegionFrame): []byte {
    var out = buf
    var k = regions.len
    loop {
        if k == 0 { break }
        var r = regions[k - 1]
        out = cb(out, indent); out = cb(out, "tk_region_drop("); out = cb(out, r.name); out = cb(out, "); "); out = cb(out, r.name); out = cb(out, " = NULL;\n")
        k = k - 1
    }
    out
}

fn cg_binding_routes_box_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    match b.bound {
        checker::Variant as va => match cg_union_box_member(prog, va) {
            (@Type()) as _gt13 => match b.value.kind {
                checker::TNullLit => false
                _ => !cg_mangle_eq(b.bound, b.value.type)
            }
            null => false
        }
        _ => false
    }
}

/**
 * cg_binding_routes_str_to_local_region — whether binding `b` is a scope-routable str: a non-
 * `#singleton` `str` binding whose value is a `~` concat bridge or an interpolation (0.3.1
 * modelo-de-memoria §9, crumb C3). This is the SINGLE predicate that both opens the owning scope's
 * region (via `cg_block_has_block_local`) and drives the `tk_str_concat_r` routing (in
 * `emit_binding`), so the region is opened exactly when — and only when — a str binding will fill
 * it. `#singleton` is excluded: the residence oracle forces it to the Root tier.
 *
 * The block-locality proof (`binding_is_block_local`) is applied by the callers, not here; this
 * predicate answers only "is the SHAPE a scope-routable str", the str twin of
 * `cg_binding_routes_box_to_local_region`.
 *
 * @param prog  the typed program (for the concat-bridge query)
 * @param b     the typed binding
 * @return      true iff `b` is a str binding with a concat/interp value
 * @since 0.3.1
 */
fn cg_binding_routes_str_to_local_region(prog: CgProg, b: checker::TBinding): bool {
    if !cg_bound_is_str(b.bound) { return false }
    match b.value.kind {
        checker::TInterp => true
        checker::TCall as bc => cg_is_concat_bridge(prog, bc)
        _ => false
    }
}

// cg_block_has_block_local — does loop body B have any TOP-LEVEL binding proven BLOCK-local and
// region-routable? Drives whether emit_loop opens a region — none ⇒ no region ⇒ byte-identical to
// the pre-S2 output for that loop. `is_value` = whether B yields a value (loop bodies do NOT).
fn cg_block_has_block_local(prog: CgProg, escaping: []str, fn_body: []@TStatement(), block: []@TStatement(), is_value: bool): bool {
    var i: u64 = 0
    loop {
        if i >= block.len { break }
        match block[i] {
            checker::TBinding as b => {
                if cg_binding_is_block_local_slice(escaping, fn_body, block, is_value, b) { return true }
                if checker::binding_is_block_local(escaping, fn_body, block, is_value, b) {
                    if cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b) || cg_binding_routes_str_to_local_region(prog, b) { return true }
                }
            }
            _ => { }
        }
        i++
    }
    false
}

// emit_block — emit each statement in order; the first error short-circuits. `prog`/`ret_type`
// are threaded so a binding/return/match inside can wrap a case value into a variant slot
// (emit_as). S2: `regions`/`fn_body`/`cur_block`/`cur_block_is_value` thread the active loop-body
// region stack + the per-block escape context so a block-local binding routes to its region and
// break/continue/return drop the right regions. (C: `emit_block`.)
fn emit_block(buf: []byte, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    var out = buf
    // (W9.3) Accumulate THIS block's direct defers incrementally (a `return`/`break`/`continue` at
    // statement i then sees only the defers registered at 0..i-1). emit_block does NOT fire its own
    // fall-through — the CALLER (emit_loop / emit_block_region) fires `[base, base+direct)` after.
    var cur = dctx
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }   // register; emits nothing inline
            _ => {
                // emit_block is reached from SUB-SCOPE bodies. The FRAME region is leaked here (frame="" —
                // SAFE), but the S2 block-region stack IS carried so a loop body's block-locals are freed.
                out = match emit_stmt(out, s, in_main, prog, ret_type, indent, "", escaping, regions, fn_body, cur, cur_block, cur_block_is_value) { []byte as o => o; error as err => return err }
            }
        }
        i++
    }
    out
}

// emit_block_region — S2: emit an ARM block (if-then / if-else / match-arm body) in STATEMENT
// position. Treated EXACTLY like a loop body except the region is an ARM region (is_loop=false): it
// is opened at block entry when the block has a provably block-local binding (is_value=false — a
// statement-arm yields no consumed value), block-locals route to it, and it is dropped on the normal
// fall-through past the arm. break/continue/return inside the arm drop it via the region-stack
// helpers (break/continue CROSS it down to the target loop; return drops everything). No block-local
// binding ⇒ no region ⇒ byte-identical to emit_block (the pre-S2 statement-arm path). (C: emit_block_region.)
fn emit_block_region(buf: []byte, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    // (W9.3) EVERY statement-arm is a DEFER SCOPE — even with no S2 region — so a defer inside the arm
    // fires at the arm's fall-through (before the arm's region, if any, drops). `base` = the in-scope
    // defer count at arm entry; the fall-through fires `[base, base+direct)` LIFO.
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, body)   // all of THIS arm's direct defers, in scope at fall-through
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, body, false) && regions.len < 64
    if !want_block {
        // No S2 region — region-less defer-only scope: emit the body, then fire the arm's defers at fall-through.
        var out = match emit_block(buf, body, in_main, prog, ret_type, indent, escaping, regions, fn_body, dctx, teko::list::empty(), false) { []byte as o => o; error as err => return err }
        return emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body)
    }
    // Open the arm region. Name by the buffer length at the creation point (the deterministic
    // `_tkbr<len>` uniquifier — matches the C twin's b->len read without a counter).
    var region = fresh_named("_tkbr", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = tk_region_new("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, body, false) })
    // Emit the body with THIS block as the current block context (so block-local bindings route to
    // `region`) and the augmented region stack.
    out = match emit_block(out, body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, body, false) { []byte as o => o; error as err => return err }
    // (W9.3) Normal fall-through exit edge: fire THIS arm's defers (LIFO) FIRST (so a defer body can
    // still read the arm's block-locals), THEN drop the arm region (idempotent + nulled for overlap).
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, "tk_region_drop("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

// emit_exprstmt_tail — W5a: emit a TRAILING expr-statement (a block's last statement) as an
// IMPLICIT RETURN of its value (a block's trailing NORMAL value is the
// function's/main's value — B.20). A trailing `if` is lowered as DIRECT control flow (each
// branch recursively tail-emitted), so `return`/`break`/`continue` inside a branch propagate
// via C's own semantics. This direct form works whether the
// trailing `if` is typed as a value (a function-body tail) or as `void` (a virtual-main tail,
// which the checker types as a statement but still yields a branch value). A void
// expr-statement, or any non-expr trailing statement, emits normally (no value).
// (C: `emit_exprstmt_tail`.)
fn emit_exprstmt_tail(buf: []byte, x: checker::TExpr, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    match x.kind {
        checker::TIfExpr as f => {
            var bh = emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent)
            // A trailing if/else returns on each branch; the frame region is NOT threaded into the
            // branch tails (frame="" → those returns simply LEAK the region — SAFE, M.5), keeping
            // this first cut's drop-routing confined to the linear top-level path. S2 — the REAL
            // `escaping` set IS threaded so a statement-arm inside a tail branch (emit_block_region via
            // emit_if_stmt/emit_match_stmt) gets the correct block-locality (matches the C twin's global
            // g_cg_escaping — without it the predicate sees an empty set and false-positives a region).
            // No else branch: emit as a control-flow statement; fall-through handled by caller's default return.
            if !f.has_else { return emit_if_stmt(bh, f, x.line, x.col, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, dctx, teko::list::empty(), false) }
            var out = cb(bh, indent)
            out = cb(out, "if (")
            out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }
            out = cb(out, ") {\n")
            var inner = cb_indent_deeper(indent)
            out = emit_cov_branch(out, dctx.cov, x.line, x.col, 0, inner)
            // (W9.3) each tail branch is a DEFER SCOPE: fire its defers at the branch's fall-through exit
            // (before the closing `}`), UNLESS its tail already C-terminated (drained on that edge).
            var then_base = dctx.defers.len
            out = match emit_block_tail(out, f.then_blk, in_main, prog, ret_type, inner, "", escaping, fn_body, dctx) { []byte as o => o; error as err => return err }
            var then_term = if f.then_blk.len > 0 { cg_stmt_c_terminates(f.then_blk[f.then_blk.len - 1]) } else { false }
            if !then_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, f.then_blk), then_base, prog, inner, escaping, fn_body) { []byte as o => o; error as err => return err } }
            out = cb(out, indent)
            out = cb(out, "} else {\n")
            out = emit_cov_branch(out, dctx.cov, x.line, x.col, 1, inner)
            var else_base = dctx.defers.len
            out = match emit_block_tail(out, f.else_blk, in_main, prog, ret_type, inner, "", escaping, fn_body, dctx) { []byte as o => o; error as err => return err }
            var else_term = if f.else_blk.len > 0 { cg_stmt_c_terminates(f.else_blk[f.else_blk.len - 1]) } else { false }
            if !else_term { out = match emit_defers(out, cg_append_direct_defers(dctx.defers, f.else_blk), else_base, prog, inner, escaping, fn_body) { []byte as o => o; error as err => return err } }
            out = cb(out, indent)
            cb(out, "}\n")
        }
        // W5b — a trailing `match` lowers as a control-flow `if` chain whose arms `return`
        // (mirrors the trailing `if`); each arm body is wrapped to the return slot via emit_as.
        checker::TMatchExpr as m => emit_match_tail(emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent), prog, x, m, in_main, ret_type, indent, escaping, fn_body, dctx)
        _ => {
            var bl = emit_cov_lines(buf, dctx.cov, cov_collect_expr(x, teko::list::empty()), indent)
            if is_void_type(x.type) {   // a void expr-statement carries no value → run for effect
                var out = cb(bl, indent)
                out = match emit_expr_ctx(out, prog, checker::Void { }, x, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }
                out = cb(out, ";\n")
                // (W9.3) Drain the FUNCTION-BODY defers (base 0) at the end of a void-returning body.
                // Inner-scope defers already fired+popped at their own scope exits, so dctx.defers here
                // is only the function-body-level defers.
                return emit_defers(out, dctx.defers, 0, prog, indent, escaping, fn_body)
            }
            // (W9.3) Drain function-body defers (base 0) before the implicit trailing-value return.
            var out = match emit_defers(bl, dctx.defers, 0, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
            // (W10b.CLASS increment 4) DESTRUCTION HOOK — the implicit tail-value-return EDGE.
            // Independent of `frame.len > 0`: a frame-local class instance needs this even when no
            // OTHER struct auto-box makes the function open a frame region at all.
            if !in_main {
                var cleanup = match cg_class_cleanup_text(prog, escaping, fn_body, true, x) { str as c => c; error as e => return e }
                if cleanup.len > 0 { out = cb(out, indent); out = cb(out, cleanup); out = cb(out, "\n") }
            }
            if !in_main {
                out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
                out = cg_return_frame_exit(out, indent, frame, dctx)
            }
            out = cb(out, indent)
            if in_main {
                out = cb(out, CG_MAIN_RETURN_OPEN)
                out = match emit_expr_ctx(out, prog, checker::Void { }, x, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }
                return cb(out, CG_MAIN_RETURN_CLOSE)
            }
            out = cb(out, "return ")
            out = match emit_as_r(out, prog, ret_type, ret_type, x, escaping, teko::list::empty(), fn_body, dctx) { []byte as o => o; error as err => return err }   // W5b — wrap a case value into a variant return slot (ret_type threaded for diverging arms)
            cb(out, ";\n")
        }
    }
}

// emit_block_tail — W5a: emit a FUNCTION/MAIN/branch body where the LAST statement, if it is
// an expr-statement carrying a value, `return`s that value (via emit_exprstmt_tail). All but
// the last statement emit normally. (C: `emit_block_tail`.)
fn emit_block_tail(buf: []byte, body: []@TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var out = buf
    // (W9.3) Accumulate THIS block's own direct defers incrementally as we iterate, so a `return` at
    // statement i fires only the defers registered at statements 0..i-1 (LIFO, all enclosing scopes).
    // emit_block_tail does NOT fire its OWN fall-through defers — the CALLER does (emit_function fires
    // base 0 for a non-expr/non-terminating tail; emit_exprstmt_tail's if-branch and emit_match_tail's
    // arm fire `[branch_base, …)`). (C: emit_block_tail accumulates via g_cg_ndefers; firing is external.)
    var cur = dctx
    var i: u64 = 0
    loop {
        if i + 1 >= body.len { break }
        var s = body[i]
        match s {
            checker::TDeferStmt => { cur = dctx_register(cur, s) }   // register; emits nothing inline
            _ => {
                // S2: tail-level statements have NO active loop-body region (regions empty) and NO block
                // routing context (cur_block empty) — a LOOP among them opens its own region via emit_loop
                // (which gets fn_body, cur for the per-block escape read counts). Frame routing rides `frame`.
                out = match emit_stmt(out, s, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, cur, teko::list::empty(), false) { []byte as o => o; error as err => return err }
            }
        }
        i++
    }
    if body.len == 0 { return out }
    var last = body[body.len - 1]
    match last {
        checker::TDeferStmt => out   // a trailing defer registers nothing observable (its fire is the caller's fall-through)
        checker::TExprStmt as es => emit_exprstmt_tail(out, es.expr, in_main, prog, ret_type, indent, frame, escaping, fn_body, cur)
        _ => emit_stmt(out, last, in_main, prog, ret_type, indent, frame, escaping, teko::list::empty(), fn_body, cur, teko::list::empty(), false)
    }
}

/**
 * emit_if_stmt — W5a: emit an `if` in STATEMENT position as plain C control flow
 * (`if (<cond>) { <then…> } [else { <else…> }]`). Each branch is emitted via emit_block_region
 * (NON-tail, value discarded), so `break`/`continue`/`return` inside a branch propagate via C's own
 * semantics — a statement-position `if` is pure CONTROL FLOW,
 * never the value path. (The TAIL `if` takes emit_exprstmt_tail; a SUB-expression `if` takes
 * emit_if_value; this is the INTERIOR statement case.)
 *
 * (#265 Track A, A3) `line`/`col` are the if-node's own position (the enclosing TExpr's e.line/e.col,
 * matching cov_addsite in teko::coverage): a `tk_cov_branch_at(fn, line, col, 0)` heads the then-block and a
 * `tk_cov_branch_at(fn, line, col, 1)` heads the else. The else mark is SYNTHESIZED even when the
 * source has no `else` (an empty skip-path `else {}` carrying only the mark) — the static walk always
 * counts 2 outcomes, so without the outcome-1 mark the branch floor is unreachable at 100%. The
 * synthesized `else` and both marks are gated on `dctx.cov.on`, so non-cov output is byte-identical.
 *
 * @param buf                the emission buffer
 * @param f                  the typed if-expression (cond + then/else blocks)
 * @param line               the if-node's source line (the branch site key)
 * @param col                the if-node's source column (the branch site key)
 * @param in_main            true iff this if sits directly in the virtual main
 * @param prog               the typed program
 * @param ret_type           the enclosing function's return type
 * @param indent             the C indentation of the `if`
 * @param frame              the active frame-region name ("" = none)
 * @param escaping           the escape set for block-locality of branch bindings
 * @param regions            the enclosing region-frame stack
 * @param fn_body            the enclosing function body (for block-locality analysis)
 * @param dctx               the threaded defer + coverage context
 * @param cur_block          the current block routing context
 * @param cur_block_is_value whether the current block is in value position
 * @return                   the buffer with the lowered `if` appended
 * @throws                   the first emission error from the condition or a branch body
 */
fn emit_if_stmt(buf: []byte, f: checker::TIfExpr, line: u32, col: u32, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    var out = cb(buf, indent)
    out = cb(out, "if (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, f.cond, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, ") {\n")
    var inner = cb_indent_deeper(indent)
    out = emit_cov_branch(out, dctx.cov, line, col, 0, inner)
    // S2 — each statement-position branch gets its OWN arm region (emit_block_region) for its provably
    // block-local bindings, dropped at the branch's fall-through / via the region stack on break/
    // continue/return. A branch with no block-local binding opens none → byte-identical. (The enclosing
    // `regions`/`fn_body` are threaded so a break/continue/return inside a branch drops the right regions.)
    out = match emit_block_region(out, f.then_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    if f.has_else {
        out = cb(out, indent)
        out = cb(out, "} else {\n")
        out = emit_cov_branch(out, dctx.cov, line, col, 1, inner)
        out = match emit_block_region(out, f.else_blk, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    } else if dctx.cov.on {
        out = cb(out, indent)
        out = cb(out, "} else {\n")
        out = emit_cov_branch(out, dctx.cov, line, col, 1, inner)
    }
    out = cb(out, indent)
    cb(out, "}\n")
}

// emit_binding — a TBinding. BindTarget: only SimpleName is lowered for M0 (destructuring
// is the honest barrier). `const` prefix for a const binding; the type rides `.bound`.
// (C: TK_TSTMT_BINDING branch.)
fn emit_binding(buf: []byte, prog: CgProg, ret_type: @Type(), b: checker::TBinding, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    var name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return error { message = "codegen: destructuring binding not yet supported" }
    }
    // `let _ = expr` — DISCARD: evaluate for effect, no C variable (so repeated `let _`
    // never collide). A `return`/divergence inside the value still propagates via C.
    if name == "_" {
        var dout = cb(buf, indent)
        dout = cb(dout, "(void)(")
        dout = match emit_as_r(dout, prog, ret_type, b.bound, b.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(dout, ");\n")
    }
    var out = cb(buf, indent)
    if b.kind == parser::BindKind::Const { out = cb(out, "const ") }
    out = match emit_type(out, prog, b.bound) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb_ident(out, name)
    out = cb(out, " = ")
    if cg_binding_grows_escaping_slice(escaping, dctx, b) {
        match b.value.kind {
            checker::TCall as c => {
                var last = c.callee.segments[c.callee.segments.len - 1].name
                if last == "with_cap" {
                    out = match emit_list_with_cap(out, prog, b.value, c, escaping, regions, fn_body, dctx, dctx.rr) { []byte as o => o; error as err => return err }
                } else {
                    out = match emit_list_push(out, prog, b.value, c, escaping, regions, fn_body, dctx, dctx.rr) { []byte as o => o; error as err => return err }
                }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    // MEM Step 1 — FRAME-LOCAL routing. When a frame region is active AND the escape check proved
    // this binding frame-local (a `let`/`mut` SimpleName, NOT escaping, value = a struct-init), emit
    // the struct-init with its DIRECT auto-box routed to the frame region (freed at the exit edge),
    // bypassing emit_as_r. We take this bypass ONLY when NO variant/optional wrapping is needed —
    // the declared type `b.bound` is the SAME named STRUCT as the value's type (e.g. `let n = Node{…}`,
    // not `let p: Pattern = LiteralPattern{…}`). When a wrap is needed we fall through to the generic
    // wrapping path, which now also routes boxed-union payloads into the same local region when the
    // binding is proven local.
    // The value never escapes, so freeing it at function exit is safe.
    // S2 — BLOCK-LOCAL routing TAKES PRECEDENCE: when this binding sits in a loop body that opened
    // its own region AND the per-block escape check proved it block-local, route its auto-box to the
    // INNERMOST block region (`_tkbr<len>`, freed per-iteration) instead of the frame. The block
    // region is tighter ⇒ freed sooner; soundness holds because binding_is_block_local is a subset.
    if regions.len > 0 && cur_block.len > 0 && cg_same_named_struct(b.bound, b.value.type) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        match b.value.kind {
            checker::TStructInit as si => {
                out = match emit_struct_init_framed(out, prog, b.value, si, regions[regions.len - 1].name, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if regions.len > 0 && cur_block.len > 0 && cg_binding_routes_str_to_local_region(prog, b) && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) {
        var str_region = regions[regions.len - 1].name
        match b.value.kind {
            checker::TInterp as bin => {
                out = match emit_interp(out, prog, bin, str_region, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            checker::TCall as bc => {
                if cg_is_concat_bridge(prog, bc) {
                    out = match emit_concat_fold(out, prog, bc.args[0], str_region, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                    return cb(out, ";\n")
                }
            }
            _ => { }
        }
    }
    if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_same_named_struct(b.bound, b.value.type) {
        match b.value.kind {
            checker::TStructInit as si => {
                out = match emit_struct_init_framed(out, prog, b.value, si, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    var box_region = if regions.len > 0 && cur_block.len > 0 && checker::binding_is_block_local(escaping, fn_body, cur_block, cur_block_is_value, b) && cg_binding_routes_box_to_local_region(prog, b) {
        regions[regions.len - 1].name
    } else if frame.len > 0 && checker::binding_is_frame_local(escaping, b) && cg_binding_routes_box_to_local_region(prog, b) {
        frame
    } else {
        ""
    }
    // W5b — if the binding's declared type is a variant and the value is a case member, WRAP it into
    // the variant repr (`let s: Shape = Circle { … }`). emit_as_r threads ret_type so a value-form
    // `match`/`if` value with a diverging `return` arm wraps that return into the FUNCTION's slot.
    out = match emit_as_r_in(out, prog, ret_type, b.bound, b.value, box_region, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ";\n")
}

// emit_assign — a TAssign -> `x op= v;`. (C: TK_TSTMT_ASSIGN branch.)
// (#88) emit the C lvalue for whichever of the three assign-target shapes applies: a bare identifier
// (Simple), a Ref<T> handle's `(*name)` pointer deref (RefDeref), or a struct/class FIELD path (the
// typed LHS field-access — emit_expr produces `(*recv).f` for a class, `recv.f` for a struct). All three
// are pure, side-effect-free lookups, so it is safe to emit the lvalue text twice (the shift path does).
fn emit_assign_lvalue(buf: []byte, prog: CgProg, a: checker::TAssign): []byte | error {
    match a.kind {
        parser::AssignKind::Field => emit_expr(buf, prog, a.target)
        _ => {
            if a.deref {
                var out = cb(buf, "(*")
                out = cb_ident(out, a.name)
                cb(out, ")")
            } else {
                cb_ident(buf, a.name)
            }
        }
    }
}

/**
 * emit_index_assign — a slice element store `ids[i] op= v` (`AssignKind::Index`). Captures the
 * receiver slice and the index into single-eval temps, bounds-checks the index against `.len` (the
 * SAME positioned `tk_panic_oob_at` as a read subscript), then writes the element in place through
 * the shared `{ptr,len}` buffer. A shift-assign (`<<=`/`>>=`) routes through the width-masked
 * `tk_shl_/tk_shr_` runtime helper — matching the bare `<<`/`>>` operator — instead of the
 * UB-prone C compound shift; every other op emits the plain C compound store.
 *
 * @param buf       the output buffer
 * @param prog      the typed program (type/name lowering)
 * @param ret_type  the enclosing function's return type (threaded to `emit_as_r`)
 * @param a         the typed index assignment (`a.target` is the typed `TIndex` LHS)
 * @param indent    the current statement indent
 * @param escaping  the frame's escaping-name set (threaded to child expr emission)
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body (escape context)
 * @param dctx      the defer context
 * @return          the buffer with the element-store block appended, or a codegen error
 * @throws          when the target is not a slice index, its element type is unsupported, or a child
 *                  expression fails to emit
 */
fn emit_index_assign(buf: []byte, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var ix = match a.target.kind { checker::TIndex as ti => ti; _ => return error { message = "codegen: index-assign target is not a subscript (internal)" } }
    var elem = match ix.receiver.type { checker::Slice as sl => sl.element; _ => return error { message = "codegen: index-assign receiver is not a slice (internal)" } }
    var wstmp = $"_ws{buf.len}"
    var witmp = $"_wi{buf.len + 1}"
    var out = cb(buf, indent)
    out = cb(out, "{ ")
    out = match emit_type(out, prog, ix.receiver.type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, wstmp)
    out = cb(out, " = (")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.receiver, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); uint64_t ")
    out = cb(out, witmp)
    out = cb(out, " = (uint64_t)(")
    out = match emit_expr_ctx(out, prog, checker::Void { }, ix.index, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, "); if (")
    out = cb(out, witmp)
    out = cb(out, " < ")
    out = cb(out, wstmp)
    out = cb(out, ".len) { ")
    out = match emit_index_store_body(out, prog, ret_type, a, wstmp, witmp, elem, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, " } else { tk_panic_oob_at(")
    out = cb(out, teko::u64_to_str(a.target.line to u64))
    out = cb(out, ", ")
    out = cb(out, teko::u64_to_str(a.target.col to u64))
    cb(out, "); }\n }\n")
}

/**
 * emit_index_store_body — the in-bounds element write of `emit_index_assign`: `<slot> op= <value>`,
 * where `<slot>` is `<wstmp>.ptr[<witmp>]` (both already single-eval temps, so re-emitting the slot
 * for a shift-assign is free) and `<value>` is wrapped into the element type via `emit_as_r`.
 *
 * @param buf       the output buffer
 * @param prog      the typed program
 * @param ret_type  the enclosing function's return type (threaded to `emit_as_r`)
 * @param a         the typed index assignment (for its op + value)
 * @param wstmp     the captured-slice temp name
 * @param witmp     the captured-index temp name
 * @param elem      the slice element type (the store's declared `bound`)
 * @param escaping  the frame's escaping-name set
 * @param regions   the active region frames
 * @param fn_body   the enclosing function body
 * @param dctx      the defer context
 * @return          the buffer with the element store appended, or a codegen error
 * @throws          when a shift-assign targets a non-integer element, or a child expression fails to emit
 */
fn emit_index_store_body(buf: []byte, prog: CgProg, ret_type: @Type(), a: checker::TAssign, wstmp: str, witmp: str, elem: @Type(), escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match elem { checker::Prim as p => p; _ => return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        if !cg_prim_is_int(prim.kind) { return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        var tag = match prim_int_tag(prim.kind) { str as t => t; error => return error { message = "codegen: shift-assign on a non-integer slice element not supported" } }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        var so = emit_index_slot(buf, wstmp, witmp)
        so = cb(so, " = ")
        so = cb(so, fn_prefix)
        so = cb(so, tag)
        so = cb(so, "(")
        so = emit_index_slot(so, wstmp, witmp)
        so = cb(so, ", ")
        so = match emit_expr_ctx(so, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(so, ");")
    }
    var op = match assignop_c(a.op) { str as s => s; error as err => return err }
    var out = emit_index_slot(buf, wstmp, witmp)
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    out = match emit_as_r(out, prog, ret_type, elem, a.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ";")
}

/**
 * emit_index_slot — the C lvalue text `<wstmp>.ptr[<witmp>]` for a captured slice/index temp pair.
 *
 * @param buf    the output buffer
 * @param wstmp  the captured-slice temp name
 * @param witmp  the captured-index temp name
 * @return       the buffer with the element lvalue appended
 */
fn emit_index_slot(buf: []byte, wstmp: str, witmp: str): []byte {
    var out = cb(buf, wstmp)
    out = cb(out, ".ptr[")
    out = cb(out, witmp)
    cb(out, "]")
}

fn emit_assign(buf: []byte, prog: CgProg, ret_type: @Type(), a: checker::TAssign, indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var is_index = match a.kind { parser::AssignKind::Index => true; _ => false }
    if is_index { return emit_index_assign(buf, prog, ret_type, a, indent, escaping, regions, fn_body, dctx) }
    var op = match assignop_c(a.op) { str as s => s; error as err => return err }
    var out = cb(buf, indent)
    // (S2 Level-1) SELF-APPEND to a non-escaping slice → route the grown buffer to the frame region
    // `_tkfr` (bulk-freed at every fn-exit edge). Emit the push directly with the frame threaded, so the
    // whole buffer history (geometric doublings + in-place tail) dies with the frame. Guarded by
    // frame.len (the region exists only when fn_body_has_frame_local opened it) and the SHARED predicate
    // checker::assign_routes_to_frame, which mirrors the escape carve-out so the two never disagree.
    // (#148 S2 Level-2) a PROVEN-LINEAR self-append (born from empty(), self-append-only writes,
    // no capture before the fn-final statement) may FREE the old buffer on every copy-grow —
    // realloc parity with the hand-written C twin. Takes precedence over Level-1 frame routing
    // (the free-list is root-only; the proof admits ESCAPING chains too, which Level-1 cannot).
    if checker::assign_frees_old(fn_body, a) {
        match a.value.kind {
            checker::TCall as c => {
                out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
                out = cb(out, " = ")
                out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, "@fo") { []byte as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    if checker::assign_routes_to_frame(escaping, a) {
        var accum_region = scope_region_of(regions, a.name)
        var target = if accum_region.len > 0 { accum_region } else { frame }
        if target.len > 0 {
            match a.value.kind {
                checker::TCall as c => {
                    out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
                    out = cb(out, " = ")
                    out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, target) { []byte as o => o; error as err => return err }
                    return cb(out, ";\n")
                }
                _ => { }
            }
        }
    }
    if cg_self_append_escapes(escaping, dctx, a) {
        match a.value.kind {
            checker::TCall as c => {
                out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
                out = cb(out, " = ")
                out = match emit_list_push(out, prog, a.value, c, escaping, regions, fn_body, dctx, dctx.rr) { []byte as o => o; error as err => return err }
                return cb(out, ";\n")
            }
            _ => { }
        }
    }
    // #61 — `<<=`/`>>=` must NOT emit the raw C compound operator: an out-of-range shift count
    // is C UB natively; the contract (#49) is a DEFINED width-masked
    // result. Rewrite as `lvalue = tk_shl_<w>(lvalue, rhs)` / tk_shr_<w>, routing through the
    // SAME teko_rt.h helpers the binary `<<`/`>>` operator uses (emit_shift). SAFE to evaluate
    // the lvalue twice: the assign-statement grammar (parse_stmt) admits only two lvalue shapes
    // — a bare identifier (`a.name`), or (when `a.deref`) a Ref<T> handle's `(*name)` pointer
    // dereference — never a struct field path, an array index, or a call. Both forms are pure,
    // side-effect-free symbol lookups, so re-emitting the lvalue text a second time is cost-free.
    if a.op == lexer::TokenKind::ShlEq || a.op == lexer::TokenKind::ShrEq {
        var prim = match a.bound {
            checker::Prim as p => p
            _ => return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        if !cg_prim_is_int(prim.kind) {
            return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        var tag = match prim_int_tag(prim.kind) {
            str as t => t
            error => return error { message = "codegen: shift-assign on a non-integer type not yet supported" }
        }
        var fn_prefix = if a.op == lexer::TokenKind::ShlEq { "tk_shl_" } else { "tk_shr_" }
        out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
        out = cb(out, " = ")
        out = cb(out, fn_prefix)
        out = cb(out, tag)
        out = cb(out, "(")
        out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
        out = cb(out, ", ")
        out = match emit_expr_ctx(out, prog, checker::Void { }, a.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        out = cb(out, ")")
        return cb(out, ";\n")
    }
    if a.op == lexer::TokenKind::SlashEq || a.op == lexer::TokenKind::PercentEq {
        return emit_div_mod_assign(out, prog, a, escaping, regions, fn_body, dctx)
    }
    // (MEM-1b-ii) `r.value op= v` — write THROUGH the reference: the handle `r` IS the pointer, so the
    // lvalue is `(*r)`. (`Ref<T>` lowers to a bare `<T> *`; deref-assign is a plain C pointer store.)
    // (#88) a FIELD target emits the typed LHS field-access (`(*recv).f` for a class — an in-place write
    // the aliased pointer observes; `recv.f` for a struct). emit_assign_lvalue selects the shape.
    out = match emit_assign_lvalue(out, prog, a) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    out = cb(out, op)
    out = cb(out, " ")
    // Wrap the value into the target's declared type (`bound`) — a case → its variant, a fitting
    // literal — exactly like a binding (emit_as_r threads ret_type for a diverging value-form arm).
    // Without this, a case value (e.g. `node = NamedType { … }`, node: TypeExpr, a variant)
    // emitted the case's fields under the variant's C type → a field-designator error.
    out = match emit_as_r(out, prog, ret_type, a.bound, a.value, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ";\n")
}

/**
 * emit_return — a `TReturn` statement, lowered to C. `in_main` selects the return shape, which is
 * the whole reason this function takes the flag: inside the virtual-main a `return n` is an EARLY
 * PROCESS EXIT, so it emits `CG_MAIN_RETURN_OPEN`/`CG_MAIN_RETURN_CLOSE` (the `tk_exit_status`-
 * normalized exit code — one code on every platform, owner ruling 2026-07-30) and a bare `return`
 * emits `return 0;`; inside an ordinary function it is the plain `return [v];`, with a case value
 * wrapped into its variant return slot (W5b). Every exit edge first fires the in-scope defers
 * (LIFO, innermost block first), then runs the class destruction hook, then drops the block
 * regions innermost-first and finally the frame region.
 *
 * @param buf        the output byte buffer to append the emitted C to
 * @param prog       the whole typed program
 * @param r          the typed `return` node (whether it carries a value, and the value)
 * @param in_main    whether this `return` sits in the virtual-main (an exit code) or in a function
 * @param ret_type   the enclosing function's declared return type (the variant return slot)
 * @param indent     the current indentation string
 * @param frame      the enclosing region-frame expression, or `""` when the function opened none
 * @param escaping   the names whose values escape the current frame
 * @param regions    the active block-region stack, innermost last
 * @param fn_body    the enclosing function's body, for the block-local escape query
 * @param dctx       the defer context whose pending defers this edge must fire
 * @return           the buffer with the `return` (and its cleanup prologue) appended
 * @throws           when a defer body, the class-cleanup text or the returned expression fails to
 *                   emit
 * @see              CG_MAIN_RETURN_OPEN
 */
fn emit_return(buf: []byte, prog: CgProg, r: checker::TReturn, in_main: bool, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    // (W9.3) A `return` leaves EVERY enclosing scope: fire ALL in-scope defers (base 0) LIFO — one
    // sweep, innermost-block-first across all nesting — BEFORE dropping any region, so a defer body can
    // still read any block-local. THEN drop all block regions (innermost-first), THEN the frame region.
    var out = match emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
    // S2 — a `return` leaves EVERY enclosing loop, so drop all active block regions (innermost-first),
    // THEN the frame region. The return value is escaping ⇒ in root ⇒ safe to read post-drop.
    out = cg_drop_all_regions(out, indent, regions)
    // (W10b.CLASS increment 4) DESTRUCTION HOOK — an explicit `return` leaves every enclosing scope,
    // same as the frame-region drop below; independent of `frame.len > 0` for the same reason as the
    // other two edges (emit_exprstmt_tail / emit_function's fall-through).
    var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
    var cleanup = if r.has_value {
        match cg_class_cleanup_text(prog, escaping, fn_body, true, r.value) { str as c => c; error as e => return e }
    } else {
        match cg_class_cleanup_text(prog, escaping, fn_body, false, no_tail) { str as c => c; error as e => return e }
    }
    if cleanup.len > 0 { out = cb(out, indent); out = cb(out, cleanup); out = cb(out, "\n") }
    out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
    out = cg_return_frame_exit(out, indent, frame, dctx)
    out = cb(out, indent)
    if !r.has_value {
        if in_main { return cb(out, "return 0;\n") }
        return cb(out, "return;\n")
    }
    var ret_regions: []RegionFrame = teko::list::empty()
    if in_main {
        out = cb(out, CG_MAIN_RETURN_OPEN)
        out = match emit_expr_ctx(out, prog, checker::Void { }, r.value, escaping, ret_regions, fn_body, dctx) { []byte as o => o; error as err => return err }
        return cb(out, CG_MAIN_RETURN_CLOSE)
    }
    out = cb(out, "return ")
    // W5b — wrap a case value into a variant return slot.
    out = match emit_as_r(out, prog, ret_type, ret_type, r.value, escaping, ret_regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ";\n")
}

/**
 * emit_loop — a TLoopStmt. When `init` is EMPTY (infinite / while loop), this emits the bare
 * `while (1) { … }` unchanged (byte-identical to pre-#517). When `init` is non-empty (range /
 * 3-part / for-each), the loop is wrapped in a `{ … }` C scope so the run-once preamble bindings
 * (`i` / `_hi` / `_first` / `_it`) live loop-locally and do NOT leak past the loop, then the
 * `while (1)` loop is emitted one indent deeper. The loop MECHANISM itself (continue-target,
 * break-target, region, defers) is emitted by `emit_loop_while` and is UNTOUCHED (#517).
 *
 * @param buf the output byte buffer
 * @param l the typed loop node (label + init + body)
 * @param in_main whether this loop is emitted inside `main`
 * @param prog the whole typed program
 * @param ret_type the enclosing function's return type
 * @param indent the current indentation string
 * @param frame the enclosing region-frame expression
 * @param escaping the names whose values escape the current frame
 * @param regions the active region-frame stack
 * @param fn_body the enclosing function's body (for block-local analysis)
 * @param dctx the defer context
 * @return the buffer with the loop emitted, or a codegen error
 */
fn emit_loop(buf: []byte, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    if l.init.len == 0 { return emit_loop_while(buf, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx) }
    var out = cb(buf, indent)
    out = cb(out, "{\n")
    var inner = cb_indent_deeper(indent)
    out = match emit_block(out, l.init, in_main, prog, ret_type, inner, escaping, regions, fn_body, dctx, teko::list::empty(), false) { []byte as o => o; error as err => return err }
    out = match emit_loop_while(out, l, in_main, prog, ret_type, inner, frame, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    out = cb(out, indent)
    out = cb(out, "}\n")
    out
}

/**
 * emit_loop_while — emit a TLoopStmt's `while (1) { … }` core (the #517-UNTOUCHED loop mechanism).
 * A LABELED loop (M.5) gets a continue-target `tk_lbl_<NAME>_cont: ;` at the TOP of its body (so
 * `continue L` lowers to `goto tk_lbl_<NAME>_cont;`, re-running the body == the next while(1)
 * iteration) and a break-target `tk_lbl_<NAME>_break: ;` AFTER the loop (so `break L` lowers to
 * `goto …_break;`). A bare loop is unchanged. (C: TK_TSTMT_LOOP branch; C grew the inner indent
 * with snprintf.)
 *
 * @param buf the output byte buffer
 * @param l the typed loop node (label + body; `init` already emitted by the caller)
 * @param in_main whether this loop is emitted inside `main`
 * @param prog the whole typed program
 * @param ret_type the enclosing function's return type
 * @param indent the current indentation string
 * @param frame the enclosing region-frame expression
 * @param escaping the names whose values escape the current frame
 * @param regions the active region-frame stack
 * @param fn_body the enclosing function's body (for block-local analysis)
 * @param dctx the defer context
 * @return the buffer with the while-loop emitted, or a codegen error
 */
fn emit_loop_while(buf: []byte, l: checker::TLoopStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var labeled = l.label.len > 0
    var out = cb(buf, indent)
    out = cb(out, "while (1) {\n")
    var inner = cb_indent_deeper(indent)
    // a labeled loop gets a continue-target at the TOP of its body.
    if labeled { out = cb(out, inner); out = cb(out, "tk_lbl_"); out = cb_str(out, l.label); out = cb(out, "_cont: ;\n") }
    // S2 — open this loop body's OWN region when it has a provably block-local binding. The region var
    // is created AT THE TOP OF THE BODY (after the continue-target, so a labeled `continue L`'s goto
    // re-runs tk_region_new — a fresh region every iteration) and dropped at every exit edge. The name
    // rides out.len at the creation point (the `_bx<len>` uniquifier) so it matches the C twin exactly.
    // A loop with NO block-local binding opens no region → byte-identical to the pre-S2 output.
    // Cap nesting at 64 active block regions to match the C twin's fixed stack (beyond that the
    // region is not opened — a safe leak). Not reachable in real code (64 nested recursive-struct loops).
    // (W9.3) The loop body is ALWAYS a DEFER SCOPE (and a break/continue target) — even with no S2
    // region — so a defer inside the loop fires at EACH iteration's end (fall-through), on break/
    // continue, and on return. `base` = the in-scope defer count at the loop body's entry; push a
    // LoopDeferFrame so break/continue can fire `[this loop's base, …)` for the scopes they cross.
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, l.body)   // all of this iteration's direct defers
    var dctx2 = DeferCtx { defers = dctx.defers; loops = teko::list::push(dctx.loops, LoopDeferFrame { label = l.label; defer_base = defer_floor; region_base = regions.len }); cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth }
    var want_block = cg_block_has_block_local(prog, escaping, fn_body, l.body, false) && regions.len < 64
    var region = if want_block { fresh_named("_tkbr", out.len to i64) } else { "" }
    var regs2 = regions
    if want_block {
        out = cb(out, inner); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = tk_region_new("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
        regs2 = teko::list::push(regions, RegionFrame { name = region; label = l.label; is_loop = true; defer_base = defer_floor; decls = cg_block_slice_accums(prog, escaping, fn_body, l.body, false) })
    }
    // emit the body with THIS block as the current block context (so a block-local binding routes to
    // `region`) and the augmented region stack (so break/continue/return drop the right regions).
    var cur_blk = if want_block { l.body } else { teko::list::empty() }
    out = match emit_block(out, l.body, in_main, prog, ret_type, inner, escaping, regs2, fn_body, dctx2, cur_blk, false) { []byte as o => o; error as err => return err }
    // (W9.3) Fall-through exit edge (end of an iteration): fire THIS iteration's defers (LIFO) FIRST
    // (so a defer body can still read this iteration's block-locals), THEN drop the loop body's region.
    out = match emit_defers(out, fall, defer_floor, prog, inner, escaping, fn_body) { []byte as o => o; error as err => return err }
    // S2 — fall-through: drop this loop body's region (the next iteration's tk_region_new opens a fresh
    // one). Idempotent + nulled for overlap safety.
    if want_block { out = cb(out, inner); out = cb(out, "tk_region_drop("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n") }
    out = cb(out, indent)
    out = cb(out, "}\n")
    // …and a break-target AFTER the loop.
    if labeled { out = cb(out, indent); out = cb(out, "tk_lbl_"); out = cb_str(out, l.label); out = cb(out, "_break: ;\n") }
    out
}

// cb_indent_deeper — `indent` + four spaces (the C did `snprintf(inner, "%s    ", indent)`).
fn cb_indent_deeper(indent: str): str {
    var xs: []byte = teko::list::empty()
    var i = 0
    loop {
        if i >= indent.len { break }
        xs = teko::list::push(xs, indent[i])
        i++
    }
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    xs = teko::list::push(xs, b' ')
    str(xs)
}

// emit_stmt — the statement dispatch (the C's emit_stmt switch). (C: `emit_stmt`.)
// MEM Step 1: `frame`/`escaping` ride the LINEAR top-level path — a TBinding may frame-route its
// allocation, a TReturn drops the region on its edge. Statements that open a SUB-SCOPE (if/match/
// loop bodies) are emitted FRAMELESS in this first cut: any return inside them simply leaks the
// region (SAFE, M.5), and a frame-local binding only inside a branch falls back to root.
/**
 * cov_push_line — add `line` to the distinct-line accumulator `acc` (skip 0 = unpositioned). Mirrors
 * teko::coverage's cov_addline dedup so the emitted marks match its distinct-line set. Linear dedup: a
 * single statement spans few lines.
 *
 * @param acc   the distinct lines gathered so far
 * @param line  a candidate source line
 * @return      `acc` with `line` appended when new (and non-zero)
 * @since #265
 */
fn cov_push_line(acc: []u32, line: u32): []u32 {
    if line == 0 { return acc }
    var i: u64 = 0
    loop { if i >= acc.len { break }; if acc[i] == line { return acc }; i = i + 1 }
    teko::list::push(acc, line)
}

/**
 * cov_collect_expr — gather the distinct source lines of an expression subtree that a statement
 * UNCONDITIONALLY evaluates when it runs (#265 Track A, A2 exactness). Descends into every
 * child EXCEPT the conditional bodies of a nested if/match (then/else blocks and arm bodies are
 * SEPARATE statements — emit_stmt marks their lines when THEY emit, control-sensitively). The
 * if/match's own line + its cond/subject/guards ARE collected (they evaluate unconditionally).
 * The static walk marks `e.line` at every expr head reached by control flow, so a
 * multi-line expression (the `cb(cb(...))` / `match emit(...) { … }` idiom pervasive in this
 * codebase) contributes ALL its lines — the fix for the statement-head-only undercount.
 *
 * @param e    the typed expression
 * @param acc  the distinct lines gathered so far
 * @return     `acc` extended with `e`'s unconditionally-reached subtree lines
 * @since #265
 */
fn cov_collect_expr(e: checker::TExpr, acc: []u32): []u32 {
    var a0 = cov_push_line(acc, e.line)
    match e.kind {
        checker::TBinary as b => cov_collect_expr(b.right, cov_collect_expr(b.left, a0))
        checker::TUnary as u => cov_collect_expr(u.operand, a0)
        checker::TCompare as c => {
            var a = cov_collect_expr(c.first, a0)
            var i = 0
            loop { if i >= c.rest.len { break }; a = cov_collect_expr(c.rest[i].operand, a); i++ }
            a
        }
        checker::TCall as c => {
            var a = a0
            var i = 0
            loop { if i >= c.args.len { break }; a = cov_collect_expr(c.args[i], a); i++ }
            a
        }
        checker::TCast as c => cov_collect_expr(c.expr, a0)
        checker::TFieldAccess as fa => cov_collect_expr(fa.receiver, a0)
        checker::TIndex as ix => cov_collect_expr(ix.index, cov_collect_expr(ix.receiver, a0))
        checker::TStructInit as si => {
            var a = a0
            var i = 0
            loop { if i >= si.field_vals.len { break }; a = cov_collect_expr(si.field_vals[i], a); i++ }
            a
        }
        checker::TInterp as in => {
            var a = a0
            var i = 0
            loop {
                if i >= in.holes.len { break }
                a = cov_collect_expr(in.holes[i], a)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; a = cov_collect_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            var a = cov_collect_expr(ie.lhs, a0)
            var i = 0
            loop { if i >= ie.elems.len { break }; a = cov_collect_expr(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            var a = a0
            var i = 0
            loop { if i >= al.elements.len { break }; a = cov_collect_expr(al.elements[i].expr, a); i++ }
            a
        }
        checker::TIfExpr as f => cov_collect_expr(f.cond, a0)
        checker::TMatchExpr as m => {
            var a = cov_collect_expr(m.subject, a0)
            var i = 0
            loop { if i >= m.arms.len { break }; if m.arms[i].has_when { a = cov_collect_expr(m.arms[i].guard, a) }; i++ }
            a
        }
        _ => a0
    }
}

/**
 * stmt_cov_lines — the distinct source lines to mark for a statement, unconditionally
 * (#265 Track A, A2). Matches `cov_walk_stmt` in teko::coverage: a binding/assign RHS, a return value, an
 * expr-statement's expr (also covers a statement-position if/match — its own line + cond/subject,
 * the branch bodies self-marking as separate statements). Loops (no own expr), break/continue and
 * defer carry no lines of their own → empty.
 *
 * @param s  the typed statement
 * @return   the distinct 1-based source lines to mark at statement entry (empty when none)
 * @since #265
 */
fn stmt_cov_lines(s: @TStatement()): []u32 {
    var acc: []u32 = teko::list::empty()
    match s {
        checker::TBinding as b => cov_collect_expr(b.value, acc)
        checker::TAssign as a => {
            var av = cov_collect_expr(a.value, acc)
            if parser::assign_has_target(a.kind) { cov_collect_expr(a.target, av) } else { av }
        }
        checker::TReturn as r => if r.has_value { cov_collect_expr(r.value, acc) } else { acc }
        checker::TExprStmt as es => cov_collect_expr(es.expr, acc)
        _ => acc
    }
}

/**
 * emit_cov_lines — under an active CovCtx, emit a `tk_cov_line_at` mark for EACH distinct line of a
 * statement's unconditionally-reached expr subtree (byte-identical when off). One-per-line, keyed on
 * the owning fn, covering the common multi-line-expression case.
 *
 * @param buf     the emission buffer
 * @param ctx     the coverage context
 * @param lines   the distinct lines to mark (from stmt_cov_lines)
 * @param indent  the C indentation
 * @return        the buffer with each mark appended, or `buf` unchanged when off
 * @since #265
 */
fn emit_cov_lines(buf: []byte, ctx: CovCtx, lines: []u32, indent: str): []byte {
    if !ctx.on { return buf }
    var out = buf
    var i: u64 = 0
    loop { if i >= lines.len { break }; out = emit_cov_line(out, ctx, lines[i], indent); i = i + 1 }
    out
}

/**
 * emit_stmt — emit ONE statement's C text, dispatched on its checker kind. An `if`/`match` in
 * statement position runs as direct CONTROL FLOW (`emit_if_stmt`/`emit_match_stmt`, so a nested
 * `break`/`continue`/`return`/diverging call propagates through C's own semantics); any other
 * expression statement (a bare call, most commonly) runs for effect via `emit_expr_stmt_default`,
 * which is the ONE site an unqualified `panic`/`exit` STATEMENT call is recognized and replays
 * the scope's pending defers before it (W15/#defer-nas-saidas — `lower_expr_stmt`'s own C twin).
 * `break`/`continue` each fire their target's crossed-scope defers before their `goto`/keyword;
 * `defer` registers onto `dctx` and emits nothing inline (fired at its scope's own exit edge).
 *
 * @param buf     the C output buffer
 * @param s       the typed statement
 * @param in_main bool  whether the enclosing function is the virtual-main entry
 * @param prog    the whole-program codegen context (symbol/class/namespace tables)
 * @param ret_type checker::Type  the enclosing function's own declared return type
 * @param indent  the C indentation for this statement
 * @param frame   the enclosing frame region's C identifier, or "" when the function opened none
 * @param escaping []str  the enclosing function's escape-checked local names
 * @param regions []RegionFrame  the active block-region stack (S2)
 * @param fn_body []checker::TStatement  the enclosing function's full body (class-cleanup lookups)
 * @param dctx    DeferCtx  the pending-defer stack + active loop targets + coverage context
 * @param cur_block []checker::TStatement  the statement's own enclosing block (region-locality)
 * @param cur_block_is_value bool  whether `cur_block` is a value-producing arm
 * @return        the buffer with this statement's C text appended
 * @throws        propagated from whichever branch lowers the statement's own sub-expressions
 */
fn emit_stmt(buf: []byte, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    var b0 = emit_cov_lines(buf, dctx.cov, stmt_cov_lines(s), indent)
    if dctx.rr.len > 0 && dctx.bracket_depth == 0 && cg_conveys_escape_deep(escaping, s) {
        var ob = cb(b0, indent); ob = cb(ob, "tk_region_enter("); ob = cb(ob, dctx.rr); ob = cb(ob, ");\n")
        var d2 = cg_dctx_bracket(dctx)
        var ob2 = match emit_stmt_dispatch(ob, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, d2, cur_block, cur_block_is_value) { []byte as o => o; error as err => return err }
        ob2 = cb(ob2, indent); ob2 = cb(ob2, "tk_region_leave();\n")
        return ob2
    }
    emit_stmt_dispatch(b0, s, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
}

/**
 * emit_stmt_dispatch — the statement-kind dispatch of emit_stmt, factored out so a conveyance bracket
 * (M2, Mechanism 1) can wrap ANY statement kind uniformly. `b0` already carries the coverage-line
 * prologue. All parameters mirror emit_stmt.
 *
 * @param b0  the buffer with the statement's coverage prologue already appended
 * @return    the buffer with the statement's C text appended
 * @since 0.3.1
 */
fn emit_stmt_dispatch(b0: []byte, s: @TStatement(), in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, cur_block: []@TStatement(), cur_block_is_value: bool): []byte | error {
    match s {
        checker::TBinding as b => emit_binding(b0, prog, ret_type, b, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
        checker::TAssign as a => emit_assign(b0, prog, ret_type, a, indent, frame, escaping, regions, fn_body, dctx)
        checker::TReturn as r => emit_return(b0, prog, r, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TExprStmt as es => {
            // W5a — an `if` in statement position runs as CONTROL FLOW,
            // so break/continue/return inside a branch propagate. W5b —
            // a `match` in statement position runs each winning arm body for effect.
            match es.expr.kind {
                checker::TIfExpr as f => emit_if_stmt(b0, f, es.expr.line, es.expr.col, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                checker::TMatchExpr as m => emit_match_stmt(b0, prog, es.expr, m, in_main, ret_type, indent, frame, escaping, regions, fn_body, dctx, cur_block, cur_block_is_value)
                _ => emit_expr_stmt_default(b0, es.expr, prog, escaping, regions, fn_body, dctx, indent)
            }
        }
        checker::TLoopStmt as l => emit_loop(b0, l, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBreakStmt as b => {
            // (W9.3) `break` crosses every scope from here down to & including its target loop body:
            // fire those scopes' defers (base = the target loop's defer_base) LIFO — one sweep,
            // innermost-block-first — BEFORE dropping their regions. S2 — then drop every block region
            // from the top down to & including that loop's region. NOT the frame, NOT outer regions.
            // `break NAME` -> `goto tk_lbl_<NAME>_break;`; bare `break` -> `break;` (M.5).
            var out = match emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, b.label), prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
            out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
            out = cg_drop_regions_from(out, indent, regions, cg_target_region_base(dctx.loops, b.label))
            out = cb(out, indent)
            if b.label.len > 0 { out = cb(out, "goto tk_lbl_"); out = cb_str(out, b.label); cb(out, "_break;\n") }
            else { cb(out, "break;\n") }
        }
        checker::TContinueStmt as c => {
            // (W9.3) `continue` ends THIS iteration of its target loop: fire every crossed scope's
            // defers (base = the target loop's defer_base) LIFO BEFORE dropping their regions, so a
            // loop-body defer fires at each iteration end (incl. on `continue`). S2 — then drop every
            // block region from the top down to & including that loop's region (next iter opens fresh).
            // `continue NAME` -> `goto tk_lbl_<NAME>_cont;`; bare `continue` -> `continue;` (M.5).
            var out = match emit_defers(b0, dctx.defers, cg_target_defer_base(dctx.loops, c.label), prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
            out = cg_emit_bracket_unwind(out, indent, dctx.bracket_depth)
            out = cg_drop_regions_from(out, indent, regions, cg_target_region_base(dctx.loops, c.label))
            out = cb(out, indent)
            if c.label.len > 0 { out = cb(out, "goto tk_lbl_"); out = cb_str(out, c.label); cb(out, "_cont;\n") }
            else { cb(out, "continue;\n") }
        }
        // (W9.3) defer { stmts } — registers the cleanup block on the threaded DeferCtx (the block
        // emitters do the actual registration via dctx_register before reaching emit_stmt for siblings);
        // emit_stmt itself emits NOTHING inline for a defer. It fires LIFO at its scope's exit edge.
        // (C: TK_TSTMT_DEFER — g_cg_defers[g_cg_ndefers++] = s, emits nothing.)
        checker::TDeferStmt => b0
        checker::TAdoptStmt as a => emit_adopt(b0, a, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TBlockStmt as b => emit_block_region(b0, b.body, in_main, prog, ret_type, indent, frame, escaping, regions, fn_body, dctx)
        checker::TSpawn => error { message = "internal: spawn codegen is not wired (codegen crumb S3)" }
    }
}

/**
 * emit_expr_stmt_default — `emit_stmt`'s default expression-statement arm: a bare call run for
 * effect, its VReg discarded. A DIVERGING call (`checker::texpr_diverges` — an unqualified
 * `panic`/`exit`, the SAME fronteira `emit_return` leaves via) leaves EVERY enclosing scope
 * exactly like a `return`, so its pending defers replay FIRST (`emit_return`'s own ordering,
 * `codegen.tks` — fires before the call TEXT, so the defer body runs before the `_Noreturn`
 * runtime call that follows it, instead of after it in UNREACHABLE text, W15/#defer-nas-saidas).
 * Every OTHER call's own later fall-through/return/break/continue edge already fires this same
 * scope's defers at its own exit — this site only closes the one edge those never reach.
 *
 * @param buf      the C output buffer
 * @param expr     the typed statement expression (the call, run for effect)
 * @param prog     the whole-program codegen context
 * @param escaping []str  the enclosing function's escape-checked local names
 * @param regions  []RegionFrame  the active block-region stack (S2)
 * @param fn_body  []checker::TStatement  the enclosing function's full body
 * @param dctx     DeferCtx  the pending-defer stack this statement may replay from
 * @param indent   the C indentation for this statement
 * @return         the buffer with this statement's C text appended
 * @throws         propagated from replaying a pending defer or emitting `expr` itself
 */
fn emit_expr_stmt_default(buf: []byte, expr: checker::TExpr, prog: CgProg, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx, indent: str): []byte | error {
    var b1 = if checker::texpr_diverges(expr) {
        match emit_defers(buf, dctx.defers, 0, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
    } else { buf }
    var out = cb(b1, indent)
    out = match emit_expr_ctx(out, prog, checker::Void { }, expr, escaping, regions, fn_body, dctx) { []byte as o => o; error as err => return err }
    cb(out, ";\n")
}

/**
 * emit_adopt — lower an `adopt [name] { … }` block (the C1 closer). ALWAYS opens an adopter region
 * `tk_region_new(<enclosing>)` (unlike an arm region, opened only when it has a block-local — an
 * adopter is opened unconditionally, since its purpose IS to own every allocation inside), pushes a
 * RegionFrame so cg_enclosing_region_expr returns the adopter for every allocation inside (each
 * per-object class child region parents under it), emits the body, fires the block's defers LIFO,
 * then SUBTREE-DROPS: `tk_region_drop_subtree(<adopter>)` frees the adopter AND every object region
 * parented under it in one sweep (cycles irrelevant). A `return`/`break`/`continue` inside the body
 * drops the adopter region via the region-stack helpers (a plain drop — a SAFE leak of the object
 * subtree on that rare escape edge; the normal brace does the full subtree reclamation).
 *
 * ACCEPTED LIMITATIONS (by design, per the issue — do not "fix" without a follow-on spine issue):
 *   - DYNAMIC correctness only, no static escape gate: an object built with a lexical struct-init
 *     directly inside `adopt { }` and then STORED into an outer binding (escaping the block)
 *     DANGLES after the brace — its child region was subtree-dropped along with everything else.
 *     `adopt` does not prove non-escape; that is deferred to a future spine-based confinement
 *     analysis layered on top of this dynamic primitive.
 *   - "lexically inside" is literal: an object built by a FACTORY/METHOD CALLED FROM inside
 *     `adopt { }` (e.g. `Node::make(1)`) opens its per-object region parented to THAT FUNCTION's
 *     own enclosing region (typically root, if the factory has no frame region of its own) — NOT
 *     the caller's adopter. Such an object safely LEAKS to root (within-model, not reclaimed by
 *     the adopt brace); only allocations the adopt body performs directly are captured.
 *
 * @param []byte buf  the C output buffer
 * @param checker::TAdoptStmt a  the typed adopt statement
 * @param bool in_main  whether the enclosing function is the virtual-main
 * @param CgProg prog  the typed program
 * @param checker::Type ret_type  the enclosing function's return type
 * @param str indent  the C indentation
 * @param str frame  the enclosing frame region name (fallback parent when the region stack is empty)
 * @param []str escaping  the enclosing function's escape set
 * @param []RegionFrame regions  the active block-region stack
 * @param []checker::TStatement fn_body  the enclosing function body (for block-local analysis)
 * @param DeferCtx dctx  the threaded defer/coverage context
 * @return []byte | error  the buffer with the adopter block emitted, or a codegen error
 */
fn emit_adopt(buf: []byte, a: checker::TAdoptStmt, in_main: bool, prog: CgProg, ret_type: @Type(), indent: str, frame: str, escaping: []str, regions: []RegionFrame, fn_body: []@TStatement(), dctx: DeferCtx): []byte | error {
    var defer_floor = dctx.defers.len
    var fall = cg_append_direct_defers(dctx.defers, a.body)
    var region = fresh_named("_tkad", buf.len to i64)
    var out = cb(buf, indent); out = cb(out, "tk_region *"); out = cb(out, region); out = cb(out, " = tk_region_new("); out = cb(out, cg_enclosing_region_expr_framed(regions, frame)); out = cb(out, ");\n")
    var regs2 = teko::list::push(regions, RegionFrame { name = region; label = ""; is_loop = false; defer_base = defer_floor; decls = teko::list::empty() })
    out = match emit_block(out, a.body, in_main, prog, ret_type, indent, escaping, regs2, fn_body, dctx, a.body, false) { []byte as o => o; error as err => return err }
    out = match emit_defers(out, fall, defer_floor, prog, indent, escaping, fn_body) { []byte as o => o; error as err => return err }
    out = cb(out, indent); out = cb(out, "tk_region_drop_subtree("); out = cb(out, region); out = cb(out, "); "); out = cb(out, region); out = cb(out, " = NULL;\n")
    out
}

// ---------------------------------------------------------------------------
// A top-level function -> a C function.
// ---------------------------------------------------------------------------

/**
 * Whether typed expression `e` (or any sub-expression) makes a DIRECT self-recursive call to the
 * function identified by `ns`/`name`. Mirrors `cg_collect_expr_opts`'s full-body traversal; a
 * `TCall` matches when its resolved target namespace (`call_ns`) and last callee path segment equal
 * `ns`/`name` — each namespace holds exactly one function per name, so the pair identifies it. A
 * closure or interface-dispatch call carries no static target name and never matches (its target is
 * a runtime value / vtable slot). Leaf expressions hold no call and answer false.
 *
 * @param e     the typed expression to scan
 * @param ns    the enclosing function's declaring namespace (matched against `TCall.call_ns`)
 * @param name  the enclosing function's bare name (matched against the callee's last path segment)
 * @return      true iff a direct self-recursive call appears anywhere within `e`
 */
fn cg_expr_calls_self(e: checker::TExpr, ns: str, name: str): bool {
    match e.kind {
        checker::TCall as c => {
            if !c.is_closure_call && !c.is_iface_dispatch && c.call_ns == ns && cg_path_last(c.callee) == name { return true }
            var i = 0
            loop { if i >= c.args.len { break }; if cg_expr_calls_self(c.args[i], ns, name) { return true }; i++ }
            false
        }
        checker::TBinary as b => cg_expr_calls_self(b.left, ns, name) || cg_expr_calls_self(b.right, ns, name)
        checker::TUnary as u => cg_expr_calls_self(u.operand, ns, name)
        checker::TCompare as c => {
            if cg_expr_calls_self(c.first, ns, name) { return true }
            var i = 0
            loop { if i >= c.rest.len { break }; if cg_expr_calls_self(c.rest[i].operand, ns, name) { return true }; i++ }
            false
        }
        checker::TIfExpr as f => cg_expr_calls_self(f.cond, ns, name) || cg_block_calls_self(f.then_blk, ns, name) || cg_block_calls_self(f.else_blk, ns, name)
        checker::TMatchExpr as m => {
            if cg_expr_calls_self(m.subject, ns, name) { return true }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when && cg_expr_calls_self(m.arms[i].guard, ns, name) { return true }
                if cg_block_calls_self(m.arms[i].body, ns, name) { return true }
                i++
            }
            false
        }
        checker::TCast as c => cg_expr_calls_self(c.expr, ns, name)
        checker::TFieldAccess as fa => cg_expr_calls_self(fa.receiver, ns, name)
        checker::TStructInit as si => {
            var i = 0
            loop { if i >= si.field_vals.len { break }; if cg_expr_calls_self(si.field_vals[i], ns, name) { return true }; i++ }
            false
        }
        checker::TIndex as ix => cg_expr_calls_self(ix.receiver, ns, name) || cg_expr_calls_self(ix.index, ns, name)
        checker::TInterp as ip => {
            var i = 0
            loop {
                if i >= ip.holes.len { break }
                if cg_expr_calls_self(ip.holes[i], ns, name) { return true }
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; if cg_expr_calls_self(fd.args[k], ns, name) { return true }; k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            false
        }
        checker::TInExpr as ie => {
            if cg_expr_calls_self(ie.lhs, ns, name) { return true }
            var i = 0
            loop { if i >= ie.elems.len { break }; if cg_expr_calls_self(ie.elems[i], ns, name) { return true }; i++ }
            false
        }
        checker::TArrayLit as al => {
            var i = 0
            loop { if i >= al.elements.len { break }; if cg_expr_calls_self(al.elements[i].expr, ns, name) { return true }; i++ }
            false
        }
        checker::TLambda as lam => cg_block_calls_self(lam.body, ns, name)
        checker::TBlockExpr as blk => cg_block_calls_self(blk.body, ns, name)
        _ => false
    }
}

/**
 * Whether any statement in `stmts` (or a nested block) makes a direct self-recursive call to the
 * function identified by `ns`/`name`. Mirrors `cg_collect_block_opts`'s statement traversal.
 *
 * @param stmts  the typed statement block to scan
 * @param ns     the enclosing function's declaring namespace
 * @param name   the enclosing function's bare name
 * @return       true iff a direct self-recursive call appears anywhere within the block
 */
fn cg_block_calls_self(stmts: []@TStatement(), ns: str, name: str): bool {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => if cg_expr_calls_self(b.value, ns, name) { return true }
            checker::TAssign as a => { if cg_expr_calls_self(a.value, ns, name) { return true }; if parser::assign_has_target(a.kind) { if cg_expr_calls_self(a.target, ns, name) { return true } } }
            checker::TReturn as r => if r.has_value && cg_expr_calls_self(r.value, ns, name) { return true }
            checker::TLoopStmt as l => { if cg_block_calls_self(l.init, ns, name) { return true }; if cg_block_calls_self(l.body, ns, name) { return true } }
            checker::TExprStmt as es => if cg_expr_calls_self(es.expr, ns, name) { return true }
            checker::TDeferStmt as d => if cg_block_calls_self(d.body, ns, name) { return true }
            checker::TAdoptStmt as a => if cg_block_calls_self(a.body, ns, name) { return true }
            checker::TBlockStmt as b => if cg_block_calls_self(b.body, ns, name) { return true }
            _ => { }
        }
        i++
    }
    false
}

/**
 * Whether `f` is DIRECTLY self-recursive — its body contains a call to itself. Such a function must
 * be emitted `__attribute__((noinline))`: LLVM (clang / zig cc, the release toolchain) miscompiles
 * an inlined self-recursive function that takes a by-value aggregate parameter. On inlining it into
 * a caller, LLVM elides the by-value argument copy, then Tail-Recursion-Elimination rewrites the
 * inlined self-recursion into a loop that OVERWRITES that parameter's storage — which aliases the
 * caller's live argument. The caller then reads the clobbered argument (issue #283: `type_join`
 * returned its slice argument's ELEMENT type instead of the slice, so the checker rejected a valid
 * program only under `-O2`). gcc compiles the same C correctly; the fix keeps the emitted C
 * self-recursion out of the inliner, closing the miscompile on every toolchain.
 *
 * @param f  the typed function
 * @return   true iff `f` (non-extern) calls itself directly
 */
fn cg_fn_is_self_recursive(f: checker::TFunction): bool {
    if f.is_extern { return false }
    cg_block_calls_self(f.body, f.namespace, f.name)
}

/**
 * cg_fn_ref_ns — the namespace a function's param type annotations were WRITTEN in, so a bare
 * contract name in a method's param type resolves the way the checker resolved it. A METHOD's
 * `TFunction` namespace is exactly its owner type's canonical name (`module::Owner`), but its param
 * types were resolved by the checker in the OWNER's enclosing MODULE namespace (collect.tks
 * `method_func_type` takes `items[i].namespace`) — so a bare `Reader` on a `class & Reader` factory
 * must bind the sibling module decl (`teko::io::Reader`) past a same-last-segment cousin
 * (`teko::emit::Reader`, the #109 collision), NOT be resolved against the over-qualified
 * `teko::io::Owner`. Used at BOTH the param-signature emitter (emit_function_sig) AND the caller's
 * arg-slot upcast canonicalisation (emit_call), so the factory's declared param type and the
 * class->interface box built for its argument agree on the real contract. A FREE function's
 * namespace already IS its module namespace, so it is returned unchanged. Detection is EXACT: only
 * when `ns` names an existing type decl is it a method's owner-qualified namespace.
 *
 * @param prog  the typed program (scanned for a type decl whose canonical name equals `ns`)
 * @param ns    the function's declared namespace (`TFunction.namespace`)
 * @return      the enclosing MODULE namespace for a method's owner-named ns, else `ns` unchanged
 */
fn cg_fn_ref_ns(prog: CgProg, ns: str): str {
    if prog.ix.exact.slots.len != 0 {
        if cg_table_get(prog.ix.exact, ns) != 0 { return checker::name_qualifier(ns) }
        return ns
    }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == ns { return checker::name_qualifier(ns) } }
            _ => { }
        }
        i++
    }
    ns
}

// emit_function — a TFunction -> a C function definition.
// (C: `emit_function`.)
// emit_function_sig — the return type + name + params up to the `)` (no body). Shared by the
// definition AND the PROTOTYPE pass in tk_emit_c, so a forward declaration and its definition
// spell the same signature. Parameter names ride cb_ident (a C-keyword param → trailing `_`).
// (C: `emit_function_sig`.)
fn emit_function_sig(buf: []byte, prog: CgProg, f: checker::TFunction): []byte | error {
    var out = buf
    if cg_fn_is_self_recursive(f) { out = cb(out, "__attribute__((noinline)) ") }
    if f.is_extern { out = cb(out, "extern ") }   // C7.1a: a foreign prototype (no body)
    out = match emit_type(out, prog, f.return_type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    if f.is_extern {
        out = cb(out, f.c_symbol)   // C7.1a: the raw foreign C symbol (NO namespace mangling)
    } else {
        out = cb_fn_name(out, f.namespace, f.name, f.overload_suffix)
    }
    out = cb(out, "(")
    if f.params.len == 0 {
        out = cb(out, "void")
    } else {
        var ref_ns = cg_fn_ref_ns(prog, f.namespace)
        /* (item-14 §13.2) a value-struct method takes its receiver as the HEADER POINTER, not a copy —
           `self` is a ref, so a write through it STICKS on the caller's materialization instead of dying
           with a by-value parameter. Mirrors the `ref<T>` parameter position (LIR degrau 18). */
        var self_is_ref = match cg_struct_self_recv(prog, f) { str => true; null => false }
        var i: u64 = 0
        loop {
            if i >= f.params.len { break }
            if i > 0 { out = cb(out, ", ") }
            out = match emit_type_expr(out, prog, f.params[i].type_ann, ref_ns) { []byte as o => o; error as err => return err }
            out = cb(out, " ")
            if i == 0 && self_is_ref { out = cb(out, "*") }
            out = cb_ident(out, f.params[i].name)
            i++
        }
    }
    cb(out, ")")
}

// cg_stmt_c_terminates — does this statement, AS LOWERED, guarantee C control doesn't fall through
// past it? A `return`/break/continue does; a trailing value-expr lowers to `return <v>;` so it does
// too — EXCEPT a `match`/`if` value tail, whose exhaustiveness C cannot see. (C: cg_stmt_c_terminates.)
fn cg_stmt_c_terminates(s: @TStatement()): bool {
    match s {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TMatchExpr => false
            checker::TIfExpr => false
            _ => true
        }
        _ => false
    }
}

// cg_same_named_struct — are `a` and `b` the SAME Named type? Used to gate the frame-local binding
// bypass to the no-wrapping case (declared type == the struct-init's own type), so a variant/
// optional-typed binding (which emit_as_r must wrap) is never emitted via the direct framed path.
fn cg_same_named_struct(a: @Type(), b: @Type()): bool {
    match a {
        checker::Named as na => match b {
            checker::Named as nb => teko::runtime::str_eq(na.name, nb.name)
            _ => false
        }
        _ => false
    }
}

// fn_body_has_frame_local — does this body have any TOP-LEVEL binding the escape check proved
// frame-local AND routable? (MEM Step 1 routes only top-level
// bindings; sub-scope bindings stay on root in this first cut.) Drives whether emit_function opens
// a frame region at all — none ⇒ no region ⇒ zero output change (the fixpoint-preserving default).
fn fn_body_has_frame_local(prog: CgProg, escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if checker::binding_is_frame_local(escaping, b) && (cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b)) { return true }
                // (S2 Level-1) a NON-escaping slice binding: its buffer is built by later self-append
                // pushes (`xs = push(xs, …)`), each routed to `_tkfr` and bulk-freed on the frame drop.
                if checker::binding_is_frame_local_slice(escaping, b) { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

fn emit_function(buf: []byte, prog: CgProg, f: checker::TFunction): []byte | error {
    emit_function_cov(buf, prog, f, -1)
}

/**
 * cg_frame_region_parent_expr — the C expression `_tkfr`'s opening `tk_region_new(…)` call
 * passes as its PARENT.
 *
 * A `#arena_size(N)`-declared function (#453) gets `NULL` — an INDEPENDENT tree root, never a
 * child of the shared process root (`tk_region_root()`). This is a CONTRACT, not an incidental
 * choice: the owner's ruling on the execution-unit model (2026-07-27) is that every isolate —
 * the language's future unit of concurrent execution, a heap-isolated boundary, NOT a suspension
 * point like async/await's coroutine — is born with its OWN root, "como se fosse outro programa"
 * (as if it were another program). `#arena_size` is the first surface to open a region under
 * that same contract: a function that declares its own arena is its OWN isolation boundary,
 * exactly like a future isolate's. This crumb does not implement isolates — no scheduling, no
 * message-passing, no thread — it only honors the boundary at the one call site that already
 * opens a per-function frame region. Every un-annotated function is UNCHANGED: `tk_region_root()`,
 * exactly as before (additive by ruling — `src/` does not adopt `#arena_size`).
 *
 * The prize this buys NOW, for free: the test-gate's `tk_arena_push`/`tk_arena_pop` bracket the
 * SHARED process root only (`tk_region_root()`'s own bump position) — a future parallel test
 * runner rewinding two lanes' marks over that ONE root would rewind them over each OTHER
 * (`docs/design/concorrencia-adiantada-s8.md`). A test that opens its OWN root via
 * `#arena_size` never touches that shared mark at all, so the hazard does not need fixing for
 * it — it is architecturally UNNECESSARY, the stronger outcome.
 *
 * @param f  the function being emitted
 * @return   `"NULL"` (own root) or `"tk_region_root()"` (child of the shared process root)
 */
fn cg_frame_region_parent_expr(f: checker::TFunction): str {
    if f.has_arena_size { "NULL" } else { "tk_region_root()" }
}

/**
 * cg_rr_init_expr — the C initializer for `_tkrr`, the RETURN REGION (0.3.1 move-on-return M2). THE
 * ONE LINE that stages the move flip: M2a0/M2a hold it at `tk_region_root()` (escaping values leak to
 * root — leak-safe, contained blast radius while bracket completeness is proven); M2b flips it to
 * `tk_region_current()` — the caller's chosen region captured at entry — so escaping values MOVE to
 * the caller and are reclaimed with it (never leaked to root). Both destinations are ⊒-safe by LUB.
 *
 * @return the C initializer expression for `tk_region *_tkrr`
 * @since 0.3.1
 */
fn cg_rr_init_expr(): str { "tk_region_current()" }

/**
 * cg_tkfr_init_expr — the C initializer for `_tkfr`, the FRAME REGION, under the M2 conveyance. An
 * `#arena_size` isolate keeps its own NULL-rooted tree (unchanged). A framed non-arena function's
 * `_tkfr` is a real child of `_tkrr` (M2b) — parent flips from root (M2a) to `_tkrr` here — so that
 * the current-region stack below `_tkfr` is exactly `_tkrr` (the caller's region), and a
 * `tk_region_leave()` at a return edge exposes `_tkrr` for the returned value (§3b).
 *
 * @param f       the function being emitted
 * @param use_rr  whether this function opens `_tkrr`/enters `_tkfr` (framed, non-arena)
 * @return        the C initializer expression for `tk_region *_tkfr`
 * @since 0.3.1
 */
fn cg_tkfr_init_expr(f: checker::TFunction, use_rr: bool): str {
    if !use_rr { return teko::str::concat("tk_region_new(", cg_frame_region_parent_expr(f), ")") }
    "tk_region_new(_tkrr)"
}

/**
 * cg_tkfr_drop_active — whether an ENTERED `_tkfr` is dropped (reclaimed) on the function's exit edges
 * under M2. M2a0 returns false for a framed function (`_tkfr` aliases root while only stack balance is
 * proven — never drop root); M2a onward returns true (the frame's non-escaping scratch is reclaimed at
 * the exit edge — the memory saving begins). An arena isolate always drops its own tree.
 *
 * @param use_rr  whether this function entered `_tkfr`
 * @return        true iff the exit edges emit `tk_region_drop(_tkfr)`
 * @since 0.3.1
 */
fn cg_tkfr_drop_active(entered: bool): bool { true }

/**
 * binding_conveys_escape — the BLIND rule (0.3.1 move-on-return M2, Mechanism 1): the RHS of a
 * binding/assign of name `name` is wrapped in a conveyance bracket (`tk_region_enter(_tkrr) … leave()`)
 * iff `name ∈ fn_escaping_vars`. It does NOT detect "contains a call" — bracketing a pure RHS is inert,
 * and sub-detecting would be UAF. Over-bracketing is leak-safe (`_tkrr ⊒` every use). The only residual
 * UAF path is escape-analysis SUB-marking — the load-bearing precondition M2 already assumes
 * (escape.tks conservative: doubt → escaping). So the bracket adds NO new UAF surface.
 *
 * @param escaping  the function's `fn_escaping_vars` set (a superset of the truly-escaping)
 * @param name      the binding/assign LHS name
 * @return          true iff the RHS must be bracketed to convey a retained call-result to `_tkrr`
 * @since 0.3.1
 */
fn binding_conveys_escape(escaping: []str, name: str): bool {
    str_list_has(escaping, name)
}

/**
 * cg_target_name — the simple bound name of a binding target, or "" for a destructure pattern (which
 * has no single name and is never conveyance-bracketed as a unit).
 *
 * @param t  the binding target pattern
 * @return   the SimpleName, or "" for a destructure
 * @since 0.3.1
 */
fn cg_target_name(t: @BindTarget()): str {
    match t {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => ""
    }
}

/**
 * cg_dctx_bracket — `dctx` with the conveyance-bracket depth incremented by one, threaded into an
 * escaping binding/assign's RHS emission so a `return`/`break`/`continue` inside it unwinds this
 * bracket (and any nested ones) on its exit edge.
 *
 * @param dctx  the defer/bracket context
 * @return      `dctx` with `bracket_depth + 1`
 * @since 0.3.1
 */
fn cg_dctx_bracket(dctx: DeferCtx): DeferCtx {
    DeferCtx { defers = dctx.defers; loops = dctx.loops; cov = dctx.cov; rr = dctx.rr; bracket_depth = dctx.bracket_depth + 1 }
}

/**
 * cg_conveys_escape_deep — whether statement `s`, evaluated, could leave an escaping value in the
 * current region and must therefore be wrapped in a conveyance bracket so it lands in `_tkrr` (0.3.1
 * move-on-return M2, Mechanism 1). True for:
 *   - a binding/assign whose LHS name escapes (the direct case), and
 *   - a statement-form `if`/`match` an arm/branch of which DIRECTLY (not across a nested loop)
 *     contains an escaping binding/assign: the subject/cond call-result is RETAINED via an arm binding
 *     that flows to that escaping write (`match parse_type_args(…) { ta => { esc = ta.args } }`), so
 *     the WHOLE statement — subject first — must run with `current == _tkrr`, else the subject
 *     materializes in `_tkfr` and the escaping write copies a pointer the frame drop frees (UAF).
 * A loop is NEVER bracketed as a whole (its `break`/`continue` leave sits AFTER the loop; the loop's
 * inner statements are bracketed individually as emit_stmt reaches them). Over-bracketing a pure
 * statement is inert and leak-safe (`_tkrr ⊒` every use); the only residual UAF is escape sub-marking.
 *
 * @param escaping  the function's `fn_escaping_vars` set
 * @param s         the statement
 * @return          true iff `s` must be conveyance-bracketed
 * @since 0.3.1
 */
fn cg_conveys_escape_deep(escaping: []str, s: @TStatement()): bool {
    match s {
        checker::TBinding as b => binding_conveys_escape(escaping, cg_target_name(b.target))
        checker::TAssign as a => binding_conveys_escape(escaping, a.name)
        checker::TExprStmt as es => cg_expr_arm_has_escaping_write(escaping, es.expr)
        _ => false
    }
}

/**
 * cg_expr_arm_has_escaping_write — whether a statement-form `if`/`match` expression `e` has an
 * arm/branch that DIRECTLY (not across a nested loop) contains an escaping binding/assign — the signal
 * that its subject/cond call-result is retained-and-escaping and the whole statement must be bracketed.
 *
 * @param escaping  the function's `fn_escaping_vars` set
 * @param e         the statement expression (an `if`/`match`, else no arms)
 * @return          true iff an arm directly contains an escaping write
 * @since 0.3.1
 */
fn cg_expr_arm_has_escaping_write(escaping: []str, e: checker::TExpr): bool {
    match e.kind {
        checker::TIfExpr as f => cg_block_has_escaping_write(escaping, f.then_blk) || (f.has_else && cg_block_has_escaping_write(escaping, f.else_blk))
        checker::TMatchExpr as m => cg_arms_have_escaping_write(escaping, m.arms)
        _ => false
    }
}

/**
 * cg_arms_have_escaping_write — whether any match arm body DIRECTLY contains an escaping write.
 *
 * @param escaping  the function's escaping-name set
 * @param arms      the match arms
 * @return          true iff some arm body has a direct escaping write
 * @since 0.3.1
 */
fn cg_arms_have_escaping_write(escaping: []str, arms: []checker::TArm): bool {
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        if cg_block_has_escaping_write(escaping, arms[i].body) { return true }
        i = i + 1
    }
    false
}

/**
 * cg_block_has_escaping_write — whether block `body` (recursing into a nested `TLoopStmt`'s `init`/
 * `body`, since a loop is never bracketed AS A WHOLE — see `cg_conveys_escape_deep` — but an escaping
 * write underneath it still signals the ENCLOSING arm/branch) contains an escaping binding/assign, or
 * a nested statement-form `if`/`match` that itself does. Used to decide whether an enclosing
 * statement-form `if`/`match` must be conveyance-bracketed to move its subject's retained result to
 * `_tkrr` — a write nested inside a `loop { }` that sits directly in an arm/branch is JUST AS retaining
 * as one written directly in the arm's own top-level statements, so it must not be missed (0.3.1,
 * dangling-`_tkfr`-alias fix: a match/if subject built in the frame region, retained only through a
 * loop-nested escaping write, was previously left un-bracketed and freed by `tk_region_drop` while
 * still aliased).
 *
 * @param escaping  the function's escaping-name set
 * @param body      the block statements
 * @return          true iff `body` (including through a nested loop's `init`/`body`) directly
 *                  contains an escaping write
 * @since 0.3.1
 */
fn cg_block_has_escaping_write(escaping: []str, body: []@TStatement()): bool {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => { if binding_conveys_escape(escaping, cg_target_name(b.target)) { return true } }
            checker::TAssign as a => { if binding_conveys_escape(escaping, a.name) { return true } }
            checker::TExprStmt as es => { if cg_expr_arm_has_escaping_write(escaping, es.expr) { return true } }
            checker::TLoopStmt as l => { if cg_block_has_escaping_write(escaping, l.init) || cg_block_has_escaping_write(escaping, l.body) { return true } }
            _ => { }
        }
        i = i + 1
    }
    false
}

/**
 * cg_emit_bracket_unwind — emit `n` balancing `tk_region_leave()` at an exit edge (return/break/
 * continue), closing the `n` conveyance brackets open at that point BEFORE the frame leave/drop. The
 * per-edge unwind that keeps the current-region stack balanced on every path (§2c), mirroring the
 * defer/region-drop unwind machinery.
 *
 * @param buf     the output buffer
 * @param indent  the current indentation
 * @param n       the number of open conveyance brackets (dctx.bracket_depth)
 * @return        the buffer with `n` leaves appended
 * @since 0.3.1
 */
fn cg_emit_bracket_unwind(buf: []byte, indent: str, n: u64): []byte {
    var out = buf
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = cb(out, indent); out = cb(out, "tk_region_leave();\n")
        i = i + 1
    }
    out
}

/**
 * cg_frame_exit — emit the frame region's exit edge under M2: when `_tkfr` was ENTERED, first
 * `tk_region_leave()` (popping `_tkfr`, exposing `_tkrr` = the caller's region for the returned value),
 * then `tk_region_drop(_tkfr)` when the drop is active (`cg_tkfr_drop_active`). Exactly one leave per
 * enter per control path — each exit edge is mutually exclusive — so the caller's current is never
 * over-popped. An arena isolate (never entered) only drops its tree.
 *
 * @param buf      the output buffer
 * @param indent   the current indentation
 * @param frame    the frame region variable name (`_tkfr`)
 * @param entered  whether `_tkfr` was entered (leave iff true; use_rr)
 * @return         the buffer with the leave (when entered) + drop (when active) appended
 * @since 0.3.1
 */
fn cg_frame_exit(buf: []byte, indent: str, frame: str, entered: bool): []byte {
    var out = buf
    if entered { out = cb(out, indent); out = cb(out, "tk_region_leave();\n") }
    if cg_tkfr_drop_active(entered) { out = cb(out, indent); out = cb(out, "tk_region_drop("); out = cb(out, frame); out = cb(out, ");\n") }
    out
}

/**
 * cg_return_frame_exit — the frame region's exit on a RETURN edge, keyed on whether `_tkfr` was
 * ENTERED (`dctx.rr.len > 0`) rather than on the passed `frame` (which emit_block STRIPS to "" for
 * sub-scopes). This is load-bearing under M2: an ENTERED function's `tk_region_enter(_tkfr)` must be
 * balanced by a `tk_region_leave()` on EVERY return edge — including a nested `error => return e`
 * whose `frame` is stripped — else the entered `_tkfr` stays on the current-region stack, dangling
 * after it is dropped (the parse_function imbalance). The `_tkfr` name is a per-function constant, so
 * it is used literally here regardless of the stripped `frame`. A non-entered arena isolate drops its
 * own `frame` tree (no leave); a frameless function does nothing.
 *
 * @param buf     the output buffer
 * @param indent  the current indentation
 * @param frame   the (possibly stripped) frame name — used only for the arena drop path
 * @param dctx    the defer context (`rr` non-empty iff `_tkfr` was entered)
 * @return        the buffer with the correct leave/drop for this return edge
 * @since 0.3.1
 */
fn cg_return_frame_exit(buf: []byte, indent: str, frame: str, dctx: DeferCtx): []byte {
    if dctx.rr.len > 0 { return cg_frame_exit(buf, indent, "_tkfr", true) }
    if frame.len > 0 { return cg_frame_exit(buf, indent, frame, false) }
    buf
}

/**
 * cg_closure_env_region — the region a capturing closure's env is allocated in (0.3.1 move-on-return
 * M2c). Inside a conveyance bracket (`bracket_depth > 0`, i.e. this closure is the RHS of an ESCAPING
 * binding) the env routes to `_tkrr` — the caller's region — so an escaping closure's env MOVES with
 * it and is reclaimed by the caller; its captured call-results, marked escaping by the same context,
 * ride the same bracket. Otherwise the env keeps the process ROOT (the leak-safe fallback — never a
 * UAF, since a non-escaping closure's env outlives its uses at root).
 *
 * @param dctx  the defer/bracket context
 * @return      the C region expression the env allocates in
 * @since 0.3.1
 */
fn cg_closure_env_region(dctx: DeferCtx): str {
    if dctx.bracket_depth > 0 && dctx.rr.len > 0 { return dctx.rr }
    "tk_region_root()"
}

/**
 * cg_emit_arena_presize — the `#arena_size(N)` pre-size gesture (#453): immediately after the
 * frame region opens, append a single DISCARDED `tk_region_alloc(_tkfr, N)` call.
 *
 * `tk_region_alloc`'s chunk allocator sizes a region's first chunk to `max(request, 64 KiB)`
 * (`TK_REGION_DEFAULT_CHUNK`, `teko_rt.c`) — this call's `N`-byte request is exactly the pre-size
 * hook the design calls for: it forces ONE up-front malloc of at least `N` bytes instead of
 * discovering the need incrementally as the function's real allocations run.
 *
 * HONEST LIMIT, reported rather than hidden: `tk_region_alloc` has no reserve-WITHOUT-consume
 * primitive today (every call bumps `used`), so this reservation's own `N` bytes count toward
 * the chunk's tally. A function whose real work stays under `N` still gets the "one malloc, no
 * further growth" guarantee — the default-vs-declared chunk (`max(N, 64 KiB)`) leaves headroom
 * for it; a workload that needs a FULL `N` bytes of its OWN on top of the reservation grows an
 * ordinary extra chunk (a correctness non-issue, just a second malloc). A byte-exact reserve-
 * without-consume primitive would need a new `teko_rt` entry point — out of scope for this
 * Teko-only crumb (reported, not forced). Sizing accuracy is the DEVELOPER's job by ruling
 * (owner, 2026-07-13): this call only wires the declared number through; it never computes one.
 *
 * @param buf  the buffer being emitted into
 * @param n    the declared byte count (`f.arena_size`)
 * @return     `buf` with the reservation call appended
 */
fn cg_emit_arena_presize(buf: []byte, n: u64): []byte {
    var out = cb(buf, "    (void)tk_region_alloc(_tkfr, ")
    var sized = cb_u64_digits(out, n)
    cb(sized, ");\n")
}

/** emit_function_cov — emit_function with an optional `tk_cov_mark(cov_idx)` entry prologue (#265,
    the native-gate TestCov profile). `cov_idx < 0` emits NO prologue → byte-identical to the
    historical emission (Program/TestPlain and every ordinary caller). A `cov_idx >= 0` marks this
    production function's items-index on entry — the executed-function mark — AND turns on the
    interior line/branch instrumentation (Track A) via a live CovCtx threaded on `dctx.cov`, so every
    `tk_cov_line_at`/`tk_cov_branch_at` interior mark keys on THIS function's items-index (cov_idx). */
fn emit_function_cov(buf: []byte, prog: CgProg, f: checker::TFunction, cov_idx: i64): []byte | error {
    var out = match emit_function_sig(buf, prog, f) { []byte as o => o; error as err => return err }
    out = cb(out, " {\n")
    if cov_idx >= 0 { out = cb(cb_u64_digits(cb(out, "    tk_cov_mark("), cov_idx to u64), ");\n") }
    // (W9.3) PER-SCOPE defer. The TAST body is emitted UNCHANGED; defers are tracked via the threaded
    // DeferCtx (the functional twin of the C's g_cg_defers/g_cg_ndefers statics, reset per function).
    // A TDeferStmt appends to dctx.defers (emits nothing inline); every scope-block fires `[base, len)`
    // LIFO at its exit edge (fall-through / break / continue / return), BEFORE that block's region drop.
    // No defers ⇒ dctx stays empty ⇒ byte-identical to the pre-W9.3 output. (C: emit_function / emit_defers.)
    var fbody = f.body
    var cov = if cov_idx >= 0 { CovCtx { on = true; fn_idx = cov_idx to u64 } } else { cov_off() }
    // MEM Step 1 — THE FRAME REGION. Run the escape check (escape.tks). When a TOP-LEVEL binding is
    // provably frame-local, open a per-function frame region `_tkfr` (a deterministic, per-fn-constant
    // name → fixpoint-safe, NOT buf.len) at entry; its frame-local allocations are bulk-freed on the
    // return edges (emit_return / emit_exprstmt_tail) and at the fall-through end. A function with NO
    // frame-local binding gets NO region — zero bytes, byte-identical to the pre-Step-1 output.
    var escaping = checker::fn_escaping_vars(f)
    var want_frame = fn_body_has_frame_local(prog, escaping, fbody) || f.has_arena_size
    var frame: str = if want_frame { "_tkfr" } else { "" }
    var use_rr = want_frame && !f.has_arena_size
    var rr: str = if use_rr { "_tkrr" } else { "" }
    var dctx = DeferCtx { defers = teko::list::empty(); loops = teko::list::empty(); cov = cov; rr = rr; bracket_depth = 0 }
    if use_rr { out = cb(out, "    tk_region *_tkrr = "); out = cb(out, cg_rr_init_expr()); out = cb(out, ";\n") }
    if want_frame {
        out = cb(out, "    tk_region *_tkfr = "); out = cb(out, cg_tkfr_init_expr(f, use_rr)); out = cb(out, ";\n")
        if use_rr { out = cb(out, "    tk_region_enter(_tkfr);\n") }
        if f.has_arena_size { out = cg_emit_arena_presize(out, f.arena_size) }
    }
    // W5a — a fn body's trailing expr-statement carrying a value implicitly returns it.
    // W5b — thread the fn's return type so a tail/return case value is wrapped into a variant
    // return slot (emit_as).
    out = match emit_block_tail(out, fbody, false, prog, f.return_type, "    ", frame, escaping, fbody, dctx) { []byte as o => o; error as err => return err }
    // (W9.3) FN-BODY FALL-THROUGH defers. When control can fall off the function's end and the tail is
    // NOT an expr-statement (a binding/assign/loop tail — an expr-stmt tail already drained via
    // emit_exprstmt_tail; a return/break/continue tail already drained on its edge), fire the remaining
    // fn-body-level defers (base 0) here, BEFORE the frame-region drop. (C: emit_function fn-fall-through.)
    var tail_is_expr = if fbody.len > 0 { match fbody[fbody.len - 1] { checker::TExprStmt => true; _ => false } } else { false }
    var tail_term = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
    if !tail_is_expr && !tail_term {
        // The fn-body fall-through fires ALL fn-body-level defers (base 0). Recompute the full list of
        // this body's direct defers (the same NODES emit_block_tail accumulated) and fire them LIFO.
        var fn_defers = cg_append_direct_defers(dctx.defers, fbody)
        out = match emit_defers(out, fn_defers, 0, prog, "    ", escaping, fbody) { []byte as o => o; error as err => return err }
    }
    // (W10b.CLASS increment 4) DESTRUCTION HOOK — the FALL-THROUGH exit edge. Same reachability
    // gate as the frame-region drop below (control must actually be able to reach here), but
    // INDEPENDENT of `want_frame`: a function with a frame-local class instance and no OTHER
    // frame-worthy struct auto-box still needs this edge (want_frame would otherwise be false).
    if !tail_term {
        // no tail/return expression here (the tail is a binding/assign/loop, not an expr-value) —
        // anything that referenced a class binding already ran EARLIER, in original order.
        var no_tail = checker::TExpr { kind = checker::TNullLit { }; type = checker::Void { }; line = 0; col = 0 }
        var cleanup = match cg_class_cleanup_text(prog, escaping, fbody, false, no_tail) { str as c => c; error as e => return e }
        if cleanup.len > 0 { out = cb(out, "    "); out = cb(out, cleanup); out = cb(out, "\n") }
    }
    // MEM Step 1 — the FALL-THROUGH exit edge. If control can reach the function's end (the tail did
    // not C-terminate), drop the frame region there too. tk_region_drop is idempotent, so this never
    // double-frees relative to a return-edge drop on another path.
    if want_frame {
        var tail_terminates = if fbody.len > 0 { cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { false }
        if !tail_terminates { out = cg_frame_exit(out, "    ", "_tkfr", use_rr) }
    }
    // A non-void function whose tail is a value-form `match`/`if` (or a loop) returns on every path
    // the CHECKER proved exhaustive — but C can't see that, so without a terminator it warns
    // -Wreturn-type and the fall-through is UB. The checker guarantees it is never reached: emit
    // `__builtin_unreachable()`. (Skip when the tail already C-terminates, and for void functions.)
    var needs_unreachable = match f.return_type {
        checker::Void => false
        _ => if fbody.len > 0 { !cg_stmt_c_terminates(fbody[fbody.len - 1]) } else { true }
    }
    if needs_unreachable { out = cb(out, "    __builtin_unreachable();\n") }
    cb(out, "}\n\n")
}

// ---------------------------------------------------------------------------
// W4c — TYPE DECLARATIONS -> C type declarations.
//   struct { f: T; … }    -> typedef struct tk_t_<M> { <Ctype> <f>; … } tk_t_<M>;
//   variant A | B | …     -> a tag enum tk_tag_<M> (one TK_TAG_<M>_<memberM> per member),
//                            then typedef struct tk_t_<M> { tk_tag_<M> tag;
//                            union { <memberCtype> <memberField>; … } as; } tk_t_<M>;
//   enum { A; B }         -> a C enum (typedef enum tk_t_<M> { TK_E_<M>_A, … } tk_t_<M>;)
// The `tag + union as` idiom is exactly what the bootstrap C itself uses (Type/TExpr).
// ---------------------------------------------------------------------------

// cb_upper — append the UPPERCASE form of a name's bytes (for enum/tag constants). Non
// lowercase bytes pass through verbatim (identifiers are alnum/underscore). (C: `cb_upper`.)
fn cb_upper(buf: []byte, s: str): []byte {
    var out = buf
    var i = 0
    loop {
        if i >= s.len { break }
        var c = s[i]
        if c >= b'a' && c <= b'z' {
            out = cb_byte(out, (c to i64 - b'a' to i64 + b'A' to i64) to byte)
        } else {
            out = cb_byte(out, c)
        }
        i++
    }
    out
}

// variant_member_name — a variant member's bare last path segment (the union field name for a
// NAMED member). Kept for the cg_variant_has_member scan. (C: `variant_member_name`.)
fn variant_member_name(m: @TypeExpr()): str | error {
    match m {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => error { message = "codegen: a variant member must be a named type" }
    }
}

/**
 * flags_carrier_ctype — the C unsigned integer type that carries a `flags` value, chosen by how
 * many bits the declaration must hold: 1–8 members -> `uint8_t`, 9–16 -> `uint16_t`,
 * 17–32 -> `uint32_t`, 33–64 -> `uint64_t`. There is no wider arm: `uint64_t` is the LAST carrier
 * because 128-bit primitives are gone from the language (owner ruling 2026-07-30, integers AND
 * floats), and the checker already caps a `flags` declaration at 64 members
 * (`checker::check_flags_member_cap`), so a count above 64 never reaches codegen.
 *
 * @param n  the declared member count (already ≤ 64, enforced in the checker)
 * @return   the C spelling of the carrier type
 * @since    0.3.1 (128-bit removal)
 */
fn flags_carrier_ctype(n: u64): str {
    if n <= 8 { return "uint8_t" }
    if n <= 16 { return "uint16_t" }
    if n <= 32 { return "uint32_t" }
    "uint64_t"
}

/**
 * emit_flags_member_const — emit ONE `flags` member's bit constant: `static const tk_t_<Name>
 * tk_t_<Name>_<MEMBER> = (tk_t_<Name>)(((uint64_t)1) << <ordinal>);`. The shift is composed on a
 * `uint64_t` one — the widest carrier a `flags` type can have — so the shifted bit is never
 * truncated before the cast to the (possibly narrower) carrier.
 *
 * @param buf       the C output buffer to grow
 * @param type_name the flags type's canonical name (mangled into its C typedef name)
 * @param member    the member's declared name (upper-cased in the constant's name)
 * @param ordinal   the member's declaration index, i.e. the bit it owns
 * @return          `buf` followed by the member's `static const` line
 * @since           0.3.1 (128-bit removal)
 */
fn emit_flags_member_const(buf: []byte, type_name: str, member: str, ordinal: u64): []byte {
    var out = cb(buf, "static const ")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, " ")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, "_")
    out = cb_upper(out, member)
    out = cb(out, " = (")
    out = mangle_type_name(out, "", type_name)
    out = cb(out, ")(((uint64_t)1) << ")
    out = cb_i64(out, ordinal to i64)
    cb(out, ");\n")
}

/**
 * emit_newtype_typedef — lower a §9 NOMINAL prim-backed value-type to a C typedef of its BACKING
 * machine type (`typedef <backing-C> tk_t_<Name>;`, ruling 9). The value IS the primitive, so the
 * typedef makes `tk_t_<Name>` and the backing C type assignment-compatible — the E9 newtype<->base
 * cast is a representation no-op, exactly like the enum<->int (E7) path.
 *
 * @param buf   the C output buffer to grow
 * @param prog  the codegen program (for backing type-expression emission)
 * @param d     the value-type declaration (its `name` names the emitted typedef)
 * @param nb    the newtype body (its `backing` is the primitive the typedef aliases)
 * @return      `buf` followed by the typedef and a blank separator line, or an emission error
 * @throws      when the backing type-expression fails to emit
 * @since §9
 */
fn emit_newtype_typedef(buf: []byte, prog: CgProg, d: parser::TypeDecl, nb: parser::NewtypeBody): []byte | error {
    var o = cb(buf, "typedef ")
    o = match emit_type_expr(o, prog, nb.backing, checker::name_qualifier(d.name)) { []byte as x => x; error as err => return err }
    o = cb(o, " ")
    o = mangle_type_name(o, "", d.name)
    cb(o, ";\n\n")
}

/**
 * emit_flags_typedef — the C typedef + member constants of a `flags` type: `typedef <carrier>
 * tk_t_<Name>;` then each member's `1 << i` constant, in declaration order (member `i` owns bit `i`).
 *
 * @param buf  the C output buffer to grow
 * @param d    the type declaration (its `name` names the emitted typedef)
 * @param fb   the flags body (its `members` are the declared names, in order)
 * @return     `buf` followed by the typedef, every member constant, and a blank separator line
 * @since      0.3.1 (128-bit removal — extracted while the `unsigned __int128` carrier arm died)
 */
fn emit_flags_typedef(buf: []byte, d: parser::TypeDecl, fb: parser::FlagsBody): []byte {
    var out = cb(buf, "typedef ")
    out = cb(out, flags_carrier_ctype(fb.members.len))
    out = cb(out, " ")
    out = mangle_type_name(out, "", d.name)
    out = cb(out, ";\n")
    var mi: u64 = 0
    loop {
        if mi >= fb.members.len { break }
        out = emit_flags_member_const(out, d.name, fb.members[mi], mi)
        mi++
    }
    cb(out, "\n")
}

/**
 * emit_type_decl — emit ONE type declaration. `d.name` is the bare name; the namespace is
 * empty (the typed item carries no provenance) so decl + ref mangle identically.
 *
 * @param buf   the C output buffer to grow
 * @param prog  the typed program (field/type resolution for the aggregate arms)
 * @param d     the type declaration to emit
 * @return      `buf` followed by `d`'s C declaration (empty for a compile-time-only body:
 *              a transparent alias, an interface, a trait)
 * @throws      when a body's shape is not emittable (a variant body that is not a union, a
 *              member type codegen cannot name)
 */
fn emit_type_decl(buf: []byte, prog: CgProg, d: parser::TypeDecl): []byte | error {
    match d.body {
        parser::StructBody as sb => {
            var out = cb(buf, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            /* (item-14 §13.2) the FAT value-struct header — a self-pointer word, FIRST member, so a
               field's offset is its declared offset plus one word in BOTH backends. A class gets none:
               it already owns an arena and therefore an intrinsic pointer/identity. */
            out = cb(out, "    tk_struct_hdr __hdr;\n")
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                out = cb(out, "    ")
                out = match emit_type_expr(out, prog, sb.fields[i].type_ann, checker::name_qualifier(d.name)) { []byte as o => o; error as err => return err }   // (#109 W3) ref_ns = the decl's own ns
                out = cb(out, " ")
                // auto-box: a recursive back-edge field is a heap pointer (finite C struct).
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { out = cb(out, "*") }
                out = cb_str(out, sb.fields[i].name)
                out = cb(out, ";\n")
                i++
            }
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::ClassBody as cb2 => {   // (W10b.CLASS) same C representation as a struct — same field
            // layout, no arena-per-object yet. Increment 2: the EFFECTIVE (base-inherited) fields,
            // so a derived class's C struct physically contains every ancestor's field too
            // (field-flattening composition — no embedded C object/vtable).
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error as err => return err }
            var out = cb(buf, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= fields.len { break }
                out = cb(out, "    ")
                out = match emit_type_expr(out, prog, fields[i].type_ann, checker::name_qualifier(d.name)) { []byte as o => o; error as err => return err }   // (#109 W3) ref_ns = the decl's own ns
                out = cb(out, " ")
                if cg_field_boxed(prog, d.name, fields[i].type_ann) { out = cb(out, "*") }
                out = cb_str(out, fields[i].name)
                out = cb(out, ";\n")
                i++
            }
            // (W10b.CLASS increment 4) a HIDDEN field carrying the instance's OWN arena-per-object
            // region handle — invisible to the Teko-level type system (the checker never sees it;
            // no `Field` entry), set once at construction (emit_struct_init_framed) and read back
            // at a frame-local binding's scope exit to drop the object's region (and, first, call
            // `destruct()` if the class declares one) — the retention mechanism a per-object
            // region needs to be reclaimed at ALL (increment 3 left this open: nothing tracked the
            // region handle past the construction expression itself).
            out = cb(out, "    tk_region *__region;\n")
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::InterfaceBody => {   // (W10b.IF) an interface is a COMPILE-TIME contract only — NO
            // runtime C type is emitted (dynamic dispatch / vtable is ROUND 3). Like a transparent
            // alias, it lowers to nothing; the checker rejects using an interface as a value type.
            buf
        }
        parser::TraitBody => {   // (TR0) a trait is COMPILE-TIME only — its members were FOLDED
            // into every deriver before typing (fold_traits), and the checker rejects a trait in
            // any value/instantiation position, so the decl itself lowers to nothing.
            buf
        }
        parser::VariantBody as vb => {
            // A variant body is a UnionType (A | B | …). Members may be ANY type (B-cg2):
            // named cases, `error`, prims, slices — each mapped to a C-safe member KEY.
            var members = match vb.type_expr {
                parser::UnionType as u => u.members
                _ => return error { message = "codegen: a variant body must be a union of members" }
            }
            // 1) the tag enum: TK_TAG_<UPPER Name>_<UPPER memberKey> per member.
            var out = cb(buf, "typedef enum tk_tag_")
            out = cb_tysym(out, d.name)   // (#149) canonical d.name carries `::` → collapse (mirror C's cb_tysym)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= members.len { break }
                var mk = match cg_member_key_texpr_str(prog, members[i], checker::name_qualifier(d.name)) { str as s => s; error as err => return err }
                out = cb(out, "    TK_TAG_")
                out = cb_upper(out, cg_ns_c_key(d.name))
                out = cb(out, "_")
                out = cb_upper(out, mk)
                if i + 1 < members.len { out = cb(out, ",") }
                out = cb(out, "\n")
                i++
            }
            out = cb(out, "} tk_tag_")
            out = cb_tysym(out, d.name)   // (#149) collapse
            out = cb(out, ";\n\n")
            // 2) the value: tag + union as. Each union field is named by the member KEY and
            //    typed via emit_type_expr (covers named/error/prim/slice/optional members).
            out = cb(out, "typedef struct ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n    tk_tag_")
            out = cb_tysym(out, d.name)   // (#149) collapse
            out = cb(out, " tag;\n    union {\n")
            var j = 0
            loop {
                if j >= members.len { break }
                var mem = members[j]
                var mk = match cg_member_key_texpr_str(prog, mem, checker::name_qualifier(d.name)) { str as s => s; error as err => return err }
                out = cb(out, "        ")
                out = match emit_type_expr(out, prog, mem, checker::name_qualifier(d.name)) { []byte as o => o; error as err => return err }   // (#109 W3) ref_ns = the decl's own ns
                out = cb(out, " ")
                out = cb_str(out, mk)   // union field == the member key
                out = cb(out, ";\n")
                j++
            }
            out = cb(out, "    } as;\n} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::EnumBody as eb => {
            var out = cb(buf, "typedef enum ")
            out = mangle_type_name(out, "", d.name)
            out = cb(out, " {\n")
            var i = 0
            loop {
                if i >= eb.members.len { break }
                out = cb(out, "    TK_E_")
                out = cb_upper(out, checker::name_last_segment(d.name))   // (#109 W3) BARE enum name
                out = cb(out, "_")
                out = cb_upper(out, eb.members[i])
                if i + 1 < eb.members.len { out = cb(out, ",") }
                out = cb(out, "\n")
                i++
            }
            out = cb(out, "} ")
            out = mangle_type_name(out, "", d.name)
            cb(out, ";\n\n")
        }
        parser::AliasBody => {
            // A TRANSPARENT alias emits NO C type — references resolve through to the aliased
            // type at the checker, and codegen emits that resolved type at every use site.
            buf
        }
        parser::NewtypeBody as nb => match emit_newtype_typedef(buf, prog, d, nb) { []byte as x => x; error as err => return err }
        parser::FlagsBody as fb => emit_flags_typedef(buf, d, fb)
        parser::ExternBody => {
            // (C7.1a) an OPAQUE foreign handle → a C `void *` typedef, so the existing
            // Named → tk_t_<Name> mangle resolves to it (distinct in Teko, plain `void *` in C).
            var o = cb(buf, "typedef void *")
            o = mangle_type_name(o, "", d.name)
            cb(o, ";\n\n")
        }
    }
}

/**
 * B-cg2 — SLICE/VARIANT TYPEDEF COLLECTION: the codegen registry of distinct anonymous types
 * needing a typedef, each stored ALONGSIDE its already-computed mangled key so a dedup scan READS
 * the key (O(1)) rather than recomputing it (the owner's "assign the converted value once, then
 * only reference it"). The keys are collision-safe by construction: the SAME mangled string
 * already used for dedup, so two types that mangle equal still collapse to one typedef (mangle-eq,
 * not type-eq). Every distinct slice element / inline variant type used in the typed program needs
 * its `tk_slice_<elem>` / `tk_u_<keys>` typedef emitted once in the prelude; we walk every type
 * that flows through emit_type (function sigs, bindings, every TExpr `.type`), collecting distinct
 * elements (deduped by mangled name) in ONE walk. Nested slices register the element first so its
 * typedef precedes the outer's reference. Threaded by return value (the functional `.tks` idiom),
 * mirroring the C's `cg_opt_set`. `inners`/`opt_keys` are RETIRED (the null-as-union pivot dropped
 * the `tk_opt_<inner>` nullable former) — kept as permanently empty fields rather than threaded out
 * of every `CgTypeSet` construction site. (C: the cg_opt_set / cg_collect_* family.)
 */
type CgTypeSet = struct {
    /** RETIRED (the `tk_opt_<inner>` nullable former is gone) — always empty. */
    inners: []@Type()
    /** RETIRED alongside `inners` — always empty. */
    opt_keys: []str
    /** Slice element types needing a `tk_slice_<key>` typedef, in registration order. */
    slices: []@Type()
    /** The mangled dedup key of each `slices` entry, computed once at insertion. */
    slice_keys: []str
    /** Inline variant types needing a `tk_u_<keys>` typedef, in registration order. */
    variants: []@Type()
    /** The mangled dedup key of each `variants` entry, computed once at insertion. */
    variant_keys: []str
}

/**
 * The mangled-name dedup key for a type; the empty string `""` for an unsupported type (skipped).
 *
 * Used for both optional inners and slice elements (same mangle). Renders `cg_opt_mangle` into a
 * scratch buffer and materializes it once, so callers store the result rather than recompute it.
 *
 * @param t  the type to mangle
 * @return   the mangled key, or `""` if `t` cannot be mangled
 */
fn cg_opt_key(t: @Type()): str {
    match cg_opt_mangle(teko::list::empty(), t) { []byte as o => str(o); error => "" }
}
/**
 * Register a slice element type in the codegen set, deduped by its mangled key.
 *
 * Computes the key ONCE, pushes it to `slice_keys`, and dedup scans read the stored key. An
 * unsupported element (empty key) is skipped so `emit_type` errors honestly.
 *
 * @param set   the registry to extend
 * @param elem  the slice's element type to register
 * @return      the set with `elem` appended, or unchanged if already present or unsupported
 */
fn cg_slice_add(set: CgTypeSet, elem: @Type()): CgTypeSet {
    var key = cg_opt_key(elem)
    if key == "" { return set }
    var i = 0
    loop {
        if i >= set.slice_keys.len { break }
        if set.slice_keys[i] == key { return set }
        i++
    }
    CgTypeSet { inners = set.inners; opt_keys = set.opt_keys; slices = teko::list::push(set.slices, elem); slice_keys = teko::list::push(set.slice_keys, key); variants = set.variants; variant_keys = set.variant_keys }
}
/**
 * B-cg2 — the dedup key for an INLINE variant type (its `tk_u_<keys>` name); `""` for unsupported.
 *
 * Renders `cg_variant_typename` into a scratch buffer and materializes it once. (C:
 * `cg_variant_typename` render-to-scratch.)
 *
 * @param t  the type to key; only an inline `Variant` yields a non-empty key
 * @return   the mangled variant name, or `""` if `t` is not a mangleable inline variant
 */
fn cg_variant_key(t: @Type()): str {
    match t {
        checker::Variant as v => match cg_variant_typename(teko::list::empty(), v) { []byte as o => str(o); error => "" }
        _ => ""
    }
}
/**
 * B-cg2 — register an INLINE variant type in the codegen set, deduped by its `tk_u_<keys>` name.
 *
 * A Named variant carries its own decl typedef and is NOT registered here. Computes the key ONCE,
 * pushes it to `variant_keys`, and dedup scans read the stored key. An unsupported member (empty
 * key) is skipped so `emit_type` errors honestly.
 *
 * @param set  the registry to extend
 * @param t    the inline variant type to register
 * @return     the set with `t` appended, or unchanged if already present or unsupported
 */
fn cg_variant_add(set: CgTypeSet, t: @Type()): CgTypeSet {
    var key = cg_variant_key(t)
    if key == "" { return set }
    var i = 0
    loop {
        if i >= set.variant_keys.len { break }
        if set.variant_keys[i] == key { return set }
        i++
    }
    CgTypeSet { inners = set.inners; opt_keys = set.opt_keys; slices = set.slices; slice_keys = set.slice_keys; variants = teko::list::push(set.variants, t); variant_keys = teko::list::push(set.variant_keys, key) }
}
/**
 * cg_collect_type_opts — register every slice's element in a type (nested elements first, so
 * `[][]T` orders right), and every INLINE `A | B | …` variant (recursing into each member FIRST,
 * so a member that is a slice gets its typedef before the enclosing `tk_u_<keys>` references it).
 * (C: `cg_collect_type_opts`.)
 *
 * @param set  the registry accumulated so far
 * @param t    the resolved type to walk
 * @return     `set` extended with every slice/variant `t` reaches
 */
fn cg_collect_type_opts(set: CgTypeSet, t: @Type()): CgTypeSet {
    match t {
        checker::Slice as sl => match sl.element {
            checker::Void => set
            _ => cg_slice_add(cg_collect_type_opts(set, sl.element), sl.element)
        }
        checker::Variant as va => {
            var s = set
            var i = 0
            loop {
                if i >= va.members.len { break }
                s = cg_collect_type_opts(s, va.members[i])
                i++
            }
            cg_variant_add(s, t)
        }
        _ => set
    }
}
fn cg_collect_expr_opts(set: CgTypeSet, e: checker::TExpr): CgTypeSet {
    var s = cg_collect_type_opts(set, e.type)   // the node's own resolved type may be `T?` / `[]T`
    match e.kind {
        checker::TBinary as b => { s = cg_collect_expr_opts(s, b.left); s = cg_collect_expr_opts(s, b.right) }
        checker::TUnary as u => { s = cg_collect_expr_opts(s, u.operand) }
        checker::TCompare as c => {
            s = cg_collect_expr_opts(s, c.first)
            var i = 0
            loop { if i >= c.rest.len { break }; s = cg_collect_expr_opts(s, c.rest[i].operand); i++ }
        }
        checker::TCall as cl => { var i = 0; loop { if i >= cl.args.len { break }; s = cg_collect_expr_opts(s, cl.args[i]); i++ } }
        checker::TIfExpr as f => {
            s = cg_collect_expr_opts(s, f.cond)
            s = cg_collect_block_opts(s, f.then_blk)
            s = cg_collect_block_opts(s, f.else_blk)
        }
        checker::TMatchExpr as m => {
            s = cg_collect_expr_opts(s, m.subject)
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cg_collect_expr_opts(s, m.arms[i].guard) }
                s = cg_collect_block_opts(s, m.arms[i].body)
                i++
            }
        }
        checker::TCast as c => { s = cg_collect_expr_opts(s, c.expr) }
        checker::TFieldAccess as fa => { s = cg_collect_expr_opts(s, fa.receiver) }
        checker::TStructInit as si => { var i = 0; loop { if i >= si.field_vals.len { break }; s = cg_collect_expr_opts(s, si.field_vals[i]); i++ } }
        checker::TIndex as ix => { s = cg_collect_expr_opts(s, ix.receiver); s = cg_collect_expr_opts(s, ix.index) }
        checker::TInterp as in => {
            var i = 0
            loop {
                if i >= in.holes.len { break }
                s = cg_collect_expr_opts(s, in.holes[i])
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            var k = 0
                            loop { if k >= fd.args.len { break }; s = cg_collect_expr_opts(s, fd.args[k]); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
        }
        checker::TInExpr as ie => { s = cg_collect_expr_opts(s, ie.lhs); var i = 0; loop { if i >= ie.elems.len { break }; s = cg_collect_expr_opts(s, ie.elems[i]); i++ } }
        // (#119) A lambda literal's own resolved type (registered above, at entry) is its FUNCTION
        // type — that carries no tk_opt_/tk_slice_/tk_u_ typedef of its own, so an optional/slice/
        // variant used ONLY inside the lambda's params/return/body (never anywhere else in the
        // enclosing function) was never visited: the collector fell through to the `_` leaf arm and
        // missed the whole body. A lifted lambda's body is emitted as its own function
        // (cg_emit_lambda_decls, capturing; or a synthesized top-level fn, non-capturing) — same as
        // any other function body — so it needs the SAME typedef registration a normal function
        // body gets. (C: the TK_TEXPR_LAMBDA case of cg_collect_expr_opts.)
        checker::TLambda as lam => {
            var i = 0
            loop { if i >= lam.params.len { break }; s = cg_collect_type_opts(s, lam.params[i].type); i++ }
            s = cg_collect_type_opts(s, lam.ret)
            s = cg_collect_block_opts(s, lam.body)
        }
        checker::TBlockExpr as blk => { s = cg_collect_block_opts(s, blk.body) }
        _ => { }   // leaves: type already registered above
    }
    s
}
fn cg_collect_block_opts(set: CgTypeSet, stmts: []@TStatement()): CgTypeSet {
    var s = set
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            checker::TBinding as b => { s = cg_collect_type_opts(s, b.bound); s = cg_collect_expr_opts(s, b.value) }
            // collect a.bound too (the target's declared type — the present-wrap target,
            // coerce_to(a.bound)): a deref-assign `r.value = v` through a `Ref<T?>` has bound=`T?`,
            // and that optional's tk_opt_<T> typedef must be emitted even when the value's own type is a
            // bare `T` (widened) — mirrors the TBinding arm collecting b.bound.
            checker::TAssign as a => { s = cg_collect_type_opts(s, a.bound); s = cg_collect_expr_opts(s, a.value); if parser::assign_has_target(a.kind) { s = cg_collect_expr_opts(s, a.target) } }
            checker::TReturn as r => { if r.has_value { s = cg_collect_expr_opts(s, r.value) } }
            checker::TLoopStmt as l => { s = cg_collect_block_opts(s, l.init); s = cg_collect_block_opts(s, l.body) }
            checker::TExprStmt as es => { s = cg_collect_expr_opts(s, es.expr) }
            checker::TDeferStmt as d => { s = cg_collect_block_opts(s, d.body) }
            checker::TAdoptStmt as a => { s = cg_collect_block_opts(s, a.body) }
            checker::TBlockStmt as b => { s = cg_collect_block_opts(s, b.body) }
            _ => { }
        }
        i++
    }
    s
}
/** Convert a SYNTACTIC type-expr to a resolved Type only as far as the typedef collector needs
 *  (cg_collect_type_opts walks Slice/Variant; every other node is a no-op leaf). A
 *  struct/variant FIELD's slice/variant whose type surfaces nowhere in any expression
 *  (only in the declaration) would otherwise never feed the collector, so its tk_opt_/tk_slice_/
 *  tk_u_ typedef is never emitted and `cc` fails with "unknown type name". `ref_ns` is the
 *  ENCLOSING decl's namespace: a bare same-namespace field ref (`[]ValBinding` inside
 *  teko::checker::Env) resolves to its canonical name (teko::checker::ValBinding) via
 *  cg_find_decl_ns, so the collected element's `tk_t_<name>` body matches the qualified named-decl
 *  typedef — a field-ONLY element (never surfaced by an expression) is otherwise stored bare and
 *  dangles (the #109 bare-name gap). The typedef NAME mangle (name_last_segment, always bare) is
 *  unaffected; only the element BODY is qualified. The prim mapping mirrors emit_type_expr exactly. */
fn cg_te_to_type_ns(prog: CgProg, ref_ns: str, te: @TypeExpr()): @Type() {
    match te {
        parser::NamedType as nt => {
            var last = nt.path.segments[nt.path.segments.len - 1].name
            if last == "u8" { checker::Prim { kind = checker::PrimKind::U8 } }
            else if last == "u16" { checker::Prim { kind = checker::PrimKind::U16 } }
            else if last == "u32" { checker::Prim { kind = checker::PrimKind::U32 } }
            else if last == "u64" { checker::Prim { kind = checker::PrimKind::U64 } }
            else if last == "i8" { checker::Prim { kind = checker::PrimKind::I8 } }
            else if last == "i16" { checker::Prim { kind = checker::PrimKind::I16 } }
            else if last == "i32" { checker::Prim { kind = checker::PrimKind::I32 } }
            else if last == "i64" { checker::Prim { kind = checker::PrimKind::I64 } }
            else if last == "f32" { checker::Prim { kind = checker::PrimKind::F32 } }
            else if last == "f64" { checker::Prim { kind = checker::PrimKind::F64 } }
            else if last == "bool" { checker::Prim { kind = checker::PrimKind::Bool } }
            else if last == "usize" { checker::Prim { kind = checker::PrimKind::Usize } }   // (§8) unsigned machine word
            else if last == "size" { checker::Prim { kind = checker::PrimKind::Size } }   // (§8) signed machine word
            else if last == "byte" { checker::Byte { } }
            else if last == "str" { checker::Str { } }
            else if last == "error" { checker::Error { } }
            else if last == "void" { checker::Void { } }
            else if last == "()" { checker::Void { } }   // (0.3.1 §2) the unit-return sentinel of `action`/no-return `func` delegate types
            else if last == "null" { checker::Null { } }
            else if last == "uptr" { checker::Uptr { } }
            else if last == "Ref" { if nt.args.len > 0 { checker::Reference { inner = cg_te_to_type_ns(prog, ref_ns, nt.args[0]) } } else { checker::Reference { inner = checker::Void { } } } }
            else if last == "ptr" { checker::Ptr { inner = null } }
            else { checker::Named { name = cg_te_canonical_name(prog, ref_ns, nt.path, last) } }
        }
        parser::SliceType as st => checker::Slice { element = cg_te_to_type_ns(prog, ref_ns, st.element) }
        parser::UnionType as ut => {
            var mem: []@Type() = teko::list::empty()
            var i = 0
            loop {
                if i >= ut.members.len { break }
                mem = teko::list::push(mem, cg_te_to_type_ns(prog, ref_ns, ut.members[i]))
                i++
            }
            checker::Variant { members = cg_union_normalize_null(mem) }
        }
        parser::FunctionType => checker::Func { params = teko::list::empty(); ret = checker::Void { }; variadic = false; param_names = []; n_required = 0; defaults = []; ret_extra = teko::list::empty() }
        parser::MacroType => checker::Void { }
    }
}

/** The canonical qualified name of a user named-type reference at a field/member position: resolve
 *  the syntactic path in `ref_ns` to its decl (cg_find_decl_ns) and take the decl's canonical name;
 *  fall back to the bare last segment when no decl matches (a type-param `T`, a generic `__g__`
 *  instance — those stay bare exactly as emit_type expects). */
fn cg_te_canonical_name(prog: CgProg, ref_ns: str, path: parser::Path, last: str): str {
    match cg_find_decl_ns(prog, path, ref_ns) {
        parser::TypeDecl as d => d.name
        error => last
    }
}

/** Register the generated typedefs (tk_opt_/tk_slice_/tk_u_) a decl's FIELD/MEMBER type
 *  annotations need, resolving names in the decl's own namespace. A named variant decl gets
 *  its own tk_t_<Name> typedef via the named-decl path, so a UnionType body recurses per-member
 *  rather than registering the whole union as an unused inline tk_u_<keys> (which would break
 *  byte-identity). Enum/flags/extern bodies carry no generated typedef. */
fn cg_register_decl_field_types(set: CgTypeSet, prog: CgProg, d: parser::TypeDecl): CgTypeSet {
    var ref_ns = checker::name_qualifier(d.name)
    match d.body {
        parser::StructBody as sb => cg_register_field_list(set, prog, ref_ns, sb.fields)
        parser::VariantBody as vb => cg_register_variant_body(set, prog, ref_ns, vb.type_expr)
        parser::AliasBody as alb => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, alb.alias))
        _ => set
    }
}

/** Register every field's optional/slice/variant type in a struct body's field list. */
fn cg_register_field_list(set: CgTypeSet, prog: CgProg, ref_ns: str, fields: []parser::Field): CgTypeSet {
    var s = set
    var fi = 0
    loop {
        if fi >= fields.len { break }
        s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, fields[fi].type_ann))
        fi++
    }
    s
}

/** Register a variant decl body's member typedefs: a UnionType recurses per-member (each named
 *  member owns its tk_t_<Name>); any other body registers its single type-expr directly. */
fn cg_register_variant_body(set: CgTypeSet, prog: CgProg, ref_ns: str, te: @TypeExpr()): CgTypeSet {
    match te {
        parser::UnionType as ut => {
            var s = set
            var mi = 0
            loop {
                if mi >= ut.members.len { break }
                s = cg_collect_type_opts(s, cg_te_to_type_ns(prog, ref_ns, ut.members[mi]))
                mi++
            }
            s
        }
        _ => cg_collect_type_opts(set, cg_te_to_type_ns(prog, ref_ns, te))
    }
}

// B-cg2 — emit ONE inline-variant typedef tk_u_<keys> (the SAME tag-enum + tag/union-struct
// shape as a named variant decl, but keyed off the resolved member types). Members' typedefs
// (slice/opt) precede it by registration order. (C: `cg_emit_inline_variant_typedef`.)
fn cg_emit_inline_variant_typedef(buf: []byte, prog: CgProg, v: checker::Variant): []byte | error {
    match cg_union_niche_member(prog, v) {
        (@Type()) as _gt14 => return buf
        null => { }
    }
    match cg_union_box_member(prog, v) {
        (@Type()) as _gt15 => return buf
        null => { }
    }
    // tag enum: typedef enum tk_tag_<keys> { TK_TAG_U_<UPPER keys…>_<UPPER key>, … } tk_tag_<keys>;
    var out = cb(buf, "typedef enum tk_tag")
    var a = 0
    loop {
        if a >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[a]) { []byte as o => o; error as err => return err }
        a++
    }
    out = cb(out, " {\n")
    var i = 0
    loop {
        if i >= v.members.len { break }
        out = cb(out, "    TK_TAG_U")
        var j = 0
        loop {
            if j >= v.members.len { break }
            out = cb(out, "_")
            var kj = match cg_member_key_str(v.members[j]) { str as s => s; error as err => return err }
            out = cb_upper(out, kj)
            j++
        }
        out = cb(out, "_")
        var ki = match cg_member_key_str(v.members[i]) { str as s => s; error as err => return err }
        out = cb_upper(out, ki)
        if i + 1 < v.members.len { out = cb(out, ",") }
        out = cb(out, "\n")
        i++
    }
    out = cb(out, "} tk_tag")
    var b = 0
    loop {
        if b >= v.members.len { break }
        out = cb(out, "_")
        out = match cg_member_key(out, v.members[b]) { []byte as o => o; error as err => return err }
        b++
    }
    out = cb(out, ";\n")
    out = cb(out, "typedef struct ")
    out = match cg_variant_typename(out, v) { []byte as o => o; error as err => return err }
    out = cb(out, " {\n    ")
    out = match cg_union_tag_ctype(out, v) { []byte as o => o; error as err => return err }
    out = cb(out, " tag;\n    union {\n")
    var m = 0
    loop {
        if m >= v.members.len { break }
        out = cb(out, "        ")
        out = match emit_type(out, prog, v.members[m]) { []byte as o => o; error as err => return err }
        out = cb(out, " ")
        out = match cg_member_key(out, v.members[m]) { []byte as o => o; error as err => return err }
        out = cb(out, ";\n")
        m++
    }
    out = cb(out, "    } as;\n} ")
    out = match cg_variant_typename(out, v) { []byte as o => o; error as err => return err }
    cb(out, ";\n")
}

// =========================================================================
// SELF-HOST — TOPOLOGICAL type-declaration emission. A struct/variant body embeds named
// aggregates, optionals (tk_opt_) and inline variants (tk_u_) BY VALUE, so each must be FULLY
// defined BEFORE the body that embeds it. Slices (tk_slice_) are pointer-only (their named
// elements have forward typedefs), so they are emitted up front. The remaining {named, opt,
// inline-variant} typedefs are emitted in DEPENDENCY order by a fixpoint: each pass emits every
// not-yet-emitted node whose by-value dependencies are already emitted, until none remain. The
// value-type graph is a DAG (every Teko recursion passes through a slice = pointer), so the
// fixpoint terminates; a residue means a genuine cyclic value type (an internal error).
// (C: the cg_typenodes / cg_*_ready / cg_emit_types_ordered family.)
// =========================================================================
// The "already-emitted" tracking. C uses parallel bool arrays keyed by index; the functional
// `.tks` idiom tracks the emitted KEYS in lists and checks membership (named decls by name,
// optionals by inner mangle key, inline variants by tk_u_<keys> key).
type CgEmitted = struct { names: []str; opt_keys: []str; uvar_keys: []str }

fn cg_str_in(xs: []str, s: str): bool {
    var i = 0
    loop { if i >= xs.len { break }; if xs[i] == s { return true }; i++ }
    false
}
// Has the named decl `name` been emitted? (a builtin/scalar not in our set has no edge → ready.)
// (#109 W3) em.names holds CANONICAL emitted decl names; a readiness probe (cg_texpr_ready) passes a
// BARE syntactic field segment. Match by bare last-segment so decl+dep agree regardless of ns form.
// (#109 order fix) EXACT-name decl probe (never the bare-last-segment fallback) — the precise
// readiness gate needs the one decl the canonical name denotes, not a same-bare cousin.
fn cg_find_decl_exact(prog: CgProg, name: str): parser::TypeDecl | error {
    if prog.ix.exact.slots.len != 0 { return cg_decl_at(prog, cg_table_get(prog.ix.exact, name)) }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == name { return d } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such type decl" }
}
// (#109 order fix) NAMESPACE-PRECISE readiness probe: a CANONICAL struct/variant name gates on
// ITS OWN emission (exact-name membership in `em`), never on a same-bare cousin from another
// namespace — discovery (readdir) order differs per platform, and on ubuntu io::Reader emitted
// early satisfied the emit codec structs' bare `Reader` edge before emit::Reader existed → cc
// "field has incomplete type". Non-body categories (interface/class/enum/alias/type-param/
// builtin/instance) keep the bare probe below.
fn cg_named_emitted_precise(prog: CgProg, em: CgEmitted, name: str): bool {
    if checker::name_qualifier(name) != "" {
        match cg_find_decl_exact(prog, name) {
            parser::TypeDecl as dd => {
                var gate = match dd.body { parser::StructBody => true; parser::VariantBody => true; _ => false }
                if gate { return cg_str_in(em.names, name) }
            }
            error => { }
        }
    }
    cg_named_emitted(em, name)
}
fn cg_named_emitted(em: CgEmitted, name: str): bool {
    var want = checker::name_last_segment(name)
    var i = 0
    loop {
        if i >= em.names.len { break }
        if checker::name_last_segment(em.names[i]) == want { return true }
        i++
    }
    false
}
/**
 * Report whether the inline variant whose typename is `key` has already been emitted.
 *
 * A variant not present in the collected set carries no dependency edge and is ready. The
 * presence scan READS the stored `variant_keys` rather than recomputing each variant's mangle.
 *
 * @param em   the emitted-so-far record
 * @param set  the collected type registry
 * @param key  the `tk_u_<keys>` name of the variant in question
 * @return     true if the variant is uncollected (no edge) or already emitted
 */
fn cg_uvar_emitted_key(em: CgEmitted, set: CgTypeSet, key: str): bool {
    var i = 0
    var present = false
    loop {
        if i >= set.variant_keys.len { break }
        if set.variant_keys[i] == key { present = true; break }
        i++
    }
    if !present { return true }
    cg_str_in(em.uvar_keys, key)
}
/**
 * cg_type_ready — by-value readiness of a resolved type (a variant member tk_type). (#122) A
 * CLASS inner is stored as a POINTER (`tk_t_C *`) inside a variant, so it needs only the forward
 * typedef (always present) — READY like a slice. Requiring the full class body would deadlock
 * the fixpoint.
 *
 * @param prog  the typed program (class/interface resolution)
 * @param em    the emitted-so-far record
 * @param set   the collected type registry
 * @param t     the resolved type to test
 * @return      true iff `t` carries no unemitted by-value dependency
 */
fn cg_type_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, t: @Type()): bool {
    match t {
        checker::Named as nm => if cg_is_class_named(prog, nm.name) { true } else { cg_named_emitted_precise(prog, em, nm.name) }
        checker::Variant as va => cg_uvar_emitted_key(em, set, cg_variant_key(t))
        checker::Slice => true   // pointer (slice typedef pre-emitted)
        _ => true   // prim/byte/str/error/void/func — no aggregate edge
    }
}
/**
 * cg_is_builtin_scalar — is `last` a builtin scalar name (no aggregate edge → ready)?
 *
 * @param last  the surface type name to classify
 * @return      whether `last` names a builtin scalar
 */
fn cg_is_builtin_scalar(last: str): bool {
    last == "u8" || last == "u16" || last == "u32" || last == "u64" ||
    last == "i8" || last == "i16" || last == "i32" || last == "i64" ||
    last == "f32" || last == "f64" || last == "bool" || last == "byte" ||
    last == "usize" || last == "size" ||   // (§8) machine words — scalars (uint64_t/int64_t), no aggregate edge
    last == "str" || last == "error" || last == "ptr" || last == "uptr" ||   // (C7.1a) opaque FFI transport types
    last == "Ref"   // (MEM-1b) Ref<T> lowers to a pointer → no by-value aggregate edge
}
/**
 * cg_texpr_union_ready — by-value readiness of a struct-field / variant-member INLINE UNION type-expr.
 *
 * A null-BEARING union (`X | null`) routes through its RESOLVED representation so the readiness key
 * matches the one the type-set collected and the field emitter (`emit_type_expr`) spells — the C5
 * resolve null-first normalizes the member order, so the SOURCE-ORDER syntactic key would mismatch
 * and falsely report "no edge" (emitting the enclosing struct BEFORE the union body → cc "incomplete
 * type"). A niche or box-in-arena union stores an 8-byte handle (a pointer whose forward typedef is
 * always present) and is READY like a slice; an inline-tag union embeds its `tk_u_<keys>` struct by
 * value and gates on that struct's emission. A null-FREE union keeps the legacy source-order key.
 *
 * @param prog      the typed program (union representation classification)
 * @param em        the emitted-so-far record
 * @param set       the collected type registry
 * @param ut        the syntactic inline-union type-expr
 * @param owner_ns  the owner decl's namespace (resolves the union's member paths)
 * @return          true when the union carries no by-value edge (pointer / uncollected) or is emitted
 * @since 0.3.0.30 (nullfield)
 */
fn cg_texpr_union_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, ut: parser::UnionType, owner_ns: str): bool {
    if !cg_texpr_union_has_null(ut) {
        return cg_uvar_emitted_key(em, set, match cg_variant_typename_texpr(teko::list::empty(), prog, ut, owner_ns) { []byte as o => str(o); error => "" })
    }
    var resolved = cg_te_to_type_ns(prog, owner_ns, parser::UnionType { members = ut.members })
    var va = match resolved { checker::Variant as v => v; _ => return cg_uvar_emitted_key(em, set, match cg_variant_typename_texpr(teko::list::empty(), prog, ut, owner_ns) { []byte as o => str(o); error => "" }) }
    match cg_union_niche_member(prog, va) { (@Type()) as _gt16 => return true; null => { } }
    match cg_union_box_member(prog, va) { (@Type()) as _gt17 => return true; null => { } }
    cg_uvar_emitted_key(em, set, cg_variant_key(va))
}
// By-value readiness of a field/member SYNTACTIC type-expr (struct field / variant member).
fn cg_texpr_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, te: @TypeExpr(), owner_ns: str): bool {
    match te {
        parser::NamedType as nt => {
            var stem = nt.path.segments[nt.path.segments.len - 1].name
            if cg_is_builtin_scalar(stem) { return true }   // builtin scalar → ready
            // (#122) a CLASS field is a POINTER (`tk_t_C *`) — it only needs the forward typedef
            // (always present by this pass), never the full body. So it is READY like a slice; a
            // recursive class-optional (`Node?` inside class `Node`) would otherwise be an
            // unbreakable by-value cycle here even though the C layout is finite.
            if cg_is_class_named(prog, stem) { return true }
            // (S4) a generic-type USE `Box<i64>` depends on the concrete instance `Box__g__i64`, not
            // the (dropped) template `Box` — gate on the instance name.
            if nt.args.len > 0 { return cg_named_emitted(em, cg_texpr_inst_name(stem, nt.args)) }
            // (#109 order fix) resolve the SYNTACTIC path in the OWNER decl's namespace, so the
            // edge points at THAT decl (namespace-precise), not a same-bare cousin.
            var want = match cg_find_decl_ns(prog, nt.path, owner_ns) { parser::TypeDecl as dd => dd.name; error => stem }
            cg_named_emitted_precise(prog, em, want)
        }
        parser::SliceType => true   // pointer (slice typedef pre-emitted)
        parser::UnionType as ut => cg_texpr_union_ready(prog, em, set, ut, owner_ns)
        parser::FunctionType => true   // (W10a) tk_closure is a runtime type — always ready
        parser::MacroType => false
    }
}
// Is a named decl's body emittable now (all its by-value field/member deps already emitted)?
fn cg_named_ready(prog: CgProg, em: CgEmitted, set: CgTypeSet, d: parser::TypeDecl): bool {
    var owner_ns = checker::name_qualifier(d.name)   // (#109 order fix) bare field refs resolve here
    match d.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                // a boxed (recursive back-edge) field is a POINTER — needs only a forward typedef,
                // so it is NOT a by-value dependency (this is what breaks the cycle for the fixpoint).
                if cg_field_boxed(prog, d.name, sb.fields[i].type_ann) { i++ } else {
                    if !cg_texpr_ready(prog, em, set, sb.fields[i].type_ann, owner_ns) { return false }
                    i++
                }
            }
            true
        }
        parser::VariantBody as vb => match vb.type_expr {
            parser::UnionType as u => {
                var i = 0
                loop {
                    if i >= u.members.len { break }
                    if !cg_texpr_ready(prog, em, set, u.members[i], owner_ns) { return false }
                    i++
                }
                true
            }
            _ => true
        }
        // (#122) a CLASS body has the same C layout as a struct (its EFFECTIVE, base-inherited
        // fields laid out by value), so its BY-VALUE field deps (e.g. a `Node?` optional wrapping
        // a class POINTER → `tk_opt_Node`) must be emitted first. Without this a class body is
        // emitted before the `tk_opt_<inner>` it embeds is defined → cc errors "incomplete type".
        // A class-named field is itself a pointer (cg_texpr_ready returns ready), so a self-cycle
        // through a plain class reference stays breakable; only by-value wrappers gate here.
        parser::ClassBody as cb2 => {
            var table = cg_type_table(prog)
            var fields = match checker::effective_class_fields(cb2, table) { []parser::Field as fs => fs; error => return true }
            var i = 0
            loop {
                if i >= fields.len { break }
                if !cg_texpr_ready(prog, em, set, fields[i].type_ann, owner_ns) { return false }
                i++
            }
            true
        }
        _ => true   // enum / alias / interface / trait — no by-value dependency
    }
}

// gather the named TYPE_DECL nodes (struct/variant/enum; alias emits nothing but is harmless).
fn cg_named_decls(prog: CgProg): []parser::TypeDecl {
    var named: []parser::TypeDecl = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { named = teko::list::push(named, d) }
            _ => { }
        }
        i++
    }
    named
}

/**
 * Emit every generated typedef (slices, optionals, inline variants, named decls) in by-value
 * dependency order, replacing the old program-order body emission + `cg_emit_optional_typedefs`.
 *
 * Slices lead (pointers), then a fixpoint emits the named/opt/inline-variant typedefs once each
 * dependency is satisfied. The collected `CgTypeSet` carries each type's mangled key so the
 * fixpoint READS the stored key instead of recomputing it per pass.
 *
 * @param buf   the output byte buffer to append to
 * @param prog  the checked program whose types are emitted
 * @return      the extended buffer
 * @throws      when a recursive value type has no slice/boxed-reference break (cyclic dependency)
 */
fn cg_emit_types_ordered(buf: []byte, prog: CgProg): []byte | error {
    // 1) collect every optional inner / slice element / inline variant used in the program.
    var set = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                set = cg_collect_type_opts(set, f.return_type)
                set = cg_collect_block_opts(set, f.body)
            }
            (@TStatement()) as st => { set = cg_collect_block_opts(set, teko::list::push(teko::list::empty(), st)) }
            _ => { }
        }
        i++
    }
    // (bugfix) SECOND pass over TypeDecls — register the generated typedefs a struct/variant/alias
    // FIELD's type annotation needs (tk_opt_/tk_slice_/tk_u_). Placed AFTER the function/statement
    // loop so the dedup makes it a STRICT NO-OP for the existing corpus (which already surfaces all
    // its field types via expressions) — this preserves byte-identity. Without it, a field whose
    // optional/slice/variant type appears ONLY in the declaration (never in any expression) loses
    // its typedef and `cc` fails with "unknown type name".
    var td = 0
    loop {
        if td >= prog.items.len { break }
        match prog.items[td] {
            parser::TypeDecl as d => { set = cg_register_decl_field_types(set, prog, d) }
            _ => { }
        }
        td++
    }
    var named = cg_named_decls(prog)

    var out = buf
    // 1a) ENUMS + FLAGS FIRST — full typedefs. An enum or flags carries NO by-value type dependency
    //     (members are plain int constants / uint constants), so they lead. Emitting before slice
    //     typedefs lets `[]<enum>`/`[]<flags>` element type (`tk_t_<T> *ptr`) resolve — a
    //     struct/variant gets a forward `typedef struct` instead, but a C enum can't be forward-
    //     declared as a struct, so we emit it complete here. Mark each emitted (em0) so the step-3
    //     fixpoint SKIPS it (no duplicate typedef) and any struct embedding an enum/flags is ready.
    //     (C8.4) flags typedef is a `typedef <uint_type> tk_t_<Name>` — same no-dependency
    //     property as enum, so it joins this pass.
    var em0 = CgEmitted { names = teko::list::empty(); opt_keys = teko::list::empty(); uvar_keys = teko::list::empty() }
    var enum_count: u64 = 0
    var ei = 0
    loop {
        if ei >= named.len { break }
        var is_enum_or_flags = match named[ei].body {
            parser::EnumBody => true
            parser::FlagsBody => true
            _ => false
        }
        if is_enum_or_flags {
            out = match emit_type_decl(out, prog, named[ei]) { []byte as o => o; error as err => return err }
            em0 = CgEmitted { names = teko::list::push(em0.names, named[ei].name); opt_keys = em0.opt_keys; uvar_keys = em0.uvar_keys }
            enum_count = enum_count + 1
        }
        ei++
    }
    if enum_count > 0 { out = cb(out, "\n") }
    var fv = 0
    loop {
        if fv >= set.variants.len { break }
        match set.variants[fv] {
            checker::Variant as va => {
                out = cb(out, "typedef struct ")
                out = match cg_variant_typename(out, va) { []byte as o => o; error as err => return err }
                out = cb(out, " ")
                out = match cg_variant_typename(out, va) { []byte as o => o; error as err => return err }
                out = cb(out, ";\n")
            }
            _ => { }
        }
        fv++
    }
    if set.variants.len > 0 { out = cb(out, "\n") }

    // 2) SLICE typedefs first (pointer-only; their named elements already have forward typedefs).
    // tk_slice_char is pre-declared in teko_rt.h (the `chars` builtin return type) — skip it to
    // avoid a duplicate-typedef compile error in generated programs that use chars().
    var k = 0
    loop {
        if k >= set.slices.len { break }
        match set.slices[k] { Char => { k++; continue }; _ => { } }   // pre-declared in teko_rt.h as tk_slice_char
        match set.slices[k] { Byte => { k++; continue }; _ => { } }   // tk_slice_byte pre-declared in teko_rt.h
        out = cb(out, "typedef struct { ")
        out = match emit_type(out, prog, set.slices[k]) { []byte as o => o; error as err => return err }
        out = cb(out, " *ptr; uint64_t len; uint64_t cap; } ")
        out = match cg_slice_typename(out, set.slices[k]) { []byte as o => o; error as err => return err }
        out = cb(out, ";\n")
        k++
    }
    if set.slices.len > 0 { out = cb(out, "\n") }

    // 3) fixpoint: emit named bodies + optionals + inline variants in by-value dependency order.
    //    Enums and flags were ALREADY emitted in step 1a (tracked in em0), so seed `em` with them
    //    and exclude them from `remaining` — the fixpoint then skips them (cg_named_emitted is true)
    //    and any struct embedding an enum/flags is immediately ready.
    var em = em0
    var remaining = named.len + set.variants.len - enum_count
    var progress = true
    loop {
        if remaining == 0 { break }
        if !progress { break }
        progress = false
        // named decls
        var ni = 0
        loop {
            if ni >= named.len { break }
            var d = named[ni]
            // (#109 W3) SELF-check uses EXACT canonical membership (not last-segment): `d.name` and
            // `em.names` are both canonical "ns::Name", so two same-last-segment types across
            // namespaces (`io::Reader` vs `emit::Reader`) are DISTINCT nodes — else emitting one marks
            // the other "already emitted" (last-segment collision), it is never emitted, `remaining`
            // never reaches 0, and the fixpoint falsely reports a cyclic value-type dependency.
            if cg_str_in(em.names, d.name) { ni++ } else {
                if !cg_named_ready(prog, em, set, d) { ni++ } else {
                    out = match emit_type_decl(out, prog, d) { []byte as o => o; error as err => return err }
                    em = CgEmitted { names = teko::list::push(em.names, d.name); opt_keys = em.opt_keys; uvar_keys = em.uvar_keys }
                    remaining = remaining - 1
                    progress = true
                    ni++
                }
            }
        }
        // inline variants
        var vi = 0
        loop {
            if vi >= set.variants.len { break }
            var vt = set.variants[vi]
            var vkey = set.variant_keys[vi]
            if cg_str_in(em.uvar_keys, vkey) { vi++ } else {
                // a tk_u_ embeds its members by value — all must be ready.
                var ready = true
                match vt {
                    checker::Variant as va => {
                        var m = 0
                        loop {
                            if m >= va.members.len { break }
                            if !cg_type_ready(prog, em, set, va.members[m]) { ready = false; break }
                            m++
                        }
                    }
                    _ => { }
                }
                if !ready { vi++ } else {
                    match vt {
                        checker::Variant as va => { out = match cg_emit_inline_variant_typedef(out, prog, va) { []byte as o => o; error as err => return err } }
                        _ => { }
                    }
                    em = CgEmitted { names = em.names; opt_keys = em.opt_keys; uvar_keys = teko::list::push(em.uvar_keys, vkey) }
                    remaining = remaining - 1
                    progress = true
                    vi++
                }
            }
        }
    }
    if remaining > 0 { return error { message = "codegen: cyclic value-type dependency (a recursive type must pass through a slice or a boxed reference)" } }
    out
}

// ---------------------------------------------------------------------------
// The program -> a full C translation unit. Passes:
//   0. (W4c) every TYPE DECL -> a C type declaration, BEFORE the functions (forward
//      order): first a forward `typedef struct tk_t_<M> tk_t_<M>;` for each struct/variant
//      (so recursive/out-of-order aggregate references compile), then the full decls.
//   1. every top-level TFunction -> a C function (use-decls no-op; type-decls done above).
//   2. the loose top-level statements (the VIRTUAL-MAIN) -> int main(void){ … return 0; }.
// The C's `cg_err` (build a tk_cstr_result error) folds away: here the function simply
// `return error { … }`, since `str | error` IS the C's TK_RESULT. (C: `tk_emit_c` + `cg_err`.)
// ---------------------------------------------------------------------------
// fmt_indent — append `depth` levels of 4-space indent.
fn fmt_indent(buf: []byte, depth: u64): []byte {
    var b = buf
    var k: u64 = 0
    loop {
        if k >= depth { break }
        b = cb(b, "    ")
        k = k + 1
    }
    b
}

// cg_format_c — re-flow the generated C into readable, brace-indented form (mirror of codegen.c's
// cg_format_c). It is STRUCTURAL: STRING/CHAR literals, `//` line comments and `#` preprocessor
// lines are copied verbatim; a `;` inside `(…)` (a `for` header) does NOT break; whitespace runs
// collapse to one space; a top-level function body close gets a blank line. The bracket stack is a
// str whose chars encode each open bracket — 'B'/'b' = block/non-block brace, '(' / '[' = paren/
// bracket — pushed via concat, popped via slice_to (no in-place mutation needed). The result is
// recompiled by cc on every build, so any corruption fails loudly.
fn cg_format_c(src: str): []byte {
    var out: []byte = teko::list::empty()
    var depth: u64 = 0
    var stk = ""
    var line_start = true
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        var c = src[i]
        if c == b'#' && line_start {
            loop {
                if i >= src.len { break }
                if src[i] == b'\n' { break }
                out = cb_byte(out, src[i])
                i = i + 1
            }
            out = cb(out, "\n")
            if i < src.len { i = i + 1 }
            line_start = true
        } else if c == b'/' && i + 1 < src.len && src[i + 1] == b'/' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            loop {
                if i >= src.len { break }
                if src[i] == b'\n' { break }
                out = cb_byte(out, src[i])
                i = i + 1
            }
            out = cb(out, "\n")
            if i < src.len { i = i + 1 }
            line_start = true
        } else if c == b'"' || c == b'\'' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            var q = c
            out = cb_byte(out, c)
            i = i + 1
            loop {
                if i >= src.len { break }
                if src[i] == q { break }
                if src[i] == b'\\' && i + 1 < src.len {
                    out = cb_byte(out, src[i])
                    out = cb_byte(out, src[i + 1])
                    i = i + 2
                } else {
                    out = cb_byte(out, src[i])
                    i = i + 1
                }
            }
            if i < src.len && src[i] == q {
                out = cb_byte(out, q)
                i = i + 1
            }
        } else if c == b' ' || c == b'\t' || c == b'\n' || c == b'\r' {
            loop {
                if i >= src.len { break }
                var w = src[i]
                if w != b' ' && w != b'\t' && w != b'\n' && w != b'\r' { break }
                i = i + 1
            }
            // suppress the collapsed space before a `{`/`}` (the brace handler spaces it) and before
            // a `;` (so a label `done:` → `done:;`, matching the C twin's trim — no `x ;`).
            var suppress = i < src.len && (src[i] == b'}' || src[i] == b'{' || src[i] == b';')
            if !line_start && !suppress && out.len > 0 && out[out.len - 1] != b' ' { out = cb(out, " ") }
        } else if c == b'{' {
            var is_block = out.len > 0 && out[out.len - 1] == b')'
            if line_start { out = fmt_indent(out, depth) } else { out = cb(out, " ") }
            out = cb(out, "{\n")
            stk = teko::str::concat(stk, if is_block { "B" } else { "b" })
            depth = depth + 1
            line_start = true
            i = i + 1
        } else if c == b'}' {
            var was_block = stk.len > 0 && stk[stk.len - 1] == b'B'
            if depth > 0 { depth = depth - 1 }
            if stk.len > 0 { stk = teko::str::slice_to(stk, stk.len - 1) }
            if !line_start { out = cb(out, "\n") }
            out = fmt_indent(out, depth)
            out = cb(out, "}")
            if depth == 0 && was_block { out = cb(out, "\n\n"); line_start = true }
            else { line_start = false }
            i = i + 1
        } else if c == b';' {
            out = cb(out, ";")
            // break after `;` at top level (empty stack — a declaration) OR inside a `{` block;
            // NOT inside `(…)` (a `for` header). Mirrors codegen.c's `sp == 0 || top == '{'`.
            var brace_top = stk.len == 0 || stk[stk.len - 1] == b'B' || stk[stk.len - 1] == b'b'
            if brace_top { out = cb(out, "\n"); line_start = true }
            else {
                if out.len > 0 && out[out.len - 1] != b' ' { out = cb(out, " ") }
                line_start = false
            }
            i = i + 1
        } else if c == b'(' || c == b'[' {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            stk = teko::str::concat(stk, if c == b'(' { "(" } else { "[" })
            out = cb_byte(out, c)
            i = i + 1
        } else if c == b')' || c == b']' {
            if stk.len > 0 { stk = teko::str::slice_to(stk, stk.len - 1) }
            out = cb_byte(out, c)
            i = i + 1
        } else {
            if line_start { out = fmt_indent(out, depth); line_start = false }
            out = cb_byte(out, c)
            i = i + 1
        }
    }
    cb(out, "\n")
}

// (W10) LAMBDA LIFTING — walk the program, STAMP each closure literal with a unique `lift_id`, and
// SYNTHESIZE a top-level function `__tkclo_<id>` for each NON-capturing lambda (its params/body are
// a plain function — emitted by the normal fn-emission, called via the W10a closure cast). Capturing
// lambdas are stamped here too; their env-struct + env-first lifted fn are emitted by the capture
// path (cg_emit_lambda_decls). The accumulator threads the id counter + the synthesized functions.
type StampAcc = struct { next: u64; fns: []checker::TFunction; lams: []checker::TLambda }
type LiftResult = struct { prog: checker::TProgram; lams: []checker::TLambda }

fn cg_lift_lambdas(prog: CgProg): LiftResult {
    var acc = StampAcc { next = 0; fns = teko::list::empty(); lams = teko::list::empty() }
    var items: []@TItem() = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                var nb = cg_lift_block(f.body, acc)
                items = teko::list::push(items, checker::TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = nb; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = f.ret_extra })
            }
            (@TStatement()) as ts => {
                var ns = cg_lift_stmt(ts, acc)
                items = teko::list::push(items, ns)
            }
            _ => items = teko::list::push(items, prog.items[i])
        }
        i++
    }
    // append the synthesized lifted functions (non-capturing → a plain top-level fn).
    var j = 0
    loop { if j >= acc.fns.len { break }; items = teko::list::push(items, acc.fns[j]); j++ }
    LiftResult { prog = checker::TProgram { items = items }; lams = acc.lams }
}
/**
 * Rebuilds a statement block with every nested closure literal stamped (`cg_lift_stmt` per
 * statement), threading the lift accumulator `acc` (0.3.1 — a `ref` param; forwarded bare to
 * every recursive call, it is already a reference, no re-borrow). `out` is a linear chain: born
 * empty, self-append-only, read only after the loop — so every copy-grow frees the superseded
 * buffer (#148 R3 DECREE; `mem::push_fo`, paranoid-gated).
 *
 * @param stmts  the statement block to rebuild
 * @param acc    the lift-id counter + synthesized-fn/capturing-lambda accumulator (by-reference)
 * @return       the block with every lambda literal stamped
 */
fn cg_lift_block(stmts: []@TStatement(), ref acc: StampAcc): []@TStatement() {
    var out: []@TStatement() = teko::list::empty()
    var i = 0
    loop { if i >= stmts.len { break }; out = teko::mem::push_fo(out, cg_lift_stmt(stmts[i], acc)); i++ }
    out
}
/**
 * Rebuilds one statement, recursing into every sub-expression via `cg_lift_expr` so a nested
 * closure literal is stamped wherever it appears (a binding/assign RHS, a return value, a loop
 * body, …).
 *
 * @param s    the statement to rebuild
 * @param acc  the lift-id counter + synthesized-fn/capturing-lambda accumulator (by-reference)
 * @return     the statement with every lambda literal stamped
 */
fn cg_lift_stmt(s: @TStatement(), ref acc: StampAcc): @TStatement() {
    match s {
        checker::TBinding as b => checker::TBinding { kind = b.kind; target = b.target; bound = b.bound; value = cg_lift_expr(b.value, acc) }
        checker::TAssign as a => checker::TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = cg_lift_expr(a.value, acc); deref = a.deref; target = if parser::assign_has_target(a.kind) { cg_lift_expr(a.target, acc) } else { a.target } }
        checker::TReturn as r => checker::TReturn { has_value = r.has_value; value = if r.has_value { cg_lift_expr(r.value, acc) } else { r.value }; values = teko::list::empty() }
        checker::TLoopStmt as l => checker::TLoopStmt { label = l.label; init = cg_lift_block(l.init, acc); body = cg_lift_block(l.body, acc) }
        checker::TExprStmt as es => checker::TExprStmt { expr = cg_lift_expr(es.expr, acc) }
        checker::TDeferStmt as d => checker::TDeferStmt { body = cg_lift_block(d.body, acc) }
        checker::TAdoptStmt as a => checker::TAdoptStmt { name = a.name; body = cg_lift_block(a.body, acc) }
        checker::TBlockStmt as b => checker::TBlockStmt { body = cg_lift_block(b.body, acc) }
        checker::TBreakStmt => s
        checker::TContinueStmt => s
        checker::TSpawn as sp => checker::TSpawn { call = cg_lift_expr(sp.call, acc) }
    }
}
/**
 * Rebuilds one expression, recursing into every sub-expression, and STAMPS every closure literal
 * it finds with a unique `lift_id` (issue #107 fix — a real lift_id counter bug this exposed):
 * a `TLambda` reserves ITS OWN id BEFORE recursing into its body, so a nested lambda literal
 * inside it stamps with HIGHER ids (outer-first numbering, stable regardless of nesting). The
 * recursive `cg_lift_block` call may advance `acc.next` further (once per nested lambda it
 * finds) — the counter used AFTER the recursion is read FRESH from `acc.next` (whatever the
 * nested walk left it at), never reset to `id + 1`: that would REUSE ids already handed out to
 * nested lambdas, producing two lifted C functions both named `__tkclo_<id>` (a
 * duplicate-definition compile error) the moment a lambda literal contains another lambda
 * literal. A non-capturing lambda is synthesized as a plain top-level fn; a capturing one is
 * recorded in `acc.lams` for the env-struct + env-first lifted-fn emission path.
 *
 * @param e    the expression to rebuild
 * @param acc  the lift-id counter + synthesized-fn/capturing-lambda accumulator (by-reference)
 * @return     the expression with every lambda literal stamped
 */
fn cg_lift_expr(e: checker::TExpr, ref acc: StampAcc): checker::TExpr {
    match e.kind {
        checker::TLambda as lam => {
            var id = acc.next
            acc = StampAcc { next = id + 1; fns = acc.fns; lams = acc.lams }
            var nbody = cg_lift_block(lam.body, acc)   // stamp nested lambdas first (ids > id)
            // synthesize a plain top-level fn for a NON-capturing lambda; capturing → emitted by the
            // capture path (recorded in `lams`).
            var newfns = acc.fns
            var newlams = acc.lams
            var stamped = checker::TLambda { params = lam.params; body = nbody; captures = lam.captures; ret = lam.ret; lift_id = id }
            if lam.captures.len == 0 {
                var ps: []parser::Param = teko::list::empty()
                var pi = 0
                loop { if pi >= lam.params.len { break }; ps = teko::list::push(ps, parser::Param { name = lam.params[pi].name; has_type = true; type_ann = checker::type_to_texpr(lam.params[pi].type); is_params = false; has_default = false; default_expr = parser::no_expr() }); pi++ }
                newfns = teko::list::push(newfns, checker::TFunction { overload_suffix = ""; name = lam_fn_name(id); type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = ps; return_type = lam.ret; body = nbody; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty() })
            } else {
                newlams = teko::list::push(newlams, stamped)
            }
            // preserve whatever `next` the nested recursion advanced to (never regress it).
            acc = StampAcc { next = acc.next; fns = newfns; lams = newlams }
            checker::TExpr { kind = stamped; type = e.type; line = e.line; col = e.col }
        }
        checker::TBinary as b => checker::TExpr { kind = checker::TBinary { op = b.op; left = cg_lift_expr(b.left, acc); right = cg_lift_expr(b.right, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TUnary as u => checker::TExpr { kind = checker::TUnary { op = u.op; operand = cg_lift_expr(u.operand, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TCompare as c => {
            var terms: []checker::TCmpTerm = teko::list::empty()
            var i = 0
            loop { if i >= c.rest.len { break }; terms = teko::list::push(terms, checker::TCmpTerm { op = c.rest[i].op; operand = cg_lift_expr(c.rest[i].operand, acc) }); i++ }
            checker::TExpr { kind = checker::TCompare { first = cg_lift_expr(c.first, acc); rest = terms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCall as cl => {
            var args: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= cl.args.len { break }; args = teko::list::push(args, cg_lift_expr(cl.args[i], acc)); i++ }
            checker::TExpr { kind = checker::TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIfExpr as f => checker::TExpr { kind = checker::TIfExpr { cond = cg_lift_expr(f.cond, acc); then_blk = cg_lift_block(f.then_blk, acc); has_else = f.has_else; else_blk = cg_lift_block(f.else_blk, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TMatchExpr as m => {
            var arms: []checker::TArm = teko::list::empty()
            var i = 0
            loop { if i >= m.arms.len { break }; var a = m.arms[i]; arms = teko::list::push(arms, checker::TArm { pattern = a.pattern; has_when = a.has_when; guard = if a.has_when { cg_lift_expr(a.guard, acc) } else { a.guard }; body = cg_lift_block(a.body, acc) }); i++ }
            checker::TExpr { kind = checker::TMatchExpr { subject = cg_lift_expr(m.subject, acc); arms = arms }; type = e.type; line = e.line; col = e.col }
        }
        checker::TCast as ct => checker::TExpr { kind = checker::TCast { expr = cg_lift_expr(ct.expr, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TFieldAccess as fa => checker::TExpr { kind = checker::TFieldAccess { receiver = cg_lift_expr(fa.receiver, acc); field = fa.field }; type = e.type; line = e.line; col = e.col }
        checker::TStructInit as si => {
            var vals: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= si.field_vals.len { break }; vals = teko::list::push(vals, cg_lift_expr(si.field_vals[i], acc)); i++ }
            checker::TExpr { kind = checker::TStructInit { field_names = si.field_names; field_vals = vals }; type = e.type; line = e.line; col = e.col }
        }
        checker::TIndex as ix => checker::TExpr { kind = checker::TIndex { receiver = cg_lift_expr(ix.receiver, acc); index = cg_lift_expr(ix.index, acc) }; type = e.type; line = e.line; col = e.col }
        checker::TInterp as in => {
            var holes: []checker::TExpr = teko::list::empty()
            var specs: []checker::TFSpec = teko::list::empty()
            var i = 0
            loop {
                if i >= in.holes.len { break }
                holes = teko::list::push(holes, cg_lift_expr(in.holes[i], acc))
                if i < in.specs.len {
                    var sp = in.specs[i]
                    var lifted_sp = match sp.kind {
                        checker::TFSpecDynamic as fd => {
                            var args: []checker::TExpr = teko::list::empty()
                            var k = 0
                            loop { if k >= fd.args.len { break }; args = teko::list::push(args, cg_lift_expr(fd.args[k], acc)); k++ }
                            checker::TFSpec { kind = checker::TFSpecDynamic { args = args } }
                        }
                        _ => sp
                    }
                    specs = teko::list::push(specs, lifted_sp)
                }
                i++
            }
            checker::TExpr { kind = checker::TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = e.type; line = e.line; col = e.col }
        }
        checker::TInExpr as ie => {
            var elems: []checker::TExpr = teko::list::empty()
            var i = 0
            loop { if i >= ie.elems.len { break }; elems = teko::list::push(elems, cg_lift_expr(ie.elems[i], acc)); i++ }
            checker::TExpr { kind = checker::TInExpr { lhs = cg_lift_expr(ie.lhs, acc); elems = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TArrayLit as a => {
            var elems: []checker::TArrayElem = teko::list::empty()
            var i = 0
            loop { if i >= a.elements.len { break }; elems = teko::list::push(elems, checker::TArrayElem { is_spread = a.elements[i].is_spread; expr = cg_lift_expr(a.elements[i].expr, acc) }); i++ }
            checker::TExpr { kind = checker::TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
        }
        checker::TBlockExpr as blk => checker::TExpr { kind = checker::TBlockExpr { body = cg_lift_block(blk.body, acc) }; type = e.type; line = e.line; col = e.col }
        _ => e   // leaves (TNumber/TVar/TStrLit/TByteLit/TBoolLit/TNullLit/TPathExpr) — no nested lambdas
    }
}

// (W10) emit the env struct + lifted function for each CAPTURING lambda. The env struct holds one
// field per capture (by-copy value, or the `T*` Ref for a by_ref capture). The lifted fn unpacks the
// env into locals of the SAME names (so the body references captures with no rewrite) then runs the
// body. ABI = env-first `R(void *envp, params)`. `protos_only` emits just the env typedefs + fn
// forward declarations (prelude); else the full definitions.
fn cg_emit_lambda_decls(buf: []byte, prog: CgProg, lams: []checker::TLambda, protos_only: bool): []byte | error {
    var out = buf
    var li = 0
    loop {
        if li >= lams.len { break }
        var lam = lams[li]
        var ids = teko::u64_to_str(lam.lift_id)
        // env struct typedef — emitted ONCE, in the protos pass only (re-emitting it in the defs pass
        // is a typedef redefinition error).
        if protos_only {
            out = cb(out, "typedef struct { ")
            var ci = 0
            loop {
                if ci >= lam.captures.len { break }
                out = match emit_type(out, prog, lam.captures[ci].type) { []byte as o => o; error as e => return e }
                out = cb(out, " ")
                out = cb_ident(out, lam.captures[ci].name)
                out = cb(out, "; ")
                ci++
            }
            out = cb(out, teko::str::concat("} __tkenv_", ids, ";\n"))
        }
        out = match emit_type(out, prog, lam.ret) { []byte as o => o; error as e => return e }
        out = cb(out, " ")
        out = cb_fn_name(out, "", lam_fn_name(lam.lift_id))
        out = cb(out, "(void *envp")
        var pi = 0
        loop {
            if pi >= lam.params.len { break }
            out = cb(out, ", ")
            out = match emit_type(out, prog, lam.params[pi].type) { []byte as o => o; error as e => return e }
            out = cb(out, " ")
            out = cb_ident(out, lam.params[pi].name)
            pi++
        }
        out = cb(out, ")")
        if protos_only {
            out = cb(out, ";\n")
        } else {
            out = cb(out, " {\n")
            out = cb(out, teko::str::concat("    __tkenv_", ids, " *_e = envp;\n"))
            var ui = 0
            loop {
                if ui >= lam.captures.len { break }
                out = cb(out, "    ")
                out = match emit_type(out, prog, lam.captures[ui].type) { []byte as o => o; error as e => return e }
                out = cb(out, " ")
                out = cb_ident(out, lam.captures[ui].name)
                out = cb(out, " = _e->")
                out = cb_ident(out, lam.captures[ui].name)
                out = cb(out, ";\n")
                ui++
            }
            // the body (reuse emit_block_tail; lifted fns route allocations to root — no frame region).
            out = match emit_block_tail(out, lam.body, false, prog, lam.ret, "    ", "", teko::list::empty(), lam.body, dctx_empty()) { []byte as o => o; error as e => return e }
            out = cb(out, "}\n")
        }
        li++
    }
    out
}

/**
 * Emit the C symbol name of a vtable dispatch THUNK for one vtable slot, identified by the vtable-
 * owning class, the contract/base it conforms to, and the method: `tk_vtthunk_<Class>__<Contract>__
 * <method>` (each `::` mangled to `__`). Keying on the (class, contract) PAIR — not just the
 * resolved method — is required: a base method inherited unchanged by a subclass reconstructs a
 * DIFFERENT self-receiver vtable (`tk_vt_<Class>_<Base>`) per owning class, so those thunks must be
 * distinct C functions. Both the vtable slot (which takes the thunk's address) and the thunk
 * definition spell the name through this one function, so they always agree.
 *
 * @param buf       the output byte buffer to append to
 * @param cd_name   the vtable-owning class's canonical name
 * @param idd_name  the contract/base's canonical name (the vtable's second key)
 * @param method    the method's bare name
 * @return          the buffer with the thunk symbol name appended
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cb_vtthunk_name(buf: []byte, cd_name: str, idd_name: str, method: str): []byte {
    cb_ident(cb(cb_tysym(cb(cb_tysym(cb(buf, "tk_vtthunk_"), cd_name), "__"), idd_name), "__"), method)
}

/**
 * Emit ONE vtable dispatch thunk DEFINITION: a well-typed wrapper whose genuine C signature is
 * `R tk_vtthunk_<Class>__<Contract>__<method>(void *self, params…)`, whose body forwards to the
 * concrete monomorphized method after RECONSTRUCTING the method's real receiver from the raw
 * object pointer `self`. Storing this thunk's address in a vtable slot makes the dynamic dispatch's
 * `R (*)(void *, params…)` cast CORRECT BY CONSTRUCTION — the thunk truly has that signature — so
 * the C23 6.3.2.3p8 undefined behavior of calling the concrete method through a `void *`-first
 * pointer type never occurs (it is `-fsanitize=function`/CFI/LTO clean).
 *
 * The receiver reconstruction is TYPE-DIRECTED, because a monomorphized method takes one of two
 * receiver ABIs:
 *   - a LEAF/own class method takes a raw pointer `tk_t_<Class> *` — the thunk casts `(tk_t_<C> *)self`;
 *   - a POLYMORPHIC-BASE method takes the base fat pointer `tk_base_<Base>` (a `{data, vtable}`
 *     struct by value) — the thunk rebuilds it as `(tk_base_<B>){ .data = self, .vtable =
 *     tk_vt_<Class>_<B> }`, restoring the object's own (class, base) self-dispatch vtable (the old
 *     direct call passed only the data word, dropping the vtable — a latent self-dispatch bug this
 *     thunk additionally repairs).
 *
 * The caller DEDUPS by the `cb_vtthunk_name` symbol (a base method inherited across subclasses
 * yields distinct thunks; identical (class, contract) slots reuse one): guard with `cg_str_in`.
 *
 * @param buf       the output byte buffer to append to
 * @param prog      the whole typed program (resolves the concrete method's real signature)
 * @param cd_name   the vtable-owning class's canonical name (rides the thunk symbol + self vtable)
 * @param idd_name  the contract/base's canonical name (rides the thunk symbol)
 * @param mns       the concrete method's mangled namespace (from `cg_find_method_ns`)
 * @param method    the method's bare name
 * @return          the buffer with the thunk definition appended
 * @throws          when the concrete method cannot be found (an internal codegen inconsistency)
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtthunk_def(buf: []byte, prog: CgProg, cd_name: str, idd_name: str, mns: str, method: str): []byte | error {
    var f = match cg_find_function(prog, mns, method) { checker::TFunction as tf => tf; error => return error { message = "codegen: vtable thunk cannot resolve its concrete method (internal)" } }
    if f.params.len == 0 { return error { message = "codegen: vtable thunk method has no receiver parameter (internal)" } }
    var out = match emit_type(buf, prog, f.return_type) { []byte as o => o; error as err => return err }
    out = cb_vtthunk_name(cb(out, " "), cd_name, idd_name, method)
    out = cb(out, "(void *self")
    var pi: u64 = 1
    loop {
        if pi >= f.params.len { break }
        out = cb(out, ", ")
        out = match emit_type_expr(out, prog, f.params[pi].type_ann, f.namespace) { []byte as o => o; error as err => return err }
        out = cb(out, " ")
        out = cb_ident(out, f.params[pi].name)
        pi++
    }
    var returns_void = match f.return_type { checker::Void => true; _ => false }
    out = cb(out, ") { ")
    out = cb(out, if returns_void { "" } else { "return " })
    out = cb_fn_name(out, mns, method)
    out = cb(out, "(")
    out = match cg_emit_vtthunk_receiver(out, prog, cd_name, f.params[0].type_ann, f.namespace) { []byte as o => o; error as err => return err }
    var ai: u64 = 1
    loop {
        if ai >= f.params.len { break }
        out = cb(out, ", ")
        out = cb_ident(out, f.params[ai].name)
        ai++
    }
    cb(out, "); }\n")
}

/**
 * Emit the reconstructed receiver EXPRESSION that a dispatch thunk forwards to the concrete method,
 * from the thunk's raw `void *self`. The shape follows the method's declared receiver C type:
 *   - a polymorphic-base receiver (`tk_base_<B>`, a `{data, vtable}` fat pointer by value) becomes
 *     `(tk_base_<B>){ .data = self, .vtable = tk_vt_<cd>_<B> }` — the object's own (class, base)
 *     self-dispatch vtable is restored;
 *   - any other receiver is a raw class pointer, cast directly as `(<recv-C-type>)self`.
 *
 * @param buf         the output byte buffer to append to
 * @param prog        the whole typed program (resolves the receiver's polymorphic-base status + C type)
 * @param cd_name     the vtable-owning class (names the self-dispatch vtable for a base receiver)
 * @param recv_ann    the concrete method's receiver parameter type annotation (`params[0].type_ann`)
 * @param recv_ns     the method's declaring namespace (ref_ns for `emit_type_expr`)
 * @return            the buffer with the receiver expression appended
 * @throws            when the receiver's C type cannot be emitted (an internal inconsistency)
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtthunk_receiver(buf: []byte, prog: CgProg, cd_name: str, recv_ann: @TypeExpr(), recv_ns: str): []byte | error {
    var thunk_base = cg_vtthunk_base_name(recv_ann)
    if thunk_base.len > 0 && cg_is_polymorphic_base(prog, thunk_base) {
        var out = cb_tysym(cb(buf, "(tk_base_"), thunk_base)
        out = cb(out, "){ .data = self, .vtable = ")
        out = cb_tysym(cb(cb_tysym(cb(out, "tk_vt_"), cd_name), "_"), thunk_base)
        return cb(out, " }")
    }
    var out = cb(buf, "(")
    out = match emit_type_expr(out, prog, recv_ann, recv_ns) { []byte as o => o; error as err => return err }
    cb(out, ")self")
}

/**
 * The bare NAMED type name of a receiver annotation, or the empty string when the annotation is not
 * a plain named type. Used to test a thunk receiver for polymorphic-base status without resolving
 * the whole type (the receiver of a method is always a `NamedType` — the class/base it belongs to).
 *
 * @param recv_ann  the receiver parameter's type annotation
 * @return          the annotation's last path segment name, or "" if it is not a `NamedType`
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_vtthunk_base_name(recv_ann: @TypeExpr()): str {
    match recv_ann {
        parser::NamedType as nt => nt.path.segments[nt.path.segments.len - 1].name
        _ => ""
    }
}

/**
 * Is `m` (a raw parser method) an INSTANCE method — one whose first parameter is the implicit
 * untyped receiver (OOP A1: a class method is static when its first parameter is typed, or it has
 * none)? Only instance methods are the target of a DYNAMIC vtable dispatch, so only they get a
 * typed dispatch thunk; a STATIC factory that happens to occupy a base-vtable slot (never invoked
 * through the `void *`-first cast) keeps a direct `&method` address and needs no thunk.
 *
 * @param m  the effective method as returned by `iface_methods_by_name`/`base_vtable_methods`
 * @return   true when `m` has an implicit untyped receiver (an instance method)
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_method_is_instance(m: parser::Function): bool {
    m.params.len > 0 && !m.params[0].has_type
}

/**
 * Emit ONE vtable slot's code-pointer initializer text: `(void *)&<thunk>` for an INSTANCE method
 * (the typed dispatch thunk) or `(void *)&<method>` for a STATIC one (a dead slot never taken
 * through the dynamic-dispatch cast, so the direct address is UB-free). Shared by the interface and
 * polymorphic-base vtable definition passes so both spell a slot identically.
 *
 * @param buf       the output byte buffer to append to
 * @param prog      the whole typed program (resolves the method's mangled namespace)
 * @param cd_name   the vtable-owning class's canonical name
 * @param idd_name  the contract/base's canonical name
 * @param m         the effective method for this slot
 * @return          the buffer with the slot initializer appended
 * @throws          when the method's stamped function cannot be resolved (an internal inconsistency)
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtable_slot(buf: []byte, prog: CgProg, cd_name: str, idd_name: str, m: parser::Function): []byte | error {
    if cg_method_is_instance(m) {
        return cb_vtthunk_name(cb(buf, "(void *)&"), cd_name, idd_name, m.name)
    }
    var mns = match cg_find_method_ns(prog, cd_name, m.name) {
        str as ns2 => ns2
        null => return error { message = "codegen: conforming class is missing a vtable method's stamped function (internal)" }
    }
    cb_fn_name(cb(buf, "(void *)&"), mns, m.name)
}

/**
 * Does class decl `cd` provide a per-(class, contract) INTERFACE/TRAIT vtable for type decl `idd`?
 * True when `idd` is an interface or trait AND `cd` nominally conforms to it. Factored so the three
 * vtable-emission phases (forward-decl, thunk, definition) apply the SAME gate.
 *
 * @param cd        the candidate vtable-owning class decl
 * @param idd       the candidate contract decl
 * @param vt_table  the checker's type table (conformance oracle)
 * @return          true when a `tk_vt_<cd>_<idd>` interface vtable must be emitted
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_pair_is_iface_vtable(cd: parser::TypeDecl, idd: parser::TypeDecl, vt_table: checker::TypeTable): bool {
    var idd_is_iface = match idd.body { parser::InterfaceBody => true; _ => false }
    idd_is_iface && checker::type_conforms_to(cd.name, idd.name, vt_table)
}

/**
 * Is type decl `cd` an `abstract class` — inheritable but NOT directly instantiable (its abstract
 * methods carry no body, so they are stamped to no `TFunction`)? An abstract class therefore has no
 * emittable self-vtable: every slot is a not-yet-implemented abstract method (`cg_pair_is_base_vtable`
 * excludes its self-pair for exactly this reason). A `virtual`/`Sealed` class answers false.
 *
 * @param cd  the candidate class decl
 * @return    true iff `cd` is a `ClassKind::Abstract` class
 * @since #594 (member-const cross-ns abstract-base codegen fix)
 */
fn cg_class_is_abstract(cd: parser::TypeDecl): bool {
    match cd.body {
        parser::ClassBody as cb => match cb.kind { parser::ClassKind::Abstract => true; _ => false }
        _ => false
    }
}

/**
 * Does class decl `cd` provide a per-(class, base) POLYMORPHIC-BASE vtable for type decl `idd`?
 * True when `idd` is a polymorphic (non-sealed) base class AND either `cd` STRICTLY subclasses `idd`,
 * or `cd` IS `idd` AND `idd` is directly instantiable (a `virtual` base's own self-vtable). An
 * `abstract` base's self-pair is EXCLUDED: it is never instantiated, and its abstract-method slots
 * resolve to no stamped function — emitting it would fail codegen with a phantom "missing vtable
 * method's stamped function" (the concrete subclass's `tk_vt_<Sub>_<Base>` carries the real slots).
 * Factored so the three vtable-emission phases apply the SAME gate.
 *
 * @param prog  the whole typed program (polymorphic-base + subclass-reachability oracles)
 * @param cd    the candidate vtable-owning class decl
 * @param idd   the candidate base decl
 * @return      true when a `tk_vt_<cd>_<idd>` base vtable must be emitted
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_pair_is_base_vtable(prog: CgProg, cd: parser::TypeDecl, idd: parser::TypeDecl): bool {
    var idd_is_poly_base = cg_is_polymorphic_base(prog, idd.name)
    var cd_is_instantiable_self = cd.name == idd.name && !cg_class_is_abstract(cd)
    var cd_is_a = cd_is_instantiable_self || cg_subclass_reaches(prog, cd.name, idd.name, SUBCLASS_CHAIN_DEPTH_LIMIT)
    idd_is_poly_base && cd_is_a
}

/**
 * Emit a `static void *const tk_vt_<cd>_<idd>[]` DEFINITION whose slots are `method_list` in order:
 * an instance-method slot takes its typed dispatch thunk's address, a static-method slot the method
 * directly (`cg_emit_vtable_slot`); a methodless contract still gets one never-indexed `(void *)0`
 * slot. Shared by the interface and base vtable definition passes.
 *
 * @param buf          the output byte buffer to append to
 * @param prog         the whole typed program (resolves each slot's stamped function)
 * @param cd_name      the vtable-owning class's canonical name
 * @param idd_name     the contract/base's canonical name
 * @param method_list  the vtable's effective methods, in slot order
 * @return             the buffer with the vtable definition appended
 * @throws             propagated from `cg_emit_vtable_slot` on an internal inconsistency
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtable_def(buf: []byte, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function): []byte | error {
    var b = cb_tysym(cb(cb_tysym(cb(buf, "static void *const tk_vt_"), cd_name), "_"), idd_name)
    b = cb(b, "[] = {")
    if method_list.len == 0 { b = cb(b, " (void *)0") }
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        b = cb(b, if i == 0 { " " } else { ", " })
        b = match cg_emit_vtable_slot(b, prog, cd_name, idd_name, method_list[i]) { []byte as o => o; error as err => return err }
        i++
    }
    cb(b, " };\n")
}

/**
 * Emit the dispatch thunks for one vtable's `method_list` (INSTANCE methods only — statics keep a
 * direct slot address and need no thunk), deduplicated against `emitted` by the `cb_vtthunk_name`
 * symbol. Bundles the grown buffer and grown dedup set into a `TThunkEmit` so the thunk-emission
 * phase can thread both through its (class, contract)/(class, base) pair walk.
 *
 * @param buf          the output byte buffer to append to
 * @param prog         the whole typed program
 * @param cd_name      the vtable-owning class's canonical name
 * @param idd_name     the contract/base's canonical name
 * @param method_list  the vtable's effective methods
 * @param emitted      the set of thunk symbols already defined
 * @return             a `TThunkEmit` bundling the grown buffer and the grown `emitted` set
 * @throws             propagated from `cg_emit_vtthunk_def` on an internal inconsistency
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtable_thunks(buf: []byte, prog: CgProg, cd_name: str, idd_name: str, method_list: []parser::Function, emitted: []str): TThunkEmit | error {
    var b = buf
    var seen = emitted
    var i: u64 = 0
    loop {
        if i >= method_list.len { break }
        var m = method_list[i]
        i++
        if !cg_method_is_instance(m) { continue }
        var key = str(cb_vtthunk_name(teko::list::empty(), cd_name, idd_name, m.name))
        if cg_str_in(seen, key) { continue }
        var mns = match cg_find_method_ns(prog, cd_name, m.name) {
            str as ns2 => ns2
            null => return error { message = "codegen: conforming class is missing a vtable method's stamped function (internal)" }
        }
        b = match cg_emit_vtthunk_def(b, prog, cd_name, idd_name, mns, m.name) { []byte as o => o; error as err => return err }
        seen = teko::list::push(seen, key)
    }
    TThunkEmit { buf = b; emitted = seen }
}

/**
 * Emit ALL per-(class, contract) and per-(class, base) VTABLES plus their dispatch thunks (#291),
 * in three ordered phases that break the thunk⇄vtable reference cycle (a thunk names its self-
 * dispatch vtable; a vtable names its thunks):
 *   1. forward-DECLARE every vtable array (`static void *const tk_vt_<cd>_<idd>[];`);
 *   2. DEFINE every dispatch thunk (may now reference any forward-declared vtable);
 *   3. DEFINE every vtable array (slots reference the now-defined thunks).
 * The (class, contract)/(class, base) pair walk is identical across phases (the same conformance /
 * IS-A gates); only the per-pair emission differs. Conformance is nominal and closed-world, so this
 * whole block is compile-time and reflection-free. A program with no dynamic dispatch (e.g. the
 * compiler's own sources) emits nothing here — the fixpoint is untouched.
 *
 * @param buf   the output byte buffer to append to
 * @param prog  the whole typed program
 * @return      the buffer with every vtable forward-decl, thunk, and definition appended
 * @throws      propagated from the per-pair emitters on an internal inconsistency
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtables_and_thunks(buf: []byte, prog: CgProg): []byte | error {
    var vt_table = cg_type_table(prog)
    var b = match cg_emit_vtable_protos(buf, prog, vt_table) { []byte as o => o; error as err => return err }
    b = match cg_emit_all_vtthunks(b, prog, vt_table) { []byte as o => o; error as err => return err }
    cg_emit_all_vtable_defs(b, prog, vt_table)
}

/**
 * Phase 1 — forward-DECLARE every vtable array so a thunk defined in phase 2 may take a later-
 * defined vtable's address (`.vtable = tk_vt_<cd>_<idd>`). Walks the (class, contract)/(class, base)
 * pairs, emitting `static void *const tk_vt_<cd>_<idd>[];` for each.
 *
 * @param buf       the output byte buffer to append to
 * @param prog      the whole typed program
 * @param vt_table  the checker's type table
 * @return          the buffer with every vtable forward declaration appended
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_vtable_protos(buf: []byte, prog: CgProg, vt_table: checker::TypeTable): []byte | error {
    var b = buf
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) { b = cb(cb_tysym(cb(cb_tysym(cb(b, "static void *const tk_vt_"), cd.name), "_"), idd.name), "[];\n") }
                                if cg_pair_is_base_vtable(prog, cd, idd) { b = cb(cb_tysym(cb(cb_tysym(cb(b, "static void *const tk_vt_"), cd.name), "_"), idd.name), "[];\n") }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

/**
 * Phase 2 — DEFINE every dispatch thunk (deduplicated program-wide). Walks the same pairs as phase
 * 1; for each vtable's method list emits the instance-method thunks not yet defined.
 *
 * @param buf       the output byte buffer to append to
 * @param prog      the whole typed program
 * @param vt_table  the checker's type table
 * @return          the buffer with every dispatch thunk defined
 * @throws          propagated from the per-vtable thunk emitter on an internal inconsistency
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_all_vtthunks(buf: []byte, prog: CgProg, vt_table: checker::TypeTable): []byte | error {
    var b = buf
    var emitted: []str = teko::list::empty()
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: interface method list failed (internal)" } }
                                    var r = match cg_emit_vtable_thunks(b, prog, cd.name, idd.name, ms, emitted) { TThunkEmit as e => e; error as err => return err }
                                    b = r.buf; emitted = r.emitted
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: base method list failed (internal)" } }
                                    var r = match cg_emit_vtable_thunks(b, prog, cd.name, idd.name, bms, emitted) { TThunkEmit as e => e; error as err => return err }
                                    b = r.buf; emitted = r.emitted
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

/**
 * Phase 3 — DEFINE every vtable array (slots reference the phase-2 thunks). Walks the same pairs as
 * phases 1 and 2, emitting the interface vtable (`iface_methods_by_name` slots) and the base vtable
 * (`base_vtable_methods` slots) for each qualifying pair.
 *
 * @param buf       the output byte buffer to append to
 * @param prog      the whole typed program
 * @param vt_table  the checker's type table
 * @return          the buffer with every vtable definition appended
 * @throws          propagated from the per-vtable definition emitter on an internal inconsistency
 * @since #291 (trait/interface vtable dispatch UB fix)
 */
fn cg_emit_all_vtable_defs(buf: []byte, prog: CgProg, vt_table: checker::TypeTable): []byte | error {
    var b = buf
    var ci = 0
    loop {
        if ci >= prog.items.len { break }
        match prog.items[ci] {
            parser::TypeDecl as cd => {
                if match cd.body { parser::ClassBody => true; _ => false } {
                    var ii = 0
                    loop {
                        if ii >= prog.items.len { break }
                        match prog.items[ii] {
                            parser::TypeDecl as idd => {
                                if cg_pair_is_iface_vtable(cd, idd, vt_table) {
                                    var ms = match checker::iface_methods_by_name(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: interface method list failed (internal)" } }
                                    b = match cg_emit_vtable_def(b, prog, cd.name, idd.name, ms) { []byte as o => o; error as err => return err }
                                }
                                if cg_pair_is_base_vtable(prog, cd, idd) {
                                    var bms = match checker::base_vtable_methods(idd.name, vt_table) { []parser::Function as f => f; error => return error { message = "codegen: base method list failed (internal)" } }
                                    b = match cg_emit_vtable_def(b, prog, cd.name, idd.name, bms) { []byte as o => o; error as err => return err }
                                }
                            }
                            _ => { }
                        }
                        ii++
                    }
                }
            }
            _ => { }
        }
        ci++
    }
    b
}

/** tk_emit_c — the PROGRAM emission entry (the virtual-main over loose top-level statements).
    Kept as the public name every caller uses; delegates to tk_emit_c_mode with CgMode::Program so
    the historical output is byte-identical (the fixpoint is intact). (#265) */
fn tk_emit_c(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::Program)
}

/** tk_emit_c_export — the reverse-FFI (`abi="c"`) emission entry (FFI-D): the ordinary Program
    translation unit PLUS the C-ABI export wrappers (`cg_c_export_wrappers_text`) that expose each
    `exp` function under its C symbol. The export GATE (`check_ffi_export`) must have passed first. */
pub fn tk_emit_c_export(prog0: checker::TProgram): str | error {
    var body_c = match tk_emit_c_mode(prog0, CgMode::Program) { str as s => s; error as e => return e }
    var wrappers = match cg_c_export_wrappers_text(prog0) { str as s => s; error as e => return e }
    teko::str::concat(body_c, wrappers)
}

/** tk_emit_c_test — the NATIVE TEST-GATE emission entry (#265): a translation unit whose `main()`
    calls each `#test` in order. `cov` selects TestCov (emit the `tk_cov_*` prologue/brackets + a
    `.tkcov` dump) vs TestPlain (no coverage, zero-cost). Exposed so the build's native gate can
    request the test profile without naming CgMode across the namespace boundary. */
pub fn tk_emit_c_test(prog0: checker::TProgram, cov: bool): str | error {
    tk_emit_c_mode(prog0, if cov { CgMode::TestCov } else { CgMode::TestPlain })
}

/**
 * tk_emit_c_cov — the COVERAGE-INSTRUMENTED PROGRAM emission entry (0.3.1 C-cov): the ordinary
 * virtual-main (byte-for-byte the SAME statements `tk_emit_c` emits), wrapped with the SAME
 * production-fn/line/branch `tk_cov_*` prologues `TestCov` carries, plus an `atexit`-registered
 * dump to `$TEKO_TKCOV`. Used ONLY to build the regression tier's own coverage-feeding compiler
 * (`build_regression_cov_exe`, `src/build/project.tks`) — never the release build, so
 * `CgMode::Program`'s fixpoint-compared output is untouched. Exposed so the build driver can
 * request the coverage-instrumented program profile without naming `CgMode` across the namespace
 * boundary.
 *
 * @param prog0  the checked program to emit (a compiler-as-SUT's OWN checked program — C-cov only
 *               makes sense when it is)
 * @return       the emitted C translation unit text, or an error
 * @since 0.3.1
 */
pub fn tk_emit_c_cov(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::ProgramCov)
}

/** tk_emit_c_test_analyze — the ANALYZE-MODE test-gate emission entry (`teko test . --analyzer`,
    0.3.0.29). Emits the same production-fn/line/branch instrumentation as `TestCov`, but a per-test
    isolation harness (`emit_test_main_analyze`) that resets the sinks around each `#test` and dumps
    that test's raw id-set to `$TEKO_ANALYZE_DIR/<idx>.tkcov`. One compile answers the whole-suite
    stale/redundant question. Exposed so the build driver can request it across the namespace. */
pub fn tk_emit_c_test_analyze(prog0: checker::TProgram): str | error {
    tk_emit_c_mode(prog0, CgMode::TestAnalyze)
}

/** tk_emit_c_mode — emit the C translation unit under `mode` (#265, lever D of #249). Types,
    prototypes and function bodies are emitted IDENTICALLY across modes; only the trailing `main()`
    differs: Program = the virtual-main (loose statements), TestPlain/TestCov = the native test gate.
    Under TestCov the production-fn prologues additionally emit `tk_cov_mark`. */
fn tk_emit_c_mode(prog0: checker::TProgram, mode: CgMode): str | error {
    var prog_ag = match checker::inline_aggregate_consts(prog0) { checker::TProgram as p => p; error as e => return e }
    var _lr = cg_lift_lambdas(cg_prog_of(prog_ag))
    var prog = cg_prog_of(_lr.prog)
    var cap_lams = _lr.lams
    var b: []byte = teko::list::empty()
    b = cb(b, "// generated by teko (F2 backend) — do not edit\n")
    b = cb(b, "#include <stdint.h>\n")
    b = cb(b, "#include <stdbool.h>\n")
    b = cb(b, "#include <stdlib.h>\n")   // malloc/abort — slice copy-append (fixed+copy)
    b = cb(b, "#include <math.h>\n")   // floor/… — float ops the corpus lowers inline (link -lm)
    b = cb(b, "#include \"teko_rt.h\"\n")
    b = cb(b, "#include \"assert.h\"\n\n")   // teko::assert seed decls (driver adds its -I)

    // emit the pragma IN the generated C so it survives regeneration (a PATH cc shim does not
    // cover the Windows clang leg). Restores the pre-GCC-14 "warning, not error" behaviour.
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wincompatible-pointer-types\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wint-conversion\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wimplicit-function-declaration\"\n")
    b = cb(b, "#pragma GCC diagnostic ignored \"-Wimplicit-int\"\n\n")

    // W4c — TYPE DECLS come FIRST (before any function that uses them). Two sub-passes:
    //   a) a forward `typedef struct tk_t_<M> tk_t_<M>;` for every struct/variant/class decl, so
    //      a field/member that references a not-yet-defined aggregate (recursive or
    //      out-of-order types) still compiles.
    //   b) the full type declarations (struct/class bodies, variant tag+union, enums).
    // (enums need no forward typedef — they carry no aggregate self-reference.)
    // (#102) CLASS joins STRUCT/VARIANT here: a class value lowers to a POINTER everywhere it is
    // used (`tk_t_<M> *`), so a `[]<Class>` element is `tk_t_<M> *`. cg_emit_types_ordered (below)
    // emits ALL slice typedefs before the fixpoint that emits named (struct/variant/class) BODIES,
    // so a `tk_slice_<Class>` typedef referencing `tk_t_<Class> *` needs the class's forward
    // typedef to exist by then — exactly the same requirement a struct/variant already gets here.
    // Without this, `cc` fails with "unknown type name 'tk_t_<Class>'" on the slice's `ptr` field.
    var fw = 0
    loop {
        if fw >= prog.items.len { break }
        match prog.items[fw] {
            parser::TypeDecl as d => {
                // STRUCT/VARIANT/CLASS decls need a forward `typedef struct …;` (an aggregate
                // self-reference, or — for class — a slice/field pointer reference that may
                // precede the body). enums carry none; a TRANSPARENT alias emits no C type at all.
                match d.body {
                    parser::StructBody => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    parser::VariantBody => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    parser::ClassBody as fcb => {
                        b = cb(b, "typedef struct ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, " ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                        // (#98) a POLYMORPHIC base ALSO gets a companion FAT-POINTER typedef
                        // `tk_base_<name>` — the D3 `{ data, vtable }` two-word rep a base-typed
                        // slot lowers to. (A sealed class needs none — it is never a base.)
                        match fcb.kind {
                            parser::ClassKind::Sealed => { }
                            _ => { b = cb(cb_tysym(cb(b, "typedef struct { void *data; void *const *vtable; } tk_base_"), d.name), ";\n") }
                        }
                    }
                    // (W10b.D3) an INTERFACE (contract) value is a data+vtable FAT POINTER — the
                    // tk_closure-shaped two-word rep. It embeds nothing and nothing orders before
                    // it, so the FULL typedef lands here in the forward pass (a class/struct field
                    // of contract type then just works).
                    parser::InterfaceBody => {
                        b = cb(b, "typedef struct { void *data; void *const *vtable; } ")
                        b = mangle_type_name(b, "", d.name)
                        b = cb(b, ";\n")
                    }
                    _ => { }
                }
            }
            _ => { }
        }
        fw++
    }
    b = cb(b, "\n")
    // Full type declarations IN DEPENDENCY ORDER (self-host): slice typedefs first (pointers),
    // then named bodies + optionals (REBOOT_PLAN §202) + inline variants topologically, so every
    // by-value embed (`tk_t_Y`, `tk_opt_T`, `tk_u_…`) is fully defined before the body using it.
    // This is also before any function (so `T?`/`[]T`/variant signatures resolve).
    b = match cg_emit_types_ordered(b, prog) { []byte as o => o; error as err => return err }

    // Function PROTOTYPES — a forward declaration for every function, so a call to a function
    // defined LATER in the unit (mutual recursion / forward reference across the merged corpus)
    // resolves. C23 makes an undeclared call an error, so without these the whole self-host corpus
    // (which freely forward-references) fails to compile. (C: the prototype pass in tk_emit_c.)
    // (C7.2) Skip `from "teko_rt"` externs — they are already declared in teko_rt.h with the
    // correct FFI struct types (tk_ffi_ures/tk_ffi_sres/etc.); emitting them again would conflict.
    var pi = 0
    loop {
        if pi >= prog.items.len { break }
        match prog.items[pi] {
            checker::TFunction as f => {
                if !(f.is_extern && f.from_lib == "teko_rt") {
                    b = match emit_function_sig(b, prog, f) { []byte as o => o; error as err => return err }
                    b = cb(b, ";\n")
                }
            }
            _ => { }
        }
        pi++
    }
    b = cb(b, "\n")
    b = match cg_emit_vtables_and_thunks(b, prog) { []byte as o => o; error as err => return err }
    b = cb(b, "\n")
    // (W10) CAPTURING lambdas: env-struct typedefs + lifted-fn forward declarations (so a closure
    // literal `&__tkclo_<id>` + `sizeof(__tkenv_<id>)` resolve before the user functions).
    b = match cg_emit_lambda_decls(b, prog, cap_lams, true) { []byte as o => o; error as err => return err }
    b = cb(b, "\n")

    // First pass: emit every top-level function. Type-decls are handled above; use-decls
    // are a no-op at the C level (imports); loose statements are the second pass.
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if !f.is_extern { b = match emit_function_mode(b, prog, f, mode) { []byte as o => o; error as err => return err } } }
            parser::TypeDecl => { }   // emitted in the type-decl passes above
            parser::UseDecl => { }   // imports are a no-op at the C level (M0)
            (@TStatement()) as _gb3 => { }   /* a loose Statement → virtual-main, second pass */
            checker::TConstDecl => { }
        }
        i++
    }
    // (W10) CAPTURING lambdas: the lifted-function DEFINITIONS (env unpack + body).
    b = match cg_emit_lambda_decls(b, prog, cap_lams, false) { []byte as o => o; error as err => return err }

    b = match emit_mode_main(b, prog, mode) { []byte as o => o; error as err => return err }
    str(cg_format_c(str(b)))
}

/** emit_mode_main — the trailing `main()`, the ONLY mode-dependent emission (#265): `Program` emits
    the historical virtual-main over the loose top-level statements (byte-identical — the fixpoint
    compares THIS), `ProgramCov` (0.3.1 C-cov) emits the SAME virtual-main wrapped with the coverage
    sinks, `TestPlain`/`TestCov`/`TestAnalyze` emit the native test gate that calls each `#test`. */
fn emit_mode_main(buf: []byte, prog: CgProg, mode: CgMode): []byte | error {
    match mode {
        CgMode::Program => emit_program_main(buf, prog)
        CgMode::ProgramCov => emit_program_main_cov(buf, prog)
        _ => emit_test_main(buf, prog, mode)
    }
}

/**
 * emit_program_main — the VIRTUAL-MAIN: the loose top-level statements, in order, become the body
 * of C `main()`; falling off the end -> `return 0;` (default exit 0). W5a — the LAST loose
 * statement, if it is a value-carrying expr-statement, becomes the process exit code via
 * `return tk_exit_status((int)(…));` (`CG_MAIN_RETURN_OPEN` — the platform-uniform exit code).
 * Delegates to `emit_program_main_body(buf, prog, false)`; the fixpoint compares THIS output.
 *
 * @param buf   the output byte buffer to append the emitted C to
 * @param prog  the checked program whose loose top-level statements form the virtual-main body
 * @return      the buffer with the virtual-main appended
 * @since #265
 */
fn emit_program_main(buf: []byte, prog: CgProg): []byte | error {
    emit_program_main_body(buf, prog, false)
}

/**
 * emit_program_main_cov — `emit_program_main`'s virtual-main, PLUS a coverage-instrumentation
 * bracket (0.3.1 C-cov): a static `atexit`-registered dump helper, and the sink reset/enable calls
 * right after `tk_set_args`. `atexit` (rather than an explicit trailing call) is what makes this
 * correct regardless of HOW the virtual-main exits — a fall-through `return 0`, the W5a tail-expr
 * `return tk_exit_status((int)(…));`, or an `exit(n)`/`tk_exit(n)` call — each already runs the libc
 * `atexit` queue (only `abort`/`tk_panic*` skip it, mirroring the region-cleanup hook's own note in
 * `teko_rt.c`). Used ONLY to build the regression tier's coverage-feeding compiler
 * (`build_regression_cov_exe`, `src/build/project.tks`) — never the release binary, so the
 * `CgMode::Program` fixpoint is untouched.
 *
 * @param buf   the output byte buffer to append the emitted C to
 * @param prog  the checked program whose loose top-level statements form the virtual-main body
 * @return      the buffer with the coverage-instrumented virtual-main appended
 * @since 0.3.1
 */
fn emit_program_main_cov(buf: []byte, prog: CgProg): []byte | error {
    emit_program_main_body(buf, prog, true)
}

/**
 * emit_program_main_body — the shared body of `emit_program_main`/`emit_program_main_cov` (0.3.1
 * C-cov extraction): `cov == false` emits BYTE-IDENTICAL output to the historical virtual-main
 * (the fixpoint compares this shape); `cov == true` additionally wraps the coverage sinks around it
 * (see `emit_program_main_cov`).
 *
 * @param buf   the output byte buffer to append the emitted C to
 * @param prog  the checked program whose loose top-level statements form the virtual-main body
 * @param cov   emit the coverage-sink reset/enable/atexit-dump bracket
 * @return      the buffer with the virtual-main appended
 * @since #265
 */
fn emit_program_main_body(buf: []byte, prog: CgProg, cov: bool): []byte | error {
    var b = buf
    var last_stmt = prog.items.len
    var li: u64 = 0   // u64 index (so `last_stmt = li` matches last_stmt's u64 type)
    loop {
        if li >= prog.items.len { break }
        match prog.items[li] {
            (@TStatement()) as _gb4 => { last_stmt = li }
            _ => { }
        }
        li++
    }
    if cov { b = cb(b, "static void __tk_cov_atexit_dump(void) { const char *dp = getenv(\"TEKO_TKCOV\"); if (dp) tk_cov_dump(dp); }\n") }
    // main captures argv so teko::env::args() (tk_rt_args) can return it; tk_set_args first.
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    if cov {
        b = cb(b, "    tk_cov_reset(); tk_cov_branch_reset(); tk_cov_branches_on(true);\n")
        b = cb(b, "    tk_cov_line_reset(); tk_cov_lines_on(true);\n")
        b = cb(b, "    atexit(__tk_cov_atexit_dump);\n")
    }
    var j = 0
    loop {
        if j >= prog.items.len { break }
        match prog.items[j] {
            checker::TFunction => { }   // handled in pass 1
            parser::TypeDecl => { }   // handled in the type-decl passes
            parser::UseDecl => { }   // no-op
            checker::TConstDecl => { }
            (@TStatement()) as s => {
                // The virtual-main has no variant return slot (its tail value is the int exit
                // code), so ret_type is void — emit_as never wraps for void.
                if j == last_stmt {
                    // the tail loose statement → implicit-return path (a one-statement block).
                    // The virtual-main is FRAMELESS: its allocations live for the whole process (M.5).
                    var tail = teko::list::push(teko::list::empty(), s)
                    b = match emit_block_tail(b, tail, true, prog, checker::Void { }, "    ", "", teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => o; error as err => return err }
                } else {
                    b = match emit_stmt(b, s, true, prog, checker::Void { }, "    ", "", teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty(), teko::list::empty(), false) { []byte as o => o; error as err => return err }
                }
            }
        }
        j++
    }
    b = cb(b, "    return 0;\n")
    b = cb(b, "}\n")
    b
}

/**
 * emit_test_main — the NATIVE TEST GATE main (#265): run each `#test` in `prog.items` order under the
 * runtime's capture, then close with the run's summary and a status derived from the tally.
 *
 * IT NO LONGER ENDS IN A BLIND `return 0`, and that is the point of the capture (owner ruling
 * 2026-07-30, §14). A failing test used to end the PROCESS at the first failure, so the status was
 * whatever `abort` left and every later test was never reported; now the harness always reaches the
 * end and the status is a fact it counted: `tk_test_any_failed() ? 1 : 0`.
 *
 * Under `TestCov` the run is bracketed with the cov reset/on calls and each test wrapped in
 * `tk_cov_enter(idx)`/`tk_cov_leave`, then the sinks are dumped to a `.tkcov` for the parent to merge
 * — a dump that is now ALWAYS reached, where before a single panicking test lost the whole file.
 * Under `TestPlain` NO `tk_cov_*` is emitted (zero-cost off).
 *
 * @param buf   the output byte buffer to append the emitted C to
 * @param prog  the checked program whose `#test` items the harness runs
 * @param mode  the code-generation profile selecting the coverage brackets
 * @return      the buffer with the gate `main` appended
 * @throws      when the analyze profile's own harness fails to emit
 */
fn emit_test_main(buf: []byte, prog: CgProg, mode: CgMode): []byte | error {
    if mode == CgMode::TestAnalyze { return emit_test_main_analyze(buf, prog) }
    var b = buf
    var cov = mode == CgMode::TestCov
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    if cov {
        b = cb(b, "    tk_cov_reset();\n")
        b = cb(b, "    tk_cov_branch_reset(); tk_cov_branches_on(true);\n")
        b = cb(b, "    tk_cov_line_reset(); tk_cov_lines_on(true);\n")
    }
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { b = emit_test_call(b, f, i, cov) }
            }
            _ => { }
        }
        i++
    }
    if cov {
        b = cb(b, "    tk_cov_branches_on(false); tk_cov_lines_on(false);\n")
        b = cb(b, "    { const char *dp = getenv(\"TEKO_TKCOV\"); if (dp) tk_cov_dump(dp); }\n")
    }
    b = emit_test_main_close(b)
    b = cb(b, "}\n")
    b
}

/**
 * emit_test_main_analyze — the per-test ISOLATION harness main (`teko test . --analyzer`, 0.3.0.29).
 *
 * Turns line/branch sinks on once, then for EACH `#test` (via `emit_test_call_analyze`) resets all
 * three sinks, runs exactly that one test under `tk_cov_enter(idx)`/`tk_cov_leave`, and dumps THAT
 * test's raw id-set to `$TEKO_ANALYZE_DIR/<idx>.tkcov`. One compile + one run therefore yields N
 * disjoint per-test id-sets, which the build driver reads back to classify STALE/REDUNDANT/LIVE —
 * without the per-test recompile the aggregate `TestCov` sink forces on `--per-test-cov`. There is
 * NO end-of-run aggregate dump: each test already flushed its own file.
 *
 * @param buf   the output byte buffer to append the emitted C to
 * @param prog  the checked program whose `#test` items form the harness body
 * @return      the buffer with the analyze-mode `main()` appended
 * @since 0.3.0.29
 */
fn emit_test_main_analyze(buf: []byte, prog: CgProg): []byte | error {
    var b = cb(buf, "extern int snprintf(char *, size_t, const char *, ...);\n")
    b = cb(b, "int main(int argc, char **argv) {\n")
    b = cb(b, "    tk_set_args(argc, argv);\n")
    b = cb(b, "    tk_cov_branches_on(true);\n")
    b = cb(b, "    tk_cov_lines_on(true);\n")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test { b = emit_test_call_analyze(b, f, i) }
            }
            _ => { }
        }
        i++
    }
    b = emit_test_main_close(b)
    b = cb(b, "}\n")
    b
}

/**
 * emit_test_main_close — the last two lines of EVERY test harness: the run's summary, then the
 * status the tally earned.
 *
 * IT IS ONE FUNCTION BECAUSE THE ANALYZE HARNESS ALREADY DRIFTED ONCE, and the drift was silent.
 * The capture (§14) makes a failing `#test` return instead of aborting, so a harness that still
 * closed on a blind `return 0` reported a suite with failures as SUCCESS — and `run_analyzer`
 * (`project.tks`) reads exactly that status (`if arc != 0 { return arc }`). The plain gate had been
 * taught to count; the analyze gate had not, and nothing would have said so. Sharing the close is
 * what makes "which harness reports the tally" un-askable.
 *
 * ALSO CLOSES THIS SHARD'S JOURNAL SEGMENT (journal wiring, 0.3.1): `note_test_end` runs ONCE here,
 * never per test, so `fold` sees a clean `end` for a shard that reached this line and can still
 * synthesise `incomplete` for one that did not (died mid-suite) — the crash-survival property the
 * journal exists for.
 *
 * @param buf  the output byte buffer to append the emitted C to
 * @return     the buffer with the summary call, the journal close, and the tally-derived `return`
 * @since 0.3.1.0
 */
fn emit_test_main_close(buf: []byte): []byte {
    var b = cb(buf, "    tk_test_summary();\n    ")
    b = cb_fn_name(b, "teko::journal", "note_test_end")
    b = cb(b, "();\n")
    cb(b, "    return tk_test_any_failed() ? 1 : 0;\n")
}

/**
 * cb_journal_tkstr_lit — the `(tk_str){ (const tk_byte *)"<escaped>", <len>` compound-literal text
 * every journal hook call below embeds as its `label` argument — everything BETWEEN the call's own
 * opening paren and the literal's OWN closing `}` (the caller supplies both parens), factored out of
 * `emit_test_channel_open`'s equivalent so the two never drift apart on how a label is quoted.
 *
 * @param buf    the output byte buffer to append the emitted C to
 * @param label  the string to embed as a `tk_str` literal
 * @return       the buffer with the literal appended, NOT YET closed (no trailing ` }`)
 * @since 0.3.1
 */
fn cb_journal_tkstr_lit(buf: []byte, label: str): []byte {
    var b = cb(buf, "(tk_str){ (const tk_byte *)\"")
    b = cb_cstr_escaped(b, label)
    b = cb(b, "\", ")
    cb_u64_digits(b, label.len)
}

/**
 * cb_journal_call1 — emit a call to a `pub fn` in `teko::journal` taking exactly one `str` argument:
 * `<mangled>((tk_str){ ... });\n`. `cb_fn_name` mangles the SAME way a call to any user function
 * does (`teko::journal`'s own functions ARE ordinary user functions, compiled through this exact
 * corpus like any other), so the symbol this builds is guaranteed to match the one the journal
 * module itself is compiled under.
 *
 * @param buf    the output byte buffer to append the emitted C to
 * @param name   the `teko::journal` function's bare name
 * @param label  the string argument (a test/row label)
 * @return       the buffer with the call appended
 * @since 0.3.1
 */
fn cb_journal_call1(buf: []byte, name: str, label: str): []byte {
    var b = cb_journal_tkstr_lit(cb(cb_fn_name(buf, "teko::journal", name), "("), label)
    cb(b, " });\n")
}

/**
 * cb_journal_call_exited — emit `teko::journal::note_test_exited((tk_str){ ... }, <code-expr>);\n`,
 * where `code_expr` is a C expression this function does NOT evaluate — the local
 * `tk_test_outcome`'s own `.code` field, read at runtime by the emitted call site, never a value
 * this codegen pass could know at compile time.
 *
 * @param buf        the output byte buffer to append the emitted C to
 * @param label      the string argument (a test's label)
 * @param code_expr  the C expression naming the exit code (`"teko_journal_rv.code"`)
 * @return           the buffer with the call appended
 * @since 0.3.1
 */
fn cb_journal_call_exited(buf: []byte, label: str, code_expr: str): []byte {
    var b = cb_journal_tkstr_lit(cb(cb_fn_name(buf, "teko::journal", "note_test_exited"), "("), label)
    cb(b, teko::str::concat(" }, ", code_expr, ");\n"))
}

/**
 * emit_test_call — one native-gate `#test` invocation: the shard filter, the arena checkpoint, this
 * test's own out/err channel, the optional coverage brackets, and the captured call that reports it.
 *
 * The label is `namespace::name` (or bare `name`). Under `cov` the body's lines/branches are
 * attributed to this test via `tk_cov_enter(idx)`/`tk_cov_leave`.
 *
 * (#469) Each invocation is wrapped in a `tk_arena_push()` / `tk_arena_pop()` checkpoint — the port
 * of the #109 test-gate memory bound to native — so the whole per-test span (the channel, the test's
 * transient allocations) is bulk-freed after each test instead of accumulating in the never-dropped
 * root region across the whole run. The coverage sinks (`tk_cov_*`) are libc-heap, so the marks
 * recorded inside the span survive the pop, and the cov brackets nest strictly inside the arena ones
 * (arena_push … cov_enter … body … cov_leave … arena_pop).
 *
 * THE POP IS NOW ALWAYS REACHED (§14): before the capture, a test that panicked died between the push
 * and the pop, so the checkpoint this function exists to take was the one case it never completed.
 *
 * @param buf  the output byte buffer to append the emitted C to
 * @param f    the `#test` function being invoked (its namespace + name form the label and symbol)
 * @param idx  the `prog.items` coverage id passed to `tk_cov_enter` under `cov`
 * @param cov  whether `CgMode::TestCov` is active (emit the `tk_cov_enter`/`tk_cov_leave` brackets)
 * @return     the buffer with this test's invocation appended
 */
fn emit_test_call(buf: []byte, f: checker::TFunction, idx: u64, cov: bool): []byte {
    var b = cb(buf, "    if (tk_test_shard_take()) {\n")
    b = cb(b, "    tk_arena_push();\n")
    b = emit_test_channel_open(b, f)
    if cov { b = cb(cb_u64_digits(cb(b, "    tk_cov_enter("), idx), ");\n") }
    b = emit_test_captured_call(b, f)
    if cov { b = cb(b, "    tk_cov_leave();\n") }
    b = cb(b, "    tk_arena_pop();\n")
    b = cb(b, "    }\n")
    b
}

/**
 * emit_test_captured_call — the ONE invocation of a `#test` body, run under the runtime's capture and
 * reported instead of merely called (owner ruling 2026-07-30, §14).
 *
 * WHAT REPLACED WHAT, and why it USED TO be one line. The harness used to call the body and then
 * close the channel with `tk_test_end()`, so a body that panicked or called `exit` ENDED THE PROCESS:
 * every later test went unreported, the tally had to be reconstructed from the wreckage, the
 * `.tkcov` was never dumped and the arena checkpoint never rewound. `tk_test_run` returns instead —
 * the setjmp lives entirely inside the runtime — and `tk_test_report` writes the verdict this test
 * earned (`ok`, `FAILED`, or `FAILED (exit n)`) and counts it.
 *
 * NOW ALSO NOTES THE VERDICT TO THE JOURNAL (journal wiring, 0.3.1): the outcome is captured in a
 * LOCAL (`tk_test_outcome` is the same struct `tk_test_report` already takes by value, so this costs
 * nothing new to compute) and inspected ONCE to call the matching `teko::journal::note_test_*` hook
 * before handing the SAME value to `tk_test_report`, unchanged. Wrapped in its own C block (`{ … }`)
 * so the local's name cannot collide with a neighbouring test's block inside the same
 * `if (tk_test_shard_take())` body.
 *
 * THE ONLY THING THIS ASKS OF A CODE GENERATOR IS THE ADDRESS OF A TOP-LEVEL FUNCTION. A `#test` is
 * emitted as `void <symbol>(void)`, so `&<symbol>` is exactly the `void (*)(void)` the runtime takes:
 * no cast, no thunk, no closure pair.
 *
 * @param buf  the output byte buffer to append the emitted C to
 * @param f    the `#test` whose namespace + name form the mangled symbol
 * @return     the buffer with the captured invocation appended
 */
fn emit_test_captured_call(buf: []byte, f: checker::TFunction): []byte {
    var label = test_label_of(f)
    var b = cb(buf, "    { tk_test_outcome teko_journal_rv = tk_test_run(&")
    b = cb_fn_name(b, f.namespace, f.name, f.overload_suffix)
    b = cb(b, ");\n    if (teko_journal_rv.how == TK_TEST_OK) { ")
    b = cb_journal_call1(b, "note_test_ok", label)
    b = cb(b, "    } else if (teko_journal_rv.how == TK_TEST_EXITED) { ")
    b = cb_journal_call_exited(b, label, "teko_journal_rv.code")
    b = cb(b, "    } else { ")
    b = cb_journal_call1(b, "note_test_panicked", label)
    b = cb(b, "    }\n    tk_test_report(teko_journal_rv);\n    }\n")
    b
}

/**
 * emit_test_channel_open — the `tk_test_begin("<label>")` call that gives ONE test its own out/err
 * channel, replacing the old `tk_print("test <label> ... ")` + `tk_flush_out()` pair.
 *
 * WHY THE VERDICT LINE MOVED TO THE END (owner ruling: a test in process gets its own channel). The
 * old harness printed the label BEFORE the body and `ok` AFTER it, on the shared stream — so a test
 * that printed anything of its own split its own verdict line in two and pushed `ok` onto the next
 * line. Measured on this tree, and it made a suite count anchored on `... ok` wrong. Now the label is
 * only REMEMBERED here; `tk_test_end` (or the panic path, for a failure) writes the whole verdict
 * line at once and then this test's captured bytes under it. The flush the old pair needed for
 * crash-attribution moved into `tk_chan_verdict_line`, which flushes every verdict line.
 *
 * @param buf  the output byte buffer to append the emitted C to
 * @param f    the `#test` whose namespace + name form the label
 * @return     the buffer with the channel-open call appended
 */
fn emit_test_channel_open(buf: []byte, f: checker::TFunction): []byte {
    var label = test_label_of(f)
    var b = cb(buf, "    tk_test_begin((tk_str){ (const tk_byte *)\"")
    b = cb_cstr_escaped(b, label)
    b = cb(b, "\", ")
    b = cb_u64_digits(b, label.len)
    b = cb(b, " });\n")
    cb_journal_call1(b, "note_test_begin", label)
}

/**
 * test_label_of — the `namespace::name` (or bare `name`) label a `#test` reports and journals under
 * — ONE composer so `emit_test_channel_open`'s `tk_test_begin` label and every journal hook's label
 * are provably the same string.
 *
 * @param f  the `#test` function
 * @return   its label
 * @since 0.3.1
 */
fn test_label_of(f: checker::TFunction): str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

/**
 * emit_test_call_analyze — one `#test` invocation under the analyze harness (0.3.0.29).
 *
 * Mirrors `emit_test_call`'s label prints and arena checkpoint, but ISOLATES this test's coverage:
 * before the call it resets all three sinks so they hold ONLY this test's ids; after the call it
 * dumps them to `$TEKO_ANALYZE_DIR/<idx>.tkcov` (the literal `idx` is baked in at emit time via the
 * digit helper, so no runtime idx bookkeeping is needed). If `$TEKO_ANALYZE_DIR` is unset the dump
 * is skipped (the binary still runs as a plain gate). The cov brackets nest strictly inside the
 * arena checkpoint, exactly as `emit_test_call` orders them.
 *
 * IT CAPTURES TOO, and it has to: the analyzer's whole value is the per-test dump, and a body that
 * panicked used to take the process down with every dump after it. All three `Test*` profiles emit
 * `tk_test_run`; `Program` and `ProgramCov` never do, which is what keeps the boundary structural.
 *
 * @param buf  the output byte buffer to append the emitted C to
 * @param f    the `#test` function being invoked (its namespace + name form the label and symbol)
 * @param idx  the `prog.items` coverage id — baked into the dump path AND passed to `tk_cov_enter`
 * @return     the buffer with this test's isolated invocation appended
 * @since 0.3.0.29
 */
fn emit_test_call_analyze(buf: []byte, f: checker::TFunction, idx: u64): []byte {
    var b = cb(buf, "    tk_arena_push();\n")
    b = emit_test_channel_open(b, f)
    b = cb(b, "    tk_cov_reset(); tk_cov_branch_reset(); tk_cov_line_reset();\n")
    b = cb(cb_u64_digits(cb(b, "    tk_cov_enter("), idx), ");\n")
    b = emit_test_captured_call(b, f)
    b = cb(b, "    tk_cov_leave();\n")
    b = cb(b, "    { const char *d = getenv(\"TEKO_ANALYZE_DIR\"); if (d) { char p[1024]; snprintf(p, sizeof p, \"%s/")
    b = cb_u64_digits(b, idx)
    b = cb(b, ".tkcov\", d); tk_cov_dump(p); } }\n")
    b = cb(b, "    tk_arena_pop();\n")
    b
}

/**
 * mode_instruments_cov — whether `mode` populates the `tk_cov_*` sinks (`TestCov` aggregates the
 * whole run into one dump, `TestAnalyze` isolates each test into its own dump, `ProgramCov`
 * aggregates the whole virtual-main run into one dump — 0.3.1 C-cov). All three emit the SAME
 * production-fn/line/branch instrumentation; only the trailing `main()` harness differs (`Program`
 * and `TestPlain` emit ZERO cov calls → byte-identical output → the gen1==gen2 fixpoint is intact).
 *
 * @param mode  the codegen mode being emitted
 * @return      true for `TestCov`/`TestAnalyze`/`ProgramCov`, false for `Program`/`TestPlain`
 * @since 0.3.0.29
 */
fn mode_instruments_cov(mode: CgMode): bool {
    match mode {
        CgMode::TestCov => true
        CgMode::TestAnalyze => true
        CgMode::ProgramCov => true
        _ => false
    }
}

/** emit_function_mode — emit a function body, adding the `tk_cov_mark(idx)` entry prologue under
    `TestCov`/`TestAnalyze` for each PRODUCTION (non-test, non-`teko::coverage`) function so
    function-level coverage is populated natively — the mark the native gate records on entry. Under
    Program/TestPlain this is exactly emit_function (no prologue → byte-identical). The coverage
    subsystem (`teko::coverage`) is self-excluded so it never measures its own reporting code. (#265) */
fn emit_function_mode(buf: []byte, prog: CgProg, f: checker::TFunction, mode: CgMode): []byte | error {
    if !mode_instruments_cov(mode) { return emit_function(buf, prog, f) }
    if f.is_test || f.namespace == "teko::coverage" { return emit_function(buf, prog, f) }
    emit_function_cov(buf, prog, f, fn_items_index(prog, f) to i64)
}

/** fn_items_index — the `prog.items` index of `f` (its coverage id, shared across processes). Matches
    by identity of namespace + name + line (the fields the cov marks key on). (#265) */
fn fn_items_index(prog: CgProg, f: checker::TFunction): u64 {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as g => {
                if g.namespace == f.namespace && g.name == f.name && g.line == f.line { return i }
            }
            _ => { }
        }
        i++
    }
    0
}

// E3 — the `.tsym` symbol map (mirror of codegen.c tk_emit_tsym): one line per function mapping its
// mangled C symbol to the Teko qualified name + source `file:line`, for the native stack-trace (E4).
fn tk_emit_tsym(prog: checker::TProgram): str {
    var b: []byte = teko::list::empty()
    b = cb(b, "# teko symbol map (.tsym v1): <c-symbol>\\t<teko-name>\\t<file>:<line>\n")
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                b = cb_fn_name(b, f.namespace, f.name, f.overload_suffix)
                b = cb(b, "\t")
                if f.namespace.len != 0 {
                    b = cb(b, f.namespace)
                    b = cb(b, "::")
                }
                b = cb(b, f.name)   // the Teko qualified name
                b = cb(b, "\t")
                b = cb(b, f.file)
                b = cb(b, ":")
                b = cb_u64_digits(b, f.line to u64)
                b = cb(b, "\n")
            }
            _ => { }
        }
        i = i + 1
    }
    str(b)
}
