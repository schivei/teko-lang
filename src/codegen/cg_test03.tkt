/** split 3/8 from codegen_test.tkt — mechanical, pure reorg, no logic changes. */
use teko::checker
use teko::lexer
use teko::parser

fn cgt_emit_borrow() {
    let prog = cgt_prog()

    let borrow_x = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("x") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    let sx = match emit_expr(cgt_empty(), prog, borrow_x) { []byte as o => str(o); error => "" }
    teko::assert::is_true(sx == "&x")

    let borrow_kw = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("return") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    let skw = match emit_expr(cgt_empty(), prog, borrow_kw) { []byte as o => str(o); error => "" }
    teko::assert::is_true(skw == "&return_")
}

// ---------------------------------------------------------------------------
// Group J: emit_binary + emit_div_mod
//   emit_binary, emit_div_mod (via emit_expr with TBinary Slash/Percent)
// ---------------------------------------------------------------------------
#test

fn cgt_emit_binary_and_div() {
    let prog = cgt_prog()
    let left = cgt_num_i64(10)
    let right = cgt_num_i64(3)

    // TBinary Plus on i64 → C7.15: tk_add_i64(left, right)
    let e_add = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Plus; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_add = match emit_expr(cgt_empty(), prog, e_add) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_add, "tk_add_i64"))

    // TBinary Star on i64 → C7.15: tk_mul_i64(left, right)
    let e_mul = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Star; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_mul = match emit_expr(cgt_empty(), prog, e_mul) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mul, "tk_mul_i64"))

    // TBinary Slash → emit_div_mod → tk_div_i64(left, right)
    let e_div = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Slash; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_div = match emit_expr(cgt_empty(), prog, e_div) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_div, "tk_div_i64"))

    // TBinary Percent → emit_div_mod → tk_mod_i64(left, right)
    let e_mod = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Percent; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_mod = match emit_expr(cgt_empty(), prog, e_mod) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mod, "tk_mod_i64"))
}

// ---------------------------------------------------------------------------
// Group K: emit_unary, emit_compare, emit_cast
// ---------------------------------------------------------------------------
#test

fn cgt_emit_unary_compare_cast() {
    let prog = cgt_prog()
    let n42 = cgt_num_i64(42)

    // emit_unary — `(-42)` and `(!true)`
    let e_neg = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Minus; operand = n42 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_neg = match emit_expr(cgt_empty(), prog, e_neg) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_neg, "-"))

    let e_not = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Bang; operand = cgt_e_bool_t() }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    let s_not = match emit_expr(cgt_empty(), prog, e_not) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_not, "!"))

    // emit_compare — TCompare with one rest term (a < b)
    let term = checker::TCmpTerm { op = lexer::TokenKind::Lt; operand = n42 }
    let terms: []checker::TCmpTerm = teko::list::push(teko::list::empty(), term)
    let e_cmp = checker::TExpr {
        kind = checker::TCompare { first = cgt_num_i64(0); rest = terms }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    let s_cmp = match emit_expr(cgt_empty(), prog, e_cmp) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_cmp, "<"))

    // emit_cast — widening I32 → I64 (no guard needed): ((int64_t)(inner))
    let inner32 = cgt_num_i32(10)
    let e_widen = checker::TExpr {
        kind = checker::TCast { expr = inner32 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    let s_widen = match emit_expr(cgt_empty(), prog, e_widen) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_widen, "int64_t"))

    // emit_cast — narrowing I64 → I8 (guarded): tk_to_i8_s(inner)
    let inner64 = cgt_num_i64(200)
    let e_narrow = checker::TExpr {
        kind = checker::TCast { expr = inner64 }
        type = checker::Prim { kind = checker::PrimKind::I8 }
        line = 0; col = 0
    }
    let s_narrow = match emit_expr(cgt_empty(), prog, e_narrow) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_narrow, "tk_to_i8"))
}

// ---------------------------------------------------------------------------
// Group M2: S2/W9 — VALUE-position arm regions. A value `if`/`match` arm with a NON-tail
//   binding takes the value-arm path (emit_branch_value / emit_arm_value) and yields its tail
//   to the enclosing sink. With NO escape context (emit_expr threads empty escaping/regions/
//   fn_body) NO region is opened — so the output is the pre-W9 value-form, byte-identical: the
//   `sink = (…); break;` commit with no `tk_region_new`. (The genuine region-opening path is
//   covered end-to-end by the value-arm regression examples — the predicate needs the live
//   per-function escape set, which only the full build pipeline supplies.)
// ---------------------------------------------------------------------------
#test

fn cgt_emit_value_arm_no_region_when_no_context() {
    let prog = cgt_prog()
    // if (true) { let tmp = 5; tmp } else { 0 }  — a value `if` whose then-branch has a non-tail
    // binding + a tail read. emit_branch_value runs; with empty escape context no region opens.
    let bind_tmp: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(5); di_kind = parser::DiKind::None
    }
    let tail_read: checker::TStatement = cgt_stmt(cgt_e_var("tmp"))
    mut then_blk: []checker::TStatement = teko::list::push(teko::list::empty(), bind_tmp)
    then_blk = teko::list::push(then_blk, tail_read)
    let else_blk: []checker::TStatement = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0)))
    let if_e = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = then_blk; has_else = true; else_blk = else_blk }
    let e_if = checker::TExpr { kind = if_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    let result = match emit_expr(cgt_empty(), prog, e_if) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "tmp"))
    // No live escape context ⇒ no value-arm region opened (leak-safe pre-W9 output).
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

// A value `match` arm with a non-tail binding takes emit_arm_value's value path: the tail value
// commits with `_rN = (…); break;`. No escape context ⇒ no region (byte-identical to pre-W9).
#test

fn cgt_emit_value_match_arm_commits_tail() {
    let prog = cgt_prog()
    let bind_tmp: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(7); di_kind = parser::DiKind::None
    }
    let arm_lit: parser::Pattern = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(1); fval = 0.0 }; line = 0; col = 0 }
    }
    mut arm_body: []checker::TStatement = teko::list::push(teko::list::empty(), bind_tmp)
    arm_body = teko::list::push(arm_body, cgt_stmt(cgt_e_var("tmp")))
    let arm1 = checker::TArm { pattern = arm_lit; has_when = false; guard = cgt_num_i64(0); body = arm_body }
    let arm_w = checker::TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0))) }
    mut arms: []checker::TArm = teko::list::push(teko::list::empty(), arm1)
    arms = teko::list::push(arms, arm_w)
    let m_e = checker::TMatchExpr { subject = cgt_num_i64(1); arms = arms }
    let e_m = checker::TExpr { kind = m_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    let result = match emit_expr(cgt_empty(), prog, e_m) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "break;"))
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

/** cgt_emit_loop_with_init — a loop with a NON-empty `init` wraps in a `{ }` C scope and emits the
    preamble binding before `while (1)` (#517 emit_loop init wrapper). */
#test

fn cgt_emit_loop_with_init() {
    let prog = cgt_prog()
    let init_bind: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3); di_kind = parser::DiKind::None
    }
    let init: []checker::TStatement = teko::list::push(cgt_empty_stmts(), init_bind)
    let body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    let loop_s: checker::TStatement = checker::TLoopStmt { label = ""; init = init; body = body }
    let ret_type = checker::Prim { kind = checker::PrimKind::I64 }
    mut b: []checker::TStatement = teko::list::push(cgt_empty_stmts(), loop_s)
    b = teko::list::push(b, cgt_ret(cgt_num_i64(0)))
    let f = cgt_fn0("cgt_loop_init", "teko::cgt", ret_type, b)
    let r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r, "_hi"))
    teko::assert::is_true(teko::str::contains(r, "while"))
}

/** cgt_loop_init_walkers — the codegen collect-optionals and lambda-lift walkers descend into a
    loop's `init` preamble as well as its body (#517). */
#test

fn cgt_loop_init_walkers() {
    let init_bind: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3); di_kind = parser::DiKind::None
    }
    let init: []checker::TStatement = teko::list::push(cgt_empty_stmts(), init_bind)
    let body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    let loop_s: checker::TStatement = checker::TLoopStmt { label = ""; init = init; body = body }
    let stmts: []checker::TStatement = teko::list::push(cgt_empty_stmts(), loop_s)
    let set0 = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }
    let collected = cg_collect_block_opts(set0, stmts)
    teko::assert::is_true(collected.inners.len == 0)
    mut acc = StampAcc { next = 0; fns = teko::list::empty(); lams = teko::list::empty() }
    let lifted = cg_lift_block(stmts, acc)
    teko::assert::is_true(lifted.len == 1)
}

