use teko::checker

// teko::codegen functions (split 23/49 from codegen.tks — mechanical, pure reorg, no logic changes).

// emit_host_ffi — lift a host-FFI primitive's fixed-ABI result (teko_rt.h) into the program's
// result type. The runtime can't name the generated sum/optional/slice structs (its header is
// included before them), so codegen builds them here: call the primitive, then construct
// `e.type` from the result's header-knowable fields (`error` is its message str). Single-eval —
// the result struct is bound to one temp, then both arms read it. `kind` selects the shape:
// "sres"(str|error) "ures"(error?) "slres"([]str|error) "u64res"(u64|error) "args" "run".
// (C: `emit_host_ffi`.)
fn emit_host_ffi(buf: []byte, prog: CgProg, e: checker::TExpr, c: checker::TCall, kind: str, rtfn: str, escaping: []str, regions: []RegionFrame, fn_body: []checker::TStatement, dctx: DeferCtx) -> []byte | error {
    let t = $"_h{buf.len}"   // unique temp per call site
    let str_t = checker::Str { }
    let err_t = checker::Error { }

    // args() -> []str : ({ uint64_t _hNn; tk_str *_hNp = tk_rt_args(&_hNn); (tk_slice_str){…}; })
    if kind == "args" {
        mut o = cb(buf, "({ uint64_t ")
        o = cb(o, t)
        o = cb(o, "n; tk_str *")
        o = cb(o, t)
        o = cb(o, "p = ")
        o = cb(o, rtfn)
        o = cb(o, "(&")
        o = cb(o, t)
        o = cb(o, "n); (")
        o = match cg_slice_typename(o, str_t) { []byte as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, "p, .len = ")
        o = cb(o, t)
        return cb(o, "n }; })")
    }
    // (C7.1a) bytes_from_ptr(ptr,u64) -> []byte : a fixed-ABI tk_ffi_bytes {ptr,len} lifted to the
    // generated tk_slice_byte (same {ptr,len} layout; the runtime can't name the generated slice).
    if kind == "bytes" {
        let byte_t = checker::Byte { }
        mut o = cb(buf, "({ tk_ffi_bytes ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, ", ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "); (")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, "){ .ptr = ")
        o = cb(o, t)
        o = cb(o, ".ptr, .len = ")
        o = cb(o, t)
        return cb(o, ".len }; })")
    }
    // run([]str) -> i32 : the primitive takes ptr+len (no generated slice type). Single-eval argv.
    if kind == "run" {
        mut o = cb(buf, "({ ")
        o = match cg_slice_typename(o, str_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, " = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, ".ptr, ")
        o = cb(o, t)
        return cb(o, ".len); })")
    }

    // C7.12 — ures_byteslice: write_file_bytes(path: str, data: []byte) -> error?.
    // The C function takes (path, ptr, len); the Teko []byte slice carries both in a struct,
    // so we bind the slice to a temp and pass .ptr + .len separately.
    if kind == "ures_byteslice" {
        let byte_t = checker::Byte { }
        mut o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[1], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_ures ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, ", ")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = match cg_emit_ffi_ures(o, prog, e.type, teko::str::concat(t, "r"), escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // ROUND 0 — sres_byteslice: str_from_utf8(bytes: []byte) -> str | error. The C function
    // takes (ptr, len); the Teko []byte slice carries both in a struct. Same VARIANT-wrap shape
    // as the generic "sres" branch below, but the single arg is a []byte split into ptr+len
    // (mirrors "ures_byteslice"'s arg handling, wrapping a str|error result instead of error?).
    if kind == "sres_byteslice" {
        let byte_t = checker::Byte { }
        mut o = cb(buf, "({ ")
        o = match cg_slice_typename(o, byte_t) { []byte as r => r; error as err => return err }
        o = cb(o, " ")
        o = cb(o, t)
        o = cb(o, "s = ")
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[0], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        o = cb(o, "; tk_ffi_sres ")
        o = cb(o, t)
        o = cb(o, "r = ")
        o = cb(o, rtfn)
        o = cb(o, "(")
        o = cb(o, t)
        o = cb(o, "s.ptr, (uint64_t)")
        o = cb(o, t)
        o = cb(o, "s.len); ")
        o = cb(o, t)
        o = cb(o, "r.ok ? ")
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}r.value") { []byte as r => r; error as err => return err }
        o = cb(o, " : ")
        o = match emit_variant_wrap_str(o, prog, e.type, err_t, teko::str::concat("tk_error_make(", $"{t}r", ".err)")) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // The struct-returning host FFI: bind the fixed-ABI result, then lift per result shape.
    let resty = if kind == "sres" { "tk_ffi_sres" } else if kind == "ures" { "tk_ffi_ures" } else if kind == "slres" { "tk_ffi_slres" } else { "tk_ffi_u64res" }
    mut o = cb(buf, "({ ")
    o = cb(o, resty)
    o = cb(o, " ")
    o = cb(o, t)
    o = cb(o, " = ")
    o = cb(o, rtfn)
    o = cb(o, "(")
    mut i: u64 = 0
    loop {
        if i >= c.args.len { break }
        if i > 0 { o = cb(o, ", ") }
        o = match emit_expr_ctx(o, prog, checker::Void { }, c.args[i], escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        i++
    }
    o = cb(o, "); ")

    if kind == "ures" {
        o = match cg_emit_ffi_ures(o, prog, e.type, t, escaping, regions, fn_body, dctx) { []byte as r => r; error as err => return err }
        return cb(o, "; })")
    }

    // VARIANT results: ok → wrap the value arm ; !ok → wrap the error arm (a tk_error).
    o = cb(o, t)
    o = cb(o, ".ok ? ")
    if kind == "sres" {
        o = match emit_variant_wrap_str(o, prog, e.type, str_t, $"{t}.value") { []byte as r => r; error as err => return err }
    } else if kind == "u64res" {
        o = match emit_variant_wrap_str(o, prog, e.type, checker::Prim { kind = checker::PrimKind::U64 }, $"{t}.value") { []byte as r => r; error as err => return err }
    } else {
        let slice_t = checker::Slice { element = checker::Str { } }
        // cexpr has literal braces → built via concat ($-interpolation has no brace escape).
        let sx = teko::str::concat("(tk_slice_str){ .ptr = ", t, teko::str::concat(".ptr, .len = ", t, ".len }"))
        o = match emit_variant_wrap_str(o, prog, e.type, slice_t, sx) { []byte as r => r; error as err => return err }
    }
    o = cb(o, " : ")
    // E2-NATIVE: wrap the runtime's `.err` tk_str (message) into a full tk_error via tk_error_make.
    // u64res carries no message (not-found is the only failure) → empty message tk_error_make.
    let eexpr = if kind == "u64res" { "tk_error_make((tk_str){0})" } else { teko::str::concat("tk_error_make(", t, ".err)") }
    o = match emit_variant_wrap_str(o, prog, e.type, err_t, eexpr) { []byte as r => r; error as err => return err }
    return cb(o, "; })")
}

/**
 * Report whether two resolved types produce the SAME generated C type name — the byte-free twin
 * of the retired `cg_type_mangle_eq`, which built two throwaway mangle strings only to compare
 * them (AL4a-2, following the `qualify_eq` precedent). It decides `mangle(a) == mangle(b)`
 * byte-for-byte WITHOUT allocating, mirroring `cg_opt_mangle`/`cg_opt_key` exactly: a type whose
 * mangle would error (an inline `Variant`, a `Void`-inner optional/slice, an unsupported shape)
 * has the empty key `""`, so two such types compare equal and an erroring type never equals a
 * well-formed one. This is MANGLE-equality, NOT `type_eq`: two DISTINCT types can share a C name
 * (the #109 bare-last-segment case — `teko::io::Reader` and `teko::emit::Reader` both mangle to
 * `Reader`), and this predicate returns true for them exactly as the string compare did.
 *
 * @param a  the first resolved type
 * @param b  the second resolved type
 * @return   true iff the two types mangle to the identical C type name
 */
fn cg_mangle_eq(a: checker::Type, b: checker::Type) -> bool {
    let ea = cg_mangle_errors(a)
    let eb = cg_mangle_errors(b)
    if ea || eb { return ea && eb }
    cg_mangle_bytes_eq(a, b)
}

/**
 * Report whether a type's mangle would ERROR (making its `cg_opt_key` the empty string `""`),
 * mirroring the error arms of `cg_opt_mangle` precisely: an inline `Variant` and any unsupported
 * shape error, and a `Slice` errors when its element is the `Void` sentinel or itself errors.
 * Every leaf (`Prim`, `Byte`, `Char`, `Str`, `Error`, `Named`) mangles cleanly.
 *
 * @param t  the resolved type
 * @return   true iff `cg_opt_mangle` would return an error for `t`
 */
fn cg_mangle_errors(t: checker::Type) -> bool {
    match t {
        checker::Prim => false
        checker::Byte => false
        checker::Char => false
        checker::Str => false
        checker::Error => false
        checker::Named => false
        checker::Slice as sl => match sl.element {
            checker::Void => true
            _ => cg_mangle_errors(sl.element)
        }
        _ => true
    }
}

/**
 * Compare the mangles of two types already known to mangle cleanly, byte-for-byte and without
 * allocating. `Slice` prepends `slice_` and recurses; a `Named` mangles to its bare last path
 * segment; every other leaf mangles to a fixed literal. Because a `Named`'s arbitrary segment text
 * can coincide with a composite's rendered form (`Named "slice_str"` and `[]str` both yield
 * `slice_str`), any comparison that touches a `Named` is routed through
 * `cg_mangle_type_matches_name`, which folds the other side's WHOLE mangle against the segment
 * bytes — giving true byte-identity with the old string compare, not a mere constructor match.
 *
 * @param a  the first resolved type (mangles cleanly)
 * @param b  the second resolved type (mangles cleanly)
 * @return   true iff `mangle(a)` equals `mangle(b)` byte-for-byte
 */
fn cg_mangle_bytes_eq(a: checker::Type, b: checker::Type) -> bool {
    match a {
        checker::Named as na => cg_mangle_type_matches_name(b, na.name)
        checker::Slice as sa => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice as sb => cg_mangle_bytes_eq(sa.element, sb.element)
            _ => false
        }
        _ => match b {
            checker::Named as nb => cg_mangle_type_matches_name(a, nb.name)
            checker::Slice => false
            _ => cg_leaf_literal_eq(a, b)
        }
    }
}

/**
 * Compare two FIXED leaf types (`Prim`, `Byte`, `Char`, `Str`, `Error`) by their mangle literal.
 * These literals are compile-time constants (no allocation) and never error, so the `str`
 * comparison is a pure byte compare of two literals.
 *
 * @param a  the first fixed-leaf type
 * @param b  the second fixed-leaf type
 * @return   true iff both mangle to the same fixed literal
 */
fn cg_leaf_literal_eq(a: checker::Type, b: checker::Type) -> bool {
    match cg_opt_mangle_str(a) {
        str as sa => match cg_opt_mangle_str(b) { str as sb => sa == sb; error => false }
        error => false
    }
}

/**
 * Report whether a cleanly-mangling type's full mangle equals the bare last segment of `name`,
 * byte-for-byte and allocation-free. Walks `t` while advancing a cursor over `name`'s last
 * `::`-segment: a match holds exactly when the walk consumes the segment to its end and no further.
 *
 * @param t     the resolved type whose mangle is folded against the segment
 * @param name  the (possibly canonical) name whose bare last segment is the target text
 * @return      true iff `mangle(t)` equals `name`'s last segment byte-for-byte
 */
fn cg_mangle_type_matches_name(t: checker::Type, name: str) -> bool {
    let start = cg_name_last_segment_offset(name)
    let end = cg_mangle_consume(t, name, start)
    end >= 0 && (end to u64) == name.len
}
