/** split 7/8 from codegen_test.tkt — mechanical, pure reorg, no logic changes. */
use teko::checker
use teko::lexer
use teko::parser

fn cgt_mangle_eq() {
    let i32t: checker::Type = checker::Prim { kind = checker::PrimKind::I32 }
    let u8t: checker::Type = checker::Prim { kind = checker::PrimKind::U8 }
    let strt: checker::Type = checker::Str { }
    let named_str: checker::Type = checker::Named { name = "str" }
    let reader_io: checker::Type = checker::Named { name = "teko::io::Reader" }
    let reader_emit: checker::Type = checker::Named { name = "teko::emit::Reader" }
    let writer: checker::Type = checker::Named { name = "teko::io::Writer" }
    let slice_str: checker::Type = checker::Slice { element = strt }
    let slice_str2: checker::Type = checker::Slice { element = checker::Str { } }
    let named_slice_str: checker::Type = checker::Named { name = "slice_str" }
    let slice_reader_a: checker::Type = checker::Slice { element = reader_io }
    let slice_reader_b: checker::Type = checker::Slice { element = reader_emit }
    let slice_i64: checker::Type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
    mut va_members: []checker::Type = teko::list::empty()
    va_members = teko::list::push(va_members, i32t)
    va_members = teko::list::push(va_members, u8t)
    let variant_a: checker::Type = checker::Variant { members = va_members }
    mut vb_members: []checker::Type = teko::list::empty()
    vb_members = teko::list::push(vb_members, strt)
    vb_members = teko::list::push(vb_members, i32t)
    let variant_b: checker::Type = checker::Variant { members = vb_members }

    teko::assert::is_true(cg_mangle_eq(i32t, i32t))
    teko::assert::is_false(cg_mangle_eq(i32t, u8t))
    teko::assert::is_true(cg_mangle_eq(reader_io, reader_emit))
    teko::assert::is_false(cg_mangle_eq(reader_io, writer))
    teko::assert::is_true(cg_mangle_eq(slice_str, slice_str2))
    teko::assert::is_false(cg_mangle_eq(slice_str, slice_i64))
    teko::assert::is_true(cg_mangle_eq(named_slice_str, slice_str))
    teko::assert::is_true(cg_mangle_eq(strt, named_str))
    teko::assert::is_true(cg_mangle_eq(slice_reader_a, slice_reader_b))
    teko::assert::is_true(cg_mangle_eq(variant_a, variant_b))
    teko::assert::is_false(cg_mangle_eq(variant_a, i32t))

    teko::assert::is_true(cg_opt_key(i32t) == cg_opt_key(i32t))
    teko::assert::is_false(cg_opt_key(i32t) == cg_opt_key(u8t))
    teko::assert::is_true(cg_opt_key(reader_io) == cg_opt_key(reader_emit))
    teko::assert::is_false(cg_opt_key(reader_io) == cg_opt_key(writer))
    teko::assert::is_true(cg_opt_key(slice_str) == cg_opt_key(slice_str2))
    teko::assert::is_false(cg_opt_key(slice_str) == cg_opt_key(slice_i64))
    teko::assert::is_true(cg_opt_key(named_slice_str) == cg_opt_key(slice_str))
    teko::assert::is_true(cg_opt_key(strt) == cg_opt_key(named_str))
    teko::assert::is_true(cg_opt_key(slice_reader_a) == cg_opt_key(slice_reader_b))
    teko::assert::is_true(cg_opt_key(variant_a) == cg_opt_key(variant_b))
    teko::assert::is_false(cg_opt_key(variant_a) == cg_opt_key(i32t))
}

/**
 * cgt_dedup_key_cache — AL4a-3: `CgTypeSet` stores each registered type's mangled key at insertion
 * so dedup scans READ the cached key instead of recomputing it. Proves the cache is faithful and
 * the dedup relation is unchanged: (1) each parallel `*_keys` array stays exactly as long as its
 * type array; (2) every cached key byte-equals the freshly recomputed key (`cg_opt_key` /
 * `cg_variant_key`) — the identical string the scans compared before; (3) a mangle-equal duplicate
 * still collapses (no growth) while a distinct type appends one entry alongside its key.
 * `inners`/`opt_keys` are RETIRED (the null-as-union pivot dropped the nullable former) and stay
 * permanently empty — not exercised here.
 */
#test

fn cgt_dedup_key_cache() {
    let strt: checker::Type = checker::Str { }
    let i64t: checker::Type = checker::Prim { kind = checker::PrimKind::I64 }
    mut set = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }

    set = cg_slice_add(set, strt)
    set = cg_slice_add(set, strt)
    teko::assert::is_true(set.slices.len == 1)
    teko::assert::is_true(set.slice_keys.len == set.slices.len)
    teko::assert::is_true(set.slice_keys[0] == cg_opt_key(set.slices[0]))

    mut va_members: []checker::Type = teko::list::empty()
    va_members = teko::list::push(va_members, i64t)
    va_members = teko::list::push(va_members, strt)
    let variant_a: checker::Type = checker::Variant { members = va_members }
    set = cg_variant_add(set, variant_a)
    set = cg_variant_add(set, variant_a)
    teko::assert::is_true(set.variants.len == 1)
    teko::assert::is_true(set.variant_keys.len == set.variants.len)
    teko::assert::is_true(set.variant_keys[0] == cg_variant_key(set.variants[0]))
}

/**
 * Build a two-member union `{ a, b }` — the shape the C4 niche/box classifiers gate on.
 *
 * @param a  the first union member
 * @param b  the second union member
 * @return   the resolved `Variant` with members `[a, b]`
 */
fn cgt_var2(a: checker::Type, b: checker::Type) -> checker::Variant {
    mut ms: []checker::Type = teko::list::empty()
    ms = teko::list::push(ms, a)
    ms = teko::list::push(ms, b)
    checker::Variant { members = ms }
}

/**
 * cgt_pair16_decl — a two-`i64`-field struct TypeDecl (`Pair16`), a real by-value 16-byte
 * aggregate — the ≥16-byte no-niche test vehicle standing in for the removed scalar `u64`
 * (drop-128, 2026-07-24). Unlike `Func` (unsupported by `cg_opt_mangle`, so `cg_mangle_eq`
 * would spuriously treat it as "equal" to the enclosing union in `cg_union_inline_recursive`'s
 * both-error fallback), a real struct mangles cleanly, matching the `repr_box` regression
 * fixture's own `Vec2` vehicle for the identical box-in-arena scenario.
 *
 * @return  the `Pair16` struct TypeDecl (two `i64` fields, `x`/`y`)
 */
fn cgt_pair16_decl() -> parser::TypeDecl {
    let fx = parser::Field { name = "x"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    let fy = parser::Field { name = "y"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    let fields: []parser::Field = teko::list::push(teko::list::push(teko::list::empty(), fx), fy)
    let body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }
    parser::TypeDecl { name = "Pair16"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = false }
}

/**
 * cgt_prog_with_pair16 — an INDEXED emitter program whose sole item is the `Pair16` struct
 * TypeDecl, so `cg_find_decl`/`cg_named_min_bytes` resolve it when the union classifiers probe
 * its size. It hands back the emitter's own `CgProg` (via `cg_prog_of`) because that is the
 * shape those classifiers take.
 *
 * @return  an indexed emitter program carrying exactly the `Pair16` TypeDecl
 */
fn cgt_prog_with_pair16() -> CgProg {
    let items: []checker::TItem = teko::list::push(teko::list::empty(), cgt_pair16_decl())
    cg_prog_of(checker::TProgram { items = items })
}

/**
 * The `Pair16 | null` union — no niche, a saturating 16-byte payload (the box-in-arena class).
 *
 * @return  the resolved `Pair16 | null` variant
 */
fn cgt_pair16_null() -> checker::Variant {
    cgt_var2(checker::Null { }, checker::Named { name = "Pair16" })
}

fn cgt_pair16_expr() -> checker::TExpr {
    let names: []str = teko::list::push(teko::list::push(teko::list::empty(), "x"), "y")
    let vals: []checker::TExpr = teko::list::push(teko::list::push(teko::list::empty(), cgt_num_i64(1)), cgt_num_i64(2))
    checker::TExpr {
        kind = checker::TStructInit { field_names = names; field_vals = vals }
        type = checker::Named { name = "Pair16" }
        line = 0; col = 0
    }
}

/**
 * The `i32 | null` union — a saturating scalar < 16 bytes (the inline-tag class).
 *
 * @return  the resolved `i32 | null` variant
 */
fn cgt_i32_null() -> checker::Variant {
    cgt_var2(checker::Null { }, checker::Prim { kind = checker::PrimKind::I32 })
}

/**
 * The `ptr | null` union — a niche-able handle (the niche class).
 *
 * @return  the resolved `ptr | null` variant
 */
fn cgt_ptr_null() -> checker::Variant {
    cgt_var2(checker::Null { }, checker::Ptr { inner = null })
}

/**
 * Assert `union_repr_class` picks the right physical representation per member class and the
 * `#inline` force flag: `Pair16|null` boxes by default and forces to inline-tag; `i32|null` is
 * inline-tag; a niche-able `ptr|null` is niche regardless of the force flag.
 */
#test

fn cgt_union_repr_class_dial() {
    let p = cgt_prog_with_pair16()
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), false) { UnionRepr::BoxInArena => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), true) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_i32_null(), false) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), false) { UnionRepr::Niche => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), true) { UnionRepr::Niche => true; _ => false })
}

#test

fn cgt_boxed_union_wrap_uses_requested_local_region() {
    let p = cgt_prog_with_pair16()
    let expected: checker::Type = cgt_pair16_null()
    let wrapped = match emit_as_r_in(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), "_tkbr0", teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(_tkbr0, sizeof("))
}

#test

fn cgt_boxed_union_wrap_defaults_to_root_region() {
    let p = cgt_prog_with_pair16()
    let expected: checker::Type = cgt_pair16_null()
    let wrapped = match emit_as_r(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(tk_region_root(), sizeof("))
}

/**
 * Assert `inline_attr_eligible` accepts a boxed `Pair16|null` and rejects each ineligible class
 * with an error: a non-sum (`i32`), an already-inline sum (`i32|null`), and a niche-able sum
 * (`ptr|null`).
 */
#test

fn cgt_inline_attr_eligible_classes() {
    let p = cgt_prog_with_pair16()
    let pairbox: checker::Type = cgt_pair16_null()
    teko::assert::is_true(match inline_attr_eligible(p, pairbox) { error => false; null => true })
    teko::assert::is_true(match inline_attr_eligible(p, checker::Prim { kind = checker::PrimKind::I32 }) { error => true; null => false })
    let i32inline: checker::Type = cgt_i32_null()
    teko::assert::is_true(match inline_attr_eligible(p, i32inline) { error => true; null => false })
    let ptrniche: checker::Type = cgt_ptr_null()
    teko::assert::is_true(match inline_attr_eligible(p, ptrniche) { error => true; null => false })
}

/**
 * One (namespace, name) pair the C and native manglers must spell identically.
 */
type CgtManglePair = struct {
    /** The declaring namespace, "" for a lifted lambda. */
    ns: str
    /** The bare function name. */
    name: str
}

/**
 * The pairs `cgt_mangle_parity_c_and_native` compares: a deep namespace, a bare-root namespace,
 * the empty namespace, and a name that collides with a C keyword (so the escape is compared too).
 *
 * @return  the parity cases, in a fixed order
 */
fn cgt_mangle_parity_pairs() -> []CgtManglePair {
    mut xs: []CgtManglePair = teko::list::empty()
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::checker"; name = "type_eq" })
    xs = teko::list::push(xs, CgtManglePair { ns = "demo"; name = "add" })
    xs = teko::list::push(xs, CgtManglePair { ns = ""; name = "lifted" })
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::math"; name = "div" })
    xs
}

/**
 * Assert the C backend's `cb_fn_name` and the native backend's `teko::lir::mangle_fn_symbol` emit
 * the SAME symbol for the same (namespace, name), and that each one carries the `teko_` user
 * prefix — the invariant that keeps a program's C-emitted and natively-emitted symbols
 * interchangeable, and keeps every user symbol out of the runtime's `tk_` family.
 */
#test

fn cgt_mangle_parity_c_and_native() {
    let pairs = cgt_mangle_parity_pairs()
    mut i: u64 = 0
    loop {
        if i >= pairs.len { break }
        let c_side = str(cb_fn_name(cgt_empty(), pairs[i].ns, pairs[i].name))
        let native_side = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name)
        teko::assert::is_true(c_side == native_side)
        teko::assert::is_true(teko::str::slice_to(c_side, TEKO_USER_PREFIX.len) == TEKO_USER_PREFIX)
        i++
    }
}

/**
 * The native mangler's `abi=c`-adjacent static/shared-archive carve-out (`mangle_fn_symbol`'s
 * `flat` argument, `emit_static_lib`'s `flat_symbols = true`): `flat` strips EXACTLY
 * `TEKO_USER_PREFIX`, changing nothing else about the mangle — every pair's `flat` spelling is
 * the SAME prefixed spelling with that one prefix removed.
 *
 * There is no `cb_fn_name` counterpart to compare against here (unlike
 * `cgt_mangle_parity_c_and_native` above): a static/shared archive is an own-native-ONLY
 * artifact kind (`emit_static_lib` — the C backend never builds one), and the C backend's OWN
 * externally-published name for its `abi = "c"` reverse-FFI export is the SEPARATE
 * `cg_c_export_symbol`/`flatten_canonical` (a single-underscore join with no `TEKO_USER_PREFIX`
 * to begin with, and no `cb_fn_name` involvement at all — the wrapper's forward call keeps using
 * `cb_fn_name` UN-carved, see `ffx_wrappers_forward_to_internal`). `cb_fn_name` itself carries no
 * `flat` mode, and needs none.
 *
 * The concrete regression this guards: `examples/toolchain/ar_link_run` (KP16's static archive)
 * failed its real host `ar`/`nm`/`ld` link+run before this fix — the archive published
 * `teko_ar_link_run__add`, but the consumer's `extern long long ar_link_run__add(...)` needed
 * exactly `ar_link_run__add`.
 */
#test
