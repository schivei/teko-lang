// ---------------------------------------------------------------------------
// Original invariant tests (kept from initial version)
// ---------------------------------------------------------------------------

/**
 * cgt_class_decl — a minimal `parser::TypeDecl` naming a class of a given `ClassKind`, optionally
 * extending a bare base, with NO members. It carries exactly the surface the polymorphic-base vtable
 * gate (`cg_pair_is_base_vtable`) inspects — the class kind (`cg_is_polymorphic_base` /
 * `cg_class_is_abstract`) and the base chain (`cg_subclass_reaches`) — so a self-vtable-eligibility
 * test needs no methods, fields, or consts.
 *
 * @param name       the class's bare name
 * @param kind       the class's `ClassKind` (Sealed / Abstract / Virtual)
 * @param has_base   whether the class extends a base
 * @param base_name  the extended base's bare name (consulted only when `has_base`)
 * @return           a member-less class `parser::TypeDecl`
 */
fn cgt_class_decl(name: str, kind: parser::ClassKind, has_base: bool, base_name: str): parser::TypeDecl {
    parser::TypeDecl {
        name = name
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        body = parser::ClassBody {
            kind = kind
            has_base = has_base
            base_name = base_name
            has_base_binding = false
            base_binding_name = ""
            implements = teko::list::empty()
            fields = teko::list::empty()
            methods = teko::list::empty()
            consts = teko::list::empty()
            is_service = false
            service_lifetime = parser::ServiceLifetime::Singleton
        }
        vis = parser::Visibility::Pub
        has_doc = false
        doc = ""
        line = 0; col = 0
    }
}

/**
 * cgt_vtable_pair_gate_excludes_abstract_self — the polymorphic-base vtable gate skips an ABSTRACT
 * base's own self-pair (its abstract methods stamp to no function, so a self-vtable is unemittable),
 * while STILL emitting a concrete subclass's `tk_vt_<Sub>_<Base>` AND a directly-instantiable
 * `virtual` base's own self-vtable (#594, member-const cross-ns abstract-base codegen fix). This is
 * the regression that member_const_cross_ns_pub_inherit exposed: codegen failed with a phantom
 * "missing a vtable method's stamped function" on the abstract base's self-pair.
 */
#test
fn cgt_vtable_pair_gate_excludes_abstract_self() {
    var parent = cgt_class_decl("Base", parser::ClassKind::Abstract, false, "")
    var sub = cgt_class_decl("Sub", parser::ClassKind::Sealed, true, "Base")
    var vbase = cgt_class_decl("VBase", parser::ClassKind::Virtual, false, "")
    var items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, parent)
    items = teko::list::push(items, sub)
    items = teko::list::push(items, vbase)
    var prog = cg_prog_of(checker::TProgram { items = items })

    teko::assert::is_true(cg_class_is_abstract(parent))
    teko::assert::is_true(!cg_class_is_abstract(sub))
    teko::assert::is_true(!cg_class_is_abstract(vbase))

    teko::assert::is_true(!cg_pair_is_base_vtable(prog, parent, parent))
    teko::assert::is_true(cg_pair_is_base_vtable(prog, sub, parent))
    teko::assert::is_true(cg_pair_is_base_vtable(prog, vbase, vbase))
}

/**
 * cgt_mangle_eq — the byte-free `cg_mangle_eq` (AL4a-2) decides identical-C-name exactly as the
 * retired string compare `cg_opt_key(a) == cg_opt_key(b)` did. Every case double-checks the
 * expected boolean AND that `cg_mangle_eq` agrees with that string oracle, proving the refactor
 * is behavior-preserving. Covers: same-shape equal/unequal; two DISTINCT `Named` that mangle
 * EQUAL because they share a bare last segment (#109 `teko::io::Reader` vs `teko::emit::Reader`);
 * a `Named` whose text coincides with a composite's rendered form (`Named "slice_str"` vs
 * `[]str`, both mangle to `slice_str`) — distinct types, equal mangle; a fixed leaf vs a
 * same-text `Named` (`str` vs `Named "str"`); erroring types (inline `Variant`, both map to the
 * empty key `""`); and distinct types that mangle DIFFERENTLY.
 */
#test
fn cgt_mangle_eq() {
    var i32t: checker::Type = checker::Prim { kind = checker::PrimKind::I32 }
    var u8t: checker::Type = checker::Prim { kind = checker::PrimKind::U8 }
    var strt: checker::Type = checker::Str { }
    var named_str: checker::Type = checker::Named { name = "str" }
    var reader_io: checker::Type = checker::Named { name = "teko::io::Reader" }
    var reader_emit: checker::Type = checker::Named { name = "teko::emit::Reader" }
    var writer: checker::Type = checker::Named { name = "teko::io::Writer" }
    var slice_str: checker::Type = checker::Slice { element = strt }
    var slice_str2: checker::Type = checker::Slice { element = checker::Str { } }
    var named_slice_str: checker::Type = checker::Named { name = "slice_str" }
    var slice_reader_a: checker::Type = checker::Slice { element = reader_io }
    var slice_reader_b: checker::Type = checker::Slice { element = reader_emit }
    var slice_i64: checker::Type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
    var va_members: []checker::Type = teko::list::empty()
    va_members = teko::list::push(va_members, i32t)
    va_members = teko::list::push(va_members, u8t)
    var variant_a: checker::Type = checker::Variant { members = va_members }
    var vb_members: []checker::Type = teko::list::empty()
    vb_members = teko::list::push(vb_members, strt)
    vb_members = teko::list::push(vb_members, i32t)
    var variant_b: checker::Type = checker::Variant { members = vb_members }

    teko::assert::is_true(cg_mangle_eq(i32t, i32t))
    teko::assert::is_false(cg_mangle_eq(i32t, u8t))
    teko::assert::is_true(cg_mangle_eq(reader_io, reader_emit))
    teko::assert::is_false(cg_mangle_eq(reader_io, writer))
    teko::assert::is_true(cg_mangle_eq(slice_str, slice_str2))
    teko::assert::is_false(cg_mangle_eq(slice_str, slice_i64))
    teko::assert::is_true(cg_mangle_eq(named_slice_str, slice_str))
    teko::assert::is_true(cg_mangle_eq(strt, named_str))
    teko::assert::is_true(cg_mangle_eq(slice_reader_a, slice_reader_b))
    teko::assert::is_true(cg_mangle_eq(variant_a, variant_b))
    teko::assert::is_false(cg_mangle_eq(variant_a, i32t))

    teko::assert::is_true(cg_opt_key(i32t) == cg_opt_key(i32t))
    teko::assert::is_false(cg_opt_key(i32t) == cg_opt_key(u8t))
    teko::assert::is_true(cg_opt_key(reader_io) == cg_opt_key(reader_emit))
    teko::assert::is_false(cg_opt_key(reader_io) == cg_opt_key(writer))
    teko::assert::is_true(cg_opt_key(slice_str) == cg_opt_key(slice_str2))
    teko::assert::is_false(cg_opt_key(slice_str) == cg_opt_key(slice_i64))
    teko::assert::is_true(cg_opt_key(named_slice_str) == cg_opt_key(slice_str))
    teko::assert::is_true(cg_opt_key(strt) == cg_opt_key(named_str))
    teko::assert::is_true(cg_opt_key(slice_reader_a) == cg_opt_key(slice_reader_b))
    teko::assert::is_true(cg_opt_key(variant_a) == cg_opt_key(variant_b))
    teko::assert::is_false(cg_opt_key(variant_a) == cg_opt_key(i32t))
}

/**
 * cgt_dedup_key_cache — AL4a-3: `CgTypeSet` stores each registered type's mangled key at insertion
 * so dedup scans READ the cached key instead of recomputing it. Proves the cache is faithful and
 * the dedup relation is unchanged: (1) each parallel `*_keys` array stays exactly as long as its
 * type array; (2) every cached key byte-equals the freshly recomputed key (`cg_opt_key` /
 * `cg_variant_key`) — the identical string the scans compared before; (3) a mangle-equal duplicate
 * still collapses (no growth) while a distinct type appends one entry alongside its key.
 * `inners`/`opt_keys` are RETIRED (the null-as-union pivot dropped the nullable former) and stay
 * permanently empty — not exercised here.
 */
#test
fn cgt_dedup_key_cache() {
    var strt: checker::Type = checker::Str { }
    var i64t: checker::Type = checker::Prim { kind = checker::PrimKind::I64 }
    var set = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }

    set = cg_slice_add(set, strt)
    set = cg_slice_add(set, strt)
    teko::assert::is_true(set.slices.len == 1)
    teko::assert::is_true(set.slice_keys.len == set.slices.len)
    teko::assert::is_true(set.slice_keys[0] == cg_opt_key(set.slices[0]))

    var va_members: []checker::Type = teko::list::empty()
    va_members = teko::list::push(va_members, i64t)
    va_members = teko::list::push(va_members, strt)
    var variant_a: checker::Type = checker::Variant { members = va_members }
    set = cg_variant_add(set, variant_a)
    set = cg_variant_add(set, variant_a)
    teko::assert::is_true(set.variants.len == 1)
    teko::assert::is_true(set.variant_keys.len == set.variants.len)
    teko::assert::is_true(set.variant_keys[0] == cg_variant_key(set.variants[0]))
}

/**
 * Build a two-member union `{ a, b }` — the shape the C4 niche/box classifiers gate on.
 *
 * @param a  the first union member
 * @param b  the second union member
 * @return   the resolved `Variant` with members `[a, b]`
 */
fn cgt_var2(a: checker::Type, b: checker::Type): checker::Variant {
    var ms: []checker::Type = teko::list::empty()
    ms = teko::list::push(ms, a)
    ms = teko::list::push(ms, b)
    checker::Variant { members = ms }
}

/**
 * cgt_pair16_decl — a two-`i64`-field struct TypeDecl (`Pair16`), a real by-value 16-byte
 * aggregate — the ≥16-byte no-niche test vehicle standing in for the removed scalar `u64`
 * (drop-128, 2026-07-24). Unlike `Func` (unsupported by `cg_opt_mangle`, so `cg_mangle_eq`
 * would spuriously treat it as "equal" to the enclosing union in `cg_union_inline_recursive`'s
 * both-error fallback), a real struct mangles cleanly, matching the `repr_box` regression
 * fixture's own `Vec2` vehicle for the identical box-in-arena scenario.
 *
 * @return  the `Pair16` struct TypeDecl (two `i64` fields, `x`/`y`)
 */
fn cgt_pair16_decl(): parser::TypeDecl {
    var fx = parser::Field { name = "x"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = ""; is_readonly = false }
    var fy = parser::Field { name = "y"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = ""; is_readonly = false }
    var fields: []parser::Field = teko::list::push(teko::list::push(teko::list::empty(), fx), fy)
    var body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }
    parser::TypeDecl { name = "Pair16"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0}
}

/**
 * cgt_prog_with_pair16 — an INDEXED emitter program whose sole item is the `Pair16` struct
 * TypeDecl, so `cg_find_decl`/`cg_named_min_bytes` resolve it when the union classifiers probe
 * its size. It hands back the emitter's own `CgProg` (via `cg_prog_of`) because that is the
 * shape those classifiers take.
 *
 * @return  an indexed emitter program carrying exactly the `Pair16` TypeDecl
 */
fn cgt_prog_with_pair16(): CgProg {
    var items: []checker::TItem = teko::list::push(teko::list::empty(), cgt_pair16_decl())
    cg_prog_of(checker::TProgram { items = items })
}

/**
 * The `Pair16 | null` union — no niche, a saturating 16-byte payload (the box-in-arena class).
 *
 * @return  the resolved `Pair16 | null` variant
 */
fn cgt_pair16_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Named { name = "Pair16" })
}

fn cgt_pair16_expr(): checker::TExpr {
    var names: []str = teko::list::push(teko::list::push(teko::list::empty(), "x"), "y")
    var vals: []checker::TExpr = teko::list::push(teko::list::push(teko::list::empty(), cgt_num_i64(1)), cgt_num_i64(2))
    checker::TExpr {
        kind = checker::TStructInit { field_names = names; field_vals = vals }
        type = checker::Named { name = "Pair16" }
        line = 0; col = 0
    }
}

/**
 * The `i32 | null` union — a saturating scalar < 16 bytes (the inline-tag class).
 *
 * @return  the resolved `i32 | null` variant
 */
fn cgt_i32_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Prim { kind = checker::PrimKind::I32 })
}

/**
 * The `ptr | null` union — a niche-able handle (the niche class).
 *
 * @return  the resolved `ptr | null` variant
 */
fn cgt_ptr_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Ptr { inner = null })
}

/**
 * Assert `union_repr_class` picks the right physical representation per member class and the
 * `#inline` force flag: `Pair16|null` boxes by default and forces to inline-tag; `i32|null` is
 * inline-tag; a niche-able `ptr|null` is niche regardless of the force flag.
 */
#test
fn cgt_union_repr_class_dial() {
    var p = cgt_prog_with_pair16()
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), false) { UnionRepr::BoxInArena => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), true) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_i32_null(), false) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), false) { UnionRepr::Niche => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), true) { UnionRepr::Niche => true; _ => false })
}

#test
fn cgt_boxed_union_wrap_uses_requested_local_region() {
    var p = cgt_prog_with_pair16()
    var expected: checker::Type = cgt_pair16_null()
    var wrapped = match emit_as_r_in(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), "_tkbr0", teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(_tkbr0, sizeof("))
}

#test
fn cgt_boxed_union_wrap_defaults_to_root_region() {
    var p = cgt_prog_with_pair16()
    var expected: checker::Type = cgt_pair16_null()
    var wrapped = match emit_as_r(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(tk_region_root(), sizeof("))
}

/**
 * Assert `inline_attr_eligible` accepts a boxed `Pair16|null` and rejects each ineligible class
 * with an error: a non-sum (`i32`), an already-inline sum (`i32|null`), and a niche-able sum
 * (`ptr|null`).
 */
#test
fn cgt_inline_attr_eligible_classes() {
    var p = cgt_prog_with_pair16()
    var pairbox: checker::Type = cgt_pair16_null()
    teko::assert::is_true(match inline_attr_eligible(p, pairbox) { error => false; null => true })
    teko::assert::is_true(match inline_attr_eligible(p, checker::Prim { kind = checker::PrimKind::I32 }) { error => true; null => false })
    var i32inline: checker::Type = cgt_i32_null()
    teko::assert::is_true(match inline_attr_eligible(p, i32inline) { error => true; null => false })
    var ptrniche: checker::Type = cgt_ptr_null()
    teko::assert::is_true(match inline_attr_eligible(p, ptrniche) { error => true; null => false })
}

/**
 * One (namespace, name) pair the C and native manglers must spell identically.
 */
type CgtManglePair = struct {
    /** The declaring namespace, "" for a lifted lambda. */
    ns: str
    /** The bare function name. */
    name: str
}

/**
 * The pairs `cgt_mangle_parity_c_and_native` compares: a deep namespace, a bare-root namespace,
 * the empty namespace, and a name that collides with a C keyword (so the escape is compared too).
 *
 * @return  the parity cases, in a fixed order
 */
fn cgt_mangle_parity_pairs(): []CgtManglePair {
    var xs: []CgtManglePair = teko::list::empty()
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::checker"; name = "type_eq" })
    xs = teko::list::push(xs, CgtManglePair { ns = "demo"; name = "add" })
    xs = teko::list::push(xs, CgtManglePair { ns = ""; name = "lifted" })
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::math"; name = "div" })
    xs
}

/**
 * Assert the C backend's `cb_fn_name` and the native backend's `teko::lir::mangle_fn_symbol` emit
 * the SAME symbol for the same (namespace, name), and that each one carries the `teko_` user
 * prefix — the invariant that keeps a program's C-emitted and natively-emitted symbols
 * interchangeable, and keeps every user symbol out of the runtime's `tk_` family.
 */
#test
fn cgt_mangle_parity_c_and_native() {
    var pairs = cgt_mangle_parity_pairs()
    var i: u64 = 0
    loop {
        if i >= pairs.len { break }
        var c_side = str(cb_fn_name(cgt_empty(), pairs[i].ns, pairs[i].name))
        var native_side = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name)
        teko::assert::is_true(c_side == native_side)
        teko::assert::is_true(teko::str::slice_to(c_side, TEKO_USER_PREFIX.len) == TEKO_USER_PREFIX)
        i++
    }
}

/**
 * The native mangler's `abi=c`-adjacent static/shared-archive carve-out (`mangle_fn_symbol`'s
 * `flat` argument, `emit_static_lib`'s `flat_symbols = true`): `flat` strips EXACTLY
 * `TEKO_USER_PREFIX`, changing nothing else about the mangle — every pair's `flat` spelling is
 * the SAME prefixed spelling with that one prefix removed.
 *
 * There is no `cb_fn_name` counterpart to compare against here (unlike
 * `cgt_mangle_parity_c_and_native` above): a static/shared archive is an own-native-ONLY
 * artifact kind (`emit_static_lib` — the C backend never builds one), and the C backend's OWN
 * externally-published name for its `abi = "c"` reverse-FFI export is the SEPARATE
 * `cg_c_export_symbol`/`flatten_canonical` (a single-underscore join with no `TEKO_USER_PREFIX`
 * to begin with, and no `cb_fn_name` involvement at all — the wrapper's forward call keeps using
 * `cb_fn_name` UN-carved, see `ffx_wrappers_forward_to_internal`). `cb_fn_name` itself carries no
 * `flat` mode, and needs none.
 *
 * The concrete regression this guards: `examples/toolchain/ar_link_run` (KP16's static archive)
 * failed its real host `ar`/`nm`/`ld` link+run before this fix — the archive published
 * `teko_ar_link_run__add`, but the consumer's `extern long long ar_link_run__add(...)` needed
 * exactly `ar_link_run__add`.
 */
#test
fn cgt_mangle_native_flat_strips_prefix_only() {
    var pairs = cgt_mangle_parity_pairs()
    var i: u64 = 0
    loop {
        if i >= pairs.len { break }
        var prefixed = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name)
        var flat = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name, true)
        teko::assert::is_true(prefixed == teko::str::concat(TEKO_USER_PREFIX, flat))
        i++
    }
    teko::assert::is_true(teko::lir::mangle_fn_symbol("ar_link_run", "add", true) == "ar_link_run__add")
}

/**
 * Assert the mangle spells the whole symbol, not just its prefix: a namespaced function keeps its
 * `::`-to-`__` namespace mangle behind the user prefix, and an un-namespaced (lifted) one is the
 * prefix plus the bare name.
 */
#test
fn cgt_mangle_spells_prefix_namespace_and_name() {
    teko::assert::is_true(str(cb_fn_name(cgt_empty(), "teko::checker", "type_eq")) == "teko_teko__checker__type_eq")
    teko::assert::is_true(str(cb_fn_name(cgt_empty(), "", "lifted")) == "teko_lifted")
}

/**
 * A call node with a resolved namespace and a bare callee name, for the origin-namespace tests.
 *
 * @param ns    the resolved namespace ("" when the checker resolved no declaration)
 * @param name  the callee's bare name
 * @return      the call node
 */
fn cgt_call_ns(ns: str, name: str): checker::TCall {
    checker::TCall { overload_suffix = "";
        callee = cgt_path1(name); args = teko::list::empty(); call_ns = ns
        is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
}

/**
 * A program declaring `probe::mine::arena_push` (a real body) and `probe::sys::getpid` (an
 * `extern fn`) — the two shapes `cg_call_is_user_declared` has to tell apart.
 *
 * @return  the indexed emitter program
 */
fn cgt_prog_with_colliding_names(): CgProg {
    var items: []checker::TItem = teko::list::empty()
    items = teko::list::push(items, cgt_fn0("arena_push", "probe::mine", checker::Void { }, cgt_empty_stmts()))
    var ext = cgt_fn0("getpid", "probe::sys", checker::Void { }, cgt_empty_stmts())
    items = teko::list::push(items, checker::TFunction { overload_suffix = "";
            name = ext.name; type_params = ext.type_params; type_constraints = ext.type_constraints
            namespace = ext.namespace; params = ext.params; return_type = ext.return_type; body = ext.body
            vis = ext.vis; has_doc = ext.has_doc; doc = ext.doc; file = ext.file; line = ext.line; col = ext.col
            is_test = ext.is_test; is_extern = true; c_symbol = "getpid"; from_lib = "c"
            has_arena_size = ext.has_arena_size; arena_size = ext.arena_size; ret_extra = ext.ret_extra })
    cg_prog_of(checker::TProgram { items = items })
}

/**
 * Assert a call the checker RESOLVED to a DECLARED body is never mistaken for a builtin, even when
 * its bare name IS one: `cg_call_is_user_declared` answers `true` for the user's `arena_push` (user
 * code owns the symbol) and `false` for the unresolved builtin call. This is the predicate that
 * stopped the emitter from silently swapping a user body for the runtime's `tk_arena_push`.
 *
 * The two callees that carry a namespace and are still NOT declarations answer `false` as well: an
 * `extern fn` (which must reach its foreign symbol and the host-FFI lifters) and a `teko::mem`
 * builtin (whose `call_ns` the checker stamps synthetically, with no declaration behind it).
 */
#test
fn cgt_user_declared_beats_a_bare_builtin_name() {
    var prog = cgt_prog_with_colliding_names()
    teko::assert::is_true(cg_call_is_user_declared(prog, cgt_call_ns("probe::mine", "arena_push")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("", "arena_push")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("probe::sys", "getpid")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("teko::mem", "free")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("", "println")))
}

/**
 * cgt_test_fn — a `#test` item named `ns::name`, the one item shape the gate harness emits for.
 *
 * @param name  the test's own name (the mangled symbol's tail)
 * @param ns    the test's namespace (the mangled symbol's head)
 * @return      the `#test` function node
 */
fn cgt_test_fn(name: str, ns: str): checker::TFunction {
    var fn0 = cgt_fn0(name, ns, checker::Void { }, cgt_empty_stmts())
    checker::TFunction { overload_suffix = "";
        name = fn0.name; type_params = fn0.type_params; type_constraints = fn0.type_constraints
        namespace = fn0.namespace; params = fn0.params; return_type = fn0.return_type; body = fn0.body
        vis = fn0.vis; has_doc = fn0.has_doc; doc = fn0.doc; file = fn0.file; line = fn0.line; col = fn0.col
        is_test = true; is_extern = fn0.is_extern; c_symbol = fn0.c_symbol; from_lib = fn0.from_lib
        has_arena_size = fn0.has_arena_size; arena_size = fn0.arena_size; ret_extra = fn0.ret_extra }
}

/**
 * cgt_prog_with_one_test — a program whose single item is one `#test`, so the emitted harness has
 * exactly one invocation to inspect.
 *
 * @return the indexed emitter program
 */
fn cgt_prog_with_one_test(): CgProg {
    var items: []checker::TItem = teko::list::push(teko::list::empty(), cgt_test_fn("cgt_captured_body", "probe::guard"))
    cg_prog_of(checker::TProgram { items = items })
}

/**
 * cgt_captured_run_line — the exact C line the harness must emit to CAPTURE `cgt_captured_body`'s
 * outcome (journal wiring, 0.3.1: the harness used to hand `tk_test_run`'s result straight to
 * `tk_test_report` in one nested call; it now binds it to a local first so it can also branch on
 * `.how` for the journal hooks, before still handing the SAME value to `tk_test_report`).
 *
 * COMPOSED FROM `TEKO_USER_PREFIX` RATHER THAN SPELLED OUT, because a literal would pin the prefix
 * ruling into an assertion that is not about it: the claim here is the SHAPE of the invocation (the
 * address of a top-level function handed to the runtime), and a prefix change would then break this
 * arm for a reason it does not measure.
 *
 * @return  `tk_test_outcome teko_journal_rv = tk_test_run(&<mangled symbol>);`
 */
fn cgt_captured_run_line(): str {
    teko::str::concat("tk_test_outcome teko_journal_rv = tk_test_run(&", TEKO_USER_PREFIX, "probe__guard__cgt_captured_body);")
}

/**
 * cgt_journal_symbol — the C symbol a `teko::journal` function mangles to, composed the SAME way
 * `cb_fn_name` would (namespace-colons to underscores, `__`, bare name) so this file's assertions are
 * not a second, independently-drifting spelling of the mangling rule.
 *
 * @param name  the `teko::journal` function's bare name
 * @return      its mangled C symbol
 */
fn cgt_journal_symbol(name: str): str { teko::str::concat(TEKO_USER_PREFIX, "teko__journal__", name) }

#test
/**
 * cgt_the_harness_runs_every_body_under_capture — the EMITTED half of the test-mode capture (§14).
 *
 * The runtime's own guard (`src/test/capture_test.tkt`) proves that a captured body's panic and exit
 * come back instead of ending the process; this proves the harness ASKS for that — that the emitted
 * invocation captures `tk_test_run(&<symbol>)`'s outcome and still hands it to `tk_test_report`,
 * rather than the bare call plus a blind `tk_test_end()` it replaced long ago. Without this arm the
 * two halves could drift and the suite would still be green, because the runtime half is exercised
 * by an extern that the harness does not emit.
 *
 * The taking of the body's ADDRESS is the whole backend requirement the design names, and it is
 * asserted literally: a `#test` is emitted as `void <symbol>(void)`, so `&<symbol>` is already the
 * `void (*)(void)` the runtime takes — no cast, no thunk, no closure pair.
 *
 * @throws when the invocation is not the captured one, or the arena/channel brackets moved
 */
fn cgt_the_harness_runs_every_body_under_capture() {
    var one = str(emit_test_call(cgt_empty(), cgt_test_fn("cgt_captured_body", "probe::guard"), 0 to u64, false))
    teko::assert::is_true(teko::str::contains(one, cgt_captured_run_line()))
    teko::assert::is_true(teko::str::contains(one, "tk_test_report(teko_journal_rv);"))
    teko::assert::is_true(!teko::str::contains(one, "tk_test_end();"))
    teko::assert::is_true(teko::str::contains(one, "tk_arena_push();"))
    teko::assert::is_true(teko::str::contains(one, "tk_arena_pop();"))
    teko::assert::is_true(teko::str::contains(one, "tk_test_begin("))
}

#test
/**
 * cgt_the_harness_notes_begin_ok_exited_and_panicked_to_the_journal — journal wiring (0.3.1): every
 * `#test` invocation the plain gate emits calls the matching `teko::journal::note_test_*` hook by its
 * mangled symbol — `begin` unconditionally (before the body runs), then exactly one of `ok`/
 * `exited`/`panicked` depending on `teko_journal_rv.how`, with `exited` carrying `.code` verbatim
 * (never re-derived, never re-parsed from a formatted string).
 *
 * @throws when a hook is missing, misnamed, or the exited call does not forward `.code`
 */
fn cgt_the_harness_notes_begin_ok_exited_and_panicked_to_the_journal() {
    var one = str(emit_test_call(cgt_empty(), cgt_test_fn("cgt_captured_body", "probe::guard"), 0 to u64, false))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_begin")))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_ok")))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_panicked")))
    teko::assert::is_true(teko::str::contains(one, teko::str::concat(cgt_journal_symbol("note_test_exited"), "((tk_str){")))
    teko::assert::is_true(teko::str::contains(one, "}, teko_journal_rv.code);"))
    teko::assert::is_true(teko::str::contains(one, "if (teko_journal_rv.how == TK_TEST_OK)"))
    teko::assert::is_true(teko::str::contains(one, "else if (teko_journal_rv.how == TK_TEST_EXITED)"))
}

#test
/**
 * cgt_the_harness_ends_on_the_tally_and_not_on_zero — the gate's status is now COUNTED, not assumed.
 *
 * Before the capture the harness closed with a blind `return 0` and relied on a panicking test
 * killing the process to report a failure; with the capture no test can do that, so a harness that
 * kept `return 0` would report every failing suite as green. This arm is what makes that regression
 * impossible to land silently.
 *
 * BOTH HARNESSES ARE ASSERTED, and the analyze one is the reason this arm grew: it kept the blind
 * `return 0` after the plain one was taught to count, so a failing `#test` under `teko test .
 * --analyzer` was captured, reported as FAILED, and then handed `run_analyzer` a status of 0.
 *
 * ALSO ASSERTS `note_test_end` (journal wiring, 0.3.1) ON BOTH HARNESSES, for the same reason: the
 * close is ONE shared function precisely so neither harness can drift from the other, and a journal
 * segment the analyze harness never closes would falsely read as a shard that died mid-suite.
 *
 * @throws when either harness does not close on the summary, the journal end, and the tally-derived
 *         status
 */
fn cgt_the_harness_ends_on_the_tally_and_not_on_zero() {
    var main_plain = match emit_test_main(cgt_empty(), cgt_prog_with_one_test(), CgMode::TestPlain) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(main_plain, "tk_test_summary();"))
    teko::assert::is_true(teko::str::contains(main_plain, cgt_journal_symbol("note_test_end")))
    teko::assert::is_true(teko::str::contains(main_plain, "return tk_test_any_failed() ? 1 : 0;"))
    teko::assert::is_true(!teko::str::contains(main_plain, "return 0;"))
    var main_analyze = match emit_test_main(cgt_empty(), cgt_prog_with_one_test(), CgMode::TestAnalyze) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(main_analyze, cgt_captured_run_line()))
    teko::assert::is_true(teko::str::contains(main_analyze, "tk_test_summary();"))
    teko::assert::is_true(teko::str::contains(main_analyze, cgt_journal_symbol("note_test_end")))
    teko::assert::is_true(teko::str::contains(main_analyze, "return tk_test_any_failed() ? 1 : 0;"))
    teko::assert::is_true(!teko::str::contains(main_analyze, "return 0;"))
}
