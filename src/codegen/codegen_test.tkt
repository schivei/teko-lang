// src/codegen/codegen_test.tkt — comprehensive unit tests for teko::codegen.
//
// These tests call codegen functions DIRECTLY with hand-built TExpr / TFunction
// nodes to drive coverage of buffer helpers, name mangling, operator tables,
// PrimKind predicates, type emission, and the full emit_function pipeline.
//
// Helper functions use the `cgt_` prefix to avoid last-segment name collision
// with checker_test.tkt helpers (the checker resolves functions by last path segment only).
//
// Original invariant tests (lowers_*) are preserved below the new groups.

use teko::checker
use teko::lexer
use teko::parser

// ---------------------------------------------------------------------------
// Helpers (cgt_ prefix — avoids collision with checker_test.tkt helpers)
// ---------------------------------------------------------------------------

fn cgt_empty(): []byte { teko::list::empty() }
/**
 * cgt_prog — the empty program in codegen's threaded view, indexed exactly as an emission builds it,
 * so every query helper under test takes the same index path the emitter takes.
 *
 * @return the empty `CgProg`
 */
fn cgt_prog(): CgProg { cg_prog_of(checker::TProgram { items = teko::list::empty() }) }

fn cgt_seg(s: str): parser::Segment { parser::Segment { name = s } }
fn cgt_path1(s: str): parser::Path {
    parser::Path { segments = teko::list::push(teko::list::empty(), cgt_seg(s)) }
}
fn cgt_named_te(s: str): parser::TypeExpr {
    parser::NamedType { path = cgt_path1(s); args = teko::list::empty() }
}

fn cgt_num(v: i64, k: checker::PrimKind): checker::TExpr {
    checker::TExpr {
        kind = checker::TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }
        type = checker::Prim { kind = k }
        line = 0; col = 0
    }
}
fn cgt_num_i64(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I64) }
fn cgt_num_i8(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I8) }
fn cgt_num_i32(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I32) }

fn cgt_e_bool_t(): checker::TExpr {
    checker::TExpr {
        kind = checker::TBoolLit { value = true }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
}
fn cgt_e_var(name: str): checker::TExpr {
    checker::TExpr {
        kind = checker::TVar { name = name; is_func = false; func_ns = "" }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
}

fn cgt_stmt(e: checker::TExpr): checker::TStatement { checker::TExprStmt { expr = e } }
fn cgt_ret(e: checker::TExpr): checker::TStatement {
    checker::TReturn { has_value = true; value = e; values = teko::list::empty() }
}
fn cgt_empty_stmts(): []checker::TStatement { teko::list::empty() }

// Build a 0-param TFunction (simplest for emit_function tests)
fn cgt_fn0(name: str, ns: str, ret: checker::Type, body: []checker::TStatement): checker::TFunction {
    checker::TFunction { overload_suffix = "";
        name = name
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        namespace = ns
        params = teko::list::empty()
        return_type = ret
        body = body
        vis = parser::Visibility::Private
        has_doc = false
        doc = ""
        file = ""
        line = 0; col = 0
        is_test = false
        is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty() }
}

// ---------------------------------------------------------------------------
// Group A: Buffer basics — cb, cb_str, cb_byte, cb_i64, cb_to_str
// ---------------------------------------------------------------------------
#test
fn cgt_buffer_basics() {
    var s1 = str(cb(cgt_empty(), "hello"))
    teko::assert::is_true(s1 == "hello")

    var s2 = str(cb_str(cgt_empty(), "world"))
    teko::assert::is_true(s2 == "world")

    var s3 = str(cb_byte(cgt_empty(), b'X'))
    teko::assert::is_true(s3 == "X")

    var s4 = str(cb_i64(cgt_empty(), 0))
    teko::assert::is_true(s4 == "0")

    var s5 = str(cb_i64(cgt_empty(), 99))
    teko::assert::is_true(s5 == "99")

    var s6 = str(cb_i64(cgt_empty(), -7))
    teko::assert::is_true(s6 == "-7")

    var s7 = cb_to_str("foo", "bar")
    teko::assert::is_true(s7 == "foobar")
}

/**
 * cgt_large_int_and_escape — Group B: large-integer printing and C-string escaping
 * (`cb_u64_digits`, `cb_u64_c_expr`, `cb_numint`, `cb_f64_literal`, `cb_cstr_escaped`).
 *
 * `cb_numint`'s negative case (drop-128, 2026-07-24) used to PANIC in the (now-retired)
 * interpreter (the old `v to u64` reinterpretation of a negative source); `NumInt`'s explicit
 * sign flag needs no such reinterpretation, so both a `-(` prefix and the correct magnitude are
 * now directly coverable (#299).
 */
#test
fn cgt_large_int_and_escape() {
    var d0 = str(cb_u64_digits(cgt_empty(), 0 to u64))
    teko::assert::is_true(d0 == "0")
    var d255 = str(cb_u64_digits(cgt_empty(), 255 to u64))
    teko::assert::is_true(d255 == "255")

    var uc = str(cb_u64_c_expr(cgt_empty(), 0 to u64))
    teko::assert::is_true(teko::str::contains(uc, "0"))
    var uc1 = str(cb_u64_c_expr(cgt_empty(), 1 to u64))
    teko::assert::is_true(uc1.len > 0)

    var i0 = str(cb_numint(cgt_empty(), parser::numint_of_u64(0)))
    teko::assert::is_true(teko::str::contains(i0, "0"))
    var ipos = str(cb_numint(cgt_empty(), parser::numint_of_u64(42)))
    teko::assert::is_true(teko::str::contains(ipos, "42"))
    var ineg = str(cb_numint(cgt_empty(), parser::numint_negate(parser::numint_of_u64(1))))
    teko::assert::is_true(teko::str::contains(ineg, "-("))
    teko::assert::is_true(teko::str::contains(ineg, "1"))
    var ineg42 = str(cb_numint(cgt_empty(), parser::numint_negate(parser::numint_of_u64(42))))
    teko::assert::is_true(teko::str::contains(ineg42, "-("))
    teko::assert::is_true(teko::str::contains(ineg42, "42"))

    var flit = str(cb_f64_literal(cgt_empty(), 1.5))
    teko::assert::is_true(flit.len > 0)

    var e1 = str(cb_cstr_escaped(cgt_empty(), "hi"))
    teko::assert::is_true(e1 == "hi")
    var e2 = cb_cstr_escaped(cgt_empty(), "\\")
    teko::assert::is_true(e2.len == 2)
    var e3 = cb_cstr_escaped(cgt_empty(), "\t")
    teko::assert::is_true(e3.len == 2)
    var e4 = cb_cstr_escaped(cgt_empty(), "\n")
    teko::assert::is_true(e4.len == 2)
}

// ---------------------------------------------------------------------------
// Group C: Name mangling — mangle_type_name, cb_fn_name, cb_ident,
//           cg_is_c_keyword, cb_upper
// ---------------------------------------------------------------------------
#test
fn cgt_name_mangling() {
    // mangle_type_name — no namespace → tk_t_<Name>
    var mn1 = str(mangle_type_name(cgt_empty(), "", "Foo"))
    teko::assert::is_true(mn1 == "tk_t_Foo")

    // with namespace: "::" collapse to "__"
    var mn2 = str(mangle_type_name(cgt_empty(), "a::b", "T"))
    teko::assert::is_true(teko::str::contains(mn2, "tk_t_"))
    teko::assert::is_true(teko::str::contains(mn2, "a"))

    // cb_fn_name — produces a non-empty mangled name
    var fn1 = str(cb_fn_name(cgt_empty(), "teko::rt", "foo"))
    teko::assert::is_true(fn1.len > 0)
    var fn2 = str(cb_fn_name(cgt_empty(), "", "bar"))
    teko::assert::is_true(teko::str::contains(fn2, "bar"))

    // cg_is_c_keyword — known keywords
    teko::assert::is_true(cg_is_c_keyword("bool"))
    teko::assert::is_true(cg_is_c_keyword("int"))
    teko::assert::is_true(cg_is_c_keyword("return"))
    teko::assert::is_true(cg_is_c_keyword("struct"))
    teko::assert::is_false(cg_is_c_keyword("foo"))
    teko::assert::is_false(cg_is_c_keyword("teko"))

    // cb_ident — non-keyword passes through; keyword gets trailing `_`
    var id1 = str(cb_ident(cgt_empty(), "foo"))
    teko::assert::is_true(id1 == "foo")
    var id2 = str(cb_ident(cgt_empty(), "bool"))
    teko::assert::is_true(id2 == "bool_")
    var id3 = str(cb_ident(cgt_empty(), "return"))
    teko::assert::is_true(id3 == "return_")

    // cb_upper — lowercase ASCII → uppercase
    var u1 = str(cb_upper(cgt_empty(), "hello"))
    teko::assert::is_true(u1 == "HELLO")
    var u2 = str(cb_upper(cgt_empty(), "world123"))
    teko::assert::is_true(teko::str::contains(u2, "WORLD"))
}

// ---------------------------------------------------------------------------
// Group D: Operator token tables — binop_c, unop_c, cmpop_c, assignop_c
// ---------------------------------------------------------------------------
#test
fn cgt_operator_tokens() {
    // binop_c
    var b1 = match binop_c(lexer::TokenKind::Plus) { str as s => s; error => "" }
    teko::assert::is_true(b1 == "+")
    var b2 = match binop_c(lexer::TokenKind::Minus) { str as s => s; error => "" }
    teko::assert::is_true(b2 == "-")
    var b3 = match binop_c(lexer::TokenKind::Star) { str as s => s; error => "" }
    teko::assert::is_true(b3 == "*")
    var b4 = match binop_c(lexer::TokenKind::Amp) { str as s => s; error => "" }
    teko::assert::is_true(b4 == "&")
    var b5 = match binop_c(lexer::TokenKind::Pipe) { str as s => s; error => "" }
    teko::assert::is_true(b5 == "|")
    var b6 = match binop_c(lexer::TokenKind::Caret) { str as s => s; error => "" }
    teko::assert::is_true(b6 == "^")
    var b7 = match binop_c(lexer::TokenKind::Shl) { str as s => s; error => "" }
    teko::assert::is_true(b7 == "<<")
    var b8 = match binop_c(lexer::TokenKind::Shr) { str as s => s; error => "" }
    teko::assert::is_true(b8 == ">>")
    var b9 = match binop_c(lexer::TokenKind::AndAnd) { str as s => s; error => "" }
    teko::assert::is_true(b9 == "&&")
    var b10 = match binop_c(lexer::TokenKind::OrOr) { str as s => s; error => "" }
    teko::assert::is_true(b10 == "||")

    // unop_c
    var u1 = match unop_c(lexer::TokenKind::Minus) { str as s => s; error => "" }
    teko::assert::is_true(u1 == "-")
    var u2 = match unop_c(lexer::TokenKind::Tilde) { str as s => s; error => "" }
    teko::assert::is_true(u2 == "~")
    var u3 = match unop_c(lexer::TokenKind::Bang) { str as s => s; error => "" }
    teko::assert::is_true(u3 == "!")

    // cmpop_c
    var c1 = match cmpop_c(lexer::TokenKind::EqEq) { str as s => s; error => "" }
    teko::assert::is_true(c1 == "==")
    var c2 = match cmpop_c(lexer::TokenKind::Ne) { str as s => s; error => "" }
    teko::assert::is_true(c2 == "!=")
    var c3 = match cmpop_c(lexer::TokenKind::Lt) { str as s => s; error => "" }
    teko::assert::is_true(c3 == "<")
    var c4 = match cmpop_c(lexer::TokenKind::Le) { str as s => s; error => "" }
    teko::assert::is_true(c4 == "<=")
    var c5 = match cmpop_c(lexer::TokenKind::Gt) { str as s => s; error => "" }
    teko::assert::is_true(c5 == ">")
    var c6 = match cmpop_c(lexer::TokenKind::Ge) { str as s => s; error => "" }
    teko::assert::is_true(c6 == ">=")

    // assignop_c
    var a1 = match assignop_c(lexer::TokenKind::Assign) { str as s => s; error => "" }
    teko::assert::is_true(a1 == "=")
    var a2 = match assignop_c(lexer::TokenKind::PlusEq) { str as s => s; error => "" }
    teko::assert::is_true(a2 == "+=")
    var a3 = match assignop_c(lexer::TokenKind::MinusEq) { str as s => s; error => "" }
    teko::assert::is_true(a3 == "-=")
    var a4 = match assignop_c(lexer::TokenKind::StarEq) { str as s => s; error => "" }
    teko::assert::is_true(a4 == "*=")
    var a5 = match assignop_c(lexer::TokenKind::SlashEq) { str as s => s; error => "" }
    teko::assert::is_true(a5 == "/=")
    var a6 = match assignop_c(lexer::TokenKind::PercentEq) { str as s => s; error => "" }
    teko::assert::is_true(a6 == "%=")
    var a7 = match assignop_c(lexer::TokenKind::AmpEq) { str as s => s; error => "" }
    teko::assert::is_true(a7 == "&=")
    var a8 = match assignop_c(lexer::TokenKind::ShlEq) { str as s => s; error => "" }
    teko::assert::is_true(a8 == "<<=")
    var a9 = match assignop_c(lexer::TokenKind::ShrEq) { str as s => s; error => "" }
    teko::assert::is_true(a9 == ">>=")
}

// ---------------------------------------------------------------------------
// Group E: PrimKind predicates
//   cg_prim_is_float, cg_prim_is_int, cg_prim_is_signed_int, cg_int_width,
//   prim_div_tag, prim_int_tag, prim_float_tag, cast_may_lose
// ---------------------------------------------------------------------------
#test
fn cgt_prim_predicates() {
    // cg_prim_is_float — floats are float; ints/bool are not
    teko::assert::is_true(cg_prim_is_float(checker::PrimKind::F32))
    teko::assert::is_true(cg_prim_is_float(checker::PrimKind::F64))
    teko::assert::is_false(cg_prim_is_float(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_float(checker::PrimKind::Bool))

    // cg_prim_is_int — integer prims; not float, not bool
    teko::assert::is_true(cg_prim_is_int(checker::PrimKind::U8))
    teko::assert::is_true(cg_prim_is_int(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_int(checker::PrimKind::F64))
    teko::assert::is_false(cg_prim_is_int(checker::PrimKind::Bool))

    // cg_prim_is_signed_int — signed ints only
    teko::assert::is_true(cg_prim_is_signed_int(checker::PrimKind::I8))
    teko::assert::is_true(cg_prim_is_signed_int(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_signed_int(checker::PrimKind::U64))
    teko::assert::is_false(cg_prim_is_signed_int(checker::PrimKind::Bool))

    // cg_int_width — bit width for ints
    teko::assert::is_true(cg_int_width(checker::PrimKind::U8) == 8)
    teko::assert::is_true(cg_int_width(checker::PrimKind::I16) == 16)
    teko::assert::is_true(cg_int_width(checker::PrimKind::U32) == 32)
    teko::assert::is_true(cg_int_width(checker::PrimKind::I64) == 64)

    // prim_div_tag — integer and float tags
    var t1 = match prim_div_tag(checker::PrimKind::U8) { str as s => s; error => "" }
    teko::assert::is_true(t1 == "u8")
    var t2 = match prim_div_tag(checker::PrimKind::I64) { str as s => s; error => "" }
    teko::assert::is_true(t2 == "i64")
    var t3 = match prim_div_tag(checker::PrimKind::F64) { str as s => s; error => "" }
    teko::assert::is_true(t3 == "f64")
    var t4 = match prim_div_tag(checker::PrimKind::Bool) { str => "ok"; error as e => "err" }
    teko::assert::is_true(t4 == "err")

    // prim_int_tag — only valid for integer prims
    var it1 = match prim_int_tag(checker::PrimKind::I8) { str as s => s; error => "" }
    teko::assert::is_true(it1 == "i8")
    var it2 = match prim_int_tag(checker::PrimKind::U64) { str as s => s; error => "" }
    teko::assert::is_true(it2 == "u64")
    var it3 = match prim_int_tag(checker::PrimKind::F32) { str => "ok"; error => "err" }
    teko::assert::is_true(it3 == "err")

    // prim_float_tag — only valid for float prims
    var ft1 = match prim_float_tag(checker::PrimKind::F32) { str as s => s; error => "" }
    teko::assert::is_true(ft1 == "f32")
    var ft2 = match prim_float_tag(checker::PrimKind::F64) { str as s => s; error => "" }
    teko::assert::is_true(ft2 == "f64")
    var ft3 = match prim_float_tag(checker::PrimKind::I64) { str => "ok"; error => "err" }
    teko::assert::is_true(ft3 == "err")

    // cast_may_lose — narrowing int→int requires a guard
    teko::assert::is_true(cast_may_lose(checker::PrimKind::I64, checker::PrimKind::I8))
    teko::assert::is_true(cast_may_lose(checker::PrimKind::U64, checker::PrimKind::U8))
    // widening int→int does NOT lose
    teko::assert::is_false(cast_may_lose(checker::PrimKind::I8, checker::PrimKind::I64))
    // unsigned→signed at equal width loses
    teko::assert::is_true(cast_may_lose(checker::PrimKind::U64, checker::PrimKind::I64))
}

// ---------------------------------------------------------------------------
// Group F: Type emission — emit_prim, emit_type (Prim/Str/Byte/Error/Void)
// ---------------------------------------------------------------------------
#test
fn cgt_type_emission() {
    // emit_prim — the C type name for each prim kind
    var p1 = match emit_prim(cgt_empty(), checker::PrimKind::U8) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p1 == "uint8_t")
    var p2 = match emit_prim(cgt_empty(), checker::PrimKind::I64) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p2 == "int64_t")
    var p3 = match emit_prim(cgt_empty(), checker::PrimKind::F64) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p3 == "double")
    var p4 = match emit_prim(cgt_empty(), checker::PrimKind::Bool) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p4 == "bool")

    // emit_type — wrapping emit_prim plus non-prim cases
    var t1 = match emit_type(cgt_empty(), cgt_prog(), checker::Prim { kind = checker::PrimKind::I32 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t1 == "int32_t")
    var t2 = match emit_type(cgt_empty(), cgt_prog(), checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t2 == "tk_str")
    var t3 = match emit_type(cgt_empty(), cgt_prog(), checker::Byte { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t3 == "uint8_t")
    // E2-NATIVE: error now emits the full tk_error struct (not tk_str).
    var t4 = match emit_type(cgt_empty(), cgt_prog(), checker::Error { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t4 == "tk_error")
    var t5 = match emit_type(cgt_empty(), cgt_prog(), checker::Void { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t5 == "void")
    // Named type → mangled tk_t_<Name>
    var t6 = match emit_type(cgt_empty(), cgt_prog(), checker::Named { name = "Shape" }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t6 == "tk_t_Shape")
}

/**
 * Group G: type mangle + member keys + variant typename — `cg_opt_mangle_str`, `cg_opt_mangle`,
 * `cg_member_key_str`, `cg_member_key`, `cg_variant_typename_str`, `cg_variant_typename`.
 */
#test
fn cgt_opt_mangle_and_keys() {
    // cg_opt_mangle_str — the suffix string for prim, byte, str, error, named
    var m1 = match cg_opt_mangle_str(checker::Prim { kind = checker::PrimKind::I64 }) { str as s => s; error => "" }
    teko::assert::is_true(m1 == "i64")
    var m2 = match cg_opt_mangle_str(checker::Str { }) { str as s => s; error => "" }
    teko::assert::is_true(m2 == "str")
    var m3 = match cg_opt_mangle_str(checker::Byte { }) { str as s => s; error => "" }
    teko::assert::is_true(m3 == "byte")
    var m4 = match cg_opt_mangle_str(checker::Error { }) { str as s => s; error => "" }
    teko::assert::is_true(m4 == "error")
    var m5 = match cg_opt_mangle_str(checker::Named { name = "Foo" }) { str as s => s; error => "" }
    teko::assert::is_true(m5 == "Foo")

    // cg_opt_mangle — buffer variant of cg_opt_mangle_str
    var om1 = match cg_opt_mangle(cgt_empty(), checker::Prim { kind = checker::PrimKind::U8 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(om1 == "u8")

    // cg_member_key_str — like cg_opt_mangle_str but handles C-keyword keys
    var k1 = match cg_member_key_str(checker::Prim { kind = checker::PrimKind::Bool }) { str as s => s; error => "" }
    teko::assert::is_true(k1 == "bool_")   // `bool` is a C keyword → gets trailing `_`
    var k2 = match cg_member_key_str(checker::Str { }) { str as s => s; error => "" }
    teko::assert::is_true(k2 == "str")
    var k3 = match cg_member_key_str(checker::Error { }) { str as s => s; error => "" }
    teko::assert::is_true(k3 == "error")
    var k4 = match cg_member_key_str(checker::Prim { kind = checker::PrimKind::I64 }) { str as s => s; error => "" }
    teko::assert::is_true(k4 == "i64")

    // cg_member_key — buffer variant
    var mk1 = match cg_member_key(cgt_empty(), checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(mk1 == "str")

    var vm1: []checker::Type = teko::list::push(teko::list::empty(), checker::Prim { kind = checker::PrimKind::I64 })
    var vm2: []checker::Type = teko::list::push(vm1, checker::Str { })
    var va = checker::Variant { members = vm2 }
    var vn = match cg_variant_typename(cgt_empty(), va) { []byte as o => str(o); error => "" }
    teko::assert::is_true(vn == "tk_u_i64_str")

    // cg_variant_typename — buffer variant
    var vm3: []checker::Type = teko::list::push(teko::list::empty(), checker::Error { })
    var va2 = checker::Variant { members = vm3 }
    var vb = match cg_variant_typename(cgt_empty(), va2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(vb == "tk_u_error")
}

// ---------------------------------------------------------------------------
// Group H: TProgram queries — cg_path_last, cg_is_prim_name, cg_is_builtin_scalar,
//   cg_find_decl, cg_find_variant_decl, cg_named_is_variant, cg_named_is_enum,
//   cg_find_function, cg_nameset_seen, cg_str_in, cg_named_decls
// ---------------------------------------------------------------------------
#test
fn cgt_prog_queries() {
    var prog = cgt_prog()

    // cg_path_last — last segment of a path
    var pl1 = cg_path_last(cgt_path1("foo"))
    teko::assert::is_true(pl1 == "foo")
    var pl2 = cg_path_last(parser::Path { segments = teko::list::empty() })
    teko::assert::is_true(pl2 == "")

    // cg_is_prim_name — aliases cg_is_builtin_scalar
    teko::assert::is_true(cg_is_prim_name("u64"))
    teko::assert::is_true(cg_is_prim_name("str"))
    teko::assert::is_false(cg_is_prim_name("MyType"))

    // cg_is_builtin_scalar
    teko::assert::is_true(cg_is_builtin_scalar("i64"))
    teko::assert::is_true(cg_is_builtin_scalar("bool"))
    teko::assert::is_true(cg_is_builtin_scalar("byte"))
    teko::assert::is_true(cg_is_builtin_scalar("error"))
    teko::assert::is_false(cg_is_builtin_scalar("Foo"))

    // cg_find_decl — empty program → error (but function is covered)
    var fd = match cg_find_decl(prog, "Foo") { parser::TypeDecl => "found"; error => "not-found" }
    teko::assert::is_true(fd == "not-found")

    // cg_find_variant_decl — empty program → error
    var fvd = match cg_find_variant_decl(prog, "Shape") { parser::TypeDecl => "found"; error => "not-found" }
    teko::assert::is_true(fvd == "not-found")

    // cg_named_is_variant / cg_named_is_enum — empty program → false
    teko::assert::is_false(cg_named_is_variant(prog, "Shape"))
    teko::assert::is_false(cg_named_is_enum(prog, "Color"))

    // cg_find_function — empty program → error
    var ff = match cg_find_function(prog, "teko::test", "my_fn") { checker::TFunction => "found"; error => "not-found" }
    teko::assert::is_true(ff == "not-found")

    // cg_str_in — membership test on []str
    var xs: []str = teko::list::push(teko::list::empty(), "alpha")
    teko::assert::is_true(cg_str_in(xs, "alpha"))
    teko::assert::is_false(cg_str_in(xs, "beta"))
    teko::assert::is_false(cg_str_in(teko::list::empty(), "x"))

    // cg_nameset_seen — delegates to cg_str_in
    teko::assert::is_true(cg_nameset_seen(xs, "alpha"))
    teko::assert::is_false(cg_nameset_seen(xs, "gamma"))

    // cg_named_decls — empty program → empty result
    var decls = cg_named_decls(prog)
    teko::assert::is_true(decls.len == 0)
}

// ---------------------------------------------------------------------------
// Group I: emit_expr — various TExpr kinds
//   emit_expr, emit_expr_ret, emit_number, emit_strlit,
//   TVar, TByteLit, TBoolLit paths
// ---------------------------------------------------------------------------
#test
fn cgt_emit_expr_variants() {
    var prog = cgt_prog()

    // TNumber (I64) → ((int64_t)42)
    var e1 = match emit_expr(cgt_empty(), prog, cgt_num_i64(42)) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(e1, "42"))
    teko::assert::is_true(teko::str::contains(e1, "int64_t"))

    // TNumber (I8) → ((int8_t)3)  — positive only; negative I8 hits cb_i64 neg branch (separately covered)
    var e2 = match emit_expr(cgt_empty(), prog, cgt_num_i8(3)) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(e2, "int8_t"))

    // TVar → the identifier (or keyword-escaped variant)
    var ev = match emit_expr(cgt_empty(), prog, cgt_e_var("myvar")) { []byte as o => str(o); error => "" }
    teko::assert::is_true(ev == "myvar")
    // C-keyword variable → trailing `_`
    var ekw = match emit_expr(cgt_empty(), prog, cgt_e_var("return")) { []byte as o => str(o); error => "" }
    teko::assert::is_true(ekw == "return_")

    // TByteLit → decimal integer (ASCII value)
    var ebl = checker::TExpr {
        kind = checker::TByteLit { value = b'A' }
        type = checker::Byte { }
        line = 0; col = 0
    }
    var sbl = match emit_expr(cgt_empty(), prog, ebl) { []byte as o => str(o); error => "" }
    teko::assert::is_true(sbl == "65")   // 'A' = 65

    // TBoolLit true → "true", false → "false"
    var etrue = match emit_expr(cgt_empty(), prog, cgt_e_bool_t()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(etrue == "true")
    var ef = checker::TExpr {
        kind = checker::TBoolLit { value = false }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var efalse = match emit_expr(cgt_empty(), prog, ef) { []byte as o => str(o); error => "" }
    teko::assert::is_true(efalse == "false")

    // TStrLit → (tk_str){ "hello", 5 }
    var esl = checker::TExpr {
        kind = checker::TStrLit { text = "hello" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var ssl = match emit_expr(cgt_empty(), prog, esl) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(ssl, "hello"))
    teko::assert::is_true(teko::str::contains(ssl, "5"))
}

/**
 * F1.4 (AL wave) — `emit_borrow`: a safe borrow `&x` (`TBorrow`) lowers to the C address-of form
 * `&<operand>`, byte-identical to the auto-ref `&` the call path already emits. Here the operand is
 * a bare `TVar x`, so the emitted text is exactly `&x`; a keyword-named target keeps its escaped
 * identifier (`&return_`), proving the operand flows through the normal expression dispatch.
 */
#test
fn cgt_emit_borrow() {
    var prog = cgt_prog()

    var borrow_x = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("x") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var sx = match emit_expr(cgt_empty(), prog, borrow_x) { []byte as o => str(o); error => "" }
    teko::assert::is_true(sx == "&x")

    var borrow_kw = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("return") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var skw = match emit_expr(cgt_empty(), prog, borrow_kw) { []byte as o => str(o); error => "" }
    teko::assert::is_true(skw == "&return_")
}

// ---------------------------------------------------------------------------
// Group J: emit_binary + emit_div_mod
//   emit_binary, emit_div_mod (via emit_expr with TBinary Slash/Percent)
// ---------------------------------------------------------------------------
#test
fn cgt_emit_binary_and_div() {
    var prog = cgt_prog()
    var left = cgt_num_i64(10)
    var right = cgt_num_i64(3)

    // TBinary Plus on i64 → C7.15: tk_add_i64(left, right)
    var e_add = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Plus; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_add = match emit_expr(cgt_empty(), prog, e_add) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_add, "tk_add_i64"))

    // TBinary Star on i64 → C7.15: tk_mul_i64(left, right)
    var e_mul = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Star; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_mul = match emit_expr(cgt_empty(), prog, e_mul) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mul, "tk_mul_i64"))

    // TBinary Slash → emit_div_mod → tk_div_i64(left, right)
    var e_div = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Slash; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_div = match emit_expr(cgt_empty(), prog, e_div) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_div, "tk_div_i64"))

    // TBinary Percent → emit_div_mod → tk_mod_i64(left, right)
    var e_mod = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Percent; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_mod = match emit_expr(cgt_empty(), prog, e_mod) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mod, "tk_mod_i64"))
}

// ---------------------------------------------------------------------------
// Group K: emit_unary, emit_compare, emit_cast
// ---------------------------------------------------------------------------
#test
fn cgt_emit_unary_compare_cast() {
    var prog = cgt_prog()
    var n42 = cgt_num_i64(42)

    // emit_unary — `(-42)` and `(!true)`
    var e_neg = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Minus; operand = n42 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_neg = match emit_expr(cgt_empty(), prog, e_neg) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_neg, "-"))

    var e_not = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Bang; operand = cgt_e_bool_t() }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var s_not = match emit_expr(cgt_empty(), prog, e_not) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_not, "!"))

    // emit_compare — TCompare with one rest term (a < b)
    var term = checker::TCmpTerm { op = lexer::TokenKind::Lt; operand = n42 }
    var terms: []checker::TCmpTerm = teko::list::push(teko::list::empty(), term)
    var e_cmp = checker::TExpr {
        kind = checker::TCompare { first = cgt_num_i64(0); rest = terms }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var s_cmp = match emit_expr(cgt_empty(), prog, e_cmp) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_cmp, "<"))

    // emit_cast — widening I32 → I64 (no guard needed): ((int64_t)(inner))
    var inner32 = cgt_num_i32(10)
    var e_widen = checker::TExpr {
        kind = checker::TCast { expr = inner32 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_widen = match emit_expr(cgt_empty(), prog, e_widen) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_widen, "int64_t"))

    // emit_cast — narrowing I64 → I8 (guarded): tk_to_i8_s(inner)
    var inner64 = cgt_num_i64(200)
    var e_narrow = checker::TExpr {
        kind = checker::TCast { expr = inner64 }
        type = checker::Prim { kind = checker::PrimKind::I8 }
        line = 0; col = 0
    }
    var s_narrow = match emit_expr(cgt_empty(), prog, e_narrow) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_narrow, "tk_to_i8"))
}

// ---------------------------------------------------------------------------
// Group M2: S2/W9 — VALUE-position arm regions. A value `if`/`match` arm with a NON-tail
//   binding takes the value-arm path (emit_branch_value / emit_arm_value) and yields its tail
//   to the enclosing sink. With NO escape context (emit_expr threads empty escaping/regions/
//   fn_body) NO region is opened — so the output is the pre-W9 value-form, byte-identical: the
//   `sink = (…); break;` commit with no `tk_region_new`. (The genuine region-opening path is
//   covered end-to-end by the value-arm regression examples — the predicate needs the live
//   per-function escape set, which only the full build pipeline supplies.)
// ---------------------------------------------------------------------------
#test
fn cgt_emit_value_arm_no_region_when_no_context() {
    var prog = cgt_prog()
    // if (true) { let tmp = 5; tmp } else { 0 }  — a value `if` whose then-branch has a non-tail
    // binding + a tail read. emit_branch_value runs; with empty escape context no region opens.
    var bind_tmp: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(5)
    }
    var tail_read: checker::TStatement = cgt_stmt(cgt_e_var("tmp"))
    var then_blk: []checker::TStatement = teko::list::push(teko::list::empty(), bind_tmp)
    then_blk = teko::list::push(then_blk, tail_read)
    var else_blk: []checker::TStatement = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0)))
    var if_e = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = then_blk; has_else = true; else_blk = else_blk }
    var e_if = checker::TExpr { kind = if_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    var result = match emit_expr(cgt_empty(), prog, e_if) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "tmp"))
    // No live escape context ⇒ no value-arm region opened (leak-safe pre-W9 output).
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

// A value `match` arm with a non-tail binding takes emit_arm_value's value path: the tail value
// commits with `_rN = (…); break;`. No escape context ⇒ no region (byte-identical to pre-W9).
#test
fn cgt_emit_value_match_arm_commits_tail() {
    var prog = cgt_prog()
    var bind_tmp: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(7)
    }
    var arm_lit: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(1); fval = 0.0 }; line = 0; col = 0 }
    }
    var arm_body: []checker::TStatement = teko::list::push(teko::list::empty(), bind_tmp)
    arm_body = teko::list::push(arm_body, cgt_stmt(cgt_e_var("tmp")))
    var arm1 = checker::TArm { pattern = arm_lit; has_when = false; guard = cgt_num_i64(0); body = arm_body }
    var arm_w = checker::TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0))) }
    var arms: []checker::TArm = teko::list::push(teko::list::empty(), arm1)
    arms = teko::list::push(arms, arm_w)
    var m_e = checker::TMatchExpr { subject = cgt_num_i64(1); arms = arms }
    var e_m = checker::TExpr { kind = m_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    var result = match emit_expr(cgt_empty(), prog, e_m) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "break;"))
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

/** cgt_emit_loop_with_init — a loop with a NON-empty `init` wraps in a `{ }` C scope and emits the
    preamble binding before `while (1)` (#517 emit_loop init wrapper). */
#test
fn cgt_emit_loop_with_init() {
    var prog = cgt_prog()
    var init_bind: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3)
    }
    var init: []checker::TStatement = teko::list::push(cgt_empty_stmts(), init_bind)
    var body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: checker::TStatement = checker::TLoopStmt { label = ""; init = init; body = body }
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }
    var b: []checker::TStatement = teko::list::push(cgt_empty_stmts(), loop_s)
    b = teko::list::push(b, cgt_ret(cgt_num_i64(0)))
    var f = cgt_fn0("cgt_loop_init", "teko::cgt", ret_type, b)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r, "_hi"))
    teko::assert::is_true(teko::str::contains(r, "while"))
}

/** cgt_loop_init_walkers — the codegen collect-optionals and lambda-lift walkers descend into a
    loop's `init` preamble as well as its body (#517). */
#test
fn cgt_loop_init_walkers() {
    var init_bind: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3)
    }
    var init: []checker::TStatement = teko::list::push(cgt_empty_stmts(), init_bind)
    var body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: checker::TStatement = checker::TLoopStmt { label = ""; init = init; body = body }
    var stmts: []checker::TStatement = teko::list::push(cgt_empty_stmts(), loop_s)
    var set0 = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }
    var collected = cg_collect_block_opts(set0, stmts)
    teko::assert::is_true(collected.inners.len == 0)
    var acc = StampAcc { next = 0; fns = teko::list::empty(); lams = teko::list::empty() }
    var lifted = cg_lift_block(stmts, acc)
    teko::assert::is_true(lifted.len == 1)
}

// ---------------------------------------------------------------------------
// Group N: emit_function — the full pipeline
//   emit_function, emit_function_sig, emit_block_tail, emit_block, emit_stmt,
//   emit_binding, emit_assign, emit_loop, emit_return, emit_if_stmt,
//   emit_exprstmt_tail, emit_as_r, cg_stmt_c_terminates, is_void_type,
//   cb_indent_deeper, emit_type_expr (via params)
// ---------------------------------------------------------------------------
#test
fn cgt_emit_function_comprehensive() {
    var prog = cgt_prog()

    // Body 1: loop{break} + if-stmt + binding + assign + return tail
    var break_body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: checker::TStatement = checker::TLoopStmt { label = ""; init = teko::list::empty(); body = break_body }

    // if (true) { } — no else — statement position → emit_if_stmt → cb_indent_deeper
    var empty_blk = cgt_empty_stmts()
    var if_s: checker::TStatement = cgt_stmt(checker::TExpr {
            kind = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = empty_blk; has_else = false; else_blk = empty_blk }
            type = checker::Void { }
            line = 0; col = 0
    })

    var bind_s: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "x" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(10)
    }
    var assign_s: checker::TStatement = checker::TAssign {
        kind = parser::AssignKind::Simple
        name = "x"
        op = lexer::TokenKind::PlusEq
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(1)
        deref = false
        target = checker::no_texpr()
    }
    var ret_s: checker::TStatement = cgt_ret(cgt_num_i64(42))

    var body1: []checker::TStatement = cgt_empty_stmts()
    body1 = teko::list::push(body1, loop_s)
    body1 = teko::list::push(body1, if_s)
    body1 = teko::list::push(body1, bind_s)
    body1 = teko::list::push(body1, assign_s)
    body1 = teko::list::push(body1, ret_s)

    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }
    var f1 = cgt_fn0("cgt_fn_ret", "teko::cgt", ret_type, body1)
    var r1 = match emit_function(cgt_empty(), prog, f1) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r1.len > 0)
    teko::assert::is_true(teko::str::contains(r1, "cgt_fn_ret"))
    teko::assert::is_true(teko::str::contains(r1, "while"))   // emit_loop → while(1)
    teko::assert::is_true(teko::str::contains(r1, "break"))
    teko::assert::is_true(teko::str::contains(r1, "int64_t x"))
    teko::assert::is_true(teko::str::contains(r1, "return"))

    // Body 2: single TExprStmt tail → covers emit_exprstmt_tail (non-if/match path)
    var tail_s: checker::TStatement = cgt_stmt(cgt_num_i64(99))
    var body2: []checker::TStatement = teko::list::push(cgt_empty_stmts(), tail_s)
    var f2 = cgt_fn0("cgt_fn_tail", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r2.len > 0)
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_tail"))
    teko::assert::is_true(teko::str::contains(r2, "return"))

    // Body 3 function, empty body → needs_unreachable = false
    var f3 = cgt_fn0("cgt_fn_void", "teko::cgt", checker::Void { }, cgt_empty_stmts())
    var r3 = match emit_function(cgt_empty(), prog, f3) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r3.len > 0)
    teko::assert::is_true(teko::str::contains(r3, "void"))

    // Function with a parameter → emit_type_expr is called from emit_function_sig
    var param = parser::Param { name = "n"; has_type = true; type_ann = cgt_named_te("u64"); is_params = false; has_default = false; default_expr = parser::no_expr() }
    var params: []parser::Param = teko::list::push(teko::list::empty(), param)
    var body4: []checker::TStatement = teko::list::push(cgt_empty_stmts(), cgt_ret(cgt_num_i64(0)))
    var f4 = checker::TFunction { overload_suffix = "";
        name = "cgt_fn_param"
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        namespace = "teko::cgt"
        params = params
        return_type = checker::Prim { kind = checker::PrimKind::I64 }
        body = body4
        vis = parser::Visibility::Private
        has_doc = false
        doc = ""
        file = ""
        line = 0; col = 0
        is_test = false
        is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty() }
    var r4 = match emit_function(cgt_empty(), prog, f4) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r4.len > 0)
    teko::assert::is_true(teko::str::contains(r4, "uint64_t"))   // emit_type_expr("u64")
    teko::assert::is_true(teko::str::contains(r4, "n"))   // cb_ident("n")
}

// Explicit `return` drops active block regions before emitting the return value. The value must be
// emitted against the escaping context (no active block-region parent), or a class literal would
// parent under a dropped handle.
#test
fn cgt_emit_return_uses_escaping_region_context() {
    var c = cgt_class_decl("RetClass", parser::ClassKind::Sealed, false, "")
    var prog = cg_prog_of(checker::TProgram { items = teko::list::push(teko::list::empty(), c) })
    var empty_names: []str = teko::list::empty()
    var empty_vals: []checker::TExpr = teko::list::empty()
    var ret_expr = checker::TExpr {
        kind = checker::TStructInit { field_names = empty_names; field_vals = empty_vals }
        type = checker::Named { name = "RetClass" }
        line = 0; col = 0
    }
    var ret = checker::TReturn { has_value = true; value = ret_expr; values = teko::list::empty() }
    var regions: []RegionFrame = teko::list::push(teko::list::empty(), RegionFrame { name = "_tkbr_ret"; label = ""; is_loop = false; defer_base = 0 to u64; decls = teko::list::empty() })
    var out = match emit_return(cgt_empty(), prog, ret, false, checker::Named { name = "RetClass" }, "    ", "", teko::list::empty(), regions, teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(out, "tk_region_drop(_tkbr_ret); _tkbr_ret = NULL;"))
    teko::assert::is_true(teko::str::contains(out, "tk_region_new(tk_region_root())"))
    teko::assert::is_true(!teko::str::contains(out, "tk_region_new(_tkbr_ret)"))
}

// ---------------------------------------------------------------------------
// Group N1b TAIL match must CHAIN its arms with a commit jump (REGRESSION).
//   A statement-position / tail `match` in a `-> void` fn has arm bodies that do NOT diverge
//   (no implicit `return`). emit_match_tail must emit the FIRST winning arm's body then `goto`
//   a unique commit label past the rest — otherwise the arms fall through as independent `if`s
//   (`if(c){a} if(1){b}`) and MULTIPLE arms fire (the wildcard `if(1)` ALWAYS fires). The fix
//   makes EXACTLY ONE arm run, matching the value-form match. This test asserts the
//   emitted C carries the commit `goto …_done` chain (the structural guarantee).
// ---------------------------------------------------------------------------
fn cgt_lit_arm(v: u64, body_name: str): checker::TArm {
    // arm: `v => { let <body_name> = <v> }` — a NON-diverging effect body (the bug trigger).
    var lit: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; line = 0; col = 0 }
    }
    var eff: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = body_name }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(v to i64)
    }
    checker::TArm { pattern = lit; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(cgt_empty_stmts(), eff) }
}
fn cgt_wild_arm(body_name: str): checker::TArm {
    var eff: checker::TStatement = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = body_name }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(99)
    }
    checker::TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(cgt_empty_stmts(), eff) }
}

#test
fn cgt_void_tail_match_chains_arms() {
    var prog = cgt_prog()

    // subject `k: i64`, two arms (1 => {effect}; _ => {effect}); the match is the void fn's tail.
    var subj = cgt_e_var("k")
    var arms: []checker::TArm = teko::list::empty()
    arms = teko::list::push(arms, cgt_lit_arm(1, "a1"))
    arms = teko::list::push(arms, cgt_wild_arm("aw"))
    var match_e = checker::TExpr {
        kind = checker::TMatchExpr { subject = subj; arms = arms }
        type = checker::Void { }
        line = 0; col = 0
    }
    var tail: []checker::TStatement = teko::list::push(cgt_empty_stmts(), cgt_stmt(match_e))
    var f = cgt_fn0("cgt_fn_void_match", "teko::cgt", checker::Void { }, tail)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }

    teko::assert::is_true(r.len > 0)
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_void_match"))
    // Both arm bodies present...
    teko::assert::is_true(teko::str::contains(r, "a1"))
    teko::assert::is_true(teko::str::contains(r, "aw"))
    // ...but chained with a commit jump so EXACTLY ONE arm runs (the regression guarantee).
    // Before the fix the arms were independent `if`s with NO goto, so both fired.
    teko::assert::is_true(teko::str::contains(r, "goto "))
    teko::assert::is_true(teko::str::contains(r, "_done"))

    // 3-arm shape (1 => ; 2 => ; _ =>) must likewise chain — assert TWO commit jumps reach the
    // single shared label (one per non-final arm + the final wildcard = 3 gotos to one label).
    var arms3: []checker::TArm = teko::list::empty()
    arms3 = teko::list::push(arms3, cgt_lit_arm(1, "b1"))
    arms3 = teko::list::push(arms3, cgt_lit_arm(2, "b2"))
    arms3 = teko::list::push(arms3, cgt_wild_arm("bw"))
    var match3 = checker::TExpr {
        kind = checker::TMatchExpr { subject = cgt_e_var("k"); arms = arms3 }
        type = checker::Void { }
        line = 0; col = 0
    }
    var tail3: []checker::TStatement = teko::list::push(cgt_empty_stmts(), cgt_stmt(match3))
    var f3 = cgt_fn0("cgt_fn_void_match3", "teko::cgt", checker::Void { }, tail3)
    var r3 = match emit_function(cgt_empty(), prog, f3) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r3, "b1"))
    teko::assert::is_true(teko::str::contains(r3, "b2"))
    teko::assert::is_true(teko::str::contains(r3, "bw"))
    teko::assert::is_true(teko::str::contains(r3, "goto "))
    teko::assert::is_true(teko::str::contains(r3, "_done"))
}

// ---------------------------------------------------------------------------
// Group N2: (C7.18/W9.3) defer lowering — the .tks twin's per-block DeferCtx + defer_base fires
// each block's defers (LIFO) at its scope exit, matching codegen.c's g_cg_defers/emit_defers OUTPUT.
// ---------------------------------------------------------------------------
#test
fn cgt_emit_defer() {
    var prog = cgt_prog()
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }

    // defer { let _c = 0 } — the with_defer() shape: [defer, return 42].
    var defer_body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBinding {
            kind = parser::BindKind::Let
            target = parser::SimpleName { name = "_c" }
            bound = checker::Prim { kind = checker::PrimKind::I64 }
            value = cgt_num_i64(0)
    })
    var defer_s: checker::TStatement = checker::TDeferStmt { body = defer_body }

    var body: []checker::TStatement = cgt_empty_stmts()
    body = teko::list::push(body, defer_s)
    body = teko::list::push(body, cgt_ret(cgt_num_i64(42)))
    var f = cgt_fn0("cgt_fn_defer", "teko::cgt", ret_type, body)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r.len > 0)
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_defer"))
    teko::assert::is_true(teko::str::contains(r, "_c"))   // defer body emitted before the return
    teko::assert::is_true(teko::str::contains(r, "return"))

    // early_return_with_defer() shape: [defer, if true { return 1 }, return 2] — the defer body
    // is drained before BOTH returns (the TIfExpr recursion + the trailing return).
    var inner: []checker::TStatement = teko::list::push(cgt_empty_stmts(), cgt_ret(cgt_num_i64(1)))
    var if_s: checker::TStatement = cgt_stmt(checker::TExpr {
            kind = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = inner; has_else = false; else_blk = cgt_empty_stmts() }
            type = checker::Void { }
            line = 0; col = 0
    })
    var body2: []checker::TStatement = cgt_empty_stmts()
    body2 = teko::list::push(body2, defer_s)
    body2 = teko::list::push(body2, if_s)
    body2 = teko::list::push(body2, cgt_ret(cgt_num_i64(2)))
    var f2 = cgt_fn0("cgt_fn_defer2", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_defer2"))
    teko::assert::is_true(teko::str::contains(r2, "_c"))   // drained inside the if AND at the tail
}

/**
 * cgt_emit_adopt — (#337) verify the `adopt { }` lowering opens an adopter region and closes it
 * with the SUBTREE-drop primitive, and that a NESTED adopt opens a second (inner) region. The
 * emitted C must name tk_region_new (the adopter open) and tk_region_drop_subtree (the bulk-drop
 * at the brace), NOT the plain tk_region_drop — that distinction is what reclaims the per-object
 * child regions instead of leaking them to the process root.
 */
#test
fn cgt_emit_adopt() {
    var prog = cgt_prog()
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }

    var inner_body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), checker::TBinding {
            kind = parser::BindKind::Let
            target = parser::SimpleName { name = "_a" }
            bound = checker::Prim { kind = checker::PrimKind::I64 }
            value = cgt_num_i64(0)
    })
    var adopt_s: checker::TStatement = checker::TAdoptStmt { name = ""; body = inner_body }
    var body: []checker::TStatement = cgt_empty_stmts()
    body = teko::list::push(body, adopt_s)
    body = teko::list::push(body, cgt_ret(cgt_num_i64(3)))
    var f = cgt_fn0("cgt_fn_adopt", "teko::cgt", ret_type, body)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_adopt"))
    teko::assert::is_true(teko::str::contains(r, "tk_region_new"))
    teko::assert::is_true(teko::str::contains(r, "tk_region_drop_subtree"))

    var named_s: checker::TStatement = checker::TAdoptStmt { name = "r"; body = inner_body }
    var nested_body: []checker::TStatement = teko::list::push(cgt_empty_stmts(), named_s)
    var outer_s: checker::TStatement = checker::TAdoptStmt { name = ""; body = nested_body }
    var body2: []checker::TStatement = cgt_empty_stmts()
    body2 = teko::list::push(body2, outer_s)
    body2 = teko::list::push(body2, cgt_ret(cgt_num_i64(3)))
    var f2 = cgt_fn0("cgt_fn_adopt_nested", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_adopt_nested"))
    teko::assert::is_true(count_substr(r2, "tk_region_drop_subtree") >= 2)
}

/**
 * count_substr — the number of non-overlapping occurrences of `needle` in `hay`. Used by the
 * nested-adopt test to prove BOTH the inner and outer adopters emit a subtree-drop.
 *
 * @param str hay  the text to search
 * @param str needle  the substring to count (non-empty)
 * @return u64  the occurrence count
 */
fn count_substr(hay: str, needle: str): u64 {
    if needle.len == 0 { return 0 }
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i + needle.len > hay.len { break }
        if teko::str::contains(teko::str::slice(hay, i, i + needle.len), needle) { n = n + 1; i = i + needle.len } else { i = i + 1 }
    }
    n
}

// ---------------------------------------------------------------------------
// Helper: 3-segment path for teko::list::empty / push
// ---------------------------------------------------------------------------
fn cgt_path3(a: str, b: str, c: str): parser::Path {
    var s1: []parser::Segment = teko::list::push(teko::list::empty(), cgt_seg(a))
    var s2: []parser::Segment = teko::list::push(s1, cgt_seg(b))
    var s3: []parser::Segment = teko::list::push(s2, cgt_seg(c))
    parser::Path { segments = s3 }
}

// ---------------------------------------------------------------------------
// Group O: type-name mangling helpers
//   cg_opt_typename, cg_slice_typename, cg_emit_variant_ctype,
//   cg_opt_mangle_texpr_str, cg_member_key_texpr_str,
//   cg_variant_typename_texpr, cg_opt_mangle_texpr
// ---------------------------------------------------------------------------
#test
fn cgt_mangle_helpers() {
    // cg_opt_typename: Str inner → "tk_opt_str"
    var opt_r = match cg_opt_typename(cgt_empty(), checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(opt_r, "tk_opt_str"))

    // cg_slice_typename: I64 element → "tk_slice_i64"
    var sl_r = match cg_slice_typename(cgt_empty(), checker::Prim { kind = checker::PrimKind::I64 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(sl_r, "tk_slice_i64"))

    // cg_emit_variant_ctype: Named "Foo" → "tk_t_Foo"
    var vc_r = match cg_emit_variant_ctype(cgt_empty(), checker::Named { name = "Foo" }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(vc_r, "Foo"))

    // cg_opt_mangle_texpr_str: NamedType "str" → "str"
    var oms = match cg_opt_mangle_texpr_str(cgt_named_te("str")) { str as s => s; error => "" }
    teko::assert::is_true(oms == "str")

    // cg_member_key_texpr_str: "bool" (C keyword) → "bool_"; "i64" → "i64"
    var mks_bool = match cg_member_key_texpr_str(cgt_named_te("bool")) { str as s => s; error => "" }
    teko::assert::is_true(mks_bool == "bool_")
    var mks_i64 = match cg_member_key_texpr_str(cgt_named_te("i64")) { str as s => s; error => "" }
    teko::assert::is_true(mks_i64 == "i64")

    // cg_variant_typename_texpr: UnionType[str, error] → "tk_u_str_error"
    var um1: []parser::TypeExpr = teko::list::push(teko::list::empty(), cgt_named_te("str"))
    var um2: []parser::TypeExpr = teko::list::push(um1, cgt_named_te("error"))
    var ut = parser::UnionType { members = um2 }
    var vtt = match cg_variant_typename_texpr(cgt_empty(), ut) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(vtt, "tk_u_str_error"))

    // cg_opt_mangle_texpr: NamedType "u64" → "u64"
    var omt = match cg_opt_mangle_texpr(cgt_empty(), cgt_named_te("u64")) { []byte as o => str(o); error => "" }
    teko::assert::is_true(omt == "u64")
}

// ---------------------------------------------------------------------------
// Group P: by-value cycle detection + variant membership
//   cg_te_reaches_byvalue, cg_name_reaches_byvalue,
//   cg_field_boxed, cg_variant_has_member
// ---------------------------------------------------------------------------
#test
fn cgt_byvalue_boxed_variant() {
    // cg_te_reaches_byvalue: "str" is a prim name → returns false immediately
    var reaches_prim = cg_te_reaches_byvalue(cgt_prog(), cgt_named_te("str"), "Foo", teko::list::empty())
    teko::assert::is_false(reaches_prim)

    // cg_te_reaches_byvalue: "Box" is not a prim name, not == "Foo" →
    // calls cg_name_reaches_byvalue; empty prog → cg_find_decl returns error → false
    var reaches_box = cg_te_reaches_byvalue(cgt_prog(), cgt_named_te("Box"), "Foo", teko::list::empty())
    teko::assert::is_false(reaches_box)

    // cg_field_boxed: SliceType is not a box candidate → false
    var slice_te = parser::SliceType { element = cgt_named_te("i64") }
    var field_boxed = cg_field_boxed(cgt_prog(), "MyStruct", slice_te)
    teko::assert::is_false(field_boxed)

    // cg_variant_has_member: variant TypeDecl with "i64" and "str" members
    var vm1: []parser::TypeExpr = teko::list::push(teko::list::empty(), cgt_named_te("i64"))
    var vm2: []parser::TypeExpr = teko::list::push(vm1, cgt_named_te("str"))
    var vbody = parser::VariantBody { type_expr = parser::UnionType { members = vm2 } }
    var vdecl = parser::TypeDecl { name = "MyV"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = vbody; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0}
    teko::assert::is_true(cg_variant_has_member(vdecl, "i64"))
    teko::assert::is_false(cg_variant_has_member(vdecl, "unknown"))
}

// ---------------------------------------------------------------------------
// Group Q: emit_call, emit_list_empty, get_push_elem, emit_list_push,
//           emit_field_access (slice.len + Named receiver → cg_find_struct_field_type)
// ---------------------------------------------------------------------------
#test
fn cgt_emit_calls_and_field() {
    // emit_call builtin: "print" → tk_print(...)
    var print_arg = checker::TExpr {
        kind = checker::TStrLit { text = "hi" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var print_args: []checker::TExpr = teko::list::push(teko::list::empty(), print_arg)
    var print_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path1("print"); args = print_args; call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Void { }
        line = 0; col = 0
    }
    var print_out = match emit_expr(cgt_empty(), cgt_prog(), print_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(print_out, "tk_print"))

    // emit_list_empty: TCall to teko::list::empty with Slice{I64} result type
    var empty_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path3("teko", "list", "empty"); args = teko::list::empty(); call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var empty_out = match emit_expr(cgt_empty(), cgt_prog(), empty_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(empty_out, "tk_slice_i64"))

    // emit_list_push / get_push_elem: TCall to teko::list::push with base+item args
    var base_arg = checker::TExpr {
        kind = checker::TVar { name = "xs"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var push_args: []checker::TExpr = teko::list::push(teko::list::push(teko::list::empty(), base_arg), cgt_num_i64(42))
    var push_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path3("teko", "list", "push"); args = push_args; call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var push_out = match emit_expr(cgt_empty(), cgt_prog(), push_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(push_out.len > 0)
    teko::assert::is_true(teko::str::contains(push_out, "tk_slice_push"))

    // emit_field_access — slice.len → simple path
    var slice_recv = checker::TExpr {
        kind = checker::TVar { name = "xs"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var fa_slice_e = checker::TExpr {
        kind = checker::TFieldAccess { receiver = slice_recv; field = "len" }
        type = checker::Prim { kind = checker::PrimKind::U64 }
        line = 0; col = 0
    }
    var fa_slice_out = match emit_expr(cgt_empty(), cgt_prog(), fa_slice_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(fa_slice_out, ".len"))

    // emit_field_access — Named receiver → cg_find_struct_field_type (empty prog → null → fa_boxed=false)
    var named_recv = checker::TExpr {
        kind = checker::TVar { name = "box_val"; is_func = false; func_ns = "" }
        type = checker::Named { name = "Box" }
        line = 0; col = 0
    }
    var fa_named_e = checker::TExpr {
        kind = checker::TFieldAccess { receiver = named_recv; field = "value" }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var fa_named_out = match emit_expr(cgt_empty(), cgt_prog(), fa_named_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(fa_named_out, "box_val"))
}

// ---------------------------------------------------------------------------
// Group R: emit_index (slice), emit_in, emit_array_lit, emit_interp (+ emit_piece_lit)
// ---------------------------------------------------------------------------
#test
fn cgt_emit_index_in_array_interp() {
    // emit_index — slice receiver: bounds-checked element access
    var slice_recv = checker::TExpr {
        kind = checker::TVar { name = "items"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var ix_e = checker::TExpr {
        kind = checker::TIndex { receiver = slice_recv; index = cgt_num_i64(0) }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var ix_out = match emit_expr(cgt_empty(), cgt_prog(), ix_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(ix_out, "items"))
    teko::assert::is_true(teko::str::contains(ix_out, "tk_panic_oob"))

    // emit_in — non-empty element list: lhs in [42]
    var in_elems: []checker::TExpr = teko::list::push(teko::list::empty(), cgt_num_i64(42))
    var in_node = checker::TInExpr { lhs = cgt_num_i64(7); elems = in_elems }
    var in_e = checker::TExpr {
        kind = in_node
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var in_out = match emit_expr(cgt_empty(), cgt_prog(), in_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(in_out, "=="))

    // emit_in — STR lhs: "x" in ["get"] routes through tk_str_eq, never struct `==` (issue #47)
    var str_lhs = checker::TExpr {
        kind = checker::TVar { name = "meth"; is_func = false; func_ns = "" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var str_elem = checker::TExpr {
        kind = checker::TStrLit { text = "get" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var sin_elems: []checker::TExpr = teko::list::push(teko::list::empty(), str_elem)
    var sin_e = checker::TExpr {
        kind = checker::TInExpr { lhs = str_lhs; elems = sin_elems }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var sin_out = match emit_expr(cgt_empty(), cgt_prog(), sin_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(sin_out, "tk_str_eq("))
    teko::assert::is_false(teko::str::contains(sin_out, "=="))

    // emit_array_lit — one-element array [42] of I64 (plain, no spread)
    var arr_ae: checker::TArrayElem = checker::TArrayElem { is_spread = false; expr = cgt_num_i64(42) }
    var arr_elems: []checker::TArrayElem = teko::list::push(teko::list::empty(), arr_ae)
    var arr_e = checker::TExpr {
        kind = checker::TArrayLit { elements = arr_elems }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var arr_out = match emit_expr(cgt_empty(), cgt_prog(), arr_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(arr_out, "malloc"))
    teko::assert::is_true(teko::str::contains(arr_out, "tk_slice_i64"))

    // emit_interp — $"pre_{n}_suf" with one i64 hole: pieces=["pre_","_suf"], holes=[i64_expr]
    var interp_pieces1: []str = teko::list::push(teko::list::empty(), "pre_")
    var interp_pieces: []str = teko::list::push(interp_pieces1, "_suf")
    var interp_holes: []checker::TExpr = teko::list::push(teko::list::empty(), cgt_num_i64(7))
    var interp_node = checker::TInterp { pieces = interp_pieces; holes = interp_holes; specs = teko::list::empty() }
    var interp_e = checker::TExpr {
        kind = interp_node
        type = checker::Str { }
        line = 0; col = 0
    }
    var interp_out = match emit_expr(cgt_empty(), cgt_prog(), interp_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(interp_out, "tk_str_concat"))
    teko::assert::is_true(teko::str::contains(interp_out, "tk_i64_to_str"))
}

// emit_pat_test — literal patterns against the subject temp `_s` (issue #47): an INT literal
// tests via bare `==`; a STR literal routes through tk_str_eq over the (tk_str){…} compound
// literal (a tk_str is a {ptr,len} struct — C `==` is invalid on it).
#test
fn cgt_emit_lit_pattern_str_vs_int() {
    // int literal pattern: (_s == 42)
    var int_pat: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { value = parser::numint_of_u64(42); is_float = false; fval = 0.0 }; line = 0; col = 0 }
    }
    var int_out = match emit_pat_test(cgt_empty(), cgt_prog(), int_pat, "_s", checker::Prim { kind = checker::PrimKind::I64 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(int_out, "(_s == "))   // bare C `==` (cb_i64 spells the constant)
    teko::assert::is_true(teko::str::contains(int_out, "42"))
    teko::assert::is_false(teko::str::contains(int_out, "tk_str_eq"))

    // str literal pattern: tk_str_eq(_s, (tk_str){ (const tk_byte *)"build", 5 })
    var str_pat: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::StrLit { text = "build" }; line = 0; col = 0 }
    }
    var str_out = match emit_pat_test(cgt_empty(), cgt_prog(), str_pat, "_s", checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(str_out, "tk_str_eq(_s, (tk_str){ (const tk_byte *)\"build\", 5 })"))
    teko::assert::is_false(teko::str::contains(str_out, "=="))
}

// ---------------------------------------------------------------------------
// Group S: cg_expr_diverges (still live — checked directly by emit_expr_stmt's
// diverging-call value-position handling)
// ---------------------------------------------------------------------------
#test
fn cgt_cg_expr_diverges_true_only_for_a_panic_exit_call() {
    // direct call — non-TCall returns false, TCall to "panic" returns true
    var non_call_e = cgt_num_i64(0)
    teko::assert::is_false(cg_expr_diverges(non_call_e))
    var panic_arg = checker::TExpr {
        kind = checker::TStrLit { text = "oops" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var panic_args: []checker::TExpr = teko::list::push(teko::list::empty(), panic_arg)
    var panic_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path1("panic"); args = panic_args; call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Void { }
        line = 0; col = 0
    }
    teko::assert::is_true(cg_expr_diverges(panic_e))
}

