}

#test
fn cgt_byvalue_boxed_variant() {
    var reaches_prim = cg_te_reaches_byvalue(cgt_prog(), cgt_named_te("str"), "Foo", teko::list::empty())
    teko::assert::is_false(reaches_prim)

    var reaches_box = cg_te_reaches_byvalue(cgt_prog(), cgt_named_te("Box"), "Foo", teko::list::empty())
    teko::assert::is_false(reaches_box)

    var slice_te = parser::SliceType { element = cgt_named_te("i64") }
    var field_boxed = cg_field_boxed(cgt_prog(), "MyStruct", slice_te)
    teko::assert::is_false(field_boxed)

    var vm1: []@TypeExpr() = teko::list::push(teko::list::empty(), cgt_named_te("i64"))
    var vm2: []@TypeExpr() = teko::list::push(vm1, cgt_named_te("str"))
    var vbody = parser::VariantBody { type_expr = parser::UnionType { members = vm2 } }
    var vdecl = parser::TypeDecl { name = "MyV"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = vbody; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; is_global = false }
    teko::assert::is_true(cg_variant_has_member(vdecl, "i64"))
    teko::assert::is_false(cg_variant_has_member(vdecl, "unknown"))
}

#test
fn cgt_emit_calls_and_field() {
    var print_arg = checker::TExpr {
        kind = checker::TStrLit { text = "hi" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var print_args: []checker::TExpr = teko::list::push(teko::list::empty(), print_arg)
    var print_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path1("print"); args = print_args; call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Void { }
        line = 0; col = 0
    }
    var print_out = match emit_expr(cgt_empty(), cgt_prog(), print_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(print_out, "tk_print"))

    var empty_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path3("teko", "list", "empty"); args = teko::list::empty(); call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var empty_out = match emit_expr(cgt_empty(), cgt_prog(), empty_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(empty_out, "tk_slice_i64"))

    var base_arg = checker::TExpr {
        kind = checker::TVar { name = "xs"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var push_args: []checker::TExpr = teko::list::push(teko::list::push(teko::list::empty(), base_arg), cgt_num_i64(42))
    var push_e = checker::TExpr {
        kind = checker::TCall { overload_suffix = ""; callee = cgt_path3("teko", "list", "push"); args = push_args; call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var push_out = match emit_expr(cgt_empty(), cgt_prog(), push_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(push_out.len > 0)
    teko::assert::is_true(teko::str::contains(push_out, "tk_slice_push"))

    var slice_recv = checker::TExpr {
        kind = checker::TVar { name = "xs"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var fa_slice_e = checker::TExpr {
        kind = checker::TFieldAccess { receiver = slice_recv; field = "len" }
        type = checker::Prim { kind = checker::PrimKind::U64 }
        line = 0; col = 0
    }
    var fa_slice_out = match emit_expr(cgt_empty(), cgt_prog(), fa_slice_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(fa_slice_out, ".len"))

    var named_recv = checker::TExpr {
        kind = checker::TVar { name = "box_val"; is_func = false; func_ns = "" }
        type = checker::Named { name = "Box" }
        line = 0; col = 0
    }
    var fa_named_e = checker::TExpr {
        kind = checker::TFieldAccess { receiver = named_recv; field = "value" }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var fa_named_out = match emit_expr(cgt_empty(), cgt_prog(), fa_named_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(fa_named_out, "box_val"))
}

#test
fn cgt_emit_index_in_array_interp() {
    var slice_recv = checker::TExpr {
        kind = checker::TVar { name = "items"; is_func = false; func_ns = "" }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var ix_e = checker::TExpr {
        kind = checker::TIndex { receiver = slice_recv; index = cgt_num_i64(0) }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var ix_out = match emit_expr(cgt_empty(), cgt_prog(), ix_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(ix_out, "items"))
    teko::assert::is_true(teko::str::contains(ix_out, "tk_panic_oob"))

    var in_elems: []checker::TExpr = teko::list::push(teko::list::empty(), cgt_num_i64(42))
    var in_node = checker::TInExpr { lhs = cgt_num_i64(7); elems = in_elems }
    var in_e = checker::TExpr {
        kind = in_node
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var in_out = match emit_expr(cgt_empty(), cgt_prog(), in_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(in_out, "=="))

    var str_lhs = checker::TExpr {
        kind = checker::TVar { name = "meth"; is_func = false; func_ns = "" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var str_elem = checker::TExpr {
        kind = checker::TStrLit { text = "get" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var sin_elems: []checker::TExpr = teko::list::push(teko::list::empty(), str_elem)
    var sin_e = checker::TExpr {
        kind = checker::TInExpr { lhs = str_lhs; elems = sin_elems }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var sin_out = match emit_expr(cgt_empty(), cgt_prog(), sin_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(sin_out, "tk_str_eq("))
    teko::assert::is_false(teko::str::contains(sin_out, "=="))

    var arr_ae: checker::TArrayElem = checker::TArrayElem { is_spread = false; expr = cgt_num_i64(42) }
    var arr_elems: []checker::TArrayElem = teko::list::push(teko::list::empty(), arr_ae)
    var arr_e = checker::TExpr {
        kind = checker::TArrayLit { elements = arr_elems }
        type = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var arr_out = match emit_expr(cgt_empty(), cgt_prog(), arr_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(arr_out, "malloc"))
    teko::assert::is_true(teko::str::contains(arr_out, "tk_slice_i64"))

    var interp_pieces1: []str = teko::list::push(teko::list::empty(), "pre_")
    var interp_pieces: []str = teko::list::push(interp_pieces1, "_suf")
    var interp_holes: []checker::TExpr = teko::list::push(teko::list::empty(), cgt_num_i64(7))
    var interp_node = checker::TInterp { pieces = interp_pieces; holes = interp_holes; specs = teko::list::empty() }
    var interp_e = checker::TExpr {
        kind = interp_node
        type = checker::Str { }
        line = 0; col = 0
    }
    var interp_out = match emit_expr(cgt_empty(), cgt_prog(), interp_e) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(interp_out, "tk_str_concat"))
    teko::assert::is_true(teko::str::contains(interp_out, "tk_i64_to_str"))
}

#test
fn cgt_emit_lit_pattern_str_vs_int() {
    var int_pat: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { value = parser::numint_of_u64(42); is_float = false; fval = 0.0 }; line = 0; col = 0 }
    }
    var int_out = match emit_pat_test(cgt_empty(), cgt_prog(), int_pat, "_s", checker::Prim { kind = checker::PrimKind::I64 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(int_out, "(_s == "))
    teko::assert::is_true(teko::str::contains(int_out, "42"))
    teko::assert::is_false(teko::str::contains(int_out, "tk_str_eq"))

    var str_pat: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::StrLit { text = "build" }; line = 0; col = 0 }
    }
    var str_out = match emit_pat_test(cgt_empty(), cgt_prog(), str_pat, "_s", checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(str_out, "tk_str_eq(_s, (tk_str){ (const tk_byte *)\"build\", 5 })"))
    teko::assert::is_false(teko::str::contains(str_out, "=="))
}

