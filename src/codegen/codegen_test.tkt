fn cgt_class_decl(name: str, kind: parser::ClassKind, has_base: bool, base_name: str): parser::TypeDecl {
    parser::TypeDecl {
        name = name
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        body = parser::ClassBody {
            kind = kind
            has_base = has_base
            base_name = base_name
            has_base_binding = false
            base_binding_name = ""
            implements = teko::list::empty()
            fields = teko::list::empty()
            methods = teko::list::empty()
            consts = teko::list::empty()
            is_service = false
            service_lifetime = parser::ServiceLifetime::Singleton
        }
        vis = parser::Visibility::Pub
        has_doc = false
        doc = ""
        line = 0; col = 0
   ; is_global = false }
}

#test
fn cgt_vtable_pair_gate_excludes_abstract_self() {
    var parent = cgt_class_decl("Base", parser::ClassKind::Abstract, false, "")
    var sub = cgt_class_decl("Sub", parser::ClassKind::Sealed, true, "Base")
    var vbase = cgt_class_decl("VBase", parser::ClassKind::Virtual, false, "")
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, parent)
    items = teko::list::push(items, sub)
    items = teko::list::push(items, vbase)
    var prog = cg_prog_of(checker::TProgram { items = items })

    teko::assert::is_true(cg_class_is_abstract(parent))
    teko::assert::is_true(!cg_class_is_abstract(sub))
    teko::assert::is_true(!cg_class_is_abstract(vbase))

    teko::assert::is_true(!cg_pair_is_base_vtable(prog, parent, parent))
    teko::assert::is_true(cg_pair_is_base_vtable(prog, sub, parent))
    teko::assert::is_true(cg_pair_is_base_vtable(prog, vbase, vbase))
}

#test
fn cgt_mangle_eq() {
    var i32t: @Type() = checker::Prim { kind = checker::PrimKind::I32 }
    var u8t: @Type() = checker::Prim { kind = checker::PrimKind::U8 }
    var strt: @Type() = checker::Str { }
    var named_str: @Type() = checker::Named { name = "str" }
    var reader_io: @Type() = checker::Named { name = "teko::io::Reader" }
    var reader_emit: @Type() = checker::Named { name = "teko::emit::Reader" }
    var writer: @Type() = checker::Named { name = "teko::io::Writer" }
    var slice_str: @Type() = checker::Slice { element = strt }
    var slice_str2: @Type() = checker::Slice { element = checker::Str { } }
    var named_slice_str: @Type() = checker::Named { name = "slice_str" }
    var slice_reader_a: @Type() = checker::Slice { element = reader_io }
    var slice_reader_b: @Type() = checker::Slice { element = reader_emit }
    var slice_i64: @Type() = checker::Slice { element = checker::Prim { kind = checker::PrimKind::I64 } }
    var va_members: []@Type() = teko::list::empty()
    va_members = teko::list::push(va_members, i32t)
    va_members = teko::list::push(va_members, u8t)
    var variant_a: @Type() = checker::Variant { members = va_members }
    var vb_members: []@Type() = teko::list::empty()
    vb_members = teko::list::push(vb_members, strt)
    vb_members = teko::list::push(vb_members, i32t)
    var variant_b: @Type() = checker::Variant { members = vb_members }

    teko::assert::is_true(cg_mangle_eq(i32t, i32t))
    teko::assert::is_false(cg_mangle_eq(i32t, u8t))
    teko::assert::is_true(cg_mangle_eq(reader_io, reader_emit))
    teko::assert::is_false(cg_mangle_eq(reader_io, writer))
    teko::assert::is_true(cg_mangle_eq(slice_str, slice_str2))
    teko::assert::is_false(cg_mangle_eq(slice_str, slice_i64))
    teko::assert::is_true(cg_mangle_eq(named_slice_str, slice_str))
    teko::assert::is_true(cg_mangle_eq(strt, named_str))
    teko::assert::is_true(cg_mangle_eq(slice_reader_a, slice_reader_b))
    teko::assert::is_true(cg_mangle_eq(variant_a, variant_b))
    teko::assert::is_false(cg_mangle_eq(variant_a, i32t))

    teko::assert::is_true(cg_opt_key(i32t) == cg_opt_key(i32t))
    teko::assert::is_false(cg_opt_key(i32t) == cg_opt_key(u8t))
    teko::assert::is_true(cg_opt_key(reader_io) == cg_opt_key(reader_emit))
    teko::assert::is_false(cg_opt_key(reader_io) == cg_opt_key(writer))
    teko::assert::is_true(cg_opt_key(slice_str) == cg_opt_key(slice_str2))
    teko::assert::is_false(cg_opt_key(slice_str) == cg_opt_key(slice_i64))
    teko::assert::is_true(cg_opt_key(named_slice_str) == cg_opt_key(slice_str))
    teko::assert::is_true(cg_opt_key(strt) == cg_opt_key(named_str))
    teko::assert::is_true(cg_opt_key(slice_reader_a) == cg_opt_key(slice_reader_b))
    teko::assert::is_true(cg_opt_key(variant_a) == cg_opt_key(variant_b))
    teko::assert::is_false(cg_opt_key(variant_a) == cg_opt_key(i32t))
}

#test
fn cgt_dedup_key_cache() {
    var strt: @Type() = checker::Str { }
    var i64t: @Type() = checker::Prim { kind = checker::PrimKind::I64 }
    var set = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }

    set = cg_slice_add(set, strt)
    set = cg_slice_add(set, strt)
    teko::assert::is_true(set.slices.len == 1)
    teko::assert::is_true(set.slice_keys.len == set.slices.len)
    teko::assert::is_true(set.slice_keys[0] == cg_opt_key(set.slices[0]))

    var va_members: []@Type() = teko::list::empty()
    va_members = teko::list::push(va_members, i64t)
    va_members = teko::list::push(va_members, strt)
    var variant_a: @Type() = checker::Variant { members = va_members }
    set = cg_variant_add(set, variant_a)
    set = cg_variant_add(set, variant_a)
    teko::assert::is_true(set.variants.len == 1)
    teko::assert::is_true(set.variant_keys.len == set.variants.len)
    teko::assert::is_true(set.variant_keys[0] == cg_variant_key(set.variants[0]))
}

fn cgt_var2(a: @Type(), b: @Type()): checker::Variant {
    var ms: []@Type() = teko::list::empty()
    ms = teko::list::push(ms, a)
    ms = teko::list::push(ms, b)
    checker::Variant { members = ms }
}

fn cgt_pair16_decl(): parser::TypeDecl {
    var fx = parser::Field { name = "x"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = ""; is_readonly = false }
    var fy = parser::Field { name = "y"; type_ann = cgt_named_te("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = ""; is_readonly = false }
    var fields: []parser::Field = teko::list::push(teko::list::push(teko::list::empty(), fx), fy)
    var body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }
    parser::TypeDecl { name = "Pair16"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; is_global = false }
}

fn cgt_prog_with_pair16(): CgProg {
    var items: []@TItem() = teko::list::push(teko::list::empty(), cgt_pair16_decl())
    cg_prog_of(checker::TProgram { items = items })
}

fn cgt_pair16_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Named { name = "Pair16" })
}

fn cgt_pair16_expr(): checker::TExpr {
    var names: []str = teko::list::push(teko::list::push(teko::list::empty(), "x"), "y")
    var vals: []checker::TExpr = teko::list::push(teko::list::push(teko::list::empty(), cgt_num_i64(1)), cgt_num_i64(2))
    checker::TExpr {
        kind = checker::TStructInit { field_names = names; field_vals = vals }
        type = checker::Named { name = "Pair16" }
        line = 0; col = 0
    }
}

fn cgt_i32_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Prim { kind = checker::PrimKind::I32 })
}

fn cgt_ptr_null(): checker::Variant {
    cgt_var2(checker::Null { }, checker::Ptr { inner = null })
}

#test
fn cgt_union_repr_class_dial() {
    var p = cgt_prog_with_pair16()
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), false) { UnionRepr::BoxInArena => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_pair16_null(), true) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_i32_null(), false) { UnionRepr::InlineTag => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), false) { UnionRepr::Niche => true; _ => false })
    teko::assert::is_true(match union_repr_class(p, cgt_ptr_null(), true) { UnionRepr::Niche => true; _ => false })
}

#test
fn cgt_boxed_union_wrap_uses_requested_local_region() {
    var p = cgt_prog_with_pair16()
    var expected: @Type() = cgt_pair16_null()
    var wrapped = match emit_as_r_in(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), "_tkbr0", teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(_tkbr0, sizeof("))
}

#test
fn cgt_boxed_union_wrap_defaults_to_root_region() {
    var p = cgt_prog_with_pair16()
    var expected: @Type() = cgt_pair16_null()
    var wrapped = match emit_as_r(cgt_empty(), p, checker::Void { }, expected, cgt_pair16_expr(), teko::list::empty(), teko::list::empty(), teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(wrapped, "tk_region_alloc(tk_region_root(), sizeof("))
}

#test
fn cgt_inline_attr_eligible_classes() {
    var p = cgt_prog_with_pair16()
    var pairbox: @Type() = cgt_pair16_null()
    teko::assert::is_true(match inline_attr_eligible(p, pairbox) { error => false; null => true })
    teko::assert::is_true(match inline_attr_eligible(p, checker::Prim { kind = checker::PrimKind::I32 }) { error => true; null => false })
    var i32inline: @Type() = cgt_i32_null()
    teko::assert::is_true(match inline_attr_eligible(p, i32inline) { error => true; null => false })
    var ptrniche: @Type() = cgt_ptr_null()
    teko::assert::is_true(match inline_attr_eligible(p, ptrniche) { error => true; null => false })
}

type CgtManglePair = struct {
    ns: str
    name: str
}

fn cgt_mangle_parity_pairs(): []CgtManglePair {
    var xs: []CgtManglePair = teko::list::empty()
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::checker"; name = "type_eq" })
    xs = teko::list::push(xs, CgtManglePair { ns = "demo"; name = "add" })
    xs = teko::list::push(xs, CgtManglePair { ns = ""; name = "lifted" })
    xs = teko::list::push(xs, CgtManglePair { ns = "teko::math"; name = "div" })
    xs
}

#test
fn cgt_mangle_parity_c_and_native() {
    var pairs = cgt_mangle_parity_pairs()
    var i: u64 = 0
    loop {
        if i >= pairs.len { break }
        var c_side = str(cb_fn_name(cgt_empty(), pairs[i].ns, pairs[i].name))
        var native_side = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name)
        teko::assert::is_true(c_side == native_side)
        teko::assert::is_true(teko::str::slice_to(c_side, TEKO_USER_PREFIX.len) == TEKO_USER_PREFIX)
        i++
    }
}

#test
fn cgt_mangle_native_flat_strips_prefix_only() {
    var pairs = cgt_mangle_parity_pairs()
    var i: u64 = 0
    loop {
        if i >= pairs.len { break }
        var prefixed = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name)
        var flat = teko::lir::mangle_fn_symbol(pairs[i].ns, pairs[i].name, true)
        teko::assert::is_true(prefixed == teko::str::concat(TEKO_USER_PREFIX, flat))
        i++
    }
    teko::assert::is_true(teko::lir::mangle_fn_symbol("ar_link_run", "add", true) == "ar_link_run__add")
}

#test
fn cgt_mangle_spells_prefix_namespace_and_name() {
    teko::assert::is_true(str(cb_fn_name(cgt_empty(), "teko::checker", "type_eq")) == "teko_teko__checker__type_eq")
    teko::assert::is_true(str(cb_fn_name(cgt_empty(), "", "lifted")) == "teko_lifted")
}

fn cgt_call_ns(ns: str, name: str): checker::TCall {
    checker::TCall { overload_suffix = "";
        callee = cgt_path1(name); args = teko::list::empty(); call_ns = ns
        is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
}

fn cgt_prog_with_colliding_names(): CgProg {
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, cgt_fn0("arena_push", "probe::mine", checker::Void { }, cgt_empty_stmts()))
    var ext = cgt_fn0("getpid", "probe::sys", checker::Void { }, cgt_empty_stmts())
    items = teko::list::push(items, checker::TFunction { overload_suffix = "";
            name = ext.name; type_params = ext.type_params; type_constraints = ext.type_constraints
            namespace = ext.namespace; params = ext.params; return_type = ext.return_type; body = ext.body
            vis = ext.vis; has_doc = ext.has_doc; doc = ext.doc; file = ext.file; line = ext.line; col = ext.col
            is_test = ext.is_test; is_extern = true; c_symbol = "getpid"; from_lib = "c"
            has_arena_size = ext.has_arena_size; arena_size = ext.arena_size; ret_extra = ext.ret_extra; guard = parser::pred_true() })
    cg_prog_of(checker::TProgram { items = items })
}

#test
fn cgt_user_declared_beats_a_bare_builtin_name() {
    var prog = cgt_prog_with_colliding_names()
    teko::assert::is_true(cg_call_is_user_declared(prog, cgt_call_ns("probe::mine", "arena_push")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("", "arena_push")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("probe::sys", "getpid")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("teko::mem", "free")))
    teko::assert::is_true(!cg_call_is_user_declared(prog, cgt_call_ns("", "println")))
}

fn cgt_test_fn(name: str, ns: str): checker::TFunction {
    var fn0 = cgt_fn0(name, ns, checker::Void { }, cgt_empty_stmts())
    checker::TFunction { overload_suffix = "";
        name = fn0.name; type_params = fn0.type_params; type_constraints = fn0.type_constraints
        namespace = fn0.namespace; params = fn0.params; return_type = fn0.return_type; body = fn0.body
        vis = fn0.vis; has_doc = fn0.has_doc; doc = fn0.doc; file = fn0.file; line = fn0.line; col = fn0.col
        is_test = true; is_extern = fn0.is_extern; c_symbol = fn0.c_symbol; from_lib = fn0.from_lib
        has_arena_size = fn0.has_arena_size; arena_size = fn0.arena_size; ret_extra = fn0.ret_extra; guard = parser::pred_true() }
}

fn cgt_prog_with_one_test(): CgProg {
    var items: []@TItem() = teko::list::push(teko::list::empty(), cgt_test_fn("cgt_captured_body", "probe::guard"))
    cg_prog_of(checker::TProgram { items = items })
}

fn cgt_captured_run_line(): str {
    teko::str::concat("tk_test_outcome teko_journal_rv = tk_test_run(&", TEKO_USER_PREFIX, "probe__guard__cgt_captured_body);")
}

fn cgt_journal_symbol(name: str): str { teko::str::concat(TEKO_USER_PREFIX, "teko__journal__", name) }

#test
fn cgt_the_harness_runs_every_body_under_capture() {
    var one = str(emit_test_call(cgt_empty(), cgt_test_fn("cgt_captured_body", "probe::guard"), 0 to u64, false))
    teko::assert::is_true(teko::str::contains(one, cgt_captured_run_line()))
    teko::assert::is_true(teko::str::contains(one, "tk_test_report(teko_journal_rv);"))
    teko::assert::is_true(!teko::str::contains(one, "tk_test_end();"))
    teko::assert::is_true(teko::str::contains(one, "tk_arena_push();"))
    teko::assert::is_true(teko::str::contains(one, "tk_arena_pop();"))
    teko::assert::is_true(teko::str::contains(one, "tk_test_begin("))
}

#test
fn cgt_the_harness_notes_begin_ok_exited_and_panicked_to_the_journal() {
    var one = str(emit_test_call(cgt_empty(), cgt_test_fn("cgt_captured_body", "probe::guard"), 0 to u64, false))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_begin")))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_ok")))
    teko::assert::is_true(teko::str::contains(one, cgt_journal_symbol("note_test_panicked")))
    teko::assert::is_true(teko::str::contains(one, teko::str::concat(cgt_journal_symbol("note_test_exited"), "((tk_str){")))
    teko::assert::is_true(teko::str::contains(one, "}, teko_journal_rv.code);"))
    teko::assert::is_true(teko::str::contains(one, "if (teko_journal_rv.how == TK_TEST_OK)"))
    teko::assert::is_true(teko::str::contains(one, "else if (teko_journal_rv.how == TK_TEST_EXITED)"))
}

#test
fn cgt_the_harness_ends_on_the_tally_and_not_on_zero() {
    var main_plain = match emit_test_main(cgt_empty(), cgt_prog_with_one_test(), CgMode::TestPlain) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(main_plain, "tk_test_summary();"))
    teko::assert::is_true(teko::str::contains(main_plain, cgt_journal_symbol("note_test_end")))
    teko::assert::is_true(teko::str::contains(main_plain, "return tk_test_any_failed() ? 1 : 0;"))
    teko::assert::is_true(!teko::str::contains(main_plain, "return 0;"))
    var main_analyze = match emit_test_main(cgt_empty(), cgt_prog_with_one_test(), CgMode::TestAnalyze) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(main_analyze, cgt_captured_run_line()))
    teko::assert::is_true(teko::str::contains(main_analyze, "tk_test_summary();"))
    teko::assert::is_true(teko::str::contains(main_analyze, cgt_journal_symbol("note_test_end")))
    teko::assert::is_true(teko::str::contains(main_analyze, "return tk_test_any_failed() ? 1 : 0;"))
    teko::assert::is_true(!teko::str::contains(main_analyze, "return 0;"))
}
