
use teko::checker
use teko::lexer
use teko::parser

fn cgt_empty(): []byte { teko::list::empty() }
fn cgt_prog(): CgProg { cg_prog_of(checker::TProgram { items = teko::list::empty() }) }

fn cgt_seg(s: str): parser::Segment { parser::Segment { name = s } }
fn cgt_path1(s: str): parser::Path {
    parser::Path { segments = teko::list::push(teko::list::empty(), cgt_seg(s)) }
}
fn cgt_named_te(s: str): @TypeExpr() {
    parser::NamedType { path = cgt_path1(s); args = teko::list::empty() }
}

fn cgt_num(v: i64, k: checker::PrimKind): checker::TExpr {
    checker::TExpr {
        kind = checker::TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }
        type = checker::Prim { kind = k }
        line = 0; col = 0
    }
}
fn cgt_num_i64(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I64) }
fn cgt_num_i8(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I8) }
fn cgt_num_i32(v: i64): checker::TExpr { cgt_num(v, checker::PrimKind::I32) }

fn cgt_e_bool_t(): checker::TExpr {
    checker::TExpr {
        kind = checker::TBoolLit { value = true }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
}
fn cgt_e_var(name: str): checker::TExpr {
    checker::TExpr {
        kind = checker::TVar { name = name; is_func = false; func_ns = "" }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
}

fn cgt_stmt(e: checker::TExpr): @TStatement() { checker::TExprStmt { expr = e } }
fn cgt_ret(e: checker::TExpr): @TStatement() {
    checker::TReturn { has_value = true; value = e; values = teko::list::empty() }
}
fn cgt_empty_stmts(): []@TStatement() { teko::list::empty() }

fn cgt_fn0(name: str, ns: str, ret: @Type(), body: []@TStatement()): checker::TFunction {
    checker::TFunction { overload_suffix = "";
        name = name
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        namespace = ns
        params = teko::list::empty()
        return_type = ret
        body = body
        vis = parser::Visibility::Private
        has_doc = false
        doc = ""
        file = ""
        line = 0; col = 0
        is_test = false
        is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

#test
fn cgt_buffer_basics() {
    var s1 = str(cb(cgt_empty(), "hello"))
    teko::assert::is_true(s1 == "hello")

    var s2 = str(cb_str(cgt_empty(), "world"))
    teko::assert::is_true(s2 == "world")

    var s3 = str(cb_byte(cgt_empty(), b'X'))
    teko::assert::is_true(s3 == "X")

    var s4 = str(cb_i64(cgt_empty(), 0))
    teko::assert::is_true(s4 == "0")

    var s5 = str(cb_i64(cgt_empty(), 99))
    teko::assert::is_true(s5 == "99")

    var s6 = str(cb_i64(cgt_empty(), -7))
    teko::assert::is_true(s6 == "-7")

    var s7 = cb_to_str("foo", "bar")
    teko::assert::is_true(s7 == "foobar")
}

#test
fn cgt_large_int_and_escape() {
    var d0 = str(cb_u64_digits(cgt_empty(), 0 to u64))
    teko::assert::is_true(d0 == "0")
    var d255 = str(cb_u64_digits(cgt_empty(), 255 to u64))
    teko::assert::is_true(d255 == "255")

    var uc = str(cb_u64_c_expr(cgt_empty(), 0 to u64))
    teko::assert::is_true(teko::str::contains(uc, "0"))
    var uc1 = str(cb_u64_c_expr(cgt_empty(), 1 to u64))
    teko::assert::is_true(uc1.len > 0)

    var i0 = str(cb_numint(cgt_empty(), parser::numint_of_u64(0)))
    teko::assert::is_true(teko::str::contains(i0, "0"))
    var ipos = str(cb_numint(cgt_empty(), parser::numint_of_u64(42)))
    teko::assert::is_true(teko::str::contains(ipos, "42"))
    var ineg = str(cb_numint(cgt_empty(), parser::numint_negate(parser::numint_of_u64(1))))
    teko::assert::is_true(teko::str::contains(ineg, "-("))
    teko::assert::is_true(teko::str::contains(ineg, "1"))
    var ineg42 = str(cb_numint(cgt_empty(), parser::numint_negate(parser::numint_of_u64(42))))
    teko::assert::is_true(teko::str::contains(ineg42, "-("))
    teko::assert::is_true(teko::str::contains(ineg42, "42"))

    var flit = str(cb_f64_literal(cgt_empty(), 1.5))
    teko::assert::is_true(flit.len > 0)

    var e1 = str(cb_cstr_escaped(cgt_empty(), "hi"))
    teko::assert::is_true(e1 == "hi")
    var e2 = cb_cstr_escaped(cgt_empty(), "\\")
    teko::assert::is_true(e2.len == 2)
    var e3 = cb_cstr_escaped(cgt_empty(), "\t")
    teko::assert::is_true(e3.len == 2)
    var e4 = cb_cstr_escaped(cgt_empty(), "\n")
    teko::assert::is_true(e4.len == 2)
}

#test
fn cgt_name_mangling() {
    var mn1 = str(mangle_type_name(cgt_empty(), "", "Foo"))
    teko::assert::is_true(mn1 == "tk_t_Foo")

    var mn2 = str(mangle_type_name(cgt_empty(), "a::b", "T"))
    teko::assert::is_true(teko::str::contains(mn2, "tk_t_"))
    teko::assert::is_true(teko::str::contains(mn2, "a"))

    var fn1 = str(cb_fn_name(cgt_empty(), "teko::rt", "foo"))
    teko::assert::is_true(fn1.len > 0)
    var fn2 = str(cb_fn_name(cgt_empty(), "", "bar"))
    teko::assert::is_true(teko::str::contains(fn2, "bar"))

    teko::assert::is_true(cg_is_c_keyword("bool"))
    teko::assert::is_true(cg_is_c_keyword("int"))
    teko::assert::is_true(cg_is_c_keyword("return"))
    teko::assert::is_true(cg_is_c_keyword("struct"))
    teko::assert::is_false(cg_is_c_keyword("foo"))
    teko::assert::is_false(cg_is_c_keyword("teko"))

    var id1 = str(cb_ident(cgt_empty(), "foo"))
    teko::assert::is_true(id1 == "foo")
    var id2 = str(cb_ident(cgt_empty(), "bool"))
    teko::assert::is_true(id2 == "bool_")
    var id3 = str(cb_ident(cgt_empty(), "return"))
    teko::assert::is_true(id3 == "return_")

    var u1 = str(cb_upper(cgt_empty(), "hello"))
    teko::assert::is_true(u1 == "HELLO")
    var u2 = str(cb_upper(cgt_empty(), "world123"))
    teko::assert::is_true(teko::str::contains(u2, "WORLD"))
}

#test
fn cgt_operator_tokens() {
    var b1 = match binop_c(lexer::TokenKind::Plus) { str as s => s; error => "" }
    teko::assert::is_true(b1 == "+")
    var b2 = match binop_c(lexer::TokenKind::Minus) { str as s => s; error => "" }
    teko::assert::is_true(b2 == "-")
    var b3 = match binop_c(lexer::TokenKind::Star) { str as s => s; error => "" }
    teko::assert::is_true(b3 == "*")
    var b4 = match binop_c(lexer::TokenKind::Amp) { str as s => s; error => "" }
    teko::assert::is_true(b4 == "&")
    var b5 = match binop_c(lexer::TokenKind::Pipe) { str as s => s; error => "" }
    teko::assert::is_true(b5 == "|")
    var b6 = match binop_c(lexer::TokenKind::Caret) { str as s => s; error => "" }
    teko::assert::is_true(b6 == "^")
    var b7 = match binop_c(lexer::TokenKind::Shl) { str as s => s; error => "" }
    teko::assert::is_true(b7 == "<<")
    var b8 = match binop_c(lexer::TokenKind::Shr) { str as s => s; error => "" }
    teko::assert::is_true(b8 == ">>")
    var b9 = match binop_c(lexer::TokenKind::AndAnd) { str as s => s; error => "" }
    teko::assert::is_true(b9 == "&&")
    var b10 = match binop_c(lexer::TokenKind::OrOr) { str as s => s; error => "" }
    teko::assert::is_true(b10 == "||")

    var u1 = match unop_c(lexer::TokenKind::Minus) { str as s => s; error => "" }
    teko::assert::is_true(u1 == "-")
    var u2 = match unop_c(lexer::TokenKind::Tilde) { str as s => s; error => "" }
    teko::assert::is_true(u2 == "~")
    var u3 = match unop_c(lexer::TokenKind::Bang) { str as s => s; error => "" }
    teko::assert::is_true(u3 == "!")

    var c1 = match cmpop_c(lexer::TokenKind::EqEq) { str as s => s; error => "" }
    teko::assert::is_true(c1 == "==")
    var c2 = match cmpop_c(lexer::TokenKind::Ne) { str as s => s; error => "" }
    teko::assert::is_true(c2 == "!=")
    var c3 = match cmpop_c(lexer::TokenKind::Lt) { str as s => s; error => "" }
    teko::assert::is_true(c3 == "<")
    var c4 = match cmpop_c(lexer::TokenKind::Le) { str as s => s; error => "" }
    teko::assert::is_true(c4 == "<=")
    var c5 = match cmpop_c(lexer::TokenKind::Gt) { str as s => s; error => "" }
    teko::assert::is_true(c5 == ">")
    var c6 = match cmpop_c(lexer::TokenKind::Ge) { str as s => s; error => "" }
    teko::assert::is_true(c6 == ">=")

    var a1 = match assignop_c(lexer::TokenKind::Assign) { str as s => s; error => "" }
    teko::assert::is_true(a1 == "=")
    var a2 = match assignop_c(lexer::TokenKind::PlusEq) { str as s => s; error => "" }
    teko::assert::is_true(a2 == "+=")
    var a3 = match assignop_c(lexer::TokenKind::MinusEq) { str as s => s; error => "" }
    teko::assert::is_true(a3 == "-=")
    var a4 = match assignop_c(lexer::TokenKind::StarEq) { str as s => s; error => "" }
    teko::assert::is_true(a4 == "*=")
    var a5 = match assignop_c(lexer::TokenKind::SlashEq) { str as s => s; error => "" }
    teko::assert::is_true(a5 == "/=")
    var a6 = match assignop_c(lexer::TokenKind::PercentEq) { str as s => s; error => "" }
    teko::assert::is_true(a6 == "%=")
    var a7 = match assignop_c(lexer::TokenKind::AmpEq) { str as s => s; error => "" }
    teko::assert::is_true(a7 == "&=")
    var a8 = match assignop_c(lexer::TokenKind::ShlEq) { str as s => s; error => "" }
    teko::assert::is_true(a8 == "<<=")
    var a9 = match assignop_c(lexer::TokenKind::ShrEq) { str as s => s; error => "" }
    teko::assert::is_true(a9 == ">>=")
}

#test
fn cgt_prim_predicates() {
    teko::assert::is_true(cg_prim_is_float(checker::PrimKind::F32))
    teko::assert::is_true(cg_prim_is_float(checker::PrimKind::F64))
    teko::assert::is_false(cg_prim_is_float(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_float(checker::PrimKind::Bool))

    teko::assert::is_true(cg_prim_is_int(checker::PrimKind::U8))
    teko::assert::is_true(cg_prim_is_int(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_int(checker::PrimKind::F64))
    teko::assert::is_false(cg_prim_is_int(checker::PrimKind::Bool))

    teko::assert::is_true(cg_prim_is_signed_int(checker::PrimKind::I8))
    teko::assert::is_true(cg_prim_is_signed_int(checker::PrimKind::I64))
    teko::assert::is_false(cg_prim_is_signed_int(checker::PrimKind::U64))
    teko::assert::is_false(cg_prim_is_signed_int(checker::PrimKind::Bool))

    teko::assert::is_true(cg_int_width(checker::PrimKind::U8) == 8)
    teko::assert::is_true(cg_int_width(checker::PrimKind::I16) == 16)
    teko::assert::is_true(cg_int_width(checker::PrimKind::U32) == 32)
    teko::assert::is_true(cg_int_width(checker::PrimKind::I64) == 64)

    var t1 = match prim_div_tag(checker::PrimKind::U8) { str as s => s; error => "" }
    teko::assert::is_true(t1 == "u8")
    var t2 = match prim_div_tag(checker::PrimKind::I64) { str as s => s; error => "" }
    teko::assert::is_true(t2 == "i64")
    var t3 = match prim_div_tag(checker::PrimKind::F64) { str as s => s; error => "" }
    teko::assert::is_true(t3 == "f64")
    var t4 = match prim_div_tag(checker::PrimKind::Bool) { str => "ok"; error as e => "err" }
    teko::assert::is_true(t4 == "err")

    var it1 = match prim_int_tag(checker::PrimKind::I8) { str as s => s; error => "" }
    teko::assert::is_true(it1 == "i8")
    var it2 = match prim_int_tag(checker::PrimKind::U64) { str as s => s; error => "" }
    teko::assert::is_true(it2 == "u64")
    var it3 = match prim_int_tag(checker::PrimKind::F32) { str => "ok"; error => "err" }
    teko::assert::is_true(it3 == "err")

    var ft1 = match prim_float_tag(checker::PrimKind::F32) { str as s => s; error => "" }
    teko::assert::is_true(ft1 == "f32")
    var ft2 = match prim_float_tag(checker::PrimKind::F64) { str as s => s; error => "" }
    teko::assert::is_true(ft2 == "f64")
    var ft3 = match prim_float_tag(checker::PrimKind::I64) { str => "ok"; error => "err" }
    teko::assert::is_true(ft3 == "err")

    teko::assert::is_true(cast_may_lose(checker::PrimKind::I64, checker::PrimKind::I8))
    teko::assert::is_true(cast_may_lose(checker::PrimKind::U64, checker::PrimKind::U8))
    teko::assert::is_false(cast_may_lose(checker::PrimKind::I8, checker::PrimKind::I64))
    teko::assert::is_true(cast_may_lose(checker::PrimKind::U64, checker::PrimKind::I64))
}

#test
fn cgt_type_emission() {
    var p1 = match emit_prim(cgt_empty(), checker::PrimKind::U8) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p1 == "uint8_t")
    var p2 = match emit_prim(cgt_empty(), checker::PrimKind::I64) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p2 == "int64_t")
    var p3 = match emit_prim(cgt_empty(), checker::PrimKind::F64) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p3 == "double")
    var p4 = match emit_prim(cgt_empty(), checker::PrimKind::Bool) { []byte as o => str(o); error => "" }
    teko::assert::is_true(p4 == "bool")

    var t1 = match emit_type(cgt_empty(), cgt_prog(), checker::Prim { kind = checker::PrimKind::I32 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t1 == "int32_t")
    var t2 = match emit_type(cgt_empty(), cgt_prog(), checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t2 == "tk_str")
    var t3 = match emit_type(cgt_empty(), cgt_prog(), checker::Byte { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t3 == "uint8_t")
    var t4 = match emit_type(cgt_empty(), cgt_prog(), checker::Error { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t4 == "tk_error")
    var t5 = match emit_type(cgt_empty(), cgt_prog(), checker::Void { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t5 == "void")
    var t6 = match emit_type(cgt_empty(), cgt_prog(), checker::Named { name = "Shape" }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(t6 == "tk_t_Shape")
}

#test
fn cgt_opt_mangle_and_keys() {
    var m1 = match cg_opt_mangle_str(checker::Prim { kind = checker::PrimKind::I64 }) { str as s => s; error => "" }
    teko::assert::is_true(m1 == "i64")
    var m2 = match cg_opt_mangle_str(checker::Str { }) { str as s => s; error => "" }
    teko::assert::is_true(m2 == "str")
    var m3 = match cg_opt_mangle_str(checker::Byte { }) { str as s => s; error => "" }
    teko::assert::is_true(m3 == "byte")
    var m4 = match cg_opt_mangle_str(checker::Error { }) { str as s => s; error => "" }
    teko::assert::is_true(m4 == "error")
    var m5 = match cg_opt_mangle_str(checker::Named { name = "Foo" }) { str as s => s; error => "" }
    teko::assert::is_true(m5 == "Foo")

    var om1 = match cg_opt_mangle(cgt_empty(), checker::Prim { kind = checker::PrimKind::U8 }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(om1 == "u8")

    var k1 = match cg_member_key_str(checker::Prim { kind = checker::PrimKind::Bool }) { str as s => s; error => "" }
    teko::assert::is_true(k1 == "bool_")
    var k2 = match cg_member_key_str(checker::Str { }) { str as s => s; error => "" }
    teko::assert::is_true(k2 == "str")
    var k3 = match cg_member_key_str(checker::Error { }) { str as s => s; error => "" }
    teko::assert::is_true(k3 == "error")
    var k4 = match cg_member_key_str(checker::Prim { kind = checker::PrimKind::I64 }) { str as s => s; error => "" }
    teko::assert::is_true(k4 == "i64")

    var mk1 = match cg_member_key(cgt_empty(), checker::Str { }) { []byte as o => str(o); error => "" }
    teko::assert::is_true(mk1 == "str")

    var vm1: []@Type() = teko::list::push(teko::list::empty(), checker::Prim { kind = checker::PrimKind::I64 })
    var vm2: []@Type() = teko::list::push(vm1, checker::Str { })
    var va = checker::Variant { members = vm2 }
    var vn = match cg_variant_typename(cgt_empty(), va) { []byte as o => str(o); error => "" }
    teko::assert::is_true(vn == "tk_u_i64_str")

    var vm3: []@Type() = teko::list::push(teko::list::empty(), checker::Error { })
    var va2 = checker::Variant { members = vm3 }
    var vb = match cg_variant_typename(cgt_empty(), va2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(vb == "tk_u_error")
}

#test
fn cgt_prog_queries() {
    var prog = cgt_prog()

    var pl1 = cg_path_last(cgt_path1("foo"))
    teko::assert::is_true(pl1 == "foo")
    var pl2 = cg_path_last(parser::Path { segments = teko::list::empty() })
    teko::assert::is_true(pl2 == "")

    teko::assert::is_true(cg_is_prim_name("u64"))
    teko::assert::is_true(cg_is_prim_name("str"))
    teko::assert::is_false(cg_is_prim_name("MyType"))

    teko::assert::is_true(cg_is_builtin_scalar("i64"))
    teko::assert::is_true(cg_is_builtin_scalar("bool"))
    teko::assert::is_true(cg_is_builtin_scalar("byte"))
    teko::assert::is_true(cg_is_builtin_scalar("error"))
    teko::assert::is_false(cg_is_builtin_scalar("Foo"))

    var fd = match cg_find_decl(prog, "Foo") { parser::TypeDecl => "found"; error => "not-found" }
    teko::assert::is_true(fd == "not-found")

    var fvd = match cg_find_variant_decl(prog, "Shape") { parser::TypeDecl => "found"; error => "not-found" }
    teko::assert::is_true(fvd == "not-found")

    teko::assert::is_false(cg_named_is_variant(prog, "Shape"))
    teko::assert::is_false(cg_named_is_enum(prog, "Color"))

    var ff = match cg_find_function(prog, "teko::test", "my_fn") { checker::TFunction => "found"; error => "not-found" }
    teko::assert::is_true(ff == "not-found")

    var xs: []str = teko::list::push(teko::list::empty(), "alpha")
    teko::assert::is_true(cg_str_in(xs, "alpha"))
    teko::assert::is_false(cg_str_in(xs, "beta"))
    teko::assert::is_false(cg_str_in(teko::list::empty(), "x"))

    teko::assert::is_true(cg_nameset_seen(xs, "alpha"))
    teko::assert::is_false(cg_nameset_seen(xs, "gamma"))

    var decls = cg_named_decls(prog)
    teko::assert::is_true(decls.len == 0)
}

#test
fn cgt_emit_expr_variants() {
    var prog = cgt_prog()

    var e1 = match emit_expr(cgt_empty(), prog, cgt_num_i64(42)) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(e1, "42"))
    teko::assert::is_true(teko::str::contains(e1, "int64_t"))

    var e2 = match emit_expr(cgt_empty(), prog, cgt_num_i8(3)) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(e2, "int8_t"))

    var ev = match emit_expr(cgt_empty(), prog, cgt_e_var("myvar")) { []byte as o => str(o); error => "" }
    teko::assert::is_true(ev == "myvar")
    var ekw = match emit_expr(cgt_empty(), prog, cgt_e_var("return")) { []byte as o => str(o); error => "" }
    teko::assert::is_true(ekw == "return_")

    var ebl = checker::TExpr {
        kind = checker::TByteLit { value = b'A' }
        type = checker::Byte { }
        line = 0; col = 0
    }
    var sbl = match emit_expr(cgt_empty(), prog, ebl) { []byte as o => str(o); error => "" }
    teko::assert::is_true(sbl == "65")

    var etrue = match emit_expr(cgt_empty(), prog, cgt_e_bool_t()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(etrue == "true")
    var ef = checker::TExpr {
        kind = checker::TBoolLit { value = false }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var efalse = match emit_expr(cgt_empty(), prog, ef) { []byte as o => str(o); error => "" }
    teko::assert::is_true(efalse == "false")

    var esl = checker::TExpr {
        kind = checker::TStrLit { text = "hello" }
        type = checker::Str { }
        line = 0; col = 0
    }
    var ssl = match emit_expr(cgt_empty(), prog, esl) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(ssl, "hello"))
    teko::assert::is_true(teko::str::contains(ssl, "5"))
}

#test
fn cgt_emit_borrow() {
    var prog = cgt_prog()

    var borrow_x = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("x") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var sx = match emit_expr(cgt_empty(), prog, borrow_x) { []byte as o => str(o); error => "" }
    teko::assert::is_true(sx == "&x")

    var borrow_kw = checker::TExpr {
        kind = checker::TBorrow { operand = cgt_e_var("return") }
        type = checker::Reference { inner = checker::Prim { kind = checker::PrimKind::I64 } }
        line = 0; col = 0
    }
    var skw = match emit_expr(cgt_empty(), prog, borrow_kw) { []byte as o => str(o); error => "" }
    teko::assert::is_true(skw == "&return_")
}

#test
fn cgt_emit_binary_and_div() {
    var prog = cgt_prog()
    var left = cgt_num_i64(10)
    var right = cgt_num_i64(3)

    var e_add = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Plus; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_add = match emit_expr(cgt_empty(), prog, e_add) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_add, "tk_add_i64"))

    var e_mul = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Star; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_mul = match emit_expr(cgt_empty(), prog, e_mul) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mul, "tk_mul_i64"))

    var e_div = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Slash; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_div = match emit_expr(cgt_empty(), prog, e_div) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_div, "tk_div_i64"))

    var e_mod = checker::TExpr {
        kind = checker::TBinary { op = lexer::TokenKind::Percent; left = left; right = right }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_mod = match emit_expr(cgt_empty(), prog, e_mod) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_mod, "tk_mod_i64"))
}

#test
fn cgt_emit_unary_compare_cast() {
    var prog = cgt_prog()
    var n42 = cgt_num_i64(42)

    var e_neg = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Minus; operand = n42 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_neg = match emit_expr(cgt_empty(), prog, e_neg) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_neg, "-"))

    var e_not = checker::TExpr {
        kind = checker::TUnary { op = lexer::TokenKind::Bang; operand = cgt_e_bool_t() }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var s_not = match emit_expr(cgt_empty(), prog, e_not) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_not, "!"))

    var term = checker::TCmpTerm { op = lexer::TokenKind::Lt; operand = n42 }
    var terms: []checker::TCmpTerm = teko::list::push(teko::list::empty(), term)
    var e_cmp = checker::TExpr {
        kind = checker::TCompare { first = cgt_num_i64(0); rest = terms }
        type = checker::Prim { kind = checker::PrimKind::Bool }
        line = 0; col = 0
    }
    var s_cmp = match emit_expr(cgt_empty(), prog, e_cmp) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_cmp, "<"))

    var inner32 = cgt_num_i32(10)
    var e_widen = checker::TExpr {
        kind = checker::TCast { expr = inner32 }
        type = checker::Prim { kind = checker::PrimKind::I64 }
        line = 0; col = 0
    }
    var s_widen = match emit_expr(cgt_empty(), prog, e_widen) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_widen, "int64_t"))

    var inner64 = cgt_num_i64(200)
    var e_narrow = checker::TExpr {
        kind = checker::TCast { expr = inner64 }
        type = checker::Prim { kind = checker::PrimKind::I8 }
        line = 0; col = 0
    }
    var s_narrow = match emit_expr(cgt_empty(), prog, e_narrow) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(s_narrow, "tk_to_i8"))
}

#test
fn cgt_emit_value_arm_no_region_when_no_context() {
    var prog = cgt_prog()
    var bind_tmp: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(5)
    }
    var tail_read: @TStatement() = cgt_stmt(cgt_e_var("tmp"))
    var then_blk: []@TStatement() = teko::list::push(teko::list::empty(), bind_tmp)
    then_blk = teko::list::push(then_blk, tail_read)
    var else_blk: []@TStatement() = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0)))
    var if_e = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = then_blk; has_else = true; else_blk = else_blk }
    var e_if = checker::TExpr { kind = if_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    var result = match emit_expr(cgt_empty(), prog, e_if) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "tmp"))
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

#test
fn cgt_emit_value_match_arm_commits_tail() {
    var prog = cgt_prog()
    var bind_tmp: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "tmp" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(7)
    }
    var arm_lit: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(1); fval = 0.0 }; line = 0; col = 0 }
    }
    var arm_body: []@TStatement() = teko::list::push(teko::list::empty(), bind_tmp)
    arm_body = teko::list::push(arm_body, cgt_stmt(cgt_e_var("tmp")))
    var arm1 = checker::TArm { pattern = arm_lit; has_when = false; guard = cgt_num_i64(0); body = arm_body }
    var arm_w = checker::TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(teko::list::empty(), cgt_stmt(cgt_num_i64(0))) }
    var arms: []checker::TArm = teko::list::push(teko::list::empty(), arm1)
    arms = teko::list::push(arms, arm_w)
    var m_e = checker::TMatchExpr { subject = cgt_num_i64(1); arms = arms }
    var e_m = checker::TExpr { kind = m_e; type = checker::Prim { kind = checker::PrimKind::I64 }; line = 0; col = 0 }
    var result = match emit_expr(cgt_empty(), prog, e_m) { []byte as o => str(o); error => "" }
    teko::assert::is_true(result.len > 0)
    teko::assert::is_true(teko::str::contains(result, "break;"))
    teko::assert::is_true(!teko::str::contains(result, "tk_region_new"))
}

#test
fn cgt_emit_loop_with_init() {
    var prog = cgt_prog()
    var init_bind: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3)
    }
    var init: []@TStatement() = teko::list::push(cgt_empty_stmts(), init_bind)
    var body: []@TStatement() = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: @TStatement() = checker::TLoopStmt { label = ""; init = init; body = body }
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }
    var b: []@TStatement() = teko::list::push(cgt_empty_stmts(), loop_s)
    b = teko::list::push(b, cgt_ret(cgt_num_i64(0)))
    var f = cgt_fn0("cgt_loop_init", "teko::cgt", ret_type, b)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r, "_hi"))
    teko::assert::is_true(teko::str::contains(r, "while"))
}

#test
fn cgt_loop_init_walkers() {
    var init_bind: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Mut
        target = parser::SimpleName { name = "_hi" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(3)
    }
    var init: []@TStatement() = teko::list::push(cgt_empty_stmts(), init_bind)
    var body: []@TStatement() = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: @TStatement() = checker::TLoopStmt { label = ""; init = init; body = body }
    var stmts: []@TStatement() = teko::list::push(cgt_empty_stmts(), loop_s)
    var set0 = CgTypeSet { inners = teko::list::empty(); opt_keys = teko::list::empty(); slices = teko::list::empty(); slice_keys = teko::list::empty(); variants = teko::list::empty(); variant_keys = teko::list::empty() }
    var collected = cg_collect_block_opts(set0, stmts)
    teko::assert::is_true(collected.inners.len == 0)
    var acc = StampAcc { next = 0; fns = teko::list::empty(); lams = teko::list::empty() }
    var lifted = cg_lift_block(stmts, acc)
    teko::assert::is_true(lifted.len == 1)
}

#test
fn cgt_emit_function_comprehensive() {
    var prog = cgt_prog()

    var break_body: []@TStatement() = teko::list::push(cgt_empty_stmts(), checker::TBreakStmt { label = "" })
    var loop_s: @TStatement() = checker::TLoopStmt { label = ""; init = teko::list::empty(); body = break_body }

    var empty_blk = cgt_empty_stmts()
    var if_s: @TStatement() = cgt_stmt(checker::TExpr {
            kind = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = empty_blk; has_else = false; else_blk = empty_blk }
            type = checker::Void { }
            line = 0; col = 0
    })

    var bind_s: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "x" }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(10)
    }
    var assign_s: @TStatement() = checker::TAssign {
        kind = parser::AssignKind::Simple
        name = "x"
        op = lexer::TokenKind::PlusEq
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(1)
        deref = false
        target = checker::no_texpr()
    }
    var ret_s: @TStatement() = cgt_ret(cgt_num_i64(42))

    var body1: []@TStatement() = cgt_empty_stmts()
    body1 = teko::list::push(body1, loop_s)
    body1 = teko::list::push(body1, if_s)
    body1 = teko::list::push(body1, bind_s)
    body1 = teko::list::push(body1, assign_s)
    body1 = teko::list::push(body1, ret_s)

    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }
    var f1 = cgt_fn0("cgt_fn_ret", "teko::cgt", ret_type, body1)
    var r1 = match emit_function(cgt_empty(), prog, f1) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r1.len > 0)
    teko::assert::is_true(teko::str::contains(r1, "cgt_fn_ret"))
    teko::assert::is_true(teko::str::contains(r1, "while"))
    teko::assert::is_true(teko::str::contains(r1, "break"))
    teko::assert::is_true(teko::str::contains(r1, "int64_t x"))
    teko::assert::is_true(teko::str::contains(r1, "return"))

    var tail_s: @TStatement() = cgt_stmt(cgt_num_i64(99))
    var body2: []@TStatement() = teko::list::push(cgt_empty_stmts(), tail_s)
    var f2 = cgt_fn0("cgt_fn_tail", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r2.len > 0)
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_tail"))
    teko::assert::is_true(teko::str::contains(r2, "return"))

    var f3 = cgt_fn0("cgt_fn_void", "teko::cgt", checker::Void { }, cgt_empty_stmts())
    var r3 = match emit_function(cgt_empty(), prog, f3) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r3.len > 0)
    teko::assert::is_true(teko::str::contains(r3, "void"))

    var param = parser::Param { name = "n"; has_type = true; type_ann = cgt_named_te("u64"); is_params = false; has_default = false; default_expr = parser::no_expr() }
    var params: []parser::Param = teko::list::push(teko::list::empty(), param)
    var body4: []@TStatement() = teko::list::push(cgt_empty_stmts(), cgt_ret(cgt_num_i64(0)))
    var f4 = checker::TFunction { overload_suffix = "";
        name = "cgt_fn_param"
        type_params = teko::list::empty()
        type_constraints = teko::list::empty()
        namespace = "teko::cgt"
        params = params
        return_type = checker::Prim { kind = checker::PrimKind::I64 }
        body = body4
        vis = parser::Visibility::Private
        has_doc = false
        doc = ""
        file = ""
        line = 0; col = 0
        is_test = false
        is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
    var r4 = match emit_function(cgt_empty(), prog, f4) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r4.len > 0)
    teko::assert::is_true(teko::str::contains(r4, "uint64_t"))
    teko::assert::is_true(teko::str::contains(r4, "n"))
}

#test
fn cgt_emit_return_uses_escaping_region_context() {
    var c = cgt_class_decl("RetClass", parser::ClassKind::Sealed, false, "")
    var prog = cg_prog_of(checker::TProgram { items = teko::list::push(teko::list::empty(), c) })
    var empty_names: []str = teko::list::empty()
    var empty_vals: []checker::TExpr = teko::list::empty()
    var ret_expr = checker::TExpr {
        kind = checker::TStructInit { field_names = empty_names; field_vals = empty_vals }
        type = checker::Named { name = "RetClass" }
        line = 0; col = 0
    }
    var ret = checker::TReturn { has_value = true; value = ret_expr; values = teko::list::empty() }
    var regions: []RegionFrame = teko::list::push(teko::list::empty(), RegionFrame { name = "_tkbr_ret"; label = ""; is_loop = false; defer_base = 0 to u64; decls = teko::list::empty() })
    var out = match emit_return(cgt_empty(), prog, ret, false, checker::Named { name = "RetClass" }, "    ", "", teko::list::empty(), regions, teko::list::empty(), dctx_empty()) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(out, "tk_region_drop(_tkbr_ret); _tkbr_ret = NULL;"))
    teko::assert::is_true(teko::str::contains(out, "tk_region_new(tk_region_root())"))
    teko::assert::is_true(!teko::str::contains(out, "tk_region_new(_tkbr_ret)"))
}

fn cgt_lit_arm(v: u64, body_name: str): checker::TArm {
    var lit: @Pattern() = parser::LiteralPattern {
        value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; line = 0; col = 0 }
    }
    var eff: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = body_name }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(v to i64)
    }
    checker::TArm { pattern = lit; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(cgt_empty_stmts(), eff) }
}
fn cgt_wild_arm(body_name: str): checker::TArm {
    var eff: @TStatement() = checker::TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = body_name }
        bound = checker::Prim { kind = checker::PrimKind::I64 }
        value = cgt_num_i64(99)
    }
    checker::TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = cgt_num_i64(0); body = teko::list::push(cgt_empty_stmts(), eff) }
}

#test
fn cgt_void_tail_match_chains_arms() {
    var prog = cgt_prog()

    var subj = cgt_e_var("k")
    var arms: []checker::TArm = teko::list::empty()
    arms = teko::list::push(arms, cgt_lit_arm(1, "a1"))
    arms = teko::list::push(arms, cgt_wild_arm("aw"))
    var match_e = checker::TExpr {
        kind = checker::TMatchExpr { subject = subj; arms = arms }
        type = checker::Void { }
        line = 0; col = 0
    }
    var tail: []@TStatement() = teko::list::push(cgt_empty_stmts(), cgt_stmt(match_e))
    var f = cgt_fn0("cgt_fn_void_match", "teko::cgt", checker::Void { }, tail)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }

    teko::assert::is_true(r.len > 0)
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_void_match"))
    teko::assert::is_true(teko::str::contains(r, "a1"))
    teko::assert::is_true(teko::str::contains(r, "aw"))
    teko::assert::is_true(teko::str::contains(r, "goto "))
    teko::assert::is_true(teko::str::contains(r, "_done"))

    var arms3: []checker::TArm = teko::list::empty()
    arms3 = teko::list::push(arms3, cgt_lit_arm(1, "b1"))
    arms3 = teko::list::push(arms3, cgt_lit_arm(2, "b2"))
    arms3 = teko::list::push(arms3, cgt_wild_arm("bw"))
    var match3 = checker::TExpr {
        kind = checker::TMatchExpr { subject = cgt_e_var("k"); arms = arms3 }
        type = checker::Void { }
        line = 0; col = 0
    }
    var tail3: []@TStatement() = teko::list::push(cgt_empty_stmts(), cgt_stmt(match3))
    var f3 = cgt_fn0("cgt_fn_void_match3", "teko::cgt", checker::Void { }, tail3)
    var r3 = match emit_function(cgt_empty(), prog, f3) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r3, "b1"))
    teko::assert::is_true(teko::str::contains(r3, "b2"))
    teko::assert::is_true(teko::str::contains(r3, "bw"))
    teko::assert::is_true(teko::str::contains(r3, "goto "))
    teko::assert::is_true(teko::str::contains(r3, "_done"))
}

#test
fn cgt_emit_defer() {
    var prog = cgt_prog()
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }

    var defer_body: []@TStatement() = teko::list::push(cgt_empty_stmts(), checker::TBinding {
            kind = parser::BindKind::Let
            target = parser::SimpleName { name = "_c" }
            bound = checker::Prim { kind = checker::PrimKind::I64 }
            value = cgt_num_i64(0)
    })
    var defer_s: @TStatement() = checker::TDeferStmt { body = defer_body }

    var body: []@TStatement() = cgt_empty_stmts()
    body = teko::list::push(body, defer_s)
    body = teko::list::push(body, cgt_ret(cgt_num_i64(42)))
    var f = cgt_fn0("cgt_fn_defer", "teko::cgt", ret_type, body)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(r.len > 0)
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_defer"))
    teko::assert::is_true(teko::str::contains(r, "_c"))
    teko::assert::is_true(teko::str::contains(r, "return"))

    var inner: []@TStatement() = teko::list::push(cgt_empty_stmts(), cgt_ret(cgt_num_i64(1)))
    var if_s: @TStatement() = cgt_stmt(checker::TExpr {
            kind = checker::TIfExpr { cond = cgt_e_bool_t(); then_blk = inner; has_else = false; else_blk = cgt_empty_stmts() }
            type = checker::Void { }
            line = 0; col = 0
    })
    var body2: []@TStatement() = cgt_empty_stmts()
    body2 = teko::list::push(body2, defer_s)
    body2 = teko::list::push(body2, if_s)
    body2 = teko::list::push(body2, cgt_ret(cgt_num_i64(2)))
    var f2 = cgt_fn0("cgt_fn_defer2", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_defer2"))
    teko::assert::is_true(teko::str::contains(r2, "_c"))
}

#test
fn cgt_emit_adopt() {
    var prog = cgt_prog()
    var ret_type = checker::Prim { kind = checker::PrimKind::I64 }

    var inner_body: []@TStatement() = teko::list::push(cgt_empty_stmts(), checker::TBinding {
            kind = parser::BindKind::Let
            target = parser::SimpleName { name = "_a" }
            bound = checker::Prim { kind = checker::PrimKind::I64 }
            value = cgt_num_i64(0)
    })
    var adopt_s: @TStatement() = checker::TAdoptStmt { name = ""; body = inner_body }
    var body: []@TStatement() = cgt_empty_stmts()
    body = teko::list::push(body, adopt_s)
    body = teko::list::push(body, cgt_ret(cgt_num_i64(3)))
    var f = cgt_fn0("cgt_fn_adopt", "teko::cgt", ret_type, body)
    var r = match emit_function(cgt_empty(), prog, f) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r, "cgt_fn_adopt"))
    teko::assert::is_true(teko::str::contains(r, "tk_region_new"))
    teko::assert::is_true(teko::str::contains(r, "tk_region_drop_subtree"))

    var named_s: @TStatement() = checker::TAdoptStmt { name = "r"; body = inner_body }
    var nested_body: []@TStatement() = teko::list::push(cgt_empty_stmts(), named_s)
    var outer_s: @TStatement() = checker::TAdoptStmt { name = ""; body = nested_body }
    var body2: []@TStatement() = cgt_empty_stmts()
    body2 = teko::list::push(body2, outer_s)
    body2 = teko::list::push(body2, cgt_ret(cgt_num_i64(3)))
    var f2 = cgt_fn0("cgt_fn_adopt_nested", "teko::cgt", ret_type, body2)
    var r2 = match emit_function(cgt_empty(), prog, f2) { []byte as o => str(o); error => "" }
    teko::assert::is_true(teko::str::contains(r2, "cgt_fn_adopt_nested"))
    teko::assert::is_true(count_substr(r2, "tk_region_drop_subtree") >= 2)
}

fn count_substr(hay: str, needle: str): u64 {
    if needle.len == 0 { return 0 }
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i + needle.len > hay.len { break }
        if teko::str::contains(teko::str::slice(hay, i, i + needle.len), needle) { n = n + 1; i = i + needle.len } else { i = i + 1 }
    }
    n
}

fn cgt_path3(a: str, b: str, c: str): parser::Path {
    var s1: []parser::Segment = teko::list::push(teko::list::empty(), cgt_seg(a))
    var s2: []parser::Segment = teko::list::push(s1, cgt_seg(b))
    var s3: []parser::Segment = teko::list::push(s2, cgt_seg(c))
    parser::Path { segments = s3 }
}

