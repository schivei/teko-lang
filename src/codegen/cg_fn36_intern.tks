/** teko::codegen functions (split 36/49 from codegen.tks — mechanical, pure reorg, no logic changes). */
use teko::checker
use teko::lexer
use teko::parser

/**
 * cg_fn_ref_ns — the namespace a function's param type annotations were WRITTEN in, so a bare
 * contract name in a method's param type resolves the way the checker resolved it. A METHOD's
 * `TFunction` namespace is exactly its owner type's canonical name (`module::Owner`), but its param
 * types were resolved by the checker in the OWNER's enclosing MODULE namespace (collect.tks
 * `method_func_type` takes `items[i].namespace`) — so a bare `Reader` on a `class & Reader` factory
 * must bind the sibling module decl (`teko::io::Reader`) past a same-last-segment cousin
 * (`teko::emit::Reader`, the #109 collision), NOT be resolved against the over-qualified
 * `teko::io::Owner`. Used at BOTH the param-signature emitter (emit_function_sig) AND the caller's
 * arg-slot upcast canonicalisation (emit_call), so the factory's declared param type and the
 * class->interface box built for its argument agree on the real contract. A FREE function's
 * namespace already IS its module namespace, so it is returned unchanged. Detection is EXACT: only
 * when `ns` names an existing type decl is it a method's owner-qualified namespace.
 *
 * @param prog  the typed program (scanned for a type decl whose canonical name equals `ns`)
 * @param ns    the function's declared namespace (`TFunction.namespace`)
 * @return      the enclosing MODULE namespace for a method's owner-named ns, else `ns` unchanged
 */
fn cg_fn_ref_ns(prog: CgProg, ns: str) -> str {
    if prog.ix.exact.slots.len != 0 {
        if cg_table_get(prog.ix.exact, ns) != 0 { return checker::name_qualifier(ns) }
        return ns
    }
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as d => { if d.name == ns { return checker::name_qualifier(ns) } }
            _ => { }
        }
        i++
    }
    ns
}

// emit_function — a TFunction -> a C function definition.
// (C: `emit_function`.)
// emit_function_sig — the return type + name + params up to the `)` (no body). Shared by the
// definition AND the PROTOTYPE pass in tk_emit_c, so a forward declaration and its definition
// spell the same signature. Parameter names ride cb_ident (a C-keyword param → trailing `_`).
// (C: `emit_function_sig`.)
fn emit_function_sig(buf: []byte, prog: CgProg, f: checker::TFunction) -> []byte | error {
    mut out = buf
    if cg_fn_is_self_recursive(f) { out = cb(out, "__attribute__((noinline)) ") }
    if f.is_extern { out = cb(out, "extern ") }   // C7.1a: a foreign prototype (no body)
    out = match emit_type(out, prog, f.return_type) { []byte as o => o; error as err => return err }
    out = cb(out, " ")
    if f.is_extern {
        out = cb(out, f.c_symbol)   // C7.1a: the raw foreign C symbol (NO namespace mangling)
    } else {
        out = cb_fn_name(out, f.namespace, f.name)   // (#49) namespace-mangled C name (def + prototype agree)
    }
    out = cb(out, "(")
    if f.params.len == 0 {
        out = cb(out, "void")
    } else {
        let ref_ns = cg_fn_ref_ns(prog, f.namespace)
        mut i: u64 = 0
        loop {
            if i >= f.params.len { break }
            if i > 0 { out = cb(out, ", ") }
            out = match emit_type_expr(out, prog, f.params[i].type_ann, ref_ns) { []byte as o => o; error as err => return err }
            out = cb(out, " ")
            out = cb_ident(out, f.params[i].name)
            i++
        }
    }
    cb(out, ")")
}

// cg_stmt_c_terminates — does this statement, AS LOWERED, guarantee C control doesn't fall through
// past it? A `return`/break/continue does; a trailing value-expr lowers to `return <v>;` so it does
// too — EXCEPT a `match`/`if` value tail, whose exhaustiveness C cannot see. (C: cg_stmt_c_terminates.)
fn cg_stmt_c_terminates(s: checker::TStatement) -> bool {
    match s {
        checker::TReturn => true
        checker::TBreakStmt => true
        checker::TContinueStmt => true
        checker::TExprStmt as es => match es.expr.kind {
            checker::TMatchExpr => false
            checker::TIfExpr => false
            _ => true
        }
        _ => false
    }
}

// cg_same_named_struct — are `a` and `b` the SAME Named type? Used to gate the frame-local binding
// bypass to the no-wrapping case (declared type == the struct-init's own type), so a variant/
// optional-typed binding (which emit_as_r must wrap) is never emitted via the direct framed path.
fn cg_same_named_struct(a: checker::Type, b: checker::Type) -> bool {
    match a {
        checker::Named as na => match b {
            checker::Named as nb => teko::runtime::str_eq(na.name, nb.name)
            _ => false
        }
        _ => false
    }
}

// fn_body_has_frame_local — does this body have any TOP-LEVEL binding the escape check proved
// frame-local AND routable? (MEM Step 1 routes only top-level
// bindings; sub-scope bindings stay on root in this first cut.) Drives whether emit_function opens
// a frame region at all — none ⇒ no region ⇒ zero output change (the fixpoint-preserving default).
fn fn_body_has_frame_local(prog: CgProg, escaping: []str, body: []checker::TStatement) -> bool {
    mut i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            checker::TBinding as b => {
                if checker::binding_is_frame_local(escaping, b) && (cg_same_named_struct(b.bound, b.value.type) || cg_binding_routes_box_to_local_region(prog, b)) { return true }
                // (S2 Level-1) a NON-escaping slice binding: its buffer is built by later self-append
                // pushes (`xs = push(xs, …)`), each routed to `_tkfr` and bulk-freed on the frame drop.
                if checker::binding_is_frame_local_slice(escaping, b) { return true }
            }
            _ => { }
        }
        i++
    }
    false
}

/** (W10c/MEM-3) Rebuild the DI provider registry from the TYPED program (codegen has no raw
 *  `parser::Program`). Walks the passed-through `TypeDecl` items — each `#lifetime` class's
 *  `di_kind` + `implements` + no-arg static factory survive into the typed AST unchanged. */

fn cg_build_di_registry(prog: CgProg) -> checker::DiRegistry | error {
    mut providers: []checker::DiProvider = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            parser::TypeDecl as td => providers = match cg_add_di_providers(providers, td) { []checker::DiProvider as ps => ps; error as e => return e }
            _ => { }
        }
        i++
    }
    checker::DiRegistry { providers = providers }
}

/** (W10c/MEM-3) Add a `#lifetime` class's providers (one per implemented interface) to the list. */

fn cg_add_di_providers(providers: []checker::DiProvider, td: parser::TypeDecl) -> []checker::DiProvider | error {
    match td.di_kind { parser::DiKind::None => return providers; _ => { } }
    let cb0 = match td.body { parser::ClassBody as c => c; _ => return providers }
    let factory = match cg_di_factory(cb0) { str as f => f; null => return error { message = $"codegen: DI class `{td.name}` has no zero-argument static factory" } }
    mut out = providers
    mut j: u64 = 0
    loop {
        if j >= cb0.implements.len { break }
        out = teko::list::push(out, checker::DiProvider { iface = cb0.implements[j]; kind = td.di_kind; impl_name = td.name; factory = factory })
        j++
    }
    out
}

/** (W10c/MEM-3) The name of a class's zero-argument static factory (its first no-arg static), or
 *  null when it has none. */

fn cg_di_factory(cb0: parser::ClassBody) -> str | null {
    mut i: u64 = 0
    loop {
        if i >= cb0.methods.len { break }
        let m = cb0.methods[i]
        let is_static = if m.params.len == 0 { true } else { m.params[0].has_type }
        if is_static && m.params.len == 0 { return m.name }
        i++
    }
    null
}

/** (W10c/MEM-3) Emit every DI materializer C function ahead of the ordinary function bodies. One
 *  `static tk_t_<Impl> *__di_materialize_<Impl>(tk_region *r)` per registered provider builds the
 *  instance via the impl's zero-arg static factory, caching it per lifetime (singleton → root,
 *  scoped → the passed region which walks up the arena tree, transient → fresh every call). */

fn emit_di_materializers(buf: []byte, prog: CgProg, reg: checker::DiRegistry) -> []byte | error {
    mut out = buf
    mut seen: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= reg.providers.len { break }
        let p = reg.providers[i]
        if !cg_str_in(seen, p.impl_name) {
            seen = teko::list::push(seen, p.impl_name)
            out = match emit_di_materializer(out, prog, p) { []byte as o => o; error as e => return e }
        }
        i++
    }
    out
}

/** (W10c/MEM-3) Emit a forward prototype for every DI materializer, so a caller emitted before the
 *  materializer definition still resolves under C23's declare-before-use rule. */

fn emit_di_materializer_protos(buf: []byte, reg: checker::DiRegistry) -> []byte | error {
    mut out = buf
    mut seen: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= reg.providers.len { break }
        let p = reg.providers[i]
        if !cg_str_in(seen, p.impl_name) {
            seen = teko::list::push(seen, p.impl_name)
            out = cb(out, "static ")
            out = mangle_type_name(out, "", p.impl_name)
            out = cb(out, " *")
            out = cb(out, checker::di_materializer_name(checker::mangle_ns_frag(p.impl_name)))
            out = cb(out, "(tk_region *r);\n")
        }
        i++
    }
    out
}

/** (W10c/MEM-3) One provider's materializer definition (see emit_di_materializers). The materializer
 *  SYMBOL uses the impl's canonical name collapsed to a C-safe symbol (`mangle_ns_frag`), matching
 *  the checker's lowered call and keeping two same-bare impls in different namespaces distinct (issue
 *  #284); the C TYPE uses the same canonical (namespace-mangled) name. The factory is resolved by an
 *  EXACT canonical-namespace match, so a same-bare cousin's factory is never chosen by mistake. */

fn emit_di_materializer(buf: []byte, prog: CgProg, p: checker::DiProvider) -> []byte | error {
    let sym = checker::mangle_ns_frag(p.impl_name)
    let factory_ns = match cg_find_di_factory_ns(prog, p.impl_name, p.factory) { str as ns => ns; null => return error { message = $"codegen: DI factory `{p.factory}` not found on `{p.impl_name}`" } }
    mut out = cb(buf, "static ")
    out = mangle_type_name(out, "", p.impl_name)
    out = cb(out, " *")
    out = cb(out, checker::di_materializer_name(sym))
    out = cb(out, "(tk_region *r) {\n")
    out = di_emit_materializer_body(out, p, factory_ns, sym)
    cb(out, "}\n")
}

/** (issue #284) Resolve a DI factory's mangled namespace by an EXACT canonical class-namespace match
 *  (`class_canon` is the impl's full canonical name, and every effective method is stamped under the
 *  owning class's canonical namespace), so two same-bare classes never share a factory. */

fn cg_find_di_factory_ns(prog: CgProg, class_canon: str, method: str) -> str | null {
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as tf => { if tf.name == method && tf.namespace == class_canon { return tf.namespace } }
            _ => { }
        }
        i++
    }
    null
}

/** (W10c/MEM-3) The lifetime-specific body of a materializer: transient builds fresh; singleton and
 *  scoped consult the arena registry (root vs. the passed region) before building + registering. */

fn di_emit_materializer_body(buf: []byte, p: checker::DiProvider, factory_ns: str, sym: str) -> []byte {
    match p.kind {
        parser::DiKind::Transient => di_emit_transient_body(buf, p, factory_ns)
        _ => di_emit_cached_body(buf, p, factory_ns, sym)
    }
}

/** (W10c/MEM-3) A transient materializer builds a fresh instance every call (no registry). */

fn di_emit_transient_body(buf: []byte, p: checker::DiProvider, factory_ns: str) -> []byte {
    mut out = cb(buf, "    (void)r;\n    return ")
    out = cb_fn_name(out, factory_ns, p.factory)
    cb(out, "();\n")
}

/** (W10c/MEM-3) A singleton/scoped materializer looks up an already-built instance (root region for
 *  a singleton, the passed region — which walks up the arena tree — for a scoped one), returning it
 *  on a hit, else building via the factory and registering it in that region. */
