use teko::list
use teko::checker
use teko::parser

// teko::codegen functions (split 5/49 from codegen.tks — mechanical, pure reorg, no logic changes).

// (W10b.CLASS increment 4) SOUNDNESS GUARD: does expression `e` read `name` ANYWHERE, with NO
// exemptions? This is DELIBERATELY NOT escape.tks's `mark_expr` — that walker's "a scalar field
// off a bare local is a safe stack-member copy" refinement is sound for an ordinary STRUCT
// (which lives ON THE C STACK, so the struct binding itself always survives a frame-region drop —
// only ITS recursive-back-edge fields are heap pointers), but is UNSOUND for a CLASS instance
// (which is ALWAYS heap/region-resident — `d.age` after `tk_region_drop(d->__region)` would read
// FREED memory). So the destruction hook cannot reuse the escaping SET alone: it additionally
// requires that the binding is not referenced ANYWHERE in the SPECIFIC tail/return expression
// that runs immediately after the injected cleanup (earlier, non-tail statements are unaffected —
// they execute in original order, BEFORE the function-exit cleanup). Unhandled/complex shapes
// (TIfExpr/TMatchExpr/TLambda — nested blocks) conservatively answer `true` (assume referenced) —
// always SAFE, it only means less aggressive cleanup, never a use-after-free.
fn cg_expr_refs_name(e: checker::TExpr, name: str) -> bool {
    match e.kind {
        checker::TVar as v => v.name == name
        checker::TNumber => false
        checker::TStrLit => false
        checker::TByteLit => false
        checker::TCharLit => false
        checker::TBoolLit => false
        checker::TNullLit => false
        checker::TPathExpr => false
        checker::TBinary as b => cg_expr_refs_name(b.left, name) || cg_expr_refs_name(b.right, name)
        checker::TUnary as u => cg_expr_refs_name(u.operand, name)
        checker::TCompare as c => {
            if cg_expr_refs_name(c.first, name) { true } else {
                mut i = 0
                mut found = false
                loop { if i >= c.rest.len { break }; if cg_expr_refs_name(c.rest[i].operand, name) { found = true; break }; i++ }
                found
            }
        }
        checker::TCall as c => {
            mut i = 0
            mut found = false
            loop { if i >= c.args.len { break }; if cg_expr_refs_name(c.args[i], name) { found = true; break }; i++ }
            found
        }
        checker::TCast as ct => cg_expr_refs_name(ct.expr, name)
        checker::TFieldAccess as fa => cg_expr_refs_name(fa.receiver, name)
        checker::TIndex as ix => cg_expr_refs_name(ix.receiver, name) || cg_expr_refs_name(ix.index, name)
        checker::TInterp as ip => {
            mut i = 0
            mut found = false
            loop { if i >= ip.holes.len { break }; if cg_expr_refs_name(ip.holes[i], name) { found = true; break }; i++ }
            found
        }
        checker::TInExpr as ie => {
            if cg_expr_refs_name(ie.lhs, name) { true } else {
                mut i = 0
                mut found = false
                loop { if i >= ie.elems.len { break }; if cg_expr_refs_name(ie.elems[i], name) { found = true; break }; i++ }
                found
            }
        }
        checker::TStructInit as si => {
            mut i = 0
            mut found = false
            loop { if i >= si.field_vals.len { break }; if cg_expr_refs_name(si.field_vals[i], name) { found = true; break }; i++ }
            found
        }
        checker::TArrayLit as al => {
            mut i = 0
            mut found = false
            loop { if i >= al.elements.len { break }; if cg_expr_refs_name(al.elements[i].expr, name) { found = true; break }; i++ }
            found
        }
        // TIfExpr / TMatchExpr / TLambda contain nested BLOCKS (statement lists), not just
        // sub-expressions — conservatively assume referenced (safe: skips cleanup, never a UAF).
        _ => true
    }
}

// (W10b.CLASS increment 4) does `class_name` declare a `destruct(self) -> void` method (own or
// inherited — `type_struct_methods` stamps EVERY effective method under the OWNING class's own
// namespace, so searching for a TFunction named "destruct" whose namespace's last segment is
// `class_name` finds it either way)? Returns that method's mangled NAMESPACE (for cb_fn_name) or
// null if the class isn't destructible. Scoped assumption: one class of a given bare name per
// program (a name collision across namespaces both with a `destruct` is not disambiguated here).
fn cg_find_destruct_ns(prog: CgProg, class_name: str) -> str | null {
    cg_find_method_ns(prog, class_name, "destruct")
}

// (W10b.D3, generalized from increment 4's destruct lookup) does `class_name` provide a method
// named `method` (own or inherited — `type_struct_methods` stamps EVERY effective method under
// the OWNING class's own namespace, so searching for a TFunction named `method` whose namespace's
// last segment is `class_name` finds it either way)? Returns that method's mangled NAMESPACE (for
// cb_fn_name) or null. Scoped assumption: one class of a given bare name per program (a name
// collision across namespaces is not disambiguated here). Mirror of codegen.c::cg_find_method_ns.
fn cg_find_method_ns(prog: CgProg, class_name: str, method: str) -> str | null {
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as tf => {
                if tf.name == method {
                    if tf.namespace == class_name { return tf.namespace }
                    if teko::str::ends_with(tf.namespace, "::" ~ class_name) { return tf.namespace }
                }
            }
            _ => { }
        }
        i++
    }
    null
}

/**
 * Is this binding's initializer a BORROWED VIEW of another region's storage — i.e. a value
 * that aliases memory the class-cleanup hook must NOT drop? A `let slot = slots[i]` reads the
 * class POINTER already stored in the slice's backing array, so `slot` and the slice element
 * are the SAME pointer sharing one `__region`. Dropping `slot->__region` at scope exit would
 * free storage the slice still owns (a use-after-free the moment the slice is read again), so
 * the cleanup hook skips a binding whose initializer indexes a slice: the slice owns the
 * region, the local only borrows it.
 *
 * @param b  the top-level `let`/`mut` binding under consideration
 * @return   true when the initializer is a slice-element read (an aliasing borrow); false when
 *           the binding owns its object (a fresh construction, call result, or field read)
 * @since #325
 */
fn cg_binding_is_slice_element_borrow(b: checker::TBinding) -> bool {
    match b.value.kind {
        checker::TIndex as ix => match ix.receiver.type { checker::Slice => true; _ => false }
        _ => false
    }
}

/**
 * Emit THE DESTRUCTION HOOK text: for every TOP-LEVEL `let`/`mut` binding that owns a CLASS
 * object, a call to its `destruct()` (if declared) followed by a drop of its own per-object
 * arena region (`__region`, set at construction — emit_struct_init_framed). (W10b.CLASS
 * increment 4.) A binding qualifies only when it is a simple name (not `_`, not `const`), NOT
 * in the escaping set (provably frame-local — never returned/aliased outward), NOT referenced
 * in `tail_expr` (the exit edge's OWN return/tail value, evaluated AFTER this cleanup), NOT a
 * borrowed view of a slice's storage (cg_binding_is_slice_element_borrow — the slice owns that
 * region), and of a CLASS type. Scoped to TOP-LEVEL bindings only (a nested-block local is a
 * further extension, not yet covered). Called at every one of a function's exit edges
 * (emit_return / emit_exprstmt_tail's tail-value-return / emit_function's fall-through),
 * mirroring exactly where the frame region itself gets dropped.
 *
 * `has_tail`/`tail_expr` is a plain pair, NOT `checker::TExpr | null` — a nullable wrapping the
 * compiler's own large recursive TExpr type hits a latent self-host codegen gap unrelated to
 * this feature; the has-flag pair sidesteps it, matching the codebase's has_X/X convention.
 *
 * @param prog       the whole typed program (resolves a bound name to its class decl + destruct)
 * @param escaping   names that escape the frame (returned/aliased outward — never dropped here)
 * @param fn_body    the function's top-level statements, scanned for droppable class bindings
 * @param has_tail   whether `tail_expr` carries the exit edge's own return/tail value
 * @param tail_expr  the exit edge's return/tail value (consulted only when `has_tail`)
 * @return           the C cleanup text, or an error propagated from a name/symbol lookup
 * @since #122 (W10b.CLASS)
 */
fn cg_class_cleanup_text(prog: CgProg, escaping: []str, fn_body: []checker::TStatement, has_tail: bool, tail_expr: checker::TExpr) -> str | error {
    mut out: []byte = teko::list::empty()
    mut i = 0
    loop {
        if i >= fn_body.len { break }
        match fn_body[i] {
            checker::TBinding as b => {
                let name = match b.target { parser::SimpleName as sn => sn.name; parser::DestructurePattern => "" }
                let referenced_in_tail = has_tail && cg_expr_refs_name(tail_expr, name)
                let is_borrow = cg_binding_is_slice_element_borrow(b)
                if name.len > 0 && name != "_" && b.kind != parser::BindKind::Const && !cg_str_in(escaping, name) && !referenced_in_tail && !is_borrow {
                    let cname = match b.bound { checker::Named as nm => nm.name; _ => "" }
                    if cname.len > 0 && cg_is_class_named(prog, cname) {
                        match cg_find_destruct_ns(prog, cname) {
                            str as ns => {
                                out = cb_fn_name(out, ns, "destruct")
                                out = cb(out, "(")
                                out = cb_ident(out, name)
                                out = cb(out, "); ")
                            }
                            null => { }
                        }
                        out = cb(out, "tk_region_drop(")
                        out = cb_ident(out, name)
                        out = cb(out, "->__region); ")
                    }
                }
            }
            _ => { }
        }
        i++
    }
    str(out)
}

/**
 * cg_find_function_scan — the ORDER-DEFINING linear resolution of a top-level function, kept as the
 * function table's reference semantics and as the fallback for an unindexed `CgProg`.
 *
 * @param prog  codegen's threaded program view
 * @param ns    the namespace the function is declared in
 * @param name  the function's name
 * @return      the first matching function in item order
 * @throws      when no function carries that (namespace, name) pair
 */
fn cg_find_function_scan(prog: CgProg, ns: str, name: str) -> checker::TFunction | error {
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
            _ => { }
        }
        i++
    }
    error { message = "codegen: no such function" }
}

/**
 * cg_find_function — the top-level FUNCTION `name` in namespace `ns`, or a `not found` error.
 * (For call-arg wrapping — emit_call needs the callee's parameter types to wrap a bare case arg
 * into a variant param via emit_as.) (C: `cg_find_function`, which returned NULL.)
 *
 * The probe's hit is VERIFIED against the queried pair before it is returned, so the composed table
 * key never has to be injective: a mismatch simply falls through to `cg_find_function_scan`.
 *
 * @param prog  codegen's threaded program view
 * @param ns    the namespace the function is declared in
 * @param name  the function's name
 * @return      the resolved function
 * @throws      when no function carries that (namespace, name) pair
 */
fn cg_find_function(prog: CgProg, ns: str, name: str) -> checker::TFunction | error {
    if prog.ix.fns.slots.len == 0 { return cg_find_function_scan(prog, ns, name) }
    let hit = cg_table_get(prog.ix.fns, cg_fn_key(ns, name))
    if hit == 0 { return error { message = "codegen: no such function" } }
    match prog.items[hit - 1] {
        checker::TFunction as f => { if f.name == name && f.namespace == ns { return f } }
        _ => { }
    }
    cg_find_function_scan(prog, ns, name)
    error { message = "codegen: no such function" }
}

// cg_is_prim_name — is `name` a builtin scalar (prim/byte/str/error), i.e. carries no user
// decl? (C: `cg_is_prim_name`; same set as cg_is_builtin_scalar.)
fn cg_is_prim_name(name: str) -> bool { cg_is_builtin_scalar(name) }

// =========================================================================
// AUTO-BOX recursive value-type back-edges. A struct field whose (named) type can reach BACK
// to the enclosing type through BY-VALUE embedding (struct field / optional inner / variant
// member / inline-union member — a SLICE is a pointer, not a by-value edge) closes an
// infinite-size cycle in C. Such a field is emitted as a heap POINTER (tk_alloc) instead of an
// inline value: construction mallocs+copies the child, field-access derefs. Mirrors the C twin.
// A VISITED set of type names (here a `[]str` threaded by return — the functional twin of the C
// stack buffer + len/cap) dedups the reachability walk so a CYCLIC type graph is explored in
// O(V+E) (a naive depth-bounded DFS revisits exponentially on cycles → codegen hangs).
// (C: `cg_nameset`/`cg_nameset_seen`/`cg_nameset_mark`.)
// =========================================================================
fn cg_nameset_seen(seen: []str, n: str) -> bool { cg_str_in(seen, n) }
