use teko::list
use teko::parser

// src/checker/collect.tks  (namespace 'teko::checker') — pass 1 (forward refs).


/**
 * The U1 STRUCTURAL-ALIAS gate (owner ruling, cargo/20-unsafe-alias-rejeitado, docs/design/
 * c-types-and-marshalling-0.3.1.md §9.2): `unsafe` on a `type Name = <type-expr>` alias is
 * REJECTED, never silently accepted.
 *
 * The owner's semantics decides this alone: `unsafe` marks a type's OWN methods as unsafe and
 * unlocks raw pointers inside its OWN body — "se não usa, não tem pq ser unsafe". A pure alias
 * (`AliasBody`) has no methods and no body of its own; it is TRANSPARENT (`resolve_named`,
 * `resolve.tks:794`) — every reference resolves straight THROUGH to the aliased type-expression,
 * and the alias's own name never survives resolution. `unsafe_carrying_at` looks the stamp up on
 * a surviving `Named` (`resolve.tks:1158`); for an alias there is none left to find, so the
 * modifier would otherwise compile and do NOTHING — a safe-looking wrapper could carry unsafe
 * data straight past the contagion gate (the defect this rejects).
 *
 * This holds UNIFORMLY regardless of the alias's right-hand side — a structural target
 * (`ptr<byte>`, `u64`, `[]T`, a bare union `A | B`) is the silent hole above, and an alias to
 * ANOTHER already-`unsafe` `Named` type (`unsafe type X = RawBuf`) is equally rejected: `X`
 * still resolves straight through to `RawBuf`, so `RawBuf`'s OWN stamp already governs every
 * use of `X` whether or not `X` itself repeats the modifier — the capability belongs to the
 * type being pointed AT, never to the alias name pointing at it. There is no reading of the
 * criterion under which an alias earns a referent of its own.
 *
 * A struct/class/enum/flags/variant/extern/interface/trait `TypeDecl` is NOT an alias — it stays
 * NOMINAL through resolution (`resolve_named`'s catch-all arm keeps a `Named{name}`, `resolve.tks:
 * 795`), so `is_unsafe_type` finds its stamp correctly and contagion already works for every one
 * of them; only `AliasBody` loses its own identity. That is the whole distinction this gate draws,
 * and it is why a nominal `unsafe type RawBuf = struct { … }` / `= class { … }` is untouched here —
 * see `c_string` (`docs/design/c-types-and-marshalling-0.3.1.md` §7.1), a nominal struct rather
 * than an alias for exactly this reason.
 *
 * @param reg  the alias's registration (blamed and located)
 * @return     one diagnostic iff the alias carries `unsafe` (empty otherwise)
 * @since 0.3.1
 */
fn reject_unsafe_alias(reg: TypeReg) -> []str {
    if !reg.decl.is_unsafe { return teko::list::empty() }
    one_diag(decl_diag(reg, $"type alias '{reg.name}' cannot be declared `unsafe` — `unsafe` marks a type's OWN methods as unsafe and unlocks raw pointers inside its OWN body, but a transparent alias (`type {reg.name} = …`) has neither: it has no methods, no body, and resolves straight through to its target, so the modifier has no referent and would otherwise compile as a silent no-op (§9.2, docs/design/c-types-and-marshalling-0.3.1.md). Declare a nominal `unsafe type {reg.name} = struct {{ … }}` (or `class`) instead if you need a real unsafe-typed wrapper — this is why `c_string` is a nominal struct, not an alias."))
}

/**
 * The R4/W0/W10b DECLARATION GATE over the whole collected table — a PURE VALIDATOR: it reads the
 * table and registers nothing, so the table the next pass sees is byte-identical whether or not a
 * declaration was rejected. That is what makes it a SOFT boundary in the all-diagnostics ruling
 * (docs/design/all-diagnostics-pre-walk-0.3.1.md §3): it collects EVERY declaration's diagnostic
 * and the build carries on into the item walk, instead of one bad field masking the whole program.
 *
 * @param table  the collected, already generic-stamped type table
 * @return       every declaration diagnostic, in table order (empty when the declarations are clean)
 */
fn validate_type_decls(table: TypeTable) -> []str {
    mut diags = check_no_duplicate_types(table)
    mut i = 0
    loop {
        if i >= table.len { break }
        diags = concat_diags(diags, validate_one_type_decl(table[i], table))
        i++
    }
    diags
}

/**
 * The located diagnostic line for a message blamed on a registered declaration as a whole (a
 * `Field` carries no position of its own, so a field-level rejection is reported at its enclosing
 * declaration's name).
 *
 * @param reg  the registration being validated
 * @param msg  the diagnostic's text
 * @return     the `file:line:col: msg` line
 * @since 0.3.1
 */
fn decl_diag(reg: TypeReg, msg: str) -> str {
    diag_at(reg.file, reg.decl.line, reg.decl.col, msg)
}

/**
 * The located diagnostic line for an inner checker `error` blamed on a registered declaration —
 * the error's own position wins when it carries one (C1-POS).
 *
 * @param reg    the registration being validated
 * @param inner  the checker error to locate
 * @return       the `file:line:col: text` line
 * @since 0.3.1
 */
fn decl_error_diag(reg: TypeReg, inner: error) -> str {
    located_diag(reg.file, reg.decl.line, reg.decl.col, inner)
}

/**
 * Every diagnostic ONE registered declaration contributes: its body's field/alias type-expressions
 * (the R4 reference escape-gate plus the U2 unsafe-contagion gate), its per-body-kind contract
 * checks, and — for an `AliasBody` only — the U1 `unsafe`-on-alias rejection
 * (`reject_unsafe_alias`). Bodies with nothing to validate (enum, flags, variant, extern)
 * contribute none.
 *
 * (S4) The declaration's own generic type-params go into scope as opaque types, so a generic body
 * field `T` resolves to `Named{T}` instead of "unknown type" — the same handling `func_type` gives
 * a generic signature. A `Ref<T>` field is still rejected by R1: its inner is a Named, not a
 * scalar Prim.
 *
 * @param reg    the registration to validate
 * @param table  the whole collected type table (for leaf probes and base/interface walks)
 * @return       the declaration's diagnostics, in declaration order
 */
fn validate_one_type_decl(reg: TypeReg, table: TypeTable) -> []str {
    let decl = reg.decl
    let tbl = type_param_table(decl.type_params, decl.type_constraints, "", table)
    match decl.body {
        parser::StructBody as sb => validate_struct_body(reg, sb, tbl, table)
        parser::AliasBody as ab => concat_diags(reject_unsafe_alias(reg), validate_field_slot(reg, "alias", ab.alias, tbl, table))
        parser::ClassBody as cb => validate_class_body(reg, cb, tbl, table)
        parser::TraitBody as trb => validate_trait_body(reg, trb, tbl, table)
        parser::InterfaceBody as ib => validate_interface_body(reg, ib, table)
        _ => teko::list::empty()
    }
}

/**
 * The R4 + U2 gate over ONE field-like slot of a declaration body (a struct/class/trait field, or
 * an alias's right-hand side): its annotation must resolve, must not BE a reference (a reference is
 * pass-down only — it cannot be stored), and must not carry unsafe data into a safe declaration.
 *
 * @param reg         the enclosing registration (blamed and located)
 * @param field_name  the slot's name, as the contagion message spells it
 * @param ann         the slot's written type annotation
 * @param tbl         the table WITH the declaration's generic type-params in scope
 * @param table       the whole collected type table (for the unsafe-carrying leaf probe)
 * @return            the slot's diagnostics (at most one — the first gate it trips)
 */
fn validate_field_slot(reg: TypeReg, field_name: str, ann: parser::TypeExpr, tbl: TypeTable, table: TypeTable) -> []str {
    let decl = reg.decl
    let ft = match resolve_type(ann, tbl, reg.namespace) {
        Type as t => t
        error as e => return one_diag(decl_error_diag(reg, e))
    }
    match ft {
        Reference => return one_diag(decl_diag(reg, "a reference cannot be stored in a struct/variant/collection"))
        _ => { }
    }
    match reject_unsafe_field_contagion(decl.name, decl.is_unsafe, field_name, ft, table) {
        error as e => one_diag(decl_error_diag(reg, e))
        null => teko::list::empty()
    }
}

/**
 * Every field of a body, gated in declaration order — one bad field never hides the next.
 *
 * @param reg     the enclosing registration
 * @param fields  the body's fields, in declaration order
 * @param tbl     the table WITH the declaration's generic type-params in scope
 * @param table   the whole collected type table
 * @return        the fields' diagnostics, in declaration order
 */
fn validate_body_fields(reg: TypeReg, fields: []parser::Field, tbl: TypeTable, table: TypeTable) -> []str {
    mut diags: []str = teko::list::empty()
    mut f: u64 = 0
    loop {
        if f >= fields.len { break }
        diags = concat_diags(diags, validate_field_slot(reg, fields[f].name, fields[f].type_ann, tbl, table))
        f++
    }
    diags
}

/**
 * The W10b.IF conformance verdict for a declaration, as a diagnostic list.
 *
 * @param reg             the declaring registration
 * @param methods         the methods that count towards conformance (a class's are its EFFECTIVE ones)
 * @param implements      the interface names the declaration claims
 * @param table           the whole collected type table
 * @param members_public  are the declaration's members implicitly public (a struct's are)?
 * @return                the conformance diagnostic, or an empty list
 */
fn conformance_diags(reg: TypeReg, methods: []parser::Function, implements: []str, table: TypeTable, members_public: bool) -> []str {
    match check_conformance(reg.decl.name, reg.namespace, methods, implements, table, members_public) {
        error as e => one_diag(decl_error_diag(reg, e))
        null => teko::list::empty()
    }
}

/**
 * A struct body's diagnostics: its fields' gates, then its interface conformance (W10b.IF — a
 * struct's members are all public).
 *
 * @param reg    the struct's registration
 * @param sb     the struct body
 * @param tbl    the table WITH the declaration's generic type-params in scope
 * @param table  the whole collected type table
 * @return       the body's diagnostics, in declaration order
 */
fn validate_struct_body(reg: TypeReg, sb: parser::StructBody, tbl: TypeTable, table: TypeTable) -> []str {
    concat_diags(validate_body_fields(reg, sb.fields, tbl, table), conformance_diags(reg, sb.methods, sb.implements, table, true))
}

/**
 * A class body's diagnostics: the inheritance-cycle guard FIRST (a cyclic base chain would make
 * every recursive base walk below diverge, so it is the one place this validator still cuts), then
 * the fields' gates, the class-shape rules (W10b.CLASS increment 2) and the conformance check over
 * the EFFECTIVE methods (W10b.IF — inherited base methods count towards conformance).
 *
 * @param reg    the class's registration
 * @param cb     the class body
 * @param tbl    the table WITH the declaration's generic type-params in scope
 * @param table  the whole collected type table
 * @return       the body's diagnostics, in declaration order
 */
fn validate_class_body(reg: TypeReg, cb: parser::ClassBody, tbl: TypeTable, table: TypeTable) -> []str {
    match class_inheritance_acyclic(reg.decl.name, table) {
        error as e => return one_diag(decl_error_diag(reg, e))
        null => { }
    }
    mut diags = validate_body_fields(reg, cb.fields, tbl, table)
    match validate_class_decl(cb, table) {
        error as e => diags = concat_diags(diags, one_diag(decl_error_diag(reg, e)))
        null => { }
    }
    let eff = match effective_class_methods(cb, table) {
        []parser::Function as m => m
        error as e => return concat_diags(diags, one_diag(decl_error_diag(reg, e)))
    }
    concat_diags(diags, conformance_diags(reg, eff, cb.implements, table, false))
}

/**
 * A trait body's diagnostics. (TR0) A trait is a struct-shaped bundle: its field types resolve
 * like a struct's (same R4 escape-gate). A GENERIC trait is outside TR0's unit and is rejected on
 * its own, before the fields — the type-params it would need in scope do not exist.
 *
 * @param reg    the trait's registration
 * @param trb    the trait body
 * @param tbl    the table WITH the declaration's generic type-params in scope
 * @param table  the whole collected type table
 * @return       the body's diagnostics, in declaration order
 */
fn validate_trait_body(reg: TypeReg, trb: parser::TraitBody, tbl: TypeTable, table: TypeTable) -> []str {
    let decl = reg.decl
    if decl.type_params.len > 0 {
        return one_diag(decl_diag(reg, $"a generic trait ('{decl.name}<…>') is not supported (TR0 — a trait is a concrete bundle)"))
    }
    concat_diags(validate_body_fields(reg, trb.fields, tbl, table), trait_method_modifier_diags(reg, trb.methods))
}
