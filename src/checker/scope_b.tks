// src/checker/scope_b.tks  (namespace 'teko::checker')

use teko::lexer
use teko::parser

 * qualifier (not merely its last segment) disambiguates two same-bare classes across namespaces:
 * a class method's ns is `owner::…::Class` (collect's `method_ns` convention), and the method
 * dispatch callee carries `[..owner.., Class, method]` (#290, #109-family). A plain `ns::fn` call
 * is unaffected — its qualifier is the target namespace, matched exactly as before.
 *
 * @param b_ns    the candidate binding's declaring namespace (never empty at the call site)
 * @param callee  the qualified call callee (`callee.segments.len > 1`)
 * @return        true iff `b_ns` equals or ends-with the callee's full `::`-joined qualifier
 * @since onda-3 (#290)
 */
fn ns_matches_call_qualifier(b_ns: str, callee: parser::Path) -> bool {
    qualifier_selects_ns(b_ns, path_qualifier(callee, callee.segments.len - 1))
}

/**
 * Does binding `b` resolve the call `callee` in env `env`? An UNQUALIFIED callee (`ns`-less) binds a
 * LOCAL (ns empty) or a function in the CURRENT namespace; a QUALIFIED callee binds a function whose
 * namespace satisfies the callee's full qualifier (`ns_matches_call_qualifier`). Shared by
 * `lookup_call` and `call_ns` so both scans apply one identical rule.
 *
 * @param b         a candidate value binding (already known to share the callee's last-segment name)
 * @param callee    the call callee path
 * @param cur_ns    the calling namespace (for the unqualified same-namespace case)
 * @param qualified whether the callee carries a qualifier (`callee.segments.len > 1`)
 * @return          true iff `b` is the call's resolved target under the namespace rules
 * @since onda-3 (#290)
 */
fn call_binding_matches(b: ValBinding, callee: parser::Path, cur_ns: str, qualified: bool) -> bool {
    if !qualified { return b.ns.len == 0 || b.ns == cur_ns }
    b.ns.len != 0 && ns_matches_call_qualifier(b.ns, callee)
}

/**
 * (#41) NAMESPACE-AWARE call resolution (mirror of C `tk_env_lookup_call`): the type of the function
 * or value the callee names. An UNQUALIFIED `name` binds a LOCAL (empty ns) or a function in the
 * CURRENT namespace; a QUALIFIED `q::…::name` binds a function whose namespace satisfies the callee's
 * full qualifier (`call_binding_matches`). Scans innermost bindings first (locals shadow), then the
 * sealed globals under the same rule.
 *
 * @param env     the typing environment (local bindings + sealed globals + current namespace)
 * @param callee  the call callee path
 * @return        the resolved target's type
 * @throws        when no binding resolves the callee (`undefined name`)
 */
fn lookup_call(env: Env, callee: parser::Path) -> Type | error {
    let name = callee.segments[callee.segments.len - 1].name
    let qualified = callee.segments.len > 1
    mut i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        let b = env.bindings[i]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.type }
    }
    mut j = env.base.len
    loop {
        if j == 0 { break }
        j = j - 1
        let b = env.base[j]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.type }
    }
    error { message = $"undefined name: {name}" }
}

/**
 * (#49) the resolved target's declaring NAMESPACE for a call — the same scan as `lookup_call` but
 * returning the winning binding's namespace. Codegen mangles a user call by this namespace; an empty
 * string means a LOCAL (empty ns), an unresolved callee, or a builtin (use the call-map / bare name).
 *
 * @param env     the typing environment
 * @param callee  the call callee path
 * @return        the resolved target's namespace, or "" for a local/builtin/unresolved callee
 */
fn call_ns(env: Env, callee: parser::Path) -> str {
    let name = callee.segments[callee.segments.len - 1].name
    let qualified = callee.segments.len > 1
    mut i = env.bindings.len
    loop {
        if i == 0 { break }
        i = i - 1
        let b = env.bindings[i]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.ns }
    }
    mut j = env.base.len
    loop {
        if j == 0 { break }
        j = j - 1
        let b = env.base[j]
        if b.name == name && call_binding_matches(b, callee, env.cur_ns, qualified) { return b.ns }
    }
    ""
}

/**
 * NotBuiltinType — the marker `builtin_type` returns for a name that is simply not a built-in: a
 * STRUCTURED "keep looking" answer, distinct from the `error` arm, which is reserved for a name
 * that IS reserved and rejected (the removed `i128`/`u128`/`f16`).
 *
 * It replaces a sentinel `error { message = "not a built-in type" }` whose only reader compared the
 * MESSAGE TEXT, from another file (`resolve.resolve_named`). Message equality as identity breaks
 * the moment anyone rewords a diagnostic — a refactor that is supposed to be safe — and the failure
 * is silent: the resolver would start propagating "not a built-in type" as a user-facing error
 * instead of falling through to the user-type rules.
 */
type NotBuiltinType = struct { }

/**
 * builtin_type — resolve an INJECTED built-in type name to its `Type` (B.19). User types
 * (struct/enum/variant) resolve against the collected registry (Etapa 3), not here.
 *
 * `i128`/`u128`/`f16` are explicit HONEST-STOP arms (drop-128, 2026-07-24): the language's widest
 * integer is 64-bit and its floats are f32/f64, so these three names never resolve to a `Prim` —
 * they name the removed 128-bit family / half-precision float and point the caller at the
 * surviving escape hatch (`teko::numeric::bigint::BigInt` / `Decimal` / `f32`) instead of being
 * reported as merely unknown.
 *
 * @param name  the surface type name to resolve
 * @return      the resolved `Type`, or `NotBuiltinType` when the name is not a built-in at all
 * @throws      when `name` is `i128`/`u128`/`f16` — removed, and rejected by NAME so the message
 *              can point at the replacement
 */
fn builtin_type(name: str) -> Type | NotBuiltinType | error {
    if name == "u8" { return Prim { kind = PrimKind::U8 } }
    if name == "u16" { return Prim { kind = PrimKind::U16 } }
    if name == "u32" { return Prim { kind = PrimKind::U32 } }
    if name == "u64" { return Prim { kind = PrimKind::U64 } }
    if name == "u128" { return error { message = "type 'u128' was removed (0.3.1): the language's widest integer is 64-bit (i64/u64). For larger integers use teko::numeric::bigint::BigInt (write '123bi') or Decimal." } }
    if name == "i8" { return Prim { kind = PrimKind::I8 } }
    if name == "i16" { return Prim { kind = PrimKind::I16 } }
    if name == "i32" { return Prim { kind = PrimKind::I32 } }
    if name == "i64" { return Prim { kind = PrimKind::I64 } }
    if name == "i128" { return error { message = "type 'i128' was removed (0.3.1): the language's widest integer is 64-bit (i64/u64). For larger integers use teko::numeric::bigint::BigInt (write '123bi') or Decimal." } }
    if name == "f16" { return error { message = "type 'f16' was removed (0.3.1): the language's floats are f32/f64. Use f32." } }
    if name == "f32" { return Prim { kind = PrimKind::F32 } }   // native floats (B.38)
    if name == "f64" { return Prim { kind = PrimKind::F64 } }   // native floats (B.38)
    if name == "bool" { return Prim { kind = PrimKind::Bool } }
    if name == "byte" { return Byte { } }
    if name == "char" { return Char { } }   // a UTF-8 codepoint (1–4 bytes) — distinct from byte / []byte
    if name == "str" { return Str { } }
    if name == "bigint" { return Named { name = "teko::numeric::bigint::BigInt" } }
    if name == "dec" { return Named { name = "teko::numeric::dec::Decimal" } }
    if name == "error" { return Error { } }
    if name == "void" { return Void { } }   // (C7.2) explicit void return annotation in extern fn declarations
    if name == "ptr" { return Ptr { inner = null } }   // (C7.1a) opaque FFI pointer (transport-only)
    if name == "uptr" { return Uptr { } }   // (C7.1a) opaque word-size unsigned (transport-only)
    NotBuiltinType { }
}

/**
 * C7.19 (#169 D0) — the ratified `Buf` transport's signature: `buf_ptr(len: u64) -> ptr<byte>`.
 * Bump-allocates `len` bytes from the currently open arena region (S1) and hands back the raw
 * address; a raw `extern` (libc/OS) writes through that pointer, and Teko re-reads the written
 * bytes by length via `bytes_from_ptr`. The region stays opaque to Teko until that read-back, so
 * no index-assignment is ever needed — the `[]byte`-param sugar is a future, separate addition.
 */
fn buf_ptr_signature() -> Type {
    let len_param: []Type = teko::list::push(teko::list::empty(), Prim { kind = PrimKind::U64 })
    Func { params = len_param; ret = Ptr { inner = Byte { } }; variadic = false; param_names = []; n_required = len_param.len; defaults = [] }
}

/**
 * Build a `str | error` result type (`tk_ffi_sres`-shaped), the union returned by the
 * value-or-error host primitives `teko::env::var` / `teko::env::cwd` / `teko::io::read_file`.
 *
 * @return  a two-member `Variant { str, error }`
 */
fn host_str_or_error() -> Type {
    mut m: []Type = teko::list::push(teko::list::empty(), Str { })
    m = teko::list::push(m, Error { })
    Variant { members = m }
}

/**
 * Build the `[]str | error` result type (`tk_ffi_slres`-shaped) returned by `teko::fs::list_dir`.
 *
 * @return  a two-member `Variant { []str, error }`
 */
fn host_strslice_or_error() -> Type {
    mut m: []Type = teko::list::push(teko::list::empty(), Slice { element = Str { } })
    m = teko::list::push(m, Error { })
    Variant { members = m }
}

/**
 * Build the `error?` result type (`tk_ffi_ures`-shaped) returned by the effect-or-error host
 * primitives `teko::env::set_var` / `teko::env::chdir` / `teko::io::write_file` /
 * `teko::io::write_file_bytes` / `teko::fs::mkdir` / `teko::fs::remove_file`.
 *
 * @return  an `Optional { inner = error }`
 */
fn host_error_optional() -> Type {
    Optional { inner = Error { } }
}

/**
 * Build a fixed `Func` type from an explicit parameter list and return type — the shared
 * constructor for every host-surface signature (all are non-generic, non-variadic, and require
 * exactly their listed parameters).
 *
 * @param params  the ordered parameter types
 * @param ret     the return type
 * @return        the corresponding `Func`
 */
fn host_func(params: []Type, ret: Type) -> Type {
    Func { params = params; ret = ret; variadic = false; param_names = []; n_required = params.len; defaults = [] }
}

/**
 * Resolve a teko HOST-STDLIB surface name (`teko::env` / `teko::io` / `teko::fs` /
 * `teko::process`) to its C-native `Func` type, mirroring the `extern fn` declarations in
 * src/env/env.tks, src/io/io.tks, src/fs/fs.tks and src/process/process.tks EXACTLY so the call's
 * checked type matches the fixed-ABI lift `emit_host_ffi` builds from it. This makes the host
 * surface resolvable for ANY standalone user project. The compiler's own project keeps binding
 * these through its discovered extern declarations (which win in `lookup_call` BEFORE this
 * fallback fires), so the path is consulted only for a user program with no local declaration —
 * additive, and byte-transparent for the compiler's own emission.
 *
 * @param name  the last path segment of the call (e.g. "args", "read_file", "list_dir", "run")
 * @return      the host primitive's `Func` type, or `error` when `name` is no host surface
 * @throws      "not a host surface function" when the name matches no host primitive
 */
fn host_surface_fn(name: str) -> Type | error {
    let str_t = Str { }
    let bytes_t = Slice { element = Byte { } }
    let str_slice_t = Slice { element = Str { } }
    if name == "args" { return host_func(teko::list::empty(), str_slice_t) }
    if name == "read_line" || name == "read_stdin" { return host_func(teko::list::empty(), str_t) }
    if name == "stdin_eof" { return host_func(teko::list::empty(), Prim { kind = PrimKind::Bool }) }
    if name == "cwd" { return host_func(teko::list::empty(), host_str_or_error()) }
    if name == "var" || name == "read_file" { return host_func(teko::list::push(teko::list::empty(), str_t), host_str_or_error()) }
    if name == "chdir" || name == "mkdir" || name == "remove_file" { return host_func(teko::list::push(teko::list::empty(), str_t), host_error_optional()) }
    if name == "set_var" || name == "write_file" { return host_func(teko::list::push(teko::list::push(teko::list::empty(), str_t), str_t), host_error_optional()) }
    if name == "write_file_bytes" {
        mut p: []Type = teko::list::push(teko::list::empty(), str_t)
        p = teko::list::push(p, bytes_t)
        return host_func(p, host_error_optional())
    }
    if name == "list_dir" { return host_func(teko::list::push(teko::list::empty(), str_t), host_strslice_or_error()) }
    if name == "run" || name == "run_quiet" { return host_func(teko::list::push(teko::list::empty(), str_slice_t), Prim { kind = PrimKind::I32 }) }
    error { message = "not a host surface function" }
}

/**
