    parser::Function { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::push(teko::list::empty(), recv_param("self")); has_return = true; return_type = named_t("i64"); body = one_stmt(e_num(0)); vis = vis; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; is_static = false; is_getter = false; is_setter = false; accessor_prop = ""; has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty(); is_operator = false; is_global = false }
}
fn iface_item(name: str, methods: []parser::Function, extends: []str): parser::Item {
    parser::Item { content = parser::TypeDecl { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::InterfaceBody { extends = extends; methods = methods }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }; namespace = ""; file = "" ; guard = parser::pred_true()}
}
fn impl_class_item(name: str, methods: []parser::Function, implements: []str): parser::Item {
    parser::Item { content = parser::TypeDecl { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::ClassBody { kind = parser::ClassKind::Sealed; has_base = false; base_name = ""; has_base_binding = false; base_binding_name = ""; implements = implements; fields = teko::list::empty(); methods = methods; consts = teko::list::empty(); is_service = false; service_lifetime = parser::ServiceLifetime::Singleton }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }; namespace = ""; file = "" ; guard = parser::pred_true()}
}
fn list1(x: parser::Function): []parser::Function { teko::list::push(teko::list::empty(), x) }
fn slist1(s: str): []str { teko::list::push(teko::list::empty(), s) }

fn mk_perm_flags(): parser::TypeDecl {
    var members = teko::list::push(teko::list::push(teko::list::empty(), "Read"), "Write")
    parser::TypeDecl { name = "Perm"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::FlagsBody { members = members; values = teko::list::empty(); methods = teko::list::empty() }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
}
fn perm_item(): parser::Item { parser::Item { content = mk_perm_flags(); namespace = ""; file = "" ; guard = parser::pred_true()} ; guard = parser::pred_true()}
fn perm_member(name: str): parser::Expr { ek(parser::PathExpr { path = parser::Path { segments = teko::list::push(teko::list::push(teko::list::empty(), parser::Segment { name = "Perm" }), parser::Segment { name = name }) } }) }
fn tr_field(name: str): parser::Field { parser::Field { name = name; type_ann = named_t("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false } }
fn tr_fields1(name: str): []parser::Field { teko::list::push(teko::list::empty(), tr_field(name)) }
