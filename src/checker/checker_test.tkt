
use teko::parser

fn ek(k: @ExprKind()): parser::Expr { parser::Expr { kind = k; line = 0; col = 0 } }
fn e_num(v: i64): parser::Expr { ek(parser::Number { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }) }
fn e_var(name: str): parser::Expr { ek(parser::Var { name = name }) }
fn pos_names(n: u64): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop { if i >= n { break }; out = teko::list::push(out, ""); i++ }
    out
}
fn st(e: parser::Expr): @Statement() { parser::ExprStmt { expr = e } }
fn one_stmt(e: parser::Expr): []@Statement() { teko::list::push(teko::list::empty(), st(e)) }
fn loop_stmt(body: []@Statement()): @Statement() { parser::LoopStmt { label = ""; init = teko::list::empty(); body = body } }
fn path1(name: str): parser::Path { parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) } }
fn named_t(name: str): @TypeExpr() { parser::NamedType { path = path1(name); args = teko::list::empty() } }

fn u32t(): @Type() { Prim { kind = PrimKind::U32 } }
fn u8t(): @Type() { Prim { kind = PrimKind::U8 } }
fn i64t(): @Type() { Prim { kind = PrimKind::I64 } }
fn boolt(): @Type() { Prim { kind = PrimKind::Bool } }
fn empty_env(): Env { Env { base_slots = teko::list::empty(); bindings = teko::list::empty(); cur_ns = ""; owner_type = ""; file = ""; base_index = nidx_empty(); ret_expected = Void { }; explicit = false } }
fn empty_table(): TypeTable { tt_empty() }
fn prim_is(t: @Type(), k: PrimKind): bool { match t { Prim as p => p.kind == k; _ => false } }

#test
fn types_compare_and_unary() {
    var env = define(empty_env(), "x", u32t(), false)
    var crest = teko::list::push(teko::list::empty(), parser::CmpTerm { op = lexer::TokenKind::Lt; operand = e_var("x") })
    var cmp = parser::Compare { first = e_var("x"); rest = crest }
    var tc = match type_compare(cmp, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(tc.type, PrimKind::Bool))
    var un = parser::Unary { op = lexer::TokenKind::Bang; operand = ek(cmp) }
    var tu = match type_unary(un, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(tu.type, PrimKind::Bool))
}

fn mk_fn(name: str, ret: @TypeExpr(), body: []@Statement()): parser::Function {
    var p = parser::Param { name = "x"; has_type = true; type_ann = named_t("u32"); is_params = false; has_default = false; default_expr = e_num(0) }
    var params = teko::list::push(teko::list::empty(), p)
    parser::Function { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = params; has_return = true; return_type = ret; body = body; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; is_static = false; is_getter = false; is_setter = false; accessor_prop = ""; has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty(); is_operator = false; is_global = false }
}

#test
fn lam_collect_descends_loop_init() {
    var refs: []str = teko::list::empty()
    var bound: []str = teko::list::empty()
    var writes: []str = teko::list::empty()
    var ib: @Statement() = parser::Binding { kind = parser::BindKind::Mut; target = parser::SimpleName { name = "_hi" }; has_type = false; type_ann = named_t("void"); is_ref = false; value = e_var("n") }
    var init: []@Statement() = teko::list::push(teko::list::empty(), ib)
    var brk: []@Statement() = teko::list::push(teko::list::empty(), parser::BreakStmt { label = "" })
    var loopnode: @Statement() = parser::LoopStmt { label = ""; init = init; body = brk }
    var stmts: []@Statement() = teko::list::push(teko::list::empty(), loopnode)
    lam_collect_block(stmts, refs, bound, writes)
    var found = false
    var i = 0
    loop {
        if i >= refs.len { break }
        if refs[i] == "n" { found = true }
        i++
    }
    teko::assert::is_true(found)
}

#test
fn chain_stats_descends_loop_init() {
    var init: []@TStatement() = teko::list::push(teko::list::empty(), t_let("_hi", tnum(3)))
    var brk: []@TStatement() = teko::list::push(teko::list::empty(), TBreakStmt { label = "" })
    var loopnode: @TStatement() = TLoopStmt { label = ""; init = init; body = brk }
    var stmts: []@TStatement() = teko::list::push(teko::list::empty(), loopnode)
    var cs = chain_stats_block(stmts, "x")
    teko::assert::is_true(cs.self_appends == 0)
}

fn i8t(): @Type() { Prim { kind = PrimKind::I8 } }
fn i16t(): @Type() { Prim { kind = PrimKind::I16 } }
fn i32t(): @Type() { Prim { kind = PrimKind::I32 } }
fn strt(): @Type() { Str { } }
fn f32t(): @Type() { Prim { kind = PrimKind::F32 } }
fn cast_of(varname: str, target_name: str): parser::Cast {
    parser::Cast { expr = e_var(varname); target = named_t(target_name) }
}
fn cast_types_to(varname: str, src: @Type(), target_name: str, want: PrimKind): bool {
    var env = define(empty_env(), varname, src, false)
    match type_cast(cast_of(varname, target_name), env, empty_table()) { TExpr as te => prim_is(te.type, want); error => false }
}
fn cast_const_types_to(v: i64, target_name: str, want: PrimKind): bool {
    var c = parser::Cast { expr = e_num(v); target = named_t(target_name) }
    match type_cast(c, empty_env(), empty_table()) { TExpr as te => prim_is(te.type, want); error => false }
}
#test
fn casts_allowed() {
    teko::assert::is_true(cast_types_to("a", i8t(), "i32", PrimKind::I32))
    teko::assert::is_true(cast_types_to("c", i32t(), "i8", PrimKind::I8))
    teko::assert::is_true(cast_types_to("d", i32t(), "u32", PrimKind::U32))
    teko::assert::is_true(cast_types_to("e", u32t(), "i8", PrimKind::I8))
    teko::assert::is_true(cast_const_types_to(200, "u8", PrimKind::U8))
    teko::assert::is_true(cast_const_types_to(5, "i8", PrimKind::I8))
}

#test
fn same_type_cast_is_redundant_warning() {
    teko::assert::is_true(cast_types_to("f", i32t(), "i32", PrimKind::I32))
}

fn bytet(): @Type() { Byte { } }
fn cast_types_to_byte(varname: str, src: @Type()): bool {
    var env = define(empty_env(), varname, src, false)
    match type_cast(cast_of(varname, "byte"), env, empty_table()) { TExpr as te => type_eq(te.type, Byte { }); error => false }
}
fn cast_const_types_to_byte(v: i64): bool {
    var c = parser::Cast { expr = e_num(v); target = named_t("byte") }
    match type_cast(c, empty_env(), empty_table()) { TExpr as te => type_eq(te.type, Byte { }); error => false }
}

#test
fn byte_int_casts_allowed() {
    teko::assert::is_true(cast_types_to("a", bytet(), "u32", PrimKind::U32))
    teko::assert::is_true(cast_types_to("b", bytet(), "u8", PrimKind::U8))
    teko::assert::is_true(cast_types_to("c", bytet(), "i64", PrimKind::I64))
    teko::assert::is_true(cast_types_to_byte("d", u8t()))
    teko::assert::is_true(cast_types_to_byte("e", u32t()))
    teko::assert::is_true(cast_const_types_to_byte(200))
}

fn foo_decl(): parser::TypeDecl {
    var fld = parser::Field { name = "token"; type_ann = named_t("u8"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
    var fields = teko::list::push(teko::list::empty(), fld)
    parser::TypeDecl { name = "Foo"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
}
fn foo_table(): TypeTable {
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "Foo"; namespace = ""; file = ""; vis = parser::Visibility::Private; decl = foo_decl() }))
}
fn color_subject(): @Type() {
    var members: []@Type() = teko::list::empty()
    members = teko::list::push(members, Named { name = "RED" })
    members = teko::list::push(members, Named { name = "GREEN" })
    members = teko::list::push(members, Named { name = "BLUE" })
    Variant { members = members }
}
fn color_table(): TypeTable {
    var t = tt_empty()
    var i = 0
    var names = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "RED"), "GREEN"), "BLUE")
    loop {
        if i >= names.len { break }
        var td = parser::TypeDecl { name = names[i]; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = teko::list::empty(); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
        t = tt_push(t, TypeReg { name = names[i]; namespace = ""; file = ""; vis = parser::Visibility::Private; decl = td })
        i++
    }
    tt_freeze(t)
}
fn case_pat(name: str): @Pattern() { parser::BindPattern { type_name = path1(name); has_binding = false; binding = ""; is_slice = false; slice_type = null; type_args = teko::list::empty() } }
fn arm_of(p: @Pattern()): parser::Arm { parser::Arm { pattern = p; has_when = false; guard = e_num(0); body = one_stmt(e_num(0)) } }
fn guarded_arm_of(p: @Pattern()): parser::Arm { parser::Arm { pattern = p; has_when = true; guard = ek(parser::BoolLit { value = true }); body = one_stmt(e_num(0)) } }

#test
fn exhaustive_barriers() {
    var opts: []@Pattern() = teko::list::push(teko::list::empty(), case_pat("RED"))
    opts = teko::list::push(opts, case_pat("GREEN"))
    var arms1: []parser::Arm = teko::list::push(teko::list::empty(), arm_of(parser::AltPattern { options = opts }))
    teko::assert::is_false(exhaustive(arms1, color_subject(), color_table(), ""))
    var arms2: []parser::Arm = teko::list::push(teko::list::empty(), arm_of(case_pat("RED")))
    arms2 = teko::list::push(arms2, arm_of(case_pat("GREEN")))
    arms2 = teko::list::push(arms2, guarded_arm_of(case_pat("BLUE")))
    teko::assert::is_false(exhaustive(arms2, color_subject(), color_table(), ""))
    var arms3: []parser::Arm = teko::list::push(teko::list::empty(), guarded_arm_of(parser::WildcardPattern { }))
    teko::assert::is_false(exhaustive(arms3, color_subject(), color_table(), ""))
}

fn color_enum_decl(): parser::TypeDecl {
    var members = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "RED"), "GREEN"), "BLUE")
    parser::TypeDecl { name = "Color"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::EnumBody { members = members; methods = teko::list::empty() }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
}
fn color_enum_table(): TypeTable {
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "Color"; namespace = ""; file = ""; vis = parser::Visibility::Private; decl = color_enum_decl() }))
}

#test
fn checker_basic_predicates() {
    i16t()
    teko::assert::is_true(is_float(Prim { kind = PrimKind::F64 }))
    teko::assert::is_true(is_float(Prim { kind = PrimKind::F32 }))
    teko::assert::is_false(is_float(Prim { kind = PrimKind::I64 }))
    teko::assert::is_true(op_is_arith_bitwise(lexer::TokenKind::Percent))
    teko::assert::is_true(op_is_arith_bitwise(lexer::TokenKind::Amp))
    teko::assert::is_false(op_is_arith_bitwise(lexer::TokenKind::Plus))
    teko::assert::is_true(prim_width(PrimKind::I32) == 32)
    teko::assert::is_true(prim_width(PrimKind::U64) == 64)
    teko::assert::is_true(prim_width(PrimKind::I8) == 8)
    var ts1: []@Type() = teko::list::push(teko::list::empty(), i64t())
    var ts2: []@Type() = teko::list::push(teko::list::empty(), i64t())
    var ts3: []@Type() = teko::list::push(teko::list::empty(), u32t())
    teko::assert::is_true(types_eq(teko::list::empty(), teko::list::empty()))
    teko::assert::is_true(types_eq(ts1, ts2))
    teko::assert::is_false(types_eq(ts1, ts3))
    teko::assert::is_true(float_fits(3.14, PrimKind::F64))
    teko::assert::is_true(float_fits(1.0, PrimKind::F32))
    teko::assert::is_false(float_fits(1.0, PrimKind::I64))
}

#test
fn checker_render_and_join() {
    var m1: []@Type() = teko::list::push(teko::list::empty(), i64t())
    var m2: []@Type() = teko::list::push(m1, Str { })
    var rms = render_members(m2)
    teko::assert::is_true(teko::str::contains(rms, "|"))
    var fparams: []@Type() = teko::list::push(teko::list::empty(), i64t())
    var rf = render_func(Func { params = fparams; ret = Str { }; variadic = false; param_names = []; n_required = (fparams).len; defaults = []; ret_extra = teko::list::empty() })
    teko::assert::is_true(teko::str::contains(rf, "->"))
    var acc1 = union_collect(teko::list::empty(), i64t(), empty_table())
    teko::assert::is_true(acc1.len == 1)
    var acc2 = union_collect(acc1, Str { }, empty_table())
    teko::assert::is_true(acc2.len == 2)
    var acc3 = union_collect(teko::list::empty(), i64t(), empty_table())
    var acc4 = union_collect(acc3, i64t(), empty_table())
    teko::assert::is_true(acc4.len == 1)
}

#test
fn checker_label_surface() {
    teko::assert::is_true(lbl_eq("outer", "outer"))
    teko::assert::is_false(lbl_eq("outer", "inner"))
    var scope: []str = teko::list::push(teko::list::push(teko::list::empty(), "outer"), "inner")
    teko::assert::is_true(lbl_enclosing(scope, "outer"))
    teko::assert::is_true(lbl_enclosing(scope, "inner"))
    teko::assert::is_false(lbl_enclosing(scope, "missing"))
    var e = error { message = "test error" }
    var surfaced = surface_at("test.tks", 3, 7, e)
    teko::assert::is_true(teko::str::contains(surfaced.message, "test.tks"))
}

#test
fn loop_label_must_be_upper_snake() {
    var empty_body: []@TStatement() = teko::list::empty()
    var bad = teko::list::push(teko::list::empty(), TLoopStmt { label = "outer"; init = teko::list::empty(); body = empty_body })
    var rbad = check_labels(bad, teko::list::empty(), false, teko::list::empty())
    teko::assert::is_true(rbad.failed)
    teko::assert::is_true(teko::str::contains(rbad.message, "UPPER_SNAKE"))
    var good = teko::list::push(teko::list::empty(), TLoopStmt { label = "OUTER"; init = teko::list::empty(); body = empty_body })
    var rgood = check_labels(good, teko::list::empty(), false, teko::list::empty())
    teko::assert::is_false(rgood.failed)
}

#test
fn subst_unify_inference() {
    var tbl = tt_empty()
    var params: []str = teko::list::push(teko::list::empty(), "T")
    var s0 = Subst { params = params; names = teko::list::empty(); types = teko::list::empty() }
    var patT: @Type() = Named { name = "T" }

    var s1 = match unify(patT, i64t(), s0, tbl) { Subst as x => x; error => s0 }
    teko::assert::is_true(prim_is(subst_type(patT, s1), PrimKind::I64))
    teko::assert::is_true(match subst_type(Named { name = "Other" }, s1) { Named as n => n.name == "Other"; _ => false })

    var patSlice: @Type() = Slice { element = Named { name = "T" } }
    var s2 = match unify(patSlice, Slice { element = Str { } }, s0, tbl) { Subst as x => x; error => s0 }
    teko::assert::is_true(match subst_type(patSlice, s2) { Slice as sl => match sl.element { Str => true; _ => false }; _ => false })

    teko::assert::is_true(match unify(patSlice, Slice { element = Void { } }, s0, tbl) { Subst => false; error => true })

    var sig: @Type() = Func { params = teko::list::push(teko::list::empty(), Named { name = "T" }); ret = Named { name = "T" }; variadic = false; param_names = []; n_required = (teko::list::push(teko::list::empty(), Named { name = "T" })).len; defaults = []; ret_extra = teko::list::empty() }
    var tps = collect_sig_type_params(sig, tbl, teko::list::empty())
    teko::assert::is_true(tps.len == 1)
    teko::assert::is_true(tps[0] == "T")
}

fn ttype_named(name: str): @TypeExpr() {
    parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) }; args = teko::list::empty() }
}
fn box_generic_table(): TypeTable {
    var fld = parser::Field { name = "value"; type_ann = ttype_named("T"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
    var body = parser::StructBody { fields = teko::list::push(teko::list::empty(), fld); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }
    var decl = parser::TypeDecl { name = "Box"; type_params = teko::list::push(teko::list::empty(), "T"); type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "Box"; namespace = ""; file = ""; vis = parser::Visibility::Private; decl = decl }))
}

#test
fn resolves_generic_type_instantiation() {
    var tbl = box_generic_table()
    var one = teko::list::push(teko::list::empty(), ttype_named("i64"))
    var inst = parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "Box" }) }; args = one }
    teko::assert::is_true(match resolve_type(inst, tbl, "") { (@Type()) as t => match t { Named as n => n.name == "Box__g__i64"; _ => false }; error => false })

    var two: []@TypeExpr() = teko::list::push(teko::list::empty(), ttype_named("i64"))
    two = teko::list::push(two, ttype_named("str"))
    var inst2 = parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "Box" }) }; args = two }
    teko::assert::is_true(match resolve_type(inst2, tbl, "") { error => true; _ => false })

    teko::assert::is_true(match resolve_type(ttype_named("Box"), tbl, "") { (@Type()) as t => match t { Named as n => n.name == "Box"; _ => false }; error => false })

    var at: []@Type() = teko::list::push(teko::list::empty(), i64t())
    at = teko::list::push(at, Str { })
    teko::assert::is_true(generic_inst_name("Box", at) == "Box__g__i64__str")
}

#test
fn splits_and_recovers_a_generic_instance_names_base() {
    var one = split_generic_instance_name("Box__g__i64")
    teko::assert::is_true(one.is_generic)
    teko::assert::is_true(one.stem == "Box")

    var two = split_generic_instance_name("Pair__g__i64__str")
    teko::assert::is_true(two.is_generic)
    teko::assert::is_true(two.stem == "Pair")

    var plain = split_generic_instance_name("teko::parser::MainFile")
    teko::assert::is_true(!plain.is_generic)

    teko::assert::is_true(named_case_name("Box__g__i64") == "Box")
    teko::assert::is_true(named_case_name("teko::parser::MainFile") == "MainFile")
    teko::assert::is_true(named_case_name("MainFile") == "MainFile")
}

#test
fn resolves_ptr_generic() {
    var ptr_i64 = parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "ptr" }) }; args = teko::list::push(teko::list::empty(), ttype_named("i64")) }
    var pi = match resolve_type(ptr_i64, empty_table(), "") { (@Type()) as t => t; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(match pi { Ptr as p => match p.inner { null => false; (@Type()) as t => match t { Prim => true; _ => false } }; _ => false })
    teko::assert::is_true(type_eq(pi, pi))
    var bare = match resolve_type(ttype_named("ptr"), empty_table(), "") { (@Type()) as t => t; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(match bare { Ptr as p => match p.inner { null => true; (@Type()) as _gt2 => false }; _ => false })   /* opaque ptr = null inner */
    teko::assert::is_true(!type_eq(bare, pi))
}

fn ref_te_of(inner: @TypeExpr()): @TypeExpr() {
    parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "Ref" }) }; args = teko::list::push(teko::list::empty(), inner) }
}
fn ref_te(name: str): @TypeExpr() { ref_te_of(ttype_named(name)) }

#test
fn mem_ref_not_struct_field() {
    var fld = parser::Field { name = "r"; type_ann = ref_te_of(ref_te("i64")); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
    var decl = parser::TypeDecl { name = "Holder"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = teko::list::push(teko::list::empty(), fld); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
    var items: []parser::Item = teko::list::push(teko::list::empty(), parser::Item { content = decl; namespace = ""; file = "" ; guard = parser::pred_true()})
    teko::assert::is_true(collect(parser::Program { items = items }).decl_diags.len > 0)
    var okfld = parser::Field { name = "n"; type_ann = named_t("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
    var okdecl = parser::TypeDecl { name = "Holder2"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = teko::list::push(teko::list::empty(), okfld); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
    var okitems: []parser::Item = teko::list::push(teko::list::empty(), parser::Item { content = okdecl; namespace = ""; file = "" ; guard = parser::pred_true()})
    var ok = collect(parser::Program { items = okitems })
    teko::assert::is_true(ok.decl_diags.len == 0 && ok.sig_diags.len == 0)
}

#test
fn mem_ref_not_collection_or_variant() {
    teko::assert::is_true(match resolve_type(parser::SliceType { element = ref_te_of(ref_te("i64")) }, empty_table(), "") { error => true; _ => false })
    var members: []@TypeExpr() = teko::list::push(teko::list::push(teko::list::empty(), ref_te_of(ref_te("i64"))), ttype_named("i64"))
    teko::assert::is_true(match resolve_type(parser::UnionType { members = members }, empty_table(), "") { error => true; _ => false })
}

#test
fn bind_pattern_explicit_type_args_resolves_instance() {
    var tbl = box_generic_table()
    var args = teko::list::push(teko::list::empty(), ttype_named("i64"))
    var bp = parser::BindPattern { type_name = path1("Box"); has_binding = true; binding = "x"; is_slice = false; slice_type = null; type_args = args }
    teko::assert::is_true(match bind_pattern_type(bp, tbl, "") { (@Type()) as t => match t { Named as n => n.name == "Box__g__i64"; _ => false }; error => false })   /* (#109 W1) ref_ns = "" in the test */
    var plain = parser::BindPattern { type_name = path1("Box"); has_binding = true; binding = "x"; is_slice = false; slice_type = null; type_args = teko::list::empty() }
    teko::assert::is_true(match bind_pattern_type(plain, tbl, "") { (@Type()) as t => match t { Named as n => n.name == "Box"; _ => false }; error => false })   /* (#109 W1) ref_ns = "" in the test */
}

fn tvar(name: str, t: @Type()): TExpr { TExpr { kind = TVar { name = name; is_func = false; func_ns = "" }; type = t; line = 0; col = 0 } }
fn tnum(v: i64): TExpr { TExpr { kind = TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }; type = i64t(); line = 0; col = 0 } }
fn gfn(name: str, param_ann: @TypeExpr(), ret: @Type(), body: []@TStatement()): TFunction {
    var tps: []str = teko::list::push(teko::list::empty(), "T")
    var tcs: []@ConstraintExpr() = teko::list::push(teko::list::empty(), parser::NoConstraint { })
    var p = parser::Param { name = "x"; has_type = true; type_ann = param_ann; is_params = false; has_default = false; default_expr = e_num(0) }
    var params = teko::list::push(teko::list::empty(), p)
    TFunction { overload_suffix = ""; name = name; type_params = tps; type_constraints = tcs; params = params; return_type = ret; body = body; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}
fn plainfn(name: str, ret: @Type(), body: []@TStatement()): TFunction {
    TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = ret; body = body; vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}
fn tcall1(name: str, arg: TExpr, rt: @Type()): TExpr {
    var callee = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) }
    var args = teko::list::push(teko::list::empty(), arg)
    TExpr { kind = TCall { overload_suffix = ""; callee = callee; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = rt; line = 0; col = 0 }
}
fn texpr_stmt(e: TExpr): @TStatement() { TExprStmt { expr = e } }
fn treturn(e: TExpr): @TStatement() { TReturn { has_value = true; value = e; values = teko::list::empty() } }
fn find_titem_fn(prog: TProgram, name: str): bool {
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] { TFunction as f => { if teko::runtime::str_eq(f.name, name) { return true } }; _ => { } }
        i++
    }
    false
}
fn has_stamped_instance(prog: TProgram, bare: str): bool {
    var needle = teko::str::concat(bare, "__g__")
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] { TFunction as f => { if teko::str::contains(f.name, needle) { return true } }; _ => { } }
        i++
    }
    false
}
fn count_generic_fns(prog: TProgram): u64 {
    var n: u64 = 0
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] { TFunction as f => { if f.type_params.len > 0 { n++ } }; _ => { } }
        i++
    }
    n
}

#test
fn mono_stamps_two_instances() {
    var gbody = teko::list::push(teko::list::empty(), treturn(tvar("x", Named { name = "T" })))
    var idg = gfn("idg", named_t("T"), Named { name = "T" }, gbody)
    var call_i = texpr_stmt(tcall1("idg", tnum(7), i64t()))
    var call_s = texpr_stmt(tcall1("idg", TExpr { kind = TStrLit { text = "hi" }; type = strt(); line = 0; col = 0 }, strt()))
    var items: []@TItem() = teko::list::push(teko::list::empty(), idg)
    items = teko::list::push(items, call_i)
    items = teko::list::push(items, call_s)
    var prog = TProgram { items = items }
    var mp = match monomorphize(prog, empty_table()) { TProgram as x => x; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(count_generic_fns(mp) == 0)
    teko::assert::is_true(find_titem_fn(mp, "idg__g__i64"))
    teko::assert::is_true(find_titem_fn(mp, "idg__g__str"))
    var found_i64_ret = false
    var i = 0
    loop {
        if i >= mp.items.len { break }
        match mp.items[i] { TFunction as f => { if teko::runtime::str_eq(f.name, "idg__g__i64") { found_i64_ret = prim_is(f.return_type, PrimKind::I64) } }; _ => { } }
        i++
    }
    teko::assert::is_true(found_i64_ret)
}

#test
fn mono_slice_and_optional_mangle() {
    var idx = TExpr { kind = TIndex { receiver = tvar("xs", Slice { element = Named { name = "T" } }); index = tnum(0) }; type = Named { name = "T" }; line = 0; col = 0 }
    var fbody = teko::list::push(teko::list::empty(), treturn(idx))
    var firstg = gfn("firstg", parser::SliceType { element = named_t("T") }, Named { name = "T" }, fbody)
    var arg = tvar("v", Slice { element = i64t() })
    var caller = texpr_stmt(tcall1("firstg", arg, i64t()))
    var items: []@TItem() = teko::list::push(teko::list::empty(), firstg)
    items = teko::list::push(items, caller)
    var mp = match monomorphize(TProgram { items = items }, empty_table()) { TProgram as x => x; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(find_titem_fn(mp, "firstg__g__i64"))

    var hbody = teko::list::push(teko::list::empty(), treturn(tvar("x", Named { name = "T" })))
    var idh = gfn("idh", named_t("T"), Named { name = "T" }, hbody)
    var slice_arg = tvar("s", Slice { element = i64t() })
    var hcaller = texpr_stmt(tcall1("idh", slice_arg, Slice { element = i64t() }))
    var items2: []@TItem() = teko::list::push(teko::list::empty(), idh)
    items2 = teko::list::push(items2, hcaller)
    var mp2 = match monomorphize(TProgram { items = items2 }, empty_table()) { TProgram as x => x; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(count_generic_fns(mp2) == 0)
    teko::assert::is_true(has_stamped_instance(mp2, "idh"))
    teko::assert::is_true(teko::str::len(mono_type_mangle(Slice { element = i64t() })) > 0)
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Variant { members = teko::list::empty() }), "variant"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Str { }), "str"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Byte { }), "byte"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Error { }), "error"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Void { }), "void"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Ptr { inner = null }), "ptr"))
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Uptr { }), "uptr"))
    teko::assert::is_true(teko::str::len(mono_type_mangle(Reference { inner = i64t() })) > 0)
    teko::assert::is_true(teko::runtime::str_eq(mono_type_mangle(Named { name = "Foo" }), "Foo"))
}

#test
fn mono_walk_covers_node_kinds() {
    var idg = gfn("idg", named_t("T"), Named { name = "T" }, teko::list::push(teko::list::empty(), treturn(tvar("x", Named { name = "T" }))))

    var n = tvar("n", i64t())
    var bin = TExpr { kind = TBinary { op = lexer::TokenKind::Plus; left = n; right = tnum(1) }; type = i64t(); line = 0; col = 0 }
    var cmpterm = TCmpTerm { op = lexer::TokenKind::Lt; operand = tnum(10) }
    var cmp = TExpr { kind = TCompare { first = n; rest = teko::list::push(teko::list::empty(), cmpterm) }; type = boolt(); line = 0; col = 0 }
    var un = TExpr { kind = TUnary { op = lexer::TokenKind::Minus; operand = n }; type = i64t(); line = 0; col = 0 }
    var cast = TExpr { kind = TCast { expr = n }; type = u8t(); line = 0; col = 0 }
    var arr = TExpr { kind = TArrayLit { elements = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = tnum(1) }) }; type = Slice { element = i64t() }; line = 0; col = 0 }
    var interp = TExpr { kind = TInterp { pieces = teko::list::push(teko::list::push(teko::list::empty(), "v"), ""); holes = teko::list::push(teko::list::empty(), n); specs = teko::list::push(teko::list::empty(), TFSpec { kind = TFSpecNone { } }) }; type = strt(); line = 0; col = 0 }
    var inx = TExpr { kind = TInExpr { lhs = n; elems = teko::list::push(teko::list::empty(), tnum(2)) }; type = boolt(); line = 0; col = 0 }
    var ife = TExpr { kind = TIfExpr { cond = cmp; then_blk = teko::list::push(teko::list::empty(), texpr_stmt(tnum(1))); has_else = true; else_blk = teko::list::push(teko::list::empty(), texpr_stmt(tnum(2))) }; type = i64t(); line = 0; col = 0 }
    var genstamp = tcall1("idg", tnum(5), i64t())

    var body: []@TStatement() = teko::list::push(teko::list::empty(), TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = "a" }; bound = i64t(); value = bin })
    body = teko::list::push(body, TAssign { kind = parser::AssignKind::Simple; name = "a"; op = lexer::TokenKind::Assign; bound = i64t(); value = un; deref = false; target = no_texpr() })
    body = teko::list::push(body, texpr_stmt(cast))
    body = teko::list::push(body, texpr_stmt(arr))
    body = teko::list::push(body, texpr_stmt(interp))
    body = teko::list::push(body, texpr_stmt(inx))
    body = teko::list::push(body, texpr_stmt(ife))
    body = teko::list::push(body, texpr_stmt(genstamp))
    var loopbody: []@TStatement() = teko::list::push(teko::list::empty(), TBreakStmt { label = "" })
    loopbody = teko::list::push(loopbody, TContinueStmt { label = "" })
    body = teko::list::push(body, TLoopStmt { label = ""; init = teko::list::empty(); body = loopbody })
    body = teko::list::push(body, TDeferStmt { body = teko::list::push(teko::list::empty(), texpr_stmt(tnum(0))) })
    body = teko::list::push(body, treturn(tnum(0)))

    var caller = plainfn("caller", i64t(), body)
    var items: []@TItem() = teko::list::push(teko::list::empty(), idg)
    items = teko::list::push(items, caller)
    var mp = match monomorphize(TProgram { items = items }, empty_table()) { TProgram as x => x; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(find_titem_fn(mp, "idg__g__i64"))
    teko::assert::is_true(find_titem_fn(mp, "caller"))
}

fn t_node_init(val: TExpr): TExpr {
    var fnames = teko::list::push(teko::list::empty(), "val")
    var fvals = teko::list::push(teko::list::empty(), val)
    TExpr { kind = TStructInit { field_names = fnames; field_vals = fvals }; type = Named { name = "Node" }; line = 0; col = 0 }
}
fn t_let(name: str, value: TExpr): TBinding {
    TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = name }; bound = value.type; value = value }
}
fn t_field_i64(recv_name: str, field: str): TExpr {
    var recv = tvar(recv_name, Named { name = "Node" })
    TExpr { kind = TFieldAccess { receiver = recv; field = field }; type = i64t(); line = 0; col = 0 }
}

#test
fn escape_call_argument_is_escaping() {
    var binding = t_let("n", t_node_init(tnum(5)))
    var body: []@TStatement() = teko::list::push(teko::list::empty(), binding)
    body = teko::list::push(body, texpr_stmt(tcall1("use", tvar("n", Named { name = "Node" }), i64t())))
    var f = plainfn("f", i64t(), body)
    var esc = fn_escaping_vars(f)
    teko::assert::is_true(str_set_has(esc, "n"))
    teko::assert::is_true(!binding_is_frame_local(esc, binding))
}

fn t_node_init2(val: TExpr, next: TExpr): TExpr {
    var fnames = teko::list::push(teko::list::empty(), "val")
    fnames = teko::list::push(fnames, "next")
    var fvals = teko::list::push(teko::list::empty(), val)
    fvals = teko::list::push(fvals, next)
    TExpr { kind = TStructInit { field_names = fnames; field_vals = fvals }; type = Named { name = "Node" }; line = 0; col = 0 }
}
fn t_field_node(recv_name: str, field: str): TExpr {
    var recv = tvar(recv_name, Named { name = "Node" })
    TExpr { kind = TFieldAccess { receiver = recv; field = field }; type = Named { name = "Node" }; line = 0; col = 0 }
}

#test
fn escape_tail_implicit_return_rebox_is_escaping() {
    var binding = t_let("n", t_node_init(tnum(5)))
    var tail = t_node_init2(t_field_i64("n", "val"), t_field_node("n", "next"))
    var body: []@TStatement() = teko::list::push(teko::list::empty(), binding)
    body = teko::list::push(body, texpr_stmt(tail))
    var f = plainfn("f", Named { name = "Node" }, body)
    var esc = fn_escaping_vars(f)
    teko::assert::is_true(str_set_has(esc, "n"))
    teko::assert::is_true(!binding_is_frame_local(esc, binding))
}

#test
fn block_local_read_only_inside_block_is_block_local() {
    var binding = t_let("n", t_node_init(tnum(5)))
    var loopbody: []@TStatement() = teko::list::push(teko::list::empty(), binding)
    loopbody = teko::list::push(loopbody, t_let("g", t_field_i64("n", "val")))
    loopbody = teko::list::push(loopbody, TBreakStmt { label = "" })
    var loopstmt = TLoopStmt { label = ""; init = teko::list::empty(); body = loopbody }
    var body: []@TStatement() = teko::list::push(teko::list::empty(), t_let("t", t_node_init(tnum(0))))
    body = teko::list::push(body, loopstmt)
    body = teko::list::push(body, treturn(t_field_i64("t", "val")))
    var f = plainfn("f", i64t(), body)
    var esc = fn_escaping_vars(f)
    teko::assert::is_true(binding_is_block_local(esc, f.body, loopbody, false, binding))
}

#test
fn block_local_boxed_union_binding_is_block_local() {
    var members: []@Type() = teko::list::push(teko::list::empty(), Null { })
    members = teko::list::push(members, Named { name = "Node" })
    var union_t: @Type() = Variant { members = members }
    var binding = TBinding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "n" }
        bound = union_t
        value = t_node_init(tnum(5))
    }
    var loopbody: []@TStatement() = teko::list::push(teko::list::empty(), binding)
    loopbody = teko::list::push(loopbody, t_let("g", t_field_i64("n", "val")))
    loopbody = teko::list::push(loopbody, TBreakStmt { label = "" })
    var loopstmt = TLoopStmt { label = ""; init = teko::list::empty(); body = loopbody }
    var body: []@TStatement() = teko::list::push(teko::list::empty(), t_let("t", t_node_init(tnum(0))))
    body = teko::list::push(body, loopstmt)
    body = teko::list::push(body, treturn(t_field_i64("t", "val")))
    var f = plainfn("f", i64t(), body)
    var esc = fn_escaping_vars(f)
    teko::assert::is_true(binding_is_block_local(esc, f.body, loopbody, false, binding))
}

#test
fn escape_tail_scalar_through_boxed_hop_is_escaping() {
    var binding = t_let("n", t_node_init(tnum(5)))
    var nnext = t_field_node("n", "next")
    var deep = TExpr { kind = TFieldAccess { receiver = nnext; field = "val" }; type = i64t(); line = 0; col = 0 }
    var body: []@TStatement() = teko::list::push(teko::list::empty(), binding)
    body = teko::list::push(body, texpr_stmt(deep))
    var f = plainfn("f", i64t(), body)
    var esc = fn_escaping_vars(f)
    teko::assert::is_true(str_set_has(esc, "n"))
    teko::assert::is_true(!binding_is_frame_local(esc, binding))
}

#test
fn escape_tail_index_receiver_is_escaping() {
    var binding = t_let("n", t_node_init(tnum(5)))
    var arr = tvar("arr", Slice { element = i64t() })
    var idx = t_field_i64("n", "val")
    var tail = TExpr { kind = TIndex { receiver = arr; index = idx }; type = i64t(); line = 0; col = 0 }
