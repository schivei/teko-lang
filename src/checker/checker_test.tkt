#test
fn trait_method_with_dispatch_markers_is_error() {
    // `virtual fn` inside a trait body — the class dispatch markers are meaningless in a trait.
    mut m = impl_method("m", parser::Visibility::Private)
    let vm = parser::Function { name = m.name; type_params = m.type_params; type_constraints = m.type_constraints; params = m.params; has_return = m.has_return; return_type = m.return_type; body = m.body; vis = m.vis; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = true; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let tr = trait_item("Stamp", teko::list::empty(), list1(vm))
    teko::assert::is_true(!tr_program_ok(teko::list::push(teko::list::empty(), tr)))
}

/**
 * (TR3, #177) A struct field of a NAMED type — for the nested-recursion and nested-not-deriving
 * structural-trait tests below.
 *
 * @param name      the field name
 * @param type_name the field's named type
 * @return the `parser::Field`
 */
fn named_field(name: str, type_name: str) -> parser::Field { parser::Field { name = name; type_ann = named_t(type_name); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" } }

/**
 * (TR3) A single-field list holding one `named_field`.
 *
 * @param name      the field name
 * @param type_name the field's named type
 * @return a one-element `[]parser::Field`
 */
fn named_fields1(name: str, type_name: str) -> []parser::Field { teko::list::push(teko::list::empty(), named_field(name, type_name)) }

/**
 * (TR3) A struct deriving all five structural traits over scalar fields type-checks — the
 * synthesized `eq`/`compare`/`hash`/`clone`/`default` all type against the folded field view.
 */
#test
fn structural_derive_over_scalars_synthesizes_and_types() {
    let derives = teko::list::push(teko::list::push(teko::list::push(teko::list::push(slist1("Eq"), "Ord"), "Hash"), "Clone"), "Default")
    let dv = deriver_struct_item("P", tr_fields1("x"), teko::list::empty(), derives)
    teko::assert::is_true(tr_program_ok(teko::list::push(teko::list::empty(), dv)))
}

/**
 * (TR3 crumb 6b) `Eq` over a nested Named field whose type does NOT derive `Eq` is a located error
 * (the recursion has no `.eq` to call); when the nested type DOES derive `Eq`, the recursion
 * resolves and the program type-checks.
 */
#test
fn structural_derive_over_nonderiving_nested_is_error() {
    let q = deriver_struct_item("Q", tr_fields1("own"), teko::list::empty(), teko::list::empty())
    let p = deriver_struct_item("P", named_fields1("q", "Q"), teko::list::empty(), slist1("Eq"))
    teko::assert::is_true(!tr_program_ok(items2(q, p)))
    let q2 = deriver_struct_item("Q2", tr_fields1("own"), teko::list::empty(), slist1("Eq"))
    let p2 = deriver_struct_item("P2", named_fields1("q", "Q2"), teko::list::empty(), slist1("Eq"))
    teko::assert::is_true(tr_program_ok(items2(q2, p2)))
}

/**
 * (TR3 crumb 6c) An enum-typed field under a structural derive is an honest stop: an enum Named is
 * not a supported field shape in v1, so the synthesis raises a located error.
 */
#test
fn structural_derive_on_an_enum_is_error() {
    let members = teko::list::push(teko::list::push(teko::list::empty(), "RED"), "BLUE")
    let ed = parser::TypeDecl { name = "Hue"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::EnumBody { members = members }; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = false }
    let dv = deriver_struct_item("P", named_fields1("hue", "Hue"), teko::list::empty(), slist1("Eq"))
    teko::assert::is_true(!tr_program_ok(items2(parser::Item { content = ed; namespace = ""; file = "" }, dv)))
}

/**
 * (TR3, trait design §2) A deriver that defines `eq` BY HAND keeps its own method — synthesis is
 * SKIPPED for that name (the hand-written method IS the override), and the program type-checks.
 */
#test
fn structural_override_wins_over_synthesis() {
    let own_eq = parser::Function { name = "eq"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::push(teko::list::push(teko::list::empty(), parser::Param { name = "self"; has_type = false; type_ann = named_t(""); is_params = false; has_default = false; default_expr = e_num(0) }), parser::Param { name = "other"; has_type = true; type_ann = named_t("P"); is_params = false; has_default = false; default_expr = e_num(0) }); has_return = true; return_type = named_t("bool"); body = one_stmt(ek(parser::BoolLit { value = true })); vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let dv = deriver_struct_item("P", tr_fields1("x"), teko::list::push(teko::list::empty(), own_eq), slist1("Eq"))
    teko::assert::is_true(tr_program_ok(teko::list::push(teko::list::empty(), dv)))
}

/**
 * (TR3, R1) A `<K: Hashable & Eq>` constraint resolves for a deriver of `Hash` + `Eq` — the
 * `Hashable`≡`Hash` synonym lets the Map-key capability constraint bind against a structural-trait
 * deriver, with no parallel interface.
 */
#test
fn structural_constraint_atom_resolves_via_synonym() {
    let derives = teko::list::push(slist1("Hash"), "Eq")
    let dv = deriver_struct_item("K", tr_fields1("x"), teko::list::empty(), derives)
    let hashable_fn = tr_generic_fn("use_key", "Hashable", one_stmt(e_num(0)))
    let mk = tr_let_struct("k", "K", "x")
    let call = parser::Item { content = st(ek(parser::Call { callee = path1("use_key"); args = teko::list::push(teko::list::empty(), e_var("k")); arg_names = teko::list::push(teko::list::empty(), ""); type_args = teko::list::empty() })); namespace = ""; file = "" }
    mut items: []parser::Item = teko::list::push(teko::list::empty(), dv)
    items = teko::list::push(items, hashable_fn)
    items = teko::list::push(items, mk)
    items = teko::list::push(items, call)
    teko::assert::is_true(tr_program_ok(items))
}

/** A full program `fn both<T: Geo & Named2>(x: T) -> i64 { return x.area() }` type-checks: the
    UNION surface authorizes `area` (owned by Geo), and `Sq2` conforms to both interfaces. */
fn s6_and_program(body_method: str) -> parser::Program {
    let ifc_geo = iface_item("Geo", list1(iface_method("area")), teko::list::empty())
    let ifc_named2 = iface_item("Named2", list1(iface_method("label")), teko::list::empty())
    let sq2 = impl_class_item("Sq2", teko::list::push(list1(impl_method("area", parser::Visibility::Pub)), impl_method("label", parser::Visibility::Pub)), teko::list::push(teko::list::push(teko::list::empty(), "Geo"), "Named2"))
    let tp = teko::list::push(teko::list::empty(), "T")
    let tc: []parser::ConstraintExpr = teko::list::push(teko::list::empty(), parser::ConstraintAnd { left = parser::ConstraintAtom { name = "Geo" }; right = parser::ConstraintAtom { name = "Named2" } })
    let params = teko::list::push(teko::list::empty(), parser::Param { name = "x"; has_type = true; type_ann = named_t("T"); is_params = false; has_default = false; default_expr = e_num(0) })
    let body: []parser::Statement = teko::list::push(teko::list::empty(), parser::Return { has_value = true; value = ek(parser::MethodCall { receiver = e_var("x"); method = body_method; args = teko::list::empty() }) })
    let f = parser::Function { name = "both"; type_params = tp; type_constraints = tc; params = params; has_return = true; return_type = named_t("i64"); body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let fitem = parser::Item { content = f; namespace = ""; file = "" }
    mut items = teko::list::push(teko::list::push(teko::list::empty(), ifc_geo), ifc_named2)
    items = teko::list::push(items, sq2)
    items = teko::list::push(items, fitem)
    parser::Program { items = items }
}

#test
/** crumb-7 fixture 1: `A&B`, a method of EACH side (`x.area()`) — accepted. */
fn s6_and_constraint_authorizes_either_sides_method() {
    teko::assert::is_true(tr_program_ok(s6_and_program("area").items))
}

#test
/** crumb-7 fixture 4: nominal mono-rejection is UNTOUCHED — a concrete arg conforming to only ONE
    side of `Geo & Named2` (missing `label`/`Named2`) still fails at `check_constraints`, the
    existing per-instance safety net (S6 adds no new instance-time check). */
fn s6_and_constraint_mono_rejects_non_conforming_concrete() {
    let ifc_geo = iface_item("Geo", list1(iface_method("area")), teko::list::empty())
    let ifc_named2 = iface_item("Named2", list1(iface_method("label")), teko::list::empty())
    let sq_geo_only = impl_class_item("SqGeoOnly", list1(impl_method("area", parser::Visibility::Pub)), slist1("Geo"))
    let tp = teko::list::push(teko::list::empty(), "T")
    let tc: []parser::ConstraintExpr = teko::list::push(teko::list::empty(), parser::ConstraintAnd { left = parser::ConstraintAtom { name = "Geo" }; right = parser::ConstraintAtom { name = "Named2" } })
    let params = teko::list::push(teko::list::empty(), parser::Param { name = "x"; has_type = true; type_ann = named_t("T"); is_params = false; has_default = false; default_expr = e_num(0) })
    let body: []parser::Statement = teko::list::push(teko::list::empty(), parser::Return { has_value = true; value = ek(parser::MethodCall { receiver = e_var("x"); method = "area"; args = teko::list::empty() }) })
    let f = parser::Function { name = "both2"; type_params = tp; type_constraints = tc; params = params; has_return = true; return_type = named_t("i64"); body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let make_lit = ek(parser::StructLit { type_path = path1("SqGeoOnly"); type_args = teko::list::empty(); field_names = teko::list::empty(); field_vals = teko::list::empty() })
    let call = st(ek(parser::Call { callee = path1("both2"); args = teko::list::push(teko::list::empty(), make_lit); arg_names = pos_names(1); type_args = teko::list::empty() }))
    mut items = teko::list::push(teko::list::push(teko::list::empty(), ifc_geo), ifc_named2)
    items = teko::list::push(items, sq_geo_only)
    items = teko::list::push(items, parser::Item { content = f; namespace = ""; file = "" })
    items = teko::list::push(items, parser::Item { content = call; namespace = ""; file = "" })
    teko::assert::is_true(!tr_program_ok(items))
}

/**
 * (TR2, 2026-07-04) the compile-time FIELD VIEW — `deriver_field_view`. The compiler-internal,
 * deriver-agnostic enumeration of a struct/class's fields with each annotation resolved to a real
 * `Type` (name + type, no runtime value). See TEKO_ROADMAP_TRAITS.md TR2. TR3 (a later unit)
 * synthesizes structural-trait bodies (Eq/Ord/Hash/Clone/Default) from it.
 */
fn fv_field(name: str, type_ann: parser::TypeExpr) -> parser::Field { parser::Field { name = name; type_ann = type_ann; vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" } }
fn fv_struct_item_derives(name: str, fields: []parser::Field, derives: []str) -> parser::Item {
    parser::Item { content = parser::TypeDecl { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = derives; consts = teko::list::empty() }; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = false }; namespace = ""; file = "" }
}
fn fv_class_item(name: str, kind: parser::ClassKind, has_base: bool, base_name: str, fields: []parser::Field) -> parser::Item {
    parser::Item { content = parser::TypeDecl { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::ClassBody { kind = kind; has_base = has_base; base_name = base_name; has_base_binding = false; base_binding_name = ""; implements = teko::list::empty(); fields = fields; methods = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = false }; namespace = ""; file = "" }
}
/**
 * The collected type table of a synthetic item list — the field-view tests' fixture builder.
 *
 * `collect` no longer stops at its first error: it returns the table it built plus the
 * diagnostics it collected, and the table is complete either way, so these tests read it
 * directly and assert on the field view rather than on the collection verdict.
 *
 * @param items  the synthetic top-level items
 * @return       the collected type table
 */
fn fv_table(items: []parser::Item) -> TypeTable {
    let col = collect(parser::Program { items = items })
    col.collected.types
}

#test
/**
 * `fold_traits` runs before the field view is ever consulted — a struct deriving a trait already
 * carries the trait's field in its OWN `fields` by the time `collect()` sees it.
 */
fn field_view_struct_includes_trait_folded_fields() {
    let tr = trait_item("Stamp", tr_fields1("at"), teko::list::empty())
    let dv = fv_struct_item_derives("Post", teko::list::push(teko::list::empty(), fv_field("title", named_t("str"))), slist1("Stamp"))
    let folded = match fold_traits(parser::Program { items = items2(tr, dv) }) { parser::Program as p => p; error => { teko::assert::is_true(false); return } }
    let table = fv_table(folded.items)
    let view = match deriver_field_view("Post", table) { []FieldView as v => v; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(view.len == 2)
    teko::assert::is_true(view[0].name == "title")
    teko::assert::is_true(view[1].name == "at")
    teko::assert::is_true(type_eq(view[1].type, i64t()))
}

#test
/**
 * A class's view walks the FULL base chain (`effective_class_fields`) — base fields first, then
 * the derived class's own, exactly like construction/field-access already sees it.
 */
fn field_view_class_includes_base_chain_fields() {
    let base = fv_class_item("Animal", parser::ClassKind::Virtual, false, "", teko::list::push(teko::list::empty(), fv_field("name", named_t("str"))))
    let derived = fv_class_item("Dog", parser::ClassKind::Sealed, true, "Animal", teko::list::push(teko::list::empty(), fv_field("breed", named_t("str"))))
    let table = fv_table(items2(base, derived))
    let view = match deriver_field_view("Dog", table) { []FieldView as v => v; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(view.len == 2)
    teko::assert::is_true(view[0].name == "name")
    teko::assert::is_true(view[1].name == "breed")
}

/**
 * `subst_method_sig_names` on a method with NO `-> ret` (`has_return = false`) leaves
 * `return_type` untouched (the substitution's `else` arm) and still preserves `is_unsafe`.
 */
#test
fn subst_method_sig_names_skips_return_type_when_has_return_is_false() {
    let g = parser::Function { name = "peek"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); has_return = false; return_type = named_t("i64"); body = teko::list::empty(); vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let stamped = subst_method_sig_names(g, slist1("T"), teko::list::push(teko::list::empty(), named_t("i64")))
    teko::assert::is_false(stamped.has_return)
    teko::assert::is_false(stamped.is_unsafe)
}

/**
 * `is_must_free_name` on a name absent from the table falls through `type_table_find`'s error
 * arm, returning `false` (an unregistered name can never be `#must_free` — the defensive `error
 * => false` arm this exercises).
 */
#test
fn is_must_free_name_unknown_name_is_false() {
    teko::assert::is_false(is_must_free_name("NoSuchType", empty_table()))
}

/**
 * U2 (#333) — unsafe nominal containment + contagion-by-composition. An `unsafe type M =
 * struct { p: i64 }` item — the leaf unsafe type every U2 test builds on (a plain `i64` field
 * is enough; the FIELD shape is irrelevant to containment, only `M`'s OWN `is_unsafe` flag is).
 */
fn unsafe_leaf_item() -> parser::Item {
    let fld = parser::Field { name = "p"; type_ann = named_t("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    parser::Item { content = parser::TypeDecl { name = "M"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = teko::list::push(teko::list::empty(), fld); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = true; must_free = false }; namespace = ""; file = "" }
}

/** The `TypeTable` `unsafe_leaf_item`'s standalone program would collect — built directly (no
 *  `collect(parser::Program)` round-trip needed) since `type_binding`/`type_function` take a
 *  `TypeTable` straight, mirroring `foo_table`/`must_free_table`'s shape above. */
fn unsafe_leaf_table() -> TypeTable {
    match unsafe_leaf_item().content { parser::TypeDecl as td => tt_freeze(tt_push(tt_empty(), TypeReg { name = td.name; namespace = ""; file = ""; vis = td.vis; decl = td })); _ => tt_empty() }
}

/**
 * `method_is_effective_unsafe`'s three arms, each exercised directly: (1) the method's OWN
 * `is_unsafe` short-circuits true (never reachable through real parsing — methods always parse
 * `is_unsafe = false`, per design — but the OR-rule itself must hold if ever driven this way);
 * (2) an ABSENT owner (an unregistered `struct_name`) falls to `type_table_find`'s error arm,
 * `false`; (3) a REGISTERED owner's OWN `is_unsafe` is read when the method's own flag is false —
 * the inheritance rule (§2 line 72) that makes every method of an `unsafe type` unsafe.
 */
#test
fn method_is_effective_unsafe_all_three_arms() {
    let safe_method = parser::Function { name = "m"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); has_return = false; return_type = named_t("i64"); body = teko::list::empty(); vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""; is_intern = false; is_abstract = false; is_virtual = false; is_override = false; has_inject = false; injects = teko::list::empty(); is_unsafe = false; has_arena_size = false; arena_size = 0 to u64 }
    let unsafe_method = parser::Function { name = safe_method.name; type_params = safe_method.type_params; type_constraints = safe_method.type_constraints; params = safe_method.params; has_return = safe_method.has_return; return_type = safe_method.return_type; body = safe_method.body; vis = safe_method.vis; has_doc = safe_method.has_doc; doc = safe_method.doc; line = safe_method.line; col = safe_method.col; is_test = safe_method.is_test; is_extern = safe_method.is_extern; c_symbol = safe_method.c_symbol; from_lib = safe_method.from_lib; os_guard = safe_method.os_guard; is_intern = safe_method.is_intern; is_abstract = safe_method.is_abstract; is_virtual = safe_method.is_virtual; is_override = safe_method.is_override; has_inject = safe_method.has_inject; injects = safe_method.injects; is_unsafe = true; has_arena_size = safe_method.has_arena_size; arena_size = safe_method.arena_size }
    teko::assert::is_true(method_is_effective_unsafe(unsafe_method, "NoSuchOwner", "", empty_table()))
    teko::assert::is_false(method_is_effective_unsafe(safe_method, "NoSuchOwner", "", empty_table()))
    teko::assert::is_true(method_is_effective_unsafe(safe_method, "M", "", unsafe_leaf_table()))
    teko::assert::is_false(method_is_effective_unsafe(safe_method, "Foo", "", foo_table()))
}

/** `unsafe_carrying` recurses through `[]M` (Slice), `M | null` (Variant), `Ref<M>` (Reference), and
 *  `ptr<M>` (Ptr, present inner) — every compositional carrier the design calls out (criterion
 *  7). Each wraps the SAME unsafe leaf `M`; the safe-scalar sibling of each shape is false. The
 *  final assertion is the OPAQUE `ptr` (`inner = null`) — the `Ptr` case's `null` arm, never
 *  carrying. */
#test
fn unsafe_carrying_recurses_through_every_carrier() {
    let table = unsafe_leaf_table()
    let m = Named { name = "M" }
    teko::assert::is_true(unsafe_carrying(Slice { element = m }, table))
    teko::assert::is_false(unsafe_carrying(Slice { element = i64t() }, table))
    teko::assert::is_true(unsafe_carrying(Variant { members = teko::list::push(teko::list::push(teko::list::empty(), Null { }), m) }, table))
    teko::assert::is_false(unsafe_carrying(Variant { members = teko::list::push(teko::list::push(teko::list::empty(), Null { }), i64t()) }, table))
    teko::assert::is_true(unsafe_carrying(Reference { inner = m }, table))
    teko::assert::is_false(unsafe_carrying(Reference { inner = i64t() }, table))
    teko::assert::is_true(unsafe_carrying(Ptr { inner = m }, table))
    teko::assert::is_false(unsafe_carrying(Ptr { inner = i64t() }, table))
    teko::assert::is_false(unsafe_carrying(Ptr { inner = null }, table))
}

/** `unsafe_carrying` over a `Variant` recurses each member — true iff ANY member carries unsafe
 *  data (criterion 7's variant case), and every OTHER `Type` shape not explicitly walked
 *  (`Prim`/`Void`/`Error`/…) falls to the catch-all `_ => false` arm. `Func` is NOT a catch-all
 *  case any more (F2, adversarial review of #333) — it is asserted separately below. */
#test
fn unsafe_carrying_variant_and_catch_all() {
    let table = unsafe_leaf_table()
    let m = Named { name = "M" }
    let mixed = Variant { members = teko::list::push(teko::list::push(teko::list::empty(), i64t()), m) }
    teko::assert::is_true(unsafe_carrying(mixed, table))
    let all_safe = Variant { members = teko::list::push(teko::list::push(teko::list::empty(), i64t()), Str { }) }
    teko::assert::is_false(unsafe_carrying(all_safe, table))
    teko::assert::is_false(unsafe_carrying(Void { }, table))
    teko::assert::is_false(unsafe_carrying(Error { }, table))
}

/**
 * Builds a region-handle TypeTable (#358) — a single `#must_free` struct `Arena` with one `uptr`
 * field `region`, the Arena shape `is_region_handle_name` recognizes structurally.
 *
 * @return TypeTable  a TypeTable holding exactly the region-handle `Arena` decl
 */
fn region_handle_table() -> TypeTable {
    let fld = parser::Field { name = "region"; type_ann = named_t("uptr"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    let fields = teko::list::push(teko::list::empty(), fld)
    let decl = parser::TypeDecl { name = "Arena"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = true; must_free = true }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "Arena"; namespace = ""; file = ""; vis = parser::Visibility::Pub; decl = decl }))
}

/**
 * Builds a `#must_free` struct table whose sole field is a NON-`uptr` (`u64`) — the near-miss the
 * region-handle probe must REJECT (right `#must_free` + arity, wrong field type).
 *
 * @return TypeTable  a TypeTable with one `#must_free` single-`u64`-field struct `NotArena`
 */
fn non_uptr_must_free_table() -> TypeTable {
    let fld = parser::Field { name = "n"; type_ann = named_t("u64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    let fields = teko::list::push(teko::list::empty(), fld)
    let decl = parser::TypeDecl { name = "NotArena"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = true; must_free = true }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "NotArena"; namespace = ""; file = ""; vis = parser::Visibility::Pub; decl = decl }))
}

/**
 * Builds a `#must_free` struct table with TWO `uptr` fields — the near-miss the region-handle probe
 * must REJECT on arity (a single-field shape is required); also exercises the field-name accessor's
 * multi-field else-branch.
 *
 * @return TypeTable  a TypeTable with one `#must_free` two-`uptr`-field struct `TwoField`
 */
fn two_field_must_free_table() -> TypeTable {
    mut fields = teko::list::push(teko::list::empty(), parser::Field { name = "a"; type_ann = named_t("uptr"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" })
    fields = teko::list::push(fields, parser::Field { name = "b"; type_ann = named_t("uptr"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" })
    let decl = parser::TypeDecl { name = "TwoField"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = true; must_free = true }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "TwoField"; namespace = ""; file = ""; vis = parser::Visibility::Pub; decl = decl }))
}

/**
 * Builds a `#must_free` single-field struct whose field names an UNRESOLVABLE type — exercises
 * `is_region_handle_decl`'s `resolve_type` error arm (a field type that cannot resolve is not
 * `uptr`, so the shape is rejected without crashing).
 *
 * @return TypeTable  a TypeTable with one `#must_free` struct `BadField` whose field type is unknown
 */
fn unresolvable_field_must_free_table() -> TypeTable {
    let fld = parser::Field { name = "x"; type_ann = named_t("NoSuchType"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
    let fields = teko::list::push(teko::list::empty(), fld)
    let decl = parser::TypeDecl { name = "BadField"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::StructBody { fields = fields; methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = true; must_free = true }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "BadField"; namespace = ""; file = ""; vis = parser::Visibility::Pub; decl = decl }))
}

/**
 * Builds a `#must_free` NON-struct (interface) table — exercises `is_region_handle_decl`'s
 * non-`StructBody` reject arm (the flag is set, but the body kind disqualifies it).
 *
 * @return TypeTable  a TypeTable with one `#must_free` interface `MustIface`
 */
fn must_free_iface_table() -> TypeTable {
    let decl = parser::TypeDecl { name = "MustIface"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = parser::InterfaceBody { extends = teko::list::empty(); methods = teko::list::empty() }; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = true }
    tt_freeze(tt_push(tt_empty(), TypeReg { name = "MustIface"; namespace = ""; file = ""; vis = parser::Visibility::Pub; decl = decl }))
}

#test
fn region_handle_predicate_recognizes_arena() {
    let tbl = region_handle_table()
    teko::assert::is_false(is_region_handle_name("MustIface", must_free_iface_table()))
    teko::assert::is_true(region_handle_field_name("MustIface", must_free_iface_table()) == "")
    teko::assert::is_true(is_region_handle_name("Arena", tbl))
    teko::assert::is_true(region_handle_field_name("Arena", tbl) == "region")
    teko::assert::is_false(is_region_handle_name("Missing", tbl))
    teko::assert::is_true(region_handle_field_name("Missing", tbl) == "")
    teko::assert::is_false(is_region_handle_name("Foo", foo_table()))
    teko::assert::is_true(region_handle_field_name("Foo", foo_table()) == "token")
    teko::assert::is_false(is_region_handle_name("BadField", unresolvable_field_must_free_table()))
    teko::assert::is_false(is_region_handle_name("NotArena", non_uptr_must_free_table()))
    teko::assert::is_false(is_region_handle_name("TwoField", two_field_must_free_table()))
    teko::assert::is_true(region_handle_field_name("TwoField", two_field_must_free_table()) == "")
    teko::assert::is_false(is_region_handle_name("Color", color_enum_table()))
    teko::assert::is_true(region_handle_field_name("Color", color_enum_table()) == "")
}

/** bigint_named — the `bigint` surface type (the runtime `BigInt` struct's canonical name). */
fn bigint_named() -> Type { Named { name = "teko::numeric::bigint::BigInt" } }
/** dec_named — the `dec` surface type (the runtime `Decimal` struct's canonical name). */
fn dec_named() -> Type { Named { name = "teko::numeric::dec::Decimal" } }
/** call_lowers_to — does a lowered operator `TExpr` call `<ns>::<fn>`? */
fn call_lowers_to(te: TExpr, ns: str, fn_name: str) -> bool {
    match te.kind {
        TCall as call => call.call_ns == ns && call.callee.segments[call.callee.segments.len - 1].name == fn_name
        _ => false
    }
}

/** bignum_plus_lowers_to_add — `bigint + bigint` becomes a `teko::numeric::bigint::add` call. */
#test
fn bignum_plus_lowers_to_add() {
    let env = define(define(empty_env(), "a", bigint_named(), false), "b", bigint_named(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Plus; left = e_var("a"); right = e_var("b") }
    let te = match type_binary(bin, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(call_lowers_to(te, "teko::numeric::bigint", "add"))
}

/** bignum_percent_lowers_to_rem — `bigint % bigint` becomes a `teko::numeric::bigint::rem` call. */
#test
fn bignum_percent_lowers_to_rem() {
    let env = define(define(empty_env(), "a", bigint_named(), false), "b", bigint_named(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Percent; left = e_var("a"); right = e_var("b") }
    let te = match type_binary(bin, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(call_lowers_to(te, "teko::numeric::bigint", "rem"))
}

/** bignum_literal_adopts — `bigint + <int literal>` adopts the literal via `bigint::of`. */
#test
fn bignum_literal_adopts() {
    let env = define(empty_env(), "a", bigint_named(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Plus; left = e_var("a"); right = e_num(7) }
    let te = match type_binary(bin, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    let adopted = match te.kind { TCall as call => call.args[1]; _ => { teko::assert::is_true(false); return } }
    teko::assert::is_true(call_lowers_to(adopted, "teko::numeric::bigint", "of"))
}

/** dec_percent_is_rejected — `dec % dec` is a checker error (decimals have no remainder operator). */
#test
fn dec_percent_is_rejected() {
    let env = define(define(empty_env(), "a", dec_named(), false), "b", dec_named(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Percent; left = e_var("a"); right = e_var("b") }
    match type_binary(bin, env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "not defined on `dec`")
    }
}

/** bignum_no_implicit_promotion — `bigint + <i64 variable>` is refused, asking for an explicit `of`. */
#test
fn bignum_no_implicit_promotion() {
    let env = define(define(empty_env(), "a", bigint_named(), false), "n", i64t(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Plus; left = e_var("a"); right = e_var("n") }
    match type_binary(bin, env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "no implicit")
    }
}

/** bignum_mixing_is_rejected — mixing `bigint` and `dec` in one operation is refused. */
#test
fn bignum_mixing_is_rejected() {
    let env = define(define(empty_env(), "a", bigint_named(), false), "b", dec_named(), false)
    let bin = parser::Binary { op = lexer::TokenKind::Plus; left = e_var("a"); right = e_var("b") }
    match type_binary(bin, env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "mix")
    }
}

/** bignum_compare_lowers_to_cmp — `bigint < bigint` lowers to a `cmp(...) < 0` bool comparison. */
#test
fn bignum_compare_lowers_to_cmp() {
    let env = define(define(empty_env(), "a", bigint_named(), false), "b", bigint_named(), false)
    let crest = teko::list::push(teko::list::empty(), parser::CmpTerm { op = lexer::TokenKind::Lt; operand = e_var("b") })
    let cmp = parser::Compare { first = e_var("a"); rest = crest }
    let te = match type_compare(cmp, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::Bool))
    let inner = match te.kind { TCompare as tc => tc.first; _ => { teko::assert::is_true(false); return } }
    teko::assert::is_true(call_lowers_to(inner, "teko::numeric::bigint", "cmp"))
}

/** arith_binop — build `a <op> b` from two already-bound variable names, for the W-RULE tests below. */
fn arith_binop(op: lexer::TokenKind) -> parser::Binary {
    parser::Binary { op = op; left = e_var("a"); right = e_var("b") }
}

/** widen_same_sign_u8_u32_to_u32 — `u8 + u32` (same signedness) widens to the LARGER width `u32`,
    no explicit `to` needed (W-RULE §2.1). */
#test
fn widen_same_sign_u8_u32_to_u32() {
    let env = define(define(empty_env(), "a", u8t(), false), "b", u32t(), false)
    let te = match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::U32))
}

/** widen_same_sign_i16_i64_to_i64 — `i16 + i64` (same signedness) widens to the LARGER width
    `i64`, no explicit `to` needed (W-RULE §2.1). */
#test
fn widen_same_sign_i16_i64_to_i64() {
    let env = define(define(empty_env(), "a", i16t(), false), "b", i64t(), false)
    let te = match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::I64))
}

/** widen_mixed_sign_peer_u8_i32_to_i32 — `u8 + i32`: the signed side (`i32`, 32 bits) is
    STRICTLY WIDER than the unsigned side (`u8`, 8 bits), so every `u8` value fits `i32` — the
    peer-type widen accepts it, result `i32` (D3, W-RULE §2.2 lossless branch). */
#test
fn widen_mixed_sign_peer_u8_i32_to_i32() {
    let env = define(define(empty_env(), "a", u8t(), false), "b", i32t(), false)
    let te = match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::I32))
}

/** mixed_sign_equal_width_rejected_u64_i64 — `u64 + i64`: EQUAL width mixed sign has NO
    lossless common fixed-width type (Teko has no wider backstop after i64/u64) — an honest
    compile error demanding an explicit `to` (W-RULE §2.2 fallthrough, D3). */
#test
fn mixed_sign_equal_width_rejected_u64_i64() {
    let env = define(define(empty_env(), "a", u64t(), false), "b", i64t(), false)
    match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "no lossless common type")
    }
}

/** int_float_still_rejected — `i32 + f64` stays a compile error: int×float is unchanged by the
    W-RULE (B.38 — no implicit int↔float promotion, ever). */
#test
fn int_float_still_rejected() {
    let env = define(define(empty_env(), "a", i32t(), false), "b", f64t(), false)
    match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "no mixed int/float")
    }
}

/** float_widens_f32_f64_to_f64 — `f32 + f64` widens to the wider float (W-RULE §2.3), always
    lossless — the float join is total, unlike the int join. */
#test
fn float_widens_f32_f64_to_f64() {
    let env = define(define(empty_env(), "a", f32t(), false), "b", f64t(), false)
    let te = match type_binary(arith_binop(lexer::TokenKind::Plus), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::F64))
}

/** bitwise_widens_same_sign_u16_u64_to_u64 — `u16 & u64` (bitwise, integer-only — B.38) widens
    under the SAME W-RULE join `type_arith_binop` uses (`widen_int_binop`), completing B.22 for
    the bitwise/remainder operator class too. */
#test
fn bitwise_widens_same_sign_u16_u64_to_u64() {
    let env = define(define(empty_env(), "a", u16t(), false), "b", u64t(), false)
    let te = match type_binary(arith_binop(lexer::TokenKind::Amp), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::U64))
}

/** bitwise_mixed_sign_equal_width_rejected_u32_i32 — `u32 | i32` (equal width, mixed sign) has
    no lossless common type — the same honest-stop the arithmetic class gives, now for bitwise. */
#test
fn bitwise_mixed_sign_equal_width_rejected_u32_i32() {
    let env = define(define(empty_env(), "a", u32t(), false), "b", i32t(), false)
    match type_binary(arith_binop(lexer::TokenKind::Pipe), env, empty_table()) {
        TExpr => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "no lossless common type")
    }
}

/** cast_widen_binop — build `(a to <target>) <op> b`, the D1 class-3 shape: an explicit lossless
    widen on the left, a NATURALLY-typed variable on the right (neither a literal nor a cast, so
    `operand_may_flag_partner` does not veto the diagnostic). */
fn cast_widen_binop(op: lexer::TokenKind, target_name: str) -> parser::Binary {
    parser::Binary { op = op; left = ek(cast_of("a", target_name)); right = e_var("b") }
}

/** d1_class3_noop_widen_warns_but_types_arith — `(a to i64) + b` with `a: i32`, `b: i64` is D1
    class 3: the W-RULE would join to `i64` without the cast, so the cast changed nothing. It was a
    hard compile ERROR; the 2026-07-27 owner ruling made it a WARNING, so the expression TYPES and
    carries the joined `i64` type. This is the behavioural half of the reversal — the printed
    warning itself goes to stderr and is not observable from a unit test.

    It replaces the `c58_d1_class3_noop_widen_still_rejected` compile-fail fixture, which was
    deleted with the rejection it pinned: a construct that no longer fails cannot live in a
    compile-fail channel. */
#test
fn d1_class3_noop_widen_warns_but_types_arith() {
    let env = define(define(empty_env(), "a", i32t(), false), "b", i64t(), false)
    let te = match type_binary(cast_widen_binop(lexer::TokenKind::Plus, "i64"), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::I64))
}

/** d1_class3_noop_widen_warns_but_types_compare — the SAME operand pair spelled as a comparison,
    `(a to i64) < b`. `redundant_widen_cast_of` is shared by both sites precisely so the two can
    never disagree, and the reversal has to hold at both: the comparison types to `bool` instead of
    failing, exactly as the arithmetic spelling types to `i64`. */
#test
fn d1_class3_noop_widen_warns_but_types_compare() {
    let env = define(define(empty_env(), "a", i32t(), false), "b", i64t(), false)
    let crest = teko::list::push(teko::list::empty(), parser::CmpTerm { op = lexer::TokenKind::Lt; operand = e_var("b") })
    let cmp = parser::Compare { first = ek(cast_of("a", "i64")); rest = crest }
    let te = match type_compare(cmp, env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(prim_is(te.type, PrimKind::Bool))
}

/** d1_class1_same_type_cast_keeps_its_node — the warned same-type `x to T` must still be a `TCast`
    in the typed tree, not folded to its operand. The D4 ≤2% ARITH-CAST-RATE gate counts `TCast`
    nodes (`metrics.tks::expr_has_conversion`), so folding the node away would have silently
    disabled the very ceiling the owner named as what the warning does NOT exempt us from. */
#test
fn d1_class1_same_type_cast_keeps_its_node() {
    let env = define(empty_env(), "f", i32t(), false)
    let te = match type_cast(cast_of("f", "i32"), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    match te.kind {
        TCast => teko::assert::is_true(true)
        _ => teko::assert::is_true(false)
    }
}

/**
 * shadow_exit_func — a user-declared `pub fn exit(code: i32) -> str` signature — the exact shape
 * D2's fixture shadows the injected `exit` builtin with (one required `i32` param, no defaults).
 *
 * @return  the `Func` type `type_call`'s in-scope lookup resolves for such a declaration
 */
fn shadow_exit_func() -> Type {
    Func { params = teko::list::push(teko::list::empty(), i32t()); ret = strt(); variadic = false; param_names = teko::list::push(teko::list::empty(), "code"); n_required = 1; defaults = teko::list::empty() }
}

/**
 * exit_call_expr — the untyped call node for `exit(3)`: an unqualified, single-segment callee —
 * the exact shape the injected `panic`/`exit` builtins and a same-named user function share
 * syntactically, and the shape `tcall_is_diverging_builtin` must tell apart by RESOLUTION.
 *
 * @return  the untyped `Call`
 */
fn exit_call_expr() -> parser::Call {
    parser::Call { callee = path1("exit"); args = teko::list::push(teko::list::empty(), e_num(3)); arg_names = pos_names(1); type_args = teko::list::empty() }
}

/**
 * D2 fixture (nf-n16, part 1) — a same-named user function IN SCOPE resolves over the injected
 * `exit` builtin (`type_call`'s `in_scope` gate): the resulting call carries a real, non-empty
 * `call_ns` and the user's OWN declared return type (`str`), never the builtin's `Void`, and
 * `texpr_diverges`/`tcall_is_diverging_builtin` must recognize it as a NORMAL call — not a
 * diverging one — precisely because the RESOLUTION says so, not because of its bare name.
 */
#test
fn shadowed_exit_resolves_to_user_function_not_builtin() {
    let env = with_ns(define_fn(empty_env(), "exit", shadow_exit_func(), "mymod"), "mymod")
    let te = match type_call(exit_call_expr(), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    match te.type { Str => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match te.kind {
        TCall as c => {
            teko::assert::is_true(c.call_ns == "mymod")
            teko::assert::is_true(!tcall_is_diverging_builtin(c))
        }
        _ => teko::assert::is_true(false)
    }
    teko::assert::is_true(!texpr_diverges(te))
}

/**
 * D2 fixture (nf-n16, part 2) — THE defect this closes: before the fix, `check_trailing_value`
 * (the function-body trailing-expression check) skipped a shadowed `exit(...)` call entirely
 * because `texpr_diverges` recognized it by BARE NAME alone, so a function declaring `-> i32`
 * whose body trails a user `exit` that actually returns `str` type-checked — only `cc` caught the
 * mismatch downstream, and the own-native backend has no `cc` at all (silent miscompilation). With
 * the fix, `check_trailing_value` sees the call's TRUE type (`str`) and rejects it itself, exactly
 * as it would any other trailing-value type mismatch.
 */
#test
fn shadowed_exit_trailing_value_rejected_by_checker_not_cc() {
    let env = with_ns(define_fn(empty_env(), "exit", shadow_exit_func(), "mymod"), "mymod")
    let te = match type_call(exit_call_expr(), env, empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    let stmts: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(te))
    match check_trailing_value(stmts, i32t(), empty_table()) {
        error => teko::assert::is_true(true)
        null => teko::assert::is_true(false)
    }
}

/**
 * D2 regression guard — an UNSHADOWED `exit(...)` (no user declaration in scope) must still
 * resolve to the injected builtin and still diverge, so `check_trailing_value` still exempts it
 * from the trailing-value type check exactly as before the fix. The fix narrows recognition to
 * RESOLUTION, not name; it must never narrow which calls are STILL recognized as the true builtin.
 */
#test
fn unshadowed_exit_still_diverges_and_skips_trailing_check() {
    let te = match type_call(exit_call_expr(), empty_env(), empty_table()) { TExpr as e => e; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(texpr_diverges(te))
    let stmts: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(te))
    match check_trailing_value(stmts, i32t(), empty_table()) {
        null => teko::assert::is_true(true)
        error => teko::assert::is_true(false)
    }
}

/**
 * widen_implicit_admits_same_sign_narrower — the implicit-widening rule (owner 2026-07-29) admits a
 * narrower same-sign integer into a wider one, in BOTH signedness families. This is the direction the
 * owner's own program needs (`mut b: i64 = 1; b = a` over an `i32` `a`), and all three of his lines
 * were rejected before it existed.
 */
#test
fn widen_implicit_admits_same_sign_narrower() {
    teko::assert::is_true(numeric_widens_implicitly(i32t(), i64t()))
    teko::assert::is_true(numeric_widens_implicitly(u32t(), u64t()))
    teko::assert::is_true(numeric_widens_implicitly(u8t(), u64t()))
}

/**
 * widen_implicit_admits_unsigned_into_strictly_wider_signed — the W-RULE's mixed-sign peer case
 * (§2.2): lossless because every `u32` value fits an `i64`. Admitted implicitly for the SAME reason
 * the arithmetic regime already admits it — the two regimes ask ONE predicate so they cannot drift.
 */
#test
fn widen_implicit_admits_unsigned_into_strictly_wider_signed() {
    teko::assert::is_true(numeric_widens_implicitly(u32t(), i64t()))
}

/**
 * widen_implicit_refuses_narrowing_and_equal_width_sign_change — the implicit direction is widening
 * ONLY. A narrowing has no implicit form at all: it must be written as a `to`, which then carries the
 * fail-loud runtime fit guard. An equal-width sign change is not a widen either — neither type holds
 * the whole of the other.
 */
#test
fn widen_implicit_refuses_narrowing_and_equal_width_sign_change() {
    teko::assert::is_true(!numeric_widens_implicitly(i64t(), i32t()))
    teko::assert::is_true(!numeric_widens_implicitly(u64t(), u8t()))
    teko::assert::is_true(!numeric_widens_implicitly(i64t(), u64t()))
    teko::assert::is_true(!numeric_widens_implicitly(u64t(), i64t()))
}

/**
 * widen_implicit_refuses_identity_and_crossing_the_float_boundary — an identity is not a conversion
 * (nothing to insert), and int↔float stays explicit in both directions (B.38, unchanged).
 */
#test
fn widen_implicit_refuses_identity_and_crossing_the_float_boundary() {
    teko::assert::is_true(!numeric_widens_implicitly(i64t(), i64t()))
    teko::assert::is_true(!numeric_widens_implicitly(i32t(), f64t()))
    teko::assert::is_true(!numeric_widens_implicitly(f64t(), i64t()))
}

/**
 * widen_implicit_admits_f32_into_f64_only — the float half: `f32` → `f64` is exact for every value,
 * so it is implicit; `f64` → `f32` is not, so it stays an explicit `to`.
 */
#test
fn widen_implicit_admits_f32_into_f64_only() {
    teko::assert::is_true(numeric_widens_implicitly(f32t(), f64t()))
    teko::assert::is_true(!numeric_widens_implicitly(f64t(), f32t()))
}

/**
 * cast_lossless_widen_is_the_guard_decision — `cast_is_lossless_widen` is the ONE width table both
 * emission routes ask about whether a `to` needs the runtime fit guard, so these are the exact pairs
 * that decide it. The three that answer false are the three the native route used to get WRONG (300
 * `to` u8 answered 300; 2^40 `to` i32 answered 0; -1 `to` u32 answered 4294967295).
 */
#test
fn cast_lossless_widen_is_the_guard_decision() {
    teko::assert::is_true(cast_is_lossless_widen(PrimKind::U8, PrimKind::U64))
    teko::assert::is_true(cast_is_lossless_widen(PrimKind::I32, PrimKind::I64))
    teko::assert::is_true(cast_is_lossless_widen(PrimKind::U32, PrimKind::I64))
    teko::assert::is_true(!cast_is_lossless_widen(PrimKind::U64, PrimKind::U8))
    teko::assert::is_true(!cast_is_lossless_widen(PrimKind::I64, PrimKind::I32))
    teko::assert::is_true(!cast_is_lossless_widen(PrimKind::I64, PrimKind::U32))
    teko::assert::is_true(!cast_is_lossless_widen(PrimKind::U64, PrimKind::I64))
}

/**
 * f32_value_widens_implicitly_into_f64 — the float half of the rule, END TO END rather than as a
 * predicate: an `f32` VALUE flows into an `f64` slot with no `to` written, and the value survives
 * exactly (every `f32` is representable in `f64`, so the widening is exact for every input, never
 * merely rounded).
 *
 * CORRECTING THE RECORD: the measurement that opened this lane reported `f32 to f64` as "rejected —
 * the conversion between floats does not exist". It was never rejected. `cast_check` admits any
 * numeric pair, and the observed rejection came from `print(y)` refusing a float ARGUMENT, one line
 * past the cast. What was missing was only the IMPLICIT direction, which this test now pins.
 */
#test
fn f32_value_widens_implicitly_into_f64() {
    mut narrow: f32 = 1.5
    mut wide: f64 = 0.0
    wide = narrow
    teko::assert::is_true(wide == 1.5)
    let bound: f64 = narrow
    teko::assert::is_true(bound == 1.5)
}

/**
 * f64_to_f32_follows_ieee_and_never_panics — the DECIDED and DOCUMENTED policy for the narrowing
 * float conversion (`docs/design/cast-width-hygiene-0.3.1.md` §2.6): `f64 to f32` is IEEE-754
 * round-to-nearest — exact when the value is representable, correctly rounded when it is not, ±∞ on
 * overflow, ±0 on underflow — and it never panics.
 *
 * WHY IT IS NOT GUARDED LIKE AN INTEGER NARROW, since the owner's rule says a cast may not truncate
 * and must panic on overflow. An integer narrow that overflows answers with a finite number bearing
 * NO relation to its input (300 becoming 44), and that is the wrong answer the rule outlaws. A float
 * narrow never does: overflow yields ±∞, which IS an `f32` value and is loudly not a number anyone
 * mistakes for the input. Guarding only the overflow end would also be incoherent, because the SAME
 * range argument applies to ordinary precision loss and to underflow — `1.0e-300 to f32` is `0.0` —
 * and no language panics on those. This mirrors **C#**, whose `checked` context covers integral types
 * only and whose `(float)1e300` is `+∞`, not an exception.
 */
#test
fn f64_to_f32_follows_ieee_and_never_panics() {
    mut exact: f64 = 1.5
    let kept: f32 = exact to f32
    teko::assert::is_true(kept == 1.5)
    mut over: f64 = 1.0e300
    let saturated: f32 = over to f32
    teko::assert::is_true(saturated > 1.0e38)
    mut under: f64 = 1.0e-300
    let flushed: f32 = under to f32
    teko::assert::is_true(flushed == 0.0)
}

#test
/**
 * collect_unused_fn_warnings_flags_a_dead_private_function — a private function never called
 * anywhere in the program is reported, by name, exactly like `initanalysis.tks`'s stderr line.
 */
fn collect_unused_fn_warnings_flags_a_dead_private_function() {
    let body: []TStatement = teko::list::push(teko::list::empty(), treturn(tnum(1)))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("dead_fn", i64t(), body)) }
    let warnings = collect_unused_fn_warnings(prog)
    teko::assert::eq_u64(warnings.len, 1)
    teko::assert::str_contains(warnings[0], "unused private function")
    teko::assert::str_contains(warnings[0], "dead_fn")
}

#test
/**
 * collect_unused_fn_warnings_spares_a_called_function — a private function CALLED from another
 * function's body is not flagged (mirrors `used_in_program`'s own predicate): `main` calls
 * `caller`, `caller` calls `callee`, so all three are either exempt (`main`) or used, leaving zero
 * findings.
 */
fn collect_unused_fn_warnings_spares_a_called_function() {
    let callee_body: []TStatement = teko::list::push(teko::list::empty(), treturn(tnum(1)))
    let caller_body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(tcall1("callee", tnum(0), i64t())))
    let main_body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(tcall1("caller", tnum(0), i64t())))
    mut items: []TItem = teko::list::empty()
    items = teko::list::push(items, plainfn("callee", i64t(), callee_body))
    items = teko::list::push(items, plainfn("caller", i64t(), caller_body))
    items = teko::list::push(items, plainfn("main", i64t(), main_body))
    let warnings = collect_unused_fn_warnings(TProgram { items = items })
    teko::assert::eq_u64(warnings.len, 0)
}

#test
/**
 * collect_redundant_cast_warnings_flags_a_same_type_cast — the D1 class-1 finding: a cast whose
 * target equals its own operand's type, buried inside an expression statement.
 */
fn collect_redundant_cast_warnings_flags_a_same_type_cast() {
    let cast = TExpr { kind = TCast { expr = tvar("x", u32t()) }; type = u32t(); line = 5; col = 3 }
    let body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(cast))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("f1", i64t(), body)) }
    let warnings = collect_redundant_cast_warnings(prog)
    teko::assert::eq_u64(warnings.len, 1)
    teko::assert::str_contains(warnings[0], "redundant cast")
    teko::assert::str_contains(warnings[0], "provable no-op")
}

#test
/**
 * collect_redundant_cast_warnings_flags_a_redundant_widen_in_a_binary — the D1 class-3 finding: an
 * arithmetic `+` whose left operand is a `to u32` cast on a `u8` value while the right operand is
 * already `u32` — the W-RULE joins to `u32` either way, so the cast is provably a no-op.
 */
fn collect_redundant_cast_warnings_flags_a_redundant_widen_in_a_binary() {
    let cast = TExpr { kind = TCast { expr = tvar("x", u8t()) }; type = u32t(); line = 8; col = 4 }
    let bin = TExpr { kind = TBinary { op = lexer::TokenKind::Plus; left = cast; right = tvar("y", u32t()) }; type = u32t(); line = 8; col = 1 }
    let body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(bin))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("f2", u32t(), body)) }
    let warnings = collect_redundant_cast_warnings(prog)
    teko::assert::eq_u64(warnings.len, 1)
    teko::assert::str_contains(warnings[0], "redundant cast")
}

#test
/**
 * collect_redundant_cast_warnings_renders_the_innermost_type_through_a_synthetic_wrap — the
 * `innermost_cast_type` regression: a `to u16` cast on a `u8` value, next to a `u32` sibling,
 * WIDENS a second time (the arithmetic join is `u32`, wider than the cast's own `u16` target), so
 * the typed tree carries a SYNTHETIC outer `to u32` wrap around the programmer's own `to u16`. The
 * reported message must still name `u16` (what the source spells), never the synthetic `u32`.
 */
fn collect_redundant_cast_warnings_renders_the_innermost_type_through_a_synthetic_wrap() {
    let inner_cast = TExpr { kind = TCast { expr = tvar("x", u8t()) }; type = u16t(); line = 12; col = 4 }
    let outer_wrap = TExpr { kind = TCast { expr = inner_cast }; type = u32t(); line = 12; col = 4 }
    let bin = TExpr { kind = TBinary { op = lexer::TokenKind::Plus; left = outer_wrap; right = tvar("y", u32t()) }; type = u32t(); line = 12; col = 1 }
    let body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(bin))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("f3", u32t(), body)) }
    let warnings = collect_redundant_cast_warnings(prog)
    teko::assert::eq_u64(warnings.len, 1)
    teko::assert::str_contains(warnings[0], "to u16")
    teko::assert::str_absent(warnings[0], "to u32")
}

#test
/**
 * collect_redundant_cast_warnings_spares_a_genuine_narrowing_cast — a `to u8` cast on a `u32` value
 * is a NARROWING (checked) conversion, never a D1 finding regardless of the sibling operand.
 */
fn collect_redundant_cast_warnings_spares_a_genuine_narrowing_cast() {
    let cast = TExpr { kind = TCast { expr = tvar("x", u32t()) }; type = u8t(); line = 20; col = 4 }
    let bin = TExpr { kind = TBinary { op = lexer::TokenKind::Plus; left = cast; right = tvar("y", u8t()) }; type = u8t(); line = 20; col = 1 }
    let body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(bin))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("f4", u8t(), body)) }
    teko::assert::eq_u64(collect_redundant_cast_warnings(prog).len, 0)
}

#test
/**
 * collect_warnings_combines_both_finding_kinds — a function that is ITSELF unused AND carries a
 * redundant cast in its body reports BOTH findings, unused-fn first (`collect_warnings`'s own
 * ordering contract).
 */
fn collect_warnings_combines_both_finding_kinds() {
    let cast = TExpr { kind = TCast { expr = tvar("x", u32t()) }; type = u32t(); line = 1; col = 1 }
    let body: []TStatement = teko::list::push(teko::list::empty(), texpr_stmt(cast))
    let prog = TProgram { items = teko::list::push(teko::list::empty(), plainfn("noisy", i64t(), body)) }
    let warnings = collect_warnings(prog)
    teko::assert::eq_u64(warnings.len, 2)
    teko::assert::str_contains(warnings[0], "unused private function")
    teko::assert::str_contains(warnings[1], "redundant cast")
}

/**
 * prog_from_module_src — lex + parse `src` as a MODULE (no loose statements) and flatten its
 * declarations into a `parser::Program`, every item stamped `path` — the same shape
 * `src/lsp/diagnostics.tks::module_items` builds for an open document, reused here so
 * `collect_diagnostics_appends_a_collected_warning_after_an_error` drives the REAL end-to-end
 * seam (lex → parse → `collect_diagnostics`) instead of a hand-built `TProgram`.
 *
 * @param src   the module source text
 * @param path  the file path stamped onto every item
 * @return      the flat program (empty items on a lex/parse fault — the caller expects clean text)
 */
fn prog_from_module_src(src: str, path: str) -> parser::Program {
    let toks = match lexer::tokenize(src) { []lexer::Token as t => t; error => teko::list::empty() }
    let m = match parser::parse_module(toks, 0) { parser::Parsed<parser::Module> as x => x.node; error => parser::Module { uses = teko::list::empty(); decls = teko::list::empty() } }
    mut items: []parser::Item = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= m.decls.len { break }
        items = match m.decls[i] {
            parser::Function as f => teko::list::push(items, parser::Item { content = f; namespace = ""; file = path })
            parser::TypeDecl as t => teko::list::push(items, parser::Item { content = t; namespace = ""; file = path })
            parser::ConstDecl as c => teko::list::push(items, parser::Item { content = c; namespace = ""; file = path })
        }
        i = i + 1
    }
    parser::Program { items = items }
}

#test
/**
 * collect_diagnostics_appends_a_collected_warning_after_an_error — the crumb C regression named by
 * the design doc (`docs/design/lsp-teko.md` §9.1): a program with ONE type error (an unknown
 * parameter type) and ONE unused private function yields TWO diagnostics from `collect_diagnostics`
 * — the error, THEN the warning — proving the checker's real declaration-boundary walk (not just
 * the hand-built-tree unit tests above) actually wires `collect_warnings` in.
 */
fn collect_diagnostics_appends_a_collected_warning_after_an_error() {
    let src = "pub fn bad(x: Bogus) -> i64 { return 0 }\nfn dead_leaf() -> i64 { return 1 }\n"
    let diags = collect_diagnostics(prog_from_module_src(src, "warn.tks"))
    teko::assert::eq_u64(diags.len, 2)
    teko::assert::str_contains(diags[0], "Bogus")
    teko::assert::str_contains(diags[1], "unused private function")
    teko::assert::str_contains(diags[1], "dead_leaf")
}

#test
/**
 * to_diagnostic_parses_file_line_col_with_caller_known_severity — the crumb D happy path: a
 * `file:line:col: msg` line, given its own file as the single candidate, resolves to a `Diagnostic`
 * whose `file`/`line`/`col`/`message` are pulled straight out of the string and whose `severity` is
 * EXACTLY the caller's `severity` argument, never re-derived from `message`'s own text.
 */
fn to_diagnostic_parses_file_line_col_with_caller_known_severity() {
    let files = teko::list::push(teko::list::empty(), "foo.tks")
    let d = to_diagnostic("foo.tks:3:5: unknown type: Bogus", files, DiagLevel::Error)
    teko::assert::eq_str(d.file, "foo.tks")
    teko::assert::eq_u64(d.line to u64, 3)
    teko::assert::eq_u64(d.col to u64, 5)
    teko::assert::eq_u64(d.end_line to u64, 3)
    teko::assert::eq_u64(d.end_col to u64, 6)
    teko::assert::eq_str(d.message, "unknown type: Bogus")
    teko::assert::is_true(d.severity == DiagLevel::Error)
}

#test
/**
 * to_diagnostic_handles_a_positionless_finding_for_a_known_file — `diag_at`'s OTHER positioned shape
 * (`file: msg`, no `line:col`, `diag_at`'s own `if line > 0` branch never taken) resolves the known
 * `file` with `line`/`col` both 0, never dropping the finding.
 */
fn to_diagnostic_handles_a_positionless_finding_for_a_known_file() {
    let files = teko::list::push(teko::list::empty(), "foo.tks")
    let d = to_diagnostic("foo.tks: whole-file note", files, DiagLevel::Warning)
    teko::assert::eq_str(d.file, "foo.tks")
    teko::assert::eq_u64(d.line to u64, 0)
    teko::assert::eq_u64(d.col to u64, 0)
    teko::assert::eq_str(d.message, "whole-file note")
    teko::assert::is_true(d.severity == DiagLevel::Warning)
}

#test
/**
 * to_diagnostic_falls_back_to_the_whole_line_for_an_unknown_file — a line naming none of the closed
 * candidate `files` (or an empty candidate set) never gets silently dropped: the WHOLE line becomes
 * the message at an unknown (`file = ""`, `line = 0`) position, `severity` still the caller's own.
 */
fn to_diagnostic_falls_back_to_the_whole_line_for_an_unknown_file() {
    let d = to_diagnostic("some standalone diagnostic", teko::list::empty(), DiagLevel::Error)
    teko::assert::eq_str(d.file, "")
    teko::assert::eq_u64(d.line to u64, 0)
    teko::assert::eq_str(d.message, "some standalone diagnostic")
    teko::assert::is_true(d.severity == DiagLevel::Error)
}

#test
/**
 * program_files_collects_distinct_non_empty_files_in_first_seen_order — the closed candidate set
 * `to_diagnostic` matches against: every DISTINCT non-empty `item.file`, first occurrence wins,
 * duplicates dropped, an empty (single-file compile path) `file` never included.
 */
fn program_files_collects_distinct_non_empty_files_in_first_seen_order() {
    mut items: []parser::Item = teko::list::empty()
    items = teko::list::push(items, parser::Item { content = mk_fn("a", named_t("i64"), teko::list::empty()); namespace = ""; file = "a.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("b", named_t("i64"), teko::list::empty()); namespace = ""; file = "b.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("c", named_t("i64"), teko::list::empty()); namespace = ""; file = "a.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("d", named_t("i64"), teko::list::empty()); namespace = ""; file = "" })
    let files = program_files(parser::Program { items = items })
    teko::assert::eq_u64(files.len, 2)
    teko::assert::eq_str(files[0], "a.tks")
    teko::assert::eq_str(files[1], "b.tks")
}

#test
/**
 * collect_diagnostics_structured_stamps_real_severity_and_range — the crumb D end-to-end regression,
 * driving the REAL lex → parse → `collect_diagnostics_structured` seam (mirroring
 * `collect_diagnostics_appends_a_collected_warning_after_an_error`'s own harness): a program with ONE
 * type error and ONE unused private function yields TWO `Diagnostic` values — the error stamped
 * `DiagLevel::Error`, the warning stamped `DiagLevel::Warning` — proving severity is REAL, not a
 * `"warning:"` text sniff, all the way from the checker's own pre-mono walk.
 */
fn collect_diagnostics_structured_stamps_real_severity_and_range() {
    let src = "pub fn bad(x: Bogus) -> i64 { return 0 }\nfn dead_leaf() -> i64 { return 1 }\n"
    let diags = collect_diagnostics_structured(prog_from_module_src(src, "warn.tks"))
    teko::assert::eq_u64(diags.len, 2)
    teko::assert::eq_str(diags[0].file, "warn.tks")
    teko::assert::is_true(diags[0].severity == DiagLevel::Error)
    teko::assert::str_contains(diags[0].message, "Bogus")
    teko::assert::eq_str(diags[1].file, "warn.tks")
    teko::assert::is_true(diags[1].severity == DiagLevel::Warning)
    teko::assert::str_contains(diags[1].message, "unused private function")
    teko::assert::str_contains(diags[1].message, "dead_leaf")
}
