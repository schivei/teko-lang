
/**
 * The LIVENESS brace on the census: the report is only trustworthy when the two arms that pin the
 * scale — the climb-floor `PtFrame` and the escape `PtRoot` — were both actually observed. A
 * counter broken to zero would otherwise be read as a fact about the axis.
 *
 * @param c  the accumulated census
 * @return   true iff both `frame` and `root` are non-zero
 */
pub fn pt_census_live(c: PtCensus) -> bool {
    if c.frame == 0 { return false }
    c.root > 0
}

/**
 * The word for one arm's liveness — whether the axis was ever seen producing it.
 *
 * @param n  the arm's cell count
 * @return   `"LIVE"` when the arm was observed, else `"DEAD"`
 */
fn pt_census_arm_state(n: u64) -> str {
    if n > 0 { return "LIVE" }
    "DEAD"
}

/**
 * The census verdict word — whether the liveness brace holds.
 *
 * @param c  the accumulated census
 * @return   `"LIVE"` when both braced arms were observed, else `"NOT LIVE"`
 */
fn pt_census_verdict(c: PtCensus) -> str {
    if pt_census_live(c) { return "LIVE" }
    "NOT LIVE"
}

/**
 * The LIVENESS line, printed BEFORE the values so no reader ever meets a zero without first being
 * told whether the arm that produced it was observed at all.
 *
 * A `DEAD` arm here is a statement about the AXIS, not about the counter: the counter is exercised
 * on all five arms from a hand-built `Spine` in `src/checker/pt_census_test.tkt`.
 *
 * @param c  the accumulated census
 * @return   the formatted liveness line (no trailing newline)
 */
pub fn pt_census_liveness_line(c: PtCensus) -> str {
    let frame_state = pt_census_arm_state(c.frame)
    let root_state = pt_census_arm_state(c.root)
    $"teko: pt-census-liveness: {pt_census_verdict(c)} — PtFrame {frame_state} ({c.frame}), PtRoot {root_state} ({c.root}); a DEAD arm is the axis never producing it (the counter itself is proven on all five arms by pt_census_test.tkt)"
}

/**
 * The one-line points-to census report: the distribution over the five arms, each arm's share of
 * the total, the `PtAdopter(⊤)` budget-fallback subset, and the per-function shape (mean beside the
 * fattest single function).
 *
 * `PtFrame`'s share is the number this exists to produce: it is the CEILING on what any
 * scope-directed reclamation could ever recover, because a cell the spine already calls
 * frame-local is the only kind of candidate such a pass has.
 *
 * @param c  the accumulated census
 * @return   the formatted report line (no trailing newline)
 */
pub fn pt_census_line(c: PtCensus) -> str {
    let per_fn = pt_census_cells_per_fn(c)
    let frame_pct = pt_census_pct(c.frame, c.cells)
    let root_pct = pt_census_pct(c.root, c.cells)
    let param_pct = pt_census_pct(c.param, c.cells)
    let adopter_pct = pt_census_pct(c.adopter, c.cells)
    let top_pct = pt_census_pct(c.top, c.cells)
    let shape = $"{c.fns} fns, {c.cells} cells ({per_fn:F2}/fn, fattest {c.max_cells})"
    let dist = $"PtFrame {c.frame} ({frame_pct:F2}%), PtRoot {c.root} ({root_pct:F2}%), PtParam {c.param} ({param_pct:F2}%), PtAdopter {c.adopter} ({adopter_pct:F2}%, {c.adopter_top} at top), PtTop {c.top} ({top_pct:F2}%)"
    $"teko: pt-census: {shape}, {dist}, unit = {PT_CENSUS_UNIT}"
}
