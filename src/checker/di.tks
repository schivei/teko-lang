use teko::parser

/** (§7 DI) svc_type_id — the deterministic 64-bit type identity of a service's C-safe canonical
 *  symbol, the tag a lifetime-bound arena slot is keyed by (`tk_region_register`/`tk_region_lookup`,
 *  Doc 1 §8). Callers pass the impl's C-safe canonical symbol (`mangle_ns_frag` of its canonical
 *  name), so two same-bare services in different namespaces get DISTINCT ids (issue #284). FNV-1a
 *  over the name's bytes (offset basis 14695981039346656037, prime 1099511628211, u64 wraparound).
 *  One derivation, so a `singleton`/`scoped` service's arena slot agrees across engines. Preserved
 *  through the annotation-DI retirement (§7 part 2) as the identity the Doc 1 §8 backend seam binds. */
pub fn svc_type_id(name: str): u64 {
    var hash: u64 = 14695981039346656037
    var i: u64 = 0
    loop {
        if i >= name.len { break }
        hash = hash ^ (name[i] to u64)
        hash = hash * 1099511628211
        i++
    }
    hash
}
