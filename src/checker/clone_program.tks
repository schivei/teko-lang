/**
 * clone_parser_constdecl — deep-copy a syntactic module/type-member constant declaration.
 *
 * @param c  the source const declaration
 * @return   a fresh const declaration
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_parser_constdecl(c: parser::ConstDecl) -> parser::ConstDecl {
    parser::ConstDecl { name = clone_str(c.name); ty = clone_typeexpr(c.ty); init = clone_expr(c.init); vis = c.vis; has_doc = c.has_doc; doc = clone_str(c.doc); line = c.line; col = c.col }
}

/**
 * clone_parser_constdecl_list — rebuild a `[]parser::ConstDecl`.
 *
 * @param xs  the source const-declaration slice
 * @return    a fresh const-declaration slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_parser_constdecl_list(xs: []parser::ConstDecl) -> []parser::ConstDecl {
    mut out: []parser::ConstDecl = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_parser_constdecl(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_function — deep-copy a syntactic `parser::Function` (carried through a passed-through
 * `TypeDecl`'s method list). Rebuilds every slice field and every string.
 *
 * @param f  the source function declaration
 * @return   a fresh function declaration holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_function(f: parser::Function) -> parser::Function {
    parser::Function {
        name = clone_str(f.name)
        type_params = clone_str_list(f.type_params)
        type_constraints = clone_constraintexpr_list(f.type_constraints)
        params = clone_param_list(f.params)
        has_return = f.has_return
        return_type = clone_typeexpr(f.return_type)
        body = clone_stmt_list(f.body)
        vis = f.vis
        has_doc = f.has_doc
        doc = clone_str(f.doc)
        line = f.line
        col = f.col
        is_test = f.is_test
        is_extern = f.is_extern
        c_symbol = clone_str(f.c_symbol)
        from_lib = clone_str(f.from_lib)
        os_guard = clone_str(f.os_guard)
        is_intern = f.is_intern
        is_abstract = f.is_abstract
        is_virtual = f.is_virtual
        is_override = f.is_override
        has_inject = f.has_inject
        injects = clone_injectbinding_list(f.injects)
        is_unsafe = f.is_unsafe
        has_arena_size = f.has_arena_size
        arena_size = f.arena_size
    }
}

/**
 * clone_function_list — rebuild a `[]parser::Function` (a type body's method list).
 *
 * @param xs  the source function slice
 * @return    a fresh function slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_function_list(xs: []parser::Function) -> []parser::Function {
    mut out: []parser::Function = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_function(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_typebody — deep-copy a `parser::TypeBody` (struct/enum/flags/variant/alias/extern/class/
 * interface/trait). Struct/class/trait bodies carry full method `Function`s, cloned in turn.
 *
 * @param b  the source type body
 * @return   a fresh type body
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_typebody(b: parser::TypeBody) -> parser::TypeBody {
    match b {
        parser::StructBody as s => parser::StructBody { fields = clone_field_list(s.fields); methods = clone_function_list(s.methods); implements = clone_str_list(s.implements); consts = clone_parser_constdecl_list(s.consts) }
        parser::EnumBody as e => parser::EnumBody { members = clone_str_list(e.members) }
        parser::FlagsBody as f => parser::FlagsBody { members = clone_str_list(f.members); values = clone_u64_list(f.values) }
        parser::VariantBody as v => parser::VariantBody { type_expr = clone_typeexpr(v.type_expr) }
        parser::AliasBody as a => parser::AliasBody { alias = clone_typeexpr(a.alias) }
        parser::ExternBody => parser::ExternBody { }
        parser::ClassBody as c => parser::ClassBody { kind = c.kind; has_base = c.has_base; base_name = clone_str(c.base_name); has_base_binding = c.has_base_binding; base_binding_name = clone_str(c.base_binding_name); implements = clone_str_list(c.implements); fields = clone_field_list(c.fields); methods = clone_function_list(c.methods); consts = clone_parser_constdecl_list(c.consts) }
        parser::InterfaceBody as i => parser::InterfaceBody { extends = clone_str_list(i.extends); methods = clone_function_list(i.methods) }
        parser::TraitBody as t => parser::TraitBody { fields = clone_field_list(t.fields); methods = clone_function_list(t.methods); consts = clone_parser_constdecl_list(t.consts) }
    }
}

/**
 * clone_typedecl — deep-copy a `parser::TypeDecl` passed through as a `TItem`.
 *
 * @param d  the source type declaration
 * @return   a fresh type declaration holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_typedecl(d: parser::TypeDecl) -> parser::TypeDecl {
    parser::TypeDecl {
        name = clone_str(d.name)
        type_params = clone_str_list(d.type_params)
        type_constraints = clone_constraintexpr_list(d.type_constraints)
        body = clone_typebody(d.body)
        vis = d.vis
        has_doc = d.has_doc
        doc = clone_str(d.doc)
        line = d.line
        col = d.col
        di_kind = d.di_kind
        has_di_key = d.has_di_key
        di_key = clone_str(d.di_key)
        is_unsafe = d.is_unsafe
        must_free = d.must_free
    }
}

/**
 * clone_usedecl — deep-copy a `parser::UseDecl` passed through as a `TItem`.
 *
 * @param u  the source use declaration
 * @return   a fresh use declaration
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_usedecl(u: parser::UseDecl) -> parser::UseDecl {
    parser::UseDecl { path = clone_path(u.path); has_alias = u.has_alias; alias = clone_str(u.alias); names = clone_str_list(u.names) }
}

/**
 * clone_type — deep-copy a semantic `Type` (all 14 cases). `Ptr.inner` is the one `Type | null`
 * field and is cloned through by value (null stays null).
 *
 * @param t  the source type
 * @return   a fresh type holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_type(t: Type) -> Type {
    match t {
        Prim as p => Prim { kind = p.kind }
        Byte => Byte { }
        Char => Char { }
        Str => Str { }
        Slice as s => Slice { element = clone_type(s.element) }
        Named as n => Named { name = clone_str(n.name) }
        Variant as v => Variant { members = clone_type_list(v.members) }
        Func as f => Func { params = clone_type_list(f.params); ret = clone_type(f.ret); variadic = f.variadic; param_names = clone_str_list(f.param_names); n_required = f.n_required; defaults = clone_expr_list(f.defaults) }
        Error => Error { }
        Void => Void { }
        Ptr as p => Ptr { inner = match p.inner { Type as ti => clone_type(ti); null => null } }
        Uptr => Uptr { }
        Reference as r => Reference { inner = clone_type(r.inner) }
        Null => Null { }
    }
}

/**
 * clone_type_list — deep-copy a `[]Type`.
 *
 * @param xs  the source type slice
 * @return    a fresh type slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_type_list(xs: []Type) -> []Type {
    mut out: []Type = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_type(xs[i]))
        i = i + 1
    }
    out
}

