/**
 * clone_texprkind — deep-copy a typed expression node (all 23 `TExprKind` cases). Private-name
 * access to `TExprKind` is why this module lives in the checker namespace.
 *
 * @param k  the source typed expression kind
 * @return   a fresh typed expression kind holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_texprkind(k: TExprKind) -> TExprKind {
    match k {
        TNumber as n => TNumber { is_float = n.is_float; value = clone_numint(n.value); fval = n.fval }
        TVar as v => TVar { name = clone_str(v.name); is_func = v.is_func; func_ns = clone_str(v.func_ns) }
        TStrLit as s => TStrLit { text = clone_str(s.text) }
        TByteLit as b => TByteLit { value = b.value }
        TCharLit as c => TCharLit { bytes = clone_str(c.bytes) }
        TBoolLit as b => TBoolLit { value = b.value }
        TNullLit => TNullLit { }
        TBinary as b => TBinary { op = b.op; left = clone_texpr(b.left); right = clone_texpr(b.right) }
        TUnary as u => TUnary { op = u.op; operand = clone_texpr(u.operand) }
        TCompare as c => TCompare { first = clone_texpr(c.first); rest = clone_tcmpterm_list(c.rest) }
        TCall as c => TCall { callee = clone_path(c.callee); args = clone_texpr_list(c.args); call_ns = clone_str(c.call_ns); is_closure_call = c.is_closure_call; callee_type = clone_type(c.callee_type); is_iface_dispatch = c.is_iface_dispatch; iface_slot = c.iface_slot }
        TIfExpr as f => TIfExpr { cond = clone_texpr(f.cond); then_blk = clone_tstmt_list(f.then_blk); has_else = f.has_else; else_blk = clone_tstmt_list(f.else_blk) }
        TMatchExpr as m => TMatchExpr { subject = clone_texpr(m.subject); arms = clone_tarm_list(m.arms) }
        TCast as c => TCast { expr = clone_texpr(c.expr) }
        TFieldAccess as f => TFieldAccess { receiver = clone_texpr(f.receiver); field = clone_str(f.field) }
        TStructInit as s => TStructInit { field_names = clone_str_list(s.field_names); field_vals = clone_texpr_list(s.field_vals) }
        TIndex as i => TIndex { receiver = clone_texpr(i.receiver); index = clone_texpr(i.index) }
        TInterp as n => TInterp { pieces = clone_str_list(n.pieces); holes = clone_texpr_list(n.holes); specs = clone_tfspec_list(n.specs) }
        TInExpr as n => TInExpr { lhs = clone_texpr(n.lhs); elems = clone_texpr_list(n.elems) }
        TPathExpr as p => TPathExpr { enum_name = clone_str(p.enum_name); member = clone_str(p.member); ordinal = p.ordinal; value = p.value }
        TArrayLit as a => TArrayLit { elements = clone_tarrayelem_list(a.elements) }
        TLambda as l => TLambda { params = clone_tlambdaparam_list(l.params); body = clone_tstmt_list(l.body); captures = clone_tcapture_list(l.captures); ret = clone_type(l.ret); lift_id = l.lift_id }
        TBorrow as b => TBorrow { operand = clone_texpr(b.operand) }
    }
}

/**
 * clone_texpr — deep-copy a typed `TExpr` (its kind, resolved type, and source position).
 *
 * @param e  the source typed expression
 * @return   a fresh typed expression
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_texpr(e: TExpr) -> TExpr {
    TExpr { kind = clone_texprkind(e.kind); type = clone_type(e.type); line = e.line; col = e.col }
}

/**
 * clone_tstatement — deep-copy a typed `TStatement` (all nine cases).
 *
 * @param s  the source typed statement
 * @return   a fresh typed statement holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tstatement(s: TStatement) -> TStatement {
    match s {
        TBinding as b => TBinding { kind = b.kind; target = clone_bindtarget(b.target); bound = clone_type(b.bound); value = clone_texpr(b.value); di_kind = b.di_kind }
        TAssign as a => TAssign { kind = a.kind; name = clone_str(a.name); op = a.op; bound = clone_type(a.bound); value = clone_texpr(a.value); deref = a.deref; target = clone_texpr(a.target) }
        TReturn as r => TReturn { has_value = r.has_value; value = clone_texpr(r.value) }
        TLoopStmt as l => TLoopStmt { label = clone_str(l.label); init = clone_tstmt_list(l.init); body = clone_tstmt_list(l.body) }
        TBreakStmt as b => TBreakStmt { label = clone_str(b.label) }
        TContinueStmt as c => TContinueStmt { label = clone_str(c.label) }
        TExprStmt as e => TExprStmt { expr = clone_texpr(e.expr) }
        TDeferStmt as d => TDeferStmt { body = clone_tstmt_list(d.body) }
        TAdoptStmt as a => TAdoptStmt { name = clone_str(a.name); body = clone_tstmt_list(a.body) }
    }
}

/**
 * clone_tstmt_list — deep-copy a typed statement block.
 *
 * @param xs  the source typed statements
 * @return    a fresh typed statement slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tstmt_list(xs: []TStatement) -> []TStatement {
    mut out: []TStatement = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_tstatement(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_tfunction — deep-copy a typed `TFunction` (its typed body, params, constraints, strings).
 *
 * @param f  the source typed function
 * @return   a fresh typed function holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tfunction(f: TFunction) -> TFunction {
    TFunction {
        name = clone_str(f.name)
        type_params = clone_str_list(f.type_params)
        type_constraints = clone_constraintexpr_list(f.type_constraints)
        params = clone_param_list(f.params)
        return_type = clone_type(f.return_type)
        body = clone_tstmt_list(f.body)
        vis = f.vis
        has_doc = f.has_doc
        doc = clone_str(f.doc)
        namespace = clone_str(f.namespace)
        file = clone_str(f.file)
        line = f.line
        col = f.col
        is_test = f.is_test
        is_extern = f.is_extern
        c_symbol = clone_str(f.c_symbol)
        from_lib = clone_str(f.from_lib)
        has_arena_size = f.has_arena_size
        arena_size = f.arena_size
    }
}

/**
 * clone_tconstdecl — deep-copy a typed module-level constant declaration.
 *
 * @param c  the source typed const declaration
 * @return   a fresh typed const declaration
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tconstdecl(c: TConstDecl) -> TConstDecl {
    TConstDecl { name = clone_str(c.name); namespace = clone_str(c.namespace); ty = clone_type(c.ty); init = clone_texpr(c.init); vis = c.vis; has_doc = c.has_doc; doc = clone_str(c.doc); line = c.line; col = c.col }
}

/**
 * clone_titem — deep-copy one typed top-level item (the five `TItem` cases: a typed function, a
 * passed-through TypeDecl/UseDecl, a typed loose statement, or a typed const).
 *
 * @param it  the source item
 * @return    a fresh item holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_titem(it: TItem) -> TItem {
    match it {
        TFunction as f => clone_tfunction(f)
        parser::TypeDecl as d => clone_typedecl(d)
        parser::UseDecl as u => clone_usedecl(u)
        TStatement as s => clone_tstatement(s)
        TConstDecl as c => clone_tconstdecl(c)
    }
}

/**
 * clone_titem_list — rebuild a `[]TItem`, the program's top-level surface.
 *
 * @param xs  the source item slice
 * @return    a fresh item slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_titem_list(xs: []TItem) -> []TItem {
    mut out: []TItem = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_titem(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_tprogram_into_current_region — a TOTAL deep clone of a checked `TProgram` into the CURRENT
 * region: the arena-por-escopo M1a safety boundary. Every item, and transitively every nested
 * aggregate, slice and string, is rebuilt (never shared by fat-pointer), so the returned program
 * holds NO pointer into the region its argument was allocated in. That is the sufficient condition
 * (design §2) for M1b to drop the frontend region before codegen without reopening the N112
 * by-address use-after-free. Byte-identity of the fixpoint over the clone is the proof it is total.
 *
 * @param prog  the checked program to clone (typically the `inline_consts` output)
 * @return      a structurally identical, value-exact program owning all its own storage
 * @since 0.3.1 arena-por-escopo M1a
 */
pub fn clone_tprogram_into_current_region(prog: TProgram) -> TProgram {
    TProgram { items = clone_titem_list(prog.items) }
}
