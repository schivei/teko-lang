 * @param t  the source term
 * @return   a fresh term
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tcmpterm(t: TCmpTerm) -> TCmpTerm {
    TCmpTerm { op = t.op; operand = clone_texpr(t.operand) }
}

/**
 * clone_tcmpterm_list — rebuild a `[]TCmpTerm`.
 *
 * @param xs  the source term slice
 * @return    a fresh term slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tcmpterm_list(xs: []TCmpTerm) -> []TCmpTerm {
    mut out: []TCmpTerm = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_tcmpterm(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_tfspeckind — deep-copy the three typed format-spec cases.
 *
 * @param k  the source format-spec kind
 * @return   a fresh format-spec kind
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_tfspeckind(k: TFSpecKind) -> TFSpecKind {
    match k {
        TFSpecNone => TFSpecNone { }
        TFSpecStatic as s => TFSpecStatic { s = clone_str(s.s) }
        TFSpecDynamic as d => TFSpecDynamic { args = clone_texpr_list(d.args) }
    }
}

/**
