/**
 * clone_expr_list — rebuild a `[]parser::Expr`.
 *
 * @param xs  the source expression slice
 * @return    a fresh expression slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_expr_list(xs: []parser::Expr) -> []parser::Expr {
    mut out: []parser::Expr = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_expr(xs[i]))
