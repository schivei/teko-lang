/**
 * clone_exprkind — deep-copy a syntactic expression node (all 24 `parser::ExprKind` cases).
 *
 * @param k  the source expression kind
 * @return   a fresh expression kind holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_exprkind(k: parser::ExprKind) -> parser::ExprKind {
    match k {
        parser::Number as n => parser::Number { is_float = n.is_float; value = clone_numint(n.value); fval = n.fval }
        parser::Var as v => parser::Var { name = clone_str(v.name) }
        parser::Call as c => parser::Call { callee = clone_path(c.callee); args = clone_expr_list(c.args); arg_names = clone_str_list(c.arg_names); type_args = clone_typeexpr_list(c.type_args) }
        parser::IfExpr as f => parser::IfExpr { cond = clone_expr(f.cond); then_blk = clone_stmt_list(f.then_blk); has_else = f.has_else; else_blk = clone_stmt_list(f.else_blk) }
        parser::MatchExpr as m => parser::MatchExpr { subject = clone_expr(m.subject); arms = clone_arm_list(m.arms) }
        parser::StrLit as s => parser::StrLit { text = clone_str(s.text) }
        parser::ByteLit as b => parser::ByteLit { value = b.value }
        parser::CharLit as c => parser::CharLit { bytes = clone_str(c.bytes) }
        parser::BoolLit as b => parser::BoolLit { value = b.value }
        parser::NullLit => parser::NullLit { }
        parser::Binary as b => parser::Binary { op = b.op; left = clone_expr(b.left); right = clone_expr(b.right) }
        parser::Unary as u => parser::Unary { op = u.op; operand = clone_expr(u.operand) }
        parser::Compare as c => parser::Compare { first = clone_expr(c.first); rest = clone_cmpterm_list(c.rest) }
        parser::FieldAccess as f => parser::FieldAccess { receiver = clone_expr(f.receiver); field = clone_str(f.field) }
        parser::MethodCall as m => parser::MethodCall { receiver = clone_expr(m.receiver); method = clone_str(m.method); args = clone_expr_list(m.args) }
        parser::Cast as c => parser::Cast { expr = clone_expr(c.expr); target = clone_typeexpr(c.target) }
        parser::PathExpr as p => parser::PathExpr { path = clone_path(p.path) }
        parser::StructLit as s => parser::StructLit { type_path = clone_path(s.type_path); type_args = clone_typeexpr_list(s.type_args); field_names = clone_str_list(s.field_names); field_vals = clone_expr_list(s.field_vals) }
        parser::Index as i => parser::Index { receiver = clone_expr(i.receiver); index = clone_expr(i.index) }
        parser::Interp as n => parser::Interp { pieces = clone_str_list(n.pieces); holes = clone_expr_list(n.holes); specs = clone_fspec_list(n.specs) }
        parser::InExpr as n => parser::InExpr { lhs = clone_expr(n.lhs); elems = clone_expr_list(n.elems) }
        parser::ArrayLit as a => parser::ArrayLit { elements = clone_arrayelem_list(a.elements) }
        parser::Lambda as l => parser::Lambda { params = clone_lambdaparam_list(l.params); body = clone_stmt_list(l.body) }
        parser::Borrow as b => parser::Borrow { operand = clone_expr(b.operand) }
    }
}

/**
 * clone_expr — deep-copy a syntactic `parser::Expr` (its kind plus source position).
 *
 * @param e  the source expression
 * @return   a fresh expression
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_expr(e: parser::Expr) -> parser::Expr {
    parser::Expr { kind = clone_exprkind(e.kind); line = e.line; col = e.col }
}

/**
 * clone_bindtarget — deep-copy a binding target (a simple name or a destructure pattern).
 *
 * @param t  the source bind target
 * @return   a fresh bind target
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_bindtarget(t: parser::BindTarget) -> parser::BindTarget {
    match t {
        parser::SimpleName as s => parser::SimpleName { name = clone_str(s.name) }
        parser::DestructurePattern as d => parser::DestructurePattern { names = clone_str_list(d.names) }
    }
}

/**
 * clone_pattern — deep-copy a `match`-arm pattern (all seven `parser::Pattern` cases).
 *
 * @param p  the source pattern
 * @return   a fresh pattern holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_pattern(p: parser::Pattern) -> parser::Pattern {
    match p {
        parser::LiteralPattern as l => parser::LiteralPattern { value = clone_expr(l.value) }
        parser::RangePattern as r => parser::RangePattern { lo = clone_expr(r.lo); hi = clone_expr(r.hi) }
        parser::AltPattern as a => parser::AltPattern { options = clone_pattern_list(a.options) }
        parser::BindPattern as b => parser::BindPattern { type_name = clone_path(b.type_name); has_binding = b.has_binding; binding = clone_str(b.binding); is_slice = b.is_slice; slice_type = match b.slice_type { parser::TypeExpr as st => clone_typeexpr(st); null => null }; type_args = clone_typeexpr_list(b.type_args) }
        parser::FieldPattern as f => parser::FieldPattern { type_name = clone_path(f.type_name); fields = clone_str_list(f.fields) }
        parser::WildcardPattern => parser::WildcardPattern { }
        parser::NullPattern => parser::NullPattern { }
    }
}

/**
 * clone_pattern_list — rebuild a `[]parser::Pattern`.
 *
 * @param xs  the source pattern slice
 * @return    a fresh pattern slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_pattern_list(xs: []parser::Pattern) -> []parser::Pattern {
    mut out: []parser::Pattern = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_pattern(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_arm — deep-copy one syntactic `match` arm (pattern, guard, body).
 *
 * @param a  the source arm
 * @return   a fresh arm
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_arm(a: parser::Arm) -> parser::Arm {
    parser::Arm { pattern = clone_pattern(a.pattern); has_when = a.has_when; guard = clone_expr(a.guard); body = clone_stmt_list(a.body) }
}

/**
 * clone_arm_list — rebuild a `[]parser::Arm`.
 *
 * @param xs  the source arm slice
 * @return    a fresh arm slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_arm_list(xs: []parser::Arm) -> []parser::Arm {
    mut out: []parser::Arm = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_arm(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_statement — deep-copy a syntactic `parser::Statement` (all nine cases).
 *
 * @param s  the source statement
 * @return   a fresh statement holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_statement(s: parser::Statement) -> parser::Statement {
    match s {
        parser::Binding as b => parser::Binding { kind = b.kind; target = clone_bindtarget(b.target); has_type = b.has_type; type_ann = clone_typeexpr(b.type_ann); is_ref = b.is_ref; value = clone_expr(b.value); di_kind = b.di_kind }
        parser::Assign as a => parser::Assign { kind = a.kind; name = clone_str(a.name); op = a.op; value = clone_expr(a.value); deref = a.deref; target = clone_expr(a.target) }
        parser::Return as r => parser::Return { has_value = r.has_value; value = clone_expr(r.value) }
        parser::LoopStmt as l => parser::LoopStmt { label = clone_str(l.label); init = clone_stmt_list(l.init); body = clone_stmt_list(l.body) }
        parser::BreakStmt as b => parser::BreakStmt { label = clone_str(b.label) }
        parser::ContinueStmt as c => parser::ContinueStmt { label = clone_str(c.label) }
        parser::ExprStmt as e => parser::ExprStmt { expr = clone_expr(e.expr) }
        parser::DeferStmt as d => parser::DeferStmt { body = clone_stmt_list(d.body) }
        parser::AdoptStmt as a => parser::AdoptStmt { name = clone_str(a.name); body = clone_stmt_list(a.body) }
    }
}

/**
 * clone_stmt_list — deep-copy a syntactic statement block.
 *
 * @param xs  the source statements
 * @return    a fresh statement slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_stmt_list(xs: []parser::Statement) -> []parser::Statement {
    mut out: []parser::Statement = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_statement(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_constraintexpr — deep-copy a generic type-parameter constraint (atom / and / or / none).
 *
 * @param c  the source constraint
 * @return   a fresh constraint
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_constraintexpr(c: parser::ConstraintExpr) -> parser::ConstraintExpr {
    match c {
        parser::ConstraintAtom as a => parser::ConstraintAtom { name = clone_str(a.name) }
        parser::ConstraintAnd as n => parser::ConstraintAnd { left = clone_constraintexpr(n.left); right = clone_constraintexpr(n.right) }
        parser::ConstraintOr as o => parser::ConstraintOr { left = clone_constraintexpr(o.left); right = clone_constraintexpr(o.right) }
        parser::NoConstraint => parser::NoConstraint { }
    }
}

/**
 * clone_constraintexpr_list — rebuild a `[]parser::ConstraintExpr`.
 *
 * @param xs  the source constraint slice
 * @return    a fresh constraint slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_constraintexpr_list(xs: []parser::ConstraintExpr) -> []parser::ConstraintExpr {
    mut out: []parser::ConstraintExpr = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_constraintexpr(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_param — deep-copy one immutable function parameter, including its default expression.
 *
 * @param p  the source parameter
 * @return   a fresh parameter
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_param(p: parser::Param) -> parser::Param {
    parser::Param { name = clone_str(p.name); has_type = p.has_type; type_ann = clone_typeexpr(p.type_ann); is_params = p.is_params; has_default = p.has_default; default_expr = clone_expr(p.default_expr) }
}

/**
 * clone_param_list — rebuild a `[]parser::Param`.
