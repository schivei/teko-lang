use teko::parser
use teko::lexer

/**
 * clone_str — a fresh copy of `s`'s bytes in a newly allocated buffer, so the clone shares no
 * string storage with the frontend region. `teko::str::concat(s, "")` always mallocs a new buffer
 * (the runtime `tk_str_concat` never short-circuits on an empty operand), giving a malloc-backed
 * copy that no region drop can reach — identical bytes, so codegen (structural, never by-address)
 * emits identically.
 *
 * @param s  the source string
 * @return   a fresh copy of `s` owning its own buffer
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_str(s: str) -> str {
    teko::str::concat(s, "")
}

/**
 * clone_str_list — rebuild a `[]str`, deep-copying every element string (see `clone_str`).
 *
 * @param xs  the source string slice
 * @return    a fresh slice of fresh string copies
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_str_list(xs: []str) -> []str {
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_str(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_u64_list — rebuild a `[]u64` into the current region. The elements are scalars (copied by
 * value), but the backing array itself is region-allocated in the source, so it must be rebuilt.
 *
 * @param xs  the source u64 slice
 * @return    a fresh slice with the same values
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_u64_list(xs: []u64) -> []u64 {
    mut out: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i])
        i = i + 1
    }
    out
}

/**
 * clone_numint — copy a `parser::NumInt` literal (sign + magnitude, both scalars) by value.
 *
 * @param x  the source numeric-literal value
 * @return   an identical `parser::NumInt`
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_numint(x: parser::NumInt) -> parser::NumInt {
    parser::NumInt { neg = x.neg; mag = x.mag }
}

/**
 * clone_segment — copy one path segment, deep-copying its name.
 *
 * @param s  the source segment
 * @return   a fresh segment
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_segment(s: parser::Segment) -> parser::Segment {
    parser::Segment { name = clone_str(s.name) }
}

/**
 * clone_segment_list — rebuild a `[]parser::Segment`.
 *
 * @param xs  the source segment slice
 * @return    a fresh segment slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_segment_list(xs: []parser::Segment) -> []parser::Segment {
    mut out: []parser::Segment = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_segment(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_path — copy a `parser::Path`, rebuilding its segment slice.
 *
 * @param p  the source path
 * @return   a fresh path
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_path(p: parser::Path) -> parser::Path {
    parser::Path { segments = clone_segment_list(p.segments) }
}

/**
 * clone_typeexpr — deep-copy a syntactic `parser::TypeExpr` (recursive over its four cases).
 *
 * @param t  the source type expression
 * @return   a fresh type expression holding no pointer into the source region
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_typeexpr(t: parser::TypeExpr) -> parser::TypeExpr {
    match t {
        parser::NamedType as n => parser::NamedType { path = clone_path(n.path); args = clone_typeexpr_list(n.args) }
        parser::SliceType as s => parser::SliceType { element = clone_typeexpr(s.element) }
        parser::UnionType as u => parser::UnionType { members = clone_typeexpr_list(u.members) }
        parser::FunctionType as f => parser::FunctionType { params = clone_typeexpr_list(f.params); ret = clone_typeexpr(f.ret) }
    }
}

/**
 * clone_typeexpr_list — rebuild a `[]parser::TypeExpr`.
 *
 * @param xs  the source type-expression slice
 * @return    a fresh type-expression slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_typeexpr_list(xs: []parser::TypeExpr) -> []parser::TypeExpr {
    mut out: []parser::TypeExpr = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_typeexpr(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_cmpterm — deep-copy one continuation term of a syntactic comparison chain.
 *
 * @param t  the source term
 * @return   a fresh term
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_cmpterm(t: parser::CmpTerm) -> parser::CmpTerm {
    parser::CmpTerm { op = t.op; operand = clone_expr(t.operand) }
}

/**
 * clone_cmpterm_list — rebuild a `[]parser::CmpTerm`.
 *
 * @param xs  the source term slice
 * @return    a fresh term slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_cmpterm_list(xs: []parser::CmpTerm) -> []parser::CmpTerm {
    mut out: []parser::CmpTerm = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_cmpterm(xs[i]))
        i = i + 1
    }
    out
}

/**
 * clone_fspeckind — deep-copy the three format-spec cases (none / static text / dynamic args).
 *
 * @param k  the source format-spec kind
 * @return   a fresh format-spec kind
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_fspeckind(k: parser::FSpecKind) -> parser::FSpecKind {
    match k {
        parser::FSpecNone => parser::FSpecNone { }
        parser::FSpecStatic as s => parser::FSpecStatic { s = clone_str(s.s) }
        parser::FSpecDynamic as d => parser::FSpecDynamic { args = clone_expr_list(d.args) }
    }
}

/**
 * clone_fspec — deep-copy a syntactic interpolation format spec.
 *
 * @param f  the source format spec
 * @return   a fresh format spec
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_fspec(f: parser::FSpec) -> parser::FSpec {
    parser::FSpec { kind = clone_fspeckind(f.kind) }
}

/**
 * clone_fspec_list — rebuild a `[]parser::FSpec`.
 *
 * @param xs  the source format-spec slice
 * @return    a fresh format-spec slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_fspec_list(xs: []parser::FSpec) -> []parser::FSpec {
    mut out: []parser::FSpec = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_fspec(xs[i]))
        i = i + 1
    }
    out
}

