 *
 * @param xs  the source typed expression slice
 * @return    a fresh typed expression slice
 * @since 0.3.1 arena-por-escopo M1a
 */
fn clone_texpr_list(xs: []TExpr) -> []TExpr {
    mut out: []TExpr = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, clone_texpr(xs[i]))
        i = i + 1
    }
    out
