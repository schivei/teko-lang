fn clone_field(f: parser::Field) -> parser::Field {
    parser::Field { name = clone_str(f.name); type_ann = clone_typeexpr(f.type_ann); vis = f.vis; is_intern = f.is_intern; has_doc = f.has_doc; doc = clone_str(f.doc) }
}

/**
 * clone_field_list — rebuild a `[]parser::Field`.
