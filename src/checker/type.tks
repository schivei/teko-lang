
pub type PrimKind = enum {
    U8; U16; U32; U64
    I8; I16; I32; I64
    F32; F64
    Bool
    Size; Usize
}

fn prim_is_float(k: PrimKind): bool {
    match k { F32 => true; F64 => true; _ => false }
}

fn prim_is_int(k: PrimKind): bool {
    match k {
        U8 => true; U16 => true; U32 => true; U64 => true
        I8 => true; I16 => true; I32 => true; I64 => true
        Size => true; Usize => true
        _ => false
    }
}

fn prim_is_signed(k: PrimKind): bool {
    match k {
        I8 => true; I16 => true; I32 => true; I64 => true
        Size => true
        _ => false
    }
}

pub fn prim_width(k: PrimKind): u32 {
    match k {
        U8 => 8; U16 => 16; U32 => 32; U64 => 64
        I8 => 8; I16 => 16; I32 => 32; I64 => 64
        F32 => 32; F64 => 64
        Bool => 1
        Size => 64; Usize => 64
    }
}

pub type Prim = struct { kind: PrimKind }
pub type Slice = struct { element: @Type() }
pub type Named = struct { name: str }
pub type Variant = struct { members: []@Type() }
pub type Func = struct { params: []@Type(); ret: @Type(); variadic: bool; param_names: []str; n_required: u64; defaults: []parser::Expr; ret_extra: []@Type() }
pub type Byte = struct { }
pub type Char = struct { }
pub type Str = struct { }
pub type Error = struct { }
pub type Void = struct { }
pub type Ptr = struct {
    inner: @Type() | null
}
pub type Uptr = struct { }
pub type Reference = struct { inner: @Type() }

pub type Null = struct { }

macro Type() { lowering { checker::Prim | checker::Byte | checker::Char | checker::Str | checker::Slice | checker::Named | checker::Variant | checker::Func | checker::Error | checker::Void | checker::Ptr | checker::Uptr | checker::Reference | checker::Null } }

fn type_is_void(t: @Type()): bool {
    match t { Void => true; _ => false }
}

fn ptr_inner_eq(a: @Type() | null, b: @Type() | null): bool {
    match a {
        null => match b { null => true; (@Type()) as _gt5 => false }
        (@Type()) as ta => match b { null => false; (@Type()) as tb => type_eq(ta, tb) }
    }
}

pub fn type_eq(a: @Type(), b: @Type()): bool {
    match a {
        Prim as pa => match b { Prim as pb => pa.kind == pb.kind; _ => false }
        Byte => match b { Byte => true; _ => false }
        Char => match b { Char => true; _ => false }
        Str => match b { Str => true; _ => false }
        Error => match b { Error => true; Named as nb => nb.name == "teko::checker::Error"; _ => false }
        Void => match b { Void => true; _ => false }
        Slice as sa => match b {
            Slice as sb => {
                match sa.element { Void => true; _ => match sb.element { Void => true; _ => type_eq(sa.element, sb.element) } }
            }
            _ => false
        }
        Named as na => match b { Named as nb => na.name == nb.name; Error => na.name == "teko::checker::Error"; Null => na.name == "teko::checker::Null"; _ => false }
        Variant as va => match b { Variant as vb => types_eq(va.members, vb.members); _ => false }
        Func as fa => match b {
            Func as fb => type_eq(fa.ret, fb.ret) && types_eq(fa.params, fb.params)
            _ => false
        }
        Ptr as pa => match b { Ptr as pb => ptr_inner_eq(pa.inner, pb.inner); _ => false }
        Uptr => match b { Uptr => true; _ => false }
        Reference as ra => match b { Reference as rb => type_eq(ra.inner, rb.inner); _ => false }
        Null => match b { Null => true; Named as nb => nb.name == "teko::checker::Null"; _ => false }
    }
}

fn types_eq(xs: []@Type(), ys: []@Type()): bool {
    if xs.len != ys.len { return false }
    var i = 0
    loop {
        if i >= xs.len { break }
        if !type_eq(xs[i], ys[i]) { return false }
        i++
    }
    true
}

fn type_contains_ref(t: @Type()): bool {
    match t {
        Reference => true
        Slice as s => type_contains_ref(s.element)
        Variant as v => types_contain_ref(v.members)
        _ => false
    }
}

fn types_contain_ref(xs: []@Type()): bool {
    var i = 0
    loop {
        if i >= xs.len { break }
        if type_contains_ref(xs[i]) { return true }
        i++
    }
    false
}

fn is_ref_null_variant(t: @Type()): bool {
    var ms = match t { Variant as v => v.members; _ => return false }
    if ms.len != 2 { return false }
    var has_null = false
    var has_ref = false
    var i = 0
    loop {
        if i >= ms.len { break }
        match ms[i] {
            Null => has_null = true
            Reference => has_ref = true
            _ => return false
        }
        i++
    }
    has_null && has_ref
}
