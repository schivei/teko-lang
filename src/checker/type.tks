// src/checker/type.tks  (namespace 'teko::checker')

/**
 * PrimKind — the injected scalar primitives (B.19), distinct real types. Native numeric set
 * (B.38 / TEKO_CORRECTION_PLAN §5): unsigned/signed integers 8–64 bit and the two IEEE floats
 * f32/f64. `dec`/`bigint` remain deferred (runtime-backed). The 128-bit widths (`u64`/`i64`)
 * and the half-precision float (`f32`) are REMOVED (drop-128, 2026-07-24) — the surface no
 * longer accepts them (`scope.tks::builtin_type` honest-stops on `i64`/`u64`/`f32`), so no
 * member for them exists here.
 *
 * (0.3.1 §8) `Size`/`Usize` — the machine-word-width types (`size` signed, `usize` unsigned) —
 * are APPENDED after `Bool` so no existing ordinal shifts (ordinal-safe for the `.tkb` wire,
 * whose prim tag is the enum ordinal). They are DISTINCT kinds from `uptr` (the opaque FFI
 * address, `Uptr`): a `usize` is a number that participates in casts/arithmetic like `u64`; a
 * `uptr` is a transport-only opaque word. On a 64-bit target `usize` lowers identical to `u64`
 * and `size` identical to `i64`, so a memory/collection position reballed from `u64` to `usize`
 * emits byte-identical C (the §8 byte-preservation proof).
 */
pub type PrimKind = enum {
    U8; U16; U32; U64
    I8; I16; I32; I64
    F32; F64
    Bool
    Size; Usize
}

/**
 * prim_is_float — true for the IEEE float prims (F32/F64).
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is a float
 */
fn prim_is_float(k: PrimKind): bool {
    match k { F32 => true; F64 => true; _ => false }
}

/**
 * prim_is_int — true for the integer prims (U8..U64, I8..I64). NOT bool, NOT float.
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is an integer
 */
fn prim_is_int(k: PrimKind): bool {
    match k {
        U8 => true; U16 => true; U32 => true; U64 => true
        I8 => true; I16 => true; I32 => true; I64 => true
        Size => true; Usize => true   // (§8) machine-word ints — participate in casts/arithmetic like i64/u64
        _ => false
    }
}

/**
 * prim_is_signed — true for the SIGNED integer prims (I8..I64). Floats are signed by nature, but
 * this predicate is about INTEGER signedness — call it only for ints (it returns false for
 * floats and bool, which carry no integer-signedness concept).
 *
 * @param k  the prim kind to classify
 * @return   whether `k` is a signed integer
 */
fn prim_is_signed(k: PrimKind): bool {
    match k {
        I8 => true; I16 => true; I32 => true; I64 => true
        Size => true   // (§8) `size` is the SIGNED machine word; `usize` is unsigned
        _ => false
    }
}

/**
 * prim_width — the bit width of a prim: ints 8/16/32/64, floats 32/64, bool 1.
 *
 * @param k  the prim kind to measure
 * @return   its bit width
 */
pub fn prim_width(k: PrimKind): u32 {
    match k {
        U8 => 8; U16 => 16; U32 => 32; U64 => 64
        I8 => 8; I16 => 16; I32 => 32; I64 => 64
        F32 => 32; F64 => 64
        Bool => 1
        Size => 64; Usize => 64   // (§8) machine word — 64-bit on the target
    }
}

/**
 * Doctrinal correction (TEKO_CORRECTION_PLAN §3 [Z1]; Laws M.0/M.1/M.3): `Unit` (the
 * value-less struct) is EXCISED — "returns no value" is `void`. `void` is a RETURN-ONLY
 * marker, legal ONLY as `Func.ret`: never a value, never a binding type, never a variant
 * member (enforced in the checker, Z2a — the model only needs to REPRESENT it). `error` is
 * the native lowercase type — it SUPERSEDES the old capitalized `Error` / `teko::Error`.
 * Nullability has no dedicated unary type-former: an absent value is the union `T | null`
 * (a `Variant` carrying a `Null` member), and a variant member may not itself be a bare
 * `null` (enforced in the checker's `variant_member_admissible`).
 *
 * The cases below that carry data (Teko has no payload on a bare enum — a variant case is
 * a struct). Byte/Str/error/void are markers (no payload).
 */
pub type Prim = struct { kind: PrimKind }
pub type Slice = struct { element: Type }   // []T — recursive (B.8)
pub type Named = struct { name: str }   // a user type, equal by NAME (nominal)
pub type Variant = struct { members: []Type }   // A | B | … (two or more); members are COMPLETE types
/**
 * Func — a function TYPE `(params): ret` (ret may be void). `variadic` = the last param is a C#-style
 * `params` slice (false for closures/FFI/lambda types). DEFARGS: `param_names` parallel to `params`
 * (empty for closures/FFI/builtins); `n_required` = count of leading params with no default;
 * `defaults` = the default expressions for `params[n_required..]`.
 *
 * @field params      the parameter types in order.
 * @field ret         the (single, or first-of-multiple) return type; may be `void`.
 * @field variadic    the last param is a C#-style `params` slice.
 * @field param_names PARALLEL to `params`; empty for closures/FFI/builtins (no named-call).
 * @field n_required  count of leading params with no default (trailing-only rule).
 * @field defaults    the default expressions for `params[n_required..]`, in order.
 * @field ret_extra   the ADDITIONAL return types (positions 2..N) of a MULTIPLE-return signature
 *                    (§9 F, ruling 3). EMPTY for a single-return fn: `ret` stays the sole return type
 *                    and every existing `Func { … }` only appends `ret_extra = teko::list::empty()`
 *                    (fixpoint). Total return arity is `1 + ret_extra.len` when non-empty. There is NO
 *                    tuple `Type` — multi-valuedness lives as this list on the signature, never as a
 *                    typeable value.
 */
pub type Func = struct { params: []Type; ret: Type; variadic: bool; param_names: []str; n_required: u64; defaults: []parser::Expr; ret_extra: []Type }
pub type Byte = struct { }   // the octet type
pub type Char = struct { }   // a UTF-8 codepoint (1–4 bytes); distinct by tag, runtime layout == []byte
pub type Str = struct { }   // validated UTF-8
pub type Error = struct { }   // the native `error` (lowercase; supersedes `Error`)
pub type Void = struct { }   // return-only marker; legal ONLY as Func.ret
/**
 * Ptr — the checker representation of `ptr<T>`, a TYPED machine address. The internal meta-name
 * differs from the surface `ptr<T>` exactly as `Slice`↔`[]T`; it is the primitive inside `Ref<T>`.
 */
pub type Ptr = struct {
    /** the pointed-to type, or `null` for the opaque `ptr` ≡ `ptr<void>` ≡ `*void` (pointer-only, NOT the value-`void`). */
    inner: Type | null
}
/**
 * Uptr — the checker representation of `uptr`, the opaque word-size unsigned integer FFI authors
 * spell for a raw `void*`-style pointer (C7.1a: transport-only at the FFI boundary, never
 * dereferenced by Teko). Owner ruling (2026-08-04, verbatim PT-BR): *"Para FFI pode se usar a
 * união `| null` para isso e para ponteiros `void*` temos `uptr`."* — value/FFI absence is the
 * union `T | null` (`Variant{Null,T}`, `checker::Null`), and a raw address is `uptr`. The opaque
 * `void*` case is already `Ptr{inner=null}` (`ptr<void>`).
 */
pub type Uptr = struct { }   // (C7.1a) opaque word-size unsigned — transport-only at the FFI boundary
/**
 * Reference — (MEM-1b) the META-level representation of the SAFE reference (user surface keyword
 * `ref`, a compiler-known "C pointer WITHOUT `*`/`&`"). The meta-name differs from the surface
 * name exactly as `Ptr`↔`ptr<T>`, `Slice`↔`[]T` (the lowercase/distinct convention avoids the
 * surface name colliding with this internal type-case during self-host codegen). `Ref<T>` is the
 * internal notation within the checker; it is never user-spellable. Reuses generics (no keyword).
 * Mutable-target only and NEVER null (R2), so `inner` is a plain `Type` and there is no
 * opaque/bare form (unlike `Ptr`). Deref/assign via `.value`+`mut`; auto-ref when a `mut` lvalue
 * is passed where `Reference` (i.e., `ref T`) is expected. C representation = bare `<T> *` today
 * (the `{p, metadata}` struct wrapper waits until regions/DI add metadata fields — W9+).
 */
pub type Reference = struct { inner: Type }

/**
 * The `null` unit type — the sole member of its own domain, a 1-byte zero-fill
 * value (`0b00000000`). Distinct from `void` (return-only, never a value): a
 * `Null` IS a bindable value meaning "absent". Ratified (owner, 2026-07-19).
 *
 * @since null-as-union
 */
pub type Null = struct { }

// a semantic type. (Compiler-managed indirection for the recursive cases.)
pub type Type = variant Prim | Byte | Char | Str | Slice | Named | Variant | Func | Error | Void | Ptr | Uptr | Reference | Null

// `void` recognition (M.3): the checker (Z2a) calls this to admit void in a
// `Func.ret` position and to reject it everywhere else (value / binding / member).
fn type_is_void(t: Type): bool {
    match t { Void => true; _ => false }
}

// (S-mem) two ptr inners equal: both null (opaque ptr) → equal; one null → not; else by type.
fn ptr_inner_eq(a: Type | null, b: Type | null): bool {
    match a {
        null => match b { null => true; Type => false }
        Type as ta => match b { null => false; Type as tb => type_eq(ta, tb) }
    }
}

// nominal type equality (B.13): structural over the shape, but Named is by name.
fn type_eq(a: Type, b: Type): bool {
    match a {
        Prim as pa => match b { Prim as pb => pa.kind == pb.kind; _ => false }
        Byte => match b { Byte => true; _ => false }
        Char => match b { Char => true; _ => false }   // char == char only (distinct from byte / []byte)
        Str => match b { Str => true; _ => false }
        Error => match b { Error => true; _ => false }   // native `error`
        Void => match b { Void => true; _ => false }   // return-only marker
        // []T == []U iff elements equal (built-in unary former). A `teko::list::empty()` carries
        // the SENTINEL slice (its element is the `Void` marker; the C twin uses a NULL element
        // pointer): it unifies with ANY concrete slice, so a bare `empty()` flows into a typed slot
        // / a `push` whose item fixes the element type. A real slice never has a `void` element.
        Slice as sa => match b {
            Slice as sb => {
                match sa.element { Void => true; _ => match sb.element { Void => true; _ => type_eq(sa.element, sb.element) } }
            }
            _ => false
        }
        Named as na => match b { Named as nb => na.name == nb.name; _ => false }
        Variant as va => match b { Variant as vb => types_eq(va.members, vb.members); _ => false }
        Func as fa => match b {
            Func as fb => type_eq(fa.ret, fb.ret) && types_eq(fa.params, fb.params)
            _ => false
        }
        Ptr as pa => match b { Ptr as pb => ptr_inner_eq(pa.inner, pb.inner); _ => false }   // ptr<T> equal by pointed type (null inner = opaque ptr)
        Uptr => match b { Uptr => true; _ => false }   // (C7.1a) opaque, same-kind only
        Reference as ra => match b { Reference as rb => type_eq(ra.inner, rb.inner); _ => false }   // (MEM-1b) Ref<T> equal by referenced type (never null)
        Null => match b { Null => true; _ => false }
    }
}

// element-wise equality of two type lists (same length, each equal in order).
fn types_eq(xs: []Type, ys: []Type): bool {
    if xs.len != ys.len { return false }
    var i = 0
    loop {
        if i >= xs.len { break }
        if !type_eq(xs[i], ys[i]) { return false }
        i++
    }
    true
}

/**
 * type_contains_ref — (MEM Step 0) ESCAPE-GATE PREDICATE — does `t` carry a Reference anywhere a
 * value can be stored? The invariant: a Reference may appear ONLY as a bare scalar function
 * PARAMETER; in EVERY other value position it is forbidden, even nested. So this returns true if
 * `t` IS a Reference, OR a Slice whose element contains a ref, OR a Variant any of whose members
 * contains a ref (this also covers a `Ref<T> | null` union — the ref lives as an ordinary
 * member). Recursive. The annotated forms are already caught by resolve (R2/R4), but an INFERRED
 * slice element (e.g. `let xs = [r, r]`) only surfaces here. C: tk_type_contains_ref.
 *
 * @param t  the type to scan
 * @return   true iff `t` carries a `Reference` anywhere a value is stored
 */
fn type_contains_ref(t: Type): bool {
    match t {
        Reference => true
        Slice as s => type_contains_ref(s.element)
        Variant as v => types_contain_ref(v.members)
        _ => false
    }
}

// any-of helper for type_contains_ref over a variant's member list.
fn types_contain_ref(xs: []Type): bool {
    var i = 0
    loop {
        if i >= xs.len { break }
        if type_contains_ref(xs[i]) { return true }
        i++
    }
    false
}

/**
 * is_ref_null_variant — is `t` the two-member absence union `Ref<T> | null` (exactly one `Null`
 * member and one `Reference` member, in either source order)? This is the SOLE ref-bearing shape the
 * null-union C3 resolve gate admits (owner D3), and the ONE shape whose LOCAL binding null-union C5
 * lifts out of the "references are parameter-only" restriction: the borrow-spine still proves the
 * handle does not outlive its referent, and the universal narrowing invariant fences the deref (a
 * `Ref<T> | null` cannot be dereferenced until narrowed to a bare `Ref<T>`), so the bare-reference R2
 * promise stays sound. Any other ref-carrying type (a bare `Reference`, a slice/optional/struct that
 * reaches a `Reference`, a `> 2`-member union) is NOT this shape and stays rejected.
 *
 * @param t  the resolved type to classify
 * @return   true iff `t` is a `Variant` whose members are exactly `{ null, Reference }`
 * @since 0.3.0.30 (null-union C5)
 */
fn is_ref_null_variant(t: Type): bool {
    var ms = match t { Variant as v => v.members; _ => return false }
    if ms.len != 2 { return false }
    var has_null = false
    var has_ref = false
    var i = 0
    loop {
        if i >= ms.len { break }
        match ms[i] {
            Null => has_null = true
            Reference => has_ref = true
            _ => return false
        }
        i++
    }
    has_null && has_ref
}
