// src/checker/cf_predicates.tks  (namespace 'teko::checker')

use teko::lexer
use teko::parser

    match t {
        Prim as p => {
            if !prim_is_int(p.kind) { return error { message = "comptime fold: type is not an integer" } }
            let w = prim_width(p.kind)
            if w > 64 { return error { message = "comptime fold: integer width wider than 64 bits is not evaluated" } }
            IntInfo { width = w; is_signed = prim_is_signed(p.kind) }
        }
        Byte => IntInfo { width = 8; is_signed = false }
        _ => error { message = "comptime fold: type is not an integer" }
    }
}

/**
 * eval_const — evaluate a PROVABLY-const expression subtree (one already accepted by
 * `is_const_expr`) to its ConstValue, matching the backend's arithmetic semantics
 * EXACTLY (Layer 1a). Recurses over the Tier-0..5 grammar plus `TIndex` of a const
 * aggregate at a const index (Layer 1c). An overflow, a ÷0, or an out-of-range cast on
 * a constant is a LOCATED COMPILE ERROR, never a silent wrap (M.1; LEGISLATION:148) —
 * a value the compiler can already see is out of range fails loudly at compile time.
 * The caller MUST have proven `is_const_expr(e) == null` first; a non-const form here
 * is an internal-error located at `e`.
 *
 * @param e      the typed, provably-const expression to evaluate
 * @param table  the type table (to classify a callee / resolve a referenced type)
 * @param env    the environment resolving a name to a const/binding + its value
 * @param agg    the module-aggregate resolution table (resolves a `TVar` index receiver, Layer 1c)
 * @return       the computed comptime value, or a located error (overflow / ÷0 /
 *               out-of-range / a non-const form reaching this evaluator)
 * @since #comptime-fold
 */
pub fn eval_const(e: TExpr, table: TypeTable, env: Env, agg: AggConstMap) -> ConstValue | error {
    match e.kind {
        TNumber as n => eval_number(n, e)
        TBoolLit as b => cv_bool(b.value)
        TByteLit as by => cv_int(by.value to u64, Byte { })
        TCharLit as ch => cv_bytes(bytes_of_str(ch.bytes))
        TStrLit as s => cv_bytes(bytes_of_str(s.text))
        TCast as c => eval_cast_expr(c, e, table, env, agg)
        TUnary as u => eval_unary_expr(u, e, table, env, agg)
        TBinary as bi => eval_binary_expr(bi, e, table, env, agg)
        TVar as v => eval_agg_ref(v, e, table, env, agg)
        TArrayLit as a => eval_array_agg(a, table, env, agg)
        TIndex as ix => eval_index_expr(ix, e, table, env, agg)
        TFieldAccess as fa => eval_field_expr(fa, e, table, env, agg)
        _ => const_form_error("this expression is not a Tier-0..2 scalar constant the comptime fold evaluates yet (#comptime-fold)", e)
    }
}

/**
 * predicate_folds_const — does the boolean predicate `e` reduce to a COMPILE-TIME CONSTANT? (the
 * test-analyzer's assertion discriminator, 0.3.0.29). An assertion whose predicate folds to a
 * constant can NEVER discriminate at run time — `is_true` of a folded-`true` is a dead guard; a test
 * whose predicates ALL fold tests the fold/foundation, not live production. This complements
 * `eval_const`: `eval_const` reduces the SCALAR grammar (numbers/casts/arith), while a predicate is a
 * BOOLEAN tree — so this also decides a `TCompare` (folds iff every operand folds), a logical `&&`/`||`
 * (folds iff both sides fold), and a `!` (folds iff its operand folds). A leaf that is a runtime call
 * or variable never folds, so the whole predicate is a real guard.
 *
 * @param e  the checked predicate expression (the single argument of `is_true`/`is_false`)
 * @return   true iff `e` is comptime-decided (a dead guard), false iff it depends on a runtime value
 * @since 0.3.0.29
 */
pub fn predicate_folds_const(e: TExpr) -> bool {
    predicate_folds(e, fold_empty_table(), env_empty())
}

/**
 * eval_folds — does `eval_const` reduce `e` to a `ConstValue` (versus erroring on a runtime form)?
 * The scalar leg of `predicate_folds`.
 *
 * @param e      the expression to test
 * @param table  the (empty) type table
 * @param env    the (empty) environment
 * @return       true iff `e` folds to a comptime `ConstValue`
 * @since 0.3.0.29
 */
fn eval_folds(e: TExpr, table: TypeTable, env: Env) -> bool {
    match eval_const(e, table, env, fold_empty_agg()) { ConstValue => true; error => false }
}

/**
 * predicate_folds — the recursive boolean-predicate fold decision behind `predicate_folds_const`.
 * A scalar/arith form defers to `eval_folds`; a comparison, a logical `&&`/`||`, and a `!` are decided
 * structurally; every other form (a call, a variable) is a runtime value and does not fold.
 *
 * @param e      the predicate (sub)expression
 * @param table  the (empty) type table forwarded to the scalar evaluator
 * @param env    the (empty) environment forwarded to the scalar evaluator
 * @return       true iff `e` is comptime-decided
 * @since 0.3.0.29
 */
fn predicate_folds(e: TExpr, table: TypeTable, env: Env) -> bool {
    if eval_folds(e, table, env) { return true }
    match e.kind {
        TCompare as c => compare_operands_fold(c, table, env)
        TBinary as b => logical_binary_folds(b, table, env)
        TUnary as u => predicate_folds(u.operand, table, env)
        _ => false
    }
}

/**
 * compare_operands_fold — a `TCompare` is comptime-decided iff its first operand AND every subsequent
 * operand each fold to a `ConstValue` (a comparison of constants has a fixed truth value).
 *
 * @param c      the typed comparison
 * @param table  the (empty) type table
 * @param env    the (empty) environment
 * @return       true iff every operand folds
 * @since 0.3.0.29
 */
fn compare_operands_fold(c: TCompare, table: TypeTable, env: Env) -> bool {
    if !eval_folds(c.first, table, env) { return false }
    mut i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        if !eval_folds(c.rest[i].operand, table, env) { return false }
        i++
    }
    true
}

/**
 * logical_binary_folds — a `TBinary` predicate is comptime-decided only for the boolean connectives
 * `&&`/`||` and only when BOTH sides fold; any other binary that reached here failed `eval_folds`
 * because an operand is a runtime value, so it does not fold.
 *
 * @param b      the typed binary node
 * @param table  the (empty) type table
 * @param env    the (empty) environment
 * @return       true iff `b` is a `&&`/`||` whose both sides fold
 * @since 0.3.0.29
 */
fn logical_binary_folds(b: TBinary, table: TypeTable, env: Env) -> bool {
    if b.op != lexer::TokenKind::AndAnd && b.op != lexer::TokenKind::OrOr { return false }
    predicate_folds(b.left, table, env) && predicate_folds(b.right, table, env)
}

/**
 * eval_number — evaluate a numeric literal (Tier 0): a float routes to the float-literal
 * encoder, an integer to the range-checked integer-literal encoder.
 *
 * @param n  the typed number literal
 * @param e  the enclosing expression (its type is the literal's declared type; its
 *           line/col position any error)
 * @return   the literal's comptime value, or a located error
 * @since #comptime-fold
 */
fn eval_number(n: TNumber, e: TExpr) -> ConstValue | error {
    if n.is_float { return eval_float_literal(n.fval, e.type, e) }
