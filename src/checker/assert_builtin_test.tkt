/**
 * abt_every_assertion_the_seed_defines_is_admitted — the collapse of three parallel lists into one,
 * pinned by name.
 *
 * `checker::assert_builtin_name` is now the SOLE enumeration of the `teko::assert` family: the typer
 * takes its signature from `assert_builtin_fn`, and both backends' assert lowering
 * (`lir::lower::assert_seed_symbol`, `codegen::cg_assert_c_symbol`) ask this predicate for the name.
 * Before the collapse each of the three carried its own copy, so an assertion added to two of them
 * type-checked and then failed to LINK — the exact failure mode this test makes impossible to
 * reintroduce silently, because a name added to `src/assert/assert.c` but not here fails here.
 */
#test
fn abt_every_assertion_the_seed_defines_is_admitted() {
    teko::assert::is_true(assert_builtin_name("is_true"))
    teko::assert::is_true(assert_builtin_name("is_false"))
    teko::assert::is_true(assert_builtin_name("scenario_begin"))
    teko::assert::is_true(assert_builtin_name("scenario_ok"))
    teko::assert::is_true(assert_builtin_name("eq_i64"))
    teko::assert::is_true(assert_builtin_name("ne_i64"))
    teko::assert::is_true(assert_builtin_name("lt_i64"))
    teko::assert::is_true(assert_builtin_name("le_i64"))
    teko::assert::is_true(assert_builtin_name("gt_i64"))
    teko::assert::is_true(assert_builtin_name("ge_i64"))
    teko::assert::is_true(assert_builtin_name("eq_u64"))
    teko::assert::is_true(assert_builtin_name("eq_f64"))
    teko::assert::is_true(assert_builtin_name("eq_str"))
    teko::assert::is_true(assert_builtin_name("ne_str"))
    teko::assert::is_true(assert_builtin_name("str_contains"))
    teko::assert::is_true(assert_builtin_name("str_absent"))
    teko::assert::is_true(assert_builtin_name("str_starts_with"))
    teko::assert::is_true(assert_builtin_name("str_ends_with"))
    teko::assert::is_true(assert_builtin_name("len_eq"))
    teko::assert::is_true(assert_builtin_name("bytes_eq"))
    teko::assert::is_true(assert_builtin_name("is_present"))
    teko::assert::is_true(assert_builtin_name("is_absent"))
    teko::assert::is_true(assert_builtin_name("is_ok"))
    teko::assert::is_true(assert_builtin_name("is_error"))
}

/**
 * abt_a_name_that_is_no_assertion_is_refused — the predicate must be a WHITELIST, not a prefix guess.
 * `print` and `concat` are real injected builtins under other roots and must never lower to a
 * `teko__assert__` symbol; `eq_i32` is the plausible-but-absent neighbour a caller would mistype.
 */
#test
fn abt_a_name_that_is_no_assertion_is_refused() {
    teko::assert::is_false(assert_builtin_name("print"))
    teko::assert::is_false(assert_builtin_name("concat"))
    teko::assert::is_false(assert_builtin_name("eq_i32"))
    teko::assert::is_false(assert_builtin_name("scenario"))
    teko::assert::is_false(assert_builtin_name(""))
}

/**
 * abt_the_family_is_twenty_four_names — the COUNT, stated so a change to the surface is a change to
 * this number and not a silent drift.
 *
 * Twenty-four is the arity of the whole list, counted the only honest way: the two names admitted
 * before this work (`is_true`, `is_false`) plus `str_contains`, which was the third, plus the
 * twenty-one added so a case can assert what it DOES instead of the number it exits with.
 */
#test
fn abt_the_family_is_twenty_four_names() {
    teko::assert::eq_u64(abt_admitted_count(abt_all_names()), 24)
}

/**
 * abt_all_names — every name the family is supposed to contain, written out so the count above is
 * measured against a list a human can read rather than against the implementation it checks.
 *
 * @return the expected member names
 */
fn abt_all_names() -> []str {
    mut n: []str = teko::list::push(teko::list::empty(), "is_true")
    n = teko::list::push(n, "is_false")
    n = teko::list::push(n, "str_contains")
    n = teko::list::push(n, "scenario_begin")
    n = teko::list::push(n, "scenario_ok")
    n = teko::list::push(n, "eq_i64")
    n = teko::list::push(n, "ne_i64")
    n = teko::list::push(n, "lt_i64")
    n = teko::list::push(n, "le_i64")
    n = teko::list::push(n, "gt_i64")
    n = teko::list::push(n, "ge_i64")
    n = teko::list::push(n, "eq_u64")
    n = teko::list::push(n, "eq_f64")
    n = teko::list::push(n, "eq_str")
    n = teko::list::push(n, "ne_str")
    n = teko::list::push(n, "str_absent")
    n = teko::list::push(n, "str_starts_with")
    n = teko::list::push(n, "str_ends_with")
    n = teko::list::push(n, "len_eq")
    n = teko::list::push(n, "bytes_eq")
    n = teko::list::push(n, "is_present")
    n = teko::list::push(n, "is_absent")
    n = teko::list::push(n, "is_ok")
    n = teko::list::push(n, "is_error")
    n
}

/**
 * abt_admitted_count — how many of `names` the predicate admits. A name on the list that the
 * predicate refuses lowers the count, so the equality above catches an omission as well as an excess.
 *
 * @param names  the names to test
 * @return       how many were admitted
 */
fn abt_admitted_count(names: []str) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        if assert_builtin_name(names[i]) { n = n + 1 }
        i = i + 1
    }
    n
}
