use teko::parser

/**
 * order_fixture — the item list this file's ORDER-INDEPENDENCE proof permutes: a non-generic decoy
 * per generic template (same bare name, another namespace), the two templates, and the two use
 * sites.
 *
 * The pass under proof (`resolve.tks::instantiate_types`) stamps one concrete `Base__g__<args>` decl
 * per written generic use. Its input is the FLATTENED item list, whose order is the order the build
 * discovered the sources in — a property of the machine, not of the program. Any lookup inside the
 * pass that answers "whichever entry sits earliest in the table" therefore makes the STAMPED SET
 * depend on the filesystem: the same tree compiles on one host and fails on another with
 * `internal: generic instance ... was not stamped`.
 *
 * The historical break this fixture encodes: a namespace declaring a NON-generic `Box` and another
 * declaring a generic `Box<T>`. The pass probed the base by bare name with no referencing namespace,
 * so it found whichever `Box` came first; when that was the non-generic one, the arity check
 * discarded the site and `Box__g__i64` was never stamped — while typing, which resolves `Box<i64>`
 * in the namespace that WROTE it, still expected the stamp to exist.
 *
 * The tests below compile these SAME items in many orders and require the SAME stamped set. A pass
 * that consults source order fails at least one order; a pass that stamps the program's closure
 * passes all of them.
 *
 * @return the fixture's items, in their declaration order
 */
fn order_fixture() -> []parser::Item {
    mut items: []parser::Item = teko::list::empty()
    items = teko::list::push(items, decoy_box_item())
    items = teko::list::push(items, generic_box_item())
    items = teko::list::push(items, use_box_item())
    items = teko::list::push(items, decoy_cell_item())
    items = teko::list::push(items, generic_cell_item())
    items = teko::list::push(items, use_cell_item())
    items
}

/** ns_alpha — the namespace declaring the decoy NON-generic `Box`. */
fn ns_alpha() -> str { "alpha" }

/** ns_beta — the namespace declaring the generic `Box<T>` and writing `Box<i64>`. */
fn ns_beta() -> str { "beta" }

/** ord_path1 — a single-segment path (a bare type reference). */
fn ord_path1(name: str) -> parser::Path { parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) } }

/** ord_named — a bare `NamedType` with no type-arguments. */
fn ord_named(name: str) -> parser::TypeExpr { parser::NamedType { path = ord_path1(name); args = teko::list::empty() } }

/** ord_named_of — a `NamedType` carrying exactly one type-argument (`Base<arg>`). */
fn ord_named_of(base: str, arg: str) -> parser::TypeExpr {
    parser::NamedType { path = ord_path1(base); args = teko::list::push(teko::list::empty(), ord_named(arg)) }
}

/** ord_field — one public struct field with the given annotation. */
fn ord_field(name: str, ann: parser::TypeExpr) -> parser::Field {
    parser::Field { name = name; type_ann = ann; vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = "" }
}

/** ord_struct — a `struct { <one field> }` body with no methods, interfaces or consts. */
fn ord_struct(field: parser::Field) -> parser::TypeBody {
    parser::StructBody { fields = teko::list::push(teko::list::empty(), field); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty() }
}

/** ord_type_decl — a type declaration with the given name, type-params and body. */
fn ord_type_decl(name: str, type_params: []str, body: parser::TypeBody) -> parser::TypeDecl {
    parser::TypeDecl { name = name; type_params = type_params; type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0; di_kind = parser::DiKind::None; has_di_key = false; di_key = ""; is_unsafe = false; must_free = false }
}

/** ord_item — a flattened top-level item in the given namespace. */
fn ord_item(content: parser::ItemKind, namespace: str) -> parser::Item {
    parser::Item { content = content; namespace = namespace; file = "" }
}

/** decoy_box_item — `type Box = struct { v: i64 }` in `alpha`: same BARE name, NOT generic. */
fn decoy_box_item() -> parser::Item {
    ord_item(ord_type_decl("Box", teko::list::empty(), ord_struct(ord_field("v", ord_named("i64")))), ns_alpha())
}

/** generic_box_item — `type Box<T> = struct { value: T }` in `beta`: the real template. */
fn generic_box_item() -> parser::Item {
    let params = teko::list::push(teko::list::empty(), "T")
    ord_item(ord_type_decl("Box", params, ord_struct(ord_field("value", ord_named("T")))), ns_beta())
}

/** use_box_item — `fn use_box() { let b: Box<i64> = … }` in `beta`: the instantiation site. */
fn use_box_item() -> parser::Item {
    let bind: parser::Statement = parser::Binding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "b" }
        has_type = true
        type_ann = ord_named_of("Box", "i64")
        value = parser::Expr { kind = parser::Var { name = "seed" }; line = 0; col = 0 }
    }
    let f = parser::Function {
        name = "use_box"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = teko::list::empty(); has_return = false; return_type = ord_named("void")
        body = teko::list::push(teko::list::empty(), bind)
        vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = false; is_abstract = false; is_virtual = false; is_override = false
        has_inject = false; injects = teko::list::empty(); is_unsafe = false
    }
    ord_item(f, ns_beta())
}

/** decoy_cell_item — `type Cell = struct { n: i64 }` in `beta`: a second same-bare decoy, so the
    permutation set also covers a decoy that shares the TEMPLATE's namespace. */
fn decoy_cell_item() -> parser::Item {
    ord_item(ord_type_decl("Cell", teko::list::empty(), ord_struct(ord_field("n", ord_named("i64")))), ns_alpha())
}

/** generic_cell_item — `type Cell<T> = struct { held: T }` in `beta`. */
fn generic_cell_item() -> parser::Item {
    let params = teko::list::push(teko::list::empty(), "T")
    ord_item(ord_type_decl("Cell", params, ord_struct(ord_field("held", ord_named("T")))), ns_beta())
}

/** use_cell_item — `fn use_cell() { let c: Cell<str> = … }` in `beta`. */
fn use_cell_item() -> parser::Item {
    let bind: parser::Statement = parser::Binding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "c" }
        has_type = true
        type_ann = ord_named_of("Cell", "str")
        value = parser::Expr { kind = parser::Var { name = "seed" }; line = 0; col = 0 }
    }
    let f = parser::Function {
        name = "use_cell"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = teko::list::empty(); has_return = false; return_type = ord_named("void")
        body = teko::list::push(teko::list::empty(), bind)
        vis = parser::Visibility::Pub; has_doc = false; doc = ""; line = 0; col = 0
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = false; is_abstract = false; is_virtual = false; is_override = false
        has_inject = false; injects = teko::list::empty(); is_unsafe = false
    }
    ord_item(f, ns_beta())
}

/**
 * rotate_items — the item list rotated left by `by` positions. Rotation alone is enough to place
 * every item both BEFORE and AFTER every other, which is exactly the axis a discovery-order
 * dependency lives on.
 *
 * @param items the fixture
 * @param by    how many positions to rotate left
 * @return      the rotated list (same multiset of items)
 */
fn rotate_items(items: []parser::Item, by: u64) -> []parser::Item {
    mut out: []parser::Item = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= items.len { break }
        out = teko::list::push(out, items[(i + by) % items.len])
        i++
    }
    out
}

/** reverse_items — the item list in reverse: the extreme of "declared after used". */
fn reverse_items(items: []parser::Item) -> []parser::Item {
    mut out: []parser::Item = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= items.len { break }
        out = teko::list::push(out, items[items.len - 1 - i])
        i++
    }
    out
}

/**
 * stamped_signature — the instantiation pass's whole answer for one item order, rendered as a
 * canonical, order-insensitive string: every stamped instance as `name(field,…)`, sorted. Two orders
 * agreeing on this string agree on the stamped SET, on which template each instance came from, and
 * on the concrete types its fields were substituted to.
 *
 * @param items the program's items, in the order under test
 * @return      the canonical rendering of the stamped instance set
 */
fn stamped_signature(items: []parser::Item) -> str {
    let program = parser::Program { items = items }
    let stamped = table_generic_instances(instantiate_types(program, collect_types(items)))
    mut rendered: []str = teko::list::empty()
    mut i = 0
    loop {
        if i >= stamped.len { break }
        rendered = teko::list::push(rendered, render_stamped_decl(stamped[i]))
        i++
    }
    join_sorted(rendered)
}

/**
 * render_stamped_decl — one stamped instance as `name(field:type,…)`. The FIELD SPELLINGS are part
 * of the rendering on purpose: they are what proves the pass stamped the GENERIC template and
 * substituted its type-param, rather than some same-bare-named decoy.
 *
 * @param decl the stamped instance decl
 * @return     its canonical rendering
 */
fn render_stamped_decl(decl: parser::TypeDecl) -> str {
    mut out = decl.name ~ "("
    match decl.body {
        parser::StructBody as sb => {
            mut i = 0
            loop {
                if i >= sb.fields.len { break }
                if i > 0 { out = out ~ "," }
                out = out ~ sb.fields[i].name ~ ":" ~ render_field_ann(sb.fields[i].type_ann)
                i++
            }
        }
        _ => { }
    }
    out ~ ")"
}

/**
 * render_field_ann — a field's (syntactic) annotation as its path text, or "?" for a shape this
 * proof never builds. Enough to tell `T` from `i64` from `str`.
 *
 * @param ann the field's type annotation
 * @return    the annotation's rendering
 */
fn render_field_ann(ann: parser::TypeExpr) -> str {
    match ann {
        parser::NamedType as nt => render_path(nt.path)
        _ => "?"
    }
}

/** render_path — a path's segments joined with "::". */
fn render_path(path: parser::Path) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= path.segments.len { break }
        if i > 0 { out = out ~ "::" }
        out = out ~ path.segments[i].name
        i++
    }
    out
}

/**
 * join_sorted — the strings sorted ascending and joined with "|", so the rendering compares the SET
 * of stamped instances and never the order they happen to sit in the table.
 *
 * @param parts the rendered instances
 * @return      the sorted, joined rendering
 */
fn join_sorted(parts: []str) -> str {
    let sorted = teko::sort::sort_str(parts)
    mut out = ""
    mut i = 0
    loop {
        if i >= sorted.len { break }
        if i > 0 { out = out ~ "|" }
        out = out ~ sorted[i]
        i++
    }
    out
}

/**
 * instantiate_stamps_the_generic_not_the_same_bare_decoy — the direct assertion: with a non-generic
 * `alpha::Box` in the program, the site `beta::Box<i64>` still stamps `Box__g__i64` FROM the generic
 * `beta::Box<T>` (its field is the substituted `value: i64`, not the decoy's `v`).
 */
#test
fn instantiate_stamps_the_generic_not_the_same_bare_decoy() {
    let sig = stamped_signature(order_fixture())
    teko::assert::is_true(teko::runtime::str_eq(sig, "Box__g__i64(value:i64)|Cell__g__str(held:str)"))
}

/**
 * instantiate_is_independent_of_item_order — THE proof: every rotation of the item list, and the
 * reversal, must produce the SAME stamped set. This is the test that fails the moment any lookup in
 * the pass starts answering by table position instead of by the program.
 */
#test
fn instantiate_is_independent_of_item_order() {
    let items = order_fixture()
    let expected = stamped_signature(items)
    teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(reverse_items(items))))
    mut by: u64 = 1
    loop {
        if by >= items.len { break }
        teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(rotate_items(items, by))))
        by++
    }
}

/**
 * instantiate_is_independent_of_reversed_rotations — the rotations of the REVERSED list too, so the
 * proof covers orders in which a template trails its use AND its decoy sits on either side of it.
 */
#test
fn instantiate_is_independent_of_reversed_rotations() {
    let items = order_fixture()
    let expected = stamped_signature(items)
    let flipped = reverse_items(items)
    mut by: u64 = 0
    loop {
        if by >= flipped.len { break }
        teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(rotate_items(flipped, by))))
        by++
    }
}
