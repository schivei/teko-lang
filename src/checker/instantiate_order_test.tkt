use teko::parser

fn order_fixture(): []parser::Item {
    var items: []parser::Item = teko::list::empty()
    items = teko::list::push(items, decoy_box_item())
    items = teko::list::push(items, generic_box_item())
    items = teko::list::push(items, use_box_item())
    items = teko::list::push(items, decoy_cell_item())
    items = teko::list::push(items, generic_cell_item())
    items = teko::list::push(items, use_cell_item())
    items
}

fn ns_alpha(): str { "alpha" }

fn ns_beta(): str { "beta" }

fn ord_path1(name: str): parser::Path { parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) } }

fn ord_named(name: str): @TypeExpr() { parser::NamedType { path = ord_path1(name); args = teko::list::empty() } }

fn ord_named_of(stem: str, arg: str): @TypeExpr() {
    parser::NamedType { path = ord_path1(stem); args = teko::list::push(teko::list::empty(), ord_named(arg)) }
}

fn ord_field(name: str, ann: @TypeExpr()): parser::Field {
    parser::Field { name = name; type_ann = ann; vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = parser::docspan_none(); is_readonly = false }
}

fn ord_struct(field: parser::Field): @TypeBody() {
    parser::StructBody { fields = teko::list::push(teko::list::empty(), field); methods = teko::list::empty(); implements = teko::list::empty(); consts = teko::list::empty(); is_readonly = false }
}

fn ord_type_decl(name: str, type_params: []str, body: @TypeBody()): parser::TypeDecl {
    parser::TypeDecl { name = name; type_params = type_params; type_constraints = teko::list::empty(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0; is_global = false }
}

fn ord_item(content: parser::UseDecl | @Statement() | parser::Function | parser::TypeDecl | parser::ConstDecl | parser::MacroDecl | parser::ComptimeDecl, namespace: str): parser::Item {
    parser::Item { content = content; namespace = namespace; file = "" ; guard = parser::pred_true()}
}

fn decoy_box_item(): parser::Item {
    ord_item(ord_type_decl("Box", teko::list::empty(), ord_struct(ord_field("v", ord_named("i64")))), ns_alpha())
}

fn generic_box_item(): parser::Item {
    var params = teko::list::push(teko::list::empty(), "T")
    ord_item(ord_type_decl("Box", params, ord_struct(ord_field("value", ord_named("T")))), ns_beta())
}

fn use_box_item(): parser::Item {
    var bind: @Statement() = parser::Binding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "b" }
        has_type = true
        type_ann = ord_named_of("Box", "i64")
        is_ref = false
        value = parser::Expr { kind = parser::Var { name = "seed" }; line = 0; col = 0 }
    }
    var f = parser::Function {
        name = "use_box"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = teko::list::empty(); has_return = false; return_type = ord_named("void")
        body = teko::list::push(teko::list::empty(), bind)
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = false; is_abstract = false; is_virtual = false; is_override = false
        is_static = false
        is_getter = false; is_setter = false; accessor_prop = ""
        has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty()
        is_operator = false
   ; is_global = false }
    ord_item(f, ns_beta())
}

fn decoy_cell_item(): parser::Item {
    ord_item(ord_type_decl("Cell", teko::list::empty(), ord_struct(ord_field("n", ord_named("i64")))), ns_alpha())
}

fn generic_cell_item(): parser::Item {
    var params = teko::list::push(teko::list::empty(), "T")
    ord_item(ord_type_decl("Cell", params, ord_struct(ord_field("held", ord_named("T")))), ns_beta())
}

fn use_cell_item(): parser::Item {
    var bind: @Statement() = parser::Binding {
        kind = parser::BindKind::Let
        target = parser::SimpleName { name = "c" }
        has_type = true
        type_ann = ord_named_of("Cell", "str")
        is_ref = false
        value = parser::Expr { kind = parser::Var { name = "seed" }; line = 0; col = 0 }
    }
    var f = parser::Function {
        name = "use_cell"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = teko::list::empty(); has_return = false; return_type = ord_named("void")
        body = teko::list::push(teko::list::empty(), bind)
        vis = parser::Visibility::Pub; has_doc = false; doc = parser::docspan_none(); line = 0; col = 0
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = false; is_abstract = false; is_virtual = false; is_override = false
        is_static = false
        is_getter = false; is_setter = false; accessor_prop = ""
        has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty()
        is_operator = false
   ; is_global = false }
    ord_item(f, ns_beta())
}

fn rotate_items(items: []parser::Item, by: u64): []parser::Item {
    var out: []parser::Item = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = teko::list::push(out, items[(i + by) % items.len])
        i++
    }
    out
}

fn reverse_items(items: []parser::Item): []parser::Item {
    var out: []parser::Item = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = teko::list::push(out, items[items.len - 1 - i])
        i++
    }
    out
}

fn stamped_signature(items: []parser::Item): str {
    var program = parser::Program { items = items }
    var stamped = table_generic_instances(instantiate_types(program, collect_types(items)))
    var rendered: []str = teko::list::empty()
    var i = 0
    loop {
        if i >= stamped.len { break }
        rendered = teko::list::push(rendered, render_stamped_decl(stamped[i]))
        i++
    }
    join_sorted(rendered)
}

fn render_stamped_decl(decl: parser::TypeDecl): str {
    var out = decl.name ~ "("
    match decl.body {
        parser::StructBody as sb => {
            var i = 0
            loop {
                if i >= sb.fields.len { break }
                if i > 0 { out = out ~ "," }
                out = out ~ sb.fields[i].name ~ ":" ~ render_field_ann(sb.fields[i].type_ann)
                i++
            }
        }
        _ => { }
    }
    out ~ ")"
}

fn render_field_ann(ann: @TypeExpr()): str {
    match ann {
        parser::NamedType as nt => render_path(nt.path)
        _ => "?"
    }
}

fn render_path(path: parser::Path): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= path.segments.len { break }
        if i > 0 { out = out ~ "::" }
        out = out ~ path.segments[i].name
        i++
    }
    out
}

fn join_sorted(parts: []str): str {
    var sorted = teko::sort::sort_str(parts)
    var out = ""
    var i = 0
    loop {
        if i >= sorted.len { break }
        if i > 0 { out = out ~ "|" }
        out = out ~ sorted[i]
        i++
    }
    out
}

#test
fn instantiate_stamps_the_generic_not_the_same_bare_decoy() {
    var sig = stamped_signature(order_fixture())
    teko::assert::is_true(teko::runtime::str_eq(sig, "Box__g__i64(value:i64)|Cell__g__str(held:str)"))
}

#test
fn instantiate_is_independent_of_item_order() {
    var items = order_fixture()
    var expected = stamped_signature(items)
    teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(reverse_items(items))))
    var by: u64 = 1
    loop {
        if by >= items.len { break }
        teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(rotate_items(items, by))))
        by++
    }
}

#test
fn instantiate_is_independent_of_reversed_rotations() {
    var items = order_fixture()
    var expected = stamped_signature(items)
    var flipped = reverse_items(items)
    var by: u64 = 0
    loop {
        if by >= flipped.len { break }
        teko::assert::is_true(teko::runtime::str_eq(expected, stamped_signature(rotate_items(flipped, by))))
        by++
    }
}
