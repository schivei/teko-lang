use teko::lexer
use teko::parser

// src/checker/typer.tks  (namespace 'teko::checker')
// Each check_* (E4/E5) EVOLVES into a type_*: the SAME checks (B.22 regimes, B.20
// `if`, B.15 `match` + exhaustiveness), but the producer BUILDS the typed node
// instead of returning a bare Type. Predicates (is_bool/is_integer/op_is_*),
// resolvers (resolve_type), env (lookup/define) and the pattern + exhaustiveness
// logic (check_pattern/exhaustive) are reused from their stages — re-derivation,
// not duplication (M.5). C1: every node, statement and item re-derived.


// ---- cast `to` (C2): a DEFINED conversion is allowed; loss is caught, never silent (M.1) ----
// Two-pronged — the ÷0/overflow/OOB lineage applied to conversions (homeostasis, Constitution §II):
//   • a CONSTANT operand the compiler can see out of range → COMPILE ERROR (fail early — M.1);
//   • a runtime value the compiler cannot see → the metal converts and the loss is caught at
//     runtime (debug-panic / release-defined, exactly like overflow) — that guard is CODEGEN's,
//     deferred (M.4). M.1 forbids only SILENT loss; a check/panic is not silent, so narrowing and
//     signed↔unsigned ARE allowed (the value might fit — M.0 keeps the metal conversion).
// Scoped to the seed's scalars: Bool casts and non-numeric casts are UNDEFINED (rejected). The
// native numeric set (B.38) — int↔int (incl 128), int↔float, float↔float — is ALL defined: the
// fit/loss is the runtime guard's (trunc toward zero, overflow/NaN/∞ → panic — §5). Decimal awaits
// its runtime; newtype↔base awaits `resolve_named` lowering a newtype to its base — both deferred
// (M.4). *(Redefines the early compile-forbid rule — see the Redefinitions Index; the prior rule
// over-applied M.1, forbidding what a guard makes non-silent.)*

/**
 * numint_fits — does the signed-magnitude literal `v` fit the target integer prim `k`? (B.38 —
 * the full int set is now u8..u64/i8..i64, the 128-bit surface types having been removed,
 * drop-128 2026-07-24.) Replaces the old i64-carrier `value_fits` (carrier-detoxed off i64,
 * §2.1). Floats are handled separately (`float_fits`); Bool is never a literal target. An
 * unsigned target rejects a negative `v` first, then gates the magnitude against its max; a
 * signed target gates the magnitude against its positive max (non-negative `v`) or against
 * `2^(w-1)` (negative `v` — the extra headroom that admits e.g. `i8::MIN = -128`, magnitude 128).
 *
 * @param v  the resolved literal carrier
 * @param k  the target integer prim kind
 * @return   true iff `v` is representable in `k`
 */
fn numint_fits(v: parser::NumInt, k: PrimKind) -> bool {
    if prim_is_float(k) { return false }   // an int literal does not fit a float type (N1/N2)
    if k == PrimKind::U8 { return !v.neg && v.mag <= 255 }
    if k == PrimKind::U16 { return !v.neg && v.mag <= 65535 }
    if k == PrimKind::U32 { return !v.neg && v.mag <= 4294967295 }
    if k == PrimKind::U64 { return !v.neg && v.mag <= 18446744073709551615 }
    if k == PrimKind::I8 { return if v.neg { v.mag <= 128 } else { v.mag <= 127 } }
    if k == PrimKind::I16 { return if v.neg { v.mag <= 32768 } else { v.mag <= 32767 } }
    if k == PrimKind::I32 { return if v.neg { v.mag <= 2147483648 } else { v.mag <= 2147483647 } }
    if k == PrimKind::I64 { return if v.neg { v.mag <= 9223372036854775808 } else { v.mag <= 9223372036854775807 } }
    false
}

/**
 * float_fits — does a constant FLOAT literal fit the target float prim? Seed ruling (§5): a
 * float constant is accepted into ANY float width — precision/range loss of float CONSTANTS is
 * permissive for now (the runtime/codegen rounding-loss note in §5 still applies). Tightening
 * `f32` over-range to a compile error is deferred (no fail-early for float consts yet).
 *
 * @param v  the constant float value (unused — every width currently accepts any value)
 * @param k  the target float prim kind
 * @return   whether `k` is a float prim
 */
fn float_fits(v: f64, k: PrimKind) -> bool { prim_is_float(k) }

// is `from -> to` a DEFINED conversion? Any integer↔integer is (the loss is runtime/codegen's,
// not a type error — B). Only genuinely-undefined conversions are rejected: Bool, and crossing
// to/from a non-numeric type. M.1 — no silent loss; M.3 — names the barrier. Reused by the
// counter-validation (E6-2) so the rule has ONE source of truth (M.5).
// byte casts AS u8 (B.36 "byte = u8 newtype"): byte's values ARE u8 values, so the effective
// PrimKind for range/cast rules is U8. Bool and non-numeric types have no cast kind (rejected).
// One source of truth (M.5) for cast_check + const_range_check.
fn cast_kind(t: Type) -> PrimKind | error {
    match t {
        Prim as p => {
            if p.kind == PrimKind::Bool { error { message = "bool casts are not defined in the seed" } }
            else { p.kind }
        }
        Byte => PrimKind::U8
        Ptr as p => cast_kind_of_ptr(p)
        _ => error { message = "cast not defined for this type in the seed (Named/Str/Slice/… — pending)" }
    }
}

/**
 * cast_kind_of_ptr — `cast_kind`'s `Ptr` arm: the arena address-carrier decision
 * (`docs/design/arena-em-teko.md` §2 P1 — "não existe cast `u64 -> ptr<byte>`, então nem o
 * caminho alocante é alcançável a partir de um endereço calculado"). `u64` is ABI-identical to
 * `void *` on every 64-bit target, so a `ptr<byte> <-> u64` pair carries `PrimKind::U64` into
 * `cast_check`'s generic "any numeric to any numeric is defined" rule, making the cast a
 * reinterpret rather than a conversion. Scoped NARROWLY to `ptr<byte>` (not every `ptr<T>`, and
 * not the opaque `ptr`): the arena's whole address surface is `u64`-carried bytes, and widening
 * this admission to arbitrary pointee types or the opaque pointer is outside what that decision
 * asked for.
 *
 * @param p  the resolved `Ptr` type (`p.inner` is the pointee, or `null` for the opaque `ptr`)
 * @return   `PrimKind::U64` when `p` is `ptr<byte>`; a NAMED error for every other pointer shape
 */
fn cast_kind_of_ptr(p: Ptr) -> PrimKind | error {
    match p.inner {
        Type as inner => match inner {
            Byte => PrimKind::U64
            _ => error { message = "cast not defined for this pointer's element type in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
        }
        null => error { message = "cast not defined for the opaque `ptr` in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
    }
}

/**
 * cast_ptr_partner_ok — when either cast endpoint is a `Ptr`, is the OTHER endpoint the ONE
 * partner the address-carrier decision admits (`docs/design/arena-em-teko.md` §2: `ptr<byte> <->
 * u64`, and ONLY that pairing)?
 *
 * WHY THIS EXISTS SEPARATELY FROM `cast_kind_of_ptr`. `cast_kind_of_ptr` answers `ptr<byte>` with
 * `PrimKind::U64` so the pair can ride `cast_check`'s generic "any numeric to any numeric is
 * defined" rule below — but that rule only ever sees the two `PrimKind`s, never the concrete
 * types they came from. Left alone, it would accept `ptr<byte> to i32` or `f64 to ptr<byte>` —
 * ANY numeric partner, not just `u64` — because `PrimKind::U64` reads as "some 64-bit-ish numeric"
 * to a rule that was written for genuine numeric-to-numeric pairs. P1 is a same-bit-pattern
 * REINTERPRET, not a machine conversion (`lir::lower_cast`'s `is_u64_ptr_byte_reinterpret_cast`
 * emits it as literally zero instructions), so a pairing that rule cannot honour must never
 * type-check in the first place. This checks the ACTUAL partner type, closing that gap before
 * `cast_kind` is ever consulted.
 *
 * @param from  the cast operand's resolved type
 * @param to    the cast target's resolved type
 * @return      `null` when NEITHER side is `Ptr` (the generic rule below decides it), or the one
 *              `Ptr` side's partner is exactly `u64`; a NAMED error for every other
 *              pointer-involving pairing (including pointer-to-pointer)
 * @since 0.3.1
 */
fn cast_ptr_partner_ok(from: Type, to: Type) -> error | null {
    let from_ptr = is_bare_ptr(from)
    let to_ptr = is_bare_ptr(to)
    if !from_ptr && !to_ptr { return null }
    if from_ptr && to_ptr {
        return error { message = "cast not defined between two pointer types in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
    }
    let partner = if from_ptr { to } else { from }
    if is_u64_prim(partner) { return null }
    error { message = "cast not defined for this pointer/numeric pairing in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
}

// is `t` (structurally) a `Ptr` — opaque `ptr` or any `ptr<T>`? `cast_ptr_partner_ok`'s own
// classifier; `cast_kind_of_ptr` still owns which POINTEE that `Ptr` may carry.
fn is_bare_ptr(t: Type) -> bool {
    match t { Ptr => true; _ => false }
}

// is `t` the resolved primitive `u64` — the ONE partner `cast_ptr_partner_ok` admits opposite a `Ptr`?
fn is_u64_prim(t: Type) -> bool {
    match t { Prim as p => p.kind == PrimKind::U64; _ => false }
}

// is `from -> to` a DEFINED conversion? Any integer/byte ↔ integer/byte is (the loss is
// runtime/codegen's — B; byte casts AS u8 — B.36). Only Bool and non-numeric ends are rejected.
// A `Ptr` endpoint is additionally pairwise-gated by `cast_ptr_partner_ok` (arena-em-teko.md §2 —
// see its own doc for why `cast_kind`'s `PrimKind::U64` answer for `ptr<byte>` is not, by itself,
// enough to keep this rule scoped to the one pairing that decision admits).
// Reused by the counter-validation (E6-2) — ONE source of truth (M.5).
fn cast_check(from: Type, to: Type) -> error | null {
    if type_eq(from, to) { return null }   // same type — a no-op
    match cast_ptr_partner_ok(from, to) { null => { }; error as e => return e }
    match cast_kind(from) { PrimKind => { }; error as e => return e }
    match cast_kind(to) { PrimKind => { }; error as e => return e }
    null   // any numeric/byte → any numeric/byte is defined (B; byte AS u8)
}

/**
 * const_range_check — a CONSTANT literal already out of the target's range is a compile error
 * (M.1 — fail early); non-constant operands are guarded at runtime by codegen. Direct literals
 * only (comptime folding deferred). Only the int-literal → int-target case is statically
 * range-checkable (B.38, u8..u64/i8..i64); float→int / int→float / float→float constant
 * conversions are runtime-guarded (trunc toward zero, overflow/NaN/∞ → panic — §5) — the checker
 * permits them, the fit is codegen/interpreter's.
 *
 * @param e       the candidate literal expression
 * @param target  the cast/annotation target type
 * @return        an error naming the out-of-range constant, or null when the fit is fine
 */
fn const_range_check(e: parser::Expr, target: Type) -> error | null {
    match e.kind {
        parser::Number as n => match cast_kind(target) {   // byte target → U8 range (0..255)
            PrimKind as k => {
                if n.is_float || !prim_is_int(k) { null }
                else if numint_fits(n.value, k) { null }
                else { error { message = "constant out of range for the cast target (M.1 — fail early)" } }
            }
            error => null   // non-numeric target: cast_check already rejected it
        }
        _ => null   // not a constant literal → runtime-guarded (codegen)
    }
}

// C6 — an annotated binding `let x: T = <value>` whose value type ≠ T. A numeric LITERAL ADOPTS T
// if it fits: the leaf stays i64 (stored AS-IS — Side D) and T lives in the binding's `bound`.
// The fit is proven HERE at type time via `value_fits`. A NON-literal mismatch is a hard error —
// no implicit conversion (M.2; use `to`). An out-of-range literal fails EARLY (M.1).
// NOTE: the counter-validation does NOT yet re-prove the binding-level fit — a forged typed tree
// `bound=u8, value=300` would currently pass revalidate. That re-proof lands with `validate_statement`
// (deferred; named gap — §VI). The front-line type check above already rejects such source.
fn annotated_literal_ok(value: parser::Expr, ann: Type) -> error | null {
    match value.kind {
        // an ARRAY LITERAL `[e0, e1, …]` annotated as `[]E` — adopts element-wise: every non-spread
        // element must itself be a fitting bare literal for E (recurses through nested arrays via
        // this same function). A spread element (`..xs`) is already a `[]T` value, not a literal —
        // skip it here (its own widen/adopt was checked at array-literal typing time). Mirrors
        // literal_adopts's TArrayLit case (the range-check side), which already recurses this way;
        // this is the RETYPING side's twin so `let a: []u8 = [1,2,3]` type-checks (#71).
        parser::ArrayLit as al => match ann {
            Slice as s => {
                mut i = 0
                mut result: error | null = null
                loop {
                    if i >= al.elements.len { break }
                    if !al.elements[i].is_spread {
                        match annotated_literal_ok(al.elements[i].expr, s.element) {
                            null => { }
                            error as e => { result = e; break }
                        }
                    }
                    i++
                }
                result
            }
            _ => error { message = "value type does not match annotation" }
        }
        parser::Unary as u => {
            if u.op == lexer::TokenKind::Minus {
                match u.operand.kind {
                    parser::Number as n => match ann {
                        Prim as p => {
                            if n.is_float {
                                if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type (B.38)" } }
                                else if float_fits(n.fval, p.kind) { null }
                                else { error { message = "float literal out of range for the annotated type (M.1 — fail early)" } }
                            } else {
                                if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                                else if !prim_is_signed(p.kind) { error { message = "a negative literal cannot be annotated as an unsigned type (M.1)" } }
                                else if numint_fits(n.value, p.kind) { null }
                                else { error { message = "literal out of range for the annotated type (M.1 — fail early)" } }
                            }
                        }
                        _ => error { message = "value type does not match annotation" }
                    }
                    _ => error { message = "value type does not match annotation" }
                }
            } else {
                error { message = "value type does not match annotation" }
            }
        }
        parser::Number as n => match ann {
            Prim as p => {
                if n.is_float {
                    // a float literal (3.14, 1.5e3) adopts a float annotation only (N2).
                    if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type (B.38)" } }
                    else if float_fits(n.fval, p.kind) { null }
                    else { error { message = "float literal out of range for the annotated type (M.1 — fail early)" } }
                } else {
                    // an integer literal adopts an integer annotation only; never a float type (N1).
                    if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                    else if numint_fits(n.value, p.kind) { null }
                    else { error { message = "literal out of range for the annotated type (M.1 — fail early)" } }
                }
            }
            _ => error { message = "value type does not match annotation" }
        }
        _ => error { message = "value type does not match annotation" }
    }
}
