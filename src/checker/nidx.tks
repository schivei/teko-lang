type NameSlot = struct {
    hash: u64
    pos: u64
}

type NameIndex = struct {
    slots: []NameSlot
}

fn nidx_empty(): NameIndex {
    NameIndex { slots = teko::list::empty() }
}

fn nidx_merge(left: []NameSlot, right: []NameSlot): []NameSlot {
    var out: []NameSlot = teko::list::empty()
    var i: u64 = 0
    var j: u64 = 0
    loop {
        if i >= left.len { break }
        if j >= right.len { break }
        if left[i].hash <= right[j].hash {
            out = teko::list::push(out, left[i])
            i++
            continue
        }
        out = teko::list::push(out, right[j])
        j++
    }
    loop { if i >= left.len { break }; out = teko::list::push(out, left[i]); i++ }
    loop { if j >= right.len { break }; out = teko::list::push(out, right[j]); j++ }
    out
}

fn nidx_msort(xs: []NameSlot, lo: u64, hi: u64): []NameSlot {
    var out: []NameSlot = teko::list::empty()
    if hi - lo <= 1 {
        if hi - lo == 1 { out = teko::list::push(out, xs[lo]) }
        return out
    }
    var mid = lo + (hi - lo) / 2
    var left = nidx_msort(xs, lo, mid)
    var right = nidx_msort(xs, mid, hi)
    nidx_merge(left, right)
}

fn nidx_sorted(slots: []NameSlot): []NameSlot {
    nidx_msort(slots, 0, slots.len)
}

fn nidx_build(names: []str): NameIndex {
    var slots: []NameSlot = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        slots = teko::list::push(slots, NameSlot { hash = teko::runtime::str_hash(names[i]); pos = i })
        i++
    }
    NameIndex { slots = nidx_sorted(slots) }
}

fn nidx_lower_bound(idx: NameIndex, h: u64): u64 {
    var lo: u64 = 0
    var hi: u64 = idx.slots.len
    loop {
        if lo >= hi { break }
        var mid = lo + (hi - lo) / 2
        if idx.slots[mid].hash < h { lo = mid + 1 } else { hi = mid }
    }
    lo
}
