#test fn borrow_summary_return_inside_adopt_is_found_alongside_break_continue() {
    var params = teko::list::push(teko::list::empty(), bw_param("r"))
    var adopt_body = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), bw_break()), bw_continue()), bw_return(bw_var("r", bw_ref(bw_i64()))))
