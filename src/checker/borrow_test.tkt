#test fn borrow_summary_destructure_binding_contributes_no_local() {
    var names = teko::list::push(teko::list::empty(), "x")
    var body = teko::list::push(teko::list::push(teko::list::empty(), bw_let_destructure(names, bw_var("r", bw_ref(bw_i64())))), bw_exprstmt(bw_var("x", bw_i64())))
    var sum = fn_borrow_summary(bw_fn(teko::list::empty(), body), bw_empty_table(), borrow_summary_env_empty())
    teko::assert::is_false(sum.returns_all)
    teko::assert::is_true(sum.returns_borrow_of.len == 0)
}

#test fn borrow_summary_env_distinguishes_multiple_callees_and_empty_path_is_total() {
    var sum_a = BorrowSummary { returns_borrow_of = teko::list::push(teko::list::empty(), 0 to u32); returns_all = false }
    var sum_b = BorrowSummary { returns_borrow_of = teko::list::empty(); returns_all = true }
    var env = borrow_summary_env_insert(borrow_summary_env_insert(borrow_summary_env_empty(), "t", "a", sum_a), "t", "b", sum_b)

    var params = teko::list::push(teko::list::empty(), bw_param("r"))
    var args = teko::list::push(teko::list::empty(), bw_var("r", bw_ref(bw_i64())))
    var call_a = bw_call("a", "t", args, Slice { element = bw_i64() })
    var body_a = teko::list::push(teko::list::empty(), bw_exprstmt(call_a))
    var result_a = fn_borrow_summary(bw_fn(params, body_a), bw_empty_table(), env)
    teko::assert::is_false(result_a.returns_all)
    teko::assert::is_true(result_a.returns_borrow_of.len == 1)

    var call_b = bw_call("b", "t", teko::list::empty(), bw_i64())
    var body_b = teko::list::push(teko::list::empty(), bw_exprstmt(call_b))
    var result_b = fn_borrow_summary(bw_fn(teko::list::empty(), body_b), bw_empty_table(), env)
    teko::assert::is_true(result_b.returns_all)

    var empty_path = TCall { overload_suffix = ""; callee = parser::Path { segments = teko::list::empty() }; args = teko::list::empty(); call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }
    teko::assert::is_true(call_last_segment(empty_path.callee) == "")
    teko::assert::is_true(call_target_key(empty_path) == "")
}
