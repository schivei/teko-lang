
use teko::lexer
use teko::parser

fn taf_num(v: u64): TExpr {
    TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; type = Prim { kind = PrimKind::I64 }; line = 0; col = 0 }
}

fn taf_bool(b: bool): TExpr {
    TExpr { kind = TBoolLit { value = b }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn taf_var(n: str): TExpr {
    TExpr { kind = TVar { name = n; is_func = false; func_ns = "" }; type = Prim { kind = PrimKind::I64 }; line = 0; col = 0 }
}

fn taf_cmp(a: TExpr, op: lexer::TokenKind, b: TExpr): TExpr {
    var term = TCmpTerm { op = op; operand = b }
    TExpr { kind = TCompare { first = a; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn taf_bin(a: TExpr, op: lexer::TokenKind, b: TExpr): TExpr {
    TExpr { kind = TBinary { op = op; left = a; right = b }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn taf_not(operand: TExpr): TExpr {
    TExpr { kind = TUnary { op = lexer::TokenKind::Bang; operand = operand }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn taf_path(name: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), parser::Segment { name = "teko" })
    segs = teko::list::push(segs, parser::Segment { name = "assert" })
    segs = teko::list::push(segs, parser::Segment { name = name })
    parser::Path { segments = segs }
}

fn taf_call(path: parser::Path, args: []TExpr): TExpr {
    TExpr { kind = TCall { overload_suffix = ""; callee = path; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

fn taf_assert(name: str, pred: TExpr): TExpr {
    taf_call(taf_path(name), teko::list::push(teko::list::empty(), pred))
}

fn taf_expr_stmt(e: TExpr): @TStatement() { TExprStmt { expr = e } }

fn taf_fn(body: []@TStatement()): TFunction {
    TFunction { overload_suffix = "";
        name = "t"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = teko::list::empty(); return_type = Void { }; body = body
        vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none(); namespace = "probe"
        file = ""; line = 0; col = 0; is_test = true; is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

#test
fn taf_logical_and_of_constants_folds() {
    var pred = taf_bin(taf_bool(true), lexer::TokenKind::AndAnd, taf_bool(false))
    teko::assert::is_true(predicate_folds_const(pred))
}

#test
fn taf_logical_and_with_runtime_does_not_fold() {
    var pred = taf_bin(taf_bool(true), lexer::TokenKind::AndAnd, taf_var("x"))
    teko::assert::is_false(predicate_folds_const(pred))
}

#test
fn taf_nonlogical_binary_runtime_does_not_fold() {
    var pred = taf_bin(taf_var("x"), lexer::TokenKind::Plus, taf_num(1))
    teko::assert::is_false(predicate_folds_const(pred))
}

#test
fn taf_not_of_constant_folds() {
    var pred = taf_not(taf_cmp(taf_num(1), lexer::TokenKind::EqEq, taf_num(1)))
    teko::assert::is_true(predicate_folds_const(pred))
}

#test
fn taf_stats_descends_into_loop() {
    var inner = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var loop_stmt: @TStatement() = TLoopStmt { label = ""; init = teko::list::empty(); body = inner }
    var stats = test_assert_stats(taf_fn(teko::list::push(teko::list::empty(), loop_stmt)))
    teko::assert::is_true(stats.total == 1)
    teko::assert::is_true(stats.folded == 1)
}

#test
fn taf_stats_descends_into_if() {
    var then_blk = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var else_blk = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_var("x"))))
    var if_expr = TExpr { kind = TIfExpr { cond = taf_var("c"); then_blk = then_blk; has_else = true; else_blk = else_blk }; type = Void { }; line = 0; col = 0 }
    var stats = test_assert_stats(taf_fn(teko::list::push(teko::list::empty(), taf_expr_stmt(if_expr))))
    teko::assert::is_true(stats.total == 2)
    teko::assert::is_true(stats.folded == 1)
}

#test
fn taf_stats_if_without_else() {
    var then_blk = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var if_expr = TExpr { kind = TIfExpr { cond = taf_var("c"); then_blk = then_blk; has_else = false; else_blk = teko::list::empty() }; type = Void { }; line = 0; col = 0 }
    var stats = test_assert_stats(taf_fn(teko::list::push(teko::list::empty(), taf_expr_stmt(if_expr))))
    teko::assert::is_true(stats.total == 1)
}

#test
fn taf_stats_descends_into_match() {
    var arm_body = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var arm = TArm { pattern = parser::WildcardPattern { }; has_when = false; guard = taf_var("g"); body = arm_body }
    var match_expr = TExpr { kind = TMatchExpr { subject = taf_var("s"); arms = teko::list::push(teko::list::empty(), arm) }; type = Void { }; line = 0; col = 0 }
    var stats = test_assert_stats(taf_fn(teko::list::push(teko::list::empty(), taf_expr_stmt(match_expr))))
    teko::assert::is_true(stats.total == 1)
}

#test
fn taf_stats_ignores_return_statement() {
    var body = teko::list::push(teko::list::empty(), TReturn { has_value = false; value = taf_num(0); values = teko::list::empty() })
    var stats = test_assert_stats(taf_fn(body))
    teko::assert::is_true(stats.total == 0)
}

#test
fn taf_stats_ignores_short_path_call() {
    var path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "foo" }) }
    var body = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_call(path, teko::list::push(teko::list::empty(), taf_bool(true)))))
    var stats = test_assert_stats(taf_fn(body))
    teko::assert::is_true(stats.total == 0)
}

#test
fn taf_stats_descends_into_defer() {
    var inner = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var body = teko::list::push(teko::list::empty(), TDeferStmt { body = inner })
    var stats = test_assert_stats(taf_fn(body))
    teko::assert::is_true(stats.total == 1)
}

#test
fn taf_stats_descends_into_adopt() {
    var inner = teko::list::push(teko::list::empty(), taf_expr_stmt(taf_assert("is_true", taf_bool(true))))
    var body = teko::list::push(teko::list::empty(), TAdoptStmt { name = ""; body = inner })
    var stats = test_assert_stats(taf_fn(body))
    teko::assert::is_true(stats.total == 1)
}
