use teko::parser

fn rt_i64(): @Type() { Prim { kind = PrimKind::I64 } }

fn rt_i64_lit(v: u64): TExpr {
    TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; type = rt_i64(); line = 0; col = 0 }
}

fn rt_var(name: str): TExpr {
    TExpr { kind = TVar { name = name; is_func = false; func_ns = "" }; type = rt_i64(); line = 0; col = 0 }
}

fn rt_let(name: str, value: TExpr): @TStatement() {
    TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = name }; bound = value.type; value = value }
}

fn rt_destructure(a: str, b: str, value: TExpr): @TStatement() {
    TBinding { kind = parser::BindKind::Let; target = parser::DestructurePattern { names = teko::list::push(teko::list::push(teko::list::empty(), a), b) }; bound = value.type; value = value }
}

fn rt_return(value: TExpr): @TStatement() { TReturn { has_value = true; value = value; values = teko::list::empty() } }

fn rt_loop(body: []@TStatement()): @TStatement() { TLoopStmt { label = ""; init = teko::list::empty(); body = body } }

fn rt_fn(body: []@TStatement()): TFunction {
    TFunction { overload_suffix = ""; name = "f"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = Void { }; body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = "t"; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn rt_is_scope(t: @ResidenceTier()): bool { match t { Scope => true; _ => false } }

fn rt_is_frame(t: @ResidenceTier()): bool { match t { Frame => true; _ => false } }

fn rt_is_caller(t: @ResidenceTier()): bool { match t { Caller => true; _ => false } }

fn rt_is_root(t: @ResidenceTier()): bool { match t { Root => true; _ => false } }

fn rt_is_unresolved(t: @ResidenceTier()): bool { match t { Unresolved => true; _ => false } }

fn rt_pt_param(): @PointsTo() { PtParam { id = PtParamId { index = 0 to u32 } } }

fn rt_pt_adopter(): @PointsTo() { PtAdopter { id = PtAdopterId { region = 0 to u32; top = false } } }

#test fn residence_tier_singleton_is_root() {
    teko::assert::is_true(rt_is_root(residence_tier(true, PtFrame { }, false, false)))
    teko::assert::is_true(rt_is_root(residence_tier(true, PtTop { }, true, true)))
}

#test fn residence_tier_ptroot_is_root() {
    teko::assert::is_true(rt_is_root(residence_tier(false, PtRoot { }, false, false)))
}

#test fn residence_tier_ptparam_is_caller() {
    teko::assert::is_true(rt_is_caller(residence_tier(false, rt_pt_param(), false, false)))
}

#test fn residence_tier_pttop_is_unresolved() {
    teko::assert::is_true(rt_is_unresolved(residence_tier(false, PtTop { }, false, false)))
}

#test fn residence_tier_frame_escaping_is_caller() {
    teko::assert::is_true(rt_is_caller(residence_tier(false, PtFrame { }, true, false)))
    teko::assert::is_true(rt_is_caller(residence_tier(false, rt_pt_adopter(), true, false)))
}

#test fn residence_tier_frame_block_local_is_scope() {
    teko::assert::is_true(rt_is_scope(residence_tier(false, PtFrame { }, false, true)))
}

#test fn residence_tier_frame_local_is_frame() {
    teko::assert::is_true(rt_is_frame(residence_tier(false, PtFrame { }, false, false)))
    teko::assert::is_true(rt_is_frame(residence_tier(false, rt_pt_adopter(), false, false)))
}

#test fn residence_plan_returned_local_moves_to_caller() {
    var body: []@TStatement() = teko::list::push(teko::list::empty(), rt_let("out", rt_i64_lit(3)))
    body = teko::list::push(body, rt_return(rt_var("out")))
    var plan = residence_plan(rt_fn(body))
    teko::assert::is_true(rt_is_caller(plan.bindings[0].tier))
    teko::assert::is_true(plan.returns.len == 1)
    teko::assert::is_true(plan.returns[0].is_move)
    teko::assert::is_true(rt_is_caller(plan.returns[0].tier))
}

#test fn residence_plan_loop_body_local_is_scope() {
    var inner = teko::list::push(teko::list::empty(), rt_let("tmp", rt_i64_lit(9)))
    var body = teko::list::push(teko::list::empty(), rt_loop(inner))
    var plan = residence_plan(rt_fn(body))
    teko::assert::is_true(plan.bindings.len == 1)
    teko::assert::is_true(plan.bindings[0].name == "tmp")
    teko::assert::is_true(rt_is_scope(plan.bindings[0].tier))
}

#test fn residence_plan_destructure_is_unresolved() {
    var body = teko::list::push(teko::list::empty(), rt_destructure("a", "b", rt_i64_lit(1)))
    var plan = residence_plan(rt_fn(body))
    teko::assert::is_true(rt_is_unresolved(plan.bindings[0].tier))
}

#test fn residence_plan_bare_return_is_not_move() {
    var body = teko::list::push(teko::list::empty(), TReturn { has_value = false; value = rt_i64_lit(0); values = teko::list::empty() })
    var plan = residence_plan(rt_fn(body))
    teko::assert::is_true(plan.returns.len == 1)
    teko::assert::is_false(plan.returns[0].is_move)
}
