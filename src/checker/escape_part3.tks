// src/checker/escape.tks   (namespace 'teko::checker')
//
// THE ESCAPE CHECK (MEM Step 1 — the memory-model keystone). A conservative, ONE-DEPTH,
// SECURITY-FIRST analysis over the typed AST: for one function it computes the set of LOCAL
// variable names that ESCAPE the frame. The codegen reads this to decide whether a heap
// allocation a function makes may be placed in a per-FUNCTION frame region (bulk-freed at
// every exit edge) or must outlive the frame (allocated in root → leaked, which is SAFE).
//
// SOUNDNESS IS THE ABSOLUTE RULE (M.1/M.5): never classify an escaping allocation as
// frame-local. When the analysis cannot PROVE an allocation is frame-local it is treated as
// ESCAPING (a leak is safe; a use-after-free is a vulnerability). The analysis is therefore
// intentionally INCOMPLETE — it frees only a provable subset.
//
// THE MODEL (no points-to graph — DEFERRED to a later, finer step):
//   * A variable ESCAPES if any read of it (a `TVar`) appears in an ESCAPING position.
//   * Escaping positions are: a `return` value; a TAIL expr-statement (an IMPLICIT RETURN — the
//     trailing value of a function body or of an if/match branch whose value is returned, which
//     codegen drop-then-returns: emit_block_tail/emit_exprstmt_tail); a call argument; a
//     struct-init field value; an array / interpolation / `in` element; an assignment RHS; a
//     binding RHS. (A call may retain its argument; a returned/stored value outlives the frame.)
//     ALL of these propagate the escaping context DOWN into their sub-expressions.
//   * The ONE refinement that lets a provable frame-local subset exist: reading a SCALAR field of
//     a BARE LOCAL (`x.f` where `x` is a `TVar` AND `x.f`'s resolved type is `Prim`/`byte`/`bool`)
//     yields a COPY of a STACK MEMBER — the struct local sits on the C stack and its scalar fields
//     are stack members (boxed recursive back-edge fields are NEVER scalar), so the read embeds NO
//     heap pointer and survives the frame-region drop. So `x` does NOT escape through that read.
//     Any OTHER receiver — a nested field access (`a.b.y`: `.y` is scalar but `a.b` is a boxed heap
//     hop), an index (`a[i]`: the element lives behind the slice's heap `.ptr`), a call result, a
//     cast, … — conservatively inherits the OUTER (possibly escaping) context, because evaluating
//     it dereferences an interior pointer (an auto-boxed back-edge / a heap-backed slice). The drop
//     happens BEFORE the tail value is evaluated, so EVERY sub-read of the tail value runs post-drop
//     — anything that derefs a frame-allocable cell must propagate escaping (UAF). When unsure,
//     propagate escaping (a leak is SAFE; a use-after-free is a vulnerability).
//
// A `let`/`mut x = StructInit{…}` binding is FRAME-LOCAL iff `x` is NOT in the escaping set:
// the struct value — and every heap cell auto-boxed inside it — dies with the frame, so the
// allocation may go in the frame region. This is the only allocation the codegen frame-routes.
use teko::parser
use teko::lexer


// walk an expr for STATEMENT BLOCKS embedded in if/match arms (bindings/assigns live there too).
fn chain_stats_expr(e: TExpr, name: str) -> ChainStats {
    match e.kind {
        TIfExpr as f => {
            mut s = chain_stats_expr(f.cond, name)
            s = cs_add(s, chain_stats_block(f.then_blk, name))
            if f.has_else { s = cs_add(s, chain_stats_block(f.else_blk, name)) }
            s
        }
        TMatchExpr as m => {
            mut s = chain_stats_expr(m.subject, name)
            mut i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cs_add(s, chain_stats_expr(m.arms[i].guard, name)) }
                s = cs_add(s, chain_stats_block(m.arms[i].body, name))
                i++
            }
            s
        }
        TBinary as b => cs_add(chain_stats_expr(b.left, name), chain_stats_expr(b.right, name))
        TUnary as u => chain_stats_expr(u.operand, name)
        TCompare as c => {
            mut s = chain_stats_expr(c.first, name)
            mut i = 0
            loop { if i >= c.rest.len { break }; s = cs_add(s, chain_stats_expr(c.rest[i].operand, name)); i++ }
            s
        }
        TCall as call => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= call.args.len { break }; s = cs_add(s, chain_stats_expr(call.args[i], name)); i++ }
            s
        }
        TCast as ct => chain_stats_expr(ct.expr, name)
        TFieldAccess as fa => chain_stats_expr(fa.receiver, name)
        TIndex as ix => cs_add(chain_stats_expr(ix.receiver, name), chain_stats_expr(ix.index, name))
        TStructInit as si => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= si.field_vals.len { break }; s = cs_add(s, chain_stats_expr(si.field_vals[i], name)); i++ }
            s
        }
        TArrayLit as al => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= al.elements.len { break }; s = cs_add(s, chain_stats_expr(al.elements[i].expr, name)); i++ }
            s
        }
        TInterp as ip => {
            mut s = cs_zero()
            mut i = 0
            loop {
                if i >= ip.holes.len { break }
                s = cs_add(s, chain_stats_expr(ip.holes[i], name))
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            mut k = 0
                            loop { if k >= fd.args.len { break }; s = cs_add(s, chain_stats_expr(fd.args[k], name)); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            s
        }
        TInExpr as ine => {
            mut s = chain_stats_expr(ine.lhs, name)
            mut i = 0
            loop { if i >= ine.elems.len { break }; s = cs_add(s, chain_stats_expr(ine.elems[i], name)); i++ }
            s
        }
        _ => cs_zero()   // leaves + TLambda (its body is a LIFTED fn — not this frame's chain)
    }
}

fn chain_stats_stmt(s: TStatement, name: str) -> ChainStats {
    match s {
        TBinding as b => {
            mut st = chain_stats_expr(b.value, name)
            match b.target {
                parser::SimpleName as sn => {
                    if sn.name == name {
                        if binding_value_is_list_empty(b) { st = cs_add(st, ChainStats { births_empty = 1; births_other = 0; other_writes = 0; self_appends = 0 }) }
                        else { st = cs_add(st, ChainStats { births_empty = 0; births_other = 1; other_writes = 0; self_appends = 0 }) }
                    }
                }
                parser::DestructurePattern => { }
            }
            st
        }
        TAssign as a => {
            mut st = chain_stats_expr(a.value, name)
            if parser::assign_has_target(a.kind) { st = cs_add(st, chain_stats_expr(a.target, name)) }
            if a.name == name {
                if assign_is_self_append(a) { st = cs_add(st, ChainStats { births_empty = 0; births_other = 0; other_writes = 0; self_appends = 1 }) }
                else { st = cs_add(st, ChainStats { births_empty = 0; births_other = 0; other_writes = 1; self_appends = 0 }) }
            }
            st
        }
        TReturn as r => if r.has_value { chain_stats_expr(r.value, name) } else { cs_zero() }
        TExprStmt as es => chain_stats_expr(es.expr, name)
        TLoopStmt as l => cs_add(chain_stats_block(l.init, name), chain_stats_block(l.body, name))
        TBreakStmt => cs_zero()
        TContinueStmt => cs_zero()
        TDeferStmt as d => chain_stats_block(d.body, name)
        TAdoptStmt as a => chain_stats_block(a.body, name)
    }
}

fn chain_stats_block(body: []TStatement, name: str) -> ChainStats {
    mut s = cs_zero()
    mut i: u64 = 0
    loop { if i >= body.len { break }; s = cs_add(s, chain_stats_stmt(body[i], name)); i++ }
    s
}

/**
 * name_escapes_body — does `name` escape the frame of the function whose body is `fn_body`? Computed
 * with the SAME walk `fn_escaping_vars` runs (tail-position analysis + self-append base carve-out), so
 * the answer matches the escaping set both codegen engines already consult. Used by `assign_frees_old`
 * to DENY free-old to an escaping accumulator: an escaping self-append's grow is conveyed to the
 * caller's region (root scope, `tk_cur_rsp == 0`), the one scope where `tk_slice_push_fo` parks the
 * superseded buffer on the root free-list — but the escaped value still reaches that buffer, so the
 * park is a use-after-park UAF (measured as a paranoid redzone stomp / SIGSEGV at scale, in
 * `copy_relocs_to_current_region_*` and every other escaping accumulator). Only FRAME-LOCAL
 * accumulators (grown at `tk_cur_rsp > 0`) may safely free-old.
 *
 * @param fn_body  the whole function body (the escape-analysis scope)
 * @param name     the accumulator name to test
 * @return         whether `name` escapes the frame
 * @since 0.3.1 (escaping-exclusion UAF fix)
 */
fn name_escapes_body(fn_body: []TStatement, name: str) -> bool {
    mut esc: []str = teko::list::empty()
    mark_block(fn_body, true, esc)
    str_set_has(esc, name)
}

// assign_frees_old — may THIS self-append's copy-grow PARK the old buffer for reuse? True iff the
// whole-fn linear-chain proof above holds for the assigned name AND the name is frame-local (an
// escaping accumulator is denied — see name_escapes_body). PUBLIC (codegen reads it).
pub fn assign_frees_old(fn_body: []TStatement, a: TAssign) -> bool {
    if !assign_is_self_append(a) { return false }
    if name_escapes_body(fn_body, a.name) { return false }
    let st = chain_stats_block(fn_body, a.name)
    if st.births_empty != 1 { return false }   // born exactly once, from empty()
    if st.births_other != 0 { return false }   // no shadow / no aliasing rebirth
    if st.other_writes != 0 { return false }   // writes are self-append only
    let total = count_reads_block(fn_body, a.name)
    if fn_body.len == 0 { return false }
    let last_reads = count_reads_stmt(fn_body[fn_body.len - 1], a.name)
    let last_st = chain_stats_stmt(fn_body[fn_body.len - 1], a.name)
    if last_st.self_appends > 0 {
        // the FINAL statement itself pushes (a tail loop/match building the chain): a capture inside
        // it could precede a later push ON THE SAME PATH — unprovable syntactically. Allow only when
        // its reads are EXACTLY its own self-append bases (no capture there at all).
        if last_reads != last_st.self_appends { return false }
        return total == st.self_appends
    }
    total - last_reads == st.self_appends   // every non-final read is a self-append base
}

// binding_is_frame_local_slice — (S2 Level-1) a SLICE binding whose buffer never leaves the frame:
// a `let`/`mut` SIMPLE name, NOT const, NOT in the escaping set, whose bound type is a slice. Unlike
// the struct-init predicate the value need not be an allocation site — a slice accumulator is BUILT
// by later `xs = push(xs, …)` self-appends (each routed to the frame region); this predicate marks
// that the frame is NEEDED and the name is a non-escaping slice. PUBLIC (the codegen reads it).
pub fn binding_is_frame_local_slice(escaping: []str, b: TBinding) -> bool {
    let name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if name == "_" { return false }
    if b.kind == parser::BindKind::Const { return false }
    if str_set_has(escaping, name) { return false }
    match b.bound {
        Slice => true
        _ => false
    }
}
