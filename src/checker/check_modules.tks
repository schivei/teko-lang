// src/checker/check_modules.tks  (namespace 'teko::checker') — W-vis-enforce.
//
// The MODULE-SYSTEM enforcement pass. A dedicated walk over the flattened program: it reads
// each item's source namespace (A3 provenance) directly, so it threads NO namespace context
// through the typing chain. It builds the `use` alias map from the use-items and checks every
// decl's TYPE references, enforcing:
//   * a BARE reference to a type in ANOTHER namespace is an error (qualify it, M.3/M.2);
//   * a QUALIFIED reference to a PRIVATE type (not pub/exp) in another namespace is an error (B.9);
//   * a qualified reference with an unbound alias, or naming the wrong namespace, is an error.
// Same-namespace refs stay bare; builtins are never namespaced. (Value-level refs — call
// callees, enum-member paths — are a follow-on increment; this covers the dominant TYPE surface.)

use teko::parser

// an alias binding: within namespace `ns`, the name `alias` refers to namespace `target`.
type AliasBind = struct { ns: str; alias: str; target: str }

// join the first `n` segments of a path with "::" (n = segments.len → the full namespace;
// n = segments.len - 1 → the prefix before the final symbol).
fn join_n(p: parser::Path, n: u64): str {
    if n == 0 { return "" }
    var s = ""
    var i = 0
    loop {
        if i >= n { break }
        s = teko::str::concat(s, p.segments[i].name)
        if i + 1 < n { s = teko::str::concat(s, "::") }
        i++
    }
    s
}

// build the alias map from every use-item (file-local `use`, B.32).
fn build_aliases(prog: parser::Program): []AliasBind {
    var a: []AliasBind = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i].content {
            parser::UseDecl as u => {
                if u.names.len == 0 && u.path.segments.len > 0 {
                    var alias = if u.has_alias { u.alias } else { u.path.segments[u.path.segments.len - 1].name }
                    a = teko::list::push(a, AliasBind { ns = prog.items[i].namespace; alias = alias; target = join_n(u.path, u.path.segments.len) })
                }
            }
            _ => { }
        }
        i++
    }
    a
}

// resolve an alias used in `ref_ns` → its target namespace ("" if unbound).
fn alias_target(a: []AliasBind, ref_ns: str, alias: str): str {
    var i = 0
    loop {
        if i >= a.len { break }
        if a[i].ns == ref_ns && a[i].alias == alias { return a[i].target }
        i++
    }
    ""
}

/**
 * find_in_ns — the type registration named `name` declared in namespace `ns`, or null if none.
 * Probes the `by_last` index (`tt_cands`) with the same exact name + namespace predicate the
 * linear scan used.
 *
 * @param table  the folded type table
 * @param name   the sought bare type name
 * @param ns     the namespace the registration must be declared in
 * @return       the matching registration, or null when none matches
 */
fn find_in_ns(table: TypeTable, name: str, ns: str): TypeReg | null {
    var cands = tt_cands(table, name)
    var i: u64 = 0
    loop {
        if i >= cands.count { break }
        var r = tt_cand_reg(table, cands, i)
        if r.name == name && r.namespace == ns { return r }
        i++
    }
    null
}

/**
 * name_exists_anywhere — does ANY registration in `table` carry the exact name `name`, in any
 * namespace? Probes the `by_last` index (`tt_cands`) with the same exact-name predicate.
 *
 * @param table  the folded type table
 * @param name   the sought bare type name
 * @return       true iff at least one registration is named `name`
 */
fn name_exists_anywhere(table: TypeTable, name: str): bool {
    var cands = tt_cands(table, name)
    var i: u64 = 0
    loop {
        if i >= cands.count { break }
        if tt_cand_reg(table, cands, i).name == name { return true }
        i++
    }
    false
}

/**
 * qualifier_names_enclosing_ns — does a single-segment type-reference prefix name the file's OWN
 * enclosing namespace? A namespace may qualify its own members `ns::X` from within `ns` without a
 * self-`use` (owner ruling, §9.D sweep): the actual resolver already matches `ns::X` by namespace
 * (`type_ref_ns`/`qualifier_selects_ns`), so this teaches the namespace-rules linter the same — the
 * prefix `ns` is the last segment of the enclosing namespace path `ref_ns` (e.g. `checker` for
 * `teko::checker`).
 *
 * @param qualifier  the written single-segment prefix (`path.segments[0].name`)
 * @param ref_ns     the fully-qualified namespace the reference is written in
 * @return           true iff the prefix names the enclosing namespace itself
 * @since            §9.D sweep (self-qualification without a self-`use`)
 */
fn qualifier_names_enclosing_ns(qualifier: str, ref_ns: str): bool {
    qualifier == name_last_segment(ref_ns)
}

/**
 * check_named — check ONE `Named` type reference (its path) used inside namespace `ref_ns`. A
 * BUILT-IN name (`u8`…/`str`/`byte`/`error`) is never namespaced and passes immediately; a name the
 * built-in table rejects outright (a removed 128-bit type) also passes here, since the resolver
 * reports it with its own message.
 *
 * @param path    the written type path
 * @param ref_ns  the namespace the reference is written in
 * @param table   the collected type table
 * @param al      the file's alias bindings
 * @return        an error when the reference violates the namespace rules, else null
 */
fn check_named(path: parser::Path, ref_ns: str, table: TypeTable, al: []AliasBind): error | null {
    if path.segments.len == 0 { return null }
    var last = path.segments[path.segments.len - 1].name
    match builtin_type(last) { Type => return null; NotBuiltinType => { }; error => { } }

    if path.segments.len == 1 {   // BARE
        match find_in_ns(table, last, ref_ns) { TypeReg => return null; null => { } }   // same-ns: bare is correct
        if name_exists_anywhere(table, last) {
            return error { message = "bare cross-namespace type reference — qualify it (`ns::Type`, with `use teko::ns`) or use the absolute path" }
        }
        return null   // unknown name → the normal resolver reports it
    }

    // QUALIFIED / ABSOLUTE: resolve the target namespace.
    var target_ns = ""
    if path.segments.len == 2 {   // single-segment prefix = a `use` alias, or the file's OWN namespace
        target_ns = alias_target(al, ref_ns, path.segments[0].name)
        if target_ns == "" {
            if qualifier_names_enclosing_ns(path.segments[0].name, ref_ns) {
                target_ns = ref_ns
            } else {
                return error { message = "qualified type reference with an unbound alias — add `use teko::<ns>` (the prefix binds nothing)" }
            }
        }
    } else {
        target_ns = join_n(path, path.segments.len - 1)   // absolute: teko::a::b::Type → "teko::a::b"
    }

    match find_in_ns(table, last, target_ns) {
        TypeReg as reg => {
            if target_ns != ref_ns && reg.vis == parser::Visibility::Private {   // cross-ns requires pub/exp (B.9)
                return error { message = "cross-namespace reference to a private type — mark the type `pub` (or `exp`)" }
            }
            return null
        }
        null => { }
    }
    if name_exists_anywhere(table, last) {
        return error { message = "qualified type reference names the wrong namespace — the type is declared elsewhere" }
    }
    null   // unknown → the normal resolver reports it
}

// walk a type expression, checking every Named leaf.
fn check_texpr(te: @TypeExpr(), ref_ns: str, table: TypeTable, al: []AliasBind): error | null {
    match te {
        parser::NamedType as n => check_named(n.path, ref_ns, table, al)
        parser::SliceType as s => check_texpr(s.element, ref_ns, table, al)
        parser::UnionType as u => {
            var i = 0
            loop {
                if i >= u.members.len { break }
                match check_texpr(u.members[i], ref_ns, table, al) { null => { }; error as e => return e }
                i++
            }
            null
        }
        parser::FunctionType as fnt => {   // (W10a) check every param + the return
            var i = 0
            loop {
                if i >= fnt.params.len { break }
                match check_texpr(fnt.params[i], ref_ns, table, al) { null => { }; error as e => return e }
                i++
            }
            check_texpr(fnt.ret, ref_ns, table, al)
        }
        parser::MacroType => null
    }
}

/**
 * check_flags_member_cap — a `flags` type declares no type-exprs to validate (C8.3), but its
 * bit-value carrier is a u64 (drop-128, 2026-07-24): bit 63 is the last representable power of
 * two, so a flags type is capped at 64 members regardless of whether any member is ever
 * referenced via `Type::Member` (codegen emits every member's `1 << i` unconditionally, so this
 * declaration-time cap is required, not just the access-time one in
 * `typer.tks::type_ns_qualified_value`).
 *
 * @param fb  the flags type's body (its declared member names)
 * @return    an error when the cap is exceeded, else `null`
 * @throws    when `fb.members.len` exceeds 64
 */
fn check_flags_member_cap(fb: parser::FlagsBody): error | null {
    if fb.members.len > 64 {
        return error { message = "a flags type may declare at most 64 members (bit 63 is the last) — write this as two flags types instead" }
    }
    null
}

/**
 * THE PASS: check every declaration's type-references (params/return for functions;
 * fields/variant member/method signatures for type declarations).
 *
 * A SOFT boundary in the all-diagnostics ruling (docs/design/all-diagnostics-pre-walk-0.3.1.md
 * §3): this pass produces NOTHING the next pass reads — it only validates — so it collects every
 * declaration's diagnostic and the build carries straight on into the item walk, instead of one bad
 * type reference masking the rest of the program.
 *
 * @param prog   the flattened program
 * @param table  the collected type table
 * @return       every module-system diagnostic, in program order (empty when the program is clean)
 */
fn check_modules(prog: parser::Program, table: TypeTable): []str {
    var al = build_aliases(prog)
    var diags: []str = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        diags = concat_diags(diags, item_module_diags(prog.items[i], table, al))
        i++
    }
    diags
}

/**
 * The module-system diagnostics ONE top-level item contributes. A `use` item and a loose statement
 * declare no type reference of their own and contribute none.
 *
 * @param it     the top-level item
 * @param table  the collected type table
 * @param al     the file's alias bindings
 * @return       the item's diagnostics, in declaration order
 * @since 0.3.1
 */
fn item_module_diags(it: parser::Item, table: TypeTable, al: []AliasBind): []str {
    match it.content {
        parser::Function as f => concat_diags(arity_decl_diags(it, f.line, f.col, f.type_params.len), fn_module_diags(it, f, table, al))
        parser::TypeDecl as d => {
            var ds = arity_decl_diags(it, d.line, d.col, d.type_params.len)   // the TYPE's own type-params
            ds = concat_diags(ds, type_method_arity_diags(it, d))             // each of its methods' type-params
            concat_diags(ds, type_module_diags(it, d, table, al))
        }
        _ => teko::list::empty()
    }
}

/**
 * The arity-cap diagnostic for ONE generic DECLARATION: a type/function/method that declares MORE than
 * `max_generic_arity()` type-parameters is an honest error (the shared generic-arity guard — owner
 * ruling). A declaration within the cap contributes nothing, so every existing declaration is unchanged.
 *
 * @param it    the declaring item (source file for the located diagnostic)
 * @param line  the declaration's line
 * @param col   the declaration's column
 * @param n     the number of declared type-parameters
 * @return      the located diagnostic when `n` exceeds the cap, else an empty list
 */
fn arity_decl_diags(it: parser::Item, line: u32, col: u32, n: u64): []str {
    if n <= max_generic_arity() { return teko::list::empty() }
    one_diag(located_diag(it.file, line, col, error { message = "a generic may declare at most 16 type parameters" }))
}

/**
 * The arity-cap diagnostics for every METHOD of a type declaration — a struct/class method that declares
 * more than `max_generic_arity()` type-parameters is an honest error, exactly like a free function or the
 * enclosing type. Non-struct/class bodies carry no methods here and contribute nothing.
 *
 * @param it  the declaring item
 * @param d   the type declaration
 * @return    each over-arity method's located diagnostic, in declaration order
 */
fn type_method_arity_diags(it: parser::Item, d: parser::TypeDecl): []str {
    var ms = instance_methods_of(d)
    var diags: []str = teko::list::empty()
    var i = 0
    loop {
        if i >= ms.len { break }
        diags = concat_diags(diags, arity_decl_diags(it, ms[i].line, ms[i].col, ms[i].type_params.len))
        i++
    }
    diags
}

/**
 * The located diagnostic ONE type-expression contributes, or none when it is legal.
 *
 * (C1-POS/C1.8/E2) The inner error's own line/col wins over the declaration's, and the message is
 * baked to `file:line:col: …` (W-loc-2) so the driver prints WHERE even when it cannot read the
 * source back.
 *
 * @param it     the declaring item (its source file and namespace)
 * @param line   the declaration's line, used when the error carries none
 * @param col    the declaration's column, used when the error carries none
 * @param te     the type-expression to check
 * @param table  the table to resolve against (WITH type-params in scope, where the caller has them)
 * @param al     the file's alias bindings
 * @return       the diagnostic, or an empty list
 * @since 0.3.1
 */
fn texpr_module_diags(it: parser::Item, line: u32, col: u32, te: @TypeExpr(), table: TypeTable, al: []AliasBind): []str {
    match check_texpr(te, it.namespace, table, al) {
        error as e => one_diag(located_diag(it.file, line, col, e))
        null => teko::list::empty()
    }
}

/**
 * A top-level function's type references: every parameter annotation, then the return type. (S4)
 * The function's generic type-params enter the table as local types of the using namespace, so a
 * signature written in terms of `T` checks against `T` rather than reporting it unqualified.
 *
 * @param it     the function's item
 * @param f      the parsed function
 * @param table  the collected type table
 * @param al     the file's alias bindings
 * @return       the function's diagnostics, in signature order
 * @since 0.3.1
 */
fn fn_module_diags(it: parser::Item, f: parser::Function, table: TypeTable, al: []AliasBind): []str {
    var ftbl = type_param_table(f.type_params, f.type_constraints, it.namespace, table)
    var diags: []str = teko::list::empty()
    var p = 0
    loop {
        if p >= f.params.len { break }
        diags = concat_diags(diags, texpr_module_diags(it, f.line, f.col, f.params[p].type_ann, ftbl, al))
        p++
    }
    if !f.has_return { return diags }
    concat_diags(diags, texpr_module_diags(it, f.line, f.col, f.return_type, ftbl, al))
}

/**
 * A type declaration's type references, per body kind: a struct's and a class's FIELDS (W10b.CLASS
 * — a class's methods are checked where a struct's are, at the item walk), a variant's member, an
 * alias's right-hand side, a flags type's member cap, an interface's method SIGNATURES (W10b.IF —
 * each typed param plus the return), and a trait's fields AND method signatures (TR0 — a trait is
 * struct-shaped with interface-shaped signatures). An enum declares no type-expression and a
 * `#extern` handle is opaque (C7.1a) — both contribute none.
 *
 * @param it     the declaration's item
 * @param d      the parsed type declaration
 * @param table  the collected type table
 * @param al     the file's alias bindings
 * @return       the declaration's diagnostics, in declaration order
 * @since 0.3.1
 */
fn type_module_diags(it: parser::Item, d: parser::TypeDecl, table: TypeTable, al: []AliasBind): []str {
    match d.body {
        parser::StructBody as sb => fields_module_diags(it, d, sb.fields, table, al)
        parser::VariantBody as vb => texpr_module_diags(it, d.line, d.col, vb.type_expr, table, al)
        parser::AliasBody as ab => texpr_module_diags(it, d.line, d.col, ab.alias, table, al)
        parser::FlagsBody as fb => flags_cap_diags(it, d, fb)
        parser::ClassBody as cb => fields_module_diags(it, d, cb.fields, table, al)
        parser::InterfaceBody as ib => method_sigs_module_diags(it, d, ib.methods, table, al)
        parser::TraitBody as trb => concat_diags(fields_module_diags(it, d, trb.fields, table, al), method_sigs_module_diags(it, d, trb.methods, table, al))
        _ => teko::list::empty()
    }
}

/**
 * The declared-member cap of a `flags` type, as a located diagnostic list.
 *
 * @param it  the declaration's item
 * @param d   the parsed type declaration
 * @param fb  the flags body
 * @return    the cap diagnostic, or an empty list
 * @since 0.3.1
 */
fn flags_cap_diags(it: parser::Item, d: parser::TypeDecl, fb: parser::FlagsBody): []str {
    match check_flags_member_cap(fb) {
        error as e => one_diag(located_diag(it.file, d.line, d.col, e))
        null => teko::list::empty()
    }
}

/**
 * Every field annotation of a struct/class/trait body, in declaration order.
 *
 * @param it      the declaration's item
 * @param d       the parsed type declaration
 * @param fields  the body's fields
 * @param table   the collected type table
 * @param al      the file's alias bindings
 * @return        the fields' diagnostics, in declaration order
 * @since 0.3.1
 */
fn fields_module_diags(it: parser::Item, d: parser::TypeDecl, fields: []parser::Field, table: TypeTable, al: []AliasBind): []str {
    var diags: []str = teko::list::empty()
    var k = 0
    loop {
        if k >= fields.len { break }
        diags = concat_diags(diags, texpr_module_diags(it, d.line, d.col, fields[k].type_ann, table, al))
        k++
    }
    diags
}

/**
 * Every method SIGNATURE of an interface or trait body: each explicitly typed parameter, then the
 * return type. An untyped parameter is a receiver, not an annotation, and is skipped.
 *
 * @param it       the declaration's item
 * @param d        the parsed type declaration
 * @param methods  the body's method signatures
 * @param table    the collected type table
 * @param al       the file's alias bindings
 * @return         the signatures' diagnostics, in declaration order
 * @since 0.3.1
 */
fn method_sigs_module_diags(it: parser::Item, d: parser::TypeDecl, methods: []parser::Function, table: TypeTable, al: []AliasBind): []str {
    var diags: []str = teko::list::empty()
    var mi = 0
    loop {
        if mi >= methods.len { break }
        diags = concat_diags(diags, one_method_sig_module_diags(it, d, methods[mi], table, al))
        mi++
    }
    diags
}

/**
 * ONE method signature's type references: each explicitly typed parameter, then the return type.
 *
 * @param it     the declaration's item
 * @param d      the parsed type declaration
 * @param m      the method signature
 * @param table  the collected type table
 * @param al     the file's alias bindings
 * @return       the signature's diagnostics, in signature order
 * @since 0.3.1
 */
fn one_method_sig_module_diags(it: parser::Item, d: parser::TypeDecl, m: parser::Function, table: TypeTable, al: []AliasBind): []str {
    var diags: []str = teko::list::empty()
    var pi = 0
    loop {
        if pi >= m.params.len { break }
        if m.params[pi].has_type {
            diags = concat_diags(diags, texpr_module_diags(it, d.line, d.col, m.params[pi].type_ann, table, al))
        }
        pi++
    }
    if !m.has_return { return diags }
    concat_diags(diags, texpr_module_diags(it, d.line, d.col, m.return_type, table, al))
}
