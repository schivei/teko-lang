// src/checker/escape_b.tks  (namespace 'teko::checker')

use teko::lexer
use teko::parser

 * block's TRAILING value is RETURNED (the function/branch tail) — codegen drops the frame region
 * BEFORE that value and `return`s it (`emit_block_tail`/`emit_exprstmt_tail`), so the last
 * statement, when it is a value-bearing expr-statement, must be analysed in an ESCAPING context
 * (MEM Step 1 UAF fix). All NON-last statements are interior (`tail = false`). A `tail = false`
 * block (a loop/defer body, or a discarded if/match branch) discards its trailing value.
 *
 * @param body  the statement block to walk
 * @param tail  true iff the block's trailing value is returned
 * @param acc   the escaping-name accumulator (by-reference, write-through, grown in place)
 */
fn mark_block(body: []TStatement, tail: bool, ref acc: []str) -> void {
    mut i = 0
    loop {
        if i >= body.len { break }
        let is_last = i + 1 == body.len
        mark_stmt(body[i], tail && is_last, acc)
        i++
    }
}

/**
 * Walks one statement, establishing the escaping context per position. `tail` is TRUE only for
 * the block's LAST statement when that block's trailing value is returned: an expr-statement
 * there is an IMPLICIT RETURN (B.20/W5a) whose value codegen produces AFTER dropping the frame
 * region, so it must be ESCAPING (not discarded).
 *
 * @param s     the statement to walk
 * @param tail  true iff `s` is the block's last statement and its trailing value is returned
 * @param acc   the escaping-name accumulator (by-reference, write-through, grown in place)
 */
fn mark_stmt(s: TStatement, tail: bool, ref acc: []str) -> void {
    match s {
        // a binding RHS escapes (the value lives on through the bound name; conservatively the
        // name may itself later escape — we do not run a second fixpoint pass).
        TBinding as b => mark_expr(b.value, true, acc)
        // an assignment RHS escapes (it may be written into an outer/captured location). (#88) a FIELD
        // write stores into an object that OUTLIVES the frame (a class is cell-backed; a struct field
        // write escapes through its `mut` root), so the receiver's reads are escaping too.
        TAssign as a => {
            // (S2 Level-1) SELF-APPEND carve-out: `xs = teko::list::push(xs, item)` grows xs in place —
            // the base read of xs is CONSUMED by the write-back (the old buffer is copied into the grown
            // one and replaced), so it does NOT escape through this statement. Mark ONLY the appended
            // item (still conservatively escaping); leaving the base UNmarked lets a non-escaping
            // accumulator be proven frame-local (single-pass, no fixpoint — item stays over-marked, which
            // is always safe). Any OTHER read of xs (return/arg/alias/index) still marks it escaping via
            // its own position, so a truly-escaping accumulator is never frame-routed.
            if assign_is_self_append(a) {
                mark_expr(self_append_item(a), true, acc)
            } else {
                mark_expr(a.value, true, acc)
                if parser::assign_has_target(a.kind) { mark_expr(a.target, true, acc) }
            }
        }
        // a return value escapes the frame entirely.
        TReturn as r => if r.has_value { mark_expr(r.value, true, acc) } else { }
        // an expression-statement: DISCARDED (value unused → NON-escaping) UNLESS it is in TAIL
        // position, where it is an implicit RETURN whose value escapes the frame (codegen
        // drop-then-returns it). Nested calls/returns inside still escape via their own positions.
        TExprStmt as es => mark_expr(es.expr, tail, acc)
        // a loop body's trailing expr is NOT a return (a loop exits via break) → NON-tail.
        TLoopStmt as l => { mark_block(l.init, false, acc); mark_block(l.body, false, acc) }
        TBreakStmt => { }
        TContinueStmt => { }
        // a defer body's trailing expr is run for effect, NOT a return → NON-tail.
        TDeferStmt as d => mark_block(d.body, false, acc)
        TAdoptStmt as a => mark_block(a.body, false, acc)
    }
}

// fn_escaping_vars — the per-function escape set: every local that outlives the frame. PUBLIC:
// the codegen (both engines) and the checker test read it. A function's PARAMETERS are immutable
// inputs (B.21) and never frame-allocated here, so they need no entry. The body is analysed in
// TAIL position: its trailing value-bearing expr-statement is an IMPLICIT RETURN (escaping).
pub fn fn_escaping_vars(f: TFunction) -> []str {
    mut acc: []str = teko::list::empty()
    mark_block(f.body, true, acc)
    acc
}

// binding_is_frame_local — does this binding's value allocate into the frame region? True iff
// it is a `let`/`mut` to a SIMPLE name that is NOT in the escaping set AND whose value is a
// struct-init (the only codegen allocation site that can be frame-routed — the auto-boxed
// recursive back-edge). A `const`, a destructure, a discard (`_`), an escaping name, or any
// non-struct-init value is NOT frame-local (→ allocates in root, the safe default). PUBLIC.
pub fn binding_is_frame_local(escaping: []str, b: TBinding) -> bool {
    let name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if name == "_" { return false }
    if b.kind == parser::BindKind::Const { return false }
    if str_set_has(escaping, name) { return false }
    match b.value.kind {
        TStructInit => true
        _ => false
    }
}

// (S2 Level-1) tcall_is_list_push — is this call `…::list::push(base, item)`, the one true grow
// intrinsic? Matched by the path tail (`list`, `push`) so any spelling of the namespace works.
fn tcall_is_list_push(c: TCall) -> bool {
    let segs = c.callee.segments
    if segs.len < 2 { return false }
    segs[segs.len - 1].name == "push" && segs[segs.len - 2].name == "list"
}

// (S2 Level-1) assign_is_self_append — is `a` exactly `xs = teko::list::push(xs, item)` (a plain
// SIMPLE name write whose RHS grows the SAME name)? Only this shape earns the base-read carve-out;
// a field/deref write, a different target, or any other RHS keeps the conservative escaping mark.
fn assign_is_self_append(a: TAssign) -> bool {
    match a.kind { parser::AssignKind::Simple => { }; _ => return false }
    match a.value.kind {
        TCall as c => {
            if !tcall_is_list_push(c) { return false }
            if c.args.len != 2 { return false }
            match c.args[0].kind {
                TVar as v => v.name == a.name
                _ => false
            }
        }
        _ => false
    }
}

// (S2 Level-1) self_append_item — the APPENDED element (arg1) of a self-append. Precondition:
// assign_is_self_append(a) held; the fallback (whole RHS) is never reached on that path.
fn self_append_item(a: TAssign) -> TExpr {
    match a.value.kind {
        TCall as c => c.args[1]
        _ => a.value
    }
}

// (S2 Level-1) assign_routes_to_frame — THE routing predicate: should this assignment's grown slice
// buffer be allocated in the function frame region (freed when the frame drops)? True iff it is a
// self-append `xs = push(xs, …)` whose target xs is a NON-escaping slice, so its whole buffer history
// dies with the frame. The codegen and the escape carve-out (mark_stmt) SHARE this exact shape — they
// must never disagree: a routed push whose base the carve-out did NOT exempt could leave xs escaping
// (leak, safe) but a base the carve-out exempted that codegen does NOT route just stays on root (also
// safe). Coupling them here keeps both correct by construction. PUBLIC (codegen reads it).
pub fn assign_routes_to_frame(escaping: []str, a: TAssign) -> bool {
    if !assign_is_self_append(a) { return false }
    if str_set_has(escaping, a.name) { return false }
    match a.bound {
        Slice => true
        _ => false
    }
}

// ── (#148 S2 Level-2) LINEAR-CHAIN proof — free-old-on-grow. ─────────────────────────────
// The C twin's lists realloc (freeing the old buffer per grow); the generated code RETAINS every
// dead doubling in the arena — the measured gen-1-vs-gen-0 memory gap. For a PROVABLY LINEAR
// accumulator chain, each copy-grow may park the OLD buffer on the runtime free-list for reuse
// (realloc parity). THE PROOF (v1, conservative — any doubt routes to root, a safe leak):
//   1. the name is BORN EXACTLY ONCE in the fn, from `…::list::empty()` (no shared buffer at birth,
//      no shadowing to conflate the counts below);
//   2. EVERY write to the name is a self-append `xs = push(xs, …)` (no rebinding to an alias);
//   3. the READ EQUATION: every read of the name is a self-append base — EXCEPT reads in the fn's
//      FINAL statement (nothing pushes after it, so capturing the final buffer there is safe).
//      total_reads(body) - reads(final stmt) == n_self_appends  ⇒  no mid-chain capture exists,
//      so no alias can observe a parked (freed) intermediate buffer.

// per-name WRITE statistics across a whole fn body (reads are counted by count_reads_*).
type ChainStats = struct { births_empty: i64; births_other: i64; other_writes: i64; self_appends: i64 }

fn cs_zero() -> ChainStats { ChainStats { births_empty = 0; births_other = 0; other_writes = 0; self_appends = 0 } }
fn cs_add(a: ChainStats, b: ChainStats) -> ChainStats {
    ChainStats { births_empty = a.births_empty + b.births_empty; births_other = a.births_other + b.births_other; other_writes = a.other_writes + b.other_writes; self_appends = a.self_appends + b.self_appends }
}

// is this binding's value exactly `…::list::empty()` (the fresh-buffer birth)?
fn binding_value_is_list_empty(b: TBinding) -> bool {
    match b.value.kind {
        TCall as c => {
            let segs = c.callee.segments
            if segs.len < 2 { return false }
            segs[segs.len - 1].name == "empty" && segs[segs.len - 2].name == "list"
        }
        _ => false
    }
}

// walk an expr for STATEMENT BLOCKS embedded in if/match arms (bindings/assigns live there too).
fn chain_stats_expr(e: TExpr, name: str) -> ChainStats {
    match e.kind {
        TIfExpr as f => {
            mut s = chain_stats_expr(f.cond, name)
            s = cs_add(s, chain_stats_block(f.then_blk, name))
            if f.has_else { s = cs_add(s, chain_stats_block(f.else_blk, name)) }
            s
        }
        TMatchExpr as m => {
            mut s = chain_stats_expr(m.subject, name)
            mut i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { s = cs_add(s, chain_stats_expr(m.arms[i].guard, name)) }
                s = cs_add(s, chain_stats_block(m.arms[i].body, name))
                i++
            }
            s
        }
        TBinary as b => cs_add(chain_stats_expr(b.left, name), chain_stats_expr(b.right, name))
        TUnary as u => chain_stats_expr(u.operand, name)
        TCompare as c => {
            mut s = chain_stats_expr(c.first, name)
            mut i = 0
            loop { if i >= c.rest.len { break }; s = cs_add(s, chain_stats_expr(c.rest[i].operand, name)); i++ }
            s
        }
        TCall as call => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= call.args.len { break }; s = cs_add(s, chain_stats_expr(call.args[i], name)); i++ }
            s
        }
        TCast as ct => chain_stats_expr(ct.expr, name)
        TFieldAccess as fa => chain_stats_expr(fa.receiver, name)
        TSafeFieldAccess as sfa => chain_stats_expr(sfa.receiver, name)
        TCoalesce as co => cs_add(chain_stats_expr(co.left, name), chain_stats_expr(co.right, name))
        TIndex as ix => cs_add(chain_stats_expr(ix.receiver, name), chain_stats_expr(ix.index, name))
        TStructInit as si => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= si.field_vals.len { break }; s = cs_add(s, chain_stats_expr(si.field_vals[i], name)); i++ }
            s
        }
        TArrayLit as al => {
            mut s = cs_zero()
            mut i = 0
            loop { if i >= al.elements.len { break }; s = cs_add(s, chain_stats_expr(al.elements[i].expr, name)); i++ }
            s
        }
        TInterp as ip => {
            mut s = cs_zero()
            mut i = 0
            loop {
                if i >= ip.holes.len { break }
                s = cs_add(s, chain_stats_expr(ip.holes[i], name))
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => {
                            mut k = 0
                            loop { if k >= fd.args.len { break }; s = cs_add(s, chain_stats_expr(fd.args[k], name)); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            s
        }
        TInExpr as ine => {
            mut s = chain_stats_expr(ine.lhs, name)
            mut i = 0
            loop { if i >= ine.elems.len { break }; s = cs_add(s, chain_stats_expr(ine.elems[i], name)); i++ }
            s
        }
        _ => cs_zero()   // leaves + TLambda (its body is a LIFTED fn — not this frame's chain)
    }
}

fn chain_stats_stmt(s: TStatement, name: str) -> ChainStats {
    match s {
        TBinding as b => {
            mut st = chain_stats_expr(b.value, name)
            match b.target {
                parser::SimpleName as sn => {
                    if sn.name == name {
                        if binding_value_is_list_empty(b) { st = cs_add(st, ChainStats { births_empty = 1; births_other = 0; other_writes = 0; self_appends = 0 }) }
                        else { st = cs_add(st, ChainStats { births_empty = 0; births_other = 1; other_writes = 0; self_appends = 0 }) }
                    }
                }
