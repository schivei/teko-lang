// src/checker/checker_test.tkt — tests for the typer (C1). #test functions the runner collects.
// The typer is unit-tested on HAND-BUILT AST: each type_* must produce a fully typed node (happy)
// or refuse an ill-typed one (barrier). Rewritten to current Teko (the `Expr` node-wrapper C1-POS,
// all-fields struct literals, `Function`/`Arm`/`TypeDecl`/`Item` shapes) and module-qualified.
use teko::parser

/**
 * program_files_collects_distinct_non_empty_files_in_first_seen_order — the closed candidate set
 * `to_diagnostic` matches against: every DISTINCT non-empty `item.file`, first occurrence wins,
 * duplicates dropped, an empty (single-file compile path) `file` never included.
 */
fn program_files_collects_distinct_non_empty_files_in_first_seen_order() {
    mut items: []parser::Item = teko::list::empty()
    items = teko::list::push(items, parser::Item { content = mk_fn("a", named_t("i64"), teko::list::empty()); namespace = ""; file = "a.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("b", named_t("i64"), teko::list::empty()); namespace = ""; file = "b.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("c", named_t("i64"), teko::list::empty()); namespace = ""; file = "a.tks" })
    items = teko::list::push(items, parser::Item { content = mk_fn("d", named_t("i64"), teko::list::empty()); namespace = ""; file = "" })
    let files = program_files(parser::Program { items = items })
    teko::assert::eq_u64(files.len, 2)
    teko::assert::eq_str(files[0], "a.tks")
    teko::assert::eq_str(files[1], "b.tks")
}

#test
/**
 * collect_diagnostics_structured_stamps_real_severity_and_range — the crumb D end-to-end regression,
 * driving the REAL lex → parse → `collect_diagnostics_structured` seam (mirroring
 * `collect_diagnostics_appends_a_collected_warning_after_an_error`'s own harness): a program with ONE
 * type error and ONE unused private function yields TWO `Diagnostic` values — the error stamped
 * `DiagLevel::Error`, the warning stamped `DiagLevel::Warning` — proving severity is REAL, not a
 * `"warning:"` text sniff, all the way from the checker's own pre-mono walk.
 */
fn collect_diagnostics_structured_stamps_real_severity_and_range() {
    let src = "pub fn bad(x: Bogus) -> i64 { return 0 }\nfn dead_leaf() -> i64 { return 1 }\n"
    let diags = collect_diagnostics_structured(prog_from_module_src(src, "warn.tks"))
    teko::assert::eq_u64(diags.len, 2)
    teko::assert::eq_str(diags[0].file, "warn.tks")
    teko::assert::is_true(diags[0].severity == DiagLevel::Error)
    teko::assert::str_contains(diags[0].message, "Bogus")
    teko::assert::eq_str(diags[1].file, "warn.tks")
    teko::assert::is_true(diags[1].severity == DiagLevel::Warning)
    teko::assert::str_contains(diags[1].message, "unused private function")
    teko::assert::str_contains(diags[1].message, "dead_leaf")
}
