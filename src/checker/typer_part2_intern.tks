// src/checker/typer.tks  (namespace 'teko::checker')
// Each check_* (E4/E5) EVOLVES into a type_*: the SAME checks (B.22 regimes, B.20
// `if`, B.15 `match` + exhaustiveness), but the producer BUILDS the typed node
// instead of returning a bare Type. Predicates (is_bool/is_integer/op_is_*),
// resolvers (resolve_type), env (lookup/define) and the pattern + exhaustiveness
// logic (check_pattern/exhaustive) are reused from their stages — re-derivation,
// not duplication (M.5). C1: every node, statement and item re-derived.
use teko::lexer
use teko::parser

fn lam_param_types(ps: []TLambdaParam) -> []Type {
    mut out: []Type = teko::list::empty()
    mut i = 0
    loop { if i >= ps.len { break }; out = teko::list::push(out, ps[i].type); i++ }
    out
}

// ---- operators (the SAME B.22 regimes as check_binary/check_unary/check_compare) ----

// (2026-07-01) `~` — binary string concat, arity-polymorphic with unary `~` (bitwise NOT, see
// type_unary below). Additive precedence, NOT commutative (honest — Governing Law M.3, the same
// reasoning `+` was rejected for concat: TEKO_LEGISLATION.md "`+` never concatenates").
//
// Flattens a LEFT-ASSOCIATIVE `~` chain (`a ~ b ~ c ~ …`, which parses as a left-leaning
// Binary tree) into a flat piece list, so `a ~ b ~ c` desugars to ONE `teko::string::concat(a,
// b, c)` call — NOT nested 2-arg calls — reusing the params-variadic `concat` built for this.
fn flatten_tilde_chain(e: parser::Expr, acc: []parser::Expr) -> []parser::Expr {
    match e.kind {
        parser::Binary as b => {
            if b.op == lexer::TokenKind::Tilde {
                let acc2 = flatten_tilde_chain(b.left, acc)
                return flatten_tilde_chain(b.right, acc2)
            }
            teko::list::push(acc, e)
        }
        _ => teko::list::push(acc, e)
    }
}

fn tilde_str_lit_text(e: parser::Expr) -> str | null {
    match e.kind {
        parser::StrLit as s => s.text
        // (2026-07-01) `$"no holes"` / `$@"""no holes"""` — interpolated syntax with ZERO holes
        // (the `verbatim` escaping flag is already resolved into `pieces` by parse time, so a
        // 0-hole Interp is indistinguishable from a plain literal here). Rare in practice (why
        // use `$`/`$@` with nothing to interpolate?), but foldable, so fold it — max compile-time
        // optimization per the user's explicit ask.
        parser::Interp as it => if it.holes.len == 0 && it.pieces.len == 1 { it.pieces[0] } else { null }
        _ => null
    }
}

// Constant-fold adjacent STR-LITERAL pieces at compile time (e.g. `x ~ "a" ~ "b" ~ y` folds
// `"a" ~ "b"` into ONE literal `"ab"` first, so the runtime call becomes `concat(x, "ab", y)` —
// 2 pieces, not 3). If EVERY piece folds into one literal, the whole `~` chain collapses to that
// single literal at compile time — zero runtime concat calls.
fn fold_tilde_pieces(pieces: []parser::Expr) -> []parser::Expr {
    mut out: []parser::Expr = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= pieces.len { break }
        match tilde_str_lit_text(pieces[i]) {
            str as t0 => {
                mut merged = t0
                mut j = i + 1
                loop {
                    if j >= pieces.len { break }
                    match tilde_str_lit_text(pieces[j]) {
                        str as tj => { merged = teko::string::concat(merged, tj); j++ }
                        null => { break }
                    }
                }
                out = teko::list::push(out, parser::Expr { kind = parser::StrLit { text = merged }; line = pieces[i].line; col = pieces[i].col })
                i = j
            }
            null => { out = teko::list::push(out, pieces[i]); i++ }
        }
    }
    out
}

fn type_tilde_chain(b: parser::Binary, env: Env, table: TypeTable) -> TExpr | error {
    let raw = flatten_tilde_chain(parser::Expr { kind = b; line = 0; col = 0 }, teko::list::empty())
    let folded = fold_tilde_pieces(raw)
    if folded.len == 1 { return type_expr(folded[0], env, table) }   // whole chain was literals — a single literal, no runtime call
    let seg_teko = parser::Segment { name = "teko" }
    let seg_string = parser::Segment { name = "string" }
    let seg_concat = parser::Segment { name = "concat" }
    mut segs: []parser::Segment = teko::list::push(teko::list::empty(), seg_teko)
    segs = teko::list::push(segs, seg_string)
    segs = teko::list::push(segs, seg_concat)
    mut pos_names: []str = teko::list::empty()   // DEFARGS (2026-07-01) — this synthetic call is always all-positional
    mut ni: u64 = 0
    loop { if ni >= folded.len { break }; pos_names = teko::list::push(pos_names, ""); ni++ }
    let call = parser::Call { callee = parser::Path { segments = segs }; args = folded; arg_names = pos_names; type_args = teko::list::empty() }
    // `concat`'s own arg-widening (type_call, below) already requires every piece to be `str` —
    // a non-str `~` operand fails there with a clear message, no separate check needed here.
    type_call(call, env, table)
}
/** `~` is desugared WHOLESALE (chain-flattened + literal-folded) BEFORE the generic operand-typing
    below — it never reaches a plain TBinary node (codegen/interpreter see an ordinary TCall or TStrLit,
    nothing new to handle, mirroring how `params` needed no engine changes).
    (S6, issue #162) operators over a constrained type-param T stay a HONEST STOP, intentionally —
    no operator-trait exists yet to authorize `+`/`-`/… the way an interface constraint authorizes
    a method call. `is_numeric`/`is_integer`/`is_bool` below never match a type-param's `Named{T}`
    (opaque OR interface-mirroring), so every arm below already falls through to its own clear error
    for a `T` operand — NO new logic is needed, and none is added here (avoids gold-plating a
    pre-alpha surface). Real operators on T arrive with an operator-trait constraint (#176+). */
/**
 * deref_ref_value — the transparent auto-deref of the `ref` keyword surface (0.3.0.30 Part A). Peels
 * ONE surface `ref`/`Reference{T}` layer off a typed expression used in a VALUE context, so the
 * developer reads a `ref`-bound name bare (no `.value`) exactly as its referenced value. The peel
 * lowers to the same `.value` read (`TFieldAccess` field `value` → codegen `(*p)`) the surface no
 * longer spells. On any non-reference expression it is an identity no-op, so it fires ONLY on the new
 * `ref` surface (the current corpus never produces a bare `Reference` in a value position). References
 * are internally depth-1, so a single peel reaches the value.
 *
 * @param te  the typed operand
 * @return    `te` with its outermost `Reference` peeled to the referenced value, else `te` unchanged
 */
fn deref_ref_value(te: TExpr) -> TExpr {
    match te.type {
        Reference as rf => TExpr { kind = TFieldAccess { receiver = te; field = "value" }; type = rf.inner; line = te.line; col = te.col }
        _ => te
    }
}

/**
 * bignum_kind — classify a type as one of the compiler-known arbitrary-precision surfaces. Returns
 * `"bigint"` for `teko::numeric::bigint::BigInt`, `"dec"` for `teko::numeric::dec::Decimal`, or the
 * empty string for anything else. The single discriminator behind the operator/comparison sugar.
 *
 * @param t  the resolved type
 * @return   `"bigint"`, `"dec"`, or `""`
 */
fn bignum_kind(t: Type) -> str {
    match t {
        Named as n => {
            if n.name == "teko::numeric::bigint::BigInt" { return "bigint" }
            if n.name == "teko::numeric::dec::Decimal" { return "dec" }
            ""
        }
        _ => ""
    }
}

/**
 * bignum_named — the `Named` type of a bignum kind (`"bigint"` → the `BigInt` struct, otherwise the
 * `Decimal` struct).
 *
 * @param kind  `"bigint"` or `"dec"`
 * @return      the corresponding `Named` type
 */
fn bignum_named(kind: str) -> Type {
    if kind == "bigint" { return Named { name = "teko::numeric::bigint::BigInt" } }
    Named { name = "teko::numeric::dec::Decimal" }
}

/**
 * bignum_ns — the runtime module namespace backing a bignum kind (drives the mangled C symbol of the
 * lowered call).
 *
 * @param kind  `"bigint"` or `"dec"`
 * @return      `"teko::numeric::bigint"` or `"teko::numeric::dec"`
 */
fn bignum_ns(kind: str) -> str {
    if kind == "bigint" { return "teko::numeric::bigint" }
    "teko::numeric::dec"
}

/**
 * bignum_call — build a typed call `teko::numeric::<kind>::<fn_name>(args)` — the ONE runtime
 * implementation both the library and the operator sugar target (no doubling). A namespaced,
 * non-closure `TCall` codegen resolves to the mangled library symbol under both backends.
 *
 * @param kind     `"bigint"` or `"dec"`
 * @param fn_name  the library function's bare name (`add`/`sub`/`mul`/`div`/`rem`/`cmp`/`neg`/`of`)
 * @param args     the typed argument expressions
 * @param ret      the call's result type
 * @return         the typed call expression
 */
fn bignum_call(kind: str, fn_name: str, args: []TExpr, ret: Type) -> TExpr {
    mut segs: []parser::Segment = teko::list::push(teko::list::empty(), parser::Segment { name = "teko" })
    segs = teko::list::push(segs, parser::Segment { name = "numeric" })
    segs = teko::list::push(segs, parser::Segment { name = kind })
    segs = teko::list::push(segs, parser::Segment { name = fn_name })
    let callee = parser::Path { segments = segs }
    TExpr { kind = TCall { callee = callee; args = args; call_ns = bignum_ns(kind); is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0 }; type = ret; line = 0; col = 0 }
}

/**
 * bignum_adopt_operand — coerce one operand of a bignum operation to the target kind. A value already
 * of that kind passes through; a fitting non-negative integer LITERAL adopts it via the library's
 * `of` constructor (literal-adopt: `big + 1` works). Every other operand — a value of the OTHER
 * bignum kind, a machine-typed variable, or a float literal — is rejected with a diagnostic that
 * names the explicit conversion (no implicit promotion, B.22).
 *
 * @param e     the typed operand
 * @param kind  the target bignum kind (`"bigint"` or `"dec"`)
 * @return      the operand as a value of `kind`, or an error explaining the required explicit step
 * @throws      when the operand mixes bignum kinds, is a non-literal of a different type, is a float
 *              literal, or is an integer literal too large to adopt without a suffix
 */
fn bignum_adopt_operand(e: TExpr, kind: str) -> TExpr | error {
    if bignum_kind(e.type) == kind { return e }
    if bignum_kind(e.type) != "" { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    match e.kind {
        TNumber as n => {
            if n.is_float { return error { message = $"a floating-point literal cannot adopt `{kind}` — write it with a `bi`/`d` suffix or convert explicitly with `{kind}::of(...)`" } }
            if !numint_fits(n.value, PrimKind::I64) { return error { message = $"integer literal is too large to adopt into `{kind}` — write it with a `bi`/`d` suffix" } }
            let lit = TExpr { kind = e.kind; type = Prim { kind = PrimKind::I64 }; line = e.line; col = e.col }
            bignum_call(kind, "of", teko::list::push(teko::list::empty(), lit), bignum_named(kind))
        }
        _ => error { message = $"no implicit conversion to `{kind}` — wrap the operand with `{kind}::of(x)` (no implicit promotion — B.22)" }
    }
}

/**
 * bignum_op_fn — map a binary operator token to the bignum library function it lowers to. Rejects
 * `%` on `dec` (decimals define no remainder) and any non-arithmetic operator on either kind.
 *
 * @param op    the operator token
 * @param kind  the bignum kind (`"bigint"` or `"dec"`)
 * @return      the library function name, or an error for an unsupported operator
 * @throws      when the operator is `%` on `dec`, or is not one of `+ - * /` (`%` on `bigint`)
 */
fn bignum_op_fn(op: lexer::TokenKind, kind: str) -> str | error {
    if op == lexer::TokenKind::Plus { return "add" }
    if op == lexer::TokenKind::Minus { return "sub" }
    if op == lexer::TokenKind::Star { return "mul" }
    if op == lexer::TokenKind::Slash { return "div" }
    if op == lexer::TokenKind::Percent {
        if kind == "dec" { return error { message = "`%` (modulo) is not defined on `dec` — a decimal has no remainder operator" } }
        return "rem"
    }
    error { message = $"this operator is not defined on `{kind}` — `bigint` supports `+ - * / %`, `dec` supports `+ - * /`, and comparisons (`< > <= >= == !=`)" }
}

/**
 * type_bignum_binop — lower a binary operator over a bignum operand to its library call (operator
 * sugar). Determines the target kind (rejecting a `bigint`/`dec` mix), maps the operator to its
 * function, adopts each operand, and returns the typed call.
 *
 * @param op     the operator token
 * @param l      the typed left operand
 * @param r      the typed right operand
 * @param lk     the left operand's bignum kind (`""` if not a bignum)
 * @param rk     the right operand's bignum kind (`""` if not a bignum)
 * @return       the typed library call implementing the operator, or a type error
 * @throws       when the operands mix kinds, an operator is unsupported, or an operand cannot adopt
 */
fn type_bignum_binop(op: lexer::TokenKind, l: TExpr, r: TExpr, lk: str, rk: str) -> TExpr | error {
    if lk != "" && rk != "" && lk != rk { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    let kind = if lk != "" { lk } else { rk }
    let fn_name = match bignum_op_fn(op, kind) { str as s => s; error as e => return e }
    let la = match bignum_adopt_operand(l, kind) { TExpr as te => te; error as e => return e }
    let ra = match bignum_adopt_operand(r, kind) { TExpr as te => te; error as e => return e }
    mut cargs: []TExpr = teko::list::push(teko::list::empty(), la)
    cargs = teko::list::push(cargs, ra)
    bignum_call(kind, fn_name, cargs, bignum_named(kind))
}
