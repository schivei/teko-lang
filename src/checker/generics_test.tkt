
type GBox = struct { v: i64 }

type Gen<T> = struct { val: T }

fn idg<T>(x: T): T { return x }

fn pickg<T>(x: T, y: T, useFirst: bool): T {
    var r = if useFirst { x } else { y }
    return r
}

fn wrapg<T>(x: T): T {
    var inner = idg(x)
    return inner
}

fn firstg<T>(xs: []T): T { return xs[0] }

#test fn generic_id_str_runs() {
    teko::assert::is_true(teko::runtime::str_eq(idg("hi"), "hi"))
}

#test fn generic_id_box_runs() {
    var b = idg(GBox { v = 5 })
    teko::assert::is_true(b.v == 5)
}

#test fn generic_pick_runs() {
    teko::assert::is_true(pickg(3, 9, true) == 3)
    teko::assert::is_true(pickg(3, 9, false) == 9)
}

#test fn generic_wrap_runs() {
    teko::assert::is_true(wrapg(11) == 11)
}

#test fn generic_first_runs() {
    var xs = teko::list::push(teko::list::push(teko::list::empty(), 4), 8)
    teko::assert::is_true(firstg(xs) == 4)
}

type GenOther = struct { x: i64 }
type GenWrap = variant Gen<i64> | GenOther
type GenMulti = variant Gen<i64> | Gen<str> | GenOther

fn gw_mk_gen(): GenWrap { return Gen<i64>{ val = 7 } }
fn gw_mk_gen_ann(): GenWrap { var g: Gen<i64> = Gen<i64> { val = 7 }; return g }
fn gw_mk_other(): GenWrap { return GenOther { x = 42 } }
fn gm_mk_i(): GenMulti { return Gen<i64>{ val = 100 } }
fn gm_mk_s(): GenMulti { return Gen<str>{ val = "hi" } }
fn gm_mk_o(): GenMulti { return GenOther { x = 9 } }

#test fn generic_variant_member_annotated_runs() {
    var r = match gw_mk_gen_ann() { Gen<i64> as gg => gg.val; GenOther as o => o.x }
    teko::assert::is_true(r == 7)
}

#test fn generic_variant_member_explicit_runs() {
    var r = match gw_mk_gen() { Gen<i64> as gg => gg.val; GenOther as o => o.x }
    teko::assert::is_true(r == 7)
}

#test fn generic_variant_member_other_arm_runs() {
    var r = match gw_mk_other() { Gen<i64> as gg => gg.val; GenOther as o => o.x }
    teko::assert::is_true(r == 42)
}

#test fn generic_variant_multi_instance_i_runs() {
    var r = match gm_mk_i() { Gen<i64> as a => a.val; Gen<str> as b => 1; GenOther as c => c.x }
    teko::assert::is_true(r == 100)
}
#test fn generic_variant_multi_instance_s_runs() {
    var r = match gm_mk_s() { Gen<i64> as a => a.val; Gen<str> as b => 2; GenOther as c => c.x }
    teko::assert::is_true(r == 2)
}
#test fn generic_variant_multi_instance_o_runs() {
    var r = match gm_mk_o() { Gen<i64> as a => a.val; Gen<str> as b => 3; GenOther as c => c.x }
    teko::assert::is_true(r == 9)
}

type Geo = interface {
    fn area(): i64
    fn scaled(k: i64): i64
}
type Sq = class & Geo {
    pub s: i64
    pub static fn make(v: i64): Sq { Sq { s = v } }
    pub fn area(): i64 { self.s * self.s }
    pub fn scaled(k: i64): i64 { self.area() * k }
}
type Tri = class & Geo {
    pub b: i64
    pub static fn make(v: i64): Tri { Tri { b = v } }
    pub fn area(): i64 { self.b * 10 }
    pub fn scaled(k: i64): i64 { self.area() + k }
}
fn geo_measure<T: Geo>(x: T, k: i64): i64 { return x.area() + x.scaled(k) }

#test fn constrained_method_dispatch_class1_runs() {
    teko::assert::is_true(geo_measure(Sq::make(3), 2) == 27)
}
#test fn constrained_method_dispatch_class2_runs() {
    teko::assert::is_true(geo_measure(Tri::make(4), 5) == 85)
}
