use teko::parser

/**
 * Render a diagnostic's LOCATION and message as the one line the driver prints:
 * `file:line:col: msg`, with any part the caller does not know omitted (M.3 — show what we know,
 * never invent a position). W-loc-2.
 *
 * @param file  the source file the diagnostic belongs to ("" when unknown)
 * @param line  the 1-based line ( 0 when unknown)
 * @param col   the 1-based column (read only when `line` is known)
 * @param msg   the diagnostic's own text
 * @return      the located diagnostic line
 */
fn diag_at(file: str, line: u32, col: u32, msg: str) -> str {
    if file != "" && line > 0 { return $"{file}:{line}:{col}: {msg}" }
    if file != "" { return $"{file}: {msg}" }
    if line > 0 { return $"{line}:{col}: {msg}" }
    msg
}

/**
 * Locate an already-built checker `error` at a declaration, yielding the diagnostic TEXT a
 * collecting pass records. The error's OWN line/col wins over the declaration's when it carries
 * one (C1-POS — an inner-expression position is more precise than the declaration's).
 *
 * A collecting pass records TEXT rather than the error value on purpose: a collected diagnostic
 * is never re-thrown, only printed, so the structured position/expected/actual a re-thrown error
 * would carry has no reader.
 *
 * @param file       the declaration's source file (W-loc-2)
 * @param decl_line  the declaration's line, used when the error carries none
 * @param decl_col   the declaration's column, used when the error carries none
 * @param inner      the checker error to locate
 * @return           the `file:line:col: text` diagnostic line
 * @since 0.3.1
 */
fn located_diag(file: str, decl_line: u32, decl_col: u32, inner: error) -> str {
    let line = if inner.line != 0 { inner.line } else { decl_line }
    let col = if inner.line != 0 { inner.col } else { decl_col }
    diag_at(file, line, col, inner.message)
}

/**
 * `b`'s diagnostics appended to `a`'s, in order — the single way a collecting pass grows its
 * accumulator, so report order stays exactly the order the passes walked (source, then line, then
 * column, by construction: every walk visits `program.items` in sorted-path order and every
 * intra-item walk visits declaration order).
 *
 * @param a  the diagnostics collected first
 * @param b  the diagnostics to append
 * @return   the concatenation, `a` before `b`
 * @since 0.3.1
 */
fn concat_diags(a: []str, b: []str) -> []str {
    if b.len == 0 { return a }
    if a.len == 0 { return b }
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}

/**
 * The single-element diagnostic list a pass records when exactly one check failed — the common
 * case, spelled once so no call site has to build a list by hand.
 *
 * @param d  the diagnostic line
 * @return   a one-element list holding it
 * @since 0.3.1
 */
fn one_diag(d: str) -> []str {
    teko::list::push(teko::list::empty(), d)
}

/**
 * Render a collected diagnostic list as the newline-separated block the driver prints. Mirrors
 * `teko::build::join_diags`; duplicated rather than shared because the checker must not depend on
 * the build layer.
 *
 * @param diags  the collected diagnostics, in report order
 * @return       the diagnostics joined by newlines ("" for an empty list)
 * @since 0.3.1
 */
pub fn join_checker_diags(diags: []str) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= diags.len { break }
        if i > 0 { out = out ~ "\n" }
        out = out ~ diags[i]
        i = i + 1
    }
    out
}

/**
 * The single `error` a collecting pass's `error`-shaped wrapper raises once it has collected
 * everything: one value whose message is EVERY diagnostic, newline-separated. Callers that still
 * speak `T | error` (the checker's own `#test` suite, `type_program`) keep their contract while
 * the pass underneath reports the whole build.
 *
 * @param diags  the collected diagnostics, in report order (must be non-empty)
 * @return       the joined error
 * @since 0.3.1
 */
fn diags_error(diags: []str) -> error {
    error { message = join_checker_diags(diags) }
}
