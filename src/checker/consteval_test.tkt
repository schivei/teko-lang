use teko::parser
use teko::lexer

/**
 * f64t — the `f64` primitive type, the result type of the Tier-5 `f64_from_bits` fixture.
 *
 * @return the `f64` primitive type
 */
fn f64t(): Type { Prim { kind = PrimKind::F64 } }

/**
 * te — wrap a typed-expression kind and its resolved type into a positioned `TExpr` at line 1.
 *
 * @param k  the typed expression kind
 * @param t  the resolved type
 * @return   the positioned `TExpr`
 */
fn te(k: @TExprKind(), t: Type): TExpr { TExpr { kind = k; type = t; line = 1; col = 1 } }

/**
 * c_num — an `i64` number-literal typed expression (Tier 0).
 *
 * @param v  the integer value (a non-negative u64, sign-split into `NumInt`)
 * @return   the typed number literal
 */
fn c_num(v: u64): TExpr { te(TNumber { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }, i64t()) }

/**
 * seg — a single path segment naming `name`.
 *
 * @param name  the segment identifier
 * @return      the segment
 */
fn seg(name: str): parser::Segment { parser::Segment { name = name } }

/**
 * path2 — a two-segment `a::b` path.
 *
 * @param a  the first segment's name
 * @param b  the last segment's name
 * @return   the two-segment path
 */
fn path2(a: str, b: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), seg(a))
    segs = teko::list::push(segs, seg(b))
    parser::Path { segments = segs }
}

/**
 * path3 — a three-segment `a::b::c` path.
 *
 * @param a  the first segment's name
 * @param b  the middle segment's name
 * @param c  the last segment's name
 * @return   the three-segment path
 */
fn path3(a: str, b: str, c: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), seg(a))
    segs = teko::list::push(segs, seg(b))
    segs = teko::list::push(segs, seg(c))
    parser::Path { segments = segs }
}

/**
 * a_call — a typed call expression with the given callee and argument list, defaulting the fields
 * irrelevant to the const-expr gate.
 *
 * @param callee  the callee path
 * @param args    the typed arguments
 * @param t       the call's result type
 * @return        the typed call expression
 */
fn a_call(callee: parser::Path, args: []TExpr, t: Type): TExpr {
    te(TCall { overload_suffix = ""; callee = callee; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }, t)
}

/**
 * accepts — assert that `is_const_expr` accepts `e` (returns null) in the empty environment.
 *
 * @param e  the typed expression that must be a legal const initializer
 */
fn accepts(e: TExpr) {
    match is_const_expr(e, empty_table(), empty_env()) { null => teko::assert::is_true(true); error => teko::assert::is_true(false) }
}

/**
 * rejects — assert that `is_const_expr` rejects `e` (returns an error) in the empty environment.
 *
 * @param e  the typed expression that must NOT be a legal const initializer
 */
fn rejects(e: TExpr) {
    match is_const_expr(e, empty_table(), empty_env()) { error => teko::assert::is_true(true); null => teko::assert::is_true(false) }
}

/**
 * const_expr_tier0_literals — Tier 0: int / bool literals are legal const initializers.
 */
#test
fn const_expr_tier0_literals() {
    accepts(c_num(127))
    accepts(te(TBoolLit { value = true }, boolt()))
    accepts(te(TStrLit { text = "hi" }, Str { }))
    accepts(te(TByteLit { value = b'A' }, Byte { }))
}

/**
 * const_expr_tier2_ops — Tier 2: `~`, unary `-`, and a binary bitwise/arithmetic op over
 * const-exprs are legal; a comparison operator is rejected.
 */
#test
fn const_expr_tier2_ops() {
    accepts(te(TUnary { op = lexer::TokenKind::Tilde; operand = c_num(0) }, i64t()))
    accepts(te(TUnary { op = lexer::TokenKind::Minus; operand = c_num(1) }, i64t()))
    accepts(te(TBinary { op = lexer::TokenKind::Plus; left = c_num(1); right = c_num(2) }, i64t()))
    accepts(te(TBinary { op = lexer::TokenKind::Shl; left = c_num(1); right = c_num(8) }, i64t()))
    rejects(te(TBinary { op = lexer::TokenKind::AndAnd; left = c_num(1); right = c_num(0) }, boolt()))
}

/**
 * const_expr_tier4_aggregates — Tier 4: an array literal and a struct literal of const-exprs are
 * legal; a struct literal with a non-const field is rejected.
 */
#test
fn const_expr_tier4_aggregates() {
    var elems: []TArrayElem = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = c_num(31) })
    elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = c_num(139) })
    accepts(te(TArrayLit { elements = elems }, Slice { element = i64t() }))

    var names: []str = teko::list::push(teko::list::empty(), "a")
    names = teko::list::push(names, "b")
    var vals: []TExpr = teko::list::push(teko::list::empty(), c_num(1))
    vals = teko::list::push(vals, c_num(2))
    accepts(te(TStructInit { field_names = names; field_vals = vals }, Named { name = "P" }))
}

/**
 * const_expr_tier5_allowlisted_call — Tier 5: a call to an allowlisted pure constructor
 * (`preg`, `teko::f64_from_bits`) over const-expr args is legal.
 */
#test
fn const_expr_tier5_allowlisted_call() {
    var pregs: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    pregs = teko::list::push(pregs, c_num(0))
    accepts(a_call(path1("preg"), pregs, Named { name = "MReg" }))

    var bits: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    accepts(a_call(path2("teko", "f64_from_bits"), bits, f64t()))
}

/**
 * const_expr_rejects_io_form — an I/O call (`teko::io::println`) is rejected: not allowlisted.
 */
#test
fn const_expr_rejects_io_form() {
    var arg: []TExpr = teko::list::push(teko::list::empty(), te(TStrLit { text = "x" }, Str { }))
    rejects(a_call(path3("teko", "io", "println"), arg, Void { }))
}

/**
 * const_expr_rejects_control_flow — a `null` literal (no Tier admits it) is rejected.
 */
#test
fn const_expr_rejects_control_flow() {
    rejects(te(TNullLit { }, i64t()))
}

/**
 * c_ret — a value-returning typed statement (`return e`), the body shape the inliner walks.
 *
 * @param e  the returned typed expression
 * @return   the typed return statement
 */
fn c_ret(e: TExpr): TStatement { TReturn { has_value = true; value = e; values = teko::list::empty() } }

/**
 * c_fn — a private nullary `i64` module-level TFunction named `name` with body `body`, for the
 * inliner fixtures (its body is walked for scalar-const references).
 *
 * @param name  the function's name
 * @param body  its typed statement block
 * @return      the typed function
 */
fn c_fn(name: str, body: []TStatement): TFunction {
    TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = i64t(); body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = "teko::checker"; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty() }
}

/**
 * mregt — the `MReg` nominal type, the result type of the `preg` const-constructor fixture.
 *
 * @return the `MReg` named type
 */
fn mregt(): Type { Named { name = "MReg" } }

/**
 * c_named_ann — a bare `Name` type annotation, the only annotation shape the constructor fixture's
 * parameters need (the canonicalizer matches parameters by NAME, never by type).
 *
 * @param name  the annotated type's name
 * @return      the parser-level type expression
 */
fn c_named_ann(name: str): parser::TypeExpr {
    parser::NamedType { path = path1(name); args = teko::list::empty() }
}

/**
 * c_param — a typed, non-variadic, non-defaulting parameter named `name`.
 *
 * @param name  the parameter's name
 * @param ty    the annotated type's name
 * @return      the parser-level parameter
 */
fn c_param(name: str, ty: str): parser::Param {
    parser::Param { name = name; has_type = true; type_ann = c_named_ann(ty); is_params = false; has_default = false; default_expr = parser::no_expr() }
}

/**
 * c_var — a bare-name reference typed expression (a constructor body's parameter reference).
 *
 * @param name  the referenced name
 * @param t     the reference's resolved type
 * @return      the typed variable reference
 */
fn c_var(name: str, t: Type): TExpr { te(TVar { name = name; is_func = false; func_ns = "teko::backend" }, t) }

/**
 * c_member — an enum member reference typed expression (`MRegClass::GPR`), a Tier-3 const leaf.
 *
 * @param enum_name  the enum type's name
 * @param member     the member's name
 * @param ordinal    the member's declared index (its runtime value)
 * @return           the typed path expression
 */
fn c_member(enum_name: str, member: str, ordinal: u64): TExpr {
    te(TPathExpr { enum_name = enum_name; member = member; ordinal = ordinal; value = ordinal }, Named { name = enum_name })
}

/**
 * preg_body — the struct literal `preg`'s body builds: `MReg { id = id; reg_class = reg_class;
 * is_phys = true }` — two parameter references and one literal.
 *
 * @return the constructor body's struct literal
 */
fn preg_body(): TExpr {
    var names: []str = teko::list::push(teko::list::empty(), "id")
    names = teko::list::push(names, "reg_class")
    names = teko::list::push(names, "is_phys")
    var vals: []TExpr = teko::list::push(teko::list::empty(), c_var("id", i64t()))
    vals = teko::list::push(vals, c_var("reg_class", Named { name = "MRegClass" }))
    vals = teko::list::push(vals, te(TBoolLit { value = true }, boolt()))
    te(TStructInit { field_names = names; field_vals = vals }, mregt())
}

/**
 * c_ctor_fn — a struct-constructor TFunction named `name` in namespace `ns`, with parameters `id` and
 * `reg_class` and a one-statement body returning `preg_body()`: the exact shape of `teko::backend`'s
 * `preg`, the constructor the backends' five `MReg` consts are initialized by.
 *
 * @param name  the constructor's name
 * @param ns    the constructor's declaring namespace
 * @return      the typed constructor function
 */
fn c_ctor_fn(name: str, ns: str): TFunction {
    var ps: []parser::Param = teko::list::push(teko::list::empty(), c_param("id", "u32"))
    ps = teko::list::push(ps, c_param("reg_class", "MRegClass"))
    var body: []TStatement = teko::list::push(teko::list::empty(), c_ret(preg_body()))
    TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = ps; return_type = mregt(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; namespace = ns; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty() }
}

/**
 * preg_ctors — the constructor table holding one `teko::backend::preg`.
 *
 * @return the single-entry struct-constructor table
 */
fn preg_ctors(): []TFunction { teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend")) }

/**
 * preg_call — the const initializer `preg(<id>, MRegClass::GPR)` as the checker types it and the fold
 * leaves it: a call whose arguments are already collapsed literals.
 *
 * @param id  the physical register number the call passes
 * @param ns  the namespace the checker resolved the call to
 * @return    the typed call expression
 */
fn preg_call(id: u64, ns: str): TExpr {
    var args: []TExpr = teko::list::push(teko::list::empty(), c_num(id))
    args = teko::list::push(args, c_member("MRegClass", "GPR", 0))
    te(TCall { overload_suffix = ""; callee = path1("preg"); args = args; call_ns = ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }, mregt())
}

/**
 * struct_init_of — the struct literal `e` carries, asserting that it IS one (the canonicalization's
 * whole contract).
 *
 * @param e  the canonicalized initializer
 * @return   the struct literal it carries (an empty literal when the assertion fails)
 */
fn struct_init_of(e: TExpr): TStructInit {
    match e.kind {
        TStructInit as si => si
        _ => {
            teko::assert::is_true(false)
            TStructInit { field_names = teko::list::empty(); field_vals = teko::list::empty() }
        }
    }
}

/**
 * num_mag_of — the magnitude of a number-literal typed expression, for asserting that a spliced
 * argument is exactly the one the fold produced.
 *
 * @param e  the typed expression that must be a number literal
 * @return   the literal's magnitude (0 when the assertion fails)
 */
fn num_mag_of(e: TExpr): u64 {
    match e.kind {
        TNumber as n => n.value.mag
        _ => {
            teko::assert::is_true(false)
            0 to u64
        }
    }
}

/**
 * is_call — whether `e` is still an un-canonicalized call.
 *
 * @param e  the canonicalized expression
 * @return   whether its kind is `TCall`
 */
fn is_call(e: TExpr): bool {
    match e.kind {
        TCall => true
        _ => false
    }
}

/**
 * canon_preg_call_becomes_struct_literal — a const initialized by the comptime constructor call
 * `preg(7, MRegClass::GPR)` canonicalizes to the struct literal `preg`'s own body builds, with the
 * SAME field names in the SAME order.
 */
#test
fn canon_preg_call_becomes_struct_literal() {
    var si = struct_init_of(canonicalize_const_ctors(preg_call(7, "teko::backend"), preg_ctors()))
    teko::assert::is_true(si.field_names.len == 3)
    teko::assert::is_true(si.field_names[0] == "id")
    teko::assert::is_true(si.field_names[1] == "reg_class")
    teko::assert::is_true(si.field_names[2] == "is_phys")
}

/**
 * canon_preg_call_preserves_the_folded_value — the canonical literal's field values are EXACTLY the
 * ones `preg` would have returned: each parameter reference becomes the argument the fold produced
 * (id = 7, reg_class = MRegClass::GPR) and the body's own literal survives (is_phys = true). A const
 * whose value drifted here would be a silent miscompilation inside the register allocator.
 */
#test
fn canon_preg_call_preserves_the_folded_value() {
    var si = struct_init_of(canonicalize_const_ctors(preg_call(7, "teko::backend"), preg_ctors()))
    teko::assert::is_true(num_mag_of(si.field_vals[0]) == 7)
    match si.field_vals[1].kind {
        TPathExpr as p => {
            teko::assert::is_true(p.enum_name == "MRegClass")
            teko::assert::is_true(p.member == "GPR")
        }
        _ => teko::assert::is_true(false)
    }
    match si.field_vals[2].kind {
        TBoolLit as b => teko::assert::is_true(b.value)
        _ => teko::assert::is_true(false)
    }
}

/**
 * canon_preg_call_keeps_the_declared_type — the canonical literal is typed as the CALL was (`MReg`),
 * so the rodata materializer resolves the same struct layout the const declares.
 */
#test
fn canon_preg_call_keeps_the_declared_type() {
    var out = canonicalize_const_ctors(preg_call(1, "teko::backend"), preg_ctors())
    teko::assert::is_true(type_eq(out.type, mregt()))
}

/**
 * canon_reaches_inside_an_array_literal — an array const whose elements are constructor calls
 * canonicalizes element-wise, so `[preg(0, GPR), preg(1, GPR)]` becomes an array of struct literals.
 */
#test
fn canon_reaches_inside_an_array_literal() {
    var elems: []TArrayElem = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = preg_call(0, "teko::backend") })
    elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = preg_call(1, "teko::backend") })
    var arr = te(TArrayLit { elements = elems }, Slice { element = mregt() })
    match canonicalize_const_ctors(arr, preg_ctors()).kind {
        TArrayLit as a => {
            teko::assert::is_true(num_mag_of(struct_init_of(a.elements[0].expr).field_vals[0]) == 0)
            teko::assert::is_true(num_mag_of(struct_init_of(a.elements[1].expr).field_vals[0]) == 1)
        }
        _ => teko::assert::is_true(false)
    }
}

/**
 * canon_leaves_a_non_struct_constructor_alone — `teko::f64_from_bits` is allowlisted in a const
 * initializer but returns a float, so no struct constructor resolves and the call survives untouched.
 */
#test
fn canon_leaves_a_non_struct_constructor_alone() {
    var bits: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    var call = a_call(path2("teko", "f64_from_bits"), bits, f64t())
    teko::assert::is_true(is_call(canonicalize_const_ctors(call, preg_ctors())))
}

/**
 * canon_refuses_an_ambiguous_constructor — two same-named constructors in different namespaces plus a
 * call the checker did not namespace resolve to nothing: guessing would splice a foreign body and
 * silently change the const's value, so the call is left for lowering's honest-stop to name.
 */
#test
fn canon_refuses_an_ambiguous_constructor() {
    var ctors: []TFunction = teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend"))
    ctors = teko::list::push(ctors, c_ctor_fn("preg", "app::other"))
    teko::assert::is_true(is_call(canonicalize_const_ctors(preg_call(3, ""), ctors)))
}

/**
 * canon_ignores_a_function_that_is_not_a_constructor — a callee whose body is not a single struct
 * literal is never spliced: `collect_const_ctors` does not even record it.
 */
#test
fn canon_ignores_a_function_that_is_not_a_constructor() {
    var plain: []TItem = teko::list::push(teko::list::empty(), c_fn("noise", teko::list::push(teko::list::empty(), c_ret(c_num(1)))))
    teko::assert::is_true(collect_const_ctors(plain).len == 0)
}

/**
 * collect_const_ctors_records_the_struct_constructor — a function whose whole body returns a struct
 * literal IS recorded, which is what makes `preg` resolvable at canonicalization time.
 */
#test
fn collect_const_ctors_records_the_struct_constructor() {
    var items: []TItem = teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend"))
    teko::assert::is_true(collect_const_ctors(items).len == 1)
}

/**
 * c_str_const — a private module-level `str` const named `name` in `teko::backend`, initialized by
 * `init` — the fixture for the #594 Tier-A `const str = <other const>` collapse.
 *
 * @param name  the const's name
 * @param init  the const's checked initializer
 * @return      the typed const declaration
 */
fn c_str_const(name: str, init: TExpr): TConstDecl {
    TConstDecl { name = name; namespace = "teko::backend"; ty = Str { }; init = init; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 1; col = 1 }
}

/**
 * str_const_init_is — does the module const named `name` in `prog` have a STRING-LITERAL initializer
 * whose text equals `expected`? False when the const is absent or its initializer is not a literal
 * (e.g. still a bare reference).
 *
 * @param prog      the program to search
 * @param name      the const's name
 * @param expected  the expected literal text
 * @return          true iff `name`'s initializer is the literal `expected`
 */
fn str_const_init_is(prog: TProgram, name: str, expected: str): bool {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TConstDecl as cd => if cd.name == name { return match cd.init.kind { TStrLit as s => s.text == expected; _ => false } }
            _ => { }
        }
        i++
    }
    false
}

/**
 * collapse_agg_const_resolves_str_reference — `const B: str = A` (A another str const) has B's
 * declaration initializer collapsed to A's string literal, so the native shared-rodata materializer
 * serializes the value instead of honest-stopping on the bare reference (#594 Tier-A follow-up). A's
 * own literal initializer is left unchanged.
 */
#test
fn collapse_agg_const_resolves_str_reference() {
    var a = c_str_const("A", te(TStrLit { text = "11.0.0" }, Str { }))
    var b = c_str_const("B", c_var("A", Str { }))
    var items: []TItem = teko::list::push(teko::list::empty(), a)
    items = teko::list::push(items, b)
    var out = match collapse_agg_const_decls(TProgram { items = items }) { TProgram as p => p; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(str_const_init_is(out, "B", "11.0.0"))
    teko::assert::is_true(str_const_init_is(out, "A", "11.0.0"))
}
