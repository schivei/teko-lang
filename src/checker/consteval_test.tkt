use teko::parser
use teko::lexer

fn f64t(): @Type() { Prim { kind = PrimKind::F64 } }

fn te(k: @TExprKind(), t: @Type()): TExpr { TExpr { kind = k; type = t; line = 1; col = 1 } }

fn c_num(v: u64): TExpr { te(TNumber { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }, i64t()) }

fn seg(name: str): parser::Segment { parser::Segment { name = name } }

fn path2(a: str, b: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), seg(a))
    segs = teko::list::push(segs, seg(b))
    parser::Path { segments = segs }
}

fn path3(a: str, b: str, c: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), seg(a))
    segs = teko::list::push(segs, seg(b))
    segs = teko::list::push(segs, seg(c))
    parser::Path { segments = segs }
}

fn a_call(callee: parser::Path, args: []TExpr, t: @Type()): TExpr {
    te(TCall { overload_suffix = ""; callee = callee; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }, t)
}

fn accepts(e: TExpr) {
    match is_const_expr(e, empty_table(), empty_env()) { null => teko::assert::is_true(true); error => teko::assert::is_true(false) }
}

fn rejects(e: TExpr) {
    match is_const_expr(e, empty_table(), empty_env()) { error => teko::assert::is_true(true); null => teko::assert::is_true(false) }
}

#test
fn const_expr_tier0_literals() {
    accepts(c_num(127))
    accepts(te(TBoolLit { value = true }, boolt()))
    accepts(te(TStrLit { text = "hi" }, Str { }))
    accepts(te(TByteLit { value = b'A' }, Byte { }))
}

#test
fn const_expr_tier2_ops() {
    accepts(te(TUnary { op = lexer::TokenKind::Tilde; operand = c_num(0) }, i64t()))
    accepts(te(TUnary { op = lexer::TokenKind::Minus; operand = c_num(1) }, i64t()))
    accepts(te(TBinary { op = lexer::TokenKind::Plus; left = c_num(1); right = c_num(2) }, i64t()))
    accepts(te(TBinary { op = lexer::TokenKind::Shl; left = c_num(1); right = c_num(8) }, i64t()))
    rejects(te(TBinary { op = lexer::TokenKind::AndAnd; left = c_num(1); right = c_num(0) }, boolt()))
}

#test
fn const_expr_tier4_aggregates() {
    var elems: []TArrayElem = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = c_num(31) })
    elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = c_num(139) })
    accepts(te(TArrayLit { elements = elems }, Slice { element = i64t() }))

    var names: []str = teko::list::push(teko::list::empty(), "a")
    names = teko::list::push(names, "b")
    var vals: []TExpr = teko::list::push(teko::list::empty(), c_num(1))
    vals = teko::list::push(vals, c_num(2))
    accepts(te(TStructInit { field_names = names; field_vals = vals }, Named { name = "P" }))
}

#test
fn const_expr_tier5_allowlisted_call() {
    var pregs: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    pregs = teko::list::push(pregs, c_num(0))
    accepts(a_call(path1("preg"), pregs, Named { name = "MReg" }))

    var bits: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    accepts(a_call(path2("teko", "f64_from_bits"), bits, f64t()))
}

#test
fn const_expr_rejects_io_form() {
    var arg: []TExpr = teko::list::push(teko::list::empty(), te(TStrLit { text = "x" }, Str { }))
    rejects(a_call(path3("teko", "io", "println"), arg, Void { }))
}

#test
fn const_expr_rejects_control_flow() {
    rejects(te(TNullLit { }, i64t()))
}

fn c_ret(e: TExpr): @TStatement() { TReturn { has_value = true; value = e; values = teko::list::empty() } }

fn c_fn(name: str, body: []@TStatement()): TFunction {
    TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = i64t(); body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = "teko::checker"; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn mregt(): @Type() { Named { name = "MReg" } }

fn c_named_ann(name: str): @TypeExpr() {
    parser::NamedType { path = path1(name); args = teko::list::empty() }
}

fn c_param(name: str, ty: str): parser::Param {
    parser::Param { name = name; has_type = true; type_ann = c_named_ann(ty); is_params = false; has_default = false; default_expr = parser::no_expr() }
}

fn c_var(name: str, t: @Type()): TExpr { te(TVar { name = name; is_func = false; func_ns = "teko::backend" }, t) }

fn c_member(enum_name: str, member: str, ordinal: u64): TExpr {
    te(TPathExpr { enum_name = enum_name; member = member; ordinal = ordinal; value = ordinal }, Named { name = enum_name })
}

fn preg_body(): TExpr {
    var names: []str = teko::list::push(teko::list::empty(), "id")
    names = teko::list::push(names, "reg_class")
    names = teko::list::push(names, "is_phys")
    var vals: []TExpr = teko::list::push(teko::list::empty(), c_var("id", i64t()))
    vals = teko::list::push(vals, c_var("reg_class", Named { name = "MRegClass" }))
    vals = teko::list::push(vals, te(TBoolLit { value = true }, boolt()))
    te(TStructInit { field_names = names; field_vals = vals }, mregt())
}

fn c_ctor_fn(name: str, ns: str): TFunction {
    var ps: []parser::Param = teko::list::push(teko::list::empty(), c_param("id", "u32"))
    ps = teko::list::push(ps, c_param("reg_class", "MRegClass"))
    var body: []@TStatement() = teko::list::push(teko::list::empty(), c_ret(preg_body()))
    TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = ps; return_type = mregt(); body = body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; namespace = ns; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn preg_ctors(): []TFunction { teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend")) }

fn preg_call(id: u64, ns: str): TExpr {
    var args: []TExpr = teko::list::push(teko::list::empty(), c_num(id))
    args = teko::list::push(args, c_member("MRegClass", "GPR", 0))
    te(TCall { overload_suffix = ""; callee = path1("preg"); args = args; call_ns = ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }, mregt())
}

fn struct_init_of(e: TExpr): TStructInit {
    match e.kind {
        TStructInit as si => si
        _ => {
            teko::assert::is_true(false)
            TStructInit { field_names = teko::list::empty(); field_vals = teko::list::empty() }
        }
    }
}

fn num_mag_of(e: TExpr): u64 {
    match e.kind {
        TNumber as n => n.value.mag
        _ => {
            teko::assert::is_true(false)
            0 to u64
        }
    }
}

fn is_call(e: TExpr): bool {
    match e.kind {
        TCall => true
        _ => false
    }
}

#test
fn canon_preg_call_becomes_struct_literal() {
    var si = struct_init_of(canonicalize_const_ctors(preg_call(7, "teko::backend"), preg_ctors()))
    teko::assert::is_true(si.field_names.len == 3)
    teko::assert::is_true(si.field_names[0] == "id")
    teko::assert::is_true(si.field_names[1] == "reg_class")
    teko::assert::is_true(si.field_names[2] == "is_phys")
}

#test
fn canon_preg_call_preserves_the_folded_value() {
    var si = struct_init_of(canonicalize_const_ctors(preg_call(7, "teko::backend"), preg_ctors()))
    teko::assert::is_true(num_mag_of(si.field_vals[0]) == 7)
    match si.field_vals[1].kind {
        TPathExpr as p => {
            teko::assert::is_true(p.enum_name == "MRegClass")
            teko::assert::is_true(p.member == "GPR")
        }
        _ => teko::assert::is_true(false)
    }
    match si.field_vals[2].kind {
        TBoolLit as b => teko::assert::is_true(b.value)
        _ => teko::assert::is_true(false)
    }
}

#test
fn canon_preg_call_keeps_the_declared_type() {
    var out = canonicalize_const_ctors(preg_call(1, "teko::backend"), preg_ctors())
    teko::assert::is_true(type_eq(out.type, mregt()))
}

#test
fn canon_reaches_inside_an_array_literal() {
    var elems: []TArrayElem = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = preg_call(0, "teko::backend") })
    elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = preg_call(1, "teko::backend") })
    var arr = te(TArrayLit { elements = elems }, Slice { element = mregt() })
    match canonicalize_const_ctors(arr, preg_ctors()).kind {
        TArrayLit as a => {
            teko::assert::is_true(num_mag_of(struct_init_of(a.elements[0].expr).field_vals[0]) == 0)
            teko::assert::is_true(num_mag_of(struct_init_of(a.elements[1].expr).field_vals[0]) == 1)
        }
        _ => teko::assert::is_true(false)
    }
}

#test
fn canon_leaves_a_non_struct_constructor_alone() {
    var bits: []TExpr = teko::list::push(teko::list::empty(), c_num(0))
    var call = a_call(path2("teko", "f64_from_bits"), bits, f64t())
    teko::assert::is_true(is_call(canonicalize_const_ctors(call, preg_ctors())))
}

#test
fn canon_refuses_an_ambiguous_constructor() {
    var ctors: []TFunction = teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend"))
    ctors = teko::list::push(ctors, c_ctor_fn("preg", "app::other"))
    teko::assert::is_true(is_call(canonicalize_const_ctors(preg_call(3, ""), ctors)))
}

#test
fn canon_ignores_a_function_that_is_not_a_constructor() {
    var plain: []@TItem() = teko::list::push(teko::list::empty(), c_fn("noise", teko::list::push(teko::list::empty(), c_ret(c_num(1)))))
    teko::assert::is_true(collect_const_ctors(plain).len == 0)
}

#test
fn collect_const_ctors_records_the_struct_constructor() {
    var items: []@TItem() = teko::list::push(teko::list::empty(), c_ctor_fn("preg", "teko::backend"))
    teko::assert::is_true(collect_const_ctors(items).len == 1)
}

fn c_str_const(name: str, init: TExpr): TConstDecl {
    TConstDecl { name = name; namespace = "teko::backend"; ty = Str { }; init = init; vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 1; col = 1; guard = parser::pred_true() }
}

fn str_const_init_is(prog: TProgram, name: str, expected: str): bool {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TConstDecl as cd => if cd.name == name { return match cd.init.kind { TStrLit as s => s.text == expected; _ => false } }
            _ => { }
        }
        i++
    }
    false
}

#test
fn collapse_agg_const_resolves_str_reference() {
    var a = c_str_const("A", te(TStrLit { text = "11.0.0" }, Str { }))
    var b = c_str_const("B", c_var("A", Str { }))
    var items: []@TItem() = teko::list::push(teko::list::empty(), a)
    items = teko::list::push(items, b)
    var out = match collapse_agg_const_decls(TProgram { items = items }) { TProgram as p => p; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(str_const_init_is(out, "B", "11.0.0"))
    teko::assert::is_true(str_const_init_is(out, "A", "11.0.0"))
}
