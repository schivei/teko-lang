// src/checker/lambda.tks  (namespace 'teko::checker')

use teko::lexer
use teko::parser

 * `FieldAccess` target to recurse into the way the pre-adoption `r.value = v` spelling did, so it
 * would otherwise never be captured; in `writes` because the capture is by COPY unless the name is
 * `ref`-bound, and only the caller (`type_lambda`, which has the enclosing scope) can tell the two
 * apart and reject the copy case honestly. A `Field`/`Index` target is still walked via `.target`.
 *
 * @param s       the statement to scan
 * @param refs    accumulates every read name (by-reference, write-through)
 * @param bound   accumulates every internally-bound name (by-reference, write-through)
 * @param writes  accumulates every bare-name assignment target (by-reference, write-through)
 */
fn lam_collect_stmt(s: parser::Statement, ref refs: []str, ref bound: []str, ref writes: []str) -> void {
    match s {
        parser::Binding as b => {
            lam_collect_expr(b.value, refs, bound, writes)
            match b.target {
                parser::SimpleName as sn => bound = str_set_add(bound.value, sn.name)
                parser::DestructurePattern as dp => { mut j = 0; loop { if j >= dp.names.len { break }; bound = str_set_add(bound.value, dp.names[j]); j++ } }
            }
        }
        parser::Assign as a => {
            lam_collect_expr(a.value, refs, bound, writes)
            if parser::assign_has_target(a.kind) {
                lam_collect_expr(a.target, refs, bound, writes)
            } else {
                refs = str_set_add(refs.value, a.name)
                writes = str_set_add(writes.value, a.name)
            }
        }
        parser::Return as r => if r.has_value { lam_collect_expr(r.value, refs, bound, writes) } else { }
        parser::LoopStmt as l => { lam_collect_block(l.init, refs, bound, writes); lam_collect_block(l.body, refs, bound, writes) }
        parser::ExprStmt as es => lam_collect_expr(es.expr, refs, bound, writes)
        parser::DeferStmt as d => lam_collect_block(d.body, refs, bound, writes)
        parser::AdoptStmt as a => lam_collect_block(a.body, refs, bound, writes)
        parser::BreakStmt => { }
        parser::ContinueStmt => { }
    }
}
/**
 * Collects the read/bound/written names of a single lambda-body expression `e` — the
 * per-expression-kind dispatch `lam_collect_stmt`/`lam_collect_block` recurse through. An
 * expression carries no assignment of its own, but the BLOCKS inside one (an `if`/`match` arm, a
 * nested lambda body) do, so `writes` is threaded through unchanged. Two arms carry history worth
 * keeping: `Borrow` (`&x`) recurses because a free read transits through the borrowed operand (AL
 * wave F1), and `SafeMethodCall` is the NP-OOP receiver/args walk (issue #116).
 *
 * @param e       the expression to scan
 * @param refs    accumulates every read name (by-reference, write-through)
 * @param bound   accumulates every internally-bound name (by-reference, write-through)
 * @param writes  accumulates every bare-name assignment target (by-reference, write-through)
 */
fn lam_collect_expr(e: parser::Expr, ref refs: []str, ref bound: []str, ref writes: []str) -> void {
    match e.kind {
        parser::Var as v => refs = str_set_add(refs.value, v.name)
        parser::Binary as b => { lam_collect_expr(b.left, refs, bound, writes); lam_collect_expr(b.right, refs, bound, writes) }
        parser::Unary as u => lam_collect_expr(u.operand, refs, bound, writes)
        parser::Compare as c => { lam_collect_expr(c.first, refs, bound, writes); mut i = 0; loop { if i >= c.rest.len { break }; lam_collect_expr(c.rest[i].operand, refs, bound, writes); i++ } }
        parser::Call as cl => { if cl.callee.segments.len == 1 { refs = str_set_add(refs.value, cl.callee.segments[0].name) }; mut i = 0; loop { if i >= cl.args.len { break }; lam_collect_expr(cl.args[i], refs, bound, writes); i++ } }
        parser::IfExpr as f => { lam_collect_expr(f.cond, refs, bound, writes); lam_collect_block(f.then_blk, refs, bound, writes); if f.has_else { lam_collect_block(f.else_blk, refs, bound, writes) } }
        parser::MatchExpr as m => { lam_collect_expr(m.subject, refs, bound, writes); mut i = 0; loop { if i >= m.arms.len { break }; lam_collect_block(m.arms[i].body, refs, bound, writes); i++ } }
        parser::FieldAccess as fa => lam_collect_expr(fa.receiver, refs, bound, writes)
        parser::SafeFieldAccess as sfa => lam_collect_expr(sfa.receiver, refs, bound, writes)
        parser::Coalesce as co => { lam_collect_expr(co.left, refs, bound, writes); lam_collect_expr(co.right, refs, bound, writes) }
        parser::Cast as ct => lam_collect_expr(ct.expr, refs, bound, writes)
        parser::Borrow as b => lam_collect_expr(b.operand, refs, bound, writes)
        parser::MethodCall as mc => { lam_collect_expr(mc.receiver, refs, bound, writes); mut i = 0; loop { if i >= mc.args.len { break }; lam_collect_expr(mc.args[i], refs, bound, writes); i++ } }
        parser::SafeMethodCall as smc => { lam_collect_expr(smc.receiver, refs, bound, writes); mut i = 0; loop { if i >= smc.args.len { break }; lam_collect_expr(smc.args[i], refs, bound, writes); i++ } }
        parser::StructLit as sl => { mut i = 0; loop { if i >= sl.field_vals.len { break }; lam_collect_expr(sl.field_vals[i], refs, bound, writes); i++ } }
        parser::Index as ix => { lam_collect_expr(ix.receiver, refs, bound, writes); lam_collect_expr(ix.index, refs, bound, writes) }
        parser::Interp as in => { mut i = 0; loop { if i >= in.holes.len { break }; lam_collect_expr(in.holes[i], refs, bound, writes); i++ } }
        parser::InExpr as n => { lam_collect_expr(n.lhs, refs, bound, writes); mut i = 0; loop { if i >= n.elems.len { break }; lam_collect_expr(n.elems[i], refs, bound, writes); i++ } }
        parser::ArrayLit as a => { mut i = 0; loop { if i >= a.elements.len { break }; lam_collect_expr(a.elements[i].expr, refs, bound, writes); i++ } }
        parser::Lambda as lam => { mut i = 0; loop { if i >= lam.params.len { break }; bound = str_set_add(bound.value, lam.params[i].name); i++ }; lam_collect_block(lam.body, refs, bound, writes) }
        parser::Number => { }
        parser::StrLit => { }
        parser::ByteLit => { }
        parser::CharLit => { }
        parser::BoolLit => { }
        parser::NullLit => { }
        parser::PathExpr => { }
    }
}

// type a closure literal. `expected` is the target type when known (a binding annotation / call-arg
// param) so an un-annotated parameter infers from it (W10 ruling 3); Void = no target. On success the
// TExpr.type is the closure's Func type. Captures = free vars resolving to ENCLOSING LOCALS (ns ""),
// each by-copy unless it is a `Ref<T>` (by_ref — the only path to shared mutation).
// resolve ONE closure parameter's type: its annotation, else the target's param type at `idx`
// (W10 ruling 3 — inference from the target), else an honest error (annotate or give a target type).
fn lam_param_type(p: parser::LambdaParam, idx: u64, exp_params: []Type, table: TypeTable, ref_ns: str) -> Type | error {
    // (#109 W1) ref_ns = the namespace the lambda is written in; unused until W2's R0-R5 rules.
    if p.has_type { return resolve_type(p.type_ann, table, ref_ns) }
    if idx < exp_params.len { return exp_params[idx] }
    error { message = $"cannot infer the type of closure parameter `{p.name}` — annotate it (`{p.name}: T`) or give the closure a target type" }
}
/**
 * lam_reject_copy_capture_write — reject a lambda body that ASSIGNS to a captured variable whose
 * capture is by COPY. A capture is by reference only when the enclosing binding is itself
 * `Reference`-typed (`type_lambda`'s `by_ref`); for every other type the closure gets a copy, so
 * `mut n = 0; let g = () => { n = 5; 0 }` used to type-check, run, and DISCARD the write with no
 * diagnostic at all — the worst M.3 category, a miscompilation of a program that looks legal.
 *
 * Names bound INSIDE the body (inner `let`s, the lambda's own params — the `bound` set) are the
 * lambda's own locals and are never captures. A name that resolves to a global/function (`ns != ""`)
 * or does not resolve at all is left alone: the body's own typing already reported the latter.
 *
 * True mutable capture is a language design decision, not a bug fix — this names the barrier
 * instead of silently losing the write.
 *
 * @param writes  the bare-name assignment targets the body collected
 * @param bound   the names the body binds internally (its own locals + params)
 * @param env     the ENCLOSING typing environment (decides ref-bound vs copy)
 * @return        `null` when every assigned name is `ref`-bound or body-local
 * @throws        when the body assigns to a by-copy captured variable
 */
fn lam_reject_copy_capture_write(writes: []str, bound: []str, env: Env) -> null | error {
    mut i: u64 = 0
    loop {
        if i >= writes.len { break }
        let nm = writes[i]
        if !str_set_has(bound, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    let by_ref = match b.type { Reference => true; _ => false }
                    if b.ns.len == 0 && !by_ref {
                        return error { message = $"a lambda cannot assign to the captured variable `{nm}` — the capture is by COPY, so the write would be lost; take it as a `ref` parameter instead" }
                    }
                }
                error => { }
            }
        }
        i++
    }
    null
}

fn type_lambda(lam: parser::Lambda, expected: Type, env: Env, table: TypeTable) -> TExpr | error {
    mut exp_params: []Type = teko::list::empty()
    match expected { Func as ef => exp_params = ef.params; _ => { } }
    // 1. resolve parameter types (annotation, else the target's param type — ruling 3)
    mut tparams: []TLambdaParam = teko::list::empty()
    mut cenv = env
    mut i: u64 = 0
    loop {
        if i >= lam.params.len { break }
        let p = lam.params[i]
        let pt = match lam_param_type(p, i, exp_params, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the lambda's enclosing namespace
        tparams = teko::list::push(tparams, TLambdaParam { name = p.name; type = pt })
        cenv = define(cenv, p.name, pt, false)
        i++
    }
    // 2. type the body in the child scope (params visible). The return type is the TARGET's ret when a
    // target type is present (the annotation is authoritative — and handles a `return`-only body whose
    // trailing value is void); otherwise it is inferred from the body's trailing value.
    let tb = match type_block(lam.body, cenv, table) { TypedBlock as bk => bk; error as e => return e }
    let ret = match expected { Func as ef => ef.ret; _ => tblock_type(tb.stmts) }
    // 3. capture analysis — free vars (refs − bound − params) that resolve to an ENCLOSING LOCAL.
    mut refs: []str = teko::list::empty()
    mut bnd: []str = teko::list::empty()
    mut writes: []str = teko::list::empty()
    mut j = 0
    loop { if j >= lam.params.len { break }; bnd = str_set_add(bnd, lam.params[j].name); j++ }
    lam_collect_block(lam.body, refs, bnd, writes)
    match lam_reject_copy_capture_write(writes, bnd, env) { error as e => return e; null => { } }
    mut captures: []TCapture = teko::list::empty()
    mut k = 0
    loop {
        if k >= refs.len { break }
        let nm = refs[k]
        if !str_set_has(bnd, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    if b.ns.len == 0 {   // an enclosing LOCAL (a global/function has ns != "") → a capture
                        let by_ref = match b.type { Reference => true; _ => false }
                        captures = teko::list::push(captures, TCapture { name = nm; type = b.type; by_ref = by_ref })
                    }
                }
                error => { }   // not a local (a global/builtin) or unresolved (body typing already reported it)
            }
        }
        k++
    }
    TExpr { kind = TLambda { params = tparams; body = tb.stmts; captures = captures; ret = ret; lift_id = 0 }; type = Func { params = lam_param_types(tparams); ret = ret; variadic = false; param_names = []; n_required = (lam_param_types(tparams)).len; defaults = [] }; line = 0; col = 0 }
}
fn lam_param_types(ps: []TLambdaParam) -> []Type {
    mut out: []Type = teko::list::empty()
    mut i = 0
    loop { if i >= ps.len { break }; out = teko::list::push(out, ps[i].type); i++ }
    out
}

// ---- operators (the SAME B.22 regimes as check_binary/check_unary/check_compare) ----

// (2026-07-01) `~` — binary string concat, arity-polymorphic with unary `~` (bitwise NOT, see
// type_unary below). Additive precedence, NOT commutative (honest — Governing Law M.3, the same
