use teko::parser

/**
 * flatten_trait_composition — flatten every trait named in a trait's `implements` list into this
 * trait's effective member surface (§9.4 traits-compose-traits). `trait C & A & B` absorbs A's and
 * B's fields/methods/consts into C so C may reference them (self-containment extends to what C
 * composed). Interface names in `implements` are NOT flattened here (they are carried, not merged —
 * check_trait_carries_interface). Same-name members are reconciled by the SHARED merge routine
 * (fold_trait_fields/consts/methods): identical AST absorbs, any difference errors. The walk is
 * transitive (a composed trait may itself compose) and cycle-guarded by the composing-trait chain.
 *
 * @param trait_name  the composing trait
 * @param tb          its own members + its `implements` list
 * @param table       the type table
 * @param seen        the composing-trait chain (cycle guard)
 * @return            the flattened member surface (own ∪ composed, merged), or a merge/cycle error
 * @throws            when the composition is cyclic or a same-name member cannot absorb
 * @since 0.3.1 (§9.4 revised)
 */
pub fn flatten_trait_composition(trait_name: str, tb: parser::TraitBody, table: TypeTable, seen: []str): FoldedMembers | error {
    var si: u64 = 0
    loop {
        if si >= seen.len { break }
        if seen[si] == trait_name { return error { message = $"cyclic trait composition: '{trait_name}' composes itself (directly or transitively)" } }
        si++
    }
    var seen2 = teko::list::push(seen, trait_name)
    var ref_ns = type_ns_of(table, trait_name)
    var split = split_trait_derives(tb.implements, table, ref_ns)
    var fields = tb.fields
    var methods = tb.methods
    var consts = tb.consts
    var i: u64 = 0
    loop {
        if i >= split.traits.len { break }
        var cname = split.traits[i]
        if trait_name_seen_before(split.traits, i, cname) { i++; continue }
        var ctb = match find_trait_body(cname, table) { parser::TraitBody as t => t; error as e => return e }
        var eff = match flatten_trait_composition(cname, ctb, table, seen2) { FoldedMembers as f => f; error as e => return e }
        fields = match fold_trait_fields(trait_name, cname, fields, eff.fields, false) { []parser::Field as f => f; error as e => return e }
        consts = match fold_trait_consts(trait_name, cname, consts, eff.consts) { []parser::ConstDecl as c => c; error as e => return e }
        methods = match fold_trait_methods(trait_name, cname, tb.methods, methods, eff.methods, table) { []parser::Function as m => m; error as e => return e }
        i++
    }
    FoldedMembers { fields = fields; methods = methods; consts = consts }
}

/**
 * self_contained_surface_names — the flat set of member names a trait body may reference through
 * `self` (§9.4 self-containment): every field, method (and property accessor), and member const of
 * the trait's flattened surface.
 *
 * @param surface  the trait's flattened member surface (own ∪ composed)
 * @return         the declared member names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_contained_surface_names(surface: FoldedMembers): []str {
    var names: []str = teko::list::empty()
    var fi: u64 = 0
    loop { if fi >= surface.fields.len { break }; names = teko::list::push(names, surface.fields[fi].name); fi++ }
    var mi: u64 = 0
    loop {
        if mi >= surface.methods.len { break }
        names = teko::list::push(names, surface.methods[mi].name)
        if surface.methods[mi].accessor_prop != "" { names = teko::list::push(names, surface.methods[mi].accessor_prop) }
        mi++
    }
    var ci: u64 = 0
    loop { if ci >= surface.consts.len { break }; names = teko::list::push(names, surface.consts[ci].name); ci++ }
    names
}

/**
 * name_in_list — is `name` present in `names`?
 *
 * @param names  the name list
 * @param name   the candidate name
 * @return       true iff present
 * @since 0.3.1 (§9.4 revised)
 */
fn name_in_list(names: []str, name: str): bool {
    var i: u64 = 0
    loop { if i >= names.len { break }; if names[i] == name { return true }; i++ }
    false
}

/**
 * expr_is_self — is `e` exactly the receiver `self`?
 *
 * @param e  the expression
 * @return   true iff `e` is the `self` variable
 * @since 0.3.1 (§9.4 revised)
 */
fn expr_is_self(e: parser::Expr): bool {
    match e.kind { parser::Var as v => v.name == "self"; _ => false }
}

/**
 * self_ref_stmts — collect every member name referenced through `self` across a statement list, for
 * the self-containment scan (§9.4).
 *
 * @param stmts  the statements to scan
 * @param acc    the names collected so far
 * @return       the accumulated `self.<member>` names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_stmts(stmts: []parser::Statement, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop { if i >= stmts.len { break }; out = self_ref_stmt(stmts[i], out); i++ }
    out
}

/**
 * self_ref_stmt — collect `self.<member>` names referenced by one statement (recursively through its
 * sub-expressions and sub-statements).
 *
 * @param s    the statement to scan
 * @param acc  the names collected so far
 * @return     the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_stmt(s: parser::Statement, acc: []str): []str {
    match s {
        parser::Binding as b => self_ref_expr(b.value, acc)
        parser::Assign as a => self_ref_expr(a.value, if parser::assign_has_target(a.kind) { self_ref_expr(a.target, acc) } else { acc })
        parser::Return as r => self_ref_exprs(r.values, self_ref_expr(r.value, acc))
        parser::LoopStmt as l => self_ref_stmts(l.body, self_ref_stmts(l.init, acc))
        parser::BreakStmt => acc
        parser::ContinueStmt => acc
        parser::ExprStmt as es => self_ref_expr(es.expr, acc)
        parser::DeferStmt as d => self_ref_stmts(d.body, acc)
        parser::AdoptStmt as ad => self_ref_stmts(ad.body, acc)
        parser::BlockStmt as bk => self_ref_stmts(bk.body, acc)
        parser::MultiBind as mb => self_ref_exprs(mb.values, acc)
    }
}

/**
 * self_ref_exprs — collect `self.<member>` names across an expression list.
 *
 * @param es   the expressions to scan
 * @param acc  the names collected so far
 * @return     the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_exprs(es: []parser::Expr, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop { if i >= es.len { break }; out = self_ref_expr(es[i], out); i++ }
    out
}

/**
 * self_ref_expr — collect `self.<member>` names referenced by one expression (recursively). A
 * `FieldAccess`/`MethodCall` whose receiver is exactly `self` contributes its field/method name;
 * every sub-expression is scanned so a `self.X` nested anywhere is caught (§9.4 self-containment).
 *
 * @param e    the expression to scan
 * @param acc  the names collected so far
 * @return     the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_expr(e: parser::Expr, acc: []str): []str {
    match e.kind {
        parser::FieldAccess as fa => {
            var a2 = self_ref_expr(fa.receiver, acc)
            if expr_is_self(fa.receiver) { teko::list::push(a2, fa.field) } else { a2 }
        }
        parser::MethodCall as mc => {
            var a2 = self_ref_exprs(mc.args, self_ref_expr(mc.receiver, acc))
            if expr_is_self(mc.receiver) { teko::list::push(a2, mc.method) } else { a2 }
        }
        parser::Call as c => self_ref_exprs(c.args, acc)
        parser::Binary as b => self_ref_expr(b.right, self_ref_expr(b.left, acc))
        parser::Unary as u => self_ref_expr(u.operand, acc)
        parser::Compare as cm => self_ref_cmpterms(cm.rest, self_ref_expr(cm.first, acc))
        parser::Cast as ca => self_ref_expr(ca.expr, acc)
        parser::Index as ix => self_ref_expr(ix.index, self_ref_expr(ix.receiver, acc))
        parser::IfExpr as ife => self_ref_stmts(ife.else_blk, self_ref_stmts(ife.then_blk, self_ref_expr(ife.cond, acc)))
        parser::MatchExpr as me => self_ref_arms(me.arms, self_ref_expr(me.subject, acc))
        parser::StructLit as sl => self_ref_exprs(sl.field_vals, acc)
        parser::Interp as ip => self_ref_exprs(ip.holes, acc)
        parser::InExpr as ie => self_ref_exprs(ie.elems, self_ref_expr(ie.lhs, acc))
        parser::ArrayLit as al => self_ref_arrayelems(al.elements, acc)
        parser::Lambda as la => self_ref_stmts(la.body, acc)
        parser::Borrow as bo => self_ref_expr(bo.operand, acc)
        parser::Block as bk => self_ref_stmts(bk.body, acc)
        parser::Number => acc
        parser::Var => acc
        parser::StrLit => acc
        parser::ByteLit => acc
        parser::CharLit => acc
        parser::BoolLit => acc
        parser::NullLit => acc
        parser::PathExpr => acc
    }
}

/**
 * self_ref_cmpterms — collect `self.<member>` names across a comparison chain's terms.
 *
 * @param ts   the comparison terms
 * @param acc  the names collected so far
 * @return     the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_cmpterms(ts: []parser::CmpTerm, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop { if i >= ts.len { break }; out = self_ref_expr(ts[i].operand, out); i++ }
    out
}

/**
 * self_ref_arrayelems — collect `self.<member>` names across an array literal's elements.
 *
 * @param els  the array elements
 * @param acc  the names collected so far
 * @return     the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_arrayelems(els: []parser::ArrayElem, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop { if i >= els.len { break }; out = self_ref_expr(els[i].expr, out); i++ }
    out
}

/**
 * self_ref_arms — collect `self.<member>` names across a match expression's arms (guard + body).
 *
 * @param arms  the match arms
 * @param acc   the names collected so far
 * @return      the accumulated names
 * @since 0.3.1 (§9.4 revised)
 */
fn self_ref_arms(arms: []parser::Arm, acc: []str): []str {
    var out = acc
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        if a.has_when { out = self_ref_expr(a.guard, out) }
        out = self_ref_stmts(a.body, out)
        i++
    }
    out
}

/**
 * check_trait_self_contained — every `self.X` a trait body references MUST be declared by the trait
 * itself or by a trait it composes (§9.4 self-containment). A trait pointing at a member it neither
 * declares nor composes is visibly wrong — the error is IN THE TRAIT, not at the composing host. For
 * each `self.<member>` reference in the trait's method bodies, `<member>` must resolve against the
 * trait's flattened surface (own ∪ composed).
 *
 * @param trait_name  the trait being checked (for the diagnostic)
 * @param trait_body  the trait's own members (its method bodies are scanned)
 * @param surface     the trait's flattened member surface (own ∪ composed) to resolve against
 * @return            null when every `self.X` is declared, else the first named error
 * @throws            when a `self.<member>` reference names no declared member of the trait
 * @since 0.3.1 (§9.4 revised)
 */
fn check_trait_self_contained(trait_name: str, trait_body: parser::TraitBody, surface: FoldedMembers): null | error {
    var allowed = self_contained_surface_names(surface)
    var refs: []str = teko::list::empty()
    var mi: u64 = 0
    loop { if mi >= trait_body.methods.len { break }; refs = self_ref_stmts(trait_body.methods[mi].body, refs); mi++ }
    var ri: u64 = 0
    loop {
        if ri >= refs.len { break }
        if !name_in_list(allowed, refs[ri]) {
            return error { message = $"trait '{trait_name}' references `self.{refs[ri]}` but declares no member '{refs[ri]}' — a trait is self-contained: every `self.X` must be declared by the trait or a trait it composes (§9.4)" }
        }
        ri++
    }
    null
}

/**
 * check_trait_carries_interface — a trait declaring `& IFoo` in its `implements` must FULLY implement
 * IFoo from its own flattened surface (§9.4 traits-carry-interface): every method IFoo requires
 * (transitively via extends) is provided, by name + matching signature, among the trait's flattened
 * members. This is the TRAIT-LEVEL full-impl check — it runs on the trait decl, so a `trait T & IFoo`
 * missing a method fails AT THE TRAIT. Reuses the interface-conformance machinery with the trait's
 * flattened methods as `own_methods` and `members_all_public = true` (a mixin's methods flatten as the
 * host's public surface).
 *
 * @param trait_name  the carrying trait
 * @param type_ns     the trait's declaring namespace
 * @param flattened   the trait's flattened member surface
 * @param iface_name  the carried interface (from the trait's `implements`)
 * @param table       the type table
 * @return            null when the trait fully implements the interface, else the conformance error
 * @throws            when a required interface method is missing or mismatched on the trait's surface
 * @since 0.3.1 (§9.4 revised)
 */
fn check_trait_carries_interface(trait_name: str, type_ns: str, flattened: FoldedMembers, iface_name: str, table: TypeTable): error | null {
    check_one_interface(trait_name, type_ns, flattened.methods, iface_name, table, true)
}

/**
 * trait_carried_interface_diags — the carried-interface conformance diagnostics of ONE trait: for
 * every interface named in the trait's `implements`, the trait's flattened surface must fully
 * implement it (§9.4 traits-carry-interface). Trait names in `implements` are composed (flattened),
 * not carried, so they are excluded here.
 *
 * @param reg        the trait's registration (for the diagnostic position)
 * @param trb        the trait body
 * @param surface    the trait's flattened member surface
 * @param table      the whole collected type table
 * @return           one diagnostic per carried interface the trait does not fully implement
 * @since 0.3.1 (§9.4 revised)
 */
fn trait_carried_interface_diags(reg: TypeReg, trb: parser::TraitBody, surface: FoldedMembers, table: TypeTable): []str {
    var type_ns = type_ns_of(table, reg.decl.name)
    var split = split_trait_derives(trb.implements, table, type_ns)
    var diags: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= split.ifaces.len { break }
        match check_trait_carries_interface(reg.decl.name, type_ns, surface, split.ifaces[i], table) {
            error as e => { diags = teko::list::push(diags, decl_diag(reg, e.message)) }
            null => { }
        }
        i++
    }
    diags
}

/**
 * trait_composition_diags — the composition diagnostics of ONE trait declaration (§9.4): flattens the
 * trait's composition to build its self-contained surface (a flatten error — cyclic composition or an
 * un-absorbable composed member — is reported), scans its method bodies for undeclared `self.X`, and
 * checks that every carried interface is fully implemented by the flattened surface.
 *
 * @param reg    the trait's registration (for the diagnostic position)
 * @param trb    the trait body
 * @param table  the whole collected type table
 * @return       the trait's composition diagnostics, in declaration order
 * @since 0.3.1 (§9.4 revised)
 */
fn trait_composition_diags(reg: TypeReg, trb: parser::TraitBody, table: TypeTable): []str {
    var surface = match flatten_trait_composition(reg.decl.name, trb, table, teko::list::empty()) {
        FoldedMembers as f => f
        error as e => return one_diag(decl_diag(reg, e.message))
    }
    var self_diags = match check_trait_self_contained(reg.decl.name, trb, surface) {
        error as e => one_diag(decl_diag(reg, e.message))
        null => teko::list::empty()
    }
    concat_diags(self_diags, trait_carried_interface_diags(reg, trb, surface, table))
}
