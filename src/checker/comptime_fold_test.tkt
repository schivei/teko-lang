use teko::parser
use teko::lexer

fn u16t(): @Type() { Prim { kind = PrimKind::U16 } }

fn u64t(): @Type() { Prim { kind = PrimKind::U64 } }

fn cf_num(value: i64, t: @Type()): TExpr { te(TNumber { is_float = false; value = parser::numint_of_i64(value); fval = 0.0 }, t) }

fn cf_fnum(fval: f64): TExpr { te(TNumber { is_float = true; value = parser::numint_of_u64(0); fval = fval }, f64t()) }

fn cf_bin(op: lexer::TokenKind, l: TExpr, r: TExpr, t: @Type()): TExpr { te(TBinary { op = op; left = l; right = r }, t) }

fn cf_un(op: lexer::TokenKind, o: TExpr, t: @Type()): TExpr { te(TUnary { op = op; operand = o }, t) }

fn cf_cast(e: TExpr, t: @Type()): TExpr { te(TCast { expr = e }, t) }

fn cf_int_is(e: TExpr, want: u64) {
    match eval_const(e, empty_table(), empty_env(), empty_agg()) {
        ConstValue as v => match v.kind {
            CVInt as ci => teko::assert::is_true(ci.bits == want)
            _ => teko::assert::is_true(false)
        }
        error => teko::assert::is_true(false)
    }
}

fn cf_bool_is(e: TExpr, want: bool) {
    match eval_const(e, empty_table(), empty_env(), empty_agg()) {
        ConstValue as v => match v.kind {
            CVBool as cb => teko::assert::is_true(cb.v == want)
            _ => teko::assert::is_true(false)
        }
        error => teko::assert::is_true(false)
    }
}

fn cf_float_is(e: TExpr, want: u64) {
    match eval_const(e, empty_table(), empty_env(), empty_agg()) {
        ConstValue as v => match v.kind {
            CVFloat as cf => teko::assert::is_true(cf.bits == want && !cf.is_f32)
            _ => teko::assert::is_true(false)
        }
        error => teko::assert::is_true(false)
    }
}

fn cf_is_error(e: TExpr) {
    match eval_const(e, empty_table(), empty_env(), empty_agg()) {
        error => teko::assert::is_true(true)
        ConstValue => teko::assert::is_true(false)
    }
}

#test
fn fold_byte_and_bool_literals() {
    cf_int_is(te(TByteLit { value = 200 to byte }, bytet()), 200 to u64)
    cf_bool_is(te(TBoolLit { value = true }, boolt()), true)
    cf_bool_is(te(TBoolLit { value = false }, boolt()), false)
}

#test
fn fold_bitwise_ops() {
    cf_int_is(cf_bin(lexer::TokenKind::Amp, cf_num(255, u8t()), cf_num(15, u8t()), u8t()), 15 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Pipe, cf_num(240, u8t()), cf_num(15, u8t()), u8t()), 255 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Caret, cf_num(255, u8t()), cf_num(15, u8t()), u8t()), 240 to u64)
    cf_int_is(cf_un(lexer::TokenKind::Tilde, cf_num(15, u8t()), u8t()), 240 to u64)
}

#test
fn fold_shift_ops() {
    cf_int_is(cf_bin(lexer::TokenKind::Shl, cf_num(1, u32t()), cf_num(8, u32t()), u32t()), 256 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Shl, cf_num(1, u8t()), cf_num(10, u8t()), u8t()), 4 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Shr, cf_num(255, u8t()), cf_num(1, u8t()), u8t()), 127 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Shr, cf_num(-128, i8t()), cf_num(1, i8t()), i8t()), 192 to u64)
}

#test
fn fold_signed_divrem() {
    cf_int_is(cf_bin(lexer::TokenKind::Slash, cf_num(-7, i8t()), cf_num(2, i8t()), i8t()), 253 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Percent, cf_num(-7, i8t()), cf_num(2, i8t()), i8t()), 255 to u64)
    cf_int_is(cf_bin(lexer::TokenKind::Star, cf_num(-3, i8t()), cf_num(-4, i8t()), i8t()), 12 to u64)
}

#test
fn fold_overflow_const() {
    cf_is_error(cf_bin(lexer::TokenKind::Plus, cf_num(200, u8t()), cf_num(100, u8t()), u8t()))
    cf_is_error(cf_bin(lexer::TokenKind::Plus, cf_num(127, i8t()), cf_num(1, i8t()), i8t()))
    cf_is_error(cf_bin(lexer::TokenKind::Minus, cf_num(0, u8t()), cf_num(1, u8t()), u8t()))
    cf_is_error(cf_bin(lexer::TokenKind::Star, cf_num(128, u8t()), cf_num(2, u8t()), u8t()))
}

#test
fn fold_div0_const() {
    cf_is_error(cf_bin(lexer::TokenKind::Slash, cf_num(5, u8t()), cf_num(0, u8t()), u8t()))
    cf_is_error(cf_bin(lexer::TokenKind::Percent, cf_num(5, u8t()), cf_num(0, u8t()), u8t()))
    var denom = cf_bin(lexer::TokenKind::Minus, cf_num(1, u64t()), cf_num(1, u64t()), u64t())
    cf_is_error(cf_bin(lexer::TokenKind::Slash, cf_num(1, u64t()), denom, u64t()))
}

#test
fn fold_signed_min_div_overflow() {
    cf_is_error(cf_bin(lexer::TokenKind::Slash, cf_num(-128, i8t()), cf_num(-1, i8t()), i8t()))
}

#test
fn fold_cast_ok() {
    cf_int_is(cf_cast(cf_num(255, u16t()), u8t()), 255 to u64)
    cf_int_is(cf_cast(te(TBoolLit { value = true }, boolt()), u8t()), 1 to u64)
    cf_int_is(cf_cast(cf_num(-1, i8t()), i16t()), 65535 to u64)
}

#test
fn fold_float_ops() {
    cf_float_is(cf_fnum(2.5), teko::f64_bits(2.5))
    cf_float_is(cf_bin(lexer::TokenKind::Plus, cf_fnum(1.5), cf_fnum(2.5), f64t()), teko::f64_bits(4.0))
    cf_float_is(cf_un(lexer::TokenKind::Minus, cf_fnum(2.5), f64t()), teko::f64_bits(-2.5))
    cf_is_error(cf_bin(lexer::TokenKind::Slash, cf_fnum(1.0), cf_fnum(0.0), f64t()))
}

fn cf_folds_to_num(e: TExpr, want: i64) {
    match fold_expr(e, empty_table(), empty_env(), empty_agg()) {
        error => teko::assert::is_true(false)
        TExpr as f => match f.kind {
            TNumber as n => teko::assert::is_true(!n.is_float && parser::numint_to_i64(n.value) == want)
            _ => teko::assert::is_true(false)
        }
    }
}

fn cf_fold_errors(e: TExpr) {
    match fold_expr(e, empty_table(), empty_env(), empty_agg()) {
        error => teko::assert::is_true(true)
        TExpr => teko::assert::is_true(false)
    }
}

fn cf_fold_stays_unary(e: TExpr) {
    match fold_expr(e, empty_table(), empty_env(), empty_agg()) {
        error => teko::assert::is_true(false)
        TExpr as f => match f.kind { TUnary => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    }
}

#test
fn fold_expr_folds_scalar_families() {
    cf_folds_to_num(cf_un(lexer::TokenKind::Tilde, cf_cast(cf_num(0, i64t()), u8t()), u8t()), 255)
    cf_folds_to_num(cf_bin(lexer::TokenKind::Amp, cf_num(255, u8t()), cf_num(15, u8t()), u8t()), 15)
    cf_folds_to_num(cf_bin(lexer::TokenKind::Shl, cf_num(1, u32t()), cf_num(8, u32t()), u32t()), 256)
    cf_folds_to_num(cf_un(lexer::TokenKind::Minus, cf_cast(cf_num(1, i64t()), i8t()), i8t()), -1)
}

#test
fn fold_expr_propagates_overflow() {
    cf_fold_errors(cf_bin(lexer::TokenKind::Plus, cf_num(200, u8t()), cf_num(100, u8t()), u8t()))
    cf_fold_errors(cf_bin(lexer::TokenKind::Slash, cf_num(5, u8t()), cf_num(0, u8t()), u8t()))
}

fn cf_let(name: str, value: TExpr): @TStatement() { TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = name }; bound = value.type; value = value } }

fn cf_const_bind(name: str, value: TExpr): @TStatement() { TBinding { kind = parser::BindKind::Const; target = parser::SimpleName { name = name }; bound = value.type; value = value } }

fn cf_mut(name: str, value: TExpr): @TStatement() { TBinding { kind = parser::BindKind::Mut; target = parser::SimpleName { name = name }; bound = value.type; value = value } }

fn cf_destructure(names: []str, value: TExpr): @TStatement() { TBinding { kind = parser::BindKind::Let; target = parser::DestructurePattern { names = names }; bound = value.type; value = value } }

fn cf_var(name: str, t: @Type()): TExpr { te(TVar { name = name; is_func = false; func_ns = "teko::checker" }, t) }

fn cf_return_of(prog: TProgram, name: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => if f.name == name { return cf_block_return(f.body) }
            _ => { }
        }
        i++
    }
    null
}

fn cf_block_return(body: []@TStatement()): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        match body[i] {
            TReturn as r => if r.has_value { return r.value }
            _ => { }
        }
        i++
    }
    null
}

fn cf_return_is_num(prog: TProgram, name: str, want: i64) {
    match cf_return_of(prog, name) {
        TExpr as rv => match rv.kind {
            TNumber as n => teko::assert::is_true(!n.is_float && parser::numint_to_i64(n.value) == want)
            _ => teko::assert::is_true(false)
        }
        null => teko::assert::is_true(false)
    }
}

fn cf_return_is_var(prog: TProgram, name: str) {
    match cf_return_of(prog, name) {
        TExpr as rv => match rv.kind {
            TVar => teko::assert::is_true(true)
            _ => teko::assert::is_true(false)
        }
        null => teko::assert::is_true(false)
    }
}

fn cf_fn_of(name: str, body: []@TStatement()): TProgram {
    var items = teko::list::push(teko::list::empty(), c_fn(name, body))
    match inline_consts(TProgram { items = items }) {
        TProgram as out => return out
        error => {
            teko::assert::is_true(false)
            return TProgram { items = teko::list::empty() }
        }
    }
}

#test
fn cf3_local_const_binding_folds() {
    var init = cf_bin(lexer::TokenKind::Pipe, cf_num(240, u8t()), cf_num(15, u8t()), u8t())
    var let_k = cf_const_bind("k", init)
    var body: []@TStatement() = teko::list::push(teko::list::empty(), let_k)
    body = teko::list::push(body, c_ret(cf_var("k", u8t())))
    cf_return_is_num(cf_fn_of("f", body), "f", 255)
}

#test
fn cf3_destructure_shadow_kills_const() {
    var outer_a = cf_let("a", cf_num(5, u64t()))
    var names = teko::list::push(teko::list::empty(), "a")
    var de = cf_destructure(names, cf_var("pt", Named { name = "Pt" }))
    var body: []@TStatement() = teko::list::push(teko::list::empty(), outer_a)
    body = teko::list::push(body, de)
    body = teko::list::push(body, c_ret(cf_var("a", u64t())))
    cf_return_is_var(cf_fn_of("f", body), "f")
}

#test
fn cf3_walk_covers_expr_and_stmt_arms() {
    var av = cf_var("a", u64t())
    var call_use = tcall1("g", cf_var("a", u64t()), u64t())
    var cast_use = cf_cast(cf_var("a", u64t()), u8t())
    var unary_use = cf_un(lexer::TokenKind::Tilde, cf_var("a", u64t()), u64t())
    var cmp_use = te(TCompare { first = cf_var("a", u64t()); rest = teko::list::push(teko::list::empty(), TCmpTerm { op = lexer::TokenKind::Lt; operand = cf_num(1000, u64t()) }) }, boolt())
    var index_use = te(TIndex { receiver = cf_var("arr", Slice { element = u64t() }); index = cf_var("a", u64t()) }, u64t())
    var struct_use = te(TStructInit { field_names = teko::list::push(teko::list::empty(), "v"); field_vals = teko::list::push(teko::list::empty(), cf_var("a", u64t())) }, Named { name = "N" })
    var in_use = te(TInExpr { lhs = cf_var("a", u64t()); elems = teko::list::push(teko::list::empty(), cf_num(1, u64t())) }, boolt())
    var none_spec = TFSpec { kind = TFSpecNone { } }
    var interp_use = te(TInterp { pieces = teko::list::push(teko::list::push(teko::list::empty(), "x"), ""); holes = teko::list::push(teko::list::empty(), cf_var("a", u64t())); specs = teko::list::push(teko::list::empty(), none_spec) }, strt())
    var dyn_spec = TFSpec { kind = TFSpecDynamic { args = teko::list::push(teko::list::empty(), cf_var("a", u64t())) } }
    var interp_dyn = te(TInterp { pieces = teko::list::push(teko::list::push(teko::list::empty(), "y"), ""); holes = teko::list::push(teko::list::empty(), cf_var("a", u64t())); specs = teko::list::push(teko::list::empty(), dyn_spec) }, strt())
    var array_use = te(TArrayLit { elements = teko::list::push(teko::list::empty(), TArrayElem { is_spread = false; expr = cf_var("a", u64t()) }) }, Slice { element = u64t() })
    var field_use = te(TFieldAccess { receiver = cf_var("s", Named { name = "N" }); field = "v" }, u64t())

    var body: []@TStatement() = teko::list::push(teko::list::empty(), cf_let("a", cf_num(255, u64t())))
    body = teko::list::push(body, cf_mut("m", cf_num(0, u64t())))
    body = teko::list::push(body, TAssign { kind = parser::AssignKind::Simple; name = "m"; op = lexer::TokenKind::Assign; bound = u64t(); value = cf_var("a", u64t()); deref = false; target = no_texpr() })
    body = teko::list::push(body, TAssign { kind = parser::AssignKind::Field; name = ""; op = lexer::TokenKind::Assign; bound = u64t(); value = cf_var("a", u64t()); deref = false; target = field_use })
    body = teko::list::push(body, texpr_stmt(call_use))
    body = teko::list::push(body, texpr_stmt(cast_use))
    body = teko::list::push(body, texpr_stmt(unary_use))
    body = teko::list::push(body, texpr_stmt(cmp_use))
    body = teko::list::push(body, texpr_stmt(index_use))
    body = teko::list::push(body, texpr_stmt(struct_use))
    body = teko::list::push(body, texpr_stmt(in_use))
    body = teko::list::push(body, texpr_stmt(interp_use))
    body = teko::list::push(body, texpr_stmt(interp_dyn))
    body = teko::list::push(body, texpr_stmt(array_use))
    body = teko::list::push(body, texpr_stmt(te(TBorrow { operand = cf_var("m", u64t()) }, Reference { inner = u64t() })))
    var loopbody: []@TStatement() = teko::list::push(teko::list::empty(), texpr_stmt(cf_bin(lexer::TokenKind::Plus, cf_var("li", u64t()), cf_num(0, u64t()), u64t())))
    loopbody = teko::list::push(loopbody, TBreakStmt { label = "" })
    loopbody = teko::list::push(loopbody, TContinueStmt { label = "" })
    var loop_init = teko::list::push(teko::list::empty(), cf_let("li", cf_bin(lexer::TokenKind::Shl, cf_var("a", u64t()), cf_num(1, u64t()), u64t())))
    body = teko::list::push(body, TLoopStmt { label = ""; init = loop_init; body = loopbody })
    body = teko::list::push(body, TDeferStmt { body = teko::list::push(teko::list::empty(), texpr_stmt(cf_var("a", u64t()))) })
    body = teko::list::push(body, TAdoptStmt { name = "reg"; body = teko::list::push(teko::list::empty(), texpr_stmt(cf_var("a", u64t()))) })
    body = teko::list::push(body, c_ret(av))

    var out = cf_fn_of("walk", body)
    cf_return_is_num(out, "walk", 255)
}

#test
fn cf3_match_arm_pattern_shadow() {
    var bind_pat: @Pattern() = parser::BindPattern { type_name = cf3_path("Some"); has_binding = true; binding = "a"; is_slice = false; slice_type = null; type_args = teko::list::empty() }
    var field_pat: @Pattern() = parser::FieldPattern { type_name = cf3_path("Pt"); fields = teko::list::push(teko::list::empty(), "a") }
    var alt_inner: @Pattern() = parser::BindPattern { type_name = cf3_path("Other"); has_binding = true; binding = "w"; is_slice = false; slice_type = null; type_args = teko::list::empty() }
    var alt_wild: @Pattern() = parser::WildcardPattern { }
    var alt_opts: []@Pattern() = teko::list::push(teko::list::empty(), alt_wild)
    alt_opts = teko::list::push(alt_opts, alt_inner)
    var alt_pat: @Pattern() = parser::AltPattern { options = alt_opts }
    var arm_bind = TArm { pattern = bind_pat; has_when = false; guard = no_texpr(); body = teko::list::push(teko::list::empty(), texpr_stmt(cf_bin(lexer::TokenKind::Amp, cf_var("a", u64t()), cf_num(1, u64t()), u64t()))) }
    var arm_field = TArm { pattern = field_pat; has_when = true; guard = cf_bin(lexer::TokenKind::Amp, cf_var("a", u64t()), cf_num(1, u64t()), u64t()); body = teko::list::push(teko::list::empty(), texpr_stmt(cf_num(0, u64t()))) }
    var arm_alt = TArm { pattern = alt_pat; has_when = false; guard = no_texpr(); body = teko::list::push(teko::list::empty(), texpr_stmt(cf_var("a", u64t()))) }
    var arms: []TArm = teko::list::push(teko::list::empty(), arm_bind)
    arms = teko::list::push(arms, arm_field)
    arms = teko::list::push(arms, arm_alt)
    var me = te(TMatchExpr { subject = cf_var("a", u64t()); arms = arms }, Void { })
    var body: []@TStatement() = teko::list::push(teko::list::empty(), cf_let("a", cf_num(255, u64t())))
    body = teko::list::push(body, texpr_stmt(me))
    body = teko::list::push(body, c_ret(cf_var("a", u64t())))
    cf_return_is_num(cf_fn_of("m", body), "m", 255)
}

fn cf3_path(name: str): parser::Path { parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) } }

#test
fn cf3_lambda_body_not_propagated() {
    var lam_body = teko::list::push(teko::list::empty(), texpr_stmt(cf_var("a", u64t())))
    var lam_ty = Func { params = teko::list::empty(); ret = u64t(); variadic = false; param_names = teko::list::empty(); n_required = 0; defaults = teko::list::empty(); ret_extra = teko::list::empty() }
    var lam = te(TLambda { params = teko::list::empty(); body = lam_body; captures = teko::list::empty(); ret = u64t(); lift_id = 0 }, lam_ty)
    var body: []@TStatement() = teko::list::push(teko::list::empty(), cf_let("a", cf_num(255, u64t())))
    body = teko::list::push(body, cf_let("f", lam))
    body = teko::list::push(body, c_ret(cf_var("a", u64t())))
    var out = cf_fn_of("lz", body)
    cf3_assert_lambda_body_var(out, "lz")
}

fn cf3_assert_lambda_body_var(prog: TProgram, name: str) {
    match cf_second_binding_value(prog, name) {
        TExpr as v => match v.kind {
            TLambda as lam => cf3_assert_first_stmt_var(lam.body)
            _ => teko::assert::is_true(false)
        }
        null => teko::assert::is_true(false)
    }
}

fn cf_second_binding_value(prog: TProgram, name: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => if f.name == name && f.body.len > 1 {
                match f.body[1] { TBinding as b => return b.value; _ => return null }
            }
            _ => { }
        }
        i++
    }
    null
}

fn cf3_assert_first_stmt_var(body: []@TStatement()) {
    teko::assert::is_true(body.len > 0)
    match body[0] {
        TExprStmt as es => match es.expr.kind {
            TVar => teko::assert::is_true(true)
            _ => teko::assert::is_true(false)
        }
        _ => teko::assert::is_true(false)
    }
}

fn cf_cvint(bits: u64, ty: @Type()): ConstValue { ConstValue { kind = CVInt { bits = bits; ty = ty } } }

fn cf_spec_static(s: str): TFSpec { TFSpec { kind = TFSpecStatic { s = s } } }

fn cf_spec_none(): TFSpec { TFSpec { kind = TFSpecNone { } } }

fn cf_fmt_is(v: ConstValue, sp: TFSpec, ty: @Type(), want: str) {
    match comptime_format(v, sp, ty) {
        error => teko::assert::is_true(false)
        []byte as b => teko::assert::is_true(str_of_bytes(b) == want)
    }
}

fn cf_fmt_declined(v: ConstValue, sp: TFSpec, ty: @Type()) {
    match comptime_format(v, sp, ty) {
        error => teko::assert::is_true(true)
        []byte => teko::assert::is_true(false)
    }
}

#test
fn fmt_hex_family() {
    cf_fmt_is(cf_cvint(255 to u64, u64t()), cf_spec_static("X"), u64t(), "FF")
    cf_fmt_is(cf_cvint(255 to u64, u64t()), cf_spec_static("x"), u64t(), "ff")
    cf_fmt_is(cf_cvint(0 to u64, u64t()), cf_spec_static("X"), u64t(), "0")
    cf_fmt_is(cf_cvint(3735928559 to u64, u64t()), cf_spec_static("X"), u64t(), "DEADBEEF")
    cf_fmt_is(cf_cvint(3735928559 to u64, u64t()), cf_spec_static("x"), u64t(), "deadbeef")
    cf_fmt_is(cf_cvint(~(0 to u64), u64t()), cf_spec_static("X"), u64t(), "FFFFFFFFFFFFFFFF")
    cf_fmt_is(cf_cvint(255 to u64, i8t()), cf_spec_static("X"), i8t(), "FFFFFFFFFFFFFFFF")
    cf_fmt_is(cf_cvint(4294967291 to u64, i32t()), cf_spec_static("X"), i32t(), "FFFFFFFFFFFFFFFB")
}

#test
fn fmt_binary_family() {
    cf_fmt_is(cf_cvint(255 to u64, u64t()), cf_spec_static("b"), u64t(), "11111111")
    cf_fmt_is(cf_cvint(0 to u64, u64t()), cf_spec_static("b"), u64t(), "0")
    cf_fmt_is(cf_cvint(5 to u64, u8t()), cf_spec_static("b"), u8t(), "101")
}

#test
fn fmt_none_decimal() {
    cf_fmt_is(cf_cvint(255 to u64, u64t()), cf_spec_none(), u64t(), "255")
    cf_fmt_is(cf_cvint(0 to u64, u64t()), cf_spec_none(), u64t(), "0")
    cf_fmt_is(cf_cvint(~(0 to u64), u64t()), cf_spec_none(), u64t(), "18446744073709551615")
    cf_fmt_is(cf_cvint(~(0 to u64), i64t()), cf_spec_none(), i64t(), "-1")
    cf_fmt_is(cf_cvint(255 to u64, i8t()), cf_spec_none(), i8t(), "-1")
    cf_fmt_is(cf_cvint((1 to u64) << 63, i64t()), cf_spec_none(), i64t(), "-9223372036854775808")
}

#test
fn fmt_d_width() {
    cf_fmt_is(cf_cvint(42 to u64, i64t()), cf_spec_static("d"), i64t(), "42")
    cf_fmt_is(cf_cvint(42 to u64, i64t()), cf_spec_static("d5"), i64t(), "00042")
    cf_fmt_is(cf_cvint(~(0 to u64), i64t()), cf_spec_static("d5"), i64t(), "-0001")
    cf_fmt_is(cf_cvint(~(0 to u64), i64t()), cf_spec_static("d"), i64t(), "-1")
}

#test
fn fmt_n_thousands() {
    cf_fmt_is(cf_cvint(1000000 to u64, u64t()), cf_spec_static("n"), u64t(), "1,000,000")
    cf_fmt_is(cf_cvint(255 to u64, u64t()), cf_spec_static("n"), u64t(), "255")
    cf_fmt_is(cf_cvint(1234 to u64, i64t()), cf_spec_static("n"), i64t(), "1,234")
    cf_fmt_is(cf_cvint(~(0 to u64), i64t()), cf_spec_static("n"), i64t(), "-1")
}

#test
fn fmt_none_bool_byte_bytes() {
    cf_fmt_is(ConstValue { kind = CVBool { v = true } }, cf_spec_none(), boolt(), "true")
    cf_fmt_is(ConstValue { kind = CVBool { v = false } }, cf_spec_none(), boolt(), "false")
    cf_fmt_is(cf_cvint(200 to u64, bytet()), cf_spec_none(), bytet(), "200")
    cf_fmt_is(ConstValue { kind = CVBytes { data = bytes_of_str("hi!") } }, cf_spec_none(), strt(), "hi!")
    cf_fmt_is(ConstValue { kind = CVBytes { data = bytes_of_str("A") } }, cf_spec_none(), Char { }, "A")
}

#test
fn fmt_declines_float_and_dynamic() {
    cf_fmt_declined(cf_cvint(42 to u64, u64t()), cf_spec_static("f2"), u64t())
    cf_fmt_declined(cf_cvint(42 to u64, u64t()), cf_spec_static("e"), u64t())
    cf_fmt_declined(cf_cvint(42 to u64, u64t()), cf_spec_static("g"), u64t())
    cf_fmt_declined(cf_cvint(42 to u64, u64t()), cf_spec_static("p"), u64t())
    cf_fmt_declined(cf_cvint(42 to u64, u64t()), TFSpec { kind = TFSpecDynamic { args = teko::list::empty() } }, u64t())
    cf_fmt_declined(ConstValue { kind = CVFloat { bits = teko::f64_bits(1.5); is_f32 = false } }, cf_spec_none(), f64t())
}

fn empty_agg(): AggConstMap { ScalarConstMap { names = teko::list::empty(); nss = teko::list::empty(); inits = teko::list::empty() } }

fn cf_index_is(ix: TExpr, agg: AggConstMap, want: u64) {
    match eval_const(ix, empty_table(), empty_env(), agg) {
        ConstValue as v => match v.kind {
            CVInt as ci => teko::assert::is_true(ci.bits == want)
            _ => teko::assert::is_true(false)
        }
        error => teko::assert::is_true(false)
    }
}

fn cf_str(text: str): TExpr { te(TStrLit { text = text }, strt()) }

fn cf_field(recv: TExpr, field: str, t: @Type()): TExpr { te(TFieldAccess { receiver = recv; field = field }, t) }

fn cf_slice_lit(elems: []TExpr, elemty: @Type()): TExpr {
    var es: []TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= elems.len { break }
        es = teko::list::push(es, TArrayElem { is_spread = false; expr = elems[i] })
        i++
    }
    te(TArrayLit { elements = es }, Slice { element = elemty })
}

fn cf_point_init(): TExpr {
    var names = teko::list::push(teko::list::push(teko::list::empty(), "x"), "y")
    var vals = teko::list::push(teko::list::push(teko::list::empty(), cf_num(30, i64t())), cf_num(12, i64t()))
    te(TStructInit { field_names = names; field_vals = vals }, Named { name = "Point" })
}

fn cf_agg_str(): AggConstMap {
    ScalarConstMap { names = teko::list::push(teko::list::empty(), "GREETING"); nss = teko::list::push(teko::list::empty(), "teko::checker"); inits = teko::list::push(teko::list::empty(), cf_str("hello")) }
}

fn cf_agg_first_is(e: TExpr, agg: AggConstMap, want_len: u64, first: u64) {
    match eval_const(e, empty_table(), empty_env(), agg) {
        error => teko::assert::is_true(false)
        ConstValue as v => match v.kind {
            CVAgg as ag => {
                teko::assert::is_true(ag.elems.len == want_len)
                match ag.elems[0].kind {
                    CVInt as ci => teko::assert::is_true(ci.bits == first)
                    _ => teko::assert::is_true(false)
                }
            }
            _ => teko::assert::is_true(false)
        }
    }
}

#test
fn eval_const_folds_inline_agg_len() {
    var elems = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), cf_num(10, i64t())), cf_num(20, i64t())), cf_num(30, i64t()))
    cf_int_is(cf_field(cf_slice_lit(elems, i64t()), "len", u64t()), 3 to u64)
}

#test
fn eval_const_folds_module_string_len() {
    cf_index_is(cf_field(cf_var("GREETING", strt()), "len", u64t()), cf_agg_str(), 5 to u64)
}

#test
fn eval_const_folds_inline_struct_field() {
    cf_int_is(cf_field(cf_point_init(), "x", i64t()), 30 to u64)
    cf_int_is(cf_field(cf_point_init(), "y", i64t()), 12 to u64)
}

#test
fn eval_const_folds_str_to_bytes() {
    cf_agg_first_is(cf_cast(cf_str("hi"), Slice { element = bytet() }), empty_agg(), 2 to u64, 0x68 to u64)
}

fn cf_bytes_eq(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn cf_elems_eq(a: []ConstValue, b: []ConstValue): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if !cf_cv_eq(a[i], b[i]) { return false }
        i++
    }
    true
}

fn cf_cv_eq(a: ConstValue, b: ConstValue): bool {
    match a.kind {
        CVInt as ai => match b.kind { CVInt as bi => ai.bits == bi.bits; _ => false }
        CVBool as ab => match b.kind { CVBool as bb => ab.v == bb.v; _ => false }
        CVFloat as af => match b.kind { CVFloat as bf => af.bits == bf.bits && af.is_f32 == bf.is_f32; _ => false }
        CVBytes as aby => match b.kind { CVBytes as bby => cf_bytes_eq(aby.data, bby.data); _ => false }
        CVAgg as aag => match b.kind { CVAgg as bag => cf_elems_eq(aag.elems, bag.elems); _ => false }
    }
}

fn cf_rt(v: ConstValue, ty: @Type(), table: TypeTable) {
    var lit = match comptime_literal_of(v, ty, table, 0 to u32, 0 to u32) {
        TExpr as e => e
        null => { teko::assert::is_true(false); return }
    }
    match eval_const(lit, table, empty_env(), empty_agg()) {
        ConstValue as re => teko::assert::is_true(cf_cv_eq(v, re))
        error => teko::assert::is_true(false)
    }
}

fn cf_rt_null(v: ConstValue, ty: @Type()) {
    match comptime_literal_of(v, ty, empty_table(), 0 to u32, 0 to u32) {
        null => teko::assert::is_true(true)
        TExpr => teko::assert::is_true(false)
    }
}

fn cf_point_table(): TypeTable {
    var fields = teko::list::push(teko::list::push(teko::list::empty(), fv_field("x", named_t("i64"))), fv_field("y", named_t("i64")))
    var item = fv_struct_item_derives("Point", fields, teko::list::empty())
    fv_table(teko::list::push(teko::list::empty(), item))
}

#test
fn comptime_literal_of_roundtrips_scalars() {
    cf_rt(ConstValue { kind = CVInt { bits = 42 to u64; ty = i64t() } }, i64t(), empty_table())
    cf_rt(ConstValue { kind = CVBool { v = true } }, boolt(), empty_table())
    cf_rt(ConstValue { kind = CVBool { v = false } }, boolt(), empty_table())
    cf_rt(ConstValue { kind = CVFloat { bits = teko::f64_bits(3.5); is_f32 = false } }, f64t(), empty_table())
    cf_rt(ConstValue { kind = CVBytes { data = bytes_of_str("hello") } }, strt(), empty_table())
    cf_rt(ConstValue { kind = CVBytes { data = bytes_of_str("A") } }, Char { }, empty_table())
}

fn cf_cvagg(elems: []ConstValue): ConstValue { ConstValue { kind = CVAgg { elems = elems } } }

#test
fn comptime_literal_of_roundtrips_slices() {
    var e10 = ConstValue { kind = CVInt { bits = 10 to u64; ty = i64t() } }
    var e20 = ConstValue { kind = CVInt { bits = 20 to u64; ty = i64t() } }
    var e30 = ConstValue { kind = CVInt { bits = 30 to u64; ty = i64t() } }
    var flat = cf_cvagg(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), e10), e20), e30))
    cf_rt(flat, Slice { element = i64t() }, empty_table())
    var inner_a = cf_cvagg(teko::list::push(teko::list::push(teko::list::empty(), e10), e20))
    var inner_b = cf_cvagg(teko::list::push(teko::list::empty(), e30))
    var nested = cf_cvagg(teko::list::push(teko::list::push(teko::list::empty(), inner_a), inner_b))
    cf_rt(nested, Slice { element = Slice { element = i64t() } }, empty_table())
}

#test
fn comptime_literal_of_roundtrips_struct() {
    var ex = ConstValue { kind = CVInt { bits = 30 to u64; ty = i64t() } }
    var ey = ConstValue { kind = CVInt { bits = 12 to u64; ty = i64t() } }
    var point = cf_cvagg(teko::list::push(teko::list::push(teko::list::empty(), ex), ey))
    cf_rt(point, Named { name = "Point" }, cf_point_table())
}

#test
fn comptime_literal_of_declines_no_literal_form() {
    cf_rt_null(ConstValue { kind = CVFloat { bits = teko::f64_bits(1.0); is_f32 = true } }, f64t())
    var agg = cf_cvagg(teko::list::push(teko::list::empty(), ConstValue { kind = CVInt { bits = 1 to u64; ty = i64t() } }))
    cf_rt_null(agg, boolt())
}
