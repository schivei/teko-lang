use teko::list
use teko::parser

/**
 * collect_diagnostics — every diagnostic of `program` a build would report — its type ERRORS (the
 * `file:line:col: msg` lines `type_program_with_deps_pre_mono` collects) PLUS every WARNING the two
 * checker passes that only used to print to stderr would have raised (`warnings.tks::collect_warnings`
 * — unused private functions, redundant D1 casts; crumb C) — WITHOUT raising an error at the first bad
 * declaration. This is the single seam the LSP consumes from the checker: it reuses the existing
 * declaration-boundary walk with an EMPTY dependency program and a no-op progress hook, so the ERROR
 * half reports EXACTLY the set a build would report — the whole program, not a prefix truncated at the
 * first defect — and the WARNING half is re-derived from that same walk's typed output (`PreMono.prog`)
 * rather than threaded live through the deep expression typer (`warnings.tks`'s own module doc).
 * Monomorphization is deliberately skipped: the diagnostics live in the pre-mono `PreMono`, and a
 * partial program (one carrying error diagnostics) must never be monomorphized.
 *
 * @param program  the merged, un-typed project program (from assembly, or a single open document)
 * @return         each project error, THEN each warning, in report order (empty ⇒ the program is
 *                 clean AND carries no finding)
 * @since 0.3.1.0 (LSP crumb A; warnings added crumb C)
 */
pub fn collect_diagnostics(program: parser::Program) -> []str {
    let empty_dep = TProgram { items = teko::list::empty() }
    match type_program_with_deps_pre_mono(program, empty_dep, lsp_no_progress) {
        PreMono as pre => concat_diags(pre.diags, collect_warnings(pre.prog))
        error as e => teko::list::push(teko::list::empty(), e.message)
    }
}

/**
 * collect_diagnostics_structured — every diagnostic of `program`, as `Diagnostic` values with a REAL,
 * source-known severity (crumb D, `docs/design/lsp-teko.md` §5.3): the pre-mono walk's own ERROR list
 * stamped `DiagLevel::Error`, then `warnings.tks::collect_warnings`'s findings stamped
 * `DiagLevel::Warning` — severity known at EACH list's own source, never re-derived downstream by
 * sniffing the rendered message text for a `"warning:"` marker, the fragile heuristic `collect_diagnostics`
 * (crumb A)'s `[]str` callers still have to apply for themselves. Reuses the EXACT SAME pre-mono walk
 * `collect_diagnostics` runs — same empty dependency program, same no-op progress hook, same skipped
 * monomorphization — so the two seams report the identical finding SET; only the SHAPE differs
 * (`[]Diagnostic` here, `[]str` there). This is an ADDITIVE post-pass over the already-typed `PreMono`
 * (like `warnings.tks`'s own seam), never a rewire of the recursive expression typer.
 *
 * @param program  the merged, un-typed project program (from assembly, or a single open document)
 * @return         each project error, THEN each warning, as ranged, severity-known `Diagnostic` values
 * @since 0.3.1.0 (LSP crumb D)
 */
pub fn collect_diagnostics_structured(program: parser::Program) -> []Diagnostic {
    let files = program_files(program)
    let empty_dep = TProgram { items = teko::list::empty() }
    match type_program_with_deps_pre_mono(program, empty_dep, lsp_no_progress) {
        PreMono as pre => {
            let errs = structure_diags(pre.diags, files, DiagLevel::Error)
            let warns = structure_diags(collect_warnings(pre.prog), files, DiagLevel::Warning)
            concat_structured_diags(errs, warns)
        }
        error as e => teko::list::push(teko::list::empty(), to_diagnostic(e.message, files, DiagLevel::Error))
    }
}
