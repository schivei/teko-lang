use teko::lexer
use teko::parser

/**
 * index_carrier — the sign-magnitude value a const index `CVInt` denotes, or null when its type is
 * not an integer the fold carries. Reuses `int_info`/`cv_int_to_numint`, the same reconstruction
 * `literal_of` uses.
 *
 * @param ci  the folded index integer
 * @return    the index's value, or null when unrepresentable
 * @since #comptime-fold
 */
fn index_carrier(ci: CVInt) -> parser::NumInt | null {
    match int_info(ci.ty) {
        error => null
        IntInfo as info => cv_int_to_numint(ci.bits, info)
    }
}

/**
 * eval_field_expr — evaluate a `TFieldAccess` of a const receiver (CF4c/CF4d): `.len` of a const
 * aggregate or const string yields its element/byte count (`eval_len_field`); a struct field of a const
 * struct yields that field's const value (`eval_struct_field`). The `cf_can_fold_field` gate proves the
 * receiver is const and the field foldable before the fold reaches here, so a non-foldable field is a
 * soft located error (the fold then leaves the access runtime).
 *
 * @param fa     the typed field-access node
 * @param e      the enclosing expression (its type is the field's type; positions any error)
 * @param table  the type table (forwarded to the receiver/field eval)
 * @param env    the environment (forwarded to the receiver/field eval)
 * @param agg    the module-aggregate resolution table (resolves a module-const receiver)
 * @return       the field's comptime value, or a located error
 * @since #comptime-fold
 */
fn eval_field_expr(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap) -> ConstValue | error {
    if is_len_field(fa) { return eval_len_field(fa, e, table, env, agg) }
    eval_struct_field(fa, e, table, env, agg)
}

/**
 * is_len_field — is `fa` the built-in `.len` of a `str` or slice receiver (CF4d)? The typer resolves
 * `.len` on a `str`/`[]T` to a `u64` BEFORE the struct-field path, so a `len` field of a user struct
 * (its receiver a `Named` type) is NOT this case and stays the struct-field fold.
 *
 * @param fa  the typed field-access node
 * @return    true iff `fa` is the length of a string/slice receiver
 * @since #comptime-fold
 */
fn is_len_field(fa: TFieldAccess) -> bool {
    if fa.field != "len" { return false }
    match fa.receiver.type {
        Str => true
        Slice => true
        _ => false
    }
}

/**
 * eval_len_field — evaluate `recv.len` of a const string/aggregate receiver (CF4d): fold the receiver
 * to its `CVBytes` (a string's raw bytes) or `CVAgg` (an array's elements) and return the count as the
 * field's `u64` type. A receiver that folds to neither is a soft located error (behavior preserved: the
 * access stays runtime).
 *
 * @param fa     the typed field-access node (`fa.field == "len"`)
 * @param e      the enclosing expression (its `u64` type is the count's type; positions any error)
 * @param table  the type table (forwarded to the receiver eval)
 * @param env    the environment (forwarded to the receiver eval)
 * @param agg    the module-aggregate resolution table (resolves a module-const receiver)
 * @return       the length as a `u64` comptime value, or a located error
 * @since #comptime-fold
 */
fn eval_len_field(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap) -> ConstValue | error {
    let recv = match eval_const(fa.receiver, table, env, agg) { error as x => return x; ConstValue as v => v }
    match value_length(recv) {
        null => const_form_error("comptime fold: `.len` receiver is not a const string or aggregate (#comptime-fold)", e)
        u64 as n => cv_int(n, e.type)
    }
}

/**
 * value_length — the element/byte count of a folded aggregate/string value, or null when the value is
 * neither (a scalar has no `.len`). A `CVAgg`'s length is its element count; a `CVBytes`'s length is its
 * byte count (the same count `.len` reads at runtime for a `str`/`[]byte`).
 *
 * @param v  the folded receiver value
 * @return   the length, or null when `v` has no length
 * @since #comptime-fold
 */
fn value_length(v: ConstValue) -> u64 | null {
    match v.kind {
        CVAgg as ag => ag.elems.len
        CVBytes as cb => cb.data.len
        _ => null
    }
}

/**
 * eval_struct_field — evaluate `recv.field` of a const struct receiver (CF4c): resolve the receiver to
 * its `TStructInit`, pick the initializer of the named field, and evaluate that. A receiver that is not
 * a const struct, or a field the struct-init does not carry, is a soft located error (the fold then
 * leaves the access runtime).
 *
 * @param fa     the typed field-access node
 * @param e      the enclosing expression (its type is the field's type; positions any error)
 * @param table  the type table (forwarded to the field-value eval)
 * @param env    the environment (forwarded to the field-value eval)
 * @param agg    the module-aggregate resolution table (resolves a module-const struct receiver)
 * @return       the field's comptime value, or a located error
 * @since #comptime-fold
 */
fn eval_struct_field(fa: TFieldAccess, e: TExpr, table: TypeTable, env: Env, agg: AggConstMap) -> ConstValue | error {
    match struct_field_init(fa.receiver, fa.field, agg) {
        null => const_form_error("comptime fold: field-access receiver is not a const struct (#comptime-fold)", e)
        TExpr as fv => eval_const(fv, table, env, agg)
    }
}

/**
 * struct_field_init — the initializer expression of field `field` in the const struct `recv` names, or
 * null when `recv` is not a resolvable const struct or carries no such field. Resolves an in-tree
 * `TStructInit` receiver directly and a module-const-struct `TVar` receiver through the aggregate map
 * (CF4c); a local struct binding — deliberately NOT propagated by `propagate_locals` — resolves to null
 * and stays runtime.
 *
 * @param recv   the field-access receiver expression
 * @param field  the accessed field's name
 * @param agg    the module-aggregate resolution table
 * @return       the field's initializer expression, or null
 * @since #comptime-fold
 */
fn struct_field_init(recv: TExpr, field: str, agg: AggConstMap) -> TExpr | null {
    match resolve_struct_init(recv, agg) {
        null => null
        TStructInit as si => field_init_by_name(si, field)
    }
}

/**
 * resolve_struct_init — the `TStructInit` a const-struct receiver denotes: an in-tree struct literal
 * directly, or a module-const-struct `TVar` resolved through the aggregate map (CF4c). Every other
 * receiver (a local binding, a runtime leaf, a non-struct const) resolves to null, so the field access
 * stays runtime.
 *
 * @param recv  the field-access receiver expression
 * @param agg   the module-aggregate resolution table
 * @return      the struct initializer, or null when the receiver is not a const struct
 * @since #comptime-fold
 */
fn resolve_struct_init(recv: TExpr, agg: AggConstMap) -> TStructInit | null {
    match recv.kind {
        TStructInit as si => si
        TVar as v => resolve_struct_init_var(v, agg)
        _ => null
    }
}

/**
 * resolve_struct_init_var — the `TStructInit` a `TVar` receiver names when it is a module const struct
 * recorded in `agg`, or null otherwise (a fn-value, a local, a scalar/non-struct const, a
 * different-module name). Mirrors `eval_agg_ref`'s resolution but keeps only the struct-init case.
 *
 * @param v    the reference node
 * @param agg  the module-aggregate resolution table
 * @return     the referenced struct initializer, or null
 * @since #comptime-fold
 */
fn resolve_struct_init_var(v: TVar, agg: AggConstMap) -> TStructInit | null {
    if v.is_func { return null }
    match agg_const_init(agg, v.name, v.func_ns) {
        null => null
        TExpr as init => match init.kind {
            TStructInit as si => si
            _ => null
        }
    }
}

/**
 * field_init_by_name — the initializer of the field named `field` in the struct-init `si`, or null when
 * `si` carries no such field. `si.field_names`/`si.field_vals` are PARALLEL and in the struct's declared
 * order (the checker reorders), so a name lookup returns the matching value.
 *
 * @param si     the resolved struct initializer
 * @param field  the accessed field's name
 * @return       the field's initializer expression, or null
 * @since #comptime-fold
 */
fn field_init_by_name(si: TStructInit, field: str) -> TExpr | null {
    mut i: u64 = 0
    loop {
        if i >= si.field_names.len { break }
        if si.field_names[i] == field { return si.field_vals[i] }
        i++
    }
    null
}

/**
 * apply_binary — apply a binary operator to two folded operands, dispatching on their
 * kinds: two integers to the integer op family, two f64 floats to the float op family.
 * A mismatched or unsupported pairing is a located error.
 *
 * @param op  the binary operator token
 * @param lv  the folded left value
 * @param rv  the folded right value
 * @param e   the enclosing expression (positions any error)
 * @return    the folded value, or a located error
 * @since #comptime-fold
 */
fn apply_binary(op: lexer::TokenKind, lv: ConstValue, rv: ConstValue, e: TExpr) -> ConstValue | error {
    match lv.kind {
        CVInt as li => apply_binary_int(op, li, rv, e)
        CVFloat as lf => apply_binary_float(op, lf, rv, e)
        _ => const_form_error("comptime fold: unsupported operand kind in a binary op (#comptime-fold)", e)
    }
}

/**
 * apply_binary_int — the left operand is an integer: require an integer right operand and
 * dispatch to the integer op family.
 *
 * @param op  the binary operator token
 * @param li  the folded left integer value
 * @param rv  the folded right value
 * @param e   the enclosing expression (positions any error)
 * @return    the folded value, or a located error
 * @since #comptime-fold
 */
fn apply_binary_int(op: lexer::TokenKind, li: CVInt, rv: ConstValue, e: TExpr) -> ConstValue | error {
    match rv.kind {
        CVInt as ri => int_binop(op, li, ri, e)
        _ => const_form_error("comptime fold: mismatched operand kinds in a binary op (#comptime-fold)", e)
    }
}

/**
 * apply_binary_float — the left operand is a float: require a float right operand and
 * dispatch to the float op family.
 *
 * @param op  the binary operator token
 * @param lf  the folded left float value
 * @param rv  the folded right value
 * @param e   the enclosing expression (positions any error)
 * @return    the folded value, or a located error
 * @since #comptime-fold
 */
fn apply_binary_float(op: lexer::TokenKind, lf: CVFloat, rv: ConstValue, e: TExpr) -> ConstValue | error {
    match rv.kind {
        CVFloat as rf => float_binop(op, lf, rf, e)
        _ => const_form_error("comptime fold: mismatched operand kinds in a binary op (#comptime-fold)", e)
    }
}
