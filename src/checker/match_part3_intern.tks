use teko::parser

// src/checker/match.tks  (namespace 'teko::checker')


// every member of the variant must be covered by some unguarded arm: NAMED (nominal) members by
// name; non-nominal members (prim/byte/str/slice/error — the `T | error` idiom) by resolved-type.
fn variant_covered(arms: []parser::Arm, members: []Type, table: TypeTable, ref_ns: str) -> bool {
    mut i = 0
    loop {
        if i >= members.len { break }
        match members[i] {
            Named as nm => { if !some_arm_names(arms, name_last_segment(nm.name), table, ref_ns) { return false } }   // (#109 W3) canonical member name → bare, to match the arms' bare case names
            Null => { if !some_arm_is_null(arms) { return false } }
            _ => { if !some_arm_covers_type(arms, members[i], table, ref_ns) { return false } }
        }
        i++
    }
    true
}

// (C7b) every member of the enum must be covered by some unguarded arm (by name).
fn enum_covered(arms: []parser::Arm, eb: parser::EnumBody, table: TypeTable, ref_ns: str) -> bool {
    mut i = 0
    loop {
        if i >= eb.members.len { break }
        if !some_arm_names(arms, eb.members[i], table, ref_ns) { return false }
        i++
    }
    true
}

// is the NONE case (a `null` pattern) covered by some UNGUARDED arm?
fn some_arm_is_null(arms: []parser::Arm) -> bool {
    mut i = 0
    loop {
        if i >= arms.len { break }
        if !arms[i].has_when {
            match arms[i].pattern { parser::NullPattern => return true; _ => { } }
        }
        i++
    }
    false
}

// a `_` covers all; otherwise a Variant subject must have every case named (its `null` member,
// if any, by `variant_covered`'s own `Null` arm). A NAMED variant subject is first expanded to
// its Variant cases (B.14/B.15) so `match s { Circle … }` over a `Shape = Circle | …` covers
// exhaustively.
fn exhaustive(arms: []parser::Arm, subject: Type, table: TypeTable, ref_ns: str) -> bool {
    if has_wildcard(arms) { return true }
    match subject {   // an ENUM subject — exhaustive iff EVERY member is named (C7b)
        Named as n => {
            match type_table_find(table, n.name, "") {   // (#109) resolved-name probe — namespace-blind (type_table_find ignores ref_ns)
                parser::TypeDecl as td => {
                    match td.body {
                        parser::EnumBody as eb => return enum_covered(arms, eb, table, ref_ns)
                        _ => { }
                    }
                }
                error => { }
            }
        }
        _ => { }
    }
    match expand_variant(subject, table) {   // a NAMED variant → its Variant cases (B.14/B.15)
        Variant as v => variant_covered(arms, v.members, table, ref_ns)
        _ => false
    }
}
