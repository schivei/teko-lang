use teko::list

// src/checker/typer.tks  (namespace 'teko::checker')
// Each check_* (E4/E5) EVOLVES into a type_*: the SAME checks (B.22 regimes, B.20
// `if`, B.15 `match` + exhaustiveness), but the producer BUILDS the typed node
// instead of returning a bare Type. Predicates (is_bool/is_integer/op_is_*),
// resolvers (resolve_type), env (lookup/define) and the pattern + exhaustiveness
// logic (check_pattern/exhaustive) are reused from their stages — re-derivation,
// not duplication (M.5). C1: every node, statement and item re-derived.


/**
 * The lone union MEMBER a numeric literal unambiguously adopts (C2b). A literal distributes over a
 * union only when EXACTLY ONE member is a numeric prim/byte it fits: zero fitting members means the
 * union takes no bare literal, and two or more (e.g. an `i8 | i32` both admitting `1`) are ambiguous
 * — both require an explicit type, so neither adopts. Returns that sole member, else `error`.
 *
 * @param n        the typed numeric-literal payload
 * @param members  the union's member types
 * @return         the single fitting numeric member, or `error` when zero or ≥2 fit
 * @throws         when no member fits or more than one does (the ambiguous/absent cases)
 */
fn union_sole_numeric_member(n: TNumber, members: []Type) -> Type | error {
    mut found: Type = Void { }
    mut count = 0
    mut i = 0
    loop {
        if i >= members.len { break }
        if number_fits_member(n, members[i]) { found = members[i]; count = count + 1 }
        i++
    }
    if count == 1 { found } else { error { message = "not exactly one numeric union member fits the literal" } }
}

/**
 * Does a union list the `null` member — the destination a bare `null` literal adopts (C2b)? A set
 * membership test over the union's members, order-independent (the null-first canonical order is
 * incidental).
 *
 * @param members  the union's member types
 * @return         true iff one member is the `Null` unit type
 */
fn union_lists_null(members: []Type) -> bool {
    mut i = 0
    loop {
        if i >= members.len { break }
        match members[i] { Null => return true; _ => { } }
        i++
    }
    false
}

/**
 * C6/C2b — does a fitting LITERAL adopt the destination `to` (a return value, trailing expr, binding,
 * argument, or struct-field slot)? A numeric literal adopts an int/float prim it fits or `byte`
 * (B.36); into a UNION it adopts the sole numeric member it fits (C2b — ambiguous ≥2 does not). A
 * bare `null` adopts a union listing `null` (or `Null` itself). RECURSES through a `match`/`if` whose
 * every contributing arm trails an adopting literal (so `match k { U8 => 8; … } : u32` adopts, and
 * `if b { 1 } else { null } : i32 | null` distributes each leaf over the same union). An empty/all-
 * fitting array literal adopts a `[]E` slot element-wise.
 *
 * @param e   the typed literal (or `if`/`match`/array composite whose leaves are literals)
 * @param to  the destination type the literal is checked against
 * @return    true iff every contributing literal leaf fits `to` (or its matching member)
 */
fn literal_adopts(e: TExpr, to: Type) -> bool {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) { Type => true; error => false }
            _ => number_fits_member(n, to)
        }
        TMatchExpr as m => {
            mut any = false
            mut i = 0
            loop {
                if i >= m.arms.len { break }
                if !tblock_diverges(m.arms[i].body) {   // a diverging arm yields no value (M.3)
                    match tblock_trailing(m.arms[i].body) {
                        TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                        null => return false
                    }
                }
                i++
            }
            any   // ≥1 contributing arm, all adopt
        }
        TIfExpr as f => {
            if !f.has_else { return false }   // a one-armed `if` has no value
            mut any = false
            if !tblock_diverges(f.then_blk) {
                match tblock_trailing(f.then_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            if !tblock_diverges(f.else_blk) {
                match tblock_trailing(f.else_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            any
        }
        // an ARRAY LITERAL adopts a `[]E` slot when EVERY non-spread element adopts E (element-wise
        // literal adoption — e.g. `[0x68, 0x65]` adopts `[]byte`). Spread elements are already
        // `[]T` and were type-checked at construction time — skip adoption for them.
        // An empty `[]` adopts any slice.
        TArrayLit as a => match to {
            Slice as s => {
                mut i = 0
                loop {
                    if i >= a.elements.len { break }
                    if !a.elements[i].is_spread {
                        if !literal_adopts(a.elements[i].expr, s.element) { return false }
                    }
                    i++
                }
                true
            }
            _ => false
        }
        TNullLit => match to {
            Variant as v => union_lists_null(v.members)
            Null => true
            _ => false
        }
        _ => false
    }
}

/**
 * (#71/C2b) RETYPE a value that `literal_adopts(e, to)` already accepted — the retyping twin of the
 * range-check above. A plain scalar leaf adopts by taking `to` wholesale (binding/assign/arg/struct-
 * field). Into a UNION `to`, a numeric leaf instead takes its sole fitting MEMBER (so `1` becomes
 * `i32`, assignable into `i32 | null`) and a `null` leaf becomes `Null` — the leaf is born at the
 * narrow member while the surrounding `if`/`match` becomes the union. An ARRAY LITERAL retypes
 * ELEMENT-WISE: each non-spread element recurses into the slice's element type (so a nested array-of-
 * arrays retypes at every depth), and the array's own `.type` becomes `to`. Mirrors `literal_adopts`'s
 * recursion exactly, one level deeper (it REBUILDS the already-typed tree — TExpr/TArrayLit/TArrayElem
 * are value types — rather than just reporting fit). A spread element is already a concrete `[]T` —
 * left untouched (its own widen was checked at array-literal typing time, same as the read side above).
 *
 * @param e   the typed value whose literal leaves adopt `to`
 * @param to  the destination type each contributing leaf is born at (a union → its matching member)
 * @return    the value rebuilt with its literal leaves re-typed
 */
fn retype_literal(e: TExpr, to: Type) -> TExpr {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) {
                Type as mem => TExpr { kind = e.kind; type = mem; line = e.line; col = e.col }
                error => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TNullLit => match to {
            Variant => TExpr { kind = e.kind; type = Null { }; line = e.line; col = e.col }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TArrayLit as a => match to {
            Slice as s => {
                mut elems: []TArrayElem = teko::list::empty()
                mut i = 0
                loop {
                    if i >= a.elements.len { break }
                    let el = a.elements[i]
                    if el.is_spread {
                        elems = teko::list::push(elems, el)
                    } else {
                        elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = retype_literal(el.expr, s.element) })
                    }
                    i++
                }
                TExpr { kind = TArrayLit { elements = elems }; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TIfExpr as f => {
            let then_blk = retype_block_trailing(f.then_blk, to)
            let else_blk = if f.has_else { retype_block_trailing(f.else_blk, to) } else { f.else_blk }
            TExpr { kind = TIfExpr { cond = f.cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = to; line = e.line; col = e.col }
        }
        TMatchExpr as m => {
            mut arms: []TArm = teko::list::empty()
            mut i = 0
            loop {
                if i >= m.arms.len { break }
                let ar = m.arms[i]
                arms = teko::list::push(arms, TArm { pattern = ar.pattern; has_when = ar.has_when; guard = ar.guard; body = retype_block_trailing(ar.body, to) })
                i++
            }
            TExpr { kind = TMatchExpr { subject = m.subject; arms = arms }; type = to; line = e.line; col = e.col }
        }
        _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
    }
}

/**
 * Rebuilds a typed statement block so its trailing value-expression is re-typed to `to`, mirroring
 * `retype_literal`'s array-element recursion one level deeper into an `if`/`match` branch body. A
 * diverging block (`return`/`break`/trailing panic) carries no value and is returned unchanged, as
 * is a block whose last statement is not a trailing expression. Only reached for a branch whose
 * trailing value already satisfied `literal_adopts(_, to)`, so retyping its leaf is sound.
 *
 * @param stmts  the branch/arm statement block
 * @param to     the destination type each contributing branch leaf adopts
 * @return       the block with its trailing expression re-typed to `to`, or the block unchanged
 */
fn retype_block_trailing(stmts: []TStatement, to: Type) -> []TStatement {
    if stmts.len == 0 { return stmts }
    if tblock_diverges(stmts) { return stmts }
    match stmts[stmts.len - 1] {
        TExprStmt as es => {
            let last_index = stmts.len - 1
            mut out: []TStatement = teko::list::empty()
            mut i = 0
            loop {
                if i >= last_index { break }
                out = teko::list::push(out, stmts[i])
                i++
            }
            let last: TStatement = TExprStmt { expr = retype_literal(es.expr, to) }
            teko::list::push(out, last)
        }
        _ => stmts
    }
}

/**
 * (C2b) BORN every literal return-position leaf of a function body at a UNION return type `ret`, so a
 * numeric or `null` leaf that `literal_adopts(_, ret)` accepted is retyped to its member before
 * codegen (which wraps the member into the union tag). The pass is GATED on `ret` being a `Variant`:
 * a scalar/`byte`/optional return keeps its body byte-identical (codegen truncates/wraps a bare leaf
 * at the boundary exactly as before), so the change is purely additive to the new union case.
 *
 * @param stmts  the typed function-body statements
 * @param ret    the function's declared return type
 * @param table  the program's type table (for the already-assignable probe)
 * @return       the body with its adopting union return/trailing leaves born at their member, else
 *               `stmts` unchanged
 */
fn retype_union_returns(stmts: []TStatement, ret: Type, table: TypeTable) -> []TStatement {
    match ret {
        Variant => retype_return_positions(stmts, ret, table, true)
        _ => stmts
    }
}
