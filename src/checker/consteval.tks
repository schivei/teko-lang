use teko::parser

fn is_scalar_const_type(t: @Type()): bool {
    match t {
        Slice => false
        Str => false
        Named => false
        Variant => false
        Func => false
        Error => false
        Void => false
        Ptr => false
        Uptr => false
        Reference => false
        Null => false
        Prim => true
        Byte => true
        Char => true
    }
}

type ScalarConstMap = struct { names: []str; nss: []str; inits: []TExpr }

fn scalar_const_init(map: ScalarConstMap, name: str, ns: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= map.names.len { break }
        if map.names[i] == name && map.nss[i] == ns { return map.inits[i] }
        i++
    }
    null
}

fn collect_module_consts(items: []@TItem()): []TConstDecl {
    var out: []TConstDecl = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        match items[i] {
            TConstDecl as cd => out = teko::list::push(out, cd)
            _ => { }
        }
        i++
    }
    out
}

pub type ConstQName = struct {
    namespace: str
    name: str
}

fn tg_axis_os_vocab(): []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "linux"), "macos"), "windows")
}

fn tg_axis_arch_vocab(): []str {
    teko::list::push(teko::list::push(teko::list::empty(), "x86_64"), "arm64")
}

fn tg_atoms_are_target(p: parser::Pred): bool {
    match p.kind {
        parser::PTrue => true
        parser::PEq as e => e.axis == "os" || e.axis == "arch"
        parser::PFlag => false
        parser::PNot as n => tg_atoms_are_target(n.inner)
        parser::PAnd as a => tg_atoms_are_target(a.left) && tg_atoms_are_target(a.right)
        parser::POr as o => tg_atoms_are_target(o.left) && tg_atoms_are_target(o.right)
    }
}

pub fn pred_is_target_guard(p: parser::Pred): bool {
    match p.kind {
        parser::PTrue => false
        _ => tg_atoms_are_target(p)
    }
}

fn tg_eval(p: parser::Pred, os: str, arch: str): bool {
    match p.kind {
        parser::PTrue => true
        parser::PEq as e => if e.axis == "os" { os == e.value } else if e.axis == "arch" { arch == e.value } else { false }
        parser::PFlag => false
        parser::PNot as n => !tg_eval(n.inner, os, arch)
        parser::PAnd as a => tg_eval(a.left, os, arch) && tg_eval(a.right, os, arch)
        parser::POr as o => tg_eval(o.left, os, arch) || tg_eval(o.right, os, arch)
    }
}

pub fn preds_target_disjoint(a: parser::Pred, b: parser::Pred): bool {
    var oss = tg_axis_os_vocab()
    var ars = tg_axis_arch_vocab()
    var i: u64 = 0
    loop {
        if i >= oss.len { break }
        var j: u64 = 0
        loop {
            if j >= ars.len { break }
            if tg_eval(a, oss[i], ars[j]) && tg_eval(b, oss[i], ars[j]) { return false }
            j = j + 1
        }
        i = i + 1
    }
    true
}

fn cond_family_arms(consts: []TConstDecl, ns: str, name: str): []TConstDecl {
    var out: []TConstDecl = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= consts.len { break }
        if consts[i].namespace == ns && consts[i].name == name { out = teko::list::push(out, consts[i]) }
        i = i + 1
    }
    out
}

fn arms_all_target_guards(arms: []TConstDecl): bool {
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        if !pred_is_target_guard(arms[i].guard) { return false }
        i = i + 1
    }
    true
}

fn arms_pairwise_disjoint(arms: []TConstDecl): bool {
    var a: u64 = 0
    loop {
        if a >= arms.len { break }
        var b = a + 1
        loop {
            if b >= arms.len { break }
            if !preds_target_disjoint(arms[a].guard, arms[b].guard) { return false }
            b = b + 1
        }
        a = a + 1
    }
    true
}

fn is_target_conditional_family(consts: []TConstDecl, ci: TConstDecl): bool {
    var arms = cond_family_arms(consts, ci.namespace, ci.name)
    if arms.len < 2 { return false }
    if !arms_all_target_guards(arms) { return false }
    arms_pairwise_disjoint(arms)
}

pub fn is_cond_const(ns: str, name: str, set: []ConstQName): bool {
    var i: u64 = 0
    loop {
        if i >= set.len { break }
        if set[i].namespace == ns && set[i].name == name { return true }
        i = i + 1
    }
    false
}

pub fn cond_const_names(items: []@TItem()): []ConstQName {
    var consts = collect_module_consts(items)
    var out: []ConstQName = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= consts.len { break }
        var ci = consts[i]
        if is_target_conditional_family(consts, ci) && !is_cond_const(ci.namespace, ci.name, out) {
            out = teko::list::push(out, ConstQName { namespace = ci.namespace; name = ci.name })
        }
        i = i + 1
    }
    out
}

fn drop_cond_consts(consts: []TConstDecl, cond: []ConstQName): []TConstDecl {
    var out: []TConstDecl = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= consts.len { break }
        if !is_cond_const(consts[i].namespace, consts[i].name, cond) { out = teko::list::push(out, consts[i]) }
        i = i + 1
    }
    out
}

fn build_scalar_map(ordered: []TConstDecl): ScalarConstMap {
    var smap = ScalarConstMap { names = teko::list::empty(); nss = teko::list::empty(); inits = teko::list::empty() }
    var i: u64 = 0
    loop {
        if i >= ordered.len { break }
        var cd = ordered[i]
        if is_scalar_const_type(cd.ty) {
            var collapsed = inline_rw_expr(cd.init, smap)
            smap = ScalarConstMap { names = teko::list::push(smap.names, cd.name); nss = teko::list::push(smap.nss, cd.namespace); inits = teko::list::push(smap.inits, collapsed) }
        }
        i++
    }
    smap
}

fn inline_rw_fspec(sp: TFSpec, map: ScalarConstMap): TFSpec {
    match sp.kind {
        TFSpecDynamic as fd => {
            var args: []TExpr = teko::list::empty()
            var k: u64 = 0
            loop {
                if k >= fd.args.len { break }
                args = teko::list::push(args, inline_rw_expr(fd.args[k], map))
                k++
            }
            TFSpec { kind = TFSpecDynamic { args = args } }
        }
        _ => sp
    }
}

fn inline_rw_exprs(xs: []TExpr, map: ScalarConstMap): []TExpr {
    var out: []TExpr = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, inline_rw_expr(xs[i], map))
        i++
    }
    out
}

fn inline_rw_expr(e: TExpr, map: ScalarConstMap): TExpr {
    match e.kind {
        TNumber => e
        TStrLit => e
        TByteStrLit => e
        TByteLit => e
        TCharLit => e
        TBoolLit => e
        TNullLit => e
        TPathExpr => e
        TVar as v => inline_rw_var(v, e, map)
        TBinary as b => TExpr { kind = TBinary { op = b.op; left = inline_rw_expr(b.left, map); right = inline_rw_expr(b.right, map) }; type = e.type; line = e.line; col = e.col }
        TUnary as u => TExpr { kind = TUnary { op = u.op; operand = inline_rw_expr(u.operand, map) }; type = e.type; line = e.line; col = e.col }
        TCompare as c => inline_rw_compare(c, e, map)
        TCall as cl => TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = inline_rw_exprs(cl.args, map); call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
        TIfExpr as f => TExpr { kind = TIfExpr { cond = inline_rw_expr(f.cond, map); then_blk = inline_rw_block(f.then_blk, map); has_else = f.has_else; else_blk = inline_rw_block(f.else_blk, map) }; type = e.type; line = e.line; col = e.col }
        TMatchExpr as m => inline_rw_match(m, e, map)
        TCast as c => TExpr { kind = TCast { expr = inline_rw_expr(c.expr, map) }; type = e.type; line = e.line; col = e.col }
        TFieldAccess as fa => TExpr { kind = TFieldAccess { receiver = inline_rw_expr(fa.receiver, map); field = fa.field }; type = e.type; line = e.line; col = e.col }
        TStructInit as si => TExpr { kind = TStructInit { field_names = si.field_names; field_vals = inline_rw_exprs(si.field_vals, map) }; type = e.type; line = e.line; col = e.col }
        TIndex as ix => TExpr { kind = TIndex { receiver = inline_rw_expr(ix.receiver, map); index = inline_rw_expr(ix.index, map) }; type = e.type; line = e.line; col = e.col }
        TInterp as in => inline_rw_interp(in, e, map)
        TInExpr as n => TExpr { kind = TInExpr { lhs = inline_rw_expr(n.lhs, map); elems = inline_rw_exprs(n.elems, map) }; type = e.type; line = e.line; col = e.col }
        TArrayLit as a => inline_rw_array(a, e, map)
        TSliceOfLen as s => TExpr { kind = TSliceOfLen { size = inline_rw_expr(s.size, map); element = s.element }; type = e.type; line = e.line; col = e.col }
        TLambda as lam => TExpr { kind = TLambda { params = lam.params; body = inline_rw_block(lam.body, map); captures = lam.captures; ret = lam.ret; lift_id = lam.lift_id }; type = e.type; line = e.line; col = e.col }
        TBorrow as b => TExpr { kind = TBorrow { operand = inline_rw_expr(b.operand, map) }; type = e.type; line = e.line; col = e.col }
        TBlockExpr as b => TExpr { kind = TBlockExpr { body = inline_rw_block(b.body, map) }; type = e.type; line = e.line; col = e.col }
    }
}

fn inline_rw_var(v: TVar, e: TExpr, map: ScalarConstMap): TExpr {
    if v.is_func { return e }
    match scalar_const_init(map, v.name, v.func_ns) {
        TExpr as sub => widen_inlined_const(e, sub)
        null => e
    }
}

fn widen_inlined_const(e: TExpr, sub: TExpr): TExpr {
    if type_eq(e.type, sub.type) { return sub }
    TExpr { kind = TCast { expr = sub }; type = e.type; line = e.line; col = e.col }
}

fn inline_rw_compare(c: TCompare, e: TExpr, map: ScalarConstMap): TExpr {
    var terms: []TCmpTerm = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        terms = teko::list::push(terms, TCmpTerm { op = c.rest[i].op; operand = inline_rw_expr(c.rest[i].operand, map) })
        i++
    }
    TExpr { kind = TCompare { first = inline_rw_expr(c.first, map); rest = terms }; type = e.type; line = e.line; col = e.col }
}

fn inline_rw_match(m: TMatchExpr, e: TExpr, map: ScalarConstMap): TExpr {
    var arms: []TArm = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= m.arms.len { break }
        arms = teko::list::push(arms, inline_rw_arm(m.arms[i], map))
        i++
    }
    TExpr { kind = TMatchExpr { subject = inline_rw_expr(m.subject, map); arms = arms }; type = e.type; line = e.line; col = e.col }
}

fn inline_rw_arm(arm: TArm, map: ScalarConstMap): TArm {
    var guard = if arm.has_when { inline_rw_expr(arm.guard, map) } else { arm.guard }
    TArm { pattern = arm.pattern; has_when = arm.has_when; guard = guard; body = inline_rw_block(arm.body, map) }
}

fn inline_rw_interp(in: TInterp, e: TExpr, map: ScalarConstMap): TExpr {
    var holes: []TExpr = teko::list::empty()
    var specs: []TFSpec = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= in.holes.len { break }
        holes = teko::list::push(holes, inline_rw_expr(in.holes[i], map))
        if i < in.specs.len { specs = teko::list::push(specs, inline_rw_fspec(in.specs[i], map)) }
        i++
    }
    TExpr { kind = TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = e.type; line = e.line; col = e.col }
}

fn inline_rw_array(a: TArrayLit, e: TExpr, map: ScalarConstMap): TExpr {
    var elems: []TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        elems = teko::list::push(elems, TArrayElem { is_spread = a.elements[i].is_spread; expr = inline_rw_expr(a.elements[i].expr, map) })
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
}

fn inline_rw_block(stmts: []@TStatement(), map: ScalarConstMap): []@TStatement() {
    var out: []@TStatement() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= stmts.len { break }
        out = teko::list::push(out, inline_rw_stmt(stmts[i], map))
        i++
    }
    out
}

fn inline_rw_stmt(st: @TStatement(), map: ScalarConstMap): @TStatement() {
    match st {
        TBinding as b => TBinding { kind = b.kind; target = b.target; bound = b.bound; value = inline_rw_expr(b.value, map) }
        TAssign as a => inline_rw_assign(a, map)
        TReturn as r => if r.has_value { TReturn { has_value = true; value = inline_rw_expr(r.value, map); values = teko::list::empty() } } else { st }
        TLoopStmt as l => TLoopStmt { label = l.label; init = inline_rw_block(l.init, map); body = inline_rw_block(l.body, map) }
        TBreakStmt => st
        TContinueStmt => st
        TExprStmt as es => TExprStmt { expr = inline_rw_expr(es.expr, map) }
        TDeferStmt as d => TDeferStmt { body = inline_rw_block(d.body, map) }
        TAdoptStmt as a => TAdoptStmt { name = a.name; body = inline_rw_block(a.body, map) }
        TBlockStmt as b => TBlockStmt { body = inline_rw_block(b.body, map) }
        TSpawn as sp => TSpawn { call = inline_rw_expr(sp.call, map); id = sp.id }
    }
}

fn inline_rw_assign(a: TAssign, map: ScalarConstMap): @TStatement() {
    var value = inline_rw_expr(a.value, map)
    if parser::assign_has_target(a.kind) {
        return TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = inline_rw_expr(a.target, map) }
    }
    TAssign { kind = a.kind; name = a.name; op = a.op; bound = a.bound; value = value; deref = a.deref; target = a.target }
}

fn rewrite_function(f: TFunction, map: ScalarConstMap): TFunction {
    TFunction { overload_suffix = f.overload_suffix; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = inline_rw_block(f.body, map); vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = f.ret_extra; guard = f.guard }
}

fn rewrite_const_init(cd: TConstDecl, map: ScalarConstMap): TConstDecl {
    TConstDecl { name = cd.name; namespace = cd.namespace; ty = cd.ty; init = inline_rw_expr(cd.init, map); vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col; guard = cd.guard }
}

fn const_is_exported(cd: TConstDecl): bool {
    match cd.vis {
        parser::Visibility::Private => false
        parser::Visibility::Pub => true
        parser::Visibility::Exp => true
    }
}

fn inline_scalar_const_item(out: []@TItem(), cd: TConstDecl, map: ScalarConstMap): []@TItem() {
    if const_is_exported(cd) { return teko::list::push(out, rewrite_const_init(cd, map)) }
    out
}

fn inline_place_item(out: []@TItem(), it: @TItem(), map: ScalarConstMap): []@TItem() {
    match it {
        TFunction as f => teko::list::push(out, rewrite_function(f, map))
        TConstDecl as cd => if is_scalar_const_type(cd.ty) { inline_scalar_const_item(out, cd, map) } else { teko::list::push(out, rewrite_const_init(cd, map)) }
        (@TStatement()) as s => teko::list::push(out, inline_rw_stmt(s, map))
        _ => teko::list::push(out, it)
    }
}

pub fn inline_consts(prog: TProgram): TProgram | error {
    var substituted = match substitute_module_consts(prog) { error as e => return e; TProgram as sp => sp }
    var agg = match build_module_agg_map(substituted) { error as e => return e; ScalarConstMap as m => m }
    fold_program(propagate_locals(substituted), agg)
}

fn const_ctor_return_value(r: TReturn): TExpr | null {
    if !r.has_value { return null }
    r.value
}

fn const_ctor_tail_expr(st: @TStatement()): TExpr | null {
    match st {
        TReturn as r => const_ctor_return_value(r)
        TExprStmt as es => es.expr
        _ => null
    }
}

fn struct_literal_or_null(e: TExpr): TExpr | null {
    match e.kind {
        TStructInit => e
        _ => null
    }
}

fn const_ctor_literal(f: TFunction): TExpr | null {
    if f.is_extern { return null }
    if f.body.len != 1 { return null }
    match const_ctor_tail_expr(f.body[0]) {
        TExpr as e => struct_literal_or_null(e)
        null => null
    }
}

fn push_when_const_ctor(acc: []TFunction, f: TFunction): []TFunction {
    match const_ctor_literal(f) {
        TExpr => teko::list::push(acc, f)
        null => acc
    }
}

fn collect_const_ctor_item(acc: []TFunction, it: @TItem()): []TFunction {
    match it {
        TFunction as f => push_when_const_ctor(acc, f)
        _ => acc
    }
}

pub fn collect_const_ctors(items: []@TItem()): []TFunction {
    var out: []TFunction = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = collect_const_ctor_item(out, items[i])
        i++
    }
    out
}

fn callee_bare_name(p: parser::Path): str {
    if p.segments.len == 0 { return "" }
    p.segments[p.segments.len - 1].name
}

fn const_ctor_matches(f: TFunction, bare: str, call_ns: str): bool {
    if f.name != bare { return false }
    if call_ns == "" { return true }
    f.namespace == call_ns
}

fn find_const_ctor(ctors: []TFunction, callee: parser::Path, call_ns: str): TFunction | null {
    var bare = callee_bare_name(callee)
    if bare == "" { return null }
    var found: []TFunction = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= ctors.len { break }
        if const_ctor_matches(ctors[i], bare, call_ns) { found = teko::list::push(found, ctors[i]) }
        i++
    }
    if found.len != 1 { return null }
    found[0]
}

fn const_ctor_arg_for_param(params: []parser::Param, args: []TExpr, name: str): TExpr | null {
    var i: u64 = 0
    loop {
        if i >= params.len { break }
        if params[i].name == name { return args[i] }
        i++
    }
    null
}

fn const_ctor_var_value(tv: TVar, params: []parser::Param, args: []TExpr): TExpr | null {
    if tv.is_func { return null }
    const_ctor_arg_for_param(params, args, tv.name)
}

fn const_ctor_field_value(v: TExpr, params: []parser::Param, args: []TExpr): TExpr | null {
    match v.kind {
        TVar as tv => const_ctor_var_value(tv, params, args)
        TNumber => v
        TStrLit => v
        TByteLit => v
        TCharLit => v
        TBoolLit => v
        TPathExpr => v
        _ => null
    }
}

fn const_ctor_substituted(call: TExpr, si: TStructInit, params: []parser::Param, args: []TExpr): TExpr | null {
    var vals: []TExpr = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= si.field_vals.len { break }
        var fv = match const_ctor_field_value(si.field_vals[i], params, args) { TExpr as x => x; null => return null }
        vals = teko::list::push(vals, fv)
        i++
    }
    TExpr { kind = TStructInit { field_names = si.field_names; field_vals = vals }; type = call.type; line = call.line; col = call.col }
}

fn canon_ctor_call(cl: TCall, args: []TExpr, call: TExpr, ctors: []TFunction): TExpr {
    var f = match find_const_ctor(ctors, cl.callee, cl.call_ns) { TFunction as x => x; null => return call }
    if f.params.len != args.len { return call }
    var lit = match const_ctor_literal(f) { TExpr as x => x; null => return call }
    var si = match lit.kind { TStructInit as s => s; _ => return call }
    match const_ctor_substituted(call, si, f.params, args) { TExpr as x => x; null => call }
}

fn canon_call(cl: TCall, e: TExpr, ctors: []TFunction): TExpr {
    var args = canon_exprs(cl.args, ctors)
    var call = TExpr { kind = TCall { overload_suffix = cl.overload_suffix; callee = cl.callee; args = args; call_ns = cl.call_ns; is_closure_call = cl.is_closure_call; callee_type = cl.callee_type; is_iface_dispatch = cl.is_iface_dispatch; iface_slot = cl.iface_slot; type_args = cl.type_args; ret_extra = cl.ret_extra }; type = e.type; line = e.line; col = e.col }
    canon_ctor_call(cl, args, call, ctors)
}

fn canon_exprs(xs: []TExpr, ctors: []TFunction): []TExpr {
    var out: []TExpr = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, canonicalize_const_ctors(xs[i], ctors))
        i++
    }
    out
}

fn canon_array(a: TArrayLit, e: TExpr, ctors: []TFunction): TExpr {
    var elems: []TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        elems = teko::list::push(elems, TArrayElem { is_spread = a.elements[i].is_spread; expr = canonicalize_const_ctors(a.elements[i].expr, ctors) })
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = e.type; line = e.line; col = e.col }
}

pub fn canonicalize_const_ctors(e: TExpr, ctors: []TFunction): TExpr {
    match e.kind {
        TCall as cl => canon_call(cl, e, ctors)
        TCast as c => TExpr { kind = TCast { expr = canonicalize_const_ctors(c.expr, ctors) }; type = e.type; line = e.line; col = e.col }
        TUnary as u => TExpr { kind = TUnary { op = u.op; operand = canonicalize_const_ctors(u.operand, ctors) }; type = e.type; line = e.line; col = e.col }
        TBinary as b => TExpr { kind = TBinary { op = b.op; left = canonicalize_const_ctors(b.left, ctors); right = canonicalize_const_ctors(b.right, ctors) }; type = e.type; line = e.line; col = e.col }
        TStructInit as si => TExpr { kind = TStructInit { field_names = si.field_names; field_vals = canon_exprs(si.field_vals, ctors) }; type = e.type; line = e.line; col = e.col }
        TArrayLit as a => canon_array(a, e, ctors)
        _ => e
    }
}

pub fn build_module_agg_map(prog: TProgram): AggConstMap | error {
    var consts = drop_cond_consts(collect_module_consts(prog.items), cond_const_names(prog.items))
    if consts.len == 0 { return ScalarConstMap { names = teko::list::empty(); nss = teko::list::empty(); inits = teko::list::empty() } }
    var ordered = match const_dep_order(consts) { []TConstDecl as o => o; error as e => return e }
    build_aggregate_map(ordered)
}

fn substitute_module_consts(prog: TProgram): TProgram | error {
    var consts = drop_cond_consts(collect_module_consts(prog.items), cond_const_names(prog.items))
    if consts.len == 0 { return prog }
    var ordered = match const_dep_order(consts) { []TConstDecl as o => o; error as e => return e }
    var smap = build_scalar_map(ordered)
    var out: []@TItem() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = inline_place_item(out, prog.items[i], smap)
        i++
    }
    TProgram { items = out }
}

fn build_aggregate_map(ordered: []TConstDecl): ScalarConstMap {
    var amap = ScalarConstMap { names = teko::list::empty(); nss = teko::list::empty(); inits = teko::list::empty() }
    var i: u64 = 0
    loop {
        if i >= ordered.len { break }
        var cd = ordered[i]
        if !is_scalar_const_type(cd.ty) {
            var collapsed = inline_rw_expr(cd.init, amap)
            amap = ScalarConstMap { names = teko::list::push(amap.names, cd.name); nss = teko::list::push(amap.nss, cd.namespace); inits = teko::list::push(amap.inits, collapsed) }
        }
        i++
    }
    amap
}

pub fn collapse_agg_const_decls(prog: TProgram): TProgram | error {
    var consts = drop_cond_consts(collect_module_consts(prog.items), cond_const_names(prog.items))
    if consts.len == 0 { return prog }
    var ordered = match const_dep_order(consts) { []TConstDecl as o => o; error as e => return e }
    var amap = build_aggregate_map(ordered)
    var out: []@TItem() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = teko::list::push(out, collapse_agg_const_decl_item(prog.items[i], amap))
        i++
    }
    TProgram { items = out }
}

fn collapse_agg_const_decl_item(it: @TItem(), amap: ScalarConstMap): @TItem() {
    match it {
        TConstDecl as cd => collapse_agg_const_decl(cd, amap)
        _ => it
    }
}

fn collapse_agg_const_decl(cd: TConstDecl, amap: ScalarConstMap): @TItem() {
    if is_scalar_const_type(cd.ty) { return cd }
    TConstDecl {
        name = cd.name; namespace = cd.namespace; ty = cd.ty
        init = inline_rw_expr(cd.init, amap)
        vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col; guard = cd.guard
    }
}

fn inline_place_item_agg(out: []@TItem(), it: @TItem(), map: ScalarConstMap): []@TItem() {
    match it {
        TFunction as f => teko::list::push(out, rewrite_function(f, map))
        (@TStatement()) as s => teko::list::push(out, inline_rw_stmt(s, map))
        _ => teko::list::push(out, it)
    }
}

pub fn inline_aggregate_consts(prog: TProgram): TProgram | error {
    var consts = drop_cond_consts(collect_module_consts(prog.items), cond_const_names(prog.items))
    if consts.len == 0 { return prog }
    var ordered = match const_dep_order(consts) { []TConstDecl as o => o; error as e => return e }
    var amap = build_aggregate_map(ordered)
    if amap.names.len == 0 { return prog }
    var out: []@TItem() = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        out = inline_place_item_agg(out, prog.items[i], amap)
        i++
    }
    TProgram { items = out }
}
