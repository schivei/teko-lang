// src/checker/match.tks  (namespace 'teko::checker')

use teko::parser

// (C7b) is `name` a member of the enum body?
fn enum_has_member(eb: parser::EnumBody, name: str): bool {
    var i = 0
    loop {
        if i >= eb.members.len { break }
        if eb.members[i] == name { return true }
        i++
    }
    false
}

// (C7b) ENUM-subject pattern check: a bare/qualified path pattern names a MEMBER (enum members
// carry NO data). `U8` and `PrimKind::U8` both name member "U8" (by the LAST path segment, like the
// `Type::Member` enum-value form). `_` matches anything; an Alt checks each option; `as x` binds the
// whole enum value. (Mirror of match.c check_enum_pattern.)
fn check_enum_pattern(p: parser::Pattern, subject: Type, eb: parser::EnumBody, env: Env, table: TypeTable): Env | error {
    match p {
        parser::WildcardPattern => env
        parser::BindPattern as bp => {
            if bp.is_slice { return error { message = "a slice pattern cannot match an enum value" } }
            var name = bp.type_name.segments[bp.type_name.segments.len - 1].name
            if !enum_has_member(eb, name) { return error { message = $"not a member of the enum: {name}" } }
            if bp.has_binding { define(env, bp.binding, subject, false) }   // `as x` — the enum value
            else { env }   // bare member — binds nothing
        }
        parser::AltPattern as ap => {
            var i = 0
            loop {
                if i >= ap.options.len { break }
                match ap.options[i] {
                    parser::BindPattern as bp => { if bp.has_binding { return error { message = "an alternative (`|`) cannot bind; use a separate arm" } } }
                    _ => { }
                }
                match check_enum_pattern(ap.options[i], subject, eb, env, table) { Env => { }; error as e => return e }
                i++
            }
            env
        }
        _ => error { message = "an enum subject needs member patterns (`U8`) or `_`" }
    }
}

/**
 * is_direct_case_of — is `named` a legal left-of-arm DISCRIMINANT of the match subject? (SEALED
 * match model, match-universal phase 1.) A left-of-arm test is valid when `named` is: the WHOLE
 * subject itself (`raw_subject` — a bind-all `Type as t`); a DIRECT case of the subject's variant
 * view (`subject_variant`); a concrete SUBCLASS of a polymorphic base-class subject; or a concrete
 * IMPL of an interface subject. A case that is itself a NESTED variant must be double-matched
 * (`Outer as v => match v { Inner as i => … }`), never skip-matched directly. A struct/primitive/
 * sealed-class/service subject admits only the bind-all (its sole concrete type is itself), which
 * `type_eq(named, raw_subject)` already covers, so this stays permissive (true) for them and the
 * ordinary resolve/typecheck path validates the rest — keeping phase 1 inert on the existing corpus,
 * which holds ZERO match-over-class/interface sites.
 *
 * @param named            the arm's resolved discriminant type
 * @param subject_variant  the subject's one-level variant view (from `expand_variant`)
 * @param raw_subject      the subject's pre-expansion resolved type
 * @param table            the program's type table (subclass/impl relation oracles)
 * @return                 true iff `named` is a legal discriminant of the subject
 * @see                    subclass_reaches, type_conforms_to
 */
fn is_direct_case_of(named: Type, subject_variant: Type, raw_subject: Type, table: TypeTable): bool {
    if type_eq(named, raw_subject) { return true }
    match subject_variant {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                if type_eq(named, v.members[i]) { return true }
                i++
            }
            false
        }
        _ => is_type_discriminant_of(named, raw_subject, table)
    }
}

/**
 * is_type_discriminant_of — for a NON-variant subject, is `named` a legal type-test discriminant of
 * `subject`? A polymorphic BASE-CLASS subject admits any concrete subclass reaching it; an INTERFACE
 * subject admits any concrete type conforming to it. Every other subject kind (struct, primitive,
 * sealed class, service) admits only itself — the bind-all — which the caller has already accepted
 * via `type_eq`, so this stays permissive (true) for them so the phase is inert on today's corpus.
 *
 * @param named    the arm's resolved discriminant type
 * @param subject  the subject's resolved type
 * @param table    the program's type table
 * @return         true iff `named` legally discriminates `subject`
 */
fn is_type_discriminant_of(named: Type, subject: Type, table: TypeTable): bool {
    match subject {
        Named as sn => match named {
            Named as an => {
                if is_polymorphic_base(sn.name, table) { return subclass_reaches(an.name, sn.name, table, 64) }
                if is_interface_name(sn.name, table) { return type_conforms_to(an.name, sn.name, table) }
                true
            }
            _ => true
        }
        _ => true
    }
}

/**
 * discriminant_mismatch_error — the diagnostic for an arm whose left-of-arm type is NOT a legal
 * discriminant of the subject. A polymorphic base-class subject names the "not a subclass" case; an
 * interface subject the "does not implement" case; every other subject falls to the variant
 * skip-level message (its historic shape).
 *
 * @param named            the rejected discriminant type
 * @param subject          the subject's resolved type
 * @param subject_variant  the subject's one-level variant view
 * @param table            the program's type table
 * @return                 the placed rejection error
 */
fn discriminant_mismatch_error(named: Type, subject: Type, subject_variant: Type, table: TypeTable): error {
    match subject {
        Named as sn => {
            if is_polymorphic_base(sn.name, table) { return error { message = $"'{type_render(named)}' is not a subclass of '{sn.name}'" } }
            if is_interface_name(sn.name, table) { return error { message = $"'{type_render(named)}' does not implement '{sn.name}'" } }
        }
        _ => { }
    }
    skip_level_error(named, subject_variant, table)
}
// (#109 W2, R5) CONTEXTUAL pattern resolution — a match-arm pattern name resolves against the
// SUBJECT variant's own members FIRST, regardless of namespace. In `match shape { Circle as c => … }`
// the bare `Circle` binds the Shape variant's `Circle` member even when the match site sits in a
// different namespace than Shape — a valid reference that R3 (strict own-ns bare) would otherwise
// reject. Matches by the pattern's LAST path segment against each member's nominal name; returns the
// member Type when found (the arm binds exactly that case), else null (fall to resolve_named/R0-R4).
// A non-variant subject (subject_variant is not a Variant) yields null — nothing contextual to bind.
// Mirror of match.c::variant_member_by_name.
fn variant_member_by_name(subject_variant: Type, last: str): Type | null {
    match subject_variant {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                match v.members[i] {
                    Named as n => if name_last_segment(n.name) == last { return v.members[i] }   // (#109 W3) member name is canonical "ns::Name"; the pattern's last segment is bare
                    _ => { }
                }
                i++
            }
            null
        }
        _ => null
    }
}
// (#110) find the DIRECT member of `subject` whose own (one-level) expansion contains `named` —
// i.e. the outer case the caller should match FIRST before re-matching `named` inside it. Used
// only to build a concrete, pasteable hint (`FooBar as v => match v { Foo as x => … }` rather than
// the whole `FooBar | error` union, which is not a nameable bind pattern). Mirror of
// match.c::find_containing_case (returns null when no direct member's expansion contains `named`).
fn find_containing_case(named: Type, subject: Type, table: TypeTable): Type | null {
    match subject {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                var mem = v.members[i]
                match expand_variant(mem, table) {
                    Variant as mv => {
                        var j = 0
                        loop {
                            if j >= mv.members.len { break }
                            if type_eq(named, mv.members[j]) { return mem }
                            j++
                        }
                    }
                    _ => { }
                }
                i++
            }
            null
        }
        _ => null
    }
}
// (#110) the skip-level-match diagnostic: "'Foo' is not a direct case of 'FooBar | error' —
// match the outer case first (FooBar as v => match v { Foo as f => … })". When a direct member's
// own expansion contains the arm's case (the common shape — a nested named variant), the hint
// names THAT member (a real, pasteable bind pattern); otherwise it falls back to the whole subject.
// Mirror of match.c::skip_level_error.
fn skip_level_error(arm_type: Type, subject: Type, table: TypeTable): error {
    var arm_s = type_render(arm_type)
    var subj_s = type_render(subject)
    var hint_s = match find_containing_case(arm_type, subject, table) { Type as t => type_render(t); null => subj_s }
    error { message = $"'{arm_s}' is not a direct case of '{subj_s}' — match the outer case first ({hint_s} as v => match v {{ {arm_s} as x => … }})" }
}

/**
 * Does `t` (an already one-level-expanded subject) carry a `null` member (null-as-union)? Used to
 * admit a `null` match pattern over a `T | null` subject, mirroring the `variant`-member machinery.
 *
 * @param t  the subject's variant view (from `expand_variant`)
 * @return   true iff `t` is a `Variant` one of whose members is `Null`
 */
fn variant_has_null_member(t: Type): bool {
    match t {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                match v.members[i] { Null => return true; _ => { } }
                i++
            }
            false
        }
        _ => false
    }
}

/**
 * reject_trait_in_match — a trait has no discriminant (§9.4): a trait name in a match SUBJECT is a
 * NAMED error, never a silent no-match. A composed trait is flattened away and never reaches here as
 * a Named trait, so this fires only on a direct trait subject a user wrote.
 *
 * @param t      the resolved subject type
 * @param table  the type table
 * @param where  the position word placed into the diagnostic (e.g. "subject")
 * @return       null when `t` is not a trait, else the named error
 * @throws       when `t` names a trait
 * @since 0.3.1 (§9.4 revised)
 */
fn reject_trait_in_match(t: Type, table: TypeTable, where: str): null | error {
    match t {
        Named as n => if is_trait_name(n.name, table) { error { message = $"cannot match on trait `{n.name}` in {where} position — a trait has no discriminant (§9.4)" } } else { null }
        _ => null
    }
}

/**
 * reject_trait_case — a trait name in a match CASE (left-of-arm) is a NAMED error (§9.4): a trait has
 * no discriminant to test. Checks the case pattern's nominal name before it would resolve (a trait is
 * not a type, so resolution would otherwise report the generic "not a type").
 *
 * @param p      the arm's pattern
 * @param table  the type table
 * @return       null when the case names no trait, else the named error
 * @throws       when the case names a trait
 * @since 0.3.1 (§9.4 revised)
 */
fn reject_trait_case(p: parser::Pattern, table: TypeTable): null | error {
    var name = match p {
        parser::BindPattern as bp => if bp.is_slice { "" } else { bp.type_name.segments[bp.type_name.segments.len - 1].name }
        parser::FieldPattern as fp => fp.type_name.segments[fp.type_name.segments.len - 1].name
        _ => ""
    }
    if name != "" && is_trait_name(name, table) {
        return error { message = $"cannot match on trait `{name}` in case position — a trait has no discriminant (§9.4)" }
    }
    null
}

/**
 * check_pattern — validate a pattern against the subject; return the env extended with bindings.
 * A `T | null` union subject is handled by the generic `NullPattern` arm
 * (`variant_has_null_member`) below plus the present case's ordinary variant-member matching.
 *
 * @param p        the syntactic pattern
 * @param subject  the resolved subject type
 * @param env      the enclosing type environment
 * @param table    the type table
 * @return         the env extended with the pattern's bindings, or an error
 */
fn check_pattern(p: parser::Pattern, subject: Type, env: Env, table: TypeTable): Env | error {
    match reject_trait_in_match(subject, table, "subject") { error as e => return e; null => { } }
    match reject_trait_case(p, table) { error as e => return e; null => { } }
    // ENUM subject (C7b): member patterns, not type binds — detected before the generic match so a
    // bare `U8` is not mis-resolved as a type name (resolve_named → "unknown type: U8").
    match subject {
        Named as n => {
            match type_table_find(table, n.name, "") {   // (#109 W1) enum-subject probe on a resolved name — no referencing ns
                parser::TypeDecl as td => {
                    match td.body {
                        parser::EnumBody as eb => return check_enum_pattern(p, subject, eb, env, table)
                        _ => { }
                    }
                }
                error => { }
            }
        }
        _ => { }
    }
    // (#110) the subject's variant view — a NAMED alias of a `variant` decl expands to its Variant
    // members (mirrors `exhaustive`); an already-inline `T | error` subject is unchanged. Used ONLY
    // to reject SKIP-LEVEL arms below (a case of a NESTED/inner variant named directly against this
    // outer subject) — native codegen only synthesizes tags for the subject's own direct union
    // members, never for a member's own inner cases.
    var subject_variant = expand_variant(subject, table)
    match p {
        parser::NullPattern => {
            if variant_has_null_member(subject_variant) { return env }
            return error { message = "`null` pattern requires an optional subject (`T?`) or a union listing `null`" }
        }
        parser::WildcardPattern => env
        parser::BindPattern as bp => {
            // `[]T as x` resolves the slice TYPE-expr; a path bind resolves the named/builtin case.
            // (#109 W2, R5) a PLAIN named bind (not `[]T`, not `Foo<i64>`) first resolves CONTEXTUALLY
            // against the subject variant's members — a bare cross-namespace case name still binds.
            var ct = if !bp.is_slice && bp.type_args.len == 0 {
                match variant_member_by_name(subject_variant, bp.type_name.segments[bp.type_name.segments.len - 1].name) {
                    Type as m => m
                    null => match bind_pattern_type(bp, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109) ref_ns = the match's enclosing namespace → R0-R4
                }
            } else {
                match bind_pattern_type(bp, table, env.cur_ns) { Type as t => t; error as e => return e }
            }
            // (#110) reject a SKIP-LEVEL arm: `ct` names a type that is not a direct case of the
            // subject's own union (it may be a case of an INNER variant nested inside one of the
            // subject's members). `is_direct_case_of` is a no-op (true) when the subject is not a
            // variant at all, so ordinary struct/prim subjects are unaffected.
            if !is_direct_case_of(ct, subject_variant, subject, table) { return discriminant_mismatch_error(ct, subject, subject_variant, table) }
            if !bp.has_binding { return env }   // bare case / `as _` discard — binds nothing
            define(env, bp.binding, ct, false)   // `Type as name` → name : the case type (match-binding immutable — B.21)
        }
        parser::LiteralPattern as lp => {
            // a numeric literal pattern adopts the subject's numeric type, so `match b { 0xE0 => … }`
            // matches a `byte` subject (byte = u8) — parity with value-position literal adoption.
            var lt = match type_expr(lp.value, env, table) { TExpr as te => te; error as e => return e }
            if !type_eq(lt.type, subject) && !literal_adopts(lt, subject) { return error { message = "literal pattern does not match the subject type" } }
            env
        }
        parser::FieldPattern as fp => {
            // C7a: variant axis `Type { f; g }` — resolve to a struct, bind each field IMMUTABLE (B.21).
            // (#109 W2, R5) resolve the case name CONTEXTUALLY against the subject variant's members
            // first (a bare cross-namespace case still binds), else fall to resolve_named/R0-R4.
            var nt = match variant_member_by_name(subject_variant, fp.type_name.segments[fp.type_name.segments.len - 1].name) {
                Type as m => m
                null => match resolve_named(fp.type_name, table, env.cur_ns, 0) { Type as t => t; error as e => return e }
            }
            var name = match nt {
                Named as n => n.name
                _ => return error { message = "field pattern requires a struct type" }
            }
            // (#110) same skip-level guard as the BIND arm above — `Type { f; g }` also names a case.
            if !is_direct_case_of(nt, subject_variant, subject, table) { return discriminant_mismatch_error(nt, subject, subject_variant, table) }
            var decl = match type_table_find(table, name, "") {   // (#109 W1) follow-up lookup of a resolved name — no referencing ns
                parser::TypeDecl as td => td
                error => return error { message = $"unknown type in field pattern: {name}" }
            }
            var sb_fields = match decl.body {
                parser::StructBody as s => s.fields
                parser::ClassBody as c => c.fields   // (W10b.CLASS increment 1)
                _ => return error { message = $"type {name} is not a struct (no fields)" }
            }
            var e2 = env
            var i = 0
            loop {
                if i >= fp.fields.len { break }
                var ft = match field_type(sb_fields, fp.fields[i], table, type_ns_of(table, name)) { Type as t => t; error as e => return e }
                e2 = define(e2, fp.fields[i], ft, false)   // B.21 — match-binding immutable
                i++
            }
            e2
        }
        parser::RangePattern as rp => {
            // C7a: `lo ..= hi` — each bound type_eq's the subject OR is a fitting literal that adopts
            // it (so `0x80 ..= 0xBF` over a `byte` subject is fine), AND the subject is an integer
            // (M.1/M.2). Mirrors match.c's `!type_eq && !literal_adopts` bound check.
            var lo = match type_expr(rp.lo, env, table) { TExpr as te => te; error as e => return e }
            var hi = match type_expr(rp.hi, env, table) { TExpr as te => te; error as e => return e }
            if !type_eq(lo.type, subject) && !literal_adopts(lo, subject) { return error { message = "range lower bound does not match the subject type" } }
            if !type_eq(hi.type, subject) && !literal_adopts(hi, subject) { return error { message = "range upper bound does not match the subject type" } }
            // an integer subject — an int prim OR `byte` (= u8); a float range is rejected (B.38).
            var int_subject = match subject { Byte => true; _ => is_integer(subject) }
            if !int_subject { return error { message = "range pattern requires an integer subject (B.38 — not a float)" } }
            env   // binds nothing
        }
        parser::AltPattern as ap => {
            // C7a: `a | b | …` — each option checked against the subject; NO option may bind (settled axis rule).
            var i = 0
            loop {
                if i >= ap.options.len { break }
                var opt = ap.options[i]
                match opt {
                    parser::BindPattern as bp => { if bp.has_binding { return error { message = "an alternative (`|`) cannot bind; use a separate arm" } } }
                    parser::FieldPattern => return error { message = "an alternative (`|`) cannot bind; use a separate arm" }
                    _ => { }
                }
                // recurse for validation (the subject must accept each option); discard the env — Alt binds nothing.
                match check_pattern(opt, subject, env, table) { Env => { }; error as e => return e }
                i++
            }
            env   // binds nothing
        }
        parser::GroupBindPattern as gp => {
            var sub = match group_bind_subunion(gp, subject, table, env.cur_ns) { Type as t => t; error as e => return e }
            define(env, gp.binding, sub, false)
        }
        parser::MacroPattern => error { message = "internal: an unexpanded @Type() macro reached pattern checking — it should be expanded by the Family-A pre-pass (§9.D CR3)" }
    }
}

/**
 * group_bind_subunion — resolve a `GroupBindPattern`'s bound TYPE: the NESTED `Variant` member of the
 * match subject whose members are exactly the group's options (in source order). The group is built into
 * a candidate anonymous union and matched by `type_eq` against the subject's DIRECT members; the found
 * member is returned UNCHANGED, so the bound `v` aliases the boxed nested variant the subject already
 * carries at that tag slot — no re-tag, no re-box (§9.D nested-group byte-identity). Errors when an
 * option is not a bare case name, or when no subject member is the union of exactly those options.
 *
 * @param gp       the grouped bind pattern
 * @param subject  the match subject's resolved type
 * @param table    the program type table
 * @param ref_ns   the match arm's referencing namespace
 * @return         the subject's nested `Variant` member the group binds, or a located error
 * @throws         when an option is not a bare case name, or the group is not a nested member of the subject
 * @since          §9.D capability (c)
 */
fn group_bind_subunion(gp: parser::GroupBindPattern, subject: Type, table: TypeTable, ref_ns: str): Type | error {
    var subject_variant = expand_variant(subject, table)
    var candidate = match group_candidate(gp, table, ref_ns) { Type as t => t; error as e => return e }
    match group_member_of(subject_variant, candidate) {
        Type as m => m
        null => error { message = "the grouped bind '(… | …) as v' does not match a nested union member of the subject — its options must be exactly the cases of one nested `(… | …)` member (§9.D)" }
    }
}

/**
 * group_candidate — the anonymous sub-union a `GroupBindPattern`'s options describe: each option resolved
 * to its case type, in source order, null-normalized (so it matches how the subject's nested `(… | …)`
 * member was itself resolved). Independent of the subject — used both to bind (`group_bind_subunion`) and
 * to test exhaustive coverage (`some_arm_covers_type`).
 *
 * @param gp      the grouped bind pattern
 * @param table   the program type table
 * @param ref_ns  the match arm's referencing namespace
 * @return        the group's anonymous `Variant`, or the first option-resolution error
 * @throws        when an option is not a bare case name or does not resolve
 * @since         §9.D capability (c)
 */
fn group_candidate(gp: parser::GroupBindPattern, table: TypeTable, ref_ns: str): Type | error {
    var opts: []Type = teko::list::empty()
    var i = 0
    loop {
        if i >= gp.options.len { break }
        var ot = match group_option_type(gp.options[i], table, ref_ns) { Type as t => t; error as e => return e }
        opts = teko::list::push(opts, ot)
        i++
    }
    Variant { members = union_normalize_null(opts) }
}

/**
 * group_option_type — the resolved case TYPE of one `GroupBindPattern` option: a non-slice `BindPattern`'s
 * named case; a slice pattern or any other shape is a located error (an option must be a bare case name).
 *
 * @param p       the option pattern
 * @param table   the program type table
 * @param ref_ns  the match arm's referencing namespace
 * @return        the option's resolved type, or a located error
 * @throws        when the option is not a bare case name
 * @since         §9.D capability (c)
 */
fn group_option_type(p: parser::Pattern, table: TypeTable, ref_ns: str): Type | error {
    match p {
        parser::BindPattern as bp => if bp.is_slice { error { message = "a grouped bind option must be a bare case name, not a slice pattern" } } else { bind_pattern_type(bp, table, ref_ns) }
        _ => error { message = "a grouped bind option '(… | …) as v' must be a bare case name" }
    }
}

/**
 * group_member_of — the DIRECT member of `subject_variant` that is `type_eq` to `candidate` (the group's
 * anonymous sub-union), or null when no member matches. The subject is kept nested, so a nested
 * `(B | C)` member is a `Variant` sitting at one tag slot; this finds THAT member so the bind aliases it.
 *
 * @param subject_variant  the subject's one-level variant view
 * @param candidate        the group's anonymous sub-union
 * @return                 the matching nested member, or null
 * @since                  §9.D capability (c)
 */
fn group_member_of(subject_variant: Type, candidate: Type): Type | null {
    match subject_variant {
        Variant as v => {
            var i = 0
            loop {
                if i >= v.members.len { break }
                if type_eq(v.members[i], candidate) { return v.members[i] }
                i++
            }
            null
        }
        _ => null
    }
}

// --- exhaustiveness (B.15) ---

// an UNGUARDED `_` covers everything; a guarded `_ when g` does NOT (B.15 — `when` excluded).
fn has_wildcard(arms: []parser::Arm): bool {
    var i = 0
    loop {
        if i >= arms.len { break }
        if !arms[i].has_when {
            match arms[i].pattern { parser::WildcardPattern => return true; _ => { } }
        }
        i++
    }
    false
}

// the case-name(s) a variant pattern selects: a single Bind/Field, or EACH bare option of an Alt.
// A slice bind (`[]T as x`) names NO nominal case (its type_name is empty) — it is skipped here
// (and the empty-path read avoided); it is covered by some_arm_covers_type instead.
// (W9.4) the case-name a single bind names: the resolved INSTANCE name `Gen__g__i64` when it carries
// explicit type-args, else the bare last path segment. Mirrors bind_pattern_type's instance resolution
// so exhaustiveness over a `variant Gen<i64> | …` covers the `Gen<i64> as x` arm by the member's name.
fn bind_case_name(bp: parser::BindPattern, table: TypeTable, ref_ns: str): str {
    if bp.type_args.len > 0 {
        var ct = match bind_pattern_type(bp, table, ref_ns) { Type as t => t; error => Void { } }   // (#109 W2) generic-instance case name resolves in the match's namespace
        match ct {
            Named as n => return n.name
            _ => { }
        }
    }
    bp.type_name.segments[bp.type_name.segments.len - 1].name
}

fn arm_case_names(p: parser::Pattern, table: TypeTable, ref_ns: str): []str {
    match p {
        parser::BindPattern as bp => {
            if bp.is_slice { teko::list::empty() }
            else { teko::list::push(teko::list::empty(), bind_case_name(bp, table, ref_ns)) }
        }
        parser::FieldPattern as fp => teko::list::push(teko::list::empty(), fp.type_name.segments[fp.type_name.segments.len - 1].name)
        parser::AltPattern as ap => {
            var names: []str = teko::list::empty()
            var i = 0
            loop {
                if i >= ap.options.len { break }
                match ap.options[i] {
                    parser::BindPattern as bp => { if !bp.is_slice { names = teko::list::push(names, bind_case_name(bp, table, ref_ns)) } }
                    parser::FieldPattern as fp => { names = teko::list::push(names, fp.type_name.segments[fp.type_name.segments.len - 1].name) }
                    _ => { }
                }
                i++
            }
            names
        }
        _ => teko::list::empty()
    }
}

// Resolve the type a BIND pattern denotes: `[]T as x` → the slice type, else the named/builtin path.
// (W9.4) `Foo<i64> as x` carries explicit type-args → resolve the concrete instance `Foo__g__i64`
// (validates arity / rejects non-generic-with-args), so exhaustiveness/binding use the stamped type.
// (#109 W1) `ref_ns` = the namespace of the match arm (referencing ns for the pattern's type name);
// threaded to resolve_type/resolve_named, unused until W2's R0-R5 rules.
fn bind_pattern_type(bp: parser::BindPattern, table: TypeTable, ref_ns: str): Type | error {
    if bp.is_slice {
        match bp.slice_type {
            parser::TypeExpr as st => resolve_type(st, table, ref_ns)
            null => error { message = "internal: slice pattern missing its slice type" }
        }
    } else if bp.type_args.len > 0 {
        resolve_type(parser::NamedType { path = bp.type_name; args = bp.type_args }, table, ref_ns)
    } else {
        resolve_named(bp.type_name, table, ref_ns, 0)
    }
}

// Does some UNGUARDED arm cover variant member `mem` by resolved-TYPE equality? Covers the
// non-nominal members of a `T | error` style variant (prim/byte/str/slice/error) — the arm is a
// bind whose resolved type equals the member. NAMED (nominal) members use some_arm_names instead.
fn some_arm_covers_type(arms: []parser::Arm, mem: Type, table: TypeTable, ref_ns: str): bool {
    var i = 0
    loop {
        if i >= arms.len { break }
        if !arms[i].has_when {
            match arms[i].pattern {
                parser::BindPattern as bp => {
                    match bind_pattern_type(bp, table, ref_ns) { Type as t => { if type_eq(t, mem) { return true } }; error => { } }   // (#109 W2) coverage check resolves the arm pattern in the match's namespace
                }
                parser::AltPattern as ap => {
                    var j = 0
                    loop {
                        if j >= ap.options.len { break }
                        match ap.options[j] {
                            parser::BindPattern as bp => { match bind_pattern_type(bp, table, ref_ns) { Type as t => { if type_eq(t, mem) { return true } }; error => { } } }   // (#109 W2) coverage check resolves the arm pattern in the match's namespace
                            _ => { }
                        }
                        j++
                    }
                }
                parser::GroupBindPattern as gp => {
                    match group_candidate(gp, table, ref_ns) { Type as cand => { if type_eq(cand, mem) { return true } }; error => { } }
                }
                _ => { }
            }
        }
        i++
    }
    false
}

// is `name` covered by some UNGUARDED arm (directly via Bind/Field, or via an Alt option)?
fn some_arm_names(arms: []parser::Arm, name: str, table: TypeTable, ref_ns: str): bool {
    var i = 0
    loop {
        if i >= arms.len { break }
        if !arms[i].has_when {
            var names = arm_case_names(arms[i].pattern, table, ref_ns)
            var j = 0
            loop {
                if j >= names.len { break }
                if names[j] == name { return true }
                j++
            }
        }
        i++
    }
    false
}

// every member of the variant must be covered by some unguarded arm: NAMED (nominal) members by
// name; non-nominal members (prim/byte/str/slice/error — the `T | error` idiom) by resolved-type.
fn variant_covered(arms: []parser::Arm, members: []Type, table: TypeTable, ref_ns: str): bool {
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] {
            Named as nm => { if !some_arm_names(arms, name_last_segment(nm.name), table, ref_ns) { return false } }   // (#109 W3) canonical member name → bare, to match the arms' bare case names
            Null => { if !some_arm_is_null(arms) { return false } }
            _ => { if !some_arm_covers_type(arms, members[i], table, ref_ns) { return false } }
        }
        i++
    }
    true
}

// (C7b) every member of the enum must be covered by some unguarded arm (by name).
fn enum_covered(arms: []parser::Arm, eb: parser::EnumBody, table: TypeTable, ref_ns: str): bool {
    var i = 0
    loop {
        if i >= eb.members.len { break }
        if !some_arm_names(arms, eb.members[i], table, ref_ns) { return false }
        i++
    }
    true
}

// is the NONE case (a `null` pattern) covered by some UNGUARDED arm?
fn some_arm_is_null(arms: []parser::Arm): bool {
    var i = 0
    loop {
        if i >= arms.len { break }
        if !arms[i].has_when {
            match arms[i].pattern { parser::NullPattern => return true; _ => { } }
        }
        i++
    }
    false
}

/**
 * subclasses_of — the CLOSED set of concrete (instantiable) subclasses of a polymorphic base class,
 * for the exhaustiveness of a `match` over a sealed class hierarchy (match-universal phase 1). Scans
 * the whole-program type table for every class whose base chain reaches `base` (the inverse of
 * `subclass_reaches`, which walks sub→base) and that is itself instantiable (not `abstract`), plus
 * `base` itself when `base` is directly instantiable (a `virtual` root). The set is closed over the
 * compiled program: whole-program visibility is what "sealed for exhaustiveness" means here.
 *
 * @param base_name  the polymorphic base class's (canonical or bare) name
 * @param table      the program's type table
 * @return           the concrete-subclass names, in declaration order
 * @see              subclass_reaches (the sub→base direction this inverts)
 */
fn subclasses_of(base_name: str, table: TypeTable): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        var reg = tt_at(table, i)
        match reg.decl.body {
            parser::ClassBody as cb => {
                var is_abstract = match cb.kind { parser::ClassKind::Abstract => true; _ => false }
                if !is_abstract {
                    var is_self = name_last_segment(reg.name) == name_last_segment(base_name)
                    if is_self || subclass_reaches(reg.name, base_name, table, 64) { out = teko::list::push(out, reg.name) }
                }
            }
            _ => { }
        }
        i++
    }
    out
}

/**
 * class_covered — is every member of a sealed class's CLOSED subclass set named by some UNGUARDED
 * arm? The class-axis twin of `variant_covered`/`enum_covered`: a guarded arm (`when`) does NOT
 * count toward covering its subclass (B.15 — the guard may be false).
 *
 * @param arms    the match arms
 * @param subs    the concrete subclass names (from `subclasses_of`)
 * @param table   the program's type table
 * @param ref_ns  the match site's namespace (for the arms' name resolution)
 * @return        true iff every `subs[i]` is named by some unguarded arm
 */
fn class_covered(arms: []parser::Arm, subs: []str, table: TypeTable, ref_ns: str): bool {
    if subs.len == 0 { return false }
    var i: u64 = 0
    loop {
        if i >= subs.len { break }
        if !some_arm_names(arms, name_last_segment(subs[i]), table, ref_ns) { return false }
        i++
    }
    true
}

/**
 * exhaustive — does the arm set cover the subject exhaustively (B.15)? An unguarded `_` covers all.
 * An ENUM subject is exhaustive iff every member is named; a VARIANT subject (a named alias expands
 * first, B.14/B.15) iff every case is covered. A polymorphic BASE-CLASS subject is a CLOSED set: it
 * is exhaustive iff an unguarded bind-all names the base OR every concrete subclass is covered
 * (match-universal phase 1). An INTERFACE subject is an OPEN set — exhaustive only via an unguarded
 * catch-all `_` or a bind-all naming the interface. Every other subject (struct/primitive/service)
 * is likewise open and requires that unguarded catch-all/bind-all.
 *
 * @param arms     the match arms
 * @param subject  the resolved subject type
 * @param table    the program's type table
 * @param ref_ns   the match site's namespace
 * @return         true iff the arms cover the subject exhaustively
 */
fn exhaustive(arms: []parser::Arm, subject: Type, table: TypeTable, ref_ns: str): bool {
    if has_wildcard(arms) { return true }
    match subject {   // an ENUM subject — exhaustive iff EVERY member is named (C7b)
        Named as n => {
            match type_table_find(table, n.name, "") {   // (#109) resolved-name probe — namespace-blind (type_table_find ignores ref_ns)
                parser::TypeDecl as td => {
                    match td.body {
                        parser::EnumBody as eb => return enum_covered(arms, eb, table, ref_ns)
                        _ => { }
                    }
                }
                error => { }
            }
        }
        _ => { }
    }
    match expand_variant(subject, table) {   // a NAMED variant → its Variant cases (B.14/B.15)
        Variant as v => variant_covered(arms, v.members, table, ref_ns)
        _ => exhaustive_type_subject(arms, subject, table, ref_ns)
    }
}

/**
 * exhaustive_type_subject — the class/interface axis of `exhaustive` (match-universal phase 1), for
 * a NON-variant, NON-enum subject. A polymorphic base-class subject is exhaustive iff an unguarded
 * bind-all names the base or the closed subclass set is fully covered. An interface subject is
 * exhaustive only via an unguarded bind-all naming it (its `_` case is handled by `has_wildcard`
 * upstream). Every other subject kind is open and requires the catch-all, so it answers false.
 *
 * @param arms     the match arms
 * @param subject  the resolved (non-variant, non-enum) subject type
 * @param table    the program's type table
 * @param ref_ns   the match site's namespace
 * @return         true iff the arms cover the class/interface subject exhaustively
 */
fn exhaustive_type_subject(arms: []parser::Arm, subject: Type, table: TypeTable, ref_ns: str): bool {
    match subject {
        Named as n => {
            if is_polymorphic_base(n.name, table) {
                if some_arm_names(arms, name_last_segment(n.name), table, ref_ns) { return true }
                return class_covered(arms, subclasses_of(n.name, table), table, ref_ns)
            }
            if is_interface_name(n.name, table) {
                if some_arm_names(arms, name_last_segment(n.name), table, ref_ns) { return true }
            }
        }
        _ => { }
    }
    false
}
