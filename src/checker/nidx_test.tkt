fn nidx_lookup_pos(idx: NameIndex, names: []str, name: str): i64 {
    var h = teko::runtime::str_hash(name)
    var best: i64 = -1
    var k = nidx_lower_bound(idx, h)
    loop {
        if k >= idx.slots.len { break }
        if idx.slots[k].hash != h { break }
        var p = idx.slots[k].pos
        if names[p] == name && (p to i64) > best { best = p to i64 }
        k++
    }
    best
}

#test fn nidx_duplicate_name_takes_max_position() {
    var names = ["a", "b", "a", "c"]
    var idx = nidx_build(names)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "a") == 2)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "b") == 1)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "c") == 3)
}

#test fn nidx_absent_name_is_not_found() {
    var names = ["a", "b", "a", "c"]
    var idx = nidx_build(names)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "z") == -1)
}

#test fn nidx_empty_finds_nothing() {
    var names: []str = teko::list::empty()
    var idx = nidx_empty()
    teko::assert::is_true(idx.slots.len == 0)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "a") == -1)
}

#test fn nidx_singleton_resolves_and_rejects() {
    var names = ["only"]
    var idx = nidx_build(names)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "only") == 0)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "other") == -1)
}

#test fn nidx_collision_is_separated_by_byte_retest() {
    var names = ["foo", "bar"]
    var h = teko::runtime::str_hash("foo")
    var idx = NameIndex { slots = [NameSlot { hash = h; pos = 0 }, NameSlot { hash = h; pos = 1 }] }
    teko::assert::is_true(nidx_lookup_pos(idx, names, "foo") == 0)
    teko::assert::is_true(nidx_lookup_pos(idx, names, "bar") == -1)
}

#test fn nidx_lower_bound_contract() {
    var idx = NameIndex { slots = [NameSlot { hash = 10; pos = 0 }, NameSlot { hash = 20; pos = 1 }, NameSlot { hash = 20; pos = 2 }, NameSlot { hash = 30; pos = 3 }] }
    teko::assert::is_true(nidx_lower_bound(idx, 5) == 0)
    teko::assert::is_true(nidx_lower_bound(idx, 10) == 0)
    teko::assert::is_true(nidx_lower_bound(idx, 20) == 1)
    teko::assert::is_true(nidx_lower_bound(idx, 25) == 3)
    teko::assert::is_true(nidx_lower_bound(idx, 30) == 3)
    teko::assert::is_true(nidx_lower_bound(idx, 99) == 4)
}
