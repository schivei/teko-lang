use teko::parser

// fn_escaping_vars — the per-function escape set: every local that outlives the frame. PUBLIC:
// the codegen (both engines) and the checker test read it. A function's PARAMETERS are immutable
// inputs (B.21) and never frame-allocated here, so they need no entry. The body is analysed in
// TAIL position: its trailing value-bearing expr-statement is an IMPLICIT RETURN (escaping).
pub fn fn_escaping_vars(f: TFunction) -> []str {
    mut acc: []str = teko::list::empty()
    mark_block(f.body, true, acc)
    acc
}

/**
 * fn_frees_old_vars — the per-function set of accumulator names whose whole-fn linear-chain proof
 * (`assign_frees_old`) holds, so any self-append `xs = push(xs, …)` to one of them may FREE-OLD on
 * a copy-grow (park the superseded buffer for reuse). PUBLIC, mirroring `fn_escaping_vars`: the C
 * emitter re-derives the proof per-assign (it has the enclosing `fn_body` at every emit site), but
 * the NATIVE backend lowers a push from a bare `TCall` with no assign/body context, so it reads this
 * precomputed set instead — one entry per proven name, checked once against the whole body. The
 * escaping-accumulator exclusion lives in `assign_frees_old` itself, so both engines agree here.
 *
 * @param f  the typed function
 * @return   the names whose accumulator chain is proven linear (free-old-safe)
 * @since 0.3.1 (native free-old parity, #148)
 */
pub fn fn_frees_old_vars(f: TFunction) -> []str {
    mut acc: []str = teko::list::empty()
    collect_frees_old_names(f.body, f.body, acc)
    acc
}

// binding_is_frame_local — is this binding a SIMPLE non-escaping local whose storage may ride a
// tighter-than-root region? A `const`, a destructure, a discard (`_`), or an escaping name is NOT
// frame-local. Codegen still decides which concrete representations actually allocate in that
// region (struct auto-box, boxed union payload, routed slice growth, ...). PUBLIC.
pub fn binding_is_frame_local(escaping: []str, b: TBinding) -> bool {
    let name = match b.target {
        parser::SimpleName as sn => sn.name
        parser::DestructurePattern => return false
    }
    if name == "_" { return false }
    if b.kind == parser::BindKind::Const { return false }
    if str_set_has(escaping, name) { return false }
    true
}

// (S2 Level-1) assign_is_self_append — is `a` exactly `xs = teko::list::push(xs, item)` (a plain
// SIMPLE name write whose RHS grows the SAME name)? Only this shape earns the base-read carve-out;
// a field/deref write, a different target, or any other RHS keeps the conservative escaping mark.
pub fn assign_is_self_append(a: TAssign) -> bool {
    match a.kind { parser::AssignKind::Simple => { }; _ => return false }
    match a.value.kind {
        TCall as c => {
            if !tcall_is_list_push(c) { return false }
            if c.args.len != 2 { return false }
            match c.args[0].kind {
                TVar as v => v.name == a.name
                _ => false
            }
        }
        _ => false
    }
}

// (S2 Level-1) assign_routes_to_frame — THE routing predicate: should this assignment's grown slice
// buffer be allocated in the function frame region (freed when the frame drops)? True iff it is a
// self-append `xs = push(xs, …)` whose target xs is a NON-escaping slice, so its whole buffer history
// dies with the frame. The codegen and the escape carve-out (mark_stmt) SHARE this exact shape — they
// must never disagree: a routed push whose base the carve-out did NOT exempt could leave xs escaping
// (leak, safe) but a base the carve-out exempted that codegen does NOT route just stays on root (also
// safe). Coupling them here keeps both correct by construction. PUBLIC (codegen reads it).
pub fn assign_routes_to_frame(escaping: []str, a: TAssign) -> bool {
    if !assign_is_self_append(a) { return false }
    if str_set_has(escaping, a.name) { return false }
    match a.bound {
        Slice => true
        _ => false
    }
}
