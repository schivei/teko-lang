// src/checker/typer.tks  (namespace 'teko::checker')
// Each check_* (E4/E5) EVOLVES into a type_*: the SAME checks (B.22 regimes, B.20
// `if`, B.15 `match` + exhaustiveness), but the producer BUILDS the typed node
// instead of returning a bare Type. Predicates (is_bool/is_integer/op_is_*),
// resolvers (resolve_type), env (lookup/define) and the pattern + exhaustiveness
// logic (check_pattern/exhaustive) are reused from their stages — re-derivation,
// not duplication (M.5). C1: every node, statement and item re-derived.

use teko::lexer
use teko::parser

/**
 * type_number — the leaf typing of a number literal (N1/N2, B.38): adopts a DEFAULT type — `i64`
 * for an integer literal, `f64` for a float. An annotation/expected type re-adopts a fitting
 * literal at the binding/cast site (`annotated_literal_ok`/`const_range_check`), where the full
 * int set (`u8..u64`/`i8..i64`) and the float set (`f32`/`f64`) come into play (literal typing in
 * annotated context: C6).
 *
 * @param n  the parsed number literal
 * @return   the typed leaf, defaulted to `i64`/`f64`
 */
fn type_number(n: parser::Number): TExpr {
    var k = if n.is_float { PrimKind::F64 } else { PrimKind::I64 }
    TExpr { kind = TNumber { is_float = n.is_float; value = n.value; fval = n.fval }; type = Prim { kind = k }; line = 0; col = 0 }
}
fn type_strlit(s: parser::StrLit): TExpr {
    TExpr { kind = TStrLit { text = s.text }; type = Str { }; line = 0; col = 0 }
}
fn type_bytelit(b: parser::ByteLit): TExpr {
    TExpr { kind = TByteLit { value = b.value }; type = Byte { }; line = 0; col = 0 }
}

// a char literal `c'x'` types as `char` (its OWN tag); the raw UTF-8 bytes ride the node.
fn type_charlit(c: parser::CharLit): TExpr {
    TExpr { kind = TCharLit { bytes = c.bytes }; type = Char { }; line = 0; col = 0 }
}
fn type_boollit(b: parser::BoolLit): TExpr {   // `true`/`false` — the bool prim (LEGISLATION §75)
    TExpr { kind = TBoolLit { value = b.value }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}
/**
 * type_nulllit — a bare `null` literal is the concrete unit value `null : Null`. It
 * WIDENS by set-membership into any union listing `null` (see `null_widens_into`); the
 * destination type supplies the surrounding union at the binding/return/arm slot, exactly
 * as a variant case widens into its variant (REBOOT_PLAN §202).
 *
 * @param n  the parsed `null` literal node
 * @return   a `TExpr` whose `.type` is `Null{}` (never fails; the `| error` is the
 *           uniform typer return shape)
 * @since 0.3.1
 */
fn type_nulllit(n: parser::NullLit): TExpr | error {
    TExpr { kind = TNullLit { }; type = Null { }; line = 0; col = 0 }
}
fn type_var(v: parser::Var, env: Env): TExpr | error {
    var b = match lookup_binding(env, v.name) { ValBinding as bb => bb; error as e => return e }
    // (W10a) a bare reference to a top-level FUNCTION used as a VALUE: only `define_fn` sets a
    // non-empty `ns`, so `ns != "" && type is Func` uniquely identifies a fn reference (a local of
    // closure type has ns=""). It lowers to a `tk_closure` literal; a plain local emits its name.
    var is_fn = b.ns.len > 0 && (match b.type { Func => true; _ => false })
    TExpr { kind = TVar { name = v.name; is_func = is_fn; func_ns = b.ns }; type = b.type; line = 0; col = 0 }
}

// ============================================================================
// (W10) CLOSURE LITERALS — type a `(params) => body` lambda, analyse its captures.
// ============================================================================

/**
 * Collects the names a lambda body's statements READ (`refs`), the names they BIND internally
 * (`bound` — inner `let`s + nested-lambda params) and the names they ASSIGN TO by bare name
 * (`writes`), transitively over every statement in `stmts`, so the free variables are
 * `refs − bound − <params>` and the assigned free variables are `writes − bound − <params>`
 * (0.3.1 — `ref` params, write-through, replacing the pre-adoption `Ref<[]str>` spelling;
 * `str_set_add`'s explicit `.value` read stays — passing a `ref` argument bare into a plain-value
 * parameter is not yet checker-auto-deref'd at a call site).
 *
 * @param stmts   the statement block to scan
 * @param refs    accumulates every read name (by-reference, write-through)
 * @param bound   accumulates every internally-bound name (by-reference, write-through)
 * @param writes  accumulates every bare-name assignment target (by-reference, write-through)
 */
fn lam_collect_block(stmts: []parser::Statement, ref refs: []str, ref bound: []str, ref writes: []str) {
    var i = 0
    loop { if i >= stmts.len { break }; lam_collect_stmt(stmts[i], refs, bound, writes); i++ }
}
/**
 * Collects the read/bound/written names of a single lambda-body statement `s` — the
 * per-statement-kind dispatch `lam_collect_block` folds over a whole block. A bare-name `Assign`
 * (`AssignKind::Simple`, no walkable `.target` expr) registers its `name` in BOTH `refs` and
 * `writes`: in `refs` because a `ref`-bound write-through assignment (`r = v`) has no
 * `FieldAccess` target to recurse into the way the pre-adoption `r.value = v` spelling did, so it
 * would otherwise never be captured; in `writes` because the capture is by COPY unless the name is
 * `ref`-bound, and only the caller (`type_lambda`, which has the enclosing scope) can tell the two
 * apart and reject the copy case honestly. A `Field`/`Index` target is still walked via `.target`.
 *
 * @param s       the statement to scan
 * @param refs    accumulates every read name (by-reference, write-through)
 * @param bound   accumulates every internally-bound name (by-reference, write-through)
 * @param writes  accumulates every bare-name assignment target (by-reference, write-through)
 */
fn lam_collect_stmt(s: parser::Statement, ref refs: []str, ref bound: []str, ref writes: []str) {
    match s {
        parser::Binding as b => {
            lam_collect_expr(b.value, refs, bound, writes)
            match b.target {
                parser::SimpleName as sn => bound = str_set_add(bound.value, sn.name)
                parser::DestructurePattern as dp => { var j = 0; loop { if j >= dp.names.len { break }; bound = str_set_add(bound.value, dp.names[j]); j++ } }
            }
        }
        parser::Assign as a => {
            lam_collect_expr(a.value, refs, bound, writes)
            if parser::assign_has_target(a.kind) {
                lam_collect_expr(a.target, refs, bound, writes)
            } else {
                refs = str_set_add(refs.value, a.name)
                writes = str_set_add(writes.value, a.name)
            }
        }
        parser::Return as r => if r.has_value { lam_collect_expr(r.value, refs, bound, writes) } else { }
        parser::LoopStmt as l => { lam_collect_block(l.init, refs, bound, writes); lam_collect_block(l.body, refs, bound, writes) }
        parser::ExprStmt as es => lam_collect_expr(es.expr, refs, bound, writes)
        parser::DeferStmt as d => lam_collect_block(d.body, refs, bound, writes)
        parser::AdoptStmt as a => lam_collect_block(a.body, refs, bound, writes)
        parser::BlockStmt as b => lam_collect_block(b.body, refs, bound, writes)
        parser::BreakStmt => { }
        parser::ContinueStmt => { }
        parser::MultiBind as mb => {
            var vi = 0
            loop {
                if vi >= mb.values.len { break }
                lam_collect_expr(mb.values[vi], refs, bound, writes)
                vi++
            }
            var ti = 0
            loop {
                if ti >= mb.targets.len { break }
                match mb.targets[ti] {
                    parser::BindName as bn => bound = str_set_add(bound.value, bn.name)
                    parser::BindSkip => { }
                    parser::BindRest => { }
                }
                ti++
            }
        }
    }
}
/**
 * Collects the read/bound/written names of a single lambda-body expression `e` — the
 * per-expression-kind dispatch `lam_collect_stmt`/`lam_collect_block` recurse through. An
 * expression carries no assignment of its own, but the BLOCKS inside one (an `if`/`match` arm, a
 * nested lambda body) do, so `writes` is threaded through unchanged. One arm carries history worth
 * keeping: `Borrow` (`&x`) recurses because a free read transits through the borrowed operand (AL
 * wave F1).
 *
 * @param e       the expression to scan
 * @param refs    accumulates every read name (by-reference, write-through)
 * @param bound   accumulates every internally-bound name (by-reference, write-through)
 * @param writes  accumulates every bare-name assignment target (by-reference, write-through)
 */
fn lam_collect_expr(e: parser::Expr, ref refs: []str, ref bound: []str, ref writes: []str) {
    match e.kind {
        parser::Var as v => refs = str_set_add(refs.value, v.name)
        parser::Binary as b => { lam_collect_expr(b.left, refs, bound, writes); lam_collect_expr(b.right, refs, bound, writes) }
        parser::Unary as u => lam_collect_expr(u.operand, refs, bound, writes)
        parser::Compare as c => { lam_collect_expr(c.first, refs, bound, writes); var i = 0; loop { if i >= c.rest.len { break }; lam_collect_expr(c.rest[i].operand, refs, bound, writes); i++ } }
        parser::Call as cl => { if cl.callee.segments.len == 1 { refs = str_set_add(refs.value, cl.callee.segments[0].name) }; var i = 0; loop { if i >= cl.args.len { break }; lam_collect_expr(cl.args[i], refs, bound, writes); i++ } }
        parser::IfExpr as f => { lam_collect_expr(f.cond, refs, bound, writes); lam_collect_block(f.then_blk, refs, bound, writes); if f.has_else { lam_collect_block(f.else_blk, refs, bound, writes) } }
        parser::MatchExpr as m => { lam_collect_expr(m.subject, refs, bound, writes); var i = 0; loop { if i >= m.arms.len { break }; lam_collect_block(m.arms[i].body, refs, bound, writes); i++ } }
        parser::FieldAccess as fa => lam_collect_expr(fa.receiver, refs, bound, writes)
        parser::Cast as ct => lam_collect_expr(ct.expr, refs, bound, writes)
        parser::Borrow as b => lam_collect_expr(b.operand, refs, bound, writes)
        parser::MethodCall as mc => { lam_collect_expr(mc.receiver, refs, bound, writes); var i = 0; loop { if i >= mc.args.len { break }; lam_collect_expr(mc.args[i], refs, bound, writes); i++ } }
        parser::StructLit as sl => { var i = 0; loop { if i >= sl.field_vals.len { break }; lam_collect_expr(sl.field_vals[i], refs, bound, writes); i++ } }
        parser::Index as ix => { lam_collect_expr(ix.receiver, refs, bound, writes); lam_collect_expr(ix.index, refs, bound, writes) }
        parser::Interp as in => { var i = 0; loop { if i >= in.holes.len { break }; lam_collect_expr(in.holes[i], refs, bound, writes); i++ } }
        parser::InExpr as n => { lam_collect_expr(n.lhs, refs, bound, writes); var i = 0; loop { if i >= n.elems.len { break }; lam_collect_expr(n.elems[i], refs, bound, writes); i++ } }
        parser::ArrayLit as a => { var i = 0; loop { if i >= a.elements.len { break }; lam_collect_expr(a.elements[i].expr, refs, bound, writes); i++ } }
        parser::Lambda as lam => { var i = 0; loop { if i >= lam.params.len { break }; bound = str_set_add(bound.value, lam.params[i].name); i++ }; lam_collect_block(lam.body, refs, bound, writes) }
        parser::Block as blk => lam_collect_block(blk.body, refs, bound, writes)
        parser::Number => { }
        parser::StrLit => { }
        parser::ByteLit => { }
        parser::CharLit => { }
        parser::BoolLit => { }
        parser::NullLit => { }
        parser::PathExpr => { }
    }
}

// type a closure literal. `expected` is the target type when known (a binding annotation / call-arg
// param) so an un-annotated parameter infers from it (W10 ruling 3); Void = no target. On success the
// TExpr.type is the closure's Func type. Captures = free vars resolving to ENCLOSING LOCALS (ns ""),
// each by-copy unless it is a `Ref<T>` (by_ref — the only path to shared mutation).
// resolve ONE closure parameter's type: its annotation, else the target's param type at `idx`
// (W10 ruling 3 — inference from the target), else an honest error (annotate or give a target type).
fn lam_param_type(p: parser::LambdaParam, idx: u64, exp_params: []Type, table: TypeTable, ref_ns: str): Type | error {
    // (#109 W1) ref_ns = the namespace the lambda is written in; unused until W2's R0-R5 rules.
    if p.has_type { return resolve_type(p.type_ann, table, ref_ns) }
    if idx < exp_params.len { return exp_params[idx] }
    error { message = $"cannot infer the type of closure parameter `{p.name}` — annotate it (`{p.name}: T`) or give the closure a target type" }
}
/**
 * lam_reject_copy_capture_write — reject a lambda body that ASSIGNS to a captured variable whose
 * capture is by COPY. A capture is by reference only when the enclosing binding is itself
 * `Reference`-typed (`type_lambda`'s `by_ref`); for every other type the closure gets a copy, so
 * `mut n = 0; let g = () => { n = 5; 0 }` used to type-check, run, and DISCARD the write with no
 * diagnostic at all — the worst M.3 category, a miscompilation of a program that looks legal.
 *
 * Names bound INSIDE the body (inner `let`s, the lambda's own params — the `bound` set) are the
 * lambda's own locals and are never captures. A name that resolves to a global/function (`ns != ""`)
 * or does not resolve at all is left alone: the body's own typing already reported the latter.
 *
 * True mutable capture is a language design decision, not a bug fix — this names the barrier
 * instead of silently losing the write.
 *
 * @param writes  the bare-name assignment targets the body collected
 * @param bound   the names the body binds internally (its own locals + params)
 * @param env     the ENCLOSING typing environment (decides ref-bound vs copy)
 * @return        `null` when every assigned name is `ref`-bound or body-local
 * @throws        when the body assigns to a by-copy captured variable
 */
fn lam_reject_copy_capture_write(writes: []str, bound: []str, env: Env): null | error {
    var i: u64 = 0
    loop {
        if i >= writes.len { break }
        var nm = writes[i]
        if !str_set_has(bound, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    var by_ref = match b.type { Reference => true; _ => false }
                    if b.ns.len == 0 && !by_ref {
                        return error { message = $"a lambda cannot assign to the captured variable `{nm}` — the capture is by COPY, so the write would be lost; take it as a `ref` parameter instead" }
                    }
                }
                error => { }
            }
        }
        i++
    }
    null
}

fn type_lambda(lam: parser::Lambda, expected: Type, env: Env, table: TypeTable): TExpr | error {
    var exp_params: []Type = teko::list::empty()
    match expected { Func as ef => exp_params = ef.params; _ => { } }
    // 1. resolve parameter types (annotation, else the target's param type — ruling 3)
    var tparams: []TLambdaParam = teko::list::empty()
    var cenv = env
    var i: u64 = 0
    loop {
        if i >= lam.params.len { break }
        var p = lam.params[i]
        var pt = match lam_param_type(p, i, exp_params, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the lambda's enclosing namespace
        tparams = teko::list::push(tparams, TLambdaParam { name = p.name; type = pt })
        cenv = define(cenv, p.name, pt, false)
        i++
    }
    // 2. type the body in the child scope (params visible). The return type is the TARGET's ret when a
    // target type is present (the annotation is authoritative — and handles a `return`-only body whose
    // trailing value is void); otherwise it is inferred from the body's trailing value.
    var tb = match type_block(lam.body, cenv, table) { TypedBlock as bk => bk; error as e => return e }
    var ret = match expected { Func as ef => ef.ret; _ => tblock_type(tb.stmts) }
    // 3. capture analysis — free vars (refs − bound − params) that resolve to an ENCLOSING LOCAL.
    var refs: []str = teko::list::empty()
    var bnd: []str = teko::list::empty()
    var writes: []str = teko::list::empty()
    var j = 0
    loop { if j >= lam.params.len { break }; bnd = str_set_add(bnd, lam.params[j].name); j++ }
    lam_collect_block(lam.body, refs, bnd, writes)
    match lam_reject_copy_capture_write(writes, bnd, env) { error as e => return e; null => { } }
    var captures: []TCapture = teko::list::empty()
    var k = 0
    loop {
        if k >= refs.len { break }
        var nm = refs[k]
        if !str_set_has(bnd, nm) {
            match lookup_binding(env, nm) {
                ValBinding as b => {
                    if b.ns.len == 0 {   // an enclosing LOCAL (a global/function has ns != "") → a capture
                        var by_ref = match b.type { Reference => true; _ => false }
                        captures = teko::list::push(captures, TCapture { name = nm; type = b.type; by_ref = by_ref })
                    }
                }
                error => { }   // not a local (a global/builtin) or unresolved (body typing already reported it)
            }
        }
        k++
    }
    TExpr { kind = TLambda { params = tparams; body = tb.stmts; captures = captures; ret = ret; lift_id = 0 }; type = Func { params = lam_param_types(tparams); ret = ret; variadic = false; param_names = []; n_required = (lam_param_types(tparams)).len; defaults = []; ret_extra = teko::list::empty() }; line = 0; col = 0 }
}
fn lam_param_types(ps: []TLambdaParam): []Type {
    var out: []Type = teko::list::empty()
    var i = 0
    loop { if i >= ps.len { break }; out = teko::list::push(out, ps[i].type); i++ }
    out
}

// ---- operators (the SAME B.22 regimes as check_binary/check_unary/check_compare) ----

// (2026-07-01) `~` — binary string concat, arity-polymorphic with unary `~` (bitwise NOT, see
// type_unary below). Additive precedence, NOT commutative (honest — Governing Law M.3, the same
// reasoning `+` was rejected for concat: TEKO_LEGISLATION.md "`+` never concatenates").
//
// Flattens a LEFT-ASSOCIATIVE `~` chain (`a ~ b ~ c ~ …`, which parses as a left-leaning
// Binary tree) into a flat piece list, so `a ~ b ~ c` desugars to ONE `teko::string::concat(a,
// b, c)` call — NOT nested 2-arg calls — reusing the params-variadic `concat` built for this.
fn flatten_tilde_chain(e: parser::Expr, acc: []parser::Expr): []parser::Expr {
    match e.kind {
        parser::Binary as b => {
            if b.op == lexer::TokenKind::Tilde {
                var acc2 = flatten_tilde_chain(b.left, acc)
                return flatten_tilde_chain(b.right, acc2)
            }
            teko::list::push(acc, e)
        }
        _ => teko::list::push(acc, e)
    }
}

fn tilde_str_lit_text(e: parser::Expr): str | null {
    match e.kind {
        parser::StrLit as s => s.text
        // (2026-07-01) `$"no holes"` / `$@"""no holes"""` — interpolated syntax with ZERO holes
        // (the `verbatim` escaping flag is already resolved into `pieces` by parse time, so a
        // 0-hole Interp is indistinguishable from a plain literal here). Rare in practice (why
        // use `$`/`$@` with nothing to interpolate?), but foldable, so fold it — max compile-time
        // optimization per the user's explicit ask.
        parser::Interp as it => if it.holes.len == 0 && it.pieces.len == 1 { it.pieces[0] } else { null }
        _ => null
    }
}

// Constant-fold adjacent STR-LITERAL pieces at compile time (e.g. `x ~ "a" ~ "b" ~ y` folds
// `"a" ~ "b"` into ONE literal `"ab"` first, so the runtime call becomes `concat(x, "ab", y)` —
// 2 pieces, not 3). If EVERY piece folds into one literal, the whole `~` chain collapses to that
// single literal at compile time — zero runtime concat calls.
fn fold_tilde_pieces(pieces: []parser::Expr): []parser::Expr {
    var out: []parser::Expr = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= pieces.len { break }
        match tilde_str_lit_text(pieces[i]) {
            str as t0 => {
                var merged = t0
                var j = i + 1
                loop {
                    if j >= pieces.len { break }
                    match tilde_str_lit_text(pieces[j]) {
                        str as tj => { merged = teko::string::concat(merged, tj); j++ }
                        null => { break }
                    }
                }
                out = teko::list::push(out, parser::Expr { kind = parser::StrLit { text = merged }; line = pieces[i].line; col = pieces[i].col })
                i = j
            }
            null => { out = teko::list::push(out, pieces[i]); i++ }
        }
    }
    out
}

fn type_tilde_chain(b: parser::Binary, env: Env, table: TypeTable): TExpr | error {
    var raw = flatten_tilde_chain(parser::Expr { kind = b; line = 0; col = 0 }, teko::list::empty())
    var folded = fold_tilde_pieces(raw)
    if folded.len == 1 { return type_expr(folded[0], env, table) }   // whole chain was literals — a single literal, no runtime call
    var seg_teko = parser::Segment { name = "teko" }
    var seg_string = parser::Segment { name = "string" }
    var seg_concat = parser::Segment { name = "concat" }
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), seg_teko)
    segs = teko::list::push(segs, seg_string)
    segs = teko::list::push(segs, seg_concat)
    var pos_names: []str = teko::list::empty()   // DEFARGS (2026-07-01) — this synthetic call is always all-positional
    var ni: u64 = 0
    loop { if ni >= folded.len { break }; pos_names = teko::list::push(pos_names, ""); ni++ }
    var call = parser::Call { callee = parser::Path { segments = segs }; args = folded; arg_names = pos_names; owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() }
    // `concat`'s own arg-widening (type_call, below) already requires every piece to be `str` —
    // a non-str `~` operand fails there with a clear message, no separate check needed here.
    type_call(call, env, table)
}
/** `~` is desugared WHOLESALE (chain-flattened + literal-folded) BEFORE the generic operand-typing
    below — it never reaches a plain TBinary node (codegen/interpreter see an ordinary TCall or TStrLit,
    nothing new to handle, mirroring how `params` needed no engine changes).
    (S6, issue #162) operators over a constrained type-param T stay a HONEST STOP, intentionally —
    no operator-trait exists yet to authorize `+`/`-`/… the way an interface constraint authorizes
    a method call. `is_numeric`/`is_integer`/`is_bool` below never match a type-param's `Named{T}`
    (opaque OR interface-mirroring), so every arm below already falls through to its own clear error
    for a `T` operand — NO new logic is needed, and none is added here (avoids gold-plating a
    pre-alpha surface). Real operators on T arrive with an operator-trait constraint (#176+). */
/**
 * deref_ref_value — the transparent auto-deref of the `ref` keyword surface (0.3.0.30 Part A). Peels
 * ONE surface `ref`/`Reference{T}` layer off a typed expression used in a VALUE context, so the
 * developer reads a `ref`-bound name bare (no `.value`) exactly as its referenced value. The peel
 * lowers to the same `.value` read (`TFieldAccess` field `value` → codegen `(*p)`) the surface no
 * longer spells. On any non-reference expression it is an identity no-op, so it fires ONLY on the new
 * `ref` surface (the current corpus never produces a bare `Reference` in a value position). References
 * are internally depth-1, so a single peel reaches the value.
 *
 * @param te  the typed operand
 * @return    `te` with its outermost `Reference` peeled to the referenced value, else `te` unchanged
 */
fn deref_ref_value(te: TExpr): TExpr {
    match te.type {
        Reference as rf => TExpr { kind = TFieldAccess { receiver = te; field = "value" }; type = rf.inner; line = te.line; col = te.col }
        _ => te
    }
}

/**
 * bignum_kind — classify a type as one of the compiler-known arbitrary-precision surfaces. Returns
 * `"bigint"` for `teko::numeric::bigint::BigInt`, `"dec"` for `teko::numeric::dec::Decimal`, or the
 * empty string for anything else. The single discriminator behind the operator/comparison sugar.
 *
 * @param t  the resolved type
 * @return   `"bigint"`, `"dec"`, or `""`
 */
fn bignum_kind(t: Type): str {
    match t {
        Named as n => {
            if n.name == "teko::numeric::bigint::BigInt" { return "bigint" }
            if n.name == "teko::numeric::dec::Decimal" { return "dec" }
            ""
        }
        _ => ""
    }
}

/**
 * bignum_named — the `Named` type of a bignum kind (`"bigint"` → the `BigInt` struct, otherwise the
 * `Decimal` struct).
 *
 * @param kind  `"bigint"` or `"dec"`
 * @return      the corresponding `Named` type
 */
fn bignum_named(kind: str): Type {
    if kind == "bigint" { return Named { name = "teko::numeric::bigint::BigInt" } }
    Named { name = "teko::numeric::dec::Decimal" }
}

/**
 * bignum_ns — the runtime module namespace backing a bignum kind (drives the mangled C symbol of the
 * lowered call).
 *
 * @param kind  `"bigint"` or `"dec"`
 * @return      `"teko::numeric::bigint"` or `"teko::numeric::dec"`
 */
fn bignum_ns(kind: str): str {
    if kind == "bigint" { return "teko::numeric::bigint" }
    "teko::numeric::dec"
}

/**
 * bignum_call — build a typed call `teko::numeric::<kind>::<fn_name>(args)` — the ONE runtime
 * implementation both the library and the operator sugar target (no doubling). A namespaced,
 * non-closure `TCall` codegen resolves to the mangled library symbol under both backends.
 *
 * @param kind     `"bigint"` or `"dec"`
 * @param fn_name  the library function's bare name (`add`/`sub`/`mul`/`div`/`rem`/`cmp`/`neg`/`of`)
 * @param args     the typed argument expressions
 * @param ret      the call's result type
 * @return         the typed call expression
 */
fn bignum_call(kind: str, fn_name: str, args: []TExpr, ret: Type): TExpr {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), parser::Segment { name = "teko" })
    segs = teko::list::push(segs, parser::Segment { name = "numeric" })
    segs = teko::list::push(segs, parser::Segment { name = kind })
    segs = teko::list::push(segs, parser::Segment { name = fn_name })
    var callee = parser::Path { segments = segs }
    TExpr { kind = TCall { overload_suffix = ""; callee = callee; args = args; call_ns = bignum_ns(kind); is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = ret; line = 0; col = 0 }
}

/**
 * bignum_adopt_operand — coerce one operand of a bignum operation to the target kind. A value already
 * of that kind passes through; a fitting non-negative integer LITERAL adopts it via the library's
 * `of` constructor (literal-adopt: `big + 1` works). Every other operand — a value of the OTHER
 * bignum kind, a machine-typed variable, or a float literal — is rejected with a diagnostic that
 * names the explicit conversion (no implicit promotion, B.22).
 *
 * @param e     the typed operand
 * @param kind  the target bignum kind (`"bigint"` or `"dec"`)
 * @return      the operand as a value of `kind`, or an error explaining the required explicit step
 * @throws      when the operand mixes bignum kinds, is a non-literal of a different type, is a float
 *              literal, or is an integer literal too large to adopt without a suffix
 */
fn bignum_adopt_operand(e: TExpr, kind: str): TExpr | error {
    if bignum_kind(e.type) == kind { return e }
    if bignum_kind(e.type) != "" { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    match e.kind {
        TNumber as n => {
            if n.is_float { return error { message = $"a floating-point literal cannot adopt `{kind}` — write it with a `bi`/`d` suffix or convert explicitly with `{kind}::of(...)`" } }
            if !numint_fits(n.value, PrimKind::I64) { return error { message = $"integer literal is too large to adopt into `{kind}` — write it with a `bi`/`d` suffix" } }
            var lit = TExpr { kind = e.kind; type = Prim { kind = PrimKind::I64 }; line = e.line; col = e.col }
            bignum_call(kind, "of", teko::list::push(teko::list::empty(), lit), bignum_named(kind))
        }
        _ => error { message = $"no implicit conversion to `{kind}` — wrap the operand with `{kind}::of(x)` (no implicit promotion — B.22)" }
    }
}

/**
 * bignum_op_fn — map a binary operator token to the bignum library function it lowers to. Rejects
 * `%` on `dec` (decimals define no remainder) and any non-arithmetic operator on either kind.
 *
 * @param op    the operator token
 * @param kind  the bignum kind (`"bigint"` or `"dec"`)
 * @return      the library function name, or an error for an unsupported operator
 * @throws      when the operator is `%` on `dec`, or is not one of `+ - * /` (`%` on `bigint`)
 */
fn bignum_op_fn(op: lexer::TokenKind, kind: str): str | error {
    if op == lexer::TokenKind::Plus { return "add" }
    if op == lexer::TokenKind::Minus { return "sub" }
    if op == lexer::TokenKind::Star { return "mul" }
    if op == lexer::TokenKind::Slash { return "div" }
    if op == lexer::TokenKind::Percent {
        if kind == "dec" { return error { message = "`%` (modulo) is not defined on `dec` — a decimal has no remainder operator" } }
        return "rem"
    }
    error { message = $"this operator is not defined on `{kind}` — `bigint` supports `+ - * / %`, `dec` supports `+ - * /`, and comparisons (`< > <= >= == !=`)" }
}

/**
 * type_bignum_binop — lower a binary operator over a bignum operand to its library call (operator
 * sugar). Determines the target kind (rejecting a `bigint`/`dec` mix), maps the operator to its
 * function, adopts each operand, and returns the typed call.
 *
 * @param op     the operator token
 * @param l      the typed left operand
 * @param r      the typed right operand
 * @param lk     the left operand's bignum kind (`""` if not a bignum)
 * @param rk     the right operand's bignum kind (`""` if not a bignum)
 * @return       the typed library call implementing the operator, or a type error
 * @throws       when the operands mix kinds, an operator is unsupported, or an operand cannot adopt
 */
fn type_bignum_binop(op: lexer::TokenKind, l: TExpr, r: TExpr, lk: str, rk: str): TExpr | error {
    if lk != "" && rk != "" && lk != rk { return error { message = "cannot mix `bigint` and `dec` in one operation — convert explicitly" } }
    var kind = if lk != "" { lk } else { rk }
    var fn_name = match bignum_op_fn(op, kind) { str as s => s; error as e => return e }
    var la = match bignum_adopt_operand(l, kind) { TExpr as te => te; error as e => return e }
    var ra = match bignum_adopt_operand(r, kind) { TExpr as te => te; error as e => return e }
    var cargs: []TExpr = teko::list::push(teko::list::empty(), la)
    cargs = teko::list::push(cargs, ra)
    bignum_call(kind, fn_name, cargs, bignum_named(kind))
}

/**
 * combine_and — fold two bool `TExpr`s into a short-circuiting `&&`, or seed the fold with the first
 * term. Used to chain a bignum comparison (`a < b < c` → `cmp(a,b)<0 && cmp(b,c)<0`).
 *
 * @param acc   the accumulated bool expression, or `null` for the first term
 * @param next  the next bool comparison term
 * @return      `acc && next`, or `next` when `acc` is `null`
 */
fn combine_and(acc: TExpr | null, next: TExpr): TExpr {
    match acc {
        TExpr as a => TExpr { kind = TBinary { op = lexer::TokenKind::AndAnd; left = a; right = next }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        null => next
    }
}

/**
 * type_bignum_compare — lower a comparison whose first operand is a bignum to a chain of `cmp(...)
 * <op> 0` terms (comparison sugar). Each adjacent pair becomes a `cmp` call compared to zero; a
 * chained comparison folds the terms with `&&`. Operands adopt the first operand's kind.
 *
 * @param first  the typed (bignum) first operand
 * @param rest   the raw comparison terms (operator + untyped operand)
 * @param env    the typing environment
 * @param table  the folded type table
 * @param kind   the bignum kind of the comparison
 * @return       the typed bool expression, or a type error
 * @throws       when an operand cannot adopt the kind or the chain is empty
 */
fn type_bignum_compare(first: TExpr, rest: []parser::CmpTerm, env: Env, table: TypeTable, kind: str): TExpr | error {
    var prev = match bignum_adopt_operand(first, kind) { TExpr as te => te; error as e => return e }
    var acc: TExpr | null = null
    var i = 0
    loop {
        if i >= rest.len { break }
        var cur_raw = deref_ref_value(match type_expr(rest[i].operand, env, table) { TExpr as te => te; error as e => return e })
        var cur = match bignum_adopt_operand(cur_raw, kind) { TExpr as te => te; error as e => return e }
        var cmp_args: []TExpr = teko::list::push(teko::list::empty(), prev)
        cmp_args = teko::list::push(cmp_args, cur)
        var cmp_call = bignum_call(kind, "cmp", cmp_args, Prim { kind = PrimKind::I64 })
        var zero = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Prim { kind = PrimKind::I64 }; line = 0; col = 0 }
        var term = TCmpTerm { op = rest[i].op; operand = zero }
        var one_cmp = TExpr { kind = TCompare { first = cmp_call; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        acc = combine_and(acc, one_cmp)
        prev = cur
        i = i + 1
    }
    match acc { TExpr as te => te; null => error { message = "a comparison needs at least one operator" } }
}

/**
 * A pair of typed binary operands after literal-adoption normalization.
 */
type BinOperands = struct {
    /** The left operand. */
    l: TExpr
    /** The right operand. */
    r: TExpr
}

/**
 * adopt_binop_operands — when a binary's operands differ only because one is an untyped LITERAL
 * (numeric, `null`, or an `if`/`match`/array composite whose leaves are literals), retype that
 * literal to the other (non-literal) operand's type through `retype_literal` so `line + 1` /
 * `n % 10` type-check (C6) and `a != null` over an `i32 | null` `a` retypes the bare `null` to its
 * matching `Null` member rather than the whole union (the union is a `Variant`, and codegen only
 * ever accepts a bare `null` typed exactly `Null`). The left operand takes priority when both would
 * adopt. Already-equal or non-adoptable operands pass through unchanged.
 *
 * @param l  the typed left operand
 * @param r  the typed right operand
 * @return   the operands with a fitting literal retyped to its partner's type
 */
fn adopt_binop_operands(l: TExpr, r: TExpr): BinOperands {
    if type_eq(l.type, r.type) { return BinOperands { l = l; r = r } }
    if literal_adopts(l, r.type) { return BinOperands { l = retype_literal(l, r.type); r = r } }
    if literal_adopts(r, l.type) { return BinOperands { l = l; r = retype_literal(r, l.type) } }
    BinOperands { l = l; r = r }
}

/**
 * err_binop_type_mismatch — wrap a binary-operand type-mismatch with rendered expected/actual types
 * so the driver prints "expected X, found Y" (mirrors expr.c type_binary's tk_error_types wrap;
 * C1.8/E2).
 *
 * @param msg  the diagnostic message
 * @param l    the left operand (renders as "expected")
 * @param r    the right operand (renders as "actual")
 * @return     the type-annotated error
 */
fn err_binop_type_mismatch(msg: str, l: TExpr, r: TExpr): error {
    teko::error::err_typed(error { message = msg }, type_render(l.type), type_render(r.type))
}

/**
 * type_shift_binop — type a shift (`<< >>`): integer operands only (no float bit-shifts — B.38); the
 * result takes the left operand's type.
 *
 * @param op  the shift operator token
 * @param l   the typed left operand
 * @param r   the typed right operand
 * @return    the typed shift expression, or a type error
 * @throws    when either operand is not an integer
 */
fn type_shift_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_integer(l.type) || !is_integer(r.type) { return error { message = "shift needs integer operands (no float bit-shifts — B.38)" } }
    TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 }
}

/**
 * widen_int_binop — join two INTEGER operand types under the W-RULE (`int_arith_join`,
 * `expr.tks`, §2.1/§2.2) and widen whichever side is narrower to the common result, or
 * surface the honest "no lossless common type" stop when none exists. Shared by
 * `type_arith_binop` and `type_bitwise_binop` (both integer-eligible operator classes) so
 * `+ - * / % & | ^` complete the B.22 sign-check's arithmetic sibling identically.
 *
 * @param op  the binary operator token, carried through to the built `TBinary`
 * @param l   the typed left operand (an integer `Prim`)
 * @param r   the typed right operand (an integer `Prim`)
 * @return    the typed binary expression at the W-RULE-joined width
 * @throws    when `l.type` and `r.type` share no lossless common integer type (W-RULE §2.2 —
 *            equal-width mixed sign, or the unsigned side equal-or-wider than the signed side)
 */
fn widen_int_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    var joined = match int_arith_join(prim_kind_of(l.type), prim_kind_of(r.type)) {
        PrimKind as k => k
        error as e => return err_binop_type_mismatch(e.message, l, r)
    }
    var lw = widen_operand(l, joined)
    var rw = widen_operand(r, joined)
    TExpr { kind = TBinary { op = op; left = lw; right = rw }; type = Prim { kind = joined }; line = 0; col = 0 }
}

/**
 * type_arith_binop — type an arithmetic operator (`+ - * /`) over the native numeric set (ints AND
 * floats). Same-type operands take the fast identity path; different-width same-family operands
 * (both integer, or both float) WIDEN under the W-RULE (`widen_int_binop` / `float_arith_join`,
 * completing B.22 into arithmetic — `cast-width-hygiene-0.3.1.md` §2); a mixed-sign integer pair
 * with no lossless common type, or a cross-family (int×float) pair, is an honest compile error
 * demanding an explicit `to` (B.38 — int×float stays unchanged).
 *
 * @param op  the arithmetic operator token
 * @param l   the typed left operand
 * @param r   the typed right operand
 * @return    the typed arithmetic expression, or a type error
 * @throws    when the left operand is not numeric, the operands are int×float, or a mixed-sign
 *            integer pair has no lossless common type (W-RULE §2.2)
 */
fn type_arith_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_numeric(l.type) { return error { message = "arithmetic needs a numeric operand (int or float)" } }
    if type_eq(l.type, r.type) { return TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 } }
    if is_integer(l.type) && is_integer(r.type) { return widen_int_binop(op, l, r) }
    if is_float(l.type) && is_float(r.type) {
        var joined = float_arith_join(prim_kind_of(l.type), prim_kind_of(r.type))
        var lw = widen_operand(l, joined)
        var rw = widen_operand(r, joined)
        return TExpr { kind = TBinary { op = op; left = lw; right = rw }; type = Prim { kind = joined }; line = 0; col = 0 }
    }
    err_binop_type_mismatch("operands must be the same type (no promotion, no mixed int/float — B.22; use `to`)", l, r)
}

/**
 * type_bitwise_binop — type a bitwise/remainder operator (`% & | ^`): integer operands only (not a
 * float — B.38). Same-type operands take the fast identity path; different-width operands WIDEN
 * under the W-RULE (`widen_int_binop`, completing B.22 into arithmetic — `cast-width-hygiene-
 * 0.3.1.md` §2); a mixed-sign pair with no lossless common type is an honest compile error
 * demanding an explicit `to`.
 *
 * @param op  the bitwise/remainder operator token
 * @param l   the typed left operand
 * @param r   the typed right operand
 * @return    the typed expression, or a type error
 * @throws    when the left operand is not an integer, the right operand is not an integer, or a
 *            mixed-sign integer pair has no lossless common type (W-RULE §2.2)
 */
fn type_bitwise_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_integer(l.type) { return error { message = "bitwise/remainder needs an integer (not a float — B.38)" } }
    if type_eq(l.type, r.type) { return TExpr { kind = TBinary { op = op; left = l; right = r }; type = l.type; line = 0; col = 0 } }
    if !is_integer(r.type) { return err_binop_type_mismatch("operands must be the same type (no promotion — B.22)", l, r) }
    widen_int_binop(op, l, r)
}

/**
 * type_logical_binop — type a logical operator (`&& ||`): bool operands, bool result, short-circuit
 * (matches C + the interpreter).
 *
 * @param op  the logical operator token
 * @param l   the typed left operand
 * @param r   the typed right operand
 * @return    the typed bool expression, or a type error
 * @throws    when either operand is not a bool
 */
fn type_logical_binop(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    if !is_bool(l.type) || !is_bool(r.type) { return error { message = "logical `&&`/`||` need bool operands" } }
    TExpr { kind = TBinary { op = op; left = l; right = r }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * NoOperator — the tri-state marker `dispatch_binop_operator` returns when NEITHER operand's owner
 * declares a matching `operator` for the token (§9 ruling 8): the caller then falls back to the
 * primitive operator over the reduced base. Modeled on `NotListBuiltin`.
 *
 * @since §9
 */
type NoOperator = struct { }

/**
 * dunder_of_binop — the dunder method name a binary operator token dispatches to (§9 ruling 2), or
 * "" when the token is not an overloadable binary operator (`&&`/`||` are NOT — they stay bool-only).
 * Arithmetic: + __add, - __sub, * __mul, / __div, % __mod. Comparison: == __eq, != __ne, < __lt,
 * > __gt, <= __le, >= __ge. Bitwise: & __band, | __bor, ^ __bxor, << __shl, >> __shr. (Index `[]`
 * and unary `~` __bnot have their own sites — `type_index` / `type_unary`.)
 *
 * @param op  the binary operator token
 * @return    the dunder name, or "" if `op` is not an overloadable binary operator
 * @since §9
 */
fn dunder_of_binop(op: lexer::TokenKind): str {
    if op == lexer::TokenKind::Plus { return "__add" }
    if op == lexer::TokenKind::Minus { return "__sub" }
    if op == lexer::TokenKind::Star { return "__mul" }
    if op == lexer::TokenKind::Slash { return "__div" }
    if op == lexer::TokenKind::Percent { return "__mod" }
    if op == lexer::TokenKind::EqEq { return "__eq" }
    if op == lexer::TokenKind::Ne { return "__ne" }
    if op == lexer::TokenKind::Lt { return "__lt" }
    if op == lexer::TokenKind::Gt { return "__gt" }
    if op == lexer::TokenKind::Le { return "__le" }
    if op == lexer::TokenKind::Ge { return "__ge" }
    if op == lexer::TokenKind::Amp { return "__band" }
    if op == lexer::TokenKind::Pipe { return "__bor" }
    if op == lexer::TokenKind::Caret { return "__bxor" }
    if op == lexer::TokenKind::Shl { return "__shl" }
    if op == lexer::TokenKind::Shr { return "__shr" }
    ""
}

/**
 * value_type_body_methods — the readonly instance methods + operators declared in a value-type body
 * (§9), or the empty list for any other body kind. The single accessor the operator lookup and the
 * definition validator share.
 *
 * @param body  the type declaration's body
 * @return      the body's method/operator list, or empty for a non-value-type body
 * @since §9
 */
fn value_type_body_methods(body: parser::TypeBody): []parser::Function {
    match body {
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => teko::list::empty()
    }
}

/**
 * type_body_operators — the `operator` members declared DIRECTLY in any body kind (§6/§9.4): a
 * value-type (Newtype/Enum/Flags), a struct, a class, or an interface (whose operators are bodyless
 * contract members). The single accessor the operator dispatch (`owner_has_matching_operator`) and the
 * definition validator (`check_operator_invariants`) share across every carrier. Only members carrying
 * `is_operator` are returned; ordinary methods and fields are filtered out.
 *
 * @param body  the type declaration's body
 * @return      the body's operator members, or empty when the body declares none
 * @since §6 (9-ops)
 */
fn type_body_operators(body: parser::TypeBody): []parser::Function {
    match body {
        parser::NewtypeBody as nb => operator_members(nb.methods)
        parser::EnumBody as eb => operator_members(eb.methods)
        parser::FlagsBody as fb => operator_members(fb.methods)
        parser::StructBody as sb => operator_members(sb.methods)
        parser::ClassBody as cb => operator_members(cb.methods)
        parser::InterfaceBody as ib => operator_members(ib.methods)
        _ => teko::list::empty()
    }
}

/**
 * methods_declare_operator — does any member of `methods` carry `is_operator`? A scan that returns on
 * the first operator, allocating NOTHING — the hot-path predicate `value_op_owner` runs per operand.
 *
 * @param methods  the body's members
 * @return         true iff at least one member is an operator
 * @since §6 (9-ops)
 */
fn methods_declare_operator(methods: []parser::Function): bool {
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator { return true }
        i++
    }
    false
}

/**
 * body_declares_operator — does `body` declare at least one `operator` member (§6)? Allocation-free:
 * a plain struct/class returns false after a bare scan, never building a filtered list, so
 * `value_op_owner` stays zero-alloc on the checker's hottest path.
 *
 * @param body  the type declaration's body
 * @return      true iff the body declares one or more operators
 * @since §6 (9-ops)
 */
fn body_declares_operator(body: parser::TypeBody): bool {
    match body {
        parser::NewtypeBody as nb => methods_declare_operator(nb.methods)
        parser::EnumBody as eb => methods_declare_operator(eb.methods)
        parser::FlagsBody as fb => methods_declare_operator(fb.methods)
        parser::StructBody as sb => methods_declare_operator(sb.methods)
        parser::ClassBody as cb => methods_declare_operator(cb.methods)
        parser::InterfaceBody as ib => methods_declare_operator(ib.methods)
        _ => false
    }
}

/**
 * is_value_type_body — is `body` a prim/enum/flags-backed VALUE-TYPE body (§9 ruling 10)? Distinguishes
 * the value-type carriers (which own the ruling-10 invariants — no fields, a readonly transient `self`,
 * a definition-level counterpart obligation) from struct/class/interface carriers, whose operators are
 * validated for well-formedness only.
 *
 * @param body  the type declaration's body
 * @return      true iff the body is a Newtype/Enum/Flags value-type body
 * @since §6 (9-ops)
 */
fn is_value_type_body(body: parser::TypeBody): bool {
    match body {
        parser::NewtypeBody => true
        parser::EnumBody => true
        parser::FlagsBody => true
        _ => false
    }
}

/**
 * value_op_owner — the NAME that owns operator/method lookup for `t`, or "" when `t` does not own any
 * operator dispatch (ruling 7's trigger: the dunder lookup runs iff at least one operand is NOT a raw
 * primitive). A `Named` type whose decl is a `NewtypeBody`, `EnumBody`, or `FlagsBody` (a NAMED
 * value-type counts as non-primitive) always returns its canonical name; a `StructBody`/`ClassBody`
 * returns its name ONLY when it declares at least one `operator` member (§6, `body_declares_operator`)
 * so `a + b` over two PLAIN structs never enters the dunder lookup. Every `Prim`/`Byte`/`Str`/`Slice`/
 * a plain data struct returns "". Because the compiler's own corpus declares ZERO value-types and ZERO
 * operator-carrying structs, and two raw primitives both yield "", the operator branch is never entered
 * for any primitive pair — the historic primitive path is byte-identical (plan §8 fixpoint argument).
 *
 * @param t      the operand's resolved type
 * @param table  the folded type table
 * @return       the owning type's canonical name, or ""
 * @since §9 (§6 extends to operator-carrying struct/class)
 */
fn value_op_owner(t: Type, table: TypeTable): str {
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::NewtypeBody => n.name
                parser::EnumBody => n.name
                parser::FlagsBody => n.name
                parser::StructBody => if body_declares_operator(td.body) { n.name } else { "" }
                parser::ClassBody => if body_declares_operator(td.body) { n.name } else { "" }
                _ => ""
            }
            error => ""
        }
        _ => ""
    }
}

/**
 * operand_reduced_to_base — the ruling-8 FALLBACK reduction: when no operator matched, a nominal
 * prim-backed value-type operand is lowered to its backing type (a representation-identity `TCast`)
 * so the primitive operator applies over the base. Enum/flags and every non-value-type operand pass
 * through unchanged. Inert on the corpus (never a value-type there).
 *
 * @param e      the typed operand
 * @param table  the folded type table
 * @return       the operand cast to its backing type, or `e` unchanged
 * @since §9
 */
fn operand_reduced_to_base(e: TExpr, table: TypeTable): TExpr {
    match value_type_base(e.type, table) {
        Type as bty => TExpr { kind = TCast { expr = e }; type = bty; line = e.line; col = e.col }
        NotValueType => e
    }
}

/**
 * operator_operand_type — resolve one declared operator-operand type-expression to a `Type`,
 * mapping the `self` atom to the owning value-type (§9 ruling 1). Used to match a call's (l, r)
 * operand pair against a candidate operator's declared positions.
 *
 * @param te               the declared operand type-expression
 * @param owner_canonical  the canonical name of the owning value-type
 * @param table            the folded type table
 * @return                 the resolved operand type, or a resolution error
 * @since §9
 */
fn operator_operand_type(te: parser::TypeExpr, owner_canonical: str, table: TypeTable): Type | error {
    if return_type_is_self(te) { return Named { name = owner_canonical } }
    resolve_type(te, table, name_qualifier(owner_canonical))
}

/**
 * owner_has_matching_operator — does the value-type `owner_canonical` declare an `operator <dn>`
 * whose two declared operands ACCEPT the (l, r) pair BY POSITION (§9 rulings 1/6/8)? Position 0 must
 * accept `l`, position 1 `r`, under the ordinary assignability rule. This is the comp-time match that
 * decides ruling 8's ordered dispatch without committing to a call.
 *
 * @param owner_canonical  the candidate owner's canonical name
 * @param dn               the dunder name sought
 * @param l                the typed left operand
 * @param r                the typed right operand
 * @param table            the folded type table
 * @return                 true iff a declared operator accepts (l, r) by position
 * @since §9
 */
fn owner_has_matching_operator(owner_canonical: str, dn: str, l: TExpr, r: TExpr, table: TypeTable): bool {
    var methods = match type_table_find(table, owner_canonical, "") {
        parser::TypeDecl as td => type_body_operators(td.body)
        error => teko::list::empty()
    }
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator && methods[i].name == dn && methods[i].params.len == 2 {
            var p0 = match operator_operand_type(methods[i].params[0].type_ann, owner_canonical, table) { Type as t => t; error => Void { } }
            var p1 = match operator_operand_type(methods[i].params[1].type_ann, owner_canonical, table) { Type as t => t; error => Void { } }
            if operator_operand_accepts(l, p0, table) && operator_operand_accepts(r, p1, table) { return true }
        }
        i++
    }
    false
}

/**
 * operator_operand_accepts — does an operator operand `arg` fit the declared position type `param`
 * (§9 rulings 1/6)? Beyond ordinary assignability, a bare NUMERIC LITERAL adopts any numeric position
 * exactly as it would at a normal call site (`f(3)` into an `i32`), so `celsius + 3` matches an
 * `operator __add(self, i32)`. The final fit/overload choice is `type_call`'s at `build_operator_call`;
 * this only gates which side owns the dispatch (ruling 8).
 *
 * @param arg    the typed operand
 * @param param  the operator's declared position type
 * @param table  the folded type table
 * @return       true iff `arg` fits `param` at this position
 * @since §9
 */
fn operator_operand_accepts(arg: TExpr, param: Type, table: TypeTable): bool {
    if assignable_to(arg.type, param, table) { return true }
    match arg.kind {
        TNumber => is_numeric(param)
        _ => false
    }
}

/**
 * build_operator_call — lower a matched binary operator to the STATIC call `<owner>::<dn>(left,
 * right)` (§9 ruling 8), routing the ORIGINAL operand expressions through `type_call` so the operator
 * reuses the ordinary method mangling, namespace resolution, and argument coercion (no new symbol
 * scheme). The result type is the operator's declared return.
 *
 * @param owner_canonical  the owning value-type's canonical name
 * @param dn               the dunder name
 * @param left             the RAW left operand expression
 * @param right            the RAW right operand expression
 * @param env              the typing environment
 * @param table            the folded type table
 * @return                 the typed static-call expression, or a type error
 * @since §9
 */
fn build_operator_call(owner_canonical: str, dn: str, left: parser::Expr, right: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var callee = method_dispatch_callee(owner_canonical, dn)
    var args: []parser::Expr = teko::list::push(teko::list::push(teko::list::empty(), left), right)
    var names: []str = teko::list::push(teko::list::push(teko::list::empty(), ""), "")
    type_call(parser::Call { callee = callee; args = args; arg_names = names; owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() }, env, table)
}

/**
 * dispatch_binop_operator — resolve a binary operator to a user `operator` on one of its operands and
 * lower it to a static method call, per ruling 8's ordered dispatch: (1) the LEFT operand's owner
 * declares an `operator <dn>` accepting this (l, r) pair by position → call `Lowner::<dn>(l, r)`;
 * else (2) the RIGHT operand's owner declares a matching one → call it; else (3) `NoOperator` (the
 * caller reduces to the base and emits the primitive op). The explicit left/right order resolves
 * non-commutative and mixed-operand cases (rulings 1/6).
 *
 * @param dn     the dunder name (`dunder_of_binop`)
 * @param left   the RAW left operand expression
 * @param right  the RAW right operand expression
 * @param l      the typed left operand
 * @param r      the typed right operand
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the lowered static-call TExpr, `NoOperator` when neither side matches, or a type error
 * @since §9
 */
fn dispatch_binop_operator(dn: str, left: parser::Expr, right: parser::Expr, l: TExpr, r: TExpr, env: Env, table: TypeTable): TExpr | NoOperator | error {
    var lo = value_op_owner(l.type, table)
    if lo != "" && owner_has_matching_operator(lo, dn, l, r, table) {
        match build_operator_call(lo, dn, left, right, env, table) { TExpr as te => return te; error as e => return e }
    }
    var ro = value_op_owner(r.type, table)
    if ro != "" && owner_has_matching_operator(ro, dn, l, r, table) {
        match build_operator_call(ro, dn, left, right, env, table) { TExpr as te => return te; error as e => return e }
    }
    NoOperator { }
}

/**
 * ConstraintOp — the interface a generic operator dispatches through (§6): the interface (from a
 * type-parameter's constraint) that DECLARES the sought dunder, and the operator's resolved return
 * type (self → the type-parameter, else the contract's declared return).
 */
type ConstraintOp = struct {
    /** iface — the constraint interface that owns the operator (the D3 dispatch key). */
    iface: str
    /** ret — the operator's return type resolved in the type-parameter's context. */
    ret: Type
}

/**
 * NoConstraintOp — the sentinel `constraint_op_owner` returns when `t` is not a constrained
 * type-parameter whose constraint interface declares the sought operator.
 */
type NoConstraintOp = struct { }

/**
 * operand_is_type_param — is `t` a generic TYPE-PARAMETER (a `resolve::type_param_table` synthetic
 * decl), rather than a concrete named type? Gates the generic operator dispatch: `a op b` over a
 * type-parameter routes through the constraint contract, never the primitive operator classes.
 *
 * @param t      the operand's resolved type
 * @param table  the folded type table (carries the enclosing generic's type-params)
 * @return       true iff `t` names an in-scope type-parameter
 * @since §6 (9-ops)
 */
fn operand_is_type_param(t: Type, table: TypeTable): bool {
    var name = match t { Named as n => n.name; _ => return false }
    match type_table_find(table, name, "") {
        parser::TypeDecl as td => is_type_param_decl(td)
        error => false
    }
}

/**
 * constraint_op_owner — the (interface, return type) a binary operator on a CONSTRAINED type-parameter
 * dispatches through (§6/§9.4 generic operator dispatch), or `NoConstraintOp` when `t` is not a
 * type-parameter whose constraint interface declares `dn`. The generic mirror of `value_op_owner`:
 * when `a: T` and `T: IEq`, `a == b` resolves `__eq` against IEq's contract and lowers to the ordinary
 * constraint-method dispatch (`type_contract_dispatch`) that `monomorph` concretizes to the argument
 * type's own operator (`rekey_struct_constraint_dispatch` for a struct receiver; the class vtable
 * otherwise). Reuses #254's shipped generic-method-on-`T` machinery — no new lowering surface.
 *
 * @param t      the operand's resolved type (possibly a constrained type-parameter)
 * @param dn     the dunder sought (`dunder_of_binop`)
 * @param table  the folded type table
 * @return       the (interface, return type) to dispatch, or `NoConstraintOp`
 * @since §6 (9-ops)
 */
fn constraint_op_owner(t: Type, dn: str, table: TypeTable): ConstraintOp | NoConstraintOp {
    var name = match t { Named as n => n.name; _ => return NoConstraintOp { } }
    var decl = match type_table_find(table, name, "") { parser::TypeDecl as td => td; error => return NoConstraintOp { } }
    if !is_type_param_decl(decl) { return NoConstraintOp { } }
    var extends = match decl.body { parser::InterfaceBody as ib => ib.extends; _ => return NoConstraintOp { } }
    var owner = match method_owner_interface(extends, dn, table) { str as o => o; null => return NoConstraintOp { } }
    var ops = match iface_methods_by_name(owner, table) { []parser::Function as f => f; error => return NoConstraintOp { } }
    var k = 0
    loop {
        if k >= ops.len { break }
        if ops[k].is_operator && ops[k].name == dn {
            var rt = match operator_operand_type(ops[k].return_type, name, table) { Type as ty => ty; error => Prim { kind = PrimKind::Bool } }
            return ConstraintOp { iface = owner; ret = rt }
        }
        k++
    }
    NoConstraintOp { }
}

/**
 * build_constraint_operator_call — lower a matched generic binary operator to the STATIC contract
 * dispatch `<T's constraint iface>::<dn>(left, right)` (§6), by synthesizing the equivalent
 * `left.<dn>(right)` method-call and routing it through `type_method_call`/`type_contract_dispatch` —
 * the SAME constraint-method lowering `x.method()` on a type-parameter already uses (#254). The
 * receiver `left` becomes the operator's first operand; `monomorph` concretizes the call to the bound
 * argument type's own operator.
 *
 * @param dn     the dunder name
 * @param left   the RAW left operand expression
 * @param right  the RAW right operand expression
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed contract-dispatch expression, or a type error
 * @since §6 (9-ops)
 */
fn build_constraint_operator_call(dn: str, left: parser::Expr, right: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var mc = parser::MethodCall { receiver = left; method = dn; args = teko::list::push(teko::list::empty(), right); arg_names = teko::list::push(teko::list::empty(), ""); type_args = teko::list::empty() }
    type_method_call(mc, env, table)
}

/**
 * dispatch_constraint_binop — dispatch a binary operator whose operand is a constrained type-parameter
 * to its constraint contract (§6), ruling-8 ordered: the LEFT operand's constraint first, then the
 * RIGHT's. When neither operand's constraint interface declares the operator, the operator is NOT
 * guaranteed by the constraint — a located error naming the operator and the type-parameter, so a
 * generic that uses `==` on an unconstrained `T` is rejected at the typing site (never silently
 * lowered).
 *
 * @param dn     the dunder name (`dunder_of_binop`)
 * @param left   the RAW left operand expression
 * @param right  the RAW right operand expression
 * @param l      the typed left operand
 * @param r      the typed right operand
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the lowered contract-dispatch expression, or the "not guaranteed" error
 * @throws       when neither operand's constraint declares `operator <dn>`
 * @since §6 (9-ops)
 */
fn dispatch_constraint_binop(dn: str, left: parser::Expr, right: parser::Expr, l: TExpr, r: TExpr, env: Env, table: TypeTable): TExpr | error {
    match constraint_op_owner(l.type, dn, table) {
        ConstraintOp => return build_constraint_operator_call(dn, left, right, env, table)
        NoConstraintOp => { }
    }
    match constraint_op_owner(r.type, dn, table) {
        ConstraintOp => return build_constraint_operator_call(dn, left, right, env, table)
        NoConstraintOp => { }
    }
    var tp = if operand_is_type_param(l.type, table) { type_render(l.type) } else { type_render(r.type) }
    error { message = $"`operator {dn}` is not guaranteed by the constraint on type parameter `{tp}` — constrain it with an interface that declares `operator {dn}` (e.g. `IEq`/`IOrd`) (§6)" }
}

/**
 * owner_has_unary_operator — does the value-type `owner_canonical` declare a UNARY `operator <dn>`
 * (one operand) accepting `o` (§9 ruling 2 — `~` → `__bnot`)? The single-operand analogue of
 * `owner_has_matching_operator`.
 *
 * @param owner_canonical  the candidate owner's canonical name
 * @param dn               the unary dunder name sought
 * @param o                the typed operand
 * @param table            the folded type table
 * @return                 true iff a declared one-operand operator accepts `o`
 * @since §9
 */
fn owner_has_unary_operator(owner_canonical: str, dn: str, o: TExpr, table: TypeTable): bool {
    var methods = match type_table_find(table, owner_canonical, "") {
        parser::TypeDecl as td => type_body_operators(td.body)
        error => teko::list::empty()
    }
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator && methods[i].name == dn && methods[i].params.len == 1 {
            var p0 = match operator_operand_type(methods[i].params[0].type_ann, owner_canonical, table) { Type as t => t; error => Void { } }
            if assignable_to(o.type, p0, table) { return true }
        }
        i++
    }
    false
}

/**
 * build_unary_operator_call — lower a matched unary operator to the static call `<owner>::<dn>(x)`
 * (§9 ruling 2), routing the ORIGINAL operand through `type_call` for the ordinary method mangling.
 *
 * @param owner_canonical  the owning value-type's canonical name
 * @param dn               the unary dunder name
 * @param operand          the RAW operand expression
 * @param env              the typing environment
 * @param table            the folded type table
 * @return                 the typed static-call expression, or a type error
 * @since §9
 */
fn build_unary_operator_call(owner_canonical: str, dn: str, operand: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var callee = method_dispatch_callee(owner_canonical, dn)
    var args: []parser::Expr = teko::list::push(teko::list::empty(), operand)
    var names: []str = teko::list::push(teko::list::empty(), "")
    type_call(parser::Call { callee = callee; args = args; arg_names = names; owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() }, env, table)
}

/**
 * type_binary — type a binary expression. Dispatches, in order: the `~` concat chain; the `bigint`/
 * `dec` operator sugar (lowered to library calls); the §9 value-type operator lookup; then the native
 * operator classes — shift, arith (`+ - * /`), bitwise/remainder (`% & | ^`), and logical (`&& ||`).
 * Operands are normalized so a fitting untyped numeric literal adopts its partner's type first (C6).
 *
 * @param b      the binary expression node
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed binary (or lowered bignum/operator call) expression, or a type error
 * @throws       on a void operand, an incompatible operand type, or a non-binary operator
 * @see          warn_redundant_cast — the D1 class-3 WARNING this emits in passing (never a failure)
 */
fn type_binary(b: parser::Binary, env: Env, table: TypeTable): TExpr | error {
    if b.op == lexer::TokenKind::Tilde { return type_tilde_chain(b, env, table) }
    var l0 = deref_ref_value(match type_expr(b.left, env, table) { TExpr as te => te; error as e => return e })
    var r0 = deref_ref_value(match type_expr(b.right, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(l0.type) || type_is_void(r0.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
    if is_ptr_or_uptr(l0.type) || is_ptr_or_uptr(r0.type) { return ptr_opaque_error() }
    var lk = bignum_kind(l0.type)
    var rk = bignum_kind(r0.type)
    if lk != "" || rk != "" { return type_bignum_binop(b.op, l0, r0, lk, rk) }
    var op_dn = dunder_of_binop(b.op)
    if op_dn != "" && (value_op_owner(l0.type, table) != "" || value_op_owner(r0.type, table) != "") {
        match dispatch_binop_operator(op_dn, b.left, b.right, l0, r0, env, table) {
            TExpr as te => return te
            NoOperator => {
                l0 = operand_reduced_to_base(l0, table)
                r0 = operand_reduced_to_base(r0, table)
            }
            error as e => return e
        }
    } else if op_dn != "" && (operand_is_type_param(l0.type, table) || operand_is_type_param(r0.type, table)) {
        return dispatch_constraint_binop(op_dn, b.left, b.right, l0, r0, env, table)
    }
    var ops = adopt_binop_operands(l0, r0)
    var l = ops.l
    var r = ops.r
    if op_is_arith(b.op) || op_is_arith_bitwise(b.op) {
        match redundant_widen_cast_of(l, r) { TExpr as bad => warn_redundant_cast(env, bad); null => { } }
    }
    if op_is_shift(b.op) { return type_shift_binop(b.op, l, r) }
    if op_is_arith(b.op) { return type_arith_binop(b.op, l, r) }
    if op_is_arith_bitwise(b.op) { return type_bitwise_binop(b.op, l, r) }
    if b.op == lexer::TokenKind::AndAnd || b.op == lexer::TokenKind::OrOr { return type_logical_binop(b.op, l, r) }
    error { message = "not a binary operator" }
}

fn type_unary(u: parser::Unary, env: Env, table: TypeTable): TExpr | error {
    var o = deref_ref_value(match type_expr(u.operand, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(o.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
    if is_ptr_or_uptr(o.type) { return ptr_opaque_error() }
    var uk = bignum_kind(o.type)
    if uk != "" {
        if u.op == lexer::TokenKind::Minus { return bignum_call(uk, "neg", teko::list::push(teko::list::empty(), o), bignum_named(uk)) }
        return error { message = $"unary `!`/`~` is not defined on `{uk}`" }
    }
    if u.op == lexer::TokenKind::Minus {   // negation: any numeric (int or float — B.38)
        if !is_numeric(o.type) { return error { message = "unary `-` needs a numeric operand (int or float)" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    if u.op == lexer::TokenKind::Tilde {   // bitwise complement: integer-only (no float bit-flip — B.38)
        var owner = value_op_owner(o.type, table)
        if owner != "" && owner_has_unary_operator(owner, "__bnot", o, table) {
            return build_unary_operator_call(owner, "__bnot", u.operand, env, table)
        }
        if !is_integer(o.type) { return error { message = "unary `~` needs an integer (not a float — B.38)" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    if u.op == lexer::TokenKind::Bang {
        if !is_bool(o.type) { return error { message = "! needs a bool" } }
        return TExpr { kind = TUnary { op = u.op; operand = o }; type = o.type; line = 0; col = 0 }
    }
    error { message = "not a unary operator" }
}

/**
 * type_compare — type a comparison chain (`a < b <= c`), operand by operand. Each step adopts a
 * bare numeric literal to its partner's type through the very function the binary ops use
 * (`adopt_binop_operands`, so `c < 0x20` compares a `byte` against a `u8`-adopted literal), applies
 * the SHARED D1 class-3 WARNING
 * (`redundant_widen_cast_of` — the same guarded decision `type_binary` uses, so an arithmetic and a
 * comparison spelling of the same operand pair always agree), and checks comparability.
 *
 * @param c      the comparison chain node
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed comparison (always `bool`), or a type error
 * @throws       on a `void` operand or an incomparable operand pair — NOT on a redundant widen
 *               cast, which only warns (owner ruling 2026-07-27, `warn_redundant_cast`)
 */
/**
 * compare_has_value_type — does any operand of the comparison chain resolve to a NAMED value-type
 * (§9)? A cheap pre-scan (each `type_expr` is pure); an operand whose typing errors is treated as
 * NOT a value-type, so the main path still reports the real error. Returns false for every
 * primitive-only chain — the historic `TCompare` path stays byte-identical (plan §8).
 *
 * @param c      the comparison chain
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       true iff at least one operand is a value-type
 * @since §9
 */
fn compare_has_value_type(c: parser::Compare, env: Env, table: TypeTable): bool {
    if operand_is_value_type(c.first, env, table) { return true }
    var i = 0
    loop {
        if i >= c.rest.len { break }
        if operand_is_value_type(c.rest[i].operand, env, table) { return true }
        i++
    }
    false
}

/**
 * operand_is_value_type — does the expression `e` type to a NAMED value-type OR a generic
 * type-parameter (§9/§6)? A value-type owns operator dispatch by declaration; a type-parameter routes
 * its comparison through the constraint contract (`compare_value_term` resolves the exact operator or
 * reports "not guaranteed"). A typing error is reported as NEITHER (the caller's main path re-types and
 * surfaces the real error), so a primitive-only chain stays on the historic `TCompare` path.
 *
 * @param e      the operand expression
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       true iff `e` types to a value-type or a type-parameter
 * @since §9 (§6 extends to constrained type-parameters)
 */
fn operand_is_value_type(e: parser::Expr, env: Env, table: TypeTable): bool {
    match type_expr(e, env, table) {
        TExpr as te => value_op_owner(te.type, table) != "" || operand_is_type_param(te.type, table)
        error => false
    }
}

/**
 * single_primitive_compare — the boolean of ONE primitive comparison term (`l op r`): adopt a bare
 * literal operand, check comparability, and build a two-term `TCompare` typed `bool`. The §9
 * value-type comparison fold uses it for a term whose operands are (reduced to) primitives.
 *
 * @param op  the comparison operator token
 * @param l   the typed left operand
 * @param r   the typed right operand
 * @return    the boolean `TCompare`, or an incomparable-operands error
 * @since §9
 */
fn single_primitive_compare(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr | error {
    var adopted = adopt_binop_operands(l, r)
    if !is_comparable(adopted.l.type, adopted.r.type) { return error { message = "operands are not comparable" } }
    var term = TCmpTerm { op = op; operand = adopted.r }
    TExpr { kind = TCompare { first = adopted.l; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * compare_value_term — the boolean of ONE comparison term when at least one operand is a value-type or
 * a type-parameter (§9 rulings 3/8, §6): dispatch the comparison dunder to a user `operator` (which
 * must return `bool`) on a value-type owner; else, when an operand is a constrained type-parameter,
 * dispatch through its constraint contract (`dispatch_constraint_binop`, which reports "not guaranteed"
 * when the constraint lacks the operator); else reduce each value-type operand to its base and compare
 * primitively. Returns a `bool`-typed expression either way, so the chain composes with `&&`.
 *
 * @param op    the comparison operator token
 * @param le    the RAW left operand expression
 * @param l     the typed left operand
 * @param re    the RAW right operand expression
 * @param r     the typed right operand
 * @param env   the typing environment
 * @param table the folded type table
 * @return      the boolean term expression, or a type error
 * @throws      when a matched comparison operator does not return `bool` (ruling 3), the constraint does
 *              not guarantee the operator (§6), or the fallback primitive compare is incomparable
 * @since §9 (§6 extends to constrained type-parameters)
 */
fn compare_value_term(op: lexer::TokenKind, le: parser::Expr, l: TExpr, re: parser::Expr, r: TExpr, env: Env, table: TypeTable): TExpr | error {
    var dn = dunder_of_binop(op)
    match dispatch_binop_operator(dn, le, re, l, r, env, table) {
        TExpr as te => {
            if !is_bool(te.type) { return error { message = $"a comparison `operator {dn}` must return `bool` (§9 ruling 3)" } }
            return te
        }
        NoOperator => { }
        error as e => return e
    }
    if operand_is_type_param(l.type, table) || operand_is_type_param(r.type, table) {
        var te = match dispatch_constraint_binop(dn, le, re, l, r, env, table) { TExpr as t => t; error as e => return e }
        if !is_bool(te.type) { return error { message = $"a comparison `operator {dn}` must return `bool` (§9 ruling 3)" } }
        return te
    }
    single_primitive_compare(op, operand_reduced_to_base(l, table), operand_reduced_to_base(r, table))
}

/**
 * type_compare_value_chain — type a comparison chain in which at least one operand is a value-type
 * (§9 ruling 3/§3.4), as an `&&`-fold of per-term booleans (`a < b < c` → `(a<b) && (b<c)`),
 * reusing `type_logical_binop`'s semantics. Each term is a user comparison operator (returning
 * `bool`) or a reduced-to-base primitive comparison.
 *
 * @param c      the comparison chain (rest length ≥ 1)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the folded boolean expression, or a type error
 * @since §9
 */
fn type_compare_value_chain(c: parser::Compare, env: Env, table: TypeTable): TExpr | error {
    var prev_expr = c.first
    var prev = deref_ref_value(match type_expr(c.first, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(prev.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
    var acc = prev
    var has_acc = false
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var cur_expr = c.rest[i].operand
        var cur = deref_ref_value(match type_expr(cur_expr, env, table) { TExpr as te => te; error as e => return e })
        if type_is_void(cur.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
        var term = match compare_value_term(c.rest[i].op, prev_expr, prev, cur_expr, cur, env, table) { TExpr as t => t; error as e => return e }
        acc = if !has_acc { term } else { TExpr { kind = TBinary { op = lexer::TokenKind::AndAnd; left = acc; right = term }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 } }
        has_acc = true
        prev_expr = cur_expr
        prev = cur
        i++
    }
    acc
}

fn type_compare(c: parser::Compare, env: Env, table: TypeTable): TExpr | error {
    var first = deref_ref_value(match type_expr(c.first, env, table) { TExpr as te => te; error as e => return e })
    if type_is_void(first.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
    var fk = bignum_kind(first.type)
    if fk != "" { return type_bignum_compare(first, c.rest, env, table, fk) }
    if compare_has_value_type(c, env, table) { return type_compare_value_chain(c, env, table) }
    var prev = first
    var terms: []TCmpTerm = teko::list::empty()
    var i = 0
    loop {
        if i >= c.rest.len { break }
        var raw = deref_ref_value(match type_expr(c.rest[i].operand, env, table) { TExpr as te => te; error as e => return e })
        if type_is_void(raw.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
        var adopted = adopt_binop_operands(prev, raw)
        if i == 0 { first = adopted.l }
        match redundant_widen_cast_of(adopted.l, adopted.r) { TExpr as bad => warn_redundant_cast(env, bad); null => { } }
        if !is_comparable(adopted.l.type, adopted.r.type) { return error { message = "operands are not comparable" } }
        var is_variant_member_pair = variant_has_member(adopted.l.type, adopted.r.type) || variant_has_member(adopted.r.type, adopted.l.type)
        if is_variant_member_pair && !op_is_eq_ne(c.rest[i].op) {
            return error { message = "a union compares to one of its own members only with `==`/`!=` (ordering needs an explicit `to`)" }
        }
        terms = teko::list::push(terms, TCmpTerm { op = c.rest[i].op; operand = adopted.r })
        prev = adopted.r
        i++
    }
    TExpr { kind = TCompare { first = first; rest = terms }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * Marker: the call is not a `teko::list::*` builtin — `type_list_builtin` falls back so its
 * caller resolves the call through the ordinary path.
 */
type NotListBuiltin = struct { }

/**
 * The GENERIC `teko::list::*` builtins that have no `.tks` module of their own (like
 * print/assert): `empty()`, `push(s, x)`, and `with_cap(n)`. Recognized by the LAST-2 path
 * segments (`list::empty` / `list::push` / `list::with_cap`), rooted at `teko` (or bare
 * `list::*`). The element type is INFERRED (B.8/Slice):
 *   - `empty()` -> `[]<sentinel>` (a `Slice` whose element is the `Void` marker, unifying with
 *     any concrete slice);
 *   - `push(s, x)` -> `[]typeof(x)`; `s` must be a slice (sentinel or a matching element);
 *   - `with_cap(n)` -> `[]<sentinel>`, exactly like `empty()`, but the runtime buffer is
 *     pre-sized for `n` elements (an enabling primitive — staged off; no compiler source calls
 *     it yet).
 * The C twin instead uses a `bool handled` out-param; Teko has no out-params, so the tri-state
 * result here is a 3-member variant (`T? | error` is illegal — a variant member may not be
 * nullable).
 *
 * @param c      the raw call node
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed `TExpr` for a recognized `list::*` builtin, `NotListBuiltin` when the
 *               call is not one of these (the caller falls back to ordinary resolution), or
 *               `error` on a malformed call (wrong arity, a non-slice base, or a mismatched item)
 */
fn type_list_builtin(c: parser::Call, env: Env, table: TypeTable): TExpr | NotListBuiltin | error {
    if c.callee.segments.len < 2 { return NotListBuiltin { } }
    var last = c.callee.segments[c.callee.segments.len - 1].name
    var prev = c.callee.segments[c.callee.segments.len - 2].name
    // (#148 R3) teko::mem::push_fo — push with FREE-OLD BY DECREE. Same typing/semantics as
    // teko::list::push; the CALLER asserts the base is a linear chain (the old buffer is dead
    // after the grow), so native codegen frees it (tk_slice_push_fo). TEKO_MEM_PARANOID is the
    // fiscal: a wrong decree poisons instead of parking and the gate fails loudly. (Mirror expr.c.)
    var is_pushfo = prev == "mem" && last == "push_fo"
    if prev != "list" && !is_pushfo { return NotListBuiltin { } }
    var rooted = c.callee.segments.len == 2 || c.callee.segments[0].name == "teko"
    if !rooted { return NotListBuiltin { } }

    if last == "empty" {
        if c.args.len != 0 { return error { message = "teko::list::empty expects no arguments" } }
        // SENTINEL slice: element is the Void marker (unifies with any concrete slice — type_eq).
        TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = teko::list::empty(); call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Slice { element = Void { } }; line = 0; col = 0 }
    } else if last == "push" || is_pushfo {
        if c.args.len != 2 { return error { message = "teko::list::push expects two arguments (slice, item)" } }
        var s = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
        var x = match type_expr(c.args[1], env, table) { TExpr as te => te; error as e => return e }
        var elem = match s.type { Slice as sl => sl.element; _ => return error { message = "teko::list::push first argument must be a slice (`[]T`)" } }
        if type_is_void(x.type) { return error { message = "teko::list::push item cannot be a `void` expression (M.1)" } }
        // A SENTINEL base (Void element) is fixed BY the item — the result element is the item's type.
        // A CONCRETE element is preserved; the item must WIDEN into it (a case into a variant element —
        // so a `[]Type` accepts heterogeneous cases: str, u64, …) OR adopt it (literal). (Mirror expr.c.)
        var result_elem = match elem {
            Void => x.type
            _ => {
                if !widens_into(x.type, elem, table) && !literal_adopts(x, elem) { return error { message = "teko::list::push item type does not match the slice element type" } }
                elem
            }
        }
        // (#57) CONCRETIZE a SENTINEL base (bare empty()) to []elem so codegen can EMIT it; the interpreter
        // ignores a slice's element type but codegen's emit_list_empty REQUIRES it. (Mirror expr.c.)
        var arr_expr = match elem { Void => TExpr { kind = s.kind; type = Slice { element = result_elem }; line = s.line; col = s.col }; _ => s }
        var args = teko::list::push(teko::list::push(teko::list::empty(), arr_expr), x)
        TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = args; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Slice { element = result_elem }; line = 0; col = 0 }
    } else if last == "with_cap" {
        if c.args.len != 1 { return error { message = "teko::list::with_cap expects one argument (the initial capacity, a `u64`)" } }
        var n = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
        var cap_t = Prim { kind = PrimKind::U64 }
        var n_typed = n
        if !type_eq(n.type, cap_t) {
            if !literal_adopts(n, cap_t) { return error { message = $"teko::list::with_cap's argument must be a `u64` — got `{type_render(n.type)}`" } }
            n_typed = TExpr { kind = n.kind; type = cap_t; line = n.line; col = n.col }
        }
        var wargs = teko::list::push(teko::list::empty(), n_typed)
        TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = wargs; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Slice { element = Void { } }; line = 0; col = 0 }
    } else if last == "grow_inplace" {
        if c.args.len != 2 { return error { message = "teko::list::grow_inplace expects two arguments (a `ref []T`, item)" } }
        var r = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
        var x = match type_expr(c.args[1], env, table) { TExpr as te => te; error as e => return e }
        var elem = match r.type {
            Reference as rf => match rf.inner { Slice as sl => sl.element; _ => return error { message = "teko::list::grow_inplace first argument must reference a slice (`ref []T`)" } }
            _ => return error { message = "teko::list::grow_inplace first argument must be an exclusive `ref []T`" }
        }
        match elem {
            Byte => return error { message = "teko::list::grow_inplace on `[]byte` is not yet supported: `tk_slice_byte` is the 2-word runtime VIEW rep (no `cap` slot); the uniform 3-word rep for the view types is the #112 native-rep remainder" }
            Char => return error { message = "teko::list::grow_inplace on `[]char` is not yet supported: `tk_slice_char` is the 2-word runtime VIEW rep (no `cap` slot); the uniform 3-word rep for the view types is the #112 native-rep remainder" }
            _ => { }
        }
        if type_is_void(x.type) { return error { message = "teko::list::grow_inplace item cannot be a `void` expression (M.1)" } }
        var item = match elem {
            Void => x
            _ => {
                if !widens_into(x.type, elem, table) && !literal_adopts(x, elem) { return error { message = "teko::list::grow_inplace item type does not match the slice element type" } }
                TExpr { kind = x.kind; type = elem; line = x.line; col = x.col }
            }
        }
        var gargs = teko::list::push(teko::list::push(teko::list::empty(), r), item)
        TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = gargs; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Void { }; line = 0; col = 0 }
    } else {
        NotListBuiltin { }
    }
}


/**
 * The negative sentinel for `type_ptr_unwrap`/`type_ptr_wrap` — the call/method is not one of the
 * opaque-pointer intrinsics, so the caller falls through to ordinary resolution.
 */
type NotPtrOp = struct { }

/**
 * ptr_opaque_error — the shared diagnostic for every operation the opaque atomic `ptr`/`uptr`
 * forbids (arithmetic `p + n`/`p - n`, subscript `p[n]`, deref/borrow `*p`/`&p`). A `ptr` is a
 * single machine word carrying only an address, never a base for pointer walking; the only way to
 * recover a value behind it is `p.__wrap<T>()`.
 *
 * @return  the fixed opaque-pointer rejection error
 * @since 0.3.1
 */
fn ptr_opaque_error(): error {
    error { message = "an opaque `ptr`/`uptr` cannot be an operand" }
}

/**
 * is_ptr_or_uptr — is `t` one of the two opaque atomic pointer words (`ptr` or `uptr`)? The single
 * classifier the arithmetic/deref/borrow rejection guards consult so every site agrees on what a
 * bare opaque pointer is.
 *
 * @param t  the resolved operand type
 * @return   true iff `t` is a `Ptr` or a `Uptr`
 * @since 0.3.1
 */
fn is_ptr_or_uptr(t: Type): bool {
    match t { Ptr => true; Uptr => true; _ => false }
}

/**
 * type_ptr_unwrap — recognize and type the STATIC intrinsic `ptr::__unwrap<T>(x)` /
 * `uptr::__unwrap<T>(x)` (§5 Part A): the infallible reinterpret that takes the ADDRESS of an
 * addressable `var` variable (R7 ordinary auto-ref of a `var`) and hands it back as the opaque word
 * `ptr` (or `uptr`). Devolve o PONTEIRO, não o valor — nada a checar. The argument's static type
 * must equal the explicit `T`; the value flowing to codegen carries `T` as the sole type-arg so the
 * seam can materialize its tag (Part B). Returns `NotPtrOp` when the callee is not an `__unwrap`
 * intrinsic path, so `type_call` falls through to ordinary resolution.
 *
 * @param c      the raw static-call node (`ptr::__unwrap<T>(x)`)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       a `ptr`/`uptr`-typed `TCall`, `NotPtrOp` when the path is not `__unwrap`, or an error
 * @throws       on wrong type-arg/argument arity, a non-addressable argument, or an argument whose
 *               type is not `T`
 * @since 0.3.1
 */
fn type_ptr_unwrap(c: parser::Call, env: Env, table: TypeTable): TExpr | NotPtrOp | error {
    if c.callee.segments.len != 2 { return NotPtrOp { } }
    var owner = c.callee.segments[0].name
    var last = c.callee.segments[1].name
    if last != "__unwrap" { return NotPtrOp { } }
    if owner != "ptr" && owner != "uptr" { return NotPtrOp { } }
    if c.callee_type_args.len != 1 { return error { message = $"`{owner}::__unwrap<T>` takes exactly one type argument" } }
    if c.args.len != 1 { return error { message = $"`{owner}::__unwrap<T>` expects one argument (an addressable `var` variable)" } }
    var rt = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { Type as t => t; error as e => return e }
    var a = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    var is_mut_lvalue = match a.kind {
        TVar as v => match lookup_binding(env, v.name) { ValBinding as vb => vb.is_mut; error => false }
        _ => false
    }
    if !is_mut_lvalue { return error { message = $"`{owner}::__unwrap<T>` requires an addressable `var` variable (a `ref T`) — its address is what the opaque word wraps" } }
    if !type_eq(a.type, rt) { return error { message = $"`{owner}::__unwrap<{type_render(rt)}>` argument must be a `{type_render(rt)}` (got `{type_render(a.type)}`)" } }
    var uargs = teko::list::push(teko::list::empty(), a)
    var xtypes = teko::list::push(teko::list::empty(), rt)
    var restype: Type = Ptr { inner = null }
    if owner == "uptr" { restype = Uptr { } }
    TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = uargs; call_ns = "teko::__ptr_unwrap"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = teko::list::empty() }; type = restype; line = 0; col = 0 }
}

/**
 * type_ptr_wrap — type the INSTANCE intrinsic `p.__wrap<T>()` on a `ptr`/`uptr` receiver (§5 Part
 * A): the fallible recovery of the value behind the opaque word. The result type is the FINAL union
 * `T | error | null` (null-first normalized, exactly as a written `T | error | null` resolves): the
 * `null` arm (address 0) is LIVE now; the `error` arm (dead arena / divergent tag) is emitted but
 * DEAD in Part A (the codegen guard is a constant `1`) until the Part B backend seam lights it up.
 * The receiver rides `args[0]`; `T` rides the sole type-arg for the seam. Returns `NotPtrOp` when the
 * method is not `__wrap` so the caller can surface an ordinary no-such-method diagnostic.
 *
 * @param mc      the method-call node (`p.__wrap<T>()`)
 * @param recv_t  the already-typed receiver type (a `Ptr` or `Uptr`)
 * @param env     the typing environment
 * @param table   the folded type table
 * @return        a `T | error | null`-typed `TCall`, `NotPtrOp` when the method is not `__wrap`, or an error
 * @throws        on wrong type-arg/argument arity, or a `void`/reference/absence-union `T`
 * @since 0.3.1
 */
fn type_ptr_wrap(mc: parser::MethodCall, recv_t: Type, env: Env, table: TypeTable): TExpr | NotPtrOp | error {
    if mc.method != "__wrap" { return NotPtrOp { } }
    if !is_ptr_or_uptr(recv_t) { return NotPtrOp { } }
    if mc.type_args.len != 1 { return error { message = "`__wrap<T>` takes exactly one type argument" } }
    if mc.args.len != 0 { return error { message = "`__wrap<T>` takes no value arguments (its receiver is the opaque word)" } }
    var rt = match resolve_type(mc.type_args[0], table, env.cur_ns) { Type as t => t; error as e => return e }
    match rt {
        Void => return error { message = "`__wrap<void>` is invalid — void is not a value (M.3)" }
        Reference => return error { message = "`__wrap<T>` cannot recover a reference (a raw address is not a safe ref target, R4)" }
        Variant as v => if variant_has_null_member(Variant { members = v.members }) { return error { message = "`__wrap<T>` cannot recover an absence union `T | null` — the null arm would collide with `__wrap`'s own `null` (address 0)" } }
        _ => { }
    }
    var recv = match type_expr(mc.receiver, env, table) { TExpr as te => te; error as e => return e }
    var members = teko::list::push(teko::list::empty(), rt)
    members = teko::list::push(members, Error { })
    members = teko::list::push(members, Null { })
    var wargs = teko::list::push(teko::list::empty(), recv)
    var xtypes = teko::list::push(teko::list::empty(), rt)
    var wseg = teko::list::push(teko::list::empty(), parser::Segment { name = "__wrap" })
    TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = wseg }; args = wargs; call_ns = "teko::__ptr_wrap"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = teko::list::empty() }; type = Variant { members = union_normalize_null(members) }; line = 0; col = 0 }
}

/**
 * The negative sentinel for `type_svc`/`type_has_svc` — the call is not a `svc`/`has_svc` intrinsic,
 * so `type_call` falls through to ordinary resolution.
 */
type NotSvcOp = struct { }

/**
 * (§7 DI, escape rule) Is `e` a DIRECT `svc<T>(…)` claim expression? The escape rule keys on
 * PROVENANCE, not type: a value that came straight from `svc<T>()` is arena-bounded and may not be
 * stored, passed as an argument, or returned — it must be re-claimed. A freshly-CONSTRUCTED value
 * (a `ctor` factory's `EnHi { }`, any function result, a local bound with `var c = svc<…>()`) is
 * NOT a claim and flows freely; only the direct call node carries the restriction (shallow
 * propagation, per the design).
 *
 * @param e  the surface expression at a store/arg/return sink
 * @return   true iff `e` is a direct `svc<T>(…)` intrinsic call
 */
fn expr_is_svc_claim(e: parser::Expr): bool {
    match e.kind {
        parser::Call as c => c.callee.segments.len == 1 && c.callee.segments[0].name == "svc" && c.callee_type_args.len == 1
        _ => false
    }
}

/**
 * (§7 DI, escape rule) The shared diagnostic when a claimed service value escapes its arena binding.
 *
 * @return the located escape error
 */
fn svc_escape_error(): error {
    error { message = "a claimed service value is arena-bounded: it may not be stored, passed as an argument, or returned — re-claim it with svc<T>() where needed" }
}

/**
 * (§7 DI, escape rule) Reject if any EXPLICIT argument is a direct `svc<T>()` claim — the "passed as
 * an argument" sink. Method-call RECEIVERS are excluded (calling a method ON a claim consumes it in
 * place); only genuine argument positions are guarded.
 *
 * @param args  the explicit source arguments
 * @return      the escape error when a claim is passed, else null
 */
fn svc_guard_arg_list(args: []parser::Expr): error | null {
    var i: u64 = 0
    loop {
        if i >= args.len { break }
        if expr_is_svc_claim(args[i]) { return svc_escape_error() }
        i++
    }
    null
}

/**
 * A registered service provider under a `(T, key)` resolution (§7 DI): the provider's canonical type
 * name and the string key it answers to (its bare type name).
 *
 * @field canon  the provider service's canonical (namespace-qualified) name
 * @field key    the string key the provider answers to (its bare last-segment name)
 */
type SvcProvider = struct { canon: str; key: str }

/**
 * (§7 DI) The canonical name of the sole type-argument of a `svc<T>` / `has_svc<T>` intrinsic, or an
 * error when it is not a nominal type.
 *
 * @param c      the intrinsic call node
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the resolved nominal type name of `T`
 * @throws       when `T` is not a nominal (named) type
 */
fn svc_target_name(c: parser::Call, env: Env, table: TypeTable): str | error {
    var t = match resolve_type(c.callee_type_args[0], table, env.cur_ns) { Type as ty => ty; error as e => return e }
    match t {
        Named as nm => nm.name
        _ => error { message = "svc<T> requires T to be a nominal `service` or `interface & IService` type" }
    }
}

/**
 * (§7 DI) Is `tname` a CONCRETE service (a `service` kind), as opposed to an `interface & IService`?
 *
 * @param tname  the target type name
 * @param table  the folded type table
 * @return       true iff `tname` names a concrete service
 */
fn svc_target_is_concrete(tname: str, table: TypeTable): bool {
    match type_table_find(table, tname, "") {
        parser::TypeDecl as td => match td.body { parser::ClassBody as cb => cb.is_service; _ => false }
        error => false
    }
}

/**
 * (§7 DI) Enumerate the service providers that resolve `svc<T>()`. When `T` is a concrete service it
 * provides itself (its bare name is the key); when `T` is an `interface & IService`, every service
 * implementing `T` is a provider (each keyed by its own bare name). The table IS the registry — this
 * reads it directly, so codegen and the checker can never diverge into the historic dual-registry
 * crash (there are no separately-built locator tables).
 *
 * @param tname  the target type's name
 * @param table  the folded type table
 * @return       the providers, in table order
 */
fn svc_providers(tname: str, table: TypeTable): []SvcProvider {
    var out: []SvcProvider = teko::list::empty()
    var want = name_last_segment(tname)
    var concrete = svc_target_is_concrete(tname, table)
    var i: u64 = 0
    loop {
        if i >= tt_len(table) { break }
        var reg = tt_at(table, i)
        i++
        match reg.decl.body {
            parser::ClassBody as cb => {
                if cb.is_service {
                    var scanon = qualify(reg.namespace, name_last_segment(reg.name))
                    var sbare = name_last_segment(reg.name)
                    var matches = if concrete { sbare == want } else { svc_service_implements(cb, want) }
                    if matches { out = teko::list::push(out, SvcProvider { canon = scanon; key = sbare }) }
                }
            }
            _ => { }
        }
    }
    out
}

/**
 * (§7 DI) Does service body `cb` implement the interface whose bare name is `want`?
 *
 * @param cb    the service's class body
 * @param want  the interface's bare last-segment name
 * @return      true iff `cb`'s implements list names `want`
 */
fn svc_service_implements(cb: parser::ClassBody, want: str): bool {
    var j: u64 = 0
    loop {
        if j >= cb.implements.len { break }
        if name_last_segment(cb.implements[j]) == want { return true }
        j++
    }
    false
}

/**
 * (§7 DI) The typed `Provider::ctor()` factory call — the simplest-correct materialization of a
 * service (a fresh instance via its IService `ctor`; the arena-lifetime slot placement is the Doc 1
 * §8 seam, layered later without touching this surface). Recurses through `type_call` so the static
 * factory resolves with full namespace/visibility/type machinery.
 *
 * @param canon  the provider's canonical name
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed factory call (typed as the concrete service), or an error
 */
fn svc_ctor_texpr(canon: str, env: Env, table: TypeTable): TExpr | error {
    var bpath = name_to_path(canon)
    var segs = teko::list::push(bpath.segments, parser::Segment { name = "ctor" })
    type_call(parser::Call { callee = parser::Path { segments = segs }; args = teko::list::empty(); arg_names = teko::list::empty(); owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() }, env, table)
}

/**
 * (§7 DI) A `str`-typed literal TExpr for a comptime key.
 *
 * @param s  the key text
 * @return   the typed string-literal expression
 */
fn svc_str_lit(s: str): TExpr {
    TExpr { kind = TStrLit { text = s }; type = Str { }; line = 0; col = 0 }
}

/**
 * (§7 DI) A `bool`-typed literal TExpr.
 *
 * @param b  the value
 * @return   the typed boolean-literal expression
 */
fn svc_bool_lit(b: bool): TExpr {
    TExpr { kind = TBoolLit { value = b }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * (§7 DI) The `key == "<literal>"` comparison TExpr for the runtime service locator.
 *
 * @param key  the runtime key expression
 * @param lit  the provider's key literal
 * @return     a bool-typed comparison expression
 */
fn svc_key_eq(key: TExpr, lit: str): TExpr {
    var term = TCmpTerm { op = lexer::TokenKind::EqEq; operand = svc_str_lit(lit) }
    TExpr { kind = TCompare { first = key; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * (§7 DI) A single-statement block wrapping one expression tail — the value of an `if`/`else` branch.
 *
 * @param e  the branch's value expression
 * @return   a one-element statement block
 */
fn svc_tail_block(e: TExpr): []TStatement {
    teko::list::push(teko::list::empty(), TExprStmt { expr = e })
}

/**
 * (§7 DI) The runtime service-locator's miss branch — a `panic` that terminates when no provider
 * answers the runtime key (guarded at the call site by `has_svc<T>(key)`, D6).
 *
 * @param tname  the target type's name (for the diagnostic)
 * @return       a diverging panic statement block
 */
fn svc_panic_block(tname: str): []TStatement {
    var msg = svc_str_lit($"svc<{name_last_segment(tname)}>: no provider registered for the runtime key")
    var pseg = teko::list::push(teko::list::empty(), parser::Segment { name = "panic" })
    var pcall = TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = pseg }; args = teko::list::push(teko::list::empty(), msg); call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Void { }; line = 0; col = 0 }
    svc_tail_block(pcall)
}

/**
 * (§7 DI, Path 2) Synthesize the runtime service-locator as an INLINE if/else chain over the
 * providers of `T` — `if key == "A" { A::ctor() } else if key == "B" { B::ctor() } else { panic }` —
 * typed as `T`. Each branch's concrete `Provider::ctor()` is upcast to `T` by the ordinary
 * branch-tail coercion (`emit_as`), so NO separate locator function, vtable-enumeration, or provider
 * registry is emitted: the historic dual-registry OOB cannot recur.
 *
 * @param key        the runtime key expression
 * @param providers  the providers of `T`
 * @param rtype      the result type `T` (a service or interface Named)
 * @param env        the typing environment
 * @param table      the folded type table
 * @return           the typed if-chain expression, or an error
 */
fn svc_runtime_chain(key: TExpr, providers: []SvcProvider, rtype: Type, tname: str, env: Env, table: TypeTable): TExpr | error {
    var elseblk = svc_panic_block(tname)
    var out: TExpr = svc_bool_lit(false)
    var built = false
    var n = providers.len
    loop {
        if n == 0 { break }
        n--
        var ctor = match svc_ctor_texpr(providers[n].canon, env, table) { TExpr as te => te; error as e => return e }
        var cond = svc_key_eq(key, providers[n].key)
        var ifx = TExpr { kind = TIfExpr { cond = cond; then_blk = svc_tail_block(ctor); has_else = true; else_blk = elseblk }; type = rtype; line = 0; col = 0 }
        elseblk = svc_tail_block(ifx)
        out = ifx
        built = true
    }
    if !built { return error { message = "svc: no provider" } }
    out
}

/**
 * (§7 DI, Path 2) The runtime `has_svc<T>(key)` — a nested `if key == "A" { true } … else { false }`
 * over the providers of `T`, typed `bool`. The comptime guard for a runtime `svc<T>(key)`.
 *
 * @param key        the runtime key expression
 * @param providers  the providers of `T`
 * @return           a bool-typed if-chain expression
 */
fn svc_has_runtime_chain(key: TExpr, providers: []SvcProvider): TExpr {
    var out = svc_bool_lit(false)
    var elseblk = svc_tail_block(svc_bool_lit(false))
    var n = providers.len
    loop {
        if n == 0 { break }
        n--
        var cond = svc_key_eq(key, providers[n].key)
        var ifx = TExpr { kind = TIfExpr { cond = cond; then_blk = svc_tail_block(svc_bool_lit(true)); has_else = true; else_blk = elseblk }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
        elseblk = svc_tail_block(ifx)
        out = ifx
    }
    out
}

/**
 * (§7 DI) The comptime constant key of an intrinsic's key argument, or NotSvcOp when the argument is
 * a RUNTIME expression (not a string literal). A `null`/absent key is reported by the caller.
 *
 * @param key  the already-typed key expression
 * @return     the literal text, or NotSvcOp for a runtime key
 */
fn svc_const_key(key: TExpr): str | NotSvcOp {
    match key.kind {
        TStrLit as sl => sl.text
        _ => NotSvcOp { }
    }
}

/**
 * (§7 DI) The clean type error a non-IService `svc<T>`/`has_svc<T>` yields — the diagnostic that
 * turns the historic pre-codegen crash on a plain interface into an honest compile-time rejection.
 *
 * @param tname  the offending target type name
 * @return       the located type error
 */
fn svc_not_iservice_error(tname: str): error {
    error { message = $"svc<T> requires T to satisfy IService — a 'service' type, or an 'interface & IService'; '{name_last_segment(tname)}' does not" }
}

/**
 * (§7 DI) Type the `svc<T: IService>(key: str | null = null): T` intrinsic (§7 Part A). `T` must
 * satisfy IService (else a clean type error, never the historic crash). Resolution: a `null`/absent
 * key resolves BY TYPE (a concrete service → its `ctor`); a CONSTANT string key resolves the provider
 * at comptime (a miss is a comptime error, D6); a RUNTIME key lowers to the inline locator chain
 * (Path 2), guarded by `has_svc`. Returns NotSvcOp when the callee is not `svc`, so `type_call` falls
 * through.
 *
 * @param c      the raw static-call node (`svc<T>(key?)`)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the resolved/typed expression, NotSvcOp, or a type error
 * @throws       on a non-IService `T`, a missing const-key provider, or a keyless interface resolve
 * @since 0.3.1
 */
fn type_svc(c: parser::Call, env: Env, table: TypeTable): TExpr | NotSvcOp | error {
    if c.callee.segments.len != 1 { return NotSvcOp { } }
    if c.callee.segments[0].name != "svc" { return NotSvcOp { } }
    if c.callee_type_args.len != 1 { return NotSvcOp { } }
    if c.args.len > 1 { return error { message = "svc<T>(key) takes at most one argument (an optional string key)" } }
    var tname = match svc_target_name(c, env, table) { str as s => s; error as e => return e }
    if !type_satisfies_iservice(tname, table) { return svc_not_iservice_error(tname) }
    var providers = svc_providers(tname, table)
    var concrete = svc_target_is_concrete(tname, table)
    if c.args.len == 0 {
        if !concrete { return error { message = $"svc<{name_last_segment(tname)}>() over an interface needs a key — write svc<{name_last_segment(tname)}>(\"Impl\")" } }
        if providers.len == 0 { return error { message = $"svc<{name_last_segment(tname)}>(): no service provider" } }
        match svc_ctor_texpr(providers[0].canon, env, table) { TExpr as te => return te; error as e => return e }
    }
    var key = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    match key.type { Str => { }; _ => return error { message = "svc<T>(key)'s key must be a `str`" } }
    match svc_const_key(key) {
        str as k => {
            var hit = svc_provider_for_key(providers, k)
            match hit {
                SvcProvider as p => match svc_ctor_texpr(p.canon, env, table) { TExpr as te => return te; error as e => return e }
                NotSvcOp => return error { message = $"svc<{name_last_segment(tname)}>(\"{k}\"): no service provider registered under that key" }
            }
        }
        NotSvcOp => { }
    }
    var rtype: Type = Named { name = tname }
    match svc_runtime_chain(key, providers, rtype, tname, env, table) { TExpr as te => return te; error as e => return e }
}

/**
 * (§7 DI) The provider answering a constant key, or NotSvcOp on a miss.
 *
 * @param providers  the providers of `T`
 * @param k          the constant key
 * @return           the matching provider, or NotSvcOp
 */
fn svc_provider_for_key(providers: []SvcProvider, k: str): SvcProvider | NotSvcOp {
    var i: u64 = 0
    loop {
        if i >= providers.len { break }
        if providers[i].key == k { return providers[i] }
        i++
    }
    NotSvcOp { }
}

/**
 * (§7 DI) Type the `has_svc<T: IService>(key: str): bool` intrinsic — true iff a provider is
 * registered under `(T, key)`. A CONSTANT key is a comptime bool; a RUNTIME key lowers to the inline
 * boolean locator chain. Returns NotSvcOp when the callee is not `has_svc`.
 *
 * @param c      the raw static-call node (`has_svc<T>(key)`)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the bool-typed expression, NotSvcOp, or a type error
 * @throws       on a non-IService `T` or a missing/non-str key
 * @since 0.3.1
 */
fn type_has_svc(c: parser::Call, env: Env, table: TypeTable): TExpr | NotSvcOp | error {
    if c.callee.segments.len != 1 { return NotSvcOp { } }
    if c.callee.segments[0].name != "has_svc" { return NotSvcOp { } }
    if c.callee_type_args.len != 1 { return NotSvcOp { } }
    if c.args.len != 1 { return error { message = "has_svc<T>(key) requires exactly one argument (the string key)" } }
    var tname = match svc_target_name(c, env, table) { str as s => s; error as e => return e }
    if !type_satisfies_iservice(tname, table) { return svc_not_iservice_error(tname) }
    var providers = svc_providers(tname, table)
    var key = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
    match key.type { Str => { }; _ => return error { message = "has_svc<T>(key)'s key must be a `str`" } }
    match svc_const_key(key) {
        str as k => {
            match svc_provider_for_key(providers, k) {
                SvcProvider => return svc_bool_lit(true)
                NotSvcOp => return svc_bool_lit(false)
            }
        }
        NotSvcOp => { }
    }
    svc_has_runtime_chain(key, providers)
}

/**
 * resolve_call_args — the single call-site argument resolver: dispatch to `pack_variadic_args` for a
 * `params`-variadic callee, else to `resolve_defargs`. Both produce a positional `[]parser::Expr` of
 * exactly `f.params.len` entries in declaration order, so §9 C defaults and `:=` named arguments bind
 * uniformly whether or not the callee is variadic (owner ruling C-T1: `params` is an inherent
 * trailing-optional and composes with defaults/named args).
 *
 * @param f          the callee's function type
 * @param args       the raw call-site argument expressions, in source order
 * @param arg_names  the parallel names (`""` positional, else a `:=` target), one per `args` entry
 * @param env        the typing environment (for a variadic passthrough type probe)
 * @param table      the resolved type table
 * @return           the resolved declaration-order positional arguments, or a located error
 * @throws           on arity/name/default violations reported by the delegate resolver
 * @since §9 C
 */
fn resolve_call_args(f: Func, args: []parser::Expr, arg_names: []str, env: Env, table: TypeTable): []parser::Expr | error {
    if f.variadic { return pack_variadic_args(f, args, arg_names, env, table) }
    resolve_defargs(f, args, arg_names)
}

/**
 * positional_prefix_len — the number of leading positional arguments before the first `:=` named
 * argument (§9 C ruling 2: named args are trailing, enforced at parse time). Equals `arg_names.len`
 * when the call is all-positional.
 *
 * @param arg_names  the parallel argument names (`""` = positional)
 * @return           the index of the first named argument, or `arg_names.len` if none
 * @since §9 C
 */
fn positional_prefix_len(arg_names: []str): u64 {
    var n: u64 = 0
    loop { if n >= arg_names.len { break }; if arg_names[n] != "" { break }; n++ }
    n
}

/**
 * named_arg_expr — the argument expression a named `:=` argument supplies for the fixed-prefix
 * parameter `pname`, searched over the named suffix `[npos, args.len)`. Returns null when no named
 * argument targets `pname` (so the parameter falls back to a default or is missing).
 *
 * @param pname      the fixed-prefix parameter's name being filled
 * @param args       the raw call-site argument expressions
 * @param arg_names  the parallel argument names
 * @param npos       the positional-prefix length (first named index)
 * @return           the matching argument expression, or null
 * @since §9 C
 */
fn named_arg_expr(pname: str, args: []parser::Expr, arg_names: []str, npos: u64): parser::Expr | null {
    var k: u64 = npos
    loop {
        if k >= args.len { break }
        if arg_names[k] == pname { return args[k] }
        k++
    }
    null
}

/**
 * validate_variadic_named — reject a `:=` named argument on a variadic call that does not target a
 * FIXED-prefix parameter (§9 C + owner ruling C-T1): an unknown name, a name already filled
 * positionally, or a name that targets the trailing `params` slot itself (the variadic slot is
 * positional-only — it collects the tail, it is not passed by name).
 *
 * @param f          the variadic callee's function type
 * @param args       the raw call-site argument expressions
 * @param arg_names  the parallel argument names
 * @param npos       the positional-prefix length (also the count of positionally-filled params)
 * @param nfixed     the number of fixed (non-variadic) parameters
 * @return           null when every named argument is a legal fixed-prefix target, else an error
 * @throws           on an unknown name, a positionally-filled name, or a `params`-slot name
 * @since §9 C
 */
fn validate_variadic_named(f: Func, args: []parser::Expr, arg_names: []str, npos: u64, nfixed: u64): error | null {
    var vk: u64 = npos
    loop {
        if vk >= args.len { break }
        var nm = arg_names[vk]
        var fidx: u64 = 0
        var matched = false
        loop { if fidx >= f.param_names.len { break }; if f.param_names[fidx] == nm { matched = true; break }; fidx++ }
        if !matched { return error { message = $"unknown named argument '{nm}'" } }
        if fidx >= nfixed { return error { message = $"the variadic 'params' parameter '{nm}' cannot be passed by name" } }
        if fidx < npos { return error { message = $"named argument '{nm}' was already provided positionally" } }
        vk++
    }
    null
}

/**
 * (2026-07-01, extended §9 C) call-site desugar for a `params`-variadic function `f`. Resolves the
 * FIXED prefix `[0, nfixed)` with the same defaults/named-argument binding as `resolve_defargs`
 * (owner ruling C-T1), then collapses the remaining positional tail into ONE synthetic array-literal
 * for the trailing `params` slot. Two fast shapes preserved: passthrough — exactly `f.params.len`
 * all-positional args whose last is already typed `[]T` (T = the params element type) → returned
 * verbatim; pack — otherwise the tail (0 or more) beyond `nfixed` becomes the array literal, so the
 * rest of `type_call` sees an ordinary `f.params.len`-arity call.
 *
 * @param f          the variadic callee's function type
 * @param args       the raw call-site argument expressions, in source order
 * @param arg_names  the parallel names (`""` positional, else a `:=` fixed-prefix target)
 * @param env        the typing environment (for the passthrough type probe)
 * @param table      the resolved type table
 * @return           the `f.params.len`-entry positional arguments (fixed prefix + packed tail)
 * @throws           on too few fixed arguments, a missing required parameter, or an illegal named arg
 * @since §9 C
 */
fn pack_variadic_args(f: Func, args: []parser::Expr, arg_names: []str, env: Env, table: TypeTable): []parser::Expr | error {
    var nfixed = f.params.len - 1
    var elem_ty = match f.params[nfixed] { Slice as s => s.element; _ => Void { } }   // parser already enforced the last param is a Slice
    var npos = positional_prefix_len(arg_names)
    var any_named = npos < args.len
    if !any_named && args.len == f.params.len {
        var last = match type_expr(args[nfixed], env, table) { TExpr as te => te; error as e => return e }
        if type_eq(last.type, Slice { element = elem_ty }) { return args }   // passthrough
    }
    if any_named && npos > nfixed { return error { message = "wrong number of arguments" } }
    match validate_variadic_named(f, args, arg_names, npos, nfixed) { error as e => return e; null => { } }
    var fixed_pos = if npos < nfixed { npos } else { nfixed }
    var out: []parser::Expr = teko::list::empty()
    var idx: u64 = 0
    loop {
        if idx >= nfixed { break }
        if idx < fixed_pos {
            out = teko::list::push(out, args[idx])
        } else {
            match named_arg_expr(f.param_names[idx], args, arg_names, npos) {
                parser::Expr as e => out = teko::list::push(out, e)
                null => {
                    if idx < f.n_required { return error { message = $"missing required argument '{f.param_names[idx]}'" } }
                    out = teko::list::push(out, f.defaults[idx - f.n_required])
                }
            }
        }
        idx++
    }
    var elems: []parser::ArrayElem = teko::list::empty()
    var i = fixed_pos
    loop {
        if i >= args.len { break }
        if arg_names[i] != "" { break }
        elems = teko::list::push(elems, parser::ArrayElem { is_spread = false; expr = args[i] })
        i++
    }
    var synth = parser::Expr { kind = parser::ArrayLit { elements = elems }; line = 0; col = 0 }
    teko::list::push(out, synth)
}

// (2026-07-01 DEFARGS) call-site resolution for a NON-variadic function `f`: named-arg-to-index
// lookup + default-fill for omitted trailing params. Produces a positional []parser::Expr of
// EXACTLY f.params.len entries, in declaration order, ready for the ordinary typing loop below.
// NOTE: intentionally NOT composed with `params`/variadic (pack_variadic_args, above) yet — a
// function that is BOTH variadic AND has named/default params is an unsupported combination for
// now (type_call only calls this for `!f.variadic`); Teko has no array index-assignment, so this
// builds the result via a single forward pass (0..params.len), pushing whichever source (a
// positional arg, a matching named arg, or the param's default) applies at each index.
fn resolve_defargs(f: Func, args: []parser::Expr, arg_names: []str): []parser::Expr | error {
    var any_named = false
    var ai: u64 = 0
    loop { if ai >= arg_names.len { break }; if arg_names[ai] != "" { any_named = true }; ai++ }
    if !any_named && args.len == f.params.len { return args }   // fast identity path — the overwhelmingly common case, zero overhead
    if any_named && f.param_names.len != f.params.len {
        return error { message = "this function cannot be called with named arguments (only a plain, named `fn` declaration supports named-call — not a closure value or builtin)" }
    }
    // the positional PREFIX length (rule D: named-LAST — already enforced at parse time, so the
    // first named arg marks where positional args end).
    var npos: u64 = 0
    loop { if npos >= arg_names.len { break }; if arg_names[npos] != "" { break }; npos++ }
    if npos > f.params.len { return error { message = "wrong number of arguments" } }
    // validate every named arg targets a REAL, not-already-positionally-filled param.
    var vk: u64 = npos
    loop {
        if vk >= args.len { break }
        var nm = arg_names[vk]
        var fidx: u64 = 0
        var matched = false
        loop { if fidx >= f.param_names.len { break }; if f.param_names[fidx] == nm { matched = true; break }; fidx++ }
        if !matched { return error { message = $"unknown named argument '{nm}'" } }
        if fidx < npos { return error { message = $"named argument '{nm}' was already provided positionally" } }
        vk++
    }
    var resolved: []parser::Expr = teko::list::empty()
    var idx: u64 = 0
    loop {
        if idx >= f.params.len { break }
        if idx < npos {
            resolved = teko::list::push(resolved, args[idx])
        } else {
            var found = false
            var found_expr = parser::no_expr()
            var k: u64 = npos
            loop {
                if k >= args.len { break }
                if arg_names[k] == f.param_names[idx] { found = true; found_expr = args[k]; break }
                k++
            }
            if found {
                resolved = teko::list::push(resolved, found_expr)
            } else if idx < f.n_required {
                return error { message = $"missing required argument '{f.param_names[idx]}'" }
            } else {
                resolved = teko::list::push(resolved, f.defaults[idx - f.n_required])
            }
        }
        idx++
    }
    resolved
}

// (C8.3, ported 2026-07-01 to close a self-host gap — see is_flags_method) flags helper method
// calls: recv.has/all/any/none/add/remove(mask). Lowered to synthetic TAST nodes directly (not
// through type_binary/type_unary's normal operator checks — the mask arithmetic is internal):
//   add(mask): recv | mask             (TBinary, flags type)
//   remove(mask): recv & ~mask            (TBinary with a nested TUnary)
//   has/all(mask): (recv & mask) == mask   (TCompare, bool)
//   any(mask): (recv & mask) != 0_flags
//   none(mask): (recv & mask) == 0_flags
// The C bootstrap (expr.c::type_flags_method) has carried this since C8.3; the self-hosted .tks
// checker never did (is_flags_method was defined, dead — a MethodCall always hit the "deferred"
// error before it could dispatch here). Mirror of expr.c::type_flags_method.
/**
 * flags_named_has_user_method — does the flags value-type `t` declare a user method named `name`
 * (§9 ruling 12)? Used at the method-call router to divert a matching call to the ordinary method
 * dispatch, while a NON-matching name keeps the built-in flags path (has/all/any/none/add/remove).
 * Always false on the compiler's own corpus (no flags carries a body) — the built-in routing stays
 * byte-identical (the plan §8 fixpoint argument).
 *
 * @param t      the receiver type
 * @param name   the called method name
 * @param table  the folded type table
 * @return       true iff `t` is a flags type whose body declares a method `name`
 * @since §9
 */
fn flags_named_has_user_method(t: Type, name: str, table: TypeTable): bool {
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::FlagsBody as fb => func_list_has_name(fb.methods, name)
                _ => false
            }
            error => false
        }
        _ => false
    }
}

/**
 * func_list_has_name — does the function list `fns` contain a member named `name`? A small linear
 * scan shared by the §9 value-type method-dispatch routing.
 *
 * @param fns   the function list
 * @param name  the name sought
 * @return      true iff some `fns[i].name == name`
 * @since §9
 */
fn func_list_has_name(fns: []parser::Function, name: str): bool {
    var i = 0
    loop {
        if i >= fns.len { break }
        if fns[i].name == name { return true }
        i++
    }
    false
}

fn type_flags_method(mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(mc.receiver, env, table) { TExpr as te => te; error as e => return e }
    var rt = recv.type
    if !is_flags_named(rt, table) { return error { message = "method call on a non-flags receiver (flags methods: has/all/any/none/add/remove)" } }
    if mc.args.len != 1 { return error { message = "flags methods take exactly one argument (the mask)" } }
    var mask = match type_expr(mc.args[0], env, table) { TExpr as te => te; error as e => return e }
    if !type_eq(rt, mask.type) {
        return teko::error::err_typed(error { message = "flags method argument must be the same flags type as the receiver" }, type_render(rt), type_render(mask.type))
    }
    var is_has = mc.method == "has"
    var is_all = mc.method == "all"
    var is_any = mc.method == "any"
    var is_none = mc.method == "none"
    var is_add = mc.method == "add"
    var is_rem = mc.method == "remove"
    if !is_has && !is_all && !is_any && !is_none && !is_add && !is_rem {
        return error { message = "unknown flags method (has/all/any/none/add/remove)" }
    }
    if is_add {
        return TExpr { kind = TBinary { op = lexer::TokenKind::Pipe; left = recv; right = mask }; type = rt; line = 0; col = 0 }
    }
    if is_rem {
        var notmask = TExpr { kind = TUnary { op = lexer::TokenKind::Tilde; operand = mask }; type = rt; line = 0; col = 0 }
        return TExpr { kind = TBinary { op = lexer::TokenKind::Amp; left = recv; right = notmask }; type = rt; line = 0; col = 0 }
    }
    var andexpr = TExpr { kind = TBinary { op = lexer::TokenKind::Amp; left = recv; right = mask }; type = rt; line = 0; col = 0 }
    if is_has || is_all {
        var term = TCmpTerm { op = lexer::TokenKind::EqEq; operand = mask }
        return TExpr { kind = TCompare { first = andexpr; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
    }
    // any/none: compare (recv & mask) against a zero-valued flags literal (the same pattern as
    // an enum ordinal cast — codegen/interpreter read the NAMED flags type off the node, not the literal).
    var zero = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = rt; line = 0; col = 0 }
    var cmp_op = if is_none { lexer::TokenKind::EqEq } else { lexer::TokenKind::Ne }
    var term = TCmpTerm { op = cmp_op; operand = zero }
    TExpr { kind = TCompare { first = andexpr; rest = teko::list::push(teko::list::empty(), term) }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/** (W10b.D3; generalized S6/issue #162) a resolved interface dot-call: the DECLARING interface
    (the D3 vtable/upcast key), the resolved Function signature, and its vtable SLOT within that
    interface's own effective-methods list. */
type IfaceDispatch = struct { iface: str; method: parser::Function; slot: u32 }

/** (S6) find `method` within `eff` (an interface's own effective methods), returning its slot. */
fn find_method_slot(eff: []parser::Function, method: str): IfaceDispatch | null {
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        if eff[i].name == method { return IfaceDispatch { iface = ""; method = eff[i]; slot = i to u32 } }
        i++
    }
    null
}

/** (W10b.D2, issue #99; generalized S6/issue #162) resolve `method` on an InterfaceBody receiver
    to its DISPATCH interface + slot. A plain interface receiver (methods.len > 0 — it declares its
    OWN methods, so it IS the dispatch interface) resolves against ITSELF (`struct_name`). A body
    with NO own methods (methods.len == 0) is either a genuine `interface X extends A, B {}` OR a
    generic type-param's synthetic InterfaceBody (type_param_table; S6: an `extends` list of N real
    interfaces, the constraint's And-union / Or-intersection surface) — BOTH shapes want the SAME
    resolution: search EACH interface of `extends`, in order, for the first that OWNS the method
    (method_owner_interface — the D3 vtable key), and read the slot from THAT interface's own
    effective-methods list (never a concatenated list — the emitted vtable is per-(class,
    interface), so the slot must agree with it). This subsumes the single-extends #99 case (the
    search trivially finds the one interface). A method owned by no interface of `extends` is the
    S6 "outside the authorized surface" honest stop. */
fn resolve_iface_dispatch(ib: parser::InterfaceBody, struct_name: str, method: str, table: TypeTable): IfaceDispatch | error {
    if ib.methods.len > 0 {
        var eff = match iface_methods_by_name(struct_name, table) { []parser::Function as f => f; error as e => return e }
        return match find_method_slot(eff, method) {
            IfaceDispatch as d => IfaceDispatch { iface = struct_name; method = d.method; slot = d.slot }
            null => error { message = $"no such method '{method}' on interface '{struct_name}'" }
        }
    }
    var owner = match method_owner_interface(ib.extends, method, table) {
        str as o => o
        null => return error { message = $"method '{method}' is not guaranteed by the constraint on type parameter '{struct_name}' ({type_param_surface_message(ib.extends, table)})" }
    }
    var eff = match iface_methods_by_name(owner, table) { []parser::Function as f => f; error as e => return e }
    match find_method_slot(eff, method) {
        IfaceDispatch as d => IfaceDispatch { iface = owner; method = d.method; slot = d.slot }
        null => error { message = $"internal: method_owner_interface named '{owner}' as owner of '{method}' but its effective methods do not contain it" }
    }
}

/** (S6, M.1) render the type-param's authorized surface (every method name every constrained
    interface of `extends` contributes) for the "not guaranteed by the constraint" error — so the
    message enumerates what IS available, never just what is missing. */
fn type_param_surface_message(extends: []str, table: TypeTable): str {
    var names = ""
    var i = 0
    loop {
        if i >= extends.len { break }
        var ms = match iface_methods_by_name(extends[i], table) { []parser::Function as f => f; error => teko::list::empty() }
        var j = 0
        loop {
            if j >= ms.len { break }
            if names == "" { names = ms[j].name } else { names = $"{names}, {ms[j].name}" }
            j++
        }
        i++
    }
    if names == "" { return "available: none" }
    $"available: {names}"
}

/** (S6, M.1) is `decl` a type-param's OWN synthetic decl (resolve::type_param_table) — never a
    genuine user decl, which the parser's own invariant keeps same-length on `type_params`/
    `type_constraints` (so a real 0-type-param decl always carries 0 constraints, the one shape a
    type-param's synthetic decl never has). */
fn is_type_param_decl(decl: parser::TypeDecl): bool {
    decl.type_params.len == 0 && decl.type_constraints.len == 1
}

/**
 * Is `name` a PHANTOM generic-instance name — a `Base__g__…` mangling at least one of whose argument
 * tokens is an in-scope abstract type-param (a `type_param_table` synthetic decl)? A generic function
 * or method that constructs a DIFFERENT generic type from its OWN type-param (`Box<T>` inside
 * `wrap<T>`) resolves that construction to `Box__g__T`, which no `instantiate_types` site stamps while
 * `T` is abstract. `type_struct_lit` tolerates such a phantom (deferring the stamp to the mono pass,
 * which re-mangles it through the bound `T` via `subst_instance_name`) instead of failing with the
 * "was not stamped" internal error — but ONLY for a genuine phantom: a name every token of which is a
 * concrete type is a real missing-stamp defect and still errors. Each maximal non-`_` token is probed
 * against the type table; a token resolving to a type-param's synthetic decl (`is_type_param_decl`)
 * makes the whole name a phantom.
 *
 * @param name   a resolved, `__g__`-stamped instance name
 * @param table  the folded type table, with the enclosing generic's type-params registered
 * @return       true iff some argument token of `name` is an in-scope abstract type-param
 */
fn name_is_phantom_instance(name: str, table: TypeTable): bool {
    if !name_is_g_instance(name) { return false }
    var i: u64 = 0
    loop {
        if i >= name.len { break }
        if name[i] == b'_' { i++; continue }
        var j = i
        loop { if j >= name.len { break }; if name[j] == b'_' { break }; j++ }
        var tok = teko::str::slice(name, i, j)
        match type_table_find(table, tok, "") {
            parser::TypeDecl as td => { if is_type_param_decl(td) { return true } }
            error => { }
        }
        i = j
    }
    false
}

/** (S6, M.1) when a constrained type-param's `extends` list came back EMPTY not because the
    constraint genuinely authorizes nothing (NoConstraint / a struct-or-variant atom) but because
    resolve::constraint_interfaces ERRORED (a trait atom / an unknown atom / a Risco-3 ambiguity),
    recompute that SAME error here so the honest stop names the real reason instead of the generic
    "method typing is deferred" — resolve::type_param_table has no error channel, so this is where
    the swallowed error re-surfaces, at the first attempted operation on `T` (never silently lost). */
fn type_param_call_error(decl: parser::TypeDecl, table: TypeTable): error | null {
    if !is_type_param_decl(decl) { return null }
    match constraint_interfaces(decl.type_constraints[0], table) {
        []str => null
        error as e => e
    }
}

/**
 * Build the direct-method-dispatch callee as a TWO-segment path whose qualifier segment carries the
 * receiver's FULL CANONICAL class name (`ns::…::Class`) and whose last segment is the method, so
 * `lookup_call`/`call_ns` key off the exact owning namespace and never collide with a same-bare
 * class in a sibling namespace (#290, #109-family). The receiver's `struct_name` is already
 * canonical (from `recv_t = Named{n.name}`), so it is placed verbatim as the single qualifier
 * segment; `ns_matches_call_qualifier` then compares `b.ns` against that whole canonical string
 * (equals, or ends-with `::<class>`), disambiguating two same-bare classes. Keeping the qualifier in
 * ONE segment — rather than splitting it back to `[..ns.., Class]` — means the callee never starts
 * with `teko`, so it never trips the interpreter's `teko`-rooted builtin name-sniffer (which would otherwise
 * treat a method named `len`/`str`/`parse`/… on a `teko::…` class as a string builtin). Mirrors how
 * FIELD access already resolves off the canonical `Named` via the type table (why fields never
 * regressed). Both backends read only the LAST segment (the method) plus `TCall.call_ns`, so the
 * qualifier's shape is transparent to codegen and the interpreter.
 *
 * @param struct_name  the receiver's canonical class name (`ns::…::Class`, or bare at the root ns)
 * @param method       the dispatched method's bare name
 * @return             the `[Class-canonical, method]` callee path
 * @since onda-3 (#290)
 */
fn method_dispatch_callee(struct_name: str, method: str): parser::Path {
    var segs: []parser::Segment = teko::list::push(teko::list::empty(), parser::Segment { name = struct_name })
    segs = teko::list::push(segs, parser::Segment { name = method })
    parser::Path { segments = segs }
}

/** `recv.method(args)` — an INSTANCE struct-method dot-call (OOP A1, 2026-07-01). Desugars into
    an ordinary `StructName::method(recv, ...args)` Call and delegates to `type_call` wholesale
    (reuses arity/defargs/generics/namespace-mangling for free — the same trick `~` used for
    `teko::string::concat`). The receiver is typed ONCE here just to discover which struct/method
    is targeted; `type_call` re-types it (and every arg) as part of its normal argument pass.
    Flags-typed receivers dispatch to type_flags_method (the dispatch's job, mirroring the C
    switch's precedence — see type_dispatch's MethodCall arm), never reaching here. A bare `.` call
    on an un-narrowed `T | null` receiver stays a compile error (NP-OOP, issue #116) — but names WHY
    and points at the narrowing match (`require_narrowed`) instead of the deferral message. The
    receiver-type lookup (`type_table_find`) is a resolved-name probe (#109 W1, no referencing ns); once resolved,
    a type-param's swallowed constraint error (S6, M.1 — a trait atom / an unknown atom / a Risco-3
    ambiguity) re-surfaces here, named, before an INTERFACE-typed receiver's DYNAMIC contract-method
    call resolves against the interface's EFFECTIVE (extends-transitive) signature list; its index
    there is the vtable slot both backends dispatch through. The receiver rides as args[0] (an
    interface value, or a class instance the emitters upcast on the fly). Mirror:
    expr.c::type_method_call. */
/**
 * method_call_arg_names — the effective call-site argument names for a method dot-call, with the
 * receiver prepended as an unnamed (`""`) index-0 argument. `resolve_defargs`/`pack_variadic_args`
 * treat a method exactly like a free call whose first parameter is the receiver, so the receiver is
 * always positional and every entry of `mc.arg_names` (a `""` positional or a `:=` named target,
 * §9 C ruling 2) follows it in order.
 *
 * @param mc  the parsed method call
 * @return    `["", mc.arg_names[0], mc.arg_names[1], …]`, parallel to the receiver-prepended args
 * @since §9 C
 */
fn method_call_arg_names(mc: parser::MethodCall): []str {
    var names: []str = teko::list::push(teko::list::empty(), "")
    var i: u64 = 0
    loop { if i >= mc.arg_names.len { break }; names = teko::list::push(names, mc.arg_names[i]); i++ }
    names
}

/**
 * expr_roots_at_name — does the lvalue chain of `e` bottom out at the bare variable `nm`? Walks a
 * `FieldAccess`/`Index` receiver chain to its root (like `lvalue_root`, but also descends an `Index`
 * receiver, which a self-write `self[i] = v` needs). Used to spot a write or a mutating call whose
 * target/receiver roots at `self`.
 *
 * @param e   the expression to walk
 * @param nm  the root name sought (`self` for the mutation analysis)
 * @return    true iff the chain roots at `Var(nm)`
 * @since item-14
 */
fn expr_roots_at_name(e: parser::Expr, nm: str): bool {
    match e.kind {
        parser::Var as v => v.name == nm
        parser::FieldAccess as fa => expr_roots_at_name(fa.receiver, nm)
        parser::Index as ix => expr_roots_at_name(ix.receiver, nm)
        _ => false
    }
}

/**
 * assign_target_is_self — does assignment `a` write THROUGH `self`? True for `self = …` /
 * `self.value = …` (a bare/deref target named `self`) and for `self.field = …` / `self[i] = …` (a
 * Field/Index target whose lvalue chain roots at `self`). This is the direct-write leaf of the
 * mutating-method inference (§13.2).
 *
 * @param a  the raw assignment
 * @return   true iff the assignment mutates the receiver
 * @since item-14
 */
fn assign_target_is_self(a: parser::Assign): bool {
    match a.kind {
        parser::AssignKind::Simple => a.name == "self"
        parser::AssignKind::RefDeref => a.name == "self"
        parser::AssignKind::Field => expr_roots_at_name(a.target, "self")
        parser::AssignKind::Index => expr_roots_at_name(a.target, "self")
    }
}

/**
 * find_instance_method_named — the instance method (or operator) named `mname` on the struct/class/
 * value-type `sname`, or null when there is none. Feeds the transitive step of the mutating-method
 * inference: a `self.other(…)` call resolves `other` here to recurse into its body.
 *
 * @param sname  the declaring type's name
 * @param mname  the method name sought
 * @param table  the folded type table
 * @return       the matching Function, or null
 * @since item-14
 */
fn find_instance_method_named(sname: str, mname: str, table: TypeTable): parser::Function | null {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return null }
    var methods = match decl.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error => return null }
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => return null
    }
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        if methods[i].name == mname { return methods[i] }
        i++
    }
    null
}

/**
 * method_name_visited — has method name `nm` already been entered on the current transitive-call walk?
 * Guards the least-fixpoint recursion of `method_mutates_self` against a cycle (a method calling
 * itself, directly or through a ring); a cycle is treated as non-mutating until a write is proven.
 *
 * @param visited  the names entered so far
 * @param nm       the method name under test
 * @return         true iff `nm` is already on the walk
 * @since item-14
 */
fn method_name_visited(visited: []str, nm: str): bool {
    var i = 0 to u64
    loop {
        if i >= visited.len { break }
        if visited[i] == nm { return true }
        i++
    }
    false
}

/**
 * method_mutates_self — does instance method `m` of `sname` mutate its receiver (§13.2)? True when the
 * body WRITES self (`self.field = …` / `self[i] = …` / `self = …`, or a property `set` on self, which
 * desugars to such a write), OR calls another instance method on self that itself mutates self. There
 * is NO `mut fn` marker — the inference is entirely from the body (ruling 7). The walk is bounded by a
 * visited-name set (least fixpoint: a recursion cycle is non-mutating until a write is proven). Inert
 * on today's corpus: no value-struct method writes self (structs are by-value), so this returns false
 * for every struct method and the §13.2 receiver check never fires.
 *
 * @param sname  the declaring type's name
 * @param m      the method
 * @param table  the folded type table (to resolve callee methods for the transitive step)
 * @return       true iff calling `m` may mutate the receiver
 * @since item-14
 */
fn method_mutates_self(sname: str, m: parser::Function, table: TypeTable): bool {
    method_mutates_self_guarded(sname, m, table, teko::list::empty())
}

/**
 * method_mutates_self_guarded — `method_mutates_self` carrying the visited-name set for cycle
 * safety. Enters `m.name`, then scans the body for a self-write or a mutating self-call.
 *
 * @param sname    the declaring type's name
 * @param m        the method under analysis
 * @param table    the folded type table
 * @param visited  the method names already on this walk
 * @return         true iff `m` mutates self
 * @since item-14
 */
fn method_mutates_self_guarded(sname: str, m: parser::Function, table: TypeTable, visited: []str): bool {
    if method_name_visited(visited, m.name) { return false }
    stmts_mutate_self(sname, m.body, table, teko::list::push(visited, m.name))
}

/**
 * stmts_mutate_self — does any statement in `stmts` write self or issue a mutating self-call (§13.2)?
 *
 * @param sname    the declaring type's name
 * @param stmts    the statement list
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff some statement mutates self
 * @since item-14
 */
fn stmts_mutate_self(sname: str, stmts: []parser::Statement, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= stmts.len { break }
        if stmt_mutates_self(sname, stmts[i], table, visited) { return true }
        i++
    }
    false
}

/**
 * stmt_mutates_self — does a single statement write self or contain a mutating self-call (§13.2)? A
 * direct `Assign` whose target roots at self is a write; every statement's sub-expressions and nested
 * blocks are scanned for a mutating self-method call.
 *
 * @param sname    the declaring type's name
 * @param s        the statement
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff the statement mutates self
 * @since item-14
 */
fn stmt_mutates_self(sname: str, s: parser::Statement, table: TypeTable, visited: []str): bool {
    match s {
        parser::Assign as a => {
            if assign_target_is_self(a) { return true }
            if expr_mutates_self(sname, a.value, table, visited) { return true }
            parser::assign_has_target(a.kind) && expr_mutates_self(sname, a.target, table, visited)
        }
        parser::Binding as b => expr_mutates_self(sname, b.value, table, visited)
        parser::MultiBind as mb => exprs_mutate_self(sname, mb.values, table, visited)
        parser::Return as r => (r.has_value && expr_mutates_self(sname, r.value, table, visited)) || exprs_mutate_self(sname, r.values, table, visited)
        parser::ExprStmt as es => expr_mutates_self(sname, es.expr, table, visited)
        parser::LoopStmt as l => stmts_mutate_self(sname, l.init, table, visited) || stmts_mutate_self(sname, l.body, table, visited)
        parser::DeferStmt as d => stmts_mutate_self(sname, d.body, table, visited)
        parser::AdoptStmt as ad => stmts_mutate_self(sname, ad.body, table, visited)
        parser::BlockStmt as bl => stmts_mutate_self(sname, bl.body, table, visited)
        _ => false
    }
}

/**
 * exprs_mutate_self — does any expression in `es` contain a mutating self-call (§13.2)?
 *
 * @param sname    the declaring type's name
 * @param es       the expression list
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff some expression carries a mutating self-call
 * @since item-14
 */
fn exprs_mutate_self(sname: str, es: []parser::Expr, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= es.len { break }
        if expr_mutates_self(sname, es[i], table, visited) { return true }
        i++
    }
    false
}

/**
 * arms_mutate_self — does any match arm's guard or body carry a mutating self-call (§13.2)?
 *
 * @param sname    the declaring type's name
 * @param arms     the match arms
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff some arm mutates self
 * @since item-14
 */
fn arms_mutate_self(sname: str, arms: []parser::Arm, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= arms.len { break }
        if arms[i].has_when && expr_mutates_self(sname, arms[i].guard, table, visited) { return true }
        if stmts_mutate_self(sname, arms[i].body, table, visited) { return true }
        i++
    }
    false
}

/**
 * expr_mutates_self — does expression `e` issue a mutating self-call (§13.2)? A `MethodCall` whose
 * receiver roots at self is resolved to its callee method and recursed into (transitive mutation);
 * every other node is walked structurally into its sub-expressions and nested statement blocks. Leaf
 * nodes (literals, `Var`, `PathExpr`) carry no self-mutation.
 *
 * @param sname    the declaring type's name
 * @param e        the expression
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff the expression carries a mutating self-call
 * @since item-14
 */
fn expr_mutates_self(sname: str, e: parser::Expr, table: TypeTable, visited: []str): bool {
    match e.kind {
        parser::MethodCall as mc => {
            if expr_roots_at_name(mc.receiver, "self") {
                match find_instance_method_named(sname, mc.method, table) {
                    parser::Function as cm => if method_mutates_self_guarded(sname, cm, table, visited) { return true }
                    null => { }
                }
            }
            expr_mutates_self(sname, mc.receiver, table, visited) || exprs_mutate_self(sname, mc.args, table, visited)
        }
        parser::Call as c => exprs_mutate_self(sname, c.args, table, visited)
        parser::Binary as b => expr_mutates_self(sname, b.left, table, visited) || expr_mutates_self(sname, b.right, table, visited)
        parser::Unary as u => expr_mutates_self(sname, u.operand, table, visited)
        parser::Compare as cmp => expr_mutates_self(sname, cmp.first, table, visited) || cmpterms_mutate_self(sname, cmp.rest, table, visited)
        parser::FieldAccess as fa => expr_mutates_self(sname, fa.receiver, table, visited)
        parser::Index as ix => expr_mutates_self(sname, ix.receiver, table, visited) || expr_mutates_self(sname, ix.index, table, visited)
        parser::Cast as ct => expr_mutates_self(sname, ct.expr, table, visited)
        parser::IfExpr as iff => expr_mutates_self(sname, iff.cond, table, visited) || stmts_mutate_self(sname, iff.then_blk, table, visited) || stmts_mutate_self(sname, iff.else_blk, table, visited)
        parser::MatchExpr as mx => expr_mutates_self(sname, mx.subject, table, visited) || arms_mutate_self(sname, mx.arms, table, visited)
        parser::StructLit as sl => exprs_mutate_self(sname, sl.field_vals, table, visited)
        parser::ArrayLit as al => arrayelems_mutate_self(sname, al.elements, table, visited)
        parser::Interp as ip => exprs_mutate_self(sname, ip.holes, table, visited)
        parser::InExpr as ie => expr_mutates_self(sname, ie.lhs, table, visited) || exprs_mutate_self(sname, ie.elems, table, visited)
        parser::Borrow as bo => expr_mutates_self(sname, bo.operand, table, visited)
        parser::Block as blk => stmts_mutate_self(sname, blk.body, table, visited)
        parser::Lambda as lm => stmts_mutate_self(sname, lm.body, table, visited)
        _ => false
    }
}

/**
 * cmpterms_mutate_self — does any continuation term of a `Compare` chain carry a mutating self-call?
 *
 * @param sname    the declaring type's name
 * @param ts       the comparison continuation terms
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff some term mutates self
 * @since item-14
 */
fn cmpterms_mutate_self(sname: str, ts: []parser::CmpTerm, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= ts.len { break }
        if expr_mutates_self(sname, ts[i].operand, table, visited) { return true }
        i++
    }
    false
}

/**
 * arrayelems_mutate_self — does any array-literal element expression carry a mutating self-call?
 *
 * @param sname    the declaring type's name
 * @param els      the array elements
 * @param table    the folded type table
 * @param visited  the transitive-call visited set
 * @return         true iff some element mutates self
 * @since item-14
 */
fn arrayelems_mutate_self(sname: str, els: []parser::ArrayElem, table: TypeTable, visited: []str): bool {
    var i = 0 to u64
    loop {
        if i >= els.len { break }
        if expr_mutates_self(sname, els[i].expr, table, visited) { return true }
        i++
    }
    false
}

/**
 * struct_is_readonly_named — is `sname` a `readonly struct` (§13.3)? True only for a StructBody whose
 * whole-struct readonly flag is set; false for any other type or an unknown name.
 *
 * @param sname  the type name
 * @param table  the folded type table
 * @return       true iff `sname` names a readonly struct
 * @since item-14
 */
fn struct_is_readonly_named(sname: str, table: TypeTable): bool {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return false }
    match decl.body { parser::StructBody as sb => sb.is_readonly; _ => false }
}

/**
 * receiver_is_immutable_target — is the receiver EXPRESSION of a method call an immutable target
 * (§13.2)? True for a value on which a mutating method must be rejected: a literal / temporary (its
 * lvalue chain roots at no binding), or a value whose STATIC type is a `readonly struct` (ruling 11).
 * Under §13.1 a plain `var` local is mutable, so an ordinary struct receiver returns false and the
 * call is admitted.
 *
 * @param recv   the untyped receiver expression
 * @param rt     the receiver's resolved type
 * @param env    the typing environment
 * @param table  the folded type table (for the readonly-struct test)
 * @return       true iff a mutating method call on this receiver must be rejected
 * @since item-14
 */
fn receiver_is_immutable_target(recv: parser::Expr, rt: Type, env: Env, table: TypeTable): bool {
    if !lvalue_root(recv).reachable { return true }
    match rt {
        Named as n => struct_is_readonly_named(n.name, table)
        _ => false
    }
}

fn type_method_call(mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var recv_t = match type_expr(mc.receiver, env, table) { TExpr as te => te.type; error as e => return e }
    if is_flags_named(recv_t, table) && !flags_named_has_user_method(recv_t, mc.method, table) {
        return type_flags_method(mc, env, table)
    }
    match recv_t {
        Variant => if variant_has_null_member(recv_t) { return require_narrowed(recv_t) }
        _ => { }
    }
    var struct_name = match recv_t { Named as n => n.name; _ => return error { message = "method typing is deferred (B.29 / M.4)" } }
    var decl = match type_table_find(table, struct_name, "") { parser::TypeDecl as td => td; error => return error { message = "method typing is deferred (B.29 / M.4)" } }
    match type_param_call_error(decl, table) { error as e => return e; null => { } }
    match decl.body {
        parser::InterfaceBody as ib => return type_contract_dispatch(ib, struct_name, mc, env, table)
        parser::TraitBody as tb => return type_contract_dispatch(parser::InterfaceBody { extends = teko::list::empty(); methods = tb.methods }, struct_name, mc, env, table)
        _ => { }
    }
    // (W10b.CLASS increment 1) a class's instance dot-call reuses this SAME desugar — only the
    // methods list's source differs; a class's methods are otherwise typed exactly like a struct's.
    var methods = match decl.body {
        parser::StructBody as sb => sb.methods
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error as e => return e }   // (W10b.CLASS increment 2) inherited methods are callable too
        parser::NewtypeBody as nb => nb.methods
        parser::EnumBody as eb => eb.methods
        parser::FlagsBody as fb => fb.methods
        _ => return error { message = "method typing is deferred (B.29 / M.4)" }
    }
    if methods.len == 0 { return error { message = $"no such method '{mc.method}' on struct '{struct_name}'" } }
    var mi: u64 = 0
    var found = false
    var mfn = methods[0]   // placeholder; overwritten below iff `found` (Teko has no uninitialized values)
    loop {
        if mi >= methods.len { break }
        if methods[mi].name == mc.method { found = true; mfn = methods[mi]; break }
        mi++
    }
    if !found { return error { message = $"no such method '{mc.method}' on struct '{struct_name}'" } }
    var is_instance = mfn.params.len > 0 && !mfn.params[0].has_type
    if !is_instance { return error { message = $"'{mc.method}' is a static method — call it as {struct_name}::{mc.method}(…)" } }
    match decl.body {
        parser::StructBody => {
            if method_mutates_self(struct_name, mfn, table) && receiver_is_immutable_target(mc.receiver, recv_t, env, table) {
                return error { message = $"cannot call mutating method `{mc.method}` on an immutable `{struct_name}` — the receiver is a literal or a `readonly struct` (§13.2)" }
            }
        }
        _ => { }
    }
    // (W10b.CLASS residual — intern visibility) a private (default) method is reachable only
    // from its OWN declaring class's code, or — if `intern` — a subclass's too. Struct methods
    // stay all-public (W10b.0.A) — this check only fires for a ClassBody receiver.
    match decl.body {
        parser::ClassBody => {
            var owner = match find_method_owner(struct_name, table, mc.method) { MemberOwner as mo => mo; error as e => return e }
            if !member_accessible(owner, env.owner_type, table) {
                return error { message = $"method '{mc.method}' is private to {owner.declaring_class}" }
            }
        }
        _ => { }
    }
    // (#98) VIRTUAL DISPATCH through a POLYMORPHIC-BASE-typed receiver. When the receiver's STATIC
    // type is a `virtual`/`abstract` class, the value may hold a subclass, so the call dispatches
    // dynamically through the base's vtable — exactly the D3 mechanism, keyed on the base class as
    // the "contract". The slot is the method's index in the base's EFFECTIVE method list (the same
    // order codegen's `tk_vt_<Sub>_<Base>` build uses). The receiver rides args[0]; both engines
    // resolve the CONCRETE override (interpreter by the payload's class name, native via the vtable slot).
    // A `sealed` class is never a base — is_polymorphic_base filters it — so its calls stay direct.
    match decl.body {
        parser::ClassBody as bcb => {
            if is_polymorphic_base(struct_name, table) {
                var slot_res = base_vtable_slot(struct_name, mc.method, table)
                match slot_res {
                    u32 as bslot => {
                        var bft = match method_func_type(mfn, struct_name, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the call's enclosing namespace
                        var bf = match bft { Func as ff => ff; _ => return error { message = "internal: base method signature is not a function type" } }
                        var bcargs: []parser::Expr = teko::list::push(teko::list::empty(), mc.receiver)
                        var bai: u64 = 0
                        loop { if bai >= mc.args.len { break }; bcargs = teko::list::push(bcargs, mc.args[bai]); bai++ }
                        var bcnames: []str = method_call_arg_names(mc)
                        var bdargs = match resolve_call_args(bf, bcargs, bcnames, env, table) { []parser::Expr as x => x; error as e => return e }
                        if bdargs.len != bf.params.len { return error { message = "wrong number of arguments" } }
                        var biargs: []TExpr = teko::list::empty()
                        var bii: u64 = 0
                        loop {
                            if bii >= bdargs.len { break }
                            var ba = match type_expr(bdargs[bii], env, table) { TExpr as te => te; error as e => return e }
                            if type_is_void(ba.type) { return error { message = "a `void` expression cannot be passed as an argument (M.1)" } }
                            var bpt = bf.params[bii]
                            ba = match coerce_argument_into(ba, bpt, table) { TExpr as x => x; error as e => return e }
                            biargs = teko::list::push(biargs, ba)
                            bii++
                        }
                        var bseg_base = parser::Segment { name = struct_name }   // the base class — the vtable key
                        var bseg_m = parser::Segment { name = mc.method }
                        var bsegs: []parser::Segment = teko::list::push(teko::list::empty(), bseg_base)
                        bsegs = teko::list::push(bsegs, bseg_m)
                        return TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = bsegs }; args = biargs; call_ns = ""; is_closure_call = false; callee_type = bft; is_iface_dispatch = true; iface_slot = bslot; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = bf.ret; line = 0; col = 0 }
                    }
                    error => { }   // method not in the base vtable → fall through to the direct desugar (a NEW own method reachable only when receiver is statically the base)
                }
            }
        }
        _ => { }
    }
    var segs = method_dispatch_callee(struct_name, mc.method).segments
    var cargs: []parser::Expr = teko::list::push(teko::list::empty(), mc.receiver)
    var ai: u64 = 0
    loop { if ai >= mc.args.len { break }; cargs = teko::list::push(cargs, mc.args[ai]); ai++ }
    var cnames: []str = method_call_arg_names(mc)
    type_call(parser::Call { callee = parser::Path { segments = segs }; args = cargs; arg_names = cnames; owner_type_args = teko::list::empty(); callee_type_args = mc.type_args }, env, table)
}

/**
 * struct_iface_named_stop — the located, named honest-stop for a STRUCT value used where an
 * interface (or trait) VALUE is required. Returns the diagnostic error when `from` is a struct
 * that nominally conforms to the contract `to` yet cannot up-cast into it (a struct has no stable
 * address to back a fat pointer, resolve.tks:785); returns null otherwise, so a class `from` and a
 * non-conforming `from` fall through to the caller's generic mismatch. The interface-value boxing
 * of a struct is deferred to the safety spine (docs/design/interface-value-type.md §4) — this only
 * NAMES the gap and points the user at the two surfaces that DO dispatch a struct's contract.
 *
 * @param from   the source (value) type at a widen/assign/arg site
 * @param to     the destination (expected) contract type
 * @param table  the program's type table (conformance + kind probes)
 * @return       the located `err_typed` honest-stop, or null when the gap does not apply
 * @see          struct_conforms_but_not_class — the predicate this diagnoses
 * @since 0.3.0.29 interface-value keystone
 */
fn struct_iface_named_stop(from: Type, to: Type, table: TypeTable): error | null {
    if !struct_conforms_but_not_class(from, to, table) { return null }
    teko::error::err_typed(error { message = "a `struct` value cannot be used as the interface `<Iface>` — a struct has no stable address to dispatch through. Make the implementer a `class` (`type T = class & <Iface>`), or take it by a generic contract-bound parameter (`fn f<T: <Iface>>(x: T)`), which dispatches statically. (interface-value boxing of a struct is deferred to the safety spine — docs/design/interface-value-type.md §4)" }, type_render(to), type_render(from))
}

/**
 * (W10b.D2/D3 / TR1) Type a dynamic contract-method dot-call `recv.method(args)` on an INTERFACE or
 * TRAIT receiver: resolve `method` to its dispatch contract + vtable slot, type the receiver + args
 * against the contract's effective signature (defaults live on the contract, DEFARGS rule E), and
 * emit an `is_iface_dispatch` TCall keyed off the real contract name (the vtable/upcast key). A
 * trait passes an InterfaceBody VIEW (`extends = []`, `methods = the trait's own method list`), so
 * this one routine serves both contract kinds (a trait value IS a contract value — W10b.D3 reuse).
 *
 * @param ib          the contract's InterfaceBody (a trait's is a synthesized view)
 * @param struct_name the resolved receiver contract name (the dispatch key)
 * @param mc          the method-call AST node (receiver + method + args)
 * @param env         the typing environment
 * @param table       the folded type table
 * @return the typed dynamic-dispatch TCall
 * @throws when the method is not on the contract, arity/types mismatch, or a signature fails to resolve
 */
fn type_contract_dispatch(ib: parser::InterfaceBody, struct_name: str, mc: parser::MethodCall, env: Env, table: TypeTable): TExpr | error {
    var dispatch = match resolve_iface_dispatch(ib, struct_name, mc.method, table) { IfaceDispatch as d => d; error as e => return e }
    var iface_canon = dispatch.iface
    var imfn = dispatch.method
    var slot = dispatch.slot
    var ift = match method_func_type(imfn, struct_name, table, env.cur_ns) { Type as t => t; error as e => return e }
    var f = match ift { Func as ff => ff; _ => return error { message = "internal: interface method signature is not a function type" } }
    var icargs: []parser::Expr = teko::list::push(teko::list::empty(), mc.receiver)
    var ica: u64 = 0
    loop { if ica >= mc.args.len { break }; icargs = teko::list::push(icargs, mc.args[ica]); ica++ }
    var icnames: []str = method_call_arg_names(mc)
    var dargs = match resolve_call_args(f, icargs, icnames, env, table) { []parser::Expr as x => x; error as e => return e }
    if dargs.len != f.params.len { return error { message = "wrong number of arguments" } }
    var iargs: []TExpr = teko::list::empty()
    var ii: u64 = 0
    loop {
        if ii >= dargs.len { break }
        var a = match type_expr(dargs[ii], env, table) { TExpr as te => te; error as e => return e }
        if type_is_void(a.type) { return error { message = "a `void` expression cannot be passed as an argument (M.1)" } }
        var pt = f.params[ii]
        a = match coerce_argument_into(a, pt, table) { TExpr as x => x; error as e => return e }
        iargs = teko::list::push(iargs, a)
        ii++
    }
    var seg_iface = parser::Segment { name = iface_canon }
    var seg_m = parser::Segment { name = mc.method }
    var isegs: []parser::Segment = teko::list::push(teko::list::empty(), seg_iface)
    isegs = teko::list::push(isegs, seg_m)
    TExpr { kind = TCall { overload_suffix = ""; callee = parser::Path { segments = isegs }; args = iargs; call_ns = ""; is_closure_call = false; callee_type = ift; is_iface_dispatch = true; iface_slot = slot; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = f.ret; line = 0; col = 0 }
}

/**
 * A single-segment path wrapping `name` (`Cell` → `Path{[Cell]}`) — the minimal path for resolving a
 * construction-site base type through `resolve_type` (#254 L5).
 *
 * @param name  the single segment name
 * @return      a one-segment path
 * @since onda-3 (#254 L5)
 */
fn single_seg_path(name: str): parser::Path {
    parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) }
}

/**
 * A copy of `p` with the segment at position `idx` renamed to `name` (`Cell::make`, idx 0 → `X`,
 * yields `X::make`) — the positional twin of `rewrite_last_segment` (#254 L5). Used to rewrite a
 * generic static call's OWNER segment (the second-to-last) to the mangled instance name.
 *
 * @param p     the path to rewrite
 * @param idx   the segment position to rename
 * @param name  the new segment name
 * @return      `p` with segment `idx` renamed
 * @since onda-3 (#254 L5)
 */
fn rewrite_segment_at(p: parser::Path, idx: u64, name: str): parser::Path {
    var segs: []parser::Segment = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= p.segments.len { break }
        if i == idx { segs = teko::list::push(segs, parser::Segment { name = name }) }
        else { segs = teko::list::push(segs, p.segments[i]) }
        i++
    }
    parser::Path { segments = segs }
}

/**
 * Retarget a static-call callee that carries OWNER-TYPE type-args (`Cell<i64>::make(…)`) to the
 * mangled generic-instance owner (`Cell__g__i64::make`), so `lookup_call` resolves the stamped factory
 * `register_instance_methods` registered (#254 L5). Resolves the `owner_type_args` (the `<…>` on the
 * TYPE before `::`) to concrete types, mangles the base (the callee's SECOND-TO-LAST segment) via
 * `generic_inst_name`, and rewrites that segment. A call with no owner type-args (or a single-segment
 * callee) passes through unchanged → byte-identical for every existing call. Any explicit METHOD
 * type-args (`callee_type_args`) are NOT consumed here — they bind the factory method's own params
 * downstream (`Map<str,i64>::fold<Acc>()`).
 *
 * @param c      the parsed static call (carrying owner_type_args)
 * @param table  the folded type table (arg resolution)
 * @param ref_ns the call's enclosing namespace
 * @return       the callee path with the owner segment mangled to the instance, or `c.callee` verbatim
 * @throws       when an owner type-arg fails to resolve
 * @since onda-3 (#254 L5)
 */
fn retarget_generic_static_callee(c: parser::Call, table: TypeTable, ref_ns: str): parser::Path | error {
    if c.owner_type_args.len == 0 || c.callee.segments.len < 2 { return c.callee }
    var owner_idx = c.callee.segments.len - 2
    var owner_name = c.callee.segments[owner_idx].name
    var nt = parser::NamedType { path = single_seg_path(owner_name); args = c.owner_type_args }
    var rt = match resolve_type(nt, table, ref_ns) { Type as t => t; error as e => return e }
    var inst = match rt { Named as n => n.name; _ => return c.callee }
    rewrite_segment_at(c.callee, owner_idx, inst)
}

/**
 * Does a call's callee carry a QUALIFIER the injected-builtin dispatch (`builtin_fn`) is entitled to
 * resolve through (0.3.1.0 qualifier validation, `docs/memory/colisao-use-str-0.3.1.md`)? `builtin_fn`
 * itself matches by LAST segment only, discarding everything before it; this predicate is the gate a
 * caller applies AFTER a `builtin_fn` match succeeds, so the qualifier the user actually wrote gets a
 * say. It mirrors the ONLY two forms `emit_call`/`emit_host_ffi` (`src/codegen/codegen.tks`) know how
 * to lower a builtin call from — a BARE name (`concat(...)`, one segment) or a path literally ROOTED
 * at `teko` (`teko::str::concat(...)`, `teko::env::var(...)`, any depth) — so the checker never signs
 * off on a spelling the codegen cannot honour. Any OTHER qualifier is rejected by the caller: a real
 * namespace missing its `teko::` root (`str::concat`, `env::var`), an invented one
 * (`bogus_namespace::str`), or a `use`-declared alias (`tstr::concat` via `use teko::str as tstr` —
 * `use` is a checker no-op for value-level references today, so an alias can never be a legal builtin
 * qualifier; teaching it to resolve is a separate, larger increment, deliberately out of scope here).
 *
 * @param callee  the call's callee path
 * @return        true iff `callee` is bare or `teko`-rooted — the two forms codegen can lower
 */
fn builtin_qualifier_ok(callee: parser::Path): bool {
    callee.segments.len == 1 || callee.segments[0].name == "teko"
}

/**
 * Builds the diagnostic for a call whose LAST segment names an injected builtin (`builtin_fn`
 * matched) but whose qualifier `builtin_qualifier_ok` rejected. Names both what was written and what
 * the two legal forms are, so a typo'd or invented namespace — or a `use`-declared alias, which does
 * NOT make a builtin callable under its short name today — reads as a namespace problem rather than a
 * mysterious "unknown function".
 *
 * @param callee  the offending call's callee path
 * @param name    the callee's last segment (the builtin name that WOULD have matched)
 * @return        the positioned diagnostic
 */
fn unresolved_builtin_qualifier_error(callee: parser::Path, name: str): error {
    var qualifier = path_qualifier(callee, callee.segments.len - 1)
    error { message = $"unknown function: {path_str(callee)} — `{qualifier}` is not a recognized namespace; the built-in `{name}` is called bare (`{name}(...)`) or fully qualified rooted at `teko::` (`teko::...::{name}(...)`)" }
}

/**
 * Types a call expression: resolves the callee (a builtin, a same/qualified-namespace function, or
 * a local closure value), types every argument against the resolved signature — widening (B.14),
 * literal-adoption (C6), generic type-param inference (S4), AUTO-REF (a `mut` lvalue passed where a
 * `ref<T>` param is expected), and transparent auto-deref (0.3.1 — a `ref`-typed argument that does
 * NOT already satisfy the parameter directly peels one `Reference` layer via `deref_ref_value`, so a
 * `ref` binding is usable bare as a call argument, no `.value`; a `ref`-typed argument that already
 * widens as-is — forwarding into a `ref T` param, or into a `ref T | null` union, the null-union R2
 * relaxation — is left alone, never derefed away from a shape that already fits) — and produces the
 * typed `TCall`.
 *
 * @param c0     the untyped call node (post generic-static-callee retargeting if type-args are given)
 * @param env    the typing environment (bindings + current namespace)
 * @param table  the resolved type table (signatures, decls, generics)
 * @return       the typed call expression, its type the callee's resolved return type
 * @throws       an unknown callee, an arity/type mismatch, or an uninferable generic type-param
 */
/**
 * overload_members_funcs — the `Func` signatures of every global function sharing exactly `(ns, name)`
 * (the members of an overload set), extracted from `overload_func_bindings`. The `members` input to
 * `overload_suffix_of`, used identically on the definition side and the call side.
 *
 * @param env   the SEALED typing environment
 * @param ns    the exact declaring namespace
 * @param name  the exact bare name
 * @return      the members' function signatures, in ascending base position
 * @since §9 A
 */
fn overload_members_funcs(env: Env, ns: str, name: str): []Func {
    var bs = overload_func_bindings(env, ns, name)
    var out: []Func = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= bs.len { break }
        match bs[i].type { Func as f => out = teko::list::push(out, f); _ => { } }
        i++
    }
    out
}

/**
 * overload_suffix_for_binding — the §9 A symbol suffix for the CHOSEN call-site candidate `b`,
 * computed over the members of `b`'s exact `(ns, name)` set. "" when `b` is a value/non-function or
 * the sole declaration — keeping the historic unsuffixed symbol (ruling 6 / fixpoint).
 *
 * @param env  the SEALED typing environment
 * @param b    the winning candidate binding (`select_overload`)
 * @return     the suffix to stamp on the `TCall`, "" when `b` is not part of an overload set
 * @since §9 A
 */
fn overload_suffix_for_binding(env: Env, b: ValBinding): str {
    match b.type {
        Func as f => overload_suffix_of(f, overload_members_funcs(env, b.ns, b.name))
        _ => ""
    }
}

/**
 * build_overload_sig — reconstruct the resolved `Func` signature of a typed function DECLARATION from
 * its parameter annotations, for the definition-side overload suffix. Resolves each parameter's
 * syntactic type against `ns` with the SAME `resolve_type` the collector used, so the rebuilt
 * parameter types are byte-equal to the collected binding's — which is what makes the definition
 * symbol match the call symbol. `ret`/`n_required`/`defaults` are placeholders (the suffix ignores
 * them). Only ever reached for a real overload set (`overload_suffix_for_decl` gates on
 * `env_is_overloaded` first).
 *
 * @param tf     the typed function whose signature is rebuilt
 * @param ns     the declaring namespace to resolve parameter types against
 * @param table  the resolved type table
 * @return       the reconstructed signature, or an error if a parameter type does not resolve
 * @throws       when a parameter's type annotation fails to resolve under `ns`
 * @since §9 A
 */
fn build_overload_sig(tf: TFunction, ns: str, table: TypeTable): Func | error {
    var ptypes: []Type = teko::list::empty()
    var pnames: []str = teko::list::empty()
    var variadic = false
    var i: u64 = 0
    loop {
        if i >= tf.params.len { break }
        var pt = match resolve_type(tf.params[i].type_ann, table, ns) { Type as t => t; error as e => return e }
        ptypes = teko::list::push(ptypes, pt)
        pnames = teko::list::push(pnames, tf.params[i].name)
        if tf.params[i].is_params { variadic = true }
        i++
    }
    Func { params = ptypes; ret = tf.return_type; variadic = variadic; param_names = pnames; n_required = 0; defaults = teko::list::empty(); ret_extra = teko::list::empty() }
}

/**
 * overload_suffix_for_decl — the §9 A symbol suffix for a function DEFINITION `tf` declared as
 * `(ns, name)`. "" unless `(ns, name)` is a real overload set (`env_is_overloaded`) — so every
 * function in a program with no overload set keeps its historic unsuffixed symbol byte-for-byte
 * (ruling 6 / fixpoint). Otherwise reconstructs `tf`'s signature and mangles it over the set's members,
 * exactly as the call side mangles the chosen candidate, so definition and call agree.
 *
 * @param env    the SEALED typing environment
 * @param ns     the function's declaring namespace
 * @param name   the function's bare name
 * @param tf     the typed function
 * @param table  the resolved type table
 * @return       the suffix to stamp on the `TFunction`, "" when not part of an overload set
 * @since §9 A
 */
fn overload_suffix_for_decl(env: Env, ns: str, name: str, tf: TFunction, table: TypeTable): str {
    if !env_is_overloaded(env, ns, name) { return "" }
    match build_overload_sig(tf, ns, table) {
        Func as f => overload_suffix_of(f, overload_members_funcs(env, ns, name))
        error => ""
    }
}

/**
 * overload_suffix_for_method — the §9 A symbol suffix for a METHOD DEFINITION, the receiver-aware twin
 * of `overload_suffix_for_decl`. A method carries an IMPLICIT untyped receiver param (`self`), which
 * `build_overload_sig`'s plain `resolve_type` cannot resolve — so it reconstructs the method's full
 * signature through `method_func_type` (the SAME resolver `collect` used to register the binding),
 * which maps the receiver to the owner type. The rebuilt `this` therefore mangles byte-identically to
 * the call-side candidate (`overload_members_funcs`), so an overloaded method's DEFINITION and its call
 * agree on the suffixed symbol (without this, both overloads emit the bare symbol and cc rejects the
 * duplicate). "" unless `(method_ns, name)` is a real overload set — so a non-overloaded method keeps
 * its historic unsuffixed symbol (ruling 6 / fixpoint).
 *
 * @param env        the SEALED typing environment
 * @param method_ns  the method's pseudo-namespace (`<owner-ns>::<Type>`)
 * @param m          the method's parsed declaration (its receiver + operand annotations)
 * @param owner_bare the owning type's bare name (for `self` resolution)
 * @param ref_ns     the owning type's declaring namespace (for annotation resolution)
 * @param table      the resolved type table
 * @return           the suffix to stamp on the method's `TFunction`, "" when not an overload set
 * @since §9 A (§9-ops method-overload emission)
 */
fn overload_suffix_for_method(env: Env, method_ns: str, m: parser::Function, owner_bare: str, ref_ns: str, table: TypeTable): str {
    if !env_is_overloaded(env, method_ns, m.name) { return "" }
    var ft = match method_func_type(m, owner_bare, table, ref_ns) { Type as t => t; error => return "" }
    match ft {
        Func as f => overload_suffix_of(f, overload_members_funcs(env, method_ns, m.name))
        _ => ""
    }
}

/**
 * select_overload — choose exactly ONE overload of the call `c` from the candidate bindings `cands`,
 * at the call site, in compile time (rulings 2/3). Each candidate that is a function is scored: its
 * call SHAPE must bind (`resolve_defargs`/`pack_variadic_args` — this is where a named/default argument
 * discriminates by PARAMETER NAME, ruling 5), and every argument must FIT its parameter
 * (`type_value_expected`, the same rule an ordinary call applies, so a bare literal may adopt a narrow
 * parameter). Survivors split into two TIERS: EXACT (every argument's plain type is `type_eq` to its
 * parameter) and WIDENED (fits only by implicit widening / literal adoption). An exact-tier singleton
 * wins outright; otherwise the highest non-empty tier decides, and more than one there is a call-site
 * ambiguity (ruling 3). A one-candidate set is never scored — the caller only reaches here for a real
 * overload set.
 *
 * @param cands  the candidate bindings (`lookup_call_candidates`)
 * @param c      the untyped call node (its args + arg-names drive the shape/type scoring)
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the chosen binding, or a located ambiguity / no-match error
 * @throws       when 0 candidates fit, or >1 fit with no unique best
 * @since §9 A
 */
fn select_overload(cands: []ValBinding, c: parser::Call, env: Env, table: TypeTable): ValBinding | error {
    var name = c.callee.segments[c.callee.segments.len - 1].name
    var exacts: []ValBinding = teko::list::empty()
    var widens: []ValBinding = teko::list::empty()
    var ci: u64 = 0
    loop {
        if ci >= cands.len { break }
        var cb = cands[ci]
        ci++
        match cb.type {
            Func as f => {
                var shaped = resolve_call_args(f, c.args, c.arg_names, env, table)
                match shaped {
                    []parser::Expr as dargs => {
                        if dargs.len == f.params.len {
                            var fits = true
                            var exact = true
                            var j: u64 = 0
                            loop {
                                if j >= dargs.len { break }
                                match type_expr(dargs[j], env, table) {
                                    TExpr as plain => {
                                        if type_is_void(plain.type) { fits = false; break }
                                        match type_value_expected(dargs[j], f.params[j], env, table) {
                                            TExpr as fa => {
                                                if !assignable_to(fa.type, f.params[j], table) { fits = false; break }
                                                if !type_eq(plain.type, f.params[j]) { exact = false }
                                            }
                                            error => { fits = false; break }
                                        }
                                    }
                                    error => { fits = false; break }
                                }
                                j++
                            }
                            if fits {
                                if exact { exacts = teko::list::push(exacts, cb) } else { widens = teko::list::push(widens, cb) }
                            }
                        }
                    }
                    error => { }
                }
            }
            _ => { }
        }
    }
    if exacts.len == 1 { return exacts[0] }
    if exacts.len >= 2 { return error { message = $"ambiguous call to overloaded '{name}': {exacts.len} candidates match with an exact signature — disambiguate with an explicit cast (e.g. `x to T`)" } }
    if widens.len == 1 { return widens[0] }
    if widens.len >= 2 { return error { message = $"ambiguous call to overloaded '{name}': {widens.len} candidates match by implicit widening — disambiguate with an explicit cast (e.g. `x to T`)" } }
    error { message = $"no matching overload for '{name}' with the given argument types" }
}

/**
 * reject_multivalue_in_value_position — honest-stops when a MULTIPLE-return call surfaces where only a
 * single value fits (§9 F, ruling 3: `var t = div(…)` does not exist). A multi-valued call is legal
 * ONLY as the sole RHS of a positional `MultiBind` (`var q, r = div(…)`) or a matched-arity
 * `return (…)`; everywhere else (a call argument, an array element, an operand, a plain `var t = …`)
 * it is an error, because no tuple type can hold it.
 *
 * @param call  the freshly typed call node
 * @return      null when the call is single-valued; otherwise the localized error
 * @since §9 F
 */
fn reject_multivalue_in_value_position(call: TCall): error | null {
    if call.ret_extra.len > 0 {
        return error { message = "a multiple-return call is valid only as the sole right-hand side of a `var …, … = …` binding or of a matched `return` — there is no tuple value" }
    }
    return null
}

fn type_call(c0: parser::Call, env: Env, table: TypeTable): TExpr | error {
    // Explicit call-site type-args live in TWO INDEPENDENT positions the parser recorded separately, so
    // there is no guessing:
    //   • `owner_type_args` — the `<…>` on the TYPE before `::` (`List<i64>::make`, `Map<str,i64>::fold`):
    //     they bind the OWNER TYPE's params, and the factory callee is retargeted to the mangled instance
    //     owner (`List<i64>::make` → `List__g__i64::make`) — unchanged pre-existing behavior.
    //   • `callee_type_args` — the `<…>` on the FUNCTION/METHOD (`foo<T>()`, `ns::foo<T>()`, `Type::m<T>()`,
    //     `Type<A>::m<B>()`, and — via the method desugar — `recv.m<T>()`): they bind the CALLEE's own
    //     type-params (the explicit-fn path).
    // The two are wholly separate and may coexist (`Map<str,i64>::fold<Acc>()`): the type args retarget the
    // owner, the method args bind `fold`. Both are empty for an ordinary (bare/inferred) call.
    // Shared generic-arity guard (owner ruling): at most `max_generic_arity()` explicit type-args in
    // EITHER position — the owner `<…>` (`Type<…>::m`) or the callee `<…>` (`m<…>()`).
    if c0.owner_type_args.len > max_generic_arity() || c0.callee_type_args.len > max_generic_arity() {
        return error { message = "at most 16 explicit type arguments" }
    }
    var explicit_fn_args: []parser::TypeExpr = c0.callee_type_args
    var c = c0
    if c0.owner_type_args.len > 0 {
        var rc = match retarget_generic_static_callee(c0, table, env.cur_ns) { parser::Path as p => p; error as e => return e }
        c = parser::Call { callee = rc; args = c0.args; arg_names = c0.arg_names; owner_type_args = c0.owner_type_args; callee_type_args = c0.callee_type_args }
    }
    match type_list_builtin(c, env, table) {   // teko::list::empty / push (generic)
        TExpr as te => return te
        error as e => return e
        NotListBuiltin => { }   // not a list builtin → fall through to the ordinary call
    }
    match type_ptr_unwrap(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotPtrOp => { }
    }
    match type_svc(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotSvcOp => { }
    }
    match type_has_svc(c, env, table) {
        TExpr as te => return te
        error as e => return e
        NotSvcOp => { }
    }
    var name = c.callee.segments[c.callee.segments.len - 1].name
    // panic / exit — injected GLOBAL diverging builtins (legislator's ruling — NO `never` type).
    // panic(error | str) = the message; exit(<integer>) = the status code. Both terminate the
    // program; the call's STATIC type is void, but texpr_diverges accepts it in any value position.
    // Fire ONLY when the namespace-aware lookup finds nothing — so the runtime's own `fn panic`
    // resolves to ITSELF (below) while every other namespace gets the injected global (#41).
    var in_scope = match lookup_call(env, c.callee) { Type => true; error => false }
    var teko_rooted = c.callee.segments.len == 2 && c.callee.segments[0].name == "teko"   // reserved-root `teko::exit`/`teko::panic`
    if (c.callee.segments.len == 1 || teko_rooted) && !in_scope {
        if name == "panic" {
            if c.args.len != 1 { return error { message = "panic expects one argument (an `error` or a `str`)" } }
            var a = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
            var ok = match a.type { Str => true; Error => true; _ => false }
            if !ok { return error { message = "panic's argument must be an `error` or a `str`" } }
            var pargs = teko::list::push(teko::list::empty(), a)
            return TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = pargs; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Void { }; line = 0; col = 0 }
        }
        if name == "exit" {
            if c.args.len != 1 { return error { message = "exit expects one argument (an integer status code)" } }
            var a = match type_expr(c.args[0], env, table) { TExpr as te => te; error as e => return e }
            var ok = match a.type { Prim as p => prim_is_int(p.kind); _ => false }
            if !ok { return error { message = "exit's argument must be an integer status code" } }
            var eargs = teko::list::push(teko::list::empty(), a)
            return TExpr { kind = TCall { overload_suffix = ""; callee = c.callee; args = eargs; call_ns = ""; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = Void { }; line = 0; col = 0 }
        }
    }
    var resolved_ns = match lookup_call(env, c.callee) { Type => call_ns(env, c.callee); error => "" }
    var ft = match lookup_call(env, c.callee) {
        Type as t => t
        error => match builtin_fn(name) {
            Type as t => {
                if !builtin_qualifier_ok(c.callee) { return unresolved_builtin_qualifier_error(c.callee, name) }
                t
            }
            error => return error { message = $"unknown function: {name}" }
        }
    }
    var ov_suffix = ""
    if in_scope && env_is_overloaded(env, resolved_ns, name) {
        var wb = match select_overload(lookup_call_candidates(env, c.callee), c, env, table) { ValBinding as b => b; error as e => return e }
        ft = wb.type
        resolved_ns = wb.ns
        ov_suffix = overload_suffix_for_binding(env, wb)
    }
    // (W10b.CLASS residual — intern visibility) a STATIC call (`ClassName::method(…)`) is
    // reachable under the SAME rule as an instance dot-call — check it here too, routed through
    // the resolved method namespace. `resolved_ns` names a real class only for a class(-static-
    // or -instance-called-as-static) method; any other qualified/unqualified call (an ordinary
    // namespaced function) leaves this a silent no-op (find_class_body errors → skipped).
    if resolved_ns != "" {
        match find_class_body(class_name_from_method_ns(resolved_ns), table) {
            parser::ClassBody => {
                var owner = match find_method_owner(class_name_from_method_ns(resolved_ns), table, name) { MemberOwner as mo => mo; error as e => return e }
                if !member_accessible(owner, env.owner_type, table) {
                    return error { message = $"method '{name}' is private to {owner.declaring_class}" }
                }
            }
            error => { }
        }
    }
    match ft {
        Func as f => {
            var dargs = match resolve_call_args(f, c.args, c.arg_names, env, table) { []parser::Expr as x => x; error as e => return e }
            if dargs.len != f.params.len { return error { message = "wrong number of arguments" } }
            // Type every argument first (void rejected); strict-check / generic-infer below.
            var targs: []TExpr = teko::list::empty()
            var ti = 0
            loop {
                if ti >= dargs.len { break }
                // (W10) a closure-literal ARG whose parameter is a concrete function type infers its
                // un-annotated params from that target (ruling 3); other args type normally.
                var is_lam = match dargs[ti].kind { parser::Lambda => true; _ => false }
                var pt_is_func = match f.params[ti] { Func => true; _ => false }
                // (W10b.D3) an ARRAY-literal ARG under a `[]<interface>` param types against the
                // contract element too (heterogeneous `[]Shape` args), like the binding-annotation path.
                var is_arr = match dargs[ti].kind { parser::ArrayLit => true; _ => false }
                var iface_arr_target = is_arr && is_iface_slice(f.params[ti], table)
                var is_dot_arg = expr_is_dot_construction(dargs[ti])
                var a = if (is_lam && pt_is_func) || iface_arr_target || is_dot_arg || arg_wants_expected(dargs[ti], f.params[ti]) {
                    match type_value_expected(dargs[ti], f.params[ti], env, table) { TExpr as te => te; error as e => return e }
                } else {
                    match type_expr(dargs[ti], env, table) { TExpr as te => te; error as e => return e }
                }
                if type_is_void(a.type) { return error { message = "a `void` expression cannot be passed as an argument (M.1)" } }
                targs = teko::list::push(targs, a)
                ti++
            }
            // (S4) GENERIC callee — the sig carries type-param Named's: INFER the type-params from the
            // arg types and substitute into the return type for the call's result. The monomorph pass
            // (post-typer) stamps the concrete instance and rewrites the callee. Type-params that appear
            // only in the return type cannot be inferred from args (M.2 no-guessing) → honest error.
            var all_tps = collect_sig_type_params(ft, table, teko::list::empty())
            // Explicit type-args on a NON-generic callee are a plain error (nothing to instantiate).
            if explicit_fn_args.len > 0 && all_tps.len == 0 {
                return error { message = $"'{name}' is not generic — it takes no explicit type arguments" }
            }
            if all_tps.len > 0 {
                var param_tps: []str = teko::list::empty()
                var pp = 0
                loop { if pp >= f.params.len { break }; param_tps = collect_sig_type_params(f.params[pp], table, param_tps); pp++ }
                if explicit_fn_args.len > 0 {
                    // EXPLICIT call-site type-args WIN over inference (owner ruling): bind each of the
                    // signature's type-params (in appearance order) to the corresponding resolved arg,
                    // dispensing with inference — this also enables a type-param that appears ONLY in the
                    // return type (uninferable from args). The typed args must still FIT the substituted
                    // parameters. The resolved concrete types ride the TCall so the monomorph pass stamps
                    // exactly this instance (instead of re-inferring from the args).
                    if explicit_fn_args.len != all_tps.len {
                        return error { message = $"'{name}' takes {all_tps.len} type argument(s), but {explicit_fn_args.len} were given" }
                    }
                    var s = Subst { params = all_tps; names = teko::list::empty(); types = teko::list::empty() }
                    var xtypes: []Type = teko::list::empty()
                    var xi = 0
                    loop {
                        if xi >= all_tps.len { break }
                        var rt = match resolve_type(explicit_fn_args[xi], table, env.cur_ns) { Type as tt => tt; error as e => return e }
                        match rt { Reference => return error { message = "a reference cannot be an explicit generic type argument (it would be stored / escape)" }; _ => { } }
                        s = Subst { params = all_tps; names = teko::list::push(s.names, all_tps[xi]); types = teko::list::push(s.types, rt) }
                        xtypes = teko::list::push(xtypes, rt)
                        xi++
                    }
                    var vi = 0
                    loop {
                        if vi >= targs.len { break }   // targs.len == f.params.len (arity checked above)
                        var want = subst_type(f.params[vi], s)
                        if !assignable_to(targs[vi].type, want, table) {
                            return error { message = $"argument {vi + 1} of '{name}' does not fit the explicit instantiation (expected {type_render(want)}, got {type_render(targs[vi].type)})" }
                        }
                        vi++
                    }
                    return TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = targs; call_ns = resolved_ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = xtypes; ret_extra = teko::list::empty() }; type = subst_type(f.ret, s); line = 0; col = 0 }
                }
                var rk = 0
                loop {
                    if rk >= all_tps.len { break }
                    if !is_type_param(all_tps[rk], param_tps) { return error { message = $"cannot infer type parameter {all_tps[rk]} — it appears only in the return type; annotate the call" } }
                    rk++
                }
                var s = Subst { params = param_tps; names = teko::list::empty(); types = teko::list::empty() }
                var gi = 0
                loop {
                    if gi >= targs.len { break }   // targs.len == f.params.len (arity checked above); bound by the typed-arg list
                    s = match unify(f.params[gi], targs[gi].type, s, table) { Subst as x => x; error as e => return e }
                    gi++
                }
                return TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = targs; call_ns = resolved_ns; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = subst_type(f.ret, s); line = 0; col = 0 }
            }
            // NON-generic: each argument must WIDEN into the parameter's type (B.14 case→variant, T→T?)
            // OR be a fitting literal that adopts it (C6) — same rule as binding/return/assign.
            var args: []TExpr = teko::list::empty()
            var i = 0
            loop {
                if i >= targs.len { break }
                var a = targs[i]
                if !assignable_to(a.type, f.params[i], table) { a = deref_ref_value(a) }
                // (MEM-1b-ii) AUTO-REF: a `ref<T>` param accepts a `mut` lvalue of the pointed type T —
                // the compiler takes the reference (codegen emits `&`). Requires a `var` variable (you
                // can't reference an immutable binding — there'd be nothing to mutate). A value ALREADY
                // of type `ref<T>` (e.g. forwarding a ref param) takes the normal assignable path below.
                var auto_reffed = false
                match f.params[i] {
                    Reference as rf => {
                        if !assignable_to(a.type, f.params[i], table) && type_eq(a.type, rf.inner) {
                            match a.kind {
                                TVar as v => match lookup_binding(env, v.name) {
                                    ValBinding as vb => {
                                        if !vb.is_mut { return error { message = $"cannot take a reference to immutable `{v.name}` — declare it `mut`/`var` (a reference needs a mutable target)" } }
                                        auto_reffed = true   // keep a.type = T; emit_call emits `&` (param is ref<T>)
                                    }
                                    error => return error { message = "auto-ref requires a mutable variable (a `var` binding)" }
                                }
                                _ => return error { message = "a `ref<T>` argument must be a mutable variable (a `var` binding) — only an lvalue can be referenced" }
                            }
                        }
                    }
                    _ => { }
                }
                if !auto_reffed {
                    a = match coerce_argument_into(a, f.params[i], table) { TExpr as x => x; error as e => return e }
                }
                args = teko::list::push(args, a)
                i++
            }
            // (W10a) a CLOSURE call: the callee resolved IN-scope to a function type whose binding is a
            // LOCAL (resolved_ns == "" — only define_fn sets a namespace). It is a `tk_closure` VALUE,
            // so codegen calls through `((R(*)(A,B))f.fn)(args)` using the Func type for the cast.
            var is_closure = in_scope && resolved_ns.len == 0
            TExpr { kind = TCall { overload_suffix = ov_suffix; callee = c.callee; args = args; call_ns = resolved_ns; is_closure_call = is_closure; callee_type = ft; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = f.ret; line = 0; col = 0 }
        }
        _ => error { message = $"not a function: {name}" }
    }
}

// ---- cast `to` (C2): a DEFINED conversion is allowed; loss is caught, never silent (M.1) ----
// Two-pronged — the ÷0/overflow/OOB lineage applied to conversions (homeostasis, Constitution §II):
//   • a CONSTANT operand the compiler can see out of range → COMPILE ERROR (fail early — M.1);
//   • a runtime value the compiler cannot see → the metal converts and the loss is caught at
//     runtime (debug-panic / release-defined, exactly like overflow) — that guard is CODEGEN's,
//     deferred (M.4). M.1 forbids only SILENT loss; a check/panic is not silent, so narrowing and
//     signed↔unsigned ARE allowed (the value might fit — M.0 keeps the metal conversion).
// Scoped to the seed's scalars: Bool casts and non-numeric casts are UNDEFINED (rejected). The
// native numeric set (B.38) — int↔int (incl 128), int↔float, float↔float — is ALL defined: the
// fit/loss is the runtime guard's (trunc toward zero, overflow/NaN/∞ → panic — §5). Decimal awaits
// its runtime; newtype↔base awaits `resolve_named` lowering a newtype to its base — both deferred
// (M.4). *(Redefines the early compile-forbid rule — see the Redefinitions Index; the prior rule
// over-applied M.1, forbidding what a guard makes non-silent.)*

/**
 * numint_fits — does the signed-magnitude literal `v` fit the target integer prim `k`? (B.38 —
 * the full int set is now u8..u64/i8..i64, the 128-bit surface types having been removed,
 * drop-128 2026-07-24.) Replaces the old i64-carrier `value_fits` (carrier-detoxed off i64,
 * §2.1). Floats are handled separately (`float_fits`); Bool is never a literal target. An
 * unsigned target rejects a negative `v` first, then gates the magnitude against its max; a
 * signed target gates the magnitude against its positive max (non-negative `v`) or against
 * `2^(w-1)` (negative `v` — the extra headroom that admits e.g. `i8::MIN = -128`, magnitude 128).
 *
 * @param v  the resolved literal carrier
 * @param k  the target integer prim kind
 * @return   true iff `v` is representable in `k`
 */
fn numint_fits(v: parser::NumInt, k: PrimKind): bool {
    if prim_is_float(k) { return false }   // an int literal does not fit a float type (N1/N2)
    if k == PrimKind::U8 { return !v.neg && v.mag <= 255 }
    if k == PrimKind::U16 { return !v.neg && v.mag <= 65535 }
    if k == PrimKind::U32 { return !v.neg && v.mag <= 4294967295 }
    if k == PrimKind::U64 { return !v.neg && v.mag <= 18446744073709551615 }
    if k == PrimKind::I8 { return if v.neg { v.mag <= 128 } else { v.mag <= 127 } }
    if k == PrimKind::I16 { return if v.neg { v.mag <= 32768 } else { v.mag <= 32767 } }
    if k == PrimKind::I32 { return if v.neg { v.mag <= 2147483648 } else { v.mag <= 2147483647 } }
    if k == PrimKind::I64 { return if v.neg { v.mag <= 9223372036854775808 } else { v.mag <= 9223372036854775807 } }
    // (§8) machine words share their 64-bit twin's range: usize ≡ u64, size ≡ i64.
    if k == PrimKind::Usize { return !v.neg && v.mag <= 18446744073709551615 }
    if k == PrimKind::Size { return if v.neg { v.mag <= 9223372036854775808 } else { v.mag <= 9223372036854775807 } }
    false
}

/**
 * float_fits — does a constant FLOAT literal fit the target float prim? Seed ruling (§5): a
 * float constant is accepted into ANY float width — precision/range loss of float CONSTANTS is
 * permissive for now (the runtime/codegen rounding-loss note in §5 still applies). Tightening
 * `f32` over-range to a compile error is deferred (no fail-early for float consts yet).
 *
 * @param v  the constant float value (unused — every width currently accepts any value)
 * @param k  the target float prim kind
 * @return   whether `k` is a float prim
 */
fn float_fits(v: f64, k: PrimKind): bool { prim_is_float(k) }

// is `from -> to` a DEFINED conversion? Any integer↔integer is (the loss is runtime/codegen's,
// not a type error — B). Only genuinely-undefined conversions are rejected: Bool, and crossing
// to/from a non-numeric type. M.1 — no silent loss; M.3 — names the barrier. Reused by the
// counter-validation (E6-2) so the rule has ONE source of truth (M.5).
// byte casts AS u8 (B.36 "byte = u8 newtype"): byte's values ARE u8 values, so the effective
// PrimKind for range/cast rules is U8. Bool and non-numeric types have no cast kind (rejected).
// One source of truth (M.5) for cast_check + const_range_check.
fn cast_kind(t: Type): PrimKind | error {
    match t {
        Prim as p => {
            if p.kind == PrimKind::Bool { error { message = "bool casts are not defined in the seed" } }
            else { p.kind }
        }
        Byte => PrimKind::U8
        Ptr as p => cast_kind_of_ptr(p)
        _ => error { message = "cast not defined for this type in the seed (Named/Str/Slice/… — pending)" }
    }
}

/**
 * cast_kind_of_ptr — `cast_kind`'s `Ptr` arm: the arena address-carrier decision
 * (`docs/design/arena-em-teko.md` §2 P1 — "não existe cast `u64 -> ptr`, então nem o caminho
 * alocante é alcançável a partir de um endereço calculado"). `u64` is ABI-identical to `void *` on
 * every 64-bit target, so a `ptr <-> u64` pair carries `PrimKind::U64` into `cast_check`'s generic
 * "any numeric to any numeric is defined" rule, making the cast a reinterpret rather than a
 * conversion. Since §5 collapsed `ptr` to the opaque atomic word (no `ptr<T>` remains), that word
 * IS the arena's whole address surface — the single admitted pointer partner of `u64`.
 *
 * @param p  the resolved opaque `Ptr` type (`p.inner` is always `null` in §5)
 * @return   `PrimKind::U64` — the opaque `ptr` reinterprets to/from `u64` as the address carrier
 */
fn cast_kind_of_ptr(p: Ptr): PrimKind | error {
    PrimKind::U64
}

/**
 * cast_ptr_partner_ok — when either cast endpoint is a `Ptr`, is the OTHER endpoint the ONE
 * partner the address-carrier decision admits (`docs/design/arena-em-teko.md` §2: `ptr<byte> <->
 * u64`, and ONLY that pairing)?
 *
 * WHY THIS EXISTS SEPARATELY FROM `cast_kind_of_ptr`. `cast_kind_of_ptr` answers `ptr<byte>` with
 * `PrimKind::U64` so the pair can ride `cast_check`'s generic "any numeric to any numeric is
 * defined" rule below — but that rule only ever sees the two `PrimKind`s, never the concrete
 * types they came from. Left alone, it would accept `ptr<byte> to i32` or `f64 to ptr<byte>` —
 * ANY numeric partner, not just `u64` — because `PrimKind::U64` reads as "some 64-bit-ish numeric"
 * to a rule that was written for genuine numeric-to-numeric pairs. P1 is a same-bit-pattern
 * REINTERPRET, not a machine conversion (`lir::lower_cast`'s `is_u64_ptr_byte_reinterpret_cast`
 * emits it as literally zero instructions), so a pairing that rule cannot honour must never
 * type-check in the first place. This checks the ACTUAL partner type, closing that gap before
 * `cast_kind` is ever consulted.
 *
 * @param from  the cast operand's resolved type
 * @param to    the cast target's resolved type
 * @return      `null` when NEITHER side is `Ptr` (the generic rule below decides it), or the one
 *              `Ptr` side's partner is exactly `u64`; a NAMED error for every other
 *              pointer-involving pairing (including pointer-to-pointer)
 * @since 0.3.1
 */
fn cast_ptr_partner_ok(from: Type, to: Type): error | null {
    var from_ptr = is_bare_ptr(from)
    var to_ptr = is_bare_ptr(to)
    if !from_ptr && !to_ptr { return null }
    if from_ptr && to_ptr {
        return error { message = "cast not defined between two pointer types in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
    }
    var partner = if from_ptr { to } else { from }
    if is_u64_prim(partner) { return null }
    error { message = "cast not defined for this pointer/numeric pairing in the seed (only `ptr<byte> <-> u64`, the arena address carrier, is defined — arena-em-teko.md §2)" }
}

// is `t` (structurally) a `Ptr` — opaque `ptr` or any `ptr<T>`? `cast_ptr_partner_ok`'s own
// classifier; `cast_kind_of_ptr` still owns which POINTEE that `Ptr` may carry.
fn is_bare_ptr(t: Type): bool {
    match t { Ptr => true; _ => false }
}

// is `t` the resolved primitive `u64` — the ONE partner `cast_ptr_partner_ok` admits opposite a `Ptr`?
fn is_u64_prim(t: Type): bool {
    match t { Prim as p => p.kind == PrimKind::U64; _ => false }
}

// is `from -> to` a DEFINED conversion? Any integer/byte ↔ integer/byte is (the loss is
// runtime/codegen's — B; byte casts AS u8 — B.36). Only Bool and non-numeric ends are rejected.
// A `Ptr` endpoint is additionally pairwise-gated by `cast_ptr_partner_ok` (arena-em-teko.md §2 —
// see its own doc for why `cast_kind`'s `PrimKind::U64` answer for `ptr<byte>` is not, by itself,
// enough to keep this rule scoped to the one pairing that decision admits).
// Reused by the counter-validation (E6-2) — ONE source of truth (M.5).
fn cast_check(from: Type, to: Type): error | null {
    if type_eq(from, to) { return null }   // same type — a no-op
    match cast_ptr_partner_ok(from, to) { null => { }; error as e => return e }
    match cast_kind(from) { PrimKind => { }; error as e => return e }
    match cast_kind(to) { PrimKind => { }; error as e => return e }
    null   // any numeric/byte → any numeric/byte is defined (B; byte AS u8)
}

/**
 * const_range_check — a CONSTANT literal already out of the target's range is a compile error
 * (M.1 — fail early); non-constant operands are guarded at runtime by codegen. Direct literals
 * only (comptime folding deferred). Only the int-literal → int-target case is statically
 * range-checkable (B.38, u8..u64/i8..i64); float→int / int→float / float→float constant
 * conversions are runtime-guarded (trunc toward zero, overflow/NaN/∞ → panic — §5) — the checker
 * permits them, the fit is codegen/interpreter's.
 *
 * @param e       the candidate literal expression
 * @param target  the cast/annotation target type
 * @return        an error naming the out-of-range constant, or null when the fit is fine
 */
fn const_range_check(e: parser::Expr, target: Type): error | null {
    match e.kind {
        parser::Number as n => match cast_kind(target) {   // byte target → U8 range (0..255)
            PrimKind as k => {
                if n.is_float || !prim_is_int(k) { null }
                else if numint_fits(n.value, k) { null }
                else { error { message = "constant out of range for the cast target (M.1 — fail early)" } }
            }
            error => null   // non-numeric target: cast_check already rejected it
        }
        _ => null   // not a constant literal → runtime-guarded (codegen)
    }
}

// C6 — an annotated binding `let x: T = <value>` whose value type ≠ T. A numeric LITERAL ADOPTS T
// if it fits: the leaf stays i64 (stored AS-IS — Side D) and T lives in the binding's `bound`.
// The fit is proven HERE at type time via `value_fits`. A NON-literal mismatch is a hard error —
// no implicit conversion (M.2; use `to`). An out-of-range literal fails EARLY (M.1).
// NOTE: the counter-validation does NOT yet re-prove the binding-level fit — a forged typed tree
// `bound=u8, value=300` would currently pass revalidate. That re-proof lands with `validate_statement`
// (deferred; named gap — §VI). The front-line type check above already rejects such source.
fn annotated_literal_ok(value: parser::Expr, ann: Type): error | null {
    match value.kind {
        // an ARRAY LITERAL `[e0, e1, …]` annotated as `[]E` — adopts element-wise: every non-spread
        // element must itself be a fitting bare literal for E (recurses through nested arrays via
        // this same function). A spread element (`..xs`) is already a `[]T` value, not a literal —
        // skip it here (its own widen/adopt was checked at array-literal typing time). Mirrors
        // literal_adopts's TArrayLit case (the range-check side), which already recurses this way;
        // this is the RETYPING side's twin so `let a: []u8 = [1,2,3]` type-checks (#71).
        parser::ArrayLit as al => match ann {
            Slice as s => {
                var i = 0
                var result: error | null = null
                loop {
                    if i >= al.elements.len { break }
                    if !al.elements[i].is_spread {
                        match annotated_literal_ok(al.elements[i].expr, s.element) {
                            null => { }
                            error as e => { result = e; break }
                        }
                    }
                    i++
                }
                result
            }
            _ => error { message = "value type does not match annotation" }
        }
        parser::Unary as u => {
            if u.op == lexer::TokenKind::Minus {
                match u.operand.kind {
                    parser::Number as n => match ann {
                        Prim as p => {
                            if n.is_float {
                                if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type (B.38)" } }
                                else if float_fits(n.fval, p.kind) { null }
                                else { error { message = "float literal out of range for the annotated type (M.1 — fail early)" } }
                            } else {
                                if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                                else if !prim_is_signed(p.kind) { error { message = "a negative literal cannot be annotated as an unsigned type (M.1)" } }
                                else if numint_fits(n.value, p.kind) { null }
                                else { error { message = "literal out of range for the annotated type (M.1 — fail early)" } }
                            }
                        }
                        _ => error { message = "value type does not match annotation" }
                    }
                    _ => error { message = "value type does not match annotation" }
                }
            } else {
                error { message = "value type does not match annotation" }
            }
        }
        parser::Number as n => match ann {
            Prim as p => {
                if n.is_float {
                    // a float literal (3.14, 1.5e3) adopts a float annotation only (N2).
                    if !prim_is_float(p.kind) { error { message = "a float literal cannot be annotated as an integer type (B.38)" } }
                    else if float_fits(n.fval, p.kind) { null }
                    else { error { message = "float literal out of range for the annotated type (M.1 — fail early)" } }
                } else {
                    // an integer literal adopts an integer annotation only; never a float type (N1).
                    if prim_is_float(p.kind) { error { message = "an integer literal cannot be annotated as a float type (write it with a `.` — B.38)" } }
                    else if numint_fits(n.value, p.kind) { null }
                    else { error { message = "literal out of range for the annotated type (M.1 — fail early)" } }
                }
            }
            _ => error { message = "value type does not match annotation" }
        }
        _ => error { message = "value type does not match annotation" }
    }
}

// `x to T` — type the inner, resolve the target, demand the conversion is DEFINED, then reject a
// CONSTANT literal already out of range (fail early — M.1). The runtime fit-check for non-constant
// operands is codegen's (debug-panic / release-defined) — deferred (M.4).
// (E7) is `t` a NAMED type whose declaration is an `enum`? (C: is_enum_named.)
fn is_enum_named(t: Type, table: TypeTable): bool {
    match t {
        Named as n => match type_table_find(table, n.name, "") {   // (#109 W1) enum-kind probe on a resolved name — no referencing ns
            parser::TypeDecl as td => match td.body { parser::EnumBody => true; _ => false }
            error => false
        }
        _ => false
    }
}

// (E7) an INTEGER cast endpoint: an int prim, or `byte` (= u8). Floats/bool excluded. (C: is_int_cast_end.)
fn is_int_cast_end(t: Type): bool {
    match t {
        Byte => true
        Prim as p => prim_is_int(p.kind)
        _ => false
    }
}

// (UTF-8 increment 1) `char to <int>` — the EXPLICIT decode of a codepoint to its scalar value.
// Allowed for u32 (the natural codepoint width), and trivially for the wider unsigned/signed ints
// that hold any codepoint (u64/i64). The REVERSE (`<int> to char`, an encode) is a later increment.
fn is_char_decode_target(t: Type): bool {
    match t {
        Prim as p => p.kind == PrimKind::U32 || p.kind == PrimKind::U64 || p.kind == PrimKind::I64
        _ => false
    }
}

/**
 * is_flags_wire_cast — E8 (#594 crumb 11): is `from -> to` a flags ↔ integer WIRE
 * cast? A flags value's raw bit pattern → an integer (an object-writer
 * `sh_flags`/`Characteristics` field needs the combined mask as a plain `uN`), or
 * an integer → a flags value. `cast_check` is prim-only, so `type_cast` handles
 * this pair directly — mirroring E7's enum-ordinal cast. Any OTHER flags cast
 * stays rejected by `cast_check`.
 *
 * @param from   the cast's source type
 * @param to     the cast's target type
 * @param table  the type table (to detect a flags-declared Named type)
 * @return       true iff the pair is a flags↔integer wire cast
 */
fn is_flags_wire_cast(from: Type, to: Type, table: TypeTable): bool {
    (is_flags_named(from, table) && is_int_cast_end(to)) ||
    (is_int_cast_end(from) && is_flags_named(to, table))
}

/**
 * NotValueType — the sentinel `value_type_base` returns when `t` is NOT a body-carrying prim-backed
 * newtype (§9 E9). Modeled on the `NotListBuiltin`/`NotPtrOp` tri-state markers.
 *
 * @since §9
 */
type NotValueType = struct { }

/**
 * value_type_base — the resolved BACKING type of a nominal prim-backed value-type `Named`
 * (a `NewtypeBody`), or `NotValueType` when `t` is anything else (§9 ruling 9). For
 * `type Celsius = f32 { … }` it returns the resolved `f32`; an enum/flags value-type reports its
 * ordinal/wire integer through the existing E7/E8 paths instead, so this covers ONLY the NewtypeBody
 * case (E9's new work). A TRANSPARENT `AliasBody` never reaches here — it resolves-through
 * (`resolve.tks`) and needs no cast. Returns `NotValueType` for every type in the compiler's own
 * corpus (no `NewtypeBody` exists), so the E9 gate is inert on the self-build (plan §8 fixpoint).
 *
 * @param t      the type to inspect
 * @param table  the folded type table
 * @return       the resolved backing type, or `NotValueType`
 * @since §9
 */
fn value_type_base(t: Type, table: TypeTable): Type | NotValueType {
    match t {
        Named as n => match type_table_find(table, n.name, "") {
            parser::TypeDecl as td => match td.body {
                parser::NewtypeBody as nb => match resolve_type(nb.backing, table, "") {
                    Type as bt => bt
                    error => NotValueType { }
                }
                _ => NotValueType { }
            }
            error => NotValueType { }
        }
        _ => NotValueType { }
    }
}

/**
 * value_type_reduce — reduce a nominal prim-backed value-type to its backing type (§9 E9), leaving
 * every other type unchanged. Lets `type_cast` apply the ordinary numeric-cast rules across the
 * newtype↔base boundary: representation is identity (the value IS the primitive), so a `Celsius`
 * (backed by `f32`) casts to/from any numeric endpoint exactly as its `f32` base would, the loss
 * runtime-guarded like any other numeric conversion. Inert on the corpus (every type reduces to
 * itself).
 *
 * @param t      the type to reduce
 * @param table  the folded type table
 * @return       the backing type for a NewtypeBody `Named`, else `t` unchanged
 * @since §9
 */
fn value_type_reduce(t: Type, table: TypeTable): Type {
    match value_type_base(t, table) {
        Type as bty => bty
        NotValueType => t
    }
}

/**
 * warn_redundant_cast — the D1 diagnostic (`cast-width-hygiene-0.3.1.md` §4/§9):
 * a WARNING printed to stderr, never a build failure. Fires on a provable no-op
 * `to` (class 1 — same-type; class 3 — a lossless widen the W-RULE/B.22
 * sign-check already performs), never on a genuine narrow/widen the source
 * still needs.
 *
 * WHY IT IS NO LONGER AN ERROR (owner ruling 2026-07-27, REVERSING the
 * 2026-07-24 ruling that made it a hard failure — *"prefiro que falhe para
 * evitarmos de cair no mesmo erro"*): *"o cast, nestes casos, não deveria ser
 * falha, deveria ser warning, o que não nos exime de não ter warnings no
 * próprio compilador (lembra? <= 2%)."*
 *
 * The reversal is not a softening of the policy — it moves enforcement to the
 * instrument that can actually carry it. D1-as-error made a redundant cast
 * UNSPELLABLE, and a bootstrap chain has two compilers that disagree about
 * which spelling is redundant: the released seed applies B.22 (*"operands must
 * be the same type — no promotion"*) and REQUIRES the cast, while a
 * locally-built gen1 has the W-RULE (`widen_int_binop`) and therefore proves
 * that same cast a no-op. As an error, no single source text satisfies both —
 * measured on the wagon: 17 of the 18 B.22 casts the seed demands make gen1
 * reject the tree outright. As a warning, one text compiles under both and the
 * seed's demand becomes payable.
 *
 * The ceiling that keeps redundant casts from returning en masse is D4, and it
 * is untouched and still HARD: ARITH-CAST-RATE ≤ 2% (`metrics.tks`,
 * `run_arith_cast_gate` in `project.tks`) fails the build. That is why the
 * same-type site below deliberately keeps the `TCast` node in the typed tree
 * instead of folding it away — a warned cast must still be COUNTED by the gate,
 * or downgrading this diagnostic would have quietly disabled the ≤2% ceiling
 * along with it.
 *
 * @param t  the redundant cast's own (unchanged) type
 * @since    0.3.1
 */
fn warn_redundant_cast(env: Env, e: TExpr) {
    teko::io::eprintln($"{diag_at(env.file, e.line, e.col, "")}warning: redundant cast: this `to {type_render(e.type)}` is a provable no-op (cast-width-hygiene-0.3.1.md D1) — delete it")
}

fn type_cast(c: parser::Cast, env: Env, table: TypeTable): TExpr | error {
    var inner = match type_expr(c.expr, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(inner.type) { return error { message = "a `void` expression cannot be cast (M.1)" } }
    var target = match resolve_type(c.target, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the cast's enclosing namespace
    // D1 class 1 — same type. Warn and TYPE IT ANYWAY, returning the identity `TCast`: falling
    // through instead would hand a non-prim same-type pair to `cast_check` (prim-only) and blame it
    // for a construct that is merely superfluous, and dropping the node would hide the cast from the
    // D4 ≤2% gate that now carries the policy.
    if type_eq(inner.type, target) {
        var noop = TExpr { kind = TCast { expr = inner }; type = target; line = inner.line; col = inner.col }
        warn_redundant_cast(env, noop)
        return noop
    }
    // (UTF-8 increment 1) `char to u32`/u64/i64 — decode the codepoint to its scalar value. char is
    // NOT a numeric cast endpoint (cast_kind rejects it), so this pair is handled here; the result
    // type is the target. `<int> to char` (encode) is NOT allowed yet. (Mirrors expr.c type_cast.)
    match inner.type {
        Char => {
            if is_char_decode_target(target) {
                return TExpr { kind = TCast { expr = inner }; type = target; line = 0; col = 0 }
            }
            return error { message = "a `char` may only be cast to u32/u64/i64 (its codepoint value); other casts are not defined" }
        }
        _ => { }
    }
    // (E7) enum ↔ integer ORDINAL cast: an enum value → its ordinal integer, an integer → the enum
    // member (the `(byte)k` / `(TokenKind)b` the .tkb serializer relies on). cast_check is prim-only,
    // so handle this pair here (it has the type table to detect an enum); the result type is the
    // target. Any OTHER enum cast stays rejected by cast_check. (Mirrors expr.c type_cast's e7.)
    var inner_r = value_type_reduce(inner.type, table)
    var target_r = value_type_reduce(target, table)
    var e7 = (is_enum_named(inner_r, table) && is_int_cast_end(target_r)) ||
    (is_int_cast_end(inner_r) && is_enum_named(target_r, table))
    var e8 = is_flags_wire_cast(inner_r, target_r, table)
    if !e7 && !e8 {
        match cast_check(inner_r, target_r) { null => { }; error as e => return e }
    }
    match const_range_check(c.expr, target_r) { null => { }; error as e => return e }
    TExpr { kind = TCast { expr = inner }; type = target; line = 0; col = 0 }   // the cast's type IS the resolved target
}

// ---- field access `x.field` (C3): read a struct field; `.type` is the field's resolved type ----
// B.29: FIELD read only (method *checking* stays deferred). M.3: nominal — resolve the receiver's
// `Named` type to its `TypeDecl` body and read the field's declared type. Receiver must be a struct.

// find a field by name in a struct body and resolve its annotation (M.3 — exact).
fn field_type(fields: []parser::Field, field: str, table: TypeTable, ref_ns: str): Type | error {
    var i = 0
    loop {
        if i >= fields.len { break }
        if fields[i].name == field { return resolve_type(fields[i].type_ann, table, ref_ns) }   // (#109 W2) field annotation resolves in the struct's OWN ns (its declaring namespace)
        i++
    }
    error { message = $"no such field: {field}" }
}

/**
 * require_narrowed — the null-union C5 deref fence (base §3d/§3f). Using a `T | null` (any
 * null-bearing union) payload AS a bare member — a field read, or the `.value` deref of a
 * `Ref<T> | null` — is REJECTED until the union has been narrowed to its bare member, the SAME
 * narrowing invariant an unmatched `T | error` obeys. The two accepted narrowing scopes rebind the
 * value to its bare member BEFORE this point (a `match` arm's pattern binding; the flow-narrowed
 * branch of an equality guard), so reaching here with a still-`Variant` null-bearing type means the
 * use is un-narrowed. Directs the author to the sanctioned narrowing forms.
 *
 * @param t  the receiver's resolved (still-union) type
 * @return   the error demanding narrowing before the bare-member use
 * @throws   error always (this is the reject path; the caller only calls it on a null-bearing union)
 * @since 0.3.0.30 (null-union C5)
 */
fn require_narrowed(t: Type): error {
    if is_ref_null_variant(t) {
        return error { message = "cannot dereference a `Ref<T> | null` — narrow it to a bare `Ref<T>` first (`match r { null => …; Ref<T> as v => v.value }`), the deref fence keeping the never-null reference promise sound" }
    }
    error { message = "cannot use `.` on a `T | null` value before narrowing — narrow it first (`match x { null => …; T as v => v.… }`)" }
}

/**
 * PropInfo — the accessor surface of a property `prop` on a resolved type: whether a getter and/or
 * a setter exist, and the accessors themselves (for the return/value type and the dispatch name).
 * Presence decides the mode (§9 ruling 1): get-only = read-only, set-only = write-only, both = rw.
 *
 * @field has_get  a `get prop` accessor exists on the type's effective method surface
 * @field has_set  a `set prop` accessor exists on the type's effective method surface
 * @field getter   the getter Function (valid iff has_get)
 * @field setter   the setter Function (valid iff has_set)
 */
pub type PropInfo = struct { has_get: bool; has_set: bool; getter: parser::Function; setter: parser::Function }

/**
 * property_surface_of — the effective method surface a property probe scans for a resolved type:
 * the contract methods for an interface/trait receiver, the effective class methods for a class,
 * or the struct's own methods. Returns null when the type has no method surface (so `find_property`
 * cleanly falls through to null for a non-property member).
 *
 * @param decl   the receiver's resolved type declaration
 * @param name   the receiver's resolved type name
 * @param table  the folded type table
 * @return       the method surface to scan, or null when the type has none
 */
fn property_surface_of(decl: parser::TypeDecl, name: str, table: TypeTable): []parser::Function | null {
    match decl.body {
        parser::InterfaceBody => match iface_methods_by_name(name, table) { []parser::Function as f => f; error => null }
        parser::TraitBody => match iface_methods_by_name(name, table) { []parser::Function as f => f; error => null }
        parser::ClassBody as cb => match effective_class_methods(cb, table) { []parser::Function as f => f; error => null }
        parser::StructBody as sb => sb.methods
        _ => null
    }
}

/**
 * find_property — the property `prop` declared on the resolved type `type_name` (or `null` when
 * `prop` is not a property of it). Scans the type's EFFECTIVE method surface for accessors flagged
 * `is_getter`/`is_setter` whose `accessor_prop == prop`. The flags (never the bare name) are the
 * authority, so an ordinary method that merely happens to be named `__get_x` is NOT a property.
 * Zero accessors exist in the corpus, so this returns `null` for every existing field access —
 * the use-site desugars run their historic path (additive-inert).
 *
 * @param type_name  the receiver's resolved type name
 * @param prop       the accessed member name
 * @param table      the folded type table
 * @return           the property's accessor surface, or null when `prop` is not a property
 */
fn find_property(type_name: str, prop: str, table: TypeTable): PropInfo | null {
    var decl = match type_table_find(table, type_name, "") { parser::TypeDecl as td => td; error => return null }
    var methods = match property_surface_of(decl, type_name, table) { []parser::Function as f => f; null => return null }
    if methods.len == 0 to u64 { return null }
    var has_get = false
    var has_set = false
    var getter = methods[0]
    var setter = methods[0]
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        var m = methods[i]
        if m.accessor_prop == prop {
            if m.is_getter { has_get = true; getter = m }
            else if m.is_setter { has_set = true; setter = m }
        }
        i = i + 1
    }
    if !has_get && !has_set { return null }
    PropInfo { has_get = has_get; has_set = has_set; getter = getter; setter = setter }
}

/**
 * class_field_visible_to — is a class field owned by `owner` reachable from the code currently being
 * typed? A private (default) field is reachable only from its OWN declaring class's code, or — if
 * `intern` — a subclass's too (W10b.CLASS residual). Wraps `member_accessible` against the enclosing
 * `env.owner_type`, naming the intent the field-read visibility gate enforces.
 *
 * @param owner  the field's declaring-class ownership record
 * @param env    the enclosing type environment (its `owner_type` is the accessing code's class)
 * @param table  the folded type table
 * @return       true iff the field is accessible from the current code
 */
fn class_field_visible_to(owner: MemberOwner, env: Env, table: TypeTable): bool {
    member_accessible(owner, env.owner_type, table)
}

/**
 * desugar_getter — type `recv.prop` as the accessor CALL `recv.__get_prop()` (§9 ruling 3,
 * field-like read). Synthesizes a `parser::MethodCall` and routes it through `type_method_call`, so
 * an interface receiver dispatches through the fat-ptr vtable and a struct/class receiver takes the
 * direct/virtual method path — no new codegen. The result type is the getter's return type.
 *
 * @param recv   the RAW receiver expression (`recv.prop`'s `recv`)
 * @param prop   the property name
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed accessor-call TExpr (a `TCall`), or a type error
 */
fn desugar_getter(recv: parser::Expr, prop: str, env: Env, table: TypeTable): TExpr | error {
    var mc = parser::MethodCall { receiver = recv; method = "__get_" ~ prop; args = teko::list::empty(); arg_names = teko::list::empty(); type_args = teko::list::empty() }
    type_method_call(mc, env, table)
}

/**
 * property_read_or — resolve a field-absence into a property READ or re-raise the field error. Only
 * called AFTER the field path failed by ABSENCE (never on a visibility failure), so a private field
 * still errors as a field. A getter yields the desugared call; a set-only (write-only) property is a
 * precise write-only error; a non-property re-raises the original field error unchanged (inertness).
 *
 * @param orig_err   the original field-absence error to re-raise for a non-property member
 * @param type_name  the receiver's resolved type name
 * @param recv       the RAW receiver expression
 * @param prop       the accessed member name
 * @param env        the typing environment
 * @param table      the folded type table
 * @return           the typed getter call, or an error (write-only, or the re-raised field error)
 * @throws           when the member is a write-only property or is neither field nor property
 */
fn property_read_or(orig_err: error, type_name: str, recv: parser::Expr, prop: str, env: Env, table: TypeTable): TExpr | error {
    match find_property(type_name, prop, table) {
        PropInfo as pinfo => {
            if pinfo.has_get { return desugar_getter(recv, prop, env, table) }
            return error { message = $"property '{prop}' is write-only — it has a setter but no getter" }
        }
        null => orig_err
    }
}

/**
 * type_field_access — type `recv.field`. Handles the non-struct receivers FIRST (`str`/slice
 * `.len`, `error`'s carrier fields, `Ref<T>.value`), then requires a `T | null` receiver be
 * narrowed before `.` is used on it (NP-OOP, issue #116 — `require_narrowed` names WHY and
 * points at the narrowing match instead of the generic struct message), and finally resolves an
 * ordinary struct/class field — or, when the member is absent as a field, a property GETTER (§9).
 *
 * @param fa     the syntactic field access
 * @param env    the enclosing type environment
 * @param table  the type table
 * @return       the typed field access, or an error
 */
fn type_field_access(fa: parser::FieldAccess, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(fa.receiver, env, table) { TExpr as te => te; error as e => return e }
    // `.len` on a `str` or a slice (`[]T`): u64 (W5-idx). This precedes the struct-field
    // path: a str/slice has no struct body, so `len` is a built-in length, not a field.
    var is_str_or_slice = match recv.type { Str => true; Slice => true; _ => false }
    if is_str_or_slice && fa.field == "len" {
        return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Prim { kind = PrimKind::U64 }; line = 0; col = 0 }
    }
    // error diagnostic adornments (E2): the built-in `error` value exposes its carrier fields as
    // readable fields — message/file/expected/actual -> str, line/col -> u32. error has no struct
    // body, so (like str/slice `.len`) this precedes the struct-field path.
    var is_error = match recv.type { Error => true; _ => false }
    if is_error {
        if fa.field == "message" || fa.field == "file" || fa.field == "expected" || fa.field == "actual" {
            return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Str { }; line = 0; col = 0 }
        }
        if fa.field == "line" || fa.field == "col" {
            return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = Prim { kind = PrimKind::U32 }; line = 0; col = 0 }
        }
        return error { message = "no such field on error (message/file/expected/actual: str; line/col: u32)" }
    }
    // (MEM-1b-ii) `Ref<T>.value` — the deref: reading `r.value` yields the referenced T. A Reference
    // has no struct body and exposes ONLY `.value` (the pointed-to value); any other field is an error.
    match recv.type {
        Reference as rf => {
            if fa.field == "value" {
                return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = rf.inner; line = 0; col = 0 }
            }
            recv = deref_ref_value(recv)
        }
        _ => { }
    }
    match recv.type {
        Variant => if variant_has_null_member(recv.type) { return require_narrowed(recv.type) }
        _ => { }
    }
    var name = match recv.type {
        Named as n => n.name
        _ => return error { message = "field access requires a struct receiver" }
    }
    var decl = match type_table_find(table, name, "") {   // (#109 W1) field-access receiver lookup on a resolved name — no referencing ns
        parser::TypeDecl as td => td
        error => return error { message = $"unknown type for field access: {name}" }
    }
    match decl.body {
        parser::StructBody as sb => {
            match field_type(sb.fields, fa.field, table, type_ns_of(table, name)) {
                Type as t => return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = t; line = 0; col = 0 }
                error as e => return property_read_or(e, name, fa.receiver, fa.field, env, table)
            }
        }
        parser::ClassBody as cb => {
            var fs = match effective_class_fields(cb, table) { []parser::Field as x => x; error as e => return e }
            match field_type(fs, fa.field, table, type_ns_of(table, name)) {
                Type as t => {
                    var owner = match find_field_owner(name, table, fa.field) { MemberOwner as mo => mo; error as e => return e }
                    if !class_field_visible_to(owner, env, table) {
                        return error { message = $"field '{fa.field}' is private to {owner.declaring_class}" }
                    }
                    return TExpr { kind = TFieldAccess { receiver = recv; field = fa.field }; type = t; line = 0; col = 0 }
                }
                error as e => return property_read_or(e, name, fa.receiver, fa.field, env, table)
            }
        }
        parser::InterfaceBody => return property_read_or(error { message = "an interface value exposes no fields — only its contract methods" }, name, fa.receiver, fa.field, env, table)
        _ => return error { message = $"type {name} is not a struct (no fields)" }
    }
}

// ---- `?.` safe navigation (NP-OOP, issue #116) — the shared checker DESUGAR ----
// `recv?.member…` on a CLASS/INTERFACE optional lowers IN THE CHECKER to the equivalent
// typed match (no new TAST node, so the interpreter and native codegen run it through their
// existing match/method/field machinery — twin-identical by construction):
//     match recv { null => null; <Inner> as __tkqL_C => __tkqL_C.<member…> }
// typed `R?` (an already-optional R stays R?; a void R makes the whole safe call void —
// statement position only, with an EMPTY null-arm body).

// the deterministic per-node binder name `__tkq<line>_<col>` (position-derived, no global
// counter — both twin checkers produce the same name for the same node).
/**
 * unread_guard_placeholder — a syntactically-valid but never-evaluated `TArm.guard` for an arm
 * built with `has_when = false`; every consumer skips the guard field entirely in that case, so
 * its content is inert (the concrete zero literal is arbitrary — any well-typed `TExpr` would do).
 *
 * @return a placeholder integer-literal expression
 */
fn unread_guard_placeholder(): TExpr {
    TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Void { }; line = 0; col = 0 }
}

/**
 * is_foreach_elem_placeholder — is `p` the for-each loop-head desugar's element-bind placeholder
 * (§5.4)? `loop mut x in <it> { … }` desugars (`parser::loop_head.tks`) to `match _it() { null =>
 * break; <placeholder> => { … } }`, where `<placeholder>` is a `BindPattern` with an EMPTY
 * `type_name` — an internal marker reachable ONLY from the parser's own for-each desugar, never
 * from user source (a literal `_ as x` is now a parse-time error: `_` is a discard, `as x` a
 * capture — a semantic contradiction, owner ruling). `resolve_foreach_arm`, BEFORE any
 * pattern-matching/exhaustiveness/codegen ever sees a for-each match's arms, rewrites this
 * placeholder into a REAL `T as x` bind (T = the iterator's resolved element type) — the SAME
 * sound, pre-existing named-bind mechanism `Foo as v` already uses, so interpreter/native/LIR need NO
 * special case.
 *
 * @param p  the arm pattern to classify
 * @return   true iff `p` is the for-each placeholder
 */
fn is_foreach_elem_placeholder(p: parser::Pattern): bool {
    match p {
        parser::BindPattern as bp => bp.type_name.segments.len == 0 && !bp.is_slice && bp.has_binding
        _ => false
    }
}

/**
 * elem_type_name — the RUNTIME-facing BARE name of a for-each iterator's element type `t` — the
 * SAME bare, unqualified spelling interpreter's `bind_case_name`/`val_type_matches` and codegen's
 * `cg_path_last`/`cg_emit_case_key_str` already compare against for an ordinary `Foo as v` bind
 * (mirrors the "#109 W3 bare-vs-bare" convention throughout match.tks/the interpreter's twin/codegen.tks — the
 * runtime never carries a namespace). Handles the realistic element-type shapes (prim, byte, char,
 * str, a named struct/class/enum); every other `Type` case is a clean, named internal error (not
 * yet supported by the for-each desugar).
 *
 * @param t  the iterator's resolved element type (`_it`'s `T?` with `null` stripped)
 * @return   the bare runtime name string, or an error for an unnameable element type
 */
fn elem_type_name(t: Type): str | error {
    match t {
        Prim as p => prim_name(p.kind)
        Byte => "byte"
        Char => "char"
        Str => "str"
        Named as n => name_last_segment(n.name)
        _ => error { message = "internal: a for-each iterator's element type must be a nameable type (prim/byte/char/str/named) — this shape is not yet supported" }
    }
}

/**
 * strip_null_member_or_self — for a two-member `T | null` union, the non-null member `T`; `t`
 * unchanged otherwise (not a union, or a union that is not exactly `{ Null, T }`). A DEDICATED,
 * single-purpose function (not inlined) so every caller shares ONE extraction point.
 *
 * @param t  the type to strip
 * @return   the non-null member of a two-member null union, or `t` unchanged
 */
fn strip_null_member_or_self(t: Type): Type {
    match t {
        Variant as v => {
            if v.members.len != 2 { return t }
            var null_count = 0
            var other: Type | null = null
            var i = 0
            loop {
                if i >= v.members.len { break }
                match v.members[i] { Null => null_count = null_count + 1; _ => other = v.members[i] }
                i++
            }
            if null_count != 1 { return t }
            match other { Type as o => o; null => t }
        }
        _ => t
    }
}

/**
 * resolve_foreach_arm — the SYNTACTIC completion one match arm needs for `exhaustive`'s coverage
 * check ONLY: when `a.pattern` is the for-each placeholder, rewrite it into a `BindPattern` carrying
 * a non-empty `type_name` (so `present_case_covered` recognizes it as covering the present case,
 * exactly like it already does for `Foo as v`); every other arm (the `null => break` arm, and any
 * ordinary user arm) passes through unchanged. This rewrite is NEVER re-resolved via `resolve_named`
 * (see `type_foreach_elem_arm` for the actual TYPED binding, which bypasses name-resolution — the
 * element type may live outside the match's own referencing namespace).
 *
 * @param a        the syntactic match arm
 * @param subject  the match's subject type (a `T | null` union when this is a for-each pull)
 * @return         the (possibly rewritten) arm, or an error when the element type is unnameable
 */
fn resolve_foreach_arm(a: parser::Arm, subject: Type): parser::Arm | error {
    if !is_foreach_elem_placeholder(a.pattern) { return a }
    var bp = match a.pattern { parser::BindPattern as b => b; _ => return a }
    var inner = strip_null_member_or_self(subject)
    var tn = match elem_type_name(inner) { str as s => s; error as e => return e }
    var segs = teko::list::push(teko::list::empty(), parser::Segment { name = tn })
    var real = parser::BindPattern { type_name = parser::Path { segments = segs }; has_binding = bp.has_binding; binding = bp.binding; is_slice = false; slice_type = null; type_args = teko::list::empty() }
    parser::Arm { pattern = real; has_when = a.has_when; guard = a.guard; body = a.body }
}

/**
 * resolve_foreach_placeholders — complete every arm of a match's arm list (`resolve_foreach_arm`,
 * applied in order) — used ONLY to build the arm list `exhaustive` checks coverage against. A no-op
 * (returns `arms` unchanged) for any match that carries no placeholder.
 *
 * @param arms     the syntactic match arm list
 * @param subject  the match's subject type
 * @return         the (possibly rewritten) arm list, or the first arm's completion error
 */
fn resolve_foreach_placeholders(arms: []parser::Arm, subject: Type): []parser::Arm | error {
    var out: []parser::Arm = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= arms.len { break }
        var ra = match resolve_foreach_arm(arms[i], subject) { parser::Arm as a => a; error as e => return e }
        out = teko::list::push(out, ra)
        i++
    }
    out
}

/**
 * type_foreach_elem_arm — TYPE the for-each pull's element-bind placeholder arm DIRECTLY, bypassing
 * `check_pattern`'s name-based type-RESOLUTION (`bind_pattern_type`/`resolve_named`'s bare-path rule
 * requires the SAME referencing namespace as the type's own declaration — the element type may live
 * elsewhere). Extracts the placeholder's `BindPattern` and the element type in ONE function (mirrors
 * `resolve_foreach_arm`'s shape), binds the element name directly to the ALREADY-KNOWN type (no
 * re-derivation needed — it came straight from `_it`'s resolved return type), types the body against
 * that binding, and the emitted `TArm.pattern` carries a REAL, bare-named `BindPattern`
 * (`elem_type_name`) — so interpreter's `pat_match`/codegen's `emit_pat_binds` see an ORDINARY named
 * bind and need no special case (#517, §5.4.1).
 *
 * @param a        the syntactic placeholder arm
 * @param subject  the match's subject type (a `T | null` union; its non-null member is the
 *                 element type T)
 * @param env      the enclosing type environment
 * @param table    the type table
 * @return         the typed arm, or an error when the pattern is not the expected placeholder
 *                 shape, T is not a nameable element type, or the guard is non-bool
 */
fn type_foreach_elem_arm(a: parser::Arm, subject: Type, env: Env, table: TypeTable): TArm | error {
    var bp = match a.pattern { parser::BindPattern as b => b; _ => return error { message = "internal: for-each placeholder must be a BindPattern" } }
    var inner = strip_null_member_or_self(subject)
    var tn = match elem_type_name(inner) { str as s => s; error as e => return e }
    var e2 = define(env, bp.binding, inner, false)
    var body = match type_block(a.body, e2, table) { TypedBlock as bk => bk; error as err => return err }
    var guard = TExpr { kind = TNumber { is_float = false; value = parser::numint_of_u64(0); fval = 0.0 }; type = Void { }; line = 0; col = 0 }
    if a.has_when {
        var g = match type_expr(a.guard, e2, table) { TExpr as te => te; error as err => return err }
        if !is_bool(g.type) { return error { message = "a `when` guard must be a bool" } }
        guard = g
    }
    var segs = teko::list::push(teko::list::empty(), parser::Segment { name = tn })
    var real = parser::BindPattern { type_name = parser::Path { segments = segs }; has_binding = bp.has_binding; binding = bp.binding; is_slice = false; slice_type = null; type_args = teko::list::empty() }
    TArm { pattern = real; has_when = a.has_when; guard = guard; body = body.stmts }
}

/**
 * type_match_arm — type ONE match arm, routing the for-each desugar's placeholder arm through the
 * bypass (`type_foreach_elem_arm`) and every other arm through the ordinary, unmodified `type_arm`.
 *
 * @param a        the syntactic match arm
 * @param subject  the match's subject type
 * @param env      the enclosing type environment
 * @param table    the type table
 * @return         the typed arm, or an error
 */
fn type_match_arm(a: parser::Arm, subject: Type, env: Env, table: TypeTable): TArm | error {
    if is_foreach_elem_placeholder(a.pattern) { return type_foreach_elem_arm(a, subject, env, table) }
    type_arm(a, subject, env, table)
}

/**
 * ConstructTarget — the resolved prefix of a construction literal (§9 B / §4.1): the CANONICAL type
 * `name` the node is tagged with, its `decl` (whose fields the values type against), and whether the
 * construction is of the ENCLOSING owner type (which bypasses the class-literal owner gate). The prefix
 * forms — `.{ … }` (target-typed), `Foo<A..> { … }` and bare `Foo { … }` — all reduce to one of these.
 */
type ConstructTarget = struct {
    /** the canonical result-type name the `TStructInit` node carries (a phantom `Base__g__…` for a generic owner-self construct). */
    name: str
    /** the declaration whose fields the literal's values are typed against (the abstract template for a phantom instance). */
    decl: parser::TypeDecl
    /** true iff this constructs the ENCLOSING owner type — it is legal inside the owner's own methods, so the class-literal owner gate is bypassed. */
    is_self: bool
}

/**
 * is_dot_sentinel — is `path` the `.{ … }` target-typed construction sentinel (§4.1)? The parser emits
 * a ZERO-segment path for `.{ … }`; every nominal or `self` prefix carries at least one segment, so an
 * empty segment list is an unambiguous marker the checker resolves against the CONTEXT's expected type.
 *
 * @param path  the construction literal's `type_path`
 * @return      true iff `path` is the `.{ … }` (empty) sentinel
 * @since §4.1
 */
fn is_dot_sentinel(path: parser::Path): bool {
    path.segments.len == 0
}

/**
 * dot_no_target_error — the §4.1 "no target type" diagnostic for a `.{ … }` used where the context
 * supplies no single constructible named type (a bare `var x = .{…}`, a scrutinee, a non-Named or
 * union expectation). `.{ … }` never infers by back-flow — the target comes ONLY from the immediate
 * slot — so this fires the moment the resolved `expected` is not a single Named struct/class.
 *
 * @return  the located no-target error
 * @since §4.1
 */
fn dot_no_target_error(): error {
    error { message = "`.{ … }` needs a known target type here — annotate the binding/return or write the type explicitly (`Name { … }`)" }
}

/**
 * dot_construct_target — resolve a `.{ … }` construction (§4.1) to its ConstructTarget from the
 * CONTEXT's `expected` type. The node is stamped with `expected`'s CANONICAL name (the same name the
 * return/slot already carries), so the emitted `TStructInit` widens into the target by exact `type_eq`
 * — this is what closes the self-return gap the retired `self { … }` construct could not. Three shapes
 * of `expected` are constructible: a concrete non-generic struct/class (its own decl types the fields);
 * an already-stamped generic instance `Foo__g__i64` (arity-0, found directly); and a generic-INSTANCE
 * spelling `Foo__g__T` (a phantom carrying an in-scope type-param — e.g. a generic self-return
 * `-> List<T>`), whose ABSTRACT template (found by stem) types the fields and which the mono pass
 * remaps. A bare generic BASE (arity > 0) is constructible ONLY as the ENCLOSING generic owner's
 * `self` return — phantom-stamped as `self { … }` was, so the mono pass remaps it with the concrete
 * instance; any OTHER bare generic base, or any non-Named/union `expected`, has no single target — an
 * honest no-target error.
 *
 * @param expected  the flow-target type resolved from the immediate slot (return / binding / arg / field)
 * @param env       the typing environment (its `owner_type` decides the `is_self` gate)
 * @param table     the folded type table
 * @return          the resolved construction target, or the located no-target error
 * @since §4.1
 */
fn dot_construct_target(expected: Type, env: Env, table: TypeTable): ConstructTarget | error {
    var en = match expected { Named as n => n; _ => return dot_no_target_error() }
    match type_table_find(table, en.name, "") {
        parser::TypeDecl as td => {
            if td.type_params.len > 0 {
                if !dot_targets_owner(en.name, env) { return dot_no_target_error() }
                var phantom = self_inst_spelling(name_last_segment(en.name), td.type_params)
                return ConstructTarget { name = phantom; decl = td; is_self = true }
            }
            ConstructTarget { name = en.name; decl = td; is_self = dot_targets_owner(en.name, env) }
        }
        error => {
            if !name_is_g_instance(en.name) { return dot_no_target_error() }
            var stem = split_generic_instance_name(en.name).stem
            var tmpl = match type_table_find(table, stem, "") { parser::TypeDecl as t => t; error => return dot_no_target_error() }
            ConstructTarget { name = en.name; decl = tmpl; is_self = dot_targets_owner(en.name, env) }
        }
    }
}

/**
 * dot_targets_owner — does a `.{ … }`'s resolved target name the ENCLOSING type (so its class-literal
 * owner gate is bypassed, exactly as a `self`-construction was)? True when there is an owner and the
 * target's base (the generic stem, or the last nominal segment) equals the owner's base. For a struct
 * the gate is never reached, so this only matters for a class self-factory; a `.{ … }` targeting a
 * DIFFERENT class than the owner stays gated.
 *
 * @param name  the target type's canonical name
 * @param env   the typing environment (its `owner_type` names the enclosing type)
 * @return      true iff `name` is (an instance of) the enclosing owner type
 * @since §4.1
 */
fn dot_targets_owner(name: str, env: Env): bool {
    if env.owner_type == "" { return false }
    named_case_name(name) == named_case_name(env.owner_type)
}

/**
 * self_return_named — the canonical Named type a `-> self` return resolves to (§4.1): the enclosing
 * type's canonical name, PHANTOM-stamped (`Cell__g__T`) when the owner is generic so it matches the
 * `Cell__g__T` a `.{ … }` self-construction stamps, letting the mono pass remap the return and the
 * construction together. A non-generic owner keeps its plain canonical name (byte-identical to the
 * previous `qualify(ns, name)`). This closes the generic-owner half of the self-return gap: a generic
 * `-> self` previously returned the BARE base, which no construction of the owner could widen into.
 *
 * @param struct_name  the enclosing type's bare name (`td.name`)
 * @param cur_ns       the enclosing namespace
 * @param table        the folded type table
 * @return             the canonical (phantom for a generic owner) self-return type
 * @since §4.1
 */
fn self_return_named(struct_name: str, cur_ns: str, table: TypeTable): Type {
    var canon = qualify(cur_ns, struct_name)
    match type_table_find(table, canon, "") {
        parser::TypeDecl as td => if td.type_params.len == 0 { Named { name = canon } } else { Named { name = self_inst_spelling(name_last_segment(canon), td.type_params) } }
        error => Named { name = canon }
    }
}

/**
 * is_error_literal_prefix — does `sl` construct the one builtin constructible type, `error { message
 * = <str> }` (B.1)? A bare single-segment `error` with no explicit type-arguments; `error` is a
 * reserved builtin name no user type can shadow, so the syntactic test matches `builtin_type`.
 *
 * @param sl  the construction literal
 * @return    true iff `sl` is an `error { … }` literal
 * @since §9 B
 */
fn is_error_literal_prefix(sl: parser::StructLit): bool {
    sl.type_args.len == 0 && sl.type_path.segments.len == 1 && sl.type_path.segments[0].name == "error"
}

/**
 * type_error_literal — type the builtin `error { message = <str> }` construction (B.1), the one
 * non-Named constructible type: exactly one `message` field, whose value must be a `str`.
 *
 * @param sl     the `error { … }` literal
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed `error` init node, or a located error
 * @since §9 B (extracted from type_struct_lit)
 */
fn type_error_literal(sl: parser::StructLit, env: Env, table: TypeTable): TExpr | error {
    if sl.field_names.len != 1 || sl.field_names[0] != "message" {
        return error { message = "`error` is constructed as `error { message = <str> }` (one `message` field)" }
    }
    var v = match type_expr(sl.field_vals[0], env, table) { TExpr as te => te; error as e => return e }
    match v.type { Str => { }; _ => return error { message = "`error`'s `message` must be a `str`" } }
    var enames = teko::list::push(teko::list::empty(), "message")
    var evals = teko::list::push(teko::list::empty(), v)
    TExpr { kind = TStructInit { field_names = enames; field_vals = evals }; type = Error { }; line = 0; col = 0 }
}


/**
 * explicit_inst_target — resolve a `Foo<A..> { … }` construction (§9 B, ruling 4): the explicit
 * type-arguments name the concrete instance `Foo__g__…` (arity-selectively — no partial application),
 * which the node is tagged with. When the annotation names ANOTHER instance of the same generic base
 * the two must agree. The concrete stamped decl types the fields; a not-yet-stamped PHANTOM instance
 * (a generic constructing a different generic from its own `T`) keeps the abstract template decl.
 *
 * @param sl        the construction literal (`type_args` non-empty)
 * @param expected  the flow-target type — checked for agreement with the explicit instance only
 * @param env       the typing environment
 * @param table     the folded type table
 * @return          the explicit-instance construction target, or a located error
 * @since §9 B
 */
fn explicit_inst_target(sl: parser::StructLit, expected: Type, env: Env, table: TypeTable): ConstructTarget | error {
    var stem = sl.type_path.segments[sl.type_path.segments.len - 1].name
    var gte = parser::NamedType { path = sl.type_path; args = sl.type_args }
    var git = match resolve_type(gte, table, env.cur_ns) { Type as t => t; error as e => return e }
    var ginst = match git { Named as gn => gn.name; _ => return error { message = "explicit type-arguments did not resolve to a struct instance" } }
    match expected {
        Named as en => { if name_has_generic_base(en.name, stem) && en.name != ginst { return error { message = "the explicit type-arguments at construction disagree with the annotated type" } } }
        _ => { }
    }
    match type_table_find(table, ginst, "") {
        parser::TypeDecl as td => ConstructTarget { name = ginst; decl = td; is_self = false }
        error => {
            if !name_is_phantom_instance(ginst, table) {
                return error { message = $"internal: generic instance `{ginst}` was not stamped" }
            }
            var tmpl = match type_table_find_arity(table, stem, sl.type_args.len) { parser::TypeDecl as t => t; error as e => return e }
            ConstructTarget { name = ginst; decl = tmpl; is_self = false }
        }
    }
}

/**
 * bare_construct_target — resolve a bare `Foo { … }` construction (§9 B, ruling 4/7): a bare prefix
 * is ARITY-0 ALWAYS, so it names the arity-0 declaration and NEVER borrows type-args from `expected`
 * (a bare use of a name that exists only as a generic is a diagnosed error inside `resolve_named`).
 *
 * @param sl     the construction literal (no explicit type-args, not `self`, not `error`)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the arity-0 construction target, or a located error
 * @since §9 B
 */
fn bare_construct_target(sl: parser::StructLit, env: Env, table: TypeTable): ConstructTarget | error {
    var nt = match resolve_named(sl.type_path, table, env.cur_ns, 0) { Type as t => t; error as e => return e }
    var canon = match nt { Named as n => n.name; _ => return error { message = "a struct literal requires a named struct type" } }
    var decl = match type_table_find_arity(table, canon, 0) {
        parser::TypeDecl as td => td
        error => return error { message = $"unknown type in a struct literal: {canon}" }
    }
    ConstructTarget { name = canon; decl = decl; is_self = false }
}

/**
 * construct_target — dispatch a construction literal's PREFIX (§9 B / §4.1) to its resolved
 * ConstructTarget: `.{ … }` (target-typed — resolved from `expected`), `Foo<A..> { … }`, or bare
 * `Foo { … }`. Every prefix but `.{ … }` decides its OWN arity — there is no nameless `{ … }`
 * construction and a bare prefix never borrows arity from the flow target; only `.{ … }` reads the
 * target from `expected` (and errors when the context supplies none). The retired `self { … }` prefix
 * is gone (§4.1) — `self` is only a receiver / a type.
 *
 * @param sl        the construction literal
 * @param expected  the flow-target type: the whole target for `.{ … }`, else only an explicit-instance
 *                  agreement check
 * @param env       the typing environment
 * @param table     the folded type table
 * @return          the resolved construction target, or a located error
 * @since §9 B (§4.1 replaces the `self { … }` sentinel with the `.{ … }` one)
 */
fn construct_target(sl: parser::StructLit, expected: Type, env: Env, table: TypeTable): ConstructTarget | error {
    if is_dot_sentinel(sl.type_path) { return dot_construct_target(expected, env, table) }
    if sl.type_args.len > 0 { return explicit_inst_target(sl, expected, env, table) }
    bare_construct_target(sl, env, table)
}

/**
 * type_struct_lit — type a construction literal (§9 B / §4.1): `Foo { … }` (arity 0), `Foo<i64> { … }`
 * (name + explicit type-args) or `.{ … }` (target-typed — resolved from `expected`). There is NO
 * nameless `{ … }` construction — a bare `{` in expression position is always a block. A NOMINAL prefix
 * decides the arity: a bare `Foo` resolves the ARITY-0 declaration always (never borrowing type-args
 * from `expected`, ruling 7); `Foo<A..>` resolves the instance at that arity. A `.{ … }` prefix reads
 * its whole target from `expected` (a concrete type, a stamped instance, or a generic owner-self
 * phantom). The builtin `error { message = <str> }` is the one non-Named constructible type. Once the
 * prefix is resolved the shared tail requires EXACTLY the declared fields (once each — M.1), checks
 * per-field value types, and emits the typed children in the struct's DECLARED order so codegen lowers
 * identically for every prefix.
 *
 * @param sl        the parsed construction literal (`type_path` = the empty `.{ … }` sentinel for a
 *                  target-typed construction)
 * @param expected  the flow-target type — the WHOLE target for `.{ … }`; for a nominal prefix, used
 *                  ONLY for an explicit instance's agreement check and a field value's nested
 *                  expectation, NEVER to retarget a bare generic prefix (ruling 7)
 * @param env       the typing environment (its `owner_type` gates a same-owner class construction)
 * @param table     the collected type table
 * @return          the typed `TStructInit`, or a located error
 * @since §9 B (rewrites the W4a/S4/W9.4 construction path)
 */
fn type_struct_lit(sl: parser::StructLit, expected: Type, env: Env, table: TypeTable): TExpr | error {
    if is_error_literal_prefix(sl) { return type_error_literal(sl, env, table) }
    var ct = match construct_target(sl, expected, env, table) { ConstructTarget as c => c; error as e => return e }
    var name = ct.name
    var decl = ct.decl
    var is_self_construct = ct.is_self
    // (W10b.CLASS) `Name { … }` also constructs a class instance — a class's fields are typed
    // identically to a struct's (increment 2: the EFFECTIVE, base-inherited fields too). An
    // `abstract` class cannot be instantiated directly (only a concrete subclass may be — it is
    // final, incomplete-by-design).
    var sb_fields = match decl.body {
        parser::StructBody as s => s.fields
        parser::ClassBody as c => {
            match c.kind { ClassKind::Abstract => return error { message = $"`{name}` is abstract and cannot be instantiated directly" }; _ => { } }
            // (W10b.D1) invariant-safe construction — a class's `{…}` literal is legal ONLY inside
            // the class's OWN methods (its static factories and instance methods), so the
            // arena-per-object and the class's invariants stay inviolable from outside code.
            // `env.owner_type` is the DECLARING class of the method body currently being typed
            // ("" outside any method) — a purely inherited method keeps its ORIGINAL declaring
            // class (type_struct_methods), so a base factory constructing the base stays legal when
            // re-typed under a derived class. Structs are pure value data: their literals stay free.
            if !is_self_construct && name_last_segment(env.owner_type) != name_last_segment(name) {
                return error { message = $"a class literal is only legal inside the class's own methods — construct it via a static factory: {name}" }
            }
            match effective_class_fields(c, table) { []parser::Field as fs => fs; error as e => return e }
        }
        // (TR0) a trait is NON-instantiable — it exists only to be derived. Point at the fix.
        parser::TraitBody => return error { message = $"'{name}' is a trait and cannot be instantiated — derive it from a struct or class instead (`type X = struct {name} …`)" }
        _ => return error { message = $"struct-literal target {name} is not a struct" }
    }
    if sl.field_names.len != sb_fields.len { return error { message = "a struct literal must set exactly the declared fields (count mismatch)" } }

    var names: []str = teko::list::empty()
    var vals: []TExpr = teko::list::empty()
    var d = 0
    loop {
        if d >= sb_fields.len { break }
        var fname = sb_fields[d].name
        // locate the provided value for this declared field (count its hits for missing/dup checks).
        var found = sl.field_names.len
        var hits = 0
        var i: u64 = 0   // u64 index (so `found = i` matches found's u64 type; mirrors the C twin's size_t)
        loop {
            if i >= sl.field_names.len { break }
            if sl.field_names[i] == fname { found = i; hits++ }
            i++
        }
        if hits == 0 { return error { message = "a struct literal is missing a declared field" } }
        if hits > 1 { return error { message = "a struct literal sets a field more than once" } }
        var ft = match resolve_type(sb_fields[d].type_ann, table, type_ns_of(table, name)) { Type as t => t; error as e => return e }   // (#109 W2) field annotation resolves in the struct's OWN ns
        // thread the field's type as EXPECTED so a nested generic constructor (`value = Box { … }`)
        // targets its concrete instance (S4). Non-struct-lit values type exactly as before.
        var val = match type_value_expected(sl.field_vals[found], ft, env, table) { TExpr as te => te; error as e => return e }
        // literal adaptation: a fitting numeric literal adopts the field's prim type.
        match val.kind {
            TNumber as num => match ft {
                Prim as p => {
                    if !type_eq(val.type, ft) {
                        var fits = if num.is_float { prim_is_float(p.kind) }
                        else { prim_is_int(p.kind) && numint_fits(num.value, p.kind) }
                        if fits { val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col } }
                    }
                }
                _ => { }
            }
            _ => { }
        }
        // (#4) a sentinel empty list ADOPTS the field's declared slice type (the field decl is the
        // known element source), so codegen emits the concrete element — no back-inference.
        var val_is_sentinel_slice = match val.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
        var ft_is_concrete_slice = match ft { Slice as fs => match fs.element { Void => false; _ => true }; _ => false }
        if val_is_sentinel_slice {
            if ft_is_concrete_slice {
                val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col }
            }
        }
        // The field value must WIDEN into the field's declared type (exact, a variant CASE into a
        // variant-typed field — keep the case type so codegen's emit_as wraps it — or `T` into a
        // `T?`); OR be a fitting numeric LITERAL that ADOPTS the field type (incl a `byte` field = u8,
        // `lo = 0x80`), in which case the leaf is retyped. Same rules as binding/arg adoption.
        if !widens_into(val.type, ft, table) {
            if literal_adopts(val, ft) {
                val = TExpr { kind = val.kind; type = ft; line = val.line; col = val.col }   // a fitting literal adopts the field's type
            } else {
                return error { message = "a struct-literal field value does not match the field's declared type" }
            }
        }
        names = teko::list::push(names, fname)
        vals = teko::list::push(vals, val)
        d++
    }
    TExpr { kind = TStructInit { field_names = names; field_vals = vals }; type = Named { name = name }; line = 0; col = 0 }
}

// is `mname` a generic INSTANCE of `base` (i.e. it begins with `base` + the `__g__` infix)? Used to
// confirm a generic struct literal matches its annotated instance type before retargeting (S4).
fn name_has_generic_base(mname: str, stem: str): bool {
    var pfx = teko::str::concat(stem, "__g__")
    if mname.len < pfx.len { return false }
    var i = 0
    loop {
        if i >= pfx.len { break }
        if mname[i] != pfx[i] { return false }
        i++
    }
    true
}

// ---- subscript index `recv[index]` (W5-idx) ----
// The receiver is a `str` (-> byte) or a slice `[]T` (-> element type T); the index must be
// an integer prim. str indexing/.len is fully lowered in both backends; slice values can't
// be constructed yet, so a slice index type-checks here but is an honest stop in interpreter/codegen.
fn type_index(ix: parser::Index, env: Env, table: TypeTable): TExpr | error {
    var recv = match type_expr(ix.receiver, env, table) { TExpr as te => te; error as e => return e }
    var idx = match type_expr(ix.index, env, table) { TExpr as te => te; error as e => return e }
    var iowner = value_op_owner(recv.type, table)
    if iowner != "" && owner_has_matching_operator(iowner, "__index", recv, idx, table) {
        return build_operator_call(iowner, "__index", ix.receiver, ix.index, env, table)
    }
    if !is_integer(idx.type) { return error { message = "a subscript index must be an integer" } }
    match recv.type {
        Str => TExpr { kind = TIndex { receiver = recv; index = idx }; type = Byte { }; line = 0; col = 0 }
        Slice as s => TExpr { kind = TIndex { receiver = recv; index = idx }; type = s.element; line = 0; col = 0 }
        Ptr => ptr_opaque_error()
        Uptr => ptr_opaque_error()
        _ => error { message = "cannot index a value of this type" }
    }
}

// is_interp_formattable — ROUND 0 hole types: str, char, bool, byte, error, int, float prims.
fn is_interp_formattable(t: Type): bool {
    match t {
        Str => true
        Char => true
        Byte => true
        Error => true
        Prim => true   // all prim (int, float, bool)
        _ => false
    }
}
fn interp_is_numeric(t: Type): bool {
    match t { Prim as p => true; _ => false }
}

// ---- string interpolation `$"…{expr}…"` (self-host parity) ----
// ROUND 0 expansion: accepts str, char, bool, byte, error, int, float hole types.
// Format specs: static (`:literal`) → validate hole is numeric; dynamic (`:[arg1,…]`) → validate
// each arg is str. Named/variant types with specs → honest-stop. Result type is always `str`.
/**
 * The calendar `to_string` function name for a date/time-shaped hole type, or "" if the hole is
 * not a date/time value.
 *
 * A static format spec on a `Named` hole whose bare type name is `Date`/`date`, `Time`/`time`,
 * or `DateTime`/`datetime` is a CALENDAR PATTERN (`$"{d:yyyy-MM-dd}"`), not a numeric spec; it
 * desugars to a call to the type's own-namespace formatter (`date_to_string` for a date/
 * datetime, `time_to_string` for a time). Recognizing by bare last segment lets a re-declared
 * local `Date`/`Time` (a standalone project cannot `use teko::time`) format identically to the
 * canonical `teko::time` types. BOTH casings are recognized: the PascalCase spelling predates
 * the drop-128 A6 redesign (2026-07-24), which renamed `teko::time`'s own types to lowercase
 * (`date`/`time`/`datetime`) — this stays back-compatible with any pre-existing local
 * re-declaration using the old PascalCase names.
 *
 * @param t  the hole's resolved type
 * @return   "date_to_string" / "time_to_string" for a date/time/datetime hole, else ""
 */
fn datetime_formatter_of(t: Type): str {
    match t {
        Named as n => {
            var bare = name_last_segment(n.name)
            if bare == "Date" || bare == "DateTime" || bare == "date" || bare == "datetime" { return "date_to_string" }
            if bare == "Time" || bare == "time" { return "time_to_string" }
            ""
        }
        _ => ""
    }
}

/**
 * Desugar a Date/Time interpolation hole with a calendar pattern into a `to_string` CALL.
 *
 * Rewrites `$"{d:yyyy-MM-dd}"` into `<ns>::date_to_string(d, "yyyy-MM-dd")` (or `time_to_string`),
 * typed here so codegen and the interpreter see an ordinary str-returning call — both engines then run the
 * SAME pure-Teko formatter, guaranteeing byte-identical output. The raw (un-typed) hole is reused
 * as the receiver so the call's own argument typing applies uniformly.
 *
 * @param raw_hole  the original (un-typed) hole expression
 * @param hole_ns   the namespace qualifier of the hole's Date/Time type ("" for a bare type)
 * @param fn_name   the formatter name from `datetime_formatter_of` (date_to_string/time_to_string)
 * @param pattern   the calendar pattern captured from the static spec
 * @param env       the current typing environment
 * @param table     the resolved type table
 * @return          the typed `to_string` call, or a checker error if it does not resolve
 */
fn desugar_datetime_hole(raw_hole: parser::Expr, hole_ns: str, fn_name: str, pattern: str, env: Env, table: TypeTable): TExpr | error {
    var segs: []parser::Segment = teko::list::empty()
    if hole_ns != "" {
        var qi: u64 = 0
        var seg_start: u64 = 0
        loop {
            if qi + 1 >= hole_ns.len { break }
            if hole_ns[qi] == b':' && hole_ns[qi + 1] == b':' {
                segs = teko::list::push(segs, parser::Segment { name = teko::str::slice(hole_ns, seg_start, qi) })
                qi = qi + 2
                seg_start = qi
            } else { qi++ }
        }
        segs = teko::list::push(segs, parser::Segment { name = teko::str::slice_from(hole_ns, seg_start) })
    }
    segs = teko::list::push(segs, parser::Segment { name = fn_name })
    var pat_expr = parser::Expr { kind = parser::StrLit { text = pattern }; line = 0; col = 0 }
    var args: []parser::Expr = teko::list::push(teko::list::empty(), raw_hole)
    args = teko::list::push(args, pat_expr)
    var arg_names: []str = teko::list::push(teko::list::empty(), "")
    arg_names = teko::list::push(arg_names, "")
    var call = parser::Call { callee = parser::Path { segments = segs }; args = args; arg_names = arg_names; owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() }
    type_call(call, env, table)
}

fn type_interp(in: parser::Interp, env: Env, table: TypeTable): TExpr | error {
    var holes: []TExpr = teko::list::empty()
    var specs: []TFSpec = teko::list::empty()
    var i = 0
    loop {
        if i >= in.holes.len { break }
        var h = match type_expr(in.holes[i], env, table) { TExpr as te => te; error as e => return e }
        var dt_fmt = datetime_formatter_of(h.type)
        if dt_fmt != "" && i < in.specs.len {
            match in.specs[i].kind {
                parser::FSpecStatic as fs => {
                    var hole_ns = match h.type { Named as n => name_qualifier(n.name); _ => "" }
                    var dh = match desugar_datetime_hole(in.holes[i], hole_ns, dt_fmt, fs.s, env, table) { TExpr as te => te; error as e => return e }
                    holes = teko::list::push(holes, dh)
                    specs = teko::list::push(specs, TFSpec { kind = TFSpecNone { } })
                    i++
                    continue
                }
                _ => { }
            }
        }
        if !is_interp_formattable(h.type) {
            return error { message = "interpolation hole type not supported in ROUND 0 (must be str/char/bool/byte/error/int/float)" }
        }
        holes = teko::list::push(holes, h)
        // type-check format spec if present
        if i < in.specs.len {
            var raw_sp = in.specs[i]
            var typed_sp = match raw_sp.kind {
                parser::FSpecNone => TFSpec { kind = TFSpecNone { } }
                parser::FSpecStatic as fs => {
                    if !interp_is_numeric(h.type) {
                        return error { message = "format spec requires a numeric hole (int or float)" }
                    }
                    TFSpec { kind = TFSpecStatic { s = fs.s } }
                }
                parser::FSpecDynamic as fd => {
                    if !interp_is_numeric(h.type) {
                        return error { message = "format spec requires a numeric hole (int or float)" }
                    }
                    var dyn_args: []TExpr = teko::list::empty()
                    var k = 0
                    loop {
                        if k >= fd.args.len { break }
                        var da = match type_expr(fd.args[k], env, table) { TExpr as te => te; error as e => return e }
                        match da.type { Str => { }; _ => return error { message = "dynamic format spec argument must be str" } }
                        dyn_args = teko::list::push(dyn_args, da)
                        k++
                    }
                    TFSpec { kind = TFSpecDynamic { args = dyn_args } }
                }
            }
            specs = teko::list::push(specs, typed_sp)
        } else {
            specs = teko::list::push(specs, TFSpec { kind = TFSpecNone { } })
        }
        i++
    }
    TExpr { kind = TInterp { pieces = in.pieces; holes = holes; specs = specs }; type = Str { }; line = 0; col = 0 }
}

// <expr> in [ e0, e1, … ] (Phase 2) — membership test. Type the lhs ONCE; require each element
// be COMPARABLE to the lhs (the SAME is_comparable rule used by `==`/compare — B.22), since the
// runtime is `lhs == e0 || lhs == e1 || …`. The empty set `x in []` is allowed (result is still
// bool — always false). The node's `.type` is bool. C twin: type_in in expr.c.
fn type_in(n: parser::InExpr, env: Env, table: TypeTable): TExpr | error {
    var lhs = match type_expr(n.lhs, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(lhs.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
    // (MEM Step 0, R4) ESCAPE GATE — `in` has its own element path (it does NOT build an ArrayLit),
    // so the literal-form gate doesn't reach it. A reference may not be an `in` operand (lhs or set
    // element): the [a, b] set is a value-position collection of refs. Mirror in expr.c::type_in.
    if type_contains_ref(lhs.type) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
    var elems: []TExpr = teko::list::empty()
    var i = 0
    loop {
        if i >= n.elems.len { break }
        var el = match type_expr(n.elems[i], env, table) { TExpr as te => te; error as e => return e }
        if type_is_void(el.type) { return error { message = "a `void` expression cannot be an operand (M.1)" } }
        if type_contains_ref(el.type) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
        if !is_comparable(lhs.type, el.type) { return error { message = "`in` element is not comparable to the left-hand operand" } }
        elems = teko::list::push(elems, el)
        i++
    }
    TExpr { kind = TInExpr { lhs = lhs; elems = elems }; type = Prim { kind = PrimKind::Bool }; line = 0; col = 0 }
}

/**
 * array_elem_contrib_type — the type an array element CONTRIBUTES to the literal join: a spread
 * element (`..xs`) contributes its slice's own element type (never itself, since the whole
 * point of a spread is that `[]T` flattens into the unified `T`); any other element contributes
 * its own type directly.
 *
 * @param ae  the typed array element
 * @return    the type this element joins into the array's unified element type
 */
fn array_elem_contrib_type(ae: TArrayElem): Type {
    if ae.is_spread {
        match ae.expr.type { Slice as s => s.element; _ => ae.expr.type }
    } else {
        ae.expr.type
    }
}

/**
 * array_elem_bare_literal — a non-spread element's trailing bare numeric-literal leaf, or `null`
 * when the element is a spread (never a literal candidate — its contribution is already a
 * concrete, previously-typed `T`) or its own expression is not a bare number. The array-literal
 * counterpart of `type_match`'s `match_arm_literal_leaf`: it gates which element is a LITERAL
 * cross-adoption candidate rather than a genuinely concrete (pinned) type.
 *
 * @param ae  the typed array element
 * @return    the element's `TNumber` leaf, or `null`
 */
fn array_elem_bare_literal(ae: TArrayElem): TExpr | null {
    if ae.is_spread { return null }
    match ae.expr.kind { TNumber => ae.expr; _ => null }
}

/**
 * array_join_anchor — the first element's CONTRIBUTED type that is NOT a bare numeric literal, or
 * `null` when every element is a bare literal (so there is no concrete type to adopt into). The
 * array-literal counterpart of `type_match`'s `match_join_anchor`: scans every element up front,
 * so a later concrete element still anchors an EARLIER literal one regardless of source order.
 *
 * @param elems  the typed array elements
 * @return       the anchor type sibling literal elements should adopt, or `null`
 */
fn array_join_anchor(elems: []TArrayElem): Type | null {
    var i = 0
    loop {
        if i >= elems.len { break }
        match array_elem_bare_literal(elems[i]) {
            TExpr => { }
            null => return array_elem_contrib_type(elems[i])
        }
        i++
    }
    null
}

/**
 * adopt_array_elem_literals — rebuild every element whose value is a bare numeric literal that
 * FITS `anchor` (`literal_adopts`) so its leaf is retyped at `anchor` instead of its bare default
 * (`retype_literal`) — the array-literal counterpart of `type_match`'s `adopt_match_arm_literals`,
 * so `[some_i32, 0]` joins to `[]i32`, not the accidental `[]<i32 | i64>` a bare-defaulted literal
 * would otherwise force into the union. An element whose literal does not fit `anchor`, is a
 * spread, or is not a bare literal at all, passes through unchanged.
 *
 * @param elems   the typed array elements
 * @param anchor  the type sibling literal elements adopt into
 * @return        the elements, with every fitting literal leaf retyped at `anchor`
 */
fn adopt_array_elem_literals(elems: []TArrayElem, anchor: Type): []TArrayElem {
    var out: []TArrayElem = teko::list::empty()
    var i = 0
    loop {
        if i >= elems.len { break }
        var ae = elems[i]
        var next = match array_elem_bare_literal(ae) {
            TExpr as t => if literal_adopts(t, anchor) { TArrayElem { is_spread = false; expr = retype_literal(t, anchor) } } else { ae }
            null => ae
        }
        out = teko::list::push(out, next)
        i++
    }
    out
}

/**
 * type_array_lit — `[ e0, e1, … ]` (Increment B+): types every element, cross-adopts a bare
 * numeric-literal element into a sibling's CONCRETE (non-literal) type (`array_join_anchor` +
 * `adopt_array_elem_literals`, mirroring `type_match`'s own literal cross-adoption) and then
 * UNIFIES every element into a common element type T (widening — a case joins into its variant;
 * sibling cases → their union), result `[]T`. An empty `[]` yields the SENTINEL `[]Void` —
 * exactly like `teko::list::empty()` — so a binding annotation (`: []T`) adopts it and a bare
 * unannotated `[]` is rejected by type_binding (collections #4). A spread element (`..xs`) must
 * type as `[]T`; its own element type T contributes to (and widens into) the unified element,
 * and is never itself a literal-adoption candidate. C twin: type_array_lit in expr.c.
 *
 * @param a      the parsed array literal
 * @param env    the enclosing type environment
 * @param table  the resolved type table
 * @return       the typed array literal, or an error
 */
fn type_array_lit(a: parser::ArrayLit, env: Env, table: TypeTable): TExpr | error {
    var typed: []TArrayElem = teko::list::empty()
    var i = 0
    loop {
        if i >= a.elements.len { break }
        var ae = a.elements[i]
        var el = match type_expr(ae.expr, env, table) { TExpr as te => te; error as e => return e }
        if ae.is_spread {
            var spread_elem = match el.type {
                Slice as s => s.element
                _ => return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" }
            }
            if type_is_void(spread_elem) { return error { message = "a spread element cannot be an untyped empty slice" } }
        } else {
            if type_is_void(el.type) { return error { message = "a `void` expression cannot be an array element (M.1)" } }
        }
        typed = teko::list::push(typed, TArrayElem { is_spread = ae.is_spread; expr = el })
        i++
    }
    var elems = match array_join_anchor(typed) { Type as anchor => adopt_array_elem_literals(typed, anchor); null => typed }
    var et: Type = Void { }
    var i2 = 0
    loop {
        if i2 >= elems.len { break }
        var contrib = array_elem_contrib_type(elems[i2])
        if type_is_void(et) { et = contrib } else { et = type_join(et, contrib, table) }
        i2++
    }
    // (MEM Step 0, R4) ESCAPE GATE — an INFERRED element type may not carry a reference. The
    // annotated form `let xs: []Ref<T> = …` is already rejected in resolve, but the inferred
    // element here (e.g. `[r, r]`) only surfaces now. This also rejects `a in [a, b]` (its `[a, b]`).
    if type_contains_ref(et) { return error { message = "a reference cannot be stored in a struct/variant/collection" } }
    // (#83) CONCRETIZE any sibling element still carrying a SENTINEL now that `et` (the join across
    // every element) is settled. `[[], [1]]`'s inner `[]` types as `[]Void` on its own (this fn's
    // own empty-array case, above); type_join now correctly folds `et` to the CONCRETE `[]i64`
    // (the #83 fix), but the individual element's own `TExpr.type` is untouched — it still says
    // `[]Void`, and codegen's array-literal case reads the element type OFF THE NODE ITSELF (not
    // the parent's contribution), so it would still honest-stop. Retype every element whose type
    // is a (possibly nested) sentinel form of the now-concrete `et` — same mechanism as the
    // `push(empty(), x)` base-concretization in type_list_builtin above. Only fires when the
    // element's type is type_eq to et (permissive-equal) AND actually carries a sentinel; a
    // genuinely-narrower case that WIDENS into a wider et (e.g. a case into a declared variant) is
    // left alone — codegen's emit_as wraps that at the use site instead.
    var final_elems = if a.elements.len != 0 && !type_has_sentinel(et) {
        var out: []TArrayElem = teko::list::empty()
        var j = 0
        loop {
            if j >= elems.len { break }
            var ael = elems[j]
            var retyped = !ael.is_spread && type_has_sentinel(ael.expr.type) && type_eq(ael.expr.type, et)
            out = teko::list::push(out, if retyped {
                    TArrayElem { is_spread = ael.is_spread; expr = TExpr { kind = ael.expr.kind; type = et; line = ael.expr.line; col = ael.expr.col } }
                } else {
                    ael
            })
            j++
        }
        out
    } else {
        elems
    }
    TExpr { kind = TArrayLit { elements = final_elems }; type = Slice { element = et }; line = 0; col = 0 }
}

/**
 * member_const_symbol — the deterministic internal name a type-member const is hoisted under and a
 * `TypeName::NAME` reference resolves to (#594 crumb 7): the owning type's CANONICAL name joined to
 * the member by `::`. The hoist pass (`type_type_member_consts`) and the resolver (`find_member_const`)
 * both compute it from the SAME canonical type name, so a scalar reference matches the inliner's
 * substitution table and an aggregate reference matches the interned rodata symbol.
 *
 * @param type_canonical  the owning type's canonical (`ns::Name`) identity
 * @param member          the member const's own name
 * @return                the hoisted const's program-unique name
 * @since #594
 */
fn member_const_symbol(type_canonical: str, member: str): str {
    teko::str::concat(type_canonical, teko::str::concat("::", member))
}

/**
 * MemberConstHit — a resolved static member const TOGETHER WITH the type whose OWN body actually
 * declares it (#594 crumb 7 visibility fix). Walking a subclass's base chain can resolve a const
 * declared several levels up (`Sub::SECRET` reaching a `Base`-declared const); `private` reach must
 * gate on THAT declaring type's namespace, never the path's leading (possibly-derived) type's — a
 * private base const must not leak cross-namespace through an unrelated subclass's name.
 *
 * @param cd         the resolved member const declaration
 * @param declaring  the type whose OWN body declares `cd` (the nearest one — shadowing wins)
 */
type MemberConstHit = struct { cd: parser::ConstDecl; declaring: parser::TypeDecl }

/**
 * resolve_member_const_hit — the nearest static member const named `seg` reachable from `owner`,
 * walking the base chain (a subclass inherits a base's member const by name; a nearer declaration
 * shadows a farther one — static hiding, D6) (#594 crumb 7), together with the type that ACTUALLY
 * declares it. Checks `owner`'s OWN consts FIRST (struct/class/trait bodies alike — shadowing), only
 * recursing into a class's base when its own body declares no such name. Returns null when no member
 * const named `seg` exists on the type or its bases.
 *
 * @param owner  the type to resolve from (struct/class/abstract/trait)
 * @param seg    the last path segment (the member const's name)
 * @param table  the type table (to follow a class's base chain)
 * @return       the resolved const plus its actual declaring type, or null when not found
 * @since #594
 */
fn resolve_member_const_hit(owner: parser::TypeDecl, seg: str, table: TypeTable): MemberConstHit | null {
    var own = body_consts(owner.body)
    var i: u64 = 0
    loop {
        if i >= own.len { break }
        if own[i].name == seg { return MemberConstHit { cd = own[i]; declaring = owner } }
        i++
    }
    match owner.body {
        parser::ClassBody as cb => {
            if !cb.has_base { return null }
            var base_decl = match type_table_find(table, cb.base_name, "") { parser::TypeDecl as td => td; error => return null }
            resolve_member_const_hit(base_decl, seg, table)
        }
        _ => null
    }
}

/**
 * member_const_visible — enforce a static member const's reach at a `TypeName::NAME` use site (#594
 * crumb 7): a `Private` member const is reachable ONLY from its DECLARING module's namespace — NEVER
 * the path's leading type's namespace, so `Sub::SECRET` (a private const declared on a `Base` in a
 * different namespace) is rejected even though `Sub` inherits the name. `Pub`/`Exp` reach across
 * namespaces (the `Exp` public-ABI distinction is exercised cross-module at crumb 8).
 *
 * @param hit     the resolved member const + its actual declaring type
 * @param table   the type table (to read the declaring type's namespace)
 * @param ref_ns  the namespace the `TypeName::NAME` reference is written in
 * @return        null when the access is allowed, else a located visibility error
 * @since #594
 */
fn member_const_visible(hit: MemberConstHit, table: TypeTable, ref_ns: str): error | null {
    match hit.cd.vis {
        parser::Visibility::Private => {
            var decl_ns = type_ns_of(table, hit.declaring.name)
            if decl_ns != ref_ns {
                return teko::error::err_loc(error { message = $"member const `{hit.cd.name}` is private to `{hit.declaring.name}` — mark it `pub`/`exp` to use it from another module" }, hit.cd.line, hit.cd.col)
            }
            null
        }
        _ => null
    }
}

/**
 * find_member_const — resolve `TypeName::NAME` to a REFERENCE to its static member const (#594 crumb
 * 7): a `TVar` bound to the hoisted const's program-unique name (the same name `type_type_member_consts`
 * emits, keyed on the PATH's leading type — the hoist re-materializes an inherited const once per
 * owning type, exactly like an inherited method is re-emitted per class), typed with the const's
 * declared type. `func_ns` is stamped to `owner_ns` — the SAME namespace `type_type_member_consts`
 * stamps its hoisted `TConstDecl.namespace` with (both derive from the type's own declaring
 * namespace) — so the c8b `(name, namespace)`-keyed scalar/aggregate inliner's ref key matches the
 * hoisted const's key and actually substitutes it. An empty `func_ns` here (the regression a
 * positive-fixture e2e build exposed) matches the hoist ONLY at the root namespace ("" == ""); any
 * type declared in a non-root namespace then never substitutes, so the reference survives to codegen
 * as the raw `sym` (a `"Type::NAME"`-shaped string embedding `::`) emitted verbatim as a C
 * identifier — invalid syntax the C compiler rejects. The inliner then substitutes a scalar's value
 * or the aggregate's rodata address. Returns null when no such member const exists, so
 * `type_path_expr` falls through to the enum-member arm.
 *
 * @param owner  the resolved leading type (struct/class/abstract/trait)
 * @param seg    the last path segment (the member const's name)
 * @param table  the type table (to follow the base chain + read each body's consts)
 * @return       the typed reference to the member const, or null when not found
 * @since #594
 */
fn find_member_const(owner: parser::TypeDecl, seg: str, table: TypeTable): TExpr | null {
    var hit = match resolve_member_const_hit(owner, seg, table) { MemberConstHit as h => h; null => return null }
    var owner_ns = type_ns_of(table, owner.name)
    var rty = match resolve_type(hit.cd.ty, table, owner_ns) { Type as t => t; error => return null }
    var sym = member_const_symbol(qualify(owner_ns, owner.name), seg)
    TExpr { kind = TVar { name = sym; is_func = false; func_ns = owner_ns }; type = rty; line = 0; col = 0 }
}

/**
 * ns_value_visible — enforce a namespace-qualified value's cross-module reach (#594 crumb 8c, issue
 * #613): a `private` module-level const is reachable ONLY from its OWN declaring namespace, so
 * `ns::NAME` naming a private const from a DIFFERENT namespace is a located visibility error — the
 * qualified spelling never widens a private const's reach (the module-level twin of
 * `member_const_visible`, D4/D6). A `pub`/`exp` value reaches across namespaces, and a reference from
 * the const's own namespace is allowed. A dep's private const never reaches here — it is not seeded
 * across the module boundary (`seed_dep_consts`), so it fails to resolve first.
 *
 * @param b       the resolved value binding
 * @param ref_ns  the namespace the `ns::NAME` reference is written in
 * @return        null when the access is allowed, else a visibility error (located at the use site by
 *                the `type_expr` wrapper)
 * @since #594
 */
fn ns_value_visible(b: ValBinding, ref_ns: str): error | null {
    match b.vis {
        parser::Visibility::Private => {
            if b.ns != ref_ns {
                return error { message = $"const `{b.name}` is private to `{b.ns}` — mark it `pub`/`exp` to use it from another module" }
            }
            null
        }
        _ => null
    }
}

/**
 * type_ns_qualified_value — the namespace-qualified VALUE fallback of `type_path_expr`, reached only
 * when the path's leading qualifier does NOT resolve as a type, so `ns::NAME` names a module-level
 * value — a `pub`/`exp` const or a top-level fn-value declared in namespace `ns` — rather than a
 * `Type::Member`. Emits the SAME `TVar` a bare reference produces, stamping `func_ns` with the value's
 * OWN full declaring namespace (`b.ns`, which the short written qualifier selects by the ends-with
 * rule) — never the short qualifier — so the c8b `(name, namespace)`-keyed scalar inliner substitutes
 * a qualified const identically and a qualified fn-value lowers to its `tk_closure` mangle. A name
 * that resolves as NEITHER a type nor a value
 * surfaces the ORIGINAL type-resolution error `type_err` (backward-compatible with the pre-#613
 * `unknown type` diagnostic) (#594 crumb 8c, issue #613).
 *
 * @param pe        the parsed path expression
 * @param member    the path's last segment (the value's bare name)
 * @param type_err  the type-resolution error to surface when no value binding matches either
 * @param env       the type-checking environment (value bindings + `cur_ns`)
 * @return          the typed value reference, or a located error
 * @throws          a visibility error for a `private` cross-namespace const, else `type_err`
 * @since #594
 */
fn type_ns_qualified_value(pe: parser::PathExpr, member: str, type_err: error, env: Env): TExpr | error {
    var qualifier = path_qualifier(pe.path, pe.path.segments.len - 1)
    var b = match lookup_value_in_ns(env, member, qualifier) { ValBinding as vb => vb; error => return type_err }
    match ns_value_visible(b, env.cur_ns) { error as e => return e; null => { } }
    var is_fn = b.ns.len > 0 && (match b.type { Func => true; _ => false })
    TExpr { kind = TVar { name = member; is_func = is_fn; func_ns = b.ns }; type = b.type; line = 0; col = 0 }
}

/**
 * type_path_expr — type a two-segment path used as a VALUE. Resolution order: (1) a member const
 * `Owner::NAME` when the leading path resolves to a struct/class/abstract/trait type (walks the base
 * chain); (2) an enum member `E::M` (value = its declaration ordinal); (3) a flags member `E::M`
 * (value = `1 << ordinal`, the bit index); (4) a namespace-qualified value `ns::NAME` — a `pub`/`exp`
 * module const or a top-level fn-value in module `ns` — reached only when the leading qualifier is NOT
 * a type (`type_ns_qualified_value`). Each backend lowers the enum/flags node without re-lookup (it
 * carries the resolved member `value`), and the namespace arm reuses the bare-reference `TVar` shape
 * so the const inliner and closure mangler need no qualified-specific path (#50, #594 crumb 8c).
 *
 * @param pe     the parsed path expression
 * @param table  the type table (enum/flags/member-const resolution)
 * @param env    the type-checking environment (value-binding lookup + the reference's `cur_ns`)
 * @return       the typed value reference, or a located error
 * @throws       when the path names no reachable member const, enum/flags member, or namespace value
 * @since #50
 */
fn type_path_expr(pe: parser::PathExpr, table: TypeTable, env: Env): TExpr | error {
    var p = pe.path
    if p.segments.len < 2 { return error { message = "a path expression must name an enum or flags member (`Type::Member`)" } }
    var member = p.segments[p.segments.len - 1].name
    var segs: []parser::Segment = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= p.segments.len - 1 { break }
        segs = teko::list::push(segs, p.segments[i])
        i++
    }
    var et = match resolve_named(parser::Path { segments = segs }, table, env.cur_ns, 0) {
        Type as t => t
        error as e => return type_ns_qualified_value(pe, member, e, env)
    }
    var tname = match et { Named as n => n.name; _ => return error { message = "`Type::Member` requires a named enum or flags type" } }
    var decl = match type_table_find(table, tname, "") { parser::TypeDecl as td => td; error => return error { message = $"unknown type in a `Type::Member` path: {tname}" } }
    match resolve_member_const_hit(decl, member, table) {
        MemberConstHit as hit => {
            match member_const_visible(hit, table, env.cur_ns) { error as e => return e; null => { } }
            match find_member_const(decl, member, table) { TExpr as mref => return mref; null => { } }
        }
        null => { }
    }
    match decl.body {
        parser::EnumBody as eb => {
            var j: u64 = 0
            loop {
                if j >= eb.members.len { break }
                if eb.members[j] == member { return TExpr { kind = TPathExpr { enum_name = tname; member = member; ordinal = j; value = j }; type = et; line = 0; col = 0 } }
                j++
            }
            error { message = $"no member `{member}` in enum `{tname}`" }
        }
        parser::FlagsBody as fb => {
            if fb.members.len > 64 { return error { message = "a flags type may declare at most 64 members (bit 63 is the last) — write this as two flags types instead" } }
            var j: u64 = 0
            loop {
                if j >= fb.members.len { break }
                if fb.members[j] == member { return TExpr { kind = TPathExpr { enum_name = tname; member = member; ordinal = j; value = (1 to u64) << j }; type = et; line = 0; col = 0 } }
                j++
            }
            error { message = $"no member `{member}` in the flags type `{tname}`" }
        }
        _ => error { message = "`Type::Member` requires an `enum` or `flags` type" }
    }
}

/**
 * type_borrow_expr — type the prefix `&x` safe-borrow expression (AL wave F1.2). The operand must
 * be an LVALUE (currently: a bare variable — field/index lvalues are deferred to a later crumb) AND
 * a `mut` binding: taking a reference to an immutable local would give the reference no way to
 * mutate anything, and `&(let)` in a mutable-consuming position must be rejected (F2) — both are
 * enforced HERE, at the borrow site, the same rule the auto-ref path (`f.params[i] as Reference`
 * above) already applies to an implicit `ref<T>` argument. The resolved type is `Reference { inner =
 * operand.type }`.
 *
 * @param b      the parsed borrow node
 * @param env    the type environment
 * @param table  the type table
 * @return       the typed borrow, or an error naming the non-mutable/non-lvalue operand
 * @throws       when the operand fails to type, is not a bare `TVar`, or names a non-`mut` binding
 */
fn type_borrow_expr(b: parser::Borrow, env: Env, table: TypeTable): TExpr | error {
    var to = match type_expr(b.operand, env, table) { TExpr as x => x; error as e => return e }
    if is_ptr_or_uptr(to.type) { return ptr_opaque_error() }
    match to.kind {
        TVar as v => match lookup_binding(env, v.name) {
            ValBinding as vb => {
                if !vb.is_mut { return error { message = $"cannot take a reference to immutable `{v.name}` — declare it `mut`/`var` (a borrow needs a mutable target)" } }
                TExpr { kind = TBorrow { operand = to }; type = Reference { inner = to.type }; line = 0; col = 0 }
            }
            error as e => e
        }
        _ => error { message = "only a mutable variable can be borrowed with `&` (an lvalue) — got a non-lvalue expression" }
    }
}

// (C1-POS) inner dispatch — the raw match over the untyped Expr's `kind`. The public type_expr
// (below) wraps this to copy each node's source position onto the typed node. The dispatch's
// TExpr constructions are built with line=0/col=0 (designated-init parity with the C twin); the
// wrapper overwrites them with the real e.line/e.col on success.
fn type_dispatch(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match e.kind {
        parser::Number as n => type_number(n)
        parser::StrLit as s => type_strlit(s)
        parser::ByteLit as b => type_bytelit(b)
        parser::CharLit as c => type_charlit(c)
        parser::BoolLit as bl => type_boollit(bl)
        parser::NullLit as nl => type_nulllit(nl)
        parser::Var as v => type_var(v, env)
        parser::Binary as b => type_binary(b, env, table)
        parser::Unary as u => type_unary(u, env, table)
        parser::Compare as c => type_compare(c, env, table)
        parser::Call as cl => {
            match svc_guard_arg_list(cl.args) { error as e => return e; null => { } }
            type_call(cl, env, table)
        }
        parser::IfExpr as f => type_if(f, env, table)
        parser::MatchExpr as m => type_match(m, env, table)
        parser::FieldAccess as fa => type_field_access(fa, env, table)
        parser::Cast as c => type_cast(c, env, table)
        parser::MethodCall as mc => {
            // (C8.3) flags helper methods are typed here; (OOP A1) struct instance methods
            // dispatch to type_method_call; anything else remains deferred. Mirror of expr.c's
            // TK_EXPR_METHOD_CALL case (the receiver is probed once for the flags check, then
            // re-typed inside whichever branch actually handles the call).
            match svc_guard_arg_list(mc.args) { error as e => return e; null => { } }
            match type_expr(mc.receiver, env, table) {
                TExpr as te => {
                    if is_ptr_or_uptr(te.type) {
                        match type_ptr_wrap(mc, te.type, env, table) {
                            TExpr as we => we
                            error as e => e
                            NotPtrOp => error { message = $"the opaque `{type_render(te.type)}` has only `__wrap<T>()` — got `.{mc.method}(…)`" }
                        }
                    } else if is_flags_named(te.type, table) {
                        if flags_named_has_user_method(te.type, mc.method, table) { type_method_call(mc, env, table) } else { type_flags_method(mc, env, table) }
                    } else { type_method_call(mc, env, table) }
                }
                error => type_method_call(mc, env, table)   // let it re-type and surface the real error
            }
        }
        parser::PathExpr as pe => type_path_expr(pe, table, env)
        parser::StructLit as sl => type_struct_lit(sl, Void { }, env, table)   // W4a (no expected type in expr position)
        parser::Index as ix => type_index(ix, env, table)   // W5-idx
        parser::Interp as in => type_interp(in, env, table)   // $"…{expr}…"
        parser::InExpr as n => type_in(n, env, table)   // <expr> in [ … ] (Phase 2)
        parser::ArrayLit as a => type_array_lit(a, env, table)   // [ e0, e1, … ] (Increment B+)
        parser::Lambda as lam => type_lambda(lam, Void { }, env, table)   // (W10) no target here → un-annotated params error (ruling 3); a binding/call-arg threads the target
        parser::Borrow as b => type_borrow_expr(b, env, table)   // &x safe borrow (AL wave F1)
        parser::Block as blk => type_block_expr(blk, env, table)
    }
}

/**
 * type_block_expr — type a Block-B in value position (§9 E, ruling 7). The body is typed in a CHILD
 * scope (`type_block`) so its bindings do not leak into the enclosing environment; the block's VALUE
 * is the type of its trailing value (`tblock_type`). A block that diverges or whose trailing value is
 * `void` cannot occupy value position — an honest error, the same contract `type_if` imposes on an
 * `if`-as-value without an `else`. The body runs INLINE in the enclosing frame (no capture, no lift),
 * so later passes walk it as an ordinary statement block, not as a lifted closure.
 *
 * @param blk    the parsed Block-B
 * @param env    the enclosing type environment (the block reads it directly — no capture)
 * @param table  the folded type table
 * @return       the block's `TExpr` (kind `TBlockExpr`, type = trailing value), or a located error
 * @throws       when the block diverges or its trailing value is `void` in value position
 * @since        §9 E
 */
fn type_block_expr(blk: parser::Block, env: Env, table: TypeTable): TExpr | error {
    var tb = match type_block(blk.body, env, table) { TypedBlock as bk => bk; error as e => return e }
    if tblock_diverges(tb.stmts) { return error { message = "a block used as a value cannot diverge — it must end in a value expression" } }
    var vt = tblock_type(tb.stmts)
    if type_is_void(vt) { return error { message = "a block used as a value must end in a value expression, not a statement" } }
    TExpr { kind = TBlockExpr { body = tb.stmts }; type = vt; line = 0; col = 0 }
}

// (C1-POS/E1/E2) public entry — wrap the dispatch to thread the source position. On success, copy
// the untyped node's line/col onto the typed node so later passes (and the renderer) can point at
// it (mirrors the C twin's tk_typer_expr). On failure, stamp THIS expr's position onto the error
// UNLESS it already carries one — the innermost (most specific) expr that set it wins, so `f(g(x))`
// blames the inner `g(x)`/`x`. E2: the error value now carries the position adornments (err_loc +
// the line/col field reads, per the E2 contract), so this half is mirrored — no longer blocked.
fn type_expr(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match type_dispatch(e, env, table) {
        TExpr as te => TExpr { kind = te.kind; type = te.type; line = e.line; col = e.col }
        error as inner => {
            if inner.line == 0 { teko::error::err_loc(inner, e.line, e.col) } else { inner }
        }
    }
}

// ---- the value-type a TYPED block yields: the last stmt's, if an ExprStmt; else void ----
fn tblock_type(stmts: []TStatement): Type {
    if stmts.len == 0 { return Void { } }
    match stmts[stmts.len - 1] {
        TExprStmt as es => es.expr.type
        _ => Void { }
    }
}

/**
 * `tcall_is_diverging_builtin` — is `c` a call to the INJECTED global `panic`/`exit` builtin,
 * as opposed to a same-named callee the resolver actually bound to something else? The bare
 * callee name alone cannot answer this: a project may declare its own `pub fn exit(...)` or a
 * local closure bound to `panic`, and the resolver then targets THAT binding instead of the
 * injected global (`type_call`'s `in_scope` gate). Every non-builtin resolution the resolver can
 * produce for a one-segment callee carries a tell the injected builtin never does: a REAL
 * declared function always resolves to a non-empty `call_ns` (its declaring namespace), and a
 * local closure variable resolves with `is_closure_call` set. The injected builtin alone is
 * constructed with an empty `call_ns`, `is_closure_call = false`, and `is_iface_dispatch = false`
 * (`type_call`'s two `panic`/`exit` injection sites), so checking those three fields — never the
 * name alone — is the same fronteira the lowering/emission passes consume (a `defer` scope
 * replay fires on exactly the calls this predicate names; never duplicate this name list
 * elsewhere).
 *
 * @param c  the typed call
 * @return   true iff `c` targets the injected `panic`/`exit` builtin (not a shadowing user
 *           declaration or local closure of the same bare name)
 */
pub fn tcall_is_diverging_builtin(c: TCall): bool {
    if c.callee.segments.len != 1 { return false }
    if c.call_ns.len != 0 || c.is_closure_call || c.is_iface_dispatch { return false }
    var name = c.callee.segments[0].name
    name == "panic" || name == "exit"
}

/**
 * texpr_diverges — does a TYPED expression DIVERGE (never fall through to a following
 * statement)? True for a call the resolver actually bound to the injected global `panic`/`exit`
 * builtins (`tcall_is_diverging_builtin` — never a same-named user function or closure the
 * resolver bound instead), for a `match` whose EVERY arm diverges, or for an `if`/`else` where
 * BOTH branches diverge. Such an expression yields no value and never falls through, so
 * match-as-value unification (`type_match`) skips it (B.20), and it may stand in for ANY
 * type at a value position (the legislator's ruling: no `never` type).
 *
 * @param e  the typed expression
 * @return   true iff `e` unconditionally terminates the enclosing frame (a panic/exit call, or
 *           a fully-diverging match/if)
 */
pub fn texpr_diverges(e: TExpr): bool {
    match e.kind {
        TCall as c => tcall_is_diverging_builtin(c)
        TMatchExpr as m => {
            if m.arms.len == 0 { return false }
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if !tblock_diverges(m.arms[i].body) { return false }
                i++
            }
            true
        }
        TIfExpr as f => f.has_else && tblock_diverges(f.then_blk) && tblock_diverges(f.else_blk)
        _ => false
    }
}

fn tblock_diverges(stmts: []TStatement): bool {
    if stmts.len == 0 { return false }
    match stmts[stmts.len - 1] {
        TReturn => true
        TBreakStmt => true
        TContinueStmt => true
        TExprStmt as es => {
            if texpr_diverges(es.expr) { return true }   // a trailing panic/exit call diverges
            match es.expr.kind {
                TIfExpr as f => f.has_else && tblock_diverges(f.then_blk) && tblock_diverges(f.else_blk)
                TMatchExpr as m => {
                    if m.arms.len == 0 { return false }
                    var i = 0
                    loop {
                        if i >= m.arms.len { break }
                        if !tblock_diverges(m.arms[i].body) { return false }
                        i++
                    }
                    true
                }
                _ => false
            }
        }
        _ => false
    }
}

// ---- a typed block: thread the env, collect the typed statements ----
fn type_block(stmts: []parser::Statement, env: Env, table: TypeTable): TypedBlock | error {
    var cur = env
    // (#148 R3 DECREE) `out` is a linear chain: born empty, self-append-only, read only after the
    // loop — so every copy-grow frees the superseded buffer (mem::push_fo; paranoid-gated).
    var out: []TStatement = teko::list::empty()
    var i = 0
    loop {
        if i >= stmts.len { break }
        // W5a — a block's TRAILING `if`-with-`else` / `match` is its VALUE (B.20): type it via
        // the VALUE form (type_expr → type_if/type_match) so the block yields the branch type.
        // A trailing `if` WITHOUT `else` can't be a value → stays a statement; `match` is
        // exhaustive so it always yields. Non-tail if/match → statement (value discarded).
        var handled = false
        if i + 1 == stmts.len {
            match stmts[i] {
                ExprStmt as es => {
                    if expr_is_dot_construction(es.expr) && !type_is_void(cur.ret_expected) {
                        var te = match type_dot_tail(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                        out = teko::mem::push_fo(out, TExprStmt { expr = te })
                        handled = true
                    }
                    match es.expr.kind {
                        IfExpr as f => {
                            if f.has_else {
                                var te = match type_expr(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                                out = teko::mem::push_fo(out, TExprStmt { expr = te })
                                handled = true
                            }
                        }
                        MatchExpr => {
                            var te = match type_expr(es.expr, cur, table) { TExpr as x => x; error as e => return e }
                            out = teko::mem::push_fo(out, TExprStmt { expr = te })
                            handled = true
                        }
                        _ => { }
                    }
                }
                _ => { }
            }
        }
        if !handled {
            match stmts[i] {
                MultiBind as mb => {
                    var seq = match type_multibind(mb, cur, table) { TStmtSeq as sq => sq; error as e => return e }
                    out = splice_stmts(out, seq.stmts)
                    cur = seq.env
                    handled = true
                }
                _ => { }
            }
        }
        if !handled {
            var ts = match type_statement(stmts[i], cur, table) { TypedStmt as t => t; error as e => return e }
            out = teko::mem::push_fo(out, ts.node)
            cur = ts.env
        }
        i++
    }
    TypedBlock { stmts = out; env = cur }
}

/**
 * splice_stmts — append every statement of `seq` onto `out`, in order (§9 F). The §9 F multiple-binding
 * desugar produces a flat statement sequence that must land at the SAME scope level as a hand-written
 * binding; this is the one place that flattening happens, shared by the block and top-level statement
 * sequencers.
 *
 * @param out  the accumulating typed-statement list
 * @param seq  the desugared statements to append
 * @return     `out` with every element of `seq` appended in order
 * @since §9 F
 */
fn splice_stmts(out: []TStatement, seq: []TStatement): []TStatement {
    var acc = out
    var i: u64 = 0
    loop {
        if i >= seq.len { break }
        acc = teko::mem::push_fo(acc, seq[i])
        i = i + 1
    }
    acc
}

// ---- if as a VALUE (B.20): cond bool; `else` required; both branches one type ----
fn type_if(f: parser::IfExpr, env: Env, table: TypeTable): TExpr | error {
    var c = match type_expr(f.cond, env, table) { TExpr as te => te; error as e => return e }
    if !is_bool(c.type) { return error { message = "an `if` condition must be a bool" } }
    if !f.has_else { return error { message = "an `if` used as a value needs an `else`" } }
    var tb = match type_block(f.then_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    var eb = match type_block(f.else_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    var tt = tblock_type(tb.stmts)
    var et = tblock_type(eb.stmts)
    // literal cross-adoption (mirrors expr.c type_if): a numeric-literal branch adopts the OTHER
    // branch's numeric type, so `if c { u32_expr } else { 64 }` is u32, not the union u32 | i64.
    var tl = trailing_number(tb.stmts)
    var el = trailing_number(eb.stmts)
    var then_adopts = match tl { TExpr as t => literal_adopts(t, et); null => false }
    if then_adopts { tt = et }
    else {
        var else_adopts = match el { TExpr as t => literal_adopts(t, tt); null => false }
        if else_adopts { et = tt }
    }
    var joined = type_join(tt, et, table)   // widen (a case joins into its variant; siblings → their union)
    TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = true; else_blk = eb.stmts }; type = joined; line = 0; col = 0 }
}

// ---- if as a STATEMENT: cond bool; branches validated; no `else`; value discarded → void ----
fn type_if_stmt(f: parser::IfExpr, env: Env, table: TypeTable): TExpr | error {
    var c = match type_expr(f.cond, env, table) { TExpr as te => te; error as e => return e }
    if !is_bool(c.type) { return error { message = "an `if` condition must be a bool" } }
    var tb = match type_block(f.then_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
    if f.has_else {
        var eb = match type_block(f.else_blk, env, table) { TypedBlock as bk => bk; error as e => return e }
        return TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = true; else_blk = eb.stmts }; type = Void { }; line = 0; col = 0 }
    }
    TExpr { kind = TIfExpr { cond = c; then_blk = tb.stmts; has_else = false; else_blk = tb.stmts }; type = Void { }; line = 0; col = 0 }   // else_blk gated by has_else
}

// ---- one typed arm: pattern extends env; `when` guard bool; body BLOCK typed in that env ----
// The arm body is a STATEMENT BLOCK, typed exactly like an `if` then/else branch (B.20). Its
// value type is the block's trailing-value type (tblock_type), unless the block diverges.
fn type_arm(a: parser::Arm, subject: Type, env: Env, table: TypeTable): TArm | error {
    var e2 = match check_pattern(a.pattern, subject, env, table) { Env as e => e; error as err => return err }
    var body = match type_block(a.body, e2, table) { TypedBlock as bk => bk; error as err => return err }
    var guard = unread_guard_placeholder()
    if a.has_when {
        var g = match type_expr(a.guard, e2, table) { TExpr as te => te; error as err => return err }
        if !is_bool(g.type) { return error { message = "a `when` guard must be a bool" } }
        guard = g
    }
    TArm { pattern = a.pattern; has_when = a.has_when; guard = guard; body = body.stmts }
}

/**
 * match_arm_literal_leaf — the trailing bare numeric-literal leaf of a NON-diverging arm body, or
 * `null` when the arm diverges or its trailing value is not a bare number literal. The `match`
 * counterpart of `type_if`'s `trailing_number`: it gates which arm is a LITERAL cross-adoption
 * candidate rather than a genuinely concrete (pinned) type.
 *
 * @param a  the typed match arm
 * @return   the trailing `TNumber` leaf, or `null`
 */
fn match_arm_literal_leaf(a: TArm): TExpr | null {
    if tblock_diverges(a.body) { return null }
    trailing_number(a.body)
}

/**
 * match_join_anchor — the first non-diverging arm's type that is NOT a bare numeric literal, or
 * `null` when every non-diverging arm trails a bare literal (so there is no concrete type to
 * adopt into). Scans every arm up front, so a later concrete arm still anchors an EARLIER
 * literal arm regardless of source order.
 *
 * @param arms  the typed match arms
 * @return      the anchor type sibling literal arms should adopt, or `null`
 */
fn match_join_anchor(arms: []TArm): Type | null {
    var i = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        if !tblock_diverges(a.body) {
            match match_arm_literal_leaf(a) {
                TExpr => { }
                null => return tblock_type(a.body)
            }
        }
        i++
    }
    null
}

/**
 * adopt_match_arm_literals — rebuild every arm whose trailing value is a bare numeric literal
 * that FITS `anchor` (`literal_adopts`) so its leaf is retyped at `anchor` instead of its bare
 * default (`retype_literal`) — the `match` counterpart of `type_if`'s literal cross-adoption
 * (typer.tks `type_if`), so `match k { i32 as n => n; null => 0 }` joins to `i32`, not the
 * accidental `i32 | i64` a bare-defaulted literal would otherwise force into the union. An arm
 * whose literal does not fit `anchor`, or whose trailing value is not a bare literal, passes
 * through unchanged.
 *
 * @param arms    the typed match arms
 * @param anchor  the type sibling literal arms adopt into
 * @return        the arms, with every fitting literal leaf retyped at `anchor`
 */
fn adopt_match_arm_literals(arms: []TArm, anchor: Type): []TArm {
    var out: []TArm = teko::list::empty()
    var i = 0
    loop {
        if i >= arms.len { break }
        var a = arms[i]
        var next = match match_arm_literal_leaf(a) {
            TExpr as t => if literal_adopts(t, anchor) { TArm { pattern = a.pattern; has_when = a.has_when; guard = a.guard; body = retype_block_trailing(a.body, anchor) } } else { a }
            null => a
        }
        out = teko::list::push(out, next)
        i++
    }
    out
}

/**
 * type_match — `match` as a VALUE (B.15/B.20): types every arm, then unifies the NON-diverging
 * arms' trailing types into the match's own type. A diverging arm (`return`/`panic`/`exit`)
 * yields no value and is skipped in unification; if EVERY arm diverges the match type is void.
 * Before the join, a bare numeric-literal arm cross-adopts a sibling's CONCRETE (non-literal)
 * type (`match_join_anchor` + `adopt_match_arm_literals`), mirroring `type_if`'s own literal
 * cross-adoption.
 *
 * @param m      the parsed match expression
 * @param env    the enclosing type environment
 * @param table  the resolved type table
 * @return       the typed match expression, or an error (non-exhaustive, or an arm's own error)
 */
fn type_match(m: parser::MatchExpr, env: Env, table: TypeTable): TExpr | error {
    var s = match type_expr(m.subject, env, table) { TExpr as te => te; error as e => return e }
    if m.arms.len == 0 { return error { message = "a `match` needs at least one arm" } }
    var typed: []TArm = teko::list::empty()
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var ai = match type_match_arm(m.arms[i], s.type, env, table) { TArm as a => a; error as e => return e }
        typed = teko::list::push(typed, ai)
        i++
    }
    var arms = match match_join_anchor(typed) { Type as anchor => adopt_match_arm_literals(typed, anchor); null => typed }
    var have_type = false
    var first: Type = Void { }
    var j = 0
    loop {
        if j >= arms.len { break }
        if !tblock_diverges(arms[j].body) {
            var t = tblock_type(arms[j].body)
            if !have_type { first = t; have_type = true }
            else { first = type_join(first, t, table) }
        }
        j++
    }
    var rarms = match resolve_foreach_placeholders(m.arms, s.type) { []parser::Arm as a => a; error as e => return e }
    if !exhaustive(rarms, s.type, table, env.cur_ns) { return error { message = "non-exhaustive `match` (cover all cases or add `_`)" } }
    var result = if have_type { first } else { Void { } }
    TExpr { kind = TMatchExpr { subject = s; arms = arms }; type = result; line = 0; col = 0 }
}

// ---- match as a STATEMENT: validate the arms; exhaustiveness forced; value discarded → void ----
fn type_match_stmt(m: parser::MatchExpr, env: Env, table: TypeTable): TExpr | error {
    var s = match type_expr(m.subject, env, table) { TExpr as te => te; error as e => return e }
    var arms: []TArm = teko::list::empty()
    var i = 0
    loop {
        if i >= m.arms.len { break }
        var ai = match type_match_arm(m.arms[i], s.type, env, table) { TArm as a => a; error as e => return e }
        arms = teko::list::push(arms, ai)
        i++
    }
    var rarms = match resolve_foreach_placeholders(m.arms, s.type) { []parser::Arm as a => a; error as e => return e }
    if !exhaustive(rarms, s.type, table, env.cur_ns) { return error { message = "non-exhaustive `match` (cover all cases or add `_`)" } }
    TExpr { kind = TMatchExpr { subject = s; arms = arms }; type = Void { }; line = 0; col = 0 }
}

// ---- statements (the evolved check_* — produce the typed node + advance the env) ----

// Type an expression flowing into a known EXPECTED type: a struct-literal is given that type so a
// generic constructor `Box { … }` targets the concrete instance; anything else types normally. Used
// at the binding level AND for struct-literal field values, so NESTED `Box { value = Box { … } }`
// threads the expected type all the way down (S4 annotation-driven).
fn type_value_expected(e: parser::Expr, expected: Type, env: Env, table: TypeTable): TExpr | error {
    match e.kind {
        parser::StructLit as sl => type_struct_lit(sl, expected, env, table)
        parser::Lambda as lam => type_lambda(lam, expected, env, table)   // (W10) target type → un-annotated closure params infer (ruling 3)
        parser::ArrayLit as al => {
            if is_iface_slice(expected, table) { return type_array_lit_expected(al, expected, env, table) }   // (W10b.D3) []<interface> literal
            adopt_value_to_expected(e, expected, env, table)
        }
        parser::NullLit => {
            if null_widens_into(expected, table) { return TExpr { kind = TNullLit { }; type = Null { }; line = e.line; col = e.col } }
            adopt_value_to_expected(e, expected, env, table)
        }
        _ => adopt_value_to_expected(e, expected, env, table)
    }
}

/**
 * Types a value against a known `expected` target and BORNS a fitting numeric literal (scalar,
 * negative, or one reachable through an `if`/`match`/array composite) at that target — the single
 * context-directed adoption path (M.5). A value already assignable to `expected` keeps its NATURAL
 * type (a variant case stays its case type so codegen's `emit_as` wraps it); otherwise a fitting
 * literal adopts `expected` via `literal_adopts` + `retype_literal` (the same pair `type_assign`
 * uses), so the leaf is born at its narrow width. A non-fitting / non-literal value is returned
 * unchanged for the caller to diagnose (M.1 fail-early messages preserved at the declaration site).
 *
 * @param e         the parsed value expression
 * @param expected  the destination type the literal adopts
 * @param env       the typing environment
 * @param table     the program's type table
 * @return          the typed value, its literal leaves born at `expected` when they fit, else the
 *                  natural-typed value; propagates the first typing error
 */
fn adopt_value_to_expected(e: parser::Expr, expected: Type, env: Env, table: TypeTable): TExpr | error {
    var t = match type_expr(e, env, table) { TExpr as te => te; error as err => return err }
    if assignable_to(t.type, expected, table) { return t }
    if literal_adopts(t, expected) { return retype_literal(t, expected) }
    t
}

/**
 * Does a parameter type accept a context-born literal — a numeric prim, `byte` (= u8), or a slice?
 * Gates whether an `if`/`match`/array ARGUMENT is routed through `type_value_expected` so its
 * literal leaves are born at the parameter's width (closing the args analogue of the assign-path
 * miscompile: an over-`i64` `if`-arm arg must be born at the parameter type, not left `i64`).
 *
 * @param t  the parameter type
 * @return   true iff `t` is a numeric prim, `byte`, or a slice
 */
fn param_takes_born_literal(t: Type): bool {
    match t {
        Byte => true
        Prim as p => prim_is_int(p.kind) || prim_is_float(p.kind)
        Slice => true
        _ => false
    }
}

/**
 * Should this argument be typed against its parameter as an EXPECTED type? True for an `if`/`match`/
 * array argument whose parameter accepts a born literal, so a fitting literal composite argument is
 * born at the parameter's narrow width (rather than left `i64`/`f64` and merely outer-retyped). A
 * non-composite or non-fitting argument is unaffected — the routed path is a no-op for it.
 *
 * @param arg    the parsed argument expression
 * @param param  the parameter type it flows into
 * @return       true iff the argument should route through `type_value_expected`
 */
fn arg_wants_expected(arg: parser::Expr, param: Type): bool {
    var composite = match arg.kind {
        parser::IfExpr => true
        parser::MatchExpr => true
        parser::ArrayLit => true
        _ => false
    }
    if !composite { return false }
    param_takes_born_literal(param)
}

/**
 * (W10b.D3 / TR1) Is `t` a slice whose element is a NAMED contract — an interface OR a trait? The
 * gate for the heterogeneous-array expected path below (`[]Renderable = [label, button]`).
 *
 * @param t     the candidate slice type
 * @param table the folded type table
 * @return true iff `t` is `[]Contract` for an interface element
 */
fn is_iface_slice(t: Type, table: TypeTable): bool {
    match t {
        Slice as s => match s.element {
            Named as n => is_interface_name(n.name, table)
            _ => false
        }
        _ => false
    }
}

// (W10b.D3) an ARRAY literal flowing into a `[]<interface>` slot: type each element AGAINST the
// contract element (so `[circle, square]` under `[]Shape` never joins to an inline class union
// the emitters cannot re-tag). Each element keeps its NARROW class type (emit_as builds the fat
// pointer per slot); the array's own type adopts the expected `[]<interface>`. A spread element
// contributes a whole `[]U` — U must widen into the contract element (its value covariant-
// rebuilds element-wise instead). Mirror of expr.c::type_array_lit_expected.
fn type_array_lit_expected(a: parser::ArrayLit, expected: Type, env: Env, table: TypeTable): TExpr | error {
    var elem = match expected { Slice as s => s.element; _ => return error { message = "internal: type_array_lit_expected needs a slice expected type" } }
    var elems: []TArrayElem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        var e = match type_expr(a.elements[i].expr, env, table) { TExpr as te => te; error as err2 => return err2 }
        if a.elements[i].is_spread {
            var selem = match e.type {
                Slice as fs => fs.element
                _ => return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" }
            }
            var selem_is_void = match selem { Void => true; _ => false }
            if selem_is_void { return error { message = "a spread element (`..xs`) must be a slice (`[]T`)" } }
            if !assignable_to(selem, elem, table) {
                return teko::error::err_typed(error { message = "array element type mismatch" }, type_render(elem), type_render(selem))
            }
        } else {
            if type_is_void(e.type) { return error { message = "a `void` expression cannot be an array element (M.1)" } }
            if !assignable_to(e.type, elem, table) {
                return teko::error::err_typed(error { message = "array element type mismatch" }, type_render(elem), type_render(e.type))
            }
        }
        elems = teko::list::push(elems, TArrayElem { is_spread = a.elements[i].is_spread; expr = e })   // keep the NARROW type — the emit wraps per slot
        i++
    }
    TExpr { kind = TArrayLit { elements = elems }; type = expected; line = 0; col = 0 }
}

/**
 * Types a `ref` binding's initializer against the annotated Reference target (owner ruling
 * 2026-07-24): `ref r: T = x` REQUIRES `x` to be a mutable variable (aliased, write-through — R7)
 * or another already-Reference-typed expression (forwarded plainly). There is no third case — a
 * fresh value/expression cannot become a `ref` binding's source (no expression-position `ref x`
 * exists to spell it, and no silent copy-fallback: an honest error names the real fix). The typed
 * value keeps its BARE (unwrapped) type on the mutable-var path — codegen's `emit_as_r` detects the
 * `Reference`-expected / non-`Reference`-value mismatch and emits the `&` itself, mirroring
 * `type_call`'s call-argument auto-ref.
 *
 * BOTH paths check the referent. The forwarding path used to return the source reference the moment
 * its type was a `Reference`, BEFORE the `type_eq` below, so `ref q: Big = p` with `p: ref i64`
 * type-checked and then wrote through a `Big`-shaped view of an `i64` cell — a memory-safety hole
 * from a re-annotation the checker never compared. A forward now requires `type_eq(src.inner,
 * rf.inner)`: the alias may be re-spelled, never re-typed.
 *
 * @param bv     the binding's value expression
 * @param rf     the annotated `Reference` target
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed initializer (bare-typed on the alias path, `Reference`-typed on the
 *               forwarding path)
 * @throws       when the source is neither a mutable variable nor an already-`Reference` value, or
 *               when a forwarded reference names a DIFFERENT referent type than the annotation
 */
fn type_ref_binding_value(bv: parser::Expr, rf: Reference, env: Env, table: TypeTable): TExpr | error {
    var v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type {
        Reference as src => {
            if !type_eq(src.inner, rf.inner) {
                return teko::error::err_typed(error { message = "a forwarded `ref` binding must name the SAME referent type as the reference it aliases" }, type_render(rf.inner), type_render(src.inner))
            }
            return v
        }
        _ => { }
    }
    if !type_eq(v.type, rf.inner) {
        return teko::error::err_typed(error { message = "a `ref` binding's source must be the referent's own type (or another reference)" }, type_render(rf.inner), type_render(v.type))
    }
    ref_source_mutable_var(bv, v, env)
}

/**
 * ref_source_mutable_var — the ALIAS-path source rule, shared by the annotated (`ref r: T = c`) and
 * the inferred (`ref r = c`) reference binding: the source must be a bare variable whose binding is
 * writable. A `ref` aliases an existing cell, so a temporary or an immutable `let` has no cell to
 * write through and the honest stop names the real fix rather than degrading into a copy.
 *
 * @param bv   the binding's source expression, untyped (the only place a bare `Var` is still visible)
 * @param v    the same expression already typed (returned unchanged when the rule holds)
 * @param env  the typing environment, consulted for the source binding's writability
 * @return     `v` unchanged
 * @throws     when the source is not a bare variable, is unbound, or names a non-writable binding
 * @since      0.3.1
 */
fn ref_source_mutable_var(bv: parser::Expr, v: TExpr, env: Env): TExpr | error {
    var var = match bv.kind { parser::Var as x => x; _ => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference — not an expression" } }
    var vb = match lookup_binding(env, var.name) { ValBinding as b => b; error => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference" } }
    if vb.is_mut { return v }
    error { message = $"cannot take a reference to immutable `{var.name}` — a `ref` binding needs a mutable source (a `var`) or another reference" }
}

/**
 * type_inferred_ref_value — type the source of an UN-ANNOTATED reference binding `ref r = c`, whose
 * referent type is inferred from the source instead of read off a `Ref<>`-wrapped annotation (owner
 * ruling 2026-07-30). Same two cases as the annotated path and no third one: an already-`Reference`
 * value forwards unchanged, any other value must be a writable variable and keeps its BARE type on
 * the alias path (codegen's `emit_as_r` sees the `Reference`-expected / bare-value mismatch and
 * emits the `&`). There is deliberately NO copy fallback — the silent copy this replaces compiled
 * `ref r = c` into an ordinary `mut` snapshot and let every later write to `c` go unseen by `r`.
 *
 * @param bv     the binding's source expression
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed source (bare-typed on the alias path, `Reference`-typed when forwarding)
 * @throws       when the source is neither a writable variable nor an already-`Reference` value
 * @since        0.3.1
 */
fn type_inferred_ref_value(bv: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    var v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type { Reference => return v; _ => { } }
    ref_source_mutable_var(bv, v, env)
}

/**
 * ref_bound_of — the BOUND type of a reference binding whose referent type came from the source
 * rather than an annotation: a forwarded reference keeps its own `Reference` type (a reference to a
 * reference is not a thing the surface can spell), any other referent type `T` binds as `Ref<T>`.
 *
 * @param t  the typed source's type
 * @return   `t` when it is already a `Reference`, else `Reference { inner = t }`
 * @since    0.3.1
 */
fn ref_bound_of(t: Type): Type {
    match t { Reference => t; _ => Reference { inner = t } }
}

/**
 * Types a binding's value with the annotation as its expected type (so a generic constructor
 * targets the concrete instance from `: Box<i64>`) — or, when the binder was `ref`, routes through
 * the mutable-source/forwarding rule instead of the ordinary widening/literal-adoption path
 * (0.3.1 — owner rulings 2026-07-24 and 2026-07-30). The reference-ness is read from `b.is_ref`,
 * the binder's own identity axis, so an UN-annotated `ref r = c` takes the same rule as `ref r: T =
 * c` instead of falling through to the plain-value path that used to copy it.
 *
 * @param b      the binding whose value is typed
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed initializer
 * @throws       when a `ref` binder's source breaks the mutable-source/forwarding rule
 */
fn type_binding_value(b: parser::Binding, env: Env, table: TypeTable): TExpr | error {
    if b.is_ref && !b.has_type { return type_inferred_ref_value(b.value, env, table) }
    if b.has_type {
        var at = match resolve_type(b.type_ann, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the binding's enclosing namespace
        match at { Reference as rf => return type_ref_binding_value(b.value, rf, env, table); _ => { } }
        return type_value_expected(b.value, at, env, table)
    }
    type_expr(b.value, env, table)
}

/**
 * Type-checks a `let`/`mut`/`const` binding statement, producing its typed `TBinding` node and
 * the environment extended with the newly bound name (a `SimpleName` target; a
 * `DestructurePattern` target is left as a refinement — the environment is returned unchanged). A
 * `ref` binding (`at` resolves to `Reference`, owner ruling 2026-07-24) skips the ordinary
 * widening/literal-adopt check entirely — `type_binding_value` (via `type_ref_binding_value`)
 * already validated the mutable-source/forwarding rule and typed `v` accordingly (bare on the
 * alias path, since a bare-typed alias value is never "assignable to" its own `Reference`
 * wrapper); `bound` is always set to the annotation `at` when one is given, unconditionally. A
 * top-level `Reference` bound type is legal ONLY on a genuine `ref` binding (`BindKind::Mut`,
 * `parse_ref_binding`'s desugar) — a `let`/`const` binding can never carry one (deep immutability
 * is the whole point of `let`; the tripartite law: `let` protects, `mut` unlocks, `ref` aliases).
 *
 * @param parser::Binding b  the parsed binding (target, optional annotation, initializer)
 * @param Env env  the typing environment
 * @param TypeTable table  the program's type table
 * @return TypedStmt | error  the typed statement plus the environment with the new binding defined
 * @throws when the initializer is `void`, an empty collection has no known element type, or a
 *               reference is bound to a local (R5)
 */
/**
 * bind_value_into_annotation — the `let x: T = value` rung ladder for a value that does not already
 * widen into its annotation `T`, in order: the struct/interface honest-stop that names a nominal
 * mismatch precisely → the implicit numeric widening (`widen_value_into` — a narrower same-family
 * value, or a machine integer into `bigint`/`dec`) → a fitting bare LITERAL adopting the declared
 * narrow type (`annotated_literal_ok` proves the fit against the RAW initializer, then
 * `retype_literal` rewrites the leaf so codegen sees the declared width, recursing into an array
 * literal's elements) → the honest stop annotated with expected and actual.
 *
 * Separate from `coerce_value_into` on purpose, and not a twin of it: this rung ladder proves a
 * literal's fit against the UNTYPED source expression (`raw`), which is the only place a negative
 * literal's sign and an array literal's element-wise fit are still visible. Both ladders put the
 * implicit widening at the same rung — after admissibility, before literal adoption — so an
 * annotated binding and an assignment cannot disagree about a widening they both now accept.
 *
 * @param v      the typed initializer
 * @param raw    the initializer's untyped source expression (the literal-fit proof reads this)
 * @param ann    the resolved annotation type
 * @param table  the folded type table
 * @return       the initializer as a value of `ann`
 * @throws       the nominal-mismatch stop, or the annotation mismatch with expected/actual attached
 * @since        0.3.1
 */
fn bind_value_into_annotation(v: TExpr, raw: parser::Expr, ann: Type, table: TypeTable): TExpr | error {
    match struct_iface_named_stop(v.type, ann, table) { error as se => return se; null => { } }
    match widen_value_into(v, ann) { TExpr as w => return w; null => { } }
    match annotated_literal_ok(raw, ann) {
        null => retype_literal(v, ann)
        error as e => teko::error::err_typed(e, type_render(ann), type_render(v.type))
    }
}

fn type_binding(b: parser::Binding, env: Env, table: TypeTable): TypedStmt | error {
    var v = match type_binding_value(b, env, table) { TExpr as te => te; error as e => return e }
    if type_is_mret_aggregate(v.type) {
        return error { message = "a multiple-return value cannot be bound to a single name — destructure it, e.g. `var a, b = f(…)` (a multiple-return call yields no first-class tuple value to capture)" }
    }
    var bound = if b.is_ref && !b.has_type { ref_bound_of(v.type) } else { v.type }
    if type_is_void(bound) { return error { message = "cannot bind a `void` expression — it yields no value (M.1)" } }
    if b.has_type {
        var at = match resolve_type(b.type_ann, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the binding's enclosing namespace
        var is_ref_binding = match at { Reference => true; _ => false }
        if !is_ref_binding && !assignable_to(v.type, at, table) {
            v = match bind_value_into_annotation(v, b.value, at, table) { TExpr as x => x; error as e => return e }
        }
        bound = at
        v = adopt_sentinel_slice_type(v, bound)
    }
    // (#4) REJECT an untyped empty collection. The element type MUST be fixed at the declaration —
    // by the binding annotation (`: []T`) or by typed initial elements (a non-empty literal / a
    // push that fixes the element). A bare `empty()`/`[]` whose element is still the sentinel is an
    // error: no silent element-less slice, no codegen back-inference (collections ruling #4).
    var bound_is_sentinel_slice = match bound { Slice as bs2 => match bs2.element { Void => true; _ => false }; _ => false }
    if bound_is_sentinel_slice {
        return error { message = "an empty list needs a known element type; annotate the binding (e.g. `var xs: []i32 = …`)" }
    }
    match bound {
        Reference => if b.kind != parser::BindKind::Mut { return error { message = "`let`/`const` cannot bind a reference — a reference binding is spelled `ref r: T = x` (write-through, requires a mutable source)" } }
        _ => if type_contains_ref(bound) && !is_ref_null_variant(bound) { return error { message = "a reference cannot be bound to a local (parameter-only in this version)" } }
    }
    var node = TBinding { kind = b.kind; target = b.target; bound = bound; value = v }
    match b.target {
        parser::SimpleName as sn => TypedStmt { node = node; env = define(env, sn.name, bound, bind_is_mut(b.kind)) }
        parser::DestructurePattern => TypedStmt { node = node; env = env }   // [destructuring binding: refinement]
    }
}

// (#88) the ROOT variable of a field-access lvalue chain (`a.b.c` → `a`). `reachable` is true when the
// whole chain roots at a plain variable (not an index / call / literal), so it has a binding to check
// for mutability. Mirrors typer.c::lvalue_root.
type LvalueRoot = struct { reachable: bool; name: str }
fn lvalue_root(e: parser::Expr): LvalueRoot {
    match e.kind {
        parser::Var as v => LvalueRoot { reachable = true; name = v.name }
        parser::FieldAccess as fa => lvalue_root(fa.receiver)
        _ => LvalueRoot { reachable = false; name = "" }
    }
}

/**
 * field_write_root_writable — the DIRECT-field-write guard: `recv.field = v` is admitted only when
 * the ROOT variable of the receiver chain is a writable binding. It walks `a.b.c` to `a`, so the
 * protection holds at EVERY depth, not just the first field.
 *
 * `let` forbids a direct write, full stop — for a CLASS exactly as for a struct (owner ruling
 * 2026-07-30: `let` protects fields at every level, like a C# `{ public get; private set; }`).
 * Until that ruling a class receiver skipped this guard entirely, on the reasoning that a class is
 * a reference type and mutation flows through the handle; the effect was that `let` bit structs and
 * was transparent to classes — half the type system ignoring the mode. Writing remains the
 * privilege of the declaring type's own methods, which reach their fields through the RECEIVER
 * binder — the receiver is the object AS a reference, so it is defined writable
 * (`is_method_receiver`) and `self.name = n` stays legal, which is the `private set` half of the
 * analogy.
 *
 * @param receiver  the untyped receiver expression of the field-access LHS
 * @param env       the typing environment, consulted for the root binding's writability
 * @return          null when the write is admitted
 * @throws          when the receiver roots at a temporary, at an unbound name, or at a binding that
 *                  is neither `mut` nor a `ref`
 * @since           0.3.1
 */
fn field_write_root_writable(receiver: parser::Expr, env: Env): error | null {
    var root = lvalue_root(receiver)
    if !root.reachable { return error { message = "cannot assign to a field of a temporary value — the receiver is not a mutable variable" } }
    var rb = match lookup_binding(env, root.name) { ValBinding as vb => vb; error as e => return e }
    if rb.is_mut { return null }
    error { message = $"cannot assign to a field of immutable `{root.name}` — declare it `mut`/`var`, or let the declaring type's own method write it (`let` protects fields at every level; there is no `ref mut`) (B.21)" }
}

/**
 * property_write_dispatch — emit the setter CALL for a property WRITE `recv.prop = value` (§9 ruling
 * 3, field-like write). Requires a setter (a get-only property is read-only); a compound `op=` is a
 * follow-up (owner decision — only plain `=` in this cut). Synthesizes `recv.__set_prop(value)` and
 * routes it through `type_method_call` (which coerces the value into the setter's parameter type and
 * dispatches interface/struct/class), then wraps the void call in a `TExprStmt`.
 *
 * @param fa     the field-access LHS (`recv.prop`)
 * @param a      the raw assignment (carries `a.op` and the RHS `a.value`)
 * @param pinfo  the resolved property surface (has_get/has_set + accessors)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed setter call wrapped in a `TypedStmt`, or a type error
 * @throws       when the property is read-only, the assignment is a compound `op=`, or the setter
 *               call fails to type
 */
fn property_write_dispatch(fa: parser::FieldAccess, a: parser::Assign, pinfo: PropInfo, env: Env, table: TypeTable): TypedStmt | error {
    if !pinfo.has_set {
        return error { message = $"property '{fa.field}' is read-only — it has a getter but no setter" }
    }
    if a.op != lexer::TokenKind::Assign {
        return error { message = $"a compound assignment on property '{fa.field}' is not supported yet — write `x.{fa.field} = x.{fa.field} <op> v` explicitly (§9 op= is a follow-up)" }
    }
    var mc = parser::MethodCall { receiver = fa.receiver; method = "__set_" ~ fa.field; args = teko::list::push(teko::list::empty(), a.value); arg_names = teko::list::push(teko::list::empty(), ""); type_args = teko::list::empty() }
    var call = match type_method_call(mc, env, table) { TExpr as te => te; error as e => return e }
    TypedStmt { node = TExprStmt { expr = call }; env = env }
}

/**
 * property_write — probe whether the assignment target `recv.prop` is a PROPERTY (§9) and, if so,
 * dispatch it through its setter; otherwise return null so the historic field-write path runs
 * byte-for-byte. Probed FIRST (before the LHS is typed as a field read), because a property LHS is
 * NOT a real field access — typing it as a field would desugar the getter and break the write. Safe
 * to probe first: a property `prop` and a homonymous field never coexist (the backing is `_prop`),
 * and `find_property` returns null for every real field, so this is inert on the corpus. A receiver
 * that does not resolve to a Named type falls through to the historic path unchanged.
 *
 * @param fa     the field-access LHS (`recv.prop`)
 * @param a      the raw assignment
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed setter statement, null (not a property — historic path), or a type error
 * @throws       when the target is a read-only property or the setter call fails to type
 */
fn property_write(fa: parser::FieldAccess, a: parser::Assign, env: Env, table: TypeTable): TypedStmt | null | error {
    var recv = match type_expr(fa.receiver, env, table) { TExpr as te => te; error => return null }
    var name = match recv.type { Named as n => n.name; _ => return null }
    match find_property(name, fa.field, table) {
        PropInfo as pinfo => match property_write_dispatch(fa, a, pinfo, env, table) {
            TypedStmt as ts => ts
            error as e => e
        }
        null => null
    }
}

/**
 * type_field_assign — type a FIELD-target assignment `recv.field op= value` (#88). The parser routes
 * EVERY `recv.field = …` here; this branch decides Ref-deref versus a struct/class field WRITE.
 *
 * Typing the LHS field-access EXPR first is load-bearing, not merely convenient: it resolves the
 * receiver and field type AND enforces read-side visibility, so a private class field written from
 * outside is rejected with the SAME "field is private to its declaring class" diagnostic a READ
 * raises — write-permission == read-permission (the RULING).
 *
 * The Ref-deref branch is the legacy MEM-1b-ii path, preserved: `r.value op= x` on a `Ref<T>` writes
 * THROUGH the reference, detected from the RECEIVER TYPE (a `Ref<T>` receiver plus the field name
 * `value`), and emits the same deref-shaped `TAssign` (kind `RefDeref`, `name` = the ref handle) the
 * old parser produced, so downstream and the TKB layout stay byte-identical for existing Ref writes.
 * Every other receiver is a struct/class field write and passes `field_write_root_writable`, the
 * `let`-protects-at-every-level guard.
 *
 * @param a      the raw assignment (`a.target` is the `FieldAccess` LHS)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed `TAssign` (kind `Field`, or `RefDeref` for a `Ref<T>.value` write)
 * @throws       when the LHS is not a field access, the receiver's root is not writable, or the
 *               value does not match the field type
 */
/**
 * field_is_readonly — is field `fname` of the Named struct `sname` frozen (§13.3)? True when the
 * field itself is `readonly`, OR its declaring struct is a `readonly struct` (which freezes every
 * field — the parser already propagated the freeze to each Field, so the per-field flag alone
 * suffices, and the struct-level flag is checked too for robustness). A frozen field is writable ONLY
 * through a construction (`.{ … }` / `Name { … }`) or a declaration default; every `recv.field = v` /
 * `self.field = v` targeting it is rejected (the construction path is a StructInit, NOT a
 * field-assign, so it never reaches this guard). Returns false for a non-struct, an unknown type, or
 * an ordinary field — inert on today's corpus (no struct is marked readonly).
 *
 * @param sname  the receiver's resolved struct name
 * @param fname  the field being written
 * @param table  the folded type table
 * @return       true iff the write must be rejected as a readonly violation
 * @since item-14
 */
fn field_is_readonly(sname: str, fname: str, table: TypeTable): bool {
    var decl = match type_table_find(table, sname, "") { parser::TypeDecl as td => td; error => return false }
    var sb = match decl.body { parser::StructBody as s => s; _ => return false }
    if sb.is_readonly { return true }
    var i = 0 to u64
    loop {
        if i >= sb.fields.len { break }
        if sb.fields[i].name == fname { return sb.fields[i].is_readonly }
        i++
    }
    false
}

fn type_field_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    var probe_fa = match a.target.kind { parser::FieldAccess as fa => fa; _ => return error { message = "assignment target is not a field access (internal: parser guarantees a field LHS)" } }
    match property_write(probe_fa, a, env, table) {
        TypedStmt as ts => return ts
        error as e => return e
        null => { }
    }
    var lhs = match type_expr(a.target, env, table) { TExpr as te => te; error as e => return e }
    var lhs_fa = match a.target.kind { parser::FieldAccess as fa => fa; _ => return error { message = "assignment target is not a field access (internal: parser guarantees a field LHS)" } }
    var recv = match type_expr(lhs_fa.receiver, env, table) { TExpr as te => te; error as e => return e }
    var field_t = lhs.type
    var ref_inner = match recv.type { Reference as rf => rf.inner; _ => Void { } }
    var is_ref_deref = match recv.type { Reference => (lhs_fa.field == "value"); _ => false }
    if is_ref_deref {
        var ref_name = match lhs_fa.receiver.kind { parser::Var as v => v.name; _ => return error { message = "`.value` deref-assignment requires a bare `Ref<T>` handle on the left" } }
        var dv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
        if !assignable_to(dv.type, ref_inner, table) {
            if !literal_adopts(dv, ref_inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(ref_inner), type_render(dv.type)) }
            dv = TExpr { kind = dv.kind; type = ref_inner; line = dv.line; col = dv.col }
        }
        return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = ref_name; op = a.op; bound = ref_inner; value = dv; deref = true; target = no_texpr() }; env = env }
    }

    match recv.type {
        Named as n => if field_is_readonly(n.name, lhs_fa.field, table) {
            return error { message = $"cannot assign to readonly field `{lhs_fa.field}` of `{n.name}` — a readonly field is set only at construction (`{n.name} {{ … }}`) or by a declaration default (§13.3)" }
        }
        _ => { }
    }

    match field_write_root_writable(lhs_fa.receiver, env) { error as e => return e; null => { } }

    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    if type_contains_ref(field_t) || type_contains_ref(v.type) { return error { message = "a reference cannot be stored in a field (parameter-only in this version)" } }
    var coerced = match coerce_value_into(v, field_t, table, "assigned value does not match the field type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Field; name = ""; op = a.op; bound = field_t; value = adopt_sentinel_slice_type(coerced, field_t); deref = false; target = lhs }; env = env }
}

/**
 * type_index_assign — type an INDEX-target assignment `ids[i] op= value` (`AssignKind::Index`). The
 * receiver must be a mutable slice/array binding `[]T`, the index an integer, and the value assignable
 * to the element type `T` (the same widen/adopt rule as a simple assign). Element write-back mutates
 * the underlying buffer, so — exactly like a struct-field write — the receiver's ROOT variable must be
 * a `mut` binding; a `let` / parameter slice is read-only and yields an honest diagnostic.
 *
 * @param a      the raw index assignment (`a.target` is the `Index{receiver,index}` LHS)
 * @param env    the typing environment
 * @param table  the folded type table
 * @return       the typed `TAssign` (kind `Index`, `bound` = the element type), or a type error
 * @throws       when the receiver is not a mutable slice, the index is non-integer, or the value does
 *               not match the element type
 */
fn type_index_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    var ix = match a.target.kind { parser::Index as x => x; _ => return error { message = "assignment target is not an index access (internal: parser guarantees an index LHS)" } }
    var recv = match type_expr(ix.receiver, env, table) { TExpr as te => te; error as e => return e }
    var elem = match recv.type {
        Slice as sl => match sl.element { Void => return error { message = "cannot assign into an untyped empty slice — its element type is unknown" }; _ => sl.element }
        _ => return teko::error::err_typed(error { message = "index-assignment target is not a slice — only a slice `[]T` supports `ids[i] = v`" }, "[]T", type_render(recv.type))
    }
    var root = lvalue_root(ix.receiver)
    if !root.reachable { return error { message = "cannot assign into an element of a temporary value — the receiver is not a mutable variable" } }
    var rb = match lookup_binding(env, root.name) { ValBinding as vb => vb; error as e => return e }
    if !rb.is_mut { return error { message = $"cannot assign into an element of immutable `{root.name}` — declare it `mut`/`var` (B.21)" } }
    var lhs = match type_expr(a.target, env, table) { TExpr as te => te; error as e => return e }
    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    if type_contains_ref(elem) || type_contains_ref(v.type) { return error { message = "a reference cannot be stored in a slice element (parameter-only in this version)" } }
    v = match coerce_value_into(v, elem, table, "assigned value does not match the slice element type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Index; name = ""; op = a.op; bound = elem; value = v; deref = false; target = lhs }; env = env }
}

fn type_assign(a: parser::Assign, env: Env, table: TypeTable): TypedStmt | error {
    if expr_is_svc_claim(a.value) { return svc_escape_error() }
    var is_field = match a.kind { parser::AssignKind::Field => true; _ => false }
    if is_field { return type_field_assign(a, env, table) }
    var is_index = match a.kind { parser::AssignKind::Index => true; _ => false }
    if is_index { return type_index_assign(a, env, table) }
    var tb = match lookup_binding(env, a.name) { ValBinding as vb => vb; error as e => return e }
    if !a.deref {
        match tb.type {
            Reference as rf => {
                var wv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
                var rhs_is_ref = match wv.type { Reference => true; _ => false }
                if !rhs_is_ref {
                    if !assignable_to(wv.type, rf.inner, table) {
                        if !literal_adopts(wv, rf.inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(rf.inner), type_render(wv.type)) }
                        wv = retype_literal(wv, rf.inner)
                    }
                    return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = a.name; op = a.op; bound = rf.inner; value = wv; deref = true; target = no_texpr() }; env = env }
                }
            }
            _ => { }
        }
    }
    // (MEM-1b-ii) `r.value op= x` — write THROUGH a reference. The handle `r` need NOT be `mut`
    // (a `Ref<T>` is a const handle that grants WRITE to its mutable target — R2 mutable-target).
    // The assigned-to type is the ref's inner T; the value must widen/adopt into T.
    if a.deref {
        var inner = match tb.type {
            Reference as rf => rf.inner
            _ => return error { message = $"`{a.name}.value` requires a reference (`Ref<T>`) — `{a.name}` is not a reference" }
        }
        var dv = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
        if !assignable_to(dv.type, inner, table) {
            if !literal_adopts(dv, inner) { return teko::error::err_typed(error { message = "assigned value does not match the referenced type" }, type_render(inner), type_render(dv.type)) }
            dv = TExpr { kind = dv.kind; type = inner; line = dv.line; col = dv.col }   // a fitting literal adopts T
        }
        return TypedStmt { node = TAssign { kind = parser::AssignKind::RefDeref; name = a.name; op = a.op; bound = inner; value = dv; deref = true; target = no_texpr() }; env = env }
    }
    if !tb.is_mut { return error { message = $"cannot assign to immutable `{a.name}` — declare it `mut`/`var` (B.21)" } }
    var v = match type_expr(a.value, env, table) { TExpr as te => te; error as e => return e }
    var both_bare_ref = (match tb.type { Reference => true; _ => false }) && (match v.type { Reference => true; _ => false })
    if !both_bare_ref {
        if type_contains_ref(tb.type) || type_contains_ref(v.type) { return error { message = "a reference cannot be bound to a local (parameter-only in this version)" } }
    }
    var coerced = match coerce_value_into(v, tb.type, table, "assigned value does not match the target type") { TExpr as x => x; error as e => return e }
    TypedStmt { node = TAssign { kind = parser::AssignKind::Simple; name = a.name; op = a.op; bound = tb.type; value = adopt_sentinel_slice_type(coerced, tb.type); deref = false; target = no_texpr() }; env = env }
}

/**
 * expr_is_dot_construction — is `e` a `.{ … }` target-typed construction (§4.1)? True for a StructLit
 * whose `type_path` is the empty dot-sentinel — the only expression shape that needs a target type
 * threaded from its slot instead of resolving on its own.
 *
 * @param e  the parsed expression
 * @return   true iff `e` is a `.{ … }` construction
 * @since §4.1
 */
fn expr_is_dot_construction(e: parser::Expr): bool {
    match e.kind { parser::StructLit as sl => is_dot_sentinel(sl.type_path); _ => false }
}

/**
 * type_dot_tail — type a `.{ … }` construction that sits in a tail slot (a `return .{…}` value or a
 * function's trailing `.{…}` expression) against `env.ret_expected` (§4.1), restamping the source
 * position onto the emitted node the way `type_expr` does. The caller has already checked
 * `expr_is_dot_construction(e)` and that `env.ret_expected` is not `Void`.
 *
 * @param e      the `.{ … }` construction expression
 * @param env    the typing environment (its `ret_expected` is the construction's target)
 * @param table  the folded type table
 * @return       the typed construction node, or a located error (no-target when the slot is untyped)
 * @since §4.1
 */
fn type_dot_tail(e: parser::Expr, env: Env, table: TypeTable): TExpr | error {
    match type_value_expected(e, env.ret_expected, env, table) {
        TExpr as te => TExpr { kind = te.kind; type = te.type; line = e.line; col = e.col }
        error as inner => if inner.line == 0 { teko::error::err_loc(inner, e.line, e.col) } else { inner }
    }
}

fn type_return(r: parser::Return, env: Env, table: TypeTable): TypedStmt | error {
    if r.has_value && expr_is_svc_claim(r.value) { return svc_escape_error() }
    var v = if r.has_value && expr_is_dot_construction(r.value) && !type_is_void(env.ret_expected) {
        match type_dot_tail(r.value, env, table) { TExpr as te => te; error as e => return e }
    } else {
        match type_expr(r.value, env, table) { TExpr as te => te; error as e => return e }
    }
    TypedStmt { node = TReturn { has_value = r.has_value; value = v; values = teko::list::empty() }; env = env }   // value gated by has_value (B.20); the return-type match is enforced by type_function's check_returns (C5)
}

/**
 * type_loop — type a `[LABEL:] loop [head] { … }` (#517). The head is already desugared: `init`
 * is typed in a LOOP-PRIVATE child scope so its bindings (counter / bound / `_first` / `_it`) do
 * NOT leak past the loop, then `body` is typed in that same scope (so the body reads the preamble).
 * The env returned is the CALLER's env — every loop-local binding (init AND body) is dropped.
 *
 * @param l the surface loop node (label + init + body)
 * @param env the enclosing type environment
 * @param table the type table
 * @return the typed loop statement paired with the UNCHANGED outer env, or a type error
 */
fn type_loop(l: parser::LoopStmt, env: Env, table: TypeTable): TypedStmt | error {
    var ib = match type_block(l.init, env, table) { TypedBlock as bk => bk; error as e => return e }
    var bb = match type_block(l.body, ib.env, table) { TypedBlock as bk => bk; error as e => return e }
    TypedStmt { node = TLoopStmt { label = l.label; init = ib.stmts; body = bb.stmts }; env = env }
}

fn type_exprstmt(es: parser::ExprStmt, env: Env, table: TypeTable): TypedStmt | error {
    // a TOP-LEVEL if/match is a STATEMENT — its value is discarded, so no `else` is required.
    match es.expr.kind {
        parser::IfExpr as f => {
            var te = match type_if_stmt(f, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
        parser::MatchExpr as m => {
            var te = match type_match_stmt(m, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
        _ => {
            var te = match type_expr(es.expr, env, table) { TExpr as x => x; error as e => return e }
            TypedStmt { node = TExprStmt { expr = te }; env = env }
        }
    }
}

/**
 * TStmtSeq — the flat statement sequence a `MultiBind` desugars to (§9 F), together with the env
 * extended by the bound names. The sequence is SPLICED into the enclosing statement block (never
 * wrapped in a `TBlockStmt`, which the native backend does not lower), so every desugared
 * `TBinding`/guard sits at the SAME scope level as a hand-written binding and both backends lower it
 * with zero new statement-node support.
 *
 * @field stmts  the desugared typed statements, in source order
 * @field env    the environment extended with the multiple binding's bound targets
 * @since §9 F
 */
type TStmtSeq = struct { stmts: []TStatement; env: Env }

/**
 * mb_expr — wrap a synthesized expression `kind` at an unpositioned (0,0) source location for the
 * §9 F multiple-binding desugar. The desugared nodes carry no user source position of their own; any
 * diagnostic they raise is blamed on the values/targets that were typed through them.
 *
 * @param kind  the expression kind to wrap
 * @return      the synthesized `parser::Expr`
 * @since §9 F
 */
fn mb_expr(kind: parser::ExprKind): parser::Expr {
    parser::Expr { kind = kind; line = 0; col = 0 }
}

/**
 * mb_var — a synthesized variable-read of the temp/target named `name` (§9 F desugar).
 *
 * @param name  the variable name to read
 * @return      a `parser::Var` expression
 * @since §9 F
 */
fn mb_var(name: str): parser::Expr {
    mb_expr(parser::Var { name = name })
}

/**
 * mb_u64_lit — a synthesized non-negative integer literal carrying the magnitude `v` (§9 F desugar):
 * an array index, a fixed element count, or a length-guard bound.
 *
 * @param v  the literal's magnitude
 * @return   a `parser::Number` expression
 * @since §9 F
 */
fn mb_u64_lit(v: u64): parser::Expr {
    mb_expr(parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 })
}

/**
 * mb_field — a synthesized field read `recv.field` (§9 F desugar), used for the source temp's `.len`.
 *
 * @param recv   the receiver expression
 * @param field  the field name to read
 * @return       a `parser::FieldAccess` expression
 * @since §9 F
 */
fn mb_field(recv: parser::Expr, field: str): parser::Expr {
    mb_expr(parser::FieldAccess { receiver = recv; field = field })
}

/**
 * mb_index — a synthesized element read `recv[idx]` (§9 F array-decomposition desugar).
 *
 * @param recv  the slice temp being indexed
 * @param idx   the index expression (a constant for the head, `len - k` for the tail)
 * @return      a `parser::Index` expression
 * @since §9 F
 */
fn mb_index(recv: parser::Expr, idx: parser::Expr): parser::Expr {
    mb_expr(parser::Index { receiver = recv; index = idx })
}

/**
 * mb_binary — a synthesized binary arithmetic expression `left op right` (§9 F desugar), used for the
 * tail index `len - k`.
 *
 * @param op     the binary operator token
 * @param left   the left operand
 * @param right  the right operand
 * @return       a `parser::Binary` expression
 * @since §9 F
 */
fn mb_binary(op: lexer::TokenKind, left: parser::Expr, right: parser::Expr): parser::Expr {
    mb_expr(parser::Binary { op = op; left = left; right = right })
}

/**
 * mb_len — the source temp's `.len` (§9 F array-decomposition guard/tail-index base).
 *
 * @param recv  the slice temp
 * @return      the `recv.len` field read
 * @since §9 F
 */
fn mb_len(recv: parser::Expr): parser::Expr {
    mb_field(recv, "len")
}

/**
 * mb_binding_stmt — a synthesized single `parser::Binding` statement the §9 F desugar feeds back
 * through `type_statement`, so all existing binding checks (numeric widening, literal adoption, `_`
 * discard, env extension) apply unchanged.
 *
 * @param kind      the mutability of the resulting binding (`Mut` for a temp, `mb.kind` for a target)
 * @param name      the bound name
 * @param has_type  true iff the shared `: T` annotation applies to this binding
 * @param ann       the shared annotation (meaningful only when `has_type`)
 * @param value     the initializer expression
 * @return          the synthesized `parser::Binding` statement
 * @since §9 F
 */
fn mb_binding_stmt(kind: parser::BindKind, name: str, has_type: bool, ann: parser::TypeExpr, value: parser::Expr): parser::Statement {
    parser::Binding { kind = kind; target = parser::SimpleName { name = name }; has_type = has_type; type_ann = ann; is_ref = false; value = value }
}

/**
 * mb_guard_stmt — the synthesized runtime length guard `if temp.len OP bound { panic(msg) }` (§9 F,
 * ruling 5). `OP` is `!=` for an exact-length decomposition and `<` for a `..` minimum-length one; the
 * guard reuses the existing `if`-statement and `panic` builtin lowering, so no codegen changes.
 *
 * @param temp   the source slice temp's name
 * @param op     the comparison token (`Ne` exact, `Lt` minimum)
 * @param bound  the fixed element count to compare `.len` against
 * @param msg    the panic message
 * @return       the synthesized guard statement
 * @since §9 F
 */
fn mb_guard_stmt(temp: str, op: lexer::TokenKind, bound: u64, msg: str): parser::Statement {
    var term = parser::CmpTerm { op = op; operand = mb_u64_lit(bound) }
    var cond = mb_expr(parser::Compare { first = mb_len(mb_var(temp)); rest = teko::list::push(teko::list::empty(), term) })
    var pseg = teko::list::push(teko::list::empty(), parser::Segment { name = "panic" })
    var pargs = teko::list::push(teko::list::empty(), mb_expr(parser::StrLit { text = msg }))
    var pnames = teko::list::push(teko::list::empty(), "")
    var pcall = mb_expr(parser::Call { callee = parser::Path { segments = pseg }; args = pargs; arg_names = pnames; owner_type_args = teko::list::empty(); callee_type_args = teko::list::empty() })
    var then_blk = teko::list::push(teko::list::empty(), parser::ExprStmt { expr = pcall })
    parser::ExprStmt { expr = mb_expr(parser::IfExpr { cond = cond; then_blk = then_blk; has_else = false; else_blk = teko::list::empty() }) }
}

/**
 * mb_temp_name — the fresh, function-unique name of the §9 F desugar temp for slot `slot`. Uniqueness
 * comes from the multiple binding's own source position (`line:col`, unique within a function) plus the
 * slot index, so two multiple bindings never share a temp and the name-based escape/codegen analyses
 * never conflate them. A user cannot spell the name (it is not a legal identifier surface), so the temp
 * is invisible.
 *
 * @param mb    the multiple-binding statement (source of the unique `line:col`)
 * @param slot  the per-binding slot index
 * @return      the synthesized temp name
 * @since §9 F
 */
fn mb_temp_name(mb: parser::MultiBind, slot: u64): str {
    "_mb_" ~ teko::u64_to_str(mb.line to u64) ~ "_" ~ teko::u64_to_str(mb.col to u64) ~ "_" ~ teko::u64_to_str(slot)
}

/**
 * MbArrayShape — the counts an array-decomposition target list splits into (§9 F, ruling 2): the fixed
 * targets before a `..` (`head_n`), those after it (`tail_n`), and whether a `..` skip-range is present.
 *
 * @field head_n    the number of positional targets (names + `_`) before the `..` (or all of them when
 *                  there is no `..`).
 * @field tail_n    the number of positional targets after the `..` (0 without a `..`).
 * @field has_rest  true iff the list contains a `..` skip-range.
 * @since §9 F
 */
type MbArrayShape = struct { head_n: u64; tail_n: u64; has_rest: bool }

/**
 * mb_array_shape — split an array-decomposition target list into head/tail counts around its optional
 * `..` (§9 F). The parser guarantees at most one `..`, so a single scan classifies every element.
 *
 * @param targets  the `BindElem` list of an `ArrayDecomp`
 * @return         the head/tail counts and rest presence
 * @since §9 F
 */
fn mb_array_shape(targets: []parser::BindElem): MbArrayShape {
    var head_n: u64 = 0
    var tail_n: u64 = 0
    var has_rest = false
    var i: u64 = 0
    loop {
        if i >= targets.len { break }
        match targets[i] {
            parser::BindRest => has_rest = true
            _ => if has_rest { tail_n = tail_n + 1 } else { head_n = head_n + 1 }
        }
        i = i + 1
    }
    MbArrayShape { head_n = head_n; tail_n = tail_n; has_rest = has_rest }
}

/**
 * type_multibind_mret — desugar a single-value parallel binding `var q, r = div(…)` into a
 * multiple-return destructure (§9 F, ruling 3). Filled in by the multiple-return crumb; until then a
 * single right-hand value in a parallel binding is not yet supported.
 *
 * @param mb     the parallel multiple binding whose right-hand side is a single value
 * @param env    the type environment
 * @param table  the program's type table
 * @return       the desugared statement sequence plus the extended env, or an error
 * @throws       when the single value is not a multiple-return call, or its arity differs from the
 *               number of targets
 * @since §9 F
 */
fn type_multibind_mret(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    var call = match type_expr(mb.values[0], env, table) { TExpr as x => x; error as e => return e }
    if !type_is_mret_aggregate(call.type) {
        return error { message = "a multiple binding `var a, b = …` with one right-hand value needs a multiple-return call there (a `fn f(): (A, B)`); this value is not one" }
    }
    var aggname = match call.type { Named as nm => nm.name; _ => "" }
    var decl = match type_table_find(table, aggname, env.cur_ns) { parser::TypeDecl as d => d; error as e => return e }
    var nfields = match decl.body { parser::StructBody as sb => sb.fields.len; _ => 0 }
    if mb.targets.len != nfields {
        return error { message = "multiple-return destructuring: the call returns " ~ teko::u64_to_str(nfields) ~ " values but " ~ teko::u64_to_str(mb.targets.len) ~ " targets were given" }
    }
    var tname = mb_temp_name(mb, 0)
    var cur = define(env, tname, call.type, true)
    var body: []TStatement = teko::list::push(teko::list::empty(), TBinding { kind = parser::BindKind::Mut; target = parser::SimpleName { name = tname }; bound = call.type; value = call })
    var i: u64 = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindName as bn => {
                var vstmt = mb_binding_stmt(mb.kind, bn.name, false, mb.type_ann, mb_field(mb_var(tname), mret_field_name(i)))
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body = teko::list::push(body, ts.node)
                cur = ts.env
            }
            parser::BindSkip => { }
            parser::BindRest => return error { message = "`..` skip-range is not valid in a multiple-return destructuring" }
        }
        i = i + 1
    }
    TStmtSeq { stmts = body; env = cur }
}

/**
 * str_has_prefix — does `s` begin with `p`? A byte-wise prefix test (§9 F needs only ASCII), used to
 * recognize a synthesized multiple-return aggregate by its reserved name stem.
 *
 * @param s  the string to test
 * @param p  the candidate prefix
 * @return   true iff `s` starts with `p`
 * @since §9 F
 */
fn str_has_prefix(s: str, p: str): bool {
    if s.len < p.len { return false }
    var i: u64 = 0
    loop {
        if i >= p.len { break }
        if s[i] != p[i] { return false }
        i = i + 1
    }
    true
}

/**
 * type_is_mret_aggregate — is `t` a synthesized §9 F multiple-return aggregate struct? True for a
 * `Named` whose last segment carries the reserved `MRET_PREFIX` stem. The value-position guard and the
 * destructuring desugar both key off this, so an aggregate is only ever produced by a multiple-return
 * call and only ever consumed by a `return (…)` or a destructuring `var a, b = …`.
 *
 * @param t  the type to classify
 * @return   true iff `t` is a multiple-return aggregate
 * @since §9 F
 */
fn type_is_mret_aggregate(t: Type): bool {
    match t {
        Named as nm => str_has_prefix(name_last_segment(nm.name), MRET_PREFIX)
        _ => false
    }
}

/**
 * type_multibind_parallel — desugar the parallel form `var a, b, … = e1, e2, …` (§9 F, ruling 1). With
 * a SINGLE right-hand value the form is a multiple-return destructure (`var q, r = div(…)`), delegated
 * to `type_multibind_mret`. Otherwise the target and value counts must match: each value is bound to a
 * fresh temp FIRST (so `var a, b = b, a` swaps — every right-hand side is evaluated before any target
 * is written), then each target is bound from its temp. A `_` target still evaluates its value (side
 * effects preserved) but binds nothing.
 *
 * @param mb     the parallel multiple binding
 * @param env    the type environment
 * @param table  the program's type table
 * @return       the desugared statement sequence plus the env extended with the bound targets, or an error
 * @throws       when target and value counts differ, or a `..` appears in a parallel target list
 * @since §9 F
 */
fn type_multibind_parallel(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    if mb.values.len == 1 {
        return type_multibind_mret(mb, env, table)
    }
    if mb.targets.len != mb.values.len {
        return error { message = "multiple assignment: the number of targets and values must match (got " ~ teko::u64_to_str(mb.targets.len) ~ " targets, " ~ teko::u64_to_str(mb.values.len) ~ " values)" }
    }
    var cur = env
    var body: []TStatement = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= mb.values.len { break }
        var tstmt = mb_binding_stmt(parser::BindKind::Mut, mb_temp_name(mb, i), mb.has_type, mb.type_ann, mb.values[i])
        var ts = match type_statement(tstmt, cur, table) { TypedStmt as t => t; error as e => return e }
        body = teko::list::push(body, ts.node)
        cur = ts.env
        i = i + 1
    }
    i = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindName as bn => {
                var vstmt = mb_binding_stmt(mb.kind, bn.name, false, mb.type_ann, mb_var(mb_temp_name(mb, i)))
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body = teko::list::push(body, ts.node)
                cur = ts.env
            }
            parser::BindSkip => { }
            parser::BindRest => return error { message = "`..` skip-range is not valid in a parallel multiple assignment" }
        }
        i = i + 1
    }
    TStmtSeq { stmts = body; env = cur }
}

/**
 * type_multibind_array — desugar the array-decomposition form `var [a, _, .., b] = arr` (§9 F, ruling
 * 2). The source array is bound to a fresh temp, a runtime length guard is emitted (ruling 5: exact
 * length without `..`, minimum head+tail length with `..`), then each named target is bound to an
 * element read — the head at a constant index, the tail at `len - k` computed at runtime. `_` skips its
 * index without binding; `..` separates head from tail.
 *
 * @param mb     the array-decomposition multiple binding
 * @param env    the type environment
 * @param table  the program's type table
 * @return       the desugared statement sequence plus the env extended with the bound targets, or an error
 * @throws       when the right-hand side is not exactly one value, or an element read fails to type
 * @since §9 F
 */
fn type_multibind_array(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    if mb.values.len != 1 {
        return error { message = "array decomposition binds exactly one array value" }
    }
    var shape = mb_array_shape(mb.targets)
    var cur = env
    var body: []TStatement = teko::list::empty()
    var aname = mb_temp_name(mb, 0)
    var astmt = mb_binding_stmt(parser::BindKind::Mut, aname, false, mb.type_ann, mb.values[0])
    var ats = match type_statement(astmt, cur, table) { TypedStmt as t => t; error as e => return e }
    body = teko::list::push(body, ats.node)
    cur = ats.env
    var guard = if shape.has_rest {
        mb_guard_stmt(aname, lexer::TokenKind::Lt, shape.head_n + shape.tail_n, "array decomposition: expected at least " ~ teko::u64_to_str(shape.head_n + shape.tail_n) ~ " elements")
    } else {
        mb_guard_stmt(aname, lexer::TokenKind::Ne, shape.head_n, "array decomposition: expected exactly " ~ teko::u64_to_str(shape.head_n) ~ " elements")
    }
    var gts = match type_statement(guard, cur, table) { TypedStmt as t => t; error as e => return e }
    body = teko::list::push(body, gts.node)
    cur = gts.env
    var slot: u64 = 0
    var j: u64 = 0
    var in_tail = false
    var i: u64 = 0
    loop {
        if i >= mb.targets.len { break }
        match mb.targets[i] {
            parser::BindRest => { in_tail = true }
            parser::BindSkip => if in_tail { j = j + 1 } else { slot = slot + 1 }
            parser::BindName as bn => {
                var idx_expr = if in_tail {
                    mb_index(mb_var(aname), mb_binary(lexer::TokenKind::Minus, mb_len(mb_var(aname)), mb_u64_lit(shape.tail_n - j)))
                } else {
                    mb_index(mb_var(aname), mb_u64_lit(slot))
                }
                var vstmt = mb_binding_stmt(mb.kind, bn.name, mb.has_type, mb.type_ann, idx_expr)
                var ts = match type_statement(vstmt, cur, table) { TypedStmt as t => t; error as e => return e }
                body = teko::list::push(body, ts.node)
                cur = ts.env
                if in_tail { j = j + 1 } else { slot = slot + 1 }
            }
        }
        i = i + 1
    }
    TStmtSeq { stmts = body; env = cur }
}

/**
 * type_multibind — types and DESUGARS a `MultiBind` (§9 F) into a FLAT sequence of already-existing
 * typed statements (`TBinding`s plus a synthesized length guard for array decomposition), introducing
 * NO new typed node so codegen/LIR stay untouched. The caller SPLICES the sequence into the enclosing
 * block. Dispatches on the target shape; the parallel form additionally routes a single
 * multiple-return call to `type_multibind_mret`.
 *
 * @param mb     the multiple-binding statement
 * @param env    the type environment
 * @param table  the program's type table
 * @return       the desugared statement sequence plus the env extended with the bound names, or an error
 * @throws       RHS/LHS arity mismatch; a wrong-arity multiple-return call; a non-`[]T` decomposition
 *               source; a misplaced or repeated `..`; an incompatible shared `: T` annotation
 * @since §9 F
 */
fn type_multibind(mb: parser::MultiBind, env: Env, table: TypeTable): TStmtSeq | error {
    match mb.shape {
        parser::MultiTargetKind::Parallel => type_multibind_parallel(mb, env, table)
        parser::MultiTargetKind::ArrayDecomp => type_multibind_array(mb, env, table)
    }
}

/**
 * top_level_stmt_nodes — type a single top-level (virtual-main) statement into the FLAT typed-statement
 * sequence it contributes (§9 F). An ordinary statement yields one node; a multiple binding desugars to
 * several, spliced at the top level exactly as inside a block. Returns the sequence plus the threaded
 * env so the collect-all and fail-fast top-level loops share one code path.
 *
 * @param s      the parsed top-level statement (the file already stamped onto `env` by the caller)
 * @param env    the threaded type environment
 * @param table  the program's type table
 * @return       the contributed statements plus the advanced env, or an error
 * @since §9 F
 */
fn top_level_stmt_nodes(s: parser::Statement, env: Env, table: TypeTable): TStmtSeq | error {
    match s {
        parser::MultiBind as mb => type_multibind(mb, env, table)
        _ => {
            var ts = match type_statement(s, env, table) { TypedStmt as x => x; error as e => return e }
            TStmtSeq { stmts = teko::list::push(teko::list::empty(), ts.node); env = ts.env }
        }
    }
}

fn type_statement(s: parser::Statement, env: Env, table: TypeTable): TypedStmt | error {
    match s {
        parser::Binding as b => type_binding(b, env, table)
        parser::Assign as a => type_assign(a, env, table)
        parser::Return as r => type_return(r, env, table)
        parser::LoopStmt as l => type_loop(l, env, table)
        parser::BreakStmt as b => TypedStmt { node = TBreakStmt { label = b.label }; env = env }
        parser::ContinueStmt as c => TypedStmt { node = TContinueStmt { label = c.label }; env = env }
        parser::ExprStmt as es => type_exprstmt(es, env, table)
        parser::DeferStmt as d => {
            // Validate: defer block may not directly contain return, break, or nested defer.
            var vi: u64 = 0
            loop {
                if vi >= d.body.len { break }
                match d.body[vi] {
                    parser::Return => return error { message = "defer block may not return" }
                    parser::BreakStmt => return error { message = "defer block may not break" }
                    parser::DeferStmt => return error { message = "nested defer is not allowed" }
                    _ => { }
                }
                vi++
            }
            // Type-check the body in void context; bindings are scoped inside (don't leak env).
            var tb = match type_block(d.body, env, table) { TypedBlock as x => x; error as e => return e }
            TypedStmt { node = TDeferStmt { body = tb.stmts }; env = env }
        }
        parser::AdoptStmt as a => type_adopt(a, env, table)
        parser::BlockStmt as bs => type_block_stmt(bs, env, table)
        parser::MultiBind => error { message = "internal: a multiple binding must be spliced by the statement sequencer, not typed as a single statement" }
    }
}

/**
 * type_block_stmt — type-check a bare `{ … }` block statement in void context (0.3.1 §6). The body
 * is an ordinary control-flow block (return/break/continue and nested blocks are all allowed), typed
 * via type_block so its bindings are scoped INSIDE and do not leak `env` — a binding declared in the
 * block is invisible after its closing brace. The enclosing `env` is returned unchanged.
 *
 * @param parser::BlockStmt bs  the parsed bare block statement
 * @param Env env  the enclosing type environment (unchanged on return — the body is scoped)
 * @param TypeTable table  the program type table
 * @return TypedStmt | error  the typed block statement, or a type error propagated from the body
 */
fn type_block_stmt(bs: parser::BlockStmt, env: Env, table: TypeTable): TypedStmt | error {
    var tb = match type_block(bs.body, env, table) { TypedBlock as x => x; error as e => return e }
    TypedStmt { node = TBlockStmt { body = tb.stmts }; env = env }
}

/**
 * type_adopt — type-check an `adopt [name] { … }` block in void context. The body is an ordinary
 * control-flow block (return/break/continue and nested `adopt` are ALL allowed — no defer-style
 * rejection), typed via type_block so its bindings are scoped inside and don't leak `env`. The
 * bound name is a codegen/region label; it introduces no binding into `env` in this increment.
 *
 * @param parser::AdoptStmt a  the parsed AdoptStmt
 * @param Env env  the enclosing type environment (unchanged on return — the body is scoped)
 * @param TypeTable table  the program type table
 * @return TypedStmt | error  the typed statement, or a type error propagated from the body
 */
fn type_adopt(a: parser::AdoptStmt, env: Env, table: TypeTable): TypedStmt | error {
    var tb = match type_block(a.body, env, table) { TypedBlock as x => x; error as e => return e }
    TypedStmt { node = TAdoptStmt { name = a.name; body = tb.stmts }; env = env }
}

// ---- items + program (the evolved check_function/check_item/check_program — E5c) ----

// the resolved return type: the annotation if present, else void (no `-> ret` — M.3).
// (#109 W1) `ref_ns` = the function's declaring namespace; unused until W2's R0-R5 rules.
fn function_return(f: parser::Function, table: TypeTable, ref_ns: str): Type | error {
    if !f.has_return { return Void { } }
    resolve_type(f.return_type, table, ref_ns)
}

// ---- C5 (DEFER scope): `return`/final-expr vs the declared return type ----
// Every `return e` reachable as a statement must yield the declared return type, and — when the
// body's trailing statement is an expression — that value too. A `return <member>` into a variant
// return type is admissible (B.14 — a member is automatically the union, no cast). The FULL
// "every path yields a value" guarantee (divergence/definite-return analysis) is a SEPARATE later
// item (M.4): a body ending in a diverging `loop`/`if`/`match` makes NO trailing-value claim here,
// so the seed's value-fns that end in a breakless `loop` (exits are inner `return`s) are NOT
// false-rejected. (Lives in the typed pass — the producer; the superseded `check_*` layer is not
// dual-walked — see the check_*/type_* duplication note in "Próximas etapas".)

// is a value of type `from` admissible where `to` is expected? (B.14 — variant member inclusion.)
// The widening rule is now the single source of truth in resolve.tks (widens_into), shared with
// the match/`if` arm JOIN (type_join) so the binding/return/assign checks and arm unification can
// never drift apart. A case widens into a named variant (`let s: Shape = Circle { … }`), a nested
// case widens transitively, and `T` widens into `T?`.
fn assignable_to(from: Type, to: Type, table: TypeTable): bool { widens_into(from, to, table) }

/**
 * bignum_ctor_of — which `bigint`/`dec` constructor receives a machine integer, and therefore what
 * type the argument must arrive as. `u64` is the one source whose whole range the `i64`-taking `of`
 * cannot accept, so it routes to `of_u64`; every other integer prim widens losslessly into `i64`
 * and takes `of`.
 *
 * @param from  the machine integer type being widened into a bignum
 * @return      `"of_u64"` for a `u64` source, `"of"` for every other integer
 * @since       0.3.1
 */
fn bignum_ctor_of(from: Type): str {
    if prim_kind_of(from) == PrimKind::U64 { return "of_u64" }
    if prim_kind_of(from) == PrimKind::Usize { return "of_u64" }   // (§8) usize ≡ u64: full unsigned 64-bit range needs the u64 ctor (size ≡ i64 widens losslessly into `of`)
    "of"
}

/**
 * widen_int_into_bignum — the implicit widening of a machine INTEGER VALUE into `bigint`/`dec`, as a
 * call to the library constructor that receives it. The owner's rule puts `bigint`/`dec` in the same
 * sentence as the machine widths (*"o mesmo vale para floats e para bigint e decimal"*), and a
 * bignum holds every machine integer, so this direction can never overflow and never panics.
 *
 * Distinct from `bignum_adopt_operand`, which handles the same target for a bare LITERAL operand of a
 * bignum OPERATOR. That one could stay literal-only because `big + 1` is the only shape an operator
 * meets; a declared target (`let b: bigint = some_i32`) meets real VALUES, which is precisely the
 * case that used to be rejected with "no implicit conversion".
 *
 * @param v       the typed integer value
 * @param target  the candidate target type
 * @return        the constructor call yielding `v` as a bignum, or `null` when `target` is not a
 *                bignum or `v` is not a machine integer
 * @since         0.3.1
 */
fn widen_int_into_bignum(v: TExpr, target: Type): TExpr | null {
    var kind = bignum_kind(target)
    if kind == "" { return null }
    if !is_integer(v.type) { return null }
    var ctor = bignum_ctor_of(v.type)
    var arg = bignum_ctor_argument(v, ctor)
    bignum_call(kind, ctor, teko::list::push(teko::list::empty(), arg), bignum_named(kind))
}

/**
 * bignum_ctor_argument — the value as the constructor's own parameter type: `of_u64` already receives
 * the `u64` unchanged, while `of` receives an `i64`, so a narrower integer is first wrapped in the
 * lossless widening `TCast` that both backends lower to nothing.
 *
 * @param v     the typed integer value
 * @param ctor  the constructor name `bignum_ctor_of` chose
 * @return      `v`, widened to the constructor's parameter type when it is not already that type
 * @since       0.3.1
 */
fn bignum_ctor_argument(v: TExpr, ctor: str): TExpr {
    if ctor == "of_u64" { return v }
    var carrier = Prim { kind = PrimKind::I64 }
    if type_eq(v.type, carrier) { return v }
    TExpr { kind = TCast { expr = v }; type = carrier; line = v.line; col = v.col }
}

/**
 * widen_value_into — the implicit WIDENING step of the value-into-target ladder: a lossless machine
 * widening (`numeric_widens_implicitly` — the same predicate the arithmetic W-RULE uses) becomes a
 * synthetic widening `TCast`, and a machine integer into `bigint`/`dec` becomes the library
 * constructor call. Answers `null` when no implicit widening applies, leaving the caller's remaining
 * rungs (literal adoption, then the honest stop) to decide.
 *
 * The synthetic `TCast` is deliberately a REAL node in the typed tree rather than a retyped leaf:
 * the ARITH-CAST-RATE gate (D4) counts `TCast` nodes, so an implicit widening is COUNTED by the same
 * meter that bounds hand-written casts instead of slipping past it.
 *
 * @param v       the typed value
 * @param target  the declared target type
 * @return        the value as a value of `target`, or `null` when it does not implicitly widen
 * @see           numeric_widens_implicitly — the rule, its C# lineage, and its Rust divergence
 * @since         0.3.1
 */
fn widen_value_into(v: TExpr, target: Type): TExpr | null {
    if numeric_widens_implicitly(v.type, target) {
        return TExpr { kind = TCast { expr = v }; type = target; line = v.line; col = v.col }
    }
    widen_int_into_bignum(v, target)
}

/**
 * coerce_value_into — the ONE ladder a value climbs to reach a declared target type, in order:
 * already admissible (`assignable_to` — B.14 case→variant, `T`→`T?`, upcasts) → implicit numeric
 * widening (`widen_value_into`) → a fitting bare LITERAL adopting the target (`retype_literal`, C6)
 * → the honest stop naming expected and actual.
 *
 * One function because the rungs used to be open-coded at every target site — assignment, field
 * assignment, index assignment, write-through-reference — and a rung added to one was a rung missing
 * from the others. The implicit widening is exactly the kind of rung that would have been added
 * unevenly.
 *
 * @param v       the typed value
 * @param target  the declared target type
 * @param table   the folded type table
 * @param what    the diagnostic message for the target kind ("assigned value does not match …")
 * @return        the value as a value of `target`
 * @throws        `what`, annotated with the rendered expected/actual types, when no rung applies
 * @since         0.3.1
 */
/**
 * adopt_sentinel_slice_type — an UNTYPED empty collection (`teko::list::empty()` / `[]`, whose
 * element type is still the `Void` sentinel) ADOPTS the declared target's concrete slice type, so
 * codegen sees the element with no back-inference (#4). Every other value KEEPS its own natural type
 * and the target rides along as the statement's `bound`, because the emit wraps the value at the use
 * site — clobbering a case type here made a variant member emit its own fields under the union's C
 * type and cc reject the field designators.
 *
 * Extracted because the identical five lines stood in `type_binding`, `type_assign` and
 * `type_field_assign` — three copies of one rule, the shape that decays into two of them being
 * updated and the third not.
 *
 * @param v       the typed value
 * @param target  the declared target type
 * @return        `v` retyped to `target` when it is a sentinel empty collection and `target` is a
 *                concrete slice, else `v` unchanged
 */
fn adopt_sentinel_slice_type(v: TExpr, target: Type): TExpr {
    var v_is_sentinel = match v.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
    if !v_is_sentinel { return v }
    var target_is_concrete = match target { Slice as bs => match bs.element { Void => false; _ => true }; _ => false }
    if !target_is_concrete { return v }
    TExpr { kind = v.kind; type = target; line = v.line; col = v.col }
}

fn coerce_value_into(v: TExpr, target: Type, table: TypeTable, what: str): TExpr | error {
    if assignable_to(v.type, target, table) { return v }
    match widen_value_into(v, target) { TExpr as w => return w; null => { } }
    if literal_adopts(v, target) { return retype_literal(v, target) }
    teko::error::err_typed(error { message = what }, type_render(target), type_render(v.type))
}

/**
 * coerce_argument_into — the value-into-target ladder for a CALL ARGUMENT, whose rungs differ from
 * `coerce_value_into`'s in two ways an assignment has no equivalent of: an ALREADY-admissible argument
 * normally ADOPTS the parameter's type, except where the emit wraps the value at the use site and the
 * argument must keep its narrow type (`arg_keeps_narrow_type`); and a fitting literal is retyped
 * SHALLOW (its own `.type` replaced, leaves untouched), which is what the three argument sites have
 * always done.
 *
 * One function because those three sites — the plain call, the interface dispatch, and the base-class
 * dispatch — each carried their own copy of the whole ladder, and the copies had ALREADY drifted: only
 * one of the three consulted `struct_iface_named_stop`, so a nominal struct/interface mismatch got a
 * precise diagnostic through a direct call and a bare "argument type mismatch" through a dispatched
 * one. Adding the implicit-widening rung to three copies would have been the next drift.
 *
 * @param a      the typed argument
 * @param pt     the parameter's declared type
 * @param table  the folded type table
 * @return       the argument as a value of `pt`
 * @throws       the nominal-mismatch stop, or "argument type mismatch" with expected/actual attached
 * @since        0.3.1
 */
fn coerce_argument_into(a: TExpr, pt: Type, table: TypeTable): TExpr | error {
    if assignable_to(a.type, pt, table) {
        if arg_keeps_narrow_type(pt, a.type, table) { return a }
        return TExpr { kind = a.kind; type = pt; line = a.line; col = a.col }
    }
    match struct_iface_named_stop(a.type, pt, table) { error as se => return se; null => { } }
    match widen_value_into(a, pt) { TExpr as w => return w; null => { } }
    if literal_adopts(a, pt) { return TExpr { kind = a.kind; type = pt; line = a.line; col = a.col } }
    teko::error::err_typed(error { message = "argument type mismatch" }, type_render(pt), type_render(a.type))
}

/** arg_keeps_narrow_type — an argument that WIDENS into a parameter type `pt` normally ADOPTS `pt`
    (its TExpr.type is rewritten to `pt`); but where the EMIT wraps the value at the use site, the
    arg must KEEP its narrow `arg_type` so codegen/interpreter see the concrete value they must wrap. True for:
    a case→variant widen (emit_as tags the union, including a bare `T`→`T | null` present-wrap), a
    class→interface/base upcast (fat-pointer build), and a `[]E_a`→`[]E_p` element widen where
    `E_a != E_p` (the slice is REBUILT element-wise — bare `[]i64`→`[]i64 | null` or covariant
    `[]Return`→`[]Statement`; #265: the native gate cc-compiles these for the first time, so a
    widened arg-type would hide the element mismatch and cc would reject the distinct `tk_slice_*`
    struct). */
fn arg_keeps_narrow_type(pt: Type, arg_type: Type, table: TypeTable): bool {
    var pt_is_variant = match expand_variant(pt, table) { Variant => true; _ => false }
    if pt_is_variant { return true }
    if arg_class_upcast(pt, arg_type, table) { return true }
    slice_element_widens(pt, arg_type)
}

/** arg_class_upcast — the param is an interface or a polymorphic base and the arg is a
    DIFFERENT-named class conforming to it (a fat-pointer upcast the emit builds from the narrow
    class). (#265) */
fn arg_class_upcast(pt: Type, arg_type: Type, table: TypeTable): bool {
    match pt {
        Named as ptn => match arg_type {
            Named as atn => (is_interface_name(ptn.name, table) || is_polymorphic_base(ptn.name, table)) && is_class_name(atn.name, table) && ptn.name != atn.name
            _ => false
        }
        _ => false
    }
}

/** slice_element_widens — both types are slices whose ELEMENTS differ (`[]E_a` → `[]E_p`, `E_a != E_p`):
    a bare→optional element widen or a covariant case→variant element widen. The emit rebuilds the
    slice element-wise, so the arg must keep its narrow `[]E_a` type for codegen to see the mismatch.
    A SENTINEL empty slice (`teko::list::empty()`, element = `void`) is EXCLUDED — it carries no
    concrete element, so it ADOPTS the param's concrete slice type (collections #4) as before. */
fn slice_element_widens(pt: Type, arg_type: Type): bool {
    match pt {
        Slice as ps => match arg_type {
            Slice as as_ => !type_is_void(as_.element) && !type_eq(ps.element, as_.element)
            _ => false
        }
        _ => false
    }
}

// check every `return` reachable as a statement (descend into loop bodies and `if`-blocks;
// match-arm returns await the divergence item — arm bodies are expressions, not statements).
fn check_returns(stmts: []TStatement, ret: Type, table: TypeTable): error | null {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match check_return_stmt(stmts[i], ret, table) { null => { }; error as e => return e }
        i++
    }
    null
}

// the trailing value-expr of a block (its last statement, when that is an expr-statement),
// or null. (C: tblock_trailing.)
fn tblock_trailing(stmts: []TStatement): TExpr | null {
    if stmts.len == 0 { return null }
    match stmts[stmts.len - 1] {
        TExprStmt as es => es.expr
        _ => null
    }
}

// the block's trailing value-expr IF it is a numeric literal (else null) — for the if/match
// literal cross-adoption (a `64` branch adopts a sibling's numeric type). (C: tl/el + NUMBER tag.)
fn trailing_number(stmts: []TStatement): TExpr | null {
    match tblock_trailing(stmts) {
        TExpr as t => match t.kind { TNumber => t; _ => null }
        null => null
    }
}

/**
 * Does a numeric literal `n` fit the scalar destination `m` — an int/float prim it fits, or `byte`
 * (= u8, B.36)? A bool or non-numeric `m` (`cast_kind` rejects it) never fits. The single-member
 * fit test shared by the scalar and union arms of `literal_adopts`/`retype_literal`.
 *
 * @param n  the typed numeric-literal payload (its value/float flavor and magnitude)
 * @param m  the candidate destination scalar type
 * @return   true iff `n` is representable in `m` under the same range rules as a binding
 */
fn number_fits_member(n: TNumber, m: Type): bool {
    match cast_kind(m) {
        PrimKind as k => {
            if n.is_float { prim_is_float(k) && float_fits(n.fval, k) }
            else { prim_is_int(k) && numint_fits(n.value, k) }
        }
        error => false
    }
}

/**
 * The lone union MEMBER a numeric literal unambiguously adopts (C2b). A literal distributes over a
 * union only when EXACTLY ONE member is a numeric prim/byte it fits: zero fitting members means the
 * union takes no bare literal, and two or more (e.g. an `i8 | i32` both admitting `1`) are ambiguous
 * — both require an explicit type, so neither adopts. Returns that sole member, else `error`.
 *
 * @param n        the typed numeric-literal payload
 * @param members  the union's member types
 * @return         the single fitting numeric member, or `error` when zero or ≥2 fit
 * @throws         when no member fits or more than one does (the ambiguous/absent cases)
 */
fn union_sole_numeric_member(n: TNumber, members: []Type): Type | error {
    var found: Type = Void { }
    var count = 0
    var i = 0
    loop {
        if i >= members.len { break }
        if number_fits_member(n, members[i]) { found = members[i]; count = count + 1 }
        i++
    }
    if count == 1 { found } else { error { message = "not exactly one numeric union member fits the literal" } }
}

/**
 * Does a union list the `null` member — the destination a bare `null` literal adopts (C2b)? A set
 * membership test over the union's members, order-independent (the null-first canonical order is
 * incidental).
 *
 * @param members  the union's member types
 * @return         true iff one member is the `Null` unit type
 */
fn union_lists_null(members: []Type): bool {
    var i = 0
    loop {
        if i >= members.len { break }
        match members[i] { Null => return true; _ => { } }
        i++
    }
    false
}

/**
 * C6/C2b — does a fitting LITERAL adopt the destination `to` (a return value, trailing expr, binding,
 * argument, or struct-field slot)? A numeric literal adopts an int/float prim it fits or `byte`
 * (B.36); into a UNION it adopts the sole numeric member it fits (C2b — ambiguous ≥2 does not). A
 * bare `null` adopts a union listing `null` (or `Null` itself). RECURSES through a `match`/`if` whose
 * every contributing arm trails an adopting literal (so `match k { U8 => 8; … } : u32` adopts, and
 * `if b { 1 } else { null } : i32 | null` distributes each leaf over the same union). An empty/all-
 * fitting array literal adopts a `[]E` slot element-wise.
 *
 * @param e   the typed literal (or `if`/`match`/array composite whose leaves are literals)
 * @param to  the destination type the literal is checked against
 * @return    true iff every contributing literal leaf fits `to` (or its matching member)
 */
fn literal_adopts(e: TExpr, to: Type): bool {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) { Type => true; error => false }
            _ => number_fits_member(n, to)
        }
        TMatchExpr as m => {
            var any = false
            var i = 0
            loop {
                if i >= m.arms.len { break }
                if !tblock_diverges(m.arms[i].body) {   // a diverging arm yields no value (M.3)
                    match tblock_trailing(m.arms[i].body) {
                        TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                        null => return false
                    }
                }
                i++
            }
            any   // ≥1 contributing arm, all adopt
        }
        TIfExpr as f => {
            if !f.has_else { return false }   // a one-armed `if` has no value
            var any = false
            if !tblock_diverges(f.then_blk) {
                match tblock_trailing(f.then_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            if !tblock_diverges(f.else_blk) {
                match tblock_trailing(f.else_blk) {
                    TExpr as t => { if !literal_adopts(t, to) { return false }; any = true }
                    null => return false
                }
            }
            any
        }
        // an ARRAY LITERAL adopts a `[]E` slot when EVERY non-spread element adopts E (element-wise
        // literal adoption — e.g. `[0x68, 0x65]` adopts `[]byte`). Spread elements are already
        // `[]T` and were type-checked at construction time — skip adoption for them.
        // An empty `[]` adopts any slice.
        TArrayLit as a => match to {
            Slice as s => {
                var i = 0
                loop {
                    if i >= a.elements.len { break }
                    if !a.elements[i].is_spread {
                        if !literal_adopts(a.elements[i].expr, s.element) { return false }
                    }
                    i++
                }
                true
            }
            _ => false
        }
        TNullLit => match to {
            Variant as v => union_lists_null(v.members)
            Null => true
            _ => false
        }
        _ => false
    }
}

/**
 * (#71/C2b) RETYPE a value that `literal_adopts(e, to)` already accepted — the retyping twin of the
 * range-check above. A plain scalar leaf adopts by taking `to` wholesale (binding/assign/arg/struct-
 * field). Into a UNION `to`, a numeric leaf instead takes its sole fitting MEMBER (so `1` becomes
 * `i32`, assignable into `i32 | null`) and a `null` leaf becomes `Null` — the leaf is born at the
 * narrow member while the surrounding `if`/`match` becomes the union. An ARRAY LITERAL retypes
 * ELEMENT-WISE: each non-spread element recurses into the slice's element type (so a nested array-of-
 * arrays retypes at every depth), and the array's own `.type` becomes `to`. Mirrors `literal_adopts`'s
 * recursion exactly, one level deeper (it REBUILDS the already-typed tree — TExpr/TArrayLit/TArrayElem
 * are value types — rather than just reporting fit). A spread element is already a concrete `[]T` —
 * left untouched (its own widen was checked at array-literal typing time, same as the read side above).
 *
 * @param e   the typed value whose literal leaves adopt `to`
 * @param to  the destination type each contributing leaf is born at (a union → its matching member)
 * @return    the value rebuilt with its literal leaves re-typed
 */
fn retype_literal(e: TExpr, to: Type): TExpr {
    match e.kind {
        TNumber as n => match to {
            Variant as v => match union_sole_numeric_member(n, v.members) {
                Type as mem => TExpr { kind = e.kind; type = mem; line = e.line; col = e.col }
                error => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TNullLit => match to {
            Variant => TExpr { kind = e.kind; type = Null { }; line = e.line; col = e.col }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TArrayLit as a => match to {
            Slice as s => {
                var elems: []TArrayElem = teko::list::empty()
                var i = 0
                loop {
                    if i >= a.elements.len { break }
                    var el = a.elements[i]
                    if el.is_spread {
                        elems = teko::list::push(elems, el)
                    } else {
                        elems = teko::list::push(elems, TArrayElem { is_spread = false; expr = retype_literal(el.expr, s.element) })
                    }
                    i++
                }
                TExpr { kind = TArrayLit { elements = elems }; type = to; line = e.line; col = e.col }
            }
            _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
        }
        TIfExpr as f => {
            var then_blk = retype_block_trailing(f.then_blk, to)
            var else_blk = if f.has_else { retype_block_trailing(f.else_blk, to) } else { f.else_blk }
            TExpr { kind = TIfExpr { cond = f.cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = to; line = e.line; col = e.col }
        }
        TMatchExpr as m => {
            var arms: []TArm = teko::list::empty()
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var ar = m.arms[i]
                arms = teko::list::push(arms, TArm { pattern = ar.pattern; has_when = ar.has_when; guard = ar.guard; body = retype_block_trailing(ar.body, to) })
                i++
            }
            TExpr { kind = TMatchExpr { subject = m.subject; arms = arms }; type = to; line = e.line; col = e.col }
        }
        _ => TExpr { kind = e.kind; type = to; line = e.line; col = e.col }
    }
}

/**
 * Rebuilds a typed statement block so its trailing value-expression is re-typed to `to`, mirroring
 * `retype_literal`'s array-element recursion one level deeper into an `if`/`match` branch body. A
 * diverging block (`return`/`break`/trailing panic) carries no value and is returned unchanged, as
 * is a block whose last statement is not a trailing expression. Only reached for a branch whose
 * trailing value already satisfied `literal_adopts(_, to)`, so retyping its leaf is sound.
 *
 * @param stmts  the branch/arm statement block
 * @param to     the destination type each contributing branch leaf adopts
 * @return       the block with its trailing expression re-typed to `to`, or the block unchanged
 */
fn retype_block_trailing(stmts: []TStatement, to: Type): []TStatement {
    if stmts.len == 0 { return stmts }
    if tblock_diverges(stmts) { return stmts }
    match stmts[stmts.len - 1] {
        TExprStmt as es => {
            var last_index = stmts.len - 1
            var out: []TStatement = teko::list::empty()
            var i = 0
            loop {
                if i >= last_index { break }
                out = teko::list::push(out, stmts[i])
                i++
            }
            var last: TStatement = TExprStmt { expr = retype_literal(es.expr, to) }
            teko::list::push(out, last)
        }
        _ => stmts
    }
}

/**
 * (C2b) BORN every literal return-position leaf of a function body at a UNION return type `ret`, so a
 * numeric or `null` leaf that `literal_adopts(_, ret)` accepted is retyped to its member before
 * codegen (which wraps the member into the union tag). The pass is GATED on `ret` being a `Variant`:
 * a scalar/`byte`/optional return keeps its body byte-identical (codegen truncates/wraps a bare leaf
 * at the boundary exactly as before), so the change is purely additive to the new union case.
 *
 * @param stmts  the typed function-body statements
 * @param ret    the function's declared return type
 * @param table  the program's type table (for the already-assignable probe)
 * @return       the body with its adopting union return/trailing leaves born at their member, else
 *               `stmts` unchanged
 */
fn retype_union_returns(stmts: []TStatement, ret: Type, table: TypeTable): []TStatement {
    match ret {
        Variant => retype_return_positions(stmts, ret, table, true)
        _ => stmts
    }
}

/**
 * Rebuilds a statement block, re-typing each RETURN-position literal leaf to the union `ret` (C2b).
 * `retype_trailing` distinguishes a value block (a function body — its final expr-statement is a
 * return-position value) from a loop/adopt body (no trailing value; only explicit `return`s inside
 * it are return positions). Recurses through nested loop/adopt bodies and through an `if`/`match`
 * used as a statement so a `return` in any branch is reached.
 *
 * @param stmts            the statement block
 * @param ret              the union return type each return-position leaf adopts
 * @param table            the program's type table
 * @param retype_trailing  true iff the block's final expr-statement is a return-position value
 * @return                 the block with its return-position literal leaves born at their member
 */
fn retype_return_positions(stmts: []TStatement, ret: Type, table: TypeTable, retype_trailing: bool): []TStatement {
    if stmts.len == 0 { return stmts }
    var last = stmts.len - 1
    var out: []TStatement = teko::list::empty()
    var i = 0
    loop {
        if i >= stmts.len { break }
        out = teko::list::push(out, retype_return_stmt(stmts[i], ret, table, retype_trailing && i == last))
        i++
    }
    out
}

/**
 * Re-types the return-position literal leaves of a single statement to the union `ret` (C2b). An
 * explicit `return e` and (when `is_trailing`) a trailing expr-statement retype their value via
 * `retype_literal` gated on `literal_adopts` — which fires ONLY on a bare literal leaf (a number,
 * `null`, or an `if`/`match`/array composite of them), so a value already typed as the union or a
 * member (a var/call/error — `literal_adopts` is false) is left untouched. The `null` case is why
 * assignability is NOT a pre-filter: a bare-`null` sentinel widens into the union yet still must be
 * born at `Null` for codegen. A loop/adopt body recurses (returns only); an `if`/`match` statement
 * recurses into its branches.
 *
 * @param s            the statement to rebuild
 * @param ret          the union return type each return-position leaf adopts
 * @param table        the program's type table
 * @param is_trailing  true iff `s` is a return-position trailing expr-statement
 * @return             the statement with its return-position literal leaves born at their member
 */
fn retype_return_stmt(s: TStatement, ret: Type, table: TypeTable, is_trailing: bool): TStatement {
    match s {
        TReturn as r => {
            if !r.has_value { return s }
            if !literal_adopts(r.value, ret) { return s }
            TReturn { has_value = true; value = retype_literal(r.value, ret); values = teko::list::empty() }
        }
        TLoopStmt as l => TLoopStmt { label = l.label; init = l.init; body = retype_return_positions(l.body, ret, table, false) }
        TAdoptStmt as a => TAdoptStmt { name = a.name; body = retype_return_positions(a.body, ret, table, false) }
        TBlockStmt as b => TBlockStmt { body = retype_return_positions(b.body, ret, table, false) }
        TExprStmt as es => {
            var inner = retype_returns_in_expr(es.expr, ret, table)
            if is_trailing && !texpr_diverges(inner) && literal_adopts(inner, ret) {
                TExprStmt { expr = retype_literal(inner, ret) }
            } else {
                TExprStmt { expr = inner }
            }
        }
        _ => s
    }
}

/**
 * Recurses into an `if`/`match` used as a STATEMENT, re-typing the return-position leaves inside its
 * branches to the union `ret` (C2b) — the branch bodies are not trailing values (the composite is a
 * statement), so only their explicit `return`s are return positions. Any other expression is
 * returned unchanged.
 *
 * @param e      the statement-expression
 * @param ret    the union return type each nested return leaf adopts
 * @param table  the program's type table
 * @return       the expression with its branch return leaves born at their member
 */
fn retype_returns_in_expr(e: TExpr, ret: Type, table: TypeTable): TExpr {
    match e.kind {
        TIfExpr as f => {
            var then_blk = retype_return_positions(f.then_blk, ret, table, false)
            var else_blk = if f.has_else { retype_return_positions(f.else_blk, ret, table, false) } else { f.else_blk }
            TExpr { kind = TIfExpr { cond = f.cond; then_blk = then_blk; has_else = f.has_else; else_blk = else_blk }; type = e.type; line = e.line; col = e.col }
        }
        TMatchExpr as m => {
            var arms: []TArm = teko::list::empty()
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var ar = m.arms[i]
                arms = teko::list::push(arms, TArm { pattern = ar.pattern; has_when = ar.has_when; guard = ar.guard; body = retype_return_positions(ar.body, ret, table, false) })
                i++
            }
            TExpr { kind = TMatchExpr { subject = m.subject; arms = arms }; type = e.type; line = e.line; col = e.col }
        }
        _ => e
    }
}

/**
 * yields_declared_return — may a value of type `from` be the value a function declaring `ret` yields?
 * Admissible when it widens into `ret` (B.14 case→variant, `T`→`T?`, an upcast), when it IMPLICITLY
 * widens as a number (`numeric_widens_implicitly` — the owner's 2026-07-29 rule, the same rung the
 * assignment and argument ladders take), or when it is a fitting bare LITERAL adopting `ret` (C6).
 *
 * The return site is a VALIDATOR, not a rewriter — it reports whether the body is well-typed and never
 * touches the typed tree — so the implicit widening needs no node inserted here, exactly as the
 * literal rung needs none: a value that widens losslessly already IS the wider type's own bit pattern.
 *
 * Shared by the `return` statement and the trailing-expression checks, which are twins of each other
 * and were each carrying their own spelling of the same disjunction.
 *
 * @param from   the yielded value's type
 * @param value  the yielded value (the literal rung inspects its shape)
 * @param ret    the function's declared return type
 * @param table  the folded type table
 * @return       whether the value is admissible as the declared return
 * @since        0.3.1
 */
fn yields_declared_return(value: TExpr, ret: Type, table: TypeTable): bool {
    assignable_to(value.type, ret, table) || numeric_widens_implicitly(value.type, ret) || literal_adopts(value, ret)
}

fn check_return_stmt(s: TStatement, ret: Type, table: TypeTable): error | null {
    match s {
        TReturn as r => {
            if r.has_value {
                if yields_declared_return(r.value, ret, table) { null }
                // (C1.8/E2) attach expected=type_render(ret), actual=type_render(r.value.type) —
                // mirrors typer.c check_return_stmt's tk_error_types wrap.
                else { teko::error::err_typed(error { message = "return value does not match the function's declared return type" }, type_render(ret), type_render(r.value.type)) }
            } else {
                if type_is_void(ret) { null }   // a bare `return` is legal iff the function returns no value (M.3)
                else { error { message = "bare `return` in a function that declares a value-returning (non-void) return type" } }
            }
        }
        TLoopStmt as l => check_returns(l.body, ret, table)
        TExprStmt as es => check_returns_inexpr(es.expr, ret, table)
        TAdoptStmt as a => check_returns(a.body, ret, table)
        TBlockStmt as b => check_returns(b.body, ret, table)
        _ => null
    }
}

// returns can also live inside a top-level `if`'s blocks (`if c { return e }`) and inside a
// `match`'s arm blocks (arm bodies are blocks now — a `return` inside one is checked — B.20).
fn check_returns_inexpr(e: TExpr, ret: Type, table: TypeTable): error | null {
    match e.kind {
        TIfExpr as f => {
            match check_returns(f.then_blk, ret, table) { null => { }; error as e => return e }
            check_returns(f.else_blk, ret, table)
        }
        TMatchExpr as m => {
            var i = 0
            loop {
                if i >= m.arms.len { break }
                match check_returns(m.arms[i].body, ret, table) { null => { }; error as e => return e }
                i++
            }
            null
        }
        _ => null
    }
}

/**
 * name_in_set — is `name` one of `set` (a small ordered string set)? The membership test the `ref`
 * return pass-down gate uses over the function's reference-parameter names.
 *
 * @param set   the candidate names
 * @param name  the name to find
 * @return      true iff `name` occurs in `set`
 */
fn name_in_set(set: []str, name: str): bool {
    var i = 0
    loop {
        if i >= set.len { break }
        if set[i] == name { return true }
        i++
    }
    false
}

/**
 * reject_ref_return — the retirement gate for ref-return (mudancas-superficie §3, 0.3.1). A function
 * may no longer declare a `Reference` return type: `ref` survives ONLY as a PARAMETER (a
 * write-through borrow whose target is the caller's) and as a LOCAL BINDING (`ref r: T = x`), never
 * as a returned value. A `Reference`-typed return is REJECTED here; every other return passes.
 *
 * @param ret  the function's resolved return type
 * @return     null when `ret` is not a reference, else the retirement error
 * @throws     when `ret` is a `Reference`
 */
fn reject_ref_return(ret: Type): error | null {
    match ret {
        Reference => return error { message = "a function cannot return a reference" }
        _ => { }
    }
    null
}

// the trailing-value check — ONLY when the last statement is an expression (else: NO claim, the
// guard against false-rejecting a body that ends in a diverging loop/if/match — the every-path item).
fn check_trailing_value(stmts: []TStatement, ret: Type, table: TypeTable): error | null {
    if stmts.len == 0 { return null }
    match stmts[stmts.len - 1] {
        TExprStmt as es => {
            if texpr_diverges(es.expr) { null }   // a trailing panic/exit yields no value (M.3)
            else { if yields_declared_return(es.expr, ret, table) { null }
                // (C1.8/E2) attach expected=type_render(ret), actual=type_render(es.expr.type) — mirrors
                // typer.c check_trailing_value's tk_error_types wrap.
                else { teko::error::err_typed(error { message = "the function's final expression does not match its declared return type" }, type_render(ret), type_render(es.expr.type)) } }
        }
        _ => null
    }
}

// ---- W5-cf-2: loop-label validation (mirrors typer.c's check_labels; null = ok) ----
// A `break NAME`/`continue NAME` must name an ENCLOSING loop; a bare `break`/`continue` must
// be inside some loop; and all loop labels within one body must be DISTINCT, so codegen's C
// goto-labels (tk_lbl_<NAME>_break / _cont) cannot collide. `scope` is the list of enclosing
// loop labels (the C linked list, realized as a Teko list); `seen` accumulates every label in
// this body for the uniqueness check. Because Teko lists are by-value, `seen` is THREADED — it
// rides in/out of every recursive call via the LabelCheck carrier (the C threads a shared
// `seen`/`nseen` out-param; this is the same accumulation, expressed immutably). On failure the
// carrier holds the message; on success it returns the grown `seen`.
type LabelCheck = struct { failed: bool; message: str; seen: []str }

fn lbl_eq(a: str, b: str): bool { a == b }

fn lbl_enclosing(scope: []str, label: str): bool {
    var i = 0
    loop {
        if i >= scope.len { break }
        if lbl_eq(scope[i], label) { return true }
        i++
    }
    false
}

// recurse into the IF then/else blocks and the MATCH arm bodies (the only expr forms that hold
// statements). Threads `seen` through; carries `scope`/`in_loop` unchanged into the branches.
fn check_labels_inexpr(e: TExpr, scope: []str, in_loop: bool, seen: []str): LabelCheck {
    match e.kind {
        TIfExpr as f => {
            var t = check_labels(f.then_blk, scope, in_loop, seen)
            if t.failed { return t }
            check_labels(f.else_blk, scope, in_loop, t.seen)
        }
        TMatchExpr as m => {   // arm bodies are blocks now — walk each arm block (B.20)
            var acc = seen
            var i = 0
            loop {
                if i >= m.arms.len { break }
                var t = check_labels(m.arms[i].body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
                i++
            }
            LabelCheck { failed = false; message = ""; seen = acc }
        }
        _ => LabelCheck { failed = false; message = ""; seen = seen }
    }
}

/**
 * check_labels — validate every `break`/`continue` in `stmts` against its enclosing loop
 * structure: a bare `break`/`continue` must be inside SOME loop (`in_loop`); a labeled one must
 * name a loop currently in `scope`; a `LABEL: loop { }` label must be UPPER_SNAKE (#517) and unique
 * among its enclosing siblings (`seen`, dedup-checked via `lbl_enclosing`). `adopt { }` is an
 * ORDINARY block, not a
 * loop — it introduces NO label frame and does not reset `in_loop`, so a bare `break`/`continue`
 * inside still targets the enclosing loop (or is rejected when there is none), and a labeled one
 * still resolves against the SAME enclosing `scope` (mirrors codegen's region-stack crossing
 * behavior, which drops an adopter region on the way out without treating it as a loop boundary).
 *
 * @param []TStatement stmts  the statement block to validate
 * @param []str scope  every loop label currently enclosing this block (innermost last)
 * @param bool in_loop  whether SOME enclosing loop exists (enables a bare break/continue)
 * @param []str seen  loop labels already declared among `stmts`' enclosing siblings (dup-check)
 * @return LabelCheck  a LabelCheck: failed=false with the accumulated `seen` on success, else the
 *                 first violation's message
 */
fn check_labels(stmts: []TStatement, scope: []str, in_loop: bool, seen: []str): LabelCheck {
    var acc = seen
    var i = 0
    loop {
        if i >= stmts.len { break }
        match stmts[i] {
            TLoopStmt as l => {
                if l.label.len > 0 {
                    if !lexer::is_upper_snake(l.label) { return LabelCheck { failed = true; message = "loop label must be UPPER_SNAKE"; seen = acc } }
                    if lbl_enclosing(acc, l.label) { return LabelCheck { failed = true; message = "duplicate loop label within the same body"; seen = acc } }
                    acc = teko::list::push(acc, l.label)
                }
                var frame = teko::list::push(scope, l.label)   // push this label as an enclosing frame
                var t = check_labels(l.body, frame, true, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TBreakStmt as b => {
                if b.label.len == 0 {
                    if !in_loop { return LabelCheck { failed = true; message = "`break`/`continue` outside a loop"; seen = acc } }
                } else if !lbl_enclosing(scope, b.label) {
                    return LabelCheck { failed = true; message = "`break`/`continue` to an unknown loop label (no enclosing loop carries that label)"; seen = acc }
                }
            }
            TContinueStmt as c => {
                if c.label.len == 0 {
                    if !in_loop { return LabelCheck { failed = true; message = "`break`/`continue` outside a loop"; seen = acc } }
                } else if !lbl_enclosing(scope, c.label) {
                    return LabelCheck { failed = true; message = "`break`/`continue` to an unknown loop label (no enclosing loop carries that label)"; seen = acc }
                }
            }
            TExprStmt as es => {
                var t = check_labels_inexpr(es.expr, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TAdoptStmt as a => {
                var t = check_labels(a.body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            TBlockStmt as b => {
                var t = check_labels(b.body, scope, in_loop, acc)
                if t.failed { return t }
                acc = t.seen
            }
            _ => { }
        }
        i++
    }
    LabelCheck { failed = false; message = ""; seen = acc }
}

/**
 * Is `v` a two-member ABSENCE union `{ null, ptr<T> }` — the ONE null-union shape the extern
 * boundary may cross (c-types-and-marshalling-0.3.1.md §5.4.4/§9.8, crumb C2b)? This is a
 * CHECKER-LOCAL mirror of codegen's niche test (`cg_union_niche_member` ∩ `cg_type_is_niche_able`,
 * `codegen.tks:1868-1916`) restricted to the ONE member that is BOTH niche-able (a spare NULL
 * bit-pattern to lower bare, with no tag word) AND already `extern_type_ok`-admissible on its own:
 * `Ptr`. That restriction is not an approximation of the codegen predicate — it is its EXACT
 * intersection with `extern_type_ok`'s base admit list, because every OTHER niche-able shape
 * (`Str`, `Error`, a class `Named`) is already excluded by `extern_type_ok` for reasons that have
 * nothing to do with nullability (a fat `{ptr,len}` value or a by-value aggregate is not a 1:1 C
 * ABI shape either way), so checking `Ptr` alone reproduces the full predicate's admitted set
 * without threading a `CgProg` into the checker layer. `Uptr` is excluded AUTOMATICALLY, for the
 * right reason: an integer has no spare bit-pattern (`0` is data), so `uptr | null` can never
 * satisfy this test — no special case needed to bar it (`c_uptr_null_union_extern_rejected`).
 *
 * @param v  the resolved union to test
 * @return   true iff `v` is exactly `{ null, ptr<T> }` for some `T`
 */
fn extern_null_union_ok(v: Variant): bool {
    if v.members.len != 2 { return false }
    var null_count = 0
    var other: Type | null = null
    var i = 0
    loop {
        if i >= v.members.len { break }
        match v.members[i] {
            Null => null_count = null_count + 1
            _ => other = v.members[i]
        }
        i++
    }
    if null_count != 1 { return false }
    match other {
        Type as t => match t { Ptr => true; _ => false }
        null => false
    }
}

/**
 * C7.1a — is `t` legal across the `extern` boundary? A primitive (int/float/bool), `byte`,
 * `ptr`, `uptr`, an `extern type` opaque handle (a `Named` whose declaration IS an `ExternBody`),
 * or a `ptr<T> | null` absence union (C2b, `extern_null_union_ok`) — the only shapes that marshal
 * 1:1 across the C ABI. Rejects an ordinary Teko struct/enum/variant (unsupported by-value
 * aggregate FFI), `str`, and a slice/optional. `void` is handled by the CALLER, for the return
 * position only.
 *
 * @param t      the resolved param or return type
 * @param table  the program's type table (to probe a `Named`'s declaration body)
 * @return       true iff `t` may cross an `extern` signature
 */
fn extern_type_ok(t: Type, table: TypeTable): bool {
    match t {
        Prim => true
        Byte => true
        Ptr => true
        Uptr => true
        Named as nm => match type_table_find(table, nm.name, "") {   // (#109 W1) extern-kind probe on a resolved name — no referencing ns
            parser::TypeDecl as td => match td.body { parser::ExternBody => true; _ => false }
            error => false
        }
        Variant as v => extern_null_union_ok(v)
        _ => false
    }
}

/**
 * teko_rt_type_ok — C7.2: teko_rt speaks Teko's own internal ABI (tk_str/tk_ffi_sres/
 * tk_ffi_ures/etc.) and may legally declare str/[]str/str|error/null|error/i32 (`Variant` covers
 * both union shapes) — allow those for `from "teko_rt"` externs. `Named` is also allowed:
 * user-defined structs declared in teko-native namespaces (e.g. teko::time's DateTime/Date/…)
 * are passed by value across the teko_rt boundary using their generated C struct layout (the C
 * side mirrors the Teko field layout exactly — SUPREME RULE).
 *
 * @param t  the extern's declared type
 * @return   whether `t` is a legal `from "teko_rt"` extern type
 */
fn teko_rt_type_ok(t: Type): bool {
    match t {
        Str => true
        Void => true
        Prim => true
        Byte => true
        Ptr => true
        Uptr => true
        Slice => true   // []str, []byte, etc.
        Variant => true
        Named => true   // user struct (e.g. DateTime, Date) — passed by value, layout-matched
        _ => false
    }
}

/**
 * params_have_discard — does any parameter in `ps` denote the write-only DISCARD `_` (owner
 * refinement 2026-07-15)? A discard parameter has no type and the reserved name "_" — a name the
 * lexer can never mint for a real identifier, so the test is unambiguous.
 *
 * @param ps  the parameter list
 * @return    true iff at least one parameter is a `_` discard
 */
fn params_have_discard(ps: []parser::Param): bool {
    var i: u64 = 0
    loop {
        if i >= ps.len { break }
        if !ps[i].has_type && ps[i].name == "_" { return true }
        i++
    }
    false
}

/**
 * method_named — the first method in `ms` whose name equals `name`, or null when none matches. Used
 * to locate the base/interface method that GOVERNS a `_` discard parameter's type by position.
 *
 * @param ms    the method list to scan
 * @param name  the method name to find
 * @return      the matching method, or null
 */
fn method_named(ms: []parser::Function, name: str): parser::Function | null {
    var i: u64 = 0
    loop {
        if i >= ms.len { break }
        if ms[i].name == name { return ms[i] }
        i++
    }
    null
}

/**
 * type_implements_list — the interface `implements` list of the type named `name` (a class or a
 * struct), or an empty list when the type is neither, is unknown, or lists no interfaces.
 *
 * @param name    the enclosing type name
 * @param ref_ns  the referencing namespace for the type-table lookup
 * @param table   the folded type table
 * @return        the type's `implements` names, or an empty list
 */
fn type_implements_list(name: str, ref_ns: str, table: TypeTable): []str {
    match type_table_find(table, name, ref_ns) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => cb.implements
            parser::StructBody as sb => sb.implements
            _ => teko::list::empty()
        }
        error => teko::list::empty()
    }
}

/**
 * find_interface_method — the interface-required method named `name` provided by any interface in
 * `impls`, or null when none provides it. Mirrors check_one_interface's resolution (find_interface_decl
 * then effective_interface_methods), so the governing signature seen here is exactly the one the
 * conformance check validated.
 *
 * @param impls   the type's `implements` interface names
 * @param name    the method name to find
 * @param table   the folded type table
 * @param ref_ns  the conforming type's namespace (interface lookups resolve here)
 * @return        the matching interface method, or null
 */
fn find_interface_method(impls: []str, name: str, table: TypeTable, ref_ns: str): parser::Function | null {
    var i: u64 = 0
    loop {
        if i >= impls.len { break }
        match find_interface_decl(impls[i], table, ref_ns) {
            IfaceHit as h => match h.decl.body {
                parser::InterfaceBody as ib => match effective_interface_methods(ib, h.ns, table, teko::list::push(teko::list::empty(), qualify(h.ns, name_last_segment(h.decl.name)))) {
                    []parser::Function as ms => match method_named(ms, name) { parser::Function as m => return m; null => { } }
                    error => { }
                }
                _ => { }
            }
            error => { }
        }
        i++
    }
    null
}

/**
 * discard_governing_sig — the base/interface method whose signature dictates the TYPES of a `_`
 * discard parameter in method `f` of type `struct_name` (owner refinement 2026-07-15): the base
 * class's same-named method (when `f` overrides) or a same-named method of an interface the type
 * implements. Null when `f` neither overrides nor implements a same-named method — the caller then
 * rejects the discard parameter as illegal in a self-owned signature.
 *
 * @param f            the method being typed
 * @param struct_name  the enclosing type name (bare or canonical)
 * @param ref_ns       the enclosing type's namespace
 * @param table        the folded type table
 * @return             the governing base/interface method, or null when none matches
 */
fn discard_governing_sig(f: parser::Function, struct_name: str, ref_ns: str, table: TypeTable): parser::Function | null {
    match type_table_find(table, struct_name, ref_ns) {
        parser::TypeDecl as td => match td.body {
            parser::ClassBody as cb => {
                if cb.has_base {
                    match find_class_body(cb.base_name, table) {
                        parser::ClassBody as bcb => match effective_class_methods(bcb, table) {
                            []parser::Function as ms => match method_named(ms, f.name) { parser::Function as m => return m; null => { } }
                            error => { }
                        }
                        error => { }
                    }
                }
            }
            _ => { }
        }
        error => { }
    }
    find_interface_method(type_implements_list(struct_name, ref_ns, table), f.name, table, ref_ns)
}

/**
 * discard_param_name — the synthesized C-visible name for the `_` discard parameter at position
 * `idx`: unique per position so multiple `_` params never collide in the emitted C signature, while
 * the body can never name it (a discard read is a compile error).
 *
 * @param idx  the parameter's positional index
 * @return     a per-position throwaway parameter name
 */
fn discard_param_name(idx: u64): str { $"_tk_discard_{idx}" }

/**
 * discard_param_type — the resolved type of the `_` discard parameter at position `idx`, taken BY
 * POSITION from the governing base/interface signature `gov`. A null `gov` is the GATE: a `_`
 * discard parameter is only legal in an implementing/overriding signature.
 *
 * @param gov     the governing base/interface method, or null
 * @param idx     the discard parameter's positional index
 * @param table   the folded type table
 * @param ref_ns  the conforming type's namespace (the governing param type resolves here, matching
 *                the conformance check's own resolution namespace)
 * @return        the resolved discard-parameter type
 * @throws        when `gov` is null (a discard param in a self-owned signature), when `idx` has no
 *                matching governing slot, or when the governing param type fails to resolve
 */
fn discard_param_type(gov: parser::Function | null, idx: u64, table: TypeTable, ref_ns: str): Type | error {
    match gov {
        parser::Function as g => {
            if idx >= g.params.len { return error { message = "a `_` discard parameter has no matching slot in the implemented/overridden signature" } }
            resolve_type(g.params[idx].type_ann, table, ref_ns)
        }
        null => error { message = "a `_` discard parameter is only allowed when implementing an interface method or overriding a base method — a plain function must name its parameters" }
    }
}

/**
 * (OOP A1, 2026-07-01) Type-check a struct/class METHOD's BODY. Mirrors type_function, except the
 * RECEIVER param (`has_type=false`, only ever index 0) binds to `Named{struct_name}` instead of going
 * through resolve_type (its type is implicit, never written by the user). (#254) The method's
 * type-param table is PREPENDED with the enclosing type's own params, so a body referencing `T`
 * resolves against the owner's `T` — a NO-OP for a non-generic owner.
 *
 * @param f                  the method to type-check
 * @param struct_name        the enclosing type name (bare from the caller; canonicalized here)
 * @param env                the typing environment
 * @param table              the folded type table
 * @param has_base           does this method's class extend a base class (super reachable via `base`)?
 * @param base_name          the (canonical) base class name (valid iff has_base)
 * @param declaring_class    the class that ORIGINALLY declared this body (intern/private access ctx)
 * @return                   the typed method as a TFunction (namespace stamped by the caller)
 */
/**
 * canonical_base_type — the CANONICAL type of the injected `base` handle a subclass method reaches
 * its inherited members through (#109 W3 / #152). `base_name` arrives PRE-QUALIFIED from
 * `canon_class_bases` (a cross-namespace base is already exact); a BARE name — unresolvable, or
 * declared at the root — is qualified by the class's own namespace.
 *
 * @param base_name  the base class name, pre-qualified or bare
 * @param cur_ns     the namespace of the class whose method is being typed
 * @return           the base handle's canonical `Named` type
 * @since            0.3.1
 */
fn canonical_base_type(base_name: str, cur_ns: str): Type {
    if name_qualifier(base_name) != "" { return Named { name = base_name } }
    Named { name = qualify(cur_ns, base_name) }
}

/**
 * is_method_receiver — is parameter `i` the method's RECEIVER (the implicit `self`)? The receiver is
 * the only parameter the parser leaves UNTYPED, and it can only be the first one; every other
 * parameter carries its annotation from source.
 *
 * It matters to mutability because writing a field is the privilege of the declaring type's own
 * methods (owner ruling 2026-07-30, the `private set` half of the `let` analogy) and a method
 * reaches its fields through this binder. The receiver is the object AS a reference — the identity
 * axis, born mutable — so it is defined writable while every other parameter stays immutable (B.21)
 * unless it is declared `ref`.
 *
 * @param f  the method being typed
 * @param i  the parameter index
 * @return   true iff parameter `i` is the implicit receiver
 * @since    0.3.1
 */
fn is_method_receiver(f: parser::Function, i: u64): bool {
    if i != 0 { return false }
    !f.params[0].has_type
}

fn type_method(f: parser::Function, struct_name: str, env: Env, table: TypeTable, has_base: bool, base_name: str, declaring_class: str): TFunction | error {
    // (W10b.CLASS residual — intern visibility) this body's OWN field/method accesses are
    // checked against `declaring_class` (see type_struct_methods's own comment on why this can
    // differ from `struct_name`), NOT `struct_name` — set before typing the body below.
    var local = with_owner(env, declaring_class)
    var tbl = method_type_param_table(receiver_canonical_name(struct_name, env.cur_ns, table), f.type_params, f.type_constraints, "", table)
    var is_teko_rt = f.is_extern && f.from_lib == "teko_rt"
    // (§4 G) `base` — the super receiver an INSTANCE method of a subclass uses to reach the base
    // object. Only meaningful for an INSTANCE method (has a receiver); a class's static methods never
    // chain/inherit, so there is no base object to bind there. The binding is a REINTERPRET of the
    // SAME receiver pointer as the base type — sound because effective_class_fields lays out the
    // base's fields as a PREFIX of the derived struct (field-flattening composition, increment 2), so
    // a `tk_t_Derived *` and a `tk_t_Base *` pointing at the SAME address read identical base fields.
    var is_instance_method = f.params.len > 0 && !f.params[0].has_type
    var inject_base = has_base && is_instance_method
    // codegen reads TFunction.params[i].type_ann DIRECTLY (the syntactic node, not the checked
    // Type) to emit a C signature — so the receiver's placeholder type_ann (no_type(), from
    // parsing) must be REWRITTEN to a real Named(struct_name) TypeExpr before it ever reaches
    // codegen, or emit_function_sig recurses on an empty path (M.1 crash). Every other param's
    // type_ann is already meaningful from parsing and passes through unchanged.
    var discard_gov: parser::Function | null = if params_have_discard(f.params) { discard_governing_sig(f, struct_name, env.cur_ns, table) } else { null }
    var fixed_params: []parser::Param = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if !f.params[i].has_type && f.params[i].name == "_" {
            var dpt = match discard_param_type(discard_gov, i, tbl, env.cur_ns) { Type as t => t; error as e => return e }
            fixed_params = teko::list::push(fixed_params, parser::Param { name = discard_param_name(i); has_type = true; type_ann = type_to_texpr(dpt); is_params = false; has_default = false; default_expr = parser::no_expr() })
            i++
            continue
        }
        var is_self_typed = f.params[i].has_type && return_type_is_self(f.params[i].type_ann)
        var pt = if !f.params[i].has_type || is_self_typed {
            Named { name = qualify(env.cur_ns, struct_name) }   // (#109 W3) canonical: the method's own ns qualifies its receiver type
        } else {
            match resolve_type(f.params[i].type_ann, tbl, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the method's enclosing namespace
        }
        fixed_params = teko::list::push(fixed_params, if !f.params[i].has_type || is_self_typed {
                parser::Param { name = f.params[i].name; has_type = true; type_ann = type_to_texpr(pt); is_params = false; has_default = false; default_expr = parser::no_expr() }
            } else {
                f.params[i]
        })
        if f.is_extern {
            if is_teko_rt {
                if !teko_rt_type_ok(pt) {
                    return error { message = "a `teko_rt` extern function parameter must be a primitive, `str`, slice, variant, or optional (C7.2)" }
                }
            } else {
                if !extern_type_ok(pt, table) {
                    return error { message = "an `extern` function parameter must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, or an `extern type` handle (C7.1a)" }
                }
            }
        }
        local = define(local, f.params[i].name, pt, is_method_receiver(f, i))
        i++
    }
    // (§4 G) `base` — the super receiver — is defined as a reinterpret of `self` to the base type,
    // under the fixed name `base`. It is now the SOLE path to super (the named binding was retired).
    if inject_base { local = define(local, "base", canonical_base_type(base_name, env.cur_ns), true) }
    var ret = if f.has_return && return_type_is_self(f.return_type) {
        self_return_named(struct_name, env.cur_ns, table)
    } else {
        match function_return(f, tbl, env.cur_ns) { Type as t => t; error as e => return e }
    }
    if is_ref_null_variant(ret) { return error { message = "a function cannot return an optional reference (`Ref<T> | null`) — references are pass-down only (R3)" } }
    if f.is_extern {
        var ret_ok = if is_teko_rt {
            teko_rt_type_ok(ret)
        } else {
            match ret { Void => true; _ => extern_type_ok(ret, table) }
        }
        if !ret_ok {
            return error { message = "an `extern` function return must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, an `extern type` handle, or absent (C7.1a)" }
        }
        var no_body: []TStatement = teko::list::empty()
        return TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = fixed_params; return_type = ret; body = no_body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = true; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = teko::list::empty() }
    }
    match check_param_defaults(f, local, tbl) { null => { }; error as e => return e }
    var tb = match type_block(f.body, with_ret_expected(local, ret), tbl) { TypedBlock as bk => bk; error as e => return e }
    match check_returns(tb.stmts, ret, table) { null => { }; error as e => return e }
    match check_trailing_value(tb.stmts, ret, table) { null => { }; error as e => return e }
    match reject_ref_return(ret) { null => { }; error as e => return e }   // §3: ref-return retired
    var lc = check_labels(tb.stmts, teko::list::empty(), false, teko::list::empty())
    if lc.failed { return error { message = lc.message } }
    var ret_stmts = retype_union_returns(tb.stmts, ret, table)
    // (§4 G / #98 Option A) PREPEND the `base` super-binding as the method body's FIRST statement: a
    // synthetic `let base: <Base> = <self>` — self UPCAST to the base, NOT a reinterpret-cast.
    // Binding self (the concrete subclass) with the base-typed `bound` lets emit_as build the D3 fat
    // pointer (data + tk_vt_<Sub>_<Base>), so dispatch through `base` works uniformly under the
    // one-representation model (widens_into now permits the Sub→Base widen). Checked ABOVE the
    // injection (check_returns/check_trailing_value/check_labels all read the ORIGINAL body) since it
    // changes nothing about return/trailing-value/label semantics.
    var body = if inject_base {
        var receiver_name = f.params[0].name
        var cast_val = TExpr {
            kind = TVar { name = receiver_name; is_func = false; func_ns = "" }
            type = Named { name = qualify(env.cur_ns, struct_name) }   // (#109 W3) canonical: self's concrete subclass type qualified by the method's ns
            line = 0; col = 0
        }
        var base_bound = Named { name = if name_qualifier(base_name) != "" { base_name } else { qualify(env.cur_ns, base_name) } }
        // (§4 G) the `base` super-binding: a self→base upcast bound to the fixed name `base`, the sole
        // super path. Prepended as the method body's FIRST statement.
        var base_kw_stmt = TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = "base" }; bound = base_bound; value = cast_val }
        var prefixed: []TStatement = teko::list::push(teko::list::empty(), base_kw_stmt)
        var si = 0
        loop { if si >= ret_stmts.len { break }; prefixed = teko::list::push(prefixed, ret_stmts[si]); si++ }
        prefixed
    } else {
        ret_stmts
    }
    var tf = TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = fixed_params; return_type = ret; body = body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = false; c_symbol = f.c_symbol; from_lib = ""; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = teko::list::empty() }
    match check_ref_storability(tf) { null => { }; error as e => return e }
    tf
}

/**
 * (#331 L2a) POST-typing Ref-storability gate. `fn_spine` needs a fully-typed `TFunction`, so this
 * runs ONCE per function after the body is assembled (it cannot be threaded into `type_binding`,
 * which runs mid-typing before any `TFunction` exists). It ADMITS a ref bound / reassigned to a
 * local IFF the spine proves the borrow's referent outlives it; otherwise it re-raises the R5 reject
 * the inline gate deferred. The only ref value obtainable today is a `Ref<T>` parameter read, so an
 * admitted ref-to-local is `bf = BfParam` and its referent is caller-owned (strictly outlives the
 * local). An un-nameable RHS (`if`/`match`/call) yields `cell_of == -1` ⇒ conservative reject.
 *
 * @param TFunction tf  the fully-typed function
 * @return error?  null when every ref-to-local is spine-sound, else the R5 reject error
 */
fn check_ref_storability(tf: TFunction): error | null {
    if !fn_has_ref_param(tf) { return null }
    check_ref_storability_block(tf.body, fn_spine(tf))
}

/**
 * True iff any of the function's parameters is a `Ref<T>`. The ONLY reference value obtainable today
 * is a `Ref<T>` parameter read, so a function with no ref parameter can hold no ref-to-local — the
 * gate skips it without building the spine (a per-function cost paid only where a ref can appear).
 *
 * @param TFunction tf  the typed function
 * @return bool  true iff at least one parameter is a reference
 */
fn fn_has_ref_param(tf: TFunction): bool {
    var i = 0
    loop {
        if i >= tf.params.len { break }
        var p = tf.params[i]
        if p.has_type {
            if type_ann_is_ref(p.type_ann) { return true }
        }
        i++
    }
    false
}

/**
 * Walk a statement block, checking each ref-to-local bind/assign and recursing into nested blocks.
 *
 * @param []TStatement stmts  the typed statement block
 * @param Spine spine  the function's spine fact
 * @return error?  null when sound, else the first reject error
 */
fn check_ref_storability_block(stmts: []TStatement, spine: Spine): error | null {
    var i = 0
    loop {
        if i >= stmts.len { break }
        match check_ref_storability_stmt(stmts[i], spine) { error as e => return e; null => { } }
        i++
    }
    null
}

/**
 * Check one statement: a ref-to-local `TBinding` / simple `TAssign` is gated by the spine; loop /
 * defer / adopt bodies and value-position `if`/`match` arms recurse so a branch-nested ref-bind is
 * not missed (mirrors the cell-universe walk).
 *
 * @param TStatement s  the typed statement
 * @param Spine spine  the function's spine fact
 * @return error?  null when sound, else the reject error
 */
fn check_ref_storability_stmt(s: TStatement, spine: Spine): error | null {
    match s {
        TBinding as b => match check_ref_bind_storable(b, spine) { error as e => return e; null => check_ref_storability_expr(b.value, spine) }
        TAssign as a => match check_ref_assign_storable(a, spine) { error as e => return e; null => check_ref_storability_expr(a.value, spine) }
        TLoopStmt as l => match check_ref_storability_block(l.init, spine) { error as e => return e; null => check_ref_storability_block(l.body, spine) }
        TDeferStmt as d => check_ref_storability_block(d.body, spine)
        TAdoptStmt as a => check_ref_storability_block(a.body, spine)
        TBlockStmt as b => check_ref_storability_block(b.body, spine)
        TReturn as r => if r.has_value { check_ref_storability_expr(r.value, spine) } else { null }
        TExprStmt as es => check_ref_storability_expr(es.expr, spine)
        TBreakStmt => null
        TContinueStmt => null
    }
}

/**
 * Recurse the Ref-storability check into a value-position `if`/`match`'s arm bodies (each a statement
 * block); any other expression carries no block, so it is a no-op.
 *
 * @param TExpr e  the typed expression
 * @param Spine spine  the function's spine fact
 * @return error?  null when sound, else the reject error
 */
fn check_ref_storability_expr(e: TExpr, spine: Spine): error | null {
    match e.kind {
        TIfExpr as f => match check_ref_storability_block(f.then_blk, spine) { error as er => return er; null => if f.has_else { check_ref_storability_block(f.else_blk, spine) } else { null } }
        TMatchExpr as m => check_ref_storability_match(m, spine)
        _ => null
    }
}

/**
 * Recurse the Ref-storability check into every match arm body.
 *
 * @param TMatchExpr m  the typed match expression
 * @param Spine spine  the function's spine fact
 * @return error?  null when sound, else the reject error
 */
fn check_ref_storability_match(m: TMatchExpr, spine: Spine): error | null {
    var i = 0
    loop {
        if i >= m.arms.len { break }
        match check_ref_storability_block(m.arms[i].body, spine) { error as e => return e; null => { } }
        i++
    }
    null
}

/**
 * Gate a `TBinding`: a bare-`Reference`-bound `SimpleName`, OR a `Ref<T> | null`-bound `SimpleName`
 * whose initializer is itself a live reference (a `&x` borrow or a ref-param alias — null-union C5
 * lifting the "references are parameter-only" restriction for the two-member ref-null shape), is a
 * ref-to-local; the spine must prove the borrow's referent outlives it. A `Ref<T> | null` local
 * initialized to `null` borrows nothing and cannot dangle, so it is admitted without an outlives
 * proof. A destructure names no single ref cell.
 *
 * @param b      the typed binding
 * @param spine  the function's spine fact
 * @return       null when sound, else the R5 reject error
 * @throws       error when the ref-to-local's referent does not provably outlive the borrow
 */
fn check_ref_bind_storable(b: TBinding, spine: Spine): error | null {
    var is_ref_bind = match b.bound {
        Reference => true
        _ => is_ref_null_variant(b.bound) && type_contains_ref(b.value.type)
    }
    if !is_ref_bind { return null }
    match b.target {
        parser::SimpleName as sn => ref_borrow_or_error(spine, sn.name, b.value)
        parser::DestructurePattern => null
    }
}

/**
 * Gate a `TAssign`: only a bare-`Reference` simple-name reassign is a ref-to-local; a field / deref
 * write names no single ref-to-local pair.
 *
 * @param TAssign a  the typed assignment
 * @param Spine spine  the function's spine fact
 * @return error?  null when sound, else the reject error
 */
fn check_ref_assign_storable(a: TAssign, spine: Spine): error | null {
    match a.kind {
        parser::AssignKind::Simple => match a.bound { Reference => ref_borrow_or_error(spine, a.name, a.value); _ => null }
        _ => null
    }
}

/**
 * The referent NAME a local ref-bind's RHS names: the borrowed local `x` of an explicit `&x`
 * (`TBorrow` — the F1.3 borrow site) whose operand is a bare `TVar`, else the aliased source of a
 * bare `Reference`-param read (`alias_src_name`). "" when the RHS names no single referent (an
 * `if`/`match`/call/non-lvalue borrow), yielding a conservative `cell_of == -1` reject.
 *
 * @param TExpr value  the ref-bind's typed RHS
 * @return str  the referent local's name, or "" when the RHS names none
 */
fn ref_bind_referent_name(value: TExpr): str {
    match value.kind {
        TBorrow as tb => match tb.operand.kind {
            TVar as v => v.name
            _ => ""
        }
        _ => alias_src_name(value)
    }
}

/**
 * The core spine query for one ref-to-local site: ADMIT iff `ref_target_outlives(borrow = the storage
 * local's cell, referent = the RHS source cell)` holds. The bf writer set `bf[borrow]` to `BfParam`
 * (a `Reference`-param alias `let r = p`) or `BfLocal` (an explicit `&x` borrow, F1.3) so the tag is
 * meaningful; an un-nameable RHS or an un-found cell (`cell_of == -1`) is a conservative reject with
 * the UNCHANGED R5 diagnostic (no fixture drift).
 *
 * @param Spine spine  the function's spine fact
 * @param str target  the ref-to-local binding/assign's storage local name
 * @param TExpr value  the RHS expression (its borrowed / aliased local name is the referent)
 * @return error?  null when the borrow provably outlives, else the R5 reject error
 */
fn ref_borrow_or_error(spine: Spine, target: str, value: TExpr): error | null {
    var borrow = cell_of(spine, target)
    var referent = cell_of(spine, ref_bind_referent_name(value))
    if borrow >= 0 {
        if referent >= 0 {
            if ref_target_outlives(spine, borrow to u32, referent to u32) { return null }
        }
    }
    error { message = "a reference cannot be bound to a local (parameter-only in this version)" }
}

/**
 * Type-checks a top-level namespace FUNCTION's body, producing the fully typed `TFunction` item
 * (an `extern` declaration is bodyless and returns early with an empty body — its return/param
 * marshalling is still validated).
 *
 * @param parser::Function f  the function to type-check
 * @param Env env  the typing environment
 * @param TypeTable table  the folded type table
 * @return TFunction | error  the typed function
 * @throws bad return/trailing value, or a label failure
 */
/**
 * check_param_defaults — enforce §9 C ruling 1 (owner sealed T2): every defaulted parameter's
 * default value MUST be a compile-time constant expression. `resolve_defargs` inlines each default
 * at the omitting call site, so a non-const default (a function call, a `var`/`let` read, an
 * allocation) would smuggle a per-call side effect into an omitted argument. Each `default_expr` is
 * typed in the function's parameter environment and forwarded to `is_const_expr` — the same D1
 * const-grammar gate a `const` initializer passes — so the two share one definition of "const".
 *
 * @param f      the function/method whose parameter defaults are validated
 * @param env    the environment with the function's parameters and generics in scope
 * @param table  the resolved type table (with the fn's type-params folded in)
 * @return       null when every default is a compile-time constant, else a located error
 * @throws       when a defaulted parameter's `default_expr` is not a compile-time constant expression
 * @since §9 C
 */
fn check_param_defaults(f: parser::Function, env: Env, table: TypeTable): error | null {
    var i: u64 = 0
    loop {
        if i >= f.params.len { break }
        if f.params[i].has_default {
            var te = match type_expr(f.params[i].default_expr, env, table) { TExpr as x => x; error as e => return e }
            match is_const_expr(te, table, env) {
                null => { }
                error => return error { message = $"the default for parameter '{f.params[i].name}' must be a compile-time constant expression" }
            }
        }
        i++
    }
    null
}

fn type_function(f: parser::Function, env: Env, table: TypeTable): TFunction | error {
    var local = env
    var tbl = type_param_table(f.type_params, f.type_constraints, "", table)   // (S4) the fn's generic type-params, opaque, in scope
    var is_teko_rt = f.is_extern && f.from_lib == "teko_rt"   // C7.2: bypass for Teko's own runtime
    var i = 0
    loop {
        if i >= f.params.len { break }
        if !f.params[i].has_type && f.params[i].name == "_" {
            return error { message = "a `_` discard parameter is only allowed when implementing an interface method or overriding a base method — a plain function must name its parameters" }
        }
        var pt = match resolve_type(f.params[i].type_ann, tbl, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the fn's enclosing namespace
        if f.is_extern {
            if is_teko_rt {
                if !teko_rt_type_ok(pt) {
                    return error { message = "a `teko_rt` extern function parameter must be a primitive, `str`, slice, variant, or optional (C7.2)" }
                }
            } else {
                if !extern_type_ok(pt, table) {
                    return error { message = "an `extern` function parameter must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, or an `extern type` handle (C7.1a)" }
                }
            }
        }
        local = define(local, f.params[i].name, pt, false)   // params are immutable (B.21)
        i++
    }
    var ret = match function_return(f, tbl, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the fn's enclosing namespace
    if is_ref_null_variant(ret) { return error { message = "a function cannot return an optional reference (`Ref<T> | null`) — references are pass-down only (R3)" } }
    if f.is_extern {
        // an extern is a bodyless foreign declaration (no body to check / return-analyze).
        // Validate the return marshals (void = no value is fine; else prim/byte only for now).
        var ret_ok = if is_teko_rt {
            teko_rt_type_ok(ret)
        } else {
            match ret { Void => true; _ => extern_type_ok(ret, table) }
        }
        if !ret_ok {
            return error { message = "an `extern` function return must be a primitive (int/float/bool), `byte`, `ptr`, `uptr`, an `extern type` handle, or absent (C7.1a)" }
        }
        var no_body: []TStatement = teko::list::empty()
        return TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = ret; body = no_body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = true; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = teko::list::empty() }
    }
    match check_param_defaults(f, local, tbl) { null => { }; error as e => return e }
    var tb = match type_block(f.body, with_ret_expected(local, ret), tbl) { TypedBlock as bk => bk; error as e => return e }
    match check_returns(tb.stmts, ret, table) { null => { }; error as e => return e }   // C5: each `return e` matches `ret`
    match check_trailing_value(tb.stmts, ret, table) { null => { }; error as e => return e }   // C5: trailing value (when present) matches
    match reject_ref_return(ret) { null => { }; error as e => return e }   // §3: ref-return retired
    var lc = check_labels(tb.stmts, teko::list::empty(), false, teko::list::empty())   // W5-cf-2: loop labels resolve + are unique
    if lc.failed { return error { message = lc.message } }
    var ret_stmts = retype_union_returns(tb.stmts, ret, table)
    var tf = TFunction { overload_suffix = ""; name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = ret; body = ret_stmts; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = ""; file = ""; line = 0; col = 0; is_test = f.is_test; is_extern = false; c_symbol = f.c_symbol; from_lib = ""; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_extra = teko::list::empty() }
    match check_ref_storability(tf) { null => { }; error as e => return e }
    tf
}

/**
 * operator_return_class — the return-type class a value-type operator must satisfy (§9 ruling 3):
 * "self" for arithmetic and bitwise operators (`__add`…`__mod`, `__band`…`__shr`, and the unary
 * `__bnot`), "bool" for the comparison operators (`__eq`…`__ge`), "element" for the index operator
 * (`__index`, whose return is the element type and is otherwise unconstrained), or "" when `name` is
 * not a recognized overloadable dunder.
 *
 * @param name  the operator member's dunder name
 * @return      "self", "bool", "element", or "" for an unrecognized name
 * @since §9
 */
fn operator_return_class(name: str): str {
    if name == "__add" || name == "__sub" || name == "__mul" || name == "__div" || name == "__mod" { return "self" }
    if name == "__band" || name == "__bor" || name == "__bxor" || name == "__shl" || name == "__shr" || name == "__bnot" { return "self" }
    if name == "__eq" || name == "__ne" || name == "__lt" || name == "__gt" || name == "__le" || name == "__ge" { return "bool" }
    if name == "__index" { return "element" }
    ""
}

/**
 * operator_expected_arity — the operand count a value-type operator must declare (§9 ruling 1): 1 for
 * the sole unary operator `__bnot`, 2 for every binary operator (arithmetic, comparison, bitwise, and
 * `__index`, whose operands are the receiver and the subscript).
 *
 * @param name  the operator member's dunder name
 * @return      the required operand count
 * @since §9
 */
fn operator_expected_arity(name: str): u64 {
    if name == "__bnot" { return 1 to u64 }
    2 to u64
}

/**
 * type_is_indexed — is `t` a primitively subscriptable type (a `str` or a slice `[]T`)? Mirrors the
 * receiver classes `type_index` accepts, so `operator __index` is admitted (§9 ruling 4) only on a
 * newtype whose backing the primitive fallback could itself index.
 *
 * @param t  the resolved backing type
 * @return   true iff `t` is `str` or a slice
 * @since §9
 */
fn type_is_indexed(t: Type): bool {
    match t {
        Str => true
        Slice => true
        _ => false
    }
}

/**
 * newtype_base_is_indexed — does the value-type `td` back an `operator __index` legally (§9 ruling
 * 4)? True only for a `NewtypeBody` whose resolved backing is an indexed type (`str`/slice); an
 * enum/flags value-type or a scalar newtype (`type Celsius = i32`) is never indexed.
 *
 * @param td      the value-type declaration
 * @param ref_ns  the declaration's namespace (for backing-type resolution)
 * @param table   the folded type table
 * @return        true iff an `__index` operator is permitted on `td`
 * @since §9
 */
fn newtype_base_is_indexed(td: parser::TypeDecl, ref_ns: str, table: TypeTable): bool {
    match td.body {
        parser::NewtypeBody as nb => match resolve_type(nb.backing, table, ref_ns) {
            Type as bt => type_is_indexed(bt)
            error => false
        }
        _ => false
    }
}

/**
 * comparator_counterpart — the mandatory counterpart of a comparison operator (§9 ruling 5):
 * `__eq`⟂`__ne`, `__lt`⟂`__ge`, `__gt`⟂`__le`. Returns "" for a non-comparison dunder (arithmetic,
 * bitwise, and index operators are individual — no counterpart).
 *
 * @param name  the operator member's dunder name
 * @return      the counterpart dunder, or "" when none is required
 * @since §9
 */
fn comparator_counterpart(name: str): str {
    if name == "__eq" { return "__ne" }
    if name == "__ne" { return "__eq" }
    if name == "__lt" { return "__ge" }
    if name == "__ge" { return "__lt" }
    if name == "__gt" { return "__le" }
    if name == "__le" { return "__gt" }
    ""
}

/**
 * op_diag — a located §9 operator-definition diagnostic, positioned on the operator member itself so
 * the error names the exact `operator` line rather than the whole type declaration.
 *
 * @param op   the offending operator member
 * @param msg  the diagnostic text
 * @return     the located error
 * @since §9
 */
fn op_diag(op: parser::Function, msg: str): error {
    teko::error::err_loc(error { message = msg }, op.line, op.col)
}

/**
 * check_one_operator — validate a single value-type `operator` member at DEFINITION (§9 rulings
 * 1/3/4): the dunder name is a recognized overloadable operator; the operand count matches the
 * operator's arity; every operand is explicitly typed and at least one is `self`; a return type is
 * declared and matches the operator's class (arithmetic/bitwise → `self`, comparison → `bool`, index
 * → the element type); and `__index` appears only on an indexed value-type.
 *
 * @param td      the owning value-type declaration
 * @param op      the operator member to validate
 * @param ref_ns  the declaration's namespace (for return/backing resolution)
 * @param table   the folded type table
 * @return        null when the operator is well-formed, else the first located diagnostic
 * @throws        a diagnostic naming the violated ruling (unknown dunder, arity, missing `self`,
 *                wrong return type, or an `__index` on a non-indexed carrier)
 * @since §9
 */
fn check_one_operator(td: parser::TypeDecl, op: parser::Function, ref_ns: str, table: TypeTable): null | error {
    var cls = operator_return_class(op.name)
    if cls == "" {
        return op_diag(op, $"`operator {op.name}` is not a recognized overloadable operator (§9 ruling 2)")
    }
    var arity = operator_expected_arity(op.name)
    if op.params.len != arity {
        return op_diag(op, $"`operator {op.name}` must take exactly {arity} operand(s) (§9 ruling 1)")
    }
    var saw_self = false
    var j = 0
    loop {
        if j >= op.params.len { break }
        if !op.params[j].has_type {
            return op_diag(op, $"every operand of `operator {op.name}` must be explicitly typed (§9 ruling 1)")
        }
        if return_type_is_self(op.params[j].type_ann) { saw_self = true }
        j++
    }
    if !saw_self {
        return op_diag(op, $"at least one operand of `operator {op.name}` must be `self` (§9 ruling 1)")
    }
    if !op.has_return {
        return op_diag(op, $"`operator {op.name}` must declare a return type (§9 ruling 3)")
    }
    if cls == "self" && !return_type_is_self(op.return_type) {
        return op_diag(op, $"an arithmetic/bitwise `operator {op.name}` must return `self` (§9 ruling 3)")
    }
    if cls == "bool" {
        if return_type_is_self(op.return_type) {
            return op_diag(op, $"a comparison `operator {op.name}` must return `bool` (§9 ruling 3)")
        }
        match resolve_type(op.return_type, table, ref_ns) {
            Type as rt => if !is_bool(rt) { return op_diag(op, $"a comparison `operator {op.name}` must return `bool` (§9 ruling 3)") }
            error as e => return e
        }
    }
    if op.name == "__index" && !newtype_base_is_indexed(td, ref_ns, table) {
        return op_diag(op, $"`operator __index` is allowed only on an indexed value-type (over `str` or `[]T`), never a scalar newtype (§9 ruling 4)")
    }
    null
}

/**
 * check_comparator_counterparts — enforce ruling 5: a value-type that declares one side of a
 * comparison pair must declare the other. Scans the value-type's operator members; the first
 * comparison operator whose mandated counterpart is absent yields a located diagnostic naming the
 * missing dunder.
 *
 * @param methods  the value-type body's members (operators + methods)
 * @return         null when every comparison operator has its counterpart, else the diagnostic
 * @throws         a diagnostic naming the missing counterpart dunder
 * @since §9
 */
fn check_comparator_counterparts(methods: []parser::Function): null | error {
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator {
            var want = comparator_counterpart(methods[i].name)
            if want != "" && !func_list_has_name(operator_members(methods), want) {
                return op_diag(methods[i], $"defining `operator {methods[i].name}` requires its counterpart `operator {want}` (§9 ruling 5)")
            }
        }
        i++
    }
    null
}

/**
 * operator_members — the sublist of `methods` that are `operator` declarations (§9), so the
 * counterpart scan matches dunder names only against actual operators (never an ordinary method that
 * happens to share a dunder-like name).
 *
 * @param methods  the value-type body's members
 * @return         only the members carrying `is_operator`
 * @since §9
 */
fn operator_members(methods: []parser::Function): []parser::Function {
    var out: []parser::Function = teko::list::empty()
    var i = 0
    loop {
        if i >= methods.len { break }
        if methods[i].is_operator { out = teko::list::push(out, methods[i]) }
        i++
    }
    out
}

/**
 * check_operator_invariants — validate a type declaration's `operator` members at DEFINITION (§9
 * rulings 1–5, §6/§9.4). Per operator, on EVERY carrier (value-type, struct, class): `check_one_operator`
 * (name, arity, `self`, return type, index carrier). Only a VALUE-TYPE body additionally owns the
 * ruling-10 invariants: `check_value_type_self_readonly` (a transient readonly `self`) and the
 * DEFINITION-level counterpart obligation `check_comparator_counterparts` (D2 — a lone value-type must
 * write both sides of a comparison pair, since it cannot compose a mixin). A struct/class does NOT face
 * the definition-level counterpart obligation here: its counterpart may be flattened in from a trait
 * (e.g. `NeByEq`), and the obligation is discharged by interface conformance over the FLATTENED methods
 * (D1). Inert for a body with no operators, so the compiler's own corpus never triggers it (plan §8).
 *
 * @param td      the type declaration
 * @param ref_ns  the declaration's namespace (for return/backing resolution)
 * @param table   the folded type table
 * @return        null when every operator is well-formed, else the first located diagnostic
 * @throws        the first ruling violation among the type's operators
 * @since §9 (§6/§9.4 extends the well-formedness pass to struct/class)
 */
fn check_operator_invariants(td: parser::TypeDecl, ref_ns: str, table: TypeTable): null | error {
    var ops = type_body_operators(td.body)
    var i = 0
    loop {
        if i >= ops.len { break }
        match check_one_operator(td, ops[i], ref_ns, table) { error as e => return e; null => { } }
        i++
    }
    if is_value_type_body(td.body) {
        var vmethods = value_type_body_methods(td.body)
        match check_value_type_self_readonly(td, vmethods, table) { error as e => return e; null => { } }
        match check_comparator_counterparts(vmethods) { error as e => return e; null => { } }
    }
    null
}

/**
 * check_value_type_self_readonly — a subtype of a primitive/enum/flags carries a READONLY,
 * transient `self` (§13.2 ruling 8/10): its instance method may READ self but never WRITE it (the
 * value IS the primitive, materialized fresh on each call — a write cannot stick). Any value-type
 * instance method whose body mutates self is a DEFINITION error, the thin-side mirror of the
 * fat-struct rule (§13.2). Operators are excluded (they are static, every operand explicit). Inert on
 * today's corpus: it declares no value-type whose method writes self.
 *
 * @param td       the value-type declaration
 * @param methods  the value-type body's methods (already extracted by the caller)
 * @param table    the folded type table (for the transitive-call resolution)
 * @return         null when every instance method leaves self read-only, else the located diagnostic
 * @throws         the first value-type method that writes self
 * @since item-14
 */
fn check_value_type_self_readonly(td: parser::TypeDecl, methods: []parser::Function, table: TypeTable): null | error {
    var i = 0 to u64
    loop {
        if i >= methods.len { break }
        var m = methods[i]
        var is_instance = !m.is_operator && !m.is_static && m.params.len > 0 && !m.params[0].has_type
        if is_instance && method_mutates_self(td.name, m, table) {
            return error { message = $"cannot mutate `self` in method `{m.name}` of value-type `{td.name}` — a subtype of a primitive/enum/flags carries a readonly `self` (the value IS the primitive; §13.2)" }
        }
        i++
    }
    null
}

/**
 * (OOP A1, 2026-07-01) Type-check EVERY method body on a struct TypeDecl and stamp each into a full
 * `TFunction` item (namespace = "<owning-ns>::<StructName>", mirroring `collect_signatures`'
 * registration exactly, so codegen and the interpreter mangle and resolve method calls to these SAME items).
 *
 * Called from both `type_program` and `type_program_with_deps`' main loops, alongside the ordinary
 * TypeDecl pass-through — a struct with methods contributes MULTIPLE `TItem`s, not one.
 *
 * @param td       the struct or class declaration whose methods to type
 * @param item_ns  the declaration's own namespace
 * @param file     the declaration's source file (W-loc-2)
 * @param env      the sealed top-level environment
 * @param table    the collected type table
 * @return         one typed item per method body
 * @throws         when a method body fails to type
 */
fn type_struct_methods(td: parser::TypeDecl, item_ns: str, file: str, env: Env, table: TypeTable): []TItem | error {
    match check_operator_invariants(td, item_ns, table) { error as e => return e; null => { } }
    // (W10b.CLASS) a class's methods are typed/stamped by this SAME pass — only the methods
    // list's source differs; a class method is otherwise identical to a struct method. Increment
    // 2: stamps the EFFECTIVE (base-inherited + overridden) methods against THIS class's own
    // name — an inherited-not-overridden method's body is re-typed/re-emitted per owning class
    // (no vtable/dispatch yet). An `abstract fn` signature (no body, never overridden by THIS
    // class) has nothing to emit — skipped.
    var methods: []parser::Function = teko::list::empty()
    var base_name = ""
    var is_class = false
    var own_names: []str = teko::list::empty()   // (W10b.CLASS) methods declared DIRECTLY on td — `base` is only ever injected for these (see below)
    match td.body {
        parser::StructBody as sb => { methods = sb.methods }
        parser::ClassBody as cb => {
            methods = match effective_class_methods(cb, table) { []parser::Function as f => f; error as e => return e }
            base_name = cb.base_name
            is_class = true
            var oi = 0
            loop { if oi >= cb.methods.len { break }; own_names = teko::list::push(own_names, cb.methods[oi].name); oi++ }
        }
        parser::NewtypeBody as nb => { methods = nb.methods }
        parser::EnumBody as eb => { methods = eb.methods }
        parser::FlagsBody as fb => { methods = fb.methods }
        _ => { }
    }
    var out: []TItem = teko::list::empty()
    var method_ns = if item_ns == "" { td.name } else { item_ns ~ "::" ~ td.name }
    var mi = 0
    loop {
        if mi >= methods.len { break }
        if methods[mi].is_abstract { mi++; continue }
        // (§4 G) `base` is injected ONLY for a method DECLARED DIRECTLY on THIS class (own or an
        // override) — a PURELY inherited method (never touched by this class) keeps its ORIGINAL
        // declaring class's own context; re-typing it under a DIFFERENT derived class must NOT inject
        // a `base` its body never asked for. Gated on the class HAVING a base (base_name != "") — the
        // super path, decoupled from the retired named binding.
        var use_base = base_name != "" && str_set_has(own_names, methods[mi].name)
        // (W10b.CLASS residual — intern visibility) the ACCESSOR context for THIS method body's
        // OWN field/method accesses: the class that ORIGINALLY DECLARED it (itself, if own/an
        // override; the ancestor that declared it, if purely inherited) — NEVER td.name when the
        // two differ, for the exact same reason as the base-binding fix above.
        var declaring_class = if is_class {
            match find_method_owner(td.name, table, methods[mi].name) { MemberOwner as mo => mo.declaring_class; error => td.name }
        } else {
            td.name
        }
        var mf = match type_method(methods[mi], td.name, with_file(env, file), table, use_base, base_name, declaring_class) {
            TFunction as x => x
            error as e => return surface_at(file, methods[mi].line, methods[mi].col, e)
        }
        var mov = overload_suffix_for_method(env, method_ns, methods[mi], td.name, item_ns, table)
        var stamped = TFunction { overload_suffix = mov; name = mf.name; type_params = mf.type_params; type_constraints = mf.type_constraints; params = mf.params; return_type = mf.return_type; body = mf.body; vis = mf.vis; has_doc = mf.has_doc; doc = mf.doc; namespace = method_ns; file = file; line = methods[mi].line; col = methods[mi].col; is_test = mf.is_test; is_extern = mf.is_extern; c_symbol = mf.c_symbol; from_lib = mf.from_lib; has_arena_size = mf.has_arena_size; arena_size = mf.arena_size; ret_extra = mf.ret_extra }
        out = teko::list::push(out, stamped)
        mi++
    }
    out
}

/**
 * type_type_member_consts — HOIST a struct/class/trait's EFFECTIVE static member consts into
 * module-level `TConstDecl` items (#594 crumb 7), so the very same inliner + rodata machinery a
 * module const uses carries a member const too — the owning type is only the NAMESPACE of resolution
 * (no layout slot). Each is typed by `type_const_decl` (identical const-eval to a module const) and
 * emitted under its program-unique `member_const_symbol` name; a `TypeName::NAME` reference
 * (`find_member_const`) binds to that same name. A class contributes its inherited-not-shadowed base
 * consts too (mirroring how its inherited methods are re-emitted per owning class).
 *
 * @param td       the type declaration whose member consts are hoisted
 * @param item_ns  the type's declaring namespace (its canonical qualifier)
 * @param file     the type's source file (for located error surfacing)
 * @param env      the pass-2 environment (namespace-scoped to the type's module)
 * @param table    the program's type table
 * @return         one `TConstDecl` TItem per effective member const, or a located error
 * @throws         a type/const-expr error in a member const's initializer, surfaced at its position
 * @since #594
 */
fn type_type_member_consts(td: parser::TypeDecl, item_ns: str, file: str, env: Env, table: TypeTable): []TItem | error {
    var eff = match td.body {
        parser::ClassBody as cb => match effective_class_consts(cb, table) { []parser::ConstDecl as c => c; error as e => return e }
        parser::StructBody as sb => sb.consts
        parser::TraitBody as tb => tb.consts
        _ => teko::list::empty()
    }
    var type_canonical = qualify(item_ns, td.name)
    var out: []TItem = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= eff.len { break }
        var cd = eff[i]
        var ti = match type_const_decl(cd, with_file(env, file), table) { TConstDecl as x => x; error as e => return surface_at(file, cd.line, cd.col, e) }
        out = teko::list::push(out, TConstDecl { name = member_const_symbol(type_canonical, cd.name); namespace = item_ns; ty = ti.ty; init = ti.init; vis = ti.vis; has_doc = ti.has_doc; doc = ti.doc; line = cd.line; col = cd.col })
        i++
    }
    out
}

/**
 * type_const_decl — pass-2 typing for a module-level constant (#594 crumb 4): resolve the declared
 * type, type the initializer against it (adopting a fitting bare literal to the declared narrow
 * width exactly as `type_binding` does, so `const K: u8 = 300` reports an out-of-range error while
 * `const K: u8 = 1` narrows the leaf), then gate the checked initializer through `is_const_expr`
 * (the D1 grammar). The returned TConstDecl carries the checked initializer the inliner substitutes
 * at each use site; its `namespace` is seeded from `env.cur_ns` and re-stamped by `type_item` from
 * the item's provenance.
 *
 * @param cd     the parsed const declaration
 * @param env    the pass-2 environment (top-level names — including sibling consts — bound)
 * @param table  the program's type table
 * @return       the typed constant, or a located error on a type mismatch, an out-of-range literal,
 *               a `void`/element-less initializer, or a non-const initializer form
 * @throws       a type-mismatch error (expected the declared type, found the initializer's) when the
 *               initializer neither is assignable to nor adopts the declared type; the `is_const_expr`
 *               error naming the offending form when the initializer is not a legal const-expr
 * @since #594
 */
fn type_const_decl(cd: parser::ConstDecl, env: Env, table: TypeTable): TConstDecl | error {
    var at = match resolve_type(cd.ty, table, env.cur_ns) { Type as t => t; error as e => return e }
    var v = match type_value_expected(cd.init, at, env, table) { TExpr as te => te; error as e => return e }
    if type_is_void(v.type) { return error { message = "a const initializer cannot be a `void` expression — it yields no value (M.1)" } }
    if !assignable_to(v.type, at, table) {
        match annotated_literal_ok(cd.init, at) {
            null => v = retype_literal(v, at)
            error as e => return teko::error::err_typed(e, type_render(at), type_render(v.type))
        }
    }
    var at_is_sentinel_slice = match at { Slice as bs => match bs.element { Void => true; _ => false }; _ => false }
    if at_is_sentinel_slice {
        return error { message = "a const of an element-less slice type needs a concrete element (e.g. `const XS: []u8 = …`)" }
    }
    var v_is_sentinel_slice = match v.type { Slice as vs => match vs.element { Void => true; _ => false }; _ => false }
    if v_is_sentinel_slice { v = TExpr { kind = v.kind; type = at; line = v.line; col = v.col } }
    match is_const_expr(v, table, env) { error as e => return e; null => { } }
    TConstDecl { name = cd.name; namespace = env.cur_ns; ty = at; init = v; vis = cd.vis; has_doc = cd.has_doc; doc = cd.doc; line = cd.line; col = cd.col }
}

fn type_item(item: parser::Item, env: Env, table: TypeTable): TItem | error {
    // Stamp the item's source file onto the env, the twin of the `with_ns` the caller already
    // does. Only the checker's WARNING surface reads it: an error is positioned on the way out
    // by `surface_at`, which has the file in hand, but a warning is printed where it is found
    // and would otherwise name a line in no file at all (`scope.tks::Env.file`).
    var fenv = with_file(env, item.file)
    match item.content {
        parser::Function as f => {
            var tf = match type_function(f, fenv, table) { TFunction as x => x; error as e => return e }
            // (#49) stamp the declaring namespace from the parsed item so codegen mangles the C name.
            var ov = overload_suffix_for_decl(env, item.namespace, tf.name, tf, table)
            TFunction { overload_suffix = ov; name = tf.name; type_params = tf.type_params; type_constraints = tf.type_constraints; params = tf.params; return_type = tf.return_type; body = tf.body; vis = tf.vis; has_doc = tf.has_doc; doc = tf.doc; namespace = item.namespace; file = item.file; line = f.line; col = f.col; is_test = tf.is_test; is_extern = tf.is_extern; c_symbol = tf.c_symbol; from_lib = tf.from_lib; has_arena_size = tf.has_arena_size; arena_size = tf.arena_size; ret_extra = tf.ret_extra }
        }
        parser::TypeDecl as td => {
            // (#109 W3) CANONICALIZE the decl name to "ns::Name" so codegen emits a namespace-distinct
            // typedef (matching the canonical Named.name at every USE). A generic `__g__` instance keeps
            // its already-unique bare name. Resolution stays bare-keyed (this is the TYPED program only).
            var cd = if name_is_g_instance(td.name) { td } else {
                parser::TypeDecl { name = qualify(item.namespace, td.name); type_params = td.type_params; type_constraints = td.type_constraints; body = td.body; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col }
            }
            normalize_inst_decl(cd, table)   // (W9.4) rewrite `Gen<i64>` member refs to the bare stamped `Gen__g__i64` (no-op when none); else passes through (collect resolved its fields)
        }
        parser::UseDecl as ud => ud   // seed no-op (alias resolution is the checker's, later)
        parser::Statement as s => {
            var ts = match type_statement(s, fenv, table) { TypedStmt as x => x; error as e => return e }
            ts.node
        }
        parser::ConstDecl as cd => {
            var ti = match type_const_decl(cd, fenv, table) { TConstDecl as x => x; error as e => return e }
            TConstDecl { name = ti.name; namespace = item.namespace; ty = ti.ty; init = ti.init; vis = ti.vis; has_doc = ti.has_doc; doc = ti.doc; line = cd.line; col = cd.col }
        }
    }
}

// (C1.8/E2) surface an inner checker error at the program level — mirror of typer.c's surface_at.
// PREFER the inner error's own line/col over the item's (an inner-expr position wins — C1-POS),
// build the LOCATED message string (diag_at — file:line:col baked in, the fallback the driver
// prints when it can't read the file), then re-attach the STRUCTURED file/line/col (err_loc) and
// PRESERVE the inner error's expected/actual (err_typed) so a type mismatch still renders
// "expected X, found Y" after surfacing.
fn surface_at(file: str, item_line: u32, item_col: u32, inner: error): error {
    var el = if inner.line != 0 { inner.line } else { item_line }
    var ec = if inner.line != 0 { inner.col } else { item_col }
    var located = error { message = diag_at(file, el, ec, inner.message) }   // located string (fallback)
    var positioned = teko::error::err_loc(located, el, ec)   // structured position (renderer)
    teko::error::err_typed(positioned, inner.expected, inner.actual)   // preserve expected/actual (C1.8)
}

/**
 * A per-item progress hook, invoked `(done, total)` after each top-level item is
 * typed. Lets a caller (the `teko build` observability layer, `teko::build`) report
 * a live "N/M items" counter for the checker phase without the checker depending on
 * anything outside itself — the caller supplies the closure; the checker only ever
 * calls it.
 *
 * @param done   how many top-level items have been typed so far
 * @param total  the total top-level item count for this program
 */
pub type ProgressFn = action<u64, u64>

/**
 * `type_program_with_deps`'s result BEFORE monomorphization: the checked program
 * (still carrying its generic templates) plus the resolved `TypeTable`
 * `monomorphize` needs. Exposed so the build driver can time and report
 * monomorphization as its OWN phase, instead of it running silently inside
 * `type_program_with_deps`.
 */
pub type PreMono = struct {
    /** the checked program, before monomorphization */
    prog: TProgram
    /** the resolved type table, as `monomorphize` expects it */
    table: TypeTable
    /**
     * every DECLARATION-boundary type error collected while typing the item list, in item order
     * (empty when the program typed cleanly). An item that fails to type contributes its
     * diagnostic here and NO `TItem` — the walk continues with the next top-level declaration, so
     * one build reports every declaration's defect instead of stopping at the first (owner ruling
     * 2026-07-26). The caller must NOT proceed to monomorphization when this is non-empty: `prog`
     * is a PARTIAL program by construction.
     */
    diags: []str
}

/**
 * The no-op `ProgressFn` `type_program_with_deps` passes to
 * `type_program_with_deps_pre_mono` when its caller wants no per-item progress
 * reporting (the original, pre-observability contract).
 *
 * @param done   how many top-level items have been typed so far (ignored)
 * @param total  the total top-level item count (ignored)
 */
fn no_item_progress(done: u64, total: u64) { }

/**
 * The DEP-AWARE TYPED ENTRY POINT (C7.10). Same as `type_program` but pre-seeds the
 * collection environment from an already-typed dep `TProgram` before collecting and
 * typing the project, then MONOMORPHIZES the result (S4b) — a thin wrapper over
 * `type_program_with_deps_pre_mono` with no progress reporting, preserving this
 * function's original contract for its non-observability callers. The dep's items
 * are NOT re-typed; only their signatures enter scope so the project's code can
 * call dep functions and reference dep types. `dep_prog.items` is empty when there
 * are no deps -> degrades silently to `type_program`'s behavior.
 *
 * @param raw_program  the merged, un-typed program (project items only)
 * @param dep_prog     the already-typed dependency program (empty when depless)
 * @return             the fully checked and monomorphized program
 * @throws             the first collection/typing/monomorphization error
 */
pub fn type_program_with_deps(raw_program: parser::Program, dep_prog: TProgram): TProgram | error {
    var pre = match type_program_with_deps_pre_mono(raw_program, dep_prog, no_item_progress) { PreMono as p => p; error as e => return e }
    if pre.diags.len > 0 { return error { message = join_checker_diags(pre.diags) } }
    var mono = match monomorphize(pre.prog, pre.table) { TProgram as mp => mp; error as e => return e }
    inline_consts(mono)
}

/**
 * `type_program_with_deps`, split just BEFORE monomorphization (see `PreMono`) and
 * instrumented with a per-item progress hook (see `ProgressFn`) — the entry point
 * the build driver uses to report the `checker` phase's live "N/M items" counter
 * and time monomorphization as its own separate phase.
 *
 * @param raw_program  the merged, un-typed program (project items only)
 * @param dep_prog     the already-typed dependency program (empty when depless)
 * @param on_item      called `(done, total)` after each top-level item is typed
 * @return             the checked program (pre-monomorphization) and its type table
 * @throws             the first collection/typing error
 */
pub fn type_program_with_deps_pre_mono(raw_program: parser::Program, dep_prog: TProgram, on_item: ProgressFn): PreMono | error {
    // (TR0) FOLD trait derivations first — PROJECT-LOCAL only (a dep's traits don't fold here:
    // the .tkb codec does not carry trait bodies — the same method-serialization gap as
    // struct/class methods — so a dep trait name in an `&`-list surfaces as the conformance
    // check's honest "not an interface" error rather than a silent half-fold).
    var folded = fold_traits_collected(raw_program)
    if folded.diags.len > 0 { return PreMono { prog = TProgram { items = teko::list::empty() }; table = tt_empty(); diags = folded.diags } }
    var program = synthesize_mret_structs(canon_class_bases(folded.program))
    var seed_empty = Collected { types = tt_empty(); env = env_empty() }
    var seed = match seed_from_dep(dep_prog, seed_empty.types, seed_empty.env) {
        Collected as s => s
        error as e => return e
    }
    var pre = pre_walk(program, collect_with_seed(program, seed))
    if pre.cut { return PreMono { prog = TProgram { items = teko::list::empty() }; table = pre.types; diags = pre.diags } }
    var types = pre.types
    var cenv = pre.env
    var items: []TItem = teko::list::empty()
    var mainbody: []TStatement = teko::list::empty()
    var diags: []str = pre.diags
    var cur = cenv
    var i = 0
    loop {
        if i >= program.items.len { break }
        var it = program.items[i]
        // (#41) mirror typer.c (tk_type_program_with_deps line 689: `cur.cur_ns = it.namespace;`):
        // same fix as type_program — set cur_ns per item so a loose main.tks statement's unqualified
        // same-namespace call resolves. See type_program's comment for the full rationale.
        cur = with_ns(cur, it.namespace)
        var ienv = with_ns(cenv, it.namespace)
        var line: u32 = 0
        var col: u32 = 0
        match it.content {
            parser::Function as f => { line = f.line; col = f.col }
            parser::TypeDecl as td => { line = td.line; col = td.col }
            parser::ConstDecl as cd => { line = cd.line; col = cd.col }
            _ => { }
        }
        match it.content {
            parser::Statement as s => match top_level_stmt_nodes(s, with_file(cur, it.file), types) {
                TStmtSeq as seq => {
                    var si: u64 = 0
                    loop {
                        if si >= seq.stmts.len { break }
                        items = teko::list::push(items, seq.stmts[si])
                        mainbody = teko::list::push(mainbody, seq.stmts[si])
                        si = si + 1
                    }
                    cur = seq.env
                }
                error as e => { diags = teko::list::push(diags, located_diag(it.file, line, col, e)) }
            }
            _ => {
                match type_item(it, ienv, types) {
                    TItem as ti => {
                        items = teko::list::push(items, ti)
                        // (OOP A1) a struct TypeDecl also contributes its METHOD bodies as extra items.
                        match it.content {
                            parser::TypeDecl as td => {
                                match type_struct_methods(td, it.namespace, it.file, ienv, types) {
                                    []TItem as mitems => {
                                        var mi2 = 0
                                        loop { if mi2 >= mitems.len { break }; items = teko::list::push(items, mitems[mi2]); mi2++ }
                                    }
                                    error as e => { diags = teko::list::push(diags, located_diag(it.file, line, col, e)) }
                                }
                                match type_type_member_consts(td, it.namespace, it.file, ienv, types) {
                                    []TItem as citems => {
                                        var ci2 = 0
                                        loop { if ci2 >= citems.len { break }; items = teko::list::push(items, citems[ci2]); ci2++ }
                                    }
                                    error as e => { diags = teko::list::push(diags, located_diag(it.file, line, col, e)) }
                                }
                            }
                            _ => { }
                        }
                    }
                    error as e => { diags = teko::list::push(diags, located_diag(it.file, line, col, e)) }
                }
            }
        }
        i++
        on_item(i to u64, program.items.len)
    }
    var lc = check_labels(mainbody, teko::list::empty(), false, teko::list::empty())
    if lc.failed { diags = teko::list::push(diags, lc.message) }
    // For the result, prepend dep items so the TProgram contains the full program (dep + project).
    // This allows subsequent operations (codegen, interpreter, coverage) to see all items.
    var all_items: []TItem = teko::list::empty()
    var di: u64 = 0
    loop {
        if di >= dep_prog.items.len { break }
        all_items = teko::list::push(all_items, dep_prog.items[di])
        di++
    }
    var pi: u64 = 0
    loop {
        if pi >= items.len { break }
        all_items = teko::list::push(all_items, items[pi])
        pi++
    }
    var tp = TProgram { items = all_items }
    PreMono { prog = tp; table = types; diags = diags }
}

/**
 * The checker's PRE-WALK product: the state the declaration-boundary item walk runs against, plus
 * everything the six pre-walk passes had to say about the program.
 *
 * `cut` is the boundary verdict of docs/design/all-diagnostics-pre-walk-0.3.1.md §3 — true when a
 * HARD pass (the signature walk, the DI registry, the stamped-instance registration) left the state
 * it produces incomplete. The item walk must NOT run on a cut: it would type bodies against missing
 * bindings and blame every caller for its callee's defect.
 */
type PreWalk = struct {
    /** the fully stamped type table the item walk resolves against */
    types: TypeTable
    /** the sealed top-level environment the item walk types against */
    env: Env
    /** every pre-walk diagnostic, in pass order (source, then line, then column within a pass) */
    diags: []str
    /** did a HARD pass leave its produced state incomplete? */
    cut: bool
}

/**
 * Run the five pre-walk passes that follow collection and fold their diagnostics into ONE list, in
 * pass order — the all-diagnostics ruling applied to the checker's pre-walk (issue #68).
 *
 * SOFT passes (`check_modules`, the DI overlay check) produce nothing the item walk reads, so their
 * diagnostics travel WITH the item walk's and the build reports them together. HARD passes (the
 * signature walk inside `col`, the stamped-instance registration) produce state a
 * failure leaves incomplete, so each collects everything it can and then sets `cut`.
 *
 * @param program  the trait-folded, base-canonicalized program
 * @param col      the collection pass's outcome (its two diagnostic classes come in with it)
 * @return         the item walk's state, every pre-walk diagnostic, and the boundary verdict
 * @since 0.3.1
 */
fn pre_walk(program: parser::Program, col: CollectOutcome): PreWalk {
    var table = col.collected.types
    var module_diags = check_modules(program, table)
    var types = tt_freeze(instantiate_types(program, table))
    var insts = register_instance_methods(col.collected.env, types)
    var diags = concat_diags(col.decl_diags, col.sig_diags)
    diags = concat_diags(diags, module_diags)
    diags = concat_diags(diags, insts.diags)
    var cut = col.sig_diags.len > 0 || insts.diags.len > 0
    PreWalk { types = types; env = seal(insts.env); diags = diags; cut = cut }
}

// THE TYPED ENTRY POINT: pass 1 (collect top-level names) + pass 2 (type each item).
pub fn type_program(raw_program: parser::Program): TProgram | error {
    // (TR0) FOLD trait derivations FIRST — every later stage (collect, conformance, typing,
    // codegen layout, the interpreter) sees each deriver's already-folded body; a trait decl itself stays
    // registered (for honest value-position/instantiation errors) but is never emitted.
    var folded = fold_traits_collected(raw_program)
    if folded.diags.len > 0 { return diags_error(folded.diags) }
    var program = synthesize_mret_structs(canon_class_bases(folded.program))
    var pre = pre_walk(program, collect(program))
    if pre.diags.len > 0 { return diags_error(pre.diags) }
    var types = pre.types
    var cenv = pre.env
    var items: []TItem = teko::list::empty()
    var mainbody: []TStatement = teko::list::empty()   // the loose top-level statements (the virtual-main), for label validation
    var cur = cenv   // threaded virtual-main scope: each loose binding extends it for the next statement (mirrors typer.c's `cur`)
    var i = 0
    loop {
        if i >= program.items.len { break }
        var it = program.items[i]
        // (#41) mirror typer.c (tk_type_program line 749: `cur.cur_ns = it.namespace;`): set the
        // namespace being type-checked on the THREADED virtual-main scope BEFORE typing a loose
        // top-level statement, so an UNQUALIFIED same-namespace call from main.tks (e.g.
        // `use_counter(21)` resolving to a fn defined in another file of the same project) matches
        // via lookup_call's `b.ns == env.cur_ns` clause. Without this, loose statements were typed
        // with cur_ns="" (from env_empty) → cross-file top-level fns reported "unknown function".
        // with_ns preserves cur's accumulated bindings (prior loose `let`s stay visible).
        cur = with_ns(cur, it.namespace)
        var ienv = with_ns(cenv, it.namespace)   // (#41) resolve this item's calls in its namespace
        // W-loc-2: the item's source file + the decl's line:col, so a type error in the
        // flattened program resolves to file:line:col (loose statements carry no loc → file only).
        var line: u32 = 0
        var col: u32 = 0
        match it.content {
            parser::Function as f => { line = f.line; col = f.col }
            parser::TypeDecl as td => { line = td.line; col = td.col }
            parser::ConstDecl as cd => { line = cd.line; col = cd.col }
            _ => { }
        }
        // a loose top-level Statement is typed directly so its node also feeds the virtual-main's
        // label validation below (mirrors typer.c's separate `mainbody` accumulator).
        // (C1-POS/C1.8/E2) surface_at prefers the ERROR's own line/col over the item's (inner-expr
        // position wins), bakes file:line:col into the message (diag_at fallback), sets the STRUCTURED
        // file/line/col (err_loc) AND preserves expected/actual (err_typed) — mirror of typer.c's
        // surface_at. The error value now carries those adornments per the E2 contract.
        match it.content {
            parser::Statement as s => {
                var seq = match top_level_stmt_nodes(s, with_file(cur, it.file), types) {
                    TStmtSeq as x => x
                    error as e => return surface_at(it.file, line, col, e)
                }
                var si: u64 = 0
                loop {
                    if si >= seq.stmts.len { break }
                    items = teko::list::push(items, seq.stmts[si])
                    mainbody = teko::list::push(mainbody, seq.stmts[si])
                    si = si + 1
                }
                cur = seq.env
            }
            _ => {
                var ti = match type_item(it, ienv, types) {
                    TItem as x => x
                    error as e => return surface_at(it.file, line, col, e)
                }
                items = teko::list::push(items, ti)
                // (OOP A1) a struct TypeDecl also contributes its METHOD bodies as extra items.
                match it.content {
                    parser::TypeDecl as td => {
                        var mitems = match type_struct_methods(td, it.namespace, it.file, ienv, types) { []TItem as x => x; error as e => return e }
                        var mi2 = 0
                        loop { if mi2 >= mitems.len { break }; items = teko::list::push(items, mitems[mi2]); mi2++ }
                        var citems = match type_type_member_consts(td, it.namespace, it.file, ienv, types) { []TItem as x => x; error as e => return e }
                        var ci2 = 0
                        loop { if ci2 >= citems.len { break }; items = teko::list::push(items, citems[ci2]); ci2++ }
                    }
                    _ => { }
                }
            }
        }
        i++
    }
    var lc = check_labels(mainbody, teko::list::empty(), false, teko::list::empty())   // W5-cf-2: validate labels in the virtual-main
    if lc.failed { return error { message = lc.message } }
    var tp = TProgram { items = items }
    var mono = match monomorphize(tp, types) { TProgram as mp => mp; error as e => return e }
    inline_consts(mono)
}
