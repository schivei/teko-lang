use teko::list
use teko::parser

// src/checker/collect.tks  (namespace 'teko::checker') — pass 1 (forward refs).


/**
 * (TR3) Append every method of `extra` onto `methods` — the synthesized structural methods fold
 * AFTER the user-trait fold, so they see the ALREADY-folded field set (user-trait + base-chain
 * fields).
 *
 * @param methods the deriver's existing methods
 * @param extra   the synthesized methods to append
 * @return the combined method list
 */
fn append_methods(methods: []parser::Function, extra: []parser::Function) -> []parser::Function {
    mut out = methods
    mut i: u64 = 0
    loop { if i >= extra.len { break }; out = teko::list::push(out, extra[i]); i++ }
    out
}

/**
 * (TR3) The result of the user-trait fold pass: the rewritten items, the recorded derives, and the
 * diagnostics of the derivers whose fold failed.
 *
 * An item whose fold failed passes through UNFOLDED, so this list being non-empty means the item
 * set is structurally incomplete — a HARD boundary
 * (docs/design/all-diagnostics-pre-walk-0.3.1.md §3). The pass still walks every remaining item, so
 * one build names every deriver that cannot fold; the fold as a whole then cuts.
 */
type UserFoldResult = struct {
// the rewritten items, in program order (an unfoldable deriver passes through unchanged)
    items: []parser::Item
// the recorded (deriver, USER-trait) pairs, for the requirement check
    derives: []TraitDerive
// one located diagnostic per deriver whose fold failed, in program order
    diags: []str
}

/**
 * (TR3) The rewrite ONE item contributes to the user-trait fold: the item itself (folded when it
 * derives user traits, unchanged otherwise), the derive list extended with its recorded pairs, and
 * its fold diagnostic if the fold failed.
 */
type FoldedItem = struct {
// the item after the fold (unchanged when it derives nothing, or when its fold failed)
    item: parser::Item
// the derive list, extended with this item's recorded (deriver, trait) pairs
    derives: []TraitDerive
// this item's fold diagnostic, or an empty list
    diags: []str
}

/**
 * (TR3) PASS 1 — fold every USER trait's members into its deriver(s) and record each (deriver,
 * trait) pair for the requirement check. Structural derives are NOT touched here (their synthesis is
 * PASS 2, over the field set THIS pass produced). A non-deriving decl passes through unchanged.
 *
 * Derivers are independent of one another, so a deriver whose fold fails contributes its diagnostic
 * and passes through unfolded while the walk continues — one build names every unfoldable deriver.
 *
 * @param program  the parsed program
 * @param table    the pre-fold type table
 * @return         the rewritten items, the recorded user-trait derives, and every fold diagnostic
 */
fn fold_user_traits(program: parser::Program, table: TypeTable) -> UserFoldResult {
    mut items: []parser::Item = teko::list::empty()
    mut derives: []TraitDerive = teko::list::empty()
    mut diags: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= program.items.len { break }
        let folded = fold_one_item(program.items[i], table, derives)
        items = teko::list::push(items, folded.item)
        derives = folded.derives
        diags = concat_diags(diags, folded.diags)
        i++
    }
    UserFoldResult { items = items; derives = derives; diags = diags }
}

/**
 * The identity `FoldedItem` — an item that derives no user trait passes through untouched.
 *
 * @param it       the item to carry through unchanged
 * @param derives  the derive list to carry through unchanged
 * @return         that item and derive list, with no diagnostics
 * @since 0.3.1
 */
fn unfolded_item(it: parser::Item, derives: []TraitDerive) -> FoldedItem {
    FoldedItem { item = it; derives = derives; diags = teko::list::empty() }
}

/**
 * (TR3) The user-trait fold of ONE top-level item — a struct or class body may derive traits;
 * every other item passes through.
 *
 * @param it       the item to fold
 * @param table    the pre-fold type table
 * @param derives  the derive list so far
 * @return         the (possibly rewritten) item, the extended derive list, and any fold diagnostic
 * @since 0.3.1
 */
fn fold_one_item(it: parser::Item, table: TypeTable, derives: []TraitDerive) -> FoldedItem {
    let td = match it.content { parser::TypeDecl as t => t; _ => return unfolded_item(it, derives) }
    match td.body {
        parser::StructBody as sb => fold_struct_item(it, td, sb, table, derives)
        parser::ClassBody as cb => fold_class_item(it, td, cb, table, derives)
        _ => unfolded_item(it, derives)
    }
}

/**
 * (TR3) Fold a STRUCT's derived user traits into its body.
 *
 * @param it       the struct's item
 * @param td       the struct's declaration
 * @param sb       the struct body
 * @param table    the pre-fold type table
 * @param derives  the derive list so far
 * @return         the rewritten item, the extended derive list, and any fold diagnostic
 * @since 0.3.1
 */
fn fold_struct_item(it: parser::Item, td: parser::TypeDecl, sb: parser::StructBody, table: TypeTable, derives: []TraitDerive) -> FoldedItem {
    let split = split_trait_derives(sb.implements, table, it.namespace)
    if split.traits.len == 0 { return unfolded_item(it, derives) }
    let fm = match fold_trait_members(td.name, sb.fields, sb.methods, sb.consts, split.traits, table, false) {
        FoldedMembers as f => f
        error as e => return FoldedItem { item = it; derives = derives; diags = one_diag(located_diag(it.file, td.line, td.col, e)) }
    }
    let body = parser::StructBody { fields = fm.fields; methods = fm.methods; implements = sb.implements; consts = fm.consts }
    FoldedItem { item = item_with_body(it, td, body); derives = record_user_trait_derives(derives, td.name, split.traits); diags = teko::list::empty() }
}

/**
 * (TR3) Fold a CLASS's derived user traits into its body.
 *
 * @param it       the class's item
 * @param td       the class's declaration
 * @param cb       the class body
 * @param table    the pre-fold type table
 * @param derives  the derive list so far
 * @return         the rewritten item, the extended derive list, and any fold diagnostic
 * @since 0.3.1
 */
fn fold_class_item(it: parser::Item, td: parser::TypeDecl, cb: parser::ClassBody, table: TypeTable, derives: []TraitDerive) -> FoldedItem {
    let split = split_trait_derives(cb.implements, table, it.namespace)
    if split.traits.len == 0 { return unfolded_item(it, derives) }
    let fm = match fold_trait_members(td.name, cb.fields, cb.methods, cb.consts, split.traits, table, true) {
        FoldedMembers as f => f
        error as e => return FoldedItem { item = it; derives = derives; diags = one_diag(located_diag(it.file, td.line, td.col, e)) }
    }
    let body = parser::ClassBody { kind = cb.kind; has_base = cb.has_base; base_name = cb.base_name; has_base_binding = cb.has_base_binding; base_binding_name = cb.base_binding_name; implements = cb.implements; fields = fm.fields; methods = fm.methods; consts = fm.consts }
    FoldedItem { item = item_with_body(it, td, body); derives = record_user_trait_derives(derives, td.name, split.traits); diags = teko::list::empty() }
}

/**
 * The same item, carrying the same declaration with a REWRITTEN body — the one place the fold
 * rebuilds a `TypeDecl`, so the twenty-odd fields it copies are spelled once.
 *
 * @param it    the original item (its namespace and file are preserved)
 * @param td    the original declaration (every field but the body is preserved)
 * @param body  the rewritten body
 * @return      the rewritten item
 * @since 0.3.1
 */
fn item_with_body(it: parser::Item, td: parser::TypeDecl, body: parser::TypeBody) -> parser::Item {
    let decl = parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = body; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; di_kind = td.di_kind; has_di_key = td.has_di_key; di_key = td.di_key; is_unsafe = td.is_unsafe; must_free = td.must_free }
    parser::Item { content = decl; namespace = it.namespace; file = it.file }
}

/**
 * (TR3) Record a (deriver, trait) requirement pair per USER trait derived — structural names carry
 * no bodyless requirement (their contract is the synthesis itself), so they are NOT recorded.
 *
 * @param derives the accumulating derive list
 * @param td_name the deriver's own type name
 * @param traits  the USER-trait names this deriver derives
 * @return the extended derive list
 */
fn record_user_trait_derives(derives: []TraitDerive, td_name: str, traits: []str) -> []TraitDerive {
    mut out = derives
    mut si: u64 = 0
    loop { if si >= traits.len { break }; out = teko::list::push(out, TraitDerive { type_name = td_name; trait_name = traits[si] }); si++ }
    out
}

/**
 * (TR3) A copy of struct decl `td` with `extra` appended to its methods (the synthesized structural
 * methods folded onto the already-baked StructBody).
 *
 * @param td    the struct type declaration
 * @param sb    its struct body
 * @param extra the synthesized methods to append
 * @return the rewritten `TypeDecl`
 */
fn struct_with_methods(td: parser::TypeDecl, sb: parser::StructBody, extra: []parser::Function) -> parser::TypeDecl {
    parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = parser::StructBody { fields = sb.fields; methods = append_methods(sb.methods, extra); implements = sb.implements; consts = sb.consts }; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; di_kind = td.di_kind; has_di_key = td.has_di_key; di_key = td.di_key; is_unsafe = td.is_unsafe; must_free = td.must_free }
}

/**
 * (TR3) A copy of class decl `td` with `extra` appended to its methods — the class-body twin of
 * `struct_with_methods`.
 *
 * @param td    the class type declaration
 * @param cb    its class body
 * @param extra the synthesized methods to append
 * @return the rewritten `TypeDecl`
 */
fn class_with_methods(td: parser::TypeDecl, cb: parser::ClassBody, extra: []parser::Function) -> parser::TypeDecl {
    parser::TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = parser::ClassBody { kind = cb.kind; has_base = cb.has_base; base_name = cb.base_name; has_base_binding = cb.has_base_binding; base_binding_name = cb.base_binding_name; implements = cb.implements; fields = cb.fields; methods = append_methods(cb.methods, extra); consts = cb.consts }; vis = td.vis; has_doc = td.has_doc; doc = td.doc; line = td.line; col = td.col; di_kind = td.di_kind; has_di_key = td.has_di_key; di_key = td.di_key; is_unsafe = td.is_unsafe; must_free = td.must_free }
}

/**
 * (TR3) PASS 2 — synthesize each STRUCTURAL trait's method over ONE decl, reading the field view
 * from the USER-trait-FOLDED `folded_table` (so co-derived user-trait fields + a class's base chain
 * are all present). A decl that derives no structural trait passes through unchanged.
 *
 * @param it           the program item (rewritten if it derives a structural trait)
 * @param folded_table the user-trait-folded type table (the field-view source)
 * @return the item, possibly with synthesized methods folded in, or a located error
 * @throws when a synthesized field shape is unsupported or a nested field does not derive the trait
 */
fn synthesize_one_decl(it: parser::Item, folded_table: TypeTable) -> parser::Item | error {
    match it.content {
        parser::TypeDecl as td => match td.body {
            parser::StructBody as sb => {
                let split = split_trait_derives(sb.implements, folded_table, it.namespace)
                if split.structural.len == 0 { return it }
                let fv = match deriver_field_view(td.name, folded_table) { []FieldView as v => v; error as e => return e }
                let synth = match synthesize_structural_methods(td.name, fv, split.structural, method_name_set(sb.methods), folded_table) { []parser::Function as m => m; error as e => return e }
                parser::Item { content = struct_with_methods(td, sb, synth); namespace = it.namespace; file = it.file }
            }
            parser::ClassBody as cb => {
                let split = split_trait_derives(cb.implements, folded_table, it.namespace)
                if split.structural.len == 0 { return it }
                let fv = match deriver_field_view(td.name, folded_table) { []FieldView as v => v; error as e => return e }
                let synth = match synthesize_structural_methods(td.name, fv, split.structural, method_name_set(cb.methods), folded_table) { []parser::Function as m => m; error as e => return e }
                parser::Item { content = class_with_methods(td, cb, synth); namespace = it.namespace; file = it.file }
            }
            _ => it
        }
        _ => it
    }
}
