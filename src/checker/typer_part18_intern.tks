use teko::list
use teko::parser

// src/checker/typer.tks  (namespace 'teko::checker')
// Each check_* (E4/E5) EVOLVES into a type_*: the SAME checks (B.22 regimes, B.20
// `if`, B.15 `match` + exhaustiveness), but the producer BUILDS the typed node
// instead of returning a bare Type. Predicates (is_bool/is_integer/op_is_*),
// resolvers (resolve_type), env (lookup/define) and the pattern + exhaustiveness
// logic (check_pattern/exhaustive) are reused from their stages — re-derivation,
// not duplication (M.5). C1: every node, statement and item re-derived.


/**
 * Types a `ref` binding's initializer against the annotated Reference target (owner ruling
 * 2026-07-24): `ref r: T = x` REQUIRES `x` to be a mutable variable (aliased, write-through — R7)
 * or another already-Reference-typed expression (forwarded plainly). There is no third case — a
 * fresh value/expression cannot become a `ref` binding's source (no expression-position `ref x`
 * exists to spell it, and no silent copy-fallback: an honest error names the real fix). The typed
 * value keeps its BARE (unwrapped) type on the mutable-var path — codegen's `emit_as_r` detects the
 * `Reference`-expected / non-`Reference`-value mismatch and emits the `&` itself, mirroring
 * `type_call`'s call-argument auto-ref.
 *
 * BOTH paths check the referent. The forwarding path used to return the source reference the moment
 * its type was a `Reference`, BEFORE the `type_eq` below, so `ref q: Big = p` with `p: ref i64`
 * type-checked and then wrote through a `Big`-shaped view of an `i64` cell — a memory-safety hole
 * from a re-annotation the checker never compared. A forward now requires `type_eq(src.inner,
 * rf.inner)`: the alias may be re-spelled, never re-typed.
 *
 * @param bv     the binding's value expression
 * @param rf     the annotated `Reference` target
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed initializer (bare-typed on the alias path, `Reference`-typed on the
 *               forwarding path)
 * @throws       when the source is neither a mutable variable nor an already-`Reference` value, or
 *               when a forwarded reference names a DIFFERENT referent type than the annotation
 */
fn type_ref_binding_value(bv: parser::Expr, rf: Reference, env: Env, table: TypeTable) -> TExpr | error {
    let v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type {
        Reference as src => {
            if !type_eq(src.inner, rf.inner) {
                return teko::error::err_typed(error { message = "a forwarded `ref` binding must name the SAME referent type as the reference it aliases" }, type_render(rf.inner), type_render(src.inner))
            }
            return v
        }
        _ => { }
    }
    if !type_eq(v.type, rf.inner) {
        return teko::error::err_typed(error { message = "a `ref` binding's source must be the referent's own type (or another reference)" }, type_render(rf.inner), type_render(v.type))
    }
    ref_source_mutable_var(bv, v, env)
}

/**
 * ref_source_mutable_var — the ALIAS-path source rule, shared by the annotated (`ref r: T = c`) and
 * the inferred (`ref r = c`) reference binding: the source must be a bare variable whose binding is
 * writable. A `ref` aliases an existing cell, so a temporary or an immutable `let` has no cell to
 * write through and the honest stop names the real fix rather than degrading into a copy.
 *
 * @param bv   the binding's source expression, untyped (the only place a bare `Var` is still visible)
 * @param v    the same expression already typed (returned unchanged when the rule holds)
 * @param env  the typing environment, consulted for the source binding's writability
 * @return     `v` unchanged
 * @throws     when the source is not a bare variable, is unbound, or names a non-writable binding
 * @since      0.3.1
 */
fn ref_source_mutable_var(bv: parser::Expr, v: TExpr, env: Env) -> TExpr | error {
    let var = match bv.kind { parser::Var as x => x; _ => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference — not an expression" } }
    let vb = match lookup_binding(env, var.name) { ValBinding as b => b; error => return error { message = "a `ref` binding's source must be a mutable variable (a `var`) or another reference" } }
    if vb.is_mut { return v }
    error { message = $"cannot take a reference to immutable `{var.name}` — a `ref` binding needs a mutable source (a `var`) or another reference" }
}

/**
 * type_inferred_ref_value — type the source of an UN-ANNOTATED reference binding `ref r = c`, whose
 * referent type is inferred from the source instead of read off a `Ref<>`-wrapped annotation (owner
 * ruling 2026-07-30). Same two cases as the annotated path and no third one: an already-`Reference`
 * value forwards unchanged, any other value must be a writable variable and keeps its BARE type on
 * the alias path (codegen's `emit_as_r` sees the `Reference`-expected / bare-value mismatch and
 * emits the `&`). There is deliberately NO copy fallback — the silent copy this replaces compiled
 * `ref r = c` into an ordinary `mut` snapshot and let every later write to `c` go unseen by `r`.
 *
 * @param bv     the binding's source expression
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed source (bare-typed on the alias path, `Reference`-typed when forwarding)
 * @throws       when the source is neither a writable variable nor an already-`Reference` value
 * @since        0.3.1
 */
fn type_inferred_ref_value(bv: parser::Expr, env: Env, table: TypeTable) -> TExpr | error {
    let v = match type_expr(bv, env, table) { TExpr as te => te; error as e => return e }
    match v.type { Reference => return v; _ => { } }
    ref_source_mutable_var(bv, v, env)
}

/**
 * ref_bound_of — the BOUND type of a reference binding whose referent type came from the source
 * rather than an annotation: a forwarded reference keeps its own `Reference` type (a reference to a
 * reference is not a thing the surface can spell), any other referent type `T` binds as `Ref<T>`.
 *
 * @param t  the typed source's type
 * @return   `t` when it is already a `Reference`, else `Reference { inner = t }`
 * @since    0.3.1
 */
fn ref_bound_of(t: Type) -> Type {
    match t { Reference => t; _ => Reference { inner = t } }
}

/**
 * Types a binding's value with the annotation as its expected type (so a generic constructor
 * targets the concrete instance from `: Box<i64>`) — or, when the binder was `ref`, routes through
 * the mutable-source/forwarding rule instead of the ordinary widening/literal-adoption path
 * (0.3.1 — owner rulings 2026-07-24 and 2026-07-30). The reference-ness is read from `b.is_ref`,
 * the binder's own identity axis, so an UN-annotated `ref r = c` takes the same rule as `ref r: T =
 * c` instead of falling through to the plain-value path that used to copy it.
 *
 * @param b      the binding whose value is typed
 * @param env    the typing environment
 * @param table  the resolved type table
 * @return       the typed initializer
 * @throws       when a `ref` binder's source breaks the mutable-source/forwarding rule
 */
fn type_binding_value(b: parser::Binding, env: Env, table: TypeTable) -> TExpr | error {
    if b.is_ref && !b.has_type { return type_inferred_ref_value(b.value, env, table) }
    if b.has_type {
        let at = match resolve_type(b.type_ann, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the binding's enclosing namespace
        match at { Reference as rf => return type_ref_binding_value(b.value, rf, env, table); _ => { } }
        return type_value_expected(b.value, at, env, table)
    }
    type_expr(b.value, env, table)
}

//
// Type-checks a `let`/`mut`/`const` binding statement, producing its typed `TBinding` node and
// the environment extended with the newly bound name (a `SimpleName` target; a
// `DestructurePattern` target is left as a refinement — the environment is returned unchanged). A
// `ref` binding (`at` resolves to `Reference`, owner ruling 2026-07-24) skips the ordinary
// widening/literal-adopt check entirely — `type_binding_value` (via `type_ref_binding_value`)
// already validated the mutable-source/forwarding rule and typed `v` accordingly (bare on the
// alias path, since a bare-typed alias value is never "assignable to" its own `Reference`
// wrapper); `bound` is always set to the annotation `at` when one is given, unconditionally. A
// top-level `Reference` bound type is legal ONLY on a genuine `ref` binding (`BindKind::Mut`,
// `parse_ref_binding`'s desugar) — a `let`/`const` binding can never carry one (deep immutability
// is the whole point of `let`; the tripartite law: `let` protects, `mut` unlocks, `ref` aliases).
//
// @param parser::Binding b  the parsed binding (target, optional annotation, initializer)
// @param Env env  the typing environment (read for `env.fn_unsafe`, U2's local-containment gate)
// @param TypeTable table  the program's type table
// @return TypedStmt | error  the typed statement plus the environment with the new binding defined
// collection, a reference is bound to a local (R5), or (U2, §2 line 84) a SAFE
// fn body binds a local of unsafe type (not as a param, return, field, OR local) —
// `env.fn_unsafe` was set once by `type_function`/`type_method` before this body's
// statements were typed
//
/**
 * bind_value_into_annotation — the `let x: T = value` rung ladder for a value that does not already
 * widen into its annotation `T`, in order: the struct/interface honest-stop that names a nominal
 * mismatch precisely → the implicit numeric widening (`widen_value_into` — a narrower same-family
 * value, or a machine integer into `bigint`/`dec`) → a fitting bare LITERAL adopting the declared
 * narrow type (`annotated_literal_ok` proves the fit against the RAW initializer, then
 * `retype_literal` rewrites the leaf so codegen sees the declared width, recursing into an array
 * literal's elements) → the honest stop annotated with expected and actual.
 *
 * Separate from `coerce_value_into` on purpose, and not a twin of it: this rung ladder proves a
 * literal's fit against the UNTYPED source expression (`raw`), which is the only place a negative
 * literal's sign and an array literal's element-wise fit are still visible. Both ladders put the
 * implicit widening at the same rung — after admissibility, before literal adoption — so an
 * annotated binding and an assignment cannot disagree about a widening they both now accept.
 *
 * @param v      the typed initializer
 * @param raw    the initializer's untyped source expression (the literal-fit proof reads this)
 * @param ann    the resolved annotation type
 * @param table  the folded type table
 * @return       the initializer as a value of `ann`
 * @throws       the nominal-mismatch stop, or the annotation mismatch with expected/actual attached
 * @since        0.3.1
 */
fn bind_value_into_annotation(v: TExpr, raw: parser::Expr, ann: Type, table: TypeTable) -> TExpr | error {
    match struct_iface_named_stop(v.type, ann, table) { error as se => return se; null => { } }
    match widen_value_into(v, ann) { TExpr as w => return w; null => { } }
    match annotated_literal_ok(raw, ann) {
        null => retype_literal(v, ann)
        error as e => teko::error::err_typed(e, type_render(ann), type_render(v.type))
    }
}

fn type_binding(b: parser::Binding, env: Env, table: TypeTable) -> TypedStmt | error {
    mut v = match type_binding_value(b, env, table) { TExpr as te => te; error as e => return e }
    mut bound = if b.is_ref && !b.has_type { ref_bound_of(v.type) } else { v.type }
    if type_is_void(bound) { return error { message = "cannot bind a `void` expression — it yields no value (M.1)" } }
    if b.has_type {
        let at = match resolve_type(b.type_ann, table, env.cur_ns) { Type as t => t; error as e => return e }   // (#109 W1) ref_ns = the binding's enclosing namespace
        let is_ref_binding = match at { Reference => true; _ => false }
        if !is_ref_binding && !assignable_to(v.type, at, table) {
            v = match bind_value_into_annotation(v, b.value, at, table) { TExpr as x => x; error as e => return e }
        }
        bound = at
        v = adopt_sentinel_slice_type(v, bound)
    }
    // (#4) REJECT an untyped empty collection. The element type MUST be fixed at the declaration —
    // by the binding annotation (`: []T`) or by typed initial elements (a non-empty literal / a
    // push that fixes the element). A bare `empty()`/`[]` whose element is still the sentinel is an
    // error: no silent element-less slice, no codegen back-inference (collections ruling #4).
    let bound_is_sentinel_slice = match bound { Slice as bs2 => match bs2.element { Void => true; _ => false }; _ => false }
    if bound_is_sentinel_slice {
        return error { message = "an empty list needs a known element type; annotate the binding (e.g. `mut xs: []i32 = teko::list::empty()`)" }
    }
    match bound {
        Reference => if b.kind != parser::BindKind::Mut { return error { message = "`let`/`const` cannot bind a reference — a reference binding is spelled `ref r: T = x` (write-through, requires a mutable source)" } }
        _ => if type_contains_ref(bound) && !is_ref_null_variant(bound) { return error { message = "a reference cannot be bound to a local (parameter-only in this version)" } }
    }
    if !env.fn_unsafe && unsafe_carrying(bound, table) {
        return error { message = "safe fn binds a local of unsafe type — mark the enclosing fn `unsafe fn` or bind only safe types (§2: unsafe data cannot be held by a safe local)" }
    }
    let node = TBinding { kind = b.kind; target = b.target; bound = bound; value = v; di_kind = b.di_kind }
    match b.target {
        parser::SimpleName as sn => TypedStmt { node = node; env = define(env, sn.name, bound, bind_is_mut(b.kind)) }
        parser::DestructurePattern => TypedStmt { node = node; env = env }   // [destructuring binding: refinement]
    }
}

// (#88) the ROOT variable of a field-access lvalue chain (`a.b.c` → `a`). `reachable` is true when the
// whole chain roots at a plain variable (not an index / call / literal), so it has a binding to check
// for mutability. Mirrors typer.c::lvalue_root.
type LvalueRoot = struct { reachable: bool; name: str }
fn lvalue_root(e: parser::Expr) -> LvalueRoot {
    match e.kind {
        parser::Var as v => LvalueRoot { reachable = true; name = v.name }
        parser::FieldAccess as fa => lvalue_root(fa.receiver)
        _ => LvalueRoot { reachable = false; name = "" }
    }
}

/**
 * field_write_root_writable — the DIRECT-field-write guard: `recv.field = v` is admitted only when
 * the ROOT variable of the receiver chain is a writable binding. It walks `a.b.c` to `a`, so the
 * protection holds at EVERY depth, not just the first field.
 *
 * `let` forbids a direct write, full stop — for a CLASS exactly as for a struct (owner ruling
 * 2026-07-30: `let` protects fields at every level, like a C# `{ public get; private set; }`).
 * Until that ruling a class receiver skipped this guard entirely, on the reasoning that a class is
 * a reference type and mutation flows through the handle; the effect was that `let` bit structs and
 * was transparent to classes — half the type system ignoring the mode. Writing remains the
 * privilege of the declaring type's own methods, which reach their fields through the RECEIVER
 * binder — the receiver is the object AS a reference, so it is defined writable
 * (`is_method_receiver`) and `self.name = n` stays legal, which is the `private set` half of the
 * analogy.
 *
 * @param receiver  the untyped receiver expression of the field-access LHS
 * @param env       the typing environment, consulted for the root binding's writability
 * @return          null when the write is admitted
 * @throws          when the receiver roots at a temporary, at an unbound name, or at a binding that
 *                  is neither `mut` nor a `ref`
 * @since           0.3.1
 */
fn field_write_root_writable(receiver: parser::Expr, env: Env) -> error | null {
    let root = lvalue_root(receiver)
    if !root.reachable { return error { message = "cannot assign to a field of a temporary value — the receiver is not a mutable variable" } }
    let rb = match lookup_binding(env, root.name) { ValBinding as vb => vb; error as e => return e }
    if rb.is_mut { return null }
    error { message = $"cannot assign to a field of immutable `{root.name}` — declare it `mut`, or let the declaring type's own method write it (`let` protects fields at every level; there is no `ref mut`) (B.21)" }
}
