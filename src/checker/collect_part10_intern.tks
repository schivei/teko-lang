use teko::parser

// src/checker/collect.tks  (namespace 'teko::checker') — pass 1 (forward refs).


/**
 * (TR0) The class dispatch markers are outside a trait's unit — an honest error, not silent
 * acceptance: a bodyless trait method already IS the requirement, and a deriver-defined method IS
 * the override, so `abstract`/`virtual`/`override`/`intern` have nothing to mean here.
 *
 * @param reg      the trait's registration
 * @param methods  the trait's methods, in declaration order
 * @return         one diagnostic per offending method
 */
fn trait_method_modifier_diags(reg: TypeReg, methods: []parser::Function) -> []str {
    mut diags: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= methods.len { break }
        let m = methods[i]
        if m.is_abstract || m.is_virtual || m.is_override || m.is_intern {
            diags = teko::list::push(diags, decl_diag(reg, $"trait method '{m.name}' may not be `abstract`/`virtual`/`override`/`intern` — a bodyless trait method is the requirement, and a deriver-defined method is the override (TR0)"))
        }
        i++
    }
    diags
}

/**
 * An interface body's diagnostics: every own method must be a bodyless signature, and the
 * EFFECTIVE method set (own + inherited) must be free of same-name/different-signature conflicts.
 * Resolving the effective set also proves each `extends` name IS an interface and that the
 * extension graph has no cycle.
 *
 * @param reg    the interface's registration
 * @param ib     the interface body
 * @param table  the whole collected type table
 * @return       the body's diagnostics, in declaration order
 */
fn validate_interface_body(reg: TypeReg, ib: parser::InterfaceBody, table: TypeTable) -> []str {
    let diags = interface_bodyless_diags(reg, ib.methods)
    let seen = teko::list::push(teko::list::empty(), qualify(reg.namespace, name_last_segment(reg.decl.name)))
    let eff = match effective_interface_methods(ib, reg.namespace, table, seen) {
        []parser::Function as m => m
        error as e => return concat_diags(diags, one_diag(decl_error_diag(reg, e)))
    }
    concat_diags(diags, interface_conflict_diags(reg, eff, table))
}

/**
 * (W10b.IF) An interface's OWN methods must be BODYLESS signatures — an interface is a pure
 * contract, and default method bodies are prohibited by the design.
 *
 * @param reg      the interface's registration
 * @param methods  the interface's own methods, in declaration order
 * @return         one diagnostic per method that carries a body
 */
fn interface_bodyless_diags(reg: TypeReg, methods: []parser::Function) -> []str {
    mut diags: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= methods.len { break }
        if methods[i].body.len > 0 {
            diags = teko::list::push(diags, decl_diag(reg, $"interface method '{methods[i].name}' must be a bodyless signature (an interface is a pure contract — no default bodies)"))
        }
        i++
    }
    diags
}

/**
 * No two EFFECTIVE methods (own + inherited) may share a name with a DIFFERENT signature — a
 * redeclaration conflict, caught HERE (at the interface) with a clear message rather than later,
 * confusingly, at an implementer. Same name + same signature is legal: it is one method.
 *
 * @param reg    the interface's registration
 * @param eff    the interface's effective method set
 * @param table  the whole collected type table (for signature comparison)
 * @return       one diagnostic per conflicting pair
 */
fn interface_conflict_diags(reg: TypeReg, eff: []parser::Function, table: TypeTable) -> []str {
    mut diags: []str = teko::list::empty()
    let owner_ns = type_ns_of(table, reg.decl.name)
    mut a: u64 = 0
    loop {
        if a >= eff.len { break }
        mut b: u64 = a + 1
        loop {
            if b >= eff.len { break }
            if eff[a].name == eff[b].name && !method_sig_matches(eff[a], eff[b], table, owner_ns) {
                diags = teko::list::push(diags, decl_diag(reg, $"interface '{reg.decl.name}' has conflicting signatures for method '{eff[a].name}' (an extended interface declares it differently)"))
            }
            b++
        }
        a++
    }
    diags
}

/**
 * The COLLECTION pass's product: the collected (table, env) plus its diagnostics, split by cut
 * boundary (docs/design/all-diagnostics-pre-walk-0.3.1.md §3).
 *
 * The split matters because the two halves of collection differ in what a failure poisons.
 * `validate_type_decls` is a pure validator over an already-built table, so the table the next
 * pass reads is complete either way — SOFT, the build carries on. The signature walk DEFINES
 * bindings, so a rejected signature leaves a hole a later call would be blamed for — HARD, the
 * build cuts at this pass's boundary.
 */
type CollectOutcome = struct {
// the collected type table and top-level environment
    collected: Collected
// SOFT — the declaration-gate diagnostics; the table is complete regardless
    decl_diags: []str
// HARD — the signature diagnostics; every one of them left a binding undefined
    sig_diags: []str
}

/**
 * Pass 1: types first, then function signatures — the top-level environment.
 *
 * (U2 #333 F1) Generic instances are STAMPED here, BEFORE field/signature validation, not
 * after `collect()` returns — `validate_type_decls`/`func_type`/`method_func_type` resolve a
 * written `Box<Raw>` to `Named{"Box__g__Raw"}` and probe the TABLE for that name's
 * `is_unsafe`; if the stamp doesn't exist yet the probe misses and the unsafe-carrying gate
 * silently passes. `instantiate_types` is idempotent (it dedups already-stamped names), so
 * calling it here and again later (`type_program`'s post-collect stamp, kept for callers
 * that only need the table, e.g. mono) is a safe no-op the second time.
 *
 * @param program  the parsed (trait-folded, base-canonicalized) program
 * @return         the collected type table + top-level environment, and both diagnostic classes
 */
fn collect(program: parser::Program) -> CollectOutcome {
    collect_over(program, instantiate_types(program, collect_types(program.items)), env_empty())
}

/**
 * collect_with_seed — C7.10: collect with a pre-seeded (table, env). Adds the project's type decls
 * on top of the seeded table, then adds the project's function signatures AND module-level const
 * bindings on top of the seeded env (#594 crumb 8b) — without the const arm, a project's own
 * `const` was never bound into `env` when a dep was present (the dep-seeded `env` only carried the
 * dep's EXPORTED consts via `seed_dep_consts`), so a bare reference always resolved to a same-name
 * dep const even when the project declared its own. Used by `type_program_with_deps` to inject dep
 * items before type-checking the project.
 *
 * (U2 #333 F1) Same early-stamp ordering as `collect()` — `instantiate_types` runs BEFORE
 * `validate_type_decls`/`func_type` so a project-written `Box<Raw>` (dep or project generic)
 * is already stamped, and its unsafe-carrying is visible to the field/signature gates.
 *
 * @param program  the project's parsed program (dep items are NOT re-typed, only seeded)
 * @param seed     the dep-derived (table, env) to extend
 * @return         the collected table + environment layered on the seed, and both diagnostic classes
 * @since #594
 */
fn collect_with_seed(program: parser::Program, seed: Collected) -> CollectOutcome {
    collect_over(program, instantiate_types(program, table_with_project_types(program, seed.types)), seed.env)
}

/**
 * The seeded table augmented with the project's own type declarations (dep types are already in
 * the seed).
 *
 * @param program  the project's parsed program
 * @param seeded   the dep-derived table to extend
 * @return         the table with one registration per project type declaration appended
 * @since 0.3.1
 */
fn table_with_project_types(program: parser::Program, seeded: TypeTable) -> TypeTable {
    mut table = seeded
    mut i = 0
    loop {
        if i >= program.items.len { break }
        match program.items[i].content {
            parser::TypeDecl as td => {
                table = teko::list::push(table, TypeReg { name = td.name; namespace = program.items[i].namespace; file = program.items[i].file; vis = td.vis; decl = td })
            }
            _ => { }
        }
        i++
    }
    table
}

/**
 * The shared body of both collection entry points: gate the declarations (MEM Step 0, R4), then
 * register every signature on top of `env0`. Depless and dep-seeded collection differ ONLY in the
 * table and environment they start from, so they share this walk verbatim.
 *
 * @param program  the parsed program whose items carry the signatures
 * @param table    the fully stamped type table to validate and resolve against
 * @param env0     the environment to grow (empty for a depless project, the dep's for a seeded one)
 * @return         the collected (table, env) and both diagnostic classes
 * @since 0.3.1
 */
fn collect_over(program: parser::Program, table: TypeTable, env0: Env) -> CollectOutcome {
    let decl_diags = validate_type_decls(table)
    let sig = collect_signatures(program.items, table, env0)
    CollectOutcome { collected = Collected { types = table; env = sig.env }; decl_diags = decl_diags; sig_diags = sig.diags }
}


// C7.10 — pre-seed the collection environment from an already-typed dep TProgram.
// Adds the dep's type declarations to `table` and the dep's function signatures to `env`.
// This gives the project's type_program access to dep types and functions without re-typing
// the dep's bodies (which are already verified). The dep's namespace is preserved on each entry.
fn seed_from_dep(dep: TProgram, table: TypeTable, env: Env) -> Collected | error {
    mut t = table
    mut e = env
    // Pass 1: register type declarations (so function param types can resolve against them).
    mut i: u64 = 0
    loop {
        if i >= dep.items.len { break }
        match dep.items[i] {
            parser::TypeDecl as td => {
                // Carry the dep item's namespace (the dep's own module path — already set when packed).
                // find_ns_of_titem extracts it from the dep's TItem.
                let ns = dep_item_ns(dep.items[i])
                t = teko::list::push(t, TypeReg { name = td.name; namespace = ns; file = ""; vis = td.vis; decl = td })
            }
            _ => { }
        }
        i++
    }
    // Pass 2: register function signatures using the now-complete type table.
    mut j: u64 = 0
    loop {
        if j >= dep.items.len { break }
        match dep.items[j] {
            TFunction as f => {
                let dtbl = type_param_table(f.type_params, f.type_constraints, "", t)
                mut params: []Type = teko::list::empty()
                mut param_names: []str = teko::list::empty()
                mut defaults: []parser::Expr = teko::list::empty()
                mut n_required: u64 = f.params.len   // DEFARGS (2026-07-01) — see func_type
                mut pi: u64 = 0
                loop {
                    if pi >= f.params.len { break }
                    let pt = match resolve_type(f.params[pi].type_ann, dtbl, f.namespace) { Type as ty => ty; error as err => return err }   // (#109 W1) ref_ns = the dep fn's declaring namespace
                    params = teko::list::push(params, pt)
                    param_names = teko::list::push(param_names, f.params[pi].name)
                    if f.params[pi].has_default {
                        if n_required == f.params.len { n_required = pi }
                        defaults = teko::list::push(defaults, f.params[pi].default_expr)
                    }
                    pi++
                }
                let is_variadic = f.params.len > 0 && f.params[f.params.len - 1].is_params
                let ft = Func { params = params; ret = f.return_type; variadic = is_variadic; param_names = param_names; n_required = n_required; defaults = defaults }
                e = define_fn(e, f.name, ft, f.namespace)
            }
            _ => { }
        }
        j++
    }
    Collected { types = t; env = seed_dep_consts(e, dep) }
}
