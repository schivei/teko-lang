use teko::parser

/**
 * cf_str_value — true iff `e` is a foldable const STRING the fold reduces to its bytes (CF4c/CF4d): an
 * in-tree `TStrLit`, or a `TVar` naming a module const string recorded in `agg`. A local string binding
 * (not propagated by `propagate_locals`), a runtime string, or a fn-value is not foldable.
 *
 * @param e    the receiver expression to classify
 * @param agg  the module-aggregate resolution table
 * @return     whether `e` is a foldable const string
 * @since #comptime-fold
 */
fn cf_str_value(e: TExpr, agg: AggConstMap) -> bool {
    match e.kind {
        TStrLit => true
        TVar as v => cf_var_is_agg_const(v, agg)
        _ => false
    }
}

/**
 * cf_var_is_agg_const — true iff `v` is a non-function reference naming a module aggregate const
 * recorded in `agg`. A fn-value (`is_func`) is never a const aggregate; a name absent from `agg` (a
 * local, a scalar const, a different-module name) is not foldable.
 *
 * @param v    the reference node
 * @param agg  the module-aggregate resolution table
 * @return     whether `v` resolves to a module aggregate const
 * @since #comptime-fold
 */
fn cf_var_is_agg_const(v: TVar, agg: AggConstMap) -> bool {
    if v.is_func { return false }
    match agg_const_init(agg, v.name, v.func_ns) {
        null => false
        TExpr => true
    }
}

/**
 * cf_array_elems_const — true iff every element of the array literal `a` is a foldable const (a
 * `cf_int_value` scalar or a nested `cf_agg_value`) and none is a spread. Any runtime or spread
 * element makes the whole aggregate non-const, so the index stays runtime.
 *
 * @param a    the typed array literal
 * @param agg  the module-aggregate resolution table (for a nested aggregate element)
 * @return     whether every element is a foldable const
 * @since #comptime-fold
 */
fn cf_array_elems_const(a: TArrayLit, agg: AggConstMap) -> bool {
    mut i: u64 = 0
    loop {
        if i >= a.elements.len { break }
        if a.elements[i].is_spread { return false }
        if !cf_element_const(a.elements[i].expr, agg) { return false }
        i++
    }
    true
}

/**
 * cf_element_const — true iff the array element `e` is a foldable const: a scalar integer op-tree
 * (`cf_int_value`) or a nested const aggregate (`cf_agg_value`).
 *
 * @param e    the element expression
 * @param agg  the module-aggregate resolution table (for a nested aggregate element)
 * @return     whether `e` is a foldable const element
 * @since #comptime-fold
 */
fn cf_element_const(e: TExpr, agg: AggConstMap) -> bool {
    if cf_int_value(e) { return true }
    cf_agg_value(e, agg)
}

/**
 * cf_can_index — true iff the whole `TIndex` folds: a foldable const-aggregate receiver
 * (`cf_agg_value`) AND a foldable const-integer index (`cf_int_value`). When false the index is
 * rebuilt around its folded children (stays runtime), preserving today's behavior for a runtime index
 * or receiver.
 *
 * @param ix   the typed index expression
 * @param agg  the module-aggregate resolution table
 * @return     whether the index expression is fully const-foldable
 * @since #comptime-fold
 */
fn cf_can_index(ix: TIndex, agg: AggConstMap) -> bool {
    cf_agg_value(ix.receiver, agg) && cf_int_value(ix.index)
}

/**
 * cf_fold_int — the fold's integer-evaluability gate: `cf_int_value` EXTENDED with a
 * `TIndex`-of-const-aggregate arm (agg-aware), so an enclosing cast or op-tree over a const index
 * collapses to a single literal (`(G[0] to u64) to i32` -> `31`, not `((31 to byte) to u64) to i32`).
 * Kept SEPARATE from `cf_int_value` so the CF3 local-binding recording gate (`lp_record_simple`) — the
 * `seed_from_dep_qualified_value_const_and_fn` guard — keeps the name-free `cf_int_value` untouched.
 *
 * @param e    the typed expression to classify
 * @param agg  the module-aggregate resolution table
 * @return     whether `e` is an integer op-tree (possibly over a const index) the fold may evaluate
 * @since #comptime-fold
 */
fn cf_fold_int(e: TExpr, agg: AggConstMap) -> bool {
    match e.kind {
        TNumber as n => !n.is_float && cf_is_int_type(e.type)
        TByteLit => true
        TCast as c => cf_is_int_type(e.type) && cf_fold_cast_operand(c.expr, agg)
        TUnary as u => is_const_unary_op(u.op) && cf_fold_int(u.operand, agg)
        TBinary as b => is_const_binary_op(b.op) && cf_fold_int(b.left, agg) && cf_fold_int(b.right, agg)
        TIndex as ix => cf_can_index(ix, agg)
        TFieldAccess as fa => cf_can_fold_field(fa, agg)
        _ => false
    }
}

/**
 * cf_can_fold_field — the fold's field-access gate (the field mirror of `cf_can_index`): true iff the
 * whole `TFieldAccess` collapses to a literal — a foldable `.len` (CF4d) or an integer struct field of a
 * const struct (CF4c). When false the field access is rebuilt around its folded receiver (stays
 * runtime), preserving today's behavior for a runtime receiver or a not-yet-foldable field.
 *
 * @param fa   the typed field-access node
 * @param agg  the module-aggregate resolution table
 * @return     whether the field access is fully const-foldable to a literal
 * @since #comptime-fold
 */
fn cf_can_fold_field(fa: TFieldAccess, agg: AggConstMap) -> bool {
    if is_len_field(fa) { return cf_len_receiver_const(fa, agg) }
    cf_struct_int_field(fa, agg)
}

/**
 * cf_len_receiver_const — true iff the `.len` receiver `fa.receiver` is a foldable const the fold can
 * take the length of (CF4d): a const aggregate for a slice receiver (`cf_agg_value`), or a const/literal
 * string for a `str` receiver (`cf_str_value`).
 *
 * @param fa   the typed `.len` field-access node
 * @param agg  the module-aggregate resolution table
 * @return     whether the receiver's length is const-foldable
 * @since #comptime-fold
 */
fn cf_len_receiver_const(fa: TFieldAccess, agg: AggConstMap) -> bool {
    match fa.receiver.type {
        Str => cf_str_value(fa.receiver, agg)
        Slice => cf_agg_value(fa.receiver, agg)
        _ => false
    }
}

/**
 * cf_struct_int_field — true iff `fa` reads a field of a const struct whose value is a foldable integer
 * op-tree (CF4c): the receiver resolves to a `TStructInit` (in-tree or a module const struct) that
 * carries the named field, and that field's initializer is `cf_fold_int`. A non-struct receiver, an
 * absent field, or a non-integer field value returns false (the access stays runtime).
 *
 * @param fa   the typed field-access node
 * @param agg  the module-aggregate resolution table
 * @return     whether `fa` reads a const struct's integer field
 * @since #comptime-fold
 */
fn cf_struct_int_field(fa: TFieldAccess, agg: AggConstMap) -> bool {
    match struct_field_init(fa.receiver, fa.field, agg) {
        null => false
        TExpr as fv => cf_fold_int(fv, agg)
    }
}

/**
 * cf_fold_cast_operand — the fold's cast-operand gate: a bare boolean literal (the sole
 * `bool -> numeric` cast) or an integer op-tree the fold evaluates (`cf_fold_int`, so a const index
 * under a cast collapses). The agg-aware mirror of `cf_cast_operand_ok`.
 *
 * @param e    the cast operand to classify
 * @param agg  the module-aggregate resolution table
 * @return     whether the operand is a foldable integer op-tree or a bare boolean literal
 * @since #comptime-fold
 */
fn cf_fold_cast_operand(e: TExpr, agg: AggConstMap) -> bool {
    match e.kind {
        TBoolLit => true
        _ => cf_fold_int(e, agg)
    }
}

/**
 * cv_int_to_numint — reconstruct the sign-magnitude literal carrier a `CVInt` of
 * width/signedness `info` re-emits as, in the SAME representation the parser/typer use (an
 * unsigned value as its non-negative magnitude, a signed value as its signed magnitude).
 * Replaces `cv_int_to_i64` (drop-128, 2026-07-24): with `info.width <= 64` guaranteed
 * (`int_info`'s gate), every value this returns is provably `<= u64::MAX` in magnitude, so —
 * unlike the old i64 carrier, which had no literal form for a u64 whose top bit was set —
 * this NEVER returns null; the return type stays `| null` for the caller's shape (a future
 * fold form may reintroduce an unrepresentable case). Every returned carrier round-trips:
 * fed back to the pipeline as a `TNumber` of the same type, it lowers to exactly the folded
 * bits on both engines, because it is indistinguishable from a hand-written literal the
 * existing lowering already emits correctly.
 *
 * @param bits  the value's two's-complement bits
 * @param info  the value's width/signedness
 * @return      the literal carrier (never null; see above)
 * @since #comptime-fold
 */
fn cv_int_to_numint(bits: u64, info: IntInfo) -> parser::NumInt | null {
    let v = mask_to_width(bits, info.width)
    if !info.is_signed { return parser::numint_of_u64(v) }
    if !bit_set(v, info.width - 1) { return parser::numint_of_u64(v) }
    if is_min_bits(v, info) { return parser::NumInt { neg = true; mag = msb_value(info.width) } }
    parser::NumInt { neg = true; mag = twos_neg(v, info.width) }
}

/**
 * literal_of — reconstruct a literal `TExpr` from a computed `ConstValue`, typed as `ty` and
 * positioned at (`line`, `col`) — the inverse of `eval_const` used by the fold to splice a folded
 * literal back into the typed AST. CF2 reconstructs the INTEGER case (a `CVInt` becomes a `TNumber`
 * whose carrier is re-derived from the bits under `ty`); every non-integer kind (folded only from a
 * later crumb) returns null, signalling the caller to leave the original op-tree unfolded (behavior
 * preserved). The produced node is indistinguishable to lowering from a hand-written literal — zero
 * runtime.
 *
 * @param v     the computed comptime value
 * @param ty    the type the fold site resolved (the reconstructed literal's `.type`)
 * @param line  the original expression's source line (diagnostics/position)
 * @param col   the original expression's source column
 * @return      a literal `TExpr` carrying `v` typed `ty`, or null when `v` has no literal form
 * @since #comptime-fold
 */
fn literal_of(v: ConstValue, ty: Type, line: u32, col: u32) -> TExpr | null {
    match v.kind {
        CVInt as ci => int_literal_of(ci, ty, line, col)
        _ => null
    }
}

/**
 * int_literal_of — reconstruct a `TNumber` literal from an integer comptime value `ci`, typed `ty`
 * and positioned at (`line`, `col`), or null when `ty` is not an integer type the fold carries.
 *
 * @param ci    the integer comptime value
 * @param ty    the reconstructed literal's type
 * @param line  the original expression's source line
 * @param col   the original expression's source column
 * @return      the `TNumber` literal, or null when unrepresentable
 * @since #comptime-fold
 */
fn int_literal_of(ci: CVInt, ty: Type, line: u32, col: u32) -> TExpr | null {
    match int_info(ty) {
        error => null
        IntInfo as info => match cv_int_to_numint(ci.bits, info) {
            null => null
            parser::NumInt as val => TExpr { kind = TNumber { is_float = false; value = val; fval = 0.0 }; type = ty; line = line; col = col }
        }
    }
}
