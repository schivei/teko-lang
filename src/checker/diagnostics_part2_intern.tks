/**
 * strip_leading_diag_space — drop a single leading space from `s` when present (the separator
 * `diag_at` inserts between its `:` and the message). A string with no leading space is unchanged.
 *
 * @param s  the string to trim
 * @return   `s` without a single leading space
 * @since 0.3.1.0 (LSP crumb D)
 */
fn strip_leading_diag_space(s: str) -> str {
    if s.len > 0 && s[0] == b' ' { return teko::str::slice_from(s, 1) }
    s
}

/**
 * to_diagnostic — turn one `collect_diagnostics`-style line (`file:line:col: msg`, `file: msg`, or a
 * bare message) into a structured `Diagnostic` stamped with the CALLER-KNOWN `severity` — never sniffed
 * from `diag`'s own text. `file` is resolved against the closed `files` candidate set
 * (`file_prefix_of`); a line naming none of them (or an unpositioned finding) yields `file = ""`,
 * `line = 0`, `col = 0` with the WHOLE line as the message, mirroring `diag_at`'s own graceful
 * degradation for an unknown position.
 *
 * @param diag      one diagnostic line
 * @param files     the known candidate files, tried in order
 * @param severity  the severity to stamp (known at the caller's own source, e.g. errors vs. warnings)
 * @return          the structured diagnostic
 * @since 0.3.1.0 (LSP crumb D)
 */
fn to_diagnostic(diag: str, files: []str, severity: DiagLevel) -> Diagnostic {
    let file = file_prefix_of(diag, files)
    if file == "" {
        return Diagnostic { file = ""; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = diag }
    }
    let rest = teko::str::slice_from(diag, file.len + 1)
    let p1 = diag_read_u32(rest, 0)
    if !p1.ok || p1.next >= rest.len || rest[p1.next] != b':' {
        return Diagnostic { file = file; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = strip_leading_diag_space(rest) }
    }
    let p2 = diag_read_u32(rest, p1.next + 1)
    if !p2.ok || p2.next >= rest.len || rest[p2.next] != b':' {
        return Diagnostic { file = file; line = 0; col = 0; end_line = 0; end_col = 0; severity = severity; message = strip_leading_diag_space(rest) }
    }
    mut j = p2.next + 1
    if j < rest.len && rest[j] == b' ' { j = j + 1 }
    let msg = teko::str::slice_from(rest, j)
    let line = p1.value
    let col = p2.value
    Diagnostic { file = file; line = line; col = col; end_line = line; end_col = col + 1; severity = severity; message = msg }
}

/**
 * structure_diags — every line of `diags` as a structured `Diagnostic`, all stamped `severity`, in the
 * same order. The mapping half of the crumb D seam: turns one already-collected `[]str` batch (all of
 * the SAME severity by construction — an error batch or a warning batch, never mixed) into `[]Diagnostic`.
 *
 * @param diags     the diagnostic lines, all of one severity
 * @param files     the known candidate files, tried in order
 * @param severity  the severity every line is stamped with
 * @return          the structured diagnostics, in `diags`' order
 * @since 0.3.1.0 (LSP crumb D)
 */
fn structure_diags(diags: []str, files: []str, severity: DiagLevel) -> []Diagnostic {
    mut out: []Diagnostic = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= diags.len { break }
        out = teko::list::push(out, to_diagnostic(diags[i], files, severity))
        i = i + 1
    }
    out
}

/**
 * concat_structured_diags — `b`'s structured diagnostics appended to `a`'s, in order. The `[]Diagnostic`
 * twin of `concat_diags`, kept separate because the corpus has no generic-over-element-type list append.
 *
 * @param a  the diagnostics collected first
 * @param b  the diagnostics to append
 * @return   the concatenation, `a` before `b`
 * @since 0.3.1.0 (LSP crumb D)
 */
fn concat_structured_diags(a: []Diagnostic, b: []Diagnostic) -> []Diagnostic {
    if b.len == 0 { return a }
    if a.len == 0 { return b }
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}
