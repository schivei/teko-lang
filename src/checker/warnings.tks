use teko::parser

/**
 * unused_fn_warning — the located warning line for one dead private function `f`, through the SAME
 * `diag_at` every other collected diagnostic uses (`file:line:col: msg`), so `lsp_api.tks`'s
 * `collect_diagnostics_structured` (crumb D) resolves it to a `Diagnostic` with a precise range, exactly
 * like a type error. The FINDING TEXT mirrors `initanalysis.tks::warn_unused_fn`'s stderr line exactly
 * (the same "unused private function `name`" wording), so a build's console output and the LSP's list never
 * read as two different findings for the same defect; the LOCATION widens from that stderr line's
 * bare `file:line:` to the full `file:line:col:` `diag_at` shape, using the column the declaration
 * already carries (`TFunction.col` — the fn name's own column) for a precise range instead of a
 * whole-line one.
 *
 * @param f  the unused private function
 * @return   the located warning line
 * @since 0.3.1.0 (LSP crumb C)
 */
fn unused_fn_warning(f: TFunction): str {
    diag_at(f.file, f.line, f.col, $"warning: unused private function `{f.name}`")
}

/**
 * collect_unused_fn_warnings — every unused-private-function warning of `prog`, in declaration
 * order. Reuses `initanalysis.tks`'s OWN predicate (`used_in_program`) and its exemptions (`main`,
 * `#test` functions) directly, so this list and `initanalysis.tks::analyze_program`'s stderr prints
 * can never disagree about WHICH functions are dead — the two passes only differ in where a finding
 * goes (a stream vs. a returned list), never in what counts as one.
 *
 * @param prog  the typed program
 * @return      one warning line per unused private function, in item order
 * @since 0.3.1.0 (LSP crumb C)
 */
pub fn collect_unused_fn_warnings(prog: TProgram): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => {
                if f.vis == parser::Visibility::Private && f.name != "main" && !f.is_test {
                    if !used_in_program(prog, f.name) { out = teko::list::push(out, unused_fn_warning(f)) }
                }
            }
            _ => { }
        }
        i = i + 1
    }
    out
}

/**
 * innermost_cast_type — peel through a chain of DIRECTLY-nested casts (`TCast { TCast { … } }`, the
 * exact shape `widen_operand` (`expr.tks`) produces when a machine-inserted arithmetic widen wraps an
 * operand that is ALREADY an explicit `to` cast) down to the innermost layer's own target type — the
 * type the SOURCE TEXT actually spells. A cast that is not further wrapped (the common case) returns
 * its own `.type` unchanged, exactly what `typer.tks::warn_redundant_cast` always rendered.
 *
 * WHY THIS EXISTS: this module re-derives the D1 class-3 (redundant-widen) finding from the ALREADY
 * fully-typed tree (§ `collect_redundant_cast_warnings`) rather than from the fleeting pre-widen
 * operands `typer.tks` checks inline. When the flagged cast's OWN target is narrower than the sibling
 * operand's type, the later arithmetic widen (`type_arith_binop`/`type_bitwise_binop`) wraps it in a
 * SECOND, synthetic cast to the wider common type — and that outer layer's `.type` is never something
 * the programmer wrote, so rendering it verbatim would name a cast that does not exist in the source.
 * Peeling to the innermost layer recovers the one the programmer actually spelled.
 *
 * @param e  a typed expression, expected (but not required) to be a `TCast`
 * @return   the innermost cast layer's own `.type`, or `e.type` unchanged when `e` is not a cast
 * @since 0.3.1.0 (LSP crumb C)
 */
fn innermost_cast_type(e: TExpr): Type {
    match e.kind {
        TCast as tc => match tc.expr.kind { TCast => innermost_cast_type(tc.expr); _ => e.type }
        _ => e.type
    }
}

/**
 * redundant_cast_warning — the located D1 warning line for a redundant cast rendered at `ty`, in the
 * exact wording `typer.tks::warn_redundant_cast` prints to stderr (`cast-width-hygiene-0.3.1.md` D1),
 * so a build's console output and the LSP's diagnostics list read as the SAME finding.
 *
 * @param file  the declaring function's source file
 * @param line  the flagged cast's 1-based line (0 when the cast carries no position — a synthesized
 *              widen the checker itself inserted; `diag_at` then renders `file: msg` alone)
 * @param col   the flagged cast's 1-based column (read only when `line` is known)
 * @param ty    the type to name in the message (the innermost, source-spelled cast target)
 * @return      the located warning line
 * @since 0.3.1.0 (LSP crumb C)
 */
fn redundant_cast_warning(file: str, line: u32, col: u32, ty: Type): str {
    diag_at(file, line, col, $"warning: redundant cast: this `to {type_render(ty)}` is a provable no-op (cast-width-hygiene-0.3.1.md D1) — delete it")
}

/**
 * note_class1_cast — the D1 class-1 check (`typer.tks::type_cast`'s same-type no-op): does `e` ITSELF
 * name a cast whose target equals its own operand's type? This is entirely SELF-CONTAINED (no sibling
 * context needed, unlike class-3), so it reproduces the original decision exactly regardless of how
 * deeply `e` ends up nested inside further casts, binary ops, or any other wrapper.
 *
 * @param file  the declaring function's source file
 * @param e     the expression to test
 * @param out   the warnings accumulated so far
 * @return      `out`, with `e`'s own redundant same-type cast appended when present
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_class1_cast(file: str, e: TExpr, out: []str): []str {
    match e.kind {
        TCast as tc => if type_eq(tc.expr.type, e.type) { teko::list::push(out, redundant_cast_warning(file, e.line, e.col, e.type)) } else { out }
        _ => out
    }
}

/**
 * note_class3_binary — the D1 class-3 check for one `TBinary` node: does the arith/bitwise op's own
 * operand pair carry the shared "redundant widen" verdict (`redundant_widen_cast_of`, `expr.tks`,
 * exactly the predicate `typer.tks::type_binary` applies inline)? Gated to arith/bitwise ops the same
 * way `type_binary` gates its own inline check (shift and logical ops never ran it either).
 *
 * @param file  the declaring function's source file
 * @param b     the typed binary node
 * @param out   the warnings accumulated so far
 * @return      `out`, with the flagged operand's warning appended when `b` carries one
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_class3_binary(file: str, b: TBinary, out: []str): []str {
    if !op_is_arith(b.op) && !op_is_arith_bitwise(b.op) { return out }
    match redundant_widen_cast_of(b.left, b.right) {
        TExpr as bad => teko::list::push(out, redundant_cast_warning(file, bad.line, bad.col, innermost_cast_type(bad)))
        null => out
    }
}

/**
 * note_class3_compare — the D1 class-3 check for one `TCompare` chain, over every CONSECUTIVE operand
 * pair (`first`/`rest[0].operand`, `rest[0].operand`/`rest[1].operand`, …) — exactly the pairs
 * `typer.tks::type_compare` checks term-by-term while building this same chain. A comparison never
 * widens its stored operands afterward (unlike an arith/bitwise binary), so every pair here is the
 * IDENTICAL pair the original inline check saw — no synthetic-wrap peeling is needed.
 *
 * @param file  the declaring function's source file
 * @param c     the typed comparison chain
 * @param out   the warnings accumulated so far
 * @return      `out`, with one warning appended per flagged consecutive pair
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_class3_compare(file: str, c: TCompare, out: []str): []str {
    var acc = out
    var prev = c.first
    var i: u64 = 0
    loop {
        if i >= c.rest.len { break }
        var cur = c.rest[i].operand
        acc = match redundant_widen_cast_of(prev, cur) {
            TExpr as bad => teko::list::push(acc, redundant_cast_warning(file, bad.line, bad.col, innermost_cast_type(bad)))
            null => acc
        }
        prev = cur
        i = i + 1
    }
    acc
}

/**
 * note_redundant_casts_expr — visit `e` and every expression reachable from it, noting a D1 class-1
 * or class-3 finding at each node that carries one. Descends into every `@TExprKind()` arm (mirroring
 * `metrics.tks::expr_has_conversion`'s exhaustive shape) so a redundant cast buried inside a call
 * argument, an `if`/`match` branch, a struct literal field, or a closure BODY is still found — the
 * closure descent (`TLambda`) is the one arm `metrics.tks`'s D4 walk skips that this walk does not,
 * because a redundant cast inside a lambda body is exactly as real a finding as one at top level.
 *
 * @param file  the declaring function's source file
 * @param e     the expression to walk
 * @param out   the warnings accumulated so far
 * @return      `out`, with every redundant cast reachable from `e` appended
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_redundant_casts_expr(file: str, e: TExpr, out: []str): []str {
    var acc = note_class1_cast(file, e, out)
    match e.kind {
        TBinary as b => {
            acc = note_class3_binary(file, b, acc)
            acc = note_redundant_casts_expr(file, b.left, acc)
            acc = note_redundant_casts_expr(file, b.right, acc)
        }
        TUnary as u => acc = note_redundant_casts_expr(file, u.operand, acc)
        TCompare as cm => {
            acc = note_class3_compare(file, cm, acc)
            acc = note_redundant_casts_expr(file, cm.first, acc)
            var i: u64 = 0
            loop { if i >= cm.rest.len { break }; acc = note_redundant_casts_expr(file, cm.rest[i].operand, acc); i = i + 1 }
        }
        TCall as c => { var i: u64 = 0; loop { if i >= c.args.len { break }; acc = note_redundant_casts_expr(file, c.args[i], acc); i = i + 1 } }
        TCast as ct => acc = note_redundant_casts_expr(file, ct.expr, acc)
        TIfExpr as f => {
            acc = note_redundant_casts_expr(file, f.cond, acc)
            acc = note_redundant_casts_block(file, f.then_blk, acc)
            if f.has_else { acc = note_redundant_casts_block(file, f.else_blk, acc) }
        }
        TMatchExpr as m => {
            acc = note_redundant_casts_expr(file, m.subject, acc)
            var i: u64 = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { acc = note_redundant_casts_expr(file, m.arms[i].guard, acc) }
                acc = note_redundant_casts_block(file, m.arms[i].body, acc)
                i = i + 1
            }
        }
        TFieldAccess as fa => acc = note_redundant_casts_expr(file, fa.receiver, acc)
        TIndex as ix => { acc = note_redundant_casts_expr(file, ix.receiver, acc); acc = note_redundant_casts_expr(file, ix.index, acc) }
        TStructInit as si => { var i: u64 = 0; loop { if i >= si.field_vals.len { break }; acc = note_redundant_casts_expr(file, si.field_vals[i], acc); i = i + 1 } }
        TInterp as ip => {
            var i: u64 = 0
            loop {
                if i >= ip.holes.len { break }
                acc = note_redundant_casts_expr(file, ip.holes[i], acc)
                if i < ip.specs.len {
                    match ip.specs[i].kind {
                        TFSpecDynamic as fd => { var k: u64 = 0; loop { if k >= fd.args.len { break }; acc = note_redundant_casts_expr(file, fd.args[k], acc); k = k + 1 } }
                        _ => { }
                    }
                }
                i = i + 1
            }
        }
        TInExpr as ie => {
            acc = note_redundant_casts_expr(file, ie.lhs, acc)
            var i: u64 = 0
            loop { if i >= ie.elems.len { break }; acc = note_redundant_casts_expr(file, ie.elems[i], acc); i = i + 1 }
        }
        TArrayLit as al => { var i: u64 = 0; loop { if i >= al.elements.len { break }; acc = note_redundant_casts_expr(file, al.elements[i].expr, acc); i = i + 1 } }
        TBorrow as bo => acc = note_redundant_casts_expr(file, bo.operand, acc)
        TLambda as lam => acc = note_redundant_casts_block(file, lam.body, acc)
        TBlockExpr as b => acc = note_redundant_casts_block(file, b.body, acc)
        _ => { }
    }
    acc
}

/**
 * note_redundant_casts_block — walk every statement of `stmts` in order, threading the accumulator.
 *
 * @param file   the declaring function's source file
 * @param stmts  the statement block to walk
 * @param out    the warnings accumulated so far
 * @return       `out`, with the whole block's findings appended
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_redundant_casts_block(file: str, stmts: []@TStatement(), out: []str): []str {
    var acc = out
    var i: u64 = 0
    loop { if i >= stmts.len { break }; acc = note_redundant_casts_stmt(file, stmts[i], acc); i = i + 1 }
    acc
}

/**
 * note_redundant_casts_stmt — visit `s`'s own expression(s), descending into a nested block
 * (`loop`/`defer`/`adopt`) the same way `metrics.tks::stmt_has_conversion` does for its own metric.
 *
 * @param file  the declaring function's source file
 * @param s     the statement to walk
 * @param out   the warnings accumulated so far
 * @return      `out`, with every redundant cast reachable from `s` appended
 * @since 0.3.1.0 (LSP crumb C)
 */
fn note_redundant_casts_stmt(file: str, s: @TStatement(), out: []str): []str {
    match s {
        TBinding as b => note_redundant_casts_expr(file, b.value, out)
        TAssign as a => {
            var acc1 = note_redundant_casts_expr(file, a.value, out)
            if parser::assign_has_target(a.kind) { note_redundant_casts_expr(file, a.target, acc1) } else { acc1 }
        }
        TReturn as r => if r.has_value { note_redundant_casts_expr(file, r.value, out) } else { out }
        TLoopStmt as l => note_redundant_casts_block(file, l.body, note_redundant_casts_block(file, l.init, out))
        TExprStmt as x => note_redundant_casts_expr(file, x.expr, out)
        TDeferStmt as d => note_redundant_casts_block(file, d.body, out)
        TAdoptStmt as ad => note_redundant_casts_block(file, ad.body, out)
        TBlockStmt as b => note_redundant_casts_block(file, b.body, out)
        _ => out
    }
}

/**
 * collect_redundant_cast_warnings — every D1 redundant-cast warning of `prog` (class-1 same-type and
 * class-3 redundant-widen, `cast-width-hygiene-0.3.1.md` D1), re-derived from the ALREADY-typed tree
 * rather than threaded live through `typer.tks`'s deep recursive expression typer — the class-1/
 * class-3 decisions depend only on the cast's own operand type(s), already fully resolved in the
 * typed tree, so no re-typing or Env context is needed to re-derive them (§ module doc). A function's
 * body is walked under its OWN `.file`; a module-level `const` initializer or a loose top-level
 * statement carries no such field on its typed node (`TConstDecl`/`TStatement` — unlike `TFunction`),
 * so those walk under `""` and the resulting warning is positioned by `diag_at`'s own graceful
 * degradation (`file` unknown ⇒ the bare message, still returned, never dropped) — the same
 * intentional compromise `initanalysis.tks::analyze_program` already makes for its own loose-body
 * walk (`check_locals(loose, loose, "")`).
 *
 * @param prog  the typed program
 * @return      one warning line per redundant cast found, in item/declaration order
 * @since 0.3.1.0 (LSP crumb C)
 */
pub fn collect_redundant_cast_warnings(prog: TProgram): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            TFunction as f => out = note_redundant_casts_block(f.file, f.body, out)
            TConstDecl as cd => out = note_redundant_casts_expr("", cd.init, out)
            (@TStatement()) as s => out = note_redundant_casts_stmt("", s, out)
            _ => { }
        }
        i = i + 1
    }
    out
}

/**
 * collect_warnings — every warning `prog` carries — unused private functions, then redundant casts
 * — as located `file:line:col: warning: …` lines, the exact shape `collect_diagnostics`
 * (`lsp_api.tks`) appends onto its error list. This is the crumb C seam: the two producers that used
 * to ONLY print to stderr (`initanalysis.tks::warn_unused_fn`, `typer.tks::warn_redundant_cast`) now
 * ALSO surface here as data, so the LSP's `collect_diagnostics` — and therefore its
 * `publishDiagnostics` — carries every warning a build would print, not only its hard errors. The
 * stderr prints are UNCHANGED (a build's console output is untouched); this is an additive second
 * reader of the same findings, not a replacement of the first.
 *
 * @param prog  the typed program
 * @return      every warning, unused-fn findings before redundant-cast findings
 * @since 0.3.1.0 (LSP crumb C)
 */
pub fn collect_warnings(prog: TProgram): []str {
    concat_diags(collect_unused_fn_warnings(prog), collect_redundant_cast_warnings(prog))
}
