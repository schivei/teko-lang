use teko::lexer
use teko::parser

/**
 * mt_i64t — the `i64` primitive type, for the ARITH-CAST-RATE fixtures.
 *
 * @return the `i64` primitive type
 */
fn mt_i64t() -> Type { Prim { kind = PrimKind::I64 } }

/**
 * mt_u32t — the `u32` primitive type, for the ARITH-CAST-RATE fixtures.
 *
 * @return the `u32` primitive type
 */
fn mt_u32t() -> Type { Prim { kind = PrimKind::U32 } }

/**
 * mt_te — a minimal typed expression at line/col 1 (the fixtures don't exercise positioning).
 *
 * @param k  the expression's kind
 * @param t  the expression's resolved type
 * @return   the assembled `TExpr`
 */
fn mt_te(k: TExprKind, t: Type) -> TExpr { TExpr { kind = k; type = t; line = 1; col = 1 } }

/**
 * mt_num — a bare i64 number-literal leaf carrying `v`.
 *
 * @param v  the literal value
 * @return   the typed number leaf
 */
fn mt_num(v: i64) -> TExpr { mt_te(TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }, mt_i64t()) }

/**
 * mt_cast — `inner to t` — a typed cast wrapping `inner`.
 *
 * @param inner  the cast's operand
 * @param t      the cast's target type
 * @return       the typed cast expression
 */
fn mt_cast(inner: TExpr, t: Type) -> TExpr { mt_te(TCast { expr = inner }, t) }

/**
 * mt_bin — `l <op> r`, typed at `l`'s own type (the fixtures don't need a genuinely-joined
 * width — only the op token and the operand subtree matter to the walker).
 *
 * @param op  the binary operator token
 * @param l   the left operand
 * @param r   the right operand
 * @return    the typed binary expression
 */
fn mt_bin(op: lexer::TokenKind, l: TExpr, r: TExpr) -> TExpr { mt_te(TBinary { op = op; left = l; right = r }, l.type) }

/**
 * mt_casting_call — a zero-arg call whose resolved namespace is `teko::casting` (the D5
 * no-panic converter surface) — the "conversion" sibling of a bare `TCast` (§5).
 *
 * @return a typed call node tagged `teko::casting`
 */
fn mt_casting_call() -> TExpr {
    let path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "u64_to_u32" }) }
    mt_te(TCall { callee = path; args = teko::list::empty(); call_ns = "teko::casting"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0 }, mt_u32t())
}

/**
 * mt_binding — `let <target> = value` (`Let`), the D4 binding node kind.
 *
 * @param value  the binding's typed value expression
 * @return       the typed binding statement
 */
fn mt_binding(value: TExpr) -> TStatement { TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = "x" }; bound = value.type; value = value; di_kind = parser::DiKind::None } }

#test
/**
 * plain_arith_binary_has_no_conversion — `1 + 2` (no cast anywhere) is noted with
 * `with_conversion = 0`.
 *
 * @return void
 */
fn plain_arith_binary_has_no_conversion() {
    let e = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2))
    let r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 0)
}

#test
/**
 * arith_binary_with_cast_operand_is_a_conversion — `(1 to u32) + 2` carries a `TCast`
 * on its left operand, so the D4 walker tags it `with_conversion = 1`.
 *
 * @return void
 */
fn arith_binary_with_cast_operand_is_a_conversion() {
    let e = mt_bin(lexer::TokenKind::Plus, mt_cast(mt_num(1), mt_u32t()), mt_num(2))
    let r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
/**
 * shift_binary_is_not_counted — `1 << 2` sits OUTSIDE the D4 regime (shift, not
 * arith/bitwise — matches the W-RULE's own scope), so it contributes nothing.
 *
 * @return void
 */
fn shift_binary_is_not_counted() {
    let e = mt_bin(lexer::TokenKind::Shl, mt_num(1), mt_num(2))
    let r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 0)
}

#test
/**
 * binding_with_casting_call_is_a_conversion — `teko::casting::*` counts the SAME as a bare
 * `to` (D5 refinement, §5): a `let` bound to a casting-module call is tagged
 * `with_conversion = 1`.
 *
 * @return void
 */
fn binding_with_casting_call_is_a_conversion() {
    let r = arith_cast_rate_walk_stmt(mt_binding(mt_casting_call()), arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
/**
 * binding_and_nested_arith_both_count — `let x = (1 + 2) to u32` is BOTH a `TBinding` unit
 * (its value carries a cast) AND, nested inside it, an arith `TBinary` unit (its own operand
 * tree — `1 + 2` — carries no cast) — two DISTINCT units, only one flagged.
 *
 * @return void
 */
fn binding_and_nested_arith_both_count() {
    let inner = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2))
    let value = mt_cast(inner, mt_u32t())
    let r = arith_cast_rate_walk_stmt(mt_binding(value), arith_cast_rate_empty())
    teko::assert::is_true(r.total == 2)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
/**
 * pct_and_gate_boundary — the D4 ceiling, asserted AT the boundary and one step past it:
 * 5/100 gates green (exactly at `ARITH_CAST_RATE_CEILING`, and `<=` must include it),
 * 6/100 gates red, and the empty (0/0) report is vacuously green.
 *
 * Pinned to the CONSTANT rather than to a hard-coded 5, so the day the ratchet tightens the
 * ceiling back toward 2% (the .32 window — see `ARITH_CAST_RATE_CEILING`) this test follows
 * instead of failing for having been written against the old number.
 *
 * @return void
 */
fn pct_and_gate_boundary() {
    let at_ceiling = ArithCastRateReport { total = 10000; with_conversion = (ARITH_CAST_RATE_CEILING * 100.0) to u64 }
    let over = ArithCastRateReport { total = 10000; with_conversion = ((ARITH_CAST_RATE_CEILING * 100.0) to u64) + 1 }
    teko::assert::is_true(arith_cast_rate_gate_ok(at_ceiling))
    teko::assert::is_false(arith_cast_rate_gate_ok(over))
    teko::assert::is_true(arith_cast_rate_gate_ok(arith_cast_rate_empty()))
}

#test
/**
 * program_walk_covers_function_and_const — `arith_cast_rate_report` visits BOTH a function
 * body's binding and a module-level `const`'s initializer.
 *
 * @return void
 */
fn program_walk_covers_function_and_const() {
    let fn_body = teko::list::push(teko::list::empty(), mt_binding(mt_cast(mt_num(5), mt_u32t())))
    let f = TFunction { name = "f"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = Void { }; body = fn_body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64 }
    let cd = TConstDecl { name = "K"; namespace = ""; ty = mt_i64t(); init = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2)); vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0 }
    mut items: []TItem = teko::list::empty()
    items = teko::list::push(items, f)
    items = teko::list::push(items, cd)
    let r = arith_cast_rate_report(TProgram { items = items })
    teko::assert::is_true(r.total == 2)
    teko::assert::is_true(r.with_conversion == 1)
}
