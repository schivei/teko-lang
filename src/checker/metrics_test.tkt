use teko::lexer
use teko::parser

fn mt_i64t(): @Type() { Prim { kind = PrimKind::I64 } }

fn mt_u32t(): @Type() { Prim { kind = PrimKind::U32 } }

fn mt_te(k: @TExprKind(), t: @Type()): TExpr { TExpr { kind = k; type = t; line = 1; col = 1 } }

fn mt_num(v: i64): TExpr { mt_te(TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }, mt_i64t()) }

fn mt_cast(inner: TExpr, t: @Type()): TExpr { mt_te(TCast { expr = inner }, t) }

fn mt_bin(op: lexer::TokenKind, l: TExpr, r: TExpr): TExpr { mt_te(TBinary { op = op; left = l; right = r }, l.type) }

fn mt_casting_call(): TExpr {
    var path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = "u64_to_u32" }) }
    mt_te(TCall { overload_suffix = ""; callee = path; args = teko::list::empty(); call_ns = "teko::casting"; is_closure_call = false; callee_type = Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }, mt_u32t())
}

fn mt_binding(value: TExpr): @TStatement() { TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = "x" }; bound = value.type; value = value } }

#test
fn plain_arith_binary_has_no_conversion() {
    var e = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2))
    var r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 0)
}

#test
fn arith_binary_with_cast_operand_is_a_conversion() {
    var e = mt_bin(lexer::TokenKind::Plus, mt_cast(mt_num(1), mt_u32t()), mt_num(2))
    var r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
fn shift_binary_is_not_counted() {
    var e = mt_bin(lexer::TokenKind::Shl, mt_num(1), mt_num(2))
    var r = arith_cast_rate_walk_stmt(TExprStmt { expr = e }, arith_cast_rate_empty())
    teko::assert::is_true(r.total == 0)
}

#test
fn binding_with_casting_call_is_a_conversion() {
    var r = arith_cast_rate_walk_stmt(mt_binding(mt_casting_call()), arith_cast_rate_empty())
    teko::assert::is_true(r.total == 1)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
fn binding_and_nested_arith_both_count() {
    var inner = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2))
    var value = mt_cast(inner, mt_u32t())
    var r = arith_cast_rate_walk_stmt(mt_binding(value), arith_cast_rate_empty())
    teko::assert::is_true(r.total == 2)
    teko::assert::is_true(r.with_conversion == 1)
}

#test
fn pct_and_gate_boundary() {
    var at_ceiling = ArithCastRateReport { total = 10000; with_conversion = (ARITH_CAST_RATE_CEILING * 100.0) to u64 }
    var over = ArithCastRateReport { total = 10000; with_conversion = ((ARITH_CAST_RATE_CEILING * 100.0) to u64) + 1 }
    teko::assert::is_true(arith_cast_rate_gate_ok(at_ceiling))
    teko::assert::is_false(arith_cast_rate_gate_ok(over))
    teko::assert::is_true(arith_cast_rate_gate_ok(arith_cast_rate_empty()))
}

#test
fn program_walk_covers_function_and_const() {
    var fn_body = teko::list::push(teko::list::empty(), mt_binding(mt_cast(mt_num(5), mt_u32t())))
    var f = TFunction { overload_suffix = ""; name = "f"; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = Void { }; body = fn_body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
    var cd = TConstDecl { name = "K"; namespace = ""; ty = mt_i64t(); init = mt_bin(lexer::TokenKind::Plus, mt_num(1), mt_num(2)); vis = parser::Visibility::Private; has_doc = false; doc = ""; line = 0; col = 0; guard = parser::pred_true() }
    var items: []@TItem() = teko::list::empty()
    items = teko::list::push(items, f)
    items = teko::list::push(items, cd)
    var r = arith_cast_rate_report(TProgram { items = items })
    teko::assert::is_true(r.total == 2)
    teko::assert::is_true(r.with_conversion == 1)
}
