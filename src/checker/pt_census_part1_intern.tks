/**
 * The zero census — no function walked yet.
 *
 * @return  a census with every field at zero
 */
fn pt_census_empty() -> PtCensus {
    PtCensus { fns = 0; cells = 0; frame = 0; root = 0; param = 0; adopter = 0; adopter_top = 0; top = 0; max_cells = 0 }
}

/**
 * Fold one program item into the census — a `TFunction` contributes its spine, everything else
 * contributes nothing.
 *
 * @param c   the accumulated census
 * @param it  the program item
 * @return    the census with the item's cells folded in (unchanged for a non-function item)
 */
fn pt_census_add_item(c: PtCensus, it: TItem) -> PtCensus {
    match it {
        TFunction as f => pt_census_add_spine(c, fn_spine(f))
        _ => c
    }
}

/**
 * Open one more function in the census: bump the function count, add its cell count to the total,
 * and raise the fat-tail high-water mark.
 *
 * @param c  the accumulated census
 * @param n  the number of cells the function's universe holds
 * @return   the census with the function's totals opened (no arm counted yet)
 */
fn pt_census_open_fn(c: PtCensus, n: u64) -> PtCensus {
    PtCensus {
        fns = c.fns + 1
        cells = c.cells + n
        frame = c.frame
        root = c.root
        param = c.param
        adopter = c.adopter
        adopter_top = c.adopter_top
        top = c.top
        max_cells = pt_census_larger(c.max_cells, n)
    }
}

/**
 * Count one cell's points-to value into the census — exactly one arm counter rises, and the
 * `PtAdopter` sub-counter rises with it when the region id is the `⊤` fallback.
 *
 * @param c  the accumulated census
 * @param p  the cell's points-to value
 * @return   the census with `p` counted
 */
fn pt_census_bump(c: PtCensus, p: PointsTo) -> PtCensus {
    PtCensus {
        fns = c.fns
        cells = c.cells
        frame = c.frame + pt_is_frame(p)
        root = c.root + pt_is_root(p)
        param = c.param + pt_is_param(p)
        adopter = c.adopter + pt_is_adopter(p)
        adopter_top = c.adopter_top + pt_is_adopter_top(p)
        top = c.top + pt_is_top(p)
        max_cells = c.max_cells
    }
}

/**
 * The `PtFrame` summand of one points-to value.
 *
 * @param p  the points-to value
 * @return   1 for `PtFrame`, else 0
 */
fn pt_is_frame(p: PointsTo) -> u64 {
    match p { PtFrame => 1; _ => 0 }
}

/**
 * The `PtRoot` summand of one points-to value.
 *
 * @param p  the points-to value
 * @return   1 for `PtRoot`, else 0
 */
fn pt_is_root(p: PointsTo) -> u64 {
    match p { PtRoot => 1; _ => 0 }
}

/**
 * The `PtParam` summand of one points-to value.
 *
 * @param p  the points-to value
 * @return   1 for `PtParam`, else 0
 */
fn pt_is_param(p: PointsTo) -> u64 {
    match p { PtParam => 1; _ => 0 }
}

/**
 * The `PtAdopter` summand of one points-to value.
 *
 * @param p  the points-to value
 * @return   1 for `PtAdopter`, else 0
 */
fn pt_is_adopter(p: PointsTo) -> u64 {
    match p { PtAdopter => 1; _ => 0 }
}

/**
 * The `PtAdopter(⊤)` summand of one points-to value — the depth-budget fallback, counted as a
 * SUBSET of `pt_is_adopter`, never beside it.
 *
 * @param p  the points-to value
 * @return   1 for a `PtAdopter` whose region id is the `⊤` fallback, else 0
 */
fn pt_is_adopter_top(p: PointsTo) -> u64 {
    match p {
        PtAdopter as a => if a.id.top { 1 } else { 0 }
        _ => 0
    }
}

/**
 * The `PtTop` summand of one points-to value.
 *
 * @param p  the points-to value
 * @return   1 for `PtTop`, else 0
 */
fn pt_is_top(p: PointsTo) -> u64 {
    match p { PtTop => 1; _ => 0 }
}

/**
 * The larger of two counts (the fat-tail high-water mark's step).
 *
 * @param a  the running maximum
 * @param b  the candidate
 * @return   whichever is greater
 */
fn pt_census_larger(a: u64, b: u64) -> u64 {
    if b > a { return b }
    a
}
