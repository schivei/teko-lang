#test
/**
 * strkey_hash_eq_consistency — the hash-eq consistency law on `StrKey`: two keys with equal payload
 * return equal `hash()` AND compare `__eq`-equal; a distinct payload differs on both. This is the
 * contract the hash-keyed collections rely on (equal keys must hash equal).
 */
fn strkey_hash_eq_consistency() {
    var a = StrKey { key = "abc" }
    var b = StrKey { key = "abc" }
    var c = StrKey { key = "xyz" }
    teko::assert::is_true(a.hash() == b.hash())
    teko::assert::is_true(a == b)
    teko::assert::is_true(a.hash() != c.hash())
    teko::assert::is_true(a != c)
}

#test
/**
 * strkey_orders_lexicographically — `StrKey`'s `IOrd` conformance orders by the underlying byte
 * order: `"a" < "b"`, and the derived `__gt`/`__le`/`__ge` reflections answer consistently.
 */
fn strkey_orders_lexicographically() {
    var a = StrKey { key = "a" }
    var b = StrKey { key = "b" }
    teko::assert::is_true(a < b)
    teko::assert::is_true(b > a)
    teko::assert::is_true(a <= a)
    teko::assert::is_true(b >= a)
}

#test
/**
 * i64key_hash_eq_consistency — the SECOND conformer instantiation: `I64Key` satisfies the same
 * hash-eq consistency law, including a NEGATIVE payload (whose sign-safe zig-zag hash never casts a
 * negative `i64` to `u64`).
 */
fn i64key_hash_eq_consistency() {
    var a = I64Key { n = -7 }
    var b = I64Key { n = -7 }
    var c = I64Key { n = 7 }
    teko::assert::is_true(a.hash() == b.hash())
    teko::assert::is_true(a == b)
    teko::assert::is_true(a.hash() != c.hash())
    teko::assert::is_true(a != c)
    teko::assert::is_true(a < c)
}
