#test
fn strkey_hash_eq_consistency() {
    var a = StrKey { key = "abc" }
    var b = StrKey { key = "abc" }
    var c = StrKey { key = "xyz" }
    teko::assert::is_true(a.hash() == b.hash())
    teko::assert::is_true(a == b)
    teko::assert::is_true(a.hash() != c.hash())
    teko::assert::is_true(a != c)
}

#test
fn strkey_orders_lexicographically() {
    var a = StrKey { key = "a" }
    var b = StrKey { key = "b" }
    teko::assert::is_true(a < b)
    teko::assert::is_true(b > a)
    teko::assert::is_true(a <= a)
    teko::assert::is_true(b >= a)
}

#test
fn i64key_hash_eq_consistency() {
    var a = I64Key { n = -7 }
    var b = I64Key { n = -7 }
    var c = I64Key { n = 7 }
    teko::assert::is_true(a.hash() == b.hash())
    teko::assert::is_true(a == b)
    teko::assert::is_true(a.hash() != c.hash())
    teko::assert::is_true(a != c)
    teko::assert::is_true(a < c)
}
