/**
 * Wrapping `a + b` as `i64` — the sum modulo 2^64. Routed through the `u64` domain (where `+` is defined modular in C) and reinterpreted back, so no signed overflow UB is emitted. Total.
 *
 * @param a  the left operand
 * @param b  the right operand
 * @return      `(a + b) mod 2^64` as `i64` (two's-complement wraparound)
 */
pub fn wrapping_add_i64(a: i64, b: i64) -> i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) + u64_bits_of_i64(b))
}

/**
 * Wrapping `a - b` as `i64` — the difference modulo 2^64. Routed through the `u64` domain (where `-` is defined modular in C) and reinterpreted back, so no signed overflow UB is emitted. Total.
 *
 * @param a  the left operand
 * @param b  the right operand
 * @return      `(a - b) mod 2^64` as `i64` (two's-complement wraparound)
 */
pub fn wrapping_sub_i64(a: i64, b: i64) -> i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) - u64_bits_of_i64(b))
}

/**
 * Wrapping `a * b` as `i64` — the product modulo 2^64. Routed through the `u64` domain (where `*` is defined modular in C) and reinterpreted back, so no signed overflow UB is emitted. Total.
 *
 * @param a  the left operand
 * @param b  the right operand
 * @return      `(a * b) mod 2^64` as `i64` (two's-complement wraparound)
 */
pub fn wrapping_mul_i64(a: i64, b: i64) -> i64 {
    i64_from_u64_bits(u64_bits_of_i64(a) * u64_bits_of_i64(b))
}

/**
 * Wrapping negation of `a` as `i64` — `i64::MIN` maps to itself (defining the UB corner). Routed through the `u64` domain, so no signed overflow is emitted. Total.
 *
 * @param a  the value to negate
 * @return      `-a mod 2^64` as `i64` (with `i64::MIN -> i64::MIN`)
 */
pub fn wrapping_neg_i64(a: i64) -> i64 {
    i64_from_u64_bits((0 to u64) - u64_bits_of_i64(a))
}

/**
 * Wrapping left shift of `a` by `count` bits as `i64`; the count is masked to `count mod 64` (the #49/#61 semantics); the runtime's signed `<<` is UB-free. Total.
 *
 * @param a  the value to shift
 * @param count  the shift amount (masked to `mod 64`)
 * @return      `a << (count mod 64)` as `i64`
 */
pub fn wrapping_shl_i64(a: i64, count: u32) -> i64 { a << ((count % 64) to i64) }

/**
 * Wrapping right shift of `a` by `count` bits as `i64` (arithmetic); the count is masked to `count mod 64` (the #49/#61 semantics). Total.
 *
 * @param a  the value to shift
 * @param count  the shift amount (masked to `mod 64`)
 * @return      `a >> (count mod 64)` as `i64`
 */
pub fn wrapping_shr_i64(a: i64, count: u32) -> i64 { a >> ((count % 64) to i64) }

/**
 * Saturating `a + b` as `i64` — clamps to `i64::MAX` on positive overflow and `i64::MIN` on negative overflow. Total.
 *
 * @param a  the augend
 * @param b  the addend
 * @return      `a + b`, or the sign-appropriate bound on overflow
 */
pub fn saturating_add_i64(a: i64, b: i64) -> i64 {
    match checked_add_i64(a, b) {
        i64 as v => v
        error => { if b > 0 { return I64_MAX }; i64_min() }
    }
}

/**
 * Saturating `a - b` as `i64` — clamps to `i64::MAX` on positive overflow and `i64::MIN` on negative overflow. Total.
 *
 * @param a  the minuend
 * @param b  the subtrahend
 * @return      `a - b`, or the sign-appropriate bound on overflow
 */
pub fn saturating_sub_i64(a: i64, b: i64) -> i64 {
    match checked_sub_i64(a, b) {
        i64 as v => v
        error => { if b < 0 { return I64_MAX }; i64_min() }
    }
}

/**
 * Saturating `a * b` as `i64` — clamps to `i64::MAX` when the product's sign is positive, `i64::MIN` when negative. Total.
 *
 * @param a  the multiplicand
 * @param b  the multiplier
 * @return      `a * b`, or the sign-appropriate bound on overflow
 */
pub fn saturating_mul_i64(a: i64, b: i64) -> i64 {
    match checked_mul_i64(a, b) {
        i64 as v => v
        error => { if (a > 0) == (b > 0) { return I64_MAX }; i64_min() }
    }
}
