/**
 * `checked_*` on `u32` reports overflow / underflow / div-by-zero / unsigned-neg as errors, never a panic; happy paths return the value.
 */
#test
fn checked_u32_edges() {
    teko::assert::is_true(chk_is_err_u32(checked_add_u32(U32_MAX, (1 to u32))))
    teko::assert::is_true(chk_is_err_u32(checked_sub_u32(U32_MIN, (1 to u32))))
    teko::assert::is_true(chk_is_err_u32(checked_mul_u32(U32_MAX, (2 to u32))))
    teko::assert::is_true(chk_is_err_u32(checked_div_u32((1 to u32), U32_MIN)))
    teko::assert::is_true(chk_is_err_u32(checked_rem_u32((1 to u32), U32_MIN)))
    teko::assert::is_true(chk_is_err_u32(checked_neg_u32((1 to u32))))
    teko::assert::is_true(chk_unwrap_u32(checked_add_u32(U32_MAX, U32_MIN)) == U32_MAX)
    teko::assert::is_true(chk_unwrap_u32(checked_sub_u32(U32_MAX, (1 to u32))) == U32_MAX - (1 to u32))
    teko::assert::is_true(chk_unwrap_u32(checked_mul_u32(U32_MAX, (1 to u32))) == U32_MAX)
    teko::assert::is_true(chk_unwrap_u32(checked_div_u32(U32_MAX, (1 to u32))) == U32_MAX)
    teko::assert::is_true(chk_unwrap_u32(checked_rem_u32(U32_MAX, (2 to u32))) == (1 to u32))
    teko::assert::is_true(chk_unwrap_u32(checked_neg_u32(U32_MIN)) == U32_MIN)
}

/**
 * `wrapping_*` on `u32` wraps modulo 2^32: MAX+1 -> 0, 0-1 -> MAX, MAX*2 -> MAX-1; and totality on happy inputs.
 */
#test
fn wrapping_u32_wraps() {
    teko::assert::is_true(wrapping_add_u32(U32_MAX, (1 to u32)) == U32_MIN)
    teko::assert::is_true(wrapping_sub_u32(U32_MIN, (1 to u32)) == U32_MAX)
    teko::assert::is_true(wrapping_mul_u32(U32_MAX, (2 to u32)) == U32_MAX - (1 to u32))
    teko::assert::is_true(wrapping_neg_u32(U32_MIN) == U32_MIN)
    teko::assert::is_true(wrapping_neg_u32((1 to u32)) == U32_MAX)
    teko::assert::is_true(wrapping_add_u32((2 to u32), (1 to u32)) == (3 to u32))
    teko::assert::is_true(wrapping_mul_u32((3 to u32), (2 to u32)) == (6 to u32))
}

/**
 * `saturating_*` on `u32` clamps to MAX on overflow and 0 on underflow; happy inputs pass through unchanged.
 */
#test
fn saturating_u32_clamps() {
    teko::assert::is_true(saturating_add_u32(U32_MAX, (1 to u32)) == U32_MAX)
    teko::assert::is_true(saturating_sub_u32(U32_MIN, (1 to u32)) == U32_MIN)
    teko::assert::is_true(saturating_mul_u32(U32_MAX, (2 to u32)) == U32_MAX)
    teko::assert::is_true(saturating_add_u32((2 to u32), (1 to u32)) == (3 to u32))
    teko::assert::is_true(saturating_sub_u32((5 to u32), (2 to u32)) == (3 to u32))
}

/**
 * Shift edges on `u32`: `checked_shl/shr` error when the count reaches the width; `wrapping_shl/shr` mask the count `mod 32` (the #49/#61 regression) and never trap.
 */
#test
fn shift_u32_edges() {
    teko::assert::is_true(chk_is_err_u32(checked_shl_u32((1 to u32), 32)))
    teko::assert::is_true(chk_is_err_u32(checked_shr_u32((1 to u32), 32)))
    teko::assert::is_true(chk_unwrap_u32(checked_shl_u32((1 to u32), 1)) == (2 to u32))
    teko::assert::is_true(chk_unwrap_u32(checked_shr_u32((2 to u32), 1)) == (1 to u32))
    teko::assert::is_true(wrapping_shl_u32((1 to u32), 32) == wrapping_shl_u32((1 to u32), 0))
    teko::assert::is_true(wrapping_shr_u32((2 to u32), 32) == wrapping_shr_u32((2 to u32), 0))
    teko::assert::is_true(wrapping_shl_u32((1 to u32), 1) == (2 to u32))
}

/**
 * `checked_pow` on `u32`: exact powers, `x^0 == 1`, and overflow -> error.
 */
#test
fn pow_u32_cases() {
    teko::assert::is_true(chk_unwrap_u32(checked_pow_u32((2 to u32), 3)) == (8 to u32))
    teko::assert::is_true(chk_unwrap_u32(checked_pow_u32((5 to u32), 0)) == (1 to u32))
    teko::assert::is_true(chk_is_err_u32(checked_pow_u32(U32_MAX, 2)))
}

