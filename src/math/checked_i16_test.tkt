/**
 * `checked_*` on `i16` reports overflow / div-by-zero / MIN-neg / MIN-over--1 as errors; happy paths (incl. negatives) return the value.
 */
#test
fn checked_i16_edges() {
    teko::assert::is_true(chk_is_err_i16(checked_add_i16(I16_MAX, (1 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_sub_i16(i16_min(), (1 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_mul_i16(I16_MAX, (2 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_mul_i16(i16_min(), (-1 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_div_i16((1 to i16), (0 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_div_i16(i16_min(), (-1 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_rem_i16((1 to i16), (0 to i16))))
    teko::assert::is_true(chk_is_err_i16(checked_neg_i16(i16_min())))
    teko::assert::is_true(chk_unwrap_i16(checked_rem_i16(i16_min(), (-1 to i16))) == (0 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_add_i16(i16_min(), I16_MAX)) == (-1 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_mul_i16((-1 to i16), (10 to i16))) == (-10 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_div_i16(i16_min(), (2 to i16))) == i16_min() / (2 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_neg_i16(I16_MAX)) == i16_min() + (1 to i16))
}

/**
 * `wrapping_*` on `i16` wraps two's-complement: MAX+1 -> MIN, MIN-1 -> MAX, MAX*2 -> -2, neg(MIN) -> MIN; happy paths total.
 */
#test
fn wrapping_i16_wraps() {
    teko::assert::is_true(wrapping_add_i16(I16_MAX, (1 to i16)) == i16_min())
    teko::assert::is_true(wrapping_sub_i16(i16_min(), (1 to i16)) == I16_MAX)
    teko::assert::is_true(wrapping_mul_i16(I16_MAX, (2 to i16)) == (-2 to i16))
    teko::assert::is_true(wrapping_neg_i16(i16_min()) == i16_min())
    teko::assert::is_true(wrapping_neg_i16((5 to i16)) == (-5 to i16))
    teko::assert::is_true(wrapping_add_i16((100 to i16), (23 to i16)) == (123 to i16))
    teko::assert::is_true(wrapping_mul_i16((-1 to i16), (-1 to i16)) == (1 to i16))
    teko::assert::is_true(wrapping_sub_i16((10 to i16), (30 to i16)) == (-20 to i16))
}

/**
 * `saturating_*` on `i16` clamps to MAX on positive overflow and MIN on negative overflow (sign-directed); happy inputs pass through.
 */
#test
fn saturating_i16_clamps() {
    teko::assert::is_true(saturating_add_i16(I16_MAX, (1 to i16)) == I16_MAX)
    teko::assert::is_true(saturating_add_i16(i16_min(), (-1 to i16)) == i16_min())
    teko::assert::is_true(saturating_sub_i16(i16_min(), (1 to i16)) == i16_min())
    teko::assert::is_true(saturating_sub_i16(I16_MAX, (-1 to i16)) == I16_MAX)
    teko::assert::is_true(saturating_mul_i16(I16_MAX, (2 to i16)) == I16_MAX)
    teko::assert::is_true(saturating_mul_i16(i16_min(), (2 to i16)) == i16_min())
    teko::assert::is_true(saturating_mul_i16(i16_min(), (-1 to i16)) == I16_MAX)
    teko::assert::is_true(saturating_add_i16((2 to i16), (3 to i16)) == (5 to i16))
}

/**
 * Shift edges on `i16`: `checked_shl/shr` error at count = width; `wrapping_shl/shr` mask the count `mod 16` (the #49/#61 regression).
 */
#test
fn shift_i16_edges() {
    teko::assert::is_true(chk_is_err_i16(checked_shl_i16((1 to i16), 16)))
    teko::assert::is_true(chk_is_err_i16(checked_shr_i16((1 to i16), 16)))
    teko::assert::is_true(chk_unwrap_i16(checked_shl_i16((1 to i16), 1)) == (2 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_shr_i16((4 to i16), 1)) == (2 to i16))
    teko::assert::is_true(wrapping_shl_i16((1 to i16), 16) == wrapping_shl_i16((1 to i16), 0))
    teko::assert::is_true(wrapping_shr_i16((4 to i16), 16) == wrapping_shr_i16((4 to i16), 0))
    teko::assert::is_true(wrapping_shl_i16((1 to i16), 2) == (4 to i16))
}

/**
 * `checked_pow` on `i16`: exact powers (incl. a negative base), `x^0 == 1`, overflow -> error.
 */
#test
fn pow_i16_cases() {
    teko::assert::is_true(chk_unwrap_i16(checked_pow_i16((2 to i16), 3)) == (8 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_pow_i16((-2 to i16), 3)) == (-8 to i16))
    teko::assert::is_true(chk_unwrap_i16(checked_pow_i16((5 to i16), 0)) == (1 to i16))
    teko::assert::is_true(chk_is_err_i16(checked_pow_i16(I16_MAX, 2)))
}

