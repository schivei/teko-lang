/**
 * `checked_*` on `u16` reports overflow / underflow / div-by-zero / unsigned-neg as errors, never a panic; happy paths return the value.
 */
#test
fn checked_u16_edges() {
    teko::assert::is_true(chk_is_err_u16(checked_add_u16(U16_MAX, (1 to u16))))
    teko::assert::is_true(chk_is_err_u16(checked_sub_u16(U16_MIN, (1 to u16))))
    teko::assert::is_true(chk_is_err_u16(checked_mul_u16(U16_MAX, (2 to u16))))
    teko::assert::is_true(chk_is_err_u16(checked_div_u16((1 to u16), U16_MIN)))
    teko::assert::is_true(chk_is_err_u16(checked_rem_u16((1 to u16), U16_MIN)))
    teko::assert::is_true(chk_is_err_u16(checked_neg_u16((1 to u16))))
    teko::assert::is_true(chk_unwrap_u16(checked_add_u16(U16_MAX, U16_MIN)) == U16_MAX)
    teko::assert::is_true(chk_unwrap_u16(checked_sub_u16(U16_MAX, (1 to u16))) == U16_MAX - (1 to u16))
    teko::assert::is_true(chk_unwrap_u16(checked_mul_u16(U16_MAX, (1 to u16))) == U16_MAX)
    teko::assert::is_true(chk_unwrap_u16(checked_div_u16(U16_MAX, (1 to u16))) == U16_MAX)
    teko::assert::is_true(chk_unwrap_u16(checked_rem_u16(U16_MAX, (2 to u16))) == (1 to u16))
    teko::assert::is_true(chk_unwrap_u16(checked_neg_u16(U16_MIN)) == U16_MIN)
}

/**
 * `wrapping_*` on `u16` wraps modulo 2^16: MAX+1 -> 0, 0-1 -> MAX, MAX*2 -> MAX-1; and totality on happy inputs.
 */
#test
fn wrapping_u16_wraps() {
    teko::assert::is_true(wrapping_add_u16(U16_MAX, (1 to u16)) == U16_MIN)
    teko::assert::is_true(wrapping_sub_u16(U16_MIN, (1 to u16)) == U16_MAX)
    teko::assert::is_true(wrapping_mul_u16(U16_MAX, (2 to u16)) == U16_MAX - (1 to u16))
    teko::assert::is_true(wrapping_neg_u16(U16_MIN) == U16_MIN)
    teko::assert::is_true(wrapping_neg_u16((1 to u16)) == U16_MAX)
    teko::assert::is_true(wrapping_add_u16((2 to u16), (1 to u16)) == (3 to u16))
    teko::assert::is_true(wrapping_mul_u16((3 to u16), (2 to u16)) == (6 to u16))
}

/**
 * `saturating_*` on `u16` clamps to MAX on overflow and 0 on underflow; happy inputs pass through unchanged.
 */
#test
fn saturating_u16_clamps() {
    teko::assert::is_true(saturating_add_u16(U16_MAX, (1 to u16)) == U16_MAX)
    teko::assert::is_true(saturating_sub_u16(U16_MIN, (1 to u16)) == U16_MIN)
    teko::assert::is_true(saturating_mul_u16(U16_MAX, (2 to u16)) == U16_MAX)
    teko::assert::is_true(saturating_add_u16((2 to u16), (1 to u16)) == (3 to u16))
    teko::assert::is_true(saturating_sub_u16((5 to u16), (2 to u16)) == (3 to u16))
}

/**
 * Shift edges on `u16`: `checked_shl/shr` error when the count reaches the width; `wrapping_shl/shr` mask the count `mod 16` (the #49/#61 regression) and never trap.
 */
#test
fn shift_u16_edges() {
    teko::assert::is_true(chk_is_err_u16(checked_shl_u16((1 to u16), 16)))
    teko::assert::is_true(chk_is_err_u16(checked_shr_u16((1 to u16), 16)))
    teko::assert::is_true(chk_unwrap_u16(checked_shl_u16((1 to u16), 1)) == (2 to u16))
    teko::assert::is_true(chk_unwrap_u16(checked_shr_u16((2 to u16), 1)) == (1 to u16))
    teko::assert::is_true(wrapping_shl_u16((1 to u16), 16) == wrapping_shl_u16((1 to u16), 0))
    teko::assert::is_true(wrapping_shr_u16((2 to u16), 16) == wrapping_shr_u16((2 to u16), 0))
    teko::assert::is_true(wrapping_shl_u16((1 to u16), 1) == (2 to u16))
}

/**
 * `checked_pow` on `u16`: exact powers, `x^0 == 1`, and overflow -> error.
 */
#test
fn pow_u16_cases() {
    teko::assert::is_true(chk_unwrap_u16(checked_pow_u16((2 to u16), 3)) == (8 to u16))
    teko::assert::is_true(chk_unwrap_u16(checked_pow_u16((5 to u16), 0)) == (1 to u16))
    teko::assert::is_true(chk_is_err_u16(checked_pow_u16(U16_MAX, 2)))
}

