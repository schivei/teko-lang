/**
 * Reinterpret `a: i32` as its two's-complement bit pattern typed `u32`.
 *
 * Non-negative `a` maps directly. For negative `a`, `a - i32::MIN` lands in
 * `[0, 2^31 - 1]` (in range — no trapping cast, no signed overflow); adding the
 * sign bit `2^31` in the `u32` domain reconstructs `a + 2^32`, the two's-complement
 * pattern.
 *
 * @param a  the signed value to reinterpret
 * @return      the `u32` whose bits equal `a`'s two's-complement encoding
 */
fn u32_bits_of_i32(a: i32) -> u32 {
    if a >= 0 { return a to u32 }
    (a - i32_min()) to u32 + ((1 to u32) << 31)
}

/**
 * Reinterpret a `u32` bit pattern `u` as the `i32` it two's-complement encodes — the inverse of `u32_bits_of_i32`.
 *
 * Sign bit clear (`u < 2^31`) maps directly. Otherwise `u - 2^31` is in
 * `[0, 2^31 - 1]` (in range), and adding `i32::MIN` yields `u - 2^32`, the signed
 * interpretation of a set sign bit.
 *
 * @param u  the `u32` bit pattern to reinterpret
 * @return      the `i32` two's-complement-encoded by `u`
 */
fn i32_from_u32_bits(u: u32) -> i32 {
    if u < ((1 to u32) << 31) { return u to i32 }
    (u - ((1 to u32) << 31)) to i32 + i32_min()
}
