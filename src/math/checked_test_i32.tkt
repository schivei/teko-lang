/**
 * `math::checked_i32` test suite — i32-specific tests for teko::math::checked (M1).
 * Signed overflow, MIN/-1 edges, wrapping, saturation, shifts, and power operations on i32.
 */
fn chk_unwrap_i32(r: i32 | error) -> i32 {
    match r {
        i32 as v => v
        error => { teko::assert::is_true(false); (0 to i32) }
    }
}

/**
 * True iff a `i32 | error` carries the error arm — the error-path predicate.
 */
fn chk_is_err_i32(r: i32 | error) -> bool {
    match r { i32 => false; error => true }
}

/**
 * Unwrap a `i64 | error` for a happy-path assertion; a surprise `error` fails the test.
 */

fn checked_i32_edges() {
    teko::assert::is_true(chk_is_err_i32(checked_add_i32(I32_MAX, (1 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_sub_i32(i32_min(), (1 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_mul_i32(I32_MAX, (2 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_mul_i32(i32_min(), (-1 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_div_i32((1 to i32), (0 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_div_i32(i32_min(), (-1 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_rem_i32((1 to i32), (0 to i32))))
    teko::assert::is_true(chk_is_err_i32(checked_neg_i32(i32_min())))
    teko::assert::is_true(chk_unwrap_i32(checked_rem_i32(i32_min(), (-1 to i32))) == (0 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_add_i32(i32_min(), I32_MAX)) == (-1 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_mul_i32((-1 to i32), (10 to i32))) == (-10 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_div_i32(i32_min(), (2 to i32))) == i32_min() / (2 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_neg_i32(I32_MAX)) == i32_min() + (1 to i32))
}

/**
 * `wrapping_*` on `i32` wraps two's-complement: MAX+1 -> MIN, MIN-1 -> MAX, MAX*2 -> -2, neg(MIN) -> MIN; happy paths total.
 */
#test
fn wrapping_i32_wraps() {
    teko::assert::is_true(wrapping_add_i32(I32_MAX, (1 to i32)) == i32_min())
    teko::assert::is_true(wrapping_sub_i32(i32_min(), (1 to i32)) == I32_MAX)
    teko::assert::is_true(wrapping_mul_i32(I32_MAX, (2 to i32)) == (-2 to i32))
    teko::assert::is_true(wrapping_neg_i32(i32_min()) == i32_min())
    teko::assert::is_true(wrapping_neg_i32((5 to i32)) == (-5 to i32))
    teko::assert::is_true(wrapping_add_i32((100 to i32), (23 to i32)) == (123 to i32))
    teko::assert::is_true(wrapping_mul_i32((-1 to i32), (-1 to i32)) == (1 to i32))
    teko::assert::is_true(wrapping_sub_i32((10 to i32), (30 to i32)) == (-20 to i32))
}

/**
 * `saturating_*` on `i32` clamps to MAX on positive overflow and MIN on negative overflow (sign-directed); happy inputs pass through.
 */
#test
fn saturating_i32_clamps() {
    teko::assert::is_true(saturating_add_i32(I32_MAX, (1 to i32)) == I32_MAX)
    teko::assert::is_true(saturating_add_i32(i32_min(), (-1 to i32)) == i32_min())
    teko::assert::is_true(saturating_sub_i32(i32_min(), (1 to i32)) == i32_min())
    teko::assert::is_true(saturating_sub_i32(I32_MAX, (-1 to i32)) == I32_MAX)
    teko::assert::is_true(saturating_mul_i32(I32_MAX, (2 to i32)) == I32_MAX)
    teko::assert::is_true(saturating_mul_i32(i32_min(), (2 to i32)) == i32_min())
    teko::assert::is_true(saturating_mul_i32(i32_min(), (-1 to i32)) == I32_MAX)
    teko::assert::is_true(saturating_add_i32((2 to i32), (3 to i32)) == (5 to i32))
}

/**
 * Shift edges on `i32`: `checked_shl/shr` error at count = width; `wrapping_shl/shr` mask the count `mod 32` (the #49/#61 regression).
 */
#test
fn shift_i32_edges() {
    teko::assert::is_true(chk_is_err_i32(checked_shl_i32((1 to i32), 32)))
    teko::assert::is_true(chk_is_err_i32(checked_shr_i32((1 to i32), 32)))
    teko::assert::is_true(chk_unwrap_i32(checked_shl_i32((1 to i32), 1)) == (2 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_shr_i32((4 to i32), 1)) == (2 to i32))
    teko::assert::is_true(wrapping_shl_i32((1 to i32), 32) == wrapping_shl_i32((1 to i32), 0))
    teko::assert::is_true(wrapping_shr_i32((4 to i32), 32) == wrapping_shr_i32((4 to i32), 0))
    teko::assert::is_true(wrapping_shl_i32((1 to i32), 2) == (4 to i32))
}

/**
 * `checked_pow` on `i32`: exact powers (incl. a negative base), `x^0 == 1`, overflow -> error.
 */
#test
fn pow_i32_cases() {
    teko::assert::is_true(chk_unwrap_i32(checked_pow_i32((2 to i32), 3)) == (8 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_pow_i32((-2 to i32), 3)) == (-8 to i32))
    teko::assert::is_true(chk_unwrap_i32(checked_pow_i32((5 to i32), 0)) == (1 to i32))
    teko::assert::is_true(chk_is_err_i32(checked_pow_i32(I32_MAX, 2)))
}

/**
 * `checked_*` on `i64` reports overflow / div-by-zero / MIN-neg / MIN-over--1 as errors; happy paths (incl. negatives) return the value.
 */
#test
