/**
 * `EXPONENT_MASK` — the IEEE-754 binary64 exponent field (bits 62..52, 11
 * bits; all-ones = `0x7FF` marks inf/nan).
 */
const EXPONENT_MASK: u64 = 0x7FF0000000000000

/**
 * `MANTISSA_MASK` — the IEEE-754 binary64 mantissa field (bits 51..0, 52
 * bits; zero mantissa + all-ones exponent = infinity, nonzero mantissa +
 * all-ones exponent = NaN).
 */
const MANTISSA_MASK: u64 = 0x000FFFFFFFFFFFFF

/**
 * `SIGN_MASK` — the IEEE-754 binary64 sign bit (bit 63).
 */
const SIGN_MASK: u64 = 0x8000000000000000
