/**
 * `math::checked constants` — shared constants for the `teko::math::checked` (M1) unit.
 * These constants define the MIN/MAX values for all integer widths (u8/u16/u32/u64, i8/i16/i32/i64).
 */
pub const U8_MIN: u8 = 0 to u8

/**
 * `u8::MAX` (2^8 - 1), constructed as `~0` (all bits set) — one uniform,
 * width-agnostic form for every unsigned ceiling.
 */
pub const U8_MAX: u8 = ~(0 to u8)

pub const U16_MIN: u16 = 0 to u16

/**
 * `u16::MAX` (2^16 - 1), constructed as `~0` (all bits set) — one uniform,
 * width-agnostic form for every unsigned ceiling.
 */
pub const U16_MAX: u16 = ~(0 to u16)

pub const U32_MIN: u32 = 0 to u32

/**
 * `u32::MAX` (2^32 - 1), constructed as `~0` (all bits set) — one uniform,
 * width-agnostic form for every unsigned ceiling.
 */
pub const U32_MAX: u32 = ~(0 to u32)

pub const U64_MIN: u64 = 0 to u64

/**
 * `u64::MAX` (2^64 - 1), constructed as `~0` (all bits set) — one uniform,
 * width-agnostic form for every unsigned ceiling.
 */
pub const U64_MAX: u64 = ~(0 to u64)

pub const I8_MAX: i8 = 127

pub const I16_MAX: i16 = 32767

pub const I32_MAX: i32 = 2147483647

pub const I64_MAX: i64 = 9223372036854775807

