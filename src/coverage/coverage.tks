use teko::checker
use teko::parser

/**
 * A branch-coverage SITE — one `if` (2 outcomes: then/else) or `match` (arms.len outcomes)
 * in a walked production-function body. The native run marks the taken outcome of each site
 * (cov_branch); the report statically enumerates every site and queries cov_branch_hit per
 * outcome to derive taken/total. Formerly part of the retired interpreter; the walk is engine-independent.
 */
type BranchSite = struct {
    /**
     * The 1-based source line of the branching expression.
     */
    line: u32
    /**
     * The source column of the branching expression (disambiguates two sites on one line).
     */
    col: u32
    /**
     * The number of outcomes: 2 for an `if`, `arms.len` for a `match`.
     */
    n: u64
}

/**
 * The accumulated coverage walk over one function: the branch SITES it contains plus the set of
 * DISTINCT executable source lines it touches. One walk feeds the line metric, the branch metric,
 * and the Cobertura `<line>` elements.
 */
type CovWalk = struct {
    /**
     * The branch sites (if/match) discovered in walk order.
     */
    sites: []BranchSite
    /**
     * The distinct executable source lines discovered in walk order.
     */
    lines: []u32
}

/**
 * Construct an empty coverage-walk accumulator (no sites, no lines).
 *
 * @return  a `CovWalk` with empty `sites` and `lines`
 */
fn cov_walk_empty() -> CovWalk { CovWalk { sites = teko::list::empty(); lines = teko::list::empty() } }

/**
 * Add `line` to the walk's distinct-line set. Line 0 (unpositioned) is skipped; a function has few
 * lines, so linear dedup is adequate.
 *
 * @param w     the accumulated coverage-walk state
 * @param line  the source line to register (0 = ignore)
 * @return      `w` with `line` present in its distinct-line set
 */
fn cov_addline(w: CovWalk, line: u32) -> CovWalk {
    if line == 0 { return w }
    mut i = 0
    loop { if i >= w.lines.len { break }; if w.lines[i] == line { return w }; i = i + 1 }
    CovWalk { sites = w.sites; lines = teko::list::push(w.lines, line) }
}

/**
 * Append one branch site to the walk.
 *
 * @param w     the accumulated coverage-walk state
 * @param line  the branching expression's source line
 * @param col   the branching expression's source column
 * @param n     the number of outcomes (2 for `if`, arms.len for `match`)
 * @return      `w` with the new `BranchSite` pushed onto `sites`
 */
fn cov_addsite(w: CovWalk, line: u32, col: u32, n: u64) -> CovWalk {
    CovWalk { sites = teko::list::push(w.sites, BranchSite { line = line; col = col; n = n }); lines = w.lines }
}

/**
 * Recurse an EXPR, collecting its source line (line coverage) and every nested if/match site
 * (branch coverage) into `w`. ONE walk feeds both the line and branch metrics and the Cobertura
 * report. Leaves (number/var/strlit/bytelit/boollit/nulllit/pathexpr) add only their own line.
 *
 * @param e  the expression to walk
 * @param w  the accumulated coverage-walk state
 * @return   `w` with every reachable line/branch site this expression contributes registered
 */
fn cov_walk_expr(e: checker::TExpr, w: CovWalk) -> CovWalk {
    let w0 = cov_addline(w, e.line)
    match e.kind {
        checker::TIfExpr as f => {
            let a1 = cov_addsite(w0, e.line, e.col, 2)
            let a2 = cov_walk_expr(f.cond, a1)
            let a3 = cov_walk_block(f.then_blk, a2)
            if f.has_else { cov_walk_block(f.else_blk, a3) } else { a3 }
        }
        checker::TMatchExpr as m => {
            let a1 = cov_addsite(w0, e.line, e.col, m.arms.len)
            mut a = cov_walk_expr(m.subject, a1)
            mut i = 0
            loop {
                if i >= m.arms.len { break }
                if m.arms[i].has_when { a = cov_walk_expr(m.arms[i].guard, a) }
                a = cov_walk_block(m.arms[i].body, a)
                i++
            }
            a
        }
        checker::TBinary as b => cov_walk_expr(b.right, cov_walk_expr(b.left, w0))
        checker::TUnary as u => cov_walk_expr(u.operand, w0)
        checker::TCompare as c => {
            mut a = cov_walk_expr(c.first, w0)
            mut i = 0
            loop { if i >= c.rest.len { break }; a = cov_walk_expr(c.rest[i].operand, a); i++ }
            a
        }
        checker::TCall as c => {
            mut a = w0
            mut i = 0
            loop { if i >= c.args.len { break }; a = cov_walk_expr(c.args[i], a); i++ }
            a
        }
        checker::TCast as c => cov_walk_expr(c.expr, w0)
        checker::TFieldAccess as fa => cov_walk_expr(fa.receiver, w0)
        checker::TIndex as ix => cov_walk_expr(ix.index, cov_walk_expr(ix.receiver, w0))
        checker::TStructInit as si => {
            mut a = w0
            mut i = 0
            loop { if i >= si.field_vals.len { break }; a = cov_walk_expr(si.field_vals[i], a); i++ }
            a
        }
        checker::TInterp as in => {
            mut a = w0
            mut i = 0
            loop {
                if i >= in.holes.len { break }
                a = cov_walk_expr(in.holes[i], a)
                if i < in.specs.len {
                    match in.specs[i].kind {
                        checker::TFSpecDynamic as fd => {
                            mut k = 0
                            loop { if k >= fd.args.len { break }; a = cov_walk_expr(fd.args[k], a); k++ }
                        }
                        _ => { }
                    }
                }
                i++
            }
            a
        }
        checker::TInExpr as ie => {
            mut a = cov_walk_expr(ie.lhs, w0)
            mut i = 0
            loop { if i >= ie.elems.len { break }; a = cov_walk_expr(ie.elems[i], a); i++ }
            a
        }
        checker::TArrayLit as al => {
            mut a = w0
            mut i = 0
            loop { if i >= al.elements.len { break }; a = cov_walk_expr(al.elements[i].expr, a); i++ }
            a
        }
        _ => w0
    }
}

/**
 * The static full-program coverage-line pre-registration walk over ONE statement, mirroring the
 * set of lines native codegen marks inline as it emits each statement (`emit_cov_lines`/
 * `stmt_cov_lines`). `TLoopStmt` and `TAdoptStmt` both descend into their body via `cov_walk_block`
 * — native emits every body statement through `emit_stmt` too (for `adopt`, via `emit_adopt` ->
 * `emit_block`), so both bodies must be walked here for native parity. A field-assignment's LHS
 * receiver (#88) is executable too, so it is walked as well. `TDeferStmt`/`TBreakStmt`/
 * `TContinueStmt` carry no directly-walked expression of their own.
 *
 * @param s  the statement to walk
 * @param w  the accumulated coverage-walk state
 * @return   `w` with every reachable line/branch site this statement contributes registered
 */
fn cov_walk_stmt(s: checker::TStatement, w: CovWalk) -> CovWalk {
    match s {
        checker::TBinding as b => cov_walk_expr(b.value, w)
        checker::TAssign as a => { let w2 = cov_walk_expr(a.value, w); if parser::assign_has_target(a.kind) { cov_walk_expr(a.target, w2) } else { w2 } }
        checker::TReturn as r => if r.has_value { cov_walk_expr(r.value, w) } else { w }
        checker::TLoopStmt as l => cov_walk_block(l.body, cov_walk_block(l.init, w))
        checker::TExprStmt as x => cov_walk_expr(x.expr, w)
        checker::TAdoptStmt as ad => cov_walk_block(ad.body, w)
        _ => w
    }
}

/**
 * Walk every statement of a block, threading the coverage-walk accumulator through in order.
 *
 * @param stmts  the block's statements
 * @param w      the accumulated coverage-walk state
 * @return       `w` with the whole block's lines/branch sites registered
 */
fn cov_walk_block(stmts: []checker::TStatement, w: CovWalk) -> CovWalk {
    mut a = w
    mut i = 0
    loop { if i >= stmts.len { break }; a = cov_walk_stmt(stmts[i], a); i++ }
    a
}

/**
 * Format a Cobertura rate decimal ("0.000".."1.0") from covered/total. A zero denominator is
 * vacuously "1.0"; a full or over-full ratio clamps to "1.0"; otherwise the three-digit
 * per-mille fraction is zero-padded.
 *
 * @param cov  the covered count (numerator)
 * @param val  the total count (denominator)
 * @return     the rate as a Cobertura decimal string
 */
fn cov_rate_str(cov: u64, val: u64) -> str {
    if val == 0 { return "1.0" }
    let m = cov * 1000 / val
    if m >= 1000 { return "1.0" }
    mut fs = teko::str::u64_to_str(m)
    loop { if fs.len >= 3 { break }; fs = teko::str::concat("0", fs) }
    teko::str::concat("0.", fs)
}

/**
 * Branch taken/total over the sites that sit on one source line (a line may host more than one
 * if/match).
 */
type LineBr = struct {
    /**
     * The number of taken outcomes across this line's sites.
     */
    taken: u64
    /**
     * The total number of outcomes across this line's sites.
     */
    total: u64
}

/**
 * Tally the branch taken/total for the sites on a single source line of one function.
 *
 * @param sites   the function's walked branch sites
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @param ln      the source line whose sites are tallied
 * @return        a `LineBr` with the taken and total outcome counts on `ln`
 */
fn cov_line_branch(sites: []BranchSite, fn_idx: u64, ln: u32) -> LineBr {
    mut taken: u64 = 0; mut total: u64 = 0
    mut s = 0
    loop {
        if s >= sites.len { break }
        if sites[s].line == ln {
            mut o: u64 = 0
            loop { if o >= sites[s].n { break }; if teko::cov_branch_hit(fn_idx, sites[s].line, sites[s].col, o) { taken = taken + 1 }; o = o + 1 }
            total = total + sites[s].n
        }
        s = s + 1
    }
    LineBr { taken = taken; total = total }
}

/**
 * Tally one production function's LINE coverage: how many of its distinct executable lines were
 * hit versus how many exist. The denominator is the walk's `lines.len`; the numerator counts the
 * lines for which `cov_line_hit` is true for this function index.
 *
 * @param w       the function's walked coverage sites and distinct executable lines
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @return        a CovCount whose `cov` is the hit-line count and `val` the total line count
 */
fn cov_fn_line_tally(w: CovWalk, fn_idx: u64) -> CovCount {
    mut cov: u64 = 0
    mut k = 0
    loop {
        if k >= w.lines.len { break }
        if teko::cov_line_hit(fn_idx, w.lines[k]) { cov = cov + 1 }
        k = k + 1
    }
    CovCount { cov = cov; val = w.lines.len }
}

/**
 * Tally one production function's BRANCH coverage: how many condition outcomes were taken versus
 * how many outcomes exist across every if/match site in the function.
 *
 * @param w       the function's walked coverage sites and distinct executable lines
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @return        a CovCount whose `cov` is the taken-outcome count and `val` the total outcomes
 */
fn cov_fn_branch_tally(w: CovWalk, fn_idx: u64) -> CovCount {
    mut cov: u64 = 0
    mut val: u64 = 0
    mut s = 0
    loop {
        if s >= w.sites.len { break }
        mut o: u64 = 0
        loop {
            if o >= w.sites[s].n { break }
            if teko::cov_branch_hit(fn_idx, w.sites[s].line, w.sites[s].col, o) { cov = cov + 1 }
            o = o + 1
        }
        val = val + w.sites[s].n
        s = s + 1
    }
    CovCount { cov = cov; val = val }
}

/**
 * Append one Cobertura `<line …/>` element per distinct executable line of a production function
 * onto the copy-grow byte buffer, in walk order. A line that hosts an if/match additionally
 * carries its condition-coverage percentage. The buffer is threaded linearly (append_fo frees the
 * superseded backing on grow), so accumulation stays O(total) rather than the O(N²) retention that
 * repeated `str::concat` would incur.
 *
 * @param buf     the copy-grow byte buffer being built
 * @param w       the function's walked coverage sites and distinct executable lines
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @return        the buffer with this function's `<line>` elements appended
 */
fn cov_emit_lines(buf: []byte, w: CovWalk, fn_idx: u64) -> []byte {
    mut b = buf
    mut k = 0
    loop {
        if k >= w.lines.len { break }
        let ln = w.lines[k]
        let lhit: u64 = if teko::cov_line_hit(fn_idx, ln) { 1 to u64 } else { 0 to u64 }
        let lb = cov_line_branch(w.sites, fn_idx, ln)
        if lb.total > 0 {
            let pct = lb.taken * 100 / lb.total
            b = teko::mem::append_fo(b, $"          <line number='{ln}' hits='{lhit}' branch='true' condition-coverage='{pct}% ({lb.taken}/{lb.total})'/>\n")
        } else {
            b = teko::mem::append_fo(b, $"          <line number='{ln}' hits='{lhit}'/>\n")
        }
        k = k + 1
    }
    b
}

/**
 * Append one production function's complete Cobertura `<class>` block onto the copy-grow byte
 * buffer: the class header (line/branch rates from the supplied tallies), its single-method
 * `<methods>` summary, and its `<lines>` (via cov_emit_lines). Attributes are single-quoted (valid
 * XML) so no `"`-escaping is needed. The class name is namespace-qualified when the function has a
 * namespace, otherwise the bare name.
 *
 * @param buf     the copy-grow byte buffer being built
 * @param f       the production function whose class block is emitted
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @param w       the function's walked coverage sites and distinct executable lines
 * @param lt      the function's line tally (cov = hit lines, val = total lines)
 * @param bt      the function's branch tally (cov = taken outcomes, val = total outcomes)
 * @param fnhit   1 when the function itself was executed at least once, else 0
 * @return        the buffer with this function's `<class>` block appended
 */
fn cov_emit_class(buf: []byte, f: checker::TFunction, fn_idx: u64, w: CovWalk, lt: CovCount, bt: CovCount, fnhit: u64) -> []byte {
    cov_emit_class_fields(buf, cov_class_name(f.namespace, f.name), f.file, f.name, f.line, fn_idx, w, lt, bt, fnhit)
}

/**
 * The namespace-qualified Cobertura class name for a function: `namespace::name` when the function
 * has a namespace, else the bare name. Extracted so the AST-walk renderer (`cov_emit_class`) and
 * the site-map renderer (`cov_emit_class_fields` via `cov_cobertura_of`) qualify the name the SAME
 * way and emit byte-identical XML.
 *
 * @param namespace  the function's namespace ("" when it has none)
 * @param name       the function's bare name
 * @return           `namespace::name`, or `name` when the namespace is empty
 */
fn cov_class_name(namespace: str, name: str) -> str {
    if namespace.len != 0 { teko::str::concat(namespace, "::", name) } else { name }
}

/**
 * Append one production function's complete Cobertura `<class>` block onto the copy-grow byte buffer
 * from its ALREADY-RESOLVED identity fields and walk. The field-level twin of `cov_emit_class`: it
 * takes the class name, filename, method name and method line directly rather than reading them off
 * a `checker::TFunction`, so the site-map report path (which has no typed program) renders exactly
 * the XML the AST-walk path renders. Attributes are single-quoted (valid XML) so no `"`-escaping is
 * needed.
 *
 * @param buf     the copy-grow byte buffer being built
 * @param cname   the namespace-qualified class name (from `cov_class_name`)
 * @param file    the source file the class reports under
 * @param mname   the method (function) name for the `<methods>` summary
 * @param mline   the function's own source line (the method's single `<line>` element)
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @param w       the function's walked coverage sites and distinct executable lines
 * @param lt      the function's line tally (cov = hit lines, val = total lines)
 * @param bt      the function's branch tally (cov = taken outcomes, val = total outcomes)
 * @param fnhit   1 when the function itself was executed at least once, else 0
 * @return        the buffer with this function's `<class>` block appended
 */
fn cov_emit_class_fields(buf: []byte, cname: str, file: str, mname: str, mline: u32, fn_idx: u64, w: CovWalk, lt: CovCount, bt: CovCount, fnhit: u64) -> []byte {
    let lrate = cov_rate_str(lt.cov, lt.val)
    let brate = cov_rate_str(bt.cov, bt.val)
    mut b = teko::mem::append_fo(buf, $"      <class name='{cname}' filename='{file}' line-rate='{lrate}' branch-rate='{brate}' complexity='0'>\n")
    b = teko::mem::append_fo(b, $"        <methods><method name='{mname}' signature='()V' line-rate='{lrate}' branch-rate='{brate}'><lines><line number='{mline}' hits='{fnhit}'/></lines></method></methods>\n")
    b = teko::mem::append_fo(b, "        <lines>\n")
    b = cov_emit_lines(b, w, fn_idx)
    teko::mem::append_fo(b, "        </lines>\n      </class>\n")
}

/**
 * Build a Cobertura XML coverage report from the LAST run's marks — one `<class>` per production
 * function (its filename is the function's source file). Each class's `<lines>` are the real
 * executable lines (every line with an evaluated expression, hit via cov_line_hit); a line that
 * hosts an if/match also carries its branch condition-coverage. The coverage machinery itself
 * (`teko::coverage`) is self-excluded, exactly as the retired interpreter was, so the report never measures
 * its own reporting code.
 *
 * The whole report accumulates into a copy-grow `[]byte` buffer via teko::mem::append_fo (the
 * codegen's emitter mechanism): each append frees the superseded backing on grow, so the report
 * costs O(final-size) memory instead of the O(N²) arena retention that repeated str::concat
 * incurred — every intermediate prefix stayed live, ballooning to tens of GB on the compiler
 * itself (#468). The `body` buffer holds every class, then the header/footer (which need the
 * whole-program aggregate rates) wrap it into `out`, converted to a str exactly once at return.
 *
 * @param prog  the fully-typed program whose production functions are reported
 * @return      the complete Cobertura XML document as a str
 */
exp fn cov_cobertura(prog: checker::TProgram) -> str {
    mut body: []byte = teko::list::empty()
    mut agg = CovAgg { lines_cov = 0; lines_val = 0; br_cov = 0; br_val = 0 }
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    let w = cov_walk_block(f.body, cov_walk_empty())
                    let r = cov_render_class(body, cov_class_name(f.namespace, f.name), f.file, f.name, f.line, i to u64, w)
                    body = r.body
                    agg = cov_agg_add(agg, r.lt, r.bt)
                }
            }
            _ => { }
        }
        i++
    }
    cov_cobertura_wrap(body, agg)
}

/**
 * The running whole-program coverage totals a Cobertura render accumulates across its classes: the
 * covered/total line counts and the taken/total branch outcomes that the document's header rates
 * are computed from. Threaded through the class loop so the AST-walk path (`cov_cobertura`) and the
 * site-map path (`cov_cobertura_of`) accumulate identically.
 */
type CovAgg = struct {
    /** the covered executable-line count summed over every class so far. */
    lines_cov: u64
    /** the total executable-line count summed over every class so far. */
    lines_val: u64
    /** the taken branch-outcome count summed over every class so far. */
    br_cov: u64
    /** the total branch-outcome count summed over every class so far. */
    br_val: u64
}

/**
 * Fold one class's line and branch tallies into the running whole-program aggregate.
 *
 * @param a   the aggregate so far
 * @param lt  the class's line tally (cov = hit lines, val = total lines)
 * @param bt  the class's branch tally (cov = taken outcomes, val = total outcomes)
 * @return    `a` with `lt`/`bt` added
 */
fn cov_agg_add(a: CovAgg, lt: CovCount, bt: CovCount) -> CovAgg {
    CovAgg { lines_cov = a.lines_cov + lt.cov; lines_val = a.lines_val + lt.val; br_cov = a.br_cov + bt.cov; br_val = a.br_val + bt.val }
}

/**
 * One rendered class plus the tallies it contributed — the return of `cov_render_class`, so the
 * caller both grows the body buffer and folds the class's line/branch counts into the aggregate
 * from a single computation of the walk.
 */
type CovClassRender = struct {
    /** the body buffer with this class's `<class>` block appended. */
    body: []byte
    /** the class's line tally (cov = hit lines, val = total lines). */
    lt: CovCount
    /** the class's branch tally (cov = taken outcomes, val = total outcomes). */
    bt: CovCount
}

/**
 * Render ONE production function's Cobertura `<class>` block AND compute its line/branch tallies in
 * one place, so the AST-walk path and the site-map path produce byte-identical XML and identical
 * aggregates. Reads the function's hit/line/branch marks from the coverage sink under `fn_idx` (the
 * program-item index the native run keyed its marks by).
 *
 * @param body    the copy-grow body buffer being built
 * @param cname   the namespace-qualified class name (from `cov_class_name`)
 * @param file    the source file the class reports under
 * @param mname   the method (function) name
 * @param mline   the function's own source line
 * @param fn_idx  the program-item index of the function (the coverage sink key)
 * @param w       the function's walked coverage sites and distinct executable lines
 * @return        the grown body plus the class's line and branch tallies
 */
fn cov_render_class(body: []byte, cname: str, file: str, mname: str, mline: u32, fn_idx: u64, w: CovWalk) -> CovClassRender {
    let lt = cov_fn_line_tally(w, fn_idx)
    let bt = cov_fn_branch_tally(w, fn_idx)
    let fnhit: u64 = if teko::cov_is_marked(fn_idx) { 1 to u64 } else { 0 to u64 }
    let b = cov_emit_class_fields(body, cname, file, mname, mline, fn_idx, w, lt, bt, fnhit)
    CovClassRender { body = b; lt = lt; bt = bt }
}

/**
 * Wrap the accumulated `<class>` body in the Cobertura document header and footer, computing the
 * whole-program line/branch rates from the aggregate. The single closer for both render paths, so a
 * report built from the site-map is byte-for-byte the report built from the typed program.
 *
 * @param body  the accumulated `<class>` blocks
 * @param agg   the whole-program line/branch aggregate
 * @return      the complete Cobertura XML document as a str
 */
fn cov_cobertura_wrap(body: []byte, agg: CovAgg) -> str {
    let lrate = cov_rate_str(agg.lines_cov, agg.lines_val)
    let brate = cov_rate_str(agg.br_cov, agg.br_val)
    mut out: []byte = teko::list::empty()
    out = teko::mem::append_fo(out, "<?xml version='1.0' ?>\n")
    out = teko::mem::append_fo(out, $"<coverage line-rate='{lrate}' branch-rate='{brate}' lines-covered='{agg.lines_cov}' lines-valid='{agg.lines_val}' branches-covered='{agg.br_cov}' branches-valid='{agg.br_val}' complexity='0' version='teko' timestamp='0'>\n")
    out = teko::mem::append_fo(out, "  <sources><source>.</source></sources>\n  <packages>\n")
    out = teko::mem::append_fo(out, $"    <package name='teko' line-rate='{lrate}' branch-rate='{brate}' complexity='0'>\n      <classes>\n")
    out = teko::mem::append_fo(out, str(body))
    out = teko::mem::append_fo(out, "      </classes>\n    </package>\n  </packages>\n</coverage>\n")
    str(out)
}

/**
 * Union a child test binary's dumped `.tkcov` into THIS process's coverage sinks, so the
 * engine-independent static walk (functions_coverage/line_coverage/branch_coverage) reads the
 * native gate's coverage exactly as it once read the interpreter's in-process marks. Backed by teko_rt.c's
 * `tk_cov_merge` (the #168 cross-process protocol).
 *
 * @param path  the child's dumped `.tkcov` file path
 * @return      true on a successful merge
 */
exp extern fn cov_merge(path: str) -> bool = "tk_cov_merge" from "teko_rt"

/**
 * A coverage count — covered / valid (numerator / denominator) for one metric. `cov_pct` rounds
 * DOWN; an empty denominator is vacuously 100% (no code → nothing to cover).
 */
type CovCount = struct {
    /**
     * The covered count (numerator).
     */
    cov: u64
    /**
     * The valid/total count (denominator).
     */
    val: u64
}

/**
 * The integer percentage of a coverage count, rounded down. An empty denominator is 100%.
 *
 * @param c  the covered/valid coverage count
 * @return   the percentage in [0, 100]
 */
fn cov_pct(c: CovCount) -> u64 { if c.val == 0 { 100 } else { c.cov * 100 / c.val } }

/**
 * The FUNCTIONS metric — distinct production functions executed over total production functions
 * (the cov-mark sink).
 *
 * @param prog  the fully-typed program
 * @return      a CovCount whose `cov` is distinct hit functions and `val` the production-fn total
 */
exp fn functions_coverage(prog: checker::TProgram) -> CovCount {
    CovCount { cov = teko::cov_distinct(); val = count_prod_fns(prog) }
}

/**
 * The LINES metric — distinct executable lines hit over total executable lines, aggregated across
 * every production function. The coverage machinery itself (`teko::coverage`) is self-excluded.
 *
 * @param prog  the fully-typed program
 * @return      a CovCount whose `cov` is hit lines and `val` the total executable lines
 */
exp fn line_coverage(prog: checker::TProgram) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    let w = cov_walk_block(f.body, cov_walk_empty())
                    mut k = 0
                    loop {
                        if k >= w.lines.len { break }
                        val = val + 1
                        if teko::cov_line_hit(i to u64, w.lines[k]) { cov = cov + 1 }
                        k = k + 1
                    }
                }
            }
            _ => { }
        }
        i++
    }
    CovCount { cov = cov; val = val }
}

/**
 * The BRANCHES metric — taken outcomes over total outcomes across every production function's
 * if/match sites. The coverage machinery itself (`teko::coverage`) is self-excluded.
 *
 * @param prog  the fully-typed program
 * @return      a CovCount whose `cov` is taken outcomes and `val` the total outcomes
 */
exp fn branch_coverage(prog: checker::TProgram) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    let w = cov_walk_block(f.body, cov_walk_empty())
                    mut s = 0
                    loop {
                        if s >= w.sites.len { break }
                        mut o: u64 = 0
                        loop {
                            if o >= w.sites[s].n { break }
                            if teko::cov_branch_hit(i to u64, w.sites[s].line, w.sites[s].col, o) { cov = cov + 1 }
                            o = o + 1
                        }
                        val = val + w.sites[s].n
                        s = s + 1
                    }
                }
            }
            _ => { }
        }
        i++
    }
    CovCount { cov = cov; val = val }
}

/**
 * The BRANCH-coverage percentage — the D4 gate's `branches` floor reads this.
 *
 * @param prog  the fully-typed program
 * @return      the branch-coverage percentage in [0, 100]
 */
exp fn branch_coverage_pct(prog: checker::TProgram) -> u64 { cov_pct(branch_coverage(prog)) }

/**
 * The LINE-coverage percentage — the D4 gate's `lines` floor reads this.
 *
 * @param prog  the fully-typed program
 * @return      the line-coverage percentage in [0, 100]
 */
exp fn line_coverage_pct(prog: checker::TProgram) -> u64 { cov_pct(line_coverage(prog)) }

/**
 * The coverage DENOMINATOR — the count of production (non-`#test`) functions. The coverage
 * machinery itself (`teko::coverage`) is excluded: those functions implement the report/walk and
 * only run under `--coverage`, so counting them would permanently depress the floors — the same
 * self-exclusion the retired interpreter carried.
 *
 * @param prog  the fully-typed program
 * @return      the number of production functions counted toward the floors
 */
fn count_prod_fns(prog: checker::TProgram) -> u64 {
    mut n: u64 = 0
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if !f.is_test && f.namespace != "teko::coverage" { n = n + 1 } }
            _ => { }
        }
        i++
    }
    n
}

/**
 * The FUNCTION-coverage percentage — the D4 gate's `functions` floor reads this. 100 when there
 * are no production functions (vacuously covered).
 *
 * @param prog  the fully-typed program
 * @return      the function-coverage percentage in [0, 100]
 */
exp fn coverage_pct(prog: checker::TProgram) -> u64 { cov_pct(functions_coverage(prog)) }

/**
 * SITEMAP_MAGIC — the first word of a serialized site-map blob, so a corrupt or foreign file is
 * rejected (and the report stage can fall back to a re-check) instead of being mis-parsed.
 *
 * @since 0.3.1
 */
const SITEMAP_MAGIC: str = "tksites"

/**
 * SITEMAP_VERSION — the serialized site-map layout version. Bumped only if the field order changes;
 * a reader that finds a different version rejects the blob.
 *
 * @since 0.3.1
 */
const SITEMAP_VERSION: u64 = 1

/**
 * SiteFn — ONE production function's coverage identity, frozen at build time so the report stage can
 * render its Cobertura `<class>` and tally its floors WITHOUT the typed program. It is exactly the
 * subset of `checker::TFunction` the coverage renderer reads (`fn_idx`, namespace, name, file,
 * `fn_line`) plus the `CovWalk` the build stage already computed by walking the body — the AST-walk
 * the report used to redo after re-checking the whole compiler (the ~3 GB peak C4 removes).
 *
 * @since 0.3.1
 */
type SiteFn = struct {
    /** the program-item index of the function — the coverage sink key the native run marked by. */
    fn_idx: u64
    /** the function's namespace ("" when it has none). */
    namespace: str
    /** the function's bare name. */
    name: str
    /** the source file the function lives in (the class's `filename`). */
    file: str
    /** the function's own 1-based source line (the method's single `<line>` element). */
    fn_line: u32
    /** the branch sites and distinct executable lines the build stage walked from the body. */
    walk: CovWalk
}

/**
 * SiteMap — the whole build's serialized coverage site-map: one `SiteFn` per production function, in
 * program-item order. Emitted by the build stage next to the gate binary and read by the report
 * stage, which then renders coverage by JOINING this table against the merged `.tkcov` sink — never
 * re-parsing or re-checking the source. The join reproduces the AST-walk report byte for byte
 * because every `SiteFn` carries the same `fn_idx`, identity fields and `CovWalk` in the same order.
 *
 * @since 0.3.1
 */
exp type SiteMap = struct {
    /** the production functions, in program-item order (the render/tally iteration order). */
    fns: []SiteFn
    /** the D4 ARITH-CAST-RATE denominator the build measured (arith/assignment expressions visited). */
    arith_total: u64
    /** the D4 ARITH-CAST-RATE numerator the build measured (of those, how many carried a conversion). */
    arith_with_conversion: u64
}

/**
 * cov_build_sitefns — walk the typed program and collect one `SiteFn` per production function, in
 * program-item order, applying the SAME filter the AST-walk report applies (skip `#test` functions
 * and the coverage machinery itself). The `fn_idx` recorded is the program-item index `i`, which is
 * exactly the sink key the native run marked by, so the report's join matches the build's marks.
 *
 * @param prog  the fully-typed program the build stage already holds
 * @return      the production functions' coverage identities, in render order
 */
fn cov_build_sitefns(prog: checker::TProgram) -> []SiteFn {
    mut fns: []SiteFn = teko::list::empty()
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if !f.is_test && f.namespace != "teko::coverage" {
                    let w = cov_walk_block(f.body, cov_walk_empty())
                    fns = teko::list::push(fns, SiteFn { fn_idx = i to u64; namespace = f.namespace; name = f.name; file = f.file; fn_line = f.line; walk = w })
                }
            }
            _ => { }
        }
        i++
    }
    fns
}

/**
 * cov_emit_sitemap — serialize the site-map of `prog` (its site-id → file:line:col:fn table) into a
 * self-describing text blob the report stage reads WITHOUT re-parsing the source. This is what
 * lets the report render coverage by a table join instead of a walk of the typed program — the
 * removal of the last "reload the AST" the owner's ruling names.
 *
 * Emitted by the build stage, which ALREADY holds `prog` typed, alongside the gate; the report
 * stage never needs the AST to report again.
 *
 * The layout is length-driven, not delimiter-driven: a header
 * `tksites <version> <n> <arith_total> <arith_with_conversion>` line, then per function a counts
 * line (`fn_idx fn_line ns_len name_len file_len n_lines n_sites`), the three identity strings
 * concatenated (sliced back by their byte lengths, so a path's own digits or separators never
 * confuse the parser), then the distinct lines and the `(line col n)` triples. All integers are
 * whitespace-separated and the counts drive the read, so the newlines are for a human reader only.
 *
 * @param prog  the verified program (the same `fe.prog` the build stage checked)
 * @return      the serialized site-map blob
 * @since 0.3.1
 */
exp fn cov_emit_sitemap(prog: checker::TProgram) -> str {
    let fns = cov_build_sitefns(prog)
    let acr = checker::arith_cast_rate_report(prog)
    mut b: []byte = teko::list::empty()
    b = teko::mem::append_fo(b, $"{SITEMAP_MAGIC} {SITEMAP_VERSION} {fns.len} {acr.total} {acr.with_conversion}\n")
    mut i: u64 = 0
    loop {
        if i >= fns.len { break }
        b = cov_emit_one_sitefn(b, fns[i])
        i = i + 1
    }
    str(b)
}

/**
 * cov_emit_one_sitefn — append ONE `SiteFn`'s serialized record to the blob buffer: its counts
 * line, its three length-prefixed identity strings, its distinct lines, and its branch-site
 * triples. The mirror of `sm_parse_fn`.
 *
 * @param buf  the copy-grow blob buffer being built
 * @param sf   the production function's coverage identity to serialize
 * @return     the buffer with `sf`'s record appended
 */
fn cov_emit_one_sitefn(buf: []byte, sf: SiteFn) -> []byte {
    mut b = teko::mem::append_fo(buf, $"{sf.fn_idx} {sf.fn_line} {sf.namespace.len} {sf.name.len} {sf.file.len} {sf.walk.lines.len} {sf.walk.sites.len}\n")
    b = teko::mem::append_fo(b, sf.namespace)
    b = teko::mem::append_fo(b, sf.name)
    b = teko::mem::append_fo(b, sf.file)
    b = teko::mem::append_fo(b, "\n")
    mut k: u64 = 0
    loop {
        if k >= sf.walk.lines.len { break }
        b = teko::mem::append_fo(b, $"{sf.walk.lines[k]} ")
        k = k + 1
    }
    b = teko::mem::append_fo(b, "\n")
    mut s: u64 = 0
    loop {
        if s >= sf.walk.sites.len { break }
        let st = sf.walk.sites[s]
        b = teko::mem::append_fo(b, $"{st.line} {st.col} {st.n} ")
        s = s + 1
    }
    teko::mem::append_fo(b, "\n")
}

/**
 * SmScan — one decoded unsigned integer plus the cursor position just past its last digit, the
 * return of `sm_uint` so the site-map parser threads a position through the blob without a mutable
 * out-parameter.
 */
type SmScan = struct {
    /** the decoded value. */
    v: u64
    /** the byte offset immediately after the value's last digit. */
    pos: u64
}

/**
 * sm_is_ws — is `c` a byte the site-map's whitespace-separated integer stream skips (space, tab,
 * CR, LF)?
 *
 * @param c  the byte to test
 * @return   whether `c` separates tokens
 */
fn sm_is_ws(c: byte) -> bool { c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' }

/**
 * sm_skip_ws — advance past any run of whitespace from `p`.
 *
 * @param s  the blob
 * @param p  the start offset
 * @return   the offset of the first non-whitespace byte at or after `p` (or `s.len`)
 */
fn sm_skip_ws(s: str, p: u64) -> u64 {
    mut q = p
    loop {
        if q >= s.len { break }
        if !sm_is_ws(s[q]) { break }
        q = q + 1
    }
    q
}

/**
 * sm_uint — read one decimal unsigned integer from the blob, skipping any leading whitespace. The
 * counts in the header drive how many of these each record reads, so a physical newline is just
 * skipped as whitespace like any separator.
 *
 * @param s  the blob
 * @param p  the offset to read from
 * @return   the decoded value and the offset just past its last digit
 */
fn sm_uint(s: str, p: u64) -> SmScan {
    mut q = sm_skip_ws(s, p)
    mut n: u64 = 0
    loop {
        if q >= s.len { break }
        let c = s[q]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        q = q + 1
    }
    SmScan { v = n; pos = q }
}

/**
 * SmFnParse — one parsed `SiteFn` plus the cursor position just past its record, the return of
 * `sm_parse_fn`.
 */
type SmFnParse = struct {
    /** the parsed production-function coverage identity. */
    sf: SiteFn
    /** the byte offset immediately after this record. */
    pos: u64
}

/**
 * sm_parse_fn — parse ONE `SiteFn` record from the blob at `p`: the seven counts, the three
 * length-sliced identity strings, the distinct lines, and the branch-site triples. The mirror of
 * `cov_emit_one_sitefn`. The strings are taken by BYTE LENGTH (from the counts) rather than by a
 * delimiter, so a file path's own digits or slashes cannot be mistaken for structure.
 *
 * @param s  the blob
 * @param p  the offset of this record's counts line
 * @return   the parsed function and the offset past its record, or a truncation error
 * @throws   when the declared string lengths run past the end of the blob (a truncated site-map)
 */
fn sm_parse_fn(s: str, p: u64) -> SmFnParse | error {
    let fn_idx = sm_uint(s, p)
    let fn_line = sm_uint(s, fn_idx.pos)
    let ns_len = sm_uint(s, fn_line.pos)
    let name_len = sm_uint(s, ns_len.pos)
    let file_len = sm_uint(s, name_len.pos)
    let n_lines = sm_uint(s, file_len.pos)
    let n_sites = sm_uint(s, n_lines.pos)
    let bs = sm_skip_ws(s, n_sites.pos)
    let ns_end = bs + ns_len.v
    let name_end = ns_end + name_len.v
    let file_end = name_end + file_len.v
    if file_end > s.len { return error { message = "site-map: identity strings run past end of blob" } }
    let namespace = teko::str::slice(s, bs, ns_end)
    let name = teko::str::slice(s, ns_end, name_end)
    let file = teko::str::slice(s, name_end, file_end)
    mut lines: []u32 = teko::list::empty()
    mut cur = file_end
    mut k: u64 = 0
    loop {
        if k >= n_lines.v { break }
        let u = sm_uint(s, cur)
        lines = teko::list::push(lines, u.v to u32)
        cur = u.pos
        k = k + 1
    }
    mut sites: []BranchSite = teko::list::empty()
    mut j: u64 = 0
    loop {
        if j >= n_sites.v { break }
        let ul = sm_uint(s, cur)
        let uc = sm_uint(s, ul.pos)
        let un = sm_uint(s, uc.pos)
        sites = teko::list::push(sites, BranchSite { line = ul.v to u32; col = uc.v to u32; n = un.v })
        cur = un.pos
        j = j + 1
    }
    SmFnParse { sf = SiteFn { fn_idx = fn_idx.v; namespace = namespace; name = name; file = file; fn_line = fn_line.v to u32; walk = CovWalk { sites = sites; lines = lines } }; pos = cur }
}

/**
 * cov_parse_sitemap — decode a serialized site-map blob back into a `SiteMap`. Verifies the magic
 * and version so a corrupt or foreign file is rejected (the report stage then falls back to a
 * re-check rather than mis-reporting). The mirror of `cov_emit_sitemap`.
 *
 * @param blob  the serialized site-map (from `cov_emit_sitemap`)
 * @return      the decoded site-map
 * @throws      when the magic or version is wrong, or the blob is truncated
 * @since 0.3.1
 */
exp fn cov_parse_sitemap(blob: str) -> SiteMap | error {
    if blob.len < SITEMAP_MAGIC.len || teko::str::slice_to(blob, SITEMAP_MAGIC.len) != SITEMAP_MAGIC { return error { message = "site-map: bad magic" } }
    let ver = sm_uint(blob, SITEMAP_MAGIC.len)
    if ver.v != SITEMAP_VERSION { return error { message = "site-map: unsupported version" } }
    let n = sm_uint(blob, ver.pos)
    let arith_total = sm_uint(blob, n.pos)
    let arith_with = sm_uint(blob, arith_total.pos)
    mut fns: []SiteFn = teko::list::empty()
    mut cur = arith_with.pos
    mut i: u64 = 0
    loop {
        if i >= n.v { break }
        match sm_parse_fn(blob, cur) {
            SmFnParse as r => { fns = teko::list::push(fns, r.sf); cur = r.pos }
            error as e => return e
        }
        i = i + 1
    }
    SiteMap { fns = fns; arith_total = arith_total.v; arith_with_conversion = arith_with.v }
}

/**
 * cov_cobertura_of — render the Cobertura report from a parsed `SiteMap` and the already-merged
 * coverage sink, WITHOUT touching the AST. The site-map twin of `cov_cobertura`: it feeds the SAME
 * per-class renderer (`cov_render_class`) and the SAME document wrapper (`cov_cobertura_wrap`) the
 * same `SiteFn`s in program-item order, so the XML is byte-for-byte identical to the AST-walk
 * report.
 *
 * @param sm  the parsed site-map
 * @return    the complete Cobertura XML document as a str
 * @since 0.3.1
 */
exp fn cov_cobertura_of(sm: SiteMap) -> str {
    mut body: []byte = teko::list::empty()
    mut agg = CovAgg { lines_cov = 0; lines_val = 0; br_cov = 0; br_val = 0 }
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        let r = cov_render_class(body, cov_class_name(sf.namespace, sf.name), sf.file, sf.name, sf.fn_line, sf.fn_idx, sf.walk)
        body = r.body
        agg = cov_agg_add(agg, r.lt, r.bt)
        i = i + 1
    }
    cov_cobertura_wrap(body, agg)
}

/**
 * cov_cobertura_from_sitemap — render the Cobertura report from a serialized site-map blob and the
 * merged sink, without touching the AST. The convenience twin of `cov_cobertura` for a caller that
 * holds the blob rather than a parsed `SiteMap` (parse then `cov_cobertura_of`).
 *
 * @param sitemap  the serialized site-map blob (from `cov_emit_sitemap`)
 * @return         the Cobertura XML, or the parse error
 * @throws         when the blob's magic/version is wrong or it is truncated
 * @since 0.3.1
 */
exp fn cov_cobertura_from_sitemap(sitemap: str) -> str | error {
    match cov_parse_sitemap(sitemap) {
        SiteMap as sm => cov_cobertura_of(sm)
        error as e => e
    }
}

/**
 * functions_coverage_of — the FUNCTIONS metric from a site-map: distinct production functions
 * executed (the sink's `cov_distinct`) over the site-map's function count. The site-map twin of
 * `functions_coverage`; the denominator is the recorded production-function count, exactly what
 * `count_prod_fns` computes from the AST.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is distinct hit functions and `val` the production-fn total
 * @since 0.3.1
 */
exp fn functions_coverage_of(sm: SiteMap) -> CovCount {
    CovCount { cov = teko::cov_distinct(); val = sm.fns.len }
}

/**
 * line_coverage_of — the LINES metric from a site-map: distinct executable lines hit over total,
 * aggregated across every recorded function by joining its walked lines against the sink. The
 * site-map twin of `line_coverage`.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is hit lines and `val` the total executable lines
 * @since 0.3.1
 */
exp fn line_coverage_of(sm: SiteMap) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        mut k: u64 = 0
        loop {
            if k >= sf.walk.lines.len { break }
            val = val + 1
            if teko::cov_line_hit(sf.fn_idx, sf.walk.lines[k]) { cov = cov + 1 }
            k = k + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

/**
 * branch_coverage_of — the BRANCHES metric from a site-map: taken outcomes over total outcomes
 * across every recorded function's if/match sites, joining each site's outcomes against the sink.
 * The site-map twin of `branch_coverage`.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is taken outcomes and `val` the total outcomes
 * @since 0.3.1
 */
exp fn branch_coverage_of(sm: SiteMap) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        mut s: u64 = 0
        loop {
            if s >= sf.walk.sites.len { break }
            let st = sf.walk.sites[s]
            mut o: u64 = 0
            loop {
                if o >= st.n { break }
                if teko::cov_branch_hit(sf.fn_idx, st.line, st.col, o) { cov = cov + 1 }
                o = o + 1
            }
            val = val + st.n
            s = s + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

/**
 * coverage_pct_of — the FUNCTION-coverage percentage from a site-map (the D4 `functions` floor).
 *
 * @param sm  the parsed site-map
 * @return    the function-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(functions_coverage_of(sm)) }

/**
 * line_coverage_pct_of — the LINE-coverage percentage from a site-map (the D4 `lines` floor).
 *
 * @param sm  the parsed site-map
 * @return    the line-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn line_coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(line_coverage_of(sm)) }

/**
 * branch_coverage_pct_of — the BRANCH-coverage percentage from a site-map (the D4 `branches` floor).
 *
 * @param sm  the parsed site-map
 * @return    the branch-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn branch_coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(branch_coverage_of(sm)) }
