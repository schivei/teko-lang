use teko::checker

/**
 * cov_cobertura_of — render the Cobertura report from a parsed `SiteMap` and the already-merged
 * coverage sink, WITHOUT touching the AST. The site-map twin of `cov_cobertura`: it feeds the SAME
 * per-class renderer (`cov_render_class`) and the SAME document wrapper (`cov_cobertura_wrap`) the
 * same `SiteFn`s in program-item order, so the XML is byte-for-byte identical to the AST-walk
 * report.
 *
 * @param sm  the parsed site-map
 * @return    the complete Cobertura XML document as a str
 * @since 0.3.1
 */
exp fn cov_cobertura_of(sm: SiteMap) -> str {
    mut body: []byte = teko::list::empty()
    mut agg = CovAgg { lines_cov = 0; lines_val = 0; br_cov = 0; br_val = 0 }
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        let r = cov_render_class(body, cov_class_name(sf.namespace, sf.name), sf.file, sf.name, sf.fn_line, sf.fn_idx, sf.walk)
        body = r.body
        agg = cov_agg_add(agg, r.lt, r.bt)
        i = i + 1
    }
    cov_cobertura_wrap(body, agg)
}

/**
 * cov_cobertura_from_sitemap — render the Cobertura report from a serialized site-map blob and the
 * merged sink, without touching the AST. The convenience twin of `cov_cobertura` for a caller that
 * holds the blob rather than a parsed `SiteMap` (parse then `cov_cobertura_of`).
 *
 * @param sitemap  the serialized site-map blob (from `cov_emit_sitemap`)
 * @return         the Cobertura XML, or the parse error
 * @throws         when the blob's magic/version is wrong or it is truncated
 * @since 0.3.1
 */
exp fn cov_cobertura_from_sitemap(sitemap: str) -> str | error {
    match cov_parse_sitemap(sitemap) {
        SiteMap as sm => cov_cobertura_of(sm)
        error as e => e
    }
}

/**
 * functions_coverage_of — the FUNCTIONS metric from a site-map: distinct production functions
 * executed (the sink's `cov_distinct`) over the site-map's function count. The site-map twin of
 * `functions_coverage`; the denominator is the recorded production-function count, exactly what
 * `count_prod_fns` computes from the AST.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is distinct hit functions and `val` the production-fn total
 * @since 0.3.1
 */
exp fn functions_coverage_of(sm: SiteMap) -> CovCount {
    CovCount { cov = teko::cov_distinct(); val = sm.fns.len }
}

/**
 * line_coverage_of — the LINES metric from a site-map: distinct executable lines hit over total,
 * aggregated across every recorded function by joining its walked lines against the sink. The
 * site-map twin of `line_coverage`.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is hit lines and `val` the total executable lines
 * @since 0.3.1
 */
exp fn line_coverage_of(sm: SiteMap) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        mut k: u64 = 0
        loop {
            if k >= sf.walk.lines.len { break }
            val = val + 1
            if teko::cov_line_hit(sf.fn_idx, sf.walk.lines[k]) { cov = cov + 1 }
            k = k + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

/**
 * branch_coverage_of — the BRANCHES metric from a site-map: taken outcomes over total outcomes
 * across every recorded function's if/match sites, joining each site's outcomes against the sink.
 * The site-map twin of `branch_coverage`.
 *
 * @param sm  the parsed site-map
 * @return    a CovCount whose `cov` is taken outcomes and `val` the total outcomes
 * @since 0.3.1
 */
exp fn branch_coverage_of(sm: SiteMap) -> CovCount {
    mut cov: u64 = 0; mut val: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= sm.fns.len { break }
        let sf = sm.fns[i]
        mut s: u64 = 0
        loop {
            if s >= sf.walk.sites.len { break }
            let st = sf.walk.sites[s]
            mut o: u64 = 0
            loop {
                if o >= st.n { break }
                if teko::cov_branch_hit(sf.fn_idx, st.line, st.col, o) { cov = cov + 1 }
                o = o + 1
            }
            val = val + st.n
            s = s + 1
        }
        i = i + 1
    }
    CovCount { cov = cov; val = val }
}

/**
 * coverage_pct_of — the FUNCTION-coverage percentage from a site-map (the D4 `functions` floor).
 *
 * @param sm  the parsed site-map
 * @return    the function-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(functions_coverage_of(sm)) }

/**
 * line_coverage_pct_of — the LINE-coverage percentage from a site-map (the D4 `lines` floor).
 *
 * @param sm  the parsed site-map
 * @return    the line-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn line_coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(line_coverage_of(sm)) }

/**
 * branch_coverage_pct_of — the BRANCH-coverage percentage from a site-map (the D4 `branches` floor).
 *
 * @param sm  the parsed site-map
 * @return    the branch-coverage percentage in [0, 100]
 * @since 0.3.1
 */
exp fn branch_coverage_pct_of(sm: SiteMap) -> u64 { cov_pct(branch_coverage_of(sm)) }
