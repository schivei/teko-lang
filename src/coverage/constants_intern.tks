use teko::checker

/**
 * SITEMAP_MAGIC — the first word of a serialized site-map blob, so a corrupt or foreign file is
 * rejected (and the report stage can fall back to a re-check) instead of being mis-parsed.
 *
 * @since 0.3.1
 */
const SITEMAP_MAGIC: str = "tksites"

/**
 * SITEMAP_VERSION — the serialized site-map layout version. Bumped only if the field order changes;
 * a reader that finds a different version rejects the blob.
 *
 * @since 0.3.1
 */
const SITEMAP_VERSION: u64 = 1
