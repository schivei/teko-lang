
/**
 * SiteMap — the whole build's serialized coverage site-map: one `SiteFn` per production function, in
 * program-item order. Emitted by the build stage next to the gate binary and read by the report
 * stage, which then renders coverage by JOINING this table against the merged `.tkcov` sink — never
 * re-parsing or re-checking the source. The join reproduces the AST-walk report byte for byte
 * because every `SiteFn` carries the same `fn_idx`, identity fields and `CovWalk` in the same order.
 *
 * @since 0.3.1
 */
exp type SiteMap = struct {
    /** the production functions, in program-item order (the render/tally iteration order). */
    fns: []SiteFn
    /** the D4 ARITH-CAST-RATE denominator the build measured (arith/assignment expressions visited). */
    arith_total: u64
    /** the D4 ARITH-CAST-RATE numerator the build measured (of those, how many carried a conversion). */
    arith_with_conversion: u64
}
