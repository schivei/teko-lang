use teko::numeric::bigint

const G17_SIG: u64 = 17

const F64_FRAC_BITS: u64 = 52

const F64_EXP_MASK: u64 = 2047

const F64_FRAC_MASK: u64 = 4503599627370495

const F64_IMPLICIT: u64 = 4503599627370496

fn ten(): bigint::BigInt {
    bigint::of_u64(10)
}

fn digit_by_subtraction(r: bigint::BigInt, s: bigint::BigInt): DigitStep {
    var acc = r
    var d: u32 = 0
    loop {
        if bigint::cmp(acc, s) < 0 { break }
        acc = bigint::sub(acc, s)
        d = d + 1
    }
    DigitStep { rest = acc; digit = d }
}

type DigitStep = struct {
    rest: bigint::BigInt
    digit: u32
}

type Scaled = struct {
    r: bigint::BigInt
    s: bigint::BigInt
    e10: i64
}

fn normalize_first_digit(r0: bigint::BigInt, s0: bigint::BigInt): Scaled {
    var r = r0
    var s = s0
    var e10: i64 = 0
    loop {
        if bigint::cmp(r, s) >= 0 { break }
        r = bigint::mul(r, ten())
        e10 = e10 - 1
    }
    loop {
        var s10 = bigint::mul(s, ten())
        if bigint::cmp(r, s10) < 0 { break }
        s = s10
        e10 = e10 + 1
    }
    Scaled { r = r; s = s; e10 = e10 }
}

type Digits = struct {
    d: [17]u32
    e10: i64
    nsig: u64
}

fn extract_digits(scaled: Scaled): Digits {
    var r = scaled.r
    var s = scaled.s
    var out: [17]u32 = []
    var i: u64 = 0
    loop {
        if i >= G17_SIG { break }
        var step = digit_by_subtraction(r, s)
        out[i] = step.digit
        r = step.rest
        if i != G17_SIG - 1 { r = bigint::mul(r, ten()) }
        i = i + 1
    }
    var e10 = scaled.e10
    if round_up_half_even(r, s, out[G17_SIG - 1]) {
        var k: i64 = (G17_SIG - 1) to i64
        var carried = true
        loop {
            if k < 0 { break }
            var ki = k to u64
            out[ki] = out[ki] + 1
            if out[ki] < 10 { carried = false; break }
            out[ki] = 0
            k = k - 1
        }
        if carried {
            out[0] = 1
            e10 = e10 + 1
        }
    }
    Digits { d = out; e10 = e10; nsig = significant_count(out) }
}

fn round_up_half_even(r: bigint::BigInt, s: bigint::BigInt, last: u32): bool {
    var two_r = bigint::mul(r, bigint::of_u64(2))
    var c = bigint::cmp(two_r, s)
    if c > 0 { return true }
    if c < 0 { return false }
    (last % 2) == 1
}

fn significant_count(out: [17]u32): u64 {
    var k: u64 = G17_SIG - 1
    loop {
        if k == 0 { break }
        if out[k] != 0 { break }
        k = k - 1
    }
    k + 1
}

fn digit_char(d: u32): byte {
    ((48 to u32) + d) to byte
}

fn sig_bytes(d: [17]u32, nsig: u64): []byte {
    var out: [nsig]byte = []
    var i: u64 = 0
    loop {
        if i >= nsig { break }
        out[i] = digit_char(d[i])
        i = i + 1
    }
    out
}

fn zeros_bytes(n: u64): []byte {
    var out: [n]byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out[i] = b'0'
        i = i + 1
    }
    out
}

fn exp_field_bytes(e10: i64): []byte {
    var neg = e10 < 0
    var mag = if neg { (0 - e10) to u64 } else { e10 to u64 }
    var digs = uint_bytes_min2(mag)
    var sign = if neg { b'-' } else { b'+' }
    [..[b'e', sign], ..digs]
}

fn uint_bytes_min2(v: u64): []byte {
    var ndig = decimal_width(v)
    var out: [ndig]byte = []
    var rem = v
    var i: u64 = ndig
    loop {
        if i == 0 { break }
        i = i - 1
        out[i] = digit_char((rem % 10) to u32)
        rem = rem / 10
    }
    out
}

fn decimal_width(v: u64): u64 {
    var n: u64 = 1
    var t = v
    loop {
        if t < 10 { break }
        t = t / 10
        n = n + 1
    }
    if n < 2 { 2 } else { n }
}

fn render_scientific(sig: []byte, e10: i64): []byte {
    var expb = exp_field_bytes(e10)
    if sig.len == 1 { return [..sig, ..expb] }
    var head: [1]byte = []
    head[0] = sig[0]
    var frac = tail_bytes(sig, 1)
    [..head, ..[b'.'], ..frac, ..expb]
}

fn tail_bytes(src: []byte, from: u64): []byte {
    var n = src.len - from
    var out: [n]byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out[i] = src[from + i]
        i = i + 1
    }
    out
}

fn head_bytes(src: []byte, count: u64): []byte {
    var out: [count]byte = []
    var i: u64 = 0
    loop {
        if i >= count { break }
        out[i] = src[i]
        i = i + 1
    }
    out
}

fn render_fixed(sig: []byte, e10: i64): []byte {
    if e10 < 0 {
        var lead = ((0 - e10) - 1) to u64
        return [..[b'0', b'.'], ..zeros_bytes(lead), ..sig]
    }
    var intlen = (e10 + 1) to u64
    if sig.len <= intlen {
        return [..sig, ..zeros_bytes(intlen - sig.len)]
    }
    var ip = head_bytes(sig, intlen)
    var fp = tail_bytes(sig, intlen)
    [..ip, ..[b'.'], ..fp]
}

fn render_magnitude(digits: Digits): []byte {
    var sig = sig_bytes(digits.d, digits.nsig)
    if digits.e10 < (0 - 4) || digits.e10 >= (G17_SIG to i64) {
        return render_scientific(sig, digits.e10)
    }
    render_fixed(sig, digits.e10)
}

fn build_ratio(m: u64, e: i64): Scaled {
    if e >= 0 {
        var r = bigint::shl(bigint::of_u64(m), e to u64)
        return normalize_first_digit(r, bigint::one())
    }
    var s = bigint::shl(bigint::one(), (0 - e) to u64)
    normalize_first_digit(bigint::of_u64(m), s)
}

fn bytes_to_str(b: []byte): str {
    match teko::text::str_from_utf8(b) {
        str as s => s
        error => ""
    }
}

fn render_finite(neg: bool, m: u64, e: i64): str {
    var digits = extract_digits(build_ratio(m, e))
    var mag = render_magnitude(digits)
    if neg { return bytes_to_str([..[b'-'], ..mag]) }
    bytes_to_str(mag)
}

/**
 * Render `x` as `%.17g` — a 17-significant-digit decimal that round-trips exactly
 * (`teko::float::parse(f64_g17(x)) == x` for every finite `x`).
 *
 * @param x  the value to render
 * @return   the decimal text; `nan`, `inf`/`-inf` and `0`/`-0` for the non-finite and zero cases
 */
exp fn f64_g17(x: f64): str {
    var bits = teko::f64_bits(x)
    var neg = (bits >> 63) != 0
    var exp_field = (bits >> F64_FRAC_BITS) & F64_EXP_MASK
    var frac = bits & F64_FRAC_MASK
    if exp_field == F64_EXP_MASK {
        if frac != 0 { return "nan" }
        return if neg { "-inf" } else { "inf" }
    }
    if exp_field == 0 && frac == 0 {
        return if neg { "-0" } else { "0" }
    }
    if exp_field == 0 {
        return render_finite(neg, frac, (0 - 1074) to i64)
    }
    var m = frac | F64_IMPLICIT
    var e = (exp_field to i64) - 1075
    render_finite(neg, m, e)
}
