fn assert_eq_str(got: str, want: str) {
    teko::assert::is_true(got == want)
}

fn unwrap_bi(r: BigInt | error): BigInt {
    match r {
        BigInt as b => b
        error => { teko::assert::is_true(false); zero() }
    }
}

fn unwrap_bytes(r: []byte | error): []byte {
    match r {
        []byte as b => b
        error => { teko::assert::is_true(false); teko::list::empty() }
    }
}

fn neg_u64(v: u64): BigInt {
    neg(of_u64(v))
}

fn hex_nibble(n: u64): byte {
    if n < 10 { return ((b'0' to u64) + n) to byte }
    ((b'a' to u64) + n - 10) to byte
}

fn bytes_to_hex(b: []byte): str {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, hex_nibble((b[i] to u64) >> 4))
        out = teko::list::push(out, hex_nibble((b[i] to u64) & 15))
        i = i + 1
    }
    match teko::text::str_from_utf8(out) {
        str as s => s
        error => ""
    }
}

#test
fn divmod_multi_limb() {
    match divmod(of_lit("987654321098765432109876543210"), of_lit("123456789012345678901234567890")) {
        DivMod as q => {
            assert_eq_str(to_str(q.quot), "8")
            assert_eq_str(to_str(q.rem), "9000000000900000000090")
        }
        error => { teko::assert::is_true(false) }
    }
}

#test
fn divmod_zero_divisor_errors() {
    match divmod(of_u64(5), zero()) {
        DivMod => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn modulo_is_euclidean() {
    assert_eq_str(to_str(unwrap_bi(modulo(neg_u64(7), of_u64(3)))), "2")
    assert_eq_str(to_str(unwrap_bi(modulo(of_u64(7), of_u64(3)))), "1")
    match modulo(of_u64(1), zero()) {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn gcd_multi_limb() {
    assert_eq_str(to_str(gcd(of_lit("123456789012345678901234567890"), of_lit("987654321098765432109876543210"))), "9000000000900000000090")
    assert_eq_str(to_str(gcd(neg_u64(48), of_u64(36))), "12")
    assert_eq_str(to_str(gcd(zero(), zero())), "0")
}

#test
fn mod_pow_known_and_rsa() {
    assert_eq_str(to_str(unwrap_bi(mod_pow(of_u64(4), of_u64(13), of_u64(497)))), "445")
    assert_eq_str(to_str(unwrap_bi(mod_pow(of_u64(65), of_u64(17), of_u64(3233)))), "2790")
    assert_eq_str(to_str(unwrap_bi(mod_pow(of_u64(2790), of_u64(2753), of_u64(3233)))), "65")
    assert_eq_str(to_str(unwrap_bi(mod_pow(of_lit("16045690984503098046"), of_lit("19088743"), of_lit("1203552815971897489555164")))), "1192139554478360475135192")
}

#test
fn mod_pow_bad_modulus_errors() {
    match mod_pow(of_u64(2), of_u64(3), zero()) {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
    match mod_pow(of_u64(2), neg_u64(1), of_u64(7)) {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn mod_inverse_small_and_big() {
    assert_eq_str(to_str(unwrap_bi(mod_inverse(of_u64(17), of_u64(3120)))), "2753")
    assert_eq_str(to_str(unwrap_bi(mod_inverse(of_lit("16045690984833335023"), of_lit("18446744073709551557")))), "11199586035192070431")
}

#test
fn mod_inverse_non_coprime_errors() {
    match mod_inverse(of_u64(4), of_u64(8)) {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn shifts_scale_by_powers_of_two() {
    assert_eq_str(to_str(shl(of_u64(1), 64)), "18446744073709551616")
    assert_eq_str(to_str(shr(of_lit("18446744073709551616"), 64)), "1")
    assert_eq_str(to_str(shl(neg_u64(3), 4)), "-48")
    teko::assert::is_true(bit_length(of_lit("18446744073709551616")) == 65)
    teko::assert::is_true(is_even(of_u64(10)))
    teko::assert::is_true(!is_even(of_u64(7)))
}

#test
fn bitwise_over_magnitudes() {
    assert_eq_str(to_str(unwrap_bi(bit_and(of_u64(61680), of_u64(4080)))), "240")
    assert_eq_str(to_str(unwrap_bi(bit_or(of_u64(61440), of_u64(15)))), "61455")
    assert_eq_str(to_str(unwrap_bi(bit_xor(of_u64(65295), of_u64(255)))), "65520")
    match bit_and(neg_u64(1), of_u64(1)) {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn bytes_be_round_trip() {
    var v = of_lit("5233100606242806050955395731361295")
    assert_eq_str(bytes_to_hex(unwrap_bytes(to_bytes_be(v))), "0102030405060708090a0b0c0d0e0f")
    assert_eq_str(to_str(from_bytes_be(unwrap_bytes(to_bytes_be(v)))), "5233100606242806050955395731361295")
    assert_eq_str(bytes_to_hex(unwrap_bytes(to_bytes_be(zero()))), "00")
    assert_eq_str(bytes_to_hex(unwrap_bytes(to_bytes_be_padded(of_u64(511), 20))), "00000000000000000000000000000000000001ff")
    match to_bytes_be(neg_u64(5)) {
        []byte => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
    match to_bytes_be_padded(of_u64(65536), 2) {
        []byte => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}

#test
fn hex_and_dec_round_trip() {
    assert_eq_str(to_hex(of_lit("5233100606242806050955395731361295")), "102030405060708090a0b0c0d0e0f")
    assert_eq_str(to_hex(zero()), "0")
    assert_eq_str(to_str(unwrap_bi(from_hex("0xff00"))), "65280")
    assert_eq_str(to_str(unwrap_bi(from_hex("-DEAD_BEEF"))), "-3735928559")
    assert_eq_str(to_hex(neg_u64(255)), "-ff")
    assert_eq_str(to_dec_str(unwrap_bi(from_dec_str("340282366920938463463374607431768211456"))), "340282366920938463463374607431768211456")
    match from_hex("xyz") {
        BigInt => { teko::assert::is_true(false) }
        error => { teko::assert::is_true(true) }
    }
}
