/**
 * FLAG_CHECK — the REPORT-ONLY mode flag: `teko fmt --check <path>…` lists every path that is
 * not already canonical and writes nothing at all. Named once here so the argument parser and
 * the usage page cannot drift apart.
 *
 * @since 0.3.1
 */
const FLAG_CHECK: str = "--check"

/**
 * FLAG_APPLY — the REWRITE mode flag: `teko fmt --apply <path>…` rewrites every unformatted
 * file in place, which is what a bare `teko fmt <path>…` used to do. Explicit since the owner
 * ruling of 2026-07-30 (*"Sim: fmt --apply explícito"*): in a dev-mode tool the destructive
 * path must never be the shortest one to type, so rewriting is now asked for by name.
 *
 * @since 0.3.1
 */
const FLAG_APPLY: str = "--apply"

/**
 * STDIN_PATH — the operand that selects the stdin-to-stdout form, the one form that needs no
 * mode: it writes to stdout and can touch no file, so there is nothing to guard.
 *
 * @since 0.3.1
 */
const STDIN_PATH: str = "-"

/**
 * FMT_HELP_CMD — the subcommand key `teko::build::print_help` prints the fmt usage page for.
 *
 * @since 0.3.1
 */
const FMT_HELP_CMD: str = "fmt"

