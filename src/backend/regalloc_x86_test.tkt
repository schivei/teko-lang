fn rx_v(id: u32): MReg {
    vreg(id, MRegClass::GPR)
}

fn rx_vf(id: u32): MReg {
    vreg(id, MRegClass::FPR)
}

fn rx_p(id: u32): MReg {
    preg(id, MRegClass::GPR)
}

fn rx_mem(reg: MReg, offset: i32): MMem {
    MMem { base_reg = reg; offset = offset }
}

fn rx_func(insts: []@MInstX86()): MFuncX86 {
    var b = MBlockX86 { id = 0; params = teko::list::empty(); insts = insts }
    MFuncX86 { symbol = "main"; blocks = teko::list::push(teko::list::empty(), b); frame = teko::list::empty() }
}

fn rx_named_func(sym: str, insts: []@MInstX86()): MFuncX86 {
    var b = MBlockX86 { id = 0; params = teko::list::empty(); insts = insts }
    MFuncX86 { symbol = sym; blocks = teko::list::push(teko::list::empty(), b); frame = teko::list::empty() }
}

fn rx_module_of(f: MFuncX86): MModuleX86 {
    MModuleX86 { funcs = teko::list::push(teko::list::empty(), f); rodata = teko::list::empty(); globals = teko::list::empty(); layouts = teko::list::empty() }
}

fn rx_intervals(f: MFuncX86): IntervalSet | error {
    var o = rpo_block_order_x86(f)
    compute_intervals_x86(number_insts_x86(f, o), o, reachable_blocks_x86(f))
}

fn rx_phys(scan: ScanResult, vreg_id: u32): u32 {
    var i: u64 = 0
    loop {
        if i >= scan.assignments.len { break }
        var got = match scan.assignments[i] {
            InReg as r => if r.vreg_id == vreg_id { r.phys } else { 100000 to u32 }
            Spilled => 100000 to u32
        }
        if got != 100000 to u32 { return got }
        i++
    }
    100000 to u32
}

fn rx_spilled(scan: ScanResult, vreg_id: u32): bool {
    var i: u64 = 0
    loop {
        if i >= scan.assignments.len { break }
        var sp = match scan.assignments[i] {
            Spilled as s => s.vreg_id == vreg_id
            InReg => false
        }
        if sp { return true }
        i++
    }
    false
}

fn rx_iv_has(list: []LiveInterval, reg_id: u32, start: u32, end: u32): bool {
    var i: u64 = 0
    loop {
        if i >= list.len { break }
        var iv = list[i]
        if iv.reg_id == reg_id && iv.start == start && iv.end == end { return true }
        i++
    }
    false
}

fn rx_iv_crosses(list: []LiveInterval, reg_id: u32): bool {
    var i: u64 = 0
    loop {
        if i >= list.len { break }
        var iv = list[i]
        if iv.reg_id == reg_id && iv.crosses_call { return true }
        i++
    }
    false
}

fn rx_inst_all_phys(inst: @MInstX86()): bool {
    var ir = inst_regs_x86(inst)
    if ir.has_def {
        if !ir.def_reg.is_phys { return false }
    }
    var i: u64 = 0
    loop {
        if i >= ir.uses.len { break }
        if !ir.uses[i].is_phys { return false }
        i++
    }
    true
}

fn rx_full_subst(n: u32): []SubstEntry {
    var t: []SubstEntry = teko::list::empty()
    var k: u32 = 0
    loop {
        if k >= n { break }
        t = teko::list::push(t, SubstEntry { vid = k; to = rx_p(9) })
        k = k + 1
    }
    t
}

fn rx_all_kinds(): []@MInstX86() {
    var xs: []@MInstX86() = teko::list::empty()
    xs = teko::list::push(xs, movimm_x86(rx_v(0), 1, true))
    xs = teko::list::push(xs, mov_x86(rx_v(1), rx_v(2), true))
    xs = teko::list::push(xs, alu_rm_x86(MAluOpX86::Add, rx_v(3), rx_v(4), true))
    xs = teko::list::push(xs, imul_x86(rx_v(5), rx_v(6), true))
    xs = teko::list::push(xs, divseq_x86(rx_v(7), rx_v(8), rx_v(9), true, false, true))
    xs = teko::list::push(xs, shift_x86(MShiftOpX86::Shl, rx_v(10), true))
    xs = teko::list::push(xs, cmp_x86(rx_v(11), rx_v(12), true))
    xs = teko::list::push(xs, setcc_x86(rx_v(13), MCond::EQ))
    xs = teko::list::push(xs, jcc_x86(MCond::EQ, 0 to u32))
    xs = teko::list::push(xs, neg_x86(rx_v(14), true))
    xs = teko::list::push(xs, not_x86(rx_v(15), true))
    xs = teko::list::push(xs, load_x86(MMemSizeX86::Q, false, rx_v(16), rx_mem(rx_v(17), 0 to i32)))
    xs = teko::list::push(xs, store_x86(MMemSizeX86::Q, rx_v(18), rx_mem(rx_v(19), 0 to i32)))
    xs = teko::list::push(xs, frame_addr_x86(rx_v(20), 0))
    xs = teko::list::push(xs, lea_rip_x86(rx_v(21), "s", RelocKindX86::Pc32))
    xs = teko::list::push(xs, jmp_x86(0 to u32))
    xs = teko::list::push(xs, call_x86("f", two_regs(rx_v(22), rx_v(23)), rx_v(24), true, false))
    xs = teko::list::push(xs, call_ind_x86(rx_v(25), one_reg(rx_v(26)), rx_v(27), true))
    xs = teko::list::push(xs, ret_x86())
    xs
}

#test
fn rx_map_minst_covers_every_case() {
    var kinds = rx_all_kinds()
    var table = rx_full_subst(28 to u32)
    teko::assert::is_true(kinds.len == 19 to u64)
    var i: u64 = 0
    loop {
        if i >= kinds.len { break }
        teko::assert::is_true(rx_inst_all_phys(map_minst_x86(kinds[i], table)))
        i++
    }
}

fn rx_entry_param_add_fixture(): []@MInstX86() {
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, mov_x86(rx_v(0), rx_p(7), true))
    insts = teko::list::push(insts, mov_x86(rx_v(1), rx_p(6), true))
    insts = teko::list::push(insts, mov_x86(rx_v(2), rx_v(0), true))
    insts = teko::list::push(insts, alu_rm_x86(MAluOpX86::Add, rx_v(2), rx_v(1), true))
    insts = teko::list::push(insts, mov_x86(rx_p(0), rx_v(2), true))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_result_pin_without_terminator_is_not_extended() {
    var insts = teko::list::push(teko::list::empty(), movimm_x86(rx_p(0), 5, true))
    var iset = match rx_intervals(rx_func(insts)) { IntervalSet as s => s; error => return }
    teko::assert::is_true(rx_iv_has(iset.fixed, 0, 0, 0))
}

fn rx_double_phys_def_fixture(): []@MInstX86() {
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, movimm_x86(rx_p(0), 1, true))
    insts = teko::list::push(insts, mov_x86(rx_v(0), rx_p(0), true))
    insts = teko::list::push(insts, movimm_x86(rx_p(0), 2, true))
    insts = teko::list::push(insts, mov_x86(rx_p(1), rx_p(0), true))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_repeated_physical_def_splits_into_two_pins() {
    var iset = match rx_intervals(rx_func(rx_double_phys_def_fixture())) { IntervalSet as s => s; error => return }
    teko::assert::is_true(rx_iv_has(iset.fixed, 0, 0, 1))
    teko::assert::is_true(rx_iv_has(iset.fixed, 0, 2, 3))
}

fn rx_call_cross_fixture(): []@MInstX86() {
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, movimm_x86(rx_v(0), 5, true))
    insts = teko::list::push(insts, call_x86("tk_x", teko::list::empty(), rx_p(0), false, false))
    insts = teko::list::push(insts, mov_x86(rx_p(0), rx_v(0), true))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_value_crossing_a_call_is_marked_and_callee_saved() {
    var f = rx_func(rx_call_cross_fixture())
    var iset = match rx_intervals(f) { IntervalSet as s => s; error => return }
    teko::assert::is_true(rx_iv_crosses(iset.virt, 0))
    var scan = linear_scan(SYSV64, iset)
    var p = rx_phys(scan, 0)
    teko::assert::is_true(p != 100000 to u32)
    teko::assert::is_true(is_callee_saved(SYSV64, rx_p(p)))
}

fn rx_shift_pin_fixture(): []@MInstX86() {
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, movimm_x86(rx_v(10), 8, true))
    insts = teko::list::push(insts, movimm_x86(rx_v(11), 2, true))
    insts = teko::list::push(insts, mov_x86(rx_v(20), rx_v(10), true))
    insts = teko::list::push(insts, mov_x86(rx_p(1), rx_v(11), true))
    insts = teko::list::push(insts, shift_x86(MShiftOpX86::Shl, rx_v(20), true))
    insts = teko::list::push(insts, mov_x86(rx_p(0), rx_v(20), true))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_shifted_value_stays_off_the_rcx_pin() {
    var f = rx_func(rx_shift_pin_fixture())
    var iset = match rx_intervals(f) { IntervalSet as s => s; error => return }
    teko::assert::is_true(rx_iv_has(iset.fixed, 1, 3, 4))
    var scan = linear_scan(SYSV64, iset)
    var p20 = rx_phys(scan, 20)
    teko::assert::is_true(p20 != 100000 to u32)
    teko::assert::is_true(p20 != 1 to u32)
    var cf = match regalloc_func_x86(SYSV64, f) { MFuncX86 as g => g; error => return }
    teko::assert::is_true(all_physical_x86(cf))
}

fn rx_spill_abi(): AbiDescriptor {
    AbiDescriptor {
        gpr_arg = push_range(teko::list::empty(), 7, 7)
        fpr_arg = teko::list::empty()
        gpr_allocatable = push_range(teko::list::empty(), 12, 13)
        fpr_allocatable = teko::list::empty()
        gpr_caller_saved = teko::list::empty()
        fpr_caller_saved = teko::list::empty()
        gpr_spill_scratch = push_range(teko::list::empty(), 10, 11)
        fpr_spill_scratch = teko::list::empty()
        spill_slot_bytes = 8
        spill_slot_align = 8
        shadow_space = 0 to u32
        max_reg_arg_bytes = 16 to u32
        arg_slots_shared = false
    }
}

fn rx_spill_fixture(): []@MInstX86() {
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, movimm_x86(rx_v(0), 3, true))
    insts = teko::list::push(insts, movimm_x86(rx_v(1), 5, true))
    insts = teko::list::push(insts, movimm_x86(rx_v(2), 7, true))
    insts = teko::list::push(insts, mov_x86(rx_v(3), rx_v(0), true))
    insts = teko::list::push(insts, alu_rm_x86(MAluOpX86::Add, rx_v(3), rx_v(1), true))
    insts = teko::list::push(insts, mov_x86(rx_v(4), rx_v(3), true))
    insts = teko::list::push(insts, alu_rm_x86(MAluOpX86::Add, rx_v(4), rx_v(2), true))
    insts = teko::list::push(insts, mov_x86(rx_p(0), rx_v(4), true))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_regalloc_gpr_spill_all_physical_and_frame_grows() {
    var f = rx_func(rx_spill_fixture())
    var iset = match rx_intervals(f) { IntervalSet as s => s; error => return }
    var scan = linear_scan(rx_spill_abi(), iset)
    teko::assert::is_true(rx_spilled(scan, 0) || rx_spilled(scan, 1) || rx_spilled(scan, 2))
    var cf = match regalloc_func_x86(rx_spill_abi(), f) { MFuncX86 as g => g; error => return }
    teko::assert::is_true(all_physical_x86(cf))
    teko::assert::is_true(cf.frame.len > 0 to u64)
}

fn rx_fpr_spill_abi(): AbiDescriptor {
    AbiDescriptor {
        gpr_arg = push_range(teko::list::empty(), 7, 7)
        fpr_arg = teko::list::empty()
        gpr_allocatable = push_range(teko::list::empty(), 12, 15)
        fpr_allocatable = push_range(teko::list::empty(), 0, 0)
        gpr_caller_saved = teko::list::empty()
        fpr_caller_saved = teko::list::empty()
        gpr_spill_scratch = push_range(teko::list::empty(), 10, 11)
        fpr_spill_scratch = push_range(teko::list::empty(), 14, 15)
        spill_slot_bytes = 8
        spill_slot_align = 8
        shadow_space = 0 to u32
        max_reg_arg_bytes = 16 to u32
        arg_slots_shared = false
    }
}

fn rx_fpr_spill_fixture(): []@MInstX86() {
    var mem = rx_mem(rx_p(7), 0 to i32)
    var insts: []@MInstX86() = teko::list::empty()
    insts = teko::list::push(insts, load_x86(MMemSizeX86::Q, false, rx_vf(10), mem))
    insts = teko::list::push(insts, load_x86(MMemSizeX86::Q, false, rx_vf(11), mem))
    insts = teko::list::push(insts, store_x86(MMemSizeX86::Q, rx_vf(10), mem))
    insts = teko::list::push(insts, store_x86(MMemSizeX86::Q, rx_vf(11), mem))
    insts = teko::list::push(insts, ret_x86())
    insts
}

#test
fn rx_regalloc_module_carries_tables_and_propagates() {
    var f1 = rx_named_func("a", rx_entry_param_add_fixture())
    var f2 = rx_named_func("b", rx_entry_param_add_fixture())
    var funcs = teko::list::push(teko::list::push(teko::list::empty(), f1), f2)
    var rodata = teko::list::push(teko::list::empty(), lir::LRodata { symbol = "r0"; bytes = teko::list::empty(); relocs = teko::list::empty() })
    var m = MModuleX86 { funcs = funcs; rodata = rodata; globals = teko::list::empty(); layouts = teko::list::empty() }
    var cm = match regalloc_module_x86(SYSV64, m) {
        MModuleX86 as x => x
        error => return
    }
    teko::assert::is_true(cm.funcs.len == 2 to u64)
    teko::assert::is_true(cm.rodata.len == 1 to u64)
}

fn rx_dump(f: MFuncX86): str {
    minst_print_x86(add_mfunc_x86(empty_mmodule_x86(), f))
}

#test
fn rx_regalloc_fpr_spill_lowers_to_movsd() {
    var f = rx_named_func("main", rx_fpr_spill_fixture())
    var cf = match regalloc_func_x86(rx_fpr_spill_abi(), f) { MFuncX86 as g => g; error => return }
    teko::assert::is_true(all_physical_x86(cf))
    teko::assert::is_true(cf.frame.len > 0 to u64)
    var text = rx_dump(cf)
    teko::assert::str_contains(text, "movsd [spill #0], %pf14")
    teko::assert::str_contains(text, "movsd %pf14, [spill #0]")
}

fn rx_dead_block_fixture(): MFuncX86 {
    var i0: []@MInstX86() = teko::list::empty()
    i0 = teko::list::push(i0, movimm_x86(rx_v(0), 5, true))
    i0 = teko::list::push(i0, mov_x86(rx_p(0), rx_v(0), true))
    i0 = teko::list::push(i0, ret_x86())
    var b0 = MBlockX86 { id = 0; params = teko::list::empty(); insts = i0 }
    var b7 = MBlockX86 { id = 7; params = teko::list::empty(); insts = teko::list::push(teko::list::empty(), jmp_x86(0 to u32)) }
    MFuncX86 { symbol = "main"; blocks = teko::list::push(teko::list::push(teko::list::empty(), b0), b7); frame = teko::list::empty() }
}

#test
fn rx_dead_block_excluded_and_allocation_succeeds() {
    var f = rx_dead_block_fixture()
    teko::assert::is_false(u32_in(reachable_blocks_x86(f), 7 to u32))
    teko::assert::is_true(u32_in(rpo_block_order_x86(f), 7 to u32))
    var cf = match regalloc_func_x86(SYSV64, f) { MFuncX86 as g => g; error => return }
    teko::assert::is_true(all_physical_x86(cf))
}

#test
fn rx_rpo_defensive_paths() {
    teko::assert::is_true(block_insts_of_x86(rx_func(teko::list::push(teko::list::empty(), ret_x86())), 99 to u32).len == 0 to u64)
    var empty_f = MFuncX86 { symbol = "main"; blocks = teko::list::empty(); frame = teko::list::empty() }
    teko::assert::is_true(rpo_block_order_x86(empty_f).len == 0 to u64)
    teko::assert::is_true(reachable_blocks_x86(empty_f).len == 0 to u64)
    var b0 = MBlockX86 { id = 0; params = teko::list::empty(); insts = teko::list::push(teko::list::empty(), ret_x86()) }
    var b9 = MBlockX86 { id = 9; params = teko::list::empty(); insts = teko::list::push(teko::list::empty(), ret_x86()) }
    var f2 = MFuncX86 { symbol = "main"; blocks = teko::list::push(teko::list::push(teko::list::empty(), b0), b9); frame = teko::list::empty() }
    var ord2 = rpo_block_order_x86(f2)
    teko::assert::is_true(ord2.len == 2 to u64)
    teko::assert::is_true(u32_in(ord2, 9 to u32))
}
