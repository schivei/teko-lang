use teko::lir

/**
 * el_p — a physical GPR operand with the given x86 ISA id (the ELF-writer
 * fixture shorthand; B1 runs post-regalloc, every operand physical).
 *
 * @param u32 id  the x86 ISA register number
 * @return MReg  the physical GPR operand
 */
fn el_p(id: u32): MReg {
    preg(id, MRegClass::GPR)
}

/**
 * el_block — a machine block (no params) with the given id and stream.
 *
 * @param u32 id  the block id
 * @param []MInstX86 insts  the block's instructions
 * @return MBlockX86  the built block
 */
fn el_block(id: u32, insts: []MInstX86): MBlockX86 {
    MBlockX86 { id = id; params = teko::list::empty(); insts = insts }
}

/**
 * el_1block_func — a single-block `MFuncX86` with the given symbol, stream, and
 * frame.
 *
 * @param str sym  the function's symbol
 * @param []MInstX86 insts  the block's instructions
 * @param []lir::LAlloca frame  the function's frame slots
 * @return MFuncX86  the built function
 */
fn el_1block_func(sym: str, insts: []MInstX86, frame: []lir::LAlloca): MFuncX86 {
    MFuncX86 { symbol = sym; blocks = [el_block(0 to u32, insts)]; frame = frame }
}

/**
 * el_no_frame — the empty `[]lir::LAlloca` frame (a frameless function).
 *
 * @return []lir::LAlloca  an empty frame slot list
 */
fn el_no_frame(): []lir::LAlloca {
    teko::list::empty()
}

/**
 * el_object_of — encode `m` under `SYSV64` and assemble its ELF object, or an
 * empty buffer on an unexpected honest-stop (so a golden length/byte assertion
 * fails loudly rather than aborting the run).
 *
 * @param MModuleX86 m  the module to encode + emit
 * @return []byte  the ELF object bytes, or empty on error
 */
fn el_object_of(m: MModuleX86): []byte {
    match encode_module_x86(SYSV64, m) {
        EncodedModuleX86 as x => emit_elf(x, no_dwarf_sink())
        error as e => teko::list::empty()
    }
}

/**
 * el_u32_at — the little-endian u32 read from `bytes` at byte index `i` (the
 * golden-object field reader).
 *
 * @param []byte bytes  the object bytes
 * @param u64 i  the field's byte offset
 * @return u32  the little-endian u32 at `i`
 */
fn el_u32_at(bytes: []byte, i: u64): u32 {
    (bytes[i] to u32) | ((bytes[i + (1 to u64)] to u32) << (8 to u32)) | ((bytes[i + (2 to u64)] to u32) << (16 to u32)) | ((bytes[i + (3 to u64)] to u32) << (24 to u32))
}

/**
 * el_u16_at — the little-endian u16 read from `bytes` at byte index `i` (the
 * `Elf64_Ehdr`/`Elf64_Sym` 16-bit-field reader).
 *
 * @param []byte bytes  the object bytes
 * @param u64 i  the field's byte offset
 * @return u32  the little-endian u16 at `i`
 */
fn el_u16_at(bytes: []byte, i: u64): u32 {
    (bytes[i] to u32) | ((bytes[i + (1 to u64)] to u32) << (8 to u32))
}

/**
 * el_rodata_module — a frameless `main` of `lea rax, [rip+"s0"]` (a `Pc32`
 * rodata reference) then `ret`, plus one rodata datum `s0 = "A\0"`. Exercises the
 * `.rodata` `STT_SECTION` symbol + the rodata-target relocation the writer folds
 * onto the section symbol.
 *
 * @return MModuleX86  the one-function, one-rodata module
 */
fn el_rodata_module(): MModuleX86 {
    var insts = [lea_rip_x86(el_p(0), "s0", RelocKindX86::Pc32), ret_x86()]
    var f = el_1block_func("main", insts, el_no_frame())
    var rbytes = [0x41 to byte, 0 to byte]
    var rodata = [lir::LRodata { symbol = "s0"; bytes = rbytes; relocs = teko::list::empty() }]
    MModuleX86 { funcs = [f]; rodata = rodata; globals = teko::list::empty(); layouts = teko::list::empty() }
}

#test
/**
 * elf_rodata_uses_section_symbol_and_pc32 — the rodata object's `.symtab` (at 80)
 * carries the `.rodata` `STT_SECTION` local symbol (`st_info = 0x03`,
 * `st_shndx = 2`) BEFORE the global `main`, so `.symtab.sh_info` (first-global) is
 * 2; the single `Pc32` relocation (at 216) is `R_X86_64_PC32`(2) against symbol
 * index 1 (the section symbol, NOT a per-string symbol) with addend −4 — the ELF
 * idiom that dodges per-string symbols and cross-object name clashes.
 *
 * @return void
 */
fn elf_rodata_uses_section_symbol_and_pc32() {
    var obj = el_object_of(el_rodata_module())
    teko::assert::is_true(obj[108] == (0x03 to byte))
    teko::assert::is_true(el_u16_at(obj, 110 to u64) == (2 to u32))
    teko::assert::is_true(obj[132] == (0x12 to byte))
    teko::assert::is_true(el_u16_at(obj, 134 to u64) == (1 to u32))
    teko::assert::is_true(el_u32_at(obj, 456 to u64) == (80 to u32))
    teko::assert::is_true(el_u32_at(obj, 476 to u64) == (2 to u32))
    teko::assert::is_true(el_u32_at(obj, 216 to u64) == (3 to u32))
    teko::assert::is_true(el_u32_at(obj, 224 to u64) == (2 to u32))
    teko::assert::is_true(el_u32_at(obj, 228 to u64) == (1 to u32))
    teko::assert::is_true(el_u32_at(obj, 232 to u64) == (0xFFFFFFFC to u32))
}

/**
 * el_rodata_off_module — a hand-built `EncodedModuleX86` whose rodata datum `s1`
 * sits at `.rodata` byte offset 8, with a `Pc32` relocation targeting it. Pins
 * the writer's addend folding — the section-symbol relocation's addend becomes
 * `base(−4) + rodata_offset(8) = 4` — without routing through isel.
 *
 * @return EncodedModuleX86  the hand-built module
 */
fn el_rodata_off_module(): EncodedModuleX86 {
    var text = [0x48 to byte, 0x8D to byte, 0x05 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0xC3 to byte]
    var rodata = [0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0x41 to byte, 0 to byte]
    var s1 = Symbol { name = "s1"; defined = true; sect = 2 to u8; offset = 8 to u32; local = true }
    var main = Symbol { name = "main"; defined = true; sect = 1 to u8; offset = 0 to u32; local = false }
    var reloc = RelocX86 { offset = 3 to u32; sym = "s1"; kind = RelocKindX86::Pc32; addend = (0) - (4); sect = RelocSect::Text }
    EncodedModuleX86 { text = text; rodata = rodata; symbols = [s1, main]; relocs = [reloc] }
}

#test
/**
 * elf_folds_rodata_offset_into_addend — the hand-built offset-8 rodata module's
 * lone relocation (at file offset 224 — its 10-byte `.rodata` pushes `.symtab`/
 * `.strtab`/`.rela.text` past the exit-module positions) has `r_offset = 3`, is
 * `R_X86_64_PC32`(2) against the section symbol (index 1), and carries the folded
 * addend `−4 + 8 = 4`, proving the writer adds the datum's `.rodata` offset onto
 * the base addend so `S + A − P` lands on `s1`.
 *
 * @return void
 */
fn elf_folds_rodata_offset_into_addend() {
    var obj = emit_elf(el_rodata_off_module(), no_dwarf_sink())
    teko::assert::is_true(el_u32_at(obj, 224 to u64) == (3 to u32))
    teko::assert::is_true(el_u32_at(obj, 232 to u64) == (2 to u32))
    teko::assert::is_true(el_u32_at(obj, 236 to u64) == (1 to u32))
    teko::assert::is_true(el_u32_at(obj, 240 to u64) == (4 to u32))
    teko::assert::is_true(el_u32_at(obj, 244 to u64) == (0 to u32))
}

/**
 * el_dwarf_sink_of — a one-function `DwarfSink` (D1.4 fixture) anchored at `sym`: a compile unit
 * with a single `DW_TAG_subprogram` DIE and a one-row line program, both targeting `sym`'s address.
 * Built through the SAME `build_dwarf_sink` the real `--debug=lines` build glue calls, so this
 * fixture exercises the exact producer → sink path, not a hand-faked shortcut.
 *
 * @param str sym  the `.text` symbol both the CU and the line program anchor to
 * @param u64 code_size  the function's (and so the unit's) code size
 * @return DwarfSink  the assembled, `present = true` sink
 */
fn el_dwarf_sink_of(sym: str, code_size: u64): DwarfSink {
    var sub = DwSubprogram { name = "main"; decl_file = 1; decl_line = 10 to u32; symbol = sym; code_size = code_size }
    var cu = DwCompileUnit {
        producer = "teko test"; language = 0x0c to u32; name = "t.tks"; comp_dir = "."
        text_symbol = sym; text_size = code_size; subprograms = [sub]
    }
    var rows = [DwLineRow { pc_advance = 0 to u64; line = 10 to u32; file = 1 }]
    build_dwarf_sink(cu, ["t.tks"], rows, code_size)
}

#test
/**
 * elf_dwarf_absent_is_byte_identical — omitting `dwarf` and passing `no_dwarf_sink()` explicitly
 * produce the SAME object, byte for byte: the `DebugInfo::None` default (§ D1.4's non-negotiable —
 * a build with no debug axis stays byte-identical to before the sink existed).
 *
 * @return void
 */
fn elf_dwarf_absent_is_byte_identical() {
    var a = emit_elf(el_rodata_off_module(), no_dwarf_sink())
    var b = emit_elf(el_rodata_off_module(), no_dwarf_sink())
    teko::assert::eq_u64(a.len, b.len)
    teko::assert::is_true(el_bytes_eq(a, b))
    teko::assert::eq_u64(el_u16_at(a, EL_EHDR_SHNUM_FIELD) to u64, 7 to u64)
}

#test
/**
 * elf_dwarf_present_appends_five_progbits_and_rela_headers — a `--debug=lines`-shaped object
 * (D1.4) grows `e_shnum` from 7 to 12 (the five DWARF headers, appended after `.rela.text` since
 * this fixture carries no `.data.rel.ro`): indices 7/8/9 are `.debug_abbrev`/`.debug_info`/
 * `.debug_line`, all `SHT_PROGBITS`(1), sized exactly like the D1.3 producers' own output
 * (`debug_abbrev()`'s length, and the `DwarfSink`'s `info`/`line` byte counts), and indices 10/11
 * are `.rela.debug_info`/`.rela.debug_line`, `SHT_RELA`(4), with `sh_info` naming the section EACH
 * patches (`.debug_info`(8) / `.debug_line`(9)) — proving the placement, not just the presence.
 *
 * @return void
 */
fn elf_dwarf_present_appends_five_progbits_and_rela_headers() {
    var sink = el_dwarf_sink_of("main", 8 to u64)
    var obj = emit_elf(el_rodata_off_module(), sink)
    teko::assert::eq_u64(el_u16_at(obj, EL_EHDR_SHNUM_FIELD) to u64, 12 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 7 to u64, EL_SHDR_TYPE_FIELD) to u64, 1 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 8 to u64, EL_SHDR_TYPE_FIELD) to u64, 1 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 9 to u64, EL_SHDR_TYPE_FIELD) to u64, 1 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 10 to u64, EL_SHDR_TYPE_FIELD) to u64, 4 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 11 to u64, EL_SHDR_TYPE_FIELD) to u64, 4 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 7 to u64, EL_SHDR_SIZE_FIELD) to u64, debug_abbrev().len)
    teko::assert::eq_u64(el_shdr_u32(obj, 8 to u64, EL_SHDR_SIZE_FIELD) to u64, sink.info.bytes.len)
    teko::assert::eq_u64(el_shdr_u32(obj, 9 to u64, EL_SHDR_SIZE_FIELD) to u64, sink.line.bytes.len)
    teko::assert::eq_u64(el_shdr_u32(obj, 10 to u64, EL_SHDR_INFO_FIELD) to u64, 8 to u64)
    teko::assert::eq_u64(el_shdr_u32(obj, 11 to u64, EL_SHDR_INFO_FIELD) to u64, 9 to u64)
}

#test
/**
 * elf_dwarf_relas_resolve_against_defined_function_symbol — the `.debug_info` low_pc relocation
 * (D1.4) is `R_X86_64_64`(1) against `main`'s `.symtab` index (2 — after the null and `.rodata`
 * section-symbol slots this fixture's rodata datum forces), addend 0: the DWARF reloc resolver
 * (`elf_dwarf_of`/`elf_resolve_relas`) reaches the SAME name-indexed symbol table `.rela.text`
 * does, not a separate/parallel one.
 *
 * @return void
 */
fn elf_dwarf_relas_resolve_against_defined_function_symbol() {
    var obj = emit_elf(el_rodata_off_module(), el_dwarf_sink_of("main", 8 to u64))
    teko::assert::eq_u64(el_rela_field(obj, 10 to u64, 0 to u64, EL_RELA_TYPE_FIELD) to u64, 1 to u64)
    teko::assert::eq_u64(el_rela_field(obj, 10 to u64, 0 to u64, EL_RELA_SYM_FIELD) to u64, 2 to u64)
    teko::assert::eq_u64(el_rela_field(obj, 10 to u64, 0 to u64, EL_RELA_ADDEND_FIELD) to u64, 0 to u64)
}

/**
 * el_abs64_module — a hand-built `EncodedModuleX86` with an `Abs64` relocation
 * targeting an undefined data global. `encode_module_x86` never produces this (it
 * raises `B1-globals` first, so a `lea` only ever carries `Pc32`/`Plt32`), but
 * feeding it directly documents and pins the future `R_X86_64_64` data-reloc
 * encoding the writer will emit.
 *
 * @return EncodedModuleX86  the hand-built Abs64 module
 */
fn el_abs64_module(): EncodedModuleX86 {
    var text = [0x48 to byte, 0xB8 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0xC3 to byte]
    var main = Symbol { name = "main"; defined = true; sect = 1 to u8; offset = 0 to u32; local = false }
    var gv = Symbol { name = "gv"; defined = false; sect = 0 to u8; offset = 0 to u32; local = false }
    var reloc = RelocX86 { offset = 2 to u32; sym = "gv"; kind = RelocKindX86::Abs64; addend = 0; sect = RelocSect::Text }
    EncodedModuleX86 { text = text; rodata = teko::list::empty(); symbols = [main, gv]; relocs = [reloc] }
}

#test
/**
 * elf_abs64_emits_r_x86_64_64 — the hand-built `Abs64` module's relocation (at
 * 216) is `R_X86_64_64`(1) against the undefined `gv` (symbol index 2) with
 * addend 0: the writer's correct future data-global encoding, reachable only by a
 * hand-built input since `encode_module_x86` honest-stops on globals first.
 *
 * @return void
 */
fn elf_abs64_emits_r_x86_64_64() {
    var obj = emit_elf(el_abs64_module(), no_dwarf_sink())
    teko::assert::is_true(el_u32_at(obj, 224 to u64) == (1 to u32))
    teko::assert::is_true(el_u32_at(obj, 228 to u64) == (2 to u32))
    teko::assert::is_true(el_u32_at(obj, 232 to u64) == (0 to u32))
}

/**
 * el_drr_module — a hand-built `EncodedModuleX86` shaped like the self-host's
 * `const []T`: a 16-byte `.rodata` whose first 8 bytes are a fat-slot pointer
 * (offset 0, carrying an `Abs64`/`Rodata` relocation at the target leaf) and
 * whose last 8 bytes are the leaf (`0x41` at offset 8), plus a `.text` `lea` that
 * takes the fat slot's address (a `Pc32`/`Text` relocation at the slot symbol).
 * The partition must move the fat slot to `.data.rel.ro` and leave the leaf in
 * `.rodata`, re-pointing the `.text` reference at the `.data.rel.ro` section
 * symbol and the data pointer at the `.rodata` one.
 *
 * @return EncodedModuleX86  the hand-built pointer-bearing-const module
 */
fn el_drr_module(): EncodedModuleX86 {
    var text = [0x48 to byte, 0x8D to byte, 0x05 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0xC3 to byte]
    var rodata = [0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0x41 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte]
    var slot = Symbol { name = "slot"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true }
    var leaf = Symbol { name = "leaf"; defined = true; sect = 2 to u8; offset = 8 to u32; local = true }
    var main = Symbol { name = "main"; defined = true; sect = 1 to u8; offset = 0 to u32; local = false }
    var text_ref = RelocX86 { offset = 3 to u32; sym = "slot"; kind = RelocKindX86::Pc32; addend = (0) - (4); sect = RelocSect::Text }
    var data_ptr = RelocX86 { offset = 0 to u32; sym = "leaf"; kind = RelocKindX86::Abs64; addend = 0; sect = RelocSect::Rodata }
    EncodedModuleX86 { text = text; rodata = rodata; symbols = [slot, leaf, main]; relocs = [text_ref, data_ptr] }
}

#test
/**
 * elf_partition_moves_pointer_const_to_data_rel_ro — the pointer-bearing-const
 * module emits a `.data.rel.ro` section (index 7, non-empty) holding the moved
 * fat slot; its `.rela.data.rel.ro` row is `R_X86_64_64`(1) against the `.rodata`
 * section symbol (index 1) with addend 0 (the leaf rebased to `.rodata` offset 0);
 * the `.text` `lea` relocation re-points at the `.data.rel.ro` section symbol
 * (index 2) as `R_X86_64_PC32`(2) with the base addend −4; and the leaf byte
 * `0x41` now sits at `.rodata` offset 0. This is the exact shape that made the
 * self-host object refuse to link under PIE, proven fixed on emitted BYTES.
 *
 * @return void
 */
fn elf_partition_moves_pointer_const_to_data_rel_ro() {
    var obj = emit_elf(el_drr_module(), no_dwarf_sink())
    teko::assert::is_true(el_section_offset(obj, EL_SHNDX_DATA_REL_RO) > (0 to u64))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_DATA_REL_RO, 0 to u64, EL_RELA_TYPE_FIELD) == (1 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_DATA_REL_RO, 0 to u64, EL_RELA_SYM_FIELD) == (1 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_DATA_REL_RO, 0 to u64, EL_RELA_ADDEND_FIELD) == (0 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_TYPE_FIELD) == (2 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_SYM_FIELD) == (2 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_ADDEND_FIELD) == (0xFFFFFFFC to u32))
    teko::assert::is_true(obj[el_section_offset(obj, 2 to u64)] == (0x41 to byte))
}

#test
/**
 * elf_symbol_index_finds_and_sentinels — `elf_symbol_index` returns a present
 * symbol's index and, for an absent name, the one-past-end sentinel
 * (`syms.len`), covering both arms of the lookup the relocation table relies on.
 *
 * @return void
 */
fn elf_symbol_index_finds_and_sentinels() {
    var syms = [ElfSym { name = ""; info = 0 to u32; shndx = 0 to u32; value = 0 to u32 }, ElfSym { name = "main"; info = 0x12 to u32; shndx = 1 to u32; value = 0 to u32 }]
    teko::assert::is_true(elf_symbol_index(syms, "main") == (1 to u32))
    teko::assert::is_true(elf_symbol_index(syms, "absent") == (2 to u32))
}

/**
 * EL_EHDR_MACHINE_FIELD — the `Elf64_Ehdr.e_machine` byte offset (16 bytes of
 * `e_ident` then the 2-byte `e_type`), read as a little-endian u16.
 */
const EL_EHDR_MACHINE_FIELD: u64 = 18 to u64

/**
 * EL_EHDR_SHOFF_FIELD — the `Elf64_Ehdr.e_shoff` byte offset (the section-header
 * table's file offset), read as a little-endian u32 since every object this
 * writer emits is far below 4 GiB.
 */
const EL_EHDR_SHOFF_FIELD: u64 = 40 to u64

/**
 * EL_EHDR_FLAGS_FIELD — the `Elf64_Ehdr.e_flags` byte offset (the
 * processor-specific ABI flags), read as a little-endian u32.
 */
const EL_EHDR_FLAGS_FIELD: u64 = 48 to u64

/**
 * EL_EHDR_SHNUM_FIELD — the `Elf64_Ehdr.e_shnum` byte offset (the section-header
 * count), read as a little-endian u16 (D1.4: proves the DWARF sink appends
 * exactly five headers).
 */
const EL_EHDR_SHNUM_FIELD: u64 = 60 to u64

/**
 * EL_SHDR_SIZE — the `Elf64_Shdr` stride in the section-header table.
 */
const EL_SHDR_SIZE: u64 = 64 to u64

/**
 * EL_SHDR_TYPE_FIELD — the `Elf64_Shdr.sh_type` offset within a section header
 * (D1.4: distinguishes a `SHT_PROGBITS` DWARF section from a `SHT_RELA` table).
 */
const EL_SHDR_TYPE_FIELD: u64 = 4 to u64

/**
 * EL_SHDR_SIZE_FIELD — the `Elf64_Shdr.sh_size` offset within a section header
 * (D1.4: proves a placed DWARF section's byte size matches its producer output).
 */
const EL_SHDR_SIZE_FIELD: u64 = 32 to u64

/**
 * EL_SHDR_INFO_FIELD — the `Elf64_Shdr.sh_info` offset within a section header
 * (D1.4: a `.rela.debug_*` header's `sh_info` names the section it patches).
 */
const EL_SHDR_INFO_FIELD: u64 = 44 to u64

/**
 * EL_SHDR_OFFSET_FIELD — the `Elf64_Shdr.sh_offset` offset within a section
 * header (the section image's file offset).
 */
const EL_SHDR_OFFSET_FIELD: u64 = 24 to u64

/**
 * EL_SHNDX_RELA_TEXT — `.rela.text`'s fixed section-header index in the writer's
 * section order (`""`, `.text`, `.rodata`, `.symtab`, `.strtab`, `.shstrtab`,
 * `.rela.text`).
 */
const EL_SHNDX_RELA_TEXT: u64 = 6 to u64

/**
 * EL_SHNDX_DATA_REL_RO — `.data.rel.ro`'s fixed section-header index: the
 * seventh header the writer appends when a const carries a pointer relocation,
 * holding the moved fat-slot bytes (`SHF_ALLOC|SHF_WRITE`).
 */
const EL_SHNDX_DATA_REL_RO: u64 = 7 to u64

/**
 * EL_SHNDX_RELA_DATA_REL_RO — `.rela.data.rel.ro`'s fixed section-header index:
 * the eighth header the writer appends, carrying the moved consts' relocations.
 * Naming the index rather than scanning for the first `SHT_RELA` keeps the two
 * relocation tables distinguishable even when `.rela.text` is empty and the two
 * share a file offset.
 */
const EL_SHNDX_RELA_DATA_REL_RO: u64 = 8 to u64

/**
 * EL_RELA_SIZE — the `Elf64_Rela` stride (`r_offset`, `r_info`, `r_addend`).
 */
const EL_RELA_SIZE: u64 = 24 to u64

/**
 * EL_RELA_TYPE_FIELD — the offset, within an `Elf64_Rela`, of `r_info`'s low
 * 32 bits: the `R_<arch>_*` relocation type.
 */
const EL_RELA_TYPE_FIELD: u64 = 8 to u64

/**
 * EL_RELA_SYM_FIELD — the offset, within an `Elf64_Rela`, of `r_info`'s high
 * 32 bits: the target's `.symtab` index.
 */
const EL_RELA_SYM_FIELD: u64 = 12 to u64

/**
 * EL_RELA_ADDEND_FIELD — the offset, within an `Elf64_Rela`, of `r_addend`'s low
 * 32 bits (every addend these fixtures build is small and non-negative).
 */
const EL_RELA_ADDEND_FIELD: u64 = 16 to u64

/**
 * el_section_offset — the file offset of the section whose header sits at index
 * `shndx`, read from the object's own section-header table so a fixture never
 * hardcodes a layout-dependent constant.
 *
 * @param []byte obj  the emitted ELF object bytes
 * @param u64 shndx  the section-header index
 * @return u64  that section's `sh_offset`
 */
fn el_section_offset(obj: []byte, shndx: u64): u64 {
    var shoff = el_u32_at(obj, EL_EHDR_SHOFF_FIELD) to u64
    el_u32_at(obj, shoff + (shndx * EL_SHDR_SIZE) + EL_SHDR_OFFSET_FIELD) to u64
}

/**
 * el_rela_field — one 32-bit field of row `n` of the relocation section at
 * section-header index `shndx`, located through the object's own section-header
 * table so the assertion survives any layout shift.
 *
 * @param []byte obj  the emitted ELF object bytes
 * @param u64 shndx  the relocation section's header index
 * @param u64 n  the zero-based row index within that table
 * @param u64 field  the field's byte offset within the `Elf64_Rela`
 * @return u32  the little-endian u32 at that field
 */
fn el_rela_field(obj: []byte, shndx: u64, n: u64, field: u64): u32 {
    el_u32_at(obj, el_section_offset(obj, shndx) + (n * EL_RELA_SIZE) + field)
}

/**
 * el_shdr_u32 — one 32-bit field of the section header at index `shndx`, located
 * through the object's own section-header table (D1.4's structural-index twin of
 * `el_section_offset`, generalized to any field instead of just `sh_offset`).
 *
 * @param []byte obj  the emitted ELF object bytes
 * @param u64 shndx  the section-header index
 * @param u64 field  the field's byte offset within the `Elf64_Shdr`
 * @return u32  the little-endian u32 at that field
 * @since 0.3.1.0
 */
fn el_shdr_u32(obj: []byte, shndx: u64, field: u64): u32 {
    var shoff = el_u32_at(obj, EL_EHDR_SHOFF_FIELD) to u64
    el_u32_at(obj, shoff + (shndx * EL_SHDR_SIZE) + field)
}

/**
 * el_bytes_eq — whether `a` and `b` hold the same bytes in the same order (D1.4's
 * byte-identity regression check: a `DebugInfo::None` build's object must be
 * indistinguishable from one emitted before the DWARF sink existed).
 *
 * @param []byte a  the first buffer
 * @param []byte b  the second buffer
 * @return bool  true iff `a` and `b` are byte-for-byte identical
 * @since 0.3.1.0
 */
fn el_bytes_eq(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

/**
 * el_arm64_gpr — a physical arm64 GPR operand with the given ISA id (the arm64
 * fixture shorthand; the encoder runs post-regalloc, every operand physical).
 *
 * @param u32 id  the arm64 ISA register number
 * @return MReg  the physical GPR operand
 */
fn el_arm64_gpr(id: u32): MReg {
    preg(id, MRegClass::GPR)
}

/**
 * el_arm64_func — a single-block, frameless arm64 `MFunc` with the given symbol
 * and instruction stream.
 *
 * @param str sym  the function's symbol
 * @param []MInst insts  the block's instructions
 * @return MFunc  the assembled arm64 function
 */
fn el_arm64_func(sym: str, insts: []MInst): MFunc {
    MFunc { symbol = sym; blocks = [MBlock { id = 0 to u32; params = teko::list::empty(); insts = insts }]; frame = teko::list::empty() }
}

/**
 * el_arm64_reloc_module — a frameless arm64 `main` of `adrp x0,"s0"; add-lo
 * x0,x0,"s0"; bl tk_exit` plus one `.rodata` datum `s0 = "A\0"`. Exercises all
 * THREE relocation kinds a real arm64 compile produces — the address pair
 * against a DEFINED `.rodata` local and the branch against an UNDEFINED extern —
 * in one object.
 *
 * @return MModule  the one-function, one-rodata, three-reloc arm64 module
 */
fn el_arm64_reloc_module(): MModule {
    var insts = [adrp_inst(el_arm64_gpr(0), "s0", MRelocKind::PageHi), add_lo_inst(el_arm64_gpr(0), el_arm64_gpr(0), "s0", MRelocKind::PageLo), call_inst("tk_exit", teko::list::empty(), el_arm64_gpr(0), false, false)]
    var rodata = [lir::LRodata { symbol = "s0"; bytes = [0x41 to byte, 0 to byte]; relocs = teko::list::empty() }]
    MModule { funcs = [el_arm64_func("main", insts)]; rodata = rodata; globals = teko::list::empty(); layouts = teko::list::empty() }
}

/**
 * el_arm64_object_of — encode `m` under `AAPCS64` and assemble its AArch64 ELF
 * object, or an empty buffer on an unexpected honest-stop (so a golden field
 * assertion fails loudly rather than aborting the run).
 *
 * @param MModule m  the arm64 module to encode + emit
 * @return []byte  the AArch64 ELF object bytes, or empty on error
 */
fn el_arm64_object_of(m: MModule): []byte {
    match encode_module(AAPCS64, m) {
        EncodedModule as x => emit_elf_arm64(x, no_dwarf_sink())
        error as e => teko::list::empty()
    }
}

#test
/**
 * the AArch64 ELF object's header names AArch64 (`e_machine` = 183) with NO
 * processor flags (`e_flags` = 0), and its three `.rela.text` rows carry the
 * numbers a real `clang --target=aarch64-linux-gnu` object carries for the same
 * four shapes: `ADR_PREL_PG_HI21`(275) then `ADD_ABS_LO12_NC`(277) for the
 * `.rodata` address pair, then `CALL26`(283) for the `bl`. The pair points at
 * the `.rodata` SECTION symbol (index 1, ahead of the global `main` at 2) with
 * the datum's offset folded onto the addend; the `bl` points at the undefined
 * `tk_exit` (index 3, last, as ELF requires). Every assertion is on emitted
 * BYTES, not on the fact that anything compiled.
 *
 * @return void
 */
fn elf_arm64_object_header_and_relas_are_golden() {
    var obj = el_arm64_object_of(el_arm64_reloc_module())
    teko::assert::is_true(el_u16_at(obj, EL_EHDR_MACHINE_FIELD) == (183 to u32))
    teko::assert::is_true(el_u32_at(obj, EL_EHDR_FLAGS_FIELD) == (0 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_TYPE_FIELD) == (275 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_SYM_FIELD) == (1 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_ADDEND_FIELD) == (0 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 1 to u64, EL_RELA_TYPE_FIELD) == (277 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 1 to u64, EL_RELA_SYM_FIELD) == (1 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 2 to u64, EL_RELA_TYPE_FIELD) == (283 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 2 to u64, EL_RELA_SYM_FIELD) == (3 to u32))
}

/**
 * el_arm64_abs64_enc — a hand-built arm64 `EncodedModule` with no functions and
 * a 16-byte `.rodata` = an 8-byte pointer slot at offset 0 (which carries the
 * relocation, so it moves to `.data.rel.ro`) then the target datum at offset 8
 * (a pure leaf that stays in `.rodata`), plus one `Abs64`/`Rodata` relocation.
 * `encode_module` never produces this (its rodata-pointer honest-stop fires
 * first), so feeding `emit_elf_arm64` directly is the only way to pin the
 * `R_AARCH64_ABS64` number the `.rela.data.rel.ro` row carries once the module
 * that produces a pointer-bearing const arrives.
 *
 * @return EncodedModule  the hand-built rodata-internal-pointer arm64 module
 */
fn el_arm64_abs64_enc(): EncodedModule {
    var rodata = [0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0x41 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte, 0 to byte]
    var ptr = Symbol { name = "ptr"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true }
    var target = Symbol { name = "target"; defined = true; sect = 2 to u8; offset = 8 to u32; local = true }
    var rr = Reloc { offset = 0 to u32; sym = "target"; kind = MRelocKind::Abs64; sect = RelocSect::Rodata }
    EncodedModule { text = teko::list::empty(); rodata = rodata; symbols = [ptr, target]; relocs = [rr] }
}

#test
/**
 * an `Abs64` arm64 relocation whose patch site is inside a pointer-bearing const
 * lands in `.rela.data.rel.ro` as `R_AARCH64_ABS64`(257) against the `.rodata`
 * section symbol (the target leaf stays read-only), and NOT in `.rela.text`: the
 * data-rel-ro partition moves the fat-slot bytes to `.data.rel.ro` so the
 * absolute relocation no longer sits in a read-only section (PIE-safe). The pure
 * leaf is the only `.rodata` datum left, so it rebases to offset 0 and the folded
 * addend is 0. The partition `emit_elf_object` performs is ISA-agnostic, so the
 * arm64 and x86 adapters cannot drift.
 *
 * @return void
 */
fn elf_arm64_abs64_lands_in_rela_data_rel_ro() {
    var obj = emit_elf_arm64(el_arm64_abs64_enc(), no_dwarf_sink())
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_DATA_REL_RO, 0 to u64, EL_RELA_TYPE_FIELD) == (257 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_DATA_REL_RO, 0 to u64, EL_RELA_ADDEND_FIELD) == (0 to u32))
    teko::assert::is_true(el_section_offset(obj, EL_SHNDX_DATA_REL_RO) > (0 to u64))
}

/**
 * EL_LDST_LO12_TYPES — every `R_AARCH64_LDST*_ABS_LO12_NC` relocation number
 * (`/usr/include/elf.h`: LDST8=278, LDST16=284, LDST32=285, LDST64=286,
 * LDST128=299). Each patches the SAME 12 bits as `ADD_ABS_LO12_NC` but SCALED by
 * the access size, so any `MRelocKind` mapping to one of these would mis-scale
 * the immediate silently — an object that links and computes garbage.
 */
const EL_LDST_LO12_TYPES: []u32 = [278 to u32, 284 to u32, 285 to u32, 286 to u32, 299 to u32]

/**
 * el_kind_is_not_an_ldst_form — assert that `kind`'s AArch64 ELF relocation type
 * is none of the load/store low-12 forms.
 *
 * @param MRelocKind kind  the relocation kind under test
 * @return void
 */
fn el_kind_is_not_an_ldst_form(kind: MRelocKind) {
    var rtype = elf_reloc_type_arm64(kind)
    var i: u64 = 0
    loop {
        if i >= EL_LDST_LO12_TYPES.len { break }
        teko::assert::is_true(rtype != EL_LDST_LO12_TYPES[i])
        i++
    }
}

#test
/**
 * elf_arm64_reloc_kinds_are_add_form_only — `PageLo` is the `ADD` low-12 form
 * (277), and NO `MRelocKind` maps to any load/store low-12 form. isel attaches a
 * relocation to `MAdrp`/`MAddLo`/`MCall` only, so the day a peephole folds an
 * `add lo12` into an `ldr [x, #lo12]` this assertion fails loudly and the new
 * shape gets the OWN kind it needs, instead of silently inheriting an unscaled
 * immediate.
 *
 * @return void
 */
fn elf_arm64_reloc_kinds_are_add_form_only() {
    teko::assert::is_true(elf_reloc_type_arm64(MRelocKind::PageLo) == (277 to u32))
    el_kind_is_not_an_ldst_form(MRelocKind::PageHi)
    el_kind_is_not_an_ldst_form(MRelocKind::PageLo)
    el_kind_is_not_an_ldst_form(MRelocKind::Call)
    el_kind_is_not_an_ldst_form(MRelocKind::Abs64)
}

#test
/**
 * elf_x86_bytes_are_unchanged_by_the_arm64_adapter — the x86-64 adapter still
 * stamps `e_machine` = 62 and still resolves its rodata reference to
 * `R_X86_64_PC32`(2) against the section symbol with the folded addend. The
 * AArch64 sibling is an ADDITION: it shares `emit_elf_object` and therefore could
 * only have regressed x86 by changing the writer, which it does not.
 *
 * @return void
 */
fn elf_x86_bytes_are_unchanged_by_the_arm64_adapter() {
    var obj = emit_elf(el_rodata_off_module(), no_dwarf_sink())
    teko::assert::is_true(el_u16_at(obj, EL_EHDR_MACHINE_FIELD) == (62 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_TYPE_FIELD) == (2 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_SYM_FIELD) == (1 to u32))
    teko::assert::is_true(el_rela_field(obj, EL_SHNDX_RELA_TEXT, 0 to u64, EL_RELA_ADDEND_FIELD) == (4 to u32))
}
