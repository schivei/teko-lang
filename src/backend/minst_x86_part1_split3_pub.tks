use teko::lir

/**
 * MRetX86 — a return terminator (`ret`). The returned value (if any) is
 * already pinned to RAX/XMM0 by a preceding `MMovX86`, and the epilogue is
 * prepended by the B1 encoder (§6.5), so this case carries no operand — the
 * selection of `LRet`.
 *
 * @since #386 B1-2
 */
pub type MRetX86 = struct { }

/**
 * MFAluX86 — a two-address scalar SSE float ALU op: `dst = dst <op> src`
 * (ADDSD/SUBSD/MULSD/DIVSD, or the `SS` single-precision forms when `!dbl`),
 * the selection of a float `LBin` arithmetic case (`B1-fp`). Destructive like
 * every x86 RMW form: a preceding `MFMovX86` seeds `dst` with the left operand
 * (mirrors `MAluRmX86`'s integer two-address shape, §4.2).
 *
 * @since #386 B1-fp
 */
pub type MFAluX86 = struct {
//
// op — which float ALU mnemonic to emit.
//
    op: MFAluOpX86
//
// dst — the destination register, read and written (the two-address tie).
//
    dst: MReg
//
// src — the second source register operand.
//
    src: MReg
//
// dbl — true for the f64 (`SD`) form, false for the f32 (`SS`) form.
//
    dbl: bool
}

/**
 * MFMovX86 — a register-register move whose operands' OWN `reg_class` fields
 * pick the concrete form: FPR-to-FPR is MOVSD/MOVSS (a scalar float copy,
 * `dbl` selects double/single); GPR-to-FPR or FPR-to-GPR is MOVQ/MOVD (a raw
 * bit-pattern crossing, `dbl` selects the 64-/32-bit transfer) — the selection
 * of `LConstFloat`'s GPR-staged materialization, a parameter/return/edge-move
 * float value, and the bit-extract/bit-rebuild halves of `select_fneg_x86`'s
 * sign-bit flip. One case for both directions, mirroring how arm64's `FMOV`
 * mnemonic itself spans both register files (`fmov_inst`, `isel_arm64.tks`).
 *
 * @since #386 B1-fp
 */
pub type MFMovX86 = struct {
//
// dst — the destination register (its `reg_class` picks the form).
//
    dst: MReg
//
// src — the source register (its `reg_class` picks the form).
//
    src: MReg
//
// dbl — true for the 64-bit (MOVSD/MOVQ) form, false for the 32-bit
// (MOVSS/MOVD) form.
//
    dbl: bool
}

/**
 * MFCmpX86 — a scalar SSE float compare (UCOMISD/UCOMISS) setting flags from
 * `a <=> b`, the selection of a float `LBin` compare — both the plain-VALUE
 * case (`select_fcmp_value_x86`, followed by `MSetccX86`/`MSetPX86`) and the
 * branch-fused case (`select_fused_branch_x86`). The unordered (NaN) result
 * sets CF=PF=ZF=1, which is why every `<`/`<=`/`>`/`>=` selection swaps `a`/
 * `b` to land on the CF-based `HI`/`HS` condition (`B1-fp`, mirrors arm64's
 * `MFCmp`).
 *
 * @since #386 B1-fp
 */
pub type MFCmpX86 = struct {
//
// a — the first compared register operand (ModRM.reg field).
//
    a: MReg
//
// b — the second compared register operand (ModRM.rm field).
//
    b: MReg
//
// dbl — true for the f64 (UCOMISD) form, false for the f32 (UCOMISS) form.
//
    dbl: bool
}

/**
 * MSetPX86 — `dst = (parity) ? 1 : 0` (`SETP`/`SETNP` then `movzx`), reading
 * the PARITY flag a preceding `MFCmpX86` set (1 iff the compared operands are
 * UNORDERED — either is NaN). The x86-only second half of the ordered-equal /
 * unordered-not-equal composite `select_fcmp_value_x86` builds for
 * `FCmpEq`/`FCmpNe` (an `MSetccX86::EQ`/`NE` alone would wrongly call a NaN
 * compare "equal", since UCOMISD also sets ZF on the unordered result) — kept
 * OUT of the shared `MCond` (which `cond_cc_x86`/arm64's own condition mapper
 * both match exhaustively) so this x86-only parity concern never forces an
 * unrelated arm64 file to grow a dead match arm.
 *
 * @since #386 B1-fp
 */
pub type MSetPX86 = struct {
//
// dst — the destination register the 0/1 result is written to.
//
    dst: MReg
//
// is_np — true for `SETNP` (ordered: parity CLEAR), false for `SETP`
// (unordered: parity SET).
//
    is_np: bool
}

/**
 * MCvtX86 — an int/float conversion (CVTSI2SD/CVTTSD2SI/CVTSD2SS/CVTSS2SD),
 * the selection of `IToF`/`FToI`/`FToF` (`B1-fp`, mirrors arm64's `MCvt`).
 *
 * @since #386 B1-fp
 */
pub type MCvtX86 = struct {
//
// op — which conversion mnemonic to emit (fixes both operands' register
// files: `Cvtsi2sd` reads GPR/writes FPR, `Cvttsd2si` reads FPR/writes
// GPR, `Cvtsd2ss`/`Cvtss2sd` read and write FPR).
//
    op: MCvtOpX86
//
// dst — the destination register.
//
    dst: MReg
//
// src — the source register.
//
    src: MReg
}

/**
 * MInstX86 — the x86-64 machine-instruction payload: one of the SysV-keyed
 * cases above. An `MInstX86` carries virtual registers (the shared regalloc
 * colors them) and physical-register pins (the SysV ABI); it holds no encoded
 * bytes. The SSE float family (`MFAluX86`/`MFMovX86`/`MFCmpX86`/`MSetPX86`/
 * `MCvtX86`) closed the `B1-fp` honest-stop (2026-07-29), mirroring arm64's
 * float cases over the parallel two-address x86 shape (§4.1/§4.2), and
 * `MOutArgX86`/`MInArgX86` closed `B1-args`, the stack half of both ABIs'
 * argument passing, while `MFSpillX86` closed the inherited FPR-spill deferral
 * the float family made reachable.
 *
 * @since #386 B1-2, B1-fp, B1-args
 */
pub type MInstX86 = variant MMovImmX86 | MMovX86 | MAluRmX86 | MImulX86 | MDivSeqX86 | MShiftX86 | MCmpX86 | MSetccX86 | MJccX86 | MNegX86 | MNotX86 | MLoadX86 | MStoreX86 | MFrameAddrX86 | MLeaRipX86 | MJmpX86 | MCallX86 | MCallIndX86 | MRetX86 | MFAluX86 | MFMovX86 | MFCmpX86 | MSetPX86 | MCvtX86 | MOutArgX86 | MInArgX86 | MFSpillX86

/**
 * MBlockX86 — an x86-64 machine basic block: its id, its block-args (the
 * SSA-lite merge parameters carried over from LIR block-args), and its
 * instruction stream. Mirrors arm64's `MBlock` shape.
 *
 * @since #386 B1-2
 */
pub type MBlockX86 = struct {
//
// id — the block's identifier, referenced by `MJmpX86`/`MJccX86` targets.
//
    id: u32
//
// params — the block-arg registers a merge into this block carries
// (mirrors `LBlock.params`, threaded through VReg-for-VReg by isel).
//
    params: []MReg
//
// insts — the instruction stream, in order, normally ending in a
// terminator (`MJmpX86`/`MJccX86`/`MRetX86`).
//
    insts: []MInstX86
}

/**
 * MFuncX86 — one selected x86-64 function: its already-mangled symbol, its
 * blocks, and its frame-slot table. Mirrors arm64's `MFunc` shape; the frame
 * table grows one entry per selected `LAlloca` and B1 finalizes each entry's
 * RSP displacement.
 *
 * @since #386 B1-2
 */
pub type MFuncX86 = struct {
//
// symbol — the function's already-mangled (or lifted) symbol.
//
    symbol: str
//
// blocks — the function's machine basic blocks, in selection order.
//
    blocks: []MBlockX86
//
// frame — the reserved frame slots, one entry per selected `LAlloca`, in
// reservation order (each entry reuses `LAlloca`'s byte-size/alignment).
//
    frame: []lir::LAlloca
}

/**
 * MModuleX86 — the whole selected x86-64 program: its functions, plus the
 * rodata/global/struct-layout tables carried THROUGH unchanged from the source
 * `LModule` (the B1 encoder emits their bytes; isel never touches them).
 * Mirrors arm64's `MModule` shape.
 *
 * @since #386 B1-2
 */
pub type MModuleX86 = struct {
//
// funcs — the selected functions, in declaration order.
//
    funcs: []MFuncX86
//
// rodata — the source `LModule`'s rodata table, unchanged.
//
    rodata: []lir::LRodata
//
// globals — the source `LModule`'s globals table, unchanged.
//
    globals: []lir::LGlobal
//
// layouts — the source `LModule`'s struct-layout table, unchanged.
//
    layouts: []lir::LStructLayout
}

/**
 * movimm_x86 — a `dst = imm` instruction (MMovImmX86).
 *
 * @param MReg dst  the destination register
 * @param i64 imm64  the immediate value
 * @param bool wide  true for the 64-bit r64 form, false for 32-bit r32
 * @return MInstX86  the built instruction
 */
pub fn movimm_x86(dst: MReg, imm64: i64, wide: bool) -> MInstX86 {
    MMovImmX86 { dst = dst; imm64 = imm64; wide = wide }
}

/**
 * mov_x86 — a `dst = src` register copy instruction (MMovX86).
 *
 * @param MReg dst  the destination register
 * @param MReg src  the source register
 * @param bool wide  true for the 64-bit r64 form, false for 32-bit r32
 * @return MInstX86  the built instruction
 */
pub fn mov_x86(dst: MReg, src: MReg, wide: bool) -> MInstX86 {
    MMovX86 { dst = dst; src = src; wide = wide }
}

/**
 * alu_rm_x86 — a two-address `dst = dst <op> src` instruction (MAluRmX86).
 *
 * @param MAluOpX86 op  which ALU mnemonic to emit
 * @param MReg dst  the destination register (read and written)
 * @param MReg src  the second source register
 * @param bool wide  true for the 64-bit r64 form, false for 32-bit r32
 * @return MInstX86  the built instruction
 */
pub fn alu_rm_x86(op: MAluOpX86, dst: MReg, src: MReg, wide: bool) -> MInstX86 {
    MAluRmX86 { op = op; dst = dst; src = src; wide = wide }
}

/**
 * imul_x86 — a two-address `dst = dst * src` instruction (MImulX86).
 *
 * @param MReg dst  the destination register (read and written)
 * @param MReg src  the second source register
 * @param bool wide  true for the 64-bit r64 form, false for 32-bit r32
 * @return MInstX86  the built instruction
 */
pub fn imul_x86(dst: MReg, src: MReg, wide: bool) -> MInstX86 {
    MImulX86 { dst = dst; src = src; wide = wide }
}

/**
 * divseq_x86 — a fixed-register `dst = a / b` (or `a % b`) instruction
 * (MDivSeqX86), the whole idiv/div RAX/RDX sequence as one macro case.
 *
 * @param MReg dst  the destination register
 * @param MReg a  the dividend register
 * @param MReg b  the divisor register
 * @param bool is_signed  true for signed (idiv/cqo), false for unsigned (div)
 * @param bool is_rem  true for the remainder (RDX), false for the quotient (RAX)
 * @param bool wide  true for the 64-bit r64 form, false for 32-bit r32
 * @return MInstX86  the built instruction
 */
pub fn divseq_x86(dst: MReg, a: MReg, b: MReg, is_signed: bool, is_rem: bool, wide: bool) -> MInstX86 {
    MDivSeqX86 { dst = dst; a = a; b = b; is_signed = is_signed; is_rem = is_rem; wide = wide }
}
