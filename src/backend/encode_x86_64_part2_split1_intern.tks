use teko::list

fn encode_neg_x86(i: MNegX86) -> EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86(teko::list::empty(), i.wide, X86_OP_GRP3_F7, X86_EXT_NEG, i.dst))
}

/**
 * encode_not_x86 — a two-address complement (`not r/m64`, `F7 /2`).
 *
 * @param MNotX86 i  the complement instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_not_x86(i: MNotX86) -> EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86(teko::list::empty(), i.wide, X86_OP_GRP3_F7, X86_EXT_NOT, i.dst))
}

/**
 * encode_load_x86 — a memory load (`mov`/`movsx`/`movsd`/`movss dst,
 * [base+disp]`) per `load_memop_x86`'s size/sign descriptor, addressing `mem`
 * (SIB `0x24` when the base is RSP/R12, forced disp8 when RBP/R13). An
 * FPR-class destination (`F32`/`F64` size) is a scalar SSE move (`B1-fp`).
 *
 * @param MLoadX86 i  the load instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_load_x86(i: MLoadX86) -> EncInstX86 {
    emit_mem_op_x86(load_memop_x86(i.size, i.sign), i.dst, i.mem)
}

/**
 * encode_store_x86 — a memory store (`mov`/`movsd`/`movss [base+disp], src`)
 * per `store_memop_x86`'s size descriptor, addressing `mem`. An FPR-class
 * source (`F32`/`F64` size) is a scalar SSE move (`B1-fp`).
 *
 * @param MStoreX86 i  the store instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_store_x86(i: MStoreX86) -> EncInstX86 {
    emit_mem_op_x86(store_memop_x86(i.size), i.src, i.mem)
}

/**
 * RSP_BASE_X86 — the physical RSP register as a memory-operand base, the one
 * base every frame-relative access in this file addresses through (frame slots,
 * the callee-saved XMM saves, and both halves of the stack-argument area). A
 * flat-POD `MReg` aggregate const (#594 crumb 9b).
 */
const RSP_BASE_X86: MReg = preg(X86_REG_RSP_ID, MRegClass::GPR)

/**
 * in_arg_base_x86 — the RSP-relative byte offset of the FIRST incoming
 * stack-argument slot (`B1-args`). The caller placed stack argument `j` at
 * `entry_rsp + 8 + caller_shadow + 8*j` (past the return address `call` pushed and
 * past the shadow area it reserved at its own RSP), and the prologue has since
 * moved RSP down by `push rbp` (8) + one push per callee-saved GPR + the
 * `sub rsp` region — so a FRAMED function reads it at
 * `16 + 8*n_saved + size + caller_shadow + 8*j` and a frameless one at
 * `8 + caller_shadow + 8*j`. Resolved here rather than at isel because only the
 * finished layout knows those numbers.
 *
 * THE `caller_shadow` TERM IS THE MIRROR OF `out_arg_base`, and its absence was a
 * measured Win64 defect: the caller stores stack argument 0 at `rsp + 32`
 * (`encode_out_arg_x86` through `out_arg_base`) while the callee read the same
 * argument 32 bytes lower, inside the home space instead of the argument. SysV
 * keeps `shadow_space` 0, so every SysV offset here is byte-identical.
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @return u32  the RSP-relative offset of incoming stack-argument slot 0
 */
fn in_arg_base_x86(layout: FrameLayoutX86) -> u32 {
    if !frame_is_framed_x86(layout) { return X86_GPR_BYTES + layout.caller_shadow }
    let n_saved = layout.saved_gpr.len to u32
    (2 to u32) * X86_GPR_BYTES + (n_saved * X86_GPR_BYTES) + layout.size + layout.caller_shadow
}

/**
 * encode_fspill_x86 — resolve `MFSpillX86{reg, slot, is_load}` to
 * `movsd [rsp + slot_offsets[slot]], xmm` (or the load direction), the scalar SSE
 * memory move at the 8-byte width, reusing `store_memop_x86`/`load_memop_x86`
 * so an FPR spill is encoded by exactly the code every other float memory access
 * goes through (`B1-fp`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MFSpillX86 i  the spill store or reload (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_fspill_x86(layout: FrameLayoutX86, i: MFSpillX86) -> EncInstX86 {
    let mem = MMem { base = RSP_BASE_X86; offset = layout.slot_offsets[i.slot] to i32 }
    let form = if i.is_load { load_memop_x86(MMemSizeX86::F64, false) } else { store_memop_x86(MMemSizeX86::F64) }
    emit_mem_op_x86(form, i.reg, mem)
}

/**
 * encode_out_arg_x86 — resolve `MOutArgX86{size, src, index}` to
 * `mov [rsp + out_arg_base + 8*index], src` at the argument's own transfer width
 * (an SSE `movsd`/`movss` for a float argument), reusing `store_memop_x86` so a
 * stack argument is encoded by exactly the code every other store goes through
 * (`B1-args`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MOutArgX86 i  the outgoing stack-argument store (source physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_out_arg_x86(layout: FrameLayoutX86, i: MOutArgX86) -> EncInstX86 {
    let off = layout.out_arg_base + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(store_memop_x86(i.size), i.src, MMem { base = RSP_BASE_X86; offset = off to i32 })
}

/**
 * encode_in_arg_x86 — resolve `MInArgX86{size, dst, index}` to
 * `mov dst, [rsp + in_arg_base + 8*index]` at the parameter's own transfer width,
 * reusing `load_memop_x86`'s zero-extending descriptor (`sign = false`, matching
 * every other load this backend emits) (`B1-args`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MInArgX86 i  the incoming stack-parameter load (destination physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_in_arg_x86(layout: FrameLayoutX86, i: MInArgX86) -> EncInstX86 {
    let off = in_arg_base_x86(layout) + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(load_memop_x86(i.size, false), i.dst, MMem { base = RSP_BASE_X86; offset = off to i32 })
}

/**
 * encode_frame_addr_x86 — resolve `MFrameAddrX86{dst, slot}` to
 * `lea dst, [rsp + slot_offsets[slot]]` (`REX.W 8D /r`). The RSP base (id 4)
 * forces a SIB byte `0x24` (emitted by `push_mem_operand_x86`), the single most
 * common x86 encoding mistake; frame addresses are always 64-bit.
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MFrameAddrX86 i  the frame-slot address instruction (destination physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_frame_addr_x86(layout: FrameLayoutX86, i: MFrameAddrX86) -> EncInstX86 {
    let off = layout.slot_offsets[i.slot]
    let mem = MMem { base = RSP_BASE_X86; offset = off to i32 }
    mut b = push_rex_x86(teko::list::empty(), true, reg_ext_x86(i.dst), false, reg_ext_x86(mem.base))
    b = push_byte_x86(b, X86_OP_LEA)
    plain_inst_x86(push_mem_operand_x86(b, reg_low3_x86(i.dst), mem))
}

/**
 * encode_lea_rip_x86 — a rip-relative address load (`lea dst, [rip+disp32]`,
 * `REX.W 8D /r` with `mod=00 rm=101`): the disp32 is a zeroed placeholder the
 * B1-7 ELF writer relocates (`R_X86_64_PC32`/`PLT32`), collapsing arm64's
 * ADRP+ADD pair into one instruction + one relocation (§4.3).
 *
 * @param MLeaRipX86 i  the address-materialization instruction (operand physical)
 * @return EncInstX86  the reloc-flagged placeholder instruction
 */
fn encode_lea_rip_x86(i: MLeaRipX86) -> EncInstX86 {
    mut b = push_rex_forced_x86(teko::list::empty(), true, reg_ext_x86(i.dst), false, false)
    b = push_byte_x86(b, X86_OP_LEA)
    b = push_byte_x86(b, modrm_x86(MODRM_MOD_INDIRECT, reg_low3_x86(i.dst), MODRM_RM_RIP_RELATIVE))
    let field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, i.kind)
}

/**
 * encode_jmp_x86 — an unconditional branch (`jmp rel32`, `E9 cd`): the rel32 is
 * a zeroed placeholder the B1-6 layout pass patches with the block displacement.
 *
 * @param MJmpX86 i  the unconditional-branch instruction
 * @return EncInstX86  the branch-flagged placeholder instruction
 */
fn encode_jmp_x86(i: MJmpX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_JMP_REL32)
    let field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

/**
 * encode_jcc_x86 — a conditional branch (`jcc rel32`, `0F 80+cc cd`): the rel32
 * is a zeroed placeholder the B1-6 layout pass patches; the condition byte is
 * position-independent.
 *
 * @param MJccX86 i  the conditional-branch instruction
 * @return EncInstX86  the branch-flagged placeholder instruction
 */
fn encode_jcc_x86(i: MJccX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_JCC_BASE + cond_cc_x86(i.cond))
    let field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

/**
 * encode_call_x86 — a direct call (`call rel32`, `E8 cd`): the rel32 is a
 * zeroed placeholder, flagged for a `Plt32` (`R_X86_64_PLT32`) relocation on
 * the callee symbol (addend −4 supplied by the B1-7 writer).
 *
 * @param MCallX86 i  the direct-call instruction
 * @return EncInstX86  the reloc-flagged placeholder instruction
 */
fn encode_call_x86(i: MCallX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_CALL_REL32)
    let field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, RelocKindX86::Plt32)
}

/**
 * encode_call_ind_x86 — an indirect call through a register (`call r/m64`,
 * `FF /2`): a position-independent instruction (no relocation, no displacement).
 *
 * @param MCallIndX86 i  the indirect-call instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_call_ind_x86(i: MCallIndX86) -> EncInstX86 {
    mut b = push_rex_x86(teko::list::empty(), false, false, false, reg_ext_x86(i.target))
    b = push_byte_x86(b, X86_OP_GRP5_FF)
    plain_inst_x86(push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, X86_EXT_CALL_IND, reg_low3_x86(i.target))))
}

/**
 * encode_ret_x86 — a return terminator (`ret`, `C3`). The B1-6 frame slice
 * prepends the epilogue; the B1-5 core emits only the bare `ret` byte (the
 * arm64 A4-1 `encode_ret` precedent).
 *
 * @return EncInstX86  the `ret` instruction
 */
fn encode_ret_x86() -> EncInstX86 {
    plain_inst_x86(push_byte_x86(teko::list::empty(), X86_OP_RET))
}

/**
 * scan_inst_saved_x86 — fold one physical instruction's def and use registers
 * into the callee-saved partition (via `inst_regs_x86`, the same def/use
 * decomposition the regalloc reads — the emitted instructions ARE the source of
 * truth, mirroring arm64's `scan_inst_saved`). Reuses the neutral `consider_reg`
 * so the caller-saved/non-allocatable filtering + ascending insert stay
 * single-sourced.
 *
 * @param AbiDescriptor abi  the register file (callee-saved partition)
 * @param Saved acc0  the partition so far
 * @param MInstX86 inst  the physical instruction to scan
 * @return Saved  the partition with `inst`'s registers folded in
 */
fn scan_inst_saved_x86(abi: AbiDescriptor, acc0: Saved, inst: MInstX86) -> Saved {
    let ir = inst_regs_x86(inst)
    mut acc = acc0
    if ir.has_def {
        acc = consider_reg(abi, acc, ir.def_reg)
    }
    mut i: u64 = 0
    loop {
        if i >= ir.uses.len { break }
        acc = consider_reg(abi, acc, ir.uses[i])
        i++
    }
    acc
}
