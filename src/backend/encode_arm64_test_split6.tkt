/**
 * enc_rodata_reloc_offset_survives_odd_length_neighbors — the native-rodata-const-align
 * regression (macOS-arm64 fixpoint `ld: pointer not aligned` on `AAPCS64.gpr_arg`): TWO
 * odd/non-8-multiple rodata entries (3 bytes, then 6 bytes — their RUNNING total, 9, is NOT
 * a multiple of 8) precede a THIRD, POINTER-BEARING entry carrying one `LDataReloc`. The
 * third entry's symbol offset AND its rebased relocation offset both land on 16 — the next
 * 8-byte boundary after 9 — never on the unaligned 9 a byte-packed concatenation would
 * produce. `module_interns_rodata_into_const` already proves the SYMBOL offset survives one
 * odd-length neighbor; this is its reloc-bearing, two-neighbor sibling — the exact
 * combination (a fat member's `LDataReloc` rebased across several odd-length preceding
 * entries) the reported link failure needed and no prior fixture exercised.
 *
 * @return void
 */
fn enc_rodata_reloc_offset_survives_odd_length_neighbors() {
    let r0 = lir::LRodata { symbol = "s0"; bytes = n_zero_bytes(3 to u64); relocs = teko::list::empty() }
    let r1 = lir::LRodata { symbol = "s1"; bytes = n_zero_bytes(6 to u64); relocs = teko::list::empty() }
    let r2_relocs = teko::list::push(teko::list::empty(), lir::data_reloc(0 to u32, "s0"))
    let r2 = lir::LRodata { symbol = "s2"; bytes = n_zero_bytes(16 to u64); relocs = r2_relocs }
    let rodata = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), r0), r1), r2)
    let f = one_block_func("main", i1(RET_INST))
    let funcs = teko::list::push(teko::list::empty(), f)
    let e = em(module_with_rodata(funcs, rodata))
    teko::assert::is_true(e.symbols[2].name == "s2")
    teko::assert::is_true(e.symbols[2].offset == (16 to u32))
    teko::assert::is_true(e.relocs.len == 1)
    teko::assert::is_true(e.relocs[0].offset == (16 to u32))
    teko::assert::is_true(e.relocs[0].offset % (8 to u32) == (0 to u32))
    teko::assert::is_true(e.relocs[0].sect == RelocSect::Rodata)
}

#test

/**
 * find_rodata_align_violations_is_empty_for_aligned_relocs — the diagnostic's pure detection
 * core (`TEKO_NATIVE_RODATA_ALIGN_CHECK`'s engine) reports NOTHING for a symbol table + reloc
 * list where every rodata-internal pointer relocation already sits on an 8-byte boundary — the
 * ordinary, well-formed case `encode_rodata` always produces today.
 *
 * @return void
 */
fn find_rodata_align_violations_is_empty_for_aligned_relocs() {
    let syms = teko::list::push(teko::list::push(teko::list::empty(), Symbol { name = "s0"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true }), Symbol { name = "s1"; defined = true; sect = 2 to u8; offset = 16 to u32; local = true })
    let relocs = teko::list::push(teko::list::empty(), lir::data_reloc(16 to u32, "s0"))
    teko::assert::is_true(find_rodata_align_violations(syms, relocs).len == 0)
}

#test

/**
 * find_rodata_align_violations_names_the_owning_symbol — the diagnostic's pure detection core
 * ATTRIBUTES a misaligned relocation (offset 9, no symbol starts exactly there) to the nearest
 * PRECEDING rodata symbol (`s0`, at offset 0) — the same "symbol+displacement" rule a linker's
 * own alignment diagnostic applies — and reports the next 8-aligned offset (16) it should have
 * landed on. This is the pure core `enc_rodata_reloc_offset_survives_odd_length_neighbors`
 * proves `encode_rodata` itself never produces; this fixture proves the DIAGNOSTIC would name
 * the right culprit if some OTHER producer ever did.
 *
 * @return void
 */
fn find_rodata_align_violations_names_the_owning_symbol() {
    let syms = teko::list::push(teko::list::empty(), Symbol { name = "s0"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true })
    let relocs = teko::list::push(teko::list::empty(), lir::data_reloc(9 to u32, "leaf"))
    let violations = find_rodata_align_violations(syms, relocs)
    teko::assert::is_true(violations.len == 1)
    teko::assert::is_true(violations[0].owner == "s0")
    teko::assert::is_true(violations[0].target == "leaf")
    teko::assert::is_true(violations[0].offset == (9 to u32))
    teko::assert::is_true(violations[0].expected == (16 to u32))
}

#test

/**
 * module_globals_honest_stops — a module carrying a top-level data global raises
 * the `A4-globals` named honest-stop (the `__data` section is deferred; the N2
 * subset lowers none).
 *
 * @return void
 */
fn module_globals_honest_stops() {
    let f = one_block_func("main", i1(RET_INST))
    let funcs = teko::list::push(teko::list::empty(), f)
    let globals = teko::list::push(teko::list::empty(), lir::LGlobal { symbol = "gv"; ty = lir::LType::I32; bytes = l_bytes() })
    let m = MModule { funcs = funcs; rodata = teko::list::empty(); globals = globals; layouts = teko::list::empty() }
    teko::assert::str_contains(em_stop(m), "A4-globals")
}

#test

/**
 * module_propagates_function_honest_stop — a function that honest-stops during
 * encode (a non-inline ALU immediate → `A4-bigimm`) propagates the stop out of
 * `encode_module` unchanged. It USED to name a float op; the float family now
 * encodes (0.3.1.0 degrau 29), so the propagation is proven through a stop that
 * still lives.
 *
 * @return void
 */
fn module_propagates_function_honest_stop() {
    let f = one_block_func("main", i1(alu_imm_inst(MAluOp::Add, true, p(0), p(1), 5000)))
    teko::assert::str_contains(em_stop(add_mfunc(empty_mmodule(), f)), "A4-bigimm")
}

/**
 * l0_ew — the empty `[]EncWord` list, typed for the big-frame-addr fixtures.
 *
 * @return []EncWord  an empty `EncWord` list
 */
fn l0_ew() -> []EncWord {
    teko::list::empty()
}

/**
 * faw — `encode_frame_addr_words(layout, fa)`, unwrapping the success case
 * and falling back to the empty list on an unexpected honest-stop (so a
 * golden length/word assertion fails loudly rather than aborting).
 *
 * @param FrameLayout layout  the enclosing frame
 * @param MFrameAddr fa  the frame-slot address instruction
 * @return []EncWord  the encoded word(s), or empty on error
 */
fn faw(layout: FrameLayout, fa: MFrameAddr) -> []EncWord {
    match encode_frame_addr_words(layout, fa) {
        []EncWord as w => w
        error as e => l0_ew()
    }
}

/**
 * faw_stop — the honest-stop message `encode_frame_addr_words` produces for
 * `(layout, fa)`, or `<ok>` when it encodes successfully.
 *
 * @param FrameLayout layout  the enclosing frame
 * @param MFrameAddr fa  the frame-slot address instruction
 * @return str  the error message, or `<ok>`
 */
fn faw_stop(layout: FrameLayout, fa: MFrameAddr) -> str {
    match encode_frame_addr_words(layout, fa) {
        []EncWord as w => "<ok>"
        error as e => e.message
    }
}

#test

/**
 * big_frame_addr_words_chain_the_add_sequence — `encode_frame_addr_words`
 * expands a big `MFrameAddr` slot offset (past the 12-bit ADD-imm field) into
 * the chained `big_offset_words` ADD sequence: `add p0, sp, #1, LSL #12` then
 * `add p0, p0, #904` for `off=5000` (`5000 = (1<<12)+904`) — the SAME
 * displacement `big_frame_addr_honest_stops` proved `encode_inst_word` alone
 * still stops on; this is the layer above that resolves it. Neither word
 * carries a branch or reloc fixup (both position-independent).
 *
 * @return void
 */
fn big_frame_addr_words_chain_the_add_sequence() {
    let fl = layout_of(8192 to u32, l0(), l0(), l1(5000))
    let ws = faw(fl, MFrameAddr { dst = p(0); slot = 0 to u64 })
    teko::assert::is_true(ws.len == 2)
    teko::assert::is_true(ws[0].word == (0x914007E0 to u32))
    teko::assert::is_true(ws[1].word == (0x910E2000 to u32))
    teko::assert::is_false(ws[0].has_branch)
    teko::assert::is_true(ws[0].reloc == null)
    teko::assert::is_false(ws[1].has_branch)
    teko::assert::is_true(ws[1].reloc == null)
}

#test

/**
 * small_frame_addr_words_matches_encode_inst_word — a slot offset within the
 * inline field resolves through `encode_frame_addr_words` to exactly the SAME
 * single word `encode_inst_word` would (byte-identical delegation, no
 * duplicated bit-slicing): slot 1 sits at offset 16, so both resolve to
 * `add p3, sp, #16` (`0x910043E3`).
 *
 * @return void
 */
fn small_frame_addr_words_matches_encode_inst_word() {
    let fl = layout_of(48 to u32, l0(), l0(), l3(0, 16, 24))
    let ws = faw(fl, MFrameAddr { dst = p(3); slot = 1 to u64 })
    teko::assert::is_true(ws.len == 1)
    teko::assert::is_true(ws[0].word == (0x910043E3 to u32))
}

#test

/**
 * frame_addr_words_succeeds_at_the_imm24_boundary — `ARM64_IMM24_FIELD_MAX`
 * itself (`2^24-1 = 16777215`) is the LARGEST offset the two-word chained
 * sequence reaches: it still resolves (two words), one past it does not
 * (`frame_addr_words_honest_stops_past_imm24`, below).
 *
 * @return void
 */
fn frame_addr_words_succeeds_at_the_imm24_boundary() {
    let fl = layout_of(20000000 to u32, l0(), l0(), l1(16777215))
    let ws = faw(fl, MFrameAddr { dst = p(3); slot = 0 to u64 })
    teko::assert::is_true(ws.len == 2)
    teko::assert::is_true(ws[0].word == (0x917FFFE3 to u32))
    teko::assert::is_true(ws[1].word == (0x913FFC63 to u32))
}

#test

/**
 * frame_addr_words_honest_stops_past_imm24 — an `MFrameAddr` slot offset one
 * past `ARM64_IMM24_FIELD_MAX` (past what two chained 12-bit lanes reach)
 * still raises `A4-bigframe` — the residual ceiling `big_offset_words`
 * documents (an unreached, three-instruction-or-scratch-register case).
 *
 * @return void
 */
fn frame_addr_words_honest_stops_past_imm24() {
    let fl = layout_of(20000000 to u32, l0(), l0(), l1(16777216))
    teko::assert::str_contains(faw_stop(fl, MFrameAddr { dst = p(0); slot = 0 to u64 }), "A4-bigframe")
}

#test

/**
 * frame_fits_boundary — `frame_fits`'s own exact ceiling: a `size` whose
 * FP/LR pair offset scales to exactly `ARM64_IMM7_MAX_POS` (`63`, i.e.
 * `size - 16 = 504`) fits; one 8 bytes past it does not.
 *
 * @return void
 */
fn frame_fits_boundary() {
    teko::assert::is_true(frame_fits(layout_of(520 to u32, l0(), l0(), l0())))
    teko::assert::is_false(frame_fits(layout_of(528 to u32, l0(), l0(), l0())))
}

#test

/**
 * big_frame_fits_boundary — `big_frame_fits`'s own exact ceiling: a `size`
 * whose FP/LR pair offset is exactly `ARM64_STR_LDR_FIELD_MAX_BYTES`
 * (`32760`, i.e. `size - 16 = 32760`) fits; one byte past it does not.
 *
 * @return void
 */
fn big_frame_fits_boundary() {
    teko::assert::is_true(big_frame_fits(layout_of(32776 to u32, l0(), l0(), l0())))
    teko::assert::is_false(big_frame_fits(layout_of(32777 to u32, l0(), l0(), l0())))
}

#test

/**
 * div_zero_guard_encodes_compare_branch_call_and_selfloop — the div-by-zero guard's
 * three-block shape (0.3.1 div-by-zero-nativo), hand-built at the `MInst` level exactly as
 * `select_lfunc` selects `teko::lir::lower_div_zero_guard`'s LIR (a materialized-zero `cmp`
 * fused into a `b.ne`, an unconditional fallthrough to the trap block, `bl tk_panic_div0`,
 * an unconditional branch TO ITS OWN block — the dead terminator after a call that never
 * returns — then the guarded `sdiv`), byte-exact and assembler-verified:
 *
 *   b0:  sub sp, sp, #0x10 ; stp x29, x30, [sp] ; mov x29, sp   (auto LR-save prologue —
 *        `needs_lr_save`, A4-2: this function BOTH calls and returns)
 *        movz x2, #0                       ; the materialized zero divisor is compared against
 *        cmp  x1, x2                       ; fused compare (divisor vs zero)
 *        b.ne #M1                          ; nonzero divisor takes the "ok" edge
 *        b    #M2                          ; zero divisor falls through to the "trap" edge
 *   b1:  sdiv x3, x0, x1                   ; the guarded quotient (dividend/divisor)
 *        ldp x29, x30, [sp] ; add sp, sp, #0x10 ; ret   (the epilogue attached to THIS `ret`)
 *   b2:  bl tk_panic_div0                  ; the SAME symbol the C route's `tk_div_*` calls
 *        b    #M2                          ; self-loop — the call never returns
 *
 * @return void
 */
fn div_zero_guard_encodes_compare_branch_call_and_selfloop() {
    let b0 = mblock(0 to u32, i4(movz_inst(true, p(2), 0, 0), cmp_inst(true, p(1), p(2)), branch_cond_inst(MCond::NE, 1 to u32), branch_inst(2 to u32)))
    let b1 = mblock(1 to u32, i2(alu_inst(MAluOp::Sdiv, true, p(3), p(0), p(1)), RET_INST))
    let no_uses: []MReg = teko::list::empty()
    let b2 = mblock(2 to u32, i2(call_inst("tk_panic_div0", no_uses, p(0), false, false), branch_inst(2 to u32)))
    let e = ef(func_blocks(bl3(b0, b1, b2)))
    teko::assert::is_true(e.words.len == 13)
    teko::assert::is_true(e.words[0] == (0xD10043FF to u32))
    teko::assert::is_true(e.words[1] == (0xA9007BFD to u32))
    teko::assert::is_true(e.words[2] == (0x910003FD to u32))
    teko::assert::is_true(e.words[3] == (0xD2800002 to u32))
    teko::assert::is_true(e.words[4] == (0xEB02003F to u32))
    teko::assert::is_true(e.words[5] == (0x54000041 to u32))
    teko::assert::is_true(e.words[6] == (0x14000005 to u32))
    teko::assert::is_true(e.words[7] == (0x9AC10C03 to u32))
    teko::assert::is_true(e.words[8] == (0xA9407BFD to u32))
    teko::assert::is_true(e.words[9] == (0x910043FF to u32))
    teko::assert::is_true(e.words[10] == (0xD65F03C0 to u32))
    teko::assert::is_true(e.words[11] == (0x94000000 to u32))
    teko::assert::is_true(e.words[12] == (0x17FFFFFF to u32))
    teko::assert::is_true(e.relocs.len == 1)
    teko::assert::is_true(e.relocs[0].offset == (44 to u32))
    teko::assert::is_true(e.relocs[0].sym == "tk_panic_div0")
    teko::assert::is_true(kind_name(e.relocs[0].kind) == "Call")
}
