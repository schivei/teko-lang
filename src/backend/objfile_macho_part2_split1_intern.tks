fn emit_segment(buf: []byte, lay: MachoLayout) -> []byte {
    let seg_cmdsize = 72 + lay.nsects * 80
    let data_size = lay.const_addr + lay.const_size
    mut b = emit_u32_le(buf, MACHO_LC_SEGMENT_64)
    b = emit_u32_le(b, seg_cmdsize)
    b = emit_fixed16(b, "")
    b = emit_u64_le(b, 0)
    b = emit_u64_le(b, align_up(data_size, 16) to u64)
    b = emit_u64_le(b, lay.text_offset to u64)
    b = emit_u64_le(b, data_size to u64)
    b = emit_u32_le(b, 7)
    b = emit_u32_le(b, 7)
    b = emit_u32_le(b, lay.nsects)
    b = emit_u32_le(b, 0)
    let text_reloff = if lay.nreloc > 0 { lay.reloc_offset } else { 0 }
    b = emit_section(b, "__text", "__TEXT", 0, lay.text_size, lay.text_offset, 2, text_reloff, lay.nreloc, S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS)
    if lay.nsects > 1 {
        let const_reloff = if lay.nreloc_const > 0 { lay.const_reloc_offset } else { 0 }
        let const_segname = if lay.nreloc_const > 0 { "__DATA" } else { "__TEXT" }
        b = emit_section(b, "__const", const_segname, lay.const_addr, lay.const_size, lay.const_offset, 3, const_reloff, lay.nreloc_const, 0)
    }
    b
}

/**
 * emit_dwarf_segment — the `__DWARF` `LC_SEGMENT_64` load command (D1.5): a
 * SECOND, separately-named segment (unlike the unnamed `__TEXT` segment
 * `emit_segment` writes) carrying `__debug_abbrev`/`__debug_info`/`__debug_line`,
 * each `S_ATTR_DEBUG`, `maxprot`/`initprot` both `VM_PROT_NONE` (0) since a debug
 * segment is never mapped at runtime. Its `vmaddr` continues immediately after
 * the `__TEXT` segment's own 16-byte-aligned `vmsize`, so the two segments'
 * virtual-address ranges never overlap even though neither is ever loaded from
 * this relocatable object (the static linker recomputes final addresses). Only
 * called when the layout was computed with `dwarf.present` (the caller's
 * `has_dwarf` gate); every section here is `SHT`-unallocated in spirit — Mach-O
 * expresses that as `S_ATTR_DEBUG`, not a missing flag the way ELF's
 * `SHF_ALLOC` works.
 *
 * @param []byte buf  the buffer to extend
 * @param MachoLayout lay  the resolved layout
 * @return []byte  `buf` followed by the `__DWARF` segment command and its three sections
 * @since 0.3.1.0
 */
fn emit_dwarf_segment(buf: []byte, lay: MachoLayout) -> []byte {
    let dwarf_nsects: u32 = 3
    let seg_cmdsize = 72 + dwarf_nsects * 80
    let vmaddr = align_up(lay.const_addr + lay.const_size, 16)
    let data_size = lay.debug_abbrev_size + lay.debug_info_size + lay.debug_line_size
    mut b = emit_u32_le(buf, MACHO_LC_SEGMENT_64)
    b = emit_u32_le(b, seg_cmdsize)
    b = emit_fixed16(b, "__DWARF")
    b = emit_u64_le(b, vmaddr to u64)
    b = emit_u64_le(b, align_up(data_size, 16) to u64)
    b = emit_u64_le(b, lay.debug_abbrev_offset to u64)
    b = emit_u64_le(b, data_size to u64)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, dwarf_nsects)
    b = emit_u32_le(b, 0)
    b = emit_section(b, "__debug_abbrev", "__DWARF", vmaddr, lay.debug_abbrev_size, lay.debug_abbrev_offset, 0, 0, 0, S_ATTR_DEBUG)
    let info_addr = vmaddr + lay.debug_abbrev_size
    let info_reloff = if lay.nreloc_debug_info > 0 { lay.debug_info_reloc_offset } else { 0 }
    b = emit_section(b, "__debug_info", "__DWARF", info_addr, lay.debug_info_size, lay.debug_info_offset, 0, info_reloff, lay.nreloc_debug_info, S_ATTR_DEBUG)
    let line_addr = info_addr + lay.debug_info_size
    let line_reloff = if lay.nreloc_debug_line > 0 { lay.debug_line_reloc_offset } else { 0 }
    emit_section(b, "__debug_line", "__DWARF", line_addr, lay.debug_line_size, lay.debug_line_offset, 0, line_reloff, lay.nreloc_debug_line, S_ATTR_DEBUG)
}

/**
 * emit_dwarf_reloc_table — one DWARF section's `relocation_info` array (D1.5): one 8-byte entry per
 * `DwReloc` — the section-relative `r_address`, then the packed word for an EXTERNAL, non-PC-relative,
 * 8-byte absolute fixup (`ARM64_RELOC_UNSIGNED`, `r_length = 3`, `r_pcrel = 0`, `r_extern = 1`), the
 * SAME encoding `reloc_type_value`/`reloc_pcrel`/`reloc_length` give `MRelocKind::Abs64` — spelled
 * directly here since a `DwReloc` carries no `MRelocKind` (DWARF relocations are always this one
 * shape: a `.text`-symbol low_pc or set_address slot, never PC-relative, never a narrower field).
 *
 * @param []byte buf  the buffer to extend
 * @param []DwReloc relocs  the section's relocations to emit
 * @param []Symbol symbols  the symbol table, for `r_symbolnum` indices
 * @return []byte  `buf` followed by the relocation entries
 * @since 0.3.1.0
 */
fn emit_dwarf_reloc_table(buf: []byte, relocs: []DwReloc, symbols: []Symbol) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= relocs.len { break }
        let r = relocs[i]
        b = emit_u32_le(b, r.offset to u32)
        let symnum = sym_index(symbols, r.symbol)
        let packed = symnum | (0 << 24) | (3 << 25) | (1 << 27) | (ARM64_RELOC_UNSIGNED << 28)
        b = emit_u32_le(b, packed to u32)
        i++
    }
    b
}

/**
 * emit_dwarf_body — append the DWARF section data and relocation tables (D1.5): 4-align, then the
 * `__debug_abbrev`/`__debug_info`/`__debug_line` bytes, contiguous (matching
 * `compute_macho_layout`'s no-padding-between-sections chain), then 4-align again and the
 * `__debug_info`/`__debug_line` `relocation_info` tables. Placed AFTER the existing `__text`/
 * `__const` relocation tables so their file offsets (`reloc_offset`/`const_reloc_offset`) never
 * move — D1.5 is strictly additive at the tail, the same shape D1.4's `emit_elf_dwarf_body` follows.
 *
 * @param []byte buf  the buffer to extend
 * @param DwarfSink dwarf  the sections to place (`present` already checked by the caller)
 * @param []Symbol symbols  the symbol table, for the relocation tables' `r_symbolnum`
 * @return []byte  `buf` followed by the DWARF section data and relocation tables
 * @since 0.3.1.0
 */
fn emit_dwarf_body(buf: []byte, dwarf: DwarfSink, symbols: []Symbol) -> []byte {
    mut b = pad_to_mult(buf, 4)
    b = append_bytes(b, dwarf.abbrev)
    b = append_bytes(b, dwarf.info.bytes)
    b = append_bytes(b, dwarf.line.bytes)
    b = pad_to_mult(b, 4)
    b = emit_dwarf_reloc_table(b, dwarf.info.relocs, symbols)
    emit_dwarf_reloc_table(b, dwarf.line.relocs, symbols)
}

/**
 * emit_build_version — the `LC_BUILD_VERSION` load command (24 bytes): platform
 * `PLATFORM_MACOS` (1), a fixed minos/sdk of 11.0.0 (so the object is
 * deterministic across hosts, satisfying FIXPOINT), and no build tools. Modern
 * `ld` requires this command on a relocatable object.
 *
 * @param []byte buf  the buffer to extend
 * @return []byte  `buf` followed by the 24-byte build-version command
 */
fn emit_build_version(buf: []byte) -> []byte {
    mut b = emit_u32_le(buf, MACHO_LC_BUILD_VERSION)
    b = emit_u32_le(b, 24)
    b = emit_u32_le(b, 1)
    b = emit_u32_le(b, MACHO_VERSION_11_0)
    b = emit_u32_le(b, MACHO_VERSION_11_0)
    emit_u32_le(b, 0)
}

/**
 * emit_symtab_cmd — the `LC_SYMTAB` load command (24 bytes): the symbol-table
 * file offset + count and the string-table file offset + size.
 *
 * @param []byte buf  the buffer to extend
 * @param MachoLayout lay  the resolved layout
 * @return []byte  `buf` followed by the 24-byte symtab command
 */
fn emit_symtab_cmd(buf: []byte, lay: MachoLayout) -> []byte {
    mut b = emit_u32_le(buf, 2)
    b = emit_u32_le(b, 24)
    b = emit_u32_le(b, lay.symtab_offset)
    b = emit_u32_le(b, lay.nsyms)
    b = emit_u32_le(b, lay.strtab_offset)
    emit_u32_le(b, lay.strtab_size)
}

/**
 * emit_dysymtab_cmd — the `LC_DYSYMTAB` load command (80 bytes): the three
 * contiguous symbol ranges — local (`ilocalsym=0`/`nlocalsym`), global-defined
 * (`iextdefsym=nlocal`/`nextdefsym`), undefined (`iundefsym=ndef`/`nundefsym`)
 * — and the twelve unused table pointers (all zero). `ld` requires this command
 * even for a static object.
 *
 * @param []byte buf  the buffer to extend
 * @param MachoLayout lay  the resolved layout
 * @return []byte  `buf` followed by the 80-byte dysymtab command
 */
fn emit_dysymtab_cmd(buf: []byte, lay: MachoLayout) -> []byte {
    let nextdef = lay.ndef - lay.nlocal
    mut b = emit_u32_le(buf, MACHO_LC_DYSYMTAB)
    b = emit_u32_le(b, 80)
    b = emit_u32_le(b, 0)
    b = emit_u32_le(b, lay.nlocal)
    b = emit_u32_le(b, lay.nlocal)
    b = emit_u32_le(b, nextdef)
    b = emit_u32_le(b, lay.ndef)
    b = emit_u32_le(b, lay.nundef)
    mut i: u32 = 0
    loop {
        if i >= 12 { break }
        b = emit_u32_le(b, 0)
        i++
    }
    b
}

/**
 * emit_reloc_table — one section's `relocation_info` array (the table is
 * emitted per section: once for `__text`, once for `__const`): one 8-byte
 * entry per relocation — the section-relative `r_address`, then the packed
 * `r_symbolnum | r_pcrel<<24 | r_length<<25 | r_extern(1)<<27 | r_type<<28`.
 * `r_length` varies per kind via `reloc_length(k)`: 2 (a 4-byte instruction
 * word) for the instruction fixups, 3 (an 8-byte quad) for `Abs64`. Every
 * relocation is an external, symbol-indexed fixup.
 *
 * @param []byte buf  the buffer to extend
 * @param []Reloc relocs  the section's relocations to emit
 * @param []Symbol symbols  the symbol table, for `r_symbolnum` indices
 * @return []byte  `buf` followed by the relocation entries
 */
fn emit_reloc_table(buf: []byte, relocs: []Reloc, symbols: []Symbol) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= relocs.len { break }
        let r = relocs[i]
        b = emit_u32_le(b, r.offset)
        let symnum = sym_index(symbols, r.sym)
        let packed = symnum | (reloc_pcrel(r.kind) << 24) | (reloc_length(r.kind) << 25) | (1 << 27) | (reloc_type_value(r.kind) << 28)
        b = emit_u32_le(b, packed to u32)
        i++
    }
    b
}

/**
 * section_addr — the `section_64` `addr` (vm address, section-relative to 0)
 * of a 1-based Mach-O section index: 0 for `__text` (section 1), `const_addr`
 * for `__const` (section 2 — the ALIGNED gap-inclusive offset `emit_segment`
 * gives that section's own `addr` field, NOT the raw `text_size`; #0.3.1.0
 * macho-const-section-align). An `nlist_64` `n_value` is the symbol's ABSOLUTE
 * address, `section_addr + Symbol.offset` — NOT the bare section-relative
 * offset (the F1 fix: a bare offset understates every `__const` symbol by
 * `const_addr`, which `ld` hard-rejects).
 *
 * @param u8 sect  the 1-based section index (1 or 2)
 * @param u32 const_addr  the `__const` section's own (aligned) vm address
 * @return u32  the section's vm address
 */
fn section_addr(sect: u8, const_addr: u32) -> u32 {
    if sect == 2 { return const_addr }
    0
}

/**
 * MachoSymType — an `nlist_64` symbol's classification, driving its `n_type`
 * byte through `macho_symtype_wire`: a defined, file-local symbol (`N_SECT`),
 * a defined, externally-visible symbol (`N_SECT | N_EXT`), or an undefined
 * external reference (`N_UNDF | N_EXT`). The wire byte (`0x0E`/`0x0F`/`0x01`)
 * does not match the enum's declaration ordinal — `macho_symtype_wire` is the
 * single emit-site mapping, mirroring #594 crumb 10's enum-wire pattern.
 */
type MachoSymType = enum { Undefined; DefinedLocal; DefinedGlobal }

/**
 * macho_symtype_wire — the `nlist_64.n_type` byte for a `MachoSymType`:
 * `N_UNDF | N_EXT` (`0x01`) for `Undefined`, `N_SECT` (`0x0E`) for
 * `DefinedLocal`, `N_SECT | N_EXT` (`0x0F`) for `DefinedGlobal`.
 *
 * @param t  the symbol's classification
 * @return   the wire `n_type` byte
 */
fn macho_symtype_wire(t: MachoSymType) -> u32 {
    match t {
        Undefined => MACHO_NTYPE_UNDF_EXT
        DefinedLocal => MACHO_NTYPE_SECT
        DefinedGlobal => MACHO_NTYPE_SECT_EXT
    }
}

/**
 * macho_sym_type — classify a neutral `Symbol` into its `MachoSymType`: an
 * undefined reference, a defined file-local symbol, or a defined
 * externally-visible symbol.
 *
 * @param s  the symbol to classify
 * @return   the symbol's `MachoSymType`
 */
fn macho_sym_type(s: Symbol) -> MachoSymType {
    if !s.defined { return MachoSymType::Undefined }
    if s.local { MachoSymType::DefinedLocal } else { MachoSymType::DefinedGlobal }
}
