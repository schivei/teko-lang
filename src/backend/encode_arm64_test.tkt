use teko::lir

fn p(id: u32): MReg {
    preg(id, MRegClass::GPR)
}

fn frameless_layout(): FrameLayout {
    FrameLayout {
        size = 0 to u32
        saved_gpr = []
        saved_fpr = []
        slot_offsets = []
        out_arg_base = 0
    }
}

fn layout_of(size: u32, gpr: []u32, fpr: []u32, slots: []u32): FrameLayout {
    FrameLayout { size = size; saved_gpr = gpr; saved_fpr = fpr; slot_offsets = slots; out_arg_base = 0 }
}

fn alloca_slot(bytes: u32, align: u32): lir::LAlloca {
    lir::LAlloca { bytes = bytes; align = align }
}

fn func_of(frame: []lir::LAlloca, insts: []@MInst()): MFunc {
    var block = MBlock { id = 0 to u32; params = []; insts = insts }
    MFunc { symbol = "t"; blocks = [block]; frame = frame }
}

fn l0(): []u32 {
    []
}

fn l1(a: u32): []u32 {
    teko::list::push(l0(), a)
}

fn l2(a: u32, b: u32): []u32 {
    teko::list::push(l1(a), b)
}

fn l3(a: u32, b: u32, c: u32): []u32 {
    teko::list::push(l2(a, b), c)
}

fn l_frame(): []lir::LAlloca {
    []
}

fn l_insts(): []@MInst() {
    []
}

fn pro(layout: FrameLayout): []u32 {
    match emit_prologue(layout) {
        error as e => l0()
        []u32 as w => w
    }
}

fn epi(layout: FrameLayout): []u32 {
    match emit_epilogue(layout) {
        error as e => l0()
        []u32 as w => w
    }
}

fn pro_stop(layout: FrameLayout): str {
    match emit_prologue(layout) {
        error as e => e.message
        []u32 as w => "<ok>"
    }
}

fn epi_stop(layout: FrameLayout): str {
    match emit_epilogue(layout) {
        error as e => e.message
        []u32 as w => "<ok>"
    }
}

fn fp(id: u32): MReg {
    preg(id, MRegClass::FPR)
}

fn m(reg: MReg, off: i32): MMem {
    MMem { base_reg = reg; offset = off }
}

fn bad_word(): EncWord {
    EncWord {
        word = 0xFFFFFFFF to u32
        has_branch = false
        target = 0 to u32
        branch_form = 0 to u32
        reloc = null
    }
}

fn enc(inst: @MInst()): EncWord {
    match encode_inst_word(frameless_layout(), inst) {
        EncWord as x => x
        error as e => bad_word()
    }
}

fn stop_of(inst: @MInst()): str {
    match encode_inst_word(frameless_layout(), inst) {
        EncWord as x => "<ok>"
        error as e => e.message
    }
}

fn stop_of_with(layout: FrameLayout, inst: @MInst()): str {
    match encode_inst_word(layout, inst) {
        EncWord as x => "<ok>"
        error as e => e.message
    }
}

fn assert_word(inst: @MInst(), expected: u32) {
    teko::assert::is_true(enc(inst).word == expected)
}

fn assert_stop(inst: @MInst(), name: str) {
    teko::assert::str_contains(stop_of(inst), name)
}

#test
fn encodes_the_movz_family() {
    assert_word(movz_inst(true, p(0), 42, 0), 0xD2800540)
    assert_word(movz_inst(false, p(0), 42, 0), 0x52800540)
    assert_word(movz_inst(true, p(0), 100, 16), 0xD2A00C80)
    assert_word(movk_inst(true, p(0), 200, 32), 0xF2C01900)
    assert_word(movn_inst(false, p(0), 1, 0), 0x12800020)
}

#test
fn encodes_every_integer_alu_reg() {
    assert_word(alu_inst(MAluOp::Add, true, p(0), p(1), p(2)), 0x8B020020)
    assert_word(alu_inst(MAluOp::Add, false, p(0), p(1), p(2)), 0x0B020020)
    assert_word(alu_inst(MAluOp::Sub, true, p(0), p(1), p(2)), 0xCB020020)
    assert_word(alu_inst(MAluOp::And, true, p(0), p(1), p(2)), 0x8A020020)
    assert_word(alu_inst(MAluOp::Orr, true, p(0), p(1), p(2)), 0xAA020020)
    assert_word(alu_inst(MAluOp::Eor, true, p(0), p(1), p(2)), 0xCA020020)
    assert_word(alu_inst(MAluOp::Mul, true, p(0), p(1), p(2)), 0x9B027C20)
    assert_word(alu_inst(MAluOp::Sdiv, true, p(0), p(1), p(2)), 0x9AC20C20)
    assert_word(alu_inst(MAluOp::Udiv, true, p(0), p(1), p(2)), 0x9AC20820)
    assert_word(alu_inst(MAluOp::Lsl, true, p(0), p(1), p(2)), 0x9AC22020)
    assert_word(alu_inst(MAluOp::Lsr, true, p(0), p(1), p(2)), 0x9AC22420)
    assert_word(alu_inst(MAluOp::Asr, true, p(0), p(1), p(2)), 0x9AC22820)
}

#test
fn encodes_alu_immediate() {
    assert_word(alu_imm_inst(MAluOp::Add, true, p(0), p(1), 7), 0x91001C20)
    assert_word(alu_imm_inst(MAluOp::Sub, true, p(0), p(1), 7), 0xD1001C20)
    assert_word(alu_imm_inst(MAluOp::Add, false, p(0), p(1), 7), 0x11001C20)
    assert_word(alu_imm_inst(MAluOp::Add, true, p(0), p(1), (0) - (7)), 0xD1001C20)
    assert_word(alu_imm_inst(MAluOp::Sub, true, p(0), p(1), (0) - (7)), 0x91001C20)
}

#test
fn encodes_msub_neg_mvn() {
    assert_word(msub_inst(true, p(0), p(1), p(2), p(3)), 0x9B028C20)
    assert_word(neg_inst(true, p(0), p(1)), 0xCB0103E0)
    assert_word(neg_inst(false, p(0), p(1)), 0x4B0103E0)
    assert_word(mvn_inst(false, p(0), p(1)), 0x2A2103E0)
    assert_word(mvn_inst(true, p(0), p(1)), 0xAA2103E0)
}

#test
fn encodes_compares() {
    assert_word(cmp_inst(true, p(1), p(2)), 0xEB02003F)
    assert_word(cmp_inst(false, p(1), p(2)), 0x6B02003F)
    assert_word(cmp_imm_inst(true, p(1), 7), 0xF1001C3F)
    assert_word(cmp_imm_inst(false, p(1), 7), 0x71001C3F)
}

#test
fn encodes_cset_all_conditions() {
    assert_word(cset_inst(true, p(0), MCond::EQ), 0x9A9F17E0)
    assert_word(cset_inst(false, p(0), MCond::NE), 0x1A9F07E0)
    assert_word(cset_inst(true, p(0), MCond::LT), 0x9A9FA7E0)
    assert_word(cset_inst(true, p(0), MCond::LE), 0x9A9FC7E0)
    assert_word(cset_inst(true, p(0), MCond::GT), 0x9A9FD7E0)
    assert_word(cset_inst(true, p(0), MCond::GE), 0x9A9FB7E0)
    assert_word(cset_inst(true, p(0), MCond::LO), 0x9A9F27E0)
    assert_word(cset_inst(true, p(0), MCond::LS), 0x9A9F87E0)
    assert_word(cset_inst(true, p(0), MCond::HI), 0x9A9F97E0)
    assert_word(cset_inst(true, p(0), MCond::HS), 0x9A9F37E0)
}

#test
fn encodes_every_extend() {
    assert_word(ext_inst(MExtOp::Sxtb, p(0), p(1)), 0x93401C20)
    assert_word(ext_inst(MExtOp::Sxth, p(0), p(1)), 0x93403C20)
    assert_word(ext_inst(MExtOp::Sxtw, p(0), p(1)), 0x93407C20)
    assert_word(ext_inst(MExtOp::Uxtb, p(0), p(1)), 0x53001C20)
    assert_word(ext_inst(MExtOp::Uxth, p(0), p(1)), 0x53003C20)
    assert_word(ext_inst(MExtOp::Uxtw, p(0), p(1)), 0xD3407C20)
}

#test
fn encodes_loads() {
    assert_word(load_inst(MMemSize::X, false, p(0), m(p(1), 0)), 0xF9400020)
    assert_word(load_inst(MMemSize::X, false, p(0), m(p(1), 8)), 0xF9400420)
    assert_word(load_inst(MMemSize::W, false, p(0), m(p(1), 4)), 0xB9400420)
    assert_word(load_inst(MMemSize::B, false, p(0), m(p(1), 0)), 0x39400020)
    assert_word(load_inst(MMemSize::H, false, p(0), m(p(1), 0)), 0x79400020)
    assert_word(load_inst(MMemSize::B, true, p(0), m(p(1), 0)), 0x39800020)
    assert_word(load_inst(MMemSize::H, true, p(0), m(p(1), 0)), 0x79800020)
    assert_word(load_inst(MMemSize::W, true, p(0), m(p(1), 0)), 0xB9800020)
}

#test
fn encodes_stores() {
    assert_word(store_inst(MMemSize::X, p(0), m(p(1), 0)), 0xF9000020)
    assert_word(store_inst(MMemSize::X, p(0), m(p(1), 16)), 0xF9000820)
    assert_word(store_inst(MMemSize::W, p(0), m(p(1), 4)), 0xB9000420)
    assert_word(store_inst(MMemSize::B, p(0), m(p(1), 0)), 0x39000020)
    assert_word(store_inst(MMemSize::H, p(0), m(p(1), 0)), 0x79000020)
}

#test
fn encodes_indirect_call_and_ret() {
    var no_uses: []MReg = []
    assert_word(call_indirect_inst(p(8), no_uses, p(0), false), 0xD63F0100)
    assert_word(RET_INST, 0xD65F03C0)
}

#test
fn encodes_compare_and_branch_placeholder() {
    var ew = enc(cbz_inst(true, true, p(5), 4))
    teko::assert::is_true(ew.word == (0xB4000005 to u32))
    teko::assert::is_true(ew.has_branch)
    teko::assert::is_true(ew.target == (4 to u32))
    teko::assert::is_true(ew.branch_form == (1 to u32))
    assert_word(cbz_inst(false, false, p(5), 4), 0x35000005)
    assert_word(cbz_inst(true, false, p(5), 4), 0xB5000005)
}

#test
fn encodes_the_float_alu_family() {
    assert_word(falu_inst(MFAluOp::FAdd, true, fp(3), fp(1), fp(2)), 0x1E622823)
    assert_word(falu_inst(MFAluOp::FSub, true, fp(3), fp(1), fp(2)), 0x1E623823)
    assert_word(falu_inst(MFAluOp::FMul, true, fp(3), fp(1), fp(2)), 0x1E620823)
    assert_word(falu_inst(MFAluOp::FDiv, true, fp(3), fp(1), fp(2)), 0x1E621823)
    assert_word(falu_inst(MFAluOp::FAdd, false, fp(3), fp(1), fp(2)), 0x1E222823)
    assert_word(falu_inst(MFAluOp::FSub, false, fp(3), fp(1), fp(2)), 0x1E223823)
    assert_word(falu_inst(MFAluOp::FMul, false, fp(3), fp(1), fp(2)), 0x1E220823)
    assert_word(falu_inst(MFAluOp::FDiv, false, fp(3), fp(1), fp(2)), 0x1E221823)
}

#test
fn encodes_the_float_negate_and_compare() {
    assert_word(fneg_inst(true, fp(7), fp(9)), 0x1E614127)
    assert_word(fneg_inst(false, fp(7), fp(9)), 0x1E214127)
    assert_word(fcmp_inst(true, fp(11), fp(12)), 0x1E6C2160)
    assert_word(fcmp_inst(false, fp(11), fp(12)), 0x1E2C2160)
}

#test
fn encodes_the_three_fmov_shapes() {
    assert_word(fmov_inst(true, fp(13), fp(14)), 0x1E6041CD)
    assert_word(fmov_inst(false, fp(13), fp(14)), 0x1E2041CD)
    assert_word(fmov_inst(true, p(15), fp(16)), 0x9E66020F)
    assert_word(fmov_inst(false, p(15), fp(16)), 0x1E26020F)
    assert_word(fmov_inst(true, fp(17), p(18)), 0x9E670251)
    assert_word(fmov_inst(false, fp(17), p(18)), 0x1E270251)
}

#test
fn encodes_every_conversion_width_pair() {
    assert_word(cvt_inst(MCvtOp::Scvtf, fp(19), p(20), true, true), 0x9E620293)
    assert_word(cvt_inst(MCvtOp::Scvtf, fp(19), p(20), false, true), 0x1E620293)
    assert_word(cvt_inst(MCvtOp::Scvtf, fp(19), p(20), true, false), 0x9E220293)
    assert_word(cvt_inst(MCvtOp::Scvtf, fp(19), p(20), false, false), 0x1E220293)
    assert_word(cvt_inst(MCvtOp::Ucvtf, fp(21), p(22), true, true), 0x9E6302D5)
    assert_word(cvt_inst(MCvtOp::Ucvtf, fp(21), p(22), false, false), 0x1E2302D5)
    assert_word(cvt_inst(MCvtOp::Fcvtzs, p(23), fp(24), true, true), 0x9E780317)
    assert_word(cvt_inst(MCvtOp::Fcvtzs, p(23), fp(24), true, false), 0x1E780317)
    assert_word(cvt_inst(MCvtOp::Fcvtzs, p(23), fp(24), false, true), 0x9E380317)
    assert_word(cvt_inst(MCvtOp::Fcvtzs, p(23), fp(24), false, false), 0x1E380317)
    assert_word(cvt_inst(MCvtOp::Fcvtzu, p(25), fp(26), true, true), 0x9E790359)
    assert_word(cvt_inst(MCvtOp::Fcvtzu, p(25), fp(26), false, false), 0x1E390359)
}

#test
fn encodes_both_fcvt_directions() {
    assert_word(cvt_inst(MCvtOp::Fcvt, fp(27), fp(28), true, false), 0x1E62439B)
    assert_word(cvt_inst(MCvtOp::Fcvt, fp(27), fp(28), false, true), 0x1E22C39B)
    teko::assert::str_contains(stop_of(cvt_inst(MCvtOp::Fcvt, fp(27), fp(28), true, true)), "identity FCVT")
    teko::assert::str_contains(stop_of(cvt_inst(MCvtOp::Fcvt, fp(27), fp(28), false, false)), "identity FCVT")
}

#test
fn fmov_between_two_gprs_is_an_internal_error() {
    teko::assert::str_contains(stop_of(fmov_inst(true, p(1), p(2))), "MFMov between two GPRs")
}

#test
fn encodes_fpr_memory_widths() {
    assert_word(load_inst(MMemSize::S, false, fp(5), m(p(6), 12)), 0xBD400CC5)
    assert_word(load_inst(MMemSize::D, false, fp(5), m(p(6), 24)), 0xFD400CC5)
    assert_word(store_inst(MMemSize::S, fp(5), m(p(6), 4)), 0xBD0004C5)
    assert_word(store_inst(MMemSize::D, fp(5), m(p(6), 8)), 0xFD0004C5)
    assert_word(load_inst(MMemSize::S, false, fp(5), m(p(6), 0)), 0xBD4000C5)
    assert_word(store_inst(MMemSize::D, fp(5), m(p(6), 0)), 0xFD0000C5)
}

#test
fn encodes_the_fpr_spill_from_sp() {
    var fl = layout_of(32 to u32, l0(), l0(), l2(24, 0))
    assert_word_with(fl, fspill_inst(fp(9), 0, false), 0xFD000FE9)
    assert_word_with(fl, fspill_inst(fp(9), 0, true), 0xFD400FE9)
    assert_word_with(fl, fspill_inst(fp(9), 1, false), 0xFD0003E9)
}

fn assert_word_with(layout: FrameLayout, inst: @MInst(), expected: u32) {
    match encode_inst_word(layout, inst) {
        EncWord as x => teko::assert::is_true(x.word == expected)
        error => teko::assert::is_true(false)
    }
}

#test
fn fpr_memory_keeps_the_unscaled_stop() {
    assert_stop(load_inst(MMemSize::D, false, fp(0), m(p(1), 4)), "A4-ldur")
    assert_stop(store_inst(MMemSize::S, fp(0), m(p(1), 2)), "A4-ldur")
}

#test
fn callee_saved_gpr_pair_words() {
    var fl = layout_of(48 to u32, l2(19, 20), l0(), l1(0))
    var pr = pro(fl)
    teko::assert::is_true(pr.len == 4)
    teko::assert::is_true(pr[0] == (0xD100C3FF to u32))
    teko::assert::is_true(pr[1] == (0xA9027BFD to u32))
    teko::assert::is_true(pr[2] == (0x910083FD to u32))
    teko::assert::is_true(pr[3] == (0xA90153F3 to u32))
    var ep = epi(fl)
    teko::assert::is_true(ep.len == 3)
    teko::assert::is_true(ep[0] == (0xA94153F3 to u32))
    teko::assert::is_true(ep[1] == (0xA9427BFD to u32))
    teko::assert::is_true(ep[2] == (0x9100C3FF to u32))
}

#test
fn callee_saved_fpr_pair_words() {
    var fl = layout_of(48 to u32, l0(), l2(8, 9), l1(0))
    var pr = pro(fl)
    teko::assert::is_true(pr.len == 4)
    teko::assert::is_true(pr[3] == (0x6D0127E8 to u32))
    var ep = epi(fl)
    teko::assert::is_true(ep[0] == (0x6D4127E8 to u32))
}

#test
fn callee_saved_fpr_single_word() {
    var fl = layout_of(32 to u32, l0(), l1(8), l0())
    var pr = pro(fl)
    teko::assert::is_true(pr.len == 4)
    teko::assert::is_true(pr[3] == (0xFD0007E8 to u32))
    var ep = epi(fl)
    teko::assert::is_true(ep[0] == (0xFD4007E8 to u32))
}

#test
fn slot_offset_reads_the_map() {
    var fl = layout_of(48 to u32, l0(), l0(), l3(0, 16, 24))
    teko::assert::is_true(slot_offset(fl, 0) == (0 to u32))
    teko::assert::is_true(slot_offset(fl, 1) == (16 to u32))
    teko::assert::is_true(slot_offset(fl, 2) == (24 to u32))
}

#test
fn big_frame_addr_honest_stops() {
    var fl = layout_of(8192 to u32, l0(), l0(), l1(5000))
    teko::assert::str_contains(stop_of_with(fl, frame_addr_inst(p(0), 0)), "A4-bigframe")
}

#test
fn big_prologue_epilogue_uses_the_big_sequence() {
    var fl = layout_of(1024 to u32, l0(), l0(), l0())
    var p = pro(fl)
    teko::assert::is_true(p.len == 4)
    teko::assert::is_true(p[0] == (0xD11003FF to u32))
    teko::assert::is_true(p[1] == (0xF901FBFD to u32))
    teko::assert::is_true(p[2] == (0xF901FFFE to u32))
    teko::assert::is_true(p[3] == (0x910FC3FD to u32))
    var e = epi(fl)
    teko::assert::is_true(e.len == 3)
    teko::assert::is_true(e[0] == (0xF941FBFD to u32))
    teko::assert::is_true(e[1] == (0xF941FFFE to u32))
    teko::assert::is_true(e[2] == (0x911003FF to u32))
}

#test
fn big_prologue_epilogue_saves_callee_saved_individually() {
    var fl = layout_of(2000 to u32, l2(19, 20), l0(), l0())
    var p = pro(fl)
    teko::assert::is_true(p.len == 6)
    teko::assert::is_true(p[0] == (0xD11F43FF to u32))
    teko::assert::is_true(p[1] == (0xF903E3FD to u32))
    teko::assert::is_true(p[2] == (0xF903E7FE to u32))
    teko::assert::is_true(p[3] == (0x911F03FD to u32))
    teko::assert::is_true(p[4] == (0xF903DBF3 to u32))
    teko::assert::is_true(p[5] == (0xF903DFF4 to u32))
    var e = epi(fl)
    teko::assert::is_true(e.len == 5)
    teko::assert::is_true(e[0] == (0xF943DBF3 to u32))
    teko::assert::is_true(e[1] == (0xF943DFF4 to u32))
    teko::assert::is_true(e[2] == (0xF943E3FD to u32))
    teko::assert::is_true(e[3] == (0xF943E7FE to u32))
    teko::assert::is_true(e[4] == (0x911F43FF to u32))
}

#test
fn huge_prologue_epilogue_honest_stops() {
    var fl = layout_of(32800 to u32, l0(), l0(), l0())
    teko::assert::str_contains(pro_stop(fl), "A4-bigframe")
    teko::assert::str_contains(epi_stop(fl), "A4-bigframe")
}

#test
fn big_immediate_honest_stops() {
    assert_stop(alu_imm_inst(MAluOp::Add, true, p(0), p(1), 5000), "A4-bigimm")
    assert_stop(alu_imm_inst(MAluOp::Add, true, p(0), p(1), (0) - (5000)), "A4-bigimm")
    assert_stop(alu_imm_inst(MAluOp::And, true, p(0), p(1), 3), "A4-bigimm")
    assert_stop(cmp_imm_inst(true, p(1), 5000), "A4-bigimm")
    assert_stop(cmp_imm_inst(true, p(1), (0) - (1)), "A4-bigimm")
}

#test
fn unscaled_offset_honest_stops() {
    assert_stop(load_inst(MMemSize::X, false, p(0), m(p(1), (0 to i32) - (8 to i32))), "A4-ldur")
    assert_stop(load_inst(MMemSize::X, false, p(0), m(p(1), 4)), "A4-ldur")
    assert_stop(load_inst(MMemSize::X, false, p(0), m(p(1), 32768)), "A4-ldur")
    assert_stop(store_inst(MMemSize::H, p(0), m(p(1), 1)), "A4-ldur")
}

#test
fn layout_zero_and_one_align_slots() {
    var frame = teko::list::push(teko::list::push(teko::list::push(l_frame(), alloca_slot(8, 0)), alloca_slot(8, 1)), alloca_slot(4, 4))
    var fl = compute_frame_layout(AAPCS64, func_of(frame, l_insts()))
    teko::assert::is_true(fl.slot_offsets[0] == (0 to u32))
    teko::assert::is_true(fl.slot_offsets[1] == (8 to u32))
    teko::assert::is_true(fl.slot_offsets[2] == (16 to u32))
    teko::assert::is_true(fl.size == (48 to u32))
}

fn i1(a: @MInst()): []@MInst() {
    teko::list::push(l_insts(), a)
}

fn i2(a: @MInst(), b: @MInst()): []@MInst() {
    teko::list::push(i1(a), b)
}

fn i3(a: @MInst(), b: @MInst(), c: @MInst()): []@MInst() {
    teko::list::push(i2(a, b), c)
}

fn i4(a: @MInst(), b: @MInst(), c: @MInst(), d: @MInst()): []@MInst() {
    teko::list::push(i3(a, b, c), d)
}

fn mblock(id: u32, insts: []@MInst()): MBlock {
    MBlock { id = id; params = []; insts = insts }
}

fn l_blocks(): []MBlock {
    []
}

fn bl1(a: MBlock): []MBlock {
    teko::list::push(l_blocks(), a)
}

fn bl2(a: MBlock, b: MBlock): []MBlock {
    teko::list::push(bl1(a), b)
}

fn bl3(a: MBlock, b: MBlock, c: MBlock): []MBlock {
    teko::list::push(bl2(a, b), c)
}

fn bl4(a: MBlock, b: MBlock, c: MBlock, d: MBlock): []MBlock {
    teko::list::push(bl3(a, b, c), d)
}

fn func_blocks(blocks: []MBlock): MFunc {
    MFunc { symbol = "t"; blocks = blocks; frame = l_frame() }
}

fn l_relocs(): []Reloc {
    []
}

fn bad_func(): EncodedFunc {
    EncodedFunc { symbol = "<error>"; words = l1(0xFFFFFFFF to u32); relocs = l_relocs() }
}

fn ef(f: MFunc): EncodedFunc {
    match encode_func(AAPCS64, f) {
        EncodedFunc as x => x
        error as e => bad_func()
    }
}

fn ef_stop(f: MFunc): str {
    match encode_func(AAPCS64, f) {
        EncodedFunc as x => "<ok>"
        error as e => e.message
    }
}

fn kind_name(k: MRelocKind): str {
    match k {
        PageHi => "PageHi"
        PageLo => "PageLo"
        Call => "Call"
        Abs64 => "Abs64"
    }
}

fn reloc_shape(ew: EncWord): str {
    match ew.reloc {
        null => "<none>"
        EncReloc as r => teko::str::concat(r.sym, "/", kind_name(r.kind))
    }
}

fn field_stop(r: u32 | error): str {
    match r {
        u32 as v => "<ok>"
        error as e => e.message
    }
}

fn neg64(m: i64): i64 {
    (0) - m
}

#test
fn diamond_forward_branches_patch_correctly() {
    var b0 = mblock(0 to u32, i2(cmp_inst(true, p(0), p(1)), branch_cond_inst(MCond::EQ, 3 to u32)))
    var b1 = mblock(7 to u32, i2(movz_inst(true, p(0), 1, 0), cbz_inst(true, true, p(0), 9 to u32)))
    var b2 = mblock(3 to u32, i2(movz_inst(true, p(0), 2, 0), branch_inst(9 to u32)))
    var b3 = mblock(9 to u32, i1(RET_INST))
    var e = ef(func_blocks(bl4(b0, b1, b2, b3)))
    teko::assert::is_true(e.words.len == 7)
    teko::assert::is_true(e.words[0] == (0xEB01001F to u32))
    teko::assert::is_true(e.words[1] == (0x54000060 to u32))
    teko::assert::is_true(e.words[2] == (0xD2800020 to u32))
    teko::assert::is_true(e.words[3] == (0xB4000060 to u32))
    teko::assert::is_true(e.words[4] == (0xD2800040 to u32))
    teko::assert::is_true(e.words[5] == (0x14000001 to u32))
    teko::assert::is_true(e.words[6] == (0xD65F03C0 to u32))
    teko::assert::is_true(e.relocs.len == 0)
}

#test
fn reloc_records_carry_exact_offsets_kinds_syms() {
    var no_uses: []MReg = []
    var insts = i4(adrp_inst(p(1), "g", MRelocKind::PageHi), add_lo_inst(p(1), p(1), "g", MRelocKind::PageLo), movz_inst(true, p(0), 0, 0), call_inst("tk_exit", no_uses, p(0), false, false))
    var e = ef(func_blocks(bl1(mblock(0 to u32, insts))))
    teko::assert::is_true(e.words.len == 4)
    teko::assert::is_true(e.words[0] == (0x90000001 to u32))
    teko::assert::is_true(e.words[1] == (0x91000021 to u32))
    teko::assert::is_true(e.words[3] == (0x94000000 to u32))
    teko::assert::is_true(e.relocs.len == 3)
    teko::assert::is_true(e.relocs[0].offset == (0 to u32))
    teko::assert::is_true(e.relocs[0].sym == "g")
    teko::assert::is_true(kind_name(e.relocs[0].kind) == "PageHi")
    teko::assert::is_true(e.relocs[1].offset == (4 to u32))
    teko::assert::is_true(kind_name(e.relocs[1].kind) == "PageLo")
    teko::assert::is_true(e.relocs[2].offset == (12 to u32))
    teko::assert::is_true(e.relocs[2].sym == "tk_exit")
    teko::assert::is_true(kind_name(e.relocs[2].kind) == "Call")
}

#test
fn a_non_relocating_word_owes_no_relocation_kind() {
    teko::assert::is_true(enc(movz_inst(true, p(0), 1, 0)).reloc == null)
    teko::assert::is_true(enc(alu_inst(MAluOp::Add, true, p(0), p(1), p(2))).reloc == null)
    teko::assert::is_true(enc(cmp_inst(true, p(0), p(1))).reloc == null)
    teko::assert::is_true(enc(RET_INST).reloc == null)
    teko::assert::is_true(enc(branch_inst(0 to u32)).reloc == null)
}

#test
fn a_relocating_word_owes_exactly_its_own_kind() {
    var no_uses: []MReg = []
    teko::assert::is_true(reloc_shape(enc(adrp_inst(p(1), "g", MRelocKind::PageHi))) == "g/PageHi")
    teko::assert::is_true(reloc_shape(enc(add_lo_inst(p(1), p(1), "g", MRelocKind::PageLo))) == "g/PageLo")
    teko::assert::is_true(reloc_shape(enc(call_inst("tk_exit", no_uses, p(0), false, false))) == "tk_exit/Call")
}

#test
fn branch_disp_field_far_honest_stops() {
    teko::assert::str_contains(field_stop(branch_disp_field(33554432, 0 to u32)), "A4-farbranch")
    teko::assert::str_contains(field_stop(branch_disp_field(neg64(33554433), 0 to u32)), "A4-farbranch")
    teko::assert::str_contains(field_stop(branch_disp_field(262144, 1 to u32)), "A4-farbranch")
    teko::assert::str_contains(field_stop(branch_disp_field(neg64(262145), 1 to u32)), "A4-farbranch")
}

#test
fn dangling_branch_target_honest_stops() {
    var e = func_blocks(bl1(mblock(0 to u32, i1(branch_inst(99 to u32)))))
    teko::assert::str_contains(ef_stop(e), "A4-badblock")
}

#test
fn encode_func_uses_the_big_sequence_for_a_big_alloca() {
    var frame = teko::list::push(l_frame(), alloca_slot(8192, 8))
    var e = ef(func_of(frame, i1(RET_INST)))
    teko::assert::is_true(e.words.len == 10)
    teko::assert::is_true(e.words[0] == (0xD1400BFF to u32))
    teko::assert::is_true(e.words[1] == (0xD10043FF to u32))
    teko::assert::is_true(e.words[2] == (0xF91003FD to u32))
    teko::assert::is_true(e.words[3] == (0xF91007FE to u32))
    teko::assert::is_true(e.words[4] == (0x91400BFD to u32))
    teko::assert::is_true(e.words[5] == (0xF95003FD to u32))
    teko::assert::is_true(e.words[6] == (0xF95007FE to u32))
    teko::assert::is_true(e.words[7] == (0x91400BFF to u32))
    teko::assert::is_true(e.words[8] == (0x910043FF to u32))
    teko::assert::is_true(e.words[9] == (0xD65F03C0 to u32))
}

fn bo(id: u32, word: u32): BlockOffset {
    BlockOffset { id = id; word = word }
}

fn named_func(sym: str, blocks: []MBlock): MFunc {
    MFunc { symbol = sym; blocks = blocks; frame = l_frame() }
}

fn one_block_func(sym: str, insts: []@MInst()): MFunc {
    named_func(sym, bl1(mblock(0 to u32, insts)))
}

fn l_bytes(): []byte {
    []
}

fn l_syms(): []Symbol {
    []
}

fn bad_module(): EncodedModule {
    EncodedModule { text = l_bytes(); rodata = l_bytes(); symbols = l_syms(); relocs = l_relocs() }
}

fn em(m: MModule): EncodedModule {
    match encode_module(AAPCS64, m) {
        EncodedModule as x => x
        error as e => bad_module()
    }
}

fn em_stop(m: MModule): str {
    match encode_module(AAPCS64, m) {
        EncodedModule as x => "<ok>"
        error as e => e.message
    }
}

fn rodata_of(sym: str, bs: []byte): []lir::LRodata {
    [lir::LRodata { symbol = sym; bytes = bs; relocs = [] }]
}

fn module_with_rodata(funcs: []MFunc, rodata: []lir::LRodata): MModule {
    MModule { funcs = funcs; rodata = rodata; globals = []; layouts = [] }
}

#test
fn module_interns_rodata_into_const() {
    var r0 = teko::list::push(teko::list::push(teko::list::push(l_bytes(), 0x68 to byte), 0x69 to byte), 0 to byte)
    var r1 = teko::list::push(teko::list::push(l_bytes(), 0x41 to byte), 0 to byte)
    var rodata = teko::list::push(rodata_of("s0", r0), lir::LRodata { symbol = "s1"; bytes = r1; relocs = teko::list::empty() })
    var f = one_block_func("main", i1(RET_INST))
    var funcs = [f]
    var e = em(module_with_rodata(funcs, rodata))
    teko::assert::is_true(e.rodata.len == (10 to u64))
    teko::assert::is_true(e.rodata[0] == (0x68 to byte))
    teko::assert::is_true(e.symbols.len == 3)
    teko::assert::is_true(e.symbols[0].name == "s0")
    teko::assert::is_true(e.symbols[0].defined)
    teko::assert::is_true(e.symbols[0].local)
    teko::assert::is_true(e.symbols[0].sect == (2 to u8))
    teko::assert::is_true(e.symbols[0].offset == (0 to u32))
    teko::assert::is_true(e.symbols[1].name == "s1")
    teko::assert::is_true(e.symbols[1].local)
    teko::assert::is_true(e.symbols[1].offset == (8 to u32))
    teko::assert::is_true(e.symbols[2].name == "main")
    teko::assert::is_true(e.symbols[2].defined)
    teko::assert::is_false(e.symbols[2].local)
    teko::assert::is_true(e.symbols[2].sect == (1 to u8))
}

fn n_zero_bytes(n: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, 0 to byte)
        i++
    }
    out
}

#test
fn enc_rodata_reloc_offset_survives_odd_length_neighbors() {
    var r0 = lir::LRodata { symbol = "s0"; bytes = n_zero_bytes(3 to u64); relocs = [] }
    var r1 = lir::LRodata { symbol = "s1"; bytes = n_zero_bytes(6 to u64); relocs = [] }
    var r2_relocs = [lir::data_reloc(0 to u32, "s0")]
    var r2 = lir::LRodata { symbol = "s2"; bytes = n_zero_bytes(16 to u64); relocs = r2_relocs }
    var rodata = [r0, r1, r2]
    var f = one_block_func("main", i1(RET_INST))
    var funcs = [f]
    var e = em(module_with_rodata(funcs, rodata))
    teko::assert::is_true(e.symbols[2].name == "s2")
    teko::assert::is_true(e.symbols[2].offset == (16 to u32))
    teko::assert::is_true(e.relocs.len == 1)
    teko::assert::is_true(e.relocs[0].offset == (16 to u32))
    teko::assert::is_true(e.relocs[0].offset % (8 to u32) == (0 to u32))
    teko::assert::is_true(e.relocs[0].sect == RelocSect::Rodata)
}

#test
fn find_rodata_align_violations_is_empty_for_aligned_relocs() {
    var syms = [Symbol { name = "s0"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true }, Symbol { name = "s1"; defined = true; sect = 2 to u8; offset = 16 to u32; local = true }]
    var relocs = [lir::data_reloc(16 to u32, "s0")]
    teko::assert::is_true(find_rodata_align_violations(syms, relocs).len == 0)
}

#test
fn find_rodata_align_violations_names_the_owning_symbol() {
    var syms = [Symbol { name = "s0"; defined = true; sect = 2 to u8; offset = 0 to u32; local = true }]
    var relocs = [lir::data_reloc(9 to u32, "leaf")]
    var violations = find_rodata_align_violations(syms, relocs)
    teko::assert::is_true(violations.len == 1)
    teko::assert::is_true(violations[0].owner == "s0")
    teko::assert::is_true(violations[0].target == "leaf")
    teko::assert::is_true(violations[0].offset == (9 to u32))
    teko::assert::is_true(violations[0].expected == (16 to u32))
}

#test
fn module_globals_honest_stops() {
    var f = one_block_func("main", i1(RET_INST))
    var funcs = [f]
    var globals = [lir::LGlobal { symbol = "gv"; ty = lir::LType::I32; bytes = l_bytes() }]
    var m = MModule { funcs = funcs; rodata = []; globals = globals; layouts = [] }
    teko::assert::str_contains(em_stop(m), "A4-globals")
}

#test
fn module_propagates_function_honest_stop() {
    var f = one_block_func("main", i1(alu_imm_inst(MAluOp::Add, true, p(0), p(1), 5000)))
    teko::assert::str_contains(em_stop(add_mfunc(empty_mmodule(), f)), "A4-bigimm")
}

fn l0_ew(): []EncWord {
    []
}

fn faw(layout: FrameLayout, fa: MFrameAddr): []EncWord {
    match encode_frame_addr_words(layout, fa) {
        []EncWord as w => w
        error as e => l0_ew()
    }
}

fn faw_stop(layout: FrameLayout, fa: MFrameAddr): str {
    match encode_frame_addr_words(layout, fa) {
        []EncWord as w => "<ok>"
        error as e => e.message
    }
}

#test
fn big_frame_addr_words_chain_the_add_sequence() {
    var fl = layout_of(8192 to u32, l0(), l0(), l1(5000))
    var ws = faw(fl, MFrameAddr { dst = p(0); slot = 0 to u64 })
    teko::assert::is_true(ws.len == 2)
    teko::assert::is_true(ws[0].word == (0x914007E0 to u32))
    teko::assert::is_true(ws[1].word == (0x910E2000 to u32))
    teko::assert::is_false(ws[0].has_branch)
    teko::assert::is_true(ws[0].reloc == null)
    teko::assert::is_false(ws[1].has_branch)
    teko::assert::is_true(ws[1].reloc == null)
}

#test
fn small_frame_addr_words_matches_encode_inst_word() {
    var fl = layout_of(48 to u32, l0(), l0(), l3(0, 16, 24))
    var ws = faw(fl, MFrameAddr { dst = p(3); slot = 1 to u64 })
    teko::assert::is_true(ws.len == 1)
    teko::assert::is_true(ws[0].word == (0x910043E3 to u32))
}

#test
fn frame_addr_words_succeeds_at_the_imm24_boundary() {
    var fl = layout_of(20000000 to u32, l0(), l0(), l1(16777215))
    var ws = faw(fl, MFrameAddr { dst = p(3); slot = 0 to u64 })
    teko::assert::is_true(ws.len == 2)
    teko::assert::is_true(ws[0].word == (0x917FFFE3 to u32))
    teko::assert::is_true(ws[1].word == (0x913FFC63 to u32))
}

#test
fn frame_addr_words_honest_stops_past_imm24() {
    var fl = layout_of(20000000 to u32, l0(), l0(), l1(16777216))
    teko::assert::str_contains(faw_stop(fl, MFrameAddr { dst = p(0); slot = 0 to u64 }), "A4-bigframe")
}

#test
fn frame_fits_boundary() {
    teko::assert::is_true(frame_fits(layout_of(520 to u32, l0(), l0(), l0())))
    teko::assert::is_false(frame_fits(layout_of(528 to u32, l0(), l0(), l0())))
}

#test
fn big_frame_fits_boundary() {
    teko::assert::is_true(big_frame_fits(layout_of(32776 to u32, l0(), l0(), l0())))
    teko::assert::is_false(big_frame_fits(layout_of(32777 to u32, l0(), l0(), l0())))
}

#test
fn div_zero_guard_encodes_compare_branch_call_and_selfloop() {
    var b0 = mblock(0 to u32, i4(movz_inst(true, p(2), 0, 0), cmp_inst(true, p(1), p(2)), branch_cond_inst(MCond::NE, 1 to u32), branch_inst(2 to u32)))
    var b1 = mblock(1 to u32, i2(alu_inst(MAluOp::Sdiv, true, p(3), p(0), p(1)), RET_INST))
    var no_uses: []MReg = []
    var b2 = mblock(2 to u32, i2(call_inst("tk_panic_div0", no_uses, p(0), false, false), branch_inst(2 to u32)))
    var e = ef(func_blocks(bl3(b0, b1, b2)))
    teko::assert::is_true(e.words.len == 13)
    teko::assert::is_true(e.words[0] == (0xD10043FF to u32))
    teko::assert::is_true(e.words[1] == (0xA9007BFD to u32))
    teko::assert::is_true(e.words[2] == (0x910003FD to u32))
    teko::assert::is_true(e.words[3] == (0xD2800002 to u32))
    teko::assert::is_true(e.words[4] == (0xEB02003F to u32))
    teko::assert::is_true(e.words[5] == (0x54000041 to u32))
    teko::assert::is_true(e.words[6] == (0x14000005 to u32))
    teko::assert::is_true(e.words[7] == (0x9AC10C03 to u32))
    teko::assert::is_true(e.words[8] == (0xA9407BFD to u32))
    teko::assert::is_true(e.words[9] == (0x910043FF to u32))
    teko::assert::is_true(e.words[10] == (0xD65F03C0 to u32))
    teko::assert::is_true(e.words[11] == (0x94000000 to u32))
    teko::assert::is_true(e.words[12] == (0x17FFFFFF to u32))
    teko::assert::is_true(e.relocs.len == 1)
    teko::assert::is_true(e.relocs[0].offset == (44 to u32))
    teko::assert::is_true(e.relocs[0].sym == "tk_panic_div0")
    teko::assert::is_true(kind_name(e.relocs[0].kind) == "Call")
}
