use teko::list

fn elf_remap_partition_symbols(symbols: []Symbol, entries: []ElfConstEntry) -> []Symbol {
    mut out: []Symbol = teko::list::empty()
    mut k: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= symbols.len { break }
        let s = symbols[i]
        if s.defined && s.local && s.sect == ELF_SECT_RODATA {
            let e = entries[k]
            let sect = if e.to_drr { ELF_SECT_DATA_REL_RO } else { ELF_SECT_RODATA }
            out = teko::list::push(out, Symbol { name = s.name; defined = s.defined; sect = sect; offset = e.new_offset; local = s.local })
            k++
        } else {
            out = teko::list::push(out, s)
        }
        i++
    }
    out
}

/**
 * elf_owner_new_base — the moved datum owning the relocation site at byte offset
 * `off`: its (original `start`, post-partition `new_offset`) pair, so a site is
 * rebased as `new_offset + (off - start)`. The owner is the entry whose span
 * contains `off`; only `to_drr` entries carry sites.
 *
 * @param []ElfConstEntry entries  the entries with offsets assigned
 * @param u32 off  the relocation site's original `.rodata` byte offset
 * @return u32  the rebased `.data.rel.ro`-relative site offset
 */
fn elf_rebased_site(entries: []ElfConstEntry, off: u32) -> u32 {
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let e = entries[i]
        if off >= e.start && off < e.end { return e.new_offset + (off - e.start) }
        i++
    }
    off
}

/**
 * elf_remap_drr_relocs — rebase every `.rodata`-relative relocation's site to be
 * `.data.rel.ro`-relative (its owning datum moved there), leaving the target
 * name, type, and addend unchanged (the target is a `.rodata` leaf, resolved
 * later against the `.rodata` section symbol).
 *
 * @param []ElfRelocReq rodata_relocs  the `.rodata`-relative relocations
 * @param []ElfConstEntry entries  the entries with offsets assigned
 * @return []ElfRelocReq  the relocations with `.data.rel.ro`-relative sites
 */
fn elf_remap_drr_relocs(rodata_relocs: []ElfRelocReq, entries: []ElfConstEntry) -> []ElfRelocReq {
    mut out: []ElfRelocReq = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= rodata_relocs.len { break }
        let r = rodata_relocs[i]
        out = teko::list::push(out, ElfRelocReq { offset = elf_rebased_site(entries, r.offset); sym = r.sym; rtype = r.rtype; addend = r.addend })
        i++
    }
    out
}

/**
 * elf_partition_data_rel_ro — split the object's `.rodata` image by
 * relocation-presence: every const datum whose bytes hold a pointer relocation
 * (a `const []T` fat slot) moves to a writable-then-RELRO `.data.rel.ro` section,
 * while pure string/leaf data stays in read-only `.rodata`. This is what makes
 * the object link under a default PIE toolchain: an absolute (`R_X86_64_64`)
 * relocation into a read-only section forces `DT_TEXTREL` (which `ld` refuses in
 * a PIE), whereas the same relocation in `.data.rel.ro` is applied at load time
 * and the page is then protected read-only (RELRO) — PIE- and ASLR-safe, exactly
 * as a C toolchain places a `static const` with a pointer initializer.
 *
 * A no-op passthrough when the module carries no rodata-internal relocation, so
 * every existing object (and golden) stays byte-identical.
 *
 * @param ElfObject obj  the neutral object (rodata image + symbols + rodata relocs)
 * @return ElfDrrPartition  the rebuilt sections + re-stamped symbols + rebased relocs
 */
fn elf_partition_data_rel_ro(obj: ElfObject) -> ElfDrrPartition {
    if obj.rodata_relocs.len == (0 to u64) {
        return ElfDrrPartition { active = false; rodata = obj.rodata; drr = teko::list::empty(); symbols = obj.symbols; drr_relocs = teko::list::empty() }
    }
    let entries = elf_assign_partition_offsets(elf_collect_const_entries(obj.symbols, obj.rodata.len to u32), obj.rodata_relocs)
    let rodata = elf_build_partition_blob(entries, obj.rodata, false)
    let drr = elf_build_partition_blob(entries, obj.rodata, true)
    let symbols = elf_remap_partition_symbols(obj.symbols, entries)
    let drr_relocs = elf_remap_drr_relocs(obj.rodata_relocs, entries)
    ElfDrrPartition { active = true; rodata = rodata; drr = drr; symbols = symbols; drr_relocs = drr_relocs }
}

/**
 * emit_elf_dwarf_body — append the DWARF section data and relocation tables (D1.4): the
 * `.debug_abbrev`/`.debug_info`/`.debug_line` bytes, each 8-aligned, then the `.rela.debug_info`/
 * `.rela.debug_line` `Elf64_Rela` tables, each 8-aligned. Extracted from `emit_elf_object` so its
 * `has_dwarf` branch stays one line, per the section-appending pattern every other optional block
 * in this writer already follows.
 *
 * @param []byte buf  the buffer to extend
 * @param ElfDwarfSections dwarf  the sections to place (`present` already checked by the caller)
 * @param []ElfRela info_relas  the resolved `.rela.debug_info` rows
 * @param []ElfRela line_relas  the resolved `.rela.debug_line` rows
 * @return []byte  `buf` followed by the DWARF section data and relocation tables
 * @since 0.3.1.0
 */
fn emit_elf_dwarf_body(buf: []byte, dwarf: ElfDwarfSections, info_relas: []ElfRela, line_relas: []ElfRela) -> []byte {
    mut b = pad_to_mult(buf, 8 to u32)
    b = append_bytes(b, dwarf.abbrev)
    b = pad_to_mult(b, 8 to u32)
    b = append_bytes(b, dwarf.info_bytes)
    b = pad_to_mult(b, 8 to u32)
    b = append_bytes(b, dwarf.line_bytes)
    b = pad_to_mult(b, 8 to u32)
    b = emit_elf_relas(b, info_relas)
    b = pad_to_mult(b, 8 to u32)
    emit_elf_relas(b, line_relas)
}

/**
 * x86_reloc_reqs — lower every `RelocX86` of `enc` to a neutral `ElfRelocReq`,
 * mapping the x86 `kind` to its numeric `R_X86_64_*` type via `elf_reloc_type`
 * (the ONLY x86 knowledge the adapter injects). The offset, target name, and
 * base addend ride through unchanged; the shared writer folds a rodata target's
 * `.rodata` offset onto the addend and resolves the name to a symbol index.
 *
 * @param EncodedModuleX86 enc  the x86 module (relocations)
 * @return []ElfRelocReq  the neutral relocation requests, in emission order
 */
fn x86_reloc_reqs(enc: EncodedModuleX86) -> []ElfRelocReq {
    mut out: []ElfRelocReq = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= enc.relocs.len { break }
        let r = enc.relocs[i]
        if r.sect == RelocSect::Text { out = teko::list::push(out, ElfRelocReq { offset = r.offset; sym = r.sym; rtype = elf_reloc_type(r.kind); addend = r.addend }) }
        i++
    }
    out
}

/**
 * x86_rodata_reloc_reqs — the `.rodata`-partition twin of `x86_reloc_reqs` (#594
 * T-B5): lower every `RelocX86` whose patch site is INSIDE `.rodata`
 * (`sect == Rodata`) to a neutral `ElfRelocReq` for `.rela.rodata`. Empty in every
 * real compile until T-B6.
 *
 * @param EncodedModuleX86 enc  the x86 module (relocations, `.sect`-tagged)
 * @return []ElfRelocReq  the `.rodata`-relative relocation requests, in order
 */
fn x86_rodata_reloc_reqs(enc: EncodedModuleX86) -> []ElfRelocReq {
    mut out: []ElfRelocReq = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= enc.relocs.len { break }
        let r = enc.relocs[i]
        if r.sect == RelocSect::Rodata { out = teko::list::push(out, ElfRelocReq { offset = r.offset; sym = r.sym; rtype = elf_reloc_type(r.kind); addend = r.addend }) }
        i++
    }
    out
}

/**
 * EM_AARCH64 — the `Elf64_Ehdr.e_machine` value identifying an AArch64 (arm64)
 * object (`/usr/include/elf.h`, value 183). The AArch64 LP64 ABI defines no
 * processor-specific `e_flags` for an `ET_REL`, so `emit_elf_arm64` passes `0`
 * exactly as the x86-64 adapter does; both halves were measured against a
 * `clang --target=aarch64-linux-gnu` reference object, whose header reads
 * `Machine: AArch64  Flags: 0x0`.
 *
 * @since 0.3.1
 */
const EM_AARCH64: u32 = 183 to u32

/**
 * R_AARCH64_ADR_PREL_PG_HI21 — the `Elf64_Rela` `r_info` type for the 21-bit
 * page displacement an `ADRP` immediate carries, bits 32:12 of `Page(S+A) -
 * Page(P)` (`/usr/include/elf.h`, value 275). The high half of every AArch64
 * address pair, whether the target is a `.rodata` datum or a function.
 *
 * @since 0.3.1
 */
const R_AARCH64_ADR_PREL_PG_HI21: u32 = 275 to u32

/**
 * R_AARCH64_ADD_ABS_LO12_NC — the `Elf64_Rela` `r_info` type for the low-12
 * immediate of an `ADD` (`/usr/include/elf.h`, value 277): bits 11:0 of `S+A`,
 * UNSCALED and unchecked. The `LDST*_ABS_LO12_NC` family patches the same 12
 * bits but SCALED by the access size, so this constant belongs to an `ADD`
 * alone — `elf_arm64_reloc_kinds_are_add_form_only` pins that.
 *
 * @since 0.3.1
 */
const R_AARCH64_ADD_ABS_LO12_NC: u32 = 277 to u32

/**
 * R_AARCH64_CALL26 — the `Elf64_Rela` `r_info` type for the 26-bit
 * PC-relative displacement of a `BL` (`/usr/include/elf.h`, value 283), bits
 * 27:2 of `S+A-P`. The AArch64-ELF counterpart of Mach-O's
 * `ARM64_RELOC_BRANCH26`, and like it, legal on a branch word only.
 *
 * @since 0.3.1
 */
const R_AARCH64_CALL26: u32 = 283 to u32
