/**
 * xat_fconst — append `%r = const.f64 <bits>` to `f0`, the float twin of
 * `xat_const`, so a fixture can produce an FPR-classed argument operand.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u64 bits  the literal's IEEE-754 bit pattern
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn xat_fconst(f0: lir::LFunc, bits: u64) -> lir::FreshVReg {
    let r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_float_inst(r.vreg, bits, true, 0, 0)); vreg = r.vreg }
}

#test

/**
 * xat_win64_call_args_number_both_files_by_shared_position — the CALLER half of
 * `B3-argslot`, and the shape that faulted on Windows: an outgoing
 * `(f64, i64, f64, i64, i64)` argument list takes XMM0, RDX, XMM2, R9 and one
 * stack slot, never the SysV-style XMM0, RCX, XMM1, RDX with nothing on the stack.
 *
 * This is `tk_ftoa_len(double, uint64_t *out_len)` generalized: its out-pointer is
 * argument POSITION 1, so it belongs in RDX, and the per-file counter left it in
 * RCX while the MSVC-built callee wrote through whatever RDX happened to hold.
 *
 * Every operand is spelled with its OWN register-file marker, the one
 * `reg_ref_x86` prints: a virtual FPR is `%fN`, never `%N`. `pin_reg_args_x86`
 * builds an argument move's destination AND its source from the one `is_fpr`
 * decision, so an `fmov` whose source carried the GPR spelling was a text no
 * selection could ever emit — a guard that failed on every host, not a
 * platform difference. `xat_float_param_lands_in_xmm0_and_returns_in_xmm0`
 * had already been asserting `fmov.d %pf0, %f0` green over this same pin.
 *
 * Inverted against the per-file counting this rule replaced (`WIN64` with
 * `arg_slots_shared = false`) 4 of these 5 assertions go red; against the
 * shared-position rule, 0 of 5.
 *
 * @return void
 */
fn xat_win64_call_args_number_both_files_by_shared_position() {
    let text = xat_dump_abi(WIN64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p2, %1")
    teko::assert::str_contains(text, "fmov.d %pf2, %f2")
    teko::assert::str_contains(text, "mov.q %p9, %3")
    teko::assert::str_contains(text, "mov.q [outarg #0], %4")
}

#test

/**
 * xat_sysv_call_args_keep_independent_per_file_counting — the byte-identity
 * guardrail for the caller half: the same argument list keeps SysV's
 * XMM0/RDI/XMM1/RSI/RDX with no outgoing stack slot at all.
 *
 * The float sources carry the `%fN` file marker for the same reason the Win64
 * twin above does — the caller-side spelling is the printer's, not the
 * fixture author's. Its first assertion is BYTE-IDENTICAL to the Win64 twin's,
 * which is why the two can only ever be red together: a CI leg reporting one
 * and not the other reported an incomplete run, never a platform difference.
 *
 * @return void
 */
fn xat_sysv_call_args_keep_independent_per_file_counting() {
    let text = xat_dump_abi(SYSV64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p7, %1")
    teko::assert::str_contains(text, "fmov.d %pf1, %f2")
    teko::assert::str_contains(text, "mov.q %p6, %3")
    teko::assert::str_contains(text, "mov.q %p2, %4")
    teko::assert::is_false(teko::runtime::str_contains(text, "[outarg #"))
}
