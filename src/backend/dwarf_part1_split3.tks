/**
 * append_std_opcode_lengths — the twelve standard-opcode operand-count bytes for opcode_base 13
 * (`00 01 01 01 01 00 00 00 01 00 00 01`), the DWARF-4 default set the golden uses.
 *
 * @param buf  the buffer to extend
 * @return     `buf` followed by the twelve bytes
 * @since 0.3.1.0
 */
fn append_std_opcode_lengths(buf: []byte) -> []byte {
    let lens: []u64 = [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= lens.len { break }
        b = teko::list::push(b, lens[i] to byte)
        i = i + 1
    }
    b
}

/**
 * DW_LNS_COPY — the standard line opcode that appends the current row to the matrix.
 *
 * @since 0.3.1.0
 */
const DW_LNS_COPY: u64 = 0x01

/**
 * DW_LNS_ADVANCE_PC — the standard line opcode that advances the code address by a ULEB operand.
 *
 * @since 0.3.1.0
 */
const DW_LNS_ADVANCE_PC: u64 = 0x02

/**
 * DW_LNS_ADVANCE_LINE — the standard line opcode that advances the source line by an SLEB operand.
 *
 * @since 0.3.1.0
 */
const DW_LNS_ADVANCE_LINE: u64 = 0x03

/**
 * DW_LNS_SET_FILE — the standard line opcode that sets the current file register to a ULEB operand.
 *
 * @since 0.3.1.0
 */
const DW_LNS_SET_FILE: u64 = 0x04

/**
 * DW_LNS_SET_COLUMN — the standard line opcode that sets the column to a ULEB operand.
 *
 * @since 0.3.1.0
 */
const DW_LNS_SET_COLUMN: u64 = 0x05

/**
 * LINE_FIRST_FILE — the DWARF line state machine's initial file register (1). A row keeping this
 * file emits no set_file opcode, so a single-file program's line program is unchanged.
 *
 * @since 0.3.1.0
 */
const LINE_FIRST_FILE: i64 = 1

/**
 * emit_line_row — append one line-program row to `prog`. The first row (`first` true, `prev` the
 * initial line 1) advances the line and sets column 1 with no address advance; every later row
 * advances the code address then the line. When the row's file differs from the running file
 * register `cur_file`, a set_file opcode precedes the line advance; a row keeping the current file
 * emits no set_file, so a single-file program is unchanged. Each row ends with a copy.
 *
 * @param prog      the program bytes so far
 * @param row       the row to emit
 * @param prev      the source line of the previous row (1 before the first row)
 * @param cur_file  the file register before this row (1 before the first row)
 * @param first     true for the first row (sets column 1, no pc advance)
 * @return          the extended program bytes
 * @since 0.3.1.0
 */
fn emit_line_row(prog: []byte, row: DwLineRow, prev: u32, cur_file: i64, first: bool) -> []byte {
    mut b = prog
    if !first {
        b = teko::list::push(b, DW_LNS_ADVANCE_PC to byte)
        b = uleb128(b, row.pc_advance)
    }
    if row.file != cur_file {
        b = teko::list::push(b, DW_LNS_SET_FILE to byte)
        b = uleb128(b, row.file to u64)
    }
    b = teko::list::push(b, DW_LNS_ADVANCE_LINE to byte)
    b = sleb128(b, (row.line to i64) - (prev to i64))
    if first {
        b = teko::list::push(b, DW_LNS_SET_COLUMN to byte)
        b = uleb128(b, 1 to u64)
    }
    teko::list::push(b, DW_LNS_COPY to byte)
}

/**
 * debug_line — the minimal `.debug_line` program for a single compile unit: the DWARF-4 header, a
 * `set_address` extended opcode (relocated to `start_symbol`), one row per `rows` entry, a final
 * address advance, and `end_sequence`. The emitted bytes and the single set_address relocation
 * reproduce the gdb-and-lldb-verified golden.
 *
 * @param files             the source file names, in file-table order (index 1 is the primary file)
 * @param start_symbol      the code symbol the initial set_address relocates against
 * @param rows              the address→line rows (the first row sits at set_address)
 * @param final_pc_advance  the code advance emitted before end_sequence (past the last row)
 * @return                  the `.debug_line` section bytes and its single relocation
 * @since 0.3.1.0
 */
pub fn debug_line(files: []str, start_symbol: str, rows: []DwLineRow, final_pc_advance: u64) -> DwSection {
    let header = line_header_body(files)
    mut prog: []byte = teko::list::empty()
    prog = teko::list::push(prog, 0x00 to byte)
    prog = teko::list::push(prog, 0x09 to byte)
    prog = teko::list::push(prog, 0x02 to byte)
    let set_addr_slot = line_prefix_len() + header.len + prog.len
    prog = emit_addr_slot(prog)
    mut prev: u32 = 1
    mut cur_file: i64 = LINE_FIRST_FILE
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        prog = emit_line_row(prog, rows[i], prev, cur_file, i == 0)
        prev = rows[i].line
        cur_file = rows[i].file
        i = i + 1
    }
    prog = teko::list::push(prog, DW_LNS_ADVANCE_PC to byte)
    prog = uleb128(prog, final_pc_advance)
    prog = teko::list::push(prog, 0x00 to byte)
    prog = teko::list::push(prog, 0x01 to byte)
    prog = teko::list::push(prog, 0x01 to byte)
    let header_length = header.len
    let unit_length = header.len + prog.len + 2 + 4
    mut out: []byte = teko::list::empty()
    out = emit_u32_le_dw(out, unit_length)
    out = emit_u16_le(out, 4 to u64)
    out = emit_u32_le_dw(out, header_length)
    out = append_bytes_dw(out, header)
    out = append_bytes_dw(out, prog)
    let relocs = teko::list::push(teko::list::empty(), DwReloc { offset = set_addr_slot; symbol = start_symbol })
    DwSection { bytes = out; relocs = relocs }
}

/**
 * line_prefix_len — the byte count of the `.debug_line` unit header fields that precede the header
 * body (unit_length 4 + version 2 + header_length 4), so the set_address slot's offset inside the
 * program maps to its offset inside the whole section.
 *
 * @return  the prefix length (10)
 * @since 0.3.1.0
 */
fn line_prefix_len() -> u64 {
    10 to u64
}

/**
 * DwarfSink — the three PRODUCED section images (D1.3's output) an object writer sinks into a
 * native ELF or Mach-O object (D1.4/D1.5): the fixed `.debug_abbrev` bytes (never relocated) plus
 * the `.debug_info` and `.debug_line` sections with their absolute-address relocations. `present`
 * gates emission everywhere a writer consumes this type: false — the `DebugInfo::None` default —
 * means the object writer places NOTHING, so the object stays byte-for-byte identical to a build
 * with no debug axis at all (the FIXPOINT the sink must never disturb).
 *
 * @since 0.3.1.0
 */
pub type DwarfSink = struct {
    /** true iff the three sections below carry real content to place. */
    present: bool
    /** the `.debug_abbrev` section bytes (valid iff `present`). */
    abbrev: []byte
    /** the `.debug_info` section bytes + relocations (valid iff `present`). */
    info: DwSection
    /** the `.debug_line` section bytes + relocations (valid iff `present`). */
    line: DwSection
}

/**
 * empty_dw_section — a `DwSection` with no bytes and no relocations, the filler `no_dwarf_sink`
 * gives its `info`/`line` fields.
 *
 * @return  the empty section
 * @since 0.3.1.0
 */
fn empty_dw_section() -> DwSection {
    DwSection { bytes = teko::list::empty(); relocs = teko::list::empty() }
}

/**
 * no_dwarf_sink — the absent `DwarfSink` (`present = false`): the value every ELF/Mach-O writer
 * entry point defaults to, so a build that never requests `--debug=lines` (`DebugInfo::None`)
 * places no DWARF bytes and stays byte-for-byte identical to today's object.
 *
 * @return  the absent sink
 * @since 0.3.1.0
 */
pub fn no_dwarf_sink() -> DwarfSink {
    DwarfSink { present = false; abbrev = teko::list::empty(); info = empty_dw_section(); line = empty_dw_section() }
}

/**
 * build_dwarf_sink — assemble the D1.3 producers (`debug_abbrev`/`debug_info`/`debug_line`) into a
 * `present = true` `DwarfSink`, the shape D1.4/D1.5's object writers consume. The single call site
 * a `--debug=lines` native build reaches once it has assembled `cu`/`files`/`rows` from the checked
 * program and the encoded module (`project.tks`'s build glue — the checker/LIR side of the D1.4/
 * D1.5 wiring); this function owns no knowledge of either.
 *
 * @param cu                the compile unit (`.debug_info`'s content)
 * @param files             the source file names, in file-table order (`.debug_line`'s header)
 * @param rows              the whole-unit address→line rows, in ascending address order
 * @param final_pc_advance  the code advance from the last row to the end of `.text`
 * @return                  the assembled, `present = true` sink
 * @since 0.3.1.0
 */
pub fn build_dwarf_sink(cu: DwCompileUnit, files: []str, rows: []DwLineRow, final_pc_advance: u64) -> DwarfSink {
    DwarfSink {
        present = true
        abbrev = debug_abbrev()
        info = debug_info(cu)
        line = debug_line(files, cu.text_symbol, rows, final_pc_advance)
    }
}

/**
 * DwBaseType — one scalar base type the compile unit describes (a DW_TAG_base_type DIE): its Teko
 * name, its size in bytes, and its DWARF `DW_AT_encoding` (one of the frozen `DW_ATE_*`). The DIE a
 * variable's `DW_AT_type` points at.
 *
 * @since 0.3.1.0
 */
pub type DwBaseType = struct {
    /** the type's Teko name, inlined as the DIE's DW_AT_name (e.g. "i32"). */
    name: str
    /** the type's size in bytes, the DW_AT_byte_size data1. */
    byte_size: u64
    /** the DWARF DW_AT_encoding (a frozen `DW_ATE_*` value), emitted as data1. */
    encoding: u64
}

/**
 * DwBaseTypeLookup — the outcome of `frozen_base_type` (option-struct, M.2): `found` is false when
 * the queried name is not one of the FROZEN scalar types (D2.5), in which case no `DW_TAG_base_type`
 * DIE is describable for it and the caller MUST NOT synthesize one from a guess. `base_type` carries
 * the described type only when `found`.
 *
 * @since 0.3.1.0
 */
pub type DwBaseTypeLookup = struct {
    /** true iff the queried name names a frozen scalar type. */
    found: bool
    /** the described base type; valid only when `found`. */
    base_type: DwBaseType
}

/**
 * dw_bt_found — the found-branch `DwBaseTypeLookup` for one frozen `name`/`byte_size`/`encoding`
 * triple, extracted so `frozen_base_type`'s guard chain stays one line per type.
 *
 * @param name       the frozen type's Teko name
 * @param byte_size  the frozen type's DW_AT_byte_size
 * @param encoding   the frozen type's DW_AT_encoding (one of the `DW_ATE_*` constants)
 * @return           `found = true`, carrying the described base type
 * @since 0.3.1.0
 */
fn dw_bt_found(name: str, byte_size: u64, encoding: u64) -> DwBaseTypeLookup {
    DwBaseTypeLookup { found = true; base_type = DwBaseType { name = name; byte_size = byte_size; encoding = encoding } }
}

/**
 * dw_bt_not_found — the not-found `DwBaseTypeLookup` `frozen_base_type` returns for any name outside
 * the frozen list.
 *
 * @return  `found = false`, with a zeroed placeholder `base_type`
 * @since 0.3.1.0
 */
fn dw_bt_not_found() -> DwBaseTypeLookup {
    DwBaseTypeLookup { found = false; base_type = DwBaseType { name = ""; byte_size = 0 to u64; encoding = 0 to u64 } }
}

/**
 * frozen_base_type — the D2.5 frozen registry: the ONLY Teko scalar type names the DWARF writer may
 * describe as a `DW_TAG_base_type`, each carrying its byte size and `DW_AT_encoding`. The list is
 * explicit and enumerated on purpose — a name outside it (a struct, a slice, `str`, or a future
 * scalar not yet reviewed) returns `found = false`, never a guessed description. Widening the
 * registry is a deliberate, reviewed addition to this function's guard chain, never an inferred
 * default.
 *
 * @param name  the Teko scalar type name (e.g. "i32", "f64", "bool", "byte")
 * @return      the described base type, or `found = false` when `name` is not frozen
 * @since 0.3.1.0
 */
