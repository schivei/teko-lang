#test
fn rgt_regalloc_module_carries_tables_and_propagates() {
    var f1 = rgt_named_func("a", rgt_add_fixture())
    var f2 = rgt_named_func("b", rgt_add_fixture())
    var funcs = teko::list::push(teko::list::push(teko::list::empty(), f1), f2)
    var rodata = teko::list::push(teko::list::empty(), lir::LRodata { symbol = "r0"; bytes = teko::list::empty(); relocs = teko::list::empty() })
    var m = MModule { funcs = funcs; rodata = rodata; globals = teko::list::empty(); layouts = teko::list::empty() }
    var cm = match regalloc_module(AAPCS64, m) {
        MModule as x => x
        error => return
    }
    teko::assert::is_true(cm.funcs.len == (2 to u64))
    teko::assert::is_true(cm.rodata.len == (1 to u64))
    var pressured = rgt_module_of(rgt_named_func("main", rgt_fpr_spill_fixture()))
    var spilled = match regalloc_module(rgt_fpr_spill_abi(), pressured) {
        MModule as x => x
        error => return
    }
    teko::assert::is_true(spilled.funcs.len == (1 to u64))
    teko::assert::is_true(all_physical(spilled.funcs[0]))
    teko::assert::is_true(spilled.funcs[0].frame.len > (0 to u64))
    teko::assert::is_true(rgt_has_fspill(spilled.funcs[0]))
}

fn rgt_has_fspill(f: MFunc): bool {
    var bi: u64 = 0
    loop {
        if bi >= f.blocks.len { break }
        var b = f.blocks[bi]
        var ii: u64 = 0
        loop {
            if ii >= b.insts.len { break }
            var is_fspill = match b.insts[ii] { MFSpill => true; _ => false }
            if is_fspill { return true }
            ii++
        }
        bi++
    }
    false
}

