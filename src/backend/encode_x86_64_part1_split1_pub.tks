pub type EncRelocX86 = struct {
    /**
     * field_off — the byte offset WITHIN the instruction's `bytes` of the field
     * the relocation patches (the emit pass rebases it by the instruction's
     * start offset in the function's `.text` image).
     */
    field_off: u32
    /**
     * sym — the relocation's target symbol, already in its final linker name.
     */
    sym: str
    /**
     * kind — which psABI relocation the writer emits (`Plt32` for a direct
     * `call`, `Pc32` for a rip-relative `lea`, `Abs64` for a data pointer).
     */
    kind: RelocKindX86
}

/**
 * EncInstX86 — one x86-64 instruction's encoding outcome: its variable-length
 * byte string plus optional pending fixups. A position-independent instruction
 * resolves to just `bytes` (`has_branch` false, `reloc` null). An intra-function
 * branch carries a `rel32` fixup — the byte offset WITHIN `bytes` of the 4-byte
 * little-endian displacement field and the destination machine-block id —
 * patched once every block's byte offset is known (the B1-6 layout pass). A
 * symbol reference carries an `EncRelocX86`, materialized into an `Elf64_Rela`
 * at B1-7. Mirrors arm64's `EncWord`, byte-granular instead of fixed 32-bit
 * words.
 *
 * @since #386 B1-5
 */
pub type EncInstX86 = struct {
    /**
     * bytes — the instruction's encoded bytes (1..15), in order, ready to
     * append to the function's `.text` image.
     */
    bytes: []byte
    /**
     * has_branch — true iff a `rel32` block displacement must be patched in.
     */
    has_branch: bool
    /**
     * branch_field_off — the byte offset within `bytes` of the 4-byte rel32
     * field (meaningful when `has_branch`).
     */
    branch_field_off: u32
    /**
     * target — the destination machine-block id (meaningful when `has_branch`).
     */
    target: u32
    /**
     * reloc — the symbol relocation this instruction owes, or `null` when it
     * owes none. There is no third state and no inert default.
     */
    reloc: EncRelocX86 | null
}

/**
 * FrameLayoutX86 — the resolved stack frame of one x86-64 function: its total
 * 16-aligned byte size, the ordered callee-saved registers to save/restore
 * (re-derived by scanning the physical function, not carried by `MFuncX86`),
 * and the RSP-relative byte offset of every `MFuncX86.frame` slot. Purely a
 * side-table the encoder reads to resolve `MFrameAddrX86` to a concrete
 * `lea dst, [rsp+off]`; the block stream is never rewritten. A `size` of 0
 * marks a frameless function (no prologue/epilogue) UNLESS `call_align` is
 * true, in which case a minimal alignment-only `push rbp`/`mov rbp,rsp` is
 * still emitted (`frame_is_framed_x86`, 0.3.1.0 degrau 19). B1-5 defines the
 * type and resolves `MFrameAddrX86` through it (the §6.1 signature); B1-6
 * fills it via `compute_frame_layout_x86` and emits the matching
 * prologue/epilogue. Mirrors arm64's `FrameLayout`.
 *
 * @since #386 B1-5
 */
pub type FrameLayoutX86 = struct {
    /**
     * size — the total frame size in bytes, rounded up to 16 (SysV 16-byte
     * call-site alignment); 0 for a frameless function.
     */
    size: u32
    /**
     * saved_gpr — the callee-saved GPR ids to push/pop, ascending for a
     * deterministic prologue.
     */
    saved_gpr: []u32
    /**
     * saved_fpr — the callee-saved FPR ids to save/restore, ascending.
     */
    saved_fpr: []u32
    /**
     * slot_offsets — the RSP-relative byte offset of each `MFuncX86.frame`
     * entry, in frame order; `MFrameAddrX86{slot}` resolves to
     * `lea dst, [rsp+slot_offsets[slot]]`.
     */
    slot_offsets: []u32
    /**
     * call_align — true iff the function needs a minimal alignment-only
     * prologue/epilogue purely to restore 16-byte alignment at the calls it
     * itself issues (`needs_call_align_x86`), independent of `size`/the saved
     * lists — a function otherwise entitled to be frameless (zero slots, zero
     * callee-saved) is NOT frameless when this is true.
     */
    call_align: bool
    /**
     * out_arg_base — the RSP-relative byte offset of the FIRST outgoing
     * stack-argument slot (`B1-args`): 0 under SysV, and `abi.shadow_space`
     * (32) under Win64, whose stack arguments begin just above the
     * caller-reserved shadow area. `MOutArgX86{index}` resolves to
     * `mov [rsp + out_arg_base + 8*index], src`.
     */
    out_arg_base: u32
    /**
     * fpr_save_base — the RSP-relative byte offset of the FIRST callee-saved XMM
     * save slot (`B3-xmm-callee-saved`); each `saved_fpr` entry takes 16 bytes
     * from there, ascending. Sits just above the argument-passing region and
     * below the local slots, and is 16-aligned so `movaps` is legal.
     */
    fpr_save_base: u32
    /**
     * caller_shadow — the shadow space the CALLER reserved below the incoming
     * stack arguments (`abi.shadow_space`: 32 under Win64, 0 everywhere else), the
     * distance `in_arg_base_x86` must skip to reach incoming stack argument 0.
     *
     * NOT `shadow_bytes_x86`, and the difference is the defect it fixes: that one
     * is 0 for a LEAF, because a leaf reserves no shadow of its OWN — but the
     * shadow below THIS function's incoming arguments belongs to whoever called
     * it, and every Win64 caller reserves it whether or not this callee goes on to
     * call anything. Reading the caller-side number off the callee-side one made a
     * Win64 callee load its fifth argument 32 bytes low, out of its own home-space
     * area.
     */
    caller_shadow: u32
}
