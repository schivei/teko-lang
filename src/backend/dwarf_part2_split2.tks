/**
 * emit_base_type_die — append one base_type DIE (abbrev 2): the abbrev code, the name string, the
 * DW_AT_encoding data1, and the DW_AT_byte_size data1.
 *
 * @param body  the DIE body accumulated so far
 * @param bt    the base type to describe
 * @return      the extended body
 * @since 0.3.1.0
 */
fn emit_base_type_die(body: []byte, bt: DwBaseType) -> []byte {
    mut b = teko::list::push(body, 0x02 to byte)
    b = emit_cstr(b, bt.name)
    b = teko::list::push(b, bt.encoding to byte)
    teko::list::push(b, bt.byte_size to byte)
}

/**
 * emit_locals_subprogram — append one subprogram DIE (abbrev 3) with its children, recording the
 * low_pc relocation. Layout: abbrev code, name, decl_file (sdata), decl_line (data2), low_pc (addr,
 * relocated), high_pc (data8 code size), frame_base (exprloc), then a formal_parameter DIE per
 * parameter, a variable DIE per local, a lexical_block per scope, and the null child terminator.
 *
 * @param body               the DIE body accumulated so far
 * @param relocs             the relocations accumulated so far
 * @param sub                the subprogram to describe
 * @param base_type_offsets  the CU-relative base_type DIE offsets, for each local's DW_AT_type ref4
 * @return                   the extended body and relocation list
 * @since 0.3.1.0
 */
fn emit_locals_subprogram(body: []byte, relocs: []DwReloc, sub: DwSubprogramLocals, base_type_offsets: []u64) -> DwSection {
    mut b = teko::list::push(body, 0x03 to byte)
    b = emit_cstr(b, sub.name)
    b = sleb128(b, sub.decl_file)
    b = emit_u16_le(b, sub.decl_line to u64)
    let low_pc_off = header_len_prefix() + b.len
    b = emit_addr_slot(b)
    let r = teko::list::push(relocs, DwReloc { offset = low_pc_off; symbol = sub.symbol })
    b = emit_u64_le_dw(b, sub.code_size)
    b = emit_frame_base(b, sub.frame_base_op)
    b = emit_local_list(b, sub.params, base_type_offsets)
    b = emit_local_list(b, sub.locals, base_type_offsets)
    b = emit_scope_list(b, sub.blocks, base_type_offsets)
    b = teko::list::push(b, 0x00 to byte)
    DwSection { bytes = b; relocs = r }
}

/**
 * emit_frame_base — append the DW_AT_frame_base exprloc: a ULEB128 length of 1 followed by the
 * single frame-base opcode. The opcode is a PLACEHOLDER (DW_OP_REG6_RBP_PLACEHOLDER) until the real
 * frame descriptor is wired in.
 *
 * @param buf  the DIE body accumulated so far
 * @param op   the frame-base opcode
 * @return     the extended body
 * @since 0.3.1.0
 */
fn emit_frame_base(buf: []byte, op: u64) -> []byte {
    let b = uleb128(buf, 1 to u64)
    teko::list::push(b, op to byte)
}

/**
 * emit_local_list — append a formal_parameter or variable DIE for each local in `locals`, in order.
 *
 * @param buf                the DIE body accumulated so far
 * @param locals             the locals to describe
 * @param base_type_offsets  the CU-relative base_type DIE offsets, for each local's DW_AT_type ref4
 * @return                   the extended body
 * @since 0.3.1.0
 */
fn emit_local_list(buf: []byte, locals: []DwLocal, base_type_offsets: []u64) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= locals.len { break }
        b = emit_local_die(b, locals[i], base_type_offsets)
        i = i + 1
    }
    b
}

/**
 * emit_local_die — append one leaf local DIE: the abbrev code (formal_parameter for a parameter,
 * variable otherwise), the name string, the DW_AT_type ref4 to its base type, and the DW_OP_fbreg
 * location.
 *
 * @param buf                the DIE body accumulated so far
 * @param local              the local to describe
 * @param base_type_offsets  the CU-relative base_type DIE offsets, indexed by `local.type_index`
 * @return                   the extended body
 * @since 0.3.1.0
 */
fn emit_local_die(buf: []byte, local: DwLocal, base_type_offsets: []u64) -> []byte {
    mut b = teko::list::push(buf, local_abbrev_code(local.is_param) to byte)
    b = emit_cstr(b, local.name)
    b = emit_u32_le_dw(b, base_type_offsets[local.type_index])
    emit_fbreg_location(b, local.fbreg_offset)
}

/**
 * local_abbrev_code — the abbreviation code for a local: formal_parameter when `is_param`, else
 * variable.
 *
 * @param is_param  whether the local is a formal parameter
 * @return          the abbreviation code
 * @since 0.3.1.0
 */
fn local_abbrev_code(is_param: bool) -> u64 {
    if is_param { return ABBREV_FORMAL_PARAMETER }
    ABBREV_VARIABLE
}

/**
 * emit_fbreg_location — append a DW_AT_location exprloc: a ULEB128 length prefix followed by the
 * DW_OP_fbreg opcode and the SLEB128 frame-base offset (the placeholder slot offset).
 *
 * @param buf     the DIE body accumulated so far
 * @param offset  the DW_OP_fbreg offset from the frame base
 * @return        the extended body
 * @since 0.3.1.0
 */
fn emit_fbreg_location(buf: []byte, offset: i64) -> []byte {
    mut expr = teko::list::push(teko::list::empty(), DW_OP_FBREG to byte)
    expr = sleb128(expr, offset)
    let b = uleb128(buf, expr.len)
    append_bytes_dw(b, expr)
}

/**
 * emit_scope_list — append one lexical_block DIE for each scope in `scopes`, in order.
 *
 * @param buf                the DIE body accumulated so far
 * @param scopes             the lexical blocks to describe
 * @param base_type_offsets  the CU-relative base_type DIE offsets, for each block local's ref4
 * @return                   the extended body
 * @since 0.3.1.0
 */
fn emit_scope_list(buf: []byte, scopes: []DwScope, base_type_offsets: []u64) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= scopes.len { break }
        b = emit_scope_block(b, scopes[i], base_type_offsets)
        i = i + 1
    }
    b
}

/**
 * emit_scope_block — append one lexical_block DIE (abbrev 6): the abbrev code, a variable DIE per
 * block local, and the null child terminator.
 *
 * @param buf                the DIE body accumulated so far
 * @param scope              the lexical block to describe
 * @param base_type_offsets  the CU-relative base_type DIE offsets, for each block local's ref4
 * @return                   the extended body
 * @since 0.3.1.0
 */
fn emit_scope_block(buf: []byte, scope: DwScope, base_type_offsets: []u64) -> []byte {
    mut b = teko::list::push(buf, 0x06 to byte)
    b = emit_local_list(b, scope.locals, base_type_offsets)
    teko::list::push(b, 0x00 to byte)
}
