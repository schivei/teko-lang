
/**
 * emit_macho — assemble a Mach-O `MH_OBJECT` for arm64 from an `EncodedModule`:
 * the `mach_header_64` + `LC_SEGMENT_64` (`__text`/`__const`) + — when `dwarf.present`
 * (D1.5) — a second `LC_SEGMENT_64` for `__DWARF` (`__debug_abbrev`/`__debug_info`/
 * `__debug_line`) + `LC_BUILD_VERSION` + `LC_SYMTAB` + `LC_DYSYMTAB`, then the section
 * images, the `__text`/`__const` relocation tables, then — when `dwarf.present` — the
 * DWARF section images and their relocation tables, then the symbol + string tables.
 * Enough for `cc`/`ld` to link into a runnable executable against the C-built
 * `teko_rt` (D-2 option 1 bootstrap). The `__info_plist` section is added at LINK
 * time (A4-5, `-Wl,-sectcreate`), not embedded here. Data globals + GOT relocs are
 * the `A4-globals` stop, raised earlier in `encode_module`. With `dwarf` omitted
 * (`no_dwarf_sink()`, the `DebugInfo::None` default) the byte output is IDENTICAL to
 * before D1.5 — the FIXPOINT this sink must never disturb.
 *
 * @param EncodedModule enc  the section images + symbols + relocations
 * @param DwarfSink dwarf  the D1.3 producer output to sink (default absent)
 * @return []byte  the Mach-O object file bytes
 */
pub fn emit_macho(enc: EncodedModule, dwarf: DwarfSink) -> []byte {
    let parts = macho_partition_relocs(enc.relocs)
    let strtab = build_strtab(enc.symbols)
    let lay = compute_macho_layout(enc, strtab.bytes.len to u32, parts.text.len to u32, parts.rodata.len to u32, dwarf)
    mut b: []byte = teko::list::empty()
    b = emit_header(b, lay)
    b = emit_segment(b, lay)
    if dwarf.present { b = emit_dwarf_segment(b, lay) }
    b = emit_build_version(b)
    b = emit_symtab_cmd(b, lay)
    b = emit_dysymtab_cmd(b, lay)
    b = append_bytes(b, enc.text)
    b = pad_to_offset(b, lay.const_offset)
    b = append_bytes(b, enc.rodata)
    b = pad_to_mult(b, 4)
    b = emit_reloc_table(b, parts.text, enc.symbols)
    b = emit_reloc_table(b, parts.rodata, enc.symbols)
    if dwarf.present { b = emit_dwarf_body(b, dwarf, enc.symbols) }
    b = pad_to_mult(b, 8)
    b = emit_symtab(b, enc.symbols, strtab, lay.const_addr)
    append_bytes(b, strtab.bytes)
}
