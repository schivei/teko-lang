/**
 * ARM64_BCOND — the conditional-branch (B.cond) placeholder template, its
 * condition field zero and imm19 field left zero for `A4-3` patching
 * (`encode_branch_cond`).
 */
const ARM64_BCOND: u32 = 0x54000000 to u32

/**
 * ARM64_CBZ — the compare-and-branch-if-zero placeholder template
 * (`encode_cbz`'s zero arm).
 */
const ARM64_CBZ: u32 = 0x34000000 to u32

/**
 * ARM64_CBNZ — the compare-and-branch-if-nonzero placeholder template
 * (`encode_cbz`'s nonzero arm).
 */
const ARM64_CBNZ: u32 = 0x35000000 to u32

/**
 * ARM64_BL — the direct-call (BL) placeholder template, flagged for a `Call`
 * relocation (`encode_call`).
 */
const ARM64_BL: u32 = 0x94000000 to u32

/**
 * ARM64_BLR — the indirect-call (BLR) template (`encode_call_indirect`).
 */
const ARM64_BLR: u32 = 0xD63F0000 to u32

/**
 * ARM64_ADRP — the page-high-address (ADRP) placeholder template, flagged for
 * a PAGE21 relocation (`encode_adrp`).
 */
const ARM64_ADRP: u32 = 0x90000000 to u32

/**
 * ARM64_RET — the bare return (RET) word (`encode_ret`).
 */
const ARM64_RET: u32 = 0xD65F03C0 to u32

/**
 * ARM64_STP_GPR64 — the 64-bit GPR store-pair (STP) template, `Rn=SP` baked
 * in (`stp_gpr`).
 */
const ARM64_STP_GPR64: u32 = 0xA9000000 to u32

/**
 * ARM64_LDP_GPR64 — the 64-bit GPR load-pair (LDP) template, `Rn=SP` baked in
 * (`ldp_gpr`).
 */
const ARM64_LDP_GPR64: u32 = 0xA9400000 to u32

/**
 * ARM64_STP_FPR64 — the 64-bit FPR store-pair (STP) template, `Rn=SP` baked
 * in (`stp_fpr`).
 */
const ARM64_STP_FPR64: u32 = 0x6D000000 to u32

/**
 * ARM64_LDP_FPR64 — the 64-bit FPR load-pair (LDP) template, `Rn=SP` baked in
 * (`ldp_fpr`).
 */
const ARM64_LDP_FPR64: u32 = 0x6D400000 to u32

/**
 * ARM64_STR_FPR64 — the 64-bit FPR unsigned-offset store (STR) template,
 * `Rn=SP` baked in (`str_fpr_sp`).
 */
const ARM64_STR_FPR64: u32 = 0xFD000000 to u32

/**
 * ARM64_LDR_FPR64 — the 64-bit FPR unsigned-offset load (LDR) template,
 * `Rn=SP` baked in (`ldr_fpr_sp`).
 */
const ARM64_LDR_FPR64: u32 = 0xFD400000 to u32

/**
 * ARM64_FTYPE_D — the `type` field's double-precision bit (`1 << 22`), the ONE
 * bit that turns every scalar float template below from its `S`
 * (single-precision) shape into its `D` (double-precision) shape. Every FP
 * template in this file is stored in its `type=00` (single) form, exactly as
 * every width-parametric integer template is stored bit-31-clear and ORs
 * `sf_bit` back in — so `ftype_bit` is the float family's `sf_bit`.
 *
 * Cross-checked against `llvm-mc -triple=aarch64`: `fadd s0,s0,s0` =
 * `0x1E202800`, `fadd d0,d0,d0` = `0x1E602800`, and the difference is exactly
 * this bit.
 *
 * @since 0.3.1.0 degrau 29 (A4-fp)
 */
const ARM64_FTYPE_D: u32 = 0x00400000 to u32

/**
 * ARM64_FADD — the single-precision `FADD Sd, Sn, Sm` template (`falu_base`'s
 * `FAdd` arm), operand fields zero. Pinned against `llvm-mc`: `fadd s0,s0,s0`
 * = `0x1E202800`.
 */
const ARM64_FADD: u32 = 0x1E202800 to u32

/**
 * ARM64_FSUB — the single-precision `FSUB Sd, Sn, Sm` template (`falu_base`'s
 * `FSub` arm). Pinned against `llvm-mc`: `fsub s0,s0,s0` = `0x1E203800`.
 */
const ARM64_FSUB: u32 = 0x1E203800 to u32

/**
 * ARM64_FMUL — the single-precision `FMUL Sd, Sn, Sm` template (`falu_base`'s
 * `FMul` arm). Pinned against `llvm-mc`: `fmul s0,s0,s0` = `0x1E200800`.
 */
const ARM64_FMUL: u32 = 0x1E200800 to u32

/**
 * ARM64_FDIV — the single-precision `FDIV Sd, Sn, Sm` template (`falu_base`'s
 * `FDiv` arm). Pinned against `llvm-mc`: `fdiv s0,s0,s0` = `0x1E201800`.
 */
const ARM64_FDIV: u32 = 0x1E201800 to u32

/**
 * ARM64_FNEG — the single-precision `FNEG Sd, Sn` template (`encode_fneg`).
 * AArch64 has a REAL scalar float negate, so `MFNeg` is one word here rather
 * than the x86 twin's sign-bit XOR round-trip through a GPR — and it is the
 * true IEEE negate, correct on `-0.0` and on a NaN payload alike. Pinned
 * against `llvm-mc`: `fneg s0,s0` = `0x1E214000`.
 */
const ARM64_FNEG: u32 = 0x1E214000 to u32

/**
 * ARM64_FCMP — the single-precision `FCMP Sn, Sm` template (`encode_fcmp`),
 * which writes NZCV and no register. Pinned against `llvm-mc`: `fcmp s0,s0` =
 * `0x1E202000`, `fcmp s1,s2` = `0x1E212000`.
 */
const ARM64_FCMP: u32 = 0x1E202000 to u32

/**
 * ARM64_FMOV_FPR_FPR — the single-precision `FMOV Sd, Sn` template
 * (`encode_fmov`'s FPR-to-FPR arm). Pinned against `llvm-mc`: `fmov s0,s0` =
 * `0x1E204000`.
 */
const ARM64_FMOV_FPR_FPR: u32 = 0x1E204000 to u32

/**
 * ARM64_FMOV_GPR_FPR — the `FMOV Wd, Sn` template (`encode_fmov`'s
 * FPR-to-GPR arm): the raw bit pattern crossing OUT of the float file. The
 * 64-bit form (`FMOV Xd, Dn`) sets `sf` AND `type` together, so the crossing
 * forms take `sf_bit(dbl) | ftype_bit(dbl)` as one unit. Pinned against
 * `llvm-mc`: `fmov w0,s0` = `0x1E260000`, `fmov x0,d0` = `0x9E660000`.
 */
const ARM64_FMOV_GPR_FPR: u32 = 0x1E260000 to u32

/**
 * ARM64_FMOV_FPR_GPR — the `FMOV Sd, Wn` template (`encode_fmov`'s
 * GPR-to-FPR arm): the raw bit pattern crossing INTO the float file, which is
 * how `select_const_float` materializes a float literal. Pinned against
 * `llvm-mc`: `fmov s0,w0` = `0x1E270000`, `fmov d0,x0` = `0x9E670000`.
 */
const ARM64_FMOV_FPR_GPR: u32 = 0x1E270000 to u32

/**
 * ARM64_SCVTF — the `SCVTF Sd, Wn` template (`cvt_base`'s `Scvtf` arm): a
 * SIGNED integer widened into a float. `sf` names the GPR (source) width,
 * `type` the FPR (destination) width, and the two are independent — which is
 * exactly the fact `MCvt`'s two width flags exist to carry. Pinned against
 * `llvm-mc`: `scvtf s0,w0` = `0x1E220000`, `scvtf d0,x0` = `0x9E620000`.
 */
const ARM64_SCVTF: u32 = 0x1E220000 to u32

/**
 * ARM64_UCVTF — the `UCVTF Sd, Wn` template (`cvt_base`'s `Ucvtf` arm): an
 * UNSIGNED integer widened into a float. Pinned against `llvm-mc`:
 * `ucvtf s0,w0` = `0x1E230000`, `ucvtf d0,x0` = `0x9E630000`.
 */
const ARM64_UCVTF: u32 = 0x1E230000 to u32

/**
 * ARM64_FCVTZS — the `FCVTZS Wd, Sn` template (`cvt_base`'s `Fcvtzs` arm): a
 * float truncated toward zero into a SIGNED integer. Here `sf` names the
 * DESTINATION (GPR) width and `type` the SOURCE (FPR) width — the mirror of
 * `SCVTF`'s assignment, and the reason the encoder reads `MCvt`'s flags by
 * register file rather than by operand position. Pinned against `llvm-mc`:
 * `fcvtzs w0,s0` = `0x1E380000`, `fcvtzs x0,d0` = `0x9E780000`.
 */
const ARM64_FCVTZS: u32 = 0x1E380000 to u32

/**
 * ARM64_FCVTZU — the `FCVTZU Wd, Sn` template (`cvt_base`'s `Fcvtzu` arm): a
 * float truncated toward zero into an UNSIGNED integer. Pinned against
 * `llvm-mc`: `fcvtzu w0,s0` = `0x1E390000`, `fcvtzu x0,d0` = `0x9E790000`.
 */
const ARM64_FCVTZU: u32 = 0x1E390000 to u32

/**
 * ARM64_FCVT_S_D — the whole `FCVT Sd, Dn` word (`encode_cvt`'s narrowing
 * arm): the f64-to-f32 correctly-rounded convert. The float-to-float family
 * encodes BOTH widths in fixed fields (source in `type`, destination in the
 * `opc` field), so neither direction is derivable from the other by an OR —
 * hence two whole-word constants instead of a template plus a bit. Pinned
 * against `llvm-mc`: `fcvt s0,d0` = `0x1E624000`.
 */
const ARM64_FCVT_S_D: u32 = 0x1E624000 to u32

/**
 * ARM64_FCVT_D_S — the whole `FCVT Dd, Sn` word (`encode_cvt`'s widening
 * arm): the f32-to-f64 exact convert. Pinned against `llvm-mc`:
 * `fcvt d0,s0` = `0x1E22C000`.
 */
const ARM64_FCVT_D_S: u32 = 0x1E22C000 to u32

/**
 * ARM64_LDR_FPR32 — the 32-bit FPR unsigned-offset load (`LDR St`) template
 * (`load_form`'s `S` arm). Pinned against `llvm-mc`: `ldr s0,[x0]` =
 * `0xBD400000`, `ldr s7,[x9,#12]` = `0xBD400D27`.
 */
const ARM64_LDR_FPR32: u32 = 0xBD400000 to u32

/**
 * ARM64_STR_FPR32 — the 32-bit FPR unsigned-offset store (`STR St`) template
 * (`store_form`'s `S` arm). Pinned against `llvm-mc`: `str s0,[x0]` =
 * `0xBD000000`.
 */
const ARM64_STR_FPR32: u32 = 0xBD000000 to u32

/**
 * ARM64_SCALE_S — the byte-access scale of the `S` (single-precision FPR)
 * memory width (4), `load_form`/`store_form`'s `S` arm. Named apart from
 * `ARM64_SCALE_W` even though both are 4: the two widths address different
 * register files, and a future width whose scale diverges must not have to
 * untangle a shared constant.
 */
const ARM64_SCALE_S: u32 = 4 to u32

/**
 * ARM64_SCALE_D — the byte-access scale of the `D` (double-precision FPR)
 * memory width (8), `load_form`/`store_form`'s `D` arm.
 */
const ARM64_SCALE_D: u32 = 8 to u32
