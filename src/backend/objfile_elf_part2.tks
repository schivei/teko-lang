fn compute_elf_layout(obj: ElfObject, rodata_size: u32, drr_size: u32, nsyms: u32, nrela: u32, nrela_rodata: u32, strtab_len: u32, shstrtab_len: u32, first_global: u32, nsects: u32, debug_abbrev_size: u32, debug_info_size: u32, debug_line_size: u32, nrela_debug_info: u32, nrela_debug_line: u32) -> ElfLayout {
    let text_offset = 64 to u32
    let text_size = obj.text.len to u32
    let rodata_offset = align_up(text_offset + text_size, 8 to u32)
    let drr_offset = align_up(rodata_offset + rodata_size, 8 to u32)
    let symtab_offset = align_up(drr_offset + drr_size, 8 to u32)
    let symtab_size = nsyms * ELF64_SYM_SIZE
    let strtab_offset = symtab_offset + symtab_size
    let shstrtab_offset = strtab_offset + strtab_len
    let rela_offset = align_up(shstrtab_offset + shstrtab_len, 8 to u32)
    let rela_size = nrela * ELF64_RELA_SIZE
    let rela_rodata_offset = align_up(rela_offset + rela_size, 8 to u32)
    let rela_rodata_size = nrela_rodata * ELF64_RELA_SIZE
    let debug_abbrev_offset = align_up(rela_rodata_offset + rela_rodata_size, 8 to u32)
    let debug_info_offset = align_up(debug_abbrev_offset + debug_abbrev_size, 8 to u32)
    let debug_line_offset = align_up(debug_info_offset + debug_info_size, 8 to u32)
    let rela_debug_info_offset = align_up(debug_line_offset + debug_line_size, 8 to u32)
    let rela_debug_info_size = nrela_debug_info * ELF64_RELA_SIZE
    let rela_debug_line_offset = align_up(rela_debug_info_offset + rela_debug_info_size, 8 to u32)
    let rela_debug_line_size = nrela_debug_line * ELF64_RELA_SIZE
    let shoff = align_up(rela_debug_line_offset + rela_debug_line_size, 8 to u32)
    ElfLayout {
        text_offset = text_offset
        text_size = text_size
        rodata_offset = rodata_offset
        rodata_size = rodata_size
        drr_offset = drr_offset
        drr_size = drr_size
        symtab_offset = symtab_offset
        symtab_size = symtab_size
        strtab_offset = strtab_offset
        strtab_size = strtab_len
        shstrtab_offset = shstrtab_offset
        shstrtab_size = shstrtab_len
        rela_offset = rela_offset
        rela_size = rela_size
        rela_rodata_offset = rela_rodata_offset
        rela_rodata_size = rela_rodata_size
        nrela_rodata = nrela_rodata
        nsects = nsects
        shoff = shoff
        nsyms = nsyms
        nrela = nrela
        first_global = first_global
        debug_abbrev_offset = debug_abbrev_offset
        debug_abbrev_size = debug_abbrev_size
        debug_info_offset = debug_info_offset
        debug_info_size = debug_info_size
        debug_line_offset = debug_line_offset
        debug_line_size = debug_line_size
        rela_debug_info_offset = rela_debug_info_offset
        rela_debug_info_size = rela_debug_info_size
        rela_debug_line_offset = rela_debug_line_offset
        rela_debug_line_size = rela_debug_line_size
    }
}

/**
 * ELF_MAGIC — the `Elf64_Ehdr.e_ident` file-magic bytes (`\x7fELF`), identifying
 * the file as an ELF object to every ELF-aware tool (`ld`, `readelf`, the kernel
 * loader). A Tier-A aggregate const (#594 crumb 11), mirroring `GZIP_MAGIC`'s
 * pattern — read once into `emit_elf_header` by index.
 */
const ELF_MAGIC: []byte = [0x7F to byte, 0x45 to byte, 0x4C to byte, 0x46 to byte]

/**
 * emit_elf_header — the 64-byte `Elf64_Ehdr`: the `e_ident` magic (`\x7fELF` +
 * ELFCLASS64 + ELFDATA2LSB + EV_CURRENT + ELFOSABI_SYSV + 8 pad bytes), then
 * `e_type = ET_REL`(1), the supplied `e_machine` (EM_X86_64=62),
 * `e_version = 1`, zero `e_entry`/`e_phoff`, the computed `e_shoff`, the supplied
 * `e_flags` (0 for x86-64 — no machine flags defined),
 * `e_ehsize = 64`, zero program-header fields, `e_shentsize = 64`, `e_shnum =
 * nsects` (7, or 8 with `.rela.rodata`), and `e_shstrndx = 5` (`.shstrtab`). The
 * `e_machine`/`e_flags` are the ONLY ISA-varying bytes of the reused header
 * (§7.1).
 *
 * @param []byte buf  the (empty) buffer to extend
 * @param ElfLayout lay  the resolved layout (for `e_shoff`)
 * @param u32 e_machine  the ELF `e_machine` (62=x86-64)
 * @param u32 e_flags  the ELF `e_flags` (0=x86-64)
 * @param u32 nsects  the section-header count emitted as `e_shnum`
 * @return []byte  `buf` followed by the 64-byte Ehdr
 */
fn emit_elf_header(buf: []byte, lay: ElfLayout, e_machine: u32, e_flags: u32, nsects: u32) -> []byte {
    let magic = ELF_MAGIC
    mut b = teko::list::push(buf, magic[0])
    b = teko::list::push(b, magic[1])
    b = teko::list::push(b, magic[2])
    b = teko::list::push(b, magic[3])
    b = teko::list::push(b, 2 to byte)
    b = teko::list::push(b, 1 to byte)
    b = teko::list::push(b, 1 to byte)
    b = teko::list::push(b, 0 to byte)
    mut k: u32 = 0
    loop {
        if k >= (8 to u32) { break }
        b = teko::list::push(b, 0 to byte)
        k++
    }
    b = emit_u16_le_elf(b, 1 to u32)
    b = emit_u16_le_elf(b, e_machine)
    b = emit_u32_le(b, 1 to u32)
    b = emit_u64_le(b, 0 to u64)
    b = emit_u64_le(b, 0 to u64)
    b = emit_u64_le(b, lay.shoff to u64)
    b = emit_u32_le(b, e_flags)
    b = emit_u16_le_elf(b, 64 to u32)
    b = emit_u16_le_elf(b, 0 to u32)
    b = emit_u16_le_elf(b, 0 to u32)
    b = emit_u16_le_elf(b, 64 to u32)
    b = emit_u16_le_elf(b, nsects)
    emit_u16_le_elf(b, 5 to u32)
}

/**
 * emit_elf_shdr — one 64-byte `Elf64_Shdr`: `sh_name` (offset into `.shstrtab`),
 * `sh_type`, `sh_flags`, a zero `sh_addr` (relocatable), `sh_offset`, `sh_size`,
 * `sh_link`, `sh_info`, `sh_addralign`, and `sh_entsize`.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 name_off  the section name's `.shstrtab` offset
 * @param u32 sh_type  the section type
 * @param u32 sh_flags  the section flags
 * @param u32 sh_offset  the section data file offset
 * @param u32 sh_size  the section byte size
 * @param u32 sh_link  the linked section index (0 when none)
 * @param u32 sh_info  the section extra info (first-global / `.text` index)
 * @param u32 sh_addralign  the section alignment
 * @param u32 sh_entsize  the fixed entry size (0 for non-table sections)
 * @return []byte  `buf` followed by the 64-byte section header
 */
fn emit_elf_shdr(buf: []byte, name_off: u32, sh_type: u32, sh_flags: u32, sh_offset: u32, sh_size: u32, sh_link: u32, sh_info: u32, sh_addralign: u32, sh_entsize: u32) -> []byte {
    mut b = emit_u32_le(buf, name_off)
    b = emit_u32_le(b, sh_type)
    b = emit_u64_le(b, sh_flags to u64)
    b = emit_u64_le(b, 0 to u64)
    b = emit_u64_le(b, sh_offset to u64)
    b = emit_u64_le(b, sh_size to u64)
    b = emit_u32_le(b, sh_link)
    b = emit_u32_le(b, sh_info)
    b = emit_u64_le(b, sh_addralign to u64)
    emit_u64_le(b, sh_entsize to u64)
}

/**
 * SHF_WRITE — the `Elf64_Shdr.sh_flags` bit (bit 0, `0x1`) marking a section as
 * writable at load time. Not combined at any call site today; named alongside
 * `SHF_ALLOC`/`SHF_EXECINSTR` for a complete, spec-faithful family.
 */
const SHF_WRITE: u32 = 0x1

/**
 * SHF_ALLOC — the `Elf64_Shdr.sh_flags` bit (bit 1, `0x2`) marking a section as
 * occupying memory during process execution (set on `.text` and `.rodata`).
 */
const SHF_ALLOC: u32 = 0x2

/**
 * SHF_EXECINSTR — the `Elf64_Shdr.sh_flags` bit (bit 2, `0x4`) marking a
 * section as containing executable machine instructions (set on `.text`,
 * combined with `SHF_ALLOC`).
 *
 * A `flags` bitmask (rather than these plain `const`s) is the more faithful
 * spelling of this OR-of-independent-bits family, but the `flags`→integer wire
 * cast a byte-emitting call site needs (#594 crumb 11's checker addition,
 * `typer.tks` E8) has not yet shipped in a released seed — the project's
 * bootstrap-seed rule (`docs/design/const-module-level-plan.md` §8) requires a
 * checker feature to land in a released seed BEFORE the corpus may spell it.
 * A follow-on crumb converts this family to `flags ElfSectionFlags` once such a
 * seed exists; until then these stay plain named `const`s (the "mapeamento no
 * emit site" fallback), ORed directly at each call site.
 */
const SHF_EXECINSTR: u32 = 0x4

/**
 * SHF_INFO_LINK — the `Elf64_Shdr.sh_flags` bit (bit 6, `0x40`) marking a
 * section's `sh_info` as another section index rather than a plain count (set
 * on `.rela.text`, whose `sh_info` names `.text`).
 */
const SHF_INFO_LINK: u32 = 0x40

/**
 * SHT_PROGBITS — the `Elf64_Shdr.sh_type` for a section holding program-defined
 * bytes (`.text`, `.rodata`, `.data.rel.ro`).
 */
const SHT_PROGBITS: u32 = 1 to u32

/**
 * SHT_RELA — the `Elf64_Shdr.sh_type` for a relocation section carrying explicit
 * addends (`.rela.text`, `.rela.data.rel.ro`).
 */
const SHT_RELA: u32 = 4 to u32

/**
 * ELF_SHNDX_SYMTAB — the fixed section-header-table index of `.symtab`, the
 * `sh_link` every `.rela.*` header names so the linker knows which symbol table
 * its `r_info` indices address.
 */
const ELF_SHNDX_SYMTAB: u32 = 3 to u32

/**
 * emit_elf_shdrs — the seven fixed section headers in table order: the null
 * header, then `.text` (PROGBITS, ALLOC|EXECINSTR, align 16), `.rodata`
 * (PROGBITS, ALLOC, align 8), `.symtab` (SYMTAB, `sh_link` → `.strtab`(4),
 * `sh_info` = first-global, entsize 24), `.strtab` (STRTAB), `.shstrtab`
 * (STRTAB), `.rela.text` (RELA, INFO_LINK, `sh_link` → `.symtab`(3), `sh_info` →
 * `.text`(1), entsize 24) — plus, when the module carries a pointer-bearing
 * const, the appended `.data.rel.ro` (PROGBITS, ALLOC|WRITE, align 8) and
 * `.rela.data.rel.ro` (RELA, INFO_LINK, `sh_link` → `.symtab`(3), `sh_info` →
 * `.data.rel.ro`) headers — plus, when DWARF is present (D1.4), the five headers
 * `emit_elf_dwarf_shdrs` appends, ALWAYS last (their table index is `7` without
 * `.data.rel.ro`, `9` with it). An off-by-one in any link/info index makes `ld`
 * reject the object.
 *
 * @param []byte buf  the buffer to extend
 * @param ElfLayout lay  the resolved layout
 * @param []u32 shname  the `sh_name` offsets, in header order
 * @param bool has_drr  whether `.data.rel.ro`/`.rela.data.rel.ro` are present
 * @param bool has_dwarf  whether the DWARF sections (D1.4) are present
 * @return []byte  `buf` followed by the section headers
 */
fn emit_elf_shdrs(buf: []byte, lay: ElfLayout, shname: []u32, has_drr: bool, has_dwarf: bool) -> []byte {
    mut b = emit_elf_shdr(buf, shname[0], 0 to u32, 0 to u32, 0 to u32, 0 to u32, 0 to u32, 0 to u32, 0 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[1], 1 to u32, SHF_ALLOC | SHF_EXECINSTR, lay.text_offset, lay.text_size, 0 to u32, 0 to u32, 16 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[2], 1 to u32, SHF_ALLOC, lay.rodata_offset, lay.rodata_size, 0 to u32, 0 to u32, 8 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[3], 2 to u32, 0 to u32, lay.symtab_offset, lay.symtab_size, 4 to u32, lay.first_global, 8 to u32, ELF64_SYM_SIZE)
    b = emit_elf_shdr(b, shname[4], 3 to u32, 0 to u32, lay.strtab_offset, lay.strtab_size, 0 to u32, 0 to u32, 1 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[5], 3 to u32, 0 to u32, lay.shstrtab_offset, lay.shstrtab_size, 0 to u32, 0 to u32, 1 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[6], 4 to u32, SHF_INFO_LINK, lay.rela_offset, lay.rela_size, 3 to u32, 1 to u32, 8 to u32, ELF64_RELA_SIZE)
    mut next: u64 = 7
    if has_drr {
        b = emit_elf_shdr(b, shname[7], SHT_PROGBITS, SHF_ALLOC | SHF_WRITE, lay.drr_offset, lay.drr_size, 0 to u32, 0 to u32, 8 to u32, 0 to u32)
        b = emit_elf_shdr(b, shname[8], SHT_RELA, SHF_INFO_LINK, lay.rela_rodata_offset, lay.rela_rodata_size, ELF_SHNDX_SYMTAB, ELF_SHNDX_DATA_REL_RO, 8 to u32, ELF64_RELA_SIZE)
        next = 9
    }
    if has_dwarf { return emit_elf_dwarf_shdrs(b, lay, shname, next) }
    b
}

/**
 * emit_elf_dwarf_shdrs — append the five DWARF section headers (D1.4): `.debug_abbrev`,
 * `.debug_info`, `.debug_line` (SHT_PROGBITS, UNALLOCATED — no `SHF_ALLOC`, so none enters the
 * execution image, matching the design's non-negotiable), each `sh_addralign = 1` (DWARF imposes
 * no alignment), then `.rela.debug_info`/`.rela.debug_line` (SHT_RELA, INFO_LINK, `sh_link` →
 * `.symtab`, `sh_info` naming the section each patches). `base` is the section-header-table index
 * `.debug_abbrev` lands at — `7` without `.data.rel.ro`, `9` with it — resolved by the caller.
 *
 * @param []byte buf  the buffer to extend
 * @param ElfLayout lay  the resolved layout
 * @param []u32 shname  the `sh_name` offsets, in header order
 * @param u64 base  the section-header-table index of `.debug_abbrev`
 * @return []byte  `buf` followed by the five DWARF section headers
 * @since 0.3.1.0
 */
fn emit_elf_dwarf_shdrs(buf: []byte, lay: ElfLayout, shname: []u32, base: u64) -> []byte {
    let info_idx = base + 1
    let line_idx = base + 2
    mut b = emit_elf_shdr(buf, shname[base], SHT_PROGBITS, 0 to u32, lay.debug_abbrev_offset, lay.debug_abbrev_size, 0 to u32, 0 to u32, 1 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[info_idx], SHT_PROGBITS, 0 to u32, lay.debug_info_offset, lay.debug_info_size, 0 to u32, 0 to u32, 1 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[line_idx], SHT_PROGBITS, 0 to u32, lay.debug_line_offset, lay.debug_line_size, 0 to u32, 0 to u32, 1 to u32, 0 to u32)
    b = emit_elf_shdr(b, shname[base + 3], SHT_RELA, SHF_INFO_LINK, lay.rela_debug_info_offset, lay.rela_debug_info_size, ELF_SHNDX_SYMTAB, info_idx to u32, 8 to u32, ELF64_RELA_SIZE)
    emit_elf_shdr(b, shname[base + 4], SHT_RELA, SHF_INFO_LINK, lay.rela_debug_line_offset, lay.rela_debug_line_size, ELF_SHNDX_SYMTAB, line_idx to u32, 8 to u32, ELF64_RELA_SIZE)
}

/**
 * emit_elf_one_sym — one 24-byte `Elf64_Sym`: `st_name` (`.strtab` offset),
 * `st_info`, a zero `st_other`, `st_shndx`, `st_value` (section-relative for a
 * defined function), and a zero `st_size` (unset in the MVP).
 *
 * @param []byte buf  the buffer to extend
 * @param ElfSym sym  the resolved symbol
 * @param u32 name_off  the symbol name's `.strtab` offset
 * @return []byte  `buf` followed by the 24-byte symbol entry
 */
fn emit_elf_one_sym(buf: []byte, sym: ElfSym, name_off: u32) -> []byte {
    mut b = emit_u32_le(buf, name_off)
    b = emit_u8_field(b, sym.info)
    b = emit_u8_field(b, 0 to u32)
    b = emit_u16_le_elf(b, sym.shndx)
    b = emit_u64_le(b, sym.value to u64)
    emit_u64_le(b, 0 to u64)
}

/**
 * emit_elf_symtab — the `Elf64_Sym` table: one entry per resolved symbol, in
 * local-then-global order, each carrying its `.strtab` name offset and its
 * section-relative value.
 *
 * @param []byte buf  the buffer to extend
 * @param []ElfSym syms  the resolved symbol table
 * @param ElfStrtab strtab  the string table (for the per-symbol name offsets)
 * @return []byte  `buf` followed by the symbol-table entries
 */
fn emit_elf_symtab(buf: []byte, syms: []ElfSym, strtab: ElfStrtab) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= syms.len { break }
        b = emit_elf_one_sym(b, syms[i], strtab.strx[i])
        i++
    }
    b
}

/**
 * emit_elf_relas — the `.rela.text` table: one 24-byte `Elf64_Rela` per
 * relocation — the `.text`-relative `r_offset`, the packed
 * `r_info = (symbol_index << 32) | type`, and the signed `r_addend` (emitted as
 * a two's-complement 8-byte little-endian field, so a negative `-4` never
 * reaches a panicking `to u64` cast).
 *
 * @param []byte buf  the buffer to extend
 * @param []ElfRela relas  the resolved relocation rows
 * @return []byte  `buf` followed by the relocation entries
 */
fn emit_elf_relas(buf: []byte, relas: []ElfRela) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= relas.len { break }
        let r = relas[i]
        b = emit_u64_le(b, r.offset to u64)
        b = emit_u64_le(b, elf_rela_info(r.symidx, r.rtype))
        b = push_imm64_x86(b, r.addend)
        i++
    }
    b
}

/**
 * ElfRelocReq — one ALREADY-RESOLVED relocation the neutral ELF writer turns into
 * an `Elf64_Rela`: the `.text`-relative field offset (`r_offset`), the target
 * symbol NAME (resolved to an index by the writer), the NUMERIC `R_<arch>_*` type
 * (each per-ISA encoder maps its own `RelocKind*` → the number, so the writer
 * holds no ISA knowledge), and the addend. This is the ISA-agnostic form of
 * `RelocX86` — the per-ISA reloc's `kind` is already lowered to `rtype`.
 *
 * @since #387 B2-7
 */
pub type ElfRelocReq = struct {
    /**
     * offset — the patched field's byte offset of the relocated field, relative to the base of the section the relocation patches: `.text`-base-relative in `ElfObject.relocs`, `.rodata`-base-relative in `ElfObject.rodata_relocs` (#594 T-B2) — historically always `.text`.
     */
    offset: u32
    /**
     * sym — the target symbol's final name (a function, an extern, a `.rodata`
     * datum, or a `.text` pcrel label).
     */
    sym: str
    /**
     * rtype — the numeric `R_<arch>_*` relocation type (per-ISA-mapped).
     */
    rtype: u32
    /**
     * addend — the `r_addend`; a rodata target folds its `.rodata` offset onto
     * this base.
     */
    addend: i64
}

/**
 * ElfObject — the ISA-agnostic input to the shared ELF64 writer: the machine id
 * (`e_machine`: EM_X86_64=62), the ABI flags (`e_flags`: 0 for x86-64), the
 * `.text`/`.rodata` section images, the neutral `Symbol` list
 * (local-then-global-then-undefined, now INCLUDING per-pcrel-pair `.text` label
 * locals — §7.2), and the resolved `ElfRelocReq` rows. `emit_elf` (x86) builds
 * this and calls `emit_elf_object`; the writer is ISA-agnostic, so E1 (the ELF
 * static linker) reuses it unchanged.
 *
 * @since #387 B2-7
 */
pub type ElfObject = struct {
    /**
     * e_machine — the ELF `e_machine` (62=x86-64).
     */
    e_machine: u32
    /**
     * e_flags — the ELF `e_flags` (0=x86-64).
     */
    e_flags: u32
    /**
     * text — the `.text` section image.
     */
    text: []byte
    /**
     * rodata — the `.rodata` section image.
     */
    rodata: []byte
    /**
     * symbols — the neutral symbol list (locals incl. `.text` pcrel labels, then
     * globals, then undefined).
     */
    symbols: []Symbol
    /**
     * relocs — the resolved relocation requests, `.text`-relative, in emission
     * order.
     */
    relocs: []ElfRelocReq
    /**
     * rodata_relocs — the relocations whose PATCH SITE lies INSIDE `.rodata` (a
     * Tier-B const's data→data pointer; #594 T-B2), separated from the `.text`-
     * relative `relocs` because each one's `offset` is `.rodata`-base-relative,
     * not `.text`-base-relative. EMPTY in every real compile today (T-B1's
     * `encode_rodata` honest-stop keeps every producer out), which keeps the
     * object byte-identical and every golden intact; the per-ISA bridge populates
     * it (partitioning the `Reloc*` by `RelocSect`) only once the T-B chain opens.
     * Each entry resolves to one `.rela.rodata` row (R_X86_64_64
     * against the `.rodata` section symbol, the target's offset folded onto the
     * addend).
     */
    rodata_relocs: []ElfRelocReq
    /**
     * dwarf — the DWARF sections to sink (D1.4), already lowered to the ISA-agnostic
     * `ElfDwarfSections` shape by the per-ISA adapter (`elf_dwarf_of`). `dwarf.present == false`
     * (`no_elf_dwarf()`) places nothing, keeping the object byte-identical to a build with no
     * debug axis.
     * @since 0.3.1.0
     */
    dwarf: ElfDwarfSections
}

/**
 * ElfDwarfSections — the ISA-AGNOSTIC form of a `DwarfSink` (D1.3's producer output) `ElfObject`
 * carries: every `DwReloc` already lowered to an `ElfRelocReq` under the target's absolute-64
 * relocation type (`R_X86_64_64` or `R_AARCH64_ABS64` — the ONLY ISA knowledge `elf_dwarf_of`
 * injects, mirroring `x86_reloc_reqs`/`arm64_reloc_reqs`). `present = false` is the
 * `DebugInfo::None` default: `emit_elf_object` places nothing when it sees it.
 *
 * @since 0.3.1.0
 */
pub type ElfDwarfSections = struct {
    /** true iff the three fields below carry real content to place. */
    present: bool
    /** the `.debug_abbrev` section bytes (valid iff `present`; never relocated). */
    abbrev: []byte
    /** the `.debug_info` section bytes (valid iff `present`). */
    info_bytes: []byte
    /** the `.debug_info` section's relocations, already `ElfRelocReq`-typed. */
    info_relocs: []ElfRelocReq
    /** the `.debug_line` section bytes (valid iff `present`). */
    line_bytes: []byte
    /** the `.debug_line` section's relocations, already `ElfRelocReq`-typed (at most one). */
    line_relocs: []ElfRelocReq
}

/**
 * no_elf_dwarf — the absent `ElfDwarfSections` (`present = false`), the `DebugInfo::None` default
 * every `ElfObject` construction site not requesting DWARF supplies.
 *
 * @return  the absent sections
 * @since 0.3.1.0
 */
fn no_elf_dwarf() -> ElfDwarfSections {
    ElfDwarfSections { present = false; abbrev = teko::list::empty(); info_bytes = teko::list::empty(); info_relocs = teko::list::empty(); line_bytes = teko::list::empty(); line_relocs = teko::list::empty() }
}

/**
 * elf_dwreloc_reqs — lower every `DwReloc` of `relocs` to an `ElfRelocReq` under the numeric
 * absolute-64 relocation type `rtype`: the offset narrows to `u32` (every DWARF section is well
 * under 4 GiB) and the addend is always 0 (a DWARF low_pc/set_address slot targets a symbol's base,
 * never an offset into it).
 *
 * @param []DwReloc relocs  the producer's relocations (`.text`-symbol-targeted)
 * @param u32 rtype  the target ISA's absolute-64 relocation type
 * @return []ElfRelocReq  the lowered relocation requests, in the same order
 * @since 0.3.1.0
 */
fn elf_dwreloc_reqs(relocs: []DwReloc, rtype: u32) -> []ElfRelocReq {
    mut out: []ElfRelocReq = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= relocs.len { break }
        let r = relocs[i]
        out = teko::list::push(out, ElfRelocReq { offset = r.offset to u32; sym = r.symbol; rtype = rtype; addend = 0 })
        i++
    }
    out
}

/**
 * elf_dwarf_of — lower a `DwarfSink` (D1.3's producer output) into the ISA-agnostic
 * `ElfDwarfSections` `emit_elf_object` consumes, under the caller-supplied absolute-64 relocation
 * type. `present = false` (the `DebugInfo::None` default) maps straight through to `no_elf_dwarf()`,
 * so the object writer places nothing — the D1.4 sink's only entry point from the per-ISA adapters.
 *
 * @param DwarfSink sink  the producer output (`present` gates everything else)
 * @param u32 abs64_rtype  the target ISA's absolute-64 relocation type
 * @return ElfDwarfSections  the ISA-agnostic sections `ElfObject.dwarf` carries
 * @since 0.3.1.0
 */
fn elf_dwarf_of(sink: DwarfSink, abs64_rtype: u32) -> ElfDwarfSections {
    if !sink.present { return no_elf_dwarf() }
    ElfDwarfSections {
        present = true
        abbrev = sink.abbrev
        info_bytes = sink.info.bytes
        info_relocs = elf_dwreloc_reqs(sink.info.relocs, abs64_rtype)
        line_bytes = sink.line.bytes
        line_relocs = elf_dwreloc_reqs(sink.line.relocs, abs64_rtype)
    }
}

/**
 * ElfConstEntry — one `.rodata` datum's byte span in the ORIGINAL concatenated
 * `.rodata` image, plus where it lands after the data-rel-ro partition: whether
 * it moves to `.data.rel.ro` and its new byte offset within its post-partition
 * section. Derived from the module's section-2 local symbols (one per datum, in
 * ascending-offset emission order).
 *
 * @since 0.3.1
 */
type ElfConstEntry = struct {
    /**
     * name — the datum's file-local symbol name (the reloc-target key).
     */
    name: str
    /**
     * start — the datum's byte offset in the ORIGINAL `.rodata` image.
     */
    start: u32
    /**
     * end — one past the datum's last byte in the ORIGINAL image (the next
     * datum's start, or the image length for the last datum): the span INCLUDES
     * any inter-datum alignment padding, which rides along harmlessly.
     */
    end: u32
    /**
     * to_drr — true iff a pointer relocation patches inside this datum, so it
     * moves to `.data.rel.ro`; false leaves it in read-only `.rodata`.
     */
    to_drr: bool
    /**
     * new_offset — the datum's 8-aligned byte offset within its POST-partition
     * section (`.data.rel.ro` when `to_drr`, else the rebuilt `.rodata`).
     */
    new_offset: u32
}

/**
 * ElfDrrPartition — the result of splitting the `.rodata` image by
 * relocation-presence: the rebuilt pure `.rodata` bytes, the moved
 * `.data.rel.ro` bytes, the neutral symbol list with each const datum's offset
 * and section re-stamped, and the moved relocations rebased to `.data.rel.ro`.
 * `active` is false (and the four passthrough fields hold the originals) when the
 * module carries no pointer-bearing const, so the writer's output stays
 * byte-identical to the pre-partition path.
 *
 * @since 0.3.1
 */
type ElfDrrPartition = struct {
    /**
     * active — true iff at least one const datum moved to `.data.rel.ro`.
     */
    active: bool
    /**
     * rodata — the pure `.rodata` bytes (originals when `!active`).
     */
    rodata: []byte
    /**
     * drr — the `.data.rel.ro` bytes (empty when `!active`).
     */
    drr: []byte
    /**
     * symbols — the neutral symbols with const-datum offsets/sections re-stamped
     * (the originals when `!active`).
     */
    symbols: []Symbol
    /**
     * drr_relocs — the moved relocations, their `offset` rebased to be
     * `.data.rel.ro`-relative (empty when `!active`).
     */
    drr_relocs: []ElfRelocReq
}

/**
 * elf_collect_const_entries — the module's `.rodata` data, one `ElfConstEntry`
 * per defined section-`ELF_SECT_RODATA` local symbol, in ascending-offset
 * emission order, each datum's span running from its own offset to the next
 * datum's offset (the last runs to `rodata_len`). `encode_rodata` emits these
 * symbols in ascending order, so the spans tile `[0, rodata_len)` exactly.
 *
 * @param []Symbol symbols  the module's neutral symbol list
 * @param u32 rodata_len  the original `.rodata` image length (the last span end)
 * @return []ElfConstEntry  the const data spans, in emission order
 */
fn elf_collect_const_entries(symbols: []Symbol, rodata_len: u32) -> []ElfConstEntry {
    mut starts: []ElfConstEntry = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= symbols.len { break }
        let s = symbols[i]
        if s.defined && s.local && s.sect == ELF_SECT_RODATA {
            starts = teko::list::push(starts, ElfConstEntry { name = s.name; start = s.offset; end = 0 to u32; to_drr = false; new_offset = 0 to u32 })
        }
        i++
    }
    mut out: []ElfConstEntry = teko::list::empty()
    mut j: u64 = 0
    loop {
        if j >= starts.len { break }
        let e = starts[j]
        let end = if j + 1 < starts.len { starts[j + 1].start } else { rodata_len }
        out = teko::list::push(out, ElfConstEntry { name = e.name; start = e.start; end = end; to_drr = false; new_offset = 0 to u32 })
        j++
    }
    out
}

/**
 * elf_reloc_in_span — whether any relocation in `relocs` patches a field whose
 * offset falls in the half-open byte span `[start, end)` (the datum owns it).
 *
 * @param []ElfRelocReq relocs  the `.rodata`-relative relocation requests
 * @param u32 start  the span's inclusive start byte offset
 * @param u32 end  the span's exclusive end byte offset
 * @return bool  true iff at least one relocation site lies within the span
 */
fn elf_reloc_in_span(relocs: []ElfRelocReq, start: u32, end: u32) -> bool {
    mut i: u64 = 0
    loop {
        if i >= relocs.len { break }
        let o = relocs[i].offset
        if o >= start && o < end { return true }
        i++
    }
    false
}

/**
 * elf_assign_partition_offsets — mark each entry that owns a relocation site as
 * `to_drr` and assign every entry its 8-aligned byte offset within its
 * post-partition section (`.data.rel.ro` for a moved datum, the rebuilt
 * `.rodata` otherwise). Two running cursors (one per section) advance in
 * emission order, so both blobs keep the datum order the neutral encoder chose,
 * and every datum starts 8-aligned (pointer slots stay aligned).
 *
 * @param []ElfConstEntry entries  the collected const spans
 * @param []ElfRelocReq rodata_relocs  the `.rodata`-relative relocations
 * @return []ElfConstEntry  the entries with `to_drr` and `new_offset` filled
 */
fn elf_assign_partition_offsets(entries: []ElfConstEntry, rodata_relocs: []ElfRelocReq) -> []ElfConstEntry {
    mut out: []ElfConstEntry = teko::list::empty()
    mut rodata_run: u32 = 0 to u32
    mut drr_run: u32 = 0 to u32
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let e = entries[i]
        let moves = elf_reloc_in_span(rodata_relocs, e.start, e.end)
        let span = e.end - e.start
        let base = if moves { align_up(drr_run, 8 to u32) } else { align_up(rodata_run, 8 to u32) }
        if moves { drr_run = base + span } else { rodata_run = base + span }
        out = teko::list::push(out, ElfConstEntry { name = e.name; start = e.start; end = e.end; to_drr = moves; new_offset = base })
        i++
    }
    out
}

/**
 * elf_pad_blob_to — append zero bytes to `buf` until its length reaches
 * `target` (the datum's 8-aligned `new_offset`), so each copied datum lands at
 * exactly the offset `elf_assign_partition_offsets` reserved for it. A no-op when
 * `buf` is already at `target`.
 *
 * @param []byte buf  the blob being rebuilt
 * @param u32 target  the length to pad up to
 * @return []byte  `buf` padded with zeros to `target` bytes
 */
fn elf_pad_blob_to(buf: []byte, target: u32) -> []byte {
    mut b = buf
    loop {
        if (b.len to u32) >= target { break }
        b = teko::list::push(b, 0 to byte)
    }
    b
}

/**
 * elf_append_byte_range — append `src[start..end)` (the datum's original bytes,
 * padding included) to `buf`.
 *
 * @param []byte buf  the blob being rebuilt
 * @param []byte src  the original `.rodata` image
 * @param u32 start  the datum's inclusive start offset in `src`
 * @param u32 end  the datum's exclusive end offset in `src`
 * @return []byte  `buf` followed by `src[start..end)`
 */
fn elf_append_byte_range(buf: []byte, src: []byte, start: u32, end: u32) -> []byte {
    mut b = buf
    mut i: u64 = start to u64
    loop {
        if i >= end { break }
        b = teko::list::push(b, src[i])
        i++
    }
    b
}

/**
 * elf_build_partition_blob — rebuild one post-partition section's bytes by
 * copying, in emission order, every entry bound for that section (`to_drr ==
 * want_drr`) to its reserved `new_offset`, padding the gap between entries with
 * zeros.
 *
 * @param []ElfConstEntry entries  the entries with offsets assigned
 * @param []byte rodata  the original `.rodata` image
 * @param bool want_drr  select `.data.rel.ro` entries (true) or `.rodata` (false)
 * @return []byte  the rebuilt section image
 */
fn elf_build_partition_blob(entries: []ElfConstEntry, rodata: []byte, want_drr: bool) -> []byte {
    mut b: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let e = entries[i]
        if e.to_drr == want_drr {
            b = elf_pad_blob_to(b, e.new_offset)
            b = elf_append_byte_range(b, rodata, e.start, e.end)
        }
        i++
    }
    b
}

/**
 * elf_remap_partition_symbols — re-stamp every const-datum symbol with its
 * post-partition offset and section tag (`ELF_SECT_DATA_REL_RO` when it moved,
 * `ELF_SECT_RODATA` otherwise), leaving every non-rodata symbol untouched. Walks
 * the symbols and the entries in lockstep: the k-th section-`ELF_SECT_RODATA`
 * local is `entries[k]` (both lists are in the same emission order), so no
 * name lookup is needed.
 *
 * @param []Symbol symbols  the module's neutral symbol list
 * @param []ElfConstEntry entries  the entries with offsets/sections assigned
 * @return []Symbol  the re-stamped symbol list, in the same order
 */
