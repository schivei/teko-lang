fn encode_neg_x86(i: MNegX86) -> EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86(teko::list::empty(), i.wide, X86_OP_GRP3_F7, X86_EXT_NEG, i.dst))
}

/**
 * encode_not_x86 — a two-address complement (`not r/m64`, `F7 /2`).
 *
 * @param MNotX86 i  the complement instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_not_x86(i: MNotX86) -> EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86(teko::list::empty(), i.wide, X86_OP_GRP3_F7, X86_EXT_NOT, i.dst))
}

/**
 * encode_load_x86 — a memory load (`mov`/`movsx`/`movsd`/`movss dst,
 * [base+disp]`) per `load_memop_x86`'s size/sign descriptor, addressing `mem`
 * (SIB `0x24` when the base is RSP/R12, forced disp8 when RBP/R13). An
 * FPR-class destination (`F32`/`F64` size) is a scalar SSE move (`B1-fp`).
 *
 * @param MLoadX86 i  the load instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_load_x86(i: MLoadX86) -> EncInstX86 {
    emit_mem_op_x86(load_memop_x86(i.size, i.sign), i.dst, i.mem)
}

/**
 * encode_store_x86 — a memory store (`mov`/`movsd`/`movss [base+disp], src`)
 * per `store_memop_x86`'s size descriptor, addressing `mem`. An FPR-class
 * source (`F32`/`F64` size) is a scalar SSE move (`B1-fp`).
 *
 * @param MStoreX86 i  the store instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_store_x86(i: MStoreX86) -> EncInstX86 {
    emit_mem_op_x86(store_memop_x86(i.size), i.src, i.mem)
}

/**
 * RSP_BASE_X86 — the physical RSP register as a memory-operand base, the one
 * base every frame-relative access in this file addresses through (frame slots,
 * the callee-saved XMM saves, and both halves of the stack-argument area). A
 * flat-POD `MReg` aggregate const (#594 crumb 9b).
 */
const RSP_BASE_X86: MReg = preg(X86_REG_RSP_ID, MRegClass::GPR)

/**
 * in_arg_base_x86 — the RSP-relative byte offset of the FIRST incoming
 * stack-argument slot (`B1-args`). The caller placed stack argument `j` at
 * `entry_rsp + 8 + caller_shadow + 8*j` (past the return address `call` pushed and
 * past the shadow area it reserved at its own RSP), and the prologue has since
 * moved RSP down by `push rbp` (8) + one push per callee-saved GPR + the
 * `sub rsp` region — so a FRAMED function reads it at
 * `16 + 8*n_saved + size + caller_shadow + 8*j` and a frameless one at
 * `8 + caller_shadow + 8*j`. Resolved here rather than at isel because only the
 * finished layout knows those numbers.
 *
 * THE `caller_shadow` TERM IS THE MIRROR OF `out_arg_base`, and its absence was a
 * measured Win64 defect: the caller stores stack argument 0 at `rsp + 32`
 * (`encode_out_arg_x86` through `out_arg_base`) while the callee read the same
 * argument 32 bytes lower, inside the home space instead of the argument. SysV
 * keeps `shadow_space` 0, so every SysV offset here is byte-identical.
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @return u32  the RSP-relative offset of incoming stack-argument slot 0
 */
fn in_arg_base_x86(layout: FrameLayoutX86) -> u32 {
    if !frame_is_framed_x86(layout) { return X86_GPR_BYTES + layout.caller_shadow }
    let n_saved = layout.saved_gpr.len to u32
    (2 to u32) * X86_GPR_BYTES + (n_saved * X86_GPR_BYTES) + layout.size + layout.caller_shadow
}

/**
 * encode_fspill_x86 — resolve `MFSpillX86{reg, slot, is_load}` to
 * `movsd [rsp + slot_offsets[slot]], xmm` (or the load direction), the scalar SSE
 * memory move at the 8-byte width, reusing `store_memop_x86`/`load_memop_x86`
 * so an FPR spill is encoded by exactly the code every other float memory access
 * goes through (`B1-fp`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MFSpillX86 i  the spill store or reload (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_fspill_x86(layout: FrameLayoutX86, i: MFSpillX86) -> EncInstX86 {
    let mem = MMem { base = RSP_BASE_X86; offset = layout.slot_offsets[i.slot] to i32 }
    let form = if i.is_load { load_memop_x86(MMemSizeX86::F64, false) } else { store_memop_x86(MMemSizeX86::F64) }
    emit_mem_op_x86(form, i.reg, mem)
}

/**
 * encode_out_arg_x86 — resolve `MOutArgX86{size, src, index}` to
 * `mov [rsp + out_arg_base + 8*index], src` at the argument's own transfer width
 * (an SSE `movsd`/`movss` for a float argument), reusing `store_memop_x86` so a
 * stack argument is encoded by exactly the code every other store goes through
 * (`B1-args`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MOutArgX86 i  the outgoing stack-argument store (source physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_out_arg_x86(layout: FrameLayoutX86, i: MOutArgX86) -> EncInstX86 {
    let off = layout.out_arg_base + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(store_memop_x86(i.size), i.src, MMem { base = RSP_BASE_X86; offset = off to i32 })
}

/**
 * encode_in_arg_x86 — resolve `MInArgX86{size, dst, index}` to
 * `mov dst, [rsp + in_arg_base + 8*index]` at the parameter's own transfer width,
 * reusing `load_memop_x86`'s zero-extending descriptor (`sign = false`, matching
 * every other load this backend emits) (`B1-args`).
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MInArgX86 i  the incoming stack-parameter load (destination physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_in_arg_x86(layout: FrameLayoutX86, i: MInArgX86) -> EncInstX86 {
    let off = in_arg_base_x86(layout) + (i.index * X86_GPR_BYTES)
    emit_mem_op_x86(load_memop_x86(i.size, false), i.dst, MMem { base = RSP_BASE_X86; offset = off to i32 })
}

/**
 * encode_frame_addr_x86 — resolve `MFrameAddrX86{dst, slot}` to
 * `lea dst, [rsp + slot_offsets[slot]]` (`REX.W 8D /r`). The RSP base (id 4)
 * forces a SIB byte `0x24` (emitted by `push_mem_operand_x86`), the single most
 * common x86 encoding mistake; frame addresses are always 64-bit.
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame
 * @param MFrameAddrX86 i  the frame-slot address instruction (destination physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_frame_addr_x86(layout: FrameLayoutX86, i: MFrameAddrX86) -> EncInstX86 {
    let off = layout.slot_offsets[i.slot]
    let mem = MMem { base = RSP_BASE_X86; offset = off to i32 }
    mut b = push_rex_x86(teko::list::empty(), true, reg_ext_x86(i.dst), false, reg_ext_x86(mem.base))
    b = push_byte_x86(b, X86_OP_LEA)
    plain_inst_x86(push_mem_operand_x86(b, reg_low3_x86(i.dst), mem))
}

/**
 * encode_lea_rip_x86 — a rip-relative address load (`lea dst, [rip+disp32]`,
 * `REX.W 8D /r` with `mod=00 rm=101`): the disp32 is a zeroed placeholder the
 * B1-7 ELF writer relocates (`R_X86_64_PC32`/`PLT32`), collapsing arm64's
 * ADRP+ADD pair into one instruction + one relocation (§4.3).
 *
 * @param MLeaRipX86 i  the address-materialization instruction (operand physical)
 * @return EncInstX86  the reloc-flagged placeholder instruction
 */
fn encode_lea_rip_x86(i: MLeaRipX86) -> EncInstX86 {
    mut b = push_rex_forced_x86(teko::list::empty(), true, reg_ext_x86(i.dst), false, false)
    b = push_byte_x86(b, X86_OP_LEA)
    b = push_byte_x86(b, modrm_x86(MODRM_MOD_INDIRECT, reg_low3_x86(i.dst), MODRM_RM_RIP_RELATIVE))
    let field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, i.kind)
}

/**
 * encode_jmp_x86 — an unconditional branch (`jmp rel32`, `E9 cd`): the rel32 is
 * a zeroed placeholder the B1-6 layout pass patches with the block displacement.
 *
 * @param MJmpX86 i  the unconditional-branch instruction
 * @return EncInstX86  the branch-flagged placeholder instruction
 */
fn encode_jmp_x86(i: MJmpX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_JMP_REL32)
    let field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

/**
 * encode_jcc_x86 — a conditional branch (`jcc rel32`, `0F 80+cc cd`): the rel32
 * is a zeroed placeholder the B1-6 layout pass patches; the condition byte is
 * position-independent.
 *
 * @param MJccX86 i  the conditional-branch instruction
 * @return EncInstX86  the branch-flagged placeholder instruction
 */
fn encode_jcc_x86(i: MJccX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_JCC_BASE + cond_cc_x86(i.cond))
    let field_off = b.len to u32
    branch_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.target)
}

/**
 * encode_call_x86 — a direct call (`call rel32`, `E8 cd`): the rel32 is a
 * zeroed placeholder, flagged for a `Plt32` (`R_X86_64_PLT32`) relocation on
 * the callee symbol (addend −4 supplied by the B1-7 writer).
 *
 * @param MCallX86 i  the direct-call instruction
 * @return EncInstX86  the reloc-flagged placeholder instruction
 */
fn encode_call_x86(i: MCallX86) -> EncInstX86 {
    mut b = push_byte_x86(teko::list::empty(), X86_OP_CALL_REL32)
    let field_off = b.len to u32
    reloc_inst_x86(emit_u32_le(b, 0 to u32), field_off, i.sym, RelocKindX86::Plt32)
}

/**
 * encode_call_ind_x86 — an indirect call through a register (`call r/m64`,
 * `FF /2`): a position-independent instruction (no relocation, no displacement).
 *
 * @param MCallIndX86 i  the indirect-call instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_call_ind_x86(i: MCallIndX86) -> EncInstX86 {
    mut b = push_rex_x86(teko::list::empty(), false, false, false, reg_ext_x86(i.target))
    b = push_byte_x86(b, X86_OP_GRP5_FF)
    plain_inst_x86(push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, X86_EXT_CALL_IND, reg_low3_x86(i.target))))
}

/**
 * encode_ret_x86 — a return terminator (`ret`, `C3`). The B1-6 frame slice
 * prepends the epilogue; the B1-5 core emits only the bare `ret` byte (the
 * arm64 A4-1 `encode_ret` precedent).
 *
 * @return EncInstX86  the `ret` instruction
 */
fn encode_ret_x86() -> EncInstX86 {
    plain_inst_x86(push_byte_x86(teko::list::empty(), X86_OP_RET))
}

/**
 * encode_inst_x86 — encode one fully-physical `MInstX86` to its `EncInstX86`, a
 * TOTAL per-case match over the 24-case variant mirroring `print_minst_x86`'s
 * dispatch and arm64's `encode_inst_word`. The position-independent integer/
 * memory/float subset encodes fully (the `B1-fp` SSE family closed
 * 2026-07-29); `MJmpX86`/`MJccX86` and `MCallX86`/`MLeaRipX86` return
 * placeholder bytes flagged for the B1-6 rel32 patch / B1-7 relocation;
 * `MFrameAddrX86` resolves through `layout` to the real `lea dst, [rsp+off]`
 * (SIB-forced). The x86 forms are natively wide (imm32 / movabs imm64 /
 * disp32), so `B1-bigimm`/`B1-memindex` are unreachable in this core — the
 * declared `| error` is for the shared union shape every caller propagates
 * through (`emit_one_x86`), not a case this function itself still raises.
 *
 * @param FrameLayoutX86 layout  the enclosing function's resolved frame (for `MFrameAddrX86`)
 * @param MInstX86 inst  the instruction to encode (all operands physical)
 * @return EncInstX86 | error  the encoding (never actually an error today)
 */
pub fn encode_inst_x86(layout: FrameLayoutX86, inst: MInstX86) -> EncInstX86 | error {
    match inst {
        MMovImmX86 as x => encode_movimm_x86(x)
        MMovX86 as x => encode_mov_x86(x)
        MAluRmX86 as x => encode_alu_rm_x86(x)
        MImulX86 as x => encode_imul_x86(x)
        MDivSeqX86 as x => encode_divseq_x86(x)
        MShiftX86 as x => encode_shift_x86(x)
        MCmpX86 as x => encode_cmp_x86(x)
        MSetccX86 as x => encode_setcc_x86(x)
        MJccX86 as x => encode_jcc_x86(x)
        MNegX86 as x => encode_neg_x86(x)
        MNotX86 as x => encode_not_x86(x)
        MLoadX86 as x => encode_load_x86(x)
        MStoreX86 as x => encode_store_x86(x)
        MFrameAddrX86 as x => encode_frame_addr_x86(layout, x)
        MLeaRipX86 as x => encode_lea_rip_x86(x)
        MJmpX86 as x => encode_jmp_x86(x)
        MCallX86 as x => encode_call_x86(x)
        MCallIndX86 as x => encode_call_ind_x86(x)
        MRetX86 => encode_ret_x86()
        MFAluX86 as x => encode_falu_x86(x)
        MFMovX86 as x => encode_fmov_x86(x)
        MFCmpX86 as x => encode_fcmp_x86(x)
        MSetPX86 as x => encode_setp_x86(x)
        MCvtX86 as x => encode_cvt_x86(x)
        MOutArgX86 as x => encode_out_arg_x86(layout, x)
        MInArgX86 as x => encode_in_arg_x86(layout, x)
        MFSpillX86 as x => encode_fspill_x86(layout, x)
    }
}

/**
 * scan_inst_saved_x86 — fold one physical instruction's def and use registers
 * into the callee-saved partition (via `inst_regs_x86`, the same def/use
 * decomposition the regalloc reads — the emitted instructions ARE the source of
 * truth, mirroring arm64's `scan_inst_saved`). Reuses the neutral `consider_reg`
 * so the caller-saved/non-allocatable filtering + ascending insert stay
 * single-sourced.
 *
 * @param AbiDescriptor abi  the register file (callee-saved partition)
 * @param Saved acc0  the partition so far
 * @param MInstX86 inst  the physical instruction to scan
 * @return Saved  the partition with `inst`'s registers folded in
 */
fn scan_inst_saved_x86(abi: AbiDescriptor, acc0: Saved, inst: MInstX86) -> Saved {
    let ir = inst_regs_x86(inst)
    mut acc = acc0
    if ir.has_def {
        acc = consider_reg(abi, acc, ir.def_reg)
    }
    mut i: u64 = 0
    loop {
        if i >= ir.uses.len { break }
        acc = consider_reg(abi, acc, ir.uses[i])
        i++
    }
    acc
}

/**
 * scan_block_saved_x86 — fold one block's instruction stream into the
 * callee-saved partition (the x86 mirror of arm64's `scan_block_saved`).
 *
 * @param AbiDescriptor abi  the register file
 * @param Saved acc0  the partition so far
 * @param MBlockX86 b  the block to scan
 * @return Saved  the partition with `b`'s registers folded in
 */
fn scan_block_saved_x86(abi: AbiDescriptor, acc0: Saved, b: MBlockX86) -> Saved {
    mut acc = acc0
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        acc = scan_inst_saved_x86(abi, acc, b.insts[i])
        i++
    }
    acc
}

/**
 * collect_callee_saved_x86 — re-derive the callee-saved save-set of a physical
 * `MFuncX86` by scanning every block's def/use registers (the D-A / A4 §3.1
 * precedent: `MFuncX86` carries no `used_callee_saved`, so B1 recomputes it).
 * On SysV AMD64 every XMM register is caller-saved, so `is_callee_saved` never
 * returns true for an FPR and the returned `fpr` list is ALWAYS empty — the
 * frame saves only GPRs. RSP(4)/RBP(5) are absent from the allocatable pool, so
 * they are never mistaken for callee-saved. The x86 mirror of arm64's
 * `collect_callee_saved`.
 *
 * @param AbiDescriptor abi  the register file
 * @param MFuncX86 f  the fully-physical function
 * @return Saved  the ascending, duplicate-free callee-saved GPR ids used (fpr always empty)
 */
fn collect_callee_saved_x86(abi: AbiDescriptor, f: MFuncX86) -> Saved {
    mut acc = Saved { gpr = teko::list::empty(); fpr = teko::list::empty() }
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        acc = scan_block_saved_x86(abi, acc, f.blocks[i])
        i++
    }
    acc
}

/**
 * shift_slot_offsets_x86 — every raw frame-slot offset shifted up by `delta`,
 * the byte size of the callee-saved push region that sits BELOW the slots on the
 * stack. With the SysV prologue's `sub rsp,#N` preceding the callee-saved
 * pushes, RSP ends `8*n_saved` bytes below the slot region, so each slot's
 * RSP-relative address (what `lea dst, [rsp+off]` reads) is its raw region
 * offset plus that push-region size. When there are no callee-saved registers
 * `delta` is 0 and the offsets pass through unchanged.
 *
 * @param []u32 offsets  the raw slot-region offsets (from `compute_slot_offsets`)
 * @param u32 delta  the callee-saved push-region byte size (`8*n_saved`)
 * @return []u32  the RSP-relative slot offsets
 */
fn shift_slot_offsets_x86(offsets: []u32, delta: u32) -> []u32 {
    mut out: []u32 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= offsets.len { break }
        out = teko::list::push(out, offsets[i] + delta)
        i++
    }
    out
}

/**
 * frame_sub_size_x86 — the `sub rsp,#N` amount that reserves everything sitting
 * BELOW the callee-saved pushes — the local slot region, the callee-saved XMM save
 * region and the argument-passing region — while keeping RSP 16-aligned at every
 * call boundary. A frameless function (nothing to reserve AND no callee-saved
 * push) reserves nothing (0). Otherwise the amount rounds
 * `reserved + 8*n_pushed` up to 16 and subtracts the push region back out, so
 * `push rbp` (RSP ≡ 0 mod 16) followed by `n_pushed` pushes then `sub rsp,#N`
 * lands RSP ≡ 0 mod 16 (the rule that `(rsp+8)` is 16-aligned at every callee
 * entry). The result can legitimately be 0 with an EVEN push count and nothing to
 * reserve (the pushes alone realign) — a framed function is still detected by
 * `size>0 OR n_saved>0`, not by `size>0`.
 *
 * @param u32 reserved  the 16-rounded bytes to reserve below the push region
 * @param u32 n_pushed  the PUSHED callee-saved register count (GPRs only — an XMM
 *                      save lives inside `reserved` instead)
 * @return u32  the `sub rsp` amount (0 for a frameless function)
 */
fn frame_sub_size_x86(reserved: u32, n_pushed: u32) -> u32 {
    let framed = (reserved > (0 to u32)) || (n_pushed > (0 to u32))
    if !framed { return 0 to u32 }
    align_up(reserved + (n_pushed * X86_GPR_BYTES), X86_STACK_ALIGN) - (n_pushed * X86_GPR_BYTES)
}

/**
 * inst_is_call_x86 — whether one machine instruction issues a call
 * (`MCallX86`/`MCallIndX86`), the per-instruction predicate `block_makes_call_x86`
 * folds over a block stream to decide whether a Win64 frame must reserve the
 * caller's shadow space (§4.1).
 *
 * @param MInstX86 i  the instruction to classify
 * @return bool  true iff `i` is a direct or indirect call
 */
fn inst_is_call_x86(i: MInstX86) -> bool {
    match i {
        MCallX86 => true
        MCallIndX86 => true
        _ => false
    }
}

/**
 * block_makes_call_x86 — whether any instruction in one block issues a call, the
 * block-level fold `func_makes_call_x86` walks over every block (the x86 mirror
 * of `scan_block_saved_x86`'s block scan).
 *
 * @param MBlockX86 b  the block to scan
 * @return bool  true iff `b` contains a call instruction
 */
fn block_makes_call_x86(b: MBlockX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        if inst_is_call_x86(b.insts[i]) { found = true; break }
        i++
    }
    found
}

/**
 * func_makes_call_x86 — whether the physical `MFuncX86` contains any call
 * (`MCallX86`/`MCallIndX86`), so `compute_frame_layout_x86` knows to reserve the
 * Win64 shadow space (a caller-only obligation — a leaf function reserves none).
 * A total scan over every block's instructions, mirroring the shape of
 * `collect_callee_saved_x86`'s block walk. On SysV (`shadow_space == 0`) the
 * result is unused, so the scan runs only on the Win64 path (§4.1).
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff the function issues at least one call
 */
fn func_makes_call_x86(f: MFuncX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if block_makes_call_x86(f.blocks[i]) { found = true; break }
        i++
    }
    found
}

/**
 * block_any_ret_x86 — whether one block contains a return terminator
 * (`MRetX86`), the block-level fold `func_any_ret_x86` walks over every block
 * (the x86 mirror of arm64's `block_any_ret`).
 *
 * @param MBlockX86 b  the block to scan
 * @return bool  true iff `b` contains an `MRetX86`
 */
fn block_any_ret_x86(b: MBlockX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        if is_ret_x86(b.insts[i]) { found = true; break }
        i++
    }
    found
}

/**
 * func_any_ret_x86 — whether the physical `MFuncX86` contains any `MRetX86`, so
 * `needs_call_align_x86` can tell a function that CALLS AND RETURNS (whose own
 * call sites need proper 16-byte alignment restored) from one that calls only
 * as its own divergent tail (`ex_func_frameless_call_reloc`'s own `tk_exit`
 * shape — a call with no `MRet` anywhere, whose alignment this backend has
 * never needed to restore because nothing after it ever runs). The x86 mirror
 * of arm64's `func_any_ret`.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff the function contains an `MRetX86`
 */
fn func_any_ret_x86(f: MFuncX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if block_any_ret_x86(f.blocks[i]) { found = true; break }
        i++
    }
    found
}

/**
 * needs_call_align_x86 — whether a function that would otherwise be frameless
 * (zero local slots, zero callee-saved registers) still needs a minimal
 * `push rbp`/`mov rbp,rsp` prologue for ONE reason alone: restoring the
 * SysV 16-byte call-boundary alignment before the calls IT ITSELF issues.
 *
 * SysV guarantees `rsp+8` is a multiple of 16 at every function's OWN entry
 * (the caller's `call` having just pushed an 8-byte return address) — so a
 * function that does ZERO stack adjustment before issuing a `call` of its own
 * hands that callee a stack off by 8 from the alignment the ABI promises it.
 * A single `push rbp` (no `sub rsp` needed) restores the missing 8 bytes at
 * no extra cost, exactly as it would for any other framed function.
 *
 * Scoped to a function that ALSO RETURNS (`func_any_ret_x86`), mirroring
 * arm64's own `needs_lr_save` reasoning exactly (`func_any_call(f) &&
 * func_any_ret(f)`): a function whose only calls are its own divergent tail
 * (`ex_func_frameless_call_reloc`'s `tk_exit` case) never returns to
 * observe — or make — a misaligned call after that point, so the existing
 * frameless encoding for THAT shape is untouched, byte for byte.
 *
 * Found live (0.3.1.0 degrau 19): the native entry stub `wrap_native_entry`
 * appends (`argc`/`argv` -> `tk_set_args` -> the renamed virtual-main -> its
 * own `ret`) has no local slots and clobbers no callee-saved register, so it
 * was the ONE function in a self-built compiler with zero slots/saves that
 * still calls AND returns — every other function either needs a slot/save of
 * its own or (like a bare `exit(n)` program body) never returns. The
 * resulting off-by-8 stack silently reached every call this stub makes
 * without symptom until a callee's OWN call chain used a strictly
 * 16-byte-aligned store deep inside (glibc's `vsnprintf` internals, first
 * exercised natively by this degrau's `tk_fmt_d_len`/`tk_fmt_n_i_len` twins) —
 * a SIGSEGV inside `__printf_buffer_init`, several frames below the actual
 * misalignment.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff a minimal alignment-only prologue/epilogue is needed
 */
fn needs_call_align_x86(f: MFuncX86) -> bool {
    func_makes_call_x86(f) && func_any_ret_x86(f)
}

/**
 * shadow_bytes_x86 — the Win64 caller-reserved shadow-space contribution to a
 * function's frame: `abi.shadow_space` when the register file reserves shadow
 * space (Win64: 32) AND the function makes a call (a callee expects 32 bytes to
 * spill its four register args), else 0. Every non-Win64 ABI leaves
 * `shadow_space` 0, so this returns 0 and the frame bytes stay byte-identical to
 * SysV/AAPCS64/LP64D (the FIXPOINT guardrail, §2.2); a Win64 LEAF (no call) also
 * returns 0, so it is frameless when it has no slots/callee-saved (§4.2).
 *
 * @param AbiDescriptor abi  the register file (its `shadow_space` field)
 * @param MFuncX86 f  the fully-physical function (scanned for a call)
 * @return u32  the shadow bytes to fold into the frame (32 for a calling Win64 function, else 0)
 */
fn shadow_bytes_x86(abi: AbiDescriptor, f: MFuncX86) -> u32 {
    if abi.shadow_space == (0 to u32) { return 0 to u32 }
    if !func_makes_call_x86(f) { return 0 to u32 }
    abi.shadow_space
}

/**
 * out_arg_bytes_x86 — the byte size of the outgoing stack-argument region a
 * function's frame must reserve (`B1-args`): 8 bytes per slot up to the highest
 * `MOutArgX86{index}` the block stream contains, rounded up to the 16-byte stack
 * alignment, or 0 when the function passes every argument in a register. Derived
 * by SCANNING the finished stream rather than carried on `MFuncX86`, exactly as
 * the callee-saved set and the shadow reservation already are, so isel stays free
 * of frame arithmetic.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return u32  the 16-aligned outgoing stack-argument region size in bytes
 */
fn out_arg_bytes_x86(f: MFuncX86) -> u32 {
    let n = max_out_arg_slots_x86(f)
    if n == (0 to u32) { return 0 to u32 }
    align_up(n * X86_GPR_BYTES, X86_STACK_ALIGN)
}

/**
 * max_out_arg_slots_x86 — how many outgoing stack-argument slots the function's
 * widest call needs: one past the highest `MOutArgX86{index}` in the stream, or 0
 * when there is none.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return u32  the outgoing stack-argument slot count
 */
fn max_out_arg_slots_x86(f: MFuncX86) -> u32 {
    mut slots: u32 = 0
    mut bi: u64 = 0
    loop {
        if bi >= f.blocks.len { break }
        let b = f.blocks[bi]
        mut ii: u64 = 0
        loop {
            if ii >= b.insts.len { break }
            let need = out_arg_slots_of_inst_x86(b.insts[ii])
            if need > slots { slots = need }
            ii++
        }
        bi++
    }
    slots
}

/**
 * out_arg_slots_of_inst_x86 — the outgoing stack-argument slot count one
 * instruction implies: `index + 1` for an `MOutArgX86`, 0 for everything else.
 *
 * @param MInstX86 i  the instruction to inspect
 * @return u32  the implied slot count
 */
fn out_arg_slots_of_inst_x86(i: MInstX86) -> u32 {
    match i {
        MOutArgX86 as x => x.index + (1 to u32)
        _ => 0 to u32
    }
}

/**
 * compute_frame_layout_x86 — build a function's `FrameLayoutX86`: re-derive the
 * callee-saved save-set by scanning the physical `MFuncX86`, lay out the frame
 * slots honoring each `LAlloca`'s alignment (the neutral `compute_slot_offsets`),
 * reserve the ARGUMENT-PASSING region at the very bottom of the frame — the
 * Win64 caller-reserved shadow space (`shadow_bytes_x86` — 32 for a calling Win64
 * function, 0 for every other ABI) plus the outgoing stack arguments
 * (`out_arg_bytes_x86`, `B1-args`) — size the `sub rsp` region for 16-byte
 * call-boundary alignment, and shift every slot offset above that
 * argument-passing region so `MFrameAddrX86` resolves to `lea dst, [rsp+off]`.
 *
 * The argument-passing region sits at RSP and NOTHING may sit below it: both
 * ABIs define a stack argument's address relative to the caller's RSP at the
 * call, and Win64 lets the callee write the 32 shadow bytes at that same RSP.
 * That is why the callee-saved pushes now precede the `sub rsp` (they used to
 * follow it, which put them at RSP and, under Win64, in the callee's way) — the
 * displacement is identical either way, so a function reserving no argument
 * region and saving no register keeps byte-identical bytes.
 *
 * A pure side-table pass — it never mutates the block stream, so the interp
 * oracle stays valid on the pre-encode function. The x86 mirror of arm64's
 * `compute_frame_layout`; frames beyond the imm32 `sub` field are caught at
 * prologue emission (`B1-bigframe`, near-N/A), not here. Both 32 and the
 * 16-rounded outgoing region are 16-aligned, so neither reservation perturbs the
 * alignment residue (§4.2).
 *
 * @param AbiDescriptor abi  the register file (callee-saved partition + shadow space)
 * @param MFuncX86 f  the fully-physical function
 * @return FrameLayoutX86  the resolved frame side-table
 */
pub fn compute_frame_layout_x86(abi: AbiDescriptor, f: MFuncX86) -> FrameLayoutX86 {
    let saved = collect_callee_saved_x86(abi, f)
    let slots = compute_slot_offsets(f.frame)
    let shadow = shadow_bytes_x86(abi, f)
    let arg_region = shadow + out_arg_bytes_x86(f)
    let fpr_region = (saved.fpr.len to u32) * X86_XMM_SAVE_BYTES
    let size = frame_sub_size_x86(slots.slots_size + arg_region + fpr_region, (saved.gpr.len to u32))
    let slot_offsets = shift_slot_offsets_x86(slots.offsets, arg_region + fpr_region)
    FrameLayoutX86 {
        size = size
        saved_gpr = saved.gpr
        saved_fpr = saved.fpr
        slot_offsets = slot_offsets
        call_align = needs_call_align_x86(f)
        out_arg_base = shadow
        fpr_save_base = arg_region
        caller_shadow = abi.shadow_space
    }
}

/**
 * frame_is_framed_x86 — whether a resolved frame needs a prologue/epilogue:
 * true when the `sub rsp` region is non-empty, OR any callee-saved register is
 * pushed, OR the frame is otherwise empty but still needs the minimal
 * alignment-only prologue `needs_call_align_x86` names (`layout.call_align`).
 * A framed function with an even callee-saved count and no slots has a zero
 * `sub` amount yet is still framed (the pushes carry it), so this is NOT
 * simply `size>0`.
 *
 * @param FrameLayoutX86 layout  the resolved frame
 * @return bool  true iff a prologue/epilogue must be emitted
 */
fn frame_is_framed_x86(layout: FrameLayoutX86) -> bool {
    let n_saved = (layout.saved_gpr.len + layout.saved_fpr.len) to u32
    (layout.size > (0 to u32)) || (n_saved > (0 to u32)) || layout.call_align
}

/**
 * honest_bigframe_x86 — the named honest-stop for a frame whose `sub rsp` amount
 * overruns the signed 32-bit immediate field. x86's `sub rsp,imm32` covers a 2 GB
 * frame, so this is an internal-invariant guard reached only by a pathological
 * (constructed) frame, never a real function (named for symmetry with arm64's
 * `A4-bigframe`, per the B1 plan §9).
 *
 * @return error  the `B1-bigframe` named honest-stop
 */
fn honest_bigframe_x86() -> error {
    error { message = "B1-bigframe: frame size exceeds the signed imm32 sub rsp field (near-N/A — sub rsp,imm32 covers 2GB)" }
}

/**
 * emit_mov_rbp_rsp_x86 — append `mov rbp, rsp` (`REX.W 89 /r`, `48 89 E5`), the
 * frame-pointer setup that follows `push rbp` in the prologue.
 *
 * @param []byte buf  the buffer to extend
 * @return []byte  `buf` followed by the three prologue bytes
 */
fn emit_mov_rbp_rsp_x86(buf: []byte) -> []byte {
    let b = push_byte_x86(buf, REX_W_PREFIX)
    push_byte_x86(push_byte_x86(b, X86_OP_MOV_RM_R), X86_MODRM_MOV_RBP_RSP)
}

/**
 * emit_push_reg_x86 — append `push r64` (`50+rd`, with a `REX.B` prefix `0x41`
 * when the id is R8..R15): the callee-saved save and the frame-pointer save.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 id  the physical register id to push
 * @return []byte  `buf` followed by the push encoding
 */
fn emit_push_reg_x86(buf: []byte, id: u32) -> []byte {
    let b = if (id & X86_REG_HIGH_BIT) != (0 to u32) { push_byte_x86(buf, REX_B_PREFIX) } else { buf }
    push_byte_x86(b, X86_OP_PUSH_R64 + (id & X86_FIELD3_MASK))
}

/**
 * emit_pop_reg_x86 — append `pop r64` (`58+rd`, with a `REX.B` prefix `0x41`
 * when the id is R8..R15): the callee-saved restore counterpart of
 * `emit_push_reg_x86`.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 id  the physical register id to pop
 * @return []byte  `buf` followed by the pop encoding
 */
fn emit_pop_reg_x86(buf: []byte, id: u32) -> []byte {
    let b = if (id & X86_REG_HIGH_BIT) != (0 to u32) { push_byte_x86(buf, REX_B_PREFIX) } else { buf }
    push_byte_x86(b, X86_OP_POP_R64 + (id & X86_FIELD3_MASK))
}

/**
 * emit_sub_rsp_x86 — append the stack-claim `sub rsp, #amount`: nothing for a
 * zero amount (an even callee-saved count needs no extra realignment), the
 * short `48 83 EC ib` form for an amount under 128, else the wide
 * `48 81 EC id` form (little-endian imm32). An amount beyond the signed imm32
 * field raises the `B1-bigframe` honest-stop.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 amount  the byte amount to subtract from RSP
 * @return []byte | error  the extended buffer, or the `B1-bigframe` honest-stop
 */
fn emit_sub_rsp_x86(buf: []byte, amount: u32) -> []byte | error {
    if amount == (0 to u32) { return buf }
    if amount < X86_SUB_RSP_IMM8_MAX {
        let b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM8), X86_MODRM_SUB_RSP)
        return push_byte_x86(b, amount)
    }
    if amount > (X86_IMM32_MAX to u32) { return honest_bigframe_x86() }
    let b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM32), X86_MODRM_SUB_RSP)
    emit_u32_le(b, amount)
}

/**
 * emit_add_rsp_x86 — append the stack-release `add rsp, #amount`, the teardown
 * counterpart of `emit_sub_rsp_x86` and its exact encoding mirror (same `48 83`/
 * `48 81` group-1 opcodes, `/0` instead of `/5`): nothing for a zero amount, the
 * short imm8 form under 128, else the wide imm32 form. It raises no
 * `B1-bigframe` — an amount the prologue's `sub` already accepted fits here by
 * construction, so this takes the imm32 form for anything larger rather than
 * duplicating a guard that cannot fire (`B1-args`).
 *
 * @param []byte buf  the buffer to extend
 * @param u32 amount  the byte amount to add back to RSP
 * @return []byte  the extended buffer
 */
fn emit_add_rsp_x86(buf: []byte, amount: u32) -> []byte {
    if amount == (0 to u32) { return buf }
    if amount < X86_SUB_RSP_IMM8_MAX {
        let b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM8), X86_MODRM_ADD_RSP)
        return push_byte_x86(b, amount)
    }
    let b = push_byte_x86(push_byte_x86(push_byte_x86(buf, REX_W_PREFIX), X86_OP_GRP1_IMM32), X86_MODRM_ADD_RSP)
    emit_u32_le(b, amount)
}

/**
 * emit_saved_fpr_stores_x86 — save (or, when `reload`, restore) every
 * callee-saved XMM the frame lists, one `movaps [rsp+off], xmm` / `movaps xmm,
 * [rsp+off]` per register at its own 16-byte slot in the frame's XMM-save region
 * (`fpr_save_base + 16*k`, ascending id order). This is the whole content of the
 * former `B3-xmm-callee-saved` honest-stop: Win64 declares XMM6..XMM15
 * nonvolatile, so a float value the allocator parked in one of them across a call
 * must be preserved by us, and `movaps` (not `movsd`) is the right instruction
 * because the ABI's promise covers all 128 bits, not the scalar low lane our own
 * code happens to use. SysV lists every XMM as caller-saved, so `saved_fpr` is
 * empty there and this appends nothing — the SysV bytes stay identical.
 *
 * The XMM-save region is 16-aligned by construction: the frame's total
 * displacement is a multiple of 16 (`frame_sub_size_x86`) and the region sits
 * above the likewise 16-aligned argument-passing region, so `movaps`' alignment
 * requirement is met without a runtime check.
 *
 * @param []byte buf  the buffer to extend
 * @param FrameLayoutX86 layout  the resolved frame
 * @param bool reload  true to emit the restoring loads, false the saving stores
 * @return []byte  `buf` followed by the save/restore encodings
 */
fn emit_saved_fpr_stores_x86(buf: []byte, layout: FrameLayoutX86, reload: bool) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= layout.saved_fpr.len { break }
        let off = layout.fpr_save_base + ((i to u32) * X86_XMM_SAVE_BYTES)
        b = append_bytes(b, emit_movaps_frame_x86(layout.saved_fpr[i], off, reload).bytes)
        i++
    }
    b
}

/**
 * emit_movaps_frame_x86 — one `movaps` between XMM register `id` and the frame
 * byte offset `off` from RSP: the store form (`0F 29`) or, when `reload`, the load
 * form (`0F 28`). Routed through `emit_mem_op_x86` so the RSP base's mandatory SIB
 * byte and the disp8/disp32 choice are the SAME code every other frame access
 * uses (`B3-xmm-callee-saved`).
 *
 * @param u32 id  the XMM register id to save or restore
 * @param u32 off  the RSP-relative byte offset of its 16-byte slot
 * @param bool reload  true for the load form, false for the store form
 * @return EncInstX86  the encoded instruction
 */
