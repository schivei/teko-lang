fn xat_call_indirect_is_call_through_target() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let t = lir::alloc_vreg(f0)
    let s0 = lir::append_inst(t.func, 0, lir::alloca_inst(t.vreg, 8, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::void_call_indirect_inst(t.vreg, teko::list::empty(), false, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::ret_inst(t.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s2), "call.indirect %0()")
}

#test

fn xat_fused_compare_branch_is_cmp_jcc_jmp() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let b1 = lir::alloc_block(f0)
    let b2 = lir::alloc_block(b1.func)
    let v0 = lir::alloc_vreg(b2.func)
    let v1 = lir::alloc_vreg(v0.func)
    let v2 = lir::alloc_vreg(v1.func)
    let v3 = lir::alloc_vreg(v2.func)
    let v4 = lir::alloc_vreg(v3.func)
    let s0 = lir::append_inst(v4.func, 0, lir::const_int_inst(v0.vreg, 5, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(v1.vreg, 3, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::bin_inst(v2.vreg, lir::LBinOp::ICmpGtS, v0.vreg, v1.vreg, 0, 0))
    let s3 = lir::append_inst(s2, 0, lir::branch_inst(v2.vreg, b1.block_id, teko::list::empty(), b2.block_id, teko::list::empty(), 0, 0))
    let s4 = lir::append_inst(s3, b1.block_id, lir::const_int_inst(v3.vreg, 1, 0, 0))
    let s5 = lir::append_inst(s4, b1.block_id, lir::ret_inst(v3.vreg, 0, 0))
    let s6 = lir::append_inst(s5, b2.block_id, lir::const_int_inst(v4.vreg, 2, 0, 0))
    let s7 = lir::append_inst(s6, b2.block_id, lir::ret_inst(v4.vreg, 0, 0))
    let text = xat_dump(s7)
    teko::assert::str_contains(text, "cmp.q %0, %1")
    teko::assert::str_contains(text, "jg #M1")
    teko::assert::str_contains(text, "jmp #M2")
}

#test

fn xat_select_module_carries_rodata_globals_layouts_through() {
    let rodata = teko::list::push(teko::list::empty(), lir::LRodata { symbol = ".Lstr0"; bytes = teko::list::empty(); relocs = teko::list::empty() })
    let inner = xat_ret(xat_const(xat_main_ret(), 7).func, xat_const(xat_main_ret(), 7).vreg)
    let m0 = lir::with_rodata(lir::add_func(lir::empty_module(), inner), rodata)
    let selected = match select_module_x86(SYSV64, m0) { MModuleX86 as x => x; error => return }
    teko::assert::is_true(selected.rodata.len == 1)
    teko::assert::is_true(selected.funcs.len == 1)
}

/**
 * xat_str_pair_call — a `main` whose body materializes a `tk_str`'s flattened
 * `(ptr, len)` pair (a rodata address + a constant length, exactly what
 * `lower.tks::lower_str_arg_call` emits) and hands it to `sym` as a two-operand
 * void call, then returns the length VReg. The fixture behind the Win64
 * by-reference argument tests.
 *
 * @param str sym  the called runtime symbol
 * @return lir::LFunc  the built function
 */
fn xat_str_pair_call(sym: str) -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let p = lir::alloc_vreg(f0)
    let n = lir::alloc_vreg(p.func)
    let s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, ".Lstr0", 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, 10, 0, 0))
    let args = teko::list::push(teko::list::push(teko::list::empty(), p.vreg), n.vreg)
    let s2 = lir::append_inst(s1, 0, lir::void_call_inst(sym, args, false, 0, 0))
    lir::append_inst(s2, 0, lir::ret_inst(n.vreg, 0, 0))
}

/**
 * xat_dump_abi — select `f` under an explicit ABI descriptor and render the
 * machine module as text (the ABI-sensitive sibling of `xat_dump`, which pins
 * SysV).
 *
 * @param AbiDescriptor abi  the ABI register file to select under
 * @param lir::LFunc f  the function to select and print
 * @return str  the rendered machine text ("" on a selection error)
 */
fn xat_dump_abi(abi: AbiDescriptor, f: lir::LFunc) -> str {
    let mf = match select_lfunc_x86(abi, f) { MFuncX86 as x => x; error => return "" }
    minst_print_x86(add_mfunc_x86(empty_mmodule_x86(), mf))
}

#test

/**
 * xat_win64_str_pair_travels_by_reference — the ONE-pair family (the io group plus
 * `tk_panic_str`): the 16-byte copy's address, `.ptr` at +0, `.len` at +8, and that
 * ADDRESS — never the pair — in RCX, the sole argument register used.
 *
 * @return void
 */
fn xat_win64_str_pair_travels_by_reference() {
    let text = xat_dump_abi(WIN64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "lea %2, [frame #0]")
    teko::assert::str_contains(text, "mov.q [%2 + 0], %0")
    teko::assert::str_contains(text, "mov.q [%2 + 8], %1")
    teko::assert::str_contains(text, "mov.q %p1, %2")
    teko::assert::str_contains(text, "call @tk_println(%p1)")
}

#test

/**
 * xat_win64_str_pair_reserves_one_16_byte_frame_slot — one by-value `tk_str` costs
 * exactly one 16-byte, 8-aligned frame slot.
 *
 * @return void
 */
fn xat_win64_str_pair_reserves_one_16_byte_frame_slot() {
    let mf = match select_lfunc_x86(WIN64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
}

#test

/**
 * xat_sysv_str_pair_stays_in_two_registers — SysV carries a 2-eightbyte aggregate
 * in RDI/RSI, so this is the byte-identity guardrail: no frame slot, no stores,
 * both halves pinned as ordinary register arguments.
 *
 * @return void
 */
fn xat_sysv_str_pair_stays_in_two_registers() {
    let text = xat_dump_abi(SYSV64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "call @tk_println(%p7, %p6)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
    let mf = match select_lfunc_x86(SYSV64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 0)
}

#test

/**
 * xat_win64_non_str_builtin_pair_stays_in_two_registers — the by-reference path is
 * keyed on the CLOSED by-value-`tk_str` arity table, never on "a call with two
 * arguments": an ordinary two-scalar call keeps RCX/RDX.
 *
 * @return void
 */
fn xat_win64_non_str_builtin_pair_stays_in_two_registers() {
    let text = xat_dump_abi(WIN64, xat_str_pair_call("teko__demo__f"))
    teko::assert::str_contains(text, "call @teko__demo__f(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
}

/**
 * xat_two_str_pairs_call — a `main` whose body materializes TWO flattened `tk_str`
 * pairs (`%0`/`%1` and `%2`/`%3` — a rodata address plus a constant length each,
 * exactly the four operands `lower.tks::fat_eq_call_args` emits) and hands all four
 * to `sym` as one result-producing call, then returns the result.
 *
 * The fixture behind the two-pair Win64 goldens: `tk_str_eq`, `tk_str_contains` and
 * `tk_str_ends_with` all have this shape.
 *
 * @param str sym  the called runtime symbol
 * @return lir::LFunc  the built function
 */
fn xat_two_str_pairs_call(sym: str) -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_str_pair_operands(f0, ".Lstr0", 10)
    let b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    let r = lir::alloc_vreg(b.func)
    let args = xat_four_vregs(a.ptr, a.len, b.ptr, b.len)
    let s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, sym, args, false, 0, 0))
    lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
}

/**
 * XatStrPairOperands — one flattened `tk_str` operand pair plus the function that
 * defines both halves.
 */
type XatStrPairOperands = struct {
    /** the function with both defining instructions appended. */
    func: lir::LFunc
    /** the VReg holding the pointer half (a rodata address). */
    ptr: u32
    /** the VReg holding the byte length. */
    len: u32
}

/**
 * xat_str_pair_operands — append the two instructions that define one flattened
 * `tk_str` pair: the rodata address of `symbol` and the constant length `len`.
 *
 * @param lir::LFunc f  the function to extend
 * @param str symbol  the rodata symbol the pointer half addresses
 * @param i64 len  the constant byte length
 * @return XatStrPairOperands  the extended function + the pair's two VRegs
 */
fn xat_str_pair_operands(f: lir::LFunc, symbol: str, len: i64) -> XatStrPairOperands {
    let p = lir::alloc_vreg(f)
    let n = lir::alloc_vreg(p.func)
    let s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, symbol, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, len, 0, 0))
    XatStrPairOperands { func = s1; ptr = p.vreg; len = n.vreg }
}

/**
 * xat_four_vregs — the four VRegs of two flattened pairs, in ABI order.
 *
 * @param u32 a  the first pair's pointer half
 * @param u32 b  the first pair's length
 * @param u32 c  the second pair's pointer half
 * @param u32 d  the second pair's length
 * @return []u32  the four ids, in order
 */
fn xat_four_vregs(a: u32, b: u32, c: u32, d: u32) -> []u32 {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), a), b), c), d)
}

/**
 * xat_last_index_of_call — `tk_rt_last_index_of_ok(hay, needle, out_index)`: TWO
 * flattened pairs followed by an ordinary pointer operand (an `LAlloca`'s address),
 * the exact shape `lower.tks::lower_last_index_of_call` emits and the only
 * two-pair entry with a trailing scalar.
 *
 * @return lir::LFunc  the built function
 */
fn xat_last_index_of_call() -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_str_pair_operands(f0, ".Lstr0", 10)
    let b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    let out = lir::alloc_vreg(b.func)
    let s0 = lir::append_inst(out.func, 0, lir::alloca_inst(out.vreg, 8 to u32, 8 to u32, 0, 0))
    let r = lir::alloc_vreg(s0)
    let args = teko::list::push(xat_four_vregs(a.ptr, a.len, b.ptr, b.len), out.vreg)
    let s1 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "tk_rt_last_index_of_ok", args, false, 0, 0))
    lir::append_inst(s1, 0, lir::ret_inst(r.vreg, 0, 0))
}

#test
