/**
 * elf_build_relas — resolve every neutral `ElfRelocReq` of `obj` into an
 * `Elf64_Rela` row: a rodata target (a defined section-2 local) re-points at the
 * `.rodata` section symbol with its `.rodata` byte offset folded onto the addend;
 * any other target (a defined function, a `.text` pcrel label, or an undefined
 * extern) keeps its base addend and takes that symbol's POST-partition table
 * index. The numeric `R_<arch>_*` type rides through unchanged — each per-ISA
 * adapter already lowered its own `RelocKind*` to `rtype`, so no ISA knowledge
 * remains here. The `r_offset` is the encoder's module-rebased `.text`-relative
 * field offset, unchanged.
 *
 * @param relocs   the `.text`-relative neutral relocation requests
 * @param symbols  the post-partition neutral symbol list (for `elf_rodata_hit`)
 * @param syms  the resolved symbol table (for target indices)
 * @return []ElfRela  the resolved relocation rows, in emission order
 */
fn elf_build_relas(relocs: []ElfRelocReq, symbols: []Symbol, syms: []ElfSym) -> []ElfRela {
    elf_resolve_relas(relocs, symbols, syms)
}

/**
 * elf_resolve_relas — resolve a list of neutral `ElfRelocReq` rows into
 * `Elf64_Rela` rows, computing the two section-symbol indices once and folding
 * each row through `elf_resolve_rela`. Shared by the `.rela.text` and
 * `.rela.data.rel.ro` builders.
 *
 * @param reqs     the neutral relocation requests, in emission order
 * @param symbols  the post-partition neutral symbol list (for `elf_rodata_hit`)
 * @param syms     the resolved symbol table (for section-symbol + target indices)
 * @return []ElfRela  the resolved relocation rows, in the same order
 */
fn elf_resolve_relas(reqs: []ElfRelocReq, symbols: []Symbol, syms: []ElfSym) -> []ElfRela {
    let rodata_secidx = elf_rodata_secsym_index(syms)
    let drr_secidx = elf_drr_secsym_index(syms)
    mut out: []ElfRela = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= reqs.len { break }
        out = teko::list::push(out, elf_resolve_rela(reqs[i], symbols, syms, rodata_secidx, drr_secidx))
        i++
    }
    out
}

/**
 * elf_resolve_rela — resolve ONE neutral `ElfRelocReq` `r` into an `Elf64_Rela`
 * row: a section-local target (a defined `.rodata` OR `.data.rel.ro` local)
 * re-points at THAT section's section symbol — `rodata_secidx` for a pure datum,
 * `drr_secidx` for a moved pointer-bearing one — with the datum's section byte
 * offset folded onto the addend; any other target takes its POST-partition
 * symbol index. The numeric `rtype` and the section-base-relative `r.offset` ride
 * through unchanged.
 *
 * @param r             the neutral relocation request
 * @param symbols       the post-partition neutral symbol list (for `elf_rodata_hit`)
 * @param syms          the resolved symbol table (for target indices)
 * @param rodata_secidx the `.rodata` section symbol's table index
 * @param drr_secidx    the `.data.rel.ro` section symbol's table index (or `syms.len`)
 * @return              the resolved `Elf64_Rela` row
 */
fn elf_resolve_rela(r: ElfRelocReq, symbols: []Symbol, syms: []ElfSym, rodata_secidx: u32, drr_secidx: u32) -> ElfRela {
    let hit = elf_rodata_hit(symbols, r.sym)
    let secidx = if hit.is_drr { drr_secidx } else { rodata_secidx }
    let symidx = if hit.found { secidx } else { elf_symbol_index(syms, r.sym) }
    let addend = if hit.found { r.addend + hit.offset } else { r.addend }
    ElfRela { offset = r.offset; symidx = symidx; rtype = r.rtype; addend = addend }
}

/**
 * elf_build_rodata_relas — resolve each moved-datum relocation into a
 * `.rela.data.rel.ro` row: a `const []T` fat slot's data→data pointer becomes
 * R_X86_64_64 against the target leaf's section symbol (the `.rodata` symbol,
 * since a leaf stays read-only) with the leaf's `.rodata` offset folded onto the
 * addend; its `r_offset` is the pointer slot's byte offset INSIDE `.data.rel.ro`
 * (the partition already rebased it). Empty unless the module carries a
 * pointer-bearing const.
 *
 * @param drr_relocs  the `.data.rel.ro`-relative moved-datum relocations
 * @param symbols  the post-partition neutral symbol list
 * @param syms  the resolved symbol table (for target indices)
 * @return      the `.rela.data.rel.ro` rows, in emission order
 */
fn elf_build_rodata_relas(drr_relocs: []ElfRelocReq, symbols: []Symbol, syms: []ElfSym) -> []ElfRela {
    elf_resolve_relas(drr_relocs, symbols, syms)
}

/**
 * elf_rela_info — the `Elf64_Rela` `r_info` word, `(symbol_index << 32) | type`.
 *
 * @param u32 symidx  the symbol-table index
 * @param u32 rtype  the `R_X86_64_*` type
 * @return u64  the packed `r_info`
 */
fn elf_rela_info(symidx: u32, rtype: u32) -> u64 {
    ((symidx to u64) << (32 to u64)) | rtype
}

/**
 * elf_section_names — the section names, in section-header-table order: the
 * seven fixed names (`""` null, `.text`, `.rodata`, `.symtab`, `.strtab`,
 * `.shstrtab`, `.rela.text`), plus — when the module carries a pointer-bearing
 * const — the appended `.data.rel.ro` (index 7) and its `.rela.data.rel.ro`
 * (index 8), plus — when a `--debug=lines` build supplies DWARF (D1.4) —
 * `.debug_abbrev`, `.debug_info`, `.debug_line`, `.rela.debug_info`, and
 * `.rela.debug_line`, ALWAYS the last five names regardless of `has_drr` (so
 * their table index is `7` or `9`, never in between). Every appended block is
 * interned into `.shstrtab` to yield its header's `sh_name`; each is APPENDED so
 * the six fixed sections keep their indices (`ELF_SHNDX_*` and every
 * `sh_link`/`sh_info`/`e_shstrndx` naming them stay valid).
 *
 * @param bool has_drr    whether a `.data.rel.ro` section (and its rela) is present
 * @param bool has_dwarf  whether the DWARF sections (D1.4) are present
 * @return []str  the section names, in header order
 */
fn elf_section_names(has_drr: bool, has_dwarf: bool) -> []str {
    let base = ["", ".text", ".rodata", ".symtab", ".strtab", ".shstrtab", ".rela.text"]
    let with_drr = if has_drr { teko::list::push(teko::list::push(base, ".data.rel.ro"), ".rela.data.rel.ro") } else { base }
    if !has_dwarf { return with_drr }
    let with_dwarf_secs = teko::list::push(teko::list::push(teko::list::push(with_drr, ".debug_abbrev"), ".debug_info"), ".debug_line")
    teko::list::push(teko::list::push(with_dwarf_secs, ".rela.debug_info"), ".rela.debug_line")
}

/**
 * ELF64_SYM_SIZE — `sizeof(Elf64_Sym)`: the 24-byte size of one symbol-table
 * entry, `.symtab`'s `sh_entsize` and the multiplier of its `sh_size`.
 */
const ELF64_SYM_SIZE: u32 = 24 to u32

/**
 * ELF64_RELA_SIZE — `sizeof(Elf64_Rela)`: the 24-byte size of one relocation
 * entry, the `.rela.*` sections' `sh_entsize` and the multiplier of their
 * `sh_size`.
 */
const ELF64_RELA_SIZE: u32 = 24 to u32

/**
 * ElfLayout — the resolved file offsets, sizes, and counts of the object:
 * computed BEFORE any bytes are emitted, so the `Elf64_Ehdr` `e_shoff` and each
 * `Elf64_Shdr` `sh_offset`/`sh_size` can reference the real data positions. The
 * emission order mirrors this exactly: `[Ehdr][.text][.rodata][.data.rel.ro?]
 * [.symtab][.strtab][.shstrtab][.rela.text][.rela.data.rel.ro?][.debug_abbrev?]
 * [.debug_info?][.debug_line?][.rela.debug_info?][.rela.debug_line?][SHT]` (D1.4
 * adds the five `?`-marked DWARF fields, always LAST regardless of `.data.rel.ro`
 * — see `elf_section_names`), with every non-string-table section placed at
 * 8-aligned offsets.
 *
 * @since #386 B1-7
 */
type ElfLayout = struct {
    /**
     * text_offset — the `.text` section data file offset (just past the Ehdr).
     */
    text_offset: u32
    /**
     * text_size — the `.text` section byte size.
     */
    text_size: u32
    /**
     * rodata_offset — the 8-aligned `.rodata` section data file offset.
     */
    rodata_offset: u32
    /**
     * rodata_size — the `.rodata` section byte size (0 when no rodata).
     */
    rodata_size: u32
    /**
     * drr_offset — the 8-aligned `.data.rel.ro` section data file offset (right
     * after `.rodata`), or the 8-aligned end-of-`.rodata` value when the module
     * carries no pointer-bearing const (nothing is emitted there).
     */
    drr_offset: u32
    /**
     * drr_size — the `.data.rel.ro` section byte size; 0 when the module carries
     * no pointer-bearing const, keeping the object byte-identical to the
     * pre-partition writer.
     */
    drr_size: u32
    /**
     * symtab_offset — the 8-aligned `.symtab` file offset.
     */
    symtab_offset: u32
    /**
     * symtab_size — the `.symtab` byte size (`nsyms * 24`).
     */
    symtab_size: u32
    /**
     * strtab_offset — the `.strtab` file offset (immediately after `.symtab`).
     */
    strtab_offset: u32
    /**
     * strtab_size — the `.strtab` byte size.
     */
    strtab_size: u32
    /**
     * shstrtab_offset — the `.shstrtab` file offset (immediately after
     * `.strtab`).
     */
    shstrtab_offset: u32
    /**
     * shstrtab_size — the `.shstrtab` byte size.
     */
    shstrtab_size: u32
    /**
     * rela_offset — the 8-aligned `.rela.text` file offset.
     */
    rela_offset: u32
    /**
     * rela_size — the `.rela.text` byte size (`nrela * 24`).
     */
    rela_size: u32
    /**
     * shoff — the 8-aligned section-header-table file offset (the Ehdr's
     * `e_shoff`).
     */
    shoff: u32
    /**
     * nsyms — the number of `Elf64_Sym` entries.
     */
    nsyms: u32
    /**
     * nrela — the number of `Elf64_Rela` entries.
     */
    nrela: u32
    /**
     * first_global — `.symtab`'s `sh_info`: the index of the first non-local
     * symbol.
     */
    first_global: u32
    /**
     * rela_rodata_offset — the 8-aligned file offset of `.rela.data.rel.ro`
     * (right after `.rela.text`), or the 8-aligned end-of-`.rela.text` value when
     * the module carries no pointer-bearing const (nothing is emitted there).
     */
    rela_rodata_offset: u32
    /**
     * rela_rodata_size — the byte size of `.rela.data.rel.ro`
     * (`nrela_rodata * 24`); 0 when the module carries no pointer-bearing const,
     * keeping the object byte-identical to the pre-partition writer.
     */
    rela_rodata_size: u32
    /**
     * nrela_rodata — the `Elf64_Rela` count of `.rela.data.rel.ro` (0 for a
     * module with no pointer-bearing const).
     */
    nrela_rodata: u32
    /**
     * nsects — the section-header count (`e_shnum`): 7 without a pointer-bearing
     * const, 9 with it (the appended `.data.rel.ro` + `.rela.data.rel.ro`), plus 5
     * more with DWARF present (D1.4). Derived from the section-name count.
     */
    nsects: u32
    /**
     * debug_abbrev_offset — the `.debug_abbrev` section data file offset (D1.4;
     * meaningful only when DWARF is present — equals the identity value below when
     * absent, since its 0-byte size never moves the chain).
     */
    debug_abbrev_offset: u32
    /**
     * debug_abbrev_size — the `.debug_abbrev` section byte size (0 when DWARF is
     * absent, keeping the object byte-identical to a build with no debug axis).
     */
    debug_abbrev_size: u32
    /**
     * debug_info_offset — the `.debug_info` section data file offset (D1.4).
     */
    debug_info_offset: u32
    /**
     * debug_info_size — the `.debug_info` section byte size (0 when DWARF is
     * absent).
     */
    debug_info_size: u32
    /**
     * debug_line_offset — the `.debug_line` section data file offset (D1.4).
     */
    debug_line_offset: u32
    /**
     * debug_line_size — the `.debug_line` section byte size (0 when DWARF is
     * absent).
     */
    debug_line_size: u32
    /**
     * rela_debug_info_offset — the `.rela.debug_info` file offset (D1.4).
     */
    rela_debug_info_offset: u32
    /**
     * rela_debug_info_size — the `.rela.debug_info` byte size (`nrela * 24`; 0
     * when DWARF is absent).
     */
    rela_debug_info_size: u32
    /**
     * rela_debug_line_offset — the `.rela.debug_line` file offset (D1.4).
     */
    rela_debug_line_offset: u32
    /**
     * rela_debug_line_size — the `.rela.debug_line` byte size (`nrela * 24`; 0
     * when DWARF is absent).
     */
    rela_debug_line_size: u32
}
