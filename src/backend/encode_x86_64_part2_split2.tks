/**
 * scan_block_saved_x86 — fold one block's instruction stream into the
 * callee-saved partition (the x86 mirror of arm64's `scan_block_saved`).
 *
 * @param AbiDescriptor abi  the register file
 * @param Saved acc0  the partition so far
 * @param MBlockX86 b  the block to scan
 * @return Saved  the partition with `b`'s registers folded in
 */
fn scan_block_saved_x86(abi: AbiDescriptor, acc0: Saved, b: MBlockX86) -> Saved {
    mut acc = acc0
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        acc = scan_inst_saved_x86(abi, acc, b.insts[i])
        i++
    }
    acc
}

/**
 * collect_callee_saved_x86 — re-derive the callee-saved save-set of a physical
 * `MFuncX86` by scanning every block's def/use registers (the D-A / A4 §3.1
 * precedent: `MFuncX86` carries no `used_callee_saved`, so B1 recomputes it).
 * On SysV AMD64 every XMM register is caller-saved, so `is_callee_saved` never
 * returns true for an FPR and the returned `fpr` list is ALWAYS empty — the
 * frame saves only GPRs. RSP(4)/RBP(5) are absent from the allocatable pool, so
 * they are never mistaken for callee-saved. The x86 mirror of arm64's
 * `collect_callee_saved`.
 *
 * @param AbiDescriptor abi  the register file
 * @param MFuncX86 f  the fully-physical function
 * @return Saved  the ascending, duplicate-free callee-saved GPR ids used (fpr always empty)
 */
fn collect_callee_saved_x86(abi: AbiDescriptor, f: MFuncX86) -> Saved {
    mut acc = Saved { gpr = teko::list::empty(); fpr = teko::list::empty() }
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        acc = scan_block_saved_x86(abi, acc, f.blocks[i])
        i++
    }
    acc
}

/**
 * shift_slot_offsets_x86 — every raw frame-slot offset shifted up by `delta`,
 * the byte size of the callee-saved push region that sits BELOW the slots on the
 * stack. With the SysV prologue's `sub rsp,#N` preceding the callee-saved
 * pushes, RSP ends `8*n_saved` bytes below the slot region, so each slot's
 * RSP-relative address (what `lea dst, [rsp+off]` reads) is its raw region
 * offset plus that push-region size. When there are no callee-saved registers
 * `delta` is 0 and the offsets pass through unchanged.
 *
 * @param []u32 offsets  the raw slot-region offsets (from `compute_slot_offsets`)
 * @param u32 delta  the callee-saved push-region byte size (`8*n_saved`)
 * @return []u32  the RSP-relative slot offsets
 */
fn shift_slot_offsets_x86(offsets: []u32, delta: u32) -> []u32 {
    mut out: []u32 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= offsets.len { break }
        out = teko::list::push(out, offsets[i] + delta)
        i++
    }
    out
}

/**
 * frame_sub_size_x86 — the `sub rsp,#N` amount that reserves everything sitting
 * BELOW the callee-saved pushes — the local slot region, the callee-saved XMM save
 * region and the argument-passing region — while keeping RSP 16-aligned at every
 * call boundary. A frameless function (nothing to reserve AND no callee-saved
 * push) reserves nothing (0). Otherwise the amount rounds
 * `reserved + 8*n_pushed` up to 16 and subtracts the push region back out, so
 * `push rbp` (RSP ≡ 0 mod 16) followed by `n_pushed` pushes then `sub rsp,#N`
 * lands RSP ≡ 0 mod 16 (the rule that `(rsp+8)` is 16-aligned at every callee
 * entry). The result can legitimately be 0 with an EVEN push count and nothing to
 * reserve (the pushes alone realign) — a framed function is still detected by
 * `size>0 OR n_saved>0`, not by `size>0`.
 *
 * @param u32 reserved  the 16-rounded bytes to reserve below the push region
 * @param u32 n_pushed  the PUSHED callee-saved register count (GPRs only — an XMM
 *                      save lives inside `reserved` instead)
 * @return u32  the `sub rsp` amount (0 for a frameless function)
 */
fn frame_sub_size_x86(reserved: u32, n_pushed: u32) -> u32 {
    let framed = (reserved > (0 to u32)) || (n_pushed > (0 to u32))
    if !framed { return 0 to u32 }
    align_up(reserved + (n_pushed * X86_GPR_BYTES), X86_STACK_ALIGN) - (n_pushed * X86_GPR_BYTES)
}

/**
 * inst_is_call_x86 — whether one machine instruction issues a call
 * (`MCallX86`/`MCallIndX86`), the per-instruction predicate `block_makes_call_x86`
 * folds over a block stream to decide whether a Win64 frame must reserve the
 * caller's shadow space (§4.1).
 *
 * @param MInstX86 i  the instruction to classify
 * @return bool  true iff `i` is a direct or indirect call
 */
fn inst_is_call_x86(i: MInstX86) -> bool {
    match i {
        MCallX86 => true
        MCallIndX86 => true
        _ => false
    }
}

/**
 * block_makes_call_x86 — whether any instruction in one block issues a call, the
 * block-level fold `func_makes_call_x86` walks over every block (the x86 mirror
 * of `scan_block_saved_x86`'s block scan).
 *
 * @param MBlockX86 b  the block to scan
 * @return bool  true iff `b` contains a call instruction
 */
fn block_makes_call_x86(b: MBlockX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        if inst_is_call_x86(b.insts[i]) { found = true; break }
        i++
    }
    found
}

/**
 * func_makes_call_x86 — whether the physical `MFuncX86` contains any call
 * (`MCallX86`/`MCallIndX86`), so `compute_frame_layout_x86` knows to reserve the
 * Win64 shadow space (a caller-only obligation — a leaf function reserves none).
 * A total scan over every block's instructions, mirroring the shape of
 * `collect_callee_saved_x86`'s block walk. On SysV (`shadow_space == 0`) the
 * result is unused, so the scan runs only on the Win64 path (§4.1).
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff the function issues at least one call
 */
fn func_makes_call_x86(f: MFuncX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if block_makes_call_x86(f.blocks[i]) { found = true; break }
        i++
    }
    found
}

/**
 * block_any_ret_x86 — whether one block contains a return terminator
 * (`MRetX86`), the block-level fold `func_any_ret_x86` walks over every block
 * (the x86 mirror of arm64's `block_any_ret`).
 *
 * @param MBlockX86 b  the block to scan
 * @return bool  true iff `b` contains an `MRetX86`
 */
fn block_any_ret_x86(b: MBlockX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= b.insts.len { break }
        if is_ret_x86(b.insts[i]) { found = true; break }
        i++
    }
    found
}

/**
 * func_any_ret_x86 — whether the physical `MFuncX86` contains any `MRetX86`, so
 * `needs_call_align_x86` can tell a function that CALLS AND RETURNS (whose own
 * call sites need proper 16-byte alignment restored) from one that calls only
 * as its own divergent tail (`ex_func_frameless_call_reloc`'s own `tk_exit`
 * shape — a call with no `MRet` anywhere, whose alignment this backend has
 * never needed to restore because nothing after it ever runs). The x86 mirror
 * of arm64's `func_any_ret`.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff the function contains an `MRetX86`
 */
fn func_any_ret_x86(f: MFuncX86) -> bool {
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        if block_any_ret_x86(f.blocks[i]) { found = true; break }
        i++
    }
    found
}

/**
 * needs_call_align_x86 — whether a function that would otherwise be frameless
 * (zero local slots, zero callee-saved registers) still needs a minimal
 * `push rbp`/`mov rbp,rsp` prologue for ONE reason alone: restoring the
 * SysV 16-byte call-boundary alignment before the calls IT ITSELF issues.
 *
 * SysV guarantees `rsp+8` is a multiple of 16 at every function's OWN entry
 * (the caller's `call` having just pushed an 8-byte return address) — so a
 * function that does ZERO stack adjustment before issuing a `call` of its own
 * hands that callee a stack off by 8 from the alignment the ABI promises it.
 * A single `push rbp` (no `sub rsp` needed) restores the missing 8 bytes at
 * no extra cost, exactly as it would for any other framed function.
 *
 * Scoped to a function that ALSO RETURNS (`func_any_ret_x86`), mirroring
 * arm64's own `needs_lr_save` reasoning exactly (`func_any_call(f) &&
 * func_any_ret(f)`): a function whose only calls are its own divergent tail
 * (`ex_func_frameless_call_reloc`'s `tk_exit` case) never returns to
 * observe — or make — a misaligned call after that point, so the existing
 * frameless encoding for THAT shape is untouched, byte for byte.
 *
 * Found live (0.3.1.0 degrau 19): the native entry stub `wrap_native_entry`
 * appends (`argc`/`argv` -> `tk_set_args` -> the renamed virtual-main -> its
 * own `ret`) has no local slots and clobbers no callee-saved register, so it
 * was the ONE function in a self-built compiler with zero slots/saves that
 * still calls AND returns — every other function either needs a slot/save of
 * its own or (like a bare `exit(n)` program body) never returns. The
 * resulting off-by-8 stack silently reached every call this stub makes
 * without symptom until a callee's OWN call chain used a strictly
 * 16-byte-aligned store deep inside (glibc's `vsnprintf` internals, first
 * exercised natively by this degrau's `tk_fmt_d_len`/`tk_fmt_n_i_len` twins) —
 * a SIGSEGV inside `__printf_buffer_init`, several frames below the actual
 * misalignment.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return bool  true iff a minimal alignment-only prologue/epilogue is needed
 */
fn needs_call_align_x86(f: MFuncX86) -> bool {
    func_makes_call_x86(f) && func_any_ret_x86(f)
}

/**
 * shadow_bytes_x86 — the Win64 caller-reserved shadow-space contribution to a
 * function's frame: `abi.shadow_space` when the register file reserves shadow
 * space (Win64: 32) AND the function makes a call (a callee expects 32 bytes to
 * spill its four register args), else 0. Every non-Win64 ABI leaves
 * `shadow_space` 0, so this returns 0 and the frame bytes stay byte-identical to
 * SysV/AAPCS64/LP64D (the FIXPOINT guardrail, §2.2); a Win64 LEAF (no call) also
 * returns 0, so it is frameless when it has no slots/callee-saved (§4.2).
 *
 * @param AbiDescriptor abi  the register file (its `shadow_space` field)
 * @param MFuncX86 f  the fully-physical function (scanned for a call)
 * @return u32  the shadow bytes to fold into the frame (32 for a calling Win64 function, else 0)
 */
fn shadow_bytes_x86(abi: AbiDescriptor, f: MFuncX86) -> u32 {
    if abi.shadow_space == (0 to u32) { return 0 to u32 }
    if !func_makes_call_x86(f) { return 0 to u32 }
    abi.shadow_space
}

/**
 * out_arg_bytes_x86 — the byte size of the outgoing stack-argument region a
 * function's frame must reserve (`B1-args`): 8 bytes per slot up to the highest
 * `MOutArgX86{index}` the block stream contains, rounded up to the 16-byte stack
 * alignment, or 0 when the function passes every argument in a register. Derived
 * by SCANNING the finished stream rather than carried on `MFuncX86`, exactly as
 * the callee-saved set and the shadow reservation already are, so isel stays free
 * of frame arithmetic.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return u32  the 16-aligned outgoing stack-argument region size in bytes
 */
fn out_arg_bytes_x86(f: MFuncX86) -> u32 {
    let n = max_out_arg_slots_x86(f)
    if n == (0 to u32) { return 0 to u32 }
    align_up(n * X86_GPR_BYTES, X86_STACK_ALIGN)
}

/**
 * max_out_arg_slots_x86 — how many outgoing stack-argument slots the function's
 * widest call needs: one past the highest `MOutArgX86{index}` in the stream, or 0
 * when there is none.
 *
 * @param MFuncX86 f  the fully-physical function
 * @return u32  the outgoing stack-argument slot count
 */
fn max_out_arg_slots_x86(f: MFuncX86) -> u32 {
    mut slots: u32 = 0
    mut bi: u64 = 0
    loop {
        if bi >= f.blocks.len { break }
        let b = f.blocks[bi]
        mut ii: u64 = 0
        loop {
            if ii >= b.insts.len { break }
            let need = out_arg_slots_of_inst_x86(b.insts[ii])
            if need > slots { slots = need }
            ii++
        }
        bi++
    }
    slots
}
