const BYTE_MASK: u64 = 0xFF

const LEB_LOW7: u64 = 0x7F

const LEB_MORE: u64 = 0x80

const SLEB_SIGN: i64 = 0x40

const SLEB_LOW7: i64 = 0x7F

const SLEB_MORE: i64 = 0x80

fn emit_byte(buf: []byte, v: u64): []byte {
    teko::list::push(buf, (v & BYTE_MASK) to byte)
}

fn emit_u16_le(buf: []byte, v: u64): []byte {
    var b0 = emit_byte(buf, v)
    emit_byte(b0, v >> 8)
}

fn emit_u32_le_dw(buf: []byte, v: u64): []byte {
    var b = emit_byte(buf, v)
    b = emit_byte(b, v >> 8)
    b = emit_byte(b, v >> 16)
    emit_byte(b, v >> 24)
}

fn emit_u64_le_dw(buf: []byte, v: u64): []byte {
    var b = buf
    var shift: u64 = 0
    loop {
        if shift >= 64 { break }
        b = emit_byte(b, v >> shift)
        shift = shift + 8
    }
    b
}

fn emit_addr_slot(buf: []byte): []byte {
    emit_u64_le_dw(buf, 0 to u64)
}

fn emit_cstr(buf: []byte, s: str): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        b = teko::list::push(b, s[i])
        i = i + 1
    }
    teko::list::push(b, 0 to byte)
}

pub fn uleb128(buf: []byte, v: u64): []byte {
    var b = buf
    var val = v
    loop {
        var group = val & LEB_LOW7
        val = val >> 7
        if val != 0 {
            b = teko::list::push(b, (group | LEB_MORE) to byte)
        } else {
            b = teko::list::push(b, group to byte)
            break
        }
    }
    b
}

pub fn sleb128(buf: []byte, v: i64): []byte {
    var b = buf
    var val = v
    loop {
        var group = val & SLEB_LOW7
        val = val >> 7
        var sign_set = (group & SLEB_SIGN) != 0
        var done = (val == 0 && !sign_set) || (val == -1 && sign_set)
        if done {
            b = teko::list::push(b, group to byte)
            break
        }
        b = teko::list::push(b, (group | SLEB_MORE) to byte)
    }
    b
}

pub type DwReloc = struct {
    offset: u64
    symbol: str
}

pub type DwSection = struct {
    bytes: []byte
    relocs: []DwReloc
}

pub type DwSubprogram = struct {
    name: str
    decl_file: i64
    decl_line: u32
    symbol: str
    code_size: u64
}

pub type DwCompileUnit = struct {
    producer: str
    language: u32
    name: str
    comp_dir: str
    text_symbol: str
    text_size: u64
    subprograms: []DwSubprogram
}

pub type DwLineRow = struct {
    pc_advance: u64
    line: u32
    file: i64
}

const DW_TAG_COMPILE_UNIT: u64 = 0x11

const DW_TAG_SUBPROGRAM: u64 = 0x2e

const DW_TAG_BASE_TYPE: u64 = 0x24

const DW_TAG_FORMAL_PARAMETER: u64 = 0x05

const DW_TAG_VARIABLE: u64 = 0x34

const DW_TAG_LEXICAL_BLOCK: u64 = 0x0b

const DW_OP_FBREG: u64 = 0x91

const ABBREV_FORMAL_PARAMETER: u64 = 4

const ABBREV_VARIABLE: u64 = 5

pub const DW_ATE_BOOLEAN: u64 = 0x02

pub const DW_ATE_SIGNED: u64 = 0x05

pub const DW_ATE_UNSIGNED: u64 = 0x07

pub const DW_ATE_FLOAT: u64 = 0x04

pub const DW_OP_REG6_RBP_PLACEHOLDER: u64 = 0x56

pub fn debug_abbrev(): []byte {
    var b: []byte = teko::list::empty()
    b = uleb128(b, 1 to u64)
    b = uleb128(b, DW_TAG_COMPILE_UNIT)
    b = teko::list::push(b, 0x01 to byte)
    b = emit_pair(b, 0x25, 0x08)
    b = emit_pair(b, 0x13, 0x05)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x1b, 0x08)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x10, 0x17)
    b = emit_pair(b, 0x00, 0x00)
    b = uleb128(b, 2 to u64)
    b = uleb128(b, DW_TAG_SUBPROGRAM)
    b = teko::list::push(b, 0x00 to byte)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x3a, 0x0d)
    b = emit_pair(b, 0x3b, 0x05)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x3f, 0x19)
    b = emit_pair(b, 0x00, 0x00)
    teko::list::push(b, 0x00 to byte)
}

fn emit_pair(buf: []byte, attr: u64, form: u64): []byte {
    var b0 = teko::list::push(buf, attr to byte)
    teko::list::push(b0, form to byte)
}

fn emit_subprogram_die(body: []byte, relocs: []DwReloc, base_off: u64, sub: DwSubprogram): DwSection {
    var b = teko::list::push(body, 0x02 to byte)
    b = emit_cstr(b, sub.name)
    b = sleb128(b, sub.decl_file)
    b = emit_u16_le(b, sub.decl_line to u64)
    var low_pc_off = base_off + b.len
    b = emit_addr_slot(b)
    var r = teko::list::push(relocs, DwReloc { offset = low_pc_off; symbol = sub.symbol })
    b = emit_u64_le_dw(b, sub.code_size)
    DwSection { bytes = b; relocs = r }
}

pub fn debug_info(cu: DwCompileUnit): DwSection {
    var relocs: []DwReloc = teko::list::empty()
    var body: []byte = teko::list::empty()
    body = teko::list::push(body, 0x01 to byte)
    body = emit_cstr(body, cu.producer)
    body = emit_u16_le(body, cu.language to u64)
    body = emit_cstr(body, cu.name)
    body = emit_cstr(body, cu.comp_dir)
    var cu_low_pc_off = header_len_prefix() + body.len
    body = emit_addr_slot(body)
    relocs = teko::list::push(relocs, DwReloc { offset = cu_low_pc_off; symbol = cu.text_symbol })
    body = emit_u64_le_dw(body, cu.text_size)
    body = emit_u32_le_dw(body, 0 to u64)
    var i: u64 = 0
    loop {
        if i >= cu.subprograms.len { break }
        var child = emit_subprogram_die(body, relocs, header_len_prefix(), cu.subprograms[i])
        body = child.bytes
        relocs = child.relocs
        i = i + 1
    }
    body = teko::list::push(body, 0x00 to byte)
    var unit_length = body.len + 2 + 4 + 1
    var out: []byte = teko::list::empty()
    out = emit_u32_le_dw(out, unit_length)
    out = emit_u16_le(out, 4 to u64)
    out = emit_u32_le_dw(out, 0 to u64)
    out = teko::list::push(out, 0x08 to byte)
    out = append_bytes_dw(out, body)
    DwSection { bytes = out; relocs = relocs }
}

fn header_len_prefix(): u64 {
    11 to u64
}

fn append_bytes_dw(dst: []byte, src: []byte): []byte {
    var b = dst
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        b = teko::list::push(b, src[i])
        i = i + 1
    }
    b
}

fn line_header_body(files: []str): []byte {
    var b: []byte = teko::list::empty()
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0xfb to byte)
    b = teko::list::push(b, 0x0e to byte)
    b = teko::list::push(b, 0x0d to byte)
    b = append_std_opcode_lengths(b)
    b = teko::list::push(b, 0x00 to byte)
    b = append_file_entries(b, files)
    teko::list::push(b, 0x00 to byte)
}

fn append_file_entries(buf: []byte, files: []str): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        b = emit_cstr(b, files[i])
        b = uleb128(b, 0 to u64)
        b = uleb128(b, 0 to u64)
        b = uleb128(b, 0 to u64)
        i = i + 1
    }
    b
}

fn append_std_opcode_lengths(buf: []byte): []byte {
    var lens: []u64 = [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]
    var b = buf
    var i: u64 = 0
    loop {
        if i >= lens.len { break }
        b = teko::list::push(b, lens[i] to byte)
        i = i + 1
    }
    b
}

const DW_LNS_COPY: u64 = 0x01

const DW_LNS_ADVANCE_PC: u64 = 0x02

const DW_LNS_ADVANCE_LINE: u64 = 0x03

const DW_LNS_SET_FILE: u64 = 0x04

const DW_LNS_SET_COLUMN: u64 = 0x05

const LINE_FIRST_FILE: i64 = 1

fn emit_line_row(prog: []byte, row: DwLineRow, prev: u32, cur_file: i64, first: bool): []byte {
    var b = prog
    if !first {
        b = teko::list::push(b, DW_LNS_ADVANCE_PC to byte)
        b = uleb128(b, row.pc_advance)
    }
    if row.file != cur_file {
        b = teko::list::push(b, DW_LNS_SET_FILE to byte)
        b = uleb128(b, row.file to u64)
    }
    b = teko::list::push(b, DW_LNS_ADVANCE_LINE to byte)
    b = sleb128(b, (row.line to i64) - (prev to i64))
    if first {
        b = teko::list::push(b, DW_LNS_SET_COLUMN to byte)
        b = uleb128(b, 1 to u64)
    }
    teko::list::push(b, DW_LNS_COPY to byte)
}

pub fn debug_line(files: []str, start_symbol: str, rows: []DwLineRow, final_pc_advance: u64): DwSection {
    var header = line_header_body(files)
    var prog: []byte = teko::list::empty()
    prog = teko::list::push(prog, 0x00 to byte)
    prog = teko::list::push(prog, 0x09 to byte)
    prog = teko::list::push(prog, 0x02 to byte)
    var set_addr_slot = line_prefix_len() + header.len + prog.len
    prog = emit_addr_slot(prog)
    var prev: u32 = 1
    var cur_file: i64 = LINE_FIRST_FILE
    var i: u64 = 0
    loop {
        if i >= rows.len { break }
        prog = emit_line_row(prog, rows[i], prev, cur_file, i == 0)
        prev = rows[i].line
        cur_file = rows[i].file
        i = i + 1
    }
    prog = teko::list::push(prog, DW_LNS_ADVANCE_PC to byte)
    prog = uleb128(prog, final_pc_advance)
    prog = teko::list::push(prog, 0x00 to byte)
    prog = teko::list::push(prog, 0x01 to byte)
    prog = teko::list::push(prog, 0x01 to byte)
    var header_length = header.len
    var unit_length = header.len + prog.len + 2 + 4
    var out: []byte = []
    out = emit_u32_le_dw(out, unit_length)
    out = emit_u16_le(out, 4 to u64)
    out = emit_u32_le_dw(out, header_length)
    out = append_bytes_dw(out, header)
    out = append_bytes_dw(out, prog)
    var relocs = [DwReloc { offset = set_addr_slot; symbol = start_symbol }]
    DwSection { bytes = out; relocs = relocs }
}

fn line_prefix_len(): u64 {
    10 to u64
}

pub type DwarfSink = struct {
    present: bool
    abbrev: []byte
    info: DwSection
    line: DwSection
}

fn empty_dw_section(): DwSection {
    DwSection { bytes = []; relocs = [] }
}

pub fn no_dwarf_sink(): DwarfSink {
    DwarfSink { present = false; abbrev = []; info = empty_dw_section(); line = empty_dw_section() }
}

pub fn build_dwarf_sink(cu: DwCompileUnit, files: []str, rows: []DwLineRow, final_pc_advance: u64): DwarfSink {
    DwarfSink {
        present = true
        abbrev = debug_abbrev()
        info = debug_info(cu)
        line = debug_line(files, cu.text_symbol, rows, final_pc_advance)
    }
}

pub type DwBaseType = struct {
    name: str
    byte_size: u64
    encoding: u64
}

pub type DwBaseTypeLookup = struct {
    found: bool
    base_type: DwBaseType
}

fn dw_bt_found(name: str, byte_size: u64, encoding: u64): DwBaseTypeLookup {
    DwBaseTypeLookup { found = true; base_type = DwBaseType { name = name; byte_size = byte_size; encoding = encoding } }
}

fn dw_bt_not_found(): DwBaseTypeLookup {
    DwBaseTypeLookup { found = false; base_type = DwBaseType { name = ""; byte_size = 0 to u64; encoding = 0 to u64 } }
}

pub fn frozen_base_type(name: str): DwBaseTypeLookup {
    if name == "bool" { return dw_bt_found(name, 1 to u64, DW_ATE_BOOLEAN) }
    if name == "byte" { return dw_bt_found(name, 1 to u64, DW_ATE_UNSIGNED) }
    if name == "u8" { return dw_bt_found(name, 1 to u64, DW_ATE_UNSIGNED) }
    if name == "u16" { return dw_bt_found(name, 2 to u64, DW_ATE_UNSIGNED) }
    if name == "u32" { return dw_bt_found(name, 4 to u64, DW_ATE_UNSIGNED) }
    if name == "u64" { return dw_bt_found(name, 8 to u64, DW_ATE_UNSIGNED) }
    if name == "i8" { return dw_bt_found(name, 1 to u64, DW_ATE_SIGNED) }
    if name == "i16" { return dw_bt_found(name, 2 to u64, DW_ATE_SIGNED) }
    if name == "i32" { return dw_bt_found(name, 4 to u64, DW_ATE_SIGNED) }
    if name == "i64" { return dw_bt_found(name, 8 to u64, DW_ATE_SIGNED) }
    if name == "f32" { return dw_bt_found(name, 4 to u64, DW_ATE_FLOAT) }
    if name == "f64" { return dw_bt_found(name, 8 to u64, DW_ATE_FLOAT) }
    if name == "usize" { return dw_bt_found(name, 8 to u64, DW_ATE_UNSIGNED) }
    if name == "size" { return dw_bt_found(name, 8 to u64, DW_ATE_SIGNED) }
    dw_bt_not_found()
}

pub type DwLocal = struct {
    name: str
    is_param: bool
    type_index: u64
    fbreg_offset: i64
}

pub type DwScope = struct {
    locals: []DwLocal
}

pub type DwSubprogramLocals = struct {
    name: str
    decl_file: i64
    decl_line: u32
    symbol: str
    code_size: u64
    frame_base_op: u64
    params: []DwLocal
    locals: []DwLocal
    blocks: []DwScope
}

pub type DwLocalsUnit = struct {
    producer: str
    language: u32
    name: str
    comp_dir: str
    text_symbol: str
    text_size: u64
    base_types: []DwBaseType
    subprograms: []DwSubprogramLocals
}

pub type DwLocalsInfo = struct {
    section: DwSection
    base_type_offsets: []u64
}

pub fn debug_abbrev_locals(): []byte {
    var b = emit_abbrev_compile_unit([])
    b = emit_abbrev_base_type(b)
    b = emit_abbrev_subprogram_locals(b)
    b = emit_abbrev_leaf_local(b, ABBREV_FORMAL_PARAMETER, DW_TAG_FORMAL_PARAMETER)
    b = emit_abbrev_leaf_local(b, ABBREV_VARIABLE, DW_TAG_VARIABLE)
    b = emit_abbrev_lexical_block(b)
    teko::list::push(b, 0x00 to byte)
}

fn emit_abbrev_compile_unit(buf: []byte): []byte {
    var b = uleb128(buf, 1 to u64)
    b = uleb128(b, DW_TAG_COMPILE_UNIT)
    b = teko::list::push(b, 0x01 to byte)
    b = emit_pair(b, 0x25, 0x08)
    b = emit_pair(b, 0x13, 0x05)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x1b, 0x08)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x10, 0x17)
    emit_pair(b, 0x00, 0x00)
}

fn emit_abbrev_base_type(buf: []byte): []byte {
    var b = uleb128(buf, 2 to u64)
    b = uleb128(b, DW_TAG_BASE_TYPE)
    b = teko::list::push(b, 0x00 to byte)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x3e, 0x0b)
    b = emit_pair(b, 0x0b, 0x0b)
    emit_pair(b, 0x00, 0x00)
}

fn emit_abbrev_subprogram_locals(buf: []byte): []byte {
    var b = uleb128(buf, 3 to u64)
    b = uleb128(b, DW_TAG_SUBPROGRAM)
    b = teko::list::push(b, 0x01 to byte)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x3a, 0x0d)
    b = emit_pair(b, 0x3b, 0x05)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x40, 0x18)
    b = emit_pair(b, 0x3f, 0x19)
    emit_pair(b, 0x00, 0x00)
}

fn emit_abbrev_leaf_local(buf: []byte, code: u64, tag: u64): []byte {
    var b = uleb128(buf, code)
    b = uleb128(b, tag)
    b = teko::list::push(b, 0x00 to byte)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x49, 0x13)
    b = emit_pair(b, 0x02, 0x18)
    emit_pair(b, 0x00, 0x00)
}

fn emit_abbrev_lexical_block(buf: []byte): []byte {
    var b = uleb128(buf, 6 to u64)
    b = uleb128(b, DW_TAG_LEXICAL_BLOCK)
    b = teko::list::push(b, 0x01 to byte)
    emit_pair(b, 0x00, 0x00)
}

pub fn debug_info_locals(cu: DwLocalsUnit): DwLocalsInfo {
    var relocs: []DwReloc = teko::list::empty()
    var body: []byte = [0x01 to byte]
    body = emit_cstr(body, cu.producer)
    body = emit_u16_le(body, cu.language to u64)
    body = emit_cstr(body, cu.name)
    body = emit_cstr(body, cu.comp_dir)
    var cu_low_pc_off = header_len_prefix() + body.len
    body = emit_addr_slot(body)
    relocs = teko::list::push(relocs, DwReloc { offset = cu_low_pc_off; symbol = cu.text_symbol })
    body = emit_u64_le_dw(body, cu.text_size)
    body = emit_u32_le_dw(body, 0 to u64)
    var base_type_offsets: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= cu.base_types.len { break }
        base_type_offsets = teko::list::push(base_type_offsets, header_len_prefix() + body.len)
        body = emit_base_type_die(body, cu.base_types[i])
        i = i + 1
    }
    i = 0
    loop {
        if i >= cu.subprograms.len { break }
        var child = emit_locals_subprogram(body, relocs, cu.subprograms[i], base_type_offsets)
        body = child.bytes
        relocs = child.relocs
        i = i + 1
    }
    body = teko::list::push(body, 0x00 to byte)
    var unit_length = body.len + 2 + 4 + 1
    var out: []byte = emit_u32_le_dw([], unit_length)
    out = emit_u16_le(out, 4 to u64)
    out = emit_u32_le_dw(out, 0 to u64)
    out = teko::list::push(out, 0x08 to byte)
    out = append_bytes_dw(out, body)
    DwLocalsInfo { section = DwSection { bytes = out; relocs = relocs }; base_type_offsets = base_type_offsets }
}

fn emit_base_type_die(body: []byte, bt: DwBaseType): []byte {
    var b = teko::list::push(body, 0x02 to byte)
    b = emit_cstr(b, bt.name)
    b = teko::list::push(b, bt.encoding to byte)
    teko::list::push(b, bt.byte_size to byte)
}

fn emit_locals_subprogram(body: []byte, relocs: []DwReloc, sub: DwSubprogramLocals, base_type_offsets: []u64): DwSection {
    var b = teko::list::push(body, 0x03 to byte)
    b = emit_cstr(b, sub.name)
    b = sleb128(b, sub.decl_file)
    b = emit_u16_le(b, sub.decl_line to u64)
    var low_pc_off = header_len_prefix() + b.len
    b = emit_addr_slot(b)
    var r = teko::list::push(relocs, DwReloc { offset = low_pc_off; symbol = sub.symbol })
    b = emit_u64_le_dw(b, sub.code_size)
    b = emit_frame_base(b, sub.frame_base_op)
    b = emit_local_list(b, sub.params, base_type_offsets)
    b = emit_local_list(b, sub.locals, base_type_offsets)
    b = emit_scope_list(b, sub.blocks, base_type_offsets)
    b = teko::list::push(b, 0x00 to byte)
    DwSection { bytes = b; relocs = r }
}

fn emit_frame_base(buf: []byte, op: u64): []byte {
    var b = uleb128(buf, 1 to u64)
    teko::list::push(b, op to byte)
}

fn emit_local_list(buf: []byte, locals: []DwLocal, base_type_offsets: []u64): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= locals.len { break }
        b = emit_local_die(b, locals[i], base_type_offsets)
        i = i + 1
    }
    b
}

fn emit_local_die(buf: []byte, local: DwLocal, base_type_offsets: []u64): []byte {
    var b = teko::list::push(buf, local_abbrev_code(local.is_param) to byte)
    b = emit_cstr(b, local.name)
    b = emit_u32_le_dw(b, base_type_offsets[local.type_index])
    emit_fbreg_location(b, local.fbreg_offset)
}

fn local_abbrev_code(is_param: bool): u64 {
    if is_param { return ABBREV_FORMAL_PARAMETER }
    ABBREV_VARIABLE
}

fn emit_fbreg_location(buf: []byte, offset: i64): []byte {
    var expr = [DW_OP_FBREG to byte]
    expr = sleb128(expr, offset)
    var b = uleb128(buf, expr.len)
    append_bytes_dw(b, expr)
}

fn emit_scope_list(buf: []byte, scopes: []DwScope, base_type_offsets: []u64): []byte {
    var b = buf
    var i: u64 = 0
    loop {
        if i >= scopes.len { break }
        b = emit_scope_block(b, scopes[i], base_type_offsets)
        i = i + 1
    }
    b
}

fn emit_scope_block(buf: []byte, scope: DwScope, base_type_offsets: []u64): []byte {
    var b = teko::list::push(buf, 0x06 to byte)
    b = emit_local_list(b, scope.locals, base_type_offsets)
    teko::list::push(b, 0x00 to byte)
}
