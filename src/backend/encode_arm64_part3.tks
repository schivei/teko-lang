fn emit_frame_mem(words0: []u32, ids: []u32, base: u32, is_fpr: bool, is_store: bool) -> []u32 {
    mut words = words0
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        let off = base + ((i to u32) * ARM64_REG_BYTES)
        let has_pair = (i + 1) < ids.len
        if has_pair {
            words = teko::list::push(words, pair_frame_word(ids[i], ids[i + 1], off / ARM64_REG_BYTES, is_fpr, is_store))
            i = i + 2
        } else {
            words = teko::list::push(words, single_frame_word(ids[i], off / ARM64_REG_BYTES, is_fpr, is_store))
            i = i + 1
        }
    }
    words
}

/**
 * callee_base_offset — the SP byte offset of the first callee-saved register,
 * placed directly below the FP/LR pair (which sits in the top 16 bytes), so any
 * 16-alignment padding falls between the slot region and this save area.
 *
 * @param FrameLayout layout  the resolved frame (size > 0)
 * @return u32  the SP offset of the first callee-saved register
 */
fn callee_base_offset(layout: FrameLayout) -> u32 {
    let n = (layout.saved_gpr.len + layout.saved_fpr.len) to u32
    (layout.size - ARM64_FP_LR_BYTES) - (n * ARM64_REG_BYTES)
}

/**
 * emit_callee_area — append the callee-saved save (or restore) words: the GPR
 * list first, then the FPR list immediately above it, each class pair-packed.
 *
 * @param []u32 words0  the word buffer to extend
 * @param FrameLayout layout  the resolved frame (size > 0)
 * @param bool is_store  true for saves (prologue), false for restores (epilogue)
 * @return []u32  `words0` followed by the callee-saved words
 */
fn emit_callee_area(words0: []u32, layout: FrameLayout, is_store: bool) -> []u32 {
    let base = callee_base_offset(layout)
    let after_gpr = emit_frame_mem(words0, layout.saved_gpr, base, false, is_store)
    let fpr_base = base + ((layout.saved_gpr.len to u32) * ARM64_REG_BYTES)
    emit_frame_mem(after_gpr, layout.saved_fpr, fpr_base, true, is_store)
}

/**
 * emit_frame_mem_single — append the save (or restore) words for one register
 * class's callee-saved list as INDIVIDUAL STR/LDR (never STP/LDP), one per id
 * at `base + i*8`: the big-frame prologue/epilogue's counterpart of
 * `emit_frame_mem`, whose offsets can exceed the STP/LDP imm7 field while
 * still fitting the STR/LDR unsigned 12-bit scaled field (`big_frame_fits`).
 *
 * @param []u32 words0  the word buffer to extend
 * @param []u32 ids  the class's ascending callee-saved ids
 * @param u32 base  the SP byte offset of the first id
 * @param bool is_fpr  true for the FP register family
 * @param bool is_store  true for saves (prologue), false for restores (epilogue)
 * @return []u32  `words0` followed by the class's individual save/restore words
 */
fn emit_frame_mem_single(words0: []u32, ids: []u32, base: u32, is_fpr: bool, is_store: bool) -> []u32 {
    mut words = words0
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        let off = base + ((i to u32) * ARM64_REG_BYTES)
        words = teko::list::push(words, single_frame_word(ids[i], off / ARM64_REG_BYTES, is_fpr, is_store))
        i++
    }
    words
}

/**
 * emit_callee_area_single — append the callee-saved save (or restore) words
 * as individual STR/LDR (the big-frame prologue/epilogue counterpart of
 * `emit_callee_area`): the GPR list first, then the FPR list immediately
 * above it, neither ever paired.
 *
 * @param []u32 words0  the word buffer to extend
 * @param FrameLayout layout  the resolved frame (size > 0)
 * @param bool is_store  true for saves (prologue), false for restores (epilogue)
 * @return []u32  `words0` followed by the callee-saved words
 */
fn emit_callee_area_single(words0: []u32, layout: FrameLayout, is_store: bool) -> []u32 {
    let base = callee_base_offset(layout)
    let after_gpr = emit_frame_mem_single(words0, layout.saved_gpr, base, false, is_store)
    let fpr_base = base + ((layout.saved_gpr.len to u32) * ARM64_REG_BYTES)
    emit_frame_mem_single(after_gpr, layout.saved_fpr, fpr_base, true, is_store)
}

/**
 * append_u32_words — append every word of `xs` to `buf`, in order: the
 * chained-instruction-sequence concatenation `emit_prologue_big`/
 * `emit_epilogue_big` use to fold `big_offset_words`'s one-or-two-word result
 * into the running word buffer.
 *
 * @param []u32 buf  the word buffer to extend
 * @param []u32 xs  the words to append
 * @return []u32  `buf` followed by `xs`
 */
fn append_u32_words(buf: []u32, xs: []u32) -> []u32 {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        b = teko::list::push(b, xs[i])
        i++
    }
    b
}

/**
 * frame_fits — whether the FP/LR store-pair offset (the largest pair offset,
 * `size - 16`) fits the signed 7-bit scaled field. When it does, every smaller
 * pair/slot offset fits too, so this single check guards the SMALL
 * prologue/epilogue path (`emit_prologue_small`/`emit_epilogue_small`), the
 * byte-for-byte-unchanged shape every frame used before the big-frame
 * sequence existed.
 *
 * @param FrameLayout layout  the resolved frame (size > 0)
 * @return bool  true iff the frame's offsets fit the STP/LDP field
 */
fn frame_fits(layout: FrameLayout) -> bool {
    ((layout.size - ARM64_FP_LR_BYTES) / ARM64_REG_BYTES) <= ARM64_IMM7_MAX_POS
}

/**
 * big_frame_fits — whether a frame too large for `frame_fits` (the STP/LDP
 * imm7 field) can still be materialized by the BIG prologue/epilogue
 * sequence: every individual STR/LDR save/restore offset (bounded above by
 * `size - FP_LR_BYTES`, the largest one) must fit the STR/LDR unsigned 12-bit
 * SCALED field. Past this, `emit_prologue_big`/`emit_epilogue_big` raise
 * `A4-bigframe` — an unrealistically large (32KB+) frame.
 *
 * @param FrameLayout layout  the resolved frame (size > 0)
 * @return bool  true iff the big-frame sequence can materialize every offset
 */
fn big_frame_fits(layout: FrameLayout) -> bool {
    (layout.size - ARM64_FP_LR_BYTES) <= ARM64_STR_LDR_FIELD_MAX_BYTES
}

/**
 * emit_prologue_small — the ORIGINAL entry sequence for a frame whose FP/LR
 * pair offset fits the STP field (`frame_fits`): `sub sp, sp, #size`; `stp
 * x29, x30, [sp, #size-16]`; `add x29, sp, #size-16` (set FP); then one save
 * per callee-saved pair/single. Byte-for-byte identical to every frame this
 * encoder produced before the big-frame sequence existed.
 *
 * @param FrameLayout layout  the resolved frame (size > 0, `frame_fits`)
 * @return []u32  the prologue words
 */
fn emit_prologue_small(layout: FrameLayout) -> []u32 {
    let top = layout.size - ARM64_FP_LR_BYTES
    mut words: []u32 = teko::list::empty()
    words = teko::list::push(words, sub_sp_imm_word(layout.size))
    words = teko::list::push(words, stp_gpr(ARM64_FP_ID, ARM64_LR_ID, top / ARM64_REG_BYTES))
    words = teko::list::push(words, add_sp_imm_word(ARM64_FP_ID, top))
    emit_callee_area(words, layout, true)
}

/**
 * emit_epilogue_small — the ORIGINAL frame-teardown sequence (LIFO) for a
 * frame whose FP/LR pair offset fits the STP field (`frame_fits`): restore
 * the callee-saved registers; `ldp x29, x30, [sp, #size-16]`; `add sp, sp,
 * #size`. Byte-for-byte identical to every frame this encoder produced
 * before the big-frame sequence existed.
 *
 * @param FrameLayout layout  the resolved frame (size > 0, `frame_fits`)
 * @return []u32  the teardown words (RET excluded)
 */
fn emit_epilogue_small(layout: FrameLayout) -> []u32 {
    let top = layout.size - ARM64_FP_LR_BYTES
    mut words: []u32 = emit_callee_area(teko::list::empty(), layout, false)
    words = teko::list::push(words, ldp_gpr(ARM64_FP_ID, ARM64_LR_ID, top / ARM64_REG_BYTES))
    words = teko::list::push(words, add_sp_imm_word(ARM64_SP_ID, layout.size))
    words
}

/**
 * emit_prologue_big — the BIG-frame entry sequence, for a frame whose FP/LR
 * pair offset outruns the STP field (`!frame_fits`): `sub sp, sp, #size`
 * (chained when `size` itself needs it, `big_offset_words`); `str x29, [sp,
 * #top]` ; `str x30, [sp, #top+8]` (INDIVIDUAL, never `stp` — `top` can
 * exceed the imm7 field while still fitting STR's wider scaled field); `add
 * x29, sp, #top` (chained when needed); then one individual save per
 * callee-saved register (`emit_callee_area_single`, never paired). Raises
 * `A4-bigframe` when even the STR/LDR field cannot hold `top`
 * (`!big_frame_fits`, an unrealistically large frame).
 *
 * @param FrameLayout layout  the resolved frame (size > 0, `!frame_fits`)
 * @return []u32 | error  the big-frame prologue words, or `A4-bigframe`
 */
fn emit_prologue_big(layout: FrameLayout) -> []u32 | error {
    if !big_frame_fits(layout) { return honest_bigframe() }
    let size = layout.size
    let top = size - ARM64_FP_LR_BYTES
    let sub_words = match big_offset_words(ARM64_SP_ID, ARM64_SP_ID, size, true) { []u32 as w => w; error as e => return e }
    mut words: []u32 = sub_words
    words = teko::list::push(words, str_gpr_sp(ARM64_FP_ID, top / ARM64_REG_BYTES))
    words = teko::list::push(words, str_gpr_sp(ARM64_LR_ID, (top + ARM64_REG_BYTES) / ARM64_REG_BYTES))
    let fp_words = match big_offset_words(ARM64_SP_ID, ARM64_FP_ID, top, false) { []u32 as w => w; error as e => return e }
    words = append_u32_words(words, fp_words)
    emit_callee_area_single(words, layout, true)
}

/**
 * emit_epilogue_big — the BIG-frame teardown sequence (LIFO), the
 * counterpart of `emit_prologue_big`: restore the callee-saved registers
 * INDIVIDUALLY (`emit_callee_area_single`); `ldr x29, [sp, #top]` ; `ldr x30,
 * [sp, #top+8]` (individual, never `ldp`); `add sp, sp, #size` (chained when
 * needed). The `RET` itself is the `MRet` encoding, emitted immediately after
 * by the function-encode layer. Raises `A4-bigframe` when even the STR/LDR
 * field cannot hold `top`.
 *
 * @param FrameLayout layout  the resolved frame (size > 0, `!frame_fits`)
 * @return []u32 | error  the big-frame teardown words (RET excluded), or `A4-bigframe`
 */
fn emit_epilogue_big(layout: FrameLayout) -> []u32 | error {
    if !big_frame_fits(layout) { return honest_bigframe() }
    let size = layout.size
    let top = size - ARM64_FP_LR_BYTES
    mut words: []u32 = emit_callee_area_single(teko::list::empty(), layout, false)
    words = teko::list::push(words, ldr_gpr_sp(ARM64_FP_ID, top / ARM64_REG_BYTES))
    words = teko::list::push(words, ldr_gpr_sp(ARM64_LR_ID, (top + ARM64_REG_BYTES) / ARM64_REG_BYTES))
    let add_words = match big_offset_words(ARM64_SP_ID, ARM64_SP_ID, size, false) { []u32 as w => w; error as e => return e }
    append_u32_words(words, add_words)
}

/**
 * emit_prologue — the function's entry sequence, or an empty list for a
 * frameless function: the ORIGINAL byte-for-byte `emit_prologue_small` shape
 * when the frame fits the STP field, else the `emit_prologue_big` sequence
 * (A4-2's big-frame fast-follow) for a frame that does not.
 *
 * @param FrameLayout layout  the resolved frame
 * @return []u32 | error  the prologue words, or the `A4-bigframe` honest-stop
 */
pub fn emit_prologue(layout: FrameLayout) -> []u32 | error {
    if layout.size == (0 to u32) {
        let none: []u32 = teko::list::empty()
        return none
    }
    if frame_fits(layout) { return emit_prologue_small(layout) }
    emit_prologue_big(layout)
}

/**
 * emit_epilogue — the function's frame-teardown sequence (LIFO), or an empty
 * list for a frameless function: the ORIGINAL byte-for-byte
 * `emit_epilogue_small` shape when the frame fits the STP field, else the
 * `emit_epilogue_big` sequence for a frame that does not. The `RET` itself is
 * the `MRet` encoding (`encode_ret`), which the function-encode layer (A4-3)
 * emits immediately after these words.
 *
 * @param FrameLayout layout  the resolved frame
 * @return []u32 | error  the teardown words, or the `A4-bigframe` honest-stop
 */
pub fn emit_epilogue(layout: FrameLayout) -> []u32 | error {
    if layout.size == (0 to u32) {
        let none: []u32 = teko::list::empty()
        return none
    }
    if frame_fits(layout) { return emit_epilogue_small(layout) }
    emit_epilogue_big(layout)
}

/**
 * encode_fspill — resolve `MFSpill{reg, slot, is_load}` to `STR Dt, [sp,
 * #slot_offsets[slot]]` (or the load direction), by building the equivalent
 * `MStore`/`MLoad` at the `D` width with `SP` as its base and handing it to
 * `encode_store`/`encode_load`. An FPR spill is therefore encoded by exactly the
 * code every other float memory access goes through, and a slot offset the scaled
 * 12-bit field cannot express raises the SAME `A4-ldur` stop any other
 * out-of-range access raises rather than a stop of its own.
 *
 * @param FrameLayout layout  the enclosing function's resolved frame
 * @param MFSpill i  the spill store or reload (operand physical)
 * @return EncWord | error  the encoded word, or a named honest-stop
 */
fn encode_fspill(layout: FrameLayout, i: MFSpill) -> EncWord | error {
    let mem = MMem { base = preg(ARM64_SP_ID, MRegClass::GPR); offset = slot_offset(layout, i.slot) to i32 }
    if i.is_load { return encode_load(MLoad { size = MMemSize::D; sign = false; dst = i.reg; mem = mem }) }
    encode_store(MStore { size = MMemSize::D; src = i.reg; mem = mem })
}

/**
 * encode_frame_addr — resolve a SMALL `MFrameAddr{dst, slot}` (a slot offset
 * within the inline 12-bit ADD-imm field) to `ADD dst, sp,
 * #slot_offset(layout, slot)`, the A4-2 replacement for A4-1's `A4-frame`
 * honest-stop — the ONE-word case `encode_inst_word`'s total per-`MInst`
 * dispatch owns directly. A slot offset beyond the field raises
 * `A4-bigframe` here; `encode_frame_addr_words` (below) is `encode_one`'s
 * caller-side wrapper that instead expands a big offset into the chained
 * big-frame ADD sequence, mirroring how `MRet`'s epilogue expansion also
 * lives outside this per-instruction dispatch.
 *
 * @param FrameLayout layout  the function's resolved frame
 * @param MFrameAddr i  the frame-slot address instruction (operand physical)
 * @return EncWord | error  the encoded ADD, or the `A4-bigframe` honest-stop
 */
fn encode_frame_addr(layout: FrameLayout, i: MFrameAddr) -> EncWord | error {
    let off = slot_offset(layout, i.slot)
    if off > ARM64_IMM12_FIELD_MAX { return honest_bigframe() }
    plain_word(add_sp_imm_word(enc_reg(i.dst), off))
}

/**
 * encode_out_arg — encode an `MOutArg{size, src, index}` as `STR src, [sp, #(index * 8)]`:
 * a store to the outgoing stack-arg area at the bottom of the frame. The slot
 * byte offset is always a multiple of 8 (AAPCS64 §6.4.2), so `encode_store`'s
 * scaled-immediate check always passes for the slot counts seen in practice.
 *
 * @param MOutArg i  the outgoing stack-argument store instruction
 * @return EncWord | error  the encoded STR, or a named honest-stop
 */
fn encode_out_arg(i: MOutArg) -> EncWord | error {
    let mem = MMem { base = preg(ARM64_SP_ID, MRegClass::GPR); offset = (i.index * ARM64_REG_BYTES) to i32 }
    encode_store(MStore { size = i.size; src = i.src; mem = mem })
}

/**
 * encode_in_arg — encode an `MInArg{size, dst, index}` as `LDR dst, [sp, #(layout.size + index * 8)]`:
 * a load from the caller's outgoing stack-arg area, which is above the current
 * function's frame top (SP points to the bottom of this callee's frame, so the
 * caller's stack-arg area is at `SP + layout.size + index * 8`).
 *
 * @param FrameLayout layout  the function's resolved frame (for the frame size)
 * @param MInArg i  the incoming stack-parameter load instruction
 * @return EncWord | error  the encoded LDR, or a named honest-stop
 */
fn encode_in_arg(layout: FrameLayout, i: MInArg) -> EncWord | error {
    let mem = MMem { base = preg(ARM64_SP_ID, MRegClass::GPR); offset = (layout.size + i.index * ARM64_REG_BYTES) to i32 }
    encode_load(MLoad { size = i.size; sign = false; dst = i.dst; mem = mem })
}

/**
 * encode_inst_word — encode one fully-physical `MInst` to its `EncWord`, a
 * TOTAL per-case match over the 31-case variant mirroring `print_minst`'s
 * dispatch. The position-independent integer/control/memory subset encodes
 * fully; branches and symbol references return placeholder words flagged for
 * A4-3 patching; `MFrameAddr` resolves through `layout` to the real `ADD dst,
 * sp, #off` (A4-2); the float family encodes fully too (0.3.1.0 degrau 29
 * closed the `A4-fp` stop, the arm64 twin of the x86 `B1-fp` arc); `MOutArg`
 * and `MInArg` handle AAPCS64 stack argument passing; big immediates,
 * unscaled offsets, and big-frame offsets return their NAMED honest-stops.
 *
 * @param FrameLayout layout  the enclosing function's resolved frame (for `MFrameAddr`, `MInArg`)
 * @param MInst inst  the instruction to encode (all operands physical)
 * @return EncWord | error  the encoding, or a named honest-stop
 */
pub fn encode_inst_word(layout: FrameLayout, inst: MInst) -> EncWord | error {
    match inst {
        MAlu as x => encode_alu(x)
        MAluImm as x => encode_alu_imm(x)
        MMSub as x => encode_msub(x)
        MNeg as x => encode_neg(x)
        MMvn as x => encode_mvn(x)
        MFAlu as x => encode_falu(x)
        MFNeg as x => encode_fneg(x)
        MCmp as x => encode_cmp(x)
        MCmpImm as x => encode_cmp_imm(x)
        MFCmp as x => encode_fcmp(x)
        MCSet as x => encode_cset(x)
        MMovZ as x => encode_movz(x)
        MMovK as x => encode_movk(x)
        MMovN as x => encode_movn(x)
        MFMov as x => encode_fmov(x)
        MMov as x => encode_mov(x)
        MExt as x => encode_ext(x)
        MCvt as x => encode_cvt(x)
        MLoad as x => encode_load(x)
        MStore as x => encode_store(x)
        MFSpill as x => encode_fspill(layout, x)
        MFrameAddr as x => encode_frame_addr(layout, x)
        MAdrp as x => encode_adrp(x)
        MAddLo as x => encode_add_lo(x)
        MBranch as x => encode_branch(x)
        MBranchCond as x => encode_branch_cond(x)
        MCbz as x => encode_cbz(x)
        MCall as x => encode_call(x)
        MCallIndirect as x => encode_call_indirect(x)
        MRet => encode_ret()
        MOutArg as x => encode_out_arg(x)
        MInArg as x => encode_in_arg(layout, x)
    }
}

/**
 * Reloc — one symbol relocation the object writer (A4-4) turns into a Mach-O
 * `relocation_info` entry: the byte offset within the function's `__text` image
 * (module-rebased at assembly) where the fixup applies, the target symbol's
 * already-final name, and which `MRelocKind` field it patches. A2 pre-tags every
 * symbol reference with its kind (`minst.tks:42`), so A4 owes no analysis — one
 * `Reloc` per `MAdrp`/`MAddLo`/`MCall`.
 *
 * @since #385 A4-3
 */
pub type Reloc = struct {
    /**
     * offset — the byte offset of the relocated instruction word, relative to
     * this function's `__text` base (word index times 4).
     */
    offset: u32
    /**
     * sym — the target symbol's final name (unprefixed; the writer adds `_`).
     */
    sym: str
    /**
     * kind — which ARM64 relocation this instruction owes (PAGE21/PAGEOFF12/
     * BRANCH26).
     */
    kind: MRelocKind
    /**
     * sect — which section this relocation's patched field lives in (#594 T-B1):
     * `Text` (the historical default — `offset` is `__text`-base-relative), or
     * `Rodata` (a data→data pointer whose `offset` is rodata-base-relative,
     * emitted only from T-B2 on). Every reloc the encoder builds today is `Text`.
     */
    sect: RelocSect
}

/**
 * EncodedFunc — one function lowered to machine bytes: its already-final symbol,
 * its `__text` words in layout order (prologue ++ every block's encoded
 * instructions ++ epilogues, with intra-function branch displacements resolved),
 * and its function-relative symbol relocations (offsets rebased to the module
 * `__text` at assembly, A4-4). The function's byte size is `words.len * 4`.
 *
 * @since #385 A4-3
 */
pub type EncodedFunc = struct {
    /**
     * symbol — the function's already-final symbol (unprefixed).
     */
    symbol: str
    /**
     * words — the encoded instruction stream, in layout order (u32 words,
     * flattened little-endian by the module writer in A4-4).
     */
    words: []u32
    /**
     * relocs — the symbol relocations, offsets relative to this function's
     * `__text` base.
     */
    relocs: []Reloc
}

/**
 * BlockOffset — one machine block's starting word index in the function's
 * emitted stream, keyed by the block's id. The branch-patch pass looks a
 * displacement target up here; ids are non-topological after #443, so a keyed
 * lookup (not a positional index) is required.
 *
 * @since #385 A4-3
 */
type BlockOffset = struct {
    /**
     * id — the machine block's id (an `MBranch`/`MBranchCond`/`MCbz` target).
     */
    id: u32
    /**
     * word — the block's starting word index in the emitted stream.
     */
    word: u32
}

/**
 * honest_farbranch — the named honest-stop for a branch displacement that does
 * not fit its instruction field (imm26 = ±128 MB for B, imm19 = ±1 MB for
 * B.cond/CBZ/CBNZ). Real functions are tiny, so this is an internal-invariant
 * guard — reached only by a pathological (constructed) input, never silently
 * mis-encoded.
 *
 * @return error  the `A4-farbranch` named honest-stop
 */
fn honest_farbranch() -> error {
    error { message = "A4-farbranch: branch displacement out of the imm26/imm19 field range (internal invariant — real functions are tiny)" }
}

/**
 * honest_badblock — the named honest-stop for a branch whose target block id is
 * absent from the function's block set. An internal-invariant guard: isel/
 * regalloc only emit branches to real blocks, so a miss means a malformed
 * `MFunc`, caught here rather than encoded to a wrong displacement.
 *
 * @return error  the `A4-badblock` named honest-stop
 */
fn honest_badblock() -> error {
    error { message = "A4-badblock: branch target block id not found in the function (internal invariant)" }
}

/**
 * imm26_fits — whether a word-displacement fits the signed 26-bit B field
 * (`[-2^25, 2^25-1]`, i.e. ±128 MB in bytes).
 *
 * @param i64 disp_words  the target-minus-here displacement in whole words
 * @return bool  true iff it is encodable in imm26
 */
fn imm26_fits(disp_words: i64) -> bool {
    (disp_words >= ((0) - ARM64_IMM26_MIN_MAGNITUDE)) && (disp_words <= ARM64_IMM26_MAX)
}

/**
 * imm19_fits — whether a word-displacement fits the signed 19-bit B.cond/CBZ
 * field (`[-2^18, 2^18-1]`, i.e. ±1 MB in bytes).
 *
 * @param i64 disp_words  the target-minus-here displacement in whole words
 * @return bool  true iff it is encodable in imm19
 */
fn imm19_fits(disp_words: i64) -> bool {
    (disp_words >= ((0) - ARM64_IMM19_MIN_MAGNITUDE)) && (disp_words <= ARM64_IMM19_MAX)
}

/**
 * twos_field — the low `bits`-wide two's-complement encoding of a signed
 * word-displacement, computed WITHOUT casting a negative `i64` through `to u32`
 * (that overflow-checks and panics): a non-negative value narrows directly, a
 * negative value of magnitude `m` becomes `2^bits - m` within the field. The
 * caller has already range-checked `disp_words`, so `2^bits - m` never
 * underflows.
 *
 * @param i64 disp_words  the in-range signed displacement in whole words
 * @param u32 bits  the field width (26 for B, 19 for B.cond/CBZ)
 * @return u32  the field's `bits`-wide two's-complement value
 */
fn twos_field(disp_words: i64, bits: u32) -> u32 {
    let modulus = (1 to u32) << bits
    let mask = modulus - (1 to u32)
    if disp_words >= (0) {
        return (disp_words to u32) & mask
    }
    let mag = ((0) - disp_words) to u32
    (modulus - mag) & mask
}

/**
 * branch_disp_field — the OR-mask a resolved intra-function branch contributes
 * to its word: for form 0 (B, imm26) the two's-complement displacement in bits
 * 0-25; for form 1 (B.cond/CBZ, imm19) the displacement in bits 5-23. A
 * displacement outside the field raises the `A4-farbranch` honest-stop.
 *
 * @param i64 disp_words  the target-minus-here displacement in whole words
 * @param u32 form  the displacement field selector (0=imm26, 1=imm19)
 * @return u32 | error  the OR-mask, or the `A4-farbranch` honest-stop
 */
fn branch_disp_field(disp_words: i64, form: u32) -> u32 | error {
    if form == (0 to u32) {
        if !imm26_fits(disp_words) { return honest_farbranch() }
        return twos_field(disp_words, ARM64_IMM26_BITS)
    }
    if !imm19_fits(disp_words) { return honest_farbranch() }
    twos_field(disp_words, ARM64_IMM19_BITS) << ARM64_BCOND_IMM19_SHIFT
}

/**
 * lookup_block_offset — the starting word index of the block whose id is `id`,
 * or the `A4-badblock` honest-stop when no such block was emitted. A linear scan
 * of the (tiny) per-function offset table, since block ids are non-topological.
 *
 * @param []BlockOffset offsets  the recorded per-block starting word indices
 * @param u32 id  the target block id
 * @return u32 | error  the block's starting word index, or `A4-badblock`
 */
fn lookup_block_offset(offsets: []BlockOffset, id: u32) -> u32 | error {
    mut i: u64 = 0
    loop {
        if i >= offsets.len { break }
        let bo = offsets[i]
        if bo.id == id { return bo.word }
        i++
    }
    honest_badblock()
}

/**
 * wrap_plain_words — append each raw instruction word of `ws` to the `EncWord`
 * stream as a position-independent `plain_word` (the prologue/epilogue expansion
 * carries no branch or reloc fixup).
 *
 * @param []EncWord acc0  the `EncWord` stream to extend
 * @param []u32 ws  the raw instruction words to append
 * @return []EncWord  `acc0` followed by each word wrapped as a plain `EncWord`
 */
fn wrap_plain_words(acc0: []EncWord, ws: []u32) -> []EncWord {
    mut acc = acc0
    mut i: u64 = 0
    loop {
        if i >= ws.len { break }
        acc = teko::list::push(acc, plain_word(ws[i]))
        i++
    }
    acc
}

/**
 * append_encwords — append every `EncWord` of `xs` to `acc`, in order: the
 * concatenation `encode_one`'s `MFrameAddr` branch uses to fold
 * `encode_frame_addr_words`'s one-or-two-word result into the running
 * `EncWord` stream.
 *
 * @param []EncWord acc  the `EncWord` stream to extend
 * @param []EncWord xs  the words to append
 * @return []EncWord  `acc` followed by `xs`
 */
fn append_encwords(acc: []EncWord, xs: []EncWord) -> []EncWord {
    mut out = acc
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i])
        i++
    }
    out
}

/**
 * inst_is_frame_addr — whether an instruction is `MFrameAddr`: the abstract
 * slot-address instruction `encode_one` may need to expand into MORE than one
 * word (the big-frame ADD sequence), mirroring `inst_is_ret`'s `MRet` check.
 *
 * @param MInst inst  the instruction
 * @return bool  true iff `inst` is `MFrameAddr`
 */
fn inst_is_frame_addr(inst: MInst) -> bool {
    match inst {
        MFrameAddr => true
        _ => false
    }
}

/**
 * as_frame_addr — `inst` as its `MFrameAddr` payload. Only ever called after
 * `inst_is_frame_addr(inst)` has already held; the `_` arm's placeholder
 * value is unreachable in practice (required by the exhaustive-match
 * contract, the same shape `bad_word`/`bad_func` use in the golden tests).
 *
 * @param MInst inst  an instruction already known to be `MFrameAddr`
 * @return MFrameAddr  its payload
 */
fn as_frame_addr(inst: MInst) -> MFrameAddr {
    match inst {
        MFrameAddr as x => x
        _ => MFrameAddr { dst = preg(0 to u32, MRegClass::GPR); slot = 0 to u64 }
    }
}

/**
 * encode_frame_addr_words — resolve `MFrameAddr{dst, slot}` to one or two
 * `EncWord`s: a slot offset within the inline 12-bit ADD-imm field resolves
 * exactly as `encode_frame_addr` does (byte-identical, ONE word, delegated
 * directly); a bigger offset expands to the chained big-offset ADD sequence
 * (`big_offset_words`, A4-2's big-frame fast-follow) — two words at most,
 * `dst` itself the scratch (safe: nothing else reads `dst` before both writes
 * land). Past `ARM64_IMM24_FIELD_MAX`, `A4-bigframe`.
 *
 * @param FrameLayout layout  the enclosing function's resolved frame
 * @param MFrameAddr i  the frame-slot address instruction (operand physical)
 * @return []EncWord | error  the one or two encoded words, or `A4-bigframe`
 */
fn encode_frame_addr_words(layout: FrameLayout, i: MFrameAddr) -> []EncWord | error {
    let off = slot_offset(layout, i.slot)
    if off <= ARM64_IMM12_FIELD_MAX {
        let ew = match encode_frame_addr(layout, i) { EncWord as x => x; error as e => return e }
        return teko::list::push(teko::list::empty(), ew)
    }
    let raw = match big_offset_words(ARM64_SP_ID, enc_reg(i.dst), off, false) { []u32 as w => w; error as e => return e }
    wrap_plain_words(teko::list::empty(), raw)
}

/**
 * encode_one — append one instruction's `EncWord`(s) to the stream: an `MRet`
 * expands to the frame epilogue words (A4-2 left it bare) followed by the RET
 * word; an `MFrameAddr` expands through `encode_frame_addr_words` (one word
 * for a small slot offset, two for a big one); every other instruction
 * encodes to its single `EncWord` via `encode_inst_word`. Any named
 * honest-stop propagates out.
 *
 * @param FrameLayout layout  the enclosing function's resolved frame
 * @param []EncWord words0  the `EncWord` stream to extend
 * @param MInst inst  the instruction to encode
 * @return []EncWord | error  the extended stream, or a named honest-stop
 */
fn encode_one(layout: FrameLayout, words0: []EncWord, inst: MInst) -> []EncWord | error {
    if inst_is_ret(inst) {
        match emit_epilogue(layout) {
            []u32 as epi => {
                let after = wrap_plain_words(words0, epi)
                return teko::list::push(after, encode_ret())
            }
            error as e => return e
        }
    }
    if inst_is_frame_addr(inst) {
        let fa = as_frame_addr(inst)
        let ews = match encode_frame_addr_words(layout, fa) { []EncWord as w => w; error as e => return e }
        return append_encwords(words0, ews)
    }
    let ew = match encode_inst_word(layout, inst) { EncWord as x => x; error as e => return e }
    teko::list::push(words0, ew)
}

/**
 * encode_block_words — append every instruction of one block to the `EncWord`
 * stream, in order, expanding `MRet` as `encode_one` does. Any named honest-stop
 * propagates out.
 *
 * @param FrameLayout layout  the enclosing function's resolved frame
 * @param []EncWord words0  the `EncWord` stream to extend
 * @param MBlock blk  the block whose instructions to encode
 * @return []EncWord | error  the extended stream, or a named honest-stop
 */
fn encode_block_words(layout: FrameLayout, words0: []EncWord, blk: MBlock) -> []EncWord | error {
    mut words = words0
    mut i: u64 = 0
    loop {
        if i >= blk.insts.len { break }
        let next = match encode_one(layout, words, blk.insts[i]) { []EncWord as w => w; error as e => return e }
        words = next
        i++
    }
    words
}

/**
 * resolve_word — the final u32 of one emitted `EncWord`: a position-independent
 * or symbol-reference word is returned as-is (the reloc placeholder stays; the
 * linker patches it), a branch word gets its displacement patched from the
 * recorded block offsets (`disp = target_offset - here`, in whole words). A
 * missing target or an out-of-field displacement raises a named honest-stop.
 *
 * @param EncWord ew  the emitted word
 * @param u32 here  this word's own index in the function's stream
 * @param []BlockOffset offsets  the recorded per-block starting word indices
 * @return u32 | error  the resolved word, or a named honest-stop
 */
fn resolve_word(ew: EncWord, here: u32, offsets: []BlockOffset) -> u32 | error {
    if !ew.has_branch { return ew.word }
    let target_off = match lookup_block_offset(offsets, ew.target) { u32 as v => v; error as e => return e }
    let disp_words = (target_off to i64) - (here to i64)
    let field = match branch_disp_field(disp_words, ew.branch_form) { u32 as v => v; error as e => return e }
    ew.word | field
}

/**
 * collect_word_reloc — fold the relocation ONE `EncWord` owes into the
 * function's `Reloc` list: a word that owes none (`reloc` null) leaves the list
 * untouched, and a word that owes one contributes exactly one `__text`-relative
 * record at its word index times four. The nullable `reloc` is the only input,
 * so there is no flag to read out of step with a kind.
 *
 * @param []Reloc acc  the relocations collected so far
 * @param EncWord ew  the word whose relocation (if any) is folded in
 * @param u64 word_index  the word's index in the function's word stream
 * @return []Reloc  `acc`, extended when `ew` owes a relocation
 */
