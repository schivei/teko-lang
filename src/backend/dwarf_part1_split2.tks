/**
 * DW_TAG_FORMAL_PARAMETER — the DWARF tag for a function parameter DIE.
 *
 * @since 0.3.1.0
 */
const DW_TAG_FORMAL_PARAMETER: u64 = 0x05

/**
 * DW_TAG_VARIABLE — the DWARF tag for a local variable DIE.
 *
 * @since 0.3.1.0
 */
const DW_TAG_VARIABLE: u64 = 0x34

/**
 * DW_TAG_LEXICAL_BLOCK — the DWARF tag for a lexical scope DIE, used to nest a shadowing local so a
 * name that is rebound in an inner scope keeps a distinct location.
 *
 * @since 0.3.1.0
 */
const DW_TAG_LEXICAL_BLOCK: u64 = 0x0b

/**
 * DW_OP_FBREG — the DWARF location opcode addressing a slot at an SLEB128 offset from the function's
 * frame base (DW_AT_frame_base). Every local and parameter location the writer emits is this single
 * opcode plus its offset.
 *
 * @since 0.3.1.0
 */
const DW_OP_FBREG: u64 = 0x91

/**
 * ABBREV_FORMAL_PARAMETER — the `.debug_abbrev` code (4) of the formal_parameter abbreviation, the
 * leaf DIE emitted for a parameter.
 *
 * @since 0.3.1.0
 */
const ABBREV_FORMAL_PARAMETER: u64 = 4

/**
 * ABBREV_VARIABLE — the `.debug_abbrev` code (5) of the variable abbreviation, the leaf DIE emitted
 * for a local (top-level or shadowed).
 *
 * @since 0.3.1.0
 */
const ABBREV_VARIABLE: u64 = 5

/**
 * DW_ATE_BOOLEAN — the DW_AT_encoding value (0x02) of a boolean base type, one of the frozen scalar
 * encodings the writer may describe (D2.5).
 *
 * @since 0.3.1.0
 */
pub const DW_ATE_BOOLEAN: u64 = 0x02

/**
 * DW_ATE_SIGNED — the DW_AT_encoding value (0x05) of a signed-integer base type (`i8`..`i64`).
 *
 * @since 0.3.1.0
 */
pub const DW_ATE_SIGNED: u64 = 0x05

/**
 * DW_ATE_UNSIGNED — the DW_AT_encoding value (0x07) of an unsigned-integer base type
 * (`u8`..`u64`, `byte`).
 *
 * @since 0.3.1.0
 */
pub const DW_ATE_UNSIGNED: u64 = 0x07

/**
 * DW_ATE_FLOAT — the DW_AT_encoding value (0x04) of an IEEE-754 floating-point base type (`f32`,
 * `f64`), one of the frozen scalar encodings the writer may describe (D2.5).
 *
 * @since 0.3.1.0
 */
pub const DW_ATE_FLOAT: u64 = 0x04

/**
 * DW_OP_REG6_RBP_PLACEHOLDER — the DW_AT_frame_base expression the writer emits until the real
 * frame descriptor is wired in: the single opcode DW_OP_reg6 (0x56), naming x86-64 RBP as the frame
 * base so DW_OP_fbreg offsets read RBP-relative. It is a PLACEHOLDER: the true frame base (register
 * AND the prologue-dependent offset) is `compute_frame_layout`'s to supply once that hook is free
 * (see DwSubprogramLocals.frame_base_op). arm64 will substitute DW_OP_reg29 (x29) the same way.
 *
 * @since 0.3.1.0
 */
pub const DW_OP_REG6_RBP_PLACEHOLDER: u64 = 0x56

/**
 * debug_abbrev — the fixed `.debug_abbrev` table for the minimal unit: two abbreviations, a
 * compile_unit (with children) and a subprogram (leaf). The attribute/form pairs match the
 * gdb-and-lldb-verified golden (docs/design/debugger-poc/mini.s): the CU carries
 * producer/language/name/comp_dir/low_pc/high_pc/stmt_list; the subprogram carries
 * name/decl_file/decl_line/low_pc/high_pc/external.
 *
 * @return  the `.debug_abbrev` section bytes
 * @since 0.3.1.0
 */
pub fn debug_abbrev() -> []byte {
    mut b: []byte = teko::list::empty()
    b = uleb128(b, 1 to u64)
    b = uleb128(b, DW_TAG_COMPILE_UNIT)
    b = teko::list::push(b, 0x01 to byte)
    b = emit_pair(b, 0x25, 0x08)
    b = emit_pair(b, 0x13, 0x05)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x1b, 0x08)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x10, 0x17)
    b = emit_pair(b, 0x00, 0x00)
    b = uleb128(b, 2 to u64)
    b = uleb128(b, DW_TAG_SUBPROGRAM)
    b = teko::list::push(b, 0x00 to byte)
    b = emit_pair(b, 0x03, 0x08)
    b = emit_pair(b, 0x3a, 0x0d)
    b = emit_pair(b, 0x3b, 0x05)
    b = emit_pair(b, 0x11, 0x01)
    b = emit_pair(b, 0x12, 0x07)
    b = emit_pair(b, 0x3f, 0x19)
    b = emit_pair(b, 0x00, 0x00)
    teko::list::push(b, 0x00 to byte)
}

/**
 * emit_pair — append one abbreviation attribute/form pair (or the `0x00 0x00` terminator) as two
 * bytes.
 *
 * @param buf   the buffer to extend
 * @param attr  the DW_AT attribute code
 * @param form  the DW_FORM form code
 * @return      `buf` followed by the two bytes
 * @since 0.3.1.0
 */
fn emit_pair(buf: []byte, attr: u64, form: u64) -> []byte {
    let b0 = teko::list::push(buf, attr to byte)
    teko::list::push(b0, form to byte)
}

/**
 * emit_subprogram_die — append one subprogram DIE (abbrev 2) to `body`, recording the low_pc
 * relocation. Layout: abbrev code, name (string), decl_file (sdata), decl_line (data2), low_pc
 * (addr, relocated), high_pc (data8 code size). The `external` flag is `flag_present` and emits no
 * bytes.
 *
 * @param body    the DIE body accumulated so far
 * @param relocs  the relocations accumulated so far
 * @param base    the byte count of the section header preceding the body (for section-relative
 *                relocation offsets)
 * @param sub     the subprogram to describe
 * @return        the extended body and relocation list
 * @since 0.3.1.0
 */
fn emit_subprogram_die(body: []byte, relocs: []DwReloc, base: u64, sub: DwSubprogram) -> DwSection {
    mut b = teko::list::push(body, 0x02 to byte)
    b = emit_cstr(b, sub.name)
    b = sleb128(b, sub.decl_file)
    b = emit_u16_le(b, sub.decl_line to u64)
    let low_pc_off = base + b.len
    b = emit_addr_slot(b)
    let r = teko::list::push(relocs, DwReloc { offset = low_pc_off; symbol = sub.symbol })
    b = emit_u64_le_dw(b, sub.code_size)
    DwSection { bytes = b; relocs = r }
}

/**
 * debug_info — the minimal `.debug_info` compile unit for `cu`: the DWARF-4 unit header, the
 * compile_unit DIE (with inline producer/name/comp_dir strings, relocated low_pc, high_pc, and a
 * stmt_list offset of 0), then one subprogram DIE per function, then the null-DIE terminator. The
 * emitted bytes and the absolute-address relocations reproduce the gdb-and-lldb-verified golden.
 *
 * @param cu  the compile unit to describe
 * @return    the `.debug_info` section bytes and its relocations
 * @since 0.3.1.0
 */
pub fn debug_info(cu: DwCompileUnit) -> DwSection {
    mut relocs: []DwReloc = teko::list::empty()
    mut body: []byte = teko::list::empty()
    body = teko::list::push(body, 0x01 to byte)
    body = emit_cstr(body, cu.producer)
    body = emit_u16_le(body, cu.language to u64)
    body = emit_cstr(body, cu.name)
    body = emit_cstr(body, cu.comp_dir)
    let cu_low_pc_off = header_len_prefix() + body.len
    body = emit_addr_slot(body)
    relocs = teko::list::push(relocs, DwReloc { offset = cu_low_pc_off; symbol = cu.text_symbol })
    body = emit_u64_le_dw(body, cu.text_size)
    body = emit_u32_le_dw(body, 0 to u64)
    mut i: u64 = 0
    loop {
        if i >= cu.subprograms.len { break }
        let child = emit_subprogram_die(body, relocs, header_len_prefix(), cu.subprograms[i])
        body = child.bytes
        relocs = child.relocs
        i = i + 1
    }
    body = teko::list::push(body, 0x00 to byte)
    let unit_length = body.len + 2 + 4 + 1
    mut out: []byte = teko::list::empty()
    out = emit_u32_le_dw(out, unit_length)
    out = emit_u16_le(out, 4 to u64)
    out = emit_u32_le_dw(out, 0 to u64)
    out = teko::list::push(out, 0x08 to byte)
    out = append_bytes_dw(out, body)
    DwSection { bytes = out; relocs = relocs }
}

/**
 * header_len_prefix — the byte count of the `.debug_info` unit header that precedes the DIE body
 * (unit_length 4 + version 2 + abbrev_offset 4 + address_size 1), so a low_pc slot's offset inside
 * the body maps to its offset inside the whole section.
 *
 * @return  the header prefix length (11)
 * @since 0.3.1.0
 */
fn header_len_prefix() -> u64 {
    11 to u64
}

/**
 * append_bytes_dw — `dst` with every byte of `src` appended, in order (no slice-concat builtin over
 * `[]byte` here).
 *
 * @param dst  the buffer to extend
 * @param src  the bytes to append
 * @return     `dst` followed by `src`
 * @since 0.3.1.0
 */
fn append_bytes_dw(dst: []byte, src: []byte) -> []byte {
    mut b = dst
    mut i: u64 = 0
    loop {
        if i >= src.len { break }
        b = teko::list::push(b, src[i])
        i = i + 1
    }
    b
}

/**
 * line_header_body — the DWARF-4 line-program header body (everything the `header_length` field
 * counts: the instruction/statement parameters, the standard opcode-length table, the empty
 * include-directory list, one file-table entry per `files` name, and the file-list terminator).
 * Fixed except for the inlined file names; a single-element `files` reproduces the verified golden.
 *
 * @param files  the source file names, in file-table order (index 1 is the primary file)
 * @return       the header body bytes
 * @since 0.3.1.0
 */
fn line_header_body(files: []str) -> []byte {
    mut b: []byte = teko::list::empty()
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0x01 to byte)
    b = teko::list::push(b, 0xfb to byte)
    b = teko::list::push(b, 0x0e to byte)
    b = teko::list::push(b, 0x0d to byte)
    b = append_std_opcode_lengths(b)
    b = teko::list::push(b, 0x00 to byte)
    b = append_file_entries(b, files)
    teko::list::push(b, 0x00 to byte)
}

/**
 * append_file_entries — append one DWARF-4 `file_names` entry per name in `files`: the
 * NUL-terminated name followed by the directory-index, mtime, and length ULEBs (all 0, since the
 * writer emits no include directories and no file metadata). The caller appends the list
 * terminator.
 *
 * @param buf    the header body accumulated so far
 * @param files  the source file names, in file-table order
 * @return       `buf` followed by the file entries
 * @since 0.3.1.0
 */
fn append_file_entries(buf: []byte, files: []str) -> []byte {
    mut b = buf
    mut i: u64 = 0
    loop {
        if i >= files.len { break }
        b = emit_cstr(b, files[i])
        b = uleb128(b, 0 to u64)
        b = uleb128(b, 0 to u64)
        b = uleb128(b, 0 to u64)
        i = i + 1
    }
    b
}
