pub type EncRelocX86 = struct {
    /**
     * field_off — the byte offset WITHIN the instruction's `bytes` of the field
     * the relocation patches (the emit pass rebases it by the instruction's
     * start offset in the function's `.text` image).
     */
    field_off: u32
    /**
     * sym — the relocation's target symbol, already in its final linker name.
     */
    sym: str
    /**
     * kind — which psABI relocation the writer emits (`Plt32` for a direct
     * `call`, `Pc32` for a rip-relative `lea`, `Abs64` for a data pointer).
     */
    kind: RelocKindX86
}

/**
 * EncInstX86 — one x86-64 instruction's encoding outcome: its variable-length
 * byte string plus optional pending fixups. A position-independent instruction
 * resolves to just `bytes` (`has_branch` false, `reloc` null). An intra-function
 * branch carries a `rel32` fixup — the byte offset WITHIN `bytes` of the 4-byte
 * little-endian displacement field and the destination machine-block id —
 * patched once every block's byte offset is known (the B1-6 layout pass). A
 * symbol reference carries an `EncRelocX86`, materialized into an `Elf64_Rela`
 * at B1-7. Mirrors arm64's `EncWord`, byte-granular instead of fixed 32-bit
 * words.
 *
 * @since #386 B1-5
 */
pub type EncInstX86 = struct {
    /**
     * bytes — the instruction's encoded bytes (1..15), in order, ready to
     * append to the function's `.text` image.
     */
    bytes: []byte
    /**
     * has_branch — true iff a `rel32` block displacement must be patched in.
     */
    has_branch: bool
    /**
     * branch_field_off — the byte offset within `bytes` of the 4-byte rel32
     * field (meaningful when `has_branch`).
     */
    branch_field_off: u32
    /**
     * target — the destination machine-block id (meaningful when `has_branch`).
     */
    target: u32
    /**
     * reloc — the symbol relocation this instruction owes, or `null` when it
     * owes none. There is no third state and no inert default.
     */
    reloc: EncRelocX86 | null
}

/**
 * FrameLayoutX86 — the resolved stack frame of one x86-64 function: its total
 * 16-aligned byte size, the ordered callee-saved registers to save/restore
 * (re-derived by scanning the physical function, not carried by `MFuncX86`),
 * and the RSP-relative byte offset of every `MFuncX86.frame` slot. Purely a
 * side-table the encoder reads to resolve `MFrameAddrX86` to a concrete
 * `lea dst, [rsp+off]`; the block stream is never rewritten. A `size` of 0
 * marks a frameless function (no prologue/epilogue) UNLESS `call_align` is
 * true, in which case a minimal alignment-only `push rbp`/`mov rbp,rsp` is
 * still emitted (`frame_is_framed_x86`, 0.3.1.0 degrau 19). B1-5 defines the
 * type and resolves `MFrameAddrX86` through it (the §6.1 signature); B1-6
 * fills it via `compute_frame_layout_x86` and emits the matching
 * prologue/epilogue. Mirrors arm64's `FrameLayout`.
 *
 * @since #386 B1-5
 */
pub type FrameLayoutX86 = struct {
    /**
     * size — the total frame size in bytes, rounded up to 16 (SysV 16-byte
     * call-site alignment); 0 for a frameless function.
     */
    size: u32
    /**
     * saved_gpr — the callee-saved GPR ids to push/pop, ascending for a
     * deterministic prologue.
     */
    saved_gpr: []u32
    /**
     * saved_fpr — the callee-saved FPR ids to save/restore, ascending.
     */
    saved_fpr: []u32
    /**
     * slot_offsets — the RSP-relative byte offset of each `MFuncX86.frame`
     * entry, in frame order; `MFrameAddrX86{slot}` resolves to
     * `lea dst, [rsp+slot_offsets[slot]]`.
     */
    slot_offsets: []u32
    /**
     * call_align — true iff the function needs a minimal alignment-only
     * prologue/epilogue purely to restore 16-byte alignment at the calls it
     * itself issues (`needs_call_align_x86`), independent of `size`/the saved
     * lists — a function otherwise entitled to be frameless (zero slots, zero
     * callee-saved) is NOT frameless when this is true.
     */
    call_align: bool
    /**
     * out_arg_base — the RSP-relative byte offset of the FIRST outgoing
     * stack-argument slot (`B1-args`): 0 under SysV, and `abi.shadow_space`
     * (32) under Win64, whose stack arguments begin just above the
     * caller-reserved shadow area. `MOutArgX86{index}` resolves to
     * `mov [rsp + out_arg_base + 8*index], src`.
     */
    out_arg_base: u32
    /**
     * fpr_save_base — the RSP-relative byte offset of the FIRST callee-saved XMM
     * save slot (`B3-xmm-callee-saved`); each `saved_fpr` entry takes 16 bytes
     * from there, ascending. Sits just above the argument-passing region and
     * below the local slots, and is 16-aligned so `movaps` is legal.
     */
    fpr_save_base: u32
    /**
     * caller_shadow — the shadow space the CALLER reserved below the incoming
     * stack arguments (`abi.shadow_space`: 32 under Win64, 0 everywhere else), the
     * distance `in_arg_base_x86` must skip to reach incoming stack argument 0.
     *
     * NOT `shadow_bytes_x86`, and the difference is the defect it fixes: that one
     * is 0 for a LEAF, because a leaf reserves no shadow of its OWN — but the
     * shadow below THIS function's incoming arguments belongs to whoever called
     * it, and every Win64 caller reserves it whether or not this callee goes on to
     * call anything. Reading the caller-side number off the callee-side one made a
     * Win64 callee load its fifth argument 32 bytes low, out of its own home-space
     * area.
     */
    caller_shadow: u32
}

/**
 * X86MemOp — the encoding descriptor for a memory-operand `mov`/`movsx`/SSE-
 * family instruction: the operand-size prefix, the mandatory SSE prefix (for
 * a float MOVSD/MOVSS transfer, `B1-fp`), the REX.W bit, whether the opcode is
 * `0F`-escaped, the primary opcode byte, and whether the register operand is
 * 8-bit (which forces a REX prefix when it is SIL/DIL/BPL/SPL or R8..R15, so
 * the low byte is addressable). `load_memop_x86`/`store_memop_x86` produce it;
 * `emit_mem_op_x86` consumes it for both loads and stores.
 *
 * @since #386 B1-5, B1-fp
 */
type X86MemOp = struct {
    /**
     * op66 — emit the `0x66` operand-size prefix (the 16-bit word forms).
     */
    op66: bool
    /**
     * mandatory_prefix — an SSE mandatory prefix byte (`X86_PREFIX_F2`/`F3`
     * for a float MOVSD/MOVSS transfer), or `X86_NO_PREFIX` for every
     * integer form (which carries its size distinction through `op66`/`rexw`
     * instead).
     */
    mandatory_prefix: u32
    /**
     * rexw — set the REX.W bit (the 64-bit quadword / sign-extending forms).
     */
    rexw: bool
    /**
     * two_byte — the opcode is `0F`-escaped (`movsx`, and every SSE form).
     */
    two_byte: bool
    /**
     * opcode — the primary opcode byte (after any `0F` escape).
     */
    opcode: u32
    /**
     * byte_reg — the register operand is 8-bit (a byte store's source; loads
     * zero-extend via `movzx` into a 32-bit register and never set this), so a
     * REX prefix is forced when its id is >= 4 (SIL/DIL/BPL/SPL/R8..R15).
     */
    byte_reg: bool
}

/**
 * push_byte_x86 — append the low 8 bits of `v` to `buf` as one byte, the
 * variable-length x86 emit primitive (all bit-slicing stays in `u32`; only the
 * final `& 0xFF` narrows to `byte`).
 *
 * @param []byte buf  the buffer to extend
 * @param u32 v  the value whose low byte is appended
 * @return []byte  `buf` followed by `v & 0xFF`
 */
fn push_byte_x86(buf: []byte, v: u32) -> []byte {
    teko::list::push(buf, (v & X86_BYTE_MASK) to byte)
}

/**
 * push_imm32_x86 — append the low 32 bits of `x` to `buf` as four little-endian
 * bytes. The mask keeps a NEGATIVE `x` from panicking on the `to u32` cast (the
 * two's-complement bit pattern is computed by masking, not by a signed cast).
 *
 * @param []byte buf  the buffer to extend
 * @param i64 x  the value whose low 32 bits are appended (imm32 / disp32)
 * @return []byte  `buf` followed by the four little-endian bytes
 */
fn push_imm32_x86(buf: []byte, x: i64) -> []byte {
    emit_u32_le(buf, (x & X86_LOW32_MASK) to u32)
}

/**
 * push_imm64_x86 — append the 64 bits of `x` to `buf` as eight little-endian
 * bytes (the `movabs` immediate), split into two masked 32-bit halves so a
 * NEGATIVE `x` never reaches a panicking signed `to u64` cast.
 *
 * @param []byte buf  the buffer to extend
 * @param i64 x  the 64-bit immediate to append
 * @return []byte  `buf` followed by the eight little-endian bytes
 */
fn push_imm64_x86(buf: []byte, x: i64) -> []byte {
    let lo = (x & X86_LOW32_MASK) to u32
    let hi = ((x >> (32)) & X86_LOW32_MASK) to u32
    emit_u32_le(emit_u32_le(buf, lo), hi)
}

/**
 * bit_u32 — a boolean as its 0/1 `u32` value, the bit-assembly primitive the
 * REX-prefix builder folds into each extension field's shift. Extracted so the
 * REX byte is composed by shifting these bits into place (bool casts are not in
 * the bootstrap seed, so `if`-selection stands in for a `bool to u32` cast).
 *
 * @param bool flag  the boolean to reduce
 * @return u32  1 when `flag`, else 0
 */
fn bit_u32(flag: bool) -> u32 {
    if flag { 1 to u32 } else { 0 to u32 }
}

/**
 * rex_x86 — the REX prefix byte value `0x40 | (W<<3) | (R<<2) | (X<<1) | B`:
 * `W` the 64-bit operand size, `R` the ModRM.reg high bit, `X` the SIB.index
 * high bit, `B` the ModRM.rm / SIB.base / opcode-reg high bit.
 *
 * @param bool w  the operand-size (REX.W) bit
 * @param bool r  the reg-field extension (REX.R) bit
 * @param bool x  the index-field extension (REX.X) bit
 * @param bool b  the rm/base/opcode-reg extension (REX.B) bit
 * @return u32  the REX prefix byte value
 */
fn rex_x86(w: bool, r: bool, x: bool, b: bool) -> u32 {
    let hi = (REX_BASE | (bit_u32(w) << REX_W_SHIFT)) | (bit_u32(r) << REX_R_SHIFT)
    (hi | (bit_u32(x) << REX_X_SHIFT)) | bit_u32(b)
}

/**
 * push_rex_x86 — append a REX prefix to `buf` only when it carries information
 * (any of W/R/X/B set); a bare `0x40` is elided, matching what an assembler
 * emits for a non-byte operation. Byte operations that need the bare `0x40` to
 * reach SIL/DIL/BPL/SPL go through `push_rex_forced_x86` instead.
 *
 * @param []byte buf  the buffer to extend
 * @param bool w  the REX.W bit
 * @param bool r  the REX.R bit
 * @param bool x  the REX.X bit
 * @param bool b  the REX.B bit
 * @return []byte  `buf`, with a REX prefix appended iff it is non-trivial
 */
fn push_rex_x86(buf: []byte, w: bool, r: bool, x: bool, b: bool) -> []byte {
    let v = rex_x86(w, r, x, b)
    if v == REX_BASE { return buf }
    push_byte_x86(buf, v)
}

/**
 * push_rex_forced_x86 — append a REX prefix to `buf` UNCONDITIONALLY, including
 * a bare `0x40`. Used where a byte register (SIL/DIL/BPL/SPL) needs the prefix
 * to be addressable, or where REX.W is always required.
 *
 * @param []byte buf  the buffer to extend
 * @param bool w  the REX.W bit
 * @param bool r  the REX.R bit
 * @param bool x  the REX.X bit
 * @param bool b  the REX.B bit
 * @return []byte  `buf` followed by the REX prefix byte
 */
fn push_rex_forced_x86(buf: []byte, w: bool, r: bool, x: bool, b: bool) -> []byte {
    push_byte_x86(buf, rex_x86(w, r, x, b))
}

/**
 * modrm_x86 — the ModRM byte `(mod<<6) | (reg<<3) | rm`, the addressing-mode
 * byte every register/memory operand rides. `mod=11` is register-direct;
 * `mod=00/01/10` select the [base], [base+disp8], [base+disp32] memory forms.
 *
 * @param u32 md  the 2-bit mode field
 * @param u32 reg  the 3-bit reg / opcode-extension field
 * @param u32 rm  the 3-bit rm field
 * @return u32  the ModRM byte value
 */
fn modrm_x86(md: u32, reg: u32, rm: u32) -> u32 {
    ((md & MODRM_MOD_MASK) << MODRM_MOD_SHIFT) | ((reg & X86_FIELD3_MASK) << X86_FIELD3_SHIFT) | (rm & X86_FIELD3_MASK)
}

/**
 * reg_low3_x86 — a physical register's low 3 bits, the value that rides the
 * ModRM.reg / ModRM.rm / SIB / opcode-`+rd` fields (the high bit routes into a
 * REX extension bit via `reg_ext_x86`).
 *
 * @param MReg r  a physical register (B1 runs post-regalloc)
 * @return u32  the register id's low 3 bits
 */
fn reg_low3_x86(r: MReg) -> u32 {
    r.id & X86_FIELD3_MASK
}

/**
 * reg_ext_x86 — whether a physical register needs a REX extension bit: true for
 * R8..R15 / XMM8..XMM15 (id >= 8), whose high bit cannot ride the 3-bit ModRM
 * field and must route into REX.R/REX.B/REX.X.
 *
 * @param MReg r  a physical register
 * @return bool  true iff the register's id has its 4th bit set
 */
fn reg_ext_x86(r: MReg) -> bool {
    (r.id & X86_REG_HIGH_BIT) != (0 to u32)
}

/**
 * cond_cc_x86 — the 4-bit x86 condition code (`tttn`) for an `MCond`, shared by
 * `Jcc` (opcode `0x80+cc`) and `SETcc` (opcode `0x90+cc`): equality (E/NE),
 * signed (L/LE/G/GE), unsigned (B/BE/A/AE), one per abstract condition.
 *
 * @param MCond c  the condition code
 * @return u32  its 4-bit x86 condition-code field
 */
fn cond_cc_x86(c: MCond) -> u32 {
    match c {
        EQ => X86_CC_E
        NE => X86_CC_NE
        LT => X86_CC_L
        LE => X86_CC_LE
        GT => X86_CC_G
        GE => X86_CC_GE
        LO => X86_CC_B
        LS => X86_CC_BE
        HI => X86_CC_A
        HS => X86_CC_AE
    }
}

/**
 * fits_i32_x86 — whether a 64-bit immediate fits the signed 32-bit field a
 * `mov r64, imm32`(sign-extended) uses: an out-of-range value takes the 10-byte
 * `movabs r64, imm64` form instead (§6.3 of the B1 plan).
 *
 * @param i64 x  the immediate to classify
 * @return bool  true iff `x` is in `[-2^31, 2^31 - 1]`
 */
fn fits_i32_x86(x: i64) -> bool {
    let hi = X86_IMM32_MAX
    let lo = (0) - X86_IMM32_MIN_MAGNITUDE
    x >= lo && x <= hi
}

/**
 * plain_inst_x86 — an `EncInstX86` for a position-independent instruction: just
 * the finished bytes, with no branch displacement and no symbol relocation
 * pending (`reloc` is `null`, not a defaulted kind).
 *
 * @param []byte bytes  the finished instruction bytes
 * @return EncInstX86  the instruction with no pending fixup
 */
fn plain_inst_x86(bytes: []byte) -> EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = false
        branch_field_off = 0 to u32
        target = 0 to u32
        reloc = null
    }
}

/**
 * branch_inst_x86 — an `EncInstX86` for an intra-function branch: the bytes
 * (with the rel32 field still zero) plus the byte offset of that field and the
 * destination machine-block id the B1-6 patch pass fills.
 *
 * @param []byte bytes  the instruction bytes (rel32 field zeroed)
 * @param u32 field_off  the byte offset of the 4-byte rel32 field
 * @param u32 target  the destination machine-block id
 * @return EncInstX86  the instruction flagged for branch patching
 */
fn branch_inst_x86(bytes: []byte, field_off: u32, target: u32) -> EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = true
        branch_field_off = field_off
        target = target
        reloc = null
    }
}

/**
 * reloc_inst_x86 — an `EncInstX86` for a symbol reference: the placeholder
 * bytes (with the relocated field zeroed) plus the byte offset of that field,
 * the target symbol, and the relocation kind the B1-7 ELF writer turns into an
 * `Elf64_Rela` entry.
 *
 * @param []byte bytes  the instruction bytes (relocated field zeroed)
 * @param u32 field_off  the byte offset of the relocated field
 * @param str sym  the target symbol's already-final name
 * @param RelocKindX86 kind  which relocation this instruction owes
 * @return EncInstX86  the instruction flagged for symbol relocation
 */
fn reloc_inst_x86(bytes: []byte, field_off: u32, sym: str, kind: RelocKindX86) -> EncInstX86 {
    EncInstX86 {
        bytes = bytes
        has_branch = false
        branch_field_off = 0 to u32
        target = 0 to u32
        reloc = EncRelocX86 { field_off = field_off; sym = sym; kind = kind }
    }
}

/**
 * emit_rr_x86 — append a register-to-register instruction (ModRM `mod=11`) to
 * `buf`: the REX prefix (from `reg`/`rm`'s widths + extensions), the optional
 * `0F` escape, the opcode, and the ModRM byte tying `reg` (the reg field) to
 * `rm` (the rm field). The caller fixes which operand is reg vs rm per opcode.
 *
 * @param []byte buf  the buffer to extend
 * @param bool rexw  set REX.W (the 64-bit form)
 * @param bool two_byte  the opcode is `0F`-escaped
 * @param u32 opcode  the primary opcode byte
 * @param MReg reg  the ModRM.reg-field register
 * @param MReg rm  the ModRM.rm-field register
 * @return []byte  `buf` followed by the encoded instruction
 */
fn emit_rr_x86(buf: []byte, rexw: bool, two_byte: bool, opcode: u32, reg: MReg, rm: MReg) -> []byte {
    mut b = push_rex_x86(buf, rexw, reg_ext_x86(reg), false, reg_ext_x86(rm))
    if two_byte { b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE) }
    b = push_byte_x86(b, opcode)
    push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, reg_low3_x86(reg), reg_low3_x86(rm)))
}

/**
 * emit_sse_rr_x86 — append a register-register SSE instruction: an optional
 * mandatory prefix byte (`X86_PREFIX_F2`/`F3`/`66`, or none), then the same
 * REX + `0F`-escape + opcode + ModRM shape as `emit_rr_x86` (every SSE opcode
 * this file emits is `0F`-escaped). Shared by the scalar float ALU/compare/
 * move/convert family (`B1-fp`): MOVSD/MOVSS, ADDSD/SUBSD/MULSD/DIVSD (and the
 * `SS` forms), UCOMISD/UCOMISS, MOVQ/MOVD, CVTSI2SD/CVTTSD2SI/CVTSD2SS/
 * CVTSS2SD.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 prefix  the mandatory SSE prefix byte, or `X86_NO_PREFIX`
 * @param bool rexw  set REX.W (the 64-bit GPR-crossing forms)
 * @param u32 opcode  the primary opcode byte (after the `0F` escape)
 * @param MReg reg  the ModRM.reg-field register
 * @param MReg rm  the ModRM.rm-field register
 * @return []byte  `buf` followed by the encoded instruction
 */
fn emit_sse_rr_x86(buf: []byte, prefix: u32, rexw: bool, opcode: u32, reg: MReg, rm: MReg) -> []byte {
    let b0 = if prefix != X86_NO_PREFIX { push_byte_x86(buf, prefix) } else { buf }
    emit_rr_x86(b0, rexw, true, opcode, reg, rm)
}

/**
 * emit_rm_ext_x86 — append a single-register instruction whose ModRM.reg field
 * is an OPCODE EXTENSION (`/0../7`), not a register: the REX prefix (from `rm`),
 * the opcode, and the ModRM byte `mod=11 | (ext_field<<3) | rm`. Drives the
 * unary `neg`/`not` (F7 /3, /2), the `shl`/`shr`/`sar` (D3 /4, /5, /7), and the
 * `idiv`/`div` (F7 /7, /6) forms.
 *
 * @param []byte buf  the buffer to extend
 * @param bool rexw  set REX.W (the 64-bit form)
 * @param u32 opcode  the primary opcode byte
 * @param u32 ext_field  the ModRM.reg opcode-extension value
 * @param MReg rm  the ModRM.rm-field register
 * @return []byte  `buf` followed by the encoded instruction
 */
fn emit_rm_ext_x86(buf: []byte, rexw: bool, opcode: u32, ext_field: u32, rm: MReg) -> []byte {
    mut b = push_rex_x86(buf, rexw, false, false, reg_ext_x86(rm))
    b = push_byte_x86(b, opcode)
    push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, ext_field, reg_low3_x86(rm)))
}

/**
 * push_mem_operand_x86 — append the ModRM + optional SIB + optional displacement
 * that address `mem` under a given `reg3` (the reg-field low 3 bits). A base of
 * RSP/R12 (low 3 == 4) always forces a SIB byte (`0x24`, no index); a base of
 * RBP/R13 (low 3 == 5) always carries at least a disp8 (its `mod=00` slot means
 * rip-relative). Zero displacements otherwise elide the disp; small ones take a
 * disp8; larger ones a disp32.
 *
 * @param []byte buf  the buffer to extend
 * @param u32 reg3  the ModRM.reg-field low 3 bits
 * @param MMem mem  the base-plus-displacement address operand
 * @return []byte  `buf` followed by the ModRM/SIB/disp bytes
 */
fn push_mem_operand_x86(buf: []byte, reg3: u32, mem: MMem) -> []byte {
    let base3 = reg_low3_x86(mem.base)
    let disp = mem.offset to i64
    let need_sib = base3 == X86_REG_RSP_ID
    let is_rbp = base3 == X86_REG_RBP_ID
    let zero_disp = disp == (0) && !is_rbp
    let disp8 = disp >= ((0) - X86_DISP8_MAGNITUDE) && disp <= X86_DISP8_MAX
    let md = if zero_disp { MODRM_MOD_INDIRECT } else { if disp8 { MODRM_MOD_DISP8 } else { MODRM_MOD_DISP32 } }
    let rm = if need_sib { X86_REG_RSP_ID } else { base3 }
    mut b = push_byte_x86(buf, modrm_x86(md, reg3, rm))
    if need_sib { b = push_byte_x86(b, (X86_REG_RSP_ID << X86_FIELD3_SHIFT) | base3) }
    if md == MODRM_MOD_DISP8 { b = push_byte_x86(b, (disp & X86_BYTE_MASK) to u32) }
    if md == MODRM_MOD_DISP32 { b = push_imm32_x86(b, disp) }
    b
}

/**
 * emit_mem_op_x86 — encode a memory-operand instruction (a load's `dst` or a
 * store's `src` as the register operand): the optional mandatory SSE prefix
 * (`B1-fp`), the optional `0x66` operand-size prefix, the REX prefix (with a
 * forced byte-register prefix when needed), the optional `0F` escape, the
 * opcode, and the ModRM/SIB/disp addressing `mem`.
 *
 * @param X86MemOp form  the size/sign encoding descriptor
 * @param MReg regop  the register operand (load dst / store src)
 * @param MMem mem  the memory operand
 * @return EncInstX86  the encoded memory instruction
 */
fn emit_mem_op_x86(form: X86MemOp, regop: MReg, mem: MMem) -> EncInstX86 {
    mut b: []byte = teko::list::empty()
    if form.mandatory_prefix != X86_NO_PREFIX { b = push_byte_x86(b, form.mandatory_prefix) }
    if form.op66 { b = push_byte_x86(b, X86_OPERAND_SIZE_PREFIX) }
    let force = form.byte_reg && (regop.id >= X86_BYTE_REG_MIN_ID)
    let rr = reg_ext_x86(regop)
    let rb = reg_ext_x86(mem.base)
    b = if force { push_rex_forced_x86(b, form.rexw, rr, false, rb) } else { push_rex_x86(b, form.rexw, rr, false, rb) }
    if form.two_byte { b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE) }
    b = push_byte_x86(b, form.opcode)
    plain_inst_x86(push_mem_operand_x86(b, reg_low3_x86(regop), mem))
}

/**
 * load_memop_x86 — the encoding descriptor for a load width + sign. Non-sign
 * loads ZERO-EXTEND (the isel's `select_load_x86` contract — `sign=false` loads
 * zero-extend, matching arm64's zero-extending LDRB/LDRH): dword `mov r32`
 * (`8B`, the r32 write clears bits 32..63), word `movzx r32, r/m16` (`0F B7`),
 * byte `movzx r32, r/m8` (`0F B6`), qword `mov r64` (`REX.W 8B`). A plain
 * `mov r8`/`mov r16` is REJECTED here — it leaves the destination's upper bits
 * stale, violating the zero-extend contract. Sign loads use `movsxd`(D,
 * `REX.W 63`) / `movsx`(W `REX.W 0F BF`, B `REX.W 0F BE`). The zero-extending
 * forms address memory (not an 8-bit register), so none sets `byte_reg`. The
 * float forms (`F32`/`F64`, `sign` ignored — a float access never sign-extends)
 * are `MOVSS`/`MOVSD` (`0F 10`, mandatory-prefixed `F3`/`F2`, `B1-fp`).
 *
 * @param MMemSizeX86 size  the access width (byte/word/dword/qword/f32/f64)
 * @param bool sign  true for a sign-extending narrow integer load (ignored
 *                   for a float size)
 * @return X86MemOp  the load encoding descriptor
 */
fn load_memop_x86(size: MMemSizeX86, sign: bool) -> X86MemOp {
    match size {
        Q => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOV_R_RM; byte_reg = false }
        D => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOVSXD; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_R_RM; byte_reg = false }
        }
        W => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = true; opcode = X86_OP_MOVSX_R32_RM16; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = true; opcode = X86_OP_MOVZX_R32_RM16; byte_reg = false }
        }
        B => if sign {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = true; opcode = X86_OP_MOVSX_R32_RM8; byte_reg = false }
        } else {
            X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = true; opcode = X86_OP_MOVZX_R32_RM8; byte_reg = false }
        }
        F64 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F2; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_LOAD; byte_reg = false }
        F32 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F3; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_LOAD; byte_reg = false }
    }
}

/**
 * store_memop_x86 — the encoding descriptor for a store width: `mov`(Q/D), the
 * `0x66`-prefixed word store(W), and the byte store(B, whose register source is
 * 8-bit and so sets `byte_reg`). Stores never sign-extend, so there is no sign
 * parameter (mirroring `MStoreX86` carrying no `sign` field). The float forms
 * (`F32`/`F64`) are `MOVSS`/`MOVSD` (`0F 11`, mandatory-prefixed `F3`/`F2`,
 * `B1-fp`).
 *
 * @param MMemSizeX86 size  the access width (byte/word/dword/qword/f32/f64)
 * @return X86MemOp  the store encoding descriptor
 */
fn store_memop_x86(size: MMemSizeX86) -> X86MemOp {
    match size {
        Q => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = true; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        D => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        W => X86MemOp { op66 = true; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM_R; byte_reg = false }
        B => X86MemOp { op66 = false; mandatory_prefix = X86_NO_PREFIX; rexw = false; two_byte = false; opcode = X86_OP_MOV_RM8_R8; byte_reg = true }
        F64 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F2; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_STORE; byte_reg = false }
        F32 => X86MemOp { op66 = false; mandatory_prefix = X86_PREFIX_F3; rexw = false; two_byte = true; opcode = X86_OP_SSE_MOV_STORE; byte_reg = false }
    }
}

/**
 * alu_opcode_x86 — the primary opcode byte for a two-address `OP r/m64, r64`
 * ALU op (the reg-into-rm direction isel selects): ADD `01`, SUB `29`, AND
 * `21`, OR `09`, XOR `31`.
 *
 * @param MAluOpX86 op  the ALU operation
 * @return u32  its `OP r/m, r` opcode byte
 */
fn alu_opcode_x86(op: MAluOpX86) -> u32 {
    match op {
        Add => X86_OP_ADD_RM_R
        Sub => X86_OP_SUB_RM_R
        And => X86_OP_AND_RM_R
        Or => X86_OP_OR_RM_R
        Xor => X86_OP_XOR_RM_R
    }
}

/**
 * shift_ext_x86 — the ModRM.reg opcode-extension for a `D3 /ext` shift-by-CL:
 * SHL `/4`, SHR `/5`, SAR `/7`.
 *
 * @param MShiftOpX86 op  the shift operation
 * @return u32  its opcode-extension value
 */
fn shift_ext_x86(op: MShiftOpX86) -> u32 {
    match op {
        Shl => X86_EXT_SHL
        Shr => X86_EXT_SHR
        Sar => X86_EXT_SAR
    }
}

/**
 * encode_movimm_x86 — `dst = imm` (MMovImmX86): `mov r32, imm32` (`B8+rd id`)
 * for the 32-bit form; `mov r64, imm32`(sign-extended, `REX.W C7 /0 id`) when
 * the 64-bit value fits a signed 32-bit field; else `movabs r64, imm64`
 * (`REX.W B8+rd io`, the arm64 MOVZ/MOVK-chain case).
 *
 * @param MMovImmX86 i  the immediate-move instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_movimm_x86(i: MMovImmX86) -> EncInstX86 {
    if !i.wide {
        mut b = push_rex_x86(teko::list::empty(), false, false, false, reg_ext_x86(i.dst))
        b = push_byte_x86(b, X86_OP_MOV_R_IMM + reg_low3_x86(i.dst))
        return plain_inst_x86(push_imm32_x86(b, i.imm64))
    }
    if fits_i32_x86(i.imm64) {
        mut b = push_rex_x86(teko::list::empty(), true, false, false, reg_ext_x86(i.dst))
        b = push_byte_x86(b, X86_OP_MOV_RM_IMM32)
        b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, 0 to u32, reg_low3_x86(i.dst)))
        return plain_inst_x86(push_imm32_x86(b, i.imm64))
    }
    mut b = push_rex_x86(teko::list::empty(), true, false, false, reg_ext_x86(i.dst))
    b = push_byte_x86(b, X86_OP_MOV_R_IMM + reg_low3_x86(i.dst))
    plain_inst_x86(push_imm64_x86(b, i.imm64))
}

/**
 * encode_mov_x86 — a GPR-GPR move (`mov r/m64, r64`, `REX.W 89 /r`): the source
 * rides the ModRM.reg field, the destination the rm field.
 *
 * @param MMovX86 i  the register-copy instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_mov_x86(i: MMovX86) -> EncInstX86 {
    plain_inst_x86(emit_rr_x86(teko::list::empty(), i.wide, false, X86_OP_MOV_RM_R, i.src, i.dst))
}

/**
 * encode_alu_rm_x86 — a two-address `dst = dst OP src` ALU op (`OP r/m64, r64`):
 * the source rides the ModRM.reg field, the read-modify-write destination the
 * rm field (§4.2). The preceding `MMovX86` seeded `dst` with the left operand.
 *
 * @param MAluRmX86 i  the two-address ALU instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_alu_rm_x86(i: MAluRmX86) -> EncInstX86 {
    plain_inst_x86(emit_rr_x86(teko::list::empty(), i.wide, false, alu_opcode_x86(i.op), i.src, i.dst))
}

/**
 * encode_imul_x86 — a two-address signed multiply (`imul r64, r/m64`,
 * `REX.W 0F AF /r`): unlike the `OP r/m, r` ALU direction, the DESTINATION
 * rides the ModRM.reg field and the source the rm field (the `0F AF` form).
 *
 * @param MImulX86 i  the multiply instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_imul_x86(i: MImulX86) -> EncInstX86 {
    plain_inst_x86(emit_rr_x86(teko::list::empty(), i.wide, true, X86_OP_IMUL_R_RM, i.dst, i.src))
}

/**
 * encode_divseq_x86 — the fixed-register division/remainder macro (MDivSeqX86)
 * expanded to its whole byte sequence: `mov rax, a` ; `cqo`(signed 64) /
 * `cdq`(signed 32) / `xor edx, edx`(unsigned) ; `idiv`/`div b` (`F7 /7` or
 * `/6`) ; `mov dst, rax` (quotient) or `mov dst, rdx` (remainder). RAX is id 0,
 * RDX id 2 (§3, §4.4).
 *
 * @param MDivSeqX86 i  the division/remainder instruction (operands physical)
 * @return EncInstX86  the encoded instruction sequence
 */
fn encode_divseq_x86(i: MDivSeqX86) -> EncInstX86 {
    let rax = preg(X86_REG_RAX_ID, MRegClass::GPR)
    let rdx = preg(X86_REG_RDX_ID, MRegClass::GPR)
    mut b = emit_rr_x86(teko::list::empty(), i.wide, false, X86_OP_MOV_RM_R, i.a, rax)
    if i.is_signed {
        if i.wide { b = push_byte_x86(b, REX_W_PREFIX) }
        b = push_byte_x86(b, X86_OP_CQO)
    } else {
        b = push_byte_x86(b, X86_OP_XOR_RM_R)
        b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, X86_REG_RDX_ID, X86_REG_RDX_ID))
    }
    let ext_field = if i.is_signed { X86_EXT_IDIV } else { X86_EXT_DIV }
    b = emit_rm_ext_x86(b, i.wide, X86_OP_GRP3_F7, ext_field, i.b)
    let srcreg = if i.is_rem { rdx } else { rax }
    plain_inst_x86(emit_rr_x86(b, i.wide, false, X86_OP_MOV_RM_R, srcreg, i.dst))
}

/**
 * encode_shift_x86 — a two-address shift-by-CL (`shl`/`shr`/`sar r/m64, cl`,
 * `D3 /ext`): the count was pre-moved to CL by a preceding `MMovX86`, so the
 * shift names only the shifted rm-field destination.
 *
 * @param MShiftX86 i  the shift instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_shift_x86(i: MShiftX86) -> EncInstX86 {
    plain_inst_x86(emit_rm_ext_x86(teko::list::empty(), i.wide, X86_OP_SHIFT_CL, shift_ext_x86(i.op), i.dst))
}

/**
 * encode_cmp_x86 — an integer compare (`cmp r/m64, r64`, `REX.W 39 /r`) that
 * sets the flags from `a - b`: `a` rides the ModRM.rm field, `b` the reg field.
 *
 * @param MCmpX86 i  the compare instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_cmp_x86(i: MCmpX86) -> EncInstX86 {
    plain_inst_x86(emit_rr_x86(teko::list::empty(), i.wide, false, X86_OP_CMP_RM_R, i.b, i.a))
}

/**
 * encode_setcc_raw_x86 — materialize a raw x86 condition-code field as a 0/1
 * value: `setcc dst8` (`0F 90+cc /0`) then `movzx dst32, dst8` (`0F B6 /r`). A
 * byte register SIL/DIL/BPL/SPL or R8..R15 (id >= 4) forces a REX prefix on
 * both halves so the low byte is addressable (§6.3). Shared by
 * `encode_setcc_x86` (whose `cc` comes from the shared `MCond` via
 * `cond_cc_x86`) and `encode_setp_x86` (whose `cc` is the PARITY field
 * directly, `X86_CC_P`/`NP` — a condition the shared `MCond` has no member
 * for, `B1-fp`).
 *
 * @param MReg dst  the destination register
 * @param u32 cc  the raw 4-bit x86 condition-code field
 * @return EncInstX86  the encoded instruction sequence
 */
fn encode_setcc_raw_x86(dst: MReg, cc: u32) -> EncInstX86 {
    let force = dst.id >= X86_BYTE_REG_MIN_ID
    let dst_ext = reg_ext_x86(dst)
    let dst_low3 = reg_low3_x86(dst)
    mut b = if force { push_rex_forced_x86(teko::list::empty(), false, false, false, dst_ext) } else { teko::list::empty() }
    b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_SETCC_BASE + cc)
    b = push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, 0 to u32, dst_low3))
    if force { b = push_rex_forced_x86(b, false, dst_ext, false, dst_ext) }
    b = push_byte_x86(b, X86_OP_TWO_BYTE_ESCAPE)
    b = push_byte_x86(b, X86_OP_MOVZX_R32_RM8)
    plain_inst_x86(push_byte_x86(b, modrm_x86(MODRM_MOD_REGISTER, dst_low3, dst_low3)))
}

/**
 * encode_setcc_x86 — materialize a preceding compare as a 0/1 value through
 * `encode_setcc_raw_x86`, over the shared `MCond`'s x86 condition field.
 *
 * @param MSetccX86 i  the conditional-set instruction (operand physical)
 * @return EncInstX86  the encoded instruction sequence
 */
fn encode_setcc_x86(i: MSetccX86) -> EncInstX86 {
    encode_setcc_raw_x86(i.dst, cond_cc_x86(i.cond))
}

/**
 * encode_setp_x86 — materialize a preceding `MFCmpX86`'s PARITY flag as a
 * plain value through `encode_setcc_raw_x86`, over the raw `X86_CC_P`/`NP`
 * condition field (`B1-fp` — the half of `select_fcmp_value_x86`'s ordered-
 * equal / unordered-not-equal composite the shared `MCond` cannot express).
 *
 * @param MSetPX86 i  the parity-set instruction (operand physical)
 * @return EncInstX86  the encoded instruction sequence
 */
fn encode_setp_x86(i: MSetPX86) -> EncInstX86 {
    encode_setcc_raw_x86(i.dst, if i.is_np { X86_CC_NP } else { X86_CC_P })
}

/**
 * encode_falu_x86 — a two-address scalar float ALU op (`ADDSD`/`SUBSD`/
 * `MULSD`/`DIVSD` or the `SS` forms, `0F 58`/`5C`/`59`/`5E`, mandatory-
 * prefixed `F2`/`F3`): the read-modify-write destination rides the ModRM.reg
 * field, `src` the rm field — the SSE "xmm1, xmm2/m64" convention, where
 * xmm1 is BOTH the destination and the reg-field operand (the same direction
 * as `encode_imul_x86`'s `0F AF`, unlike the integer `OP r/m,r` ALU family).
 * The preceding `MFMovX86` seeded `dst` with the left operand (§4.2).
 *
 * @param MFAluX86 i  the two-address float ALU instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_falu_x86(i: MFAluX86) -> EncInstX86 {
    let prefix = if i.dbl { X86_PREFIX_F2 } else { X86_PREFIX_F3 }
    let opcode = match i.op { FAdd => X86_OP_SSE_ADD; FSub => X86_OP_SSE_SUB; FMul => X86_OP_SSE_MUL; FDiv => X86_OP_SSE_DIV }
    plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), prefix, false, opcode, i.dst, i.src))
}

/**
 * encode_fmov_x86 — a register-register move whose operands' `reg_class`
 * fields pick the concrete SSE form (`B1-fp`): FPR-to-FPR is `MOVSD`/`MOVSS`
 * (`0F 10`, mandatory-prefixed `F2`/`F3`, reg field is the destination);
 * GPR-to-FPR is `MOVQ`/`MOVD` LOAD (`66 [REX.W] 0F 6E`, reg field is the FPR
 * destination); FPR-to-GPR is `MOVQ`/`MOVD` STORE (`66 [REX.W] 0F 7E`, reg
 * field is the FPR SOURCE — the store-direction convention, opposite of the
 * load form). GPR-to-GPR (unreached by any selector, which always routes a
 * same-class copy through `MMovX86`) falls back to the plain integer `mov`.
 *
 * @param MFMovX86 i  the move instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_fmov_x86(i: MFMovX86) -> EncInstX86 {
    let dst_fpr = i.dst.reg_class == MRegClass::FPR
    let src_fpr = i.src.reg_class == MRegClass::FPR
    if dst_fpr && src_fpr {
        let prefix = if i.dbl { X86_PREFIX_F2 } else { X86_PREFIX_F3 }
        return plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), prefix, false, X86_OP_SSE_MOV_LOAD, i.dst, i.src))
    }
    if dst_fpr && !src_fpr {
        return plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_66, i.dbl, X86_OP_MOVQD_LOAD, i.dst, i.src))
    }
    if !dst_fpr && src_fpr {
        return plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_66, i.dbl, X86_OP_MOVQD_STORE, i.src, i.dst))
    }
    plain_inst_x86(emit_rr_x86(teko::list::empty(), i.dbl, false, X86_OP_MOV_RM_R, i.src, i.dst))
}

/**
 * encode_fcmp_x86 — a scalar float compare (`UCOMISD`/`UCOMISS`, `0F 2E`) that
 * sets the flags from `a <=> b`: `a` rides the ModRM.reg field, `b` the rm
 * field. `UCOMISD` is mandatory-prefixed `66`; `UCOMISS` carries no mandatory
 * prefix (`B1-fp`).
 *
 * @param MFCmpX86 i  the compare instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_fcmp_x86(i: MFCmpX86) -> EncInstX86 {
    let prefix = if i.dbl { X86_PREFIX_66 } else { X86_NO_PREFIX }
    plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), prefix, false, X86_OP_UCOMIS, i.a, i.b))
}

/**
 * encode_cvt_x86 — an int/float conversion (`CVTSI2SD`/`CVTTSD2SI`/`CVTTSS2SI`/
 * `CVTSD2SS`/`CVTSS2SD`, `0F 2A`/`2C`/`5A`): `Cvtsi2sd`/`Cvttsd2si` are
 * mandatory-prefixed `F2` with `REX.W` (the GPR side is always the wide 64-bit
 * form, `B1-fp`) and `Cvttss2si` is their `F3`-prefixed single-precision twin;
 * `Cvtsd2ss` is mandatory-prefixed `F2` (narrowing FROM double), `Cvtss2sd`
 * mandatory-prefixed `F3` (widening FROM single) — neither of those two sets
 * `REX.W` (both their operands are FPR).
 *
 * @param MCvtX86 i  the conversion instruction (operands physical)
 * @return EncInstX86  the encoded instruction
 */
fn encode_cvt_x86(i: MCvtX86) -> EncInstX86 {
    match i.op {
        Cvtsi2sd => plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_F2, true, X86_OP_CVTSI2S, i.dst, i.src))
        Cvttsd2si => plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_F2, true, X86_OP_CVTTS2SI, i.dst, i.src))
        Cvttss2si => plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_F3, true, X86_OP_CVTTS2SI, i.dst, i.src))
        Cvtsd2ss => plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_F2, false, X86_OP_CVTS2S, i.dst, i.src))
        Cvtss2sd => plain_inst_x86(emit_sse_rr_x86(teko::list::empty(), X86_PREFIX_F3, false, X86_OP_CVTS2S, i.dst, i.src))
    }
}

/**
 * encode_neg_x86 — a two-address negate (`neg r/m64`, `F7 /3`).
 *
 * @param MNegX86 i  the negate instruction (operand physical)
 * @return EncInstX86  the encoded instruction
 */
