use teko::checker
use teko::lexer
use teko::parser
use teko::lir

fn rmt_prim(k: checker::PrimKind): @Type() { checker::Prim { kind = k } }

fn rmt_num(v: u64): checker::TExpr {
    checker::TExpr { kind = checker::TNumber { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; type = rmt_prim(checker::PrimKind::I64); line = 0; col = 0 }
}

fn rmt_int_pattern(v: u64): @Pattern() {
    parser::LiteralPattern { value = parser::Expr { kind = parser::Number { is_float = false; value = parser::numint_of_u64(v); fval = 0.0 }; line = 0; col = 0 } }
}

fn rmt_wild_pattern(): @Pattern() { parser::WildcardPattern { } }

fn rmt_arm(pat: @Pattern(), val: u64): checker::TArm {
    var body = teko::list::push(teko::list::empty(), checker::TExprStmt { expr = rmt_num(val) })
    checker::TArm { pattern = pat; has_when = false; guard = rmt_num(0 to u64); body = body }
}

fn rmt_match_module(): MModule | error {
    var subject = rmt_num(5 to u64)
    var arm0 = rmt_arm(rmt_int_pattern(1 to u64), 40 to u64)
    var arm1 = rmt_arm(rmt_int_pattern(2 to u64), 41 to u64)
    var arm2 = rmt_arm(rmt_wild_pattern(), 42 to u64)
    var arms = teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), arm0), arm1), arm2)
    var match_expr = checker::TExpr { kind = checker::TMatchExpr { subject = subject; arms = arms }; type = rmt_prim(checker::PrimKind::I64); line = 0; col = 0 }
    var no_params: []parser::Param = teko::list::empty()
    var body = teko::list::push(teko::list::empty(), checker::TReturn { has_value = true; value = match_expr; values = teko::list::empty() })
    var f = checker::TFunction { overload_suffix = "";
        name = "pick"; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        namespace = "teko::demo"; params = no_params; return_type = rmt_prim(checker::PrimKind::I64); body = body
        vis = parser::Visibility::Private; has_doc = false; doc = parser::docspan_none()
        file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""
        has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
    var lf = match lir::lower_function(f, checker::tt_empty()) { lir::LoweredFunction as r => r.func; error as e => return e }
    select_module(lir::add_func(lir::empty_module(), lf))
}

fn rmt_dead_block(f: MFunc, reachable: []u32): u32 {
    var i: u64 = 0
    loop {
        if i >= f.blocks.len { break }
        var bid = f.blocks[i].id
        if !u32_in(reachable, bid) { return bid }
        i++
    }
    f.blocks[0].id
}

fn rmt_has_raw_retreat(stream: []NumberedInst, order: []u32): bool {
    var i: u64 = 0
    loop {
        if i >= stream.len { break }
        var ni = stream[i]
        var t = terminator_target(ni.inst)
        if t.has {
            if block_pos(order, t.target) <= block_pos(order, ni.block_id) { return true }
        }
        i++
    }
    false
}

#test
fn rmt_match_wildcard_fallback_is_reachability_excluded() {
    var mm = match rmt_match_module() { MModule as x => x; error => return }
    var f = mm.funcs[0]
    teko::assert::is_true(f.blocks.len == (8 to u64))
    var order = rpo_block_order(f)
    var reachable = reachable_blocks(f)
    teko::assert::is_true(reachable.len == (7 to u64))
    var dead = rmt_dead_block(f, reachable)
    teko::assert::is_true(!u32_in(reachable, dead))
    teko::assert::is_true(block_pos(order, dead) == ((order.len - 1) to u32))
    var succs = block_successors(f, dead)
    teko::assert::is_true(succs.len == (1 to u64))
    var merge = succs[0]
    teko::assert::is_true(block_pos(order, merge) < block_pos(order, dead))
    var stream = number_insts(f, order)
    teko::assert::is_true(rmt_has_raw_retreat(stream, order))
    teko::assert::is_true(natural_loops(stream, order, reachable).len == (0 to u64))
}

#test
fn rmt_regalloc_match_allocates_and_preserves() {
    var mm = match rmt_match_module() { MModule as x => x; error => return }
    var f = mm.funcs[0]
    var is_err = match regalloc_func(AAPCS64, f) { MFunc => false; error => true }
    teko::assert::is_true(!is_err)
    var colored = match regalloc_module(AAPCS64, mm) { MModule as x => x; error => return }
    teko::assert::is_true(all_physical(colored.funcs[0]))
}

#test
fn rmt_reachable_blocks_empty_function() {
    var empty_f = MFunc { symbol = "main"; blocks = teko::list::empty(); frame = teko::list::empty() }
    teko::assert::is_true(reachable_blocks(empty_f).len == (0 to u64))
}
