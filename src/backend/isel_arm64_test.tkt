use teko::lir

/**
 * iat_bin — append `%r = op a, b` to `f0`, returning the advanced function
 * plus the fresh result VReg (a fixture-building shorthand shared by every
 * test below).
 *
 * @param lir::LFunc f0  the function to extend
 * @param lir::LBinOp op  the binary op
 * @param u32 a  the first operand VReg
 * @param u32 b  the second operand VReg
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn iat_bin(f0: lir::LFunc, op: lir::LBinOp, a: u32, b: u32): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::bin_inst(r.vreg, op, a, b, 0, 0)); vreg = r.vreg }
}

/**
 * iat_un — append `%r = op a` to `f0`, returning the advanced function plus
 * the fresh result VReg.
 *
 * @param lir::LFunc f0  the function to extend
 * @param lir::LUnOp op  the unary op
 * @param u32 a  the operand VReg
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn iat_un(f0: lir::LFunc, op: lir::LUnOp, a: u32): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::un_inst(r.vreg, op, a, 0, 0)); vreg = r.vreg }
}

/**
 * iat_const — append `%r = const val` to `f0`, returning the advanced
 * function plus the fresh result VReg.
 *
 * @param lir::LFunc f0  the function to extend
 * @param i64 val  the literal value
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn iat_const(f0: lir::LFunc, val: i64): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_int_inst(r.vreg, val, 0, 0)); vreg = r.vreg }
}

/**
 * iat_const_float — append `%r = const.float bits` to `f0`, returning the
 * advanced function plus the fresh result VReg.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u64 bits  the IEEE bit pattern
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn iat_const_float(f0: lir::LFunc, bits: u64): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_float_inst(r.vreg, bits, true, 0, 0)); vreg = r.vreg }
}

/**
 * iat_f32_const — append an `f32`-DECLARED float literal to `f0`, its `bits`
 * still the f64 pattern (`LConstFloat`'s own contract) and its `wide` flag
 * false. The sibling of `iat_const_float` for the road an `f32` literal takes,
 * which is a different one: it owes a narrowing convert.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u64 bits  the literal's f64 IEEE bit pattern
 * @return lir::FreshVReg  the advanced function + the literal's VReg
 */
fn iat_f32_const(f0: lir::LFunc, bits: u64): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_float_inst(r.vreg, bits, false, 0, 0)); vreg = r.vreg }
}

/**
 * iat_ret — append `ret value` to `f0`.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u32 value  the returned VReg
 * @return lir::LFunc  the advanced function
 */
fn iat_ret(f0: lir::LFunc, value: u32): lir::LFunc {
    lir::append_inst(f0, 0, lir::ret_inst(value, 0, 0))
}

/**
 * iat_two_i64_params — a fresh 2-param (I64, I64) -> I64 function named
 * `sym`, its entry block already carrying both `LParam` instructions.
 *
 * @param str sym  the function's symbol
 * @return lir::LFunc  the seeded function
 */
fn iat_two_i64_params(sym: str): lir::LFunc {
    var ptypes = teko::list::push(teko::list::push(teko::list::empty(), lir::LType::I64), lir::LType::I64)
    var f = lir::new_func(sym, 2, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
}
/**
 * iat_main_ret — a zero-param `main` returning a fully-built expression
 * (the "straight-line, no calls" analog of `lir_interp_test.tkt`'s F1-F5:
 * A2-2 does not yet select `LCall`, so the equivalence fixtures below use a
 * plain `ret` in place of a `tk_exit`).
 *
 * @return lir::LFunc  the seeded, empty-bodied function
 */
fn iat_main_ret(): lir::LFunc {
    lir::new_func("main", 0, teko::list::empty(), lir::LType::I32)
}

#test
fn iat_const_minus_one_is_a_single_movn_with_zero_imm() {
    var c = iat_const(iat_main_ret(), -1)
    var f = iat_ret(c.func, c.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "movn.x %0, #0, lsl #0")
}

#test
fn iat_materialize_bits_narrow_form_direct() {
    var ctx0 = SelCtx { func = new_mfunc("main"); vinfo = vinfo_empty(); next_scratch = 0; cur_block = 0; next_block = 1 }
    var ctx1 = materialize_bits(ctx0, vreg(0, MRegClass::GPR), 42 to u64, false)
    var text = minst_print(add_mfunc(empty_mmodule(), ctx1.func))
    teko::assert::str_contains(text, "movz.w %0, #42, lsl #0")
}

/**
 * iat_kitchen_sink — a two-param (I64,I64) function exercising every
 * `LBinOp` arithmetic/bitwise/shift/compare case plus every `LUnOp` case
 * (the coverage sweep for `select_bin`/`select_un`'s full dispatch),
 * ending `ret`. Assertions below are ROBUST — they check the opcode
 * mnemonic appears, not exact register numbers (ids shift as the fixture
 * grows).
 *
 * @return lir::LFunc  the built function
 */
fn iat_kitchen_sink(): lir::LFunc {
    var f = iat_two_i64_params("teko__demo__kitchen_sink")
    f = iat_bin(f, lir::LBinOp::IAdd, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ISub, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IMul, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IDivS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IDivU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IRemS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IRemU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IAnd, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IOr, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IXor, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IShl, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IShrS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::IShrU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpEq, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpNe, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpLtS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpLtU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpLeS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpLeU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpGtS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpGtU, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpGeS, 0, 1).func
    f = iat_bin(f, lir::LBinOp::ICmpGeU, 0, 1).func
    f = iat_un(f, lir::LUnOp::INeg, 0).func
    f = iat_un(f, lir::LUnOp::INot, 0).func
    f = iat_un(f, lir::LUnOp::Trunc, 0).func
    f = iat_un(f, lir::LUnOp::ZExt, 0).func
    var last = iat_un(f, lir::LUnOp::SExt, 0)
    f = last.func
    iat_ret(f, last.vreg)
}

#test
fn iat_kitchen_sink_covers_every_int_bin_and_un_op() {
    var mf = match select_lfunc(iat_kitchen_sink()) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "add.x ")
    teko::assert::str_contains(text, "sub.x ")
    teko::assert::str_contains(text, "mul.x ")
    teko::assert::str_contains(text, "sdiv.x ")
    teko::assert::str_contains(text, "udiv.x ")
    teko::assert::str_contains(text, "msub.x ")
    teko::assert::str_contains(text, "and.x ")
    teko::assert::str_contains(text, "orr.x ")
    teko::assert::str_contains(text, "eor.x ")
    teko::assert::str_contains(text, "lsl.x ")
    teko::assert::str_contains(text, "asr.x ")
    teko::assert::str_contains(text, "lsr.x ")
    teko::assert::str_contains(text, "cset.w ")
    teko::assert::str_contains(text, "eq")
    teko::assert::str_contains(text, "ne")
    teko::assert::str_contains(text, "lt")
    teko::assert::str_contains(text, "lo")
    teko::assert::str_contains(text, "le")
    teko::assert::str_contains(text, "ls")
    teko::assert::str_contains(text, "gt")
    teko::assert::str_contains(text, "hi")
    teko::assert::str_contains(text, "ge")
    teko::assert::str_contains(text, "hs")
    teko::assert::str_contains(text, "neg.x ")
    teko::assert::str_contains(text, "mvn.x ")
    teko::assert::str_contains(text, "mov.w ")
}

/**
 * iat_float_kitchen_sink — a two-float-const function exercising every
 * `LBinOp` float case plus `FNeg`/`IToF`/`FToI`/`FToF` (the coverage sweep
 * for the float side of `select_bin`/`select_un`).
 *
 * @return lir::LFunc  the built function
 */
fn iat_float_kitchen_sink(): lir::LFunc {
    var f = iat_two_i64_params("teko__demo__float_kitchen_sink")
    var a = iat_const_float(f, 4607182418800017408 to u64)
    f = a.func
    var b = iat_const_float(f, 4611686018427387904 to u64)
    f = b.func
    f = iat_bin(f, lir::LBinOp::FAdd, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FSub, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FMul, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FDiv, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpEq, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpNe, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpLt, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpLe, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpGt, a.vreg, b.vreg).func
    f = iat_bin(f, lir::LBinOp::FCmpGe, a.vreg, b.vreg).func
    f = iat_un(f, lir::LUnOp::FNeg, a.vreg).func
    f = iat_un(f, lir::LUnOp::IToF, 0).func
    f = iat_un(f, lir::LUnOp::FToI, a.vreg).func
    var last = iat_un(f, lir::LUnOp::FToF, a.vreg)
    f = last.func
    iat_ret(f, last.vreg)
}

#test
fn iat_float_kitchen_sink_covers_every_float_op() {
    var mf = match select_lfunc(iat_float_kitchen_sink()) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fadd.d ")
    teko::assert::str_contains(text, "fsub.d ")
    teko::assert::str_contains(text, "fmul.d ")
    teko::assert::str_contains(text, "fdiv.d ")
    teko::assert::str_contains(text, "fcmp.d ")
    teko::assert::str_contains(text, "fneg.d ")
    teko::assert::str_contains(text, "scvtf.dx ")
    teko::assert::str_contains(text, "fcvtzs.xd ")
    teko::assert::str_contains(text, "fcvt.sd ")
}

/**
 * iat_f32_const_narrows_and_records_single — the `f32` LITERAL road, which is
 * not the `f64` one: `LConstFloat.bits` is always the f64 pattern, so an
 * `f32`-declared literal must be STAGED into a double and then narrowed by
 * `FCVT Sd, Dn`, and the value must be recorded SINGLE so every later
 * width-sensitive decision reads `.s`. Asserting the narrowing convert is
 * present AND that the following float op selected the `.s` form is what
 * distinguishes a real narrowing from a bit pattern left at double width.
 */
#test
fn iat_f32_const_narrows_and_records_single() {
    var f = iat_two_i64_params("teko__demo__f32_literal")
    var a = iat_f32_const(f, 4612811918334230528 to u64)
    f = a.func
    var sum = iat_bin(f, lir::LBinOp::FAdd, a.vreg, a.vreg)
    f = iat_ret(sum.func, sum.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fcvt.sd ")
    teko::assert::str_contains(text, "fadd.s ")
}

/**
 * iat_f32_ftof_widens — the reverse direction: an `FToF` whose OPERAND is a
 * single widens, so the selected convert must be `fcvt.ds` (destination double,
 * source single). A direction read from the wrong end is the defect this pins.
 */
#test
fn iat_f32_ftof_widens() {
    var f = iat_two_i64_params("teko__demo__f32_widen")
    var a = iat_f32_const(f, 4612811918334230528 to u64)
    f = a.func
    var wide = iat_un(f, lir::LUnOp::FToF, a.vreg)
    f = iat_ret(wide.func, wide.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fcvt.ds ")
}

/**
 * iat_f32_ftoi_reads_single — an `FToI` over a SINGLE operand must read the
 * source at single width (`fcvtzs.ds`: destination the wide integer, source the
 * single float). Reading it as a double decodes 32 live bits as a double's low
 * half and truncates to nonsense — a silently wrong VALUE, not a crash.
 */
#test
fn iat_f32_ftoi_reads_single() {
    var f = iat_two_i64_params("teko__demo__f32_to_int")
    var a = iat_f32_const(f, 4612811918334230528 to u64)
    f = a.func
    var n = iat_un(f, lir::LUnOp::FToI, a.vreg)
    f = iat_ret(n.func, n.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fcvtzs.xs ")
}

/**
 * iat_float_lt_le_take_the_ordered_conditions — an `FCmpLt`/`FCmpLe` must land
 * on the NaN-correct `lo`/`ls` conditions, never the signed-integer `lt`/`le`
 * (which read TRUE on an `FCMP`'s unordered result, making `nan < x` true).
 */
#test
fn iat_float_lt_le_take_the_ordered_conditions() {
    var f = iat_two_i64_params("teko__demo__float_order")
    var a = iat_const_float(f, 4607182418800017408 to u64)
    f = a.func
    var b = iat_const_float(f, 4611686018427387904 to u64)
    f = b.func
    var lt = iat_bin(f, lir::LBinOp::FCmpLt, a.vreg, b.vreg)
    f = lt.func
    var le = iat_bin(f, lir::LBinOp::FCmpLe, a.vreg, b.vreg)
    f = iat_ret(le.func, le.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, ", lo")
    teko::assert::str_contains(text, ", ls")
    teko::assert::is_true(!teko::str::contains(text, ", lt"))
    teko::assert::is_true(!teko::str::contains(text, ", le"))
}

#test
fn iat_void_ret_selects_bare_ret() {
    var f = lir::append_inst(iat_main_ret(), 0, lir::ret_void_inst(0, 0))
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "ret")
}

/**
 * iat_one_param_func — a single-parameter function of machine class `ty`
 * (its own return type too, so a scalar `ret` is well-formed), its param
 * already read via `LParam` and returned directly — the coverage sweep for
 * `mregclass_of_ltype`/`ltype_is_wide`'s full per-`LType` dispatch.
 *
 * @param lir::LType ty  the parameter's (and return's) machine class
 * @return lir::LFunc  the built function
 */
fn iat_one_param_func(ty: lir::LType): lir::LFunc {
    var ptypes = teko::list::push(teko::list::empty(), ty)
    var f = lir::new_func("teko__demo__one_param", 1, ptypes, ty)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    iat_ret(f, 0)
}

/**
 * iat_select_succeeds — whether `select_lfunc(f)` selects without error.
 *
 * @param lir::LFunc f  the function to select
 * @return bool  whether selection succeeded
 */
fn iat_select_succeeds(f: lir::LFunc): bool {
    match select_lfunc(f) { MFunc => true; error => false }
}

#test
fn iat_select_param_covers_every_scalar_machine_class() {
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I8)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I16)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I32)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I64)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::Ptr)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::Void)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::F32)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::F64)))
}

/**
 * iat_mixed_gpr_fpr_params — a 3-param function `(F64, I64, F64)`: proves
 * the AAPCS64 classifier counts EACH register file independently
 * (`gpr_index_before`/`fpr_index_before`, §3.5) — param 1 (I64) walks ONE
 * earlier FPR entry (the classifier's GPR-count "no match" branch); param
 * 2 (F64) walks a MIXED earlier pair, one FPR match and one GPR non-match
 * (both branches of the FPR-count loop in a single call).
 *
 * @return lir::LFunc  the built function
 */
fn iat_mixed_gpr_fpr_params(): lir::LFunc {
    var t1 = teko::list::push(teko::list::empty(), lir::LType::F64)
    var t2 = teko::list::push(t1, lir::LType::I64)
    var ptypes = teko::list::push(t2, lir::LType::F64)
    var f = lir::new_func("teko__demo__mixed_params", 3, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(2, 2, 0, 0))
    iat_ret(f, 1)
}

#test
fn iat_mixed_gpr_fpr_params_assigns_independent_class_slots() {
    var mf = match select_lfunc(iat_mixed_gpr_fpr_params()) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fmov.d %0, %p0")
    teko::assert::str_contains(text, "mov.x %1, %p0")
    teko::assert::str_contains(text, "fmov.d %2, %p1")
}

/**
 * iat_dump — select `f` and render the machine module as text (the A2-3
 * golden-dump fixtures assert against key lines of this).
 *
 * @param lir::LFunc f  the function to select and print
 * @return str  the rendered machine text ("" on a selection error)
 */
fn iat_dump(f: lir::LFunc): str {
    var mf = match select_lfunc(f) { MFunc as x => x; error => return "" }
    minst_print(add_mfunc(empty_mmodule(), mf))
}

#test
fn iat_a24_global_addr_is_adrp_add_data_reloc() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var v = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(v.func, 0, lir::global_addr_inst(v.vreg, ".Lstr0", 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "adrp.page_hi %0, @.Lstr0")
    teko::assert::str_contains(text, "add_lo.page_lo %0, %0, @.Lstr0")
}

#test
fn iat_a25_call_indirect_is_blr_through_target() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var t = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(t.func, 0, lir::alloca_inst(t.vreg, 8, 8, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::void_call_indirect_inst(t.vreg, teko::list::empty(), false, 0, 0))
    var s2 = lir::append_inst(s1, 0, lir::ret_inst(t.vreg, 0, 0))
    teko::assert::str_contains(iat_dump(s2), "call.indirect %0()")
}

#test
/**
 * an `LFuncAddr` lowers to the SAME page/page-off ADRP+ADD pair a global address
 * does. It used to print `adrp.call`/`add_lo.call`, i.e. a `BRANCH26` relocation
 * tagged onto an ADRP and onto an ADD, which Apple's `ld` refuses to link; a
 * relocation type names the instruction field being patched, not the target's
 * section.
 */
fn iat_a24_func_addr_is_adrp_add_page_reloc() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var v = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(v.func, 0, lir::func_addr_inst(v.vreg, "teko__demo__f", 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "adrp.page_hi %0, @teko__demo__f")
    teko::assert::str_contains(text, "add_lo.page_lo %0, %0, @teko__demo__f")
}

#test
fn iat_a25_call_with_result_moves_x0_out() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var r = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__f", teko::list::empty(), false, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "call @teko__demo__f() -> %p0")
    teko::assert::str_contains(text, "mov.x %0, %p0")
}

/**
 * iat_guarded_div_func — the div-by-zero guard's exact LIR shape, hand-built from the SAME
 * primitives `teko::lir::lower_div_zero_guard` composes (`const_int_inst`, `bin_inst(ICmpNe)`,
 * `alloc_block`, `branch_inst`, `void_call_inst("tk_panic_div0")`, `jump_inst`) ahead of one
 * guarded `op` over two `i64` params — the isel-level proof that A2's compare/branch/call
 * machinery selects this COMPOSITE shape without a stop (0.3.1 div-by-zero-nativo).
 *
 * @param lir::LBinOp op  the guarded division/remainder opcode (`IDivS`/`IDivU`/`IRemS`/`IRemU`)
 * @return lir::LFunc  `%0`,`%1` = params (dividend, divisor); `%2` = `const 0`; `%3` = `%1 !=
 *                      %2`; branch `%3` to an "ok" block (else a "trap" block); trap calls
 *                      `tk_panic_div0()` then jumps to itself (dead, never returns); ok computes
 *                      `op(%0, %1)` and returns it
 */
fn iat_guarded_div_func(op: lir::LBinOp): lir::LFunc {
    var ptypes = teko::list::push(teko::list::push(teko::list::empty(), lir::LType::I64), lir::LType::I64)
    var f = lir::new_func("teko__demo__guarded_div", 2, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
    var z = lir::alloc_vreg(f)
    f = lir::append_inst(z.func, 0, lir::const_int_inst(z.vreg, 0, 0, 0))
    var c = lir::alloc_vreg(f)
    f = lir::append_inst(c.func, 0, lir::bin_inst(c.vreg, lir::LBinOp::ICmpNe, 1, z.vreg, 0, 0))
    var okb = lir::alloc_block(f)
    f = okb.func
    var trapb = lir::alloc_block(f)
    f = trapb.func
    f = lir::append_inst(f, 0, lir::branch_inst(c.vreg, okb.block_id, teko::list::empty(), trapb.block_id, teko::list::empty(), 0, 0))
    f = lir::append_inst(f, trapb.block_id, lir::void_call_inst("tk_panic_div0", teko::list::empty(), false, 0, 0))
    f = lir::append_inst(f, trapb.block_id, lir::jump_inst(trapb.block_id, teko::list::empty(), 0, 0))
    var q = lir::alloc_vreg(f)
    f = lir::append_inst(q.func, okb.block_id, lir::bin_inst(q.vreg, op, 0, 1, 0, 0))
    lir::append_inst(f, okb.block_id, lir::ret_inst(q.vreg, 0, 0))
}

#test
/**
 * iat_div_zero_guard_selects_compare_branch_call_and_selfloop — the guard's ICmpNe fuses into
 * a `cmp` at the branch site (`%1` is used exactly once, by the branch — `is_fused_compare`),
 * takes the nonzero edge on `NE`, calls the SAME `tk_panic_div0` runtime symbol the C route's
 * `tk_div_*`/`tk_mod_*` already call, and closes the trap block with an unconditional branch TO
 * ITSELF (the dead terminator `lower_div_zero_guard` documents — the call never returns).
 *
 * @return void
 */
fn iat_div_zero_guard_selects_compare_branch_call_and_selfloop() {
    var text = iat_dump(iat_guarded_div_func(lir::LBinOp::IDivS))
    teko::assert::str_contains(text, "cmp.x %1, %2")
    teko::assert::str_contains(text, "b.ne #M")
    teko::assert::str_contains(text, "call @tk_panic_div0()")
    teko::assert::str_contains(text, "b #M2")
}

#test
/**
 * iat_div_zero_guard_ok_path_selects_every_guarded_op — the guard's "ok" block (reached once
 * the divisor is proven nonzero) still selects the SAME per-op instruction the unguarded kitchen
 * sink already covers (`sdiv`/`udiv` for `/`, the two-instruction `sdiv`/`udiv`+`msub` for `%`) —
 * the guard changes nothing about the division/remainder itself, only what precedes it.
 *
 * @return void
 */
fn iat_div_zero_guard_ok_path_selects_every_guarded_op() {
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IDivS)), "sdiv.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IDivU)), "udiv.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IRemS)), "msub.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IRemU)), "msub.x ")
}
