#test
fn iat_float_lt_le_take_the_ordered_conditions() {
    var f = iat_two_i64_params("teko__demo__float_order")
    var a = iat_const_float(f, 4607182418800017408 to u64)
    f = a.func
    var b = iat_const_float(f, 4611686018427387904 to u64)
    f = b.func
    var lt = iat_bin(f, lir::LBinOp::FCmpLt, a.vreg, b.vreg)
    f = lt.func
    var le = iat_bin(f, lir::LBinOp::FCmpLe, a.vreg, b.vreg)
    f = iat_ret(le.func, le.vreg)
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, ", lo")
    teko::assert::str_contains(text, ", ls")
    teko::assert::is_true(!teko::str::contains(text, ", lt"))
    teko::assert::is_true(!teko::str::contains(text, ", le"))
}

#test
fn iat_void_ret_selects_bare_ret() {
    var f = lir::append_inst(iat_main_ret(), 0, lir::ret_void_inst(0, 0))
    var mf = match select_lfunc(f) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "ret")
}

fn iat_one_param_func(ty: lir::LType): lir::LFunc {
    var ptypes = teko::list::push(teko::list::empty(), ty)
    var f = lir::new_func("teko__demo__one_param", 1, ptypes, ty)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    iat_ret(f, 0)
}

fn iat_select_succeeds(f: lir::LFunc): bool {
    match select_lfunc(f) { MFunc => true; error => false }
}

#test
fn iat_select_param_covers_every_scalar_machine_class() {
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I8)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I16)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I32)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::I64)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::Ptr)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::Void)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::F32)))
    teko::assert::is_true(iat_select_succeeds(iat_one_param_func(lir::LType::F64)))
}

fn iat_mixed_gpr_fpr_params(): lir::LFunc {
    var t1 = teko::list::push(teko::list::empty(), lir::LType::F64)
    var t2 = teko::list::push(t1, lir::LType::I64)
    var ptypes = teko::list::push(t2, lir::LType::F64)
    var f = lir::new_func("teko__demo__mixed_params", 3, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(2, 2, 0, 0))
    iat_ret(f, 1)
}

#test
fn iat_mixed_gpr_fpr_params_assigns_independent_class_slots() {
    var mf = match select_lfunc(iat_mixed_gpr_fpr_params()) { MFunc as x => x; error => return }
    var text = minst_print(add_mfunc(empty_mmodule(), mf))
    teko::assert::str_contains(text, "fmov.d %0, %p0")
    teko::assert::str_contains(text, "mov.x %1, %p0")
    teko::assert::str_contains(text, "fmov.d %2, %p1")
}

fn iat_dump(f: lir::LFunc): str {
    var mf = match select_lfunc(f) { MFunc as x => x; error => return "" }
    minst_print(add_mfunc(empty_mmodule(), mf))
}

#test
fn iat_a24_global_addr_is_adrp_add_data_reloc() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var v = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(v.func, 0, lir::global_addr_inst(v.vreg, ".Lstr0", 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "adrp.page_hi %0, @.Lstr0")
    teko::assert::str_contains(text, "add_lo.page_lo %0, %0, @.Lstr0")
}

#test
fn iat_a25_call_indirect_is_blr_through_target() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var t = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(t.func, 0, lir::alloca_inst(t.vreg, 8, 8, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::void_call_indirect_inst(t.vreg, teko::list::empty(), false, 0, 0))
    var s2 = lir::append_inst(s1, 0, lir::ret_inst(t.vreg, 0, 0))
    teko::assert::str_contains(iat_dump(s2), "call.indirect %0()")
}

#test
fn iat_a24_func_addr_is_adrp_add_page_reloc() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var v = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(v.func, 0, lir::func_addr_inst(v.vreg, "teko__demo__f", 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "adrp.page_hi %0, @teko__demo__f")
    teko::assert::str_contains(text, "add_lo.page_lo %0, %0, @teko__demo__f")
}

#test
fn iat_a25_call_with_result_moves_x0_out() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var r = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__f", teko::list::empty(), false, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
    var text = iat_dump(s1)
    teko::assert::str_contains(text, "call @teko__demo__f(): %p0")
    teko::assert::str_contains(text, "mov.x %0, %p0")
}

fn iat_guarded_div_func(op: lir::LBinOp): lir::LFunc {
    var ptypes = teko::list::push(teko::list::push(teko::list::empty(), lir::LType::I64), lir::LType::I64)
    var f = lir::new_func("teko__demo__guarded_div", 2, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    f = lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
    var z = lir::alloc_vreg(f)
    f = lir::append_inst(z.func, 0, lir::const_int_inst(z.vreg, 0, 0, 0))
    var c = lir::alloc_vreg(f)
    f = lir::append_inst(c.func, 0, lir::bin_inst(c.vreg, lir::LBinOp::ICmpNe, 1, z.vreg, 0, 0))
    var okb = lir::alloc_block(f)
    f = okb.func
    var trapb = lir::alloc_block(f)
    f = trapb.func
    f = lir::append_inst(f, 0, lir::branch_inst(c.vreg, okb.block_id, teko::list::empty(), trapb.block_id, teko::list::empty(), 0, 0))
    f = lir::append_inst(f, trapb.block_id, lir::void_call_inst("tk_panic_div0", teko::list::empty(), false, 0, 0))
    f = lir::append_inst(f, trapb.block_id, lir::jump_inst(trapb.block_id, teko::list::empty(), 0, 0))
    var q = lir::alloc_vreg(f)
    f = lir::append_inst(q.func, okb.block_id, lir::bin_inst(q.vreg, op, 0, 1, 0, 0))
    lir::append_inst(f, okb.block_id, lir::ret_inst(q.vreg, 0, 0))
}

#test
fn iat_div_zero_guard_selects_compare_branch_call_and_selfloop() {
    var text = iat_dump(iat_guarded_div_func(lir::LBinOp::IDivS))
    teko::assert::str_contains(text, "cmp.x %1, %2")
    teko::assert::str_contains(text, "b.ne #M")
    teko::assert::str_contains(text, "call @tk_panic_div0()")
    teko::assert::str_contains(text, "b #M2")
}

#test
fn iat_div_zero_guard_ok_path_selects_every_guarded_op() {
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IDivS)), "sdiv.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IDivU)), "udiv.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IRemS)), "msub.x ")
    teko::assert::str_contains(iat_dump(iat_guarded_div_func(lir::LBinOp::IRemU)), "msub.x ")
}
