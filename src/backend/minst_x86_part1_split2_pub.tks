/**
 * MNegX86 — a two-address unary negate: `dst = -dst` (`neg r/m64`), the
 * selection of `INeg` after an `MMovX86` seeds `dst` with the operand.
 *
 * @since #386 B1-2
 */
pub type MNegX86 = struct {
    /**
     * dst — the negated destination register, read and written.
     */
    dst: MReg
    /**
     * wide — true for the 64-bit r64 form, false for the 32-bit r32 form.
     */
    wide: bool
}

/**
 * MNotX86 — a two-address unary complement: `dst = ~dst` (`not r/m64`), the
 * selection of `INot` after an `MMovX86` seeds `dst` with the operand.
 *
 * @since #386 B1-2
 */
pub type MNotX86 = struct {
    /**
     * dst — the complemented destination register, read and written.
     */
    dst: MReg
    /**
     * wide — true for the 64-bit r64 form, false for the 32-bit r32 form.
     */
    wide: bool
}

/**
 * MLoadX86 — load a value from memory (`mov`/`movzx`/`movsx r64, [base+disp]`),
 * the selection of `LLoad`. The `size` is the transfer width; `sign` picks the
 * sign-extending narrow form (`movsx`) over the zero-extending/plain form
 * (`mov`/`movzx`), mirroring arm64's `MLoad` size/sign pair (§6.4).
 *
 * @since #386 B1-2
 */
pub type MLoadX86 = struct {
    /**
     * size — the access width (byte/word/dword/qword).
     */
    size: MMemSizeX86
    /**
     * sign — true when a narrow load sign-extends into the destination,
     * false for a zero-extending or plain full-width load.
     */
    sign: bool
    /**
     * dst — the destination register the loaded value is written to.
     */
    dst: MReg
    /**
     * mem — the base-plus-displacement address loaded from.
     */
    mem: MMem
}

/**
 * MStoreX86 — store a value to memory (`mov [base+disp], r64`), the selection
 * of `LStore`. The `size` is the stored width; stores never sign-extend, so
 * this case carries no `sign` field.
 *
 * @since #386 B1-2
 */
pub type MStoreX86 = struct {
    /**
     * size — the access width (byte/word/dword/qword).
     */
    size: MMemSizeX86
    /**
     * src — the register holding the value stored.
     */
    src: MReg
    /**
     * mem — the base-plus-displacement address stored to.
     */
    mem: MMem
}

/**
 * MFSpillX86 — spill an FPR value to, or reload it from, its frame slot in ONE
 * instruction: `movsd [rsp + slot_offsets[slot]], xmm` and the load direction, the
 * offset resolved once the frame layout is known.
 *
 * It exists because the GPR spill PAIR cannot be reused for a float. That pair is
 * `lea addr, [frame slot]` + `mov value, [addr]`, and for a GPR the SAME scratch
 * carries the address and then the value; a float needs an FPR for the value and a
 * GPR for the address at the same time, and both x86-64 ABIs reserve exactly two
 * GPR spill scratches — which one instruction with two spilled integer uses
 * already consumes. Resolving the offset in the encoder, as `MFrameAddrX86`
 * already does for the address form, removes the address register from the problem
 * entirely (and emits one instruction where the GPR path emits two).
 *
 * Always the 8-byte `MOVSD` width, for `f32` and `f64` alike: the transfer is a
 * BIT-PRESERVING save/restore of whatever the register holds, never an arithmetic
 * conversion, and a spill slot is 8 bytes wide either way.
 *
 * @since #386 B1-fp
 */
pub type MFSpillX86 = struct {
    /**
     * reg — the FPR whose value is saved, or which the value is reloaded into.
     */
    reg: MReg
    /**
     * slot — the absolute frame-slot index of the spill slot.
     */
    slot: u64
    /**
     * is_load — true for the reload (memory -> register), false for the spill
     * store (register -> memory).
     */
    is_load: bool
}

/**
 * MOutArgX86 — store one OUTGOING call argument into the caller-owned stack-arg
 * area (`mov [rsp + out_arg_base + 8*index], src`, resolved once the frame
 * layout is known), the selection of an argument past its class's
 * argument-register window (`B1-args`). Both x86-64 ABIs place such an argument
 * at a fixed offset from the caller's RSP AT THE CALL — SysV from RSP itself,
 * Win64 from just above the 32-byte shadow area — so the offset is a frame
 * concern the machine IR carries only as an INDEX, exactly as `MFrameAddrX86`
 * carries a slot index rather than a resolved displacement.
 *
 * @since #386 B1-args
 */
pub type MOutArgX86 = struct {
    /**
     * size — the transfer width of the stored argument (its own recorded
     * machine width, matching what the register path would have moved).
     */
    size: MMemSizeX86
    /**
     * src — the register holding the argument value.
     */
    src: MReg
    /**
     * index — the argument's position in the stack-arg area, counting only the
     * arguments that overflowed a register window (0 is the first such).
     */
    index: u32
}

/**
 * MInArgX86 — load one INCOMING parameter out of the caller-owned stack-arg
 * area (`mov dst, [rsp + in_arg_base + 8*index]`, resolved once the frame layout
 * is known), the selection of an `LParam` past its class's argument-register
 * window (`B1-args`). Addressed from RSP rather than RBP on purpose: the
 * displacement the frame layout resolves already accounts for the return
 * address, the saved RBP, the callee-saved pushes and the `sub rsp` region, so a
 * function receiving stack parameters needs no frame pointer and is NOT forced
 * to become framed.
 *
 * @since #386 B1-args
 */
pub type MInArgX86 = struct {
    /**
     * size — the transfer width of the loaded parameter.
     */
    size: MMemSizeX86
    /**
     * dst — the destination register the parameter is written to.
     */
    dst: MReg
    /**
     * index — the parameter's position in the stack-arg area, counting only the
     * parameters that overflowed a register window (0 is the first such).
     */
    index: u32
}

/**
 * MFrameAddrX86 — the abstract address of a reserved frame slot
 * (`lea dst, [rsp+off]`, resolved once B1 finalizes the frame layout), the
 * selection of `LAlloca`. The base-RSP `lea` always emits a SIB byte at
 * encode (§6.5) — an encoding concern the IR carries no trace of.
 *
 * @since #386 B1-2
 */
pub type MFrameAddrX86 = struct {
    /**
     * dst — the destination register the slot's address is written to.
     */
    dst: MReg
    /**
     * slot — the frame-slot index (an `MFuncX86.frame` table entry). `u64`
     * (D5, `cast-width-hygiene-0.3.1.md` §3/C3) — a pure internal count.
     */
    slot: u64
}

/**
 * MLeaRipX86 — a rip-relative address materialization: `lea dst, [rip+disp32]`
 * (plus one relocation), the selection of `LGlobalAddr`/`LFuncAddr`. The x86
 * single-instruction form COLLAPSES arm64's ADRP+ADD pair (two relocations)
 * into one `lea` + one `RelocX86` (§4.3).
 *
 * @since #386 B1-2
 */
pub type MLeaRipX86 = struct {
    /**
     * dst — the destination register the full address is written to.
     */
    dst: MReg
    /**
     * sym — the already-final relocation symbol name.
     */
    sym: str
    /**
     * kind — which relocation the B1 encoder owes this instruction.
     */
    kind: RelocKindX86
}

/**
 * MJmpX86 — an unconditional branch (`jmp rel32`) to a machine block, the
 * selection of `LJump` (after its edge moves are emitted). The B1 encoder
 * patches the rel32 displacement (§6.2).
 *
 * @since #386 B1-2
 */
pub type MJmpX86 = struct {
    /**
     * target — the machine-block id this branch transfers control to.
     */
    target: u32
}

/**
 * MCallX86 — a direct call (`call rel32`) to an already-mangled symbol, the
 * selection of `LCall` (after its SysV argument lowering, §4.5). The B1
 * encoder emits one `R_X86_64_PLT32` relocation (addend -4) for the target.
 *
 * @since #386 B1-2
 */
pub type MCallX86 = struct {
    /**
     * sym — the callee's already-mangled (or runtime `tk_*`) symbol.
     */
    sym: str
    /**
     * uses — every physical argument register this call pins (the liveness
     * set the shared regalloc reads).
     */
    uses: []MReg
    /**
     * ret_reg — the physical register (RAX/XMM0) the callee's result lands
     * in, meaningful only when `has_result` is true.
     */
    ret_reg: MReg
    /**
     * has_result — true when the call yields a value the caller consumes.
     */
    has_result: bool
    /**
     * variadic — mirrors the callee's variadic marker (SysV passes the AL
     * vector-count to a variadic callee).
     */
    variadic: bool
}

/**
 * MCallIndX86 — an indirect call (`call r/m64`) through a register holding the
 * callee's address, the selection of `LCallIndirect` (the vtable/closure
 * dispatch path).
 *
 * @since #386 B1-2
 */
pub type MCallIndX86 = struct {
    /**
     * target — the register holding the callee's address.
     */
    target: MReg
    /**
     * uses — every physical argument register this call pins (the liveness
     * set the shared regalloc reads).
     */
    uses: []MReg
    /**
     * ret_reg — the physical register (RAX/XMM0) the callee's result lands
     * in, meaningful only when `has_result` is true.
     */
    ret_reg: MReg
    /**
     * has_result — true when the call yields a value the caller consumes.
     */
    has_result: bool
}
