#test
fn xat_call_with_result_moves_rax_out() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var r = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__f", teko::list::empty(), false, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
    var text = xat_dump(s1)
    teko::assert::str_contains(text, "call @teko__demo__f(): %p0")
    teko::assert::str_contains(text, "mov.q %0, %p0")
}

#test
fn xat_call_indirect_is_call_through_target() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var t = lir::alloc_vreg(f0)
    var s0 = lir::append_inst(t.func, 0, lir::alloca_inst(t.vreg, 8, 8, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::void_call_indirect_inst(t.vreg, teko::list::empty(), false, 0, 0))
    var s2 = lir::append_inst(s1, 0, lir::ret_inst(t.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s2), "call.indirect %0()")
}

#test
fn xat_fused_compare_branch_is_cmp_jcc_jmp() {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var b1 = lir::alloc_block(f0)
    var b2 = lir::alloc_block(b1.func)
    var v0 = lir::alloc_vreg(b2.func)
    var v1 = lir::alloc_vreg(v0.func)
    var v2 = lir::alloc_vreg(v1.func)
    var v3 = lir::alloc_vreg(v2.func)
    var v4 = lir::alloc_vreg(v3.func)
    var s0 = lir::append_inst(v4.func, 0, lir::const_int_inst(v0.vreg, 5, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::const_int_inst(v1.vreg, 3, 0, 0))
    var s2 = lir::append_inst(s1, 0, lir::bin_inst(v2.vreg, lir::LBinOp::ICmpGtS, v0.vreg, v1.vreg, 0, 0))
    var s3 = lir::append_inst(s2, 0, lir::branch_inst(v2.vreg, b1.block_id, teko::list::empty(), b2.block_id, teko::list::empty(), 0, 0))
    var s4 = lir::append_inst(s3, b1.block_id, lir::const_int_inst(v3.vreg, 1, 0, 0))
    var s5 = lir::append_inst(s4, b1.block_id, lir::ret_inst(v3.vreg, 0, 0))
    var s6 = lir::append_inst(s5, b2.block_id, lir::const_int_inst(v4.vreg, 2, 0, 0))
    var s7 = lir::append_inst(s6, b2.block_id, lir::ret_inst(v4.vreg, 0, 0))
    var text = xat_dump(s7)
    teko::assert::str_contains(text, "cmp.q %0, %1")
    teko::assert::str_contains(text, "jg #M1")
    teko::assert::str_contains(text, "jmp #M2")
}

#test
fn xat_select_module_carries_rodata_globals_layouts_through() {
    var rodata = teko::list::push(teko::list::empty(), lir::LRodata { symbol = ".Lstr0"; bytes = teko::list::empty(); relocs = teko::list::empty() })
    var inner = xat_ret(xat_const(xat_main_ret(), 7).func, xat_const(xat_main_ret(), 7).vreg)
    var m0 = lir::with_rodata(lir::add_func(lir::empty_module(), inner), rodata)
    var selected = match select_module_x86(SYSV64, m0) { MModuleX86 as x => x; error => return }
    teko::assert::is_true(selected.rodata.len == 1)
    teko::assert::is_true(selected.funcs.len == 1)
}

fn xat_str_pair_call(sym: str): lir::LFunc {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var p = lir::alloc_vreg(f0)
    var n = lir::alloc_vreg(p.func)
    var s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, ".Lstr0", 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, 10, 0, 0))
    var args = teko::list::push(teko::list::push(teko::list::empty(), p.vreg), n.vreg)
    var s2 = lir::append_inst(s1, 0, lir::void_call_inst(sym, args, false, 0, 0))
    lir::append_inst(s2, 0, lir::ret_inst(n.vreg, 0, 0))
}

fn xat_dump_abi(abi: AbiDescriptor, f: lir::LFunc): str {
    var mf = match select_lfunc_x86(abi, f) { MFuncX86 as x => x; error => return "" }
    minst_print_x86(add_mfunc_x86(empty_mmodule_x86(), mf))
}

#test
fn xat_win64_str_pair_travels_by_reference() {
    var text = xat_dump_abi(WIN64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "lea %2, [frame #0]")
    teko::assert::str_contains(text, "mov.q [%2 + 0], %0")
    teko::assert::str_contains(text, "mov.q [%2 + 8], %1")
    teko::assert::str_contains(text, "mov.q %p1, %2")
    teko::assert::str_contains(text, "call @tk_println(%p1)")
}

#test
fn xat_win64_str_pair_reserves_one_16_byte_frame_slot() {
    var mf = match select_lfunc_x86(WIN64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
}

#test
fn xat_sysv_str_pair_stays_in_two_registers() {
    var text = xat_dump_abi(SYSV64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "call @tk_println(%p7, %p6)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
    var mf = match select_lfunc_x86(SYSV64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 0)
}

#test
fn xat_win64_non_str_builtin_pair_stays_in_two_registers() {
    var text = xat_dump_abi(WIN64, xat_str_pair_call("teko__demo__f"))
    teko::assert::str_contains(text, "call @teko__demo__f(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
}

fn xat_two_str_pairs_call(sym: str): lir::LFunc {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var a = xat_str_pair_operands(f0, ".Lstr0", 10)
    var b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    var r = lir::alloc_vreg(b.func)
    var args = xat_four_vregs(a.ptr, a.len, b.ptr, b.len)
    var s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, sym, args, false, 0, 0))
    lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
}

type XatStrPairOperands = struct {
    func: lir::LFunc
    ptr: u32
    len: u32
}

fn xat_str_pair_operands(f: lir::LFunc, symbol: str, len: i64): XatStrPairOperands {
    var p = lir::alloc_vreg(f)
    var n = lir::alloc_vreg(p.func)
    var s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, symbol, 0, 0))
    var s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, len, 0, 0))
    XatStrPairOperands { func = s1; ptr = p.vreg; len = n.vreg }
}

fn xat_four_vregs(a: u32, b: u32, c: u32, d: u32): []u32 {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), a), b), c), d)
}

fn xat_last_index_of_call(): lir::LFunc {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var a = xat_str_pair_operands(f0, ".Lstr0", 10)
    var b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    var out = lir::alloc_vreg(b.func)
    var s0 = lir::append_inst(out.func, 0, lir::alloca_inst(out.vreg, 8 to u32, 8 to u32, 0, 0))
    var r = lir::alloc_vreg(s0)
    var args = teko::list::push(xat_four_vregs(a.ptr, a.len, b.ptr, b.len), out.vreg)
    var s1 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "tk_rt_last_index_of_ok", args, false, 0, 0))
    lir::append_inst(s1, 0, lir::ret_inst(r.vreg, 0, 0))
}

#test
fn xat_win64_tk_str_eq_passes_both_pairs_by_reference() {
    var text = xat_dump_abi(WIN64, xat_two_str_pairs_call("tk_str_eq"))
    teko::assert::str_contains(text, "[frame #0]")
    teko::assert::str_contains(text, "[frame #1]")
    teko::assert::str_contains(text, "+ 0], %0")
    teko::assert::str_contains(text, "+ 8], %1")
    teko::assert::str_contains(text, "+ 0], %2")
    teko::assert::str_contains(text, "+ 8], %3")
    teko::assert::str_contains(text, "call @tk_str_eq(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "%p8"))
}

#test
fn xat_win64_two_pairs_reserve_two_16_byte_frame_slots() {
    var mf = match select_lfunc_x86(WIN64, xat_two_str_pairs_call("tk_str_eq")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 2)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
    teko::assert::is_true(mf.frame[1].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[1].align == (8 to u32))
}

fn xat_two_pair_entries(): []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_eq"), "tk_str_ends_with"), "tk_str_contains")
}

#test
fn xat_win64_every_two_pair_entry_travels_by_reference() {
    var entries = xat_two_pair_entries()
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var sym = entries[i]
        var win = xat_dump_abi(WIN64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(win, "[frame #1]")
        teko::assert::str_contains(win, teko::str::concat("call @", sym, "(%p1, %p2)"))
        var sysv = xat_dump_abi(SYSV64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(sysv, teko::str::concat("call @", sym, "(%p7, %p6, %p2, %p1)"))
        teko::assert::is_false(teko::runtime::str_contains(sysv, "[frame #"))
        i++
    }
}

#test
fn xat_win64_last_index_of_out_slot_follows_the_two_references() {
    var text = xat_dump_abi(WIN64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p1, %p2, %p8)")
}

#test
fn xat_sysv_last_index_of_stays_in_five_registers() {
    var text = xat_dump_abi(SYSV64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p7, %p6, %p2, %p1, %p8)")
    var mf = match select_lfunc_x86(SYSV64, xat_last_index_of_call()) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (8 to u32))
}

#test
fn xat_win64_runtime_flattened_entries_stay_in_registers() {
    var entries = xat_flattened_entries()
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var text = xat_dump_abi(WIN64, xat_two_str_pairs_call(entries[i]))
        teko::assert::str_contains(text, teko::str::concat("call @", entries[i], "(%p1, %p2, %p8, %p9)"))
        teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
        i++
    }
}

fn xat_flattened_entries(): []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_concat_len"), "tk_str_slice_len"), "tk_str_of_bytes_len"), "tk_slice_str_eq")
}

fn xat_no_arg_reg_by_ref_abi(): AbiDescriptor {
    AbiDescriptor {
        gpr_arg = teko::list::empty()
        fpr_arg = teko::list::empty()
        gpr_allocatable = teko::list::push(teko::list::empty(), 3 to u32)
        fpr_allocatable = teko::list::empty()
        gpr_caller_saved = teko::list::empty()
        fpr_caller_saved = teko::list::empty()
        gpr_spill_scratch = teko::list::empty()
        fpr_spill_scratch = teko::list::empty()
        spill_slot_bytes = 8 to u32
        spill_slot_align = 8 to u32
        shadow_space = 32 to u32
        max_reg_arg_bytes = 8 to u32
        arg_slots_shared = true
    }
}

#test
fn xat_by_ref_without_an_argument_register_is_an_internal_stop() {
    match select_lfunc_x86(xat_no_arg_reg_by_ref_abi(), xat_str_pair_call("tk_println")) {
        MFuncX86 => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "cannot pass a by-reference aggregate")
    }
}

fn xat_mixed_class_params(): lir::LFunc {
    var ptypes = xat_mixed_class_types()
    var f = lir::new_func("teko__demo__mixed", 5, ptypes, lir::LType::I64)
    var i: u64 = 0
    loop {
        if i >= ptypes.len { break }
        f = lir::append_inst(f, 0, lir::param_inst(i to u32, i to u32, 0, 0))
        i++
    }
    xat_ret(f, 4)
}

fn xat_mixed_class_types(): []lir::LType {
    var ptypes: []lir::LType = teko::list::empty()
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    teko::list::push(ptypes, lir::LType::I64)
}

#test
fn xat_win64_params_number_both_files_by_shared_position() {
    var text = xat_dump_abi(WIN64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p2")
    teko::assert::str_contains(text, "fmov.d %f2, %pf2")
    teko::assert::str_contains(text, "mov.q %3, %p9")
    teko::assert::str_contains(text, "mov.q %4, [inarg #0]")
}

#test
fn xat_sysv_params_keep_independent_per_file_counting() {
    var text = xat_dump_abi(SYSV64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p7")
    teko::assert::str_contains(text, "fmov.d %f2, %pf1")
    teko::assert::str_contains(text, "mov.q %3, %p6")
    teko::assert::str_contains(text, "mov.q %4, %p2")
    teko::assert::is_false(teko::runtime::str_contains(text, "[inarg #"))
}

fn xat_mixed_class_call(): lir::LFunc {
    var f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    var a = xat_fconst(f0, 1)
    var b = xat_const(a.func, 2)
    var c = xat_fconst(b.func, 3)
    var d = xat_const(c.func, 4)
    var e = xat_const(d.func, 5)
    var r = lir::alloc_vreg(e.func)
    var args: []u32 = teko::list::empty()
    args = teko::list::push(args, a.vreg)
    args = teko::list::push(args, b.vreg)
    args = teko::list::push(args, c.vreg)
    args = teko::list::push(args, d.vreg)
    args = teko::list::push(args, e.vreg)
    var s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__mixed", args, false, 0, 0))
    xat_ret(s0, r.vreg)
}

fn xat_fconst(f0: lir::LFunc, bits: u64): lir::FreshVReg {
    var r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_float_inst(r.vreg, bits, true, 0, 0)); vreg = r.vreg }
}

#test
fn xat_win64_call_args_number_both_files_by_shared_position() {
    var text = xat_dump_abi(WIN64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p2, %1")
    teko::assert::str_contains(text, "fmov.d %pf2, %f2")
    teko::assert::str_contains(text, "mov.q %p9, %3")
    teko::assert::str_contains(text, "mov.q [outarg #0], %4")
}

#test
fn xat_sysv_call_args_keep_independent_per_file_counting() {
    var text = xat_dump_abi(SYSV64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p7, %1")
    teko::assert::str_contains(text, "fmov.d %pf1, %f2")
    teko::assert::str_contains(text, "mov.q %p6, %3")
    teko::assert::str_contains(text, "mov.q %p2, %4")
    teko::assert::is_false(teko::runtime::str_contains(text, "[outarg #"))
}
