use teko::lir

/**
 * xat_bin — append `%r = op a, b` to `f0`, returning the advanced function
 * plus the fresh result VReg (a fixture-building shorthand).
 *
 * @param lir::LFunc f0  the function to extend
 * @param lir::LBinOp op  the binary op
 * @param u32 a  the first operand VReg
 * @param u32 b  the second operand VReg
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn xat_bin(f0: lir::LFunc, op: lir::LBinOp, a: u32, b: u32) -> lir::FreshVReg {
    let r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::bin_inst(r.vreg, op, a, b, 0, 0)); vreg = r.vreg }
}

/**
 * xat_un — append `%r = op a` to `f0`, returning the advanced function plus
 * the fresh result VReg.
 *
 * @param lir::LFunc f0  the function to extend
 * @param lir::LUnOp op  the unary op
 * @param u32 a  the operand VReg
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn xat_un(f0: lir::LFunc, op: lir::LUnOp, a: u32) -> lir::FreshVReg {
    let r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::un_inst(r.vreg, op, a, 0, 0)); vreg = r.vreg }
}

/**
 * xat_const — append `%r = const val` to `f0`, returning the advanced function
 * plus the fresh result VReg.
 *
 * @param lir::LFunc f0  the function to extend
 * @param i64 val  the literal value
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn xat_const(f0: lir::LFunc, val: i64) -> lir::FreshVReg {
    let r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_int_inst(r.vreg, val, 0, 0)); vreg = r.vreg }
}

/**
 * xat_ret — append `ret value` to `f0`.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u32 value  the returned VReg
 * @return lir::LFunc  the advanced function
 */
fn xat_ret(f0: lir::LFunc, value: u32) -> lir::LFunc {
    lir::append_inst(f0, 0, lir::ret_inst(value, 0, 0))
}

/**
 * xat_two_i64_params — a fresh 2-param (I64, I64) -> I64 function named `sym`,
 * its entry block already carrying both `LParam` instructions.
 *
 * @param str sym  the function's symbol
 * @return lir::LFunc  the seeded function
 */
fn xat_two_i64_params(sym: str) -> lir::LFunc {
    let ptypes = teko::list::push(teko::list::push(teko::list::empty(), lir::LType::I64), lir::LType::I64)
    mut f = lir::new_func(sym, 2, ptypes, lir::LType::I64)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    lir::append_inst(f, 0, lir::param_inst(1, 1, 0, 0))
}

/**
 * xat_main_ret — a zero-param `main` seed (the straight-line fixture base).
 *
 * @return lir::LFunc  the seeded, empty-bodied function
 */
fn xat_main_ret() -> lir::LFunc {
    lir::new_func("main", 0, teko::list::empty(), lir::LType::I32)
}

/**
 * xat_dump — select `f` for x86-64 under the SysV ABI and render the machine
 * module as text (the golden-dump fixtures assert against key lines of this);
 * "" on a selection error. The SysV output is the byte-identity guardrail: it is
 * unchanged from before the ABI descriptor was threaded, because `SYSV64` is
 * exactly the descriptor the old code hardcoded.
 *
 * @param lir::LFunc f  the function to select and print
 * @return str  the rendered machine text ("" on a selection error)
 */
fn xat_dump(f: lir::LFunc) -> str {
    let mf = match select_lfunc_x86(SYSV64, f) { MFuncX86 as x => x; error => return "" }
    minst_print_x86(add_mfunc_x86(empty_mmodule_x86(), mf))
}

/**
 * xat_kitchen_sink — a two-param (I64,I64) function exercising every integer
 * `LBinOp` arithmetic/bitwise/shift/compare case plus every integer `LUnOp`
 * case (the coverage sweep for `select_bin_x86`/`select_un_x86`'s integer
 * dispatch), ending `ret`. The float family has its own sweep,
 * `xat_float_kitchen_sink` (`B1-fp`, closed 2026-07-29).
 *
 * @return lir::LFunc  the built function
 */
fn xat_kitchen_sink() -> lir::LFunc {
    mut f = xat_two_i64_params("teko__demo__kitchen_sink")
    f = xat_bin(f, lir::LBinOp::IAdd, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ISub, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IMul, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IDivS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IDivU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IRemS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IRemU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IAnd, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IOr, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IXor, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IShl, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IShrS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::IShrU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpEq, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpNe, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpLtS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpLtU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpLeS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpLeU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpGtS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpGtU, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpGeS, 0, 1).func
    f = xat_bin(f, lir::LBinOp::ICmpGeU, 0, 1).func
    f = xat_un(f, lir::LUnOp::INeg, 0).func
    f = xat_un(f, lir::LUnOp::INot, 0).func
    f = xat_un(f, lir::LUnOp::Trunc, 0).func
    f = xat_un(f, lir::LUnOp::ZExt, 0).func
    let last = xat_un(f, lir::LUnOp::SExt, 0)
    f = last.func
    xat_ret(f, last.vreg)
}

#test
fn xat_kitchen_sink_covers_every_int_bin_and_un_op() {
    let text = xat_dump(xat_kitchen_sink())
    teko::assert::str_contains(text, "add.q ")
    teko::assert::str_contains(text, "sub.q ")
    teko::assert::str_contains(text, "imul.q ")
    teko::assert::str_contains(text, "idiv.q ")
    teko::assert::str_contains(text, "div.q ")
    teko::assert::str_contains(text, "irem.q ")
    teko::assert::str_contains(text, "rem.q ")
    teko::assert::str_contains(text, "and.q ")
    teko::assert::str_contains(text, "or.q ")
    teko::assert::str_contains(text, "xor.q ")
    teko::assert::str_contains(text, "shl.q ")
    teko::assert::str_contains(text, "sar.q ")
    teko::assert::str_contains(text, "shr.q ")
    teko::assert::str_contains(text, "sete ")
    teko::assert::str_contains(text, "setne ")
    teko::assert::str_contains(text, "setl ")
    teko::assert::str_contains(text, "setb ")
    teko::assert::str_contains(text, "setle ")
    teko::assert::str_contains(text, "setbe ")
    teko::assert::str_contains(text, "setg ")
    teko::assert::str_contains(text, "seta ")
    teko::assert::str_contains(text, "setge ")
    teko::assert::str_contains(text, "setae ")
    teko::assert::str_contains(text, "neg.q ")
    teko::assert::str_contains(text, "not.q ")
    teko::assert::str_contains(text, "mov.d ")
}

/**
 * xat_one_param_func — a single-parameter function of machine class `ty` (its
 * own return type too), its param read via `LParam` and returned directly — the
 * coverage sweep for `select_param_x86`'s per-register-file receipt.
 *
 * @param lir::LType ty  the parameter's (and return's) machine class
 * @return lir::LFunc  the built function
 */
fn xat_one_param_func(ty: lir::LType) -> lir::LFunc {
    let ptypes = teko::list::push(teko::list::empty(), ty)
    mut f = lir::new_func("teko__demo__one_param", 1, ptypes, ty)
    f = lir::append_inst(f, 0, lir::param_inst(0, 0, 0, 0))
    xat_ret(f, 0)
}

/**
 * xat_select_succeeds — whether `select_lfunc_x86(f)` selects without error.
 *
 * @param lir::LFunc f  the function to select
 * @return bool  whether selection succeeded
 */
fn xat_select_succeeds(f: lir::LFunc) -> bool {
    match select_lfunc_x86(SYSV64, f) { MFuncX86 => true; error => false }
}

#test
/**
 * xat_param_covers_every_scalar_class — every scalar `LType` a parameter can
 * carry now selects: the GPR widths through `MMovX86` out of the SysV integer
 * argument register, and `F32`/`F64` through `MFMovX86` out of XMM0 (`B1-fp`,
 * closed 2026-07-29 — both float classes used to be the float honest-stop).
 *
 * @return void
 */
fn xat_param_covers_every_scalar_class() {
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::I8)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::I16)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::I32)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::I64)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::Ptr)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::Void)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::F32)))
    teko::assert::is_true(xat_select_succeeds(xat_one_param_func(lir::LType::F64)))
}

#test
/**
 * xat_float_param_lands_in_xmm0_and_returns_in_xmm0 — an f64 parameter is
 * received by an `MFMovX86` out of XMM0 (the SysV first float argument register)
 * and returned by an `MFMovX86` into XMM0 (the float result register), the two
 * ends of `B1-fp`'s ABI plumbing. Asserts the printed FPR operand spelling, so a
 * regression that quietly re-routed either end through a GPR `mov` fails here.
 *
 * @return void
 */
fn xat_float_param_lands_in_xmm0_and_returns_in_xmm0() {
    let text = xat_dump(xat_one_param_func(lir::LType::F64))
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
}

#test
fn xat_field_addr_materializes_offset_then_adds() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let base = lir::alloc_vreg(f0)
    let fa = lir::alloc_vreg(base.func)
    let s0 = lir::append_inst(fa.func, 0, lir::alloca_inst(base.vreg, 16, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::field_addr_inst(fa.vreg, base.vreg, 8, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::ret_inst(fa.vreg, 0, 0))
    let text = xat_dump(s2)
    teko::assert::str_contains(text, "mov.q %2, #8")
    teko::assert::str_contains(text, "mov.q %1, %0")
    teko::assert::str_contains(text, "add.q %1, %2")
}

#test
fn xat_store_i64_is_qword_mov() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let base = lir::alloc_vreg(f0)
    let val = lir::alloc_vreg(base.func)
    let s0 = lir::append_inst(val.func, 0, lir::alloca_inst(base.vreg, 8, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(val.vreg, 42, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::store_inst(base.vreg, val.vreg, lir::LType::I64, 0, 0))
    let s3 = lir::append_inst(s2, 0, lir::ret_inst(val.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s3), "mov.q [%0 + 0], %1")
}

/**
 * xat_load_ty_succeeds — whether an `alloca`+`load ty`+`ret` function selects
 * for x86-64 (the coverage sweep over `mem_size_of_x86`'s every arm).
 *
 * @param lir::LType ty  the loaded machine class
 * @return bool  whether selection succeeded
 */
fn xat_load_ty_succeeds(ty: lir::LType) -> bool {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let base = lir::alloc_vreg(f0)
    let ld = lir::alloc_vreg(base.func)
    let s0 = lir::append_inst(ld.func, 0, lir::alloca_inst(base.vreg, 8, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::load_inst(ld.vreg, base.vreg, ty, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::ret_inst(ld.vreg, 0, 0))
    match select_lfunc_x86(SYSV64, s2) { MFuncX86 => true; error => false }
}

#test
/**
 * xat_mem_size_covers_every_transfer_class — every real machine class a load can
 * name selects, integer AND float (`B1-fp`, closed 2026-07-29 — `F32`/`F64` used
 * to be the float honest-stop); only `Void`, which names no transfer width at
 * all, is still rejected as malformed.
 *
 * @return void
 */
fn xat_mem_size_covers_every_transfer_class() {
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::I8))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::I16))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::I32))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::I64))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::Ptr))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::F32))
    teko::assert::is_true(xat_load_ty_succeeds(lir::LType::F64))
    teko::assert::is_true(!xat_load_ty_succeeds(lir::LType::Void))
}

#test
/**
 * xat_float_load_store_are_scalar_sse_moves — an f64 load and an f64 store name
 * the `f64` transfer width and carry FPR-file operands (`B1-fp`), so the printed
 * form is the scalar SSE move over an XMM register rather than an integer `mov.q`
 * over a GPR.
 *
 * @return void
 */
fn xat_float_load_store_are_scalar_sse_moves() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::F64)
    let base = lir::alloc_vreg(f0)
    let ld = lir::alloc_vreg(base.func)
    let s0 = lir::append_inst(ld.func, 0, lir::alloca_inst(base.vreg, 8, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::load_inst(ld.vreg, base.vreg, lir::LType::F64, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::store_inst(base.vreg, ld.vreg, lir::LType::F64, 0, 0))
    let s3 = lir::append_inst(s2, 0, lir::ret_inst(ld.vreg, 0, 0))
    let text = xat_dump(s3)
    teko::assert::str_contains(text, "mov.f64 %f1, [%0 + 0]")
    teko::assert::str_contains(text, "mov.f64 [%0 + 0], %f1")
}

#test
fn xat_global_addr_is_single_lea_rip() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let v = lir::alloc_vreg(f0)
    let s0 = lir::append_inst(v.func, 0, lir::global_addr_inst(v.vreg, ".Lstr0", 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s1), "lea.pc32 %0, [rip @.Lstr0]")
}

#test
fn xat_func_addr_is_single_lea_rip() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let v = lir::alloc_vreg(f0)
    let s0 = lir::append_inst(v.func, 0, lir::func_addr_inst(v.vreg, "teko__demo__f", 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::ret_inst(v.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s1), "lea.pc32 %0, [rip @teko__demo__f]")
}

#test
fn xat_call_with_result_moves_rax_out() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let r = lir::alloc_vreg(f0)
    let s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__f", teko::list::empty(), false, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
    let text = xat_dump(s1)
    teko::assert::str_contains(text, "call @teko__demo__f() -> %p0")
    teko::assert::str_contains(text, "mov.q %0, %p0")
}

#test
fn xat_call_indirect_is_call_through_target() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let t = lir::alloc_vreg(f0)
    let s0 = lir::append_inst(t.func, 0, lir::alloca_inst(t.vreg, 8, 8, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::void_call_indirect_inst(t.vreg, teko::list::empty(), false, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::ret_inst(t.vreg, 0, 0))
    teko::assert::str_contains(xat_dump(s2), "call.indirect %0()")
}

#test
fn xat_fused_compare_branch_is_cmp_jcc_jmp() {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let b1 = lir::alloc_block(f0)
    let b2 = lir::alloc_block(b1.func)
    let v0 = lir::alloc_vreg(b2.func)
    let v1 = lir::alloc_vreg(v0.func)
    let v2 = lir::alloc_vreg(v1.func)
    let v3 = lir::alloc_vreg(v2.func)
    let v4 = lir::alloc_vreg(v3.func)
    let s0 = lir::append_inst(v4.func, 0, lir::const_int_inst(v0.vreg, 5, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(v1.vreg, 3, 0, 0))
    let s2 = lir::append_inst(s1, 0, lir::bin_inst(v2.vreg, lir::LBinOp::ICmpGtS, v0.vreg, v1.vreg, 0, 0))
    let s3 = lir::append_inst(s2, 0, lir::branch_inst(v2.vreg, b1.block_id, teko::list::empty(), b2.block_id, teko::list::empty(), 0, 0))
    let s4 = lir::append_inst(s3, b1.block_id, lir::const_int_inst(v3.vreg, 1, 0, 0))
    let s5 = lir::append_inst(s4, b1.block_id, lir::ret_inst(v3.vreg, 0, 0))
    let s6 = lir::append_inst(s5, b2.block_id, lir::const_int_inst(v4.vreg, 2, 0, 0))
    let s7 = lir::append_inst(s6, b2.block_id, lir::ret_inst(v4.vreg, 0, 0))
    let text = xat_dump(s7)
    teko::assert::str_contains(text, "cmp.q %0, %1")
    teko::assert::str_contains(text, "jg #M1")
    teko::assert::str_contains(text, "jmp #M2")
}

#test
fn xat_select_module_carries_rodata_globals_layouts_through() {
    let rodata = teko::list::push(teko::list::empty(), lir::LRodata { symbol = ".Lstr0"; bytes = teko::list::empty(); relocs = teko::list::empty() })
    let inner = xat_ret(xat_const(xat_main_ret(), 7).func, xat_const(xat_main_ret(), 7).vreg)
    let m0 = lir::with_rodata(lir::add_func(lir::empty_module(), inner), rodata)
    let selected = match select_module_x86(SYSV64, m0) { MModuleX86 as x => x; error => return }
    teko::assert::is_true(selected.rodata.len == 1)
    teko::assert::is_true(selected.funcs.len == 1)
}

/**
 * xat_str_pair_call — a `main` whose body materializes a `tk_str`'s flattened
 * `(ptr, len)` pair (a rodata address + a constant length, exactly what
 * `lower.tks::lower_str_arg_call` emits) and hands it to `sym` as a two-operand
 * void call, then returns the length VReg. The fixture behind the Win64
 * by-reference argument tests.
 *
 * @param str sym  the called runtime symbol
 * @return lir::LFunc  the built function
 */
fn xat_str_pair_call(sym: str) -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let p = lir::alloc_vreg(f0)
    let n = lir::alloc_vreg(p.func)
    let s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, ".Lstr0", 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, 10, 0, 0))
    let args = teko::list::push(teko::list::push(teko::list::empty(), p.vreg), n.vreg)
    let s2 = lir::append_inst(s1, 0, lir::void_call_inst(sym, args, false, 0, 0))
    lir::append_inst(s2, 0, lir::ret_inst(n.vreg, 0, 0))
}

/**
 * xat_dump_abi — select `f` under an explicit ABI descriptor and render the
 * machine module as text (the ABI-sensitive sibling of `xat_dump`, which pins
 * SysV).
 *
 * @param AbiDescriptor abi  the ABI register file to select under
 * @param lir::LFunc f  the function to select and print
 * @return str  the rendered machine text ("" on a selection error)
 */
fn xat_dump_abi(abi: AbiDescriptor, f: lir::LFunc) -> str {
    let mf = match select_lfunc_x86(abi, f) { MFuncX86 as x => x; error => return "" }
    minst_print_x86(add_mfunc_x86(empty_mmodule_x86(), mf))
}

#test
/**
 * xat_win64_str_pair_travels_by_reference — the ONE-pair family (the io group plus
 * `tk_panic_str`): the 16-byte copy's address, `.ptr` at +0, `.len` at +8, and that
 * ADDRESS — never the pair — in RCX, the sole argument register used.
 *
 * @return void
 */
fn xat_win64_str_pair_travels_by_reference() {
    let text = xat_dump_abi(WIN64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "lea %2, [frame #0]")
    teko::assert::str_contains(text, "mov.q [%2 + 0], %0")
    teko::assert::str_contains(text, "mov.q [%2 + 8], %1")
    teko::assert::str_contains(text, "mov.q %p1, %2")
    teko::assert::str_contains(text, "call @tk_println(%p1)")
}

#test
/**
 * xat_win64_str_pair_reserves_one_16_byte_frame_slot — one by-value `tk_str` costs
 * exactly one 16-byte, 8-aligned frame slot.
 *
 * @return void
 */
fn xat_win64_str_pair_reserves_one_16_byte_frame_slot() {
    let mf = match select_lfunc_x86(WIN64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
}

#test
/**
 * xat_sysv_str_pair_stays_in_two_registers — SysV carries a 2-eightbyte aggregate
 * in RDI/RSI, so this is the byte-identity guardrail: no frame slot, no stores,
 * both halves pinned as ordinary register arguments.
 *
 * @return void
 */
fn xat_sysv_str_pair_stays_in_two_registers() {
    let text = xat_dump_abi(SYSV64, xat_str_pair_call("tk_println"))
    teko::assert::str_contains(text, "call @tk_println(%p7, %p6)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
    let mf = match select_lfunc_x86(SYSV64, xat_str_pair_call("tk_println")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 0)
}

#test
/**
 * xat_win64_non_str_builtin_pair_stays_in_two_registers — the by-reference path is
 * keyed on the CLOSED by-value-`tk_str` arity table, never on "a call with two
 * arguments": an ordinary two-scalar call keeps RCX/RDX.
 *
 * @return void
 */
fn xat_win64_non_str_builtin_pair_stays_in_two_registers() {
    let text = xat_dump_abi(WIN64, xat_str_pair_call("teko__demo__f"))
    teko::assert::str_contains(text, "call @teko__demo__f(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
}

/**
 * xat_two_str_pairs_call — a `main` whose body materializes TWO flattened `tk_str`
 * pairs (`%0`/`%1` and `%2`/`%3` — a rodata address plus a constant length each,
 * exactly the four operands `lower.tks::fat_eq_call_args` emits) and hands all four
 * to `sym` as one result-producing call, then returns the result.
 *
 * The fixture behind the two-pair Win64 goldens: `tk_str_eq`, `tk_str_contains` and
 * `tk_str_ends_with` all have this shape.
 *
 * @param str sym  the called runtime symbol
 * @return lir::LFunc  the built function
 */
fn xat_two_str_pairs_call(sym: str) -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_str_pair_operands(f0, ".Lstr0", 10)
    let b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    let r = lir::alloc_vreg(b.func)
    let args = xat_four_vregs(a.ptr, a.len, b.ptr, b.len)
    let s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, sym, args, false, 0, 0))
    lir::append_inst(s0, 0, lir::ret_inst(r.vreg, 0, 0))
}

/**
 * XatStrPairOperands — one flattened `tk_str` operand pair plus the function that
 * defines both halves.
 */
type XatStrPairOperands = struct {
    /** the function with both defining instructions appended. */
    func: lir::LFunc
    /** the VReg holding the pointer half (a rodata address). */
    ptr: u32
    /** the VReg holding the byte length. */
    len: u32
}

/**
 * xat_str_pair_operands — append the two instructions that define one flattened
 * `tk_str` pair: the rodata address of `symbol` and the constant length `len`.
 *
 * @param lir::LFunc f  the function to extend
 * @param str symbol  the rodata symbol the pointer half addresses
 * @param i64 len  the constant byte length
 * @return XatStrPairOperands  the extended function + the pair's two VRegs
 */
fn xat_str_pair_operands(f: lir::LFunc, symbol: str, len: i64) -> XatStrPairOperands {
    let p = lir::alloc_vreg(f)
    let n = lir::alloc_vreg(p.func)
    let s0 = lir::append_inst(n.func, 0, lir::global_addr_inst(p.vreg, symbol, 0, 0))
    let s1 = lir::append_inst(s0, 0, lir::const_int_inst(n.vreg, len, 0, 0))
    XatStrPairOperands { func = s1; ptr = p.vreg; len = n.vreg }
}

/**
 * xat_four_vregs — the four VRegs of two flattened pairs, in ABI order.
 *
 * @param u32 a  the first pair's pointer half
 * @param u32 b  the first pair's length
 * @param u32 c  the second pair's pointer half
 * @param u32 d  the second pair's length
 * @return []u32  the four ids, in order
 */
fn xat_four_vregs(a: u32, b: u32, c: u32, d: u32) -> []u32 {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), a), b), c), d)
}

/**
 * xat_last_index_of_call — `tk_rt_last_index_of_ok(hay, needle, out_index)`: TWO
 * flattened pairs followed by an ordinary pointer operand (an `LAlloca`'s address),
 * the exact shape `lower.tks::lower_last_index_of_call` emits and the only
 * two-pair entry with a trailing scalar.
 *
 * @return lir::LFunc  the built function
 */
fn xat_last_index_of_call() -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_str_pair_operands(f0, ".Lstr0", 10)
    let b = xat_str_pair_operands(a.func, ".Lstr1", 20)
    let out = lir::alloc_vreg(b.func)
    let s0 = lir::append_inst(out.func, 0, lir::alloca_inst(out.vreg, 8 to u32, 8 to u32, 0, 0))
    let r = lir::alloc_vreg(s0)
    let args = teko::list::push(xat_four_vregs(a.ptr, a.len, b.ptr, b.len), out.vreg)
    let s1 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "tk_rt_last_index_of_ok", args, false, 0, 0))
    lir::append_inst(s1, 0, lir::ret_inst(r.vreg, 0, 0))
}

#test
/**
 * xat_win64_tk_str_eq_passes_both_pairs_by_reference — the golden for the shape the
 * Windows leg faulted on with ACCESS_VIOLATION: each pair gets its OWN 16-byte
 * frame copy (`.ptr` at +0, `.len` at +8, from that pair's own two VRegs), and the
 * two ADDRESSES — not the four halves — travel in RCX and RDX.
 *
 * The `is_false` is the load-bearing half: `%p8` (R8) appearing would mean a third
 * register was pinned, which is exactly the flat four-operand form the callee reads
 * as two pointers.
 *
 * @return void
 */
fn xat_win64_tk_str_eq_passes_both_pairs_by_reference() {
    let text = xat_dump_abi(WIN64, xat_two_str_pairs_call("tk_str_eq"))
    teko::assert::str_contains(text, "[frame #0]")
    teko::assert::str_contains(text, "[frame #1]")
    teko::assert::str_contains(text, "+ 0], %0")
    teko::assert::str_contains(text, "+ 8], %1")
    teko::assert::str_contains(text, "+ 0], %2")
    teko::assert::str_contains(text, "+ 8], %3")
    teko::assert::str_contains(text, "call @tk_str_eq(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "%p8"))
}

#test
/**
 * xat_win64_two_pairs_reserve_two_16_byte_frame_slots — two by-value `tk_str`
 * arguments cost two 16-byte, 8-aligned frame slots, not one shared copy.
 *
 * @return void
 */
fn xat_win64_two_pairs_reserve_two_16_byte_frame_slots() {
    let mf = match select_lfunc_x86(WIN64, xat_two_str_pairs_call("tk_str_eq")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 2)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
    teko::assert::is_true(mf.frame[1].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[1].align == (8 to u32))
}

/**
 * xat_two_pair_entries — every runtime entry whose FIRST TWO parameters are
 * by-value `tk_str` and whose argument list is exactly those two pairs
 * (`teko_rt.h`: `tk_str_eq`, `tk_str_ends_with`, `tk_str_contains`).
 * `tk_rt_last_index_of_ok` is the fourth member of the family and is covered
 * separately because it carries a trailing out-parameter.
 *
 * ENUMERATED, NOT SAMPLED: the defect this pins was a fix that covered the
 * one-`tk_str` family and left the two-`tk_str` one emitting SysV's form on Win64,
 * so a golden for whichever entry a fixture happens to touch would repeat the
 * mistake at the next entry.
 *
 * @return []str  the three symbols, in `teko_rt.h` declaration order
 */
fn xat_two_pair_entries() -> []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_eq"), "tk_str_ends_with"), "tk_str_contains")
}

#test
/**
 * xat_win64_every_two_pair_entry_travels_by_reference — the family sweep: EVERY
 * entry of `xat_two_pair_entries` emits two frame copies and a call using exactly
 * RCX and RDX under WIN64, and the SysV four-register form under SYSV64.
 *
 * @return void
 */
fn xat_win64_every_two_pair_entry_travels_by_reference() {
    let entries = xat_two_pair_entries()
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let sym = entries[i]
        let win = xat_dump_abi(WIN64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(win, "[frame #1]")
        teko::assert::str_contains(win, teko::str::concat("call @", sym, "(%p1, %p2)"))
        let sysv = xat_dump_abi(SYSV64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(sysv, teko::str::concat("call @", sym, "(%p7, %p6, %p2, %p1)"))
        teko::assert::is_false(teko::runtime::str_contains(sysv, "[frame #"))
        i++
    }
}

#test
/**
 * xat_win64_last_index_of_out_slot_follows_the_two_references — the fourth family
 * member: `tk_rt_last_index_of_ok`'s two references take RCX/RDX and its
 * `uint64_t *out_index` takes the NEXT register (R8), never RCX — the numbering
 * that a per-pair-agnostic pinning would have got wrong.
 *
 * @return void
 */
fn xat_win64_last_index_of_out_slot_follows_the_two_references() {
    let text = xat_dump_abi(WIN64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p1, %p2, %p8)")
}

#test
/**
 * xat_sysv_last_index_of_stays_in_five_registers — the byte-identity guardrail for
 * the trailing-scalar member: SysV pins all five operands as ordinary register
 * arguments and reserves no pair copy (its only frame slot is the `LAlloca`'s own).
 *
 * @return void
 */
fn xat_sysv_last_index_of_stays_in_five_registers() {
    let text = xat_dump_abi(SYSV64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p7, %p6, %p2, %p1, %p8)")
    let mf = match select_lfunc_x86(SYSV64, xat_last_index_of_call()) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (8 to u32))
}

#test
/**
 * xat_win64_runtime_flattened_entries_stay_in_registers — the entries the RUNTIME
 * itself declares flattened (`tk_str_concat_len`, `tk_str_slice_len`,
 * `tk_str_of_bytes_len`, `tk_slice_str_eq` — each taking `const tk_byte *ptr,
 * uint64_t len, …`) take no by-value aggregate at all, so the flat pair IS their C
 * ABI on Win64 too and NOTHING may be materialized for them.
 *
 * @return void
 */
fn xat_win64_runtime_flattened_entries_stay_in_registers() {
    let entries = xat_flattened_entries()
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let text = xat_dump_abi(WIN64, xat_two_str_pairs_call(entries[i]))
        teko::assert::str_contains(text, teko::str::concat("call @", entries[i], "(%p1, %p2, %p8, %p9)"))
        teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
        i++
    }
}

/**
 * xat_flattened_entries — the runtime entries whose `tk_str` arguments were
 * flattened IN THE RUNTIME's own signature on purpose, and which must therefore
 * keep the plain register form on every ABI.
 *
 * @return []str  the four flattened symbols the native LIR calls
 */
fn xat_flattened_entries() -> []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_concat_len"), "tk_str_slice_len"), "tk_str_of_bytes_len"), "tk_slice_str_eq")
}

/**
 * xat_no_arg_reg_by_ref_abi — a degenerate register file with NO integer
 * argument register and Win64's by-reference aggregate rule, the only input that
 * reaches `pin_fat_slot_addrs_x86`'s "no argument register" internal arm (every
 * shipped x86-64 descriptor has at least four).
 *
 * @return AbiDescriptor  the degenerate register file
 */
fn xat_no_arg_reg_by_ref_abi() -> AbiDescriptor {
    AbiDescriptor {
        gpr_arg = teko::list::empty()
        fpr_arg = teko::list::empty()
        gpr_allocatable = teko::list::push(teko::list::empty(), 3 to u32)
        fpr_allocatable = teko::list::empty()
        gpr_caller_saved = teko::list::empty()
        fpr_caller_saved = teko::list::empty()
        gpr_spill_scratch = teko::list::empty()
        fpr_spill_scratch = teko::list::empty()
        spill_slot_bytes = 8 to u32
        spill_slot_align = 8 to u32
        shadow_space = 32 to u32
        max_reg_arg_bytes = 8 to u32
        arg_slots_shared = true
    }
}

#test
fn xat_by_ref_without_an_argument_register_is_an_internal_stop() {
    match select_lfunc_x86(xat_no_arg_reg_by_ref_abi(), xat_str_pair_call("tk_println")) {
        MFuncX86 => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "cannot pass a by-reference aggregate")
    }
}

/**
 * xat_mixed_class_params — a five-parameter `(F64, I64, F64, I64, I64)` function
 * whose entry block reads every parameter through `LParam`, the fixture that tells
 * the two argument-slot rules apart (`B3-argslot`).
 *
 * The shape is chosen so NO position agrees between them: under SysV's per-file
 * counters the parameters land in XMM0/RDI/XMM1/RSI/RDX and none overflows, while
 * under Win64's shared positions they land in XMM0/RDX/XMM2/R9 and the fifth
 * overflows to the stack-argument area. A rule read from the wrong ABI therefore
 * cannot produce this fixture's expected text by accident.
 *
 * @return lir::LFunc  the built function
 */
fn xat_mixed_class_params() -> lir::LFunc {
    let ptypes = xat_mixed_class_types()
    mut f = lir::new_func("teko__demo__mixed", 5, ptypes, lir::LType::I64)
    mut i: u64 = 0
    loop {
        if i >= ptypes.len { break }
        f = lir::append_inst(f, 0, lir::param_inst(i to u32, i to u32, 0, 0))
        i++
    }
    xat_ret(f, 4)
}

/**
 * xat_mixed_class_types — the `(F64, I64, F64, I64, I64)` machine-class list both
 * mixed-class fixtures are built from.
 *
 * @return []lir::LType  the five parameter classes, in declaration order
 */
fn xat_mixed_class_types() -> []lir::LType {
    mut ptypes: []lir::LType = teko::list::empty()
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    teko::list::push(ptypes, lir::LType::I64)
}

#test
/**
 * xat_win64_params_number_both_files_by_shared_position — the callee half of
 * `B3-argslot`: Win64 argument position `k` owns the k-th register of WHICHEVER
 * file the parameter belongs to, so `(F64, I64, F64, I64, I64)` arrives in
 * XMM0, RDX, XMM2, R9 and the fifth position — past the four shared slots — in the
 * caller's stack-argument area.
 *
 * The old per-file counting answered XMM0, RCX, XMM1, RDX and put NOTHING on the
 * stack; every one of those five is asserted against here.
 *
 * @return void
 */
fn xat_win64_params_number_both_files_by_shared_position() {
    let text = xat_dump_abi(WIN64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p2")
    teko::assert::str_contains(text, "fmov.d %f2, %pf2")
    teko::assert::str_contains(text, "mov.q %3, %p9")
    teko::assert::str_contains(text, "mov.q %4, [inarg #0]")
}

#test
/**
 * xat_sysv_params_keep_independent_per_file_counting — the byte-identity
 * guardrail for the same fixture: SysV counts each register file on its own, so
 * the two floats take XMM0/XMM1, the three integers take RDI/RSI/RDX and nothing
 * reaches the stack-argument area.
 *
 * @return void
 */
fn xat_sysv_params_keep_independent_per_file_counting() {
    let text = xat_dump_abi(SYSV64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p7")
    teko::assert::str_contains(text, "fmov.d %f2, %pf1")
    teko::assert::str_contains(text, "mov.q %3, %p6")
    teko::assert::str_contains(text, "mov.q %4, %p2")
    teko::assert::is_false(teko::runtime::str_contains(text, "[inarg #"))
}

/**
 * xat_mixed_class_call — a `main` that materializes five values of classes
 * `(F64, I64, F64, I64, I64)` and hands them to `teko__demo__mixed` as one
 * result-producing call, then returns the result: the CALLER half of the
 * mixed-class fixture, mirroring `xat_mixed_class_params`'s signature exactly.
 *
 * @return lir::LFunc  the built function
 */
fn xat_mixed_class_call() -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_fconst(f0, 1)
    let b = xat_const(a.func, 2)
    let c = xat_fconst(b.func, 3)
    let d = xat_const(c.func, 4)
    let e = xat_const(d.func, 5)
    let r = lir::alloc_vreg(e.func)
    mut args: []u32 = teko::list::empty()
    args = teko::list::push(args, a.vreg)
    args = teko::list::push(args, b.vreg)
    args = teko::list::push(args, c.vreg)
    args = teko::list::push(args, d.vreg)
    args = teko::list::push(args, e.vreg)
    let s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__mixed", args, false, 0, 0))
    xat_ret(s0, r.vreg)
}

/**
 * xat_fconst — append `%r = const.f64 <bits>` to `f0`, the float twin of
 * `xat_const`, so a fixture can produce an FPR-classed argument operand.
 *
 * @param lir::LFunc f0  the function to extend
 * @param u64 bits  the literal's IEEE-754 bit pattern
 * @return lir::FreshVReg  the advanced function + the result VReg
 */
fn xat_fconst(f0: lir::LFunc, bits: u64) -> lir::FreshVReg {
    let r = lir::alloc_vreg(f0)
    lir::FreshVReg { func = lir::append_inst(r.func, 0, lir::const_float_inst(r.vreg, bits, true, 0, 0)); vreg = r.vreg }
}

#test
/**
 * xat_win64_call_args_number_both_files_by_shared_position — the CALLER half of
 * `B3-argslot`, and the shape that faulted on Windows: an outgoing
 * `(f64, i64, f64, i64, i64)` argument list takes XMM0, RDX, XMM2, R9 and one
 * stack slot, never the SysV-style XMM0, RCX, XMM1, RDX with nothing on the stack.
 *
 * This is `tk_ftoa_len(double, uint64_t *out_len)` generalized: its out-pointer is
 * argument POSITION 1, so it belongs in RDX, and the per-file counter left it in
 * RCX while the MSVC-built callee wrote through whatever RDX happened to hold.
 *
 * Every operand is spelled with its OWN register-file marker, the one
 * `reg_ref_x86` prints: a virtual FPR is `%fN`, never `%N`. `pin_reg_args_x86`
 * builds an argument move's destination AND its source from the one `is_fpr`
 * decision, so an `fmov` whose source carried the GPR spelling was a text no
 * selection could ever emit — a guard that failed on every host, not a
 * platform difference. `xat_float_param_lands_in_xmm0_and_returns_in_xmm0`
 * had already been asserting `fmov.d %pf0, %f0` green over this same pin.
 *
 * Inverted against the per-file counting this rule replaced (`WIN64` with
 * `arg_slots_shared = false`) 4 of these 5 assertions go red; against the
 * shared-position rule, 0 of 5.
 *
 * @return void
 */
fn xat_win64_call_args_number_both_files_by_shared_position() {
    let text = xat_dump_abi(WIN64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p2, %1")
    teko::assert::str_contains(text, "fmov.d %pf2, %f2")
    teko::assert::str_contains(text, "mov.q %p9, %3")
    teko::assert::str_contains(text, "mov.q [outarg #0], %4")
}

#test
/**
 * xat_sysv_call_args_keep_independent_per_file_counting — the byte-identity
 * guardrail for the caller half: the same argument list keeps SysV's
 * XMM0/RDI/XMM1/RSI/RDX with no outgoing stack slot at all.
 *
 * The float sources carry the `%fN` file marker for the same reason the Win64
 * twin above does — the caller-side spelling is the printer's, not the
 * fixture author's. Its first assertion is BYTE-IDENTICAL to the Win64 twin's,
 * which is why the two can only ever be red together: a CI leg reporting one
 * and not the other reported an incomplete run, never a platform difference.
 *
 * @return void
 */
fn xat_sysv_call_args_keep_independent_per_file_counting() {
    let text = xat_dump_abi(SYSV64, xat_mixed_class_call())
    teko::assert::str_contains(text, "fmov.d %pf0, %f0")
    teko::assert::str_contains(text, "mov.q %p7, %1")
    teko::assert::str_contains(text, "fmov.d %pf1, %f2")
    teko::assert::str_contains(text, "mov.q %p6, %3")
    teko::assert::str_contains(text, "mov.q %p2, %4")
    teko::assert::is_false(teko::runtime::str_contains(text, "[outarg #"))
}
