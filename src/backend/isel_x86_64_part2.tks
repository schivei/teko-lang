fn select_param_x86(abi: AbiDescriptor, ctx0: SelCtxX86, f: lir::LFunc, inst: lir::LInst, p: lir::LParam) -> SelCtxX86 | error {
    if p.index >= f.param_types.len {
        return error { message = "isel x86-64: param index out of range (internal)" }
    }
    let ty = f.param_types[p.index to u64]
    let reg_class = mregclass_of_ltype(ty)
    let wide = ltype_is_wide(ty)
    let is_fpr = reg_class == MRegClass::FPR
    let slot = arg_reg(abi, reg_class, param_class_index_x86(abi, f.param_types, p.index))
    let dst = vreg(inst.result, reg_class)
    let ctx1 = selctx_x86_set_vinfo(ctx0, inst.result, reg_class, wide)
    if !slot.ok {
        let stack_index = stack_index_before(abi, f.param_types, p.index)
        return selctx_x86_emit(ctx1, in_arg_x86(arg_slot_size_x86(reg_class, wide), dst, stack_index))
    }
    let mv = if is_fpr { fmov_x86(dst, slot.reg, wide) } else { mov_x86(dst, slot.reg, wide) }
    selctx_x86_emit(ctx1, mv)
}

/**
 * select_ret_x86 — the `LRet` selection (§4.5): for a value-carrying return,
 * pin the returned VReg's current value into the ABI's result register — RAX
 * (decision D-A — the result register is NOT the first argument register) or
 * XMM0 (`B1-fp`), by its recorded `class_of` — via `MMovX86`/`MFMovX86`, then
 * emit `ret`; a void return emits `ret` alone.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LRet r  the return op
 * @return SelCtxX86  the advanced context
 */
fn select_ret_x86(ctx0: SelCtxX86, r: lir::LRet) -> SelCtxX86 {
    if !r.has_value {
        return selctx_x86_emit(ctx0, ret_x86())
    }
    let info = vinfo_get(ctx0.vinfo, r.value)
    let is_fpr = info.reg_class == MRegClass::FPR
    let pinned = if is_fpr { XMM0_X86 } else { RAX_X86 }
    let mv = if is_fpr { fmov_x86(pinned, vreg(r.value, MRegClass::FPR), info.wide) } else { mov_x86(pinned, vreg(r.value, MRegClass::GPR), info.wide) }
    let ctx1 = selctx_x86_emit(ctx0, mv)
    selctx_x86_emit(ctx1, ret_x86())
}

/**
 * selctx_x86_set_block_param — refine mirror block `block_id`'s parameter at
 * `index` to `reg` in the context's function (the class becomes known when the
 * feeding edge move is selected).
 *
 * @param SelCtxX86 ctx  the context to update
 * @param u32 block_id  the target block
 * @param u32 index  the parameter position
 * @param MReg reg  the refined parameter register
 * @return SelCtxX86  the updated context
 */
fn selctx_x86_set_block_param(ctx: SelCtxX86, block_id: u32, index: u32, reg: MReg) -> SelCtxX86 {
    SelCtxX86 { func = set_block_param_x86(ctx.func, block_id, index, reg); vinfo = ctx.vinfo; next_scratch = ctx.next_scratch; cur_block = ctx.cur_block; next_block = ctx.next_block }
}

/**
 * emit_edge_moves_x86 — the parallel-copy of `args` into the block params of
 * `target`, emitted into the current block just before the branch. A plain
 * sequential copy is correct by construction: a block param is always a FRESH
 * VReg (from `add_block_param`), disjoint from every jump arg, so no source is
 * also a destination and no cycle can arise. Each move refines the target
 * param's register class and records the param's `class_of`; a float-class
 * edge value moves via `MFMovX86` (`B1-fp`).
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LFunc f  the enclosing function (for the target's params)
 * @param u32 target  the destination block id
 * @param args  the block-args this edge supplies, positionally
 * @return SelCtxX86 | error  the advanced context, or a NAMED honest-stop
 */
fn emit_edge_moves_x86(ctx0: SelCtxX86, f: lir::LFunc, target: u32, args: []u32) -> SelCtxX86 | error {
    let params = block_params_of(f, target)
    if params.len != args.len {
        return error { message = "isel x86-64: edge arg count does not match target block param count (internal)" }
    }
    mut ctx = ctx0
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        let src = args[i]
        let src_info = vinfo_get(ctx.vinfo, src)
        let dst = vreg(params[i], src_info.reg_class)
        let mv = if src_info.reg_class == MRegClass::FPR { fmov_x86(dst, vreg(src, MRegClass::FPR), src_info.wide) } else { mov_x86(dst, vreg(src, MRegClass::GPR), src_info.wide) }
        let ctx_a = selctx_x86_emit(ctx, mv)
        let ctx_b = selctx_x86_set_block_param(ctx_a, target, i to u32, dst)
        ctx = selctx_x86_set_vinfo(ctx_b, params[i], src_info.reg_class, src_info.wide)
        i++
    }
    ctx
}

/**
 * select_jump_x86 — the `LJump` selection: the parallel-copy of its block-args
 * into the target's params, then an unconditional `jmp` to the target (the
 * explicit terminator form — no fall-through emission, §4.1).
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LFunc f  the enclosing function
 * @param lir::LJump j  the jump op
 * @return SelCtxX86 | error  the advanced context, or a propagated error
 */
fn select_jump_x86(ctx0: SelCtxX86, f: lir::LFunc, j: lir::LJump) -> SelCtxX86 | error {
    let ctx1 = match emit_edge_moves_x86(ctx0, f, j.target, j.args) { SelCtxX86 as c => c; error as e => return e }
    selctx_x86_emit(ctx1, jmp_x86(j.target))
}

/**
 * EdgeResX86 — a resolved branch edge: the block the branch actually targets
 * (the real block for an empty-arg edge, or a freshly-split edge block that
 * performs the moves then jumps on), plus the advanced context.
 *
 * @since #386 B1-3
 */
type EdgeResX86 = struct {
    /**
     * ctx — the advanced context (edge block appended when one was split).
     */
    ctx: SelCtxX86
    /**
     * block — the machine-block id the branch transfers control to.
     */
    block: u32
}

/**
 * resolve_edge_x86 — the landing block for one branch edge. A conditional `jcc`
 * cannot carry moves, so an edge that supplies block-args is split into its own
 * block (the moves, then `jmp` to the real target) and the branch targets that
 * edge block; an empty-arg edge branches straight to its target (the fast path
 * the corpus hits in practice). The current emit target is restored before
 * returning.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LFunc f  the enclosing function
 * @param u32 target  the edge's real destination block
 * @param args  the block-args the edge supplies (empty for the fast path)
 * @return EdgeResX86 | error  the landing block + advanced context, or an error
 */
fn resolve_edge_x86(ctx0: SelCtxX86, f: lir::LFunc, target: u32, args: []u32) -> EdgeResX86 | error {
    if args.len == 0 {
        return EdgeResX86 { ctx = ctx0; block = target }
    }
    let saved = ctx0.cur_block
    let fb = selctx_x86_new_block(ctx0)
    let ctx_in = selctx_x86_switch(fb.ctx, fb.id)
    let ctx_moved = match emit_edge_moves_x86(ctx_in, f, target, args) { SelCtxX86 as c => c; error as e => return e }
    let ctx_end = selctx_x86_emit(ctx_moved, jmp_x86(target))
    let ctx_back = selctx_x86_switch(ctx_end, saved)
    EdgeResX86 { ctx = ctx_back; block = fb.id }
}

/**
 * select_fused_float_branch_x86 — the taken-edge selection when the fused
 * compare is a FLOAT compare (`B1-fp`): `LT`/`LE`/`GT`/`GE` need only the same
 * swap-operand trick `select_fcmp_value_x86` already uses (a single `ucomisd`
 * + `jcc HI`/`HS`, unordered/NaN uniformly NOT-taken, matching that helper's
 * own doc); `EQ`/`NE` need the ordered/parity composite that helper builds as
 * a VALUE (a bare fused `ucomisd`+`jcc` cannot express "ordered AND equal" in
 * one jump) — so those two materialize the corrected 0/1 value into a scratch
 * GPR first, then take the edge by testing that scratch against zero, exactly
 * `select_boolean_branch_x86`'s own zero-compare-and-`jne` shape.
 *
 * @param SelCtxX86 ctx1  the context to extend (edges already resolved)
 * @param MCond cond  the float condition (EQ/NE/LT/LE/GT/GE)
 * @param a  the first compared VReg
 * @param b  the second compared VReg
 * @param bool dbl  the compared operands' width (true for the f64 form)
 * @param u32 taken  the machine-block id taken when the compare holds
 * @return SelCtxX86  the advanced context
 */
fn select_fused_float_branch_x86(ctx1: SelCtxX86, cond: MCond, a: u32, b: u32, dbl: bool, taken: u32) -> SelCtxX86 {
    match cond {
        LT => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(b, MRegClass::FPR), vreg(a, MRegClass::FPR), dbl)), jcc_x86(MCond::HI, taken))
        LE => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(b, MRegClass::FPR), vreg(a, MRegClass::FPR), dbl)), jcc_x86(MCond::HS, taken))
        GT => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(a, MRegClass::FPR), vreg(b, MRegClass::FPR), dbl)), jcc_x86(MCond::HI, taken))
        GE => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(a, MRegClass::FPR), vreg(b, MRegClass::FPR), dbl)), jcc_x86(MCond::HS, taken))
        LO => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(b, MRegClass::FPR), vreg(a, MRegClass::FPR), dbl)), jcc_x86(MCond::HI, taken))
        LS => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(b, MRegClass::FPR), vreg(a, MRegClass::FPR), dbl)), jcc_x86(MCond::HS, taken))
        HI => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(a, MRegClass::FPR), vreg(b, MRegClass::FPR), dbl)), jcc_x86(MCond::HI, taken))
        HS => selctx_x86_emit(selctx_x86_emit(ctx1, fcmp_x86(vreg(a, MRegClass::FPR), vreg(b, MRegClass::FPR), dbl)), jcc_x86(MCond::HS, taken))
        EQ => {
            let scratch = selctx_x86_scratch(ctx1, MRegClass::GPR)
            let ctx2 = select_fcmp_value_x86(scratch.ctx, scratch.reg, MCond::EQ, a, b, dbl)
            let zero = selctx_x86_scratch(ctx2, MRegClass::GPR)
            let ctx3 = selctx_x86_emit(zero.ctx, movimm_x86(zero.reg, 0, false))
            let ctx4 = selctx_x86_emit(ctx3, cmp_x86(scratch.reg, zero.reg, false))
            selctx_x86_emit(ctx4, jcc_x86(MCond::NE, taken))
        }
        NE => {
            let scratch = selctx_x86_scratch(ctx1, MRegClass::GPR)
            let ctx2 = select_fcmp_value_x86(scratch.ctx, scratch.reg, MCond::NE, a, b, dbl)
            let zero = selctx_x86_scratch(ctx2, MRegClass::GPR)
            let ctx3 = selctx_x86_emit(zero.ctx, movimm_x86(zero.reg, 0, false))
            let ctx4 = selctx_x86_emit(ctx3, cmp_x86(scratch.reg, zero.reg, false))
            selctx_x86_emit(ctx4, jcc_x86(MCond::NE, taken))
        }
    }
}

/**
 * select_fused_branch_x86 — the taken-edge selection when the branch condition
 * is a compare fused into this branch: re-emit the compare over its operands
 * (nothing was materialized at the compare site) then a `jcc` to the taken
 * block — the integer path a single `cmp`+`jcc`; the float path
 * `select_fused_float_branch_x86` (`B1-fp`).
 *
 * @param SelCtxX86 ctx1  the context to extend (edges already resolved)
 * @param DefCmp dc  the resolved compare definition (opcode + operands)
 * @param u32 taken  the machine-block id taken when the compare holds
 * @return SelCtxX86  the advanced context
 */
fn select_fused_branch_x86(ctx1: SelCtxX86, dc: DefCmp, taken: u32) -> SelCtxX86 {
    let ck = cmp_kind_of(dc.op)
    let a_info = vinfo_get(ctx1.vinfo, dc.a)
    if ck.is_float {
        return select_fused_float_branch_x86(ctx1, ck.cond, dc.a, dc.bb, a_info.wide, taken)
    }
    let ca = selctx_x86_emit(ctx1, cmp_x86(vreg(dc.a, MRegClass::GPR), vreg(dc.bb, MRegClass::GPR), a_info.wide))
    selctx_x86_emit(ca, jcc_x86(ck.cond, taken))
}

/**
 * select_boolean_branch_x86 — the taken-edge selection for a generic boolean
 * condition (a value NOT produced by a fused compare): x86 has no
 * compare-and-branch, so the boolean is tested against a materialized zero
 * (`mov scratch, #0` ; `cmp cond, scratch`) and a `jne` takes the edge when the
 * condition is nonzero (true). The `MInstX86` alphabet has no compare-immediate
 * or `test`, so the explicit zero register keeps the selection within the
 * frozen B1-2 IR.
 *
 * @param SelCtxX86 ctx1  the context to extend (edges already resolved)
 * @param u32 cond  the boolean condition VReg
 * @param u32 taken  the machine-block id taken when `cond` is nonzero
 * @return SelCtxX86 | error  the advanced context
 */
fn select_boolean_branch_x86(ctx1: SelCtxX86, cond: u32, taken: u32) -> SelCtxX86 | error {
    let c_info = vinfo_get(ctx1.vinfo, cond)
    let scratch = selctx_x86_scratch(ctx1, MRegClass::GPR)
    let cz = selctx_x86_emit(scratch.ctx, movimm_x86(scratch.reg, 0, c_info.wide))
    let cc = selctx_x86_emit(cz, cmp_x86(vreg(cond, MRegClass::GPR), scratch.reg, c_info.wide))
    selctx_x86_emit(cc, jcc_x86(MCond::NE, taken))
}

/**
 * select_branch_x86 — the `LBranch` selection (§4.1): resolve each edge to a
 * landing block (splitting an arg-carrying edge), emit the conditional `jcc` to
 * the taken edge, then an unconditional `jmp` to the else edge — the explicit
 * pair form the reachability-aware regalloc expects (no fall-through). When the
 * condition is a compare fused into this branch, re-emit `cmp` + `jcc`;
 * otherwise test the boolean condition against zero.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LFunc f  the enclosing function
 * @param lir::LBranch br  the branch op
 * @return SelCtxX86 | error  the advanced context, or a propagated error
 */
fn select_branch_x86(ctx0: SelCtxX86, f: lir::LFunc, br: lir::LBranch) -> SelCtxX86 | error {
    let t_land = match resolve_edge_x86(ctx0, f, br.t_target, br.t_args) { EdgeResX86 as r => r; error as e => return e }
    let f_land = match resolve_edge_x86(t_land.ctx, f, br.f_target, br.f_args) { EdgeResX86 as r => r; error as e => return e }
    let ctx1 = f_land.ctx
    let dc = find_cmp_def(f, br.cond)
    let branched = if dc.found && is_fused_compare(f, br.cond) {
        select_fused_branch_x86(ctx1, dc, t_land.block)
    } else {
        select_boolean_branch_x86(ctx1, br.cond, t_land.block)
    }
    let ctx2 = match branched { SelCtxX86 as c => c; error as e => return e }
    selctx_x86_emit(ctx2, jmp_x86(f_land.block))
}

/**
 * mem_size_of_x86 — the load/store transfer size for a machine class: B/W/D/Q
 * for the integer widths (and Ptr = Q), F32/F64 for the float widths (an SSE
 * move, `B1-fp`). A void-typed access is malformed.
 *
 * @param lir::LType t  the accessed value's machine class
 * @return MMemSizeX86 | error  the transfer size, or a NAMED honest-stop
 */
fn mem_size_of_x86(t: lir::LType) -> MMemSizeX86 | error {
    match t {
        lir::LType::I8 => MMemSizeX86::B
        lir::LType::I16 => MMemSizeX86::W
        lir::LType::I32 => MMemSizeX86::D
        lir::LType::I64 => MMemSizeX86::Q
        lir::LType::Ptr => MMemSizeX86::Q
        lir::LType::F32 => MMemSizeX86::F32
        lir::LType::F64 => MMemSizeX86::F64
        lir::LType::Void => error { message = "isel x86-64: a void-typed memory access is malformed (internal)" }
    }
}

/**
 * select_alloca_x86 — the `LAlloca` selection: reserve a frame slot (its index
 * is the current frame length) and materialize its address with
 * `MFrameAddrX86`; the encoder resolves the slot to an `lea dst, [rsp+off]`
 * (base-RSP forces a SIB byte, §6.5). The address is a Ptr (wide GPR).
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LAlloca a  the alloca op (its byte-size/alignment shape)
 * @return SelCtxX86  the advanced context
 */
fn select_alloca_x86(ctx0: SelCtxX86, inst: lir::LInst, a: lir::LAlloca) -> SelCtxX86 {
    let slot = ctx0.func.frame.len
    let ctx1 = SelCtxX86 { func = append_frame_x86(ctx0.func, a); vinfo = ctx0.vinfo; next_scratch = ctx0.next_scratch; cur_block = ctx0.cur_block; next_block = ctx0.next_block }
    let dst = vreg(inst.result, MRegClass::GPR)
    let ctx2 = selctx_x86_set_vinfo(ctx1, inst.result, MRegClass::GPR, true)
    selctx_x86_emit(ctx2, frame_addr_x86(dst, slot))
}

/**
 * select_field_addr_x86 — the `LFieldAddr` selection: `dst = base + offset`.
 * The `MInstX86` alphabet carries no add-immediate form (the two-address RMW is
 * register-register only), and the general `lea dst, [base+disp]` is not in the
 * B1-2 IR, so the constant offset is materialized into a scratch register
 * (`mov scratch, #offset`) then folded in with the two-address add
 * (`mov dst, base` ; `add dst, scratch`). This stays within the frozen alphabet
 * (smallest blast, M.1); a later pass folds the offset into a following load's
 * `MMem` displacement (§6.4).
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LFieldAddr fa  the field-address op
 * @return SelCtxX86  the advanced context
 */
fn select_field_addr_x86(ctx0: SelCtxX86, inst: lir::LInst, fa: lir::LFieldAddr) -> SelCtxX86 {
    let dst = vreg(inst.result, MRegClass::GPR)
    let ctx1 = selctx_x86_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    let scratch = selctx_x86_scratch(ctx1, MRegClass::GPR)
    let ctx2 = selctx_x86_emit(scratch.ctx, movimm_x86(scratch.reg, fa.offset to i64, true))
    let ctx3 = selctx_x86_emit(ctx2, mov_x86(dst, vreg(fa.base, MRegClass::GPR), true))
    selctx_x86_emit(ctx3, alu_rm_x86(MAluOpX86::Add, dst, scratch.reg, true))
}

/**
 * select_load_x86 — the `LLoad` selection: `mov`/`movsd`/`movss dst,
 * [addr + 0]` at the size + register file the loaded `ty` picks (`B1-fp`).
 * Loads zero-extend (`sign=false`): a narrow value's own producing extend
 * chain already fixed its class, so the load itself does not re-sign (a
 * float load carries no sign concept either way).
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LLoad l  the load op
 * @return SelCtxX86 | error  the advanced context, or a propagated size error
 */
fn select_load_x86(ctx0: SelCtxX86, inst: lir::LInst, l: lir::LLoad) -> SelCtxX86 | error {
    let size = match mem_size_of_x86(l.ty) { MMemSizeX86 as s => s; error as e => return e }
    let reg_class = mregclass_of_ltype(l.ty)
    let wide = ltype_is_wide(l.ty)
    let dst = vreg(inst.result, reg_class)
    let ctx1 = selctx_x86_set_vinfo(ctx0, inst.result, reg_class, wide)
    selctx_x86_emit(ctx1, load_x86(size, false, dst, MMem { base = vreg(l.addr, MRegClass::GPR); offset = 0 to i32 }))
}

/**
 * select_store_x86 — the `LStore` selection: `mov`/`movsd`/`movss
 * [addr + 0], src` at the size + register file the stored `ty` picks
 * (`B1-fp`). No result VReg.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LStore s  the store op
 * @return SelCtxX86 | error  the advanced context, or a propagated size error
 */
fn select_store_x86(ctx0: SelCtxX86, s: lir::LStore) -> SelCtxX86 | error {
    let size = match mem_size_of_x86(s.ty) { MMemSizeX86 as sz => sz; error as e => return e }
    let reg_class = mregclass_of_ltype(s.ty)
    selctx_x86_emit(ctx0, store_x86(size, vreg(s.value, reg_class), MMem { base = vreg(s.addr, MRegClass::GPR); offset = 0 to i32 }))
}

/**
 * select_global_addr_x86 — the `LGlobalAddr` selection: a single
 * `lea dst, [rip + disp32]` with one `Pc32` relocation (§4.3). The x86
 * single-instruction rip-relative form COLLAPSES arm64's ADRP+ADD pair (two
 * relocations) into one instruction the ELF writer patches with one entry.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LGlobalAddr g  the global-address op
 * @return SelCtxX86  the advanced context
 */
fn select_global_addr_x86(ctx0: SelCtxX86, inst: lir::LInst, g: lir::LGlobalAddr) -> SelCtxX86 {
    let dst = vreg(inst.result, MRegClass::GPR)
    let ctx1 = selctx_x86_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_x86_emit(ctx1, lea_rip_x86(dst, g.symbol, RelocKindX86::Pc32))
}

/**
 * select_func_addr_x86 — the `LFuncAddr` selection: the same single
 * `lea dst, [rip + disp32]` as a global address, addressing a function symbol
 * with a `Pc32` relocation (the standard `lea foo(%rip)` form for a
 * locally-defined function; an external symbol's PLT/GOT indirection is the
 * `B1-globals`/linker concern, §7.2). Both address materializations collapse to
 * the one rip-relative lea, distinguished only by their symbol.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LFuncAddr fa  the function-address op
 * @return SelCtxX86  the advanced context
 */
fn select_func_addr_x86(ctx0: SelCtxX86, inst: lir::LInst, fa: lir::LFuncAddr) -> SelCtxX86 {
    let dst = vreg(inst.result, MRegClass::GPR)
    let ctx1 = selctx_x86_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_x86_emit(ctx1, lea_rip_x86(dst, fa.symbol, RelocKindX86::Pc32))
}

/**
 * PinnedArgsX86 — the outcome of lowering a call's arguments into their SysV
 * argument registers: the advanced context + the pinned physical registers (the
 * `uses` the `MCallX86`/`MCallIndX86` records for regalloc liveness).
 *
 * @since #386 B1-3
 */
type PinnedArgsX86 = struct {
    /**
     * ctx — the context with every argument pinned into its ABI register.
     */
    ctx: SelCtxX86
    /**
     * uses — the physical argument registers pinned, in argument order.
     */
    uses: []MReg
}

/**
 * pin_args_x86 — lower each argument into the target ABI's slot (§4.5),
 * classified by the descriptor's own slot-numbering rule (GPR: SysV
 * RDI/RSI/RDX/RCX/R8/R9, Win64 RCX/RDX/R8/R9; FPR: XMM0..7, XMM0..3 on Win64 —
 * `B1-fp`; per-file counters on SysV, one shared argument position on Win64 —
 * `B3-argslot`), read through
 * the descriptor because neither argument order is the contiguous encoding
 * order, collecting the physregs as the call's `uses`. The `abi` descriptor is
 * threaded from the emit driver so the SAME isel places a call's outgoing
 * arguments in SysV registers on x86-linux and in the Win64 registers on
 * x86_64-windows. An argument past its class's argument-register window is
 * STORED into the caller-owned stack-arg area instead (`MOutArgX86`, `B1-args`,
 * closed 2026-07-29) and contributes no `use` — it travels through memory, so no
 * physical register has to be kept live across the call for it.
 *
 * A variadic call still honest-stops. That stop is a GUARD, not a deferral:
 * measured 2026-07-29, all eighteen call-construction sites in `lir/lower.tks`
 * pass `variadic = false`, so no lowering this compiler performs can reach it —
 * the register/stack split above is already what a variadic SysV call needs, but
 * the AL vector count it must also set (and Win64's rule that a float vararg
 * travels in BOTH files) would be ABI code with no caller to exercise it.
 *
 * @param AbiDescriptor abi  the target ABI register file (SysV or Win64)
 * @param SelCtxX86 ctx0  the context to extend
 * @param args  the argument VRegs, in declaration order
 * @param bool variadic  whether the call is variadic (honest-stops here)
 * @return PinnedArgsX86 | error  the pinned args, or a NAMED honest-stop
 */
fn pin_args_x86(abi: AbiDescriptor, ctx0: SelCtxX86, args: []u32, variadic: bool) -> PinnedArgsX86 | error {
    if variadic {
        return error { message = "isel x86-64: B1-args — a variadic call needs the AL vector count (SysV) and the dual-file float rule (Win64); LCall carries no arity (0.3.1)" }
    }
    pin_reg_args_x86(abi, store_stack_args_x86(abi, ctx0, args), args)
}

/**
 * arg_class_index_x86 — the index argument `i` occupies inside its own register
 * file's argument window at a CALL site, the caller-side twin of
 * `param_class_index_x86`: the argument POSITION when the ABI numbers both files
 * by one shared slot (Win64, `B3-argslot`), else how many earlier arguments share
 * this one's class (SysV, `B1-fp`).
 *
 * @param AbiDescriptor abi  the target ABI register file (its slot-numbering rule)
 * @param SelCtxX86 ctx  the context whose `vinfo` records each argument's class
 * @param []u32 args  the argument VRegs, in declaration order
 * @param u64 i  the argument position to resolve
 * @return u32  the index to look up in that class's argument-register window
 */
fn arg_class_index_x86(abi: AbiDescriptor, ctx: SelCtxX86, args: []u32, i: u64) -> u32 {
    if abi.arg_slots_shared { return i to u32 }
    let is_fpr = vinfo_get(ctx.vinfo, args[i]).reg_class == MRegClass::FPR
    mut n: u32 = 0
    mut j: u64 = 0
    loop {
        if j >= i { break }
        if (vinfo_get(ctx.vinfo, args[j]).reg_class == MRegClass::FPR) == is_fpr { n++ }
        j++
    }
    n
}

/**
 * arg_slot_x86 — where argument `i` of `args` travels: the `ArgReg` its class's
 * window yields (`ok` false meaning "this one overflows to the stack"), reading
 * each argument's class out of the recorded `vinfo` and its window index out of
 * the descriptor's slot-numbering rule (`arg_class_index_x86` —
 * `B1-fp`/`B1-args`/`B3-argslot`). One shared classifier so
 * `store_stack_args_x86` and `pin_reg_args_x86` cannot disagree about which
 * arguments went where.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param SelCtxX86 ctx  the context whose `vinfo` records each argument's class
 * @param []u32 args  the argument VRegs, in declaration order
 * @param u64 i  the argument position to classify
 * @return ArgReg  the assigned argument register, or `ok = false` for a stack argument
 */
fn arg_slot_x86(abi: AbiDescriptor, ctx: SelCtxX86, args: []u32, i: u64) -> ArgReg {
    let cls = vinfo_get(ctx.vinfo, args[i]).reg_class
    arg_reg(abi, cls, arg_class_index_x86(abi, ctx, args, i))
}

/**
 * store_stack_args_x86 — the FIRST of the two argument-lowering passes
 * (`B1-args`): store every argument that overflowed its class's register window
 * into the caller-owned stack-arg area, in declaration order, as `MOutArgX86`.
 *
 * Run BEFORE the register pins on purpose. A stack argument's own value still
 * needs a register to be stored FROM, and every physical argument register the
 * second pass pins is live from its pin to the call — doing the memory traffic
 * first means the stores compete with as few fixed intervals as possible.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param SelCtxX86 ctx0  the context to extend
 * @param []u32 args  the argument VRegs, in declaration order
 * @return SelCtxX86  the advanced context
 */
fn store_stack_args_x86(abi: AbiDescriptor, ctx0: SelCtxX86, args: []u32) -> SelCtxX86 {
    mut ctx = ctx0
    mut stack_n: u32 = 0
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if !arg_slot_x86(abi, ctx, args, i).ok {
            let info = vinfo_get(ctx.vinfo, args[i])
            ctx = selctx_x86_emit(ctx, out_arg_x86(arg_slot_size_x86(info.reg_class, info.wide), vreg(args[i], info.reg_class), stack_n))
            stack_n++
        }
        i++
    }
    ctx
}

/**
 * pin_reg_args_x86 — the SECOND argument-lowering pass: move every argument that
 * DID fit its class's window into the physical register `arg_reg` named for it,
 * collecting those physregs as the call's `uses` so the regalloc keeps them live
 * to the call. A stack argument is skipped here — `store_stack_args_x86` already
 * placed it, and it contributes no register use.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param SelCtxX86 ctx0  the context to extend (stack arguments already stored)
 * @param []u32 args  the argument VRegs, in declaration order
 * @return PinnedArgsX86  the advanced context and the pinned physregs
 */
fn pin_reg_args_x86(abi: AbiDescriptor, ctx0: SelCtxX86, args: []u32) -> PinnedArgsX86 {
    mut ctx = ctx0
    mut uses: []MReg = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        let slot = arg_slot_x86(abi, ctx, args, i)
        if slot.ok {
            let info = vinfo_get(ctx.vinfo, args[i])
            let is_fpr = info.reg_class == MRegClass::FPR
            let mv = if is_fpr { fmov_x86(slot.reg, vreg(args[i], MRegClass::FPR), info.wide) } else { mov_x86(slot.reg, vreg(args[i], MRegClass::GPR), info.wide) }
            ctx = selctx_x86_emit(ctx, mv)
            uses = teko::list::push(uses, slot.reg)
        }
        i++
    }
    PinnedArgsX86 { ctx = ctx; uses = uses }
}

/**
 * X86_STR_ARG_BYTES — the byte size of a `tk_str` (`teko_rt.h:45-48`: a pointer
 * plus a `size_t`, both 8 bytes on every x86-64 target). The threshold
 * `max_reg_arg_bytes` is compared against to decide register-vs-reference
 * passing, and the size of the frame slot the by-reference copy lives in.
 */
const X86_STR_ARG_BYTES: u32 = 16 to u32

/**
 * X86_STR_ARG_ALIGN — the alignment of a `tk_str` frame copy (8: its widest
 * field is an 8-byte pointer).
 */
const X86_STR_ARG_ALIGN: u32 = 8 to u32

/**
 * X86_STR_LEN_OFFSET — the byte offset of `tk_str`'s `len` field inside the
 * struct (`ptr` at 0, `len` at 8) — the displacement the by-reference copy's
 * second store writes at.
 */
const X86_STR_LEN_OFFSET: i32 = 8 to i32

/**
 * by_ref_fat_pairs_x86 — how many of this call's leading flattened `(ptr, len)`
 * pairs, which the TARGET-NEUTRAL LIR produced from by-value `tk_str` parameters
 * (`lower.tks::lower_str_arg_call`, `fat_eq_call_args`, `lower_last_index_of_call`),
 * must be re-materialized and passed BY REFERENCE instead?
 *
 * ZERO on an ABI that carries a 16-byte aggregate in registers
 * (`max_reg_arg_bytes == 16` — SysV/AAPCS64/LP64D), where the flat pair IS the
 * true C ABI, so those targets keep the byte-identical register sequence
 * (FIXPOINT). Otherwise (Win64: an aggregate travels in a register ONLY at size
 * 1/2/4/8) it is the callee's own fat arity, read from the LIR
 * (`lir::fat_arg_builtin_arity`) so the table is single-sourced — one pair for the
 * io group, TWO for `tk_str_eq`/`tk_str_contains`/`tk_str_ends_with`/
 * `tk_rt_last_index_of_ok`.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param str symbol  the call's already-final runtime symbol
 * @return u64  the number of leading pairs to pass by reference (0 on SysV)
 */
fn by_ref_fat_pairs_x86(abi: AbiDescriptor, symbol: str) -> u64 {
    if abi.max_reg_arg_bytes >= X86_STR_ARG_BYTES { return 0 }
    lir::fat_arg_builtin_arity(symbol)
}

/**
 * FatSlotsX86 — the frame-slot ADDRESSES of every re-materialized `tk_str`
 * argument, in declaration order, plus the context that reserved and filled them.
 *
 * @since 0.3.1.0 (Win64 fat-pair generalization)
 */
type FatSlotsX86 = struct {
    /**
     * ctx — the context with each slot reserved and both halves stored.
     */
    ctx: SelCtxX86
    /**
     * addrs — one scratch register per pair, holding that pair's slot address.
     */
    addrs: []MReg
}

/**
 * materialize_one_fat_pair_x86 — reserve a 16-byte frame slot, take its address
 * (`MFrameAddrX86` — the encoder resolves it to `lea scratch, [rsp+off]`, above
 * the shadow region `compute_frame_layout_x86` already reserves) and store the
 * pair into it: `ptr` at +0 and `len` at +8, `tk_str`'s own field order.
 *
 * Both halves store at `Q` width. `len` is a `size_t`, and the SysV path already
 * relies on the same invariant (it moves the whole 64-bit register into its
 * argument register), so a narrow producer's zero-extended upper half is not a new
 * assumption. Neither half can be float-class — every producer of a flattened pair
 * builds it from a fat pointer's address and byte length — so there is no `B1-fp`
 * arm here.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param u32 ptr  the VReg holding the pair's pointer half
 * @param u32 len  the VReg holding the pair's byte length
 * @return FreshScratchX86  the advanced context + the register holding the slot's
 *                          address
 */
fn materialize_one_fat_pair_x86(ctx0: SelCtxX86, ptr: u32, len: u32) -> FreshScratchX86 {
    let frame_slot = ctx0.func.frame.len
    let with_slot = append_frame_x86(ctx0.func, lir::LAlloca { bytes = X86_STR_ARG_BYTES; align = X86_STR_ARG_ALIGN })
    let ctx1 = SelCtxX86 { func = with_slot; vinfo = ctx0.vinfo; next_scratch = ctx0.next_scratch; cur_block = ctx0.cur_block; next_block = ctx0.next_block }
    let scratch = selctx_x86_scratch(ctx1, MRegClass::GPR)
    let ctx2 = selctx_x86_emit(scratch.ctx, frame_addr_x86(scratch.reg, frame_slot))
    let ctx3 = selctx_x86_emit(ctx2, store_x86(MMemSizeX86::Q, vreg(ptr, MRegClass::GPR), MMem { base = scratch.reg; offset = 0 to i32 }))
    let ctx4 = selctx_x86_emit(ctx3, store_x86(MMemSizeX86::Q, vreg(len, MRegClass::GPR), MMem { base = scratch.reg; offset = X86_STR_LEN_OFFSET }))
    FreshScratchX86 { ctx = ctx4; reg = scratch.reg }
}

/**
 * materialize_fat_pairs_x86 — the FIRST of the two by-reference passes: one frame
 * copy per leading pair (`materialize_one_fat_pair_x86`), in declaration order, so
 * `args[2k]`/`args[2k+1]` land in the slot whose address becomes argument `k`.
 *
 * Run entirely BEFORE any physical argument register is pinned, for the same
 * reason `store_stack_args_x86` runs before `pin_reg_args_x86`: the memory traffic
 * of a later pair would otherwise sit BETWEEN an earlier pair's pin and the call,
 * competing with a live fixed interval for no reason.
 *
 * @param SelCtxX86 ctx0  the context to extend
 * @param []u32 args  the call's flattened argument VRegs (the pairs lead)
 * @param u64 pairs  how many leading pairs to copy
 * @return FatSlotsX86  the advanced context + one slot address per pair
 */
fn materialize_fat_pairs_x86(ctx0: SelCtxX86, args: []u32, pairs: u64) -> FatSlotsX86 {
    mut ctx = ctx0
    mut addrs: []MReg = teko::list::empty()
    mut k: u64 = 0
    loop {
        if k >= pairs { break }
        let one = materialize_one_fat_pair_x86(ctx, args[k * 2], args[k * 2 + 1])
        ctx = one.ctx
        addrs = teko::list::push(addrs, one.reg)
        k++
    }
    FatSlotsX86 { ctx = ctx; addrs = addrs }
}

/**
 * pin_fat_slot_addrs_x86 — the SECOND pass over the pairs: move each slot ADDRESS
 * into the integer argument register of its own position (`addrs[k]` → argument
 * `k`: RCX, then RDX, …) and collect those physregs as the call's `uses`.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param SelCtxX86 ctx0  the context whose slots are already filled
 * @param []MReg addrs  one slot address per pair, in declaration order
 * @return PinnedArgsX86 | error  the pinned addresses, or a NAMED honest-stop when
 *                                the ABI has no argument register at that position
 */
fn pin_fat_slot_addrs_x86(abi: AbiDescriptor, ctx0: SelCtxX86, addrs: []MReg) -> PinnedArgsX86 | error {
    mut ctx = ctx0
    mut uses: []MReg = teko::list::empty()
    mut k: u64 = 0
    loop {
        if k >= addrs.len { break }
        let slot = arg_reg(abi, MRegClass::GPR, k to u32)
        if !slot.ok {
            return error { message = "isel x86-64: an ABI with no integer argument register cannot pass a by-reference aggregate (internal)" }
        }
        ctx = selctx_x86_emit(ctx, mov_x86(slot.reg, addrs[k], true))
        uses = teko::list::push(uses, slot.reg)
        k++
    }
    PinnedArgsX86 { ctx = ctx; uses = uses }
}

/**
 * pin_trailing_scalar_args_x86 — the args AFTER the by-reference pairs, pinned
 * into the argument registers that follow them: `tk_rt_last_index_of_ok`'s
 * `uint64_t *out_index` is exactly this case (two references in RCX/RDX, the
 * out-slot address in R8).
 *
 * COLLAPSING THE PAIRS RENUMBERS THE SLOTS. Each by-reference pair took TWO
 * flattened operands and travels in ONE register, so flattened operand `i` sits at
 * argument POSITION `i - pairs` — and that position IS the window index here,
 * because this path exists only on an ABI whose two register files share their
 * slots by position (`by_ref_fat_pairs_x86` answers 0 on every ABI that carries a
 * 16-byte aggregate in registers, so SysV never arrives). An FPR-class trailing
 * argument therefore takes the XMM of that same position (`B3-argslot`, dispatched
 * 2026-07-30 — it used to honest-stop for want of exactly this numbering). A
 * trailing argument past the register window still honest-stops: with four
 * argument slots and at most two pairs plus one out-slot, no shipped entry reaches
 * it.
 *
 * @param AbiDescriptor abi  the target ABI register file
 * @param PinnedArgsX86 pinned  the pairs already pinned (its context + uses)
 * @param []u32 args  the call's flattened argument VRegs
 * @param u64 pairs  how many leading pairs were passed by reference
 * @return PinnedArgsX86 | error  every argument pinned, or a NAMED honest-stop
 */
