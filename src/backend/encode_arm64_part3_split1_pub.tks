
/**
 * emit_prologue — the function's entry sequence, or an empty list for a
 * frameless function: the ORIGINAL byte-for-byte `emit_prologue_small` shape
 * when the frame fits the STP field, else the `emit_prologue_big` sequence
 * (A4-2's big-frame fast-follow) for a frame that does not.
 *
 * @param FrameLayout layout  the resolved frame
 * @return []u32 | error  the prologue words, or the `A4-bigframe` honest-stop
 */
pub fn emit_prologue(layout: FrameLayout) -> []u32 | error {
    if layout.size == (0 to u32) {
        let none: []u32 = teko::list::empty()
        return none
    }
    if frame_fits(layout) { return emit_prologue_small(layout) }
    emit_prologue_big(layout)
}

/**
 * emit_epilogue — the function's frame-teardown sequence (LIFO), or an empty
 * list for a frameless function: the ORIGINAL byte-for-byte
 * `emit_epilogue_small` shape when the frame fits the STP field, else the
 * `emit_epilogue_big` sequence for a frame that does not. The `RET` itself is
 * the `MRet` encoding (`encode_ret`), which the function-encode layer (A4-3)
 * emits immediately after these words.
 *
 * @param FrameLayout layout  the resolved frame
 * @return []u32 | error  the teardown words, or the `A4-bigframe` honest-stop
 */
pub fn emit_epilogue(layout: FrameLayout) -> []u32 | error {
    if layout.size == (0 to u32) {
        let none: []u32 = teko::list::empty()
        return none
    }
    if frame_fits(layout) { return emit_epilogue_small(layout) }
    emit_epilogue_big(layout)
}
