/**
 * ex_encodes_the_unary_ops — `neg r/m64` (`F7 /3`) and `not r/m64` (`F7 /2`),
 * plus the 32-bit `neg` form.
 *
 * @return void
 */
fn ex_encodes_the_unary_ops() {
    ex_assert_hex(neg_x86(ex_p(0), true), "48f7d8")
    ex_assert_hex(not_x86(ex_p(0), true), "48f7d0")
    ex_assert_hex(neg_x86(ex_p(0), false), "f7d8")
}

#test

/**
 * ex_encodes_every_load_addressing_form — the SIB-forcing RSP base, a zero
 * displacement, disp8/disp32 (positive and negative), a plain base, the
 * disp-forcing RBP base, and the REX.B R12/R13 bases.
 *
 * @return void
 */
fn ex_encodes_every_load_addressing_form() {
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "488b442408")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 0 to i32)), "488b0424")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 512 to i32)), "488b842400020000")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), (0 to i32) - (8 to i32))), "488b4424f8")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(3), 0 to i32)), "488b03")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(5), 0 to i32)), "488b4500")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(12), 0 to i32)), "498b0424")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(13), 0 to i32)), "498b4500")
}

#test

/**
 * ex_encodes_every_load_width_and_sign — Q/D/W/B loads in their zero-extending
 * size ladder (byte `movzx 0F B6`, word `movzx 0F B7`, dword `mov 8B`, qword
 * `REX.W 8B`) and their sign-extending `movsxd`(D) / `movsx`(W/B) forms,
 * covering `load_memop_x86` — the isel's `sign=false` zero-extend contract.
 *
 * @return void
 */
fn ex_encodes_every_load_width_and_sign() {
    ex_assert_hex(load_x86(MMemSizeX86::D, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "8b442408")
    ex_assert_hex(load_x86(MMemSizeX86::D, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "4863442408")
    ex_assert_hex(load_x86(MMemSizeX86::W, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "0fb7442408")
    ex_assert_hex(load_x86(MMemSizeX86::W, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "480fbf442408")
    ex_assert_hex(load_x86(MMemSizeX86::B, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "0fb6442408")
    ex_assert_hex(load_x86(MMemSizeX86::B, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "480fbe442408")
}

#test

/**
 * ex_encodes_every_store_width — Q/D/W (the `0x66`-prefixed word) and the byte
 * store (a low `al` source, then a forced-REX `sil` source), covering
 * `store_memop_x86` and the byte-register REX trap.
 *
 * @return void
 */
fn ex_encodes_every_store_width() {
    ex_assert_hex(store_x86(MMemSizeX86::Q, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "4889442408")
    ex_assert_hex(store_x86(MMemSizeX86::D, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "89442408")
    ex_assert_hex(store_x86(MMemSizeX86::W, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "6689442408")
    ex_assert_hex(store_x86(MMemSizeX86::B, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "88442408")
    ex_assert_hex(store_x86(MMemSizeX86::B, ex_p(6), ex_mem(ex_p(4), 8 to i32)), "4088742408")
}

#test

/**
 * ex_encodes_indirect_calls_and_return — `call r/m64` (`FF /2`) across a low
 * and a high register, and the bare `ret`.
 *
 * @return void
 */
fn ex_encodes_indirect_calls_and_return() {
    ex_assert_hex(call_ind_x86(ex_p(0), teko::list::empty(), ex_p(0), false), "ffd0")
    ex_assert_hex(call_ind_x86(ex_p(11), teko::list::empty(), ex_p(0), false), "41ffd3")
    ex_assert_hex(ret_x86(), "c3")
}

#test

/**
 * ex_encodes_the_direct_call_reloc — `call rel32` (`E8`) is a zeroed
 * placeholder carrying a `Plt32` relocation on the callee symbol at rel32
 * offset 1.
 *
 * @return void
 */
fn ex_encodes_the_direct_call_reloc() {
    let enc = ex_enc(call_x86("tk_exit", teko::list::empty(), ex_p(0), false, false))
    teko::assert::is_true(teko::crypto::to_hex(enc.bytes) == "e800000000")
    teko::assert::is_true(enc.reloc != null)
    let r = ex_reloc_of(enc)
    teko::assert::is_true(r.field_off == (1 to u32))
    teko::assert::is_true(r.sym == "tk_exit")
    ex_assert_reloc_is_plt32(r.kind)
    teko::assert::is_false(enc.has_branch)
}

#test

/**
 * ex_encodes_the_rip_relative_lea_reloc — `lea dst, [rip+disp32]` (`REX.W 8D`,
 * `mod=00 rm=101`) is a zeroed-disp placeholder carrying the instruction's
 * relocation kind at disp32 offset 3; a high register sets REX.R.
 *
 * @return void
 */
fn ex_encodes_the_rip_relative_lea_reloc() {
    let enc = ex_enc(lea_rip_x86(ex_p(0), "g", RelocKindX86::Pc32))
    teko::assert::is_true(teko::crypto::to_hex(enc.bytes) == "488d0500000000")
    teko::assert::is_true(enc.reloc != null)
    let r = ex_reloc_of(enc)
    teko::assert::is_true(r.field_off == (3 to u32))
    teko::assert::is_true(r.sym == "g")
    ex_assert_reloc_is_pc32(r.kind)
    ex_assert_hex(lea_rip_x86(ex_p(10), "g", RelocKindX86::Pc32), "4c8d1500000000")
}

#test

/**
 * ex_a_non_relocating_instruction_owes_no_relocation_kind — the x86-64 twin of
 * the arm64 regression that kills the inert relocation default: an instruction
 * that references no symbol carries `reloc == null`, never a defaulted
 * `RelocKindX86`. `plain_inst_x86` used to fill `reloc_kind =
 * RelocKindX86::Plt32` — a CALL relocation — on every position-independent
 * instruction, inert only because a separate `has_reloc` flag sat beside it.
 * There is now nothing to default: a mov, a cmp, a ret and an intra-function
 * `jmp` all owe `null`, and only `call rel32` and `lea rip`-relative owe a
 * record at all (asserted by the two goldens above).
 *
 * @return void
 */
fn ex_a_non_relocating_instruction_owes_no_relocation_kind() {
    teko::assert::is_true(ex_enc(mov_x86(ex_p(0), ex_p(1), true)).reloc == null)
    teko::assert::is_true(ex_enc(cmp_x86(ex_p(0), ex_p(1), true)).reloc == null)
    teko::assert::is_true(ex_enc(ret_x86()).reloc == null)
    teko::assert::is_true(ex_enc(jmp_x86(0 to u32)).reloc == null)
}

#test

/**
 * ex_encodes_the_scalar_float_memory_moves — the SSE scalar float load/store
 * widths (`B1-fp`): `MOVSD` is `F2 0F 10`(load)/`F2 0F 11`(store), `MOVSS` the
 * `F3`-prefixed twin, with the mandatory prefix ahead of any REX (an XMM8..15
 * operand sets REX.R) and the same SIB/disp8 addressing the integer forms use
 * (RSP forces the SIB byte `0x24`, RBP forces a zero disp8). Every vector below
 * was cross-checked against GNU `as`.
 *
 * @return void
 */
fn ex_encodes_the_scalar_float_memory_moves() {
    ex_assert_hex(load_x86(MMemSizeX86::F64, false, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f20f100424")
    ex_assert_hex(load_x86(MMemSizeX86::F32, false, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f30f100424")
    ex_assert_hex(store_x86(MMemSizeX86::F64, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f20f110424")
    ex_assert_hex(store_x86(MMemSizeX86::F32, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f30f110424")
    ex_assert_hex(load_x86(MMemSizeX86::F64, false, ex_fpr(10), ex_mem(ex_p(5), 0 to i32)), "f2440f105500")
    ex_assert_hex(store_x86(MMemSizeX86::F64, ex_fpr(10), ex_mem(ex_p(5), 0 to i32)), "f2440f115500")
}

#test

/**
 * ex_encodes_the_float_register_moves — `MFMovX86`'s three shapes (`B1-fp`):
 * FPR-to-FPR is `MOVSD`/`MOVSS` (`F2`/`F3 0F 10`, ModRM.reg is the
 * destination); GPR-to-FPR is `MOVQ`/`MOVD` (`66 [REX.W] 0F 6E`); FPR-to-GPR is
 * the opposite-direction `66 [REX.W] 0F 7E`, whose ModRM.reg field holds the XMM
 * SOURCE. Every vector below was cross-checked against GNU `as`.
 *
 * @return void
 */
fn ex_encodes_the_float_register_moves() {
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_fpr(1), true), "f20f10c1")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_fpr(1), false), "f30f10c1")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_fpr(11), true), "f2450f10d3")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_fpr(11), false), "f3450f10d3")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_p(0), true), "66480f6ec0")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_p(0), false), "660f6ec0")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_p(11), true), "664d0f6ed3")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_p(11), false), "66450f6ed3")
    ex_assert_hex(fmov_x86(ex_p(0), ex_fpr(0), true), "66480f7ec0")
    ex_assert_hex(fmov_x86(ex_p(0), ex_fpr(0), false), "660f7ec0")
    ex_assert_hex(fmov_x86(ex_p(11), ex_fpr(10), true), "664d0f7ed3")
    ex_assert_hex(fmov_x86(ex_p(11), ex_fpr(10), false), "66450f7ed3")
}

#test

/**
 * ex_encodes_the_float_alu_family — every `MFAluOpX86` in both widths
 * (`B1-fp`): `ADDSD`/`SUBSD`/`MULSD`/`DIVSD` are `F2 0F 58`/`5C`/`59`/`5E`, and
 * the `SS` twins swap the mandatory prefix to `F3`; the read-modify-write
 * destination rides ModRM.reg. Every vector below was cross-checked against GNU
 * `as`.
 *
 * @return void
 */
fn ex_encodes_the_float_alu_family() {
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(0), ex_fpr(1), true), "f20f58c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FSub, ex_fpr(0), ex_fpr(1), true), "f20f5cc1")
    ex_assert_hex(falu_x86(MFAluOpX86::FMul, ex_fpr(0), ex_fpr(1), true), "f20f59c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(0), ex_fpr(1), true), "f20f5ec1")
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(0), ex_fpr(1), false), "f30f58c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FSub, ex_fpr(0), ex_fpr(1), false), "f30f5cc1")
    ex_assert_hex(falu_x86(MFAluOpX86::FMul, ex_fpr(0), ex_fpr(1), false), "f30f59c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(0), ex_fpr(1), false), "f30f5ec1")
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(10), ex_fpr(11), true), "f2450f58d3")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(10), ex_fpr(11), false), "f3450f5ed3")
}

#test

/**
 * ex_encodes_the_float_compare_and_parity — `UCOMISD` is `66 0F 2E` and
 * `UCOMISS` the UNPREFIXED `0F 2E` (the one form in this family carrying no
 * mandatory prefix), its first operand on ModRM.reg; `MSetPX86` is `setp`/
 * `setnp` (`0F 9A`/`9B`) plus the `movzx dst32, dst8` widening every `setcc`
 * here carries, with a forced REX for a byte register at id >= 4. Every vector
 * below was cross-checked against GNU `as`.
 *
 * @return void
 */
fn ex_encodes_the_float_compare_and_parity() {
    ex_assert_hex(fcmp_x86(ex_fpr(0), ex_fpr(1), true), "660f2ec1")
    ex_assert_hex(fcmp_x86(ex_fpr(0), ex_fpr(1), false), "0f2ec1")
    ex_assert_hex(fcmp_x86(ex_fpr(10), ex_fpr(11), true), "66450f2ed3")
    ex_assert_hex(setp_x86(ex_p(0), false), "0f9ac00fb6c0")
    ex_assert_hex(setp_x86(ex_p(0), true), "0f9bc00fb6c0")
    ex_assert_hex(setp_x86(ex_p(6), false), "400f9ac6400fb6f6")
    ex_assert_hex(setp_x86(ex_p(6), true), "400f9bc6400fb6f6")
}

#test

/**
 * ex_encodes_the_float_conversions — every `MCvtOpX86` (`B1-fp`): `CVTSI2SD` is
 * `F2 REX.W 0F 2A` (its GPR side always the wide form), `CVTTSD2SI` is
 * `F2 REX.W 0F 2C` with the GPR destination on ModRM.reg, `CVTSD2SS` is
 * `F2 0F 5A` and `CVTSS2SD` is `F3 0F 5A` (both FPR-only, so neither sets
 * REX.W). Every vector below was cross-checked against GNU `as`.
 *
 * @return void
 */
fn ex_encodes_the_float_conversions() {
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsi2sd, ex_fpr(0), ex_p(0)), "f2480f2ac0")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvttsd2si, ex_p(0), ex_fpr(0)), "f2480f2cc0")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsd2ss, ex_fpr(0), ex_fpr(1)), "f20f5ac1")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtss2sd, ex_fpr(0), ex_fpr(1)), "f30f5ac1")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsi2sd, ex_fpr(10), ex_p(11)), "f24d0f2ad3")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvttsd2si, ex_p(11), ex_fpr(10)), "f24d0f2cda")
}

/**
 * fx_u1 — a one-element `[]u32` (the callee-saved / slot-offset fixture builder).
 *
 * @param u32 a  the sole element
 * @return []u32  the singleton list
 */
fn fx_u1(a: u32) -> []u32 {
    teko::list::push(teko::list::empty(), a)
}

/**
 * fx_u2 — a two-element `[]u32`.
 *
 * @param u32 a  the first element
 * @param u32 b  the second element
 * @return []u32  the two-element list
 */
fn fx_u2(a: u32, b: u32) -> []u32 {
    teko::list::push(fx_u1(a), b)
}

/**
 * fx_u3 — a three-element `[]u32`.
 *
 * @param u32 a  the first element
 * @param u32 b  the second element
 * @param u32 c  the third element
 * @return []u32  the three-element list
 */
fn fx_u3(a: u32, b: u32, c: u32) -> []u32 {
    teko::list::push(fx_u2(a, b), c)
}

/**
 * fx_none_u32 — the empty `[]u32` (the no-callee-saved / no-slots fixture).
 *
 * @return []u32  the empty list
 */
fn fx_none_u32() -> []u32 {
    teko::list::empty()
}
