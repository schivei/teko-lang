#test
fn ex_encodes_every_load_addressing_form() {
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "488b442408")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 0 to i32)), "488b0424")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), 512 to i32)), "488b842400020000")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(4), (0 to i32) - (8 to i32))), "488b4424f8")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(3), 0 to i32)), "488b03")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(5), 0 to i32)), "488b4500")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(12), 0 to i32)), "498b0424")
    ex_assert_hex(load_x86(MMemSizeX86::Q, false, ex_p(0), ex_mem(ex_p(13), 0 to i32)), "498b4500")
}

#test
fn ex_encodes_every_load_width_and_sign() {
    ex_assert_hex(load_x86(MMemSizeX86::D, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "8b442408")
    ex_assert_hex(load_x86(MMemSizeX86::D, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "4863442408")
    ex_assert_hex(load_x86(MMemSizeX86::W, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "0fb7442408")
    ex_assert_hex(load_x86(MMemSizeX86::W, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "480fbf442408")
    ex_assert_hex(load_x86(MMemSizeX86::B, false, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "0fb6442408")
    ex_assert_hex(load_x86(MMemSizeX86::B, true, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "480fbe442408")
}

#test
fn ex_encodes_every_store_width() {
    ex_assert_hex(store_x86(MMemSizeX86::Q, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "4889442408")
    ex_assert_hex(store_x86(MMemSizeX86::D, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "89442408")
    ex_assert_hex(store_x86(MMemSizeX86::W, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "6689442408")
    ex_assert_hex(store_x86(MMemSizeX86::B, ex_p(0), ex_mem(ex_p(4), 8 to i32)), "88442408")
    ex_assert_hex(store_x86(MMemSizeX86::B, ex_p(6), ex_mem(ex_p(4), 8 to i32)), "4088742408")
}

#test
fn ex_encodes_indirect_calls_and_return() {
    ex_assert_hex(call_ind_x86(ex_p(0), [], ex_p(0), false), "ffd0")
    ex_assert_hex(call_ind_x86(ex_p(11), [], ex_p(0), false), "41ffd3")
    ex_assert_hex(ret_x86(), "c3")
}

#test
fn ex_encodes_the_direct_call_reloc() {
    var enc = ex_enc(call_x86("tk_exit", [], ex_p(0), false, false))
    teko::assert::is_true(teko::crypto::to_hex(enc.bytes) == "e800000000")
    teko::assert::is_true(enc.reloc != null)
    var r = ex_reloc_of(enc)
    teko::assert::is_true(r.field_off == (1 to u32))
    teko::assert::is_true(r.sym == "tk_exit")
    ex_assert_reloc_is_plt32(r.kind)
    teko::assert::is_false(enc.has_branch)
}

#test
fn ex_encodes_the_rip_relative_lea_reloc() {
    var enc = ex_enc(lea_rip_x86(ex_p(0), "g", RelocKindX86::Pc32))
    teko::assert::is_true(teko::crypto::to_hex(enc.bytes) == "488d0500000000")
    teko::assert::is_true(enc.reloc != null)
    var r = ex_reloc_of(enc)
    teko::assert::is_true(r.field_off == (3 to u32))
    teko::assert::is_true(r.sym == "g")
    ex_assert_reloc_is_pc32(r.kind)
    ex_assert_hex(lea_rip_x86(ex_p(10), "g", RelocKindX86::Pc32), "4c8d1500000000")
}

#test
fn ex_a_non_relocating_instruction_owes_no_relocation_kind() {
    teko::assert::is_true(ex_enc(mov_x86(ex_p(0), ex_p(1), true)).reloc == null)
    teko::assert::is_true(ex_enc(cmp_x86(ex_p(0), ex_p(1), true)).reloc == null)
    teko::assert::is_true(ex_enc(ret_x86()).reloc == null)
    teko::assert::is_true(ex_enc(jmp_x86(0 to u32)).reloc == null)
}

#test
fn ex_encodes_the_scalar_float_memory_moves() {
    ex_assert_hex(load_x86(MMemSizeX86::F64, false, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f20f100424")
    ex_assert_hex(load_x86(MMemSizeX86::F32, false, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f30f100424")
    ex_assert_hex(store_x86(MMemSizeX86::F64, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f20f110424")
    ex_assert_hex(store_x86(MMemSizeX86::F32, ex_fpr(0), ex_mem(ex_p(4), 0 to i32)), "f30f110424")
    ex_assert_hex(load_x86(MMemSizeX86::F64, false, ex_fpr(10), ex_mem(ex_p(5), 0 to i32)), "f2440f105500")
    ex_assert_hex(store_x86(MMemSizeX86::F64, ex_fpr(10), ex_mem(ex_p(5), 0 to i32)), "f2440f115500")
}

#test
fn ex_encodes_the_float_register_moves() {
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_fpr(1), true), "f20f10c1")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_fpr(1), false), "f30f10c1")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_fpr(11), true), "f2450f10d3")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_fpr(11), false), "f3450f10d3")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_p(0), true), "66480f6ec0")
    ex_assert_hex(fmov_x86(ex_fpr(0), ex_p(0), false), "660f6ec0")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_p(11), true), "664d0f6ed3")
    ex_assert_hex(fmov_x86(ex_fpr(10), ex_p(11), false), "66450f6ed3")
    ex_assert_hex(fmov_x86(ex_p(0), ex_fpr(0), true), "66480f7ec0")
    ex_assert_hex(fmov_x86(ex_p(0), ex_fpr(0), false), "660f7ec0")
    ex_assert_hex(fmov_x86(ex_p(11), ex_fpr(10), true), "664d0f7ed3")
    ex_assert_hex(fmov_x86(ex_p(11), ex_fpr(10), false), "66450f7ed3")
}

#test
fn ex_encodes_the_float_alu_family() {
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(0), ex_fpr(1), true), "f20f58c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FSub, ex_fpr(0), ex_fpr(1), true), "f20f5cc1")
    ex_assert_hex(falu_x86(MFAluOpX86::FMul, ex_fpr(0), ex_fpr(1), true), "f20f59c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(0), ex_fpr(1), true), "f20f5ec1")
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(0), ex_fpr(1), false), "f30f58c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FSub, ex_fpr(0), ex_fpr(1), false), "f30f5cc1")
    ex_assert_hex(falu_x86(MFAluOpX86::FMul, ex_fpr(0), ex_fpr(1), false), "f30f59c1")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(0), ex_fpr(1), false), "f30f5ec1")
    ex_assert_hex(falu_x86(MFAluOpX86::FAdd, ex_fpr(10), ex_fpr(11), true), "f2450f58d3")
    ex_assert_hex(falu_x86(MFAluOpX86::FDiv, ex_fpr(10), ex_fpr(11), false), "f3450f5ed3")
}

#test
fn ex_encodes_the_float_compare_and_parity() {
    ex_assert_hex(fcmp_x86(ex_fpr(0), ex_fpr(1), true), "660f2ec1")
    ex_assert_hex(fcmp_x86(ex_fpr(0), ex_fpr(1), false), "0f2ec1")
    ex_assert_hex(fcmp_x86(ex_fpr(10), ex_fpr(11), true), "66450f2ed3")
    ex_assert_hex(setp_x86(ex_p(0), false), "0f9ac00fb6c0")
    ex_assert_hex(setp_x86(ex_p(0), true), "0f9bc00fb6c0")
    ex_assert_hex(setp_x86(ex_p(6), false), "400f9ac6400fb6f6")
    ex_assert_hex(setp_x86(ex_p(6), true), "400f9bc6400fb6f6")
}

#test
fn ex_encodes_the_float_conversions() {
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsi2sd, ex_fpr(0), ex_p(0)), "f2480f2ac0")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvttsd2si, ex_p(0), ex_fpr(0)), "f2480f2cc0")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsd2ss, ex_fpr(0), ex_fpr(1)), "f20f5ac1")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtss2sd, ex_fpr(0), ex_fpr(1)), "f30f5ac1")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvtsi2sd, ex_fpr(10), ex_p(11)), "f24d0f2ad3")
    ex_assert_hex(cvt_x86(MCvtOpX86::Cvttsd2si, ex_p(11), ex_fpr(10)), "f24d0f2cda")
}

fn fx_u1(a: u32): []u32 {
    [a]
}

fn fx_u2(a: u32, b: u32): []u32 {
    teko::list::push(fx_u1(a), b)
}

fn fx_u3(a: u32, b: u32, c: u32): []u32 {
    teko::list::push(fx_u2(a, b), c)
}

fn fx_none_u32(): []u32 {
    []
}

fn fx_frame(size: u32, saved: []u32, slots: []u32): FrameLayoutX86 {
    FrameLayoutX86 { size = size; saved_gpr = saved; saved_fpr = []; slot_offsets = slots; call_align = false; out_arg_base = 0 to u32; fpr_save_base = 0 to u32; caller_shadow = 0 to u32 }
}

fn fx_prologue_hex(layout: FrameLayoutX86): str {
    match emit_prologue_x86(layout) {
        []byte as b => teko::crypto::to_hex(b)
        error as e => "<err>"
    }
}

fn fx_prologue_stop(layout: FrameLayoutX86): str {
    match emit_prologue_x86(layout) {
        []byte as b => "<ok>"
        error as e => e.message
    }
}

fn fx_epilogue_hex(layout: FrameLayoutX86): str {
    teko::crypto::to_hex(emit_epilogue_x86(layout))
}

#test
fn ex_multi_callee_saved_frame() {
    var fl = fx_frame(8 to u32, fx_u3(3 to u32, 12 to u32, 13 to u32), fx_none_u32())
    teko::assert::is_true(fx_prologue_hex(fl) == "554889e553415441554883ec08")
    teko::assert::is_true(fx_epilogue_hex(fl) == "4883c408415d415c5bc9")
}

#test
fn ex_large_frame_uses_imm32_sub() {
    var fl = fx_frame(512 to u32, fx_none_u32(), fx_u1(0 to u32))
    teko::assert::is_true(fx_prologue_hex(fl) == "554889e54881ec00020000")
    teko::assert::is_true(fx_epilogue_hex(fl) == "c9")
}

fn fx_i1(a: @MInstX86()): []@MInstX86() {
    [a]
}

fn fx_i2(a: @MInstX86(), b: @MInstX86()): []@MInstX86() {
    teko::list::push(fx_i1(a), b)
}

fn fx_block(id: u32, insts: []@MInstX86()): MBlockX86 {
    MBlockX86 { id = id; params = []; insts = insts }
}

fn fx_no_frame(): []lir::LAlloca {
    []
}

fn fx_alloca_frame(bytes: u32, align: u32): []lir::LAlloca {
    [lir::LAlloca { bytes = bytes; align = align }]
}

fn fx_1block_func(sym: str, insts: []@MInstX86(), frame: []lir::LAlloca): MFuncX86 {
    MFuncX86 { symbol = sym; blocks = [fx_block(0 to u32, insts)]; frame = frame }
}

#test
fn ex_func_makes_call_x86_detects_indirect() {
    var ind = call_ind_x86(ex_p(0), [], ex_p(0), false)
    var f = fx_1block_func("main", fx_i1(ind), fx_no_frame())
    teko::assert::is_true(func_makes_call_x86(f))
}

fn fx_xmm_frame(size: u32, saved_fpr: []u32, fpr_save_base: u32): FrameLayoutX86 {
    FrameLayoutX86 { size = size; saved_gpr = fx_none_u32(); saved_fpr = saved_fpr; slot_offsets = fx_none_u32(); call_align = false; out_arg_base = 0 to u32; fpr_save_base = fpr_save_base; caller_shadow = 0 to u32 }
}

#test
fn ex_win64_callee_saved_xmm_rides_movaps() {
    var one = fx_xmm_frame(16 to u32, fx_u1(6 to u32), 0 to u32)
    teko::assert::is_true(fx_prologue_hex(one) == "554889e54883ec100f293424")
    teko::assert::is_true(fx_epilogue_hex(one) == "0f283424c9")
    var two = fx_xmm_frame(48 to u32, fx_u2(6 to u32, 15 to u32), 16 to u32)
    teko::assert::is_true(fx_prologue_hex(two) == "554889e54883ec300f29742410440f297c2420")
    teko::assert::is_true(fx_epilogue_hex(two) == "0f28742410440f287c2420c9")
}

fn fx_func_stop(f: MFuncX86): str {
    match encode_func_x86(SYSV64, f) {
        EncodedFuncX86 as ef => "<ok>"
        error as e => e.message
    }
}

fn fx_encode_func(f: MFuncX86): EncodedFuncX86 {
    match encode_func_x86(SYSV64, f) {
        EncodedFuncX86 as ef => ef
        error as e => EncodedFuncX86 { symbol = "<error>"; bytes = []; relocs = [] }
    }
}

fn fx_reloc_kind_name(kind: RelocKindX86): str {
    match kind { Plt32 => "plt32"; Pc32 => "pc32"; Abs64 => "abs64" }
}

#test
fn ex_func_frameless_call_reloc() {
    var f = fx_1block_func("main", fx_i1(call_x86("tk_exit", [], ex_p(0), false, false)), fx_no_frame())
    var ef = fx_encode_func(f)
    teko::assert::is_true(teko::crypto::to_hex(ef.bytes) == "e800000000")
    teko::assert::is_true(ef.relocs.len == 1)
    teko::assert::is_true(ef.relocs[0].offset == (1 to u32))
    teko::assert::is_true(ef.relocs[0].sym == "tk_exit")
    teko::assert::is_true(fx_reloc_kind_name(ef.relocs[0].kind) == "plt32")
    teko::assert::is_true(ef.relocs[0].addend == ((0) - (4)))
}

#test
fn ex_func_call_then_return_gets_a_minimal_align_only_frame() {
    var f = fx_1block_func("main", fx_i2(call_x86("tk_something", [], ex_p(0), false, false), ret_x86()), fx_no_frame())
    var ef = fx_encode_func(f)
    teko::assert::is_true(teko::crypto::to_hex(ef.bytes) == "554889e5e800000000c9c3")
    teko::assert::is_true(ef.relocs.len == 1)
    teko::assert::is_true(ef.relocs[0].offset == (5 to u32))
    teko::assert::is_true(ef.relocs[0].sym == "tk_something")
}

#test
fn ex_func_call_with_no_return_stays_frameless_even_when_named_differently() {
    var f = fx_1block_func("teko_main", fx_i1(call_x86("tk_exit", [], ex_p(0), false, false)), fx_no_frame())
    var ef = fx_encode_func(f)
    teko::assert::is_true(teko::crypto::to_hex(ef.bytes) == "e800000000")
}

#test
fn ex_func_rip_lea_reloc() {
    var f = fx_1block_func("main", fx_i2(lea_rip_x86(ex_p(0), "gv", RelocKindX86::Pc32), ret_x86()), fx_no_frame())
    var ef = fx_encode_func(f)
    teko::assert::is_true(teko::crypto::to_hex(ef.bytes) == "488d0500000000c3")
    teko::assert::is_true(ef.relocs.len == 1)
    teko::assert::is_true(ef.relocs[0].offset == (3 to u32))
    teko::assert::is_true(ef.relocs[0].sym == "gv")
    teko::assert::is_true(fx_reloc_kind_name(ef.relocs[0].kind) == "pc32")
    teko::assert::is_true(ef.relocs[0].addend == ((0) - (4)))
}

#test
fn ex_func_branch_to_missing_block_honest_stops() {
    var f = fx_1block_func("g", fx_i1(jmp_x86(99 to u32)), fx_no_frame())
    teko::assert::str_contains(fx_func_stop(f), "B1-badblock")
}

#test
fn ex_func_bigframe_propagates() {
    var f = fx_1block_func("g", fx_i1(ret_x86()), fx_alloca_frame(2147483648 to u32, 8 to u32))
    teko::assert::str_contains(fx_func_stop(f), "B1-bigframe")
}

fn fx_patch_stop(raw: []byte, fixups: []BranchFixupX86, offsets: []BlockOffsetX86): str {
    match patch_branches_x86(raw, fixups, offsets) {
        []byte as b => "<ok>"
        error as e => e.message
    }
}

#test
fn ex_patch_far_displacement_honest_stops() {
    var raw = [0 to byte, 0 to byte, 0 to byte, 0 to byte]
    var fixups = [BranchFixupX86 { field_off = 0 to u32; target = 0 to u32 }]
    var offsets = [BlockOffsetX86 { id = 0 to u32; byte = 2147483652 to u32 }]
    teko::assert::str_contains(fx_patch_stop(raw, fixups, offsets), "B1-farbranch")
}

#test
fn ex_reloc_addend_convention() {
    teko::assert::is_true(reloc_addend_x86(RelocKindX86::Plt32) == ((0) - (4)))
    teko::assert::is_true(reloc_addend_x86(RelocKindX86::Pc32) == ((0) - (4)))
    teko::assert::is_true(reloc_addend_x86(RelocKindX86::Abs64) == (0))
}

fn fx_module_of1(f: MFuncX86): MModuleX86 {
    MModuleX86 { funcs = [f]; rodata = []; globals = []; layouts = [] }
}

fn fx_module_stop(m: MModuleX86): str {
    match encode_module_x86(SYSV64, m) {
        EncodedModuleX86 as e => "<ok>"
        error as er => er.message
    }
}

#test
fn ex_module_globals_honest_stops() {
    var f = fx_1block_func("main", fx_i1(ret_x86()), fx_no_frame())
    var globals = [lir::LGlobal { symbol = "gv"; ty = lir::LType::I32; bytes = [] }]
    var m = MModuleX86 { funcs = [f]; rodata = []; globals = globals; layouts = [] }
    teko::assert::str_contains(fx_module_stop(m), "B1-globals")
}

#test
fn ex_module_propagates_function_stop() {
    var f = fx_1block_func("main", fx_i1(ret_x86()), fx_alloca_frame(0xFFFFFF00 to u32, 8 to u32))
    teko::assert::str_contains(fx_module_stop(fx_module_of1(f)), "B1-bigframe")
}

fn fx_in_arg_hex(abi: AbiDescriptor): str {
    var f = fx_1block_func("main", fx_i2(in_arg_x86(MMemSizeX86::Q, ex_p(0), 0 to u32), ret_x86()), fx_no_frame())
    match encode_func_x86(abi, f) {
        EncodedFuncX86 as ef => teko::crypto::to_hex(ef.bytes)
        error as e => "<err>"
    }
}

#test
fn ex_win64_incoming_stack_arg_skips_the_callers_shadow() {
    teko::assert::is_true(fx_in_arg_hex(SYSV64) == "488b442408c3")
    teko::assert::is_true(fx_in_arg_hex(WIN64) == "488b442428c3")
}

#test
fn ex_frame_layout_carries_the_callers_shadow_unconditionally() {
    var leaf = fx_1block_func("main", fx_i1(ret_x86()), fx_no_frame())
    teko::assert::is_true(compute_frame_layout_x86(WIN64, leaf).out_arg_base == (0 to u32))
    teko::assert::is_true(compute_frame_layout_x86(WIN64, leaf).caller_shadow == (32 to u32))
    teko::assert::is_true(compute_frame_layout_x86(SYSV64, leaf).caller_shadow == (0 to u32))
}
