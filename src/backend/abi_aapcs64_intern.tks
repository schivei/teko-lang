
/**
 * push_range — append the inclusive integer range `[lo, hi]` to `xs`, one
 * id at a time in ascending order. A runtime helper the regalloc/ABI test
 * fixtures assemble small custom register-id lists from, so a contiguous run
 * of ids never needs typing out by hand (and so cannot be mistyped). The
 * shipped descriptors (`AAPCS64`/`SYSV64`/`WIN64`) are now
 * rodata consts with explicit array literals (#594 T-B6), not built through
 * this helper.
 *
 * @param []u32 xs  the array to extend
 * @param u32 lo  the first id to append (inclusive)
 * @param u32 hi  the last id to append (inclusive)
 * @return []u32  `xs` followed by `lo, lo+1, ..., hi`
 */
fn push_range(xs: []u32, lo: u32, hi: u32) -> []u32 {
    mut result = xs
    mut i = lo
    loop {
        if i > hi { break }
        result = teko::list::push(result, i)
        i++
    }
    result
}

/**
 * contains_u32 — whether `target` occurs anywhere in `xs`, a linear
 * membership scan over the small (at most 32-entry) register-id lists the
 * descriptor stores.
 *
 * @param []u32 xs  the array to search
 * @param u32 target  the id to look for
 * @return bool  true iff `target` is one of `xs`'s elements
 */
fn contains_u32(xs: []u32, target: u32) -> bool {
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == target { return true }
        i++
    }
    false
}
