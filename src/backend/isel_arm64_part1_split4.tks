/**
 * select_itof — the `IToF` selection: one `SCVTF` (signed source — `LUnOp`
 * declares no unsigned `IToF` variant, so signed is the total, documented
 * default) reading the WIDE `X` integer form and producing the WIDE `D` float.
 *
 * Both widths are exact rather than defaults, and they are the x86 twin's
 * (`select_itof_x86`, whose `CVTSI2SD` also pins `REX.W` + double): the integer
 * carrier of every LIR value is `i64`, and an `int to f32` cast is decomposed by
 * the lowering into this `IToF` followed by an `FToF` narrowing
 * (`lower.tks`'s `int_to_narrow_float_cast`), so `IToF` alone never has to
 * produce a single.
 *
 * @param SelCtx ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param u32 a  the GPR operand VReg
 * @return SelCtx  the advanced context
 */
fn select_itof(ctx0: SelCtx, inst: lir::LInst, a: u32) -> SelCtx {
    let dst = vreg(inst.result, MRegClass::FPR)
    let ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, true)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Scvtf, dst, vreg(a, MRegClass::GPR), true, true))
}

/**
 * select_ftoi — the `FToI` selection: one `FCVTZS` (signed destination,
 * mirroring `select_itof`'s default) into the wide `X` integer form, reading the
 * source at the OPERAND's own recorded float width.
 *
 * The source width is the load-bearing half: reading an `f32` value with the `D`
 * template decodes its 32 live bits as the low half of a double and truncates to
 * nonsense. Its x86 twin makes the same choice by picking between
 * `CVTTSD2SI`/`CVTTSS2SI` from the same recorded width.
 *
 * @param SelCtx ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param u32 a  the FPR operand VReg
 * @param bool a_wide  the operand's own recorded float width (true f64, false f32)
 * @return SelCtx  the advanced context
 */
fn select_ftoi(ctx0: SelCtx, inst: lir::LInst, a: u32, a_wide: bool) -> SelCtx {
    let dst = vreg(inst.result, MRegClass::GPR)
    let ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::GPR, true)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Fcvtzs, dst, vreg(a, MRegClass::FPR), a_wide, true))
}

/**
 * select_ftof — the `FToF` selection: one `FCVT`, its DIRECTION taken from the
 * operand's own recorded width (`a_wide` narrows f64->f32, `!a_wide` widens
 * f32->f64). Sound because the lowering never emits an identity `FToF`
 * (`is_same_width_float_cast` returns the operand unchanged instead), so the two
 * widths always differ and "not the operand's width" names exactly one target —
 * the same argument `select_ftof_x86` runs on its own two mnemonics.
 *
 * @param SelCtx ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param u32 a  the FPR operand VReg
 * @param bool a_wide  the operand's own recorded width (true f64, false f32)
 * @return SelCtx  the advanced context
 */
fn select_ftof(ctx0: SelCtx, inst: lir::LInst, a: u32, a_wide: bool) -> SelCtx {
    let dst_wide = !a_wide
    let dst = vreg(inst.result, MRegClass::FPR)
    let ctx1 = selctx_set_vinfo(ctx0, inst.result, MRegClass::FPR, dst_wide)
    selctx_emit(ctx1, cvt_inst(MCvtOp::Fcvt, dst, vreg(a, MRegClass::FPR), a_wide, dst_wide))
}

/**
 * select_un — the `LUn` dispatch: one selection per `LUnOp` case (§3.1 of
 * the isel plan).
 *
 * @param SelCtx ctx0  the context to extend
 * @param lir::LInst inst  the enclosing instruction (its result VReg)
 * @param lir::LUn u  the unary op
 * @return SelCtx  the advanced context
 */
