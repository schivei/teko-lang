/**
 * xat_win64_tk_str_eq_passes_both_pairs_by_reference — the golden for the shape the
 * Windows leg faulted on with ACCESS_VIOLATION: each pair gets its OWN 16-byte
 * frame copy (`.ptr` at +0, `.len` at +8, from that pair's own two VRegs), and the
 * two ADDRESSES — not the four halves — travel in RCX and RDX.
 *
 * The `is_false` is the load-bearing half: `%p8` (R8) appearing would mean a third
 * register was pinned, which is exactly the flat four-operand form the callee reads
 * as two pointers.
 *
 * @return void
 */
fn xat_win64_tk_str_eq_passes_both_pairs_by_reference() {
    let text = xat_dump_abi(WIN64, xat_two_str_pairs_call("tk_str_eq"))
    teko::assert::str_contains(text, "[frame #0]")
    teko::assert::str_contains(text, "[frame #1]")
    teko::assert::str_contains(text, "+ 0], %0")
    teko::assert::str_contains(text, "+ 8], %1")
    teko::assert::str_contains(text, "+ 0], %2")
    teko::assert::str_contains(text, "+ 8], %3")
    teko::assert::str_contains(text, "call @tk_str_eq(%p1, %p2)")
    teko::assert::is_false(teko::runtime::str_contains(text, "%p8"))
}

#test

/**
 * xat_win64_two_pairs_reserve_two_16_byte_frame_slots — two by-value `tk_str`
 * arguments cost two 16-byte, 8-aligned frame slots, not one shared copy.
 *
 * @return void
 */
fn xat_win64_two_pairs_reserve_two_16_byte_frame_slots() {
    let mf = match select_lfunc_x86(WIN64, xat_two_str_pairs_call("tk_str_eq")) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 2)
    teko::assert::is_true(mf.frame[0].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[0].align == (8 to u32))
    teko::assert::is_true(mf.frame[1].bytes == (16 to u32))
    teko::assert::is_true(mf.frame[1].align == (8 to u32))
}

/**
 * xat_two_pair_entries — every runtime entry whose FIRST TWO parameters are
 * by-value `tk_str` and whose argument list is exactly those two pairs
 * (`teko_rt.h`: `tk_str_eq`, `tk_str_ends_with`, `tk_str_contains`).
 * `tk_rt_last_index_of_ok` is the fourth member of the family and is covered
 * separately because it carries a trailing out-parameter.
 *
 * ENUMERATED, NOT SAMPLED: the defect this pins was a fix that covered the
 * one-`tk_str` family and left the two-`tk_str` one emitting SysV's form on Win64,
 * so a golden for whichever entry a fixture happens to touch would repeat the
 * mistake at the next entry.
 *
 * @return []str  the three symbols, in `teko_rt.h` declaration order
 */
fn xat_two_pair_entries() -> []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_eq"), "tk_str_ends_with"), "tk_str_contains")
}

#test

/**
 * xat_win64_every_two_pair_entry_travels_by_reference — the family sweep: EVERY
 * entry of `xat_two_pair_entries` emits two frame copies and a call using exactly
 * RCX and RDX under WIN64, and the SysV four-register form under SYSV64.
 *
 * @return void
 */
fn xat_win64_every_two_pair_entry_travels_by_reference() {
    let entries = xat_two_pair_entries()
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let sym = entries[i]
        let win = xat_dump_abi(WIN64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(win, "[frame #1]")
        teko::assert::str_contains(win, teko::str::concat("call @", sym, "(%p1, %p2)"))
        let sysv = xat_dump_abi(SYSV64, xat_two_str_pairs_call(sym))
        teko::assert::str_contains(sysv, teko::str::concat("call @", sym, "(%p7, %p6, %p2, %p1)"))
        teko::assert::is_false(teko::runtime::str_contains(sysv, "[frame #"))
        i++
    }
}

#test

/**
 * xat_win64_last_index_of_out_slot_follows_the_two_references — the fourth family
 * member: `tk_rt_last_index_of_ok`'s two references take RCX/RDX and its
 * `uint64_t *out_index` takes the NEXT register (R8), never RCX — the numbering
 * that a per-pair-agnostic pinning would have got wrong.
 *
 * @return void
 */
fn xat_win64_last_index_of_out_slot_follows_the_two_references() {
    let text = xat_dump_abi(WIN64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p1, %p2, %p8)")
}

#test

/**
 * xat_sysv_last_index_of_stays_in_five_registers — the byte-identity guardrail for
 * the trailing-scalar member: SysV pins all five operands as ordinary register
 * arguments and reserves no pair copy (its only frame slot is the `LAlloca`'s own).
 *
 * @return void
 */
fn xat_sysv_last_index_of_stays_in_five_registers() {
    let text = xat_dump_abi(SYSV64, xat_last_index_of_call())
    teko::assert::str_contains(text, "call @tk_rt_last_index_of_ok(%p7, %p6, %p2, %p1, %p8)")
    let mf = match select_lfunc_x86(SYSV64, xat_last_index_of_call()) { MFuncX86 as x => x; error => return }
    teko::assert::is_true(mf.frame.len == 1)
    teko::assert::is_true(mf.frame[0].bytes == (8 to u32))
}

#test

/**
 * xat_win64_runtime_flattened_entries_stay_in_registers — the entries the RUNTIME
 * itself declares flattened (`tk_str_concat_len`, `tk_str_slice_len`,
 * `tk_str_of_bytes_len`, `tk_slice_str_eq` — each taking `const tk_byte *ptr,
 * uint64_t len, …`) take no by-value aggregate at all, so the flat pair IS their C
 * ABI on Win64 too and NOTHING may be materialized for them.
 *
 * @return void
 */
fn xat_win64_runtime_flattened_entries_stay_in_registers() {
    let entries = xat_flattened_entries()
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let text = xat_dump_abi(WIN64, xat_two_str_pairs_call(entries[i]))
        teko::assert::str_contains(text, teko::str::concat("call @", entries[i], "(%p1, %p2, %p8, %p9)"))
        teko::assert::is_false(teko::runtime::str_contains(text, "[frame #"))
        i++
    }
}

/**
 * xat_flattened_entries — the runtime entries whose `tk_str` arguments were
 * flattened IN THE RUNTIME's own signature on purpose, and which must therefore
 * keep the plain register form on every ABI.
 *
 * @return []str  the four flattened symbols the native LIR calls
 */
fn xat_flattened_entries() -> []str {
    teko::list::push(teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), "tk_str_concat_len"), "tk_str_slice_len"), "tk_str_of_bytes_len"), "tk_slice_str_eq")
}

/**
 * xat_no_arg_reg_by_ref_abi — a degenerate register file with NO integer
 * argument register and Win64's by-reference aggregate rule, the only input that
 * reaches `pin_fat_slot_addrs_x86`'s "no argument register" internal arm (every
 * shipped x86-64 descriptor has at least four).
 *
 * @return AbiDescriptor  the degenerate register file
 */
fn xat_no_arg_reg_by_ref_abi() -> AbiDescriptor {
    AbiDescriptor {
        gpr_arg = teko::list::empty()
        fpr_arg = teko::list::empty()
        gpr_allocatable = teko::list::push(teko::list::empty(), 3 to u32)
        fpr_allocatable = teko::list::empty()
        gpr_caller_saved = teko::list::empty()
        fpr_caller_saved = teko::list::empty()
        gpr_spill_scratch = teko::list::empty()
        fpr_spill_scratch = teko::list::empty()
        spill_slot_bytes = 8 to u32
        spill_slot_align = 8 to u32
        shadow_space = 32 to u32
        max_reg_arg_bytes = 8 to u32
        arg_slots_shared = true
    }
}

#test

fn xat_by_ref_without_an_argument_register_is_an_internal_stop() {
    match select_lfunc_x86(xat_no_arg_reg_by_ref_abi(), xat_str_pair_call("tk_println")) {
        MFuncX86 => teko::assert::is_true(false)
        error as e => teko::assert::str_contains(e.message, "cannot pass a by-reference aggregate")
    }
}

/**
 * xat_mixed_class_params — a five-parameter `(F64, I64, F64, I64, I64)` function
 * whose entry block reads every parameter through `LParam`, the fixture that tells
 * the two argument-slot rules apart (`B3-argslot`).
 *
 * The shape is chosen so NO position agrees between them: under SysV's per-file
 * counters the parameters land in XMM0/RDI/XMM1/RSI/RDX and none overflows, while
 * under Win64's shared positions they land in XMM0/RDX/XMM2/R9 and the fifth
 * overflows to the stack-argument area. A rule read from the wrong ABI therefore
 * cannot produce this fixture's expected text by accident.
 *
 * @return lir::LFunc  the built function
 */
fn xat_mixed_class_params() -> lir::LFunc {
    let ptypes = xat_mixed_class_types()
    mut f = lir::new_func("teko__demo__mixed", 5, ptypes, lir::LType::I64)
    mut i: u64 = 0
    loop {
        if i >= ptypes.len { break }
        f = lir::append_inst(f, 0, lir::param_inst(i to u32, i to u32, 0, 0))
        i++
    }
    xat_ret(f, 4)
}

/**
 * xat_mixed_class_types — the `(F64, I64, F64, I64, I64)` machine-class list both
 * mixed-class fixtures are built from.
 *
 * @return []lir::LType  the five parameter classes, in declaration order
 */
fn xat_mixed_class_types() -> []lir::LType {
    mut ptypes: []lir::LType = teko::list::empty()
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    ptypes = teko::list::push(ptypes, lir::LType::F64)
    ptypes = teko::list::push(ptypes, lir::LType::I64)
    teko::list::push(ptypes, lir::LType::I64)
}

#test

/**
 * xat_win64_params_number_both_files_by_shared_position — the callee half of
 * `B3-argslot`: Win64 argument position `k` owns the k-th register of WHICHEVER
 * file the parameter belongs to, so `(F64, I64, F64, I64, I64)` arrives in
 * XMM0, RDX, XMM2, R9 and the fifth position — past the four shared slots — in the
 * caller's stack-argument area.
 *
 * The old per-file counting answered XMM0, RCX, XMM1, RDX and put NOTHING on the
 * stack; every one of those five is asserted against here.
 *
 * @return void
 */
fn xat_win64_params_number_both_files_by_shared_position() {
    let text = xat_dump_abi(WIN64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p2")
    teko::assert::str_contains(text, "fmov.d %f2, %pf2")
    teko::assert::str_contains(text, "mov.q %3, %p9")
    teko::assert::str_contains(text, "mov.q %4, [inarg #0]")
}

#test

/**
 * xat_sysv_params_keep_independent_per_file_counting — the byte-identity
 * guardrail for the same fixture: SysV counts each register file on its own, so
 * the two floats take XMM0/XMM1, the three integers take RDI/RSI/RDX and nothing
 * reaches the stack-argument area.
 *
 * @return void
 */
fn xat_sysv_params_keep_independent_per_file_counting() {
    let text = xat_dump_abi(SYSV64, xat_mixed_class_params())
    teko::assert::str_contains(text, "fmov.d %f0, %pf0")
    teko::assert::str_contains(text, "mov.q %1, %p7")
    teko::assert::str_contains(text, "fmov.d %f2, %pf1")
    teko::assert::str_contains(text, "mov.q %3, %p6")
    teko::assert::str_contains(text, "mov.q %4, %p2")
    teko::assert::is_false(teko::runtime::str_contains(text, "[inarg #"))
}

/**
 * xat_mixed_class_call — a `main` that materializes five values of classes
 * `(F64, I64, F64, I64, I64)` and hands them to `teko__demo__mixed` as one
 * result-producing call, then returns the result: the CALLER half of the
 * mixed-class fixture, mirroring `xat_mixed_class_params`'s signature exactly.
 *
 * @return lir::LFunc  the built function
 */
fn xat_mixed_class_call() -> lir::LFunc {
    let f0 = lir::new_func("main", 0, teko::list::empty(), lir::LType::I64)
    let a = xat_fconst(f0, 1)
    let b = xat_const(a.func, 2)
    let c = xat_fconst(b.func, 3)
    let d = xat_const(c.func, 4)
    let e = xat_const(d.func, 5)
    let r = lir::alloc_vreg(e.func)
    mut args: []u32 = teko::list::empty()
    args = teko::list::push(args, a.vreg)
    args = teko::list::push(args, b.vreg)
    args = teko::list::push(args, c.vreg)
    args = teko::list::push(args, d.vreg)
    args = teko::list::push(args, e.vreg)
    let s0 = lir::append_inst(r.func, 0, lir::call_inst(r.vreg, "teko__demo__mixed", args, false, 0, 0))
    xat_ret(s0, r.vreg)
}
