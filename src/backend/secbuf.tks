pub type SectionBuf = class {
    intern wstream: teko::io::FileStream | null
    intern rstream: teko::io::FileStream | null
    intern path: str
    intern total: u64

    pub static fn open(stem: str, tag: str): SectionBuf | error {
        var path = $"{stem}.{tag}.sect"
        var ws = match teko::io::open_write(path) { teko::io::FileStream as fs => fs; error as e => return e }
        SectionBuf { wstream = ws; rstream = null; path = path; total = 0 }
    }

    pub fn append(data: []byte): u64 | error {
        var ws = match self.wstream {
            teko::io::FileStream as fs => fs
            null => panic($"teko::backend::secbuf: append after finish_writing ({self.path})")
        }
        var start = self.total
        var written = match teko::io::stream_write(ws, data) { u64 as n => n; error as e => return e }
        self.total = start + written
        start
    }

    pub fn append_prefix(data: []byte, n: u64): u64 | error {
        var ws = match self.wstream {
            teko::io::FileStream as fs => fs
            null => panic($"teko::backend::secbuf: append_prefix after finish_writing ({self.path})")
        }
        var start = self.total
        var written = match teko::io::stream_write_prefix(ws, data, n) { u64 as w => w; error as e => return e }
        self.total = start + written
        start
    }

    pub fn size(): u64 { self.total }

    pub fn finish_writing(): error | null {
        match self.wstream {
            teko::io::FileStream as ws => {
                match teko::io::stream_close(ws) { error as e => return e; null => { } }
            }
            null => { }
        }
        self.wstream = null
        var rs = match teko::io::open_read(self.path) { teko::io::FileStream as fs => fs; error as e => return e }
        self.rstream = rs
        null
    }

    pub fn copy_range_into(out: teko::io::FileStream, start: u64, end: u64): u64 | error {
        if start > end || end > self.total {
            return error { message = $"teko::backend::secbuf: copy_range_into: range [{start},{end}) exceeds section size {self.total} ({self.path})" }
        }
        var rs = match self.rstream {
            teko::io::FileStream as fs => fs
            null => panic($"teko::backend::secbuf: copy_range_into before finish_writing ({self.path})")
        }
        match teko::io::stream_seek(rs, start to i64, teko::io::Whence::Start) { u64 => { }; error as e => return e }
        var scratch: [teko::io::CHUNK]byte = []
        var pos = start
        loop {
            if pos >= end { break }
            var remain = end - pos
            var want = if remain < teko::io::CHUNK { remain } else { teko::io::CHUNK }
            var view = slice(scratch, 0, want)
            var got = match teko::io::stream_read(rs, view) { u64 as c => c; error as e => return e }
            if got == 0 { return error { message = $"teko::backend::secbuf: copy_range_into: unexpected EOF at {pos} ({self.path})" } }
            match teko::io::stream_write_prefix(out, scratch, got) { u64 => { }; error as e => return e }
            pos = pos + got
        }
        end - start
    }

    pub fn read_range_into(dst: []byte, dst_off: u64, start: u64, len: u64): u64 | error {
        var end = start + len
        if end > self.total {
            return error { message = $"teko::backend::secbuf: read_range_into: range [{start},{end}) exceeds section size {self.total} ({self.path})" }
        }
        var rs = match self.rstream {
            teko::io::FileStream as fs => fs
            null => panic($"teko::backend::secbuf: read_range_into before finish_writing ({self.path})")
        }
        match teko::io::stream_seek(rs, start to i64, teko::io::Whence::Start) { u64 => { }; error as e => return e }
        var pos = start
        loop {
            if pos >= end { break }
            var remain = end - pos
            var want = if remain < teko::io::CHUNK { remain } else { teko::io::CHUNK }
            var view = slice(dst, dst_off + (pos - start), want)
            var got = match teko::io::stream_read(rs, view) { u64 as c => c; error as e => return e }
            if got == 0 { return error { message = $"teko::backend::secbuf: read_range_into: unexpected EOF at {pos} ({self.path})" } }
            pos = pos + got
        }
        len
    }

    pub fn copy_into(out: teko::io::FileStream): u64 | error {
        self.copy_range_into(out, 0, self.total)
    }

    pub fn dispose(): error | null {
        match self.wstream {
            teko::io::FileStream as ws => {
                match teko::io::stream_close(ws) { error as e => return e; null => { } }
            }
            null => { }
        }
        self.wstream = null
        match self.rstream {
            teko::io::FileStream as rs => {
                match teko::io::stream_close(rs) { error as e => return e; null => { } }
            }
            null => { }
        }
        self.rstream = null
        teko::fs::remove_file(self.path)
    }
}

const RODATA_STR_REC: u64 = 16

fn put_u64_le8(buf: ref []byte, off: u64, v: u64) {
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        buf[off + i] = ((v >> (i * 8)) & 255) to byte
        i++
    }
}

fn u64_from_le8(buf: []byte, off: u64): u64 {
    var v: u64 = 0
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        v = v | ((buf[off + i] to u64) << (i * 8))
        i++
    }
    v
}

pub fn rodata_str_symbol(index: u64): str {
    teko::str::concat(".Lstr", teko::u64_to_str(index))
}

pub type RodataSink = class {
    intern bytes: SectionBuf
    intern str_meta: SectionBuf

    pub static fn open(stem: str): RodataSink | error {
        var b = match SectionBuf::open(stem, "rodata") { SectionBuf as s => s; error as e => return e }
        var mm = match SectionBuf::open(stem, "rodata.meta") { SectionBuf as s => s; error as e => return e }
        RodataSink { bytes = b; str_meta = mm }
    }

    pub fn string_count(): u64 { self.str_meta.size() / RODATA_STR_REC }

    pub fn append_image(data: []byte): u64 | error {
        self.bytes.append(data)
    }

    pub fn intern_string(data: []byte): u64 | error {
        var off = match self.bytes.append(data) { u64 as o => o; error as e => return e }
        var rec: [RODATA_STR_REC]byte = []
        put_u64_le8(rec, 0, off)
        put_u64_le8(rec, 8, data.len)
        match self.str_meta.append(rec) { u64 => { }; error as e => return e }
        off
    }

    pub fn read_range_into(dst: []byte, dst_off: u64, start: u64, len: u64): u64 | error {
        self.bytes.read_range_into(dst, dst_off, start, len)
    }

    pub fn finish_writing(): error | null {
        match self.bytes.finish_writing() { error as e => return e; null => { } }
        self.str_meta.finish_writing()
    }

    pub fn finish_strings(): []teko::lir::LRodata | error {
        var n = self.string_count()
        var out: [n]teko::lir::LRodata = []
        var rec: [RODATA_STR_REC]byte = []
        var i: u64 = 0
        loop {
            if i >= n { break }
            match self.str_meta.read_range_into(rec, 0, i * RODATA_STR_REC, RODATA_STR_REC) { u64 => { }; error as e => return e }
            var off = u64_from_le8(rec, 0)
            var len = u64_from_le8(rec, 8)
            out[i] = teko::lir::LRodata { symbol = rodata_str_symbol(i); offset = off; len = len; relocs = [] }
            i++
        }
        out
    }

    pub fn dispose(): error | null {
        match self.bytes.dispose() { error as e => return e; null => { } }
        self.str_meta.dispose()
    }
}
