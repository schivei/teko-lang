/**
 * ptr — an opaque machine pointer: a newtype over the signed arch-word `isize` with no arithmetic
 * operators declared, so pointer math (`p + n`, `p[n]`) does not type-check by construction. It is the
 * address half of the zero-copy marshall surface; the unsigned address word is `uptr`. Reinterpreting
 * an opaque pointer to a value of a same-representation type is the direct same-base conversion.
 */
exp global type ptr = isize { }

/**
 * uptr — an opaque unsigned machine pointer: a newtype over the unsigned arch-word `usize` with no
 * arithmetic operators, the unsigned address word carried in fat pointers and region handles. Its
 * crossing to `usize` is a Marshall bridge (an explicit `to`, never implicit), keeping a measure and an
 * address from silently interchanging.
 */
exp global type uptr = usize { }

/**
 * os — the host operating-system token ("linux", "macos", or "windows"), a compile-time constant
 * fixed to the target the compiler emits for.
 * @return the lowercase OS name.
 */
exp global fn os(): str { os_name() }

#os("linux")
fn os_name(): str { "linux" }

#os("macos")
fn os_name(): str { "macos" }

#os("windows")
fn os_name(): str { "windows" }

/**
 * arch — the host CPU architecture token ("x86_64" or "arm64"), a compile-time constant fixed to the
 * target the compiler emits for.
 * @return the canonical lowercase architecture name.
 */
exp global fn arch(): str { arch_name() }

#arch("x86_64")
fn arch_name(): str { "x86_64" }

#arch("arm64")
fn arch_name(): str { "arm64" }
