// src/regex/regex_test.tkt — tests for teko::regex (ROUND 0 minimal engine).
// Covers: literal match, `.`, `*`/`+`/`?`, character classes, alternation, grouping,
// anchors — both matching AND non-matching cases, plus a couple of bad-pattern cases.
//
// The NON-matching half is the half that matters, and it is not symmetry for its own sake.
// This engine is now part of the TEST GATE (see the ⚠ note atop regex.tks): the regression
// runner's `Then <stream> pattern = "…"` step decides other scenarios' verdicts by calling
// `is_match`. A bug that matches too little makes a good scenario go red — loud, and fixed
// the same day. A bug that matches too much makes a BROKEN scenario go green, and nothing
// downstream will ever report it. So every operator a `.tkr` may spell is asserted here in
// both directions: what it accepts, and — the load-bearing one — what it must refuse.

/**
 * matched — unwrap `bool | error` from `is_match_pattern`. A bad pattern in these matching tests is
 * itself a test failure: every pattern below is meant to compile, and the ones that are not live in
 * `malformed_patterns_are_compile_errors`.
 *
 * @param pattern  the regex source (expected to compile)
 * @param input    the subject text
 * @return         true when the pattern is found somewhere in `input`
 */
fn matched(pattern: str, input: str): bool {
    match teko::regex::is_match_pattern(pattern, input) {
        bool as b => b
        error => { teko::assert::is_true(false); false }
    }
}

/**
 * rejected — true when `pattern` is REJECTED at compile time. The input is irrelevant: a pattern
 * that does not parse never reaches the matcher.
 *
 * @param pattern  the regex source under test
 * @return         true when compiling it is an honest error
 */
fn rejected(pattern: str): bool {
    match teko::regex::is_match_pattern(pattern, "any input at all") {
        bool => false
        error => true
    }
}

#test
/**
 * literal_searches_anywhere_in_the_input — `is_match` is a SEARCH: a literal pattern is found at
 * any offset, and is still refused when the input merely resembles it.
 *
 * @return void
 */
fn literal_searches_anywhere_in_the_input() {
    teko::assert::is_true(matched("panic", "6:17: teko: deliberate panic: impossible conversion"))
    teko::assert::is_true(matched("6:17", "6:17: teko: deliberate panic: impossible conversion"))
    teko::assert::is_false(matched("panicked", "6:17: teko: deliberate panic: impossible conversion"))
}

#test
/**
 * literal_multibyte_codepoint_matches_the_same_text — a pattern literal that is NOT ASCII must find
 * itself in input carrying the identical text, and must still refuse input that only LOOKS similar.
 * Regression for the defect where the parser walked the pattern BYTE BY BYTE: a multi-byte codepoint
 * (the em dash `—`, U+2014, 3 bytes) became three separate one-byte `RChar` nodes, none of which ever
 * decoded back to U+2014 — so the declared text could never be found, even though it sat byte-for-byte
 * in the subject (cargo/0.3.1.0-matcher-padrao-stderr — CI run 30563221738, `own_native.tkr` ::
 * `assert_failure_names_the_scenario_and_both_values`).
 *
 * @return void
 */
fn literal_multibyte_codepoint_matches_the_same_text() {
    var panic_text = "teko: deliberate panic: the_named_case: assertion failed: eq_i64 — expected 42, got 41\nteko: stack trace:\n"
    teko::assert::is_true(matched("the_named_case: assertion failed: eq_i64 — expected 42, got 41", panic_text))
    teko::assert::is_false(matched("the_named_case: assertion failed: eq_i64 - expected 42, got 41", panic_text))
    teko::assert::is_true(matched("café", "a café au lait"))
    teko::assert::is_false(matched("café", "a cafe au lait"))
}

#test
/**
 * class_member_multibyte_codepoint — a `[...]` class member (and a range endpoint) decodes as a
 * WHOLE codepoint too, not one raw byte at a time — the same defect class as the literal case,
 * closed by the same fix (`decode_codepoint`), covered separately so the class parser cannot regress
 * to it unnoticed.
 *
 * @return void
 */
fn class_member_multibyte_codepoint() {
    teko::assert::is_true(matched("[é—]", "café"))
    teko::assert::is_true(matched("[é—]", "em—dash"))
    teko::assert::is_false(matched("^[é—]+$", "abc"))
}

#test
/**
 * panic_marker_pattern_survives_position_and_backtrace — the pattern shape `.tkr` panic scenarios
 * actually carry: marker + reason, asserted against a stderr that also holds a source position
 * ahead of it and a backtrace after it. Those are exactly the parts that differ per platform (glibc
 * prints frames, musl prints one notice), so matching must survive both — and must still refuse the
 * WRONG reason, and a crash that was never a panic at all.
 *
 * @return void
 */
fn panic_marker_pattern_survives_position_and_backtrace() {
    var glibc = "6:17: teko: deliberate panic: impossible conversion\nteko: stack trace:\n./p(+0x1234) [0x55]\n"
    var musl  = "6:17: teko: deliberate panic: impossible conversion\nteko: stack trace unavailable on this platform (no execinfo)\n"
    teko::assert::is_true(matched("teko: deliberate panic: impossible conversion", glibc))
    teko::assert::is_true(matched("teko: deliberate panic: impossible conversion", musl))
    teko::assert::is_false(matched("teko: deliberate panic: integer overflow", glibc))
    teko::assert::is_false(matched("teko: deliberate panic: impossible conversion", "teko: FATAL signal\n"))
}

#test
/**
 * start_anchor_refuses_a_mid_string_hit — `^` is the escape hatch a scenario uses when a search is
 * too loose: it must pin to the input's true start, not to the offset being tried.
 *
 * @return void
 */
fn start_anchor_refuses_a_mid_string_hit() {
    teko::assert::is_true(matched("^teko", "teko: deliberate panic: boom"))
    teko::assert::is_false(matched("^panic", "teko: deliberate panic: boom"))
}

#test
/**
 * end_anchor_refuses_a_trailing_remainder — `$` pins to the input's true end, so a trailing newline
 * defeats it. Worth knowing before writing `$` into a `.tkr`: captured streams usually end in one.
 *
 * @return void
 */
fn end_anchor_refuses_a_trailing_remainder() {
    teko::assert::is_true(matched("boom$", "teko: deliberate panic: boom"))
    teko::assert::is_false(matched("boom$", "teko: deliberate panic: boom\n"))
    teko::assert::is_false(matched("panic$", "teko: deliberate panic: boom"))
}

#test
/**
 * both_anchors_together_demand_the_whole_input — `^…$` is how a scenario asks for exactness, and
 * why the `Pattern` mode did not need an implicit total match imposed on every pattern.
 *
 * @return void
 */
fn both_anchors_together_demand_the_whole_input() {
    teko::assert::is_true(matched("^abc$", "abc"))
    teko::assert::is_false(matched("^abc$", "abcd"))
    teko::assert::is_false(matched("^abc$", "zabc"))
}

#test
/**
 * dot_matches_exactly_one_codepoint — `.` consumes ONE codepoint: never zero, never a run.
 *
 * @return void
 */
fn dot_matches_exactly_one_codepoint() {
    teko::assert::is_true(matched("^a.c$", "abc"))
    teko::assert::is_false(matched("^a.c$", "ac"))
    teko::assert::is_false(matched("^a.c$", "abbc"))
}

#test
/**
 * star_accepts_zero_but_plus_demands_one — the pair whose difference IS the "matches too much"
 * risk: if `+` ever behaved like `*`, a pattern demanding at least one occurrence would accept
 * none, and the scenario asserting it would go green on nothing.
 *
 * @return void
 */
fn star_accepts_zero_but_plus_demands_one() {
    teko::assert::is_true(matched("^ab*c$", "ac"))
    teko::assert::is_true(matched("^ab*c$", "abbbc"))
    teko::assert::is_false(matched("^ab+c$", "ac"))
    teko::assert::is_true(matched("^ab+c$", "abbbc"))
}

#test
/**
 * dot_star_is_not_a_free_pass — `.*` is the loosest thing a pattern can spell, and even it must
 * still hold its anchors and its literal neighbours.
 *
 * @return void
 */
fn dot_star_is_not_a_free_pass() {
    teko::assert::is_true(matched("^a.*z$", "abcz"))
    teko::assert::is_true(matched("^a.*z$", "az"))
    teko::assert::is_false(matched("^a.*z$", "abc"))
}

#test
/**
 * opt_matches_zero_or_one — `?` accepts zero or one occurrence, and refuses two.
 *
 * @return void
 */
fn opt_matches_zero_or_one() {
    teko::assert::is_true(matched("colou?r", "color"))
    teko::assert::is_true(matched("colou?r", "colour"))
    teko::assert::is_false(matched("^colou?r$", "colouur"))
}

#test
/**
 * class_negation_matches — `[^…]` accepts a non-member and refuses an input that contains a member.
 *
 * @return void
 */
fn class_negation_matches() {
    teko::assert::is_true(matched("[^0-9]", "x"))
    teko::assert::is_false(matched("^[^0-9]+$", "abc123"))
}

#test
/**
 * class_range_accepts_only_its_members — an `a-z`/`0-9` range accepts exactly its members. The
 * refusals are the load-bearing half: a range that quietly widened would accept anything.
 *
 * @return void
 */
fn class_range_accepts_only_its_members() {
    teko::assert::is_true(matched("^[0-9]+$", "4711"))
    teko::assert::is_false(matched("^[0-9]+$", "47a"))
    teko::assert::is_false(matched("^[0-9]+$", ""))
    teko::assert::is_true(matched("^[a-z0-9_]+$", "exit_code_7"))
    teko::assert::is_false(matched("^[a-z0-9_]+$", "exit-code-7"))
}

#test
/**
 * alternation_takes_either_branch_and_no_third — `|` takes either branch and invents no third one.
 *
 * @return void
 */
fn alternation_takes_either_branch_and_no_third() {
    teko::assert::is_true(matched("^cat|dog$", "cat"))
    teko::assert::is_true(matched("^cat|dog$", "dog"))
    teko::assert::is_false(matched("^(cat|dog)$", "cow"))
    teko::assert::is_true(matched("panic: (boom|impossible conversion)", "teko: deliberate panic: boom"))
    teko::assert::is_false(matched("panic: (boom|impossible conversion)", "teko: deliberate panic: integer overflow"))
}

#test
/**
 * group_binds_the_quantifier_to_the_whole_group — a quantifier binds to the GROUP, and without the
 * group it binds to the single atom before it. The last assertion pins that difference.
 *
 * @return void
 */
fn group_binds_the_quantifier_to_the_whole_group() {
    teko::assert::is_true(matched("^(ab)+$", "abab"))
    teko::assert::is_false(matched("^(ab)+$", "aba"))
    teko::assert::is_false(matched("^ab+$", "abab"))
}

#test
/**
 * full_match_requires_the_whole_input — `full_match` anchors both ends regardless of any literal
 * `^`/`$` in the pattern. The regression runner does NOT use it (its `Pattern` mode is a search);
 * it stays covered because the module exports it.
 *
 * @return void
 */
fn full_match_requires_the_whole_input() {
    var re = match teko::regex::compile("ab*c") {
        teko::regex::Regex as r => r
        error => { teko::assert::is_true(false); teko::regex::Regex { pattern = ""; ast = teko::regex::REmpty { } } }
    }
    teko::assert::is_true(teko::regex::full_match(re, "abbc"))
    teko::assert::is_false(teko::regex::full_match(re, "xabbc"))
}

#test
/**
 * malformed_patterns_are_compile_errors — the gate's other blind spot. A malformed pattern that
 * quietly degraded to "match nothing" would fail a scenario for the wrong reason; one that degraded
 * to "match everything" would pass it for no reason at all. Refusing to compile rules out both.
 *
 * @return void
 */
fn malformed_patterns_are_compile_errors() {
    teko::assert::is_true(rejected("a("))
    teko::assert::is_true(rejected("a)"))
    teko::assert::is_true(rejected("[a-"))
    teko::assert::is_true(rejected("[z-a]"))
    teko::assert::is_true(rejected("*x"))
    teko::assert::is_false(rejected("^a(b|c)*d$"))
}

#test
/**
 * escape_sequences_are_refused_not_ignored — a `\` is a compile error, not a silently-dropped
 * character. This is also why a `.tkr` pattern cannot yet match a literal `.` or `(`.
 *
 * @return void
 */
fn escape_sequences_are_refused_not_ignored() {
    teko::assert::is_true(rejected("a\\.c"))
    teko::assert::is_true(rejected("\\d+"))
}
