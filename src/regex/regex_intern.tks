use teko::list

// --- the []RegexNode-of-one helper pair (the interpreter workaround plumbing) ---

fn one(node: RegexNode) -> []RegexNode { teko::list::push(teko::list::empty(), node) }
fn one_of(wrapped: []RegexNode) -> RegexNode { wrapped[0] }

/**
 * utf8_width — the byte width of the UTF-8 codepoint whose LEAD byte is `b0`. Every byte a caller
 * offers here comes from `bytes_of_str` on a `str`, which the language already guarantees is valid
 * UTF-8 (B.36) — so classifying the lead byte is enough; there is no invalid-lead case left to
 * report, since that already ended at the `str`'s own boundary.
 *
 * @param b0  the lead byte of a codepoint
 * @return    1 for ASCII, 2/3/4 for a two/three/four-byte lead
 */
fn utf8_width(b0: byte) -> u64 {
    if b0 <= 0x7F { return 1 }
    if b0 <= 0xDF { return 2 }
    if b0 <= 0xEF { return 3 }
    4
}

/**
 * decode_codepoint — decodes the FULL UTF-8 codepoint starting at byte offset `pos` in `p`.
 *
 * THE DEFECT THIS CLOSES: the parser used to walk the pattern BYTE BY BYTE, turning every raw byte
 * into its own `RChar` node — correct only for ASCII. A multi-byte pattern character (e.g. the em
 * dash `—`, U+2014, 3 bytes) became THREE separate nodes, each decoded from a LONE byte wrapped as
 * if it were its own one-byte string; a lead or continuation byte in isolation is not valid UTF-8,
 * so none of the three ever decoded back to U+2014. The matcher's other side, `is_match`, decodes
 * the SUBJECT text correctly (`chars()`, real codepoints) — so a literal non-ASCII pattern
 * character could never match the identical text it was quoted from, however plainly that text
 * sat in the captured stream. This function decodes the WHOLE codepoint in one step so the parser
 * advances by codepoints, the same unit `is_match` already scans in.
 *
 * @param p    the pattern's raw bytes (`bytes_of_str` on a `str` — valid UTF-8 by construction)
 * @param pos  the byte offset of the codepoint's lead byte
 * @return     the decoded codepoint and its width in bytes
 */
fn decode_codepoint(p: []byte, pos: u64) -> CPScan {
    let width = utf8_width(p[pos])
    if width == 1 { return CPScan { cp = p[pos] to u32; width = width } }
    if width == 2 {
        let b0 = p[pos] to u32
        let b1 = p[pos + 1] to u32
        return CPScan { cp = ((b0 & 0x1F) << 6) | (b1 & 0x3F); width = width }
    }
    if width == 3 {
        let b0 = p[pos] to u32
        let b1 = p[pos + 1] to u32
        let b2 = p[pos + 2] to u32
        return CPScan { cp = ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F); width = width }
    }
    let b0 = p[pos] to u32
    let b1 = p[pos + 1] to u32
    let b2 = p[pos + 2] to u32
    let b3 = p[pos + 3] to u32
    CPScan { cp = ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F); width = width }
}

fn codepoints_of(input: str) -> []u32 {
    let bytes = bytes_of_str(input)
    mut out: []u32 = teko::list::empty()
    mut pos: u64 = 0
    loop {
        if pos >= bytes.len { break }
        let scan = decode_codepoint(bytes, pos)
        out = teko::list::push(out, scan.cp)
        pos = pos + scan.width
    }
    out
}

fn parse_alt(p: []byte, pos: u64) -> PState | error {
    let first = match parse_concat(p, pos) { PState as s => s; error as e => return e }
    mut branches: []RegexNode = teko::list::push(teko::list::empty(), first.node)
    mut at = first.pos
    loop {
        if at >= p.len || p[at] != b'|' { break }
        let next = match parse_concat(p, at + 1) { PState as s => s; error as e => return e }
        branches = teko::list::push(branches, next.node)
        at = next.pos
    }
    if branches.len == 1 { return PState { pos = at; node = first.node } }
    PState { pos = at; node = RAlt { branches = branches } }
}

fn parse_concat(p: []byte, pos: u64) -> PState | error {
    mut parts: []RegexNode = teko::list::empty()
    mut at = pos
    loop {
        if at >= p.len || p[at] == b'|' || p[at] == b')' { break }
        let step = match parse_repeat(p, at) { PState as s => s; error as e => return e }
        parts = teko::list::push(parts, step.node)
        at = step.pos
    }
    if parts.len == 0 { return PState { pos = at; node = REmpty { } } }
    if parts.len == 1 { return PState { pos = at; node = parts[0] } }
    PState { pos = at; node = RConcat { parts = parts } }
}

fn parse_repeat(p: []byte, pos: u64) -> PState | error {
    let base = match parse_atom(p, pos) { PState as s => s; error as e => return e }
    if base.pos < p.len && p[base.pos] == b'*' {
        return PState { pos = base.pos + 1; node = RStar { inner = one(base.node) } }
    }
    if base.pos < p.len && p[base.pos] == b'+' {
        return PState { pos = base.pos + 1; node = RPlus { inner = one(base.node) } }
    }
    if base.pos < p.len && p[base.pos] == b'?' {
        return PState { pos = base.pos + 1; node = ROpt { inner = one(base.node) } }
    }
    base
}

/**
 * parse_atom — the highest-precedence grammar rule: `.` | `^` | `$` | a `(...)` group | a `[...]`
 * class | a literal codepoint. A literal is decoded whole via `decode_codepoint`, so a multi-byte
 * pattern character advances the cursor by its own byte width, never by a fixed one byte.
 *
 * @param p    the pattern's raw bytes
 * @param pos  the byte offset to parse from
 * @return     the parsed node and the position just past it
 * @throws     an unterminated group, a bare `\`, a stray `)`, or a quantifier with nothing to repeat
 */
fn parse_atom(p: []byte, pos: u64) -> PState | error {
    if pos >= p.len { return error { message = "regex: unexpected end of pattern" } }
    let b = p[pos]
    if b == b'.' { return PState { pos = pos + 1; node = RAny { } } }
    if b == b'^' { return PState { pos = pos + 1; node = RStart { } } }
    if b == b'$' { return PState { pos = pos + 1; node = REnd { } } }
    if b == b'(' {
        let inner = match parse_alt(p, pos + 1) { PState as s => s; error as e => return e }
        if inner.pos >= p.len || p[inner.pos] != b')' {
            return error { message = "regex: unterminated group — expected ')'" }
        }
        return PState { pos = inner.pos + 1; node = RGroup { inner = one(inner.node) } }
    }
    if b == b'[' { return parse_class(p, pos + 1) }
    if b == b'\\' {
        return error { message = "regex: escape sequences are not supported yet (ROUND 0 scope)" }
    }
    if b == b')' { return error { message = "regex: unexpected ')'" } }
    if b == b'*' || b == b'+' || b == b'?' {
        return error { message = "regex: quantifier with nothing to repeat" }
    }
    let scan = decode_codepoint(p, pos)
    PState { pos = pos + scan.width; node = RChar { cp = scan.cp } }
}

/**
 * parse_class — a `[...]` character class; `pos` is just AFTER the `[`. Supports `^` negation (the
 * first byte) and `a-z` ranges; a lone trailing `-` (e.g. `[a-]`) is a literal `-`, mirroring common
 * practice. Each member is decoded as a whole codepoint (`decode_codepoint`), so a multi-byte class
 * member or range endpoint is never split across raw bytes.
 *
 * @param p    the pattern's raw bytes
 * @param pos  the byte offset just past the class's opening `[`
 * @return     the parsed `RClass` node and the position just past its closing `]`
 * @throws     an unterminated or empty class, or a range whose endpoints are out of order
 */
fn parse_class(p: []byte, pos: u64) -> PState | error {
    mut at = pos
    mut negate = false
    if at < p.len && p[at] == b'^' { negate = true; at = at + 1 }
    mut ranges: []RRange = teko::list::empty()
    mut first = true
    loop {
        if at >= p.len { return error { message = "regex: unterminated character class — expected ']'" } }
        if p[at] == b']' && !first { break }
        first = false
        let lo = decode_codepoint(p, at)
        let after_lo = at + lo.width
        if after_lo + 1 < p.len && p[after_lo] == b'-' && p[after_lo + 1] != b']' {
            let hi = decode_codepoint(p, after_lo + 1)
            if hi.cp < lo.cp { return error { message = "regex: character class range out of order" } }
            ranges = teko::list::push(ranges, RRange { lo = lo.cp; hi = hi.cp })
            at = after_lo + 1 + hi.width
        } else {
            ranges = teko::list::push(ranges, RRange { lo = lo.cp; hi = lo.cp })
            at = after_lo
        }
    }
    if ranges.len == 0 { return error { message = "regex: empty character class" } }
    PState { pos = at + 1; node = RClass { negate = negate; ranges = ranges } }
}

/**
 * The matcher: recursive backtracking over input CODEPOINTS.
 *
 * `m_node(node, input, i, cont)` tries to match `node` starting at codepoint index `i` of `input`
 * (an `[]char`, ROUND 0 codepoint-ops), then matches the CONTINUATION `cont` — the sibling nodes
 * still to match, in order — starting at the index just past this match. It answers true iff
 * `node` then `cont` succeeds somewhere. This is first-order CPS: `cont` stands in for "the rest
 * of the pattern", letting `*`/`+`/`?`/alternation backtrack (retry a shorter or alternate match
 * of `node`) when `cont` fails to follow.
 *
 * THE CONTINUATION IS A CONS CHAIN, NOT A LIST, and that is a memory ruling rather than a taste.
 * It used to be a `[]RegexNode` that every step REBUILT: `m_cont` copied the tail to drop one
 * head, and a concatenation copied the whole sibling run onto the caller's continuation — at
 * EVERY start offset of the search. Nothing frees inside a run (the region allocator releases at
 * termination), so a search over a few kilobytes allocated tens of megabytes, and the regression
 * runner — which judges every scenario's output through `is_match` — turned that into gigabytes
 * of resident parent and an OOM kill of `teko test` (measured 2026-07-31: 130 scenarios matching
 * against a 2.7 KB stream took the runner's parent process to 1.9 GB). A cons cell shares its
 * tail instead of copying it, and the search's top-level chain is built ONCE for all offsets, so
 * a literal pattern now allocates NOTHING per offset. Same language, same backtracking order,
 * same verdicts.
 */
type MCont = struct {
// the node to match next.
    head: RegexNode
// the rest of the continuation: a ONE-element slice, or empty at the end of the chain.
    tail: []MCont
}

/**
 * mc_end — the empty continuation: nothing left to match, so reaching it is a match.
 *
 * @return the end-of-chain continuation
 */
fn mc_end() -> []MCont { teko::list::empty() }

/**
 * mc_push — `cont` with `node` to be matched FIRST. O(1): the tail is shared, never copied.
 *
 * @param node  the node to match before `cont`
 * @param cont  the continuation to match after it
 * @return      the extended continuation
 */
fn mc_push(node: RegexNode, cont: []MCont) -> []MCont {
    teko::list::push(teko::list::empty(), MCont { head = node; tail = cont })
}

/**
 * mc_push_all — `cont` with every node of `parts` to be matched first, IN ORDER. Built from the
 * end backwards so each cell can share the one after it.
 *
 * @param parts  the sibling nodes to match, in order
 * @param cont   the continuation to match after them
 * @return       the extended continuation
 */
fn mc_push_all(parts: []RegexNode, cont: []MCont) -> []MCont {
    mut out = cont
    mut j = parts.len
    loop {
        if j == 0 { break }
        j = j - 1
        out = mc_push(parts[j], out)
    }
    out
}

/**
 * mc_of_node — the continuation that matches `node` and then `cont`. A concatenation is FLATTENED
 * into the chain here rather than re-flattened on every visit, which is what lets a search hoist
 * its whole top-level pattern out of the start-offset loop.
 *
 * @param node  the node to match
 * @param cont  what to match after it
 * @return      the continuation
 */
fn mc_of_node(node: RegexNode, cont: []MCont) -> []MCont {
    match node {
        RConcat as c => mc_push_all(c.parts, cont)
        _ => mc_push(node, cont)
    }
}

/**
 * class_matches — is `cp` a member of the character class `cls`? A negated class answers the
 * opposite of the membership test, which is the whole of `[^…]`.
 *
 * @param cls  the class to test against
 * @param cp   the candidate codepoint
 * @return     true iff the class accepts `cp`
 */
fn class_matches(cls: RClass, cp: u32) -> bool {
    mut i: u64 = 0
    mut hit = false
    loop {
        if i >= cls.ranges.len { break }
        let r = cls.ranges[i]
        if cp >= r.lo && cp <= r.hi { hit = true; break }
        i++
    }
    if cls.negate { !hit } else { hit }
}

/**
 * m_cont — match a continuation chain from index `i`: its head, with the rest as ITS continuation.
 * An empty chain is a match — there is nothing left to demand.
 *
 * @param cont   the continuation chain
 * @param input  the input codepoints
 * @param i      the codepoint index to match from
 * @return       true iff the whole chain matches from `i`
 */
fn m_cont(cont: []MCont, input: []u32, i: u64) -> bool {
    if cont.len == 0 { return true }
    m_node(cont[0].head, input, i, cont[0].tail)
}

/**
 * m_node — match one node from index `i`, then its continuation from just past the match.
 *
 * @param node   the node to match
 * @param input  the input codepoints
 * @param i      the codepoint index to match from
 * @param cont   what must match after `node`
 * @return       true iff `node` and then `cont` match
 */
fn m_node(node: RegexNode, input: []u32, i: u64, cont: []MCont) -> bool {
    match node {
        REmpty => m_cont(cont, input, i)
        RChar as c => m_one(i < input.len && input[i] == c.cp, input, i, cont)
        RAny => m_one(i < input.len, input, i, cont)
        RClass as cls => m_one(i < input.len && class_matches(cls, input[i]), input, i, cont)
        RStart => i == 0 && m_cont(cont, input, i)
        REnd => i == input.len && m_cont(cont, input, i)
        RGroup as g => m_node(one_of(g.inner), input, i, cont)
        RConcat as c => m_cont(mc_push_all(c.parts, cont), input, i)
        RAlt as a => m_alt(a.branches, 0, input, i, cont)
        RStar as s => m_star(one_of(s.inner), input, i, cont)
        RPlus as pl => m_plus(one_of(pl.inner), input, i, cont)
        ROpt as o => m_opt(one_of(o.inner), input, i, cont)
    }
}

/**
 * m_one — the shared tail of every SINGLE-CODEPOINT node (`RChar`/`RAny`/`RClass`): when the node
 * accepted the codepoint at `i`, the continuation must match from `i + 1`; otherwise there is no
 * match. Named once because three arms differing only in their acceptance test are three chances
 * for one of them to advance by the wrong amount.
 *
 * @param accepted  whether the node accepted the codepoint at `i` (false also when `i` is past the end)
 * @param input     the input codepoints
 * @param i         the codepoint index the node consumed
 * @param cont      what must match after it
 * @return          true iff the node accepted and the continuation matches from `i + 1`
 */
fn m_one(accepted: bool, input: []u32, i: u64, cont: []MCont) -> bool {
    accepted && m_cont(cont, input, i + 1)
}

/**
 * m_alt — match the first branch of an alternation that succeeds, in declaration order.
 *
 * @param branches  the alternation's branches
 * @param idx       the branch to try now
 * @param input     the input codepoints
 * @param i         the codepoint index to match from
 * @param cont      what must match after the branch
 * @return          true iff some branch from `idx` on matches, followed by `cont`
 */
fn m_alt(branches: []RegexNode, idx: u64, input: []u32, i: u64, cont: []MCont) -> bool {
    if idx >= branches.len { return false }
    if m_node(branches[idx], input, i, cont) { return true }
    m_alt(branches, idx + 1, input, i, cont)
}

/**
 * m_star — `x*`, GREEDY: try "one more copy of `x`, then star again" before "stop here" (the
 * classic longest-first backtracking star).
 *
 * @param inner  the repeated node
 * @param input  the input codepoints
 * @param i      the codepoint index to match from
 * @param cont   what must match after the repetition
 * @return       true iff some number of copies of `inner` followed by `cont` matches
 */
fn m_star(inner: RegexNode, input: []u32, i: u64, cont: []MCont) -> bool {
    if m_node(inner, input, i, mc_push(RStar { inner = one(inner) }, cont)) { return true }
    m_cont(cont, input, i)
}

/**
 * m_plus — `x+` = one copy of `x`, then `x*`: reuse `m_star`'s own backtracking by making the
 * first match's continuation "star again, then whatever `cont` already held".
 *
 * @param inner  the repeated node
 * @param input  the input codepoints
 * @param i      the codepoint index to match from
 * @param cont   what must match after the repetition
 * @return       true iff one or more copies of `inner` followed by `cont` matches
 */
fn m_plus(inner: RegexNode, input: []u32, i: u64, cont: []MCont) -> bool {
    m_node(inner, input, i, mc_push(RStar { inner = one(inner) }, cont))
}

/**
 * m_opt — `x?`, GREEDY: try matching `x` (then `cont`); if that fails, skip `x` and match `cont`
 * at the SAME position.
 *
 * @param inner  the optional node
 * @param input  the input codepoints
 * @param i      the codepoint index to match from
 * @param cont   what must match after it
 * @return       true iff `inner` then `cont`, or `cont` alone, matches from `i`
 */
fn m_opt(inner: RegexNode, input: []u32, i: u64, cont: []MCont) -> bool {
    if m_node(inner, input, i, cont) { return true }
    m_cont(cont, input, i)
}
