/**
 * `teko::sort` selection: `nth_*` returns the k-th smallest element (0-indexed) of a slice, in
 * O(n) EXPECTED time via quickselect — without fully sorting `xs` first. NO INDEX-ASSIGNMENT (a
 * Teko language law): rather than the classical in-place Lomuto/Hoare partition (which mutates the
 * array through `xs[i] = …`), each partition step reads `xs` once and BUILDS three fresh slices
 * (`less`/`equal`/`greater`) with `teko::list::push`, then recurses into whichever one contains the
 * sought rank — the same value-thread discipline `teko::sort::sort.tks`'s merge sort already uses.
 * One family per concrete element type (`i64`/`u64`/`f64`/`str`/`byte`).
 */

/**
 * One quickselect partition step of `xs` against the middle element as pivot, returning the k-th
 * smallest (0-indexed) by recursing into whichever of the three partitions contains rank `k`. The
 * caller (`nth_i64`) has already checked `0 <= k < xs.len`, an invariant this function preserves on
 * every recursive call, so `xs` is never empty here.
 *
 * @param xs  a nonempty slice (read only; never mutated in place)
 * @param k   the sought rank, `0 <= k < xs.len`
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 */
fn quickselect_i64(xs: []i64, k: u64): i64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: []i64 = teko::list::empty()
    var equal: []i64 = teko::list::empty()
    var greater: []i64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less = teko::list::push(less, xs[i]); i++; continue }
        if xs[i] > pivot { greater = teko::list::push(greater, xs[i]); i++; continue }
        equal = teko::list::push(equal, xs[i])
        i++
    }
    if k < less.len { return quickselect_i64(less, k) }
    if k < less.len + equal.len { return pivot }
    quickselect_i64(greater, k - less.len - equal.len)
}

/**
 * The k-th smallest element (0-indexed) of `xs` under the native signed order — equivalent to
 * `teko::sort::sort_i64(xs)[k]` but without materializing the whole sorted slice.
 *
 * @param xs  the slice to select from (read only; never mutated in place)
 * @param k   the 0-indexed rank sought
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 * @throws    panics when `k >= xs.len` (including the empty-slice case), mirroring array-index
 *            out-of-range
 */
exp fn nth_i64(xs: []i64, k: u64): i64 {
    if k >= xs.len { panic("teko::sort::nth_i64: k is out of range") }
    quickselect_i64(xs, k)
}

/**
 * One quickselect partition step of `xs` against the middle element as pivot, returning the k-th
 * smallest (0-indexed) by recursing into whichever of the three partitions contains rank `k`.
 *
 * @param xs  a nonempty slice (read only; never mutated in place)
 * @param k   the sought rank, `0 <= k < xs.len`
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 */
fn quickselect_u64(xs: []u64, k: u64): u64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: []u64 = teko::list::empty()
    var equal: []u64 = teko::list::empty()
    var greater: []u64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less = teko::list::push(less, xs[i]); i++; continue }
        if xs[i] > pivot { greater = teko::list::push(greater, xs[i]); i++; continue }
        equal = teko::list::push(equal, xs[i])
        i++
    }
    if k < less.len { return quickselect_u64(less, k) }
    if k < less.len + equal.len { return pivot }
    quickselect_u64(greater, k - less.len - equal.len)
}

/**
 * The k-th smallest element (0-indexed) of `xs` under the native unsigned order.
 *
 * @param xs  the slice to select from (read only; never mutated in place)
 * @param k   the 0-indexed rank sought
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 * @throws    panics when `k >= xs.len` (including the empty-slice case)
 */
exp fn nth_u64(xs: []u64, k: u64): u64 {
    if k >= xs.len { panic("teko::sort::nth_u64: k is out of range") }
    quickselect_u64(xs, k)
}

/**
 * One quickselect partition step of `xs` against the middle element as pivot under
 * `teko::sort::cmp_f64`'s NaN-last total order, returning the k-th smallest (0-indexed).
 *
 * @param xs  a nonempty slice (read only; never mutated in place)
 * @param k   the sought rank, `0 <= k < xs.len`
 * @return    the element that would sit at index `k` were `xs` sorted ascending under `cmp_f64`
 */
fn quickselect_f64(xs: []f64, k: u64): f64 {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: []f64 = teko::list::empty()
    var equal: []f64 = teko::list::empty()
    var greater: []f64 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var c = teko::sort::cmp_f64(xs[i], pivot)
        if c < 0 { less = teko::list::push(less, xs[i]); i++; continue }
        if c > 0 { greater = teko::list::push(greater, xs[i]); i++; continue }
        equal = teko::list::push(equal, xs[i])
        i++
    }
    if k < less.len { return quickselect_f64(less, k) }
    if k < less.len + equal.len { return pivot }
    quickselect_f64(greater, k - less.len - equal.len)
}

/**
 * The k-th smallest element (0-indexed) of `xs` under `teko::sort::cmp_f64`'s NaN-last total order
 * (so any NaN present ranks last).
 *
 * @param xs  the slice to select from (read only; never mutated in place)
 * @param k   the 0-indexed rank sought
 * @return    the element that would sit at index `k` were `xs` sorted ascending under `cmp_f64`
 * @throws    panics when `k >= xs.len` (including the empty-slice case)
 */
exp fn nth_f64(xs: []f64, k: u64): f64 {
    if k >= xs.len { panic("teko::sort::nth_f64: k is out of range") }
    quickselect_f64(xs, k)
}

/**
 * One quickselect partition step of `xs` against the middle element as pivot under
 * `teko::sort::cmp`'s lexicographic byte order, returning the k-th smallest (0-indexed).
 *
 * @param xs  a nonempty slice (read only; never mutated in place)
 * @param k   the sought rank, `0 <= k < xs.len`
 * @return    the element that would sit at index `k` were `xs` sorted ascending under `cmp`
 */
fn quickselect_str(xs: []str, k: u64): str {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: []str = teko::list::empty()
    var equal: []str = teko::list::empty()
    var greater: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        var c = teko::sort::cmp(xs[i], pivot)
        if c < 0 { less = teko::list::push(less, xs[i]); i++; continue }
        if c > 0 { greater = teko::list::push(greater, xs[i]); i++; continue }
        equal = teko::list::push(equal, xs[i])
        i++
    }
    if k < less.len { return quickselect_str(less, k) }
    if k < less.len + equal.len { return pivot }
    quickselect_str(greater, k - less.len - equal.len)
}

/**
 * The k-th smallest string (0-indexed) of `xs` under `teko::sort::cmp`'s lexicographic byte order.
 *
 * @param xs  the slice to select from (read only; never mutated in place)
 * @param k   the 0-indexed rank sought
 * @return    the element that would sit at index `k` were `xs` sorted ascending under `cmp`
 * @throws    panics when `k >= xs.len` (including the empty-slice case)
 */
exp fn nth_str(xs: []str, k: u64): str {
    if k >= xs.len { panic("teko::sort::nth_str: k is out of range") }
    quickselect_str(xs, k)
}

/**
 * One quickselect partition step of `xs` against the middle element as pivot, returning the k-th
 * smallest (0-indexed) by recursing into whichever of the three partitions contains rank `k`.
 *
 * @param xs  a nonempty slice (read only; never mutated in place)
 * @param k   the sought rank, `0 <= k < xs.len`
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 */
fn quickselect_bytes(xs: []byte, k: u64): byte {
    if xs.len == 1 { return xs[0] }
    var pivot = xs[xs.len / 2]
    var less: []byte = teko::list::empty()
    var equal: []byte = teko::list::empty()
    var greater: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] < pivot { less = teko::list::push(less, xs[i]); i++; continue }
        if xs[i] > pivot { greater = teko::list::push(greater, xs[i]); i++; continue }
        equal = teko::list::push(equal, xs[i])
        i++
    }
    if k < less.len { return quickselect_bytes(less, k) }
    if k < less.len + equal.len { return pivot }
    quickselect_bytes(greater, k - less.len - equal.len)
}

/**
 * The k-th smallest byte (0-indexed) of `xs` under the native unsigned octet order.
 *
 * @param xs  the slice to select from (read only; never mutated in place)
 * @param k   the 0-indexed rank sought
 * @return    the element that would sit at index `k` were `xs` sorted ascending
 * @throws    panics when `k >= xs.len` (including the empty-slice case)
 */
exp fn nth_bytes(xs: []byte, k: u64): byte {
    if k >= xs.len { panic("teko::sort::nth_bytes: k is out of range") }
    quickselect_bytes(xs, k)
}
