#test fn is_sorted_i64_classifies_correctly() {
    var empty: []i64 = teko::list::empty()
    teko::assert::is_true(teko::sort::is_sorted_i64(empty))
    teko::assert::is_true(teko::sort::is_sorted_i64([1]))
    teko::assert::is_true(teko::sort::is_sorted_i64([1, 1, 2, 3]))
    teko::assert::is_false(teko::sort::is_sorted_i64([3, 1, 2]))
}

#test fn bsearch_i64_finds_and_misses() {
    var xs = [1, 3, 5, 7, 9]
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 5) { u64 as i => xs[i] == 5; null => false })
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 1) { u64 as i => xs[i] == 1; null => false })
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 9) { u64 as i => xs[i] == 9; null => false })
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 0) { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 4) { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_i64(xs, 10) { u64 => false; null => true })
    var empty: []i64 = teko::list::empty()
    teko::assert::is_true(match teko::sort::bsearch_i64(empty, 1) { u64 => false; null => true })
}

#test fn partition_point_i64_finds_boundary() {
    var xs = [1, 2, 4, 8, 10]
    teko::assert::eq_u64(teko::sort::partition_point_i64(xs, (v: i64) => v < 5), 3)
    teko::assert::eq_u64(teko::sort::partition_point_i64(xs, (v: i64) => v < 100), 5)
    teko::assert::eq_u64(teko::sort::partition_point_i64(xs, (v: i64) => v < 0), 0)
    var empty: []i64 = teko::list::empty()
    teko::assert::eq_u64(teko::sort::partition_point_i64(empty, (v: i64) => v < 5), 0)
}

#test fn is_sorted_u64_classifies_correctly() {
    var empty: []u64 = teko::list::empty()
    teko::assert::is_true(teko::sort::is_sorted_u64(empty))
    teko::assert::is_true(teko::sort::is_sorted_u64([1]))
    teko::assert::is_true(teko::sort::is_sorted_u64([1, 1, 2, 3]))
    teko::assert::is_false(teko::sort::is_sorted_u64([3, 1, 2]))
}

#test fn bsearch_u64_finds_and_misses() {
    var xs: []u64 = [1, 3, 5, 7, 9]
    teko::assert::is_true(match teko::sort::bsearch_u64(xs, 5) { u64 as i => xs[i] == 5; null => false })
    teko::assert::is_true(match teko::sort::bsearch_u64(xs, 0) { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_u64(xs, 4) { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_u64(xs, 10) { u64 => false; null => true })
}

#test fn partition_point_u64_finds_boundary() {
    var xs: []u64 = [1, 2, 4, 8, 10]
    teko::assert::eq_u64(teko::sort::partition_point_u64(xs, (v: u64) => v < 5), 3)
    teko::assert::eq_u64(teko::sort::partition_point_u64(xs, (v: u64) => v < 100), 5)
    teko::assert::eq_u64(teko::sort::partition_point_u64(xs, (v: u64) => v < 1), 0)
}

#test fn is_sorted_f64_classifies_correctly() {
    var empty: []f64 = teko::list::empty()
    teko::assert::is_true(teko::sort::is_sorted_f64(empty))
    teko::assert::is_true(teko::sort::is_sorted_f64([1.0]))
    teko::assert::is_true(teko::sort::is_sorted_f64([1.0, 2.0, teko::math::nan()]))
    teko::assert::is_false(teko::sort::is_sorted_f64([3.0, 1.0, 2.0]))
    teko::assert::is_false(teko::sort::is_sorted_f64([teko::math::nan(), 1.0]))
}

#test fn bsearch_f64_finds_and_misses() {
    var xs = [1.0, 3.0, 5.0, 7.0]
    teko::assert::is_true(match teko::sort::bsearch_f64(xs, 5.0) { u64 as i => xs[i] == 5.0; null => false })
    teko::assert::is_true(match teko::sort::bsearch_f64(xs, 4.0) { u64 => false; null => true })
}

#test fn bsearch_f64_finds_nan() {
    var xs = [1.0, 2.0, teko::math::nan()]
    teko::assert::is_true(match teko::sort::bsearch_f64(xs, teko::math::nan()) { u64 as i => teko::math::is_nan(xs[i]); null => false })
}

#test fn partition_point_f64_finds_boundary() {
    var xs = [1.0, 2.0, 4.0, 8.0]
    teko::assert::eq_u64(teko::sort::partition_point_f64(xs, (v: f64) => v < 3.0), 2)
    teko::assert::eq_u64(teko::sort::partition_point_f64(xs, (v: f64) => v < 100.0), 4)
}

#test fn is_sorted_str_classifies_correctly() {
    var empty: []str = teko::list::empty()
    teko::assert::is_true(teko::sort::is_sorted_str(empty))
    teko::assert::is_true(teko::sort::is_sorted_str(["a"]))
    teko::assert::is_true(teko::sort::is_sorted_str(["a", "b", "c"]))
    teko::assert::is_false(teko::sort::is_sorted_str(["c", "a", "b"]))
}

#test fn bsearch_str_finds_and_misses() {
    var xs = ["ant", "bee", "cat", "dog"]
    teko::assert::is_true(match teko::sort::bsearch_str(xs, "cat") { u64 as i => xs[i] == "cat"; null => false })
    teko::assert::is_true(match teko::sort::bsearch_str(xs, "ant") { u64 as i => xs[i] == "ant"; null => false })
    teko::assert::is_true(match teko::sort::bsearch_str(xs, "aardvark") { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_str(xs, "cow") { u64 => false; null => true })
    teko::assert::is_true(match teko::sort::bsearch_str(xs, "zebra") { u64 => false; null => true })
}

#test fn partition_point_str_finds_boundary() {
    var xs = ["ant", "bee", "cat", "dog"]
    teko::assert::eq_u64(teko::sort::partition_point_str(xs, (v: str) => teko::sort::cmp(v, "cat") < 0), 2)
    teko::assert::eq_u64(teko::sort::partition_point_str(xs, (v: str) => teko::sort::cmp(v, "zoo") < 0), 4)
}

#test fn is_sorted_bytes_classifies_correctly() {
    var empty: []byte = teko::list::empty()
    teko::assert::is_true(teko::sort::is_sorted_bytes(empty))
    teko::assert::is_true(teko::sort::is_sorted_bytes([b'a']))
    teko::assert::is_true(teko::sort::is_sorted_bytes([b'a', b'b', b'c']))
    teko::assert::is_false(teko::sort::is_sorted_bytes([b'c', b'a', b'b']))
}

#test fn bsearch_bytes_finds_and_misses() {
    var xs = [b'a', b'c', b'e', b'g']
    teko::assert::is_true(match teko::sort::bsearch_bytes(xs, b'e') { u64 as i => xs[i] == b'e'; null => false })
    teko::assert::is_true(match teko::sort::bsearch_bytes(xs, b'b') { u64 => false; null => true })
}

#test fn partition_point_bytes_finds_boundary() {
    var xs = [b'a', b'c', b'e', b'g']
    teko::assert::eq_u64(teko::sort::partition_point_bytes(xs, (v: byte) => v < b'e'), 2)
    teko::assert::eq_u64(teko::sort::partition_point_bytes(xs, (v: byte) => v < b'z'), 4)
}
