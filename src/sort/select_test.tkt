#test fn nth_i64_matches_full_sort_at_every_rank() {
    var xs = [5, 3, 1, 4, 2]
    var sorted = teko::sort::sort_i64(xs)
    var k: u64 = 0
    loop {
        if k >= xs.len { break }
        teko::assert::eq_i64(teko::sort::nth_i64(xs, k), sorted[k])
        k++
    }
}

#test fn nth_i64_handles_duplicates() {
    var xs = [4, 4, 4, 1, 1]
    teko::assert::eq_i64(teko::sort::nth_i64(xs, 0), 1)
    teko::assert::eq_i64(teko::sort::nth_i64(xs, 1), 1)
    teko::assert::eq_i64(teko::sort::nth_i64(xs, 2), 4)
    teko::assert::eq_i64(teko::sort::nth_i64(xs, 4), 4)
}

#test fn nth_i64_singleton() {
    teko::assert::eq_i64(teko::sort::nth_i64([9], 0), 9)
}

#test fn nth_u64_matches_full_sort_at_every_rank() {
    var xs: []u64 = [5, 3, 1, 4, 2]
    var sorted = teko::sort::sort_u64(xs)
    var k: u64 = 0
    loop {
        if k >= xs.len { break }
        teko::assert::eq_u64(teko::sort::nth_u64(xs, k), sorted[k])
        k++
    }
}

#test fn nth_u64_handles_duplicates() {
    var xs: []u64 = [4, 4, 1, 1, 1]
    teko::assert::eq_u64(teko::sort::nth_u64(xs, 0), 1)
    teko::assert::eq_u64(teko::sort::nth_u64(xs, 3), 4)
}

#test fn nth_f64_matches_full_sort_at_every_rank() {
    var xs = [5.5, 3.5, 1.5, 4.5, 2.5]
    var sorted = teko::sort::sort_f64(xs)
    var k: u64 = 0
    loop {
        if k >= xs.len { break }
        teko::assert::eq_f64(teko::sort::nth_f64(xs, k), sorted[k], 0.0)
        k++
    }
}

#test fn nth_f64_nan_is_the_highest_rank() {
    var xs = [3.0, teko::math::nan(), 1.0, 2.0]
    teko::assert::eq_f64(teko::sort::nth_f64(xs, 0), 1.0, 0.0)
    teko::assert::is_true(teko::math::is_nan(teko::sort::nth_f64(xs, 3)))
}

#test fn nth_str_matches_full_sort_at_every_rank() {
    var xs = ["mango", "apple", "cherry", "banana"]
    var sorted = teko::sort::sort_str(xs)
    var k: u64 = 0
    loop {
        if k >= xs.len { break }
        teko::assert::eq_str(teko::sort::nth_str(xs, k), sorted[k])
        k++
    }
}

#test fn nth_str_handles_duplicates() {
    var xs = ["b", "a", "b", "a"]
    teko::assert::eq_str(teko::sort::nth_str(xs, 0), "a")
    teko::assert::eq_str(teko::sort::nth_str(xs, 1), "a")
    teko::assert::eq_str(teko::sort::nth_str(xs, 2), "b")
    teko::assert::eq_str(teko::sort::nth_str(xs, 3), "b")
}

#test fn nth_bytes_matches_full_sort_at_every_rank() {
    var xs = [b'e', b'c', b'a', b'd', b'b']
    var sorted = teko::sort::sort_bytes(xs)
    var k: u64 = 0
    loop {
        if k >= xs.len { break }
        teko::assert::is_true(teko::sort::nth_bytes(xs, k) == sorted[k])
        k++
    }
}

#test fn nth_bytes_handles_duplicates() {
    var xs = [b'c', b'a', b'c', b'a']
    teko::assert::is_true(teko::sort::nth_bytes(xs, 0) == b'a')
    teko::assert::is_true(teko::sort::nth_bytes(xs, 1) == b'a')
    teko::assert::is_true(teko::sort::nth_bytes(xs, 2) == b'c')
    teko::assert::is_true(teko::sort::nth_bytes(xs, 3) == b'c')
}
