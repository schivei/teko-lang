/**
 * CLOCK_REALTIME — the POSIX `clockid_t` naming the system-wide wall-clock: settable, and it may
 * jump forward or backward on an NTP adjustment or a manual `settimeofday`. Part of `teko::sys`,
 * the curated libc/syscall CONSTANTS module for the FFI runtime (§16): every value here is a
 * literal Teko `const`, transcribed from the platform ABI — NEVER imported from a C header/macro —
 * and per-`#os` guarded so the §17 prune (`src/build/prune.tks`) keeps exactly the definition
 * matching the compiled target, before the checker ever sees the other block. Linux value: 0
 * (glibc `bits/time.h`'s `CLOCK_REALTIME`).
 *
 * @since §16
 */
#os("linux")
pub const CLOCK_REALTIME: i32 = 0

/**
 * CLOCK_MONOTONIC — the POSIX `clockid_t` naming a monotonic, never-adjusted clock: unaffected by
 * wall-clock changes, so it is the correct choice for measuring elapsed time. Linux value: 1
 * (glibc `bits/time.h`'s `CLOCK_MONOTONIC`).
 *
 * @since §16
 */
#os("linux")
pub const CLOCK_MONOTONIC: i32 = 1

/**
 * CLOCK_REALTIME — the POSIX `clockid_t` naming the system-wide wall-clock on macOS. Same numeric
 * value as the Linux definition (0, Darwin `<time.h>`'s `CLOCK_REALTIME`), but declared as its own
 * `#os("macos")` block so each per-target definition is a self-contained, independently prunable
 * unit (§17) — never a value shared across the OS boundary.
 *
 * @since §16
 */
#os("macos")
pub const CLOCK_REALTIME: i32 = 0

/**
 * CLOCK_MONOTONIC — the POSIX `clockid_t` naming a monotonic, never-adjusted clock on macOS. Value
 * 6 (Darwin `<time.h>`'s `CLOCK_MONOTONIC`), DIFFERENT from the Linux value (1) — the reason this
 * constant cannot be a single cross-platform definition and must carry its own `#os("macos")`
 * block.
 *
 * @since §16
 */
#os("macos")
pub const CLOCK_MONOTONIC: i32 = 6
