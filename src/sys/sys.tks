/**
 * CLOCK_REALTIME — the POSIX `clockid_t` naming the system-wide wall-clock: settable, and it may
 * jump forward or backward on an NTP adjustment or a manual `settimeofday`. Part of `teko::sys`,
 * the curated libc/syscall CONSTANTS module for the FFI runtime (§16): every value here is a
 * literal Teko `const`, transcribed from the platform ABI — NEVER imported from a C header/macro —
 * and per-`#os` guarded so the §17 prune (`src/build/prune.tks`) keeps exactly the definition
 * matching the compiled target, before the checker ever sees the other block. Linux value: 0
 * (glibc `bits/time.h`'s `CLOCK_REALTIME`).
 *
 * @since §16
 */
#os("linux")
pub const CLOCK_REALTIME: i32 = 0

/**
 * CLOCK_MONOTONIC — the POSIX `clockid_t` naming a monotonic, never-adjusted clock: unaffected by
 * wall-clock changes, so it is the correct choice for measuring elapsed time. Linux value: 1
 * (glibc `bits/time.h`'s `CLOCK_MONOTONIC`).
 *
 * @since §16
 */
#os("linux")
pub const CLOCK_MONOTONIC: i32 = 1

/**
 * CLOCK_REALTIME — the POSIX `clockid_t` naming the system-wide wall-clock on macOS. Same numeric
 * value as the Linux definition (0, Darwin `<time.h>`'s `CLOCK_REALTIME`), but declared as its own
 * `#os("macos")` block so each per-target definition is a self-contained, independently prunable
 * unit (§17) — never a value shared across the OS boundary.
 *
 * @since §16
 */
#os("macos")
pub const CLOCK_REALTIME: i32 = 0

/**
 * CLOCK_MONOTONIC — the POSIX `clockid_t` naming a monotonic, never-adjusted clock on macOS. Value
 * 6 (Darwin `<time.h>`'s `CLOCK_MONOTONIC`), DIFFERENT from the Linux value (1) — the reason this
 * constant cannot be a single cross-platform definition and must carry its own `#os("macos")`
 * block.
 *
 * @since §16
 */
#os("macos")
pub const CLOCK_MONOTONIC: i32 = 6

/**
 * SYS_EXIT_GROUP — the x86_64 Linux syscall number for `exit_group(status)`, which terminates ALL
 * threads of the process with `status` (the correct process-exit primitive; plain `exit`/60 ends
 * only the calling thread). Part of `teko::sys`, the curated per-`#os`/`#arch` syscall-number
 * module the §16 raw-syscall intrinsic reads: every value is a literal Teko `const` transcribed
 * from the kernel ABI table (never a C header/macro), `#os`/`#arch` guarded so the §17 prune keeps
 * exactly the target's definition before the checker sees the others. x86_64 value: 231.
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_EXIT_GROUP: i64 = 231

/**
 * SYS_EXIT_GROUP — the aarch64 Linux syscall number for `exit_group(status)`. Value 94 (the
 * `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (231) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_EXIT_GROUP: i64 = 94

/**
 * SYS_WRITE — the x86_64 Linux syscall number for `write(fd, buf, count)`: writes `count` octets
 * from the buffer at `buf` to the open file descriptor `fd`, returning the octet count actually
 * written (or the negated errno on failure — the raw §16 §1.1 syscall-return convention). Part of
 * `teko::sys` (see `SYS_EXIT_GROUP`'s doc for the module's curation discipline). x86_64 value: 1
 * (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_WRITE: i64 = 1

/**
 * SYS_WRITE — the aarch64 Linux syscall number for `write(fd, buf, count)`. Value 64 (the
 * `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (1) — the reason this constant
 * cannot be a single cross-arch definition and must carry its own `#arch("aarch64")` block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_WRITE: i64 = 64

/**
 * SYS_CLOCK_GETTIME — the x86_64 Linux syscall number for `clock_gettime(clk_id, *tp)`, which fills
 * the caller-owned `struct timespec` at `*tp` with the current time for clock `clk_id` (the third
 * §16 raw-syscall crumb — the first to write DATA back through a struct pointer, exercising the
 * `ref_word` bridge (§1.2) together with the C1 `extern type = struct` header-less layout). Part of
 * `teko::sys` (see `SYS_EXIT_GROUP`'s doc for the module's curation discipline). x86_64 value: 228
 * (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_CLOCK_GETTIME: i64 = 228

/**
 * SYS_CLOCK_GETTIME — the aarch64 Linux syscall number for `clock_gettime(clk_id, *tp)`. Value 113
 * (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (228) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_CLOCK_GETTIME: i64 = 113

/**
 * SYS_GETRANDOM — the x86_64 Linux syscall number for `getrandom(buf, buflen, flags)`, which fills
 * the caller-owned buffer at `buf` with up to `buflen` octets of kernel entropy, returning the octet
 * count actually written (the fourth §16 raw-syscall crumb — a WRITABLE `ptr_word`-bridged buffer,
 * the same shape as `SYS_WRITE`'s READ-only buffer but mutated by the kernel instead of read from
 * it). Part of `teko::sys` (see `SYS_EXIT_GROUP`'s doc for the module's curation discipline).
 * x86_64 value: 318 (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_GETRANDOM: i64 = 318

/**
 * SYS_GETRANDOM — the aarch64 Linux syscall number for `getrandom(buf, buflen, flags)`. Value 278
 * (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (318) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_GETRANDOM: i64 = 278

/**
 * SYS_MMAP — the x86_64 Linux syscall number for `mmap(addr, length, prot, flags, fd, offset)`,
 * which creates a new page-aligned mapping in the calling process's address space, returning the
 * mapped address (or the negated errno in the `[-4095, -1]` band on failure — the raw §16 §1.1
 * syscall-return convention). Part of `teko::sys` (see `SYS_EXIT_GROUP`'s doc for the module's
 * curation discipline). The fifth §16 raw-syscall crumb — the arena-over-mmap keystone's backing
 * store (`docs/design/plano-s16-arena-mmap.md` §2). x86_64 value: 9
 * (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_MMAP: i64 = 9

/**
 * SYS_MMAP — the aarch64 Linux syscall number for `mmap(addr, length, prot, flags, fd, offset)`.
 * Value 222 (the `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (9) — the
 * reason this constant cannot be a single cross-arch definition and must carry its own
 * `#arch("aarch64")` block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_MMAP: i64 = 222

/**
 * SYS_MUNMAP — the x86_64 Linux syscall number for `munmap(addr, length)`, which releases a
 * mapping previously created by `mmap`, returning `0` on success (or the negated errno on
 * failure). Part of `teko::sys` (see `SYS_EXIT_GROUP`'s doc for the module's curation discipline).
 * x86_64 value: 11 (`arch/x86/entry/syscalls/syscall_64.tbl`).
 *
 * @since §16
 */
#os("linux") #arch("x86_64")
pub const SYS_MUNMAP: i64 = 11

/**
 * SYS_MUNMAP — the aarch64 Linux syscall number for `munmap(addr, length)`. Value 215 (the
 * `unistd.h` generic syscall table), DIFFERENT from the x86_64 value (11) — the reason this
 * constant cannot be a single cross-arch definition and must carry its own `#arch("aarch64")`
 * block.
 *
 * @since §16
 */
#os("linux") #arch("aarch64")
pub const SYS_MUNMAP: i64 = 215

/**
 * PROT_NONE — the `mmap`/`mprotect` protection flag requesting that the mapped pages be
 * inaccessible (no read, write, or execute). Part of `teko::sys`'s `PROT_*`/`MAP_*` flag family:
 * the Linux `asm-generic/mman-common.h` values, identical on every architecture (unlike the
 * `SYS_*` syscall numbers above), so each carries a single `#os("linux")` guard with no `#arch`
 * split. Value: 0.
 *
 * @since §16
 */
#os("linux")
pub const PROT_NONE: i64 = 0

/**
 * PROT_READ — the `mmap`/`mprotect` protection flag requesting that the mapped pages be
 * readable. See `PROT_NONE`'s doc for the flag family's cross-arch curation discipline.
 * Value: 1.
 *
 * @since §16
 */
#os("linux")
pub const PROT_READ: i64 = 1

/**
 * PROT_WRITE — the `mmap`/`mprotect` protection flag requesting that the mapped pages be
 * writable. See `PROT_NONE`'s doc for the flag family's cross-arch curation discipline.
 * Value: 2.
 *
 * @since §16
 */
#os("linux")
pub const PROT_WRITE: i64 = 2

/**
 * MAP_PRIVATE — the `mmap` flag requesting a private copy-on-write mapping: modifications are not
 * visible to other processes mapping the same underlying object, and are not carried through to
 * the underlying file (irrelevant for the anonymous mappings the §16 arena backing store uses,
 * but still REQUIRED — Linux rejects a mapping request naming neither `MAP_PRIVATE` nor
 * `MAP_SHARED`). See `PROT_NONE`'s doc for the flag family's cross-arch curation discipline.
 * Value: 2.
 *
 * @since §16
 */
#os("linux")
pub const MAP_PRIVATE: i64 = 2

/**
 * MAP_ANONYMOUS — the `mmap` flag requesting a mapping not backed by any file: the kernel
 * zero-fills the pages instead of reading them from `fd`, which must then be ignored (by
 * convention passed as `-1`). The arena-over-mmap keystone's backing store combines this with
 * `MAP_PRIVATE` for every allocation. See `PROT_NONE`'s doc for the flag family's cross-arch
 * curation discipline. Value: `0x20` (32).
 *
 * @since §16
 */
#os("linux")
pub const MAP_ANONYMOUS: i64 = 0x20

/**
 * MAP_FIXED — the `mmap` flag requesting the mapping be placed at EXACTLY the given `addr`
 * (discarding any existing mapping in that range), rather than treating `addr` as a mere hint.
 * Not used by this crumb's fixture (a plain hint-`0` mapping), but part of the curated flag
 * surface for the arena keystone's future fixed-address reservation path. See `PROT_NONE`'s doc
 * for the flag family's cross-arch curation discipline. Value: `0x10` (16).
 *
 * @since §16
 */
#os("linux")
pub const MAP_FIXED: i64 = 0x10
