use teko::encoding::json
use teko::list

/**
 * read_stdin_n — the syscall floor for the LSP transport: read EXACTLY `n` bytes from stdin
 * into an arena-owned `[]byte`, blocking until `n` bytes arrive or stdin hits EOF. The
 * returned slice's length is what was actually read (`n` on a full body, fewer on EOF
 * mid-body). It binds the maintained C runtime primitive `tk_rt_read_stdin_n`
 * (src/runtime/teko_rt.c) — the JSON-RPC / LSP base-protocol body is `Content-Length`-framed
 * with NO trailing newline, so the line reader cannot bound it; the caller reads exactly the
 * header's byte count. A `[]byte` return (the `tk_rt_secure_bytes` ABI shape) keeps this
 * brand-new primitive lowerable by the released bootstrap seed's frozen codegen.
 *
 * @param n  the exact number of body bytes to consume from stdin
 * @return   the bytes read; `.len == n` on a full body, `.len < n` on EOF mid-body
 * @since 0.3.1.0
 */
extern fn read_stdin_n(n: u64) -> []byte = "tk_rt_read_stdin_n" from "teko_rt"

/**
 * CRLF — the ASCII carriage-return + line-feed pair the LSP base protocol terminates every
 * header line with (and, doubled, separates the header block from the body).
 *
 * @since 0.3.1.0
 */
const CRLF: str = "\r\n"

/**
 * ascii_lower — the lowercase of a single ASCII byte (`A`..`Z` mapped to `a`..`z`), every other
 * byte unchanged. Used for the case-insensitive header field-name comparison the LSP base
 * protocol mandates.
 *
 * @param b  the byte to fold
 * @return   the lowercased byte
 * @since 0.3.1.0
 */
fn ascii_lower(b: byte) -> byte {
    if b >= b'A' && b <= b'Z' { return ((b to i64) + 32) to byte }
    b
}

/**
 * header_is_content_length — does the header line `line` name the `Content-Length` field,
 * compared case-insensitively up to the colon? A header line is `Field-Name: value`; this reads
 * the name (bytes before the first `:`) and folds both sides to lowercase.
 *
 * @param line  one header line, the trailing CRLF already stripped by the line reader
 * @return      true when the field name is `content-length`
 * @since 0.3.1.0
 */
fn header_is_content_length(line: str) -> bool {
    let name = "content-length"
    if line.len < name.len { return false }
    mut i: u64 = 0
    loop {
        if i >= name.len { break }
        if ascii_lower(line[i]) != name[i] { return false }
        i = i + 1
    }
    line[name.len] == b':'
}

/**
 * parse_header_value_u64 — the unsigned integer value of a `Field: N` header line, skipping the
 * field name (up to and including the first `:`) and any leading spaces, then reading the digit
 * run. A line with no digits after the colon yields `null` (a malformed length).
 *
 * @param line  the header line (CRLF stripped)
 * @return      the parsed value, or `null` when no digits follow the colon
 * @since 0.3.1.0
 */
fn parse_header_value_u64(line: str) -> u64 | null {
    mut i: u64 = 0
    loop {
        if i >= line.len { return null }
        if line[i] == b':' { i = i + 1; break }
        i = i + 1
    }
    loop {
        if i >= line.len || line[i] != b' ' { break }
        i = i + 1
    }
    if i >= line.len || line[i] < b'0' || line[i] > b'9' { return null }
    mut n: u64 = 0
    loop {
        if i >= line.len || line[i] < b'0' || line[i] > b'9' { break }
        n = n * 10 + ((line[i] to u64) - (b'0' to u64))
        i = i + 1
    }
    n
}

/**
 * body_to_message — validate the decoded body bytes and build the `RpcMessage`. The body must be
 * valid UTF-8 (the JSON door) and must parse as JSON; either failure is an honest transport
 * error, never a silent accept.
 *
 * @param body_bytes  the exact body bytes read for the frame
 * @return            the decoded message, or `error` on a UTF-8 / JSON fault
 * @throws            when the body is not valid UTF-8 or not valid JSON
 * @since 0.3.1.0
 */
fn body_to_message(body_bytes: []byte) -> RpcMessage | error {
    let text = match teko::text::str_from_utf8(body_bytes) {
        str as s => s
        error as e => return error { message = teko::str::concat("malformed frame: body is not UTF-8: ", e.message) }
    }
    let value = match json::decode(text) {
        json::JsonValue as v => v
        error as e => return error { message = teko::str::concat("malformed frame: body is not JSON: ", e.message) }
    }
    RpcMessage { body = value }
}

/**
 * find_crlf_crlf — the index of the first `CRLF CRLF` (header/body separator) in `bytes`, or
 * `null` when the four-byte sequence is absent. Pure scan, for `decode_frame_bytes` (the
 * stdin-free framing decoder the fixtures drive).
 *
 * @param bytes  the whole framed buffer
 * @return       the index of the first `\r` of the separator, or `null`
 * @since 0.3.1.0
 */
fn find_crlf_crlf(bytes: []byte) -> u64 | null {
    if bytes.len < 4 { return null }
    mut i: u64 = 0
    loop {
        if i + 4 > bytes.len { return null }
        if bytes[i] == b'\r' && bytes[i + 1] == b'\n' && bytes[i + 2] == b'\r' && bytes[i + 3] == b'\n' { return i }
        i = i + 1
    }
    null
}

/**
 * slice_bytes — a fresh `[]byte` holding `bytes[from..to]` (half-open). A small local copy since
 * there is no slice-of-slice builtin over `[]byte` here; the framing decoder needs the header and
 * body sub-ranges as independent buffers.
 *
 * @param bytes  the source buffer
 * @param from   the inclusive start index
 * @param to     the exclusive end index
 * @return       the copied sub-range
 * @since 0.3.1.0
 */
fn slice_bytes(bytes: []byte, from: u64, to: u64) -> []byte {
    mut out: []byte = teko::list::empty()
    mut i = from
    loop {
        if i >= to || i >= bytes.len { break }
        out = teko::list::push(out, bytes[i])
        i = i + 1
    }
    out
}

/**
 * content_length_of_header_bytes — scan the header block bytes for the `Content-Length` value.
 * The header block is ASCII; it is decoded to a `str`, split on CRLF, and each line offered to
 * the same case-insensitive field matcher `read_message` uses, so the two paths agree.
 *
 * @param header  the header-block bytes (everything before the CRLF CRLF separator)
 * @return        the declared body length, or `null` when no valid `Content-Length` is present
 * @since 0.3.1.0
 */
fn content_length_of_header_bytes(header: []byte) -> u64 | null {
    let text = match teko::text::str_from_utf8(header) { str as s => s; error => return null }
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= text.len {
            let last = teko::str::slice(text, start, text.len)
            if header_is_content_length(last) { return parse_header_value_u64(last) }
            break
        }
        if text[i] == b'\r' && i + 1 < text.len && text[i + 1] == b'\n' {
            let line = teko::str::slice(text, start, i)
            if header_is_content_length(line) { return parse_header_value_u64(line) }
            i = i + 2
            start = i
            continue
        }
        i = i + 1
    }
    null
}
