use teko::encoding::json
use teko::list

/**
 * jstr — a JSON string value wrapping `s`. A tiny constructor so the response builders read as
 * data, not boilerplate.
 *
 * @param s  the decoded string
 * @return   the JSON string value
 * @since 0.3.1.0
 */
fn jstr(s: str) -> json::JsonValue {
    json::JsonString { value = s }
}

/**
 * jnum — a JSON number value wrapping `v`. JSON has one numeric grammar (f64); integral values
 * re-encode without a fractional part (src/encoding/json/json.tks).
 *
 * @param v  the numeric value
 * @return   the JSON number value
 * @since 0.3.1.0
 */
fn jnum(v: f64) -> json::JsonValue {
    json::JsonNumber { value = v }
}

/**
 * jnull — the JSON `null` value. Used for a request `id` that was absent (a notification) and for
 * the `shutdown` result.
 *
 * @return  the JSON null value
 * @since 0.3.1.0
 */
fn jnull() -> json::JsonValue {
    json::JsonNull { }
}

/**
 * jbool — a JSON boolean value wrapping `b`. Used for capability flags the `initialize` result
 * advertises (`documentFormattingProvider: true`).
 *
 * @param b  the boolean value
 * @return   the JSON boolean value
 * @since 0.3.1.0 (LSP crumb B)
 */
fn jbool(b: bool) -> json::JsonValue {
    json::JsonBool { value = b }
}

/**
 * jobj — a JSON object from parallel `keys`/`values` slices, in the given order (the encoder
 * preserves source order, so responses are byte-deterministic and the fixtures can match exact
 * STDOUT).
 *
 * @param keys    the field names, in order
 * @param values  the field values, parallel to `keys`
 * @return        the JSON object value
 * @since 0.3.1.0
 */
fn jobj(keys: []str, values: []json::JsonValue) -> json::JsonValue {
    json::JsonObject { keys = keys; values = values }
}

/**
 * object_field — the value of `key` in `req` when `req` is a JSON object, else `null`. The one
 * accessor the dispatcher uses to read `method`/`id` off an incoming request.
 *
 * @param req  the request DOM
 * @param key  the field name
 * @return     the field value, or `null` when absent / `req` is not an object
 * @since 0.3.1.0
 */
fn object_field(req: json::JsonValue, key: str) -> json::JsonValue | null {
    match req {
        json::JsonObject as o => json::object_get(o, key)
        _ => null
    }
}

/**
 * as_str — the decoded string of a JSON string value, else `null`. Used to read the `method` name.
 *
 * @param v  the JSON value
 * @return   the string, or `null` when `v` is not a JSON string
 * @since 0.3.1.0
 */
fn as_str(v: json::JsonValue) -> str | null {
    match v {
        json::JsonString as s => s.value
        _ => null
    }
}

/**
 * request_id — the request's `id` value echoed back on a response, or JSON `null` when the message
 * carried none (a notification). LSP requires the response `id` to equal the request `id`.
 *
 * @param req  the request DOM
 * @return     the `id` value, or JSON `null`
 * @since 0.3.1.0
 */
fn request_id(req: json::JsonValue) -> json::JsonValue {
    match object_field(req, "id") {
        json::JsonValue as v => v
        null => jnull()
    }
}

/**
 * has_id — did the request carry an `id`? A JSON-RPC message with an `id` is a REQUEST (it expects
 * a response); one without is a NOTIFICATION (it must not be answered). The dispatcher answers an
 * unknown method only when it is a request.
 *
 * @param req  the request DOM
 * @return     true when an `id` field is present
 * @since 0.3.1.0
 */
fn has_id(req: json::JsonValue) -> bool {
    match object_field(req, "id") {
        json::JsonValue => true
        null => false
    }
}

/**
 * response — a JSON-RPC success response `{ "jsonrpc": "2.0", "id": <id>, "result": <result> }`.
 *
 * @param id      the request id echoed back
 * @param result  the result payload
 * @return        the response DOM
 * @since 0.3.1.0
 */
fn response(id: json::JsonValue, result: json::JsonValue) -> json::JsonValue {
    jobj(["jsonrpc", "id", "result"], [jstr("2.0"), id, result])
}

/**
 * error_response — a JSON-RPC error response `{ "jsonrpc": "2.0", "id": <id>, "error": { "code":
 * <code>, "message": <message> } }`. Used for an unknown method on a request (code -32601,
 * MethodNotFound).
 *
 * @param id       the request id echoed back
 * @param code     the JSON-RPC error code
 * @param message  the human-readable error text
 * @return         the error response DOM
 * @since 0.3.1.0
 */
fn error_response(id: json::JsonValue, code: i64, message: str) -> json::JsonValue {
    let err = jobj(["code", "message"], [jnum(code to f64), jstr(message)])
    jobj(["jsonrpc", "id", "error"], [jstr("2.0"), id, err])
}

/**
 * completion_options — the `initialize` result's `completionProvider` value: a `CompletionOptions`
 * object (the protocol requires an OBJECT here, never a bare boolean, unlike the other providers)
 * naming `.`/`:` as trigger characters — the field-access and namespace-path separators completion
 * is most useful right after.
 *
 * @return  the `CompletionOptions` DOM
 * @since 0.3.1.0 (LSP crumb G)
 */
fn completion_options() -> json::JsonValue {
    jobj(["triggerCharacters"], [jarr([jstr("."), jstr(":")])])
}

/**
 * initialize_result — the `initialize` response. Capabilities are HONEST: `textDocumentSync` is
 * announced as FULL (1) — the client pushes the whole buffer on every `didOpen`/`didChange`, which is
 * what `diagnose_document` re-checks (crumb A) — `documentFormattingProvider` is true, since the pure
 * `teko::fmt::format_source` answers whole-document formatting in-process (crumb B), and
 * `hoverProvider`/`definitionProvider` are true, since `hover_response`/`definition_response`
 * (crumb F) resolve the cursor against the symbol index. `completionProvider` (crumb G) names the
 * candidate-list answer `completion_response` gives over the SAME index. `serverInfo` names the
 * server and its build.
 *
 * @param id  the request id echoed back
 * @return    the `initialize` response DOM
 * @since 0.3.1.0
 */
fn initialize_result(id: json::JsonValue) -> json::JsonValue {
    let server_info = jobj(["name", "version"], [jstr("teko"), jstr(teko::env::version())])
    let capability_keys = ["textDocumentSync", "documentFormattingProvider", "hoverProvider", "definitionProvider", "completionProvider"]
    let capability_values = [jnum(1.0), jbool(true), jbool(true), jbool(true), completion_options()]
    let capabilities = jobj(capability_keys, capability_values)
    let result = jobj(["capabilities", "serverInfo"], [capabilities, server_info])
    response(id, result)
}

/**
 * DocRef — a document identity paired with its current buffer, as read off a `didOpen`/`didChange`
 * notification: the `uri` the diagnostics are published against and the `text` the front-end checks.
 * Under FULL text sync (the announced capability) both notifications carry the whole buffer, so the
 * server never reconstructs it from deltas.
 *
 * @since 0.3.1.0 (LSP crumb A)
 */
type DocRef = struct {
// the document URI the diagnostics are published against.
    uri: str
// the document's full current text.
    text: str
}

/**
 * str_field — the string value of `key` in `v` when `v` is a JSON object holding a string there,
 * else `null`. The one accessor the document-notification readers use to pull `uri`/`text` fields.
 *
 * @param v    the JSON value (expected to be an object)
 * @param key  the field name
 * @return     the field's string, or `null` when absent / not a string / `v` not an object
 * @since 0.3.1.0 (LSP crumb A)
 */
fn str_field(v: json::JsonValue, key: str) -> str | null {
    match object_field(v, key) {
        json::JsonValue as fv => as_str(fv)
        null => null
    }
}

/**
 * text_document_of — the `params.textDocument` object of a notification, or `null` when the message
 * carries no such object. The shared first hop of every document-notification reader.
 *
 * @param req  the notification DOM
 * @return     the `textDocument` object, or `null`
 * @since 0.3.1.0 (LSP crumb A)
 */
fn text_document_of(req: json::JsonValue) -> json::JsonValue | null {
    let params = match object_field(req, "params") { json::JsonValue as v => v; null => return null }
    object_field(params, "textDocument")
}

/**
 * open_doc — the `DocRef` of a `textDocument/didOpen` notification: `params.textDocument.uri` and
 * `params.textDocument.text`. Returns `null` when either field is missing (a malformed open, which
 * the dispatcher then simply does not answer).
 *
 * @param req  the `didOpen` DOM
 * @return     the opened document, or `null`
 * @since 0.3.1.0 (LSP crumb A)
 */
fn open_doc(req: json::JsonValue) -> DocRef | null {
    let td = match text_document_of(req) { json::JsonValue as v => v; null => return null }
    let uri = match str_field(td, "uri") { str as s => s; null => return null }
    let text = match str_field(td, "text") { str as s => s; null => return null }
    DocRef { uri = uri; text = text }
}

/**
 * change_doc — the `DocRef` of a `textDocument/didChange` notification under FULL sync: the `uri`
 * from `params.textDocument` and the whole buffer from the LAST entry of `params.contentChanges`
 * (full sync sends one change carrying the complete text; the last entry is the newest). Returns
 * `null` when the uri or a change text is missing.
 *
 * @param req  the `didChange` DOM
 * @return     the changed document, or `null`
 * @since 0.3.1.0 (LSP crumb A)
 */
fn change_doc(req: json::JsonValue) -> DocRef | null {
    let td = match text_document_of(req) { json::JsonValue as v => v; null => return null }
    let uri = match str_field(td, "uri") { str as s => s; null => return null }
    let params = match object_field(req, "params") { json::JsonValue as v => v; null => return null }
    let changes = match object_field(params, "contentChanges") { json::JsonValue as v => v; null => return null }
    match changes {
        json::JsonArray as arr => {
            if arr.items.len == 0 { return null }
            let last = arr.items[arr.items.len - 1]
            match str_field(last, "text") { str as s => DocRef { uri = uri; text = s }; null => null }
        }
        _ => null
    }
}

/**
 * close_uri — the `uri` of a `textDocument/didClose` notification, or `null` when absent. On close
 * the server publishes an EMPTY diagnostics list for that uri to clear the client's squiggles.
 *
 * @param req  the `didClose` DOM
 * @return     the closed document's uri, or `null`
 * @since 0.3.1.0 (LSP crumb A)
 */
fn close_uri(req: json::JsonValue) -> str | null {
    let td = match text_document_of(req) { json::JsonValue as v => v; null => return null }
    str_field(td, "uri")
}

/**
 * one_message — a one-element outgoing list holding `v`. The dispatcher returns a LIST of messages
 * (a response plus any pushed notification), so the single-response cases spell their list once here.
 *
 * @param v  the single message to send
 * @return   a one-element outgoing list
 * @since 0.3.1.0 (LSP crumb A)
 */
fn one_message(v: json::JsonValue) -> []json::JsonValue {
    teko::list::push(teko::list::empty(), v)
}

/**
 * no_messages — the empty outgoing list, for a notification the server answers with nothing.
 *
 * @return  an empty outgoing list
 * @since 0.3.1.0 (LSP crumb A)
 */
fn no_messages() -> []json::JsonValue {
    teko::list::empty()
}

/**
 * DocStore — the server's open-document set: the unsaved buffers the client is the source of truth
 * for, held as two PARALLEL slices (a `uri` and its current `text` at the same index). A request that
 * carries no buffer of its own — `textDocument/formatting` — reads the text from here rather than the
 * (possibly stale) disk. Kept as parallel slices because the corpus has no map builtin; the set is
 * small (open editors, not edits), so a linear scan is ample.
 *
 * @since 0.3.1.0 (LSP crumb B)
 */
type DocStore = struct {
// the open documents' URIs, parallel to `texts`.
    uris: []str
// each open document's current full text, parallel to `uris`.
    texts: []str
}

/**
 * Dispatch — one handled message's TWO outputs: the (possibly updated) document store and the list
 * of messages to write back. Threading the store through the return keeps the server functional — the
 * loop carries the store forward without a mutable global.
 *
 * @since 0.3.1.0 (LSP crumb B)
 */
type Dispatch = struct {
// the document store after handling the message.
    store: DocStore
// the messages to frame and write (a response and/or a notification; empty for silence).
    out: []json::JsonValue
}

/**
 * store_empty — the initial empty document store.
 *
 * @return  a store with no open documents
 * @since 0.3.1.0 (LSP crumb B)
 */
fn store_empty() -> DocStore {
    DocStore { uris = teko::list::empty(); texts = teko::list::empty() }
}

/**
 * store_put — the store with `uri` now holding `text`: the existing entry's text is replaced when the
 * document is already open, else a new entry is appended. Rebuilt (rather than mutated in place) to
 * keep the value semantics; the set is small.
 *
 * @param store  the current store
 * @param uri    the document URI
 * @param text   the document's new full text
 * @return       the updated store
 * @since 0.3.1.0 (LSP crumb B)
 */
fn store_put(store: DocStore, uri: str, text: str) -> DocStore {
    mut uris: []str = teko::list::empty()
    mut texts: []str = teko::list::empty()
    mut found = false
    mut i: u64 = 0
    loop {
        if i >= store.uris.len { break }
        uris = teko::list::push(uris, store.uris[i])
        if store.uris[i] == uri {
            texts = teko::list::push(texts, text)
            found = true
        } else {
            texts = teko::list::push(texts, store.texts[i])
        }
        i = i + 1
    }
    if !found {
        uris = teko::list::push(uris, uri)
        texts = teko::list::push(texts, text)
    }
    DocStore { uris = uris; texts = texts }
}

/**
 * store_get — the current text of the document `uri`, or `null` when it is not open. The single read
 * `format_response` makes to recover the buffer a formatting request does not carry.
 *
 * @param store  the current store
 * @param uri    the document URI
 * @return       the document's text, or `null` when absent
 * @since 0.3.1.0 (LSP crumb B)
 */
fn store_get(store: DocStore, uri: str) -> str | null {
    mut i: u64 = 0
    loop {
        if i >= store.uris.len { break }
        if store.uris[i] == uri { return store.texts[i] }
        i = i + 1
    }
    null
}

/**
 * store_remove — the store with the document `uri` dropped (a `didClose`), rebuilt without its entry.
 * A uri that is not open is a no-op.
 *
 * @param store  the current store
 * @param uri    the document URI to drop
 * @return       the store without `uri`
 * @since 0.3.1.0 (LSP crumb B)
 */
fn store_remove(store: DocStore, uri: str) -> DocStore {
    mut uris: []str = teko::list::empty()
    mut texts: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= store.uris.len { break }
        if store.uris[i] != uri {
            uris = teko::list::push(uris, store.uris[i])
            texts = teko::list::push(texts, store.texts[i])
        }
        i = i + 1
    }
    DocStore { uris = uris; texts = texts }
}

/**
 * dispatch_of — a `Dispatch` pairing `store` with the outgoing `out`. The single constructor every
 * dispatch arm returns through, so the store is never forgotten on a branch.
 *
 * @param store  the store to carry forward
 * @param out    the messages to write
 * @return       the paired dispatch
 * @since 0.3.1.0 (LSP crumb B)
 */
fn dispatch_of(store: DocStore, out: []json::JsonValue) -> Dispatch {
    Dispatch { store = store; out = out }
}

/**
 * open_dispatch — handle a `didOpen`: record the buffer in the store and push the buffer's
 * diagnostics. A malformed open (no `DocRef`) leaves the store untouched and answers nothing.
 *
 * @param store  the current store
 * @param req    the `didOpen` DOM
 * @return       the updated store and the `publishDiagnostics` notification (or nothing)
 * @since 0.3.1.0 (LSP crumb B)
 */
fn open_dispatch(store: DocStore, req: json::JsonValue) -> Dispatch {
    match open_doc(req) {
        DocRef as d => dispatch_of(store_put(store, d.uri, d.text), one_message(diagnostics_notification(d.uri, d.text)))
        null => dispatch_of(store, no_messages())
    }
}

/**
 * change_dispatch — handle a `didChange`: update the stored buffer and re-publish diagnostics,
 * mirroring `open_dispatch` for the changed document.
 *
 * @param store  the current store
 * @param req    the `didChange` DOM
 * @return       the updated store and the `publishDiagnostics` notification (or nothing)
 * @since 0.3.1.0 (LSP crumb B)
 */
fn change_dispatch(store: DocStore, req: json::JsonValue) -> Dispatch {
    match change_doc(req) {
        DocRef as d => dispatch_of(store_put(store, d.uri, d.text), one_message(diagnostics_notification(d.uri, d.text)))
        null => dispatch_of(store, no_messages())
    }
}

/**
 * close_dispatch — handle a `didClose`: drop the document from the store and publish an EMPTY
 * diagnostics list to clear the client's squiggles for it.
 *
 * @param store  the current store
 * @param req    the `didClose` DOM
 * @return       the store without the document and the clearing notification (or nothing)
 * @since 0.3.1.0 (LSP crumb B)
 */
fn close_dispatch(store: DocStore, req: json::JsonValue) -> Dispatch {
    match close_uri(req) {
        str as uri => dispatch_of(store_remove(store, uri), one_message(publish_diagnostics(uri, teko::list::empty())))
        null => dispatch_of(store, no_messages())
    }
}

/**
 * Pos — a 0-based document position (line and character), for the full-document range a formatting
 * `TextEdit` replaces.
 *
 * @since 0.3.1.0 (LSP crumb B)
 */
type Pos = struct {
// the 0-based line.
    line: u32
// the 0-based character.
    col: u32
}

/**
 * end_position_of — the 0-based position just past the LAST character of `text` (the line count of
 * newlines seen, and the length of the final line). It is the end of the whole-document range a
 * formatting edit replaces, so `format_response` can substitute the entire buffer with one `TextEdit`.
 *
 * @param text  the document text
 * @return      the position at the end of the document
 * @since 0.3.1.0 (LSP crumb B)
 */
fn end_position_of(text: str) -> Pos {
    mut line: u32 = 0
    mut col: u32 = 0
    mut i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            line = line + 1
            col = 0
        } else {
            col = col + 1
        }
        i = i + 1
    }
    Pos { line = line; col = col }
}

/**
 * text_edit_full — one LSP `TextEdit` that replaces the WHOLE document (`text`) with `new_text`: the
 * range runs from the document start (0, 0) to `end_position_of(text)`. The formatter is whole-file by
 * design, so a single full-range edit is the exact shape the client applies.
 *
 * @param text      the current document text (for the end of the replaced range)
 * @param new_text  the formatted replacement text
 * @return          the JSON `TextEdit`
 * @since 0.3.1.0 (LSP crumb B)
 */
fn text_edit_full(text: str, new_text: str) -> json::JsonValue {
    let ep = end_position_of(text)
    let range = jobj(["start", "end"], [encode_position(0, 0), encode_position(ep.line, ep.col)])
    jobj(["range", "newText"], [range, jstr(new_text)])
}

/**
 * format_uri — the `params.textDocument.uri` of a `textDocument/formatting` request, or `null` when
 * absent. The formatting request identifies the document but does NOT carry its text — the server
 * recovers the text from the store.
 *
 * @param req  the formatting request DOM
 * @return     the document URI, or `null`
 * @since 0.3.1.0 (LSP crumb B)
 */
fn format_uri(req: json::JsonValue) -> str | null {
    let td = match text_document_of(req) { json::JsonValue as v => v; null => return null }
    str_field(td, "uri")
}

/**
 * format_response — answer a `textDocument/formatting` request: recover the document's text from the
 * store, run the pure `teko::fmt::format_source` over it IN-PROCESS, and reply with a one-element
 * `TextEdit[]` replacing the whole buffer with the formatted text. A document that is not open, or one
 * the formatter refuses (a parse error / a non-canonicalizable stream), yields a `null` result — the
 * protocol's "no edits" — never a corrupt edit. The store is unchanged (formatting reads, never
 * writes).
 *
 * @param store  the current store (read for the document text)
 * @param req    the formatting request DOM
 * @return       the store (unchanged) and the `TextEdit[]`-or-null response
 * @since 0.3.1.0 (LSP crumb B)
 */
fn format_response(store: DocStore, req: json::JsonValue) -> Dispatch {
    let id = request_id(req)
    let uri = match format_uri(req) { str as u => u; null => return dispatch_of(store, one_message(response(id, jnull()))) }
    let text = match store_get(store, uri) { str as t => t; null => return dispatch_of(store, one_message(response(id, jnull()))) }
    match teko::fmt::format_source(text) {
        str as formatted => dispatch_of(store, one_message(response(id, jarr(one_message(text_edit_full(text, formatted))))))
        error => dispatch_of(store, one_message(response(id, jnull())))
    }
}

/**
 * write_all — frame and write every message of `msgs` to stdout, in order. The dispatcher returns a
 * response plus any pushed notification as one list; this drains it to the wire.
 *
 * @param msgs  the outgoing messages, in send order
 * @since 0.3.1.0 (LSP crumb A)
 */
fn write_all(msgs: []json::JsonValue) -> void {
    mut i: u64 = 0
    loop {
        if i >= msgs.len { break }
        write_message(msgs[i])
        i = i + 1
    }
}
