/**
 * RpcMessage — one decoded JSON-RPC / LSP / DAP message: the raw `Content-Length`-framed body
 * already parsed into a `JsonValue` DOM (src/encoding/json/json.tks). LSP and DAP share this
 * one transport shape, so this type is the substrate both tracks read and write.
 *
 * @since 0.3.1.0
 * @see read_message
 */
pub type RpcMessage = struct {
// the message body: the framed JSON payload parsed into the JSON DOM.
    body: json::JsonValue
}

/**
 * encode_frame — frame `body` per the LSP/DAP base protocol: the `Content-Length` header (the
 * body's exact byte length), a blank CRLF line, then the encoded JSON body. Encoding a
 * `JsonValue` is total (src/encoding/json/json.tks), so this cannot fail. The byte length is
 * the encoded string's `.len` (JSON is UTF-8, so byte count is the wire count).
 *
 * @param body  the response / notification payload to frame
 * @return      the complete `Content-Length`-framed wire message
 * @since 0.3.1.0
 */
pub fn encode_frame(body: json::JsonValue) -> str {
    let payload = json::encode(body)
    teko::str::concat("Content-Length: ", teko::u64_to_str(payload.len), CRLF, CRLF, payload)
}

/**
 * write_message — frame `body` and write it to stdout with a RAW byte write, never through
 * `println`. A newline-appending or unframed write would corrupt the JSON-RPC stream: the base
 * protocol demands a pure `Content-Length` frame with nothing between messages. Every log /
 * diagnostic goes to stderr (`log`), never stdout.
 *
 * @param body  the payload to frame and emit on stdout
 * @since 0.3.1.0
 */
pub fn write_message(body: json::JsonValue) -> void {
    teko::io::write(encode_frame(body))
}

/**
 * log — write a diagnostic line to STDERR, never stdout. The transport invariant: stdout carries
 * only framed JSON-RPC, so any log on stdout would corrupt the stream (proven in the design). A
 * trailing newline is added; stderr is free-form.
 *
 * @param msg  the diagnostic text
 * @since 0.3.1.0
 */
pub fn log(msg: str) -> void {
    teko::io::eprintln(teko::str::concat("teko-lsp: ", msg))
}

/**
 * read_message — read ONE `Content-Length`-framed message from stdin, blocking until the whole
 * body is available. Header lines are read with the line reader (each terminated by CRLF, which
 * the reader strips) until a blank line ends the header block; the `Content-Length` header sets
 * the exact body byte count, read with `read_stdin_n`. A body shorter than the declared length
 * (EOF mid-body) is a truncated frame — a hard error, never a silent accept.
 *
 * @return  the decoded message, or `error` on EOF before a frame / a malformed frame
 * @throws  `error { message = "eof" }` at a clean end of input; a `malformed frame: ...` error
 *          when the header is absent / the length is unparseable / the body is truncated
 * @since 0.3.1.0
 */
pub fn read_message() -> RpcMessage | error {
    mut have_len = false
    mut content_length: u64 = 0
    mut saw_header = false
    loop {
        let line = teko::io::read_line()
        if line.len == 0 {
            if !saw_header && teko::io::stdin_eof() { return error { message = "eof" } }
            break
        }
        saw_header = true
        if header_is_content_length(line) {
            match parse_header_value_u64(line) {
                u64 as n => { content_length = n; have_len = true }
                null => { return error { message = "malformed frame: unparseable Content-Length" } }
            }
        }
    }
    if !have_len { return error { message = "malformed frame: missing Content-Length" } }
    let body_bytes = read_stdin_n(content_length)
    if body_bytes.len < content_length { return error { message = "malformed frame: truncated body" } }
    body_to_message(body_bytes)
}

/**
 * decode_frame_bytes — decode ONE complete `Content-Length`-framed message already sitting in a
 * `[]byte` buffer (the stdin-free twin of `read_message`, which the regression fixtures drive so
 * the framing is proven by matching printed STDOUT, not by an exit code). Finds the header/body
 * separator, reads the `Content-Length`, and requires the buffer to actually carry that many body
 * bytes — a short buffer is a truncated frame, the same hard error `read_message` raises.
 *
 * @param bytes  the whole framed buffer
 * @return       the decoded message, or `error` on a malformed / truncated frame
 * @throws       `malformed frame: ...` when the separator / length is absent or the body is short
 * @since 0.3.1.0
 */
pub fn decode_frame_bytes(bytes: []byte) -> RpcMessage | error {
    let sep = match find_crlf_crlf(bytes) {
        u64 as s => s
        null => return error { message = "malformed frame: no header/body separator" }
    }
    let header = slice_bytes(bytes, 0, sep)
    let content_length = match content_length_of_header_bytes(header) {
        u64 as n => n
        null => return error { message = "malformed frame: missing Content-Length" }
    }
    let body_start = sep + 4
    if body_start + content_length > bytes.len { return error { message = "malformed frame: truncated body" } }
    body_to_message(slice_bytes(bytes, body_start, body_start + content_length))
}
