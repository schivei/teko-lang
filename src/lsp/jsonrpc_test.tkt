use teko::encoding::json

/**
 * body_field_str — the string value of `key` in a decoded message body, or "" when absent / not a
 * string. Used to read a round-tripped `method` back out.
 *
 * @param m    the decoded message
 * @param key  the field name
 * @return     the field's string value, or ""
 */
fn body_field_str(m: RpcMessage, key: str): str {
    match m.body {
        json::JsonObject as o => match json::object_get(o, key) {
            json::JsonValue as v => match v { json::JsonString as s => s.value; _ => "" }
            null => ""
        }
        _ => ""
    }
}

#test
/**
 * encode_frame_prepends_content_length — a body of nine bytes frames to the exact
 * `Content-Length: 9\r\n\r\n{"m":"x"}` wire message, proving the header count and the CRLF CRLF
 * separator.
 */
fn encode_frame_prepends_content_length() {
    var body = match json::decode("{\"m\":\"x\"}") { json::JsonValue as v => v; error => json::JsonNull { } }
    teko::assert::eq_str(encode_frame(body), "Content-Length: 9\r\n\r\n{\"m\":\"x\"}")
}

#test
/**
 * decode_frame_round_trips — a framed request decodes back to its body, and the `method` field
 * survives the round trip.
 */
fn decode_frame_round_trips() {
    var frame = "Content-Length: 34\r\n\r\n{\"method\":\"initialize\",\"id\":1}"
    var msg = match decode_frame_bytes(teko::text::bytes_of_str(frame)) { RpcMessage as m => m; error as e => { teko::assert::eq_str(e.message, "no error expected"); return } }
    teko::assert::eq_str(body_field_str(msg, "method"), "initialize")
}

#test
/**
 * decode_frame_rejects_truncated_body — a frame whose `Content-Length` exceeds the bytes actually
 * present is a truncated frame: decoding raises the honest `malformed frame: truncated body` error
 * rather than silently accepting a short body.
 */
fn decode_frame_rejects_truncated_body() {
    var frame = "Content-Length: 50\r\n\r\n{\"method\":\"x\"}"
    match decode_frame_bytes(teko::text::bytes_of_str(frame)) {
        RpcMessage => teko::assert::eq_str("accepted a truncated frame", "should have been rejected")
        error as e => teko::assert::eq_str(e.message, "malformed frame: truncated body")
    }
}

#test
/**
 * decode_frame_rejects_missing_separator — a buffer with no CRLF CRLF header/body separator is a
 * malformed frame, rejected by its own honest error.
 */
fn decode_frame_rejects_missing_separator() {
    match decode_frame_bytes(teko::text::bytes_of_str("Content-Length: 2\r\n{}")) {
        RpcMessage => teko::assert::eq_str("accepted a frame with no separator", "should have been rejected")
        error as e => teko::assert::eq_str(e.message, "malformed frame: no header/body separator")
    }
}
