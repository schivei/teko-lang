/**
 * SG_ROOTS — the `.tkt` corpus roots this guard walks. Read from the repository root, which is where
 * the test gate runs.
 */
const SG_ROOTS: str = "src"

/**
 * SG_SELF — the ONE file the scan skips: this one.
 *
 * A guard that names violations has to be able to SPELL them, and its inversion below spells three.
 * Exempting the rule's own declaration is the only way the rule can be tested at all; exempting
 * anything else would be the blindness this guard exists to replace, so the exemption is a single
 * named path and the inversion proves the predicate still bites everywhere it is applied.
 */
const SG_SELF: str = "src/test/scratch_guard_test.tkt"

/**
 * SG_WRAPPER — the ONE composer a test scratch path must pass through. A literal that is not the
 * direct argument of this call is a path two tests can derive identically.
 */
const SG_WRAPPER: str = "teko::test::scoped(\""

/**
 * sg_scratch_prefixes — the SCRATCH NAMESPACE: the path prefixes that mark a path a test WRITES,
 * as opposed to one it merely computes and compares.
 *
 * THE NAMESPACE IS DOTTED, AND THAT IS THE WHOLE TRICK. Deciding "does this literal get written?" from
 * the text is undecidable — `project_binary_path_test.tkt` compares against `"bin/teko"` nine times
 * and writes nothing. So the rule is inverted: a path a test writes must LIVE in a namespace reserved
 * for scratch, and the namespace is spelled with a leading dot (`bin/.…`, `.regr-…`, `/tmp/.…`). The
 * probe binaries were RENAMED into it (`bin/pt-probe` → `bin/.pt-probe`) rather than the rule being
 * widened to chase their spelling — the rule follows the need, not the string.
 *
 * `.teko-` JOINED THE LIST for the opposite reason, and the distinction matters: the Windows leg
 * independently moved the verdict-channel tests off `/tmp` (which Windows has not) onto
 * working-directory names of exactly this shape, arriving at the same convention from a different
 * defect. That is a NEED the rule did not yet cover, so the rule grew — the alternative would have
 * been to leave a whole family of real scratch files outside the guard because of a spelling.
 *
 * @return the prefixes that mark a scratch path
 */
fn sg_scratch_prefixes() -> []str {
    mut p: []str = teko::list::push(teko::list::empty(), "bin/.")
    p = teko::list::push(p, ".regr-")
    p = teko::list::push(p, ".teko-")
    p = teko::list::push(p, "/tmp/.")
    p
}

/**
 * sg_every_scratch_literal_is_scoped — THE GUARD, and it is the half that closes the defect.
 *
 * Isolating one resource fixes one resource. This rejects the NEXT one: a `.tkt` that hard-codes a
 * scratch path which a second test could spell the same way. Under the round-robin shard split those
 * two tests land in different PROCESSES — and neighbouring tests are exactly the ones that share a
 * path, because they live in the same file and family.
 *
 * @throws when a `.tkt` carries a scratch literal that is not `teko::test::scoped`'s direct argument
 */
#test
fn sg_every_scratch_literal_is_scoped() {
    let bad = sg_unscoped_in_tree(SG_ROOTS)
    teko::assert::is_present(teko::str::concat("no unscoped scratch literal (found: ", bad, ")"), bad.len == 0)
}

/**
 * sg_the_guard_rejects_a_planted_violation — THE INVERSION, and it is not optional.
 *
 * Three times on this lane a guard answered ZERO on a tree that was still broken, because it was BLIND
 * rather than tolerant. A guard that cannot fail is decoration. So the predicate is fed a line that
 * violates the rule and must say so, and a line that obeys it and must not.
 */
#test
fn sg_the_guard_rejects_a_planted_violation() {
    teko::assert::is_true(sg_line_violates("    let w = \".regr-pool-planted\"", sg_scratch_needles()))
    teko::assert::is_true(sg_line_violates("    let p = \"bin/.regr-work/planted\"", sg_scratch_needles()))
    teko::assert::is_true(sg_line_violates("    let c = \"/tmp/.planted.chan\"", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let w = teko::test::scoped(\".regr-pool-planted\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let p = teko::test::scoped(\"bin/.regr-work/planted\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    teko::assert::eq_str(bin_path_for(t), \"bin/teko\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let x = \"out/x\"", sg_scratch_needles()))
}

/**
 * sg_two_tests_never_derive_the_same_path — the other half of the claim, stated as a property rather
 * than as a scan: the SAME base, composed by two different test identities, is two different paths.
 *
 * `base` IS NOW THE SUFFIX, NOT THE PREFIX (journal J2): `teko::test::scoped` delegates to
 * `teko::journal::scratch`, which roots the composed path under this run and this test's own identity
 * and leaves `base` as the TAIL — `<run_root>/<writer>/<base>`, not `<base><scope>`. The identity that
 * used to be appended is now the part that comes first.
 *
 * Proved here against this test's own live identity and a recorded neighbour's, so the property is
 * measured at run time rather than argued from the composer's source.
 */
#test
fn sg_two_tests_never_derive_the_same_path() {
    let mine = teko::test::scoped(".regr-shared-base")
    teko::assert::ne_str(mine, ".regr-shared-base")
    teko::assert::str_ends_with(mine, ".regr-shared-base")
    teko::assert::str_contains(mine, "sg_two_tests_never_derive_the_same_path")
}

/**
 * sg_unscoped_in_tree — the first offending `<file>:<line>` under `root`, or "" when the tree obeys
 * the rule. Names the FILE and the LINE, never a count: a count cannot be acted on.
 *
 * @param root  the directory to walk
 * @return      `<path>: <line>` for the first violation, or ""
 */
fn sg_unscoped_in_tree(root: str) -> str {
    let entries = match teko::fs::list_dir(root) { []str as e => e; error => teko::list::empty() }
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let full = teko::str::concat(root, "/", entries[i])
        let hit = if sg_is_tkt(entries[i]) { sg_scan_unless_self(full) } else { sg_unscoped_in_tree(full) }
        if hit.len > 0 { return hit }
        i = i + 1
    }
    ""
}

/**
 * sg_scan_unless_self — scan `path` unless it is this guard's own file (see `SG_SELF`).
 *
 * @param path  the `.tkt` to scan
 * @return      `<path>: <line>` for the first violation, or ""
 */
fn sg_scan_unless_self(path: str) -> str {
    if path == SG_SELF { return "" }
    sg_unscoped_in_file(path)
}

/**
 * sg_is_tkt — whether `name` is a `.tkt` test file.
 *
 * @param name  a directory entry's name
 * @return      true iff it ends in `.tkt`
 */
fn sg_is_tkt(name: str) -> bool { teko::str::ends_with(name, ".tkt") }

/**
 * sg_unscoped_in_file — the first offending `<path>: <line>` in one file, or "".
 *
 * A file that cannot be read is NOT silently clean: an unreadable `.tkt` is reported as the violation
 * it might be hiding, because the safe reading of "I could not check" is never "it is fine".
 *
 * @param path  the file to scan
 * @return      `<path>: <line>` for the first violation, or ""
 */
fn sg_unscoped_in_file(path: str) -> str {
    let text = match teko::io::read_file(path) { str as s => s; error => return teko::str::concat(path, ": unreadable") }
    if !sg_text_mentions_scratch(text) { return "" }
    let bad = sg_first_violating_line(text, sg_scratch_needles())
    if bad.len == 0 { return "" }
    teko::str::concat(path, ": ", bad)
}

/**
 * sg_first_violating_line — the first offending LINE of `text`, or "".
 *
 * Walks the text by index and slices one line at a time instead of building a list of every line.
 * That is not a micro-optimisation: `teko::list::push` copies, so a list of a 1400-line file is
 * quadratic in the file, and the five files that reach this point are the biggest `.tkt` in the tree.
 *
 * @param text     the file's whole text
 * @param needles  the quote-prefixed scratch prefixes, built ONCE by the caller
 * @return         the offending line, or "" when there is none
 */
fn sg_first_violating_line(text: str, needles: []str) -> str {
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            let line = teko::str::slice(text, start, i)
            if sg_line_violates(line, needles) { return line }
            start = i + 1
        }
        i = i + 1
    }
    if start >= text.len { return "" }
    let last = teko::str::slice(text, start, text.len)
    if sg_line_violates(last, needles) { return last }
    ""
}

/**
 * sg_text_mentions_scratch — whether the WHOLE file text names the scratch namespace at all: three
 * substring scans, no allocation, no line list.
 *
 * MEASURED, and this is why it exists: splitting every `.tkt` into a line LIST first cost the suite
 * 95.6 s against 20.7 s before this guard existed — the push-per-line is quadratic in the file, and
 * almost every file has no scratch literal to find. The fast reject brings the whole guard under the
 * noise floor while leaving the exact per-line answer for the files that do mention one, which are the
 * only ones whose offending LINE anybody needs named.
 *
 * @param text  the file's whole text
 * @return      true iff any scratch prefix appears anywhere in it
 */
fn sg_text_mentions_scratch(text: str) -> bool {
    let prefixes = sg_scratch_prefixes()
    mut i: u64 = 0
    loop {
        if i >= prefixes.len { break }
        if teko::str::contains(text, prefixes[i]) { return true }
        i = i + 1
    }
    false
}

/**
 * sg_line_violates — whether one source line carries a scratch literal that is NOT wrapped.
 *
 * The test is deliberately coarse in ONE direction only: a line that mentions the wrapper at all is
 * accepted, because a line can hold at most a handful of literals and mixing a wrapped and an unwrapped
 * one on the same line is a shape no reviewer would let through anyway. Coarse the other way — accepting
 * a line merely because it looked like a comparison — is what would make the guard blind, so that is
 * not done.
 *
 * @param line     one source line
 * @param needles  the quote-prefixed scratch prefixes, built ONCE by the caller
 * @return         true iff it hard-codes a scratch path
 */
fn sg_line_violates(line: str, needles: []str) -> bool {
    if teko::str::contains(line, SG_WRAPPER) { return false }
    sg_line_has_literal(line, needles)
}

/**
 * sg_scratch_needles — the scratch prefixes with their opening quote already attached.
 *
 * Built once per FILE rather than once per line. The per-line spelling allocated a three-element list
 * and three concatenations for every line of every scanned file — a cost that does not show up in a
 * unit test and does show up in the suite's wall clock, which is the kind of thing this lane measures
 * rather than assumes.
 *
 * @return the literal-opening needles to search for
 */
fn sg_scratch_needles() -> []str {
    let prefixes = sg_scratch_prefixes()
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prefixes.len { break }
        out = teko::list::push(out, teko::str::concat("\"", prefixes[i]))
        i = i + 1
    }
    out
}

/**
 * sg_line_has_literal — whether `line` opens a string literal with any of `needles`.
 *
 * @param line     the source line
 * @param needles  the quote-prefixed scratch prefixes
 * @return         true iff one of them appears
 */
fn sg_line_has_literal(line: str, needles: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= needles.len { break }
        if teko::str::contains(line, needles[i]) { return true }
        i = i + 1
    }
    false
}
