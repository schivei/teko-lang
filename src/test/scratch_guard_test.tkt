const SG_ROOTS: str = "src"

const SG_SELF: str = "src/test/scratch_guard_test.tkt"

const SG_WRAPPER: str = "teko::test::scoped(\""

const SG_WRAPPER_SCRATCH: str = "teko::journal::scratch(\""

fn sg_scratch_prefixes(): []str {
    var p: []str = teko::list::push(teko::list::empty(), "bin/.")
    p = teko::list::push(p, ".regr-")
    p = teko::list::push(p, ".teko-")
    p = teko::list::push(p, "/tmp/.")
    p
}

#test
fn sg_every_scratch_literal_is_scoped() {
    var bad = sg_unscoped_in_tree(SG_ROOTS)
    teko::assert::is_present(teko::str::concat("no unscoped scratch literal (found: ", bad, ")"), bad.len == 0)
}

#test
fn sg_the_guard_rejects_a_planted_violation() {
    teko::assert::is_true(sg_line_violates("    let w = \".regr-pool-planted\"", sg_scratch_needles()))
    teko::assert::is_true(sg_line_violates("    let p = \"bin/.regr-work/planted\"", sg_scratch_needles()))
    teko::assert::is_true(sg_line_violates("    let c = \"/tmp/.planted.chan\"", sg_scratch_needles()))
    teko::assert::is_true(sg_line_violates("    let q = \"bin/.regr-work/.toolquery-planted\"", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let w = teko::test::scoped(\".regr-pool-planted\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let p = teko::test::scoped(\"bin/.regr-work/planted\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let q = teko::journal::scratch(\"bin/.regr-work/.toolquery-planted\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    teko::assert::eq_str(bin_path_for(t), \"bin/teko\")", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("    let x = \"out/x\"", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("pub const TKRUN_DIR: str = \"bin/.tkrun\"", sg_scratch_needles()))
    teko::assert::is_false(sg_line_violates("const TOOL_QUERY_PREFIX: str = \"bin/.regr-work/.toolquery\"", sg_scratch_needles()))
}

#test
fn sg_two_tests_never_derive_the_same_path() {
    var mine = teko::test::scoped(".regr-shared-base")
    teko::assert::ne_str(mine, ".regr-shared-base")
    teko::assert::str_ends_with(mine, ".regr-shared-base")
    teko::assert::str_contains(mine, "sg_two_tests_never_derive_the_same_path")
}

fn sg_unscoped_in_tree(root: str): str {
    var entries = match teko::fs::list_dir(root) { []str as e => e; error => teko::list::empty() }
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var full = teko::str::concat(root, "/", entries[i])
        var hit = if sg_is_scannable(entries[i]) { sg_scan_unless_self(full) } else { sg_unscoped_in_tree(full) }
        if hit.len > 0 { return hit }
        i = i + 1
    }
    ""
}

fn sg_scan_unless_self(path: str): str {
    if path == SG_SELF { return "" }
    sg_unscoped_in_file(path)
}

fn sg_is_scannable(name: str): bool {
    teko::str::ends_with(name, ".tkt") || teko::str::ends_with(name, ".tks")
}

fn sg_unscoped_in_file(path: str): str {
    var text = match teko::io::read_file(path) { str as s => s; error => return teko::str::concat(path, ": unreadable") }
    if !sg_text_mentions_scratch(text) { return "" }
    var bad = sg_first_violating_line(text, sg_scratch_needles())
    if bad.len == 0 { return "" }
    teko::str::concat(path, ": ", bad)
}

fn sg_first_violating_line(text: str, needles: []str): str {
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            var line = teko::str::slice(text, start, i)
            if sg_line_violates(line, needles) { return line }
            start = i + 1
        }
        i = i + 1
    }
    if start >= text.len { return "" }
    var last = teko::str::slice(text, start, text.len)
    if sg_line_violates(last, needles) { return last }
    ""
}

fn sg_text_mentions_scratch(text: str): bool {
    var prefixes = sg_scratch_prefixes()
    var i: u64 = 0
    loop {
        if i >= prefixes.len { break }
        if teko::str::contains(text, prefixes[i]) { return true }
        i = i + 1
    }
    false
}

fn sg_line_violates(line: str, needles: []str): bool {
    if teko::str::contains(line, SG_WRAPPER) { return false }
    if teko::str::contains(line, SG_WRAPPER_SCRATCH) { return false }
    if sg_line_declares_a_named_constant(line) { return false }
    sg_line_has_literal(line, needles)
}

fn sg_line_declares_a_named_constant(line: str): bool {
    teko::str::contains(line, "const ") && teko::str::contains(line, ": str = \"")
}

fn sg_scratch_needles(): []str {
    var prefixes = sg_scratch_prefixes()
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= prefixes.len { break }
        out = teko::list::push(out, teko::str::concat("\"", prefixes[i]))
        i = i + 1
    }
    out
}

fn sg_line_has_literal(line: str, needles: []str): bool {
    var i: u64 = 0
    loop {
        if i >= needles.len { break }
        if teko::str::contains(line, needles[i]) { return true }
        i = i + 1
    }
    false
}
