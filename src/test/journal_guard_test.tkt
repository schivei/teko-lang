/**
 * jg_path_is_rooted — whether `path` opens with `root`, the same test `teko::assert::str_starts_with`
 * performs, but returning a `bool` this file's own inversion can assert against instead of panicking.
 *
 * journal_guard_test — G2, THE OBSERVATIONAL HALF of the scratch-isolation proof this whole file is
 * (journal J7, journaling-de-corrida-0.3.1 §7). G1 (`scratch_guard_test.tkt`) is a SOURCE SCAN: it
 * proves every scratch literal in the corpus is the direct argument of the one composer
 * (`teko::test::scoped`/`teko::journal::scratch`). What it cannot prove is that the composer ITSELF
 * still roots what it hands back — a regression to `scratch`'s own body would slip straight past a
 * scan that only ever reads call sites, because every call site would still look correct.
 *
 * SO THIS FILE TESTS THE COMPOSER'S OUTPUT DIRECTLY, AT RUNTIME, rather than photographing
 * `bin/`/`out/`/`/tmp` before and after a run. A literal directory snapshot was the design's first
 * shape, and it was rejected here on measurement, not taste: this suite's own gate runs every other
 * `#test` in the SAME process before this one reaches the shard's slot in file order, and every one
 * of them already shares this run's `run_root()` — so a snapshot taken at this test's own entry
 * would already show `bin/.tkrun/<run>` as pre-existing, and the property worth proving (a NEW
 * top-level entry never appears outside it) degenerates to "zero new entries", which is true
 * whether the composer is correct or entirely deleted. A property that cannot fail on a broken
 * composer is not a guard. Asking each composed path directly whether it lives under this run's own
 * root has no such blind spot, and the inversion below proves the assertion is alive.
 *
 * @param path  the path to check
 * @param root  the run root it must open with
 * @return      true iff `path` starts with `root`
 */
fn jg_path_is_rooted(path: str, root: str): bool {
    if root.len > path.len { return false }
    teko::str::slice_to(path, root.len) == root
}

/**
 * jg_a_scoped_path_lives_under_this_runs_root — THE PROPERTY, across several distinct bases (a bare
 * name, a nested one, one that already opens with a dot) so it is not an artefact of one spelling.
 *
 * @return void
 */
#test
fn jg_a_scoped_path_lives_under_this_runs_root() {
    var root = teko::journal::run_root()
    teko::assert::str_starts_with(teko::test::scoped("bin/.jg-a"), root)
    teko::assert::str_starts_with(teko::test::scoped("bin/.jg-b/nested"), root)
    teko::assert::str_starts_with(teko::test::scoped(".jg-dotted"), root)
}

/**
 * jg_the_guard_rejects_an_unrooted_path — THE INVERSION, and it is not optional (the same law G1's
 * own inversion states): a guard that cannot fail is decoration. Three arms: a path built at RUNTIME
 * (never a scratch literal, so G1 has nothing to say about it — `teko::str::concat` composes it, no
 * call site here spells a whole scratch path) that plainly does not open with this run's root; the
 * empty path, which cannot be "rooted" by any non-empty root either; and the positive control,
 * proving the predicate is not simply hard-wired to `false`.
 *
 * THE THIRD ARM IS THE INSTRUMENT'S OWN LIVENESS (§7.2): a predicate that always answers `false`
 * would pass the first two arms for the wrong reason. Asserting it also answers `true` on a genuinely
 * scoped path is what tells the two `false`s apart from a broken instrument.
 *
 * @return void
 */
#test
fn jg_the_guard_rejects_an_unrooted_path() {
    var root = teko::journal::run_root()
    var stray = teko::str::concat("bin/", "jg-stray-outside-run-root")
    teko::assert::is_false(jg_path_is_rooted(stray, root))
    teko::assert::is_false(jg_path_is_rooted("", root))
    teko::assert::is_true(jg_path_is_rooted(teko::test::scoped("bin/.jg-c"), root))
}
