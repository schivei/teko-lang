fn jg_path_is_rooted(path: str, root: str): bool {
    if root.len > path.len { return false }
    teko::str::slice_to(path, root.len) == root
}

#test
fn jg_a_scoped_path_lives_under_this_runs_root() {
    var root = teko::journal::run_root()
    teko::assert::str_starts_with(teko::test::scoped("bin/.jg-a"), root)
    teko::assert::str_starts_with(teko::test::scoped("bin/.jg-b/nested"), root)
    teko::assert::str_starts_with(teko::test::scoped(".jg-dotted"), root)
}

#test
fn jg_the_guard_rejects_an_unrooted_path() {
    var root = teko::journal::run_root()
    var stray = teko::str::concat("bin/", "jg-stray-outside-run-root")
    teko::assert::is_false(jg_path_is_rooted(stray, root))
    teko::assert::is_false(jg_path_is_rooted("", root))
    teko::assert::is_true(jg_path_is_rooted(teko::test::scoped("bin/.jg-c"), root))
}
