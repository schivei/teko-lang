#test
fn date_to_string_token_widths() {
    var d = teko::time::date { days = 20000 to i32 }
    teko::assert::is_true(teko::time::date_to_string(d, "yy/M/d") == "24/10/4")
}

#test
fn time_to_string_clock_pattern() {
    var noon = teko::time::time { ticks = 43200000000000 to u64 }
    teko::assert::is_true(teko::time::time_to_string(noon, "HH:mm:ss") == "12:00:00")

    var odd = teko::time::time { ticks = 3661000000000 to u64 }
    teko::assert::is_true(teko::time::time_to_string(odd, "HH:mm:ss") == "01:01:01")
}

#test
fn date_min_max_roundtrip() {
    var min_d = teko::time::date_from_days(-2147483648 to i32)
    teko::assert::is_true(min_d.days == -2147483648)

    var max_d = teko::time::date_from_days(2147483647 to i32)
    teko::assert::is_true(max_d.days == 2147483647)
}

#test
fn time_max_boundary_23_59_59_999999999() {
    var last_ns_of_day = teko::time::time_from_ns(86399999999999)
    teko::assert::is_true(last_ns_of_day.ticks == 86399999999999)
    teko::assert::is_true(teko::time::time_to_string(last_ns_of_day, "HH:mm:ss") == "23:59:59")

    var midnight = teko::time::time_from_ns(0)
    teko::assert::is_true(midnight.ticks == 0)
}

#test
fn datetime_of_combines_fields() {
    var d = teko::time::date_from_days(18628)
    var t = teko::time::time_from_ns(3661000000000)
    var dt = teko::time::datetime_of(d, t)
    teko::assert::is_true(dt.days == 18628)
    teko::assert::is_true(dt.ticks == 3661000000000)
}

#test
fn timestamp_roundtrip() {
    var dt = teko::time::datetime_of(teko::time::date_from_days(18628), teko::time::time_from_ns(3661000000000))
    var ts = teko::time::timestamp_from_datetime(dt)
    teko::assert::is_true(ts == 18628 * 86400 + 3661)
    var back = teko::time::timestamp_to_datetime(ts)
    teko::assert::is_true(back.days == dt.days)
    teko::assert::is_true(back.ticks == dt.ticks)

    var pre_epoch = teko::time::datetime_of(teko::time::date_from_days(-1 to i32), teko::time::time_from_ns(0))
    var pre_ts = teko::time::timestamp_from_datetime(pre_epoch)
    teko::assert::is_true(pre_ts == 0 - 86400)
    var pre_back = teko::time::timestamp_to_datetime(pre_ts)
    teko::assert::is_true(pre_back.days == -1)
    teko::assert::is_true(pre_back.ticks == 0)
}

#test
fn datetime_add_normalizes_across_midnight() {
    var almost_midnight = teko::time::datetime_of(teko::time::date_from_days(100), teko::time::time_from_ns(82800000000000))
    var two_hours = teko::time::span_from_ns(7200000000000)
    var forward = teko::time::datetime_add(almost_midnight, two_hours)
    teko::assert::is_true(forward.days == 101)
    teko::assert::is_true(forward.ticks == 3600000000000)

    var just_after_midnight = teko::time::datetime_of(teko::time::date_from_days(100), teko::time::time_from_ns(3600000000000))
    var backward = teko::time::datetime_sub(just_after_midnight, two_hours)
    teko::assert::is_true(backward.days == 99)
    teko::assert::is_true(backward.ticks == 82800000000000)
}

#test
fn datetime_diff_matches_add() {
    var a = teko::time::datetime_of(teko::time::date_from_days(50), teko::time::time_from_ns(1000000000))
    var b = teko::time::datetime_of(teko::time::date_from_days(49), teko::time::time_from_ns(500000000))
    var d = teko::time::datetime_diff(a, b)
    teko::assert::is_true(d.ticks == 86400000000000 + 500000000)
    var reconstructed = teko::time::datetime_add(b, d)
    teko::assert::is_true(reconstructed.days == a.days)
    teko::assert::is_true(reconstructed.ticks == a.ticks)
}

#test
fn span_arithmetic() {
    var a = teko::time::span_from_ns(1000000000)
    var b = teko::time::span_from_ns(300000000)
    teko::assert::is_true(teko::time::span_add(a, b).ticks == 1300000000)
    teko::assert::is_true(teko::time::span_sub(a, b).ticks == 700000000)
    teko::assert::is_true(teko::time::span_sub(b, a).ticks == 0 - 700000000)
}

#test
fn date_add_and_diff_days() {
    var d = teko::time::date_from_days(1000)
    teko::assert::is_true(teko::time::date_add_days(d, 5).days == 1005)
    teko::assert::is_true(teko::time::date_add_days(d, -5 to i32).days == 995)
    teko::assert::is_true(teko::time::date_diff_days(teko::time::date_from_days(1005), d) == 5)
}

#test
fn dto_offset_field() {
    var dt = teko::time::datetime_of(teko::time::date_from_days(18628), teko::time::time_from_ns(0))
    var plus_two = teko::time::dto_of(dt, 120)
    teko::assert::is_true(plus_two.days == 18628)
    teko::assert::is_true(plus_two.ticks == 0)
    teko::assert::is_true(plus_two.offset_minutes == 120)

    var minus_five_thirty = teko::time::dto_of(dt, -330 to i16)
    teko::assert::is_true(minus_five_thirty.offset_minutes == -330)
}

#test
fn datetime_diff_at_the_last_in_domain_day() {
    var later = teko::time::datetime_of(teko::time::date_from_days(106750), teko::time::time_from_ns(0))
    var earlier = teko::time::datetime_of(teko::time::date_from_days(0), teko::time::time_from_ns(0))
    var d = teko::time::datetime_diff(later, earlier)
    teko::assert::is_true(d.ticks == 9223200000000000000)
    teko::assert::is_true(d.ticks > 0)
    var back = teko::time::datetime_diff(earlier, later)
    teko::assert::is_true(back.ticks == 0 - 9223200000000000000)
}

#test
fn date_diff_days_widens_before_subtracting() {
    var far_future = teko::time::date_from_days(2000000000 to i32)
    var far_past = teko::time::date_from_days(-100000000 to i32)
    teko::assert::is_true(teko::time::date_diff_days(far_future, far_past) == 2100000000)
}

#test
fn date_to_string_renders_a_negative_year() {
    var before_year_one = teko::time::date_from_days(-800000 to i32)
    var text = teko::time::date_to_string(before_year_one, "yyyy-MM-dd")
    teko::assert::is_true(teko::time::civil_from_days(-800000).year < 0)
    teko::assert::is_true(text == "-0221-09-04")
}
