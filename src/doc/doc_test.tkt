// src/doc/doc_test.tkt — tests for teko::doc's CLI arg parsing (`parse_doc_args`), pure and
// I/O-free. `run_cli`'s SUCCESS path (`teko::build::doc_frontend`, which `chdir`s the process)
// is deliberately NOT exercised here: `chdir` is process-global state, and this test runs inside
// the SAME process as every other `#test` in the suite (D2) — changing the working directory
// mid-suite would corrupt every relative path a NEIGHBOURING test relies on (the same hazard
// `teko::test::scoped` exists to avoid for scratch FILES; there is no analogous per-test cwd).
// `teko doc`'s functional end-to-end behavior is proven manually against a real gen2 binary
// (this unit's validation write-up), the same posture `teko::fmt`'s `_test.tkt` already takes
// for its own file-WRITING path (only `--check`, read-only, is exercised there).

#test
fn no_args_defaults_json_mode_false_and_project_arg_empty() {
    let a = parse_doc_args(["teko", "doc"])
    teko::assert::is_false(a.json_mode)
    teko::assert::eq_str(a.project_arg, "")
}

#test
fn a_bare_path_is_read_as_the_project_arg() {
    let a = parse_doc_args(["teko", "doc", "myproj"])
    teko::assert::is_false(a.json_mode)
    teko::assert::eq_str(a.project_arg, "myproj")
}

#test
fn json_flag_sets_json_mode_and_leaves_the_path_alone() {
    let a = parse_doc_args(["teko", "doc", "--json", "myproj"])
    teko::assert::is_true(a.json_mode)
    teko::assert::eq_str(a.project_arg, "myproj")
}

#test
fn the_json_flag_may_follow_the_path_too() {
    let a = parse_doc_args(["teko", "doc", "myproj", "--json"])
    teko::assert::is_true(a.json_mode)
    teko::assert::eq_str(a.project_arg, "myproj")
}

#test
fn only_the_first_positional_is_kept_as_the_project_arg() {
    let a = parse_doc_args(["teko", "doc", "first", "second"])
    teko::assert::eq_str(a.project_arg, "first")
}
