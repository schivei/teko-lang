// src/doc/markdown_test.tkt — tests for teko::doc::render_markdown. Fixtures are hand-built
// `DocItem`/`DocBlock`/`DocTag`/`DocMember` literals (every field spelled out) rather than
// parsed source, so the renderer is tested against the MODEL alone, independent of the parser
// or the extraction pass (those have their own tests, index_test.tkt).

fn empty_block() -> DocBlock { DocBlock { summary = ""; tags = teko::list::empty() } }

#test
fn a_single_root_item_renders_the_minimal_document_exactly() {
    let item = DocItem {
        name = "ping"; namespace = ""; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Function; signature = "fn ping()"
        block = DocBlock { summary = "Pings."; tags = teko::list::empty() }
        members = teko::list::empty()
    }
    let got = render_markdown("proj", [item])
    let want = "# proj — API Reference\n\n_Generated by `teko doc`._\n\n## (root)\n\n### `fn ping()`\n\nPings.\n\n"
    teko::assert::eq_str(got, want)
}

#test
fn items_are_grouped_by_namespace_in_first_seen_order() {
    let a = DocItem { name = "a"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32; kind = DocKind::Function; signature = "fn a()"; block = empty_block(); members = teko::list::empty() }
    let b = DocItem { name = "b"; namespace = "other"; file = "g.tks"; line = 1 to u32; col = 1 to u32; kind = DocKind::Function; signature = "fn b()"; block = empty_block(); members = teko::list::empty() }
    let c = DocItem { name = "c"; namespace = "m"; file = "f.tks"; line = 2 to u32; col = 1 to u32; kind = DocKind::Function; signature = "fn c()"; block = empty_block(); members = teko::list::empty() }
    let got = render_markdown("proj", [a, b, c])
    // "m" is first-seen (item `a`), so its section (and both of its items) precede "other"'s,
    // even though `c` (also namespace "m") appears AFTER `b` (namespace "other") in the input.
    let m_at = match teko::str::last_index_of(got, "## m") { u64 as i => i; error => { teko::assert::is_true(false); return } }
    let other_at = match teko::str::last_index_of(got, "## other") { u64 as i => i; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(m_at < other_at)
    let c_at = match teko::str::last_index_of(got, "fn c()") { u64 as i => i; error => { teko::assert::is_true(false); return } }
    teko::assert::is_true(c_at < other_at)
}

#test
fn parameters_and_return_render_as_bulleted_and_single_line_sections() {
    let item = DocItem {
        name = "add"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Function; signature = "fn add(a: i64, b: i64) -> i64"
        block = DocBlock {
            summary = "Adds two numbers."
            tags = [
                DocTag { tag = "param"; arg = "a"; text = "the first" }
                DocTag { tag = "param"; arg = "b"; text = "the second" }
                DocTag { tag = "return"; arg = ""; text = "the sum" }
            ]
        }
        members = teko::list::empty()
    }
    let got = render_markdown("proj", [item])
    teko::assert::str_contains(got, "**Parameters:**\n\n- `a` — the first\n- `b` — the second\n")
    teko::assert::str_contains(got, "**Returns:** the sum\n")
}

#test
fn throws_since_and_see_also_render_when_present() {
    let item = DocItem {
        name = "risky"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Function; signature = "fn risky()"
        block = DocBlock {
            summary = ""
            tags = [
                DocTag { tag = "throws"; arg = ""; text = "when it fails" }
                DocTag { tag = "since"; arg = ""; text = "0.3.1" }
                DocTag { tag = "see"; arg = ""; text = "teko::doc::safe" }
            ]
        }
        members = teko::list::empty()
    }
    let got = render_markdown("proj", [item])
    teko::assert::str_contains(got, "**Throws:**\n\n- when it fails\n")
    teko::assert::str_contains(got, "**Since:** 0.3.1\n")
    teko::assert::str_contains(got, "**See also:**\n\n- teko::doc::safe\n")
}

#test
fn a_types_fields_and_methods_render_as_their_own_bulleted_sections() {
    let item = DocItem {
        name = "Pair"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Type; signature = "type Pair"
        block = DocBlock { summary = "A pair of values."; tags = teko::list::empty() }
        members = [
            DocMember { name = "x"; kind = MemberKind::Field; signature = "x: i64"; block = DocBlock { summary = "the first value"; tags = teko::list::empty() } }
            DocMember { name = "swap"; kind = MemberKind::Method; signature = "fn swap(self) -> void"; block = empty_block() }
        ]
    }
    let got = render_markdown("proj", [item])
    teko::assert::str_contains(got, "**Fields:**\n\n- `x: i64` — the first value\n")
    teko::assert::str_contains(got, "**Methods:**\n\n- `fn swap(self) -> void`\n")
}

#test
fn a_type_with_no_members_renders_no_member_sections() {
    let item = DocItem {
        name = "Marker"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Type; signature = "type Marker"
        block = empty_block(); members = teko::list::empty()
    }
    let got = render_markdown("proj", [item])
    teko::assert::str_absent(got, "**Fields:**")
    teko::assert::str_absent(got, "**Methods:**")
}
