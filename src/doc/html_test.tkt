// src/doc/html_test.tkt — tests for teko::doc::render_html: a minimal structural snapshot plus
// escaping and section-presence checks (a full-page byte-exact snapshot is not worth hand-tracing
// once escaping and per-namespace looping are both in play — index_test.tkt / markdown_test.tkt
// already prove the underlying model; this file's job is the HTML shell + escaping specifically).

fn empty_block() -> DocBlock { DocBlock { summary = ""; tags = teko::list::empty() } }

#test
fn render_html_of_no_items_is_the_bare_page_shell() {
    let got = render_html("proj", teko::list::empty())
    let want = "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>proj — API Reference</title></head><body>\n<h1>proj — API Reference</h1>\n<p><em>Generated by <code>teko doc</code>.</em></p>\n</body></html>\n"
    teko::assert::eq_str(got, want)
}

#test
fn render_html_escapes_the_project_name_and_signature_and_summary() {
    let item = DocItem {
        name = "lt"; namespace = ""; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Function; signature = "fn lt(a: A<B>) -> bool"
        block = DocBlock { summary = "a < b & c > d"; tags = teko::list::empty() }
        members = teko::list::empty()
    }
    let got = render_html("A & <B>", [item])
    teko::assert::str_contains(got, "A &amp; &lt;B&gt;")
    teko::assert::str_contains(got, "fn lt(a: A&lt;B&gt;) -&gt; bool")
    teko::assert::str_contains(got, "a &lt; b &amp; c &gt; d")
    teko::assert::str_absent(got, "A<B>")
}

#test
fn render_html_groups_items_under_a_namespace_heading() {
    let a = DocItem { name = "a"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32; kind = DocKind::Function; signature = "fn a()"; block = empty_block(); members = teko::list::empty() }
    let got = render_html("proj", [a])
    teko::assert::str_contains(got, "<h2>m</h2>")
    teko::assert::str_contains(got, "<code>fn a()</code>")
}

#test
fn render_html_renders_parameters_returns_throws_since_and_see() {
    let item = DocItem {
        name = "risky"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Function; signature = "fn risky(x: i64)"
        block = DocBlock {
            summary = ""
            tags = [
                DocTag { tag = "param"; arg = "x"; text = "the input" }
                DocTag { tag = "return"; arg = ""; text = "the output" }
                DocTag { tag = "throws"; arg = ""; text = "on failure" }
                DocTag { tag = "since"; arg = ""; text = "0.3.1" }
                DocTag { tag = "see"; arg = ""; text = "teko::doc" }
            ]
        }
        members = teko::list::empty()
    }
    let got = render_html("proj", [item])
    teko::assert::str_contains(got, "<h4>Parameters</h4>")
    teko::assert::str_contains(got, "<code>x</code> — the input")
    teko::assert::str_contains(got, "<strong>Returns:</strong> the output")
    teko::assert::str_contains(got, "<h4>Throws</h4>")
    teko::assert::str_contains(got, "<li>on failure</li>")
    teko::assert::str_contains(got, "<strong>Since:</strong> 0.3.1")
    teko::assert::str_contains(got, "<h4>See also</h4>")
    teko::assert::str_contains(got, "<li>teko::doc</li>")
}

#test
fn render_html_renders_fields_and_methods_as_their_own_lists() {
    let item = DocItem {
        name = "Pair"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32
        kind = DocKind::Type; signature = "type Pair"
        block = empty_block()
        members = [
            DocMember { name = "x"; kind = MemberKind::Field; signature = "x: i64"; block = DocBlock { summary = "the x"; tags = teko::list::empty() } }
            DocMember { name = "swap"; kind = MemberKind::Method; signature = "fn swap(self)"; block = empty_block() }
        ]
    }
    let got = render_html("proj", [item])
    teko::assert::str_contains(got, "<h4>Fields</h4>")
    teko::assert::str_contains(got, "<code>x: i64</code> — the x")
    teko::assert::str_contains(got, "<h4>Methods</h4>")
    teko::assert::str_contains(got, "<code>fn swap(self)</code></li>")
}

#test
fn render_html_omits_member_sections_when_there_are_none() {
    let item = DocItem { name = "Marker"; namespace = "m"; file = "f.tks"; line = 1 to u32; col = 1 to u32; kind = DocKind::Type; signature = "type Marker"; block = empty_block(); members = teko::list::empty() }
    let got = render_html("proj", [item])
    teko::assert::str_absent(got, "<h4>Fields</h4>")
    teko::assert::str_absent(got, "<h4>Methods</h4>")
}
