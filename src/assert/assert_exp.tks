
/**
 * scenario_begin — name the case that follows, so its assertions and its `ok` line address it by name
 * instead of by an exit code.
 *
 * @param name  the scenario's name, as a human and a `.tkr` row both spell it
 */
exp fn scenario_begin(name: str) { scenario_set_rt(name) }

/**
 * scenario_ok — declare the named case PASSED: emits `scenario <name>: ok` on the current channel (a `#test`'s
 * own channel when one is open, the real stdout otherwise) and clears the name.
 *
 * @throws  when no scenario is named — a silent `ok` for an unnamed case is the reporting hole this
 *          whole mechanism exists to close
 */
exp fn scenario_ok() { scenario_ok_rt() }

/**
 * is_true — the predicate must hold.
 *
 * @param c  the predicate
 * @throws   when `c` is false
 */
exp fn is_true(c: bool) {
    if !c { fail_bare("is_true") }
}

/**
 * is_false — the predicate must NOT hold.
 *
 * @param c  the predicate
 * @throws   when `c` is true
 */
exp fn is_false(c: bool) {
    if c { fail_bare("is_false") }
}

/**
 * eq_i64 — signed integer equality.
 *
 * @param got   the observed value
 * @param want  the expected value
 * @throws      when they differ, naming both
 */
exp fn eq_i64(got: i64, want: i64) {
    if got != want { fail("eq_i64", $"expected {want}, got {got}") }
}

/**
 * ne_i64 — signed integer difference.
 *
 * @param got   the observed value
 * @param want  the value it must NOT be
 * @throws      when they are equal, naming both
 */
exp fn ne_i64(got: i64, want: i64) {
    if got == want { fail("ne_i64", $"expected anything but {want}, got {got}") }
}

/**
 * lt_i64 — the observed value must be strictly below the bound.
 *
 * @param got    the observed value
 * @param bound  the exclusive upper bound
 * @throws       when `got >= bound`, naming both
 */
exp fn lt_i64(got: i64, bound: i64) {
    if got >= bound { fail("lt_i64", $"expected < {bound}, got {got}") }
}

/**
 * le_i64 — the observed value must not exceed the bound.
 *
 * @param got    the observed value
 * @param bound  the inclusive upper bound
 * @throws       when `got > bound`, naming both
 */
exp fn le_i64(got: i64, bound: i64) {
    if got > bound { fail("le_i64", $"expected <= {bound}, got {got}") }
}

/**
 * gt_i64 — the observed value must be strictly above the bound.
 *
 * @param got    the observed value
 * @param bound  the exclusive lower bound
 * @throws       when `got <= bound`, naming both
 */
exp fn gt_i64(got: i64, bound: i64) {
    if got <= bound { fail("gt_i64", $"expected > {bound}, got {got}") }
}

/**
 * ge_i64 — the observed value must be at least the bound.
 *
 * @param got    the observed value
 * @param bound  the inclusive lower bound
 * @throws       when `got < bound`, naming both
 */
exp fn ge_i64(got: i64, bound: i64) {
    if got < bound { fail("ge_i64", $"expected >= {bound}, got {got}") }
}

/**
 * eq_u64 — unsigned integer equality.
 *
 * @param got   the observed value
 * @param want  the expected value
 * @throws      when they differ, naming both
 */
exp fn eq_u64(got: u64, want: u64) {
    if got != want { fail("eq_u64", $"expected {want}, got {got}") }
}

/**
 * eq_f64 — float equality WITHIN a tolerance, because exact binary64 equality is almost never the
 * claim a test means to make; the tolerance is an ARGUMENT so the scenario states its own precision
 * rather than inheriting a magic one.
 *
 * @param got   the observed value
 * @param want  the expected value
 * @param tol   the largest absolute difference that still counts as equal
 * @throws      when `|got - want| > tol`, naming all three
 */
exp fn eq_f64(got: f64, want: f64, tol: f64) {
    let diff = if got < want { want - got } else { got - want }
    if diff > tol { fail("eq_f64", $"expected {want} within {tol}, got {got}") }
}

/**
 * eq_str — byte equality of two strings.
 *
 * @param got   the observed text
 * @param want  the expected text
 * @throws      when they differ, quoting both
 */
exp fn eq_str(got: str, want: str) {
    if got != want { fail(
            "eq_str", teko::str::concat("expected ", quoted(want), ", got ", quoted(got))) }
}

/**
 * ne_str — byte difference of two strings.
 *
 * @param got   the observed text
 * @param want  the text it must NOT be
 * @throws      when they are equal, quoting both
 */
exp fn ne_str(got: str, want: str) {
    if got == want { fail_two_texts("ne_str", "anything but", want, got) }
}

/**
 * str_contains — `needle` must appear in `hay`. An empty needle is contained in anything.
 *
 * @param hay     the text searched
 * @param needle  the substring demanded
 * @throws        when `needle` does not appear, quoting both
 */
exp fn str_contains(hay: str, needle: str) {
    if !teko::str::contains(hay, needle) { fail_two_texts("str_contains", "to contain", needle, hay) }
}

/**
 * str_absent — `needle` must NOT appear in `hay`.
 *
 * @param hay     the text searched
 * @param needle  the substring forbidden
 * @throws        when `needle` appears, quoting both
 */
exp fn str_absent(hay: str, needle: str) {
    if teko::str::contains(hay, needle) { fail_two_texts("str_absent", "NOT to contain", needle, hay) }
}

/**
 * str_starts_with — `hay` must open with `prefix`.
 *
 * @param hay     the text examined
 * @param prefix  the opening demanded
 * @throws        when `hay` does not open with it, quoting both
 */
exp fn str_starts_with(hay: str, prefix: str) {
    if prefix.len > hay.len { fail_two_texts("str_starts_with", "to start with", prefix, hay) }
    if teko::str::slice_to(hay, prefix.len) != prefix { fail_two_texts("str_starts_with", "to start with", prefix, hay) }
}

/**
 * str_ends_with — `hay` must close with `suffix`.
 *
 * @param hay     the text examined
 * @param suffix  the closing demanded
 * @throws        when `hay` does not close with it, quoting both
 */
exp fn str_ends_with(hay: str, suffix: str) {
    if !teko::str::ends_with(hay, suffix) { fail_two_texts("str_ends_with", "to end with", suffix, hay) }
}

/**
 * len_eq — the length assertion for ANY sequence: pass `xs.len`, whatever `xs`'s element type is.
 * This is how `[]T` SHAPE is asserted with no generics in the seed.
 *
 * @param got   the observed length
 * @param want  the expected length
 * @throws      when they differ, naming both
 */
exp fn len_eq(got: u64, want: u64) {
    if got != want { fail("len_eq", $"expected length {want}, got {got}") }
}

/**
 * bytes_eq — element-wise equality of two `[]byte`, reporting the FIRST differing INDEX rather than
 * just "not equal": for a byte buffer the index is the whole diagnosis.
 *
 * @param got   the observed bytes
 * @param want  the expected bytes
 * @throws      when the lengths differ, or at the first differing index
 */
exp fn bytes_eq(got: []byte, want: []byte) {
    if got.len != want.len { fail("bytes_eq", $"expected {want.len} bytes, got {got.len}") }
    mut i: u64 = 0
    loop {
        if i >= got.len { break }
        if got[i] != want[i] {
            let w = want[i] to u64
            let g = got[i] to u64
            fail("bytes_eq", $"expected byte {w} at index {i}, got {g}")
        }
        i = i + 1
    }
}

/**
 * is_present — a `T | null` narrowed to its `T` member. The caller does the `match` (which is where
 * narrowing lives) and passes whether it hit `T`, plus the member's NAME so the failure says which
 * union it was about.
 *
 * @param what     the union member's name, for the message
 * @param present  whether the caller's `match` reached the non-null arm
 * @throws         when it did not
 */
exp fn is_present(what: str, present: bool) {
    if !present { fail("is_present", teko::str::concat("expected ", what, " to be present, got null")) }
}

/**
 * is_absent — a `T | null` that must be null.
 *
 * @param what     the union member's name, for the message
 * @param present  whether the caller's `match` reached the non-null arm
 * @throws         when it did
 */
exp fn is_absent(what: str, present: bool) {
    if present { fail("is_absent", teko::str::concat("expected ", what, " to be null, got a present value")) }
}

/**
 * is_ok — a `T | error` that must have yielded its value member.
 *
 * @param what  the operation's name, for the message
 * @param ok    whether the caller's `match` reached the value arm
 * @throws      when it reached the error arm instead
 */
exp fn is_ok(what: str, ok: bool) {
    if !ok { fail("is_ok", teko::str::concat("expected ", what, " to succeed, got the error member")) }
}

/**
 * is_error — a `T | error` that must have yielded its error member. This is the assertion a scenario
 * uses for "this fails", in place of addressing the failure by an exit code.
 *
 * @param what  the operation's name, for the message
 * @param ok    whether the caller's `match` reached the value arm
 * @throws      when it did (i.e. the operation unexpectedly succeeded)
 */
exp fn is_error(what: str, ok: bool) {
    if ok { fail("is_error", teko::str::concat("expected ", what, " to yield its error member, got a value")) }
}
