#test
fn inflate_dynamic_huffman_known_vector() {
    var decoded = match teko::compress::inflate(kav_raw_deflate()) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(decoded, kav_plaintext()))
}

#test
fn deflate_inflate_round_trip() {
    var empty: []byte = []
    var empty_roundtrip = match teko::compress::inflate(teko::compress::deflate(empty)) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(empty_roundtrip.len == 0)

    var plaintext = kav_plaintext()
    var roundtrip = match teko::compress::inflate(teko::compress::deflate(plaintext)) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(roundtrip, plaintext))

    var repetitive: []byte = []()
    var i: u64 = 0
    loop {
        if i >= 5000 { break }
        repetitive = teko::list::push(repetitive, (i % 7) to byte)
        i++
    }
    var rep_roundtrip = match teko::compress::inflate(teko::compress::deflate(repetitive)) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(rep_roundtrip, repetitive))
}

#test
fn zlib_known_vector_and_round_trip() {
    var decoded = match teko::compress::zlib_decompress(kav_zlib_stream()) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(decoded, kav_plaintext()))

    var plaintext = kav_plaintext()
    var own_roundtrip = match teko::compress::zlib_decompress(teko::compress::zlib_compress(plaintext)) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(own_roundtrip, plaintext))
}

#test
fn gzip_known_vector_and_round_trip() {
    var decoded = match teko::compress::gzip_decompress(kav_gzip_stream()) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(decoded, kav_plaintext()))

    var plaintext = kav_plaintext()
    var own_roundtrip = match teko::compress::gzip_decompress(teko::compress::gzip_compress(plaintext)) {
        []byte as b => b
        error as e => { teko::assert::is_true(false); [] }
    }
    teko::assert::is_true(bytes_eq(own_roundtrip, plaintext))
}
