/**
 * The DEFLATE `BTYPE` tag (RFC 1951 §3.2.3): `Stored` (uncompressed, code `0`), `Fixed`
 * (fixed-Huffman, code `1`), or `Dynamic` (dynamic-Huffman, code `2`). The declaration
 * order fixes the ordinal to the on-the-wire `BTYPE` code, so `btype to BlockType`
 * reproduces the wire value directly — no separate wire-mapping helper is needed.
 */
pub type BlockType = enum { Stored; Fixed; Dynamic }

/**
 * Decompress a raw DEFLATE bitstream (RFC 1951 — no zlib/gzip framing) into its original
 * bytes.
 *
 * @param data  the compressed DEFLATE stream
 * @return      the decompressed bytes, or an `error` on any malformed block, code, or
 *              truncation
 * @throws      when the stream ends before a `BFINAL == 1` block, or any block body is
 *              malformed (see `inflate_one_block`)
 */
pub fn inflate(data: []byte) -> []byte | error {
    mut state = InflateState { reader = bitreader_new(data); output = teko::list::empty() }
    loop {
        let step = match inflate_one_block(state) { BlockResult as r => r; error as e => return e }
        state = step.state
        if step.is_final { break }
    }
    state.output
}
