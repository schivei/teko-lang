/**
 * Read the `HCLEN` code-length-alphabet lengths (3 bits each, RFC 1951 §3.2.7), applying
 * the `code_length_order()` permutation to recover the 19 lengths in ALPHABET order
 * (position 0 = symbol 0, … position 18 = symbol 18). Any position not covered by
 * `HCLEN` entries is implicitly length `0` (unused).
 *
 * @param r      the cursor positioned right after `HCLEN` itself
 * @param hclen  how many (position, length) entries are encoded (4-19)
 * @return       the 19-entry code-length array (indexed by symbol) and the advanced
 *               cursor, or an `error` on stream truncation
 */
fn read_code_length_alphabet(r: BitReader, hclen: u32) -> CodeLengthsResult | error {
    let order = code_length_order()
    mut cur = r
    mut slots: []CodeLengthSlot = teko::list::empty()
    mut i: u32 = 0
    loop {
        if i >= hclen { break }
        let step = match read_bits(cur, 3) { BitsResult as b => b; error as e => return e }
        cur = step.next
        slots = teko::list::push(slots, CodeLengthSlot { position = order[i]; length = step.value })
        i++
    }

    mut lengths: []u32 = teko::list::empty()
    mut p: u32 = 0
    loop {
        if p >= 19 { break }
        lengths = teko::list::push(lengths, code_length_lengths_of(slots, p))
        p++
    }
    CodeLengthsResult { reader = cur; lengths = lengths }
}

/**
 * Find the length recorded for alphabet position `p` among the `HCLEN` slots (`0` if no
 * slot named `p` — the RFC's "trailing lengths are zero" shorthand).
 *
 * @param slots  the `(position, length)` pairs read in transmission order
 * @param p      the alphabet position to look up
 * @return       the length assigned to `p`, or `0` if none was transmitted
 */
fn code_length_lengths_of(slots: []CodeLengthSlot, p: u32) -> u32 {
    mut i: u64 = 0
    loop {
        if i >= slots.len { break }
        if slots[i].position == p { return slots[i].length }
        i++
    }
    0
}

/**
 * Decode one DYNAMIC-Huffman block (BTYPE 10, RFC 1951 §3.2.7): read `HLIT`/`HDIST`/
 * `HCLEN`, the code-length alphabet's own lengths, build its table, decode the combined
 * literal/length + distance length sequence, build both final tables, then decode the
 * block body exactly like a fixed-Huffman block.
 *
 * @param state  the running inflate state (cursor + output so far)
 * @return       the state advanced past this dynamic-Huffman block, or an `error` on any
 *               malformed header field, code, or stream truncation
 */
fn inflate_dynamic_block(state: InflateState) -> InflateState | error {
    let hlit_step = match read_bits(state.reader, 5) { BitsResult as b => b; error as e => return e }
    let hlit = hlit_step.value + 257
    let hdist_step = match read_bits(hlit_step.next, 5) { BitsResult as b => b; error as e => return e }
    let hdist = hdist_step.value + 1
    let hclen_step = match read_bits(hdist_step.next, 4) { BitsResult as b => b; error as e => return e }
    let hclen = hclen_step.value + 4

    let cl_alphabet = match read_code_length_alphabet(hclen_step.next, hclen) { CodeLengthsResult as r => r; error as e => return e }
    let cl_table = match build_huffman(cl_alphabet.lengths) { HuffTable as t => t; error as e => return e }

    let combined = match decode_code_lengths(cl_alphabet.reader, cl_table, hlit + hdist) { CodeLengthsResult as r => r; error as e => return e }
    let litlen_lengths = slice_u32(combined.lengths, 0, hlit to u64)
    let dist_lengths = slice_u32(combined.lengths, hlit to u64, (hlit + hdist) to u64)

    let litlen = match build_huffman(litlen_lengths) { HuffTable as t => t; error as e => return e }
    let dist = match build_huffman(dist_lengths) { HuffTable as t => t; error as e => return e }

    inflate_huffman_block(InflateState { reader = combined.reader; output = state.output }, litlen, dist)
}

/**
 * The result of decoding one DEFLATE block: the advanced state plus whether it was the
 * stream's final block.
 */
type BlockResult = struct {
    /** The inflate state advanced past this block. */
    state: InflateState
    /** Whether this block's `BFINAL` bit was set (the stream's last block). */
    is_final: bool
}

/**
 * Decode exactly one DEFLATE block (its 3-bit header, `BFINAL`+`BTYPE`, then the body
 * matching `BTYPE`).
 *
 * @param state  the running inflate state, positioned at a block header
 * @return       the advanced state and whether this was the FINAL block (`BFINAL == 1`),
 *               or an `error` on a malformed header or block body
 * @throws       when `BTYPE == 3` (reserved, RFC 1951 §3.2.3)
 */
fn inflate_one_block(state: InflateState) -> BlockResult | error {
    let final_step = match read_bit(state.reader) { BitResult as b => b; error as e => return e }
    let is_final = final_step.bit != 0
    let type_step = match read_bits(final_step.next, 2) { BitsResult as b => b; error as e => return e }
    let btype = type_step.value
    let body_state = InflateState { reader = type_step.next; output = state.output }

    match btype to BlockType {
        Stored => {
            let next = match inflate_stored_block(body_state) { InflateState as s => s; error as e => return e }
            BlockResult { state = next; is_final = is_final }
        }
        Fixed => {
            let next = match inflate_fixed_block(body_state) { InflateState as s => s; error as e => return e }
            BlockResult { state = next; is_final = is_final }
        }
        Dynamic => {
            let next = match inflate_dynamic_block(body_state) { InflateState as s => s; error as e => return e }
            BlockResult { state = next; is_final = is_final }
        }
        _ => error { message = "inflate: reserved block type (BTYPE 3)" }
    }
}
