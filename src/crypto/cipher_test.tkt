fn hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

fn hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = hex_val(chars[i])
        var lo = hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

fn hexed(r: []byte | CryptoError): str {
    match r {
        []byte as x => to_hex(x)
        CryptoError => "ERR"
    }
}

fn zeros(n: u64): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, 0 to byte)
        i++
    }
    out
}

#test
fn aes_fips197_single_block() {
    teko::assert::is_true(hexed(aes_encrypt_block(hex_bytes("2b7e151628aed2a6abf7158809cf4f3c"), hex_bytes("3243f6a8885a308d313198a2e0370734"))) == "3925841d02dc09fbdc118597196a0b32")
    teko::assert::is_true(hexed(aes_encrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f"), hex_bytes("00112233445566778899aabbccddeeff"))) == "69c4e0d86a7b0430d8cdb78070b4c55a")
    teko::assert::is_true(hexed(aes_encrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f1011121314151617"), hex_bytes("00112233445566778899aabbccddeeff"))) == "dda97ca4864cdfe06eaf70a0ec0d7191")
    teko::assert::is_true(hexed(aes_encrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), hex_bytes("00112233445566778899aabbccddeeff"))) == "8ea2b7ca516745bfeafc49904b496089")
}

#test
fn aes_fips197_decrypt_inverts() {
    teko::assert::is_true(hexed(aes_decrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f"), hex_bytes("69c4e0d86a7b0430d8cdb78070b4c55a"))) == "00112233445566778899aabbccddeeff")
    teko::assert::is_true(hexed(aes_decrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f1011121314151617"), hex_bytes("dda97ca4864cdfe06eaf70a0ec0d7191"))) == "00112233445566778899aabbccddeeff")
    teko::assert::is_true(hexed(aes_decrypt_block(hex_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), hex_bytes("8ea2b7ca516745bfeafc49904b496089"))) == "00112233445566778899aabbccddeeff")
}

#test
fn aes_rejects_bad_key_length() {
    teko::assert::is_true(hexed(aes_encrypt_block(hex_bytes("000102030405060708090a0b0c0d0e"), hex_bytes("00112233445566778899aabbccddeeff"))) == "ERR")
}

#test
fn aes128_cbc_sp800_38a() {
    var key = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    var iv = hex_bytes("000102030405060708090a0b0c0d0e0f")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var ct = "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b273bed6b8e3c1743b7116e69e222295163ff1caa1681fac09120eca307586e1a7"
    teko::assert::is_true(hexed(aes_cbc_encrypt(key, iv, pt)) == ct)
    teko::assert::is_true(hexed(aes_cbc_decrypt(key, iv, hex_bytes(ct))) == to_hex(pt))
}

#test
fn aes256_cbc_sp800_38a() {
    var key = hex_bytes("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4")
    var iv = hex_bytes("000102030405060708090a0b0c0d0e0f")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var ct = "f58c4c04d6e5f1ba779eabfb5f7bfbd69cfc4e967edb808d679f777bc6702c7d39f23369a9d9bacfa530e26304231461b2eb05e2c39be9fcda6c19078c6a9d1b"
    teko::assert::is_true(hexed(aes_cbc_encrypt(key, iv, pt)) == ct)
    teko::assert::is_true(hexed(aes_cbc_decrypt(key, iv, hex_bytes(ct))) == to_hex(pt))
}

#test
fn aes_ctr_sp800_38a() {
    var iv = hex_bytes("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var k128 = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    var ct128 = "874d6191b620e3261bef6864990db6ce9806f66b7970fdff8617187bb9fffdff5ae4df3edbd5d35e5b4f09020db03eab1e031dda2fbe03d1792170a0f3009cee"
    teko::assert::is_true(hexed(aes_ctr(k128, iv, pt)) == ct128)
    teko::assert::is_true(hexed(aes_ctr(k128, iv, hex_bytes(ct128))) == to_hex(pt))
    var k256 = hex_bytes("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4")
    var ct256 = "601ec313775789a5b7a7f504bbf3d228f443e3ca4d62b59aca84e990cacaf5c52b0930daa23de94ce87017ba2d84988ddfc9c58db67aada613c2dd08457941a6"
    teko::assert::is_true(hexed(aes_ctr(k256, iv, pt)) == ct256)
}

#test
fn aes_cfb_sp800_38a() {
    var iv = hex_bytes("000102030405060708090a0b0c0d0e0f")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var k128 = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    var ct128 = "3b3fd92eb72dad20333449f8e83cfb4ac8a64537a0b3a93fcde3cdad9f1ce58b26751f67a3cbb140b1808cf187a4f4dfc04b05357c5d1c0eeac4c66f9ff7f2e6"
    teko::assert::is_true(hexed(aes_cfb_encrypt(k128, iv, pt)) == ct128)
    teko::assert::is_true(hexed(aes_cfb_decrypt(k128, iv, hex_bytes(ct128))) == to_hex(pt))
    var k256 = hex_bytes("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4")
    var ct256 = "dc7e84bfda79164b7ecd8486985d386039ffed143b28b1c832113c6331e5407bdf10132415e54b92a13ed0a8267ae2f975a385741ab9cef82031623d55b1e471"
    teko::assert::is_true(hexed(aes_cfb_encrypt(k256, iv, pt)) == ct256)
    teko::assert::is_true(hexed(aes_cfb_decrypt(k256, iv, hex_bytes(ct256))) == to_hex(pt))
}

#test
fn aes_ofb_sp800_38a() {
    var iv = hex_bytes("000102030405060708090a0b0c0d0e0f")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var k128 = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    var ct128 = "3b3fd92eb72dad20333449f8e83cfb4a7789508d16918f03f53c52dac54ed8259740051e9c5fecf64344f7a82260edcc304c6528f659c77866a510d9c1d6ae5e"
    teko::assert::is_true(hexed(aes_ofb(k128, iv, pt)) == ct128)
    teko::assert::is_true(hexed(aes_ofb(k128, iv, hex_bytes(ct128))) == to_hex(pt))
    var k256 = hex_bytes("603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4")
    var ct256 = "dc7e84bfda79164b7ecd8486985d38604febdc6740d20b3ac88f6ad82a4fb08d71ab47a086e86eedf39d1c5bba97c4080126141d67f37be8538f5a8be740e484"
    teko::assert::is_true(hexed(aes_ofb(k256, iv, pt)) == ct256)
}

#test
fn aes192_modes() {
    var key = hex_bytes("8e73b0f7da0e6452c810f32b809079e562f8ead2522c6b7b")
    var pt = hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710")
    var iv = hex_bytes("000102030405060708090a0b0c0d0e0f")
    teko::assert::is_true(hexed(aes_cbc_encrypt(key, iv, pt)) == "4f021db243bc633d7178183a9fa071e8b4d9ada9ad7dedf4e5e738763f69145a571b242012fb7ae07fa9baac3df102e008b0e27988598881d920a9e64f5615cd")
    var ctr = hex_bytes("f0f1f2f3f4f5f6f7f8f9fafbfcfdfeff")
    teko::assert::is_true(hexed(aes_ctr(key, ctr, pt)) == "1abc932417521ca24f2b0459fe7e6e0b090339ec0aa6faefd5ccc2c6f4ce8e941e36b26bd1ebc670d1bd1d665620abf74f78a7f6d29809585a97daec58c6b050")
}

#test
fn chacha20_rfc8439_keystream() {
    var key = hex_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    var nonce = hex_bytes("000000090000004a00000000")
    var ks = hexed(chacha20(key, nonce, 1, zeros(64)))
    teko::assert::is_true(ks == "10f1e7e4d13b5915500fdd1fa32071c4c7d1f4c733c068030422aa9ac3d46c4ed2826446079faa0914c2d705d98b02a2b5129cd1de164eb9cbd083e8a2503c4e")
}

#test
fn chacha20_rfc8439_encrypt() {
    var key = hex_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    var nonce = hex_bytes("000000000000004a00000000")
    var pt = bytes_of_str("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
    var ct = "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"
    teko::assert::is_true(hexed(chacha20(key, nonce, 1, pt)) == ct)
    teko::assert::is_true(hexed(chacha20(key, nonce, 1, hex_bytes(ct))) == to_hex(pt))
}

#test
fn chacha20_rejects_bad_lengths() {
    teko::assert::is_true(hexed(chacha20(zeros(16), zeros(12), 1, zeros(8))) == "ERR")
    teko::assert::is_true(hexed(chacha20(zeros(32), zeros(8), 1, zeros(8))) == "ERR")
}

#test
fn cmac_aes128_nist() {
    var key = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    teko::assert::is_true(hexed(cmac_aes(key, [])) == "bb1d6929e95937287fa37d129b756746")
    teko::assert::is_true(hexed(cmac_aes(key, hex_bytes("6bc1bee22e409f96e93d7e117393172a"))) == "070a16b46b4d4144f79bdd9dd04a287c")
    teko::assert::is_true(hexed(cmac_aes(key, hex_bytes("6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411"))) == "dfa66747de9ae63030ca32611497c827")
}

#test
fn gmac_aes128() {
    var key = hex_bytes("2b7e151628aed2a6abf7158809cf4f3c")
    var iv = hex_bytes("000102030405060708090a0b")
    teko::assert::is_true(hexed(gmac_aes(key, iv, [])) == "a715b99567eaea4806b3a91c785f11cc")
    teko::assert::is_true(hexed(gmac_aes(key, iv, hex_bytes("6bc1bee22e409f96e93d7e117393172a"))) == "1f8672178fb5d61cc42b0802f958d913")
}
