/**
 * Tests for `teko::crypto`'s password-hashing KDFs: `scrypt` (RFC 7914, `scrypt.tks`) and
 * Argon2id (RFC 9106, `argon2.tks`). Pure Teko (no extern), so every case runs natively. This
 * file lives under `teko::crypto` (namespace = directory), so the functions under test are
 * called bare, mirroring `kdf_test.tkt`/`mac_test.tkt`.
 *
 * Every expected value is either a published RFC known-answer vector or was cross-checked
 * offline against a reference implementation before landing here:
 *   - scrypt: RFC 7914 §12's `N=16,r=1,p=1` vector verbatim, plus two `hashlib.scrypt`
 *     (Python 3.11, OpenSSL-backed) cross-checks at slightly larger `N`/`r` — kept small per
 *     this lane's own instructions so the fixture stays fast under the arena/no-GC
 *     allocation cost `scrypt.tks`'s header documents for large `N * p`.
 *   - Argon2id: RFC 9106 §5.3's official vector verbatim (`t=3, m=32 KiB, p=4`, non-empty
 *     secret and associated data — proves multi-lane end to end), plus three
 *     `argon2.low_level.core` (argon2-cffi 25.1.0, the real C reference `argon2_ctx`)
 *     cross-checks covering `p=1`, a non-empty secret/associated-data pair, and `p=2`.
 */

/**
 * A slice of `n` bytes all equal to `value` — the RFC 9106 §5.3 vector's repeated-byte
 * password/salt/secret/associated-data fields.
 *
 * @param value  the byte to repeat
 * @param n      the number of bytes
 * @return       `n` copies of `value`
 */
fn repeat_byte(value: byte, n: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, value)
        i++
    }
    out
}

/**
 * Renders a `[]byte | CryptoError` result as a lowercase hex string, or its error message on
 * failure — a `CryptoError` surfaces as a non-matching string that fails the assertion loudly.
 *
 * @param r  the result a password-KDF call returned
 * @return   the bytes as lowercase hex, or the error message
 */
fn pw_ok_hex(r: []byte | CryptoError): str {
    match r {
        []byte as b => to_hex(b)
        CryptoError as e => e.message
    }
}

/**
 * scrypt against RFC 7914 §12's smallest published vector: `scrypt("", "", N=16, r=1, p=1,
 * dkLen=64)`.
 */
#test
fn scrypt_rfc7914_vector1() {
    var dk = pw_ok_hex(scrypt(teko::list::empty(), teko::list::empty(), 16, 1, 1, 64))
    teko::assert::eq_str(dk, "77d6576238657b203b19ca42c18a0497f16b4844e3074ae8dfdffa3fede21442fcd0069ded0948f8326a753a0fc81f17e8d3e0fb2e0d3628cf35e20c38d18906")
}

/**
 * scrypt at a larger `N`/`r` (still `p=1`, kept small per this lane's instructions), cross-
 * checked offline against `hashlib.scrypt(b"password", salt=b"NaCl", n=1024, r=8, p=1,
 * dklen=64)` (Python 3.11).
 */
#test
fn scrypt_offline_cross_check() {
    var dk = pw_ok_hex(scrypt(bytes_of_str("password"), bytes_of_str("NaCl"), 1024, 8, 1, 64))
    teko::assert::eq_str(dk, "27b418c674c769d12501fbb1f53bac32df6514c0f28d043872b148b348961a79057a6861cc3553246aa0ddb63bc074450b924022547a799538d603396835dd62")
}

/**
 * scrypt rejects every invalid parameter with a `CryptoError` rather than a panic: `n` not a
 * power of two greater than 1, `r == 0`, `p == 0`, `dk_len == 0`.
 */
#test
fn scrypt_rejects_invalid_params() {
    var pw = bytes_of_str("pw")
    var salt = bytes_of_str("salt")
    match scrypt(pw, salt, 15, 1, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match scrypt(pw, salt, 1, 1, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match scrypt(pw, salt, 16, 0, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match scrypt(pw, salt, 16, 1, 0, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match scrypt(pw, salt, 16, 1, 1, 0) { []byte => teko::assert::is_true(false); CryptoError => { } }
}

/**
 * Argon2id against RFC 9106 §5.3's official known-answer vector: `t=3` passes, `m=32` KiB,
 * `p=4` lanes, a non-empty secret AND associated data — proves multi-lane addressing, the
 * secret/AD fields in `H0`, and the final cross-lane XOR all end to end.
 */
#test
fn argon2id_rfc9106_vector() {
    var pw = repeat_byte(0x01 to byte, 32)
    var salt = repeat_byte(0x02 to byte, 16)
    var secret = repeat_byte(0x03 to byte, 8)
    var ad = repeat_byte(0x04 to byte, 12)
    var tag = pw_ok_hex(argon2id(pw, salt, secret, ad, 3, 32, 4, 32))
    teko::assert::eq_str(tag, "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659")
}

/**
 * Argon2id (`p=1`, no secret/AD), cross-checked offline against `argon2.low_level.core`
 * (argon2-cffi 25.1.0, the real C reference `argon2_ctx`) with `t=2, m=8 KiB, p=1, tag=32`.
 */
#test
fn argon2id_hash_offline_cross_check() {
    var tag = pw_ok_hex(argon2id_hash(bytes_of_str("password"), bytes_of_str("somesalt"), 2, 8, 1, 32))
    teko::assert::eq_str(tag, "fdb4ddb6d5887131b66f0b2a3740c077dd05b755845861f6b5a1dde8b1071646")
}

/**
 * Argon2id with a non-empty secret and associated data (`p=1`), cross-checked offline against
 * `argon2.low_level.core` with `t=2, m=8 KiB, p=1, tag=24`.
 */
#test
fn argon2id_secret_and_ad_offline_cross_check() {
    var tag = pw_ok_hex(argon2id(bytes_of_str("pw"), bytes_of_str("saltsalt"), bytes_of_str("secretkey"), bytes_of_str("assocdata"), 2, 8, 1, 24))
    teko::assert::eq_str(tag, "f7a4495aa153e0feb67a0fe3c5c4e324ae11a1489c2ca6de")
}

/**
 * Argon2id with two lanes (`p=2`), cross-checked offline against `argon2.low_level.core` with
 * `t=2, m=16 KiB, p=2, tag=32` — proves multi-lane addressing at a second, smaller scale than
 * the RFC §5.3 vector's `p=4`.
 */
#test
fn argon2id_two_lanes_offline_cross_check() {
    var tag = pw_ok_hex(argon2id_hash(bytes_of_str("multilane"), bytes_of_str("12345678"), 2, 16, 2, 32))
    teko::assert::eq_str(tag, "be406ee566a7d838c95a1c74c818d164058d0766b41e23a8f12974b152612b49")
}

/**
 * Argon2id rejects every invalid parameter with a `CryptoError` rather than a panic:
 * `parallelism == 0`, `t_cost == 0`, `m_cost_kib` below `8 * parallelism`, a salt shorter than
 * 8 bytes, and `tag_len` below 4 bytes.
 */
#test
fn argon2id_rejects_invalid_params() {
    var pw = bytes_of_str("pw")
    var salt = bytes_of_str("saltsalt")
    var empty: []byte = teko::list::empty()
    match argon2id(pw, salt, empty, empty, 1, 8, 0, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match argon2id(pw, salt, empty, empty, 0, 8, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match argon2id(pw, salt, empty, empty, 1, 4, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match argon2id(pw, bytes_of_str("short"), empty, empty, 1, 8, 1, 32) { []byte => teko::assert::is_true(false); CryptoError => { } }
    match argon2id(pw, salt, empty, empty, 1, 8, 1, 2) { []byte => teko::assert::is_true(false); CryptoError => { } }
}
