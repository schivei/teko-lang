/**
 * Tests for `teko::crypto::aead` (C5): AES-GCM (NIST SP 800-38D), ChaCha20-Poly1305 (RFC 8439
 * §2.8), and AES-CCM (NIST SP 800-38C). Pure Teko (no extern), so every case runs natively. This
 * file lives under `teko::crypto` (namespace = directory), so the functions under test are called
 * bare, mirroring `cipher_test.tkt`/`mac_test.tkt`.
 *
 * Every expected value is a published known-answer vector — the GCM spec (McGrew & Viega) Test
 * Cases 4 and 16, RFC 8439 §2.8.2, and NIST SP 800-38C Appendix C examples 1–3 — cross-checked
 * against a reference implementation (pycryptodome).
 */

/**
 * The numeric value of one lowercase hex digit (`'0'..'9'`, `'a'..'f'`).
 *
 * @param c  a hex-digit byte
 * @return   the digit's value 0..15 (0 for a non-hex byte, which the fixtures never pass)
 */
fn hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

/**
 * Decodes an even-length lowercase hex string into the bytes it denotes — how the fixtures spell
 * the keys, nonces, AAD, plaintexts, and expected outputs given in hex.
 *
 * @param s  an even-length lowercase hex string
 * @return   the decoded bytes, most-significant nibble first
 */
fn hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = hex_val(chars[i])
        var lo = hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

/**
 * Renders an AEAD result as lowercase hex, or the sentinel `"ERR"` when it is a `CryptoError` —
 * the compact form the assertions compare against the published vectors.
 *
 * @param r  an AEAD output or a `CryptoError`
 * @return   the bytes as lowercase hex, or `"ERR"` on failure
 */
fn hexed(r: []byte | CryptoError): str {
    match r {
        []byte as x => to_hex(x)
        CryptoError => "ERR"
    }
}

/**
 * Copies `b` with its final byte flipped by one bit — the corruption that must make an `open`
 * reject the tag.
 *
 * @param b  the sealed `ciphertext ‖ tag`, at least one byte
 * @return   a fresh copy with the last byte XOR `0x01`
 */
fn flip_last(b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        var v = if i == b.len - 1 { ((b[i] to u32) ^ 1) to byte } else { b[i] }
        out = teko::list::push(out, v)
        i++
    }
    out
}

/**
 * AES-256-GCM against the GCM specification (McGrew & Viega) Test Case 16: seal produces the
 * published `ciphertext ‖ tag`, and open recovers the plaintext.
 */
#test
fn aes256_gcm_test_case_16() {
    var key = hex_bytes("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")
    var nonce = hex_bytes("cafebabefacedbaddecaf888")
    var aad = hex_bytes("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    var pt = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
    var sealed = "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f66276fc6ece0f4e1768cddf8853bb2d551b"
    teko::assert::is_true(hexed(aes_gcm_seal(key, nonce, aad, hex_bytes(pt))) == sealed)
    teko::assert::is_true(hexed(aes_gcm_open(key, nonce, aad, hex_bytes(sealed))) == pt)
}

/**
 * AES-128-GCM against the GCM specification Test Case 4: seal produces the published `ciphertext ‖
 * tag`, and open recovers the plaintext.
 */
#test
fn aes128_gcm_test_case_4() {
    var key = hex_bytes("feffe9928665731c6d6a8f9467308308")
    var nonce = hex_bytes("cafebabefacedbaddecaf888")
    var aad = hex_bytes("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    var pt = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
    var sealed = "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47"
    teko::assert::is_true(hexed(aes_gcm_seal(key, nonce, aad, hex_bytes(pt))) == sealed)
    teko::assert::is_true(hexed(aes_gcm_open(key, nonce, aad, hex_bytes(sealed))) == pt)
}

/**
 * A GCM tag that does not verify (a one-bit flip of the sealed output) is a `CryptoError`, never
 * a panic and never a leaked plaintext (M.1).
 */
#test
fn aes_gcm_rejects_forged_tag() {
    var key = hex_bytes("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308")
    var nonce = hex_bytes("cafebabefacedbaddecaf888")
    var aad = hex_bytes("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    var pt = hex_bytes("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
    var sealed = match aes_gcm_seal(key, nonce, aad, pt) { []byte as s => s; CryptoError => teko::list::empty() }
    teko::assert::is_true(hexed(aes_gcm_open(key, nonce, aad, flip_last(sealed))) == "ERR")
}

/**
 * A GCM nonce of the wrong length is a `CryptoError` at the seam (only the 96-bit path is offered).
 */
#test
fn aes_gcm_rejects_bad_nonce() {
    var key = hex_bytes("feffe9928665731c6d6a8f9467308308")
    var nonce = hex_bytes("cafebabefacedbaddecaf8")
    teko::assert::is_true(hexed(aes_gcm_seal(key, nonce, teko::list::empty(), teko::list::empty())) == "ERR")
}

/**
 * ChaCha20-Poly1305 against RFC 8439 §2.8.2 (the full worked example): seal produces the published
 * `ciphertext ‖ tag`, and open recovers the plaintext.
 */
#test
fn chacha20_poly1305_rfc8439() {
    var key = hex_bytes("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    var nonce = hex_bytes("070000004041424344454647")
    var aad = hex_bytes("50515253c0c1c2c3c4c5c6c7")
    var pt = "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e"
    var sealed = "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b61161ae10b594f09e26a7e902ecbd0600691"
    teko::assert::is_true(hexed(chacha20_poly1305_seal(key, nonce, aad, hex_bytes(pt))) == sealed)
    teko::assert::is_true(hexed(chacha20_poly1305_open(key, nonce, aad, hex_bytes(sealed))) == pt)
}

/**
 * A ChaCha20-Poly1305 tag that does not verify (a one-bit flip of the sealed output) is a
 * `CryptoError`, never a panic and never a leaked plaintext.
 */
#test
fn chacha20_poly1305_rejects_forged_tag() {
    var key = hex_bytes("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    var nonce = hex_bytes("070000004041424344454647")
    var aad = hex_bytes("50515253c0c1c2c3c4c5c6c7")
    var pt = hex_bytes("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e")
    var sealed = match chacha20_poly1305_seal(key, nonce, aad, pt) { []byte as s => s; CryptoError => teko::list::empty() }
    teko::assert::is_true(hexed(chacha20_poly1305_open(key, nonce, aad, flip_last(sealed))) == "ERR")
}

/**
 * AES-CCM against NIST SP 800-38C Appendix C example 1: 7-byte nonce, 8-byte AAD, 4-byte
 * plaintext, 4-byte tag — seal produces the published output and open recovers the plaintext.
 */
#test
fn aes_ccm_nist_example_1() {
    var key = hex_bytes("404142434445464748494a4b4c4d4e4f")
    var nonce = hex_bytes("10111213141516")
    var aad = hex_bytes("0001020304050607")
    var pt = "20212223"
    var sealed = "7162015b4dac255d"
    teko::assert::is_true(hexed(aes_ccm_seal(key, nonce, aad, hex_bytes(pt), 4)) == sealed)
    teko::assert::is_true(hexed(aes_ccm_open(key, nonce, aad, hex_bytes(sealed), 4)) == pt)
}

/**
 * AES-CCM against NIST SP 800-38C example 2: 8-byte nonce, 16-byte AAD, 16-byte plaintext, 6-byte
 * tag.
 */
#test
fn aes_ccm_nist_example_2() {
    var key = hex_bytes("404142434445464748494a4b4c4d4e4f")
    var nonce = hex_bytes("1011121314151617")
    var aad = hex_bytes("000102030405060708090a0b0c0d0e0f")
    var pt = "202122232425262728292a2b2c2d2e2f"
    var sealed = "d2a1f0e051ea5f62081a7792073d593d1fc64fbfaccd"
    teko::assert::is_true(hexed(aes_ccm_seal(key, nonce, aad, hex_bytes(pt), 6)) == sealed)
    teko::assert::is_true(hexed(aes_ccm_open(key, nonce, aad, hex_bytes(sealed), 6)) == pt)
}

/**
 * AES-CCM against NIST SP 800-38C example 3: 12-byte nonce, 20-byte AAD, 24-byte plaintext, 8-byte
 * tag — and a one-bit flip of the sealed output must be rejected.
 */
#test
fn aes_ccm_nist_example_3() {
    var key = hex_bytes("404142434445464748494a4b4c4d4e4f")
    var nonce = hex_bytes("101112131415161718191a1b")
    var aad = hex_bytes("000102030405060708090a0b0c0d0e0f10111213")
    var pt = "202122232425262728292a2b2c2d2e2f3031323334353637"
    var sealed = "e3b201a9f5b71a7a9b1ceaeccd97e70b6176aad9a4428aa5484392fbc1b09951"
    teko::assert::is_true(hexed(aes_ccm_seal(key, nonce, aad, hex_bytes(pt), 8)) == sealed)
    teko::assert::is_true(hexed(aes_ccm_open(key, nonce, aad, hex_bytes(sealed), 8)) == pt)
    teko::assert::is_true(hexed(aes_ccm_open(key, nonce, aad, flip_last(hex_bytes(sealed)), 8)) == "ERR")
}
