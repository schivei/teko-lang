use teko::numeric::bigint

/**
 * `teko::crypto::rsa` — RSA public-key signature primitives (PKCS#1 v2.2 / RFC 8017), the first
 * lane of the document-signing critical path: it unblocks JOSE RS256/384/512 and PS256/384/512,
 * XML-DSig `rsa-sha256`, and RSA COSE. ECDSA and Ed25519 are a separate, later lane — this file
 * does not attempt them.
 *
 * BUILT ON `teko::numeric::bigint`. Every modular operation (RSASP1/RSAVP1, the padding
 * integer↔octet-string conversions) is `mod_pow` / `from_bytes_be` / `to_bytes_be_padded` from
 * the existing arbitrary-precision engine — this file adds no new bignum arithmetic, only the
 * RSA key shape and the two PKCS#1 encoding schemes (EMSA-PKCS1-v1_5 and EMSA-PSS/MGF1) layered
 * on top.
 *
 * KEYS ARE RAW COMPONENTS, NOT ASN.1. `RsaPublicKey`/`RsaPrivateKey` hold the modulus and
 * exponent(s) as `BigInt`s directly; ASN.1/DER (`SubjectPublicKeyInfo`, `PKCS#1`/`PKCS#8`
 * key files) is not implemented yet, so keys are built from raw big-endian bytes or hex text.
 *
 * NO CRT. `RsaPrivateKey` is the plain `(n, d, e)` form — the private exponent `d` is applied
 * directly via `mod_pow`, not the ~4x-faster CRT decomposition (`p, q, dp, dq, qinv`). This is a
 * deliberate scope cut (YAGNI): CRT only speeds up signing, changes nothing about the wire
 * format or the signature produced, and can be layered in later as a pure performance follow-up
 * without touching this file's public surface.
 *
 * FLAT SURFACE (the convention shipped by `teko::crypto::hash`/`mac`/`aead`): every function
 * lives directly under `teko::crypto` and is called bare from sibling crypto files and from
 * tests — `rsa_sign_pkcs1v15`, not `teko::crypto::rsa::sign_pkcs1v15`.
 *
 * ERRORS ARE VALUES. Every fallible operation (a modulus too small for the padding, a malformed
 * key component, a not-yet-RSAVP1-in-range signature) returns `CryptoError` — this file's own
 * `crypto_error`/`CryptoError` reuse (`teko::crypto` core, `crypto.tks`), never a second error
 * type. Verification never panics: an ill-formed signature is simply `false`.
 *
 * NO INDEX-ASSIGNMENT. Every byte buffer here is built by `teko::list::push` (functional
 * growth), the same discipline `teko::crypto::hash`/`mac`/`aead` already use.
 */

/**
 * An RSA public key: the modulus `n` and the public exponent `e` (RFC 8017 §3.1), both raw
 * `BigInt` components — no ASN.1 wrapping.
 */
exp type RsaPublicKey = struct {
    /** the RSA modulus, `n = p * q` */
    n: bigint::BigInt
    /** the public exponent */
    e: bigint::BigInt
}

/**
 * An RSA private key in the plain (non-CRT) form: the modulus `n`, the private exponent `d`, and
 * the public exponent `e` (RFC 8017 §3.2, the "first representation"). `e` is carried alongside
 * `d`/`n` purely for the caller's convenience (e.g. deriving the matching `RsaPublicKey`); the
 * signing primitive itself only reads `n` and `d`.
 */
exp type RsaPrivateKey = struct {
    /** the RSA modulus, `n = p * q` */
    n: bigint::BigInt
    /** the private exponent */
    d: bigint::BigInt
    /** the public exponent (carried for convenience; unused by `mod_pow`-based signing) */
    e: bigint::BigInt
}

/**
 * The hash algorithm selecting both a digest primitive and its EMSA-PKCS1-v1_5 `DigestInfo`
 * prefix / EMSA-PSS parameters. Limited to the three SHA-2 members PKCS#1 v2.2 lists for RSA
 * signatures at production strength; SHA-1/MD5 are legacy-broken and deliberately excluded here
 * even though `teko::crypto::hash` still ships them for other interop.
 */
exp type RsaHashAlg = enum { Sha256; Sha384; Sha512 }

/**
 * The digest of `data` under `alg`, dispatching to the matching `teko::crypto::hash` one-shot
 * function.
 *
 * @param alg   the selected hash algorithm
 * @param data  the bytes to hash
 * @return      the digest (32, 48, or 64 bytes for SHA-256/384/512)
 */
fn rsa_hash(alg: RsaHashAlg, data: []byte): []byte {
    match alg {
        Sha256 => sha256_of(data)
        Sha384 => sha384_of(data)
        Sha512 => sha512_of(data)
    }
}

/**
 * The digest length in bytes `alg` produces — `hLen` in RFC 8017's notation.
 *
 * @param alg  the selected hash algorithm
 * @return     32, 48, or 64
 */
fn rsa_hash_len(alg: RsaHashAlg): u64 {
    match alg {
        Sha256 => 32
        Sha384 => 48
        Sha512 => 64
    }
}

/**
 * DIGEST_INFO_SHA256 — the ASN.1 DER `DigestInfo` prefix (algorithm identifier, no trailing
 * digest) EMSA-PKCS1-v1_5 prepends to a SHA-256 digest (RFC 8017 §9.2, RFC 3447 Appendix B).
 */
const DIGEST_INFO_SHA256: []byte = [
    0x30 to byte, 0x31 to byte, 0x30 to byte, 0x0d to byte, 0x06 to byte, 0x09 to byte,
    0x60 to byte, 0x86 to byte, 0x48 to byte, 0x01 to byte, 0x65 to byte, 0x03 to byte,
    0x04 to byte, 0x02 to byte, 0x01 to byte, 0x05 to byte, 0x00 to byte, 0x04 to byte,
    0x20 to byte
]

/**
 * DIGEST_INFO_SHA384 — the ASN.1 DER `DigestInfo` prefix for a SHA-384 digest.
 */
const DIGEST_INFO_SHA384: []byte = [
    0x30 to byte, 0x41 to byte, 0x30 to byte, 0x0d to byte, 0x06 to byte, 0x09 to byte,
    0x60 to byte, 0x86 to byte, 0x48 to byte, 0x01 to byte, 0x65 to byte, 0x03 to byte,
    0x04 to byte, 0x02 to byte, 0x02 to byte, 0x05 to byte, 0x00 to byte, 0x04 to byte,
    0x30 to byte
]

/**
 * DIGEST_INFO_SHA512 — the ASN.1 DER `DigestInfo` prefix for a SHA-512 digest.
 */
const DIGEST_INFO_SHA512: []byte = [
    0x30 to byte, 0x51 to byte, 0x30 to byte, 0x0d to byte, 0x06 to byte, 0x09 to byte,
    0x60 to byte, 0x86 to byte, 0x48 to byte, 0x01 to byte, 0x65 to byte, 0x03 to byte,
    0x04 to byte, 0x02 to byte, 0x03 to byte, 0x05 to byte, 0x00 to byte, 0x04 to byte,
    0x40 to byte
]

/**
 * The ASN.1 DER `DigestInfo` prefix EMSA-PKCS1-v1_5 prepends to a digest under `alg`.
 *
 * @param alg  the selected hash algorithm
 * @return     the 19-byte `DigestInfo` prefix for `alg`
 */
fn rsa_digest_info_prefix(alg: RsaHashAlg): []byte {
    match alg {
        Sha256 => DIGEST_INFO_SHA256
        Sha384 => DIGEST_INFO_SHA384
        Sha512 => DIGEST_INFO_SHA512
    }
}

/**
 * Concatenates `a` then `b` into a fresh `[]byte` — this file's own copy of the block-join
 * helper every crypto file in this namespace carries privately (mirroring `hash.tks`'s
 * `bytes_concat` / `mac.tks`'s equivalent).
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   a fresh slice holding `a`'s bytes followed by `b`'s bytes
 */
fn rsa_bytes_concat(a: []byte, b: []byte): []byte {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * The sub-slice `data[from..to)` as a fresh `[]byte`.
 *
 * @param data  the source slice
 * @param from  the inclusive start index
 * @param to    the exclusive end index
 * @return      a fresh slice holding `data[from..to)`
 */
fn rsa_bytes_slice(data: []byte, from: u64, to: u64): []byte {
    var out: []byte = teko::list::empty()
    var i = from
    loop {
        if i >= to { break }
        out = teko::list::push(out, data[i])
        i++
    }
    out
}

/**
 * Build an `RsaPublicKey` from its raw big-endian byte components (`OS2IP` on each).
 *
 * @param n  the modulus, most-significant byte first
 * @param e  the public exponent, most-significant byte first
 * @return   the assembled public key
 */
exp fn rsa_public_key_from_bytes_be(n: []byte, e: []byte): RsaPublicKey {
    RsaPublicKey { n = bigint::from_bytes_be(n); e = bigint::from_bytes_be(e) }
}

/**
 * Build an `RsaPrivateKey` (plain, non-CRT) from its raw big-endian byte components.
 *
 * @param n  the modulus, most-significant byte first
 * @param d  the private exponent, most-significant byte first
 * @param e  the public exponent, most-significant byte first
 * @return   the assembled private key
 */
exp fn rsa_private_key_from_bytes_be(n: []byte, d: []byte, e: []byte): RsaPrivateKey {
    RsaPrivateKey { n = bigint::from_bytes_be(n); d = bigint::from_bytes_be(d); e = bigint::from_bytes_be(e) }
}

/**
 * Build an `RsaPublicKey` from hexadecimal component text (see `bigint::from_hex` for the
 * accepted syntax: optional `0x` prefix, either digit case, `_` separators).
 *
 * @param n_hex  the modulus in hexadecimal
 * @param e_hex  the public exponent in hexadecimal
 * @return       the assembled public key, or a `CryptoError` naming the malformed component
 * @throws       `CryptoError` when `n_hex` or `e_hex` is not valid hexadecimal
 */
exp fn rsa_public_key_from_hex(n_hex: str, e_hex: str): RsaPublicKey | CryptoError {
    var n = match bigint::from_hex(n_hex) {
        bigint::BigInt as b => b
        error => return crypto_error("rsa_public_key_from_hex: invalid modulus hex")
    }
    var e = match bigint::from_hex(e_hex) {
        bigint::BigInt as b => b
        error => return crypto_error("rsa_public_key_from_hex: invalid exponent hex")
    }
    RsaPublicKey { n = n; e = e }
}

/**
 * Build an `RsaPrivateKey` (plain, non-CRT) from hexadecimal component text.
 *
 * @param n_hex  the modulus in hexadecimal
 * @param d_hex  the private exponent in hexadecimal
 * @param e_hex  the public exponent in hexadecimal
 * @return       the assembled private key, or a `CryptoError` naming the malformed component
 * @throws       `CryptoError` when `n_hex`, `d_hex`, or `e_hex` is not valid hexadecimal
 */
exp fn rsa_private_key_from_hex(n_hex: str, d_hex: str, e_hex: str): RsaPrivateKey | CryptoError {
    var n = match bigint::from_hex(n_hex) {
        bigint::BigInt as b => b
        error => return crypto_error("rsa_private_key_from_hex: invalid modulus hex")
    }
    var d = match bigint::from_hex(d_hex) {
        bigint::BigInt as b => b
        error => return crypto_error("rsa_private_key_from_hex: invalid private exponent hex")
    }
    var e = match bigint::from_hex(e_hex) {
        bigint::BigInt as b => b
        error => return crypto_error("rsa_private_key_from_hex: invalid public exponent hex")
    }
    RsaPrivateKey { n = n; d = d; e = e }
}

/**
 * The modulus size in bytes, `k = ceil(bit_length(n) / 8)` — RFC 8017's `k`, the fixed width of
 * every signature representative and the padding schemes' `emLen` for a byte-aligned key.
 *
 * @param n  the RSA modulus
 * @return   the modulus size in bytes
 */
fn rsa_modulus_len_bytes(n: bigint::BigInt): u64 {
    (bigint::bit_length(n) + 7) / 8
}

/**
 * RSASP1 (RFC 8017 §5.2.1): the raw signature primitive `s = m^d mod n`. Not constant-time
 * (inherits `bigint::mod_pow`'s exponent-bit branching); hardening is tracked alongside that
 * engine's own documented follow-up.
 *
 * @param priv  the signer's private key
 * @param m     the message representative, `0 <= m < n`
 * @return      the signature representative `s`
 * @throws      `CryptoError` when the underlying `mod_pow` rejects the modulus or exponent
 */
fn rsa_sp1(priv: RsaPrivateKey, m: bigint::BigInt): bigint::BigInt | CryptoError {
    match bigint::mod_pow(m, priv.d, priv.n) {
        bigint::BigInt as s => s
        error => crypto_error("rsa_sp1: mod_pow failed")
    }
}

/**
 * RSAVP1 (RFC 8017 §5.2.2): the raw verification primitive `m = s^e mod n`, first rejecting a
 * signature representative outside `[0, n)` (RFC 8017 §5.2.2 step 1) as a `CryptoError` rather
 * than silently reducing it.
 *
 * @param pubkey  the signer's public key
 * @param s       the signature representative
 * @return        the recovered message representative `m`
 * @throws        `CryptoError` when `s` is out of range, or the underlying `mod_pow` fails
 */
fn rsa_vp1(pubkey: RsaPublicKey, s: bigint::BigInt): bigint::BigInt | CryptoError {
    if bigint::is_neg(s) || bigint::cmp(s, pubkey.n) >= 0 {
        return crypto_error("rsa_vp1: signature representative out of range")
    }
    match bigint::mod_pow(s, pubkey.e, pubkey.n) {
        bigint::BigInt as m => m
        error => crypto_error("rsa_vp1: mod_pow failed")
    }
}

/**
 * EMSA-PKCS1-v1_5 encode (RFC 8017 §9.2): `0x00 || 0x01 || PS || 0x00 || DigestInfo`, where `PS`
 * is `em_len - tLen - 3` bytes of `0xFF` and `DigestInfo` is the ASN.1 prefix for `alg` followed
 * by `Hash(message)`. Rejects an `em_len` too small to hold at least 8 padding bytes.
 *
 * @param alg      the hash algorithm
 * @param message  the message to encode
 * @param em_len   the intended encoded-message length (the modulus size in bytes, `k`)
 * @return         the `em_len`-byte encoded message
 * @throws         `CryptoError` when `em_len` is too small for the digest and minimum padding
 */
fn rsa_emsa_pkcs1_v15_encode(alg: RsaHashAlg, message: []byte, em_len: u64): []byte | CryptoError {
    var t = rsa_bytes_concat(rsa_digest_info_prefix(alg), rsa_hash(alg, message))
    if em_len < t.len + 11 {
        return crypto_error("rsa_emsa_pkcs1_v15_encode: intended encoded message length too short")
    }
    var ps_len = em_len - t.len - 3
    var out: []byte = teko::list::empty()
    out = teko::list::push(out, 0x00 to byte)
    out = teko::list::push(out, 0x01 to byte)
    var i: u64 = 0
    loop {
        if i >= ps_len { break }
        out = teko::list::push(out, 0xFF to byte)
        i++
    }
    out = teko::list::push(out, 0x00 to byte)
    rsa_bytes_concat(out, t)
}

/**
 * RSASSA-PKCS1-v1_5 sign (RFC 8017 §8.2.1): EMSA-PKCS1-v1_5-encode the message to the modulus
 * width, convert to an integer (`OS2IP`), apply RSASP1, and convert the result back to a
 * `k`-byte signature (`I2OSP`). Deterministic — the same key/hash/message always produces the
 * same signature, matching every PKCS#1 v1.5 reference implementation byte-for-byte.
 *
 * @param priv      the signer's private key
 * @param hash_alg  the hash algorithm (drives both the digest and the `DigestInfo` prefix)
 * @param message   the message to sign
 * @return          the `k`-byte signature, or a `CryptoError` on a too-small modulus
 * @throws          `CryptoError` when the modulus is too small for the chosen hash's `DigestInfo`
 */
exp fn rsa_sign_pkcs1v15(priv: RsaPrivateKey, hash_alg: RsaHashAlg, message: []byte): []byte | CryptoError {
    var k = rsa_modulus_len_bytes(priv.n)
    var em = match rsa_emsa_pkcs1_v15_encode(hash_alg, message, k) {
        []byte as b => b
        CryptoError as err => return err
    }
    var s = match rsa_sp1(priv, bigint::from_bytes_be(em)) {
        bigint::BigInt as b => b
        CryptoError as err => return err
    }
    match bigint::to_bytes_be_padded(s, k) {
        []byte as b => b
        error => crypto_error("rsa_sign_pkcs1v15: signature encoding failed")
    }
}

/**
 * RSASSA-PKCS1-v1_5 verify (RFC 8017 §8.2.2): reject a wrong-length signature, apply RSAVP1,
 * re-encode the message the same way `rsa_sign_pkcs1v15` did, and compare the two encodings with
 * `ct_eq`. Never panics — every malformed input (wrong length, out-of-range representative, a
 * too-small modulus) simply yields `false`.
 *
 * @param pubkey    the signer's public key
 * @param hash_alg  the hash algorithm the signature was produced under
 * @param message   the message whose signature is being checked
 * @param sig       the candidate signature
 * @return          `true` iff `sig` is a genuine RSASSA-PKCS1-v1_5 signature of `message`
 */
exp fn rsa_verify_pkcs1v15(pubkey: RsaPublicKey, hash_alg: RsaHashAlg, message: []byte, sig: []byte): bool {
    var k = rsa_modulus_len_bytes(pubkey.n)
    if sig.len != k {
        return false
    }
    var m = match rsa_vp1(pubkey, bigint::from_bytes_be(sig)) {
        bigint::BigInt as b => b
        CryptoError => return false
    }
    var em_actual = match bigint::to_bytes_be_padded(m, k) {
        []byte as b => b
        error => return false
    }
    var em_expected = match rsa_emsa_pkcs1_v15_encode(hash_alg, message, k) {
        []byte as b => b
        CryptoError => return false
    }
    ct_eq(em_actual, em_expected)
}

/**
 * `I2OSP(counter, 4)` — a 32-bit counter as 4 big-endian bytes, the `C` term MGF1 (RFC 8017
 * Appendix B.2.1) appends to its seed on every iteration.
 *
 * @param counter  the MGF1 iteration counter
 * @return         the 4-byte big-endian encoding of `counter`
 */
fn rsa_i2osp_counter(counter: u64): []byte {
    var out: []byte = teko::list::empty()
    out = teko::list::push(out, ((counter >> 24) & 0xFF) to byte)
    out = teko::list::push(out, ((counter >> 16) & 0xFF) to byte)
    out = teko::list::push(out, ((counter >> 8) & 0xFF) to byte)
    out = teko::list::push(out, (counter & 0xFF) to byte)
    out
}

/**
 * MGF1 (RFC 8017 Appendix B.2.1): the mask generation function built from `alg` — repeatedly
 * hashes `seed || I2OSP(counter, 4)` for `counter = 0, 1, …` and concatenates the digests until
 * at least `mask_len` bytes are available, then truncates to exactly `mask_len`.
 *
 * @param alg       the hash algorithm underlying the mask generation
 * @param seed      the seed bytes
 * @param mask_len  the desired mask length in bytes
 * @return          the `mask_len`-byte mask
 */
fn rsa_mgf1(alg: RsaHashAlg, seed: []byte, mask_len: u64): []byte {
    var out: []byte = teko::list::empty()
    var counter: u64 = 0
    loop {
        if out.len >= mask_len { break }
        out = rsa_bytes_concat(out, rsa_hash(alg, rsa_bytes_concat(seed, rsa_i2osp_counter(counter))))
        counter++
    }
    rsa_bytes_slice(out, 0, mask_len)
}

/**
 * Eight zero bytes — the fixed `0x00 * 8` prefix EMSA-PSS prepends to `mHash || salt` before
 * hashing it into `H` (RFC 8017 §9.1.1 step 6).
 *
 * @return  8 zero bytes
 */
fn rsa_pss_zero8(): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        out = teko::list::push(out, 0 to byte)
        i++
    }
    out
}

/**
 * XORs two equal-length byte slices — the `maskedDB = DB ⊕ dbMask` step of EMSA-PSS (both
 * encode and verify).
 *
 * @param a  the first slice
 * @param b  the second slice (must be at least as long as `a`)
 * @return   a fresh slice with `a[i] ⊕ b[i]` at every index
 */
fn rsa_pss_xor(a: []byte, b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        out = teko::list::push(out, ((a[i] to u32) ^ (b[i] to u32)) to byte)
        i++
    }
    out
}

/**
 * The bitmask keeping only the low `8 - n_bits` bits of a byte — the complement of EMSA-PSS's
 * "set the leftmost `n_bits` bits to zero" instruction (RFC 8017 §9.1.1 step 11 / §9.1.2 step
 * 9). `n_bits` is always `8 * emLen - emBits`, which RFC 8017 guarantees is in `[0, 8)`.
 *
 * @param n_bits  the number of leading bits to clear, `0 <= n_bits < 8`
 * @return        the keep-mask for the remaining low bits
 */
fn rsa_pss_keep_mask(n_bits: u32): u32 {
    (0xFF to u32) >> n_bits
}

/**
 * Clears the leftmost `n_bits` bits of `buf`'s first byte, leaving the rest unchanged — EMSA-PSS
 * encode's step 11 (masked-DB) and verify's step 9 (recovered DB) share this exact operation.
 *
 * @param buf     the byte slice (must be non-empty when `n_bits > 0`)
 * @param n_bits  the number of leading bits to clear, `0 <= n_bits < 8`
 * @return        a fresh slice with the top `n_bits` bits of byte 0 cleared
 */
fn rsa_pss_clear_top_bits(buf: []byte, n_bits: u32): []byte {
    if n_bits == 0 || buf.len == 0 {
        return buf
    }
    var out: []byte = teko::list::empty()
    out = teko::list::push(out, ((buf[0] to u32) & rsa_pss_keep_mask(n_bits)) to byte)
    var i: u64 = 1
    loop {
        if i >= buf.len { break }
        out = teko::list::push(out, buf[i])
        i++
    }
    out
}

/**
 * Checks that the leftmost `n_bits` bits of `buf`'s first byte are already zero — EMSA-PSS
 * verify's step 8 consistency check on `maskedDB` before unmasking.
 *
 * @param buf     the byte slice
 * @param n_bits  the number of leading bits that must be zero, `0 <= n_bits < 8`
 * @return        `true` iff every one of those leading bits is zero (vacuously true when
 *                `n_bits` is 0 or `buf` is empty)
 */
fn rsa_pss_top_bits_clear(buf: []byte, n_bits: u32): bool {
    if n_bits == 0 || buf.len == 0 {
        return true
    }
    var clear_mask = (0xFF to u32) ^ rsa_pss_keep_mask(n_bits)
    ((buf[0] to u32) & clear_mask) == 0
}

/**
 * Recovers the salt from a decoded EMSA-PSS `DB` block: scans past the leading `0x00` run,
 * requires the next byte to be exactly `0x01`, and returns everything after it as the salt (RFC
 * 8017 §9.1.2 step 10). The salt length is not a parameter — PSS verification always recovers it
 * from the padding itself.
 *
 * @param db  the unmasked, top-bits-cleared `DB` block
 * @return    the salt, or a `CryptoError` when the `0x00* || 0x01` separator is malformed
 * @throws    `CryptoError` when `db` has no `0x01` separator after its leading zero run
 */
fn rsa_pss_extract_salt(db: []byte): []byte | CryptoError {
    var i: u64 = 0
    loop {
        if i >= db.len {
            return crypto_error("rsa_pss_extract_salt: no 0x01 separator found")
        }
        if db[i] != 0x00 to byte {
            break
        }
        i++
    }
    if db[i] != 0x01 to byte {
        return crypto_error("rsa_pss_extract_salt: malformed 0x01 separator")
    }
    rsa_bytes_slice(db, i + 1, db.len)
}

/**
 * EMSA-PSS encode (RFC 8017 §9.1.1) with a CALLER-SUPPLIED salt (rather than a randomly drawn
 * one), so signing is deterministic and testable: hashes the message, builds
 * `M' = 0x00^8 || mHash || salt`, hashes `M'` into `H`, masks `PS || 0x01 || salt` with
 * `MGF1(H, …)`, clears the top bits the modulus width demands, and appends `H || 0xbc`.
 *
 * @param alg      the hash algorithm
 * @param message  the message to encode
 * @param salt     the salt bytes (any length that fits the modulus; empty is allowed)
 * @param em_bits  the intended encoded-message bit length, `modBits - 1`
 * @return         the encoded message, `ceil(em_bits / 8)` bytes
 * @throws         `CryptoError` when the modulus is too small to hold the digest and salt
 */
fn rsa_emsa_pss_encode(alg: RsaHashAlg, message: []byte, salt: []byte, em_bits: u64): []byte | CryptoError {
    var h_len = rsa_hash_len(alg)
    var em_len = (em_bits + 7) / 8
    if em_len < h_len + salt.len + 2 {
        return crypto_error("rsa_emsa_pss_encode: modulus too small for digest and salt")
    }
    var m_prime = rsa_bytes_concat(rsa_bytes_concat(rsa_pss_zero8(), rsa_hash(alg, message)), salt)
    var h = rsa_hash(alg, m_prime)
    var ps_len = em_len - salt.len - h_len - 2
    var db: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= ps_len { break }
        db = teko::list::push(db, 0 to byte)
        i++
    }
    db = teko::list::push(db, 0x01 to byte)
    db = rsa_bytes_concat(db, salt)
    var masked_db = rsa_pss_xor(db, rsa_mgf1(alg, h, em_len - h_len - 1))
    var clear_bits = (8 * em_len - em_bits) to u32
    var em = rsa_bytes_concat(rsa_pss_clear_top_bits(masked_db, clear_bits), h)
    teko::list::push(em, 0xbc to byte)
}

/**
 * EMSA-PSS verify (RFC 8017 §9.1.2): checks the trailing `0xbc`, the cleared top bits of the
 * masked `DB`, unmasks it with `MGF1`, recovers the salt, rebuilds `M'`, and compares `Hash(M')`
 * against the embedded `H` with `ct_eq`. Never panics on malformed input — every structural
 * failure (short `em`, wrong trailer, unclear top bits, missing `0x01` separator) is `false`.
 *
 * @param alg      the hash algorithm
 * @param message  the message whose encoding is being checked
 * @param em       the candidate encoded message
 * @param em_bits  the intended encoded-message bit length, `modBits - 1`
 * @return         `true` iff `em` is a valid EMSA-PSS encoding of `message` under `alg`
 */
fn rsa_emsa_pss_verify(alg: RsaHashAlg, message: []byte, em: []byte, em_bits: u64): bool {
    var h_len = rsa_hash_len(alg)
    var em_len = em.len
    if em_len < h_len + 2 {
        return false
    }
    if em[em_len - 1] != 0xbc to byte {
        return false
    }
    var db_len = em_len - h_len - 1
    var masked_db = rsa_bytes_slice(em, 0, db_len)
    var h = rsa_bytes_slice(em, db_len, db_len + h_len)
    var clear_bits = (8 * em_len - em_bits) to u32
    if !rsa_pss_top_bits_clear(masked_db, clear_bits) {
        return false
    }
    var db = rsa_pss_clear_top_bits(rsa_pss_xor(masked_db, rsa_mgf1(alg, h, db_len)), clear_bits)
    var salt = match rsa_pss_extract_salt(db) {
        []byte as s => s
        CryptoError => return false
    }
    var m_prime = rsa_bytes_concat(rsa_bytes_concat(rsa_pss_zero8(), rsa_hash(alg, message)), salt)
    ct_eq(rsa_hash(alg, m_prime), h)
}

/**
 * RSASSA-PSS sign (RFC 8017 §8.1.1) with a CALLER-SUPPLIED salt: EMSA-PSS-encode the message
 * (see `rsa_emsa_pss_encode` for why the salt is a parameter, not randomly drawn), convert to an
 * integer, apply RSASP1, and convert back to a `k`-byte signature.
 *
 * @param priv      the signer's private key
 * @param hash_alg  the hash algorithm
 * @param message   the message to sign
 * @param salt      the salt bytes (the caller owns freshness/randomness policy)
 * @return          the `k`-byte signature, or a `CryptoError` on a too-small modulus
 * @throws          `CryptoError` when the modulus is too small for the chosen hash and salt
 */
exp fn rsa_sign_pss(priv: RsaPrivateKey, hash_alg: RsaHashAlg, message: []byte, salt: []byte): []byte | CryptoError {
    var mod_bits = bigint::bit_length(priv.n)
    if mod_bits == 0 {
        return crypto_error("rsa_sign_pss: modulus must be positive")
    }
    var em_bits = mod_bits - 1
    var em = match rsa_emsa_pss_encode(hash_alg, message, salt, em_bits) {
        []byte as b => b
        CryptoError as err => return err
    }
    var s = match rsa_sp1(priv, bigint::from_bytes_be(em)) {
        bigint::BigInt as b => b
        CryptoError as err => return err
    }
    match bigint::to_bytes_be_padded(s, rsa_modulus_len_bytes(priv.n)) {
        []byte as b => b
        error => crypto_error("rsa_sign_pss: signature encoding failed")
    }
}

/**
 * RSASSA-PSS verify (RFC 8017 §8.1.2): reject a wrong-length signature, apply RSAVP1, and check
 * the recovered integer's EMSA-PSS encoding against `message` (the salt length is recovered
 * from the padding, never a parameter here). Never panics.
 *
 * @param pubkey    the signer's public key
 * @param hash_alg  the hash algorithm the signature was produced under
 * @param message   the message whose signature is being checked
 * @param sig       the candidate signature
 * @return          `true` iff `sig` is a valid RSASSA-PSS signature of `message`
 */
exp fn rsa_verify_pss(pubkey: RsaPublicKey, hash_alg: RsaHashAlg, message: []byte, sig: []byte): bool {
    var k = rsa_modulus_len_bytes(pubkey.n)
    if sig.len != k {
        return false
    }
    var mod_bits = bigint::bit_length(pubkey.n)
    if mod_bits == 0 {
        return false
    }
    var em_bits = mod_bits - 1
    var m = match rsa_vp1(pubkey, bigint::from_bytes_be(sig)) {
        bigint::BigInt as b => b
        CryptoError => return false
    }
    var em = match bigint::to_bytes_be_padded(m, (em_bits + 7) / 8) {
        []byte as b => b
        error => return false
    }
    rsa_emsa_pss_verify(hash_alg, message, em, em_bits)
}
