/**
 * Tests for `teko::crypto::mac` (C2, issue #195): HMAC (RFC 2104/4231), Poly1305 (RFC 8439),
 * CMAC subkeys (NIST SP 800-38B), and the pure GHASH core (NIST SP 800-38D). Pure Teko (no
 * extern), so every case runs natively. This file lives under `teko::crypto` (namespace =
 * directory), so the functions under test are called bare, mirroring `hash_test.tkt`.
 *
 * The CMAC/GMAC block-cipher SEAM (`cmac_with_cipher`/`gmac_with_cipher`) is exercised with a
 * deterministic mock cipher (`E(x) = x ⊕ K`) so the CBC/GHASH plumbing is verified independently
 * of AES (Lane 4, not yet implemented); the algorithm-specific pieces (`cmac_gen_subkeys`,
 * `ghash`) are checked against their published cipher-free vectors.
 */

/**
 * The numeric value of one lowercase hex digit (`'0'..'9'`, `'a'..'f'`).
 *
 * @param c  a hex-digit byte
 * @return   the digit's value 0..15 (0 for a non-hex byte, which the fixtures never pass)
 */
fn hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

/**
 * Decodes an even-length lowercase hex string into the bytes it denotes — how the fixtures spell
 * the RFC/NIST keys and expected values given in hex.
 *
 * @param s  an even-length lowercase hex string
 * @return   the decoded bytes, most-significant nibble first
 */
fn hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = hex_val(chars[i])
        var lo = hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

/**
 * A slice of `n` bytes all equal to `value` — the repeated-byte keys/data of RFC 4231.
 *
 * @param value  the byte to repeat (only the low 8 bits are used)
 * @param n      the number of bytes
 * @return       `n` copies of `value`
 */
fn repeat_byte(value: u32, n: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, value to byte)
        i++
    }
    out
}

/**
 * The ascending byte sequence `start, start+1, …` of length `count` (wrapping at 256) — RFC 4231
 * test case 4's `0x01..0x19` key and the CMAC/GMAC mock inputs.
 *
 * @param start  the first byte value
 * @param count  the number of bytes
 * @return       the ascending byte run
 */
fn byte_range(start: u32, count: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= count { break }
        out = teko::list::push(out, (start + (i to u32)) to byte)
        i++
    }
    out
}

/**
 * The deterministic mock block cipher `E(x) = x ⊕ (0x00,0x01,…,0x0f)` — a bijection standing in
 * for AES so the CMAC/GMAC seam plumbing is testable without a real cipher. Its outputs match the
 * Python oracle that generated the expected CMAC/GMAC values in this file.
 *
 * @param b  the 16-byte input block
 * @return   the 16-byte "encrypted" block
 */
fn mock_encrypt_block(b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        out = teko::list::push(out, ((b[i] to u32) ^ (i to u32)) to byte)
        i++
    }
    out
}

/**
 * HMAC-SHA-256 against every RFC 4231 known-answer vector (test cases 1..7). Test case 5's value
 * is the full 256-bit tag (the RFC truncates it to 128 bits; the untruncated tag is the KAT here).
 */
#test
fn hmac_sha256_rfc4231() {
    teko::assert::is_true(hmac_sha256_hex_of(repeat_byte(0x0b, 20), bytes_of_str("Hi There")) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    teko::assert::is_true(hmac_sha256_hex_of(bytes_of_str("Jefe"), bytes_of_str("what do ya want for nothing?")) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    teko::assert::is_true(hmac_sha256_hex_of(repeat_byte(0xaa, 20), repeat_byte(0xdd, 50)) == "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    teko::assert::is_true(hmac_sha256_hex_of(byte_range(1, 25), repeat_byte(0xcd, 50)) == "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    teko::assert::is_true(hmac_sha256_hex_of(repeat_byte(0x0c, 20), bytes_of_str("Test With Truncation")) == "a3b6167473100ee06e0c796c2955552bfa6f7c0a6a8aef8b93f860aab0cd20c5")
    teko::assert::is_true(hmac_sha256_hex_of(repeat_byte(0xaa, 131), bytes_of_str("Test Using Larger Than Block-Size Key - Hash Key First")) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    teko::assert::is_true(hmac_sha256_hex_of(repeat_byte(0xaa, 131), bytes_of_str("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")) == "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
}

/**
 * HMAC-SHA-512 against every RFC 4231 known-answer vector (test cases 1..7). Test case 5's value
 * is the full 512-bit tag (the RFC truncates it to 128 bits).
 */
#test
fn hmac_sha512_rfc4231() {
    teko::assert::is_true(hmac_sha512_hex_of(repeat_byte(0x0b, 20), bytes_of_str("Hi There")) == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854")
    teko::assert::is_true(hmac_sha512_hex_of(bytes_of_str("Jefe"), bytes_of_str("what do ya want for nothing?")) == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
    teko::assert::is_true(hmac_sha512_hex_of(repeat_byte(0xaa, 20), repeat_byte(0xdd, 50)) == "fa73b0089d56a284efb0f0756c890be9b1b5dbdd8ee81a3655f83e33b2279d39bf3e848279a722c806b485a47e67c807b946a337bee8942674278859e13292fb")
    teko::assert::is_true(hmac_sha512_hex_of(byte_range(1, 25), repeat_byte(0xcd, 50)) == "b0ba465637458c6990e5a8c5f61d4af7e576d97ff94b872de76f8050361ee3dba91ca5c11aa25eb4d679275cc5788063a5f19741120c4f2de2adebeb10a298dd")
    teko::assert::is_true(hmac_sha512_hex_of(repeat_byte(0x0c, 20), bytes_of_str("Test With Truncation")) == "415fad6271580a531d4179bc891d87a650188707922a4fbb36663a1eb16da008711c5b50ddd0fc235084eb9d3364a1454fb2ef67cd1d29fe6773068ea266e96b")
    teko::assert::is_true(hmac_sha512_hex_of(repeat_byte(0xaa, 131), bytes_of_str("Test Using Larger Than Block-Size Key - Hash Key First")) == "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598")
    teko::assert::is_true(hmac_sha512_hex_of(repeat_byte(0xaa, 131), bytes_of_str("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")) == "e37b6a775dc87dbaa4dfa9f96e5e3ffddebd71f8867289865df5a32d20cdc944b6022cac3c4982b10d5eeb55c3e4de15134676fb6de0446065c97440fa8c6a58")
}

/**
 * Streaming HMAC-SHA-256 equals the one-shot: feeding a message in three uneven chunks through
 * `hmac_sha256_update` (spanning the 64-byte inner-block boundary) matches `hmac_sha256_of`.
 */
#test
fn hmac_sha256_streaming_matches_oneshot() {
    var key = repeat_byte(0x0b, 20)
    var msg = byte_range(0, 200)
    var s = hmac_sha256_init(key)
    s = hmac_sha256_update(s, byte_range(0, 40))
    s = hmac_sha256_update(s, byte_range(40, 100))
    s = hmac_sha256_update(s, byte_range(140, 60))
    teko::assert::is_true(to_hex(hmac_sha256_finalize(s)) == to_hex(hmac_sha256_of(key, msg)))
}

/**
 * Streaming HMAC-SHA-512 equals the one-shot across the 128-byte inner-block boundary.
 */
#test
fn hmac_sha512_streaming_matches_oneshot() {
    var key = repeat_byte(0xaa, 20)
    var msg = byte_range(0, 300)
    var s = hmac_sha512_init(key)
    s = hmac_sha512_update(s, byte_range(0, 130))
    s = hmac_sha512_update(s, byte_range(130, 170))
    teko::assert::is_true(to_hex(hmac_sha512_finalize(s)) == to_hex(hmac_sha512_of(key, msg)))
}

/**
 * HMAC-SHA3-256 known-answer vectors (cross-checked against Python `hmac`/`hashlib.sha3_256`):
 * an ASCII key/message, RFC 4231 test case 1's inputs, and a 200-byte key that exceeds the
 * 136-byte SHA3-256 block (exercising the long-key hashing path).
 */
#test
fn hmac_sha3_256_vectors() {
    teko::assert::is_true(hmac_sha3_256_hex_of(bytes_of_str("key"), bytes_of_str("The quick brown fox jumps over the lazy dog")) == "8c6e0683409427f8931711b10ca92a506eb1fafa48fadd66d76126f47ac2c333")
    teko::assert::is_true(hmac_sha3_256_hex_of(repeat_byte(0x0b, 20), bytes_of_str("Hi There")) == "ba85192310dffa96e2a3a40e69774351140bb7185e1202cdcc917589f95e16bb")
    teko::assert::is_true(hmac_sha3_256_hex_of(repeat_byte(0xaa, 200), bytes_of_str("Test Using Larger Than Block-Size Key - Hash Key First")) == "49ad92b02124fdac9627ae45e008a696182ab6bfb8470457777c744aeb9df06f")
}

/**
 * HMAC constant-time verification accepts the genuine tag and rejects a forged one, across the
 * SHA-256, SHA-512, and SHA3-256 variants.
 */
#test
fn hmac_verify_accepts_and_rejects() {
    var key = bytes_of_str("key")
    var msg = bytes_of_str("The quick brown fox jumps over the lazy dog")
    teko::assert::is_true(hmac_sha256_verify(key, msg, hmac_sha256_of(key, msg)))
    teko::assert::is_true(!hmac_sha256_verify(key, msg, repeat_byte(0, 32)))
    teko::assert::is_true(hmac_sha512_verify(key, msg, hmac_sha512_of(key, msg)))
    teko::assert::is_true(!hmac_sha512_verify(key, msg, repeat_byte(0, 64)))
    teko::assert::is_true(hmac_sha3_256_verify(key, msg, hmac_sha3_256_of(key, msg)))
    teko::assert::is_true(!hmac_sha3_256_verify(key, msg, repeat_byte(0, 32)))
}

/**
 * Poly1305 against the RFC 8439 §2.5.2 example (a 34-byte, multi-block message), the empty
 * message (tag reduces to the addend `s` = key bytes 16..31), and Appendix A.3 vector #1 (a
 * 64-byte all-zero message under the all-zero key, tag all zero).
 */
#test
fn poly1305_rfc8439() {
    var key = hex_bytes("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    var tag = match poly1305_hex(key, bytes_of_str("Cryptographic Forum Research Group")) { str as s => s; CryptoError => "" }
    teko::assert::is_true(tag == "a8061dc1305136c6c22b8baf0c0127a9")
    var empty_tag = match poly1305_hex(key, teko::list::empty()) { str as s => s; CryptoError => "" }
    teko::assert::is_true(empty_tag == "0103808afb0db2fd4abff6af4149f51b")
    var zero_tag = match poly1305_hex(repeat_byte(0, 32), repeat_byte(0, 64)) { str as s => s; CryptoError => "" }
    teko::assert::is_true(zero_tag == "00000000000000000000000000000000")
}

/**
 * Poly1305 rejects a key whose length is not 32 bytes, and its constant-time verify accepts the
 * genuine tag and rejects a forged one.
 */
#test
fn poly1305_key_length_and_verify() {
    var bad = match poly1305(repeat_byte(0, 16), bytes_of_str("x")) { []byte => false; CryptoError => true }
    teko::assert::is_true(bad)
    var key = hex_bytes("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b")
    var msg = bytes_of_str("Cryptographic Forum Research Group")
    var good = match poly1305(key, msg) { []byte as t => t; CryptoError => teko::list::empty() }
    var ok = match poly1305_verify(key, msg, good) { bool as b => b; CryptoError => false }
    teko::assert::is_true(ok)
    var forged = match poly1305_verify(key, msg, repeat_byte(0, 16)) { bool as b => b; CryptoError => false }
    teko::assert::is_true(!forged)
}

/**
 * CMAC subkey derivation against the NIST SP 800-38B AES-128 worked example: given
 * `L = CIPH_K(0^128)`, `cmac_gen_subkeys` yields the published `K1`/`K2`.
 */
#test
fn cmac_subkeys_nist() {
    var sub = cmac_gen_subkeys(hex_bytes("7df76b0c1ab899b33e42f047b91b546f"))
    teko::assert::is_true(to_hex(sub.k1) == "fbeed618357133667c85e08f7236a8de")
    teko::assert::is_true(to_hex(sub.k2) == "f7ddac306ae266ccf90bc11ee46d513b")
}

/**
 * CMAC over the injected mock cipher (`E(x) = x ⊕ K`) for the empty message, one complete block
 * (K1 path), and a 40-byte message needing `10*` padding (K2 path) — cross-checked against the
 * Python oracle. Proves the CBC-MAC chaining, subkey selection, and final-block padding
 * independently of a real cipher.
 */
#test
fn cmac_with_mock_cipher() {
    teko::assert::is_true(to_hex(cmac_with_cipher((b: []byte) => mock_encrypt_block(b), teko::list::empty())) == "80050a0f14111e1b282d22273c393633")
    teko::assert::is_true(to_hex(cmac_with_cipher((b: []byte) => mock_encrypt_block(b), byte_range(0, 16))) == "00020406080a0c0e10121416181a1c1e")
    teko::assert::is_true(to_hex(cmac_with_cipher((b: []byte) => mock_encrypt_block(b), byte_range(0, 40))) == "3034383c2024282cb83d32372c292623")
}

/**
 * GHASH against the NIST GCM specification test case 2: `GHASH_H(C ‖ len-block)` with the given
 * hash subkey `H`, a one-block ciphertext `C`, and the `[0]_64 ‖ [128]_64` length block, yields
 * the documented `f38cbb1a…`. The pure GF(2^128) core, no cipher required.
 */
#test
fn ghash_gcm_test_case_2() {
    var h = hex_bytes("66e94bd4ef8a2c3b884cfa59ca342b2e")
    var data = hex_bytes("0388dace60b6a392f328c2b971b2fe7800000000000000000000000000000080")
    var out = match ghash(h, data) { []byte as x => to_hex(x); CryptoError => "" }
    teko::assert::is_true(out == "f38cbb1ad69223dcc3457ae5b6b0f885")
    var bad = match ghash(repeat_byte(0, 8), data) { []byte => false; CryptoError => true }
    teko::assert::is_true(bad)
}

/**
 * GMAC over the injected mock cipher for empty AAD, one complete AAD block, and a 20-byte AAD
 * needing zero-padding — cross-checked against the Python oracle. Proves the `H = E(0)`, GHASH
 * length-block assembly, and `⊕ E(J0)` masking of the seam independently of a real cipher.
 */
#test
fn gmac_with_mock_cipher() {
    var iv = byte_range(0, 12)
    var empty_tag = match gmac_with_cipher((b: []byte) => mock_encrypt_block(b), iv, teko::list::empty()) { []byte as x => to_hex(x); CryptoError => "" }
    teko::assert::is_true(empty_tag == "0000000000000000000000000c0d0e0e")
    var tag16 = match gmac_with_cipher((b: []byte) => mock_encrypt_block(b), iv, byte_range(0, 16)) { []byte as x => to_hex(x); CryptoError => "" }
    teko::assert::is_true(tag16 == "f2dadde039ff9702fa7869c5edcf9efa")
    var tag20 = match gmac_with_cipher((b: []byte) => mock_encrypt_block(b), iv, byte_range(0, 20)) { []byte as x => to_hex(x); CryptoError => "" }
    teko::assert::is_true(tag20 == "52d3e1fc9d603550cf7517634bdb6e62")
}
