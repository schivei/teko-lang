/**
 * SHA-256 of a 200-byte message — several WHOLE blocks (3 full 64-byte blocks plus an 8-byte
 * remainder) followed by its own padding block, exercising `sha256_update`'s multi-block
 * absorption loop directly (not just the single-shot `sha2_pad` edge above).
 */
#test
fn sha256_of_multi_block_message() {
    var msg = ""
    var i = 0
    loop {
        if i >= 200 { break }
        msg = teko::str::concat(msg, "a")
        i++
    }
    teko::assert::is_true(sha256_hex_of(bytes_of_str(msg)) == "c2a908d98f5df987ade41b5fce213067efbcc21ef2240212a41e54b5e7c28ae5")
}

/**
 * SHA-512 of a 200-byte message — exceeds one 128-byte block, exercising `sha512_update`'s
 * multi-block absorption loop and the 128-bit length suffix's zero high-64-bits invariant.
 */
#test
fn sha512_of_multi_block_message() {
    var msg = ""
    var i = 0
    loop {
        if i >= 200 { break }
        msg = teko::str::concat(msg, "a")
        i++
    }
    teko::assert::is_true(sha512_hex_of(bytes_of_str(msg)) == "4b11459c33f52a22ee8236782714c150a3b2c60994e9acee17fe68947a3e6789f31e7668394592da7bef827cddca88c4e6f86e4df7ed1ae6cba71f3e98faee9f")
}

/**
 * SHA-384 of a 200-byte message — exceeds one 128-byte block, exercising `sha384_update`'s
 * multi-block absorption loop (the same SHA-512 compression path SHA-384 reuses) cross-checked
 * against Python's `hashlib.sha384`.
 */
#test
fn sha384_of_multi_block_message() {
    var msg = ""
    var i = 0
    loop {
        if i >= 200 { break }
        msg = teko::str::concat(msg, "a")
        i++
    }
    teko::assert::is_true(sha384_hex_of(bytes_of_str(msg)) == "0691b6e978614b67d60557b2a2cddd53406508522efa21c624dbbfa8ab6e726d5c586b489c7c09f24109a64c10211d48")
}

/**
 * The 56-byte NIST/FIPS reference message (`"abc...pq"`, FIPS 180-4 §B) as a `[]byte` — the
 * shared long known-answer-vector input for the SHA-3, BLAKE2b, and legacy fixtures below.
 *
 * @return  the 56-byte reference message
 */
fn nist_msg_56(): []byte {
    bytes_of_str("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
}

/**
 * SHA-256 empty-string and `"abc"` known-answer vectors (FIPS 180-4) — the single-block edges
 * the multi-block test above does not cover.
 */
#test
fn sha256_short_vectors() {
    teko::assert::is_true(sha256_hex_of(bytes_of_str("")) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    teko::assert::is_true(sha256_hex_of(bytes_of_str("abc")) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    teko::assert::is_true(sha256_hex_of(nist_msg_56()) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
}

/**
 * SHA-512 empty-string and `"abc"` known-answer vectors (FIPS 180-4).
 */
#test
fn sha512_short_vectors() {
    teko::assert::is_true(sha512_hex_of(bytes_of_str("")) == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    teko::assert::is_true(sha512_hex_of(bytes_of_str("abc")) == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
}

/**
 * SHA-384 empty-string, `"abc"`, and 56-byte known-answer vectors (FIPS 180-4), plus a
 * streaming/one-shot cross-check spanning the 128-byte inner-block boundary.
 */
#test
fn sha384_short_vectors_and_streaming() {
    teko::assert::is_true(sha384_hex_of(bytes_of_str("")) == "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")
    teko::assert::is_true(sha384_hex_of(bytes_of_str("abc")) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    teko::assert::is_true(sha384_hex_of(nist_msg_56()) == "3391fdddfc8dc7393707a65b1b4709397cf8b1d162af05abfe8f450de5f36bc6b0455a8520bc4e6f5fe95b1fe3c8452b")
    var s = sha384_init()
    s = sha384_update(s, bytes_of_str("ab"))
    s = sha384_update(s, bytes_of_str("c"))
    teko::assert::is_true(teko::crypto::to_hex(sha384_finalize(s)) == sha384_hex_of(bytes_of_str("abc")))
}

/**
 * SHA3-256 empty-string, `"abc"`, and 56-byte known-answer vectors (FIPS 202).
 */
#test
fn sha3_256_vectors() {
    teko::assert::is_true(sha3_256_hex_of(bytes_of_str("")) == "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
    teko::assert::is_true(sha3_256_hex_of(bytes_of_str("abc")) == "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
    teko::assert::is_true(sha3_256_hex_of(nist_msg_56()) == "41c0dba2a9d6240849100376a8235e2c82e1b9998a999e21db32dd97496d3376")
}

/**
 * SHA3-512 empty-string, `"abc"`, and 56-byte known-answer vectors (FIPS 202).
 */
#test
fn sha3_512_vectors() {
    teko::assert::is_true(sha3_512_hex_of(bytes_of_str("")) == "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a615b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")
    teko::assert::is_true(sha3_512_hex_of(bytes_of_str("abc")) == "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0")
    teko::assert::is_true(sha3_512_hex_of(nist_msg_56()) == "04a371e84ecfb5b8b77cb48610fca8182dd457ce6f326a0fd3d7ec2f1e91636dee691fbe0c985302ba1b0d8dc78c086346b533b49c030d99a27daf1139d6e75e")
}

/**
 * SHAKE128 extendable-output known-answer vectors (FIPS 202), squeezed to 32 bytes.
 */
#test
fn shake128_vectors() {
    teko::assert::is_true(teko::crypto::to_hex(shake128_of(bytes_of_str(""), 32)) == "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
    teko::assert::is_true(teko::crypto::to_hex(shake128_of(bytes_of_str("abc"), 32)) == "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8")
    teko::assert::is_true(teko::crypto::to_hex(shake128_of(nist_msg_56(), 32)) == "1a96182b50fb8c7e74e0a707788f55e98209b8d91fade8f32f8dd5cff7bf21f5")
}

/**
 * SHAKE256 extendable-output known-answer vectors (FIPS 202), squeezed to 64 bytes.
 */
#test
fn shake256_vectors() {
    teko::assert::is_true(teko::crypto::to_hex(shake256_of(bytes_of_str(""), 64)) == "46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762fd75dc4ddd8c0f200cb05019d67b592f6fc821c49479ab48640292eacb3b7c4be")
    teko::assert::is_true(teko::crypto::to_hex(shake256_of(bytes_of_str("abc"), 64)) == "483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739d5a15bef186a5386c75744c0527e1faa9f8726e462a12a4feb06bd8801e751e4")
}

/**
 * BLAKE2b-512 empty-string, `"abc"`, and 56-byte known-answer vectors (RFC 7693 appendix).
 */
#test
fn blake2b512_vectors() {
    teko::assert::is_true(blake2b512_hex_of(bytes_of_str("")) == "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce")
    teko::assert::is_true(blake2b512_hex_of(bytes_of_str("abc")) == "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
    teko::assert::is_true(blake2b512_hex_of(nist_msg_56()) == "7285ff3e8bd768d69be62b3bf18765a325917fa9744ac2f582a20850bc2b1141ed1b3e4528595acc90772bdf2d37dc8a47130b44f33a02e8730e5ad8e166e888")
}

/**
 * BLAKE2b with a truncated 32-byte output length (`blake2b_of(data, 32)`) — exercises the
 * parameterized digest length distinct from the BLAKE2b-512 default.
 */
#test
fn blake2b_256_vector() {
    teko::assert::is_true(teko::crypto::to_hex(blake2b_of(bytes_of_str("abc"), 32)) == "bddd813c634239723171ef3fee98579b94964e3bb1cb3e427262c8c068d52319")
}

/**
 * MD5 (legacy) empty-string, `"abc"`, and 56-byte known-answer vectors (RFC 1321 §A.5).
 */
#test
fn md5_legacy_vectors() {
    teko::assert::is_true(md5_hex_of(bytes_of_str("")) == "d41d8cd98f00b204e9800998ecf8427e")
    teko::assert::is_true(md5_hex_of(bytes_of_str("abc")) == "900150983cd24fb0d6963f7d28e17f72")
    teko::assert::is_true(md5_hex_of(nist_msg_56()) == "8215ef0796a20bcaaae116d3876c664a")
}

/**
 * SHA-1 (legacy) empty-string, `"abc"`, and 56-byte known-answer vectors (FIPS 180-4).
 */
#test
fn sha1_legacy_vectors() {
    teko::assert::is_true(sha1_hex_of(bytes_of_str("")) == "da39a3ee5e6b4b0d3255bfef95601890afd80709")
    teko::assert::is_true(sha1_hex_of(bytes_of_str("abc")) == "a9993e364706816aba3e25717850c26c9cd0d89d")
    teko::assert::is_true(sha1_hex_of(nist_msg_56()) == "84983e441c3bd26ebaae4aa1f95129e5e54670f1")
}

/**
 * Streaming equals one-shot for SHA3-256: feeding the 56-byte message in three chunks through
 * `keccak_update` yields the same digest as `sha3_256_of` (spans a sponge-block boundary).
 */
#test
fn sha3_256_streaming_matches_oneshot() {
    var s = sha3_256_init()
    s = keccak_update(s, bytes_of_str("abcdbcdecdefdefg"))
    s = keccak_update(s, bytes_of_str("efghfghighijhijkijkljklm"))
    s = keccak_update(s, bytes_of_str("klmnlmnomnopnopq"))
    teko::assert::is_true(teko::crypto::to_hex(keccak_finalize(s, 32)) == sha3_256_hex_of(nist_msg_56()))
}

/**
 * Streaming equals one-shot for BLAKE2b-512: chunked `blake2b_update` (crossing the 128-byte
 * block boundary via a 200-byte message) yields the same digest as `blake2b512_of`.
 */
#test
fn blake2b_streaming_matches_oneshot() {
    var msg = ""
    var i = 0
    loop {
        if i >= 200 { break }
        msg = teko::str::concat(msg, "a")
        i++
    }
    var s = blake2b_init(64)
    s = blake2b_update(s, bytes_of_str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    s = blake2b_update(s, bytes_of_str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    s = blake2b_update(s, bytes_of_str("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
    teko::assert::is_true(teko::crypto::to_hex(blake2b_finalize(s)) == blake2b512_hex_of(bytes_of_str(msg)))
}

/**
 * Streaming equals one-shot for the legacy MD5 path: chunked `md5_update` across a 64-byte
 * block boundary matches `md5_of`.
 */
#test
fn md5_streaming_matches_oneshot() {
    var s = md5_init()
    s = md5_update(s, bytes_of_str("abcdbcdecdefdefgefghfghi"))
    s = md5_update(s, bytes_of_str("ghijhijkijkljklmklmnlmnomnopnopq"))
    teko::assert::is_true(teko::crypto::to_hex(md5_finalize(s)) == md5_hex_of(nist_msg_56()))
}
