use teko::numeric::bigint

fn rsa_test_hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

fn rsa_test_hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = rsa_test_hex_val(chars[i])
        var lo = rsa_test_hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

fn rsa_test_unwrap_pub(r: RsaPublicKey | CryptoError): RsaPublicKey {
    match r {
        RsaPublicKey as k => k
        CryptoError => { teko::assert::is_true(false); RsaPublicKey { n = bigint::zero(); e = bigint::zero() } }
    }
}

fn rsa_test_unwrap_priv(r: RsaPrivateKey | CryptoError): RsaPrivateKey {
    match r {
        RsaPrivateKey as k => k
        CryptoError => { teko::assert::is_true(false); RsaPrivateKey { n = bigint::zero(); d = bigint::zero(); e = bigint::zero() } }
    }
}

fn rsa_test_unwrap_bytes(r: []byte | CryptoError): []byte {
    match r {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); [] }
    }
}

fn rsa_test_n_hex(): str {
    "d1c4d4610948c799cf87fa6ee33c3e1f67e31e9aa7f9d4d1dfcdee69eb82c1aba426b24e3d43ac79107b859e0ea3eefbac59c7386aecf212b914025bfe09795500dfbbb69f142c7c4d22e53a0620c4720b75cbed2604b8724d6bc4a808bd90e9f7f933390f86df97229eb4a438060a46ad82be3bcedee4cf94c701a174b655fb"
}

fn rsa_test_e_hex(): str {
    "010001"
}

fn rsa_test_d_hex(): str {
    "8ad487f2c8e0402a0dede2d2ecd57c0ff103a1c79d907d4781a59b3ac2c1c147c5d64e7ff5900a5ffd86a2c21ed264627088e28ef6456758f8e0c346faf46e359ef8963e2261e07266eeb878f77723853fac4d672d18c5b7bd59257e59bcd0fb7c94c431b255f209382597231e5361ab27e97f2287a5e7a015cd20934786be01"
}

fn rsa_test_message(): []byte {
    bytes_of_str("The quick brown fox jumps over the lazy dog")
}

fn rsa_test_salt(): []byte {
    rsa_test_hex_bytes("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
}

fn rsa_test_pub(): RsaPublicKey {
    rsa_test_unwrap_pub(rsa_public_key_from_hex(rsa_test_n_hex(), rsa_test_e_hex()))
}

fn rsa_test_priv(): RsaPrivateKey {
    rsa_test_unwrap_priv(rsa_private_key_from_hex(rsa_test_n_hex(), rsa_test_d_hex(), rsa_test_e_hex()))
}

#test
fn pkcs1v15_sign_matches_python_reference() {
    var priv = rsa_test_priv()
    var pubkey = rsa_test_pub()
    var msg = rsa_test_message()

    var sig256 = rsa_test_unwrap_bytes(rsa_sign_pkcs1v15(priv, RsaHashAlg::Sha256, msg))
    teko::assert::bytes_eq(sig256, rsa_test_hex_bytes("399fff2a750388a10505c59b43a7072e2fd6ee8f168f840dbb972f4fa1ff21467543ca1e921551eb3ca51ee9dedd0f362c753b68d851c1450a28f0cdab932bdcb9256910d28459e2ec55b201a8acc4162a40725b8a386540c94d325dc95608a8c8d267850248ffa8c454389aaf94f3fad2d1b9674c908facf0f081b1e7731a6d"))
    teko::assert::is_true(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha256, msg, sig256))

    var sig384 = rsa_test_unwrap_bytes(rsa_sign_pkcs1v15(priv, RsaHashAlg::Sha384, msg))
    teko::assert::bytes_eq(sig384, rsa_test_hex_bytes("4f57599e234966bda21c622cc991a584f02ac41d4b0feb6f0f4c4ed343052720ffba3b7fe801a9e11a06ad08801c8bb005a98c5bb6c71445f19132baa9fafabbdbbebda26947bab26dd932db2d6b32ad9e764ecdb02e9a7a54f69500f5a5a814516c8ff29bcb7ea38c286dee2a4daaea2527e63e56a2119405eed1e0ad7b07f8"))
    teko::assert::is_true(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha384, msg, sig384))

    var sig512 = rsa_test_unwrap_bytes(rsa_sign_pkcs1v15(priv, RsaHashAlg::Sha512, msg))
    teko::assert::bytes_eq(sig512, rsa_test_hex_bytes("c01751cc02d1759e638486cdb2f330e8fb1e8bace4e41fbde64f08cc25dcf03c3b452aa890f67a202dc01744829a979acbb00c072396ad3ef361edcbebdc3e0bcbb07bc540d348f9331717692950820f949dfd156b5c5032a4718587ae5edaa4d083d72837a7f18ee50dc9c58675d6b6987f3f4bad0a2bfcb9c30cb0eaf8199d"))
    teko::assert::is_true(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha512, msg, sig512))
}

#test
fn pkcs1v15_verify_rejects_tampering() {
    var pubkey = rsa_test_pub()
    var msg = rsa_test_message()
    var sig = rsa_test_unwrap_bytes(rsa_sign_pkcs1v15(rsa_test_priv(), RsaHashAlg::Sha256, msg))

    teko::assert::is_false(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha256, msg, rsa_test_hex_bytes("00")))

    var tampered: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= sig.len { break }
        var v = sig[i]
        if i == 0 { v = ((v to u32) ^ (0x01 to u32)) to byte }
        tampered = teko::list::push(tampered, v)
        i++
    }
    teko::assert::is_false(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha256, msg, tampered))

    teko::assert::is_false(rsa_verify_pkcs1v15(pubkey, RsaHashAlg::Sha256, bytes_of_str("a different message"), sig))
}

#test
fn pss_sign_matches_vectors_and_round_trips() {
    var priv = rsa_test_priv()
    var pubkey = rsa_test_pub()
    var msg = rsa_test_message()
    var salt = rsa_test_salt()

    var sig256 = rsa_test_unwrap_bytes(rsa_sign_pss(priv, RsaHashAlg::Sha256, msg, salt))
    teko::assert::bytes_eq(sig256, rsa_test_hex_bytes("100478a63ff8eccf054c60f0ccc4e09ce9da9a7af9e54b9ce72ab3767c66b3302fc701753710d6cc83b9f064f6bcfe92471280168461d50df631b222fbc3c8e3348fa23656d576855ca46dbe7a7d48206f45eda000e29c794396f8045742932cb9e9ea8c79bd53f35485c332d150313455d3a59e8728bd69b78d731bec056206"))
    teko::assert::is_true(rsa_verify_pss(pubkey, RsaHashAlg::Sha256, msg, sig256))

    var sig384 = rsa_test_unwrap_bytes(rsa_sign_pss(priv, RsaHashAlg::Sha384, msg, salt))
    teko::assert::bytes_eq(sig384, rsa_test_hex_bytes("6c6f8dfe70a28664b3503d8edef78d2fddd931cf51df151a844ee6dc1a0440288ebbdde3bc6a4bb7647451610d3d2f371ab6f5cafd02f6e7da9dd57d31be324898fafb929de1833c31b5a608df83dc2fef0f3651ee9bf1f923f408b560d16b075dc10b6c7d757ee0ff877794798bf3e534c82a337234e1c4d993ce14995596a9"))
    teko::assert::is_true(rsa_verify_pss(pubkey, RsaHashAlg::Sha384, msg, sig384))

    var sig512 = rsa_test_unwrap_bytes(rsa_sign_pss(priv, RsaHashAlg::Sha512, msg, salt))
    teko::assert::bytes_eq(sig512, rsa_test_hex_bytes("39019516787838e73528b6f203f3423c520317cb7079a179ee34ba2dcabd49d533b0ee52d3ac69b3e9fc5b52a07267e27d002a2852bba3f6c248837f4b206bd2cee2e1a3bd07dd4035bca47bc1b5f629ee9b8928fddef0bd0d17f31a6bd051da31869c10a36c02cad69f94c23d18d94c9cdadcec92d07b688f6300b155536b5f"))
    teko::assert::is_true(rsa_verify_pss(pubkey, RsaHashAlg::Sha512, msg, sig512))

    var short_salt: []byte = []
    var fresh = rsa_test_unwrap_bytes(rsa_sign_pss(priv, RsaHashAlg::Sha256, msg, short_salt))
    teko::assert::is_true(rsa_verify_pss(pubkey, RsaHashAlg::Sha256, msg, fresh))
}

#test
fn pss_verify_rejects_tampering() {
    var pubkey = rsa_test_pub()
    var msg = rsa_test_message()
    var sig = rsa_test_unwrap_bytes(rsa_sign_pss(rsa_test_priv(), RsaHashAlg::Sha256, msg, rsa_test_salt()))

    teko::assert::is_false(rsa_verify_pss(pubkey, RsaHashAlg::Sha256, msg, rsa_test_hex_bytes("00")))

    var tampered: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= sig.len { break }
        var v = sig[i]
        if i == sig.len - 1 { v = ((v to u32) ^ (0x01 to u32)) to byte }
        tampered = teko::list::push(tampered, v)
        i++
    }
    teko::assert::is_false(rsa_verify_pss(pubkey, RsaHashAlg::Sha256, msg, tampered))

    teko::assert::is_false(rsa_verify_pss(pubkey, RsaHashAlg::Sha256, bytes_of_str("a different message"), sig))
}

#test
fn sign_rejects_too_small_modulus() {
    var tiny = rsa_test_unwrap_priv(rsa_private_key_from_hex("ca1", "ac1", "11"))
    match rsa_sign_pkcs1v15(tiny, RsaHashAlg::Sha256, rsa_test_message()) {
        []byte => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    match rsa_sign_pss(tiny, RsaHashAlg::Sha256, rsa_test_message(), rsa_test_salt()) {
        []byte => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
}

#test
fn key_constructors_reject_malformed_hex() {
    match rsa_public_key_from_hex("not-hex", "10001") {
        RsaPublicKey => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    match rsa_private_key_from_hex(rsa_test_n_hex(), "zz", rsa_test_e_hex()) {
        RsaPrivateKey => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
}

#test
fn key_constructors_bytes_and_hex_agree() {
    var pub_hex = rsa_test_pub()
    var pub_bytes = rsa_public_key_from_bytes_be(rsa_test_hex_bytes(rsa_test_n_hex()), rsa_test_hex_bytes(rsa_test_e_hex()))
    teko::assert::is_true(bigint::eq(pub_hex.n, pub_bytes.n))
    teko::assert::is_true(bigint::eq(pub_hex.e, pub_bytes.e))

    var priv_bytes = rsa_private_key_from_bytes_be(rsa_test_hex_bytes(rsa_test_n_hex()), rsa_test_hex_bytes(rsa_test_d_hex()), rsa_test_hex_bytes(rsa_test_e_hex()))
    var sig = rsa_test_unwrap_bytes(rsa_sign_pkcs1v15(priv_bytes, RsaHashAlg::Sha256, rsa_test_message()))
    teko::assert::is_true(rsa_verify_pkcs1v15(pub_hex, RsaHashAlg::Sha256, rsa_test_message(), sig))
}
