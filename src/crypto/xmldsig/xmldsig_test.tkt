use teko::crypto
use teko::encoding::xml
use teko::numeric::bigint

fn xt_parse(text: str): xml::XmlNode {
    match xml::parse(text) {
        xml::XmlNode as n => n
        error => { teko::assert::is_true(false); xml::text_node("") }
    }
}

fn xt_doc(): xml::XmlNode {
    xt_parse("<Document xmlns=\"urn:example:doc\"><Data>hello world</Data></Document>")
}

fn xt_unwrap_node(r: xml::XmlNode | crypto::CryptoError): xml::XmlNode {
    match r {
        xml::XmlNode as n => n
        crypto::CryptoError => { teko::assert::is_true(false); xml::text_node("") }
    }
}

fn xt_expect_ok(r: bool | crypto::CryptoError) {
    match r {
        bool as v => teko::assert::is_true(v)
        crypto::CryptoError => teko::assert::is_true(false)
    }
}

fn xt_expect_reject(r: bool | crypto::CryptoError) {
    match r {
        bool => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

fn xt_signature_value(doc: xml::XmlNode): str {
    var sig = match find_element_with_inlined_namespaces(doc, "Signature", ns_scope_root()) {
        xml::XmlNode as n => n
        null => { teko::assert::is_true(false); return "" }
    }
    match extract_text_child(sig, "SignatureValue") {
        str as s => s
        crypto::CryptoError => { teko::assert::is_true(false); "" }
    }
}

fn xt_digest_value(doc: xml::XmlNode): str {
    var sig = match find_element_with_inlined_namespaces(doc, "Signature", ns_scope_root()) {
        xml::XmlNode as n => n
        null => { teko::assert::is_true(false); return "" }
    }
    var si = match find_element_with_inlined_namespaces(sig, "SignedInfo", ns_scope_root()) {
        xml::XmlNode as n => n
        null => { teko::assert::is_true(false); return "" }
    }
    var reference = match first_child_local(si, "Reference") {
        xml::XmlNode as n => n
        null => { teko::assert::is_true(false); return "" }
    }
    match extract_text_child(reference, "DigestValue") {
        str as s => s
        crypto::CryptoError => { teko::assert::is_true(false); "" }
    }
}

fn xt_tamper_byte(s: str, index: u64, replacement: byte): str {
    var out: str = ""
    var i: u64 = 0
    loop {
        if i >= s.len { break }
        out = out ~ one_byte(if i == index { replacement } else { s[i] })
        i++
    }
    out
}

fn xt_hex(s: str): bigint::BigInt {
    match bigint::from_hex(s) {
        bigint::BigInt as b => b
        error => { teko::assert::is_true(false); bigint::zero() }
    }
}

fn xt_rsa_priv(): crypto::RsaPrivateKey {
    var n_hex = ""
    var d_hex = ""
    var e_hex = "010001"
    match crypto::rsa_private_key_from_hex(n_hex, d_hex, e_hex) {
        crypto::RsaPrivateKey as k => k
        crypto::CryptoError => { teko::assert::is_true(false); crypto::RsaPrivateKey { n = bigint::zero(); d = bigint::zero(); e = bigint::zero() } }
    }
}

fn xt_rsa_pub(): crypto::RsaPublicKey {
    var priv = xt_rsa_priv()
    crypto::RsaPublicKey { n = priv.n; e = priv.e }
}

fn xt_rsa_signxml_pub(): crypto::RsaPublicKey {
    var n_hex = ""
    var e_hex = "010001"
    match crypto::rsa_public_key_from_hex(n_hex, e_hex) {
        crypto::RsaPublicKey as k => k
        crypto::CryptoError => { teko::assert::is_true(false); crypto::RsaPublicKey { n = bigint::zero(); e = bigint::zero() } }
    }
}

fn xt_ec_scalar(): bigint::BigInt {
    xt_hex("265dde4ae678817e7374d33783a6a0f36a18d7d2862bcfb049ce0137c213155e")
}

fn xt_ec_point(): crypto::P256Point {
    var qx_hex = "47c9dd102a147130a9246e601b46e00d30bd06ce47a10391fe0946ff4f1df87a"
    var qy_hex = "1650cd8e1c26ba088179f87aa57aa408917acf019f2af72c54bbc307749da9f0"
    crypto::P256Point { infinity = false; x = xt_hex(qx_hex); y = xt_hex(qy_hex) }
}

fn xt_ecdsa_signxml_pub(): crypto::P256Point {
    var qx_hex = "66b4b755669d437463b8dbec75e29fe070caa99a0b8afb24d2a1d491827835b8"
    var qy_hex = "e3679e71254e264f4dd4c6c1b954bc4ea9faa5b8b29c8329b02e86aec1a98faf"
    crypto::P256Point { infinity = false; x = xt_hex(qx_hex); y = xt_hex(qy_hex) }
}

fn xt_hmac_secret(): []byte {
    bytes_of_str("my-shared-hmac-secret-0123456789")
}

fn xt_rsa_signxml_doc(): str {
    "<Document xmlns=\"urn:example:doc\"><Data>hello world</Data><ds:Signature xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\"><ds:SignedInfo><ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/><ds:SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#rsa-sha256\"/><ds:Reference URI=\"\"><ds:Transforms><ds:Transform Algorithm=\"http://www.w3.org/2000/09/xmldsig#enveloped-signature\"/><ds:Transform Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/></ds:Transforms><ds:DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"/><ds:DigestValue>NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=</ds:DigestValue></ds:Reference></ds:SignedInfo><ds:SignatureValue></ds:SignatureValue><ds:KeyInfo><ds:KeyValue><ds:RSAKeyValue><ds:Modulus></ds:Modulus><ds:Exponent>AQAB</ds:Exponent></ds:RSAKeyValue></ds:KeyValue></ds:KeyInfo></ds:Signature></Document>"
}

fn xt_hmac_signxml_doc(): str {
    "<Document xmlns=\"urn:example:doc\"><Data>hello world</Data><ds:Signature xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\"><ds:SignedInfo><ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/><ds:SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#hmac-sha256\"/><ds:Reference URI=\"\"><ds:Transforms><ds:Transform Algorithm=\"http://www.w3.org/2000/09/xmldsig#enveloped-signature\"/><ds:Transform Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/></ds:Transforms><ds:DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"/><ds:DigestValue>NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=</ds:DigestValue></ds:Reference></ds:SignedInfo><ds:SignatureValue>DDjy1waC0UXyIdDwcRW7oYEuHoTCcArd57kD1YqUNRQ=</ds:SignatureValue></ds:Signature></Document>"
}

fn xt_ecdsa_signxml_doc(): str {
    "<Document xmlns=\"urn:example:doc\"><Data>hello world</Data><ds:Signature xmlns:ds=\"http://www.w3.org/2000/09/xmldsig#\"><ds:SignedInfo><ds:CanonicalizationMethod Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/><ds:SignatureMethod Algorithm=\"http://www.w3.org/2001/04/xmldsig-more#ecdsa-sha256\"/><ds:Reference URI=\"\"><ds:Transforms><ds:Transform Algorithm=\"http://www.w3.org/2000/09/xmldsig#enveloped-signature\"/><ds:Transform Algorithm=\"http://www.w3.org/TR/2001/REC-xml-c14n-20010315\"/></ds:Transforms><ds:DigestMethod Algorithm=\"http://www.w3.org/2001/04/xmlenc#sha256\"/><ds:DigestValue>NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=</ds:DigestValue></ds:Reference></ds:SignedInfo><ds:SignatureValue>jJkK3QvOkecOVVG6Gr32vWoq/9bZEEh6k+oKTp9RlT3noqeJdcOXyajHJZfIRAidIWfdOTNqIhEFFNgNZu1IMA==</ds:SignatureValue><ds:KeyInfo><ds:KeyValue><dsig11:ECKeyValue xmlns:dsig11=\"http://www.w3.org/2009/xmldsig11#\"><dsig11:NamedCurve URI=\"urn:oid:1.2.840.10045.3.1.7\"/><dsig11:PublicKey>BGa0t1VmnUN0Y7jb7HXin+BwyqmaC4r7JNKh1JGCeDW442eecSVOJk9N1MbBuVS8Tqn6pbiynIMpsC6GrsGpj68=</dsig11:PublicKey></dsig11:ECKeyValue></ds:KeyValue></ds:KeyInfo></ds:Signature></Document>"
}

#test
fn hmac_enveloped_sign_matches_python_vector() {
    var signed = xt_unwrap_node(xmldsig_sign_enveloped(xt_doc(), SignatureAlg::HmacSha256, DigestAlg::Sha256, signing_key_hmac(xt_hmac_secret()), null))
    teko::assert::eq_str(xt_digest_value(signed), "NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=")
    teko::assert::eq_str(xt_signature_value(signed), "1SeegOJ7fWm1aJPJ3l3CaGP7rb8OKFIQAzauchOnWvo=")
    xt_expect_ok(xmldsig_verify(signed, verification_key_hmac(xt_hmac_secret())))
}

#test
fn rsa_enveloped_sign_matches_python_vector() {
    var signed = xt_unwrap_node(xmldsig_sign_enveloped(xt_doc(), SignatureAlg::RsaSha256, DigestAlg::Sha256, signing_key_rsa(xt_rsa_priv()), null))
    teko::assert::eq_str(xt_digest_value(signed), "NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=")
    teko::assert::eq_str(xt_signature_value(signed), "")
    xt_expect_ok(xmldsig_verify(signed, verification_key_rsa(xt_rsa_pub())))
}

#test
fn ecdsa_enveloped_sign_verify_round_trip() {
    var signed = xt_unwrap_node(xmldsig_sign_enveloped(xt_doc(), SignatureAlg::EcdsaSha256, DigestAlg::Sha256, signing_key_ecdsa(xt_ec_scalar()), null))
    xt_expect_ok(xmldsig_verify(signed, verification_key_ecdsa(xt_ec_point())))
    xt_expect_reject(xmldsig_verify(signed, verification_key_ecdsa(xt_ecdsa_signxml_pub())))
}

#test
fn hmac_verify_accepts_signxml_document() {
    xt_expect_ok(xmldsig_verify(xt_parse(xt_hmac_signxml_doc()), verification_key_hmac(xt_hmac_secret())))
}

#test
fn rsa_verify_accepts_signxml_document() {
    xt_expect_ok(xmldsig_verify(xt_parse(xt_rsa_signxml_doc()), verification_key_rsa(xt_rsa_signxml_pub())))
}

#test
fn ecdsa_verify_accepts_signxml_document() {
    xt_expect_ok(xmldsig_verify(xt_parse(xt_ecdsa_signxml_doc()), verification_key_ecdsa(xt_ecdsa_signxml_pub())))
}

#test
fn verify_rejects_tampered_digest() {
    var doc_text = xt_hmac_signxml_doc()
    var marker = index_of_first(doc_text, "NWHakKrcp2xtp1f9hNjytN3AqAOzLgPMLo8mkvwm45Q=")
    var tampered = xt_tamper_byte(doc_text, marker, b'Z')
    xt_expect_reject(xmldsig_verify(xt_parse(tampered), verification_key_hmac(xt_hmac_secret())))
}

#test
fn verify_rejects_tampered_signature() {
    var doc_text = xt_hmac_signxml_doc()
    var marker = index_of_first(doc_text, "DDjy1waC0UXyIdDwcRW7oYEuHoTCcArd57kD1YqUNRQ=")
    var tampered = xt_tamper_byte(doc_text, marker, b'Z')
    xt_expect_reject(xmldsig_verify(xt_parse(tampered), verification_key_hmac(xt_hmac_secret())))
}

#test
fn verify_rejects_wrong_hmac_secret() {
    xt_expect_reject(xmldsig_verify(xt_parse(xt_hmac_signxml_doc()), verification_key_hmac(bytes_of_str("not-the-right-secret"))))
}

#test
fn verify_rejects_document_with_no_signature() {
    xt_expect_reject(xmldsig_verify(xt_doc(), verification_key_hmac(xt_hmac_secret())))
}

#test
fn sign_rejects_key_algorithm_family_mismatch() {
    match xmldsig_sign_enveloped(xt_doc(), SignatureAlg::RsaSha256, DigestAlg::Sha256, signing_key_hmac(xt_hmac_secret()), null) {
        xml::XmlNode => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

#test
fn detached_sign_verify_round_trip() {
    var node = xt_parse("<Payload>detached content</Payload>")
    var other = xt_parse("<Payload>a different payload</Payload>")
    var signature = xt_unwrap_node(xmldsig_sign_detached(node, "urn:example:detached-ref", SignatureAlg::HmacSha256, DigestAlg::Sha256, signing_key_hmac(xt_hmac_secret()), null))
    teko::assert::eq_str(signature.local, "Signature")
    xt_expect_ok(xmldsig_verify_detached(signature, node, verification_key_hmac(xt_hmac_secret())))
    xt_expect_reject(xmldsig_verify_detached(signature, other, verification_key_hmac(xt_hmac_secret())))
}

#test
fn enveloping_sign_verify_round_trip() {
    var data = xt_parse("<Payload>enveloped-in-signature content</Payload>")
    var signature = xt_unwrap_node(xmldsig_sign_enveloping("obj1", data, SignatureAlg::HmacSha256, DigestAlg::Sha256, signing_key_hmac(xt_hmac_secret()), null))
    teko::assert::eq_str(signature.local, "Signature")
    xt_expect_ok(xmldsig_verify(signature, verification_key_hmac(xt_hmac_secret())))
}

#test
fn sha1_digest_matches_python_and_round_trips() {
    var node = xt_parse("<Data>hello world</Data>")
    var signature = xt_unwrap_node(xmldsig_sign_detached(node, "urn:example:sha1-ref", SignatureAlg::HmacSha256, DigestAlg::Sha1, signing_key_hmac(xt_hmac_secret()), null))
    teko::assert::eq_str(xt_digest_value(signature), "dGg9W1na7/iJ3YDBi9q6mipRwM8=")
    xt_expect_ok(xmldsig_verify_detached(signature, node, verification_key_hmac(xt_hmac_secret())))
}

fn index_of_first(haystack: str, needle: str): u64 {
    var at: u64 = 0
    loop {
        if at + needle.len > haystack.len { break }
        if xt_matches_at(haystack, at, needle) { return at }
        at++
    }
    teko::assert::is_true(false)
    haystack.len
}

fn xt_matches_at(haystack: str, at: u64, needle: str): bool {
    var i: u64 = 0
    loop {
        if i >= needle.len { break }
        if haystack[at + i] != needle[i] { return false }
        i++
    }
    true
}
