/**
 * Tests for `teko::crypto::des`/`teko::crypto::tdes` — DES (FIPS 46-3) and 3DES/TDEA
 * (NIST SP 800-67), both marked `@deprecated` (legacy interop only). Pure Teko (no extern), so
 * every case runs natively. This file lives under `teko::crypto` (namespace = directory), so the
 * functions under test are called bare, mirroring `cipher_test.tkt`.
 *
 * Every expected value is either a published FIPS 46-3 known-answer vector or cross-checked
 * against `pycryptodome` 3.23.0 (`Crypto.Cipher.DES`/`DES3`, ECB and CBC modes).
 */

/**
 * The numeric value of one lowercase hex digit (`'0'..'9'`, `'a'..'f'`).
 *
 * @param c  a hex-digit byte
 * @return   the digit's value 0..15 (0 for a non-hex byte, which the fixtures never pass)
 */
fn hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

/**
 * Decodes an even-length lowercase hex string into the bytes it denotes.
 *
 * @param s  an even-length lowercase hex string
 * @return   the decoded bytes, most-significant nibble first
 */
fn hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = hex_val(chars[i])
        var lo = hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

/**
 * Renders a cipher result as lowercase hex, or the sentinel `"ERR"` when it is a `CryptoError`.
 *
 * @param r  a cipher output or a `CryptoError`
 * @return   the bytes as lowercase hex, or `"ERR"` on failure
 */
fn hexed(r: []byte | CryptoError): str {
    match r {
        []byte as x => to_hex(x)
        CryptoError => "ERR"
    }
}

/**
 * DES single-block encryption against the classic FIPS 46-3 known-answer vectors: the weak key
 * `0101010101010101` (cross-checked against `pycryptodome`) and the textbook `0123456789ABCDEF`
 * example (the "Now is the t" plaintext), and the all-zero key/block vector.
 */
#test
fn des_known_answer_vectors() {
    teko::assert::is_true(hexed(des_encrypt_block(hex_bytes("0101010101010101"), hex_bytes("95f8a5e5dd31d900"))) == "8000000000000000")
    teko::assert::is_true(hexed(des_encrypt_block(hex_bytes("0123456789abcdef"), hex_bytes("4e6f772069732074"))) == "3fa40e8a984d4815")
    teko::assert::is_true(hexed(des_encrypt_block(hex_bytes("0000000000000000"), hex_bytes("0000000000000000"))) == "8ca64de9c1b123a7")
}

/**
 * DES single-block decryption inverts encryption for every known-answer vector above.
 */
#test
fn des_decrypt_inverts() {
    teko::assert::is_true(hexed(des_decrypt_block(hex_bytes("0101010101010101"), hex_bytes("8000000000000000"))) == "95f8a5e5dd31d900")
    teko::assert::is_true(hexed(des_decrypt_block(hex_bytes("0123456789abcdef"), hex_bytes("3fa40e8a984d4815"))) == "4e6f772069732074")
    teko::assert::is_true(hexed(des_decrypt_block(hex_bytes("0000000000000000"), hex_bytes("8ca64de9c1b123a7"))) == "0000000000000000")
}

/**
 * A bad DES key or block length is a `CryptoError`, never a panic.
 */
#test
fn des_rejects_bad_lengths() {
    teko::assert::is_true(hexed(des_encrypt_block(hex_bytes("01010101010101"), hex_bytes("95f8a5e5dd31d900"))) == "ERR")
    teko::assert::is_true(hexed(des_encrypt_block(hex_bytes("0101010101010101"), hex_bytes("95f8a5e5dd31d9"))) == "ERR")
}

/**
 * `des_is_weak_key` recognizes all four classic DES weak keys and rejects an ordinary key.
 */
#test
fn des_weak_key_detection() {
    teko::assert::is_true(des_is_weak_key(hex_bytes("0101010101010101")))
    teko::assert::is_true(des_is_weak_key(hex_bytes("fefefefefefefefe")))
    teko::assert::is_true(des_is_weak_key(hex_bytes("e0e0e0e0f1f1f1f1")))
    teko::assert::is_true(des_is_weak_key(hex_bytes("1f1f1f1f0e0e0e0e")))
    teko::assert::is_true(!des_is_weak_key(hex_bytes("0123456789abcdef")))
}

/**
 * 3-key TDEA single-block encrypt/decrypt against a `pycryptodome` `DES3` (`MODE_ECB`)
 * cross-check: `K1=0123456789abcdef`, `K2=fedcba9876543210`, `K3=89abcdef01234567`.
 */
#test
fn tdes_3key_known_answer() {
    var key = hex_bytes("0123456789abcdeffedcba987654321089abcdef01234567")
    var pt = hex_bytes("4e6f772069732074")
    teko::assert::is_true(hexed(tdes_encrypt_block(key, pt)) == "fbe62b683922941e")
    teko::assert::is_true(hexed(tdes_decrypt_block(key, hex_bytes("fbe62b683922941e"))) == to_hex(pt))
}

/**
 * 2-key TDEA (`K3 = K1`) single-block encrypt against the same `pycryptodome` cross-check with
 * `K1 || K2` (16 bytes).
 */
#test
fn tdes_2key_known_answer() {
    var key = hex_bytes("0123456789abcdeffedcba9876543210")
    var pt = hex_bytes("4e6f772069732074")
    teko::assert::is_true(hexed(tdes_encrypt_block(key, pt)) == "d80a0d8b2bae5e4e")
    teko::assert::is_true(hexed(tdes_decrypt_block(key, hex_bytes("d80a0d8b2bae5e4e"))) == to_hex(pt))
}

/**
 * TDEA rejects a key that is neither 16 nor 24 bytes.
 */
#test
fn tdes_rejects_bad_key_length() {
    teko::assert::is_true(hexed(tdes_encrypt_block(hex_bytes("0123456789abcdef"), hex_bytes("4e6f772069732074"))) == "ERR")
}

/**
 * TDEA rejects a weak keying set: `K1 = K2` degenerates the EDE construction toward single DES.
 */
#test
fn tdes_rejects_weak_keying() {
    var key = hex_bytes("0123456789abcdef0123456789abcdef89abcdef01234567")
    teko::assert::is_true(hexed(tdes_encrypt_block(key, hex_bytes("4e6f772069732074"))) == "ERR")
}

/**
 * TDEA rejects a keying set containing a classic DES weak component key.
 */
#test
fn tdes_rejects_weak_component_key() {
    var key = hex_bytes("01010101010101010123456789abcdef89abcdef01234567")
    teko::assert::is_true(hexed(tdes_encrypt_block(key, hex_bytes("4e6f772069732074"))) == "ERR")
}

/**
 * 3-key TDEA-ECB over a two-block message matches the block-by-block `tdes_encrypt_block` results
 * (ECB has no chaining), and decryption inverts it.
 */
#test
fn tdes_ecb_matches_single_block() {
    var key = hex_bytes("0123456789abcdeffedcba987654321089abcdef01234567")
    var pt = hex_bytes("4e6f77206973207468652074696d6520666f7220616c6c20")
    var ct = hexed(tdes_ecb_encrypt(key, pt))
    var expected = teko::str::concat("fbe62b683922941e", hexed(tdes_encrypt_block(key, hex_bytes("68652074696d6520"))), hexed(tdes_encrypt_block(key, hex_bytes("666f7220616c6c20"))))
    teko::assert::is_true(ct == expected)
    teko::assert::is_true(hexed(tdes_ecb_decrypt(key, hex_bytes(ct))) == to_hex(pt))
}

/**
 * 3-key TDEA-CBC against a `pycryptodome` `DES3.MODE_CBC` cross-check over a three-block message
 * with IV `1234567890abcdef`.
 */
#test
fn tdes_3key_cbc_known_answer() {
    var key = hex_bytes("0123456789abcdeffedcba987654321089abcdef01234567")
    var iv = hex_bytes("1234567890abcdef")
    var pt = hex_bytes("4e6f77206973207468652074696d6520666f7220616c6c20")
    var ct = "204011f986e35647199e47af391620c5bb9a5bcfc86db0bb"
    teko::assert::is_true(hexed(tdes_cbc_encrypt(key, iv, pt)) == ct)
    teko::assert::is_true(hexed(tdes_cbc_decrypt(key, iv, hex_bytes(ct))) == to_hex(pt))
}

/**
 * 2-key TDEA-CBC against the matching `pycryptodome` cross-check.
 */
#test
fn tdes_2key_cbc_known_answer() {
    var key = hex_bytes("0123456789abcdeffedcba9876543210")
    var iv = hex_bytes("1234567890abcdef")
    var pt = hex_bytes("4e6f77206973207468652074696d6520666f7220616c6c20")
    var ct = "f85d4ab92066789e1d0430671f28ae7ab9627d35385d2e24"
    teko::assert::is_true(hexed(tdes_cbc_encrypt(key, iv, pt)) == ct)
    teko::assert::is_true(hexed(tdes_cbc_decrypt(key, iv, hex_bytes(ct))) == to_hex(pt))
}

/**
 * TDEA-CBC rejects an IV that is not exactly 8 bytes, and a plaintext length that is not a
 * multiple of 8, both as `CryptoError` rather than a panic.
 */
#test
fn tdes_cbc_rejects_bad_lengths() {
    var key = hex_bytes("0123456789abcdeffedcba987654321089abcdef01234567")
    teko::assert::is_true(hexed(tdes_cbc_encrypt(key, hex_bytes("1234567890"), hex_bytes("4e6f772069732074"))) == "ERR")
    teko::assert::is_true(hexed(tdes_cbc_encrypt(key, hex_bytes("1234567890abcdef"), hex_bytes("4e6f7720697320"))) == "ERR")
}

/**
 * PKCS#7 padding round-trips through `tdes_pkcs7_pad`/`tdes_pkcs7_unpad` for both a partial final
 * block and an already-block-aligned message (which still gets a full pad block, RFC 5652 §6.3).
 */
#test
fn tdes_pkcs7_roundtrip() {
    var partial = bytes_of_str("Now is the")
    var padded = tdes_pkcs7_pad(partial)
    teko::assert::is_true(padded.len % 8 == 0)
    var unpadded = match tdes_pkcs7_unpad(padded) { []byte as v => v; CryptoError => teko::list::empty() }
    teko::assert::is_true(to_hex(unpadded) == to_hex(partial))

    var aligned = bytes_of_str("12345678")
    var padded_aligned = tdes_pkcs7_pad(aligned)
    teko::assert::is_true(padded_aligned.len == 16)
    var unpadded_aligned = match tdes_pkcs7_unpad(padded_aligned) { []byte as v => v; CryptoError => teko::list::empty() }
    teko::assert::is_true(to_hex(unpadded_aligned) == to_hex(aligned))
}

/**
 * `tdes_pkcs7_unpad` rejects malformed padding (a trailing byte that does not match a consistent
 * PKCS#7 tail) as a `CryptoError`.
 */
#test
fn tdes_pkcs7_rejects_malformed_padding() {
    var bad = hex_bytes("0102030405060709")
    teko::assert::is_true(hexed(tdes_pkcs7_unpad(bad)) == "ERR")
}
