use teko::numeric::bigint

fn ec_test_hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

fn ec_test_hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = ec_test_hex_val(chars[i])
        var lo = ec_test_hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

fn ec_test_bigint_hex(s: str): bigint::BigInt {
    match bigint::from_hex(s) {
        bigint::BigInt as b => b
        error => { teko::assert::is_true(false); bigint::zero() }
    }
}

fn ec_test_message(): []byte {
    bytes_of_str("The quick brown fox jumps over the lazy dog")
}

fn ec_test_pub_256(): P256Point {
    P256Point {
        infinity = false
        x = ec_test_bigint_hex("2bfb09c4040800282d35e57a455a95d3084365b4ec15524dfb1bae3e5826f0f9")
        y = ec_test_bigint_hex("a9ab811e17d08374aae063cd1cd387e917d9268fd68f9c52844435a935199b08")
    }
}

fn ec_test_priv_256(): bigint::BigInt {
    ec_test_bigint_hex("0b0c8be674a36687934d142fc0342d684653c7f3dfa8d58ae63d59c3d13ba421")
}

fn ec_test_k_256(): bigint::BigInt {
    ec_test_bigint_hex("3fe2f0846d8b9c1e2e0a2f2e6f0e9c8a1b2c3d4e5f60718293a4b5c6d7e8f901")
}

#test
fn ecdsa_p256_sha256_matches_reference_vector() {
    var priv = ec_test_priv_256()
    var pubkey = ec_test_pub_256()
    var msg = ec_test_message()
    var sig: P256Signature = match ecdsa_p256_sign(priv, EcHashAlg::Sha256, msg, ec_test_k_256()) {
        P256Signature as s => s
        CryptoError => { teko::assert::is_true(false); P256Signature { r = bigint::zero(); s = bigint::zero() } }
    }
    teko::assert::is_true(bigint::eq(sig.r, ec_test_bigint_hex("9fd24e976fda2346da74e1f57e374d5c55229a8d1c37c0c3f7dfed0853b104ed")))
    teko::assert::is_true(bigint::eq(sig.s, ec_test_bigint_hex("83b28f6461759d1604cf18703097b44551839aea5a743cb0e557eb9c0a0be8cf")))
    teko::assert::is_true(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, msg, sig.r, sig.s))
}

#test
fn ecdsa_p256_sha384_matches_reference_vector() {
    var priv = ec_test_bigint_hex("e1ecc8cb4222613dea16941b8aca200019567221e36c55d30d40a7f93ec7fca4")
    var pubkey = P256Point {
        infinity = false
        x = ec_test_bigint_hex("04de28235c5eb7cf195a0d6074f28021aceae16c7469be2c780e77b465b40279")
        y = ec_test_bigint_hex("c823a5f780c2dbd635956950e2a86ebc868775f89796dd1c63c02860d7ec3398")
    }
    var k = ec_test_bigint_hex("1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e6f708192a3b4c5d6e7f809")
    var msg = ec_test_message()
    var sig: P256Signature = match ecdsa_p256_sign(priv, EcHashAlg::Sha384, msg, k) {
        P256Signature as s => s
        CryptoError => { teko::assert::is_true(false); P256Signature { r = bigint::zero(); s = bigint::zero() } }
    }
    teko::assert::is_true(bigint::eq(sig.r, ec_test_bigint_hex("b5a104b6caadfa15a6fb9eb3939237284d404e9d9486b706411457a16f12e84a")))
    teko::assert::is_true(bigint::eq(sig.s, ec_test_bigint_hex("3707eed7e0c4bfa5de22a62d7431dd59a55357c20a69a6e739d30fcf6c0d1542")))
    teko::assert::is_true(ecdsa_p256_verify(pubkey, EcHashAlg::Sha384, msg, sig.r, sig.s))
}

#test
fn ecdsa_p256_verify_rejects_tampering() {
    var pubkey = ec_test_pub_256()
    var msg = ec_test_message()
    var sig: P256Signature = match ecdsa_p256_sign(ec_test_priv_256(), EcHashAlg::Sha256, msg, ec_test_k_256()) {
        P256Signature as s => s
        CryptoError => { teko::assert::is_true(false); P256Signature { r = bigint::zero(); s = bigint::zero() } }
    }

    teko::assert::is_false(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, msg, bigint::add(sig.r, bigint::one()), sig.s))
    teko::assert::is_false(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, msg, sig.r, bigint::add(sig.s, bigint::one())))
    teko::assert::is_false(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, bytes_of_str("a different message"), sig.r, sig.s))
}

#test
fn ecdsa_p256_sign_rejects_out_of_range_nonce() {
    var priv = ec_test_priv_256()
    var msg = ec_test_message()
    match ecdsa_p256_sign(priv, EcHashAlg::Sha256, msg, bigint::zero()) {
        P256Signature => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    var order = ec_test_bigint_hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    match ecdsa_p256_sign(priv, EcHashAlg::Sha256, msg, order) {
        P256Signature => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
}

#test
fn ecdsa_p256_verify_rejects_malformed_inputs() {
    var msg = ec_test_message()
    var off_curve = P256Point { infinity = false; x = bigint::one(); y = bigint::one() }
    teko::assert::is_false(ecdsa_p256_verify(off_curve, EcHashAlg::Sha256, msg, bigint::one(), bigint::one()))

    var pubkey = ec_test_pub_256()
    teko::assert::is_false(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, msg, bigint::zero(), bigint::one()))
    teko::assert::is_false(ecdsa_p256_verify(pubkey, EcHashAlg::Sha256, msg, bigint::one(), bigint::zero()))
}

#test
fn ec_p256_generator_is_on_curve() {
    teko::assert::is_true(ec_p256_is_on_curve(ec_p256_generator()))
    teko::assert::is_true(ec_p256_is_on_curve(P256Point { infinity = true; x = bigint::zero(); y = bigint::zero() }))
}

#test
fn ec_p256_uncompressed_round_trips_and_rejects_malformed_input() {
    var g = ec_p256_generator()
    var encoded: []byte = match ec_p256_point_to_uncompressed(g) {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }
    teko::assert::len_eq(encoded.len, 65)
    var decoded: P256Point = match ec_p256_point_from_uncompressed(encoded) {
        P256Point as p => p
        CryptoError => { teko::assert::is_true(false); P256Point { infinity = true; x = bigint::zero(); y = bigint::zero() } }
    }
    teko::assert::is_true(bigint::eq(decoded.x, g.x))
    teko::assert::is_true(bigint::eq(decoded.y, g.y))

    match ec_p256_point_from_uncompressed(ec_test_hex_bytes("00")) {
        P256Point => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    match ec_p256_point_from_uncompressed(ec_p256_bytes_pad_to_65(ec_test_hex_bytes("02"))) {
        P256Point => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    var off_curve_bytes = ec_test_hex_bytes("04")
    match ec_p256_point_from_uncompressed(ec_p256_bytes_pad_to_65(off_curve_bytes)) {
        P256Point => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
}

fn ec_p256_bytes_pad_to_65(prefix: []byte): []byte {
    var out = prefix
    var i = prefix.len
    loop {
        if i >= 65 { break }
        out = teko::list::push(out, 0 to byte)
        i++
    }
    out
}
