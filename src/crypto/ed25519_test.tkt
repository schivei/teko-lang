/**
 * Tests for `teko::crypto::ed25519`: RFC 8032 §7.1 TEST 1, TEST 2, and TEST 3 (the zero-byte,
 * one-byte, and two-byte published Ed25519 test vectors), each independently re-verified against
 * `cryptography.hazmat`'s `Ed25519PrivateKey`/`Ed25519PublicKey` (an OpenSSL-backed, independent
 * implementation): `Ed25519PrivateKey.from_private_bytes(secret).public_key()` reproduces the
 * published public key byte-for-byte, and `.sign(message)` reproduces the published signature
 * byte-for-byte (Ed25519 signing is fully deterministic, so two independent RFC 8032-conformant
 * implementations MUST agree on every bit).
 *
 * This file lives under `teko::crypto` (namespace = directory), so `teko::crypto::ed25519`'s
 * functions are called bare, mirroring `rsa_test.tkt` / `ec_p256_test.tkt`.
 */

/**
 * The numeric value of one lowercase hex digit (`'0'..'9'`, `'a'..'f'`).
 *
 * @param c  a hex-digit byte
 * @return   the digit's value 0..15 (0 for a non-hex byte, which the fixtures never pass)
 */
fn ed25519_test_hex_val(c: byte): u32 {
    var v = c to u32
    if v >= (b'0' to u32) && v <= (b'9' to u32) { return v - (b'0' to u32) }
    if v >= (b'a' to u32) && v <= (b'f' to u32) { return v - (b'a' to u32) + 10 }
    0
}

/**
 * Decodes an even-length lowercase hex string into the bytes it denotes (the empty string
 * decodes to the empty byte slice, matching TEST 1's zero-length message).
 *
 * @param s  an even-length lowercase hex string
 * @return   the decoded bytes, most-significant nibble first
 */
fn ed25519_test_hex_bytes(s: str): []byte {
    var chars = bytes_of_str(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= chars.len { break }
        var hi = ed25519_test_hex_val(chars[i])
        var lo = ed25519_test_hex_val(chars[i + 1])
        out = teko::list::push(out, ((hi << 4) | lo) to byte)
        i = i + 2
    }
    out
}

/**
 * Runs one RFC 8032 §7.1 known-answer vector end to end: `ed25519_public_key_from_secret`
 * reproduces the published public key, `ed25519_sign` reproduces the published signature
 * byte-for-byte, and `ed25519_verify` accepts the published signature.
 *
 * @param secret_hex  the 32-byte secret key seed, hex
 * @param public_hex  the 32-byte expected public key, hex
 * @param message_hex the message, hex (may be empty, for a zero-length message)
 * @param sig_hex     the 64-byte expected signature, hex
 */
fn ed25519_test_check_vector(secret_hex: str, public_hex: str, message_hex: str, sig_hex: str) {
    var secret = ed25519_test_hex_bytes(secret_hex)
    var expected_public = ed25519_test_hex_bytes(public_hex)
    var message = ed25519_test_hex_bytes(message_hex)
    var expected_sig = ed25519_test_hex_bytes(sig_hex)

    var derived_public: []byte = match ed25519_public_key_from_secret(secret) {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }
    teko::assert::bytes_eq(derived_public, expected_public)

    var sig: []byte = match ed25519_sign(secret, message) {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }
    teko::assert::bytes_eq(sig, expected_sig)
    teko::assert::is_true(ed25519_verify(expected_public, message, expected_sig))
}

/**
 * RFC 8032 §7.1 TEST 1 — the zero-length message vector.
 */
#test
fn ed25519_rfc8032_test1_zero_length_message() {
    ed25519_test_check_vector(
        "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
        "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
        "",
        "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    )
}

/**
 * RFC 8032 §7.1 TEST 2 — the one-byte message vector.
 */
#test
fn ed25519_rfc8032_test2_one_byte_message() {
    ed25519_test_check_vector(
        "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
        "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
        "72",
        "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
    )
}

/**
 * RFC 8032 §7.1 TEST 3 — the two-byte message vector.
 */
#test
fn ed25519_rfc8032_test3_two_byte_message() {
    ed25519_test_check_vector(
        "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
        "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
        "af82",
        "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
    )
}

/**
 * `ed25519_verify` rejects a bit-flipped signature and a signature checked against the wrong
 * message — the two ways a forged/corrupted signature must fail without panicking.
 */
#test
fn ed25519_verify_rejects_tampering() {
    var secret = ed25519_test_hex_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    var public_key: []byte = match ed25519_public_key_from_secret(secret) {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }
    var message = ed25519_test_hex_bytes("72")
    var sig: []byte = match ed25519_sign(secret, message) {
        []byte as b => b
        CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }

    var tampered: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= sig.len { break }
        var v = sig[i]
        if i == 0 { v = v ^ (0x01 to byte) }
        tampered = teko::list::push(tampered, v)
        i++
    }
    teko::assert::is_false(ed25519_verify(public_key, message, tampered))
    teko::assert::is_false(ed25519_verify(public_key, ed25519_test_hex_bytes("00"), sig))
}

/**
 * `ed25519_sign`/`ed25519_public_key_from_secret` reject a wrong-length secret key as a
 * `CryptoError`, never a panic; `ed25519_verify` rejects a wrong-length public key or signature
 * as `false`, never a panic.
 */
#test
fn ed25519_rejects_malformed_input_lengths() {
    var short_secret = ed25519_test_hex_bytes("0011")
    match ed25519_sign(short_secret, ed25519_test_hex_bytes("00")) {
        []byte => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }
    match ed25519_public_key_from_secret(short_secret) {
        []byte => teko::assert::is_true(false)
        CryptoError => teko::assert::is_true(true)
    }

    var public_key = ed25519_test_hex_bytes("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    teko::assert::is_false(ed25519_verify(ed25519_test_hex_bytes("00"), ed25519_test_hex_bytes("00"), ed25519_test_hex_bytes("00")))
    teko::assert::is_false(ed25519_verify(public_key, ed25519_test_hex_bytes("00"), ed25519_test_hex_bytes("00")))
}
