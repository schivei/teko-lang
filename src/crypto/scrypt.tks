/**
 * `teko::crypto::scrypt` — the scrypt memory-hard password-based key-derivation function
 * (RFC 7914): Salsa20/8 Core, scryptBlockMix, scryptROMix, and the top-level `scrypt` entry
 * point, wired onto the existing `pbkdf2_sha256` (`kdf.tks`). Pure Teko over `[]byte`, no OS
 * dependency, testable via `.tkt` against the RFC 7914 known-answer vectors.
 *
 * scrypt's memory-hardness comes from `scryptROMix`: it fills an `N`-element vector `V` of
 * `128*r`-byte blocks by iterating `scryptBlockMix`, then makes `N` further passes reading
 * `V` at pseudo-random indices — an intentionally random-access structure. Teko's NO
 * INDEX-ASSIGNMENT discipline (`teko::list::push`/`teko::list::empty` only) means every READ
 * of `V[j]` is a cheap slice (`scrypt_bytes_slice`), but this module still builds the WHOLE
 * `V` vector once (sequentially, via push) rather than mutating single elements — there is no
 * random-access WRITE in scryptROMix (`V[i]` is only ever written once, in index order), so
 * this file carries none of the O(memory^2) rebuild cost `argon2.tks` documents for Argon2id's
 * genuinely random-access memory array.
 *
 * PUBLIC SURFACE IS `exp` (catalog §0 framing); every Salsa20/8/BlockMix/ROMix helper is
 * file-local, prefixed `scrypt_` (tree-wide unique helper names, avoiding the flat-namespace
 * union-tag collision class `docs/design/fix-union-tag-cross-namespace-codegen.md` documents
 * for same-bare-name TYPES — this file declares no new struct type used in a `T | error`
 * union other than the shared `CryptoError`, so that hazard does not apply here, but unique
 * function names are kept anyway per the stdlib lane's own convention).
 */

/**
 * A working quartet of the Salsa20/8 core's 4x4 word matrix, returned by `scrypt_quarterround`
 * so the caller can rebuild its 16-word state without index-assignment.
 */
type SalsaQuad = struct {
    /** the first updated word */
    a: u32
    /** the second updated word */
    b: u32
    /** the third updated word */
    c: u32
    /** the fourth updated word */
    d: u32
}

/**
 * Left-rotates a 32-bit word by `count` bits — the `R(a,b)` primitive RFC 7914 §3 defines for
 * the Salsa20/8 core.
 *
 * @param x      the word to rotate
 * @param count  the rotation amount in bits, 1..31
 * @return       `x` rotated left by `count` bits
 */
fn scrypt_rotl32(x: u32, count: u32): u32 {
    (x << count) | (x >> (32 - count))
}

/**
 * Reads a little-endian 32-bit word out of `b` at byte offset `off` — the wire order Salsa20/8
 * reads its 16-word input in (RFC 7914 §3, "without endianness conversion" in the reference C
 * meaning the caller supplies little-endian words).
 *
 * @param b    the byte slice being read
 * @param off  the starting byte offset (`off+3` must be in bounds)
 * @return     the little-endian 32-bit value at `b[off..off+4)`
 */
fn scrypt_le_u32_at(b: []byte, off: u64): u32 {
    (b[off] to u32) | ((b[off + 1] to u32) << 8) | ((b[off + 2] to u32) << 16) | ((b[off + 3] to u32) << 24)
}

/**
 * Appends a 32-bit word to `buf` in little-endian byte order.
 *
 * @param buf  the output buffer to extend
 * @param x    the word to emit, least-significant byte first
 * @return     `buf` with `x`'s four little-endian bytes appended
 */
fn scrypt_push_le32(buf: []byte, x: u32): []byte {
    var b = buf
    b = teko::list::push(b, (x & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 8) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 16) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 24) & 0xFF) to byte)
    b
}

/**
 * Appends every byte of `src` onto a copy of `dst`, returning the concatenation.
 *
 * @param dst  the prefix bytes
 * @param src  the bytes to append after `dst`
 * @return     a fresh slice holding `dst` followed by `src`
 */
fn scrypt_bytes_append(dst: []byte, src: []byte): []byte {
    var out = dst
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        out = teko::list::push(out, src[i])
        i++
    }
    out
}

/**
 * The sub-slice `data[from..to)` as a fresh `[]byte`.
 *
 * @param data  the source slice
 * @param from  the inclusive start index
 * @param to    the exclusive end index
 * @return      a fresh slice holding `data[from..to)`
 */
fn scrypt_bytes_slice(data: []byte, from: u64, to: u64): []byte {
    var out: []byte = teko::list::empty()
    var i = from
    loop {
        if i >= to { break }
        out = teko::list::push(out, data[i])
        i++
    }
    out
}

/**
 * The byte-wise XOR of two equal-length slices — the `T = X xor B[i]` step of scryptBlockMix
 * and the `T = X xor V[j]` step of scryptROMix.
 *
 * @param a  the first slice
 * @param b  the second slice (the caller guarantees `a.len == b.len`)
 * @return   a fresh slice with `a[i] ⊕ b[i]` at every index
 */
fn scrypt_bytes_xor(a: []byte, b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        out = teko::list::push(out, ((a[i] to u32) ^ (b[i] to u32)) to byte)
        i++
    }
    out
}

/**
 * `true` iff `n` is a power of two strictly greater than 1 — the CPU/memory cost parameter `N`'s
 * required shape (RFC 7914 §2: "must be larger than 1, a power of 2").
 *
 * @param n  the candidate value
 * @return   whether `n` is a valid scrypt `N`
 */
fn scrypt_is_pow2_gt1(n: u64): bool {
    n > 1 && (n & (n - 1)) == 0
}

/**
 * One Salsa20 quarterround (the reusable 4-word transform underlying both the Salsa20/8 core's
 * column round and row round): `b ^= R(a+d,7); c ^= R(b+a,9); d ^= R(c+b,13); a ^= R(d+c,18)`,
 * with every add 32-bit-wrapping.
 *
 * @param a  the first word
 * @param b  the second word
 * @param c  the third word
 * @param d  the fourth word
 * @return   the four words after the quarterround, in the same `a,b,c,d` order
 */
fn scrypt_quarterround(a: u32, b: u32, c: u32, d: u32): SalsaQuad {
    var nb = b ^ scrypt_rotl32(teko::math::wrapping_add_u32(a, d), 7)
    var nc = c ^ scrypt_rotl32(teko::math::wrapping_add_u32(nb, a), 9)
    var nd = d ^ scrypt_rotl32(teko::math::wrapping_add_u32(nc, nb), 13)
    var na = a ^ scrypt_rotl32(teko::math::wrapping_add_u32(nd, nc), 18)
    SalsaQuad { a = na; b = nb; c = nc; d = nd }
}

/**
 * The Salsa20/8 core hash function (RFC 7914 §3): a fixed permutation from 64 octets to 64
 * octets, built from 4 double-rounds (8 quarterrounds each: a column round over
 * `(0,4,8,12)/(5,9,13,1)/(10,14,2,6)/(15,3,7,11)` then a row round over
 * `(0,1,2,3)/(5,6,7,4)/(10,11,8,9)/(15,12,13,14)`), followed by feed-forward addition of the
 * original 16 words.
 *
 * @param input  the 64-byte input block
 * @return       the 64-byte Salsa20/8 output block
 */
fn scrypt_salsa_core(input: []byte): []byte {
    var in0 = scrypt_le_u32_at(input, 0)
    var in1 = scrypt_le_u32_at(input, 4)
    var in2 = scrypt_le_u32_at(input, 8)
    var in3 = scrypt_le_u32_at(input, 12)
    var in4 = scrypt_le_u32_at(input, 16)
    var in5 = scrypt_le_u32_at(input, 20)
    var in6 = scrypt_le_u32_at(input, 24)
    var in7 = scrypt_le_u32_at(input, 28)
    var in8 = scrypt_le_u32_at(input, 32)
    var in9 = scrypt_le_u32_at(input, 36)
    var in10 = scrypt_le_u32_at(input, 40)
    var in11 = scrypt_le_u32_at(input, 44)
    var in12 = scrypt_le_u32_at(input, 48)
    var in13 = scrypt_le_u32_at(input, 52)
    var in14 = scrypt_le_u32_at(input, 56)
    var in15 = scrypt_le_u32_at(input, 60)
    var x0 = in0
    var x1 = in1
    var x2 = in2
    var x3 = in3
    var x4 = in4
    var x5 = in5
    var x6 = in6
    var x7 = in7
    var x8 = in8
    var x9 = in9
    var x10 = in10
    var x11 = in11
    var x12 = in12
    var x13 = in13
    var x14 = in14
    var x15 = in15
    var round: u64 = 0
    loop {
        if round >= 4 { break }
        var c0 = scrypt_quarterround(x0, x4, x8, x12)
        x0 = c0.a
        x4 = c0.b
        x8 = c0.c
        x12 = c0.d
        var c1 = scrypt_quarterround(x5, x9, x13, x1)
        x5 = c1.a
        x9 = c1.b
        x13 = c1.c
        x1 = c1.d
        var c2 = scrypt_quarterround(x10, x14, x2, x6)
        x10 = c2.a
        x14 = c2.b
        x2 = c2.c
        x6 = c2.d
        var c3 = scrypt_quarterround(x15, x3, x7, x11)
        x15 = c3.a
        x3 = c3.b
        x7 = c3.c
        x11 = c3.d
        var r0 = scrypt_quarterround(x0, x1, x2, x3)
        x0 = r0.a
        x1 = r0.b
        x2 = r0.c
        x3 = r0.d
        var r1 = scrypt_quarterround(x5, x6, x7, x4)
        x5 = r1.a
        x6 = r1.b
        x7 = r1.c
        x4 = r1.d
        var r2 = scrypt_quarterround(x10, x11, x8, x9)
        x10 = r2.a
        x11 = r2.b
        x8 = r2.c
        x9 = r2.d
        var r3 = scrypt_quarterround(x15, x12, x13, x14)
        x15 = r3.a
        x12 = r3.b
        x13 = r3.c
        x14 = r3.d
        round++
    }
    var out: []byte = teko::list::empty()
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x0, in0))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x1, in1))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x2, in2))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x3, in3))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x4, in4))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x5, in5))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x6, in6))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x7, in7))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x8, in8))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x9, in9))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x10, in10))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x11, in11))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x12, in12))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x13, in13))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x14, in14))
    out = scrypt_push_le32(out, teko::math::wrapping_add_u32(x15, in15))
    out
}

/**
 * scryptBlockMix (RFC 7914 §4): mixes `2*r` 64-byte blocks through the Salsa20/8 core in a
 * chain (each block XORed with the running state before hashing), then de-interleaves the
 * results into the even-indexed halves followed by the odd-indexed halves.
 *
 * @param input  `128*r` bytes, `2*r` 64-byte blocks `B[0]..B[2r-1]`
 * @param r      the block size parameter
 * @return       `128*r` bytes, the mixed and de-interleaved output blocks
 */
fn scrypt_blockmix(input: []byte, r: u64): []byte {
    var blocks = 2 * r
    var x = scrypt_bytes_slice(input, (blocks - 1) * 64, blocks * 64)
    var y: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= blocks { break }
        var bi = scrypt_bytes_slice(input, i * 64, i * 64 + 64)
        x = scrypt_salsa_core(scrypt_bytes_xor(x, bi))
        y = scrypt_bytes_append(y, x)
        i++
    }
    var out: []byte = teko::list::empty()
    var e: u64 = 0
    loop {
        if e >= blocks { break }
        out = scrypt_bytes_append(out, scrypt_bytes_slice(y, e * 64, e * 64 + 64))
        e = e + 2
    }
    var o: u64 = 1
    loop {
        if o >= blocks { break }
        out = scrypt_bytes_append(out, scrypt_bytes_slice(y, o * 64, o * 64 + 64))
        o = o + 2
    }
    out
}

/**
 * The `Integerify` step of scryptROMix (RFC 7914 §5): interprets the last 64-byte sub-block of
 * a `128*r`-byte block as a little-endian integer, truncated to the low 64 bits (every
 * realistic `N` fits comfortably within 64 bits, so this truncation never changes the `mod N`
 * result the caller computes).
 *
 * @param block  a `128*r`-byte scryptBlockMix output
 * @param r      the block size parameter
 * @return       the low 64 bits of the last 64-byte sub-block, little-endian
 */
fn scrypt_integerify(block: []byte, r: u64): u64 {
    var off = (2 * r - 1) * 64
    var lo = scrypt_le_u32_at(block, off) to u64
    var hi = scrypt_le_u32_at(block, off + 4) to u64
    lo | (hi << 32)
}

/**
 * scryptROMix (RFC 7914 §5): fills an `N`-element vector `V` with the successive
 * scryptBlockMix states (the memory-hard fill pass), then makes `N` further scryptBlockMix
 * passes reading `V` at the pseudo-random index `Integerify(X) mod N` (the memory-hard mix
 * pass). `V` is built once via `teko::list::push` in strict index order — never
 * random-access WRITTEN — so the NO INDEX-ASSIGNMENT discipline costs nothing here; only the
 * second pass's reads are random-access, and reads are a cheap slice.
 *
 * @param input  `128*r` bytes, the block to mix
 * @param r      the block size parameter
 * @param n      the CPU/memory cost parameter (a power of two greater than 1)
 * @return       `128*r` bytes, the memory-hard-mixed output block
 */
fn scrypt_romix(input: []byte, r: u64, n: u64): []byte {
    var block_bytes = 128 * r
    var x = input
    var v: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        v = scrypt_bytes_append(v, x)
        x = scrypt_blockmix(x, r)
        i++
    }
    var j: u64 = 0
    loop {
        if j >= n { break }
        var idx = scrypt_integerify(x, r) % n
        var vj = scrypt_bytes_slice(v, idx * block_bytes, idx * block_bytes + block_bytes)
        x = scrypt_blockmix(scrypt_bytes_xor(x, vj), r)
        j++
    }
    x
}

/**
 * scrypt (RFC 7914 §6): the password-based key-derivation function built from
 * `PBKDF2-HMAC-SHA-256` (reusing `pbkdf2_sha256`, `kdf.tks`) bracketing `p` independent
 * `scryptROMix` memory-hard passes. Deliberately slow and memory-hungry — the caller tunes
 * `n`/`r`/`p` for the target hardware.
 *
 * @param password  the passphrase bytes
 * @param salt      the salt bytes
 * @param n         the CPU/memory cost parameter: must be a power of two greater than 1
 * @param r         the block size parameter: must be at least 1
 * @param p         the parallelization parameter: must be at least 1
 * @param dk_len    the derived-key length in bytes: must be at least 1
 * @return          the `dk_len`-byte derived key, or a `CryptoError` on an invalid parameter
 * @throws          `CryptoError` when `n`/`r`/`p`/`dk_len` fail their validity constraints, or
 *                   when the underlying `pbkdf2_sha256` calls reject their derived lengths
 */
exp fn scrypt(password: []byte, salt: []byte, n: u64, r: u64, p: u64, dk_len: u64): []byte | CryptoError {
    if !scrypt_is_pow2_gt1(n) { return crypto_error("scrypt: n must be a power of two greater than 1") }
    if r == 0 { return crypto_error("scrypt: r must be at least 1") }
    if p == 0 { return crypto_error("scrypt: p must be at least 1") }
    if dk_len == 0 { return crypto_error("scrypt: dk_len must be at least 1") }
    var block_bytes = 128 * r
    var seed = match pbkdf2_sha256(password, salt, 1, p * block_bytes) {
        []byte as s => s
        CryptoError as e => return e
    }
    var mixed: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= p { break }
        var bi = scrypt_bytes_slice(seed, i * block_bytes, i * block_bytes + block_bytes)
        mixed = scrypt_bytes_append(mixed, scrypt_romix(bi, r, n))
        i++
    }
    pbkdf2_sha256(password, mixed, 1, dk_len)
}
