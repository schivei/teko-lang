#test
fn jwk_rsa_sign_verify_round_trip() {
    var want = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.SQ2CF8JygIt9BWngEpeNwNiq5JyS3IWsHSEbZe5kn38Ip-X2cvCw9sEzOHUadPWlIEu_Azg98J-rZXCWNnJohUWw7vgGWmwpdgWTSXlrndymfVsFDHMB9-4G81_6bCS1f4QG8y0Ox-mnH-WLKzc-ZuJj1hAYIdxWv37xg4I1sc8"
    var sign_key = jt_unwrap_key(jwk_to_sign_key(jt_jwk_rsa_private_json()))
    var verify_key = jt_unwrap_key(jwk_to_verify_key(jt_jwk_rsa_public_json()))
    var tok = jt_unwrap_str(jwt_sign(JwsAlg::RS256, sign_key, jt_claims()))
    teko::assert::eq_str(tok, want)
    teko::assert::eq_str(jt_unwrap_str(jwt_verify(verify_key, tok)), jt_claims())
}

#test
fn jwk_to_sign_key_rejects_public_only_rsa() {
    match jwk_to_sign_key(jt_jwk_rsa_public_json()) {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

