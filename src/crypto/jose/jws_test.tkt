#test
fn jwk_rejects_unsupported_ec_curve() {
    var bad = "{\"kty\":\"EC\",\"crv\":\"P-384\",\"x\":\"Vno6-LjkCp2hoZ0CEOHqsIUIlkkaC4wxA3957Z4vurc\",\"y\":\"9YXvk0uv5GeoMlMe07jfs_wPF3dPFKWaO-Fgx9HKJaQ\"}"
    match jwk_to_verify_key(bad) {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

