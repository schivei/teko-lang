 */
fn jt_jwk_okp_private_json(): str {
    "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"mXsvrCbC7teFND62ezrDQiZlqp52zl1ZGxWOE9HUh3M\",\"d\":\"-TLtZ18kn2REdmmWuDxULLXyyPOcZPnJO5-krISxxL4\"}"
}

/**
 * @return  the public-only `"OKP"` JWK JSON text (same `x` as `jt_jwk_okp_private_json`)
 */
fn jt_jwk_okp_public_json(): str {
    "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"mXsvrCbC7teFND62ezrDQiZlqp52zl1ZGxWOE9HUh3M\"}"
}

/**
 * Importing and using an `"OKP"` JWK produces the SAME EdDSA token as the raw `JwkOkpPrivate`
 * struct (`eddsa_matches_pyjwt_and_round_trips`), and the public-only JWK verifies it.
 */
#test
fn jwk_okp_sign_verify_round_trip() {
    var want = "eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ.fiHH-0Z9EiEdfbcFa60z_k24fcw0k6frrRkgCLEWzLc7_M03h9MnJ50G1N8G-mNeYwL876A8QVUcWgxtkZXCCg"
    var sign_key = jt_unwrap_key(jwk_to_sign_key(jt_jwk_okp_private_json()))
    var verify_key = jt_unwrap_key(jwk_to_verify_key(jt_jwk_okp_public_json()))
    var tok = jt_unwrap_str(jwt_sign(JwsAlg::EdDSA, sign_key, jt_claims()))
    teko::assert::eq_str(tok, want)
    teko::assert::eq_str(jt_unwrap_str(jwt_verify(verify_key, tok)), jt_claims())
}

/**
 * `jwk_to_verify_key` rejects malformed JSON, a non-object top-level value, a missing `kty`, and
 * an unsupported `kty` — every failure a `CryptoError`, never a panic.
 */
#test
fn jwk_import_rejects_malformed_input() {
    match jwk_to_verify_key("not json") {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
    match jwk_to_verify_key("[1,2,3]") {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
    match jwk_to_verify_key("{\"k\":\"AAAA\"}") {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
    match jwk_to_verify_key("{\"kty\":\"unknown-family\"}") {
        (@JoseKey()) as k => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}
