#test
fn jwk_ec_sign_verify_round_trip() {
    var sign_key = jt_unwrap_key(jwk_to_sign_key(jt_jwk_ec_private_json()))
    var verify_key = jt_unwrap_key(jwk_to_verify_key(jt_jwk_ec_public_json()))
    var tok = jt_unwrap_str(jwt_sign(JwsAlg::ES256, sign_key, jt_claims()))
