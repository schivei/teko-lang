/**
 * `teko::crypto::des` — the DES (FIPS 46-3) single-block cipher primitive: the initial/final
 * permutations, the 16-round Feistel network (expansion `E`, eight S-boxes, permutation `P`),
 * and the key schedule (`PC-1`/`PC-2` plus the per-round left rotations).
 *
 * **LEGACY / DEPRECATED — interop only.** DES has a 56-bit effective key (brute-forceable) and a
 * 64-bit block (subject to the "Sweet32" birthday-bound collision attack across ~2^32 blocks
 * under one key in a chaining mode). It MUST NOT be used for new work; it ships only so a caller
 * can read/write a legacy format that mandates it. `teko::crypto::tdes` builds 3DES (TDEA) on top
 * of this file's single-block primitive.
 *
 * FLAT SURFACE (the `teko::crypto` convention): every exported symbol lives directly under
 * `teko::crypto`, called bare — `des_encrypt_block`, not `teko::crypto::des::encrypt_block`.
 *
 * WORKS IN u64/u32 BIT ARITHMETIC throughout: DES is a bit-permutation-heavy cipher, and
 * bitwise operators on a bare `byte` are rejected by the checker, so every block/key/subkey is
 * packed into a `u64` (or a 32-bit half into a `u32`) for the whole computation and only
 * unpacked to `[]byte` at the very edges (`des_block_to_u64`/`des_u64_to_block`).
 *
 * NO INDEX-ASSIGNMENT: every output buffer is built via `teko::list::push`, matching
 * `teko::crypto::cipher`'s discipline. The S-boxes and permutation tables are module consts.
 */

/**
 * DES_IP_TABLE — the Initial Permutation (FIPS 46-3 Table 1): `IP` reorders the 64 input bits
 * (1-indexed from the most significant bit) before the first Feistel round.
 */
const DES_IP_TABLE: []u32 = [
    58, 50, 42, 34, 26, 18, 10, 2,
    60, 52, 44, 36, 28, 20, 12, 4,
    62, 54, 46, 38, 30, 22, 14, 6,
    64, 56, 48, 40, 32, 24, 16, 8,
    57, 49, 41, 33, 25, 17, 9, 1,
    59, 51, 43, 35, 27, 19, 11, 3,
    61, 53, 45, 37, 29, 21, 13, 5,
    63, 55, 47, 39, 31, 23, 15, 7
]

/**
 * DES_FP_TABLE — the Final Permutation (FIPS 46-3 Table 1, `IP^-1`): applied to the pre-output
 * block (`R16 || L16`) after the 16 Feistel rounds to produce the cipher/plain text.
 */
const DES_FP_TABLE: []u32 = [
    40, 8, 48, 16, 56, 24, 64, 32,
    39, 7, 47, 15, 55, 23, 63, 31,
    38, 6, 46, 14, 54, 22, 62, 30,
    37, 5, 45, 13, 53, 21, 61, 29,
    36, 4, 44, 12, 52, 20, 60, 28,
    35, 3, 43, 11, 51, 19, 59, 27,
    34, 2, 42, 10, 50, 18, 58, 26,
    33, 1, 41, 9, 49, 17, 57, 25
]

/**
 * DES_E_TABLE — the round-function expansion permutation `E` (FIPS 46-3 Table 2): expands the
 * 32-bit right half to 48 bits by duplicating each block boundary bit, feeding the eight S-boxes.
 */
const DES_E_TABLE: []u32 = [
    32, 1, 2, 3, 4, 5,
    4, 5, 6, 7, 8, 9,
    8, 9, 10, 11, 12, 13,
    12, 13, 14, 15, 16, 17,
    16, 17, 18, 19, 20, 21,
    20, 21, 22, 23, 24, 25,
    24, 25, 26, 27, 28, 29,
    28, 29, 30, 31, 32, 1
]

/**
 * DES_P_TABLE — the round-function output permutation `P` (FIPS 46-3 Table 3): scrambles the
 * concatenated 32-bit S-box output before it is XORed into the left half.
 */
const DES_P_TABLE: []u32 = [
    16, 7, 20, 21, 29, 12, 28, 17,
    1, 15, 23, 26, 5, 18, 31, 10,
    2, 8, 24, 14, 32, 27, 3, 9,
    19, 13, 30, 6, 22, 11, 4, 25
]

/**
 * DES_PC1_TABLE — Permuted Choice 1 (FIPS 46-3 Table 4): drops the 8 parity bits from the 64-bit
 * key and permutes the remaining 56 into the initial `C0 || D0` key-schedule register.
 */
const DES_PC1_TABLE: []u32 = [
    57, 49, 41, 33, 25, 17, 9,
    1, 58, 50, 42, 34, 26, 18,
    10, 2, 59, 51, 43, 35, 27,
    19, 11, 3, 60, 52, 44, 36,
    63, 55, 47, 39, 31, 23, 15,
    7, 62, 54, 46, 38, 30, 22,
    14, 6, 61, 53, 45, 37, 29,
    21, 13, 5, 28, 20, 12, 4
]

/**
 * DES_PC2_TABLE — Permuted Choice 2 (FIPS 46-3 Table 5): selects and permutes 48 of the 56
 * `C_i || D_i` bits into each round's subkey `K_i`.
 */
const DES_PC2_TABLE: []u32 = [
    14, 17, 11, 24, 1, 5,
    3, 28, 15, 6, 21, 10,
    23, 19, 12, 4, 26, 8,
    16, 7, 27, 20, 13, 2,
    41, 52, 31, 37, 47, 55,
    30, 40, 51, 45, 33, 48,
    44, 49, 39, 56, 34, 53,
    46, 42, 50, 36, 29, 32
]

/**
 * DES_SHIFTS — the per-round left-rotation counts applied to `C`/`D` before deriving each
 * subkey (FIPS 46-3 Table 6): 1 bit for rounds 1, 2, 9, and 16; 2 bits for every other round.
 */
const DES_SHIFTS: []u64 = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]

/**
 * DES_SBOX — the eight DES substitution boxes (FIPS 46-3 Table 7), flattened into one 512-entry
 * table: `DES_SBOX[box * 64 + row * 16 + col]` is `S_{box+1}(row, col)`.
 */
const DES_SBOX: []u32 = [
    14, 4, 13, 1, 2, 15, 11, 8, 3, 10, 6, 12, 5, 9, 0, 7,
    0, 15, 7, 4, 14, 2, 13, 1, 10, 6, 12, 11, 9, 5, 3, 8,
    4, 1, 14, 8, 13, 6, 2, 11, 15, 12, 9, 7, 3, 10, 5, 0,
    15, 12, 8, 2, 4, 9, 1, 7, 5, 11, 3, 14, 10, 0, 6, 13,
    15, 1, 8, 14, 6, 11, 3, 4, 9, 7, 2, 13, 12, 0, 5, 10,
    3, 13, 4, 7, 15, 2, 8, 14, 12, 0, 1, 10, 6, 9, 11, 5,
    0, 14, 7, 11, 10, 4, 13, 1, 5, 8, 12, 6, 9, 3, 2, 15,
    13, 8, 10, 1, 3, 15, 4, 2, 11, 6, 7, 12, 0, 5, 14, 9,
    10, 0, 9, 14, 6, 3, 15, 5, 1, 13, 12, 7, 11, 4, 2, 8,
    13, 7, 0, 9, 3, 4, 6, 10, 2, 8, 5, 14, 12, 11, 15, 1,
    13, 6, 4, 9, 8, 15, 3, 0, 11, 1, 2, 12, 5, 10, 14, 7,
    1, 10, 13, 0, 6, 9, 8, 7, 4, 15, 14, 3, 11, 5, 2, 12,
    7, 13, 14, 3, 0, 6, 9, 10, 1, 2, 8, 5, 11, 12, 4, 15,
    13, 8, 11, 5, 6, 15, 0, 3, 4, 7, 2, 12, 1, 10, 14, 9,
    10, 6, 9, 0, 12, 11, 7, 13, 15, 1, 3, 14, 5, 2, 8, 4,
    3, 15, 0, 6, 10, 1, 13, 8, 9, 4, 5, 11, 12, 7, 2, 14,
    2, 12, 4, 1, 7, 10, 11, 6, 8, 5, 3, 15, 13, 0, 14, 9,
    14, 11, 2, 12, 4, 7, 13, 1, 5, 0, 15, 10, 3, 9, 8, 6,
    4, 2, 1, 11, 10, 13, 7, 8, 15, 9, 12, 5, 6, 3, 0, 14,
    11, 8, 12, 7, 1, 14, 2, 13, 6, 15, 0, 9, 10, 4, 5, 3,
    12, 1, 10, 15, 9, 2, 6, 8, 0, 13, 3, 4, 14, 7, 5, 11,
    10, 15, 4, 2, 7, 12, 9, 5, 6, 1, 13, 14, 0, 11, 3, 8,
    9, 14, 15, 5, 2, 8, 12, 3, 7, 0, 4, 10, 1, 13, 11, 6,
    4, 3, 2, 12, 9, 5, 15, 10, 11, 14, 1, 7, 6, 0, 8, 13,
    4, 11, 2, 14, 15, 0, 8, 13, 3, 12, 9, 7, 5, 10, 6, 1,
    13, 0, 11, 7, 4, 9, 1, 10, 14, 3, 5, 12, 2, 15, 8, 6,
    1, 4, 11, 13, 12, 3, 7, 14, 10, 15, 6, 8, 0, 5, 9, 2,
    6, 11, 13, 8, 1, 4, 10, 7, 9, 5, 0, 15, 14, 2, 3, 12,
    13, 2, 8, 4, 6, 15, 11, 1, 10, 9, 3, 14, 5, 0, 12, 7,
    1, 15, 13, 8, 10, 3, 7, 4, 12, 5, 6, 11, 0, 14, 9, 2,
    7, 11, 4, 1, 9, 12, 14, 2, 0, 6, 10, 13, 15, 3, 5, 8,
    2, 1, 14, 7, 4, 10, 8, 13, 15, 12, 9, 0, 3, 5, 6, 11
]

/**
 * The four classic DES weak keys (FIPS 46-3 / SP 800-67 note): a weak key makes DES encryption
 * its own inverse (`E_K = D_K`), so `DES_WEAK_KEYS[i]` packed as a 64-bit value (including the
 * parity bits) is rejected wherever a caller asks for weak-key validation (`tdes_key_expand`
 * checks each TDEA component key against this table).
 */
const DES_WEAK_KEYS: []u64 = [
    0x0101010101010101,
    0xFEFEFEFEFEFEFEFE,
    0xE0E0E0E0F1F1F1F1,
    0x1F1F1F1F0E0E0E0E
]

/**
 * An expanded DES key: the 16 round subkeys (48 bits each, low-order-packed in a `u64`), so a
 * caller schedules a key once (`des_key_expand`) and reuses it across every block.
 */
exp type DesKey = struct {
    /** the 16 round subkeys `K1..K16`, each the low 48 bits of its `u64` slot, in round order */
    round_keys: []u64
}

/**
 * The left/right 32-bit halves of a DES Feistel round, each stored as the low 32 bits of a
 * `u64` — returned as a value because a round updates both halves from one input pair.
 */
type DesFeistelHalves = struct {
    /** the new left half (the previous round's right half, unchanged) */
    l: u64
    /** the new right half (`l_prev XOR f(r_prev, subkey)`) */
    r: u64
}

/**
 * Packs an 8-byte block into a `u64`, most-significant byte first — DES's bit-1-is-MSB
 * convention, so `des_permute`'s 1-indexed-from-the-left tables apply directly.
 *
 * @param b  the 8-byte block
 * @return   the packed 64-bit value
 */
fn des_block_to_u64(b: []byte): u64 {
    var out: u64 = 0
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        out = (out << 8) | ((b[i] to u32) to u64)
        i++
    }
    out
}

/**
 * Unpacks a 64-bit value into an 8-byte block, most-significant byte first — the inverse of
 * `des_block_to_u64`.
 *
 * @param x  the 64-bit value
 * @return   the 8-byte big-endian block
 */
fn des_u64_to_block(x: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        var shift = (7 - i) * 8
        out = teko::list::push(out, ((x >> shift) & 0xFF) to byte)
        i++
    }
    out
}

/**
 * Applies a DES bit-permutation table to a packed value: output bit `j` (1-indexed from the
 * left, `j` in `1..table.len`) is input bit `table[j-1]` (1-indexed from the left of a `width`-
 * bit source). The one primitive behind `IP`/`FP`/`E`/`P`/`PC-1`/`PC-2`.
 *
 * @param src    the source value, its meaningful bits in the low `width` bits
 * @param width  the source's bit width (64, 56, or 32 in this file)
 * @param table  the 1-indexed permutation table; its length is the output bit width
 * @return       the permuted value, packed into the low `table.len` bits
 */
fn des_permute(src: u64, width: u64, table: []u32): u64 {
    var out: u64 = 0
    var i: u64 = 0
    loop {
        if i >= table.len { break }
        var pos = (table[i] to u64)
        var shift = width - pos
        var bit = (src >> shift) & 1
        out = (out << 1) | bit
        i++
    }
    out
}

/**
 * Rotates a 28-bit value (packed in the low bits of a `u64`) left by `count` bits, wrapping
 * within the 28-bit field — the `C_i`/`D_i` key-schedule rotation (FIPS 46-3 Table 6).
 *
 * @param x      the 28-bit value, in the low bits
 * @param count  the rotation count (1 or 2 in the DES schedule)
 * @return       `x` rotated left by `count` within a 28-bit field
 */
fn des_rotl28(x: u64, count: u64): u64 {
    ((x << count) | (x >> (28 - count))) & 0xFFFFFFF
}

/**
 * Reverses the order of a round-key list — turns the encryption subkey order `K1..K16` into the
 * decryption order `K16..K1` (DES decryption is encryption with the schedule reversed).
 *
 * @param keys  the subkeys in some order
 * @return      a fresh list holding `keys` in reverse order
 */
fn des_reverse_keys(keys: []u64): []u64 {
    var out: []u64 = teko::list::empty()
    var i: u64 = keys.len
    loop {
        if i == 0 { break }
        i--
        out = teko::list::push(out, keys[i])
    }
    out
}

/**
 * Derives the 16 round subkeys from an 8-byte DES key (FIPS 46-3 §3.2): `PC-1` drops the parity
 * bits into the initial `C0 || D0`, then each round left-rotates both halves per `DES_SHIFTS` and
 * `PC-2` selects that round's 48-bit subkey.
 *
 * @param key8  the 8-byte DES key (including parity bits; the caller guarantees the length)
 * @return      the 16 round subkeys `K1..K16`, in round order
 */
fn des_key_schedule(key8: []byte): []u64 {
    var pc1 = des_permute(des_block_to_u64(key8), 64, DES_PC1_TABLE)
    var c = (pc1 >> 28) & 0xFFFFFFF
    var d = pc1 & 0xFFFFFFF
    var keys: []u64 = teko::list::empty()
    var round: u64 = 0
    loop {
        if round >= 16 { break }
        c = des_rotl28(c, DES_SHIFTS[round])
        d = des_rotl28(d, DES_SHIFTS[round])
        keys = teko::list::push(keys, des_permute((c << 28) | d, 56, DES_PC2_TABLE))
        round++
    }
    keys
}

/**
 * The DES round function `f` (FIPS 46-3 §3.3): expands the 32-bit right half to 48 bits (`E`),
 * XORs in the round subkey, splits into eight 6-bit groups each substituted by its S-box, and
 * permutes the recombined 32 bits (`P`).
 *
 * @param r        the 32-bit right half, in the low bits of a `u64`
 * @param subkey   the 48-bit round subkey, in the low bits of a `u64`
 * @return         the 32-bit round output, in the low bits of a `u64`
 */
fn des_f(r: u64, subkey: u64): u64 {
    var expanded = des_permute(r, 32, DES_E_TABLE) ^ subkey
    var combined: u64 = 0
    var group: u64 = 0
    loop {
        if group >= 8 { break }
        var six = (expanded >> ((7 - group) * 6)) & 0x3F
        var row = (((six >> 5) & 1) << 1) | (six & 1)
        var col = (six >> 1) & 0xF
        var s = DES_SBOX[group * 64 + row * 16 + col]
        combined = (combined << 4) | s
        group++
    }
    des_permute(combined, 32, DES_P_TABLE)
}

/**
 * Runs one Feistel round: the new left half is the old right half; the new right half is the old
 * left half XORed with `f(right, subkey)` (FIPS 46-3 §3.3).
 *
 * @param halves  the current left/right halves
 * @param subkey  this round's 48-bit subkey
 * @return        the updated left/right halves after the round
 */
fn des_round(halves: DesFeistelHalves, subkey: u64): DesFeistelHalves {
    DesFeistelHalves { l = halves.r; r = halves.l ^ des_f(halves.r, subkey) }
}

/**
 * The DES single-block core (FIPS 46-3 §3.1): `IP`, then 16 Feistel rounds under `round_keys` in
 * the order given, then the pre-output swap and `FP`. Encryption passes `K1..K16`; decryption
 * passes the same subkeys reversed (`des_reverse_keys`) — the two are the same core.
 *
 * @param round_keys  the 16 subkeys to apply, in the order this call should use them
 * @param block8      the 8-byte input block
 * @return            the 8-byte output block
 */
fn des_crypt_core(round_keys: []u64, block8: []byte): []byte {
    var permuted = des_permute(des_block_to_u64(block8), 64, DES_IP_TABLE)
    var halves = DesFeistelHalves { l = permuted >> 32; r = permuted & 0xFFFFFFFF }
    var round: u64 = 0
    loop {
        if round >= 16 { break }
        halves = des_round(halves, round_keys[round])
        round++
    }
    des_u64_to_block(des_permute((halves.r << 32) | halves.l, 64, DES_FP_TABLE))
}

/**
 * Expands an 8-byte DES key into a reusable `DesKey` (FIPS 46-3 §3.2). Expand once, then reuse
 * across every block with `des_encrypt_block_ks`/`des_decrypt_block_ks`.
 *
 * @param key8  the DES key: exactly 8 bytes (56 effective bits plus 8 parity bits)
 * @return      the expanded round-key schedule, or a `CryptoError` on an invalid key length
 * @throws      `CryptoError` when `key8.len != 8`
 */
exp fn des_key_expand(key8: []byte): DesKey | CryptoError {
    if key8.len != 8 { return crypto_error("des: key must be exactly 8 bytes") }
    DesKey { round_keys = des_key_schedule(key8) }
}

/**
 * Encrypts one 8-byte block under a pre-expanded key (FIPS 46-3 §3.1) — the fast path for a
 * caller applying the same key to many blocks.
 *
 * @param ks      the expanded key (`des_key_expand`)
 * @param block8  the 8-byte plaintext block (the caller guarantees the length)
 * @return        the 8-byte ciphertext block
 */
exp fn des_encrypt_block_ks(ks: DesKey, block8: []byte): []byte {
    des_crypt_core(ks.round_keys, block8)
}

/**
 * Decrypts one 8-byte block under a pre-expanded key: the same Feistel core with the subkey
 * order reversed (FIPS 46-3 §3.1 decryption note).
 *
 * @param ks      the expanded key (`des_key_expand`)
 * @param block8  the 8-byte ciphertext block (the caller guarantees the length)
 * @return        the 8-byte plaintext block
 */
exp fn des_decrypt_block_ks(ks: DesKey, block8: []byte): []byte {
    des_crypt_core(des_reverse_keys(ks.round_keys), block8)
}

/**
 * Encrypts one 8-byte block under `key8`, expanding the key on the spot — the one-shot form. For
 * many blocks under the same key, expand once with `des_key_expand` and call
 * `des_encrypt_block_ks`.
 *
 * @param key8    the DES key (8 bytes)
 * @param block8  the 8-byte plaintext block
 * @return        the 8-byte ciphertext block, or a `CryptoError` on a bad key/block length
 * @throws        `CryptoError` when `key8.len != 8` or `block8.len != 8`
 */
exp fn des_encrypt_block(key8: []byte, block8: []byte): []byte | CryptoError {
    if block8.len != 8 { return crypto_error("des: block must be exactly 8 bytes") }
    var ks = match des_key_expand(key8) { DesKey as k => k; CryptoError as e => return e }
    des_encrypt_block_ks(ks, block8)
}

/**
 * Decrypts one 8-byte block under `key8`, expanding the key on the spot.
 *
 * @param key8    the DES key (8 bytes)
 * @param block8  the 8-byte ciphertext block
 * @return        the 8-byte plaintext block, or a `CryptoError` on a bad key/block length
 * @throws        `CryptoError` when `key8.len != 8` or `block8.len != 8`
 */
exp fn des_decrypt_block(key8: []byte, block8: []byte): []byte | CryptoError {
    if block8.len != 8 { return crypto_error("des: block must be exactly 8 bytes") }
    var ks = match des_key_expand(key8) { DesKey as k => k; CryptoError as e => return e }
    des_decrypt_block_ks(ks, block8)
}

/**
 * Reports whether an 8-byte DES key is one of the four classic weak keys (FIPS 46-3 / SP 800-67):
 * a weak key makes `E_K = D_K`, degenerating double/triple-DES protection. Used by
 * `teko::crypto::tdes` to reject weak TDEA component keys.
 *
 * @param key8  the 8-byte candidate key
 * @return      `true` iff `key8` packs to one of `DES_WEAK_KEYS`
 */
exp fn des_is_weak_key(key8: []byte): bool {
    var packed = des_block_to_u64(key8)
    var i: u64 = 0
    loop {
        if i >= DES_WEAK_KEYS.len { break }
        if packed == DES_WEAK_KEYS[i] { return true }
        i++
    }
    false
}
