/**
 * `teko::crypto::cipher` (C4) — the symmetric block/stream cipher family: AES (FIPS 197) in the
 * confidentiality-only modes CBC / CTR / CFB / OFB (NIST SP 800-38A), plus the ChaCha20 stream
 * cipher (RFC 8439). Per the stdlib catalog §1.5 (`teko::crypto::cipher`: AES-128/192/256
 * {CBC,CTR,CFB,OFB} · ChaCha20 · legacy 3DES) this is pure Teko over `[]byte`, no OS dependency,
 * testable via `.tkt` against the published FIPS/NIST/RFC known-answer vectors.
 *
 * FLAT SURFACE (the convention shipped by `teko::crypto::hash`/`mac`/`kdf`): the functions live
 * directly under `teko::crypto` — `teko::crypto::aes_encrypt_block`, not
 * `teko::crypto::cipher::…` — so `teko::crypto::mac`'s `cmac_aes`/`gmac_aes` reuse the block
 * primitive by injecting `(b) => aes_encrypt_block_ks(ks, b)` into the cipher-agnostic seams
 * (`cmac_with_cipher`/`gmac_with_cipher`).
 *
 * FAMILIES SHIPPED:
 *   - AES (FIPS 197): the 128/192/256-bit key schedule (`aes_key_expand`), single-block
 *     encrypt/decrypt (`aes_encrypt_block`/`aes_decrypt_block`, and the pre-expanded
 *     `*_block_ks` fast paths the modes and the MAC seams reuse).
 *   - AES modes (NIST SP 800-38A): CBC, CTR, CFB (128-bit feedback), OFB — encrypt and decrypt,
 *     all parameterized on a caller-supplied IV / initial counter block.
 *   - ChaCha20 (RFC 8439 §2.3–2.4): the quarter-round permutation, the 64-byte block function,
 *     and the counter-mode stream over a 32-byte key, 12-byte nonce, and 32-bit initial counter.
 *
 * Legacy 3DES (`@deprecated` in §1.5) is NOT shipped here: DES's bit-permutation / S-box machinery
 * is a self-contained primitive that shares nothing with AES or ChaCha20, so it is a distinct
 * follow-up seam rather than a trivial addition to this file.
 *
 * PUBLIC SURFACE IS `exp` (catalog §0 framing); the S-boxes, key-schedule words, GF(2^8) and
 * round transforms are file-local private.
 *
 * NO INDEX-ASSIGNMENT. Every output buffer, round key, and cipher state is built via
 * `teko::list::push` (functional growth) — the same discipline `teko::crypto::hash`/`mac` use.
 *
 * CONSTANT-TIME POSTURE (hand-audited convention, per the catalog §B framing): the GF(2^8)
 * multiply and the mode plumbing avoid data-dependent branches; the AES S-box is a table lookup
 * (the standard software AES trade-off, not a claim of cache-timing resistance) and the mode
 * length checks branch only on public lengths, never on key/plaintext content.
 */

/**
 * AES_SBOX — the AES substitution box (FIPS 197 §5.1.1): `S-box[b]` is the multiplicative inverse
 * of `b` in GF(2^8) followed by the fixed affine transform. A module const lowered to global data,
 * indexed directly by `SubBytes`/`SubWord`; never rebuilt per call.
 */
const AES_SBOX: []u32 = [
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5,
    0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0,
    0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc,
    0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a,
    0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0,
    0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b,
    0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85,
    0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5,
    0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17,
    0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88,
    0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c,
    0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9,
    0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6,
    0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e,
    0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94,
    0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68,
    0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16
]

/**
 * AES_INV_SBOX — the AES inverse substitution box (FIPS 197 §5.3.2): `AES_INV_SBOX[AES_SBOX[b]] =
 * b`, applied by `InvSubBytes` in the equivalent inverse cipher. A module const lowered to global
 * data, indexed directly during decryption.
 */
const AES_INV_SBOX: []u32 = [
    0x52, 0x09, 0x6a, 0xd5, 0x30, 0x36, 0xa5, 0x38,
    0xbf, 0x40, 0xa3, 0x9e, 0x81, 0xf3, 0xd7, 0xfb,
    0x7c, 0xe3, 0x39, 0x82, 0x9b, 0x2f, 0xff, 0x87,
    0x34, 0x8e, 0x43, 0x44, 0xc4, 0xde, 0xe9, 0xcb,
    0x54, 0x7b, 0x94, 0x32, 0xa6, 0xc2, 0x23, 0x3d,
    0xee, 0x4c, 0x95, 0x0b, 0x42, 0xfa, 0xc3, 0x4e,
    0x08, 0x2e, 0xa1, 0x66, 0x28, 0xd9, 0x24, 0xb2,
    0x76, 0x5b, 0xa2, 0x49, 0x6d, 0x8b, 0xd1, 0x25,
    0x72, 0xf8, 0xf6, 0x64, 0x86, 0x68, 0x98, 0x16,
    0xd4, 0xa4, 0x5c, 0xcc, 0x5d, 0x65, 0xb6, 0x92,
    0x6c, 0x70, 0x48, 0x50, 0xfd, 0xed, 0xb9, 0xda,
    0x5e, 0x15, 0x46, 0x57, 0xa7, 0x8d, 0x9d, 0x84,
    0x90, 0xd8, 0xab, 0x00, 0x8c, 0xbc, 0xd3, 0x0a,
    0xf7, 0xe4, 0x58, 0x05, 0xb8, 0xb3, 0x45, 0x06,
    0xd0, 0x2c, 0x1e, 0x8f, 0xca, 0x3f, 0x0f, 0x02,
    0xc1, 0xaf, 0xbd, 0x03, 0x01, 0x13, 0x8a, 0x6b,
    0x3a, 0x91, 0x11, 0x41, 0x4f, 0x67, 0xdc, 0xea,
    0x97, 0xf2, 0xcf, 0xce, 0xf0, 0xb4, 0xe6, 0x73,
    0x96, 0xac, 0x74, 0x22, 0xe7, 0xad, 0x35, 0x85,
    0xe2, 0xf9, 0x37, 0xe8, 0x1c, 0x75, 0xdf, 0x6e,
    0x47, 0xf1, 0x1a, 0x71, 0x1d, 0x29, 0xc5, 0x89,
    0x6f, 0xb7, 0x62, 0x0e, 0xaa, 0x18, 0xbe, 0x1b,
    0xfc, 0x56, 0x3e, 0x4b, 0xc6, 0xd2, 0x79, 0x20,
    0x9a, 0xdb, 0xc0, 0xfe, 0x78, 0xcd, 0x5a, 0xf4,
    0x1f, 0xdd, 0xa8, 0x33, 0x88, 0x07, 0xc7, 0x31,
    0xb1, 0x12, 0x10, 0x59, 0x27, 0x80, 0xec, 0x5f,
    0x60, 0x51, 0x7f, 0xa9, 0x19, 0xb5, 0x4a, 0x0d,
    0x2d, 0xe5, 0x7a, 0x9f, 0x93, 0xc9, 0x9c, 0xef,
    0xa0, 0xe0, 0x3b, 0x4d, 0xae, 0x2a, 0xf5, 0xb0,
    0xc8, 0xeb, 0xbb, 0x3c, 0x83, 0x53, 0x99, 0x61,
    0x17, 0x2b, 0x04, 0x7e, 0xba, 0x77, 0xd6, 0x26,
    0xe1, 0x69, 0x14, 0x63, 0x55, 0x21, 0x0c, 0x7d
]

/**
 * AES_RCON — the AES key-schedule round constants (FIPS 197 §5.2): `AES_RCON[j]` is `rc[j]`, the
 * GF(2^8) element `x^(j-1)`, XORed (shifted into the top byte) into the first word of each new key
 * group. Index 0 is unused; indices 1..10 cover every key size (AES-128 uses the most, up to 10).
 */
const AES_RCON: []u32 = [
    0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36
]

/**
 * An expanded AES key: the full round-key schedule flattened to bytes plus the round count, so a
 * caller expands a key once (`aes_key_expand`) and reuses it across every block of a mode.
 */
exp type AesKey = struct {
    /** the round keys `w0..w{4(Nr+1)-1}` serialized big-endian to `16 · (Nr+1)` bytes */
    round_keys: []byte
    /** the number of AES rounds `Nr` (10 for AES-128, 12 for AES-192, 14 for AES-256) */
    rounds: u64
}

/**
 * The sub-slice `data[from..to)` as a fresh `[]byte` — the block/segment splitter this file uses
 * (each crypto file carries its own file-local slicer per the namespace convention).
 *
 * @param data  the source slice
 * @param from  the inclusive start index
 * @param to    the exclusive end index
 * @return      a fresh slice holding `data[from..to)`
 */
fn cipher_slice(data: []byte, from: u64, to: u64): []byte {
    var out: []byte = teko::list::empty()
    var i = from
    loop {
        if i >= to { break }
        out = teko::list::push(out, data[i])
        i++
    }
    out
}

/**
 * Appends every byte of `src` to `dst` — how the block modes concatenate their per-block outputs.
 *
 * @param dst  the buffer to extend
 * @param src  the bytes to append
 * @return     `dst` followed by `src`
 */
fn cipher_append(dst: []byte, src: []byte): []byte {
    var out = dst
    var i: u64 = 0
    loop {
        if i >= src.len { break }
        out = teko::list::push(out, src[i])
        i++
    }
    out
}

/**
 * Multiplies two GF(2^8) elements under the AES reduction polynomial `x^8 + x^4 + x^3 + x + 1`
 * (`0x11b`) — the `MixColumns`/`InvMixColumns` and key-schedule primitive. Branch-free (the
 * per-bit accumulate and the modular reduction are mask-selected, never an `if` on the operand
 * bits), so its running time is independent of the byte values.
 *
 * @param a  the first field element (only the low 8 bits are used)
 * @param b  the second field element (only the low 8 bits are used)
 * @return   the product `a · b` in GF(2^8), in 0..255
 */
fn gf_mul8(a: u32, b: u32): u32 {
    var p: u32 = 0
    var x = a & 0xFF
    var y = b & 0xFF
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        var bit = y & 1
        p = p ^ (x * bit)
        var carry = (x >> 7) & 1
        x = ((x << 1) & 0xFF) ^ (0x1b * carry)
        y = y >> 1
        i++
    }
    p & 0xFF
}

/**
 * Reads a big-endian 32-bit word out of `b` at byte offset `off` — the word order FIPS 197 packs
 * key/state columns in.
 *
 * @param b    the byte slice being read
 * @param off  the starting byte offset (`off+3` must be in bounds)
 * @return     the big-endian 32-bit value at `b[off..off+4)`
 */
fn aes_be_word(b: []byte, off: u64): u32 {
    ((b[off] to u32) << 24) | ((b[off + 1] to u32) << 16) | ((b[off + 2] to u32) << 8) | (b[off + 3] to u32)
}

/**
 * Appends a 32-bit word to `buf` in big-endian byte order — the inverse of `aes_be_word`, used to
 * flatten the key schedule to bytes.
 *
 * @param buf  the output buffer to extend
 * @param x    the word to emit, most-significant byte first
 * @return     `buf` with `x`'s four big-endian bytes appended
 */
fn aes_push_be_word(buf: []byte, x: u32): []byte {
    var b = buf
    b = teko::list::push(b, ((x >> 24) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 16) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 8) & 0xFF) to byte)
    b = teko::list::push(b, (x & 0xFF) to byte)
    b
}

/**
 * Applies the AES S-box to each of the four bytes of a word (FIPS 197 `SubWord`).
 *
 * @param w  the word to substitute
 * @return   the word with `AES_SBOX` applied to every byte
 */
fn aes_sub_word(w: u32): u32 {
    var b0 = AES_SBOX[((w >> 24) & 0xFF) to u64]
    var b1 = AES_SBOX[((w >> 16) & 0xFF) to u64]
    var b2 = AES_SBOX[((w >> 8) & 0xFF) to u64]
    var b3 = AES_SBOX[(w & 0xFF) to u64]
    (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

/**
 * Rotates a word left by one byte (FIPS 197 `RotWord`): `[a0,a1,a2,a3]` becomes `[a1,a2,a3,a0]`.
 *
 * @param w  the word to rotate
 * @return   `w` cyclically rotated left by 8 bits
 */
fn aes_rot_word(w: u32): u32 {
    ((w << 8) | (w >> 24)) & 0xFFFFFFFF
}

/**
 * Expands an AES cipher key into the schedule of `4 · (Nr+1)` 32-bit words (FIPS 197 §5.2).
 *
 * @param key  the cipher key (`4 · Nk` bytes; the caller guarantees a valid length)
 * @param nk   the key length in words (4, 6, or 8)
 * @param nr   the round count `Nr`
 * @return     the expanded key schedule as `4 · (Nr+1)` words
 */
fn aes_expand_words(key: []byte, nk: u64, nr: u64): []u32 {
    var w: []u32 = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= nk { break }
        w = teko::list::push(w, aes_be_word(key, i * 4))
        i++
    }
    var total = 4 * (nr + 1)
    loop {
        if i >= total { break }
        var temp = w[i - 1]
        var m = i % nk
        if m == 0 {
            temp = aes_sub_word(aes_rot_word(temp)) ^ (AES_RCON[i / nk] << 24)
        } else if nk > 6 && m == 4 {
            temp = aes_sub_word(temp)
        }
        w = teko::list::push(w, w[i - nk] ^ temp)
        i++
    }
    w
}

/**
 * Expands an AES key (16, 24, or 32 bytes) into a reusable `AesKey` (FIPS 197 §5.2). Expand once,
 * then feed the result to `aes_encrypt_block_ks`/`aes_decrypt_block_ks` (or the mode functions) for
 * every block under that key.
 *
 * @param key  the cipher key: exactly 16 (AES-128), 24 (AES-192), or 32 (AES-256) bytes
 * @return     the expanded key schedule, or a `CryptoError` on an invalid key length
 * @throws     `CryptoError` when `key.len` is not 16, 24, or 32
 */
exp fn aes_key_expand(key: []byte): AesKey | CryptoError {
    if key.len != 16 && key.len != 24 && key.len != 32 {
        return crypto_error("aes: key must be 16, 24, or 32 bytes")
    }
    var nk = key.len / 4
    var nr = nk + 6
    var words = aes_expand_words(key, nk, nr)
    var rk: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= words.len { break }
        rk = aes_push_be_word(rk, words[i])
        i++
    }
    AesKey { round_keys = rk; rounds = nr }
}

/**
 * Applies the AES S-box (or its inverse) to all 16 state bytes — `SubBytes` / `InvSubBytes`.
 *
 * @param s    the 16-byte state
 * @param box  the substitution table (`AES_SBOX` for encrypt, `AES_INV_SBOX` for decrypt)
 * @return     the fresh 16-byte substituted state
 */
fn aes_sub_bytes(s: []byte, box: []u32): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        out = teko::list::push(out, box[s[i] to u64] to byte)
        i++
    }
    out
}

/**
 * Cyclically shifts the rows of the AES state (FIPS 197 `ShiftRows`): row `r` moves left by `r`
 * bytes, over the column-major layout `state[r + 4c]`.
 *
 * @param s  the 16-byte state
 * @return   the fresh 16-byte state after `ShiftRows`
 */
fn aes_shift_rows(s: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        var r = i % 4
        var c = i / 4
        var src = r + 4 * ((c + r) % 4)
        out = teko::list::push(out, s[src])
        i++
    }
    out
}

/**
 * Inverse of `aes_shift_rows` (FIPS 197 `InvShiftRows`): row `r` moves right by `r` bytes.
 *
 * @param s  the 16-byte state
 * @return   the fresh 16-byte state after `InvShiftRows`
 */
fn aes_inv_shift_rows(s: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        var r = i % 4
        var c = i / 4
        var src = r + 4 * ((c + 4 - r) % 4)
        out = teko::list::push(out, s[src])
        i++
    }
    out
}

/**
 * Mixes one AES column (FIPS 197 `MixColumns`), the fixed GF(2^8) matrix `[2 3 1 1; 1 2 3 1;
 * 1 1 2 3; 3 1 1 2]` applied to the four bytes `s0..s3`, appending the four result bytes to `out`.
 *
 * @param out  the output state being built
 * @param s0   the column's first byte
 * @param s1   the column's second byte
 * @param s2   the column's third byte
 * @param s3   the column's fourth byte
 * @return     `out` with the four mixed bytes appended
 */
fn aes_mix_one_column(out: []byte, s0: u32, s1: u32, s2: u32, s3: u32): []byte {
    var o0 = gf_mul8(s0, 2) ^ gf_mul8(s1, 3) ^ s2 ^ s3
    var o1 = s0 ^ gf_mul8(s1, 2) ^ gf_mul8(s2, 3) ^ s3
    var o2 = s0 ^ s1 ^ gf_mul8(s2, 2) ^ gf_mul8(s3, 3)
    var o3 = gf_mul8(s0, 3) ^ s1 ^ s2 ^ gf_mul8(s3, 2)
    var b = out
    b = teko::list::push(b, (o0 & 0xFF) to byte)
    b = teko::list::push(b, (o1 & 0xFF) to byte)
    b = teko::list::push(b, (o2 & 0xFF) to byte)
    b = teko::list::push(b, (o3 & 0xFF) to byte)
    b
}

/**
 * Mixes one AES column under the inverse matrix (FIPS 197 `InvMixColumns`) `[14 11 13 9; 9 14 11
 * 13; 13 9 14 11; 11 13 9 14]`, appending the four result bytes to `out`.
 *
 * @param out  the output state being built
 * @param s0   the column's first byte
 * @param s1   the column's second byte
 * @param s2   the column's third byte
 * @param s3   the column's fourth byte
 * @return     `out` with the four inverse-mixed bytes appended
 */
fn aes_inv_mix_one_column(out: []byte, s0: u32, s1: u32, s2: u32, s3: u32): []byte {
    var o0 = gf_mul8(s0, 14) ^ gf_mul8(s1, 11) ^ gf_mul8(s2, 13) ^ gf_mul8(s3, 9)
    var o1 = gf_mul8(s0, 9) ^ gf_mul8(s1, 14) ^ gf_mul8(s2, 11) ^ gf_mul8(s3, 13)
    var o2 = gf_mul8(s0, 13) ^ gf_mul8(s1, 9) ^ gf_mul8(s2, 14) ^ gf_mul8(s3, 11)
    var o3 = gf_mul8(s0, 11) ^ gf_mul8(s1, 13) ^ gf_mul8(s2, 9) ^ gf_mul8(s3, 14)
    var b = out
    b = teko::list::push(b, (o0 & 0xFF) to byte)
    b = teko::list::push(b, (o1 & 0xFF) to byte)
    b = teko::list::push(b, (o2 & 0xFF) to byte)
    b = teko::list::push(b, (o3 & 0xFF) to byte)
    b
}

/**
 * Applies `MixColumns` to all four AES columns.
 *
 * @param s  the 16-byte state
 * @return   the fresh 16-byte mixed state
 */
fn aes_mix_columns(s: []byte): []byte {
    var out: []byte = teko::list::empty()
    var c: u64 = 0
    loop {
        if c >= 4 { break }
        out = aes_mix_one_column(out, s[4 * c] to u32, s[4 * c + 1] to u32, s[4 * c + 2] to u32, s[4 * c + 3] to u32)
        c++
    }
    out
}

/**
 * Applies `InvMixColumns` to all four AES columns.
 *
 * @param s  the 16-byte state
 * @return   the fresh 16-byte inverse-mixed state
 */
fn aes_inv_mix_columns(s: []byte): []byte {
    var out: []byte = teko::list::empty()
    var c: u64 = 0
    loop {
        if c >= 4 { break }
        out = aes_inv_mix_one_column(out, s[4 * c] to u32, s[4 * c + 1] to u32, s[4 * c + 2] to u32, s[4 * c + 3] to u32)
        c++
    }
    out
}

/**
 * XORs the round key of round `round` into the state (FIPS 197 `AddRoundKey`).
 *
 * @param s      the 16-byte state
 * @param rk     the flattened round-key schedule
 * @param round  the round index whose 16 key bytes start at `16 · round`
 * @return       the fresh 16-byte state after the key XOR
 */
fn aes_add_round_key(s: []byte, rk: []byte, round: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        out = teko::list::push(out, ((s[i] to u32) ^ (rk[16 * round + i] to u32)) to byte)
        i++
    }
    out
}

/**
 * Encrypts one 16-byte block under a pre-expanded key (FIPS 197 §5.1) — the fast path the modes
 * and the CMAC/GMAC seams reuse so the key schedule is computed once, not per block.
 *
 * @param ks     the expanded key (`aes_key_expand`)
 * @param block  the 16-byte plaintext block (the caller guarantees the length)
 * @return       the 16-byte ciphertext block
 */
exp fn aes_encrypt_block_ks(ks: AesKey, block: []byte): []byte {
    var state = aes_add_round_key(block, ks.round_keys, 0)
    var round: u64 = 1
    loop {
        if round >= ks.rounds { break }
        state = aes_add_round_key(aes_mix_columns(aes_shift_rows(aes_sub_bytes(state, AES_SBOX))), ks.round_keys, round)
        round++
    }
    aes_add_round_key(aes_shift_rows(aes_sub_bytes(state, AES_SBOX)), ks.round_keys, ks.rounds)
}

/**
 * Decrypts one 16-byte block under a pre-expanded key using the equivalent inverse cipher
 * (FIPS 197 §5.3).
 *
 * @param ks     the expanded key (`aes_key_expand`)
 * @param block  the 16-byte ciphertext block (the caller guarantees the length)
 * @return       the 16-byte plaintext block
 */
exp fn aes_decrypt_block_ks(ks: AesKey, block: []byte): []byte {
    var state = aes_add_round_key(block, ks.round_keys, ks.rounds)
    var round = ks.rounds - 1
    loop {
        if round == 0 { break }
        state = aes_inv_mix_columns(aes_add_round_key(aes_inv_sub_bytes_state(state), ks.round_keys, round))
        round = round - 1
    }
    aes_add_round_key(aes_inv_sub_bytes_state(state), ks.round_keys, 0)
}

/**
 * The decryption round prologue `InvSubBytes(InvShiftRows(state))` — the shared head of every
 * inverse-cipher round, extracted so the round loop and the final round read the same.
 *
 * @param s  the 16-byte state
 * @return   the fresh 16-byte state after `InvShiftRows` then `InvSubBytes`
 */
fn aes_inv_sub_bytes_state(s: []byte): []byte {
    aes_sub_bytes(aes_inv_shift_rows(s), AES_INV_SBOX)
}

/**
 * Encrypts one 16-byte block under `key` (FIPS 197), expanding the key on the spot — the one-shot
 * form for a caller that encrypts a single block. For many blocks, expand once with
 * `aes_key_expand` and call `aes_encrypt_block_ks`.
 *
 * @param key    the cipher key (16, 24, or 32 bytes)
 * @param block  the 16-byte plaintext block
 * @return       the 16-byte ciphertext block, or a `CryptoError` on a bad key/block length
 * @throws       `CryptoError` when `key.len` is not 16/24/32 or `block.len != 16`
 */
exp fn aes_encrypt_block(key: []byte, block: []byte): []byte | CryptoError {
    if block.len != 16 { return crypto_error("aes: block must be exactly 16 bytes") }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    aes_encrypt_block_ks(ks, block)
}

/**
 * Decrypts one 16-byte block under `key` (FIPS 197), expanding the key on the spot.
 *
 * @param key    the cipher key (16, 24, or 32 bytes)
 * @param block  the 16-byte ciphertext block
 * @return       the 16-byte plaintext block, or a `CryptoError` on a bad key/block length
 * @throws       `CryptoError` when `key.len` is not 16/24/32 or `block.len != 16`
 */
exp fn aes_decrypt_block(key: []byte, block: []byte): []byte | CryptoError {
    if block.len != 16 { return crypto_error("aes: block must be exactly 16 bytes") }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    aes_decrypt_block_ks(ks, block)
}

/**
 * XORs two equal-length 16-byte blocks — the CBC chaining primitive.
 *
 * @param a  the first 16-byte block
 * @param b  the second 16-byte block
 * @return   the fresh 16-byte block `a ⊕ b`
 */
fn cipher_xor16(a: []byte, b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        out = teko::list::push(out, ((a[i] to u32) ^ (b[i] to u32)) to byte)
        i++
    }
    out
}

/**
 * Appends `data[off..off+n) ⊕ ks[0..n)` to `out` — the keystream-XOR step shared by CTR, CFB, and
 * OFB (and the segment builder for CFB feedback).
 *
 * @param out   the output buffer being built
 * @param data  the input (plaintext for encrypt, ciphertext for decrypt)
 * @param off   the offset of this segment in `data`
 * @param ks    the keystream/feedback block, at least `n` bytes
 * @param n     the segment length in bytes (1..16)
 * @return      `out` with the `n` XORed bytes appended
 */
fn cipher_stream_xor(out: []byte, data: []byte, off: u64, ks: []byte, n: u64): []byte {
    var o = out
    var j: u64 = 0
    loop {
        if j >= n { break }
        o = teko::list::push(o, ((data[off + j] to u32) ^ (ks[j] to u32)) to byte)
        j++
    }
    o
}

/**
 * Increments a 16-byte counter block as a big-endian 128-bit integer, mod 2^128 (NIST SP 800-38A
 * §B.1, the standard full-block CTR increment).
 *
 * @param block  the 16-byte counter block
 * @return       the fresh 16-byte block `block + 1 (mod 2^128)`
 */
fn ctr_increment(block: []byte): []byte {
    var rev: []byte = teko::list::empty()
    var carry: u32 = 1
    var i: u64 = 16
    loop {
        if i == 0 { break }
        i--
        var v = (block[i] to u32) + carry
        rev = teko::list::push(rev, (v & 0xFF) to byte)
        carry = v >> 8
    }
    var out: []byte = teko::list::empty()
    var j: u64 = 16
    loop {
        if j == 0 { break }
        j--
        out = teko::list::push(out, rev[j])
    }
    out
}

/**
 * Validates a 16-byte IV / initial counter block, returning it unchanged or a `CryptoError`.
 *
 * @param iv  the candidate IV
 * @return    `iv` when it is 16 bytes, else a `CryptoError`
 * @throws    `CryptoError` when `iv.len != 16`
 */
fn require_iv16(iv: []byte): []byte | CryptoError {
    if iv.len != 16 { return crypto_error("aes: IV must be exactly 16 bytes") }
    iv
}

/**
 * AES-CBC encryption (NIST SP 800-38A §6.2): `C_i = CIPH_K(P_i ⊕ C_{i-1})`, `C_0 = IV`. No
 * padding — the plaintext length must be a whole number of 16-byte blocks (a caller needing
 * partial data pads first, e.g. PKCS#7).
 *
 * @param key  the cipher key (16, 24, or 32 bytes)
 * @param iv   the 16-byte initialization vector
 * @param pt   the plaintext, a multiple of 16 bytes
 * @return     the ciphertext (same length as `pt`), or a `CryptoError` on a bad length
 * @throws     `CryptoError` when the key/IV length is invalid or `pt.len` is not a multiple of 16
 */
exp fn aes_cbc_encrypt(key: []byte, iv: []byte, pt: []byte): []byte | CryptoError {
    var iv16 = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    if pt.len % 16 != 0 { return crypto_error("aes_cbc: plaintext length must be a multiple of 16") }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var prev = iv16
    var off: u64 = 0
    loop {
        if off >= pt.len { break }
        var c = aes_encrypt_block_ks(ks, cipher_xor16(cipher_slice(pt, off, off + 16), prev))
        out = cipher_append(out, c)
        prev = c
        off = off + 16
    }
    out
}

/**
 * AES-CBC decryption (NIST SP 800-38A §6.2): `P_i = CIPH_K^{-1}(C_i) ⊕ C_{i-1}`, `C_0 = IV`.
 *
 * @param key  the cipher key (16, 24, or 32 bytes)
 * @param iv   the 16-byte initialization vector
 * @param ct   the ciphertext, a multiple of 16 bytes
 * @return     the plaintext (same length as `ct`), or a `CryptoError` on a bad length
 * @throws     `CryptoError` when the key/IV length is invalid or `ct.len` is not a multiple of 16
 */
exp fn aes_cbc_decrypt(key: []byte, iv: []byte, ct: []byte): []byte | CryptoError {
    var iv16 = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    if ct.len % 16 != 0 { return crypto_error("aes_cbc: ciphertext length must be a multiple of 16") }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var prev = iv16
    var off: u64 = 0
    loop {
        if off >= ct.len { break }
        var cblock = cipher_slice(ct, off, off + 16)
        out = cipher_append(out, cipher_xor16(aes_decrypt_block_ks(ks, cblock), prev))
        prev = cblock
        off = off + 16
    }
    out
}

/**
 * AES-CTR (NIST SP 800-38A §6.5): XORs the data with the keystream `CIPH_K(T_i)`, where the
 * counter block starts at `iv` and is incremented as a big-endian 128-bit integer per block.
 * Encryption and decryption are the same operation, so this one function serves both. The data may
 * be any length (the final partial block is truncated to fit).
 *
 * @param key   the cipher key (16, 24, or 32 bytes)
 * @param iv    the 16-byte initial counter block
 * @param data  the input, any length
 * @return      the transformed output (same length as `data`), or a `CryptoError` on a bad length
 * @throws      `CryptoError` when the key or IV length is invalid
 */
exp fn aes_ctr(key: []byte, iv: []byte, data: []byte): []byte | CryptoError {
    var counter = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var off: u64 = 0
    loop {
        if off >= data.len { break }
        var block = aes_encrypt_block_ks(ks, counter)
        var n = if data.len - off < 16 { data.len - off } else { 16 }
        out = cipher_stream_xor(out, data, off, block, n)
        counter = ctr_increment(counter)
        off = off + 16
    }
    out
}

/**
 * AES-OFB (NIST SP 800-38A §6.4): the keystream is the repeated re-encryption of the IV
 * (`O_i = CIPH_K(O_{i-1})`, `O_0 = IV`), XORed into the data. Encryption and decryption are the
 * same operation. The data may be any length.
 *
 * @param key   the cipher key (16, 24, or 32 bytes)
 * @param iv    the 16-byte initialization vector
 * @param data  the input, any length
 * @return      the transformed output (same length as `data`), or a `CryptoError` on a bad length
 * @throws      `CryptoError` when the key or IV length is invalid
 */
exp fn aes_ofb(key: []byte, iv: []byte, data: []byte): []byte | CryptoError {
    var feedback = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var off: u64 = 0
    loop {
        if off >= data.len { break }
        feedback = aes_encrypt_block_ks(ks, feedback)
        var n = if data.len - off < 16 { data.len - off } else { 16 }
        out = cipher_stream_xor(out, data, off, feedback, n)
        off = off + 16
    }
    out
}

/**
 * AES-CFB encryption with full 128-bit feedback (NIST SP 800-38A §6.3, the CFB-128 variant):
 * `C_i = P_i ⊕ CIPH_K(C_{i-1})`, `C_0 = IV`. The data may be any length (the final partial block
 * is XORed with the leading bytes of the keystream).
 *
 * @param key  the cipher key (16, 24, or 32 bytes)
 * @param iv   the 16-byte initialization vector
 * @param pt   the plaintext, any length
 * @return     the ciphertext (same length as `pt`), or a `CryptoError` on a bad length
 * @throws     `CryptoError` when the key or IV length is invalid
 */
exp fn aes_cfb_encrypt(key: []byte, iv: []byte, pt: []byte): []byte | CryptoError {
    var feedback = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var off: u64 = 0
    loop {
        if off >= pt.len { break }
        var ksblock = aes_encrypt_block_ks(ks, feedback)
        var n = if pt.len - off < 16 { pt.len - off } else { 16 }
        var cblock = cipher_stream_xor(teko::list::empty(), pt, off, ksblock, n)
        out = cipher_append(out, cblock)
        feedback = cblock
        off = off + 16
    }
    out
}

/**
 * AES-CFB decryption with full 128-bit feedback (NIST SP 800-38A §6.3): `P_i = C_i ⊕
 * CIPH_K(C_{i-1})`, `C_0 = IV` — the feedback is the ciphertext, so decryption still uses the
 * forward block cipher.
 *
 * @param key  the cipher key (16, 24, or 32 bytes)
 * @param iv   the 16-byte initialization vector
 * @param ct   the ciphertext, any length
 * @return     the plaintext (same length as `ct`), or a `CryptoError` on a bad length
 * @throws     `CryptoError` when the key or IV length is invalid
 */
exp fn aes_cfb_decrypt(key: []byte, iv: []byte, ct: []byte): []byte | CryptoError {
    var feedback = match require_iv16(iv) { []byte as v => v; CryptoError as e => return e }
    var ks = match aes_key_expand(key) { AesKey as k => k; CryptoError as e => return e }
    var out: []byte = teko::list::empty()
    var off: u64 = 0
    loop {
        if off >= ct.len { break }
        var ksblock = aes_encrypt_block_ks(ks, feedback)
        var n = if ct.len - off < 16 { ct.len - off } else { 16 }
        out = cipher_stream_xor(out, ct, off, ksblock, n)
        feedback = cipher_slice(ct, off, off + n)
        off = off + 16
    }
    out
}

/**
 * A ChaCha20 working quartet — the four 32-bit words a quarter round transforms, returned as a
 * value because the round updates all four at once.
 */
type ChaChaQuad = struct {
    /** the first word of the quartet */
    a: u32
    /** the second word of the quartet */
    b: u32
    /** the third word of the quartet */
    c: u32
    /** the fourth word of the quartet */
    d: u32
}

/**
 * Rotates a 32-bit word left by `n` bits (0..31) — the ChaCha20 diffusion primitive.
 *
 * @param x  the word to rotate
 * @param n  the rotation amount in bits, 1..31
 * @return   `x` rotated left by `n` bits
 */
fn rotl32(x: u32, n: u32): u32 {
    ((x << n) | (x >> (32 - n))) & 0xFFFFFFFF
}

/**
 * The ChaCha20 quarter round (RFC 8439 §2.1): the sequence of four add-XOR-rotate steps applied to
 * a quartet of state words. Every add is 32-bit-wrapping (`wrapping_add_u32`).
 *
 * @param a  the first input word
 * @param b  the second input word
 * @param c  the third input word
 * @param d  the fourth input word
 * @return   the transformed quartet
 */
fn chacha_quarter_round(a: u32, b: u32, c: u32, d: u32): ChaChaQuad {
    var na = teko::math::wrapping_add_u32(a, b)
    var nd = rotl32(d ^ na, 16)
    var nc = teko::math::wrapping_add_u32(c, nd)
    var nb = rotl32(b ^ nc, 12)
    na = teko::math::wrapping_add_u32(na, nb)
    nd = rotl32(nd ^ na, 8)
    nc = teko::math::wrapping_add_u32(nc, nd)
    nb = rotl32(nb ^ nc, 7)
    ChaChaQuad { a = na; b = nb; c = nc; d = nd }
}

/**
 * Reads a little-endian 32-bit word out of `b` at byte offset `off` — the wire order ChaCha20
 * reads its key, nonce, and counter in.
 *
 * @param b    the byte slice being read
 * @param off  the starting byte offset (`off+3` must be in bounds)
 * @return     the little-endian 32-bit value at `b[off..off+4)`
 */
fn cipher_le_word(b: []byte, off: u64): u32 {
    (b[off] to u32) | ((b[off + 1] to u32) << 8) | ((b[off + 2] to u32) << 16) | ((b[off + 3] to u32) << 24)
}

/**
 * Appends a 32-bit word to `buf` in little-endian byte order — how a ChaCha20 keystream word is
 * serialized.
 *
 * @param buf  the output buffer to extend
 * @param x    the word to emit, least-significant byte first
 * @return     `buf` with `x`'s four little-endian bytes appended
 */
fn cipher_push_le_word(buf: []byte, x: u32): []byte {
    var b = buf
    b = teko::list::push(b, (x & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 8) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 16) & 0xFF) to byte)
    b = teko::list::push(b, ((x >> 24) & 0xFF) to byte)
    b
}

/**
 * Builds the initial ChaCha20 state (RFC 8439 §2.3): the four `"expa nd 3 2-by te k"` constants,
 * the eight key words, the block counter, and the three nonce words, in that order.
 *
 * @param key      the 32-byte key
 * @param nonce    the 12-byte nonce
 * @param counter  the 32-bit block counter
 * @return         the 16-word initial state
 */
fn chacha20_init_state(key: []byte, nonce: []byte, counter: u32): []u32 {
    var s: []u32 = teko::list::empty()
    s = teko::list::push(s, 0x61707865)
    s = teko::list::push(s, 0x3320646e)
    s = teko::list::push(s, 0x79622d32)
    s = teko::list::push(s, 0x6b206574)
    var i: u64 = 0
    loop {
        if i >= 8 { break }
        s = teko::list::push(s, cipher_le_word(key, i * 4))
        i++
    }
    s = teko::list::push(s, counter)
    var j: u64 = 0
    loop {
        if j >= 3 { break }
        s = teko::list::push(s, cipher_le_word(nonce, j * 4))
        j++
    }
    s
}

/**
 * Runs the ten column/diagonal double rounds over the working state (RFC 8439 §2.3.1), returning
 * the 16 permuted words. The state is threaded through the two matching structs the two round
 * shapes produce, so no word is index-assigned.
 *
 * @param s  the 16-word initial state (read for the diagonal/column word selection)
 * @return   the 16-word working state after 20 rounds (before the feed-forward add)
 */
fn chacha20_rounds(s: []u32): []u32 {
    var x0 = s[0]
    var x1 = s[1]
    var x2 = s[2]
    var x3 = s[3]
    var x4 = s[4]
    var x5 = s[5]
    var x6 = s[6]
    var x7 = s[7]
    var x8 = s[8]
    var x9 = s[9]
    var x10 = s[10]
    var x11 = s[11]
    var x12 = s[12]
    var x13 = s[13]
    var x14 = s[14]
    var x15 = s[15]
    var round: u64 = 0
    loop {
        if round >= 10 { break }
        var q0 = chacha_quarter_round(x0, x4, x8, x12)
        x0 = q0.a
        x4 = q0.b
        x8 = q0.c
        x12 = q0.d
        var q1 = chacha_quarter_round(x1, x5, x9, x13)
        x1 = q1.a
        x5 = q1.b
        x9 = q1.c
        x13 = q1.d
        var q2 = chacha_quarter_round(x2, x6, x10, x14)
        x2 = q2.a
        x6 = q2.b
        x10 = q2.c
        x14 = q2.d
        var q3 = chacha_quarter_round(x3, x7, x11, x15)
        x3 = q3.a
        x7 = q3.b
        x11 = q3.c
        x15 = q3.d
        var q4 = chacha_quarter_round(x0, x5, x10, x15)
        x0 = q4.a
        x5 = q4.b
        x10 = q4.c
        x15 = q4.d
        var q5 = chacha_quarter_round(x1, x6, x11, x12)
        x1 = q5.a
        x6 = q5.b
        x11 = q5.c
        x12 = q5.d
        var q6 = chacha_quarter_round(x2, x7, x8, x13)
        x2 = q6.a
        x7 = q6.b
        x8 = q6.c
        x13 = q6.d
        var q7 = chacha_quarter_round(x3, x4, x9, x14)
        x3 = q7.a
        x4 = q7.b
        x9 = q7.c
        x14 = q7.d
        round++
    }
    var out: []u32 = teko::list::empty()
    out = teko::list::push(out, x0)
    out = teko::list::push(out, x1)
    out = teko::list::push(out, x2)
    out = teko::list::push(out, x3)
    out = teko::list::push(out, x4)
    out = teko::list::push(out, x5)
    out = teko::list::push(out, x6)
    out = teko::list::push(out, x7)
    out = teko::list::push(out, x8)
    out = teko::list::push(out, x9)
    out = teko::list::push(out, x10)
    out = teko::list::push(out, x11)
    out = teko::list::push(out, x12)
    out = teko::list::push(out, x13)
    out = teko::list::push(out, x14)
    out = teko::list::push(out, x15)
    out
}

/**
 * The ChaCha20 block function (RFC 8439 §2.3): 20 rounds over the state derived from
 * `key`/`nonce`/`counter`, fed forward by adding the initial state, serialized little-endian into
 * a 64-byte keystream block.
 *
 * @param key      the 32-byte key
 * @param nonce    the 12-byte nonce
 * @param counter  the 32-bit block counter for this block
 * @return         the 64-byte keystream block
 */
fn chacha20_block(key: []byte, nonce: []byte, counter: u32): []byte {
    var s = chacha20_init_state(key, nonce, counter)
    var w = chacha20_rounds(s)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= 16 { break }
        out = cipher_push_le_word(out, teko::math::wrapping_add_u32(w[i], s[i]))
        i++
    }
    out
}

/**
 * ChaCha20 stream cipher (RFC 8439 §2.4): XORs `data` with the keystream generated from the
 * 32-byte `key`, 12-byte `nonce`, and 32-bit initial block `counter` (RFC 8439 uses counter 1 for
 * the first message block). Encryption and decryption are the same operation. The counter is
 * 32-bit-wrapping per block.
 *
 * @param key      the 32-byte key
 * @param nonce    the 12-byte nonce
 * @param counter  the initial 32-bit block counter (typically 1 per RFC 8439)
 * @param data     the input, any length
 * @return         the transformed output (same length as `data`), or a `CryptoError` on a bad
 *                 key/nonce length
 * @throws         `CryptoError` when `key.len != 32` or `nonce.len != 12`
 */
exp fn chacha20(key: []byte, nonce: []byte, counter: u32, data: []byte): []byte | CryptoError {
    if key.len != 32 { return crypto_error("chacha20: key must be exactly 32 bytes") }
    if nonce.len != 12 { return crypto_error("chacha20: nonce must be exactly 12 bytes (96-bit)") }
    var out: []byte = teko::list::empty()
    var off: u64 = 0
    var block_counter = counter
    loop {
        if off >= data.len { break }
        var ks = chacha20_block(key, nonce, block_counter)
        var n = if data.len - off < 64 { data.len - off } else { 64 }
        out = cipher_stream_xor(out, data, off, ks, n)
        block_counter = teko::math::wrapping_add_u32(block_counter, 1)
        off = off + 64
    }
    out
}
