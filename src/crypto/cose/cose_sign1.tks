use teko::crypto
use teko::encoding::cbor
use teko::numeric::bigint

/**
 * `teko::crypto::cose` `COSE_Sign1` (RFC 9052 §4.2, CBOR tag 18): single-signer signing over
 * `ES256`/`EdDSA`/`RS256`/`PS256` (this module's core doc in `cose.tks` covers the algorithm/key
 * scope). Builds the `Sig_structure` (§4.4) `["Signature1", protected, external_aad, payload]`,
 * canonical-CBOR-encodes it, signs those bytes, and assembles `[protected, unprotected, payload,
 * signature]` tagged 18 via `encode_canonical`.
 *
 * `ES256` SIGNING draws a fresh random nonce per attempt (RFC 6979's threat model — a reused or
 * predictable nonce leaks the private scalar) from `teko::crypto::secure_bytes`, retrying on the
 * astronomically rare invalid draw, mirroring `teko::crypto::jose::jws`'s `jose_es256_sign`.
 *
 * VERIFICATION NEVER PANICS: every structural failure (malformed CBOR, wrong tag/shape, an
 * unmapped `alg`, a key/alg family mismatch, a tampered signature) is a `CryptoError`.
 */

/**
 * Builds the RFC 9052 §4.4 `Sig_structure` for `COSE_Sign1` and canonical-CBOR-encodes it — the
 * exact bytes every algorithm signs/verifies over.
 *
 * @param protected_bytes  the protected header bucket's raw bytes
 * @param external_aad     caller-supplied external additional authenticated data (an empty slice
 *                         when unused)
 * @param payload          the payload bytes
 * @return                 the canonical `Sig_structure` encoding
 */
fn cose_sig1_structure_bytes(protected_bytes: []byte, external_aad: []byte, payload: []byte): []byte {
    var arr = cose_four(cbor::cbor_text("Signature1"), cbor::cbor_bytes(protected_bytes), cbor::cbor_bytes(external_aad), cbor::cbor_bytes(payload))
    cbor::encode_canonical(cbor::cbor_array(arr))
}

/**
 * `ES256` signing over `message` with a fresh random nonce per attempt, retrying on the
 * astronomically rare invalid draw (`k` outside `[1, order)`, or a degenerate `r`/`s` of zero).
 * A bounded 16-attempt cap turns a hypothetical broken CSPRNG into a `CryptoError` rather than an
 * infinite loop (mirrors `teko::crypto::jose::jws`'s `jose_es256_sign`).
 *
 * @param scalar   the signer's private scalar `d`
 * @param message  the message to sign (the `Sig_structure` bytes)
 * @return         the raw `(r, s)` signature, or a `CryptoError` on repeated invalid nonce draws
 * @throws         `CryptoError` after 16 failed nonce draws
 */
fn cose_sign1_es256_raw(scalar: bigint::BigInt, message: []byte): crypto::P256Signature | crypto::CryptoError {
    var attempt: u64 = 0
    loop {
        if attempt >= 16 {
            return crypto::crypto_error("cose_sign1: ES256 signing failed to derive a valid ECDSA nonce")
        }
        var k = bigint::from_bytes_be(crypto::secure_bytes(32))
        match crypto::ecdsa_p256_sign(scalar, crypto::EcHashAlg::Sha256, message, k) {
            crypto::P256Signature as sig => return sig
            crypto::CryptoError => attempt = attempt + 1
        }
    }
    crypto::crypto_error("cose_sign1: ES256 signing unreachable")
}

/**
 * Encodes a P-256 `(r, s)` pair as the COSE `ES256` fixed 64-byte `r || s` concatenation
 * (RFC 9053 §2.1), each component zero-padded to exactly 32 bytes.
 *
 * @param sig  the raw ECDSA signature
 * @return     the 64-byte COSE signature, or a `CryptoError` if a component does not fit 32 bytes
 * @throws     `CryptoError` when `r` or `s` is out of the representable 32-byte range
 */
fn cose_sign1_es256_to_bytes(sig: crypto::P256Signature): []byte | crypto::CryptoError {
    var r_bytes = match bigint::to_bytes_be_padded(sig.r, 32) {
        []byte as b => b
        error => return crypto::crypto_error("cose_sign1: ES256 signature 'r' does not fit 32 bytes")
    }
    var s_bytes = match bigint::to_bytes_be_padded(sig.s, 32) {
        []byte as b => b
        error => return crypto::crypto_error("cose_sign1: ES256 signature 's' does not fit 32 bytes")
    }
    cose_bytes_concat(r_bytes, s_bytes)
}

/**
 * `ES256` signing: requires an `EcdsaPrivate` `CoseSigningKey`.
 *
 * @param key      the signer's key
 * @param message  the `Sig_structure` bytes
 * @return         the 64-byte `r || s` signature, or a `CryptoError`
 * @throws         `CryptoError` when `key` is not `EcdsaPrivate`, or per `cose_sign1_es256_raw`
 */
fn cose_sign1_sign_es256(key: CoseSigningKey, message: []byte): []byte | crypto::CryptoError {
    if key.kind != CoseSigningKeyKind::EcdsaPrivate {
        return crypto::crypto_error("cose_sign1: ES256 signing requires an EC P-256 private key")
    }
    var sig = match cose_sign1_es256_raw(key.ec_scalar, message) {
        crypto::P256Signature as s => s
        crypto::CryptoError as e => return e
    }
    cose_sign1_es256_to_bytes(sig)
}

/**
 * `EdDSA` signing: requires an `Ed25519Private` `CoseSigningKey`.
 *
 * @param key      the signer's key
 * @param message  the `Sig_structure` bytes
 * @return         the 64-byte Ed25519 signature, or a `CryptoError`
 * @throws         `CryptoError` when `key` is not `Ed25519Private`
 */
fn cose_sign1_sign_eddsa(key: CoseSigningKey, message: []byte): []byte | crypto::CryptoError {
    if key.kind != CoseSigningKeyKind::Ed25519Private {
        return crypto::crypto_error("cose_sign1: EdDSA signing requires an Ed25519 private key")
    }
    crypto::ed25519_sign(key.ed_secret, message)
}

/**
 * `RS256` signing: requires an `RsaPrivate` `CoseSigningKey`.
 *
 * @param key      the signer's key
 * @param message  the `Sig_structure` bytes
 * @return         the RSASSA-PKCS1-v1_5 signature, or a `CryptoError`
 * @throws         `CryptoError` when `key` is not `RsaPrivate`, or per `rsa_sign_pkcs1v15`
 */
fn cose_sign1_sign_rs256(key: CoseSigningKey, message: []byte): []byte | crypto::CryptoError {
    if key.kind != CoseSigningKeyKind::RsaPrivate {
        return crypto::crypto_error("cose_sign1: RS256 signing requires an RSA private key")
    }
    crypto::rsa_sign_pkcs1v15(key.rsa_key, crypto::RsaHashAlg::Sha256, message)
}

/**
 * `PS256` signing: requires an `RsaPrivate` `CoseSigningKey`. Draws a fresh random 32-byte salt
 * (RFC 9053 §3.1: PSS salt length equals the hash length) from `teko::crypto::secure_bytes` per
 * signature.
 *
 * @param key      the signer's key
 * @param message  the `Sig_structure` bytes
 * @return         the RSASSA-PSS signature, or a `CryptoError`
 * @throws         `CryptoError` when `key` is not `RsaPrivate`, or per `rsa_sign_pss`
 */
fn cose_sign1_sign_ps256(key: CoseSigningKey, message: []byte): []byte | crypto::CryptoError {
    if key.kind != CoseSigningKeyKind::RsaPrivate {
        return crypto::crypto_error("cose_sign1: PS256 signing requires an RSA private key")
    }
    crypto::rsa_sign_pss(key.rsa_key, crypto::RsaHashAlg::Sha256, message, crypto::secure_bytes(32))
}

/**
 * Computes the raw signature bytes for `alg` over `sig_input` under `key` — the one flat
 * exhaustive dispatch every `Sign1`-eligible `CoseAlg` member routes through. `Hmac256` is not a
 * `Sign1` algorithm and is rejected as a `CryptoError`.
 *
 * @param alg        the signature algorithm
 * @param key        the signer's key
 * @param sig_input  the `Sig_structure` bytes
 * @return           the raw signature bytes, or a `CryptoError`
 * @throws           `CryptoError` on a key/alg family mismatch, `Hmac256`, or an underlying
 *                   primitive failure
 */
fn cose_sign1_dispatch_sign(alg: CoseAlg, key: CoseSigningKey, sig_input: []byte): []byte | crypto::CryptoError {
    match alg {
        ES256 => cose_sign1_sign_es256(key, sig_input)
        EdDSA => cose_sign1_sign_eddsa(key, sig_input)
        RS256 => cose_sign1_sign_rs256(key, sig_input)
        PS256 => cose_sign1_sign_ps256(key, sig_input)
        Hmac256 => crypto::crypto_error("cose_sign1: HMAC is not a Sign1 algorithm; use cose_mac0_create")
    }
}

/**
 * `ES256` verification: rejects a signature that is not exactly 64 bytes before splitting it.
 *
 * @param key        the candidate verification key
 * @param sig_input  the `Sig_structure` bytes
 * @param sig        the candidate signature
 * @return           `true` iff `sig` is a valid ECDSA P-256/SHA-256 signature under `key`
 */
fn cose_sign1_verify_es256(key: CoseVerificationKey, sig_input: []byte, sig: []byte): bool {
    if key.kind != CoseVerificationKeyKind::EcdsaPublic || sig.len != 64 { return false }
    var r = bigint::from_bytes_be(cose_bytes_slice(sig, 0, 32))
    var s = bigint::from_bytes_be(cose_bytes_slice(sig, 32, 64))
    crypto::ecdsa_p256_verify(key.ec_point, crypto::EcHashAlg::Sha256, sig_input, r, s)
}

/**
 * Checks `sig` under `alg`/`key` over `sig_input` — the one flat exhaustive dispatch every
 * `Sign1`-eligible `CoseAlg` member routes through. Never panics. `Hmac256` is not a `Sign1`
 * algorithm and always yields `false`.
 *
 * @param alg        the signature algorithm
 * @param key        the candidate verification key
 * @param sig_input  the `Sig_structure` bytes
 * @param sig        the candidate signature
 * @return           `true` iff `sig` is a genuine signature under `key`/`alg`
 */
fn cose_sign1_dispatch_verify(alg: CoseAlg, key: CoseVerificationKey, sig_input: []byte, sig: []byte): bool {
    match alg {
        ES256 => cose_sign1_verify_es256(key, sig_input, sig)
        EdDSA => key.kind == CoseVerificationKeyKind::Ed25519Public && crypto::ed25519_verify(key.ed_public, sig_input, sig)
        RS256 => key.kind == CoseVerificationKeyKind::RsaPublic && crypto::rsa_verify_pkcs1v15(key.rsa_key, crypto::RsaHashAlg::Sha256, sig_input, sig)
        PS256 => key.kind == CoseVerificationKeyKind::RsaPublic && crypto::rsa_verify_pss(key.rsa_key, crypto::RsaHashAlg::Sha256, sig_input, sig)
        Hmac256 => false
    }
}

/**
 * Signs `payload` under `alg`/`key` and returns the encoded, tag-18 `COSE_Sign1` document
 * (RFC 9052 §4.2): builds the protected header (`alg` only) and unprotected header (`kid` when
 * non-empty), computes the `Sig_structure` over the EXACT protected header bytes, signs it, and
 * canonical-CBOR-encodes `[protected, unprotected, payload, signature]` under tag 18.
 *
 * @param alg           the signature algorithm
 * @param key           the signer's key (matching `alg`'s family — see the per-family
 *                      `cose_sign1_sign_*` helpers)
 * @param kid           the key identifier to carry in the unprotected header, or an empty slice
 *                      to omit it
 * @param external_aad  external additional authenticated data, or an empty slice when unused
 * @param payload       the payload bytes to sign (embedded, never detached)
 * @return              the encoded `COSE_Sign1` document, or a `CryptoError`
 * @throws              `CryptoError` on a key/alg family mismatch or an underlying primitive
 *                      failure
 */
exp fn cose_sign1_sign(alg: CoseAlg, key: CoseSigningKey, kid: []byte, external_aad: []byte, payload: []byte): []byte | crypto::CryptoError {
    var protected_bytes = cose_protected_header_bytes(alg)
    var unprotected = cose_unprotected_header(kid)
    var sig_input = cose_sig1_structure_bytes(protected_bytes, external_aad, payload)
    var sig = match cose_sign1_dispatch_sign(alg, key, sig_input) {
        []byte as s => s
        crypto::CryptoError as e => return e
    }
    var arr = cose_four(cbor::cbor_bytes(protected_bytes), unprotected, cbor::cbor_bytes(payload), cbor::cbor_bytes(sig))
    cbor::encode_canonical(cbor::cbor_tag(18, cbor::cbor_array(arr)))
}

/**
 * Verifies an encoded `COSE_Sign1` document (tag 18, or a bare untagged array) and returns the
 * payload on success: extracts the four fields, reads `alg` off the protected header, recomputes
 * the `Sig_structure` from the EXACT protected/payload bytes on the wire, and checks the
 * signature under `key`.
 *
 * @param key           the verifier's key (must match the document's `alg` family — see the
 *                      per-family `cose_sign1_verify_*`/dispatch helpers)
 * @param external_aad  the same external additional authenticated data the signer used, or an
 *                      empty slice when unused
 * @param cose_bytes    the candidate encoded `COSE_Sign1` document
 * @return              the payload bytes, or a `CryptoError`
 * @throws              `CryptoError` on malformed CBOR, a wrong tag/shape, an unsupported `alg`,
 *                      a key/alg family mismatch, or a signature that fails to verify
 */
exp fn cose_sign1_verify(key: CoseVerificationKey, external_aad: []byte, cose_bytes: []byte): []byte | crypto::CryptoError {
    var four = match cose_decode_four_tuple(18, cose_bytes) {
        CoseFourTuple as t => t
        crypto::CryptoError as e => return e
    }
    var protected_map = match cose_decode_protected_map(four.protected) {
        cbor::CborValue as m => m
        crypto::CryptoError as e => return e
    }
    var alg = match cose_header_alg(protected_map) {
        CoseAlg as a => a
        crypto::CryptoError as e => return e
    }
    var sig_input = cose_sig1_structure_bytes(four.protected, external_aad, four.payload)
    if !cose_sign1_dispatch_verify(alg, key, sig_input, four.trailer) {
        return crypto::crypto_error("cose_sign1_verify: signature verification failed")
    }
    four.payload
}
