use teko::crypto
use teko::encoding::cbor
use teko::numeric::bigint

/**
 * Tests for `teko::crypto::cose`: `COSE_Sign1` and `COSE_Mac0` sign/verify across every
 * algorithm this unit implements (`ES256`, `EdDSA`, `RS256`, `PS256`, `HMAC 256/256`), plus the
 * shared header plumbing (`cose_alg_label`/`cose_alg_from_label`, `cose_read_headers`).
 *
 * CROSS-CHECK METHODOLOGY (every vector below traces to one of these, generated by a Python
 * script hand-building the exact RFC 9052/9053 structures this unit implements — `cbor2 6.1.4`
 * for canonical CBOR, `cryptography 50.0.0` for RSA/ECDSA/Ed25519 primitives, and `pycose 1.1.0`
 * cross-checked against the same protected/unprotected header shape for `HMAC`/`EdDSA`):
 *   - `RS256` (RSASSA-PKCS1-v1_5) and `HMAC 256/256` and `EdDSA` are DETERMINISTIC. Their
 *     expected `COSE_Sign1`/`COSE_Mac0` documents are BYTE-IDENTICAL to `cryptography`'s
 *     `RSAPrivateKey.sign(..., padding.PKCS1v15(), hashes.SHA256())` /
 *     `Ed25519PrivateKey.sign(...)` / `hmac.new(..., hashlib.sha256)` over the exact
 *     `Sig_structure`/`MAC_structure` bytes this unit computes, assembled into
 *     `[protected, unprotected, payload, trailer]` and canonical-CBOR-encoded under the matching
 *     tag (18 for `Sign1`, 17 for `Mac0`) with `cbor2.dumps(..., canonical=True)`. The
 *     `HMAC`/`EdDSA` header shape (`alg` in protected, `kid` in unprotected) was additionally
 *     cross-checked against `pycose`'s own `Sign1Message`/`Mac0Message` encoder, which produces
 *     the identical bucket placement.
 *   - `ES256` and `PS256` are RANDOMIZED (ECDSA nonce / PSS salt), so no byte-identical document
 *     is possible. Instead: (a) `cose_sign1_verify` is checked to ACCEPT a document
 *     `cryptography` produced under the same key (the strongest "our verifier implements the
 *     real algorithm" proof), and (b) a fresh self-signed document round-trips through this
 *     unit's own `cose_sign1_verify`.
 *   - The RSA key is a freshly generated 1024-bit `cryptography.hazmat` key; the EC key a
 *     `SECP256R1` key from `ec.generate_private_key`; the Ed25519 key from
 *     `Ed25519PrivateKey.generate()`. The HMAC secret is the 32 bytes `0x00..0x1f`.
 *   - The shared payload is the ASCII text `"hello cose sign1"`, with no `external_aad`.
 *
 * This file lives under `teko::crypto::cose` (namespace = directory), so `cose_sign1_sign`/
 * `cose_sign1_verify`/`cose_mac0_create`/`cose_mac0_verify`/`cose_alg_label`/... are called bare,
 * mirroring `teko::crypto::jose`'s `jws_test.tkt` and `teko::crypto::xmldsig`'s
 * `xmldsig_test.tkt`.
 */

/**
 * The `BigInt` a hex fixture decodes to, failing the test on malformed hex.
 *
 * @param hex  the hexadecimal text
 * @return     the parsed value
 */
fn ct_bigint_hex(hex: str): bigint::BigInt {
    match bigint::from_hex(hex) {
        bigint::BigInt as b => b
        error => { teko::assert::is_true(false); bigint::zero() }
    }
}

/**
 * A fixed-length big-endian `[]byte` decoded from a hex fixture, failing the test on malformed
 * hex or a value that does not fit `len` bytes.
 *
 * @param hex  the hexadecimal text
 * @param len  the exact output length in bytes
 * @return     the decoded bytes
 */
fn ct_hex_bytes(hex: str, len: u64): []byte {
    var v = ct_bigint_hex(hex)
    match bigint::to_bytes_be_padded(v, len) {
        []byte as b => b
        error => { teko::assert::is_true(false); teko::list::empty() }
    }
}

/**
 * The sequential byte string `0, 1, 2, .. n-1` — this file's fixed 32-byte HMAC secret
 * (`ct_seq_bytes(32)`), built programmatically rather than transcribed as a hex literal.
 *
 * @param n  how many bytes to build
 * @return   `n` bytes, `out[i] == i` (truncated to a byte)
 */
fn ct_seq_bytes(n: u64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, i to byte)
        i++
    }
    out
}

/**
 * The `[]byte` value of a `[]byte | CryptoError` a vector expects to succeed.
 *
 * @param r  the union to unwrap
 * @return   the contained bytes
 */
fn ct_unwrap_bytes(r: []byte | crypto::CryptoError): []byte {
    match r {
        []byte as b => b
        crypto::CryptoError => { teko::assert::is_true(false); teko::list::empty() }
    }
}

/**
 * The shared test payload, `"hello cose sign1"` (see this file's header for the cross-check
 * methodology).
 *
 * @return  the payload bytes
 */
fn ct_payload(): []byte {
    bytes_of_str("hello cose sign1")
}

/**
 * The 1024-bit RSA test key's modulus, as hex (`cryptography.hazmat`-generated; a small key,
 * matching `teko::crypto::jose::jws_test`'s convention, keeps this pure-Teko bignum engine's
 * test-suite runtime modest).
 *
 * @return  the modulus hex text
 */
fn ct_rsa_n_hex(): str {
    "b1a934ab047b230b17db4172413e35ee0e78ef84f3319d9e09b81354ad1a32ddad70b8b66980f07ecc815b19ac4514b6d60480250de99147dbc9926036c6a81f1e1b0dfc556849a278cf7ed1d7dcf8e1b72f46fd9ef9a7020563f485c3b0225cee67be732feb3b911cf0ea99fc6cfe572b802704d83cc51af1713db11ace517b"
}

/**
 * The RSA test key's public exponent, as hex (`65537`).
 *
 * @return  the exponent hex text
 */
fn ct_rsa_e_hex(): str {
    "10001"
}

/**
 * The RSA test key's private exponent, as hex.
 *
 * @return  the private exponent hex text
 */
fn ct_rsa_d_hex(): str {
    "9fe004e56142ee662d31c1d36fa2ec252e20e66a5def6847afb756adfc9876edc6068a329cfecb6d4fdb987fa1e7089d003b4c960bcf044e061b7efdd64d2f3c5197b5c40e41645a7de05e329d3fa3e38115e4465ce7d1f796712871711a7a21f8b4eb945ed20685921284e85e92b9d65ab52a3b2f549fd5e3836f6c29fc6501"
}

/**
 * The assembled RSA test signing key.
 *
 * @return  a `RsaPrivate` `CoseSigningKey`
 */
fn ct_rsa_sign_key(): CoseSigningKey {
    var priv = match crypto::rsa_private_key_from_hex(ct_rsa_n_hex(), ct_rsa_d_hex(), ct_rsa_e_hex()) {
        crypto::RsaPrivateKey as k => k
        crypto::CryptoError => { teko::assert::is_true(false); crypto::RsaPrivateKey { n = bigint::zero(); d = bigint::zero(); e = bigint::zero() } }
    }
    cose_signing_key_rsa(priv)
}

/**
 * The assembled RSA test verification key.
 *
 * @return  a `RsaPublic` `CoseVerificationKey`
 */
fn ct_rsa_verify_key(): CoseVerificationKey {
    var pubkey = match crypto::rsa_public_key_from_hex(ct_rsa_n_hex(), ct_rsa_e_hex()) {
        crypto::RsaPublicKey as k => k
        crypto::CryptoError => { teko::assert::is_true(false); crypto::RsaPublicKey { n = bigint::zero(); e = bigint::zero() } }
    }
    cose_verification_key_rsa(pubkey)
}

/**
 * `RS256` signing over `ct_payload` matches the Python reference document byte-for-byte
 * (RSASSA-PKCS1-v1_5 is deterministic), and `cose_sign1_verify` accepts it and recovers the
 * exact payload.
 */
#test
fn rs256_matches_python_and_round_trips() {
    var want = ""
    var doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::RS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    teko::assert::eq_str(crypto::to_hex(doc), want)
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(ct_rsa_verify_key(), teko::list::empty(), doc)), ct_payload())
}

/**
 * `cose_sign1_verify` ACCEPTS a `PS256` document `cryptography` produced under the same RSA key
 * (PSS is randomized, so no byte-identical document is possible — see this file's header), and a
 * freshly self-signed `PS256` document round-trips.
 */
#test
fn ps256_verify_accepts_python_document_and_round_trips() {
    var external_hex = ""
    var external = ct_hex_bytes(external_hex, 155)
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(ct_rsa_verify_key(), teko::list::empty(), external)), ct_payload())

    var fresh = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::PS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(ct_rsa_verify_key(), teko::list::empty(), fresh)), ct_payload())
}

/**
 * The P-256 test key's private scalar `d`, as hex (`cryptography.hazmat`-generated).
 *
 * @return  the scalar hex text
 */
fn ct_ec_d_hex(): str {
    "eb302aaa44006b3151d1d1a431be6f4b187d418d70edd9283ecc3033adb4bbdf"
}

/**
 * The P-256 test key's public X coordinate, as hex.
 *
 * @return  the X coordinate hex text
 */
fn ct_ec_x_hex(): str {
    "b45c2fa9dc92ecc111b5e5dd360e1302739e3bdda25990e0942008ec57bf1035"
}

/**
 * The P-256 test key's public Y coordinate, as hex.
 *
 * @return  the Y coordinate hex text
 */
fn ct_ec_y_hex(): str {
    "567cb99c568643ce2ef776da000000295331f3ffeb0684a7c1517169bffa7e5f"
}

/**
 * The assembled P-256 test public point.
 *
 * @return  the P-256 point
 */
fn ct_ec_point(): crypto::P256Point {
    crypto::P256Point { infinity = false; x = ct_bigint_hex(ct_ec_x_hex()); y = ct_bigint_hex(ct_ec_y_hex()) }
}

/**
 * `cose_sign1_verify` ACCEPTS an `ES256` document `cryptography` produced under the same P-256
 * key (ECDSA is randomized — see this file's header), and a freshly self-signed `ES256` document
 * round-trips.
 */
#test
fn es256_verify_accepts_python_document_and_round_trips() {
    var external_hex = "d28443a10126a05068656c6c6f20636f7365207369676e315840fda256b22e25bd2a0c34143fc0ca113f070d667acf4ccc7f3a1867d322f10fc4251946e4bbff4127449e21bdede9c71833a03f55b9cb66d304441fd2069a15d2"
    var external = ct_hex_bytes(external_hex, 90)
    var verify_key = cose_verification_key_ecdsa(ct_ec_point())
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(verify_key, teko::list::empty(), external)), ct_payload())

    var sign_key = cose_signing_key_ecdsa(ct_bigint_hex(ct_ec_d_hex()))
    var fresh = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::ES256, sign_key, teko::list::empty(), teko::list::empty(), ct_payload()))
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(verify_key, teko::list::empty(), fresh)), ct_payload())
}

/**
 * The Ed25519 test key's secret seed, as hex (`cryptography.hazmat`-generated).
 *
 * @return  the secret seed hex text
 */
fn ct_ed_secret_hex(): str {
    "cca332852a42fc4c1bcb94f8c72de5ebcdd18ab0e10f5e10bc0d35bb2c1b29ef"
}

/**
 * The Ed25519 test key's public key, as hex.
 *
 * @return  the public key hex text
 */
fn ct_ed_public_hex(): str {
    "ab452f6977937ed66c7d0e8a7e76ce667a0ecff238d4480d36fe06be414035fc"
}

/**
 * `EdDSA` signing over `ct_payload` matches the Python reference document byte-for-byte
 * (Ed25519 signing is deterministic), and `cose_sign1_verify` accepts it.
 */
#test
fn eddsa_matches_python_and_round_trips() {
    var want = "d28443a10127a05068656c6c6f20636f7365207369676e3158402c5af61ffc80665b530e63c284a1c688a900e3926da927d2f42830657a56294034f45c4934025241f7ead4dda5bbcb41ea306393985f88c83ca465b0990d650d"
    var sign_key = cose_signing_key_ed25519(ct_hex_bytes(ct_ed_secret_hex(), 32))
    var doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::EdDSA, sign_key, teko::list::empty(), teko::list::empty(), ct_payload()))
    teko::assert::eq_str(crypto::to_hex(doc), want)

    var verify_key = cose_verification_key_ed25519(ct_hex_bytes(ct_ed_public_hex(), 32))
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_sign1_verify(verify_key, teko::list::empty(), doc)), ct_payload())
}

/**
 * `HMAC 256/256` `COSE_Mac0` creation over `ct_payload` (with a `kid` header) matches the Python
 * reference document byte-for-byte (HMAC is deterministic), and `cose_mac0_verify` accepts it.
 */
#test
fn hmac_mac0_matches_python_and_round_trips() {
    var want = "d18443a10105a104456b65792d315068656c6c6f20636f7365207369676e315820f6af50a669d22f0ed9b13a922d5de1f6237d6d05addd422f14b295250b0c2ebb"
    var secret = ct_seq_bytes(32)
    var kid = bytes_of_str("key-1")
    var doc = cose_mac0_create(secret, kid, teko::list::empty(), ct_payload())
    teko::assert::eq_str(crypto::to_hex(doc), want)
    teko::assert::bytes_eq(ct_unwrap_bytes(cose_mac0_verify(secret, teko::list::empty(), doc)), ct_payload())
}

/**
 * `cose_read_headers` reads back the exact `alg`/`kid` a `COSE_Mac0` document carries.
 */
#test
fn read_headers_reads_alg_and_kid() {
    var secret = ct_seq_bytes(32)
    var kid = bytes_of_str("key-1")
    var doc = cose_mac0_create(secret, kid, teko::list::empty(), ct_payload())
    var headers = match cose_read_headers(doc) {
        CoseHeaders as h => h
        crypto::CryptoError => { teko::assert::is_true(false); CoseHeaders { alg = CoseAlg::Hmac256; kid = teko::list::empty() } }
    }
    match headers.alg {
        CoseAlg::Hmac256 => teko::assert::is_true(true)
        _ => teko::assert::is_true(false)
    }
    teko::assert::bytes_eq(headers.kid, kid)
}

/**
 * `cose_read_headers` reports an empty `kid` when the document carries none (the `RS256` vector
 * signs with no `kid` header).
 */
#test
fn read_headers_reports_absent_kid() {
    var doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::RS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    var headers = match cose_read_headers(doc) {
        CoseHeaders as h => h
        crypto::CryptoError => { teko::assert::is_true(false); CoseHeaders { alg = CoseAlg::RS256; kid = teko::list::empty() } }
    }
    match headers.alg {
        CoseAlg::RS256 => teko::assert::is_true(true)
        _ => teko::assert::is_true(false)
    }
    teko::assert::len_eq(headers.kid.len, 0)
}

/**
 * `cose_sign1_verify` rejects a `COSE_Sign1` document checked under a key of the WRONG family
 * (an `EC` key checked against an `RS256` document), a family mismatch, never silently accepting
 * it.
 */
#test
fn sign1_verify_rejects_key_family_mismatch() {
    var doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::RS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    var wrong_key = cose_verification_key_ecdsa(ct_ec_point())
    match cose_sign1_verify(wrong_key, teko::list::empty(), doc) {
        []byte => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

/**
 * `cose_sign1_verify` rejects a genuine document checked under the WRONG RSA key (a tampered/
 * mismatched-key attack), with a `CryptoError`.
 */
#test
fn sign1_verify_rejects_wrong_key() {
    var doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::RS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    var wrong_key = cose_verification_key_rsa(crypto::RsaPublicKey { n = bigint::add(ct_bigint_hex(ct_rsa_n_hex()), bigint::of(2)); e = ct_bigint_hex(ct_rsa_e_hex()) })
    match cose_sign1_verify(wrong_key, teko::list::empty(), doc) {
        []byte => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

/**
 * `cose_sign1_verify` rejects malformed CBOR input with a `CryptoError`, never panicking.
 */
#test
fn sign1_verify_rejects_malformed_cbor() {
    var garbage = ct_hex_bytes("ffffffffffff", 6)
    match cose_sign1_verify(ct_rsa_verify_key(), teko::list::empty(), garbage) {
        []byte => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

/**
 * `cose_mac0_verify` rejects a genuine `COSE_Mac0` document checked under the WRONG secret, with
 * a `CryptoError`.
 */
#test
fn mac0_verify_rejects_wrong_secret() {
    var doc = cose_mac0_create(ct_seq_bytes(32), teko::list::empty(), teko::list::empty(), ct_payload())
    var wrong_secret = ct_seq_bytes(31)
    match cose_mac0_verify(wrong_secret, teko::list::empty(), doc) {
        []byte => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

/**
 * `cose_mac0_verify` rejects a `COSE_Sign1` document (tag 18, not tag 17) with a `CryptoError` —
 * the tag-number check catches the structural type confusion before any cryptography runs.
 */
#test
fn mac0_verify_rejects_wrong_tag_number() {
    var sign1_doc = ct_unwrap_bytes(cose_sign1_sign(CoseAlg::RS256, ct_rsa_sign_key(), teko::list::empty(), teko::list::empty(), ct_payload()))
    match cose_mac0_verify(ct_seq_bytes(32), teko::list::empty(), sign1_doc) {
        []byte => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}

/**
 * The `CoseAlg` value of a `CoseAlg | CryptoError` a vector expects to succeed.
 *
 * @param r  the union to unwrap
 * @return   the contained algorithm
 */
fn ct_unwrap_alg(r: CoseAlg | crypto::CryptoError): CoseAlg {
    match r {
        CoseAlg as a => a
        crypto::CryptoError => { teko::assert::is_true(false); CoseAlg::Hmac256 }
    }
}

/**
 * `cose_alg_label`/`cose_alg_from_label` round-trip for every algorithm this unit supports
 * (the RFC 9053 registry integers `-7`, `-8`, `-37`, `-257`, `5`), and `cose_alg_from_label`
 * rejects an unregistered/unsupported label.
 */
#test
fn alg_label_round_trips_and_rejects_unsupported() {
    teko::assert::eq_i64(cose_alg_label(CoseAlg::ES256), -7)
    teko::assert::eq_i64(cose_alg_label(CoseAlg::EdDSA), -8)
    teko::assert::eq_i64(cose_alg_label(CoseAlg::PS256), -37)
    teko::assert::eq_i64(cose_alg_label(CoseAlg::RS256), -257)
    teko::assert::eq_i64(cose_alg_label(CoseAlg::Hmac256), 5)

    match ct_unwrap_alg(cose_alg_from_label(-7)) { ES256 => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match ct_unwrap_alg(cose_alg_from_label(-8)) { EdDSA => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match ct_unwrap_alg(cose_alg_from_label(-37)) { PS256 => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match ct_unwrap_alg(cose_alg_from_label(-257)) { RS256 => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match ct_unwrap_alg(cose_alg_from_label(5)) { Hmac256 => teko::assert::is_true(true); _ => teko::assert::is_true(false) }
    match cose_alg_from_label(-999) {
        CoseAlg => teko::assert::is_true(false)
        crypto::CryptoError => teko::assert::is_true(true)
    }
}
