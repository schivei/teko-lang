// src/parser/parse_type.tks   (namespace 'teko::parser')

use teko::lexer

// A primary type: a slice `[]T` or a named path. (Members of a `|` union and a
// slice's element are primaries — the union level is `parse_type` below.)
// (0.3.1 §2) The old function/closure VALUE type `(A, B): R` is RETIRED — a function TYPE is now
// written with the C#-style delegate spellings `func<…, R>` / `action<…>` (see `parse_delegate_type`
// below). A `(` in a type position is no longer a function type; it falls through to the ordinary
// parse path and fails as an unexpected token.

/**
 * delegate_unit_ret — the internal unit-return sentinel a delegate type with NO return (`action`,
 * `action<…>`) carries in the shared `FunctionType.ret` slot. It is an UNSPELLABLE named type `()`
 * that the checker's `builtin_type` resolves to `Void`; the user can never write it (the lexer emits
 * `(` as `LParen`, never an identifier `()`), so it exists solely to let `action` reuse the one
 * `FunctionType` AST node `func` uses, mapping the absent return to unit. This is the SAME internal
 * `Void` the retired `(A, B): void` form produced — a pure surface respelling, no new runtime type.
 *
 * @return the `()` sentinel type-expression
 */
fn delegate_unit_ret(): TypeExpr {
    NamedType { path = Path { segments = teko::list::push(teko::list::empty(), Segment { name = "()" }) }; args = teko::list::empty() }
}

/**
 * is_delegate_kw_at — is the token at `pos` the contextual delegate-type constructor `func` or
 * `action` (0.3.1 §2 surface)? Both are plain `Ident`s (never reserved in the lexer), recognized
 * only in a TYPE position and only when NOT immediately followed by `::` (so a hypothetical
 * `func::X` path segment is untouched — none exist in the corpus). They introduce the C#-style
 * delegate TYPE spellings that REPLACE the old `(A, B): R` closure form.
 *
 * @param tokens  the token stream
 * @param pos     the candidate position
 * @return        true iff `pos` opens a `func`/`action` delegate type
 */
fn is_delegate_kw_at(tokens: []lexer::Token, pos: u64): bool {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) { return false }
    if !(tokens[pos].text == "func" || tokens[pos].text == "action") { return false }
    !is_kind_at(tokens, pos + 1, lexer::TokenKind::ColonColon)
}

/**
 * parse_delegate_type — `func<T1, …, Tn, R>` / `action<T1, …, Tn>`, the C#-style delegate TYPE
 * spellings (0.3.1 §2 surface) that REPLACE the retired `(A, B): R` closure form. Both desugar into
 * the existing `FunctionType` AST node (a closure/function VALUE type), so codegen/.tkb are unchanged:
 *
 *   - `func<R>`            → 0 params, returns `R`         (exactly one type arg IS the return)
 *   - `func<T1, …, Tn, R>` → params `T1…Tn`, returns `R`  (the LAST type arg is the return)
 *   - `func` bare / `func<>`  → INVALID (a `func` needs at least the return type)
 *   - `action`             → 0 params, no return (unit — the `delegate_unit_ret` sentinel)
 *   - `action<T1, …, Tn>`  → params `T1…Tn`, no return (unit)
 *   - `action<>`           → INVALID (write bare `action` for the zero-parameter form)
 *
 * The `<…>` list mirrors `parse_named`'s type-argument loop, threading the `>>` (Shr) compound close
 * through `pending_gt` so a delegate nests inside a generic (`List<func<i64, str>>`). Arity is capped
 * at 16 type arguments — the general generic cap (`max_generic_arity`). `pos` is at `func`/`action`.
 *
 * @param tokens  the token stream
 * @param pos     the index of the `func`/`action` keyword
 * @return        the parsed delegate as a `FunctionType`, or a parse error
 */
fn parse_delegate_type(tokens: []lexer::Token, pos: u64): ParsedType | error {
    var is_action = tokens[pos].text == "action"
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::Lt) {
        if is_action {
            return ParsedType { node = FunctionType { params = teko::list::empty(); ret = delegate_unit_ret() }; next = pos + 1; pending_gt = 0 }
        }
        return err_at(tokens, pos, "`func` needs a return type: write `func<R>` (a zero-parameter function returning `R`)")
    }
    var args: []TypeExpr = teko::list::empty()
    var p = pos + 2
    var pend = 0 to u64
    loop {
        var a = match parse_type(tokens, p) { ParsedType as x => x; error as e => return e }
        args = teko::list::push(args, a.node)
        if a.pending_gt > 0 { p = a.next; pend = a.pending_gt - 1; break }
        p = a.next
        if is_kind_at(tokens, p, lexer::TokenKind::Comma) { p = p + 1 }
        else if is_kind_at(tokens, p, lexer::TokenKind::Gt) { p = p + 1; break }
        else if is_kind_at(tokens, p, lexer::TokenKind::Shr) { p = p + 1; pend = 1; break }
        else { return err_at(tokens, p, "expected ',' or '>' in a `func`/`action` type-argument list") }
    }
    if args.len > 16 {
        return err_at(tokens, pos, "a `func`/`action` delegate type may carry at most 16 type arguments")
    }
    if is_action {
        if args.len == 0 { return err_at(tokens, pos, "`action<>` is empty — write `action` for a zero-parameter no-return function type") }
        return ParsedType { node = FunctionType { params = args; ret = delegate_unit_ret() }; next = p; pending_gt = pend }
    }
    if args.len == 0 { return err_at(tokens, pos, "`func<>` is empty — a `func` needs at least a return type: write `func<R>`") }
    var params: []TypeExpr = teko::list::empty()
    var i = 0 to u64
    loop { if i >= args.len - 1 { break }; params = teko::list::push(params, args[i]); i++ }
    ParsedType { node = FunctionType { params = params; ret = args[args.len - 1] }; next = p; pending_gt = pend }
}

/**
 * Build the `null` type-atom (null-as-union). The `null` keyword in a type position denotes the
 * `Null` unit type; it is carried as a single-segment `NamedType` named "null" (a reserved keyword,
 * so it can never collide with a user type), which the checker's `resolve_type` maps to `checker::Null`.
 *
 * @param pos  the position of the `null` keyword token
 * @return     the parsed `null` type atom, consuming exactly the one keyword token
 */
fn parse_null_type(pos: u64): ParsedType {
    var segs = teko::list::push(teko::list::empty(), Segment { name = "null" })
    ParsedType { node = NamedType { path = Path { segments = segs }; args = teko::list::empty() }; next = pos + 1; pending_gt = 0 }
}

/**
 * is_ref_grafia_at — is the token at `pos` the contextual `ref` keyword used as the SAFE-reference
 * type grafia (0.3.0.30 Part A)? `ref` is NOT a reserved token (the lexer emits a plain `Ident`);
 * it becomes the reference grafia only in a type position, when the `ref` identifier is immediately
 * followed by another token that can begin a type (a name, `[`, `(`, or `ref` again for nesting).
 * A bare identifier literally named `ref` at the end of a type (none exist in the corpus) stays an
 * ordinary named type. Legal in every ordinary type position (a return, a field, a generic
 * argument, a slice element — `ref-transparent-model.md:56`); the ONE position that does NOT reach
 * this function is the two BINDER sites (`ref x: T = e`, `fn f(ref x: T)`), which each consume
 * their own leading `ref` token before ever calling `parse_type`/`parse_type_primary` — so a `let`
 * or `mut` binding's annotation reaching THIS function with `ref` inside it is a real misuse of a
 * different, narrower kind: `type_binding` (0.3.1, owner ruling 2026-07-24) rejects a `let`/`mut`
 * binding whose annotation resolves to a `Reference`, since only a `ref` binding may hold one.
 *
 * @param tokens  the token stream
 * @param pos     the candidate `ref` position
 * @return        true iff `pos` opens a `ref`-grafia reference type
 */
fn is_ref_grafia_at(tokens: []lexer::Token, pos: u64): bool {
    if !(is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "ref") { return false }
    is_name_at(tokens, pos + 1) || is_kind_at(tokens, pos + 1, lexer::TokenKind::LBracket) || is_kind_at(tokens, pos + 1, lexer::TokenKind::LParen)
}

/**
 * wrap_ref_type — build the compiler-internal reference type `Ref<inner>` (checker `Reference{inner}`)
 * that the surface `ref`-grafia desugars to. `Ref` is the compiler-internal name of the safe reference
 * (invisible on the surface, per the ratified 0.3.1 model); the `ref` keyword is its only user grafia.
 *
 * @param inner  the referenced (pointee) type
 * @return       a `NamedType` `Ref<inner>` resolving to `checker::Reference{inner}`
 */
fn wrap_ref_type(inner: TypeExpr): TypeExpr {
    var segs = teko::list::push(teko::list::empty(), Segment { name = "Ref" })
    var args = teko::list::push(teko::list::empty(), inner)
    NamedType { path = Path { segments = segs }; args = args }
}

fn parse_type_primary(tokens: []lexer::Token, pos: u64): ParsedType | error {
    if is_ref_grafia_at(tokens, pos) {
        var inner = match parse_type_primary(tokens, pos + 1) { ParsedType as x => x; error as e => return e }
        return ParsedType { node = wrap_ref_type(inner.node); next = inner.next; pending_gt = inner.pending_gt }
    }
    // (§4) `self` as a type ATOM — the ENCLOSING type (the receiver's type in an instance method,
    // the type itself in a `static fn`). Modeled as a single-segment `NamedType` named "self"; the
    // checker's `resolve_type` special-cases that segment and resolves it to the enclosing type
    // (only meaningful inside a method body — e.g. a `: self` return on a factory). No new AST node,
    // so `.tkb` serialization is unchanged.
    var head = if is_kind_at(tokens, pos, lexer::TokenKind::SelfKw) {
        ParsedType { node = NamedType { path = Path { segments = teko::list::push(teko::list::empty(), Segment { name = "self" }) }; args = teko::list::empty() }; next = pos + 1; pending_gt = 0 }
    } else if is_kind_at(tokens, pos, lexer::TokenKind::LBracket) {
        match parse_slice(tokens, pos) { ParsedType as x => x; error as e => return e }
    } else if is_delegate_kw_at(tokens, pos) {
        match parse_delegate_type(tokens, pos) { ParsedType as x => x; error as e => return e }
    } else if is_kind_at(tokens, pos, lexer::TokenKind::Null) {
        parse_null_type(pos)
    } else {
        match parse_named(tokens, pos) { ParsedType as x => x; error as e => return e }
    }
    var node = head.node
    var p = head.next
    // A pending compound-`>` close (`>>` from a nested generic) means we are mid-close: no postfix
    // `?` can apply here — propagate the leftover up to the enclosing generic's close (S4).
    if head.pending_gt > 0 {
        return ParsedType { node = node; next = p; pending_gt = head.pending_gt }
    }
    ParsedType { node = node; next = p; pending_gt = 0 }
}

/**
 * hide_ref_surface_at — the 0.3.1 adoption gate: the compiler-internal reference name `Ref` is no
 * longer user-spellable as an ordinary named type (the `ref` keyword grafia, `wrap_ref_type` above,
 * is the ONLY surface). This fires only for the literal capitalized identifier `Ref` reached through
 * the ORDINARY named-type path (`parse_named`, below) — the `ref`-keyword grafia branch in
 * `parse_type_primary` returns before ever calling `parse_named`, so it never re-enters this gate,
 * and a `ref T | null` union member (the null-union R2-relaxed shape) still resolves normally.
 *
 * The name is reserved at BOTH ends: `parse_type_decl` refuses to DECLARE a type called `Ref`
 * (`is_reserved_type_name`). Without that, a user's own `pub type Ref` parsed fine and then every
 * USE of it failed here with a message about a compiler-internal name the author never wrote — a
 * diagnostic that names the wrong thing at the wrong place.
 *
 * @param path    the just-parsed type path
 * @return        true iff the path is the single, bare, reserved segment `Ref`
 */
fn hide_ref_surface_at(path: Path): bool {
    path.segments.len == 1 && path.segments[0].name == "Ref"
}

/**
 * is_reserved_type_name — may a user DECLARE a type with this name? `Ref` is reserved: it is the
 * compiler-internal safe reference `wrap_ref_type` builds, so a declaration of that name would be
 * unusable (every reference to it is rejected by `hide_ref_surface_at`) and its rejection message
 * would describe a construct the author never spelled.
 *
 * @param name  the declared type name
 * @return      true iff the name is reserved for the compiler
 */
pub fn is_reserved_type_name(name: str): bool {
    name == "Ref"
}

/**
 * is_ref_grafia_annotation — is `te` a BARE `ref T` annotation (the `Ref<T>` node `wrap_ref_type`
 * builds)? A `let`/`mut`/`const` binding may not carry one: the `ref` IS the binding modifier, so
 * `mut r: ref i64 = x` used to be silently accepted as a full-blown reference binding —
 * indistinguishable, after the parse, from the `ref r: i64 = x` the tripartite law prescribes, and
 * flatly contradicting this unit's own documented rule. A union that CONTAINS a reference
 * (`ref i32 | null`, the R2-relaxed absence shape) is not a bare `ref T` and stays legal.
 *
 * @param te  the parsed annotation type-expression
 * @return    true iff the annotation is a top-level `ref T`
 */
pub fn is_ref_grafia_annotation(te: TypeExpr): bool {
    match te {
        NamedType as nt => nt.args.len == 1 && hide_ref_surface_at(nt.path)
        _ => false
    }
}

/**
 * A named type is a path: `u64`, `lexer::Token` (nominal — B.13). It may carry generic type
 * ARGUMENTS `<T1, T2, …>` (S4 type-generics — `Box<i64>`, `Result<i64, str>`, nested `Box<Box<i64>>`).
 * Inference-only: type-args appear ONLY in a type position, never as a call turbofish.
 *
 * The `<…>` is parsed SPECULATIVELY and backtracks if it is not a closed argument list: the cast
 * target is a type-PRIMARY (`x to i64 < y`), so a bare `<` after a type name must stay available as
 * the comparison operator. The close handles the `>>` (Shr) compound: it closes THIS list with one
 * `>` and leaves the other for the enclosing generic (threaded via `ParsedType.pending_gt`), so
 * `Box<Box<i64>>` parses at any nesting depth. (A `>=`/`>>=` close — `>` immediately before `=`,
 * no space — still backtracks; write a space before `=`.)
 *
 * @param tokens  the token stream
 * @param pos     the index of the type name's first token
 * @return        the parsed named type (with any `<…>` type-argument list)
 * @throws        when the reserved compiler-internal name `Ref` is spelled directly (0.3.1 — use `ref T`)
 */
fn parse_named(tokens: []lexer::Token, pos: u64): ParsedType | error {
    var pp = match parse_path(tokens, pos) { Parsed<Path> as x => x; error as e => return e }
    if hide_ref_surface_at(pp.node) {
        return err_at(tokens, pos, "`Ref<T>` is compiler-internal — write the `ref` keyword instead (`ref T` in a type position, `ref x: T` to bind)")
    }
    var plain = ParsedType { node = NamedType { path = pp.node; args = teko::list::empty() }; next = pp.next; pending_gt = 0 }
    if !is_kind_at(tokens, pp.next, lexer::TokenKind::Lt) { return plain }
    var args: []TypeExpr = teko::list::empty()
    var p = pp.next + 1
    loop {
        var a = match parse_type(tokens, p) { ParsedType as x => x; error => return plain }   // not a type → backtrack
        args = teko::list::push(args, a.node)
        // A nested generic just closed with a compound `>>`: the arg carries a leftover `>` that
        // closes THIS list. Consume one; pass any remainder (deeper nesting) up.
        if a.pending_gt > 0 {
            return ParsedType { node = NamedType { path = pp.node; args = args }; next = a.next; pending_gt = a.pending_gt - 1 }
        }
        p = a.next
        if is_kind_at(tokens, p, lexer::TokenKind::Comma) { p = p + 1 }
        else if is_kind_at(tokens, p, lexer::TokenKind::Gt) {
            return ParsedType { node = NamedType { path = pp.node; args = args }; next = p + 1; pending_gt = 0 }
        }
        else if is_kind_at(tokens, p, lexer::TokenKind::Shr) {
            // `>>` closes THIS list with its first `>` and leaves one `>` for an enclosing generic.
            return ParsedType { node = NamedType { path = pp.node; args = args }; next = p + 1; pending_gt = 1 }
        }
        else { return plain }   // not a closed arg list → backtrack (e.g. `x to i64 < y`)
    }
}

// (W9.4) parse a `<T1, T2, …>` type-argument list — `pos` is at the `<`. Mirrors parse_named's `<…>`
// loop, but standalone (shared by struct-construction `Foo<i64>{…}` and the `Foo<i64> as x` pattern).
// Returns `error` to SIGNAL BACKTRACK when it is not a closed list (the caller swallows it, so a bare
// `<` stays a comparison). The `>>` (Shr) compound closes THIS list with one `>` and leaves pending_gt.
fn parse_type_args(tokens: []lexer::Token, pos: u64): ParsedTypeArgs | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Lt) { return err_at(tokens, pos, "expected '<' to open a type-argument list") }
    var args: []TypeExpr = teko::list::empty()
    var p = pos + 1
    loop {
        var a = match parse_type(tokens, p) { ParsedType as x => x; error as e => return e }   // not a type → backtrack
        args = teko::list::push(args, a.node)
        // A nested generic just closed with a compound `>>`: the arg carries a leftover `>` that
        // closes THIS list. Consume one; pass any remainder (deeper nesting) up via pending_gt.
        if a.pending_gt > 0 {
            return ParsedTypeArgs { args = args; next = a.next; pending_gt = a.pending_gt - 1 }
        }
        p = a.next
        if is_kind_at(tokens, p, lexer::TokenKind::Comma) { p = p + 1 }
        else if is_kind_at(tokens, p, lexer::TokenKind::Gt) {
            return ParsedTypeArgs { args = args; next = p + 1; pending_gt = 0 }
        }
        else if is_kind_at(tokens, p, lexer::TokenKind::Shr) {
            return ParsedTypeArgs { args = args; next = p + 1; pending_gt = 1 }
        }
        else { return err_at(tokens, p, "not a closed type-argument list") }   // backtrack (e.g. `a < b`)
    }
}

// `[]T` — `pos` is at `[` (parse_type_primary checked). The element is a PRIMARY, so
// `[]A | B` is `([]A) | B`; nested slices recurse (`[][]T`). Recursive — B.8.
fn parse_slice(tokens: []lexer::Token, pos: u64): ParsedType | error {
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::RBracket) {
        return err_at(tokens, pos + 1, "expected ']' to close '[' in a slice type '[]T'")
    }
    var elem = match parse_type_primary(tokens, pos + 2) { ParsedType as x => x; error as e => return e }
    ParsedType { node = SliceType { element = elem.node }; next = elem.next; pending_gt = elem.pending_gt }
}

// THE TYPE ENTRY — the union level (`|`, the lowest-precedence type operator, B.14):
// one or more primaries. One → that primary (no needless UnionType — M.5); two or
// more → a UnionType.
fn parse_type(tokens: []lexer::Token, pos: u64): ParsedType | error {
    var first = match parse_type_primary(tokens, pos) { ParsedType as x => x; error as e => return e }
    var members: []TypeExpr = teko::list::empty()
    members = teko::list::push(members, first.node)
    var p = first.next
    var pend = first.pending_gt
    // A `|` may be led by a newline (MULTI-LINE type union, e.g. a wide `variant` over many lines);
    // separators may also follow the `|`. We only advance `p` once a `|` is found, so a trailing
    // newline that ENDS the type (no continuation `|`) is left intact for the caller. A pending
    // compound-`>` close (a nested generic mid-close) cannot be followed by `|` — stop and propagate.
    loop {
        if pend > 0 { break }
        var q = skip_seps(tokens, p)
        if !is_kind_at(tokens, q, lexer::TokenKind::Pipe) { break }
        var mp = skip_seps(tokens, q + 1)
        var m = match parse_type_primary(tokens, mp) { ParsedType as x => x; error as e => return e }
        members = teko::list::push(members, m.node)
        p = m.next
        pend = m.pending_gt
    }
    if members.len == 1 { return ParsedType { node = first.node; next = p; pending_gt = pend } }
    ParsedType { node = UnionType { members = members }; next = p; pending_gt = pend }
}
