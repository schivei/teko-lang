use teko::lexer

fn has_token(tokens: []lexer::Token, pos: u64): bool {
    pos < tokens.len
}

fn kind_at(tokens: []lexer::Token, pos: u64): lexer::TokenKind {
    tokens[pos].kind
}

fn is_kind_at(tokens: []lexer::Token, pos: u64, k: lexer::TokenKind): bool {
    if !has_token(tokens, pos) { return false }
    kind_at(tokens, pos) == k
}

fn err_at(tokens: []lexer::Token, pos: u64, msg: str): error {
    if tokens.len == 0 { return error { message = msg } }
    var i = if pos < tokens.len { pos } else { tokens.len - 1 }
    var line = tokens[i].line
    var col = tokens[i].col
    if line == 0 { return error { message = msg } }
    error { message = $"{line}:{col}: {msg}" }
}

fn is_sep(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Semicolon) || is_kind_at(tokens, pos, lexer::TokenKind::Newline)
}

fn is_name_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Type) ||
    is_kind_at(tokens, pos, lexer::TokenKind::To) ||
    is_kind_at(tokens, pos, lexer::TokenKind::In)
}

fn skip_seps(tokens: []lexer::Token, pos: u64): u64 {
    var p = pos
    loop {
        if !is_sep(tokens, p) { break }
        p++
    }
    p
}

/**
 * Reports whether a token kind opens a bracket group, so a depth-tracking scan can nest.
 *
 * @param k  the token kind to classify
 * @return   `true` for `(`, `[` and `{`
 */
fn is_open_bracket(k: lexer::TokenKind): bool {
    k == lexer::TokenKind::LParen || k == lexer::TokenKind::LBracket || k == lexer::TokenKind::LBrace
}

/**
 * Reports whether a token kind closes a bracket group, so a depth-tracking scan can unnest.
 *
 * @param k  the token kind to classify
 * @return   `true` for `)`, `]` and `}`
 */
fn is_close_bracket(k: lexer::TokenKind): bool {
    k == lexer::TokenKind::RParen || k == lexer::TokenKind::RBracket || k == lexer::TokenKind::RBrace
}

/**
 * Counts the comma-separated items of a bracketed list without allocating, so the caller can
 * pre-size the exact backing array before a second parsing pass. Scanning starts at the first
 * item (just past the opening bracket) and stops at the matching `close` at depth zero; nested
 * bracket groups are skipped by depth so their inner commas do not count.
 *
 * @param tokens  the token stream being parsed
 * @param p0      index of the first item token (already past the opening bracket and separators)
 * @param close   the closing bracket kind that terminates the list at depth zero
 * @return        the number of top-level items, zero for an immediately-closed list
 */
fn count_comma_items(tokens: []lexer::Token, p0: u64, close: lexer::TokenKind): u64 {
    var p = skip_seps(tokens, p0)
    if is_kind_at(tokens, p, close) { return 0 }
    var n: u64 = 1
    var depth: u64 = 0
    loop {
        if p >= tokens.len { break }
        var k = kind_at(tokens, p)
        if depth == 0 && k == close { break }
        if depth == 0 && k == lexer::TokenKind::Comma { n++; p++; continue }
        if is_open_bracket(k) { depth++ }
        else if is_close_bracket(k) { if depth > 0 { depth = depth - 1 } }
        p++
    }
    n
}

/**
 * Counts the separator-delimited statements of a `{ ... }` block without allocating, so the caller
 * can pre-size the exact backing array before parsing. Scanning starts at the first statement and
 * stops at the block's own closing `}` at depth zero; nested bracket groups are skipped by depth.
 *
 * @param tokens  the token stream being parsed
 * @param p0      index of the first statement token (already past `{` and leading separators)
 * @return        the number of statements, zero for an empty block
 */
fn count_block_stmts(tokens: []lexer::Token, p0: u64): u64 {
    var p = skip_seps(tokens, p0)
    var n: u64 = 0
    var depth: u64 = 0
    loop {
        if p >= tokens.len { break }
        var k = kind_at(tokens, p)
        if depth == 0 && k == lexer::TokenKind::RBrace { break }
        if depth == 0 && is_sep(tokens, p) { p = skip_seps(tokens, p); continue }
        if depth == 0 { n++ }
        loop {
            if p >= tokens.len { break }
            var kk = kind_at(tokens, p)
            if depth == 0 && kk == lexer::TokenKind::RBrace { break }
            if depth == 0 && is_sep(tokens, p) { break }
            if is_open_bracket(kk) { depth++ }
            else if is_close_bracket(kk) { if depth > 0 { depth = depth - 1 } }
            p++
        }
    }
    n
}
