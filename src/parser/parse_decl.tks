// src/parser/parse_decl.tks   (namespace 'teko::parser')

use teko::lexer

/**
 * parse_discard_param — parse a `_` DISCARD parameter (owner refinement 2026-07-15): a parameter
 * that occupies the ABI slot but binds no name and allocates nothing. It carries NO type annotation
 * (`_`, never `_: T`) — its type is resolved BY POSITION from the interface/base signature the
 * function implements or overrides; the CHECKER both fills that type and enforces that a discard
 * parameter appears only in an implementing/overriding signature. Repetition (`x, _, _, p`) is
 * allowed: each `_` is a separate comma-separated token. Emitted as a Param named "_" — a name the
 * lexer can never produce for a real identifier, so the checker recognizes it unambiguously.
 *
 * @param tokens   the token stream
 * @param pos      the index of the `_` (Underscore) token
 * @param params   the parameters accumulated so far
 * @return         `params` with the discard Param appended, and the index just past the `_`
 * @throws         when a type annotation follows the `_` (`_: T` is invalid for a discard param)
 */
fn parse_discard_param(tokens: []lexer::Token, pos: u64, params: []Param): ParsedList<Param> | error {
    if is_kind_at(tokens, pos + 1, lexer::TokenKind::Colon) {
        return err_at(tokens, pos + 1, "a `_` discard parameter takes no type annotation — its type is fixed by position from the interface/base signature being implemented or overridden")
    }
    var out = teko::list::push(params, Param { name = "_"; has_type = false; type_ann = no_type(); is_params = false; has_default = false; default_expr = no_expr() })
    ParsedList<Param> { items = out; next = pos + 1 }
}

// `( name: T, name: T, … )` — comma-separated params; empty `()` allowed; params are
// immutable (B.21). `pos` is at `(`. (§4 §12.1) EVERY parameter is mandatorily typed
// (`name: type`): the bare/untyped receiver slot was RETIRED with the teach window — a method's
// receiver is the SYNTHETIC `self` the parser injects (see `inject_synthetic_receiver`), never a
// written parameter. A parameter literally named `self`, or any untyped first param, is an error.
fn parse_params(tokens: []lexer::Token, pos: u64): ParsedList<Param> | error {
    var p = pos + 1   // consume `(`
    var params: []Param = teko::list::empty()
    var seen_default = false   // DEFARGS (2026-07-01) — TRAILING-ONLY: once true, every later param must also default
    if is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return ParsedList<Param> { items = params; next = p + 1 }
    }
    loop {
        if is_kind_at(tokens, p, lexer::TokenKind::Underscore) {
            var dp = match parse_discard_param(tokens, p, params) { ParsedList<Param> as x => x; error as e => return e }
            params = dp.items
            p = dp.next
            if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
            p = p + 1
            continue
        }
        // `params` — a CONTEXTUAL variadic-parameter modifier (2026-07-01), like `from` in the
        // `extern` position: NOT a reserved word (295+ existing uses as a plain identifier/field
        // name across the corpus), so it only triggers when `params` is immediately followed by
        // ANOTHER name + `:` — i.e. `params pieces: []T`. A parameter *literally named* `params`
        // (`params: []T`, colon right after) is unaffected — ordinary parsing. Trailing-only:
        // rejected below if another param follows. Type must be a slice `[]T` (checked once parsed).
        var has_params_kw = is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "params" &&
        is_name_at(tokens, p + 1) && is_kind_at(tokens, p + 2, lexer::TokenKind::Colon)
        if has_params_kw { p = p + 1 }
        var has_ref_kw = is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "ref" &&
        is_name_at(tokens, p + 1) && is_kind_at(tokens, p + 2, lexer::TokenKind::Colon)
        if has_ref_kw { p = p + 1 }
        // (§4 D2/§12.1) `self` is a RESERVED keyword and the SYNTHETIC receiver — it can never be
        // written as a parameter (the loose/explicit receiver slot was retired with the teach
        // window). A `self` token here is an error; so is any untyped param (every param is `name: T`).
        if is_kind_at(tokens, p, lexer::TokenKind::SelfKw) {
            return err_at(tokens, p, "`self` is the synthetic receiver; it cannot name a parameter")
        }
        if !is_name_at(tokens, p) {
            return err_at(tokens, p, "expected a parameter name")
        }
        var name = tokens[p].text
        if !is_kind_at(tokens, p + 1, lexer::TokenKind::Colon) {
            return err_at(tokens, p + 1, "expected ':' after a parameter name")
        }
        var ty = match parse_type(tokens, p + 2) { ParsedType as x => x; error as e => return e }
        if has_params_kw {
            match ty.node { SliceType => { }; _ => return err_at(tokens, p + 2, "'params' parameter must have a slice type ([]T)") }
        }
        var param_ty = if has_ref_kw { wrap_ref_type(ty.node) } else { ty.node }
        // DEFARGS (2026-07-01) — `= <expr>` right after the type: a default value, evaluated at
        // the call site when the argument is omitted. TRAILING-ONLY (rule A): once ANY param
        // defaults, every param after it must ALSO default — `=` uses Assign, consistent with
        // struct-init `{f=v}` (not `:`, which is a type annotation).
        var ppos = ty.next
        var has_default = false
        var default_expr = no_expr()
        if is_kind_at(tokens, ppos, lexer::TokenKind::Assign) {
            var dv = match parse_expr(tokens, ppos + 1) { Parsed<Expr> as x => x; error as e => return e }
            has_default = true
            default_expr = dv.node
            ppos = dv.next
        } else if seen_default && !has_params_kw {
            return err_at(tokens, ppos, "a default-valued parameter must be followed only by other defaulted parameters (defaults are trailing-only)")
        }
        if has_default { seen_default = true }
        params = teko::list::push(params, Param { name = name; has_type = true; type_ann = param_ty; is_params = has_params_kw; has_default = has_default; default_expr = default_expr })
        p = ppos
        if has_params_kw && is_kind_at(tokens, p, lexer::TokenKind::Comma) {
            return err_at(tokens, p, "'params' must be the last parameter")
        }
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = p + 1   // consume `,`
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close the parameter list")
    }
    ParsedList<Param> { items = params; next = p + 1 }
}

// (W11/S6, 2026-07-01) `<T: A & B | C>` — a constraint ATOM: a bare nominal name (a
// variant/struct the type-param must nominally belong to). Never `?`/null/void (a
// constraint targets a concrete nominal type, matching the `<T?>` ban below).
fn parse_constraint_atom(tokens: []lexer::Token, pos: u64): Parsed<ConstraintExpr> | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Ident) {
        return err_at(tokens, pos, "expected a constraint name (a nominal variant/struct) in a type-parameter constraint")
    }
    var name = tokens[pos].text
    var p = pos + 1
    Parsed<ConstraintExpr> { node = ConstraintAtom { name = name }; next = p }
}
// `&`-term: one or more atoms joined by `&` (AND), left-associative.
fn parse_constraint_and(tokens: []lexer::Token, pos: u64): Parsed<ConstraintExpr> | error {
    var left = match parse_constraint_atom(tokens, pos) { Parsed<ConstraintExpr> as x => x; error as e => return e }
    loop {
        if !is_kind_at(tokens, left.next, lexer::TokenKind::Amp) { break }
        var right = match parse_constraint_atom(tokens, left.next + 1) { Parsed<ConstraintExpr> as x => x; error as e => return e }
        left = Parsed<ConstraintExpr> { node = ConstraintAnd { left = left.node; right = right.node }; next = right.next }
    }
    left
}
// `|`-chain over `&`-terms (so `&` binds tighter than `|`: `C1 & C2 | C3` = `(C1 & C2) | C3`),
// left-associative. This is a DEDICATED grammar (2 precedence levels, boolean semantics),
// distinct from parse_type's `|` (a type UNION) — reusing that grammar would conflate two
// different meanings of the same token under different AST targets.
fn parse_constraint_expr(tokens: []lexer::Token, pos: u64): Parsed<ConstraintExpr> | error {
    var left = match parse_constraint_and(tokens, pos) { Parsed<ConstraintExpr> as x => x; error as e => return e }
    loop {
        if !is_kind_at(tokens, left.next, lexer::TokenKind::Pipe) { break }
        var right = match parse_constraint_and(tokens, left.next + 1) { Parsed<ConstraintExpr> as x => x; error as e => return e }
        left = Parsed<ConstraintExpr> { node = ConstraintOr { left = left.node; right = right.node }; next = right.next }
    }
    left
}

// `[doc] [pub|exp] fn name(params): ret { body }` (B.21, B.29). Doc + visibility optional
// and precede `fn`; `-> ret` optional (absent = Unit). `pos` is at the doc, `pub`/`exp`, or `fn`.
// (S4) An OPTIONAL generic type-parameter list `<T, U, …>` after a fn/type NAME. `pos` is at the
// token AFTER the name. No `<` → empty list, pos unchanged. The decl-site `<` is UNAMBIGUOUS: the
// `fn`/`type` keyword already committed the parse to a decl, so it is never a comparison. A decl
// list never nests, so it closes with a single `>` (no `>>` split — that is parse_type_args' job).
// (W11/S6) each name may carry an OPTIONAL `: ConstraintExpr` — names/constraints stay PARALLEL
// (NoConstraint{} filling an unconstrained slot), so every downstream reader indexes both by i.
fn parse_type_params(tokens: []lexer::Token, pos: u64): ParsedTypeParams | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Lt) {
        return ParsedTypeParams { names = teko::list::empty(); constraints = teko::list::empty(); next = pos }
    }
    var p = pos + 1
    var names: []str = teko::list::empty()
    var constraints: []ConstraintExpr = teko::list::empty()
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
            return err_at(tokens, p, "expected a type-parameter name in '<…>'")
        }
        names = teko::list::push(names, tokens[p].text)
        p = p + 1
        if is_kind_at(tokens, p, lexer::TokenKind::Colon) {
            var c = match parse_constraint_expr(tokens, p + 1) { Parsed<ConstraintExpr> as x => x; error as e => return e }
            constraints = teko::list::push(constraints, c.node)
            p = c.next
        } else {
            constraints = teko::list::push(constraints, NoConstraint { })
        }
        if is_kind_at(tokens, p, lexer::TokenKind::Comma) { p = p + 1 }
        else if is_kind_at(tokens, p, lexer::TokenKind::Gt) { p = p + 1; break }
        else { return err_at(tokens, p, "expected ',' or '>' in a type-parameter list") }
    }
    ParsedTypeParams { names = names; constraints = constraints; next = p }
}

/**
 * Does token `pos` hold the RETIRED `unsafe` declaration keyword?
 *
 * `unsafe` was retired by §6 of the 0.3.1 surface migration: the parser detects it in the
 * `type`/`fn` modifier slot only to REJECT it with the retirement diagnostic (there is no unsafe
 * surface left to mark). It remains lexically a plain `Ident` (never a reserved keyword), so a
 * `::`-path segment named `unsafe` is unaffected — the rejection fires only in the modifier slot.
 *
 * @param []lexer::Token tokens  the full token stream
 * @param u64 pos  the position to test
 * @return bool  true iff `tokens[pos]` is the retired `unsafe` keyword in a modifier slot
 */
fn is_unsafe_modifier_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "unsafe"
}

/**
 * consume_static_modifier — consume the keyword `static` (§4 D3) that marks a method as a member of
 * the TYPE (no receiver), in the method modifier chain. Significant only inside a type body; parsed
 * universally (inert at the top level, like pub/exp/intern). During the §4 teach window the value is
 * carried into `Function.is_static` but is NOT authoritative — the checker's static-vs-instance
 * detector still keys off the receiver's param shape.
 * @param tokens  the token stream
 * @param pos     the index at the (possible) `static` keyword
 * @return        Parsed<bool> — whether `static` was present, and the index just after it
 */
fn consume_static_modifier(tokens: []lexer::Token, pos: u64): Parsed<bool> {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Static) { return Parsed<bool> { node = false; next = pos } }
    Parsed<bool> { node = true; next = pos + 1 }
}

/**
 * inject_synthetic_receiver — prepend the synthetic receiver `self` (param[0], has_type=false; the
 * type is injected by the checker as the enclosing type) to a method's user-written params. This is
 * the single point where the §4 synthetic receiver is born; every downstream consumer
 * (receiver_canonical_name / method_func_type / the `is_instance = !params[0].has_type` detector) reads
 * it unchanged. Called only for an INSTANCE method (non-`static`) that did NOT write an explicit
 * receiver — during the §4 teach window every instance method still writes `self` explicitly, so the
 * caller's guard never fires and this stays a behavioral no-op.
 * @param params  the params WRITTEN by the user (no receiver)
 * @return        params with the synthetic `self` at index 0
 */
fn inject_synthetic_receiver(params: []Param): []Param {
    var out: []Param = teko::list::empty()
    out = teko::list::push(out, Param { name = "self"; has_type = false; type_ann = no_type(); is_params = false; has_default = false; default_expr = no_expr() })
    var i = 0 to u64
    loop {
        if i >= params.len { break }
        out = teko::list::push(out, params[i])
        i = i + 1
    }
    out
}

// `is_type_method` (§4 §12.1) — true ONLY for a type-body member (struct/class/trait/interface):
// a NON-`static` one gets the SYNTHETIC `self` receiver injected. A top-level `fn` passes false.
// `allow_bodyless` (W10b.IF) — true ONLY for an INTERFACE method: a pure signature `fn sig(): T`
// with NO body (the interface is a contract). Mirrors the `abstract fn` bodyless path; every other
// caller passes false.
/**
 * Consume the OPTIONAL `("c_name")` reverse-FFI symbol override that may follow an `exp` visibility
 * marker on a function (FFI-D, reverse-FFI export). The override names the exact C symbol the `exp`
 * function is emitted under in an `abi="c"` artifact, mirroring the `= "SYM"` an `extern` import uses;
 * absent, the codegen flattens the canonical name (`ns::fn` → `ns_fn`) instead. A `(` that opens the
 * override MUST wrap a single quoted string and close with `)`.
 *
 * @param tokens  the full token stream
 * @param pos     the index immediately past the consumed `exp` keyword
 * @return        the override symbol (empty string when no `(` follows) and the index past it
 * @throws        when a `(` opens but is not a single quoted string closed by `)`
 * @since 0.3.0.30 (FFI base — reverse-FFI export)
 */
fn parse_export_override(tokens: []lexer::Token, pos: u64): Parsed<str> | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::LParen) { return Parsed<str> { node = ""; next = pos } }
    var p = pos + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
        return err_at(tokens, p, "expected a quoted C symbol inside `exp(\"…\")`")
    }
    var sym = tokens[p].text
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected `)` to close the `exp(\"…\")` export-symbol override")
    }
    Parsed<str> { node = sym; next = p + 1 }
}

/**
 * Advance the `parse_decl` keyword-search cursor past an OPTIONAL `("c_name")` reverse-FFI export
 * override that may follow an `exp` marker, so the following `fn`/`type`/`flags`/`const` search lands on
 * the real keyword (FFI-D). This is a lightweight peek only — `parse_function` re-parses (and validates)
 * the override from the declaration's true start.
 *
 * @param tokens  the full token stream
 * @param pos     the index immediately past the consumed `exp` keyword
 * @return        the index past a `("STR")` override group, or `pos` unchanged when none follows
 * @since 0.3.0.30 (FFI base — reverse-FFI export)
 */
fn skip_export_override_peek(tokens: []lexer::Token, pos: u64): u64 {
    if !is_kind_at(tokens, pos, lexer::TokenKind::LParen) { return pos }
    var k = pos + 1
    if is_kind_at(tokens, k, lexer::TokenKind::Str) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::RParen) { k = k + 1 }
    k
}

/**
 * Is the token at `pos` the start of a function/closure return-type annotation
 * (docs/design/mudancas-superficie-0.3.1.md §2)? The return type uses `:` — the SAME operator
 * `x: T` uses to annotate a variable's type. The retired `->` grafia no longer parses (its `Arrow`
 * token was removed from the lexer in the sweep).
 *
 * @param tokens  the full token stream
 * @param pos     the index just past the parameter list's closing `)`
 * @return        true when `pos` opens a return-type annotation (`:`)
 * @since 0.3.1 (`->` → `:` return-type migration, swept)
 */
fn is_return_type_intro_at(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Colon)
}

/**
 * parse_multi_return_types — parse a MULTIPLE-return signature `( A, B, … )` (§9 F, ruling 3). `pos`
 * is at the `(` immediately after the return-type `:`. At least TWO types are required — a single
 * `( A )` is rejected (write `A`). The `( )` are recognized ONLY in this return-type position, so the
 * multi-valuation never enters the general type grammar: there is no first-class tuple type.
 *
 * @param tokens  the token stream
 * @param pos     the `(` token position
 * @return        the parsed return-type list (length ≥ 2) and the index past `)`, or a parse error
 * @throws        on a single-type `( A )`, an empty `( )`, a missing `,`/`)`, or a malformed type
 * @since §9 F
 */
fn parse_multi_return_types(tokens: []lexer::Token, pos: u64): ParsedList<TypeExpr> | error {
    var p = skip_seps(tokens, pos + 1)
    if is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "a multiple-return signature `( A, B )` needs at least two types")
    }
    var types: []TypeExpr = teko::list::empty()
    loop {
        var t = match parse_type(tokens, p) { ParsedType as x => x; error as e => return e }
        types = teko::list::push(types, t.node)
        p = skip_seps(tokens, t.next)
        if !is_kind_at(tokens, p, lexer::TokenKind::Comma) { break }
        p = skip_seps(tokens, p + 1)
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::RParen) {
        return err_at(tokens, p, "expected ')' to close a multiple-return signature")
    }
    if types.len < 2 {
        return err_at(tokens, pos, "a multiple-return signature `( A, B )` needs at least two types — for a single return type write `A`, not `( A )`")
    }
    ParsedList<TypeExpr> { items = types; next = p + 1 }
}

/**
 * Parse a `fn` declaration's signature + body, from an optional leading doc-comment through the
 * closing `}` (or the bodyless/`extern` forms). Shared by the top-level `fn` position (real
 * `is_test`/`os_guard`/`has_arena_size`/`arena_size` attributes threaded in from
 * `parse_decl_attributes`) and every struct/class METHOD call site (`is_type_method = true`,
 * always `is_test = false`, `os_guard = ""`, `has_arena_size = false`, `arena_size = 0` — methods
 * do not go through the attribute collector in this crumb).
 *
 * @param tokens          the full token stream
 * @param pos             the index of the leading doc-comment/modifier/`fn` keyword
 * @param is_test         a `#test` attribute precedes it? (top-level only)
 * @param os_guard        a `#os("…")` conditional-compile guard ("" = all OSes; top-level only)
 * @param is_type_method  true for a struct/class/trait/interface member (§4 §12.1): a NON-`static`
 *                        one gets the SYNTHETIC `self` receiver injected; a top-level `fn` (false)
 *                        never does. The receiver is never written — an explicit one is a parse error.
 * @param allow_bodyless  true where a signature-only `fn` (no `{ … }`) is legal (interface method)
 * @param has_arena_size  a `#arena_size(N)` directive precedes it? (#453, top-level only)
 * @param arena_size      the directive's byte count (valid iff `has_arena_size`)
 * @return                the parsed `Function` declaration + the resume index
 * @throws                a malformed signature/body, or `#arena_size`/`#test` before `extern`
 */
fn parse_function(tokens: []lexer::Token, pos: u64, is_test: bool, os_guard: str, is_type_method: bool, allow_bodyless: bool, has_arena_size: bool, arena_size: u64): Parsed<Decl> | error {
    var p = pos
    var has_doc = false
    var doc = ""
    // (#111) an own-line doc comment attaches to the NEXT declaration: skip the significant
    // newline(s) between the `/** … */` and the modifiers/keyword that follow it. Same-line
    // placement (no newline in between) is unaffected — skip_seps is a no-op there.
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = tokens[p].text
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private   // default: own-namespace only
    var export_c_symbol = ""
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
        var ov = match parse_export_override(tokens, p) { Parsed<str> as x => x; error as e => return e }
        export_c_symbol = ov.node
        p = ov.next
    }
    // (W10b.CLASS, 2026-07-01) `intern` widens reach to "also visible to inheritors" — combines
    // WITH the vis above, not a 4th tier; meaningful only inside a class body, but parsed
    // universally (harmless elsewhere, matching how `pub`/`exp` parse even where meaningless).
    var is_intern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Intern) {
        is_intern = true
        p = p + 1
    }
    // Method modifiers — meaningful only inside a class body (inheritance, W10b.CLASS increment
    // 2+); parsed universally here so a top-level `fn` grammar never needs to special-case them.
    var is_abstract = false
    var is_virtual = false
    var is_override = false
    if is_kind_at(tokens, p, lexer::TokenKind::Abstract) { is_abstract = true; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Virtual) { is_virtual = true; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Override) { is_override = true; p = p + 1 }
    // (§4 D3) `static fn` — marks an in-body member of the TYPE (no receiver). Parsed universally
    // in the modifier chain (inert at top level, like the class modifiers above); significant only
    // inside a type body. During the §4 teach window the checker still keys static-vs-instance off
    // the receiver's param shape, so this flag is carried but not yet authoritative.
    var static_mod = consume_static_modifier(tokens, p)
    var is_static = static_mod.node
    p = static_mod.next
    var is_extern = false   // C7.1a: `extern fn …` (foreign, no body)
    if is_kind_at(tokens, p, lexer::TokenKind::Extern) {
        is_extern = true
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Fn) {
        return err_at(tokens, p, "expected `fn`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a function name")
    }
    var name = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col   // W-loc-2: the fn's source position
    p = p + 1
    var tps = match parse_type_params(tokens, p) { ParsedTypeParams as x => x; error as e => return e }   // (S4/W11) `<T, U: A & B, …>`
    p = tps.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the parameter list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    // (§4 §12.1) An INSTANCE method (a type-body member, `is_type_method`, NOT `static`) ALWAYS gets
    // the synthetic `self` at param[0] — the receiver is never written (parse_params rejects an
    // explicit one), so it is injected unconditionally here. The static-vs-instance split lives ONLY
    // in the parser: a `static fn` gets no injection; every other type-body method does. The checker's
    // detector (`is_instance = params.len>0 && !params[0].has_type`) reads the injected receiver.
    if is_type_method && !is_static {
        params = ParsedList<Param> { items = inject_synthetic_receiver(params.items); next = params.next }
    }
    var has_return = false
    var return_type = no_type()
    var ret_types: []TypeExpr = teko::list::empty()
    if is_return_type_intro_at(tokens, p) {
        if is_kind_at(tokens, p + 1, lexer::TokenKind::LParen) {
            var mr = match parse_multi_return_types(tokens, p + 1) { ParsedList<TypeExpr> as x => x; error as e => return e }
            ret_types = mr.items
            has_return = true
            return_type = ret_types[0]
            p = mr.next
        } else {
            var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
            has_return = true
            return_type = ret.node
            p = ret.next
        }
    }
    if is_extern {
        if ret_types.len > 0 { return err_at(tokens, p, "an `extern` function may not declare a multiple-return `( A, B )` signature") }
        if is_test { return err_at(tokens, p, "`#test` may not precede `extern`") }
        if has_arena_size { return err_at(tokens, p, "`#arena_size(…)` may not precede `extern` (there is no Teko body to size)") }
        if export_c_symbol != "" { return err_at(tokens, p, "an `extern` (imported) function may not carry an `exp(\"…\")` export override") }
        if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
            return err_at(tokens, p, "expected `= \"symbol\"` to bind the C symbol of an `extern` function")
        }
        p = p + 1
        if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
            return err_at(tokens, p, "expected a quoted C symbol after `=` in an `extern` function")
        }
        var c_symbol = tokens[p].text
        p = p + 1
        var from_lib = ""   // "" = implicit libc (C7.1a, macOS)
        // `from` is CONTEXTUAL (not a reserved word — the corpus uses it as an identifier), so
        // match it as a plain Ident in the extern position.
        if is_kind_at(tokens, p, lexer::TokenKind::Ident) && tokens[p].text == "from" {
            p = p + 1
            if !is_kind_at(tokens, p, lexer::TokenKind::Str) {
                return err_at(tokens, p, "expected a quoted library name after `from`")
            }
            from_lib = tokens[p].text
            p = p + 1
        }
        var no_body: []Statement = teko::list::empty()
        return Parsed<Decl> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = no_body; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = true; c_symbol = c_symbol; from_lib = from_lib; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty(); is_operator = false }; next = p }
    }
    // (W10b.CLASS increment 2) `abstract fn …` — a SIGNATURE ONLY, no body (abstract classes only;
    // enforced by the checker, not the parser). A bare `;`/newline/`}` follows instead of `{`.
    if (is_abstract || allow_bodyless) && !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        if has_arena_size { return err_at(tokens, p, "`#arena_size(…)` may not precede an `abstract fn` (there is no Teko body to size)") }
        if ret_types.len > 0 { return err_at(tokens, p, "a bodyless (`abstract`/interface) function may not declare a multiple-return `( A, B )` signature yet") }
        var no_body: []Statement = teko::list::empty()
        return Parsed<Decl> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = no_body; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = false; c_symbol = export_c_symbol; from_lib = ""; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty(); is_operator = false }; next = p }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the function body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<Statement> as x => x; error as e => return e }
    Parsed<Decl> { node = Function { name = name; type_params = tps.names; type_constraints = tps.constraints; params = params.items; has_return = has_return; return_type = return_type; body = blk.items; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col; is_test = is_test; is_extern = false; c_symbol = export_c_symbol; from_lib = ""; os_guard = os_guard; is_intern = is_intern; is_abstract = is_abstract; is_virtual = is_virtual; is_override = is_override; is_static = is_static; is_getter = false; is_setter = false; accessor_prop = ""; has_arena_size = has_arena_size; arena_size = arena_size; ret_types = ret_types; is_operator = false }; next = blk.next }
}

/**
 * accessor_kind_at — is the member at `pos` a property accessor, and which? Returns 1 for a getter
 * (`get <name>(`), 2 for a setter (`set <name>(`), 0 for neither. CONTEXTUAL, exactly like
 * `operator`/`trait`: `get`/`set` are ordinary identifiers everywhere and only start an accessor
 * when `Ident("get")`/`Ident("set")` is immediately followed by a NAME and a `(` (past an optional
 * leading doc and a `pub`/`exp`/`intern` visibility run — the same prefix `class_item_is_method`
 * skips). Never reserve `get`/`set`: they name real members across the corpus, so a `get: T` field
 * or an `fn get(…)` method still routes to its historic branch and this returns 0.
 *
 * @param tokens  the token stream
 * @param pos     the member's first token (leading doc/visibility allowed)
 * @return        1 = getter, 2 = setter, 0 = not an accessor
 * @since §9 properties
 */
fn accessor_kind_at(tokens: []lexer::Token, pos: u64): u64 {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Intern) { k = k + 1 }
    if !is_kind_at(tokens, k, lexer::TokenKind::Ident) { return 0 to u64 }
    var word = tokens[k].text
    if word != "get" && word != "set" { return 0 to u64 }
    if !is_name_at(tokens, k + 1) { return 0 to u64 }
    if !is_kind_at(tokens, k + 2, lexer::TokenKind::LParen) { return 0 to u64 }
    if word == "get" { return 1 to u64 }
    2 to u64
}

/**
 * parse_accessor — parse a property accessor member `[pub|exp|intern] (get|set) <prop> ( … ) [: T]
 * [{ … }]` into a `Function` flagged `is_getter`/`is_setter` with `accessor_prop = <prop>` and a
 * SYNTHETIC dispatch name (`__get_<prop>` / `__set_<prop>`). `allow_bodyless` is true in an
 * interface body (a bodyless contract accessor) and false in a struct/class body (a real accessor
 * body is required). The receiver `self` is ALWAYS injected (accessors are instance members); an
 * explicit `self` never appears — the property name follows the `get`/`set` word directly.
 *
 * Shape rules (post-parse, precise diagnostics):
 *   - getter: ZERO user parameters (only the injected `self`) and a return type `: T` REQUIRED.
 *   - setter: exactly ONE typed user parameter (the value) and NO return type.
 *
 * @param tokens          the token stream
 * @param pos             the accessor's first token (leading doc/visibility allowed)
 * @param allow_bodyless  true in an interface body, false in a struct/class body
 * @return                the parsed accessor `Function` + the resume index
 * @throws                on a malformed accessor shape or a missing/forbidden body
 * @since §9 properties
 */
fn parse_accessor(tokens: []lexer::Token, pos: u64, allow_bodyless: bool): Parsed<Decl> | error {
    var p = pos
    var has_doc = false
    var doc = ""
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = tokens[p].text
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) { vis = Visibility::Pub; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Exp) { vis = Visibility::Exp; p = p + 1 }
    var is_intern = false
    if is_kind_at(tokens, p, lexer::TokenKind::Intern) { is_intern = true; p = p + 1 }
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected `get` or `set` to open a property accessor")
    }
    var word = tokens[p].text
    var is_getter = word == "get"
    var is_setter = word == "set"
    if !is_getter && !is_setter {
        return err_at(tokens, p, "expected `get` or `set` to open a property accessor")
    }
    p = p + 1
    if !is_name_at(tokens, p) {
        return err_at(tokens, p, "expected a property name after `get`/`set`")
    }
    var prop = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LParen) {
        return err_at(tokens, p, "expected '(' for the accessor parameter list")
    }
    var params = match parse_params(tokens, p) { ParsedList<Param> as x => x; error as e => return e }
    p = params.next
    if is_getter && params.items.len != 0 {
        return err_at(tokens, p, "a getter takes no parameters — write `get " ~ prop ~ "(): T`")
    }
    if is_setter && params.items.len != 1 {
        return err_at(tokens, p, "a setter takes exactly one value parameter — write `set " ~ prop ~ "(value: T)`")
    }
    if is_setter && !params.items[0].has_type {
        return err_at(tokens, p, "a setter's value parameter must declare a type — write `set " ~ prop ~ "(value: T)`")
    }
    var injected = inject_synthetic_receiver(params.items)
    var has_return = false
    var return_type = no_type()
    if is_return_type_intro_at(tokens, p) {
        var ret = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
        has_return = true
        return_type = ret.node
        p = ret.next
    }
    if is_getter && !has_return {
        return err_at(tokens, p, "a getter must declare a return type — write `get " ~ prop ~ "(): T`")
    }
    if is_setter && has_return {
        return err_at(tokens, p, "a setter returns nothing — drop the `: T` after `set " ~ prop ~ "(value: T)`")
    }
    var sym = (if is_getter { "__get_" } else { "__set_" }) ~ prop
    var body: []Statement = teko::list::empty()
    if allow_bodyless && !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return Parsed<Decl> { node = accessor_function(sym, injected, has_return, return_type, body, vis, has_doc, doc, name_line, name_col, is_intern, is_getter, is_setter, prop); next = p }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the accessor body")
    }
    var blk = match parse_block(tokens, p) { ParsedList<Statement> as x => x; error as e => return e }
    Parsed<Decl> { node = accessor_function(sym, injected, has_return, return_type, blk.items, vis, has_doc, doc, name_line, name_col, is_intern, is_getter, is_setter, prop); next = blk.next }
}

/**
 * accessor_function — assemble the `Function` node for a parsed property accessor (§9 properties).
 * The `name` is the SYNTHETIC dispatch symbol (`__get_<prop>`/`__set_<prop>`) so the accessor reuses
 * every method mechanism (registration, conformance-by-name, vtable slot, dispatch, mangling); the
 * human property name rides on `accessor_prop` for diagnostics and the use-site registry.
 *
 * @param sym          the synthetic method name (`__get_<prop>` / `__set_<prop>`)
 * @param params       the parameter list WITH the injected `self` receiver
 * @param has_return   the getter's return-type presence (always false for a setter)
 * @param return_type  the getter's return type (Unit for a setter)
 * @param body         the accessor body statements (empty for a bodyless interface accessor)
 * @param vis          the accessor's visibility
 * @param has_doc      a leading doc-comment was peeled?
 * @param doc          the doc span (valid iff has_doc)
 * @param line         the property name's 1-based source line
 * @param col          the property name's 1-based source column
 * @param is_intern    the `intern` reach widener was present?
 * @param is_getter    this accessor is a getter?
 * @param is_setter    this accessor is a setter?
 * @param prop         the human-facing property name
 * @return             the assembled accessor Function
 * @since §9 properties
 */
fn accessor_function(sym: str, params: []Param, has_return: bool, return_type: TypeExpr, body: []Statement, vis: Visibility, has_doc: bool, doc: str, line: u32, col: u32, is_intern: bool, is_getter: bool, is_setter: bool, prop: str): Function {
    Function {
        name = sym; type_params = teko::list::empty(); type_constraints = teko::list::empty()
        params = params; has_return = has_return; return_type = return_type; body = body
        vis = vis; has_doc = has_doc; doc = doc; line = line; col = col
        is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; os_guard = ""
        is_intern = is_intern; is_abstract = false; is_virtual = false; is_override = false; is_static = false
        is_getter = is_getter; is_setter = is_setter; accessor_prop = prop
        has_arena_size = false; arena_size = 0 to u64; ret_types = teko::list::empty()
        is_operator = false
    }
}

/**
 * parse_member_fn_or_accessor — parse ONE type-body member that `*_item_is_method` has already
 * classified as a method-shaped member: either a property accessor (`get`/`set`, contextual — §9
 * properties) or an ordinary `fn` method. Routing is the sole new behaviour; a non-accessor member
 * takes the historic `parse_function` path unchanged, so the corpus (which holds no accessor)
 * reproduces byte-for-byte.
 *
 * @param tokens          the token stream
 * @param pos             the member's first token (leading doc/visibility allowed)
 * @param allow_bodyless  true in an interface/trait body (a bodyless contract member is legal),
 *                        false in a struct/class body (a real body is required)
 * @return                the parsed member `Function` (as a `Decl`) + the resume index
 * @throws                on a malformed accessor or `fn` member
 * @since §9 properties
 */
fn parse_member_fn_or_accessor(tokens: []lexer::Token, pos: u64, allow_bodyless: bool): Parsed<Decl> | error {
    if accessor_kind_at(tokens, pos) != 0 to u64 {
        return parse_accessor(tokens, pos, allow_bodyless)
    }
    parse_function(tokens, pos, false, "", true, allow_bodyless, false, 0 to u64)
}

// `{ name: T; name: T; … }` — field list; `;`/newline separates; empty `{ }` allowed;
// trailing separator allowed. `pos` is at `{`. (Inside `{}` → `;`/newline, B.17.)
// (OOP A1, 2026-07-01) A struct body's items are INTERLEAVED fields and methods (unified
// method model): `type S = struct { s: str; fn a(self): str { self.s } ; fn b() {} }`.
// An item starting with `fn` (optionally preceded by a doc comment / `pub`/`exp`) is a METHOD,
// parsed via `parse_function` with `is_type_method = true`; anything else is a plain field
// (`name: type`), exactly as before. Struct members (fields + methods) stay ALL PUBLIC per
// W10b.0.A — a method's `pub`/`exp` marker is accepted (parses) but carries no extra reach
// beyond the struct's own visibility (the checker does not special-case it further here).
fn struct_item_is_method(tokens: []lexer::Token, pos: u64): bool {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }   // (#111) own-line doc
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Static) { k = k + 1 }   // (§4 D3) `static fn` factory in a struct body
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) { return true }
    accessor_kind_at(tokens, pos) != 0 to u64
}
/**
 * skip_field_inline_attr — consume an optional leading `#inline` layout attribute at a struct/class
 * FIELD position (C4's NEW field parse site), returning the index of the field name that follows. A
 * `#` that does not name `inline` is a precise error — `#inline` is the only field attribute.
 *
 * NOTE (bounded C4 divergence, reported to the integrator): the parsed `#inline` flag is not yet
 * persisted onto the `Field` AST nor honored by codegen — the end-to-end layout flip is a flagged
 * remainder (see the C4 report). The parse site + `inline_attr_eligible` validator land in C4.
 *
 * @param tokens  the token stream
 * @param pos     the index at the (possible) leading `#`
 * @return        the index past a consumed `#inline` (or `pos` unchanged when absent), or an error
 * @throws        when a `#` at `pos` is not `#inline`
 * @since 0.3.0.30 (null-union C4)
 */
fn skip_field_inline_attr(tokens: []lexer::Token, pos: u64): u64 | error {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Hash) { return pos }
    if !is_kind_at(tokens, pos + 1, lexer::TokenKind::Ident) || tokens[pos + 1].text != "inline" {
        return err_at(tokens, pos + 1, "the only field attribute is `#inline`")
    }
    skip_seps(tokens, pos + 2)
}

fn parse_fields(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)   // consume `{`, skip leading separators
    var fields: []Field = teko::list::empty()
    var methods: []Function = teko::list::empty()
    var consts: []ConstDecl = teko::list::empty()
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if struct_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, false) { Parsed<Decl> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a struct method must parse to a Function") }
            methods = teko::list::push(methods, mf)
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                var fstart = match skip_field_inline_attr(tokens, fdoc.next) { u64 as x => x; error as e => return e }
                if !is_name_at(tokens, fstart) {
                    return err_at(tokens, fstart, "expected a field name, a method (`fn …`), or a `const` member")
                }
                var name = tokens[fstart].text
                if !is_kind_at(tokens, fstart + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fstart + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fstart + 2) { ParsedType as x => x; error as e => return e }
                fields = teko::list::push(fields, Field { name = name; type_ann = ty.node; vis = Visibility::Pub; is_intern = false; has_doc = fdoc.has_doc; doc = fdoc.doc })
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a struct member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }   // trailing separator
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

// (W10b.CLASS) is the member at `pos` a method (`fn …`, past any doc/vis/intern/dispatch
// modifiers) or a field? Mirrors `struct_item_is_method`'s lookahead, plus the class-only
// `intern`/`abstract`/`virtual`/`override` modifiers `parse_function` itself now consumes.
fn class_item_is_method(tokens: []lexer::Token, pos: u64): bool {
    var k = pos
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }   // (#111) own-line doc
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Intern) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Abstract) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Virtual) { k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Override) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Static) { k = k + 1 }   // (§4 D3) `static fn` member of the type
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) { return true }
    accessor_kind_at(tokens, pos) != 0 to u64
}

// `{ [pub|exp]? [intern]? name: T; … }` interleaved with methods (`parse_function`,
// `is_type_method = true`) — a class body's member list. Unlike a struct, a bare field
// defaults to Visibility::Private (encapsulation is the class default; `pub`/`intern` widen).
fn parse_class_fields(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)   // consume `{`, skip leading separators
    var fields: []Field = teko::list::empty()
    var methods: []Function = teko::list::empty()
    var consts: []ConstDecl = teko::list::empty()
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if class_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, false) { Parsed<Decl> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a class method must parse to a Function") }
            methods = teko::list::push(methods, mf)
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                var fp = match skip_field_inline_attr(tokens, fdoc.next) { u64 as x => x; error as e => return e }
                var fvis = Visibility::Private
                if is_kind_at(tokens, fp, lexer::TokenKind::Pub) { fvis = Visibility::Pub; fp = fp + 1 }
                else if is_kind_at(tokens, fp, lexer::TokenKind::Exp) { fvis = Visibility::Exp; fp = fp + 1 }
                var fintern = false
                if is_kind_at(tokens, fp, lexer::TokenKind::Intern) { fintern = true; fp = fp + 1 }
                if !is_name_at(tokens, fp) {
                    return err_at(tokens, fp, "expected a field name, a method (`fn …`), or a `const` member")
                }
                var name = tokens[fp].text
                if !is_kind_at(tokens, fp + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fp + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fp + 2) { ParsedType as x => x; error as e => return e }
                fields = teko::list::push(fields, Field { name = name; type_ann = ty.node; vis = fvis; is_intern = fintern; has_doc = fdoc.has_doc; doc = fdoc.doc })
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a class member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }   // trailing separator
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

// `[abstract|virtual] class [Base[(binding)]] [& I1 & I2 …] { members }`. `pos` is at
// `abstract`/`virtual`/`class` (the caller has already dispatched on one of these).
// SEALED (no modifier) is Teko's default class kind (final + instantiable) — see ClassKind's doc.
fn parse_class_body(tokens: []lexer::Token, pos: u64): Parsed<TypeBody> | error {
    var p = pos
    var kind = ClassKind::Sealed
    if is_kind_at(tokens, p, lexer::TokenKind::Abstract) { kind = ClassKind::Abstract; p = p + 1 }
    else if is_kind_at(tokens, p, lexer::TokenKind::Virtual) { kind = ClassKind::Virtual; p = p + 1 }
    if is_kind_at(tokens, p, lexer::TokenKind::Service) {
        return err_at(tokens, p, "a service is always sealed; write 'type N = service <lifetime> { … }' (no 'virtual'/'abstract')")
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Class) {
        return err_at(tokens, p, "expected `class`")
    }
    p = p + 1
    var has_base = false
    var base_name = ""
    // (§4 G) `has_base_binding`/`base_binding_name` are VESTIGIAL ClassBody fields (always
    // false/"") kept only so the `.tkb` serialization format is untouched — the parser no longer
    // PRODUCES a named base-binding. Super is reached SOLELY through the `base` keyword; the physical
    // removal of these two fields is a W15 pass after §4.
    var has_base_binding = false
    var base_binding_name = ""
    if is_name_at(tokens, p) {
        has_base = true
        base_name = tokens[p].text
        p = p + 1
        if is_kind_at(tokens, p, lexer::TokenKind::LParen) {
            return err_at(tokens, p, "super is accessed via `base`, not a named binding — write `class Base { … }`, not `class Base(name)`")
        }
    }
    var implements: []str = teko::list::empty()
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
        if !is_name_at(tokens, p + 1) {
            return err_at(tokens, p + 1, "expected an interface name after '&'")
        }
        implements = teko::list::push(implements, tokens[p + 1].text)
        p = p + 2
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the class body")
    }
    var fs = match parse_class_fields(tokens, p) { ParsedStructBody as x => x; error as e => return e }
    Parsed<TypeBody> { node = ClassBody {
            kind = kind; has_base = has_base; base_name = base_name
            has_base_binding = has_base_binding; base_binding_name = base_binding_name
            implements = implements; fields = fs.fields; methods = fs.methods; consts = fs.consts
            is_service = false; service_lifetime = ServiceLifetime::Singleton
        }; next = fs.next }
}

/**
 * Parse the lifetime modifier that follows `service` (§7 DI). Contextual, like `params`/`trait`:
 * `singleton`/`scoped`/`transient` are ordinary identifiers everywhere else and only mean a lifetime
 * in the slot immediately after `service`. A missing/unknown lifetime is a clean parse error.
 *
 * @param tokens  the token stream
 * @param pos     the position of the lifetime word (one past `service`)
 * @return        the parsed ServiceLifetime and the resume position
 * @throws        when the token is not one of `singleton`/`scoped`/`transient`
 */
fn parse_service_lifetime(tokens: []lexer::Token, pos: u64): Parsed<ServiceLifetime> | error {
    if is_name_at(tokens, pos) && tokens[pos].text == "singleton" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Singleton; next = pos + 1 }
    }
    if is_name_at(tokens, pos) && tokens[pos].text == "scoped" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Scoped; next = pos + 1 }
    }
    if is_name_at(tokens, pos) && tokens[pos].text == "transient" {
        return Parsed<ServiceLifetime> { node = ServiceLifetime::Transient; next = pos + 1 }
    }
    err_at(tokens, pos, "expected a service lifetime `singleton`/`scoped`/`transient` after `service`")
}

/**
 * Parse a `service <lifetime> [& I1 & I2 …] { members }` body (§7 DI). `pos` is at `service`. A
 * service is a SEALED class (never `virtual`/`abstract`) carrying an arena lifetime; it reuses the
 * ClassBody node marked `is_service`. The `& I` list (each an interface it implements) and the member
 * body follow the class shape; the factory `static ctor(): self` (the IService contract) lives among
 * the members.
 *
 * @param tokens  the token stream
 * @param pos     the position of the `service` keyword
 * @return        the parsed ClassBody (is_service = true) and the resume position
 * @throws        when the lifetime, interface list, or `{ … }` body is malformed
 */
fn parse_service_body(tokens: []lexer::Token, pos: u64): Parsed<TypeBody> | error {
    var lt = match parse_service_lifetime(tokens, pos + 1) { Parsed<ServiceLifetime> as x => x; error as e => return e }
    var p = lt.next
    var implements: []str = teko::list::empty()
    loop {
        if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
        if !is_name_at(tokens, p + 1) {
            return err_at(tokens, p + 1, "expected an interface name after '&'")
        }
        implements = teko::list::push(implements, tokens[p + 1].text)
        p = p + 2
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the service body")
    }
    var fs = match parse_class_fields(tokens, p) { ParsedStructBody as x => x; error as e => return e }
    Parsed<TypeBody> { node = ClassBody {
            kind = ClassKind::Sealed; has_base = false; base_name = ""
            has_base_binding = false; base_binding_name = ""
            implements = implements; fields = fs.fields; methods = fs.methods; consts = fs.consts
            is_service = true; service_lifetime = lt.node
        }; next = fs.next }
}

// (W10b.IF) parse a `Name [& Name …]` list where the FIRST name has NO leading `&` (interface
// extends / struct implements — a flat list of interface names). Returns the names + the resume pos.
fn parse_amp_name_list(tokens: []lexer::Token, pos: u64): ParsedList<str> | error {
    var p = pos
    var names: []str = teko::list::empty()
    if is_name_at(tokens, p) {
        names = teko::list::push(names, tokens[p].text)
        p = p + 1
        loop {
            if !is_kind_at(tokens, p, lexer::TokenKind::Amp) { break }
            if !is_name_at(tokens, p + 1) { return err_at(tokens, p + 1, "expected an interface name after '&'") }
            names = teko::list::push(names, tokens[p + 1].text)
            p = p + 2
        }
    }
    ParsedList<str> { items = names; next = p }
}

// (W10b.IF) `interface [I1 & I2 …] { fn sig(self): T; … }`. `pos` is at `interface`. The `I1 & I2`
// extends list (multiple inheritance) sits between `interface` and `{`; each member is a BODYLESS
// method signature (parse_function is_type_method=true, allow_bodyless=true) — no fields, no bodies.
fn parse_interface_body(tokens: []lexer::Token, pos: u64): Parsed<TypeBody> | error {
    var ext_start = pos + 1
    if is_kind_at(tokens, ext_start, lexer::TokenKind::Amp) { ext_start = ext_start + 1 }
    var ext = match parse_amp_name_list(tokens, ext_start) { ParsedList<str> as x => x; error as e => return e }
    var p = ext.next
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' for the interface body")
    }
    p = skip_seps(tokens, p + 1)
    var methods: []Function = teko::list::empty()
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return Parsed<TypeBody> { node = InterfaceBody { extends = ext.items; methods = methods }; next = p + 1 }
    }
    loop {
        var idoc = peel_leading_doc(tokens, p)
        var imc = peek_member_const(tokens, idoc.next)
        if imc.is_const || imc.bad_override { return reject_const_member(tokens, imc.kw_pos) }
        var m = match parse_member_fn_or_accessor(tokens, p, true) { Parsed<Decl> as x => x; error as e => return e }
        var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "an interface member must be a method signature (`fn …`)") }
        methods = teko::list::push(methods, mf)
        p = m.next
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) { return err_at(tokens, p, "expected ';', a newline, or '}' after an interface method") }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }   // trailing separator
    }
    Parsed<TypeBody> { node = InterfaceBody { extends = ext.items; methods = methods }; next = p + 1 }
}

// (TR0) `trait { <fields>; <methods, with or without bodies> }`. `pos` is at the `{` (the caller
// consumed the contextual `trait`). The body is STRUCT-SHAPED: interleaved `name: T` fields and
// `fn` methods; unlike a struct's, a method here MAY be bodyless (a requirement the deriver must
// satisfy — parse_function allow_bodyless=true, the interface-member path). Mirrors parse_fields.
fn parse_trait_fields(tokens: []lexer::Token, pos: u64): ParsedStructBody | error {
    var p = skip_seps(tokens, pos + 1)   // consume `{`, skip leading separators
    var fields: []Field = teko::list::empty()
    var methods: []Function = teko::list::empty()
    var consts: []ConstDecl = teko::list::empty()
    if is_kind_at(tokens, p, lexer::TokenKind::RBrace) {
        return ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
    }
    loop {
        if struct_item_is_method(tokens, p) {
            var m = match parse_member_fn_or_accessor(tokens, p, true) { Parsed<Decl> as x => x; error as e => return e }
            var mf = match m.node { Function as f => f; _ => return err_at(tokens, p, "internal: a trait method must parse to a Function") }
            methods = teko::list::push(methods, mf)
            p = m.next
        } else {
            var fdoc = peel_leading_doc(tokens, p)
            var mcs = match try_parse_member_const(tokens, fdoc.next, fdoc.has_doc, fdoc.doc, consts) { MemberConstStep as x => x; error as e => return e }
            if mcs.handled {
                consts = mcs.consts
                p = mcs.next
            } else {
                if !is_name_at(tokens, fdoc.next) {
                    return err_at(tokens, fdoc.next, "expected a field name, a method (`fn …`), or a `const` member in the trait body")
                }
                var name = tokens[fdoc.next].text
                if !is_kind_at(tokens, fdoc.next + 1, lexer::TokenKind::Colon) {
                    return err_at(tokens, fdoc.next + 1, "expected ':' after a field name")
                }
                var ty = match parse_type(tokens, fdoc.next + 2) { ParsedType as x => x; error as e => return e }
                fields = teko::list::push(fields, Field { name = name; type_ann = ty.node; vis = Visibility::Pub; is_intern = false; has_doc = fdoc.has_doc; doc = fdoc.doc })
                p = ty.next
            }
        }
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';', a newline, or '}' after a trait member")
        }
        p = skip_seps(tokens, p)
        if is_kind_at(tokens, p, lexer::TokenKind::RBrace) { break }   // trailing separator
    }
    ParsedStructBody { fields = fields; methods = methods; consts = consts; next = p + 1 }
}

// the body of a type declaration. `struct [I & …] { fields }`, `interface [I & …] { sigs }`,
// `trait { … }`, `enum { … }`, `variant A | B`, `[abstract|virtual] class …`, or ELSE a
// TRANSPARENT alias `= <type-expr>` (self-host parity). `pos` is at the body's first token.
fn parse_type_body(tokens: []lexer::Token, pos: u64): Parsed<TypeBody> | error {
    if is_kind_at(tokens, pos, lexer::TokenKind::Class) || is_kind_at(tokens, pos, lexer::TokenKind::Abstract) || is_kind_at(tokens, pos, lexer::TokenKind::Virtual) {
        return parse_class_body(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Interface) {
        return parse_interface_body(tokens, pos)
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Service) {
        return parse_service_body(tokens, pos)
    }
    // (TR0) `trait` is CONTEXTUAL, like `from`/`params` — NOT a reserved word (an identifier named
    // `trait` stays an ordinary Ident everywhere else). It only means "trait declaration" when the
    // body position holds Ident("trait") IMMEDIATELY followed by `{` — a transparent alias to a
    // type named `trait` (`type X = trait`) has no `{` and still parses as an alias below. A trait
    // declares NO derive-list of its own (no `trait A & B { }` — compose at the deriver instead).
    if is_kind_at(tokens, pos, lexer::TokenKind::Ident) && tokens[pos].text == "trait" && is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) {
        var fs = match parse_trait_fields(tokens, pos + 1) { ParsedStructBody as x => x; error as e => return e }
        return Parsed<TypeBody> { node = TraitBody { fields = fs.fields; methods = fs.methods; consts = fs.consts }; next = fs.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Struct) {
        // (W10b.IF) optional implements list `struct I1 & I2 { … }` between `struct` and `{`.
        var impls = match parse_amp_name_list(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        if !is_kind_at(tokens, impls.next, lexer::TokenKind::LBrace) {
            return err_at(tokens, impls.next, "expected '{' after `struct` (or its interface list)")
        }
        var fs = match parse_fields(tokens, impls.next) { ParsedStructBody as x => x; error as e => return e }
        return Parsed<TypeBody> { node = StructBody { fields = fs.fields; methods = fs.methods; implements = impls.items; consts = fs.consts }; next = fs.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Enum) {
        if !is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) {
            return err_at(tokens, pos + 1, "expected '{' after `enum`")
        }
        match reject_const_body_member(tokens, pos + 1) { error as e => return e; null => { } }
        var ms = match parse_field_names(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        return Parsed<TypeBody> { node = EnumBody { members = ms.items; methods = teko::list::empty() }; next = ms.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Flags) {
        if !is_kind_at(tokens, pos + 1, lexer::TokenKind::LBrace) {
            return err_at(tokens, pos + 1, "expected '{' after `flags`")
        }
        match reject_const_body_member(tokens, pos + 1) { error as e => return e; null => { } }
        var ms = match parse_field_names(tokens, pos + 1) { ParsedList<str> as x => x; error as e => return e }
        return Parsed<TypeBody> { node = FlagsBody { members = ms.items; values = teko::list::empty(); methods = teko::list::empty() }; next = ms.next }
    }
    if is_kind_at(tokens, pos, lexer::TokenKind::Variant) {
        var ty = match parse_type(tokens, pos + 1) { ParsedType as x => x; error as e => return e }
        return Parsed<TypeBody> { node = VariantBody { type_expr = ty.node }; next = ty.next }
    }
    // ELSE: `type Name = <type-expr>` — a TRANSPARENT alias (slice `[]T`, a named type, a
    // union `A | B`, an optional `T?`, …). Parse a full type-expression (self-host parity).
    var al = match parse_type(tokens, pos) { ParsedType as x => x; error as e => return e }
    Parsed<TypeBody> { node = AliasBody { alias = al.node }; next = al.next }
}

// `[doc] [pub|exp] flags Name { Member; Member; … }` (C8.2).
// A standalone bitflag-enum declaration: `flags` keyword + name + member-name list.
// Power-of-2 values are auto-assigned by the checker (C8.3); no `=` and no manual values here.
fn parse_flags_decl(tokens: []lexer::Token, pos: u64): Parsed<Decl> | error {
    var p = pos
    var has_doc = false
    var doc = ""
    // (#111) an own-line doc comment attaches to the NEXT declaration; see parse_function.
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = tokens[p].text
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Flags) {
        return err_at(tokens, p, "expected `flags`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a type name after `flags`")
    }
    var name = tokens[p].text
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::LBrace) {
        return err_at(tokens, p, "expected '{' after the flags type name")
    }
    var ms = match parse_field_names(tokens, p) { ParsedList<str> as x => x; error as e => return e }
    Parsed<Decl> { node = TypeDecl { name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); body = FlagsBody { members = ms.items; values = teko::list::empty(); methods = teko::list::empty() }; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col }; next = ms.next }
}

// `[doc] [pub|exp] type Name = <body>` (B.13, nominal). Doc + visibility precede `type`.
// `pos` is at the doc, `pub`/`exp`, or `type`.
fn parse_type_decl(tokens: []lexer::Token, pos: u64): Parsed<Decl> | error {
    var p = pos
    var has_doc = false
    var doc = ""
    // (#111) an own-line doc comment attaches to the NEXT declaration; see parse_function.
    if is_kind_at(tokens, p, lexer::TokenKind::Doc) {
        has_doc = true
        doc = tokens[p].text
        p = skip_seps(tokens, p + 1)
    }
    var vis = Visibility::Private   // default: own-namespace only
    if is_kind_at(tokens, p, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        p = p + 1
    } else if is_kind_at(tokens, p, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        p = p + 1
    }
    var is_extern = false   // C7.1a: `extern type Name` (opaque foreign handle)
    if is_kind_at(tokens, p, lexer::TokenKind::Extern) {
        is_extern = true
        p = p + 1
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Type) {
        return err_at(tokens, p, "expected `type`")
    }
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a type name")
    }
    var name = tokens[p].text
    if is_reserved_type_name(name) {
        return err_at(tokens, p, "`Ref` is a reserved type name — it is the compiler-internal safe reference the `ref` keyword desugars to, so no user type may take it (write `ref T` in a type position, `ref x: T` to bind)")
    }
    var name_line: u32 = tokens[p].line
    var name_col: u32 = tokens[p].col   // W-loc-2: the type's source position
    p = p + 1
    var tps = match parse_type_params(tokens, p) { ParsedTypeParams as x => x; error as e => return e }   // (S4/W11) `type Box<T: A & B> = …`
    p = tps.next
    if is_extern {
        // `extern type Name` — an OPAQUE foreign handle: no `= <body>`, lowers to `void *`.
        return Parsed<Decl> { node = TypeDecl { name = name; type_params = tps.names; type_constraints = tps.constraints; body = ExternBody { }; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col }; next = p }
    }
    if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
        return err_at(tokens, p, "expected '=' in a type declaration")
    }
    var body = match parse_type_body(tokens, p + 1) { Parsed<TypeBody> as x => x; error as e => return e }
    Parsed<Decl> { node = TypeDecl { name = name; type_params = tps.names; type_constraints = tps.constraints; body = body.node; vis = vis; has_doc = has_doc; doc = doc; line = name_line; col = name_col }; next = body.next }
}

// `parse_module` returns Parsed<Module> (an instance of the result.tks generic).

/** Collect the leading `#…` attributes before a declaration keyword (each on its own line or
 *  inline): `#test` (D2), `#os("…")` (C7.1f), and `#arena_size(N)` (#453, the 0.3.1 SW1
 *  resource/arena foundation — precedes a `fn`). A doubled `#arena_size(…)` on one declaration is
 *  an honest error; `#must_free` was retired by §6 and the annotation-DI lifetimes
 *  (`#singleton`/`#scoped`/`#transient`) and the `#inject(…)` overlay were retired by §7 part 2 —
 *  all rejected on sight as unknown attributes. `next` resumes at the doc/visibility/keyword that
 *  follows the block; placement (fn-vs-type) is enforced by the caller so the message names the
 *  actual keyword. */
fn parse_decl_attributes(tokens: []lexer::Token, pos: u64): ParsedAttributes | error {
    var start = pos
    var is_test = false
    var os_guard = ""
    var has_arena_size = false
    var arena_size: u64 = 0 to u64
    loop {
        if !is_kind_at(tokens, start, lexer::TokenKind::Hash) { break }
        if !is_kind_at(tokens, start + 1, lexer::TokenKind::Ident) {
            return err_at(tokens, start + 1, "expected an attribute name after `#`")
        }
        var attr = tokens[start + 1].text
        if attr == "test" {
            is_test = true
            start = skip_seps(tokens, start + 2)
        } else if attr == "os" {
            if !is_kind_at(tokens, start + 2, lexer::TokenKind::LParen) { return err_at(tokens, start + 2, "expected '(' after `#os`") }
            if !is_kind_at(tokens, start + 3, lexer::TokenKind::Str) { return err_at(tokens, start + 3, "expected a quoted OS name in `#os(\"…\")`") }
            os_guard = tokens[start + 3].text
            if !is_kind_at(tokens, start + 4, lexer::TokenKind::RParen) { return err_at(tokens, start + 4, "expected ')' to close `#os(…)`") }
            start = skip_seps(tokens, start + 5)
        } else if attr == "arena_size" {
            if has_arena_size { return err_at(tokens, start + 1, "a function may carry only one `#arena_size(…)` directive") }
            var parsed = match parse_arena_size_arg(tokens, start) { ParsedU64 as x => x; error as e => return e }
            has_arena_size = true
            arena_size = parsed.value
            start = skip_seps(tokens, parsed.next)
        } else if attr == "inline" {
            return err_at(tokens, start + 1, "`#inline` attaches to a local binding (`#inline var …`) or a struct field (`#inline name: T`), not a declaration")
        } else {
            return err_at(tokens, start + 1, "unknown attribute (only `#test`, `#os(\"…\")`, `#arena_size(N)`, and the binding/field `#inline` are recognized)")
        }
    }
    ParsedAttributes { is_test = is_test; os_guard = os_guard; has_arena_size = has_arena_size; arena_size = arena_size; next = start }
}

/** A parsed `u64` literal + the resume index (the `#arena_size(N)` argument's own tiny result
 *  shape — not worth a whole named type in `result.tks` for one call site). */
type ParsedU64 = struct { value: u64; next: u64 }

/** Parse the `(N)` byte-count argument of `#arena_size(N)`. `pos` is at the `#`. `N` must be a
 *  bare positive integer literal (no suffix, no expression) — a compile-time constant the
 *  developer writes; the compiler never computes or infers it (owner ruling 2026-07-13). */
fn parse_arena_size_arg(tokens: []lexer::Token, pos: u64): ParsedU64 | error {
    if !is_kind_at(tokens, pos + 2, lexer::TokenKind::LParen) { return err_at(tokens, pos + 2, "expected '(' after `#arena_size`") }
    if !is_kind_at(tokens, pos + 3, lexer::TokenKind::Number) { return err_at(tokens, pos + 3, "expected a positive integer byte count in `#arena_size(N)`") }
    var lit = tokens[pos + 3].text
    var n = match lit_int(lit) { NumInt as v => v; error as e => return err_at(tokens, pos + 3, e.message) }
    if n.neg || n.mag == (0 to u64) { return err_at(tokens, pos + 3, "`#arena_size(N)` requires a positive byte count") }
    if !is_kind_at(tokens, pos + 4, lexer::TokenKind::RParen) { return err_at(tokens, pos + 4, "expected ')' to close `#arena_size(…)`") }
    ParsedU64 { value = n.mag; next = pos + 5 }
}

/**
 * Peel an OPTIONAL leading doc-comment off `pos`, before any `#…` attribute is parsed
 * (issue #285 — the standard Javadoc placement precedes `#test`/`#os`/`#arena_size`, not just the
 * `pub`/`exp`/keyword `parse_function`/`parse_type_decl` already handle).
 *
 * @param tokens  the full token stream
 * @param pos     the position to peek at (a Doc token, or the first attribute/keyword)
 * @return        the peeled doc (absent when `pos` is not a Doc token) + the resume position
 */
fn peel_leading_doc(tokens: []lexer::Token, pos: u64): ParsedLeadingDoc {
    if !is_kind_at(tokens, pos, lexer::TokenKind::Doc) {
        return ParsedLeadingDoc { has_doc = false; doc = ""; next = pos }
    }
    ParsedLeadingDoc { has_doc = true; doc = tokens[pos].text; next = skip_seps(tokens, pos + 1) }
}

/**
 * Rebuild a parsed Decl with an OUTER doc-comment attached (issue #285) — used only when
 * `parse_decl` itself peeled a doc that preceded the `#…` attributes, so the inner
 * `parse_function`/`parse_type_decl`/`parse_flags_decl` never saw it and left `has_doc=false`.
 * A no-op (the node is returned unchanged) when `has_doc` is false or the node is neither.
 *
 * @param node     the freshly parsed declaration
 * @param has_doc  true iff an outer doc-comment was peeled by `parse_decl`
 * @param doc      the outer doc-comment's text (valid iff has_doc)
 * @return         `node`, with `has_doc`/`doc` overridden to the outer doc when present
 */
fn with_outer_doc(node: Decl, has_doc: bool, doc: str): Decl {
    if !has_doc { return node }
    match node {
        Function as f => Function { name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; has_return = f.has_return; return_type = f.return_type; body = f.body; vis = f.vis; has_doc = true; doc = doc; line = f.line; col = f.col; is_test = f.is_test; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; os_guard = f.os_guard; is_intern = f.is_intern; is_abstract = f.is_abstract; is_virtual = f.is_virtual; is_override = f.is_override; is_static = f.is_static; is_getter = f.is_getter; is_setter = f.is_setter; accessor_prop = f.accessor_prop; has_arena_size = f.has_arena_size; arena_size = f.arena_size; ret_types = f.ret_types; is_operator = f.is_operator }
        TypeDecl as td => TypeDecl { name = td.name; type_params = td.type_params; type_constraints = td.type_constraints; body = td.body; vis = td.vis; has_doc = true; doc = doc; line = td.line; col = td.col }
        ConstDecl as cd => ConstDecl { name = cd.name; ty = cd.ty; init = cd.init; vis = cd.vis; has_doc = true; doc = doc; line = cd.line; col = cd.col }
        _ => node
    }
}

/**
 * parse_const_decl — parse a module-level `const NAME: Type = <const-expr>` (#594),
 * reached from `parse_decl` after the optional doc/`pub`/`exp` peel. The type
 * annotation is MANDATORY at module scope (unlike a local `const`, whose type may
 * infer): a public constant's type is part of its contract. The initializer is
 * parsed as a full expression here and validated as a const-expr later, in the
 * checker (`is_const_expr`), so parse errors stay syntactic.
 *
 * @param tokens  the full token stream
 * @param start   the index of the `const` keyword
 * @param vis     the visibility peeled by `parse_decl`
 * @return        the parsed ConstDecl and the index just past its initializer
 * @throws        a located error on a missing name, a missing `: Type`, a missing
 *                `=`, or an ill-formed initializer expression
 * @since #594
 */
fn parse_const_decl(tokens: []lexer::Token, start: u64, vis: Visibility): Parsed<Decl> | error {
    var kw_line: u32 = tokens[start].line
    var kw_col: u32 = tokens[start].col
    var p = start + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Ident) {
        return err_at(tokens, p, "expected a constant name after `const`")
    }
    var name = tokens[p].text
    p = p + 1
    if !is_kind_at(tokens, p, lexer::TokenKind::Colon) {
        return err_at(tokens, p, "expected ':' and a type — a module-level `const` must declare its type")
    }
    var ty = match parse_type(tokens, p + 1) { ParsedType as x => x; error as e => return e }
    p = ty.next
    if !is_kind_at(tokens, p, lexer::TokenKind::Assign) {
        return err_at(tokens, p, "expected `=` and an initializer for a `const`")
    }
    var init = match parse_expr(tokens, p + 1) { Parsed<Expr> as x => x; error as e => return e }
    var cd = ConstDecl { name = name; ty = ty.node; init = init.node; vis = vis; has_doc = false; doc = ""; line = kw_line; col = kw_col }
    Parsed<Decl> { node = cd; next = init.next }
}

/**
 * MemberConstPeek — the non-destructive lookahead a type-body member loop runs to decide whether the
 * next member (after its leading doc was peeled) is a static `const` member (#594 crumb 7). It peels
 * an OPTIONAL `pub`/`exp` visibility and reports the `const` keyword's position, so the caller can
 * either delegate to `parse_type_member_const` or fall back to field/method parsing UNCHANGED (the
 * peek never advances the caller's cursor). `bad_override` flags a `[pub|exp] override const …`, a
 * parse error the caller surfaces (`override` is method-only).
 *
 * @param is_const     the next member is a `const` (delegate to `parse_type_member_const`)
 * @param vis          the visibility peeled ahead of the `const` (Private when none)
 * @param kw_pos       the index of the `const` keyword (or the `override` keyword when bad_override)
 * @param bad_override an `override` illegally precedes the `const`
 */
type MemberConstPeek = struct { is_const: bool; vis: Visibility; kw_pos: u64; bad_override: bool }

/**
 * peek_member_const — decide, without moving the caller's cursor, whether the member at `pos` (past
 * its already-peeled leading doc) is a static `const` member (#594 crumb 7). Peels an optional
 * `pub`/`exp`, then classifies the following token: an `override const` is `bad_override`, a plain
 * `const` is a member const, anything else is a field/method the caller parses as before.
 *
 * @param tokens  the token stream
 * @param pos     the member's first token (after the leading doc was peeled)
 * @return        the classification (is_const / bad_override / the peeled visibility + keyword index)
 * @since #594
 */
fn peek_member_const(tokens: []lexer::Token, pos: u64): MemberConstPeek {
    var k = pos
    var vis = Visibility::Private
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) { vis = Visibility::Pub; k = k + 1 }
    else if is_kind_at(tokens, k, lexer::TokenKind::Exp) { vis = Visibility::Exp; k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Override) && is_kind_at(tokens, k + 1, lexer::TokenKind::Const) {
        return MemberConstPeek { is_const = false; vis = vis; kw_pos = k; bad_override = true }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Const) {
        return MemberConstPeek { is_const = true; vis = vis; kw_pos = k; bad_override = false }
    }
    MemberConstPeek { is_const = false; vis = vis; kw_pos = k; bad_override = false }
}

/**
 * MemberConstStep — the outcome of one `try_parse_member_const` attempt inside a struct/class/trait
 * member loop (#594 crumb 7). When `handled`, the member was a `const`: `consts` is the caller's
 * list with the parsed ConstDecl pushed and `next` is the index past its initializer. When not
 * handled, `consts` is returned UNCHANGED and `next` echoes the position the caller passed in, so
 * the field/method fallback resumes exactly where the peek looked.
 *
 * @param handled the member was a `const` and was consumed
 * @param consts  the caller's consts list (with the new ConstDecl pushed iff handled)
 * @param next    the index past the const's initializer (or the caller's position iff not handled)
 */
type MemberConstStep = struct { handled: bool; consts: []ConstDecl; next: u64 }

/**
 * try_parse_member_const — the shared member-const step every struct/class/trait member loop runs
 * (#594 crumb 7): peek via `peek_member_const`, surface the method-only-`override` error, and, when
 * the member IS a `const`, delegate to `parse_type_member_const` and push the result onto the
 * caller's consts list. A non-const member leaves the cursor and the list untouched, so the caller
 * falls back to its own field parsing unchanged.
 *
 * @param tokens   the token stream
 * @param pos      the member's first token (after the leading doc was peeled)
 * @param has_doc  whether a leading doc-comment preceded the member
 * @param doc      the leading doc-comment's text (valid iff has_doc)
 * @param consts   the member loop's consts list so far
 * @return         the step outcome (handled flag, updated consts, cursor to resume at)
 * @throws         a located error on `override const` or a malformed member const
 * @since #594
 */
fn try_parse_member_const(tokens: []lexer::Token, pos: u64, has_doc: bool, doc: str, consts: []ConstDecl): MemberConstStep | error {
    var mc = peek_member_const(tokens, pos)
    if mc.bad_override { return err_at(tokens, mc.kw_pos, "a `const` member may not carry `override` — `override` is method-only") }
    if mc.is_const {
        var cd = match parse_type_member_const(tokens, mc.kw_pos, mc.vis, has_doc, doc) { Parsed<ConstDecl> as x => x; error as e => return e }
        return MemberConstStep { handled = true; consts = teko::list::push(consts, cd.node); next = cd.next }
    }
    MemberConstStep { handled = false; consts = consts; next = pos }
}

/**
 * reject_const_member — the located error a body that carries no `consts` list (interface / enum /
 * flags) raises when a `const` member appears in it (#594 crumb 7). A member const is static
 * type-level state, which only a struct, class, or trait body owns.
 *
 * @param tokens  the token stream
 * @param pos     the offending `const` keyword's index
 * @return        the located parse error
 * @since #594
 */
fn reject_const_member(tokens: []lexer::Token, pos: u64): error {
    err_at(tokens, pos, "a `const` member is only allowed in a struct, class, or trait body")
}

/**
 * reject_const_body_member — guard the name-only `enum`/`flags` member list (`parse_field_names`)
 * against a `const` member (#594 crumb 7): those bodies carry no `consts` list, so a `const` at the
 * first member position is the same located error the interface path raises. `brace_pos` is at the
 * body's opening `{`.
 *
 * @param tokens     the token stream
 * @param brace_pos  the index of the body's opening `{`
 * @return           the located error when a `const` opens the member list, else null
 * @since #594
 */
fn reject_const_body_member(tokens: []lexer::Token, brace_pos: u64): error | null {
    var fp = skip_seps(tokens, brace_pos + 1)
    if is_kind_at(tokens, fp, lexer::TokenKind::Const) { return reject_const_member(tokens, fp) }
    null
}

/**
 * parse_type_member_const — parse a `[pub|exp] const NAME: Type = <const-expr>` member inside a
 * struct/class/trait body (#594 crumb 7), DELEGATING the `const …` grammar to `parse_const_decl` so
 * the type-member and module placements never diverge. The leading doc (peeled by the member loop) is
 * threaded onto the returned ConstDecl; the visibility was peeled by `peek_member_const`. A member
 * const is static/type-level — it takes no layout slot and is resolved by `TypeName::NAME`.
 *
 * @param tokens   the token stream
 * @param pos      the index of the `const` keyword (after the peeled doc/visibility)
 * @param vis      the visibility peeled by the member loop
 * @param has_doc  whether a leading doc-comment preceded the member
 * @param doc      the leading doc-comment's text (valid iff has_doc)
 * @return         the parsed member ConstDecl and the index past its initializer
 * @throws         a located error on a missing name / `: Type` / `=` / bad initializer
 * @since #594
 */
fn parse_type_member_const(tokens: []lexer::Token, pos: u64, vis: Visibility, has_doc: bool, doc: str): Parsed<ConstDecl> | error {
    var d = match parse_const_decl(tokens, pos, vis) { Parsed<Decl> as x => x; error as e => return e }
    var parsed_const = match d.node { ConstDecl as c => c; _ => return err_at(tokens, pos, "internal: a member const must parse to a ConstDecl") }
    var cd = ConstDecl { name = parsed_const.name; ty = parsed_const.ty; init = parsed_const.init; vis = parsed_const.vis; has_doc = has_doc; doc = doc; line = parsed_const.line; col = parsed_const.col }
    Parsed<ConstDecl> { node = cd; next = d.next }
}

/**
 * Parse one top-level declaration at `pos` — `[doc] [#attrs] [doc] [pub|exp] fn|type|flags …`.
 *
 * The Javadoc MAY precede the `#…` attributes (issue #285, the standard placement — a doc
 * describes the whole declaration, above every modifier) OR follow them (the pre-existing
 * placement `parse_function`/`parse_type_decl`/`parse_flags_decl` already parse themselves);
 * both are accepted, but only one may be present (a doc in both slots is not a Teko idiom and
 * the second is treated as part of the keyword search, erroring normally if it doesn't fit).
 *
 * @param tokens  the full token stream
 * @param pos     the position of the first token of the declaration (a Doc, `#`, `pub`/`exp`,
 *                `extern`, or `fn`/`type`/`flags`)
 * @return        the parsed declaration and the position just past it
 * @throws        a plain `error` when `pos` is not the start of a valid declaration
 */
fn parse_decl(tokens: []lexer::Token, pos: u64): Parsed<Decl> | error {
    var outer_doc = peel_leading_doc(tokens, pos)
    var attrs = match parse_decl_attributes(tokens, outer_doc.next) { ParsedAttributes as x => x; error as e => return e }
    var start = attrs.next
    var k = start
    if is_kind_at(tokens, k, lexer::TokenKind::Doc) { k = skip_seps(tokens, k + 1) }
    var vis = Visibility::Private
    if is_kind_at(tokens, k, lexer::TokenKind::Pub) {
        vis = Visibility::Pub
        k = k + 1
    } else if is_kind_at(tokens, k, lexer::TokenKind::Exp) {
        vis = Visibility::Exp
        k = skip_export_override_peek(tokens, k + 1)
    }
    var saw_extern = false
    if is_kind_at(tokens, k, lexer::TokenKind::Extern) {
        saw_extern = true
        k = k + 1
    }
    if is_unsafe_modifier_at(tokens, k) { k = k + 1 }
    if is_kind_at(tokens, k, lexer::TokenKind::Fn) {
        var d = match parse_fn_decl_with_attrs(tokens, start, attrs) { Parsed<Decl> as x => x; error as e => return e }
        return Parsed<Decl> { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Type) {
        var d = match parse_type_decl_with_attrs(tokens, start, k, attrs) { Parsed<Decl> as x => x; error as e => return e }
        return Parsed<Decl> { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Flags) {
        var d = match parse_flags_decl_with_attrs(tokens, start, k, attrs) { Parsed<Decl> as x => x; error as e => return e }
        return Parsed<Decl> { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); next = d.next }
    }
    if is_kind_at(tokens, k, lexer::TokenKind::Const) {
        if saw_extern { return err_at(tokens, k, "expected `fn` or `type` after `extern`") }
        match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
        var d = match parse_const_decl(tokens, k, vis) { Parsed<Decl> as x => x; error as e => return e }
        return Parsed<Decl> { node = with_outer_doc(d.node, outer_doc.has_doc, outer_doc.doc); next = d.next }
    }
    if saw_extern {
        return err_at(tokens, k, "expected `fn` or `type` after `extern`")
    }
    err_at(tokens, k, "expected a declaration (`fn`/`type`/`flags`, optionally `pub`/`exp`/doc); loose statements belong in main.tks")
}

/** Parse a `fn` declaration reached through `parse_decl`, applying the collected attributes:
 *  `#arena_size(N)` (#453) is threaded into the parsed Function (has_arena_size/arena_size). */
fn parse_fn_decl_with_attrs(tokens: []lexer::Token, start: u64, attrs: ParsedAttributes): Parsed<Decl> | error {
    parse_function(tokens, start, attrs.is_test, attrs.os_guard, false, false, attrs.has_arena_size, attrs.arena_size)
}

/** Parse a `type` declaration reached through `parse_decl`, applying the collected attributes:
 *  `#test`/`#os`/`#arena_size` may not precede a type. */
fn parse_type_decl_with_attrs(tokens: []lexer::Token, start: u64, k: u64, attrs: ParsedAttributes): Parsed<Decl> | error {
    match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
    parse_type_decl(tokens, start)
}

/** Parse a `flags` declaration reached through `parse_decl`. */
fn parse_flags_decl_with_attrs(tokens: []lexer::Token, start: u64, k: u64, attrs: ParsedAttributes): Parsed<Decl> | error {
    match reject_fn_only_attrs_on_type(tokens, k, attrs) { error as e => return e; null => { } }
    parse_flags_decl(tokens, start)
}

/** The function-only attributes (`#test`, `#os`, `#arena_size`) are all rejected before a `type`. */
fn reject_fn_only_attrs_on_type(tokens: []lexer::Token, k: u64, attrs: ParsedAttributes): error | null {
    if attrs.is_test { return err_at(tokens, k, "`#test` may only precede a function") }
    if attrs.os_guard != "" { return err_at(tokens, k, "`#os(\"…\")` may only precede a function") }
    if attrs.has_arena_size { return err_at(tokens, k, "`#arena_size(…)` may only precede a function, not a `type`") }
    null
}

// --- loose doc-comments & the adjacency rule (ruling 2026-08-06,
// docs/design/comments-anywhere-doc-classification-0.3.1.md) ---
//
// A `/** … */` reaches the parser as a Doc token (`//` and `/* */` are dropped by the lexer, so
// they are already accepted in any position). A Doc is DOCUMENTATION only when it is adjacent —
// no blank line — to a declaration it can annotate; anywhere else it is a LOOSE comment, accepted
// as trivia and ignored, never "expected a declaration".

// Does the token at `pos` begin a DECLARATION HEAD — an attribute, a visibility/linkage modifier,
// or a declaration keyword? A doc classifies only when one of these immediately follows it.
fn is_decl_head_token(tokens: []lexer::Token, pos: u64): bool {
    is_kind_at(tokens, pos, lexer::TokenKind::Hash) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Pub) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Exp) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Extern) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Fn) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Type) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Flags) ||
    is_kind_at(tokens, pos, lexer::TokenKind::Const) ||
    is_unsafe_modifier_at(tokens, pos)
}

// Does the doc-comment at `docpos` CLASSIFY as documentation for a following declaration? Only when
// a declaration head follows it with at most a single own-line newline between them — a blank line
// (a second separator) or a `;` breaks the adjacency and makes it a loose comment.
fn doc_classifies(tokens: []lexer::Token, docpos: u64): bool {
    if !is_kind_at(tokens, docpos, lexer::TokenKind::Doc) { return false }
    var p = docpos + 1
    if is_kind_at(tokens, p, lexer::TokenKind::Semicolon) { return false }
    if is_kind_at(tokens, p, lexer::TokenKind::Newline) {
        p = p + 1
        if is_sep(tokens, p) { return false }
    }
    is_decl_head_token(tokens, p)
}

// Skip a run of separators AND loose doc-comments — the trivia between declarations. Stops at a
// real token or at a CLASSIFYING doc (left in place for `parse_decl` to attach). This is what lets
// a `/** banner */` sit at the top of a file, before a `use`, or between declarations.
fn skip_trivia(tokens: []lexer::Token, pos: u64): u64 {
    var p = pos
    loop {
        if is_sep(tokens, p) { p = p + 1; continue }
        if is_kind_at(tokens, p, lexer::TokenKind::Doc) && !doc_classifies(tokens, p) { p = p + 1; continue }
        break
    }
    p
}

// a module file: the `use` header, then a loop of declarations. Rejects loose statements.
// `pos` is 0 (file start).
pub fn parse_module(tokens: []lexer::Token, pos: u64): Parsed<Module> | error {
    var hdr = match parse_use_header(tokens, pos) { ParsedList<UseDecl> as x => x; error as e => return e }
    var p = skip_trivia(tokens, hdr.next)
    var decls: []Decl = teko::list::empty()
    loop {
        if !has_token(tokens, p) { break }
        var d = match parse_decl(tokens, p) { Parsed<Decl> as x => x; error as e => return e }
        decls = teko::list::push(decls, d.node)
        p = d.next
        if !has_token(tokens, p) { break }
        if !is_sep(tokens, p) {
            return err_at(tokens, p, "expected ';' or a newline after a declaration")
        }
        p = skip_trivia(tokens, p)
    }
    Parsed<Module> { node = Module { uses = hdr.items; decls = decls }; next = p }
}
