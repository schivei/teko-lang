// --- expressions ---

use teko::lexer

/**
 * NumInt — the resolved integer-literal carrier, sign + 64-bit magnitude (drop-128,
 * 2026-07-24). Holds any value in the language's integer range `[i64::MIN, u64::MAX]`:
 * `neg=false` covers `0..=u64::MAX`, `neg=true` covers `i64::MIN..=-1`. Replaces the old
 * `i64` carrier, whose only reason to exist was to hold a high-bit u64 losslessly — a
 * u64 with its high bit set needs 65 signed bits, not 128.
 *
 * @field neg  true iff the value is strictly negative (only ever set for a signed target)
 * @field mag  the magnitude: the value itself when `neg=false`, else its absolute value.
 *             `i64::MIN` is representable as `{ neg = true; mag = 0x8000000000000000 }`
 *             (`|i64::MIN|` = 2^63 fits u64)
 * @since 0.3.1 (drop-128-family)
 */
pub type NumInt = struct { neg: bool; mag: u64 }

/**
 * numint_of_u64 — a non-negative `NumInt` carrying the magnitude `m` (`neg=false`). The
 * constructor every non-negated integer literal / synthesized constant value uses.
 *
 * @param m  the non-negative magnitude
 * @return   `{ neg = false; mag = m }`
 * @since 0.3.1 (drop-128-family)
 */
pub fn numint_of_u64(m: u64): NumInt { NumInt { neg = false; mag = m } }

/**
 * numint_of_i64 — the `NumInt` a plain signed `i64` value denotes (sign-splits it). Safe at
 * the `i64::MIN` boundary: `-(v+1)` never overflows (`v+1` stays in range even at `i64::MIN`,
 * and negating it lands at worst on `i64::MAX`), and `+1` recovers the true magnitude — the
 * classic MIN-safe negation, avoiding the CHECKED `i64 -> u64` cast (M.1) a direct negation
 * would need.
 *
 * @param v  the signed value to convert
 * @return   `v` as a sign-magnitude `NumInt`
 * @since 0.3.1 (drop-128-family)
 */
pub fn numint_of_i64(v: i64): NumInt {
    if v >= 0 { return numint_of_u64(v to u64) }
    NumInt { neg = true; mag = ((0 - (v + 1)) to u64) + 1 }
}

/**
 * numint_negate — the arithmetic negation of `v` (unary `-`). Zero stays zero (canonical
 * non-negative); every other magnitude flips its sign flag, magnitude unchanged (sign +
 * magnitude negation never touches the magnitude bits, unlike two's-complement negation).
 *
 * @param v  the value to negate
 * @return   `-v`
 * @since 0.3.1 (drop-128-family)
 */
pub fn numint_negate(v: NumInt): NumInt {
    if v.mag == 0 { v } else { NumInt { neg = !v.neg; mag = v.mag } }
}

/**
 * numint_is_zero — is `v` the value zero? (`neg` is ignored — a canonical `NumInt` never
 * carries `neg=true` at magnitude 0, but a caller-built one might; this checks the value,
 * not the representation.)
 *
 * @param v  the value to test
 * @return   true iff `v` denotes zero
 * @since 0.3.1 (drop-128-family)
 */
pub fn numint_is_zero(v: NumInt): bool { v.mag == 0 }

/**
 * U64_ALL_ONES — every bit of a `u64` set (`2^64 - 1`). The subtrahend `numint_bits` negates a
 * magnitude against, so the two's-complement negation never leaves the `u64` domain.
 *
 * @since 0.3.1 (drop-128-family)
 */
const U64_ALL_ONES: u64 = 0xFFFFFFFFFFFFFFFF

/**
 * I64_SIGN_BIT_U — `2^63` as a `u64`: the smallest bit pattern whose SIGNED reading is negative,
 * and exactly the distance between the unsigned and the signed reading of any pattern at or above
 * it (`signed = unsigned - 2^63 + i64::MIN`).
 *
 * @since 0.3.1 (drop-128-family)
 */
const I64_SIGN_BIT_U: u64 = 9223372036854775808

/**
 * I64_MIN — the most negative `i64` (`-2^63`). Spelled as a subtraction because `2^63` itself has
 * no `i64` literal form (the language's largest is `i64::MAX`).
 *
 * @since 0.3.1 (drop-128-family)
 */
const I64_MIN: i64 = -9223372036854775807 - 1

/**
 * numint_to_i64 — `v`'s raw 64-bit two's-complement bit pattern, reinterpreted as `i64` (the SAME
 * register value the native backend would hold). Every carrier that needs a plain machine-register
 * view of a literal (LIR constants, the interpreters, const-aggregate serialization) goes through
 * this one conversion.
 *
 * PROOF THAT NO STEP CAN TRAP OR OVERFLOW, in any build mode (the reason the pre-0.3.1 32-bit split
 * was replaced): the old form computed `((mag >> 32) to i64) * 4294967296 + (mag & 0xFFFFFFFF)`,
 * and for any `mag >= 2^63` — a magnitude the corpus really carries, e.g. the
 * `18446744073709551615` literal in `parse_lit.tks` — that multiplication overflows `i64`, which is
 * UNDEFINED behavior in the emitted C (`tk_mul_i64` is a bare `*` unless `TEKO_OVERFLOW_DEBUG` is
 * set, and a panic if it ever is). The result happened to be right on wrapping hardware; the
 * derivation was not. The split is also unnecessary — `mag` already IS the bit pattern.
 *
 * The form below reaches the same value in three provably-in-range steps:
 *   1. `numint_bits` produces the 64-bit pattern in the UNSIGNED domain: `mag` itself when
 *      non-negative, else `(U64_ALL_ONES - mag) + 1` (the textbook two's-complement negation). The
 *      subtraction cannot underflow (`mag <= U64_ALL_ONES`) and the `+ 1` cannot overflow (`mag >= 1`
 *      on that branch, so the difference is `<= U64_ALL_ONES - 1`); `mag == 0` returns 0 directly.
 *   2. a pattern below `2^63` casts straight across: it is inside `i64`'s positive range, so the
 *      CHECKED `u64 -> i64` cast (M.1 — it panics past `i64::MAX`, which is why the full magnitude
 *      is never cast directly) always succeeds.
 *   3. a pattern at or above `2^63` casts `bits - 2^63` (in `[0, 2^63)`, so again inside the
 *      positive range) and adds `I64_MIN`; the sum lies in `[i64::MIN, -1]`, so the signed addition
 *      cannot overflow either.
 * Total over the whole `NumInt` domain, exact at `i64::MIN`, and identical to the old result for
 * every value that did not overflow.
 *
 * @param v  the value to reinterpret
 * @return   `v`'s value as a raw i64 register bit pattern
 * @since 0.3.1 (drop-128-family)
 */
pub fn numint_to_i64(v: NumInt): i64 {
    i64_of_u64_bits(numint_bits(v))
}

/**
 * numint_bits — `v`'s 64-bit two's-complement pattern, as a `u64`: the magnitude itself when `v` is
 * non-negative, else its two's-complement negation computed with in-range unsigned steps only (see
 * `numint_to_i64`'s proof, step 1). The same value the frozen `.tkb` wire encoding writes as its
 * `lo` half (`tkb_write.numint_lo`).
 *
 * @param v  the value whose bit pattern is wanted
 * @return   the 64-bit pattern denoting `v`
 * @since 0.3.1 (drop-128-family)
 */
fn numint_bits(v: NumInt): u64 {
    if !v.neg { return v.mag }
    if v.mag == 0 { return 0 }
    (U64_ALL_ONES - v.mag) + 1
}

/**
 * i64_of_u64_bits — the signed value a 64-bit pattern denotes: a straight reinterpretation, done
 * with two in-range steps because the `u64 -> i64` cast is CHECKED (see `numint_to_i64`'s proof,
 * steps 2 and 3).
 *
 * @param bits  the 64-bit two's-complement pattern
 * @return      its signed reading
 * @since 0.3.1 (drop-128-family)
 */
fn i64_of_u64_bits(bits: u64): i64 {
    if bits < I64_SIGN_BIT_U { return bits to i64 }
    ((bits - I64_SIGN_BIT_U) to i64) + I64_MIN
}

/**
 * A literal number leaf (N1 — TEKO_CORRECTION_PLAN §5). Carries the RAW value; the resolved
 * type (set by the typer) decides width/signedness/float-kind.
 *
 * @field is_float  false for an integer literal (`value` holds it, any width u8..u64/i8..i64),
 *                   true for a float literal (f32/f64; `fval` holds it, default f64)
 * @field value      the raw integer literal value as a sign+64-bit-magnitude pair (meaningful
 *                    only when `!is_float`) — see `NumInt`
 * @field fval       the raw float literal value (meaningful only when `is_float`)
 */
pub type Number = struct { is_float: bool; value: NumInt; fval: f64 }
pub type Var = struct { name: str }   // a variable reference (reading)
pub type StrLit = struct { text: str }   // "…"  (B.36)
pub type ByteLit = struct { value: byte }   // b'x' (B.36)
pub type CharLit = struct { bytes: str }   // c'x' — one UTF-8 codepoint (1–4 bytes), carried as its raw UTF-8
pub type BoolLit = struct { value: bool }   // true / false (LEGISLATION §75)
pub type NullLit = struct { }   // null (REBOOT_PLAN §202) — no payload; typed `T?` by the checker
pub type Binary = struct { op: lexer::TokenKind; left: Expr; right: Expr }   // any binary op
pub type Unary = struct { op: lexer::TokenKind; operand: Expr }   // - ~ ! (prefix)
/**
 * One continuation term of a `Compare` chain (`<op> operand`) — e.g. the `< c` in `a < b < c`.
 * ((TR3) `pub` so the structural-trait synthesis can build a `Compare` node directly.)
 */
pub type CmpTerm = struct { op: lexer::TokenKind; operand: Expr }
pub type Compare = struct { first: Expr; rest: []CmpTerm }   // a<b<c chain, kept as written (M.3)
/**
 * A call expression `f(x)` / `lexer::foo(x)` / `Cell<i64>::make(7)`.
 *
 * @param callee    the callee path (the function or generic-instance factory owner)
 * @param args      the positional/named argument expressions
 * @param arg_names       PARALLEL to `args` (DEFARGS 2026-07-01) — "" = positional, else the NAMED param
 *                        this arg targets (`f(name = x)`); named-LAST ordering enforced at parse time
 * @param owner_type_args (#254 L5) the `<…>` on the TYPE before `::` (`Cell<i64>::make`) — binds the
 *                        owner type's params; the checker retargets the factory owner. Empty otherwise.
 * @param callee_type_args explicit `<…>` on the FUNCTION/METHOD (`foo<T>()`, `Type::m<T>()`) — binds the
 *                        callee's own type-params; empty for a bare/inferred call. TRANSIENT: the `.tkb`
 *                        codec persists `checker::TCall`, not `parser::Call`
 */
pub type Call = struct { callee: Path; args: []Expr; arg_names: []str; owner_type_args: []TypeExpr; callee_type_args: []TypeExpr }   // explicit call-site generic args in TWO independent positions: owner_type_args = the `<…>` on the TYPE before `::` (`Type<T>::m` — binds the type's params, retargeted to the instance owner); callee_type_args = the `<…>` on the FUNCTION/METHOD (`foo<T>()`, `Type::m<T>()` — binds the callee's own type-params). Either/both/neither may be present (`Map<K,V>::fold<Acc>()`). Empty for a bare/inferred call.

/**
 * MacroCall — an `@name(...)` call site in the untyped AST (§14): a compiler-executed call the resolver
 * routes to a `MacroDecl` (Family A, expanded pre-type-check) or a `ComptimeDecl` (Family B, folded
 * post-type-check) by the resolved declaration's family. A BARE call (no `@`) never produces this node —
 * it stays an ordinary runtime `Call`. Carries `callee_type_args` for `@sizeof<T>()`/`@fields<T>()`.
 *
 * @field callee           the macro/comptime name path (the `@name` target)
 * @field args             the raw call-site argument expressions (nodes for Family A; folded for B)
 * @field callee_type_args the explicit `<T…>` type arguments (`@sizeof<i32>()`), else empty
 * @since 0.4-macros (§14 A1)
 */
pub type MacroCall = struct { callee: Path; args: []Expr; callee_type_args: []TypeExpr }
pub type IfExpr = struct {   // if/else is an EXPRESSION (B.20)
    cond: Expr
    then_blk: []Statement
    has_else: bool
    else_blk: []Statement
}
pub type MatchExpr = struct { subject: Expr; arms: []Arm }   // match is an EXPRESSION (B.15)

// --- postfix access & cast (F2) — recursive over Expr (compiler-managed indirection) ---
pub type FieldAccess = struct { receiver: Expr; field: str }   // x.field — read a struct field (the checker's own `s.token`/`b.left` shape; B.29)
/**
 * MethodCall — an instance dot-call `recv.method(a, …)` (B.29), typed via the struct/class method
 * dispatch (method checking is deferred, M.4). Carries the call-site argument names so a dot-call
 * `recv.m(w := 5)` binds §9 C defaults/named args exactly as a free call `m(w := 5)` does.
 */
pub type MethodCall = struct {
    /** receiver — the value the method is invoked on (the implicit index-0 argument). */
    receiver: Expr
    /** method — the invoked method's bare name. */
    method: str
    /** args — the call-site arguments, in source order (the receiver is NOT among them). */
    args: []Expr
    /**
     * arg_names — the call-site argument NAMES, parallel to `args`: `""` for a positional argument,
     * else the parameter named by a `:=` named argument (§9 C ruling 2). Threaded verbatim from
     * `parse_call_args` (`ParsedCallArgs.arg_names`); the typer prepends a `""` for the receiver at
     * index 0 before forwarding to `resolve_defargs`.
     */
    arg_names: []str
    /** type_args — explicit call-site generic args `recv.m<T>(…)` (empty for the inferred `recv.m(…)`). */
    type_args: []TypeExpr
}
pub type Cast = struct { expr: Expr; target: TypeExpr }   // x to T — explicit conversion; preserves→ok / loses→compile-error (E7; M.0+M.1)
/**
 * Borrow — the prefix `&x` safe mutable-borrow expression (AL wave F1). Takes a live
 * borrow of the operand lvalue, surfacing the auto-ref that is implicit in argument
 * position today as an explicit operator. Types to `Reference<T>`; mutability is inferred
 * from the operand's binding + the consuming position (bare `&x`, no `&mut`). A borrow of
 * an immutable (`let`) binding in mutable position is a checker error (auto-enforces F2).
 * `&` is the SAFE `ref` surface here — NOT the unsafe raw-pointer sigil (that stays unsafe;
 * `*`/deref untouched, prospecção §12).
 */
pub type Borrow = struct { operand: Expr }   // &x — safe mutable borrow (AL wave F1)
pub type PathExpr = struct { path: Path }   // a qualified path as a VALUE — Enum::Member (e.g. PrimKind::U32), module statics (P2; the F2/Part-1 AST had only single-name Var)
pub type StructLit = struct { type_path: Path; type_args: []TypeExpr; field_names: []str; field_vals: []Expr }   // Name { field = value, … } — a struct VALUE constructor (W4a); (W9.4) type_args = explicit `Foo<i64>{ … }` generic args (empty for bare `Foo { … }`); parallel slices (.len replaces nfields)
pub type Index = struct { receiver: Expr; index: Expr }   // recv[index] — str→byte, []T→T (W5-idx)
// Format spec for a single $"…{expr:spec}…" hole. Three variants:
//   FSpecNone    — no colon in hole (existing behavior)
//   FSpecStatic  — `:literal` → static spec string (e.g. "F2")
//   FSpecDynamic — `:[arg1, arg2, …]` → arg expressions evaluated at runtime
pub type FSpecNone = struct { }
pub type FSpecStatic = struct { s: str }
pub type FSpecDynamic = struct { args: []Expr }
pub type FSpec = struct { kind: FSpecNone | FSpecStatic | FSpecDynamic }
// `$"pre {a} mid {b} post"` — string interpolation (self-host parity). The string is
// pieces[0] ++ str(holes[0]) ++ pieces[1] ++ … ++ pieces[nholes] — so pieces.len == holes.len + 1.
// Pieces are DECODED literal str spans (escapes resolved, like StrLit); each hole is a full Expr.
// specs[i] carries the optional format spec for holes[i] (specs.len == holes.len).
pub type Interp = struct { pieces: []str; holes: []Expr; specs: []FSpec }   // $"…{expr}…" (self-host parity)
// `<expr> in [ e0, e1, … ]` → bool (Phase 2). True iff the LHS equals any element; the LHS is
// EVALUATED ONCE. The `[ … ]` is a SPECIAL membership-set syntax valid ONLY here (no general
// array literal). Empty set `x in []` is allowed → always false.
pub type InExpr = struct { lhs: Expr; elems: []Expr }   // x in [ … ] — membership test (Phase 2)
pub type ArrayElem = struct { is_spread: bool; expr: Expr }   // one element in an array literal: plain (is_spread=false) or spread (is_spread=true, ..expr)
pub type ArrayLit = struct { elements: []ArrayElem }   // [ e0, e1, … ] — a slice/array literal (Increment B+); element type unified by the checker
// (W10) a closure LITERAL `(params) => expr` / `(params) => { … }` — an anonymous function value
// (NO `fn` keyword). A param's type is OPTIONAL (`has_type` false ⇒ inferred from the target type,
// per the W10 ruling). The body is a STATEMENT BLOCK (a `=> expr` form is stored as one trailing
// ExprStmt, like a fn body), so the trailing value is the closure's result. The return type is
// inferred (no `-> R` on a literal). The checker types it to a `Func` and lifts it to a top-level
// function + capture env. (`.type` ends up the closure's Func type.)
pub type LambdaParam = struct { name: str; has_type: bool; type_ann: TypeExpr }
pub type Lambda = struct { params: []LambdaParam; body: []Statement }

/**
 * Block — (§9 E, ruling 7) a Block-B in EXPRESSION position: `{ stmt* trailing_expr }`. A lexical
 * inline block that introduces its own scope and runs in the SAME frame (it is not a closure, it does
 * not capture, it does not allocate); its VALUE is the trailing expression (Block-B — the trailing
 * value is the result). A LEADING `{` in expression position is always a Block-B: §9 B construction
 * always carries a type prefix (`Name { … }`), so a `{` with no path before it is never a
 * construction — unambiguous.
 *
 * @field body  the parsed statements; the trailing statement's value is the block's result
 * @since §9 E
 */
pub type Block = struct { body: []Statement }

// (C1-POS/E1) Expr is a STRUCT WRAPPER over the variant of node kinds — mirroring the typed
// `TExpr` (tast.tks) and the C `tk_expr` (ast.h), so EVERY expression node carries its 1-based
// source position. The parser stamps line/col from the node's first token; the checker copies
// it onto the typed node and onto type-errors, so a message points at the failing expression.
pub type ExprKind = variant Number | Var | Call | IfExpr | MatchExpr | StrLit | ByteLit | CharLit | BoolLit | NullLit | Binary | Unary | Compare | FieldAccess | MethodCall | Cast | PathExpr | StructLit | Index | Interp | InExpr | ArrayLit | Lambda | Borrow | Block | MacroCall
pub type Expr = struct { kind: ExprKind; line: u32; col: u32 }

// --- statements ---
pub type BindKind = enum { Let; Mut; Const }
pub type SimpleName = struct { name: str }
pub type DestructurePattern = struct { names: []str }   // let { x; y } = … (B.13 partial)
macro BindTarget(local: bool = false) {
    if local { lowering { SimpleName | DestructurePattern } }
    else     { lowering { parser::SimpleName | parser::DestructurePattern } }
}

/**
 * Binding — a local binding statement `let|mut|var|const|ref TARGET [: T] = value`. `var` (0.3.1
 * mudancas-superficie-0.3.1.md §1) is the single-local-binding keyword, parsed CONTEXTUALLY
 * (`parse_stmt.tks`'s `is_var_binding_head`, like `ref`) alongside `let`/`mut` in the additive window
 * — it stamps the same `BindKind::Mut` `mut` already produces.
 *
 * @field kind      the mutability mode the binder declared; a `ref` binding, and a `var` binding,
 *                  both desugar to `Mut`
 * @field target    the bound name, or a `{ x; y }` destructure
 * @field has_type  true iff the source carried a `: T` annotation (A.8)
 * @field type_ann  the parsed annotation, meaningful only when `has_type` (A.8)
 * @field is_ref    true iff the binder was the `ref` modifier. INDEPENDENT of `kind`: `let`/`mut` is
 *                  the mutability axis, `ref` is the IDENTITY axis (alias, not copy) and is born
 *                  mutable. It is recorded here because an UN-annotated `ref r = c` has no
 *                  `Ref<>`-wrapped annotation to carry its reference-ness — without the flag the
 *                  checker saw a plain `mut` binding and silently COPIED (owner ruling 2026-07-30)
 * @field value     the initializer expression
 */
pub type Binding = struct {
    kind: BindKind
    target: @BindTarget()
    has_type: bool
    type_ann: TypeExpr
    is_ref: bool
    value: Expr
}
/**
 * AssignKind — the target shape of an assignment (#88). One of four, tagged on `Assign`/`TAssign`:
 *
 * @field Simple    `name op= value` — the bare binding `name` (deref=false; target = no_expr()).
 * @field RefDeref  `name.value op= value` — write THROUGH a `Ref<T>` handle `name` (deref=true, the
 *                  legacy MEM-1b-ii flag; target = no_expr()).
 * @field Field     `recv.field op= value` — a struct/class field write; `target` is the LHS field-access
 *                  EXPR (a FieldAccess, arbitrarily nested); `name`/`deref` unused.
 * @field Index     `ids[i] op= value` — a slice/array ELEMENT write; `target` is the LHS index EXPR (an
 *                  `Index{receiver,index}`); `name`/`deref` unused. Appended LAST so the three legacy
 *                  ordinals (and thus the TKB `assign_kind_byte` layout) are unchanged. `deref` stays a
 *                  plain bool == (kind==RefDeref); Field/Index both carry the general lvalue in `target`
 *                  (see `assign_has_target`).
 */
pub type AssignKind = enum { Simple; RefDeref; Field; Index }
pub type Assign = struct { kind: AssignKind; name: str; op: lexer::TokenKind; value: Expr; deref: bool; target: Expr }   // x = / += / … (B.4); see AssignKind above

/**
 * assign_has_target — does an `AssignKind` carry a general lvalue EXPRESSION in `Assign.target` /
 * `TAssign.target`? True for the two expr-target shapes — `Field` (`recv.field`) and `Index`
 * (`ids[i]`) — and false for `Simple` / `RefDeref` (which write a bare `name`). Every AST/TAST walk
 * that descends into a field assignment's `target` must descend an index assignment's `target` too
 * (both hold sub-expressions naming free variables), so the two share this single predicate.
 *
 * @param kind  the assignment's target discriminant
 * @return      true iff `target` holds a walkable lvalue expression (`Field` or `Index`)
 */
pub fn assign_has_target(kind: AssignKind): bool {
    match kind {
        AssignKind::Field => true
        AssignKind::Index => true
        _ => false
    }
}
/**
 * Return — a `return [expr]` / `return (e1, e2, …)` statement. A bare `return` (no value) carries
 * `has_value=false` and a placeholder `value`. A single-value return uses `value`; a MULTIPLE return
 * (§9 F, ruling 3) fills `values` with ≥ 2 exprs matched positionally against `Function.ret_types`.
 *
 * @field has_value true iff a value (single or multiple) follows the `return`.
 * @field value     the single returned expression (a placeholder when `!has_value` or when multiple).
 * @field values    the `return (e1, e2, …)` list; length ≤ 1 ⇒ single return (uses `value`,
 *                  byte-identical); ≥ 2 ⇒ multiple return. The `( )` are recognized ONLY in `return`
 *                  position — a bare `(a, b)` expression stays a parse error (ruling 3).
 * @since §9 F (the `values` field)
 */
pub type Return = struct { has_value: bool; value: Expr; values: []Expr }
/**
 * `[LABEL:] loop [<head>] { … }` (M.5, #517). The head is fully desugared by the parser: `init`
 * holds the run-once, LOOP-SCOPED preamble (counter/bound/`_first` for range & 3-part, `_it` for
 * for-each; empty for infinite & while) and `body` already contains the folded condition-break, the
 * guarded step, and/or the closure-iterator `match`. `label` empty (len 0) = unlabeled.
 *
 * @field label the UPPER_SNAKE prefix label, or "" when unlabeled
 * @field init  the loop-scoped preamble, run once before the first iteration; it does NOT leak past
 *              the loop (checker scope / codegen brace)
 * @field body  the iteration body (folded head + user statements)
 */
pub type LoopStmt = struct { label: str; init: []Statement; body: []Statement }
pub type BreakStmt = struct { label: str }   // break [NAME] — label empty = innermost loop
pub type ContinueStmt = struct { label: str }   // continue [NAME] — label empty = innermost loop
pub type ExprStmt = struct { expr: Expr }   // a bare expression on its own line
// `defer { stmts }` (C7.18) — scoped cleanup block; executes LIFO at ANY scope exit
// (normal return, early return inside a loop, break out of a function).
// Panic does NOT run deferred blocks (simplifies implementation).
// Nested `defer` is rejected by the checker.
pub type DeferStmt = struct { body: []Statement }

/**
 * `adopt [name] { stmts }` — opens an ADOPTER region; every object allocated lexically inside
 * belongs to it, and the closing brace BULK-drops the whole subtree at once (cycles irrelevant —
 * nothing is freed per-object). The C1 closer of the memory remodel (§1 L4). `adopt` is a
 * CONTEXTUAL statement head (not a hard keyword) recognized by ident text at statement position.
 *
 * @field name  the optional bound name (`adopt r { … }`); empty = anonymous adopter. The region
 *              is opened/dropped either way; the name only matters when a future increment lets
 *              code reference the region handle.
 * @field body  the statements executed inside the adopter region.
 */
pub type AdoptStmt = struct { name: str; body: []Statement }

/**
 * `{ stmts }` at STATEMENT position — a BARE BLOCK that opens a lexical scope (0.3.1 §6). The block
 * is a STATEMENT, never a value: it may not appear in expression position (`var r = { … }` stays
 * invalid). Bindings declared inside die at the closing brace, and the block's region drops on exit
 * exactly as an `if`/`loop` body's scope does. This is the intended replacement for the retired
 * manual `Arena` — a bare `{ }` IS the region.
 *
 * @field body  the statements executed inside the lexical scope, `;`/newline separated.
 */
pub type BlockStmt = struct { body: []Statement }

/**
 * BindName — a positional target in a multiple-binding form (§9 F) that binds its slot's value to a
 * source name.
 *
 * @field name  the identifier the slot's value is bound to
 * @since §9 F
 */
pub type BindName = struct { name: str }
/**
 * BindSkip — the `_` discard target in a multiple-binding form (§9 F): the slot is consumed but no
 * variable is emitted for it.
 *
 * @since §9 F
 */
pub type BindSkip = struct { }
/**
 * BindRest — the `..` skip-range marker of an array decomposition `[a, .., b, c]` (§9 F, ruling 2
 * addendum). It skips 0+ MIDDLE elements and separates the bound head from the bound tail. Legal only
 * inside an `ArrayDecomp` shape, at most once, never in a parallel name-list.
 *
 * @since §9 F
 */
pub type BindRest = struct { }
/**
 * BindElem — one positional leaf of a multiple-binding target list (§9 F): a name, the `_` discard, or
 * the `..` skip-range marker. It is never a value — always a leaf of a target LIST. Retired to a §14
 * Form 2 parametric type-macro (§9.D sweep): `@BindElem()` lowers to the home-namespace-QUALIFIED union
 * (`parser::BindName | …`, the default, cross-namespace-safe at every use site); `@BindElem(true)` lowers
 * to the BARE union for a same-namespace bare spot.
 *
 * @param local  false (default) ⇒ home-ns-qualified members; true ⇒ bare members
 * @return       the inline union `BindName | BindSkip | BindRest` (qualified unless `local`)
 * @since §9 F (retired from `type … = variant` to `@Type()`, §9.D sweep)
 */
macro BindElem(local: bool = false) {
    if local { lowering { BindName | BindSkip | BindRest } }
    else     { lowering { parser::BindName | parser::BindSkip | parser::BindRest } }
}

/**
 * MultiTargetKind — which multiple-binding shape a `MultiBind` declares, fixing how its right-hand
 * side is interpreted.
 *
 * @field Parallel    `var a, b, c = …` — comma-separated targets; the RHS is either N parallel exprs
 *                    (ruling 1) or a single multiple-return call destructured (ruling 3).
 * @field ArrayDecomp `var [a, b, c] = arr` — bracketed targets; the RHS is one `[]T` unpacked by
 *                    position (ruling 2). Admits one `BindRest` (`..`).
 * @since §9 F
 */
pub type MultiTargetKind = enum { Parallel; ArrayDecomp }

/**
 * MultiBind — the MULTIPLE binding statement `var|const TARGETS [: T] = VALUES` (§9 F). Deliberately
 * separate from `Binding` (which stays byte-identical, the sole path the compiler's own fixpoint
 * exercises): the whole new surface is one new `Statement` case, and the checker desugars it to
 * already-existing typed nodes, leaving codegen/LIR untouched.
 *
 * @field kind      the mutability the binder declared (`Const`/`Mut`).
 * @field shape     `Parallel` (`a, b`) or `ArrayDecomp` (`[a, b]`).
 * @field targets   the positional targets in source order (`BindName`/`BindSkip`/`BindRest`).
 * @field has_type  true iff a single shared `: T` annotation was present (ruling 1).
 * @field type_ann  the shared annotation, meaningful only when `has_type`.
 * @field values    `Parallel`: N exprs (parallel) or 1 expr (a multiple-return call); `ArrayDecomp`:
 *                  exactly 1 expr (the `[]T`).
 * @field line      1-based source line of the first target (diagnostics).
 * @field col       1-based source column of the first target.
 * @since §9 F
 */
pub type MultiBind = struct {
    kind: BindKind
    shape: MultiTargetKind
    targets: []@BindElem()
    has_type: bool
    type_ann: TypeExpr
    values: []Expr
    line: u32
    col: u32
}

/**
 * LoweringFrag — a `lowering { … }` fragment inside a Family-A macro body (§14.2): the RAW token run
 * between the braces, captured VERBATIM (not parsed as statements). At expansion (Family-A pre-pass) the
 * run is re-parsed in the GRAMMATICAL POSITION of the `@call` — an `Expr`/`Statement` in value position,
 * a `TypeExpr` in a type annotation (`[]@Type()`, §9.D) — with each `${expr}` injection hole (a
 * `Dollar` `{` … `}` sub-run in the captured tokens) filled by the caller's intact argument node
 * (§5.1-Opt-1, context-polymorphic). A `LoweringFrag` is legal ONLY in a macro body; anywhere else it is
 * a checker honest-stop. INERT until the corpus writes a macro (no `lowering` in `src/`).
 *
 * @field tokens  the raw token run between the fragment's `{` and its matching `}` (holes included)
 * @since 0.4-macros (§14 A2)
 */
pub type LoweringFrag = struct { tokens: []lexer::Token }

pub type Statement = variant Binding | Assign | Return | LoopStmt | BreakStmt | ContinueStmt | ExprStmt | DeferStmt | AdoptStmt | BlockStmt | MultiBind | LoweringFrag

/**
 * Generic type-parameter CONSTRAINTS (W11/S6, 2026-07-01). `<T: ConstraintExpr>` is a DEDICATED
 * boolean grammar over NOMINAL atoms (variant/struct names), syntactically distinct from a
 * type-expression `|` (that's a type UNION; this is a boolean AND/OR over membership tests). `&`
 * binds tighter than `|`: `C1 & C2 | C3` parses as `(C1 & C2) | C3`. An atom is a bare name; the
 * checker rejects a null/void atom (a constraint targets a concrete nominal type, never a
 * use-position nullable/void). Checked AT MONOMORPHIZATION (when a generic is instantiated with a
 * concrete type), never at definition (an unconstrained T stays OPAQUE — store/pass/return only;
 * operating on members needs a constraint). `NoConstraint` is the sentinel for a type-param with
 * no `: …` clause, so `Function`/`TypeDecl.type_constraints` stays PARALLEL to `type_params` (same
 * length, index i's constraint governs `type_params[i]`) without a nullable-field indirection.
 */
pub type ConstraintAtom = struct { name: str }   // a nominal variant/struct name
pub type ConstraintAnd = struct { left: ConstraintExpr; right: ConstraintExpr }   // C1 & C2 — both must hold
pub type ConstraintOr = struct { left: ConstraintExpr; right: ConstraintExpr }   // C1 | C2 — either must hold
pub type NoConstraint = struct { }   // sentinel: the type-param has no `: …` clause
pub type ConstraintExpr = variant ConstraintAtom | ConstraintAnd | ConstraintOr | NoConstraint

// --- top-level items ---
pub type Param = struct { name: str; has_type: bool; type_ann: TypeExpr; is_params: bool; has_default: bool; default_expr: Expr }   // immutable (B.21); is_params = C#-style variadic modifier (2026-07-01), trailing-only, type_ann must be a Slice; has_default/default_expr = DEFARGS (2026-07-01) — TRAILING-ONLY (once one param defaults, every later param must too), default_expr valid iff has_default; has_type = OOP A1 (2026-07-01) — false ONLY for a struct method's 1st param (the RECEIVER, name free, type injected by the checker as the enclosing struct); every other param is always typed (type_ann valid iff has_type)

// Visibility — a declaration's REACH (LEGISLATION "Visibility — pub vs exp"; B.9).
// Private (default, no keyword) = own namespace only; Pub = across the project's
// namespaces (not in the binary header); Exp = exported in the `.tkh` (the public ABI),
// pub by definition. Ordered by increasing reach: Private < Pub < Exp.
pub type Visibility = enum { Private; Pub; Exp }

pub type Function = struct {
    name: str
    type_params: []str   // generic type-parameter names (S4 — empty for a non-generic fn; e.g. `fn id<T>` → ["T"])
    type_constraints: []ConstraintExpr   // (W11/S6) PARALLEL to type_params (same length); NoConstraint{} = no `: …` clause
    params: []Param
    has_return: bool   // `-> ret` present? (absent = Unit return; P5a)
    return_type: TypeExpr   // the return type (valid iff has_return)
    body: []Statement
    vis: Visibility   // private (default) / pub / exp
    has_doc: bool   // a `/** … */` doc precedes it?
    doc: str   // the doc span (valid iff has_doc)
    line: u32   // the name's 1-based source line (W-loc-2 diagnostics)
    col: u32   // the name's 1-based source column (W-loc-2 diagnostics)
    is_test: bool   // a `#test` attribute precedes it? (D2 — run by `teko test` / the build gate)
    is_extern: bool   // an `extern` foreign-function declaration? (C7.1a — no body)
    c_symbol: str   // the C symbol it binds (valid iff is_extern)
    from_lib: str   // the providing library ("" = implicit libc; valid iff is_extern)
    os_guard: str   // a `#os("…")` conditional-compile guard ("" = all OSes; C7.1f)
    is_intern: bool   // (W10b.CLASS, 2026-07-01) visible to inheritors (combines WITH vis, not a 4th tier); struct members always false
    is_abstract: bool   // `abstract fn` — signature only, no body (abstract classes only)
    is_virtual: bool   // `virtual fn` — overridable by a derived class
    is_override: bool   // `override fn` — overrides a base virtual/abstract method
    is_static: bool   // (§4 D3, 2026-08-11) `static fn` — an in-body member of the TYPE, no receiver. Parsed universally (inert at top level, like a modifier); the checker's static-vs-instance detector still keys off the receiver's param shape during the §4 teach window, so this flag is ACCEPTED but not yet authoritative. Non-method `Function`s carry false.
    /**
     * is_getter — this Function is a property GETTER accessor `get <prop>(): T { … }` (§9
     * properties). A non-accessor Function carries false, so every existing `fn`/method reproduces
     * byte-for-byte (additive-inert). When true, the accessor takes NO user parameters (only the
     * injected `self`), declares a return type T, and `accessor_prop` names the property.
     */
    is_getter: bool
    /**
     * is_setter — this Function is a property SETTER accessor `set <prop>(value: T) { … }` (§9
     * properties). False for every non-accessor (additive-inert). When true, the accessor takes
     * exactly ONE user parameter `value: T` after the injected `self`, returns Unit, and
     * `accessor_prop` names the property.
     */
    is_setter: bool
    /**
     * accessor_prop — the SOURCE property name an accessor serves (`""` for a non-accessor). The
     * `name` field carries the SYNTHETIC dispatch symbol (`__get_<prop>` / `__set_<prop>`); this
     * keeps the human-facing property name for diagnostics and for the use-site property registry
     * (`find_property`, §9). Empty on every ordinary fn/method — additive-inert.
     */
    accessor_prop: str
    /**
     * A `#arena_size(N)` directive precedes it (#453, the 0.3.1 SW1 resource/arena foundation) —
     * a DEVELOPER-DECLARED per-function arena budget in bytes, covering the function's own frame
     * region AND every child scope it opens (nested block/loop/arm regions all parent to that
     * same frame). Additive-only: `src/` does not adopt it (the pre-0.3.1 seed must keep building
     * gen1), and it is parsed ONLY at the top-level `fn` position — a method's `Function` always
     * carries `has_arena_size = false` (methods do not go through `parse_decl_attributes`). The
     * compiler never INFERS this number (owner ruling 2026-07-13): a later `teko profile` (#479)
     * may SUGGEST one, never assign it.
     */
    has_arena_size: bool
    /**
     * The `#arena_size(N)` byte count itself (valid iff `has_arena_size`; `0` otherwise). Parsed
     * as an unsigned, strictly positive integer literal — `#arena_size(0)` is rejected at parse
     * time (a zero-byte arena is not a budget).
     */
    arena_size: u64
    /**
     * ret_types — the return-type list of an `fn f(): (A, B, …)` MULTIPLE-return signature (§9 F,
     * ruling 3). EMPTY for a single-return fn (which keeps using `return_type`), so every existing
     * `Function { … }` literal only appends `ret_types = teko::list::empty()` and nothing changes
     * (fixpoint). The `( )` are parsed ONLY in this signature position, so multi-valuedness never
     * enters `TypeExpr` — there is no first-class tuple type.
     * @since §9 F
     */
    ret_types: []TypeExpr
    /**
     * is_operator — this member is an `operator __dunder(left: …, right: …)` declaration (§9
     * ruling 1), NOT an ordinary method. Operators are STATIC (no injected receiver — every operand
     * is explicitly typed) and READONLY; the checker validates the dunder name, the operand
     * arity/positions (at least one operand is `self`), and the mandated return type per class
     * (arith/bitwise → self, comparison → bool, index → element). Every ordinary `fn`/method carries
     * false, so each existing `Function { … }` literal only appends `is_operator = false` and nothing
     * changes (additive-inert, fixpoint).
     */
    is_operator: bool
}
/**
 * StructBody — a `struct [I & …] { fields; methods; consts }` body (OOP A1). A struct's members
 * (fields + methods) stay ALL PUBLIC. `implements` is the `struct I1 & I2 { … }` interface list,
 * empty when the struct declares none.
 *
 * @param fields      the interleaved `name: T` fields, in source order
 * @param methods     the interleaved `fn` decls — an untyped 1st param marks an INSTANCE method
 *                    (the receiver), else a STATIC method
 * @param implements  the interface names the struct conforms to (`& I1 & I2`), empty when none
 * @param consts      the static type-member `const NAME: T = …` declarations (#594 crumb 7); each
 *                    occupies NO layout slot and is resolved by `StructName::NAME`
 * @param is_readonly this struct is a `readonly struct` (§13.3): EVERY field freezes after
 *                    construction. A readonly struct's fields may be set ONLY inside a construction
 *                    (`.{ … }` / `Name { … }`) or via a declaration default; any later write (external
 *                    `s.f = v` or internal `self.f = v`) is a checker error. A bare `struct` (the
 *                    default, all `var`) carries false and is byte-identical to today's tree
 *                    (additive-inert, fixpoint).
 */
pub type StructBody = struct { fields: []Field; methods: []Function; implements: []str; consts: []ConstDecl; is_readonly: bool }
/**
 * One field of a struct/class/trait body.
 *
 * `vis` is the field's REACH (W10b.CLASS, 2026-07-01) — the usual Private/Pub/Exp; `is_intern`
 * widens it to "also visible to inheritors" (orthogonal, not a 4th Visibility tier — see
 * Visibility's own doc). A struct's Field always carries vis=Pub/is_intern=false (struct members
 * stay all-public per W10b.0.A); only class-body fields actually vary these.
 *
 * `has_doc`/`doc` (issue #285) mirror Function's own: a leading Javadoc directly above the field
 * attaches here, so a class/struct body can carry a full-Javadoc per field (W15).
 *
 * @param name       the field's name
 * @param type_ann   the field's declared type
 * @param vis        the field's reach (Private/Pub/Exp)
 * @param is_intern  visible to inheritors? (class bodies only; always false for a struct field)
 * @param has_doc    a Javadoc directly precedes this field?
 * @param doc        the doc-comment's text (valid iff has_doc)
 * @param is_readonly this individual field is `readonly` (§13.3), even inside an otherwise-mutable
 *                    struct: it may be set ONLY at construction (`.{ … }` / `Name { … }`) or by a
 *                    declaration default, never mutated afterwards. A struct marked `readonly` propagates the
 *                    freeze to every field, so each Field also reads back true there. An ordinary
 *                    field carries false. Orthogonal to `vis`/`is_intern` (reach) and to a get-only
 *                    property (encapsulation): `readonly` freezes, `get`-only encapsulates.
 */
pub type Field = struct { name: str; type_ann: TypeExpr; vis: Visibility; is_intern: bool; has_doc: bool; doc: str; is_readonly: bool }
/**
 * EnumBody — an `enum Name { A; B; … }` body: the member names, in declaration order. §9 adds an
 * optional trailing method block `enum Dir { N; S } { fn oposto(): Dir { … } }` (ruling 12): a
 * value-type enum may carry readonly instance methods + operators. An enum written WITHOUT the
 * second brace-block has `methods == []` and reproduces the pre-§9 node byte-for-byte
 * (additive-inert, the fixpoint argument in the plan §8).
 *
 * @field members  the member names, in declaration order
 * @field methods  the trailing `{ … }` block's readonly instance methods + operators (§9); empty
 *                 for an enum with no method block
 */
pub type EnumBody = struct { members: []str; methods: []Function }
/**
 * A `flags` type body: member names + their power-of-2 bit-values (C8.3 assigns member `i`
 * → `1 << i`; C8.6 serializes). The bit-value carrier is `u64` (drop-128, 2026-07-24), so a
 * flags type is capped at 64 members — bit 63 is the last representable; a 65th member is a
 * checker error naming the cap.
 *
 * @field members  the member names, in declaration order
 * @field values    the resolved bit-value of each member, PARALLEL to `members` (≤ 64 entries)
 * @field methods   the trailing `{ … }` block's readonly instance methods + operators (§9 ruling
 *                  12); empty for a flags type with no method block (additive-inert)
 */
pub type FlagsBody = struct { members: []str; values: []u64; methods: []Function }
pub type VariantBody = struct { type_expr: TypeExpr }   // a union (A.8)
pub type AliasBody = struct { alias: TypeExpr }   // `type Name = <type-expr>` — a TRANSPARENT alias (self-host parity)
/**
 * NewtypeBody — a PRIMITIVE-backed value-type WITH a body: `type Celsius = f32 { <members> }`
 * (§9 rulings 10/11). NOMINAL and NON-transparent — unlike `AliasBody` it does NOT resolve-through to
 * its base (`resolve.tks` keeps it a `Named`), so the base↔newtype conversion needs the explicit E9
 * cast (§9 ruling 9). The value IS the primitive: `base` is the backing type-expr (a scalar prim, or
 * — ONLY for an `[]`-operator carrier — an indexed type map/array/list/dict, ruling 4); `methods`
 * holds ONLY readonly instance methods and `operator` declarations (NO fields, NO statics — ruling
 * 10, enforced by the checker).
 *
 * A `type X = <prim>` with NO trailing `{ … }` block parses as `AliasBody` (transparent) exactly as
 * today — this node is produced ONLY when a body block follows.
 *
 * @field backing  the backing type-expr (the primitive the value IS, or an indexed type for `[]`)
 * @field methods  the interleaved readonly instance methods + operators, in source order
 */
pub type NewtypeBody = struct { backing: TypeExpr; methods: []Function }
pub type ExternBody = struct { }   // `extern type Name` — an OPAQUE foreign handle (C7.1a; lowers to `void *`)
// (W10b.CLASS, 2026-07-01) a class's KIND — Teko INVERTS the usual default: SEALED (final,
// instantiable, NOT inheritable) is the DEFAULT (bare `class`); `abstract class` = inheritable,
// NOT instantiable; `virtual class` = instantiable AND inheritable.
pub type ClassKind = enum { Sealed; Abstract; Virtual }
/**
 * ServiceLifetime — the arena lifetime of a `service` kind (§7 DI). Governs which arena slot a
 * `svc<T>()`-resolved value resides in (Doc 1 §8, per-thread): `Singleton` = one instance per
 * thread-root; `Scoped` = one per enclosing frame/sub-root; `Transient` = a fresh instance each
 * resolution (no slot). A `service` always carries exactly one of these.
 *
 * @since 0.3.1
 */
pub type ServiceLifetime = enum { Singleton; Scoped; Transient }
/**
 * ClassBody — a `type C = <kind> [Base[(binding)]] [& I1 & I2 …] { fields; methods; consts }` body
 * (W10b.CLASS). AT MOST one base class (itself Abstract or Virtual, enforced by the checker). Members
 * (fields + methods) are PRIVATE BY DEFAULT (`pub`/`intern` widen) — the inverse of a struct. A
 * `service` (§7 DI) REUSES this node: it is a SEALED class marked `is_service`, carrying a
 * `service_lifetime`; `svc<T>()` resolves it in comp-time.
 *
 * @param kind              SEALED (default), Abstract, or Virtual (see ClassKind)
 * @param has_base          does this class extend a base class?
 * @param base_name         the base class's name (valid iff has_base)
 * @param has_base_binding  is a base-binding name declared (`Base(parent)`)?
 * @param base_binding_name the name INSTANCE methods use to reach the base object (valid iff has_base_binding)
 * @param implements        the `& I1 & I2` interface/derive list
 * @param fields            the interleaved `name: T` fields, in source order
 * @param methods           the interleaved `fn` decls (instance/static, per receiver shape)
 * @param consts            the static type-member `const NAME: T = …` declarations (#594 crumb 7);
 *                          each occupies NO layout slot and is resolved by `ClassName::NAME` (a
 *                          subclass reaches a base's `pub`/`exp` member const by name)
 * @param is_service        true iff this class was written `type N = service <lifetime> …` (§7 DI);
 *                          a service is always Sealed and auto-conforms to the synthesized IService
 * @param service_lifetime  the arena lifetime (valid iff is_service; Singleton for a non-service)
 */
pub type ClassBody = struct {
    kind: ClassKind
    has_base: bool
    base_name: str
    has_base_binding: bool
    base_binding_name: str
    implements: []str
    fields: []Field
    methods: []Function
    consts: []ConstDecl
    is_service: bool
    service_lifetime: ServiceLifetime
}
// (W10b.IF) an INTERFACE — a PURE SIGNATURE CONTRACT: `type X = interface [I1 & I2 …] { fn sig; … }`.
// `extends: []str` — the interfaces this one extends (multiple inheritance; the `I1 & I2` list between
// `interface` and `{`). `methods: []Function` — INSTANCE-method SIGNATURES only (each is a bodyless
// `Function`: 1st param untyped = the receiver; NO body, NO statics, NO default bodies; all members
// public). A type conforms by providing every method (transitively through `extends`) with a matching
// signature. An interface has NO runtime representation yet (dynamic dispatch = ROUND 3); it is a
// compile-time contract only, so codegen emits nothing for it and rejects it as a value type.
pub type InterfaceBody = struct { extends: []str; methods: []Function }
/**
 * TraitBody — the `trait [<& composition>] { <concrete members> }` MIXIN body (§9.4 revised): a
 * self-contained, flattenable bundle of CONCRETE members ONLY, composed into a struct/class/service
 * (or into another trait) through the `&`-list. A trait is NOT a type — it never reaches a value,
 * param, return, field, constraint or dispatch position; it resides only in its own declaration and
 * in a composer's `&`-list. It carries FIELDS (the mixin's own state — the `_name` backing a `get
 * name` lives HERE, read as `self._name`, never the property, or it recurses), BODIED methods
 * (instance methods, `get`/`set` accessors, `static fn` factories) and member consts. It carries NO
 * bodyless members (that is the interface's role — the parser rejects a bodyless trait method).
 * Self-containment: every `self.X` a body references MUST be declared by this trait or by a trait it
 * composes (`implements`). The `implements` list names traits it composes (flattened in) and/or
 * interfaces it fully implements (trait-carries-interface).
 *
 * @field fields      the mixin's own fields, flattened into the composer
 * @field methods     the interleaved bodied instance/accessor/static methods, in source order
 * @field consts      the static member consts (D-consts), resolved by `ComposerName::NAME`
 * @field implements  the `&`-composed trait names (flattened in) and/or interface names (carried)
 * @since 0.3.1 (§9.4 revised)
 */
pub type TraitBody = struct { fields: []Field; methods: []Function; consts: []ConstDecl; implements: []str }
/**
 * TypeBody — the body variant of a `TypeDecl`: a struct/enum/flags/variant/alias/§9 newtype/extern/
 * class/interface/trait shape. Public because it is both the `TypeDecl.body` surface and the `.tkb`
 * codec's serialized carrier (C7.16). §9 adds `NewtypeBody`, the prim-backed value-type-with-body.
 */
pub type TypeBody = variant StructBody | EnumBody | FlagsBody | VariantBody | AliasBody | NewtypeBody | ExternBody | ClassBody | InterfaceBody | TraitBody
pub type TypeDecl = struct {   // nominal (B.13)
    name: str
    type_params: []str   // generic type-parameter names (S4 — empty for a non-generic type; e.g. `type Box<T>` → ["T"])
    type_constraints: []ConstraintExpr   // (W11/S6) PARALLEL to type_params (same length); NoConstraint{} = no `: …` clause
    body: TypeBody
    vis: Visibility   // private (default) / pub / exp
    has_doc: bool
    doc: str   // the doc span (valid iff has_doc)
    line: u32   // the name's 1-based source line (W-loc-2 diagnostics)
    col: u32   // the name's 1-based source column (W-loc-2 diagnostics)
}
/**
 * A `use` declaration, in one of three forms (S1, the 0.1.0.0-beta remodel §3.1):
 * bare `use a::b`, aliased `use a::b as c`, or grouped `use a::b::[ X, Y ]`.
 */
pub type UseDecl = struct {
    /** the owning namespace path (`a::b`), common to all three forms. */
    path: Path
    /** true iff an `as alias` follows the path (never true for the grouped form). */
    has_alias: bool
    /** the bound alias name (valid iff `has_alias`; `""` for bare/grouped forms). */
    alias: str
    /**
     * the grouped import's names (`use a::b::[ X, Y ]` → `["X", "Y"]`); EMPTY for the two
     * existing forms (bare and aliased) — an empty list is the "not a grouped import"
     * sentinel the checker's `build_aliases` guards on.
     */
    names: []str
}

/**
 * ConstDecl — a module-level named compile-time constant `const NAME: Type = init`
 * (#594). Distinct from the local `BindKind::Const` binding (`parse_stmt.tks`): a
 * ConstDecl is a top-level Decl with visibility, a mandatory type annotation, and a
 * const-expr initializer (validated by `teko::checker::is_const_expr`). It carries
 * no scope and opens no arena — the checker inlines it (scalars) or the backend
 * materializes it in rodata (aggregates, C-agg-2).
 *
 * @param name    the constant's identifier
 * @param ty      the mandatory declared type annotation
 * @param init    the const-expr initializer
 * @param vis     Pub/Exp/private, mirroring a function's
 * @param has_doc whether a doc-comment was attached
 * @param doc     the attached doc-comment text (valid iff has_doc)
 * @param line    the `const` keyword's source line
 * @param col     the `const` keyword's source column
 * @since #594
 */
pub type ConstDecl = struct { name: str; ty: TypeExpr; init: Expr; vis: Visibility; has_doc: bool; doc: str; line: u32; col: u32 }

// --- R-main: a `.tks` file is a MAIN (executable entry) or a MODULE. ---
/**
 * A top-level declaration — a module's content: a `fn` (Function), a `type`/`flags`
 * (TypeDecl), or a module-level `const` (ConstDecl, #594).
 *
 * @since #594 widened with ConstDecl (was `Function | TypeDecl`).
 */
/**
 * MacroDecl — a Family-A syntactic macro declaration (`macro name(params) { body }`, §14.1).
 * Pre-type-check, copy-in-place, ENLARGES the AST via `lowering`/`${}`; it has NO return type (a
 * `macro` always emits, never yields a value — the value case is `ComptimeDecl`). Native-only: there is
 * NO `extern macro`. Params are anonymous nodes (untyped until materialized), so arity is free and a
 * trailing `is_params` param binds the variadic node pack.
 *
 * @field name    the macro's declared name (the `@name(...)` call target)
 * @field params  the anonymous parameter list; a trailing `is_params` param binds the node pack
 * @field body    the macro body statements (comptime logic + `lowering { … }` blocks; no return type)
 * @field vis     visibility (`pub`/`exp`/internal)
 * @since 0.4-macros (§14 A1)
 */
pub type MacroDecl = struct { name: str; params: []Param; body: []Statement; vis: Visibility }

/**
 * ComptimeDecl — a Family-B comptime-evaluation declaration (`comptime name(params): T { body }`,
 * §14.1). Post-type-check, args are typed comptime-KNOWN values; the body folds to a value INLINED as a
 * literal at the call site. Native-only: there is NO `extern comptime`. Carries a return type (the
 * inlined literal's type); a `<T…>` generic list lets a comptime infer a runtime arg's type (§14.2).
 *
 * @field name         the comptime macro's name (the `@name(...)` call target)
 * @field type_params  the `<T…>` generic params (empty for a non-generic comptime)
 * @field params       typed parameters; a trailing `is_params` param binds a typed pack
 * @field ret          the return type — the inlined literal's type
 * @field body         the body statements, folded by `eval_const` over typed values
 * @field vis          visibility (`pub`/`exp`/internal)
 * @since 0.4-macros (§14 A1)
 */
pub type ComptimeDecl = struct { name: str; type_params: []str; params: []Param; ret: TypeExpr; body: []Statement; vis: Visibility }

pub type Decl = variant Function | TypeDecl | ConstDecl | MacroDecl | ComptimeDecl
pub type MainFile = struct { uses: []UseDecl; body: []Statement }   // main.tks: the `use` header + the VIRTUAL MAIN's body (statements only — no type/fn decls)
pub type Module = struct { uses: []UseDecl; decls: []Decl }   // a module: the `use` header + declarations (no loose statements)

// --- the FLATTENED item/program — the CHECKER's input view (mirror of the C tk_item /
//     tk_program in ast.h). The parser produces File/Module/Decl; the DRIVER flattens
//     them into this `Program` of `Item`s, which the checker (collect/typer) consumes.
//     Each `Item` is a tagged payload (the C union) PLUS the namespace it came from (A3
//     provenance for codegen name-mangling; resolution/typing IGNORE it). ---
/**
 * The C `tk_item` tag+union, as a Teko variant — a flattened top-level item's
 * payload: a `use`, a loose statement (main files), a `fn`, a `type`/`flags`, or a
 * module-level `const` (ConstDecl, #594).
 *
 * @since #594 widened with ConstDecl (was `UseDecl | Statement | Function | TypeDecl`).
 */
macro ItemKind() { lowering { UseDecl | Statement | Function | TypeDecl | ConstDecl | MacroDecl | ComptimeDecl } }

/**
 * Item — a flattened top-level item: its payload plus source provenance. The `content` union (§9.D
 * sweep, `@ItemKind()`) is a `use`, a loose statement (main files), a `fn`, a `type`/`flags`, a
 * module-level `const`, a macro, or a comptime decl.
 *
 * @field content    the item's payload — the `@ItemKind()` inline union
 * @field namespace  the item's source namespace (A3)
 * @field file       the source file (W-loc-2: assemble tags it so a flattened-program error resolves to
 *                   file:line:col; empty on the single-file compile/run path)
 */
pub type Item = struct { content: @ItemKind(); namespace: str; file: str }
pub type Program = struct { items: []Item }   // the flat item list the checker consumes
