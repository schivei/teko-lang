// src/parser/parser_test.tkt — tests for teko::parser. NO main: PUBLIC `#test`
// functions the compiler collects (a runner — ALPHA). C mirror: a `main` harness.

// helper: lex `source`, then parse a type from position 0 — the TypeExpr, or error.
use teko::lexer

// does parsing a type from `source` fail (the barrier)?
fn type_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_type(toks, 0) { ParsedType => false; error => true }
}

#test
fn rejects_malformed_types() {
    // barrier: each must fail to parse (B.1).
    teko::assert::is_true(type_errors("[]"))   // slice with no element
    teko::assert::is_true(type_errors("A |"))   // union with no right-hand side
    teko::assert::is_true(type_errors("::"))   // path with no leading name
    teko::assert::is_true(type_errors("lexer::"))   // `::` with no name after
    teko::assert::is_true(type_errors(""))   // no type at all
}

// appended to parser_test.tkt — P2a expression-atom tests. #test collected.

// does parsing an expression from `source` fail (the barrier)?
// A parse that succeeds but leaves tokens unconsumed also counts as an error
// (e.g. `to u32` parses `to` as a name-var but leaves `u32` unconsumed).
fn expr_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_expr(toks, 0) { Parsed<Expr> as pe => pe.next < toks.len; error => true }
}

#test
fn rejects_malformed_atoms() {
    // barrier: each must fail (B.1). (Binary/operator cases arrive in P2c–P2e.)
    teko::assert::is_true(expr_errors("(1"))   // unclosed paren
    teko::assert::is_true(expr_errors("f("))   // unclosed call, no arg
    teko::assert::is_true(expr_errors("f(x"))   // unclosed call after an arg
    teko::assert::is_true(expr_errors("f(x,"))   // trailing comma, no next arg
    teko::assert::is_true(expr_errors("+"))   // not the start of an atom
    teko::assert::is_true(expr_errors(""))   // empty
}

// appended to parser_test.tkt — P2b postfix tests.

#test
fn rejects_malformed_postfix() {
    teko::assert::is_true(expr_errors("a."))   // no name after `.`
    teko::assert::is_true(expr_errors("a.5"))   // a number is not a field/method name
    teko::assert::is_true(expr_errors("a.b("))   // unclosed method-call args
}

// appended to parser_test.tkt — P2c unary + cast tests.

#test
fn rejects_malformed_unary_cast() {
    teko::assert::is_true(expr_errors("-"))   // unary with no operand
    teko::assert::is_true(expr_errors("x to"))   // cast with no target type
    teko::assert::is_true(expr_errors("to u32"))   // `to` cannot start an expression
}

// appended to parser_test.tkt — P2d binary + comparison tests.

#test
fn rejects_malformed_binary() {
    teko::assert::is_true(expr_errors("1 +"))   // additive, no rhs
    teko::assert::is_true(expr_errors("1 *"))   // multiplicative, no rhs
    teko::assert::is_true(expr_errors("1 <"))   // comparison, no rhs
    teko::assert::is_true(expr_errors("<< 2"))   // shift, no left operand
}

// appended to parser_test.tkt — P2e logical tests + a full-ladder end-to-end check.

#test
fn rejects_malformed_logical() {
    teko::assert::is_true(expr_errors("a &&"))   // no rhs
    teko::assert::is_true(expr_errors("a ||"))   // no rhs
    teko::assert::is_true(expr_errors("|| b"))   // no left operand
}

// appended to parser_test.tkt — P3a pattern tests.

// does parsing a pattern from `source` fail (the barrier)?
fn pattern_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_pattern(toks, 0) { Parsed<Pattern> => false; error => true }
}

#test
fn rejects_non_patterns() {
    teko::assert::is_true(pattern_errors("+"))   // not a pattern start
    teko::assert::is_true(pattern_errors(""))   // empty
}

// appended to parser_test.tkt — P3b bind + bare-case tests.

#test
fn rejects_malformed_bind() {
    teko::assert::is_true(pattern_errors("Foo as"))   // `as` with no name
    teko::assert::is_true(pattern_errors("Foo as 5"))   // a number is not a binding name
}

// appended to parser_test.tkt — P3b-field field-pattern tests.

#test
fn rejects_malformed_field() {
    teko::assert::is_true(pattern_errors("Foo { a b }"))   // two names with no separator
    teko::assert::is_true(pattern_errors("Foo { a;"))   // unclosed
    teko::assert::is_true(pattern_errors("Foo { 5 }"))   // a number is not a field name
}

// appended to parser_test.tkt — P3c range + alt tests.

#test
fn rejects_malformed_range_alt() {
    teko::assert::is_true(pattern_errors("1 ..="))   // range with no hi
    teko::assert::is_true(pattern_errors("_ ..= 5"))   // a range bound must be a literal (wildcard isn't)
    teko::assert::is_true(pattern_errors("1 |"))   // alt with no right option
}

// appended to parser_test.tkt — P3d arm tests.

fn arm_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_arm(toks, 0) { Parsed<Arm> => false; error => true }
}

#test
fn rejects_malformed_arms() {
    teko::assert::is_true(arm_errors("_ 5"))   // no `=>`
    teko::assert::is_true(arm_errors("_ =>"))   // no body
    teko::assert::is_true(arm_errors("_ when => 1"))   // `when` with no guard expression
}

// appended to parser_test.tkt — P4a block + statement tests.

fn block_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_block(toks, 0) { ParsedList<Statement> => false; error => true }
}

#test
fn rejects_malformed_block() {
    teko::assert::is_true(block_errors("{ a b }"))   // two statements with no separator
    teko::assert::is_true(block_errors("{ a"))   // unclosed block
    teko::assert::is_true(block_errors("{ + }"))   // not a valid statement
}

// appended to parser_test.tkt — P4b binding tests.

fn stmt_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_statement(toks, 0) { Parsed<Statement> => false; error => true }
}

#test
fn rejects_malformed_bindings() {
    teko::assert::is_true(stmt_errors("let = 1"))   // no name
    teko::assert::is_true(stmt_errors("let x 1"))   // no `=`
    teko::assert::is_true(stmt_errors("let x ="))   // no value
    teko::assert::is_true(stmt_errors("let x: = 1"))   // annotation with no type
}

// appended to parser_test.tkt — P4c destructure + assignment tests.

#test
fn rejects_malformed_assign() {
    teko::assert::is_true(stmt_errors("x ="))   // assignment with no value
    teko::assert::is_true(stmt_errors("let { x = p"))   // unclosed destructure
}

// appended to parser_test.tkt — P4d loop/break/continue tests.

/** rejects_malformed_loop — a while-head with no body brace, and an unclosed infinite body, both
    fail to parse (#517: `loop x` is now a while-condition `x` that then wants a `{`). */
#test
fn rejects_malformed_loop() {
    teko::assert::is_true(stmt_errors("loop x"))
    teko::assert::is_true(stmt_errors("loop {"))
}

/** rejects_range_destructure — a destructure target on a range (`loop mut { x } in 0..3`) is
    rejected: a range yields a single value, not a struct (#517). */
#test
fn rejects_range_destructure() {
    teko::assert::is_true(stmt_errors("loop mut { x } in 0..3 { }"))
}

/** rejects_loop_binding_no_separator — a `mut`-headed loop with neither `in` nor a 3-part `=` after
    the binding target is rejected (#517). */
#test
fn rejects_loop_binding_no_separator() {
    teko::assert::is_true(stmt_errors("loop mut i 5 { }"))
}

/** rejects_three_part_missing_semicolon — a 3-part head missing the `;` after the init is rejected
    (#517). */
#test
fn rejects_three_part_missing_semicolon() {
    teko::assert::is_true(stmt_errors("loop mut i = 0 i < 4; i++ { }"))
}

/** rejects_loop_head_missing_body_brace — each `mut`-head form (range, 3-part cond/step, for-each)
    requires a `{` body; the missing-brace and missing-cond-`;` diagnostics all reject (#517). */
#test
fn rejects_loop_head_missing_body_brace() {
    teko::assert::is_true(stmt_errors("loop mut i in 0..3 x"))
    teko::assert::is_true(stmt_errors("loop mut i = 0; i < 4 x { }"))
    teko::assert::is_true(stmt_errors("loop mut i = 0; i < 4; i++ x"))
    teko::assert::is_true(stmt_errors("loop mut x in it y"))
}

// appended to parser_test.tkt — P4e if/match-expression tests (reuses expr_of).

#test
fn rejects_malformed_if_match() {
    teko::assert::is_true(expr_errors("if c a"))   // no `{` after condition
    teko::assert::is_true(expr_errors("if c { a } else"))   // `else` with no block/if
    teko::assert::is_true(expr_errors("match x a"))   // no `{` after subject
    teko::assert::is_true(expr_errors("match x { }"))   // a match needs at least one arm
}

/** rejects_underscore_as_name — `_ as x` (a discard bound to a name) is a semantic contradiction
    (owner ruling, #517): `_` says "discard this value", `as x` says "capture it as x" — you cannot
    re-capture what you discarded. The parser rejects it OUTRIGHT, regardless of subject/context. */
#test
fn rejects_underscore_as_name() {
    teko::assert::is_true(expr_errors("match o { _ as x => x }"))
    teko::assert::is_true(expr_errors("match o { null => 0; _ as x => x }"))
}

/** rejects_underscore_declarations — the write-only discard `_` (owner ruling 2026-07-15) may NOT
    carry a declarative keyword or a type: `let _`, `mut _`, `const _`, and `_: T` targets are hard
    parse errors. The valid way to evaluate an expression for effect and drop its result is the
    keyword-less discard-assign `_ = expr`. */
#test
fn rejects_underscore_declarations() {
    teko::assert::is_true(stmt_errors("let _ = 1"))
    teko::assert::is_true(stmt_errors("mut _ = 1"))
    teko::assert::is_true(stmt_errors("const _ = 1"))
    teko::assert::is_true(stmt_errors("let _: i32 = 1"))
    teko::assert::is_true(stmt_errors("loop mut _ in xs { }"))
}

/** rejects_underscore_read_positions — `_` is WRITE-ONLY: every R-value / read appearance is a hard
    parse error (owner ruling 2026-07-15). A bare read, an arithmetic/unary operand, a field/index
    receiver, a call argument, an array element, a compound-assign target, and a `return _` are all
    rejected — `_` carries no value. The pure-underscore-run lexer errors (`__`, `_1`) also surface
    here as parse-time failures. */
#test
fn rejects_underscore_read_positions() {
    teko::assert::is_true(expr_errors("_"))
    teko::assert::is_true(expr_errors("_ + 1"))
    teko::assert::is_true(expr_errors("-_"))
    teko::assert::is_true(expr_errors("_.field"))
    teko::assert::is_true(expr_errors("_[0]"))
    teko::assert::is_true(expr_errors("[_]"))
    teko::assert::is_true(expr_errors("f(_)"))
    teko::assert::is_true(expr_errors("concat(a, _)"))
    teko::assert::is_true(expr_errors("__"))
    teko::assert::is_true(expr_errors("_1"))
    teko::assert::is_true(stmt_errors("y = _"))
    teko::assert::is_true(stmt_errors("_ += 1"))
    teko::assert::is_true(stmt_errors("return _"))
}

// appended to parser_test.tkt — P5a function tests.

// helper: parse a function decl from `source` — the Function, or error.
fn func_of(source: str): Function | error {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return error { message = "lex failed" } }
    var pd = match parse_function(toks, 0, false, "", false, false, false, 0 to u64) { Parsed<Decl> as x => x; error as e => return e }
    match pd.node { Function as f => f; _ => error { message = "not a function" } }
}

fn func_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_function(toks, 0, false, "", false, false, false, 0 to u64) { Parsed<Decl> => false; error => true }
}

#test
fn rejects_malformed_functions() {
    teko::assert::is_true(func_errors("fn { }"))   // no name
    teko::assert::is_true(func_errors("fn f { }"))   // no params
    teko::assert::is_true(func_errors("fn f(): { }"))   // `->` with no return type
    teko::assert::is_true(func_errors("fn f(): u8"))   // no body
    teko::assert::is_true(func_errors("fn f(x) { }"))   // param with no type
}

// appended to parser_test.tkt — P5b struct type-decl tests.

fn type_decl_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_type_decl(toks, 0) { Parsed<Decl> as pd => pd.next < toks.len; error => true }
}

#test
fn rejects_malformed_struct() {
    teko::assert::is_true(type_decl_errors("type = struct { }"))   // no name
    teko::assert::is_true(type_decl_errors("type T struct { }"))   // no `=`
    teko::assert::is_true(type_decl_errors("type T = struct x: i32 }"))   // no `{`
    teko::assert::is_true(type_decl_errors("type T = struct { x }"))   // field with no type
    teko::assert::is_true(type_decl_errors("type T = struct { x: i32 y: i32 }"))   // two fields, no separator
}

// appended to parser_test.tkt — P5c enum/variant tests.

#test
fn rejects_malformed_enum_variant() {
    teko::assert::is_true(type_decl_errors("type C = enum Red }"))   // no `{` after `enum`
    teko::assert::is_true(type_decl_errors("type C = enum { 5 }"))   // a number is not a member name
    teko::assert::is_true(type_decl_errors("type S = variant"))   // variant with no type
    teko::assert::is_true(type_decl_errors("type T = thing { }"))   // not struct/enum/variant
}

// appended to parser_test.tkt — P5d standalone `use` tests.

fn use_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_use(toks, 0) { Parsed<UseDecl> => false; error => true }
}

#test
fn rejects_malformed_use() {
    teko::assert::is_true(use_errors("use"))   // no path
    teko::assert::is_true(use_errors("use a as"))   // `as` with no alias name
    teko::assert::is_true(use_errors("use ::"))   // `::` with no leading name
    teko::assert::is_true(use_errors("use a::"))   // trailing `::` with no name and no `[`
}

#test
fn rejects_malformed_grouped_use_import() {
    teko::assert::is_true(use_errors("use path::[ ]"))   // empty list
    teko::assert::is_true(use_errors("use path::[ A B ]"))   // missing comma
    teko::assert::is_true(use_errors("use path::[ A, ]"))   // trailing comma
    teko::assert::is_true(use_errors("use path::[ A, B"))   // unclosed list
    teko::assert::is_true(use_errors("use path::[ A, B ] as x"))   // no alias on a grouped import
}

// appended to parser_test.tkt — R-main-c module tests.

fn module_of(source: str): Module | error {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return error { message = "lex failed" } }
    var pm = match parse_module(toks, 0) { Parsed<Module> as x => x; error as e => return e }
    pm.node
}

fn module_errors(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_module(toks, 0) { Parsed<Module> => false; error => true }
}

/**
 * A module-level `const` REQUIRES both a type annotation and an initializer; omitting
 * either is a located parse error (#594 crumb 1).
 */
#test
fn rejects_ill_formed_module_const() {
    teko::assert::is_true(module_errors("const C = 1"))
    teko::assert::is_true(module_errors("const D: i64"))
}

// appended to parser_test.tkt — P6 end-to-end integration.

#test
fn struct_literal_separator_is_semicolon() {
    // a struct literal MUST separate fields with `;` (not `,`): the `,` form is rejected.
    teko::assert::is_true(module_errors("fn f(): P { P { a = 1, b = 2 } }"))   // `,` between fields → error
    // the `;` form parses fine (no barrier).
    teko::assert::is_true(!module_errors("fn f(): P { P { a = 1; b = 2 } }"))   // `;` between fields → ok
}

// --- (#111) own-line `/** … */` doc comments — must parse and ATTACH to the NEXT declaration,
// same as the pre-existing same-line placement (Javadoc/rustdoc/JSDoc-style is own-line). ---

/**
 * §6 (0.3.1 surface migration): `#must_free` was retired — the decorator is rejected on sight,
 * before a `type`, a `fn`, a `flags`, or a `let`, so a plain `type` (no attribute) still parses.
 */
#test
fn rejects_must_free_decorator_everywhere() {
    teko::assert::is_true(module_errors("#must_free\ntype FileHandle = class { }"))
    teko::assert::is_true(module_errors("#must_free\ntype M = struct { p: u8 }"))
    teko::assert::is_true(module_errors("#must_free\nfn handle() { }"))
    teko::assert::is_true(module_errors("#must_free\nflags F { A; B }"))
    teko::assert::is_true(module_errors("#must_free\nlet x = 1"))
    teko::assert::is_false(module_errors("type Plain = class { }"))
}

/**
 * The `c_symbol` an `exp` function carries after parsing `source`'s first declaration (the reverse-FFI
 * `exp("…")` override, "" when none), or "<err>" when the module fails to parse.
 *
 * @param source  a single-declaration module
 * @return        the parsed function's `c_symbol`, or "<err>"
 */
fn ffx_first_fn_c_symbol(source: str): str {
    var m = match module_of(source) { Module as x => x; error => return "<err>" }
    if m.decls.len == 0 { return "<err>" }
    match m.decls[0] { Function as f => f.c_symbol; _ => "<err>" }
}

/**
 * Whether the first declaration of `source` parses as a NON-extern `exp` function (the export shape).
 *
 * @param source  a single-declaration module
 * @return        true iff the first decl is an `exp`, non-extern function
 */
fn ffx_first_fn_is_plain_exp(source: str): bool {
    var m = match module_of(source) { Module as x => x; error => return false }
    if m.decls.len == 0 { return false }
    match m.decls[0] { Function as f => f.vis == Visibility::Exp && !f.is_extern; _ => false }
}

/**
 * The `exp("c_name")` override captures the C export symbol onto a plain (non-extern) `exp` function.
 */
#test
fn ffx_parses_export_override() {
    teko::assert::is_true(ffx_first_fn_c_symbol("exp(\"teko_add\") fn add(a: i64, b: i64): i64 { a }") == "teko_add")
    teko::assert::is_true(ffx_first_fn_is_plain_exp("exp(\"teko_add\") fn add(a: i64, b: i64): i64 { a }"))
}

/**
 * A bare `exp` (no override) leaves the export symbol empty — the flatten-canonical default applies later.
 */
#test
fn ffx_bare_exp_has_no_override() {
    teko::assert::is_true(ffx_first_fn_c_symbol("exp fn add(a: i64): i64 { a }") == "")
}

/**
 * A malformed override — a missing `)`, a non-string argument, and the override on an `extern` import —
 * each fails to parse (M.3 — no silent coercion).
 */
#test
fn ffx_rejects_malformed_export_override() {
    teko::assert::is_true(module_errors("exp(\"teko_add\" fn add(): i64 { 0 }"))
    teko::assert::is_true(module_errors("exp(42) fn add(): i64 { 0 }"))
    teko::assert::is_true(module_errors("exp(\"x\") extern fn c_add(a: i64): i64 = \"c_add\""))
}

/**
 * The FFI IMPORT surface: `extern fn name(...): R = "SYM" from "lib"` parses as a bodyless foreign
 * function carrying its C symbol and providing library (the FFI-in base, task item 1).
 */
#test
fn ffx_parses_extern_import() {
    var m = match module_of("extern fn strlen(s: u64): u64 = \"strlen\" from \"c\"") { Module as x => x; error => return teko::assert::is_true(false) }
    teko::assert::is_true(m.decls.len == 1)
    match m.decls[0] {
        Function as f => {
            teko::assert::is_true(f.is_extern)
            teko::assert::is_true(f.c_symbol == "strlen")
            teko::assert::is_true(f.from_lib == "c")
        }
        _ => teko::assert::is_true(false)
    }
}

// --- comments-anywhere + positional doc-comment classification (ruling 2026-08-06,
//     docs/design/comments-anywhere-doc-classification-0.3.1.md). A `/** … */` is trivia
//     UNLESS it is adjacent (no blank line) to a const/type/fn signature ± its #attrs. ---

// parse a whole module from `source`: did it parse AND consume every token?
fn module_ok(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return false }
    match parse_module(toks, 0) { Parsed<Module> as pm => pm.next == toks.len; error => false }
}

// does the FIRST declaration of the parsed module carry a classified doc-comment?
fn first_decl_has_doc(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return false }
    var pm = match parse_module(toks, 0) { Parsed<Module> as x => x; error => return false }
    if pm.node.decls.len == 0 { return false }
    match pm.node.decls[0] {
        Function as f => f.has_doc
        TypeDecl as td => td.has_doc
        ConstDecl as cd => cd.has_doc
        MacroDecl => false
        ComptimeDecl => false
    }
}

#test
fn accepts_loose_comments_in_any_position() {
    // a stray /** */ at the top of a file (before any decl) — accepted, ignored (was: parse error)
    teko::assert::is_true(module_ok("/** banner */\nfn f(): i32 { 0 }"))
    // a loose /** */ before a `use` — accepted
    teko::assert::is_true(module_ok("/** banner */\nuse teko::list\nfn f(): i32 { 0 }"))
    // a loose /** */ between two declarations — accepted
    teko::assert::is_true(module_ok("fn a(): i32 { 0 }\n/** between */\nfn b(): i32 { 1 }"))
    // a loose /** */ at end of file — accepted
    teko::assert::is_true(module_ok("fn a(): i32 { 0 }\n/** trailing */"))
}

#test
fn classifies_doc_only_on_adjacency() {
    // own line, immediately above → classified for f
    teko::assert::is_true(first_decl_has_doc("/** doc */\nfn f(): i32 { 0 }"))
    // same line → classified
    teko::assert::is_true(first_decl_has_doc("/** doc */ fn f(): i32 { 0 }"))
    // before #attrs → classified
    teko::assert::is_true(first_decl_has_doc("/** doc */\n#test\nfn f() { }"))
    // after #attrs → classified
    teko::assert::is_true(first_decl_has_doc("#test\n/** doc */\nfn f() { }"))
    // a BLANK LINE breaks adjacency → f has NO doc (the comment is loose)
    teko::assert::is_false(first_decl_has_doc("/** not a doc */\n\nfn f(): i32 { 0 }"))
    // a loose banner separated by a blank line from a type → the type has NO doc
    teko::assert::is_false(first_decl_has_doc("/** banner */\n\ntype T = i32"))
    // and the blank-line cases still PARSE (the loose comment is accepted)
    teko::assert::is_true(module_ok("/** not a doc */\n\nfn f(): i32 { 0 }"))
}

/** toks_of — `source` lexed, or an empty token list on a lex fault (a `var`-head test helper: every
    caller here feeds well-formed lexemes, so an empty list only ever surfaces as a loud parse
    failure downstream, never a silent pass). */
fn toks_of(source: str): []lexer::Token {
    match lexer::tokenize(source) { []lexer::Token as ts => ts; error => teko::list::empty() }
}

/**
 * is_var_binding_head_recognizes_the_head_shape — 0.3.1 mudancas-superficie-0.3.1.md §1: `var` is
 * CONTEXTUAL (like `ref`), so `is_var_binding_head` must accept exactly the binding-head shapes
 * (a name then `:`/`=`, or a destructure `{ … }`) and reject every other adjacency — in particular
 * `var` used as a plain identifier (a bare reassignment, or a name with neither `:` nor `=` after
 * it) stays legal, which is the whole point of going contextual instead of reserving the word.
 */
#test
fn is_var_binding_head_recognizes_the_head_shape() {
    teko::assert::is_true(is_var_binding_head(toks_of("var x = 1"), 0))
    teko::assert::is_true(is_var_binding_head(toks_of("var x: i64 = 1"), 0))
    teko::assert::is_true(is_var_binding_head(toks_of("var { a; b } = p"), 0))
    teko::assert::is_false(is_var_binding_head(toks_of("mut x = 1"), 0))
    teko::assert::is_false(is_var_binding_head(toks_of("var = 1"), 0))
    teko::assert::is_false(is_var_binding_head(toks_of("var x 1"), 0))
}

/**
 * bind_kind_at_maps_var_to_mut — `var` and `mut` both stamp `BindKind::Mut` (0.3.1
 * mudancas-superficie-0.3.1.md §1: the single always-mutable local); `let` and `const` keep their
 * own kinds — the additive window changes no existing mapping.
 */
#test
fn bind_kind_at_maps_var_to_mut() {
    teko::assert::is_true(bind_kind_at(toks_of("var x = 1"), 0) == BindKind::Mut)
    teko::assert::is_true(bind_kind_at(toks_of("mut x = 1"), 0) == BindKind::Mut)
    teko::assert::is_true(bind_kind_at(toks_of("let x = 1"), 0) == BindKind::Let)
    teko::assert::is_true(bind_kind_at(toks_of("const x = 1"), 0) == BindKind::Const)
}

/** is_binding_head_recognizes_var — the shared dispatcher predicate opens on `var` exactly when
    `is_var_binding_head` would, and stays closed on a plain `var` reassignment. */
#test
fn is_binding_head_recognizes_var() {
    teko::assert::is_true(is_binding_head(toks_of("var x = 1"), 0))
    teko::assert::is_false(is_binding_head(toks_of("var = 1"), 0))
}

/** stmt_of — `source` parsed as ONE statement, or its error. */
fn stmt_of(source: str): Statement | error {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return error { message = "lex failed" } }
    match parse_statement(toks, 0) { Parsed<Statement> as p => p.node; error as e => return e }
}

/**
 * var_statement_parses_as_mutable_binding — the statement dispatcher (`parse_statement`) routes a
 * `var`-headed statement to `parse_binding`, producing a `Binding` stamped `BindKind::Mut`, with and
 * without a type annotation.
 */
#test
fn var_statement_parses_as_mutable_binding() {
    teko::assert::is_true(match stmt_of("var x = 1") { Statement as s => match s { Binding as b => b.kind == BindKind::Mut; _ => false }; error => false })
    teko::assert::is_true(match stmt_of("var x: i64 = 1") { Statement as s => match s { Binding as b => b.kind == BindKind::Mut && b.has_type; _ => false }; error => false })
}

/**
 * var_reassignment_and_malformed_var_statements — `var` reassignment stays a PLAIN assignment (no
 * binding keyword involved, since `var` is contextual); a `var`-headed destructure parses, and
 * propagates the same barriers `let`/`mut` already carry (an unclosed destructure, and a bare
 * `ref T` annotation — the tripartite-law rejection, now spelled with `var` too).
 */
#test
fn var_reassignment_and_malformed_var_statements() {
    teko::assert::is_false(stmt_errors("var = 1"))
    teko::assert::is_true(block_errors("{ var x 1 }"))
    teko::assert::is_false(stmt_errors("var { a; b } = p"))
    teko::assert::is_true(stmt_errors("var { x = p"))
    teko::assert::is_true(stmt_errors("var x: ref i64 = 1"))
    teko::assert::is_true(stmt_errors("let ref x = 1"))
}

/**
 * hash_inline_accepts_var — `#inline` attaches to a `var` binding exactly as it already does to
 * `let`/`mut`/`const` (`is_binding_head` is the predicate the attribute parser uses).
 */
#test
fn hash_inline_accepts_var() {
    teko::assert::is_false(stmt_errors("#inline var x = 1"))
}

/** hash_inline_rejects_non_binding — the attribute still refuses a non-binding
    statement, `var` included when it is not itself a binding head. */
#test
fn hash_inline_rejects_non_binding() {
    teko::assert::is_true(stmt_errors("#inline var = 1"))
}

/**
 * return_type_name_of — the first path segment of `source`'s parsed function's return type, or ""
 * when `source` fails to parse, has no return type, or the return type is not a plain named type.
 * A tight probe that both graphs feed the SAME parsed type, not merely that parsing succeeds.
 */
fn return_type_name_of(source: str): str {
    var f = match func_of(source) { Function as x => x; error => return "" }
    if !f.has_return { return "" }
    match f.return_type { NamedType as nt => nt.path.segments[0].name; _ => "" }
}

/**
 * A top-level `fn`'s return type parses under `:` exactly as it already does under `->` — same
 * `has_return`/resolved type — and the two graphs may sit on sibling declarations in one module.
 */
#test
fn return_type_colon_accepted_on_functions() {
    teko::assert::is_true(match func_of("fn f(): i64 { return 0 }") { Function as f => f.has_return; error => false })
    teko::assert::is_true(return_type_name_of("fn f(): i64 { return 0 }") == "i64")
    teko::assert::is_true(return_type_name_of("fn f(): i64 { return 0 }") == "i64")
    teko::assert::is_false(func_errors("fn soma(a: i64, b: i64): i64 { return a + b }"))
    teko::assert::is_true(module_ok("fn a(): i64 { 0 }\nfn b(): i64 { 1 }"))
}

/**
 * `:` with no return type, or `:` with no body, are malformed exactly as the `->` equivalents
 * already are — the additive window changes which TOKEN introduces the return type, not the
 * grammar around it.
 */
#test
fn return_type_colon_rejects_malformed_forms() {
    teko::assert::is_true(func_errors("fn f(): { }"))
    teko::assert::is_true(func_errors("fn f(): u8"))
}

/**
 * The `:` grafia also parses at the two OTHER call sites of `parse_function`'s return-type arm: a
 * class method (`allow_receiver`) and a bodyless interface method signature (`allow_bodyless`) —
 * both graphs may even coexist on sibling members of the same interface.
 */
#test
fn return_type_colon_accepted_in_class_and_interface_methods() {
    teko::assert::is_true(module_ok("type Sq = class {\n    pub fn area(self): i64 { self.s }\n}"))
    teko::assert::is_true(module_ok("type Geo = interface {\n    fn area(self): i64\n}"))
    teko::assert::is_true(module_ok("type Geo = interface {\n    fn area(self): i64\n    fn scaled(self, k: i64): i64\n}"))
}

/** first_decl_is_macro — does `source` parse to a module whose first decl is a `MacroDecl`? */
fn first_decl_is_macro(source: str): bool {
    var m = match module_of(source) { Module as mm => mm; error => return false }
    if m.decls.len == 0 { return false }
    match m.decls[0] { MacroDecl => true; _ => false }
}

/** first_decl_is_comptime — does `source` parse to a module whose first decl is a `ComptimeDecl`? */
fn first_decl_is_comptime(source: str): bool {
    var m = match module_of(source) { Module as mm => mm; error => return false }
    if m.decls.len == 0 { return false }
    match m.decls[0] { ComptimeDecl => true; _ => false }
}

/** expr_is_macro_call — does `source` parse to a `MacroCall` expression at position 0? */
fn expr_is_macro_call(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return false }
    match parse_expr(toks, 0) { Parsed<Expr> as pe => match pe.node.kind { MacroCall => true; _ => false }; error => false }
}

/** expr_is_call — does `source` parse to an ordinary runtime `Call` expression at position 0? */
fn expr_is_call(source: str): bool {
    var toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return false }
    match parse_expr(toks, 0) { Parsed<Expr> as pe => match pe.node.kind { Call => true; _ => false }; error => false }
}

/**
 * parses_macro_and_comptime_decls — a `macro name(untyped params) { }` and a
 * `comptime name<T>(params): T { }` both round-trip to their own `Decl` variant (§14.1 A1).
 */
#test
fn parses_macro_and_comptime_decls() {
    teko::assert::is_true(first_decl_is_macro("macro emit(x) { }"))
    teko::assert::is_true(first_decl_is_macro("macro pair(a, b) { }"))
    teko::assert::is_true(first_decl_is_comptime("comptime answer(): i64 { 42 }"))
    teko::assert::is_true(first_decl_is_comptime("comptime sizeof<T>(): u64 { 0 to u64 }"))
}

/**
 * parses_at_macro_call — `@name(...)` / `@name<T>()` parses to a `MacroCall`, while a bare `name(...)`
 * (no `@`) stays an ordinary runtime `Call` (§14.1 A1).
 */
#test
fn parses_at_macro_call() {
    teko::assert::is_true(expr_is_macro_call("@answer()"))
    teko::assert::is_true(expr_is_macro_call("@sizeof<i32>()"))
    teko::assert::is_true(expr_is_call("answer()"))
}

/**
 * rejects_macro_return_and_comptime_without_return — a `macro` may NOT declare a return type (it emits,
 * it does not yield), and a `comptime` MUST declare one (the inlined literal's type) — §14.1.
 */
#test
fn rejects_macro_return_and_comptime_without_return() {
    teko::assert::is_true(module_errors("macro emit(x): i64 { }"))
    teko::assert::is_true(module_errors("comptime answer() { 42 }"))
}

/** macro_body_has_lowering — does `source` parse to a module whose first macro decl body contains a `LoweringFrag`? */
fn macro_body_has_lowering(source: str): bool {
    var m = match module_of(source) { Module as mm => mm; error => return false }
    if m.decls.len == 0 { return false }
    match m.decls[0] {
        MacroDecl as md => {
            var i = 0
            var found = false
            loop {
                if i >= md.body.len { break }
                match md.body[i] { LoweringFrag => found = true; _ => { } }
                i++
            }
            found
        }
        _ => false
    }
}

/**
 * parses_lowering_fragment_in_macro_body — a `lowering { … }` fragment inside a macro body parses to a
 * `LoweringFrag` statement (§14.2 A2), including one carrying a `${expr}` injection hole.
 */
#test
fn parses_lowering_fragment_in_macro_body() {
    teko::assert::is_true(macro_body_has_lowering("macro dbg(x) { lowering { println(x) } }"))
    teko::assert::is_true(macro_body_has_lowering("macro dbg(x) { lowering { f(${x}) } }"))
}
