// src/parser/parser_decl_test.tkt — tests for teko::parser (functions/types/use/module/DI/FFI). #test collected.

// appended to parser_test.tkt — P5a function tests.

// helper: parse a function decl from `source` — the Function, or error.
fn func_of(source: str) -> Function | error {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return error { message = "lex failed" } }
    let pd = match parse_function(toks, 0, false, "", false, false, false, 0 to u64) { Parsed<Decl> as x => x; error as e => return e }
    match pd.node { Function as f => f; _ => error { message = "not a function" } }
}

fn func_errors(source: str) -> bool {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_function(toks, 0, false, "", false, false, false, 0 to u64) { Parsed<Decl> => false; error => true }
}

#test
fn rejects_malformed_functions() {
    teko::assert::is_true(func_errors("fn { }"))   // no name
    teko::assert::is_true(func_errors("fn f { }"))   // no params
    teko::assert::is_true(func_errors("fn f() -> { }"))   // `->` with no return type
    teko::assert::is_true(func_errors("fn f() -> u8"))   // no body
    teko::assert::is_true(func_errors("fn f(x) { }"))   // param with no type
}

// appended to parser_test.tkt — P5b struct type-decl tests.

fn type_decl_errors(source: str) -> bool {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_type_decl(toks, 0) { Parsed<Decl> as pd => pd.next < toks.len; error => true }
}

#test
fn rejects_malformed_struct() {
    teko::assert::is_true(type_decl_errors("type = struct { }"))   // no name
    teko::assert::is_true(type_decl_errors("type T struct { }"))   // no `=`
    teko::assert::is_true(type_decl_errors("type T = struct x: i32 }"))   // no `{`
    teko::assert::is_true(type_decl_errors("type T = struct { x }"))   // field with no type
    teko::assert::is_true(type_decl_errors("type T = struct { x: i32 y: i32 }"))   // two fields, no separator
}

// appended to parser_test.tkt — P5c enum/variant tests.

#test
fn rejects_malformed_enum_variant() {
    teko::assert::is_true(type_decl_errors("type C = enum Red }"))   // no `{` after `enum`
    teko::assert::is_true(type_decl_errors("type C = enum { 5 }"))   // a number is not a member name
    teko::assert::is_true(type_decl_errors("type S = variant"))   // variant with no type
    teko::assert::is_true(type_decl_errors("type T = thing { }"))   // not struct/enum/variant
}

// appended to parser_test.tkt — P5d standalone `use` tests.

fn use_errors(source: str) -> bool {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_use(toks, 0) { Parsed<UseDecl> => false; error => true }
}

#test
fn rejects_malformed_use() {
    teko::assert::is_true(use_errors("use"))   // no path
    teko::assert::is_true(use_errors("use a as"))   // `as` with no alias name
    teko::assert::is_true(use_errors("use ::"))   // `::` with no leading name
    teko::assert::is_true(use_errors("use a::"))   // trailing `::` with no name and no `[`
}

#test
fn rejects_malformed_grouped_use_import() {
    teko::assert::is_true(use_errors("use path::[ ]"))   // empty list
    teko::assert::is_true(use_errors("use path::[ A B ]"))   // missing comma
    teko::assert::is_true(use_errors("use path::[ A, ]"))   // trailing comma
    teko::assert::is_true(use_errors("use path::[ A, B"))   // unclosed list
    teko::assert::is_true(use_errors("use path::[ A, B ] as x"))   // no alias on a grouped import
}

// appended to parser_test.tkt — R-main-c module tests.

fn module_of(source: str) -> Module | error {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return error { message = "lex failed" } }
    let pm = match parse_module(toks, 0) { Parsed<Module> as x => x; error as e => return e }
    pm.node
}

fn module_errors(source: str) -> bool {
    let toks = match lexer::tokenize(source) { []lexer::Token as ts => ts; error => return true }
    match parse_module(toks, 0) { Parsed<Module> => false; error => true }
}

/**
 * A module-level `const` REQUIRES both a type annotation and an initializer; omitting
 * either is a located parse error (#594 crumb 1).
 */
#test
fn rejects_ill_formed_module_const() {
    teko::assert::is_true(module_errors("const C = 1"))
    teko::assert::is_true(module_errors("const D: i64"))
}

// appended to parser_test.tkt — P6 end-to-end integration.

#test
fn struct_literal_separator_is_semicolon() {
    // a struct literal MUST separate fields with `;` (not `,`): the `,` form is rejected.
    teko::assert::is_true(module_errors("fn f() -> P { P { a = 1, b = 2 } }"))   // `,` between fields → error
    // the `;` form parses fine (no barrier).
    teko::assert::is_true(!module_errors("fn f() -> P { P { a = 1; b = 2 } }"))   // `;` between fields → ok
}

// --- (#111) own-line `/** … */` doc comments — must parse and ATTACH to the NEXT declaration,
// same as the pre-existing same-line placement (Javadoc/rustdoc/JSDoc-style is own-line). ---

/** The `DiKind` carried by the first declaration of `source`, or `DiKind::None` if it is not a
 *  type decl — a parser-test accessor for the W10c lifetime-annotation cases below. */
fn first_decl_di_kind(source: str) -> DiKind {
    match module_of(source) {
        Module as m => match m.decls[0] { TypeDecl as td => td.di_kind; _ => DiKind::None }
        error => DiKind::None
    }
}

#test
fn parses_lifetime_annotations_on_a_type() {
    teko::assert::is_true(first_decl_di_kind("#singleton\ntype Logger = class { }") == DiKind::Singleton)
    teko::assert::is_true(first_decl_di_kind("#scoped\ntype Session = class { }") == DiKind::Scoped)
    teko::assert::is_true(first_decl_di_kind("#transient\ntype Handler = class { }") == DiKind::Transient)
    teko::assert::is_true(first_decl_di_kind("type Plain = class { }") == DiKind::None)
}

#test
fn rejects_swapped_di_placement() {
    teko::assert::is_true(module_errors("#singleton\nfn handle() { }"))
    teko::assert::is_true(module_errors("#inject(log: Logger)\ntype Logger = class { }"))
}

/** The `must_free` flag carried by the first declaration of `source`, or `false` if it is
 *  not a type decl — a parser-test accessor for the S2 (#336) `#must_free` cases below. */
fn first_decl_must_free(source: str) -> bool {
    match module_of(source) {
        Module as m => match m.decls[0] { TypeDecl as td => td.must_free; _ => false }
        error => false
    }
}

/**
 * S2 (#336) acceptance 1: `#must_free type FileHandle = class { … }` parses, with the
 * resulting `TypeDecl.must_free` set to true; a plain `type` (no `#must_free`) stays false.
 */
#test
fn parses_must_free_attribute_on_a_type() {
    teko::assert::is_true(first_decl_must_free("#must_free\ntype FileHandle = class { }"))
    teko::assert::is_true(first_decl_must_free("#must_free\ntype M = struct { p: u8 }"))
    teko::assert::is_false(first_decl_must_free("type Plain = class { }"))
}

/**
 * S2 (#336) acceptance 5: `#must_free` may only precede a `type` — rejected before a `fn`,
 * rejected before a `flags`, and (since `#` never starts a statement) a leading `#must_free`
 * before a `let` fails to parse as a declaration in the first place.
 */
#test
fn rejects_must_free_on_fn_flags_and_let() {
    teko::assert::is_true(module_errors("#must_free\nfn handle() { }"))
    teko::assert::is_true(module_errors("#must_free\nflags F { A; B }"))
    teko::assert::is_true(module_errors("#must_free\nlet x = 1"))
}

/**
 * The `c_symbol` an `exp` function carries after parsing `source`'s first declaration (the reverse-FFI
 * `exp("…")` override, "" when none), or "<err>" when the module fails to parse.
 *
 * @param source  a single-declaration module
 * @return        the parsed function's `c_symbol`, or "<err>"
 */
fn ffx_first_fn_c_symbol(source: str) -> str {
    let m = match module_of(source) { Module as x => x; error => return "<err>" }
    if m.decls.len == 0 { return "<err>" }
    match m.decls[0] { Function as f => f.c_symbol; _ => "<err>" }
}

/**
 * Whether the first declaration of `source` parses as a NON-extern `exp` function (the export shape).
 *
 * @param source  a single-declaration module
 * @return        true iff the first decl is an `exp`, non-extern function
 */
fn ffx_first_fn_is_plain_exp(source: str) -> bool {
    let m = match module_of(source) { Module as x => x; error => return false }
    if m.decls.len == 0 { return false }
    match m.decls[0] { Function as f => f.vis == Visibility::Exp && !f.is_extern; _ => false }
}

/**
 * The `exp("c_name")` override captures the C export symbol onto a plain (non-extern) `exp` function.
 */
#test
fn ffx_parses_export_override() {
    teko::assert::is_true(ffx_first_fn_c_symbol("exp(\"teko_add\") fn add(a: i64, b: i64) -> i64 { a }") == "teko_add")
    teko::assert::is_true(ffx_first_fn_is_plain_exp("exp(\"teko_add\") fn add(a: i64, b: i64) -> i64 { a }"))
}

/**
 * A bare `exp` (no override) leaves the export symbol empty — the flatten-canonical default applies later.
 */
#test
fn ffx_bare_exp_has_no_override() {
    teko::assert::is_true(ffx_first_fn_c_symbol("exp fn add(a: i64) -> i64 { a }") == "")
}

/**
 * A malformed override — a missing `)`, a non-string argument, and the override on an `extern` import —
 * each fails to parse (M.3 — no silent coercion).
 */
#test
fn ffx_rejects_malformed_export_override() {
    teko::assert::is_true(module_errors("exp(\"teko_add\" fn add() -> i64 { 0 }"))
    teko::assert::is_true(module_errors("exp(42) fn add() -> i64 { 0 }"))
    teko::assert::is_true(module_errors("exp(\"x\") extern fn c_add(a: i64) -> i64 = \"c_add\""))
}

/**
 * The FFI IMPORT surface: `extern fn name(...) -> R = "SYM" from "lib"` parses as a bodyless foreign
 * function carrying its C symbol and providing library (the FFI-in base, task item 1).
 */
#test
fn ffx_parses_extern_import() {
    let m = match module_of("extern fn strlen(s: u64) -> u64 = \"strlen\" from \"c\"") { Module as x => x; error => return teko::assert::is_true(false) }
    teko::assert::is_true(m.decls.len == 1)
    match m.decls[0] {
        Function as f => {
            teko::assert::is_true(f.is_extern)
            teko::assert::is_true(f.c_symbol == "strlen")
            teko::assert::is_true(f.from_lib == "c")
        }
        _ => teko::assert::is_true(false)
    }
}
