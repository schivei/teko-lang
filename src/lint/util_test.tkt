/**
 * has_prefix_true_and_false — the exact-prefix and shorter-than-prefix cases, plus the
 * empty-prefix vacuous-true case.
 *
 * @return void
 */
#test
fn has_prefix_true_and_false() {
    teko::assert::is_true(has_prefix("use teko::io", "use "))
    teko::assert::is_false(has_prefix("us", "use "))
    teko::assert::is_false(has_prefix("import teko::io", "use "))
    teko::assert::is_true(has_prefix("anything", ""))
}

/**
 * trim_left_strips_leading_whitespace — spaces/tabs are dropped; a line with none is unchanged;
 * an all-whitespace line trims to empty.
 *
 * @return void
 */
#test
fn trim_left_strips_leading_whitespace() {
    teko::assert::is_true(trim_left("    use a::b") == "use a::b")
    teko::assert::is_true(trim_left("\tuse a::b") == "use a::b")
    teko::assert::is_true(trim_left("use a::b") == "use a::b")
    teko::assert::is_true(trim_left("   ") == "")
}

/**
 * join_lines_round_trips_split_lines — joining the pieces `teko::iter::split_lines` produces
 * reconstructs the original (no-trailing-newline) text; the empty list joins to "".
 *
 * @return void
 */
#test
fn join_lines_round_trips_split_lines() {
    let original = "a\nbb\nccc"
    teko::assert::is_true(join_lines(teko::iter::split_lines(original)) == original)
    let empty: []str = teko::list::empty()
    teko::assert::is_true(join_lines(empty) == "")
    let one = teko::list::push(teko::list::empty(), "solo")
    teko::assert::is_true(join_lines(one) == "solo")
}

/**
 * str_list_contains_finds_membership — present, absent, and empty-list cases.
 *
 * @return void
 */
#test
fn str_list_contains_finds_membership() {
    let xs = teko::list::push(teko::list::push(teko::list::empty(), "a"), "b")
    teko::assert::is_true(str_list_contains(xs, "a"))
    teko::assert::is_true(str_list_contains(xs, "b"))
    teko::assert::is_false(str_list_contains(xs, "c"))
    let empty: []str = teko::list::empty()
    teko::assert::is_false(str_list_contains(empty, "a"))
}
