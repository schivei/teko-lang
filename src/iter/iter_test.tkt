fn counting_identity(ref cell: i64): func<i64, i64> {
    var c: func<i64, i64> = (x: i64) => { cell.value = cell.value + 1; x }
    c
}

fn or_else(value: i64 | null, sentinel: i64): i64 {
    match value {
        i64 as v => v
        null => sentinel
    }
}

#test
fn once_and_empty_edge_sources() {
    var oc = OnceCursor { emitted = false }
    var single = collect(once(7, oc))
    teko::assert::is_true(single.len == 1)
    teko::assert::is_true(single[0] == 7)
    var nothing = collect(empty())
    teko::assert::is_true(nothing.len == 0)
}

fn is_even_local(x: i64): bool { x % 2 == 0 }

fn add_local(a: i64, x: i64): i64 { a + x }

#test
fn take_and_skip_slice() {
    var rc = RangeCursor { next = 0; hi = 5 }
    var tc = TakeCursor { left = 2 }
    var leading = collect(take(range(rc), tc))
    teko::assert::is_true(leading.len == 2)
    teko::assert::is_true(leading[1] == 1)
    var rc2 = RangeCursor { next = 0; hi = 5 }
    var sc = SkipCursor { left = 2 }
    var trailing = collect(skip(range(rc2), sc))
    teko::assert::is_true(trailing.len == 3)
    teko::assert::is_true(trailing[0] == 2)
}

#test
fn enumerate_pairs_indices() {
    var ac = ArrayCursor { pos = 0 }
    var ec = EnumCursor { index = 0 }
    var en = enumerate(over_array([10, 20, 30], ac), ec)
    var first = en()
    var first_index = match first { IntIndexed as ix => ix.index; null => -1 }
    var first_value = match first { IntIndexed as ix => ix.value; null => -1 }
    teko::assert::is_true(first_index == 0)
    teko::assert::is_true(first_value == 10)
    var second = en()
    var second_index = match second { IntIndexed as ix => ix.index; null => -1 }
    var second_value = match second { IntIndexed as ix => ix.value; null => -1 }
    teko::assert::is_true(second_index == 1)
    teko::assert::is_true(second_value == 20)
}

#test
fn zip_stops_at_the_shorter() {
    var ra = RangeCursor { next = 0; hi = 2 }
    var rb = RangeCursor { next = 100; hi = 105 }
    var z = zip(range(ra), range(rb))
    var p0 = z()
    var p0_sum = match p0 { IntPair as p => p.first + p.second; null => -1 }
    teko::assert::is_true(p0_sum == 100)
    var p1 = z()
    var p1_sum = match p1 { IntPair as p => p.first + p.second; null => -1 }
    teko::assert::is_true(p1_sum == 102)
    var p2 = z()
    var exhausted = match p2 { IntPair => false; null => true }
    teko::assert::is_true(exhausted)
}

#test
fn chain_concatenates() {
    var ra = RangeCursor { next = 0; hi = 2 }
    var rb = RangeCursor { next = 10; hi = 12 }
    var cc = ChainCursor { first_done = false }
    var collected = collect(chain(range(ra), range(rb), cc))
    teko::assert::is_true(collected.len == 4)
    teko::assert::is_true(collected[0] == 0)
    teko::assert::is_true(collected[2] == 10)
    teko::assert::is_true(collected[3] == 11)
}

#test
fn fold_sum_count_terminals() {
    var rc = RangeCursor { next = 1; hi = 5 }
    var folded = fold(range(rc), 0, add_local)
    teko::assert::is_true(folded == 10)
    var rc2 = RangeCursor { next = 1; hi = 5 }
    teko::assert::is_true(sum(range(rc2)) == 10)
    var rc3 = RangeCursor { next = 1; hi = 5 }
    teko::assert::is_true(count(range(rc3)) == 4)
}

#test
fn reduce_terminal() {
    var rc = RangeCursor { next = 1; hi = 4 }
    var reduced = reduce(range(rc), add_local)
    teko::assert::is_true(or_else(reduced, -1) == 6)
    var empty_rc = RangeCursor { next = 0; hi = 0 }
    var reduced_empty = reduce(range(empty_rc), add_local)
    var is_empty = match reduced_empty { i64 => false; null => true }
    teko::assert::is_true(is_empty)
}

#test
fn any_all_find_terminals() {
    var rc = RangeCursor { next = 0; hi = 6 }
    teko::assert::is_true(any(range(rc), is_even_local))
    var rc2 = RangeCursor { next = 1; hi = 6 }
    var rc3 = RangeCursor { next = 0; hi = 6 }
    teko::assert::is_true(all(range(rc2), is_even_local) == false)
    teko::assert::is_true(all(range(rc3), is_gte_zero_local))
    var rc4 = RangeCursor { next = 1; hi = 6 }
    var found = find(range(rc4), is_even_local)
    teko::assert::is_true(or_else(found, -1) == 2)
    var rc5 = RangeCursor { next = 1; hi = 2 }
    var missed = find(range(rc5), is_even_local)
    var is_miss = match missed { i64 => false; null => true }
    teko::assert::is_true(is_miss)
}

fn is_gte_zero_local(x: i64): bool { x >= 0 }

#test
fn bytes_pipeline() {
    var bc = ByteCursor { pos = 0 }
    var tbc = TakeByteCursor { left = 3 }
    var taken = collect_bytes(take_bytes(over_bytes(bytes_of_str("hello"), bc), tbc))
    teko::assert::is_true(taken.len == 3)
    teko::assert::is_true(taken[0] == b'h')
    teko::assert::is_true(taken[1] == b'e')
    teko::assert::is_true(taken[2] == b'l')
}

#test
fn lines_pipeline() {
    var lines = split_lines("alpha\nbeta\ngamma")
    teko::assert::is_true(lines.len == 3)
    var sc = StrCursor { pos = 0 }
    var collected = collect_strs(over_strs(lines, sc))
    teko::assert::is_true(collected.len == 3)
    teko::assert::is_true(collected[0] == "alpha")
    teko::assert::is_true(collected[2] == "gamma")
}
