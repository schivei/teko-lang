/** teko::fs::list_dir — the entries of the directory at `path` (excluding "." and "..").
 * @return the entries, or an error when the directory cannot be opened. */
exp extern fn list_dir(path: str): []str | error = "tk_rt_list_dir" from "teko_rt"

/** teko::fs::mkdir — create a directory at `path` with mode 0755; succeeds when it already
 * exists. */
exp extern fn mkdir(path: str): error | null = "tk_rt_mkdir" from "teko_rt"

/** teko::fs::remove_file — delete the file at `path`; succeeds when it is already absent. */
exp extern fn remove_file(path: str): error | null = "tk_rt_remove_file" from "teko_rt"
