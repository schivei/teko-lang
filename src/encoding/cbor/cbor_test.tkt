fn bytes_lit(xs: []i64): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i] to byte)
        i++
    }
    out
}

fn slices_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn expect_value(result: CborValue | error): CborValue {
    match result {
        CborValue as v => v
        error => { teko::assert::is_true(false); cbor_null() }
    }
}

fn expect_error(result: CborValue | error) {
    match result {
        CborValue => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

fn assert_vector(v: CborValue, want: []byte) {
    teko::assert::is_true(slices_equal(encode(v), want))
    teko::assert::is_true(cbor_equal(v, expect_value(decode(want))))
}

fn assert_float(vec: []byte, want: f64) {
    var v = expect_value(decode(vec))
    teko::assert::is_true(v.kind == CborKind::Float)
    teko::assert::eq_f64(v.real, want, 0.0)
}

fn pair(a: CborValue, b: CborValue): []CborValue {
    var out: []CborValue = []
    out = teko::list::push(out, a)
    out = teko::list::push(out, b)
    out
}

#test
fn unsigned_integers_match_appendix_a() {
    assert_vector(cbor_uint(0), bytes_lit([0x00]))
    assert_vector(cbor_uint(23), bytes_lit([0x17]))
    assert_vector(cbor_uint(24), bytes_lit([0x18, 0x18]))
    assert_vector(cbor_uint(1000), bytes_lit([0x19, 0x03, 0xe8]))
    assert_vector(cbor_uint(1000000), bytes_lit([0x1a, 0x00, 0x0f, 0x42, 0x40]))
    assert_vector(cbor_uint(1000000000000), bytes_lit([0x1b, 0x00, 0x00, 0x00, 0xe8, 0xd4, 0xa5, 0x10, 0x00]))
    assert_vector(cbor_uint(18446744073709551615), bytes_lit([0x1b, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff]))
}

#test
fn negative_integers_match_appendix_a() {
    assert_vector(cbor_int(-1), bytes_lit([0x20]))
    assert_vector(cbor_int(-10), bytes_lit([0x29]))
    assert_vector(cbor_int(-100), bytes_lit([0x38, 0x63]))
    assert_vector(cbor_int(-1000), bytes_lit([0x39, 0x03, 0xe7]))
}

#test
fn strings_match_appendix_a() {
    assert_vector(cbor_bytes(bytes_lit([0x01, 0x02, 0x03, 0x04])), bytes_lit([0x44, 0x01, 0x02, 0x03, 0x04]))
    assert_vector(cbor_text(""), bytes_lit([0x60]))
    assert_vector(cbor_text("IETF"), bytes_lit([0x64, 0x49, 0x45, 0x54, 0x46]))
    assert_vector(cbor_text("\"\\"), bytes_lit([0x62, 0x22, 0x5c]))
    assert_vector(cbor_text("ü"), bytes_lit([0x62, 0xc3, 0xbc]))
}

#test
fn containers_match_appendix_a() {
    assert_vector(cbor_array([]), bytes_lit([0x80]))
    var inner1 = cbor_array(pair(cbor_uint(2), cbor_uint(3)))
    var inner2 = cbor_array(pair(cbor_uint(4), cbor_uint(5)))
    var nested = cbor_array(teko::list::push(pair(cbor_uint(1), inner1), inner2))
    assert_vector(nested, bytes_lit([0x83, 0x01, 0x82, 0x02, 0x03, 0x82, 0x04, 0x05]))
    assert_vector(cbor_map([], []), bytes_lit([0xa0]))
    var mk = pair(cbor_text("a"), cbor_text("b"))
    var mv = pair(cbor_uint(1), cbor_array(pair(cbor_uint(2), cbor_uint(3))))
    assert_vector(cbor_map(mk, mv), bytes_lit([0xa2, 0x61, 0x61, 0x01, 0x61, 0x62, 0x82, 0x02, 0x03]))
}

#test
fn tags_match_appendix_a() {
    assert_vector(cbor_tag(1, cbor_uint(1363896240)), bytes_lit([0xc1, 0x1a, 0x51, 0x4b, 0x67, 0xb0]))
    assert_vector(cbor_tag(23, cbor_bytes(bytes_lit([0x01, 0x02, 0x03, 0x04]))), bytes_lit([0xd7, 0x44, 0x01, 0x02, 0x03, 0x04]))
}

#test
fn simple_values_match_appendix_a() {
    assert_vector(cbor_bool(false), bytes_lit([0xf4]))
    assert_vector(cbor_bool(true), bytes_lit([0xf5]))
    assert_vector(cbor_null(), bytes_lit([0xf6]))
    assert_vector(cbor_undefined(), bytes_lit([0xf7]))
    assert_vector(cbor_simple(16), bytes_lit([0xf0]))
    assert_vector(cbor_simple(255), bytes_lit([0xf8, 0xff]))
}

#test
fn floats_decode_across_widths() {
    assert_float(bytes_lit([0xf9, 0x00, 0x00]), 0.0)
    assert_float(bytes_lit([0xf9, 0x3c, 0x00]), 1.0)
    assert_float(bytes_lit([0xf9, 0x3e, 0x00]), 1.5)
    assert_float(bytes_lit([0xf9, 0x7b, 0xff]), 65504.0)
    assert_float(bytes_lit([0xf9, 0xc4, 0x00]), -4.0)
    assert_float(bytes_lit([0xf9, 0x04, 0x00]), 0.00006103515625)
    assert_float(bytes_lit([0xfa, 0x47, 0xc3, 0x50, 0x00]), 100000.0)
    assert_float(bytes_lit([0xfb, 0x7e, 0x37, 0xe4, 0x3c, 0x88, 0x00, 0x75, 0x9c]), 1.0e+300)
    assert_vector(cbor_float(1.5), bytes_lit([0xfb, 0x3f, 0xf8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]))
}

#test
fn indefinite_length_items_decode() {
    var joined = cbor_bytes(bytes_lit([0x01, 0x02, 0x03, 0x04, 0x05]))
    teko::assert::is_true(cbor_equal(joined, expect_value(decode(bytes_lit([0x5f, 0x42, 0x01, 0x02, 0x43, 0x03, 0x04, 0x05, 0xff])))))
    teko::assert::is_true(cbor_equal(cbor_text("streaming"), expect_value(decode(bytes_lit([0x7f, 0x65, 0x73, 0x74, 0x72, 0x65, 0x61, 0x64, 0x6d, 0x69, 0x6e, 0x67, 0xff])))))
    teko::assert::is_true(cbor_equal(cbor_array([]), expect_value(decode(bytes_lit([0x9f, 0xff])))))
    var mk = pair(cbor_text("a"), cbor_text("b"))
    var mv = pair(cbor_uint(1), cbor_array(pair(cbor_uint(2), cbor_uint(3))))
    teko::assert::is_true(cbor_equal(cbor_map(mk, mv), expect_value(decode(bytes_lit([0xbf, 0x61, 0x61, 0x01, 0x61, 0x62, 0x9f, 0x02, 0x03, 0xff, 0xff])))))
}

#test
fn canonical_encoding_sorts_map_keys() {
    var keys: []CborValue = []
    keys = teko::list::push(keys, cbor_uint(10))
    keys = teko::list::push(keys, cbor_uint(1))
    keys = teko::list::push(keys, cbor_text("z"))
    var vals: []CborValue = []
    vals = teko::list::push(vals, cbor_uint(0))
    vals = teko::list::push(vals, cbor_uint(0))
    vals = teko::list::push(vals, cbor_uint(0))
    var got = encode_canonical(cbor_map(keys, vals))
    teko::assert::is_true(slices_equal(got, bytes_lit([0xa3, 0x01, 0x00, 0x0a, 0x00, 0x61, 0x7a, 0x00])))
}

#test
fn malformed_inputs_are_errors() {
    expect_error(decode(bytes_lit([0x18])))
    expect_error(decode(bytes_lit([0x44, 0x01, 0x02])))
    expect_error(decode(bytes_lit([0x83, 0x01, 0x02])))
    expect_error(decode(bytes_lit([0x00, 0x00])))
    expect_error(decode(bytes_lit([0x1c])))
    expect_error(decode(bytes_lit([0xff])))
}
