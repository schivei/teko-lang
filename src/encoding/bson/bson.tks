/**
 * `teko::encoding::bson` — a pure-Teko BSON (Binary JSON, the MongoDB wire/document format,
 * bsonspec.org) encoder + decoder over `[]byte` (catalog entry S-BSON, §1.5). Pure Teko, no C
 * twin: like `teko::encoding::json` / `teko::encoding::cbor`, a library with zero OS/FFI
 * dependency ships as `.tks` + `.tkt` only. This unit is the document codec the native
 * `teko::db::mongodb` driver rides on (OP_MSG carries BSON documents), so its byte layout must
 * match a reference encoder (pymongo / libbson) exactly.
 *
 * VALUE MODEL — a TAGGED STRUCT, not an inline union. `BsonValue` carries a `BsonKind`
 * discriminant plus the union of every element type's payload; `kind` selects which fields are
 * meaningful (the `teko::encoding::cbor` / `teko::encoding::xml` tag-struct discipline). A document
 * is stored as parallel `keys` (field names) and `vals` slices; an array stores its elements in
 * `vals` (the `"0"`, `"1"`, … integer field names are synthesised on encode and skipped on
 * decode).
 *
 * SCOPE (this unit). The element types a MongoDB application document needs: double (`0x01`),
 * UTF-8 string (`0x02`), embedded document (`0x03`), array (`0x04`), binary with subtype
 * (`0x05`), ObjectId (`0x07`), boolean (`0x08`), UTC datetime (`0x09`, milliseconds since the
 * Unix epoch), null (`0x0A`), 32-bit integer (`0x10`), timestamp (`0x11`), 64-bit integer
 * (`0x12`), 128-bit decimal (`0x13`), min key (`0xFF`), and max key (`0x7F`). Every integer is
 * little-endian; documents are framed by a leading total-length `int32` and a trailing `0x00`.
 *
 * NAMED SEAM (honest — M.3). Decimal128 is carried as its raw 16 bytes: it round-trips
 * byte-for-byte but is NOT parsed into a decimal magnitude here (the IEEE 754-2008 decimal
 * arithmetic is a follow-on). The deprecated element types (undefined `0x06`, DBPointer `0x0C`,
 * JavaScript code `0x0D`/`0x0F`, symbol `0x0E`, regex `0x0B`) are out of scope; decoding one is a
 * checked `error`, never a silent skip.
 *
 * ERROR MODEL (M.1 fail-loud / M.3 honest types). `decode(p: []byte): BsonValue | error` — a
 * truncated document, a length that disagrees with the terminator, an unterminated cstring, an
 * unknown element type, or a malformed ObjectId/Decimal128 length is a checked failure, never a
 * panic. `encode(doc: BsonValue): []byte | error` rejects a non-document top level, a field name
 * containing an interior NUL (illegal in a BSON cstring), and a mis-sized ObjectId (must be 12
 * bytes) / Decimal128 (must be 16 bytes).
 */

/**
 * The kind discriminant of a `BsonValue`: which BSON element type it holds. Each maps to a BSON
 * type byte (see the module doc's SCOPE note).
 */
exp type BsonKind = enum {
    Double; String; Document; Array; Binary; ObjectId; Bool; DateTime; Null; Int32; Int64; Timestamp; Decimal128; MinKey; MaxKey
}

/**
 * One BSON element value as a tagged struct spanning every `BsonKind` (see the module doc's VALUE
 * MODEL note): `kind` selects which fields below carry meaning.
 */
exp type BsonValue = struct {
    /**
     * Which BSON element type this is; selects which of the fields below are meaningful.
     */
    kind: BsonKind
    /**
     * The floating-point value for `Double`. Zero otherwise.
     */
    real: f64
    /**
     * The string content for `String`. Empty otherwise.
     */
    text: str
    /**
     * The boolean value for `Bool`. `false` otherwise.
     */
    flag: bool
    /**
     * The signed integer for `Int32` and `Int64`, and the millisecond instant for `DateTime`.
     * Zero otherwise.
     */
    int_val: i64
    /**
     * The unsigned value for `Timestamp` (the combined 64-bit BSON timestamp). Zero otherwise.
     */
    uint_val: u64
    /**
     * The payload bytes for `Binary`, the 12 bytes for `ObjectId`, and the 16 bytes for
     * `Decimal128`. Empty otherwise.
     */
    bytes: []byte
    /**
     * The binary subtype for `Binary` (e.g. `0x00` generic, `0x04` UUID). Zero otherwise.
     */
    subtype: byte
    /**
     * The field names of a `Document`, parallel to `vals`. Empty for an `Array` (its names are the
     * synthesised decimal indices) and for scalars.
     */
    keys: []str
    /**
     * The field values of a `Document` and the elements of an `Array`. Empty for scalars.
     */
    vals: []BsonValue
}

/**
 * A decoded value paired with the offset just past it — the internal cursor result threaded
 * through the recursive decoder.
 */
type BsonRead = struct {
    /**
     * The value decoded at the requested offset.
     */
    value: BsonValue
    /**
     * The offset of the first byte AFTER the decoded value.
     */
    pos: u64
}

/**
 * A decoded document body: its parallel field names and values plus the offset past the trailing
 * `0x00`.
 */
type DocRead = struct {
    /**
     * The document's field names, parallel to `vals`.
     */
    keys: []str
    /**
     * The document's field values, parallel to `keys`.
     */
    vals: []BsonValue
    /**
     * The offset of the first byte after the document's terminator.
     */
    pos: u64
}

/**
 * A decoded null-terminated field name paired with the offset past its terminator.
 */
type NameRead = struct {
    /**
     * The field name (the cstring content, terminator excluded).
     */
    name: str
    /**
     * The offset of the first byte after the terminating `0x00`.
     */
    pos: u64
}

/**
 * A fresh empty `[]byte`, the default for the byte-carrying field of a `BsonValue`.
 *
 * @return  an empty byte slice
 */
fn no_bytes(): []byte {
    teko::list::empty()
}

/**
 * A fresh empty `[]str`, the default for the key field of a `BsonValue`.
 *
 * @return  an empty string slice
 */
fn no_keys(): []str {
    teko::list::empty()
}

/**
 * A fresh empty `[]BsonValue`, the default for the value field of a `BsonValue`.
 *
 * @return  an empty value slice
 */
fn no_vals(): []BsonValue {
    teko::list::empty()
}

/**
 * Builds a `BsonValue` from every field explicitly — the single constructor the public builders
 * funnel through so each records only the fields its kind uses and leaves the rest at defaults.
 *
 * @param kind      the element's kind discriminant
 * @param real      the floating-point value (see `BsonValue.real`)
 * @param text      the string content (see `BsonValue.text`)
 * @param flag      the boolean value (see `BsonValue.flag`)
 * @param int_val   the signed integer / datetime (see `BsonValue.int_val`)
 * @param uint_val  the timestamp (see `BsonValue.uint_val`)
 * @param bytes     the binary / ObjectId / Decimal128 bytes (see `BsonValue.bytes`)
 * @param subtype   the binary subtype (see `BsonValue.subtype`)
 * @param keys      the document field names (see `BsonValue.keys`)
 * @param vals      the document / array values (see `BsonValue.vals`)
 * @return          the assembled value
 */
fn mk_value(kind: BsonKind, real: f64, text: str, flag: bool, int_val: i64, uint_val: u64, bytes: []byte, subtype: byte, keys: []str, vals: []BsonValue): BsonValue {
    BsonValue { kind = kind; real = real; text = text; flag = flag; int_val = int_val; uint_val = uint_val; bytes = bytes; subtype = subtype; keys = keys; vals = vals }
}

/**
 * Wraps a double as a `0x01` element value.
 *
 * @param x  the value
 * @return   the BSON double value
 */
exp fn bson_double(x: f64): BsonValue {
    mk_value(BsonKind::Double, x, "", false, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a UTF-8 string as a `0x02` element value.
 *
 * @param s  the string
 * @return   the BSON string value
 */
exp fn bson_string(s: str): BsonValue {
    mk_value(BsonKind::String, 0.0, s, false, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps parallel field-name / value slices as an embedded document (`0x03`, also the `0x04` array
 * body form). `keys[i]` names `vals[i]`; the two slices must have the same length.
 *
 * @param keys  the field names
 * @param vals  the field values, parallel to `keys`
 * @return      the BSON document value
 */
exp fn bson_document(keys: []str, vals: []BsonValue): BsonValue {
    mk_value(BsonKind::Document, 0.0, "", false, 0, 0, no_bytes(), 0 to byte, keys, vals)
}

/**
 * Wraps a sequence of elements as a `0x04` array value; the integer field names are synthesised on
 * encode.
 *
 * @param vals  the array elements
 * @return      the BSON array value
 */
exp fn bson_array(vals: []BsonValue): BsonValue {
    mk_value(BsonKind::Array, 0.0, "", false, 0, 0, no_bytes(), 0 to byte, no_keys(), vals)
}

/**
 * Wraps payload bytes and a subtype as a `0x05` binary value.
 *
 * @param subtype  the binary subtype byte
 * @param data     the payload bytes
 * @return         the BSON binary value
 */
exp fn bson_binary(subtype: byte, data: []byte): BsonValue {
    mk_value(BsonKind::Binary, 0.0, "", false, 0, 0, data, subtype, no_keys(), no_vals())
}

/**
 * Wraps 12 bytes as a `0x07` ObjectId value. Encoding rejects a slice that is not exactly 12
 * bytes.
 *
 * @param id  the 12 ObjectId bytes
 * @return    the BSON ObjectId value
 */
exp fn bson_objectid(id: []byte): BsonValue {
    mk_value(BsonKind::ObjectId, 0.0, "", false, 0, 0, id, 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a boolean as a `0x08` element value.
 *
 * @param b  the boolean
 * @return   the BSON boolean value
 */
exp fn bson_bool(b: bool): BsonValue {
    mk_value(BsonKind::Bool, 0.0, "", b, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a millisecond instant as a `0x09` UTC datetime value.
 *
 * @param ms  milliseconds since the Unix epoch (may be negative for instants before 1970)
 * @return    the BSON datetime value
 */
exp fn bson_datetime(ms: i64): BsonValue {
    mk_value(BsonKind::DateTime, 0.0, "", false, ms, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * The `0x0A` null element value.
 *
 * @return  the BSON null value
 */
exp fn bson_null(): BsonValue {
    mk_value(BsonKind::Null, 0.0, "", false, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a 32-bit integer as a `0x10` element value; the low 32 bits are encoded.
 *
 * @param v  the signed value, `[-2^31, 2^31 - 1]`
 * @return   the BSON int32 value
 */
exp fn bson_int32(v: i64): BsonValue {
    mk_value(BsonKind::Int32, 0.0, "", false, v, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a 64-bit integer as a `0x12` element value.
 *
 * @param v  the signed value
 * @return   the BSON int64 value
 */
exp fn bson_int64(v: i64): BsonValue {
    mk_value(BsonKind::Int64, 0.0, "", false, v, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps a 64-bit BSON timestamp as a `0x11` element value.
 *
 * @param t  the combined timestamp (increment in the low 32 bits, seconds in the high 32)
 * @return   the BSON timestamp value
 */
exp fn bson_timestamp(t: u64): BsonValue {
    mk_value(BsonKind::Timestamp, 0.0, "", false, 0, t, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Wraps 16 bytes as a `0x13` Decimal128 value (carried verbatim; see the module doc's SEAM note).
 * Encoding rejects a slice that is not exactly 16 bytes.
 *
 * @param raw  the 16 Decimal128 bytes (little-endian IEEE 754-2008 decimal)
 * @return     the BSON Decimal128 value
 */
exp fn bson_decimal128(raw: []byte): BsonValue {
    mk_value(BsonKind::Decimal128, 0.0, "", false, 0, 0, raw, 0 to byte, no_keys(), no_vals())
}

/**
 * The `0xFF` min-key element value (sorts before every other BSON value).
 *
 * @return  the BSON min-key value
 */
exp fn bson_min_key(): BsonValue {
    mk_value(BsonKind::MinKey, 0.0, "", false, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * The `0x7F` max-key element value (sorts after every other BSON value).
 *
 * @return  the BSON max-key value
 */
exp fn bson_max_key(): BsonValue {
    mk_value(BsonKind::MaxKey, 0.0, "", false, 0, 0, no_bytes(), 0 to byte, no_keys(), no_vals())
}

/**
 * Appends every byte of `more` to `out`, returning the grown slice (functional accumulation, no
 * index-assignment).
 *
 * @param out   the accumulator
 * @param more  the bytes to append
 * @return      `out` followed by `more`
 */
fn append_all(out: []byte, more: []byte): []byte {
    var acc = out
    var i: u64 = 0
    loop {
        if i >= more.len { break }
        acc = teko::list::push(acc, more[i])
        i++
    }
    acc
}

/**
 * Appends the low `count` bytes of `v` to `out` in little-endian order (BSON's integer layout).
 *
 * @param out    the accumulator
 * @param v      the value whose bytes are emitted (signed values reinterpreted as their two's
 *               complement pattern)
 * @param count  how many low-order bytes to emit (4 or 8)
 * @return       `out` followed by the little-endian bytes
 */
fn append_le(out: []byte, v: u64, count: u64): []byte {
    var acc = out
    var i: u64 = 0
    loop {
        if i >= count { break }
        acc = teko::list::push(acc, ((v >> (i * 8)) & 0xFF) to byte)
        i++
    }
    acc
}

/**
 * Appends the low `count` bytes of a signed `i64` to `out` in little-endian order, extracting each
 * byte with a masked shift in the signed domain so no negative-to-unsigned cast is performed (the
 * value's two's-complement pattern is emitted directly).
 *
 * @param out    the accumulator
 * @param v      the signed value
 * @param count  how many low-order bytes to emit (4 or 8)
 * @return       `out` followed by the little-endian bytes
 */
fn append_le_i64(out: []byte, v: i64, count: u64): []byte {
    var acc = out
    var i: u64 = 0
    loop {
        if i >= count { break }
        acc = teko::list::push(acc, ((v >> (i * 8)) & 0xFF) to byte)
        i++
    }
    acc
}

/**
 * Encodes a field name as a BSON cstring (the UTF-8 bytes followed by `0x00`), rejecting an
 * interior NUL.
 *
 * @param name  the field name
 * @return      the cstring bytes, or `error` when the name contains a NUL
 */
fn encode_cstring(name: str): []byte | error {
    var raw = bytes_of_str(name)
    var i: u64 = 0
    loop {
        if i >= raw.len { break }
        if raw[i] == 0x00 { return error { message = "bson: field name contains an interior NUL" } }
        i++
    }
    teko::list::push(raw, 0x00 to byte)
}

/**
 * Encodes a BSON string value (`0x02`): the byte length plus one as a little-endian `int32`, then
 * the UTF-8 bytes, then `0x00`.
 *
 * @param s  the string
 * @return   the encoded string-value bytes
 */
fn encode_string_value(s: str): []byte {
    var raw = bytes_of_str(s)
    var out = append_le(no_bytes(), (raw.len + 1) to u64, 4)
    append_all(out, teko::list::push(raw, 0x00 to byte))
}

/**
 * Encodes one element value (the bytes AFTER the type byte and field name), recursing into
 * embedded documents and arrays.
 *
 * @param v  the value to encode
 * @return   the encoded value bytes, or `error` when a nested value is invalid
 */
fn encode_value(v: BsonValue): []byte | error {
    match v.kind {
        BsonKind::Double => append_le(no_bytes(), f64_bits(v.real), 8)
        BsonKind::String => encode_string_value(v.text)
        BsonKind::Document => encode_document(v)
        BsonKind::Array => encode_array_value(v.vals)
        BsonKind::Binary => encode_binary_value(v)
        BsonKind::ObjectId => encode_fixed(v.bytes, 12, "ObjectId")
        BsonKind::Bool => teko::list::push(no_bytes(), (if v.flag { 0x01 } else { 0x00 }) to byte)
        BsonKind::DateTime => append_le_i64(no_bytes(), v.int_val, 8)
        BsonKind::Null => no_bytes()
        BsonKind::Int32 => append_le_i64(no_bytes(), v.int_val, 4)
        BsonKind::Int64 => append_le_i64(no_bytes(), v.int_val, 8)
        BsonKind::Timestamp => append_le(no_bytes(), v.uint_val, 8)
        BsonKind::Decimal128 => encode_fixed(v.bytes, 16, "Decimal128")
        BsonKind::MinKey => no_bytes()
        BsonKind::MaxKey => no_bytes()
    }
}

/**
 * Encodes a fixed-width byte value (ObjectId, Decimal128), rejecting a mis-sized slice.
 *
 * @param data  the bytes
 * @param want  the required length
 * @param what  the type name for the error message
 * @return      the bytes verbatim, or `error` when the length is wrong
 */
fn encode_fixed(data: []byte, want: u64, what: str): []byte | error {
    if data.len != want { return error { message = concat("bson: ", what, " must be ", i64_to_str(want to i64), " bytes") } }
    data
}

/**
 * Encodes a BSON binary value (`0x05`): the payload length as a little-endian `int32`, the subtype
 * byte, then the payload.
 *
 * @param v  the binary value
 * @return   the encoded binary-value bytes
 */
fn encode_binary_value(v: BsonValue): []byte {
    var out = append_le(no_bytes(), v.bytes.len, 4)
    out = teko::list::push(out, v.subtype)
    append_all(out, v.bytes)
}

/**
 * Encodes an array value (`0x04`): a document whose field names are the decimal indices `"0"`,
 * `"1"`, … of the elements.
 *
 * @param vals  the array elements
 * @return      the encoded array bytes, or `error` when a nested value is invalid
 */
fn encode_array_value(vals: []BsonValue): []byte | error {
    var keys: []str = no_keys()
    var i: u64 = 0
    loop {
        if i >= vals.len { break }
        keys = teko::list::push(keys, u64_to_str(i))
        i++
    }
    encode_document(bson_document(keys, vals))
}

/**
 * Encodes the element list of a document: for each field, the type byte, the field-name cstring,
 * and the encoded value.
 *
 * @param keys  the field names
 * @param vals  the field values, parallel to `keys`
 * @return      the encoded element-list bytes, or `error` when a field is invalid
 */
fn encode_elements(keys: []str, vals: []BsonValue): []byte | error {
    var out: []byte = no_bytes()
    var i: u64 = 0
    loop {
        if i >= keys.len { break }
        out = teko::list::push(out, type_byte(vals[i].kind))
        var name = match encode_cstring(keys[i]) { []byte as b => b; error as e => return e }
        out = append_all(out, name)
        var body = match encode_value(vals[i]) { []byte as b => b; error as e => return e }
        out = append_all(out, body)
        i++
    }
    out
}

/**
 * The BSON type byte for a kind.
 *
 * @param kind  the value kind
 * @return      the BSON element type byte
 */
fn type_byte(kind: BsonKind): byte {
    match kind {
        BsonKind::Double => 0x01 to byte
        BsonKind::String => 0x02 to byte
        BsonKind::Document => 0x03 to byte
        BsonKind::Array => 0x04 to byte
        BsonKind::Binary => 0x05 to byte
        BsonKind::ObjectId => 0x07 to byte
        BsonKind::Bool => 0x08 to byte
        BsonKind::DateTime => 0x09 to byte
        BsonKind::Null => 0x0A to byte
        BsonKind::Int32 => 0x10 to byte
        BsonKind::Timestamp => 0x11 to byte
        BsonKind::Int64 => 0x12 to byte
        BsonKind::Decimal128 => 0x13 to byte
        BsonKind::MinKey => 0xFF to byte
        BsonKind::MaxKey => 0x7F to byte
    }
}

/**
 * Encodes a document value to its framed bytes: the total length as a leading little-endian
 * `int32`, the element list, and the trailing `0x00`. Also the shape used for an embedded document
 * or array body.
 *
 * @param doc  the document (or array-as-document) value
 * @return     the framed document bytes, or `error` when the value is not a document/array or a
 *             field is invalid
 */
fn encode_document(doc: BsonValue): []byte | error {
    if doc.kind != BsonKind::Document && doc.kind != BsonKind::Array {
        return error { message = "bson: top-level value must be a document" }
    }
    var body = match encode_elements(doc.keys, doc.vals) { []byte as b => b; error as e => return e }
    var total = 4 + body.len + 1
    var out = append_le(no_bytes(), total, 4)
    out = append_all(out, body)
    teko::list::push(out, 0x00 to byte)
}

/**
 * Encodes a complete BSON document to a fresh byte slice. The top-level value must be a
 * `Document`.
 *
 * @param doc  the document value
 * @return     the BSON byte encoding, or `error` when the value is not a document or a field is
 *             invalid
 */
exp fn encode(doc: BsonValue): []byte | error {
    if doc.kind != BsonKind::Document { return error { message = "bson: top-level value must be a document" } }
    encode_document(doc)
}

/**
 * A decode failure with a message naming the offending offset.
 *
 * @param what  the failure description
 * @param pos   the offset at which the failure was detected
 * @return      the checked error
 */
fn read_error(what: str, pos: u64): error {
    error { message = concat("bson: ", what, " at offset ", i64_to_str(pos to i64)) }
}

/**
 * Reads `count` bytes little-endian from `p` at `pos` into a `u64`. The caller has already
 * bounds-checked `pos + count <= p.len`.
 *
 * @param p      the input
 * @param pos    the offset of the least-significant byte
 * @param count  how many bytes to read (4 or 8)
 * @return       the assembled unsigned value
 */
fn read_le_u(p: []byte, pos: u64, count: u64): u64 {
    var v: u64 = 0
    var i = count
    loop {
        if i == 0 { break }
        i = i - 1
        v = (v << 8) | (p[pos + i] to u64)
    }
    v
}

/**
 * Reads a little-endian signed `int32` from `p` at `pos`, sign-extending to `i64`.
 *
 * @param p    the input
 * @param pos  the offset of the least-significant byte
 * @return     the sign-extended value
 */
fn read_le_i32(p: []byte, pos: u64): i64 {
    var u = read_le_u(p, pos, 4)
    if u >= 0x80000000 { return (u to i64) - 4294967296 }
    u to i64
}

/**
 * Reads a little-endian signed `int64` from `p` at `pos` by combining a sign-extended high word
 * with the unsigned low word, so the full `i64` range is reconstructed without a high-bit
 * unsigned-to-signed cast: `value = high_signed * 2^32 + low`.
 *
 * @param p    the input
 * @param pos  the offset of the least-significant byte
 * @return     the reconstructed signed value
 */
fn read_le_i64(p: []byte, pos: u64): i64 {
    var low = read_le_u(p, pos, 4) to i64
    var high = read_le_i32(p, pos + 4)
    high * 4294967296 + low
}

/**
 * Reads a null-terminated field name (cstring) from `p` at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the cstring's first byte
 * @return     the name and the offset past the terminator, or `error` when unterminated
 */
fn read_cstring(p: []byte, pos: u64): NameRead | error {
    var out: []byte = no_bytes()
    var at = pos
    loop {
        if at >= p.len { return read_error("unterminated field name", pos) }
        if p[at] == 0x00 { return NameRead { name = str_of_bytes(out); pos = at + 1 } }
        out = teko::list::push(out, p[at])
        at++
    }
}

/**
 * Reads `n` bytes out of `p` starting at `pos`, bounds-checked.
 *
 * @param p    the input
 * @param pos  the offset of the first byte
 * @param n    how many bytes to take
 * @return     the taken bytes, or `error` when truncated
 */
fn take_bytes(p: []byte, pos: u64, n: u64): []byte | error {
    if pos + n > p.len { return read_error("truncated value", pos) }
    var out: []byte = no_bytes()
    var i: u64 = 0
    loop {
        if i >= n { break }
        out = teko::list::push(out, p[pos + i])
        i++
    }
    out
}

/**
 * Decodes a BSON string value (`0x02`) at `pos`: the length `int32`, then that many bytes minus the
 * trailing `0x00`.
 *
 * @param p    the input
 * @param pos  the offset of the length prefix
 * @return     the string value and the offset past it, or `error`
 */
fn decode_string(p: []byte, pos: u64): BsonRead | error {
    if pos + 4 > p.len { return read_error("truncated string length", pos) }
    var len = read_le_u(p, pos, 4)
    if len == 0 { return read_error("string length must include the terminator", pos) }
    var body = match take_bytes(p, pos + 4, len - 1) { []byte as b => b; error as e => return e }
    if pos + 4 + len > p.len { return read_error("truncated string", pos) }
    BsonRead { value = bson_string(str_of_bytes(body)); pos = pos + 4 + len }
}

/**
 * Decodes a BSON binary value (`0x05`) at `pos`: the payload length `int32`, the subtype byte, then
 * the payload.
 *
 * @param p    the input
 * @param pos  the offset of the length prefix
 * @return     the binary value and the offset past it, or `error`
 */
fn decode_binary(p: []byte, pos: u64): BsonRead | error {
    if pos + 5 > p.len { return read_error("truncated binary header", pos) }
    var len = read_le_u(p, pos, 4)
    var sub = p[pos + 4]
    var payload = match take_bytes(p, pos + 5, len) { []byte as b => b; error as e => return e }
    BsonRead { value = bson_binary(sub, payload); pos = pos + 5 + len }
}

/**
 * Decodes one element value at `pos` selected by its BSON type byte, recursing into embedded
 * documents and arrays.
 *
 * @param p     the input
 * @param t     the element type byte
 * @param pos   the offset of the value's first byte
 * @return      the value and the offset past it, or `error` on truncation or an unknown type
 */
fn decode_value(p: []byte, t: byte, pos: u64): BsonRead | error {
    if t == 0x01 to byte { return decode_double(p, pos) }
    if t == 0x02 to byte { return decode_string(p, pos) }
    if t == 0x03 to byte { return decode_embedded(p, pos) }
    if t == 0x04 to byte { return decode_array(p, pos) }
    if t == 0x05 to byte { return decode_binary(p, pos) }
    if t == 0x07 to byte { return decode_fixed(p, pos, 12, false) }
    if t == 0x08 to byte { return decode_bool(p, pos) }
    if t == 0x09 to byte { return decode_datetime(p, pos) }
    if t == 0x0A to byte { return BsonRead { value = bson_null(); pos = pos } }
    if t == 0x10 to byte { return decode_int32(p, pos) }
    if t == 0x11 to byte { return decode_timestamp(p, pos) }
    if t == 0x12 to byte { return decode_int64(p, pos) }
    if t == 0x13 to byte { return decode_fixed(p, pos, 16, true) }
    if t == 0xFF to byte { return BsonRead { value = bson_min_key(); pos = pos } }
    if t == 0x7F to byte { return BsonRead { value = bson_max_key(); pos = pos } }
    read_error(concat("unsupported element type 0x", hex_byte(t)), pos)
}

/**
 * Formats a byte as two lowercase hexadecimal digits.
 *
 * @param b  the byte
 * @return   the two-digit hex string
 */
fn hex_byte(b: byte): str {
    concat(hex_digit((b to u64) >> 4), hex_digit((b to u64) & 0xF))
}

/**
 * Formats a nibble (0..15) as one lowercase hexadecimal digit.
 *
 * @param n  the nibble value
 * @return   the hex digit
 */
fn hex_digit(n: u64): str {
    if n < 10 { return one_byte((0x30 + n) to byte) }
    one_byte((0x61 + (n - 10)) to byte)
}

/**
 * Decodes a BSON double value (`0x01`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 8-byte double
 * @return     the double value and the offset past it, or `error`
 */
fn decode_double(p: []byte, pos: u64): BsonRead | error {
    if pos + 8 > p.len { return read_error("truncated double", pos) }
    BsonRead { value = bson_double(f64_from_bits(read_le_u(p, pos, 8))); pos = pos + 8 }
}

/**
 * Decodes a BSON boolean value (`0x08`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 1-byte boolean
 * @return     the boolean value and the offset past it, or `error`
 */
fn decode_bool(p: []byte, pos: u64): BsonRead | error {
    if pos + 1 > p.len { return read_error("truncated boolean", pos) }
    BsonRead { value = bson_bool(p[pos] != 0x00); pos = pos + 1 }
}

/**
 * Decodes a BSON UTC datetime value (`0x09`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 8-byte millisecond instant
 * @return     the datetime value and the offset past it, or `error`
 */
fn decode_datetime(p: []byte, pos: u64): BsonRead | error {
    if pos + 8 > p.len { return read_error("truncated datetime", pos) }
    BsonRead { value = bson_datetime(read_le_i64(p, pos)); pos = pos + 8 }
}

/**
 * Decodes a BSON int32 value (`0x10`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 4-byte integer
 * @return     the int32 value and the offset past it, or `error`
 */
fn decode_int32(p: []byte, pos: u64): BsonRead | error {
    if pos + 4 > p.len { return read_error("truncated int32", pos) }
    BsonRead { value = bson_int32(read_le_i32(p, pos)); pos = pos + 4 }
}

/**
 * Decodes a BSON int64 value (`0x12`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 8-byte integer
 * @return     the int64 value and the offset past it, or `error`
 */
fn decode_int64(p: []byte, pos: u64): BsonRead | error {
    if pos + 8 > p.len { return read_error("truncated int64", pos) }
    BsonRead { value = bson_int64(read_le_i64(p, pos)); pos = pos + 8 }
}

/**
 * Decodes a BSON timestamp value (`0x11`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the 8-byte timestamp
 * @return     the timestamp value and the offset past it, or `error`
 */
fn decode_timestamp(p: []byte, pos: u64): BsonRead | error {
    if pos + 8 > p.len { return read_error("truncated timestamp", pos) }
    BsonRead { value = bson_timestamp(read_le_u(p, pos, 8)); pos = pos + 8 }
}

/**
 * Decodes a fixed-width byte value (ObjectId `0x07` = 12 bytes, or Decimal128 `0x13` = 16 bytes)
 * at `pos`.
 *
 * @param p          the input
 * @param pos        the offset of the fixed bytes
 * @param n          the width (12 or 16)
 * @param is_decimal whether the value is a Decimal128 (else an ObjectId)
 * @return           the value and the offset past it, or `error`
 */
fn decode_fixed(p: []byte, pos: u64, n: u64, is_decimal: bool): BsonRead | error {
    var raw = match take_bytes(p, pos, n) { []byte as b => b; error as e => return e }
    if is_decimal { return BsonRead { value = bson_decimal128(raw); pos = pos + n } }
    BsonRead { value = bson_objectid(raw); pos = pos + n }
}

/**
 * Decodes an embedded document (`0x03`) at `pos`.
 *
 * @param p    the input
 * @param pos  the offset of the document's length prefix
 * @return     the document value and the offset past it, or `error`
 */
fn decode_embedded(p: []byte, pos: u64): BsonRead | error {
    var doc = match decode_doc_at(p, pos) { DocRead as d => d; error as e => return e }
    BsonRead { value = bson_document(doc.keys, doc.vals); pos = doc.pos }
}

/**
 * Decodes an array (`0x04`) at `pos`: a document whose field values become the array elements (the
 * synthesised index names are discarded).
 *
 * @param p    the input
 * @param pos  the offset of the array's length prefix
 * @return     the array value and the offset past it, or `error`
 */
fn decode_array(p: []byte, pos: u64): BsonRead | error {
    var doc = match decode_doc_at(p, pos) { DocRead as d => d; error as e => return e }
    BsonRead { value = bson_array(doc.vals); pos = doc.pos }
}

/**
 * Decodes a document body at `pos`: the total-length `int32`, the element list, and the trailing
 * `0x00`, verifying the declared length matches the bytes consumed.
 *
 * @param p    the input
 * @param pos  the offset of the document's length prefix
 * @return     the field names, values, and offset past the document, or `error`
 */
fn decode_doc_at(p: []byte, pos: u64): DocRead | error {
    if pos + 4 > p.len { return read_error("truncated document length", pos) }
    var declared = read_le_u(p, pos, 4)
    if declared < 5 { return read_error("document length too small", pos) }
    if pos + declared > p.len { return read_error("document length exceeds input", pos) }
    var keys: []str = no_keys()
    var vals: []BsonValue = no_vals()
    var at = pos + 4
    loop {
        if at >= p.len { return read_error("unterminated document", pos) }
        if p[at] == 0x00 {
            if at + 1 != pos + declared { return read_error("document length disagrees with terminator", pos) }
            return DocRead { keys = keys; vals = vals; pos = at + 1 }
        }
        var t = p[at]
        var name = match read_cstring(p, at + 1) { NameRead as n => n; error as e => return e }
        var val = match decode_value(p, t, name.pos) { BsonRead as r => r; error as e => return e }
        keys = teko::list::push(keys, name.name)
        vals = teko::list::push(vals, val.value)
        at = val.pos
    }
}

/**
 * Decodes a complete BSON document: a single top-level document with any trailing bytes reported as
 * a checked error.
 *
 * @param p  the input bytes
 * @return   the decoded document value, or `error` on malformed input or trailing bytes
 */
exp fn decode(p: []byte): BsonValue | error {
    var doc = match decode_doc_at(p, 0) { DocRead as d => d; error as e => return e }
    if doc.pos != p.len { return read_error("trailing bytes after document", doc.pos) }
    bson_document(doc.keys, doc.vals)
}

/**
 * Compares two byte slices for exact equality.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and identical bytes
 */
fn bytes_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

/**
 * Compares two strings for byte-exact equality.
 *
 * @param a  the first string
 * @param b  the second string
 * @return   true when both have the same bytes
 */
fn str_equal(a: str, b: str): bool {
    bytes_equal(bytes_of_str(a), bytes_of_str(b))
}

/**
 * Structurally compares two `BsonValue` trees for equality, recursing through documents (in field
 * order) and arrays. Doubles compare by `f64` bit pattern (the round-trip identity relation).
 *
 * @param a  the first value
 * @param b  the second value
 * @return   true when the two trees are structurally identical
 */
exp fn bson_equal(a: BsonValue, b: BsonValue): bool {
    if a.kind != b.kind { return false }
    match a.kind {
        BsonKind::Double => f64_bits(a.real) == f64_bits(b.real)
        BsonKind::String => str_equal(a.text, b.text)
        BsonKind::Bool => a.flag == b.flag
        BsonKind::DateTime => a.int_val == b.int_val
        BsonKind::Int32 => a.int_val == b.int_val
        BsonKind::Int64 => a.int_val == b.int_val
        BsonKind::Timestamp => a.uint_val == b.uint_val
        BsonKind::Null => true
        BsonKind::MinKey => true
        BsonKind::MaxKey => true
        BsonKind::ObjectId => bytes_equal(a.bytes, b.bytes)
        BsonKind::Decimal128 => bytes_equal(a.bytes, b.bytes)
        BsonKind::Binary => a.subtype == b.subtype && bytes_equal(a.bytes, b.bytes)
        BsonKind::Array => vals_equal(a.vals, b.vals)
        BsonKind::Document => keys_equal(a.keys, b.keys) && vals_equal(a.vals, b.vals)
    }
}

/**
 * Compares two field-name slices elementwise.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and equal names in order
 */
fn keys_equal(a: []str, b: []str): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if !str_equal(a[i], b[i]) { return false }
        i++
    }
    true
}

/**
 * Compares two `BsonValue` slices elementwise with `bson_equal`.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and structurally equal elements
 */
fn vals_equal(a: []BsonValue, b: []BsonValue): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if !bson_equal(a[i], b[i]) { return false }
        i++
    }
    true
}
