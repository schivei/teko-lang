fn bytes_lit(xs: []i64): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i] to byte)
        i++
    }
    out
}

fn slices_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn expect_bytes(result: []byte | error): []byte {
    match result {
        []byte as b => b
        error => { teko::assert::is_true(false); [] }
    }
}

fn expect_value(result: BsonValue | error): BsonValue {
    match result {
        BsonValue as v => v
        error => { teko::assert::is_true(false); bson_null() }
    }
}

fn expect_decode_error(result: BsonValue | error) {
    match result {
        BsonValue => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

fn expect_encode_error(result: []byte | error) {
    match result {
        []byte => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

fn one_field(name: str, v: BsonValue): BsonValue {
    var keys: []str = teko::list::empty()
    keys = teko::list::push(keys, name)
    var vals: []BsonValue = teko::list::empty()
    vals = teko::list::push(vals, v)
    bson_document(keys, vals)
}

fn round_trips(v: BsonValue): bool {
    var doc = one_field("x", v)
    var got = expect_bytes(encode(doc))
    bson_equal(doc, expect_value(decode(got)))
}

#test
fn hello_world_matches_reference_bytes() {
    var doc = one_field("hello", bson_string("world"))
    var want = bytes_lit([0x16, 0x00, 0x00, 0x00, 0x02, 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x00, 0x06, 0x00, 0x00, 0x00, 0x77, 0x6f, 0x72, 0x6c, 0x64, 0x00, 0x00])
    teko::assert::is_true(slices_equal(expect_bytes(encode(doc)), want))
    teko::assert::is_true(bson_equal(doc, expect_value(decode(want))))
}

#test
fn bson_array_matches_reference_bytes() {
    var elems: []BsonValue = teko::list::empty()
    elems = teko::list::push(elems, bson_string("awesome"))
    elems = teko::list::push(elems, bson_double(5.05))
    elems = teko::list::push(elems, bson_int32(1986))
    var doc = one_field("BSON", bson_array(elems))
    var want = bytes_lit([0x31, 0x00, 0x00, 0x00, 0x04, 0x42, 0x53, 0x4f, 0x4e, 0x00, 0x26, 0x00, 0x00, 0x00, 0x02, 0x30, 0x00, 0x08, 0x00, 0x00, 0x00, 0x61, 0x77, 0x65, 0x73, 0x6f, 0x6d, 0x65, 0x00, 0x01, 0x31, 0x00, 0x33, 0x33, 0x33, 0x33, 0x33, 0x33, 0x14, 0x40, 0x10, 0x32, 0x00, 0xc2, 0x07, 0x00, 0x00, 0x00, 0x00])
    teko::assert::is_true(slices_equal(expect_bytes(encode(doc)), want))
    teko::assert::is_true(bson_equal(doc, expect_value(decode(want))))
}

#test
fn all_element_types_round_trip() {
    teko::assert::is_true(round_trips(bson_bool(true)))
    teko::assert::is_true(round_trips(bson_null()))
    teko::assert::is_true(round_trips(bson_int32(-2000000000)))
    teko::assert::is_true(round_trips(bson_int64(-9223372036854775807)))
    teko::assert::is_true(round_trips(bson_datetime(1565546054692)))
    teko::assert::is_true(round_trips(bson_timestamp(7300000000000000000)))
    teko::assert::is_true(round_trips(bson_binary(0x04 to byte, bytes_lit([0xde, 0xad, 0xbe, 0xef]))))
    teko::assert::is_true(round_trips(bson_objectid(bytes_lit([0x50, 0x7f, 0x1f, 0x77, 0xbc, 0xf8, 0x6c, 0xd7, 0x99, 0x43, 0x90, 0x11]))))
    teko::assert::is_true(round_trips(bson_decimal128(bytes_lit([0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10]))))
    teko::assert::is_true(round_trips(bson_min_key()))
    teko::assert::is_true(round_trips(bson_max_key()))
    teko::assert::is_true(round_trips(one_field("n", bson_int32(7))))
}

#test
fn malformed_documents_are_errors() {
    expect_decode_error(decode(bytes_lit([0x05, 0x00, 0x00, 0x00])))
    expect_decode_error(decode(bytes_lit([0x16, 0x00, 0x00, 0x00, 0x02, 0x68, 0x69, 0x00])))
    expect_decode_error(decode(bytes_lit([0x06, 0x00, 0x00, 0x00, 0x00, 0x00])))
}

#test
fn invalid_values_are_encode_errors() {
    var nul_name = str_of_bytes(bytes_lit([0x61, 0x00, 0x62]))
    expect_encode_error(encode(one_field(nul_name, bson_int32(1))))
    expect_encode_error(encode(one_field("id", bson_objectid(bytes_lit([0x01, 0x02, 0x03])))))
}
