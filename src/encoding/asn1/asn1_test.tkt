use teko::numeric::bigint

fn bytes_lit(xs: []i64): []byte {
    var out: []byte = []
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i] to byte)
        i++
    }
    out
}

fn bi(s: str): bigint::BigInt {
    match bigint::from_str(s) {
        bigint::BigInt as b => b
        error => { teko::assert::is_true(false); bigint::zero() }
    }
}

fn expect_value(result: Asn1Value | error): Asn1Value {
    match result {
        Asn1Value as v => v
        error => { teko::assert::is_true(false); asn1_null() }
    }
}

fn expect_arcs(result: []u64 | error): []u64 {
    match result {
        []u64 as arcs => arcs
        error => { teko::assert::is_true(false); [] }
    }
}

fn is_err(result: Asn1Value | error): bool {
    match result {
        Asn1Value => false
        error => true
    }
}

fn is_arc_err(result: []u64 | error): bool {
    match result {
        []u64 => false
        error => true
    }
}

#test
fn boolean_encodes_der_canonical_all_ones_or_zero() {
    teko::assert::bytes_eq(der_encode(asn1_boolean(true)), bytes_lit([0x01, 0x01, 0xff]))
    teko::assert::bytes_eq(der_encode(asn1_boolean(false)), bytes_lit([0x01, 0x01, 0x00]))
}

#test
fn integer_encodes_der_two_complement_minimal_matching_asn1crypto() {
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("0"))), bytes_lit([0x02, 0x01, 0x00]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("1"))), bytes_lit([0x02, 0x01, 0x01]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-1"))), bytes_lit([0x02, 0x01, 0xff]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("127"))), bytes_lit([0x02, 0x01, 0x7f]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("128"))), bytes_lit([0x02, 0x02, 0x00, 0x80]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("255"))), bytes_lit([0x02, 0x02, 0x00, 0xff]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("256"))), bytes_lit([0x02, 0x02, 0x01, 0x00]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-128"))), bytes_lit([0x02, 0x01, 0x80]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-129"))), bytes_lit([0x02, 0x02, 0xff, 0x7f]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("65535"))), bytes_lit([0x02, 0x03, 0x00, 0xff, 0xff]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-65536"))), bytes_lit([0x02, 0x03, 0xff, 0x00, 0x00]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("1000000000000"))), bytes_lit([0x02, 0x06, 0x00, 0xe8, 0xd4, 0xa5, 0x10, 0x00]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-1000000000000"))), bytes_lit([0x02, 0x06, 0xff, 0x17, 0x2b, 0x5a, 0xf0, 0x00]))
}

#test
fn integer_beyond_64_bits_matches_asn1crypto() {
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("123456789012345678901234567890"))), bytes_lit([0x02, 0x0d, 0x01, 0x8e, 0xe9, 0x0f, 0xf6, 0xc3, 0x73, 0xe0, 0xee, 0x4e, 0x3f, 0x0a, 0xd2]))
    teko::assert::bytes_eq(der_encode(asn1_integer(bi("-123456789012345678901234567890"))), bytes_lit([0x02, 0x0d, 0xfe, 0x71, 0x16, 0xf0, 0x09, 0x3c, 0x8c, 0x1f, 0x11, 0xb1, 0xc0, 0xf5, 0x2e]))
    var big = bi("123456789012345678901234567890")
    var decoded = expect_value(der_decode(der_encode(asn1_integer(big))))
    teko::assert::is_true(bigint::eq(decoded.integer, big))
}

#test
fn octet_string_and_null_encode() {
    teko::assert::bytes_eq(der_encode(asn1_octet_string(bytes_of_str("hello"))), bytes_lit([0x04, 0x05, 0x68, 0x65, 0x6c, 0x6c, 0x6f]))
    teko::assert::bytes_eq(der_encode(asn1_null()), bytes_lit([0x05, 0x00]))
}

#test
fn object_identifier_encodes_der_matching_asn1crypto_and_round_trips_dotted_string() {
    var rsa_arcs = expect_arcs(asn1_oid_from_str("1.2.840.113549.1.1.1"))
    teko::assert::bytes_eq(der_encode(expect_value(asn1_oid(rsa_arcs))), bytes_lit([0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01]))
    teko::assert::eq_str(asn1_oid_to_str(rsa_arcs), "1.2.840.113549.1.1.1")

    var wide_arcs = expect_arcs(asn1_oid_from_str("2.999.1"))
    teko::assert::bytes_eq(der_encode(expect_value(asn1_oid(wide_arcs))), bytes_lit([0x06, 0x03, 0x88, 0x37, 0x01]))
    teko::assert::eq_str(asn1_oid_to_str(wide_arcs), "2.999.1")
}

#test
fn object_identifier_rejects_malformed_dotted_strings_and_arc_lists() {
    teko::assert::is_true(is_arc_err(asn1_oid_from_str("")))
    teko::assert::is_true(is_arc_err(asn1_oid_from_str("1..2")))
    teko::assert::is_true(is_arc_err(asn1_oid_from_str("1")))
    teko::assert::is_true(is_arc_err(asn1_oid_from_str(".1.2")))
    var no_arcs: []u64 = []
    teko::assert::is_true(is_err(asn1_oid(no_arcs)))
    var one_arc = teko::list::push(no_arcs, 1 to u64)
    teko::assert::is_true(is_err(asn1_oid(one_arc)))
    var bad_first = [3 to u64, 0 to u64]
    teko::assert::is_true(is_err(asn1_oid(bad_first)))
    var bad_second = [0 to u64, 40 to u64]
    teko::assert::is_true(is_err(asn1_oid(bad_second)))
}

#test
fn utf8_and_printable_string_encode_matching_asn1crypto() {
    teko::assert::bytes_eq(der_encode(asn1_utf8_string("hello")), bytes_lit([0x0c, 0x05, 0x68, 0x65, 0x6c, 0x6c, 0x6f]))
    teko::assert::bytes_eq(der_encode(expect_value(asn1_printable_string("US"))), bytes_lit([0x13, 0x02, 0x55, 0x53]))
    teko::assert::is_true(is_err(asn1_printable_string("a@b")))
}

#test
fn ia5_string_round_trips_and_rejects_non_ascii() {
    var v = expect_value(asn1_ia5_string("test@example.com"))
    var decoded = expect_value(der_decode(der_encode(v)))
    teko::assert::is_true(asn1_equal(decoded, v))
    teko::assert::is_true(is_err(asn1_ia5_string("café")))
}

#test
fn utc_and_generalized_time_encode_and_validate_canonical_form() {
    var utc = expect_value(asn1_utc_time("260815120000Z"))
    teko::assert::bytes_eq(der_encode(utc), bytes_lit([0x17, 0x0d, 0x32, 0x36, 0x30, 0x38, 0x31, 0x35, 0x31, 0x32, 0x30, 0x30, 0x30, 0x30, 0x5a]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(utc))), utc))
    teko::assert::is_true(is_err(asn1_utc_time("not-a-time")))

    var gtime = expect_value(asn1_generalized_time("20260815120000Z"))
    teko::assert::bytes_eq(der_encode(gtime), bytes_lit([0x18, 0x0f, 0x32, 0x30, 0x32, 0x36, 0x30, 0x38, 0x31, 0x35, 0x31, 0x32, 0x30, 0x30, 0x30, 0x30, 0x5a]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(gtime))), gtime))
    teko::assert::is_true(is_err(asn1_generalized_time("not-a-time")))
}

#test
fn bit_string_encodes_der_and_validates_unused_bits() {
    teko::assert::bytes_eq(der_encode(expect_value(asn1_bit_string(bytes_lit([0x60]), 5))), bytes_lit([0x03, 0x02, 0x05, 0x60]))
    teko::assert::is_true(is_err(asn1_bit_string([], 1)))
    var one_byte: []byte = bytes_lit([1])
    teko::assert::is_true(is_err(asn1_bit_string(one_byte, 8)))
    teko::assert::is_true(!is_err(asn1_bit_string(one_byte, 7)))
}

#test
fn set_sorts_members_into_canonical_der_order_matching_asn1crypto_setof() {
    var items: []Asn1Value = []
    items = teko::list::push(items, asn1_integer(bi("3")))
    items = teko::list::push(items, asn1_integer(bi("1")))
    items = teko::list::push(items, asn1_integer(bi("2")))
    teko::assert::bytes_eq(der_encode(asn1_set(items)), bytes_lit([0x31, 0x09, 0x02, 0x01, 0x01, 0x02, 0x01, 0x02, 0x02, 0x01, 0x03]))
}

#test
fn sequence_of_integer_oid_octet_string_matches_asn1crypto_and_round_trips() {
    var rsa_arcs = expect_arcs(asn1_oid_from_str("1.2.840.113549.1.1.1"))
    var items: []Asn1Value = []
    items = teko::list::push(items, asn1_integer(bi("1")))
    items = teko::list::push(items, expect_value(asn1_oid(rsa_arcs)))
    items = teko::list::push(items, asn1_octet_string(bytes_of_str("hi")))
    var seq = asn1_sequence(items)
    teko::assert::bytes_eq(der_encode(seq), bytes_lit([0x30, 0x12, 0x02, 0x01, 0x01, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01, 0x04, 0x02, 0x68, 0x69]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(seq))), seq))
}

#test
fn tagged_values_encode_primitive_explicit_and_high_tag_number() {
    var prim = asn1_tagged_primitive(Asn1Class::ContextSpecific, 0, bytes_lit([0xab]))
    teko::assert::bytes_eq(der_encode(prim), bytes_lit([0x80, 0x01, 0xab]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(prim))), prim))

    var explicit_items: []Asn1Value = []
    explicit_items = teko::list::push(explicit_items, asn1_integer(bi("5")))
    var explicit_tag = asn1_tagged_constructed(Asn1Class::ContextSpecific, 3, explicit_items)
    teko::assert::bytes_eq(der_encode(explicit_tag), bytes_lit([0xa3, 0x03, 0x02, 0x01, 0x05]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(explicit_tag))), explicit_tag))

    var high_tag = asn1_tagged_primitive(Asn1Class::ContextSpecific, 128, bytes_lit([0xcd]))
    teko::assert::bytes_eq(der_encode(high_tag), bytes_lit([0x9f, 0x81, 0x00, 0x01, 0xcd]))
    teko::assert::is_true(asn1_equal(expect_value(der_decode(der_encode(high_tag))), high_tag))
}

#test
fn der_decode_rejects_indefinite_length_and_trailing_bytes() {
    teko::assert::is_true(is_err(der_decode(bytes_lit([0x01, 0x02, 0xff]))))
    teko::assert::is_true(is_err(der_decode(bytes_lit([0x05, 0x01, 0x00]))))
    teko::assert::is_true(is_err(der_decode(bytes_lit([0x30, 0x80, 0x00, 0x00]))))
    var extra: []byte = teko::list::push(der_encode(asn1_null()), 0x00 to byte)
    teko::assert::is_true(is_err(der_decode(extra)))
}

#test
fn der_decode_tolerates_a_non_minimal_ber_integer_body() {
    var padded: []byte = bytes_lit([0x02, 0x02, 0x00, 0x05])
    var decoded = expect_value(der_decode(padded))
    teko::assert::is_true(decoded.kind == Asn1Tag::Integer)
    teko::assert::is_true(bigint::eq(decoded.integer, bi("5")))
}

#test
fn der_decode_parses_a_real_rsa_subject_public_key_info() {
    var pub_der: []byte = bytes_lit([
        0x30, 0x5c, 0x30, 0x0d, 0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01,
        0x05, 0x00, 0x03, 0x4b, 0x00, 0x30, 0x48, 0x02, 0x41, 0x00, 0xc4, 0xcb, 0x14, 0xbb, 0x0c,
        0xbf, 0x61, 0xd3, 0xb8, 0xd6, 0x92, 0xd3, 0xd8, 0xe5, 0x7a, 0x4e, 0x4a, 0xb3, 0xe3, 0xff,
        0x86, 0xe3, 0x5c, 0x39, 0x6f, 0xa1, 0x6b, 0xa1, 0x04, 0xe4, 0x78, 0x10, 0xcf, 0xc9, 0xff,
        0x00, 0x99, 0x5a, 0xc4, 0x31, 0xf5, 0x9a, 0xc3, 0x30, 0x1e, 0x58, 0x0b, 0xff, 0x54, 0xb4,
        0xba, 0x56, 0x19, 0xcd, 0x54, 0x7b, 0x9c, 0x8c, 0x1f, 0x61, 0x71, 0xe3, 0xec, 0x95, 0x02,
        0x03, 0x01, 0x00, 0x01
    ])

    var info = expect_value(der_decode(pub_der))
    teko::assert::is_true(info.kind == Asn1Tag::Sequence)
    teko::assert::len_eq(info.items.len, 2)

    var alg_id = info.items[0]
    teko::assert::is_true(alg_id.kind == Asn1Tag::Sequence)
    teko::assert::is_true(alg_id.items[0].kind == Asn1Tag::ObjectIdentifier)
    teko::assert::eq_str(asn1_oid_to_str(alg_id.items[0].oid), "1.2.840.113549.1.1.1")
    teko::assert::is_true(alg_id.items[1].kind == Asn1Tag::Null)

    var pk_bits = info.items[1]
    teko::assert::is_true(pk_bits.kind == Asn1Tag::BitString)
    teko::assert::eq_u64(pk_bits.unused_bits, 0)

    var rsa_key = expect_value(der_decode(pk_bits.bytes))
    teko::assert::is_true(rsa_key.kind == Asn1Tag::Sequence)
    teko::assert::eq_str(bigint::to_hex(rsa_key.items[0].integer), "c4cb14bb0cbf61d3b8d692d3d8e57a4e4ab3e3ff86e35c396fa16ba104e47810cfc9ff00995ac431f59ac3301e580bff54b4ba5619cd547b9c8c1f6171e3ec95")
    teko::assert::is_true(bigint::eq(rsa_key.items[1].integer, bi("65537")))

    teko::assert::bytes_eq(der_encode(info), pub_der)
}
