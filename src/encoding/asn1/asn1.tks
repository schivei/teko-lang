use teko::numeric::bigint

/**
 * `teko::encoding::asn1` — a pure-Teko ASN.1 value model plus a DER encoder with BER
 * definite-length decode tolerance (X.680/X.690). Pure Teko, no C twin: like
 * `teko::encoding::cbor` / `teko::encoding::csv`, a library with zero OS/FFI dependency ships
 * as `.tks` + `.tkt` only, and both engines pick it up automatically. This unit is the payload
 * codec the future `teko::crypto::x509`/PKCS lanes ride on (certificates and key blobs are DER).
 *
 * VALUE MODEL — a TAGGED STRUCT, not an inline union. `Asn1Value` carries an `Asn1Tag`
 * discriminant plus the union of every kind's payload fields; `kind` selects which fields are
 * meaningful. This mirrors `teko::encoding::cbor`'s `CborValue` tag-struct choice (forward
 * compatible and directly validatable) rather than a `@Macro()` inline union.
 *
 * SCOPE (this unit). BOOLEAN, INTEGER (arbitrary precision via `teko::numeric::bigint`, since
 * DER integers in certificates/keys routinely exceed 64 bits), BIT STRING (payload bytes plus an
 * unused-bit count), OCTET STRING, NULL, OBJECT IDENTIFIER (an arc list plus dotted-string
 * helpers), UTF8String, PrintableString, IA5String, UTCTime/GeneralizedTime (validated to their
 * DER canonical `...Z` forms), SEQUENCE, SET, and context/application/private TAGGED values
 * (tag class, tag number, constructed flag, and either child values or a raw primitive payload).
 *
 * CANONICAL DER ON ENCODE. `der_encode` always emits definite-length, minimal-length headers: a
 * shortest identifier (short form under tag 31, base-128 high-tag-number form at/above it), a
 * shortest length (short form under 128, minimal-width long form otherwise), and a minimal
 * two's-complement INTEGER body. `SET` content is additionally sorted into bytewise ascending
 * order of each member's own DER encoding (the SET OF canonical rule, X.690 §11.6) — an honest
 * simplification for a general `SET` whose members carry distinct tags (§11.5's per-tag
 * canonical order), documented rather than silently assumed correct for that narrower case.
 *
 * BER DECODE TOLERANCE. `der_decode` accepts any definite-length encoding (short or long form,
 * including a non-minimal INTEGER two's-complement body) without re-deriving DER minimality —
 * only encoding is held to the canonical form. Indefinite length (the `0x80` length octet) is a
 * checked decode error: DER never emits it, and honoring it would need an unbounded lookahead for
 * the terminating end-of-contents marker this module does not implement. Constructed encodings of
 * the primitive string types (BER's "chunked" OCTET STRING/BIT STRING) are likewise a checked
 * decode error rather than silently supported — a documented, named seam (M.3 honest scope), not
 * a silent gap.
 *
 * TAGGED VALUES, ONE SHAPE FOR BOTH DIRECTIONS. A context/application/private-tagged value
 * (`Asn1Tag::Tagged`) is EITHER constructed (`constructed = true`, its content is zero or more
 * child `Asn1Value`s in `items` — covers EXPLICIT tagging as a single-child wrap and a
 * constructed IMPLICIT-tagged aggregate alike) OR primitive (`constructed = false`, its content
 * is the opaque `bytes` payload — an IMPLICIT-tagged primitive type, whose real universal shape
 * is not recoverable without a schema, so it is carried as raw bytes rather than guessed).
 *
 * ERROR MODEL (M.1 fail-loud / M.3 honest types). `der_decode(bytes: []byte): Asn1Value | error`
 * — a truncated TLV, an indefinite length, an out-of-range field (an invalid `BIT STRING`
 * unused-bit count, a malformed `OBJECT IDENTIFIER`, a `UTCTime`/`GeneralizedTime` not in its
 * canonical form, trailing bytes after the top-level value) is a checked failure, never a panic.
 * `der_encode` is total over a value built through this module's validating constructors (every
 * `Asn1Value` those constructors can produce has a DER rendering).
 */

/**
 * The tag class of an identifier octet (X.690 §8.1.2.2): `Universal` (the fixed, standard
 * meanings this module natively models — BOOLEAN, INTEGER, …), `Application`,
 * `ContextSpecific` (the common case for a schema-defined tagged field, e.g. X.509's `[0]`
 * version), and `Private`.
 */
exp type Asn1Class = enum { Universal; Application; ContextSpecific; Private }

/**
 * The kind discriminant of an `Asn1Value`: which ASN.1 type it holds, or `Tagged` for a
 * context/application/private-tagged value carried outside the universal class. See the module
 * doc's VALUE MODEL and TAGGED VALUES notes for which `Asn1Value` fields each kind reads.
 */
exp type Asn1Tag = enum {
    Boolean; Integer; BitString; OctetString; Null; ObjectIdentifier;
    Utf8String; PrintableString; IA5String; UtcTime; GeneralizedTime;
    Sequence; Set; Tagged
}

/**
 * One ASN.1 value as a tagged struct spanning every `Asn1Tag` (see the module doc's VALUE MODEL
 * note): `kind` selects which fields below carry meaning. Never construct this directly outside
 * this file — use the validating `asn1_*` builders, which are the sole source of the invariants
 * (a `BitString`'s `unused_bits <= 7`, a valid `ObjectIdentifier` arc list, a charset-checked
 * `PrintableString`/`IA5String`, a canonical-form `UtcTime`/`GeneralizedTime`) the encoder and
 * `asn1_equal` rely on.
 */
exp type Asn1Value = struct {
    /**
     * Which ASN.1 type this is; selects which of the fields below are meaningful.
     */
    kind: Asn1Tag
    /**
     * The boolean value for `Boolean`. `false` otherwise.
     */
    flag: bool
    /**
     * The arbitrary-precision value for `Integer`. Zero otherwise.
     */
    integer: bigint::BigInt
    /**
     * The payload bytes for `BitString`/`OctetString`, and the raw primitive content for a
     * primitive `Tagged` value (`constructed = false`). Empty otherwise.
     */
    bytes: []byte
    /**
     * The count of unused trailing bits (`0..7`) in the last byte of `bytes` for `BitString`.
     * Zero otherwise.
     */
    unused_bits: u64
    /**
     * The arc list for `ObjectIdentifier` (e.g. `[1, 2, 840, 113549, 1, 1, 1]`). Empty otherwise.
     */
    oid: []u64
    /**
     * The text for `Utf8String`/`PrintableString`/`IA5String`/`UtcTime`/`GeneralizedTime`. Empty
     * otherwise.
     */
    text: str
    /**
     * The elements for `Sequence`/`Set`, and the children for a constructed `Tagged` value
     * (`constructed = true`). Empty otherwise.
     */
    items: []Asn1Value
    /**
     * The tag class for `Tagged`. `Universal` for every other kind.
     */
    tag_class: Asn1Class
    /**
     * The tag number for `Tagged`. Zero for every other kind (whose tag number is implied by
     * `kind` itself — see `universal_tag_num`).
     */
    tag_num: u64
    /**
     * Whether a `Tagged` value's content is constructed (`items`) or primitive (`bytes`).
     * `true` for `Sequence`/`Set` (always constructed); `false` for every other non-`Tagged`
     * kind (always primitive).
     */
    constructed: bool
}

/**
 * A fresh empty `[]byte`, the default for the byte-carrying fields of an `Asn1Value`.
 *
 * @return  an empty byte slice
 */
fn no_bytes(): []byte {
    teko::list::empty()
}

/**
 * A fresh empty `[]u64`, the default for `Asn1Value.oid`.
 *
 * @return  an empty arc slice
 */
fn no_arcs(): []u64 {
    teko::list::empty()
}

/**
 * A fresh empty `[]Asn1Value`, the default for the child-carrying fields of an `Asn1Value`.
 *
 * @return  an empty value slice
 */
fn no_items(): []Asn1Value {
    teko::list::empty()
}

/**
 * Builds an `Asn1Value` from every field explicitly — the single constructor every public
 * builder funnels through so each records only the fields its kind uses and leaves the rest at
 * defaults.
 *
 * @param kind         the item's kind discriminant
 * @param flag         the boolean value (see `Asn1Value.flag`)
 * @param integer      the integer value (see `Asn1Value.integer`)
 * @param bytes        the payload / raw primitive bytes (see `Asn1Value.bytes`)
 * @param unused_bits  the BIT STRING unused-bit count (see `Asn1Value.unused_bits`)
 * @param oid          the OBJECT IDENTIFIER arc list (see `Asn1Value.oid`)
 * @param text         the string text (see `Asn1Value.text`)
 * @param items        the child values (see `Asn1Value.items`)
 * @param tag_class    the tag class (see `Asn1Value.tag_class`)
 * @param tag_num      the tag number (see `Asn1Value.tag_num`)
 * @param constructed  whether the content is constructed (see `Asn1Value.constructed`)
 * @return             the assembled value
 */
fn mk_value(kind: Asn1Tag, flag: bool, integer: bigint::BigInt, bytes: []byte, unused_bits: u64, oid: []u64, text: str, items: []Asn1Value, tag_class: Asn1Class, tag_num: u64, constructed: bool): Asn1Value {
    Asn1Value { kind = kind; flag = flag; integer = integer; bytes = bytes; unused_bits = unused_bits; oid = oid; text = text; items = items; tag_class = tag_class; tag_num = tag_num; constructed = constructed }
}

/**
 * Wraps a boolean as a BOOLEAN value.
 *
 * @param v  the boolean
 * @return   the ASN.1 BOOLEAN value
 */
exp fn asn1_boolean(v: bool): Asn1Value {
    mk_value(Asn1Tag::Boolean, v, bigint::zero(), no_bytes(), 0, no_arcs(), "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Wraps an arbitrary-precision integer as an INTEGER value.
 *
 * @param v  the value
 * @return   the ASN.1 INTEGER value
 */
exp fn asn1_integer(v: bigint::BigInt): Asn1Value {
    mk_value(Asn1Tag::Integer, false, v, no_bytes(), 0, no_arcs(), "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Builds a BIT STRING value from `payload` bytes plus a count of unused trailing bits in the
 * last byte.
 *
 * @param payload      the bit-string content bytes
 * @param unused_bits  the number of unused low-order bits in the last byte of `payload`
 * @return             the ASN.1 BIT STRING value
 * @throws             when `unused_bits > 7`, or `payload` is empty with a nonzero `unused_bits`
 */
exp fn asn1_bit_string(payload: []byte, unused_bits: u64): Asn1Value | error {
    if unused_bits > 7 { return error { message = "asn1: BIT STRING unused-bit count must be 0..7" } }
    if payload.len == 0 && unused_bits != 0 { return error { message = "asn1: an empty BIT STRING must have zero unused bits" } }
    bit_string_raw(payload, unused_bits)
}

/**
 * Builds a BIT STRING value without re-validating `unused_bits` — the internal counterpart to
 * `asn1_bit_string` used once a caller (a builder or the decoder) has already checked the
 * invariant.
 *
 * @param payload      the bit-string content bytes
 * @param unused_bits  the already-validated unused-bit count
 * @return             the ASN.1 BIT STRING value
 */
fn bit_string_raw(payload: []byte, unused_bits: u64): Asn1Value {
    mk_value(Asn1Tag::BitString, false, bigint::zero(), payload, unused_bits, no_arcs(), "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Wraps raw bytes as an OCTET STRING value.
 *
 * @param payload  the content bytes
 * @return         the ASN.1 OCTET STRING value
 */
exp fn asn1_octet_string(payload: []byte): Asn1Value {
    mk_value(Asn1Tag::OctetString, false, bigint::zero(), payload, 0, no_arcs(), "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * The ASN.1 NULL value.
 *
 * @return  the ASN.1 NULL value
 */
exp fn asn1_null(): Asn1Value {
    mk_value(Asn1Tag::Null, false, bigint::zero(), no_bytes(), 0, no_arcs(), "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Builds an OBJECT IDENTIFIER value from its arc list (e.g. `[1, 2, 840, 113549, 1, 1, 1]` for
 * `1.2.840.113549.1.1.1`), validating the X.690 §8.19.4 first/second-arc constraint.
 *
 * @param arcs  the arc list, at least two components
 * @return      the ASN.1 OBJECT IDENTIFIER value
 * @throws      when `arcs` has fewer than two components, the first arc exceeds 2, or the first
 *              arc is 0 or 1 and the second arc exceeds 39
 */
exp fn asn1_oid(arcs: []u64): Asn1Value | error {
    if arcs.len < 2 { return error { message = "asn1: OBJECT IDENTIFIER needs at least two arcs" } }
    if arcs[0] > 2 { return error { message = "asn1: OBJECT IDENTIFIER first arc must be 0, 1, or 2" } }
    if arcs[0] < 2 && arcs[1] > 39 { return error { message = "asn1: OBJECT IDENTIFIER second arc must be 0..39 when the first arc is 0 or 1" } }
    oid_raw(arcs)
}

/**
 * Builds an OBJECT IDENTIFIER value without re-validating the arc list — the internal
 * counterpart to `asn1_oid` used once a caller has already checked the invariant.
 *
 * @param arcs  the already-validated arc list
 * @return      the ASN.1 OBJECT IDENTIFIER value
 */
fn oid_raw(arcs: []u64): Asn1Value {
    mk_value(Asn1Tag::ObjectIdentifier, false, bigint::zero(), no_bytes(), 0, arcs, "", no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Wraps text as a UTF8String value. Total: a Teko `str` is always valid UTF-8, so every `str`
 * has a UTF8String rendering.
 *
 * @param s  the text
 * @return   the ASN.1 UTF8String value
 */
exp fn asn1_utf8_string(s: str): Asn1Value {
    mk_value(Asn1Tag::Utf8String, false, bigint::zero(), no_bytes(), 0, no_arcs(), s, no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Does `b` belong to the PrintableString charset (X.680 §41.4): letters, digits, space, or one
 * of `' ( ) + , - . / : = ?`?
 *
 * @param b  the byte to classify
 * @return   true when `b` is an allowed PrintableString character
 */
fn is_printable_string_byte(b: byte): bool {
    if b >= b'A' && b <= b'Z' { return true }
    if b >= b'a' && b <= b'z' { return true }
    if b >= b'0' && b <= b'9' { return true }
    b == b' ' || b == b'\'' || b == b'(' || b == b')' || b == b'+' || b == b',' || b == b'-' || b == b'.' || b == b'/' || b == b':' || b == b'=' || b == b'?'
}

/**
 * Reports whether every byte of `s` is in the PrintableString charset.
 *
 * @param s  the text to check
 * @return   true when `s` is entirely PrintableString-safe
 */
fn is_printable_string(s: str): bool {
    var b = bytes_of_str(s)
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        if !is_printable_string_byte(b[i]) { return false }
        i++
    }
    true
}

/**
 * Wraps text as a PrintableString value, validating its restricted charset (X.680 §41.4).
 *
 * @param s  the text
 * @return   the ASN.1 PrintableString value
 * @throws   when `s` contains a character outside the PrintableString charset
 */
exp fn asn1_printable_string(s: str): Asn1Value | error {
    if !is_printable_string(s) { return error { message = "asn1: PrintableString contains a disallowed character" } }
    mk_value(Asn1Tag::PrintableString, false, bigint::zero(), no_bytes(), 0, no_arcs(), s, no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Reports whether every byte of `s` is 7-bit ASCII (`< 128`), the IA5String charset.
 *
 * @param s  the text to check
 * @return   true when `s` is entirely 7-bit ASCII
 */
fn is_ia5_charset(s: str): bool {
    var b = bytes_of_str(s)
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        if b[i] > 127 { return false }
        i++
    }
    true
}

/**
 * Wraps text as an IA5String value, validating it is 7-bit ASCII.
 *
 * @param s  the text
 * @return   the ASN.1 IA5String value
 * @throws   when `s` contains a byte `>= 128`
 */
exp fn asn1_ia5_string(s: str): Asn1Value | error {
    if !is_ia5_charset(s) { return error { message = "asn1: IA5String contains a non-ASCII byte" } }
    mk_value(Asn1Tag::IA5String, false, bigint::zero(), no_bytes(), 0, no_arcs(), s, no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Reports whether every byte of `s[from, to)` is an ASCII decimal digit.
 *
 * @param s     the text
 * @param from  the inclusive start offset
 * @param to    the exclusive end offset
 * @return      true when every byte in the range is `'0'..'9'`
 */
fn all_digits(s: str, from: u64, to: u64): bool {
    var b = bytes_of_str(s)
    var i = from
    loop {
        if i >= to { break }
        if b[i] < b'0' || b[i] > b'9' { return false }
        i++
    }
    true
}

/**
 * Reports whether `s` is exactly the DER canonical UTCTime form `YYMMDDHHMMSSZ` (RFC 5280 §4.1.2.5.1):
 * 12 decimal digits followed by a literal `Z`, 13 bytes total.
 *
 * @param s  the text to check
 * @return   true when `s` matches the canonical UTCTime form
 */
fn is_valid_utc_time(s: str): bool {
    if s.len != 13 { return false }
    if !all_digits(s, 0, 12) { return false }
    bytes_of_str(s)[12] == b'Z'
}

/**
 * Wraps text as a UTCTime value, validating the DER canonical `YYMMDDHHMMSSZ` form (RFC 5280
 * §4.1.2.5.1 — no fractional seconds, no explicit offset, UTC only).
 *
 * @param s  the time text
 * @return   the ASN.1 UTCTime value
 * @throws   when `s` is not exactly `YYMMDDHHMMSSZ`
 */
exp fn asn1_utc_time(s: str): Asn1Value | error {
    if !is_valid_utc_time(s) { return error { message = "asn1: UTCTime must be the canonical YYMMDDHHMMSSZ form" } }
    mk_value(Asn1Tag::UtcTime, false, bigint::zero(), no_bytes(), 0, no_arcs(), s, no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Reports whether `s` is exactly the DER canonical GeneralizedTime form `YYYYMMDDHHMMSSZ` (RFC
 * 5280 §4.1.2.5.2): 14 decimal digits followed by a literal `Z`, 15 bytes total.
 *
 * @param s  the text to check
 * @return   true when `s` matches the canonical GeneralizedTime form
 */
fn is_valid_generalized_time(s: str): bool {
    if s.len != 15 { return false }
    if !all_digits(s, 0, 14) { return false }
    bytes_of_str(s)[14] == b'Z'
}

/**
 * Wraps text as a GeneralizedTime value, validating the DER canonical `YYYYMMDDHHMMSSZ` form
 * (RFC 5280 §4.1.2.5.2 — no fractional seconds, UTC only).
 *
 * @param s  the time text
 * @return   the ASN.1 GeneralizedTime value
 * @throws   when `s` is not exactly `YYYYMMDDHHMMSSZ`
 */
exp fn asn1_generalized_time(s: str): Asn1Value | error {
    if !is_valid_generalized_time(s) { return error { message = "asn1: GeneralizedTime must be the canonical YYYYMMDDHHMMSSZ form" } }
    mk_value(Asn1Tag::GeneralizedTime, false, bigint::zero(), no_bytes(), 0, no_arcs(), s, no_items(), Asn1Class::Universal, 0, false)
}

/**
 * Wraps a sequence of values as a SEQUENCE.
 *
 * @param items  the elements, in order
 * @return       the ASN.1 SEQUENCE value
 */
exp fn asn1_sequence(items: []Asn1Value): Asn1Value {
    mk_value(Asn1Tag::Sequence, false, bigint::zero(), no_bytes(), 0, no_arcs(), "", items, Asn1Class::Universal, 0, true)
}

/**
 * Wraps a sequence of values as a SET. `der_encode` sorts the encoded members into bytewise
 * ascending order (see the module doc's CANONICAL DER note); the order given here need not
 * already be sorted.
 *
 * @param items  the elements
 * @return       the ASN.1 SET value
 */
exp fn asn1_set(items: []Asn1Value): Asn1Value {
    mk_value(Asn1Tag::Set, false, bigint::zero(), no_bytes(), 0, no_arcs(), "", items, Asn1Class::Universal, 0, true)
}

/**
 * Builds a constructed context/application/private-tagged value — EXPLICIT tagging of a single
 * child (`items` of length 1) or a constructed IMPLICIT-tagged aggregate (any length).
 *
 * @param tag_class  the tag class
 * @param num        the tag number
 * @param items      the child values
 * @return           the ASN.1 tagged value
 */
exp fn asn1_tagged_constructed(tag_class: Asn1Class, num: u64, items: []Asn1Value): Asn1Value {
    mk_value(Asn1Tag::Tagged, false, bigint::zero(), no_bytes(), 0, no_arcs(), "", items, tag_class, num, true)
}

/**
 * Builds a primitive context/application/private-tagged value (typically an IMPLICIT-tagged
 * primitive type) carrying its content as opaque raw bytes.
 *
 * @param tag_class  the tag class
 * @param num        the tag number
 * @param payload    the raw primitive content
 * @return           the ASN.1 tagged value
 */
exp fn asn1_tagged_primitive(tag_class: Asn1Class, num: u64, payload: []byte): Asn1Value {
    mk_value(Asn1Tag::Tagged, false, bigint::zero(), payload, 0, no_arcs(), "", no_items(), tag_class, num, false)
}

/**
 * Parses a dotted-decimal OID string (e.g. `"1.2.840.113549.1.1.1"`) into its arc list.
 *
 * @param s  the dotted-decimal text
 * @return   the parsed arc list
 * @throws   when `s` is empty, has an empty arc (`""`, a leading/trailing/doubled `.`), a
 *           non-decimal character, or fewer than two arcs overall
 */
exp fn asn1_oid_from_str(s: str): []u64 | error {
    if s.len == 0 { return error { message = "asn1: empty OID string" } }
    var b = bytes_of_str(s)
    var arcs: []u64 = no_arcs()
    var cur: u64 = 0
    var saw_digit = false
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        var c = b[i]
        if c == b'.' {
            if !saw_digit { return error { message = "asn1: OID has an empty arc" } }
            arcs = teko::list::push(arcs, cur)
            cur = 0
            saw_digit = false
            i++
            continue
        }
        if c < b'0' || c > b'9' { return error { message = "asn1: OID arc must be decimal digits" } }
        cur = cur * 10 + ((c to u64) - (b'0' to u64))
        saw_digit = true
        i++
    }
    if !saw_digit { return error { message = "asn1: OID has an empty arc" } }
    arcs = teko::list::push(arcs, cur)
    if arcs.len < 2 { return error { message = "asn1: OID needs at least two arcs" } }
    arcs
}

/**
 * Renders an arc list as a dotted-decimal OID string (e.g. `[1, 2, 840]` -> `"1.2.840"`).
 *
 * @param arcs  the arc list
 * @return      the dotted-decimal text
 */
exp fn asn1_oid_to_str(arcs: []u64): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= arcs.len { break }
        if i > 0 { out = concat(out, ".") }
        out = concat(out, u64_to_str(arcs[i]))
        i++
    }
    out
}

/**
 * Compares two byte slices for exact equality.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and identical bytes
 */
fn bytes_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

/**
 * Compares two arc lists for exact equality.
 *
 * @param a  the first arc list
 * @param b  the second arc list
 * @return   true when both have the same length and identical arcs
 */
fn arcs_equal(a: []u64, b: []u64): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

/**
 * Compares two `Asn1Value` slices elementwise with `asn1_equal`.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and structurally equal elements
 */
fn items_equal(a: []Asn1Value, b: []Asn1Value): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if !asn1_equal(a[i], b[i]) { return false }
        i++
    }
    true
}

/**
 * Structurally compares two `Asn1Value` trees for equality, recursing through SEQUENCE, SET, and
 * constructed tagged content.
 *
 * @param a  the first value
 * @param b  the second value
 * @return   true when the two trees are structurally identical
 */
exp fn asn1_equal(a: Asn1Value, b: Asn1Value): bool {
    if a.kind != b.kind { return false }
    match a.kind {
        Asn1Tag::Boolean => a.flag == b.flag
        Asn1Tag::Integer => bigint::eq(a.integer, b.integer)
        Asn1Tag::BitString => a.unused_bits == b.unused_bits && bytes_equal(a.bytes, b.bytes)
        Asn1Tag::OctetString => bytes_equal(a.bytes, b.bytes)
        Asn1Tag::Null => true
        Asn1Tag::ObjectIdentifier => arcs_equal(a.oid, b.oid)
        Asn1Tag::Utf8String => a.text == b.text
        Asn1Tag::PrintableString => a.text == b.text
        Asn1Tag::IA5String => a.text == b.text
        Asn1Tag::UtcTime => a.text == b.text
        Asn1Tag::GeneralizedTime => a.text == b.text
        Asn1Tag::Sequence => items_equal(a.items, b.items)
        Asn1Tag::Set => items_equal(a.items, b.items)
        Asn1Tag::Tagged => tagged_equal(a, b)
    }
}

/**
 * The `Tagged`-kind arm of `asn1_equal`: same class, tag number, and constructed flag, then
 * either child equality (constructed) or payload equality (primitive).
 *
 * @param a  the first tagged value
 * @param b  the second tagged value
 * @return   true when both tagged values are structurally identical
 */
fn tagged_equal(a: Asn1Value, b: Asn1Value): bool {
    if a.tag_class != b.tag_class || a.tag_num != b.tag_num || a.constructed != b.constructed { return false }
    if a.constructed { return items_equal(a.items, b.items) }
    bytes_equal(a.bytes, b.bytes)
}

/**
 * The universal class tag number for every non-`Tagged` kind (X.680 §8): `Boolean` 1, `Integer`
 * 2, `BitString` 3, `OctetString` 4, `Null` 5, `ObjectIdentifier` 6, `Sequence` 16, `Set` 17,
 * `Utf8String` 12, `PrintableString` 19, `IA5String` 22, `UtcTime` 23, `GeneralizedTime` 24.
 * Never called for `Tagged` (whose number lives in `Asn1Value.tag_num` instead).
 *
 * @param kind  the non-`Tagged` kind
 * @return      its universal tag number
 */
fn universal_tag_num(kind: Asn1Tag): u64 {
    match kind {
        Asn1Tag::Boolean => 1
        Asn1Tag::Integer => 2
        Asn1Tag::BitString => 3
        Asn1Tag::OctetString => 4
        Asn1Tag::Null => 5
        Asn1Tag::ObjectIdentifier => 6
        Asn1Tag::Utf8String => 12
        Asn1Tag::PrintableString => 19
        Asn1Tag::IA5String => 22
        Asn1Tag::UtcTime => 23
        Asn1Tag::GeneralizedTime => 24
        Asn1Tag::Sequence => 16
        Asn1Tag::Set => 17
        Asn1Tag::Tagged => 0
    }
}

/**
 * The inverse of `universal_tag_num`: maps a universal-class tag number to its `Asn1Tag` kind.
 *
 * @param num  the universal tag number
 * @return     the corresponding kind
 * @throws     when `num` is not one of the universal tag numbers this module models
 */
fn kind_of_universal_tag(num: u64): Asn1Tag | error {
    if num == 1 { return Asn1Tag::Boolean }
    if num == 2 { return Asn1Tag::Integer }
    if num == 3 { return Asn1Tag::BitString }
    if num == 4 { return Asn1Tag::OctetString }
    if num == 5 { return Asn1Tag::Null }
    if num == 6 { return Asn1Tag::ObjectIdentifier }
    if num == 12 { return Asn1Tag::Utf8String }
    if num == 19 { return Asn1Tag::PrintableString }
    if num == 22 { return Asn1Tag::IA5String }
    if num == 23 { return Asn1Tag::UtcTime }
    if num == 24 { return Asn1Tag::GeneralizedTime }
    if num == 16 { return Asn1Tag::Sequence }
    if num == 17 { return Asn1Tag::Set }
    error { message = concat("asn1: unsupported universal tag number ", u64_to_str(num)) }
}

/**
 * Is `kind`'s content constructed (SEQUENCE, SET) rather than primitive (every other non-`Tagged`
 * kind)?
 *
 * @param kind  the non-`Tagged` kind
 * @return      true for `Sequence`/`Set`
 */
fn is_constructed_kind(kind: Asn1Tag): bool {
    kind == Asn1Tag::Sequence || kind == Asn1Tag::Set
}

/**
 * Maps a tag class to its 2-bit identifier-octet encoding (X.690 §8.1.2.2): `Universal` 0,
 * `Application` 1, `ContextSpecific` 2, `Private` 3.
 *
 * @param tag_class  the tag class
 * @return           its 2-bit code
 */
fn class_bits(tag_class: Asn1Class): u64 {
    match tag_class {
        Asn1Class::Universal => 0
        Asn1Class::Application => 1
        Asn1Class::ContextSpecific => 2
        Asn1Class::Private => 3
    }
}

/**
 * The inverse of `class_bits`: maps a 2-bit identifier-octet class code to its `Asn1Class`.
 *
 * @param bits  the 2-bit class code (`0..3`)
 * @return      the corresponding tag class
 */
fn class_of_bits(bits: u64): Asn1Class {
    if bits == 0 { return Asn1Class::Universal }
    if bits == 1 { return Asn1Class::Application }
    if bits == 2 { return Asn1Class::ContextSpecific }
    Asn1Class::Private
}
