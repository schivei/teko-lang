fn bytes_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn expect_parts(result: []MultipartPart | error): []MultipartPart {
    match result {
        []MultipartPart as parts => parts
        error => { teko::assert::is_true(false); teko::list::empty() }
    }
}

fn expect_error(result: []MultipartPart | error) {
    match result {
        []MultipartPart => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

fn expect_boundary(result: str | error): str {
    match result {
        str as s => s
        error => { teko::assert::is_true(false); "" }
    }
}

#test
fn form_urlencoded_round_trips_through_the_mime_entry_points() {
    var fields: []teko::encoding::url::FormField = teko::list::empty()
    fields = teko::list::push(fields, teko::encoding::url::FormField { key = "q"; value = "a b&c" })
    fields = teko::list::push(fields, teko::encoding::url::FormField { key = "page"; value = "2" })
    var body = encode_form_urlencoded(fields)
    var parsed = match parse_form_urlencoded(body) {
        []teko::encoding::url::FormField as fs => fs
        error => { teko::assert::is_true(false); teko::list::empty() }
    }
    teko::assert::len_eq(parsed.len, 2)
    teko::assert::eq_str(parsed[0].key, "q")
    teko::assert::eq_str(parsed[0].value, "a b&c")
    teko::assert::eq_str(parsed[1].key, "page")
    teko::assert::eq_str(parsed[1].value, "2")
}

#test
fn build_then_parse_multipart_round_trips_a_text_and_a_binary_part() {
    var text_bytes = bytes_of_str("hello world")
    var binary_bytes: []byte = teko::list::empty()
    binary_bytes = teko::list::push(binary_bytes, 0x00 to byte)
    binary_bytes = teko::list::push(binary_bytes, 0xFF to byte)
    binary_bytes = teko::list::push(binary_bytes, 0x0D to byte)
    binary_bytes = teko::list::push(binary_bytes, 0x0A to byte)

    var parts: []MultipartPart = teko::list::empty()
    parts = teko::list::push(parts, MultipartPart { name = "field"; filename = ""; content_type = ""; data = text_bytes })
    parts = teko::list::push(parts, MultipartPart { name = "upload"; filename = "a.bin"; content_type = "application/octet-stream"; data = binary_bytes })

    var boundary = default_boundary()
    var built = build_multipart(parts, boundary)
    var parsed = expect_parts(parse_multipart(built, boundary))

    teko::assert::len_eq(parsed.len, 2)
    teko::assert::eq_str(parsed[0].name, "field")
    teko::assert::eq_str(parsed[0].filename, "")
    teko::assert::eq_str(parsed[0].content_type, "")
    teko::assert::is_true(bytes_equal(parsed[0].data, text_bytes))
    teko::assert::eq_str(parsed[1].name, "upload")
    teko::assert::eq_str(parsed[1].filename, "a.bin")
    teko::assert::eq_str(parsed[1].content_type, "application/octet-stream")
    teko::assert::is_true(bytes_equal(parsed[1].data, binary_bytes))
}

#test
fn build_multipart_of_zero_parts_still_yields_a_final_boundary_only() {
    var parts: []MultipartPart = teko::list::empty()
    var built = build_multipart(parts, default_boundary())
    var parsed = expect_parts(parse_multipart(built, default_boundary()))
    teko::assert::len_eq(parsed.len, 0)
}

#test
fn quoted_name_and_filename_escape_and_unescape_special_characters() {
    var parts: []MultipartPart = teko::list::empty()
    parts = teko::list::push(parts, MultipartPart { name = "a \"quoted\" name"; filename = "back\\slash.txt"; content_type = ""; data = bytes_of_str("x") })
    var boundary = default_boundary()
    var parsed = expect_parts(parse_multipart(build_multipart(parts, boundary), boundary))
    teko::assert::len_eq(parsed.len, 1)
    teko::assert::eq_str(parsed[0].name, "a \"quoted\" name")
    teko::assert::eq_str(parsed[0].filename, "back\\slash.txt")
}

#test
fn parse_multipart_rejects_body_without_boundary() {
    expect_error(parse_multipart(bytes_of_str("no boundary in here"), default_boundary()))
}

#test
fn parse_multipart_rejects_part_missing_content_disposition_name() {
    var boundary = "X"
    var raw = concat("--", boundary, "\r\nContent-Type: text/plain\r\n\r\nbody\r\n--", boundary, "--\r\n")
    expect_error(parse_multipart(bytes_of_str(raw), boundary))
}

#test
fn extract_boundary_reads_quoted_and_unquoted_forms() {
    var quoted = expect_boundary(extract_boundary("multipart/form-data; boundary=\"abc123\""))
    teko::assert::eq_str(quoted, "abc123")
    var unquoted = expect_boundary(extract_boundary("multipart/form-data; boundary=abc123; charset=utf-8"))
    teko::assert::eq_str(unquoted, "abc123")
}

#test
fn extract_boundary_rejects_content_type_without_boundary_parameter() {
    match extract_boundary("multipart/form-data") {
        str => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}
