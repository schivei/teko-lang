fn expect_ok(result: IniDocument | error): IniDocument {
    match result {
        IniDocument as d => d
        error => { teko::assert::is_true(false); ini_empty() }
    }
}

fn expect_error(result: IniDocument | error) {
    match result {
        IniDocument => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

#test
fn sections_and_values_round_trip() {
    var doc = expect_ok(parse_ini("[owner]\nname = Tom\nrole : admin\n[servers]\nalpha = 10.0.0.1\nbeta = 10.0.0.2\n"))
    teko::assert::is_true(doc.sections.len == 2)
    teko::assert::is_true(ini_get(doc, "owner", "name") == "Tom")
    teko::assert::is_true(ini_get(doc, "owner", "role") == "admin")
    teko::assert::is_true(ini_get(doc, "servers", "alpha") == "10.0.0.1")
    teko::assert::is_true(ini_get(doc, "servers", "beta") == "10.0.0.2")
}

#test
fn colon_separator_and_comments() {
    var text = "[sec1]\nkey1 = value1\nkey2 : value2\n; a comment\n# another comment\nkey3 =    spaced value   \n[sec2]\nonlykey =\nquoted = \"hello\"\n"
    var doc = expect_ok(parse_ini(text))
    teko::assert::is_true(ini_get(doc, "sec1", "key1") == "value1")
    teko::assert::is_true(ini_get(doc, "sec1", "key2") == "value2")
    teko::assert::is_true(ini_get(doc, "sec1", "key3") == "spaced value")
    teko::assert::is_true(ini_get(doc, "sec2", "onlykey") == "")
}

#test
fn optional_quote_stripping_is_a_documented_divergence_from_configparser() {
    var doc = expect_ok(parse_ini("[sec2]\nquoted = \"hello\"\n"))
    teko::assert::is_true(ini_get(doc, "sec2", "quoted") == "hello")
}

#test
fn global_section_before_any_header_is_a_documented_divergence_from_configparser() {
    var doc = expect_ok(parse_ini("loose = value\n[sec]\nk = v\n"))
    teko::assert::is_true(ini_get(doc, "", "loose") == "value")
    teko::assert::is_true(ini_get(doc, "sec", "k") == "v")
}

#test
fn missing_key_and_missing_section_lookup_are_null() {
    var doc = expect_ok(parse_ini("[sec]\nk = v\n"))
    match ini_get(doc, "sec", "missing") { str => teko::assert::is_true(false); null => teko::assert::is_true(true) }
    match ini_get(doc, "nosuch", "k") { str => teko::assert::is_true(false); null => teko::assert::is_true(true) }
}

#test
fn write_ini_round_trips_through_parse_ini() {
    var doc = expect_ok(parse_ini("[a]\nx = 1\ny = 2\n[b]\nz = 3\n"))
    var text = write_ini(doc)
    var reparsed = expect_ok(parse_ini(text))
    teko::assert::is_true(ini_get(reparsed, "a", "x") == "1")
    teko::assert::is_true(ini_get(reparsed, "a", "y") == "2")
    teko::assert::is_true(ini_get(reparsed, "b", "z") == "3")
}

#test
fn write_ini_omits_header_line_for_the_global_section() {
    var doc = ini_set(ini_empty(), "", "k", "v")
    var text = write_ini(doc)
    teko::assert::is_true(!teko::str::contains(text, "[]"))
    var reparsed = expect_ok(parse_ini(text))
    teko::assert::is_true(ini_get(reparsed, "", "k") == "v")
}

#test
fn parse_ini_rejects_a_line_with_no_separator() {
    expect_error(parse_ini("[sec]\nnovalue\n"))
}

#test
fn parse_ini_rejects_an_unterminated_section_header() {
    expect_error(parse_ini("[unterminated\nk = v\n"))
}

#test
fn ini_set_replaces_an_existing_key_in_place() {
    var doc = ini_set(ini_empty(), "sec", "k", "first")
    doc = ini_set(doc, "sec", "other", "x")
    doc = ini_set(doc, "sec", "k", "second")
    var s = match ini_get_section(doc, "sec") { IniSection as sec => sec; null => { teko::assert::is_true(false); IniSection { name = ""; entries = [] } } }
    teko::assert::is_true(s.entries.len == 2)
    teko::assert::is_true(ini_get(doc, "sec", "k") == "second")
    teko::assert::is_true(ini_get(doc, "sec", "other") == "x")
}

#test
fn semicolon_and_hash_comment_lines_are_both_ignored() {
    var doc = expect_ok(parse_ini("; leading comment\n# also a comment\n[sec]\n; inside\nk = v\n# trailing\n"))
    teko::assert::is_true(doc.sections.len == 1)
    teko::assert::is_true(ini_get(doc, "sec", "k") == "v")
}

#test
fn hash_and_semicolon_inside_a_value_are_literal_not_a_comment() {
    var doc = expect_ok(parse_ini("[sec]\nk = v#not-a-comment\n"))
    teko::assert::is_true(ini_get(doc, "sec", "k") == "v#not-a-comment")
}
