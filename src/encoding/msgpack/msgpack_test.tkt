fn bytes_lit(xs: []i64): []byte {
    var out: []byte = []()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        out = teko::list::push(out, xs[i] to byte)
        i++
    }
    out
}

fn slices_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn expect_value(result: MsgValue | error): MsgValue {
    match result {
        MsgValue as v => v
        error => { teko::assert::is_true(false); msg_nil() }
    }
}

fn expect_error(result: MsgValue | error) {
    match result {
        MsgValue => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

fn assert_vector(v: MsgValue, want: []byte) {
    teko::assert::is_true(slices_equal(encode(v), want))
    teko::assert::is_true(msg_equal(v, expect_value(decode(want))))
}

fn pair(a: MsgValue, b: MsgValue): []MsgValue {
    var out: []MsgValue = []()
    out = teko::list::push(out, a)
    out = teko::list::push(out, b)
    out
}

#test
fn unsigned_integer_formats_match_spec() {
    assert_vector(msg_uint(0), bytes_lit([0x00]))
    assert_vector(msg_uint(127), bytes_lit([0x7f]))
    assert_vector(msg_uint(128), bytes_lit([0xcc, 0x80]))
    assert_vector(msg_uint(256), bytes_lit([0xcd, 0x01, 0x00]))
    assert_vector(msg_uint(65536), bytes_lit([0xce, 0x00, 0x01, 0x00, 0x00]))
    assert_vector(msg_uint(4294967296), bytes_lit([0xcf, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00]))
}

#test
fn negative_integer_formats_match_spec() {
    assert_vector(msg_int(-1), bytes_lit([0xff]))
    assert_vector(msg_int(-32), bytes_lit([0xe0]))
    assert_vector(msg_int(-33), bytes_lit([0xd0, 0xdf]))
    assert_vector(msg_int(-129), bytes_lit([0xd1, 0xff, 0x7f]))
    assert_vector(msg_int(-32769), bytes_lit([0xd2, 0xff, 0xff, 0x7f, 0xff]))
    assert_vector(msg_int(-2147483649), bytes_lit([0xd3, 0xff, 0xff, 0xff, 0xff, 0x7f, 0xff, 0xff, 0xff]))
}

#test
fn scalar_formats_match_spec() {
    assert_vector(msg_nil(), bytes_lit([0xc0]))
    assert_vector(msg_bool(false), bytes_lit([0xc2]))
    assert_vector(msg_bool(true), bytes_lit([0xc3]))
    assert_vector(msg_str(""), bytes_lit([0xa0]))
    assert_vector(msg_str("hello"), bytes_lit([0xa5, 0x68, 0x65, 0x6c, 0x6c, 0x6f]))
    assert_vector(msg_bin(bytes_lit([0x01, 0x02, 0x03])), bytes_lit([0xc4, 0x03, 0x01, 0x02, 0x03]))
}

#test
fn long_string_uses_str8() {
    var s = ""
    var i: u64 = 0
    loop {
        if i >= 32 { break }
        s = concat(s, "a")
        i++
    }
    var got = encode(msg_str(s))
    teko::assert::eq_u64(got.len, 34)
    teko::assert::is_true(got[0] == 0xd9 to byte)
    teko::assert::is_true(got[1] == 0x20 to byte)
    teko::assert::is_true(msg_equal(msg_str(s), expect_value(decode(got))))
}

#test
fn container_formats_match_spec() {
    assert_vector(msg_array([]), bytes_lit([0x90]))
    var xs: []MsgValue = []()
    xs = teko::list::push(xs, msg_uint(1))
    xs = teko::list::push(xs, msg_uint(2))
    xs = teko::list::push(xs, msg_uint(3))
    assert_vector(msg_array(xs), bytes_lit([0x93, 0x01, 0x02, 0x03]))
    assert_vector(msg_map([], []), bytes_lit([0x80]))
    assert_vector(msg_map(pair(msg_uint(1), msg_uint(3)), pair(msg_uint(2), msg_uint(4))), bytes_lit([0x82, 0x01, 0x02, 0x03, 0x04]))
    var mv: []MsgValue = []()
    mv = teko::list::push(mv, msg_array(pair(msg_str("x"), msg_bool(true))))
    var mk: []MsgValue = []()
    mk = teko::list::push(mk, msg_str("k"))
    var doc = msg_map(mk, mv)
    teko::assert::is_true(msg_equal(doc, expect_value(decode(encode(doc)))))
}

#test
fn float_formats_match_spec() {
    assert_vector(msg_float(1.5), bytes_lit([0xcb, 0x3f, 0xf8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]))
    var back = expect_value(decode(bytes_lit([0xca, 0x3f, 0xc0, 0x00, 0x00])))
    teko::assert::is_true(back.kind == MsgKind::Float)
    teko::assert::eq_f64(back.real, 1.5, 0.0)
}

#test
fn extension_formats_match_spec() {
    assert_vector(msg_ext(5, bytes_lit([0x99])), bytes_lit([0xd4, 0x05, 0x99]))
    assert_vector(msg_ext(-1, bytes_lit([0x0a, 0x0b, 0x0c, 0x0d])), bytes_lit([0xd6, 0xff, 0x0a, 0x0b, 0x0c, 0x0d]))
    assert_vector(msg_ext(1, bytes_lit([0x01, 0x02, 0x03])), bytes_lit([0xc7, 0x03, 0x01, 0x01, 0x02, 0x03]))
}

#test
fn malformed_inputs_are_errors() {
    expect_error(decode(bytes_lit([0xcc])))
    expect_error(decode(bytes_lit([0x93, 0x01, 0x02])))
    expect_error(decode(bytes_lit([0x00, 0x00])))
    expect_error(decode(bytes_lit([0xc1])))
    expect_error(decode(bytes_lit([0xa5, 0x68, 0x69])))
}
