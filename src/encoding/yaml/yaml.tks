/**
 * `teko::encoding::yaml` — a pure-Teko YAML 1.2 (https://yaml.org/spec/1.2.2/) decoder + encoder
 * over `str`, practical subset (catalog lane `teko::encoding::yaml`). Pure Teko, no C twin: like
 * `teko::encoding::toml` / `teko::encoding::cbor`, a library with zero OS/FFI dependency ships as
 * `.tks` only, and both engines pick it up automatically.
 *
 * VALUE MODEL — a TAGGED STRUCT (this file), not an `@Macro()` inline union: `YamlValue` carries a
 * `YamlKind` discriminant plus the union of every kind's payload fields, mirroring
 * `teko::encoding::toml::TomlValue` / `teko::encoding::cbor::CborValue`. `Map` is a pair of
 * parallel slices (`keys`/`vals`, source order preserved), the same "n unlabeled things walked in
 * lockstep" idiom `teko::encoding::json::JsonObject` and `TomlValue.keys`/`vals` use.
 *
 * THIS FILE is the value model shared by every file in this namespace: `YamlKind`/`YamlValue`, the
 * public constructors, the accessors, and structural equality. `yaml_parse.tks` (the decoder) and
 * `yaml_encode.tks` (the encoder) are its siblings — the same three-file split
 * `teko::encoding::toml` uses (`toml.tks` + `toml_parse.tks` + `toml_encode.tks`).
 *
 * SCOPE (this unit, YAML 1.2, PRACTICAL SUBSET — see `yaml_parse.tks`'s module doc for the full,
 * honest deferral list). Block mappings and sequences (indentation-based), flow collections (`{ }`,
 * `[ ]`), plain/single-/double-quoted scalars, literal (`|`) and folded (`>`) block scalars with
 * basic chomping (`-`/`+`), `#` comments, the CORE-SCHEMA scalar resolution rules (null/bool/
 * int/float vs. plain string), anchors (`&name`) and aliases (`*name`), and explicit document
 * markers (`---`/`...`) for multi-document streams.
 *
 * ERROR MODEL (M.1 fail-loud / M.3 honest types). `yaml_parse::parse_yaml(str): YamlValue | error`
 * / `parse_yaml_all(str): []YamlValue | error` — any malformed or unsupported-construct input is a
 * checked failure, never a panic. `yaml_encode::encode_yaml` is total (a well-formed `YamlValue`
 * tree always has a rendering) so it returns `str` bare.
 */

/**
 * The kind discriminant of a `YamlValue`: which YAML core-schema value shape it holds. `Str` covers
 * every YAML string form (plain, single-/double-quoted, literal/folded block — all normalize to the
 * same decoded `text`); `Seq` holds `items` (in source order); `Map` holds the parallel `keys`/
 * `vals` slices (source order preserved).
 */
exp type YamlKind = enum {
    Null; Bool; Int; Float; Str; Seq; Map
}

/**
 * One YAML value as a tagged struct spanning every `YamlKind` (see the module doc's VALUE MODEL
 * note): `kind` selects which fields below carry meaning.
 */
exp type YamlValue = struct {
    /**
     * Which YAML value shape this is; selects which of the fields below are meaningful.
     */
    kind: YamlKind
    /**
     * The decoded text for `Str`. Empty otherwise.
     */
    text: str
    /**
     * The value for `Int`. Zero otherwise.
     */
    int_val: i64
    /**
     * The value for `Float`. Zero otherwise.
     */
    float_val: f64
    /**
     * The value for `Bool`. `false` otherwise.
     */
    bool_val: bool
    /**
     * The elements, in source order, for `Seq`. Empty otherwise.
     */
    items: []YamlValue
    /**
     * The keys, in source order, for `Map`. Empty otherwise.
     */
    keys: []str
    /**
     * The values for `Map`, parallel to `keys`. Empty otherwise.
     */
    vals: []YamlValue
}

/**
 * A fresh empty `[]YamlValue`, the default for the child-carrying fields of a `YamlValue`.
 *
 * @return  an empty value slice
 */
fn no_items(): []YamlValue {
    teko::list::empty()
}

/**
 * A fresh empty `[]str`, the default for `YamlValue.keys`.
 *
 * @return  an empty string slice
 */
fn no_keys(): []str {
    teko::list::empty()
}

/**
 * Builds a `YamlValue` from every field explicitly — the single constructor every other builder in
 * this namespace funnels through, so each records only the fields its kind uses and leaves the rest
 * at defaults.
 *
 * @param kind       the value's kind discriminant
 * @param text       the string text (see `YamlValue.text`)
 * @param int_val    the integer value (see `YamlValue.int_val`)
 * @param float_val  the float value (see `YamlValue.float_val`)
 * @param bool_val   the boolean value (see `YamlValue.bool_val`)
 * @param items      the sequence elements (see `YamlValue.items`)
 * @param keys       the map keys (see `YamlValue.keys`)
 * @param vals       the map values (see `YamlValue.vals`)
 * @return           the assembled value
 */
fn mk_value(kind: YamlKind, text: str, int_val: i64, float_val: f64, bool_val: bool, items: []YamlValue, keys: []str, vals: []YamlValue): YamlValue {
    YamlValue { kind = kind; text = text; int_val = int_val; float_val = float_val; bool_val = bool_val; items = items; keys = keys; vals = vals }
}

/**
 * Appends every byte of `more` to `out`, returning the grown slice (functional accumulation, no
 * index-assignment) — shared by `yaml_parse.tks` and `yaml_encode.tks`, mirroring
 * `teko::encoding::toml::append_all`.
 *
 * @param out   the accumulator
 * @param more  the bytes to append
 * @return      `out` followed by `more`
 */
fn append_all(out: []byte, more: []byte): []byte {
    var acc = out
    var i: u64 = 0
    loop {
        if i >= more.len { break }
        acc = teko::list::push(acc, more[i])
        i++
    }
    acc
}

/**
 * The YAML `null` value (from `~`, `null`, an empty scalar, or a programmatically built document).
 *
 * @return  the YAML null value
 */
exp fn yaml_null(): YamlValue {
    mk_value(YamlKind::Null, "", 0, 0.0, false, no_items(), no_keys(), no_items())
}

/**
 * Wraps a boolean as a `YamlValue`.
 *
 * @param v  the boolean value
 * @return   the YAML boolean value
 */
exp fn yaml_bool(v: bool): YamlValue {
    mk_value(YamlKind::Bool, "", 0, 0.0, v, no_items(), no_keys(), no_items())
}

/**
 * Wraps a signed 64-bit integer as a `YamlValue`.
 *
 * @param v  the integer value
 * @return   the YAML integer value
 */
exp fn yaml_int(v: i64): YamlValue {
    mk_value(YamlKind::Int, "", v, 0.0, false, no_items(), no_keys(), no_items())
}

/**
 * Wraps a floating-point number as a `YamlValue`.
 *
 * @param v  the float value
 * @return   the YAML float value
 */
exp fn yaml_float(v: f64): YamlValue {
    mk_value(YamlKind::Float, "", 0, v, false, no_items(), no_keys(), no_items())
}

/**
 * Wraps decoded text as a `YamlValue` string (every YAML string form — plain, quoted, block —
 * decodes to this one kind).
 *
 * @param s  the decoded text
 * @return   the YAML string value
 */
exp fn yaml_string(s: str): YamlValue {
    mk_value(YamlKind::Str, s, 0, 0.0, false, no_items(), no_keys(), no_items())
}

/**
 * Wraps a sequence of values as a YAML sequence, in the given order.
 *
 * @param items  the elements, in order
 * @return       the YAML sequence value
 */
exp fn yaml_seq(items: []YamlValue): YamlValue {
    mk_value(YamlKind::Seq, "", 0, 0.0, false, items, no_keys(), no_items())
}

/**
 * A fresh, empty YAML mapping — the starting point for building a document programmatically (grow
 * it with `yaml_map_set`), and the shape every mapping node the parser builds starts from.
 *
 * @return  an empty YAML mapping value
 */
exp fn yaml_map_empty(): YamlValue {
    mk_value(YamlKind::Map, "", 0, 0.0, false, no_items(), no_keys(), no_items())
}

/**
 * Returns a new mapping equal to `map` with `key` set to `value`: replacing the existing entry in
 * place (preserving its position) when `key` is already present, else appending a new entry at the
 * end. This is the ONLY way to grow a `Map` value (no index-assignment, per house style).
 *
 * @param map    the mapping to extend (must have `kind == Map`; a non-mapping is returned unchanged)
 * @param key    the key to set
 * @param value  the value to set it to
 * @return       the updated mapping
 */
exp fn yaml_map_set(map: YamlValue, key: str, value: YamlValue): YamlValue {
    if map.kind != YamlKind::Map { return map }
    var new_keys: []str = no_keys()
    var new_vals: []YamlValue = no_items()
    var replaced = false
    var i: u64 = 0
    loop {
        if i >= map.keys.len { break }
        new_keys = teko::list::push(new_keys, map.keys[i])
        if map.keys[i] == key {
            new_vals = teko::list::push(new_vals, value)
            replaced = true
        } else {
            new_vals = teko::list::push(new_vals, map.vals[i])
        }
        i++
    }
    if !replaced {
        new_keys = teko::list::push(new_keys, key)
        new_vals = teko::list::push(new_vals, value)
    }
    mk_value(YamlKind::Map, map.text, map.int_val, map.float_val, map.bool_val, map.items, new_keys, new_vals)
}

/**
 * Looks up `key` in `map`'s direct entries (one level — nested lookups walk `yaml_get` segment by
 * segment).
 *
 * @param map  the mapping to search (a non-mapping always misses)
 * @param key  the key to look up
 * @return     the value at `key`, or `null` when `map` is not a mapping or has no such key
 */
exp fn yaml_get(map: YamlValue, key: str): YamlValue | null {
    if map.kind != YamlKind::Map { return null }
    var i: u64 = 0
    loop {
        if i >= map.keys.len { break }
        if map.keys[i] == key { return map.vals[i] }
        i++
    }
    null
}

/**
 * Looks up element `i` of `seq` (bounds-checked).
 *
 * @param seq  the sequence to index (a non-sequence always misses)
 * @param i    the zero-based index
 * @return     the element at `i`, or `null` when `seq` is not a sequence or `i` is out of range
 */
exp fn yaml_index(seq: YamlValue, i: u64): YamlValue | null {
    if seq.kind != YamlKind::Seq { return null }
    if i >= seq.items.len { return null }
    seq.items[i]
}

/**
 * Reads `v` as a string, requiring `kind == Str` (a strict, honest-types accessor — see the module
 * doc's ERROR MODEL note; a caller wanting looser coercion inspects `v.kind` directly).
 *
 * @param v  the value to read
 * @return   the string text, or `error` when `v` is not a `Str`
 */
exp fn yaml_to_str(v: YamlValue): str | error {
    if v.kind != YamlKind::Str { return yaml_type_error("string", v.kind) }
    v.text
}

/**
 * Reads `v` as a signed 64-bit integer, requiring `kind == Int`.
 *
 * @param v  the value to read
 * @return   the integer value, or `error` when `v` is not an `Int`
 */
exp fn yaml_to_int(v: YamlValue): i64 | error {
    if v.kind != YamlKind::Int { return yaml_type_error("int", v.kind) }
    v.int_val
}

/**
 * Reads `v` as a 64-bit float, requiring `kind == Float`.
 *
 * @param v  the value to read
 * @return   the float value, or `error` when `v` is not a `Float`
 */
exp fn yaml_to_float(v: YamlValue): f64 | error {
    if v.kind != YamlKind::Float { return yaml_type_error("float", v.kind) }
    v.float_val
}

/**
 * Reads `v` as a boolean, requiring `kind == Bool`.
 *
 * @param v  the value to read
 * @return   the boolean value, or `error` when `v` is not a `Bool`
 */
exp fn yaml_to_bool(v: YamlValue): bool | error {
    if v.kind != YamlKind::Bool { return yaml_type_error("bool", v.kind) }
    v.bool_val
}

/**
 * Builds the checked failure a `yaml_to_*` accessor returns on a `kind` mismatch.
 *
 * @param wanted  the requested shape's name
 * @param got     the value's actual kind
 * @return        the checked error
 */
fn yaml_type_error(wanted: str, got: YamlKind): error {
    error { message = concat("yaml: value is not a ", wanted, " (kind ", yaml_kind_name(got), ")") }
}

/**
 * Renders a `YamlKind` as a short lowercase name, for error messages.
 *
 * @param k  the kind to render
 * @return   its name
 */
fn yaml_kind_name(k: YamlKind): str {
    match k {
        YamlKind::Null => "null"
        YamlKind::Bool => "bool"
        YamlKind::Int => "int"
        YamlKind::Float => "float"
        YamlKind::Str => "string"
        YamlKind::Seq => "sequence"
        YamlKind::Map => "mapping"
    }
}

/**
 * Structurally compares two `YamlValue` trees for equality, recursing through sequences and
 * mappings (in slice order — two mappings with the same entries in a different order are NOT
 * equal, matching `teko::encoding::toml::toml_equal`'s slice-order convention). Floats compare by
 * `f64` bit pattern (so `NaN` equals `NaN`, and `-0.0` differs from `0.0`).
 *
 * @param a  the first value
 * @param b  the second value
 * @return   true when the two trees are structurally identical
 */
exp fn yaml_equal(a: YamlValue, b: YamlValue): bool {
    if a.kind != b.kind { return false }
    match a.kind {
        YamlKind::Null => true
        YamlKind::Bool => a.bool_val == b.bool_val
        YamlKind::Int => a.int_val == b.int_val
        YamlKind::Float => f64_bits(a.float_val) == f64_bits(b.float_val)
        YamlKind::Str => a.text == b.text
        YamlKind::Seq => items_equal(a.items, b.items)
        YamlKind::Map => keys_equal(a.keys, b.keys) && items_equal(a.vals, b.vals)
    }
}

/**
 * Compares two `YamlValue` slices elementwise with `yaml_equal`.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and structurally equal elements
 */
fn items_equal(a: []YamlValue, b: []YamlValue): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if !yaml_equal(a[i], b[i]) { return false }
        i++
    }
    true
}

/**
 * Compares two `[]str` slices for elementwise equality.
 *
 * @param a  the first slice
 * @param b  the second slice
 * @return   true when both have the same length and identical strings at every index
 */
fn keys_equal(a: []str, b: []str): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}
