use teko::list

// src/emit/tkh_frame.tks  (namespace 'teko::emit')
//
// the `.tkh` frame: version constant + `emit_tkh` (collect → table → body → FNV-1a →
// "TKH\0" header). Pure line-count split of tkh.tks; no behavior change.

/**
 * TKH_VERSION — wire format version of a `.tkh` exported-interface artifact. Bumped 1 → 2 in
 * 0.3.1 for exactly the reason `TKB_EXPR_VERSION`/`TKB_PROGRAM_VERSION` were: this unit reuses
 * the `.tkb` codec WHOLESALE (`write_type`/`read_type`, the string table, the FNV-1a frame — see
 * this file's header), so the drop-128 `PrimKind` ordinal renumbering moved every primitive's
 * on-wire number here too. A pre-0.3.1 `.tkh` passes the `"TKH\0"` magic AND its own FNV-1a (its
 * bytes are internally consistent), so nothing but the version field can catch it — without the
 * bump each primitive would decode into the WRONG type, silently. Owner ruling 2026-07-24: an old
 * artifact FAILS LOUD (M.3); no retroactive support for pre-STS/LTS formats.
 *
 * @since 0.3.1 (drop-128 R2)
 */
const TKH_VERSION: u32 = 2

/**
 * emit_tkh — serialize a whole exported interface `h` into the `.tkh` frame: the `"TKH\0"` magic,
 * `TKH_VERSION`, the FNV-1a of the body, then the string table and the body itself.
 *
 * @param h  the exported interface (its types, then its functions)
 * @return   the complete `.tkh` bytes
 */
fn emit_tkh(h: Header) -> []byte {
    let table = collect_header(st_empty(), h)
    let body = write_header(write_strtable(teko::list::empty(), table), table, h)
    let hash = fnv1a(body, 0)
    mut out: []byte = teko::list::empty()
    out = write_u8(out, b'T')
    out = write_u8(out, b'K')
    out = write_u8(out, b'H')
    out = write_u8(out, 0)
    out = write_u32(out, TKH_VERSION)
    out = write_u64(out, hash)
    append_bytes(out, body)
}
