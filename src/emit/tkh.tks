
use teko::checker


type SigParam = struct { name: str; type: @Type() }

type FnSig = struct {
    name: str
    params: []SigParam
    ret: @Type()
    has_doc: bool
    doc: str
}

type ConstSig = struct { name: str; type: @Type(); has_doc: bool; doc: str }

type SigField = struct { name: str; type: @Type() }

type TyShape = enum { Struct; Enum; Variant; Alias; Newtype; Interface; Trait; Flags; Extern; ExternStruct }

type TyExport = struct {
    name: str
    shape: TyShape
    fields: []SigField
    members: []str
    cases: []@Type()
    methods: []FnSig
    extends: []str
    has_doc: bool
    doc: str
}

type Header = struct { types: []TyExport; fns: []FnSig; consts: []ConstSig }


fn write_doc(buf: []byte, t: StrTable, has_doc: bool, doc: str): []byte {
    if !has_doc { return write_u8(buf, 0) }
    write_u32(write_u8(buf, 1), st_find(t, doc))
}

fn write_sigparam(buf: []byte, t: StrTable, p: SigParam): []byte {
    write_type(write_u32(buf, st_find(t, p.name)), t, p.type)
}

fn write_sigparams(buf: []byte, t: StrTable, xs: []SigParam): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_sigparam(b, t, xs[i])
        i++
    }
    b
}

fn write_fnsig(buf: []byte, t: StrTable, f: FnSig): []byte {
    var b = write_u32(buf, st_find(t, f.name))
    b = write_sigparams(b, t, f.params)
    b = write_type(b, t, f.ret)
    write_doc(b, t, f.has_doc, f.doc)
}

fn write_fnsigs(buf: []byte, t: StrTable, xs: []FnSig): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_fnsig(b, t, xs[i])
        i++
    }
    b
}

fn write_sigfield(buf: []byte, t: StrTable, f: SigField): []byte {
    write_type(write_u32(buf, st_find(t, f.name)), t, f.type)
}

fn write_sigfields(buf: []byte, t: StrTable, xs: []SigField): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_sigfield(b, t, xs[i])
        i++
    }
    b
}

fn write_members(buf: []byte, t: StrTable, xs: []str): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_u32(b, st_find(t, xs[i]))
        i++
    }
    b
}

fn shape_byte(s: TyShape): byte {
    if s == TyShape::Struct { return 0 }
    if s == TyShape::Enum { return 1 }
    if s == TyShape::Variant { return 2 }
    if s == TyShape::Alias { return 3 }
    if s == TyShape::Newtype { return 4 }
    if s == TyShape::Interface { return 5 }
    if s == TyShape::Trait { return 6 }
    if s == TyShape::Flags { return 7 }
    if s == TyShape::Extern { return 8 }
    9
}

fn write_tyexport(buf: []byte, t: StrTable, e: TyExport): []byte {
    var b = write_u32(buf, st_find(t, e.name))
    b = write_u8(b, shape_byte(e.shape))
    b = write_sigfields(b, t, e.fields)
    b = write_members(b, t, e.members)
    b = write_types(b, t, e.cases)
    b = write_fnsigs(b, t, e.methods)
    b = write_members(b, t, e.extends)
    write_doc(b, t, e.has_doc, e.doc)
}

fn write_tyexports(buf: []byte, t: StrTable, xs: []TyExport): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_tyexport(b, t, xs[i])
        i++
    }
    b
}

fn write_constsig(buf: []byte, t: StrTable, c: ConstSig): []byte {
    var b = write_u32(buf, st_find(t, c.name))
    b = write_type(b, t, c.type)
    write_doc(b, t, c.has_doc, c.doc)
}

fn write_constsigs(buf: []byte, t: StrTable, xs: []ConstSig): []byte {
    var b = write_u32(buf, xs.len to u32)
    var i = 0
    loop {
        if i >= xs.len { break }
        b = write_constsig(b, t, xs[i])
        i++
    }
    b
}

fn write_header(buf: []byte, t: StrTable, h: Header): []byte {
    var b = write_fnsigs(write_tyexports(buf, t, h.types), t, h.fns)
    write_constsigs(b, t, h.consts)
}


fn collect_doc(t: StrTable, has_doc: bool, doc: str): StrTable {
    if !has_doc { return t }
    st_intern(t, doc).table
}

fn collect_sigparam(t: StrTable, p: SigParam): StrTable {
    collect_type_strings(st_intern(t, p.name).table, p.type)
}

fn collect_sigparams(t: StrTable, xs: []SigParam): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_sigparam(tab, xs[i])
        i++
    }
    tab
}

fn collect_fnsig(t: StrTable, f: FnSig): StrTable {
    var t1 = st_intern(t, f.name).table
    var t2 = collect_sigparams(t1, f.params)
    var t3 = collect_type_strings(t2, f.ret)
    collect_doc(t3, f.has_doc, f.doc)
}

fn collect_fnsigs(t: StrTable, xs: []FnSig): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_fnsig(tab, xs[i])
        i++
    }
    tab
}

fn collect_sigfield(t: StrTable, f: SigField): StrTable {
    collect_type_strings(st_intern(t, f.name).table, f.type)
}

fn collect_sigfields(t: StrTable, xs: []SigField): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_sigfield(tab, xs[i])
        i++
    }
    tab
}

fn collect_members(t: StrTable, xs: []str): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = st_intern(tab, xs[i]).table
        i++
    }
    tab
}

fn collect_tyexport(t: StrTable, e: TyExport): StrTable {
    var t1 = st_intern(t, e.name).table
    var t2 = collect_sigfields(t1, e.fields)
    var t3 = collect_members(t2, e.members)
    var t4 = collect_type_list(t3, e.cases)
    var t5 = collect_fnsigs(t4, e.methods)
    var t6 = collect_members(t5, e.extends)
    collect_doc(t6, e.has_doc, e.doc)
}

fn collect_tyexports(t: StrTable, xs: []TyExport): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_tyexport(tab, xs[i])
        i++
    }
    tab
}

fn collect_constsig(t: StrTable, c: ConstSig): StrTable {
    var t1 = st_intern(t, c.name).table
    var t2 = collect_type_strings(t1, c.type)
    collect_doc(t2, c.has_doc, c.doc)
}

fn collect_constsigs(t: StrTable, xs: []ConstSig): StrTable {
    var tab = t
    var i = 0
    loop {
        if i >= xs.len { break }
        tab = collect_constsig(tab, xs[i])
        i++
    }
    tab
}

fn collect_header(t: StrTable, h: Header): StrTable {
    collect_constsigs(collect_fnsigs(collect_tyexports(t, h.types), h.fns), h.consts)
}


const TKH_VERSION: u32 = 3

fn emit_tkh(h: Header): []byte {
    var table = collect_header(st_empty(), h)
    var body = write_header(write_strtable(teko::list::empty(), table), table, h)
    var hash = fnv1a(body, 0)
    var out: []byte = teko::list::empty()
    out = write_u8(out, b'T')
    out = write_u8(out, b'K')
    out = write_u8(out, b'H')
    out = write_u8(out, 0)
    out = write_u32(out, TKH_VERSION)
    out = write_u64(out, hash)
    append_bytes(out, body)
}


type RDoc = struct { r: Reader; has_doc: bool; doc: str }
type RSigParam = struct { r: Reader; value: SigParam }
type RSigParams = struct { r: Reader; value: []SigParam }
type RFnSig = struct { r: Reader; value: FnSig }
type RFnSigs = struct { r: Reader; value: []FnSig }
type RSigField = struct { r: Reader; value: SigField }
type RSigFields = struct { r: Reader; value: []SigField }
type RMembers = struct { r: Reader; value: []str }
type RTyExport = struct { r: Reader; value: TyExport }
type RTyExports = struct { r: Reader; value: []TyExport }
type RConstSig = struct { r: Reader; value: ConstSig }
type RConstSigs = struct { r: Reader; value: []ConstSig }
type RHeader = struct { r: Reader; value: Header }

fn read_doc(r: Reader, table: []str): RDoc | error {
    var p = match read_u8(r) { RByte as x => x; error as e => return e }
    if p.value == 0 { return RDoc { r = p.r; has_doc = false; doc = "" } }
    var d = match tkb_read_str(p.r, table) { RStr as x => x; error as e => return e }
    RDoc { r = d.r; has_doc = true; doc = d.value }
}

fn read_sigparam(r: Reader, table: []str): RSigParam | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ty = match read_type(nm.r, table) { RType as x => x; error as e => return e }
    RSigParam { r = ty.r; value = SigParam { name = nm.value; type = ty.value } }
}

fn read_sigparams(r: Reader, table: []str): RSigParams | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []SigParam = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var p = match read_sigparam(rr, table) { RSigParam as x => x; error as e => return e }
        xs = teko::list::push(xs, p.value)
        rr = p.r
        i++
    }
    RSigParams { r = rr; value = xs }
}

fn read_fnsig(r: Reader, table: []str): RFnSig | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ps = match read_sigparams(nm.r, table) { RSigParams as x => x; error as e => return e }
    var rt = match read_type(ps.r, table) { RType as x => x; error as e => return e }
    var dc = match read_doc(rt.r, table) { RDoc as x => x; error as e => return e }
    RFnSig { r = dc.r; value = FnSig {
            name = nm.value; params = ps.value; ret = rt.value
            has_doc = dc.has_doc; doc = dc.doc
    } }
}

fn read_fnsigs(r: Reader, table: []str): RFnSigs | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []FnSig = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var f = match read_fnsig(rr, table) { RFnSig as x => x; error as e => return e }
        xs = teko::list::push(xs, f.value)
        rr = f.r
        i++
    }
    RFnSigs { r = rr; value = xs }
}

fn read_sigfield(r: Reader, table: []str): RSigField | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ty = match read_type(nm.r, table) { RType as x => x; error as e => return e }
    RSigField { r = ty.r; value = SigField { name = nm.value; type = ty.value } }
}

fn read_sigfields(r: Reader, table: []str): RSigFields | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []SigField = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var f = match read_sigfield(rr, table) { RSigField as x => x; error as e => return e }
        xs = teko::list::push(xs, f.value)
        rr = f.r
        i++
    }
    RSigFields { r = rr; value = xs }
}

fn read_members(r: Reader, table: []str): RMembers | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []str = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var s = match tkb_read_str(rr, table) { RStr as x => x; error as e => return e }
        xs = teko::list::push(xs, s.value)
        rr = s.r
        i++
    }
    RMembers { r = rr; value = xs }
}

fn shape_of(b: byte): TyShape {
    if b == 0 { return TyShape::Struct }
    if b == 1 { return TyShape::Enum }
    if b == 2 { return TyShape::Variant }
    if b == 3 { return TyShape::Alias }
    if b == 4 { return TyShape::Newtype }
    if b == 5 { return TyShape::Interface }
    if b == 6 { return TyShape::Trait }
    if b == 7 { return TyShape::Flags }
    if b == 8 { return TyShape::Extern }
    TyShape::ExternStruct
}

fn read_tyexport(r: Reader, table: []str): RTyExport | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var sh = match read_u8(nm.r) { RByte as x => x; error as e => return e }
    var fs = match read_sigfields(sh.r, table) { RSigFields as x => x; error as e => return e }
    var ms = match read_members(fs.r, table) { RMembers as x => x; error as e => return e }
    var cs = match read_types(ms.r, table) { RTypes as x => x; error as e => return e }
    var md = match read_fnsigs(cs.r, table) { RFnSigs as x => x; error as e => return e }
    var ex = match read_members(md.r, table) { RMembers as x => x; error as e => return e }
    var dc = match read_doc(ex.r, table) { RDoc as x => x; error as e => return e }
    RTyExport { r = dc.r; value = TyExport {
            name = nm.value; shape = shape_of(sh.value)
            fields = fs.value; members = ms.value; cases = cs.value
            methods = md.value; extends = ex.value
            has_doc = dc.has_doc; doc = dc.doc
    } }
}

fn read_tyexports(r: Reader, table: []str): RTyExports | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []TyExport = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var e = match read_tyexport(rr, table) { RTyExport as x => x; error as e => return e }
        xs = teko::list::push(xs, e.value)
        rr = e.r
        i++
    }
    RTyExports { r = rr; value = xs }
}

fn read_constsig(r: Reader, table: []str): RConstSig | error {
    var nm = match tkb_read_str(r, table) { RStr as x => x; error as e => return e }
    var ty = match read_type(nm.r, table) { RType as x => x; error as e => return e }
    var dc = match read_doc(ty.r, table) { RDoc as x => x; error as e => return e }
    RConstSig { r = dc.r; value = ConstSig {
            name = nm.value; type = ty.value; has_doc = dc.has_doc; doc = dc.doc
    } }
}

fn read_constsigs(r: Reader, table: []str): RConstSigs | error {
    var n = match read_u32(r) { RU32 as x => x; error as e => return e }
    var rr = n.r
    var xs: []ConstSig = teko::list::empty()
    var i = 0
    loop {
        if i >= n.value { break }
        var c = match read_constsig(rr, table) { RConstSig as x => x; error as e => return e }
        xs = teko::list::push(xs, c.value)
        rr = c.r
        i++
    }
    RConstSigs { r = rr; value = xs }
}

fn read_header(r: Reader, table: []str): RHeader | error {
    var ts = match read_tyexports(r, table) { RTyExports as x => x; error as e => return e }
    var fs = match read_fnsigs(ts.r, table) { RFnSigs as x => x; error as e => return e }
    var cs = match read_constsigs(fs.r, table) { RConstSigs as x => x; error as e => return e }
    RHeader { r = cs.r; value = Header { types = ts.value; fns = fs.value; consts = cs.value } }
}

fn read_tkh(data: []byte): Header | error {
    var r0 = Reader { data = data; pos = 0 }
    var m0 = match read_u8(r0) { RByte as x => x; error as e => return e }
    var m1 = match read_u8(m0.r) { RByte as x => x; error as e => return e }
    var m2 = match read_u8(m1.r) { RByte as x => x; error as e => return e }
    var m3 = match read_u8(m2.r) { RByte as x => x; error as e => return e }
    if m0.value != b'T' || m1.value != b'K' || m2.value != b'H' || m3.value != 0 {
        return error { message = "not a .tkh (bad magic)" }
    }
    var ver = match read_u32(m3.r) { RU32 as x => x; error as e => return e }
    if ver.value != TKH_VERSION {
        return error { message = "unsupported .tkh version (this compiler reads version 3; older artifacts predate the full exp-surface header and must be rebuilt with the current compiler)" }
    }
    var stored = match read_u64(ver.r) { RU64 as x => x; error as e => return e }
    if data.len < 16 { return error { message = "truncated .tkh header" } }
    if fnv1a(data, 16) != stored.value {
        return error { message = ".tkh altered or corrupt (hash mismatch)" }
    }
    var table = match read_strtable(stored.r) { RTable as x => x; error as e => return e }
    var h = match read_header(table.r, table.value) { RHeader as x => x; error as e => return e }
    h.value
}
