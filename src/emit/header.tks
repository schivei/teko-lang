
use teko::checker
use teko::parser

fn build_fnsig(f: checker::TFunction, table: checker::TypeTable): FnSig | error {
    var params: []SigParam = teko::list::empty()
    var i = 0
    loop {
        if i >= f.params.len { break }
        var pt = match checker::resolve_type(f.params[i].type_ann, table, f.namespace) {
            (@Type()) as t => t
            error as e => return e
        }
        params = teko::list::push(params, SigParam { name = f.params[i].name; type = pt })
        i++
    }
    FnSig { name = f.name; params = params; ret = f.return_type; has_doc = f.has_doc; doc = f.doc.read() }
}

fn fnsig_from_func(name: str, ft: checker::Func, has_doc: bool, doc: str): FnSig {
    var params: [ft.params.len]SigParam = []
    var i = 0
    loop {
        if i >= ft.params.len { break }
        params[i] = SigParam { name = ft.param_names[i]; type = ft.params[i] }
        i++
    }
    FnSig { name = name; params = params; ret = ft.ret; has_doc = has_doc; doc = doc }
}

fn build_method_sig(f: parser::Function, owner: str, ns: str, table: checker::TypeTable): FnSig | error {
    var ft = match checker::method_func_type(f, owner, table, ns) {
        (@Type()) as t => t
        error as e => return e
    }
    match ft {
        checker::Func as fn_t => fnsig_from_func(f.name, fn_t, f.has_doc, f.doc.read())
        _ => error { message = "an exported method did not resolve to a function type" }
    }
}

fn build_methods(ms: []parser::Function, owner: str, ns: str, table: checker::TypeTable): []FnSig | error {
    var out: [ms.len]FnSig = []
    var i = 0
    loop {
        if i >= ms.len { break }
        out[i] = match build_method_sig(ms[i], owner, ns, table) {
            FnSig as x => x
            error as e => return e
        }
        i++
    }
    out
}

fn build_target_case(te: @TypeExpr(), ns: str, table: checker::TypeTable): []@Type() | error {
    var t = match checker::resolve_type(te, table, ns) {
        (@Type()) as x => x
        error as e => return e
    }
    var cs: [1]@Type() = []
    cs[0] = t
    cs
}

fn build_sigfields(fields: []parser::Field, ns: str, table: checker::TypeTable): []SigField | error {
    var out: []SigField = teko::list::empty()
    var i = 0
    loop {
        if i >= fields.len { break }
        var ft = match checker::resolve_type(fields[i].type_ann, table, ns) {
            (@Type()) as t => t
            error as e => return e
        }
        out = teko::list::push(out, SigField { name = fields[i].name; type = ft })
        i++
    }
    out
}

fn build_tyexport(d: parser::TypeDecl, table: checker::TypeTable): TyExport | error {
    var ns = checker::name_qualifier(d.name)
    match d.body {
        parser::StructBody as sb => {
            var fields = match build_sigfields(sb.fields, ns, table) {
                []SigField as fs => fs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Struct
                fields = fields; members = teko::list::empty(); cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::EnumBody as eb => {
            TyExport {
                name = d.name; shape = TyShape::Enum
                fields = teko::list::empty(); members = eb.members; cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::VariantBody as vb => {
            var rt = match checker::resolve_type(vb.type_expr, table, ns) {
                (@Type()) as t => t
                error as e => return e
            }
            var cases = match rt {
                checker::Variant as v => v.members
                _ => return error { message = "an exported variant's body did not resolve to a union" }
            }
            TyExport {
                name = d.name; shape = TyShape::Variant
                fields = teko::list::empty(); members = teko::list::empty(); cases = cases
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::AliasBody as ab => {
            var cases = match build_target_case(ab.alias, ns, table) {
                []@Type() as cs => cs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Alias
                fields = teko::list::empty(); members = teko::list::empty(); cases = cases
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::NewtypeBody as nb => {
            var cases = match build_target_case(nb.backing, ns, table) {
                []@Type() as cs => cs
                error as e => return e
            }
            var methods = match build_methods(nb.methods, d.name, ns, table) {
                []FnSig as ms => ms
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Newtype
                fields = teko::list::empty(); members = teko::list::empty(); cases = cases
                methods = methods; extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::ExternBody => {
            TyExport {
                name = d.name; shape = TyShape::Extern
                fields = teko::list::empty(); members = teko::list::empty(); cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::ExternStructBody as esb => {
            var fields = match build_sigfields(esb.fields, ns, table) {
                []SigField as fs => fs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::ExternStruct
                fields = fields; members = teko::list::empty(); cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::FlagsBody as fb => {
            TyExport {
                name = d.name; shape = TyShape::Flags
                fields = teko::list::empty(); members = fb.members; cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::ClassBody as cb => {
            var fields = match build_sigfields(cb.fields, ns, table) {
                []SigField as fs => fs
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Struct
                fields = fields; members = teko::list::empty(); cases = teko::list::empty()
                methods = teko::list::empty(); extends = teko::list::empty()
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::InterfaceBody as ib => {
            var methods = match build_methods(ib.methods, d.name, ns, table) {
                []FnSig as ms => ms
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Interface
                fields = teko::list::empty(); members = teko::list::empty(); cases = teko::list::empty()
                methods = methods; extends = ib.extends
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
        parser::TraitBody as tb => {
            var fields = match build_sigfields(tb.fields, ns, table) {
                []SigField as fs => fs
                error as e => return e
            }
            var methods = match build_methods(tb.methods, d.name, ns, table) {
                []FnSig as ms => ms
                error as e => return e
            }
            TyExport {
                name = d.name; shape = TyShape::Trait
                fields = fields; members = teko::list::empty(); cases = teko::list::empty()
                methods = methods; extends = tb.implements
                has_doc = d.has_doc; doc = d.doc.read()
            }
        }
    }
}

fn build_constsig(c: checker::TConstDecl): ConstSig {
    ConstSig { name = c.name; type = c.ty; has_doc = c.has_doc; doc = c.doc.read() }
}

fn build_header(prog: checker::TProgram, table: checker::TypeTable): Header | error {
    var types: []TyExport = teko::list::empty()
    var fns: []FnSig = teko::list::empty()
    var consts: []ConstSig = teko::list::empty()
    var i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.vis == parser::Visibility::Exp {
                    var sig = match build_fnsig(f, table) {
                        FnSig as s => s
                        error as e => return e
                    }
                    fns = teko::list::push(fns, sig)
                }
            }
            parser::TypeDecl as d => {
                if d.vis == parser::Visibility::Exp {
                    var te = match build_tyexport(d, table) {
                        TyExport as t => t
                        error as e => return e
                    }
                    types = teko::list::push(types, te)
                }
            }
            parser::UseDecl => { }
            (@TStatement()) as _gb2 => { }
            checker::TConstDecl as c => {
                if c.vis == parser::Visibility::Exp {
                    consts = teko::list::push(consts, build_constsig(c))
                }
            }
        }
        i++
    }
    Header { types = types; fns = fns; consts = consts }
}

fn emit_program(prog: checker::TProgram, table: checker::TypeTable): []byte | error {
    var header = match build_header(prog, table) {
        Header as h => h
        error as e => return e
    }
    emit_tkh(header)
}
