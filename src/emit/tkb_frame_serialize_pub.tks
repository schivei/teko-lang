/**
 * Wire format version of a single-TExpr `.tkb`. Bumped 1 → 2 in 0.3.1: the drop-128 family
 * removal (R2) deleted `PrimKind::{u64,i64,f32}` and RENUMBERED the surviving `PrimKind`
 * ordinals on the wire, so a pre-0.3.1 artifact would deserialize into the WRONG types if the
 * reader accepted it. Owner ruling 2026-07-24: an old `.tkb` must FAIL LOUD against the new
 * compiler (M.3) — rebuild the artifact; no retroactive support for pre-STS/LTS formats.
 * @since 0.3.1 (drop-128 R2)
 */
pub const TKB_EXPR_VERSION: u32 = 2

/**
 * Wire format version of a whole-program `.tkb` (C7.16). Bumped 3 → 4 in 0.3.1 for the same
 * `PrimKind` ordinal renumbering as `TKB_EXPR_VERSION` — see its rationale.
 * @since 0.3.1 (drop-128 R2)
 */
pub const TKB_PROGRAM_VERSION: u32 = 4
