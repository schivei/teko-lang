
use teko::checker
use teko::parser
use teko::lexer

fn i64ty(): @Type() { checker::Prim { kind = checker::PrimKind::I64 } }
fn nt(name: str): @TypeExpr() { parser::NamedType { path = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) }; args = teko::list::empty() } }
fn tnum(v: i64): checker::TExpr { checker::TExpr { kind = checker::TNumber { is_float = false; value = parser::numint_of_i64(v); fval = 0.0 }; type = i64ty(); line = 0; col = 0 } }
fn drop_last(b: []byte): []byte {
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop { if i + 1 >= b.len { break }; out = teko::list::push(out, b[i]); i = i + 1 }
    out
}

fn ty_prim(): @Type() { checker::Prim { kind = checker::PrimKind::I64 } }
fn match_prim_arm(ty: @Type()): str {
    match ty { checker::Prim => "prim"; _ => "other" }
}

#test
fn descent_multifield_sibling_no_descend() {
    var f: @Type() = checker::Func { params = teko::list::empty(); ret = ty_prim(); variadic = false; param_names = teko::list::empty(); n_required = 0; defaults = teko::list::empty(); ret_extra = teko::list::empty() }
    teko::assert::is_true(match_prim_arm(f) == "other")
}

fn tnum_roundtrip(v: i64): bool {
    var bytes = write_texpr(teko::list::empty(), st_empty(), tnum(v))
    var decoded = match read_texpr(Reader { data = bytes; pos = 0 }, teko::list::empty()) { RTExpr as x => x; error => return false }
    var n = match decoded.value.kind { checker::TNumber as nn => nn; _ => return false }
    parser::numint_to_i64(n.value) == v
}

#test
fn tnb_number_roundtrip() {
    teko::assert::is_true(tnum_roundtrip(0))
    teko::assert::is_true(tnum_roundtrip(1))
    teko::assert::is_true(tnum_roundtrip(42))
    teko::assert::is_true(tnum_roundtrip(-1))
    teko::assert::is_true(tnum_roundtrip(-42))
    teko::assert::is_true(tnum_roundtrip(9223372036854775807))
    teko::assert::is_true(tnum_roundtrip(-9223372036854775807 - 1))
}

fn bytes_equal(a: []byte, b: []byte): bool {
    if a.len != b.len { return false }
    var i: u64 = 0
    loop {
        if i >= a.len { break }
        if a[i] != b[i] { return false }
        i++
    }
    true
}

fn tkh_of_version(ver: byte): []byte {
    var sig = FnSig { name = "f"; params = teko::list::empty(); ret = i64ty(); has_doc = false; doc = "" }
    var h = Header { types = teko::list::empty(); fns = teko::list::push(teko::list::empty(), sig) }
    var bytes = emit_tkh(h)
    var out: []byte = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= bytes.len { break }
        if i == 4 { out = teko::list::push(out, ver) } else { out = teko::list::push(out, bytes[i]) }
        i++
    }
    out
}

#test
fn tkh_current_version_roundtrips() {
    var h = match read_tkh(tkh_of_version(2 to byte)) { Header as x => x; error => return teko::assert::is_true(false) }
    teko::assert::is_true(h.fns.len == 1)
}

#test
fn tkh_version_1_is_rejected() {
    var msg = match read_tkh(tkh_of_version(1 to byte)) { Header => ""; error as e => e.message }
    teko::assert::str_contains(msg, "unsupported .tkh version")
    teko::assert::str_contains(msg, "must be rebuilt with the current compiler")
}

fn trait_body_roundtrips_implements(): bool {
    var f = parser::Field { name = "x"; type_ann = nt("i64"); vis = parser::Visibility::Pub; is_intern = false; has_doc = false; doc = ""; is_readonly = false }
    var impls = teko::list::push(teko::list::push(teko::list::empty(), "A"), "B")
    var tb: @TypeBody() = parser::TraitBody { fields = teko::list::push(teko::list::empty(), f); methods = teko::list::empty(); consts = teko::list::empty(); implements = impls }
    var st = collect_typebody(st_empty(), tb)
    var bytes = write_typebody(teko::list::empty(), st, tb)
    var decoded = match read_typebody(Reader { data = bytes; pos = 0 }, st.strings) { RTypeBody as x => x.value; error => return false }
    match decoded {
        parser::TraitBody as d => d.fields.len == 1 && d.fields[0].name == "x" && d.implements.len == 2 && d.implements[0] == "A" && d.implements[1] == "B"
        _ => false
    }
}

#test
fn tkb_traitbody_implements_roundtrip() {
    teko::assert::is_true(trait_body_roundtrips_implements())
}
