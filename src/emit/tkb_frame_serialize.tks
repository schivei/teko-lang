// src/emit/tkb_frame_serialize.tks  (namespace 'teko::emit')
//
// the `.tkb` frame: wire-version constants + header (magic + version + hash) + body — the two
// public entry points `serialize` / `serialize_program`. Pure line-count split of
// tkb_frame.tks; no behavior change.

use teko::checker

/**
 * Wire format version of a single-TExpr `.tkb`. Bumped 1 → 2 in 0.3.1: the drop-128 family
 * removal (R2) deleted `PrimKind::{u64,i64,f32}` and RENUMBERED the surviving `PrimKind`
 * ordinals on the wire, so a pre-0.3.1 artifact would deserialize into the WRONG types if the
 * reader accepted it. Owner ruling 2026-07-24: an old `.tkb` must FAIL LOUD against the new
 * compiler (M.3) — rebuild the artifact; no retroactive support for pre-STS/LTS formats.
 * @since 0.3.1 (drop-128 R2)
 */
pub const TKB_EXPR_VERSION: u32 = 2

/**
 * Wire format version of a whole-program `.tkb` (C7.16). Bumped 3 → 4 in 0.3.1 for the same
 * `PrimKind` ordinal renumbering as `TKB_EXPR_VERSION` — see its rationale.
 * @since 0.3.1 (drop-128 R2)
 */
pub const TKB_PROGRAM_VERSION: u32 = 4

fn serialize(te: checker::TExpr) -> []byte {
    let table = collect_strings(st_empty(), te)
    let body = write_texpr(write_strtable(teko::list::empty(), table), table, te)
    let h = fnv1a(body, 0)
    mut out: []byte = teko::list::empty()
    out = write_u8(out, b'T')
    out = write_u8(out, b'K')
    out = write_u8(out, b'B')
    out = write_u8(out, 0)
    out = write_u32(out, TKB_EXPR_VERSION)
    out = write_u64(out, h)   // FNV-1a of the body
    append_bytes(out, body)
}

/** (C7.16) serialize a whole typed PROGRAM. Same frame, VERSION 3 (program tree) so the reader
    can't confuse it with a version-1 single-expr `.tkb` nor an older v2 that lacked call_ns /
    type_params / type_constraints / method fidelity (#165). The KEYSTONE for `.tkl` packaging. */
fn serialize_program(prog: checker::TProgram) -> []byte {
    let table = collect_program(st_empty(), prog)
    let body = write_program(write_strtable(teko::list::empty(), table), table, prog)
    let h = fnv1a(body, 0)
    mut out: []byte = teko::list::empty()
    out = write_u8(out, b'T')
    out = write_u8(out, b'K')
    out = write_u8(out, b'B')
    out = write_u8(out, 0)
    out = write_u32(out, TKB_PROGRAM_VERSION)
    out = write_u64(out, h)
    append_bytes(out, body)
}
