/**
 * teko::journal::scratch — the per-test scratch path composer, split out of journal.tks
 * (mechanical file-size split; no logic changes).
 *
 * @since 0.3.1
 */


/**
 * writer_dir — the per-writer sub-directory a scope token names under the run root: the token with
 * its leading `.` removed (`.s0-label` becomes `s0-label`), so the run root holds one directory per
 * test identity rather than a flat pile of sibling files.
 *
 * @param scope  the running test's scope token (`.s<shard>-<label>`), never ""
 * @return       the sub-directory name
 * @since 0.3.1
 */
fn writer_dir(scope: str) -> str {
    if scope.len > 0 && scope[0] == b'.' { return teko::str::slice_from(scope, 1) }
    scope
}

/**
 * dir_of — the directory part of `path` (everything before its last `/`), or "" when it names no
 * directory. Used to create a scratch file's parents without creating the file itself.
 *
 * @param path  a composed path
 * @return      the parent directory, or ""
 * @since 0.3.1
 */
fn dir_of(path: str) -> str {
    mut i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_to(path, i) }
    }
    ""
}
