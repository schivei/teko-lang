
/**
 * note_test_begin — called by the emitted test harness right before a `#test` body runs
 * (`codegen.tks::emit_test_channel_open`).
 *
 * @param label  the test's `namespace::name` (or bare `name`)
 * @since 0.3.1
 */
pub fn note_test_begin(label: str) { note_open_append_close(test_writer(), KIND_BEGIN, label) }

/**
 * note_test_ok — called by the emitted test harness when a `#test` returned normally
 * (`codegen.tks::emit_test_captured_call`).
 *
 * @param label  the test's `namespace::name`
 * @since 0.3.1
 */
pub fn note_test_ok(label: str) { note_open_append_close(test_writer(), KIND_OK, label) }

/**
 * note_test_panicked — called by the emitted test harness when a `#test` panicked (an explicit
 * `panic`, a failed assertion, or an implicit panic).
 *
 * @param label  the test's `namespace::name`
 * @since 0.3.1
 */
pub fn note_test_panicked(label: str) {
    note_open_append_close(test_writer(), KIND_FAIL, fail_payload(label, "panicked"))
}

/**
 * note_test_exited — called by the emitted test harness when a `#test` called `exit(code)`.
 *
 * @param label  the test's `namespace::name`
 * @param code   the value the test exited with
 * @since 0.3.1
 */
pub fn note_test_exited(label: str, code: i32) {
    note_open_append_close(test_writer(), KIND_FAIL, fail_payload(label, exited_reason(code)))
}

/**
 * note_test_end — called ONCE by the emitted test harness, after every `#test` has run
 * (`codegen.tks::emit_test_main_close`): closes this shard's segment cleanly, so `fold` never
 * synthesises `incomplete` for a shard that finished — only for one that died mid-suite.
 *
 * @since 0.3.1
 */
pub fn note_test_end() { note_open_append_close(test_writer(), KIND_END, "") }

/**
 * note_row_begin — a regression row is about to run.
 *
 * @param label  the row's identity (`<file>.tkr[<scenario> row <n>]`)
 * @since 0.3.1
 */
pub fn note_row_begin(label: str) { note_open_append_close(ROW_WRITER, KIND_BEGIN, label) }

/**
 * note_row_ok — a regression row passed.
 *
 * @param label  the row's identity
 * @since 0.3.1
 */
pub fn note_row_ok(label: str) { note_open_append_close(ROW_WRITER, KIND_OK, label) }

/**
 * note_row_fail — a regression row failed.
 *
 * @param label   the row's identity
 * @param reason  why it failed, single-line
 * @since 0.3.1
 */
pub fn note_row_fail(label: str, reason: str) {
    note_open_append_close(ROW_WRITER, KIND_FAIL, fail_payload(label, reason))
}

/**
 * note_row_skip — a regression row was skipped (a missing tool, `REGRESSION_REQUIRE_TOOLS`'s
 * fail-open reading).
 *
 * @param label   the row's identity
 * @param reason  why it was skipped, single-line
 * @since 0.3.1
 */
pub fn note_row_skip(label: str, reason: str) {
    note_open_append_close(ROW_WRITER, KIND_SKIP, fail_payload(label, reason))
}

/**
 * note_row_end — called ONCE by the regression driver after every row has run: closes the `r0`
 * segment cleanly, mirroring `note_test_end`'s reason exactly (`fold` must not call a finished
 * regression tier `incomplete`).
 *
 * @since 0.3.1
 */
pub fn note_row_end() { note_open_append_close(ROW_WRITER, KIND_END, "") }
