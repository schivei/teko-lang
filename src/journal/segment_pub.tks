
/**
 * open — open the segment of `writer` in THIS run (§2.2), creating and locking the run root first.
 *
 * @param writer  the writer identity; two live writers never repeat it (`s<i>`/`p<i>`/`m`)
 * @return        the opened segment
 * @throws        when the segment could not be created (permission, disk full), or when this run's id
 *                was just minted and collides with a live root (§11.3's ferrolho)
 * @since 0.3.1
 */
pub fn open(writer: str) -> Journal | error {
    let run = run_id()
    let root = match ensure_root() { str as r => r; error as e => return e }
    open_seg(seg_path(root, writer), run, writer)
}

/**
 * append — append ONE record to `j`'s segment.
 *
 * THE DURABILITY POINT IS THIS, and it is named: a single `write(2)` on a descriptor opened in
 * O_APPEND, with no user-space buffer. The record is in the kernel when `append` returns, so a
 * `SIGKILL` of the process does not lose it — only a crash of the machine would, and that boundary
 * is §5.
 *
 * @param j        the segment to append to
 * @param kind     the record's kind
 * @param payload  the body, without newlines
 * @return         nothing on success, or the write failure
 * @throws         when the write fails (ENOSPC, EIO) — the failure is PEGAJOSA in the caller (§4)
 * @since 0.3.1
 */
pub fn append(j: Journal, kind: str, payload: str) -> null | error {
    let rec = teko::str::concat(record_line(j.run, j.writer, kind, payload), "\n")
    if append_seg_rt(rec, j.seg) != 0 {
        return error { message = teko::str::concat("teko::journal::append: write failed on writer ", j.writer) }
    }
    null
}

/**
 * note — record a `stop <sig>` note NOW to the segment `open` armed, through the SAME async-signal-safe
 * writer the polite-signal handler (`tk_rt_stop_handler`, §6) runs when a signal ends the run: it
 * prepends the armed `run\twriter\tstop\t` head, appends `sig`, and terminates the line. A program that
 * wants to mark a deliberate stop calls it; the J5 guard calls it to assert the record a polite signal
 * PRODUCES without delivering a real terminating signal, which by the re-raise contract of §6 would end
 * the process before it could read the note back. The signal delivery that CALLS this writer is proven
 * by the handler's own body.
 *
 * @param sig  the signal number the note records
 * @since 0.3.1
 */
pub fn note(sig: i32) { note_write_rt(sig) }

/**
 * rename — publish `from` as `to` atomically within one directory, so no reader sees a half-written
 * file: what is a whole artefact writes to the writer's own temporary and lands here (§2.3).
 *
 * @param from  the existing (complete) file
 * @param to    the path to publish it as, replacing any file already there
 * @return      nothing on success, or the failure
 * @throws      when the rename failed (cross-device, permission)
 * @since 0.3.1
 */
pub fn rename(from: str, to: str) -> null | error {
    if rename_rt(from, to) != 0 {
        return error { message = teko::str::concat("teko::journal::rename: could not publish ", from) }
    }
    null
}

/**
 * append_raw — append `line` + a newline to `path` VERBATIM: no run stamp, no writer field, no
 * kind. The RAW half of the durability point (§2.3's single `write(2)` on an O_APPEND descriptor),
 * for a caller whose channel is not a journal SEGMENT at all — `teko::process::verdict_emit`'s third
 * channel writes whatever line ITS OWN caller composed, unstructured, and must keep doing so; this
 * is what lets it reuse the one durable-append mechanism this module already owns without adopting
 * the four-field record shape `append` imposes.
 *
 * @param path  the file to append to (created if absent)
 * @param line  the line to append, WITHOUT its own trailing newline (one is added)
 * @return      nothing on success, or the failure to open or write
 * @since 0.3.1
 */
pub fn append_raw(path: str, line: str) -> null | error {
    let fd = open_seg_rt(path)
    if fd == BAD_DESCRIPTOR {
        return error { message = teko::str::concat("teko::journal::append_raw: could not open ", path) }
    }
    let rc = append_seg_rt(teko::str::concat(line, "\n"), fd)
    _ = close_fd_rt(fd)
    if rc != 0 {
        return error { message = teko::str::concat("teko::journal::append_raw: write failed on ", path) }
    }
    null
}
