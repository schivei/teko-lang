/**
 * teko::journal::types — the Journal and Record type declarations split out of journal.tks
 * (mechanical file-size split; no logic changes).
 *
 * @since 0.3.1
 */

/**
 * Journal — the append-only segment ONE writer owns and no more.
 *
 * @since 0.3.1
 */
pub type Journal = struct {
    /** the identifier of the run this segment belongs to (`run_id`), stamped into every record. */
    run: str
    /** the writer's identity — `s<i>` for a gate shard, `p<i>` for a pool child, `m` for the orchestrator. */
    writer: str
    /**
     * the open sink: a raw descriptor today, a per-lane slab index when lanes arrive.
     *
     * AN `i64` AND NOT THE DESIGN'S `u64`: the descriptor is what `open_seg_rt` answers, and it
     * answers `-1` on failure — a signed field takes that value with no cast, and this project's cast
     * law admits no `i64`-from-`u64` narrowing to launder it.
     */
    seg: i64
}

/**
 * Record — a record read back by the summariser.
 *
 * @since 0.3.1
 */
pub type Record = struct {
    /** the run that wrote it; a record of another run is DISCARDED by `fold`. */
    run: str
    /** who wrote it. */
    writer: str
    /** the record's kind (`begin`, `ok`, `fail`, `cov`, `end`, `stop`, `crash`, `incomplete`). */
    kind: str
    /** the record body, without newlines (the emitter keeps them out). */
    payload: str
}

