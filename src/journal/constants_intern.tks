/**
 * teko::journal::constants — module-level constants split out of journal.tks (mechanical
 * file-size split; no logic changes).
 *
 * @since 0.3.1
 */

/**
 * BAD_DESCRIPTOR — what `open_seg_rt` answers when the segment could not be created.
 */
const BAD_DESCRIPTOR: i64 = -1

/**
 * FIELD_SEP — the byte that separates a record's fields on disk. A tab, because it never appears in
 * a run id, a writer id, or a `kind`, and a payload carrying one would be the emitter's bug to keep
 * out (payloads are single-line by contract).
 */
const FIELD_SEP: str = "\t"

/**
 * LOCK_NAME — the basename of a run root's lock file, which `fold` must NOT read as a segment (it
 * carries a pid, not records) and whose live-owner `sweep` spares.
 */
const LOCK_NAME: str = ".lock"
