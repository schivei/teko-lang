
/**
 * run_id_is_fresh — whether the NEXT call to `run_id` would MINT a stamp rather than read one
 * already inherited through `TEKO_RUN`.
 *
 * THIS IS THE SIGNAL `claim_root`'s ferrolho NEEDS AND `run_id` ALONE CANNOT GIVE IT: once `run_id`
 * runs it sets `TEKO_RUN`, so asking afterwards can no longer tell "I minted this" from "my parent
 * handed it to me" — the two cases must be told apart BEFORE that call, which is why this reads the
 * environment directly instead of delegating.
 *
 * @return  true iff no `TEKO_RUN` is set yet in this process's environment
 * @since 0.3.1
 */
fn run_id_is_fresh() -> bool {
    match teko::env::var(RUN_ENV) {
        str as v => v.len == 0
        error => true
    }
}

/**
 * lock_path — the lock file inside a run root, whose body is ONE pid per line — one line per writer
 * that has ever claimed this root, never overwritten (§1.1: a run root is shared on purpose by every
 * writer `TEKO_RUN` was inherited into, and each one's pid has to stay recorded for the root to read
 * as live for as long as ANY of them still is).
 *
 * @param root  a run root
 * @return      `<root>/.lock`
 * @since 0.3.1
 */
fn lock_path(root: str) -> str { teko::str::concat(root, "/", LOCK_NAME) }

/**
 * seg_path — the segment file writer `writer` owns under run root `root`.
 *
 * @param root    the run root the segment lives in
 * @param writer  the writer identity
 * @return        `<root>/<writer>`
 * @since 0.3.1
 */
fn seg_path(root: str, writer: str) -> str { teko::str::concat(root, "/", writer) }

/**
 * mkdir_p — create `dir` and every missing parent, since `teko::fs::mkdir` is a single `mkdir(2)`.
 * An already-existing level is a no-op (mkdir treats EEXIST as success).
 *
 * @param dir  the directory to create, with any parents it needs
 * @return     an `error` when a level cannot be created, else `null`
 * @since 0.3.1
 */
fn mkdir_p(dir: str) -> error | null {
    mut i: u64 = 0
    loop {
        if i >= dir.len { break }
        if dir[i] == b'/' && i > 0 {
            match teko::fs::mkdir(teko::str::slice_to(dir, i)) { error as e => return e; null => { } }
        }
        i = i + 1
    }
    teko::fs::mkdir(dir)
}

/**
 * claim_root — create `root` (if absent) and record this process among its lock's writers, refusing
 * when `fresh` names a real conflict (§11.3's ferrolho).
 *
 * A FRESH ID COLLIDING WITH A LIVE ROOT IS THE ONE CASE THIS REFUSES. `fresh` is true exactly when
 * THIS call's `run_id` was just minted rather than inherited: a minted id landing on a directory some
 * OTHER live process already holds means the naming scheme's own uniqueness assumption (timestamp +
 * pid) broke, or `TEKO_RUN` was set by hand to a value that collides — either way it is a real
 * conflict and MUST be named, never silently shared. An INHERITED id (`fresh = false`) sharing a live
 * root is not a conflict at all — it is every sibling writer `TEKO_RUN` was deliberately propagated to
 * (§1.1) — so it is never refused, no matter how many live pids the lock already names.
 *
 * @param root   the run root to claim
 * @param fresh  whether this call's run id was just minted rather than inherited via `TEKO_RUN`
 * @return       `root`, created and recording this process, or the named refusal
 * @throws       when `fresh` is true and `root` is already held by a live process
 * @since 0.3.1
 */
fn claim_root(root: str, fresh: bool) -> str | error {
    if fresh && root_is_live(root) {
        return error { message = teko::str::concat("teko::journal: run root already in use by a live process (", root, ")") }
    }
    match mkdir_p(root) { error => { }; null => { } }
    record_self_pid(root)
    root
}

/**
 * ensure_root — create THIS run's root and record this process among its lock's writers, so a
 * concurrent `sweep` from another run spares it while any of this run's writers is alive.
 *
 * @return  the run root, created and locked
 * @throws  when this run's id was just minted and collides with a live root (§11.3)
 * @since 0.3.1
 */
fn ensure_root() -> str | error {
    let fresh = run_id_is_fresh()
    claim_root(run_root(), fresh)
}
