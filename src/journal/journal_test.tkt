/**
 * tdir — a hermetic scratch directory for one fixture, under THIS run's own root so parallel gate
 * shards (each in its own process, each minting its own `run_id`) never collide, and created eagerly
 * so a segment file can be opened inside it.
 *
 * @param tag  a per-fixture label kept distinct from every other fixture's
 * @return     the created directory
 * @since 0.3.1
 */
fn tdir(tag: str) -> str {
    let dir = teko::str::concat(run_root(), "/jt_", tag)
    match mkdir_p(dir) { error => { }; null => { } }
    dir
}

/**
 * has_record — whether `recs` holds a record of exactly `kind` and `payload`, the shape every fold
 * fixture asserts on (it names the record it expects rather than a count).
 *
 * @param recs     the folded records
 * @param kind     the kind to find
 * @param payload  the payload to find
 * @return         true iff a matching record is present
 * @since 0.3.1
 */
fn has_record(recs: []Record, kind: str, payload: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= recs.len { break }
        if recs[i].kind == kind && recs[i].payload == payload { return true }
        i = i + 1
    }
    false
}

/**
 * dir_absent — whether `path` names no listable directory, the way a fixture reads "this root was
 * reclaimed" (a removed directory no longer lists; a present one lists, if only as empty).
 *
 * @param path  a directory path
 * @return      true iff `path` cannot be listed
 * @since 0.3.1
 */
fn dir_absent(path: str) -> bool {
    match teko::fs::list_dir(path) { []str => false; error => true }
}

/**
 * plant_segment — write `content` verbatim as the segment file `name` inside `dir`, the way the
 * hygiene fixtures forge a torn or foreign-run segment `fold` then has to clean.
 *
 * @param dir      the directory to write into
 * @param name     the segment file's basename
 * @param content  the exact bytes of the segment
 * @since 0.3.1
 */
fn plant_segment(dir: str, name: str, content: str) {
    match teko::io::write_file(teko::str::concat(dir, "/", name), content) { error => { }; null => { } }
}

/**
 * j_append_then_fold_returns_the_record — the append→fold round trip through the writer seam: one
 * `ok probe` written, and `fold` reads it back.
 */
#test
fn j_append_then_fold_returns_the_record() {
    let dir = tdir("append")
    let j = match open_seg(teko::str::concat(dir, "/s0"), "r1", "s0") {
        Journal as jj => jj
        error => { teko::assert::is_true(false); return }
    }
    match append(j, "ok", "probe") { error => { teko::assert::is_true(false) }; null => { } }
    teko::assert::is_true(has_record(fold(dir, "r1"), "ok", "probe"))
}

/**
 * j_a_record_of_another_run_is_discarded — hygiene rule 1 (§4): a line stamped with another run is
 * dropped by `fold`, and only this run's record survives.
 */
#test
fn j_a_record_of_another_run_is_discarded() {
    let dir = tdir("otherrun")
    let mine = teko::str::concat(record_line("r1", "s0", "ok", "mine"), "\n")
    let theirs = teko::str::concat(record_line("other", "s0", "ok", "theirs"), "\n")
    plant_segment(dir, "s0", teko::str::concat(mine, theirs))
    let recs = fold(dir, "r1")
    teko::assert::is_true(has_record(recs, "ok", "mine"))
    teko::assert::is_false(has_record(recs, "ok", "theirs"))
}

/**
 * j_a_torn_last_line_is_dropped — hygiene rule 2 (§4): a final line with no trailing newline is a
 * torn write, and `fold` keeps only the completed line before it.
 */
#test
fn j_a_torn_last_line_is_dropped() {
    let dir = tdir("torn")
    let kept = teko::str::concat(record_line("r1", "s0", "ok", "kept"), "\n")
    let torn = record_line("r1", "s0", "ok", "torn")
    plant_segment(dir, "s0", teko::str::concat(kept, torn))
    let recs = fold(dir, "r1")
    teko::assert::is_true(has_record(recs, "ok", "kept"))
    teko::assert::is_false(has_record(recs, "ok", "torn"))
}

/**
 * j_a_segment_without_end_yields_incomplete — hygiene rule 3 (§4): a segment that opened a test but
 * wrote no terminal kind is folded with a synthetic `incomplete` naming the test it died in.
 */
#test
fn j_a_segment_without_end_yields_incomplete() {
    let dir = tdir("noend")
    plant_segment(dir, "s0", teko::str::concat(record_line("r1", "s0", KIND_BEGIN, "test_x"), "\n"))
    teko::assert::is_true(has_record(fold(dir, "r1"), KIND_INCOMPLETE, "test_x"))
}

/**
 * j_a_closed_segment_is_not_synthesised_incomplete — the inversion of rule 3: a segment that DID
 * write an `end` is left alone, so the synthetic `incomplete` is not a blind default.
 */
#test
fn j_a_closed_segment_is_not_synthesised_incomplete() {
    let dir = tdir("closed")
    let begin = teko::str::concat(record_line("r1", "s0", KIND_BEGIN, "test_y"), "\n")
    let end = teko::str::concat(record_line("r1", "s0", KIND_END, ""), "\n")
    plant_segment(dir, "s0", teko::str::concat(begin, end))
    teko::assert::is_false(has_record(fold(dir, "r1"), KIND_INCOMPLETE, "test_y"))
}

/**
 * j_open_append_fold_roundtrips_the_public_api — the whole §2.2 public surface in one path:
 * `open`/`run_id`/`run_root`/`append`/`fold` agree on a record written to this run's real root.
 */
#test
fn j_open_append_fold_roundtrips_the_public_api() {
    let j = match open("m") {
        Journal as jj => jj
        error => { teko::assert::is_true(false); return }
    }
    match append(j, "ok", "public_probe") { error => { teko::assert::is_true(false) }; null => { } }
    teko::assert::is_true(has_record(fold(run_root(), run_id()), "ok", "public_probe"))
}

/**
 * j_sweep_reclaims_a_dead_root_but_spares_keep_and_live — `sweep`'s two guards, both exercised on a
 * hermetic tree: a dead root (no live lock) is reclaimed WITH its children, while the kept root and a
 * root whose lock names THIS live process are both spared.
 */
#test
fn j_sweep_reclaims_a_dead_root_but_spares_keep_and_live() {
    let base = tdir("sweep")
    let keep = teko::str::concat(base, "/keep")
    let dead = teko::str::concat(base, "/dead")
    let live = teko::str::concat(base, "/live")
    match mkdir_p(keep) { error => { }; null => { } }
    match mkdir_p(dead) { error => { }; null => { } }
    match mkdir_p(live) { error => { }; null => { } }
    plant_segment(dead, "s0", "child")
    match teko::io::write_file(lock_path(live), teko::str::i64_to_str(pid_rt())) { error => { }; null => { } }
    let removed = sweep_under(base, keep)
    teko::assert::is_true(dir_absent(dead))
    teko::assert::is_false(dir_absent(keep))
    teko::assert::is_false(dir_absent(live))
    teko::assert::eq_u64(removed, 1)
}

/**
 * j_scratch_ends_with_its_base — `scratch` keeps the caller's base as the tail of the composed path,
 * whether a test scope is active (a rooted path ending in `base`) or not (`base` unchanged).
 */
#test
fn j_scratch_ends_with_its_base() {
    teko::assert::str_ends_with(scratch("probe.txt"), "probe.txt")
}

/**
 * j5_a_polite_signal_note_is_a_folded_stop_record — the polite-signal note of §6, proven through the
 * EXACT writer the handler runs (`tk_rt_stop_handler` does nothing but `tk_journal_note(sig)` then
 * restore-default-and-re-raise). `open` arms the `stop` head, the note writer appends the signal
 * number, and `fold` reads a terminal `stop` record carrying it — so a run that a signal ended reads
 * as stopped, never as passed.
 *
 * WHY NOT AN OS SIGNAL HERE. Delivering a real SIGTERM re-raises the default and terminates the
 * process — the handler's whole point — which would kill this test shard before it could read the
 * segment. The note WRITER is exercised directly; the signal that CALLS it is proven by the handler
 * body itself.
 */
#test
fn j5_a_polite_signal_note_is_a_folded_stop_record() {
    let dir = tdir("j5note")
    match open_seg(teko::str::concat(dir, "/m"), "r1", "m") {
        Journal as j => { teko::assert::is_true(j.seg >= 0) }
        error => { teko::assert::is_true(false); return }
    }
    let sigterm: i32 = 15
    note(sigterm)
    teko::assert::is_true(has_record(fold(dir, "r1"), KIND_STOP, "15"))
}
