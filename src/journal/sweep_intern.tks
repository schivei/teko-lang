use teko::list

//
// teko::journal::sweep — lock-file bookkeeping and run-root reclamation, split out of
// journal.tks (mechanical file-size split; no logic changes).
//
// @since 0.3.1
//


/**
 * last_segment — the last `/`-separated segment of `path` (its basename), or `path` when it has none.
 *
 * @param path  a path
 * @return      its final segment
 * @since 0.3.1
 */
fn last_segment(path: str) -> str {
    mut i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_from(path, i + 1) }
    }
    path
}

/**
 * parse_pid — the decimal pid ONE lock line holds, read digit by digit. A line with no digit answers
 * 0, which `lock_pids` skips rather than recording as a real pid.
 *
 * @param line  one line of a lock file's contents, without its newline
 * @return      the pid, or 0 when the line carries none
 * @since 0.3.1
 */
fn parse_pid(line: str) -> i64 {
    mut v: i64 = 0
    mut i: u64 = 0
    mut seen: bool = false
    loop {
        if i >= line.len { break }
        let c = line[i]
        if c >= b'0' && c <= b'9' {
            v = (v * 10) + ((c to i64) - (b'0' to i64))
            seen = true
        }
        if seen && (c < b'0' || c > b'9') { break }
        i = i + 1
    }
    v
}

/**
 * lock_pids — every pid `root`'s lock file names, one per line (§1.1: a root is a shared destination
 * for every writer `TEKO_RUN` inherited it into, so its lock is a SET of pids, not one). A body with
 * no trailing newline on its last line is still read (`sweep`'s existing single-pid fixtures write
 * exactly that shape).
 *
 * @param root  a run root
 * @return      the pids its lock names, in the order they were recorded
 * @since 0.3.1
 */
fn lock_pids(root: str) -> []i64 {
    let body = match teko::io::read_file(lock_path(root)) { str as s => s; error => return teko::list::empty() }
    mut out: []i64 = teko::list::empty()
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= body.len { break }
        if body[i] == b'\n' {
            let p = parse_pid(teko::str::slice(body, start, i))
            if p > 0 { out = teko::list::push(out, p) }
            start = i + 1
        }
        i = i + 1
    }
    if start < body.len {
        let p = parse_pid(teko::str::slice_from(body, start))
        if p > 0 { out = teko::list::push(out, p) }
    }
    out
}

/**
 * root_is_live — whether the run root at `root` is still held by AT LEAST ONE live process among
 * every writer its lock ever recorded. A shared root (§1.1) stays live as long as ANY sibling writer
 * does, not only the one that happened to claim it first.
 *
 * @param root  a sibling run root
 * @return      true iff its lock names a pid that is currently alive
 * @since 0.3.1
 */
fn root_is_live(root: str) -> bool {
    let pids = lock_pids(root)
    mut i: u64 = 0
    loop {
        if i >= pids.len { break }
        if pid_alive_rt(pids[i]) { return true }
        i = i + 1
    }
    false
}

/**
 * pid_in_lock — whether `pid` is already one of the pids `root`'s lock names, so `record_self_pid`
 * appends a writer's pid AT MOST ONCE even across repeated `open` calls in the same process.
 *
 * @param root  a run root
 * @param pid   the pid to look for
 * @return      true iff `root`'s lock already names `pid`
 * @since 0.3.1
 */
fn pid_in_lock(root: str, pid: i64) -> bool {
    let pids = lock_pids(root)
    mut i: u64 = 0
    loop {
        if i >= pids.len { break }
        if pids[i] == pid { return true }
        i = i + 1
    }
    false
}

/**
 * record_self_pid — append this process's pid as one more line of `root`'s lock, unless it is there
 * already. NEVER OVERWRITES: the earlier shape (one `write_file` per claim) let the LAST writer to
 * open erase every EARLIER writer's pid, so a `sweep` running between two sibling writers' exits could
 * read a still-running root as dead the instant the writer that happened to open last was the first to
 * finish. Appending keeps every sibling's pid on record for as long as the file exists.
 *
 * @param root  the run root this process is claiming a share of
 * @since 0.3.1
 */
fn record_self_pid(root: str) {
    let pid = pid_rt()
    if pid_in_lock(root, pid) { return }
    match teko::io::append_file(lock_path(root), teko::str::concat(teko::str::i64_to_str(pid), "\n")) { error => { }; null => { } }
}

/**
 * rmtree — best-effort recursive removal of `path` and everything under it, in pure Teko over
 * `list_dir` + `remove_file` (libc `remove` rmdir's an empty directory, so children go first and the
 * now-empty directory follows). No runtime primitive is added for a walk this file can own.
 *
 * @param path  the tree root to remove
 * @return      true when the whole tree went, false when something survived
 * @since 0.3.1
 */
fn rmtree(path: str) -> bool {
    match teko::fs::list_dir(path) {
        []str as entries => {
            mut ok: bool = true
            mut i: u64 = 0
            loop {
                if i >= entries.len { break }
                if !rmtree(teko::str::concat(path, "/", entries[i])) { ok = false }
                i = i + 1
            }
            if !ok { return false }
            match teko::fs::remove_file(path) { error => false; null => true }
        }
        error => {
            match teko::fs::remove_file(path) { error => false; null => true }
        }
    }
}

/**
 * sweep_under — remove the run roots under `base` that are neither `keep` nor still locked by a live
 * process, returning how many were removed. The directory is a PARAMETER so a hermetic unit test can
 * exercise the reclaim-versus-spare logic on its own scratch tree without touching `bin/.tkrun`.
 *
 * @param base  the directory that holds the run roots
 * @param keep  the run root to preserve (this run's own)
 * @return      how many roots were removed
 * @since 0.3.1
 */
fn sweep_under(base: str, keep: str) -> u64 {
    let keep_id = last_segment(keep)
    let entries = match teko::fs::list_dir(base) { []str as e => e; error => teko::list::empty() }
    mut removed: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let name = entries[i]
        let path = teko::str::concat(base, "/", name)
        if name != keep_id && !root_is_live(path) {
            if rmtree(path) { removed = removed + 1 }
        }
        i = i + 1
    }
    removed
}
