/**
 * teko::journal tests — j_scratch/j3_/j5_ tests (scratch path + polite-signal note), split
 * out of journal_test.tkt (mechanical file-size split; no logic changes).
 *
 * @since 0.3.1
 */

/**
 * j_scratch_ends_with_its_base — `scratch` keeps the caller's base as the tail of the composed path,
 * whether a test scope is active (a rooted path ending in `base`) or not (`base` unchanged).
 */
#test
fn j_scratch_ends_with_its_base() {
    teko::assert::str_ends_with(scratch("probe.txt"), "probe.txt")
}

/**
 * j3_regr_work_dir_scopes_like_every_other_family — journal J3, family #15 (journaling-de-corrida-0.3.1
 * §3.3): `teko::build::REGR_WORK_DIR` — the root `run_regression_sources` now scopes, and the base every
 * one of families #17-20 derives from through its `prefix` chain — composes through THIS file's own
 * `scratch`, exactly like every other caller: rooted under this run and this test's own identity, still
 * ending in the same base.
 */
#test
fn j3_regr_work_dir_scopes_like_every_other_family() {
    let scoped = scratch(teko::build::REGR_WORK_DIR)
    teko::assert::str_ends_with(scoped, teko::build::REGR_WORK_DIR)
    teko::assert::str_contains(scoped, "j3_regr_work_dir_scopes_like_every_other_family")
    teko::assert::ne_str(scoped, teko::build::REGR_WORK_DIR)
}

/**
 * j5_a_polite_signal_note_is_a_folded_stop_record — the polite-signal note of §6, proven through the
 * EXACT writer the handler runs (`tk_rt_stop_handler` does nothing but `tk_journal_note(sig)` then
 * restore-default-and-re-raise). `open` arms the `stop` head, the note writer appends the signal
 * number, and `fold` reads a terminal `stop` record carrying it — so a run that a signal ended reads
 * as stopped, never as passed.
 *
 * WHY NOT AN OS SIGNAL HERE. Delivering a real SIGTERM re-raises the default and terminates the
 * process — the handler's whole point — which would kill this test shard before it could read the
 * segment. The note WRITER is exercised directly; the signal that CALLS it is proven by the handler
 * body itself.
 */
#test
fn j5_a_polite_signal_note_is_a_folded_stop_record() {
    let dir = tdir("j5note")
    match open_seg(teko::str::concat(dir, "/m"), "r1", "m") {
        Journal as j => { teko::assert::is_true(j.seg >= 0) }
        error => { teko::assert::is_true(false); return }
    }
    let sigterm: i32 = 15
    note(sigterm)
    teko::assert::is_true(has_record(fold(dir, "r1"), KIND_STOP, "15"))
}

/**
 * j4_rec — one synthetic `Record`, the literal §13.6 fixtures build from (`summarize` is pure, so no
 * segment file and no real run are needed to exercise it).
 *
 * @param run      the shared run stamp every fixture record carries
 * @param writer   the writer identity
 * @param kind     the record kind
 * @param payload  the record body
 * @return         the record
 * @since 0.3.1
 */
