/**
 * scratch — the path `base` has IN THIS RUN and for the CURRENTLY RUNNING test (§2.2).
 *
 * THIS IS THE ONE COMPOSER. "Which paths are isolated" is answered by reading this function's
 * callers, not by grepping literals — which is exactly how the fixed paths went unnoticed.
 *
 * BYTE-FOR-BYTE `base` OUTSIDE A TEST, and that is the point rather than a fallback: the same
 * path-composing code runs in PRODUCTION (the regression runner), and there the path must stay what
 * it was. Rooting applies exactly where the concurrency it guards against exists — inside the test
 * gate, where `teko::test::scope()` is non-empty.
 *
 * @param base  the path a caller would otherwise hard-code
 * @return      `<run_root()>/<writer>/<base>` inside a test (parents created), `base` outside one
 * @since 0.3.1
 */
pub fn scratch(base: str) -> str {
    let scope = teko::test::scope()
    if scope.len == 0 { return base }
    let composed = teko::str::concat(run_root(), "/", writer_dir(scope), "/", base)
    let parent = dir_of(composed)
    if parent.len > 0 { match mkdir_p(parent) { error => { }; null => { } } }
    composed
}
