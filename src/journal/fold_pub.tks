
/**
 * fold — re-read EVERY segment of `run` under `root` and return the records in segment order.
 *
 * THREE HYGIENE RULES, one per named failure mode of §4: a record of another run is discarded
 * (`parse_record`, rule 1); a torn last line is dropped (`fold_segment`, rule 2); a segment with no
 * terminal kind yields a synthetic `incomplete` naming its writer (`fold_segment`, rule 3). A pure
 * query over bytes already on disk, so a replay yields the same records after the orchestrator was
 * killed.
 *
 * @param root  the run root (`run_root()`, or an old root on a replay)
 * @param run   the stamp a record must carry to count
 * @return      the records, ordered by segment name then by write order
 * @since 0.3.1
 */
pub fn fold(root: str, run: str) -> []Record {
    let entries = match teko::fs::list_dir(root) { []str as e => e; error => teko::list::empty() }
    let names = sort_names(entries)
    mut out: []Record = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        out = fold_segment(out, root, names[i], run)
        i = i + 1
    }
    out
}
