use teko::list

//
// teko::journal::fold — re-reading a run's segments back into records, split out of
// journal.tks (mechanical file-size split; no logic changes).
//
// @since 0.3.1
//


/**
 * is_terminal_kind — whether `kind` closes a segment, so `fold` need not synthesise an `incomplete`
 * for it: a clean `end`, a signalled `stop`, or an already-synthesised `incomplete`.
 *
 * @param kind  a record's kind
 * @return      true iff the kind marks the segment as closed
 * @since 0.3.1
 */
fn is_terminal_kind(kind: str) -> bool {
    if kind == KIND_END { return true }
    if kind == KIND_STOP { return true }
    kind == KIND_INCOMPLETE
}

/**
 * parse_record — decode ONE journal line into a `Record`, or `null` when it belongs to another run
 * or is malformed (fewer than the three `FIELD_SEP` bytes a record carries before its payload).
 *
 * THE RUN FILTER IS HYGIENE RULE 1 (§4). A line whose first field is not `want_run` is a previous
 * run's garbage under a shared directory, and it is DISCARDED here rather than counted.
 *
 * @param want_run  the run stamp a record must carry to count
 * @param line      one journal line, WITHOUT its trailing newline
 * @return          the decoded record, or `null` when it is another run's or malformed
 * @since 0.3.1
 */
fn parse_record(want_run: str, line: str) -> Record | null {
    mut i: u64 = 0
    mut t1: u64 = 0
    mut t2: u64 = 0
    mut t3: u64 = 0
    mut n: u64 = 0
    loop {
        if i >= line.len { break }
        if line[i] == b'\t' {
            n = n + 1
            if n == 1 { t1 = i }
            if n == 2 { t2 = i }
            if n == 3 { t3 = i; break }
        }
        i = i + 1
    }
    if n < 3 { return null }
    let run = teko::str::slice_to(line, t1)
    if run != want_run { return null }
    Record {
        run = run
        writer = teko::str::slice(line, t1 + 1, t2)
        kind = teko::str::slice(line, t2 + 1, t3)
        payload = teko::str::slice_from(line, t3 + 1)
    }
}

/**
 * is_dir — whether `path` names a listable directory. Used to keep `fold_segment` from reading a
 * run root's writer/scratch SUB-directory as if it were a segment file: a run root holds both segment
 * files AND the per-writer scratch trees, and `read_file` on a directory sizes to a garbage-large
 * value that would allocate until OOM. No stat primitive is surfaced, so the listability of a path
 * is the available directory test.
 *
 * @param path  a path under a run root
 * @return      true iff `path` is a directory
 * @since 0.3.1
 */
fn is_dir(path: str) -> bool {
    match teko::fs::list_dir(path) { []str => true; error => false }
}

/**
 * fold_segment — read ONE segment file and append its records (of `run`) to `acc`, applying the two
 * per-segment hygiene rules of §4: a line without a trailing newline is a torn write and is dropped
 * (rule 2, satisfied by only emitting a line at each `\n`); a segment carrying no terminal kind gets
 * a synthetic `incomplete` naming its writer and the test it died in (rule 3). A directory entry (a
 * writer's scratch tree, sibling to the segments) is not a segment and is skipped.
 *
 * @param acc   the records folded so far
 * @param root  the run root the segment lives under
 * @param name  the segment file's basename
 * @param run   the run stamp a record must carry to count
 * @return      `acc` with this segment's records (and any synthetic `incomplete`) appended
 * @since 0.3.1
 */
fn fold_segment(acc: []Record, root: str, name: str, run: str) -> []Record {
    if name == LOCK_NAME { return acc }
    let path = teko::str::concat(root, "/", name)
    if is_dir(path) { return acc }
    let content = match teko::io::read_file(path) { str as s => s; error => return acc }
    mut out: []Record = acc
    mut writer: str = ""
    mut last_begin: str = ""
    mut saw_terminal: bool = false
    mut saw_any: bool = false
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= content.len { break }
        if content[i] == b'\n' {
            match parse_record(run, teko::str::slice(content, start, i)) {
                Record as r => {
                    out = teko::list::push(out, r)
                    writer = r.writer
                    saw_any = true
                    if r.kind == KIND_BEGIN { last_begin = r.payload }
                    if is_terminal_kind(r.kind) { saw_terminal = true }
                }
                null => { }
            }
            start = i + 1
        }
        i = i + 1
    }
    if saw_any && !saw_terminal {
        out = teko::list::push(out, Record { run = run; writer = writer; kind = KIND_INCOMPLETE; payload = last_begin })
    }
    out
}

/**
 * str_less — whether `a` sorts before `b` byte-lexicographically, so `fold` returns segments in a
 * stable name order (the corpus surfaces no `str` comparator under a `teko::str::` name here).
 *
 * @param a  the left string
 * @param b  the right string
 * @return   true iff `a` is strictly less than `b`
 * @since 0.3.1
 */
fn str_less(a: str, b: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= a.len { return b.len > a.len }
        if i >= b.len { return false }
        if a[i] < b[i] { return true }
        if a[i] > b[i] { return false }
        i = i + 1
    }
}

/**
 * remove_at — a copy of `xs` without the element at `idx`, the shrink `sort_names`'s selection pass
 * needs (a `[]str` is push-only, value-semantics).
 *
 * @param xs   the list to copy
 * @param idx  the index to drop
 * @return     `xs` without element `idx`
 * @since 0.3.1
 */
fn remove_at(xs: []str, idx: u64) -> []str {
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != idx { out = teko::list::push(out, xs[i]) }
        i = i + 1
    }
    out
}

/**
 * sort_names — `names` in ascending byte order, by selection. Directory listings arrive in no
 * guaranteed order, and `fold`'s `@return` promises segment-name order.
 *
 * @param names  the directory entries to sort
 * @return       the same entries, ascending
 * @since 0.3.1
 */
fn sort_names(names: []str) -> []str {
    mut remaining: []str = names
    mut ordered: []str = teko::list::empty()
    loop {
        if remaining.len == 0 { break }
        mut min_idx: u64 = 0
        mut j: u64 = 1
        loop {
            if j >= remaining.len { break }
            if str_less(remaining[j], remaining[min_idx]) { min_idx = j }
            j = j + 1
        }
        ordered = teko::list::push(ordered, remaining[min_idx])
        remaining = remove_at(remaining, min_idx)
    }
    ordered
}
