//
// teko::journal::extern — the runtime symbol bindings journal.tks used to declare inline,
// split out verbatim (mechanical file-size split; no logic changes).
//
// @since 0.3.1
//

/**
 * open_seg_rt — the runtime symbol `tk_journal_open` wraps: open/create `path` in O_WRONLY|O_APPEND|
 * O_CREAT and return the RAW descriptor. Kept private so every caller goes through the typed `open`.
 *
 * A SCALAR RETURN AND NOT `Journal | error`, which the whole runtime surface records
 * (`teko::io::append_file_raw`): a brand-new `error`-shaped `extern fn` needs a per-name lift the
 * released bootstrap seed's frozen codegen cannot learn, and a `from "teko_rt"` extern cannot return
 * a user struct by value at all. The Teko wrapper builds the `Journal` and the `error`.
 *
 * @param path  the segment file to open, created when absent
 * @return      the raw descriptor (>= 0), or -1 on a failure to open
 * @since 0.3.1
 */
extern fn open_seg_rt(path: str) -> i64 = "tk_journal_open" from "teko_rt"

/**
 * append_seg_rt — the runtime symbol `tk_journal_append` wraps: write `rec` whole to descriptor
 * `seg`, finishing a short write in a loop. Kept private so every caller goes through `append`.
 *
 * `rec` LEADS `seg`, and that order is deliberate: a by-value `str` is only ABI-describable when it
 * is a leading parameter (see `lir/lower.tks::takes_one_str_by_value`), so putting the record first
 * keeps the call correct on every target rather than only on the ones where a fat pair happens to
 * decompose into the same registers.
 *
 * @param rec  the record bytes, already terminated by a newline
 * @param seg  the raw descriptor a segment was opened on
 * @return     0 on success, or the errno the write failed with
 * @since 0.3.1
 */
extern fn append_seg_rt(rec: str, seg: i64) -> i32 = "tk_journal_append" from "teko_rt"

/**
 * arm_note_rt — the runtime symbol `tk_journal_arm` wraps: remember `prefix` (a pre-shaped
 * `run\twriter\tstop\t` record head) as the bytes a later async-signal-safe `tk_journal_note`
 * prepends before the signal number. Kept private so `open` is the one arm point.
 *
 * @param prefix  the stop-record head, formatted here at open time (never inside a handler)
 * @since 0.3.1
 */
extern fn arm_note_rt(prefix: str) -> void = "tk_journal_arm" from "teko_rt"

/**
 * rename_rt — the runtime symbol `tk_rt_rename` wraps: rename `from` to `to` atomically within one
 * directory. Kept private so every caller goes through `rename`.
 *
 * @param from  the existing (complete) file
 * @param to    the path to publish it as, replacing any file already there
 * @return      0 on success, or the errno
 * @since 0.3.1
 */
extern fn rename_rt(from: str, to: str) -> i32 = "tk_rt_rename" from "teko_rt"

/**
 * mono_ns_rt — the runtime symbol `tk_rt_monotonic_ns` wraps: monotonic nanoseconds, the time half
 * of a run stamp. Binds an EXISTING runtime symbol (no new C); kept private so `run_id` is the one
 * composer of the stamp.
 *
 * @return  a monotonically non-decreasing nanosecond reading
 * @since 0.3.1
 */
extern fn mono_ns_rt() -> i64 = "tk_rt_monotonic_ns" from "teko_rt"

/**
 * pid_rt — the runtime symbol `tk_rt_pid` wraps: this process's id, the disambiguating half of a run
 * stamp. Kept private so `run_id` is the one composer of the stamp.
 *
 * @return  this process's id
 * @since 0.3.1
 */
extern fn pid_rt() -> i64 = "tk_rt_pid" from "teko_rt"

/**
 * pid_alive_rt — the runtime symbol `tk_rt_pid_alive` wraps: whether `pid` is a live process. Kept
 * private so `sweep` is the one caller of the liveness test.
 *
 * @param pid  the process id a root's lock recorded
 * @return     true iff a process with that id is currently alive
 * @since 0.3.1
 */
extern fn pid_alive_rt(pid: i64) -> bool = "tk_rt_pid_alive" from "teko_rt"

/**
 * note_write_rt — the runtime symbol `tk_journal_note` wraps: the SAME async-signal-safe writer the
 * polite-signal handler (`tk_rt_stop_handler`, §6) runs — it appends the armed `run\twriter\tstop\t`
 * head, the signal number, and a newline to the segment `open` stashed. Kept private so `note` is the
 * one caller.
 *
 * @param sig  the signal number the note records
 * @since 0.3.1
 */
extern fn note_write_rt(sig: i32) -> void = "tk_journal_note" from "teko_rt"


/**
 * close_fd_rt — the runtime symbol `tk_rt_close_fd` wraps (already bound once for
 * `teko::process`'s own pipes, `close_fd_raw`; rebinding the same existing symbol here needs no new
 * C). Kept private so every hook below goes through it the same way.
 *
 * ===== WIRING STARTS HERE (owner order, 0.3.1) ===== Everything ABOVE this point is the library —
 * correct, unit-tested, and (until this section) never called by anything but its own tests. What
 * follows are the CALL SITES: `codegen.tks`'s emitted per-`#test` C hooks (`note_test_begin`/
 * `note_test_ok`/`note_test_panicked`/`note_test_exited`, writer `s<shard>`) and the regression
 * runner's per-row hooks (`note_row_begin`/`_ok`/`_fail`/`_skip`, writer `r0` — the regression tier
 * is not itself sharded into multiple journal writers today, so one writer covers the whole tier;
 * `run_pool`'s OWN process-per-row parallelism is orthogonal and unaffected).
 *
 * EACH HOOK OPENS ITS OWN SEGMENT FD, APPENDS ONE RECORD, AND CLOSES IT — never a cached handle
 * across calls. Teko carries no top-level mutable state (grep this whole corpus for a top-level
 * `mut`: there is none), so the one "open once, reuse across many call sites" resource every OTHER
 * per-test facility in this corpus relies on (the capture channel `tk_test_begin` opens, the
 * per-task coverage sinks) lives in the C runtime's per-task fields — exactly the door this wiring
 * may not walk through (`teko_rt.c` is the frozen twin here). Opening and closing per call is the
 * honest cost of doing this in pure Teko instead: THIS function already exists for another caller's
 * pipes (`teko::process::close_fd_raw`), so binding it again here adds no new C, and it is what
 * keeps a 1000-plus-test suite from leaking a file descriptor per test.
 *
 * BEST-EFFORT, ON PURPOSE. §4's "pegajosa" failure (a journal that cannot be written fails the
 * PROCESS) is the right law for `journal::append`'s OWN unit tests, which exist to exercise that
 * exact contract. It is the wrong law for a hook riding along every `#test` and every regression row
 * in every Teko program: a full disk must not turn "the suite failed" into "the suite could not even
 * observe itself," so every hook below swallows a `journal::open`/`append` failure in silence and
 * lets the test/row run exactly as it would have before this wiring existed.
 *
 * @param fd  the descriptor a hook's own `open_seg_rt` opened
 * @return    0 on success, or the errno
 * @since 0.3.1
 */
extern fn close_fd_rt(fd: i64) -> i32 = "tk_rt_close_fd" from "teko_rt"
