/**
 * teko::journal::scratch — the per-test scratch path composer, split out of journal.tks
 * (mechanical file-size split; no logic changes).
 *
 * @since 0.3.1
 */


/**
 * writer_dir — the per-writer sub-directory a scope token names under the run root: the token with
 * its leading `.` removed (`.s0-label` becomes `s0-label`), so the run root holds one directory per
 * test identity rather than a flat pile of sibling files.
 *
 * @param scope  the running test's scope token (`.s<shard>-<label>`), never ""
 * @return       the sub-directory name
 * @since 0.3.1
 */
fn writer_dir(scope: str) -> str {
    if scope.len > 0 && scope[0] == b'.' { return teko::str::slice_from(scope, 1) }
    scope
}

/**
 * dir_of — the directory part of `path` (everything before its last `/`), or "" when it names no
 * directory. Used to create a scratch file's parents without creating the file itself.
 *
 * @param path  a composed path
 * @return      the parent directory, or ""
 * @since 0.3.1
 */
fn dir_of(path: str) -> str {
    mut i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_to(path, i) }
    }
    ""
}

/**
 * scratch — the path `base` has IN THIS RUN and for the CURRENTLY RUNNING test (§2.2).
 *
 * THIS IS THE ONE COMPOSER. "Which paths are isolated" is answered by reading this function's
 * callers, not by grepping literals — which is exactly how the fixed paths went unnoticed.
 *
 * BYTE-FOR-BYTE `base` OUTSIDE A TEST, and that is the point rather than a fallback: the same
 * path-composing code runs in PRODUCTION (the regression runner), and there the path must stay what
 * it was. Rooting applies exactly where the concurrency it guards against exists — inside the test
 * gate, where `teko::test::scope()` is non-empty.
 *
 * @param base  the path a caller would otherwise hard-code
 * @return      `<run_root()>/<writer>/<base>` inside a test (parents created), `base` outside one
 * @since 0.3.1
 */
pub fn scratch(base: str) -> str {
    let scope = teko::test::scope()
    if scope.len == 0 { return base }
    let composed = teko::str::concat(run_root(), "/", writer_dir(scope), "/", base)
    let parent = dir_of(composed)
    if parent.len > 0 { match mkdir_p(parent) { error => { }; null => { } } }
    composed
}
