//
// teko::journal::run_root — run id and run root/lock path composition, split out of
// journal.tks (mechanical file-size split; no logic changes).
//
// @since 0.3.1
//

/**
 * run_id — the identifier of THIS run, inherited from the orchestrator or minted now.
 *
 * NAMING THE RUN IS WHAT KILLS THE SILENT GARBAGE. An orphan segment from yesterday lives under
 * another root and carries another stamp, so it is IDENTIFIABLE rather than silently merged — the
 * one failure mode on the list that gave no signal at all. Stable within the process and inherited
 * by children through `RUN_ENV`: the first call with no `TEKO_RUN` mints `<monotonic-ns>-<pid>` and
 * writes it back, so every later call and every child reads the same stamp.
 *
 * @return  the run's identifier, stable within the process
 * @since 0.3.1
 */
pub fn run_id() -> str {
    match teko::env::var(RUN_ENV) {
        str as v => { if v.len > 0 { return v } }
        error => { }
    }
    let id = teko::str::concat(teko::str::i64_to_str(mono_ns_rt()), "-", teko::str::i64_to_str(pid_rt()))
    match teko::env::set_var(RUN_ENV, id) { error => { }; null => { } }
    id
}

/**
 * run_root — the directory THIS run owns, and the only one it may create.
 *
 * @return  `bin/.tkrun/<run_id()>`
 * @since 0.3.1
 */
pub fn run_root() -> str { teko::str::concat(TKRUN_DIR, "/", run_id()) }
