/**
 * teko::journal — the append-only segment ONE writer owns and nobody else shares.
 *
 * THE MODEL, IN ONE SENTENCE. Every write a run makes goes to a journal: an append-only record,
 * stamped with the run's identity, segmented per writer. Summarisation does not merge anything at
 * the end — it RE-READS. Three properties, each killing one defect: a per-writer segment removes the
 * overlap (no shared destination, so no lock); a run stamp removes the previous run's garbage passing
 * for valid; append-only plus read-back summarisation removes the loss on abrupt death (there is
 * nothing to merge that could be lost — it was already written).
 *
 * WHY THE `seg` IS OPAQUE. Today it is a descriptor opened in `O_APPEND`; when the lanes of a future
 * `teko::isolate` arrive it will be a per-lane slab index. The record format, `append` and the
 * summariser do not change with the swap — and that invariance is why the field carries no concrete
 * meaning on the surface. The substrate swap is ONE function.
 *
 * @since 0.3.1
 */

/**
 * open_seg_rt — the runtime symbol `tk_journal_open` wraps: open/create `path` in O_APPEND and return
 * the RAW descriptor (>= 0), or -1 when it could not be created. Kept private so every caller goes
 * through the typed `open_at`.
 *
 * A SCALAR RETURN AND NOT `Journal | error`, which is a compiler constraint the whole runtime surface
 * records (`teko::io::append_file`): a brand-new `error`-shaped `extern fn` needs a per-name lift in
 * codegen the released bootstrap seed's frozen codegen cannot learn, and a `from "teko_rt"` extern
 * cannot return a user struct by value at all. The Teko wrapper builds the `Journal` and the `error`.
 *
 * @param path  the segment file to open, created when absent
 * @return      the raw descriptor (>= 0), or -1 on failure
 * @since 0.3.1
 */
extern fn open_seg_rt(path: str) -> i64 = "tk_journal_open" from "teko_rt"

/**
 * append_seg_rt — the runtime symbol `tk_journal_append` wraps: write the record whole to descriptor
 * `seg` and return 0, or the errno. Kept private so every caller goes through `append`/`append_line`.
 *
 * @param seg  the raw descriptor a segment was opened on
 * @param rec  the record bytes, already terminated by a newline
 * @return     0 on success, or the errno the write failed with
 * @since 0.3.1
 */
extern fn append_seg_rt(seg: i64, rec: str) -> i32 = "tk_journal_append" from "teko_rt"

/**
 * close_seg_rt — the runtime symbol `tk_journal_close` wraps: close descriptor `seg`, returning 0 or
 * the errno. Kept private so every caller goes through `close`.
 *
 * @param seg  the raw descriptor to close
 * @return     0 on success, or the errno
 * @since 0.3.1
 */
extern fn close_seg_rt(seg: i64) -> i32 = "tk_journal_close" from "teko_rt"

/**
 * rename_rt — the runtime symbol `tk_rt_rename` wraps: rename `from` to `to` atomically within the
 * same directory, returning 0 or the errno. Kept private so every caller goes through `rename`.
 *
 * @param from  the existing path
 * @param to    the path to publish it as, replacing any file already there
 * @return      0 on success, or the errno
 * @since 0.3.1
 */
extern fn rename_rt(from: str, to: str) -> i32 = "tk_rt_rename" from "teko_rt"

/**
 * BAD_DESCRIPTOR — what `open_seg_rt` answers when the segment could not be created.
 */
const BAD_DESCRIPTOR: i64 = -1

/**
 * FIELD_SEP — the byte that separates a record's fields on disk. A tab, because it never appears in a
 * run id, a writer id or a `kind`, and a payload that carried one would be the emitter's bug to keep
 * out (payloads are single-line by contract).
 */
const FIELD_SEP: str = "\t"

/**
 * Journal — the append-only segment ONE writer owns and no more.
 *
 * @since 0.3.1
 */
pub type Journal = struct {
    /** the identifier of the run this segment belongs to (`run_id`), stamped into every record. */
    run: str
    /** the writer's identity — `s<i>` for a gate shard, `p<i>` for a pool child, `m` for the orchestrator. */
    writer: str
    /**
     * the open sink: a raw descriptor today, a per-lane slab index when lanes arrive.
     *
     * AN `i64` AND NOT THE DESIGN'S `u64`, for a reason the runtime surface forces: the descriptor is
     * what `open_seg_rt` answers, and it answers `-1` on failure — a signed field takes that value
     * with no cast, and this project's cast law admits no `i64`-from-`u64` narrowing to launder it.
     */
    seg: i64
}

/**
 * Record — a record read back by the summariser.
 *
 * @since 0.3.1
 */
pub type Record = struct {
    /** the run that wrote it; a record of another run is DISCARDED by `fold`. */
    run: str
    /** who wrote it. */
    writer: str
    /** the record's kind (`begin`, `ok`, `fail`, `cov`, `end`, `stop`, `crash`). */
    kind: str
    /** the record body, without newlines (the emitter keeps them out). */
    payload: str
}

/**
 * open_at — open the segment file `path` for `run`/`writer`, returning the `Journal` that owns it.
 *
 * THE IDENTITY IS PASSED IN, NOT COMPOSED HERE. `run` and `writer` are the stamp every record built
 * on this segment carries; the caller (or `teko::journal::open`, once run identity lands) supplies
 * them so this function stays the single place a descriptor becomes a typed segment.
 *
 * @param path    the segment file to open, created when absent
 * @param run     the run stamp records on this segment carry
 * @param writer  the writer identity records on this segment carry
 * @return        the opened segment
 * @throws        when the segment could not be created (permission, disk full)
 * @since 0.3.1
 */
pub fn open_at(path: str, run: str, writer: str) -> Journal | error {
    let fd = open_seg_rt(path)
    if fd == BAD_DESCRIPTOR {
        return error { message = teko::str::concat("teko::journal::open_at: could not open segment ", path) }
    }
    Journal { run = run; writer = writer; seg = fd }
}

/**
 * append — append ONE record to `j`'s segment.
 *
 * THE DURABILITY POINT IS THIS, and it is named: a single `write(2)` on a descriptor opened in
 * `O_APPEND`, with no user-space buffer. The record is in the kernel when `append` returns, so a
 * `SIGKILL` of the process does not lose it — only a crash of the machine would, and that boundary is
 * the design's §5.
 *
 * @param j        the segment to append to
 * @param kind     the record's kind
 * @param payload  the body, without newlines
 * @return         nothing on success, or the write failure
 * @throws         when the write fails (ENOSPC, EIO)
 * @since 0.3.1
 */
pub fn append(j: Journal, kind: str, payload: str) -> null | error {
    let rec = teko::str::concat(record_line(j.run, j.writer, kind, payload), "\n")
    if append_seg_rt(j.seg, rec) != 0 {
        return error { message = teko::str::concat("teko::journal::append: write failed on writer ", j.writer) }
    }
    null
}

/**
 * record_line — the on-disk shape of one record, WITHOUT its trailing newline: the four fields joined
 * by `FIELD_SEP`, in the order `fold` reads them back.
 *
 * @param run      the run stamp
 * @param writer   the writer identity
 * @param kind     the record kind
 * @param payload  the single-line body
 * @return         `run \t writer \t kind \t payload`
 * @since 0.3.1
 */
fn record_line(run: str, writer: str, kind: str, payload: str) -> str {
    mut line: str = teko::str::concat(run, FIELD_SEP)
    line = teko::str::concat(line, writer)
    line = teko::str::concat(line, FIELD_SEP)
    line = teko::str::concat(line, kind)
    line = teko::str::concat(line, FIELD_SEP)
    teko::str::concat(line, payload)
}

/**
 * close — close `j`'s segment. A segment that is never closed is flushed at process exit anyway (the
 * writes are unbuffered), so this exists for the writer that is DONE and wants the descriptor back.
 *
 * @param j  the segment to close
 * @return   nothing on success, or the close failure
 * @throws   when the descriptor could not be closed
 * @since 0.3.1
 */
pub fn close(j: Journal) -> null | error {
    if close_seg_rt(j.seg) != 0 {
        return error { message = teko::str::concat("teko::journal::close: could not close writer ", j.writer) }
    }
    null
}

/**
 * append_line — append `line` and a newline to the segment file at `path`, as ONE durable write.
 *
 * THIS IS THE RAW-LINE ARM `teko::process::verdict_emit` delegates to, and it is the SAME durability
 * primitive `append` uses — an `O_APPEND` open, one `write(2)`, a close — with no field stamping, so
 * the third channel's byte format is exactly what its readers already expect. Structured records go
 * through `append`; a free-form verdict line goes through here, and both are one unbuffered write.
 *
 * @param path  the segment file to append to, created when absent
 * @param line  the record, WITHOUT a trailing newline (one is added)
 * @return      nothing on success, or the failure
 * @throws      when the segment could not be opened or the bytes could not all be written
 * @since 0.3.1
 */
pub fn append_line(path: str, line: str) -> null | error {
    let fd = open_seg_rt(path)
    if fd == BAD_DESCRIPTOR {
        return error { message = teko::str::concat("teko::journal::append_line: could not open segment ", path) }
    }
    let wrote = append_seg_rt(fd, teko::str::concat(line, "\n"))
    let closed = close_seg_rt(fd)
    if wrote != 0 {
        return error { message = teko::str::concat("teko::journal::append_line: write failed on ", path) }
    }
    if closed != 0 {
        return error { message = teko::str::concat("teko::journal::append_line: close failed on ", path) }
    }
    null
}

/**
 * rename — publish `from` as `to` atomically within one directory, so no reader sees a half-written
 * file: what is a whole artefact writes to the writer's own temporary and lands here.
 *
 * @param from  the existing (complete) file
 * @param to    the path to publish it as, replacing any file already there
 * @return      nothing on success, or the failure
 * @throws      when the rename failed (cross-device, permission)
 * @since 0.3.1
 */
pub fn rename(from: str, to: str) -> null | error {
    if rename_rt(from, to) != 0 {
        return error { message = teko::str::concat(teko::str::concat("teko::journal::rename: could not publish ", from), teko::str::concat(" as ", to)) }
    }
    null
}

/**
 * mono_ns_rt — the runtime symbol `tk_rt_monotonic_ns` wraps: monotonic nanoseconds, the time half of
 * a run stamp. Kept private so `run_id` is the one composer of the stamp.
 *
 * @return  a monotonically non-decreasing nanosecond reading
 * @since 0.3.1
 */
extern fn mono_ns_rt() -> i64 = "tk_rt_monotonic_ns" from "teko_rt"

/**
 * pid_rt — the runtime symbol `tk_rt_pid` wraps: this process's id, the disambiguating half of a run
 * stamp. Kept private so `run_id` is the one composer of the stamp.
 *
 * @return  this process's id
 * @since 0.3.1
 */
extern fn pid_rt() -> i64 = "tk_rt_pid" from "teko_rt"

/**
 * rmtree_rt — the runtime symbol `tk_rt_rmtree` wraps: best-effort recursive remove of a PREVIOUS
 * run's root, 0 on full success. Kept private so `sweep` is the one caller.
 *
 * @param path  the run root to remove
 * @return      0 when the whole tree went, -1 when something survived
 * @since 0.3.1
 */
extern fn rmtree_rt(path: str) -> i32 = "tk_rt_rmtree" from "teko_rt"

/**
 * pid_alive_rt — the runtime symbol `tk_rt_pid_alive` wraps: whether `pid` is a live process. Kept
 * private so `sweep` is the one caller of the liveness test.
 *
 * @param pid  the process id the root lock recorded
 * @return     true iff a process with that id is currently alive
 * @since 0.3.1
 */
extern fn pid_alive_rt(pid: i64) -> bool = "tk_rt_pid_alive" from "teko_rt"

/**
 * RUN_ENV — the environment key that carries a run's identity to its children, and CACHES it within a
 * process. `run_id` reads it (so every call in one process, and every child `spawn_spec` launches,
 * answers the same stamp) and writes it on first miss.
 *
 * NAMING THE RUN IS WHAT KILLS THE SILENT GARBAGE. An orphan segment from yesterday lives under
 * another root and carries another stamp, so it is IDENTIFIABLE rather than silently merged — the one
 * failure mode on the list that gave no signal at all.
 */
pub const RUN_ENV: str = "TEKO_RUN"

/**
 * TKRUN_DIR — the directory that holds every run's root. A dotted scratch namespace under `bin/` so
 * the scratch guard (G1) already recognises it and `sweep` has one place to walk.
 */
pub const TKRUN_DIR: str = "bin/.tkrun"

/**
 * run_id — the identifier of THIS run, inherited from the orchestrator or minted now.
 *
 * STABLE WITHIN THE PROCESS AND INHERITED BY CHILDREN, through one mechanism: `RUN_ENV`. The first
 * call with no `TEKO_RUN` set mints `<monotonic-ns>-<pid>` and writes it back, so every later call and
 * every child reads the same stamp instead of minting a fresh one per process.
 *
 * @return  the run's identifier, stable within the process
 * @since 0.3.1
 */
pub fn run_id() -> str {
    match teko::env::var(RUN_ENV) {
        str as v => { if v.len > 0 { return v } }
        error => { }
    }
    let id = teko::str::concat(teko::str::i64_to_str(mono_ns_rt()), teko::str::concat("-", teko::str::i64_to_str(pid_rt())))
    match teko::env::set_var(RUN_ENV, id) { error => { }; null => { } }
    id
}

/**
 * run_root — the directory THIS run owns, and the only one it may create.
 *
 * @return  `bin/.tkrun/<run_id()>`
 * @since 0.3.1
 */
pub fn run_root() -> str { teko::str::concat(teko::str::concat(TKRUN_DIR, "/"), run_id()) }

/**
 * mkdir_p — create `dir` and every missing parent, since `teko::fs::mkdir` is a single `mkdir(2)`.
 * A local copy of `project.tks`'s helper so the journal module carries no cross-module dependency for
 * a three-line walk; an already-existing level is a no-op (`tk_rt_mkdir` treats EEXIST as success).
 *
 * @param dir  the directory to create, with any parents it needs
 * @return     an `error` when a level cannot be created, else `null`
 * @since 0.3.1
 */
fn mkdir_p(dir: str) -> error | null {
    mut i: u64 = 0
    loop {
        if i >= dir.len { break }
        if dir[i] == b'/' && i > 0 {
            match teko::fs::mkdir(teko::str::slice_to(dir, i)) { error as e => return e; null => { } }
        }
        i = i + 1
    }
    teko::fs::mkdir(dir)
}

/**
 * dir_of — the directory part of `path` (everything before its last `/`), or "" when it names no
 * directory. Used to create a scratch file's parents without creating the file itself.
 *
 * @param path  a composed path
 * @return      the parent directory, or ""
 * @since 0.3.1
 */
fn dir_of(path: str) -> str {
    mut i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_to(path, i) }
    }
    ""
}

/**
 * writer_dir — the per-writer sub-directory a scope token names under the run root: the token with its
 * leading `.` removed (`.s0-label` becomes `s0-label`), so the run root holds one directory per test
 * identity rather than a flat pile of sibling files.
 *
 * @param scope  the running test's scope token (`.s<shard>-<label>`), never ""
 * @return       the sub-directory name
 * @since 0.3.1
 */
fn writer_dir(scope: str) -> str {
    if scope.len > 0 && scope[0] == b'.' { return teko::str::slice_from(scope, 1) }
    scope
}

/**
 * scratch — the path `base` has IN THIS RUN and for the CURRENTLY RUNNING test.
 *
 * THIS IS THE ONE COMPOSER. "Which paths are isolated" is answered by reading this function's callers,
 * not by grepping literals — which is exactly how the fixed paths went unnoticed.
 *
 * BYTE-FOR-BYTE `base` OUTSIDE A TEST, and that is the point rather than a fallback: the same
 * path-composing code runs in PRODUCTION (the regression runner), and there the path must stay what it
 * was. Rooting applies exactly where the concurrency it guards against exists — inside the test gate,
 * where `teko::test::scope()` is non-empty.
 *
 * @param base  the path a caller would otherwise hard-code
 * @return      `<run_root()>/<writer>/<base>` inside a test (parents created), `base` outside one
 * @since 0.3.1
 */
pub fn scratch(base: str) -> str {
    let scope = teko::test::scope()
    if scope.len == 0 { return base }
    let root = run_root()
    let composed = teko::str::concat(teko::str::concat(root, "/"), teko::str::concat(writer_dir(scope), teko::str::concat("/", base)))
    let parent = dir_of(composed)
    if parent.len > 0 { match mkdir_p(parent) { error => { }; null => { } } }
    composed
}

/**
 * ensure_root — create this run's root and stamp it with a lock naming this process, so a concurrent
 * `sweep` from another run leaves it alone while this run is alive.
 *
 * @return  the run root, created and locked
 * @since 0.3.1
 */
pub fn ensure_root() -> str {
    let root = run_root()
    match mkdir_p(root) { error => { }; null => { } }
    match teko::io::write_file(lock_path(root), teko::str::i64_to_str(pid_rt())) { error => { }; null => { } }
    root
}

/**
 * lock_path — the lock file inside a run root, whose body is the locking process's pid.
 *
 * @param root  a run root
 * @return      `<root>/.lock`
 * @since 0.3.1
 */
fn lock_path(root: str) -> str { teko::str::concat(root, "/.lock") }

/**
 * sweep — remove the run roots under `bin/.tkrun/` that are neither `keep` nor still locked by a live
 * process.
 *
 * THE CLEANUP IS THE NEXT RUN'S, NEVER ITS OWN. A run that cleaned on exit would lose the cleanup in
 * the one case it matters (abrupt death) and lose with it the proof that it died. Sweeping on OPEN has
 * the opposite property: a SIGKILL leaves the root ON PURPOSE, and the next run reclaims it only after
 * it could have reported it — and only once its locker is gone.
 *
 * @param keep  the run root to preserve (this run's own)
 * @return      how many roots were removed
 * @since 0.3.1
 */
pub fn sweep(keep: str) -> u64 {
    let keep_id = last_segment(keep)
    let entries = match teko::fs::list_dir(TKRUN_DIR) { []str as e => e; error => teko::list::empty() }
    mut removed: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let name = entries[i]
        if name != keep_id && !root_is_live(teko::str::concat(teko::str::concat(TKRUN_DIR, "/"), name)) {
            if rmtree_rt(teko::str::concat(teko::str::concat(TKRUN_DIR, "/"), name)) == 0 { removed = removed + 1 }
        }
        i = i + 1
    }
    removed
}

/**
 * root_is_live — whether the run root at `root` is still held by a live process, read from its lock.
 *
 * @param root  a sibling run root
 * @return      true iff its lock names a pid that is currently alive
 * @since 0.3.1
 */
fn root_is_live(root: str) -> bool {
    let body = match teko::io::read_file(lock_path(root)) { str as s => s; error => return false }
    let pid = parse_pid(body)
    if pid <= 0 { return false }
    pid_alive_rt(pid)
}

/**
 * parse_pid — the decimal pid a lock file holds, read digit by digit (the corpus has no string→int
 * intrinsic, and the body is exactly `i64_to_str(pid)` so leading digits are all there is). A body
 * with no digit answers 0, which `root_is_live` reads as "not live".
 *
 * @param body  the lock file's contents
 * @return      the pid, or 0 when the body carries none
 * @since 0.3.1
 */
fn parse_pid(body: str) -> i64 {
    mut v: i64 = 0
    mut i: u64 = 0
    mut seen: bool = false
    loop {
        if i >= body.len { break }
        let c = body[i]
        if c >= b'0' && c <= b'9' {
            v = (v * 10) + ((c to i64) - (b'0' to i64))
            seen = true
        }
        if seen && (c < b'0' || c > b'9') { break }
        i = i + 1
    }
    v
}

/**
 * last_segment — the last `/`-separated segment of `path` (its basename), or `path` when it has none.
 *
 * @param path  a path
 * @return      its final segment
 * @since 0.3.1
 */
fn last_segment(path: str) -> str {
    mut i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_from(path, i + 1) }
    }
    path
}
