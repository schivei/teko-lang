/**
 * teko::journal — the append-only segment ONE writer owns and nobody else shares (design
 * journaling-de-corrida-0.3.1 §2.2).
 *
 * THE MODEL, IN ONE SENTENCE. Every write a run makes goes to a journal: an append-only record,
 * stamped with the run's identity, segmented per writer. Summarisation does not merge at the end —
 * it RE-READS (`fold`). Three properties, each killing one named failure mode: a per-writer segment
 * removes the shared destination (no lock, no overlap); a run stamp removes a previous run's garbage
 * passing for valid; append-only plus read-back removes the loss on abrupt death — there is nothing
 * to merge that could be lost, because it was already written.
 *
 * WHY `seg` IS OPAQUE. Today it is a descriptor opened in O_APPEND; when the lanes of a future
 * `teko::isolate` arrive it will be a per-lane slab index. The record format, `append`, and `fold`
 * do not change with the swap, and that invariance is why the field carries no concrete meaning.
 *
 * @since 0.3.1
 */

/**
 * open_seg_rt — the runtime symbol `tk_journal_open` wraps: open/create `path` in O_WRONLY|O_APPEND|
 * O_CREAT and return the RAW descriptor. Kept private so every caller goes through the typed `open`.
 *
 * A SCALAR RETURN AND NOT `Journal | error`, which the whole runtime surface records
 * (`teko::io::append_file_raw`): a brand-new `error`-shaped `extern fn` needs a per-name lift the
 * released bootstrap seed's frozen codegen cannot learn, and a `from "teko_rt"` extern cannot return
 * a user struct by value at all. The Teko wrapper builds the `Journal` and the `error`.
 *
 * @param path  the segment file to open, created when absent
 * @return      the raw descriptor (>= 0), or -1 on a failure to open
 * @since 0.3.1
 */
extern fn open_seg_rt(path: str): i64 = "tk_journal_open" from "teko_rt"

/**
 * append_seg_rt — the runtime symbol `tk_journal_append` wraps: write `rec` whole to descriptor
 * `seg`, finishing a short write in a loop. Kept private so every caller goes through `append`.
 *
 * `rec` LEADS `seg`, and that order is deliberate: a by-value `str` is only ABI-describable when it
 * is a leading parameter (see `lir/lower.tks::takes_one_str_by_value`), so putting the record first
 * keeps the call correct on every target rather than only on the ones where a fat pair happens to
 * decompose into the same registers.
 *
 * @param rec  the record bytes, already terminated by a newline
 * @param seg  the raw descriptor a segment was opened on
 * @return     0 on success, or the errno the write failed with
 * @since 0.3.1
 */
extern fn append_seg_rt(rec: str, seg: i64): i32 = "tk_journal_append" from "teko_rt"

/**
 * arm_note_rt — the runtime symbol `tk_journal_arm` wraps: remember `prefix` (a pre-shaped
 * `run\twriter\tstop\t` record head) as the bytes a later async-signal-safe `tk_journal_note`
 * prepends before the signal number. Kept private so `open` is the one arm point.
 *
 * @param prefix  the stop-record head, formatted here at open time (never inside a handler)
 * @since 0.3.1
 */
extern fn arm_note_rt(prefix: str): void = "tk_journal_arm" from "teko_rt"

/**
 * rename_rt — the runtime symbol `tk_rt_rename` wraps: rename `from` to `to` atomically within one
 * directory. Kept private so every caller goes through `rename`.
 *
 * @param from  the existing (complete) file
 * @param to    the path to publish it as, replacing any file already there
 * @return      0 on success, or the errno
 * @since 0.3.1
 */
extern fn rename_rt(from: str, to: str): i32 = "tk_rt_rename" from "teko_rt"

/**
 * mono_ns_rt — the runtime symbol `tk_rt_monotonic_ns` wraps: monotonic nanoseconds, the time half
 * of a run stamp. Binds an EXISTING runtime symbol (no new C); kept private so `run_id` is the one
 * composer of the stamp.
 *
 * @return  a monotonically non-decreasing nanosecond reading
 * @since 0.3.1
 */
extern fn mono_ns_rt(): i64 = "tk_rt_monotonic_ns" from "teko_rt"

/**
 * pid_rt — the runtime symbol `tk_rt_pid` wraps: this process's id, the disambiguating half of a run
 * stamp. Kept private so `run_id` is the one composer of the stamp.
 *
 * @return  this process's id
 * @since 0.3.1
 */
extern fn pid_rt(): i64 = "tk_rt_pid" from "teko_rt"

/**
 * pid_alive_rt — the runtime symbol `tk_rt_pid_alive` wraps: whether `pid` is a live process. Kept
 * private so `sweep` is the one caller of the liveness test.
 *
 * @param pid  the process id a root's lock recorded
 * @return     true iff a process with that id is currently alive
 * @since 0.3.1
 */
extern fn pid_alive_rt(pid: i64): bool = "tk_rt_pid_alive" from "teko_rt"

/**
 * note_write_rt — the runtime symbol `tk_journal_note` wraps: the SAME async-signal-safe writer the
 * polite-signal handler (`tk_rt_stop_handler`, §6) runs — it appends the armed `run\twriter\tstop\t`
 * head, the signal number, and a newline to the segment `open` stashed. Kept private so `note` is the
 * one caller.
 *
 * @param sig  the signal number the note records
 * @since 0.3.1
 */
extern fn note_write_rt(sig: i32): void = "tk_journal_note" from "teko_rt"

/**
 * BAD_DESCRIPTOR — what `open_seg_rt` answers when the segment could not be created.
 */
const BAD_DESCRIPTOR: i64 = -1

/**
 * FIELD_SEP — the byte that separates a record's fields on disk. A tab, because it never appears in
 * a run id, a writer id, or a `kind`, and a payload carrying one would be the emitter's bug to keep
 * out (payloads are single-line by contract).
 */
const FIELD_SEP: str = "\t"

/**
 * RUN_ENV — the environment key that carries a run's identity to its children and CACHES it within a
 * process. `run_id` reads it (so every call in one process, and every child a `spawn_spec` launches,
 * answers the same stamp) and writes it on the first miss.
 */
pub const RUN_ENV: str = "TEKO_RUN"

/**
 * TKRUN_DIR — the directory that holds every run's root. A dotted scratch namespace under `bin/` so
 * the scratch guard already recognises it and `sweep` has one place to walk.
 */
pub const TKRUN_DIR: str = "bin/.tkrun"

/**
 * LOCK_NAME — the basename of a run root's lock file, which `fold` must NOT read as a segment (it
 * carries a pid, not records) and whose live-owner `sweep` spares.
 */
const LOCK_NAME: str = ".lock"

/**
 * KIND_BEGIN — the kind a writer appends when a test STARTS; its payload names the test. The last
 * `begin` with no matching verdict is the test a dead writer died in, which `fold` carries into the
 * synthetic `incomplete`'s payload.
 */
pub const KIND_BEGIN: str = "begin"

/**
 * KIND_PLAN — the kind a writer appends ONCE, before its first `begin`, naming (in its payload, a
 * decimal count) how many tests it intends to run. `summarize` (§13) reads it back to say
 * `never-ran`: the gap between a `plan` and the verdicts a writer actually produced is exactly the
 * tests a dead writer never reached.
 */
pub const KIND_PLAN: str = "plan"

/**
 * KIND_OK — the kind a writer appends when a test PASSED; its payload names the test.
 */
pub const KIND_OK: str = "ok"

/**
 * KIND_FAIL — the kind a writer appends when a test FAILED; its payload is the test's label, a tab,
 * and the failure reason (`summarize`'s `payload_label`/`payload_reason` split it back apart).
 */
pub const KIND_FAIL: str = "fail"

/**
 * KIND_SKIP — the kind a writer appends when a test was SKIPPED for missing capability; its payload
 * is the test's label, a tab, and the skip reason, the same shape as `KIND_FAIL`'s.
 */
pub const KIND_SKIP: str = "skip"

/**
 * KIND_END — the kind a writer appends when it has run everything it planned. Its presence is what
 * distinguishes a finished segment from a dead one.
 */
pub const KIND_END: str = "end"

/**
 * KIND_STOP — the kind the signal arm appends when a polite signal ends the run (§6). A terminal
 * kind like `end`: a segment carrying one is not synthesised `incomplete`.
 */
pub const KIND_STOP: str = "stop"

/**
 * KIND_INCOMPLETE — the kind `fold` stamps on the synthetic `end` it appends for a segment that
 * never wrote one: the writer died, and the run must SEE it rather than round it up (§4).
 */
pub const KIND_INCOMPLETE: str = "incomplete"

/**
 * KIND_COV — the kind a writer appends ONCE when it dumps its coverage: the payload is six
 * `TAB`-separated `u64` fields (functions cov/val, lines cov/val, branches cov/val), which
 * `summary::cov_of_payload` decodes. The measurement transported in the journal itself (spec
 * §3.8); no writer emits it yet, so the fold sums to 0 until an emitter exists — additive, no
 * caller to break.
 *
 * @since 0.3.1
 */
pub const KIND_COV: str = "cov"

/**
 * Journal — the append-only segment ONE writer owns and no more.
 *
 * @since 0.3.1
 */
pub type Journal = struct {
    /** the identifier of the run this segment belongs to (`run_id`), stamped into every record. */
    run: str
    /** the writer's identity — `s<i>` for a gate shard, `p<i>` for a pool child, `m` for the orchestrator. */
    writer: str
    /**
     * the open sink: a raw descriptor today, a per-lane slab index when lanes arrive.
     *
     * AN `i64` AND NOT THE DESIGN'S `u64`: the descriptor is what `open_seg_rt` answers, and it
     * answers `-1` on failure — a signed field takes that value with no cast, and this project's cast
     * law admits no `i64`-from-`u64` narrowing to launder it.
     */
    seg: i64
}

/**
 * Record — a record read back by the summariser.
 *
 * @since 0.3.1
 */
pub type Record = struct {
    /** the run that wrote it; a record of another run is DISCARDED by `fold`. */
    run: str
    /** who wrote it. */
    writer: str
    /** the record's kind (`begin`, `ok`, `fail`, `cov`, `end`, `stop`, `crash`, `incomplete`). */
    kind: str
    /** the record body, without newlines (the emitter keeps them out). */
    payload: str
}

/**
 * run_id — the identifier of THIS run, inherited from the orchestrator or minted now.
 *
 * NAMING THE RUN IS WHAT KILLS THE SILENT GARBAGE. An orphan segment from yesterday lives under
 * another root and carries another stamp, so it is IDENTIFIABLE rather than silently merged — the
 * one failure mode on the list that gave no signal at all. Stable within the process and inherited
 * by children through `RUN_ENV`: the first call with no `TEKO_RUN` mints `<monotonic-ns>-<pid>` and
 * writes it back, so every later call and every child reads the same stamp.
 *
 * @return  the run's identifier, stable within the process
 * @since 0.3.1
 */
pub fn run_id(): str {
    match teko::env::var(RUN_ENV) {
        str as v => { if v.len > 0 { return v } }
        error => { }
    }
    var id = teko::str::concat(teko::str::i64_to_str(mono_ns_rt()), "-", teko::str::i64_to_str(pid_rt()))
    match teko::env::set_var(RUN_ENV, id) { error => { }; null => { } }
    id
}

/**
 * run_id_is_fresh — whether the NEXT call to `run_id` would MINT a stamp rather than read one
 * already inherited through `TEKO_RUN`.
 *
 * THIS IS THE SIGNAL `claim_root`'s ferrolho NEEDS AND `run_id` ALONE CANNOT GIVE IT: once `run_id`
 * runs it sets `TEKO_RUN`, so asking afterwards can no longer tell "I minted this" from "my parent
 * handed it to me" — the two cases must be told apart BEFORE that call, which is why this reads the
 * environment directly instead of delegating.
 *
 * @return  true iff no `TEKO_RUN` is set yet in this process's environment
 * @since 0.3.1
 */
fn run_id_is_fresh(): bool {
    match teko::env::var(RUN_ENV) {
        str as v => v.len == 0
        error => true
    }
}

/**
 * run_root — the directory THIS run owns, and the only one it may create.
 *
 * @return  `bin/.tkrun/<run_id()>`
 * @since 0.3.1
 */
pub fn run_root(): str { teko::str::concat(TKRUN_DIR, "/", run_id()) }

/**
 * lock_path — the lock file inside a run root, whose body is ONE pid per line — one line per writer
 * that has ever claimed this root, never overwritten (§1.1: a run root is shared on purpose by every
 * writer `TEKO_RUN` was inherited into, and each one's pid has to stay recorded for the root to read
 * as live for as long as ANY of them still is).
 *
 * @param root  a run root
 * @return      `<root>/.lock`
 * @since 0.3.1
 */
fn lock_path(root: str): str { teko::str::concat(root, "/", LOCK_NAME) }

/**
 * seg_path — the segment file writer `writer` owns under run root `root`.
 *
 * @param root    the run root the segment lives in
 * @param writer  the writer identity
 * @return        `<root>/<writer>`
 * @since 0.3.1
 */
fn seg_path(root: str, writer: str): str { teko::str::concat(root, "/", writer) }

/**
 * mkdir_p — create `dir` and every missing parent, since `teko::fs::mkdir` is a single `mkdir(2)`.
 * An already-existing level is a no-op (mkdir treats EEXIST as success).
 *
 * @param dir  the directory to create, with any parents it needs
 * @return     an `error` when a level cannot be created, else `null`
 * @since 0.3.1
 */
fn mkdir_p(dir: str): error | null {
    var i: u64 = 0
    loop {
        if i >= dir.len { break }
        if dir[i] == b'/' && i > 0 {
            match teko::fs::mkdir(teko::str::slice_to(dir, i)) { error as e => return e; null => { } }
        }
        i = i + 1
    }
    teko::fs::mkdir(dir)
}

/**
 * claim_root — create `root` (if absent) and record this process among its lock's writers, refusing
 * when `fresh` names a real conflict (§11.3's ferrolho).
 *
 * A FRESH ID COLLIDING WITH A LIVE ROOT IS THE ONE CASE THIS REFUSES. `fresh` is true exactly when
 * THIS call's `run_id` was just minted rather than inherited: a minted id landing on a directory some
 * OTHER live process already holds means the naming scheme's own uniqueness assumption (timestamp +
 * pid) broke, or `TEKO_RUN` was set by hand to a value that collides — either way it is a real
 * conflict and MUST be named, never silently shared. An INHERITED id (`fresh = false`) sharing a live
 * root is not a conflict at all — it is every sibling writer `TEKO_RUN` was deliberately propagated to
 * (§1.1) — so it is never refused, no matter how many live pids the lock already names.
 *
 * @param root   the run root to claim
 * @param fresh  whether this call's run id was just minted rather than inherited via `TEKO_RUN`
 * @return       `root`, created and recording this process, or the named refusal
 * @throws       when `fresh` is true and `root` is already held by a live process
 * @since 0.3.1
 */
fn claim_root(root: str, fresh: bool): str | error {
    if fresh && root_is_live(root) {
        return error { message = teko::str::concat("teko::journal: run root already in use by a live process (", root, ")") }
    }
    match mkdir_p(root) { error => { }; null => { } }
    record_self_pid(root)
    root
}

/**
 * ensure_root — create THIS run's root and record this process among its lock's writers, so a
 * concurrent `sweep` from another run spares it while any of this run's writers is alive.
 *
 * @return  the run root, created and locked
 * @throws  when this run's id was just minted and collides with a live root (§11.3)
 * @since 0.3.1
 */
fn ensure_root(): str | error {
    var fresh = run_id_is_fresh()
    claim_root(run_root(), fresh)
}

/**
 * record_line — the on-disk shape of one record, WITHOUT its trailing newline: the four fields
 * joined by `FIELD_SEP`, in the order `fold` reads them back.
 *
 * @param run      the run stamp
 * @param writer   the writer identity
 * @param kind     the record kind
 * @param payload  the single-line body
 * @return         `run \t writer \t kind \t payload`
 * @since 0.3.1
 */
fn record_line(run: str, writer: str, kind: str, payload: str): str {
    teko::str::concat(run, FIELD_SEP, writer, FIELD_SEP, kind, FIELD_SEP, payload)
}

/**
 * open_seg — open the segment file `path` for `run`/`writer`, returning the `Journal` that owns it
 * and arming the polite-signal note with this run/writer's stop-record head.
 *
 * THE IDENTITY IS PASSED IN, NOT COMPOSED HERE, so this stays the single place a descriptor becomes
 * a typed segment — the seam the public `open` and the unit tests both go through.
 *
 * @param path    the segment file to open, created when absent
 * @param run     the run stamp records on this segment carry
 * @param writer  the writer identity records on this segment carry
 * @return        the opened segment
 * @throws        when the segment could not be created (permission, disk full)
 * @since 0.3.1
 */
fn open_seg(path: str, run: str, writer: str): Journal | error {
    var fd = open_seg_rt(path)
    if fd == BAD_DESCRIPTOR {
        return error { message = teko::str::concat("teko::journal: could not open segment ", path) }
    }
    arm_note_rt(record_line(run, writer, KIND_STOP, ""))
    Journal { run = run; writer = writer; seg = fd }
}

/**
 * open — open the segment of `writer` in THIS run (§2.2), creating and locking the run root first.
 *
 * @param writer  the writer identity; two live writers never repeat it (`s<i>`/`p<i>`/`m`)
 * @return        the opened segment
 * @throws        when the segment could not be created (permission, disk full), or when this run's id
 *                was just minted and collides with a live root (§11.3's ferrolho)
 * @since 0.3.1
 */
pub fn open(writer: str): Journal | error {
    var run = run_id()
    var root = match ensure_root() { str as r => r; error as e => return e }
    open_seg(seg_path(root, writer), run, writer)
}

/**
 * append — append ONE record to `j`'s segment.
 *
 * THE DURABILITY POINT IS THIS, and it is named: a single `write(2)` on a descriptor opened in
 * O_APPEND, with no user-space buffer. The record is in the kernel when `append` returns, so a
 * `SIGKILL` of the process does not lose it — only a crash of the machine would, and that boundary
 * is §5.
 *
 * @param j        the segment to append to
 * @param kind     the record's kind
 * @param payload  the body, without newlines
 * @return         nothing on success, or the write failure
 * @throws         when the write fails (ENOSPC, EIO) — the failure is PEGAJOSA in the caller (§4)
 * @since 0.3.1
 */
pub fn append(j: Journal, kind: str, payload: str): null | error {
    var rec = teko::str::concat(record_line(j.run, j.writer, kind, payload), "\n")
    if append_seg_rt(rec, j.seg) != 0 {
        return error { message = teko::str::concat("teko::journal::append: write failed on writer ", j.writer) }
    }
    null
}

/**
 * note — record a `stop <sig>` note NOW to the segment `open` armed, through the SAME async-signal-safe
 * writer the polite-signal handler (`tk_rt_stop_handler`, §6) runs when a signal ends the run: it
 * prepends the armed `run\twriter\tstop\t` head, appends `sig`, and terminates the line. A program that
 * wants to mark a deliberate stop calls it; the J5 guard calls it to assert the record a polite signal
 * PRODUCES without delivering a real terminating signal, which by the re-raise contract of §6 would end
 * the process before it could read the note back. The signal delivery that CALLS this writer is proven
 * by the handler's own body.
 *
 * @param sig  the signal number the note records
 * @since 0.3.1
 */
pub fn note(sig: i32) { note_write_rt(sig) }

/**
 * rename — publish `from` as `to` atomically within one directory, so no reader sees a half-written
 * file: what is a whole artefact writes to the writer's own temporary and lands here (§2.3).
 *
 * @param from  the existing (complete) file
 * @param to    the path to publish it as, replacing any file already there
 * @return      nothing on success, or the failure
 * @throws      when the rename failed (cross-device, permission)
 * @since 0.3.1
 */
pub fn rename(from: str, to: str): null | error {
    if rename_rt(from, to) != 0 {
        return error { message = teko::str::concat("teko::journal::rename: could not publish ", from) }
    }
    null
}

/**
 * append_raw — append `line` + a newline to `path` VERBATIM: no run stamp, no writer field, no
 * kind. The RAW half of the durability point (§2.3's single `write(2)` on an O_APPEND descriptor),
 * for a caller whose channel is not a journal SEGMENT at all — `teko::process::verdict_emit`'s third
 * channel writes whatever line ITS OWN caller composed, unstructured, and must keep doing so; this
 * is what lets it reuse the one durable-append mechanism this module already owns without adopting
 * the four-field record shape `append` imposes.
 *
 * @param path  the file to append to (created if absent)
 * @param line  the line to append, WITHOUT its own trailing newline (one is added)
 * @return      nothing on success, or the failure to open or write
 * @since 0.3.1
 */
pub fn append_raw(path: str, line: str): null | error {
    var fd = open_seg_rt(path)
    if fd == BAD_DESCRIPTOR {
        return error { message = teko::str::concat("teko::journal::append_raw: could not open ", path) }
    }
    var rc = append_seg_rt(teko::str::concat(line, "\n"), fd)
    _ = close_fd_rt(fd)
    if rc != 0 {
        return error { message = teko::str::concat("teko::journal::append_raw: write failed on ", path) }
    }
    null
}

/**
 * writer_dir — the per-writer sub-directory a scope token names under the run root: the token with
 * its leading `.` removed (`.s0-label` becomes `s0-label`), so the run root holds one directory per
 * test identity rather than a flat pile of sibling files.
 *
 * @param scope  the running test's scope token (`.s<shard>-<label>`), never ""
 * @return       the sub-directory name
 * @since 0.3.1
 */
fn writer_dir(scope: str): str {
    if scope.len > 0 && scope[0] == b'.' { return teko::str::slice_from(scope, 1) }
    scope
}

/**
 * dir_of — the directory part of `path` (everything before its last `/`), or "" when it names no
 * directory. Used to create a scratch file's parents without creating the file itself.
 *
 * @param path  a composed path
 * @return      the parent directory, or ""
 * @since 0.3.1
 */
fn dir_of(path: str): str {
    var i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_to(path, i) }
    }
    ""
}

/**
 * scratch — the path `base` has IN THIS RUN and for the CURRENTLY RUNNING test (§2.2).
 *
 * THIS IS THE ONE COMPOSER. "Which paths are isolated" is answered by reading this function's
 * callers, not by grepping literals — which is exactly how the fixed paths went unnoticed.
 *
 * BYTE-FOR-BYTE `base` OUTSIDE A TEST, and that is the point rather than a fallback: the same
 * path-composing code runs in PRODUCTION (the regression runner), and there the path must stay what
 * it was. Rooting applies exactly where the concurrency it guards against exists — inside the test
 * gate, where `teko::test::scope()` is non-empty.
 *
 * @param base  the path a caller would otherwise hard-code
 * @return      `<run_root()>/<writer>/<base>` inside a test (parents created), `base` outside one
 * @since 0.3.1
 */
pub fn scratch(base: str): str {
    var scope = teko::test::scope()
    if scope.len == 0 { return base }
    var composed = teko::str::concat(run_root(), "/", writer_dir(scope), "/", base)
    var parent = dir_of(composed)
    if parent.len > 0 { match mkdir_p(parent) { error => { }; null => { } } }
    composed
}

/**
 * is_terminal_kind — whether `kind` closes a segment, so `fold` need not synthesise an `incomplete`
 * for it: a clean `end`, a signalled `stop`, or an already-synthesised `incomplete`.
 *
 * @param kind  a record's kind
 * @return      true iff the kind marks the segment as closed
 * @since 0.3.1
 */
fn is_terminal_kind(kind: str): bool {
    if kind == KIND_END { return true }
    if kind == KIND_STOP { return true }
    kind == KIND_INCOMPLETE
}

/**
 * parse_record — decode ONE journal line into a `Record`, or `null` when it belongs to another run
 * or is malformed (fewer than the three `FIELD_SEP` bytes a record carries before its payload).
 *
 * THE RUN FILTER IS HYGIENE RULE 1 (§4). A line whose first field is not `want_run` is a previous
 * run's garbage under a shared directory, and it is DISCARDED here rather than counted.
 *
 * @param want_run  the run stamp a record must carry to count
 * @param line      one journal line, WITHOUT its trailing newline
 * @return          the decoded record, or `null` when it is another run's or malformed
 * @since 0.3.1
 */
fn parse_record(want_run: str, line: str): Record | null {
    var i: u64 = 0
    var t1: u64 = 0
    var t2: u64 = 0
    var t3: u64 = 0
    var n: u64 = 0
    loop {
        if i >= line.len { break }
        if line[i] == b'\t' {
            n = n + 1
            if n == 1 { t1 = i }
            if n == 2 { t2 = i }
            if n == 3 { t3 = i; break }
        }
        i = i + 1
    }
    if n < 3 { return null }
    var run = teko::str::slice_to(line, t1)
    if run != want_run { return null }
    Record {
        run = run
        writer = teko::str::slice(line, t1 + 1, t2)
        kind = teko::str::slice(line, t2 + 1, t3)
        payload = teko::str::slice_from(line, t3 + 1)
    }
}

/**
 * is_dir — whether `path` names a listable directory. Used to keep `fold_segment` from reading a
 * run root's writer/scratch SUB-directory as if it were a segment file: a run root holds both segment
 * files AND the per-writer scratch trees, and `read_file` on a directory sizes to a garbage-large
 * value that would allocate until OOM. No stat primitive is surfaced, so the listability of a path
 * is the available directory test.
 *
 * @param path  a path under a run root
 * @return      true iff `path` is a directory
 * @since 0.3.1
 */
fn is_dir(path: str): bool {
    match teko::fs::list_dir(path) { []str => true; error => false }
}

/**
 * fold_segment — read ONE segment file and append its records (of `run`) to `acc`, applying the two
 * per-segment hygiene rules of §4: a line without a trailing newline is a torn write and is dropped
 * (rule 2, satisfied by only emitting a line at each `\n`); a segment carrying no terminal kind gets
 * a synthetic `incomplete` naming its writer and the test it died in (rule 3). A directory entry (a
 * writer's scratch tree, sibling to the segments) is not a segment and is skipped.
 *
 * @param acc   the records folded so far
 * @param root  the run root the segment lives under
 * @param name  the segment file's basename
 * @param run   the run stamp a record must carry to count
 * @return      `acc` with this segment's records (and any synthetic `incomplete`) appended
 * @since 0.3.1
 */
fn fold_segment(acc: []Record, root: str, name: str, run: str): []Record {
    if name == LOCK_NAME { return acc }
    var path = teko::str::concat(root, "/", name)
    if is_dir(path) { return acc }
    var content = match teko::io::read_file(path) { str as s => s; error => return acc }
    var out: []Record = acc
    var writer: str = ""
    var last_begin: str = ""
    var saw_terminal: bool = false
    var saw_any: bool = false
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= content.len { break }
        if content[i] == b'\n' {
            match parse_record(run, teko::str::slice(content, start, i)) {
                Record as r => {
                    out = teko::list::push(out, r)
                    writer = r.writer
                    saw_any = true
                    if r.kind == KIND_BEGIN { last_begin = r.payload }
                    if is_terminal_kind(r.kind) { saw_terminal = true }
                }
                null => { }
            }
            start = i + 1
        }
        i = i + 1
    }
    if saw_any && !saw_terminal {
        out = teko::list::push(out, Record { run = run; writer = writer; kind = KIND_INCOMPLETE; payload = last_begin })
    }
    out
}

/**
 * str_less — whether `a` sorts before `b` byte-lexicographically, so `fold` returns segments in a
 * stable name order (the corpus surfaces no `str` comparator under a `teko::str::` name here).
 *
 * @param a  the left string
 * @param b  the right string
 * @return   true iff `a` is strictly less than `b`
 * @since 0.3.1
 */
fn str_less(a: str, b: str): bool {
    var i: u64 = 0
    loop {
        if i >= a.len { return b.len > a.len }
        if i >= b.len { return false }
        if a[i] < b[i] { return true }
        if a[i] > b[i] { return false }
        i = i + 1
    }
}

/**
 * remove_at — a copy of `xs` without the element at `idx`, the shrink `sort_names`'s selection pass
 * needs (a `[]str` is push-only, value-semantics).
 *
 * @param xs   the list to copy
 * @param idx  the index to drop
 * @return     `xs` without element `idx`
 * @since 0.3.1
 */
fn remove_at(xs: []str, idx: u64): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if i != idx { out = teko::list::push(out, xs[i]) }
        i = i + 1
    }
    out
}

/**
 * sort_names — `names` in ascending byte order, by selection. Directory listings arrive in no
 * guaranteed order, and `fold`'s `@return` promises segment-name order.
 *
 * @param names  the directory entries to sort
 * @return       the same entries, ascending
 * @since 0.3.1
 */
fn sort_names(names: []str): []str {
    var remaining: []str = names
    var ordered: []str = teko::list::empty()
    loop {
        if remaining.len == 0 { break }
        var min_idx: u64 = 0
        var j: u64 = 1
        loop {
            if j >= remaining.len { break }
            if str_less(remaining[j], remaining[min_idx]) { min_idx = j }
            j = j + 1
        }
        ordered = teko::list::push(ordered, remaining[min_idx])
        remaining = remove_at(remaining, min_idx)
    }
    ordered
}

/**
 * fold — re-read EVERY segment of `run` under `root` and return the records in segment order.
 *
 * THREE HYGIENE RULES, one per named failure mode of §4: a record of another run is discarded
 * (`parse_record`, rule 1); a torn last line is dropped (`fold_segment`, rule 2); a segment with no
 * terminal kind yields a synthetic `incomplete` naming its writer (`fold_segment`, rule 3). A pure
 * query over bytes already on disk, so a replay yields the same records after the orchestrator was
 * killed.
 *
 * @param root  the run root (`run_root()`, or an old root on a replay)
 * @param run   the stamp a record must carry to count
 * @return      the records, ordered by segment name then by write order
 * @since 0.3.1
 */
pub fn fold(root: str, run: str): []Record {
    var entries = match teko::fs::list_dir(root) { []str as e => e; error => teko::list::empty() }
    var names = sort_names(entries)
    var out: []Record = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        out = fold_segment(out, root, names[i], run)
        i = i + 1
    }
    out
}

/**
 * last_segment — the last `/`-separated segment of `path` (its basename), or `path` when it has none.
 *
 * @param path  a path
 * @return      its final segment
 * @since 0.3.1
 */
fn last_segment(path: str): str {
    var i: u64 = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        if path[i] == b'/' { return teko::str::slice_from(path, i + 1) }
    }
    path
}

/**
 * parse_pid — the decimal pid ONE lock line holds, read digit by digit. A line with no digit answers
 * 0, which `lock_pids` skips rather than recording as a real pid.
 *
 * @param line  one line of a lock file's contents, without its newline
 * @return      the pid, or 0 when the line carries none
 * @since 0.3.1
 */
fn parse_pid(line: str): i64 {
    var v: i64 = 0
    var i: u64 = 0
    var seen: bool = false
    loop {
        if i >= line.len { break }
        var c = line[i]
        if c >= b'0' && c <= b'9' {
            v = (v * 10) + ((c to i64) - (b'0' to i64))
            seen = true
        }
        if seen && (c < b'0' || c > b'9') { break }
        i = i + 1
    }
    v
}

/**
 * lock_pids — every pid `root`'s lock file names, one per line (§1.1: a root is a shared destination
 * for every writer `TEKO_RUN` inherited it into, so its lock is a SET of pids, not one). A body with
 * no trailing newline on its last line is still read (`sweep`'s existing single-pid fixtures write
 * exactly that shape).
 *
 * @param root  a run root
 * @return      the pids its lock names, in the order they were recorded
 * @since 0.3.1
 */
fn lock_pids(root: str): []i64 {
    var body = match teko::io::read_file(lock_path(root)) { str as s => s; error => return teko::list::empty() }
    var out: []i64 = teko::list::empty()
    var start: u64 = 0
    var i: u64 = 0
    loop {
        if i >= body.len { break }
        if body[i] == b'\n' {
            var p = parse_pid(teko::str::slice(body, start, i))
            if p > 0 { out = teko::list::push(out, p) }
            start = i + 1
        }
        i = i + 1
    }
    if start < body.len {
        var p = parse_pid(teko::str::slice_from(body, start))
        if p > 0 { out = teko::list::push(out, p) }
    }
    out
}

/**
 * root_is_live — whether the run root at `root` is still held by AT LEAST ONE live process among
 * every writer its lock ever recorded. A shared root (§1.1) stays live as long as ANY sibling writer
 * does, not only the one that happened to claim it first.
 *
 * @param root  a sibling run root
 * @return      true iff its lock names a pid that is currently alive
 * @since 0.3.1
 */
fn root_is_live(root: str): bool {
    var pids = lock_pids(root)
    var i: u64 = 0
    loop {
        if i >= pids.len { break }
        if pid_alive_rt(pids[i]) { return true }
        i = i + 1
    }
    false
}

/**
 * pid_in_lock — whether `pid` is already one of the pids `root`'s lock names, so `record_self_pid`
 * appends a writer's pid AT MOST ONCE even across repeated `open` calls in the same process.
 *
 * @param root  a run root
 * @param pid   the pid to look for
 * @return      true iff `root`'s lock already names `pid`
 * @since 0.3.1
 */
fn pid_in_lock(root: str, pid: i64): bool {
    var pids = lock_pids(root)
    var i: u64 = 0
    loop {
        if i >= pids.len { break }
        if pids[i] == pid { return true }
        i = i + 1
    }
    false
}

/**
 * record_self_pid — append this process's pid as one more line of `root`'s lock, unless it is there
 * already. NEVER OVERWRITES: the earlier shape (one `write_file` per claim) let the LAST writer to
 * open erase every EARLIER writer's pid, so a `sweep` running between two sibling writers' exits could
 * read a still-running root as dead the instant the writer that happened to open last was the first to
 * finish. Appending keeps every sibling's pid on record for as long as the file exists.
 *
 * @param root  the run root this process is claiming a share of
 * @since 0.3.1
 */
fn record_self_pid(root: str) {
    var pid = pid_rt()
    if pid_in_lock(root, pid) { return }
    match teko::io::append_file(lock_path(root), teko::str::concat(teko::str::i64_to_str(pid), "\n")) { error => { }; null => { } }
}

/**
 * rmtree — best-effort recursive removal of `path` and everything under it, in pure Teko over
 * `list_dir` + `remove_file` (libc `remove` rmdir's an empty directory, so children go first and the
 * now-empty directory follows). No runtime primitive is added for a walk this file can own.
 *
 * @param path  the tree root to remove
 * @return      true when the whole tree went, false when something survived
 * @since 0.3.1
 */
fn rmtree(path: str): bool {
    match teko::fs::list_dir(path) {
        []str as entries => {
            var ok: bool = true
            var i: u64 = 0
            loop {
                if i >= entries.len { break }
                if !rmtree(teko::str::concat(path, "/", entries[i])) { ok = false }
                i = i + 1
            }
            if !ok { return false }
            match teko::fs::remove_file(path) { error => false; null => true }
        }
        error => {
            match teko::fs::remove_file(path) { error => false; null => true }
        }
    }
}

/**
 * sweep_under — remove the run roots under `base` that are neither `keep` nor still locked by a live
 * process, returning how many were removed. The directory is a PARAMETER so a hermetic unit test can
 * exercise the reclaim-versus-spare logic on its own scratch tree without touching `bin/.tkrun`.
 *
 * @param base  the directory that holds the run roots
 * @param keep  the run root to preserve (this run's own)
 * @return      how many roots were removed
 * @since 0.3.1
 */
fn sweep_under(base: str, keep: str): u64 {
    var keep_id = last_segment(keep)
    var entries = match teko::fs::list_dir(base) { []str as e => e; error => teko::list::empty() }
    var removed: u64 = 0
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var name = entries[i]
        var path = teko::str::concat(base, "/", name)
        if name != keep_id && !root_is_live(path) {
            if rmtree(path) { removed = removed + 1 }
        }
        i = i + 1
    }
    removed
}

/**
 * sweep — remove the run roots under `bin/.tkrun/` that are neither `keep` nor still held by a live
 * process (§2.2).
 *
 * THE CLEANUP IS THE NEXT RUN'S, NEVER ITS OWN. A run that cleaned on exit would lose the cleanup in
 * the one case it matters (abrupt death) and lose with it the proof that it died. Sweeping on OPEN
 * has the opposite property: a `SIGKILL` leaves the root ON PURPOSE, and the next run reclaims it
 * only after it could have reported it — and only once its locker is gone.
 *
 * @param keep  the run root to preserve (this run's own)
 * @return      how many roots were removed
 * @since 0.3.1
 */
pub fn sweep(keep: str): u64 { sweep_under(TKRUN_DIR, keep) }

/**
 * close_fd_rt — the runtime symbol `tk_rt_close_fd` wraps (already bound once for
 * `teko::process`'s own pipes, `close_fd_raw`; rebinding the same existing symbol here needs no new
 * C). Kept private so every hook below goes through it the same way.
 *
 * ===== WIRING STARTS HERE (owner order, 0.3.1) ===== Everything ABOVE this point is the library —
 * correct, unit-tested, and (until this section) never called by anything but its own tests. What
 * follows are the CALL SITES: `codegen.tks`'s emitted per-`#test` C hooks (`note_test_begin`/
 * `note_test_ok`/`note_test_panicked`/`note_test_exited`, writer `s<shard>`) and the regression
 * runner's per-row hooks (`note_row_begin`/`_ok`/`_fail`/`_skip`, writer `r0` — the regression tier
 * is not itself sharded into multiple journal writers today, so one writer covers the whole tier;
 * `run_pool`'s OWN process-per-row parallelism is orthogonal and unaffected).
 *
 * EACH HOOK OPENS ITS OWN SEGMENT FD, APPENDS ONE RECORD, AND CLOSES IT — never a cached handle
 * across calls. Teko carries no top-level mutable state (grep this whole corpus for a top-level
 * `mut`: there is none), so the one "open once, reuse across many call sites" resource every OTHER
 * per-test facility in this corpus relies on (the capture channel `tk_test_begin` opens, the
 * per-task coverage sinks) lives in the C runtime's per-task fields — exactly the door this wiring
 * may not walk through (`teko_rt.c` is the frozen twin here). Opening and closing per call is the
 * honest cost of doing this in pure Teko instead: THIS function already exists for another caller's
 * pipes (`teko::process::close_fd_raw`), so binding it again here adds no new C, and it is what
 * keeps a 1000-plus-test suite from leaking a file descriptor per test.
 *
 * BEST-EFFORT, ON PURPOSE. §4's "pegajosa" failure (a journal that cannot be written fails the
 * PROCESS) is the right law for `journal::append`'s OWN unit tests, which exist to exercise that
 * exact contract. It is the wrong law for a hook riding along every `#test` and every regression row
 * in every Teko program: a full disk must not turn "the suite failed" into "the suite could not even
 * observe itself," so every hook below swallows a `journal::open`/`append` failure in silence and
 * lets the test/row run exactly as it would have before this wiring existed.
 *
 * @param fd  the descriptor a hook's own `open_seg_rt` opened
 * @return    0 on success, or the errno
 * @since 0.3.1
 */
extern fn close_fd_rt(fd: i64): i32 = "tk_rt_close_fd" from "teko_rt"

/**
 * TEST_SHARD_ENV — mirrors `teko_rt.h`'s `TK_TEST_SHARD_ENV` (`"TEKO_TEST_SHARD"`). Read here (never
 * compared to it) so the writer identity a compiled test binary's journal records carry matches the
 * shard split's OWN naming (journal J2) without a second definition of the format drifting from the
 * runtime's.
 */
const TEST_SHARD_ENV: str = "TEKO_TEST_SHARD"

/**
 * shard_index_of — the `<i>` a `TEKO_TEST_SHARD=<i>/<n>` value names, read digit-by-digit up to the
 * first `/`. Anything that is not a leading run of digits (unset, empty, malformed) answers 0 — the
 * same "no sharding" reading `tk_shard_parse` gives an unrecognised value, so an unsharded run and a
 * malformed one both write to writer `s0`.
 *
 * @param v  a `TEKO_TEST_SHARD` value (or any string; never reads past its own length)
 * @return   the shard index it names, or 0
 * @since 0.3.1
 */
fn shard_index_of(v: str): u64 {
    var i: u64 = 0
    var n: u64 = 0
    loop {
        if i >= v.len { break }
        if v[i] == b'/' { break }
        if v[i] < b'0' || v[i] > b'9' { return 0 }
        n = (n * 10) + ((v[i] to u64) - (b'0' to u64))
        i = i + 1
    }
    n
}

/**
 * test_writer — this process's writer identity for the compiled UNIT TEST binary's own journal
 * segment: `s<i>` under a parsed `TEKO_TEST_SHARD=<i>/<n>`, or `s0` for an unsharded run (a single
 * process IS shard 0 of 1, in every other sense already — E1-C6's default).
 *
 * @return the writer identity this test binary's per-test notes are stamped with
 * @since 0.3.1
 */
fn test_writer(): str {
    match teko::env::var(TEST_SHARD_ENV) {
        str as v => teko::str::concat("s", teko::str::u64_to_str(shard_index_of(v)))
        error => "s0"
    }
}

/**
 * note_open_append_close — open `writer`'s segment, append one record, close it — the shared body
 * every hook below calls, so the open/append/close discipline lives in exactly one place.
 *
 * @param writer   the writer identity (`test_writer()`, or a fixed row-tier id)
 * @param kind     the record kind
 * @param payload  the record payload
 * @since 0.3.1
 */
fn note_open_append_close(writer: str, kind: str, payload: str) {
    match open(writer) {
        Journal as j => {
            match append(j, kind, payload) { error => { }; null => { } }
            _ = close_fd_rt(j.seg)
        }
        error => { }
    }
}

/**
 * note_test_begin — called by the emitted test harness right before a `#test` body runs
 * (`codegen.tks::emit_test_channel_open`).
 *
 * @param label  the test's `namespace::name` (or bare `name`)
 * @since 0.3.1
 */
pub fn note_test_begin(label: str) { note_open_append_close(test_writer(), KIND_BEGIN, label) }

/**
 * note_test_ok — called by the emitted test harness when a `#test` returned normally
 * (`codegen.tks::emit_test_captured_call`).
 *
 * @param label  the test's `namespace::name`
 * @since 0.3.1
 */
pub fn note_test_ok(label: str) { note_open_append_close(test_writer(), KIND_OK, label) }

/**
 * note_test_panicked — called by the emitted test harness when a `#test` panicked (an explicit
 * `panic`, a failed assertion, or an implicit panic).
 *
 * @param label  the test's `namespace::name`
 * @since 0.3.1
 */
pub fn note_test_panicked(label: str) {
    note_open_append_close(test_writer(), KIND_FAIL, fail_payload(label, "panicked"))
}

/**
 * fail_payload — the `label` + `FIELD_SEP` + `reason` shape a `fail`/`skip` record's payload always
 * takes (the same shape `summary.tks::payload_label`/`payload_reason` split back apart). Factored out
 * so every hook that builds one, and every test that proves the shape, share ONE composer.
 *
 * @param label   the test/row identity
 * @param reason  the single-line reason
 * @return        `label` + a tab + `reason`
 * @since 0.3.1
 */
fn fail_payload(label: str, reason: str): str { teko::str::concat(label, FIELD_SEP, reason) }

/**
 * exited_reason — the reason text `note_test_exited` names: `"exited <code>"`.
 *
 * @param code  the value a `#test` exited with
 * @return      `"exited "` + `code`
 * @since 0.3.1
 */
fn exited_reason(code: i32): str { teko::str::concat("exited ", teko::str::i64_to_str(code to i64)) }

/**
 * note_test_exited — called by the emitted test harness when a `#test` called `exit(code)`.
 *
 * @param label  the test's `namespace::name`
 * @param code   the value the test exited with
 * @since 0.3.1
 */
pub fn note_test_exited(label: str, code: i32) {
    note_open_append_close(test_writer(), KIND_FAIL, fail_payload(label, exited_reason(code)))
}

/**
 * note_test_end — called ONCE by the emitted test harness, after every `#test` has run
 * (`codegen.tks::emit_test_main_close`): closes this shard's segment cleanly, so `fold` never
 * synthesises `incomplete` for a shard that finished — only for one that died mid-suite.
 *
 * @since 0.3.1
 */
pub fn note_test_end() { note_open_append_close(test_writer(), KIND_END, "") }

/**
 * ROW_WRITER — the writer identity every regression-row hook stamps its records with. The
 * regression tier is not itself split into multiple journal writers (unlike the unit phase's
 * `s<shard>`): `run_pool`'s process-per-row parallelism already gives each row its OWN process, and
 * every one of those processes shares this SAME writer identity by design — they are not
 * independent journal writers racing on one segment, because `journal::open`'s segment file is
 * opened, appended to, and closed within the SAME single call in each hook below (`note_row_*`),
 * never held across the fork. Two rows' notes interleave at the granularity of one already-atomic
 * `write(2)` each (§5), the same guarantee `append` states for any writer.
 */
const ROW_WRITER: str = "r0"

/**
 * note_row_begin — a regression row is about to run.
 *
 * @param label  the row's identity (`<file>.tkr[<scenario> row <n>]`)
 * @since 0.3.1
 */
pub fn note_row_begin(label: str) { note_open_append_close(ROW_WRITER, KIND_BEGIN, label) }

/**
 * note_row_ok — a regression row passed.
 *
 * @param label  the row's identity
 * @since 0.3.1
 */
pub fn note_row_ok(label: str) { note_open_append_close(ROW_WRITER, KIND_OK, label) }

/**
 * note_row_fail — a regression row failed.
 *
 * @param label   the row's identity
 * @param reason  why it failed, single-line
 * @since 0.3.1
 */
pub fn note_row_fail(label: str, reason: str) {
    note_open_append_close(ROW_WRITER, KIND_FAIL, fail_payload(label, reason))
}

/**
 * note_row_skip — a regression row was skipped (a missing tool, `REGRESSION_REQUIRE_TOOLS`'s
 * fail-open reading).
 *
 * @param label   the row's identity
 * @param reason  why it was skipped, single-line
 * @since 0.3.1
 */
pub fn note_row_skip(label: str, reason: str) {
    note_open_append_close(ROW_WRITER, KIND_SKIP, fail_payload(label, reason))
}

/**
 * note_row_end — called ONCE by the regression driver after every row has run: closes the `r0`
 * segment cleanly, mirroring `note_test_end`'s reason exactly (`fold` must not call a finished
 * regression tier `incomplete`).
 *
 * @since 0.3.1
 */
pub fn note_row_end() { note_open_append_close(ROW_WRITER, KIND_END, "") }
