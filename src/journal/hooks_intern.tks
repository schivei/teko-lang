/**
 * teko::journal::hooks — the emitted test-harness and regression-driver call sites
 * (note_test_*/note_row_*), split out of journal.tks (mechanical file-size split; no logic
 * changes).
 *
 * @since 0.3.1
 */


/**
 * TEST_SHARD_ENV — mirrors `teko_rt.h`'s `TK_TEST_SHARD_ENV` (`"TEKO_TEST_SHARD"`). Read here (never
 * compared to it) so the writer identity a compiled test binary's journal records carry matches the
 * shard split's OWN naming (journal J2) without a second definition of the format drifting from the
 * runtime's.
 */
const TEST_SHARD_ENV: str = "TEKO_TEST_SHARD"

/**
 * shard_index_of — the `<i>` a `TEKO_TEST_SHARD=<i>/<n>` value names, read digit-by-digit up to the
 * first `/`. Anything that is not a leading run of digits (unset, empty, malformed) answers 0 — the
 * same "no sharding" reading `tk_shard_parse` gives an unrecognised value, so an unsharded run and a
 * malformed one both write to writer `s0`.
 *
 * @param v  a `TEKO_TEST_SHARD` value (or any string; never reads past its own length)
 * @return   the shard index it names, or 0
 * @since 0.3.1
 */
fn shard_index_of(v: str) -> u64 {
    mut i: u64 = 0
    mut n: u64 = 0
    loop {
        if i >= v.len { break }
        if v[i] == b'/' { break }
        if v[i] < b'0' || v[i] > b'9' { return 0 }
        n = (n * 10) + ((v[i] to u64) - (b'0' to u64))
        i = i + 1
    }
    n
}

/**
 * test_writer — this process's writer identity for the compiled UNIT TEST binary's own journal
 * segment: `s<i>` under a parsed `TEKO_TEST_SHARD=<i>/<n>`, or `s0` for an unsharded run (a single
 * process IS shard 0 of 1, in every other sense already — E1-C6's default).
 *
 * @return the writer identity this test binary's per-test notes are stamped with
 * @since 0.3.1
 */
fn test_writer() -> str {
    match teko::env::var(TEST_SHARD_ENV) {
        str as v => teko::str::concat("s", teko::str::u64_to_str(shard_index_of(v)))
        error => "s0"
    }
}

/**
 * note_open_append_close — open `writer`'s segment, append one record, close it — the shared body
 * every hook below calls, so the open/append/close discipline lives in exactly one place.
 *
 * @param writer   the writer identity (`test_writer()`, or a fixed row-tier id)
 * @param kind     the record kind
 * @param payload  the record payload
 * @since 0.3.1
 */
fn note_open_append_close(writer: str, kind: str, payload: str) {
    match open(writer) {
        Journal as j => {
            match append(j, kind, payload) { error => { }; null => { } }
            _ = close_fd_rt(j.seg)
        }
        error => { }
    }
}

/**
 * fail_payload — the `label` + `FIELD_SEP` + `reason` shape a `fail`/`skip` record's payload always
 * takes (the same shape `summary.tks::payload_label`/`payload_reason` split back apart). Factored out
 * so every hook that builds one, and every test that proves the shape, share ONE composer.
 *
 * @param label   the test/row identity
 * @param reason  the single-line reason
 * @return        `label` + a tab + `reason`
 * @since 0.3.1
 */
fn fail_payload(label: str, reason: str) -> str { teko::str::concat(label, FIELD_SEP, reason) }

/**
 * exited_reason — the reason text `note_test_exited` names: `"exited <code>"`.
 *
 * @param code  the value a `#test` exited with
 * @return      `"exited "` + `code`
 * @since 0.3.1
 */
fn exited_reason(code: i32) -> str { teko::str::concat("exited ", teko::str::i64_to_str(code to i64)) }

/**
 * ROW_WRITER — the writer identity every regression-row hook stamps its records with. The
 * regression tier is not itself split into multiple journal writers (unlike the unit phase's
 * `s<shard>`): `run_pool`'s process-per-row parallelism already gives each row its OWN process, and
 * every one of those processes shares this SAME writer identity by design — they are not
 * independent journal writers racing on one segment, because `journal::open`'s segment file is
 * opened, appended to, and closed within the SAME single call in each hook below (`note_row_*`),
 * never held across the fork. Two rows' notes interleave at the granularity of one already-atomic
 * `write(2)` each (§5), the same guarantee `append` states for any writer.
 */
const ROW_WRITER: str = "r0"
