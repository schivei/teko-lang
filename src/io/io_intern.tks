
/**
 * append_file_raw — the runtime symbol `append_file` wraps: 0 on success, `APPEND_FAILED` when the
 * file could not be opened or the bytes could not all be written. Kept private so every caller goes
 * through the typed wrapper.
 *
 * A SCALAR RETURN AND NOT `error | null`, which is a compiler constraint and not a preference — the
 * very one `read_line`/`read_stdin` above record: a brand-new `error`-shaped `extern fn` needs a
 * per-name lift in codegen (`emit_host_ffi`) that the RELEASED bootstrap seed's frozen codegen
 * cannot learn post-release. The plain Teko wrapper below restores the `error | null` surface at no
 * ABI cost.
 *
 * @param path     the file to append to; created when absent
 * @param content  the bytes to append, exactly as given (no newline is added)
 * @return         0 on success, `APPEND_FAILED` on failure
 */
extern fn append_file_raw(path: str, content: str) -> i32 = "tk_rt_append_file" from "teko_rt"

/**
 * APPEND_FAILED — `TK_RT_APPEND_FAILED` (src/runtime/teko_rt.h) at the Teko level.
 */
const APPEND_FAILED: i32 = -1
