/** FileReader — a one-shot `Reader` over a whole file: the first `read` slurps `path` and yields
 * it as one Buf, every later `read` yields EOF. */
exp type FileReader = class & Reader {
    /** The path read on the first pull. */
    pub path: str
    /** Whether the file's contents have already been handed out. */
    pub delivered: bool

    /** of — a file reader over `path`. */
    pub static fn of(path: str): FileReader { FileReader { path = path; delivered = false } }

    /** read — on the first call, slurp the whole file; on every later call, yield EOF.
     * @return the file bytes on the first call, then the empty chunk, or the read error. */
    pub fn read(max: u64): Buf | error {
        if self.delivered { return Buf::empty() }
        self.delivered = true
        match read_file(self.path) {
            str as s => Buf::from_str(s)
            error as e => e
        }
    }
}

/** file_flush — commit a `MemWriter`'s accumulated bytes to `path`.
 * @return null on success, or the write error. */
exp fn file_flush(path: str, sink: MemWriter): error | null {
    write_file_bytes(path, sink.content().bytes())
}
