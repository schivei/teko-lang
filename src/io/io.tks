/** teko::io::read_file — read `path` as UTF-8 text.
 * @return the file contents, or an error on failure. */
exp extern fn read_file(path: str): str | error = "tk_rt_read_file" from "teko_rt"

/** teko::io::read_line — read one line from stdin (newline stripped); "" at EOF (check
 * stdin_eof() to distinguish from a genuine blank line). */
exp extern fn read_line(): str = "tk_rt_read_line" from "teko_rt"

/** teko::io::stdin_eof — whether the last read_line() call hit end of input. */
exp extern fn stdin_eof(): bool = "tk_rt_stdin_eof" from "teko_rt"

/** teko::io::read_stdin — read all of stdin until EOF. */
exp extern fn read_stdin(): str = "tk_rt_read_stdin" from "teko_rt"

/** teko::io::write_file — (over)write `path` with `content`.
 * @return null on success, or the failure. */
exp extern fn write_file(path: str, content: str): error | null = "tk_rt_write_file" from "teko_rt"

extern fn append_file_raw(path: str, content: str): i32 = "tk_rt_append_file" from "teko_rt"

const APPEND_FAILED: i32 = -1

/** teko::io::append_file — append `content` to the file at `path`, creating it when absent.
 * @return null on success, or the failure. */
exp fn append_file(path: str, content: str): error | null {
    if append_file_raw(path, content) == APPEND_FAILED {
        return error { message = "teko::io::append_file: could not append to the file" }
    }
    null
}

/** teko::io::write_file_bytes — write raw bytes to `path`. */
exp extern fn write_file_bytes(path: str, data: []byte): error | null = "tk_rt_write_file_bytes" from "teko_rt"

/** teko::io::write — write `s` to stdout verbatim (no newline). */
exp extern fn write(s: str) = "tk_write" from "teko_rt"

/** teko::io::ewrite — write `s` to stderr verbatim (no newline). */
exp extern fn ewrite(s: str) = "tk_ewrite" from "teko_rt"

/** teko::io::print — write `s` to stdout. */
exp extern fn print(s: str) = "tk_print" from "teko_rt"

/** teko::io::println — write `s` to stdout followed by a newline. */
exp extern fn println(s: str) = "tk_println" from "teko_rt"

/** teko::io::eprint — write `s` to stderr. */
exp extern fn eprint(s: str) = "tk_eprint" from "teko_rt"

/** teko::io::eprintln — write `s` to stderr followed by a newline. */
exp extern fn eprintln(s: str) = "tk_eprintln" from "teko_rt"

/** teko::io::flush — flush buffered stdout to the OS. */
exp extern fn flush() = "tk_flush_out" from "teko_rt"
