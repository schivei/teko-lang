use teko::checker

/**
 * unmark_test_function — `f` with `is_test` cleared, every other field copied verbatim. The ONE
 * field this whole file ever flips post-check — see `native_gate_unmark_tests`'s own doc for why.
 *
 * @param f  the checked `#test` function
 * @return   `f`, `is_test = false`
 * @since 0.3.1.0 (tests-native-no-c)
 */
fn unmark_test_function(f: checker::TFunction) -> checker::TFunction {
    checker::TFunction { name = f.name; type_params = f.type_params; type_constraints = f.type_constraints; params = f.params; return_type = f.return_type; body = f.body; vis = f.vis; has_doc = f.has_doc; doc = f.doc; namespace = f.namespace; file = f.file; line = f.line; col = f.col; is_test = false; is_extern = f.is_extern; c_symbol = f.c_symbol; from_lib = f.from_lib; has_arena_size = f.has_arena_size; arena_size = f.arena_size }
}

//
// native_gate_unmark_tests — `prog` with every `#test` function's `is_test` flag CLEARED (all other
// fields, and every non-function item, untouched) — the ONE signal the own-AOT-backend's per-item
// lowering (`lower_item_function`, `src/lir/lower.tks`) reads to decide whether a function's body is
// "part of the emitted program": `if f.is_test { skip }`, by design, so an ordinary
// `TEKO_BACKEND=native` PRODUCTION build never bloats its binary with test code once tests are
//
