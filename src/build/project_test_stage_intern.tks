// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

            checker::TFunction as f => {
                if f.is_test {
                    let path = $"{adir}/{i}.tkcov"
                    let data = match teko::io::read_file(path) { str as s => s; error => "" }
                    let stats = checker::test_assert_stats(f)
                    recs = teko::list::push(recs, TestRecord { label = test_label(f); ids = tkcov_ids(data); asserts_total = stats.total; asserts_folded = stats.folded })
                }
            }
            _ => { }
        }
        i++
    }
    recs
}

/**
 * run_analyzer — the `teko test . --analyzer` body (0.3.0.29): compile the ANALYZE-mode test gate
 * ONCE, run it ONCE (each `#test` writes its own `<idx>.tkcov` under the scratch dir), then decode
 * every per-test id set and print the stale/redundant/live report. One compile + one run answers the
 * whole-suite question — no per-test recompile. Dev-time only, advisory: it prints and returns 0
 * (a passing gate already ran first); it never fails the build on a verdict.
 *
 * @param dir  the project directory (diagnostics)
 * @param fe   the already-assembled front-end product (checked program + manifest)
 * @return     0 on success, else the failing status (emit/cc/run error)
 * @since 0.3.0.29
 */
fn run_analyzer(dir: str, fe: Frontend) -> i32 {
    let od = strip_trailing_slash("bin")
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the analyzer output directory"); null => { } }
    let stem = teko::str::concat(fe.manifest.name, "-tkanalyze")
    let cfile = teko::str::concat(od, "/", stem, ".c")
    let binp = binary_output_path(od, stem, resolved_target())
    let emitted = match codegen::tk_emit_c_test_analyze(fe.prog) { str as s => s; error as e => return fail(dir, e.message) }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(fe.manifest.name, fe.manifest.version, fe.manifest.suffix, fe.manifest.description))
    match teko::io::write_file(cfile, csrc) { error as e => return fail(dir, e.message); null => { } }
    if run_cc(cfile, binp, fe.manifest, fe.prog, 0) != 0 { return fail(dir, "cc failed to build the analyzer test gate") }
    let adir = teko::str::concat(od, "/analyze")
    match teko::fs::mkdir(adir) { error => return fail(dir, "cannot create the analyzer scratch directory"); null => { } }
    match teko::env::set_var("TEKO_ANALYZE_DIR", adir) { error => { }; null => { } }
    let arc = teko::process::run(teko::list::push(teko::list::empty(), binp))
    if arc != 0 { return arc }
    teko::io::print(analyzer_report(analyze_records_of(fe.prog, adir)))
    0
}

/**
 * arith_cast_rate_line — the printed report line: `arith-cast-rate: <with>/<total> (<pct>%),
 * ceiling <=2.00%`.
 *
 * @param r  the accumulated report
 * @return   the formatted report line (no trailing newline)
 */
fn arith_cast_rate_line(r: checker::ArithCastRateReport) -> str {
    let pct = checker::arith_cast_rate_pct(r)
    let ceiling = checker::ARITH_CAST_RATE_CEILING
    $"teko: arith-cast-rate: {r.with_conversion}/{r.total} ({pct:F2}%), ceiling <={ceiling:F2}%"
}

/**
 * run_arith_cast_gate — the `teko test . --arith-cast-gate` body (D4/C5,
 * `cast-width-hygiene-0.3.1.md` §5): compute the ARITH-CAST-RATE over the ALREADY-TYPED
 * program (`fe.prog` — no recompile, no run needed, unlike `--analyzer`) and fail the build
 * when it exceeds the ratified ≤2% ceiling. A passing `.tkt` gate already ran before this is
 * reached, so a program with zero arithmetic/assignment expressions gates vacuously green.
 *
 * @param dir  the project directory (diagnostics)
 * @param fe   the already-assembled front-end product (checked program + manifest)
 * @return     0 when the rate is at or under 2%, else 1 (the CI-facing failure)
 * @since 0.3.1 (C5)
 */
fn run_arith_cast_gate(dir: str, fe: Frontend) -> i32 {
    arith_cast_verdict(report_arith_cast_rate(fe))
}

/**
 * report_arith_cast_rate — compute the ARITH-CAST-RATE and PRINT it, with no verdict attached.
 *
 * Split out from `run_arith_cast_gate` so the number can be reported EARLY — right after the
 * front end, before the test gate — while the pass/fail verdict stays at the end of
 * `test_project`. The reason is that the two belong at different points in the run and used to
 * be welded at the wrong one:
 *
 * - the METRIC is a property of the typed SOURCE (`fe.prog`). It needs no test to have passed and
 *   no binary to have been produced. Reporting it behind the test gate meant it only ever spoke
 *   when everything else was already green — precisely when it is least needed. On a tree whose
 *   suite is red (wagon 20, `fat-pointer receiver call` / N2) it would never have printed at all,
 *   which is how a gate ships and delivers nothing.
 * - the VERDICT must NOT come first, and that is the other half of the split: failing early on a
 *   cast-rate ceiling would return before the test gate ran and hide every test failure behind a
 *   style metric. A gate that masks defects is worse than one that runs late.
 *
 * @param fe  the already-assembled front-end product (checked program + manifest)
 * @return    the accumulated report, already printed
 * @since 0.3.1 (C5); split 2026-07-27
 */
fn report_arith_cast_rate(fe: Frontend) -> checker::ArithCastRateReport {
    let r = checker::arith_cast_rate_report(fe.prog)
    teko::io::println(arith_cast_rate_line(r))
    r
}

/**
 * arith_cast_verdict — the D4 pass/fail on an ALREADY-COMPUTED report (nothing is re-walked and
 * nothing is re-printed; `report_arith_cast_rate` did both).
 *
 * @param r  the report computed earlier in the run
 * @return   0 when the rate is at or under the ceiling, else 1 (the CI-facing failure)
 * @since 0.3.1 (C5); split 2026-07-27
 */
fn arith_cast_verdict(r: checker::ArithCastRateReport) -> i32 {
    if checker::arith_cast_rate_gate_ok(r) { return 0 }
    let ceiling = checker::ARITH_CAST_RATE_CEILING
    teko::io::eprintln($"teko: arith-cast-rate gate FAILED — the D4 ceiling (<={ceiling:F2}%) was exceeded")
    1
}

/**
 * One test's coverage attribution: the label of the `#test` and the percentage of the WHOLE
 * production surface (functions / lines / branches) that this single test exercised on its own.
 * Emitted one row per test by `--per-test-cov` (owner ruling 0.3.0.29 — the T2 lever): a dev-time
 * tool to prove which tests are redundant or subsumed by another.
 */
type PerTestCoverage = struct {
    /**
     * The test's label — `namespace::name`, or the bare `name` when the test has no namespace.
     */
    label: str
    /**
     * The percentage of production functions this test alone executed (against the whole surface).
     */
    functions: u64
    /**
     * The percentage of production executable lines this test alone hit (against the whole surface).
     */
    lines: u64
    /**
     * The percentage of production branch outcomes this test alone took (against the whole surface).
     */
    branches: u64
}

/**
 * The label of a `#test` function — `namespace::name`, or the bare `name` when it has no namespace.
 * Matches the label the native gate prints for the test (`emit_test_call`), so a per-test row is
 * traceable to its `test <label> ... ok` line.
 *
 * @param f  the `#test` function
 * @return   the human label used in the per-test report
 */
fn test_label(f: checker::TFunction) -> str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

/**
 * Format ONE per-test attribution row as a single stable, machine-parseable line (no trailing
 * newline). The shape is `per-test-cov <label> functions=<f>% lines=<l>% branches=<b>%` — the
 * fields the T2 investigation greps to rank tests by marginal coverage.
 *
 * @param r  the per-test coverage row
 * @return   the formatted line (no trailing newline)
 */
fn per_test_cov_row_str(r: PerTestCoverage) -> str {
    $"per-test-cov {r.label} functions={r.functions}% lines={r.lines}% branches={r.branches}%"
}

/**
 * Format the full per-test attribution report: a fixed header line followed by one
 * `per_test_cov_row_str` line per test, each newline-terminated. The header is
 * `teko: per-test coverage attribution`; an empty `rows` yields the header alone.
 *
 * @param rows  the per-test coverage rows, in test order
 * @return      the complete report text (header + one line per row), newline-terminated throughout
 */
fn per_test_cov_report_str(rows: []PerTestCoverage) -> str {
    mut out = teko::str::concat("teko: per-test coverage attribution", "\n")
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        out = teko::str::concat(out, per_test_cov_row_str(rows[i]), "\n")
        i = i + 1
    }
    out
}

/**
 * The program reduced to its production items plus EXACTLY ONE `#test` (the one at `keep_idx`): every
 * non-test item is kept in order, every OTHER `#test` is dropped. Emitting + measuring this program
 * attributes the run's coverage to that single test. The kept test's own body is excluded from the
 * production coverage surface exactly as `line_coverage`/`branch_coverage` already exclude `#test`
 * functions, so the reported percentages measure only PRODUCTION code the test reached.
 *
 * @param prog      the full checked program (production items + every `#test`)
 * @param keep_idx  the `prog.items` index of the single `#test` to retain
 * @return          the program with only production items and the one kept test
 */
fn keep_single_test(prog: checker::TProgram, keep_idx: u64) -> checker::TProgram {
    mut kept: []checker::TItem = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        mut drop = false
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test && i != keep_idx { drop = true } }
            _ => { }
        }
        if !drop { kept = teko::list::push(kept, prog.items[i]) }
        i = i + 1
    }
    checker::TProgram { items = kept }
}

/**
 * Emit, compile and RUN the coverage-instrumented test binary for `filtered` (a single-test program
 * from `keep_single_test`), then attribute its coverage to THIS process's sinks: reset the three
 * sinks, then merge the child's dumped `.tkcov`. On return the in-process coverage sinks hold ONLY
 * this test's marks, so `coverage::*_pct(filtered)` reads its per-test attribution. Reuses the same
 * native-gate machinery (`codegen::tk_emit_c_test` + `run_cc` + `teko::process::run` + `cov_merge`)
 * as the aggregate gate; the only difference is the single-test program and the pre-merge reset.
 *
 * @param dir       the project directory (for diagnostics)
 * @param out_dir   the scratch output directory (the per-test TU + binary + `.tkcov` land here)
 * @param filtered  the single-test program to instrument (production items + one `#test`)
 * @param m         the resolved manifest (name/version drive the emitted metadata)
 * @param stem      the output artifact stem (shared across tests — each run overwrites the scratch)
 * @return          0 on success (sinks now hold this test's coverage), else the failing status
 * @throws          when the scratch dir/emit/cc fails, or the child test process exits non-zero
 */
fn run_one_test_cov(dir: str, out_dir: str, filtered: checker::TProgram, m: Manifest, stem: str) -> i32 {
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let cfile = teko::str::concat(od, "/", stem, ".c")
    let binp = binary_output_path(od, stem, resolved_target())
    let covfile = teko::str::concat(od, "/", stem, ".tkcov")
    let emitted = match codegen::tk_emit_c_test(filtered, true) { str as s => s; error as e => return fail(dir, e.message) }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    match teko::io::write_file(cfile, csrc) { error as e => return fail(dir, e.message); null => { } }
    if run_cc(cfile, binp, m, filtered, 0) != 0 { return fail(dir, "cc failed to build the per-test coverage gate") }
    match teko::env::set_var("TEKO_TKCOV", covfile) { error => { }; null => { } }
    let argv = teko::list::push(teko::list::empty(), binp)
    let trc = teko::process::run(argv)
    if trc != 0 { return trc }
    teko::cov_reset()
    teko::cov_branch_reset()
    teko::cov_line_reset()
    coverage::cov_merge(covfile)
    0
}
