/**
 * cross_note_for_name — `cross_note` keyed by a target NAME (a `TEKO_TARGET` value or a regressor's
 * `Given target`), so the regression runner's honest run-skip and the build's own emitted-not-run
 * note read the SAME rule instead of each carrying its own idea of what "cross" means (D39). An
 * unrecognized name is not cross here: its honest R2 stop belongs to `emit_native`.
 *
 * @param name  the target name ("" → the host default, i.e. never cross)
 * @return      the cross classification for that name
 * @since 0.3.1
 */
fn cross_note_for_name(name: str) -> CrossNote {
    if name.len == 0 { return CrossNote { is_cross = false; note = "" } }
    match target_from_name(name) { NativeTarget as t => cross_note(t); error => CrossNote { is_cross = false; note = "" } }
}

//
// resolved_cross_note — `cross_note` for the target THIS build resolved (`resolved_target`), the
// form the build's run steps consult: `teko run`'s execute step and the native test gate's run
// both print `note` and skip the child process when `is_cross`, so a cross build reports
// "emitted, not executed" instead of failing on an artifact this host cannot exec.
//
//
