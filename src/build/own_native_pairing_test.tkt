const ONP_MAIN: str = "examples/regressions/own_native/main.tks"

const ONP_TKR: str = "examples/regressions/own_native/own_native.tkr"

const ONP_CALL: str = "scenario(\""

const ONP_CALL_OK: str = "scenario_named_ok(\""

const ONP_CALL_TRUE: str = "scenario_true(\""

const ONP_ROW: str = "Then stdout pattern = \"scenario "

#test
fn onp_the_driver_and_the_tkr_name_the_same_cases() {
    var driver = onp_driver_names()
    var rows = onp_row_names()
    teko::assert::len_eq(driver.len, rows.len)
    onp_assert_every_name_present(driver, rows, "the .tkr")
    onp_assert_every_name_present(rows, driver, "main.tks")
}

#test
fn onp_no_case_is_named_twice() {
    onp_assert_no_duplicates(onp_driver_names(), "main.tks")
    onp_assert_no_duplicates(onp_row_names(), "the .tkr")
}

#test
fn onp_no_name_is_a_suffix_of_another_without_the_prefix() {
    var names = onp_driver_names()
    teko::assert::is_true(onp_has_suffix_pair(names))
}

fn onp_driver_names(): []str {
    var text = onp_read(ONP_MAIN)
    var a = onp_names_after(text, ONP_CALL)
    a = onp_concat(a, onp_names_after(text, ONP_CALL_OK))
    onp_concat(a, onp_names_after(text, ONP_CALL_TRUE))
}

fn onp_row_names(): []str {
    onp_names_after(onp_read(ONP_TKR), ONP_ROW)
}

fn onp_read(path: str): str {
    match teko::io::read_file(path) {
        str as s => s
        error => { teko::assert::is_present(path, false); "" }
    }
}

fn onp_names_after(text: str, marker: str): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i + marker.len > text.len { break }
        if teko::str::slice(text, i, i + marker.len) != marker { i = i + 1; continue }
        var from = i + marker.len
        var to = onp_name_end(text, from)
        out = teko::list::push(out, teko::str::slice(text, from, to))
        i = to
    }
    out
}

fn onp_name_end(text: str, from: u64): u64 {
    var j = from
    loop {
        if j >= text.len { break }
        if text[j] == b'"' { break }
        if text[j] == b':' { break }
        j = j + 1
    }
    j
}

fn onp_concat(a: []str, b: []str): []str {
    var out = a
    var i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}

fn onp_contains(names: []str, want: str): bool {
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        if names[i] == want { return true }
        i = i + 1
    }
    false
}

fn onp_assert_every_name_present(have: []str, want: []str, side: str) {
    var i: u64 = 0
    loop {
        if i >= have.len { break }
        teko::assert::is_present(teko::str::concat(have[i], " in ", side), onp_contains(want, have[i]))
        i = i + 1
    }
}

fn onp_assert_no_duplicates(names: []str, side: str) {
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        teko::assert::is_present(teko::str::concat(names[i], " exactly once in ", side), onp_count_of(names, names[i]) == 1)
        i = i + 1
    }
}

fn onp_count_of(names: []str, want: str): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        if names[i] == want { n = n + 1 }
        i = i + 1
    }
    n
}

fn onp_has_suffix_pair(names: []str): bool {
    var i: u64 = 0
    loop {
        if i >= names.len { break }
        var j: u64 = 0
        loop {
            if j >= names.len { break }
            if i != j && names[i] != names[j] && teko::str::ends_with(names[i], names[j]) { return true }
            j = j + 1
        }
        i = i + 1
    }
    false
}
