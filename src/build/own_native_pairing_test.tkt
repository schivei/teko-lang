/**
 * ONP_MAIN — the own-backend corpus's driver, read from the repository root (which is where the test
 * gate runs).
 */
const ONP_MAIN: str = "examples/regressions/own_native/main.tks"

/** ONP_TKR — the `.tkr` whose rows must name exactly the cases `ONP_MAIN` announces. */
const ONP_TKR: str = "examples/regressions/own_native/own_native.tkr"

/** ONP_CALL — how a case announces itself in the driver. */
const ONP_CALL: str = "scenario(\""

/** ONP_CALL_OK — the driver's other announcement form, for a case whose claim is not a return value. */
const ONP_CALL_OK: str = "scenario_named_ok(\""

/** ONP_ROW — how a `.tkr` row demands one case's announcement. */
const ONP_ROW: str = "Then stdout pattern = \"scenario "

/**
 * onp_the_driver_and_the_tkr_name_the_same_cases — the migration's own safety property.
 *
 * The corpus used to address its 129 cases by the number `main.tks` exited with; both files now
 * address them by NAME. A name that existed on only ONE side would trade one silent defect for
 * another: a driver case with no row is a case nothing asserts (the hole 41 of them were already in),
 * and a row with no driver case is a row that can never be satisfied. So the two sets must be EQUAL,
 * and this test is what keeps them moving together.
 */
#test
fn onp_the_driver_and_the_tkr_name_the_same_cases() {
    let driver = onp_driver_names()
    let rows = onp_row_names()
    teko::assert::len_eq(driver.len, rows.len)
    onp_assert_every_name_present(driver, rows, "the .tkr")
    onp_assert_every_name_present(rows, driver, "main.tks")
}

/**
 * onp_no_case_is_named_twice — a duplicated name on either side makes one row assert another case's
 * line, which is the aliasing the exit-code mechanism was thrown out for.
 */
#test
fn onp_no_case_is_named_twice() {
    onp_assert_no_duplicates(onp_driver_names(), "main.tks")
    onp_assert_no_duplicates(onp_row_names(), "the .tkr")
}

/**
 * onp_no_name_is_a_suffix_of_another_without_the_prefix — WHY the announcement opens with the fixed
 * word `scenario `.
 *
 * `Then stdout pattern` SEARCHES the captured stdout, so a row demanding `loop_tail_no_break: ok`
 * would be satisfied by `fat_loop_tail_no_break: ok` — measured, those two names are really in this
 * corpus. The fixed prefix removes the aliasing because it must sit immediately before the full name.
 * This test pins that a suffix pair EXISTS, so nobody deletes the prefix believing it decorative.
 */
#test
fn onp_no_name_is_a_suffix_of_another_without_the_prefix() {
    let names = onp_driver_names()
    teko::assert::is_true(onp_has_suffix_pair(names))
}

/**
 * onp_driver_names — every case name `main.tks` announces, in file order.
 *
 * @return the announced names
 */
fn onp_driver_names() -> []str {
    let text = onp_read(ONP_MAIN)
    let a = onp_names_after(text, ONP_CALL)
    onp_concat(a, onp_names_after(text, ONP_CALL_OK))
}

/**
 * onp_row_names — every case name the `.tkr` demands an announcement for, in file order.
 *
 * @return the demanded names
 */
fn onp_row_names() -> []str {
    onp_names_after(onp_read(ONP_TKR), ONP_ROW)
}

/**
 * onp_read — a repository file's whole text, failing loud when it is missing: a pairing test that
 * silently read "" would report two empty sets as equal.
 *
 * @param path  the path, relative to the repository root
 * @return      the file's text
 * @throws      when the file cannot be read
 */
fn onp_read(path: str) -> str {
    match teko::io::read_file(path) {
        str as s => s
        error => { teko::assert::is_present(path, false); "" }
    }
}

/**
 * onp_names_after — every quoted-or-colon-terminated name that follows an occurrence of `marker`.
 *
 * The name runs from just past the marker to the next `"` (the driver's call form) or `:` (the row's
 * pattern form), whichever comes first, so ONE scanner serves both spellings.
 *
 * @param text    the file text to scan
 * @param marker  the opening the name follows
 * @return        the names, in the order they occur
 */
fn onp_names_after(text: str, marker: str) -> []str {
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i + marker.len > text.len { break }
        if teko::str::slice(text, i, i + marker.len) != marker { i = i + 1; continue }
        let from = i + marker.len
        let to = onp_name_end(text, from)
        out = teko::list::push(out, teko::str::slice(text, from, to))
        i = to
    }
    out
}

/**
 * onp_name_end — the first index at or after `from` holding a `"` or a `:`, i.e. one past the last
 * byte of a name. The text's own length bounds it, so a truncated file cannot run the scan away.
 *
 * @param text  the text being scanned
 * @param from  where the name starts
 * @return      the exclusive end index
 */
fn onp_name_end(text: str, from: u64) -> u64 {
    mut j = from
    loop {
        if j >= text.len { break }
        if text[j] == b'"' { break }
        if text[j] == b':' { break }
        j = j + 1
    }
    j
}

/**
 * onp_concat — `b`'s items appended to `a`.
 *
 * @param a  the first list
 * @param b  the list appended to it
 * @return   the joined list
 */
fn onp_concat(a: []str, b: []str) -> []str {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}

/**
 * onp_contains — whether `names` holds `want`.
 *
 * @param names  the list searched
 * @param want   the name looked for
 * @return       true iff it is there
 */
fn onp_contains(names: []str, want: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        if names[i] == want { return true }
        i = i + 1
    }
    false
}

/**
 * onp_assert_every_name_present — every name of `have` must also be in `want`, and the failure names
 * the missing case and the side it is missing from, so a reader goes straight to the file to edit.
 *
 * @param have  the names that exist
 * @param want  the names they must all appear among
 * @param side  what `want` is, for the failure message
 */
fn onp_assert_every_name_present(have: []str, want: []str, side: str) {
    mut i: u64 = 0
    loop {
        if i >= have.len { break }
        teko::assert::is_present(teko::str::concat(have[i], " in ", side), onp_contains(want, have[i]))
        i = i + 1
    }
}

/**
 * onp_assert_no_duplicates — no name may occur twice in `names`.
 *
 * @param names  the names to check
 * @param side   which file they came from, for the failure message
 */
fn onp_assert_no_duplicates(names: []str, side: str) {
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        teko::assert::is_present(teko::str::concat(names[i], " exactly once in ", side), onp_count_of(names, names[i]) == 1)
        i = i + 1
    }
}

/**
 * onp_count_of — how many times `want` occurs in `names`.
 *
 * @param names  the list searched
 * @param want   the name counted
 * @return       its occurrence count
 */
fn onp_count_of(names: []str, want: str) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        if names[i] == want { n = n + 1 }
        i = i + 1
    }
    n
}

/**
 * onp_has_suffix_pair — whether some name in `names` ENDS WITH another (different) name, which is the
 * condition that makes an unprefixed announcement ambiguous under a searching pattern.
 *
 * @param names  the names to inspect
 * @return       true iff such a pair exists
 */
fn onp_has_suffix_pair(names: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        mut j: u64 = 0
        loop {
            if j >= names.len { break }
            if i != j && names[i] != names[j] && teko::str::ends_with(names[i], names[j]) { return true }
            j = j + 1
        }
        i = i + 1
    }
    false
}
