use teko::lir

/**
 * encode_lfuncs_in_region_arm64 — encode a LIST of `LFunc` (an item's own top-level function plus
 * its newly lifted closures/thunks) inside the scratch region the caller has already entered, each
 * one through `encode_lfunc_in_region_arm64` (isel → regalloc → encode). The arm64 twin of
 * `encode_lfuncs_in_region_x86`. The fused native lowering driver calls this BEFORE
 * `region_leave()`; every returned `EncodedFunc`'s `str` fields may still reference this region's
 * memory — the caller commits through `fold_encoded_funcs_arm64` (which copies) AFTER leaving,
 * before the region drops.
 *
 * @param fs  the item's lowered functions, in emission order
 * @return    one `EncodedFunc` per function, or the first propagated honest-stop
 * @since 0.3.1 C6.4
 */
pub fn encode_lfuncs_in_region_arm64(fs: []teko::lir::LFunc) -> []teko::backend::EncodedFunc | error {
    mut out: []teko::backend::EncodedFunc = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= fs.len { break }
        let ef = match encode_lfunc_in_region_arm64(fs[i]) { teko::backend::EncodedFunc as x => x; error as e => return e }
        out = teko::list::push(out, ef)
        i++
    }
    out
}

//
// fold_encoded_funcs_arm64 — fold a LIST of already-encoded arm64 functions into the root-resident
// `__text` accumulator `mt`, copying each one to the current region first (E1, extended;
// `copy_encoded_func_to_current_region_arm64`) so the fold's appends never retain a `str` pointing
// into a region the caller is about to drop. The arm64 twin of `fold_encoded_funcs_x86`. Called
//
