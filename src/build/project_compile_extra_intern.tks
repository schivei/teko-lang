/**
 * ns_delta_str — the raw-nanoseconds label (e.g. `"120000000ns"`) for the monotonic-ns window
 * `[start_ns, end_ns]`, for the per-item native-lowering trace's trailing ` | Nns`. Reports the FULL
 * nanosecond delta with NO truncation: a whole-millisecond unit (the prior `ms`) collapsed every
 * sub-millisecond item to `0ms`, hiding exactly the fast-vs-slow spread the trace exists to expose —
 * nanoseconds keep every item's true cost visible (finer than microseconds, which would still zero a
 * sub-µs item). The delta is non-negative (monotonic origin).
 *
 * @param start_ns  the reading taken just before the item's lowering-and-encode window
 * @param end_ns    the reading taken just after that window committed
 * @return          the `"<ns>ns"` label
 * @since 0.3.1 native-lowering-timing
 */
fn ns_delta_str(start_ns: i64, end_ns: i64) -> str {
    teko::str::concat(teko::i64_to_str(end_ns - start_ns), "ns")
}

//
// trace_native_item — OPEN the per-item native-lowering trace line for `it` (its 1-based position out
// of `total`, then its label) to stderr WITHOUT a trailing newline, and return the monotonic-ns
// reading that starts the item's timing window, when `native_trace_items_enabled`. The line is closed
// by `trace_native_item_done` with a trailing ` | Nns` once the item's lowering-and-encode committed;
// an item whose native codegen faults mid-window therefore leaves its OPEN line on stderr WITHOUT the
// ` | Nns` — the last line names the exact crashing item, the ns-less tail marking it as the one that
// did not finish. A no-op returning `0` otherwise, so the ordinary build's output is byte-identical to
// before this diagnostic existed.
//
