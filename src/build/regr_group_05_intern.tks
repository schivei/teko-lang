/**
 * regr_group_config_text — a group's configuration rendered for its report line: the target it
 * builds for and the env tokens it builds under. What a reader needs to tell two groups apart.
 *
 * @param spec  the group's configuration
 * @return      the rendered configuration
 */
fn regr_group_config_text(spec: RegrGroupSpec) -> str {
    let target = if spec.target.len == 0 { HOST_TARGET } else { spec.target }
    mut env = ""
    mut i: u64 = 0
    loop {
        if i >= spec.env.len { break }
        if env.len > 0 { env = env ~ " " }
        env = env ~ spec.env[i]
        i = i + 1
    }
    if env.len == 0 { return $"target {target}, no env" }
    $"target {target}, env {env}"
}

/**
 * RegrBatchPrep — everything `regr_build_groups` must know AFTER generating the projects and BEFORE
 * launching them: the launch spec of each buildable group, where its capture files land (`prefix`
 * is also `spec.prefix`, kept alongside for the fold step's own indexing), and what generating each
 * one cost. `gen_ns` is indexed by GROUP, `specs`/`prefixes` by position in the pool — the two are
 * not the same list, because a group below the member floor is generated by nobody and appears in
 * neither.
 */
type RegrBatchPrep = struct {
// the launch spec of each buildable group, in group order.
    specs: []ProcSpec
// each spec's scratch prefix, parallel to `specs`.
    prefixes: []str
// what generating each GROUP's project cost, indexed by group (0 for one never generated).
    gen_ns: []i64
}

/**
 * regr_groups_prepare — generate every buildable group's project and collect the spec that builds
 * it, WITHOUT launching anything yet.
 *
 * The separation is the design. Generation writes to disk and must finish before any build reads
 * from disk; building is what benefits from running many at once. Doing them in one pass would
 * serialize the second on the first.
 *
 * @param exe   the absolute path to this compiler binary
 * @param plan  the whole plan
 * @param work  the regression scratch work tree
 * @return      the pool's specs, prefixes and per-group generation cost
 */
fn regr_groups_prepare(exe: str, plan: RegrGroupPlan, work: str) -> RegrBatchPrep {
    mut specs: []ProcSpec = teko::list::empty()
    mut prefixes: []str = teko::list::empty()
    mut gen_ns: []i64 = teko::list::empty()
    mut g: u64 = 0
    loop {
        if g >= plan.specs.len { break }
        if !regr_group_buildable(plan, g) { gen_ns = teko::list::push(gen_ns, 0); g = g + 1; continue }
        gen_ns = teko::list::push(gen_ns, regr_group_generate(plan, g, work))
        let dir = regr_group_dir(work, g)
        let prefix = dir ~ ".compile"
        prefixes = teko::list::push(prefixes, prefix)
        specs = teko::list::push(specs, compile_regressive_spec(exe, dir, with_regr_cov_env(plan.specs[g].env, prefix), prefix))
        g = g + 1
    }
    RegrBatchPrep { specs = specs; prefixes = prefixes; gen_ns = gen_ns }
}

/**
 * regr_groups_fold — turn the pool's captures back into one `RegrGroupBuild` per group, in group
 * order, re-inserting the un-generated groups the pool never carried.
 *
 * @param plan  the whole plan
 * @param work  the regression scratch work tree
 * @param prep  what `regr_groups_prepare` produced
 * @param caps  the pool's captures, parallel to `prep.specs`
 * @return      one build outcome per group
 */
fn regr_groups_fold(plan: RegrGroupPlan, work: str, prep: RegrBatchPrep, caps: []CapResult) -> []RegrGroupBuild {
    mut builds: []RegrGroupBuild = teko::list::empty()
    mut g: u64 = 0
    mut at: u64 = 0
    loop {
        if g >= plan.specs.len { break }
        if !regr_group_buildable(plan, g) {
            builds = teko::list::push(builds, regr_group_skipped(regr_group_member_count(plan.members, g), phase_zero()))
            g = g + 1
            continue
        }
        builds = teko::list::push(builds, regr_group_verdict(plan, g, work, plan.specs.len, caps[at], prep.gen_ns[g]))
        at = at + 1
        g = g + 1
    }
    builds
}
