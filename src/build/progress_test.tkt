/**
 * Build a `[]str` CLI argument vector from up to three tokens, dropping any that is
 * "" so a test can pass fewer than three. Mirrors `project_test.tkt`/`help_test.tkt`'s
 * own `args_of` fixtures, scoped to this file's observability-flag tests.
 *
 * @param a  the first token (dropped when "")
 * @param b  the second token (dropped when "")
 * @param c  the third token (dropped when "")
 * @return   the assembled argument vector
 */
fn progress_args_of(a: str, b: str, c: str) -> []str {
    mut v: []str = teko::list::empty()
    if a != "" { v = teko::list::push(v, a) }
    if b != "" { v = teko::list::push(v, b) }
    if c != "" { v = teko::list::push(v, c) }
    v
}

/**
 * `no_tty_of` detects `--no-tty` anywhere on the line, and does not mistake an
 * unrelated flag or a bare project argument for it.
 */
#test
fn no_tty_of_detects_the_flag() {
    teko::assert::is_true(no_tty_of(progress_args_of("teko", "build", "--no-tty")))
    teko::assert::is_true(no_tty_of(progress_args_of("teko", "--no-tty", "build")))
    teko::assert::is_false(no_tty_of(progress_args_of("teko", "build", ".")))
    teko::assert::is_false(no_tty_of(progress_args_of("teko", "", "")))
}

/**
 * `--no-tty` is a manual OVERRIDE that always forces the plain, non-interactive
 * output — regardless of what the env-based heuristic would otherwise decide. This
 * is the cheap, environment-independent half of the contract (the CI/TERM-reading
 * half depends on the process environment and is exercised manually, not here).
 */
#test
fn output_is_tty_no_tty_override_forces_plain() {
    teko::assert::is_false(output_is_tty(true))
}

/**
 * `project_arg_of` skips a `--no-tty` flag (wherever it sits) rather than mistaking
 * it for the project positional argument.
 */
#test
fn project_arg_of_skips_no_tty() {
    teko::assert::is_true(project_arg_of(progress_args_of("teko", "--no-tty", "."), 1) == ".")
    teko::assert::is_true(project_arg_of(progress_args_of("teko", ".", "--no-tty"), 1) == ".")
}

/**
 * `count_unit_text`/`count_only_text`/`size_text` render the exact shapes the
 * observability phases compose their lines from.
 */
#test
fn counter_and_size_text_render_expected_shapes() {
    teko::assert::is_true(count_unit_text(122, 122, "files") == "122/122 files")
    teko::assert::is_true(count_only_text(1204, "instances") == "1204 instances")
    teko::assert::is_true(size_text(8800000) == "(8.3 MB)")
}

/**
 * `report_mode` resolves the three phase-render states from the (quiet, tty) axes:
 * `quiet` always wins as `Quiet` (regardless of `tty`); otherwise a terminal is
 * `Tty` and a non-interactive destination (CI/pipe/redirect) is `Plain` — the state
 * that makes a phase announce at its START, closing the silent inter-phase gap.
 */
#test
fn report_mode_resolves_the_three_states() {
    teko::assert::is_true(report_mode(true, true) == Report::Quiet)
    teko::assert::is_true(report_mode(true, false) == Report::Quiet)
    teko::assert::is_true(report_mode(false, true) == Report::Tty)
    teko::assert::is_true(report_mode(false, false) == Report::Plain)
}

/**
 * `duration_str` renders a ns duration to one decimal place of seconds, floors a negative delta to
 * "0.0", and carries no unit suffix (the caller appends "s"). The top command wall and each phase's
 * elapsed both read through it, so this pins the shared shape.
 */
#test
fn duration_str_renders_tenths_of_seconds() {
    teko::assert::is_true(duration_str(0) == "0.0")
    teko::assert::is_true(duration_str(2500000000) == "2.5")
    teko::assert::is_true(duration_str(-5) == "0.0")
}

/**
 * `build_clock_wall_ns` measures the external wall since the top clock opened and never goes
 * negative — a monotonic clock cannot run backwards, so the floor is a structural guarantee, not a
 * value that could be asserted for its magnitude (the ns are non-deterministic).
 */
#test
fn build_clock_wall_is_never_negative() {
    let c = build_clock_start()
    teko::assert::is_true(build_clock_wall_ns(c) >= 0)
}

/**
 * The razão records one label per settled phase, IN SETTLE ORDER, and its total is the sum of the
 * per-phase ns. The label sequence is deterministic and asserted; the ns are the caller's to sum,
 * never a magnitude a fixture pins.
 */
#test
fn ledger_records_labels_in_settle_order() {
    mut l = ledger_empty()
    l = ledger_record(l, "parse", 10)
    l = ledger_record(l, "checker", 20)
    l = ledger_record(l, "link", 30)
    teko::assert::is_true(ledger_labels_joined(l, " ") == "parse checker link")
    teko::assert::eq_i64(ledger_total_ns(l), 60)
}

/**
 * `ledger_reconcile` on a SEQUENTIAL run (the wall equals the sum of the phases) reports `dark == 0`
 * and `overlap == 0` and does not fail — the regime of today, where the law's DESIGUALDADE collapses
 * to an equality.
 */
#test
fn ledger_reconcile_sequential_has_zero_dark_and_zero_overlap() {
    mut l = ledger_empty()
    l = ledger_record(l, "parse", 40)
    l = ledger_record(l, "link", 60)
    match ledger_reconcile(l, 100) {
        Reconciliation as r => {
            teko::assert::eq_i64(r.dark, 0)
            teko::assert::eq_i64(r.overlap, 0)
        }
        error => teko::assert::is_true(false)
    }
}

/**
 * `ledger_reconcile` on a PARALLEL run (concurrent phases sum to more than the wall) reports
 * `dark == 0` and a positive `overlap` and DOES NOT FAIL: the sum exceeding the wall is the
 * parallelism gain, never a defeito. Trapping on it would break the day threads land.
 */
#test
fn ledger_reconcile_parallel_reports_overlap_without_error() {
    mut l = ledger_empty()
    l = ledger_record(l, "isel", 50)
    l = ledger_record(l, "regalloc", 50)
    match ledger_reconcile(l, 80) {
        Reconciliation as r => {
            teko::assert::eq_i64(r.dark, 0)
            teko::assert::eq_i64(r.overlap, 20)
        }
        error => teko::assert::is_true(false)
    }
}

/**
 * DARK TIME IS THE ONLY FAILURE. When the wall exceeds the sum of the phases, some wall belongs to no
 * phase (`dark > 0`) and `ledger_reconcile` returns an error — the one defeito the law forbids.
 */
#test
fn ledger_reconcile_dark_time_is_the_only_failure() {
    mut l = ledger_empty()
    l = ledger_record(l, "parse", 30)
    match ledger_reconcile(l, 100) {
        Reconciliation => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}
