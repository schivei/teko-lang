/**
 * src/build/regr_group_test_config.tkt   (namespace `teko::build`)
 *
 * Unit tests for configuration rendering and reporting.
 */

#test
/**
 * regr_group_config_text_names_the_host_and_the_env — the report line a reader tells two groups
 * apart by: an undeclared target reads as the host sentinel (never as an empty gap), and the env
 * tokens are spelled out.
 *
 * @return void
 */
fn regr_group_config_text_names_the_host_and_the_env() {
    let bare = regr_group_config_text(RegrGroupSpec { env = teko::list::empty(); target = "" })
    teko::assert::is_true(teko::str::contains(bare, HOST_TARGET))
    teko::assert::is_true(teko::str::contains(bare, "no env"))
    let with_env = regr_group_config_text(RegrGroupSpec { env = teko::list::push(teko::list::empty(), "TEKO_FOO=1"); target = "wasm32-wasi" })
    teko::assert::is_true(teko::str::contains(with_env, "wasm32-wasi"))
    teko::assert::is_true(teko::str::contains(with_env, "TEKO_FOO=1"))
}
