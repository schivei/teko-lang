use teko::parser
use teko::checker

fn priv_fn(name: str, body: []@TStatement()): checker::TFunction {
    checker::TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = checker::Void { }; body = body; vis = parser::Visibility::Private; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn exp_fn(name: str, body: []@TStatement()): checker::TFunction {
    checker::TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = checker::Void { }; body = body; vis = parser::Visibility::Exp; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = false; c_symbol = ""; from_lib = ""; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn extern_fn(name: str, lib: str): checker::TFunction {
    var no_body: []@TStatement() = teko::list::empty()
    checker::TFunction { overload_suffix = ""; name = name; type_params = teko::list::empty(); type_constraints = teko::list::empty(); params = teko::list::empty(); return_type = checker::Void { }; body = no_body; vis = parser::Visibility::Pub; has_doc = false; doc = ""; namespace = ""; file = ""; line = 0; col = 0; is_test = false; is_extern = true; c_symbol = "sym"; from_lib = lib; has_arena_size = false; arena_size = 0 to u64; ret_extra = teko::list::empty(); guard = parser::pred_true() }
}

fn call_stmt(name: str): @TStatement() {
    var callee = parser::Path { segments = teko::list::push(teko::list::empty(), parser::Segment { name = name }) }
    var ce = checker::TExpr { kind = checker::TCall { overload_suffix = ""; callee = callee; args = teko::list::empty(); call_ns = ""; is_closure_call = false; callee_type = checker::Void { }; is_iface_dispatch = false; iface_slot = 0; type_args = teko::list::empty(); ret_extra = teko::list::empty() }; type = checker::Void { }; line = 0; col = 0 }
    checker::TExprStmt { expr = ce }
}

fn one_stmt(s: @TStatement()): []@TStatement() { teko::list::push(teko::list::empty(), s) }

fn one_item(f: checker::TFunction): []@TItem() { teko::list::push(teko::list::empty(), f) }

fn push_item(items: []@TItem(), f: checker::TFunction): []@TItem() { teko::list::push(items, f) }

#test
fn call_inside_loop_init_is_reachable() {
    var loop_init = one_stmt(call_stmt("raw_write"))
    var loop_s: @TStatement() = checker::TLoopStmt { label = ""; init = loop_init; body = one_stmt(checker::TBreakStmt { label = "" }) }
    var helper = priv_fn("helper", one_stmt(loop_s))
    var items0 = one_item(extern_fn("raw_write", "libc"))
    var items1 = push_item(items0, helper)
    var items2 = teko::list::push(items1, call_stmt("helper"))
    var prog = checker::TProgram { items = items2 }
    teko::assert::is_true(name_in(reachable_libs(prog), "libc"))
}

#test
fn exp_function_is_its_own_root_even_when_uncalled_locally() {
    var pubapi = exp_fn("pubapi", one_stmt(call_stmt("crypto_init")))
    var items0 = one_item(extern_fn("crypto_init", "crypto"))
    var items1 = push_item(items0, pubapi)
    var prog = checker::TProgram { items = items1 }
    teko::assert::is_true(name_in(reachable_libs(prog), "crypto"))
}

#test
fn function_taken_as_a_value_counts_as_a_use() {
    var fref = checker::TExpr { kind = checker::TVar { name = "raw_read"; is_func = true; func_ns = "" }; type = checker::Void { }; line = 0; col = 0 }
    var bound = checker::TBinding { kind = parser::BindKind::Let; target = parser::SimpleName { name = "f" }; bound = checker::Void { }; value = fref }
    var items0 = one_item(extern_fn("raw_read", "libc"))
    var items1 = teko::list::push(items0, bound)
    var prog = checker::TProgram { items = items1 }
    teko::assert::is_true(name_in(reachable_libs(prog), "libc"))
}
