// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

    let binp = binary_output_path(GATE_OUT_DIR, teko::str::concat(m.name, "-regrcov"), resolved_target())
    if !path_exists(binp) { return exe }
    let cwd = match teko::env::cwd() { str as c => c; error => "" }
    abs_path_of(binp, cwd)
}

/**
 * path_exists — is there an entry named `p` in its parent directory? The existence probe the
 * driver needs for a BINARY (reading the file to test for it would pull megabytes into the arena
 * of the one process this staging keeps small).
 *
 * @param p  the path to probe
 * @return   true iff `p`'s parent directory lists `p`'s basename
 * @since 0.3.1.0
 */
fn path_exists(p: str) -> bool {
    let entries = match teko::fs::list_dir(dirname_of(p)) { []str as e => e; error => return false }
    let name = basename_of(p)
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i] == name { return true }
        i = i + 1
    }
    false
}

/**
 * build_regression_cov_exe — build a COVERAGE-INSTRUMENTED copy of the compiler `prog` (0.3.1
 * C-cov): emit it under `CgMode::ProgramCov` (`codegen::tk_emit_c_cov` — the SAME production-fn
 * line/branch prologues `TestCov` carries, but the ORDINARY virtual-main body, so the binary is a
 * fully functional `teko` CLI that ALSO dumps its coverage sinks to `$TEKO_TKCOV` at exit), then
 * compile it with `run_cc` at `REGRCOV_CC_OPT`. Distinct from the
 * `<name>-tktest` gate binary (`run_native_gate`) — that one's `main()` calls `#test`s; this one's
 * `main()` is the real CLI, so IT (not the release binary) can compile regression SNIPPETS while
 * marking the compiler-source lines those compiles exercise. The returned path is resolved
 * ABSOLUTE (never `bin/…`-relative): a `When built in place` scenario `cd`s into its own project
 * directory before invoking this exe (`compile_in_place`), so a relative path would resolve
 * against the WRONG directory once the regression phase reaches that scenario.
 *
 * The previous run's binary is REMOVED before the `cc`, so a failed compile leaves no stale
 * instrumented compiler behind for the driver to pick up and drive a whole regression tier with.
 *
 * @param m     the resolved manifest (names the output stem)
 * @param prog  the checked program to emit (the SAME `fe.prog` this `teko test` run already checked)
 * @return      the built instrumented binary's ABSOLUTE path, or an error
 * @since 0.3.1
 */
fn build_regression_cov_exe(m: Manifest, prog: checker::TProgram) -> str | error {
    let od = GATE_OUT_DIR
    match teko::fs::mkdir(od) { error => { }; null => { } }
    let stem = teko::str::concat(m.name, "-regrcov")
    let cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    let binp = binary_output_path(od, stem, resolved_target())
    let mode = report_mode(false, output_is_tty(false))
    let emit_phase = phase_begin("emit rcov", cfile, mode)
    let emitted = match codegen::tk_emit_c_cov(prog) {
        str as s => s
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return e }
    }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    match teko::io::write_file(cfile, csrc) {
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return e }
        null => { }
    }
    phase_end_ok(emit_phase, teko::str::concat(cfile, teko::str::concat(" ", size_text(csrc.len))))
    match teko::fs::remove_file(binp) { error => { }; null => { } }
    let cc_phase = phase_begin("cc rcov", binp, mode)
    if run_cc(cfile, binp, m, prog, REGRCOV_CC_OPT) != 0 {
        phase_end_fail(cc_phase, binp, REGRCOV_CC_FAIL)
        return error { message = REGRCOV_CC_FAIL }
    }
    phase_end_ok(cc_phase, binp)
    let cwd = match teko::env::cwd() { str as c => c; error => "" }
    abs_path_of(binp, cwd)
}

/**
 * REGRCOV_CC_OPT — the cc optimization level the coverage-instrumented regression compiler
 * (`teko-regrcov`) is built at (owner ruling 2026-07-31: "se `-O0` está com gargalo, use `-O2`
 * então, assim como o release").
 *
 * This binary is NOT a throwaway that only has to exist: every `.tkr` scenario COMPILES a whole
 * project through it, so the regression tier pays its execution speed once per scenario. Built
 * without a `-O` flag it took minutes on the heaviest scenario against seconds for the same
 * compile driven by the `-O2` release binary; the extra `cc` seconds this level costs are paid
 * ONCE per `teko test` run, and the tier gets them back many times over. The gate binary
 * (`<name>-tktest`) deliberately stays at 0 — it is measured separately, and its 1195 short
 * tests do not repay an optimizing `cc` over a 10 MB translation unit.
 */
const REGRCOV_CC_OPT: i32 = 2

/**
 * REGRCOV_CC_FAIL — the diagnostic for a failed `cc` of the coverage-instrumented regression
 * compiler, named so the phase line and the returned error carry the SAME words.
 */
const REGRCOV_CC_FAIL: str = "cc failed to build the coverage-instrumented regression compiler"

/**
 * GATE_OUT_DIR — the output directory `teko test` builds its gate binary, its instrumented
 * regression compiler and their coverage dumps under. `teko test` has no `-o`, so this is a
 * constant rather than a parameter, and the three stages of a staged run each derive the SAME
 * paths from it without passing anything to each other.
 */
const GATE_OUT_DIR: str = "bin"

/**
 * TEST_STAGE_ENV — the environment key that tells a re-invoked `teko test` WHICH stage of the run
 * it is (absent/empty = the driver itself). The `TEKO_IN_REGRESSION` sentinel's pattern: an
 * environment selector rather than a CLI flag, so the argv the driver hands its own binary is the
 * argv the user typed, verbatim — no flag list to keep in sync, and nothing a spawned scenario
 * compile can inherit and misread.
 */
const TEST_STAGE_ENV: str = "TEKO_TEST_STAGE"

/**
 * TEST_STAGE_BUILD — the stage that COMPILES: the front-end over the project plus its `.tkt`
 * tests, the gate binary, and the instrumented regression compiler. The whole memory cost of a
 * `teko test` run lives here, and the operating system takes all of it back when this stage's
 * process exits (owner ruling 2026-07-31: "ao fim, libera memória … cada passo deve rodar
 * independente, sem alocação de memória acumulativa").
 */
const TEST_STAGE_BUILD: str = "build"

/**
 * TEST_STAGE_REPORT — the stage that JUDGES: it re-checks the source (the only way to read
 * coverage back, which is a walk of the TYPED program), folds in every dump the gate and the
 * regression tier left on disk, and applies the floor/delta/arith-cast/analyzer policies.
 */
