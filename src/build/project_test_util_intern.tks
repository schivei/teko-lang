// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

 */
type ChangedFile = struct {
    /**
     * The changed file's path exactly as `git diff` reports it (repo-relative, `b/`-prefix stripped).
     */
    path: str
    /**
     * The new-side (post-change) 1-based source line numbers this diff added or replaced, in order.
     */
    lines: []u32
}

/**
 * The whole set of source lines changed since a git base — one `ChangedFile` per touched `.tks`
 * file. Produced by `changed_line_set` from a `git diff <base>...HEAD` and consulted by
 * `changed_contains` when attributing coverage to only the changed lines (the delta metric).
 */
type ChangedLines = struct {
    /**
     * The changed `.tks` files, each with its added/replaced new-side line numbers.
     */
    files: []ChangedFile
}

/**
 * One executable production line as the coverage report saw it: its source file, its 1-based line
 * number, and whether the run hit it. Parsed out of the Cobertura report (`cov_lines_from_cobertura`)
 * so the delta attribution reuses the SAME executable-line surface and hit marks the coverage floors
 * read — the delta is a projection of the aggregate coverage onto the changed lines.
 */
type CovLine = struct {
    /**
     * The source file the line belongs to (the Cobertura `<class filename=…>` of its function).
     */
    file: str
    /**
     * The 1-based source line number.
     */
    line: u32
    /**
     * Whether the aggregate run executed this line at least once (Cobertura `hits` &gt; 0).
     */
    hit: bool
}

/**
 * A delta-coverage count — covered / total over the CHANGED executable lines only. `delta_pct`
 * rounds down; an empty denominator (nothing executable changed) is vacuously 100% — a commit that
 * touched no measurable code has nothing to prove, so the gate never blocks it.
 */
type DeltaCoverage = struct {
    /**
     * The number of changed executable lines the run covered (numerator).
     */
    cov: u64
    /**
     * The total number of changed executable lines (denominator).
     */
    val: u64
}

/**
 * The value of the `--per-commit-test <base>` flag — the git ref/sha to diff against — or "" when
 * the flag is absent (the no-op default: `teko test` behaves exactly as before, zero added cost).
 * A DEV+CI knob (owner ruling 0.3.0.29 — the delta-coverage enforcer): with `--cov-validation` also
 * present a below-floor delta FAILS the gate, otherwise it only warns (consistent with #19's
 * default-non-blocking floor policy).
 *
 * @param args  the full CLI argument vector
 * @return      the git base immediately following `--per-commit-test`, or "" when the flag is absent
 */
fn per_commit_base_of(args: []str) -> str {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--per-commit-test" {
            if i + 1 < args.len { return args[i + 1] }
            return ""
        }
        i = i + 1
    }
    ""
}

/**
 * Does `s` begin with the byte sequence `p`? A local byte-level prefix test (there is no
 * `teko::str::starts_with` builtin — only `ends_with`/`contains`), used throughout the unified-diff
 * parser to classify each diff line by its leading marker.
 *
 * @param s  the string to test
 * @param p  the required prefix
 * @return   true iff `s` starts with `p`
 */
fn bp_prefix(s: str, p: str) -> bool {
    if s.len < p.len { return false }
    mut i: u64 = 0
    loop {
        if i >= p.len { break }
        if s[i] != p[i] { return false }
        i = i + 1
    }
    true
}

/**
 * Split `text` into lines on the `\n` byte, dropping the terminators; a trailing non-newline segment
 * is its own line and a trailing newline yields no empty final line. Kept local (rather than reaching
 * for `teko::iter::split_lines`) so the diff/Cobertura parsers stay self-contained within the build
 * namespace and directly unit-testable.
 *
 * @param text  the text to break into lines
 * @return      the lines in order, without their line terminators
 */
fn bp_lines(text: str) -> []str {
    mut out: []str = teko::list::empty()
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            out = teko::list::push(out, teko::str::slice(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < text.len { out = teko::list::push(out, teko::str::slice_from(text, start)) }
    out
}

/**
 * The first index of `needle` in `s`, or -1 when absent — a forward substring search (the only
 * builtin, `last_index_of`, searches from the END). Backs the Cobertura attribute extractor.
 *
 * @param s       the haystack
 * @param needle  the substring to locate (an empty needle matches at 0)
 * @return        the 0-based index of the first occurrence, or -1 when `needle` does not occur
 */
fn bp_find(s: str, needle: str) -> i64 {
    if needle.len == 0 { return 0 }
    if s.len < needle.len { return -1 }
    mut i: u64 = 0
    let last = s.len - needle.len
    loop {
        if i > last { break }
        if bp_prefix(teko::str::slice_from(s, i), needle) { return i to i64 }
        i = i + 1
    }
    -1
}

/**
 * The leading run of decimal digits of `s` as a u64 (0 when `s` does not start with a digit). Parses
 * the small integers the diff hunk header and Cobertura attributes carry.
 *
 * @param s  the string whose leading digit run is read
 * @return   the parsed non-negative integer, or 0 when there is no leading digit
 */
fn bp_parse_uint(s: str) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= s.len { break }
        let c = s[i]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        i = i + 1
    }
    n
}

/**
 * The new-side (post-change) start line of a unified-diff hunk header `@@ -a,b +c,d @@`: the integer
 * immediately after the `+` (the `c`). 0 when the line carries no `+` group (never a valid header).
 *
 * @param line  the `@@ … @@` hunk header line
 * @return      the new-side start line `c`, or 0 when the header is malformed
 */
fn bp_hunk_newstart(line: str) -> u32 {
    mut i: u64 = 0
    loop {
        if i >= line.len { break }
        if line[i] == b'+' { return bp_parse_uint(teko::str::slice_from(line, i + 1)) to u32 }
        i = i + 1
    }
    0
}

/**
 * The changed file's path from a unified-diff `+++ ` header line: the text after `+++ `, with a
 * leading `b/` stripped. A `+++ /dev/null` (a pure deletion) yields "" so it registers no file.
 *
 * @param line  the `+++ …` header line
 * @return      the repo-relative path, or "" for `/dev/null`
 */
fn bp_plusfile(line: str) -> str {
    let rest = teko::str::slice_from(line, 4)
    if rest == "/dev/null" { return "" }
    if bp_prefix(rest, "b/") { return teko::str::slice_from(rest, 2) }
    rest
}

/**
 * Append a completed file's changed lines to the accumulator, but ONLY when it is a non-empty `.tks`
 * file — a file with no added lines (pure deletion) or a non-Teko path contributes no delta unit, so
 * it is dropped. Flushed by `changed_line_set` each time the diff advances to the next `+++` file.
 *
 * @param files  the changed-file accumulator so far
 * @param path   the file just parsed (repo-relative)
 * @param lines  its added/replaced new-side line numbers
 * @return       `files` with the file appended when it is a non-empty `.tks`, else `files` unchanged
 */
fn cl_flush(files: []ChangedFile, path: str, lines: []u32) -> []ChangedFile {
    if lines.len == 0 { return files }
    if !teko::str::ends_with(path, ".tks") { return files }
    teko::list::push(files, ChangedFile { path = path; lines = lines })
}

/**
 * Parse a `git diff <base>...HEAD` unified diff into the set of new-side lines it changed per `.tks`
 * file. Walks the diff line by line, tracking the current `+++` file and the running new-side line
 * number seeded by each `@@` hunk header: an added line (`+`, not the `+++` header) records the
 * current new-side number and advances it; a context line (leading space) advances it; a deletion
 * (`-`, not the `---` header) and every header/metadata line leave it untouched. PURE — the git shell
 * is elsewhere (`per_commit_diff_text`) so this is directly unit-testable on a synthetic diff.
 *
 * @param diff  the unified-diff text from `git diff <base>...HEAD`
 * @return      the changed `.tks` files with their added/replaced new-side line numbers
 */
fn changed_line_set(diff: str) -> ChangedLines {
    mut files: []ChangedFile = teko::list::empty()
    mut cur_file: str = ""
    mut cur_lines: []u32 = teko::list::empty()
    mut newno: u32 = 0
    let lines = bp_lines(diff)
    mut i: u64 = 0
    loop {
        if i >= lines.len { break }
        let ln = lines[i]
        if bp_prefix(ln, "+++ ") {
            files = cl_flush(files, cur_file, cur_lines)
            cur_file = bp_plusfile(ln)
            cur_lines = teko::list::empty()
        } else if bp_prefix(ln, "@@ ") {
            newno = bp_hunk_newstart(ln)
        } else if bp_prefix(ln, "+") && !bp_prefix(ln, "+++") {
            cur_lines = teko::list::push(cur_lines, newno)
            newno = newno + 1
        } else if bp_prefix(ln, " ") {
            newno = newno + 1
        }
        i = i + 1
    }
    files = cl_flush(files, cur_file, cur_lines)
    ChangedLines { files = files }
}
