/**
 * resolved_target — the own-backend target this build resolves to, with the R2 error arm folded
 * back onto the host default. The honest R2 stop for an unrecognized `TEKO_TARGET` (or an
 * unsupported host os-arch pair) belongs to `emit_native` (which surfaces it as a build failure
 * before anything is emitted); every OTHER consumer of the resolved target — the cross-emit note
 * (`cross_note`), the os-arch link-key selection (`link_target_keys`) and the M.3 extern-lib
 * validators — needs a TOTAL answer and must not double-report that diagnostic, so a bad value
 * reads here as `host_default_target_guess()` (which is also exactly what the C backend, the only
 * path that ignores `TEKO_TARGET`, links for).
 *
 * @return the resolved own-backend target, or the host guess when the value is unrecognized
 * @since 0.3.1
 */
fn resolved_target() -> NativeTarget {
    match native_target() { NativeTarget as t => t; error => host_default_target_guess() }
}

