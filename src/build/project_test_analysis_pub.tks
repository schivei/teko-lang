
/**
 * encode_lfuncs_in_region_win — encode a LIST of `LFunc` (an item's own top-level function plus its
 * newly lifted closures/thunks) inside the scratch region the caller has already entered, each one
 * through `encode_lfunc_in_region_win`. The Win64 twin of `encode_lfuncs_in_region_x86`; the fused
 * native lowering driver calls this BEFORE `region_leave()` and commits through the SHARED
 * `fold_encoded_funcs_x86` (which copies) AFTER leaving, before the region drops — identical to the
 * x86-linux commit path, since both tails share `EncodedFuncX86`/`ModuleTextX86`.
 *
 * @param fs  the item's lowered functions, in emission order
 * @return    one `EncodedFuncX86` per function, or the first propagated honest-stop
 * @since 0.3.1 C6.4
 */
pub fn encode_lfuncs_in_region_win(fs: []teko::lir::LFunc) -> []teko::backend::EncodedFuncX86 | error {
    mut out: []teko::backend::EncodedFuncX86 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= fs.len { break }
        let ef = match encode_lfunc_in_region_win(fs[i]) { teko::backend::EncodedFuncX86 as x => x; error as e => return e }
        out = teko::list::push(out, ef)
        i++
    }
    out
}
