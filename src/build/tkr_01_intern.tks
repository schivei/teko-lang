use teko::casting

/**
 * tkr_match_ignore — the empty `TkrMatch` (no expectation on a stream).
 *
 * @return an `Ignore`-mode match
 * @since 0.3.0.29
 */
fn tkr_match_ignore() -> TkrMatch { TkrMatch { mode = TkrMatchMode::Ignore; text = "" } }

/**
 * tkr_read_i32 — read an unquoted non-negative integer (an expected exit code) at `p` and narrow it
 * to the `i32` a process status is.
 *
 * Routed through `teko::casting::u64_to_i32` (returns `i32 | error`, never panics) rather than a bare
 * `to i32` (panics). The value comes from a `.tkr` FILE, which a human writes: `Then it exits with
 * 99999999999` is a typo in a spec, and a typo in a spec must become a diagnostic naming the file,
 * not an aborted compiler with "impossible conversion" and no filename. That is the recoverable row
 * of `docs/design/cast-width-hygiene-0.3.1.md` §10.2 — the caller can and does recover, because both
 * of this function's callers already return `TkrLower | error`.
 *
 * @param s  the line being read
 * @param p  the cursor at the value
 * @return   the parsed value as i32
 * @throws   error  when the number does not fit an `i32` (a malformed spec, named as such)
 * @see      teko::casting::u64_to_i32 — the checked no-panic converter this delegates to
 * @since 0.3.0.29
 */
fn tkr_read_i32(s: str, p: u64) -> i32 | error {
    match casting::u64_to_i32(mf_read_int(s, p)) {
        i32 as v => v
        error => error { message = teko::str::concat("tkr: expected exit code is not a process status (out of i32 range): ", s) }
    }
}

/**
 * tkr_expect_for — the per-os-arch override matching `osarch`, or `null` when the lowered `Tkr`
 * declares none for it (the runner then uses the top-level expectation).
 *
 * @param t       the lowered spec
 * @param osarch  the os-arch key to resolve
 * @return        the matching override, or `null`
 * @since 0.3.0.29
 */
fn tkr_expect_for(t: Tkr, osarch: str) -> TkrExpect | null {
    mut k: u64 = 0
    loop {
        if k >= t.expect.len { break }
        if t.expect[k].osarch == osarch { return t.expect[k] }
        k = k + 1
    }
    null
}
