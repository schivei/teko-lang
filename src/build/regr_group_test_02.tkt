/**
 * regr_group_slot_is_null — did the slot lookup miss? The `RegrGroupSlot | null` result read as a
 * bool, so the lookup law above asserts on one shape instead of matching in four places.
 *
 * @param gs   the grouping
 * @param key  the row key to look up
 * @return     true when the lookup found no slot
 */
fn regr_group_slot_is_null(gs: RegrGroups, key: str) -> bool {
    match regr_group_slot(gs, key) { RegrGroupSlot => false; null => true }
}

#test
/**
 * regr_with_entry_env_appends_the_selector — the row's own env survives and the selector is ADDED to
 * it: a `Given env` token still has to reach the child, and the group binary still
 * has to be told which member to run.
 *
 * @return void
 */
fn regr_with_entry_env_appends_the_selector() {
    let t = regr_with_entry_env(regr_test_row("", teko::list::push(teko::list::empty(), "K=V")), "m3")
    teko::assert::is_true(t.env.len == 2)
    teko::assert::is_true(t.env[0] == "K=V")
    teko::assert::is_true(t.env[1] == REGR_GROUP_ENTRY_VAR ~ "=m3")
}

#test
/**
 * regr_groups_total_sums_every_group_build — the phase accounting: the run's summary line must still
 * report every build the run paid for, and a grouped row reports none of its own, so the group
 * builds' cost is exactly what this sum contributes.
 *
 * @return void
 */
fn regr_groups_total_sums_every_group_build() {
    let one = RegrGroupBuild { ok = true; binp = "a"; members = 2; times = PhaseTimes { harness_ns = 1; compile_ns = 2; run_ns = 0; builds = 1 } }
    let two = RegrGroupBuild { ok = true; binp = "b"; members = 3; times = PhaseTimes { harness_ns = 10; compile_ns = 20; run_ns = 0; builds = 1 } }
    let gs = RegrGroups { members = teko::list::empty(); builds = teko::list::push(teko::list::push(teko::list::empty(), one), two) }
    let total = regr_groups_total(gs)
    teko::assert::is_true(total.builds == 2)
    teko::assert::is_true(total.harness_ns == 11)
    teko::assert::is_true(total.compile_ns == 22)
}

#test
/**
 * regr_group_config_text_names_the_host_and_the_env — the report line a reader tells two groups
 * apart by: an undeclared target reads as the host sentinel (never as an empty gap), and the env
 * tokens are spelled out.
 *
 * @return void
 */
fn regr_group_config_text_names_the_host_and_the_env() {
    let bare = regr_group_config_text(RegrGroupSpec { env = teko::list::empty(); target = "" })
    teko::assert::is_true(teko::str::contains(bare, HOST_TARGET))
    teko::assert::is_true(teko::str::contains(bare, "no env"))
    let with_env = regr_group_config_text(RegrGroupSpec { env = teko::list::push(teko::list::empty(), "TEKO_FOO=1"); target = "x86_64-windows" })
    teko::assert::is_true(teko::str::contains(with_env, "x86_64-windows"))
    teko::assert::is_true(teko::str::contains(with_env, "TEKO_FOO=1"))
}

/**
 * regr_test_row — a groupable `Tkr` with the given `target` and `env`, everything else at the
 * neutral default. The shared fixture the grouping tests vary one axis of.
 *
 * @param target  the row's declared target
 * @param env     the row's child env
 * @return        the lowered row
 */
fn regr_test_row(target: str, env: []str) -> Tkr {
    Tkr {
        args = teko::list::empty(); stdin = ""; kind = TkrKind::Exit; exit = 0
        stdout = TkrMatch { mode = TkrMatchMode::Ignore; text = "" }
        stderr = TkrMatch { mode = TkrMatchMode::Ignore; text = "" }
        targets = teko::list::empty(); expect = teko::list::empty(); golden = teko::list::empty()
        diagnostic = ""; source_inline = "exit(0)\n"; source_file = ""
        env = env; target = target; in_place = false; dep_dir = ""
        check_wellformed = false
    }
}

/**
 * regr_test_row_kind — the shared fixture with a different `kind`.
 *
 * @param kind  the row's classification
 * @return      the lowered row
 */
fn regr_test_row_kind(kind: TkrKind) -> Tkr {
    let b = regr_test_row("", teko::list::empty())
    Tkr {
        args = b.args; stdin = b.stdin; kind = kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = b.check_wellformed
    }
}

/**
 * regr_test_row_source — the shared fixture with a different inline source ("" = a project-based
 * scenario, which the fold never takes).
 *
 * @param src  the row's inline snippet source
 * @return     the lowered row
 */
fn regr_test_row_source(src: str) -> Tkr {
    let b = regr_test_row("", teko::list::empty())
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = src; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = b.check_wellformed
    }
}

/**
 * regr_test_row_file — a row whose snippet is named by `Given source = "<file>"` rather than carried
 * inline. The shape the corpus uses everywhere since inline code was banned in a `.tkr`.
 *
 * @param path  the source file, relative to the row's `.tkr` directory
 * @return      a runnable row naming that file and carrying no inline body
 */
fn regr_test_row_file(path: str) -> Tkr {
    let base = regr_test_row_source("")
    Tkr {
        args = base.args; stdin = base.stdin; kind = base.kind; exit = base.exit; stdout = base.stdout
        stderr = base.stderr; targets = base.targets; expect = base.expect; golden = base.golden
        diagnostic = base.diagnostic; source_inline = ""; source_file = path; env = base.env
        target = base.target; in_place = base.in_place; dep_dir = base.dep_dir
        check_wellformed = base.check_wellformed
    }
}

/**
 * regr_test_row_wellformed — the shared fixture carrying a `Then object well-formed` leaf check, the
 * exclusion whose reason is that the checked artifact would otherwise become the whole group's.
 *
 * @return the lowered row
 */
fn regr_test_row_wellformed() -> Tkr {
    let b = regr_test_row("", teko::list::empty())
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = true
    }
}
