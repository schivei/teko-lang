use teko::checker
use teko::lir
use teko::list

// use teko::checker
// use teko::lir
//
// // src/build/project.tks   (namespace 'teko::build')
// //
// // The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// // surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// // the directory resolution in main.c (project_dir_of). main.tks dispatches here:
// //   teko build <dir>  → compile_project  (front-end → native codegen)
// //   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
// //   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
// //
// // FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// // the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// // so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// // `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// // codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// // diverged to is retired, #524).
//
//
// AFTER `region_leave()` (so the copies and the fold itself land in the ROOT) and BEFORE
// `region_drop` (the item's region is still alive, so the strings it may have synthesized are still
// readable to copy FROM).
//
// @param mt   the running root-resident `__text` accumulator
// @param efs  the item's encoded functions, in emission order
// @return     the extended accumulator
// @since 0.3.1 C6.4
//
fn fold_encoded_funcs_arm64(mt: teko::backend::ModuleText, efs: []teko::backend::EncodedFunc) -> teko::backend::ModuleText {
    mut acc = mt
    mut i: u64 = 0
    loop {
        if i >= efs.len { break }
        acc = teko::backend::fold_encoded_func(acc, copy_encoded_func_to_current_region_arm64(efs[i]))
        i++
    }
    acc
}

/**
 * FusedItemOutArm64 — the arm64 twin of `FusedItemOut` (x86): one item's (or the virtual-main's)
 * contribution from inside its own scoped region, produced by the SHARED arm64 pipeline
 * (isel → AAPCS64 regalloc → arm64 encode) both `emit_native_arm64` and `emit_native_arm64_linux`
 * fuse through — only the final object-format writer differs between those two tails. Same fields
 * and the same commit contract (§3 of the design) as `FusedItemOut`, with `encoded` carrying
 * arm64's own `EncodedFunc` (word-granular `__text`, not x86's byte-granular `.text`). The caller
 * commits every field to the root BEFORE the region drops.
 *
 * @since 0.3.1 C6.4
 */
type FusedItemOutArm64 = struct {
// encoded — this item's own function plus its newly lifted functions, already encoded.
    encoded: []teko::backend::EncodedFunc
// rodata — the rodata table this item's lowering grew (seed prefix + its own delta).
    rodata: []teko::lir::LRodata
// loose — the loose top-level statement list this item grew (seed prefix + its own delta).
    loose: []checker::TStatement
// new_lifted_count — how many NEW lifted closures/thunks this item's lowering created.
    new_lifted_count: u64
}

/**
 * fuse_lower_item_arm64 — lower ONE program item and encode its output, ENTIRELY inside the
 * caller's already-entered scratch region: the arm64 twin of `fuse_lower_item_x86`. Seed a
 * throwaway `LModule` with EMPTY `funcs` (so `lower_item`'s `add_func` yields only THIS item's own
 * `LFunc`, §4b), lower the item, isolate its newly lifted functions (`lifted_suffix`), run the
 * frame-escape guard over the item's own function plus those (moved per-item, §2c), then encode all
 * of them through the arm64 pipeline. Every native honest-stop (from lowering, the guard, or
 * encoding) propagates out unchanged.
 *
 * @param robase    the root-resident rodata accumulator (read-only seed for this item's dedup)
 * @param prelude   the whole-program lowering context (`teko::lir::lower_prelude`)
 * @param loose     the root-resident loose-statement accumulator (read-only seed)
 * @param it        the program item to lower
 * @param lifted_ph  the root-resident lifted-count placeholder list (length = the running total)
 * @return          this item's encoded output + grown rodata/loose + new-lifted count, or a
 *                  propagated honest-stop
 * @since 0.3.1 C6.4
 */
fn fuse_lower_item_arm64(robase: []teko::lir::LRodata, prelude: teko::lir::LowerPrelude, loose: []checker::TStatement, it: checker::TItem, lifted_ph: []teko::lir::LFunc) -> FusedItemOutArm64 | error {
    let seed = teko::lir::LModule { funcs = teko::list::empty(); rodata = robase; globals = prelude.module.globals; layouts = prelude.module.layouts }
    let step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, lifted_ph, prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { teko::lir::LowerItemOut as x => x; error as e => return e }
    let new_lifted = lifted_suffix(step.lifted, lifted_ph.len)
    let item_funcs = concat_lfuncs(step.module.funcs, new_lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    let encoded = match encode_lfuncs_in_region_arm64(item_funcs) { []teko::backend::EncodedFunc as x => x; error as e => return e }
    FusedItemOutArm64 { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = new_lifted.len }
}

/**
 * fuse_virtual_main_arm64 — lower the synthesized virtual-main and encode it, ENTIRELY inside the
 * caller's already-entered scratch region: the arm64 twin of `fuse_virtual_main_x86`.
 * `lower_virtual_main` over every item's collected loose statement (continuing the SAME lifted-id
 * numbering via `lifted_ph`, §4b), the platform-ABI entry wrap (`teko::lir::wrap_native_entry` —
 * renames `main` to the internal symbol and appends the `argc`/`argv` stub, §4a) applied to a
 * throwaway one-function `LModule` so no whole-module table is materialized, the frame-escape
 * guard, then encoding through the arm64 pipeline — the one synthesized "item" that runs after
 * every real one has already dropped its region.
 *
 * @param loose     every item's collected loose top-level statement, in program order
 * @param prelude   the whole-program lowering context
 * @param robase    the root-resident rodata accumulator (read-only seed)
 * @param lifted_ph  the root-resident lifted-count placeholder list (length = the running total)
 * @return          the entry's encoded output (renamed vmain + stub + any new lifted) + grown
 *                  rodata, or a propagated honest-stop
 * @since 0.3.1 C6.4
 */
fn fuse_virtual_main_arm64(loose: []checker::TStatement, prelude: teko::lir::LowerPrelude, robase: []teko::lir::LRodata, lifted_ph: []teko::lir::LFunc) -> FusedItemOutArm64 | error {
    let vmain = match teko::lir::lower_virtual_main(loose, prelude.layouts, prelude.enums, robase, lifted_ph, prelude.externs, false, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { teko::lir::LoweredFunction as x => x; error as e => return e }
    let new_lifted = lifted_suffix(vmain.lifted, lifted_ph.len)
    let seed = teko::lir::LModule { funcs = teko::list::push(teko::list::empty(), vmain.func); rodata = vmain.rodata; globals = prelude.module.globals; layouts = prelude.module.layouts }
    let wrapped = match teko::lir::wrap_native_entry(seed) { teko::lir::LModule as x => x; error as e => return e }
    let all_funcs = concat_lfuncs(wrapped.funcs, new_lifted)
    match frame_escape_window(all_funcs) { error as e => return e; null => { } }
    let encoded = match encode_lfuncs_in_region_arm64(all_funcs) { []teko::backend::EncodedFunc as x => x; error as e => return e }
    FusedItemOutArm64 { encoded = encoded; rodata = vmain.rodata; loose = teko::list::empty(); new_lifted_count = new_lifted.len }
}

/**
 * NativeObjectWriterArm64 — the ONE call that tells `emit_native_arm64_fused`'s two instances
 * apart: `emit_native_arm64` (Mach-O) passes `teko::backend::emit_macho`, `emit_native_arm64_linux`
 * (ELF) passes `teko::backend::emit_elf_arm64`. Everything upstream of the final object-format
 * write — isel, AAPCS64 regalloc, arm64 encode, the per-item fused lowering loop itself — is
 * IDENTICAL between the two tails, preserving the invariant that the arm64-macos differential keeps
 * covering the arm64-linux codegen (§ design doc C6.4). Takes the D1.4/D1.5 `DwarfSink` alongside
 * the encoded module, so the writer's own object format decides how to place it (or, when absent,
 * places nothing) — the SAME two-argument shape `emit_macho`/`emit_elf_arm64` already carry.
 *
 * @since 0.3.1 C6.4
 */
type NativeObjectWriterArm64 = (teko::backend::EncodedModule, teko::backend::DwarfSink) -> []byte

/**
 * emit_native_arm64_fused — the shared arm64 own-backend tail, FUSED lower+encode per item (0.3.1
 * C6.4, `docs/design/native-lowering-oom-por-funcao-0.3.1.md`): compute the whole-program lowering
 * context ONCE (`teko::lir::lower_prelude`), then for every program item — a scratch child region,
 * lower AND encode that ONE item inside it (`fuse_lower_item_arm64`), leave the region, commit its
 * outputs to the root accumulators (`__text` words E1, the rodata delta E4, the loose-statement
 * delta E6, the new-lifted count E5), THEN drop the region — bounding the arm64 native peak to
 * `Σ(bytes) + rodata + ONE item's LIR/scratch`, mirroring the x86-linux fusion of C6.3. The
 * virtual-main lowers and encodes the same way, in its own final window, once every item's region
 * has already dropped. The assembled `__text`/rodata/symbols, plus the D1.5 DWARF sink
 * (`build_dwarf_sink_for`, gated on `DebugInfo::Lines`), are wrapped in the object format `writer`
 * selects (Mach-O for `emit_native_arm64`, ELF for `emit_native_arm64_linux` — the ONE call that
 * differs, §4a of the design) and handed to `finish_native_object` (write `.o` + `cc`-link + `.tsym`
 * + success marker) — unchanged past the encoder, so a `DebugInfo::None` build's emitted bytes stay
 * byte-identical to the pre-fusion module-at-a-time path (only WHERE the compiler's own
 * intermediates bump-allocate changes, never their computed values).
 *
 * @param dir     the project directory (for diagnostics)
 * @param od      the slash-stripped output directory (already created)
 * @param stem    the output artifact name (the manifest `name`)
 * @param prog    the checked, typed program (lowered item-by-item, not up front — C6.4)
 * @param m       the resolved manifest (link knobs)
 * @param debug   the requested `--debug=` level (D1.4/D1.5)
 * @param writer  the target's own object-format writer (Mach-O or ELF)
 * @return        0 on a successful build+link, else the failing status
 * @since 0.3.1 C6.4
 */
fn emit_native_arm64_fused(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo, writer: NativeObjectWriterArm64) -> i32 {
    let prelude = match teko::lir::lower_prelude(prog, false) { teko::lir::LowerPrelude as x => x; error as e => return fail(dir, e.message) }
    mut robase = prelude.module.rodata
    mut loose: []checker::TStatement = teko::list::empty()
    mut lifted_ph: []teko::lir::LFunc = teko::list::empty()
    mut mt = teko::backend::empty_module_text()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        let t0 = trace_native_item(i, prog.items.len, prog.items[i])
        let child = region_new(region_root())
        region_enter(child)
        let outcome = fuse_lower_item_arm64(robase, prelude, loose, prog.items[i], lifted_ph)
        region_leave()
        match outcome {
            FusedItemOutArm64 as out => {
                match check_current_region_is_root(native_item_label(i, prog.items.len)) { error as e => return fail(dir, e.message); null => { } }
                mt = fold_encoded_funcs_arm64(mt, out.encoded)
                robase = commit_rodata_delta(robase, out.rodata)
                loose = commit_loose(loose, out.loose)
                lifted_ph = extend_lifted_placeholders(lifted_ph, out.new_lifted_count)
                region_drop(child)
                trace_native_item_done(t0)
            }
            error as e => return fail(dir, e.message)
        }
        i++
    }
    let vt0 = trace_native_vmain()
    let vchild = region_new(region_root())
    region_enter(vchild)
    let vmain_outcome = fuse_virtual_main_arm64(loose, prelude, robase, lifted_ph)
    region_leave()
    match vmain_outcome {
        FusedItemOutArm64 as out => {
            match check_current_region_is_root("virtual-main") { error as e => return fail(dir, e.message); null => { } }
            mt = fold_encoded_funcs_arm64(mt, out.encoded)
            robase = commit_rodata_delta(robase, out.rodata)
            region_drop(vchild)
            trace_native_item_done(vt0)
            match teko::backend::finish_encoded_module(mt, robase, prelude.module.globals) {
                teko::backend::EncodedModule as enc => {
                    let dwarf = build_dwarf_sink_for(dir, prog, enc.symbols, enc.text.len, debug)
                    finish_native_object(dir, od, stem, writer(enc, dwarf), prog, m)
                }
                error as e => fail(dir, e.message)
            }
        }
        error as e => fail(dir, e.message)
    }
}

/**
 * encode_lfunc_in_region_win — the per-function isel → regalloc → encode pipeline for ONE `LFunc`
 * under the Win64 ABI register file, meant to run with a scratch region entered: the Win64 twin of
 * `encode_lfunc_in_region_x86` — `select_lfunc_x86`/`regalloc_func_x86`/`encode_func_x86` are the
 * SAME x86 pipeline `emit_native_x86` uses, called with `WIN64` instead of `SYSV64` (the x86 ISA is
 * shared between the two tails; only the ABI register partition differs). Reuses `EncodedFuncX86`
 * and every downstream x86 copy/fold/commit helper unchanged.
 *
 * @param f  the lowered function to encode
 * @return   the encoded function, or a propagated native honest-stop
 * @since 0.3.1 C6.4
 */
fn encode_lfunc_in_region_win(f: teko::lir::LFunc) -> teko::backend::EncodedFuncX86 | error {
    let sel = match teko::backend::select_lfunc_x86(teko::backend::WIN64, f) { teko::backend::MFuncX86 as x => x; error as e => return e }
    let col = match teko::backend::regalloc_func_x86(teko::backend::WIN64, sel) { teko::backend::MFuncX86 as x => x; error as e => return e }
    teko::backend::encode_func_x86(teko::backend::WIN64, col)
}

/**
 * fuse_lower_item_win — lower ONE program item and encode its output, ENTIRELY inside the caller's
 * already-entered scratch region: the Win64 twin of `fuse_lower_item_x86`, identical except the
 * encode step runs under the Win64 ABI (`encode_lfuncs_in_region_win`). Reuses `FusedItemOut` — the
 * x86 struct, since Win64 shares `EncodedFuncX86` with the SysV path.
 *
 * @param robase    the root-resident rodata accumulator (read-only seed for this item's dedup)
 * @param prelude   the whole-program lowering context (`teko::lir::lower_prelude`)
 * @param loose     the root-resident loose-statement accumulator (read-only seed)
 * @param it        the program item to lower
 * @param lifted_ph  the root-resident lifted-count placeholder list (length = the running total)
 * @return          this item's encoded output + grown rodata/loose + new-lifted count, or a
 *                  propagated honest-stop
 * @since 0.3.1 C6.4
 */
fn fuse_lower_item_win(robase: []teko::lir::LRodata, prelude: teko::lir::LowerPrelude, loose: []checker::TStatement, it: checker::TItem, lifted_ph: []teko::lir::LFunc) -> FusedItemOut | error {
    let seed = teko::lir::LModule { funcs = teko::list::empty(); rodata = robase; globals = prelude.module.globals; layouts = prelude.module.layouts }
    let step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, lifted_ph, prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { teko::lir::LowerItemOut as x => x; error as e => return e }
    let new_lifted = lifted_suffix(step.lifted, lifted_ph.len)
    let item_funcs = concat_lfuncs(step.module.funcs, new_lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    let encoded = match encode_lfuncs_in_region_win(item_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = new_lifted.len }
}
