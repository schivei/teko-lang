// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

 * pass predates the fix; a bare `last = n` inside this exact closure would build a corrupt
 * env struct THIS generation. `.value =` keeps the FieldAccess-target shape the previous seed's
 * capture walk already handles).
 *
 * @param phase       the checker phase handle from `phase_begin`
 * @param last        the caller's tick counter, updated to the latest `done`
 * @param total_cell  the caller's total-item counter, updated to the latest `total`
 * @return            the `ProgressFn` closure to pass to `type_program_with_deps_pre_mono`
 */
fn checker_tick_fn(phase: Phase, ref last: u64, ref total_cell: u64) -> checker::ProgressFn {
    (n: u64, m: u64) => {
        last.value = n
        total_cell.value = m
        phase_tick(phase, count_unit_text(n, m, "items"))
    }
}

/**
 * module_const_count — the number of module-level `checker::TConstDecl` items on a typed
 * program's item surface: the upfront total the `consteval` phase renders, since
 * `inline_consts` visits exactly the module consts and the count is known before the
 * pass runs (post-inline the scalar consts are dropped from the surface, so it must be
 * taken BEFORE).
 *
 * @param prog  the typed program about to be const-inlined
 * @return      the module-level const count
 */
fn module_const_count(prog: checker::TProgram) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TConstDecl => { n++ }
            _ => { }
        }
        i++
    }
    n
}

/**
 * append_diags — `b`'s diagnostics appended to `a`'s, in order. The build reports FILE-boundary
 * (parse) diagnostics before DECLARATION-boundary (type) ones, which is the order a reader walks
 * the pipeline in.
 *
 * @param a  the diagnostics collected first
 * @param b  the diagnostics to append
 * @return   the concatenation
 * @since 0.3.1
 */
fn append_diags(a: []str, b: []str) -> []str {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}

/**
 * Run the checker, monomorphization, and const-inlining phases over `selected` (with
 * `dep_prog`'s signatures pre-seeded), reporting ALL THREE as their own timed
 * `teko build` observability phases: `checker` ticks a live "N/M items" counter as
 * `type_program_with_deps_pre_mono` types each top-level item; `monomorph` settles
 * once with the resulting instance count (its fixpoint queue has no cheap upfront
 * total, so it renders as a count-up rather than a running "N/M" — see
 * `count_only_text`); `consteval` settles with the module-const count
 * (`module_const_count`), so an `inline_consts` failure (e.g. a const reference
 * cycle) reports under its OWN label instead of re-ending the already-settled
 * `monomorph` phase. Extracted from `frontend_body` to keep that function flat.
 *
 * @param selected  the OS-pruned, un-typed merged program
 * @param dep_prog  the already-typed dependency program (empty when depless)
 * @param report    print the phase lines (`false` for a silent/retry pass)
 * @param tty       render the phases' in-place `\r` updates
 * @param parse_diags  the FILE-boundary lex/parse diagnostics the assembly already collected, so
 *                     they are reported alongside this phase's declaration-boundary ones
 * @return          the fully checked and monomorphized program, or every collected diagnostic
 */
fn checked_program_of(selected: parser::Program, dep_prog: checker::TProgram, report: bool, tty: bool, parse_diags: []str) -> checker::TProgram | error {
    let mode = report_mode(!report, tty)
    let checker_phase = phase_begin("checker", count_unit_text(0, selected.items.len, "items"), mode)
    mut last: u64 = 0
    mut total_cell: u64 = selected.items.len
    let on_item = checker_tick_fn(checker_phase, last, total_cell)
    let pre = match checker::type_program_with_deps_pre_mono(selected, dep_prog, on_item) {
        checker::PreMono as p => p
        error as e => {
            let all = append_diags(parse_diags, teko::list::push(teko::list::empty(), e.message))
            phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), all[0])
            return error { message = join_diags(all) }
        }
    }
    // Every FILE-boundary (parse) and DECLARATION-boundary (type) diagnostic this build collected,
    // reported TOGETHER — the `teko test` shape, one line per defect. Monomorphization is NOT
    // attempted: `pre.prog` is partial by construction when anything failed to type.
    let collected = append_diags(parse_diags, pre.diags)
    if collected.len > 0 {
        phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), collected[0])
        return error { message = join_diags(collected) }
    }
    phase_end_ok(checker_phase, count_unit_text(total_cell, total_cell, "items"))

    let mono_phase = phase_begin("monomorph", count_only_text(0, "instances"), mode)
    let checked = match checker::monomorphize(pre.prog, pre.table) {
        checker::TProgram as c => c
        error as e => {
            phase_end_fail(mono_phase, count_only_text(0, "instances"), e.message)
            return e
        }
    }
    let instances = if checked.items.len > pre.prog.items.len { checked.items.len - pre.prog.items.len } else { 0 }
    phase_end_ok(mono_phase, count_unit_text(instances, instances, "instances"))

    let consts_total = module_const_count(checked)
    let consteval_phase = phase_begin("consteval", count_unit_text(0, consts_total, "consts"), mode)
    match checker::inline_consts(checked) {
        checker::TProgram as inlined => {
            phase_end_ok(consteval_phase, count_unit_text(consts_total, consts_total, "consts"))
            inlined
        }
        error as e => {
            phase_end_fail(consteval_phase, count_unit_text(0, consts_total, "consts"), e.message)
            return e
        }
    }
}

/**
 * The PARSED front-end product — the manifest plus the merged, un-typed program, the
 * output of `frontend_parse` and the input of `frontend_check`. Splitting the two
 * lets the gated build PARSE THE TREE ONCE and derive BOTH the gate program (with
 * `.tkt` tests) and the release program (`filter_tkt`) from the same parse, instead
 * of re-lexing/re-parsing the whole corpus for the release rebuild (the historical
 * silent re-front-end).
 *
 * @field parsed    the merged, OS-unpruned, un-typed program (with or without `.tkt`
 *                  items, per the `include_tests` the parse ran with)
 * @field manifest  the parsed project manifest
 */
type ParsedFront = struct {
    parsed: parser::Program
    manifest: Manifest
    /** every FILE-boundary lex/parse diagnostic the assembly collected (empty on a clean parse).
        Carried rather than raised so the CHECKER still runs over the files that DID parse and the
        build reports every file's defect in one pass (owner ruling 2026-07-26). */
    diags: []str
}

/**
 * The PARSE half of the front-end (manifest -> discover -> assemble), operating in
 * the CURRENT directory (the caller has already chdir'd). Reads and parses the
 * manifest, discovers the source tree, injects the project-root `main.tks`, checks
 * the A4 main-file rule, prints the build banner, and assembles every eligible file
 * into ONE merged (un-typed) program.
 *
 * @param include_tests  assemble the `.tkt` test files into the merged program too
 * @param quiet          suppress the banner and the `lexer`/`parser` phase output
 * @param tty            render the phases' in-place `\r` updates
 * @return               the parsed program and manifest, or the first error
 */
fn frontend_parse(include_tests: bool, quiet: bool, tty: bool) -> ParsedFront | error {
    // --- find + read + parse the manifest (the single <name>.tkp at the root — A1) ---
    let mname = match find_manifest() { str as n => n; error as e => return e }
    let mtext = match teko::io::read_file(mname) { str as s => s; error => return error { message = "cannot read .tkp manifest" } }
    let m = match parse_manifest(mtext) { Manifest as x => x; error as e => return e }

    // --- discover the source tree (A2) ---
    mut files = match discover(m.name, m.source) { []SourceFile as f => f; error as e => return e }

    // The entry MainFile lives at the PROJECT ROOT, not under `source` (discover walks only
    // `source`). Inject it into the file set so the merged program has an entry, tagged with
    // the bare root namespace (provenance). Skip it if absent (a library).
    match teko::io::read_file("main.tks") {
        str => files = teko::list::push(files, SourceFile { path = "main.tks"; namespace = m.name })
        error => { }
    }

    // --- C7.9: A4 main-file rule — Binary REQUIRES main.tks; library kinds FORBID it ---
    mut has_main = false
    mut mi: u64 = 0
    loop {
        if mi >= files.len { break }
        if teko::str::ends_with(files[mi].path, "main.tks") { has_main = true; break }
        mi = mi + 1
    }
    match check_main_file_rule(m.artifact, has_main) { Artifact => { }; error as e => return e }

    if !quiet {
        teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
        teko::io::eprintln(teko::str::concat("project '", m.name, teko::str::concat("' (source=", m.source, ")")))
    }

    // --- assemble: read+parse every file, MERGE into ONE program (A3) ---
    // assemble bakes file:line:col into the message, so report with an empty path (W-loc).
    let asm = match assemble_sel(files, include_tests, !quiet, tty) { Assembled as a => a; error as e => return e }

    ParsedFront { parsed = asm.program; manifest = m; diags = asm.diags }
}

/**
 * The CHECK half of the front-end (prune-os -> load-deps -> check+monomorphize) over
 * an already-parsed program. Deterministic in its input: two calls over the same
 * `ParsedFront` produce the same checked program — the property the parse-once gated
 * build relies on (the release program is `frontend_check(filter_tkt(parse))`,
 * byte-equivalent to the historical re-parsed release front-end).
 *
 * @param pf     the parsed program and manifest from `frontend_parse`
 * @param quiet  suppress the `checker`/`monomorph` phase output
 * @param tty    render the phases' in-place `\r` updates
 * @return       the checked program and manifest, or the first error
 */
fn frontend_check(pf: ParsedFront, quiet: bool, tty: bool) -> Frontend | error {
    // --- C7.1f: keep only the target OS's `#os("…")` function variants (conditional compilation) ---
    let selected = prune_os(pf.parsed, target_os(pf.manifest))

    // --- C7.10: load dep .tkl packages and prepend their typed items before type-checking ---
    // The dep's TProgram items carry their own namespaces (set when they were originally checked);
    // we pre-seed the collection environment with them so the project's code can call dep functions
    // and reference dep types. m.deps is empty when there is no [dependencies] section → no-op.
    let dep_prog = match load_deps_program(pf.manifest) { checker::TProgram as p => p; error as e => return e }

    let checked = match checked_program_of(selected, dep_prog, !quiet, tty, pf.diags) { checker::TProgram as c => c; error as e => return e }
