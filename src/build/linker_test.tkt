/**
 * refusal_of — the message `resolve_linker` would carry for an impossible pair, or "" when it
 * unexpectedly resolved to a linker. (`src/build/linker_test.tkt`, the linker probe's tests.)
 *
 * @param arch  the machine the link must target
 * @param fmt   the container format the link must emit
 * @return      the refusal message, or "" when a linker was found
 */
fn refusal_of(arch: LinkArch, fmt: LinkFormat) -> str {
    match resolve_linker(arch, fmt) { str => ""; error as e => e.message }
}

#test
fn mingw_is_recognised_by_token_and_by_path() {
    teko::assert::is_true(linker_is_mingw("x86_64-w64-mingw32-ld"))
    teko::assert::is_true(linker_is_mingw("/mingw64/bin/ld"))
    teko::assert::is_true(linker_is_mingw("C:/msys64/mingw64/bin/ld.exe"))
    teko::assert::is_false(linker_is_mingw("ld.lld"))
    teko::assert::is_false(linker_is_mingw("lld-link"))
    teko::assert::is_false(linker_is_mingw("ld"))
}

/**
 * mingw_is_recognised_in_every_triple_spelling — the TRIPLE recogniser convicts MinGW however the
 * driver spells it: gcc's `x86_64-w64-mingw32`, clang's `x86_64-w64-windows-gnu` (which contains no
 * `mingw` at all, and is the reason `MINGW_TRIPLE_ABI_TOKEN` exists), and the 32-bit / `pc`-vendor
 * forms.
 *
 * @return void
 */
#test
fn mingw_is_recognised_in_every_triple_spelling() {
    teko::assert::is_true(triple_is_mingw("x86_64-w64-mingw32"))
    teko::assert::is_true(triple_is_mingw("i686-w64-mingw32"))
    teko::assert::is_true(triple_is_mingw("x86_64-w64-windows-gnu"))
    teko::assert::is_true(triple_is_mingw("x86_64-pc-windows-gnu"))
    teko::assert::is_true(triple_is_mingw("aarch64-w64-mingw32"))
}

/**
 * a_legitimate_toolchain_triple_is_not_mingw — every triple the project actually builds through has
 * to pass: the MSVC target the Windows default pins, both Linux ABIs, and macOS. A ban that
 * convicted one of these would refuse the host toolchain of a supported platform, which is a worse
 * failure than the one it guards against.
 *
 * @return void
 */
#test
fn a_legitimate_toolchain_triple_is_not_mingw() {
    teko::assert::is_false(triple_is_mingw("x86_64-pc-windows-msvc"))
    teko::assert::is_false(triple_is_mingw("aarch64-pc-windows-msvc"))
    teko::assert::is_false(triple_is_mingw("x86_64-linux-gnu"))
    teko::assert::is_false(triple_is_mingw("x86_64-unknown-linux-musl"))
    teko::assert::is_false(triple_is_mingw("aarch64-linux-gnu"))
    teko::assert::is_false(triple_is_mingw("arm64-apple-darwin24"))
}

/**
 * an_unreadable_triple_is_unknown_and_not_a_violation — a driver that does not understand
 * `-dumpmachine` yields "" from the probe, and "" must read as "this host could not tell me", never
 * as a conviction. Anything else would refuse every toolchain that merely declines to answer.
 *
 * @return void
 */
#test
fn an_unreadable_triple_is_unknown_and_not_a_violation() {
    teko::assert::is_false(triple_is_mingw(""))
    teko::assert::is_false(triple_is_mingw("unknown"))
}

/**
 * the_ban_reason_is_one_text_shared_by_both_routes — the native route's refusal quotes the same
 * `MINGW_BAN_REASON` the C route's does, owner's words included, so whichever route a reader hits
 * teaches the same law from the same sentence.
 *
 * @return void
 */
#test
fn the_ban_reason_is_one_text_shared_by_both_routes() {
    teko::assert::str_contains(MINGW_BAN_REASON, "forbidden")
    teko::assert::str_contains(MINGW_BAN_REASON, "proibido")
    teko::assert::str_contains(MINGW_BAN_REASON, "EMULATED")
    teko::assert::str_contains(mingw_rejected_error("x86_64-w64-mingw32-ld", LinkArch::X8664).message, MINGW_BAN_REASON)
}

#test
fn every_elf_pair_has_an_emulation_to_assert_with() {
    teko::assert::is_true(gnu_emulation_for(LinkArch::X8664, LinkFormat::Elf) == "elf_x86_64")
    teko::assert::is_true(gnu_emulation_for(LinkArch::Arm64, LinkFormat::Elf) == "aarch64linux")
}

#test
fn mach_o_has_no_gnu_emulation_and_says_so() {
    teko::assert::is_true(gnu_emulation_for(LinkArch::Arm64, LinkFormat::Macho) == "")
    teko::assert::is_true(gnu_emulation_for(LinkArch::X8664, LinkFormat::Macho) == "")
}

#test
fn candidate_tables_exclude_mingw_everywhere() {
    let pe = linker_candidates(LinkArch::X8664, LinkFormat::Pe)
    teko::assert::is_true(pe.len > 0)
    mut i: u64 = 0
    loop {
        if i >= pe.len { break }
        teko::assert::is_false(linker_is_mingw(pe[i]))
        i = i + 1
    }
    let elf = linker_candidates(LinkArch::X8664, LinkFormat::Elf)
    teko::assert::is_true(elf.len > 0)
    mut j: u64 = 0
    loop {
        if j >= elf.len { break }
        teko::assert::is_false(linker_is_mingw(elf[j]))
        j = j + 1
    }
}

#test
fn a_pe_pair_with_no_target_is_refused_by_name_not_defaulted() {
    let msg = refusal_of(LinkArch::Arm64, LinkFormat::Pe)
    teko::assert::is_true(msg.len > 0)
    teko::assert::str_contains(msg, "arm64")
    teko::assert::str_contains(msg, "PE")
    teko::assert::str_contains(msg, "Tried:")
}

#test
fn the_mingw_refusal_teaches_why() {
    let msg = mingw_rejected_error("x86_64-w64-mingw32-ld", LinkArch::X8664).message
    teko::assert::str_contains(msg, "MinGW")
    teko::assert::str_contains(msg, "x86_64")
    teko::assert::str_contains(msg, "EMULATED")
    teko::assert::str_contains(msg, "lld-link")
}

#test
fn the_candidate_list_is_readable_in_a_diagnostic() {
    let none: []str = teko::list::empty()
    teko::assert::is_true(join_candidates(none) == "(none)")
    teko::assert::is_true(join_candidates(linker_candidates(LinkArch::X8664, LinkFormat::Pe)) == "lld-link")
}

/**
 * the_pe_table_names_no_tool_a_windows_path_would_hijack — the PE arm names `lld-link` and nothing
 * whose spelling another program answers to.
 *
 * MEASURED, on the project's own Windows runner, in the shell CI uses: `command -v link.exe` answers
 * `/usr/bin/link.exe`, the MSYS `ln` clone — so the bare `link` token this list used to carry named a
 * hard-link utility, never MSVC's linker (which is absent from that PATH entirely). Asserted as "the
 * token is not in the table" rather than as a probe result, because the probe rejecting it would be
 * luck and this is a rule.
 *
 * @return void
 */
#test
fn the_pe_table_names_no_tool_a_windows_path_would_hijack() {
    let pe = linker_candidates(LinkArch::X8664, LinkFormat::Pe)
    teko::assert::is_true(pe.len == 1)
    teko::assert::is_true(pe[0] == "lld-link")
    mut i: u64 = 0
    loop {
        if i >= pe.len { break }
        teko::assert::is_false(pe[i] == "link")
        teko::assert::is_false(pe[i] == "link.exe")
        i = i + 1
    }
}

/**
 * the_host_elf_linker_is_found_and_asserts_its_machine — resolving ELF/x86_64 on the host yields
 * either a non-MinGW linker or the named refusal, and never a silent default.
 *
 * linux-x86_64 is the only host this suite can assert on natively; on any other host the pair is
 * genuinely absent and the refusal IS the correct answer, so both outcomes are accepted — what is
 * under test is that neither one is a quiet fallback to whatever the PATH holds.
 */
#test
fn the_host_elf_linker_is_found_and_asserts_its_machine() {
    match resolve_linker(LinkArch::X8664, LinkFormat::Elf) {
        str as cmd => teko::assert::is_false(linker_is_mingw(cmd))
        error as e => teko::assert::str_contains(e.message, "no linker on this host targets")
    }
}
