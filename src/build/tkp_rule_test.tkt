
fn rule_ok(artifact: Artifact, has_main: bool): bool {
    match check_main_file_rule(artifact, has_main) { Artifact => true; error => false }
}

#test
fn enforces_main_file_rule() {
    teko::assert::is_true(rule_ok(Artifact::Binary, true))
    teko::assert::is_false(rule_ok(Artifact::Binary, false))
    teko::assert::is_true(rule_ok(Artifact::Static, false))
    teko::assert::is_false(rule_ok(Artifact::Static, true))
    teko::assert::is_true(rule_ok(Artifact::Shared, false))
    teko::assert::is_true(rule_ok(Artifact::Package, false))
    teko::assert::is_false(rule_ok(Artifact::Package, true))
}
