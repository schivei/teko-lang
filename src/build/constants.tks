// src/build/constants.tks   (namespace 'teko::build')
//
// Module-level constants for the build subsystem.

/**
 * DEFAULT_PROJECT_NAME — the generic fallback project name `teko init` offers
 * when no better default can be derived: an empty/all-slash target path
 * (`basename`), an empty candidate name (`sanitize_ident`), or an unreadable
 * current directory (`default_project_name`).
 */
const DEFAULT_PROJECT_NAME: str = "app"

/**
 * REGR_NS_PER_MS — nanoseconds in a millisecond, the unit every rendered duration is rounded to.
 */
const REGR_NS_PER_MS: i64 = 1000000

/**
 * REGR_MS_PER_S — milliseconds in a second, the split point of the `s`/`ms` rendering.
 */
const REGR_MS_PER_S: i64 = 1000

/**
 * REGR_PERCENT — the whole, for the phase-share percentages.
 */
const REGR_PERCENT: i64 = 100

/**
 * REGR_SLOWEST_DEFAULT — how many of the slowest rows the default report lists. 262 scenarios times
 * one line each is noise nobody reads; the top slice is what points at a detractor. `--regr-timings`
 * dumps every row for a diff between runs.
 */
const REGR_SLOWEST_DEFAULT: u64 = 20

/**
 * REGR_TIMINGS_FLAG — the argv flag that switches the report from "totals + tables" to "every row".
 */
const REGR_TIMINGS_FLAG: str = "--regr-timings"
