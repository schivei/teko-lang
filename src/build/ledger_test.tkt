/**
 * ledger_test.tkt — the build-law fixtures (`docs/design/modelo-de-build-0.3.1.md` §5). They assert
 * the STRUCTURE of a phase ledger and the `dark`/`overlap` decomposition of `ledger_reconcile`, never
 * a measured ns: every ledger here is built from LITERAL durations, so the rendered `dark`/`overlap`
 * strings are deterministic. The law is an INEQUALITY (`wall <= Σphases`): `dark == 0` is the sole
 * defect, `overlap >= 0` is the parallelism gain and never fails. The fixtures print the rendered
 * label/dark/overlap lines and MATCH the string — no exit code, no absolute ns.
 */

/**
 * ledger_of3 — a three-phase ledger from explicit labels and durations, so a fixture reads its
 * expected `Σns` straight off the literals it passed in.
 *
 * @param la  the first phase label
 * @param na  the first phase duration (ns)
 * @param lb  the second phase label
 * @param nb  the second phase duration (ns)
 * @param lc  the third phase label
 * @param nc  the third phase duration (ns)
 * @return    the assembled ledger, in settle order
 */
fn ledger_of3(la: str, na: i64, lb: str, nb: i64, lc: str, nc: i64): PhaseLedger {
    var l = empty_ledger()
    l = ledger_record(l, la, na)
    l = ledger_record(l, lb, nb)
    l = ledger_record(l, lc, nc)
    l
}

/**
 * ledger_records_phases_in_order — F1: a build with N known phases deposits N labels in the ledger, in
 * settle order, and `ledger_total_ns` sums their durations. The label line is the ledger's structural
 * face — WHICH phases were named and in what order — never a timing.
 */
#test
fn ledger_records_phases_in_order() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    var labels = ledger_labels_line(l)
    teko::io::println(labels)
    teko::assert::eq_str(labels, "parse,checker,link")
    teko::assert::eq_i64(ledger_total_ns(l), 600)
}

/**
 * native_phase_names_are_in_the_ledger — F3: the native backend is no longer mute. A ledger built from
 * the six own-backend phase names renders them in the exact order the tails settle them, so a native
 * build's ledger contains `link` (the `cc`-as-linker step that used to report nothing). Presence and
 * order, not the ns.
 */
#test
fn native_phase_names_are_in_the_ledger() {
    var l = empty_ledger()
    l = ledger_record(l, "lower", 10)
    l = ledger_record(l, "isel", 10)
    l = ledger_record(l, "regalloc", 10)
    l = ledger_record(l, "encode", 10)
    l = ledger_record(l, "objfile", 10)
    l = ledger_record(l, "link", 10)
    var labels = ledger_labels_line(l)
    teko::io::println(labels)
    teko::assert::eq_str(labels, "lower,isel,regalloc,encode,objfile,link")
}

/**
 * reconcile_sequential_has_zero_dark_and_zero_overlap — F2, the sequential regime: when the wall equals
 * the sum of phases, no time is unattributed and none is concurrent, so the law holds with EQUALITY —
 * `dark == 0` and `overlap == 0`. Never asserted as `wall == Σ`; asserted as the decomposition being
 * both-zero.
 */
#test
fn reconcile_sequential_has_zero_dark_and_zero_overlap() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 600) {
        Reconciliation as r => {
            var line = reconciliation_line(r)
            teko::io::println(line)
            teko::assert::eq_str(line, "dark=0 overlap=0")
            teko::assert::eq_i64(r.dark, 0)
        }
        error => teko::assert::is_true(false)
    }
}

/**
 * reconcile_parallel_reports_overlap_and_never_fails — F2, the parallel regime: when the sum of phases
 * EXCEEDS the wall (concurrent lead times counted twice in the sum but living on one wall), the law
 * holds with strict `<` — `dark == 0` and `overlap == Σns − wall`. This is the parallelism gain, NOT a
 * defect: `ledger_reconcile` must return it, never error. Trapping here was the removed rule that would
 * break the day threads land.
 */
#test
fn reconcile_parallel_reports_overlap_and_never_fails() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 500) {
        Reconciliation as r => {
            var line = reconciliation_line(r)
            teko::io::println(line)
            teko::assert::eq_str(line, "dark=0 overlap=100")
            teko::assert::eq_i64(r.dark, 0)
        }
        error => teko::assert::is_true(false)
    }
}

/**
 * reconcile_dark_time_is_the_only_defect — F2, the defect regime: when the wall EXCEEDS the sum of
 * phases there is wall that no phase names — the owner's dark time — and `ledger_reconcile` is the ONE
 * place that fails, returning an error. `dark > 0` is the sole failure of the law.
 */
#test
fn reconcile_dark_time_is_the_only_defect() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 700) {
        Reconciliation as _ => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

/**
 * build_clock_wall_is_never_negative — the top-of-command clock measures a real monotonic span, so the
 * external wall it reports for a just-opened clock is `>= 0`. The clock is the reading `main` weighs
 * against the ledger; it can never run backwards.
 */
#test
fn build_clock_wall_is_never_negative() {
    var c = build_clock_start()
    teko::assert::is_true(build_clock_wall(c) >= 0)
}
