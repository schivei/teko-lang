
fn ledger_of3(la: str, na: i64, lb: str, nb: i64, lc: str, nc: i64): PhaseLedger {
    var l = empty_ledger()
    l = ledger_record(l, la, na)
    l = ledger_record(l, lb, nb)
    l = ledger_record(l, lc, nc)
    l
}

#test
fn ledger_records_phases_in_order() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    var labels = ledger_labels_line(l)
    teko::io::println(labels)
    teko::assert::eq_str(labels, "parse,checker,link")
    teko::assert::eq_i64(ledger_total_ns(l), 600)
}

#test
fn native_phase_names_are_in_the_ledger() {
    var l = empty_ledger()
    l = ledger_record(l, "lower", 10)
    l = ledger_record(l, "isel", 10)
    l = ledger_record(l, "regalloc", 10)
    l = ledger_record(l, "encode", 10)
    l = ledger_record(l, "objfile", 10)
    l = ledger_record(l, "link", 10)
    var labels = ledger_labels_line(l)
    teko::io::println(labels)
    teko::assert::eq_str(labels, "lower,isel,regalloc,encode,objfile,link")
}

#test
fn reconcile_sequential_has_zero_dark_and_zero_overlap() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 600) {
        Reconciliation as r => {
            var line = reconciliation_line(r)
            teko::io::println(line)
            teko::assert::eq_str(line, "dark=0 overlap=0")
            teko::assert::eq_i64(r.dark, 0)
        }
        error => teko::assert::is_true(false)
    }
}

#test
fn reconcile_parallel_reports_overlap_and_never_fails() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 500) {
        Reconciliation as r => {
            var line = reconciliation_line(r)
            teko::io::println(line)
            teko::assert::eq_str(line, "dark=0 overlap=100")
            teko::assert::eq_i64(r.dark, 0)
        }
        error => teko::assert::is_true(false)
    }
}

#test
fn reconcile_dark_time_is_the_only_defect() {
    var l = ledger_of3("parse", 100, "checker", 200, "link", 300)
    match ledger_reconcile(l, 700) {
        Reconciliation as _ => teko::assert::is_true(false)
        error => teko::assert::is_true(true)
    }
}

#test
fn build_clock_wall_is_never_negative() {
    var c = build_clock_start()
    teko::assert::is_true(build_clock_wall(c) >= 0)
}
