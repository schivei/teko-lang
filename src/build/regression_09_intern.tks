/**
 * collect_tkcov_files — recursively list every `*.tkcov` file under `dir` (the regression scratch
 * work tree), depth-first. `teko::fs::list_dir` doubles as the is-directory probe here: an entry
 * `list_dir` can open is a subdirectory (recurse into it), one it cannot is a plain file (keep it
 * when its name ends `.tkcov`). A plain (non-instrumented) regression run creates none, so this
 * walk then returns `[]`.
 *
 * @param dir  the directory to walk (the regression scratch work tree, or one of its subdirectories)
 * @return     every `.tkcov` file path found, in directory-listing order
 * @since 0.3.1
 */
fn collect_tkcov_files(dir: str) -> []str {
    mut out: []str = teko::list::empty()
    let entries = match teko::fs::list_dir(dir) { []str as e => e; error => return out }
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let full = dir ~ "/" ~ entries[i]
        match teko::fs::list_dir(full) {
            []str => {
                let sub = collect_tkcov_files(full)
                mut si: u64 = 0
                loop { if si >= sub.len { break }; out = teko::list::push(out, sub[si]); si = si + 1 }
            }
            error => { if teko::str::ends_with(full, ".tkcov") { out = teko::list::push(out, full) } }
        }
        i = i + 1
    }
    out
}

/**
 * RegrBuildKind — which build shape a `RegrBuilt` cache slot holds. `None` is the empty slot;
 * the other three are the shapes `tkr_ensure_artifact` can be asked for, and a slot only satisfies
 * a scenario asking for its OWN kind (see `RegrBuilt.kind` for what keying on `done` alone cost).
 *
 * @since 0.3.1
 */
type RegrBuildKind = enum { None; Project; Dependency; InPlace }

/**
 * RegrSrcBuild — ONE cached `Given source = "<file>"` build: the `key` it is filed under, the
 * captured build outcome, and the binary it produced.
 *
 * @since 0.3.1
 */
type RegrSrcBuild = struct {
// the (source file, declared env) identity this build answers for (`regr_src_key`).
    key: str
// the captured build outcome, replayed verbatim to every later row with the same key.
    comp: CapResult
// the scratch binary this build produced (meaningful when `comp.exit == 0`).
    binp: str
}

/**
 * regr_src_key — the identity of a standalone-source build: the source FILE plus the row's DECLARED
 * env, joined by a newline (neither a path nor a `K=V` token may contain one, so no two distinct
 * builds can collide into one key).
 *
 * KEYED ON THE ENV, NOT ON THE FILE ALONE, and that is the whole safety argument. Two rows naming
 * the same file under a different `Given target`/`Given env` are legitimately
 * DIFFERENT builds — collapsing them is the same defect class `RegrBuilt` already produced in this
 * repo when it was keyed on `done` alone: a green row asserting an artifact it never built. The
 * F5 corpus is the live proof — `own_differential.tks` is named by four configurations at once.
 *
 * The env keyed on is the row's DECLARED env, never the coverage-augmented one: `with_regr_cov_env`
 * appends a `TEKO_TKCOV=<prefix>.tkcov` token built from the ROW's scratch prefix, so no two rows
 * ever share that env and a key including it could never hit.
 *
 * @param srcp  the resolved source file path
 * @param env   the row's declared child env (`K=V` tokens)
 * @return      the cache key
 * @since 0.3.1
 */
fn regr_src_key(srcp: str, env: []str) -> str {
    mut out = srcp
    mut i: u64 = 0
    loop {
        if i >= env.len { break }
        out = out ~ "\n" ~ env[i]
        i = i + 1
    }
    out
}

/**
 * regr_src_lookup — the cached standalone-source build filed under `key`, or `null` when this
 * `.tkr` file has not built it yet.
 *
 * @param built  the shared cache slot carried into this row
 * @param key    the identity to look for (`regr_src_key`)
 * @return       the cached build, or `null`
 * @since 0.3.1
 */
fn regr_src_lookup(built: RegrBuilt, key: str) -> RegrSrcBuild | null {
    mut i: u64 = 0
    loop {
        if i >= built.srcs.len { break }
        if built.srcs[i].key == key { return built.srcs[i] }
        i = i + 1
    }
    null
}

/**
 * regr_src_remember — `built` with the standalone-source build `entry` added to its cache.
 *
 * @param built  the cache slot to extend
 * @param entry  the build to file
 * @return       the extended cache slot
 * @since 0.3.1
 */
fn regr_src_remember(built: RegrBuilt, entry: RegrSrcBuild) -> RegrBuilt {
    RegrBuilt { done = built.done; kind = built.kind; comp = built.comp; binp = built.binp; srcs = teko::list::push(built.srcs, entry) }
}

/**
 * tkr_standalone_artifact — resolve a `Given source = "<file>"` row's artifact, building the file
 * at most ONCE per (file, declared env) per `.tkr` (`regr_src_key`).
 *
 * Every row this serves after the first reports `fresh = false`, exactly as a second row of a shared
 * PROJECT build does: the measurement must not re-count a build the run never performed. Before this
 * cache the three `F8 target` rows compiled the identical one-line file three times to read three
 * substrings out of the identical diagnostic.
 *
 * @param exe       the absolute path to this compiler binary
 * @param srcp      the resolved source file path
 * @param t         the lowered row
 * @param prefix    the row's scratch-file prefix (used only when this row is the one that BUILDS)
 * @param built     the shared cache slot
 * @return          the row's artifact, with the cache slot threaded back
 * @since 0.3.1
 */
fn tkr_standalone_artifact(exe: str, srcp: str, t: Tkr, prefix: str, built: RegrBuilt) -> TkrArtifact {
    let key = regr_src_key(srcp, t.env)
    match regr_src_lookup(built, key) {
        RegrSrcBuild as hit => return TkrArtifact { comp = hit.comp; binp = hit.binp; built = built; fresh = false }
        null => { }
    }
    let comp = compile_standalone_source(exe, srcp, with_regr_cov_env(t.env, prefix), prefix)
    let binp = artifact_path_for_target(snippet_project_binp(prefix), t.target)
    TkrArtifact { comp = comp; binp = binp; built = regr_src_remember(built, RegrSrcBuild { key = key; comp = comp; binp = binp }); fresh = true }
}

/**
 * RegrBuilt — the lazily-built artifact of a project-based regressor: whether the project's `.tkp`
 * has been compiled yet (`done`), the captured build outcome (`comp`), and the built binary path
 * (`binp`). Threaded so several RUN scenarios (across features, across an entire `.tkr` file) share
 * ONE compile (a project's `.tkp` is compiled at most once per file), while an inline/explicit-file/
 * dependency-provisioned scenario compiles its OWN artifact and never touches this cache
 * (`tkr_ensure_artifact`).
 *
 * @since 0.3.0.30
 */
type RegrBuilt = struct {
// true once the project has been compiled (the compile is attempted at most once).
    done: bool
//
// WHICH build shape produced `comp`/`binp`. The cache is keyed on it, because the three shapes
// compile genuinely different things: `Project` is `teko <dir> -o bin` from the runner's cwd,
// `Dependency` is a SCRATCH consumer copy whose `packages/` was provisioned from a sub-project,
// and `InPlace` is `cd <dir> && teko . -o bin` (the #64 CWD-relative shape). Before this field
// existed the cache was keyed on `done` alone, so a `.tkr` holding two of the three shapes had
// whichever scenario ran FIRST serve the others — the later one asserted the earlier one's
// artifact and passed without ever exercising the shape it names.
//
    kind: RegrBuildKind
// the captured build outcome (meaningful once `done`).
    comp: CapResult
// the built binary path (meaningful once `done` and the build succeeded).
    binp: str
//
// every `Given source = "<file>"` build this `.tkr` has already paid for, keyed on (file,
// declared env) — `tkr_standalone_artifact`. Separate from the single `done`/`kind` slot above
// because a standalone source is not the PROJECT: a `.tkr` may name many of them, and two rows
// naming the same one under the same configuration are one build, not two.
//
    srcs: []RegrSrcBuild
}

/**
 * tkr_ensure_built — compile the regressor project once (lazily), returning the shared `RegrBuilt`.
 * A no-op when `built.done` (the project is compiled at most once per `.tkr` file).
 *
 * @param exe       the absolute path to this compiler binary
 * @param regr_dir  the regressor project directory
 * @param env       the per-scenario child env for the FIRST scenario reaching this cache slot
 * @param prefix    the scratch-file prefix for the compile
 * @param built     the current build state
 * @return          the build state, compiled when it was not already
 * @since 0.3.0.30
 */
fn tkr_ensure_built(exe: str, regr_dir: str, env: []str, prefix: str, built: RegrBuilt) -> RegrBuilt {
    if regr_built_serves(built, RegrBuildKind::Project) { return built }
    let comp = compile_regressive(exe, regr_dir, env, prefix ~ ".compile")
    let name = match regressive_name(regr_dir) { str as s => s; error => "" }
    RegrBuilt { done = true; kind = RegrBuildKind::Project; comp = comp; binp = regr_dir ~ "/bin/" ~ name; srcs = built.srcs }
}

/**
 * regr_built_serves — may the cache slot `built` serve a scenario asking for a `want`-shaped build?
 * Only when it holds a completed build OF THAT SHAPE. A slot of a different shape does NOT serve:
 * the caller compiles what it actually asked for and replaces the slot, so a `.tkr` mixing shapes
 * pays one build per shape instead of silently asserting the wrong artifact.
 *
 * @param built  the cache slot carried into this scenario
 * @param want   the build shape the scenario needs
 * @return       true when `built` already holds a `want`-shaped artifact
 * @since 0.3.1
 */
fn regr_built_serves(built: RegrBuilt, want: RegrBuildKind) -> bool {
    if !built.done { return false }
    built.kind == want
}

/**
 * guard_no_project_build_at_root — REFUSE a scenario that would compile the project ROOT itself
 * (the compiler) as a regressor. A root-listed `regressor.tkr` scenario MUST be snippet-scoped
 * (inline `source` / explicit `source` file); a `built and run` with no source at `regr_dir ==
 * "."`/"" would rebuild the compiler and recurse. Returns an honest error in that case, else
 * null. The structural half of the self-project anti-recursion guard; the `TEKO_IN_REGRESSION`
 * sentinel is the backstop.
 *
 * @param regr_dir  the regressor directory (dirname of the listed `.tkr`)
 * @param t         the lowered scenario
 * @return          an error when the scenario would build the project root, else null
 * @throws          when `regr_dir` is the project root and the scenario has no inline/explicit source
 * @since 0.3.1
 */
fn guard_no_project_build_at_root(regr_dir: str, t: Tkr) -> null | error {
    let at_root = regr_dir == "." || regr_dir.len == 0
    let has_src = t.source_inline.len > 0 || t.source_file.len > 0
    if at_root && !has_src {
        return error { message = "regressor.tkr scenario at the project root has no inline/explicit `source` — it would rebuild the compiler root" }
    }
    null
}
