// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → VM, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end, then diverge at the
// backend (codegen→cc) vs the VM.

use teko::parser
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

// =========================================================================
// project_dir_of — mirror main.c::project_dir_of. Resolve a project ARGUMENT to its
// directory: a `.tkp` path resolves to its CONTAINING directory ("." when it has no path
// separator); anything else is taken as the directory as-is.
// =========================================================================
fn project_dir_of(arg: str) -> str {
    if !teko::str::ends_with(arg, ".tkp") {
        return arg
    }
    match teko::str::last_index_of(arg, "/") {
        u64 as i => teko::str::slice_to(arg, i)   // ".../foo.tkp" → ".../" stem before the last slash
        error => "."   // no separator → the current directory
    }
}

// =========================================================================
// The shared front-end result — Teko's stand-in for project_frontend's two out-params.
// =========================================================================
type Frontend = struct {
    prog: checker::TProgram
    manifest: Manifest
}

// Report a stage failure to stderr in the driver's canonical form and return status 1.
// An empty path means the message already carries its own file:line:col (a per-file
// assemble / checker diagnostic) — print it bare, with no redundant location prefix.
fn fail(path: str, message: str) -> i32 {
    if path == "" {
        teko::io::eprint(teko::str::concat("teko: ", message))
    } else {
        teko::io::eprint(teko::str::concat("teko: ", path, teko::str::concat(": ", message)))
    }
    1
}

// =========================================================================
// find_manifest — mirror driver.c::find_manifest. Scan the CURRENT directory for the
// single `<name>.tkp` manifest (self-describing — glob the extension, don't hardcode a
// name). Yields the manifest filename, or an error when there is none / more than one.
// (Contained host edge — M.1; the dir listing is the deferred teko::fs::list_dir FFI.)
// =========================================================================
fn find_manifest() -> str | error {
    let entries = match teko::fs::list_dir(".") { []str as e => e; error as e => return e }
    mut found = ""
    mut count: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        let name = entries[i]
        if teko::str::ends_with(name, ".tkp") {
            found = name
            count = count + 1
        }
        i++
    }
    if count != 1 {
        return error { message = "no single .tkp manifest in project directory" }
    }
    found
}

// =========================================================================
// project_frontend — mirror driver.c::project_frontend. Enter `dir` (so relative `source`
// and discovered paths resolve from the root), find + read + parse the single `<name>.tkp`,
// discover the source tree, inject the project-root `main.tks` (tagged with the manifest
// name as namespace), report the file → namespace map, assemble all files into ONE merged
// program, and type-check the WHOLE thing together (M.1). Returns the checked program +
// the manifest, or the first error.
// =========================================================================
fn project_frontend(dir: str) -> Frontend | error { project_frontend_sel(dir, false) }

// project_frontend_sel — the front-end with a test selector. `include_tests=true` (the `teko
// test` path) assembles the `.tkt` test files INTO the merged program so their `#test` functions
// are typed + available to the VM runner; `false` is the production build/run front-end.
fn project_frontend_sel(dir: str, include_tests: bool) -> Frontend | error {
    // Enter the project root so relative source paths resolve (the contained host edge).
    match teko::env::chdir(dir) { error => return error { message = "cannot enter project directory" }; null => { } }   // error? — null = success
    frontend_body(include_tests, false, output_is_tty(false))
}

// (C7.1f) #os conditional compilation — the TARGET OS for guard selection: derived from the
// `[extern] target` triple when set, else the host `teko::os()`.
fn target_os(m: Manifest) -> str {
    if m.target.len > 0 {
        if teko::str::contains(m.target, "linux") { return "linux" }
        if teko::str::contains(m.target, "darwin") || teko::str::contains(m.target, "macos") || teko::str::contains(m.target, "apple") { return "macos" }
        if teko::str::contains(m.target, "windows") || teko::str::contains(m.target, "mingw") || teko::str::contains(m.target, "w64") { return "windows" }
    }
    teko::os()
}

// (C7.1f) drop every `#os("…")`-guarded function whose guard ≠ the target OS, so only the current
// platform's variant compiles. Unguarded items (os_guard == "") always pass through.
fn prune_os(program: parser::Program, tos: str) -> parser::Program {
    mut kept: []parser::Item = teko::list::empty()
    mut i = 0
    loop {
        if i >= program.items.len { break }
        let it = program.items[i]
        mut keep = true
        match it.content {
            parser::Function as f => { if f.os_guard != "" && f.os_guard != tos { keep = false } }
            _ => { }
        }
        if keep { kept = teko::list::push(kept, it) }
        i++
    }
    parser::Program { items = kept }
}

// =========================================================================
// C7.10 — DEP LOADING: load each dep's .tkl package, extract its .tkb, deserialize
// the TProgram, and return all dep items concatenated. The dep items are prepended to
// the project's own items so they land in scope before the main code is type-checked.
// Search strategy: look for `<dep>-*.tkl` in a `packages/` subdirectory of the project
// root (cwd after the front-end chdir). If not found, return an honest error.
// =========================================================================

// load_dep_program — load one dep by package name, returning its TProgram.
// Searches `packages/<name>-*.tkl` (takes the first match) in the current directory.
fn load_dep_program(dep: str) -> checker::TProgram | error {
    // List the packages/ directory to find `<dep>-*.tkl`.
    let entries = match teko::fs::list_dir("packages") {
        []str as e => e
        error => return error { message = teko::str::concat("teko: dep '", dep, "': packages/ directory not found — place .tkl packages in packages/") }
    }
    mut tkl_path = ""
    mut ei: u64 = 0
    loop {
        if ei >= entries.len { break }
        let e = entries[ei]
        // Match `<dep>-*.tkl` — must start with `<dep>-` and end with `.tkl`.
        let prefix = teko::str::concat(dep, "-")
        let has_prefix = e.len >= prefix.len && teko::str::slice_to(e, prefix.len) == prefix
        if has_prefix && teko::str::ends_with(e, ".tkl") {
            tkl_path = teko::str::concat("packages/", e)
            break
        }
        ei++
    }
    if tkl_path == "" {
        return error { message = teko::str::concat("teko: dep '", dep, "': package not found (looked in packages/)") }
    }

    // Read the .tkl bytes (the file is a ZIP archive — binary, not UTF-8, but read_file
    // returns the raw bytes as a str; we treat each byte via s[i]).
    let raw_str = match teko::io::read_file(tkl_path) {
        str as s => s
        error => return error { message = teko::str::concat("teko: dep '", dep, "': cannot read .tkl file") }
    }
    // Convert str → []byte (s[i] → byte).
    mut raw: []byte = teko::list::empty()
    mut ri: u64 = 0
    loop {
        if ri >= raw_str.len { break }
        raw = teko::list::push(raw, raw_str[ri])
        ri++
    }

    // Unzip — find the `<dep>.tkb` entry.
    let zip_entries = match compress::read_zip(raw) {
        []compress::ZipEntry as es => es
        error as e => return error { message = teko::str::concat("teko: dep '", dep, teko::str::concat("': bad .tkl (ZIP parse error): ", e.message)) }
    }
    let tkb_name = teko::str::concat(dep, ".tkb")
    mut tkb_data: []byte = teko::list::empty()
    mut found_tkb = false
    mut zi: u64 = 0
    loop {
        if zi >= zip_entries.len { break }
        if zip_entries[zi].name == tkb_name {
            tkb_data = zip_entries[zi].data
            found_tkb = true
            break
        }
        zi++
    }
    if !found_tkb {
        return error { message = teko::str::concat("teko: dep '", dep, teko::str::concat("': .tkl does not contain ", teko::str::concat(tkb_name, ""))) }
    }

    // Deserialize the TProgram from the .tkb bytes.
    match emit::deserialize_program(tkb_data) {
        checker::TProgram as p => p
        error as e => return error { message = teko::str::concat("teko: dep '", dep, teko::str::concat("': .tkb deserialization failed: ", e.message)) }
    }
}

// load_deps_program — load all deps listed in the manifest and return a TProgram containing
// all their items. Returns an empty TProgram if m.deps is empty (no [dependencies] → silent skip).
// The dep items carry their own namespaces and are injected into the type-check environment
// via type_program_with_deps (not re-typed).
fn load_deps_program(m: Manifest) -> checker::TProgram | error {
    mut all_items: []checker::TItem = teko::list::empty()
    mut di: u64 = 0
    loop {
        if di >= m.deps.len { break }
        let dep_prog = match load_dep_program(m.deps[di]) {
            checker::TProgram as p => p
            error as e => return e
        }
        mut ii: u64 = 0
        loop {
            if ii >= dep_prog.items.len { break }
            all_items = teko::list::push(all_items, dep_prog.items[ii])
            ii++
        }
        di++
    }
    checker::TProgram { items = all_items }
}

/**
 * Build the `checker` phase's per-item progress hook (BUILD-OUTPUT OBSERVABILITY):
 * on each tick, record the latest `(done, total)` into `last`/`total_cell` (read
 * back once `type_program_with_deps_pre_mono` returns, for the settle line — the
 * actual total can differ slightly from the pre-check item count once trait
 * derivations fold) and render the live "N/M items" counter. The closure write-throughs stay
 * explicit `.value =` (0.3.1 — a bare `ref`-bound write-through assign captures correctly with
 * the `lam_collect_stmt` fix this PR ships, but that fix cannot yet cover its OWN introduction —
 * the compiler that BUILDS this generation's `src/` is the PREVIOUS seed, whose closure-capture
 * pass predates the fix; a bare `last = n` inside this exact closure would build a corrupt
 * env struct THIS generation. `.value =` keeps the FieldAccess-target shape the previous seed's
 * capture walk already handles).
 *
 * @param phase       the checker phase handle from `phase_begin`
 * @param last        the caller's tick counter, updated to the latest `done`
 * @param total_cell  the caller's total-item counter, updated to the latest `total`
 * @return            the `ProgressFn` closure to pass to `type_program_with_deps_pre_mono`
 */
fn checker_tick_fn(phase: Phase, ref last: u64, ref total_cell: u64) -> checker::ProgressFn {
    (n: u64, m: u64) => {
        last.value = n
        total_cell.value = m
        phase_tick(phase, count_unit_text(n, m, "items"))
    }
}

/**
 * module_const_count — the number of module-level `checker::TConstDecl` items on a typed
 * program's item surface: the upfront total the `consteval` phase renders, since
 * `inline_consts` visits exactly the module consts and the count is known before the
 * pass runs (post-inline the scalar consts are dropped from the surface, so it must be
 * taken BEFORE).
 *
 * @param prog  the typed program about to be const-inlined
 * @return      the module-level const count
 */
fn module_const_count(prog: checker::TProgram) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TConstDecl => { n++ }
            _ => { }
        }
        i++
    }
    n
}

/**
 * append_diags — `b`'s diagnostics appended to `a`'s, in order. The build reports FILE-boundary
 * (parse) diagnostics before DECLARATION-boundary (type) ones, which is the order a reader walks
 * the pipeline in.
 *
 * @param a  the diagnostics collected first
 * @param b  the diagnostics to append
 * @return   the concatenation
 * @since 0.3.1
 */
fn append_diags(a: []str, b: []str) -> []str {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i = i + 1
    }
    out
}

/**
 * Run the checker, monomorphization, and const-inlining phases over `selected` (with
 * `dep_prog`'s signatures pre-seeded), reporting ALL THREE as their own timed
 * `teko build` observability phases: `checker` ticks a live "N/M items" counter as
 * `type_program_with_deps_pre_mono` types each top-level item; `monomorph` settles
 * once with the resulting instance count (its fixpoint queue has no cheap upfront
 * total, so it renders as a count-up rather than a running "N/M" — see
 * `count_only_text`); `consteval` settles with the module-const count
 * (`module_const_count`), so an `inline_consts` failure (e.g. a const reference
 * cycle) reports under its OWN label instead of re-ending the already-settled
 * `monomorph` phase. Extracted from `frontend_body` to keep that function flat.
 *
 * @param selected  the OS-pruned, un-typed merged program
 * @param dep_prog  the already-typed dependency program (empty when depless)
 * @param report    print the phase lines (`false` for a silent/retry pass)
 * @param tty       render the phases' in-place `\r` updates
 * @param parse_diags  the FILE-boundary lex/parse diagnostics the assembly already collected, so
 *                     they are reported alongside this phase's declaration-boundary ones
 * @return          the fully checked and monomorphized program, or every collected diagnostic
 */
fn checked_program_of(selected: parser::Program, dep_prog: checker::TProgram, report: bool, tty: bool, parse_diags: []str) -> checker::TProgram | error {
    let mode = report_mode(!report, tty)
    let checker_phase = phase_begin("checker", count_unit_text(0, selected.items.len, "items"), mode)
    mut last: u64 = 0
    mut total_cell: u64 = selected.items.len
    let on_item = checker_tick_fn(checker_phase, last, total_cell)
    let pre = match checker::type_program_with_deps_pre_mono(selected, dep_prog, on_item) {
        checker::PreMono as p => p
        error as e => {
            let all = append_diags(parse_diags, teko::list::push(teko::list::empty(), e.message))
            phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), all[0])
            return error { message = join_diags(all) }
        }
    }
    // Every FILE-boundary (parse) and DECLARATION-boundary (type) diagnostic this build collected,
    // reported TOGETHER — the `teko test` shape, one line per defect. Monomorphization is NOT
    // attempted: `pre.prog` is partial by construction when anything failed to type.
    let collected = append_diags(parse_diags, pre.diags)
    if collected.len > 0 {
        phase_end_fail(checker_phase, count_unit_text(last, total_cell, "items"), collected[0])
        return error { message = join_diags(collected) }
    }
    phase_end_ok(checker_phase, count_unit_text(total_cell, total_cell, "items"))

    let mono_phase = phase_begin("monomorph", count_only_text(0, "instances"), mode)
    let checked = match checker::monomorphize(pre.prog, pre.table) {
        checker::TProgram as c => c
        error as e => {
            phase_end_fail(mono_phase, count_only_text(0, "instances"), e.message)
            return e
        }
    }
    let instances = if checked.items.len > pre.prog.items.len { checked.items.len - pre.prog.items.len } else { 0 }
    phase_end_ok(mono_phase, count_unit_text(instances, instances, "instances"))

    let consts_total = module_const_count(checked)
    let consteval_phase = phase_begin("consteval", count_unit_text(0, consts_total, "consts"), mode)
    match checker::inline_consts(checked) {
        checker::TProgram as inlined => {
            phase_end_ok(consteval_phase, count_unit_text(consts_total, consts_total, "consts"))
            inlined
        }
        error as e => {
            phase_end_fail(consteval_phase, count_unit_text(0, consts_total, "consts"), e.message)
            return e
        }
    }
}

/**
 * The PARSED front-end product — the manifest plus the merged, un-typed program, the
 * output of `frontend_parse` and the input of `frontend_check`. Splitting the two
 * lets the gated build PARSE THE TREE ONCE and derive BOTH the gate program (with
 * `.tkt` tests) and the release program (`filter_tkt`) from the same parse, instead
 * of re-lexing/re-parsing the whole corpus for the release rebuild (the historical
 * silent re-front-end).
 *
 * @field parsed    the merged, OS-unpruned, un-typed program (with or without `.tkt`
 *                  items, per the `include_tests` the parse ran with)
 * @field manifest  the parsed project manifest
 */
type ParsedFront = struct {
    parsed: parser::Program
    manifest: Manifest
    /** every FILE-boundary lex/parse diagnostic the assembly collected (empty on a clean parse).
        Carried rather than raised so the CHECKER still runs over the files that DID parse and the
        build reports every file's defect in one pass (owner ruling 2026-07-26). */
    diags: []str
}

/**
 * The PARSE half of the front-end (manifest -> discover -> assemble), operating in
 * the CURRENT directory (the caller has already chdir'd). Reads and parses the
 * manifest, discovers the source tree, injects the project-root `main.tks`, checks
 * the A4 main-file rule, prints the build banner, and assembles every eligible file
 * into ONE merged (un-typed) program.
 *
 * @param include_tests  assemble the `.tkt` test files into the merged program too
 * @param quiet          suppress the banner and the `lexer`/`parser` phase output
 * @param tty            render the phases' in-place `\r` updates
 * @return               the parsed program and manifest, or the first error
 */
fn frontend_parse(include_tests: bool, quiet: bool, tty: bool) -> ParsedFront | error {
    // --- find + read + parse the manifest (the single <name>.tkp at the root — A1) ---
    let mname = match find_manifest() { str as n => n; error as e => return e }
    let mtext = match teko::io::read_file(mname) { str as s => s; error => return error { message = "cannot read .tkp manifest" } }
    let m = match parse_manifest(mtext) { Manifest as x => x; error as e => return e }

    // --- discover the source tree (A2) ---
    mut files = match discover(m.name, m.source) { []SourceFile as f => f; error as e => return e }

    // The entry MainFile lives at the PROJECT ROOT, not under `source` (discover walks only
    // `source`). Inject it into the file set so the merged program has an entry, tagged with
    // the bare root namespace (provenance). Skip it if absent (a library).
    match teko::io::read_file("main.tks") {
        str => files = teko::list::push(files, SourceFile { path = "main.tks"; namespace = m.name })
        error => { }
    }

    // --- C7.9: A4 main-file rule — Binary REQUIRES main.tks; library kinds FORBID it ---
    mut has_main = false
    mut mi: u64 = 0
    loop {
        if mi >= files.len { break }
        if teko::str::ends_with(files[mi].path, "main.tks") { has_main = true; break }
        mi = mi + 1
    }
    match check_main_file_rule(m.artifact, has_main) { Artifact => { }; error as e => return e }

    if !quiet {
        teko::io::eprintln(teko::str::concat("teko ", teko::env::version()))
        teko::io::eprintln(teko::str::concat("project '", m.name, teko::str::concat("' (source=", m.source, ")")))
    }

    // --- assemble: read+parse every file, MERGE into ONE program (A3) ---
    // assemble bakes file:line:col into the message, so report with an empty path (W-loc).
    let asm = match assemble_sel(files, include_tests, !quiet, tty) { Assembled as a => a; error as e => return e }

    ParsedFront { parsed = asm.program; manifest = m; diags = asm.diags }
}

/**
 * The CHECK half of the front-end (prune-os -> load-deps -> check+monomorphize) over
 * an already-parsed program. Deterministic in its input: two calls over the same
 * `ParsedFront` produce the same checked program — the property the parse-once gated
 * build relies on (the release program is `frontend_check(filter_tkt(parse))`,
 * byte-equivalent to the historical re-parsed release front-end).
 *
 * @param pf     the parsed program and manifest from `frontend_parse`
 * @param quiet  suppress the `checker`/`monomorph` phase output
 * @param tty    render the phases' in-place `\r` updates
 * @return       the checked program and manifest, or the first error
 */
fn frontend_check(pf: ParsedFront, quiet: bool, tty: bool) -> Frontend | error {
    // --- C7.1f: keep only the target OS's `#os("…")` function variants (conditional compilation) ---
    let selected = prune_os(pf.parsed, target_os(pf.manifest))

    // --- C7.10: load dep .tkl packages and prepend their typed items before type-checking ---
    // The dep's TProgram items carry their own namespaces (set when they were originally checked);
    // we pre-seed the collection environment with them so the project's code can call dep functions
    // and reference dep types. m.deps is empty when there is no [dependencies] section → no-op.
    let dep_prog = match load_deps_program(pf.manifest) { checker::TProgram as p => p; error as e => return e }

    let checked = match checked_program_of(selected, dep_prog, !quiet, tty, pf.diags) { checker::TProgram as c => c; error as e => return e }

    Frontend { prog = checked; manifest = pf.manifest }
}

/**
 * The front-end AFTER the chdir (manifest -> discover -> assemble -> check),
 * operating in the CURRENT directory — `frontend_parse` chained into
 * `frontend_check`, for the single-pass callers (`teko run`, `teko test`,
 * `--no-verify`) that need no parse reuse.
 *
 * @param include_tests  assemble the `.tkt` test files into the merged program too
 * @param quiet          suppress the observability output
 * @param tty            render the `lexer`/`parser`/`checker`/`monomorph` phases'
 *                       in-place `\r` updates (BUILD-OUTPUT OBSERVABILITY)
 * @return               the checked program and manifest, or the first error
 */
fn frontend_body(include_tests: bool, quiet: bool, tty: bool) -> Frontend | error {
    let pf = match frontend_parse(include_tests, quiet, tty) { ParsedFront as x => x; error as e => return e }
    frontend_check(pf, quiet, tty)
}

/**
 * The PRODUCTION view of a parsed program: every item whose provenance is a `.tkt`
 * test file is dropped, everything else passes through IN ORDER. Because
 * `assemble_sel` walks the same file list with and without tests — the only
 * difference being the `.tkt` skip — `filter_tkt(parse(with tests))` is
 * item-for-item identical to `parse(without tests)`: same items, same order, same
 * content. That equivalence is what lets the gated build parse ONCE and derive the
 * release program from the gate's parse without re-reading the tree (the FIXPOINT
 * is untouched — the release program is byte-identical to the re-parsed one).
 *
 * @param p  the merged program parsed WITH `.tkt` tests
 * @return   the same program with every `.tkt`-provenance item removed
 */
fn filter_tkt(p: parser::Program) -> parser::Program {
    mut kept: []parser::Item = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= p.items.len { break }
        if !teko::str::ends_with(p.items[i].file, ".tkt") { kept = teko::list::push(kept, p.items[i]) }
        i = i + 1
    }
    parser::Program { items = kept }
}

// =========================================================================
// rt_dir / run_cc / backend — the native BACKEND wiring (F2/F3), mirroring driver.c's
// tk_backend. Emit C for the checked program, write it at the project root (the front-end
// has chdir'd there), invoke the host `cc`, produce the native binary. The output stem is
// the manifest `name`.
// =========================================================================

// F3 — where the minimal execution runtime (teko_rt.{h,c}) lives. Resolution order: the
// TK_RT_DIR env override (what CMake bakes into the C bootstrap), else probe the in-tree
// candidates by reading their `teko_rt.h` — `src/runtime` (the teko project layout) then
// `runtime`. (A general install resolves via TK_RT_DIR; bundling the runtime is Phase 7.)
fn rt_dir() -> str {
    match teko::env::var("TK_RT_DIR") {
        str as d => d
        error => {
            match teko::io::read_file("src/runtime/teko_rt.h") { str => return "src/runtime"; error => { } }
            match teko::io::read_file("runtime/teko_rt.h") { str => return "runtime"; error => { } }
            "src/runtime"   // best-effort default
        }
    }
}

// The teko::assert C SEED lives beside the runtime (sibling dir `<parent of rt>/assert`); the
// generated C does `#include "assert.h"` and may reference teko__assert__* (the seed is WEAK, so
// it is harmless when the program self-defines teko::assert). Mirror driver.c's `-I <src>/assert`.
fn assert_dir(rt: str) -> str {
    match teko::str::last_index_of(rt, "/") {
        u64 as i => teko::str::concat(teko::str::slice_to(rt, i), "/assert")   // <parent>/assert
        error => "assert"
    }
}

// (issue #73) Toolchain portability: `-std=c23` and `-ferror-limit=0` are clang spellings.
// GCC (Ubuntu's default `cc`) rejects both — GCC 13 (ubuntu-latest/24.04) only understands
// the pre-standardization `-std=c2x` name (GCC 14+ also accepts `-std=c23`, but c2x is the
// portable spelling), and GCC's unlimited-errors flag is `-fmax-errors=0` not
// `-ferror-limit=0`. Detect the compiler family ONCE per build via a flag-acceptance probe
// (exit-code only — no output capture needed): try compiling an empty translation unit with
// the clang-only flags under `-fsyntax-only`. clang accepts them (exit 0); GCC rejects the
// unrecognized options (nonzero exit). Mirrors driver.c::cc_family_is_clang. Uses run_quiet
// so a deliberately-rejected flag doesn't print to the user's build output.
fn cc_family_is_clang(cc: str, binary: str) -> bool {
    let probe = teko::str::concat(binary, ".ccprobe.c")
    match teko::io::write_file(probe, "int main(void){return 0;}\n") {
        error => return true   // can't probe (no file created) — assume clang (today's default), fail open
        null => { }
    }
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, cc)
    argv = teko::list::push(argv, "-std=c23")
    argv = teko::list::push(argv, "-ferror-limit=0")
    argv = teko::list::push(argv, "-fsyntax-only")
    argv = teko::list::push(argv, probe)
    let is_clang = teko::process::run_quiet(argv) == 0
    match teko::fs::remove_file(probe) { error => { }; null => { } }   // best-effort cleanup (issue #79; mirrors driver.c's unchecked remove)
    is_clang
}

/**
 * (C7.20) append_reachable_link_flags — the global `[extern.libs]` resolved link flags
 * (`-l<name>` / paths / raw flags), appended to `argv` AFTER the sources so the linker
 * resolves their symbols (link order). A flag is appended only when its originating key
 * (m.link_lib_name, parallel to m.link_flags) is in `reachable` — extern-reachability: only a
 * lib whose name is actually reached by a call from the program's own entry points earns a
 * place on the link line, so a project that declares two [extern.libs] but only calls one of
 * them's extern fns links just that one — and only when the blind-link opt-in has not withdrawn
 * it (`omit_flag_for_blind_link`).
 *
 * @param argv       the link argument vector so far
 * @param m          the resolved manifest (global `[extern.libs]` columns)
 * @param reachable  the extern-lib keys actually reached from the program's entry points
 * @return           `argv` with every reachable, non-withdrawn global flag appended in order
 */
fn append_reachable_link_flags(argv: []str, m: Manifest, reachable: []str) -> []str {
    mut out = argv
    mut li = 0
    loop {
        if li >= m.link_flags.len { break }
        if name_in(reachable, m.link_lib_name[li]) && !omit_flag_for_blind_link(m.link_flags[li], m.link_mode[li]) {
            out = teko::list::push(out, m.link_flags[li])
        }
        li = li + 1
    }
    out
}

/**
 * omit_flag_for_blind_link — must this resolved flag be WITHDRAWN from the link line because the
 * build asked for a blind link over it (R5)? True only for the exact case the opt-in exists for:
 * `--allow-undef` is set, the element declared `shared:`, it NAMES a path, and that path is not
 * present here — there is nothing to hand the linker, so passing it would fail on the missing file
 * and make the opt-in a no-op. A bare `shared:<name>` is NEVER withdrawn: whether the linker can
 * find `-l<name>` in its own (or the cross toolchain's) search paths is the linker's question, and
 * its fail-loud miss IS the R5 default — a dev who means to blind-link one must point at its path.
 *
 * @param flag  the resolved link flag
 * @param mode  the element's declared linkage mode (`LINK_MODE_SHARED` for a `shared:` element)
 * @return      true iff the flag must be left off the link line for the blind link
 * @since 0.3.1
 */
fn omit_flag_for_blind_link(flag: str, mode: str) -> bool {
    if mode != LINK_MODE_SHARED { return false }
    if !allow_undef_selected() { return false }
    let path = lib_spec_path(flag)
    if path.len == 0 { return false }
    !lib_file_present(path)
}

/**
 * (C7.20) append_reachable_os_lib_flags — the DEFERRED `[extern.libs.<key>]` flags (C7.1f),
 * appended to `argv` only when their section key applies to this build (`os_lib_key_matches`: a
 * bare OS matching the build's or the target's OS, or a full os-arch matching the resolved target —
 * the ratified §4.2 arch-key fill) AND their originating key is in `reachable` AND the blind-link
 * opt-in has not withdrawn it (`omit_flag_for_blind_link`). Resolved HERE, so manifest parse stays
 * host-independent.
 *
 * @param argv       the link argument vector so far
 * @param m          the resolved manifest (the deferred per-section columns)
 * @param keys       the build's applicability keys (`link_target_keys`)
 * @param reachable  the extern-lib keys actually reached from the program's entry points
 * @return           `argv` with every applicable, reachable deferred flag appended in order
 */
fn append_reachable_os_lib_flags(argv: []str, m: Manifest, keys: LinkTargetKeys, reachable: []str) -> []str {
    mut out = argv
    mut oi = 0
    loop {
        if oi >= m.os_lib_os.len { break }
        if os_lib_key_matches(m.os_lib_os[oi], keys) && name_in(reachable, m.os_lib_name[oi]) && !omit_flag_for_blind_link(m.os_lib_flag[oi], m.os_lib_mode[oi]) {
            out = teko::list::push(out, m.os_lib_flag[oi])
        }
        oi = oi + 1
    }
    out
}

/**
 * ASSERT_SEED_NAMESPACE — the namespace whose functions the C assert SEED
 * (`src/assert/assert.c`) realizes as `teko__assert__*`. A program that declares
 * this namespace ITSELF (only the compiler's own corpus does — `teko::` is a
 * reserved, non-shadowable root) supplies those symbols from its own generated C,
 * so the seed must not also define them there.
 */
const ASSERT_SEED_NAMESPACE: str = "teko::assert"

/**
 * ASSERT_SEED_STRONG_FLAG — the `cc` define that tells `src/assert/assert.c` it is the
 * SOLE definition of `teko__assert__*` and must therefore emit STRONG symbols. Passed
 * exactly when the program being built does not declare `teko::assert` itself. Absent,
 * the seed defaults to `__attribute__((weak))` — the pre-2026-07-25 behaviour, kept as
 * the default so a previously RELEASED seed (which cannot know about this flag) still
 * links `teko.c` + `assert.c` together without a duplicate symbol.
 */
const ASSERT_SEED_STRONG_FLAG: str = "-DTK_ASSERT_SEED_STRONG"

/**
 * declares_assert_seed — does a top-level function with this `namespace`/`is_extern`
 * pair DEFINE one of the assert seed's symbols? An `extern fn` only BINDS a foreign
 * symbol (it emits a prototype, never a body), so it never competes with the seed —
 * only a real, bodied declaration in the seed's namespace does.
 *
 * @param namespace  the function's declaring namespace
 * @param is_extern  whether it is a bodiless foreign binding
 * @return           true iff this declaration defines an assert-seed symbol
 */
fn declares_assert_seed(namespace: str, is_extern: bool) -> bool {
    !is_extern && namespace == ASSERT_SEED_NAMESPACE
}

/**
 * program_declares_assert_seed — does `prog` define the `teko::assert` symbols itself?
 * True ONLY for the compiler's own corpus (`src/assert/assert.tks`), whose generated C
 * defines `teko__assert__*` strongly. Its NEGATION is what `build_cc_argv` uses to pass
 * `ASSERT_SEED_STRONG_FLAG`: when the program supplies no definition, the seed becomes
 * the strong one and resolves everywhere — including PE/COFF, where GNU ld does not
 * honour a weak definition across translation units, so the weak-only seed left every
 * Windows program that CALLED `teko::assert` without defining it unlinkable (see the
 * comment block in `src/assert/assert.c`).
 *
 * @param prog  the checked program about to be linked
 * @return      true iff the program supplies the assert-seed symbols itself
 */
fn program_declares_assert_seed(prog: checker::TProgram) -> bool {
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if declares_assert_seed(f.namespace, f.is_extern) { return true } }
            _ => { }
        }
        i = i + 1
    }
    false
}

/**
 * teko_cc_env — the raw value of the `TEKO_CC` cross-linker env seam (#387 B2-8),
 * or "" when it is unset. The seam mirrors `TEKO_BACKEND`/`TEKO_TARGET`: it lets a
 * differential lane override the compiler `build_cc_argv` invokes without a
 * manifest edit, so the same self-hosted `teko` cross-links the own `.o` on a host
 * whose default `cc` cannot (the linux-x86_64 CI runner linking a PE/COFF object).
 *
 * @return the `TEKO_CC` value, or "" when the variable is absent
 */
fn teko_cc_env() -> str {
    match teko::env::var("TEKO_CC") { str as v => v; error => "" }
}

/**
 * default_cc_for_target — the compiler that links the own object for `t` when neither the manifest
 * `cc` nor the `TEKO_CC` seam pins one: the HOST `cc`, for every target there is.
 *
 * IT USED TO NAME `x86_64-w64-mingw32-gcc` FOR `X8664Windows`, AND THAT ARM IS GONE. It was the
 * last place in this compiler that ASKED for MinGW, and it asked BY DEFAULT — so a cross Windows
 * build silently linked through the very toolchain the owner banned (2026-07-26, restated
 * 2026-07-29: *"queremos sim Cross compiling quando todos os natives estiverem funcionando, mas não
 * quero saber de mingw"*). No dedicated cross driver replaces it, because none is wanted here: a
 * cross build whose claim is the OBJECT now stops at the object (`build_links_binary`, applied by
 * `finish_native_object`) and needs no linker at all, and the full cross LINK arrives with the
 * project's own linker AFTER the natives work — that order is the ruling, not an accident.
 *
 * EVERY ARM THEREFORE ANSWERS THE SAME, AND THE FUNCTION STAYS. It is the single place the question
 * "does this target have a cross driver of its own?" is answered, and the regressor's pre-build
 * capability probe reads it (`cross_cc_for_target`, `host_cc_cannot_link_cross_reason`) to conclude
 * that a cross row needs NO cross toolchain on this host. Inlining the constant at those call sites
 * would scatter the answer; keeping it named keeps the day a legitimate (non-MinGW) cross driver
 * appears a one-arm change. The wasm arms never reach a `cc` invocation at all — `emit_native`
 * routes a wasm target to `emit_native_wasm`, which writes the finished, self-contained module
 * (`backend-wasm.md` §1.2) — and exist only so the match stays exhaustive.
 *
 * @param t  the resolved own-backend target
 * @return   the compiler command for `t` — the host `cc` for every target
 */
fn default_cc_for_target(t: NativeTarget) -> str {
    match t {
        NativeTarget::X8664Windows => HOST_CC_NAME
        NativeTarget::X8664Linux => HOST_CC_NAME
        NativeTarget::Arm64Macho => HOST_CC_NAME
        NativeTarget::Wasm32Wasi => HOST_CC_NAME
        NativeTarget::Wasm64Wasi => HOST_CC_NAME
        NativeTarget::Wasm32Browser => HOST_CC_NAME
    }
}

/**
 * WINDOWS_OS_NAME — the `teko::os()` spelling of a Windows host, in the same vocabulary
 * `target_os_name` and the `[extern.libs.<os>]` section keys use. Named because the host-OS
 * comparison that picks the Windows compiler default is a DECISION, not a passing string.
 */
const WINDOWS_OS_NAME: str = "windows"

/**
 * WINDOWS_CC_NAME — the compiler a Windows host compiles the emitted C with: `clang`, never the
 * `cc` on the PATH.
 *
 * MEASURED, on the project's own Windows runner: `cc` there IS MinGW (`cc → /c/mingw64/bin/cc`),
 * so "the host default" and "the banned toolchain" were the same file, and the LLVM already on the
 * image was never reached. Resolving `clang` by name is what makes the ban real on the C route
 * instead of only on the native one.
 *
 * WHY NOT `cl.exe`: the emitted C uses GNU statement-expressions (`({ ... })`) plus `__builtin_`/
 * `__attribute__`, which C23 does not standardise and MSVC's own compiler rejects. clang accepts
 * them even while targeting MSVC, because the COMPILER is clang — MSVC contributes its headers,
 * libraries and linker, nothing more. Rewriting the emitter to drop those extensions is a cost the
 * owner declined for now.
 */
const WINDOWS_CC_NAME: str = "clang"

/**
 * WINDOWS_MSVC_TRIPLE — the target triple that pins the Windows compiler default to the MSVC ABI:
 * MSVC headers, MSVC libraries, and `lld-link`/`link.exe` as the linker. Its `-msvc` tail is
 * exactly what `triple_is_mingw` refuses to confuse with MinGW's `-gnu` one.
 */
const WINDOWS_MSVC_TRIPLE: str = "x86_64-pc-windows-msvc"

/**
 * CC_TARGET_FLAG_PREFIX — the clang spelling that pins a target triple on the command line. The
 * `--target=<triple>` form (one token) and not `-target <triple>` (two), so a default the build adds
 * for the host can never be mistaken for the manifest's own `[extern] target` pair.
 */
const CC_TARGET_FLAG_PREFIX: str = "--target="

/**
 * CcChoice — the compiler the link line runs, together with the target flag that choice implies.
 *
 * TWO FIELDS BECAUSE A COMPILER DEFAULT CAN BE A COMMAND *PLUS* AN ABI. The Windows default is not
 * simply "clang": it is clang aimed at MSVC, and the aim is a separate argv token. Returning the
 * pair keeps `resolve_cc`'s precedence law readable — a PINNED compiler (manifest `cc`, `TEKO_CC`)
 * carries an empty `target_flag`, because a caller who names the compiler also owns its target and
 * the build must not second-guess them.
 *
 * @since 0.3.1
 */
type CcChoice = struct {
    /** the compiler command `build_cc_argv` puts at argv[0]. */
    cmd: str
    /** the target-pinning flag this choice implies ("" for a pinned compiler and for every non-Windows host). */
    target_flag: str
}

/**
 * host_cc_choice — the compiler default for a build that pinned none: `clang --target=<MSVC>` on a
 * Windows host, the bare host `cc` everywhere else.
 *
 * THE WINDOWS ARM IS THE WHOLE POINT (owner: *"odeio, eu disse ODEIO o uso de mingw, deveria usar
 * MSVC em Windows"*). On that host the PATH's `cc` is MinGW, so the old bare-`cc` default handed
 * the C route to the banned toolchain silently. Naming clang and its MSVC target makes the honest
 * Windows toolchain the DEFAULT rather than something a lane has to remember to pass.
 *
 * EVERY OTHER HOST IS BYTE-UNCHANGED: `HOST_CC_NAME` with no flag, exactly what the line carried
 * before, which is the condition for the product fixpoint to keep closing on Linux and macOS.
 *
 * @return the default compiler choice for this host
 * @since 0.3.1
 */
fn host_cc_choice() -> CcChoice {
    if teko::os() == WINDOWS_OS_NAME {
        return CcChoice { cmd = WINDOWS_CC_NAME; target_flag = CC_TARGET_FLAG_PREFIX ~ WINDOWS_MSVC_TRIPLE }
    }
    CcChoice { cmd = HOST_CC_NAME; target_flag = "" }
}

/**
 * resolve_cc_choice — pick the compiler `build_cc_argv` invokes, in the precedence order that was
 * already law (#387 B2-8, D-D) and is preserved here exactly: the manifest `[extern] cc` override
 * wins; then the `TEKO_CC` env seam; then this host's default (`host_cc_choice`).
 *
 * THE `TEKO_TARGET` ARM IS GONE, and its removal is a simplification rather than a policy change:
 * it existed only to reach `default_cc_for_target`'s MinGW cross driver, and now that every target
 * answers with the host `cc` the arm could not say anything the default does not. A cross build no
 * longer needs it either — it stops at the object (`build_links_binary`).
 *
 * A PINNED COMPILER IS OBEYED WITHOUT A TARGET FLAG. Whoever names the compiler owns its ABI, so
 * neither override inherits the Windows default's `--target=`; and a pinned compiler is still
 * subject to the MinGW ban — `invoke_cc` asks whatever was resolved what it targets and refuses a
 * MinGW answer, which is what keeps `TEKO_CC=...mingw...` from being a way around the law.
 *
 * @param m  the resolved manifest (the `cc` override, if any)
 * @return   the compiler command for the current build, plus the target flag it implies
 */
fn resolve_cc_choice(m: Manifest) -> CcChoice {
    if m.cc.len > 0 { return CcChoice { cmd = m.cc; target_flag = "" } }
    let env_cc = teko_cc_env()
    if env_cc.len > 0 { return CcChoice { cmd = env_cc; target_flag = "" } }
    host_cc_choice()
}

/**
 * resolve_cc — the COMMAND half of `resolve_cc_choice`, for the callers that only need to name the
 * compiler (diagnostics, the regressor's capability probes) and never assemble a command line.
 *
 * @param m  the resolved manifest (the `cc` override, if any)
 * @return   the compiler command for the current build
 */
fn resolve_cc(m: Manifest) -> str { resolve_cc_choice(m).cmd }

/**
 * opt_cc_flag — the portable cc optimization flag for an optimization `level`, or
 * "" for level 0. Level 0 (the DEV/CI default) emits NO flag so the link line stays
 * byte-identical to the historic `-O0` release line (the FIXPOINT is preserved);
 * level 1/2 emit `-O1`/`-O2`, which both gcc and clang accept (deliberately NOT
 * `-march=native`, which is not portable for a released seed).
 *
 * @param level  the requested optimization level (0, 1 or 2; >2 is clamped to `-O2`)
 * @return       "-O1"/"-O2" for level 1/2, else "" (no flag) for level 0
 */
fn opt_cc_flag(level: i32) -> str {
    if level >= 2 { return "-O2" }
    if level == 1 { return "-O1" }
    ""
}

/**
 * opt_arg_has_prefix — does `a` begin with the `--opt=` selector prefix (so the
 * remainder is the requested level)? A 6-byte prefix, guarded on length so the
 * slice never runs past the string.
 *
 * @param a  a single CLI argument token
 * @return   true iff `a` is a `--opt=<n>` form
 */
fn opt_arg_has_prefix(a: str) -> bool {
    a.len > 6 && teko::str::slice_to(a, 6) == "--opt="
}

/**
 * opt_level_of_value — map the text after `--opt=` to an optimization level: "0" →
 * 0, "1" → 1, and every other value (including "2") → 2, so an out-of-range or
 * malformed suffix resolves to the fully-optimized release level rather than
 * silently disabling optimization.
 *
 * @param v  the substring after `--opt=`
 * @return   0 for "0", 1 for "1", else 2
 */
fn opt_level_of_value(v: str) -> i32 {
    if v == "0" { return 0 }
    if v == "1" { return 1 }
    2
}

/**
 * opt_level_of — resolve the requested cc optimization level from the build flags.
 * `--release` selects level 2 (the release seed profile); `--opt=<0|1|2>` selects
 * that explicit level; with neither flag the level is 0 (the DEV/CI default — no
 * `-O`, fast to PRODUCE, byte-identical to the historic release line). The last
 * matching flag on the line wins, so an explicit `--opt=` can override an earlier
 * `--release`.
 *
 * @param args  the full CLI argument vector
 * @return      the resolved optimization level (0 by default; 2 for `--release`)
 */
fn opt_level_of(args: []str) -> i32 {
    mut i: u64 = 0
    mut level: i32 = 0
    loop {
        if i >= args.len { break }
        let a = args[i]
        if a == "--release" { level = 2 }
        else if opt_arg_has_prefix(a) { level = opt_level_of_value(teko::str::slice_from(a, 6)) }
        i = i + 1
    }
    level
}

/**
 * build_cc_argv — assemble the host-`cc` command line that turns one input file
 * (`input`, a generated `.c` for the C backend or an own-backend `.o`) into the
 * native `binary`, in full parity with `driver.c::run_cc` (M.5, reuse the host
 * toolchain in one invocation). The line carries: the compiler chosen by
 * `resolve_cc_choice` (the `[extern] cc` override, else the `TEKO_CC` env seam,
 * else this host's default — `clang --target=x86_64-pc-windows-msvc` on Windows,
 * the bare host `cc` elsewhere) followed by that choice's own target flag, if any
 * (empty on every non-Windows host, so the line there is byte-unchanged); the portable
 * `-std`/error-limit spelling for the detected compiler
 * family (clang `-std=c23`/`-ferror-limit=0`, else GCC's `-std=c2x`/`-fmax-errors=0`);
 * `-w` to silence warnings on machine-generated C; the project version baked into
 * `teko_rt`'s `tk_rt_version()` as a BARE `-DTEKO_VERSION_STRING` token (embedded
 * quotes broke Windows arg re-parsing); `ASSERT_SEED_STRONG_FLAG` when the program
 * does NOT declare `teko::assert` itself (making the assert seed the sole, STRONG
 * definition — PE/COFF has no working cross-TU weak definition, so the weak-only seed
 * left every Windows program that called `teko::assert` unlinkable); the cross knobs
 * (`-target`/`--sysroot`/`-nostdlib`, C7.1f); the runtime + assert include dirs; the
 * input; the two C runtime
 * seed sources (`teko_rt.c` + `assert.c`); `-lm` (unless freestanding); the
 * reachable `[extern.libs]` link flags (C7.20); and, on macOS, the `__info_plist`
 * `-Wl,-sectcreate` section. Shared verbatim by `run_cc` (a `.c` input) and
 * `link_object` (an own-backend `.o` input) so both link the SAME way — the only
 * difference is the input file, keeping the two paths from drifting. When `debug`
 * is set it also appends the DEBUG profile flag `-g` (emit DWARF so the E4 native
 * stack trace resolves against the `.tsym` map). Optimization is an AXIS of the
 * build, not a global: `opt` 0 (the DEV/CI DEFAULT) emits NO `-O` flag — the line
 * is byte-identical to the historic `-O0` release line, so the FIXPOINT (gen1 ==
 * gen2) is preserved untouched — while `opt` 1/2 appends `-O1`/`-O2` (the portable
 * gcc+clang spelling; never `-march=native`, which is not portable for a released
 * seed). The published seed is built ONCE at `opt` 2 in `release.yml` (a diagnostic
 * proved the same emitted `teko.c` recompiled at `-O2` self-hosts 1.30x faster,
 * 168.7s → 129.6s, and `cmp` showed `-O0` and `-O2` emit BYTE-IDENTICAL C — the
 * speed changes, the emitted output does not), so everyone downstream gets a fast
 * compiler. Assertions stay ON at every level (nothing defines NDEBUG).
 *
 * @param input   the input path — a generated `.c` (C backend) or a `.o` (own backend)
 * @param binary  the output native executable path
 * @param m       the resolved manifest (cc override, version, cross knobs, libs)
 * @param prog    the checked program (for extern-reachability of the link flags)
 * @param debug   append the debug profile flag (`-g`); false = today's byte-identical release line
 * @param opt     the cc optimization level: 0 (default) emits no `-O` flag, 1/2 appends `-O1`/`-O2`
 * @return        the full `cc` argument vector, ready for `teko::process::run`
 */
fn build_cc_argv(input: str, binary: str, m: Manifest, prog: checker::TProgram, debug: bool, opt: i32) -> []str {
    let rt = rt_dir()
    let asrt = assert_dir(rt)
    let choice = resolve_cc_choice(m)
    let is_clang = cc_family_is_clang(choice.cmd, binary)
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, choice.cmd)
    if choice.target_flag.len > 0 { argv = teko::list::push(argv, choice.target_flag) }
    argv = teko::list::push(argv, if is_clang { "-std=c23" } else { "-std=c2x" })
    argv = teko::list::push(argv, "-w")
    argv = teko::list::push(argv, if is_clang { "-ferror-limit=0" } else { "-fmax-errors=0" })
    if debug { argv = teko::list::push(argv, "-g") }
    let oflag = opt_cc_flag(opt)
    if oflag.len > 0 { argv = teko::list::push(argv, oflag) }
    let verval = if m.suffix.len > 0 { teko::str::concat(teko::str::concat(m.version, "-"), m.suffix) } else { m.version }
    argv = teko::list::push(argv, teko::str::concat("-DTEKO_VERSION_STRING=", verval))
    if !program_declares_assert_seed(prog) { argv = teko::list::push(argv, ASSERT_SEED_STRONG_FLAG) }
    if m.target.len > 0 { argv = teko::list::push(teko::list::push(argv, "-target"), m.target) }
    if m.sysroot.len > 0 { argv = teko::list::push(teko::list::push(argv, "--sysroot"), m.sysroot) }
    if m.freestanding { argv = teko::list::push(argv, "-nostdlib") }
    argv = teko::list::push(argv, "-I")
    argv = teko::list::push(argv, rt)
    argv = teko::list::push(argv, "-I")
    argv = teko::list::push(argv, asrt)
    argv = teko::list::push(argv, input)
    argv = teko::list::push(argv, teko::str::concat(rt, "/teko_rt.c"))
    argv = teko::list::push(argv, teko::str::concat(asrt, "/assert.c"))
    let keys = link_target_keys(m)
    argv = append_libm_flag(argv, m, keys.emit_os)
    let reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    argv = append_allow_undef_flag(argv)
    argv = append_macos_plist_flag(argv, binary, m, keys.emit_os)
    argv = append_windows_reproducible_flag(argv, keys.emit_os)
    argv = teko::list::push(argv, "-o")
    teko::list::push(argv, binary)
}

/**
 * LIBM_FLAG — the flag that links the C math library on the platforms that ship it separately.
 */
const LIBM_FLAG: str = "-lm"

/**
 * append_libm_flag — link the math library, EXCEPT where the platform has none to link.
 *
 * WINDOWS HAS NO SEPARATE LIBM. Its math functions live in the CRT the linker already pulls in, and
 * MSVC ships no `m.lib` at all — so `-lm` there is not a harmless extra, it is a link error
 * (`could not open 'm.lib'`) once the compiler stops being MinGW (whose `libm.a` is what made the
 * flag work until now). The Linux/macOS arms are untouched, which is what keeps their link line
 * byte-identical.
 *
 * A FREESTANDING build links no libc at all (`-nostdlib`), so it never asks for libm either.
 *
 * @param argv     the link argument vector so far
 * @param m        the resolved manifest (the freestanding switch)
 * @param emit_os  the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`)
 * @return         `argv` with `-lm` appended where the platform has one, else unchanged
 * @since 0.3.1
 */
fn append_libm_flag(argv: []str, m: Manifest, emit_os: str) -> []str {
    if m.freestanding { return argv }
    if emit_os == WINDOWS_OS_NAME { return argv }
    teko::list::push(argv, LIBM_FLAG)
}

/**
 * WINDOWS_NO_TIMESTAMP_FLAG — the MSVC-linker option that makes the PE image REPRODUCIBLE instead of
 * stamping the wall clock into its COFF `TimeDateStamp`. `-Wl,` because it reaches `lld-link` /
 * `link.exe` through the `clang` driver.
 *
 * IT USED TO BE THE GNU SPELLING (`--no-insert-timestamp`), WHICH ONLY MinGW's `ld` UNDERSTANDS.
 * With MinGW banned, the linker behind a Windows target is `lld-link`/`link.exe`, and the GNU
 * spelling would abort the link as an unknown argument — so the flag had to move with the toolchain.
 * `/Brepro` is the MSVC-family switch for exactly this, and both linkers accept it.
 */
const WINDOWS_NO_TIMESTAMP_FLAG: str = "-Wl,/Brepro"

/**
 * append_windows_reproducible_flag — on a Windows/COFF target, stop the linker from stamping the
 * BUILD TIME into the executable, so two links of the same program produce the same bytes.
 *
 * THE MEASUREMENT THIS CLOSES, from the wagon's own `windows-x86_64` leg at `d74df08` — the first
 * run in which that leg ever got far enough to compare two generations at all:
 *
 *     gen2 ready (4296372 bytes)
 *     gen3 ready (4296372 bytes)
 *     byte-identity: gen2 != gen3  ✗
 *     .fixpoint/gen2 .fixpoint/gen3 differ: char 137, line 2
 *     emitted-C identity: gen2.c == gen3.c  ✓ (10114862 bytes)
 *
 * Same SIZE, byte-identical emitted C, and the first difference at `cmp`'s 1-based char 137 —
 * offset 136. In a PE image `e_lfanew` points at 128, the `PE\0\0` signature occupies 128..131, and
 * the COFF header follows: `Machine` 132..133, `NumberOfSections` 134..135, `TimeDateStamp`
 * 136..139. The first differing byte IS the first byte of the timestamp, and the two generations
 * were linked ~85 s apart.
 *
 * SO THE COMPILER WAS NEVER WRONG HERE. It emitted the same C and produced the same program; the
 * LINKER broke reproducibility by recording when it ran. The fixpoint is a claim about the
 * compiler, and a clock embedded by the output format is not the compiler disagreeing with itself.
 *
 * NOT A FIXPOINT SOFTENING, and the distinction matters on this wagon: nothing is excluded from the
 * comparison and no byte is forgiven. The build stops WRITING a value that was never about the
 * program, so the two images become equal on their own — the gate goes on comparing every byte.
 *
 * IF A DIFFERENCE REMAINS AFTER THIS, expect the optional header's `CheckSum` (computed over the
 * image, so it moves with the timestamp) or a debug-directory stamp. `cmp` reports only the FIRST
 * difference, so a clean run is what proves the set was just this one.
 *
 * @param argv     the link argument vector so far
 * @param emit_os  the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`) — "windows" enables it
 * @return         `argv` with the flag appended on a Windows target, else unchanged
 */
fn append_windows_reproducible_flag(argv: []str, emit_os: str) -> []str {
    if emit_os != "windows" { return argv }
    teko::list::push(argv, WINDOWS_NO_TIMESTAMP_FLAG)
}

/**
 * ALLOW_UNDEF_FLAG — the Teko-linker flag name that opts INTO a blind link over shared libraries
 * the link step cannot see (R5, teko-target-crosslink-0.3.1.md §5). OURS, not the system
 * linker's: `allow_undef_cc_flag` translates it per object format for the transitional `cc`, and
 * the own M-linker makes it native in E1.
 */
const ALLOW_UNDEF_FLAG: str = "--allow-undef"

/**
 * allow_undef_of — does the `--allow-undef` opt-in appear in `args`? The SINGLE parser for the
 * flag (owner ruling 2026-07-24, §5.0: "o default é FALHAR … ou passa --allow-undef … Nunca
 * blind-link silencioso — opt-in, M.3"), consulted both by `project_arg_of` (so the token is never
 * mistaken for the project positional) and — through `allow_undef_selected` — by the link-line
 * builder.
 *
 * @param args  the full CLI argument vector
 * @return      true iff `--allow-undef` appears anywhere in `args`
 * @since 0.3.1
 */
fn allow_undef_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == ALLOW_UNDEF_FLAG { return true }
        i = i + 1
    }
    false
}

/**
 * allow_undef_selected — is the blind-link opt-in active for THIS build? `allow_undef_of` over
 * this process's own argv, so the link-line builder and the M.3 shared-lib validator read the one
 * flag parser without eight layers of plumbing threading a link-step modality through the
 * front-end. The same shape `self_exe_path` uses to read argv where it is needed.
 *
 * @return true iff this invocation carries `--allow-undef`
 * @since 0.3.1
 */
fn allow_undef_selected() -> bool { allow_undef_of(teko::env::args()) }

/**
 * allow_undef_cc_flag — the TRANSITIONAL translation of `--allow-undef` for a given object format
 * (§5.2): Mach-O → `-Wl,-undefined,dynamic_lookup`, which is precisely "leave these undefined,
 * resolve at load". ELF needs the PAIR `--allow-shlib-undefined,--unresolved-symbols=ignore-all`:
 * §5.2 names the first, but `--allow-shlib-undefined` alone governs only undefined symbols INSIDE a
 * shared dependency — an EXECUTABLE with an undefined symbol still fails `ld` (verified: `cc` with
 * only that flag rejects a program calling an unlinked symbol). Emitting the ratified flag alone
 * would ship a no-op opt-in — a fabricated capability, which M.1/M.3 forbid more strongly than the
 * flag list binds — so the mechanically-required companion travels with it. `""` for
 * PE/COFF — a DLL cannot be referenced without an import library, so there is no host-linker flag
 * that would make the blind link work there (the honest stop is raised by
 * `validate_shared_libs_for_target`, not silently papered over with a flag that does nothing) —
 * and `""` for wasm, which has no link step at all. In E1 the own M-linker makes the capability
 * native and this translation retires.
 *
 * @param objfmt  the resolved target's object format (`target_objfmt`)
 * @return        the host-linker flag that enables the blind link, or "" when none exists
 * @since 0.3.1
 */
fn allow_undef_cc_flag(objfmt: str) -> str {
    if objfmt == OBJFMT_ELF { return "-Wl,--allow-shlib-undefined,--unresolved-symbols=ignore-all" }
    if objfmt == OBJFMT_MACHO { return "-Wl,-undefined,dynamic_lookup" }
    ""
}

/**
 * append_allow_undef_flag — append the translated blind-link flag to the link line when this build
 * carries `--allow-undef` and the resolved target's object format has a translation. A flagless
 * build appends NOTHING, so the default link line — and the product FIXPOINT — stay byte-identical.
 *
 * @param argv  the link argument vector so far
 * @return      `argv` with the translated flag appended, or unchanged
 * @since 0.3.1
 */
fn append_allow_undef_flag(argv: []str) -> []str {
    if !allow_undef_selected() { return argv }
    let flag = allow_undef_cc_flag(target_objfmt(resolved_target()))
    if flag.len == 0 { return argv }
    teko::list::push(argv, flag)
}

/**
 * ExternLibEntry — one `[extern.libs…]` declaration that APPLIES to the build's resolved target,
 * flattened out of the manifest's parallel columns for the M.3 validators: the manifest key, the
 * resolved link flag, the declared linkage mode, and the section it came from.
 *
 * @since 0.3.1
 */
type ExternLibEntry = struct {
    /** the manifest key (the `from "<key>"` handle) this flag was declared under. */
    key: str
    /** the resolved cc link flag (`-l<name>`, a direct file path, or a verbatim `-flag`). */
    flag: str
    /** the declared linkage mode: `LINK_MODE_STATIC`, `LINK_MODE_SHARED`, or "". */
    mode: str
    /** the section key it came from: "" for the global `[extern.libs]`, else the bare OS / os-arch. */
    section: str
}

/**
 * applicable_extern_libs — every extern-lib declaration that applies to `target`: the whole global
 * `[extern.libs]` section (it links on every target) plus the deferred `[extern.libs.<key>]`
 * entries whose section key matches, keyed on the TARGET's own OS and canonical os-arch name
 * (`target_os_name`/`target_name`) rather than on the build's `[extern] target` triple — the
 * validators answer "is this lib available FOR THE REQUESTED TARGET", which is a question about the
 * target, not about the `cc` triple seam.
 *
 * @param m       the parsed manifest
 * @param target  the resolved own-backend target
 * @return        the applicable declarations, global section first, each in declaration order
 * @since 0.3.1
 */
fn applicable_extern_libs(m: Manifest, target: NativeTarget) -> []ExternLibEntry {
    mut out: []ExternLibEntry = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= m.link_flags.len { break }
        out = teko::list::push(out, ExternLibEntry { key = m.link_lib_name[i]; flag = m.link_flags[i]; mode = m.link_mode[i]; section = "" })
        i = i + 1
    }
    let keys = target_link_keys(target)
    mut j: u64 = 0
    loop {
        if j >= m.os_lib_os.len { break }
        if os_lib_key_matches(m.os_lib_os[j], keys) {
            out = teko::list::push(out, ExternLibEntry { key = m.os_lib_name[j]; flag = m.os_lib_flag[j]; mode = m.os_lib_mode[j]; section = m.os_lib_os[j] })
        }
        j = j + 1
    }
    out
}

/**
 * lib_spec_path — the LOCAL FILE PATH a resolved link flag names, or "" when the flag names no
 * file (a `-l<name>` search request or a verbatim `-flag` escape). A direct-file element resolves
 * to the path itself (`mf_extern_spec`), so a leading `-` is the whole distinction.
 *
 * @param flag  a resolved link flag
 * @return      the path it names, or "" when it names none
 * @since 0.3.1
 */
fn lib_spec_path(flag: str) -> str {
    if flag.len > 0 && flag[0] == b'-' { return "" }
    flag
}

/**
 * lib_file_present — is `path` present on THIS machine? Resolved by listing the containing
 * directory and looking for the basename, so the check costs one `list_dir` and never slurps a
 * multi-megabyte archive into memory just to learn it exists.
 *
 * @param path  the declared library path (relative to the project root, or absolute)
 * @return      true iff a directory entry with that basename exists
 * @since 0.3.1
 */
fn lib_file_present(path: str) -> bool {
    let entries = match teko::fs::list_dir(dirname_of(path)) { []str as e => e; error => return false }
    name_in(entries, basename_of(path))
}

/**
 * static_lib_locality_error — the R4 verdict for ONE static declaration. A cross target's static
 * lib MUST name a local file: the host linker cannot search the target's library paths, so a bare
 * `-l<name>` for a cross target is the "not pointed at for the requested os-arch" error (and the
 * message spells the `[extern.libs.<os-arch>]` line that fixes it). A named path — cross or host —
 * must be PRESENT, which is the already-ratified "an explicitly-named missing lib file is a hard
 * error" rule (LEGISLATION:423) applied per target. A bare `-l<name>` for the HOST target keeps
 * today's behaviour: the host linker searches its own paths and reports its own fail-loud miss.
 *
 * @param e       the applicable static declaration
 * @param target  the resolved own-backend target
 * @return        null when the lib is honestly available, else the positioned compile error
 * @throws        when the lib is unpointed-at (cross) or its named path is absent (R4, M.3)
 * @since 0.3.1
 */
fn static_lib_locality_error(e: ExternLibEntry, target: NativeTarget) -> null | error {
    let tname = target_name(target)
    let path = lib_spec_path(e.flag)
    if path.len == 0 {
        if !cross_note(target).is_cross { return null }
        return error { message = $"[extern.libs] static lib {e.key} is not pointed at for target {tname}: a cross static lib must name a file present locally — declare it as [extern.libs.{tname}] {e.key} = [static:<path>] (R4, M.3)" }
    }
    if lib_file_present(path) { return null }
    error { message = $"[extern.libs] static lib {e.key} for target {tname} is not present locally: {path} (R4, M.3)" }
}

/**
 * validate_static_libs_for_target — M.3/R4: every `static:` lib that applies to the resolved
 * target must be pointed at for that target AND present locally, surfaced HERE as a positioned
 * COMPILE error naming the lib, the target and the missing path — never deferred to an opaque `ld`
 * failure. `shared:` libs follow the §5 fail-or-`--allow-undef` rule
 * (`validate_shared_libs_for_target`), not this one; a manifest with no `static:` declaration is a
 * no-op.
 *
 * @param m       the parsed manifest (global + per-section `[extern.libs]` columns)
 * @param target  the resolved own-backend target
 * @return        null when every applicable static lib is available, else the FIRST honest error
 * @throws        when an applicable static lib is unpointed-at or absent (R4, M.3)
 * @since 0.3.1
 */
fn validate_static_libs_for_target(m: Manifest, target: NativeTarget) -> null | error {
    let entries = applicable_extern_libs(m, target)
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_STATIC {
            match static_lib_locality_error(entries[i], target) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

/**
 * is_import_lib_path — does `path` name a PE import library (a `.lib` or `.a` import stub)? The one
 * thing that lets a COFF link reference a DLL at all, so it is what the R5 COFF rule looks for.
 *
 * @param path  the declared library path
 * @return      true iff the path names an import-library file
 * @since 0.3.1
 */
fn is_import_lib_path(path: str) -> bool {
    teko::str::ends_with(path, ".lib") || teko::str::ends_with(path, ".a")
}

/**
 * shared_lib_link_error — the R5 verdict for ONE shared declaration. PE/COFF first: the
 * transitional `link.exe`/`lld-link` cannot reference a DLL without an import library and will not
 * invent one, so a cross `shared:` on `x86_64-windows` that names no import lib is a NAMED honest
 * stop EVEN WITH `--allow-undef` (§5.2 — the E1 own import-table writer closes this, and the
 * message says so; fabricating an import table in the transitional path is not on the table). Then
 * the general rule: a NAMED path that is absent FAILS by default and is permitted only under the
 * explicit `--allow-undef` blind link. A bare `-l<name>` gets no compile-time verdict — the linker
 * searches its own (or the cross toolchain's) paths and its "cannot find -l<name>" IS the R5
 * fail-loud default; `--allow-undef` never suppresses that, it only permits undefined symbols.
 *
 * @param e            the applicable shared declaration
 * @param target       the resolved own-backend target
 * @param allow_undef  whether this build carries the `--allow-undef` opt-in
 * @return             null when the link may honestly proceed, else the compile error / named stop
 * @throws             on a missing named shared lib without `--allow-undef`, or the COFF import-lib gap
 * @since 0.3.1
 */
fn shared_lib_link_error(e: ExternLibEntry, target: NativeTarget, allow_undef: bool) -> null | error {
    let tname = target_name(target)
    let path = lib_spec_path(e.flag)
    if target_objfmt(target) == OBJFMT_COFF && cross_note(target).is_cross && !is_import_lib_path(path) {
        return error { message = $"[extern.libs] shared lib {e.key} cannot be linked for target {tname}: PE/COFF references a DLL only through an import library, which the transitional system linker will not synthesize — point at one ([extern.libs.{tname}] {e.key} = [shared:<path>.lib]); --allow-undef does not lift this (E1's own import-table writer does)" }
    }
    if path.len == 0 { return null }
    if lib_file_present(path) { return null }
    if allow_undef { return null }
    error { message = $"[extern.libs] shared lib {e.key} for target {tname} is not present locally: {path} — supply the library, or pass {ALLOW_UNDEF_FLAG} to link blind and resolve it at load time on the target (R5, M.3)" }
}

/**
 * validate_shared_libs_for_target — M.3/R5: the DEFAULT is to FAIL when an applicable `shared:`
 * lib cannot be linked here; `--allow-undef` is the sole, explicit escape (owner ruling
 * 2026-07-24, §5.0 — never a silent blind link). Delegates each applicable declaration to
 * `shared_lib_link_error`; a manifest with no `shared:` declaration is a no-op.
 *
 * @param m            the parsed manifest (global + per-section `[extern.libs]` columns)
 * @param target       the resolved own-backend target
 * @param allow_undef  whether this build carries the `--allow-undef` opt-in
 * @return             null when every applicable shared lib may honestly link, else the FIRST error
 * @throws             on a missing named shared lib without the opt-in, or the COFF import-lib gap
 * @since 0.3.1
 */
fn validate_shared_libs_for_target(m: Manifest, target: NativeTarget, allow_undef: bool) -> null | error {
    let entries = applicable_extern_libs(m, target)
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_SHARED {
            match shared_lib_link_error(entries[i], target, allow_undef) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

/**
 * validate_extern_libs_for_target — the build's single M.3 pre-link gate: apply the R4 static rule
 * and the R5 shared rule to the target THIS build resolved, with the `--allow-undef` opt-in read
 * from this invocation. Called before any artifact is emitted, so an unavailable cross lib is a
 * positioned compile error instead of an opaque linker failure half a pipeline later.
 *
 * @param m  the resolved manifest
 * @return   null when the link may honestly proceed, else the first R4/R5 error
 * @throws   per `validate_static_libs_for_target` / `validate_shared_libs_for_target`
 * @since 0.3.1
 */
fn validate_extern_libs_for_target(m: Manifest) -> null | error {
    let target = resolved_target()
    match validate_static_libs_for_target(m, target) { error as e => return e; null => { } }
    validate_shared_libs_for_target(m, target, allow_undef_selected())
}

/**
 * append_macos_plist_flag — on a macOS target, write the project's `Info.plist`
 * beside `binary` and append the `-Wl,-sectcreate,__TEXT,__info_plist,<plist>`
 * flag so the linked Mach-O carries native version metadata (C7.1k; visible to
 * `mdls` / `otool -s __TEXT __info_plist`). Best-effort — a plist write failure
 * leaves `argv` unchanged and never breaks the build. A no-op off macOS (the
 * Windows VERSIONINFO + Linux ELF note are the staged follow-ons).
 *
 * `tos` MUST BE THE EMIT OS, NEVER `target_os(m)`. `-sectcreate` is an Apple `ld`
 * flag and a question about the OS being linked FOR, but `target_os` answers with
 * the HOST whenever no `[extern] target` triple is set — and a `TEKO_TARGET` cross
 * build sets no triple. On a macOS host cross-linking to Windows that handed the
 * flag to `x86_64-w64-mingw32-ld`, which fails the link outright:
 *
 *     unable to disambiguate: -sectcreate (did you mean --sectcreate ?)
 *
 * No Linux lane could ever see it (`teko::os()` there is never "macos"), and the
 * one lane that could was SKIPPING the row for a missing cross-linker. Provisioning
 * mingw is what surfaced it — the skip was hiding a real defect, which is the whole
 * reason a skipped row counts as a failure in this project's own CI.
 *
 * @param argv    the link argument vector so far
 * @param binary  the output executable path (the plist lands at `<binary>.Info.plist`)
 * @param m       the manifest (project identity embedded in the plist)
 * @param tos     the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`); "macos" enables
 *                 the section, "" (wasm) and every other value leave `argv` untouched
 * @return        `argv` with the sectcreate flag appended on macOS, else unchanged
 */
fn append_macos_plist_flag(argv: []str, binary: str, m: Manifest, tos: str) -> []str {
    if tos != "macos" { return argv }
    let plist = teko::str::concat(binary, ".Info.plist")
    match teko::io::write_file(plist, plist_xml(m)) {
        null => teko::list::push(argv, teko::str::concat("-Wl,-sectcreate,__TEXT,__info_plist,", plist))
        error => argv
    }
}

/**
 * CC_TRIPLE_PROBE_SUFFIX — the scratch file the target-triple probe redirects the compiler's output
 * into, appended to the build's own `binary` path so two concurrent builds never share one. Read
 * back and deleted immediately, exactly as `cc_family_is_clang` does with its `.ccprobe.c`.
 */
const CC_TRIPLE_PROBE_SUFFIX: str = ".ccmachine"

/**
 * cc_target_triple — ASK the resolved compiler what it targets: run `<cc> -dumpmachine` and return
 * the triple it prints, or "" when this host cannot say.
 *
 * ASKING BEATS INFERRING, which is the same argument the regressor's `host_cc_arch` already makes:
 * a compiler's name and its path are conventions, its `-dumpmachine` answer is what it will
 * actually do. That is why the measured Windows defect (`cc → /c/mingw64/bin/cc`) is caught here
 * even when the command is spelled `cc` like anywhere else.
 *
 * "" IS "UNKNOWN", NEVER "GUILTY". A driver that does not understand `-dumpmachine` exits non-zero
 * and yields "", and a compiler that cannot be measured is let through — `triple_is_mingw("")` is
 * false by construction. Convicting silence would break every toolchain that merely declines to
 * answer.
 *
 * ONE PROCESS PER `cc` LINE, NOT ONE PER COMPILED FILE: the probe runs from `invoke_cc`, which runs
 * once per link, and its answer is reused for that whole line (the C backend emits ONE translation
 * unit per program, so this is one probe per build — the same cost profile as the existing
 * `cc_family_is_clang` flag probe).
 *
 * @param cc      the resolved compiler command
 * @param binary  the build's output path, used to place the probe's scratch file
 * @return        the compiler's target triple, or "" when it could not be read
 * @since 0.3.1
 */
fn cc_target_triple(cc: str, binary: str) -> str {
    let outp = binary ~ CC_TRIPLE_PROBE_SUFFIX
    mut argv: []str = teko::list::push(teko::list::empty(), cc)
    argv = teko::list::push(argv, HOST_CC_MACHINE_FLAG)
    let h = teko::process::spawn_redirected(argv, "", teko::list::empty(), "", outp, outp ~ ".err")
    let rc = teko::process::wait_one(h)
    let out = match teko::io::read_file(outp) { str as s => s; error => "" }
    match teko::fs::remove_file(outp) { error => { }; null => { } }
    match teko::fs::remove_file(outp ~ ".err") { error => { }; null => { } }
    if rc != 0 { return "" }
    trimmed_line(first_line(out))
}

/**
 * trimmed_line — `line` without a trailing carriage return, so a triple read on a Windows host
 * compares equal to the same triple read anywhere else.
 *
 * @param line  one line of a captured stream
 * @return      the line without its trailing `\r`, if it had one
 * @since 0.3.1
 */
fn trimmed_line(line: str) -> str {
    if line.len > 0 && line[line.len - 1] == b'\r' { return teko::str::slice_to(line, line.len - 1) }
    line
}

/**
 * mingw_cc_evidence — the EVIDENCE that the resolved compiler `cc` is MinGW, or "" when there is
 * none.
 *
 * TWO READINGS, IN COST ORDER. The command itself is inspected first (`linker_is_mingw` — the same
 * recogniser the native route uses, so both routes convict on the same spelling), because it costs
 * nothing and it catches the measured case: on the project's Windows runner `cc` resolves to
 * `/c/mingw64/bin/cc`, whose PATH names MinGW outright. Only then is the compiler ASKED what it
 * targets, which catches the case a name cannot — a driver installed under an innocent path that
 * nonetheless emits `x86_64-w64-windows-gnu`.
 *
 * @param cc      the resolved compiler command
 * @param binary  the build's output path (where the triple probe's scratch file goes)
 * @return        the phrase naming how MinGW was recognised, or "" when it was not
 * @since 0.3.1
 */
fn mingw_cc_evidence(cc: str, binary: str) -> str {
    if linker_is_mingw(cc) { return $"the command '{cc}' itself names a MinGW install" }
    let triple = cc_target_triple(cc, binary)
    if triple_is_mingw(triple) { return $"it answers {HOST_CC_MACHINE_FLAG} with the MinGW target triple '{triple}'" }
    ""
}

/**
 * mingw_cc_rejected_error — the C route's refusal, the sibling of the native route's
 * `mingw_rejected_error`.
 *
 * THE ORDER IS TO MAKE NOISE (owner). The ban had been implemented on the native route only, so the
 * C route — the route the Windows lane actually builds through — resolved `cc` from the PATH and got
 * MinGW with no guard firing anywhere. Both messages now quote ONE reason (`MINGW_BAN_REASON`), so
 * the refusal reads the same whichever route hit it, and each names the honest replacement for ITS
 * own route: a native linker there, clang-with-an-MSVC-target here.
 *
 * @param cc        the compiler command that was refused
 * @param evidence  how it was recognised as MinGW (`mingw_cc_evidence`)
 * @return          the named error
 * @since 0.3.1
 */
fn mingw_cc_rejected_error(cc: str, evidence: str) -> error {
    error { message = teko::str::concat(
        "refusing the MinGW C compiler '", cc, "': ", evidence, ". ",
        MINGW_BAN_REASON,
        " Use clang with an explicit MSVC target (", WINDOWS_CC_NAME, " ", CC_TARGET_FLAG_PREFIX,
        WINDOWS_MSVC_TRIPLE, "), which is this build's own default on a Windows host — MSVC supplies",
        " the headers, the libraries and the linker, and clang supplies the GNU C extensions the",
        " emitted C uses.") }
}

/**
 * CC_VERBOSE_FLAG — the flag that makes a gcc/clang driver print the sub-invocations it runs,
 * including the full linker command line.
 */
const CC_VERBOSE_FLAG: str = "-v"

/**
 * cc_verbose_argv — `argv` with `CC_VERBOSE_FLAG` inserted right after the compiler, so the RE-RUN
 * is the same line plus the one flag and nothing else.
 *
 * Inserted at the front rather than appended, so the flag is visibly part of the invocation and not
 * mistaken for one more input at the end of a long line.
 *
 * @param argv  the link line that failed (argv[0] is the compiler)
 * @return      the same line with `-v` after the compiler
 * @since 0.3.1
 */
fn cc_verbose_argv(argv: []str) -> []str {
    mut out: []str = teko::list::push(teko::list::empty(), argv[0])
    out = teko::list::push(out, CC_VERBOSE_FLAG)
    mut i: u64 = 1
    loop {
        if i >= argv.len { break }
        out = teko::list::push(out, argv[i])
        i = i + 1
    }
    out
}

/**
 * report_cc_failure — on a FAILED `cc` invocation, re-run the identical line with `-v` and let its
 * output through, then hand back the ORIGINAL status.
 *
 * THE LOG LINE THAT ASKED FOR THIS, verbatim from a real run: `clang: error: linker command failed
 * with exit code 1 (use -v to see invocation)`. The tool named the one thing that would explain it
 * and nobody had asked; the project's own rule (`scripts/check_ar_elf.sh`) is that *"a silent 'exit
 * 1, no output' gate is never acceptable"*, and a link failure whose invocation is unknown is that
 * gate.
 *
 * ONLY ON FAILURE. A routine `-v` would bury every successful build's log in driver internals, so
 * the happy path stays exactly as quiet as it was — the second invocation costs nothing on a build
 * that works, because it never happens.
 *
 * A `-v` RE-RUN THAT SUCCEEDS IS ITSELF REPORTED, because it means the failure was not reproducible
 * from the same inputs (a full disk, a killed child, a racing parallel build) and that is a
 * different bug from a broken link line.
 *
 * @param argv  the link line that failed (argv[0] is the compiler)
 * @param rc    the failing status the first invocation returned
 * @return      `rc`, unchanged — the diagnostic never rewrites the verdict
 * @since 0.3.1
 */
fn report_cc_failure(argv: []str, rc: i32) -> i32 {
    teko::io::eprintln($"teko: cc failed (status {rc}) — re-running the same line with {CC_VERBOSE_FLAG} so the invocation is on the record:")
    if teko::process::run(cc_verbose_argv(argv)) == 0 {
        teko::io::eprintln($"teko: the {CC_VERBOSE_FLAG} re-run of the SAME line SUCCEEDED — the failure above is not reproducible from these inputs")
    }
    rc
}

/**
 * invoke_cc — the ONE gate every `cc` invocation of this build passes through: refuse a MinGW
 * compiler, run the line, and on failure re-run it verbosely.
 *
 * ONE FUNNEL, THREE CALLERS (`run_cc`, `run_cc_debug`, `link_object`), so the ban and the diagnostic
 * cannot be present on one route and absent on another — which is exactly the drift that left the C
 * route unguarded while the native route had a ban.
 *
 * @param argv    the assembled link line (`build_cc_argv`; argv[0] is the compiler)
 * @param binary  the build's output path (where the triple probe's scratch file goes)
 * @return        the compiler's exit status, or 1 when the compiler was refused
 * @since 0.3.1
 */
fn invoke_cc(argv: []str, binary: str) -> i32 {
    let evidence = mingw_cc_evidence(argv[0], binary)
    if evidence.len > 0 { return fail("", mingw_cc_rejected_error(argv[0], evidence).message) }
    let rc = teko::process::run(argv)
    if rc == 0 { return 0 }
    report_cc_failure(argv, rc)
}

/**
 * run_cc — compile the generated C `cfile` into the native `binary` via the host
 * `cc` (the C-backend link path). A thin wrapper over `build_cc_argv` (which
 * assembles the shared link line) and `invoke_cc` (which gates and runs it): pass
 * the `.c` as the input.
 *
 * @param cfile   the generated C translation unit
 * @param binary  the output native executable path
 * @param m       the resolved manifest
 * @param prog    the checked program (extern-reachability)
 * @param opt     the cc optimization level (0 = default/no `-O`, 2 = release seed)
 * @return        the `cc` process exit code (0 on success)
 */
fn run_cc(cfile: str, binary: str, m: Manifest, prog: checker::TProgram, opt: i32) -> i32 {
    invoke_cc(build_cc_argv(cfile, binary, m, prog, false, opt), binary)
}

/**
 * run_cc_debug — the DEBUG-profile sibling of `run_cc` (the `teko run` build path):
 * compile the generated C `cfile` into `binary` with `build_cc_argv(..., true)`, so
 * the link line carries `-g` (DWARF for the E4 native stack trace, resolved against
 * the `.tsym` map) on top of the already-unoptimized, assertions-on release line.
 * The ONLY difference from `run_cc` is the debug flag, keeping the two paths aligned.
 *
 * @param cfile   the generated C translation unit
 * @param binary  the output native executable path
 * @param m       the resolved manifest
 * @param prog    the checked program (extern-reachability)
 * @return        the `cc` process exit code (0 on success)
 */
fn run_cc_debug(cfile: str, binary: str, m: Manifest, prog: checker::TProgram) -> i32 {
    invoke_cc(build_cc_argv(cfile, binary, m, prog, true, 0), binary)
}

/**
 * link_object — link the own-backend Mach-O object `objfile` into the native
 * `binary` via the host `cc`-as-linker (D-C, the #385 A4-5 keystone: `cc obj.o
 * teko_rt.c assert.c -lm -o exe`). Reuses `build_cc_argv` verbatim — the ONLY
 * difference from `run_cc` is a `.o` input in place of a `.c`, so the own object
 * links against the same C-built `teko_rt`/`assert` runtime (resolving `_tk_exit`,
 * `_tk_set_args`, `_tk_region_*`) and inherits the same `[extern.libs]` flags +
 * macOS `__info_plist` parity for free. Toolchain independence (dropping `cc` for
 * the own linker) is Phase E/#226; this bootstrap links through `cc`. Passes opt
 * level 0: the own backend emits its machine code directly, so `cc -O` would only
 * touch the runtime `.c` seed sources on the link line — the C backend (`run_cc`)
 * is the path the release seed optimizes.
 *
 * @param objfile  the own-backend Mach-O `.o` (from `emit_macho` + `write_file_bytes`)
 * @param binary   the output native executable path
 * @param m        the resolved manifest
 * @param prog     the checked program (extern-reachability)
 * @return         the `cc` process exit code (0 on success)
 */
fn link_object(objfile: str, binary: str, m: Manifest, prog: checker::TProgram) -> i32 {
    invoke_cc(build_cc_argv(objfile, binary, m, prog, false, 0), binary)
}

// (C7.1k) plist_xml — a minimal macOS Info.plist carrying the project's identity, embedded into the
// Mach-O `__TEXT,__info_plist` section by run_cc. Fields must be plain text (no XML metacharacters);
// the seed's own metadata is. (XML-escaping of arbitrary metadata is a follow-on.)
fn plist_xml(m: Manifest) -> str {
    let ver = if m.version != "" { m.version } else { "0.0.0.0" }
    let info = if m.description != "" { teko::str::concat(m.name, " — ", m.description) } else { m.name }
    teko::str::concat(
        "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n",
        teko::str::concat(
            teko::str::concat("  <key>CFBundleName</key><string>", m.name, "</string>\n"),
            teko::str::concat(
                teko::str::concat("  <key>CFBundleIdentifier</key><string>org.teko.", m.name, "</string>\n"),
                teko::str::concat(
                    teko::str::concat("  <key>CFBundleShortVersionString</key><string>", ver, "</string>\n"),
                    teko::str::concat(
                        teko::str::concat("  <key>CFBundleVersion</key><string>", ver, "</string>\n"),
                        teko::str::concat("  <key>CFBundleGetInfoString</key><string>", info, "</string>\n</dict>\n</plist>\n"))))))
}

/**
 * backend — the artifact dispatch: lower the checked program to the native
 * `binary` and report. `stem` is the output name (the manifest `name`); artifacts
 * land under `out_dir` (default "bin", or `-o <dir>`), created at the project root
 * (the cwd after the front-end chdir'd). Mirrors `driver.c`. `Static` wraps the
 * own-native whole-program object into a platform-native static archive
 * (`emit_static_lib`, KP16 + the real-toolchain-validated Mach-O/COFF port
 * from `theory/kp16-ar-macho-coff` — own-backend targets only; a non-native
 * backend/target combination is a NAMED honest stop, M.3 — no fake
 * artifact); `Shared` is still a plain honest stop (its increment has not
 * landed); `package` emits a `.tkl`; the default
 * `binary` kind emits C and links via `cc` — UNLESS `m.backend == Backend::Native`
 * (the resolved `TEKO_BACKEND=native` selection, D1/#390) selects the own AOT backend
 * (`emit_native`). The default is `Backend::C`, so a flagless build stays
 * byte-identical (FIXPOINT).
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the build output directory (`-o`, default "bin")
 * @param prog     the checked, typed program
 * @param m        the resolved manifest
 * @param opt      the cc optimization level for the C-backend link (0 = default, 2 = release seed)
 * @param tty      render the `codegen`/`emit C`/`cc` phases' in-place `\r` updates
 *                 (BUILD-OUTPUT OBSERVABILITY; the library/package honest-stop and
 *                 packaging paths below are unaffected — only the default binary
 *                 path is instrumented). The backend always reports — `tty` only
 *                 selects the rendering (Tty on a terminal, Plain on a CI/log),
 *                 never silence.
 * @return         0 on a successful build, else the failing status
 */
fn backend(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest, opt: i32, tty: bool) -> i32 {
    match validate_extern_libs_for_target(m) { error as e => return fail(dir, e.message); null => { } }
    if m.artifact == Artifact::Static {
        return emit_static_lib(dir, stem, out_dir, prog, m)
    }
    if m.artifact == Artifact::Shared {
        return fail(dir, "shared library output (.dylib/.so/.dll) is not yet implemented — planned (C7.1m)")
    }
    if m.artifact == Artifact::Package {
        // C7.12: emit .tkh + .tkb (+ best-effort .tsym) → ZIP-STORE → <out_dir>/<name>-<version>.tkl
        // trim a trailing `/` from the output dir (mirrors the Binary path below).
        let od = if out_dir.len > 0 && out_dir[out_dir.len - 1] == b'/' { teko::str::slice_to(out_dir, out_dir.len - 1) } else { out_dir }
        match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
        // .tkh — exported interface (type signatures + docs for `exp` items)
        let table = checker::type_table_of(prog)
        let tkh_bytes = match emit::emit_program(prog, table) {
            []byte as b => b
            error as e => return fail(dir, e.message)
        }
        // .tkb — whole-program typed tree (C7.16 codec)
        let tkb_bytes = emit::serialize_program(prog)
        // .tsym — symbol map (best-effort; always added when available)
        let tsym_str = codegen::tk_emit_tsym(prog)
        mut tsym_bytes: []byte = teko::list::empty()
        mut k = 0
        loop {
            if k >= tsym_str.len { break }
            tsym_bytes = teko::list::push(tsym_bytes, tsym_str[k])
            k++
        }
        // assemble the archive entries: <name>.tkh, <name>.tkb, <name>.tsym
        mut entries: []compress::ZipEntry = teko::list::empty()
        entries = teko::list::push(entries, compress::ZipEntry { name = teko::str::concat(m.name, ".tkh"); data = tkh_bytes })
        entries = teko::list::push(entries, compress::ZipEntry { name = teko::str::concat(m.name, ".tkb"); data = tkb_bytes })
        entries = teko::list::push(entries, compress::ZipEntry { name = teko::str::concat(m.name, ".tsym"); data = tsym_bytes })
        let zip_bytes = compress::write_zip(entries)
        // <out_dir>/<name>-<version>.tkl
        let ver = if m.version == "" { "0.0.0" } else { m.version }
        let tkl_name = teko::str::concat(m.name, "-", teko::str::concat(ver, ".tkl"))
        let tkl_path = teko::str::concat(od, "/", tkl_name)
        match teko::io::write_file_bytes(tkl_path, zip_bytes) {
            error as e => return fail(dir, e.message)
            null => { }
        }
        teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": packaged ", tkl_path, "")))
        return 0
    }
    if m.backend == Backend::Native {
        return emit_native(dir, stem, out_dir, prog, m)
    }
    let mode = report_mode(false, tty)
    if m.abi == "c" {
        match codegen::check_ffi_export(prog) { null => { }; error as e => return fail(dir, e.message) }
    }
    let codegen_phase = phase_begin("codegen", count_unit_text(0, prog.items.len, "items"), mode)
    let emitted = match ffi_emit_c(prog, m.abi) {
        str as s => s
        error as e => {
            phase_end_fail(codegen_phase, count_unit_text(0, prog.items.len, "items"), e.message)
            return fail(dir, e.message)
        }
    }
    phase_end_ok(codegen_phase, count_unit_text(prog.items.len, prog.items.len, "items"))
    // C7.1k — append the build-metadata C so every binary carries its identity (what(1)/strings).
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    let binp = teko::str::concat(od, "/", stem)
    let emit_phase = phase_begin("emit C", cfile, mode)
    match teko::io::write_file(cfile, csrc) {
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return fail(dir, e.message) }
        null => { }   // error? — null = success
    }
    phase_end_ok(emit_phase, teko::str::concat(cfile, teko::str::concat(" ", size_text(csrc.len))))
    if m.abi == "c" {
        match ffi_write_c_header(od, stem, prog) { null => { }; error as e => return fail(dir, e.message) }
    }
    let cc_phase = phase_begin("cc", binp, mode)
    if run_cc(cfile, binp, m, prog, opt) != 0 {
        phase_end_fail(cc_phase, binp, "cc failed to build the generated C")
        return fail(dir, "cc failed to build the generated C")
    }
    phase_end_ok(cc_phase, binp)
    // E3 — write the symbol map beside the binary (best-effort; a write error never fails the build —
    // the .tsym is debug metadata for the E4 native stack-trace, not the artifact).
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, "")))
    0
}

/**
 * backend_of — resolve the code-generation backend for a build: `Backend::Native`
 * iff `native_backend_selected()` (the `TEKO_BACKEND=native` env seam), else the
 * default `Backend::C`. The earlier `--backend={c,native}` CLI flag was REMOVED
 * (owner ruling 2026-07-24 — "já não estava mesmo sendo usado"); `TEKO_BACKEND` is
 * now the ONLY selection surface. The result is stamped onto the front-end's
 * manifest (`with_backend`) so the artifact dispatch reads it as `m.backend`.
 *
 * @return the resolved backend — `Backend::Native` or `Backend::C`
 */
fn backend_of() -> Backend {
    if c_backend_selected() { Backend::C } else { Backend::Native }
}

/** TEKO_BACKEND_C_VALUE — the one env value that still asks for the retiring C emitter. */
const TEKO_BACKEND_C_VALUE: str = "c"

/**
 * c_backend_selected — is `TEKO_BACKEND=c` in the environment?
 *
 * THE DEFAULT INVERTED ON 2026-07-26, by owner ruling. Until then the default was
 * `Backend::C` and `TEKO_BACKEND=native` opted in; now NATIVE IS THE DEFAULT and `c` is what
 * must be asked for. His words: *"deve sim manter --backend sem ressuscitar, o que tem que fazer
 * é apenas passar pelo caminho de native e não mais pelo caminho de emissão de C (default hoje)"*
 * — and, on the train: *"é o fim da linha para o C que não pode mais embarcar no trem, está
 * barrado."*
 *
 * WHY A DEFAULT AND NOT A FLAG. I had restored `--backend=native` for this and the owner
 * reversed it: a flag is a CHOICE, and there is no choice to offer. A flag also fails open —
 * every call site that forgets it silently keeps emitting C, green, and the C path survives by
 * omission. Inverting the default fails CLOSED: everything that does not ask for C gets native,
 * and what breaks, breaks visibly.
 *
 * The `c` value survives only as the differential's other arm (`Given backend = "c"` in the
 * regressor, `TEKO_BACKEND=c` in `tkr.tks`) and dies with the C emitter itself.
 *
 * @return true when the environment still asks for the C emitter
 * @since 0.3.1
 */
fn c_backend_selected() -> bool {
    match teko::env::var("TEKO_BACKEND") { str as v => v == TEKO_BACKEND_C_VALUE; error => false }
}

/**
 * NativeTarget — which own-AOT-backend target the temporary `TEKO_TARGET` env
 * seam selects (D-D, #386 B1-8; #387 B2-8; #388 B3-4; the wasm variants at
 * #389 C1-5/C1-7): `Arm64Macho` (arm64 machine code in a Mach-O object — the
 * A4 reference, and the macOS host default), `X8664Linux` (x86-64 SysV machine
 * code in an ELF object — the linux host default), `X8664Windows` (x86-64 Win64
 * machine code — the SAME x86 ISA as `X8664Linux`, differing only in the ABI
 * register file and PE/COFF object format — the windows host default),
 * `Wasm32Wasi` (a WASI command module — the `exit(n)`/arithmetic/control-flow
 * corpus this slice targets, `backend-c1-wasm.md` §8), `Wasm64Wasi` (the SAME
 * WASI command module shape, but `memory64` + a uniform `i64` `Ptr` — the
 * wasm64 switch, §6, C1-7 — scoped to the alloca-free/rodata-free/`Ptr`-
 * signature-free subset today, `wasm_scope_stop_wasm64`), or `Wasm32Browser`
 * (the SAME emitted module, a JS-import runtime binding instead of WASI — its
 * full wiring is a later slice; reaching it here is a NAMED stop for now, §9).
 * Targets are named by OS, not by object format (ruling #390): the format
 * (ELF/Mach-O/COFF) is a consequence of the OS, so `x86_64-linux` and
 * `x86_64-windows` — not `x86_64-elf`/`x86_64-coff`/`x86_64-win`/`x86_64-pe` —
 * are canonical. The seam mirrors
 * `TEKO_BACKEND` and is read only when the own backend is already active;
 * D1/#390 supersedes it with the real `--target` manifest flag.
 */
type NativeTarget = enum { Arm64Macho; X8664Linux; X8664Windows; Wasm32Wasi; Wasm64Wasi; Wasm32Browser }

/**
 * unsupported_target_error — the honest R2 diagnostic (owner ruling 2026-07-24,
 * teko-target-crosslink-0.3.1.md §0) for a `TEKO_TARGET` value `target_from_name`
 * does not recognize: names the offending value AND lists every canonical/alias
 * name it accepts, so a typo or an unsupported request is a COMPILE error, never a
 * silent mis-lower to the wrong object format. The message carries NO `teko: ` prefix
 * of its own — every path that surfaces it goes through `fail`, which prefixes
 * `teko: <dir>: ` — so the diagnostic reads with one prefix, not two.
 *
 * @param name  the raw, unrecognized `TEKO_TARGET` value
 * @return      the honest error naming `name` and the supported set
 */
fn unsupported_target_error(name: str) -> error {
    error { message = teko::str::concat(
        "unsupported TEKO_TARGET \"", name,
        "\" — supported targets: x86_64-linux (alias x86_64-elf), ",
        "x86_64-windows (aliases x86_64-win, x86_64-pe, x86_64-coff), arm64-macos, ",
        "wasm32-wasi (aliases wasm32, wasm, wasi), wasm64-wasi (alias wasm64), ",
        "wasm32-browser (aliases wasm-browser, browser)") }
}

/**
 * target_from_name — map a raw `TEKO_TARGET` value to a `NativeTarget`:
 * `x86_64-linux` selects the x86-64 SysV/ELF pipeline, `x86_64-windows` the
 * x86-64 Win64/PE-COFF
 * pipeline, `arm64-macos` the arm64/Mach-O pipeline (all canonical, OS-based
 * per ruling #390; `x86_64-elf`/`x86_64-coff`/`x86_64-win`/
 * `x86_64-pe` are accepted as deprecated format-named aliases),
 * `wasm32-wasi`/`wasm32`/`wasm`/`wasi` select the WASI wasm32 target (#389
 * C1-5), `wasm64-wasi`/`wasm64` select the wasm64 target (#389 C1-7, §6), and
 * `wasm32-browser`/`wasm-browser`/`browser` select the Browser variant. Every
 * other value — including an empty string or a typo — is now an honest R2
 * error (owner ruling 2026-07-24) naming the value and the supported set
 * (`unsupported_target_error`): an unrecognized target NEVER silently
 * mis-lowers to `Arm64Macho` anymore.
 *
 * @param name  the raw `TEKO_TARGET` environment value
 * @return      the selected own-backend target, or the honest R2 error
 * @throws      when `name` is neither a canonical name nor a known alias
 */
fn target_from_name(name: str) -> NativeTarget | error {
    if name == "x86_64-linux" { return NativeTarget::X8664Linux }
    if name == "x86_64-elf" { return NativeTarget::X8664Linux }
    if name == "x86_64-windows" { return NativeTarget::X8664Windows }
    if name == "x86_64-win" { return NativeTarget::X8664Windows }
    if name == "x86_64-pe" { return NativeTarget::X8664Windows }
    if name == "x86_64-coff" { return NativeTarget::X8664Windows }
    if name == "arm64-macos" { return NativeTarget::Arm64Macho }
    if name == "wasm32-wasi" { return NativeTarget::Wasm32Wasi }
    if name == "wasm32" { return NativeTarget::Wasm32Wasi }
    if name == "wasm" { return NativeTarget::Wasm32Wasi }
    if name == "wasi" { return NativeTarget::Wasm32Wasi }
    if name == "wasm64-wasi" { return NativeTarget::Wasm64Wasi }
    if name == "wasm64" { return NativeTarget::Wasm64Wasi }
    if name == "wasm32-browser" { return NativeTarget::Wasm32Browser }
    if name == "wasm-browser" { return NativeTarget::Wasm32Browser }
    if name == "browser" { return NativeTarget::Wasm32Browser }
    unsupported_target_error(name)
}

/**
 * host_target_for_os_guess — the OS-ONLY, NEVER-FAILING host-default guess: the exact Phase-1
 * heuristic (teko-target-crosslink-0.3.1.md §2.1) this vagão's precise `host_target_for_os`
 * supersedes for every FALLIBLE consumer, kept here as the one ALWAYS-TOTAL fallback the
 * handful of "never double-report, must answer" consumers still need (`resolved_target`'s own
 * documented contract; `cross_note`'s bare-value comparison) — `linux`/`windows` pick their
 * dominant x86-64 pipeline, every other OS string (`macos`, or the builtin's `unknown`
 * fallback) keeps the pre-existing `Arm64Macho` default, so a macOS host's FIXPOINT and arm64
 * differential stay byte-preserved even where the precise resolver below now honestly fails.
 *
 * @param os  a `teko::os()` value ("linux" | "macos" | "windows" | "unknown")
 * @return    the OS's dominant-arch own-backend target — always succeeds
 */
fn host_target_for_os_guess(os: str) -> NativeTarget {
    if os == "linux" { return NativeTarget::X8664Linux }
    if os == "windows" { return NativeTarget::X8664Windows }
    NativeTarget::Arm64Macho
}

/**
 * host_target_for_os — the own-backend target the build HOST defaults to, PRECISE in both
 * `teko::os()` and `teko::arch()` (owner ruling 2026-07-24, R1: "TEKO_TARGET deve ser do
 * sistema e arquitetura atuais quando não definido"). Phase 2 of the two-phase host default
 * (teko-target-crosslink-0.3.1.md §2.1), now that `teko::arch()` is a seed-recognized builtin:
 * `linux`+`x86_64` selects `X8664Linux`, `windows`+`x86_64` selects `X8664Windows`,
 * `macos`+`arm64` selects `Arm64Macho` — the only three (os, arch) pairs this backend has a
 * real codegen pipeline for. Every OTHER pair (an `arm64` linux host, an `x86_64` macOS host,
 * an `arm64` windows host, or an `unknown` arch) is now an honest R2 error naming the
 * unsupported os-arch, reusing `unsupported_target_error`'s own message (D39 single source) —
 * REPLACES the old Phase-1 behavior of silently guessing the OS's dominant arch regardless of
 * the host's REAL arch, which is exactly the bug class this whole design exists to close (a
 * linux x86_64 host used to emit arm64 Mach-O before R1; an arm64 linux host would otherwise
 * now silently emit x86_64 ELF instead — this closes THAT one too). Split out as a pure
 * function of the os/arch strings (rather than reading `teko::os()`/`teko::arch()` inline) so
 * the (os, arch) × target mapping is independently testable without depending on the real host.
 *
 * @param os    a `teko::os()` value ("linux" | "macos" | "windows" | "unknown")
 * @param arch  a `teko::arch()` value ("x86_64" | "arm64" | "unknown")
 * @return      the own-backend target that (os, arch) pair defaults to
 * @throws      when this backend has no own-backend target for the (os, arch) pair
 */
fn host_target_for_os(os: str, arch: str) -> NativeTarget | error {
    if os == "linux" && arch == "x86_64" { return NativeTarget::X8664Linux }
    if os == "windows" && arch == "x86_64" { return NativeTarget::X8664Windows }
    if os == "macos" && arch == "arm64" { return NativeTarget::Arm64Macho }
    unsupported_target_error($"{arch}-{os}")
}

/**
 * host_default_target — the own-backend target for THIS build host: `host_target_for_os`
 * applied to the live `teko::os()`/`teko::arch()` reading. The bug this replaces
 * (teko-target-crosslink §1): an unset `TEKO_TARGET` used to fall back to a HARDCODED
 * `Arm64Macho` regardless of the real host, so a linux x86_64 host silently emitted an arm64
 * Mach-O object that `cc`/`ld` then rejected with an opaque cross-format error; the OS-only
 * Phase-1 fix left the SAME class of bug open one dimension over (an arm64 linux host silently
 * emitting x86_64 ELF) — this now names that host honestly instead.
 *
 * @return the resolved own-backend target for the current host, or the honest R2 error when
 *         this backend has no target for the host's (os, arch) pair
 * @throws when the live host's (os, arch) pair names no own-backend target
 */
fn host_default_target() -> NativeTarget | error { host_target_for_os(teko::os(), teko::arch()) }

/**
 * host_default_target_guess — the ALWAYS-TOTAL sibling of `host_default_target`, for the
 * handful of consumers that must never re-surface the R1 host-arch diagnostic a second time
 * (`resolved_target`'s own "never double-report" contract, `cross_note`'s bare-value
 * comparison): the precise reading when this host's (os, arch) pair has a real own-backend
 * target, else the SAME Phase-1 OS-only guess `host_target_for_os_guess` always answers with.
 * The one honest R2 stop for an unsupported host lives at `native_target`/`emit_native`
 * (reached BEFORE any of these total consumers run in a real build) — this function exists so
 * they still have SOMETHING to compare/report against once that stop has already fired.
 *
 * @return the precise host target, or the Phase-1 OS-only guess when the host has none
 */
fn host_default_target_guess() -> NativeTarget {
    match host_default_target() { NativeTarget as t => t; error => host_target_for_os_guess(teko::os()) }
}

/**
 * native_target — which own-backend target the temporary `TEKO_TARGET` env seam
 * selects (D-D, #386 B1-8), consulted by `emit_native` after `native_backend_selected`
 * has already chosen the own backend. An unset/absent variable resolves to
 * `host_default_target()` (R1 — the current host's precise os+arch, not a hardcoded arm64
 * nor an OS-only guess), so the default build on a supported host emits the RIGHT object
 * format; a SET-but-unrecognized value, OR an unset value on a host whose (os, arch) pair
 * this backend has no target for, is the honest R2 error (`target_from_name` /
 * `host_target_for_os` respectively), never a silent mis-lower. D1/#390 supersedes this env
 * read with the real `--target` manifest flag.
 *
 * @return the selected own-backend target, or the honest R2 error
 * @throws when the set `TEKO_TARGET` value is neither a canonical name nor a known alias, or
 *         when unset and the host's own (os, arch) pair has no own-backend target
 */
fn native_target() -> NativeTarget | error {
    match teko::env::var("TEKO_TARGET") { str as v => target_from_name(v); error => host_default_target() }
}

/**
 * resolved_target — the own-backend target this build resolves to, with the R2 error arm folded
 * back onto the host default. The honest R2 stop for an unrecognized `TEKO_TARGET` (or an
 * unsupported host os-arch pair) belongs to `emit_native` (which surfaces it as a build failure
 * before anything is emitted); every OTHER consumer of the resolved target — the cross-emit note
 * (`cross_note`), the os-arch link-key selection (`link_target_keys`) and the M.3 extern-lib
 * validators — needs a TOTAL answer and must not double-report that diagnostic, so a bad value
 * reads here as `host_default_target_guess()` (which is also exactly what the C backend, the only
 * path that ignores `TEKO_TARGET`, links for).
 *
 * @return the resolved own-backend target, or the host guess when the value is unrecognized
 * @since 0.3.1
 */
fn resolved_target() -> NativeTarget {
    match native_target() { NativeTarget as t => t; error => host_default_target_guess() }
}

/**
 * target_name — the CANONICAL `<arch>-<os>` name of an own-backend target: the exact spelling
 * `target_from_name` accepts as canonical (its format-named aliases are deliberately NOT produced
 * here) and the spelling the `[extern.libs.<os-arch>]` section key, the `on "<os-arch>"` regressor
 * routing and the cross-emit note all share — ONE os-arch string space (D39). C3 folds this into
 * `supported_targets()`'s `TargetRow.name` column; until that seed-gated crumb lands it is the
 * single source for the reverse (variant → name) direction.
 *
 * @param t  the own-backend target
 * @return   its canonical os-arch name
 * @since 0.3.1
 */
fn target_name(t: NativeTarget) -> str {
    match t {
        NativeTarget::Arm64Macho => "arm64-macos"
        NativeTarget::X8664Linux => "x86_64-linux"
        NativeTarget::X8664Windows => "x86_64-windows"
        NativeTarget::Wasm32Wasi => "wasm32-wasi"
        NativeTarget::Wasm64Wasi => "wasm64-wasi"
        NativeTarget::Wasm32Browser => "wasm32-browser"
    }
}

/** OBJFMT_ELF — the object-format token of the ELF target (x86_64-linux). */
const OBJFMT_ELF: str = "elf"

/** OBJFMT_MACHO — the object-format token of the Mach-O target (arm64-macos). */
const OBJFMT_MACHO: str = "macho"

/** OBJFMT_COFF — the object-format token of the PE/COFF target (x86_64-windows). */
const OBJFMT_COFF: str = "coff"

/** OBJFMT_WASM — the object-format token of the wasm targets: a self-contained module, not a
    relocatable object, so there is no separate link step to give a linker flag to. */
const OBJFMT_WASM: str = "wasm"

/**
 * target_objfmt — the OBJECT FORMAT an own-backend target emits, as the token the
 * `--allow-undef` translation table (§5.2) and the COFF import-lib rule (R5) key on. Named by
 * format rather than by OS because that is what the transitional system linker's flag spelling
 * actually depends on. C3 folds this into `TargetRow.objfmt`.
 *
 * @param t  the own-backend target
 * @return   `OBJFMT_ELF` / `OBJFMT_MACHO` / `OBJFMT_COFF` / `OBJFMT_WASM`
 * @since 0.3.1
 */
fn target_objfmt(t: NativeTarget) -> str {
    match t {
        NativeTarget::Arm64Macho => OBJFMT_MACHO
        NativeTarget::X8664Linux => OBJFMT_ELF
        NativeTarget::X8664Windows => OBJFMT_COFF
        NativeTarget::Wasm32Wasi => OBJFMT_WASM
        NativeTarget::Wasm64Wasi => OBJFMT_WASM
        NativeTarget::Wasm32Browser => OBJFMT_WASM
    }
}

/**
 * links_with_cc — the ONE rule for "will this build actually run a `cc`/`ld` LINK step?", given
 * whether a cross toolchain was explicitly pinned.
 *
 * TWO REASONS A BUILD NEVER REACHES A LINKER, and they are different in kind. The wasm targets have
 * no link step at all: their own-backend tail (`emit_native_wasm`) writes a finished, self-contained
 * module (`backend-wasm.md` §1.2). A CROSS target has one in principle, but this host has no honest
 * linker to run it with — so the build stops at the OBJECT, which is what the cross build's claim
 * was all along.
 *
 * PINNING IS THE ESCAPE HATCH, and it is deliberate: somebody who names a cross compiler
 * (`[extern] cc`, `TEKO_CC`) is asserting they have one, and the build obeys them — subject to the
 * MinGW ban, which `invoke_cc` enforces on whatever they named.
 *
 * @param t       the own-backend target
 * @param pinned  whether a cross compiler was explicitly named for this build
 * @return        true iff a link step will run
 * @since 0.3.1
 */
fn links_with_cc(t: NativeTarget, pinned: bool) -> bool {
    if target_objfmt(t) == OBJFMT_WASM { return false }
    !cross_note(t).is_cross || pinned
}

/**
 * target_links_with_cc — `links_with_cc` for a build that pinned no compiler beyond the `TEKO_CC`
 * seam: the form the regressor's pre-build capability probes ask, since they see the environment but
 * not a project's manifest.
 *
 * WHY THE ANSWER CHANGED FOR A CROSS TARGET (it used to be "yes, every relocatable-object target
 * links"): a cross build now stops at the object, so the probes that used to demand a cross linker
 * on the PATH — and honest-skip the row without one — must stop demanding a tool the build no longer
 * invokes. That is what lets `own_cross_x86_64_windows_emits_coff` run on a Linux host with NO MinGW
 * installed while still checking the only thing it ever claimed: the emitted object's format.
 *
 * @param t  the own-backend target
 * @return   true iff building for `t` on this host runs a link step
 * @since 0.3.1
 */
fn target_links_with_cc(t: NativeTarget) -> bool { links_with_cc(t, teko_cc_env().len > 0) }

/**
 * build_links_binary — `links_with_cc` for THIS build, which also sees the manifest's own `[extern]
 * cc` override — the form `finish_native_object` consults before it links.
 *
 * @param t  the own-backend target
 * @param m  the resolved manifest (its `cc` override counts as a pin)
 * @return   true iff this build links a binary, false when it stops at the object
 * @since 0.3.1
 */
fn build_links_binary(t: NativeTarget, m: Manifest) -> bool {
    links_with_cc(t, m.cc.len > 0 || teko_cc_env().len > 0)
}

/**
 * target_os_name — the OS half of a target's canonical os-arch name (`"linux"` / `"macos"` /
 * `"windows"`), in the same vocabulary `teko::os()` and the bare-OS `[extern.libs.<os>]` section
 * key use; `""` for the wasm targets, which name no host OS. This is the OS a manifest's per-OS
 * section is matched against when the build resolves an explicit `TEKO_TARGET`.
 *
 * @param t  the own-backend target
 * @return   the target's OS name, or "" for a wasm target
 * @since 0.3.1
 */
fn target_os_name(t: NativeTarget) -> str {
    match t {
        NativeTarget::Arm64Macho => "macos"
        NativeTarget::X8664Linux => "linux"
        NativeTarget::X8664Windows => "windows"
        NativeTarget::Wasm32Wasi => ""
        NativeTarget::Wasm64Wasi => ""
        NativeTarget::Wasm32Browser => ""
    }
}

/**
 * target_arch_name — the ARCH half of a target's canonical os-arch name (`"x86_64"` /
 * `"arm64"`), the sibling of `target_os_name` over the same single os-arch string space (D39);
 * `""` for the wasm targets, whose canonical names (`wasm32-wasi`, `wasm64-wasi`, `wasm32-browser`)
 * name a MACHINE MODEL and a host environment, not a CPU that a system linker could be asked to
 * emit for. Split out because the regressor's own-backend capability rule needs the arch a build
 * WOULD emit for, to compare against the arch the host `cc` actually targets
 * (`host_cc_cannot_link_host_default_reason`) — a comparison that must read the arch off the
 * NativeTarget enum rather than re-derive it from a string, so it can never drift from
 * `target_name`.
 *
 * @param t  the own-backend target
 * @return   the target's arch name, or "" for a wasm target
 * @since 0.3.1
 */
fn target_arch_name(t: NativeTarget) -> str {
    match t {
        NativeTarget::Arm64Macho => "arm64"
        NativeTarget::X8664Linux => "x86_64"
        NativeTarget::X8664Windows => "x86_64"
        NativeTarget::Wasm32Wasi => ""
        NativeTarget::Wasm64Wasi => ""
        NativeTarget::Wasm32Browser => ""
    }
}

/**
 * CrossNote — whether the resolved target differs from the build host, plus the human note the
 * build report carries when it does. The run/differential step consults `is_cross` to SKIP
 * execution HONESTLY (an emitted-not-run status), never to invent a green: the host cannot
 * execute an artifact built for another target (R3/R5, teko-target-crosslink-0.3.1.md §3).
 *
 * @since 0.3.1
 */
type CrossNote = struct {
    /** true when the resolved target is not this build host's own target. */
    is_cross: bool
    /** the emitted-not-run report line when `is_cross`, else "". */
    note: str
}

/**
 * cross_note — classify the resolved target against the build host (R3): equal ⇒ not cross and an
 * empty note; different ⇒ cross, with the report line naming BOTH targets
 * (`cross: emitted for x86_64-windows on host x86_64-linux — not executed`). The host side is
 * `host_default_target_guess()`, precise now that `teko::arch()` is seed-recognized (§2.1) for
 * every (os, arch) pair this backend has a target for: on THOSE hosts an explicit same-OS,
 * different-arch request now correctly reads as cross. The one residual imprecision is a host
 * whose OWN (os, arch) pair has no own-backend target at all (arm64-linux, x86_64-macos,
 * arm64-windows) — there the guess falls back to the OS's dominant arch, so an explicit
 * same-OS cross request reads as NOT cross and is still executed on that host: the
 * conservative direction (the host runs it and reports the real exit) rather than a fabricated
 * skip. It never mis-reports the reverse.
 *
 * @param target  the resolved own-backend target
 * @return        the cross classification + its report line
 * @since 0.3.1
 */
fn cross_note(target: NativeTarget) -> CrossNote {
    let host = host_default_target_guess()
    if target == host { return CrossNote { is_cross = false; note = "" } }
    CrossNote { is_cross = true; note = $"teko: cross: emitted for {target_name(target)} on host {target_name(host)} — not executed" }
}

/**
 * cross_note_for_name — `cross_note` keyed by a target NAME (a `TEKO_TARGET` value or a regressor's
 * `Given target`), so the regression runner's honest run-skip and the build's own emitted-not-run
 * note read the SAME rule instead of each carrying its own idea of what "cross" means (D39). An
 * unrecognized name is not cross here: its honest R2 stop belongs to `emit_native`.
 *
 * @param name  the target name ("" → the host default, i.e. never cross)
 * @return      the cross classification for that name
 * @since 0.3.1
 */
fn cross_note_for_name(name: str) -> CrossNote {
    if name.len == 0 { return CrossNote { is_cross = false; note = "" } }
    match target_from_name(name) { NativeTarget as t => cross_note(t); error => CrossNote { is_cross = false; note = "" } }
}

/**
 * resolved_cross_note — `cross_note` for the target THIS build resolved (`resolved_target`), the
 * form the build's run steps consult: `teko run`'s execute step and the native test gate's run
 * both print `note` and skip the child process when `is_cross`, so a cross build reports
 * "emitted, not executed" instead of failing on an artifact this host cannot exec.
 *
 * @return the cross classification for this build
 * @since 0.3.1
 */
fn resolved_cross_note() -> CrossNote { cross_note(resolved_target()) }

/**
 * LinkTargetKeys — the keys a deferred `[extern.libs.<key>]` section is matched against, so the
 * LINK line and the M.3 validators apply ONE applicability rule instead of two (D39).
 *
 * @since 0.3.1
 */
type LinkTargetKeys = struct {
    /**
     * The BUILD's OS as `target_os` resolves it (the `[extern] target` triple, else the host) — the
     * pre-0.3.1 match, kept verbatim so no existing manifest changes meaning.
     */
    build_os: str
    /**
     * The RESOLVED TARGET's own OS — what "any arch of that OS" (LEGISLATION:426) means for a CROSS
     * build, where the build host's OS is not the OS being linked for. "" for a wasm target, which
     * names no host OS (and has no link step).
     */
    emit_os: str
    /** The resolved target's canonical os-arch name — the ratified §4.2 arch key. */
    os_arch: str
}

/**
 * link_target_keys — the applicability keys for THIS build's link line: `target_os`'s answer (the
 * historic key, unchanged), the resolved target's own OS, and the resolved target's os-arch name.
 *
 * @param m  the resolved manifest (its `[extern] target` triple feeds `target_os`)
 * @return   the three keys a deferred section may match
 * @since 0.3.1
 */
fn link_target_keys(m: Manifest) -> LinkTargetKeys {
    let t = resolved_target()
    LinkTargetKeys { build_os = target_os(m); emit_os = target_os_name(t); os_arch = target_name(t) }
}

/**
 * target_link_keys — the applicability keys for a target judged ON ITS OWN, with no build around
 * it: the M.3 validators ask "is this lib available FOR THIS TARGET", which is a question about the
 * target, not about the host or the `cc` triple seam, so both OS slots are the target's own OS.
 *
 * @param t  the resolved own-backend target
 * @return   the three keys a deferred section may match for `t`
 * @since 0.3.1
 */
fn target_link_keys(t: NativeTarget) -> LinkTargetKeys {
    LinkTargetKeys { build_os = target_os_name(t); emit_os = target_os_name(t); os_arch = target_name(t) }
}

/**
 * os_lib_key_matches — does a deferred `[extern.libs.<key>]` section apply? The section key is
 * EITHER a bare OS — matching any arch of that OS (LEGISLATION:426), which for a CROSS build means
 * the OS being linked FOR as well as the historic `target_os` answer — OR a full os-arch name,
 * matching exactly one target (the ratified §4.2 arch-key fill). Additive by construction: every
 * key that matched before still matches, so no existing manifest changes meaning. An empty key
 * (a malformed `[extern.libs.]` header) matches nothing.
 *
 * @param key   the section key as written in the manifest
 * @param keys  the build's (or the target's) applicability keys
 * @return      true iff the section's flags belong on this link line
 * @since 0.3.1
 */
fn os_lib_key_matches(key: str, keys: LinkTargetKeys) -> bool {
    if key.len == 0 { return false }
    key == keys.build_os || key == keys.emit_os || key == keys.os_arch
}

/**
 * strip_trailing_slash — `dir` without a single trailing `/`, so a joined
 * `<dir>/<stem>` never doubles the separator (`./bin/` → `./bin`). Returns `dir`
 * unchanged when it is empty or has no trailing slash.
 *
 * @param dir  the directory path
 * @return     `dir` with one trailing `/` removed, if present
 */
fn strip_trailing_slash(dir: str) -> str {
    if dir.len > 0 && dir[dir.len - 1] == b'/' { return teko::str::slice_to(dir, dir.len - 1) }
    dir
}

/**
 * mkdir_p — create `dir` and every missing parent, since `teko::fs::mkdir` is a single
 * `mkdir(2)` (it will not create `target/debug` unless `target` already exists). Walk the
 * path left to right, creating each `/`-terminated prefix in turn, then the full path; an
 * already-existing level is a no-op (`tk_rt_mkdir` treats EEXIST as success). Used by the
 * `teko run` debug builder, whose scratch dir (`target/debug`) is two levels deep.
 *
 * @param dir  the directory to create (with any parents it needs)
 * @return     an `error` when a level cannot be created, else `null` on success
 */
fn mkdir_p(dir: str) -> error | null {
    mut i: u64 = 0
    loop {
        if i >= dir.len { break }
        if dir[i] == b'/' && i > 0 {
            match teko::fs::mkdir(teko::str::slice_to(dir, i)) { error as e => return e; null => { } }
        }
        i = i + 1
    }
    teko::fs::mkdir(dir)
}

/**
 * emit_native — the own-AOT-backend driver (the #385 A4-5 KEYSTONE, extended for
 * x86-64 at #386 B1-8 and Windows at #388 B3-4): lower the
 * checked program to target-independent LIR, then dispatch on `native_target()` to
 * the per-ISA tail — arm64 `MInst`/AAPCS64/Mach-O (the macOS-host-default,
 * byte-unchanged A4 path), x86-64 `MInstX86`/SysV/ELF (the B1 path, the linux-host
 * default OR `TEKO_TARGET=x86_64-linux`), or x86-64 `MInstX86`/Win64/PE-COFF (the B3
 * path, the windows-host default OR `TEKO_TARGET=x86_64-windows` — the SAME x86
 * ISA as the Linux path, differing only in the `win64` register file and the
 * `emit_coff` object format). Each tail selects instructions, allocates registers,
 * encodes machine bytes, wraps them in the target object format, writes the `.o`,
 * and links it into a native executable against the C-built `teko_rt`/`assert`
 * runtime via `cc`-as-linker (`link_object`, the D-C bootstrap). Any pipeline
 * pass's NAMED honest-stop (`A4-fp`/`B1-fp`/`B1-args`/…) propagates out unchanged
 * as a `fail`, so an unsupported program stops identically to any other backend
 * diagnostic (M.3 — never a fabricated artifact) and the C-vs-own differential
 * compares at the stop, not a fake value; a SET-but-unrecognized `TEKO_TARGET`
 * fails the SAME honest way (R2, `native_target`'s error arm below). Reached only
 * when `m.backend == Backend::Native` (the resolved backend, `TEKO_BACKEND=native`
 * — the earlier `--backend` CLI flag was removed, owner ruling 2026-07-24); the
 * default C path is untouched.
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the build output directory (`-o`, default "bin")
 * @param prog     the checked, typed program
 * @param m        the resolved manifest (link knobs)
 * @return         0 on a successful build+link, else the failing status
 */
fn emit_native(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest) -> i32 {
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let lmod = match teko::lir::lower_program(prog) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    match target {
        NativeTarget::X8664Linux => emit_native_x86(dir, od, stem, lmod, prog, m)
        NativeTarget::X8664Windows => emit_native_win(dir, od, stem, lmod, prog, m)
        NativeTarget::Arm64Macho => emit_native_arm64(dir, od, stem, lmod, prog, m)
        NativeTarget::Wasm32Wasi => emit_native_wasm(dir, od, stem, lmod, prog, m, false, false)
        NativeTarget::Wasm64Wasi => emit_native_wasm(dir, od, stem, lmod, prog, m, false, true)
        NativeTarget::Wasm32Browser => emit_native_wasm(dir, od, stem, lmod, prog, m, true, false)
    }
}

/**
 * emit_native_arm64 — the arm64/Mach-O own-backend tail (the A4 reference, #385): give `lmod` the
 * platform-ABI entry point (`teko::lir::wrap_native_entry` — `argc`/`argv` + `tk_set_args`, 0.3.1
 * native-args fix), select arm64 `MInst` from the wrapped module, allocate registers under
 * AAPCS64, encode to arm64 machine words, wrap them in a Mach-O object, and hand the bytes to
 * `finish_native_object` (write `.o` + `cc`-link + `.tsym` + success marker). The pipeline calls
 * are otherwise the SAME order as A4-5, so the arm64 differential and the FIXPOINT (gen2 == gen3
 * under this SAME updated compiler) are preserved.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @param prog  the checked program (extern-reachability, `.tsym`)
 * @param m     the resolved manifest (link knobs)
 * @return      0 on a successful build+link, else the failing status
 */
fn emit_native_arm64(dir: str, od: str, stem: str, lmod: teko::lir::LModule, prog: checker::TProgram, m: Manifest) -> i32 {
    let entry = match teko::lir::wrap_native_entry(lmod) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let sel = match teko::backend::select_module(entry) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_native_object(dir, od, stem, teko::backend::emit_macho(enc), prog, m)
}

/**
 * emit_native_x86 — the x86-64/ELF own-backend tail (#386 B1): give `lmod` the platform-ABI entry
 * point (`teko::lir::wrap_native_entry` — `argc`/`argv` + `tk_set_args`, 0.3.1 native-args fix),
 * select x86-64 `MInstX86` from the wrapped module, allocate registers under the SysV AMD64
 * register file (`sysv64`), encode to variable-length x86 machine bytes, wrap them
 * in an `ET_REL` ELF64 object (`emit_elf`), and hand the bytes to
 * `finish_native_object` (write `.o` + `cc`-link + `.tsym` + success marker).
 * Reached only via `TEKO_TARGET=x86_64-linux`; the emitted `.o` is a linux x86-64
 * object, so the executing C-vs-own differential runs on a linux-x86_64 host
 * (`scripts/diff_c_own.sh`), while a macOS host still writes the `.o` for the
 * byte / well-formedness cross-check even though `cc` cannot link an ELF there.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @param prog  the checked program (extern-reachability, `.tsym`)
 * @param m     the resolved manifest (link knobs)
 * @return      0 on a successful build+link, else the failing status
 */
fn emit_native_x86(dir: str, od: str, stem: str, lmod: teko::lir::LModule, prog: checker::TProgram, m: Manifest) -> i32 {
    let entry = match teko::lir::wrap_native_entry(lmod) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let sel = match teko::backend::select_module_x86(teko::backend::SYSV64, entry) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module_x86(teko::backend::SYSV64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module_x86(teko::backend::SYSV64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_native_object(dir, od, stem, teko::backend::emit_elf(enc), prog, m)
}

/**
 * emit_native_win — the x86-64/Win64/PE-COFF own-backend tail (#388 B3): give `lmod` the
 * platform-ABI entry point (`teko::lir::wrap_native_entry` — `argc`/`argv` + `tk_set_args`, 0.3.1
 * native-args fix), select x86-64 `MInstX86` from the wrapped module under the Win64 ABI register
 * file (`win64` — call/return arguments land in RCX/RDX/R8/R9, the byte-differing
 * counterpart of the SysV `emit_native_x86`), allocate registers under the same
 * `win64` descriptor, encode to the SAME variable-length x86 machine bytes as the
 * Linux path (the x86 ISA is shared — only the ABI register partition differs),
 * wrap them in a PE/COFF object (`emit_coff`, B3-3), and hand the bytes to
 * `finish_native_object` (write `.o` + `cc`-link + `.tsym` + success marker).
 * Reached only via `TEKO_TARGET=x86_64-windows`; the emitted `.o` is a Windows
 * x86-64 object, so the executing C-vs-own differential runs on a Windows host
 * (B3-4), while a non-Windows host still writes the `.o` for the byte /
 * well-formedness cross-check (`llvm-readobj` is cross-format) even though the
 * host `cc` cannot link a PE there without the MinGW cross toolchain.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @param prog  the checked program (extern-reachability, `.tsym`)
 * @param m     the resolved manifest (link knobs)
 * @return      0 on a successful build+link, else the failing status
 */
fn emit_native_win(dir: str, od: str, stem: str, lmod: teko::lir::LModule, prog: checker::TProgram, m: Manifest) -> i32 {
    let entry = match teko::lir::wrap_native_entry(lmod) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let sel = match teko::backend::select_module_x86(teko::backend::WIN64, entry) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module_x86(teko::backend::WIN64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module_x86(teko::backend::WIN64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_native_object(dir, od, stem, teko::backend::emit_coff(enc), prog, m)
}

/**
 * report_object_only — the SUCCESS report of a cross build that stopped at the object: it names the
 * object, the target it is for, and the host that emitted it.
 *
 * IT IS A SUCCESS AND IT SAYS SO, which is the difference between this and a skip. The build produced
 * exactly the artifact a cross build can produce here and the artifact is checkable; nothing was left
 * unverified, so nothing should read as outstanding. The line keeps the EXCLUSIVE `"(own backend)"`
 * marker every own-backend report carries, so a harness keying on it sees the emission it expects.
 *
 * @param dir   the project directory (for diagnostics)
 * @param objp  the emitted object path
 * @param t     the cross target the object was emitted for
 * @return      0 — the build succeeded
 * @since 0.3.1
 */
fn report_object_only(dir: str, objp: str, t: NativeTarget) -> i32 {
    teko::io::println($"teko: {dir}: emitted {objp} for {target_name(t)} (own backend) — not linked on host {target_name(host_default_target_guess())}: the object IS the artifact of a cross build here")
    0
}

/**
 * finish_native_object — the object-format-agnostic tail shared by every own-backend
 * target: write the encoded object bytes to `<od>/<stem>.o`, link it into
 * `<od>/<stem>` via `cc`-as-linker (`link_object`) against the C-built runtime,
 * write the `.tsym` symbol map beside the binary (best-effort — a write error never
 * fails the build), and print the EXCLUSIVE `"(own backend)"` success marker the
 * differential harness keys on (F1(a)). Factoring it here keeps the arm64, x86 and
 * Windows tails identical past the encoder, so the link paths never drift.
 *
 * A CROSS BUILD STOPS AT THE OBJECT, and that is the artifact it was always claiming. The `.o` is
 * written first, then `build_links_binary` decides: on this host's own target the link runs exactly
 * as before, while for a foreign target with no pinned cross compiler the build reports the object
 * and succeeds — no linker is invoked, because none on this host can honestly link a foreign format
 * and the banned one is not an option (owner 2026-07-29: *"queremos sim Cross compiling quando todos
 * os natives estiverem funcionando, mas não quero saber de mingw"*). Nothing is lost by stopping:
 * a cross artifact could never be RUN here either (`cross_note`), so the object's format was the
 * whole claim, and it stays checkable (`llvm-readobj` reads COFF on any host). The full cross LINK
 * arrives with the project's own linker, after the natives work.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param obj   the encoded object-file bytes (Mach-O, ELF or PE/COFF)
 * @param prog  the checked program (`.tsym` emission)
 * @param m     the resolved manifest (link knobs)
 * @return      0 on a successful write+link (or write, for a cross target), else the failing status
 */
fn finish_native_object(dir: str, od: str, stem: str, obj: []byte, prog: checker::TProgram, m: Manifest) -> i32 {
    let objp = teko::str::concat(od, "/", teko::str::concat(stem, ".o"))
    let binp = teko::str::concat(od, "/", stem)
    match teko::io::write_file_bytes(objp, obj) { error as e => return fail(dir, e.message); null => { } }
    let target = resolved_target()
    if !build_links_binary(target, m) { return report_object_only(dir, objp, target) }
    if link_object(objp, binp, m, prog) != 0 {
        return fail(dir, "cc failed to link the own-backend object")
    }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, " (own backend)")))
    0
}

/**
 * emit_static_lib — the `Artifact::Static` (`kind = "static"`) tail (KP16, the
 * kill-C static-archive substrate, `docs/design/kill-c-pull-forward-0.3.0.30.md`
 * §2(b); the Mach-O/COFF lanes ported from the real-toolchain-validated
 * `theory/kp16-ar-macho-coff` branch): own-native ONLY — requires
 * `Backend::Native` (`TEKO_BACKEND=native`), since a static archive wraps an
 * own-emitted `.o`, and the C emitter never produces one. Lowers the checked
 * program to LIR exactly as `emit_native` does, then dispatches on the
 * selected target: the ELF target (`x86_64-linux`)
 * archives its whole-program object via the KP16 GNU-format writer
 * (`teko::backend::emit_static_archive`); `arm64-macos` via the BSD
 * `__.SYMDEF` writer (`emit_static_archive_macho`); `x86_64-windows` via the
 * MS two-linker-member `.lib` writer (`emit_static_archive_coff`); every wasm
 * target is a NAMED honest stop — a wasm module has no static-archive
 * convention to wrap into (M.3 — no fake artifact). Lowers with `flat_symbols
 * = true` (`teko::lir::mangle_fn_symbol`'s carve-out): the archive itself IS
 * the published C contract — there is no separate wrapper the way the C
 * backend's `abi = "c"` reverse-FFI export has — so every function's LIR
 * symbol must be the BARE mangle (`<ns>__<name>`), never `TEKO_USER_PREFIX`-
 * decorated, or a real consumer's `extern` declaration fails to link (measured:
 * `examples/toolchain/ar_link_run` published `teko_ar_link_run__add` where the
 * archive contract is `ar_link_run__add`). `lower_program`
 * unconditionally synthesizes a virtual `int main()` from the project's loose
 * top-level statements (`emit_native`'s entry point for a `binary` artifact)
 * — a library has none of its own, but `lower_program` is shared with the
 * binary path and always appends the (trivial, `return 0`) synthesized one
 * regardless, so it is stripped here (`strip_virtual_main`) BEFORE any target
 * tail runs: a `static` artifact must never export a bare `main` symbol for a
 * real consumer's own `main` to collide with (found by the theory branch's
 * real link+run validation, a gap `ar`/`nm`/`ld -r`-only checking never
 * caught).
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the build output directory (`-o`, default "bin")
 * @param prog     the checked, typed program
 * @param m        the resolved manifest
 * @return         0 on a successful build+archive, else the failing status
 */
fn emit_static_lib(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest) -> i32 {
    if m.backend != Backend::Native {
        return fail(dir, "static library output (.a) needs the own-native backend (TEKO_BACKEND=native) — the C emitter never produces a `.o` to archive")
    }
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let raw_lmod = match teko::lir::lower_program(prog, true) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let lmod = strip_virtual_main(raw_lmod)
    let target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    match target {
        NativeTarget::X8664Linux => emit_static_lib_x86(dir, od, stem, lmod)
        NativeTarget::Arm64Macho => emit_static_lib_macho(dir, od, stem, lmod)
        NativeTarget::X8664Windows => emit_static_lib_coff(dir, od, stem, lmod)
        _ => fail(dir, "static library output has no wasm convention to wrap into (M.3)")
    }
}

/**
 * strip_virtual_main — `lmod` with the synthesized virtual `main` `LFunc`
 * removed (identified by its exact, un-namespaced `"main"` symbol —
 * `lower_virtual_main` builds it via `new_func("main", ...)` directly,
 * bypassing `mangle_fn_symbol`, so a real user function can never collide
 * with this exact bare name: any root-level `pub`/`exp fn main` mangles to
 * `<project>__main` instead). Every OTHER field (`rodata`/`globals`/
 * `layouts`) passes through unchanged; only `funcs` is filtered.
 *
 * @param lmod  the freshly lowered module (still carrying the virtual main)
 * @return      the same module with the virtual main's `LFunc` dropped
 */
fn strip_virtual_main(lmod: teko::lir::LModule) -> teko::lir::LModule {
    mut kept: []teko::lir::LFunc = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= lmod.funcs.len { break }
        if lmod.funcs[i].symbol != "main" { kept = teko::list::push(kept, lmod.funcs[i]) }
        i++
    }
    teko::lir::LModule { funcs = kept; rodata = lmod.rodata; globals = lmod.globals; layouts = lmod.layouts }
}

/**
 * emit_static_lib_x86 — the x86-64/ELF static-archive tail: select, allocate,
 * and encode exactly as `emit_native_x86` does, then hand the encoded module's
 * object bytes AND its neutral symbol list (for the archive's exported-symbol
 * index) to `finish_static_archive` in place of `finish_native_object`'s cc-link.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 */
fn emit_static_lib_x86(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module_x86(teko::backend::SYSV64, lmod) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module_x86(teko::backend::SYSV64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module_x86(teko::backend::SYSV64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_elf(enc), enc.symbols, ArchiveFormat::Gnu)
}

/**
 * emit_static_lib_macho — the arm64/Mach-O static-archive tail: select,
 * allocate, and encode exactly as `emit_native_arm64` does, then hand the
 * encoded module's Mach-O object bytes AND its neutral symbol list to
 * `finish_static_archive` under the BSD `__.SYMDEF` archive format.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 */
fn emit_static_lib_macho(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module(lmod) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_macho(enc), enc.symbols, ArchiveFormat::Bsd)
}

/**
 * emit_static_lib_coff — the x86-64/Win64/PE-COFF static-archive tail: select,
 * allocate, and encode exactly as `emit_native_win` does, then hand the
 * encoded module's PE/COFF object bytes AND its neutral symbol list to
 * `finish_static_archive` under the MS two-linker-member `.lib` archive
 * format.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 */
fn emit_static_lib_coff(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module_x86(teko::backend::WIN64, lmod) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module_x86(teko::backend::WIN64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module_x86(teko::backend::WIN64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_coff(enc), enc.symbols, ArchiveFormat::Coff)
}

/**
 * ArchiveFormat — which static-archive container `finish_static_archive`
 * wraps the encoded object into: `Gnu` (KP16's ELF-only writer), `Bsd` (the
 * Mach-O `__.SYMDEF` writer), or `Coff` (the MS two-linker-member `.lib`
 * writer). One shared tail keeps the archive-name convention and the
 * `.o`-write-before-archive ordering identical across all three, so only the
 * container bytes and the output extension differ.
 */
type ArchiveFormat = enum { Gnu; Bsd; Coff }

/**
 * archive_output_path — the finished archive's on-disk path under `od`: the
 * Unix `ar`/`ranlib` convention `lib<stem>.a` for `Gnu`/`Bsd` (every `-l<stem>`
 * linker search on Linux/macOS expects this), or the MS `link.exe`/`lib.exe`
 * convention `<stem>.lib` for `Coff` (no `lib` prefix, `.lib` extension).
 *
 * @param od      the slash-stripped output directory (already created)
 * @param stem    the output artifact name (the manifest `name`)
 * @param format  the target archive container
 * @return        the archive's on-disk path
 */
fn archive_output_path(od: str, stem: str, format: ArchiveFormat) -> str {
    match format {
        Coff => teko::str::concat(od, "/", teko::str::concat(stem, ".lib"))
        _ => teko::str::concat(od, "/", teko::str::concat("lib", teko::str::concat(stem, ".a")))
    }
}

/**
 * wrap_archive_bytes — dispatch the encoded object + its neutral symbol list
 * to the container writer named by `format`: KP16's GNU-format ELF writer
 * (`teko::backend::emit_static_archive`), the BSD `__.SYMDEF` writer
 * (`emit_static_archive_macho`), or the MS two-linker-member `.lib` writer
 * (`emit_static_archive_coff`) — the Mach-O/COFF writers live in
 * `src/backend/objfile_ar_macho.tks`/`objfile_ar_coff.tks`.
 *
 * @param member_name  the archive member's bare on-disk name (`"<stem>.o"`)
 * @param obj          the encoded object-file bytes
 * @param symbols      the encoded module's neutral symbol list
 * @param format       the target archive container
 * @return             the finished archive bytes, or an honest-stop
 * @throws             when the GNU writer's `member_name` exceeds its 15-byte short-name budget
 */
fn wrap_archive_bytes(member_name: str, obj: []byte, symbols: []teko::backend::Symbol, format: ArchiveFormat) -> []byte | error {
    match format {
        Gnu => teko::backend::emit_static_archive(member_name, obj, symbols)
        Bsd => teko::backend::emit_static_archive_macho(member_name, obj, symbols)
        Coff => teko::backend::emit_static_archive_coff(member_name, obj, symbols)
    }
}

/**
 * finish_static_archive — the object-format-agnostic tail shared by every
 * static-archive target: write the encoded `.o` bytes to `<od>/<stem>.o` (the
 * same on-disk object a binary build would produce), wrap it into a
 * single-member static archive under `format` (`wrap_archive_bytes`) indexed
 * by `symbols`' exported entries, write it to its platform-conventional path
 * (`archive_output_path`), and print the EXCLUSIVE `"(own backend, static
 * archive)"` success marker.
 *
 * @param dir      the project directory (for diagnostics)
 * @param od       the slash-stripped output directory (already created)
 * @param stem     the output artifact name (the manifest `name`)
 * @param obj      the encoded object-file bytes (own-native emitted)
 * @param symbols  the encoded module's neutral symbol list (the archive's
 *                 exported-symbol index)
 * @param format   the target archive container
 * @return         0 on a successful write+archive, else the failing status
 *                 (including the GNU writer's over-length member-name honest-stop)
 */
fn finish_static_archive(dir: str, od: str, stem: str, obj: []byte, symbols: []teko::backend::Symbol, format: ArchiveFormat) -> i32 {
    let objp = teko::str::concat(od, "/", teko::str::concat(stem, ".o"))
    let member_name = teko::str::concat(stem, ".o")
    let libp = archive_output_path(od, stem, format)
    match teko::io::write_file_bytes(objp, obj) { error as e => return fail(dir, e.message); null => { } }
    let archive = match wrap_archive_bytes(member_name, obj, symbols, format) { []byte as b => b; error as e => return fail(dir, e.message) }
    match teko::io::write_file_bytes(libp, archive) { error as e => return fail(dir, e.message); null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", libp, " (own backend, static archive)")))
    0
}

/**
 * emit_native_wasm — the wasm own-backend tail (#389 C1-5, reworked to the
 * ratified `backend-wasm.md` §1.2 shape; the wasm64 switch at C1-7, §6):
 * assemble the lowered LIR module into a whole `WasmModule`
 * (`teko::backend::wasm_assemble_program` — stackify every function, wire
 * the WASI import set, synthesize + export `_start`, lay out linear memory;
 * propagates any pipeline honest-stop, e.g. `C1-globals`/`C1-i128`/
 * `C1-f16`/`C1-irreducible`/`C1-wasm64-scope`, unchanged as a `fail`, M.3),
 * then serialize it (`emit_wasm`) to a finished, SELF-CONTAINED `.wasm`
 * module and write it DIRECTLY to `<od>/<stem>.wasm`. §1.2 is law: the wasm
 * path emits ONE module that IMPORTS its runtime via WASI imports — there
 * is no relocatable-object + external-linker step (no `wasm-ld`, no
 * `zig`-compiled shim), so the emitted bytes ARE the runnable artifact (the
 * module already embeds its linear memory, the `_start` export, and its
 * active data). Writes the `.tsym` symbol map beside the module (best-
 * effort, mirrors `finish_native_object`) and prints the EXCLUSIVE `"(own
 * backend)"` success marker the differential harness keys on (F1(a)). The
 * `Wasm32Browser` variant's JS-import self-contained module + glue is a
 * LATER slice (N6b, §7) — reaching it here is a clean, NAMED stop, not a
 * silent Browser-as-WASI fallback.
 *
 * @param dir      the project directory (diagnostics)
 * @param od       the slash-stripped output directory (already created)
 * @param stem     the output artifact name
 * @param lmod     the lowered LIR module
 * @param prog     the checked program (`.tsym` emission)
 * @param m        the resolved manifest (unused today — no wasm-side
 *                 `[extern]`/`cc` override yet; kept for signature parity
 *                 with the register targets' own `emit_native_*` tails)
 * @param browser  `true` for the `Wasm32Browser` variant (JS-import + glue,
 *                 N6b territory — not yet wired)
 * @param ptr64    `true` for the `Wasm64Wasi` variant (the wasm64 switch,
 *                 #389 C1-7, §6 — scoped to `wasm_scope_stop_wasm64`'s own
 *                 supported subset today)
 * @return         0 on a successful build, else the failing status
 */
fn emit_native_wasm(dir: str, od: str, stem: str, lmod: teko::lir::LModule, prog: checker::TProgram, m: Manifest, browser: bool, ptr64: bool) -> i32 {
    if browser {
        return fail(dir, "wasm32-browser: the JS-import Browser variant is not wired yet (N6b territory, backend-c1-wasm.md §9)")
    }
    let wmod = match teko::backend::wasm_assemble_program(lmod, ptr64) { teko::backend::WasmModule as x => x; error as e => return fail(dir, e.message) }
    let binp = teko::str::concat(od, "/", teko::str::concat(stem, ".wasm"))
    match teko::io::write_file_bytes(binp, teko::backend::emit_wasm(wmod)) { error as e => return fail(dir, e.message); null => { } }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, " (own backend)")))
    0
}

// =========================================================================
// compile_project — mirror driver.c::tk_compile_project (the `teko build <dir>` entry).
// Front-end (manifest → discover → assemble → check), then the native backend over the
// merged program. The output binary stem is the manifest `name`.
// =========================================================================
/**
 * The parent directory of `path` — everything before the rightmost path separator — or "."
 * when `path` carries no separator. A minimal local helper (no teko::fs::dirname exists yet).
 * A reverse byte scan finds the rightmost of a POSIX '/' and a Windows '\', so a POSIX path
 * with no '\' splits at exactly its last '/' — byte-identical to a plain last-'/' split. The
 * scan is used instead of teko::str::last_index_of because that builtin is native-only (the VM
 * does not implement it), and dirname_of is exercised by both engines.
 *
 * @param path  an argv[0]-style invocation path, POSIX- or Windows-separated
 * @return      the directory portion of `path`, or "." when it carries no separator
 */
fn dirname_of(path: str) -> str {
    mut i = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        let b = path[i]
        if b == b'/' || b == b'\\' { return teko::str::slice_to(path, i) }
    }
    "."
}

/**
 * The last path segment of `path` — everything after the rightmost path separator — or the
 * whole `path` when it carries no separator. The mirror of `dirname_of` (same reverse
 * POSIX-or-Windows-separator scan, so together `dirname_of(p) ~ "/" ~ basename_of(p)`
 * reconstructs a separator-normalized `p`), used by the regression runner (0.3.1 C0) to split a
 * manifest-listed `.tkr` FILE path into its regressor directory and basename without a
 * `teko::str::last_index_of` call (native-only — the VM does not implement it).
 *
 * @param path  an argv[0]-style invocation path, POSIX- or Windows-separated
 * @return      the segment after the rightmost separator, or `path` unchanged when it carries none
 */
fn basename_of(path: str) -> str {
    mut i = path.len
    loop {
        if i == 0 { break }
        i = i - 1
        let b = path[i]
        if b == b'/' || b == b'\\' { return teko::str::slice_from(path, i + 1) }
    }
    path
}

/**
 * Whether `b` is an ASCII letter (A-Z or a-z) — the drive-letter test for a Windows absolute
 * path such as `C:\...`. Named with an `_ascii_` segment to stay distinct from the `is_alpha`
 * char builtin, which classifies a full Unicode `char` rather than a raw path byte.
 *
 * @param b  the byte to classify
 * @return   true when `b` is an ASCII letter
 */
fn is_ascii_alpha(b: byte) -> bool {
    (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z')
}

/**
 * Make `path` absolute against `cwd` when it isn't already, recognising POSIX and Windows
 * absolute shapes without disturbing the POSIX arm: a leading '/' (POSIX, checked FIRST and
 * unchanged), a `<letter>:` drive prefix (`C:\...` or `C:/...`), or a `\\` UNC prefix — each is
 * already absolute and returned as-is. Anything else is joined onto `cwd` with a '/'. Returns
 * "" when `path` is empty, or when a relative `path` has no `cwd` to anchor it.
 *
 * @param path  an argv[0]-style invocation path or an already-absolute path
 * @param cwd   the directory a relative `path` is resolved against
 * @return      the absolute form of `path`, or "" when neither input is usable
 */
fn abs_path_of(path: str, cwd: str) -> str {
    if path.len == 0 { return "" }
    if path[0] == b'/' { return path }
    if path.len >= 2 && is_ascii_alpha(path[0]) && path[1] == b':' { return path }
    if path.len >= 2 && path[0] == b'\\' && path[1] == b'\\' { return path }
    if cwd.len == 0 { return "" }
    teko::str::concat(cwd, "/", path)
}

// probe_rt_dir — true (and TK_RT_DIR set) when `<base>/src/runtime/teko_rt.h` or
// `<base>/runtime/teko_rt.h` exists (the in-tree layout, then a bundled-install layout).
fn probe_rt_dir(base: str) -> bool {
    match teko::io::read_file(teko::str::concat(base, "/src/runtime/teko_rt.h")) {
        str => { teko::env::set_var("TK_RT_DIR", teko::str::concat(base, "/src/runtime")); return true }
        error => { }
    }
    match teko::io::read_file(teko::str::concat(base, "/runtime/teko_rt.h")) {
        str => { teko::env::set_var("TK_RT_DIR", teko::str::concat(base, "/runtime")); return true }
        error => { }
    }
    false
}

/** home_dir — the current user's home directory: `$HOME` (POSIX) or `%USERPROFILE%` (Windows), whichever resolves first. "" when neither is set. */
fn home_dir() -> str {
    match teko::env::var("HOME") {
        str as h => h
        error => match teko::env::var("USERPROFILE") { str as h => h; error => "" }
    }
}

/** share_rt_bases — the (issue #157) installed-layout probe bases, in order: the per-user share dir (`<home>/.local/share/teko`, mirroring install.sh's `~/.local/bin` prefix) then the system-wide share dir (`/usr/local/share/teko`, mirroring `/usr/local/bin`). install.sh populates `<base>/runtime` + `<base>/assert` + `<base>/win32_compat.h` from the release's teko-bootstrap-src.tar.gz — the same sibling layout probe_rt_dir already expects from an in-tree checkout. */
fn share_rt_bases() -> []str {
    mut bases: []str = teko::list::empty()
    let home = home_dir()
    if home.len > 0 { bases = teko::list::push(bases, teko::str::concat(home, "/.local/share/teko")) }
    bases = teko::list::push(bases, "/usr/local/share/teko")
    bases
}

/** probe_share_rt_dir — true (and TK_RT_DIR set) when any (issue #157) installed-layout share dir carries a `runtime/teko_rt.h`. */
fn probe_share_rt_dir() -> bool {
    let bases = share_rt_bases()
    mut i = 0
    loop {
        if i >= bases.len { break }
        if probe_rt_dir(bases[i]) { return true }
        i++
    }
    false
}

/**
 * If TK_RT_DIR is unset, locate the in-tree runtime relative to the COMPILER BINARY's OWN
 * location (argv[0], via teko::env::args()) — NOT the current working directory (#64: a build
 * run from inside a project directory, or from an unrelated cwd via an absolute project path,
 * must still find teko_rt.c; CWD-relative probing only worked by coincidence when invoked from
 * the compiler's own source tree root). argv[0] is resolved to an absolute path against the
 * PRE-chdir cwd when it isn't already absolute (e.g. `./bin/teko` or a PATH-relative launch from
 * a shell that passes the resolved script path). Probe order:
 *   1. `<bindir>/..` — the repo/tree root (`bin/teko` / `build/teko` sit one level under the
 *      tree root that holds `src/runtime`).
 *   2. `<bindir>` itself — a flat bundled-install layout.
 *   3. the CWD (pre-#64 legacy behavior) — a bare `teko` resolved via $PATH (argv[0] not
 *      filesystem-resolvable) still works when cwd happens to be the compiler's own tree.
 *   4. (issue #157) the installed-layout share dirs (`probe_share_rt_dir`) — a released binary
 *      copied to a bare `bin/` prefix by install.sh has no `src/runtime` sibling at all, so
 *      none of the probes above can ever find it; install.sh instead stages the runtime
 *      sources under `share/teko` beside the chosen bin prefix, and this is the last resort
 *      that finds them.
 * Each probe pins TK_RT_DIR to an ABSOLUTE match so run_cc still finds teko_rt.c after the
 * front-end chdir's into the target project.
 */
fn ensure_rt_dir_abs() {
    match teko::env::var("TK_RT_DIR") { str => return; error => { } }
    let cwd = match teko::env::cwd() { str as c => c; error => "" }

    let argv = teko::env::args()
    if argv.len > 0 {
        let exe_abs = abs_path_of(argv[0], cwd)
        if exe_abs.len > 0 {
            let bindir = dirname_of(exe_abs)
            if probe_rt_dir(dirname_of(bindir)) { return }
            if probe_rt_dir(bindir) { return }
        }
    }

    if cwd.len > 0 && probe_rt_dir(cwd) { return }
    if probe_share_rt_dir() { return }
}

/** compile_project — the `teko build <dir>` entry with every default: the D4 gate ON, no coverage
 *  report, no `--no-verify`, optimization OFF (the dev/CI default level 0), and the NATIVE gate (the
 *  default since #168). Delegates to compile_project_g. Mirrors driver.c::tk_compile_project (the C
 *  seed's VM-only entry).
 *
 *  @param dir      the project directory
 *  @param out_dir  the build output directory (`-o`, default "bin")
 *  @return         0 on a fully gated, successfully built release, else the failing status
 *  @since #265 */
fn compile_project(dir: str, out_dir: str) -> i32 { compile_project_g(dir, out_dir, false, false, 0, false, Backend::C, false) }

// (#148) report_peak — the compiler prints its own memory cost at the end of a successful build
// (peak RSS via teko::mem::peak_rss; 0 = unavailable on this host → print suppressed).
fn report_peak() {
    let pb = teko::mem::peak_rss()
    if pb > 0 {
        let mb10 = pb * 10 / 1048576
        let whole = mb10 / 10
        let frac = mb10 % 10
        teko::io::println($"teko: memory: peak {whole}.{frac} MB")
    }
}

// strip_tests — the production program WITHOUT `#test` functions (D4): a release binary must
// not carry test code. Tests are excluded from codegen; everything else passes through.
fn strip_tests(prog: checker::TProgram) -> checker::TProgram {
    mut kept: []checker::TItem = teko::list::empty()
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        mut drop = false
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test { drop = true } }
            _ => { }
        }
        if !drop { kept = teko::list::push(kept, prog.items[i]) }
        i++
    }
    checker::TProgram { items = kept }
}

/**
 * built_artifact_path — the path of the artifact a BINARY build actually produced: `<out>/<name>`
 * when it linked, `<out>/<name>.o` when a cross build stopped at the object.
 *
 * WITHOUT THIS THE CLOSING LINE LIES. `report_build_done` names a path, and a reader takes that path
 * to exist; a cross build that emits only the object would have it announce a binary nobody wrote.
 * The rule is read from the SAME predicate the build itself decided with (`build_links_binary`), so
 * the report cannot drift from the artifact.
 *
 * Only the BINARY artifact is answered here — a static/shared/package build reports the base path
 * exactly as it always has, and changing those spellings is not this rule's business.
 *
 * @param out_dir  the output directory as given (a trailing slash is stripped)
 * @param m        the resolved manifest (artifact kind, backend, `cc` pin, name)
 * @param t        the target this build resolved
 * @return         the path the build's own artifact lives at
 * @since 0.3.1
 */
fn artifact_path_for(out_dir: str, m: Manifest, t: NativeTarget) -> str {
    let base = teko::str::concat(strip_trailing_slash(out_dir), "/", m.name)
    if m.artifact != Artifact::Binary { return base }
    if m.backend != Backend::Native { return base }
    if build_links_binary(t, m) { return base }
    base ~ ".o"
}

/**
 * built_artifact_path — `artifact_path_for` applied to the target THIS build resolved, the form the
 * closing report calls.
 *
 * @param out_dir  the output directory as given (a trailing slash is stripped)
 * @param m        the resolved manifest (artifact kind, backend, `cc` pin, name)
 * @return         the path the build's own artifact lives at
 * @since 0.3.1
 */
fn built_artifact_path(out_dir: str, m: Manifest) -> str { artifact_path_for(out_dir, m, resolved_target()) }

/**
 * Print the BUILD-OUTPUT OBSERVABILITY closing line: the built artifact's path and
 * the TOTAL wall time since `start` (front-end + backend combined) — the summary
 * the phase list settles into.
 *
 * @param binp   the built artifact path
 * @param start  when the build began, before the front-end ran
 */
fn report_build_done(binp: str, start: i64) {
    teko::io::eprintln(teko::str::concat("built ", binp, teko::str::concat("   ", teko::str::concat(elapsed_str(start), "s"))))
}

/**
 * Emit the C translation unit, selecting the reverse-FFI export emitter (`tk_emit_c_export`, which appends
 * the C-ABI export wrappers) when the artifact's ABI is `"c"`, else the ordinary emitter (FFI-D).
 *
 * @param prog  the checked program
 * @param abi   the artifact ABI (`"c"` = reverse-FFI export, else the native Teko ABI)
 * @return      the emitted C source text
 * @throws      when codegen fails
 * @since 0.3.0.30 (FFI base — reverse-FFI export)
 */
fn ffi_emit_c(prog: checker::TProgram, abi: str) -> str | error {
    if abi == "c" { return codegen::tk_emit_c_export(prog) }
    codegen::tk_emit_c(prog)
}

/**
 * Write the MANDATORY reverse-FFI C header (`<stem>.h`) beside the artifact for an `abi="c"` build — pure
 * text (real C prototypes for every `exp` function), needing no C preprocessor and no cc (FFI-D, KP11).
 *
 * @param od    the output directory (trailing slash stripped)
 * @param stem  the artifact stem (the header is `<stem>.h`)
 * @param prog  the checked program
 * @return      null on success
 * @throws      when the header cannot be generated or written
 * @since 0.3.0.30 (FFI base — reverse-FFI export)
 */
fn ffi_write_c_header(od: str, stem: str, prog: checker::TProgram) -> error | null {
    let hsrc = match codegen::emit_c_header(prog) { str as s => s; error as e => return e }
    let hpath = teko::str::concat(od, "/", teko::str::concat(stem, ".h"))
    match teko::io::write_file(hpath, hsrc) { error as e => return e; null => { } }
    teko::io::println(teko::str::concat("teko: wrote reverse-FFI header ", hpath))
    null
}

/** Hand `prog` to the backend at optimization level `opt` and, on success, report the closing
 *  `built <path> <elapsed>` line (measured since `start`) and the build's peak memory cost
 *  (#148). The shared tail of every build path once its program is final: no tests present,
 *  the `--no-verify` escape hatch, and the gate's own release rebuild. `tty` selects the
 *  backend's in-place `\r` phase updates (BUILD-OUTPUT OBSERVABILITY). */
fn codegen_and_report(dir: str, out_dir: str, prog: checker::TProgram, m: Manifest, opt: i32, tty: bool, start: i64) -> i32 {
    let rc = backend(dir, m.name, out_dir, prog, m, opt, tty)
    if rc == 0 {
        report_build_done(built_artifact_path(out_dir, m), start)
        report_peak()
    }
    rc
}

/** Assemble WITHOUT the `.tkt` tests and codegen straight away at optimization level `opt`, skipping
 *  the D4 gate entirely (issue #249 lever A: `--no-verify`). Used only when the caller has explicitly
 *  opted out of re-verification — e.g. a self-host release chain re-proving the fixpoint on gen-2,
 *  where the `.tkt` gate outcome is already known deterministic from gen-1. This is the path
 *  `release.yml` drives with `--no-verify --release`, so the published seed links at `-O2`.
 *  `backend` is the resolved backend (`TEKO_BACKEND`-selected), stamped onto the manifest before codegen (D1/#390). */
fn build_ungated(dir: str, out_dir: str, opt: i32, tty: bool, start: i64, backend: Backend) -> i32 {
    let fe = match frontend_body(false, false, tty) { Frontend as f => f; error as e => return fail(dir, e.message) }
    codegen_and_report(dir, out_dir, fe.prog, with_backend(fe.manifest, backend), opt, tty, start)
}

/**
 * The human-readable messages for every D4 coverage floor a run fails to meet, in the fixed order
 * functions → lines → branches. Empty (len 0) when every floor holds. The SINGLE source of the
 * floor-comparison logic and its wording, shared by the strict enforcement path
 * (`coverage_gate_result` fails on the first) and the non-blocking path (`warn_coverage_floors`
 * prints them all) so both agree exactly on which floors are unmet. Takes the floors as explicit
 * values (not a `Manifest`) so the comparison is a pure, directly-testable function.
 *
 * @param fcov     the measured function-coverage percentage
 * @param lcov     the measured line-coverage percentage
 * @param bcov     the measured branch-coverage percentage
 * @param floor_f  the [coverage] functions floor percentage
 * @param floor_l  the [coverage] lines floor percentage
 * @param floor_b  the [coverage] branches floor percentage
 * @return         one message per unmet floor (functions, then lines, then branches); empty when all hold
 */
fn unmet_coverage_floors(fcov: u64, lcov: u64, bcov: u64, floor_f: u64, floor_l: u64, floor_b: u64) -> []str {
    mut msgs: []str = teko::list::empty()
    if fcov < floor_f {
        msgs = teko::list::push(msgs, $"function coverage {fcov}% is below the {floor_f}% floor ([coverage] functions) — add tests")
    }
    if lcov < floor_l {
        msgs = teko::list::push(msgs, $"line coverage {lcov}% is below the {floor_l}% floor ([coverage] lines) — add tests")
    }
    if bcov < floor_b {
        msgs = teko::list::push(msgs, $"branch coverage {bcov}% is below the {floor_b}% floor ([coverage] branches) — add tests")
    }
    msgs
}

/**
 * The unmet-floor messages for `fe`'s recorded function/line/branch coverage against the `.tkp`
 * [coverage] floors (default 50/50/49). Thin wrapper over `unmet_coverage_floors` that reads the
 * three measured percentages off the coverage sinks and the three floors off the manifest.
 *
 * @param fe  the assembled front-end product (checked program + manifest with the floors)
 * @return    one message per unmet floor; empty when every floor holds
 */
fn coverage_floor_misses(fe: Frontend) -> []str {
    unmet_coverage_floors(coverage::coverage_pct(fe.prog), coverage::line_coverage_pct(fe.prog), coverage::branch_coverage_pct(fe.prog), fe.manifest.cov_functions, fe.manifest.cov_lines, fe.manifest.cov_branches)
}

/**
 * The D4 coverage-floor POLICY as a pure predicate: does an unmet floor BLOCK the gate? Only when
 * enforcement is opted into (`cov_validation`) AND at least one floor is unmet (owner ruling
 * 0.3.0.29). The single source of the "warn vs fail" decision, exercised directly by the
 * regression tests for both paths.
 *
 * @param misses          the unmet-floor messages (from `coverage_floor_misses`)
 * @param cov_validation  `--cov-validation` — enforcement opted in
 * @return                true iff the gate must FAIL (enforce on AND a floor unmet); false = warn/pass
 */
fn coverage_floor_blocks(misses: []str, cov_validation: bool) -> bool {
    cov_validation && misses.len > 0
}

/**
 * Check the D4 coverage floors STRICTLY (the `--cov-validation` path): 0 when every floor holds,
 * else the FIRST unmet floor's `fail` status (BLOCKED — the build stops here). This is the historic
 * enforcing behavior, now reached only under opt-in validation (owner ruling 0.3.0.29: floors are
 * non-blocking by default — see `enforce_coverage_floors`).
 *
 * @param dir  the project directory (for the diagnostic prefix)
 * @param fe   the assembled front-end product (checked program + manifest floors)
 * @return     0 when every floor holds, else 1 with the first unmet floor reported to stderr
 * @throws     the first unmet floor's message when any of functions/lines/branches is below its floor
 */
fn coverage_gate_result(dir: str, fe: Frontend) -> i32 {
    let misses = coverage_floor_misses(fe)
    if coverage_floor_blocks(misses, true) { return fail(dir, misses[0]) }
    0
}

/**
 * Print every unmet coverage floor as a NON-BLOCKING warning to stderr (the default path when
 * `--cov-validation` is absent — owner ruling 0.3.0.29). Each message is prefixed `teko: warning:`
 * and the build/gate proceeds regardless; only `--cov-validation` turns these into a failure.
 *
 * @param misses  the unmet-floor messages (from `coverage_floor_misses`); empty prints nothing
 */
fn warn_coverage_floors(misses: []str) {
    mut i: u64 = 0
    loop {
        if i >= misses.len { break }
        teko::io::eprintln(teko::str::concat("teko: warning: ", misses[i]))
        i = i + 1
    }
}

/**
 * Apply the D4 coverage-floor policy under the `--cov-validation` opt-in (owner ruling 0.3.0.29:
 * the floors are a NON-BLOCKING warning by default; enforcement is opt-in). With `cov_validation`
 * true an unmet floor FAILS the gate (`coverage_gate_result`, the historic behavior); with it false
 * an unmet floor only WARNS (`warn_coverage_floors`) and the gate passes. The tests-pass gate itself
 * is unaffected — only this coverage-FLOOR enforcement is made opt-in.
 *
 * @param dir             the project directory (for the diagnostic prefix)
 * @param fe              the assembled front-end product (checked program + manifest floors)
 * @param cov_validation  `--cov-validation` — enforce (fail) rather than warn on an unmet floor
 * @return                0 unless `cov_validation` is set AND a floor is unmet, in which case 1
 * @throws                under `cov_validation`, the first unmet floor's message
 */
fn enforce_coverage_floors(dir: str, fe: Frontend, cov_validation: bool) -> i32 {
    if cov_validation { return coverage_gate_result(dir, fe) }
    warn_coverage_floors(coverage_floor_misses(fe))
    0
}

/** report_native_coverage — print the three engine-independent coverage metrics (function/line/branch)
 *  the native gate populated (#265 Track A). Uses the exported percentage wrappers
 *  (coverage::*_coverage_pct). */
fn report_native_coverage(prog: checker::TProgram) {
    let fcov = coverage::coverage_pct(prog)
    let lcov = coverage::line_coverage_pct(prog)
    let bcov = coverage::branch_coverage_pct(prog)
    teko::io::println($"teko: coverage {fcov}% functions")
    teko::io::println($"teko: coverage {lcov}% lines")
    teko::io::println($"teko: coverage {bcov}% branches")
}

/** run_native_gate — (#265, lever D of #249) the D4 test gate run NATIVELY: emit a test-profile C
 *  translation unit whose `main()` calls each `#test` in order, compile it with `run_cc` at opt 0
 *  (the gate binary is a throwaway — kept fast to PRODUCE regardless of the release build's opt level),
 *  run the resulting binary (a failed assert panics → non-zero exit, fail-fast M.1),
 *  and — cov ALWAYS on for the gate, to feed the floors — merge the child's dumped `.tkcov` into
 *  this process's coverage sinks. Under TestCov each PRODUCTION fn body carries `tk_cov_line_at`/
 *  `tk_cov_branch_at` interior marks (#265 Track A), so the merged sinks populate ALL THREE metrics —
 *  the engine-independent static walk (coverage::*_coverage_pct) reads them exactly as it read the
 *  VM's in-process marks. Replaces the 15.6 s VM interpret of the test bodies with a sub-second native run.
 *  BUILD-OUTPUT OBSERVABILITY: the gate's emit and cc steps used to be the silent gap between the
 *  front-end and the test run; both now report as visible phases (`emit test` for the first silent step,
 *  `cc test` for the slow one). The gate always reports — `tty` only selects the rendering (Tty on a
 *  terminal, Plain on a CI/log), never silence.
 *  CROSS (0.3.1 C5): when the resolved target is not this host's, the gate TU is still emitted and
 *  linked (proving the cross link line works) but the RUN — and with it the coverage merge — is
 *  honestly skipped with the emitted-not-run line. Before this, a cross `teko build` died at the gate
 *  on an exec failure of a foreign-format binary; a fabricated pass is not the alternative, an honest
 *  "not executed" is. */
fn run_native_gate(dir: str, out_dir: str, prog: checker::TProgram, m: Manifest, tty: bool) -> i32 {
    let mode = report_mode(false, tty)
    let od = if out_dir.len > 0 && out_dir[out_dir.len - 1] == b'/' { teko::str::slice_to(out_dir, out_dir.len - 1) } else { out_dir }
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let stem = teko::str::concat(m.name, "-tktest")
    let cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    let binp = teko::str::concat(od, "/", stem)
    let covfile = teko::str::concat(od, "/", teko::str::concat(stem, ".tkcov"))
    let emit_phase = phase_begin("emit test", cfile, mode)
    let emitted = match codegen::tk_emit_c_test(prog, true) {
        str as s => s
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return fail(dir, e.message) }
    }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    match teko::io::write_file(cfile, csrc) {
        error as e => { phase_end_fail(emit_phase, cfile, e.message); return fail(dir, e.message) }
        null => { }
    }
    phase_end_ok(emit_phase, teko::str::concat(cfile, teko::str::concat(" ", size_text(csrc.len))))
    let cc_phase = phase_begin("cc test", binp, mode)
    if run_cc(cfile, binp, m, prog, 0) != 0 {
        phase_end_fail(cc_phase, binp, "cc failed to build the native test gate")
        return fail(dir, "cc failed to build the native test gate")
    }
    phase_end_ok(cc_phase, binp)
    let cross = resolved_cross_note()
    if cross.is_cross { teko::io::println(cross.note); return 0 }
    match teko::env::set_var("TEKO_TKCOV", covfile) { error => { }; null => { } }
    mut argv: []str = teko::list::push(teko::list::empty(), binp)
    let trc = teko::process::run(argv)
    if trc != 0 { return trc }
    coverage::cov_merge(covfile)
    0
}

/** The `--coverage` output path ("<out_dir>/cobertura.xml", creating `out_dir` first) when
 *  `gen_cov` is set, else "" (an empty path means "don't write" to the caller). */
fn cobertura_path_of(out_dir: str, gen_cov: bool) -> str {
    if !gen_cov { return "" }
    teko::fs::mkdir(out_dir)
    teko::str::concat(out_dir, "/cobertura.xml")
}

/** (#151) The RELEASE program build, WITHOUT re-loading the front: derive the production
 *  parse from the gate's ALREADY-PARSED tree (`filter_tkt(pf.parsed)` — item-for-item
 *  identical to a fresh no-tests parse, see `filter_tkt`), run check+monomorph over it as
 *  REPORTED work (the `checker`/`monomorph` phases print for real — this is legitimate,
 *  distinct production-only work, not a silent retry; only the banner, printed once by
 *  `frontend_parse`, is not repeated), strip any surviving `#test` functions by provenance,
 *  and hand the clean program to the backend at optimization level `opt`. `backend` is the
 *  resolved backend (`TEKO_BACKEND`-selected), stamped onto the manifest before codegen (D1/#390). */
fn release_build_of(dir: str, out_dir: str, opt: i32, tty: bool, start: i64, backend: Backend, pf: ParsedFront) -> i32 {
    let pf_prod = ParsedFront { parsed = filter_tkt(pf.parsed); manifest = pf.manifest; diags = pf.diags }
    let rel = match frontend_check(pf_prod, false, tty) { Frontend as f => f; error as e => return fail(dir, e.message) }
    codegen_and_report(dir, out_dir, strip_tests(rel.prog), with_backend(rel.manifest, backend), opt, tty, start)
}

/** run_gate_native — the D4 test-gate body run NATIVELY (the DEFAULT since #168): run every `#test`
 *  compiled-native (run_native_gate, fail-fast), then enforce ALL THREE coverage floors
 *  (function/line/branch) via coverage_gate_result — the SAME floor fn the VM lane uses. Track A's
 *  per-fn line/branch instrumentation (tk_cov_line_at/tk_cov_branch_at) makes the native run populate
 *  the line and branch sinks too, so coverage_gate_result works VERBATIM on the merged native sinks.
 *  Because run_native_gate runs the compiled tests in a CHILD process, this compiler's own peak stays
 *  codegen-only (~366 MB) instead of the retired VM gate's in-process functional-env balloon (~1.5 GB)
 *  — the #168 memory-debt fix. Since #524 (VM retirement) this is the SOLE gate engine.
 *
 *  @param dir      the project directory (for diagnostics)
 *  @param out_dir  the build output directory (the test TU + binary + .tkcov land under it)
 *  @param gen_cov  write a Cobertura report (`--coverage`) from the merged native sinks
 *  @param fe       the already-assembled front-end product (checked program + manifest)
 *  @param pf       the gate's PARSED tree (release derives from it via `filter_tkt` —
 *                  no re-parse)
 *  @param opt      the cc optimization level for the RELEASE rebuild (the gate binary stays opt 0)
 *  @param tty      render the release rebuild's backend phases' in-place `\r` updates
 *  @param start    when the build began (the closing `built <path> <elapsed>` line's baseline)
 *  @param backend  the resolved code-generation backend (`TEKO_BACKEND=native`, default `Backend::C`)
 *  @param cov_validation  `--cov-validation` — enforce (fail) the coverage floors instead of warning
 *  @return         0 when every test passes, the floor policy is satisfied, and the release build succeeds
 *  @since #265 */
fn run_gate_native(dir: str, out_dir: str, gen_cov: bool, fe: Frontend, pf: ParsedFront, opt: i32, tty: bool, start: i64, backend: Backend, cov_validation: bool) -> i32 {
    let trc = run_native_gate(dir, out_dir, fe.prog, fe.manifest, tty)
    if trc != 0 { return trc }
    report_native_coverage(fe.prog)
    let gate_rc = enforce_coverage_floors(dir, fe, cov_validation)
    if gate_rc != 0 { return gate_rc }
    if gen_cov {
        let xml = coverage::cov_cobertura(fe.prog)
        let cov_path = cobertura_path_of(out_dir, gen_cov)
        match teko::io::write_file(cov_path, xml) { error => { }; null => { } }
        teko::io::println(teko::str::concat("teko: wrote coverage report ", cov_path))
    }
    release_build_of(dir, out_dir, opt, tty, start, backend, pf)
}

/**
 * run_gate — the D4 test-gate body: run every `#test` NATIVELY (#265, the sole engine after
 * VM retirement), then enforce the three coverage floors and rebuild the release program.
 *
 * @param dir      the project directory (diagnostics)
 * @param out_dir  the output directory (default "bin")
 * @param gen_cov  `--coverage` — write the Cobertura report
 * @param fe       the front-end result assembled WITH the `.tkt` tests
 * @param pf       the gate's parsed tree (the release program derives from it, no re-parse)
 * @param opt      the cc optimization level for the release rebuild (0 = default, 2 = release seed)
 * @param tty      render the release rebuild's backend phases' in-place `\r` updates
 * @param start    when the build began (the closing `built <path> <elapsed>` line's baseline)
 * @param backend  the resolved code-generation backend (`TEKO_BACKEND=native`, default `Backend::C`)
 * @param cov_validation  `--cov-validation` — enforce (fail) the coverage floors instead of warning
 * @return         0 when the gate passes and the release build succeeds, else the failing status
 */
fn run_gate(dir: str, out_dir: str, gen_cov: bool, fe: Frontend, pf: ParsedFront, opt: i32, tty: bool, start: i64, backend: Backend, cov_validation: bool) -> i32 {
    run_gate_native(dir, out_dir, gen_cov, fe, pf, opt, tty, start, backend, cov_validation)
}

/** No `#test` functions at all: ignore the gate, build the production program straight from the
 *  already-assembled `fe` (no test code present to strip or verify) at optimization level `opt`.
 *  `backend` is the resolved backend (`TEKO_BACKEND`-selected), stamped onto the manifest before codegen (D1/#390). */
fn build_no_tests_present(dir: str, out_dir: str, fe: Frontend, opt: i32, tty: bool, start: i64, backend: Backend) -> i32 { codegen_and_report(dir, out_dir, fe.prog, with_backend(fe.manifest, backend), opt, tty, start) }

/** compile_project_g — the build with the D4 TEST GATE (ON BY DEFAULT; `--no-test` is IGNORED for a
 *  build — a release MUST run its tests). Assemble WITH the `.tkt` tests, run them on the NATIVE gate
 *  FIRST (fail-fast — a failed assertion aborts the build before any emission), THEN codegen the
 *  production program (tests stripped, run_gate). Since #524 (VM retirement) the gate is ALWAYS native
 *  (#265, child-process tests, ~366 MB compiler peak) — the only engine. The ONLY skips are a project
 *  with NO `#test` functions (build_no_tests_present), or an explicit `no_verify=true` (issue #249
 *  lever A — `--no-verify`, build_ungated): a CI-only escape hatch for a self-host chain that has
 *  ALREADY proven the gate on an earlier generation and only needs the fixpoint (`gen1.c==gen2.c`),
 *  not a second full re-verification. `no_verify` changes NOTHING when false — the untouched default.
 *  The front is PARSED ONCE: the gate checks the tree WITH tests, and the release program later
 *  derives from the SAME parse via `filter_tkt` (`release_build_of`) — no second lex/parse pass.
 *
 *  @param dir          the project directory
 *  @param out_dir      the build output directory (`-o`, default "bin")
 *  @param gen_cov      write a Cobertura report (`--coverage`)
 *  @param no_verify    skip the gate entirely (`--no-verify`, #249 lever A)
 *  @param opt          the cc optimization level (`--release`/`--opt=<n>`; 0 = dev/CI default, 2 = release seed)
 *  @param no_tty       `--no-tty` — force the plain, non-interactive observability output even on a terminal
 *  @param backend      the resolved code-generation backend (`TEKO_BACKEND=native`, default `Backend::C`)
 *  @param cov_validation  `--cov-validation` — enforce (fail) the coverage floors instead of warning (0.3.0.29)
 *  @return             0 on a fully gated, successfully built release, else the failing status
 *  @since #265 */
fn compile_project_g(dir: str, out_dir: str, gen_cov: bool, no_verify: bool, opt: i32, no_tty: bool, backend: Backend, cov_validation: bool) -> i32 {
    ensure_rt_dir_abs()
    match teko::env::chdir(dir) { error => return fail(dir, "cannot enter project directory"); null => { } }
    let tty = output_is_tty(no_tty)
    let start = now_ns()
    if no_verify {
        return build_ungated(dir, out_dir, opt, tty, start, backend)
    }
    let pf = match frontend_parse(true, false, tty) { ParsedFront as x => x; error as e => return fail(dir, e.message) }
    match frontend_check(pf, false, tty) {
        Frontend as fe => {
            if !has_tests(fe.prog) {
                return build_no_tests_present(dir, out_dir, fe, opt, tty, start, backend)
            }
            run_gate(dir, out_dir, gen_cov, fe, pf, opt, tty, start, backend, cov_validation)
        }
        error as e => return fail(dir, e.message)
    }
}

// has_tests — does the program contain any `#test` function? (The gate runs iff this is true; a
// project with NO tests builds unconditionally — the "no .tkt → ignore tests" rule.)
fn has_tests(prog: checker::TProgram) -> bool {
    mut i = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test { return true } }
            _ => { }
        }
        i++
    }
    false
}

// CLI helpers (mirror main.c::parse_out_dir; here because main.tks is the virtual-main and holds no
// `fn`s). `-o <dir>` may appear anywhere after the subcommand: `teko . -o ./out`.

// the build OUTPUT directory from the args (`-o <dir>`), or "bin" by default.
fn out_dir_of(args: []str, start: u64) -> str {
    mut i = start
    loop {
        if i >= args.len { break }
        if args[i] == "-o" {
            if i + 1 < args.len { return args[i + 1] }
        }
        i = i + 1
    }
    "bin"
}

// does `--coverage` appear in the args? (write a Cobertura `cobertura.xml` next to the build output.)
fn coverage_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--coverage" { return true }
        i = i + 1
    }
    false
}

/** analyzer_of — does `--analyzer` appear in the args? (`teko test . --analyzer`, 0.3.0.29): after the
    gate + coverage floors, run the dev-time whole-suite stale/redundant/misleading analyzer (ONE
    compile, one run, per-test `.tkcov` dumps). Dev-time/advisory only — never wired into CI. */
fn analyzer_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--analyzer" { return true }
        i = i + 1
    }
    false
}

/**
 * arith_cast_gate_of — does `--arith-cast-gate` appear in the args? (`teko test .
 * --arith-cast-gate`, D4/C5 — `cast-width-hygiene-0.3.1.md` §5): after the gate + floors,
 * compute the ARITH-CAST-RATE (D4) over the already-typed program and FAIL the build when
 * it exceeds the ratified ≤2% ceiling. CI-facing (unlike `--analyzer`, this one gates).
 *
 * @param args  the process argv
 * @return      whether `--arith-cast-gate` is present
 */
fn arith_cast_gate_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--arith-cast-gate" { return true }
        i = i + 1
    }
    false
}

/** (Issue #249 lever A) does `--no-verify` appear in the args? A `build` normally ALWAYS runs the
 *  D4 `.tkt` gate first (unchanged default); this flag skips it entirely, emitting straight to
 *  codegen. Intended for a self-host release chain that has already proven the gate on an earlier
 *  generation and only needs to re-prove the fixpoint — NOT for everyday builds (skipping the
 *  gate means the binary is unverified). */
fn no_verify_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--no-verify" { return true }
        i = i + 1
    }
    false
}

/**
 * Does `--cov-validation` appear in the args? (Owner ruling 0.3.0.29.) The D4 coverage floors are a
 * NON-BLOCKING warning by default; this flag opts INTO strict enforcement — an unmet floor then FAILS
 * the build/test gate (`enforce_coverage_floors`), the historic behavior. The tests-pass gate is
 * always mandatory and unaffected; only the coverage-FLOOR enforcement is gated behind this flag.
 *
 * @param args  the full CLI argument vector
 * @return      true iff `--cov-validation` appears anywhere in `args`
 */
fn cov_validation_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--cov-validation" { return true }
        i = i + 1
    }
    false
}

/**
 * Does `--per-test-cov` appear in the args? (Owner ruling 0.3.0.29 — the T2 lever.) A DEV-TIME
 * `teko test` flag that attributes coverage to EACH `#test` individually (`run_per_test_cov`),
 * printing a per-test functions/lines/branches report used to prove which tests are redundant or
 * subsumed. Off by default and zero-cost when absent; NOT a CI gate.
 *
 * @param args  the full CLI argument vector
 * @return      true iff `--per-test-cov` appears anywhere in `args`
 */
fn per_test_cov_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--per-test-cov" { return true }
        i = i + 1
    }
    false
}

/**
 * does `--no-tty` appear in the args? (BUILD-OUTPUT OBSERVABILITY.) FORCES the plain,
 * non-interactive phase output (no `\r` in-place updates, one settled line per phase)
 * even when stdout IS a real terminal — a manual override of `output_is_tty`'s
 * env-based auto-detection, for a dev who wants clean diagnostic output to capture
 * or paste. Overrides win: `--no-tty` present -> always plain, regardless of `CI`/`TERM`.
 *
 * @param args  the full CLI argument vector
 * @return      true iff `--no-tty` appears anywhere in `args`
 */
fn no_tty_of(args: []str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--no-tty" { return true }
        i = i + 1
    }
    false
}

/**
 * is_backend_flag — is `a` the retired `--backend` flag, in either the bare `--backend`
 * form (a two-token flag whose value follows) or the single-token `--backend=<value>`
 * form? Owner ruling 2026-07-24 removed the flag as unused surface — `TEKO_BACKEND` is
 * now the sole selection seam — so every spelling is rejected honestly (`has_backend_flag`)
 * rather than silently accepted or mistaken for the project positional.
 *
 * @param a  a single CLI argument token
 * @return   true iff `a` is `--backend` or a `--backend=...` token
 */
fn is_backend_flag(a: str) -> bool {
    if a == "--backend" { return true }
    a.len > 10 && teko::str::slice_to(a, 10) == "--backend="
}

/**
 * has_backend_flag — does the retired `--backend` flag (`is_backend_flag`) appear
 * anywhere in `args` from `start`? Consulted at CLI dispatch (`main.tks`) BEFORE
 * `project_arg_of` runs, so a stray `--backend`/`--backend=...` gets the honest,
 * TEKO_BACKEND-pointing rejection instead of being mistaken for the project
 * positional.
 *
 * @param args   the full CLI argument vector
 * @param start  the index to begin scanning from (2 for a subcommand, 1 for a bare project)
 * @return       true iff a `--backend` token appears anywhere from `start` onward
 */
fn has_backend_flag(args: []str, start: u64) -> bool {
    mut i = start
    loop {
        if i >= args.len { break }
        if is_backend_flag(args[i]) { return true }
        i = i + 1
    }
    false
}

/** project_arg_of — the FIRST non-flag positional (the project) from `start`, or "" if none (the
 *  caller reports). Skips `-o <dir>` (and its value), `--no-test` (D4; currently ignored),
 *  `--no-verify` (#249 lever A), `--cov-validation`/`--per-test-cov` (the 0.3.0.29 coverage knobs),
 *  `--per-commit-test <base>` (the 0.3.0.29 delta-coverage gate — a value flag, so its base is skipped
 *  too), `--native-gate` (#265, now an inert no-op), `--release`,
 *  `--opt=<n>` (the optimization axis), and `--no-tty` (BUILD-OUTPUT OBSERVABILITY) — every
 *  recognized build flag — so none of them is mistaken for the project. `--vm-gate` was removed
 *  outright with the VM (#524, M3), and `--backend` was removed outright too (owner ruling
 *  2026-07-24, `has_backend_flag`, rejected upstream in `main.tks` before this runs): a stray
 *  occurrence of either now falls through as an unknown positional, the honest "not a project"
 *  signal that the flag is gone.
 *
 *  Also skips `--arith-cast-gate` (D4/C5, `cast-width-hygiene-0.3.1.md` §5) — the ARITH-CAST-
 *  RATE CI gate flag, and `--allow-undef` (R5, `teko-target-crosslink-0.3.1.md` §5) — the
 *  blind-link opt-in for a shared lib the link step cannot see.
 *
 *  @param args   the full CLI argument vector
 *  @param start  the index to begin scanning from (2 for a subcommand, 1 for a bare project)
 *  @return       the first positional argument, or "" when only flags remain
 *  @since #265 */
fn project_arg_of(args: []str, start: u64) -> str {
    mut i = start
    loop {
        if i >= args.len { break }
        if args[i] == "-o" { i = i + 2 }
        else if args[i] == "--no-test" { i = i + 1 }
        else if args[i] == "--no-verify" { i = i + 1 }
        else if args[i] == "--cov-validation" { i = i + 1 }
        else if args[i] == "--per-test-cov" { i = i + 1 }
        else if args[i] == "--per-commit-test" { i = i + 2 }
        else if args[i] == "--native-gate" { i = i + 1 }
        else if args[i] == "--release" { i = i + 1 }
        else if args[i] == "--no-tty" { i = i + 1 }
        else if args[i] == "--analyzer" { i = i + 1 }
        else if args[i] == "--arith-cast-gate" { i = i + 1 }
        else if args[i] == ALLOW_UNDEF_FLAG { i = i + 1 }
        else if args[i] == REGR_TIMINGS_FLAG { i = i + 1 }
        else if opt_arg_has_prefix(args[i]) { i = i + 1 }
        else { return args[i] }
    }
    ""
}

/**
 * build_debug_binary — lower `prog` to the native `<out_dir>/<stem>` executable with the DEBUG
 * profile, the `teko run` build tail. Honours `m.backend` exactly as the release `backend` does
 * (the resolved `TEKO_BACKEND=native` selection, D1/#390): `Backend::Native` → `emit_native` (links via `link_object`, the release
 * line — the `-g` debug metadata is the C backend's contribution); else emit C, link it with the
 * debug `cc` line (`run_cc_debug` → `build_cc_argv(..., true)`), write the `.tsym` beside the
 * binary (best-effort — debug metadata for the E4 native stack trace), and print the built marker.
 * Mirrors `backend`'s binary path; the caller (`build_debug_and_report`) has already created
 * `out_dir` and its parents (`mkdir_p`).
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the debug scratch directory (`target/debug`, already created)
 * @param prog     the checked, typed program
 * @param m        the resolved manifest
 * @return         0 on a successful build, else the failing status
 */
fn build_debug_binary(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest) -> i32 {
    match validate_extern_libs_for_target(m) { error as e => return fail(dir, e.message); null => { } }
    if m.backend == Backend::Native {
        return emit_native(dir, stem, out_dir, prog, m)
    }
    let emitted = match codegen::tk_emit_c(prog) { str as s => s; error as e => return fail(dir, e.message) }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    let od = strip_trailing_slash(out_dir)
    let cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    let binp = teko::str::concat(od, "/", stem)
    match teko::io::write_file(cfile, csrc) { error as e => return fail(dir, e.message); null => { } }
    if run_cc_debug(cfile, binp, m, prog) != 0 {
        return fail(dir, "cc failed to build the generated C")
    }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, "")))
    0
}

/**
 * build_debug_and_report — the `teko run` build entry (post-VM): create `out_dir` (and any missing
 * parents — `mkdir_p`, since `target/debug` is two levels deep), build `prog` to `<out_dir>/<stem>`
 * with the DEBUG profile (`build_debug_binary`), and on success report the peak memory cost (#148).
 * Mirrors `codegen_and_report` but drives the debug link line and takes the explicit `stem`/`out_dir`
 * the run scratch dir needs.
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the debug scratch directory (`target/debug`)
 * @param prog     the checked, typed program
 * @param m        the resolved manifest
 * @return         0 on a successful build, else the failing status
 */
fn build_debug_and_report(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest) -> i32 {
    match mkdir_p(strip_trailing_slash(out_dir)) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let rc = build_debug_binary(dir, stem, out_dir, prog, m)
    if rc == 0 { report_peak() }
    rc
}

/**
 * The `teko run <dir>` entry (post-VM): build the project with the DEBUG profile and EXECUTE the
 * resulting native binary — the `cargo run` / `go run` shape. Same front-end as `teko build` but
 * WITHOUT the `.tkt` tests (a run, not a gate) and WITHOUT the D4 coverage floors: this is the fast
 * debug-iteration command. The debug profile links with `-g` (DWARF for the E4 native stack trace,
 * fed by the `.tsym` map), assertions ON, and no optimization (see build_cc_argv's `debug` seam).
 * The binary is built to a scratch dir, then run; the returned status is the PROGRAM's own exit code
 * (teko::exit(n) -> n, a panic -> non-zero) — the exact contract the retired VM `run` path had.
 * When the resolved target is NOT this host's (`resolved_cross_note`), the binary is emitted and the
 * RUN is honestly skipped with the emitted-not-run line (R3/C5): this host cannot exec a cross
 * artifact, and reporting that is the honest answer — never a fabricated run status.
 *
 * @param dir      the project directory (already the cwd; the front-end chdir'd in)
 * @param backend  the resolved code-generation backend (`TEKO_BACKEND=native`, default `Backend::C`)
 * @return         the executed program's exit code, or a non-zero build/diagnostic status
 */
fn run_project(dir: str, backend: Backend) -> i32 {
    ensure_rt_dir_abs()
    let fe = match project_frontend(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    let stem = fe.manifest.name
    let bc = build_debug_and_report(dir, stem, "target/debug", fe.prog, with_backend(fe.manifest, backend))
    if bc != 0 { return bc }
    let cross = resolved_cross_note()
    if cross.is_cross { teko::io::println(cross.note); return 0 }
    let binp = teko::str::concat("target/debug/", stem)
    let argv = teko::list::push(teko::list::empty(), binp)
    teko::process::run(argv)
}

/** TKCOV_MAGIC_LEN — the fixed 8-byte magic header (`TKCOV1\0\0`) that opens every `.tkcov` dump,
    and also the wire width of one `u64` id/count (both are 8). (0.3.0.29) */
const TKCOV_MAGIC_LEN: u64 = 8

/** TKCOV_SECTIONS — the three id sections a `.tkcov` file carries, in order: functions, branches,
    lines (see `tk_cov_dump` in teko_rt.c). (0.3.0.29) */
const TKCOV_SECTIONS: u64 = 3

/** REDUNDANT_MIN — an id must be covered by at least this many DISTINCT tests for it to count as
    "also covered elsewhere". A test is REDUNDANT when EVERY one of its ids reaches this floor (the
    test itself contributes one, so 2 means at least one OTHER test covers the id too). (0.3.0.29) */
const REDUNDANT_MIN: u64 = 2

/** Verdict — the COVERAGE-SET axis of the analyzer (`teko test . --analyzer`, 0.3.0.29). `Stale`:
    the test exercises NO production id (guards nothing — e.g. asserts only comptime-folded literals).
    `Redundant`: every id it covers is ALSO covered by another test (removing it loses no coverage).
    `Live`: it uniquely covers at least one id. This is crossed with the ASSERTION-FOLD axis to form
    the combined `Status`. */
type Verdict = enum { Stale; Redundant; Live }

/** Status — the COMBINED per-test verdict (0.3.0.29 Crumb 4), crossing the coverage-set axis with the
    assertion-fold axis, most-severe first. `Misleading`: an assertion folds to a constant AND the test
    still covers production (looks LIVE, guards nothing — the star finding coverage counting cannot
    see). `Foundational`: EVERY assertion folds to a constant (tests the fold/language foundation, e.g.
    `1+1==2`). `Dead`: no production coverage and no live assertion. `Redundant`: real assertions +
    covers production, but its coverage set ⊆ the union of the other tests. `Live`: real assertion(s)
    plus at least one uniquely-covered production id. */
type Status = enum { Misleading; Foundational; Dead; Redundant; Live }

/** TestRecord — one `#test`'s analyzer input: its display label, the DEDUPED set of production ids
    (functions ∪ branches ∪ lines) it covered (decoded from that test's isolated `.tkcov`), and its
    assertion tally (from `checker::test_assert_stats`). (0.3.0.29) */
type TestRecord = struct {
    /** the `namespace::name` (or bare `name`) label, matching the native gate's `test <label>` line. */
    label: str
    /** the deduped production ids this test covered — empty ⇒ no coverage. */
    ids: []u64
    /** the number of bool assertions (`is_true`/`is_false`) the test makes. */
    asserts_total: u64
    /** how many of those assertions have a predicate that folds to a comptime constant (dead guards). */
    asserts_folded: u64
}

/** verdict_text — the stable, greppable token for a coverage `Verdict` (`STALE`/`REDUNDANT`/`LIVE`).
    Retained for the coverage-axis unit tests; the report prints the combined `Status`. (0.3.0.29) */
fn verdict_text(v: Verdict) -> str {
    match v {
        Verdict::Stale => "STALE"
        Verdict::Redundant => "REDUNDANT"
        Verdict::Live => "LIVE"
    }
}

/** status_text — the stable, greppable token for a combined `Status`
    (`MISLEADING`/`FOUNDATIONAL`/`DEAD`/`REDUNDANT`/`LIVE`). (0.3.0.29) */
fn status_text(s: Status) -> str {
    match s {
        Status::Misleading => "MISLEADING"
        Status::Foundational => "FOUNDATIONAL"
        Status::Dead => "DEAD"
        Status::Redundant => "REDUNDANT"
        Status::Live => "LIVE"
    }
}

/**
 * combined_status — cross the coverage-set axis (`cov`) with the assertion-fold axis (`total`/`folded`)
 * into the single reported `Status`, most-severe first. A test "covers production" iff `cov` is not
 * `Stale`. MISLEADING (a dead guard while covering production) outranks FOUNDATIONAL (all guards dead)
 * outranks DEAD (no coverage, no live guard); the remaining production-covering tests with real guards
 * are REDUNDANT or LIVE by their coverage set.
 *
 * @param cov     the coverage-set verdict for this test (`classify_test`)
 * @param total   the number of bool assertions the test makes
 * @param folded  how many of those assertions fold to a comptime constant
 * @return        the combined `Status`
 * @since 0.3.0.29
 */
fn combined_status(cov: Verdict, total: u64, folded: u64) -> Status {
    let covers = cov != Verdict::Stale
    let has_folded = folded >= 1
    let all_folded = total >= 1 && folded == total
    if has_folded && covers { return Status::Misleading }
    if all_folded { return Status::Foundational }
    if !covers { return Status::Dead }
    match cov {
        Verdict::Redundant => Status::Redundant
        _ => Status::Live
    }
}

/**
 * read_u64_le — decode the little-endian `u64` at byte offset `off` in the raw `.tkcov` bytes. Any
 * byte that falls past the end of `data` reads as 0, so a truncated file decodes to a bounded value
 * instead of panicking.
 *
 * @param data  the raw `.tkcov` file bytes (a `str` used as a byte buffer)
 * @param off   the starting byte offset of the 8-byte little-endian word
 * @return      the decoded unsigned 64-bit value
 * @since 0.3.0.29
 */
fn read_u64_le(data: str, off: u64) -> u64 {
    mut v: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= TKCOV_MAGIC_LEN { break }
        let at = off + i
        if at < data.len { v = v | ((data[at] to u64) << (i * TKCOV_MAGIC_LEN)) }
        i++
    }
    v
}

/**
 * tkcov_magic_ok — does `data` open with the 8-byte `TKCOV1\0\0` magic? A missing/short/foreign file
 * fails, so `tkcov_ids` treats it as "no ids" (an absent per-test dump ⇒ STALE) rather than panicking.
 *
 * @param data  the raw `.tkcov` file bytes
 * @return      true iff the first 8 bytes are exactly `T K C O V 1 \0 \0`
 * @since 0.3.0.29
 */
fn tkcov_magic_ok(data: str) -> bool {
    if data.len < TKCOV_MAGIC_LEN { return false }
    let ascii = "TKCOV1"
    mut i: u64 = 0
    loop {
        if i >= ascii.len { break }
        if data[i] != ascii[i] { return false }
        i++
    }
    if (data[6] to u64) != 0 { return false }
    if (data[7] to u64) != 0 { return false }
    true
}

/**
 * ids_contains — is `id` already present in `ids`? (the linear membership test backing `dedup_ids`
 * and `count_of` — the id sets are small per test).
 *
 * @param ids  the id list to search
 * @param id   the id to look for
 * @return     true iff `id` appears in `ids`
 * @since 0.3.0.29
 */
fn ids_contains(ids: []u64, id: u64) -> bool {
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if ids[i] == id { return true }
        i++
    }
    false
}

/**
 * dedup_ids — the input id list with duplicates removed (first-seen order). One test may mark the
 * same id many times (a hot branch/line); the classifier counts a test ONCE per id, so each test's
 * set is deduped before it feeds the cross-test tally.
 *
 * @param ids  the raw id list (possibly with repeats)
 * @return     a list holding each distinct id exactly once
 * @since 0.3.0.29
 */
fn dedup_ids(ids: []u64) -> []u64 {
    mut out: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if !ids_contains(out, ids[i]) { out = teko::list::push(out, ids[i]) }
        i++
    }
    out
}

/**
 * tkcov_ids — decode one test's isolated `.tkcov` bytes into its DEDUPED production id set: validate
 * the magic, then read the three sections (functions, branches, lines) — each a `u64` count followed
 * by that many `u64` ids — and merge them into one deduped list (the three id-spaces are globally
 * disjoint, so a single merged set is exact). A bad magic or a section whose count runs past the
 * buffer yields whatever was decoded so far, never a panic.
 *
 * @param data  the raw `.tkcov` file bytes for one test
 * @return      the deduped set of ids the test covered (empty when the file is absent/corrupt/empty)
 * @since 0.3.0.29
 */
fn tkcov_ids(data: str) -> []u64 {
    if !tkcov_magic_ok(data) { return teko::list::empty() }
    mut acc: []u64 = teko::list::empty()
    mut off: u64 = TKCOV_MAGIC_LEN
    mut s: u64 = 0
    loop {
        if s >= TKCOV_SECTIONS { break }
        if off + TKCOV_MAGIC_LEN > data.len { break }
        let n = read_u64_le(data, off)
        off = off + TKCOV_MAGIC_LEN
        mut k: u64 = 0
        loop {
            if k >= n { break }
            if off + TKCOV_MAGIC_LEN > data.len { break }
            acc = teko::list::push(acc, read_u64_le(data, off))
            off = off + TKCOV_MAGIC_LEN
            k++
        }
        s++
    }
    dedup_ids(acc)
}

/**
 * concat_ids — append every element of `b` onto `a` (list concat over `u64`). Used to fold every
 * test's deduped ids into the one cross-test multiset `all_ids_of` builds.
 *
 * @param a  the accumulator list
 * @param b  the list whose elements are appended
 * @return   `a` followed by `b`
 * @since 0.3.0.29
 */
fn concat_ids(a: []u64, b: []u64) -> []u64 {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * all_ids_of — the cross-test MULTISET: every record's deduped ids concatenated. Because each test's
 * ids are already deduped, `count_of(all, id)` over this multiset equals the number of DISTINCT tests
 * that cover `id` — exactly the signal the REDUNDANT test needs.
 *
 * @param recs  the per-test records
 * @return      the concatenation of every record's ids
 * @since 0.3.0.29
 */
fn all_ids_of(recs: []TestRecord) -> []u64 {
    mut acc: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= recs.len { break }
        acc = concat_ids(acc, recs[i].ids)
        i++
    }
    acc
}

/**
 * count_of — how many times `id` occurs in the cross-test multiset `all_ids` — i.e. how many distinct
 * tests cover `id`.
 *
 * @param all_ids  the multiset from `all_ids_of`
 * @param id       the production id to tally
 * @return         the number of tests covering `id`
 * @since 0.3.0.29
 */
fn count_of(all_ids: []u64, id: u64) -> u64 {
    mut c: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= all_ids.len { break }
        if all_ids[i] == id { c = c + 1 }
        i++
    }
    c
}

/**
 * classify_test — the analyzer verdict for one test given the cross-test multiset. STALE when it
 * covers no id at all; LIVE when it uniquely covers at least one id (some id has fewer than
 * `REDUNDANT_MIN` covering tests); REDUNDANT when every id it covers is also covered elsewhere.
 *
 * @param ids      this test's deduped id set
 * @param all_ids  the cross-test multiset (`all_ids_of`)
 * @return         `Verdict::Stale`, `Verdict::Live`, or `Verdict::Redundant`
 * @since 0.3.0.29
 */
fn classify_test(ids: []u64, all_ids: []u64) -> Verdict {
    if ids.len == 0 { return Verdict::Stale }
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if count_of(all_ids, ids[i]) < REDUNDANT_MIN { return Verdict::Live }
        i++
    }
    Verdict::Redundant
}

/** analyzer_header_line — the report's first line: the advisory banner. (0.3.0.29) */
fn analyzer_header_line() -> str { "teko: test analyzer (dev-time; ADVISORY — removal is manual)" }

/** analyzer_caveat_line — the report's second line: the REDUNDANT-but-still-a-localizer caveat. A
    REDUNDANT backend golden-vector may still be the SOLE localizer of a specific bug; a human, not the
    tool, decides whether to remove it. (0.3.0.29) */
fn analyzer_caveat_line() -> str { "teko: caveat — a REDUNDANT test may still be a sole localizer (diagnostic value); a human decides" }

/** analyzer_fold_line — the report's third line: the assertion-fold caveat. MISLEADING flags a test
    whose assertion folded to a constant yet still covers production (a green test that guards nothing —
    a class pure coverage counting cannot detect); FOUNDATIONAL flags a test whose assertions all fold
    (it tests the language/fold foundation, e.g. `1+1==2`). (0.3.0.29) */
fn analyzer_fold_line() -> str { "teko: note — MISLEADING = assertion folded-to-constant yet covers production (invisible to coverage); FOUNDATIONAL = tests the foundation (e.g. 1+1)" }

/**
 * analyzer_line — one per-test report line:
 * `analyzer <label> ids=<n> asserts=<total>/<folded> status=<...>`.
 *
 * @param label   the test's `namespace::name` (or bare `name`) label
 * @param n       the number of ids the test covered
 * @param total   the number of bool assertions the test makes
 * @param folded  how many of those assertions fold to a comptime constant
 * @param s       the combined status
 * @return        the formatted, greppable line
 * @since 0.3.0.29
 */
fn analyzer_line(label: str, n: u64, total: u64, folded: u64, s: Status) -> str {
    let st = status_text(s)
    $"analyzer {label} ids={n} asserts={total}/{folded} status={st}"
}

/**
 * StatusTally — the per-status counts accumulated across the report (0.3.0.29 Crumb 4), so the summary
 * footer can be a single pure fold over the records.
 */
type StatusTally = struct {
    /** count of MISLEADING tests. */
    misleading: u64
    /** count of FOUNDATIONAL tests. */
    foundational: u64
    /** count of DEAD tests. */
    dead: u64
    /** count of REDUNDANT tests. */
    redundant: u64
    /** count of LIVE tests. */
    live: u64
}

/** tally_empty — the zero `StatusTally`. (0.3.0.29) */
fn tally_empty() -> StatusTally { StatusTally { misleading = 0; foundational = 0; dead = 0; redundant = 0; live = 0 } }

/**
 * tally_add — increment the count for `s` in `t`.
 *
 * @param t  the running tally
 * @param s  the status to increment
 * @return   `t` with `s`'s count raised by one
 * @since 0.3.0.29
 */
fn tally_add(t: StatusTally, s: Status) -> StatusTally {
    match s {
        Status::Misleading => StatusTally { misleading = t.misleading + 1; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Foundational => StatusTally { misleading = t.misleading; foundational = t.foundational + 1; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Dead => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead + 1; redundant = t.redundant; live = t.live }
        Status::Redundant => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant + 1; live = t.live }
        Status::Live => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live + 1 }
    }
}

/**
 * analyzer_summary_line — the report footer: the per-status counts and their total.
 *
 * @param t  the accumulated status tally
 * @return   the formatted summary line
 * @since 0.3.0.29
 */
fn analyzer_summary_line(t: StatusTally) -> str {
    let total = t.misleading + t.foundational + t.dead + t.redundant + t.live
    $"analyzer: {t.misleading} MISLEADING, {t.foundational} FOUNDATIONAL, {t.dead} DEAD, {t.redundant} REDUNDANT, {t.live} LIVE (total {total})"
}

/**
 * analyzer_report — the WHOLE analyzer report as one string: the three-line header, one
 * `analyzer_line` per record (the coverage-set axis crossed with the assertion-fold axis into a
 * combined `Status`), then the summary footer. Pure — the driver builds `recs` from the decoded
 * `.tkcov` files plus `checker::test_assert_stats` and hands them here.
 *
 * @param recs  the per-test records (label + deduped ids + assertion tally)
 * @return      the complete, newline-terminated report text
 * @since 0.3.0.29
 */
fn analyzer_report(recs: []TestRecord) -> str {
    let all = all_ids_of(recs)
    mut out = teko::str::concat(analyzer_header_line(), "\n", analyzer_caveat_line(), "\n", analyzer_fold_line(), "\n")
    mut tally = tally_empty()
    mut i: u64 = 0
    loop {
        if i >= recs.len { break }
        let r = recs[i]
        let cov = classify_test(r.ids, all)
        let s = combined_status(cov, r.asserts_total, r.asserts_folded)
        out = teko::str::concat(out, analyzer_line(r.label, r.ids.len, r.asserts_total, r.asserts_folded, s), "\n")
        tally = tally_add(tally, s)
        i++
    }
    teko::str::concat(out, analyzer_summary_line(tally), "\n")
}

/**
 * analyze_records_of — read every `#test`'s isolated `.tkcov` under `adir` and decode it into a
 * `TestRecord`. The dump file is named by the test's `prog.items` index (the id the analyze harness
 * baked into its path), so the order here matches the harness's run order. A missing/corrupt file
 * decodes (via `tkcov_ids`) to an empty id set ⇒ STALE, so a test that never dumped is still reported.
 *
 * @param prog  the checked program whose `#test` items were run
 * @param adir  the scratch directory the analyze binary wrote `<idx>.tkcov` files into
 * @return      one `TestRecord` per `#test`, in `prog.items` order
 * @since 0.3.0.29
 */
fn analyze_records_of(prog: checker::TProgram, adir: str) -> []TestRecord {
    mut recs: []TestRecord = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        match prog.items[i] {
            checker::TFunction as f => {
                if f.is_test {
                    let path = $"{adir}/{i}.tkcov"
                    let data = match teko::io::read_file(path) { str as s => s; error => "" }
                    let stats = checker::test_assert_stats(f)
                    recs = teko::list::push(recs, TestRecord { label = test_label(f); ids = tkcov_ids(data); asserts_total = stats.total; asserts_folded = stats.folded })
                }
            }
            _ => { }
        }
        i++
    }
    recs
}

/**
 * run_analyzer — the `teko test . --analyzer` body (0.3.0.29): compile the ANALYZE-mode test gate
 * ONCE, run it ONCE (each `#test` writes its own `<idx>.tkcov` under the scratch dir), then decode
 * every per-test id set and print the stale/redundant/live report. One compile + one run answers the
 * whole-suite question — no per-test recompile. Dev-time only, advisory: it prints and returns 0
 * (a passing gate already ran first); it never fails the build on a verdict.
 *
 * @param dir  the project directory (diagnostics)
 * @param fe   the already-assembled front-end product (checked program + manifest)
 * @return     0 on success, else the failing status (emit/cc/run error)
 * @since 0.3.0.29
 */
fn run_analyzer(dir: str, fe: Frontend) -> i32 {
    let od = strip_trailing_slash("bin")
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the analyzer output directory"); null => { } }
    let stem = teko::str::concat(fe.manifest.name, "-tkanalyze")
    let cfile = teko::str::concat(od, "/", stem, ".c")
    let binp = teko::str::concat(od, "/", stem)
    let emitted = match codegen::tk_emit_c_test_analyze(fe.prog) { str as s => s; error as e => return fail(dir, e.message) }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(fe.manifest.name, fe.manifest.version, fe.manifest.suffix, fe.manifest.description))
    match teko::io::write_file(cfile, csrc) { error as e => return fail(dir, e.message); null => { } }
    if run_cc(cfile, binp, fe.manifest, fe.prog, 0) != 0 { return fail(dir, "cc failed to build the analyzer test gate") }
    let adir = teko::str::concat(od, "/analyze")
    match teko::fs::mkdir(adir) { error => return fail(dir, "cannot create the analyzer scratch directory"); null => { } }
    match teko::env::set_var("TEKO_ANALYZE_DIR", adir) { error => { }; null => { } }
    let arc = teko::process::run(teko::list::push(teko::list::empty(), binp))
    if arc != 0 { return arc }
    teko::io::print(analyzer_report(analyze_records_of(fe.prog, adir)))
    0
}

/**
 * arith_cast_rate_line — the printed report line: `arith-cast-rate: <with>/<total> (<pct>%),
 * ceiling <=2.00%`.
 *
 * @param r  the accumulated report
 * @return   the formatted report line (no trailing newline)
 */
fn arith_cast_rate_line(r: checker::ArithCastRateReport) -> str {
    let pct = checker::arith_cast_rate_pct(r)
    let ceiling = checker::ARITH_CAST_RATE_CEILING
    $"teko: arith-cast-rate: {r.with_conversion}/{r.total} ({pct:F2}%), ceiling <={ceiling:F2}%"
}

/**
 * run_arith_cast_gate — the `teko test . --arith-cast-gate` body (D4/C5,
 * `cast-width-hygiene-0.3.1.md` §5): compute the ARITH-CAST-RATE over the ALREADY-TYPED
 * program (`fe.prog` — no recompile, no run needed, unlike `--analyzer`) and fail the build
 * when it exceeds the ratified ≤2% ceiling. A passing `.tkt` gate already ran before this is
 * reached, so a program with zero arithmetic/assignment expressions gates vacuously green.
 *
 * @param dir  the project directory (diagnostics)
 * @param fe   the already-assembled front-end product (checked program + manifest)
 * @return     0 when the rate is at or under 2%, else 1 (the CI-facing failure)
 * @since 0.3.1 (C5)
 */
fn run_arith_cast_gate(dir: str, fe: Frontend) -> i32 {
    arith_cast_verdict(report_arith_cast_rate(fe))
}

/**
 * report_arith_cast_rate — compute the ARITH-CAST-RATE and PRINT it, with no verdict attached.
 *
 * Split out from `run_arith_cast_gate` so the number can be reported EARLY — right after the
 * front end, before the test gate — while the pass/fail verdict stays at the end of
 * `test_project`. The reason is that the two belong at different points in the run and used to
 * be welded at the wrong one:
 *
 * - the METRIC is a property of the typed SOURCE (`fe.prog`). It needs no test to have passed and
 *   no binary to have been produced. Reporting it behind the test gate meant it only ever spoke
 *   when everything else was already green — precisely when it is least needed. On a tree whose
 *   suite is red (wagon 20, `fat-pointer receiver call` / N2) it would never have printed at all,
 *   which is how a gate ships and delivers nothing.
 * - the VERDICT must NOT come first, and that is the other half of the split: failing early on a
 *   cast-rate ceiling would return before the test gate ran and hide every test failure behind a
 *   style metric. A gate that masks defects is worse than one that runs late.
 *
 * @param fe  the already-assembled front-end product (checked program + manifest)
 * @return    the accumulated report, already printed
 * @since 0.3.1 (C5); split 2026-07-27
 */
fn report_arith_cast_rate(fe: Frontend) -> checker::ArithCastRateReport {
    let r = checker::arith_cast_rate_report(fe.prog)
    teko::io::println(arith_cast_rate_line(r))
    r
}

/**
 * arith_cast_verdict — the D4 pass/fail on an ALREADY-COMPUTED report (nothing is re-walked and
 * nothing is re-printed; `report_arith_cast_rate` did both).
 *
 * @param r  the report computed earlier in the run
 * @return   0 when the rate is at or under the ceiling, else 1 (the CI-facing failure)
 * @since 0.3.1 (C5); split 2026-07-27
 */
fn arith_cast_verdict(r: checker::ArithCastRateReport) -> i32 {
    if checker::arith_cast_rate_gate_ok(r) { return 0 }
    let ceiling = checker::ARITH_CAST_RATE_CEILING
    teko::io::eprintln($"teko: arith-cast-rate gate FAILED — the D4 ceiling (<={ceiling:F2}%) was exceeded")
    1
}

/**
 * One test's coverage attribution: the label of the `#test` and the percentage of the WHOLE
 * production surface (functions / lines / branches) that this single test exercised on its own.
 * Emitted one row per test by `--per-test-cov` (owner ruling 0.3.0.29 — the T2 lever): a dev-time
 * tool to prove which tests are redundant or subsumed by another.
 */
type PerTestCoverage = struct {
    /**
     * The test's label — `namespace::name`, or the bare `name` when the test has no namespace.
     */
    label: str
    /**
     * The percentage of production functions this test alone executed (against the whole surface).
     */
    functions: u64
    /**
     * The percentage of production executable lines this test alone hit (against the whole surface).
     */
    lines: u64
    /**
     * The percentage of production branch outcomes this test alone took (against the whole surface).
     */
    branches: u64
}

/**
 * The label of a `#test` function — `namespace::name`, or the bare `name` when it has no namespace.
 * Matches the label the native gate prints for the test (`emit_test_call`), so a per-test row is
 * traceable to its `test <label> ... ok` line.
 *
 * @param f  the `#test` function
 * @return   the human label used in the per-test report
 */
fn test_label(f: checker::TFunction) -> str {
    if f.namespace.len != 0 { teko::str::concat(f.namespace, "::", f.name) } else { f.name }
}

/**
 * Format ONE per-test attribution row as a single stable, machine-parseable line (no trailing
 * newline). The shape is `per-test-cov <label> functions=<f>% lines=<l>% branches=<b>%` — the
 * fields the T2 investigation greps to rank tests by marginal coverage.
 *
 * @param r  the per-test coverage row
 * @return   the formatted line (no trailing newline)
 */
fn per_test_cov_row_str(r: PerTestCoverage) -> str {
    $"per-test-cov {r.label} functions={r.functions}% lines={r.lines}% branches={r.branches}%"
}

/**
 * Format the full per-test attribution report: a fixed header line followed by one
 * `per_test_cov_row_str` line per test, each newline-terminated. The header is
 * `teko: per-test coverage attribution`; an empty `rows` yields the header alone.
 *
 * @param rows  the per-test coverage rows, in test order
 * @return      the complete report text (header + one line per row), newline-terminated throughout
 */
fn per_test_cov_report_str(rows: []PerTestCoverage) -> str {
    mut out = teko::str::concat("teko: per-test coverage attribution", "\n")
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        out = teko::str::concat(out, per_test_cov_row_str(rows[i]), "\n")
        i = i + 1
    }
    out
}

/**
 * The program reduced to its production items plus EXACTLY ONE `#test` (the one at `keep_idx`): every
 * non-test item is kept in order, every OTHER `#test` is dropped. Emitting + measuring this program
 * attributes the run's coverage to that single test. The kept test's own body is excluded from the
 * production coverage surface exactly as `line_coverage`/`branch_coverage` already exclude `#test`
 * functions, so the reported percentages measure only PRODUCTION code the test reached.
 *
 * @param prog      the full checked program (production items + every `#test`)
 * @param keep_idx  the `prog.items` index of the single `#test` to retain
 * @return          the program with only production items and the one kept test
 */
fn keep_single_test(prog: checker::TProgram, keep_idx: u64) -> checker::TProgram {
    mut kept: []checker::TItem = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        mut drop = false
        match prog.items[i] {
            checker::TFunction as f => { if f.is_test && i != keep_idx { drop = true } }
            _ => { }
        }
        if !drop { kept = teko::list::push(kept, prog.items[i]) }
        i = i + 1
    }
    checker::TProgram { items = kept }
}

/**
 * Emit, compile and RUN the coverage-instrumented test binary for `filtered` (a single-test program
 * from `keep_single_test`), then attribute its coverage to THIS process's sinks: reset the three
 * sinks, then merge the child's dumped `.tkcov`. On return the in-process coverage sinks hold ONLY
 * this test's marks, so `coverage::*_pct(filtered)` reads its per-test attribution. Reuses the same
 * native-gate machinery (`codegen::tk_emit_c_test` + `run_cc` + `teko::process::run` + `cov_merge`)
 * as the aggregate gate; the only difference is the single-test program and the pre-merge reset.
 *
 * @param dir       the project directory (for diagnostics)
 * @param out_dir   the scratch output directory (the per-test TU + binary + `.tkcov` land here)
 * @param filtered  the single-test program to instrument (production items + one `#test`)
 * @param m         the resolved manifest (name/version drive the emitted metadata)
 * @param stem      the output artifact stem (shared across tests — each run overwrites the scratch)
 * @return          0 on success (sinks now hold this test's coverage), else the failing status
 * @throws          when the scratch dir/emit/cc fails, or the child test process exits non-zero
 */
fn run_one_test_cov(dir: str, out_dir: str, filtered: checker::TProgram, m: Manifest, stem: str) -> i32 {
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let cfile = teko::str::concat(od, "/", stem, ".c")
    let binp = teko::str::concat(od, "/", stem)
    let covfile = teko::str::concat(od, "/", stem, ".tkcov")
    let emitted = match codegen::tk_emit_c_test(filtered, true) { str as s => s; error as e => return fail(dir, e.message) }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    match teko::io::write_file(cfile, csrc) { error as e => return fail(dir, e.message); null => { } }
    if run_cc(cfile, binp, m, filtered, 0) != 0 { return fail(dir, "cc failed to build the per-test coverage gate") }
    match teko::env::set_var("TEKO_TKCOV", covfile) { error => { }; null => { } }
    let argv = teko::list::push(teko::list::empty(), binp)
    let trc = teko::process::run(argv)
    if trc != 0 { return trc }
    teko::cov_reset()
    teko::cov_branch_reset()
    teko::cov_line_reset()
    coverage::cov_merge(covfile)
    0
}

/**
 * run_per_test_cov — the `teko test --per-test-cov` body (owner ruling 0.3.0.29 — the T2 lever). For
 * EACH `#test` in `fe.prog`, build the single-test program (`keep_single_test`), run it under coverage
 * in isolation (`run_one_test_cov` — reset sinks then merge only that test), read the three attributed
 * percentages off the now-isolated sinks, and collect a `PerTestCoverage` row. Finally print the full
 * report (`per_test_cov_report_str`). DEV-TIME only: it recompiles one test binary per test, so it is
 * deliberately opt-in and never runs in the default gate. It also leaves the in-process sinks holding
 * the LAST test's marks (harmless — it runs after the aggregate floor policy, at the end of the run).
 *
 * @param dir  the project directory (for diagnostics)
 * @param fe   the assembled front-end product (checked program WITH the `.tkt` tests + manifest)
 * @return     0 when every per-test run succeeds and the report prints, else the failing status
 */
fn run_per_test_cov(dir: str, fe: Frontend) -> i32 {
    mut rows: []PerTestCoverage = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= fe.prog.items.len { break }
        match fe.prog.items[i] {
            checker::TFunction as f => {
                if f.is_test {
                    let filtered = keep_single_test(fe.prog, i)
                    let rc = run_one_test_cov(dir, "bin", filtered, fe.manifest, teko::str::concat(fe.manifest.name, "-pertest"))
                    if rc != 0 { return rc }
                    rows = teko::list::push(rows, PerTestCoverage { label = test_label(f); functions = coverage::coverage_pct(filtered); lines = coverage::line_coverage_pct(filtered); branches = coverage::branch_coverage_pct(filtered) })
                }
            }
            _ => { }
        }
        i = i + 1
    }
    teko::io::print(per_test_cov_report_str(rows))
    0
}

/**
 * The changed lines of ONE source file since a git base — the file path (as git reports it,
 * repo-relative) plus the new-side line numbers that the diff ADDED or replaced. The unit the
 * per-commit delta gate attributes coverage to (owner ruling 0.3.0.29: "código vivo prova a si
 * mesmo; congelado sai da conta" — only the lines a commit touched count toward its delta).
 */
type ChangedFile = struct {
    /**
     * The changed file's path exactly as `git diff` reports it (repo-relative, `b/`-prefix stripped).
     */
    path: str
    /**
     * The new-side (post-change) 1-based source line numbers this diff added or replaced, in order.
     */
    lines: []u32
}

/**
 * The whole set of source lines changed since a git base — one `ChangedFile` per touched `.tks`
 * file. Produced by `changed_line_set` from a `git diff <base>...HEAD` and consulted by
 * `changed_contains` when attributing coverage to only the changed lines (the delta metric).
 */
type ChangedLines = struct {
    /**
     * The changed `.tks` files, each with its added/replaced new-side line numbers.
     */
    files: []ChangedFile
}

/**
 * One executable production line as the coverage report saw it: its source file, its 1-based line
 * number, and whether the run hit it. Parsed out of the Cobertura report (`cov_lines_from_cobertura`)
 * so the delta attribution reuses the SAME executable-line surface and hit marks the coverage floors
 * read — the delta is a projection of the aggregate coverage onto the changed lines.
 */
type CovLine = struct {
    /**
     * The source file the line belongs to (the Cobertura `<class filename=…>` of its function).
     */
    file: str
    /**
     * The 1-based source line number.
     */
    line: u32
    /**
     * Whether the aggregate run executed this line at least once (Cobertura `hits` &gt; 0).
     */
    hit: bool
}

/**
 * A delta-coverage count — covered / total over the CHANGED executable lines only. `delta_pct`
 * rounds down; an empty denominator (nothing executable changed) is vacuously 100% — a commit that
 * touched no measurable code has nothing to prove, so the gate never blocks it.
 */
type DeltaCoverage = struct {
    /**
     * The number of changed executable lines the run covered (numerator).
     */
    cov: u64
    /**
     * The total number of changed executable lines (denominator).
     */
    val: u64
}

/**
 * The value of the `--per-commit-test <base>` flag — the git ref/sha to diff against — or "" when
 * the flag is absent (the no-op default: `teko test` behaves exactly as before, zero added cost).
 * A DEV+CI knob (owner ruling 0.3.0.29 — the delta-coverage enforcer): with `--cov-validation` also
 * present a below-floor delta FAILS the gate, otherwise it only warns (consistent with #19's
 * default-non-blocking floor policy).
 *
 * @param args  the full CLI argument vector
 * @return      the git base immediately following `--per-commit-test`, or "" when the flag is absent
 */
fn per_commit_base_of(args: []str) -> str {
    mut i: u64 = 0
    loop {
        if i >= args.len { break }
        if args[i] == "--per-commit-test" {
            if i + 1 < args.len { return args[i + 1] }
            return ""
        }
        i = i + 1
    }
    ""
}

/**
 * Does `s` begin with the byte sequence `p`? A local byte-level prefix test (there is no
 * `teko::str::starts_with` builtin — only `ends_with`/`contains`), used throughout the unified-diff
 * parser to classify each diff line by its leading marker.
 *
 * @param s  the string to test
 * @param p  the required prefix
 * @return   true iff `s` starts with `p`
 */
fn bp_prefix(s: str, p: str) -> bool {
    if s.len < p.len { return false }
    mut i: u64 = 0
    loop {
        if i >= p.len { break }
        if s[i] != p[i] { return false }
        i = i + 1
    }
    true
}

/**
 * Split `text` into lines on the `\n` byte, dropping the terminators; a trailing non-newline segment
 * is its own line and a trailing newline yields no empty final line. Kept local (rather than reaching
 * for `teko::iter::split_lines`) so the diff/Cobertura parsers stay self-contained within the build
 * namespace and directly unit-testable.
 *
 * @param text  the text to break into lines
 * @return      the lines in order, without their line terminators
 */
fn bp_lines(text: str) -> []str {
    mut out: []str = teko::list::empty()
    mut start: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= text.len { break }
        if text[i] == b'\n' {
            out = teko::list::push(out, teko::str::slice(text, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < text.len { out = teko::list::push(out, teko::str::slice_from(text, start)) }
    out
}

/**
 * The first index of `needle` in `s`, or -1 when absent — a forward substring search (the only
 * builtin, `last_index_of`, searches from the END). Backs the Cobertura attribute extractor.
 *
 * @param s       the haystack
 * @param needle  the substring to locate (an empty needle matches at 0)
 * @return        the 0-based index of the first occurrence, or -1 when `needle` does not occur
 */
fn bp_find(s: str, needle: str) -> i64 {
    if needle.len == 0 { return 0 }
    if s.len < needle.len { return -1 }
    mut i: u64 = 0
    let last = s.len - needle.len
    loop {
        if i > last { break }
        if bp_prefix(teko::str::slice_from(s, i), needle) { return i to i64 }
        i = i + 1
    }
    -1
}

/**
 * The leading run of decimal digits of `s` as a u64 (0 when `s` does not start with a digit). Parses
 * the small integers the diff hunk header and Cobertura attributes carry.
 *
 * @param s  the string whose leading digit run is read
 * @return   the parsed non-negative integer, or 0 when there is no leading digit
 */
fn bp_parse_uint(s: str) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= s.len { break }
        let c = s[i]
        if c < b'0' || c > b'9' { break }
        n = n * 10 + (c to u64) - (b'0' to u64)
        i = i + 1
    }
    n
}

/**
 * The new-side (post-change) start line of a unified-diff hunk header `@@ -a,b +c,d @@`: the integer
 * immediately after the `+` (the `c`). 0 when the line carries no `+` group (never a valid header).
 *
 * @param line  the `@@ … @@` hunk header line
 * @return      the new-side start line `c`, or 0 when the header is malformed
 */
fn bp_hunk_newstart(line: str) -> u32 {
    mut i: u64 = 0
    loop {
        if i >= line.len { break }
        if line[i] == b'+' { return bp_parse_uint(teko::str::slice_from(line, i + 1)) to u32 }
        i = i + 1
    }
    0
}

/**
 * The changed file's path from a unified-diff `+++ ` header line: the text after `+++ `, with a
 * leading `b/` stripped. A `+++ /dev/null` (a pure deletion) yields "" so it registers no file.
 *
 * @param line  the `+++ …` header line
 * @return      the repo-relative path, or "" for `/dev/null`
 */
fn bp_plusfile(line: str) -> str {
    let rest = teko::str::slice_from(line, 4)
    if rest == "/dev/null" { return "" }
    if bp_prefix(rest, "b/") { return teko::str::slice_from(rest, 2) }
    rest
}

/**
 * Append a completed file's changed lines to the accumulator, but ONLY when it is a non-empty `.tks`
 * file — a file with no added lines (pure deletion) or a non-Teko path contributes no delta unit, so
 * it is dropped. Flushed by `changed_line_set` each time the diff advances to the next `+++` file.
 *
 * @param files  the changed-file accumulator so far
 * @param path   the file just parsed (repo-relative)
 * @param lines  its added/replaced new-side line numbers
 * @return       `files` with the file appended when it is a non-empty `.tks`, else `files` unchanged
 */
fn cl_flush(files: []ChangedFile, path: str, lines: []u32) -> []ChangedFile {
    if lines.len == 0 { return files }
    if !teko::str::ends_with(path, ".tks") { return files }
    teko::list::push(files, ChangedFile { path = path; lines = lines })
}

/**
 * Parse a `git diff <base>...HEAD` unified diff into the set of new-side lines it changed per `.tks`
 * file. Walks the diff line by line, tracking the current `+++` file and the running new-side line
 * number seeded by each `@@` hunk header: an added line (`+`, not the `+++` header) records the
 * current new-side number and advances it; a context line (leading space) advances it; a deletion
 * (`-`, not the `---` header) and every header/metadata line leave it untouched. PURE — the git shell
 * is elsewhere (`per_commit_diff_text`) so this is directly unit-testable on a synthetic diff.
 *
 * @param diff  the unified-diff text from `git diff <base>...HEAD`
 * @return      the changed `.tks` files with their added/replaced new-side line numbers
 */
fn changed_line_set(diff: str) -> ChangedLines {
    mut files: []ChangedFile = teko::list::empty()
    mut cur_file: str = ""
    mut cur_lines: []u32 = teko::list::empty()
    mut newno: u32 = 0
    let lines = bp_lines(diff)
    mut i: u64 = 0
    loop {
        if i >= lines.len { break }
        let ln = lines[i]
        if bp_prefix(ln, "+++ ") {
            files = cl_flush(files, cur_file, cur_lines)
            cur_file = bp_plusfile(ln)
            cur_lines = teko::list::empty()
        } else if bp_prefix(ln, "@@ ") {
            newno = bp_hunk_newstart(ln)
        } else if bp_prefix(ln, "+") && !bp_prefix(ln, "+++") {
            cur_lines = teko::list::push(cur_lines, newno)
            newno = newno + 1
        } else if bp_prefix(ln, " ") {
            newno = newno + 1
        }
        i = i + 1
    }
    files = cl_flush(files, cur_file, cur_lines)
    ChangedLines { files = files }
}

/**
 * Do two source paths refer to the same file, tolerant of the repo-relative vs project-relative
 * mismatch between what `git diff` reports (repo root) and what the checker records on a function
 * (`f.file`, which may be project-relative)? True when they are equal or one is a path-suffix of the
 * other (`.../src/x.tks` matches `x.tks` only across a `/` boundary, so `ax.tks` never matches `x.tks`).
 *
 * @param a  one path
 * @param b  the other path
 * @return   true iff `a` and `b` denote the same file up to a leading-directory prefix
 */
fn path_tail_match(a: str, b: str) -> bool {
    if a == b { return true }
    if teko::str::ends_with(a, teko::str::concat("/", b)) { return true }
    if teko::str::ends_with(b, teko::str::concat("/", a)) { return true }
    false
}

/**
 * Was `(file, line)` changed since the base — i.e. is `line` in the changed-line set of a file that
 * `path_tail_match`es `file`? The membership predicate the delta attribution consults per executable
 * line. PURE and directly unit-testable against a synthetic `ChangedLines`.
 *
 * @param cls   the changed-line set from `changed_line_set`
 * @param file  the executable line's source file
 * @param line  the executable line's 1-based line number
 * @return      true iff that file+line was added/replaced since the base
 */
fn changed_contains(cls: ChangedLines, file: str, line: u32) -> bool {
    mut i: u64 = 0
    loop {
        if i >= cls.files.len { break }
        if path_tail_match(cls.files[i].path, file) {
            mut j: u64 = 0
            loop {
                if j >= cls.files[i].lines.len { break }
                if cls.files[i].lines[j] == line { return true }
                j = j + 1
            }
        }
        i = i + 1
    }
    false
}

/**
 * The value of a single-quoted attribute `key` on a Cobertura element line — the text between `key`
 * (e.g. `filename='`, `number='`, `hits='`) and the next single quote. "" when the key is absent.
 *
 * @param s    the element line
 * @param key  the attribute prefix including the opening quote (e.g. `hits='`)
 * @return     the attribute value, or "" when `key` does not occur
 */
fn xml_attr(s: str, key: str) -> str {
    let at = bp_find(s, key)
    if at < 0 { return "" }
    let start = (at to u64) + key.len
    mut j = start
    loop {
        if j >= s.len { break }
        if s[j] == b'\'' { break }
        j = j + 1
    }
    teko::str::slice(s, start, j)
}

/**
 * Parse the executable production lines (file, line, hit) out of a Cobertura report — reusing the
 * coverage subsystem's OWN exported renderer (`coverage::cov_cobertura`) as the source of truth for
 * "which lines are executable and were they hit", so the delta metric can never diverge from the
 * aggregate floors. Reads the `filename` off each `<class …>` and one `CovLine` off each body
 * `<line number=… hits=…/>`; the per-method summary `<line>` (on the `<methods>` line) is skipped so
 * a function's declaration line is not double-counted.
 *
 * @param xml  the Cobertura XML from `coverage::cov_cobertura`
 * @return     one `CovLine` per executable production line, in report order
 */
fn cov_lines_from_cobertura(xml: str) -> []CovLine {
    mut out: []CovLine = teko::list::empty()
    mut cur_file: str = ""
    let lines = bp_lines(xml)
    mut i: u64 = 0
    loop {
        if i >= lines.len { break }
        let ln = lines[i]
        if teko::str::contains(ln, "<class ") {
            cur_file = xml_attr(ln, "filename='")
        } else if teko::str::contains(ln, "<line number='") && !teko::str::contains(ln, "<methods>") {
            let num = bp_parse_uint(xml_attr(ln, "number='")) to u32
            let hits = bp_parse_uint(xml_attr(ln, "hits='"))
            out = teko::list::push(out, CovLine { file = cur_file; line = num; hit = hits > 0 })
        }
        i = i + 1
    }
    out
}

/**
 * Attribute the aggregate line coverage to ONLY the changed lines — the delta metric. Of the
 * executable production lines (`covlines`), count those that were changed since the base
 * (`changed_contains`) as the denominator and the changed-AND-hit ones as the numerator. PURE: given
 * a synthetic coverage map + changed-line set it computes the delta with no git and no sinks — the
 * function the regression exercises.
 *
 * @param covlines  every executable production line with its hit flag (from `cov_lines_from_cobertura`)
 * @param cls       the lines changed since the base (from `changed_line_set`)
 * @return          the covered/total delta over the changed executable lines
 */
fn delta_line_coverage(covlines: []CovLine, cls: ChangedLines) -> DeltaCoverage {
    mut cov: u64 = 0
    mut val: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= covlines.len { break }
        if changed_contains(cls, covlines[i].file, covlines[i].line) {
            val = val + 1
            if covlines[i].hit { cov = cov + 1 }
        }
        i = i + 1
    }
    DeltaCoverage { cov = cov; val = val }
}

/**
 * The integer percentage of a delta count, rounded down. An empty denominator (no executable line
 * changed) is vacuously 100% — a commit that touched no measurable code has nothing to prove.
 *
 * @param d  the delta count
 * @return   the delta percentage in [0, 100]
 */
fn delta_pct(d: DeltaCoverage) -> u64 { if d.val == 0 { 100 } else { d.cov * 100 / d.val } }

/**
 * The per-commit delta-coverage policy as a pure predicate, mirroring `coverage_floor_blocks`: a
 * below-floor delta BLOCKS the gate only when `--cov-validation` is opted in; otherwise it warns and
 * the gate passes (owner ruling 0.3.0.29 / #19 default-non-blocking). A delta at or above the floor
 * never blocks regardless of the flag.
 *
 * @param pct             the measured delta percentage
 * @param floor           the [coverage] lines floor the delta must meet
 * @param cov_validation  `--cov-validation` — enforcement opted in
 * @return                true iff the gate must FAIL (validation on AND the delta is below the floor)
 */
fn delta_floor_blocks(pct: u64, floor: u64, cov_validation: bool) -> bool {
    cov_validation && pct < floor
}

/**
 * The one-line per-commit delta-coverage report the CI log greps: the base ref, the delta percentage,
 * and the covered/total changed-line counts.
 *
 * @param base  the git base the delta was measured against
 * @param d     the measured delta count
 * @return      the formatted report line (no trailing newline)
 */
fn per_commit_report_str(base: str, d: DeltaCoverage) -> str {
    $"teko: per-commit delta coverage (base {base}): {delta_pct(d)}% ({d.cov}/{d.val}) of changed executable lines covered"
}

/**
 * Shell `git diff <base>...HEAD -- '*.tks'` to `out_path` (stderr silenced), returning git's exit
 * status. Uses `sh -c` because `teko::process::run` has no redirection; the three-dot form diffs
 * against the merge-base of `<base>` and `HEAD`, restricted to Teko sources. A non-zero status means
 * git is unavailable or `<base>` is not a valid ref — the caller degrades gracefully.
 *
 * @param base      the git ref/sha to diff against
 * @param out_path  the file to capture the diff into
 * @return          git's exit status (0 on success)
 */
fn run_git_diff(base: str, out_path: str) -> i32 {
    let cmd = teko::str::concat("git diff ", base, "...HEAD -- '*.tks' > ", out_path, " 2>/dev/null")
    mut argv: []str = teko::list::push(teko::list::empty(), "sh")
    argv = teko::list::push(argv, "-c")
    argv = teko::list::push(argv, cmd)
    teko::process::run(argv)
}

/**
 * The captured `git diff <base>...HEAD` text, or an error when git is unavailable / `<base>` is not a
 * valid ref (so the per-commit gate can degrade gracefully rather than crash — guardrail). Captures to
 * a scratch file next to the project root, then slurps it.
 *
 * @param base  the git ref/sha to diff against
 * @return      the unified-diff text, or an error describing the git failure
 * @throws      when the `git diff` invocation fails or the scratch file cannot be read
 */
fn per_commit_diff_text(base: str) -> str | error {
    let out_path = ".teko-per-commit.diff"
    if run_git_diff(base, out_path) != 0 {
        return error { message = teko::str::concat("git diff ", base, "...HEAD failed (git unavailable or invalid base)") }
    }
    teko::io::read_file(out_path)
}

/**
 * The `teko test --per-commit-test <base>` body (owner ruling 0.3.0.29 — the delta-coverage CI
 * enforcer). Diff `<base>...HEAD` for changed `.tks` lines (`changed_line_set`), project the just-run
 * aggregate coverage onto those lines (`cov_lines_from_cobertura` over `coverage::cov_cobertura` +
 * `delta_line_coverage`), report the delta, and apply the SAME warn-vs-fail policy as the floors: with
 * `--cov-validation` a below-floor delta FAILS (exit 1); otherwise it only warns. When git is
 * unavailable or `<base>` is invalid the gate degrades gracefully — an honest warning, exit 0, never a
 * crash. Runs AFTER the aggregate floor policy, so the coverage sinks already hold the run's marks.
 *
 * @param dir             the project directory (for the diagnostic prefix)
 * @param fe              the assembled front-end product (checked program + manifest floors)
 * @param base            the git ref/sha to measure the delta against
 * @param cov_validation  `--cov-validation` — enforce (fail) rather than warn on a below-floor delta
 * @param pre_regr_cob    the Cobertura XML snapshot taken right after the `#test` gate, BEFORE the
 *                         regression tier's `merge_regression_coverage` folds in any `.tkcov` (0.3.1
 *                         cobertura fix): the delta gate must credit only lines a `#test` actually
 *                         exercised, never a line merely REACHED by a regressive run
 * @return                0 unless `cov_validation` is set AND the delta is below the [coverage] lines floor
 * @throws                under `cov_validation`, when the delta is below the lines floor
 */
fn run_per_commit_test(dir: str, fe: Frontend, base: str, cov_validation: bool, pre_regr_cob: str) -> i32 {
    let diff = match per_commit_diff_text(base) {
        str as s => s
        error => {
            teko::io::eprintln($"teko: warning: per-commit delta coverage skipped — `git diff {base}...HEAD` unavailable")
            return 0
        }
    }
    let cls = changed_line_set(diff)
    let covlines = cov_lines_from_cobertura(pre_regr_cob)
    let d = delta_line_coverage(covlines, cls)
    teko::io::println(per_commit_report_str(base, d))
    let pct = delta_pct(d)
    let floor = fe.manifest.cov_lines
    if delta_floor_blocks(pct, floor, cov_validation) {
        return fail(dir, $"per-commit delta coverage {pct}% is below the {floor}% floor ([coverage] lines) — the lines changed since {base} are undertested")
    }
    if pct < floor {
        teko::io::eprintln($"teko: warning: per-commit delta coverage {pct}% is below the {floor}% floor ([coverage] lines) — the lines changed since {base} are undertested")
    }
    0
}

/**
 * regression_coverage_exe — the compiler binary the regression tier uses to compile its scenarios
 * (0.3.1 C-cov, `regressor-principal-0.3.1.md` §5.1 Cov-A): for the compiler's OWN project
 * (`fe.manifest.name == "teko"` — the reserved root name no other project may claim), build a
 * COVERAGE-INSTRUMENTED copy of `fe.prog` (`codegen::tk_emit_c_cov`) and return ITS path, so every
 * scenario compile marks the exact compiler-source lines it exercises — folded back via
 * `merge_regression_coverage` BEFORE the floor read. For any OTHER project `exe` (this running
 * binary) is returned UNCHANGED: its regressions compile UNRELATED snippets with a plain compiler,
 * and there is nothing of THAT project's own source to attribute coverage to. A failed
 * instrumented build honest-warns and falls back to `exe` un-instrumented — the regression tier's
 * pass/fail verdict never depends on the coverage feed succeeding.
 *
 * @param dir  the project directory (the instrumented binary's build directory anchor)
 * @param exe  this compiler binary's own path (the fallback, and every other project's exe)
 * @param fe   the resolved front-end product (its `prog`/`manifest` build the instrumented copy)
 * @return     the exe the regression tier should compile scenarios with
 * @since 0.3.1
 */
fn regression_coverage_exe(dir: str, exe: str, fe: Frontend) -> str {
    if fe.manifest.name != "teko" { return exe }
    match build_regression_cov_exe(fe.manifest, fe.prog) {
        str as p => p
        error as e => {
            teko::io::println(teko::str::concat("teko: regression coverage-feed build failed (", teko::str::concat(e.message, ") — running regressions without coverage attribution")))
            exe
        }
    }
}

/**
 * build_regression_cov_exe — build a COVERAGE-INSTRUMENTED copy of the compiler `prog` (0.3.1
 * C-cov): emit it under `CgMode::ProgramCov` (`codegen::tk_emit_c_cov` — the SAME production-fn
 * line/branch prologues `TestCov` carries, but the ORDINARY virtual-main body, so the binary is a
 * fully functional `teko` CLI that ALSO dumps its coverage sinks to `$TEKO_TKCOV` at exit), then
 * compile it with `run_cc` at opt 0 (a throwaway gate-shaped binary, built fast). Distinct from the
 * `<name>-tktest` gate binary (`run_native_gate`) — that one's `main()` calls `#test`s; this one's
 * `main()` is the real CLI, so IT (not the release binary) can compile regression SNIPPETS while
 * marking the compiler-source lines those compiles exercise. The returned path is resolved
 * ABSOLUTE (never `bin/…`-relative): a `When built in place` scenario `cd`s into its own project
 * directory before invoking this exe (`compile_in_place`), so a relative path would resolve
 * against the WRONG directory once the regression phase reaches that scenario.
 *
 * @param m     the resolved manifest (names the output stem)
 * @param prog  the checked program to emit (the SAME `fe.prog` this `teko test` run already checked)
 * @return      the built instrumented binary's ABSOLUTE path, or an error
 * @since 0.3.1
 */
fn build_regression_cov_exe(m: Manifest, prog: checker::TProgram) -> str | error {
    let od = "bin"
    match teko::fs::mkdir(od) { error => { }; null => { } }
    let stem = teko::str::concat(m.name, "-regrcov")
    let cfile = teko::str::concat(od, "/", teko::str::concat(stem, ".c"))
    let binp = teko::str::concat(od, "/", stem)
    let emitted = match codegen::tk_emit_c_cov(prog) { str as s => s; error as e => return e }
    let csrc = teko::str::concat(emitted, codegen::tk_emit_meta(m.name, m.version, m.suffix, m.description))
    match teko::io::write_file(cfile, csrc) { error as e => return e; null => { } }
    if run_cc(cfile, binp, m, prog, 0) != 0 { return error { message = "cc failed to build the coverage-instrumented regression compiler" } }
    let cwd = match teko::env::cwd() { str as c => c; error => "" }
    abs_path_of(binp, cwd)
}

/**
 * run_regression_tier — run the `[tests] regression` phase, feeding its coverage back into this
 * process's sinks BEFORE any floor read (0.3.1 C-cov, D9): resolve the coverage-feeding exe
 * (`regression_coverage_exe`), run every listed `.tkr` (`run_regression_phase`), then merge every
 * covfile the compiles produced (`merge_regression_coverage`) — a no-op merge when the exe was not
 * instrumented (every project except the compiler's own). Coverage is merged REGARDLESS of the
 * phase's verdict — a rejected (compile-fail) scenario exercises real compiler code too.
 *
 * @param dir  the project directory
 * @param exe  this compiler binary's own path
 * @param fe   the resolved front-end product
 * @return     0 when every regressor passed (or the tier is advisory), 1 on a gated failure
 * @since 0.3.1
 */
fn run_regression_tier(dir: str, exe: str, fe: Frontend) -> i32 {
    let regr_exe = regression_coverage_exe(dir, exe, fe)
    let rc = run_regression_phase(regr_exe, fe.manifest)
    merge_regression_coverage()
    rc
}

/**
 * The `teko test <dir>` entry (D2, post-VM): assemble WITH the `.tkt` tests, then run every
 * `#test` NATIVELY via the #265 native gate (emit a test-profile C TU, compile with `run_cc`,
 * run the child fail-fast — a failed assert panics with a non-zero exit, M.1). The regression tier
 * (`run_regression_tier`) runs NEXT REGARDLESS of the gate's own verdict — never skipped just
 * because the gate failed. Before this, a single crashed `#test` returned the gate's status
 * immediately and the regression tier NEVER RAN, so a lane whose unit gate happened to fail
 * reported nothing at all about its regression corpus — the exact hidden-failure shape M.1 exists
 * to forbid, just one phase up from where M.1 itself already guards. The gate's own failure is
 * still the highest-precedence verdict (a `trc != 0` still fails the whole command, unchanged),
 * only DEFERRED past the regression tier's run so its report — pass or fail — is never swallowed.
 * With no `[tests] regression` files declared (`test_regression_files` empty, 0.3.1 C0) the tier
 * is a zero-cost no-op either way (the 0.3.0.29 inert base).
 *
 * When the gate passes, its coverage feed folds into `fe.prog` (C-cov, D9) BEFORE
 * `--coverage`/the floor policy read it, so neither ever undercounts what the regressives
 * exercised, and the D4 coverage-floor policy applies next (`--cov-validation` enforces;
 * otherwise warns — owner ruling 0.3.0.29). Unlike `teko build`, it emits NO release binary.
 * `--coverage` writes a Cobertura report to `<cwd>/cobertura.xml` (the project root — `teko test`
 * has no `-o`). `--per-test-cov` additionally emits the dev-time per-test attribution report
 * (`run_per_test_cov`) AFTER the floor policy. `--per-commit-test <base>` runs the delta-coverage
 * enforcer (`run_per_commit_test`) AFTER the floor policy — measuring coverage attributed to the
 * lines changed since `<base>` and (under `--cov-validation`) failing when that delta is below
 * floor; absent, it is a zero-cost no-op. The regression tier's OWN verdict gates last among the
 * pass-path policies (after the floor + delta policies), matching the pre-C-cov ordering.
 *
 * The D4 arith-cast-rate NUMBER is reported here, unconditionally, before the gate even runs —
 * see `report_arith_cast_rate` — because it is a property of the TYPED SOURCE alone, so it prints
 * even on a tree whose suite fails; only its PASS/FAIL verdict (`arith_cast_gate`) waits until the
 * end, alongside every other gate.
 *
 * @param dir              the project directory (already the cwd; the front-end chdir'd in)
 * @param gen_cov          `--coverage` — write the Cobertura report next to the project root
 * @param cov_validation   `--cov-validation` — enforce (fail) the coverage floors instead of warning
 * @param per_test_cov     `--per-test-cov` — also print the dev-time per-test attribution report
 * @param per_commit_base  `--per-commit-test <base>` — the git base for the delta gate ("" = no-op)
 * @param analyzer         `--analyzer` — after the gate + floors, run the dev-time stale/redundant analyzer
 * @param arith_cast_gate  `--arith-cast-gate` — after the gate + floors, enforce the D4
 *                         ARITH-CAST-RATE ceiling (≤2%, `cast-width-hygiene-0.3.1.md` §5, C5)
 * @return                 0 when every test passes and the gate + floor + delta + regression +
 *                         arith-cast-rate policies hold, else the highest-precedence failing status
 */
fn test_project(dir: str, gen_cov: bool, cov_validation: bool, per_test_cov: bool, per_commit_base: str, analyzer: bool, arith_cast_gate: bool) -> i32 {
    ensure_rt_dir_abs()
    let exe = self_exe_path()
    let fe = match project_frontend_sel(dir, true) { Frontend as x => x; error as e => return fail(dir, e.message) }
    let acr = report_arith_cast_rate(fe)
    let trc = run_native_gate(dir, "bin", fe.prog, fe.manifest, output_is_tty(false))
    let pre_regr_cob = coverage::cov_cobertura(fe.prog)
    let has_regr = fe.manifest.test_regression_files.len > 0
    let regr_rc = if has_regr { run_regression_tier(dir, exe, fe) } else { 0 }
    if gen_cov {
        let xml = coverage::cov_cobertura(fe.prog)
        match teko::io::write_file("cobertura.xml", xml) { error as e => return fail(dir, e.message); null => { } }
        teko::io::println("teko: wrote coverage report cobertura.xml")
    }
    let floor_rc = if trc == 0 { enforce_coverage_floors(dir, fe, cov_validation) } else { 0 }
    mut per_commit_rc: i32 = 0
    if trc == 0 && floor_rc == 0 && per_commit_base.len > 0 {
        per_commit_rc = run_per_commit_test(dir, fe, per_commit_base, cov_validation, pre_regr_cob)
    }
    let gate_rc = test_gate_precedence(trc, floor_rc, per_commit_rc, has_regr, regr_rc)
    if gate_rc != 0 { return gate_rc }
    if arith_cast_gate {
        let acrc = arith_cast_verdict(acr)
        if acrc != 0 { return acrc }
    }
    if per_test_cov { return run_per_test_cov(dir, fe) }
    if analyzer { return run_analyzer(dir, fe) }
    0
}

/**
 * test_gate_precedence — `test_project`'s combined failing status, in PRECEDENCE order, extracted
 * to a pure function so the invariant this fixes (owner-observed run `30400712261`: a crashed unit
 * gate used to return IMMEDIATELY, skipping the regression tier's run entirely — the tier's own
 * report went missing, not merely failed) is provable without a real build. The gate's own status
 * (`trc`) is still the highest-precedence failure, UNCHANGED; only the caller's control flow moved,
 * computing `floor_rc`/`per_commit_rc`/`regr_rc` before ever consulting `trc`, so their reports are
 * never swallowed by an earlier return.
 *
 * @param trc            the unit-test gate's own exit status (0 = every `#test` passed)
 * @param floor_rc       the D4 coverage-floor policy's status (0 when it was never consulted)
 * @param per_commit_rc  the delta-coverage enforcer's status (0 when `--per-commit-test` was absent)
 * @param has_regr       whether the manifest declares `[tests] regression` files at all
 * @param regr_rc        the regression tier's own exit status (ignored when `has_regr` is false)
 * @return                the highest-precedence non-zero status among the four, else 0
 * @since 0.3.1
 */
fn test_gate_precedence(trc: i32, floor_rc: i32, per_commit_rc: i32, has_regr: bool, regr_rc: i32) -> i32 {
    if trc != 0 { return trc }
    if floor_rc != 0 { return floor_rc }
    if per_commit_rc != 0 { return per_commit_rc }
    if has_regr && regr_rc != 0 { return regr_rc }
    0
}
