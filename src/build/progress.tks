/**
 * src/build/progress.tks   (namespace 'teko::build')
 *
 * BUILD-OUTPUT OBSERVABILITY — the per-phase progress reporter `teko build` (and the
 * bare-project invocation) uses in place of the historical one-line-per-file wall.
 * Every phase (parse, checker, monomorph, codegen, emit C, cc — plus the native backend's
 * lower/isel/regalloc/encode/objfile/link, the test gate's `emit test`/`cc test`, and the
 * release `rebuild`) ANNOUNCES itself at its START
 * and settles with the elapsed time and a `✓`/`✗` mark. The `Report` mode decides the
 * shape: `Tty` overwrites a single in-place line with a `\r`-updating counter WHILE the
 * phase works; `Plain` (CI/pipe/redirect) prints a full START line AND a full settle
 * line — no `\r` (which would smear a log), but the phase is visible the instant it
 * begins, so a long phase is never a silent gap between two settled lines; `Quiet`
 * prints nothing (an already-reported retry pass). All output goes to stderr — the C
 * standard library never buffers stderr, so a `\r` update is visible immediately with no
 * new runtime seam (stdout, by contrast, is block- or line-buffered and would need an
 * `fflush` primitive this compiler's released seed does not expose).
 */

/**
 * Whether the build's phase output should render as an interactive TTY (in-place `\r`
 * updates) rather than one settled line per phase (CI/log-safe, no `\r`).
 *
 * INTERIM ENV HEURISTIC — isolated here as the ONE place to swap for a real
 * `isatty(stdout)` once that runtime seam is staged (a new C-twin FFI is out of scope
 * for this change). Until then: `no_tty` (the CLI `--no-tty` override) always wins and
 * forces the plain form; else a non-empty `CI` variable, or an empty/`"dumb"` `TERM`,
 * is treated as non-interactive (piped, redirected, or a CI runner); anything else is
 * treated as a real terminal.
 *
 * @param no_tty  the `--no-tty` CLI override (forces the plain, non-interactive form)
 * @return        true iff the build should render in-place `\r`-updating phase lines
 */
pub fn output_is_tty(no_tty: bool) -> bool {
    if no_tty { return false }
    let ci = match teko::env::var("CI") { str as v => v; error => "" }
    if ci.len > 0 { return false }
    let term = match teko::env::var("TERM") { str as v => v; error => "" }
    if term.len == 0 { return false }
    term != "dumb"
}

/**
 * How a build phase renders its progress. THREE states, made explicit so a phase
 * can announce itself the moment it BEGINS on a non-interactive log — not only
 * settle at its END (the "silent gap" a CI reader saw between phases before this
 * distinction existed: a long phase was invisible while it ran):
 *
 *   - `Tty`   — an interactive terminal: a mid-phase line the `\r`-updating counter
 *               overwrites in place, settling with elapsed time + `✓`/`✗`.
 *   - `Plain` — a non-interactive log (CI, a pipe, a redirect): a plain START line
 *               at `phase_begin` AND a plain settle line at `phase_end` — no `\r`
 *               (which would smear a log), no mid-phase ticks, but the phase is
 *               visible the instant it starts, so a long phase is never a silent gap.
 *   - `Quiet` — no output at all (a silent/retry pass whose lines were already
 *               reported, e.g. the release rebuild's re-run of the front-end).
 */
pub type Report = enum { Tty; Plain; Quiet }

/**
 * Resolve the phase-render mode from the two axes the callers already carry: `quiet`
 * (this pass should print nothing — a retry/already-reported run) always wins as
 * `Quiet`; otherwise a real terminal renders `Tty` (in-place `\r` updates) and a
 * non-interactive destination renders `Plain` (START + settle lines, no `\r`).
 *
 * @param quiet  suppress ALL output for this pass (the caller's `!report`)
 * @param tty    render in-place `\r` updates (from `output_is_tty`)
 * @return       the resolved `Report` mode
 */
pub fn report_mode(quiet: bool, tty: bool) -> Report {
    if quiet { return Report::Quiet }
    if tty { Report::Tty } else { Report::Plain }
}

/**
 * One in-flight build phase: its label, start time, and how it renders (`mode`).
 *
 * @field label  the fixed-width-padded phase name ("parse", "checker", "cc", ...)
 * @field start  when the phase began, as a monotonic-clock ns reading (see `now_ns` —
 *               plain `i64` rather than `teko::time::span`; a build phase's duration is a
 *               MONOTONIC measurement per the drop-128 A6 type table, and threading the raw
 *               scalar `now_ns()` already returns keeps every call site downstream a plain
 *               numeric parameter, never a stored `teko::time` carrier struct)
 * @field mode   how this phase renders its progress (`Tty`/`Plain`/`Quiet`)
 */
pub type Phase = struct {
    label: str
    start: i64
    mode: Report
}

/**
 * A fresh monotonic-clock reading, in nanoseconds — the baseline `Phase.start` records and
 * `elapsed_str` measures against. Reads the `.ticks` field straight off
 * `teko::time::span_monotonic_now()`'s return: that function is PURE (non-extern) — it composes
 * `teko::time`'s private extern clock read into an ordinary `span` on the Teko side — so its
 * result is a normal, freely-composable value; only a value fresh off an EXTERN call itself
 * would trip the storage restriction `teko::time`'s module doc describes. This module keeps
 * every downstream call site (`Phase.start` and every fn threading it) a plain `i64`, matching
 * the ROUND 0 precedent of never storing a `teko::time` carrier struct here.
 *
 * @return a monotonic-clock ns reading
 */
fn now_ns() -> i64 {
    teko::time::span_monotonic_now().ticks
}

/**
 * now_ns_pub — a monotonic-clock ns reading exposed to the command entry point (`main`), so the
 * top-level `BuildClock` measures the SAME clock the phases do. It is the one public door onto the
 * private `now_ns` reader; keeping the reader private preserves the module's rule that only this file
 * touches `teko::time`, while `main` still reads a comparable instant for the external wall.
 *
 * @return a monotonic-clock ns reading
 * @since 0.3.1
 */
pub fn now_ns_pub() -> i64 {
    now_ns()
}

/**
 * BuildClock — the TOP clock of the command, the only one that sees the real external wall.
 *
 * The `start` is marked at the first instruction of `main` (the earliest Teko can observe; the
 * `exec`+loader cost BEFORE that is unreachable from inside the process and belongs to the CI that
 * runs `time`). The top wall (`now_ns_pub()` at close minus `start`) is the `wall_externo` of the
 * LAW: it must be covered ENTIRELY by phases (`dark == 0`), with the `process` bucket naming the
 * slice that is not work. Under parallelism the sum of phases EXCEEDS this wall (`overlap`), which is
 * expected, so the LAW is a DESIGUALDADE `wall <= Σfases`, never an equality.
 *
 * @field start  the monotonic ns reading taken at the first instruction of `main`
 * @since 0.3.1
 */
pub type BuildClock = struct {
    start: i64
}

/**
 * build_clock_start — open the top clock. Called as the FIRST useful instruction of `main`, before
 * the flag parse and subcommand dispatch, so that setup work falls INSIDE the observable window
 * instead of escaping into the dark.
 *
 * @return the opened clock
 * @since 0.3.1
 */
pub fn build_clock_start() -> BuildClock {
    BuildClock { start = now_ns() }
}

/**
 * build_clock_wall_ns — the external wall so far: the monotonic ns elapsed since the clock opened.
 * Floors at zero (a monotonic clock cannot run backwards, so a negative delta is impossible in
 * practice and renders as no time rather than a negative one).
 *
 * @param clock  the top clock opened by `build_clock_start`
 * @return       the external wall in ns (>= 0)
 * @since 0.3.1
 */
pub fn build_clock_wall_ns(clock: BuildClock) -> i64 {
    let d = now_ns() - clock.start
    if d < 0 { 0 } else { d }
}

/**
 * PhaseLedger — the razão of the phases of ONE build run: (label, ns) pairs in settle order.
 *
 * THE INVARIANT IS THE LAW (a DESIGUALDADE): `wall_externo <= ledger_total_ns(l)`, with the
 * `process` bucket already in the razão. The ONLY defeito is `dark = max(0, wall − Σfases) > 0` —
 * wall that no phase names (the dark time). The folga `overlap = max(0, Σfases − wall)` is NOT a
 * defeito: it is the parallelism gain, `>= 0` and informative. `ledger_reconcile` asserts
 * `dark == 0` and returns `overlap`.
 *
 * @field labels  the name of each phase, in settle order
 * @field ns      the duration of each phase (parallel to `labels`), in monotonic ns
 * @since 0.3.1
 */
pub type PhaseLedger = struct {
    labels: []str
    ns: []i64
}

/**
 * ledger_empty — the empty razão, before any phase has settled.
 *
 * @return a razão with no phases
 * @since 0.3.1
 */
pub fn ledger_empty() -> PhaseLedger {
    PhaseLedger { labels = teko::list::empty(); ns = teko::list::empty() }
}

/**
 * ledger_record — append a settled phase to the razão. A ledger is a value, so the caller threads the
 * returned razão forward; recording and instrumenting a phase are meant to be ONE action at each
 * phase's settle point.
 *
 * @param l      the current razão
 * @param label  the name of the phase that just settled
 * @param ns     its measured duration (`now_ns() - phase.start`)
 * @return       the razão with the phase appended
 * @since 0.3.1
 */
pub fn ledger_record(l: PhaseLedger, label: str, ns: i64) -> PhaseLedger {
    PhaseLedger {
        labels = teko::list::push(l.labels, label)
        ns = teko::list::push(l.ns, ns)
    }
}

/**
 * ledger_labels_joined — the razão's labels in settle order, joined by `sep`. The deterministic view
 * a fixture asserts against (the ns are non-deterministic and never asserted; the label sequence is).
 *
 * @param l    the razão
 * @param sep  the separator to place between labels
 * @return     the labels joined in settle order, or "" for an empty razão
 * @since 0.3.1
 */
pub fn ledger_labels_joined(l: PhaseLedger, sep: str) -> str {
    mut out = ""
    mut i: u64 = 0
    loop {
        if i >= l.labels.len { break }
        if i > 0 { out = teko::str::concat(out, sep) }
        out = teko::str::concat(out, l.labels[i])
        i = i + 1
    }
    out
}

/**
 * ledger_total_ns — the sum of every phase in the razão.
 *
 * @param l  the razão
 * @return   the sum of the durations, in ns
 * @since 0.3.1
 */
pub fn ledger_total_ns(l: PhaseLedger) -> i64 {
    mut acc: i64 = 0
    mut i: u64 = 0
    loop {
        if i >= l.ns.len { break }
        acc = acc + l.ns[i]
        i = i + 1
    }
    acc
}

/**
 * Reconciliation — the verdict of the LAW decomposed into its two fixed-sign quantities: `dark` (wall
 * no one named, which MUST be 0) and `overlap` (the parallelism gain, `>= 0`, informative).
 *
 * @field dark     `max(0, wall − Σfases)` — dark time; the defeito to eliminate.
 * @field overlap  `max(0, Σfases − wall)` — overlap of concurrent phases; the measured speedup.
 * @since 0.3.1
 */
pub type Reconciliation = struct {
    dark: i64
    overlap: i64
}

/**
 * ledger_reconcile — the verdict of the LAW (§2.1), which is a DESIGUALDADE and not an equality.
 * Returns the `dark`/`overlap` decomposition of the top wall against the sum of the phases. Fails
 * ONLY when there is dark time (`dark > 0` — wall that no phase names); NEVER when the sum of the
 * phases exceeds the wall (`Σfases > wall`), because that is the PARALLELISM GAIN and trapping on it
 * would break the day threads land. Sequential: `dark == 0` and `overlap == 0`. Parallel:
 * `dark == 0` and `overlap > 0`.
 *
 * @param l     the razão of phases (the lifecycle `process` phase already included)
 * @param wall  the external wall (`build_clock_wall_ns` at close)
 * @return      the decomposition with `dark == 0`, or an error when there is dark time (`dark > 0`)
 * @throws      when `wall > Σfases`: the wall carries `dark` ns that no phase accounts for
 * @since 0.3.1
 */
pub fn ledger_reconcile(l: PhaseLedger, wall: i64) -> Reconciliation | error {
    let total = ledger_total_ns(l)
    let dark = if wall > total { wall - total } else { 0 }
    if dark > 0 { return error { message = $"teko: {dark}ns of wall belongs to no phase (dark time)" } }
    Reconciliation { dark = 0; overlap = total - wall }
}

/**
 * `s` right-padded with spaces to at least `width` bytes — column alignment for the
 * phase label / counter fields.
 *
 * @param s      the text to pad
 * @param width  the minimum output width
 * @return       `s`, followed by enough spaces to reach `width`
 */
fn pad_right(s: str, width: u64) -> str {
    mut out = s
    loop {
        if out.len >= width { break }
        out = teko::str::concat(out, " ")
    }
    out
}

/**
 * `s` left-padded with spaces to at least `width` bytes — right-aligning the elapsed
 * time column.
 *
 * @param s      the text to pad
 * @param width  the minimum output width
 * @return       enough leading spaces to reach `width`, followed by `s`
 */
fn pad_left(s: str, width: u64) -> str {
    mut out = s
    loop {
        if out.len >= width { break }
        out = teko::str::concat(" ", out)
    }
    out
}

/**
 * The monotonic time elapsed since `start` (ns, see `now_ns`), rendered to one decimal place of
 * seconds ("42.1", no unit suffix — the caller appends "s").
 *
 * The subtraction cannot overflow, and NOT because anything checks it: both operands are readings
 * of the SAME monotonic clock, whose ns value is a small positive count since an arbitrary boot-era
 * origin, so their difference is bounded by the process's own uptime — many orders of magnitude
 * inside `i64`. (The pre-0.3.1 wording claimed a "checked `-` … would panic on genuine overflow";
 * there is no such check — `TEKO_OVERFLOW_DEBUG` is defined by no build path, so `-` on `i64` is a
 * bare machine subtract. The bound is a property of the operands, and that is what makes it safe.)
 * A negative delta — which a monotonic clock cannot produce — floors to zero rather than rendering
 * a negative time.
 *
 * @param start  the phase's recorded start time, a monotonic-clock ns reading (see `now_ns`)
 * @return       the elapsed seconds, one decimal place, as decimal text
 */
fn elapsed_str(start: i64) -> str {
    duration_str(now_ns() - start)
}

/**
 * duration_str — a nanosecond duration rendered to one decimal place of seconds ("42.1", no unit
 * suffix — the caller appends "s"). A negative delta — which a monotonic clock cannot produce —
 * floors to zero rather than rendering a negative time. The one place phase-elapsed and the
 * top-level command wall share, so both read the same way.
 *
 * @param ns  the duration in nanoseconds (a monotonic-clock difference)
 * @return    the seconds, one decimal place, as decimal text
 * @since 0.3.1
 */
pub fn duration_str(ns: i64) -> str {
    let ns_u = if ns < 0 { 0 to u64 } else { ns to u64 }
    let tenths = ns_u / 100000000
    $"{tenths / 10}.{tenths % 10}"
}

/**
 * The "N/M unit" counter text for a phase whose total is known up front
 * (`"122/122 files"`, `"789/789 items"`).
 *
 * @param count  how many units are done so far
 * @param total  the known total unit count
 * @param unit   the unit name ("files", "items", "instances", ...)
 * @return       the rendered counter text
 */
pub fn count_unit_text(count: u64, total: u64, unit: str) -> str {
    $"{count}/{total} {unit}"
}

/**
 * The "N unit" count-up text for a phase whose total is NOT cheaply known up front
 * (monomorphization's fixpoint queue, whose size only settles once the phase ends) —
 * the spinner/count-up fallback the observability shape calls for in that case.
 *
 * @param count  how many units have been produced so far
 * @param unit   the unit name
 * @return       the rendered count-up text
 */
pub fn count_only_text(count: u64, unit: str) -> str {
    $"{count} {unit}"
}

/**
 * The "(N.N MB)" text for a byte size (the emit-C phase's generated-file size).
 *
 * @param bytes  the size in bytes
 * @return       the size rendered to one decimal place of megabytes, parenthesized
 */
pub fn size_text(bytes: u64) -> str {
    let tenths = bytes * 10 / 1048576
    $"({tenths / 10}.{tenths % 10} MB)"
}

/**
 * The mid-phase line: the padded label followed by the current counter text, with
 * no elapsed time or mark yet (the phase is still running).
 *
 * @param label  the phase name
 * @param text   the current counter/detail text
 * @return       the rendered mid-phase line, un-terminated (no trailing newline)
 */
fn mid_line(label: str, text: str) -> str {
    teko::str::concat("  ", teko::str::concat(pad_right(label, 11), pad_right(text, 24)))
}

/**
 * The settled line: the padded label, the final counter/detail text, the elapsed
 * time, the `✓`/`✗` mark, and — on a failure — the diagnostic message.
 *
 * @param label    the phase name
 * @param text     the final counter/detail text
 * @param start    the phase's start time, a monotonic-clock ns reading (for the elapsed column)
 * @param mark     "✓" (success) or "✗" (failure)
 * @param message  the failure diagnostic, or "" on success
 * @return         the rendered settle line, un-terminated (no trailing newline)
 */
fn settle_line(label: str, text: str, start: i64, mark: str, message: str) -> str {
    let elapsed = teko::str::concat(pad_left(elapsed_str(start), 6), "s")
    let head = teko::str::concat("  ", teko::str::concat(pad_right(label, 11), teko::str::concat(pad_right(text, 24), teko::str::concat(elapsed, teko::str::concat("  ", mark)))))
    if message == "" { head } else { teko::str::concat(head, teko::str::concat("  ", message)) }
}

/**
 * Begin a phase: record its start time and ANNOUNCE it, so the label appears the
 * instant the phase starts (never a silent gap). On `Tty` this is the initial
 * mid-phase line the first `\r` tick will overwrite in place; on `Plain` (a CI/log
 * destination) it is a full, newline-terminated START line — the key line that turns
 * a long silent phase into a visible "started … / settled …" pair. `Quiet` prints
 * nothing (a retry/already-reported pass).
 *
 * @param label    the phase name ("parse", "checker", "cc", ...)
 * @param initial  the starting counter/detail text (typically the zero count)
 * @param mode     how this phase renders (`Tty`/`Plain`/`Quiet`)
 * @return         the `Phase` handle for `phase_tick`/`phase_end_ok`/`phase_end_fail`
 */
pub fn phase_begin(label: str, initial: str, mode: Report) -> Phase {
    match mode {
        Report::Tty => teko::io::eprint(mid_line(label, initial))
        Report::Plain => teko::io::eprintln(mid_line(label, initial))
        Report::Quiet => { }
    }
    Phase { label = label; start = now_ns(); mode = mode }
}

/**
 * Update a running phase's in-place counter. Only `Tty` ticks: a `Plain` run has
 * already printed its START line and settles once at the end (a `\r` would smear a
 * log file), and a `Quiet` run prints nothing.
 *
 * @param p     the phase handle from `phase_begin`
 * @param text  the current counter/detail text
 */
pub fn phase_tick(p: Phase, text: str) -> void {
    if p.mode != Report::Tty { return }
    teko::io::eprint(teko::str::concat("\r", mid_line(p.label, text)))
}

/**
 * Settle a phase as SUCCESSFUL: the final counter/detail text, elapsed time, and a
 * `✓`. On `Tty` this overwrites the last in-place line (`\r` prefix); on `Plain` it
 * is a plain settle line following the START line `phase_begin` already printed;
 * `Quiet` prints nothing. Non-quiet output ends with a single newline (flushed
 * immediately — stderr is never buffered).
 *
 * @param p     the phase handle from `phase_begin`
 * @param text  the final counter/detail text
 */
pub fn phase_end_ok(p: Phase, text: str) -> void {
    if p.mode == Report::Quiet { return }
    let prefix = if p.mode == Report::Tty { "\r" } else { "" }
    teko::io::eprintln(teko::str::concat(prefix, settle_line(p.label, text, p.start, "✓", "")))
}

/**
 * Settle a phase as FAILED: the counter/detail text at the point of failure, elapsed
 * time, a `✗`, and the diagnostic message — so WHERE a build stopped is obvious. On
 * `Tty` the `\r` overwrites the last in-place line; on `Plain` it follows the START
 * line; `Quiet` prints nothing.
 *
 * @param p        the phase handle from `phase_begin`
 * @param text     the counter/detail text at the point of failure
 * @param message  the failure diagnostic
 */
pub fn phase_end_fail(p: Phase, text: str, message: str) -> void {
    if p.mode == Report::Quiet { return }
    let prefix = if p.mode == Report::Tty { "\r" } else { "" }
    teko::io::eprintln(teko::str::concat(prefix, settle_line(p.label, text, p.start, "✗", message)))
}
