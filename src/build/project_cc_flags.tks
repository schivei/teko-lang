// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

 * MinGW answer, which is what keeps `TEKO_CC=...mingw...` from being a way around the law.
 *
 * @param m  the resolved manifest (the `cc` override, if any)
 * @return   the compiler command for the current build, plus the target flag it implies
 */
fn resolve_cc_choice(m: Manifest) -> CcChoice {
    if m.cc.len > 0 { return CcChoice { cmd = m.cc; target_flag = "" } }
    let env_cc = teko_cc_env()
    if env_cc.len > 0 { return CcChoice { cmd = env_cc; target_flag = "" } }
    host_cc_choice()
}

/**
 * resolve_cc — the COMMAND half of `resolve_cc_choice`, for the callers that only need to name the
 * compiler (diagnostics, the regressor's capability probes) and never assemble a command line.
 *
 * @param m  the resolved manifest (the `cc` override, if any)
 * @return   the compiler command for the current build
 */
fn resolve_cc(m: Manifest) -> str { resolve_cc_choice(m).cmd }

/**
 * opt_cc_flag — the portable cc optimization flag for an optimization `level`, or
 * "" for level 0. Level 0 (the DEV/CI default) emits NO flag so the link line stays
 * byte-identical to the historic `-O0` release line (the FIXPOINT is preserved);
 * level 1/2 emit `-O1`/`-O2`, which both gcc and clang accept (deliberately NOT
 * `-march=native`, which is not portable for a released seed).
 *
 * @param level  the requested optimization level (0, 1 or 2; >2 is clamped to `-O2`)
 * @return       "-O1"/"-O2" for level 1/2, else "" (no flag) for level 0
 */

/**
 * DebugInfo — how much debug information a build emits, the `--debug=<value>` axis
 * (`docs/design/debugger-superficie-e-contramedida-0.3.1.md` §7.2, crumb D1.6).
 *
 * An ENUM and not a bool because the axis is LEVELLED at the reference this surface mirrors:
 * rustc documents `line-tables-only` ("the minimal amount of debug info for backtraces with
 * filename/line number info, but not anything else") as a first-class level distinct from
 * `full`. `Lines` IS that level. A `Vars` member joins here at D2.6, once locals are threaded
 * through the LIR — no existing spelling changes meaning when it does.
 *
 * One level drives TWO outputs from ONE origin: the DWARF sections (for gdb/lldb/VSCode, D1.3
 * onward) and the `.tsym` v2 map (for `tdb`). They are consumers, never rival formats.
 *
 * @since 0.3.1 debugger piso, D1.6
 * @see opt_level_of  the sibling build AXIS, likewise CLI-only and absent from `teko.tkp` (§7.3)
 */

/**
 * build_cc_argv — assemble the host-`cc` command line that turns one input file
 * (`input`, a generated `.c` for the C backend or an own-backend `.o`) into the
 * native `binary`, in full parity with `driver.c::run_cc` (M.5, reuse the host
 * toolchain in one invocation). The line carries: the compiler chosen by
 * `resolve_cc_choice` (the `[extern] cc` override, else the `TEKO_CC` env seam,
 * else this host's default — `clang --target=x86_64-pc-windows-msvc` on Windows,
 * the bare host `cc` elsewhere) followed by that choice's own target flag, if any
 * (empty on every non-Windows host, so the line there is byte-unchanged); the portable
 * `-std`/error-limit spelling for the detected compiler
 * family (clang `-std=c23`/`-ferror-limit=0`, else GCC's `-std=c2x`/`-fmax-errors=0`);
 * `-w` to silence warnings on machine-generated C; the project version baked into
 * `teko_rt`'s `tk_rt_version()` as a BARE `-DTEKO_VERSION_STRING` token (embedded
 * quotes broke Windows arg re-parsing); `ASSERT_SEED_STRONG_FLAG` when the program
 * does NOT declare `teko::assert` itself (making the assert seed the sole, STRONG
 * definition — PE/COFF has no working cross-TU weak definition, so the weak-only seed
 * left every Windows program that called `teko::assert` unlinkable); the cross knobs
 * (`-target`/`--sysroot`/`-nostdlib`, C7.1f); the runtime + assert include dirs; the
 * input; the two C runtime
 * seed sources (`teko_rt.c` + `assert.c`); `-lm` (unless freestanding); the
 * reachable `[extern.libs]` link flags (C7.20); on macOS, the `__info_plist`
 * `-Wl,-sectcreate` section; and, on Windows, the reproducible-build flag (`/Brepro`) plus a widened
 * 16 MiB stack reserve (`/STACK:16777216`, past the PE default's 1 MiB — see
 * `WINDOWS_STACK_RESERVE_FLAG`). Shared verbatim by `run_cc` (a `.c` input) and
 * `link_object` (an own-backend `.o` input) so both link the SAME way — the only
 * difference is the input file, keeping the two paths from drifting. When `debug`
 * is set it also appends the DEBUG profile flag `-g` (emit DWARF so the E4 native
 * stack trace resolves against the `.tsym` map). Optimization is an AXIS of the
 * build, not a global: `opt` 0 (the DEV/CI DEFAULT) emits NO `-O` flag — the line
 * is byte-identical to the historic `-O0` release line, so the FIXPOINT (gen1 ==
 * gen2) is preserved untouched — while `opt` 1/2 appends `-O1`/`-O2` (the portable
 * gcc+clang spelling; never `-march=native`, which is not portable for a released
 * seed). The published seed is built ONCE at `opt` 2 in `release.yml` (a diagnostic
 * proved the same emitted `teko.c` recompiled at `-O2` self-hosts 1.30x faster,
 * 168.7s → 129.6s, and `cmp` showed `-O0` and `-O2` emit BYTE-IDENTICAL C — the
 * speed changes, the emitted output does not), so everyone downstream gets a fast
 * compiler. Assertions stay ON at every level (nothing defines NDEBUG).
 *
 * @param input   the input path — a generated `.c` (C backend) or a `.o` (own backend)
 * @param binary  the output native executable path
 * @param m       the resolved manifest (cc override, version, cross knobs, libs)
 * @param prog    the checked program (for extern-reachability of the link flags)
 * @param debug   append the debug profile flag (`-g`); false = today's byte-identical release line
 * @param opt     the cc optimization level: 0 (default) emits no `-O` flag, 1/2 appends `-O1`/`-O2`
 * @return        the full `cc` argument vector, ready for `teko::process::run`
 */
fn build_cc_argv(input: str, binary: str, m: Manifest, prog: checker::TProgram, debug: bool, opt: i32) -> []str {
    let rt = rt_dir()
    let asrt = assert_dir(rt)
    let choice = resolve_cc_choice(m)
    let is_clang = cc_family_is_clang(choice.cmd, binary)
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, choice.cmd)
    if choice.target_flag.len > 0 { argv = teko::list::push(argv, choice.target_flag) }
    argv = teko::list::push(argv, if is_clang { "-std=c23" } else { "-std=c2x" })
    argv = teko::list::push(argv, "-w")
    argv = teko::list::push(argv, if is_clang { "-ferror-limit=0" } else { "-fmax-errors=0" })
    if debug { argv = teko::list::push(argv, "-g") }
    let oflag = opt_cc_flag(opt)
    if oflag.len > 0 { argv = teko::list::push(argv, oflag) }
    let verval = if m.suffix.len > 0 { teko::str::concat(teko::str::concat(m.version, "-"), m.suffix) } else { m.version }
    argv = teko::list::push(argv, teko::str::concat("-DTEKO_VERSION_STRING=", verval))
    if !program_declares_assert_seed(prog) { argv = teko::list::push(argv, ASSERT_SEED_STRONG_FLAG) }
    if m.target.len > 0 { argv = teko::list::push(teko::list::push(argv, "-target"), m.target) }
    if m.sysroot.len > 0 { argv = teko::list::push(teko::list::push(argv, "--sysroot"), m.sysroot) }
    if m.freestanding { argv = teko::list::push(argv, "-nostdlib") }
    argv = teko::list::push(argv, "-I")
    argv = teko::list::push(argv, rt)
    argv = teko::list::push(argv, "-I")
    argv = teko::list::push(argv, asrt)
    argv = teko::list::push(argv, input)
    argv = teko::list::push(argv, teko::str::concat(rt, "/teko_rt.c"))
    argv = teko::list::push(argv, teko::str::concat(asrt, "/assert.c"))
    let keys = link_target_keys(m)
    argv = append_libm_flag(argv, m, keys.emit_os)
    let reachable = reachable_libs(prog)
    argv = append_reachable_link_flags(argv, m, reachable)
    argv = append_reachable_os_lib_flags(argv, m, keys, reachable)
    argv = append_allow_undef_flag(argv)
    argv = append_macos_plist_flag(argv, binary, m, keys.emit_os)
    argv = append_windows_reproducible_flag(argv, keys.emit_os)
    argv = append_windows_stack_reserve_flag(argv, keys.emit_os)
    argv = teko::list::push(argv, "-o")
    teko::list::push(argv, binary)
}

/**
 * LIBM_FLAG — the flag that links the C math library on the platforms that ship it separately.
 */
const LIBM_FLAG: str = "-lm"

/**
 * append_libm_flag — link the math library, EXCEPT where the platform has none to link.
 *
 * WINDOWS HAS NO SEPARATE LIBM. Its math functions live in the CRT the linker already pulls in, and
 * MSVC ships no `m.lib` at all — so `-lm` there is not a harmless extra, it is a link error
 * (`could not open 'm.lib'`) once the compiler stops being MinGW (whose `libm.a` is what made the
 * flag work until now). The Linux/macOS arms are untouched, which is what keeps their link line
 * byte-identical.
 *
 * A FREESTANDING build links no libc at all (`-nostdlib`), so it never asks for libm either.
 *
 * @param argv     the link argument vector so far
 * @param m        the resolved manifest (the freestanding switch)
 * @param emit_os  the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`)
 * @return         `argv` with `-lm` appended where the platform has one, else unchanged
 * @since 0.3.1
 */
fn append_libm_flag(argv: []str, m: Manifest, emit_os: str) -> []str {
    if m.freestanding { return argv }
    if emit_os == WINDOWS_OS_NAME { return argv }
    teko::list::push(argv, LIBM_FLAG)
}

/**
 * WINDOWS_NO_TIMESTAMP_FLAG — the MSVC-linker option that makes the PE image REPRODUCIBLE instead of
 * stamping the wall clock into its COFF `TimeDateStamp`. `-Wl,` because it reaches `lld-link` /
 * `link.exe` through the `clang` driver.
 *
 * IT USED TO BE THE GNU SPELLING (`--no-insert-timestamp`), WHICH ONLY MinGW's `ld` UNDERSTANDS.
 * With MinGW banned, the linker behind a Windows target is `lld-link`/`link.exe`, and the GNU
 * spelling would abort the link as an unknown argument — so the flag had to move with the toolchain.
 * `/Brepro` is the MSVC-family switch for exactly this, and both linkers accept it.
 */
const WINDOWS_NO_TIMESTAMP_FLAG: str = "-Wl,/Brepro"

/**
 * append_windows_reproducible_flag — on a Windows/COFF target, stop the linker from stamping the
 * BUILD TIME into the executable, so two links of the same program produce the same bytes.
 *
 * THE MEASUREMENT THIS CLOSES, from the wagon's own `windows-x86_64` leg at `d74df08` — the first
 * run in which that leg ever got far enough to compare two generations at all:
 *
 *     gen2 ready (4296372 bytes)
 *     gen3 ready (4296372 bytes)
 *     byte-identity: gen2 != gen3  ✗
 *     .fixpoint/gen2 .fixpoint/gen3 differ: char 137, line 2
 *     emitted-C identity: gen2.c == gen3.c  ✓ (10114862 bytes)
 *
 * Same SIZE, byte-identical emitted C, and the first difference at `cmp`'s 1-based char 137 —
 * offset 136. In a PE image `e_lfanew` points at 128, the `PE\0\0` signature occupies 128..131, and
 * the COFF header follows: `Machine` 132..133, `NumberOfSections` 134..135, `TimeDateStamp`
 * 136..139. The first differing byte IS the first byte of the timestamp, and the two generations
 * were linked ~85 s apart.
 *
 * SO THE COMPILER WAS NEVER WRONG HERE. It emitted the same C and produced the same program; the
 * LINKER broke reproducibility by recording when it ran. The fixpoint is a claim about the
 * compiler, and a clock embedded by the output format is not the compiler disagreeing with itself.
 *
 * NOT A FIXPOINT SOFTENING, and the distinction matters on this wagon: nothing is excluded from the
 * comparison and no byte is forgiven. The build stops WRITING a value that was never about the
 * program, so the two images become equal on their own — the gate goes on comparing every byte.
 *
 * IF A DIFFERENCE REMAINS AFTER THIS, expect the optional header's `CheckSum` (computed over the
 * image, so it moves with the timestamp) or a debug-directory stamp. `cmp` reports only the FIRST
 * difference, so a clean run is what proves the set was just this one.
 *
 * @param argv     the link argument vector so far
 * @param emit_os  the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`) — "windows" enables it
 * @return         `argv` with the flag appended on a Windows target, else unchanged
 */
fn append_windows_reproducible_flag(argv: []str, emit_os: str) -> []str {
    if emit_os != "windows" { return argv }
    teko::list::push(argv, WINDOWS_NO_TIMESTAMP_FLAG)
}

/**
 * WINDOWS_STACK_RESERVE_FLAG — the MSVC-linker option that reserves a 16 MiB (0x1000000) stack for
 * the produced PE image, instead of the PE default's 1 MiB reserve.
 *
 * Windows' 1 MiB default thread stack is far smaller than Linux's 8 MiB default, and this
 * compiler's own bounded-but-deep recursive-descent passes (e.g. `teko::checker::monomorph`'s
 * `mono_texpr`/`mono_tstmt`/`mono_block` AST walk, whose depth tracks the INPUT program's
 * statement/expression nesting, not any bug) overflow the smaller Windows default well before the
 * SAME recursion would overflow Linux's — a stack-size gap, not a codegen defect (confirmed by
 * reproducing the SAME crash on Linux under an artificially shrunk 1 MiB `ulimit -s`, and by the
 * crash disappearing once the stack is widened past the observed recursion depth). `/STACK` reaches
 * `lld-link`/`link.exe` through the `clang` driver exactly like `WINDOWS_NO_TIMESTAMP_FLAG` reaches
 * it for `/Brepro`.
 */
const WINDOWS_STACK_RESERVE_FLAG: str = "-Wl,/STACK:16777216"

/**
 * append_windows_stack_reserve_flag — on a Windows/COFF target, widen the produced binary's stack
 * reserve past the PE default's 1 MiB so the compiler's deep-but-finite recursive passes (checker
 * monomorphization, codegen lowering) do not overflow it on the OS whose default stack is smallest.
 *
 * @param argv     the link argument vector so far
 * @param emit_os  the RESOLVED TARGET's own OS (`LinkTargetKeys.emit_os`) — "windows" enables it
 * @return         `argv` with the flag appended on a Windows target, else unchanged
 */
fn append_windows_stack_reserve_flag(argv: []str, emit_os: str) -> []str {
    if emit_os != WINDOWS_OS_NAME { return argv }
    teko::list::push(argv, WINDOWS_STACK_RESERVE_FLAG)
}

/**
 * ALLOW_UNDEF_FLAG — the Teko-linker flag name that opts INTO a blind link over shared libraries
 * the link step cannot see (R5, teko-target-crosslink-0.3.1.md §5). OURS, not the system
 * linker's: `allow_undef_cc_flag` translates it per object format for the transitional `cc`, and
 * the own M-linker makes it native in E1.
 */
const ALLOW_UNDEF_FLAG: str = "--allow-undef"

