
/**
 * run_pool — run every one of `specs` in its own PROCESS, at most `jobs` in flight at once, and
 * return one `CapResult` each, in the ORDER `specs` WERE GIVEN — replaces the old `sh`-batch
 * scaffold's `run_captured_batch` with the same intent (many isolated builds, one call, N verdicts
 * instead of stopping at the first) and no line of shell.
 *
 * THE WINDOW IS A SLIDING ONE, DELIBERATELY, not a barrier every `jobs` launches: this launches the
 * first `jobs` specs, then repeatedly HARVESTS THE OLDEST STILL-IN-FLIGHT child and immediately
 * launches the next pending one. The window's own children keep running between one harvest and the
 * next — only the harvest itself blocks, and only on the child whose turn it is — so a barrier's
 * per-batch tail waste (waiting for the slowest of a group before the next group can start) happens
 * at most ONCE, at the very end of the whole run, instead of once per `jobs`-sized group.
 *
 * ORDER IS BY INDEX, NEVER BY COMPLETION — the determinism law (§8 of the design): harvesting
 * `specs[i]` always waits on `specs[i]`'s OWN handle, so the returned list is `specs`' order
 * regardless of which child actually finished first. The same source therefore produces the SAME
 * report at `jobs=1` and at `jobs=64` — only the WALL CLOCK differs, never which line says what.
 *
 * @param specs  what to run, one per row
 * @param jobs   how many may be in flight at once (`regr_jobs()`)
 * @return       one capture per spec, in the order given (empty for no specs)
 * @since 0.3.1.2
 */
pub fn run_pool(specs: []ProcSpec, jobs: u64) -> []CapResult {
    let n = specs.len
    mut caps: []CapResult = teko::list::empty()
    if n == 0 { return caps }
    let window = pool_window(n, jobs)
    let t_pool0 = regr_now_ns()
    mut handles: []teko::process::ProcHandle = teko::list::empty()
    mut spawned_at: []i64 = teko::list::empty()
    mut launched: u64 = 0
    loop {
        if launched >= window { break }
        handles = teko::list::push(handles, spawn_spec(specs[launched]))
        spawned_at = teko::list::push(spawned_at, regr_now_ns())
        launched = launched + 1
    }
    mut harvested: u64 = 0
    loop {
        if harvested >= n { break }
        caps = teko::list::push(caps, harvest_spec(specs[harvested], handles[harvested], spawned_at[harvested], t_pool0))
        harvested = harvested + 1
        if launched < n {
            handles = teko::list::push(handles, spawn_spec(specs[launched]))
            spawned_at = teko::list::push(spawned_at, regr_now_ns())
            launched = launched + 1
        }
    }
    caps
}
