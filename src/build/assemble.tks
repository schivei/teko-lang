
use teko::parser
use teko::lexer

fn asm_is_main(path: str): bool {
    if !teko::str::ends_with(path, "main.tks") { return false }
    if path.len == 8 { return true }
    path[path.len - 9] == b'/'
}

fn asm_main_items(mf: parser::MainFile): []parser::Item {
    var items: []parser::Item = teko::list::empty()
    var ui: u64 = 0
    loop {
        if ui >= mf.uses.len { break }
        items = teko::list::push(items, parser::Item { content = mf.uses[ui]; namespace = ""; file = ""; guard = parser::pred_true() })
        ui = ui + 1
    }
    var si: u64 = 0
    loop {
        if si >= mf.body.len { break }
        items = teko::list::push(items, parser::Item { content = mf.body[si]; namespace = ""; file = ""; guard = parser::pred_true() })
        si = si + 1
    }
    items
}

fn asm_module_items(m: parser::Module): []parser::Item {
    var items: []parser::Item = teko::list::empty()
    var ui: u64 = 0
    loop {
        if ui >= m.uses.len { break }
        items = teko::list::push(items, parser::Item { content = m.uses[ui]; namespace = ""; file = ""; guard = parser::pred_true() })
        ui = ui + 1
    }
    var di: u64 = 0
    loop {
        if di >= m.decls.len { break }
        var g = asm_decl_guard(m, di)
        items = match m.decls[di] {
            parser::Function as f => teko::list::push(items, parser::Item { content = f; namespace = ""; file = ""; guard = g })
            parser::TypeDecl as t => teko::list::push(items, parser::Item { content = t; namespace = ""; file = ""; guard = g })
            parser::ConstDecl as c => teko::list::push(items, parser::Item { content = c; namespace = ""; file = ""; guard = g })
            parser::MacroDecl as md => teko::list::push(items, parser::Item { content = md; namespace = ""; file = ""; guard = g })
            parser::ComptimeDecl as cd => teko::list::push(items, parser::Item { content = cd; namespace = ""; file = ""; guard = g })
        }
        di = di + 1
    }
    items
}

fn asm_decl_guard(m: parser::Module, di: u64): parser::Pred {
    if di < m.decl_guards.len { return m.decl_guards[di] }
    parser::pred_true()
}

fn asm_parse(path: str, tokens: []lexer::Token): []parser::Item | error {
    if asm_is_main(path) {
        var mf = match parser::parse_main_file(tokens, 0) { parser::Parsed<parser::MainFile> as x => x.node; error as e => return e }
        asm_main_items(mf)
    } else {
        var m = match parser::parse_module(tokens, 0) { parser::Parsed<parser::Module> as x => x.node; error as e => return e }
        asm_module_items(m)
    }
}

fn asm_lex_and_parse(path: str, src: str): []parser::Item | error {
    var tokens = match lexer::tokenize_file(src, path) { []lexer::Token as t => t; error as e => return e }
    match asm_parse(path, tokens) { []parser::Item as items => items; error as e => return e }
}

fn eligible_file_count(files: []SourceFile, include_tests: bool): u64 {
    var n: u64 = 0
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if include_tests || !teko::str::ends_with(files[i].path, ".tkt") { n = n + 1 }
        i = i + 1
    }
    n
}

fn assemble(files: []SourceFile): parser::Program | error {
    var a = match assemble_sel(files, false, false, false) { Assembled as x => x; error as e => return e }
    if a.diags.len > 0 { return error { message = join_diags(a.diags) } }
    a.program
}

pub type Assembled = struct {
    program: parser::Program
    diags: []str
}

pub fn join_diags(diags: []str): str {
    var out = ""
    var i: u64 = 0
    loop {
        if i >= diags.len { break }
        if i > 0 { out = out ~ "\n" }
        out = out ~ diags[i]
        i = i + 1
    }
    out
}

fn assemble_sel(files: []SourceFile, include_tests: bool, report: bool, tty: bool): Assembled | error {
    var merged: []parser::Item = teko::list::empty()
    var diags: []str = teko::list::empty()
    var total = eligible_file_count(files, include_tests)
    var mode = report_mode(!report, tty)
    var lex_phase = phase_begin("lexer", count_unit_text(0, total, "files"), mode)
    var parse_phase = phase_begin("parser", count_unit_text(0, total, "files"), mode)
    var lexed: u64 = 0
    var parsed: u64 = 0
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        var sf = files[i]
        if teko::str::ends_with(sf.path, ".tkt") && !include_tests {
            i = i + 1
            continue
        }
        var src = match teko::io::read_file(sf.path) { str as s => s; error as e => return e }
        var one: []parser::Item = teko::list::empty()
        var ok = true
        match asm_lex_and_parse(sf.path, src) {
            []parser::Item as items => { one = items }
            error as e => {
                diags = teko::list::push(diags, teko::str::concat(sf.path, ":", e.message))
                ok = false
            }
        }
        if !ok {
            i = i + 1
            continue
        }
        lexed = lexed + 1
        parsed = parsed + 1
        phase_tick(lex_phase, count_unit_text(lexed, total, "files"))
        phase_tick(parse_phase, count_unit_text(parsed, total, "files"))
        var k: u64 = 0
        loop {
            if k >= one.len { break }
            merged = teko::list::push(merged, parser::Item { content = one[k].content; namespace = sf.namespace; file = sf.path; guard = one[k].guard })
            k = k + 1
        }
        i = i + 1
    }
    if diags.len > 0 {
        phase_end_fail(lex_phase, count_unit_text(lexed, total, "files"), diags[0])
        phase_end_fail(parse_phase, count_unit_text(parsed, total, "files"), diags[0])
        return Assembled { program = parser::Program { items = merged }; diags = diags }
    }
    phase_end_ok(lex_phase, count_unit_text(lexed, total, "files"))
    phase_end_ok(parse_phase, count_unit_text(parsed, total, "files"))
    Assembled { program = parser::Program { items = merged }; diags = diags }
}

pub type FileOverride = struct {
    path: str
    content: str
}

fn overridden_content(overrides: []FileOverride, path: str): str | null {
    var i: u64 = 0
    loop {
        if i >= overrides.len { break }
        if overrides[i].path == path { return overrides[i].content }
        i = i + 1
    }
    null
}

fn read_source_with_overrides(path: str, overrides: []FileOverride): str | error {
    match overridden_content(overrides, path) {
        str as c => return c
        null => { }
    }
    match teko::io::read_file(path) { str as s => s; error as e => return e }
}

fn append_tagged_items(merged: []parser::Item, items: []parser::Item, sf: SourceFile): []parser::Item {
    var out = merged
    var i: u64 = 0
    loop {
        if i >= items.len { break }
        out = teko::list::push(out, parser::Item { content = items[i].content; namespace = sf.namespace; file = sf.path; guard = items[i].guard })
        i = i + 1
    }
    out
}

pub fn assemble_with_overrides(files: []SourceFile, overrides: []FileOverride): Assembled | error {
    var merged: []parser::Item = teko::list::empty()
    var diags: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        var sf = files[i]
        if teko::str::ends_with(sf.path, ".tkt") {
            i = i + 1
            continue
        }
        var src = match read_source_with_overrides(sf.path, overrides) { str as s => s; error as e => return e }
        match asm_lex_and_parse(sf.path, src) {
            []parser::Item as items => { merged = append_tagged_items(merged, items, sf) }
            error as e => { diags = teko::list::push(diags, teko::str::concat(sf.path, ":", e.message)) }
        }
        i = i + 1
    }
    Assembled { program = parser::Program { items = merged }; diags = diags }
}
