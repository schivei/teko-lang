// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage


/**
 * dwarf_files_of — the unique file names `facts` reference, in first-seen order (the DWARF
 * `.debug_line` file table — index 1 is the primary file, matching the first fact's file).
 *
 * @param facts  the ascending-by-offset facts
 * @return       the unique file names, in first-seen order
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn dwarf_files_of(facts: []DwarfFuncFact) -> []str {
    mut out: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= facts.len { break }
        if dwarf_file_index_of(out, facts[i].file) == 0 { out = teko::list::push(out, facts[i].file) }
        i = i + 1
    }
    out
}

/**
 * dwarf_code_size_of — the `.text` byte length of the function at `facts[i]`: the run to the next
 * function's offset, or to `text_len` for the last one.
 *
 * @param facts     the ascending-by-offset facts
 * @param i         the fact's index
 * @param text_len  the module's total `.text` byte length
 * @return          the function's code size
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn dwarf_code_size_of(facts: []DwarfFuncFact, i: u64, text_len: u64) -> u64 {
    if i + 1 < facts.len { return (facts[i + 1].offset - facts[i].offset) to u64 }
    text_len - (facts[i].offset to u64)
}

/**
 * dwarf_subprograms_of — one `dwarf::DwSubprogram` per fact, in address order, each `code_size`
 * from `dwarf_code_size_of`.
 *
 * @param facts     the ascending-by-offset facts
 * @param files     the unique file table (for `decl_file`)
 * @param text_len  the module's total `.text` byte length
 * @return          the subprograms, in address order
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn dwarf_subprograms_of(facts: []DwarfFuncFact, files: []str, text_len: u64) -> []teko::backend::DwSubprogram {
    mut out: []teko::backend::DwSubprogram = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= facts.len { break }
        let f = facts[i]
        out = teko::list::push(out, teko::backend::DwSubprogram {
            name = f.teko_name
            decl_file = dwarf_file_index_of(files, f.file)
            decl_line = f.line
            symbol = f.symbol
            code_size = dwarf_code_size_of(facts, i, text_len)
        })
        i = i + 1
    }
    out
}

/**
 * dwarf_rows_of — one `dwarf::DwLineRow` per fact, in address order: the first row sits at the
 * line program's `set_address` (`pc_advance = 0`), every later row advances by the gap since the
 * previous fact's offset.
 *
 * @param facts  the ascending-by-offset facts
 * @param files  the unique file table (for each row's `file`)
 * @return       the line rows, in address order
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn dwarf_rows_of(facts: []DwarfFuncFact, files: []str) -> []teko::backend::DwLineRow {
    mut out: []teko::backend::DwLineRow = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= facts.len { break }
        let f = facts[i]
        let advance: u64 = if i == 0 { 0 to u64 } else { (f.offset - facts[i - 1].offset) to u64 }
        out = teko::list::push(out, teko::backend::DwLineRow { pc_advance = advance; line = f.line; file = dwarf_file_index_of(files, f.file) })
        i = i + 1
    }
    out
}

/**
 * build_dwarf_sink_for — assemble the D1.4/D1.5 sink for a `--debug=lines` native build: join the
 * checker's per-function file/line against the encoded module's `.text` symbol offsets by the SAME
 * mangled name both the C and native backends produce (`teko::lir::mangle_fn_symbol`,
 * `cgt_mangle_parity_c_and_native` proves the two agree), sort by address, and hand the result to
 * `dwarf::build_dwarf_sink`. Returns `no_dwarf_sink()` unless `debug == DebugInfo::Lines` (so every
 * other build reaches `emit_elf`/`emit_elf_arm64`/`emit_macho` exactly as before D1.4/D1.5 — the
 * byte-identity FIXPOINT) or the module emits no function at all (nothing to describe). Called ONCE
 * per tail, at the very end of the fused per-item driver (0.3.1 C6.3/C6.4) — after every item's own
 * scoped region has already dropped and the whole module's `EncodedModule(X86)` is assembled, so
 * `symbols`/`text_len` are the ROOT-resident, final values, never a region-local intermediate.
 *
 * @param dir      the project directory (D1.5's design note: `comp_dir` is BEST-EFFORT — the
 *                 project directory as given, not resolved to an absolute path; a wrong `comp_dir`
 *                 makes the debugger resolve the breakpoint but fail to LIST the source, the
 *                 documented non-fatal half-failure, see docs/design/debugger-superficie-e-
 *                 contramedida-0.3.1.md §1.5)
 * @param prog     the checked program (per-function file/line)
 * @param symbols  the encoded module's symbol table (`.text` offsets)
 * @param text_len the module's total `.text` byte length
 * @param debug    the requested `--debug=` level
 * @return         the assembled sink, or the absent one
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn build_dwarf_sink_for(dir: str, prog: checker::TProgram, symbols: []teko::backend::Symbol, text_len: u64, debug: DebugInfo) -> teko::backend::DwarfSink {
    if debug != DebugInfo::Lines { return teko::backend::no_dwarf_sink() }
    let facts = dwarf_sort_by_offset(dwarf_collect_facts(prog, symbols))
    if facts.len == 0 { return teko::backend::no_dwarf_sink() }
    let files = dwarf_files_of(facts)
    let first = facts[0]
    let last = facts[facts.len - 1]
    let cu = teko::backend::DwCompileUnit {
        producer = "teko 0.3.1"
        language = 0x0c to u32
        name = files[0]
        comp_dir = dir
        text_symbol = first.symbol
        text_size = text_len
        subprograms = dwarf_subprograms_of(facts, files, text_len)
    }
    teko::backend::build_dwarf_sink(cu, files, dwarf_rows_of(facts, files), text_len - (last.offset to u64))
}

/**
 * emit_native — the own-AOT-backend driver (the #385 A4-5 KEYSTONE, extended for
 * x86-64 at #386 B1-8 and Windows at #388 B3-4): lower the
 * checked program to target-independent LIR, then dispatch on `native_target()` to
 * the per-ISA tail — arm64 `MInst`/AAPCS64/Mach-O (the macOS-host-default,
 * byte-unchanged A4 path), x86-64 `MInstX86`/SysV/ELF (the B1 path, the linux-host
 * default OR `TEKO_TARGET=x86_64-linux`), or x86-64 `MInstX86`/Win64/PE-COFF (the B3
 * path, the windows-host default OR `TEKO_TARGET=x86_64-windows` — the SAME x86
 * ISA as the Linux path, differing only in the `win64` register file and the
 * `emit_coff` object format). Each tail selects instructions, allocates registers,
 * encodes machine bytes, wraps them in the target object format, writes the `.o`,
 * and links it into a native executable against the C-built `teko_rt`/`assert`
 * runtime via `cc`-as-linker (`link_object`, the D-C bootstrap). Any pipeline
 * pass's NAMED honest-stop (`A4-fp`/`B1-fp`/`B1-args`/…) propagates out unchanged
 * as a `fail`, so an unsupported program stops identically to any other backend
 * diagnostic (M.3 — never a fabricated artifact) and the C-vs-own differential
 * compares at the stop, not a fake value; a SET-but-unrecognized `TEKO_TARGET`
 * fails the SAME honest way (R2, `native_target`'s error arm below). Reached only
 * when `m.backend == Backend::Native` (the resolved backend, `TEKO_BACKEND=native`
 * — the earlier `--backend` CLI flag was removed, owner ruling 2026-07-24); the
 * default C path is untouched. `debug` (D1.4/D1.5) sinks `.debug_abbrev`/`.debug_info`/`.debug_line`
 * into the ELF/Mach-O tails when `DebugInfo::Lines` (`build_dwarf_sink_for`); `DebugInfo::None`
 * (the default) reaches every tail exactly as before D1.4/D1.5, so the emitted object stays
 * byte-identical (the FIXPOINT).
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the build output directory (`-o`, default "bin")
 * @param prog     the checked, typed program
 * @param m        the resolved manifest (link knobs)
 * @param debug    the requested `--debug=` level (D1.4/D1.5)
 * @return         0 on a successful build+link, else the failing status
 *
 * (0.3.1 C6.3/C6.4) No own-backend tail lowers the WHOLE program up front anymore: every one of
 * the four (`emit_native_x86`, `emit_native_win`, `emit_native_arm64`, `emit_native_arm64_linux`)
 * is a FUSED lower+encode driver (`docs/design/native-lowering-oom-por-funcao-0.3.1.md`) that
 * lowers each item inside its own scoped region, so `prog` is handed to each directly instead of a
 * pre-built `LModule`.
 */
fn emit_native(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo) -> i32 {
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    match target {
        NativeTarget::X8664Linux => emit_native_x86(dir, od, stem, prog, m, debug)
        NativeTarget::X8664Windows => emit_native_win(dir, od, stem, prog, m)
        NativeTarget::Arm64Macho => emit_native_arm64(dir, od, stem, prog, m, debug)
        NativeTarget::Arm64Linux => emit_native_arm64_linux(dir, od, stem, prog, m, debug)
    }
}

/**
 * emit_native_arm64 — the arm64/Mach-O own-backend tail (the A4 reference, #385), FUSED lower+encode
 * per item (0.3.1 C6.4, `docs/design/native-lowering-oom-por-funcao-0.3.1.md`): the Mach-O instance
 * of the shared arm64 fused driver (`emit_native_arm64_fused`) — the platform-ABI entry point
 * (`teko::lir::wrap_native_entry`), arm64 isel, AAPCS64 regalloc and arm64 encode all run per item
 * inside their own scoped region, exactly mirroring the x86-linux fusion of C6.3. Only the final
 * object-format call (`teko::backend::emit_macho`) is specific to this tail. `debug` (D1.5) sinks the
 * DWARF sections into the Mach-O object when `DebugInfo::Lines`; `DebugInfo::None` reaches
 * `emit_macho` exactly as before D1.5 (byte-identical).
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param prog  the checked, typed program (lowered item-by-item, not up front — C6.4)
 * @param m     the resolved manifest (link knobs)
 * @param debug the requested `--debug=` level (D1.5)
 * @return      0 on a successful build+link, else the failing status
 * @since 0.3.1 C6.4
 */
fn emit_native_arm64(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo) -> i32 {
    emit_native_arm64_fused(dir, od, stem, prog, m, debug, (enc, dwarf) => teko::backend::emit_macho(enc, dwarf))
}

/**
 * emit_native_arm64_linux — the arm64/Linux-ELF own-backend tail, FUSED lower+encode per item (0.3.1
 * C6.4): the SAME `emit_native_arm64_fused` shared driver as `emit_native_arm64` (platform-ABI entry
 * wrap → arm64 isel → AAPCS64 regalloc → arm64 encode, per item, each in its own scoped region) with
 * the object format swapped from Mach-O to ELF (`teko::backend::emit_elf_arm64`). Exactly ONE call
 * differs, and nothing else may: the two arm64 tails share isel, regalloc, encode AND the fused
 * per-item driver itself, so the arm64-macos differential keeps covering the arm64-linux codegen — a
 * drift between the two tails would silently void that coverage. `debug` (D1.4) sinks the DWARF
 * sections into the ELF object when `DebugInfo::Lines`; `DebugInfo::None` reaches `emit_elf_arm64`
 * exactly as before D1.4 (byte-identical).
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param prog  the checked, typed program (lowered item-by-item, not up front — C6.4)
 * @param m     the resolved manifest (link knobs)
 * @param debug the requested `--debug=` level (D1.4)
 * @return      0 on a successful build+link, else the failing status
 * @since 0.3.1
 */
fn emit_native_arm64_linux(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest, debug: DebugInfo) -> i32 {
    emit_native_arm64_fused(dir, od, stem, prog, m, debug, (enc, dwarf) => teko::backend::emit_elf_arm64(enc, dwarf))
}

/**
 * region_root — the CURRENT TASK's root region as a `u64` handle (`tk_region_root_u`). The parent
 * of every per-function scratch region the fused native emit driver opens; the accumulators the
 * driver copies its per-function outputs into live here (Group B, §2).
 *
 * @return  the root region handle
 * @since 0.3.1
 */
extern fn region_root() -> u64 = "tk_region_root_u" from "teko_rt"

/**
 * region_new — a fresh empty child region of `parent`, as a `u64` handle (`tk_region_new_u`). Reuses
 * the runtime's child-region tree (separate chunk lists — none of `arena_push`'s interleaved-bump
 * trap); the per-function scratch region the fused emit driver bump-allocates its isel/regalloc/
 * encode scratch into, then drops whole.
 *
 * @param parent  the enclosing region handle (`region_root()`)
 * @return        the new child region handle
 * @since 0.3.1
 */
extern fn region_new(parent: u64) -> u64 = "tk_region_new_u" from "teko_rt"

/**
 * region_drop — bulk-free every chunk of `region` (`tk_region_drop_u`). Called AFTER the function's
 * outputs have been copied to the root accumulators, so the freed span holds only dead scratch
 * (LIR mirror, MInst, interval sets, encode buffers).
 *
 * @param region  the child region handle to drop
 * @return        void
 * @since 0.3.1
 */
extern fn region_drop(region: u64) -> void = "tk_region_drop_u" from "teko_rt"

/**
 * region_enter — push `child` as the current region of the task: every default allocation
 * (`list::push` and friends) subsequently bump-allocates in `child` until the matching
 * `region_leave` (`tk_region_enter_u`). The per-scope pair of the native backend for its
 * per-function scratch.
 *
 * @param child  the child region that receives the scratch
 * @return       void
 * @since 0.3.1
 */
extern fn region_enter(child: u64) -> void = "tk_region_enter_u" from "teko_rt"

/**
 * region_leave — pop the current region: default allocation returns to its prior destination (the
 * root, at the top of the loop) (`tk_region_leave`). Called BEFORE copying the function's outputs
 * to the object accumulators and BEFORE the child's `region_drop`.
 *
 * @return  void
 * @since 0.3.1
 */
extern fn region_leave() -> void = "tk_region_leave" from "teko_rt"

/**
 * region_current — the task's CURRENT region as a `u64` handle (`tk_region_current_u`): the region
 * `list::push`/`tk_alloc` bump-allocates from RIGHT NOW — the root when no child window is open, the
 * top-of-stack child while one is. Used ONLY by the `TEKO_NATIVE_REGION_CHECK` diagnostic to assert,
 * after `region_leave()` and before the fused loop's copy-out commits, that the current region really
 * did return to the root (a mismatch is region-stack corruption, the native-region-crash suspect).
 * Binds the SAME frozen runtime symbol (`teko_rt.c:tk_region_current_u`) the C route already ships;
