use teko::checker
use teko::codegen
use teko::lir
use teko::list

// use teko::checker
// use teko::codegen
// use teko::lir
//
// // src/build/project.tks   (namespace 'teko::build')
// //
// // The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// // surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// // the directory resolution in main.c (project_dir_of). main.tks dispatches here:
// //   teko build <dir>  → compile_project  (front-end → native codegen)
// //   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
// //   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
// //
// // FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// // the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// // so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// // `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// // codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// // diverged to is retired, #524).
//
//
// E4, the loose-statement delta E6, the new-lifted count E5), THEN drop the region — bounding the
// Windows native peak to `Σ(bytes) + rodata + ONE item's LIR/scratch`, mirroring the x86-linux
// fusion of C6.3 (the win64 register file — call/return arguments in RCX/RDX/R8/R9 — is the ONLY
// byte-difference from `emit_native_x86`; the x86 ISA itself, and the encoded machine bytes for any
// shared instruction, are identical). The virtual-main lowers and encodes the same way, in its own
// final window, once every item's region has already dropped. The assembled `.text`/rodata/symbols
// are wrapped in a PE/COFF object (`teko::backend::emit_coff`, B3-3) and handed to
// `finish_native_object` (write `.o` + `cc`-link + `.tsym` + success marker) — unchanged past the
// encoder, so the emitted bytes are byte-identical to the pre-fusion module-at-a-time path (only
// WHERE the compiler's own intermediates bump-allocate changes, never their computed values).
// Reached only via `TEKO_TARGET=x86_64-windows`; the emitted `.o` is a Windows
// x86-64 object, so the executing C-vs-own differential runs on a Windows host
// (B3-4), while a non-Windows host still writes the `.o` for the byte /
// well-formedness cross-check (`llvm-readobj` is cross-format) even though the
// host `cc` cannot link a PE there without the MinGW cross toolchain. Takes NO
// `debug` parameter: the COFF DWARF sink is `W0`…`W2` (`docs/design/debugger-
// superficie-e-contramedida-0.3.1.md` §9.4), a separate, still-unstarted crumb
// gated on a Windows-CI-only linker-survival sondagem — out of D1.4/D1.5's
// ELF/Mach-O scope. `emit_native` calls this tail without `debug`, so a
// `--debug=lines` Windows build silently gets no DWARF (same as today).
//
// @param dir   the project directory (for diagnostics)
// @param od    the slash-stripped output directory (already created)
// @param stem  the output artifact name (the manifest `name`)
// @param prog  the checked, typed program (lowered item-by-item, not up front — C6.4)
// @param m     the resolved manifest (link knobs)
// @return      0 on a successful build+link, else the failing status
//
fn emit_native_win(dir: str, od: str, stem: str, prog: checker::TProgram, m: Manifest) -> i32 {
    let prelude = match teko::lir::lower_prelude(prog, false) { teko::lir::LowerPrelude as x => x; error as e => return fail(dir, e.message) }
    mut robase = prelude.module.rodata
    mut loose: []checker::TStatement = teko::list::empty()
    mut lifted_ph: []teko::lir::LFunc = teko::list::empty()
    mut mt = teko::backend::empty_module_text_x86()
    mut i: u64 = 0
    loop {
        if i >= prog.items.len { break }
        let t0 = trace_native_item(i, prog.items.len, prog.items[i])
        let child = region_new(region_root())
        region_enter(child)
        let outcome = fuse_lower_item_win(robase, prelude, loose, prog.items[i], lifted_ph)
        region_leave()
        match outcome {
            FusedItemOut as out => {
                match check_current_region_is_root(native_item_label(i, prog.items.len)) { error as e => return fail(dir, e.message); null => { } }
                mt = fold_encoded_funcs_x86(mt, out.encoded)
                robase = commit_rodata_delta(robase, out.rodata)
                loose = commit_loose(loose, out.loose)
                lifted_ph = extend_lifted_placeholders(lifted_ph, out.new_lifted_count)
                region_drop(child)
                trace_native_item_done(t0)
            }
            error as e => return fail(dir, e.message)
        }
        i++
    }
    let vt0 = trace_native_vmain()
    let vchild = region_new(region_root())
    region_enter(vchild)
    let vmain_outcome = fuse_virtual_main_win(loose, prelude, robase, lifted_ph)
    region_leave()
    match vmain_outcome {
        FusedItemOut as out => {
            match check_current_region_is_root("virtual-main") { error as e => return fail(dir, e.message); null => { } }
            mt = fold_encoded_funcs_x86(mt, out.encoded)
            robase = commit_rodata_delta(robase, out.rodata)
            region_drop(vchild)
            trace_native_item_done(vt0)
            match teko::backend::finish_encoded_module_x86(mt, robase, prelude.module.globals) {
                teko::backend::EncodedModuleX86 as enc => finish_native_object(dir, od, stem, teko::backend::emit_coff(enc), prog, m)
                error as e => fail(dir, e.message)
            }
        }
        error as e => fail(dir, e.message)
    }
}

/**
 * report_object_only — the SUCCESS report of a cross build that stopped at the object: it names the
 * object, the target it is for, and the host that emitted it.
 *
 * IT IS A SUCCESS AND IT SAYS SO, which is the difference between this and a skip. The build produced
 * exactly the artifact a cross build can produce here and the artifact is checkable; nothing was left
 * unverified, so nothing should read as outstanding. The line keeps the EXCLUSIVE `"(own backend)"`
 * marker every own-backend report carries, so a harness keying on it sees the emission it expects.
 *
 * @param dir   the project directory (for diagnostics)
 * @param objp  the emitted object path
 * @param t     the cross target the object was emitted for
 * @return      0 — the build succeeded
 * @since 0.3.1
 */
fn report_object_only(dir: str, objp: str, t: NativeTarget) -> i32 {
    teko::io::println($"teko: {dir}: emitted {objp} for {target_name(t)} (own backend) — not linked on host {target_name(host_default_target_guess())}: the object IS the artifact of a cross build here")
    0
}

/**
 * finish_native_object — the object-format-agnostic tail shared by every own-backend
 * target: write the encoded object bytes to `<od>/<stem>.o`, link it into the target's
 * own executable name (`binary_output_path` — `<od>/<stem>.exe` for a PE target, so the
 * image is launchable by the name it was given) via `cc`-as-linker (`link_object`)
 * against the C-built runtime,
 * write the `.tsym` symbol map beside the binary (best-effort — a write error never
 * fails the build), and print the EXCLUSIVE `"(own backend)"` success marker the
 * differential harness keys on (F1(a)). Factoring it here keeps the arm64, x86 and
 * Windows tails identical past the encoder, so the link paths never drift.
 *
 * A CROSS BUILD STOPS AT THE OBJECT, and that is the artifact it was always claiming. The `.o` is
 * written first, then `build_links_binary` decides: on this host's own target the link runs exactly
 * as before, while for a foreign target with no pinned cross compiler the build reports the object
 * and succeeds — no linker is invoked, because none on this host can honestly link a foreign format
 * and the banned one is not an option (owner 2026-07-29: *"queremos sim Cross compiling quando todos
 * os natives estiverem funcionando, mas não quero saber de mingw"*). Nothing is lost by stopping:
 * a cross artifact could never be RUN here either (`cross_note`), so the object's format was the
 * whole claim, and it stays checkable (`llvm-readobj` reads COFF on any host). The full cross LINK
 * arrives with the project's own linker, after the natives work.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param obj   the encoded object-file bytes (Mach-O, ELF or PE/COFF)
 * @param prog  the checked program (`.tsym` emission)
 * @param m     the resolved manifest (link knobs)
 * @return      0 on a successful write+link (or write, for a cross target), else the failing status
 */
fn finish_native_object(dir: str, od: str, stem: str, obj: []byte, prog: checker::TProgram, m: Manifest) -> i32 {
    let objp = object_output_path(od, stem)
    let target = resolved_target()
    let binp = binary_output_path(od, stem, target)
    match teko::io::write_file_bytes(objp, obj) { error as e => return fail(dir, e.message); null => { } }
    if !build_links_binary(target, m) { return report_object_only(dir, objp, target) }
    if link_object(objp, binp, m, prog) != 0 {
        return fail(dir, "cc failed to link the own-backend object")
    }
    match teko::io::write_file(teko::str::concat(binp, ".tsym"), codegen::tk_emit_tsym(prog)) { error => { }; null => { } }
    teko::io::println(teko::str::concat("teko: ", dir, teko::str::concat(": built ", binp, " (own backend)")))
    0
}

/**
 * emit_static_lib — the `Artifact::Static` (`kind = "static"`) tail (KP16, the
 * kill-C static-archive substrate, `docs/design/kill-c-pull-forward-0.3.0.30.md`
 * §2(b); the Mach-O/COFF lanes ported from the real-toolchain-validated
 * `theory/kp16-ar-macho-coff` branch): own-native ONLY — requires
 * `Backend::Native` (`TEKO_BACKEND=native`), since a static archive wraps an
 * own-emitted `.o`, and the C emitter never produces one. Lowers the checked
 * program to LIR exactly as `emit_native` does, then dispatches on the
 * selected target: the ELF target (`x86_64-linux`)
 * archives its whole-program object via the KP16 GNU-format writer
 * (`teko::backend::emit_static_archive`); `arm64-macos` via the BSD
 * `__.SYMDEF` writer (`emit_static_archive_macho`); `x86_64-windows` via the
 * MS two-linker-member `.lib` writer (`emit_static_archive_coff`). Lowers with `flat_symbols
 * = true` (`teko::lir::mangle_fn_symbol`'s carve-out): the archive itself IS
 * the published C contract — there is no separate wrapper the way the C
 * backend's `abi = "c"` reverse-FFI export has — so every function's LIR
 * symbol must be the BARE mangle (`<ns>__<name>`), never `TEKO_USER_PREFIX`-
 * decorated, or a real consumer's `extern` declaration fails to link (measured:
 * `examples/toolchain/ar_link_run` published `teko_ar_link_run__add` where the
 * archive contract is `ar_link_run__add`). `lower_program`
 * unconditionally synthesizes a virtual `int main()` from the project's loose
 * top-level statements (`emit_native`'s entry point for a `binary` artifact)
 * — a library has none of its own, but `lower_program` is shared with the
 * binary path and always appends the (trivial, `return 0`) synthesized one
 * regardless, so it is stripped here (`strip_virtual_main`) BEFORE any target
 * tail runs: a `static` artifact must never export a bare `main` symbol for a
 * real consumer's own `main` to collide with (found by the theory branch's
 * real link+run validation, a gap `ar`/`nm`/`ld -r`-only checking never
 * caught).
 *
 * @param dir      the project directory (for diagnostics)
 * @param stem     the output artifact name (the manifest `name`)
 * @param out_dir  the build output directory (`-o`, default "bin")
 * @param prog     the checked, typed program
 * @param m        the resolved manifest
 * @return         0 on a successful build+archive, else the failing status
 */
fn emit_static_lib(dir: str, stem: str, out_dir: str, prog: checker::TProgram, m: Manifest) -> i32 {
    if m.backend != Backend::Native {
        return fail(dir, "static library output (.a) needs the own-native backend (TEKO_BACKEND=native) — the C emitter never produces a `.o` to archive")
    }
    let od = strip_trailing_slash(out_dir)
    match teko::fs::mkdir(od) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let raw_lmod = match teko::lir::lower_program(prog, true) { teko::lir::LModule as x => x; error as e => return fail(dir, e.message) }
    let lmod = strip_virtual_main(raw_lmod)
    let target = match native_target() { NativeTarget as t => t; error as e => return fail(dir, e.message) }
    match target {
        NativeTarget::X8664Linux => emit_static_lib_x86(dir, od, stem, lmod)
        NativeTarget::Arm64Macho => emit_static_lib_macho(dir, od, stem, lmod)
        NativeTarget::Arm64Linux => emit_static_lib_arm64_linux(dir, od, stem, lmod)
        NativeTarget::X8664Windows => emit_static_lib_coff(dir, od, stem, lmod)
    }
}

/**
 * strip_virtual_main — `lmod` with the synthesized virtual `main` `LFunc`
 * removed (identified by its exact, un-namespaced `"main"` symbol —
 * `lower_virtual_main` builds it via `new_func("main", ...)` directly,
 * bypassing `mangle_fn_symbol`, so a real user function can never collide
 * with this exact bare name: any root-level `pub`/`exp fn main` mangles to
 * `<project>__main` instead). Every OTHER field (`rodata`/`globals`/
 * `layouts`) passes through unchanged; only `funcs` is filtered.
 *
 * @param lmod  the freshly lowered module (still carrying the virtual main)
 * @return      the same module with the virtual main's `LFunc` dropped
 */
fn strip_virtual_main(lmod: teko::lir::LModule) -> teko::lir::LModule {
    mut kept: []teko::lir::LFunc = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= lmod.funcs.len { break }
        if lmod.funcs[i].symbol != "main" { kept = teko::list::push(kept, lmod.funcs[i]) }
        i++
    }
    teko::lir::LModule { funcs = kept; rodata = lmod.rodata; globals = lmod.globals; layouts = lmod.layouts }
}

/**
 * emit_static_lib_x86 — the x86-64/ELF static-archive tail: select, allocate,
 * and encode exactly as `emit_native_x86` does, then hand the encoded module's
 * object bytes AND its neutral symbol list (for the archive's exported-symbol
 * index) to `finish_static_archive` in place of `finish_native_object`'s cc-link.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 */
fn emit_static_lib_x86(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module_x86(teko::backend::SYSV64, lmod) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module_x86(teko::backend::SYSV64, sel) { teko::backend::MModuleX86 as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module_x86(teko::backend::SYSV64, col) { teko::backend::EncodedModuleX86 as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_elf(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Gnu)
}

/**
 * emit_static_lib_macho — the arm64/Mach-O static-archive tail: select,
 * allocate, and encode exactly as `emit_native_arm64` does, then hand the
 * encoded module's Mach-O object bytes AND its neutral symbol list to
 * `finish_static_archive` under the BSD `__.SYMDEF` archive format.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 */
fn emit_static_lib_macho(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module(lmod) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_macho(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Bsd)
}
