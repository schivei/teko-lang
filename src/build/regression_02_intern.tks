/**
 * NO_MEM_CAP — the job count `mem_job_cap_at` answers when memory cannot be measured
 * (unreadable path, or a `MemAvailable:` line this parser does not recognise): a value no
 * real `nproc_rt()` will ever reach, so `os_max_of` picks the CPU count untouched — the
 * governor abstains rather than guesses.
 */
const NO_MEM_CAP: u64 = 1000000

/**
 * mem_available_kib — the kB value `content`'s `MemAvailable:` line names, or 0 when the
 * line is absent or carries no digit after it.
 *
 * PURE: takes the file's text rather than reading it itself, so the parser is testable
 * against a synthetic string with no filesystem and no platform dependency.
 *
 * @param content  the whole text of `/proc/meminfo` (or any string to probe the parser)
 * @return         the kB `MemAvailable:` names, or 0
 * @since 0.3.1
 */
fn mem_available_kib(content: str) -> u64 {
    let at = mem_label_end(content, MEM_AVAILABLE_LABEL)
    if at >= content.len { return 0 }
    mut i = at
    loop {
        if i >= content.len { break }
        if content[i] != b' ' { break }
        i = i + 1
    }
    mut v: u64 = 0
    mut seen = false
    loop {
        if i >= content.len { break }
        let c = content[i]
        if c < b'0' || c > b'9' { break }
        v = (v * 10) + ((c to u64) - (b'0' to u64))
        seen = true
        i = i + 1
    }
    if !seen { return 0 }
    v
}

/**
 * mem_label_end — the index right after the first occurrence of `label` in `content`, or
 * `content.len` when `label` does not occur (the "not found" sentinel `mem_available_kib`
 * checks for).
 *
 * @param content  the text to scan
 * @param label    the literal substring to find
 * @return         the index just past `label`'s first occurrence, or `content.len`
 * @since 0.3.1
 */
fn mem_label_end(content: str, label: str) -> u64 {
    if label.len == 0 || label.len > content.len { return content.len }
    mut i: u64 = 0
    let last = content.len - label.len
    loop {
        if i > last { return content.len }
        if teko::str::slice(content, i, i + label.len) == label { return i + label.len }
        i = i + 1
    }
}

/**
 * mem_job_cap_at — how many concurrent `MEM_PER_JOB_KIB`-sized children `path`'s available
 * memory can budget for, or `NO_MEM_CAP` when `path` cannot be read or its content names no
 * usable `MemAvailable:` figure.
 *
 * PARAMETERISED BY PATH so the whole governor is testable with a real scratch file the test
 * writes (a synthetic `/proc/meminfo`) and with a path that does not exist at all — no
 * platform detection is needed to exercise every branch.
 *
 * @param path  the meminfo-shaped file to read (`MEMINFO_PATH` in production)
 * @return      the memory-budgeted job count (>= 1), or `NO_MEM_CAP`
 * @since 0.3.1
 */
fn mem_job_cap_at(path: str) -> u64 {
    let content = match teko::io::read_file(path) { str as s => s; error => return NO_MEM_CAP }
    let avail = mem_available_kib(content)
    if avail == 0 { return NO_MEM_CAP }
    let cap = avail / MEM_PER_JOB_KIB
    if cap < 1 { return 1 }
    cap
}

/**
 * mem_job_cap — `mem_job_cap_at(MEMINFO_PATH)`, the production reading of this host's
 * memory-budgeted job count.
 *
 * @return  the memory-budgeted job count (>= 1), or `NO_MEM_CAP` when unmeasurable
 * @since 0.3.1
 */
fn mem_job_cap() -> u64 { mem_job_cap_at(MEMINFO_PATH) }

/**
 * os_max_of — the effective job count for a machine reporting `cpu` processors and a
 * memory budget for `mem` concurrent children: whichever is SMALLER, because either one
 * alone is a real ceiling this run must not cross.
 *
 * PURE, so the two governors (CPU count, memory budget) are each tested through their own
 * seam and this composition is tested directly against synthetic numbers, with no
 * dependency on the host's real hardware.
 *
 * @param cpu  the OS-granted processor count (`nproc_rt()`)
 * @param mem  the memory-budgeted job count (`mem_job_cap()`), or `NO_MEM_CAP` to abstain
 * @return     `min(cpu, mem)`
 * @since 0.3.1
 */
fn os_max_of(cpu: u64, mem: u64) -> u64 { if mem < cpu { mem } else { cpu } }

/**
 * os_max — the effective default/cap job count (>= 1): BOTH the default job count when a
 * run names no number AND the cap an explicit `TEKO_*_JOBS` is clamped to (E1-C6). The
 * SMALLER of what the OS grants in processors (`nproc_rt`) and what this host's AVAILABLE
 * memory budgets at `MEM_PER_JOB_KIB` per child (`mem_job_cap`) — added because the
 * CPU-only default let a test/regression job pool size itself past the runner's real
 * memory ceiling: `TEKO_TEST_JOBS`'s default sharded every run 4-way on a 4-core CI runner
 * with no regard for how much memory four concurrent heavy children actually had to share,
 * and that is precisely the shape that was observed OOMing (SIGTERM/exit 143 mid-run) under
 * the native self-host lane. Neither governor alone decided the old behaviour; the pair
 * does now. On a host `/proc/meminfo` cannot answer (non-Linux), this is byte-for-byte the
 * old CPU-only value — the governor never raises concurrency, only lowers it under real
 * pressure, and abstains rather than guesses when it cannot measure that pressure at all.
 *
 * @return the effective job count, at least 1
 * @since 0.3.1.0
 */
fn os_max() -> u64 { os_max_of(nproc_rt(), mem_job_cap()) }

/**
 * clamp_jobs — a requested job count confined to `[1, os_max()]`: the low bound keeps a run from
 * asking for zero children, the high bound keeps an env override from exceeding the OS-granted
 * parallelism (E1-C6). The default path never needs it (`os_max()` is already in range); it guards
 * the ONE untrusted input, the `TEKO_*_JOBS` value a run wrote.
 *
 * @param v  the requested count (already parsed)
 * @return   `v` clamped into `[1, os_max()]`
 * @since 0.3.1.0
 */
fn clamp_jobs(v: u64) -> u64 {
    let m = os_max()
    if v < 1 { return 1 }
    if v > m { return m }
    v
}

/** REGR_JOBS_ENV — the env key a run overrides the OS-granted default through (12-Factor: the
    concurrency of the machine is the machine's business, not the source's), clamped to `[1, os_max()]`. */
const REGR_JOBS_ENV: str = "TEKO_REGR_JOBS"

/**
 * regr_jobs_of — parse a `TEKO_REGR_JOBS` value into a job count, falling back to the OS-granted
 * default for anything that is not a positive decimal number. A malformed value is a CONFIGURATION
 * mistake, and the safe reading of one is "the author did not mean zero children".
 *
 * @param raw  the env value as written
 * @return     the parsed count, or `os_max()` when it is empty, non-numeric or zero
 * @since 0.3.1
 */
fn regr_jobs_of(raw: str) -> u64 { regr_jobs_of_default(raw, os_max()) }

/**
 * regr_jobs_of_default — the job-count parser with the FALLBACK named by the caller, so the test
 * gate's own concurrency knob (`project.tks::test_jobs`) reuses this one parser instead of growing a
 * second decimal scanner with its own idea of what a malformed value means.
 *
 * @param raw       the env value as written
 * @param fallback  the count to answer for an empty, non-numeric or zero value
 * @return          the parsed count, or `fallback`
 * @since 0.3.1.2
 */
fn regr_jobs_of_default(raw: str, fallback: u64) -> u64 {
    mut v: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= raw.len { break }
        let c = raw[i]
        if c < b'0' { return fallback }
        if c > b'9' { return fallback }
        v = (v * 10) + ((c to u64) - (b'0' to u64))
        i = i + 1
    }
    if v == 0 { return fallback }
    v
}

/**
 * regr_jobs — how many captured children this run may have in flight at once.
 *
 * @return the effective job count
 * @since 0.3.1
 */
fn regr_jobs() -> u64 {
    match teko::env::var(REGR_JOBS_ENV) { str as v => clamp_jobs(regr_jobs_of(v)); error => os_max() }
}

/**
 * pool_window — the number of children `run_pool` may hold in flight at once for `n` specs and a
 * requested `jobs`: never 0 (a 0/malformed `jobs` would silently launch nothing), and never more
 * than `n` (an oversized window is a no-op, not a bug, but reading it back would misreport how many
 * children are actually running).
 *
 * @param n     how many specs there are
 * @param jobs  the requested degree of parallelism
 * @return      the effective window, in `1..=n`
 */
fn pool_window(n: u64, jobs: u64) -> u64 {
    if jobs < 1 { return 1 }
    if jobs > n { return n }
    jobs
}

/**
 * regr_now_ns — the monotonic clock reading every measurement here subtracts. NEVER a wall clock: a
 * wall-clock jump would produce a negative or absurd interval, and the readings are only ever used
 * as differences.
 *
 * @return the monotonic nanosecond reading
 * @since 0.3.1
 */
fn regr_now_ns() -> i64 {
    teko::time::span_monotonic_now().ticks
}
