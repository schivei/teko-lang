/**
 * dwarf_file_index_of — the 1-based index of `name` in `files`, or 0 when absent (the DWARF
 * file-table convention `dwarf::DwLineRow.file`/`DwSubprogram.decl_file` expect).
 *
 * @param files  the file-table names, in table order
 * @param name   the file name to find
 * @return       the 1-based index, or 0 when absent
 * @since 0.3.1 debugger piso, D1.4/D1.5
 */
fn dwarf_file_index_of(files: []str, name: str) -> i64 {
    mut i: u64 = 0
    loop {
        if i >= files.len { break }
        if files[i] == name { return (i to i64) + 1 }
        i = i + 1
    }
    0
}
