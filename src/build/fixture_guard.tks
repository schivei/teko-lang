/**
 * src/build/fixture_guard.tks   (namespace `teko::build`)
 *
 * THE GUARD THAT WOULD HAVE CAUGHT THE DAMAGE AT THE DRAIN INSTEAD OF IN SEVEN CI LEGS.
 *
 * Measured, 2026-07-30: two forward merges resolved a conflict on the boundary of their own hunks by
 * dropping the four lines `    0` / `}` / blank / the next doc-comment's opening fence. Across seven
 * splice points that cost SIX function bodies their closing brace and SEVEN doc-comments their fence
 * in `examples/regressions/own_native/src/corpus.tks`, so the file stopped LEXING
 * (`3710:18: unexpected character`) and contributed no declarations at all — and the channel then
 * reported 119 consequent `unknown function: f_*` lines against `main.tks`. Three readers of that CI
 * log in a row diagnosed something the build had never said, because nothing in the pipeline could
 * say "this fixture file is structurally broken"; it could only say what broke downstream of it.
 *
 * A splice like that is invisible to review (both sides of the seam are legitimate lines) and
 * invisible to the compiler until a channel runs, which is why the check belongs HERE, in the unit
 * tier every lane pays for before it ever builds a fixture:
 *
 *   · every hand-written `.tks`/`.tkt` closes every block it opens (`source_structure_defect`);
 *   · no top-level doc-comment opens inside an unclosed block (the exact fingerprint of the splice);
 *   · a fixture's helper calls all resolve to a declaration (`undeclared_helper_calls`);
 *   · a fixture's declaration count never DROPS (`count_declared_fns` against a pinned floor).
 *
 * The scanners are line-oriented and delegate the literal/comment bookkeeping to
 * `snippet_brace_delta`, so a brace inside a string, a byte literal, a `//` line comment or a Javadoc
 * block is never miscounted — which is the whole reason this can be a cheap textual pass instead of
 * a second parser.
 */

/**
 * SourceStructure — the structural verdict on ONE hand-written Teko source: what the brace depth was
 * at end-of-file, and where the first orphan top-level doc-comment sits.
 *
 * @since 0.3.1
 */
type SourceStructure = struct {
    /** the `{`/`}` nesting depth left at end-of-file — 0 for a well-formed source, positive when a block never closed, negative when one closed too often. */
    depth: i64
    /** the 1-based line of the FIRST column-0 doc-comment seen at non-zero depth (0 when there is none) — the fingerprint of a merge that spliced two hunks together. */
    orphan_doc_line: u64
}

/**
 * line_end_at — the index of the newline ending the line that starts at `from`, or `text.len` when
 * that line is the last and unterminated.
 *
 * @param text  the whole source text
 * @param from  the index of the line's first byte
 * @return      the index one past the line's last byte
 * @since 0.3.1
 */
fn line_end_at(text: str, from: u64): u64 {
    var k = from
    loop {
        if k >= text.len { break }
        if text[k] == b'\n' { break }
        k = k + 1
    }
    k
}

/**
 * doc_fence_closes_on_line — does a doc-comment block that opens on `line` also close on it? A
 * one-line doc-comment carries its own closing fence and needs no multi-line skip; anything else
 * leaves the block open for the caller to carry into the next line.
 *
 * @param line  the line opening the block
 * @return      true when the line carries its own closing fence
 * @since 0.3.1
 */
fn doc_fence_closes_on_line(line: str): bool {
    teko::str::contains(line, "*" ~ "/")
}

/**
 * scan_source_structure — walk `text` line by line and report its structural verdict
 * (`SourceStructure`). A doc-comment block is skipped whole (its prose may hold anything); every
 * other line's braces are counted outside literals and comments by `snippet_brace_delta`, whose
 * open-literal and open-block-comment state is threaded across lines.
 *
 * ONLY A COLUMN-0 DOC-COMMENT COUNTS AS ORPHAN, and that exclusion is load-bearing: a struct field's
 * own Javadoc legitimately sits at depth 1, so keying the check on indentation is what tells a field
 * doc apart from a top-level declaration doc that a splice left stranded inside a function body.
 *
 * @param text  the whole source text
 * @return      the depth left at end-of-file and the first orphan doc-comment line
 * @since 0.3.1
 */
fn scan_source_structure(text: str): SourceStructure {
    var depth: i64 = 0
    var orphan: u64 = 0
    var in_str = false
    var in_comment = false
    var cur: u64 = 0
    var lineno: u64 = 0
    loop {
        if cur >= text.len { break }
        var eol = line_end_at(text, cur)
        var line = teko::str::slice(text, cur, eol)
        lineno = lineno + 1
        cur = if eol < text.len { eol + 1 } else { eol }
        if in_comment || in_str {
            var carry = snippet_brace_delta(line, in_str, in_comment)
            depth = depth + carry.delta
            in_str = carry.in_str
            in_comment = carry.in_comment
            continue
        }
        if mf_starts_with(tkr_trim(line), "/**") {
            if depth != 0 && orphan == 0 && mf_starts_with(line, "/**") { orphan = lineno }
            in_comment = !doc_fence_closes_on_line(line)
            continue
        }
        var scan = snippet_brace_delta(line, in_str, in_comment)
        depth = depth + scan.delta
        in_str = scan.in_str
        in_comment = scan.in_comment
    }
    SourceStructure { depth = depth; orphan_doc_line = orphan }
}

/**
 * source_structure_defect — the one-line complaint about `path`'s structure, or "" when it is sound.
 * An unreadable file is reported too: a guard that silently passes over what it could not read is
 * worth nothing.
 *
 * @param path  the `.tks`/`.tkt` file to inspect
 * @return      the complaint naming the file and the offending line, or "" when sound
 * @since 0.3.1
 */
fn source_structure_defect(path: str): str {
    var text = match teko::io::read_file(path) { str as s => s; error as e => return $"{path}: unreadable ({e.message})" }
    var st = scan_source_structure(text)
    if st.orphan_doc_line > 0 { return $"{path}:{st.orphan_doc_line}: a top-level doc-comment opens inside an unclosed block — a merge spliced two hunks here" }
    if st.depth != 0 { return $"{path}: brace depth {st.depth} at end-of-file — a block was never closed" }
    ""
}

/**
 * is_teko_source — does `name` end in one of the two hand-written Teko source extensions this guard
 * inspects?
 *
 * @param name  a file name or path
 * @return      true for a `.tks` or `.tkt` file
 * @since 0.3.1
 */
fn is_teko_source(name: str): bool {
    teko::str::ends_with(name, ".tks") || teko::str::ends_with(name, ".tkt")
}

/**
 * collect_teko_sources — every `.tks`/`.tkt` file under `dir`, recursively. A directory that cannot
 * be listed contributes nothing rather than aborting the walk (the same tolerance
 * `collect_tkcov_files` uses, and for the same reason: a scratch tree may vanish mid-walk).
 *
 * @param dir  the directory to walk
 * @return     the paths found, in the order the walk met them
 * @since 0.3.1
 */
fn collect_teko_sources(dir: str): []str {
    var out: []str = teko::list::empty()
    var entries = match teko::fs::list_dir(dir) { []str as e => e; error => return out }
    var i: u64 = 0
    loop {
        if i >= entries.len { break }
        var full = dir ~ "/" ~ entries[i]
        match teko::fs::list_dir(full) {
            []str => {
                var sub = collect_teko_sources(full)
                var si: u64 = 0
                loop { if si >= sub.len { break }; out = teko::list::push(out, sub[si]); si = si + 1 }
            }
            error => { if is_teko_source(full) { out = teko::list::push(out, full) } }
        }
        i = i + 1
    }
    out
}

/**
 * structural_defects_under — the complaints about every hand-written Teko source under `dir`
 * (`source_structure_defect`), empty when the whole subtree is sound.
 *
 * @param dir  the directory to walk
 * @return     one complaint per defective file
 * @since 0.3.1
 */
fn structural_defects_under(dir: str): []str {
    var files = collect_teko_sources(dir)
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        var defect = source_structure_defect(files[i])
        if defect.len > 0 { out = teko::list::push(out, defect) }
        i = i + 1
    }
    out
}

/**
 * ident_end_at — the index one past the identifier starting at `from` in `text` (`from` itself when
 * no identifier byte is there). The identifier-continue class is the lexer's own
 * (`is_ident_byte`, `src/build/init.tks`) — a guard that carried its own copy would be a second
 * source of truth about what an identifier is.
 *
 * @param text  the text to read
 * @param from  the index of the identifier's first byte
 * @return      the index one past the identifier
 * @since 0.3.1
 */
fn ident_end_at(text: str, from: u64): u64 {
    var k = from
    loop {
        if k >= text.len { break }
        if !is_ident_byte(text[k]) { break }
        k = k + 1
    }
    k
}

/**
 * list_has_str — is `needle` already in `xs`?
 *
 * @param xs      the list to search
 * @param needle  the string to look for
 * @return        true when present
 * @since 0.3.1
 */
fn list_has_str(xs: []str, needle: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i = i + 1
    }
    false
}

/**
 * called_names_with_prefix — every distinct identifier in `text` that starts with `prefix` and is
 * immediately followed by `(`, i.e. every name the text CALLS. Purely textual on purpose: this guard
 * runs before any parse and its job is to notice that a name has no declaration at all.
 *
 * @param text    the text to scan
 * @param prefix  the family prefix a fixture's helpers share (e.g. `f_`)
 * @return        the distinct called names, in first-seen order
 * @since 0.3.1
 */
fn called_names_with_prefix(text: str, prefix: str): []str {
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= text.len { break }
        if i > 0 && is_ident_byte(text[i - 1]) { i = i + 1; continue }
        var end = ident_end_at(text, i)
        if end == i { i = i + 1; continue }
        var name = teko::str::slice(text, i, end)
        var called = end < text.len && text[end] == b'('
        if called && mf_starts_with(name, prefix) && !list_has_str(out, name) { out = teko::list::push(out, name) }
        i = end
    }
    out
}

/**
 * declared_fn_name_on_line — the name a top-level `fn`/`pub fn` declaration line declares, or "" when
 * `line` is not one.
 *
 * @param line  one source line
 * @return      the declared function's name, or ""
 * @since 0.3.1
 */
fn declared_fn_name_on_line(line: str): str {
    var at: u64 = 0
    if mf_starts_with(line, "fn ") { at = 3 }
    if mf_starts_with(line, "pub fn ") { at = 7 }
    if at == 0 { return "" }
    var end = ident_end_at(line, at)
    teko::str::slice(line, at, end)
}

/**
 * declared_fn_names — every top-level function `text` declares, in declaration order. COLUMN 0 ONLY,
 * and the rule matters because it is the rule a pinned count is compared against: a method inside a
 * `class` body is not a free function and could never answer a bare call.
 *
 * @param text  the source text to scan
 * @return      the declared names
 * @since 0.3.1
 */
fn declared_fn_names(text: str): []str {
    var out: []str = teko::list::empty()
    var cur: u64 = 0
    loop {
        if cur >= text.len { break }
        var eol = line_end_at(text, cur)
        var name = declared_fn_name_on_line(teko::str::slice(text, cur, eol))
        if name.len > 0 { out = teko::list::push(out, name) }
        cur = if eol < text.len { eol + 1 } else { eol }
    }
    out
}

/**
 * count_declared_fns — how many top-level functions `text` declares (`declared_fn_names`). The
 * measure a fixture pins a FLOOR against, so a merge that eats declarations is caught by the count
 * even when what it ate happened to leave the braces balanced.
 *
 * @param text  the source text to scan
 * @return      the number of top-level function declarations
 * @since 0.3.1
 */
fn count_declared_fns(text: str): u64 {
    declared_fn_names(text).len
}

/**
 * undeclared_helper_calls — every `prefix`-family name `caller_text` calls that `decl_text` does not
 * declare. The DIRECT form of the question the 119-line cascade answered indirectly.
 *
 * @param caller_text  the text doing the calling (a fixture's `main.tks`)
 * @param decl_text    the text expected to declare them (its corpus module)
 * @param prefix       the family prefix (e.g. `f_`)
 * @return             the unresolved names, in first-seen order
 * @since 0.3.1
 */
fn undeclared_helper_calls(caller_text: str, decl_text: str, prefix: str): []str {
    var called = called_names_with_prefix(caller_text, prefix)
    var declared = declared_fn_names(decl_text)
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= called.len { break }
        if !list_has_str(declared, called[i]) { out = teko::list::push(out, called[i]) }
        i = i + 1
    }
    out
}

/**
 * CodeScan — one source line with every string literal, char literal and comment blanked out, plus
 * the literal/comment state to thread into the next line.
 *
 * @since 0.3.1
 */
type CodeScan = struct {
    /** the line with literal and comment bytes replaced by spaces, so braces and `;` inside them cannot be mistaken for code. */
    text: str
    /** true when a string/char literal is still open at end-of-line. */
    in_str: bool
    /** true when a block comment is still open at end-of-line. */
    in_comment: bool
}

/**
 * code_only_line — blank out every string literal, char literal and comment byte of `line`, keeping
 * its length so a column never shifts. The state parameters carry an unterminated literal or an open
 * block comment in from the previous line, and the result carries them out to the next.
 *
 * @param line        the raw source line
 * @param in_str      true when a literal was still open at the end of the previous line
 * @param in_comment  true when a block comment was still open at the end of the previous line
 * @return            the blanked line and the state to thread onward
 * @since 0.3.1
 */
fn code_only_line(line: str, in_str: bool, in_comment: bool): CodeScan {
    var out = ""
    var k: u64 = 0
    var open = in_str
    var comment = in_comment
    var quote: byte = b'"'
    loop {
        if k >= line.len { break }
        var c = line[k]
        if comment {
            if c == b'*' && k + 1 < line.len && line[k + 1] == b'/' { comment = false; out = out ~ "  "; k = k + 2; continue }
            out = out ~ " "
            k = k + 1
            continue
        }
        if open {
            if c == b'\\' && k + 1 < line.len { out = out ~ "  "; k = k + 2; continue }
            if c == quote { open = false }
            out = out ~ " "
            k = k + 1
            continue
        }
        if c == b'/' && k + 1 < line.len && line[k + 1] == b'/' { break }
        if c == b'/' && k + 1 < line.len && line[k + 1] == b'*' { comment = true; out = out ~ "  "; k = k + 2; continue }
        if c == b'"' || c == b'\'' { open = true; quote = c; out = out ~ " "; k = k + 1; continue }
        out = out ~ teko::str::slice(line, k, k + 1)
        k = k + 1
    }
    CodeScan { text = out; in_str = open; in_comment = comment }
}

/**
 * code_only_text — `code_only_line` applied to every line of `text`, rejoined with newlines so line
 * numbers and the nesting of braces are preserved while nothing inside a literal or a comment can be
 * read as code.
 *
 * @param text  the whole source text
 * @return      the blanked text, line for line
 * @since 0.3.1
 */
fn code_only_text(text: str): str {
    var out = ""
    var cur: u64 = 0
    var first = true
    var open = false
    var comment = false
    loop {
        if cur >= text.len { break }
        var eol = line_end_at(text, cur)
        var scan = code_only_line(teko::str::slice(text, cur, eol), open, comment)
        open = scan.in_str
        comment = scan.in_comment
        if !first { out = out ~ "\n" }
        out = out ~ scan.text
        first = false
        cur = if eol < text.len { eol + 1 } else { eol }
    }
    out
}

/**
 * is_decimal_byte — is `b` one of the ten decimal digits?
 *
 * @param b  the byte to classify
 * @return   true for `0`..`9`
 * @since 0.3.1
 */
fn is_decimal_byte(b: byte): bool {
    b >= b'0' && b <= b'9'
}

/**
 * is_bare_number — is `s` a NUMERIC LITERAL AND NOTHING ELSE (an optional sign, decimal digits,
 * digit separators and at most one fraction point)? This is the shape whose type the checker defaults
 * — `i64` for an integer, `f64` for a fraction — and therefore the shape that splits a `match` join
 * on a seed that does not cross-adopt it into a concrete sibling.
 *
 * @param s  the arm's trailing value text, already trimmed
 * @return   true when `s` is a bare numeric literal
 * @since 0.3.1
 */
fn is_bare_number(s: str): bool {
    if s.len == 0 { return false }
    var k: u64 = 0
    if s[0] == b'-' { k = 1 }
    var digits: u64 = 0
    var dots: u64 = 0
    loop {
        if k >= s.len { break }
        var c = s[k]
        if is_decimal_byte(c) { digits = digits + 1; k = k + 1; continue }
        if c == b'_' { k = k + 1; continue }
        if c == b'.' && dots == 0 { dots = 1; k = k + 1; continue }
        return false
    }
    digits > 0
}

/**
 * ends_with_narrowing_cast — does `s` end in a cast to a numeric width a bare literal does NOT
 * default to? Such an arm is the CONCRETE ANCHOR a bare-literal sibling would have to be
 * cross-adopted into. A bare integer literal defaults to `i64` and a bare float literal to `f64`, so
 * `to i64` and `to f64` already AGREE with a bare-literal sibling and are deliberately absent here:
 * only a narrower (or differently-signed) anchor splits the join.
 *
 * @param s  the arm's trailing value text, already trimmed
 * @return   true when the value ends in a narrowing numeric cast
 * @since 0.3.1
 */
fn ends_with_narrowing_cast(s: str): bool {
    if teko::str::ends_with(s, " to i8") { return true }
    if teko::str::ends_with(s, " to i16") { return true }
    if teko::str::ends_with(s, " to i32") { return true }
    if teko::str::ends_with(s, " to u8") { return true }
    if teko::str::ends_with(s, " to u16") { return true }
    if teko::str::ends_with(s, " to u32") { return true }
    if teko::str::ends_with(s, " to u64") { return true }
    if teko::str::ends_with(s, " to f32") { return true }
    teko::str::ends_with(s, " to byte")
}

/**
 * arrow_index — the index of the first `=>` in `s`, or `s.len` when there is none.
 *
 * @param s  the text to search
 * @return   the index of the arrow's `=`, or `s.len`
 * @since 0.3.1
 */
fn arrow_index(s: str): u64 {
    var k: u64 = 0
    loop {
        if k + 1 >= s.len { break }
        if s[k] == b'=' && s[k + 1] == b'>' { return k }
        k = k + 1
    }
    s.len
}

/**
 * match_arm_values — the trailing VALUE text of every arm in a `match` body, split at nesting depth
 * zero on `;` and on newlines (the two arm separators the language allows). A nested `match` inside an
 * arm sits at depth one or deeper, so it is never split apart and is reported as its own arm's value —
 * which is neither a bare literal nor a narrowing cast, so it simply does not participate.
 *
 * @param body  the text BETWEEN the match's braces, already blanked by `code_only_text`
 * @return      one trimmed value per arm, in source order
 * @since 0.3.1
 */
fn match_arm_values(body: str): []str {
    var out: []str = teko::list::empty()
    var depth: i64 = 0
    var cur = ""
    var k: u64 = 0
    loop {
        if k > body.len { break }
        var at_end = k == body.len
        var c = if at_end { b'\n' } else { body[k] }
        if c == b'(' || c == b'[' || c == b'{' { depth = depth + 1 }
        if c == b')' || c == b']' || c == b'}' { depth = depth - 1 }
        if depth == 0 && (c == b';' || c == b'\n') {
            var arrow = arrow_index(cur)
            if arrow < cur.len { out = teko::list::push(out, tkr_trim(teko::str::slice(cur, arrow + 2, cur.len))) }
            cur = ""
            k = k + 1
            continue
        }
        if !at_end { cur = cur ~ teko::str::slice(body, k, k + 1) }
        k = k + 1
    }
    out
}

/**
 * seed_hostile_match_body — does this `match` body MIX a bare numeric literal arm with an arm whose
 * value is a narrowing numeric cast? That mixture is the one shape a compiler without match-arm
 * literal cross-adoption types as a UNION (`i32 | i64`) instead of the anchor's width, which is how
 * `stage_rc_of_env` came to be unbuildable by the published seed. A DIVERGING arm (`… => return …`)
 * contributes no value to the join and is skipped.
 *
 * @param body  the text BETWEEN the match's braces, already blanked by `code_only_text`
 * @return      true when the body mixes a bare literal with a narrowing-cast anchor
 * @since 0.3.1
 */
fn seed_hostile_match_body(body: str): bool {
    var vals = match_arm_values(body)
    var bare: u64 = 0
    var anchors: u64 = 0
    var i: u64 = 0
    loop {
        if i >= vals.len { break }
        var v = vals[i]
        i = i + 1
        if mf_starts_with(v, "return") { continue }
        if is_bare_number(v) { bare = bare + 1; continue }
        if ends_with_narrowing_cast(v) { anchors = anchors + 1 }
    }
    bare > 0 && anchors > 0
}

/**
 * match_keyword_at — does a `match` KEYWORD (not the tail of a longer identifier) start at `i`?
 *
 * @param code  the blanked source text
 * @param i     the candidate start index
 * @return      true when `code` has the keyword `match` at `i`
 * @since 0.3.1
 */
fn match_keyword_at(code: str, i: u64): bool {
    if i + 6 > code.len { return false }
    if teko::str::slice(code, i, i + 6) != "match " { return false }
    if i == 0 { return true }
    !is_ident_byte(code[i - 1])
}

/**
 * brace_open_on_line — the index of the `{` opening a match body that starts at `from`, or `code.len`
 * when the rest of that LINE carries none (a `match` whose brace is on a later line is not a shape
 * this tree writes, and refusing to guess keeps the scanner free of false positives).
 *
 * @param code  the blanked source text
 * @param from  the index just past the `match` keyword
 * @return      the index of the opening brace, or `code.len`
 * @since 0.3.1
 */
fn brace_open_on_line(code: str, from: u64): u64 {
    var k = from
    loop {
        if k >= code.len { break }
        if code[k] == b'\n' { return code.len }
        if code[k] == b'{' { return k }
        k = k + 1
    }
    code.len
}

/**
 * matching_brace — the index of the `}` closing the `{` at `open`, or `code.len` when the text ends
 * first.
 *
 * @param code  the blanked source text
 * @param open  the index of the opening brace
 * @return      the index of its closing brace, or `code.len`
 * @since 0.3.1
 */
fn matching_brace(code: str, open: u64): u64 {
    var depth: i64 = 0
    var k = open
    loop {
        if k >= code.len { break }
        if code[k] == b'{' { depth = depth + 1 }
        if code[k] == b'}' {
            depth = depth - 1
            if depth == 0 { return k }
        }
        k = k + 1
    }
    code.len
}

/**
 * seed_hostile_arm_lines — the 1-based line of every `match` in `text` that mixes a bare numeric
 * literal arm with a narrowing-cast anchor. The scan runs over `code_only_text`, so a brace or a `;`
 * inside a string literal or a comment can never open, close or split a match body.
 *
 * @param text  the whole source text
 * @return      the offending lines, in source order
 * @since 0.3.1
 */
fn seed_hostile_arm_lines(text: str): []u64 {
    var code = code_only_text(text)
    var out: []u64 = teko::list::empty()
    var line: u64 = 1
    var i: u64 = 0
    loop {
        if i >= code.len { break }
        if code[i] == b'\n' { line = line + 1; i = i + 1; continue }
        if !match_keyword_at(code, i) { i = i + 1; continue }
        var open = brace_open_on_line(code, i + 6)
        if open >= code.len { i = i + 6; continue }
        var close = matching_brace(code, open)
        if close >= code.len { i = i + 6; continue }
        if seed_hostile_match_body(teko::str::slice(code, open + 1, close)) { out = teko::list::push(out, line) }
        i = i + 6
    }
    out
}

/**
 * seed_hostile_arm_defects — the one-line complaints about `path`, one per offending `match`. An
 * unreadable file is reported too, for the same reason `source_structure_defect` reports one.
 *
 * @param path  the `.tks` file to inspect
 * @return      one complaint per offending match, empty when the file is seed-safe
 * @since 0.3.1
 */
fn seed_hostile_arm_defects(path: str): []str {
    var text = match teko::io::read_file(path) { str as s => s; error as e => return teko::list::push(teko::list::empty(), $"{path}: unreadable ({e.message})") }
    var lines = seed_hostile_arm_lines(text)
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= lines.len { break }
        out = teko::list::push(out, $"{path}:{lines[i]}: a bare numeric literal arm shares this `match` with a narrowing-cast arm — annotate the literal (`0 to i32`), or a seed without match-arm literal cross-adoption types the join as a union")
        i = i + 1
    }
    out
}

/**
 * seed_hostile_arms_under — the complaints about every compiler source under `dir`, empty when the
 * whole subtree is buildable by a compiler that does not cross-adopt a bare literal arm. Only `.tks`
 * is walked: a `.tkt` is not part of the `--no-verify --release` surface the bootstrap ladder builds.
 *
 * @param dir  the source root to walk
 * @return     one complaint per offending match, in walk order
 * @since 0.3.1
 */
fn seed_hostile_arms_under(dir: str): []str {
    var files = collect_teko_sources(dir)
    var out: []str = teko::list::empty()
    var i: u64 = 0
    loop {
        if i >= files.len { break }
        if teko::str::ends_with(files[i], ".tks") {
            var defects = seed_hostile_arm_defects(files[i])
            var d: u64 = 0
            loop { if d >= defects.len { break }; out = teko::list::push(out, defects[d]); d = d + 1 }
        }
        i = i + 1
    }
    out
}
