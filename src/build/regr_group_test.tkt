
#test
fn snippet_tail_is_value_sees_a_trailing_expression() {
    teko::assert::is_true(snippet_tail_is_value("total()"))
    teko::assert::is_true(snippet_tail_is_value("(probe()) to i32"))
    teko::assert::is_true(snippet_tail_is_value("present_val + absent_val"))
    teko::assert::is_true(snippet_tail_is_value("c_abs-42 to i32"))
}

#test
fn snippet_tail_is_value_rejects_a_void_statement() {
    teko::assert::is_true(!snippet_tail_is_value("exit(42)"))
    teko::assert::is_true(!snippet_tail_is_value("panic(\"boom\")"))
    teko::assert::is_true(!snippet_tail_is_value("let x = 1"))
    teko::assert::is_true(!snippet_tail_is_value("if bad() != 0 { exit(1) }"))
    teko::assert::is_true(!snippet_tail_is_value("match k {\n    0 => exit(7)\n    _ => exit(9)\n}"))
    teko::assert::is_true(!snippet_tail_is_value("loop { break }"))
    teko::assert::is_true(!snippet_tail_is_value("b.v = null"))
    teko::assert::is_true(!snippet_tail_is_value("xs[0] = 3"))
}

#test
fn snippet_tail_is_assignment_ignores_a_comparison() {
    teko::assert::is_true(!snippet_tail_is_assignment("a == b"))
    teko::assert::is_true(!snippet_tail_is_assignment("a != b"))
    teko::assert::is_true(!snippet_tail_is_assignment("(x <= y) to i32"))
    teko::assert::is_true(!snippet_tail_is_assignment("f(\"k=v\")"))
    teko::assert::is_true(snippet_tail_is_assignment("total = 3"))
}

#test
fn snippet_stmts_have_return_is_a_word_scan() {
    teko::assert::is_true(snippet_stmts_have_return("if x.len != 3 { return 1 }\nexit(0)\n"))
    teko::assert::is_true(!snippet_stmts_have_return("let returned = 1\nexit(returned)\n"))
    teko::assert::is_true(!snippet_stmts_have_return("print(\"return\")\nexit(0)\n"))
}

#test
fn snippet_declared_names_claims_only_top_level() {
    var decls = "type Counter = class {\n    pub n: i64\n    pub fn make(v: i64): Counter { Counter { n = v } }\n}\n\nconst B: byte = 5\n\npub fn probe(): i64 { 1 }\n"
    var names = snippet_declared_names(decls)
    teko::assert::is_true(str_list_contains(names, "Counter"))
    teko::assert::is_true(str_list_contains(names, "B"))
    teko::assert::is_true(str_list_contains(names, "probe"))
    teko::assert::is_true(!str_list_contains(names, "make"))
    teko::assert::is_true(!str_list_contains(names, "n"))
}

#test
fn snippet_declared_names_skips_a_doc_comment_and_keeps_an_attribute() {
    var decls = "/**\n * A doc comment naming type Ghost, which is not a declaration.\n */\n#test\nfn probe(): i64 { 1 }\n"
    var names = snippet_declared_names(decls)
    teko::assert::is_true(str_list_contains(names, "probe"))
    teko::assert::is_true(!str_list_contains(names, "Ghost"))
}

#test
fn str_list_contains_finds_and_misses() {
    var xs = ["a", "b"]
    teko::assert::is_true(str_list_contains(xs, "a"))
    teko::assert::is_true(str_list_contains(xs, "b"))
    teko::assert::is_true(!str_list_contains(xs, "c"))
}

fn str_list_contains(xs: []str, needle: str): bool {
    var i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i = i + 1
    }
    false
}

#test
fn regr_group_module_text_wraps_the_statements_in_an_entry() {
    var text = regr_group_module_text("fn total(): i32 { 42 }\ntotal()\n")
    teko::assert::is_true(teko::str::contains(text, "fn total(): i32 { 42 }"))
    teko::assert::is_true(teko::str::contains(text, "pub fn entry() {"))
    teko::assert::is_true(teko::str::contains(text, "exit(total())"))
}

#test
fn regr_group_module_text_leaves_a_void_tail_alone() {
    var text = regr_group_module_text("let x = 21\nexit(x + x)\n")
    teko::assert::is_true(teko::str::contains(text, "exit(x + x)"))
    teko::assert::is_true(!teko::str::contains(text, "exit(exit"))
}

#test
fn regr_group_main_text_dispatches_and_ends_at_exit_zero() {
    var text = regr_group_main_text(regr_group_dispatch_line("m7"))
    teko::assert::is_true(teko::str::contains(text, REGR_GROUP_ENTRY_VAR))
    teko::assert::is_true(teko::str::contains(text, "if regr_entry == \"m7\" { regr_hit = true; m7::entry() }"))
    teko::assert::is_true(teko::str::contains(text, "exit(97)"))
    teko::assert::is_true(teko::str::ends_with(text, "exit(0)\n"))
}

#test
fn regr_group_manifest_text_names_the_generated_project() {
    var text = regr_group_manifest_text()
    teko::assert::is_true(teko::str::contains(text, "name = \"" ~ REGR_GROUP_PROJECT_NAME ~ "\""))
    teko::assert::is_true(teko::str::contains(text, "source = \"src\""))
    teko::assert::is_true(teko::str::contains(text, "kind = \"binary\""))
}

#test
fn regr_group_key_separates_two_configurations() {
    var plain = regr_group_key(regr_test_row("", []))
    var backend = regr_group_key(regr_test_row("", ["TEKO_FOO=1"]))
    var target = regr_group_key(regr_test_row("x86_64-windows", []))
    teko::assert::is_true(plain != backend)
    teko::assert::is_true(plain != target)
    teko::assert::is_true(plain == regr_group_key(regr_test_row("", [])))
}

#test
fn regr_row_groupable_refuses_what_the_fold_cannot_hold() {
    teko::assert::is_true(regr_row_groupable(".", regr_test_row("", [])))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_kind(TkrKind::CompileFail)))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_source("")))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_wellformed()))
    teko::assert::is_true(regr_group_solo(regr_group_key(regr_test_row("", []))))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_source("if bad() != 0 { return 1 }\nexit(0)\n")))
}

#test
fn regr_row_source_reads_a_given_source_file_and_a_missing_one() {
    var inline_row = regr_test_row_source("exit(1)\n")
    teko::assert::is_true(regr_row_source(".", inline_row) == "exit(1)\n")
    var missing = regr_test_row_file("__definitely_missing_case__.tks")
    teko::assert::is_true(regr_row_source(".", missing) == "")
    teko::assert::is_true(!regr_row_groupable(".", missing))
    var present = regr_test_row_file("cases/cross_exit42.tks")
    teko::assert::is_true(regr_row_source("examples/regressions/own_native", present).len > 0)
    teko::assert::is_true(regr_row_groupable("examples/regressions/own_native", present))
}

#test
fn regr_group_slot_misses_an_unplanned_row_and_an_unbuilt_group() {
    var member = RegrGroupMember { key = "k"; group = 0; module = "m0"; source = "exit(0)\n" }
    var members = [member]
    var failed = [RegrGroupBuild { ok = false; binp = ""; members = 1; times = phase_zero() }]
    var ok = [RegrGroupBuild { ok = true; binp = "b"; members = 1; times = phase_zero() }]
    teko::assert::is_true(regr_group_slot_is_null(RegrGroups { members = members; builds = failed }, "k"))
    teko::assert::is_true(regr_group_slot_is_null(RegrGroups { members = members; builds = ok }, "other"))
    teko::assert::is_true(!regr_group_slot_is_null(RegrGroups { members = members; builds = ok }, "k"))
    teko::assert::is_true(regr_group_slot_is_null(regr_groups_empty(), "k"))
}

fn regr_group_slot_is_null(gs: RegrGroups, key: str): bool {
    match regr_group_slot(gs, key) { RegrGroupSlot => false; null => true }
}

#test
fn regr_with_entry_env_appends_the_selector() {
    var t = regr_with_entry_env(regr_test_row("", ["K=V"]), "m3")
    teko::assert::is_true(t.env.len == 2)
    teko::assert::is_true(t.env[0] == "K=V")
    teko::assert::is_true(t.env[1] == REGR_GROUP_ENTRY_VAR ~ "=m3")
}

#test
fn regr_groups_total_sums_every_group_build() {
    var one = RegrGroupBuild { ok = true; binp = "a"; members = 2; times = PhaseTimes { harness_ns = 1; compile_ns = 2; run_ns = 0; builds = 1 } }
    var two = RegrGroupBuild { ok = true; binp = "b"; members = 3; times = PhaseTimes { harness_ns = 10; compile_ns = 20; run_ns = 0; builds = 1 } }
    var gs = RegrGroups { members = []; builds = [one, two] }
    var total = regr_groups_total(gs)
    teko::assert::is_true(total.builds == 2)
    teko::assert::is_true(total.harness_ns == 11)
    teko::assert::is_true(total.compile_ns == 22)
}

#test
fn regr_group_config_text_names_the_host_and_the_env() {
    var bare = regr_group_config_text(RegrGroupSpec { env = []; target = "" })
    teko::assert::is_true(teko::str::contains(bare, HOST_TARGET))
    teko::assert::is_true(teko::str::contains(bare, "no env"))
    var with_env = regr_group_config_text(RegrGroupSpec { env = ["TEKO_FOO=1"]; target = "x86_64-windows" })
    teko::assert::is_true(teko::str::contains(with_env, "x86_64-windows"))
    teko::assert::is_true(teko::str::contains(with_env, "TEKO_FOO=1"))
}

fn regr_test_row(target: str, env: []str): Tkr {
    Tkr {
        args = []; stdin = ""; kind = TkrKind::Exit; exit = 0
        stdout = TkrMatch { mode = TkrMatchMode::Ignore; text = "" }
        stderr = TkrMatch { mode = TkrMatchMode::Ignore; text = "" }
        targets = []; expect = []; golden = []
        diagnostic = ""; source_inline = "exit(0)\n"; source_file = ""
        env = env; target = target; in_place = false; dep_dir = ""
        check_wellformed = false
    }
}

fn regr_test_row_kind(kind: TkrKind): Tkr {
    var b = regr_test_row("", [])
    Tkr {
        args = b.args; stdin = b.stdin; kind = kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = b.check_wellformed
    }
}

fn regr_test_row_source(src: str): Tkr {
    var b = regr_test_row("", [])
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = src; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = b.check_wellformed
    }
}

fn regr_test_row_file(path: str): Tkr {
    var row = regr_test_row_source("")
    Tkr {
        args = row.args; stdin = row.stdin; kind = row.kind; exit = row.exit; stdout = row.stdout
        stderr = row.stderr; targets = row.targets; expect = row.expect; golden = row.golden
        diagnostic = row.diagnostic; source_inline = ""; source_file = path; env = row.env
        target = row.target; in_place = row.in_place; dep_dir = row.dep_dir
        check_wellformed = row.check_wellformed
    }
}

fn regr_test_row_wellformed(): Tkr {
    var b = regr_test_row("", [])
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr
        targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target
        in_place = b.in_place; dep_dir = b.dep_dir
        check_wellformed = true
    }
}
