
/**
 * slowest_index_excluding — the index of the slowest row not already in `taken` (index 0 when every
 * row is taken, which `regr_print_slowest`'s bound makes unreachable).
 *
 * @param rows   the measured rows
 * @param taken  the indices already printed
 * @return       the index of the slowest remaining row
 */
fn slowest_index_excluding(rows: []RowTiming, taken: []u64) -> u64 {
    mut best: u64 = 0
    mut best_ns: i64 = -1
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        let t = phase_total_ns(rows[i].times)
        if !u64_list_has(taken, i) && t > best_ns {
            best = i
            best_ns = t
        }
        i++
    }
    best
}

/**
 * u64_list_has — is `needle` in `xs`? (The already-printed index set's membership test.)
 *
 * @param xs      the accumulated indices
 * @param needle  the index to look for
 * @return        true when present
 */
fn u64_list_has(xs: []u64, needle: u64) -> bool {
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i++
    }
    false
}
