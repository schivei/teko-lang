// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

 * no runtime is added.
 *
 * @return  the current region handle
 * @since 0.3.1 native-region-crash
 */
extern fn region_current() -> u64 = "tk_region_current_u" from "teko_rt"

/**
 * encode_lfunc_in_region_x86 — the per-function isel → regalloc → encode pipeline for ONE `LFunc`,
 * meant to run with a scratch region entered: `select_lfunc_x86` (LIR → virtual `MFuncX86`),
 * `regalloc_func_x86` (SysV coloring, the largest scratch — interval sets), then `encode_func_x86`
 * (final `.text` bytes + function-relative relocs + the defined symbol name). Every intermediate is
 * Group-A scratch derived from THIS function's LIR; the only output that outlives the region is the
 * returned `EncodedFuncX86`, copied out by `fold_encoded_func_x86` before the region drops (§2).
 *
 * @param f  the lowered function to encode
 * @return   the encoded function, or a propagated native honest-stop
 * @since 0.3.1
 */
fn encode_lfunc_in_region_x86(f: teko::lir::LFunc) -> teko::backend::EncodedFuncX86 | error {
    let sel = match teko::backend::select_lfunc_x86(teko::backend::SYSV64, f) { teko::backend::MFuncX86 as x => x; error as e => return e }
    let col = match teko::backend::regalloc_func_x86(teko::backend::SYSV64, sel) { teko::backend::MFuncX86 as x => x; error as e => return e }
    teko::backend::encode_func_x86(teko::backend::SYSV64, col)
}

/**
 * fold_lfunc_scoped_x86 — encode ONE function inside its OWN scratch region and fold its bytes into
 * the root-resident `.text` accumulator `mt` (the PROOF of the fix, §2). Opens a child region, enters
 * it so all isel/regalloc/encode scratch bump-allocates there, LEAVES it (default allocation back to
 * the root), then folds the still-live child's outputs into `mt` — `fold_encoded_func_x86`'s appends
 * land in the ROOT (Group B), COPYING the bytes and the symbol/reloc `str` names (which originate in
 * `prog`, not the child) — and finally DROPS the child, reclaiming the whole per-function scratch. On
 * a native honest-stop the child is LEFT for `tk_regions_free_all` (leak-tolerant, M.5) rather than
 * dropped, because the error's message may have been interned inside the window and is read by the
 * caller after this returns.
 *
 * @param mt  the root-resident running `.text` accumulator
 * @param f   the lowered function to encode and fold
 * @return    the extended accumulator, or the propagated honest-stop
 * @since 0.3.1
 */
fn fold_lfunc_scoped_x86(mt: teko::backend::ModuleTextX86, f: teko::lir::LFunc) -> teko::backend::ModuleTextX86 | error {
    let child = region_new(region_root())
    region_enter(child)
    let encoded = encode_lfunc_in_region_x86(f)
    region_leave()
    match encoded {
        teko::backend::EncodedFuncX86 as ef => {
            let out = teko::backend::fold_encoded_func_x86(mt, ef)
            region_drop(child)
            out
        }
        error as e => e
    }
}

/**
 * encode_module_fused_x86 — the FUSED per-function native encode of a whole module: instead of three
 * module-wide passes (`select_module_x86` → `regalloc_module_x86` → `encode_module_x86`), which keep
 * every function's MInst live at once, loop over `entry.funcs` folding each function through its own
 * scratch region (`fold_lfunc_scoped_x86`), then assemble the final `EncodedModuleX86` from the
 * root-resident accumulator plus the module's persistent rodata/globals (Group B, by-reference —
 * §2 exception E2). The emitted bytes are byte-identical to the module-at-a-time path: the scratch
 * region only changes WHERE the intermediates are bump-allocated, never their computed values.
 *
 * @param entry  the platform-ABI-wrapped lowered module
 * @return       the encoded module (section images + ordered symbols + relocs), or a honest-stop
 * @since 0.3.1
 */
fn encode_module_fused_x86(entry: teko::lir::LModule) -> teko::backend::EncodedModuleX86 | error {
    mut mt = teko::backend::empty_module_text_x86()
    mut i: u64 = 0
    loop {
        if i >= entry.funcs.len { break }
        mt = match fold_lfunc_scoped_x86(mt, entry.funcs[i]) { teko::backend::ModuleTextX86 as x => x; error as e => return e }
        i++
    }
    teko::backend::finish_encoded_module_x86(mt, entry.rodata, entry.globals)
}

/**
 * copy_str_to_current_region — a byte-for-byte copy of `s`, freshly allocated in whichever region
 * is CURRENT at the call site (`tk_str_concat` always mallocs a NEW buffer regardless of operand
 * length, `teko_rt.c:143`). The fused native lowering driver (C6.3) calls this AFTER
 * `region_leave()`, so the copy lands in the ROOT its accumulators reside in — the tool a `str`
 * synthesized INSIDE a scratch region (a mangled function symbol, a reloc target, a synthesized
 * rodata symbol) needs to outlive that region's drop.
 *
 * @param s  the string to copy
 * @return   a fresh copy of `s`, resident in the current region
 * @since 0.3.1 C6.2
 */
fn copy_str_to_current_region(s: str) -> str { teko::str::concat("", s) }

/**
 * copy_bytes_to_current_region — `src` copied byte-by-byte into a freshly built list, so a
 * `[]byte` slice possibly referencing a scratch region's memory is safe to hold onto in the
 * CURRENT region. Mirrors `append_bytes`'s elementwise copy (`encode_arm64.tks:2741`) without
 * calling it, so this crumb's edits stay concentrated in `project.tks` — no encode/isel file is
 * touched (§5 of the design).
 *
 * @param src  the bytes to copy
 * @return     a fresh `[]byte`, resident in the current region
 * @since 0.3.1 C6.2
 */
fn copy_bytes_to_current_region(src: []byte) -> []byte {
    mut out: []byte = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= src.len { break }
        out = teko::list::push(out, src[i])
        i++
    }
    out
}

/**
 * copy_reloc_to_current_region_x86 — `r` with its `sym` name force-copied to the current region
 * (E1, extended for the fused lowering driver). Under Tier 1 (encode-only fusion) every symbol
 * name already originated in `prog`, lowered whole-program on the root before any scratch region
 * opened, so the encode-side fold never needed to copy it. The C6.3 lowering fusion moves
 * `mangle_fn_symbol`'s `str::concat` calls INSIDE the item's own scratch region, so this driver
 * can no longer assume `r.sym` survives the region's drop without an explicit copy.
 *
 * @param r  the function-relative relocation to copy
 * @return   `r` with `sym` resident in the current region
 * @since 0.3.1 C6.2
 *
 * (0.3.1 C6.3-fix, arm64 native-fixpoint SIGSEGV) Every copied field is bound to its OWN `let`
 * BEFORE the struct literal is built, instead of calling `copy_str_to_current_region` inline as a
 * field initializer alongside the other (non-allocating) field reads. Behaviorally identical —
 * this is a defensive sequencing change, not a logic change — narrowing the struct-literal-with-
 * an-allocating-call shape this crumb's helpers share with `copy_lrodata_to_current_region`
 * (§ the macOS-arm64 native fixpoint crash the coordinator traced there).
 */
fn copy_reloc_to_current_region_x86(r: teko::backend::RelocX86) -> teko::backend::RelocX86 {
    let sym = copy_str_to_current_region(r.sym)
    teko::backend::RelocX86 { offset = r.offset; sym = sym; kind = r.kind; addend = r.addend; sect = r.sect }
}

/**
 * copy_relocs_to_current_region_x86 — `copy_reloc_to_current_region_x86` applied to every entry of
 * `relocs`, in order.
 *
 * @param relocs  the function-relative relocations to copy
 * @return        `relocs`, each entry resident in the current region
 * @since 0.3.1 C6.2
 */
fn copy_relocs_to_current_region_x86(relocs: []teko::backend::RelocX86) -> []teko::backend::RelocX86 {
    mut out: []teko::backend::RelocX86 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= relocs.len { break }
        out = teko::list::push(out, copy_reloc_to_current_region_x86(relocs[i]))
        i++
    }
    out
}

/**
 * copy_encoded_func_to_current_region_x86 — `ef` with its `symbol` and every reloc's `sym` force-
 * copied to the current region (E1, extended); `bytes` is left as-is, because
 * `fold_encoded_func_x86`'s own `append_bytes` already copies it byte-by-byte into the root
 * accumulator (Tier 1, unchanged).
 *
 * @param ef  the encoded function to copy
 * @return    `ef` with every `str` field resident in the current region
 * @since 0.3.1 C6.2
 *
 * (0.3.1 C6.3-fix) Each field bound to its own `let` before the struct literal, same defensive
 * sequencing as `copy_reloc_to_current_region_x86` — see its note.
 */
fn copy_encoded_func_to_current_region_x86(ef: teko::backend::EncodedFuncX86) -> teko::backend::EncodedFuncX86 {
    let symbol = copy_str_to_current_region(ef.symbol)
    let relocs = copy_relocs_to_current_region_x86(ef.relocs)
    teko::backend::EncodedFuncX86 { symbol = symbol; bytes = ef.bytes; relocs = relocs }
}

/**
 * fold_encoded_funcs_x86 — fold a LIST of already-encoded functions into the root-resident `.text`
 * accumulator `mt`, copying each one to the current region first (E1, extended;
 * `copy_encoded_func_to_current_region_x86`) so the fold's appends never retain a `str` pointing
 * into a region the caller is about to drop. Called AFTER `region_leave()` (so the copies and the
 * fold itself land in the ROOT) and BEFORE `region_drop` (the item's region is still alive, so the
 * strings it may have synthesized are still readable to copy FROM).
 *
 * @param mt   the running root-resident `.text` accumulator
 * @param efs  the item's encoded functions, in emission order
 * @return     the extended accumulator
 * @since 0.3.1 C6.2
 */
fn fold_encoded_funcs_x86(mt: teko::backend::ModuleTextX86, efs: []teko::backend::EncodedFuncX86) -> teko::backend::ModuleTextX86 {
    mut acc = mt
    mut i: u64 = 0
    loop {
        if i >= efs.len { break }
        acc = teko::backend::fold_encoded_func_x86(acc, copy_encoded_func_to_current_region_x86(efs[i]))
        i++
    }
    acc
}

/**
 * copy_ldata_reloc_to_current_region — one `LDataReloc` with its `target` name force-copied to the
 * current region (E4's relocation sibling — empty in every real compile today, T-B6, but handled
 * generically so `commit_rodata_delta` stays correct if a future rodata-internal pointer is ever
 * synthesized inside an item's scratch region).
 *
 * @param r  the rodata-internal relocation to copy
 * @return   `r` with `target` resident in the current region
 * @since 0.3.1 C6.2
 *
 * (0.3.1 C6.3-fix) `target` bound to its own `let` before the struct literal, same defensive
 * sequencing as `copy_reloc_to_current_region_x86` — see its note.
 */
fn copy_ldata_reloc_to_current_region(r: teko::lir::LDataReloc) -> teko::lir::LDataReloc {
    let target = copy_str_to_current_region(r.target)
    teko::lir::LDataReloc { offset = r.offset; target = target }
}
