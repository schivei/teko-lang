use teko::list

// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).


    loop {
        if i >= ascii.len { break }
        if data[i] != ascii[i] { return false }
        i++
    }
    if (data[6] to u64) != 0 { return false }
    if (data[7] to u64) != 0 { return false }
    true
}

/**
 * ids_contains — is `id` already present in `ids`? (the linear membership test backing `dedup_ids`
 * and `count_of` — the id sets are small per test).
 *
 * @param ids  the id list to search
 * @param id   the id to look for
 * @return     true iff `id` appears in `ids`
 * @since 0.3.0.29
 */
fn ids_contains(ids: []u64, id: u64) -> bool {
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if ids[i] == id { return true }
        i++
    }
    false
}

/**
 * dedup_ids — the input id list with duplicates removed (first-seen order). One test may mark the
 * same id many times (a hot branch/line); the classifier counts a test ONCE per id, so each test's
 * set is deduped before it feeds the cross-test tally.
 *
 * @param ids  the raw id list (possibly with repeats)
 * @return     a list holding each distinct id exactly once
 * @since 0.3.0.29
 */
fn dedup_ids(ids: []u64) -> []u64 {
    mut out: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if !ids_contains(out, ids[i]) { out = teko::list::push(out, ids[i]) }
        i++
    }
    out
}

/**
 * tkcov_ids — decode one test's isolated `.tkcov` bytes into its DEDUPED production id set: validate
 * the magic, then read the three sections (functions, branches, lines) — each a `u64` count followed
 * by that many `u64` ids — and merge them into one deduped list (the three id-spaces are globally
 * disjoint, so a single merged set is exact). A bad magic or a section whose count runs past the
 * buffer yields whatever was decoded so far, never a panic.
 *
 * @param data  the raw `.tkcov` file bytes for one test
 * @return      the deduped set of ids the test covered (empty when the file is absent/corrupt/empty)
 * @since 0.3.0.29
 */
fn tkcov_ids(data: str) -> []u64 {
    if !tkcov_magic_ok(data) { return teko::list::empty() }
    mut acc: []u64 = teko::list::empty()
    mut off: u64 = TKCOV_MAGIC_LEN
    mut s: u64 = 0
    loop {
        if s >= TKCOV_SECTIONS { break }
        if off + TKCOV_MAGIC_LEN > data.len { break }
        let n = read_u64_le(data, off)
        off = off + TKCOV_MAGIC_LEN
        mut k: u64 = 0
        loop {
            if k >= n { break }
            if off + TKCOV_MAGIC_LEN > data.len { break }
            acc = teko::list::push(acc, read_u64_le(data, off))
            off = off + TKCOV_MAGIC_LEN
            k++
        }
        s++
    }
    dedup_ids(acc)
}

/**
 * concat_ids — append every element of `b` onto `a` (list concat over `u64`). Used to fold every
 * test's deduped ids into the one cross-test multiset `all_ids_of` builds.
 *
 * @param a  the accumulator list
 * @param b  the list whose elements are appended
 * @return   `a` followed by `b`
 * @since 0.3.0.29
 */
fn concat_ids(a: []u64, b: []u64) -> []u64 {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * all_ids_of — the cross-test MULTISET: every record's deduped ids concatenated. Because each test's
 * ids are already deduped, `count_of(all, id)` over this multiset equals the number of DISTINCT tests
 * that cover `id` — exactly the signal the REDUNDANT test needs.
 *
 * @param recs  the per-test records
 * @return      the concatenation of every record's ids
 * @since 0.3.0.29
 */
fn all_ids_of(recs: []TestRecord) -> []u64 {
    mut acc: []u64 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= recs.len { break }
        acc = concat_ids(acc, recs[i].ids)
        i++
    }
    acc
}

/**
 * count_of — how many times `id` occurs in the cross-test multiset `all_ids` — i.e. how many distinct
 * tests cover `id`.
 *
 * @param all_ids  the multiset from `all_ids_of`
 * @param id       the production id to tally
 * @return         the number of tests covering `id`
 * @since 0.3.0.29
 */
fn count_of(all_ids: []u64, id: u64) -> u64 {
    mut c: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= all_ids.len { break }
        if all_ids[i] == id { c = c + 1 }
        i++
    }
    c
}

/**
 * classify_test — the analyzer verdict for one test given the cross-test multiset. STALE when it
 * covers no id at all; LIVE when it uniquely covers at least one id (some id has fewer than
 * `REDUNDANT_MIN` covering tests); REDUNDANT when every id it covers is also covered elsewhere.
 *
 * @param ids      this test's deduped id set
 * @param all_ids  the cross-test multiset (`all_ids_of`)
 * @return         `Verdict::Stale`, `Verdict::Live`, or `Verdict::Redundant`
 * @since 0.3.0.29
 */
fn classify_test(ids: []u64, all_ids: []u64) -> Verdict {
    if ids.len == 0 { return Verdict::Stale }
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        if count_of(all_ids, ids[i]) < REDUNDANT_MIN { return Verdict::Live }
        i++
    }
    Verdict::Redundant
}

/** analyzer_header_line — the report's first line: the advisory banner. (0.3.0.29) */
fn analyzer_header_line() -> str { "teko: test analyzer (dev-time; ADVISORY — removal is manual)" }

/** analyzer_caveat_line — the report's second line: the REDUNDANT-but-still-a-localizer caveat. A
    REDUNDANT backend golden-vector may still be the SOLE localizer of a specific bug; a human, not the
    tool, decides whether to remove it. (0.3.0.29) */
fn analyzer_caveat_line() -> str { "teko: caveat — a REDUNDANT test may still be a sole localizer (diagnostic value); a human decides" }

/** analyzer_fold_line — the report's third line: the assertion-fold caveat. MISLEADING flags a test
    whose assertion folded to a constant yet still covers production (a green test that guards nothing —
    a class pure coverage counting cannot detect); FOUNDATIONAL flags a test whose assertions all fold
    (it tests the language/fold foundation, e.g. `1+1==2`). (0.3.0.29) */
fn analyzer_fold_line() -> str { "teko: note — MISLEADING = assertion folded-to-constant yet covers production (invisible to coverage); FOUNDATIONAL = tests the foundation (e.g. 1+1)" }

/**
 * analyzer_line — one per-test report line:
 * `analyzer <label> ids=<n> asserts=<total>/<folded> status=<...>`.
 *
 * @param label   the test's `namespace::name` (or bare `name`) label
 * @param n       the number of ids the test covered
 * @param total   the number of bool assertions the test makes
 * @param folded  how many of those assertions fold to a comptime constant
 * @param s       the combined status
 * @return        the formatted, greppable line
 * @since 0.3.0.29
 */
fn analyzer_line(label: str, n: u64, total: u64, folded: u64, s: Status) -> str {
    let st = status_text(s)
    $"analyzer {label} ids={n} asserts={total}/{folded} status={st}"
}

/**
 * StatusTally — the per-status counts accumulated across the report (0.3.0.29 Crumb 4), so the summary
 * footer can be a single pure fold over the records.
 */
type StatusTally = struct {
// count of MISLEADING tests.
    misleading: u64
// count of FOUNDATIONAL tests.
    foundational: u64
// count of DEAD tests.
    dead: u64
// count of REDUNDANT tests.
    redundant: u64
// count of LIVE tests.
    live: u64
}

/** tally_empty — the zero `StatusTally`. (0.3.0.29) */
fn tally_empty() -> StatusTally { StatusTally { misleading = 0; foundational = 0; dead = 0; redundant = 0; live = 0 } }

/**
 * tally_add — increment the count for `s` in `t`.
 *
 * @param t  the running tally
 * @param s  the status to increment
 * @return   `t` with `s`'s count raised by one
 * @since 0.3.0.29
 */
fn tally_add(t: StatusTally, s: Status) -> StatusTally {
    match s {
        Status::Misleading => StatusTally { misleading = t.misleading + 1; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Foundational => StatusTally { misleading = t.misleading; foundational = t.foundational + 1; dead = t.dead; redundant = t.redundant; live = t.live }
        Status::Dead => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead + 1; redundant = t.redundant; live = t.live }
        Status::Redundant => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant + 1; live = t.live }
        Status::Live => StatusTally { misleading = t.misleading; foundational = t.foundational; dead = t.dead; redundant = t.redundant; live = t.live + 1 }
    }
}

/**
 * analyzer_summary_line — the report footer: the per-status counts and their total.
 *
 * @param t  the accumulated status tally
 * @return   the formatted summary line
 * @since 0.3.0.29
 */
fn analyzer_summary_line(t: StatusTally) -> str {
    let total = t.misleading + t.foundational + t.dead + t.redundant + t.live
    $"analyzer: {t.misleading} MISLEADING, {t.foundational} FOUNDATIONAL, {t.dead} DEAD, {t.redundant} REDUNDANT, {t.live} LIVE (total {total})"
}

/**
 * analyzer_report — the WHOLE analyzer report as one string: the three-line header, one
 * `analyzer_line` per record (the coverage-set axis crossed with the assertion-fold axis into a
 * combined `Status`), then the summary footer. Pure — the driver builds `recs` from the decoded
 * `.tkcov` files plus `checker::test_assert_stats` and hands them here.
 *
 * @param recs  the per-test records (label + deduped ids + assertion tally)
 * @return      the complete, newline-terminated report text
 * @since 0.3.0.29
 */
fn analyzer_report(recs: []TestRecord) -> str {
    let all = all_ids_of(recs)
    mut out = teko::str::concat(analyzer_header_line(), "\n", analyzer_caveat_line(), "\n", analyzer_fold_line(), "\n")
    mut tally = tally_empty()
    mut i: u64 = 0
    loop {
        if i >= recs.len { break }
        let r = recs[i]
        let cov = classify_test(r.ids, all)
        let s = combined_status(cov, r.asserts_total, r.asserts_folded)
        out = teko::str::concat(out, analyzer_line(r.label, r.ids.len, r.asserts_total, r.asserts_folded, s), "\n")
        tally = tally_add(tally, s)
        i++
    }
    teko::str::concat(out, analyzer_summary_line(tally), "\n")
}
