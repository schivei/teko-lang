// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).


const TEST_STAGE_REPORT: str = "report"

/**
 * TEST_STAGE_REGR — the stage that RUNS the regressors: the whole `[tests] regression` tier in a
 * process of its own, re-invoked, so that its accumulation (the captures of every build and of
 * every scenario read back from disk — the arena the region allocator only returns at exit) DIES
 * with this process before the report stage opens its re-check peak. Without this boundary the
 * driver held the tier's aggregate LIVE while it waited for the report to reload the compiler's
 * AST, and the two peaks coincided (the measured cause of the CI macOS-arm64 exit 137).
 *
 * @since 0.3.1
 */
const TEST_STAGE_REGR: str = "regr"

/**
 * TEST_GATE_RC_ENV — the key the driver hands the unit gate's exit status to the report stage
 * through. Passed explicitly because the report stage runs in a DIFFERENT process and the floor
 * policy is only consulted when the gate itself passed.
 */
const TEST_GATE_RC_ENV: str = "TEKO_TEST_GATE_RC"

/**
 * TEST_REGR_RC_ENV — the key the driver hands the regression tier's exit status to the report
 * stage through (the tier's verdict gates after the floor and delta policies).
 */
const TEST_REGR_RC_ENV: str = "TEKO_TEST_REGR_RC"

/**
 * STAGE_SELECT_FAILED — the status a `teko test` run exits with when the stage selector cannot be
 * made visible to a child process. Not a test failure and not a pass: the driver refuses to run.
 */
const STAGE_SELECT_FAILED: i32 = 2

/**
 * test_project — the `teko test <dir>` entry (D2, post-interpreter), STAGED ACROSS PROCESSES since 0.3.1.0.
 *
 * A `teko test` run has five steps: compile the project with its `.tkt` tests into a gate binary,
 * `cc` it, run it, compile each `.tkr` regressor, run each regressor. Three of the five already ran
 * in child processes and gave their memory back at exit; the regression tier did not — it ran in
 * the driver, and since the region allocator only releases at termination, its aggregate (the
 * captures of every build and scenario, read back from disk) stayed resident through the report
 * stage's ~3 GB re-check, the two peaks coinciding under `wait`. The owner's ruling (2026-07-31)
 * is that each step runs independently with no accumulated allocation, and that the parent
 * RE-INVOKES ITSELF to get there — the shape `compile_regressive` has been proving for a release.
 *
 * So this entry is a FOUR-WAY dispatch on `TEST_STAGE_ENV`:
 *   - `build`  → `test_stage_build`: front-end + gate binary + instrumented regression compiler.
 *   - `regr`   → `test_stage_regr`: run the whole regression tier, then EXIT (the arena goes back).
 *   - `report` → `test_stage_report`: re-check, merge the dumps, apply the policies, verdict.
 *   - absent   → `test_drive`: spawn the three above, and between them run the gate binary.
 *
 * @param dir              the project directory
 * @param gen_cov          `--coverage` — write the Cobertura report next to the project root
 * @param cov_validation   `--cov-validation` — enforce (fail) the coverage floors instead of warning
 * @param per_test_cov     `--per-test-cov` — also print the dev-time per-test attribution report
 * @param per_commit_base  `--per-commit-test <base>` — the git base for the delta gate ("" = no-op)
 * @param analyzer         `--analyzer` — after the gate + floors, run the dev-time stale/redundant analyzer
 * @param arith_cast_gate  `--arith-cast-gate` — after the gate + floors, enforce the D4
 *                         ARITH-CAST-RATE ceiling (≤2%, `cast-width-hygiene-0.3.1.md` §5, C5)
 * @return                 0 when every test passes and the gate + floor + delta + regression +
 *                         arith-cast-rate policies hold, else the highest-precedence failing status
 */
fn test_project(dir: str, gen_cov: bool, cov_validation: bool, per_test_cov: bool, per_commit_base: str, analyzer: bool, arith_cast_gate: bool) -> i32 {
    let stage = selected_test_stage()
    if stage == TEST_STAGE_BUILD { return test_stage_build(dir) }
    if stage == TEST_STAGE_REGR { return test_stage_regr(dir) }
    if stage == TEST_STAGE_REPORT {
        return test_stage_report(dir, gen_cov, cov_validation, per_test_cov, per_commit_base, analyzer, arith_cast_gate)
    }
    test_drive(dir)
}

/**
 * selected_test_stage — the stage this process was invoked as, "" when it is the driver. An empty
 * value reads as absent: `set_var` has no unset, so the driver CLEARS the selector by setting it
 * empty after each spawn and nothing downstream may read that as a stage.
 *
 * @return `TEST_STAGE_BUILD`, `TEST_STAGE_REPORT`, or "" for the driver
 * @since 0.3.1.0
 */
fn selected_test_stage() -> str {
    match teko::env::var(TEST_STAGE_ENV) { str as v => v; error => "" }
}

/**
 * test_drive — the `teko test` DRIVER: the process the user launched, which from here on compiles
 * nothing, runs no tier, and therefore holds nothing. It spawns the build stage, runs the (light)
 * gate binary that stage produced, spawns the regression stage — which runs the whole tier and
 * EXITS, giving its aggregate back to the operating system — and only then spawns the report stage
 * for the verdict. No pair of heavyweight peaks is ever resident at once: the tier's captures are
 * gone before the report opens its re-check. This is the cure for the CI macOS-arm64 exit 137.
 *
 * The gate run is short; the compile and both the tier and the re-check now live in children that
 * each exit — which is exactly why this process, the one that sits through all of it, holds only
 * the manifest.
 *
 * MINTS THIS RUN'S JOURNAL STAMP FIRST (journal wiring, 0.3.1): `teko::journal::run_id()`, called
 * before ANY child is spawned, sets `TEKO_RUN` in THIS process's own environment — and every stage
 * below inherits it for free through `fork` (`tk_rt_spawn_redirected`, `teko_rt.c`: the child starts
 * as a full copy of this process's environment, `putenv`-ing only the FEW keys each spawn spec adds
 * on top). Without this call each stage would mint its OWN stamp on first use and the gate's
 * `s<shard>` segments would land in a different `run_root()` than the regression tier's `r0` — two
 * runs that never fold together, which is exactly the coherence `print_journal_summary`
 * (`test_stage_report`) needs from ONE root holding both.
 *
 * ALSO SWEEPS OLD RUN ROOTS HERE, on OPEN rather than on exit (`teko::journal::sweep`'s own reason:
 * a `SIGKILL`ed run's root is left ON PURPOSE, as the very evidence a later `--replay` would read —
 * cleaning it on THIS run's exit would destroy that evidence in the one case it matters).
 *
 * @param dir  the project directory
 * @return     the report stage's verdict, or the first failing stage's status
 * @throws     the manifest's own message when the project directory has no readable single `.tkp`
 * @since 0.3.1.0
 */
fn test_drive(dir: str) -> i32 {
    _ = teko::journal::run_id()
    _ = teko::journal::sweep(teko::journal::run_root())
    ensure_rt_dir_abs()
    let exe = self_exe_path()
    let launch = match teko::env::cwd() { str as c => c; error => "" }
    let brc = run_test_stage(TEST_STAGE_BUILD, exe)
    if brc != 0 { return brc }
    let m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    let trc = native_gate_run(GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, m), false)
    match teko::env::chdir(launch) { error => return fail(dir, "cannot return to the launch directory"); null => { } }
    let regr_rc = run_test_stage(TEST_STAGE_REGR, exe)
    run_test_report_stage(exe, trc, regr_rc)
}

/**
 * drive_regression_tier — run the `[tests] regression` phase with the compiler the build stage
 * left for it. A project that declares no regressors is a zero-cost no-op (the 0.3.0.29 inert
 * base). The tier's coverage is NOT merged here — the report stage merges the same files itself,
 * and this process is the one that must stay small.
 *
 * @param exe  this compiler binary's own path (the un-instrumented fallback)
 * @param m    the resolved manifest
 * @return     0 when every regressor passed (or the tier is advisory), 1 on a gated failure
 * @since 0.3.1.0
 */
fn drive_regression_tier(exe: str, m: Manifest) -> i32 {
    if m.test_regression_files.len == 0 { return 0 }
    run_regression_phase(regression_feed_exe(exe, m), m)
}

/**
 * test_stage_regr — STAGE 2: enter the project, read ITS MANIFEST ALONE (never the checked AST) and
 * run the regression tier with the compiler the build stage left behind. Then RETURN — the process
 * exits and the operating system reclaims every capture the tier read back from disk. This is the
 * `drive_regression_tier` call the driver used to make in-line, moved into its own process so the
 * tier's aggregate never coexists with the report stage's re-check peak.
 *
 * @param dir  the project directory
 * @return     0 when every regressor passed (or the tier is advisory), 1 on a gated failure
 * @throws     the manifest's own message when the project directory has no readable single `.tkp`
 * @since 0.3.1
 */
fn test_stage_regr(dir: str) -> i32 {
    ensure_rt_dir_abs()
