/**
 * BIN_TEST_OUT_DIR — the output directory every path golden below is taken against, pinned once so
 * a golden reads as a claim about the SUFFIX and not about the directory.
 */
const BIN_TEST_OUT_DIR: str = "bin"

/**
 * BIN_TEST_STEM — the artifact stem every path golden below is taken against: the compiler's own
 * manifest `name`, which is the exact stem the released asset is published under.
 */
const BIN_TEST_STEM: str = "teko"

/**
 * bin_path_for — `binary_output_path` under the pinned directory and stem, so each golden below is
 * one target mapped to one name.
 *
 * @param t  the own-backend target to name the executable for
 * @return   the executable path `binary_output_path` produces for `t`
 */
fn bin_path_for(t: NativeTarget) -> str {
    binary_output_path(BIN_TEST_OUT_DIR, BIN_TEST_STEM, t)
}

#test
/**
 * a_windows_target_names_an_exe — THE MEASURED DEFECT, and the first of the two halves this
 * fixture exists to hold apart: a PE image written as a bare `bin/teko` is not launchable by that
 * name (Windows resolves an extensionless program name by APPENDING `.exe`), and the producer that
 * published one made the whole `windows-x86_64` leg fail on a missing `teko.exe`.
 *
 * @return void
 */
fn a_windows_target_names_an_exe() {
    teko::assert::is_true(bin_path_for(NativeTarget::X8664Windows) == "bin/teko.exe")
    teko::assert::is_true(teko::str::ends_with(bin_path_for(NativeTarget::X8664Windows), EXE_SUFFIX_PE))
}

#test
/**
 * no_other_target_names_an_exe — THE SECOND HALF, and the one a fix that suffixed every host would
 * pass the first half without: an ELF or Mach-O executable is launched by its EXACT name, so a
 * `.exe` on Linux or macOS is the same defect pointing the other way. Every non-Windows target is
 * asserted to be the bare `<od>/<stem>` it has always been, which is also what keeps the existing
 * Linux/macOS regressions byte-identical.
 *
 * @return void
 */
fn no_other_target_names_an_exe() {
    teko::assert::is_true(bin_path_for(NativeTarget::X8664Linux) == "bin/teko")
    teko::assert::is_true(bin_path_for(NativeTarget::Arm64Linux) == "bin/teko")
    teko::assert::is_true(bin_path_for(NativeTarget::Arm64Macho) == "bin/teko")
    teko::assert::is_true(!teko::str::ends_with(bin_path_for(NativeTarget::X8664Linux), EXE_SUFFIX_PE))
    teko::assert::is_true(!teko::str::ends_with(bin_path_for(NativeTarget::Arm64Linux), EXE_SUFFIX_PE))
    teko::assert::is_true(!teko::str::ends_with(bin_path_for(NativeTarget::Arm64Macho), EXE_SUFFIX_PE))
}

#test
/**
 * a_wasm_target_keeps_naming_a_module — the naming the wasm tail used to assemble by hand and now
 * asks the same helper for: a self-contained module is `<od>/<stem>.wasm`, never a bare name and
 * never an `.exe`. The golden is what proves folding that third hand-built name into the helper
 * changed no byte of the wasm path.
 *
 * @return void
 */
fn a_wasm_target_keeps_naming_a_module() {
    teko::assert::is_true(bin_path_for(NativeTarget::Wasm32Wasi) == "bin/teko.wasm")
    teko::assert::is_true(bin_path_for(NativeTarget::Wasm64Wasi) == "bin/teko.wasm")
    teko::assert::is_true(bin_path_for(NativeTarget::Wasm32Browser) == "bin/teko.wasm")
    teko::assert::is_true(!teko::str::ends_with(bin_path_for(NativeTarget::Wasm32Wasi), EXE_SUFFIX_PE))
}

#test
/**
 * the_suffix_is_keyed_on_the_image_format — the RULE, not the table: `.exe` belongs to the PE/COFF
 * image format and `.wasm` to the wasm module format, so every target sharing a format shares its
 * executable extension. This is what makes the next target that emits either container inherit the
 * right name without a second decision.
 *
 * @return void
 */
fn the_suffix_is_keyed_on_the_image_format() {
    teko::assert::is_true(executable_suffix(NativeTarget::X8664Windows) == EXE_SUFFIX_PE)
    teko::assert::is_true(executable_suffix(NativeTarget::Wasm32Wasi) == EXE_SUFFIX_WASM)
    teko::assert::is_true(executable_suffix(NativeTarget::X8664Linux) == EXE_SUFFIX_NONE)
    teko::assert::is_true(executable_suffix(NativeTarget::Arm64Macho) == EXE_SUFFIX_NONE)
}

#test
/**
 * the_harness_looks_for_the_same_name_the_build_writes — the side door this fixture closes: the
 * regressor resolves a row's artifact through `artifact_path_for_target`, which used to list the
 * wasm spellings by hand and therefore could not know about the Windows suffix. Asserted against
 * `binary_output_path` itself so the two can never disagree again, in either direction.
 *
 * @return void
 */
fn the_harness_looks_for_the_same_name_the_build_writes() {
    teko::assert::is_true(artifact_path_for_target("bin/teko", "x86_64-windows") == bin_path_for(NativeTarget::X8664Windows))
    teko::assert::is_true(artifact_path_for_target("bin/teko", "x86_64-linux") == bin_path_for(NativeTarget::X8664Linux))
    teko::assert::is_true(artifact_path_for_target("bin/teko", "wasm32-wasi") == bin_path_for(NativeTarget::Wasm32Wasi))
    teko::assert::is_true(artifact_path_for_target("bin/teko", "wasm64") == bin_path_for(NativeTarget::Wasm64Wasi))
}

#test
/**
 * a_row_with_no_declared_target_follows_the_host — a row that declares no target (or the literal
 * `host`) is named for whatever this host's build writes, in both spellings, on every host: the
 * assertion is the EQUIVALENCE with the compiler's own total resolution, never a fixed suffix, so
 * it is green on a Linux, macOS and Windows runner alike.
 *
 * @return void
 */
fn a_row_with_no_declared_target_follows_the_host() {
    let host_name = bin_path_for(host_default_target_guess())
    teko::assert::is_true(artifact_path_for_target("bin/teko", "") == host_name)
    teko::assert::is_true(artifact_path_for_target("bin/teko", HOST_TARGET) == host_name)
}
