/**
 * emit_static_lib_arm64_linux — the arm64/Linux-ELF static-archive tail: select, allocate,
 * and encode exactly as `emit_native_arm64_linux` does, then hand the encoded module's ELF
 * object bytes AND its neutral symbol list to `finish_static_archive` under the GNU archive
 * format (the format an ELF platform's `ar`/`ld` expect, the same choice
 * `emit_static_lib_x86` makes). MANDATORY rather than optional: `emit_static_lib`'s dispatch is
 * EXHAUSTIVE over `NativeTarget`, so an arm64-Linux `.a` request has nowhere else to land.
 *
 * @param dir   the project directory (for diagnostics)
 * @param od    the slash-stripped output directory (already created)
 * @param stem  the output artifact name (the manifest `name`)
 * @param lmod  the target-independent lowered module
 * @return      0 on a successful write+archive, else the failing status
 * @since 0.3.1
 */
fn emit_static_lib_arm64_linux(dir: str, od: str, stem: str, lmod: teko::lir::LModule) -> i32 {
    let sel = match teko::backend::select_module(lmod) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let col = match teko::backend::regalloc_module(teko::backend::AAPCS64, sel) { teko::backend::MModule as x => x; error as e => return fail(dir, e.message) }
    let enc = match teko::backend::encode_module(teko::backend::AAPCS64, col) { teko::backend::EncodedModule as x => x; error as e => return fail(dir, e.message) }
    finish_static_archive(dir, od, stem, teko::backend::emit_elf_arm64(enc, teko::backend::no_dwarf_sink()), enc.symbols, ArchiveFormat::Gnu)
}

