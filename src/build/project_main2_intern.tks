// // src/build/project.tks   (namespace 'teko::build')
// //
// // The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// // surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// // the directory resolution in main.c (project_dir_of). main.tks dispatches here:
// //   teko build <dir>  → compile_project  (front-end → native codegen)
// //   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
// //   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
// //
// // FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// // the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// // so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// // `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// // codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// // diverged to is retired, #524).
//
//
// @param exe    this compiler binary's absolute path
// @return       the child's exit status, or `STAGE_SELECT_FAILED` when the selector cannot be set
// @since 0.3.1.0
//
fn run_test_stage(stage: str, exe: str) -> i32 {
    if !env_visible_to_children(TEST_STAGE_ENV, stage) { return report_stage_select_failure(stage) }
    teko::io::flush()
    let rc = teko::process::run(self_stage_argv(exe))
    match teko::env::set_var(TEST_STAGE_ENV, "") { error => { }; null => { } }
    rc
}

/**
 * run_test_report_stage — spawn the report stage with the gate's and the tier's statuses in the
 * environment. When those statuses cannot be made visible the run STOPS instead of reporting: a
 * report stage that read a missing status as 0 would turn a failed gate into a green run, and a
 * silent false pass is the one outcome M.1 forbids outright.
 *
 * @param exe      this compiler binary's absolute path
 * @param trc      the unit gate's exit status
 * @param regr_rc  the regression tier's exit status
 * @return         the report stage's verdict, or a non-zero status that never masks `trc`
 * @since 0.3.1.0
 */
fn run_test_report_stage(exe: str, trc: i32, regr_rc: i32) -> i32 {
    let ready = env_visible_to_children(TEST_GATE_RC_ENV, $"{trc}") && env_visible_to_children(TEST_REGR_RC_ENV, $"{regr_rc}")
    if !ready {
        report_stage_select_failure(TEST_STAGE_REPORT)
        if trc != 0 { return trc }
        return STAGE_SELECT_FAILED
    }
    run_test_stage(TEST_STAGE_REPORT, exe)
}

/**
 * report_stage_select_failure — the honest stop when the environment refuses to carry a stage's
 * selector or status to a child (M.3: name what could not be done, do not proceed as if it had).
 *
 * @param stage  the stage that could not be selected
 * @return       `STAGE_SELECT_FAILED`
 * @since 0.3.1.0
 */
fn report_stage_select_failure(stage: str) -> i32 {
    teko::io::eprintln(teko::str::concat("teko: cannot hand the `", stage, "` stage its ", TEST_STAGE_ENV, " selector — refusing to run `teko test` unstaged"))
    STAGE_SELECT_FAILED
}

/**
 * env_visible_to_children — set `key` to `value` AND read it back, because a value a child cannot
 * see is worse than one that was never set: the child would run the wrong stage, or read a failed
 * gate as a passing one.
 *
 * @param key    the environment key
 * @param value  the value the child must see
 * @return       true iff the value is set and reads back identical
 * @since 0.3.1.0
 */
fn env_visible_to_children(key: str, value: str) -> bool {
    match teko::env::set_var(key, value) { error => return false; null => { } }
    match teko::env::var(key) { str as v => v == value; error => false }
}

/**
 * stage_rc_of_env — the exit status a driver handed this stage through `key` (0 when absent, which
 * is also what a stage run by hand should assume).
 *
 * @param key  `TEST_GATE_RC_ENV` or `TEST_REGR_RC_ENV`
 * @return     the parsed status
 * @since 0.3.1.0
 */
fn stage_rc_of_env(key: str) -> i32 {
    match teko::env::var(key) { str as v => bp_parse_uint(v) to i32; error => 0 to i32 }
}

/**
 * self_stage_argv — the argv to re-invoke this binary with: the user's own argv with `argv[0]`
 * replaced by this binary's RESOLVED absolute path (the launch spelling may be `./out/teko`, and
 * a stage must not depend on the child's PATH lookup finding the same file).
 *
 * @param exe  this compiler binary's absolute path
 * @return     the argv for `teko::process::run`
 * @since 0.3.1.0
 */
fn self_stage_argv(exe: str) -> []str {
    let args = teko::env::args()
    mut out: []str = teko::list::push(teko::list::empty(), exe)
    mut i: u64 = 1
    loop {
        if i >= args.len { break }
        out = teko::list::push(out, args[i])
        i = i + 1
    }
    out
}

//
// test_gate_precedence — `test_project`'s combined failing status, in PRECEDENCE order, extracted
// to a pure function so the invariant this fixes (owner-observed run `30400712261`: a crashed unit
// gate used to return IMMEDIATELY, skipping the regression tier's run entirely — the tier's own
// report went missing, not merely failed) is provable without a real build. The gate's own status
// (`trc`) is still the highest-precedence failure, UNCHANGED; only the caller's control flow moved,
// computing `floor_rc`/`per_commit_rc`/`regr_rc` before ever consulting `trc`, so their reports are
// never swallowed by an earlier return.
//
// @param trc            the unit-test gate's own exit status (0 = every `#test` passed)
// @param floor_rc       the D4 coverage-floor policy's status (0 when it was never consulted)
// @param per_commit_rc  the delta-coverage enforcer's status (0 when `--per-commit-test` was absent)
// @param has_regr       whether the manifest declares `[tests] regression` files at all
// @param regr_rc        the regression tier's own exit status (ignored when `has_regr` is false)
//
