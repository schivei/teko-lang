// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).

use teko::parser
use teko::lexer
use teko::checker
use teko::codegen
use teko::emit
use teko::compress
use teko::coverage

 * §5.2 names the first, but `--allow-shlib-undefined` alone governs only undefined symbols INSIDE a
 * shared dependency — an EXECUTABLE with an undefined symbol still fails `ld` (verified: `cc` with
 * only that flag rejects a program calling an unlinked symbol). Emitting the ratified flag alone
 * would ship a no-op opt-in — a fabricated capability, which M.1/M.3 forbid more strongly than the
 * flag list binds — so the mechanically-required companion travels with it. `""` for
 * PE/COFF — a DLL cannot be referenced without an import library, so there is no host-linker flag
 * that would make the blind link work there (the honest stop is raised by
 * `validate_shared_libs_for_target`, not silently papered over with a flag that does nothing).
 * In E1 the own M-linker makes the capability native and this translation retires.
 *
 * @param objfmt  the resolved target's object format (`target_objfmt`)
 * @return        the host-linker flag that enables the blind link, or "" when none exists
 * @since 0.3.1
 */
fn allow_undef_cc_flag(objfmt: str) -> str {
    if objfmt == OBJFMT_ELF { return "-Wl,--allow-shlib-undefined,--unresolved-symbols=ignore-all" }
    if objfmt == OBJFMT_MACHO { return "-Wl,-undefined,dynamic_lookup" }
    ""
}

/**
 * append_allow_undef_flag — append the translated blind-link flag to the link line when this build
 * carries `--allow-undef` and the resolved target's object format has a translation. A flagless
 * build appends NOTHING, so the default link line — and the product FIXPOINT — stay byte-identical.
 *
 * @param argv  the link argument vector so far
 * @return      `argv` with the translated flag appended, or unchanged
 * @since 0.3.1
 */
fn append_allow_undef_flag(argv: []str) -> []str {
    if !allow_undef_selected() { return argv }
    let flag = allow_undef_cc_flag(target_objfmt(resolved_target()))
    if flag.len == 0 { return argv }
    teko::list::push(argv, flag)
}

/**
 * ExternLibEntry — one `[extern.libs…]` declaration that APPLIES to the build's resolved target,
 * flattened out of the manifest's parallel columns for the M.3 validators: the manifest key, the
 * resolved link flag, the declared linkage mode, and the section it came from.
 *
 * @since 0.3.1
 */
type ExternLibEntry = struct {
    /** the manifest key (the `from "<key>"` handle) this flag was declared under. */
    key: str
    /** the resolved cc link flag (`-l<name>`, a direct file path, or a verbatim `-flag`). */
    flag: str
    /** the declared linkage mode: `LINK_MODE_STATIC`, `LINK_MODE_SHARED`, or "". */
    mode: str
    /** the section key it came from: "" for the global `[extern.libs]`, else the bare OS / os-arch. */
    section: str
}

/**
 * applicable_extern_libs — every extern-lib declaration that applies to `target`: the whole global
 * `[extern.libs]` section (it links on every target) plus the deferred `[extern.libs.<key>]`
 * entries whose section key matches, keyed on the TARGET's own OS and canonical os-arch name
 * (`target_os_name`/`target_name`) rather than on the build's `[extern] target` triple — the
 * validators answer "is this lib available FOR THE REQUESTED TARGET", which is a question about the
 * target, not about the `cc` triple seam.
 *
 * @param m       the parsed manifest
 * @param target  the resolved own-backend target
 * @return        the applicable declarations, global section first, each in declaration order
 * @since 0.3.1
 */
fn applicable_extern_libs(m: Manifest, target: NativeTarget) -> []ExternLibEntry {
    mut out: []ExternLibEntry = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= m.link_flags.len { break }
        out = teko::list::push(out, ExternLibEntry { key = m.link_lib_name[i]; flag = m.link_flags[i]; mode = m.link_mode[i]; section = "" })
        i = i + 1
    }
    let keys = target_link_keys(target)
    mut j: u64 = 0
    loop {
        if j >= m.os_lib_os.len { break }
        if os_lib_key_matches(m.os_lib_os[j], keys) {
            out = teko::list::push(out, ExternLibEntry { key = m.os_lib_name[j]; flag = m.os_lib_flag[j]; mode = m.os_lib_mode[j]; section = m.os_lib_os[j] })
        }
        j = j + 1
    }
    out
}

/**
 * lib_spec_path — the LOCAL FILE PATH a resolved link flag names, or "" when the flag names no
 * file (a `-l<name>` search request or a verbatim `-flag` escape). A direct-file element resolves
 * to the path itself (`mf_extern_spec`), so a leading `-` is the whole distinction.
 *
 * @param flag  a resolved link flag
 * @return      the path it names, or "" when it names none
 * @since 0.3.1
 */
fn lib_spec_path(flag: str) -> str {
    if flag.len > 0 && flag[0] == b'-' { return "" }
    flag
}

/**
 * lib_file_present — is `path` present on THIS machine? Resolved by listing the containing
 * directory and looking for the basename, so the check costs one `list_dir` and never slurps a
 * multi-megabyte archive into memory just to learn it exists.
 *
 * @param path  the declared library path (relative to the project root, or absolute)
 * @return      true iff a directory entry with that basename exists
 * @since 0.3.1
 */
fn lib_file_present(path: str) -> bool {
    let entries = match teko::fs::list_dir(dirname_of(path)) { []str as e => e; error => return false }
    name_in(entries, basename_of(path))
}

/**
 * static_lib_locality_error — the R4 verdict for ONE static declaration. A cross target's static
 * lib MUST name a local file: the host linker cannot search the target's library paths, so a bare
 * `-l<name>` for a cross target is the "not pointed at for the requested os-arch" error (and the
 * message spells the `[extern.libs.<os-arch>]` line that fixes it). A named path — cross or host —
 * must be PRESENT, which is the already-ratified "an explicitly-named missing lib file is a hard
 * error" rule (LEGISLATION:423) applied per target. A bare `-l<name>` for the HOST target keeps
 * today's behaviour: the host linker searches its own paths and reports its own fail-loud miss.
 *
 * @param e       the applicable static declaration
 * @param target  the resolved own-backend target
 * @return        null when the lib is honestly available, else the positioned compile error
 * @throws        when the lib is unpointed-at (cross) or its named path is absent (R4, M.3)
 * @since 0.3.1
 */
fn static_lib_locality_error(e: ExternLibEntry, target: NativeTarget) -> null | error {
    let tname = target_name(target)
    let path = lib_spec_path(e.flag)
    if path.len == 0 {
        if !cross_note(target).is_cross { return null }
        return error { message = $"[extern.libs] static lib {e.key} is not pointed at for target {tname}: a cross static lib must name a file present locally — declare it as [extern.libs.{tname}] {e.key} = [static:<path>] (R4, M.3)" }
    }
    if lib_file_present(path) { return null }
    error { message = $"[extern.libs] static lib {e.key} for target {tname} is not present locally: {path} (R4, M.3)" }
}

/**
 * validate_static_libs_for_target — M.3/R4: every `static:` lib that applies to the resolved
 * target must be pointed at for that target AND present locally, surfaced HERE as a positioned
 * COMPILE error naming the lib, the target and the missing path — never deferred to an opaque `ld`
 * failure. `shared:` libs follow the §5 fail-or-`--allow-undef` rule
 * (`validate_shared_libs_for_target`), not this one; a manifest with no `static:` declaration is a
 * no-op.
 *
 * @param m       the parsed manifest (global + per-section `[extern.libs]` columns)
 * @param target  the resolved own-backend target
 * @return        null when every applicable static lib is available, else the FIRST honest error
 * @throws        when an applicable static lib is unpointed-at or absent (R4, M.3)
 * @since 0.3.1
 */
fn validate_static_libs_for_target(m: Manifest, target: NativeTarget) -> null | error {
    let entries = applicable_extern_libs(m, target)
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_STATIC {
            match static_lib_locality_error(entries[i], target) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

/**
 * is_import_lib_path — does `path` name a PE import library (a `.lib` or `.a` import stub)? The one
 * thing that lets a COFF link reference a DLL at all, so it is what the R5 COFF rule looks for.
 *
 * @param path  the declared library path
 * @return      true iff the path names an import-library file
 * @since 0.3.1
 */
fn is_import_lib_path(path: str) -> bool {
    teko::str::ends_with(path, ".lib") || teko::str::ends_with(path, ".a")
}

/**
 * shared_lib_link_error — the R5 verdict for ONE shared declaration. PE/COFF first: the
 * transitional `link.exe`/`lld-link` cannot reference a DLL without an import library and will not
 * invent one, so a cross `shared:` on `x86_64-windows` that names no import lib is a NAMED honest
 * stop EVEN WITH `--allow-undef` (§5.2 — the E1 own import-table writer closes this, and the
 * message says so; fabricating an import table in the transitional path is not on the table). Then
 * the general rule: a NAMED path that is absent FAILS by default and is permitted only under the
 * explicit `--allow-undef` blind link. A bare `-l<name>` gets no compile-time verdict — the linker
 * searches its own (or the cross toolchain's) paths and its "cannot find -l<name>" IS the R5
 * fail-loud default; `--allow-undef` never suppresses that, it only permits undefined symbols.
 *
 * @param e            the applicable shared declaration
 * @param target       the resolved own-backend target
 * @param allow_undef  whether this build carries the `--allow-undef` opt-in
 * @return             null when the link may honestly proceed, else the compile error / named stop
 * @throws             on a missing named shared lib without `--allow-undef`, or the COFF import-lib gap
 * @since 0.3.1
 */
fn shared_lib_link_error(e: ExternLibEntry, target: NativeTarget, allow_undef: bool) -> null | error {
    let tname = target_name(target)
    let path = lib_spec_path(e.flag)
    if target_objfmt(target) == OBJFMT_COFF && cross_note(target).is_cross && !is_import_lib_path(path) {
        return error { message = $"[extern.libs] shared lib {e.key} cannot be linked for target {tname}: PE/COFF references a DLL only through an import library, which the transitional system linker will not synthesize — point at one ([extern.libs.{tname}] {e.key} = [shared:<path>.lib]); --allow-undef does not lift this (E1's own import-table writer does)" }
    }
    if path.len == 0 { return null }
    if lib_file_present(path) { return null }
    if allow_undef { return null }
    error { message = $"[extern.libs] shared lib {e.key} for target {tname} is not present locally: {path} — supply the library, or pass {ALLOW_UNDEF_FLAG} to link blind and resolve it at load time on the target (R5, M.3)" }
}

/**
 * validate_shared_libs_for_target — M.3/R5: the DEFAULT is to FAIL when an applicable `shared:`
 * lib cannot be linked here; `--allow-undef` is the sole, explicit escape (owner ruling
 * 2026-07-24, §5.0 — never a silent blind link). Delegates each applicable declaration to
 * `shared_lib_link_error`; a manifest with no `shared:` declaration is a no-op.
 *
 * @param m            the parsed manifest (global + per-section `[extern.libs]` columns)
 * @param target       the resolved own-backend target
 * @param allow_undef  whether this build carries the `--allow-undef` opt-in
 * @return             null when every applicable shared lib may honestly link, else the FIRST error
 * @throws             on a missing named shared lib without the opt-in, or the COFF import-lib gap
 * @since 0.3.1
 */
fn validate_shared_libs_for_target(m: Manifest, target: NativeTarget, allow_undef: bool) -> null | error {
    let entries = applicable_extern_libs(m, target)
    mut i: u64 = 0
    loop {
        if i >= entries.len { break }
        if entries[i].mode == LINK_MODE_SHARED {
            match shared_lib_link_error(entries[i], target, allow_undef) { error as err => return err; null => { } }
        }
        i = i + 1
    }
    null
}

/**
 * validate_extern_libs_for_target — the build's single M.3 pre-link gate: apply the R4 static rule
 * and the R5 shared rule to the target THIS build resolved, with the `--allow-undef` opt-in read
 * from this invocation. Called before any artifact is emitted, so an unavailable cross lib is a
 * positioned compile error instead of an opaque linker failure half a pipeline later.
 *
 * @param m  the resolved manifest
 * @return   null when the link may honestly proceed, else the first R4/R5 error
 * @throws   per `validate_static_libs_for_target` / `validate_shared_libs_for_target`
 * @since 0.3.1
 */
fn validate_extern_libs_for_target(m: Manifest) -> null | error {
    let target = resolved_target()
    match validate_static_libs_for_target(m, target) { error as e => return e; null => { } }
    validate_shared_libs_for_target(m, target, allow_undef_selected())
}

