
/**
 * encode_lfuncs_in_region_x86 — encode a LIST of `LFunc` (an item's own top-level function plus
 * its newly lifted closures/thunks) inside the scratch region the caller has already entered, each
 * one through the proved `encode_lfunc_in_region_x86` pipeline (isel → regalloc → encode). The
 * fused native lowering driver (C6.3) calls this BEFORE `region_leave()`; every returned
 * `EncodedFuncX86`'s `str` fields may still reference this region's memory — the caller commits
 * through `fold_encoded_funcs_x86` (which copies) AFTER leaving, before the region drops.
 *
 * @param fs  the item's lowered functions, in emission order
 * @return    one `EncodedFuncX86` per function, or the first propagated honest-stop
 * @since 0.3.1 C6.2
 */
pub fn encode_lfuncs_in_region_x86(fs: []teko::lir::LFunc) -> []teko::backend::EncodedFuncX86 | error {
    mut out: []teko::backend::EncodedFuncX86 = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= fs.len { break }
        let ef = match encode_lfunc_in_region_x86(fs[i]) { teko::backend::EncodedFuncX86 as x => x; error as e => return e }
        out = teko::list::push(out, ef)
        i++
    }
    out
}
