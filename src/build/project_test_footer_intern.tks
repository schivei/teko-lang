use teko::checker
use teko::coverage

// src/build/project.tks   (namespace 'teko::build')
//
// The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// the directory resolution in main.c (project_dir_of). main.tks dispatches here:
//   teko build <dir>  → compile_project  (front-end → native codegen)
//   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
//   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
//
// FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// diverged to is retired, #524).


    let exe = self_exe_path()
    let m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    drive_regression_tier(exe, m)
}

/**
 * enter_project_manifest — chdir into the project and read ITS MANIFEST ALONE. The driver needs
 * the project's name, its regressor list and its gate flag; it must NOT need the checked program,
 * which is the whole point of the staging.
 *
 * @param dir  the project directory
 * @return     the parsed manifest
 * @throws     "cannot enter project directory", the missing/ambiguous `.tkp` message, or the
 *             manifest parse error
 * @since 0.3.1.0
 */
fn enter_project_manifest(dir: str) -> Manifest | error {
    match teko::env::chdir(dir) { error => return error { message = "cannot enter project directory" }; null => { } }
    let mname = match find_manifest() { str as n => n; error as e => return e }
    let mtext = match teko::io::read_file(mname) { str as s => s; error => return error { message = "cannot read .tkp manifest" } }
    parse_manifest(mtext)
}

/**
 * test_stage_build — STAGE 1: assemble the project WITH its `.tkt` tests, report the D4
 * arith-cast-rate number (a property of the typed source alone, so it prints before anything can
 * fail), build the gate binary through the own-AOT-backend native test gate (0.3.1.0
 * tests-native-no-c — no `.c` translation unit, no `cc`-COMPILE of the test program; see
 * `native_gate_build`'s doc), and build the instrumented regression compiler from the same program.
 * Then RETURN — the caller is `main`, the process exits, and the operating system takes the arena
 * back.
 *
 * Parses + checks EXPLICITLY (`frontend_parse` + `frontend_check`, rather than the
 * `project_frontend_sel` convenience) so `pf` — the gate's UN-typed parse — survives to
 * `native_gate_build`, which needs it to splice the harness in and re-check
 * (`native_gate_program`). Mirrors the exact two-call shape `compile_project_g` already uses for
 * the same reason.
 *
 * @param dir  the project directory
 * @return     0 when both binaries are built, else the failing status
 * @throws     the front-end's first error, or the parse/check/`emit_native` failure (already reported)
 * @since 0.3.1.0
 */
fn test_stage_build(dir: str) -> i32 {
    ensure_rt_dir_abs()
    match teko::env::chdir(dir) { error => return fail(dir, "cannot enter project directory"); null => { } }
    let tty = output_is_tty(false)
    let pf = match frontend_parse(true, false, tty) { ParsedFront as x => x; error as e => return fail(dir, e.message) }
    let fe = match frontend_check(pf, false, tty) { Frontend as x => x; error as e => return fail(dir, e.message) }
    report_arith_cast_rate(fe)
    let smrc = emit_sitemap_file(dir, GATE_OUT_DIR, fe.manifest, fe.prog)
    if smrc != 0 { return smrc }
    let brc = native_gate_build(dir, GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, fe.manifest), pf, fe.manifest, tty)
    if brc != 0 { return brc }
    build_regression_feed_exe(fe.manifest, fe.prog)
    0
}

/**
 * sitemap_path — the coverage site-map the build stage emits and the report stage reads
 * (`<od>/<name>.tksites`), beside the gate binary.
 *
 * @param od  the output directory (trailing separator tolerated — see `gate_out_dir`)
 * @param m   the resolved manifest (its `name` is the file stem)
 * @return    the site-map file path
 * @since 0.3.1
 */
fn sitemap_path(od: str, m: Manifest) -> str {
    teko::str::concat(gate_out_dir(od), "/", m.name, ".tksites")
}

/**
 * emit_sitemap_file — serialize the coverage site-map of the checked program and write it beside the
 * gate binary, so the report stage can render coverage by a table join instead of re-checking the
 * whole compiler (C4 — the removal of the report stage's ~3 GB AST re-load). Emitted in the BUILD
 * stage, which already holds the typed program; the report stage never rebuilds it.
 *
 * @param dir   the project directory (for the diagnostic prefix)
 * @param od    the output directory the gate binary lands under
 * @param m     the resolved manifest
 * @param prog  the checked program the site-map is serialized from
 * @return      0 on a successful write, else the write's failing status
 * @throws      the write failure's message (already prefixed by `fail`)
 * @since 0.3.1
 */
fn emit_sitemap_file(dir: str, od: str, m: Manifest, prog: checker::TProgram) -> i32 {
    match teko::fs::mkdir(gate_out_dir(od)) { error => return fail(dir, "cannot create the output directory"); null => { } }
    let blob = coverage::cov_emit_sitemap(prog)
    match teko::io::write_file(sitemap_path(od, m), blob) { error as e => return fail(dir, e.message); null => { } }
    0
}

/**
 * read_sitemap — read and parse the coverage site-map the build stage wrote. A missing or corrupt
 * file yields an error so the report stage can fall back to a re-check rather than mis-report.
 *
 * @param od  the output directory the site-map lives under
 * @param m   the resolved manifest (its `name` is the file stem)
 * @return    the parsed site-map, or the read/parse error
 * @throws    "cannot read the coverage site-map …" when the file is absent, or the parse error
 * @since 0.3.1
 */
fn read_sitemap(od: str, m: Manifest) -> coverage::SiteMap | error {
    let path = sitemap_path(od, m)
    let blob = match teko::io::read_file(path) { str as s => s; error => return error { message = teko::str::concat("cannot read the coverage site-map ", path) } }
    coverage::cov_parse_sitemap(blob)
}

/**
 * print_journal_summary — the cross-phase journal summary block (journal J4 §13.4), read from THIS
 * run's own journal (`fold`+`summarize`, journal wiring 0.3.1) and completed with the coverage this
 * stage already merged from the site-map (`with_coverage`).
 *
 * PRINTS UNCONDITIONALLY, even when a gate further down this function fails — a survivable,
 * replayable record of what happened is exactly the property the journal exists for (§1.3), and a
 * summary that only ever appeared on a green run would defeat it. Called BEFORE any gate decision in
 * `test_stage_report`.
 *
 * REACHES BOTH PHASES BECAUSE `TEKO_RUN` IS INHERITED, NOT BECAUSE IT IS RE-DERIVED: `test_drive`
 * mints (or reads an already-inherited) run stamp via `teko::journal::run_id()` before it spawns the
 * build/gate/regression/report stages, and `tk_rt_spawn_redirected`'s `fork` carries the WHOLE
 * parent environment to each — so the gate's `s<shard>` segments and the regression tier's `r0`
 * segment, written by three DIFFERENT processes, land under the SAME `run_root()` this stage folds.
 *
 * `cov_missing` IS 0 HERE, NOT BECAUSE NOTHING CAN GO MISSING, BUT BECAUSE THIS FUNCTION NEVER
 * REACHES THIS LINE WHEN IT DID: `merge_gate_coverage` (above, in `test_stage_report`) already
 * returns `fail(dir, ...)` the moment a unit-gate shard left no dump (J4 §2.4), before this call
 * runs. A REAL `cov_missing` for the REGRESSION tier is not yet threaded through
 * `merge_regression_coverage`'s own best-effort walk — a gap named here rather than pretended away.
 *
 * @param sm  the site-map this stage already read
 * @since 0.3.1
 */
fn print_journal_summary(sm: coverage::SiteMap) {
    let recs = teko::journal::fold(teko::journal::run_root(), teko::journal::run_id())
    let base = teko::journal::summarize(recs)
    let cov = teko::journal::CovTriple {
        functions_cov = coverage::functions_coverage_of(sm).cov
        functions_val = coverage::functions_coverage_of(sm).val
        lines_cov = coverage::line_coverage_of(sm).cov
        lines_val = coverage::line_coverage_of(sm).val
        branches_cov = coverage::branch_coverage_of(sm).cov
        branches_val = coverage::branch_coverage_of(sm).val
    }
    teko::io::println(teko::journal::render_summary(teko::journal::with_coverage(base, cov, 0)))
}

//
// test_stage_report — STAGE 3: the verdict. Read the MANIFEST alone and the build stage's coverage
// SITE-MAP, fold in the gate's dumps and then the regression tier's, and render coverage by JOINING
// the site-map against the merged sink — never re-checking the source. Then apply the policies in
// their historic precedence.
//
// WHY THERE IS NO LONGER A RE-CHECK ON THE GATE PATH (C4). Stage 1 held the checked program, but the
// coverage it must be read against does not exist until the gate and the regressors have RUN — after
// stage 1 exits, by design. The report used to re-check the WHOLE compiler purely to walk its AST
// for the site-id → file:line table (the ~3 GB / ~4.5 GB peak that OOM-killed the macOS-arm64 leg
// right after `recheck ✓`). Stage 1 now serializes that table (`cov_emit_sitemap`) beside the gate,
// and this stage renders coverage and the D4 arith-cast verdict from it plus the merged sink — a
//
