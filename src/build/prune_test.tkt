use teko::parser

fn env_linux_x64(): CcEnv {
    CcEnv { os = "linux"; arch = "x86_64"; build_flags = teko::list::empty() }
}

fn env_macos_arm64(): CcEnv {
    CcEnv { os = "macos"; arch = "arm64"; build_flags = teko::list::empty() }
}

fn env_with_flag(flag: str): CcEnv {
    CcEnv { os = "linux"; arch = "x86_64"; build_flags = teko::list::push(teko::list::empty(), flag) }
}

#test
fn prune_ptrue_is_always_kept() {
    teko::assert::is_true(eval_pred(parser::pred_true(), env_linux_x64()))
    teko::assert::is_true(eval_pred(parser::pred_true(), env_macos_arm64()))
}

#test
fn prune_os_axis_matches_only_its_os() {
    teko::assert::is_true(eval_pred(parser::pred_os("linux"), env_linux_x64()))
    teko::assert::is_false(eval_pred(parser::pred_os("macos"), env_linux_x64()))
    teko::assert::is_true(eval_pred(parser::pred_os("macos"), env_macos_arm64()))
}

#test
fn prune_arch_axis_matches_only_its_arch() {
    teko::assert::is_true(eval_pred(parser::pred_arch("x86_64"), env_linux_x64()))
    teko::assert::is_false(eval_pred(parser::pred_arch("arm64"), env_linux_x64()))
    teko::assert::is_true(eval_pred(parser::pred_arch("arm64"), env_macos_arm64()))
}

#test
fn prune_unknown_axis_never_matches() {
    var p = parser::Pred { kind = parser::PEq { axis = "cpu"; value = "x86_64" } }
    teko::assert::is_false(eval_pred(p, env_linux_x64()))
}

#test
fn prune_flag_present_vs_absent() {
    var p = parser::Pred { kind = parser::PFlag { name = "debug" } }
    teko::assert::is_true(eval_pred(p, env_with_flag("debug")))
    teko::assert::is_false(eval_pred(p, env_linux_x64()))
}

#test
fn prune_not_negates() {
    teko::assert::is_false(eval_pred(parser::pred_not(parser::pred_os("linux")), env_linux_x64()))
    teko::assert::is_true(eval_pred(parser::pred_not(parser::pred_os("macos")), env_linux_x64()))
}

#test
fn prune_and_truth_table() {
    var tt = parser::pred_and(parser::pred_os("linux"), parser::pred_arch("x86_64"))
    var tf = parser::pred_and(parser::pred_os("linux"), parser::pred_arch("arm64"))
    var ft = parser::pred_and(parser::pred_os("macos"), parser::pred_arch("x86_64"))
    var ff = parser::pred_and(parser::pred_os("macos"), parser::pred_arch("arm64"))
    teko::assert::is_true(eval_pred(tt, env_linux_x64()))
    teko::assert::is_false(eval_pred(tf, env_linux_x64()))
    teko::assert::is_false(eval_pred(ft, env_linux_x64()))
    teko::assert::is_false(eval_pred(ff, env_linux_x64()))
}

#test
fn prune_or_truth_table() {
    var tt = parser::pred_or(parser::pred_os("linux"), parser::pred_arch("x86_64"))
    var tf = parser::pred_or(parser::pred_os("linux"), parser::pred_arch("arm64"))
    var ft = parser::pred_or(parser::pred_os("macos"), parser::pred_arch("x86_64"))
    var ff = parser::pred_or(parser::pred_os("macos"), parser::pred_arch("arm64"))
    teko::assert::is_true(eval_pred(tt, env_linux_x64()))
    teko::assert::is_true(eval_pred(tf, env_linux_x64()))
    teko::assert::is_true(eval_pred(ft, env_linux_x64()))
    teko::assert::is_false(eval_pred(ff, env_linux_x64()))
}

#test
fn prune_composed_tree() {
    var inner = parser::pred_or(parser::pred_arch("arm64"), parser::Pred { kind = parser::PFlag { name = "debug" } })
    var tree = parser::pred_and(parser::pred_os("linux"), inner)
    teko::assert::is_false(eval_pred(tree, env_linux_x64()))
    teko::assert::is_true(eval_pred(tree, env_with_flag("debug")))
}
