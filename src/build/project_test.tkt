use teko::parser
use teko::checker

/**
 * dirname_of splits a POSIX path at the last '/' and returns "." for a separator-less name —
 * byte-identical to the '/'-only original.
 */
#test
fn pt_dirname_posix_is_byte_identical() {
    teko::assert::is_true(dirname_of("/a/b/c") == "/a/b")
    teko::assert::is_true(dirname_of("file") == ".")
}

/**
 * basename_of splits a POSIX or Windows path at the last separator and returns the whole path for
 * a separator-less name — the mirror of `dirname_of` (0.3.1 C0).
 */
#test
fn pt_basename_of_mirrors_dirname() {
    teko::assert::is_true(basename_of("/a/b/c") == "c")
    teko::assert::is_true(basename_of("file") == "file")
    teko::assert::is_true(basename_of("examples/regressions/cwd_build/cwd_build.tkr") == "cwd_build.tkr")
    teko::assert::is_true(basename_of("D:\\a\\b\\c.tkr") == "c.tkr")
}

/**
 * target_matches — does `target_from_name(name)` resolve to `want`? `false` when
 * `name` is unrecognized (the R2 honest error, owner ruling 2026-07-24) — the
 * shared assertion body every `target_from_name` golden below reduces to.
 *
 * @param str name  the raw `TEKO_TARGET` value to map
 * @param NativeTarget want  the expected mapped target
 * @return bool  `true` iff `target_from_name(name)` resolves to `want`
 */
fn target_matches(name: str, want: NativeTarget) -> bool {
    match target_from_name(name) { NativeTarget as t => t == want; error => false }
}

#test
/**
 * target_from_name_still_maps_the_pre_existing_targets — a non-regression
 * check on the ENUM extension (#389 C1-5 adds two arms to `NativeTarget`):
 * the pre-existing `x86_64-linux`/`x86_64-elf` mappings, and the canonical
 * `arm64-macos` name, still resolve exactly as before.
 *
 * @return void
 */
fn target_from_name_still_maps_the_pre_existing_targets() {
    teko::assert::is_true(target_matches("x86_64-linux", NativeTarget::X8664Linux))
    teko::assert::is_true(target_matches("x86_64-elf", NativeTarget::X8664Linux))
    teko::assert::is_true(target_matches("arm64-macos", NativeTarget::Arm64Macho))
}

#test
/**
 * target_from_name_rejects_unsupported_values — R2 (owner ruling 2026-07-24): an
 * unrecognized `TEKO_TARGET` value (a typo, or the empty string) is now an honest
 * COMPILE error naming the offending value and listing the supported set, never a
 * silent mis-lower to `Arm64Macho` (the pre-0.3.1 behavior `target_from_name_still_
 * maps_the_pre_existing_targets` used to also cover).
 *
 * @return void
 */
fn target_from_name_rejects_unsupported_values() {
    match target_from_name("bogus-target") {
        NativeTarget => teko::assert::is_true(false)
        error as e => {
            teko::assert::is_true(teko::str::contains(e.message, "bogus-target"))
            teko::assert::is_true(teko::str::contains(e.message, "x86_64-linux"))
        }
    }
    match target_from_name("") {
        NativeTarget => teko::assert::is_true(false)
        error as e => teko::assert::is_true(teko::str::contains(e.message, "supported targets"))
    }
}

/**
 * host_target_matches — does `host_target_for_os(os, arch)` resolve to `want`? `false` on the
 * honest R2 error, the shared assertion body every precise-pairing golden below reduces to
 * (mirrors `target_matches`'s own idiom for `target_from_name`).
 *
 * @param os    a `teko::os()` value
 * @param arch  a `teko::arch()` value
 * @param want  the expected mapped target
 * @return      `true` iff `host_target_for_os(os, arch)` resolves to `want`
 */
fn host_target_matches(os: str, arch: str, want: NativeTarget) -> bool {
    match host_target_for_os(os, arch) { NativeTarget as t => t == want; error => false }
}

/**
 * host_target_is_unsupported — does `host_target_for_os(os, arch)` honestly refuse the pair
 * (the R2 arm), naming both `os` and `arch` in its own message?
 *
 * @param os    a `teko::os()` value
 * @param arch  a `teko::arch()` value
 * @return      `true` iff the pair is refused, with `os`/`arch` both named in the message
 */
fn host_target_is_unsupported(os: str, arch: str) -> bool {
    match host_target_for_os(os, arch) {
        NativeTarget => false
        error as e => teko::str::contains(e.message, os) && teko::str::contains(e.message, arch)
    }
}

#test
/**
 * host_target_for_os_is_precise_for_every_supported_pair — Phase 2 of the two-phase host
 * default (owner ruling 2026-07-24, teko-target-crosslink-0.3.1.md §2.1, now that
 * `teko::arch()` is seed-recognized): `host_target_for_os` picks the ONE own-backend target
 * this backend has a real codegen pipeline for, keyed on BOTH `os` AND `arch` — simulating
 * every supported host without depending on which one this test actually runs on.
 *
 * `linux`+`arm64` is the FOURTH row, and it is the one that makes `linux` the first OS with
 * two arches: refusing it (which this resolver honestly did, because `Arm64Linux` did not
 * exist) is what left the arm64-Linux test leg green over rows it never ran.
 *
 * @return void
 */
fn host_target_for_os_is_precise_for_every_supported_pair() {
    teko::assert::is_true(host_target_matches("linux", "x86_64", NativeTarget::X8664Linux))
    teko::assert::is_true(host_target_matches("windows", "x86_64", NativeTarget::X8664Windows))
    teko::assert::is_true(host_target_matches("macos", "arm64", NativeTarget::Arm64Macho))
    teko::assert::is_true(host_target_matches("linux", "arm64", NativeTarget::Arm64Linux))
}

#test
/**
 * host_target_for_os_rejects_every_unsupported_pair — the R2 counterpart: teaching
 * `host_target_for_os` the architecture means an `(os, arch)` pair with no own-backend target
 * (an x86_64 macOS host, an arm64 windows host, or a wholly `unknown`
 * arch) is now an honest COMPILE-time refusal naming BOTH the offending `os` and `arch` — never
 * the pre-0.3.1-teko-arch silent mis-lower to the OS's dominant arch regardless of the host's
 * REAL arch (the exact bug class R1 exists to close, one dimension over from the original
 * linux-host-emits-arm64-Mach-O report).
 *
 * @return void
 */
fn host_target_for_os_rejects_every_unsupported_pair() {
    teko::assert::is_true(host_target_is_unsupported("macos", "x86_64"))
    teko::assert::is_true(host_target_is_unsupported("windows", "arm64"))
    teko::assert::is_true(host_target_is_unsupported("linux", "unknown"))
    teko::assert::is_true(host_target_is_unsupported("unknown", "unknown"))
}

#test
/**
 * host_target_for_os_guess_maps_every_known_os — the Phase-1 OS-only heuristic
 * (teko-target-crosslink-0.3.1.md §2.1), kept as `host_target_for_os_guess`: `linux` and
 * `windows` pick their own-backend x86-64 pipeline, while `macos` and any other (`unknown`)
 * value keep the pre-existing `Arm64Macho` default. Still the ALWAYS-TOTAL fallback
 * `host_default_target_guess`/`resolved_target`/`cross_note` fall back to on a host whose
 * precise (os, arch) pair has no own-backend target.
 *
 * @return void
 */
fn host_target_for_os_guess_maps_every_known_os() {
    teko::assert::is_true(host_target_for_os_guess("linux") == NativeTarget::X8664Linux)
    teko::assert::is_true(host_target_for_os_guess("windows") == NativeTarget::X8664Windows)
    teko::assert::is_true(host_target_for_os_guess("macos") == NativeTarget::Arm64Macho)
    teko::assert::is_true(host_target_for_os_guess("unknown") == NativeTarget::Arm64Macho)
}

#test
/**
 * host_default_target_matches_the_real_host — the LIVE seam: `host_default_target()` (real
 * `teko::os()`/`teko::arch()`) never disagrees with `host_target_for_os` applied to that same
 * (os, arch) pair, in EITHER arm. A host whose own pair has no own-backend target (an aarch64
 * linux host, an x86_64 macOS host, an arm64 windows host, …) is a LEGITIMATE live outcome, not a
 * test failure — the R2 error `host_default_target()` returns there must be the SAME honest
 * refusal `host_target_for_os` itself gives that exact pair, never a silent divergence between
 * the two.
 *
 * THE BUG THIS REPLACES (measured live on CI's `test / linux-arm64-glibc`, job 90725227419, run
 * 30495738831): the previous body asserted `false` on the error arm, on the unstated assumption
 * that every host this suite runs on is one of the three supported pairs. On an aarch64 linux
 * runner `host_target_for_os("linux", "arm64")` correctly refuses — that refusal IS this crumb's
 * own R1/R2 design, not a defect — so the assertion fired and, because a failed
 * `teko::assert::is_true` has no soft-fail path yet (SIGABRT, `cargo/0.3.1-envelope-e-assert`
 * owns that separately), it aborted the WHOLE test binary, not just this one case. Asserting the
 * EQUIVALENCE instead of a fixed arm is what makes this test host-agnostic: green on every host,
 * supported or not, without ever discovering which one it is running on.
 *
 * @return void
 */
fn host_default_target_matches_the_real_host() {
    match host_default_target() {
        NativeTarget as live => teko::assert::is_true(host_target_matches(teko::os(), teko::arch(), live))
        error => teko::assert::is_true(host_target_is_unsupported(teko::os(), teko::arch()))
    }
}

#test
/**
 * host_default_target_guess_falls_back_when_the_precise_pair_is_unsupported —
 * `host_default_target_guess` is ALWAYS total, and it PREFERS the precise resolver: on any host
 * whose (os, arch) pair has an own-backend target it answers exactly that target, and only on an
 * unsupported pair does it fall through to the OS-only Phase-1 guess. The assertion is on the
 * equivalence, in both arms, so it never assumes which host it is running on.
 *
 * WHY THIS CANNOT BE PINNED AGAINST `host_target_for_os_guess` ALONE ANYMORE: the previous body
 * asserted `host_default_target_guess() == host_target_for_os_guess(teko::os())` unconditionally,
 * on the stated assumption that "each of the three supported pairs IS its own OS's dominant arch,
 * by construction". `Arm64Linux` breaks that assumption — `linux` is now the first OS with TWO
 * supported arches — so on an arm64 Linux host the precise resolver answers `Arm64Linux` while
 * the OS-only guess still answers `X8664Linux`, and the two legitimately differ. Asserting the
 * PREFERENCE instead of the equality keeps the property that actually matters: this function
 * never crashes and never contradicts the precise resolver.
 *
 * @return void
 */
fn host_default_target_guess_falls_back_when_the_precise_pair_is_unsupported() {
    match host_default_target() {
        NativeTarget as precise => teko::assert::is_true(host_default_target_guess() == precise)
        error => teko::assert::is_true(host_default_target_guess() == host_target_for_os_guess(teko::os()))
    }
}

/**
 * args_of — build a `[]str` CLI argument vector from up to three tokens, dropping any that is "" so
 * a test can pass fewer than three. The shared fixture for the optimization-flag parse tests below.
 *
 * @param a  the first token (dropped when "")
 * @param b  the second token (dropped when "")
 * @param c  the third token (dropped when "")
 * @return   the assembled argument vector
 */
fn args_of(a: str, b: str, c: str) -> []str {
    mut v: []str = teko::list::empty()
    if a != "" { v = teko::list::push(v, a) }
    if b != "" { v = teko::list::push(v, b) }
    if c != "" { v = teko::list::push(v, c) }
    v
}

#test
/**
 * opt_cc_flag_maps_levels_to_flags — level 0 emits NO flag (""), level 1 `-O1`, level 2 `-O2`, and
 * an out-of-range level clamps to `-O2` — the exact strings `build_cc_argv` appends to the cc line.
 *
 * @return void
 */
fn opt_cc_flag_maps_levels_to_flags() {
    teko::assert::is_true(opt_cc_flag(0) == "")
    teko::assert::is_true(opt_cc_flag(1) == "-O1")
    teko::assert::is_true(opt_cc_flag(2) == "-O2")
    teko::assert::is_true(opt_cc_flag(3) == "-O2")
}

#test
/**
 * project_arg_of_skips_optimization_flags — `--release` and `--opt=<n>` are recognized build flags,
 * so `project_arg_of` steps over them and still finds the project positional after them.
 *
 * @return void
 */
fn project_arg_of_skips_optimization_flags() {
    teko::assert::is_true(project_arg_of(args_of("--release", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of("--opt=2", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of(".", "--release", ""), 0) == ".")
}

#test
/**
 * is_backend_flag_detects_both_retired_spellings — the retired `--backend` flag
 * (owner ruling 2026-07-24) is recognized in both its two-token (`--backend native`)
 * and single-token (`--backend=native`/`--backend=c`) spellings, so `has_backend_flag`
 * can reject the whole line honestly; an ordinary positional or an unrelated flag is
 * NOT mistaken for it.
 *
 * @return void
 */
fn is_backend_flag_detects_both_retired_spellings() {
    teko::assert::is_true(is_backend_flag("--backend"))
    teko::assert::is_true(is_backend_flag("--backend=native"))
    teko::assert::is_true(is_backend_flag("--backend=c"))
    teko::assert::is_true(!is_backend_flag("proj"))
    teko::assert::is_true(!is_backend_flag("--release"))
}

#test
/**
 * has_backend_flag_scans_from_start — `has_backend_flag` finds a `--backend`
 * occurrence anywhere from `start` onward (both spellings), and reports absent when
 * the line carries none.
 *
 * @return void
 */
fn has_backend_flag_scans_from_start() {
    teko::assert::is_true(has_backend_flag(args_of("--backend=native", "proj", ""), 0))
    teko::assert::is_true(has_backend_flag(args_of("--backend", "native", "proj"), 0))
    teko::assert::is_true(!has_backend_flag(args_of(".", "--release", ""), 0))
}

#test
/**
 * project_arg_of_no_longer_recognizes_backend — since `--backend` was removed as CLI
 * surface (owner ruling 2026-07-24, rejected upstream by `has_backend_flag` before
 * `project_arg_of` ever runs), `project_arg_of` itself no longer special-cases it: a
 * stray `--backend=native` now falls through as an (unknown) positional, exactly the
 * honest "not a project" signal `--vm-gate` already gets (#524, M3).
 *
 * @return void
 */
fn project_arg_of_no_longer_recognizes_backend() {
    teko::assert::is_true(project_arg_of(args_of("--backend=native", "proj", ""), 0) == "--backend=native")
}

/**
 * debug_matches — does `debug_info_of(args)` resolve to `want`? `false` on an unrecognised
 * `--debug=` value — the shared assertion body the D1.6 golden tests below reduce to.
 *
 * @param args  the CLI argument vector to resolve
 * @param want  the expected `DebugInfo` level
 * @return      true iff `debug_info_of(args)` resolves to `want`
 */
fn debug_matches(args: []str, want: DebugInfo) -> bool {
    match debug_info_of(args) { DebugInfo as d => d == want; error => false }
}

#test
/**
 * debug_arg_has_prefix_detects_the_selector — `--debug=` is recognized with anything after it,
 * and an ordinary positional or an unrelated flag is NOT mistaken for it — the 8-byte guard
 * mirroring `opt_arg_has_prefix`'s 6-byte one.
 *
 * @return void
 */
fn debug_arg_has_prefix_detects_the_selector() {
    teko::assert::is_true(debug_arg_has_prefix("--debug=lines"))
    teko::assert::is_true(debug_arg_has_prefix("--debug=none"))
    teko::assert::is_true(debug_arg_has_prefix("--debug=bogus"))
    teko::assert::is_true(!debug_arg_has_prefix("--debug"))
    teko::assert::is_true(!debug_arg_has_prefix("--opt=2"))
    teko::assert::is_true(!debug_arg_has_prefix("proj"))
}

#test
/**
 * debug_info_of_value_maps_none_and_lines_and_errors_otherwise — "none" and "lines" resolve to
 * their levels; every other value (unlike `opt_level_of_value`, which resolves a malformed
 * suffix to level 2) is a HARD error naming both accepted values — no silent coercion.
 *
 * @return void
 */
fn debug_info_of_value_maps_none_and_lines_and_errors_otherwise() {
    teko::assert::is_true(match debug_info_of_value("none") { DebugInfo as d => d == DebugInfo::None; error => false })
    teko::assert::is_true(match debug_info_of_value("lines") { DebugInfo as d => d == DebugInfo::Lines; error => false })
    teko::assert::is_true(match debug_info_of_value("vars") { DebugInfo => false; error as e => teko::str::contains(e.message, "accepted: none, lines") })
    teko::assert::is_true(match debug_info_of_value("") { DebugInfo => false; error => true })
}

#test
/**
 * debug_info_of_defaults_to_none_and_takes_the_last_flag — with no `--debug=` flag the level is
 * `None` (never imposed, `--release` included, matching `opt_level_of`'s "no flag" default);
 * with the flag present it resolves to the requested level, and the LAST occurrence on the
 * line wins — the same rule `opt_level_of` follows under repetition.
 *
 * @return void
 */
fn debug_info_of_defaults_to_none_and_takes_the_last_flag() {
    teko::assert::is_true(debug_matches(args_of(".", "--release", ""), DebugInfo::None))
    teko::assert::is_true(debug_matches(args_of("--debug=lines", ".", ""), DebugInfo::Lines))
    teko::assert::is_true(debug_matches(args_of("--debug=none", ".", ""), DebugInfo::None))
    teko::assert::is_true(debug_matches(args_of("--debug=lines", "--debug=none", "."), DebugInfo::None))
}

#test
/**
 * project_arg_of_skips_debug_flag — `--debug=<value>` is a recognized build flag, so
 * `project_arg_of` steps over it and still finds the project positional after it — the same
 * trap `--opt=` already proved (§7.1 of the design doc: a flag absent from this list is read
 * as the project path, silently).
 *
 * @return void
 */
fn project_arg_of_skips_debug_flag() {
    teko::assert::is_true(project_arg_of(args_of("--debug=lines", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of("--debug=none", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of(".", "--debug=lines", ""), 0) == ".")
}

#test
/**
 * has_bare_g_flag_scans_from_start — `has_bare_g_flag` finds a bare `-g` occurrence anywhere
 * from `start` onward, and reports absent when the line carries none — including when it only
 * carries the (unrelated) `--debug=lines` spelling, the precedent `has_backend_flag` set.
 *
 * @return void
 */
fn has_bare_g_flag_scans_from_start() {
    teko::assert::is_true(has_bare_g_flag(args_of("-g", "proj", ""), 0))
    teko::assert::is_true(has_bare_g_flag(args_of("proj", "-g", ""), 0))
    teko::assert::is_true(!has_bare_g_flag(args_of(".", "--debug=lines", ""), 0))
    teko::assert::is_true(!has_bare_g_flag(args_of(".", "--release", ""), 0))
}

/** pt_push_u64le — append `v` as 8 little-endian bytes (the `.tkcov` wire form) to `b`. */
fn pt_push_u64le(b: []byte, v: u64) -> []byte {
    mut out = b
    mut x = v
    mut i: u64 = 0
    loop {
        if i >= 8 { break }
        out = teko::list::push(out, (x & 255) to byte)
        x = x >> 8
        i++
    }
    out
}

/** pt_tkcov_section — append a `.tkcov` id section (u64 count then the ids) to `b`. */
fn pt_tkcov_section(b: []byte, ids: []u64) -> []byte {
    mut out = pt_push_u64le(b, ids.len)
    mut i: u64 = 0
    loop {
        if i >= ids.len { break }
        out = pt_push_u64le(out, ids[i])
        i++
    }
    out
}

/** pt_tkcov — a well-formed `.tkcov` byte buffer (as a `str`) with the given fn/branch/line sections. */
fn pt_tkcov(fns: []u64, branches: []u64, lines: []u64) -> str {
    mut b: []byte = teko::list::empty()
    b = teko::list::push(b, b'T'); b = teko::list::push(b, b'K'); b = teko::list::push(b, b'C')
    b = teko::list::push(b, b'O'); b = teko::list::push(b, b'V'); b = teko::list::push(b, b'1')
    b = teko::list::push(b, 0 to byte); b = teko::list::push(b, 0 to byte)
    b = pt_tkcov_section(b, fns)
    b = pt_tkcov_section(b, branches)
    b = pt_tkcov_section(b, lines)
    str(b)
}

/** pt_ids — a `[]u64` from three ids (a small fixture helper). */
fn pt_ids3(a: u64, b: u64, c: u64) -> []u64 {
    teko::list::push(teko::list::push(teko::list::push(teko::list::empty(), a), b), c)
}

/** pt_ids1 — a single-id `[]u64` fixture (the `u64` parameter forces the literal's width). */
fn pt_ids1(a: u64) -> []u64 { teko::list::push(teko::list::empty(), a) }

/** pt_ids2 — a two-id `[]u64` fixture. */
fn pt_ids2(a: u64, b: u64) -> []u64 { teko::list::push(pt_ids1(a), b) }

/** analyzer_of recognizes `--analyzer` and ignores its absence. */
#test
fn pt_analyzer_of_flag() {
    let with = teko::list::push(teko::list::push(teko::list::empty(), "test"), "--analyzer")
    teko::assert::is_true(analyzer_of(with))
    let without = teko::list::push(teko::list::empty(), "test")
    teko::assert::is_false(analyzer_of(without))
}

/** tkcov_ids merges the three sections and dedups shared ids; a bad magic yields no ids. */
#test
fn pt_tkcov_ids_merges_and_dedups() {
    let fns = pt_ids2(1, 2)
    let branches = pt_ids1(3)
    let lines = pt_ids1(1)
    let ids = tkcov_ids(pt_tkcov(fns, branches, lines))
    teko::assert::is_true(ids.len == 3)
    teko::assert::is_true(tkcov_ids("bad").len == 0)
}

/** dedup_ids keeps each id once in first-seen order; ids_contains backs it. */
#test
fn pt_dedup_ids() {
    let dup = pt_ids3(7, 7, 9)
    let uniq = dedup_ids(dup)
    teko::assert::is_true(uniq.len == 2)
    teko::assert::is_true(ids_contains(uniq, 9))
    teko::assert::is_false(ids_contains(uniq, 4))
}

/** classify_test: no ids ⇒ STALE, all shared ⇒ REDUNDANT, a unique id ⇒ LIVE. */
#test
fn pt_classify_test_axes() {
    let unique = pt_ids1(1)
    let shared_a = pt_ids1(2)
    let shared_b = pt_ids1(2)
    let all = concat_ids(concat_ids(unique, shared_a), shared_b)
    teko::assert::is_true(verdict_text(classify_test(teko::list::empty(), all)) == "STALE")
    teko::assert::is_true(verdict_text(classify_test(shared_a, all)) == "REDUNDANT")
    teko::assert::is_true(verdict_text(classify_test(unique, all)) == "LIVE")
}

/** combined_status crosses the coverage axis with the assertion-fold axis, most-severe first. */
#test
fn pt_combined_status_precedence() {
    teko::assert::is_true(status_text(combined_status(Verdict::Live, 2, 1)) == "MISLEADING")
    teko::assert::is_true(status_text(combined_status(Verdict::Stale, 2, 2)) == "FOUNDATIONAL")
    teko::assert::is_true(status_text(combined_status(Verdict::Stale, 1, 0)) == "DEAD")
    teko::assert::is_true(status_text(combined_status(Verdict::Redundant, 1, 0)) == "REDUNDANT")
    teko::assert::is_true(status_text(combined_status(Verdict::Live, 1, 0)) == "LIVE")
}

/**
 * test_gate_precedence — the gate's own status (`trc`) is STILL the highest-precedence failure,
 * unchanged, no matter what the floor/per-commit/regression statuses are; a passing gate falls
 * through to the floor status, then per-commit, then the regression tier (ignored entirely when
 * `has_regr` is false, even if `regr_rc` carries a stray non-zero value); all-zero is 0.
 */
#test
fn pt_test_gate_precedence_defers_to_the_gate_first() {
    teko::assert::is_true(test_gate_precedence(7, 1, 1, true, 1) == 7)
    teko::assert::is_true(test_gate_precedence(0, 3, 1, true, 1) == 3)
    teko::assert::is_true(test_gate_precedence(0, 0, 5, true, 1) == 5)
    teko::assert::is_true(test_gate_precedence(0, 0, 0, true, 9) == 9)
    teko::assert::is_true(test_gate_precedence(0, 0, 0, false, 9) == 0)
    teko::assert::is_true(test_gate_precedence(0, 0, 0, true, 0) == 0)
    teko::assert::is_true(test_gate_precedence(0, 0, 0, false, 0) == 0)
}

/** analyzer_report renders header, per-test lines with asserts=, and a per-status summary. */
#test
fn pt_analyzer_report_shape() {
    let unique = pt_ids1(1)
    let shared_a = pt_ids1(2)
    let shared_b = pt_ids1(2)
    mut recs: []TestRecord = teko::list::push(teko::list::empty(), TestRecord { label = "a::live"; ids = concat_ids(unique, shared_a); asserts_total = 1; asserts_folded = 0 })
    recs = teko::list::push(recs, TestRecord { label = "a::red"; ids = shared_b; asserts_total = 1; asserts_folded = 0 })
    recs = teko::list::push(recs, TestRecord { label = "a::found"; ids = teko::list::empty(); asserts_total = 1; asserts_folded = 1 })
    let report = analyzer_report(recs)
    teko::assert::is_true(teko::str::contains(report, "ADVISORY"))
    teko::assert::is_true(teko::str::contains(report, "analyzer a::live ids=2 asserts=1/0 status=LIVE"))
    teko::assert::is_true(teko::str::contains(report, "status=REDUNDANT"))
    teko::assert::is_true(teko::str::contains(report, "status=FOUNDATIONAL"))
    teko::assert::is_true(teko::str::contains(report, "1 FOUNDATIONAL"))
}
/**
 * cov_validation_of detects `--cov-validation` anywhere on the line and is absent otherwise — the
 * opt-in that flips the D4 coverage floors from a warning to a hard failure (owner ruling 0.3.0.29).
 */
#test
fn pt_cov_validation_of_detects_the_flag() {
    teko::assert::is_true(cov_validation_of(args_of("build", "--cov-validation", ".")))
    teko::assert::is_true(cov_validation_of(args_of("--cov-validation", "build", ".")))
    teko::assert::is_false(cov_validation_of(args_of("build", ".", "-o")))
    teko::assert::is_false(cov_validation_of(args_of("test", ".", "")))
}

/**
 * per_test_cov_of detects `--per-test-cov` anywhere on the line and is absent otherwise — the
 * dev-time per-test attribution knob (owner ruling 0.3.0.29 — the T2 lever), off by default.
 */
#test
fn pt_per_test_cov_of_detects_the_flag() {
    teko::assert::is_true(per_test_cov_of(args_of("test", "--per-test-cov", ".")))
    teko::assert::is_true(per_test_cov_of(args_of("--per-test-cov", "test", ".")))
    teko::assert::is_false(per_test_cov_of(args_of("test", ".", "--coverage")))
    teko::assert::is_false(per_test_cov_of(args_of("build", ".", "")))
}

/**
 * project_arg_of skips the two 0.3.0.29 coverage knobs (`--cov-validation`, `--per-test-cov`) — both
 * value-less flags — so neither is ever mistaken for the project positional.
 */
#test
fn pt_project_arg_of_skips_the_coverage_knobs() {
    teko::assert::is_true(project_arg_of(args_of("--cov-validation", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of("--per-test-cov", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of(".", "--cov-validation", "--per-test-cov"), 0) == ".")
}

/**
 * coverage_floor_blocks encodes the whole `--cov-validation` policy: a run BELOW a floor is a
 * non-blocking pass by default (validation off → never blocks) and a hard failure only when
 * validation is opted in; a run that MEETS every floor never blocks regardless of the flag.
 */
#test
fn pt_coverage_floor_blocks_is_opt_in() {
    let below = unmet_coverage_floors(10, 10, 10, 50, 50, 49)
    let met = unmet_coverage_floors(90, 90, 90, 50, 50, 49)
    teko::assert::is_false(coverage_floor_blocks(below, false))
    teko::assert::is_true(coverage_floor_blocks(below, true))
    teko::assert::is_false(coverage_floor_blocks(met, false))
    teko::assert::is_false(coverage_floor_blocks(met, true))
}

/**
 * per_test_cov_report_str prints the fixed header then one newline-terminated row per test, in order.
 * An empty row set yields the header alone — the report shape the `--per-test-cov` fixture asserts.
 */
#test
fn pt_per_test_cov_report_str_shape() {
    teko::assert::is_true(per_test_cov_report_str(teko::list::empty()) == "teko: per-test coverage attribution\n")
    mut rows: []PerTestCoverage = teko::list::empty()
    rows = teko::list::push(rows, PerTestCoverage { label = "a"; functions = 10; lines = 20; branches = 30 })
    rows = teko::list::push(rows, PerTestCoverage { label = "b"; functions = 1; lines = 2; branches = 3 })
    let out = per_test_cov_report_str(rows)
    teko::assert::str_contains(out, "teko: per-test coverage attribution\n")
    teko::assert::str_contains(out, "per-test-cov a functions=10% lines=20% branches=30%\n")
    teko::assert::str_contains(out, "per-test-cov b functions=1% lines=2% branches=3%\n")
}

/**
 * per_commit_base_of reads the value FOLLOWING `--per-commit-test` (the git base for the delta gate),
 * is "" when the flag is absent, and is "" when the flag is the last token with no value after it.
 */
#test
fn pt_per_commit_base_of_reads_the_value() {
    teko::assert::is_true(per_commit_base_of(args_of("test", "--per-commit-test", "abc123")) == "abc123")
    teko::assert::is_true(per_commit_base_of(args_of("--per-commit-test", "main", "test")) == "main")
    teko::assert::is_true(per_commit_base_of(args_of("test", ".", "--coverage")) == "")
    teko::assert::is_true(per_commit_base_of(args_of("test", ".", "--per-commit-test")) == "")
}

/**
 * project_arg_of skips `--per-commit-test` AND its base value (a two-token value flag), so neither the
 * flag nor the git ref that follows it is ever mistaken for the project positional.
 */
#test
fn pt_project_arg_of_skips_the_per_commit_flag() {
    teko::assert::is_true(project_arg_of(args_of("--per-commit-test", "main", "."), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of(".", "--per-commit-test", "main"), 0) == ".")
}

/**
 * changed_line_set parses a unified diff into the added/replaced NEW-side line numbers per `.tks`
 * file: a context line advances the new-side counter, a `+` line records the current number and
 * advances, and the `@@` header (re)seeds it — so `changed_contains` answers membership tolerant of a
 * repo-relative vs project-relative path (a `/`-boundary suffix match).
 */
#test
fn pt_changed_line_set_parses_added_lines() {
    let diff = "diff --git a/src/x.tks b/src/x.tks\n--- a/src/x.tks\n+++ b/src/x.tks\n@@ -1,3 +1,4 @@\n ctx\n+added2\n+added3\n ctx4\n"
    let cls = changed_line_set(diff)
    teko::assert::is_true(changed_contains(cls, "src/x.tks", 2))
    teko::assert::is_true(changed_contains(cls, "src/x.tks", 3))
    teko::assert::is_false(changed_contains(cls, "src/x.tks", 1))
    teko::assert::is_false(changed_contains(cls, "src/x.tks", 4))
    teko::assert::is_true(changed_contains(cls, "x.tks", 2))
    teko::assert::is_false(changed_contains(cls, "other.tks", 2))
}

/**
 * cov_lines_from_cobertura reads one CovLine per BODY `<line>` element, taking the file from the
 * enclosing `<class filename=…>` and hit from `hits > 0`, and SKIPS the per-method summary `<line>`
 * (on the `<methods>` line) so a function's declaration line is not double-counted.
 */
#test
fn pt_cov_lines_from_cobertura_reads_body_lines() {
    let xml = "      <class name='ns::f' filename='src/x.tks' line-rate='0.5' branch-rate='1.0' complexity='0'>\n        <methods><method name='f' signature='()V' line-rate='0.5' branch-rate='1.0'><lines><line number='10' hits='1'/></lines></method></methods>\n        <lines>\n          <line number='11' hits='1'/>\n          <line number='12' hits='0'/>\n        </lines>\n      </class>\n"
    let cov = cov_lines_from_cobertura(xml)
    teko::assert::is_true(cov.len == 2)
    teko::assert::is_true(cov[0].file == "src/x.tks")
    teko::assert::is_true(cov[0].line == 11)
    teko::assert::is_true(cov[0].hit)
    teko::assert::is_true(cov[1].line == 12)
    teko::assert::is_false(cov[1].hit)
}

/**
 * A synthetic changed-line set + coverage map fully exercise delta_line_coverage: only lines that are
 * BOTH executable and changed count toward the denominator, and only the covered ones toward the
 * numerator (unchanged lines and other-file lines are excluded) — here 1 of 2 changed lines is hit.
 */
#test
fn pt_delta_line_coverage_attributes_only_changed_lines() {
    mut files: []ChangedFile = teko::list::empty()
    files = teko::list::push(files, ChangedFile { path = "src/x.tks"; lines = teko::list::push(teko::list::push(teko::list::empty(), 2 to u32), 3 to u32) })
    let cls = ChangedLines { files = files }
    mut cov: []CovLine = teko::list::empty()
    cov = teko::list::push(cov, CovLine { file = "src/x.tks"; line = 2 to u32; hit = true })
    cov = teko::list::push(cov, CovLine { file = "src/x.tks"; line = 3 to u32; hit = false })
    cov = teko::list::push(cov, CovLine { file = "src/x.tks"; line = 9 to u32; hit = true })
    cov = teko::list::push(cov, CovLine { file = "other.tks"; line = 2 to u32; hit = true })
    let d = delta_line_coverage(cov, cls)
    teko::assert::is_true(d.cov == 1)
    teko::assert::is_true(d.val == 2)
    teko::assert::is_true(delta_pct(d) == 50)
}

/**
 * delta_pct is vacuously 100% when nothing executable changed (an empty denominator) — a commit that
 * touched no measurable code has nothing to prove, so the gate must never block it.
 */
#test
fn pt_delta_pct_empty_is_vacuously_full() {
    teko::assert::is_true(delta_pct(DeltaCoverage { cov = 0; val = 0 }) == 100)
    teko::assert::is_true(delta_pct(DeltaCoverage { cov = 3; val = 4 }) == 75)
}

/**
 * delta_floor_blocks encodes the whole per-commit warn-vs-fail policy: a below-floor delta is a
 * non-blocking pass by default (validation off) and a hard failure only under `--cov-validation`; a
 * delta at or above the floor never blocks regardless of the flag (owner ruling 0.3.0.29 / #19).
 */
#test
fn pt_delta_floor_blocks_is_opt_in() {
    teko::assert::is_false(delta_floor_blocks(50, 80, false))
    teko::assert::is_true(delta_floor_blocks(50, 80, true))
    teko::assert::is_false(delta_floor_blocks(80, 80, true))
    teko::assert::is_false(delta_floor_blocks(100, 50, true))
}

/**
 * per_commit_report_str renders the stable, greppable one-line delta report the CI log parses:
 * the base ref, the delta percentage, and the covered/total changed-line counts.
 */
#test
fn pt_per_commit_report_str_shape() {
    let line = per_commit_report_str("origin/main", DeltaCoverage { cov = 3; val = 4 })
    teko::assert::is_true(line == "teko: per-commit delta coverage (base origin/main): 75% (3/4) of changed executable lines covered")
}

/**
 * declares_assert_seed distinguishes a real `teko::assert` DEFINITION from every other declaration:
 * an `extern fn` in the same namespace only BINDS a foreign symbol (prototype, no body) and never
 * competes with the C seed, and no other namespace can supply `teko__assert__*` at all. This is the
 * predicate that decides whether `src/assert/assert.c` joins the link line — the mechanism that
 * replaced the seed's `__attribute__((weak))`, which GNU ld for PE/COFF does not honour across
 * translation units (it made every Windows program calling `teko::assert` without defining it
 * unlinkable — the `assert_native` regression scenario).
 */
#test
fn pt_declares_assert_seed_only_for_a_bodied_teko_assert_decl() {
    teko::assert::is_true(declares_assert_seed("teko::assert", false))
    teko::assert::is_false(declares_assert_seed("teko::assert", true))
    teko::assert::is_false(declares_assert_seed("teko::str", false))
    teko::assert::is_false(declares_assert_seed("", false))
    teko::assert::is_false(declares_assert_seed("assert", false))
}

/**
 * program_declares_assert_seed is false for a program with NO items — the ordinary case, where the
 * assert seed MUST stay on the link line so `teko__assert__*` resolves at all.
 */
#test
fn pt_program_declares_assert_seed_is_false_for_an_empty_program() {
    let empty = checker::TProgram { items = teko::list::empty() }
    teko::assert::is_false(program_declares_assert_seed(empty))
}

/**
 * pt_manifest_of — parse a `.tkp` fixture text into a Manifest for the extern-lib validator tests,
 * degrading to the smallest parsable manifest when the fixture text itself is malformed.
 *
 * @param src  the `.tkp` text
 * @return     the parsed manifest, or a minimal one with no `[extern.libs]` columns
 */
fn pt_manifest_of(src: str) -> Manifest {
    match parse_manifest(src) { Manifest as m => m; error => pt_empty_manifest() }
}

/**
 * pt_empty_manifest — the smallest manifest that parses (no `[extern.libs]` at all), the stand-in
 * for a malformed fixture text.
 *
 * @return a manifest with empty extern-lib columns
 */
fn pt_empty_manifest() -> Manifest {
    match parse_manifest("name = \"x\"\nsource = \"src\"\n") { Manifest as m => m; error => pt_empty_manifest() }
}

/**
 * pt_is_error — did a validator return an error (rather than the `null` success)?
 *
 * @param v  the validator verdict
 * @return   true iff `v` carries an error
 */
fn pt_is_error(v: null | error) -> bool {
    match v { error => true; null => false }
}

/**
 * pt_error_text — the message of a validator verdict, or "" when it succeeded.
 *
 * @param v  the validator verdict
 * @return   the error message, or "" for success
 */
fn pt_error_text(v: null | error) -> str {
    match v { error as e => e.message; null => "" }
}

/**
 * pt_cross_object_target — a target that `cross_note` classifies as CROSS on EVERY host: whichever
 * of `x86_64-windows` / `x86_64-linux` this host does not default to (no host defaults to both, so
 * one of the two is always cross). It is the SINGLE always-cross fixture the R4/R5 cross assertions
 * below share, so they hold platform-independently.
 *
 * @return a target that is cross on the host running the suite
 */
fn pt_cross_object_target() -> NativeTarget {
    if host_default_target_guess() == NativeTarget::X8664Windows { return NativeTarget::X8664Linux }
    NativeTarget::X8664Windows
}

#test
/**
 * pt_target_name_is_the_canonical_os_arch_name — the reverse (variant → name) direction of the D39
 * single os-arch string space, for EVERY `NativeTarget` variant: the spelling the
 * `[extern.libs.<os-arch>]` section key, the `on "<os-arch>"` regressor routing and the cross-emit
 * note all share.
 *
 * WHY THIS IS ONE OF FIVE TESTS AND NOT ONE OF FOURTEEN ASSERTIONS: the assert seed reports the line
 * of the ENCLOSING DECLARATION, not of the failing assertion (measured: the arm64-macos SIGABRT
 * named `project_test.tkt:738`, which was the `fn` line of the single test these five replace, so
 * the trace located nothing). One test per FAMILY names the family that diverged — the fact that
 * decides the next step — without inflating the suite count by thirteen.
 */
fn pt_target_name_is_the_canonical_os_arch_name() {
    teko::assert::is_true(target_name(NativeTarget::X8664Linux) == "x86_64-linux")
    teko::assert::is_true(target_name(NativeTarget::Arm64Macho) == "arm64-macos")
    teko::assert::is_true(target_name(NativeTarget::Arm64Linux) == "arm64-linux")
    teko::assert::is_true(target_name(NativeTarget::X8664Windows) == "x86_64-windows")
}

#test
/**
 * pt_target_objfmt_keys_the_linker_rules — the object format each variant emits, as the token the
 * `--allow-undef` translation (§5.2) and the COFF import-lib rule (R5) key on. Both ELF targets are
 * asserted, so the `Arm64Linux` arm cannot go missing from the family the way it did while this was
 * a single test.
 */
fn pt_target_objfmt_keys_the_linker_rules() {
    teko::assert::is_true(target_objfmt(NativeTarget::X8664Linux) == OBJFMT_ELF)
    teko::assert::is_true(target_objfmt(NativeTarget::Arm64Linux) == OBJFMT_ELF)
    teko::assert::is_true(target_objfmt(NativeTarget::Arm64Macho) == OBJFMT_MACHO)
    teko::assert::is_true(target_objfmt(NativeTarget::X8664Windows) == OBJFMT_COFF)
}

#test
/**
 * pt_target_name_round_trips_through_target_from_name — the D39 closure claim: what the reverse
 * direction EMITS, the forward direction ACCEPTS, for every variant. `aarch64-linux` is asserted
 * alongside it because that is the spelling `cc -dumpmachine` reports for `Arm64Linux`, and an
 * alias that stops resolving is the same outage as a canonical name that stops resolving.
 */
fn pt_target_name_round_trips_through_target_from_name() {
    teko::assert::is_true(target_matches(target_name(NativeTarget::X8664Linux), NativeTarget::X8664Linux))
    teko::assert::is_true(target_matches(target_name(NativeTarget::Arm64Macho), NativeTarget::Arm64Macho))
    teko::assert::is_true(target_matches(target_name(NativeTarget::Arm64Linux), NativeTarget::Arm64Linux))
    teko::assert::is_true(target_matches(target_name(NativeTarget::X8664Windows), NativeTarget::X8664Windows))
    teko::assert::is_true(target_matches("aarch64-linux", NativeTarget::Arm64Linux))
}

#test
/**
 * pt_links_with_cc_is_relative_to_the_host — the "will a link step run?" rule, stated the only way
 * it can be stated portably: `links_with_cc` is a function of the target AND of the host, so the
 * host side must be NAMED, never assumed.
 *
 * THE BUG THIS ASSERTION REPLACES, and it is the whole reason for this split: the single test used
 * to assert `target_links_with_cc(NativeTarget::X8664Linux)` outright. That reads "x86_64-linux
 * links" — true only on a host whose own default IS x86_64-linux. On arm64-macos the host default
 * is `Arm64Macho`, so `cross_note(X8664Linux).is_cross` holds, a cross build stops at the OBJECT,
 * and the honest answer is FALSE — the assertion was the failure, not the platform. It survived
 * because the OS-only Phase-1 host guess answered `X8664Linux` for every linux host; once
 * `host_target_for_os` learned the arch, arm64-linux joined arm64-macos in refuting it.
 *
 * WHAT IS ASSERTED INSTEAD, all host-independent: the host's OWN target always links (never cross);
 * a cross target does not link unpinned, whether asked through the environment-only probe or
 * directly; and pinning is the escape hatch that makes it link.
 */
fn pt_links_with_cc_is_relative_to_the_host() {
    teko::assert::is_true(target_links_with_cc(host_default_target_guess()))
    teko::assert::is_false(target_links_with_cc(pt_cross_object_target()))
    teko::assert::is_false(links_with_cc(pt_cross_object_target(), false))
    teko::assert::is_true(links_with_cc(pt_cross_object_target(), true))
}

#test
/**
 * pt_target_os_name_is_the_os_half_of_the_name — the OS half of each canonical name, in the same
 * vocabulary `teko::os()` and the bare-OS `[extern.libs.<os>]` key use. Both linux targets are
 * asserted: they share one OS name across two archs, which is exactly what the bare-OS section key
 * relies on.
 */
fn pt_target_os_name_is_the_os_half_of_the_name() {
    teko::assert::is_true(target_os_name(NativeTarget::X8664Linux) == "linux")
    teko::assert::is_true(target_os_name(NativeTarget::Arm64Linux) == "linux")
    teko::assert::is_true(target_os_name(NativeTarget::Arm64Macho) == "macos")
    teko::assert::is_true(target_os_name(NativeTarget::X8664Windows) == "windows")
}

#test
/**
 * pt_cross_note_is_empty_for_the_host_target — the C5 classification: the host's own target is NOT
 * cross and carries no note, while a target no host defaults to is cross and its note names BOTH
 * targets plus the honest verdict ("not executed"). `cross_note_for_name` folds an empty and an
 * unrecognized name to NOT cross (the R2 stop for the latter belongs to `emit_native`).
 *
 * @return void
 */
fn pt_cross_note_is_empty_for_the_host_target() {
    let here = cross_note(host_default_target_guess())
    teko::assert::is_false(here.is_cross)
    teko::assert::is_true(here.note == "")
    let cross = cross_note(pt_cross_object_target())
    teko::assert::is_true(cross.is_cross)
    teko::assert::str_contains(cross.note, target_name(pt_cross_object_target()))
    teko::assert::str_contains(cross.note, target_name(host_default_target_guess()))
    teko::assert::str_contains(cross.note, "not executed")
    teko::assert::is_true(cross_note_for_name(target_name(pt_cross_object_target())).is_cross)
    teko::assert::is_false(cross_note_for_name("").is_cross)
    teko::assert::is_false(cross_note_for_name("some-unknown-target").is_cross)
    teko::assert::is_false(cross_note_for_name(target_name(host_default_target_guess())).is_cross)
}

#test
/**
 * pt_os_lib_key_matches_both_shapes — the §4.2 link-time delta: a deferred section key applies when
 * it is the build's OS (bare-OS back-compat), the OS being linked FOR (what "any arch of that OS"
 * means on a cross build), or the resolved target's full os-arch name — and never otherwise. A
 * malformed empty key matches nothing.
 *
 * @return void
 */
fn pt_os_lib_key_matches_both_shapes() {
    let host = LinkTargetKeys { build_os = "linux"; emit_os = "linux"; os_arch = "x86_64-linux" }
    teko::assert::is_true(os_lib_key_matches("linux", host))
    teko::assert::is_true(os_lib_key_matches("x86_64-linux", host))
    teko::assert::is_false(os_lib_key_matches("arm64-macos", host))
    teko::assert::is_false(os_lib_key_matches("windows", host))
    teko::assert::is_false(os_lib_key_matches("", host))
    let cross = LinkTargetKeys { build_os = "linux"; emit_os = "windows"; os_arch = "x86_64-windows" }
    teko::assert::is_true(os_lib_key_matches("windows", cross))
    teko::assert::is_true(os_lib_key_matches("x86_64-windows", cross))
    teko::assert::is_true(os_lib_key_matches("linux", cross))
    teko::assert::is_false(os_lib_key_matches("arm64-macos", cross))
    let own = target_link_keys(NativeTarget::X8664Windows)
    teko::assert::is_true(os_lib_key_matches("windows", own))
    teko::assert::is_false(os_lib_key_matches("linux", own))
    teko::assert::is_true(os_lib_key_matches("x86_64-windows", own))
}

#test
/**
 * pt_static_lib_cross_must_be_pointed_at_and_present — R4/M.3: for a CROSS target a bare
 * `static:<name>` is a compile error naming the lib, the target and the os-arch section that fixes
 * it (the host linker cannot search the target's library paths); the SAME declaration for the host
 * target is fine (the host linker searches its own paths and reports its own miss). An
 * explicitly-named path that is absent is an error for any target — the already-ratified
 * "explicitly-named missing lib file is a hard error" rule (LEGISLATION:423), per target.
 *
 * @return void
 */
fn pt_static_lib_cross_must_be_pointed_at_and_present() {
    let bare = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs]\nfoo = [\"static:foo\"]\n")
    let cross = validate_static_libs_for_target(bare, pt_cross_object_target())
    teko::assert::is_true(pt_is_error(cross))
    teko::assert::str_contains(pt_error_text(cross), "foo")
    teko::assert::str_contains(pt_error_text(cross), target_name(pt_cross_object_target()))
    teko::assert::is_false(pt_is_error(validate_static_libs_for_target(bare, host_default_target_guess())))
    let absent = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs]\nfoo = [\"static:__no_such_dir__/libfoo.a\"]\n")
    let miss = validate_static_libs_for_target(absent, host_default_target_guess())
    teko::assert::is_true(pt_is_error(miss))
    teko::assert::str_contains(pt_error_text(miss), "__no_such_dir__/libfoo.a")
    let clean = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs]\nm = []\n")
    teko::assert::is_false(pt_is_error(validate_static_libs_for_target(clean, pt_cross_object_target())))
}

#test
/**
 * pt_static_validation_honours_the_section_key — a `static:` declaration in a section that does NOT
 * apply to the validated target is not the target's problem: only the applicable sections (global,
 * the target's bare OS, the target's os-arch) are checked.
 *
 * @return void
 */
fn pt_static_validation_honours_the_section_key() {
    let m = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs.arm64-macos]\nfoo = [\"static:foo\"]\n")
    teko::assert::is_false(pt_is_error(validate_static_libs_for_target(m, NativeTarget::X8664Windows)))
    let own = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs." ~ target_name(pt_cross_object_target()) ~ "]\nfoo = [\"static:foo\"]\n")
    teko::assert::is_true(pt_is_error(validate_static_libs_for_target(own, pt_cross_object_target())))
}

#test
/**
 * pt_shared_lib_default_fails_and_allow_undef_opts_in — R5 (owner ruling 2026-07-24 §5.0): a named
 * shared lib that is absent here FAILS by default, with a message pointing at `--allow-undef`; the
 * same manifest under the opt-in passes (the blind link is explicit, never silent). A bare
 * `shared:<name>` gets no compile-time verdict — the linker's own fail-loud miss is the default.
 *
 * @return void
 */
fn pt_shared_lib_default_fails_and_allow_undef_opts_in() {
    let m = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs]\nbar = [\"shared:__no_such_dir__/libbar.so\"]\n")
    let strict = validate_shared_libs_for_target(m, host_default_target_guess(), false)
    teko::assert::is_true(pt_is_error(strict))
    teko::assert::str_contains(pt_error_text(strict), "__no_such_dir__/libbar.so")
    teko::assert::str_contains(pt_error_text(strict), ALLOW_UNDEF_FLAG)
    teko::assert::is_false(pt_is_error(validate_shared_libs_for_target(m, host_default_target_guess(), true)))
    let by_name = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs]\nbar = [\"shared:bar\"]\n")
    teko::assert::is_false(pt_is_error(validate_shared_libs_for_target(by_name, host_default_target_guess(), false)))
}

#test
/**
 * pt_shared_cross_coff_needs_an_import_lib — R5's COFF gap (§5.2): cross-linking a `shared:` lib to
 * `x86_64-windows` without an import library is a NAMED honest stop EVEN WITH `--allow-undef`,
 * because PE/COFF cannot reference a DLL without one and the transitional linker will not synthesize
 * it; pointing at a `.lib` import stub lifts the stop (its own presence is then the ordinary rule).
 *
 * @return void
 */
fn pt_shared_cross_coff_needs_an_import_lib() {
    let m = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs.x86_64-windows]\nbar = [\"shared:bar\"]\n")
    if cross_note(NativeTarget::X8664Windows).is_cross {
        let stop = validate_shared_libs_for_target(m, NativeTarget::X8664Windows, true)
        teko::assert::is_true(pt_is_error(stop))
        teko::assert::str_contains(pt_error_text(stop), "import library")
        let pointed = pt_manifest_of("name = \"app\"\nsource = \"src\"\n[extern.libs.x86_64-windows]\nbar = [\"shared:__no_such_dir__/bar.lib\"]\n")
        teko::assert::is_false(pt_is_error(validate_shared_libs_for_target(pointed, NativeTarget::X8664Windows, true)))
        return
    }
    teko::assert::is_false(pt_is_error(validate_shared_libs_for_target(m, NativeTarget::X8664Windows, false)))
}

#test
/**
 * pt_allow_undef_flag_surface — the opt-in is recognized only when spelled exactly, translates per
 * object format (Mach-O's `dynamic_lookup`; ELF's pair, since `--allow-shlib-undefined` alone does
 * not let an executable carry an undefined symbol), and has NO translation for PE/COFF — a
 * flag that would do nothing is not emitted, the honest stop covers that case instead.
 *
 * @return void
 */
fn pt_allow_undef_flag_surface() {
    teko::assert::is_true(allow_undef_of(args_of("teko", "build", ALLOW_UNDEF_FLAG)))
    teko::assert::is_false(allow_undef_of(args_of("teko", "build", ".")))
    teko::assert::is_false(allow_undef_of(args_of("teko", "build", "--allow-undefined")))
    teko::assert::str_contains(allow_undef_cc_flag(OBJFMT_ELF), "--unresolved-symbols=ignore-all")
    teko::assert::str_contains(allow_undef_cc_flag(OBJFMT_ELF), "--allow-shlib-undefined")
    teko::assert::is_true(allow_undef_cc_flag(OBJFMT_MACHO) == "-Wl,-undefined,dynamic_lookup")
    teko::assert::is_true(allow_undef_cc_flag(OBJFMT_COFF) == "")
    teko::assert::is_true(project_arg_of(args_of("teko", ALLOW_UNDEF_FLAG, "proj"), 1) == "proj")
}

#test
/**
 * pt_blind_link_withdrawal_is_opt_in_only — a flag is withdrawn from the link line ONLY for the case
 * the opt-in exists for. This gate runs WITHOUT `--allow-undef` in its own argv, so nothing is
 * withdrawn here — which is exactly the invariant that matters: no silent blind link.
 *
 * @return void
 */
fn pt_blind_link_withdrawal_is_opt_in_only() {
    teko::assert::is_false(allow_undef_selected())
    teko::assert::is_false(omit_flag_for_blind_link("__no_such_dir__/libbar.so", LINK_MODE_SHARED))
    teko::assert::is_false(omit_flag_for_blind_link("-lbar", LINK_MODE_SHARED))
    teko::assert::is_false(omit_flag_for_blind_link("__no_such_dir__/libfoo.a", LINK_MODE_STATIC))
}

#test
/**
 * pt_lib_file_present_reads_the_local_tree — the R4/R5 locality probe answers from the project root
 * the build already chdir'd into: a file that exists is present, a fabricated path is not, and an
 * unreadable directory is not present (never an exception).
 *
 * @return void
 */
fn pt_lib_file_present_reads_the_local_tree() {
    teko::assert::is_true(lib_file_present("teko.tkp"))
    teko::assert::is_false(lib_file_present("__no_such_dir__/libfoo.a"))
    teko::assert::is_false(lib_file_present("src/__no_such_file__.a"))
    teko::assert::is_true(lib_spec_path("-lfoo") == "")
    teko::assert::is_true(lib_spec_path("vendor/libfoo.a") == "vendor/libfoo.a")
}

#test
/**
 * pt_target_arch_name_completes_the_os_arch_name — arch and OS are the two halves of ONE os-arch
 * string space (D39), so for every relocatable-object target the pair must REASSEMBLE the canonical
 * name `target_name` produces. Asserted as that identity rather than as a table of literals, because
 * the identity is what the capability rules depend on: a new target whose arch half disagreed with
 * its canonical name would be caught here instead of silently mis-answering "can this host link it".
 *
 * @return void
 */
fn pt_target_arch_name_completes_the_os_arch_name() {
    teko::assert::is_true((target_arch_name(NativeTarget::X8664Linux) ~ "-" ~ target_os_name(NativeTarget::X8664Linux)) == target_name(NativeTarget::X8664Linux))
    teko::assert::is_true((target_arch_name(NativeTarget::Arm64Macho) ~ "-" ~ target_os_name(NativeTarget::Arm64Macho)) == target_name(NativeTarget::Arm64Macho))
    teko::assert::is_true((target_arch_name(NativeTarget::X8664Windows) ~ "-" ~ target_os_name(NativeTarget::X8664Windows)) == target_name(NativeTarget::X8664Windows))
}

/**
 * pt_cc_manifest_of — a manifest whose `[extern] cc` names `cc_cmd`, for the resolution-precedence
 * tests. Written as manifest TEXT rather than a struct literal so the test exercises the very parse
 * path a real project's `.tkp` takes.
 *
 * @param cc_cmd  the compiler the manifest pins
 * @return        the parsed manifest carrying that `cc` override
 */
fn pt_cc_manifest_of(cc_cmd: str) -> Manifest {
    pt_manifest_of("name = \"x\"\nsource = \"src\"\n[extern]\ncc = \"" ~ cc_cmd ~ "\"\n")
}

/**
 * pt_the_manifest_cc_override_wins_over_every_default — the top of the resolution precedence law:
 * a manifest `[extern] cc` is obeyed verbatim on EVERY host, and it carries NO implied target flag,
 * because whoever names the compiler owns its ABI.
 *
 * @return void
 */
#test
fn pt_the_manifest_cc_override_wins_over_every_default() {
    let choice = resolve_cc_choice(pt_cc_manifest_of("my-own-cc"))
    teko::assert::is_true(choice.cmd == "my-own-cc")
    teko::assert::is_true(choice.target_flag == "")
    teko::assert::is_true(resolve_cc(pt_cc_manifest_of("my-own-cc")) == "my-own-cc")
}

/**
 * pt_the_host_default_is_clang_with_msvc_only_on_windows — the Windows default is
 * `clang --target=x86_64-pc-windows-msvc`, and it is a WINDOWS default: on this suite's own host the
 * choice must still be the bare `cc` with no target flag, which is the condition for the Linux/macOS
 * link line to stay byte-identical and the product fixpoint to keep closing.
 *
 * Both arms are asserted on every host — the one that matches this host by measurement
 * (`teko::os()`), the other by the pieces the Windows arm is built from — so a Linux gate still
 * proves what the Windows spelling will be.
 *
 * @return void
 */
#test
fn pt_the_host_default_is_clang_with_msvc_only_on_windows() {
    let choice = host_cc_choice()
    if teko::os() == WINDOWS_OS_NAME {
        teko::assert::is_true(choice.cmd == WINDOWS_CC_NAME)
        teko::assert::is_true(choice.target_flag == "--target=x86_64-pc-windows-msvc")
    } else {
        teko::assert::is_true(choice.cmd == HOST_CC_NAME)
        teko::assert::is_true(choice.target_flag == "")
    }
    teko::assert::is_true(WINDOWS_CC_NAME == "clang")
    teko::assert::is_true(CC_TARGET_FLAG_PREFIX ~ WINDOWS_MSVC_TRIPLE == "--target=x86_64-pc-windows-msvc")
    teko::assert::is_false(triple_is_mingw(WINDOWS_MSVC_TRIPLE))
}

/**
 * pt_no_target_asks_for_a_cross_driver_any_more — the MinGW cross driver is gone from
 * `default_cc_for_target`: every target answers with the host `cc`, which is what tells the
 * regressor's pre-build probe that a cross row needs no cross toolchain on this host.
 *
 * @return void
 */
#test
fn pt_no_target_asks_for_a_cross_driver_any_more() {
    teko::assert::is_true(default_cc_for_target(NativeTarget::X8664Windows) == HOST_CC_NAME)
    teko::assert::is_true(default_cc_for_target(NativeTarget::X8664Linux) == HOST_CC_NAME)
    teko::assert::is_true(default_cc_for_target(NativeTarget::Arm64Macho) == HOST_CC_NAME)
    teko::assert::is_false(linker_is_mingw(default_cc_for_target(NativeTarget::X8664Windows)))
}

/**
 * pt_the_c_route_refusal_teaches_the_same_law_as_the_native_one — the C route's refusal names the
 * compiler, names the EVIDENCE, quotes the shared ban reason (the owner's own words included), and
 * points at the honest replacement for its own route: clang aimed at MSVC.
 *
 * @return void
 */
#test
fn pt_the_c_route_refusal_teaches_the_same_law_as_the_native_one() {
    let msg = mingw_cc_rejected_error("/c/mingw64/bin/cc", "the command names a MinGW install").message
    teko::assert::str_contains(msg, "/c/mingw64/bin/cc")
    teko::assert::str_contains(msg, "the command names a MinGW install")
    teko::assert::str_contains(msg, MINGW_BAN_REASON)
    teko::assert::str_contains(msg, WINDOWS_MSVC_TRIPLE)
    teko::assert::str_contains(msg, WINDOWS_CC_NAME)
}

/**
 * pt_a_mingw_cc_is_convicted_by_its_path_without_any_probe — the cheap reading fires first and on
 * the MEASURED case: the Windows runner's `cc` resolves to `/c/mingw64/bin/cc`, whose path names
 * MinGW outright, so no process has to run for the ban to bite. The evidence phrase is what proves
 * no process ran — it names the PATH reading (`MINGW_PATH_EVIDENCE_PHRASE`) and not the probe.
 *
 * IT ASSERTS NOTHING ABOUT THIS HOST'S OWN `cc`, and that is the point of its present shape. The
 * earlier version handed `mingw_cc_evidence` the host's `HOST_CC_NAME` and asserted the verdict was
 * innocent, which is not a fact about this function but about whichever toolchain is on the runner's
 * PATH — and on the Windows runner, whose `cc` really is `/c/mingw64/bin/cc`, it contradicted this
 * very doc-comment and failed. What the build actually does on Windows is pinned where it belongs,
 * on `host_cc_choice` (`pt_the_host_default_is_clang_with_msvc_only_on_windows`): the bare host `cc`
 * is never the compiler there in the first place.
 *
 * @return void
 */
#test
fn pt_a_mingw_cc_is_convicted_by_its_path_without_any_probe() {
    let by_path = mingw_cc_evidence("/c/mingw64/bin/cc", teko::test::scoped("bin/.pt-probe"))
    teko::assert::str_contains(by_path, "/c/mingw64/bin/cc")
    teko::assert::str_contains(by_path, MINGW_PATH_EVIDENCE_PHRASE)
    teko::assert::is_false(teko::str::contains(by_path, MINGW_TRIPLE_EVIDENCE_PHRASE))
    teko::assert::str_contains(mingw_cc_evidence("x86_64-w64-mingw32-gcc", teko::test::scoped("bin/.pt-probe")), MINGW_PATH_EVIDENCE_PHRASE)
    teko::assert::str_contains(mingw_path_evidence("C:/msys64/mingw64/bin/clang.exe"), MINGW_PATH_EVIDENCE_PHRASE)
}

/**
 * pt_an_innocent_spelling_is_left_for_the_triple_to_judge — the other half of the cost-ordered rule,
 * proved on hand-written spellings so it holds identically on every self-test host: a command whose
 * spelling names no MinGW is NOT convicted by the cheap reading, whatever it is called and wherever
 * it lives. This is the rule the retired host-`cc` assertion was reaching for, stated about the
 * FUNCTION instead of about the runner.
 *
 * @return void
 */
#test
fn pt_an_innocent_spelling_is_left_for_the_triple_to_judge() {
    teko::assert::is_true(mingw_path_evidence(HOST_CC_NAME) == "")
    teko::assert::is_true(mingw_path_evidence(WINDOWS_CC_NAME) == "")
    teko::assert::is_true(mingw_path_evidence("/usr/bin/cc") == "")
    teko::assert::is_true(mingw_path_evidence("C:/Program Files/LLVM/bin/clang.exe") == "")
    teko::assert::is_true(mingw_path_evidence("x86_64-w64-windows-gnu-gcc") == "")
}

/**
 * pt_the_triple_reading_convicts_the_gnu_abi_and_acquits_the_unknown — the DEAR reading, pinned on
 * triples written out by hand instead of on whatever the host's compiler answers: both MinGW
 * spellings convict and the phrase quotes the triple it read plus the flag that read it, MSVC and
 * the legitimate host triples are acquitted, and the empty triple — an absent compiler, or a driver
 * with no `-dumpmachine` — is unknown rather than guilty.
 *
 * @return void
 */
#test
fn pt_the_triple_reading_convicts_the_gnu_abi_and_acquits_the_unknown() {
    let gnu = mingw_triple_evidence("x86_64-w64-windows-gnu")
    teko::assert::str_contains(gnu, MINGW_TRIPLE_EVIDENCE_PHRASE)
    teko::assert::str_contains(gnu, "x86_64-w64-windows-gnu")
    teko::assert::str_contains(gnu, HOST_CC_MACHINE_FLAG)
    teko::assert::str_contains(mingw_triple_evidence("x86_64-w64-mingw32"), MINGW_TRIPLE_EVIDENCE_PHRASE)
    teko::assert::is_true(mingw_triple_evidence(WINDOWS_MSVC_TRIPLE) == "")
    teko::assert::is_true(mingw_triple_evidence("x86_64-linux-gnu") == "")
    teko::assert::is_true(mingw_triple_evidence("arm64-apple-darwin24") == "")
    teko::assert::is_true(mingw_triple_evidence("") == "")
}

/**
 * pt_a_compiler_with_no_dumpmachine_is_unknown_not_guilty — an executable that exists but rejects
 * `-dumpmachine` yields "" (unknown), and unknown must never be a conviction. `sh` stands in for
 * such a driver: it is on every host this suite runs on and it exits non-zero for the flag.
 *
 * @return void
 */
#test
fn pt_a_compiler_with_no_dumpmachine_is_unknown_not_guilty() {
    teko::assert::is_true(cc_target_triple("sh", teko::test::scoped("bin/.pt-probe-sh")) == "")
    teko::assert::is_true(mingw_cc_evidence("sh", teko::test::scoped("bin/.pt-probe-sh")) == "")
}

/**
 * pt_the_verbose_rerun_is_the_same_line_plus_one_flag — the failure-path re-run adds `-v` directly
 * after the compiler and changes NOTHING else: same compiler, same arguments, same order, one token
 * longer.
 *
 * @return void
 */
#test
fn pt_the_verbose_rerun_is_the_same_line_plus_one_flag() {
    let line = args_of("cc", "-w", "-o")
    let verbose = cc_verbose_argv(line)
    teko::assert::is_true(verbose.len == line.len + 1)
    teko::assert::is_true(verbose[0] == "cc")
    teko::assert::is_true(verbose[1] == CC_VERBOSE_FLAG)
    teko::assert::is_true(verbose[2] == "-w")
    teko::assert::is_true(verbose[3] == "-o")
    teko::assert::is_true(CC_VERBOSE_FLAG == "-v")
}

/**
 * pt_a_cross_build_stops_at_the_object_and_a_host_build_links — the piece-4 rule, asserted from both
 * sides of the pin: with nothing pinned, a target this host does not own runs NO link step (the
 * object is the artifact) while the host's own target links exactly as before; with a compiler
 * pinned, the cross link is obeyed again.
 *
 * @return void
 */
#test
fn pt_a_cross_build_stops_at_the_object_and_a_host_build_links() {
    let host = host_default_target_guess()
    let plain = pt_empty_manifest()
    teko::assert::is_true(links_with_cc(host, false))
    teko::assert::is_true(build_links_binary(host, plain))
    teko::assert::is_true(build_links_binary(host, pt_cc_manifest_of("my-own-cc")))
    teko::assert::is_false(build_links_binary(pt_foreign_target_of(host), plain))
    teko::assert::is_true(build_links_binary(pt_foreign_target_of(host), pt_cc_manifest_of("my-own-cc")))
}

/**
 * pt_foreign_target_of — a relocatable-object target that is NOT `host`, so the cross rule can be
 * asserted on any host this suite runs on.
 *
 * @param host  the host's own default target
 * @return      a linking target different from `host`
 */
fn pt_foreign_target_of(host: NativeTarget) -> NativeTarget {
    if host == NativeTarget::X8664Windows { return NativeTarget::X8664Linux }
    NativeTarget::X8664Windows
}

/**
 * pt_the_closing_line_names_the_artifact_that_exists — the reported path follows the artifact: a
 * host binary build reports `<out>/<name>`, and a cross build that stopped at the object reports
 * `<out>/<name>.o` instead of announcing a binary nobody wrote.
 *
 * @return void
 */
#test
fn pt_the_closing_line_names_the_artifact_that_exists() {
    let host = host_default_target_guess()
    let native = pt_native_manifest()
    teko::assert::is_true(artifact_path_for("out/", native, host) == "out/x")
    teko::assert::is_true(artifact_path_for("out", native, pt_foreign_target_of(host)) == "out/x.o")
    teko::assert::is_true(artifact_path_for("out", pt_empty_manifest(), pt_foreign_target_of(host)) == "out/x")
}

/**
 * pt_native_manifest — the smallest BINARY manifest with the own backend stamped on, as the front-end
 * stamps it (`with_backend`): the shape whose closing line must follow the artifact.
 *
 * @return the manifest, carrying `Backend::Native`
 */
fn pt_native_manifest() -> Manifest {
    with_backend(pt_empty_manifest(), Backend::Native)
}

#test
/**
 * arm64_linux_target_row_set — the WHOLE row `Arm64Linux` adds to the target table, asserted
 * column by column rather than trusting that one arm implies the rest: the canonical name
 * `arm64-linux` (OS-based, ruling #390), the `aarch64-linux` spelling alias that
 * `cc -dumpmachine` reports, the ELF object format, the `linux` OS half and the `arm64` arch
 * half of the one os-arch string space (D39), the round trip
 * `target_from_name(target_name(t)) == t`, and the fact that it LINKS with `cc` on its own
 * host.
 *
 * A HALF-TAUGHT TARGET IS WORSE THAN NO TARGET: a variant that resolves but reports the wrong
 * arch would make the regressor's own-backend capability probe compare `arm64` against the
 * host `cc`'s `aarch64` and honest-skip the very rows this row exists to run.
 *
 * @return void
 */
fn arm64_linux_target_row_set() {
    teko::assert::is_true(target_matches("arm64-linux", NativeTarget::Arm64Linux))
    teko::assert::is_true(target_matches("aarch64-linux", NativeTarget::Arm64Linux))
    teko::assert::is_true(target_name(NativeTarget::Arm64Linux) == "arm64-linux")
    teko::assert::is_true(target_objfmt(NativeTarget::Arm64Linux) == OBJFMT_ELF)
    teko::assert::is_true(target_os_name(NativeTarget::Arm64Linux) == "linux")
    teko::assert::is_true(target_arch_name(NativeTarget::Arm64Linux) == "arm64")
    teko::assert::is_true(target_matches(target_name(NativeTarget::Arm64Linux), NativeTarget::Arm64Linux))
}

#test
/**
 * arm64_linux_is_distinct_from_arm64_macos — the two arm64 targets share ISA, ABI, isel,
 * regalloc and encoder, and differ in exactly ONE observable: the object container. Pinning
 * the differences that MUST exist (name, object format) alongside the one that must NOT (the
 * arch) is what stops a future refactor from folding them into one variant and silently
 * emitting Mach-O on Linux — the original R1 bug, wearing the other arch's clothes.
 *
 * @return void
 */
fn arm64_linux_is_distinct_from_arm64_macos() {
    teko::assert::is_true(NativeTarget::Arm64Linux != NativeTarget::Arm64Macho)
    teko::assert::is_true(target_arch_name(NativeTarget::Arm64Linux) == target_arch_name(NativeTarget::Arm64Macho))
    teko::assert::is_true(target_objfmt(NativeTarget::Arm64Linux) != target_objfmt(NativeTarget::Arm64Macho))
    teko::assert::is_true(target_os_name(NativeTarget::Arm64Linux) != target_os_name(NativeTarget::Arm64Macho))
}

#test
/**
 * unsupported_target_error_lists_arm64_linux — D39's single-source rule: the R2 diagnostic
 * that lists every accepted target must list the new one too, or a user typing
 * `TEKO_TARGET=arm64-linu` is told, with authority, that the target they want does not exist.
 *
 * @return void
 */
fn unsupported_target_error_lists_arm64_linux() {
    match target_from_name("arm64-linu") {
        NativeTarget => teko::assert::is_true(false)
        error as e => {
            teko::assert::is_true(teko::str::contains(e.message, "arm64-linux"))
            teko::assert::is_true(teko::str::contains(e.message, "aarch64-linux"))
        }
    }
}

/**
 * pt_test_jobs_parses_its_env_and_falls_back_safely — the gate's concurrency knob reuses the
 * regression pool's ONE decimal parser (`regr_jobs_of_default`), with the gate's own fallback.
 *
 * A malformed value must mean "the author did not mean zero shards", never zero: a run that silently
 * launched no shard would report an EMPTY suite as a passing one, which is the class of silent
 * success this whole change exists to remove.
 */
#test
fn pt_test_jobs_parses_its_env_and_falls_back_safely() {
    teko::assert::eq_u64(regr_jobs_of_default("8", os_max()), 8)
    teko::assert::eq_u64(regr_jobs_of_default("1", os_max()), 1)
    teko::assert::eq_u64(regr_jobs_of_default("", os_max()), os_max())
    teko::assert::eq_u64(regr_jobs_of_default("0", os_max()), os_max())
    teko::assert::eq_u64(regr_jobs_of_default("four", os_max()), os_max())
    teko::assert::eq_u64(regr_jobs_of_default("2x", os_max()), os_max())
}

/**
 * pt_a_gate_shard_names_itself_and_owns_its_dump — each shard of the in-process suite must carry BOTH
 * env tokens: which shard it is, and where ITS coverage goes.
 *
 * The second is not decoration. Every shard runs the same binary, so a shared `TEKO_TKCOV` would have
 * the shards clobber one another's dump and the coverage floors would then judge the suite on whatever
 * shard finished last — a wrong number that looks like a right one.
 */
#test
fn pt_a_gate_shard_names_itself_and_owns_its_dump() {
    let spec = gate_shard_spec("bin/teko-tktest", teko::test::scoped("bin/.shard/"), 2, 4)
    teko::assert::len_eq(spec.argv.len, 1)
    teko::assert::eq_str(spec.argv[0], "bin/teko-tktest")
    teko::assert::len_eq(spec.env.len, 2)
    teko::assert::eq_str(spec.env[0], "TEKO_TEST_SHARD=2/4")
    teko::assert::eq_str(spec.env[1], teko::str::concat("TEKO_TKCOV=", teko::test::scoped("bin/.shard/"), "2.tkcov"))
    teko::assert::eq_str(spec.prefix, teko::str::concat(teko::test::scoped("bin/.shard/"), "2"))
}

/**
 * pt_the_first_failing_shard_decides_in_shard_order — a sharded run's exit code must be a function of
 * the SOURCE, never of which process finished first, so it is the first failure in SHARD order.
 */
#test
fn pt_the_first_failing_shard_decides_in_shard_order() {
    mut all_ok: []CapResult = teko::list::push(teko::list::empty(), pt_cap_exit(0))
    all_ok = teko::list::push(all_ok, pt_cap_exit(0))
    teko::assert::eq_i64(first_shard_failure(all_ok) to i64, 0)
    mut mixed: []CapResult = teko::list::push(teko::list::empty(), pt_cap_exit(0))
    mixed = teko::list::push(mixed, pt_cap_exit(134))
    mixed = teko::list::push(mixed, pt_cap_exit(7))
    teko::assert::eq_i64(first_shard_failure(mixed) to i64, 134)
    let none: []CapResult = teko::list::empty()
    teko::assert::eq_i64(first_shard_failure(none) to i64, 0)
}

/**
 * pt_cap_exit — a `CapResult` carrying only an exit code, for the shard-verdict tests above.
 *
 * @param code  the exit code to carry
 * @return      a capture whose every other field is empty
 */
fn pt_cap_exit(code: i32) -> CapResult {
    CapResult { exit = code; stdout = ""; stderr = ""; harness_ns = 0; child_ns = 0; cmd = ""; chan_text = "" }
}

/**
 * pt_per_commit_diff_text_writes_its_scoped_capture_file — journal J3, family #24:
 * `per_commit_diff_text` now captures through `teko::test::scoped(".teko-per-commit.diff")`, so its
 * scratch file lands at exactly the path this test's OWN `teko::test::scoped` call with the same base
 * composes — the shell redirect (`run_git_diff`) creates it whether `git diff` succeeded or not, so
 * this holds even on a host with no `git`. The point is where it landed, not what it said: two
 * concurrent `--per-commit-test` runs on the same host would otherwise share the unscoped literal and
 * read each other's half-written diff.
 */
#test
fn pt_per_commit_diff_text_writes_its_scoped_capture_file() {
    match per_commit_diff_text("HEAD") { str => { }; error => { } }
    match teko::io::read_file(teko::test::scoped(".teko-per-commit.diff")) {
        str => { }
        error => teko::assert::is_true(false)
    }
}

/**
 * pt_shard_base — a hermetic scratch prefix for the `merge_shard_coverage` fixtures below, so two
 * shards' dumps land at `<prefix>0.tkcov`/`<prefix>1.tkcov` under this test's own scoped tree.
 *
 * @param tag  a per-fixture label kept distinct from every other fixture's
 * @return     the scratch prefix (with its trailing separator)
 * @since 0.3.1.0
 */
fn pt_shard_base(tag: str) -> str {
    teko::test::scoped(teko::str::concat("bin/.pt-shard-", tag, "/"))
}

/**
 * pt_write_tkcov — plant a well-formed, empty `.tkcov` dump at `<base><i>.tkcov`, the shape
 * `merge_shard_coverage` reads.
 *
 * @param base  the shard scratch prefix
 * @param i     the shard index
 * @since 0.3.1.0
 */
fn pt_write_tkcov(base: str, i: u64) {
    let path = teko::str::concat(base, $"{i}", ".tkcov")
    let no_ids: []u64 = teko::list::empty()
    match teko::io::write_file(path, pt_tkcov(no_ids, no_ids, no_ids)) { error => { }; null => { } }
}

/**
 * pt_merge_shard_coverage_merges_every_dump_present — the happy path: every shard left a dump, and
 * `merge_shard_coverage` merges all of them without error.
 */
#test
fn pt_merge_shard_coverage_merges_every_dump_present() {
    let base = pt_shard_base("present")
    pt_write_tkcov(base, 0)
    pt_write_tkcov(base, 1)
    pt_write_tkcov(base, 2)
    match merge_shard_coverage(base, 3) {
        error => teko::assert::is_true(false)
        null => { }
    }
}

/**
 * pt_merge_shard_coverage_names_the_first_missing_shard — the defect J4 closes: a shard that left no
 * `.tkcov` dump must STOP the merge and NAME that shard, in shard order, rather than merging what it
 * can and moving on (the historic `-> void` path discarded `coverage::cov_merge`'s `bool` here and
 * silently blessed a run whose floors were computed over a stale dump, or none at all).
 */
#test
fn pt_merge_shard_coverage_names_the_first_missing_shard() {
    let base = pt_shard_base("missing")
    pt_write_tkcov(base, 0)
    match merge_shard_coverage(base, 3) {
        error as e => { teko::assert::str_contains(e.message, "shard 1"); teko::assert::str_contains(e.message, "1.tkcov") }
        null => teko::assert::is_true(false)
    }
}
