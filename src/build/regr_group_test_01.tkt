/**
 * src/build/regr_group_test.tkt   (namespace `teko::build`)
 *
 * The unit surface of the grouped regression builds (`regr_group.tks`). Everything here is a PURE
 * function over source text — the classification of a snippet's tail, the bare names it claims, the
 * generated module/dispatcher text, the group key. The end-to-end proof that the fold preserves
 * every verdict is the regression phase itself; these tests pin the decisions that phase depends on,
 * so a wrong one fails here with a name instead of failing there as a mystery build.
 */

#test
/**
 * snippet_tail_is_value_sees_a_trailing_expression — the virtual-main tail rule: a bare expression
 * IS the program's exit code, so the fold has to wrap it in `exit(…)`. Covers the shapes the .31
 * corpus actually ends on — a bare call, a parenthesized call with a cast, and an arithmetic sum.
 *
 * @return void
 */
fn snippet_tail_is_value_sees_a_trailing_expression() {
    teko::assert::is_true(snippet_tail_is_value("total()"))
    teko::assert::is_true(snippet_tail_is_value("(probe()) to i32"))
    teko::assert::is_true(snippet_tail_is_value("present_val + absent_val"))
    teko::assert::is_true(snippet_tail_is_value("c_abs-42 to i32"))
}

#test
/**
 * snippet_tail_is_value_rejects_a_void_statement — the other half of the tail rule: a statement that
 * produces no value must be left ALONE, never wrapped in `exit(…)`. Covers a diverging call, a
 * binding, a bare `if`, a `match`, a `loop`, and an ASSIGNMENT — the one void shape that opens with
 * an ordinary expression instead of a keyword.
 *
 * @return void
 */
fn snippet_tail_is_value_rejects_a_void_statement() {
    teko::assert::is_true(!snippet_tail_is_value("exit(42)"))
    teko::assert::is_true(!snippet_tail_is_value("panic(\"boom\")"))
    teko::assert::is_true(!snippet_tail_is_value("let x = 1"))
    teko::assert::is_true(!snippet_tail_is_value("if bad() != 0 { exit(1) }"))
    teko::assert::is_true(!snippet_tail_is_value("match k {\n    0 => exit(7)\n    _ => exit(9)\n}"))
    teko::assert::is_true(!snippet_tail_is_value("loop { break }"))
    teko::assert::is_true(!snippet_tail_is_value("b.v = null"))
    teko::assert::is_true(!snippet_tail_is_value("xs[0] = 3"))
}

#test
/**
 * snippet_tail_is_assignment_ignores_a_comparison — the assignment probe must not mistake `==`/`!=`/
 * `<=`/`>=` or a match arrow `=>` for an assignment, and must not see an `=` nested inside brackets
 * (the whole reason it tracks depth).
 *
 * @return void
 */
fn snippet_tail_is_assignment_ignores_a_comparison() {
    teko::assert::is_true(!snippet_tail_is_assignment("a == b"))
    teko::assert::is_true(!snippet_tail_is_assignment("a != b"))
    teko::assert::is_true(!snippet_tail_is_assignment("(x <= y) to i32"))
    teko::assert::is_true(!snippet_tail_is_assignment("f(\"k=v\")"))
    teko::assert::is_true(snippet_tail_is_assignment("total = 3"))
}

#test
/**
 * snippet_stmts_have_return_is_a_word_scan — a top-level `return` bars the fold (in the virtual main
 * it sets the exit code; in the `void entry()` it would be a type error), but only as a WHOLE word
 * and only outside string literals — `returned` and `"return"` are not returns.
 *
 * @return void
 */
fn snippet_stmts_have_return_is_a_word_scan() {
    teko::assert::is_true(snippet_stmts_have_return("if x.len != 3 { return 1 }\nexit(0)\n"))
    teko::assert::is_true(!snippet_stmts_have_return("let returned = 1\nexit(returned)\n"))
    teko::assert::is_true(!snippet_stmts_have_return("print(\"return\")\nexit(0)\n"))
}

#test
/**
 * snippet_declared_names_claims_only_top_level — the packing constraint reads TOP-LEVEL declarations
 * only: a class's own `make` method is addressed through its type and collides with nothing, so
 * claiming it would split the corpus into dozens of pointless groups. The enclosing `type` IS
 * claimed, and so is a top-level `fn`/`const`.
 *
 * @return void
 */
fn snippet_declared_names_claims_only_top_level() {
    let decls = "type Counter = class {\n    pub n: i64\n    pub fn make(v: i64) -> Counter { Counter { n = v } }\n}\n\nconst B: byte = 5\n\npub fn probe() -> i64 { 1 }\n"
    let names = snippet_declared_names(decls)
    teko::assert::is_true(str_list_contains(names, "Counter"))
    teko::assert::is_true(str_list_contains(names, "B"))
    teko::assert::is_true(str_list_contains(names, "probe"))
    teko::assert::is_true(!str_list_contains(names, "make"))
    teko::assert::is_true(!str_list_contains(names, "n"))
}

#test
/**
 * snippet_declared_names_skips_a_doc_comment_and_keeps_an_attribute — the walk mirrors the splitter:
 * a leading doc-comment block is skipped (it is not the declaration) and a bare attribute line
 * accumulates onto the declaration it decorates, so the name behind `#test` is still claimed.
 *
 * @return void
 */
fn snippet_declared_names_skips_a_doc_comment_and_keeps_an_attribute() {
    let decls = "/**\n * A doc comment naming type Ghost, which is not a declaration.\n */\n#test\nfn probe() -> i64 { 1 }\n"
    let names = snippet_declared_names(decls)
    teko::assert::is_true(str_list_contains(names, "probe"))
    teko::assert::is_true(!str_list_contains(names, "Ghost"))
}

#test
/**
 * str_list_contains_finds_and_misses — the membership helper the two claim tests above assert
 * through, pinned on its own so a failure there names the predicate and not the claim.
 *
 * @return void
 */
fn str_list_contains_finds_and_misses() {
    let xs = teko::list::push(teko::list::push(teko::list::empty(), "a"), "b")
    teko::assert::is_true(str_list_contains(xs, "a"))
    teko::assert::is_true(str_list_contains(xs, "b"))
    teko::assert::is_true(!str_list_contains(xs, "c"))
}

/**
 * str_list_contains — is `needle` in `xs`? The assertion helper the claim tests read with.
 *
 * @param xs      the list to search
 * @param needle  the value to find
 * @return        true when present
 */
fn str_list_contains(xs: []str, needle: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i = i + 1
    }
    false
}

#test
/**
 * regr_group_module_text_wraps_the_statements_in_an_entry — the generated module: the snippet's
 * declarations stay verbatim ahead of a `pub fn entry()` carrying its statements, and a VALUE tail
 * becomes an explicit `exit(…)` so the virtual-main rule survives the move into a function body.
 *
 * @return void
 */
fn regr_group_module_text_wraps_the_statements_in_an_entry() {
    let text = regr_group_module_text("fn total() -> i32 { 42 }\ntotal()\n")
    teko::assert::is_true(teko::str::contains(text, "fn total() -> i32 { 42 }"))
    teko::assert::is_true(teko::str::contains(text, "pub fn entry() {"))
    teko::assert::is_true(teko::str::contains(text, "exit(total())"))
}

#test
/**
 * regr_group_module_text_leaves_a_void_tail_alone — the same generator over a snippet that already
 * ends in `exit(…)`: the tail must NOT be wrapped a second time (`exit(exit(0))` does not typecheck,
 * and the group build would fail for a snippet that was perfectly foldable).
 *
 * @return void
 */
fn regr_group_module_text_leaves_a_void_tail_alone() {
    let text = regr_group_module_text("let x = 21\nexit(x + x)\n")
    teko::assert::is_true(teko::str::contains(text, "exit(x + x)"))
    teko::assert::is_true(!teko::str::contains(text, "exit(exit"))
}

#test
/**
 * regr_group_main_text_dispatches_and_ends_at_exit_zero — the generated dispatcher: it reads the
 * selector, routes to each member, and ENDS at `exit(0)` (a member whose own virtual main fell
 * through exits 0), with the unknown-selector arm taking the loud sentinel instead.
 *
 * @return void
 */
fn regr_group_main_text_dispatches_and_ends_at_exit_zero() {
    let text = regr_group_main_text(regr_group_dispatch_line("m7"))
    teko::assert::is_true(teko::str::contains(text, REGR_GROUP_ENTRY_VAR))
    teko::assert::is_true(teko::str::contains(text, "if regr_entry == \"m7\" { regr_hit = true; m7::entry() }"))
    teko::assert::is_true(teko::str::contains(text, "exit(97)"))
    teko::assert::is_true(teko::str::ends_with(text, "exit(0)\n"))
}

#test
/**
 * regr_group_manifest_text_names_the_generated_project — the synthesized `.tkp` must root the
 * project at `src` (so every `src/m<k>/` directory becomes its own namespace, which is what keeps
 * two members' same-named declarations apart) and carry the fixed artifact name the runner resolves
 * the built binary through.
 *
 * @return void
 */
fn regr_group_manifest_text_names_the_generated_project() {
    let text = regr_group_manifest_text()
    teko::assert::is_true(teko::str::contains(text, "name = \"" ~ REGR_GROUP_PROJECT_NAME ~ "\""))
    teko::assert::is_true(teko::str::contains(text, "source = \"src\""))
    teko::assert::is_true(teko::str::contains(text, "kind = \"binary\""))
}

#test
/**
 * regr_group_key_separates_two_configurations — the key two rows must share to share a build: the
 * target plus every env token. Two rows differing in either must NOT key alike, or a differently
 * configured scenario would silently ride another one's build.
 *
 * @return void
 */
fn regr_group_key_separates_two_configurations() {
    let plain = regr_group_key(regr_test_row("", teko::list::empty()))
    let backend = regr_group_key(regr_test_row("", teko::list::push(teko::list::empty(), "TEKO_FOO=1")))
    let target = regr_group_key(regr_test_row("x86_64-windows", teko::list::empty()))
    teko::assert::is_true(plain != backend)
    teko::assert::is_true(plain != target)
    teko::assert::is_true(plain == regr_group_key(regr_test_row("", teko::list::empty())))
}

#test
/**
 * regr_row_groupable_refuses_what_the_fold_cannot_hold — the exclusion set, each arm for its own
 * measured reason: a compile-fail row (its build MUST fail), a project-based row (no inline source),
 * a leaf-tool row (the checked artifact would become the whole group's), and a `return`-bearing
 * snippet. NO row is excluded for its backend any more — every row is own-backend since the C
 * emitter was excised, so every group is SOLO (asserted here) and is emitted as its one source
 * verbatim, needing none of the dispatcher the backend cannot lower.
 *
 * @return void
 */
fn regr_row_groupable_refuses_what_the_fold_cannot_hold() {
    teko::assert::is_true(regr_row_groupable(".", regr_test_row("", teko::list::empty())))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_kind(TkrKind::CompileFail)))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_source("")))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_wellformed()))
    teko::assert::is_true(regr_group_solo(regr_group_key(regr_test_row("", teko::list::empty()))))
    teko::assert::is_true(!regr_row_groupable(".", regr_test_row_source("if bad() != 0 { return 1 }\nexit(0)\n")))
}

#test
/**
 * regr_row_source_reads_a_given_source_file_and_a_missing_one — the two halves of the file-based
 * fold. A row spelling its snippet as `Given source = "<file>"` must contribute the FILE'S TEXT (the
 * only spelling left once inline code is banned in a `.tkr`), and a row naming a file that is not
 * there must contribute "" and be refused by `regr_row_groupable` — never crash the plan pass, which
 * is not the pass that reports a manifest error.
 *
 * @return void
 */
fn regr_row_source_reads_a_given_source_file_and_a_missing_one() {
    let inline_row = regr_test_row_source("exit(1)\n")
    teko::assert::is_true(regr_row_source(".", inline_row) == "exit(1)\n")
    let missing = regr_test_row_file("__definitely_missing_case__.tks")
    teko::assert::is_true(regr_row_source(".", missing) == "")
    teko::assert::is_true(!regr_row_groupable(".", missing))
    let present = regr_test_row_file("cases/cross_exit42.tks")
    teko::assert::is_true(regr_row_source("examples/regressions/own_native", present).len > 0)
    teko::assert::is_true(regr_row_groupable("examples/regressions/own_native", present))
}

#test
/**
 * regr_group_slot_misses_an_unplanned_row_and_an_unbuilt_group — the fallback, stated as a lookup
 * law: a row the plan never bound has no slot, and a row whose group FAILED to build has none
 * either. Both answers send the caller down the ordinary per-scenario build path, which is what
 * makes a grouped build a pure optimisation.
 *
 * @return void
 */
fn regr_group_slot_misses_an_unplanned_row_and_an_unbuilt_group() {
    let member = RegrGroupMember { key = "k"; group = 0; module = "m0"; source = "exit(0)\n" }
    let members = teko::list::push(teko::list::empty(), member)
    let failed = teko::list::push(teko::list::empty(), RegrGroupBuild { ok = false; binp = ""; members = 1; times = phase_zero() })
    let ok = teko::list::push(teko::list::empty(), RegrGroupBuild { ok = true; binp = "b"; members = 1; times = phase_zero() })
    teko::assert::is_true(regr_group_slot_is_null(RegrGroups { members = members; builds = failed }, "k"))
    teko::assert::is_true(regr_group_slot_is_null(RegrGroups { members = members; builds = ok }, "other"))
    teko::assert::is_true(!regr_group_slot_is_null(RegrGroups { members = members; builds = ok }, "k"))
    teko::assert::is_true(regr_group_slot_is_null(regr_groups_empty(), "k"))
}

