use teko::casting

/**
 * TkrKind — the comparison policy a regressor's built artifact is checked under: `Exit` compares
 * the exact exit code (the robust default oracle); `Print` compares exit AND stdout; `Trap` asserts
 * a non-zero exit only (never byte-compares a trap against a platform's abort signal); `CompileFail`
 * asserts the BUILD fails and its diagnostic contains the expected substring. This is the frozen
 * in-memory lowering target the `.tkr` Gherkin parser lowers each scenario into (companion §1.2).
 *
 * `Trap` is the kind a deliberate-panic scenario wants, paired with a `stderr pattern` step: the
 * `Then it traps` half says the program died, and the pattern half says WHICH guard killed it,
 * and that the program chose to. Asserting an exact exit code proved neither — an abort's status
 * is synthesised from the wait status by whatever ran the child, so it is 134 under a POSIX
 * shell and something else on Windows, and no number distinguishes "the guard fired" from "the
 * binary never started" (see `TK_PANIC_MARKER`, src/runtime/teko_rt.h).
 *
 * @since 0.3.0.29
 */
pub type TkrKind = enum { Exit; Print; Trap; CompileFail; EmitOnly }

/**
 * TkrMatchMode — how one output stream is checked: `Ignore` (no expectation), `Literal` (exact
 * bytes), `Sha256` (a lowercase-hex sha256 of the bytes, for large/binary output), or `Pattern`
 * (a `teko::regex` pattern SEARCHED for anywhere in the stream). Modelled as a tag alongside
 * `TkrMatch.text` because Teko enums carry no payload.
 *
 * `Pattern` exists because some observable truths are not byte-stable across platforms while the
 * fact they prove is. A panic writes its marker line, then a backtrace that is a symbol list on
 * glibc and a single "unavailable on this platform" notice under musl; a positioned guard prefixes
 * a `line:col:` that a fixture must not have to restate. `Literal` can express neither without
 * pinning the parts that legitimately move, and the alternative the scenarios used instead —
 * asserting the abort's exit code — was proving something the SHELL invented, not something Teko
 * emitted (see `TK_PANIC_MARKER`, src/runtime/teko_rt.h).
 *
 * `Pattern` is a SEARCH, not a full match: the pattern must occur somewhere in the stream. Owner
 * ruling 2026-07-26 — an implicit total match was proposed and refused, because it would force
 * every pattern to be written `.*<it>.*` while stopping nobody from writing exactly that. The
 * anchors `^` and `$` are available to any scenario that wants the strict reading, which makes
 * exactness an explicit choice rather than a default nobody can opt out of.
 *
 * @since 0.3.0.29
 */
pub type TkrMatchMode = enum { Ignore; Literal; Sha256; Pattern }

/**
 * TkrMatch — an expected output stream: the `mode` (Ignore/Literal/Sha256/Pattern) plus `text`
 * (the literal expected bytes for `Literal`, the lowercase-hex digest for `Sha256`, the
 * `teko::regex` source for `Pattern`, "" for `Ignore`).
 *
 * @since 0.3.0.29
 */
pub type TkrMatch = struct {
    /** how the stream is checked. */
    mode: TkrMatchMode
    /** the expected bytes (Literal), the hex sha256 (Sha256), the regex (Pattern), "" (Ignore). */
    text: str
}

/**
 * TkrExpect — a per-os-arch expectation override declared by a `Then on "<os-arch>"` step, for the
 * legitimate divergences a target introduces (e.g. a Windows trap exit differing from a POSIX abort).
 * Each field overrides the top-level expectation ONLY for the named `osarch`; `has_exit`
 * distinguishes "override the exit code" from "leave it inherited".
 *
 * @since 0.3.0.29
 */
pub type TkrExpect = struct {
    /** the os-arch key this override applies to (e.g. "x86_64-windows", "x86_64-linux"). */
    osarch: str
    /** true when this override supplies an `exit` code (else the top-level exit is inherited). */
    has_exit: bool
    /** the overriding exit code (meaningful only when `has_exit`). */
    exit: i32
    /** the overriding stdout expectation (Ignore → inherit the top-level stdout). */
    stdout: TkrMatch
    /** the overriding stderr expectation (Ignore → inherit the top-level stderr). */
    stderr: TkrMatch
}

/**
 * TkrGolden — an opt-in strict per-os-arch byte golden: the lowercase-hex sha256 of the emitted
 * artifact for the named `osarch`. A per-target fixpoint — fragile across toolchains, so it is
 * additive to (never a replacement for) the portable output-based expectation.
 *
 * @since 0.3.0.29
 */
pub type TkrGolden = struct {
    /** the os-arch the golden hash pins (e.g. "x86_64-linux"). */
    osarch: str
    /** the expected lowercase-hex sha256 of the emitted `.o`/binary for that os-arch. */
    sha256: str
}

/**
 * Tkr — one lowered scenario's in-memory spec (the frozen check-layer model, NEVER a file on disk):
 * the opaque runtime inputs (`args`/`stdin`), the expected observable outputs (`exit`/`stdout`/
 * `stderr`, literal or hashed), the variant set to run (`targets`), per-os-arch overrides (`expect`),
 * the kind (exit/print/trap/compile_fail), the `compile_fail` diagnostic substring, and any opt-in
 * per-os-arch byte golden (`golden`). The `.tkr` Gherkin parser lowers each scenario into one `Tkr`
 * (an Outline into one per Examples row); the runner's check layer consumes it (companion §1.2).
 *
 * @since 0.3.0.29
 */
pub type Tkr = struct {
    /** argv passed to the built binary — the fold-opaque runtime operands (the opacity law). */
    args: []str
    /** bytes fed to the process stdin; "" when none. */
    stdin: str
    /** the classification driving the comparison policy. */
    kind: TkrKind
    /** expected exit code (ignored for `Trap`, which asserts non-zero only). */
    exit: i32
    /** expected stdout (Ignore/Literal/Sha256). */
    stdout: TkrMatch
    /** expected stderr (Ignore/Literal/Sha256). */
    stderr: TkrMatch
    /** the variants to run: os-arch names, `["all"]`, or `[]` → inherit `[tests] targets`. */
    targets: []str
    /** per-os-arch expectation overrides; empty when uniform. */
    expect: []TkrExpect
    /** opt-in per-os-arch byte goldens; empty when output-based. */
    golden: []TkrGolden
    /** for `CompileFail`: the required diagnostic substring ("" → assert failure only). */
    diagnostic: str
    /** an inline Teko source program (from `Given source inline`); "" when the scenario builds a dir `.tkp` or an explicit `source` file. @since 0.3.1 */
    source_inline: str
    /** an explicit standalone source file, relative to `regr_dir` (from `Given source`); "" when none. @since 0.3.1 */
    source_file: str
    /** per-scenario child env (`K=V` tokens) applied to compile AND run; from `Given env`/`Given target`. [] when none. @since 0.3.1 */
    env: []str
    /** the effective os-arch target (from `Given target`); "" or the `HOST_TARGET` sentinel (`"host"`) → the build host's native target. @since 0.3.1 */
    target: str
    /** true for the `When built in place` entry verb (the #64 CWD-relative shape: `teko build .` with CWD == `regr_dir`). @since 0.3.1 */
    in_place: bool
    /** the `Background: Given dependency` sub-project directory (relative to `regr_dir`); "" when the scenario needs no provisioned dependency. @since 0.3.1 */
    dep_dir: str
    /** true for a `Then object well-formed` step (post-build host-toolchain cross-check of the emitted `.o`). @since 0.3.1 */
    check_wellformed: bool
}

/**
 * tkr_match_ignore — the empty `TkrMatch` (no expectation on a stream).
 *
 * @return an `Ignore`-mode match
 * @since 0.3.0.29
 */
fn tkr_match_ignore(): TkrMatch { TkrMatch { mode = TkrMatchMode::Ignore; text = "" } }

/**
 * tkr_read_i32 — read an unquoted non-negative integer (an expected exit code) at `p` and narrow it
 * to the `i32` a process status is.
 *
 * Routed through `teko::casting::u64_to_i32` (returns `i32 | error`, never panics) rather than a bare
 * `to i32` (panics). The value comes from a `.tkr` FILE, which a human writes: `Then it exits with
 * 99999999999` is a typo in a spec, and a typo in a spec must become a diagnostic naming the file,
 * not an aborted compiler with "impossible conversion" and no filename. That is the recoverable row
 * of `docs/design/cast-width-hygiene-0.3.1.md` §10.2 — the caller can and does recover, because both
 * of this function's callers already return `TkrLower | error`.
 *
 * @param s  the line being read
 * @param p  the cursor at the value
 * @return   the parsed value as i32
 * @throws   error  when the number does not fit an `i32` (a malformed spec, named as such)
 * @see      teko::casting::u64_to_i32 — the checked no-panic converter this delegates to
 * @since 0.3.0.29
 */
fn tkr_read_i32(s: str, p: u64): i32 | error {
    match casting::u64_to_i32(mf_read_int(s, p)) {
        i32 as v => v
        error => error { message = teko::str::concat("tkr: expected exit code is not a process status (out of i32 range): ", s) }
    }
}

/**
 * tkr_expect_for — the per-os-arch override matching `osarch`, or `null` when the lowered `Tkr`
 * declares none for it (the runner then uses the top-level expectation).
 *
 * @param t       the lowered spec
 * @param osarch  the os-arch key to resolve
 * @return        the matching override, or `null`
 * @since 0.3.0.29
 */
fn tkr_expect_for(t: Tkr, osarch: str): TkrExpect | null {
    var k: u64 = 0
    loop {
        if k >= t.expect.len { break }
        if t.expect[k].osarch == osarch { return t.expect[k] }
        k = k + 1
    }
    null
}

/**
 * TkrPhase — the Gherkin step PHASE: `Given` (opaque runtime inputs), `When` (the entry verb that
 * classifies the exercise mode), or `Then` (the expected observable output). `And`/`But` inherit the
 * preceding step's phase and never appear as a distinct value here.
 *
 * @since 0.3.0.30
 */
pub type TkrPhase = enum { Given; When; Then }

/**
 * TkrStep — one lowered Gherkin step: the resolved `phase`, the `noun` phrase selecting a `Tkr`
 * field (e.g. "args", "exit", "stdout sha256", "source"), the entry `verb` for a When, the `osarch`
 * route from an `on "<os-arch>"` prefix, and the raw TOML `value` text (already placeholder-
 * substituted, still in surface form so the reused `mf_read_*` lexers decode it).
 *
 * @since 0.3.0.30
 */
pub type TkrStep = struct {
    /** the resolved phase (And/But inherit the previous step's). */
    phase: TkrPhase
    /** the noun-phrase selecting the target `Tkr` field ("" for an entry-verb When). */
    noun: str
    /** the entry verb ("built and run" | "compiled" | "compilation fails" | ""). */
    verb: str
    /** the os-arch route from an `on "<os-arch>"` prefix ("" = top-level expectation). */
    osarch: str
    /** the raw TOML value text right of `=` ("" for a valueless entry verb). */
    value: str
}

/**
 * TkrRow — one Examples data row: the ordered `cells` (column values). A wrapper struct rather than
 * a bare `[]str` because a `[][]str` nested-slice STRUCT FIELD is not yet emittable by the backend
 * (the optional/slice mangle twin's gap — reported up); `[]TkrRow` sidesteps it cleanly.
 *
 * @since 0.3.0.30
 */
pub type TkrRow = struct {
    /** the row's column values (parallel to the Examples headers). */
    cells: []str
}

/**
 * TkrExamples — a Scenario Outline's parameter table: `headers` (placeholder names) and `rows` (one
 * `TkrRow` of column values per case). Empty `headers` ⇒ a plain scenario (one implicit row).
 *
 * @since 0.3.0.30
 */
pub type TkrExamples = struct {
    /** the placeholder column names from the header row. */
    headers: []str
    /** one row of column values per parametrised case. */
    rows: []TkrRow
}

/**
 * TkrScenario — one scenario: `name`, whether it is an `outline`, its ordered `steps` (Background
 * Given steps prepended), and its `examples` table (empty for a plain scenario).
 *
 * @since 0.3.0.30
 */
pub type TkrScenario = struct {
    /** the scenario's free-text label (report line). */
    name: str
    /** true for a `Scenario Outline` (expanded per Examples row). */
    outline: bool
    /** the ordered steps (Background Given steps prepended). */
    steps: []TkrStep
    /** the parameter table (empty headers ⇒ a single implicit row). */
    examples: TkrExamples
}

/**
 * TkrFeature — one parsed `Feature:` block of a `.tkr` file: the `name` free text and the
 * `scenarios` (Background already folded into each scenario's steps). A file may hold MULTIPLE
 * features (`parse_tkr` returns `[]TkrFeature`); a project may hold multiple `.tkr` files — the
 * file↔project relation is free (companion §1.1, #40).
 *
 * @since 0.3.0.30
 */
pub type TkrFeature = struct {
    /** the Feature free-text label. */
    name: str
    /** the scenarios, each carrying the Background Given steps. */
    scenarios: []TkrScenario
}

/**
 * tkr_is_ws — is `c` an ASCII whitespace byte (space, tab, CR, LF)? The trim/hex-scan predicate.
 *
 * @param c  the byte
 * @return   true for space/tab/CR/LF
 * @since 0.3.0.30
 */
fn tkr_is_ws(c: byte): bool { c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' }

/**
 * tkr_trim — `s` with leading and trailing ASCII whitespace removed.
 *
 * @param s  the text
 * @return   the trimmed text
 * @since 0.3.0.30
 */
fn tkr_trim(s: str): str {
    var a: u64 = 0
    loop {
        if a >= s.len { break }
        if !tkr_is_ws(s[a]) { break }
        a = a + 1
    }
    var b = s.len
    loop {
        if b <= a { break }
        if !tkr_is_ws(s[b - 1]) { break }
        b = b - 1
    }
    teko::str::slice(s, a, b)
}

/**
 * tkr_find_byte — the index of the first `c` in `s` at or after `from`, or `s.len` when absent.
 *
 * @param s     the text
 * @param c     the byte to find
 * @param from  the start cursor
 * @return      the index of `c`, or `s.len`
 * @since 0.3.0.30
 */
fn tkr_find_byte(s: str, c: byte, from: u64): u64 {
    var k = from
    loop {
        if k >= s.len { break }
        if s[k] == c { return k }
        k = k + 1
    }
    s.len
}

/**
 * tkr_after — the remainder of `line` past `prefix` (already known to be a prefix of `line`),
 * trimmed of surrounding whitespace. Used to read a keyword line's free text or a step body.
 *
 * @param line    the source line
 * @param prefix  the matched keyword prefix
 * @return        the trimmed remainder
 * @since 0.3.0.30
 */
fn tkr_after(line: str, prefix: str): str { tkr_trim(teko::str::slice_from(line, prefix.len)) }

/**
 * tkr_table_cells — split a `| a | b | c |` table line into its trimmed cell values, dropping the
 * empty spans before the first `|` and after the last. A line with no `|` yields [].
 *
 * @param line  the table line
 * @return      the ordered cell values
 * @since 0.3.0.30
 */
fn tkr_table_cells(line: str): []str {
    var t = tkr_trim(line)
    var out: []str = teko::list::empty()
    if t.len == 0 || t[0] != b'|' { return out }
    var k: u64 = 1
    loop {
        if k >= t.len { break }
        var nb = tkr_find_byte(t, b'|', k)
        if nb >= t.len { break }
        out = teko::list::push(out, tkr_trim(teko::str::slice(t, k, nb)))
        k = nb + 1
    }
    out
}

/**
 * tkr_phase_of_keyword — the phase a leading step keyword selects: Given/When/Then map to their
 * phase; `And`/`But` inherit `prev`. Returns `prev` for a non-keyword (never reached — the caller
 * only calls this on a recognised keyword).
 *
 * @param kw    the keyword ("Given" | "When" | "Then" | "And" | "But")
 * @param prev  the preceding step's phase (for And/But inheritance)
 * @return      the resolved phase
 * @since 0.3.0.30
 */
fn tkr_phase_of_keyword(kw: str, prev: TkrPhase): TkrPhase {
    if kw == "Given" { return TkrPhase::Given }
    if kw == "When" { return TkrPhase::When }
    if kw == "Then" { return TkrPhase::Then }
    prev
}

/**
 * TkrStepKw — a step line resolved into its leading keyword and the trimmed body past it. The
 * keyword is "" when the line opens with no recognised step keyword.
 *
 * @since 0.3.0.30
 */
type TkrStepKw = struct {
    /** the recognised step keyword ("Given"/"When"/"Then"/"And"/"But"), or "". */
    kw: str
    /** the trimmed remainder of the line past the keyword. */
    body: str
}

/**
 * tkr_step_keyword — split a step line into its leading keyword + trimmed body, or a "" keyword when
 * the line does not open with `Given`/`When`/`Then`/`And`/`But` followed by a space.
 *
 * @param line  the trimmed source line
 * @return      the keyword + body split
 * @since 0.3.0.30
 */
fn tkr_step_keyword(line: str): TkrStepKw {
    if mf_starts_with(line, "Given ") { return TkrStepKw { kw = "Given"; body = tkr_after(line, "Given ") } }
    if mf_starts_with(line, "When ") { return TkrStepKw { kw = "When"; body = tkr_after(line, "When ") } }
    if mf_starts_with(line, "Then ") { return TkrStepKw { kw = "Then"; body = tkr_after(line, "Then ") } }
    if mf_starts_with(line, "And ") { return TkrStepKw { kw = "And"; body = tkr_after(line, "And ") } }
    if mf_starts_with(line, "But ") { return TkrStepKw { kw = "But"; body = tkr_after(line, "But ") } }
    TkrStepKw { kw = ""; body = "" }
}

/**
 * tkr_parse_step — lower one step body (past its keyword) into a `TkrStep`: an entry verb when it
 * carries no `=`, else an `on "<os-arch>"`-routed `noun = value` pair. The value keeps its surface
 * form (placeholders intact) so the reused `mf_read_*` lexers decode it after Outline substitution.
 *
 * @param phase  the step's resolved phase
 * @param body   the trimmed step body (past the keyword)
 * @return       the parsed step, or an `error` on a malformed `on "<os-arch>"` prefix
 * @throws       when an `on` prefix is present but its os-arch is not a quoted string
 * @since 0.3.0.30
 */
fn tkr_parse_step(phase: TkrPhase, body: str): TkrStep | error {
    var eq = tkr_find_byte(body, b'=', 0)
    if eq >= body.len {
        return TkrStep { phase = phase; noun = ""; verb = body; osarch = ""; value = "" }
    }
    var value = tkr_trim(teko::str::slice_from(body, eq + 1))
    var lhs = tkr_trim(teko::str::slice_to(body, eq))
    var osarch = ""
    if mf_starts_with(lhs, "on ") {
        var rest = tkr_trim(teko::str::slice_from(lhs, 3))
        var q = match mf_read_quoted(rest, 0) { MfQuoted as x => x; error as e => return e }
        osarch = q.text
        lhs = tkr_trim(teko::str::slice_from(rest, q.next))
    }
    TkrStep { phase = phase; noun = lhs; verb = ""; osarch = osarch; value = value }
}

/**
 * TkrParse — the in-progress `.tkr` parse. It accumulates COMPLETED features (`features`) and the
 * OPEN feature (`feat_active`/`name`/`scenarios`), the shared Background Given `bg` steps, the OPEN
 * scenario (`cur_*`), its `examples` accumulator, the `phase` inherited by an And/But, and the
 * location flags (`in_bg`/`have_cur`/`in_examples`). Bundled so each line handler is one small
 * `TkrParse -> TkrParse | error` step, keeping `parse_tkr` flat.
 *
 * @since 0.3.0.30
 */
type TkrParse = struct {
    /** the features closed by a subsequent `Feature:` opener (or end of file). */
    features: []TkrFeature
    /** true while a feature is open (a `Feature:` seen, or an implicit feature under a scenario). */
    feat_active: bool
    /** the open feature's free-text label. */
    name: str
    /** the open feature's scenarios closed so far. */
    scenarios: []TkrScenario
    /** the Background Given steps (prepended to every scenario on flush). */
    bg: []TkrStep
    /** true while a Background block is open (its Given steps append to `bg`). */
    in_bg: bool
    /** true while a Scenario/Scenario Outline is open (flushed on the next opener / EOF). */
    have_cur: bool
    /** the open scenario's label. */
    cur_name: str
    /** true when the open scenario is a `Scenario Outline`. */
    cur_outline: bool
    /** the open scenario's own steps (before Background prepend). */
    cur_steps: []TkrStep
    /** the open Examples header row (placeholder names); empty until read. */
    ex_headers: []str
    /** true once the Examples header row has been consumed. */
    ex_have_headers: bool
    /** the open Examples data rows. */
    ex_rows: []TkrRow
    /** true while an `Examples:` table is open (subsequent `|` lines are its rows). */
    in_examples: bool
    /** the phase an And/But inherits (the last Given/When/Then). */
    phase: TkrPhase
}

/**
 * tkr_parse_new — a fresh `TkrParse` before the first line (no features, nothing open).
 *
 * @return the initial parse state
 * @since 0.3.0.30
 */
fn tkr_parse_new(): TkrParse {
    TkrParse {
        features = teko::list::empty(); feat_active = false; name = ""; scenarios = teko::list::empty()
        bg = teko::list::empty(); in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = TkrPhase::Given
    }
}

/**
 * tkr_prepend_bg — a step list with the Background Given steps prepended, in Background-then-own
 * order (shared opaque inputs precede a scenario's own).
 *
 * @param bg     the Background Given steps
 * @param steps  the scenario's own steps
 * @return       the combined step list
 * @since 0.3.0.30
 */
fn tkr_prepend_bg(bg: []TkrStep, steps: []TkrStep): []TkrStep {
    var out: []TkrStep = teko::list::empty()
    var k: u64 = 0
    loop {
        if k >= bg.len { break }
        out = teko::list::push(out, bg[k])
        k = k + 1
    }
    var j: u64 = 0
    loop {
        if j >= steps.len { break }
        out = teko::list::push(out, steps[j])
        j = j + 1
    }
    out
}

/**
 * tkr_flush_cur — close the open scenario (if any) into the open feature's `scenarios`, folding the
 * Background steps and the Examples table into it, then clear the open-scenario/examples state. A
 * no-op when no scenario is open. The open feature (`feat_active`/`name`/`features`) is preserved.
 *
 * @param p  the parse state
 * @return   `p` with the open scenario appended and the per-scenario accumulators reset
 * @since 0.3.0.30
 */
fn tkr_flush_cur(p: TkrParse): TkrParse {
    if !p.have_cur { return p }
    var sc = TkrScenario {
        name = p.cur_name; outline = p.cur_outline
        steps = tkr_prepend_bg(p.bg, p.cur_steps)
        examples = TkrExamples { headers = p.ex_headers; rows = p.ex_rows }
    }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = teko::list::push(p.scenarios, sc)
        bg = p.bg; in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = p.phase
    }
}

/**
 * tkr_flush_feature — close the open scenario, then close the open feature into `features` (a
 * `TkrFeature` of its `name` + `scenarios`), resetting the open-feature accumulators. A no-op on the
 * feature close when no feature is open (`feat_active` false — an empty file yields no features).
 *
 * @param p  the parse state
 * @return   `p` with the open scenario and the open feature both closed
 * @since 0.3.0.30
 */
fn tkr_flush_feature(p: TkrParse): TkrParse {
    var f = tkr_flush_cur(p)
    if !f.feat_active { return f }
    var feat = TkrFeature { name = f.name; scenarios = f.scenarios }
    TkrParse {
        features = teko::list::push(f.features, feat); feat_active = false; name = ""; scenarios = teko::list::empty()
        bg = teko::list::empty(); in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = TkrPhase::Given
    }
}

/**
 * tkr_open_scenario — flush any open scenario and open a new one named `name`, `outline` selecting
 * `Scenario Outline` vs `Scenario`. Marks the feature active (an implicit feature when no explicit
 * `Feature:` opened one) and leaves Background mode.
 *
 * @param p        the parse state
 * @param name     the new scenario's label
 * @param outline  true for a `Scenario Outline`
 * @return         `p` with the new scenario open
 * @since 0.3.0.30
 */
fn tkr_open_scenario(p: TkrParse, name: str, outline: bool): TkrParse {
    var f = tkr_flush_cur(p)
    TkrParse {
        features = f.features; feat_active = true; name = f.name; scenarios = f.scenarios
        bg = f.bg; in_bg = false
        have_cur = true; cur_name = name; cur_outline = outline; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = TkrPhase::Given
    }
}

/**
 * tkr_add_step — append a parsed step to the open target: the Background list when in a Background
 * block, else the open scenario's own steps. Updates the inherited phase. A step outside any block
 * is an honest error (M.3).
 *
 * @param p     the parse state
 * @param step  the parsed step
 * @return      `p` with the step recorded, or an `error` when no block is open
 * @throws      when a step appears before any Background/Scenario opener
 * @since 0.3.0.30
 */
fn tkr_add_step(p: TkrParse, step: TkrStep): TkrParse | error {
    if p.in_bg {
        return TkrParse {
            features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios
            bg = teko::list::push(p.bg, step); in_bg = true
            have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
            ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
            in_examples = false; phase = step.phase
        }
    }
    if !p.have_cur { return error { message = "tkr: a step appears before any Scenario/Background" } }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios
        bg = p.bg; in_bg = false
        have_cur = true; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = teko::list::push(p.cur_steps, step)
        ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
        in_examples = false; phase = step.phase
    }
}

/**
 * tkr_add_table_row — record a `| … |` line under the open Examples: the first row is the header
 * (placeholder names), each subsequent row is a data row. An honest error when no Examples is open.
 *
 * @param p      the parse state
 * @param cells  the parsed cell values
 * @return       `p` with the header or a data row recorded, or an `error` outside an Examples block
 * @throws       when a `|` line appears with no open `Examples:`
 * @since 0.3.0.30
 */
fn tkr_add_table_row(p: TkrParse, cells: []str): TkrParse | error {
    if !p.in_examples { return error { message = "tkr: a table row appears outside an Examples block" } }
    if !p.ex_have_headers {
        return TkrParse {
            features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
            have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
            ex_headers = cells; ex_have_headers = true; ex_rows = p.ex_rows; in_examples = true; phase = p.phase
        }
    }
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
        have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
        ex_headers = p.ex_headers; ex_have_headers = true; ex_rows = teko::list::push(p.ex_rows, TkrRow { cells = cells })
        in_examples = true; phase = p.phase
    }
}

/**
 * tkr_open_examples — mark the open scenario's `Examples:` table as active (its header/rows follow).
 *
 * @param p  the parse state
 * @return   `p` with Examples reading enabled
 * @since 0.3.0.30
 */
fn tkr_open_examples(p: TkrParse): TkrParse {
    TkrParse {
        features = p.features; feat_active = p.feat_active; name = p.name; scenarios = p.scenarios; bg = p.bg; in_bg = false
        have_cur = p.have_cur; cur_name = p.cur_name; cur_outline = p.cur_outline; cur_steps = p.cur_steps
        ex_headers = p.ex_headers; ex_have_headers = p.ex_have_headers; ex_rows = p.ex_rows
        in_examples = true; phase = p.phase
    }
}

/**
 * tkr_open_feature — flush the open feature, then open a fresh feature named `nm` (an explicit
 * `Feature:` opener). Every prior feature is already closed into `features` by `tkr_flush_feature`.
 *
 * @param p   the parse state
 * @param nm  the new feature's free-text label
 * @return    `p` with the new feature open (no scenario yet)
 * @since 0.3.0.30
 */
fn tkr_open_feature(p: TkrParse, nm: str): TkrParse {
    var f = tkr_flush_feature(p)
    TkrParse {
        features = f.features; feat_active = true; name = nm; scenarios = teko::list::empty()
        bg = teko::list::empty(); in_bg = false
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = TkrPhase::Given
    }
}

/**
 * tkr_open_background — flush the open scenario, then open a Background block (its Given steps append
 * to a fresh `bg`). Marks the feature active (an implicit feature when none opened one).
 *
 * @param p  the parse state
 * @return   `p` with a Background block open
 * @since 0.3.0.30
 */
fn tkr_open_background(p: TkrParse): TkrParse {
    var f = tkr_flush_cur(p)
    TkrParse {
        features = f.features; feat_active = true; name = f.name; scenarios = f.scenarios
        bg = teko::list::empty(); in_bg = true
        have_cur = false; cur_name = ""; cur_outline = false; cur_steps = teko::list::empty()
        ex_headers = teko::list::empty(); ex_have_headers = false; ex_rows = teko::list::empty()
        in_examples = false; phase = TkrPhase::Given
    }
}

/**
 * tkr_apply_line — fold one already-trimmed `.tkr` line into the parse state: a Feature/Background/
 * Scenario/Examples opener, a `|` table row, or a `Given`/`When`/`Then`/`And`/`But` step. A blank or
 * `#`-comment line is skipped upstream; an unrecognised non-blank line is an honest error (M.3).
 *
 * @param p     the parse state
 * @param line  the trimmed source line (non-blank, non-comment)
 * @return      the updated parse state, or an `error` on a malformed step / stray table row
 * @throws      on an unrecognised line, a malformed step value, or a table row outside Examples
 * @since 0.3.0.30
 */
fn tkr_apply_line(p: TkrParse, line: str): TkrParse | error {
    if mf_starts_with(line, "Feature:") { return tkr_open_feature(p, tkr_after(line, "Feature:")) }
    if mf_starts_with(line, "Background:") { return tkr_open_background(p) }
    if mf_starts_with(line, "Scenario Outline:") { return tkr_open_scenario(p, tkr_after(line, "Scenario Outline:"), true) }
    if mf_starts_with(line, "Scenario:") { return tkr_open_scenario(p, tkr_after(line, "Scenario:"), false) }
    if mf_starts_with(line, "Examples:") { return tkr_open_examples(p) }
    if line[0] == b'|' { return tkr_add_table_row(p, tkr_table_cells(line)) }
    var kw = tkr_step_keyword(line)
    if kw.kw.len == 0 { return error { message = teko::str::concat("tkr: unrecognised line: ", line) } }
    var phase = tkr_phase_of_keyword(kw.kw, p.phase)
    var step = match tkr_parse_step(phase, kw.body) { TkrStep as s => s; error as e => return e }
    tkr_add_step(p, step)
}

/**
 * tkr_count_triple_quotes — the number of non-overlapping `"""` occurrences in `line`. A line
 * opening a raw multi-line docstring (`Given source inline = """`) carries exactly ONE; a
 * self-contained single-line value (e.g. a HEX docstring `= """0a 00"""`) carries an EVEN count.
 * Used by `parse_tkr` to tell the two shapes apart before deciding whether to slurp continuation
 * lines.
 *
 * @param line  the trimmed source line
 * @return      how many `"""` occurrences it carries
 * @since 0.3.1
 */
fn tkr_count_triple_quotes(line: str): u64 {
    var n: u64 = 0
    var k: u64 = 0
    loop {
        if k + 3 > line.len { break }
        if mf_at(line, k) == b'"' && mf_at(line, k + 1) == b'"' && mf_at(line, k + 2) == b'"' { n = n + 1; k = k + 3 } else { k = k + 1 }
    }
    n
}

/**
 * tkr_needs_docstring_continuation — does `line` open a RAW multi-line `"""` docstring whose close
 * has not yet been seen (an odd `"""` count)? True for `Given source inline = """`; false for an
 * already-closed single-line value and for any ordinary line.
 *
 * @param line  the trimmed source line
 * @return      true when `line` opens an unterminated `"""` docstring
 * @since 0.3.1
 */
fn tkr_needs_docstring_continuation(line: str): bool { tkr_count_triple_quotes(line) % 2 == 1 }

/**
 * TkrSlurp — the result of consuming a RAW multi-line docstring body: its decoded `text` (every
 * line between the opener and the closing `"""`-only line, newline-joined, verbatim — no escape
 * processing) and `next` (the source cursor just past the consumed closing-fence line).
 *
 * @since 0.3.1
 */
type TkrSlurp = struct {
    /** the docstring body, newline-joined, byte-for-byte as authored. */
    text: str
    /** the cursor just past the closing `"""` line. */
    next: u64
}

/**
 * tkr_slurp_docstring_body — consume RAW physical lines of `src` starting at `from` verbatim
 * (untrimmed — a Teko snippet's indentation is preserved byte-for-byte, though it is
 * parse-irrelevant) until a line whose TRIMMED form is exactly `"""` (the Gherkin closing-fence
 * convention) closes the docstring. M.3 when EOF is reached first (an unterminated docstring).
 *
 * @param src   the whole `.tkr` source
 * @param from  the cursor just past the opener line's newline
 * @return      the joined body text and the cursor past the closing line, or an `error` on EOF
 * @throws      when `src` ends before a closing `"""`-only line is found
 * @since 0.3.1
 */
fn tkr_slurp_docstring_body(src: str, from: u64): TkrSlurp | error {
    var cur = from
    var out = ""
    var first = true
    loop {
        if cur >= src.len { return error { message = "tkr: unterminated \"\"\" docstring (missing a closing \"\"\" line)" } }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var raw = teko::str::slice(src, cur, eol)
        var next = if eol < src.len { eol + 1 } else { eol }
        if tkr_trim(raw) == "\"\"\"" { return TkrSlurp { text = out; next = next } }
        if !first { out = out ~ "\n" }
        out = out ~ raw
        first = false
        cur = next
    }
    error { message = "tkr: unreachable docstring slurp" }
}

/**
 * tkr_strip_trailing_fence — `line` with its trailing `"""` opener fence removed (the caller has
 * already established `line` ends with it, via `tkr_needs_docstring_continuation`), so the
 * reconstructed one-line-equivalent step reads `<keyword> <noun> = <body>` with the multi-line
 * `<body>` appended in place of the bare fence.
 *
 * @param line  the trimmed opener line (ends with `"""`)
 * @return      `line` minus its trailing `"""`
 * @since 0.3.1
 */
fn tkr_strip_trailing_fence(line: str): str {
    if line.len < 3 { return line }
    teko::str::slice_to(line, line.len - 3)
}

/**
 * parse_tkr — read a `.tkr` (Gherkin) source into its `[]TkrFeature` (one per `Feature:` block; a
 * file with no explicit `Feature:` is one implicit feature carrying its scenarios; an empty file is
 * the empty list), or fail honestly (M.3). Reuses the manifest value lexers (`mf_read_quoted`/
 * `mf_read_array`/`mf_read_int`) verbatim for every right-hand side; introduces keyword-line +
 * Examples-table + HEX-docstring parsing, plus a RAW multi-line `"""` docstring continuation (for
 * `Given source inline`, 0.3.1 C1) that slurps subsequent physical lines verbatim until a
 * `"""`-only closing line. Background Given steps are prepended to every scenario (at flush).
 *
 * @param src  the `.tkr` file contents
 * @return     the parsed features, or an `error` on any malformed line / unknown noun-phrase
 * @throws     on a malformed keyword line, an unknown noun-phrase, a malformed value, or an
 *             unterminated `"""` docstring
 * @since 0.3.0.30
 */
fn parse_tkr(src: str): []TkrFeature | error {
    var p = tkr_parse_new()
    var cur: u64 = 0
    loop {
        if cur >= src.len { break }
        var eol = cur
        loop {
            if eol >= src.len { break }
            if src[eol] == b'\n' { break }
            eol = eol + 1
        }
        var raw = teko::str::slice(src, cur, eol)
        cur = if eol < src.len { eol + 1 } else { eol }
        var line = tkr_trim(raw)
        if line.len == 0 || line[0] == b'#' { continue }
        if tkr_needs_docstring_continuation(line) {
            var body = match tkr_slurp_docstring_body(src, cur) { TkrSlurp as s => s; error as e => return e }
            var full_line = tkr_strip_trailing_fence(line) ~ body.text
            p = match tkr_apply_line(p, full_line) { TkrParse as np => np; error as e => return e }
            cur = body.next
            continue
        }
        p = match tkr_apply_line(p, line) { TkrParse as np => np; error as e => return e }
    }
    var done = tkr_flush_feature(p)
    done.features
}

/**
 * tkr_hex_nibble — the value 0–15 of a hex digit byte, or an error for a non-hex byte (M.3).
 *
 * @param c  the candidate hex digit
 * @return   the nibble value, or an `error` when `c` is not `[0-9A-Fa-f]`
 * @throws   on a non-hex byte
 * @since 0.3.0.30
 */
fn tkr_hex_nibble(c: byte): u64 | error {
    if c >= b'0' && c <= b'9' { return (c to u64) - (b'0' to u64) }
    if c >= b'a' && c <= b'f' { return (c to u64) - (b'a' to u64) + 10 }
    if c >= b'A' && c <= b'F' { return (c to u64) - (b'A' to u64) + 10 }
    error { message = "tkr: non-hex byte in a HEX docstring" }
}

/**
 * tkr_read_hex_docstring — decode a `"""<hex>"""` docstring to raw bytes, ignoring ALL ASCII
 * whitespace between the fences. Carries CONTROL bytes (`\n`, `\0`, opcodes) LITERALLY into a
 * `Literal` `TkrMatch`, closing the `.tkr` newline-in-quoted-literal gap. M.3 on bad hex.
 *
 * @param s  the source starting at (or before) the opening `"""`
 * @param p  the cursor at the first `"`
 * @return   the decoded bytes, or an `error` on malformed hex / an unterminated docstring
 * @throws   on a non-hex nibble, an odd nibble count, or a missing closing `"""`
 * @since 0.3.0.30
 */
fn tkr_read_hex_docstring(s: str, p: u64): str | error {
    if !(mf_at(s, p) == b'"' && mf_at(s, p + 1) == b'"' && mf_at(s, p + 2) == b'"') {
        return error { message = "tkr: expected a \"\"\" HEX docstring" }
    }
    var k = p + 3
    var nibbles: []u64 = teko::list::empty()
    var closed = false
    loop {
        if k >= s.len { break }
        if mf_at(s, k) == b'"' && mf_at(s, k + 1) == b'"' && mf_at(s, k + 2) == b'"' { closed = true; k = k + 3; break }
        var c = s[k]
        if tkr_is_ws(c) { k = k + 1; continue }
        var n = match tkr_hex_nibble(c) { u64 as v => v; error as e => return e }
        nibbles = teko::list::push(nibbles, n)
        k = k + 1
    }
    if !closed { return error { message = "tkr: unterminated HEX docstring (missing closing \"\"\")" } }
    if nibbles.len % 2 != 0 { return error { message = "tkr: odd hex-nibble count in a HEX docstring" } }
    var bytes: []byte = teko::list::empty()
    var j: u64 = 0
    loop {
        if j >= nibbles.len { break }
        bytes = teko::list::push(bytes, (nibbles[j] * 16 + nibbles[j + 1]) to byte)
        j = j + 2
    }
    match str_from_utf8(bytes) { str as out => out; error as e => e }
}

/**
 * tkr_replace_all — every non-overlapping occurrence of `needle` in `hay` replaced by `rep`
 * (`needle` assumed non-empty — a placeholder token `<name>`).
 *
 * @param hay     the text
 * @param needle  the token to replace (non-empty)
 * @param rep     the replacement
 * @return        `hay` with every `needle` replaced
 * @since 0.3.0.30
 */
fn tkr_replace_all(hay: str, needle: str, rep: str): str {
    if needle.len == 0 { return hay }
    var out = ""
    var k: u64 = 0
    loop {
        if k >= hay.len { break }
        if k + needle.len <= hay.len && teko::str::slice(hay, k, k + needle.len) == needle {
            out = out ~ rep
            k = k + needle.len
        } else {
            out = out ~ teko::str::slice(hay, k, k + 1)
            k = k + 1
        }
    }
    out
}

/**
 * tkr_subst_row — textually substitute every `<header>` placeholder in `value` with the matching
 * column value from `row`, BEFORE the reused `mf_read_*` lexers see it. Substitution is purely
 * lexical, so a placeholder may sit anywhere inside a quoted string or an array element.
 *
 * @param value    the step value carrying `<name>` placeholders
 * @param headers  the Examples header names
 * @param row      the Examples row values (parallel to `headers`)
 * @return         the substituted value
 * @since 0.3.0.30
 */
fn tkr_subst_row(value: str, headers: []str, row: []str): str {
    var out = value
    var k: u64 = 0
    loop {
        if k >= headers.len { break }
        var col = if k < row.len { row[k] } else { "" }
        out = tkr_replace_all(out, teko::str::concat(teko::str::concat("<", headers[k]), ">"), col)
        k = k + 1
    }
    out
}

/**
 * tkr_step_subst — a copy of `step` with its `value` placeholder-substituted for `row`. A step with
 * no placeholders (e.g. a Background step or an entry verb) is returned unchanged in effect.
 *
 * @param step     the step
 * @param headers  the Examples header names
 * @param row      the Examples row values
 * @return         the substituted step
 * @since 0.3.0.30
 */
fn tkr_step_subst(step: TkrStep, headers: []str, row: []str): TkrStep {
    TkrStep {
        phase = step.phase; noun = step.noun; verb = step.verb; osarch = step.osarch
        value = tkr_subst_row(step.value, headers, row)
    }
}

/**
 * tkr_kind_for_verb — the `TkrKind` an entry verb / `it traps` selects: `compilation fails` ⇒
 * CompileFail, `it traps` ⇒ Trap, `built and run`/`compiled` ⇒ Print (both run and check the
 * declared streams; check_run treats Print and Exit alike bar the trap case), `built` ⇒ EmitOnly.
 * An unknown verb is an honest error (M.3).
 *
 * `WHEN BUILT` — BUILD AND ASSERT THE ARTEFACT, NEVER RUN IT. Owner ruling 2026-07-28: *"vale
 * incrementar o que o regressor faz (ensinar), é necessidade real."*
 *
 * The need is a CROSS row. `own_cross_x86_64_windows_emits_coff_and_skips_the_run` declares
 * `When built and run` + `Then exit = 42`, and on any host that cannot exec a foreign-format binary
 * the exit is never checked — so the runner honestly SKIPS it, and `no_skips_gate.sh` fails the
 * lane. That skip was correct: the row really did leave a claim unverified.
 *
 * The old grammar had no way out. `Tkr.exit` is a bare `i32` with no "was it declared" bit, so a
 * scenario omitting `Then exit` is indistinguishable from one asserting `exit = 0` — a row could
 * not say *"I claim the OBJECT, not the RUN"*. `When built` is that sentence. Nothing is left
 * unverified, so the row PASSES rather than skipping, and the gate keeps its teeth everywhere else.
 *
 * SAFE FOR THE BOOTSTRAP, and the owner named the reason: *"os testes só executam na gen2 nunca no
 * seed."* The ladder builds dry (`--no-verify`) and never reads a `.tkr`, so only the tip needs to
 * know this verb — a new entry keyword cannot break a seed that never parses one.
 *
 * @param verb  the entry verb text
 * @return      the selected kind, or an `error` for an unknown verb
 * @throws      when `verb` names no known entry
 * @since 0.3.0.30
 */
fn tkr_kind_for_verb(verb: str): TkrKind | error {
    if verb == "compilation fails" { return TkrKind::CompileFail }
    if verb == "it traps" { return TkrKind::Trap }
    if verb == "built" { return TkrKind::EmitOnly }
    if verb == "built and run" || verb == "compiled" { return TkrKind::Print }
    error { message = teko::str::concat("tkr: unknown When entry verb: ", verb) }
}

/**
 * tkr_get_expect — the per-os-arch override accumulator in `list` for `osarch`, or a fresh
 * inherit-everything override when absent. The caller mutates one field and puts it back.
 *
 * @param list    the overrides so far
 * @param osarch  the os-arch key
 * @return        the existing or a fresh override for `osarch`
 * @since 0.3.0.30
 */
fn tkr_get_expect(list: []TkrExpect, osarch: str): TkrExpect {
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == osarch { return list[k] }
        k = k + 1
    }
    TkrExpect { osarch = osarch; has_exit = false; exit = 0; stdout = tkr_match_ignore(); stderr = tkr_match_ignore() }
}

/**
 * tkr_put_expect — `list` with the override for `e.osarch` replaced by `e` (or `e` appended when
 * absent), an upsert keyed by os-arch.
 *
 * @param list  the overrides so far
 * @param e     the override to store
 * @return      `list` with `e` upserted
 * @since 0.3.0.30
 */
fn tkr_put_expect(list: []TkrExpect, e: TkrExpect): []TkrExpect {
    var out: []TkrExpect = teko::list::empty()
    var found = false
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == e.osarch { out = teko::list::push(out, e); found = true } else { out = teko::list::push(out, list[k]) }
        k = k + 1
    }
    if !found { out = teko::list::push(out, e) }
    out
}

/**
 * tkr_put_golden — `list` with the byte golden for `osarch` set to `sha` (upsert keyed by os-arch).
 *
 * @param list    the goldens so far
 * @param osarch  the os-arch key
 * @param sha     the expected artifact sha256
 * @return        `list` with the golden upserted
 * @since 0.3.0.30
 */
fn tkr_put_golden(list: []TkrGolden, osarch: str, sha: str): []TkrGolden {
    var out: []TkrGolden = teko::list::empty()
    var found = false
    var k: u64 = 0
    loop {
        if k >= list.len { break }
        if list[k].osarch == osarch { out = teko::list::push(out, TkrGolden { osarch = osarch; sha256 = sha }); found = true } else { out = teko::list::push(out, list[k]) }
        k = k + 1
    }
    if !found { out = teko::list::push(out, TkrGolden { osarch = osarch; sha256 = sha }) }
    out
}

/**
 * tkr_noun_stream_match — the `TkrMatch` for a stream noun-phrase value: `stdout`/`stderr` ⇒ Literal
 * bytes, `… sha256` ⇒ a Sha256 digest, `… bytes` ⇒ the HEX-docstring-decoded Literal bytes,
 * `… pattern` ⇒ a `teko::regex` source SEARCHED for in the stream. M.3 on a malformed quoted /
 * hex value.
 *
 * The four suffixes are recognised on both `stdout` and `stderr`, and both at top level and behind
 * an `on "<os-arch>"` route, because they are all read through this one function — a per-target
 * `Then on "x86_64-linux" stderr pattern = "…"` costs nothing extra.
 *
 * @param noun   the stream noun ("stdout" | "… sha256" | "… bytes" | "… pattern"; stderr alike)
 * @param value  the surface value (a quoted string or a `"""hex"""` docstring)
 * @return       the parsed match, or an `error` on a malformed value
 * @throws       on a malformed quoted string or HEX docstring
 * @since 0.3.0.30
 */
fn tkr_noun_stream_match(noun: str, value: str): TkrMatch | error {
    if teko::str::ends_with(noun, "bytes") {
        var b = match tkr_read_hex_docstring(value, 0) { str as x => x; error as e => return e }
        return TkrMatch { mode = TkrMatchMode::Literal; text = b }
    }
    var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
    if teko::str::ends_with(noun, "sha256") { return TkrMatch { mode = TkrMatchMode::Sha256; text = q.text } }
    if teko::str::ends_with(noun, "pattern") { return TkrMatch { mode = TkrMatchMode::Pattern; text = q.text } }
    TkrMatch { mode = TkrMatchMode::Literal; text = q.text }
}

/**
 * TkrLower — the in-progress lowering of a scenario to a `Tkr`: every top-level field plus the
 * per-os-arch `expect`/`golden` upserts. Bundled so each step folds through one small
 * `TkrLower -> TkrLower | error`.
 *
 * @since 0.3.0.30
 */
type TkrLower = struct {
    /** accumulated fold-opaque argv operands. */
    args: []str
    /** accumulated stdin bytes. */
    stdin: str
    /** the classification (defaults to Exit until a When sets it). */
    kind: TkrKind
    /** the expected exit code. */
    exit: i32
    /** the top-level stdout expectation. */
    stdout: TkrMatch
    /** the top-level stderr expectation. */
    stderr: TkrMatch
    /** the declared variant set. */
    targets: []str
    /** the compile-fail diagnostic substring. */
    diagnostic: str
    /** the per-os-arch expectation overrides. */
    expect: []TkrExpect
    /** the per-os-arch byte goldens. */
    golden: []TkrGolden
    /** an inline Teko source program; "" when none declared. @since 0.3.1 */
    source_inline: str
    /** an explicit standalone source file (relative to `regr_dir`); "" when none declared. @since 0.3.1 */
    source_file: str
    /** accumulated per-scenario child env (`K=V` tokens). @since 0.3.1 */
    env: []str
    /** the declared effective os-arch target; "" when none declared, `HOST_TARGET` when declared AS the host. @since 0.3.1 */
    target: str
    /** true once a `When built in place` entry verb is seen. @since 0.3.1 */
    in_place: bool
    /** the declared `Background: Given dependency` sub-project directory; "" when none declared. @since 0.3.1 */
    dep_dir: str
    /** true once a `Then object well-formed` step is seen. @since 0.3.1 */
    check_wellformed: bool
}

/**
 * tkr_lower_new — a fresh `TkrLower` at the documented defaults (kind Exit, exit 0, ignored streams,
 * empty lists).
 *
 * @return the initial lowering accumulator
 * @since 0.3.0.30
 */
fn tkr_lower_new(): TkrLower {
    TkrLower {
        args = teko::list::empty(); stdin = ""; kind = TkrKind::Exit; exit = 0
        stdout = tkr_match_ignore(); stderr = tkr_match_ignore(); targets = teko::list::empty()
        diagnostic = ""; expect = teko::list::empty(); golden = teko::list::empty()
        source_inline = ""; source_file = ""; env = teko::list::empty(); target = ""
        in_place = false; dep_dir = ""; check_wellformed = false
    }
}

/**
 * tkr_env_extend — `base` with every token of `extra` appended, in order. The accumulator step
 * `Given env`/`Given target` use to grow the per-scenario child env without a
 * general list-concat builtin (none exists in `teko::list`).
 *
 * @param base   the env tokens accumulated so far
 * @param extra  the tokens to append
 * @return       `base` followed by `extra`
 * @since 0.3.1
 */
fn tkr_env_extend(env0: []str, extra: []str): []str {
    var out = env0
    var k: u64 = 0
    loop {
        if k >= extra.len { break }
        out = teko::list::push(out, extra[k])
        k = k + 1
    }
    out
}

/**
 * tkr_target_env — the env token(s) `Given target` sugars to: a real cross target `t` →
 * `TEKO_TARGET=<t>`; the `HOST_TARGET` sentinel (`"host"`) and the empty value → NO token at all.
 * The sentinel exists so a target `Examples` table can spell its HOST row explicitly, and
 * for that row "the build host's own target" must mean exactly what an UNSET `TEKO_TARGET` means
 * (`native_target()`'s R1 host-derived default). Exporting `TEKO_TARGET=host` instead would hand
 * the own backend an unrecognised target name and earn its honest R2 stop on every host — turning
 * the table's host row red for spelling out the default it already had.
 *
 * @param value  the declared target name (a cross target, `"host"`, or "")
 * @return       the env token(s) the name sugars to, or `[]` for the host
 * @since 0.3.1
 */
fn tkr_target_env(value: str): []str {
    if value.len == 0 || value == HOST_TARGET { return teko::list::empty() }
    teko::list::push(teko::list::empty(), teko::str::concat("TEKO_TARGET=", value))
}

/**
 * HOST_OS_ARCH_TARGET — the `Given target` token meaning "THIS host's own os-arch, spelled out".
 *
 * It is not the same thing as `HOST_TARGET` (`"host"`) and the difference is the whole point. `host`
 * means "declare no target at all" — the row exercises the UNSET-`TEKO_TARGET` default path. This
 * token means "declare a target, and let it be the one this host natively builds" — the row
 * exercises the EXPLICITLY-SPELLED path, which is a different code path in the build and the one a
 * real user takes when they pin their own platform.
 *
 * WHY IT EXISTS (owner ruling 2026-07-27: *"precisa ensinar o regressor a entender diferentes OSes e
 * arquiteturas para variar um mesmo teste"*). A row that wanted "the explicitly-spelled host target"
 * had to hardcode one — `x86_64-linux` — which turns the row into a CROSS row on every other host and
 * earns it an honest skip there. Hardcoding an architecture where the subject is "an explicit
 * spelling" is what silently narrows the corpus to one machine. A row whose subject genuinely IS an
 * architecture (emitting COFF, emitting Mach-O) still names that architecture and still skips
 * honestly where the toolchain is absent — this token is for the other kind of row, and only that.
 */
const HOST_OS_ARCH_TARGET: str = "host-os-arch"

/**
 * tkr_resolve_target_name — the DECLARED target name a `Given target` value stands for, with
 * `HOST_OS_ARCH_TARGET` resolved to this host's own os-arch (`x86_64-linux`, `arm64-macos`, …), or
 * to the plain `HOST_TARGET` sentinel when this host's (os, arch) pair names no own-backend target
 * at all (`host_default_target`'s own honest R2 error): there is no real name to spell out
 * explicitly on such a host, so the row degrades to the EXACT same "declare no target" path the
 * plain `host` sentinel already takes — which the row's own capability probe
 * (`host_cc_cannot_link_host_default_reason`) then honestly skips, instead of exporting a
 * `TEKO_TARGET` this host cannot actually build.
 *
 * Resolved at LOWERING time, on purpose: every consumer downstream (the run-wrapper resolution, the
 * cross classification, the toolchain probe, the artifact extension, the object-format check) reads
 * `Tkr.target` as a real os-arch name, so a token that survived into the lowered row would have to be
 * understood again at each of those sites — six chances to forget one. Resolving here means exactly
 * one site knows the token exists.
 *
 * @param value  the surface `Given target` value
 * @return       the same value, this host's os-arch name when it is `HOST_OS_ARCH_TARGET` and the
 *               host has one, or `HOST_TARGET` when it does not
 * @since 0.3.1
 */
fn tkr_resolve_target_name(value: str): str {
    if value != HOST_OS_ARCH_TARGET { return value }
    match host_default_target() { NativeTarget as t => target_name(t); error => HOST_TARGET }
}

/**
 * tkr_apply_given — fold a `Given` noun (`args`/`stdin`/`stdin bytes`/`targets`/`source`/
 * `source inline`/`env`/`target`/`dependency`) into `b`. M.3 on a malformed value or an
 * unknown Given noun.
 *
 * @param b      the lowering accumulator
 * @param noun   the Given noun-phrase
 * @param value  the surface value
 * @return       the updated accumulator, or an `error` on a bad value / unknown noun
 * @throws       on a malformed value or an unknown Given noun-phrase
 * @since 0.3.0.30
 */
fn tkr_apply_given(b: TkrLower, noun: str, value: str): TkrLower | error {
    if noun == "source" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = q.text; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "source inline" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = value; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "env" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = tkr_env_extend(b.env, xs); target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "target" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        var name = tkr_resolve_target_name(q.text)
        var env2 = tkr_env_extend(b.env, tkr_target_env(name))
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = env2; target = name; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "dependency" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = q.text; check_wellformed = b.check_wellformed }
    }
    if noun == "args" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = xs; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "targets" {
        var xs = match mf_read_str_list(value, 0) { []str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = xs; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "stdin" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = q.text; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "stdin bytes" {
        var d = match tkr_read_hex_docstring(value, 0) { str as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = d; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown Given noun-phrase: ", noun) }
}

/**
 * tkr_apply_then_top — fold a top-level (no `on`) `Then` noun (`exit`/the stdout+stderr families/
 * `diagnostic`) into `b`. M.3 on a malformed value or an unknown Then noun.
 *
 * @param b      the lowering accumulator
 * @param noun   the Then noun-phrase
 * @param value  the surface value
 * @return       the updated accumulator, or an `error` on a bad value / unknown noun
 * @throws       on a malformed value or an unknown Then noun-phrase
 * @since 0.3.0.30
 */
fn tkr_apply_then_top(b: TkrLower, noun: str, value: str): TkrLower | error {
    if noun == "exit" {
        var code = match tkr_read_i32(value, 0) { i32 as v => v; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = code; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if noun == "diagnostic" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = q.text; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stdout") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = m; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stderr") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = m; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown Then noun-phrase: ", noun) }
}

/**
 * tkr_apply_then_osarch — fold an `on "<os-arch>"`-routed `Then` noun into a per-os-arch override
 * (`exit`/stdout/stderr) or a byte golden (`artifact sha256`). M.3 on a bad value.
 *
 * @param b       the lowering accumulator
 * @param osarch  the routed os-arch
 * @param noun    the Then noun-phrase
 * @param value   the surface value
 * @return        the updated accumulator, or an `error` on a bad value / unknown noun
 * @throws        on a malformed value or an unknown routed noun-phrase
 * @since 0.3.0.30
 */
fn tkr_apply_then_osarch(b: TkrLower, osarch: str, noun: str, value: str): TkrLower | error {
    if noun == "artifact sha256" {
        var q = match mf_read_quoted(value, 0) { MfQuoted as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = tkr_put_golden(b.golden, osarch, q.text); source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    var e = tkr_get_expect(b.expect, osarch)
    if noun == "exit" {
        var code = match tkr_read_i32(value, 0) { i32 as v => v; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = true; exit = code; stdout = e.stdout; stderr = e.stderr }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stdout") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = e.has_exit; exit = e.exit; stdout = m; stderr = e.stderr }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if mf_starts_with(noun, "stderr") {
        var m = match tkr_noun_stream_match(noun, value) { TkrMatch as x => x; error as er => return er }
        var ne = TkrExpect { osarch = osarch; has_exit = e.has_exit; exit = e.exit; stdout = e.stdout; stderr = m }
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = tkr_put_expect(b.expect, ne); golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    error { message = teko::str::concat("tkr: unknown routed Then noun-phrase: ", noun) }
}

/**
 * tkr_apply_step_lower — fold one step into the lowering: a When sets the kind (`built in place`
 * additionally marks `in_place`), a Given sets an opaque input, a Then sets a top-level or
 * `on`-routed expectation (or the verb-only leaf-tool flag `object well-formed`).
 * M.3 on any malformed value.
 *
 * @param b     the lowering accumulator
 * @param step  the (already placeholder-substituted) step
 * @return      the updated accumulator, or an `error` on a bad value / unknown phrase
 * @throws      on a malformed value, an unknown noun-phrase, or an unknown When verb
 * @since 0.3.0.30
 */
fn tkr_apply_step_lower(b: TkrLower, step: TkrStep): TkrLower | error {
    if step.phase == TkrPhase::When {
        if step.verb == "built in place" {
            return TkrLower { args = b.args; stdin = b.stdin; kind = TkrKind::Print; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = true; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
        }
        var k = match tkr_kind_for_verb(step.verb) { TkrKind as x => x; error as e => return e }
        return TkrLower { args = b.args; stdin = b.stdin; kind = k; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if step.phase == TkrPhase::Given { return tkr_apply_given(b, step.noun, step.value) }
    if step.verb == "it traps" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = TkrKind::Trap; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed }
    }
    if step.verb == "object well-formed" {
        return TkrLower { args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; diagnostic = b.diagnostic; expect = b.expect; golden = b.golden; source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = true }
    }
    if step.osarch.len > 0 { return tkr_apply_then_osarch(b, step.osarch, step.noun, step.value) }
    tkr_apply_then_top(b, step.noun, step.value)
}

/**
 * tkr_lower_to_tkr — fold a fully-substituted step list into a `Tkr` via the shared check-layer
 * model (the lowering IR). Used by both the plain-scenario and per-Outline-row paths.
 *
 * @param steps  the scenario's steps (Background-prepended, placeholder-substituted)
 * @return       the lowered spec, or an `error` on a malformed step value
 * @throws       on a malformed value or an unknown noun-phrase
 * @since 0.3.0.30
 */
fn tkr_lower_to_tkr(steps: []TkrStep): Tkr | error {
    var b = tkr_lower_new()
    var k: u64 = 0
    loop {
        if k >= steps.len { break }
        b = match tkr_apply_step_lower(b, steps[k]) { TkrLower as nb => nb; error as e => return e }
        k = k + 1
    }
    Tkr {
        args = b.args; stdin = b.stdin; kind = b.kind; exit = b.exit; stdout = b.stdout; stderr = b.stderr; targets = b.targets; expect = b.expect; golden = b.golden; diagnostic = b.diagnostic
        source_inline = b.source_inline; source_file = b.source_file; env = b.env; target = b.target; in_place = b.in_place; dep_dir = b.dep_dir; check_wellformed = b.check_wellformed
    }
}

/**
 * tkr_lower_scenario — lower one PLAIN scenario to a `Tkr`, folding Given/When/Then steps into the
 * reused `Tkr` model (`Given`→opaque inputs, `When`→kind, `Then`→expectations, routing
 * `on "<os-arch>"` into `TkrExpect`/`TkrGolden`). M.3 honest error on a bad value.
 *
 * @param sc  the scenario (steps already Background-prepended)
 * @return    the lowered spec, or an `error` on a malformed step value / unknown phrase
 * @throws    on a malformed value or an unknown noun-phrase
 * @since 0.3.0.30
 */
fn tkr_lower_scenario(sc: TkrScenario): Tkr | error { tkr_lower_to_tkr(sc.steps) }

/**
 * tkr_expand_outline — expand a `Scenario Outline` into one `Tkr` per Examples row by textually
 * substituting each `<name>` placeholder with the row's matching column value BEFORE the reused
 * `mf_read_*` lexers see it, then lowering. A plain scenario yields a single-element list.
 *
 * @param sc  the (outline) scenario
 * @return    one lowered spec per row, or an `error` on a width mismatch / bad value
 * @throws    on a row width mismatch, an unknown placeholder, or a malformed value
 * @since 0.3.0.30
 */
fn tkr_expand_outline(sc: TkrScenario): []Tkr | error {
    if !sc.outline || sc.examples.headers.len == 0 {
        var t = match tkr_lower_scenario(sc) { Tkr as x => x; error as e => return e }
        return teko::list::push(teko::list::empty(), t)
    }
    var out: []Tkr = teko::list::empty()
    var r: u64 = 0
    loop {
        if r >= sc.examples.rows.len { break }
        var row = sc.examples.rows[r].cells
        if row.len != sc.examples.headers.len { return error { message = "tkr: Examples row width does not match the header row" } }
        var subst: []TkrStep = teko::list::empty()
        var si: u64 = 0
        loop {
            if si >= sc.steps.len { break }
            subst = teko::list::push(subst, tkr_step_subst(sc.steps[si], sc.examples.headers, row))
            si = si + 1
        }
        var t = match tkr_lower_to_tkr(subst) { Tkr as x => x; error as e => return e }
        out = teko::list::push(out, t)
        r = r + 1
    }
    out
}

/**
 * tkb_scenario_is_declarative — true when a scenario has NO `When` entry verb: it is a
 * documentation-only meta-scenario (an R0 `# verified-by:` contract) and is honest-SKIPPED,
 * never executed. Lets `regressor.tkr` carry the self-host/fixpoint contract as living
 * documentation beside the executable language matrix.
 *
 * @param sc  the parsed scenario
 * @return    true when the scenario declares no `When` verb
 * @since 0.3.1
 */
fn tkb_scenario_is_declarative(sc: TkrScenario): bool {
    var k: u64 = 0
    loop {
        if k >= sc.steps.len { break }
        if sc.steps[k].phase == TkrPhase::When { return false }
        k = k + 1
    }
    true
}
