use teko::list

/**
 * linker_targets_arch — does `cmd` actually target (`arch`, `fmt`)?
 *
 * The assertion the ruling demands: finding a linker is not enough, it has to MIRAR o alvo pedido.
 * For a GNU-ld-compatible candidate the question is answered by exit code alone — `-m <emulation>
 * --version` fails on an unsupported emulation — so no output capture is needed, and none exists
 * (`teko::process` exposes `run`/`run_quiet`, both returning only a status).
 *
 * A pair with no GNU emulation name (every Mach-O pair, and the PE linkers, which take
 * `/machine:` rather than `-m`) cannot be probed this way; those return false here and are
 * asserted by their own arm in `resolve_linker`.
 *
 * WHAT THE PROBE MEANS PER VENDOR, measured on linux-x86_64/binutils-2.42 + LLVM lld:
 * `ld -m elf_x86_64 --version` exits 0 and `ld -m aarch64linux --version` exits 1, so for GNU ld
 * this is a genuine DISCRIMINATOR — a host-only BFD ld cannot claim a foreign machine. `ld.lld`
 * exits 0 for both, and that answer is honest rather than permissive: lld carries every target by
 * construction, so it really can emit aarch64 ELF from an x86_64 host. That is CROSS, which is
 * legitimate; what the ruling forbids is an EMULATED toolchain — one whose machine is not the
 * host's — and emulation is caught by `linker_is_mingw` plus the architecture assertion on the
 * PUBLISHED artifact (scripts/produce_assets.sh), not by this probe.
 *
 * @param cmd   the candidate linker command
 * @param arch  the machine the link must target
 * @param fmt   the container format the link must emit
 * @return      true iff the candidate ran and accepted the target's emulation
 */
fn linker_targets_arch(cmd: str, arch: LinkArch, fmt: LinkFormat) -> bool {
    let emu = gnu_emulation_for(arch, fmt)
    if emu.len == 0 { return false }
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, cmd)
    argv = teko::list::push(argv, "-m")
    argv = teko::list::push(argv, emu)
    argv = teko::list::push(argv, "--version")
    teko::process::run_quiet(argv) == 0
}

/**
 * pe_linker_targets_arch — does the PE candidate `cmd` target `arch`?
 *
 * `lld-link` and MSVC `link` take `/machine:<ARCH>` instead of GNU's `-m <emulation>`, and both
 * exit non-zero on a machine they cannot emit. `/?` makes the probe a help request rather than a
 * link attempt, so nothing is written and no input is needed.
 *
 * A machine this build has no PE target for spells to "" and is REFUSED here rather than probed:
 * a machine name the probe cannot assert must never reach a linker, because a candidate that
 * happens to exit 0 would then stand in for an assertion that was never made.
 *
 * @param cmd   the candidate PE linker command
 * @param arch  the machine the link must target
 * @return      true iff the candidate ran and accepted the machine
 */
fn pe_linker_targets_arch(cmd: str, arch: LinkArch) -> bool {
    let machine = match arch {
        LinkArch::X8664 => "/machine:X64"
        LinkArch::Arm64 => ""
    }
    if machine.len == 0 { return false }
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, cmd)
    argv = teko::list::push(argv, machine)
    argv = teko::list::push(argv, "/?")
    teko::process::run_quiet(argv) == 0
}

/**
 * macho_linker_targets_arch — does the Mach-O candidate `cmd` target `arch`?
 *
 * Apple's `ld` and LLVM's `ld64.lld` both take `-arch <name>` (never GNU's `-m <emulation>`), and
 * both answer `-v` with their version banner and exit 0 without touching a file — so `<cmd> -arch
 * <name> -v` is a link-free probe that runs iff the linker exists and accepts the machine, the
 * Mach-O sibling of `linker_targets_arch`'s `-m … --version` and `pe_linker_targets_arch`'s
 * `/machine: /?`. The `-arch` name is the same spelling `arch_name` gives ("arm64"/"x86_64"), which
 * is exactly the Mach-O `cpu` token, so no separate table is needed.
 *
 * @param cmd   the candidate Mach-O linker command
 * @param arch  the machine the link must target
 * @return      true iff the candidate ran and accepted the machine
 */
fn macho_linker_targets_arch(cmd: str, arch: LinkArch) -> bool {
    mut argv: []str = teko::list::empty()
    argv = teko::list::push(argv, cmd)
    argv = teko::list::push(argv, "-arch")
    argv = teko::list::push(argv, arch_name(arch))
    argv = teko::list::push(argv, "-v")
    teko::process::run_quiet(argv) == 0
}

/**
 * candidate_targets — the format-aware architecture assertion for one candidate.
 *
 * @param cmd   the candidate linker command
 * @param arch  the machine the link must target
 * @param fmt   the container format the link must emit
 * @return      true iff the candidate is native to the requested target
 */
fn candidate_targets(cmd: str, arch: LinkArch, fmt: LinkFormat) -> bool {
    if fmt == LinkFormat::Pe { return pe_linker_targets_arch(cmd, arch) }
    if fmt == LinkFormat::Macho { return macho_linker_targets_arch(cmd, arch) }
    linker_targets_arch(cmd, arch, fmt)
}

/**
 * resolve_linker — the linker for (`arch`, `fmt`), or a named refusal.
 *
 * Walks `linker_candidates` in order and returns the FIRST candidate that both survives the MinGW
 * ban and passes the architecture assertion. There is no last-resort arm: a host with no native
 * linker gets `no_linker_error`, never a silent `"cc"`.
 *
 * @param arch  the machine the link must target
 * @param fmt   the container format the link must emit
 * @return      the linker command to invoke
 * @throws      `mingw_rejected_error` when the only viable candidate is MinGW, else
 *              `no_linker_error` when no candidate targets the requested machine
 */
fn resolve_linker(arch: LinkArch, fmt: LinkFormat) -> str | error {
    let cands = linker_candidates(arch, fmt)
    mut saw_mingw = ""
    mut i: u64 = 0
    loop {
        if i >= cands.len { break }
        let cmd = cands[i]
        if linker_is_mingw(cmd) {
            saw_mingw = cmd
        } else if candidate_targets(cmd, arch, fmt) {
            return cmd
        }
        i = i + 1
    }
    if saw_mingw.len > 0 { return mingw_rejected_error(saw_mingw, arch) }
    no_linker_error(arch, fmt)
}
