// use teko::checker
// use teko::coverage
//
// // src/build/project.tks   (namespace 'teko::build')
// //
// // The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// // surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// // the directory resolution in main.c (project_dir_of). main.tks dispatches here:
// //   teko build <dir>  → compile_project  (front-end → native codegen)
// //   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
// //   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
// //
// // FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// // the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// // so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// // `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// // codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// // diverged to is retired, #524).
//
//
// light file-join process. The typed program is re-loaded ONLY for the dev-time `--per-test-cov`
// and `--analyzer` flags (never on any CI path), and lazily, so the gate path holds no AST at all.
//
// The Cobertura snapshot taken between the two merges is the PRE-REGRESSION picture the
// `--per-commit-test` delta gate compares against, exactly as the single-process driver took it
// between the gate and the tier — now rendered from the site-map, so byte-identical without the AST.
//
// @param dir              the project directory
// @param gen_cov          `--coverage` — write the Cobertura report next to the project root
// @param cov_validation   `--cov-validation` — enforce (fail) the coverage floors instead of warning
// @param per_test_cov     `--per-test-cov` — also print the dev-time per-test attribution report
// @param per_commit_base  `--per-commit-test <base>` — the git base for the delta gate ("" = no-op)
// @param analyzer         `--analyzer` — run the dev-time stale/redundant analyzer
// @param arith_cast_gate  `--arith-cast-gate` — enforce the D4 ARITH-CAST-RATE ceiling
// @return                 the run's final status, in the historic precedence order
// @throws                 the manifest/site-map read error, the Cobertura write failure, or a shard
// that left no coverage dump (`merge_gate_coverage`, J4 §2.4)
// @since 0.3.1.0
//
fn test_stage_report(dir: str, gen_cov: bool, cov_validation: bool, per_test_cov: bool, per_commit_base: str, analyzer: bool, arith_cast_gate: bool) -> i32 {
    let trc = stage_rc_of_env(TEST_GATE_RC_ENV)
    let regr_rc = stage_rc_of_env(TEST_REGR_RC_ENV)
    let m = match enter_project_manifest(dir) { Manifest as x => x; error as e => return fail(dir, e.message) }
    let sm = match read_sitemap(GATE_OUT_DIR, m) { coverage::SiteMap as x => x; error as e => return fail(dir, e.message) }
    match merge_gate_coverage(GATE_OUT_DIR, gate_paths(GATE_OUT_DIR, m), test_jobs(), trc) { error as e => return fail(dir, e.message); null => { } }
    let pre_regr_cob = coverage::cov_cobertura_of(sm)
    merge_regression_coverage()
    print_journal_summary(sm)
    if gen_cov {
        let xml = coverage::cov_cobertura_of(sm)
        match teko::io::write_file("cobertura.xml", xml) { error as e => return fail(dir, e.message); null => { } }
        teko::io::println("teko: wrote coverage report cobertura.xml")
    }
    let floor_rc = if trc == 0 { enforce_coverage_floors_sm(dir, sm, m, cov_validation) } else { 0 }
    mut per_commit_rc: i32 = 0
    if trc == 0 && floor_rc == 0 && per_commit_base.len > 0 {
        per_commit_rc = run_per_commit_test(dir, m, per_commit_base, cov_validation, pre_regr_cob)
    }
    let has_regr = m.test_regression_files.len > 0
    let gate_rc = test_gate_precedence(trc, floor_rc, per_commit_rc, has_regr, regr_rc)
    if gate_rc != 0 { return gate_rc }
    if arith_cast_gate {
        let acrc = arith_cast_verdict(checker::arith_cast_rate_from(sm.arith_total, sm.arith_with_conversion))
        if acrc != 0 { return acrc }
    }
    if per_test_cov { return report_per_test_cov(dir) }
    if analyzer { return report_analyzer(dir) }
    0
}

/**
 * report_per_test_cov — the `--per-test-cov` branch of the report stage. This dev-time flag needs
 * the typed program (it re-emits a single-test gate per `#test`), so it LAZILY re-checks the source
 * here — the only place the report stage still loads the AST, and one no CI path reaches.
 *
 * @param dir  the project directory (already the current directory)
 * @return     0 when every per-test gate built and ran, else the failing status
 * @throws     the re-check's first error
 * @since 0.3.1
 */
fn report_per_test_cov(dir: str) -> i32 {
    let fe = match recheck_frontend_here(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    run_per_test_cov(dir, fe)
}

/**
 * report_analyzer — the `--analyzer` branch of the report stage. Like `--per-test-cov` this dev-time
 * flag needs the typed program (it emits and runs the ANALYZE-mode gate), so it LAZILY re-checks
 * the source here rather than on the gate path.
 *
 * @param dir  the project directory (already the current directory)
 * @return     the analyzer's status
 * @throws     the re-check's first error
 * @since 0.3.1
 */
fn report_analyzer(dir: str) -> i32 {
    let fe = match recheck_frontend_here(dir) { Frontend as x => x; error as e => return fail(dir, e.message) }
    run_analyzer(dir, fe)
}

/**
 * recheck_frontend_here — re-check the project in the CURRENT directory (the caller has already
 * entered it), run QUIETLY under one named phase. Quiet because the file→namespace map and the
 * per-file counters were already printed by stage 1 and a second copy would read as a second build;
 * under a phase because a silent twenty-second gap is exactly the shape this codebase refuses to
 * leave in a log.
 *
 * @param dir  the project directory (for the phase label only — not re-entered)
 * @return     the re-checked front-end product
 * @throws     the front-end's first error, already settled onto the phase line
 * @since 0.3.1
 */
fn recheck_frontend_here(dir: str) -> Frontend | error {
    let phase = phase_begin("recheck", dir, report_mode(false, output_is_tty(false)))
    match frontend_body(true, true, false) {
        Frontend as fe => { phase_end_ok(phase, dir); fe }
        error as e => { phase_end_fail(phase, dir, e.message); e }
    }
}

//
// run_test_stage — re-invoke THIS binary for `stage`, with the argv the user typed. Everything the
// child needs beyond that is the stage selector and the two statuses, all in the environment.
//
// stdout is flushed FIRST: it is block-buffered whenever it is not a terminal, and the child
// writes to the same file description, so an unflushed line would land after the child's output
// and the log would read out of order.
//
// @param stage  `TEST_STAGE_BUILD`, `TEST_STAGE_REGR`, or `TEST_STAGE_REPORT`
//
