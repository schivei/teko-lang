/**
 * cap_synthetic — a `CapResult` the runner produced WITHOUT spawning anything (a guard rejection, an
 * unreadable source file, the empty initial build cache). Its phases are zero because no child ran.
 *
 * @param exit    the exit status to report
 * @param stderr  the message that stands in for the child's diagnostics
 * @return        the synthesized capture
 * @since 0.3.1
 */
fn cap_synthetic(exit: i32, stderr: str) -> CapResult {
    CapResult { exit = exit; stdout = ""; stderr = stderr; harness_ns = 0; child_ns = 0; cmd = ""; chan_text = "" }
}

/**
 * cap_with_extra_harness — `c` with `ns` more nanoseconds attributed to its HARNESS phase: the
 * scratch-tree work a caller did around the capture (wiping and repopulating a snippet project, for
 * instance) belongs to the same row's harness cost, not to the child's.
 *
 * @param c   the capture to attribute onto
 * @param ns  the extra harness nanoseconds
 * @return    `c` with its harness phase extended
 * @since 0.3.1
 */
fn cap_with_extra_harness(c: CapResult, ns: i64) -> CapResult {
    CapResult { exit = c.exit; stdout = c.stdout; stderr = c.stderr; harness_ns = c.harness_ns + ns; child_ns = c.child_ns; cmd = c.cmd; chan_text = c.chan_text }
}

/**
 * run_captured_env — `run_captured` with a per-child environment: run `argv` under `env` (`K=V`
 * tokens) with `stdin_data` on its stdin, capturing exit/stdout/stderr. `env` reaches ONLY the
 * spawned child — `teko::process::spawn_redirected` builds the child's environment itself, so the
 * runner's own process env is never touched (no `teko::env::set_var` leak across scenarios).
 * `env == []` is byte-identical to the old `run_captured`.
 *
 * @param argv        the command to run (argv[0] is the executable)
 * @param stdin_data  bytes to feed the child's stdin
 * @param env         the child environment as `K=V` tokens ([] = inherit only)
 * @param prefix      the scratch-file path prefix (its parent directory is created)
 * @return            the captured exit/stdout/stderr
 * @since 0.3.1
 */
fn run_captured_env(argv: []str, stdin_data: str, env: []str, prefix: str) -> CapResult {
    run_captured_spec(ProcSpec { argv = argv; dir = ""; env = env; stdin_data = stdin_data; prefix = prefix })
}

/**
 * run_captured_in_dir — `run_captured_env` with the child's working directory additionally set to
 * `dir` (the #64 CWD-relative shape `When built in place` needs: `teko build .` with CWD == `dir`,
 * not `teko build <dir>` from the runner's own cwd). `dir == "."` (or "") is the runner's own cwd,
 * unchanged — `spawn_redirected`'s own "" convention.
 *
 * @param argv        the command to run (argv[0] is the executable)
 * @param stdin_data  bytes to feed the child's stdin
 * @param env         the child environment as `K=V` tokens ([] = inherit only)
 * @param dir         the directory to run `argv` from
 * @param prefix      the scratch-file path prefix (its parent directory is created)
 * @return            the captured exit/stdout/stderr
 * @since 0.3.1
 */
fn run_captured_in_dir(argv: []str, stdin_data: str, env: []str, dir: str, prefix: str) -> CapResult {
    let effective_dir = if dir == "." { "" } else { dir }
    run_captured_spec(ProcSpec { argv = argv; dir = effective_dir; env = env; stdin_data = stdin_data; prefix = prefix })
}

/**
 * run_captured — run `argv` with `stdin_data` on its stdin, capturing exit/stdout/stderr via
 * `teko::process::spawn_redirected`'s own file redirection (`.in`/`.out`/`.err` under `prefix`).
 * The scratch directory is created if missing; on a read failure the captured stream is "". An
 * `env`-less `run_captured_env` call (0.3.1 C2).
 *
 * @param argv        the command to run (argv[0] is the executable)
 * @param stdin_data  bytes to feed the child's stdin
 * @param prefix      the scratch-file path prefix (its parent directory is created)
 * @return            the captured exit/stdout/stderr
 * @since 0.3.0.29
 */
fn run_captured(argv: []str, stdin_data: str, prefix: str) -> CapResult {
    run_captured_env(argv, stdin_data, teko::list::empty(), prefix)
}

/**
 * tool_on_path — is `name` an executable reachable on the child shell's `PATH`? Shells `command -v
 * <name>` — POSIX-portable, unlike `which`, and the ONE surviving use of a shell in this file: it
 * probes a shell BUILTIN, which has no standalone executable for `spawn_redirected`/`run` to launch
 * directly. Reads its exit status; used to honest-skip a leaf-tool step whose host
 * toolchain is absent (0.3.1 C3), rather than fabricate a pass or crash on a missing binary.
 *
 * `name` IS NOT SHELL-QUOTED, and that is a scoped, checked safety argument rather than an
 * oversight: every caller passes a cross/host `cc`
 * name this file itself resolved (`cross_cc_for_target`/`host_cc_arch`), never text that reaches
 * here from a `.tkr` scenario or any other untrusted source — none of those shapes can contain a
 * space or a shell metacharacter.
 *
 * @param name  the executable name to probe
 * @return      true when `command -v name` succeeds
 * @since 0.3.1
 */
fn tool_on_path(name: str) -> bool {
    mut shv: []str = teko::list::push(teko::list::empty(), "sh")
    shv = teko::list::push(shv, "-c")
    shv = teko::list::push(shv, teko::str::concat("command -v ", name) ~ " >/dev/null 2>&1")
    teko::process::run_quiet(shv) == 0
}

/**
 * TOOL_QUERY_PREFIX — the scratch-file prefix every toolchain QUERY (`tool_query_line`) captures
 * through, inside `REGR_WORK_DIR` (spelled out rather than concatenated from it — a `const` may not
 * call `~`, #594). One fixed prefix, not a per-call unique one: these queries are idempotent
 * readings of the host toolchain, so the last one's capture files are the only ones worth keeping,
 * and a unique prefix per call would litter the work tree with a file per row for no diagnostic
 * gain.
 *
 * THAT ARGUMENT HOLDS FOR ONE PROCESS AND FAILS FOR MANY, which is why `tool_query_line` no longer
 * uses this constant directly (see `tool_query_prefix`). Measured: an audit by MTIME of one whole
 * unit-gate run shows `.toolquery.{in,out,err}` among the files it rewrites, and the answer read back
 * out of `.out` decides SKIP versus FAIL for regression rows. Two concurrent readers do not merely
 * lose a file — the first one reads the SECOND one's answer, and answers a different question with it.
 */
const TOOL_QUERY_PREFIX: str = "bin/.regr-work/.toolquery"

/**
 * tool_query_prefix — `TOOL_QUERY_PREFIX`, scoped to the test that is asking when a test is asking.
 *
 * Outside a test `teko::test::scope()` is empty and this is byte-for-byte the old constant, so the
 * production regression runner's paths are unchanged; inside a test it is that test's own, so two
 * tests in two shards cannot answer each other's question.
 *
 * @return the capture prefix this caller may write
 */
fn tool_query_prefix() -> str { teko::test::scoped(TOOL_QUERY_PREFIX) }

/**
 * tool_query_line — ASK a host tool a question and read its one-line answer: run `argv`, and on a
 * ZERO exit return the first line of its stdout with any trailing carriage return stripped (a `sh`
 * on Windows can deliver CRLF); on any non-zero exit — including the shell's 127 for an absent
 * executable — return "". The empty answer is therefore ALWAYS "this host could not tell me", never
 * a fact, which is what lets every caller here fail SAFE by treating "" as "no reason to skip".
 *
 * This is the measurement style the capability probes use: ask the very toolchain that will do the
 * work what it is, rather than infer it from the kernel (`uname -m`) or from a path convention. The
 * two are NOT interchangeable — a Windows-on-ARM host whose `cc` is an emulated x86-64 toolchain
 * reports `aarch64` to `uname` and `x86_64` to the compiler, and it is the COMPILER that links.
 *
 * @param argv  the tool invocation (argv[0] is the executable)
 * @return      the first line of the tool's stdout, or "" when it failed or is absent
 * @since 0.3.1
 */
fn tool_query_line(argv: []str) -> str {
    let cap = run_captured(argv, "", tool_query_prefix())
    if cap.exit != 0 { return "" }
    trimmed_line(first_line(cap.stdout))
}

/**
 * REGRESSION_REQUIRE_TOOLS_VAR — the environment-variable key of the fail-closed toggle: on a
 * provisioned CI lane, setting it to `"1"` turns an absent-toolchain honest-skip (a `Given target`'s
 * cross linker, a leaf-tool `Then` step) into a hard FAILURE instead — a broken provisioning step
 * must not silently degrade to green (R2). A dev
 * laptop with the var unset keeps the honest-skip default.
 */
const REGRESSION_REQUIRE_TOOLS_VAR: str = "REGRESSION_REQUIRE_TOOLS"

/**
 * tool_skip_or_fail — turn a missing-toolchain `reason` into an honest skip, UNLESS
 * `REGRESSION_REQUIRE_TOOLS=1` is set (a provisioned CI lane), in which case it is a hard failure
 * (R2).
 *
 * @param reason  the missing-tool explanation
 * @return        a skip outcome by default, a fail outcome under the fail-closed flag
 * @since 0.3.1
 */
fn tool_skip_or_fail(reason: str) -> RegrOutcome {
    let require = match teko::env::var(REGRESSION_REQUIRE_TOOLS_VAR) { str as v => v == "1"; error => false }
    if require { return regr_fail(reason) }
    regr_skip(reason)
}

/**
 * regressive_name — the `name` of the regressive project at `regr_dir` (read from its single
 * `<name>.tkp`), used to locate the built binary at `<regr_dir>/bin/<name>`.
 *
 * @param regr_dir  the regressive project directory
 * @return          the project name, or an `error` when no single `.tkp` parses
 * @throws          when the directory has no `.tkp` or its manifest is malformed
 * @since 0.3.0.29
 */
fn regressive_name(regr_dir: str) -> str | error {
    let entries = match teko::fs::list_dir(regr_dir) { []str as e => e; error as e => return e }
    mut tkp = ""
    mut k: u64 = 0
    loop {
        if k >= entries.len { break }
        if teko::str::ends_with(entries[k], ".tkp") { tkp = entries[k] }
        k = k + 1
    }
    if tkp.len == 0 { return error { message = "regressive has no .tkp manifest" } }
    let text = match teko::io::read_file(regr_dir ~ "/" ~ tkp) { str as s => s; error as e => return e }
    let m = match parse_manifest(text) { Manifest as mm => mm; error as e => return e }
    m.name
}

/**
 * argv_with_args — build the run argv: the binary path (native form — `spawn_redirected` execs it
 * directly, no shell to satisfy) followed by the `.tkr` `args` UNCHANGED (the fold-opaque runtime
 * operands — never path-normalized, since they are not necessarily paths).
 *
 * @param binp  the built binary path
 * @param args  the argv operands from the `.tkr`
 * @return      the full run argv
 * @since 0.3.0.29
 */
fn argv_with_args(binp: str, args: []str) -> []str {
    mut out: []str = teko::list::push(teko::list::empty(), binp)
    mut k: u64 = 0
    loop {
        if k >= args.len { break }
        out = teko::list::push(out, args[k])
        k = k + 1
    }
    out
}

/**
 * tkr_effective_target — the os-arch a leaf-tool check runs against: the scenario's declared
 * `Given target` when it names a REAL cross target, else this build host's own `teko::os()`. The
 * `HOST_TARGET` sentinel (`"host"`) resolves to the host exactly like an undeclared target — it is
 * the spelling a two-column backend×target `Examples` table uses for its host row, and it must
 * never be handed to a leaf-tool selector as if it were an os-arch name.
 *
 * @param target  the scenario's declared target ("" / "host" → host default)
 * @return        the effective os-arch
 * @since 0.3.1
 */
fn tkr_effective_target(target: str) -> str {
    if target.len > 0 && target != HOST_TARGET { return target }
    teko::os()
}

/**
 * HOST_CC_NAME — the compiler token `resolve_cc`/`default_cc_for_target` return for a target that
 * links with the BUILD HOST's own toolchain. A target resolving to it needs no cross-toolchain
 * probe, so the name is pinned here rather than spelled inline at the comparison site.
 */
const HOST_CC_NAME: str = "cc"

/**
 * cross_cc_for_target — the CROSS-compiler a `Given target` build will actually link through, or ""
 * when `target` needs none. Delegates to the very function the build itself uses
 * (`target_from_name` + `default_cc_for_target`), so the runner's pre-build capability probe can
 * never drift from the toolchain the build then invokes. An unrecognised target name yields "" — its
 * honest R2 stop belongs to `emit_native`, not here.
 *
 * IT ANSWERS "" FOR EVERY TARGET TODAY, and that is a fact about the toolchains rather than about
 * this code: `default_cc_for_target` no longer names a cross driver for any target, because the only
 * one it ever named was MinGW's and MinGW is banned — a cross build stops at the object instead
 * (`links_with_cc`). The delegation stays because the answer must keep coming from the build's own
 * resolution: the day a legitimate cross driver exists (the project's own linker, after the natives),
 * this probe learns about it without being edited.
 *
 * @param target  the scenario's declared target ("" / "host" → the host toolchain)
 * @return        the cross-compiler command, or "" when this target needs no cross driver
 * @since 0.3.1
 */
fn cross_cc_for_target(target: str) -> str {
    if target.len == 0 || target == HOST_TARGET { return "" }
    let cc = match target_from_name(target) { NativeTarget as t => default_cc_for_target(t); error => "" }
    if cc == HOST_CC_NAME { return "" }
    cc
}

