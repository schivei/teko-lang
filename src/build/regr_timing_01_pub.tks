/**
 * src/build/regr_timing.tks   (namespace `teko::build`)
 *
 * REGRESSION TIMING — the observability half of the regression runner (owner ruling 2026-07-25:
 * *"colocar o tempo de execução de cada regressão, para entendermos o que pode ser um detrator"*).
 *
 * It is NOT a gate. Nothing here can fail a run, and no time value ever reaches an artifact: the
 * fixpoint requires the compiler to rebuild itself byte-for-byte, so timings live only in the
 * `teko test` report on stdout.
 *
 * WHY THREE PHASES AND NOT ONE NUMBER. Measured on the .31 corpus before this was written: 263
 * declared scenarios expand to ~322 builds (each `Examples` row is a full project build), the whole
 * regression phase took 8m33s in CI, and the largest inline source is NINE lines. That is ~1.6 s per
 * build of a 3-to-9-line program — a per-build FIXED cost (scratch tree, `sh -c`, a whole front-end
 * start-up, a `cc` invocation, the binary itself), not a cost proportional to the fixture. A single
 * number per scenario would print a nearly flat list at ~1.6 s and point at no detractor at all. So
 * every row is measured in three parts:
 *
 *   - `harness` — creating/cleaning the scratch project, writing the source, building argv/env, the
 *     `sh -c` plumbing and reading the capture files back;
 *   - `compile` — the compiler invocation itself, INCLUDING the host `cc` it spawns (they share one
 *     child process, so no cheap split exists here; separating them needs the compiler to report its
 *     own `cc` time, which is a compiler change, not a runner one);
 *   - `run` — executing the built binary (zero for a `compilation fails` scenario).
 */

/**
 * PhaseTimes — one measurement, in monotonic nanoseconds, plus how many BUILDS it covers. Summing
 * two `PhaseTimes` sums each phase and the build count, so the same type serves a row, a scenario, a
 * feature, a file and the whole phase (one aggregation rule, no per-level arithmetic to get wrong).
 */
pub type PhaseTimes = struct {
    /** scratch/IO/plumbing time around the children, in ns. */
    harness_ns: i64
    /** time inside the compiler child (its own `cc` included), in ns. */
    compile_ns: i64
    /** time inside the built binary, in ns (0 for a compile-fail row). */
    run_ns: i64
    /** how many project builds this measurement covers. */
    builds: u64
}

/**
 * RowTiming — the timing of ONE expanded scenario row (one `Examples` line, or the scenario itself
 * when it has no `Examples`), labelled well enough to appear in a report a human reads.
 */
pub type RowTiming = struct {
    /** the enclosing feature's name (the table groups by it). */
    feature: str
    /** the scenario's name. */
    scenario: str
    /** the row's index within the scenario's expanded `Examples` (0 when there are none). */
    row: u64
    /** true when the row was honest-SKIPPED (kept in the tables, with its ~0 time, so the aggregate cannot overstate what ran). */
    skipped: bool
    /** the row's own three-phase measurement. */
    times: PhaseTimes
}

/**
 * phase_zero — an empty measurement (every phase 0, no builds), the identity for `phase_add`.
 *
 * @return the zero measurement
 */
pub fn phase_zero() -> PhaseTimes {
    PhaseTimes { harness_ns = 0; compile_ns = 0; run_ns = 0; builds = 0 }
}

/**
 * phase_add — the sum of two measurements, phase by phase (and build count by build count).
 *
 * @param a  the first measurement
 * @param b  the second measurement
 * @return   their sum
 */
pub fn phase_add(a: PhaseTimes, b: PhaseTimes) -> PhaseTimes {
    PhaseTimes {
        harness_ns = a.harness_ns + b.harness_ns
        compile_ns = a.compile_ns + b.compile_ns
        run_ns = a.run_ns + b.run_ns
        builds = a.builds + b.builds
    }
}

/**
 * phase_total_ns — a measurement's wall total: the three phases added together.
 *
 * @param p  the measurement
 * @return   harness + compile + run, in ns
 */
pub fn phase_total_ns(p: PhaseTimes) -> i64 {
    p.harness_ns + p.compile_ns + p.run_ns
}

/**
 * rows_total — the sum of every row's measurement (the file/phase aggregate).
 *
 * @param rows  the measured rows
 * @return      their summed measurement
 */
pub fn rows_total(rows: []RowTiming) -> PhaseTimes {
    mut acc = phase_zero()
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        acc = phase_add(acc, rows[i].times)
        i++
    }
    acc
}

/**
 * rows_skipped — how many of the measured rows were honest-skipped. Reported alongside the totals so
 * a fast file is never read as a fast file when it was in fact a mostly-skipped one (the same lesson
 * as the `N run, S skipped, F failed` summary).
 *
 * @param rows  the measured rows
 * @return      the count of skipped rows
 */
pub fn rows_skipped(rows: []RowTiming) -> u64 {
    mut n: u64 = 0
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        if rows[i].skipped { n = n + 1 }
        i++
    }
    n
}

/**
 * regr_ms_text — `ns` rendered as milliseconds, or as seconds with one decimal once it passes a
 * second. Milliseconds are the resolution that matters here (a whole build is ~1.6 s and a phase of
 * it can be a few ms); anything finer is runner noise.
 *
 * @param ns  the duration in nanoseconds
 * @return    the rendered duration, unit suffix included
 */
pub fn regr_ms_text(ns: i64) -> str {
    let ms = ns / REGR_NS_PER_MS
    if ms < REGR_MS_PER_S { return $"{ms}ms" }
    let tenths = ms / (REGR_MS_PER_S / 10)
    $"{tenths / 10}.{tenths % 10}s"
}

/**
 * regr_share_text — `part` as a whole-percent share of `whole` ("0%" when `whole` is 0, so a
 * zero-length phase never divides by zero).
 *
 * @param part   the phase's own time
 * @param whole  the total the share is taken of
 * @return       the rendered percentage
 */
pub fn regr_share_text(part: i64, whole: i64) -> str {
    if whole <= 0 { return "0%" }
    $"{(part * REGR_PERCENT) / whole}%"
}

/**
 * regr_totals_text — the compact totals a per-file report line carries: builds, wall total, and the
 * three phases as shares of it.
 *
 * @param p  the file's summed measurement
 * @return   the parenthesised totals text, e.g. `322 builds, 8.5s: harness 12% / compile 84% / run 4%`
 */
pub fn regr_totals_text(p: PhaseTimes) -> str {
    let total = phase_total_ns(p)
    let h = regr_share_text(p.harness_ns, total)
    let c = regr_share_text(p.compile_ns, total)
    let r = regr_share_text(p.run_ns, total)
    $"{p.builds} builds, {regr_ms_text(total)}: harness {h} / compile {c} / run {r}"
}

/**
 * regr_row_line — one row's line in a table: its three phases, its total, and its skip mark.
 *
 * @param rt  the measured row
 * @return    the rendered line (no trailing newline)
 */
pub fn regr_row_line(rt: RowTiming) -> str {
    let mark = if rt.skipped { " [skipped]" } else { "" }
    let t = rt.times
    $"    {regr_ms_text(phase_total_ns(t))}  (harness {regr_ms_text(t.harness_ns)} / compile {regr_ms_text(t.compile_ns)} / run {regr_ms_text(t.run_ns)})  {rt.feature} :: {rt.scenario}[{rt.row}]{mark}"
}
