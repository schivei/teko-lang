// src/build/regr_timing_report.tks   (namespace 'teko::build')
//
// Reporting and output functions for regression timing results.

/**
 * feature_names_of — every distinct feature name among `rows`, in first-appearance order (the order
 * the file declares them, which is the order a reader scrolls).
 *
 * @param rows  the measured rows
 * @return      the distinct feature names
 */
fn feature_names_of(rows: []RowTiming) -> []str {
    mut names: []str = teko::list::empty()
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        if !str_list_has(names, rows[i].feature) { names = teko::list::push(names, rows[i].feature) }
        i++
    }
    names
}

/**
 * str_list_has — is `needle` already in `xs`? (The distinct-name accumulator's membership test.)
 *
 * @param xs      the accumulated names
 * @param needle  the name to look for
 * @return        true when present
 */
fn str_list_has(xs: []str, needle: str) -> bool {
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i++
    }
    false
}

/**
 * feature_total — the summed measurement of every row belonging to `feature`.
 *
 * @param rows     the measured rows
 * @param feature  the feature name to total
 * @return         that feature's summed measurement
 */
fn feature_total(rows: []RowTiming, feature: str) -> PhaseTimes {
    mut acc = phase_zero()
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        if rows[i].feature == feature { acc = phase_add(acc, rows[i].times) }
        i++
    }
    acc
}

/**
 * regr_print_feature_table — the per-feature table: one line per feature with its build count, wall
 * total and mean per build. A dozen features fit a log; a couple of hundred scenarios do not.
 *
 * @param rows  the measured rows of one `.tkr` file
 */
pub fn regr_print_feature_table(rows: []RowTiming) {
    let names = feature_names_of(rows)
    if names.len == 0 { return }
    teko::io::println("teko: regression timings by feature (builds, total, mean/build)")
    mut i: u64 = 0
    loop {
        if i >= names.len { break }
        let ft = feature_total(rows, names[i])
        let total = phase_total_ns(ft)
        let mean = if ft.builds == 0 { 0 } else { total / (ft.builds to i64) }
        teko::io::println($"    {ft.builds} builds  {regr_ms_text(total)}  mean {regr_ms_text(mean)}  {names[i]}")
        i++
    }
}

/**
 * slowest_index_excluding — the index of the slowest row not already in `taken` (index 0 when every
 * row is taken, which `regr_print_slowest`'s bound makes unreachable).
 *
 * @param rows   the measured rows
 * @param taken  the indices already printed
 * @return       the index of the slowest remaining row
 */
fn slowest_index_excluding(rows: []RowTiming, taken: []u64) -> u64 {
    mut best: u64 = 0
    mut best_ns: i64 = -1
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        let t = phase_total_ns(rows[i].times)
        if !u64_list_has(taken, i) && t > best_ns {
            best = i
            best_ns = t
        }
        i++
    }
    best
}

/**
 * u64_list_has — is `needle` in `xs`? (The already-printed index set's membership test.)
 *
 * @param xs      the accumulated indices
 * @param needle  the index to look for
 * @return        true when present
 */
fn u64_list_has(xs: []u64, needle: u64) -> bool {
    mut i: u64 = 0
    loop {
        if i >= xs.len { break }
        if xs[i] == needle { return true }
        i++
    }
    false
}

/**
 * regr_print_slowest — the N slowest rows, each with its three phases. Selection is an N-pass scan
 * of maxima rather than a sort: N is 20 and the row count is in the hundreds, so this stays trivially
 * correct (and allocation-free) where a sort would be a second thing to get right.
 *
 * @param rows  the measured rows of one `.tkr` file
 * @param n     how many rows to list
 */
pub fn regr_print_slowest(rows: []RowTiming, n: u64) {
    if rows.len == 0 { return }
    let want = if rows.len < n { rows.len } else { n }
    teko::io::println($"teko: regression timings — {want} slowest row(s)")
    mut taken: []u64 = teko::list::empty()
    mut k: u64 = 0
    loop {
        if k >= want { break }
        let pick = slowest_index_excluding(rows, taken)
        teko::io::println(regr_row_line(rows[pick]))
        taken = teko::list::push(taken, pick)
        k = k + 1
    }
}

/**
 * regr_timings_verbose — did this invocation ask for the FULL per-row dump (`--regr-timings`)?
 * Read straight off this process's argv, the same shape `allow_undef_selected` (project.tks) uses,
 * so an observability flag needs no plumbing through the test driver.
 *
 * The default is the summary (totals + feature table + slowest rows) for LEGIBILITY, not to save
 * work: every row is measured either way, and flipping the default to "print everything" is a
 * one-line change here if the owner prefers the full dump.
 *
 * @return true iff `--regr-timings` is present in argv
 */
pub fn regr_timings_verbose() -> bool {
    let argv = teko::env::args()
    mut i: u64 = 0
    loop {
        if i >= argv.len { break }
        if argv[i] == REGR_TIMINGS_FLAG { return true }
        i++
    }
    false
}

/**
 * regr_print_all_rows — every measured row, one line each, in run order: the `--regr-timings` dump,
 * meant to be diffed between two runs.
 *
 * @param rows  the measured rows of one `.tkr` file
 */
pub fn regr_print_all_rows(rows: []RowTiming) {
    teko::io::println($"teko: regression timings — all {rows.len} row(s)")
    mut i: u64 = 0
    loop {
        if i >= rows.len { break }
        teko::io::println(regr_row_line(rows[i]))
        i++
    }
}

/**
 * regr_print_timings — the whole per-file timing report: the feature table plus either every row
 * (`--regr-timings`) or the slowest slice. Silent for a file that measured nothing (a wholly
 * declarative `.tkr` builds nothing and has nothing to say).
 *
 * @param rows  the measured rows of one `.tkr` file
 */
pub fn regr_print_timings(rows: []RowTiming) {
    if rows.len == 0 { return }
    regr_print_feature_table(rows)
    if regr_timings_verbose() {
        regr_print_all_rows(rows)
        return
    }
    regr_print_slowest(rows, REGR_SLOWEST_DEFAULT)
}
