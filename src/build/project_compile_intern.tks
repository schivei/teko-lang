use teko::checker
use teko::lir
use teko::list
use teko::parser

// use teko::checker
// use teko::lir
// use teko::parser
//
// // src/build/project.tks   (namespace 'teko::build')
// //
// // The PROJECT ORCHESTRATION entry layer — the canonical Teko ORIGINAL of the project
// // surfaces in src/driver.c (project_frontend / tk_compile_project / tk_run_project) and
// // the directory resolution in main.c (project_dir_of). main.tks dispatches here:
// //   teko build <dir>  → compile_project  (front-end → native codegen)
// //   teko run   <dir>  → run_project      (front-end → native codegen + execute, debug profile)
// //   teko <projarg>    → project_dir_of   (a `.tkp` → its dir; else the dir as-is)
// //
// // FAITHFUL-NOT-LITERAL (M.3). It mirrors the C twins' SHAPE and contracts in native Teko:
// // the C uses out-params (project_frontend(dir, &prog, &manifest)); Teko has NO out-params,
// // so the shared front-end returns a small `Frontend` struct (prog + manifest), as
// // `Frontend | error`. Both entries (build/run) run the SAME front-end AND the SAME
// // codegen→cc backend; `run` additionally executes the resulting binary (the interpreter this once
// // diverged to is retired, #524).
//
//
// (`src/backend/isel_arm64.tks`/`regalloc.tks`), outside this crumb's declared scope.
//
fn copy_lrodata_to_current_region(r: teko::lir::LRodata) -> teko::lir::LRodata {
    let symbol = copy_str_to_current_region(r.symbol)
    let bytes = copy_bytes_to_current_region(r.bytes)
    let relocs = copy_ldata_relocs_to_current_region(r.relocs)
    teko::lir::LRodata { symbol = symbol; bytes = bytes; relocs = relocs }
}

/**
 * commit_rodata_delta — copy to the root-resident rodata accumulator `robase` the entries an
 * item's lowering interned beyond `robase`'s own length (the item's delta), each one copied
 * field-by-field into the current region (E4). Called with the item's scratch region still alive
 * (after `region_leave()`, before `region_drop`), so the next item's dedup and the final
 * `.rodata` section see entries resident in the root, never inside a region about to be dropped.
 *
 * @param robase  the root-resident rodata accumulator (the prefix already committed)
 * @param grown   the rodata table the item's lowering returned (the SAME prefix plus its delta)
 * @return        `robase` extended with the delta, resident in the current region
 * @since 0.3.1 C6.2
 */
fn commit_rodata_delta(robase: []teko::lir::LRodata, grown: []teko::lir::LRodata) -> []teko::lir::LRodata {
    mut out = robase
    mut i: u64 = robase.len
    loop {
        if i >= grown.len { break }
        out = teko::list::push(out, copy_lrodata_to_current_region(grown[i]))
        i++
    }
    out
}

/**
 * commit_loose — append to the root-resident `loose` accumulator `acc` the loose top-level
 * statements an item contributed beyond `acc`'s own length (E6). Every element is a
 * `checker::TStatement` residing in `prog` (root) since long before any scratch region opened, so
 * only the list SPINE needs rebuilding here — no field of an individual statement needs copying.
 * Called after `region_leave()` so the new spine nodes land in the root, for the virtual-main to
 * read once every item's region has dropped.
 *
 * @param acc    the root-resident loose accumulator
 * @param delta  the loose statements the item's lowering returned (the SAME prefix plus its delta)
 * @return       `acc` extended with the delta, resident in the current region
 * @since 0.3.1 C6.2
 */
fn commit_loose(acc: []checker::TStatement, delta: []checker::TStatement) -> []checker::TStatement {
    mut out = acc
    mut i: u64 = acc.len
    loop {
        if i >= delta.len { break }
        out = teko::list::push(out, delta[i])
        i++
    }
    out
}

/**
 * FusedItemOut — one item's (or the virtual-main's) contribution from inside its own scoped
 * region: the ENCODED functions (its own top-level `LFunc` plus any newly lifted closures/thunks,
 * still possibly referencing the region's memory), the grown rodata table (seed prefix + this
 * item's interned delta), the grown loose-statement list, and how many NEW lifted functions this
 * item added (E5 — only the COUNT crosses the window; the caller extends the root placeholder list
 * by it). The caller commits every field to the root BEFORE the region drops
 * (`docs/design/native-lowering-oom-por-funcao-0.3.1.md` §3).
 *
 * @since 0.3.1 C6.3
 */
type FusedItemOut = struct {
// encoded — this item's own function plus its newly lifted functions, already encoded.
    encoded: []teko::backend::EncodedFuncX86
// rodata — the rodata table this item's lowering grew (seed prefix + its own delta).
    rodata: []teko::lir::LRodata
// loose — the loose top-level statement list this item grew (seed prefix + its own delta).
    loose: []checker::TStatement
// new_lifted_count — how many NEW lifted closures/thunks this item's lowering created.
    new_lifted_count: u64
}

/**
 * lifted_suffix — the entries of `all` from index `from` onward: the NEW lifted functions an
 * item's (or the virtual-main's) lowering created, once the root placeholder prefix
 * (`docs/design/native-lowering-oom-por-funcao-0.3.1.md` §4b's E5-wiring) is excluded.
 *
 * @param all   the lowering step's full lifted-function list (placeholder prefix + real suffix)
 * @param from  the placeholder prefix's length (the running lifted count BEFORE this step)
 * @return      the real, newly lifted functions only
 * @since 0.3.1 C6.3
 */
fn lifted_suffix(all: []teko::lir::LFunc, from: u64) -> []teko::lir::LFunc {
    mut out: []teko::lir::LFunc = teko::list::empty()
    mut i: u64 = from
    loop {
        if i >= all.len { break }
        out = teko::list::push(out, all[i])
        i++
    }
    out
}

/**
 * concat_lfuncs — `a` followed by every entry of `b`, in order.
 *
 * @param a  the first function list
 * @param b  the function list to append
 * @return   `a` followed by `b`
 * @since 0.3.1 C6.3
 */
fn concat_lfuncs(a: []teko::lir::LFunc, b: []teko::lir::LFunc) -> []teko::lir::LFunc {
    mut out = a
    mut i: u64 = 0
    loop {
        if i >= b.len { break }
        out = teko::list::push(out, b[i])
        i++
    }
    out
}

/**
 * frame_escape_window — `teko::lir::frame_escape_guard`'s WHOLE-MODULE check applied to just `fs`
 * (one item's own function plus its newly lifted ones), wrapped in a throwaway `LModule` — the
 * per-function guts of the check are already independent per function
 * (`func_returns_frame_address`, `frame_escape.tks:69-77`), so checking `fs` alone here verifies
 * exactly the same functions the whole-module call would, just inside the item's own window
 * instead of after every item has lowered (§2c's R4). ISA-agnostic — shared by every fused native
 * tail's per-item window (x86, arm64-macos, arm64-linux, win64; 0.3.1 C6.4 widened the name from
 * `_x86` since the check never touched anything x86-specific).
 *
 * @param fs  the functions to check (this item's own plus its new lifted)
 * @return    `null` when none returns a frame address, else the propagated NAMED error
 * @since 0.3.1 C6.3
 */
fn frame_escape_window(fs: []teko::lir::LFunc) -> null | error {
    teko::lir::frame_escape_guard(teko::lir::LModule { funcs = fs; rodata = teko::list::empty(); globals = teko::list::empty(); layouts = teko::list::empty() })
}

/**
 * extend_lifted_placeholders — `ph` extended by `count` symbol-only placeholder `LFunc`s (E5's
 * root-resident id reservation, §4b/§6): the fused driver never holds the LIR of a PAST item's
 * lifted functions (they were encoded and dropped with that item's region), but `lower_item` still
 * needs a `lifted` list whose LENGTH equals the running total, since only `.len` is ever read when
 * reserving a new thunk/lambda's id (`lower.tks:5620`/`6057` — never dereferenced). The placeholder
 * bodies are never encoded, so their content is irrelevant; only the count matters.
 *
 * @param ph     the root-resident placeholder list so far
 * @param count  how many new placeholders to append
 * @return       `ph` extended by `count` placeholders
 * @since 0.3.1 C6.3
 */
fn extend_lifted_placeholders(ph: []teko::lir::LFunc, count: u64) -> []teko::lir::LFunc {
    mut out = ph
    mut i: u64 = 0
    loop {
        if i >= count { break }
        out = teko::list::push(out, teko::lir::new_func("", 0, teko::list::empty(), teko::lir::LType::Void))
        i++
    }
    out
}

/**
 * fuse_lower_item_x86 — lower ONE program item and encode its output, ENTIRELY inside the
 * caller's already-entered scratch region (the fused driver's per-item window,
 * `docs/design/native-lowering-oom-por-funcao-0.3.1.md` §4): seed a throwaway `LModule` with EMPTY
 * `funcs` (so `lower_item`'s `add_func` yields only THIS item's own `LFunc`, §4b), lower the item,
 * isolate its newly lifted functions (`lifted_suffix`), run the frame-escape guard over the item's
 * own function plus those (moved per-item, §2c), then encode all of them. Every native honest-stop
 * (from lowering, the guard, or encoding) propagates out unchanged.
 *
 * @param robase    the root-resident rodata accumulator (read-only seed for this item's dedup)
 * @param prelude   the whole-program lowering context (`teko::lir::lower_prelude`)
 * @param loose     the root-resident loose-statement accumulator (read-only seed)
 * @param it        the program item to lower
 * @param lifted_ph  the root-resident lifted-count placeholder list (length = the running total)
 * @return          this item's encoded output + grown rodata/loose + new-lifted count, or a
 *                  propagated honest-stop
 * @since 0.3.1 C6.3
 */
fn fuse_lower_item_x86(robase: []teko::lir::LRodata, prelude: teko::lir::LowerPrelude, loose: []checker::TStatement, it: checker::TItem, lifted_ph: []teko::lir::LFunc) -> FusedItemOut | error {
    let seed = teko::lir::LModule { funcs = teko::list::empty(); rodata = robase; globals = prelude.module.globals; layouts = prelude.module.layouts }
    let step = match teko::lir::lower_item(seed, loose, it, prelude.layouts, prelude.enums, lifted_ph, prelude.externs, false, prelude.variants, prelude.table, prelude.ref_fns, prelude.field_decls) { teko::lir::LowerItemOut as x => x; error as e => return e }
    let new_lifted = lifted_suffix(step.lifted, lifted_ph.len)
    let item_funcs = concat_lfuncs(step.module.funcs, new_lifted)
    match frame_escape_window(item_funcs) { error as e => return e; null => { } }
    let encoded = match encode_lfuncs_in_region_x86(item_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = step.module.rodata; loose = step.loose; new_lifted_count = new_lifted.len }
}

/**
 * fuse_virtual_main_x86 — lower the synthesized virtual-main and encode it, ENTIRELY inside the
 * caller's already-entered scratch region: `lower_virtual_main` over every item's collected loose
 * statement (continuing the SAME lifted-id numbering via `lifted_ph`, §4b), the platform-ABI entry
 * wrap (`teko::lir::wrap_native_entry` — renames `main` to the internal symbol and appends the
 * `argc`/`argv` stub, §4a) applied to a throwaway one-function `LModule` so no whole-module table
 * is materialized, the frame-escape guard, then encoding — mirroring `fuse_lower_item_x86` for the
 * one synthesized "item" that runs after every real one has already dropped its region.
 *
 * @param loose     every item's collected loose top-level statement, in program order
 * @param prelude   the whole-program lowering context
 * @param robase    the root-resident rodata accumulator (read-only seed)
 * @param lifted_ph  the root-resident lifted-count placeholder list (length = the running total)
 * @return          the entry's encoded output (renamed vmain + stub + any new lifted) + grown
 *                  rodata, or a propagated honest-stop
 * @since 0.3.1 C6.3
 */
fn fuse_virtual_main_x86(loose: []checker::TStatement, prelude: teko::lir::LowerPrelude, robase: []teko::lir::LRodata, lifted_ph: []teko::lir::LFunc) -> FusedItemOut | error {
    let vmain = match teko::lir::lower_virtual_main(loose, prelude.layouts, prelude.enums, robase, lifted_ph, prelude.externs, false, prelude.variants, prelude.ref_fns, prelude.field_decls, prelude.table) { teko::lir::LoweredFunction as x => x; error as e => return e }
    let new_lifted = lifted_suffix(vmain.lifted, lifted_ph.len)
    let seed = teko::lir::LModule { funcs = teko::list::push(teko::list::empty(), vmain.func); rodata = vmain.rodata; globals = prelude.module.globals; layouts = prelude.module.layouts }
    let wrapped = match teko::lir::wrap_native_entry(seed) { teko::lir::LModule as x => x; error as e => return e }
    let all_funcs = concat_lfuncs(wrapped.funcs, new_lifted)
    match frame_escape_window(all_funcs) { error as e => return e; null => { } }
    let encoded = match encode_lfuncs_in_region_x86(all_funcs) { []teko::backend::EncodedFuncX86 as x => x; error as e => return e }
    FusedItemOut { encoded = encoded; rodata = vmain.rodata; loose = teko::list::empty(); new_lifted_count = new_lifted.len }
}

/**
 * native_trace_items_enabled — whether the fused native driver's per-item lowering trace
 * (`TEKO_NATIVE_TRACE_ITEMS=1`) is requested: a diagnostic aid, NOT part of the ritual's normal
 * output, for narrowing a crash (a signal, not a `TEKO_SOFT`-caught honest-stop) that happens
 * mid-`emit_native_x86` — printing each item's label to stderr immediately BEFORE its own scoped
 * region opens, so the LAST line on stderr names the exact item whose lowering-or-encode a native
 * fatal signal interrupted, instead of only the generic "entered native lowering" phase boundary
 * `checker`/`monomorph`/`consteval` already report around.
 *
 * @return  true iff `TEKO_NATIVE_TRACE_ITEMS` is set to `"1"`
 * @since 0.3.1
 */
fn native_trace_items_enabled() -> bool {
    match teko::env::var("TEKO_NATIVE_TRACE_ITEMS") { str as v => v == "1"; error => false }
}

/**
 * item_trace_label — a short, best-effort human label for one program item (its kind plus its own
 * name, when the kind carries one), for `native_trace_items_enabled`'s per-item lowering trace.
 * Never fails: a kind with no natural single name (a loose top-level statement, a passed-through
 * `use`/type declaration this backend does not name specially here) renders a generic tag instead.
 *
 * @param it  the program item to label
 * @return    the item's trace label
 * @since 0.3.1
 */
fn item_trace_label(it: checker::TItem) -> str {
    match it {
        checker::TFunction as f => teko::str::concat("fn ", teko::str::concat(f.namespace, teko::str::concat("::", f.name)))
        checker::TConstDecl as c => teko::str::concat("const ", teko::str::concat(c.namespace, teko::str::concat("::", c.name)))
        parser::TypeDecl as td => teko::str::concat("type ", td.name)
        _ => "loose statement / use"
    }
}

/**
 * native_lowering_mono_ns — binds the EXISTING runtime symbol `tk_rt_monotonic_ns` (also wrapped by
 * `journal::mono_ns_rt` and `time::monotonic_ns`) so the per-item native-lowering trace can stamp a
 * wall-clock window around each item WITHOUT a new C symbol. Kept private to this backend driver, the
 * one place that times item lowering. The origin is unspecified; only DELTAS between two readings on
 * the same run are meaningful, which is exactly what a per-item duration is.
 *
 * @return  a monotonically non-decreasing nanosecond reading
 * @since 0.3.1 native-lowering-timing
 */
extern fn native_lowering_mono_ns() -> i64 = "tk_rt_monotonic_ns" from "teko_rt"
