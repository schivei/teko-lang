/**
 * OV_A_PATH — the first fixture file's path (deliberately not on disk — every fixture test below
 * OVERRIDES every file it names, so `assemble_with_overrides` never falls through to a real read).
 */
const OV_A_PATH: str = "virtual/a.tks"

/**
 * OV_A_SRC — `OV_A_PATH`'s override buffer: a single well-typed public function.
 */
const OV_A_SRC: str = "pub fn a(): i64 { return 1 }"

/**
 * OV_B_PATH — the second fixture file's path.
 */
const OV_B_PATH: str = "virtual/b.tks"

/**
 * OV_B_SRC — `OV_B_PATH`'s override buffer: a single well-typed public function.
 */
const OV_B_SRC: str = "pub fn b(): i64 { return 2 }"

/**
 * OV_BAD_SRC — an override buffer that fails to PARSE (an unterminated function body), so its
 * file's own diagnostic is exercised without touching disk.
 */
const OV_BAD_SRC: str = "pub fn broken( {"

/**
 * one_file — a one-element `[]SourceFile` naming `path` in namespace `ns`.
 *
 * @param path  the file's path
 * @param ns    the file's namespace
 * @return      the one-element file set
 */
fn one_file(path: str, ns: str): []SourceFile {
    teko::list::push(teko::list::empty(), SourceFile { path = path; namespace = ns })
}

/**
 * two_files — a two-element `[]SourceFile` naming `path_a` and `path_b`, both in namespace `ns`.
 *
 * @param path_a  the first file's path
 * @param path_b  the second file's path
 * @param ns      the shared namespace
 * @return        the two-element file set
 */
fn two_files(path_a: str, path_b: str, ns: str): []SourceFile {
    var one = teko::list::push(teko::list::empty(), SourceFile { path = path_a; namespace = ns })
    teko::list::push(one, SourceFile { path = path_b; namespace = ns })
}

/**
 * one_override — a one-element `[]FileOverride` substituting `content` for `path`.
 *
 * @param path     the file path the override replaces
 * @param content  the buffer's text
 * @return         the one-element override set
 */
fn one_override(path: str, content: str): []FileOverride {
    teko::list::push(teko::list::empty(), FileOverride { path = path; content = content })
}

/**
 * two_overrides — a two-element `[]FileOverride` pairing `(path_a, content_a)` and
 * `(path_b, content_b)`.
 *
 * @param path_a     the first file's path
 * @param content_a  the first file's override text
 * @param path_b     the second file's path
 * @param content_b  the second file's override text
 * @return           the two-element override set
 */
fn two_overrides(path_a: str, content_a: str, path_b: str, content_b: str): []FileOverride {
    var one = teko::list::push(teko::list::empty(), FileOverride { path = path_a; content = content_a })
    teko::list::push(one, FileOverride { path = path_b; content = content_b })
}

#test
/**
 * assemble_with_overrides_merges_every_overridden_file_without_touching_disk — two files, BOTH
 * fully overridden (neither path exists on disk), merge into ONE program carrying both files'
 * items, with no diagnostics — proving the override buffer is what actually got lexed/parsed.
 */
fn assemble_with_overrides_merges_every_overridden_file_without_touching_disk() {
    var files = two_files(OV_A_PATH, OV_B_PATH, "virtual")
    var overrides = two_overrides(OV_A_PATH, OV_A_SRC, OV_B_PATH, OV_B_SRC)
    var out = match assemble_with_overrides(files, overrides) {
        Assembled as a => a
        error => { teko::assert::is_true(false); return }
    }
    teko::assert::eq_u64(out.diags.len, 0)
    teko::assert::eq_u64(out.program.items.len, 2)
}

#test
/**
 * assemble_with_overrides_isolates_a_per_file_parse_error — one good override plus one file whose
 * override fails to parse: the walk does NOT stop at the bad file (FILE-boundary isolation,
 * `Assembled`'s own doc) — the good file's item is still merged, and the bad file contributes
 * exactly one diagnostic naming its own path.
 */
fn assemble_with_overrides_isolates_a_per_file_parse_error() {
    var files = two_files(OV_A_PATH, OV_B_PATH, "virtual")
    var overrides = two_overrides(OV_A_PATH, OV_A_SRC, OV_B_PATH, OV_BAD_SRC)
    var out = match assemble_with_overrides(files, overrides) {
        Assembled as a => a
        error => { teko::assert::is_true(false); return }
    }
    teko::assert::eq_u64(out.diags.len, 1)
    teko::assert::str_contains(out.diags[0], OV_B_PATH)
    teko::assert::eq_u64(out.program.items.len, 1)
}

#test
/**
 * assemble_with_overrides_skips_tkt_files_even_when_overridden — a `.tkt` file is excluded from
 * assembly (matching `assemble`'s own production-build selection) EVEN when an override names it:
 * the exclusion is checked before the override lookup, so a stray test-file override never leaks
 * into the merged program.
 */
fn assemble_with_overrides_skips_tkt_files_even_when_overridden() {
    var files = one_file("virtual/skip_test.tkt", "virtual")
    var overrides = one_override("virtual/skip_test.tkt", "#test\nfn t() { }")
    var out = match assemble_with_overrides(files, overrides) {
        Assembled as a => a
        error => { teko::assert::is_true(false); return }
    }
    teko::assert::eq_u64(out.diags.len, 0)
    teko::assert::eq_u64(out.program.items.len, 0)
}
