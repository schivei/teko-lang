use teko::parser
use teko::checker

/**
 * dirname_of splits a POSIX path at the last '/' and returns "." for a separator-less name —
 * byte-identical to the '/'-only original.
 */
#test
fn pt_dirname_posix_is_byte_identical() {
    teko::assert::is_true(dirname_of("/a/b/c") == "/a/b")
    teko::assert::is_true(dirname_of("file") == ".")
}

/**
 * basename_of splits a POSIX or Windows path at the last separator and returns the whole path for
 * a separator-less name — the mirror of `dirname_of` (0.3.1 C0).
 */
#test
fn pt_basename_of_mirrors_dirname() {
    teko::assert::is_true(basename_of("/a/b/c") == "c")
    teko::assert::is_true(basename_of("file") == "file")
    teko::assert::is_true(basename_of("examples/regressions/cwd_build/cwd_build.tkr") == "cwd_build.tkr")
    teko::assert::is_true(basename_of("D:\\a\\b\\c.tkr") == "c.tkr")
}

/**
 * target_matches — does `target_from_name(name)` resolve to `want`? `false` when
 * `name` is unrecognized (the R2 honest error, owner ruling 2026-07-24) — the
 * shared assertion body every `target_from_name` golden below reduces to.
 *
 * @param str name  the raw `TEKO_TARGET` value to map
 * @param NativeTarget want  the expected mapped target
 * @return bool  `true` iff `target_from_name(name)` resolves to `want`
 */
fn target_matches(name: str, want: NativeTarget) -> bool {
    match target_from_name(name) { NativeTarget as t => t == want; error => false }
}

#test
/**
 * target_from_name_still_maps_the_pre_existing_targets — a non-regression
 * check on the ENUM extension (#389 C1-5 adds two arms to `NativeTarget`):
 * the pre-existing `x86_64-linux`/`x86_64-elf` mappings, and the canonical
 * `arm64-macos` name, still resolve exactly as before.
 *
 * @return void
 */
fn target_from_name_still_maps_the_pre_existing_targets() {
    teko::assert::is_true(target_matches("x86_64-linux", NativeTarget::X8664Linux))
    teko::assert::is_true(target_matches("x86_64-elf", NativeTarget::X8664Linux))
    teko::assert::is_true(target_matches("arm64-macos", NativeTarget::Arm64Macho))
}

#test
/**
 * target_from_name_rejects_unsupported_values — R2 (owner ruling 2026-07-24): an
 * unrecognized `TEKO_TARGET` value (a typo, or the empty string) is now an honest
 * COMPILE error naming the offending value and listing the supported set, never a
 * silent mis-lower to `Arm64Macho` (the pre-0.3.1 behavior `target_from_name_still_
 * maps_the_pre_existing_targets` used to also cover).
 *
 * @return void
 */
fn target_from_name_rejects_unsupported_values() {
    match target_from_name("bogus-target") {
        NativeTarget => teko::assert::is_true(false)
        error as e => {
            teko::assert::is_true(teko::str::contains(e.message, "bogus-target"))
            teko::assert::is_true(teko::str::contains(e.message, "x86_64-linux"))
        }
    }
    match target_from_name("") {
        NativeTarget => teko::assert::is_true(false)
        error as e => teko::assert::is_true(teko::str::contains(e.message, "supported targets"))
    }
}

/**
 * host_target_matches — does `host_target_for_os(os, arch)` resolve to `want`? `false` on the
 * honest R2 error, the shared assertion body every precise-pairing golden below reduces to
 * (mirrors `target_matches`'s own idiom for `target_from_name`).
 *
 * @param os    a `teko::os()` value
 * @param arch  a `teko::arch()` value
 * @param want  the expected mapped target
 * @return      `true` iff `host_target_for_os(os, arch)` resolves to `want`
 */
fn host_target_matches(os: str, arch: str, want: NativeTarget) -> bool {
    match host_target_for_os(os, arch) { NativeTarget as t => t == want; error => false }
}

/**
 * host_target_is_unsupported — does `host_target_for_os(os, arch)` honestly refuse the pair
 * (the R2 arm), naming both `os` and `arch` in its own message?
 *
 * @param os    a `teko::os()` value
 * @param arch  a `teko::arch()` value
 * @return      `true` iff the pair is refused, with `os`/`arch` both named in the message
 */
fn host_target_is_unsupported(os: str, arch: str) -> bool {
    match host_target_for_os(os, arch) {
        NativeTarget => false
        error as e => teko::str::contains(e.message, os) && teko::str::contains(e.message, arch)
    }
}

#test
/**
 * host_target_for_os_is_precise_for_every_supported_pair — Phase 2 of the two-phase host
 * default (owner ruling 2026-07-24, teko-target-crosslink-0.3.1.md §2.1, now that
 * `teko::arch()` is seed-recognized): `host_target_for_os` picks the ONE own-backend target
 * this backend has a real codegen pipeline for, keyed on BOTH `os` AND `arch` — simulating
 * every supported host without depending on which one this test actually runs on.
 *
 * `linux`+`arm64` is the FOURTH row, and it is the one that makes `linux` the first OS with
 * two arches: refusing it (which this resolver honestly did, because `Arm64Linux` did not
 * exist) is what left the arm64-Linux test leg green over rows it never ran.
 *
 * @return void
 */
fn host_target_for_os_is_precise_for_every_supported_pair() {
    teko::assert::is_true(host_target_matches("linux", "x86_64", NativeTarget::X8664Linux))
    teko::assert::is_true(host_target_matches("windows", "x86_64", NativeTarget::X8664Windows))
    teko::assert::is_true(host_target_matches("macos", "arm64", NativeTarget::Arm64Macho))
    teko::assert::is_true(host_target_matches("linux", "arm64", NativeTarget::Arm64Linux))
}

#test
/**
 * host_target_for_os_rejects_every_unsupported_pair — the R2 counterpart: teaching
 * `host_target_for_os` the architecture means an `(os, arch)` pair with no own-backend target
 * (an x86_64 macOS host, an arm64 windows host, or a wholly `unknown`
 * arch) is now an honest COMPILE-time refusal naming BOTH the offending `os` and `arch` — never
 * the pre-0.3.1-teko-arch silent mis-lower to the OS's dominant arch regardless of the host's
 * REAL arch (the exact bug class R1 exists to close, one dimension over from the original
 * linux-host-emits-arm64-Mach-O report).
 *
 * @return void
 */
fn host_target_for_os_rejects_every_unsupported_pair() {
    teko::assert::is_true(host_target_is_unsupported("macos", "x86_64"))
    teko::assert::is_true(host_target_is_unsupported("windows", "arm64"))
    teko::assert::is_true(host_target_is_unsupported("linux", "unknown"))
    teko::assert::is_true(host_target_is_unsupported("unknown", "unknown"))
}

#test
/**
 * host_target_for_os_guess_maps_every_known_os — the Phase-1 OS-only heuristic
 * (teko-target-crosslink-0.3.1.md §2.1), kept as `host_target_for_os_guess`: `linux` and
 * `windows` pick their own-backend x86-64 pipeline, while `macos` and any other (`unknown`)
 * value keep the pre-existing `Arm64Macho` default. Still the ALWAYS-TOTAL fallback
 * `host_default_target_guess`/`resolved_target`/`cross_note` fall back to on a host whose
 * precise (os, arch) pair has no own-backend target.
 *
 * @return void
 */
fn host_target_for_os_guess_maps_every_known_os() {
    teko::assert::is_true(host_target_for_os_guess("linux") == NativeTarget::X8664Linux)
    teko::assert::is_true(host_target_for_os_guess("windows") == NativeTarget::X8664Windows)
    teko::assert::is_true(host_target_for_os_guess("macos") == NativeTarget::Arm64Macho)
    teko::assert::is_true(host_target_for_os_guess("unknown") == NativeTarget::Arm64Macho)
}

#test
/**
 * host_default_target_matches_the_real_host — the LIVE seam: `host_default_target()` (real
 * `teko::os()`/`teko::arch()`) never disagrees with `host_target_for_os` applied to that same
 * (os, arch) pair, in EITHER arm. A host whose own pair has no own-backend target (an aarch64
 * linux host, an x86_64 macOS host, an arm64 windows host, …) is a LEGITIMATE live outcome, not a
 * test failure — the R2 error `host_default_target()` returns there must be the SAME honest
 * refusal `host_target_for_os` itself gives that exact pair, never a silent divergence between
 * the two.
 *
 * THE BUG THIS REPLACES (measured live on CI's `test / linux-arm64-glibc`, job 90725227419, run
 * 30495738831): the previous body asserted `false` on the error arm, on the unstated assumption
 * that every host this suite runs on is one of the three supported pairs. On an aarch64 linux
 * runner `host_target_for_os("linux", "arm64")` correctly refuses — that refusal IS this crumb's
 * own R1/R2 design, not a defect — so the assertion fired and, because a failed
 * `teko::assert::is_true` has no soft-fail path yet (SIGABRT, `cargo/0.3.1-envelope-e-assert`
 * owns that separately), it aborted the WHOLE test binary, not just this one case. Asserting the
 * EQUIVALENCE instead of a fixed arm is what makes this test host-agnostic: green on every host,
 * supported or not, without ever discovering which one it is running on.
 *
 * @return void
 */
fn host_default_target_matches_the_real_host() {
    match host_default_target() {
        NativeTarget as live => teko::assert::is_true(host_target_matches(teko::os(), teko::arch(), live))
        error => teko::assert::is_true(host_target_is_unsupported(teko::os(), teko::arch()))
    }
}

#test
/**
 * host_default_target_guess_falls_back_when_the_precise_pair_is_unsupported —
 * `host_default_target_guess` is ALWAYS total, and it PREFERS the precise resolver: on any host
 * whose (os, arch) pair has an own-backend target it answers exactly that target, and only on an
 * unsupported pair does it fall through to the OS-only Phase-1 guess. The assertion is on the
 * equivalence, in both arms, so it never assumes which host it is running on.
 *
 * WHY THIS CANNOT BE PINNED AGAINST `host_target_for_os_guess` ALONE ANYMORE: the previous body
 * asserted `host_default_target_guess() == host_target_for_os_guess(teko::os())` unconditionally,
 * on the stated assumption that "each of the three supported pairs IS its own OS's dominant arch,
 * by construction". `Arm64Linux` breaks that assumption — `linux` is now the first OS with TWO
 * supported arches — so on an arm64 Linux host the precise resolver answers `Arm64Linux` while
 * the OS-only guess still answers `X8664Linux`, and the two legitimately differ. Asserting the
 * PREFERENCE instead of the equality keeps the property that actually matters: this function
 * never crashes and never contradicts the precise resolver.
 *
 * @return void
 */
fn host_default_target_guess_falls_back_when_the_precise_pair_is_unsupported() {
    match host_default_target() {
        NativeTarget as precise => teko::assert::is_true(host_default_target_guess() == precise)
        error => teko::assert::is_true(host_default_target_guess() == host_target_for_os_guess(teko::os()))
    }
}

/**
 * args_of — build a `[]str` CLI argument vector from up to three tokens, dropping any that is "" so
 * a test can pass fewer than three. The shared fixture for the optimization-flag parse tests below.
 *
 * @param a  the first token (dropped when "")
 * @param b  the second token (dropped when "")
 * @param c  the third token (dropped when "")
 * @return   the assembled argument vector
 */
fn args_of(a: str, b: str, c: str) -> []str {
    mut v: []str = teko::list::empty()
    if a != "" { v = teko::list::push(v, a) }
    if b != "" { v = teko::list::push(v, b) }
    if c != "" { v = teko::list::push(v, c) }
    v
}

#test
/**
 * opt_cc_flag_maps_levels_to_flags — level 0 emits NO flag (""), level 1 `-O1`, level 2 `-O2`, and
 * an out-of-range level clamps to `-O2` — the exact strings `build_cc_argv` appends to the cc line.
 *
 * @return void
 */
fn opt_cc_flag_maps_levels_to_flags() {
    teko::assert::is_true(opt_cc_flag(0) == "")
    teko::assert::is_true(opt_cc_flag(1) == "-O1")
    teko::assert::is_true(opt_cc_flag(2) == "-O2")
    teko::assert::is_true(opt_cc_flag(3) == "-O2")
}

#test
/**
 * project_arg_of_skips_optimization_flags — `--release` and `--opt=<n>` are recognized build flags,
 * so `project_arg_of` steps over them and still finds the project positional after them.
 *
 * @return void
 */
fn project_arg_of_skips_optimization_flags() {
    teko::assert::is_true(project_arg_of(args_of("--release", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of("--opt=2", ".", ""), 0) == ".")
    teko::assert::is_true(project_arg_of(args_of(".", "--release", ""), 0) == ".")
}

#test
/**
 * is_backend_flag_detects_both_retired_spellings — the retired `--backend` flag
 * (owner ruling 2026-07-24) is recognized in both its two-token (`--backend native`)
 * and single-token (`--backend=native`/`--backend=c`) spellings, so `has_backend_flag`
 * can reject the whole line honestly; an ordinary positional or an unrelated flag is
 * NOT mistaken for it.
 *
 * @return void
 */
fn is_backend_flag_detects_both_retired_spellings() {
    teko::assert::is_true(is_backend_flag("--backend"))
    teko::assert::is_true(is_backend_flag("--backend=native"))
    teko::assert::is_true(is_backend_flag("--backend=c"))
    teko::assert::is_true(!is_backend_flag("proj"))
    teko::assert::is_true(!is_backend_flag("--release"))
}

#test
