    pub type Buf = struct {
        len: u64
        fn empty() -> Buf { Buf { len = 0 } }
    }

    fn source() -> Buf | error {
        error { message = "boom" }
    }

    pub fn make(limit: u64) -> (u64) -> Buf | error {
        let f: (u64) -> Buf | error = (max: u64) => {

            let picked = match source() {
                Buf as b => b
                error as e => {
                    if max == limit { return e }
                    Buf::empty()
                }
            }
            picked
        }
        f
    }

    pub fn run_through(f: (u64) -> Buf | error, arg: u64) -> Buf | error {
        f(arg)
    }

    pub fn trailing_marker() -> u64 {
        777
    }

        let g = make(5)

        let direct_err = match g(5) {
            Buf as _ => 0 to u64
            error as _ => 10 to u64
        }

        let direct_ok = match g(1) {
            Buf as b => 1 to u64
            error as _ => 0 to u64
        }

        let combinator_err = match run_through(g, 5) {
            Buf as _ => 0 to u64
            error as _ => 10 to u64
        }

        let marker = trailing_marker()

    (direct_err + direct_ok + combinator_err + (if marker == 777 to u64 { 9 to u64 } else { 0 to u64 })) to i32
    """
