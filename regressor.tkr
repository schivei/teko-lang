    type Counter = class {
        intern n: i64
        pub fn make() -> Counter { Counter { n = 0 } }
        pub fn bump(self) { self.n = self.n + 1 }
        pub fn set(self, v: i64) { self.n = v }
        pub fn get(self) -> i64 { self.n }
    }

    type Box = class {
        pub val: i64
        pub fn make() -> Box { Box { val = 1 } }
    }

    type Point = struct { x: i64; y: i64 }

    type Inner = struct { z: i64 }
    type Outer = struct { inner: Inner; w: i64 }

    fn bump_local_copy(p: Point) -> i64 {
        mut local = p
        local.x = 999
        local.x
    }

    type Acc = class {
        intern total: i64
        pub fn make() -> Acc { Acc { total = 0 } }
        pub fn run(self) {
            defer { self.total = self.total + 1000 }
            mut i = 0
            loop {
                if i >= 3 { break }
                self.total = self.total + i
                i++
            }
        }
        pub fn get(self) -> i64 { self.total }
    }

    let a = Counter::make()
    let b = a
    a.bump()
    a.bump()
