  Scenario: unsafe_rawbuf_roundtrip
    Given source inline = """
    /**
     * A LOCAL COPY of the U3 (`teko::mem::unsafe`, issue #334) `RawBuf` shape, WITH the `unsafe`
     * modifier (this fixture is compiled by gen1/native, never the released seed, so U1's `unsafe`
     * grammar is available here — unlike the stdlib module itself, which stages the modifier off
     * until a seed refresh; see `src/mem/unsafe/rawbuf.tks`'s header). Mirrors the established
     * cross-project convention (`crypto_hash_kat`'s verbatim `crypto.tks` copy): a regression
     * fixture is its own standalone project, so it self-contains the shapes it exercises.
     *
     * An `unsafe type` pairing a raw address with its length in bytes — lowers to exactly
     * `typedef struct tk_t_RawBuf { uint8_t *ptr; uint64_t len; } tk_t_RawBuf;` (AC#2), since
     * codegen's `emit_type_decl` keys off the body shape, never the `unsafe` flag (AC#5).
     */
    pub unsafe type RawBuf = struct {
        /** The buffer's raw base address, as returned by `teko::mem::buf_ptr`. */
        ptr: ptr<byte>

        /** The buffer's length in bytes. */
        len: u64
    }

    /**
     * Bump-allocates a fresh `len`-byte arena region and wraps its raw address in a `RawBuf`.
     * `unsafe fn` because its return type names the `unsafe type RawBuf` (U2's fn-signature
     * containment gate) — a `pub fn` here would be rejected.
     *
     * @param len the buffer's length in bytes
     * @return    a `RawBuf` describing the freshly allocated region
     */
    pub unsafe fn rawbuf_alloc(len: u64) -> RawBuf {
        RawBuf { ptr = teko::mem::buf_ptr(len); len = len }
    }

    /**
     * Reads `buf`'s bytes back into a safe `[]byte` copy — the one boundary crossing a `RawBuf` may
     * perform (the remodel's §2 boundary rule: only a by-value safe copy, or an `Owned<T>`, may
     * leave an `unsafe fn`). `unsafe fn` because its parameter names the `unsafe type RawBuf`.
     *
     * @param buf the buffer to read
     * @return    a freshly copied `[]byte` holding `buf.len` bytes read from `buf.ptr`
     */
    pub unsafe fn rawbuf_read(buf: RawBuf) -> []byte {
        teko::mem::bytes_from_ptr(buf.ptr, buf.len)
    }

    /**
     * Raw libc `memset` — NOT `from "teko_rt"` (no Teko-owned wrapper), mirroring
     * `buf_ptr_memset_roundtrip`'s `fill_bytes`. Binds directly to the C runtime symbol linked
     * into every generated binary. Fills `n` bytes at `dst` with `val` and returns `dst`.
     */
    pub extern fn fill_bytes(dst: ptr<byte>, val: i32, n: u64) -> ptr<byte> = "memset"

    /**
     * Allocates an 8-byte `RawBuf` (AC#1), fills it with the byte value 5 through the raw `memset`
     * extern reaching directly into its raw `ptr<byte>` field, then reads the written bytes back
     * as a safe `[]byte` (`rawbuf_read`, the boundary crossing) and sums them. Deterministic:
     * 8 bytes * 5 = 40. `unsafe fn` because it binds a local of the `unsafe type RawBuf`.
     *
     * @return the sum of the 8 filled bytes (40)
     */
    pub unsafe fn filled_sum() -> i32 {
        let buf = rawbuf_alloc(8)
        fill_bytes(buf.ptr, 5, buf.len)
        let written = rawbuf_read(buf)
        mut total: i32 = 0
        mut i: u64 = 0
        loop {
            if i >= written.len { break }
            total = total + (written[i] to i32)
            i++
        }
        total
    }

    filled_sum()
    """
    When built and run
    Then exit = 40

  Scenario: unsafe_type_modifier
    Given source inline = """
    /**
     * A `pub unsafe fn` — proves an exported namespace function accepts the `unsafe` modifier
     * (acceptance criterion 3). Its param names the `unsafe type RawBuf` (U2's fn-signature
     * containment gate), which is exactly why it must be `unsafe fn` — a `pub fn` here would be
     * rejected.
     *
     * @param buf the buffer whose length is read
     * @return    the buffer's length
     */
    pub unsafe fn rawbuf_len(buf: RawBuf) -> i64 {
        buf.len
    }

    /**
     * A SAFE-signature (`i64 -> i64`) entry point so a SAFE caller (this fixture's top-level
     * script) can exercise `RawBuf`/`rawbuf_len` without itself ever binding an unsafe-typed
     * local (U2's local-containment gate would reject that outside an `unsafe fn`) — calls
     * are UNCOLORED, so this safe-signature `unsafe fn` may still be called from safe code.
     *
     * @param len the buffer length to round-trip through `RawBuf`
     * @return    the same length, having passed through `RawBuf` internally
     */
    pub unsafe fn rawbuf_len_of(len: i64) -> i64 {
        rawbuf_len(make_rawbuf(len))
    }

    /**
     * A bare `unsafe fn` (no `pub`) — proves the modifier also parses without a leading
     * visibility keyword (acceptance criterion 3).
     *
     * @return a fixed sentinel value
     */
    unsafe fn sentinel() -> i64 {
        42
    }

    /**
     * A normal (non-`unsafe`) `type` — the no-regression control (acceptance criterion 4): parses
     * and runs identically to before U1, with `is_unsafe = false`.
     */
    pub type Plain = struct {
        /** A single field, present only to give the struct shape. */
        tag: i64
    }

    /**
     * A normal (non-`unsafe`) namespace function — the no-regression control's fn half.
     *
     * @param p the plain value to read
     * @return  the value's tag
     */
    pub fn plain_tag(p: Plain) -> i64 {
        p.tag
    }

    /**
     * An `unsafe type` struct — the shape the U1 surface targets (0.1.0.0-beta memory+unsafe
     * remodel §2/§3). U2 (#333) now ENFORCES containment: `RawBuf` may only be named by another
     * `unsafe type` or an `unsafe fn` (see `make_rawbuf` below, which is `unsafe fn` for exactly
     * this reason — a `pub fn` naming `RawBuf` in its signature would be rejected).
     */
    pub unsafe type RawBuf = struct {
        /** The buffer's length in bytes. */
        len: i64
    }

    /**
     * An `unsafe type class` — the class-body counterpart of `RawBuf`, proving `unsafe` parses on
     * both struct-shaped and class-shaped bodies (acceptance criteria 1/2).
     */
    pub unsafe type Handle = class {
        /** The wrapped raw address, carried as a plain integer (U1 lands only the flag, not a
         *  real raw-memory type — that is U3's job). */
        pub addr: i64

        /**
         * Builds a `Handle` around the given address.
         *
         * @param addr the address to wrap
         * @return     the constructed handle
         */
        pub fn make(addr: i64) -> Handle {
            Handle { addr = addr }
        }
    }

    /**
     * A SAFE-signature (`i64 -> i64`) entry point so a SAFE caller (this fixture's top-level
     * script) can exercise `Handle::make`/`.addr` without itself ever binding an unsafe-typed
     * local (U2's local-containment gate would reject that outside an `unsafe fn`).
     *
     * @param addr the address to round-trip through `Handle`
     * @return     the same address, having passed through `Handle` internally
     */
    pub unsafe fn handle_addr_of(addr: i64) -> i64 {
        Handle::make(addr).addr
    }

    /**
     * Builds a `RawBuf` describing a buffer of the given length. `unsafe fn` because its return
     * type names the `unsafe type RawBuf` (U2's fn-signature containment gate) — a `pub fn` here
     * would be rejected.
     *
     * @param len the buffer's length in bytes
     * @return    the constructed `RawBuf`
     */
    pub unsafe fn make_rawbuf(len: i64) -> RawBuf {
        RawBuf { len = len }
    }

    if rawbuf_len_of(7) != 7 { exit(1) }

    if handle_addr_of(9) != 9 { exit(2) }

    if sentinel() != 42 { exit(3) }

    let p = Plain { tag = 5 }
    if plain_tag(p) != 5 { exit(4) }

    exit(42)
    """
    When built and run
    Then exit = 42

