  Scenario: iface_value_stateful_class
    Given source inline = """
    /**
     * Counter — a stateful contract. Dispatched through as an interface VALUE, the concrete class
     * carries the mutable state across calls (the class arena-mutation rule).
     */
    type Counter = interface {
        /**
         * bump — advance the counter one step.
         */
        fn bump(self)

        /**
         * get — the current count.
         *
         * @return  the running count
         */
        fn get(self) -> i64
    }

    /**
     * Cnt — a class conforming to `Counter`, whose `bump` mutates its own field.
     */
    type Cnt = class & Counter {
        /** The running count. */
        pub n: i64

        /**
         * make — a fresh counter positioned at zero.
         *
         * @return  the constructed counter
         */
        pub fn make() -> Cnt { Cnt { n = 0 } }

        /**
         * bump — the `Counter` contract: increment the stored count.
         */
        pub fn bump(self) { self.n = self.n + 1 }

        /**
         * get — the `Counter` contract: read the stored count.
         *
         * @return  the running count
         */
        pub fn get(self) -> i64 { self.n }
    }

    /**
     * drive — advance a dynamic `Counter` VALUE three times, then read it. State persists across the
     * dispatched calls because the interface value wraps a live class object.
     *
     * @param c  the counter, taken as a dynamic interface value
     * @return   the count after three increments
     */
    pub fn drive(c: Counter) -> i64 {
        c.bump()
        c.bump()
        c.bump()
        c.get()
    }

    /**
     * scenario — build a fresh counter and drive it three times through the interface value.
     *
     * @return  the count after three increments (3)
     */
    pub fn scenario() -> i64 { drive(Cnt::make()) }

    exit(scenario())
    """
    When built and run
    Then exit = 3

  Scenario: inline_attr_parse
    Given source inline = """
    /**
     * Pair — a large by-value struct (two `i64` words = 16 bytes) with NO spare NULL niche, standing in
     * for the removed scalar `u128` (drop-128, 2026-07-24) as the `#inline` attribute's test vehicle: any
     * ≥16-byte no-niche type exercises the same boxed-by-default union slot the parse sites attach to.
     */
    type Pair = struct {
        /** The first word of the pair. */
        x: i64
        /** The second word of the pair. */
        y: i64
    }

    /**
     * A holder whose union field carries the `#inline` layout attribute at the struct-FIELD parse site
     * (C4's new field parse position). The attribute parses and the field builds; its boxed-vs-inline
     * layout flip is a flagged C4 remainder, so the slot still round-trips as the boxed default here.
     */
    type Holder = struct {
        /** A `#inline`-annotated large-union field — exercises the field parse site. */
        #inline slot: Pair | null
    }

    /**
     * Exercise the `#inline` attribute at BOTH new parse sites — a local binding (`#inline mut …`) and a
     * struct field (`#inline slot: …`) — and round-trip the union values so a parse regression that drops
     * or mis-binds the attribute changes the exit code.
     *
     * @return  present local payload (42) + absent field sentinel (5) = 47
     */
    pub fn probe_inline_parse() -> i32 {
        #inline mut hot: Pair | null = Pair { x = 42; y = 0 }
        mut a: i32 = 0
        match hot {
            null => a = 100
            Pair as v => a = v.x to i32
        }
        let h: Holder = Holder { slot = null }
        mut b: i32 = 0
        match h.slot {
            null => b = 5
            Pair as v => b = (v.x to i32) + 100
        }
        a + b
    }

    exit(probe_inline_parse())
    """
    When built and run
    Then exit = 47

