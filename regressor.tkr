  Scenario: member_const_interface_rejected
    Given source inline = """
    /**
     * Contract — an interface that ILLEGALLY declares a `const` member. The parser rejects this: an
     * interface carries no statics, so a member const is only allowed in a struct/class/trait body.
     */
    type Contract = interface {
        /**
         * run — an ordinary interface method signature (legal).
         *
         * @return an i64
         */
        fn run(self) -> i64
        /** BAD — a `const` member in an interface body: a located parse error (#594 crumb 7). */
        const BAD: i64 = 1
    }

    exit(0)
    """
    When compilation fails
    Then diagnostic = "a `const` member is only allowed in a struct, class, or trait body"

  Scenario: member_const_override_rejected
    Given source inline = """
    /**
     * Widget — a struct that ILLEGALLY marks a member `const` with `override`. The parser rejects this:
     * `override` is method-only; a member const is statically hidden, never overridden (#594 crumb 7).
     *
     * @field id  the widget's identifier
     */
    type Widget = struct {
        /** the widget's identifier */
        id: i64
        /** BAD — a member const bearing `override`: a located parse error. */
        override const BAD: i64 = 1
    }

    exit(0)
    """
    When compilation fails
    Then diagnostic = "may not carry `override`"

