  Scenario: defer_cross_block_return
    Given source inline = """
    /**
     * Regression for issue #161's boundary principle: a `return` that crosses N nested block
     * regions (loop-body -> if-arm -> if-arm) must fire every enclosing `defer` LIFO (innermost
     * first, outermost last) BEFORE the region each defer belongs to is dropped, and the carried
     * return value must be evaluated AFTER all of those defers have run — never a stale snapshot
     * taken at the `return` statement itself.
     *
     * @return the accumulator built entirely by the three defers, proving both the LIFO firing
     *         order and the after-defers evaluation of the returned value:
     *         start at 1 -> innermost defer doubles it (2) -> middle defer adds 3 (5) ->
     *         outermost defer adds 100 (105). A stale-snapshot bug (returning 1) or a
     *         wrong-order bug (any total other than 105) both fail this fixture.
     */
    pub fn cross_block_return() -> i64 {
        mut acc: i64 = 1
        loop {
            defer { acc = acc + 100 }
            if true {
                defer { acc = acc + 3 }
                if true {
                    defer { acc = acc * 2 }
                    return acc
                }
            }
        }
    }

    (cross_block_return()) to i32
    """
    When built and run
    Then exit = 105

  Scenario: di_lazy
    Given source inline = """
    /** A service whose construction is a hard error — the fixture proves DI is LAZY by never taking the
     *  branch that uses it, so the factory (which would `exit(9)`) never runs. */
    type Service = interface {
        fn ping(self) -> i64
    }

    /** A `#singleton` whose factory aborts (exit 9): if DI materialized eagerly, the program would exit
     *  9; because the injected name is only materialized on FIRST USE, an untaken branch never builds it. */
    #singleton
    type Bomb = class & Service {
        pub tag: i64

        pub fn make() -> Bomb { exit(9) }
        pub fn ping(self) -> i64 { self.tag }
    }

    /** `flag` is false at the call site, so `svc` is never read → its materializer is never emitted →
     *  the exit-9 factory never fires and control falls through to 0. */
    #inject(svc: Service)
    fn run_if(flag: bool) -> i64 {
        if flag { svc.ping() } else { 0 }
    }

    if run_if(false) != 0 { exit(1) }
    """
    When built and run
    Then exit = 0

  Scenario: di_recursive
    Given source inline = """
    /** A leaf dependency provided as a `#singleton`. */
    type Base = interface {
        fn value(self) -> i64
    }

    /** The leaf `#singleton`: `value()` returns 7. */
    #singleton
    type Leaf = class & Base {
        pub v: i64

        pub fn make() -> Leaf { Leaf { v = 7 } }
        pub fn value(self) -> i64 { self.v }
    }

    /** A composite dependency provided as a `#singleton`, built through a factory that recursively
     *  materializes its own dependency (`Base`) — constructor injection threaded through the region. */
    type Composite = interface {
        fn total(self) -> i64
    }

    /** The composite `#singleton`: its factory reads the recursively-injected leaf value (via
     *  `injected_base_value`, whose `#inject(base: Base)` materializes the leaf) and carries it. */
    #singleton
    type Sum = class & Composite {
        pub carried: i64

        pub fn make() -> Sum { Sum { carried = injected_base_value() } }
        pub fn total(self) -> i64 { self.carried + 1 }
    }

    /** The recursive materialization step: injecting `Base` here builds the leaf singleton, and its
     *  value flows up into `Sum`'s factory. */
    #inject(base: Base)
    fn injected_base_value() -> i64 {
        base.value()
    }

    /** Inject the composite; `total()` = carried (7, from the recursively-built leaf) + 1 = 8. */
    #inject(c: Composite)
    fn composed_total() -> i64 {
        c.total()
    }

    if composed_total() != 8 { exit(1) }
    """
    When built and run
    Then exit = 0

