    type Account = class {
        pub owner: str
        pub balance: i64

        pub fn open(owner: str, balance: i64 = 0) -> Account | error {
            if balance < 0 { return error { message = "negative initial balance" } }
            Account { owner = owner; balance = balance }
        }

        pub fn describe(self) -> str {
            self.owner
        }
    }

    type Transfer = class {
        pub source: Account
        pub target: Account

        pub fn between(a: str, b: str, amount: i64) -> Transfer | error {
            let src = match Account::open(a, balance = amount) { Account as acc => acc; error as e => return e }
            let dst = match Account::open(b) { Account as acc => acc; error as e => return e }
            Transfer { source = src; target = dst }
        }
    }

    match Account::open("Ana", balance = 100) {
        Account as acct => {
            if acct.describe() != "Ana" { exit(1) }
            if acct.balance != 100 { exit(2) }
        }
        error => exit(3)
    }

    match Account::open("Bob") {
        Account as acct => { if acct.balance != 0 { exit(4) } }
        error => exit(5)
    }

    match Account::open("Eve", balance = 0 - 1) {
        Account => exit(6)
        error as e => { if e.message != "negative initial balance" { exit(7) } }
    }

    match Transfer::between("Ana", "Bob", 50) {
        Transfer as t => {
            if t.source.describe() != "Ana" { exit(8) }
            if t.target.balance != 0 { exit(9) }
        }
        error => exit(10)
    }
    match Transfer::between("Ana", "Bob", 0 - 50) {
        Transfer => exit(11)
        error as e => { if e.message != "negative initial balance" { exit(12) } }
    }

    exit(0)
    """
