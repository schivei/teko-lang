        let archive_text = match read_file(archive_path) { str as s => s; error => return 3 }
        let payload = match unstore(Buf::from_str(archive_text)) { Buf as b => b; error => return 4 }
        match write_file_bytes(out_path, payload.bytes()) {
            error => return 5
            null => { }
        }
        let original = match read_file(source_path) { str as s => s; error => return 6 }
        let recovered = match read_file(out_path) { str as s => s; error => return 7 }
        if original != recovered { return 8 }
        0
    }

    let source_path = "teko_io_file_copy_source_184.txt"
    let archive_path = "teko_io_file_copy_archive_184.tkl"
    let out_path = "teko_io_file_copy_out_184.txt"

    let seed = match write_file_bytes(source_path, bytes_of_str("the quick brown fox\njumps over\n")) {
        error => 20
        null => 0
    }
    if seed != 0 { exit(seed) }

    let result = run_copy_pipeline(source_path, archive_path, out_path)

    match remove_file(source_path) { error => { }; null => { } }
    match remove_file(archive_path) { error => { }; null => { } }
    match remove_file(out_path) { error => { }; null => { } }

    if result != 0 { exit(result) }
