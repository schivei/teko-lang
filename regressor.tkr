  Scenario: buf_ptr_memset_roundtrip
    Given source inline = """
    /**
     * Raw libc `memset` — NOT `from "teko_rt"` (no Teko-owned wrapper). Binds directly to the C
     * runtime symbol linked into every generated binary. Fills `n` bytes at `dst` with `val` and
     * returns `dst`. `ptr<byte>` matches libc's `void *memset(void *, int, size_t)` prototype byte-
     * for-byte (C treats `void *` and `uint8_t *` as ABI-compatible pointer widths).
     */
    pub extern fn fill_bytes(dst: ptr<byte>, val: i32, n: u64) -> ptr<byte> = "memset"

    /**
     * Bump-allocates an 8-byte arena region (C7.19 `Buf`), fills it with the byte value 7 through
     * the raw `memset` extern, then reads the written bytes back by length and sums them.
     * Deterministic: 8 bytes * 7 = 56.
     */
    pub fn filled_sum() -> i32 {
        let region = teko::mem::buf_ptr(8)
        fill_bytes(region, 7, 8)
        let written = teko::mem::bytes_from_ptr(region, 8)
        mut total: i32 = 0
        mut i: u64 = 0
        loop {
            if i >= written.len { break }
            total = total + (written[i] to i32)
            i++
        }
        total
    }

    filled_sum()
    """
    When built and run
    Then exit = 56

  Scenario: casting_native_roundtrip
    Given source inline = """
    /**
     * VERBATIM COPY of `u64_to_u32` and `u64_to_u8` from `src/casting/casting.tks`
     * (`teko::casting`, D5 refinement, C6, `cast-width-hygiene-0.3.1.md` §10), kept in sync by
     * hand — this regression fixture is its own standalone project (cross-project `[aliases]`
     * resolution is not implemented in the seed yet), so it self-contains the two converters it
     * exercises, mirroring `examples/regressions/crypto_hash_kat/src/crypto/hash.tks`'s
     * established convention. The `teko::math::` qualifier is shortened to bare `` here
     * (this fixture's project root is `casting_native_roundtrip`, not `teko`) — every function
     * body is otherwise unchanged. If `casting.tks` changes these two functions, this copy must
     * be updated too.
     *
     * @param reason  the human-readable cause of the out-of-range rejection
     * @return        an `error` whose `message` is `reason`
     */
    fn cast_error(reason: str) -> error { error { message = reason } }

    /**
     * Checked narrowing of a `u64` to `u32`; returns the value or an `error` (NO panic).
     *
     * @param v  the source value
     * @return   `v`, when `v <= u32::MAX`
     * @throws   error  when `v > u32::MAX`
     */
    pub fn u64_to_u32(v: u64) -> u32 | error {
        if v > U32_MAX { return cast_error("u64_to_u32: value does not fit u32") }
        v to u32
    }

    /**
     * Checked narrowing of a `u64` to `u8`; returns the value or an `error` (NO panic).
     *
     * @param v  the source value
     * @return   `v`, when `v <= u8::MAX`
     * @throws   error  when `v > u8::MAX`
     */
    pub fn u64_to_u8(v: u64) -> u8 | error {
        if v > U8_MAX { return cast_error("u64_to_u8: value does not fit u8") }
        v to u8
    }

    /**
     * VERBATIM COPY of the two constants from `src/math/checked.tks` (`teko::math`, M1, issue
     * #185) that the vendored `src/casting/casting.tks` below depends on, kept in sync by hand —
     * this regression fixture is its own standalone project (cross-project `[aliases]`
     * resolution is not implemented in the seed yet), so it self-contains what it exercises,
     * mirroring `examples/regressions/crypto_hash_kat/src/math/math.tks`'s established
     * convention. The `teko::math::` qualifier is shortened to bare `` here (this
     * fixture's project root is `casting_native_roundtrip`, not `teko`) — the values are
     * unchanged. If `checked.tks` changes these constants, this copy must be updated too.
     */

    /**
     * `u32::MAX` (2^32 - 1), constructed as `~0` (all bits set).
     */
    pub const U32_MAX: u32 = ~(0 to u32)

    /**
     * `u8::MAX` (2^8 - 1), constructed as `~0` (all bits set).
     */
    pub const U8_MAX: u8 = ~(0 to u8)

    mut total: i64 = 0

    match u64_to_u32(50 to u64) {
        u32 as v => if v == (50 to u32) { total = total + 50 } else { }
        error => { }
    }

    match u64_to_u32(4294967296 to u64) {
        u32 => { }
        error => total = total + 20
    }

    match u64_to_u8(7 to u64) {
        u8 as v => if v == (7 to u8) { total = total + 7 } else { }
        error => { }
    }

    exit(total)
    """
    When built and run
    Then exit = 77

