     * pick — returns its own `ref` parameter unchanged: the sound identity pass-down (`-> ref T`, R6/R7).
     * The returned reference aliases the caller's storage, which outlives the call.
     *
     * @param r  a by-reference integer
     * @return   the same reference (a `-> ref i64` return)
     */
    fn pick(ref r: i64) -> ref i64 { r }

    /**
     * compute — borrows a local, passes it through `pick`, writes 42 THROUGH the returned reference, and
     * reads the local back to prove the returned reference still aliased the caller's storage.
     *
     * @return the value written through the returned reference (42)
     */
    pub fn compute() -> i64 {
        mut x: i64 = 0
        ref r: i64 = pick(x)
        r = 42
        x
    }

    exit(compute())
    """
    When built and run
    Then exit = 42

  Scenario: ref_selfhost_ok
    Given source inline = """
    /**
     * bump — the `ref` keyword's transparent write-through: reading and writing `r` bare mutates the
     * caller's storage directly, no `.value` (0.3.1 — `Ref<T>` is compiler-internal and no longer
     * user-spellable; `ref` is the sole surface, replacing the pre-adoption `Ref<T>`/`.value`/`&x`
     * coexistence this fixture used to exercise).
     *
     * @param r  a by-reference integer
     * @return   void
     */
    fn bump(ref r: i64) { r = r + 1 }

    /**
     * compute — applies the `ref` write-through path 42 times on the same local, proving repeated
     * write-through targets the one shared storage cell.
     *
     * @return the accumulated value (0 + 42 = 42)
     */
    pub fn compute() -> i64 {
        mut x: i64 = 0
        mut i: i64 = 0
        loop {
            if i >= 42 { break }
            bump(x)
            i = i + 1
        }
        x
    }

    exit(compute())
    """
    When built and run
    Then exit = 42

