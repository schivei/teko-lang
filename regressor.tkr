  Scenario: struct_through_constraint
    Given source inline = """
    /**
     * A minimal measurement contract satisfied by value-type structs. Constraint-bound generic code
     * dispatches `x.measure()` through this contract; ruling (a) lowers such a struct dispatch to a
     * DIRECT call to the concrete stamped method rather than through a class-only vtable (#294).
     */
    type Measurable = interface {
        /**
         * Report this value's measure.
         *
         * @return the value's measure as a signed 64-bit integer
         */
        fn measure(self) -> i64
    }

    /**
     * A struct conforming to `Measurable` whose measure is its stored width verbatim — the first of
     * two concrete struct types proving per-type stamped dispatch (#294).
     */
    type Point = struct Measurable {
        /** The stored width. */
        w: i64

        /**
         * Report the stored width unchanged.
         *
         * @return the stored width
         */
        pub fn measure(self) -> i64 { self.w }
    }

    /**
     * A struct conforming to `Measurable` whose measure DOUBLES its stored width — the second concrete
     * struct type, proving each struct dispatches to its OWN stamped method, not a shared one (#294).
     */
    type Doubled = struct Measurable {
        /** The stored width. */
        w: i64

        /**
         * Report twice the stored width.
         *
         * @return the stored width doubled
         */
        pub fn measure(self) -> i64 { self.w + self.w }
    }

    /**
     * Sum a single measurable value via a constraint-bound generic — the constraint-dispatch site that
     * must lower to a DIRECT stamped-method call for a struct receiver (#294). Instantiated at two
     * distinct struct types, each dispatching to its own `Struct::measure`.
     *
     * @param x  a value whose concrete struct type satisfies `Measurable`
     * @return   `x.measure()` at the receiver's concrete struct type
     */
    fn total<T: Measurable>(x: T) -> i64 { return x.measure() }

    let p = Point { w = 5 }
    let d = Doubled { w = 9 }

    if total(p) != 5 { exit(1) }
    if total(d) != 18 { exit(2) }

    exit(total(p))
    """
    When built and run
    Then exit = 5

  Scenario: struct_vs_class_constraint
    Given source inline = """
    /**
     * A measurement contract satisfied by BOTH a value-type struct and a ref-type class in the same
     * program — the discriminator that proves the constraint-dispatch fix stays a NO-OP for classes:
     * the struct receiver lowers to a DIRECT stamped-method call, the class receiver keeps dispatching
     * through its vtable, both correct (#294 ruling (a)).
     */
    type Measurable = interface {
        /**
         * Report this value's measure.
         *
         * @return the value's measure as a signed 64-bit integer
         */
        fn measure(self) -> i64
    }

    /**
     * A STRUCT conforming to `Measurable` (value type, no vtable) — constraint dispatch on it must
     * resolve to the concrete stamped `StructValue::measure`, never a fat-pointer upcast (#294).
     */
    type StructValue = struct Measurable {
        /** The stored width. */
        w: i64

        /**
         * Report the stored width unchanged.
         *
         * @return the stored width
         */
        pub fn measure(self) -> i64 { self.w }
    }

    /**
     * A CLASS conforming to `Measurable` (ref type, has a vtable) — constraint dispatch on it keeps
     * routing through the vtable exactly as before the fix, proving the struct rewrite does not perturb
     * the class dispatch path (#294).
     */
    type ClassValue = class & Measurable {
        /** The stored width. */
        pub w: i64

        /**
         * Construct a `ClassValue` wrapping `x`.
         *
         * @param x  the width to store
         * @return   a fresh `ClassValue`
         */
        pub fn make(x: i64) -> ClassValue { ClassValue { w = x } }

        /**
         * Report ten more than the stored width, so a mismatched dispatch would surface loudly.
         *
         * @return the stored width plus ten
         */
        pub fn measure(self) -> i64 { self.w + 10 }
    }

    /**
     * Dispatch `measure()` through a `Measurable` constraint. Instantiated once at a STRUCT type
     * (direct stamped call) and once at a CLASS type (vtable dispatch) — both must return the correct
     * per-type measure (#294).
     *
     * @param x  a value whose concrete type satisfies `Measurable`
     * @return   `x.measure()` at the receiver's concrete type
     */
    fn total<T: Measurable>(x: T) -> i64 { return x.measure() }

    let s = StructValue { w = 3 }
    let c = ClassValue::make(4)

    if total(s) != 3 { exit(1) }
    if total(c) != 14 { exit(2) }

    exit(total(s) + total(c))
    """
    When built and run
    Then exit = 17

