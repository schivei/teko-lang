    /**
     * Sink — a pure interface contract whose absorb method takes three integers; a conforming type may
     * discard the ones it does not use with `_` discard parameters.
     */
    type Sink = interface {
        fn absorb(self, a: i64, b: i64, keep: i64) -> i64
    }

    /**
     * Bin — a struct conforming to Sink whose absorb IGNORES the first two arguments via two adjacent
     * `_` discard parameters, using only its own `tag` and the kept argument.
     */
    type Bin = struct Sink {
        tag: i64
        /**
         * absorb — return `tag + keep`, discarding the first two arguments (their types come by
         * position from Sink::absorb). Demonstrates two `_` discard parameters in a row.
         *
         * @param keep  the one argument this implementation keeps
         * @return      the sum of the bin's tag and the kept argument
         */
        fn absorb(self, _, _, keep: i64) -> i64 { self.tag + keep }
    }

    let b = Bin { tag = 3 }
    if b.absorb(10, 20, 4) != 7 { exit(1) }
    if b.absorb(100, 200, 5) != 8 { exit(2) }
    exit(0)
    """
    When built and run
    Then exit = 0

  Scenario: doc_comment_fields_and_test
    Given source inline = """
    /**
     * A 2D point (a struct), with a Javadoc directly above each field (issue #285).
     *
     * @param x  the x coordinate
     * @param y  the y coordinate
     */
    pub type Point = struct {
        /**
         * The x coordinate.
         */
        x: i64
        /**
         * The y coordinate.
         */
        y: i64
    }

    /**
     * A 2D vector (a class), with a Javadoc directly above each field (issue #285) — the same
     * placement `parse_class_fields` must accept alongside a struct's `parse_fields`.
     */
    pub type Vector = class {
        /**
         * The horizontal component.
         */
        pub dx: i64
        /**
         * The vertical component.
         */
        pub dy: i64

        /**
         * Build a Vector from its two components.
         *
         * @param dx  the horizontal component
         * @param dy  the vertical component
         * @return    the constructed Vector
         */
        pub fn make(dx: i64, dy: i64) -> Vector { Vector { dx = dx; dy = dy } }
    }

    /**
     * Sum the components of a Point and a Vector — exercises reading both the struct's and the
     * class's Javadoc-commented fields at runtime (parsing success alone would not).
     *
     * @param p  the point
     * @param v  the vector
     * @return   `p.x + p.y + v.dx + v.dy`
     */
    pub fn total(p: Point, v: Vector) -> i64 {
        p.x + p.y + v.dx + v.dy
    }

    let p = Point { x = 1; y = 2 }
    let v = Vector::make(3, 4)
    exit(total(p, v) - 10)
    """
    When built and run
    Then exit = 0

  Scenario: encodings_roundtrip
    Given source inline = """
    /**
     * `teko::encoding::base64` — RFC 4648 Base64 encode/decode, T1 of issue #189 (encodings T1:
     * TOML + CSV + URL/MIME). Pure Teko, no C twin (the `teko::regex` / `teko::encoding::json`
     * precedent: library code with zero OS/FFI dependency ships as `.tks` + `.tkt` only, and both
     * engines get it automatically — the VM tree-walks it, every self-hosted binary compiles it
     * natively).
     *
     * VERBATIM COPY of `src/encoding/base64/base64.tks`, kept in sync by hand — this regression
     * fixture is its own standalone project (cross-project `[aliases]` resolution is not
     * implemented in the seed yet), so it self-contains the module it exercises, mirroring
     * `examples/regressions/json_roundtrip/src/j/json.tks`'s established convention.
     *
     * THREE ALPHABETS, ONE ENGINE. RFC 4648 §4 "standard" (`+`/`/`, padded with `=`), §5
     * "URL and filename safe" (`-`/`_` in place of `+`/`/`, padded), and the padding-free variant
     * used by MIME/`base64url` contexts that omit trailing `=`. All three share the same 6-bit
     * grouping and only differ in (a) which two characters represent indices 62/63 and (b) whether
     * `=` padding is emitted/required. `Base64Alphabet` selects the two extra characters and the
     * padding policy so `encode`/`decode` stay ONE implementation each, parameterized by alphabet —
     * avoiding three near-duplicate encoders (M.5 — one source of truth).
     *
     * ERROR MODEL (M.1 fail-loud / M.3 honest types). `decode` is `str -> []byte | error`: invalid
     * alphabet characters, a malformed padding tail, or a truncated (non-multiple-of-4, unpadded-
     * short) final group are checked failures, never a panic. `encode` is total (any `[]byte` has a
     * valid Base64 rendering) so it returns `str` bare, matching `teko::encoding::json::encode`'s
     * totality precedent.
     */
    type Base64Alphabet = struct {
        /**
         * The character standing for 6-bit value 62 (`+` standard, `-` URL-safe).
         */
        char62: byte
        /**
         * The character standing for 6-bit value 63 (`/` standard, `_` URL-safe).
         */
        char63: byte
        /**
         * Whether `encode` emits trailing `=` padding and `decode` requires/consumes it.
         */
        padded: bool
    }

    /**
     * The RFC 4648 §4 standard alphabet (`+`/`/`), WITH `=` padding — the default MIME/general-
     * purpose form (`Content-Transfer-Encoding: base64`, data URIs, PEM-adjacent text).
     *
     * @return      the standard, padded `Base64Alphabet`
     */
    pub fn standard_alphabet() -> Base64Alphabet {
        Base64Alphabet { char62 = b'+'; char63 = b'/'; padded = true }
    }

    /**
     * The RFC 4648 §5 URL-and-filename-safe alphabet (`-`/`_`), WITH `=` padding — safe to embed
     * directly in a URL path/query segment without percent-encoding `+`/`/`.
     *
     * @return      the URL-safe, padded `Base64Alphabet`
     */
    pub fn url_safe_alphabet() -> Base64Alphabet {
        Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = true }
    }

    /**
     * The URL-safe alphabet WITHOUT `=` padding — the compact `base64url` form used by JWT
     * segments and other contexts where trailing padding is conventionally omitted.
     *
     * @return      the URL-safe, unpadded `Base64Alphabet`
     */
    pub fn url_safe_no_pad_alphabet() -> Base64Alphabet {
        Base64Alphabet { char62 = b'-'; char63 = b'_'; padded = false }
    }

    /**
     * Maps a 6-bit value (0..63) to its Base64 character under `alphabet`.
     *
     * @param alphabet  the alphabet selecting the 62/63 characters
     * @param sextet    a value in 0..63 (the caller guarantees this range)
     * @return          the corresponding Base64 alphabet character
     */
    fn base64_char_of(alphabet: Base64Alphabet, sextet: u32) -> byte {
        if sextet < 26 { return (b'A' to u32 + sextet) to byte }
        if sextet < 52 { return (b'a' to u32 + (sextet - 26)) to byte }
        if sextet < 62 { return (b'0' to u32 + (sextet - 52)) to byte }
        if sextet == 62 { return alphabet.char62 }
        alphabet.char63
    }

    /**
     * Encodes one complete 3-byte group into its 4-character Base64 quantum, appending it to `out`.
     *
     * @param out       the growing output byte accumulator
     * @param alphabet  the alphabet selecting the 62/63 characters
     * @param b0        the group's first input byte
     * @param b1        the group's second input byte
     * @param b2        the group's third input byte
     * @return          `out` with the 4 encoded characters appended
     */
    fn encode_full_group(out: []byte, alphabet: Base64Alphabet, b0: byte, b1: byte, b2: byte) -> []byte {
        let n0 = b0 to u32
        let n1 = b1 to u32
        let n2 = b2 to u32
        mut o = out
        o = teko::list::push(o, base64_char_of(alphabet, n0 >> 2))
        o = teko::list::push(o, base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4)))
        o = teko::list::push(o, base64_char_of(alphabet, ((n1 & 0xF) << 2) | (n2 >> 6)))
        o = teko::list::push(o, base64_char_of(alphabet, n2 & 0x3F))
        o
    }

    /**
     * Encodes a trailing 1- or 2-byte remainder group (fewer than 3 input bytes left), appending
     * its Base64 characters — plus `=` padding when `alphabet.padded` — to `out`.
     *
     * @param out       the growing output byte accumulator
     * @param alphabet  the alphabet selecting the 62/63 characters and padding policy
     * @param b0        the remainder's first byte
     * @param has_b1    whether a second remainder byte follows
     * @param b1        the remainder's second byte (ignored when `has_b1` is false)
     * @return          `out` with the remainder's encoded characters (and any padding) appended
     */
    fn encode_tail_group(out: []byte, alphabet: Base64Alphabet, b0: byte, has_b1: bool, b1: byte) -> []byte {
        let n0 = b0 to u32
        mut o = out
        o = teko::list::push(o, base64_char_of(alphabet, n0 >> 2))
        if has_b1 {
            let n1 = b1 to u32
            o = teko::list::push(o, base64_char_of(alphabet, ((n0 & 0x3) << 4) | (n1 >> 4)))
            o = teko::list::push(o, base64_char_of(alphabet, (n1 & 0xF) << 2))
            if alphabet.padded { o = teko::list::push(o, b'=') }
            return o
        }
        o = teko::list::push(o, base64_char_of(alphabet, (n0 & 0x3) << 4))
        if alphabet.padded {
            o = teko::list::push(o, b'=')
            o = teko::list::push(o, b'=')
        }
        o
    }

    /**
     * Encodes `data` as Base64 text under `alphabet`. Total (M.3 — a byte slice always has a valid
     * Base64 rendering): never fails, so the return type is `str` bare.
     *
     * @param data      the raw bytes to encode
     * @param alphabet  the alphabet (standard, URL-safe, or URL-safe unpadded) to render under
     * @return          the Base64-encoded text
     */
    pub fn encode(data: []byte, alphabet: Base64Alphabet) -> str {
        mut out: []byte = teko::list::empty()
        mut i: u64 = 0
        let full_groups = data.len / 3
        loop {
            if i >= full_groups { break }
            let base = i * 3
            out = encode_full_group(out, alphabet, data[base], data[base + 1], data[base + 2])
            i++
        }
        let remainder = data.len - (full_groups * 3)
        if remainder == 1 {
            out = encode_tail_group(out, alphabet, data[full_groups * 3], false, 0 to byte)
        } else if remainder == 2 {
            out = encode_tail_group(out, alphabet, data[full_groups * 3], true, data[(full_groups * 3) + 1])
        }
        str(out)
    }

    /**
     * `encode` under the RFC 4648 §4 standard, padded alphabet — the common default.
     *
     * @param data  the raw bytes to encode
     * @return      the standard-alphabet Base64 text
     */
    pub fn encode_standard(data: []byte) -> str {
        encode(data, standard_alphabet())
    }

    /**
     * `encode` under the RFC 4648 §5 URL-safe, padded alphabet.
     *
     * @param data  the raw bytes to encode
     * @return      the URL-safe Base64 text
     */
    pub fn encode_url_safe(data: []byte) -> str {
        encode(data, url_safe_alphabet())
    }

    /**
     * `encode` under the URL-safe, UNPADDED alphabet (the `base64url`/JWT-segment convention).
     *
     * @param data  the raw bytes to encode
     * @return      the URL-safe, unpadded Base64 text
     */
    pub fn encode_url_safe_no_pad(data: []byte) -> str {
        encode(data, url_safe_no_pad_alphabet())
    }

    /**
     * Decodes one Base64 alphabet character to its 6-bit value under `alphabet`, or reports it as
     * not a member of the alphabet.
     *
     * @param alphabet  the alphabet selecting the 62/63 characters
     * @param c         the character to classify
     * @return          the 6-bit value (0..63), or `error` when `c` is outside the alphabet
     */
    fn base64_value_of(alphabet: Base64Alphabet, c: byte) -> u32 | error {
        if c >= b'A' && c <= b'Z' { return (c to u32) - (b'A' to u32) }
        if c >= b'a' && c <= b'z' { return (c to u32) - (b'a' to u32) + 26 }
        if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) + 52 }
        if c == alphabet.char62 { return 62 to u32 }
        if c == alphabet.char63 { return 63 to u32 }
        error { message = "base64: invalid character in input" }
    }

    /**
     * The parsed shape of one decode pass's input: the alphabet characters with any trailing `=`
     * padding (and, for the unpadded variant, any trailing whitespace) already stripped, plus how
     * many padding characters were present (0, 1, or 2 — used to size the final output group).
     */
    type Base64Trimmed = struct {
        /**
         * The input with trailing `=` padding characters removed.
         */
        body: []byte
        /**
         * The count of trailing `=` characters that were removed (0, 1, or 2).
         */
        pad_count: u64
    }

    /**
     * Strips trailing `=` padding from `input` under `alphabet`'s padding policy, validating that a
     * padded alphabet's padding (when present) is well-formed (1 or 2 trailing `=`, never more, and
     * never on a body whose length isn't a multiple of 4 once padding is included).
     *
     * @param input     the raw Base64 text bytes
     * @param alphabet  the alphabet in effect (its `padded` flag governs padding expectations)
     * @return          the trimmed body plus pad count, or `error` for malformed padding
     */
    fn trim_base64_padding(input: []byte, alphabet: Base64Alphabet) -> Base64Trimmed | error {
        if !alphabet.padded {
            return Base64Trimmed { body = input; pad_count = 0 }
        }
        if input.len == 0 {
            return Base64Trimmed { body = input; pad_count = 0 }
        }
        if input.len % 4 != 0 {
            return error { message = "base64: padded input length must be a multiple of 4" }
        }
        mut pad: u64 = 0
        if input[input.len - 1] == b'=' { pad = 1 }
        if pad == 1 && input.len >= 2 && input[input.len - 2] == b'=' { pad = 2 }
        Base64Trimmed { body = bytes_slice_view(input, 0, input.len - pad); pad_count = pad }
    }

    /**
     * A copying sub-slice view of `data[from, to)` as a fresh `[]byte` (Teko slices have no native
     * sub-slice operator over `[]byte`, so this copies the range — mirrors
     * `teko::encoding::json`'s `str_slice_bytes` helper, generalized to return bytes instead of a
     * `str`).
     *
     * @param data  the source byte slice
     * @param from  the inclusive start offset
     * @param to    the exclusive end offset
     * @return      a fresh `[]byte` holding `data[from, to)`
     */
    fn bytes_slice_view(data: []byte, from: u64, to: u64) -> []byte {
        mut out: []byte = teko::list::empty()
        mut i = from
        loop {
            if i >= to { break }
            out = teko::list::push(out, data[i])
            i++
        }
        out
    }

    /**
     * Decodes one full 4-character Base64 quantum (no padding involved) into its 3 output bytes,
     * appending them to `out`.
     *
     * @param out       the growing decoded-byte accumulator
     * @param alphabet  the alphabet in effect
     * @param c0        the quantum's first character
     * @param c1        the quantum's second character
     * @param c2        the quantum's third character
     * @param c3        the quantum's fourth character
     * @return          `out` with the 3 decoded bytes appended, or `error` on an invalid character
     */
    fn decode_full_quantum(out: []byte, alphabet: Base64Alphabet, c0: byte, c1: byte, c2: byte, c3: byte) -> []byte | error {
        let v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
        let v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
        let v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
        let v3 = match base64_value_of(alphabet, c3) { u32 as v => v; error as e => return e }
        mut o = out
        o = teko::list::push(o, ((v0 << 2) | (v1 >> 4)) to byte)
        o = teko::list::push(o, (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte)
        o = teko::list::push(o, (((v2 << 6) | v3) & 0xFF) to byte)
        o
    }

    /**
     * Decodes a final quantum shortened by padding (2 or 3 significant characters) into its 1 or 2
     * output bytes, appending them to `out`.
     *
     * @param out         the growing decoded-byte accumulator
     * @param alphabet    the alphabet in effect
     * @param c0          the quantum's first character
     * @param c1          the quantum's second character
     * @param has_c2      whether a third significant character follows (one `=` of padding)
     * @param c2          the quantum's third character (ignored when `has_c2` is false)
     * @return            `out` with the decoded tail byte(s) appended, or `error` on an invalid character
     */
    fn decode_tail_quantum(out: []byte, alphabet: Base64Alphabet, c0: byte, c1: byte, has_c2: bool, c2: byte) -> []byte | error {
        let v0 = match base64_value_of(alphabet, c0) { u32 as v => v; error as e => return e }
        let v1 = match base64_value_of(alphabet, c1) { u32 as v => v; error as e => return e }
        mut o = out
        o = teko::list::push(o, ((v0 << 2) | (v1 >> 4)) to byte)
        if has_c2 {
            let v2 = match base64_value_of(alphabet, c2) { u32 as v => v; error as e => return e }
            o = teko::list::push(o, (((v1 << 4) | (v2 >> 2)) & 0xFF) to byte)
        }
        o
    }

    /**
     * Decodes the trailing (possibly padding-shortened) quantum of a padded-alphabet input,
     * dispatching to a full or partial quantum decode by `trimmed.pad_count`.
     *
     * @param out       the growing decoded-byte accumulator
     * @param alphabet  the alphabet in effect
     * @param trimmed   the padding-stripped body plus its pad count
     * @param start     the offset of the trailing quantum's first character within `trimmed.body`
     * @return          `out` with the trailing quantum's decoded byte(s) appended, or `error`
     */
    fn decode_trailing_quantum(out: []byte, alphabet: Base64Alphabet, trimmed: Base64Trimmed, start: u64) -> []byte | error {
        let body = trimmed.body
        if trimmed.pad_count == 0 {
            return decode_full_quantum(out, alphabet, body[start], body[start + 1], body[start + 2], body[start + 3])
        }
        if trimmed.pad_count == 1 {
            return decode_tail_quantum(out, alphabet, body[start], body[start + 1], true, body[start + 2])
        }
        decode_tail_quantum(out, alphabet, body[start], body[start + 1], false, 0 to byte)
    }

    /**
     * Validates that an UNPADDED alphabet's trimmed body never has a length whose remainder mod 4
     * is 1 (0, 2, and 3 are the only legal short-group tails for Base64 — a single leftover
     * character cannot encode any byte, padded or not).
     *
     * @param body_len  the trimmed body's length
     * @return          `error` when `body_len % 4 == 1`, otherwise `null` (no error)
     */
    fn validate_unpadded_length(body_len: u64) -> error | null {
        if body_len % 4 == 1 { return error { message = "base64: invalid unpadded input length" } }
        null
    }

    /**
     * Decodes the unpadded trailing group of an unpadded-alphabet input (0, 2, or 3 leftover
     * characters after the full 4-character quantums), appending its decoded byte(s) to `out`.
     *
     * @param out           the growing decoded-byte accumulator
     * @param alphabet      the alphabet in effect
     * @param body          the (already length-validated) input body
     * @param full_quantums the count of complete 4-character quantums before this tail
     * @return              `out` with the tail's decoded byte(s) appended, or `error`
     */
    fn decode_unpadded_tail(out: []byte, alphabet: Base64Alphabet, body: []byte, full_quantums: u64) -> []byte | error {
        let start = full_quantums * 4
        let remainder = body.len - start
        if remainder == 0 { return out }
        if remainder == 2 { return decode_tail_quantum(out, alphabet, body[start], body[start + 1], false, 0 to byte) }
        decode_tail_quantum(out, alphabet, body[start], body[start + 1], true, body[start + 2])
    }

    /**
     * Decodes every complete 4-character Base64 quantum in `body` (all but the final, possibly
     * partial group), appending their decoded bytes to `out`.
     *
     * @param out           the growing decoded-byte accumulator
     * @param alphabet      the alphabet in effect
     * @param body          the input body being decoded
     * @param full_quantums the count of complete 4-character quantums to decode
     * @return              `out` with every complete quantum's bytes appended, or `error`
     */
    fn decode_full_quantums(out: []byte, alphabet: Base64Alphabet, body: []byte, full_quantums: u64) -> []byte | error {
        mut o = out
        mut i: u64 = 0
        loop {
            if i >= full_quantums { break }
            let base = i * 4
            let next = match decode_full_quantum(o, alphabet, body[base], body[base + 1], body[base + 2], body[base + 3]) { []byte as b => b; error as e => return e }
            o = next
            i++
        }
        o
    }

    /**
     * Decodes Base64 `text` under `alphabet` back to raw bytes. Malformed input (an out-of-
     * alphabet character, bad padding, or an illegal trailing group length) is a checked `error`
     * (M.1 fail-loud), never a panic.
     *
     * @param text      the Base64-encoded text
     * @param alphabet  the alphabet the text was encoded under
     * @return          the decoded bytes, or `error` for malformed input
     */
    pub fn decode(text: str, alphabet: Base64Alphabet) -> []byte | error {
        let input = bytes_of_str(text)
        let trimmed = match trim_base64_padding(input, alphabet) { Base64Trimmed as t => t; error as e => return e }
        if !alphabet.padded {
            match validate_unpadded_length(trimmed.body.len) { null => { }; error as e => return e }
        }
        let body = trimmed.body
        let has_trailing = alphabet.padded && trimmed.pad_count > 0
        let full_quantums = body.len / 4
        mut out = match decode_full_quantums(teko::list::empty(), alphabet, body, full_quantums) { []byte as b => b; error as e => return e }
        if has_trailing {
            return decode_trailing_quantum(out, alphabet, trimmed, full_quantums * 4)
        }
        decode_unpadded_tail(out, alphabet, body, full_quantums)
    }

    /**
     * `decode` under the RFC 4648 §4 standard, padded alphabet.
     *
     * @param text  the standard-alphabet Base64 text
     * @return      the decoded bytes, or `error` for malformed input
     */
    pub fn decode_standard(text: str) -> []byte | error {
        decode(text, standard_alphabet())
    }

    /**
     * `decode` under the RFC 4648 §5 URL-safe, padded alphabet.
     *
     * @param text  the URL-safe Base64 text
     * @return      the decoded bytes, or `error` for malformed input
     */
    pub fn decode_url_safe(text: str) -> []byte | error {
        decode(text, url_safe_alphabet())
    }

    /**
     * `decode` under the URL-safe, UNPADDED alphabet.
     *
     * @param text  the URL-safe, unpadded Base64 text
     * @return      the decoded bytes, or `error` for malformed input
     */
    pub fn decode_url_safe_no_pad(text: str) -> []byte | error {
        decode(text, url_safe_no_pad_alphabet())
    }

    /**
     * `teko::encoding::csv` — RFC 4180 CSV parse/write, T1 of issue #189 (encodings T1: TOML +
     * CSV + URL/MIME). Pure Teko, no C twin (the `teko::regex` / `teko::encoding::json`
     * precedent: library code with zero OS/FFI dependency ships as `.tks` + `.tkt` only, and
     * both engines get it automatically).
     *
     * VERBATIM COPY of `src/encoding/csv/csv.tks`, kept in sync by hand — this regression
     * fixture is its own standalone project (cross-project `[aliases]` resolution is not
     * implemented in the seed yet), so it self-contains the module it exercises, mirroring
     * `examples/regressions/json_roundtrip/src/j/json.tks`'s established convention.
     *
     * VALUE MODEL. A CSV document is `[]CsvRow` where `CsvRow = struct { fields: []str }` — rows
     * of already-UNquoted field text (RFC 4180 §2's records-of-fields grammar), matching
     * `teko::encoding::json`'s parallel-slices precedent for "an ordered sequence of like things".
     *
     * QUOTING RULES (RFC 4180 §2). A field that contains a comma, a double quote, or a line break
     * (`\r`, `\n`, or `\r\n`) MUST be quoted; a literal `"` inside a quoted field is escaped as
     * `""`. `write_csv` quotes a field ONLY when required (the minimal-quoting convention nearly
     * every real-world CSV writer follows) — `parse_csv` accepts BOTH quoted and unquoted fields
     * per the grammar, and treats a leading `"` as the sole signal that a field is quoted (fields
     * never MIX a quoted prefix with trailing unquoted text — RFC 4180 does not allow it).
     *
     * LINE ENDINGS. RFC 4180 mandates `\r\n` between records; `write_csv` emits `\r\n` (the spec
     * form). `parse_csv` accepts `\r\n`, bare `\n`, AND bare `\r` as a record separator (real-world
     * CSV is generated by many non-conforming tools — accepting all three is the least-surface,
     * most-compatible read path, mirroring `teko::encoding::json`'s "never guess, but be liberal
     * about incidental whitespace" spirit) OUTSIDE a quoted field; a line break INSIDE a quoted
     * field is data, not a record separator (RFC 4180 §2 rule 5).
     *
     * ERROR MODEL (M.1 fail-loud / M.3 honest types). `parse_csv` is `str -> []CsvRow | error`: an
     * unterminated quoted field is a checked failure, never a panic. `write_csv` is total (any
     * `[]CsvRow` has a valid CSV rendering) so it returns `str` bare.
     *
     * NAMING NOTE (VM/checker/native gotcha — HALT-worthy finding, kept here for the next reader):
     * the bare names `parse` and `write` are RESERVED builtins — `parse` is
     * `teko::float::parse(str) -> f64` (src/checker/scope.tks, matched by bare LAST SEGMENT
     * regardless of namespace prefix, the same mechanism that lets `teko::str::concat`/
     * `teko::string::concat` share one dispatch), and `write` is the stdout primitive
     * `tk_write(str) -> void` (src/codegen/codegen.tks, same bare-last-segment dispatch, native
     * codegen only). Declaring a public function literally named `parse` (even fully namespaced as
     * `teko::encoding::csv::parse`) gets shadowed by the float builtin at the CHECKER/VM layer: a
     * call resolves to the f64 builtin instead of this module's CSV parser, and matching its
     * `[]CsvRow | error` result against `f64`'s shape panics at runtime ("non-exhaustive match" —
     * neither arm's pattern actually matches the wrong-shaped value). Declaring one literally named
     * `write` compiles and passes the VM gate (the VM has no `tk_write` collision) but FAILS the
     * NATIVE gate: codegen emits a call to `tk_write` with this function's `[]CsvRow` argument
     * against `tk_write`'s `tk_str` parameter, a C type mismatch the host `cc` rejects. Both
     * collisions are avoided here by using `parse_csv`/`write_csv` instead.
     */

    /**
     * One CSV record: its fields, in column order, already unquoted/unescaped.
     */
    type CsvRow = struct {
        /**
         * The record's field values, in column order.
         */
        fields: []str
    }

    /**
     * Does `field` require RFC 4180 quoting — does it contain a comma, a double quote, or any of
     * `\r`/`\n`?
     *
     * @param field  the field text to inspect
     * @return       true when `field` must be quoted to round-trip safely
     */
    fn needs_quoting(field: str) -> bool {
        let bytes = bytes_of_str(field)
        mut i: u64 = 0
        loop {
            if i >= bytes.len { break }
            let b = bytes[i]
            if b == b',' || b == b'"' || b == b'\n' || b == b'\r' { return true }
            i++
        }
        false
    }

    /**
     * Appends `field`'s RFC 4180 quoted form (`"`, then the field with every `"` doubled, then
     * `"`) to `out`.
     *
     * @param out    the growing output byte accumulator
     * @param field  the field text to quote
     * @return       `out` with the quoted field appended
     */
    fn append_quoted_field(out: []byte, field: str) -> []byte {
        let bytes = bytes_of_str(field)
        mut o = teko::list::push(out, b'"')
        mut i: u64 = 0
        loop {
            if i >= bytes.len { break }
            let b = bytes[i]
            o = teko::list::push(o, b)
            if b == b'"' { o = teko::list::push(o, b'"') }
            i++
        }
        teko::list::push(o, b'"')
    }

    /**
     * Appends `field` to `out`, quoting it first when `needs_quoting` requires it.
     *
     * @param out    the growing output byte accumulator
     * @param field  the field text to render
     * @return       `out` with the (possibly quoted) field appended
     */
    fn append_field(out: []byte, field: str) -> []byte {
        if needs_quoting(field) { return append_quoted_field(out, field) }
        mut o = out
        let bytes = bytes_of_str(field)
        mut i: u64 = 0
        loop {
            if i >= bytes.len { break }
            o = teko::list::push(o, bytes[i])
            i++
        }
        o
    }

    /**
     * Appends one record's fields — comma-separated, each quoted only if required — followed by
     * the RFC 4180 `\r\n` record terminator, to `out`.
     *
     * @param out  the growing output byte accumulator
     * @param row  the record to render
     * @return     `out` with the rendered record (plus its `\r\n` terminator) appended
     */
    fn append_row(out: []byte, row: CsvRow) -> []byte {
        mut o = out
        mut i: u64 = 0
        loop {
            if i >= row.fields.len { break }
            if i > 0 { o = teko::list::push(o, b',') }
            o = append_field(o, row.fields[i])
            i++
        }
        o = teko::list::push(o, b'\r')
        teko::list::push(o, b'\n')
    }

    /**
     * Renders `rows` as RFC 4180 CSV text: comma-separated fields (quoted only when required),
     * `\r\n`-terminated records. Total (M.3): any `[]CsvRow` has a valid CSV rendering.
     *
     * @param rows  the records to render, in order
     * @return      the CSV document text
     */
    pub fn write_csv(rows: []CsvRow) -> str {
        mut out: []byte = teko::list::empty()
        mut i: u64 = 0
        loop {
            if i >= rows.len { break }
            out = append_row(out, rows[i])
            i++
        }
        str(out)
    }

    /**
     * One parse step's outcome: the parsed field's text plus the input position just past it
     * (past its closing quote for a quoted field, or past its terminating delimiter's start for
     * an unquoted one).
     */
    type FieldStep = struct {
        /**
         * The field's unquoted/unescaped text.
         */
        text: str
        /**
         * The offset in the input just past this field (before any `,`/record-terminator).
         */
        next: u64
    }

    /**
     * Parses one QUOTED field (input positioned AT the opening `"`): copies bytes through,
     * un-escaping `""` to a single `"`, until the matching unescaped closing `"`.
     *
     * @param input  the raw source bytes
     * @param pos    the offset of the field's opening `"`
     * @return       the unquoted field text plus the position just past the closing `"`, or
     *               `error` when the quote is never closed
     */
    fn parse_quoted_field(input: []byte, pos: u64) -> FieldStep | error {
        mut i = pos + 1
        mut out: []byte = teko::list::empty()
        loop {
            if i >= input.len { return error { message = "csv: unterminated quoted field" } }
            let b = input[i]
            if b != b'"' {
                out = teko::list::push(out, b)
                i++
                continue
            }
            let is_escaped_quote = i + 1 < input.len && input[i + 1] == b'"'
            if is_escaped_quote {
                out = teko::list::push(out, b'"')
                i = i + 2
                continue
            }
            return FieldStep { text = str(out); next = i + 1 }
        }
        error { message = "csv: unreachable" }
    }

    /**
     * Is `b` a record-terminating byte outside a quoted field (`,`, `\r`, `\n`, or past-the-end)?
     *
     * @param input  the raw source bytes
     * @param pos    the offset to classify
     * @return       true when `pos` is at or past the end, or `input[pos]` is `,`/`\r`/`\n`
     */
    fn is_field_boundary(input: []byte, pos: u64) -> bool {
        if pos >= input.len { return true }
        let b = input[pos]
        b == b',' || b == b'\r' || b == b'\n'
    }

    /**
     * Parses one UNQUOTED field (input positioned at its first byte): copies bytes through
     * verbatim until the next `,`, line break, or end of input.
     *
     * @param input  the raw source bytes
     * @param pos    the offset of the field's first byte
     * @return       the field text plus the position just past it (at the boundary byte)
     */
    fn parse_unquoted_field(input: []byte, pos: u64) -> FieldStep {
        mut i = pos
        loop {
            if is_field_boundary(input, i) { break }
            i++
        }
        FieldStep { text = str_slice_bytes_view(input, pos, i); next = i }
    }

    /**
     * A copying sub-slice view of `data[from, to)` as a fresh `str` (assumes the range is valid
     * UTF-8 — true here because it slices within an already-validated CSV source).
     *
     * @param data  the source byte slice
     * @param from  the inclusive start offset
     * @param to    the exclusive end offset
     * @return      a fresh `str` holding `data[from, to)`
     */
    fn str_slice_bytes_view(data: []byte, from: u64, to: u64) -> str {
        mut out: []byte = teko::list::empty()
        mut i = from
        loop {
            if i >= to { break }
            out = teko::list::push(out, data[i])
            i++
        }
        str(out)
    }

    /**
     * Parses one field (quoted or unquoted, dispatching on whether `input[pos]` is `"`).
     *
     * @param input  the raw source bytes
     * @param pos    the offset of the field's first byte
     * @return       the parsed field plus the position just past it, or `error` for an
     *               unterminated quoted field
     */
    fn parse_field(input: []byte, pos: u64) -> FieldStep | error {
        if pos < input.len && input[pos] == b'"' { return parse_quoted_field(input, pos) }
        parse_unquoted_field(input, pos)
    }

    /**
     * Consumes one record terminator (`\r\n`, bare `\r`, or bare `\n`) at `pos`, returning the
     * position just past it (unchanged when `pos` is already at end of input).
     *
     * @param input  the raw source bytes
     * @param pos    the offset to consume a terminator from
     * @return       the position just past the consumed terminator (or `pos` unchanged at EOF)
     */
    fn consume_record_terminator(input: []byte, pos: u64) -> u64 {
        if pos >= input.len { return pos }
        if input[pos] == b'\r' && pos + 1 < input.len && input[pos + 1] == b'\n' { return pos + 2 }
        pos + 1
    }

    /**
     * Parses one record starting at `pos`: comma-separated fields until a line break or end of
     * input, followed by consuming that terminator.
     *
     * @param input  the raw source bytes
     * @param pos    the offset of the record's first field
     * @return       the parsed row plus the position just past its terminator, or `error` for a
     *               malformed (unterminated-quote) field
     */
    fn parse_row(input: []byte, pos: u64) -> RowStep | error {
        mut fields: []str = teko::list::empty()
        mut i = pos
        loop {
            let step = match parse_field(input, i) { FieldStep as s => s; error as e => return e }
            fields = teko::list::push(fields, step.text)
            i = step.next
            if i >= input.len || input[i] == b'\r' || input[i] == b'\n' { break }
            i = i + 1
        }
        let after = consume_record_terminator(input, i)
        RowStep { row = CsvRow { fields = fields }; next = after }
    }

    /**
     * One record-parse step's outcome: the parsed row plus the input position just past its
     * terminator.
     */
    type RowStep = struct {
        /**
         * The parsed record.
         */
        row: CsvRow
        /**
         * The offset in the input just past this record's terminator.
         */
        next: u64
    }

    /**
     * Parses `text` as an RFC 4180 CSV document into its records. A trailing newline produces no
     * extra empty record (a document ending exactly at a terminator is the common, well-formed
     * case); a genuinely empty final line (two consecutive terminators, or trailing text after
     * the last terminator) still yields its row, matching real-world CSV readers.
     *
     * @param text  the CSV document text
     * @return      the parsed records in source order, or `error` for an unterminated quoted field
     */
    pub fn parse_csv(text: str) -> []CsvRow | error {
        let input = bytes_of_str(text)
        if input.len == 0 {
            let no_rows: []CsvRow = teko::list::empty()
            return no_rows
        }
        mut rows: []CsvRow = teko::list::empty()
        mut pos: u64 = 0
        loop {
            if pos >= input.len { break }
            let step = match parse_row(input, pos) { RowStep as s => s; error as e => return e }
            rows = teko::list::push(rows, step.row)
            pos = step.next
        }
        rows
    }

    /**
     * Converts a boolean check outcome to its exit-code contribution (1 = held, 0 = failed) —
     * the same accumulator idiom `json_roundtrip::m::work`'s `check_ops` uses. This module drives
     * `teko::encoding::base64`, `teko::encoding::url`, and `teko::encoding::csv` (issue #189,
     * mirrored verbatim in this fixture's own `src/b64`/`src/url`/`src/csv` — see each file's
     * header, namespaces `b64`/`::url`/`::csv`, `use`d above) through
     * known-answer encode/decode checks plus round-trip fixpoints; `check_ops` below sums all 12
     * checks into the fixture's exit code.
     *
     * @param b  the check's boolean outcome
     * @return   1 when `b` is true, 0 otherwise
     */
    fn bool_to_i64(b: bool) -> i64 {
        if b { 1 } else { 0 }
    }

    /**
     * Compares two `[]byte` slices for equal content (Teko has no built-in slice equality).
     *
     * @param a  the first slice
     * @param b  the second slice
     * @return   true when both slices have the same length and identical bytes at every index
     */
    fn bytes_equal(a: []byte, b: []byte) -> bool {
        if a.len != b.len { return false }
        mut i: u64 = 0
        loop {
            if i >= a.len { break }
            if a[i] != b[i] { return false }
            i++
        }
        true
    }

    /**
     * Base64 checks: the RFC 4648 "Man"/"" known answers plus a URL-safe round-trip.
     *
     * @return  1 for each of 4 checks that held (0..4)
     */
    fn base64_checks() -> i64 {
        let c1 = bool_to_i64(encode_standard(bytes_of_str("Man")) == "TWFu")
        let c2 = bool_to_i64(encode_standard(teko::list::empty()) == "")
        let decoded = match decode_standard("TWFu") {
            []byte as v => v
            error => teko::list::empty()
        }
        let c3 = bool_to_i64(bytes_equal(decoded, bytes_of_str("Man")))
        let raw = bytes_of_str("foobar")
        let round_tripped = match decode_url_safe_no_pad(encode_url_safe_no_pad(raw)) {
            []byte as v => v
            error => teko::list::empty()
        }
        let c4 = bool_to_i64(bytes_equal(round_tripped, raw))
        c1 + c2 + c3 + c4
    }

    /**
     * URL checks: RFC 3986 percent-encoding known answer, form-urlencoded space-as-`+`, and a
     * form-body parse round-trip.
     *
     * @return  1 for each of 4 checks that held (0..4)
     */
    fn url_checks() -> i64 {
        let c1 = bool_to_i64(percent_encode("hello world!") == "hello%20world%21")
        let c2 = bool_to_i64(encode_form_component("john doe") == "john+doe")
        let decoded = match percent_decode("hello%20world%21") {
            str as s => s
            error => ""
        }
        let c3 = bool_to_i64(decoded == "hello world!")
        let fields = match parse_form("name=john+doe&q=a%2Bb") {
            []FormField as f => f
            error => teko::list::empty()
        }
        let c4 = bool_to_i64(fields.len == 2 && fields[0].value == "john doe" && fields[1].value == "a+b")
        c1 + c2 + c3 + c4
    }

    /**
     * CSV checks: RFC 4180 minimal-quoting write, quoted-field parse, and a write-then-parse
     * round-trip over commas/quotes/newlines.
     *
     * @return  1 for each of 4 checks that held (0..4)
     */
    fn csv_checks() -> i64 {
        mut fields: []str = teko::list::empty()
        fields = teko::list::push(fields, "hello, world")
        fields = teko::list::push(fields, "plain")
        let row = CsvRow { fields = fields }
        mut rows: []CsvRow = teko::list::empty()
        rows = teko::list::push(rows, row)
        let written = write_csv(rows)
        let c1 = bool_to_i64(written == "\"hello, world\",plain\r\n")

        let parsed = match parse_csv("a,b,c\r\n1,2,3\r\n") {
            []CsvRow as r => r
            error => teko::list::empty()
        }
        let c2 = bool_to_i64(parsed.len == 2 && parsed[0].fields[0] == "a" && parsed[1].fields[2] == "3")

        let round_tripped = match parse_csv(written) {
            []CsvRow as r => r
            error => teko::list::empty()
        }
        let c3 = bool_to_i64(round_tripped.len == 1 && round_tripped[0].fields[0] == "hello, world")

        let rejected = match parse_csv("\"unterminated") {
            []CsvRow => false
            error => true
        }
        let c4 = bool_to_i64(rejected)
        c1 + c2 + c3 + c4
    }

    /**
     * Runs every codec's checks and sums their exit-code contributions.
     *
     * @return  the total held-check count (0..12; 12 = every check passed)
     */
    pub fn check_ops() -> i64 {
        base64_checks() + url_checks() + csv_checks()
    }

    /**
     * `teko::encoding::url` — RFC 3986 percent-encoding plus `application/x-www-form-urlencoded`
     * encode/decode, T1 of issue #189 (encodings T1: TOML + CSV + URL/MIME). Pure Teko, no C twin
     * (the `teko::regex` / `teko::encoding::json` precedent: library code with zero OS/FFI
     * dependency ships as `.tks` + `.tkt` only, and both engines get it automatically).
     *
     * VERBATIM COPY of `src/encoding/url/url.tks`, kept in sync by hand — this regression fixture
     * is its own standalone project (cross-project `[aliases]` resolution is not implemented in
     * the seed yet), so it self-contains the module it exercises, mirroring
     * `examples/regressions/json_roundtrip/src/j/json.tks`'s established convention.
     *
     * TWO ENCODINGS, ONE ESCAPE ENGINE. RFC 3986 §2.3 "unreserved" characters (`A-Z a-z 0-9 - _ . ~`)
     * never need escaping; everything else percent-encodes to `%XX` (uppercase hex, per §2.1's
     * recommendation and universal practice). `application/x-www-form-urlencoded` (the HTML-form
     * body/query-string convention) is the SAME percent-escape engine with one addition: a space
     * encodes as `+` instead of `%20` (and `decode_form` accepts `+` back as a space, on top of
     * ordinary `%XX` decoding) — so `percent_encode`/`percent_decode` and
     * `encode_form_component`/`decode_form_component` share one core, parameterized by whether `+`
     * means space (M.5 — one source of truth, mirrors `teko::encoding::base64`'s one-engine-per-
     * alphabet-flag shape).
     *
     * ERROR MODEL (M.1 fail-loud / M.3 honest types). Decoding is `str -> str | error`: a `%` not
     * followed by two hex digits is a checked failure, never a panic. Encoding is total (any `str`
     * has a valid percent-encoded rendering) so it returns `str` bare.
     */

    /**
     * Is `b` one of RFC 3986 §2.3's UNRESERVED characters (never percent-encoded under either
     * encoding)? — letters, digits, and `- _ . ~`.
     *
     * @param b  the byte to classify
     * @return   true when `b` is unreserved
     */
    fn is_unreserved(b: byte) -> bool {
        if b >= b'A' && b <= b'Z' { return true }
        if b >= b'a' && b <= b'z' { return true }
        if b >= b'0' && b <= b'9' { return true }
        b == b'-' || b == b'_' || b == b'.' || b == b'~'
    }

    /**
     * The uppercase hex digit (`0-9A-F`) for a nibble (0..15).
     *
     * @param nibble  a value in 0..15 (the caller guarantees this range)
     * @return        the corresponding uppercase hex character
     */
    fn hex_upper_nibble(nibble: u32) -> byte {
        if nibble < 10 { return (b'0' to u32 + nibble) to byte }
        (b'A' to u32 + (nibble - 10)) to byte
    }

    /**
     * Appends the 3-byte `%XX` percent-escape for `b` (uppercase hex) to `out`.
     *
     * @param out  the growing output byte accumulator
     * @param b    the byte to escape
     * @return     `out` with `%`, then `b`'s two uppercase hex digits, appended
     */
    fn append_percent_escape(out: []byte, b: byte) -> []byte {
        let v = b to u32
        mut o = out
        o = teko::list::push(o, b'%')
        o = teko::list::push(o, hex_upper_nibble(v >> 4))
        o = teko::list::push(o, hex_upper_nibble(v & 0xF))
        o
    }

    /**
     * Encodes `text` byte-by-byte: unreserved bytes pass through verbatim, a space becomes `+`
     * when `space_as_plus` is set (the form-urlencoded convention), and every other byte
     * percent-escapes as `%XX`. The one shared engine behind both `percent_encode` and
     * `encode_form_component` (M.5).
     *
     * @param text           the text to encode
     * @param space_as_plus  whether a space (`0x20`) renders as `+` instead of `%20`
     * @return               the percent-encoded text
     */
    fn encode_with(text: str, space_as_plus: bool) -> str {
        let input = bytes_of_str(text)
        mut out: []byte = teko::list::empty()
        mut i: u64 = 0
        loop {
            if i >= input.len { break }
            let b = input[i]
            if space_as_plus && b == b' ' {
                out = teko::list::push(out, b'+')
            } else if is_unreserved(b) {
                out = teko::list::push(out, b)
            } else {
                out = append_percent_escape(out, b)
            }
            i++
        }
        str(out)
    }

    /**
     * Percent-encodes `text` per RFC 3986 §2.1: every byte outside the unreserved set becomes
     * `%XX` (uppercase hex); a space becomes `%20` (NOT `+` — that is the form-urlencoded
     * convention, see `encode_form_component`). Total (M.3): always succeeds.
     *
     * @param text  the text to encode
     * @return      the percent-encoded text
     */
    pub fn percent_encode(text: str) -> str {
        encode_with(text, false)
    }

    /**
     * Encodes `text` as one `application/x-www-form-urlencoded` component: identical to
     * `percent_encode` except a space becomes `+` instead of `%20` — the HTML-form
     * query-string/body convention. Total (M.3): always succeeds.
     *
     * @param text  the text to encode
     * @return      the form-urlencoded text
     */
    pub fn encode_form_component(text: str) -> str {
        encode_with(text, true)
    }

    /**
     * The value of one hex digit (`0-9A-Fa-f`), or a report that `c` is not a hex digit.
     *
     * @param c  the character to classify
     * @return   the digit's value (0..15), or `error` when `c` is not a hex digit
     */
    fn hex_digit_value_of(c: byte) -> u32 | error {
        if c >= b'0' && c <= b'9' { return (c to u32) - (b'0' to u32) }
        if c >= b'a' && c <= b'f' { return (c to u32) - (b'a' to u32) + 10 }
        if c >= b'A' && c <= b'F' { return (c to u32) - (b'A' to u32) + 10 }
        error { message = "url: invalid hex digit in percent-escape" }
    }

    /**
     * One `%XX` decode step's result: the decoded byte plus the input position just past it.
     */
    type PercentEscapeStep = struct {
        /**
         * The byte the `%XX` escape decoded to.
         */
        value: byte
        /**
         * The offset in the input just past the 3-byte `%XX` escape.
         */
        next: u64
    }

    /**
     * Decodes one `%XX` percent-escape (input positioned AT the `%`), returning the escaped byte
     * and the position just past the two hex digits.
     *
     * @param input  the raw encoded bytes
     * @param pos    the offset of the `%` character
     * @return       the decoded byte plus the position past the escape, or `error` on a truncated
     *               or malformed escape
     */
    fn decode_percent_escape(input: []byte, pos: u64) -> PercentEscapeStep | error {
        if pos + 2 >= input.len { return error { message = "url: truncated percent-escape" } }
        let hi = match hex_digit_value_of(input[pos + 1]) { u32 as v => v; error as e => return e }
        let lo = match hex_digit_value_of(input[pos + 2]) { u32 as v => v; error as e => return e }
        PercentEscapeStep { value = ((hi << 4) | lo) to byte; next = pos + 3 }
    }

    /**
     * Decodes `text` byte-by-byte: `%XX` escapes decode to their byte, a `+` decodes to a space
     * when `plus_as_space` is set (the form-urlencoded convention), and every other byte passes
     * through verbatim. The one shared engine behind both `percent_decode` and
     * `decode_form_component` (M.5). Malformed `%XX` escapes and a non-UTF-8 result are checked
     * `error`s (M.1 fail-loud).
     *
     * @param text           the encoded text to decode
     * @param plus_as_space  whether a literal `+` decodes to a space
     * @return               the decoded text, or `error` for a malformed escape or invalid UTF-8
     */
    fn decode_with(text: str, plus_as_space: bool) -> str | error {
        let input = bytes_of_str(text)
        mut out: []byte = teko::list::empty()
        mut i: u64 = 0
        loop {
            if i >= input.len { break }
            let b = input[i]
            if b == b'%' {
                let step = match decode_percent_escape(input, i) { PercentEscapeStep as s => s; error as e => return e }
                out = teko::list::push(out, step.value)
                i = step.next
                continue
            }
            if plus_as_space && b == b'+' {
                out = teko::list::push(out, b' ')
            } else {
                out = teko::list::push(out, b)
            }
            i++
        }
        str_from_utf8(out)
    }

    /**
     * Decodes a percent-encoded `text` per RFC 3986: `%XX` escapes become their byte, every other
     * byte passes through verbatim (a `+` is left as a literal `+` — NOT decoded to a space; use
     * `decode_form_component` for the form-urlencoded convention).
     *
     * @param text  the percent-encoded text
     * @return      the decoded text, or `error` for a malformed escape or invalid UTF-8 result
     */
    pub fn percent_decode(text: str) -> str | error {
        decode_with(text, false)
    }

    /**
     * Decodes one `application/x-www-form-urlencoded` component: `%XX` escapes become their
     * byte AND a literal `+` decodes to a space (the HTML-form convention).
     *
     * @param text  the form-urlencoded text
     * @return      the decoded text, or `error` for a malformed escape or invalid UTF-8 result
     */
    pub fn decode_form_component(text: str) -> str | error {
        decode_with(text, true)
    }

    /**
     * One decoded `key=value` pair from a parsed form-urlencoded query/body string.
     */
    type FormField = struct {
        /**
         * The decoded field name.
         */
        key: str
        /**
         * The decoded field value (empty when the field had no `=value` part).
         */
        value: str
    }

    /**
     * Splits `body` on `&` (and legacy `;`, still accepted by common implementations) into its raw
     * `key=value` segments, without decoding — a preparatory step shared by `parse_form`.
     *
     * @param body  the raw (still percent/`+`-encoded) form body or query string
     * @return      the list of raw, undecoded segments
     */
    fn split_form_segments(body: str) -> []str {
        let input = bytes_of_str(body)
        mut segments: []str = teko::list::empty()
        mut start: u64 = 0
        mut i: u64 = 0
        loop {
            if i >= input.len { break }
            if input[i] == b'&' || input[i] == b';' {
                segments = teko::list::push(segments, str_slice_chars(body, start to i64, i to i64))
                start = i + 1
            }
            i++
        }
        segments = teko::list::push(segments, str_slice_chars(body, start to i64, input.len to i64))
        segments
    }

    /**
     * Splits one raw `key=value` (or bare `key`) segment at its FIRST `=`, returning the raw
     * (still-encoded) key and value halves.
     *
     * @param segment  one raw, undecoded `key=value` segment
     * @return         the raw key and value halves (`value` is empty when no `=` was present)
     */
    fn split_key_value(segment: str) -> FormField {
        let input = bytes_of_str(segment)
        mut i: u64 = 0
        loop {
            if i >= input.len { break }
            if input[i] == b'=' {
                return FormField { key = str_slice_chars(segment, 0, i to i64); value = str_slice_chars(segment, (i + 1) to i64, input.len to i64) }
            }
            i++
        }
        FormField { key = segment; value = "" }
    }

    /**
     * Decodes one raw `key=value` segment into a `FormField` with both halves percent/`+`-decoded.
     *
     * @param segment  one raw, undecoded `key=value` segment
     * @return         the decoded field, or `error` when either half is malformed
     */
    fn decode_form_segment(segment: str) -> FormField | error {
        let raw = split_key_value(segment)
        let key = match decode_form_component(raw.key) { str as s => s; error as e => return e }
        let value = match decode_form_component(raw.value) { str as s => s; error as e => return e }
        FormField { key = key; value = value }
    }

    /**
     * Parses an `application/x-www-form-urlencoded` body (or a URL query string, `?`-prefix
     * already stripped by the caller) into its decoded `key=value` fields, in source order.
     * Fields are `&`-separated (and legacy `;`-separated); a bare `key` with no `=` decodes to an
     * empty value.
     *
     * @param body  the raw form body or query string
     * @return      the decoded fields in source order, or `error` when any segment is malformed
     */
    pub fn parse_form(body: str) -> []FormField | error {
        if body.len == 0 {
            let no_fields: []FormField = teko::list::empty()
            return no_fields
        }
        let segments = split_form_segments(body)
        mut fields: []FormField = teko::list::empty()
        mut i: u64 = 0
        loop {
            if i >= segments.len { break }
            let field = match decode_form_segment(segments[i]) { FormField as f => f; error as e => return e }
            fields = teko::list::push(fields, field)
            i++
        }
        fields
    }

    /**
     * Renders `fields` back into one `application/x-www-form-urlencoded` body string
     * (`key=value` pairs, `&`-joined, both halves percent/`+`-encoded). Total (M.3): always
     * succeeds (the inverse of `parse_form`, modulo key ordering and the `;` legacy separator).
     *
     * @param fields  the fields to render, in the order they should appear
     * @return        the encoded form body
     */
    pub fn encode_form(fields: []FormField) -> str {
        mut out = ""
        mut i: u64 = 0
        loop {
            if i >= fields.len { break }
            if i > 0 { out = concat(out, "&") }
            out = concat(out, encode_form_component(fields[i].key), "=", encode_form_component(fields[i].value))
            i++
        }
        out
    }

    (check_ops()) to i32
    """
    When built and run
    Then exit = 12

  Scenario: enum_member_shadows_primkind
    Given source inline = """
    /** Kind — mirrors the SHAPE of `teko::checker::PrimKind` closely enough to reproduce #263: an
     * integer family followed by a float family, so `F32` sits at a NON-ZERO ordinal (2), not 0. */
    pub type Kind = enum { I32; U32; F32 }

    /** is_float — a bare-member match over `Kind`, the exact shape `teko::checker::prim_is_float`
     * uses over `PrimKind` (`match k { F32 => true; F64 => true; _ => false }`). */
    pub fn is_float(k: Kind) -> bool {
        match k { F32 => true; _ => false }
    }

    /** Format — an UNRELATED enum that ALSO declares a member literally named `F32`, but at ordinal
     * 0 (not 2, like `Kind::F32`). Its mere presence in the corpus is the #263 trigger: the VM's
     * pre-fix `vm_match_as_enum_int` scanned every enum program-wide for a member named `F32`,
     * regardless of which enum the match's subject actually was. */
    pub type Format = enum { F32; Text }

    /** is_binary_format — a bare-member match over `Format`, so its OWN `F32` (ordinal 0) is
     * exercised too — proving the fix does not merely favor whichever enum comes first. */
    pub fn is_binary_format(f: Format) -> bool {
        match f { F32 => true; _ => false }
    }

    /** cast_i32_roundtrips — the issue's OWN symptom: a cast to `i32` (an entirely different prim
     * family from the colliding `F32` member) must keep working once ANY enum with an `F32` member
     * exists in the corpus. */
    pub fn cast_i32_roundtrips(v: i64) -> i32 {
        v to i32
    }

    if !is_float(Kind::F32) { exit(1) }
    if is_float(Kind::I32) { exit(2) }
    if is_float(Kind::U32) { exit(3) }
    if !is_binary_format(Format::F32) { exit(4) }
    if is_binary_format(Format::Text) { exit(5) }
    if cast_i32_roundtrips(42) != 42 { exit(6) }

    exit(15)
    """
