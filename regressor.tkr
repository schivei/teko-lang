  # The riscv64 lane's OBJECT cross-check, restored alongside the differential rows above: the
  # retired riscv64-qemu job asserted own == C under qemu AND ran scripts/check_elf.sh over the
  # own-emitted riscv .o with the riscv binutils. The differential rows cannot carry that step —
  # `Then object well-formed` is per-scenario, and their `c` rows emit no `.o` at all — so the
  # object check lives here, pinned to the own backend on the cross target.

  Scenario: own_riscv_object_well_formed (the retired riscv64-qemu lane's ELF cross-check)
    Given backend = "own"
    Given target = "riscv64-linux"
    Given source = "examples/regressions/cwd_build/cases/18_own_riscv_object_well_formed_the_retired.tks"
    When built and run
    Then exit = 42
    Then object well-formed

  # (0.3.1 C5) The CROSS-EMIT rows: TEKO_TARGET names a target this host may be able to BUILD but
  # cannot EXECUTE. R3 says emit normally; C5 says report "emitted, not executed" and skip the run
  # instead of failing on an exec of a foreign-format binary. The RUN is honest-skipped by
  # cross_note_for_name (the same classification the build's own report uses) while `Then object
  # well-formed` still asserts the emitted object IS the requested format — which is the whole point
  # of a cross build. On a host with no cross toolchain the row skips earlier, at
  # target_toolchain_skip_reason.

  Scenario: own_cross_x86_64_windows_emits_coff_and_skips_the_run (0.3.1 C5 — emitted, not executed)
    Given backend = "own"
    Given target = "x86_64-windows"
    Given source = "examples/regressions/cwd_build/cases/19_own_cross_x86_64_windows_emits_coff_and.tks"
    When built and run
    Then exit = 42
    Then object well-formed

  # (0.3.1 C5) The host os-arch spelled EXPLICITLY: the reproduced-good path of the motivating bug
  # (TEKO_TARGET=x86_64-linux made the whole vertical work, exit 42). On an x86_64 linux host this
  # RUNS for real; on any other host it is a cross target whose link step would reach the host `cc`,
  # so host_cc_cannot_link_cross_reason skips the row honestly instead of dying in `ld`.

  Scenario: own_explicit_host_os_arch_runs (0.3.1 C5 — the reproduced-good path)
    Given backend = "own"
    Given target = "x86_64-linux"
    Given source = "examples/regressions/cwd_build/cases/20_own_explicit_host_os_arch_runs_0_3_1_c5.tks"
    When built and run
    Then exit = 42
    Then object well-formed


