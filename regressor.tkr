  Scenario: interface_dispatch
    Given source inline = """
    type Shape = interface {
        fn area(self) -> i64
        fn grown(self, extra: i64) -> i64
    }

    type NamedShape = interface Shape {
        fn shape_name(self) -> str
    }

    type Circle = class & Shape {
        pub r: i64
        pub fn make(rr: i64) -> Circle { Circle { r = rr } }
        pub fn area(self) -> i64 { self.r * self.r * 3 }
        pub fn grown(self, extra: i64) -> i64 { self.area() + extra }
    }

    type Square = class & NamedShape {
        pub side: i64
        pub fn make(s: i64) -> Square { Square { side = s } }
        pub fn area(self) -> i64 { self.side * self.side }
        pub fn grown(self, extra: i64) -> i64 { self.area() + extra }
        pub fn shape_name(self) -> str { "square" }
    }

    type Speaker = interface {
        fn speak(self) -> str
    }

    type Animal = virtual class & Speaker {
        pub legs: i64
        pub fn make_animal(n: i64) -> Animal { Animal { legs = n } }
        pub virtual fn speak(self) -> str { "..." }
    }

    type Dog = class Animal {
        pub fn make_dog() -> Dog { Dog { legs = 4 } }
        pub override fn speak(self) -> str { "woof" }
    }

    fn shape_area(s: Shape) -> i64 { s.area() }

    fn pick_shape(which: i64) -> Shape {
        if which == 0 { return Circle::make(1) }
        return Square::make(5)
    }

    fn total_area(shapes: []Shape) -> i64 {
        mut sum: i64 = 0
        mut i: u64 = 0
        loop {
            if i >= shapes.len { break }
            let s = shapes[i]
            sum = sum + s.area()
            i++
        }
        sum
    }

    fn hold_shape<T: Shape>(x: T) -> T { return x }

    fn measure<T: Shape>(x: T, extra: i64) -> i64 { return x.area() + x.grown(extra) }

    let c = Circle::make(2)
    let s: Shape = c
    if s.area() != 12 { exit(1) }

    if s.grown(5) != 17 { exit(2) }

    if shape_area(c) != 12 { exit(3) }

    let p = pick_shape(1)
    if p.area() != 25 { exit(4) }
    let q = pick_shape(0)
    if q.area() != 3 { exit(5) }

    let sq = Square::make(3)
    let shapes: []Shape = [c, sq]
    if total_area(shapes) != 21 { exit(6) }

    let n: NamedShape = sq
    if n.area() != 9 { exit(7) }
    if n.shape_name() != "square" { exit(8) }

    let d = Dog::make_dog()
    let sp: Speaker = d
    if sp.speak() != "woof" { exit(9) }
    let a = Animal::make_animal(2)
    let sa: Speaker = a
    if sa.speak() != "..." { exit(10) }

    let held = hold_shape(c)
    if held.area() != 12 { exit(11) }
    if shape_area(held) != 12 { exit(12) }

    if measure(c, 5) != 29 { exit(13) }

    if measure(sq, 2) != 20 { exit(14) }

    exit(0)
    """
    When built and run
    Then exit = 0

