    /**
     * A monomorphic i64 iterator: a closure yielding the next element or `null` at exhaustion.
     * Self-contained twin of `teko::iter::IntIter` — a standalone project cannot see the compiler
     * corpus's stdlib namespaces (they are in scope only when building the compiler itself), so
     * this fixture re-declares the SAME shapes; the real module's tests live in
     * `src/iter/iter_test.tkt`. THIS fixture pins the native==VM behavior of the protocol.
     *
     * @since ITER0
     */
    pub type IntIter = () -> i64 | null

    /**
     * The half-open range cursor: the next value to yield and the exclusive upper bound. Cursors
     * live in caller-owned `mut` state and are threaded through a `ref` (the one shared-mutation
     * cell) — a `mut` captured directly by a closure is by-copy and would never advance.
     *
     * @param next  the next integer to yield
     * @param hi    the exclusive upper bound
     * @since ITER0
     */
    pub type RangeCursor = struct { next: i64; hi: i64 }

    /**
     * Iterate the half-open range `[cur.next, cur.hi)`.
     *
     * @param cur  the caller-owned range cursor
     * @return     an IntIter over the range
     * @since ITER0
     */
    pub fn range(ref cur: RangeCursor) -> IntIter {
        let it: IntIter = () => {
            if cur.next >= cur.hi { return null }
            let v = cur.next
            cur = RangeCursor { next = v + 1; hi = cur.hi }
            v
        }
        it
    }

    /**
     * Lazily map each element through `f`; stateless, so no cursor.
     *
     * @param src  the upstream iterator
     * @param f    the per-element transform
     * @return     a lazy IntIter of the transformed elements
     * @since ITER0
     */
    pub fn map(src: IntIter, f: (i64) -> i64) -> IntIter {
        let mapped: IntIter = () => {
            let nx = src()
            match nx {
                i64 as v => f(v)
                null => null
            }
        }
        mapped
    }

    /**
     * Lazily keep only elements satisfying `keep`; stateless.
     *
     * @param src   the upstream iterator
     * @param keep  the survival predicate
     * @return      a lazy IntIter of the surviving elements
     * @since ITER0
     */
    pub fn filter(src: IntIter, keep: (i64) -> bool) -> IntIter {
        let filtered: IntIter = () => {
            mut result: i64 | null = null
            loop {
                let nx = src()
                match nx {
                    i64 as v => {
                        if keep(v) { result = v; break }
                    }
                    null => break
                }
            }
            result
        }
        filtered
    }

    /**
     * The remaining-count cursor for `take`.
     *
     * @param left  how many more elements `take` may yield
     * @since ITER0
     */
    pub type TakeCursor = struct { left: i64 }

    /**
     * Yield at most `cur.left` elements, then stop WITHOUT pulling the source further (the lazy
     * cap this fixture proves).
     *
     * @param src  the upstream iterator
     * @param cur  the caller-owned remaining-count cursor
     * @return     a lazy IntIter of at most `n` leading elements
     * @since ITER0
     */
    pub fn take(src: IntIter, ref cur: TakeCursor) -> IntIter {
        let taken: IntIter = () => {
            if cur.left <= 0 { return null }
            let nx = src()
            match nx {
                i64 as v => { cur = TakeCursor { left = cur.left - 1 }; v }
                null => null
            }
        }
        taken
    }

    /**
     * The remaining-to-drop cursor for `skip`.
     *
     * @param left  how many more leading elements to discard
     * @since ITER0
     */
    pub type SkipCursor = struct { left: i64 }

    /**
     * Discard the first `cur.left` elements, then pass the rest through.
     *
     * @param src  the upstream iterator
     * @param cur  the caller-owned remaining-to-drop cursor
     * @return     a lazy IntIter with its first `n` elements dropped
     * @since ITER0
     */
    pub fn skip(src: IntIter, ref cur: SkipCursor) -> IntIter {
        let skipped: IntIter = () => {
            loop {
                if cur.left <= 0 { break }
                let dropped = src()
                match dropped {
                    i64 => cur = SkipCursor { left = cur.left - 1 }
                    null => { cur = SkipCursor { left = 0 }; return null }
                }
            }
            src()
        }
        skipped
    }

    /**
     * The which-source cursor for `chain`.
     *
     * @param first_done  whether the first iterator has yielded `null`
     * @since ITER0
     */
    pub type ChainCursor = struct { first_done: bool }

    /**
     * Concatenate two iterators: all of `a`, then all of `b`.
     *
     * @param a    the first iterator (drained first)
     * @param b    the second iterator
     * @param cur  the caller-owned which-source cursor
     * @return     a lazy IntIter over `a` followed by `b`
     * @since ITER0
     */
    pub fn chain(a: IntIter, b: IntIter, ref cur: ChainCursor) -> IntIter {
        let ch: IntIter = () => {
            if cur.first_done == false {
                let na = a()
                match na {
                    i64 as x => return x
                    null => cur = ChainCursor { first_done = true }
                }
            }
            b()
        }
        ch
    }

    /**
     * Drain the iterator, threading an accumulator through `step` (eager left fold).
     *
     * @param src   the iterator to drain
     * @param init  the starting accumulator
     * @param step  the combiner
     * @return      the final accumulator
     * @since ITER0
     */
    pub fn fold(src: IntIter, init: i64, step: (i64, i64) -> i64) -> i64 {
        mut acc = init
        loop {
            let nx = src()
            match nx {
                i64 as v => acc = step(acc, v)
                null => break
            }
        }
        acc
    }

    /**
     * Sum the elements the iterator yields.
     *
     * @param src  the iterator to drain
     * @return     the arithmetic sum
     * @since ITER0
     */
    pub fn sum(src: IntIter) -> i64 {
        mut total: i64 = 0
        loop {
            let nx = src()
            match nx {
                i64 as v => total = total + v
                null => break
            }
        }
        total
    }

    /**
     * Materialize the iterator into an `[]i64`, preserving order.
     *
     * @param src  the iterator to drain
     * @return     a slice of every element yielded, in order
     * @since ITER0
     */
    pub fn collect(src: IntIter) -> []i64 {
        mut out: []i64 = teko::list::empty()
        loop {
            let nx = src()
            match nx {
                i64 as v => out = teko::list::push(out, v)
                null => break
            }
        }
        out
    }

    /**
     * Wrap a caller-owned counter cell into an identity transform that ticks the cell on each
     * call — the instrument the laziness check reads back to prove a `map` closure ran exactly as
     * many times as the downstream `take` demanded.
     *
     * @param cell  the caller-owned tick counter
     * @return      an identity transform that ticks `cell`
     * @since ITER0
     */
    pub fn counting_identity(ref cell: i64) -> (i64) -> i64 {
        let c: (i64) -> i64 = (x: i64) => { cell = cell + 1; x }
        c
    }

    /**
     * The even predicate the checks use.
     *
     * @param x  the value to test
     * @return   true when `x` is even
     * @since ITER0
     */
    pub fn is_even(x: i64) -> bool { x % 2 == 0 }

    /**
     * The ten-times transform the composition check uses.
     *
     * @param x  the value to scale
     * @return   `x * 10`
     * @since ITER0
     */
    pub fn times_ten(x: i64) -> i64 { x * 10 }

    /**
     * The addition combiner the fold check uses.
     *
     * @param a  the running accumulator
     * @param x  the next element
     * @return   `a + x`
     * @since ITER0
     */
    pub fn add(a: i64, x: i64) -> i64 { a + x }

    /**
     * Stage 0 — sources and `collect` roundtrip: `range` yields the sequence in order.
     *
     * @return  0 on success, else a distinct failure code
     * @since ITER0
     */
    pub fn check_sources() -> i64 {
        mut rc = RangeCursor { next = 0; hi = 4 }
        let collected = collect(range(rc))
        if collected.len != 4 { return 1 }
        if collected[0] != 0 { return 2 }
        if collected[3] != 3 { return 3 }
        0
    }

    /**
     * Stage 1 — the laziness proof: a `map` closure ticking a counter, capped by `take(2)` over a
     * thousand-element range, ticks EXACTLY twice.
     *
     * @return  0 on success, else a distinct failure code
     * @since ITER0
     */
    pub fn check_laziness() -> i64 {
        mut count_cell = 0
        let ticking = counting_identity(count_cell)
        mut rc = RangeCursor { next = 0; hi = 1000 }
        mut tc = TakeCursor { left = 2 }
        let result = collect(take(map(range(rc), ticking), tc))
        if result.len != 2 { return 11 }
        if result[0] != 0 { return 12 }
        if result[1] != 1 { return 13 }
        if count_cell != 2 { return 14 }
        0
    }

    /**
     * Stage 2 — adapter correctness: `filter`, `skip`, `chain` behave.
     *
     * @return  0 on success, else a distinct failure code
     * @since ITER0
     */
    pub fn check_adapters() -> i64 {
        mut rc = RangeCursor { next = 0; hi = 6 }
        let evens = collect(filter(range(rc), is_even))
        if evens.len != 3 { return 21 }
        if evens[2] != 4 { return 22 }
        mut rc2 = RangeCursor { next = 0; hi = 5 }
        mut sc = SkipCursor { left = 2 }
        let after_skip = collect(skip(range(rc2), sc))
        if after_skip.len != 3 { return 23 }
        if after_skip[0] != 2 { return 24 }
        mut ra = RangeCursor { next = 0; hi = 2 }
        mut rb = RangeCursor { next = 10; hi = 12 }
        mut cc = ChainCursor { first_done = false }
        let chained = collect(chain(range(ra), range(rb), cc))
        if chained.len != 4 { return 25 }
        if chained[3] != 11 { return 26 }
        0
    }

    /**
     * Stage 3 — the composition payoff + terminals: `fold(map(filter(range,even),*10),0,+)` == 60.
     *
     * @return  0 on success, else a distinct failure code
     * @since ITER0
     */
    pub fn check_pipeline() -> i64 {
        mut rc = RangeCursor { next = 0; hi = 6 }
        let total = fold(map(filter(range(rc), is_even), times_ten), 0, add)
        if total != 60 { return 31 }
        mut rc2 = RangeCursor { next = 1; hi = 5 }
        if sum(range(rc2)) != 10 { return 32 }
        0
    }

    let sources_result = check_sources()
    if sources_result != 0 { exit(sources_result) }
    let laziness_result = check_laziness()
    if laziness_result != 0 { exit(laziness_result) }
    let adapters_result = check_adapters()
    if adapters_result != 0 { exit(adapters_result) }
    let pipeline_result = check_pipeline()
    if pipeline_result != 0 { exit(pipeline_result) }
    """
    When built and run
    Then exit = 0

  Scenario: json_roundtrip
    Given source inline = """
    pub type JsonNull = struct { }
    pub type JsonBool = struct { value: bool }
    pub type JsonNumber = struct { value: f64 }
    pub type JsonString = struct { value: str }
    pub type JsonArray = struct { items: []JsonValue }
    pub type JsonObject = struct { keys: []str; values: []JsonValue }

    pub type JsonValue = variant JsonNull | JsonBool | JsonNumber | JsonString | JsonArray | JsonObject

    fn is_json_ws(b: byte) -> bool {
        b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'
    }

    fn is_digit_byte(b: byte) -> bool {
        b >= b'0' && b <= b'9'
    }

    fn hex_digit_value(b: byte) -> i64 {
        if b >= b'0' && b <= b'9' { return (b to i64) - (b'0' to i64) }
        if b >= b'a' && b <= b'f' { return (b to i64) - (b'a' to i64) + 10 }
        if b >= b'A' && b <= b'F' { return (b to i64) - (b'A' to i64) + 10 }
        -1
    }

    pub type PResult = struct { pos: u64; value: JsonValue }

    fn skip_ws(p: []byte, pos: u64) -> u64 {
        mut at = pos
        loop {
            if at >= p.len || !is_json_ws(p[at]) { break }
            at++
        }
        at
    }

    fn parse_value(p: []byte, pos: u64) -> PResult | error {
        let at = skip_ws(p, pos)
        if at >= p.len { return error { message = "json: unexpected end of input" } }
        let b = p[at]
        if b == b'{' { return parse_object(p, at) }
        if b == b'[' { return parse_array(p, at) }
        if b == b'"' { return parse_string_value(p, at) }
        if b == b't' { return parse_literal(p, at, "true", JsonBool { value = true }) }
        if b == b'f' { return parse_literal(p, at, "false", JsonBool { value = false }) }
        if b == b'n' { return parse_literal(p, at, "null", JsonNull { }) }
        if b == b'-' || is_digit_byte(b) { return parse_number(p, at) }
        error { message = concat("json: unexpected character at offset ", i64_to_str(at to i64)) }
    }

    fn parse_literal(p: []byte, pos: u64, word: str, value: JsonValue) -> PResult | error {
        mut i: u64 = 0
        loop {
            if i >= word.len { break }
            if pos + i >= p.len || p[pos + i] != word[i] {
                return error { message = concat("json: invalid literal at offset ", i64_to_str(pos to i64)) }
            }
            i++
        }
        PResult { pos = pos + word.len; value = value }
    }

    fn parse_object(p: []byte, pos: u64) -> PResult | error {

        mut at = skip_ws(p, pos + 1)
        mut keys: []str = teko::list::empty()
        mut values: []JsonValue = teko::list::empty()
        if at < p.len && p[at] == b'}' { return PResult { pos = at + 1; value = JsonObject { keys = keys; values = values } } }
        loop {
            at = skip_ws(p, at)
            if at >= p.len || p[at] != b'"' {
                return error { message = concat("json: expected string key at offset ", i64_to_str(at to i64)) }
            }
            let key_res = match parse_string(p, at) { PStringResult as s => s; error as e => return e }
            at = skip_ws(p, key_res.pos)
            if at >= p.len || p[at] != b':' {
                return error { message = concat("json: expected ':' after object key at offset ", i64_to_str(at to i64)) }
            }
            let val_res = match parse_value(p, at + 1) { PResult as v => v; error as e => return e }
            keys = teko::list::push(keys, key_res.text)
            values = teko::list::push(values, val_res.value)
            at = skip_ws(p, val_res.pos)
            if at >= p.len { return error { message = "json: unterminated object — expected ',' or '}'" } }
            if p[at] == b',' { at = at + 1; continue }
            if p[at] == b'}' { return PResult { pos = at + 1; value = JsonObject { keys = keys; values = values } } }
            return error { message = concat("json: expected ',' or '}' at offset ", i64_to_str(at to i64)) }
        }
        error { message = "json: unreachable" }
    }

    fn parse_array(p: []byte, pos: u64) -> PResult | error {

        mut at = skip_ws(p, pos + 1)
        mut items: []JsonValue = teko::list::empty()
        if at < p.len && p[at] == b']' { return PResult { pos = at + 1; value = JsonArray { items = items } } }
        loop {
            let val_res = match parse_value(p, at) { PResult as v => v; error as e => return e }
            items = teko::list::push(items, val_res.value)
            at = skip_ws(p, val_res.pos)
            if at >= p.len { return error { message = "json: unterminated array — expected ',' or ']'" } }
            if p[at] == b',' { at = at + 1; continue }
            if p[at] == b']' { return PResult { pos = at + 1; value = JsonArray { items = items } } }
            return error { message = concat("json: expected ',' or ']' at offset ", i64_to_str(at to i64)) }
        }
        error { message = "json: unreachable" }
    }

    pub type PStringResult = struct { pos: u64; text: str }

    fn parse_string_value(p: []byte, pos: u64) -> PResult | error {
        let s = match parse_string(p, pos) { PStringResult as r => r; error as e => return e }
        PResult { pos = s.pos; value = JsonString { value = s.text } }
    }

    fn parse_string(p: []byte, pos: u64) -> PStringResult | error {
        mut at = pos + 1
        mut out: str = ""
        loop {
            if at >= p.len { return error { message = "json: unterminated string" } }
            let b = p[at]
            if b == b'"' { return PStringResult { pos = at + 1; text = out } }
            if b == b'\\' {
                if at + 1 >= p.len { return error { message = "json: unterminated escape sequence" } }
                let esc = p[at + 1]
                if esc == b'"' { out = out ~ one_byte(b'"'); at = at + 2; continue }
                if esc == b'\\' { out = out ~ one_byte(b'\\'); at = at + 2; continue }
                if esc == b'/' { out = out ~ one_byte(b'/'); at = at + 2; continue }
                if esc == b'b' { out = out ~ one_byte(0x08 to byte); at = at + 2; continue }
                if esc == b'f' { out = out ~ one_byte(0x0C to byte); at = at + 2; continue }
                if esc == b'n' { out = out ~ one_byte(b'\n'); at = at + 2; continue }
                if esc == b'r' { out = out ~ one_byte(b'\r'); at = at + 2; continue }
                if esc == b't' { out = out ~ one_byte(b'\t'); at = at + 2; continue }
                if esc == b'u' {
                    let step = match parse_unicode_escape(p, at) { UEscResult as u => u; error as e => return e }
                    out = out ~ step.text
                    at = step.pos
                    continue
                }
                return error { message = concat("json: invalid escape sequence at offset ", i64_to_str(at to i64)) }
            }
            if b < 0x20 to byte {
                return error { message = concat("json: raw control character in string at offset ", i64_to_str(at to i64)) }
            }

            out = out ~ one_byte(b)
            at = at + 1
        }
        error { message = "json: unreachable" }
    }

    pub type UEscResult = struct { pos: u64; text: str }

    fn parse_unicode_escape(p: []byte, pos: u64) -> UEscResult | error {
        let cp1 = match read_hex4(p, pos + 2) { i64 as v => v; error as e => return e }

        if cp1 >= 0xD800 && cp1 <= 0xDBFF {
            if pos + 6 + 1 < p.len && p[pos + 6] == b'\\' && p[pos + 7] == b'u' {
                let cp2 = match read_hex4(p, pos + 8) { i64 as v => v; error as e => return e }
                if cp2 >= 0xDC00 && cp2 <= 0xDFFF {
                    let astral = 0x10000 + ((cp1 - 0xD800) * 0x400) + (cp2 - 0xDC00)
                    return UEscResult { pos = pos + 12; text = codepoint_to_str(astral) }
                }
            }
            return error { message = "json: unpaired UTF-16 high surrogate in \\u escape" }
        }
        if cp1 >= 0xDC00 && cp1 <= 0xDFFF {
            return error { message = "json: unpaired UTF-16 low surrogate in \\u escape" }
        }
        UEscResult { pos = pos + 6; text = codepoint_to_str(cp1) }
    }

    fn read_hex4(p: []byte, pos: u64) -> i64 | error {
        if pos + 4 > p.len { return error { message = "json: truncated \\u escape" } }
        mut v: i64 = 0
        mut i: u64 = 0
        loop {
            if i >= 4 { break }
            let d = hex_digit_value(p[pos + i])
            if d < 0 { return error { message = "json: invalid hex digit in \\u escape" } }
            v = (v * 16) + d
            i++
        }
        v
    }

    fn codepoint_to_str(cp: i64) -> str {
        if cp <= 0x7F {
            one_byte(cp to byte)
        } else if cp <= 0x7FF {
            let b0 = (0xC0 | (cp >> 6)) to byte
            let b1 = (0x80 | (cp & 0x3F)) to byte
            one_byte(b0) ~ one_byte(b1)
        } else if cp <= 0xFFFF {
            let b0 = (0xE0 | (cp >> 12)) to byte
            let b1 = (0x80 | ((cp >> 6) & 0x3F)) to byte
            let b2 = (0x80 | (cp & 0x3F)) to byte
            one_byte(b0) ~ one_byte(b1) ~ one_byte(b2)
        } else {
            let b0 = (0xF0 | (cp >> 18)) to byte
            let b1 = (0x80 | ((cp >> 12) & 0x3F)) to byte
            let b2 = (0x80 | ((cp >> 6) & 0x3F)) to byte
            let b3 = (0x80 | (cp & 0x3F)) to byte
            one_byte(b0) ~ one_byte(b1) ~ one_byte(b2) ~ one_byte(b3)
        }
    }

    fn parse_number(p: []byte, pos: u64) -> PResult | error {
        mut at = pos
        mut negative = false
        if at < p.len && p[at] == b'-' { negative = true; at = at + 1 }
        if at >= p.len || !is_digit_byte(p[at]) {
            return error { message = concat("json: invalid number at offset ", i64_to_str(pos to i64)) }
        }

        if p[at] == b'0' {
            at = at + 1
        } else {
            loop {
                if at >= p.len || !is_digit_byte(p[at]) { break }
                at++
            }
        }
        mut has_frac = false
        mut frac_start: u64 = 0
        mut frac_end: u64 = 0
        if at < p.len && p[at] == b'.' {
            has_frac = true
            at = at + 1
            frac_start = at
            if at >= p.len || !is_digit_byte(p[at]) {
                return error { message = "json: expected digit after '.' in number" }
            }
            loop {
                if at >= p.len || !is_digit_byte(p[at]) { break }
                at++
            }
            frac_end = at
        }
        mut has_exp = false
        mut exp_negative = false
        mut exp_start: u64 = 0
        mut exp_end: u64 = 0
        if at < p.len && (p[at] == b'e' || p[at] == b'E') {
            has_exp = true
            at = at + 1
            if at < p.len && (p[at] == b'+' || p[at] == b'-') {
                exp_negative = p[at] == b'-'
                at = at + 1
            }
            exp_start = at
            if at >= p.len || !is_digit_byte(p[at]) {
                return error { message = "json: expected digit in number exponent" }
            }
            loop {
                if at >= p.len || !is_digit_byte(p[at]) { break }
                at++
            }
            exp_end = at

            if exp_end - exp_start > 6 {
                return error { message = "json: number exponent has too many digits" }
            }
        }
        let sign_width = if negative { 1 to u64 } else { 0 to u64 }
        let int_text = str_slice_bytes(p, pos + sign_width, int_end_of(p, pos, negative))
        mut mantissa = digits_to_f64(int_text)
        if has_frac {
            let frac_text = str_slice_bytes(p, frac_start, frac_end)
            mantissa = mantissa + (digits_to_f64(frac_text) / pow10(frac_end - frac_start))
        }
        if negative { mantissa = -mantissa }
        if has_exp {
            let exp_text = str_slice_bytes(p, exp_start, exp_end)
            mut exp_val = digits_to_i64(exp_text)
            if exp_negative { exp_val = -exp_val }
            mantissa = mantissa * pow10_signed(exp_val)
        }
        PResult { pos = at; value = JsonNumber { value = mantissa } }
    }

    fn int_end_of(p: []byte, pos: u64, negative: bool) -> u64 {
        let sign_width = if negative { 1 to u64 } else { 0 to u64 }
        mut at = pos + sign_width
        if at < p.len && p[at] == b'0' { return at + 1 }
        loop {
            if at >= p.len || !is_digit_byte(p[at]) { break }
            at++
        }
        at
    }

    fn str_slice_bytes(p: []byte, from: u64, to_pos: u64) -> str {
        mut out: str = ""
        mut i = from
        loop {
            if i >= to_pos { break }
            out = out ~ one_byte(p[i])
            i++
        }
        out
    }

    fn digits_to_f64(digits: str) -> f64 {
        mut v: f64 = 0.0
        mut i: u64 = 0
        loop {
            if i >= digits.len { break }
            let d = ((digits[i] to i64) - (b'0' to i64)) to f64
            v = (v * 10.0) + d
            i++
        }
        v
    }

    fn digits_to_i64(digits: str) -> i64 {
        mut v: i64 = 0
        mut i: u64 = 0
        loop {
            if i >= digits.len { break }
            let d = (digits[i] to i64) - (b'0' to i64)
            v = (v * 10) + d
            i++
        }
        v
    }

    fn pow10(n: u64) -> f64 {
        mut v: f64 = 1.0
        mut i: u64 = 0
        loop {
            if i >= n { break }
            v = v * 10.0
            i++
        }
        v
    }

    fn pow10_signed(n: i64) -> f64 {
        if n >= 0 { return pow10(n to u64) }
        1.0 / pow10((-n) to u64)
    }

    pub fn decode(text: str) -> JsonValue | error {
        let bytes = bytes_of_str(text)
        let result = match parse_value(bytes, 0) { PResult as r => r; error as e => return e }
        let after = skip_ws(bytes, result.pos)
        if after != bytes.len {
            return error { message = concat("json: unexpected trailing input at offset ", i64_to_str(after to i64)) }
        }
        result.value
    }

    pub fn encode(value: JsonValue) -> str {
        match value {
            JsonNull => "null"
            JsonBool as b => if b.value { "true" } else { "false" }
            JsonNumber as n => encode_number(n.value)
            JsonString as s => encode_string(s.value)
            JsonArray as a => encode_array(a.items)
            JsonObject as o => encode_object(o.keys, o.values)
        }
    }

    fn encode_array(items: []JsonValue) -> str {
        mut out = "["
        mut i: u64 = 0
        loop {
            if i >= items.len { break }
            if i > 0 { out = out ~ "," }
            out = out ~ encode(items[i])
            i++
        }
        out ~ "]"
    }

    fn encode_object(keys: []str, values: []JsonValue) -> str {
        mut out = "{"
        mut i: u64 = 0
        loop {
            if i >= keys.len { break }
            if i > 0 { out = out ~ "," }
            out = out ~ encode_string(keys[i]) ~ ":" ~ encode(values[i])
            i++
        }
        out ~ "}"
    }

    fn encode_string(s: str) -> str {
        mut out = "\""
        mut i: u64 = 0
        loop {
            if i >= s.len { break }
            let b = s[i]
            if b == b'"' { out = out ~ "\\\""; i++; continue }
            if b == b'\\' { out = out ~ "\\\\"; i++; continue }
            if b == b'\n' { out = out ~ "\\n"; i++; continue }
            if b == b'\r' { out = out ~ "\\r"; i++; continue }
            if b == b'\t' { out = out ~ "\\t"; i++; continue }
            if b == 0x08 to byte { out = out ~ "\\b"; i++; continue }
            if b == 0x0C to byte { out = out ~ "\\f"; i++; continue }
            if b < 0x20 to byte {
                out = out ~ "\\u" ~ hex4_of(b to i64)
                i++
                continue
            }
            out = out ~ one_byte(b)
            i++
        }
        out ~ "\""
    }

    fn hex4_of(v: i64) -> str {
        one_byte(hex_nibble(((v >> 12) & 0xF))) ~ one_byte(hex_nibble(((v >> 8) & 0xF))) ~ one_byte(hex_nibble(((v >> 4) & 0xF))) ~ one_byte(hex_nibble(v & 0xF))
    }

    fn hex_nibble(v: i64) -> byte {
        if v < 10 { return ((b'0' to i64) + v) to byte }
        ((b'a' to i64) + (v - 10)) to byte
    }

    fn encode_number(v: f64) -> str {
        if v == (v to i64 to f64) && v >= -9223372036854775808.0 && v <= 9223372036854775807.0 {
            return i64_to_str(v to i64)
        }
        encode_float_fixed(v)
    }

    fn encode_float_fixed(v: f64) -> str {
        mut x = v
        mut sign = ""
        if x < 0.0 { sign = "-"; x = -x }
        let int_part = x to i64
        mut frac = x - (int_part to f64)
        mut digits = ""
        mut i: u64 = 0
        loop {
            if i >= 9 { break }
            frac = frac * 10.0
            let d = frac to i64
            digits = digits ~ one_byte(((b'0' to i64) + d) to byte)
            frac = frac - (d to f64)
            i++
        }
        let trimmed = trim_trailing_zeros(digits)
        if trimmed.len == 0 { return sign ~ i64_to_str(int_part) }
        sign ~ i64_to_str(int_part) ~ "." ~ trimmed
    }

    fn trim_trailing_zeros(digits: str) -> str {
        mut end = digits.len
        loop {
            if end == 0 || digits[end - 1] != b'0' { break }
            end--
        }
        str_slice_chars(digits, 0, end to i64)
    }

    pub fn object_get(obj: JsonObject, key: str) -> JsonValue | null {
        mut i: u64 = 0
        loop {
            if i >= obj.keys.len { break }
            if str_eq(obj.keys[i], key) { return obj.values[i] }
            i++
        }
        null
    }

    fn str_eq(a: str, b: str) -> bool {
        if a.len != b.len { return false }
        mut i: u64 = 0
        loop {
            if i >= a.len { break }
            if a[i] != b[i] { return false }
            i++
        }
        true
    }

    pub fn array_get(arr: JsonArray, index: u64) -> JsonValue | null {
        if index >= arr.items.len { return null }
        arr.items[index]
    }

    fn bool_to_i64(b: bool) -> i64 {
        if b { 1 } else { 0 }
    }

    fn str_equal(a: str, b: str) -> bool {
        if a.len != b.len { return false }
        mut i: u64 = 0
        loop {
            if i >= a.len { break }
            if a[i] != b[i] { return false }
            i++
        }
        true
    }

    pub fn check_ops() -> i64 {
        let doc = "{\"name\":\"Ada\",\"age\":36,\"score\":-3.5,\"active\":true,\"nothing\":null,\"tags\":[\"x\",\"y\\\"z\"],\"nested\":{\"e\":1.5e2,\"esc\":\"a\\nb\\tc\"}}"

        let value = match decode(doc) {
            JsonValue as v => v
            error => JsonNull { }
        }

        let c1 = match value {
            JsonObject as o => bool_to_i64(o.keys.len == 7)
            _ => 0
        }

        let c2 = match value {
            JsonObject as o => match object_get(o, "name") {
                JsonValue as v => match v {
                    JsonString as s => bool_to_i64(str_equal(s.value, "Ada"))
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let c3 = match value {
            JsonObject as o => match object_get(o, "score") {
                JsonValue as v => match v {
                    JsonNumber as n => bool_to_i64(n.value == -3.5)
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let c4 = match value {
            JsonObject as o => match object_get(o, "tags") {
                JsonValue as v => match v {
                    JsonArray as a => match array_get(a, 1) {
                        JsonValue as v2 => match v2 {
                            JsonString as s => bool_to_i64(str_equal(s.value, "y\"z"))
                            _ => 0
                        }
                        null => 0
                    }
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let c5 = match value {
            JsonObject as o => match object_get(o, "nested") {
                JsonValue as v => match v {
                    JsonObject as inner => match object_get(inner, "e") {
                        JsonValue as v2 => match v2 {
                            JsonNumber as n => bool_to_i64(n.value == 150.0)
                            _ => 0
                        }
                        null => 0
                    }
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let c6 = match value {
            JsonObject as o => match object_get(o, "nested") {
                JsonValue as v => match v {
                    JsonObject as inner => match object_get(inner, "esc") {
                        JsonValue as v2 => match v2 {
                            JsonString as s => bool_to_i64(str_equal(s.value, "a\nb\tc"))
                            _ => 0
                        }
                        null => 0
                    }
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let c7 = match value {
            JsonObject as o => match object_get(o, "nothing") {
                JsonValue as v => match v {
                    JsonNull => 1
                    _ => 0
                }
                null => 0
            }
            _ => 0
        }

        let encoded1 = encode(value)
        let value2 = match decode(encoded1) {
            JsonValue as v => v
            error => JsonNull { }
        }
        let encoded2 = encode(value2)
        let c8 = bool_to_i64(str_equal(encoded1, encoded2))

        let c9 = match decode("{\"a\": }") {
            JsonValue => 0
            error => 1
        }

        c1 + c2 + c3 + c4 + c5 + c6 + c7 + c8 + c9
    }

    (check_ops()) to i32
    """
    When built and run
    Then exit = 9

