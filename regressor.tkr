Feature: F2 language corpus — batch 2, the full remaining language/const/ownership corpus (dobrado, dir removido)

  Scenario: adopt_cyclic_bulk_drop
    Given source inline = """
    /**
     * Node — a class whose `peer` field points at another Node, so two instances can form a MUTUAL
     * back-edge cycle. Each `class` object opens its own arena-per-object child region; when built
     * directly inside an `adopt { }` block those child regions parent under the adopter, and the
     * closing brace's subtree-drop reclaims the whole knot at once (cycles irrelevant).
     *
     * @field id    a small identity, printed to make the run deterministic.
     * @field peer  the mutually-referenced Node (null until linked) — the cycle edge.
     */
    type Node = class {
        id: i64
        peer: Node | null

        /**
         * cyclic_bulk_drop — build a two-node cycle inside `adopt { }`, print it, and let the brace
         * bulk-drop the subtree. The mutual back-edges (`a.peer = b`, `b.peer = a`) make a cycle no
         * per-object free could reclaim; the adopter's subtree-drop reclaims it wholesale.
         *
         * @return  the sum of the two ids (a deterministic value the driver checks).
         */
        pub fn cyclic_bulk_drop() -> i64 {
            mut total: i64 = 0
            adopt {
                let a = Node { id = 1; peer = null }
                let b = Node { id = 2; peer = null }
                a.peer = b
                b.peer = a
                total = a.id + b.id
                teko::io::write($"cycle {a.id}-{b.id}\n")
            }
            total
        }

        /**
         * nested_adopt — an `adopt` whose body itself contains an `adopt`. The inner adopter is a
         * child region of the outer; the outer brace's subtree-drop reclaims both nested subtrees in
         * one sweep (no double-free, no leak).
         *
         * @return  a deterministic marker value.
         */
        pub fn nested_adopt() -> i64 {
            mut marker: i64 = 0
            adopt {
                let outer = Node { id = 10; peer = null }
                adopt {
                    let inner = Node { id = 20; peer = null }
                    outer.peer = inner
                    marker = outer.id + inner.id
                    teko::io::write($"nested {outer.id}-{inner.id}\n")
                }
            }
            marker
        }

        /**
         * named_adopt — an `adopt r { }` with a bound name. The name is a parse/codegen label in this
         * increment (no handle surface yet); the region is opened and subtree-dropped exactly as an
         * anonymous adopter would be.
         *
         * @return  a deterministic marker value.
         */
        pub fn named_adopt() -> i64 {
            mut marker: i64 = 0
            adopt r {
                let n = Node { id = 30; peer = null }
                marker = n.id
                teko::io::write($"named {n.id}\n")
            }
            marker
        }
    }

    if Node::cyclic_bulk_drop() != 3 { exit(1) }
    if Node::nested_adopt() != 30 { exit(2) }
    if Node::named_adopt() != 30 { exit(3) }
    """
    When built and run
    Then exit = 0

  Scenario: arena_commit_keeps_alloc
    Given source inline = """
    /**
     * Build a `[]i64` DURING an open `teko::arena_push()` checkpoint, `teko::arena_commit()` the
     * checkpoint (the Boundary-A "keep" path, as opposed to `teko::arena_pop()`'s "rewind" path), and
     * read the built slice back — proving `arena_commit` never reclaims data allocated during the
     * span it discards. A further, unrelated allocation made AFTER the commit proves the root region
     * is still fully functional (the commit's mark bookkeeping does not corrupt subsequent bumps).
     *
     * @return the sum `10 + 20 + 30 + 1 = 61`
     */
    pub fn build_sum() -> i64 {
        teko::arena_push()
        mut xs: []i64 = teko::list::empty()
        xs = teko::list::push(xs, 10)
        xs = teko::list::push(xs, 20)
        xs = teko::list::push(xs, 30)
        teko::arena_commit()

        mut sum: i64 = 0
        mut i: u64 = 0
        loop {
            if i >= xs.len { break }
            sum = sum + xs[i]
            i = i + 1
        }

        mut ys: []i64 = teko::list::empty()
        ys = teko::list::push(ys, 1)
        sum + ys[0]
    }

    exit(build_sum())
    """
    When built and run
    Then exit = 61

  Scenario: arena_manual_ok
    Given source inline = """
    /**
     * A LOCAL COPY of the S3 (`teko::mem::unsafe`, issue #358) `Arena` shape, WITH the `#must_free`
     * and `unsafe` modifiers (this fixture is compiled by gen1/native, never the released seed, so
     * both markers are available here — unlike the stdlib module itself, which stages them off until a
     * seed refresh; see src/mem/unsafe/arena.tks's header). Mirrors the unsafe_rawbuf_roundtrip
     * convention: a regression fixture is its own standalone project, so it self-contains the shape it
     * exercises.
     *
     * The dev-controlled, non-lexical MANUAL region: `Arena::new` opens a fresh child region
     * (`region_new` -> tk_region_new), `region_alloc` bump-allocates a `ptr<T>` into it, and
     * `teko::mem::free(a)` bulk-drops the whole subtree (tk_region_drop_subtree). `#must_free` bars the
     * region leak (a compile error if dropped unfreed — arena_manual_leak); `unsafe` contains the
     * residual dangling-`ptr<T>`-after-free risk the dev owns. The handle carries the raw `tk_region *`
     * as an opaque `uptr` — the single field the checker's `is_region_handle_name` probe recognizes.
     */
    #must_free
    pub unsafe type Arena = struct {
        /** The raw `tk_region *` this handle owns, carried as an opaque `uptr`; 0 once bulk-freed. */
        region: uptr

        /**
         * Opens a fresh manual region (a new child of the process root) and wraps its raw handle. The
         * method inherits its owning type's `unsafe`-ness; the returned `Arena` is `#must_free`.
         *
         * @return a fresh `Arena` owning a newly opened child region
         */
        pub fn new() -> Arena {
            Arena { region = teko::mem::region_new() }
        }
    }

    /**
     * Allocates a single `u64` INTO the arena, reads its low byte back through the raw `ptr<u64>`
     * (`bytes_from_ptr`, the one boundary crossing that copies region bytes into a safe `[]byte`), and
     * frees the whole region via a `defer { teko::mem::free(a) }` — the canonical `#must_free` cleanup
     * idiom, satisfying the consume on the fn's single exit path. `unsafe fn` because it binds a local
     * of the `unsafe type Arena`. For `value = 42` the low byte reads back 42.
     *
     * @param value the `u64` to allocate and read back through the region pointer
     * @return      the low byte of `value`, read back through the `ptr<u64>` before the region is freed
     */
    pub unsafe fn via_defer(value: u64) -> i32 {
        mut a = Arena::new()
        defer { teko::mem::free(a) }
        let p = teko::mem::region_alloc(a.region, value)
        let back = teko::mem::bytes_from_ptr(p, 1)
        back[0] to i32
    }

    /**
     * Allocates a single `u64` INTO the arena, reads its low byte back through the raw `ptr<u64>`, then
     * frees the region on BOTH arms of the `if` (AC#4 — every branch consumes the `#must_free` handle):
     * the `flag`-true arm returns the read-back byte, the false arm returns 0. `unsafe fn` because it
     * binds a local of the `unsafe type Arena`.
     *
     * @param flag  selects the arm: true reads the value back, false returns 0
     * @param value the `u64` to allocate into the region
     * @return      the low byte of `value` (flag true) or 0 (flag false), each after bulk-freeing
     */
    pub unsafe fn via_branches(flag: bool, value: u64) -> i32 {
        mut a = Arena::new()
        let p = teko::mem::region_alloc(a.region, value)
        let back = teko::mem::bytes_from_ptr(p, 1)
        if flag {
            teko::mem::free(a)
            back[0] to i32
        } else {
            teko::mem::free(a)
            0
        }
    }

    /**
     * Sums the three manual-region sub-results — the deterministic fixture sentinel. The defer path
     * reads back 42, the if-true arm reads back 20, the if-false arm returns 0: 42 + 20 + 0 = 62.
     * `unsafe fn` because it calls the `unsafe fn`s that name the `unsafe type Arena`.
     *
     * @return the exit sentinel, 62
     */
    pub unsafe fn total() -> i32 {
        let x = via_defer(42)
        let y = via_branches(true, 20)
        let z = via_branches(false, 20)
        x + y + z
    }

    total()
    """
    When built and run
    Then exit = 62

