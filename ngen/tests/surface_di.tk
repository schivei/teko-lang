// surface_di.tk -- §58 DI1 (D229): a class names a service lifetime in its
// own `:` list, and `inject` resolves it at comptime, no runtime container.
//
// Clock names IServiceSingleton -- a marker, never a base or an interface --
// and answers to TWO keys: the interface it implements, and its own concrete
// name. Both injections below land on the SAME object: `tick()` keeps
// counting across the two, and `rt_live()` never rises past the one instance
// the program ever allocates -- the singleton is a root, never released.
//
// expect-exit: 42

#include "../lib/rt.mc"

interface IClock {
    i64 tick();
}

class Clock : IClock, IServiceSingleton {
    i64 n;

    public i64 tick() {
        n = n + 1;
        return n;
    }
}

i64 main() {
    IClock a = inject IClock;
    Clock b = inject Clock;
    if (a.tick() != 1) return 1;
    if (b.tick() != 2) return 2;
    if (rt_live() != 1) return 3;
    return 42;
}
