// surface_refout.tk -- `ref T` and `out T` (K2, D221 §41): C#'s by-reference
// parameter forms, over a side table of the pointee a parameter's own node
// carries (teko_ref.mc).
//
// What each helper proves, in order:
//
//   1. `scheck` -- a scalar `ref` (`bump(ref i64 x)`) mutates the caller's
//      own local, unlike the by-value overload of the same name
//      (`bump(i64 x)`), which `teko_over.mc` resolves by the argument's own
//      `ref` tag, not merely its type; `split(v, out hi, out lo)` writes
//      both `out` parameters; `f(i64)`/`f(ref i64)` resolve the same way.
//   2. `fcheck` -- `ref` over a field (`bump(ref p.x)`) and over a local
//      array element (`bump(ref a[1])`), the two addresses `teko_expr.mc`'s
//      field store and `teko_array.mc`'s own `tk_arr_addr` already build.
//   3. `mcheck` -- `ref` as a METHOD parameter (`Doubler.twice`).
//   4. `rcheck` -- a `ref` of COUNTED (class) pointee: `replace` reassigns
//      the caller's own `Cell`, `rt_live()`/the destructor prove the old one
//      is released exactly once, through `rt_store`'s own old-value
//      `rc_dec` -- the one exception `teko_rc.mc`'s `tk_rc_assign` grew.
//
// expect-exit: 42

#include "../lib/rt.mc"

void bump(i64 x) {
    x = x + 1;
}

void bump(ref i64 x) {
    x = x + 1;
}

void split(i64 v, out i64 hi, out i64 lo) {
    hi = v / 10;
    lo = v % 10;
}

i64 f(i64 k) {
    return k;
}

i64 f(ref i64 k) {
    k = k + 100;
    return k;
}

i64 scheck() {
    i64 a = 1;
    bump(a);
    if (a != 1) return 1;
    bump(ref a);
    if (a != 2) return 2;

    i64 hi = 0;
    i64 lo = 0;
    split(57, out hi, out lo);
    if (hi != 5) return 3;
    if (lo != 7) return 4;

    i64 z = 1;
    if (f(z) != 1) return 5;
    if (z != 1) return 6;
    if (f(ref z) != 101) return 7;
    if (z != 101) return 8;
    return 0;
}

class Point {
    public i64 x;
    public i64 y;
}

i64 fcheck() {
    Point p = new Point;
    p.x = 10;
    bump(ref p.x);
    if (p.x != 11) return 1;

    i64 a[3];
    a[0] = 1;
    a[1] = 2;
    a[2] = 3;
    bump(ref a[1]);
    if (a[1] != 3) return 2;
    if (a[0] != 1) return 3;
    if (a[2] != 3) return 4;
    return 0;
}

class Doubler {
    public void twice(ref i64 v) {
        v = v * 2;
    }
}

i64 mcheck() {
    Doubler d = new Doubler;
    i64 y = 5;
    d.twice(ref y);
    if (y != 10) return 1;
    return 0;
}

i64 cell_dtors = 0;

class Cell {
    public i64 v;

    public Cell(i64 x) {
        v = x;
    }

    ~Cell() {
        cell_dtors = cell_dtors + 1;
    }
}

void replace(ref Cell c, i64 nv) {
    c = new Cell(nv);
}

i64 rcheck() {
    Cell c = new Cell(1);
    replace(ref c, 5);
    if (c.v != 5) return 1;
    if (cell_dtors != 1) return 2;                // the original Cell(1), released on reassignment
    c = null;
    if (cell_dtors != 2) return 3;
    return 0;
}

i64 main() {
    i64 bad = scheck();
    if (bad != 0) return 10 + bad;

    bad = fcheck();
    if (bad != 0) return 20 + bad;
    if (rt_live() != 0) return 25;

    bad = mcheck();
    if (bad != 0) return 30 + bad;
    if (rt_live() != 0) return 35;

    bad = rcheck();
    if (bad != 0) return 40 + bad;
    if (rt_live() != 0) return 45;
    if (cell_dtors != 2) return 50 + cell_dtors;

    return 42;
}
