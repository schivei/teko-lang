// types_class.tk -- `class` (entrega 3, D214): word 0 of the object is the
// vtable, fields are laid out base-first (SHAPE_SIDE at 8 stays at 8 in
// Square, whose own field lands after it), a plain method is a direct call and
// a `virtual`/`override` pair dispatches through the vtable -- `s.area()` on a
// name declared `Shape` runs `square_area` when the object is a Square.
//
// expect-exit: 42

#include "../lib/rt.mc"

class Shape {
    i64 side;

    i64 twice(self) {
        return self.side * 2;
    }

    virtual i64 area(self) {
        return self.side;
    }

    virtual i64 scaled(self, i64 k) {
        return self.area() * k;
    }
}

class Square : Shape {
    i64 tag;

    override i64 area(self) {
        return self.side * self.side;
    }
}

i64 area_of(Shape s) {
    return s.area();
}

i64 main() {
    if (SHAPE_SIDE != 8) return 1;
    if (SHAPE_SIZE != 16) return 2;
    if (SQUARE_TAG != 16) return 3;
    if (SQUARE_SIZE != 24) return 4;

    Shape p = new Shape;
    p.side = 3;
    if (p.area() != 3) return 5;
    if (p.twice() != 6) return 6;
    if (p.scaled(2) != 6) return 7;

    Square q = new Square;
    q.side = 5;
    q.tag = 1;
    if (q.area() != 25) return 8;
    if (q.twice() != 10) return 9;

    Shape r = new Square;
    r.side = 4;
    if (r.area() != 16) return 10;               // the override, through the vtable
    if (r.scaled(2) != 32) return 11;            // an inherited virtual calling it
    if (area_of(r) != 16) return 12;             // ...and through a parameter

    return p.area() + q.area() + r.area() - 2;
}
