// surface_panic_null.tk -- calling a NULL delegate (K1, D221 §41): a panic,
// not a segfault. `f(1, 2)` rebaixes to `callp(tk_deleg_code(f), f, 1, 2)`
// (teko_deleg.mc), and `tk_deleg_code` (ngen/lib/rt.mc) checks the object
// before ever reading its code pointer, through the same surface `panic`
// (ngen/lib/rt.mc) a program may call directly.
//
// expect-exit: 70

#include "../lib/rt.mc"

delegate i64 Op(i64 a, i64 b);

i64 main() {
    Op f = null;
    return f(1, 2);
}
