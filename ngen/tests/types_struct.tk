// types_struct.tk -- `struct` (entrega 3, D214: primitivas -> tipos): the
// declaration, the `#define` of every field's offset, `new` and the C-like
// `p.field` / `p.field = e` that teko_struct.mc/teko_expr.mc teach. The three
// fields are deliberately of three different widths, so the offsets below are
// the natural alignment (u8 at 0, i64 at 8 and not at 1, u32 at 16) and not a
// coincidence; `Line` proves a field can be another struct and that `l.a.x`
// chains through it.
//
// expect-exit: 42

#include "../lib/rt.mc"

struct Point {
    u8  tag;
    i64 x;
    u32 y;
}

struct Line {
    Point a;
    i64   len;
}

i64 main() {
    if (POINT_TAG != 0) return 1;
    if (POINT_X != 8) return 2;
    if (POINT_Y != 16) return 3;
    if (POINT_SIZE != 24) return 4;
    if (LINE_LEN != 8) return 5;

    Point p = new Point;
    if (p.x != 0) return 6;                  // rt_alloc hands out zeroed bytes
    p.tag = 2;
    p.x = 30;
    p.y = 10;

    Line l = new Line();
    l.a = p;
    l.len = 0;
    return l.a.x + l.a.y + l.a.tag + l.len;
}
