namespace teko

/**
 * A string type represented as a slice of bytes.
 */
exp global type str = class Array<char> {
    pub get bytes(enc: Encoding = Encoding::UTF8): []byte {
        var b: [self.len * 4]byte = []
        var s: usize = 0
        for i in 0..self.len {
            let c = self[i]
            let encoded = c.encode(enc)
            for j in 0..encoded.len {
                b[s + j] = encoded[j]
            }
            s += encoded.len
        }
        return b
    }

    pub fn ends_with(suffix: self): bool {
        if suffix.len > self.len {
            return false
        }

        var ends = self.slice(self.len - suffix.len, suffix.len)

        return ends == suffix
    }
}
