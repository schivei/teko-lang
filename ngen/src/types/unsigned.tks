override namespace teko

exp global type unsigned = interface number {}

exp global type u8 = struct unsigned {
    pub const __SIZE_OF: usize = 1

    pub static get MAX(): Self {
        return 0xFF
    }
    pub static get MIN(): Self {
        return 0
    }
}
exp global type u16 = struct unsigned {
    pub const __SIZE_OF: usize = 2

    pub static get MAX(): Self {
        return 0xFFFF
    }
    pub static get MIN(): Self {
        return 0
    }
}
exp global type u32 = struct unsigned {
    pub const __SIZE_OF: usize = 4

    pub static get MAX(): Self {
        return 0xFFFFFFFF
    }
    pub static get MIN(): Self {
        return 0
    }
}
exp global type u64 = struct unsigned {
    pub const __SIZE_OF: usize = 8

    pub static get MAX(): Self {
        return 0xFFFFFFFFFFFFFFFF
    }
    pub static get MIN(): Self {
        return 0
    }
}

#if WORD_64
exp global type usize = struct unsigned {
    pub const __SIZE_OF: usize = 8

    pub static get MAX(): Self {
        return u64::MAX
    }
    pub static get MIN(): Self {
        return 0
    }
}
#else
exp global type usize = struct unsigned {
    pub const __SIZE_OF: usize = 4

    pub static get MAX(): Self {
        return u32::MAX
    }
    pub static get MIN(): Self {
        return 0
    }
}
#endif

exp global type uptr = struct unsigned {
    pub const __SIZE_OF: usize = usize::__SIZE_OF
    
    pub static get MAX(): Self {
        return usize::MAX
    }
    pub static get MIN(): Self {
        return 0
    }
}
