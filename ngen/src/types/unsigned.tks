override namespace teko

exp global primitive byte : unsigned {
    exp const __SIZE_OF: usize = 1
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 1
    exp const __NAME: str = "byte"

    exp static get MAX: self {
        return 0xFF
    }
    exp static get MIN: self {
        return 0
    }
}

exp global primitive u8 : unsigned {
    exp const __SIZE_OF: usize = 1
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 1
    exp const __NAME: str = "u8"

    exp static get MAX: self {
        return 0xFF
    }
    exp static get MIN: self {
        return 0
    }
}
exp global primitive u16 : unsigned {
    exp const __SIZE_OF: usize = 2
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 2
    exp const __NAME: str = "u16"

    exp static get MAX: self {
        return 0xFFFF
    }
    exp static get MIN: self {
        return 0
    }
}
exp global primitive u32 : unsigned {
    exp const __SIZE_OF: usize = 4
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 4
    exp const __NAME: str = "u32"

    exp static get MAX: self {
        return 0xFFFFFFFF
    }
    exp static get MIN: self {
        return 0
    }
}
exp global primitive u64 : unsigned {
    exp const __SIZE_OF: usize = 8
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 8
    exp const __NAME: str = "u64"

    exp static get MAX: self {
        return 0xFFFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return 0
    }
}
exp global primitive u128 : unsigned {
    exp const __SIZE_OF: usize = 16
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 16
    exp const __NAME: str = "u128"

    exp static get MAX: self {
        return 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return 0
    }
}

#if WORD_64
exp global primitive usize : u64, unsigned {
    exp override const __NAME: str = "usize"
}

#if !HAS_METADATA
exp global primitive uptr : u128, unsigned {
    exp override const __NAME: str = "uptr"
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = "uptr"
}
#endif

#elseif WORD_32
exp global primitive usize : u32, unsigned {
    exp override const __NAME: str = "usize"
}

#if !HAS_METADATA
exp global primitive uptr : u64, unsigned {
    exp override const __NAME: str = "uptr"
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = "uptr"
}
#endif

#elseif WORD_16
exp global primitive usize : u16, unsigned {
    exp override const __NAME: str = "usize"
}

#if !HAS_METADATA
exp global primitive uptr : u32, unsigned {
    exp override const __NAME: str = "uptr"
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = "uptr"
}
#endif

#else
exp global primitive usize : u8, unsigned {
    exp override const __NAME: str = "usize"
}

#if !HAS_METADATA
exp global primitive uptr : u16, unsigned {
    exp override const __NAME: str = "uptr"
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = "uptr"
}
#endif

#endif
