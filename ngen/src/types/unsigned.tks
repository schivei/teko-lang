override namespace teko

exp global primitive byte : unsigned = "byte" {
    pub const __SIZE_OF: usize = 1

    pub static get MAX: self {
        return 0xFF
    }
    pub static get MIN: self {
        return 0
    }
}

exp global primitive u8 : unsigned = "u8" {
    pub const __SIZE_OF: usize = 1

    pub static get MAX: self {
        return 0xFF
    }
    pub static get MIN: self {
        return 0
    }
}
exp global primitive u16 : unsigned = "u16" {
    pub const __SIZE_OF: usize = 2

    pub static get MAX: self {
        return 0xFFFF
    }
    pub static get MIN: self {
        return 0
    }
}
exp global primitive u32 : unsigned = "u32" {
    pub const __SIZE_OF: usize = 4

    pub static get MAX: self {
        return 0xFFFFFFFF
    }
    pub static get MIN: self {
        return 0
    }
}
exp global primitive u64 : unsigned = "u64" {
    pub const __SIZE_OF: usize = 8

    pub static get MAX: self {
        return 0xFFFFFFFFFFFFFFFF
    }
    pub static get MIN: self {
        return 0
    }
}
exp global primitive u128 : unsigned = "u128" {
    pub const __SIZE_OF: usize = 16

    pub static get MAX: self {
        return 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
    }
    pub static get MIN: self {
        return 0
    }
}

#if WORD_64
exp global primitive usize : u64, unsigned = "usize"

#if !HAS_METADATA
exp global primitive uptr : u128, unsigned = "uptr"
#else
exp global primitive uptr : usize, unsigned = "uptr"
#endif

#elseif WORD_32
exp global primitive usize : u32, unsigned = "usize"

#if !HAS_METADATA
exp global primitive uptr : u64, unsigned = "uptr"
#else
exp global primitive uptr : usize, unsigned = "uptr"
#endif

#elseif WORD_16
exp global primitive usize : u16, unsigned = "usize"

#if !HAS_METADATA
exp global primitive uptr : u32, unsigned = "uptr"
#else
exp global primitive uptr : usize, unsigned = "uptr"
#endif

#else
exp global primitive usize : u8, unsigned = "usize"

#if !HAS_METADATA
exp global primitive uptr : u16, unsigned = "uptr"
#else
exp global primitive uptr : usize, unsigned = "uptr"
#endif

#endif
