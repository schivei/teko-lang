namespace teko

exp const IOTA: u8 = 0

exp global primitive u8 : unsigned {
    exp const __SIZE_OF: usize = TypeSizes::S8
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S8
    exp const __NAME: str = "u8"

    exp static get MAX: self {
        return 0xFF
    }
    exp static get MIN: self {
        return IOTA
    }
}

exp global primitive u16 : unsigned {
    exp const __SIZE_OF: usize = TypeSizes::S16
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S16
    exp const __NAME: str = "u16"

    exp static get MAX: self {
        return 0xFFFF
    }
    exp static get MIN: self {
        return IOTA
    }
}

exp global primitive u32 : unsigned {
    exp const __SIZE_OF: usize = TypeSizes::S32
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S32
    exp const __NAME: str = "u32"

    exp static get MAX: self {
        return 0xFFFFFFFF
    }
    exp static get MIN: self {
        return IOTA
    }
}

exp global primitive u64 : unsigned {
    exp const __SIZE_OF: usize = TypeSizes::S64
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S64
    exp const __NAME: str = "u64"

    exp static get MAX: self {
        return 0xFFFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return IOTA
    }
}

exp global primitive u128 : unsigned {
    exp const __SIZE_OF: usize = TypeSizes::S128
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S128
    exp const __NAME: str = "u128"

    exp static get MAX: self {
        return 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return IOTA
    }
}

exp global primitive byte : u8, unsigned {
    exp override const __NAME: str = "byte"
}

const USIZE_NAME: str = "usize"
const UPTR_NAME: str = "uptr"

#if WORD_64
exp global primitive usize : u64, unsigned {
    exp override const __NAME: str = USIZE_NAME
}

#if !HAS_METADATA
exp global primitive uptr : u128, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#endif

#elseif WORD_32
exp global primitive usize : u32, unsigned {
    exp override const __NAME: str = USIZE_NAME
}

#if !HAS_METADATA
exp global primitive uptr : u64, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#endif

#elseif WORD_16
exp global primitive usize : u16, unsigned {
    exp override const __NAME: str = USIZE_NAME
}

#if !HAS_METADATA
exp global primitive uptr : u32, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#endif

#else
exp global primitive usize : u8, unsigned {
    exp override const __NAME: str = USIZE_NAME
}

#if !HAS_METADATA
exp global primitive uptr : u16, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#else
exp global primitive uptr : usize, unsigned {
    exp override const __NAME: str = UPTR_NAME
}
#endif

#endif
