namespace teko

exp global primitive i8 : signed = "i8" {
    pub const __SIZE_OF: usize = 1

    pub static get MAX: self {
        return 0x7F
    }
    pub static get MIN: self {
        return -0x80
    }
}
exp global primitive i16 : signed = "i16" {
    pub const __SIZE_OF: usize = 2

    pub static get MAX: self {
        return 0x7FFF
    }
    pub static get MIN: self {
        return -0x8000
    }
}
exp global primitive i32 : signed = "i32" {
    pub const __SIZE_OF: usize = 4

    pub static get MAX: self {
        return 0x7FFFFFFF
    }
    pub static get MIN: self {
        return -0x80000000
    }
}
exp global primitive i64 : signed = "i64" {
    pub const __SIZE_OF: usize = 8

    pub static get MAX: self {
        return 0x7FFFFFFFFFFFFFFF
    }
    pub static get MIN: self {
        return -0x8000000000000000
    }
}
exp global primitive i128 : signed = "i128" {
    pub const __SIZE_OF: usize = 16

    pub static get MAX: self {
        return 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
    }
    pub static get MIN: self {
        return -0x80000000000000000000000000000000
    }
}
