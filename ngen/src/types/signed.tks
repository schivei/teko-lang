namespace teko

exp global primitive i8 : signed {
    exp const __SIZE_OF: usize = 1
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 1
    exp const __NAME: str = "i8"

    exp static get MAX: self {
        return 0x7F
    }
    exp static get MIN: self {
        return -0x80
    }
}
exp global primitive i16 : signed {
    exp const __SIZE_OF: usize = 2
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 2
    exp const __NAME: str = "i16"

    exp static get MAX: self {
        return 0x7FFF
    }
    exp static get MIN: self {
        return -0x8000
    }
}
exp global primitive i32 : signed {
    exp const __SIZE_OF: usize = 4
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 4
    exp const __NAME: str = "i32"

    exp static get MAX: self {
        return 0x7FFFFFFF
    }
    exp static get MIN: self {
        return -0x80000000
    }
}
exp global primitive i64 : signed {
    exp const __SIZE_OF: usize = 8
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 8
    exp const __NAME: str = "i64"

    exp static get MAX: self {
        return 0x7FFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return -0x8000000000000000
    }
}
exp global primitive i128 : signed {
    exp const __SIZE_OF: usize = 16
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 16
    exp const __NAME: str = "i128"

    exp static get MAX: self {
        return 0x7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
    }
    exp static get MIN: self {
        return -0x80000000000000000000000000000000
    }
}
