namespace teko

exp global type signed = interface number {}

exp global type i8 = struct signed {
    pub const __SIZE_OF: usize = 1

    pub static get MAX(): Self {
        return 0x7F
    }
    pub static get MIN(): Self {
        return -0x80
    }
}
exp global type i16 = struct signed {
    pub const __SIZE_OF: usize = 2

    pub static get MAX(): Self {
        return 0x7FFF
    }
    pub static get MIN(): Self {
        return -0x8000
    }
}
exp global type i32 = struct signed {
    pub const __SIZE_OF: usize = 4

    pub static get MAX(): Self {
        return 0x7FFFFFFF
    }
    pub static get MIN(): Self {
        return -0x80000000
    }
}
exp global type i64 = struct signed {
    pub const __SIZE_OF: usize = 8

    pub static get MAX(): Self {
        return 0x7FFFFFFFFFFFFFFF
    }
    pub static get MIN(): Self {
        return -0x8000000000000000
    }
}

#if WORD_64
exp global type isize = struct signed {
    pub const __SIZE_OF: usize = 8

    pub static get MAX(): Self {
        return i64::MAX
    }
    pub static get MIN(): Self {
        return i64::MIN
    }
}
#else
exp global type isize = struct signed {
    pub const __SIZE_OF: usize = 4

    pub static get MAX(): Self {
        return i32::MAX
    }
    pub static get MIN(): Self {
        return i32::MIN
    }
}
#endif

exp global type ptr = struct signed {
    pub const __SIZE_OF: usize = isize::__SIZE_OF

    pub static get MAX(): Self {
        return isize::MAX
    }
    pub static get MIN(): Self {
        return isize::MIN
    }
}
