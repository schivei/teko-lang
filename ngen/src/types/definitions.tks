namespace teko

pub global flags ValueKind {
    Value,
    Object,
    Array
} {
    pub fn has(kind: ValueKind) -> bool {
        return (self & kind) == kind
    }
}

pub global interface __type {
    const __SIZE_OF: usize
    const __V_KIND: ValueKind
}

pub global interface number : __type {
    static get MAX: Self
    static get MIN: Self
}

pub global interface integer : number {}
pub global interface signed : integer {}
pub global interface unsigned : integer {}
pub global interface floating : number {}
