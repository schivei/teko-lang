namespace teko

exp global flags ValueKind {
    Value,
    Object,
    Array
}

exp global struct TypeSizes {
    exp const S8: usize = 1
    exp const S16: usize = 2
    exp const S32: usize = 4
    exp const S64: usize = 8
    exp const S128: usize = 16
}

/**
 * The `__type` interface defines the basic properties that all types must have.
 *
 * If one type does not implement this interface, it will be injected in compile-time with AST transformations.
 */
exp global interface __type {
    const __SIZE_OF: usize
    const __V_KIND: ValueKind
    const __ALIGN_OF: usize
    const __NAME: str
}

exp global interface number : __type {
    static get MAX: self
    static get MIN: self
}

exp global interface boxed: __type {}

exp global interface integer : number {}
exp global interface signed : integer {}
exp global interface unsigned : integer {}
exp global interface floating : number {
    static get POS_INF: self
    static get NEG_INF: self
    static get NAN: self
    static get EPSILON: self
    static get POS_MIN: self
    static get NEG_MIN: self
}

exp global primitive bool : __type {
    exp const __SIZE_OF: usize = TypeSizes::S8
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = TypeSizes::S8
    exp const __NAME: str = "bool"

    exp static get TRUE: self {
        bitcast<u8, self>(0x01)
    }

    exp static get FALSE: self {
        bitcast<u8, self>(0x00)
    }

    exp static fn new<T: __type>(type: T): self {
        convert<T, self>(type)
    }
}
