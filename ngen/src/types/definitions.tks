namespace teko

exp global flags ValueKind {
    Value,
    Object,
    Array
}

exp global enum TypeSizes : usize {
    S8 = 1
    S16 = 2
    S32 = 4
    S64 = 8
    S128 = 16
}

/**
 * The `__type` interface defines the basic properties that all types must have.
 *
 * If one type does not implement this interface, it will be injected in compile-time with AST transformations.
 */
exp global interface __type {
    const __SIZE_OF: usize
    const __V_KIND: ValueKind
    const __ALIGN_OF: usize
    const __NAME: str
}

exp global interface number : __type {
    static get MAX: self
    static get MIN: self
}

exp global interface integer : number {}
exp global interface signed : integer {}
exp global interface unsigned : integer {}
exp global interface floating : number {
    static get POS_INF: self
    static get NEG_INF: self
    static get NAN: self
    static get EPSILON: self
    static get POS_MIN: self
    static get NEG_MIN: self
}
