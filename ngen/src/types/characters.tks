namespace teko

/**
 * A character type represented as a single byte (0-255).
 */
exp global primitive char : byte, __type = "char" {
    pub fn to_lowercase(): char {
        if self >= 'A' && self <= 'Z' {
            return self + 32
        }
        
        // for accented characters and other non-ASCII characters, return as is
        // TODO: Implement proper Unicode lowercase conversion for non-ASCII characters.
        self
    }
}
