namespace teko

/**
 * A character type represented as a single byte (0-255).
 */
exp global primitive char : byte, __type {
    exp const __SIZE_OF: usize = 1
    exp const __V_KIND: ValueKind = ValueKind::Value
    exp const __ALIGN_OF: usize = 1
    exp const __NAME: str = "char"

    exp fn to_lowercase(): char {
        if self >= 'A' && self <= 'Z' {
            return self + 32
        }
        
        return self
    }
}
