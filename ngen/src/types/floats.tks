namespace teko

exp global primitive f32 : floating {
    exp const __SIZE_OF: usize = 4
    exp const __V_KIND: ValueKind = .Value
    exp const __ALIGN_OF: usize = 4
    exp const __NAME: str = "f32"

    exp static get MAX: self {
        return bitcast<u32, f32>(0x7F7FFFFF)
    }
    exp static get MIN: self {
        return bitcast<u32, f32>(0xFF7FFFFF)
    }
    exp static get EPSILON: self {
        return bitcast<u32, f32>(0x34000000)
    }
    exp static get POS_INF: self {
        return bitcast<u32, f32>(0x7F800000)
    }
    exp static get NEG_INF: self {
        return bitcast<u32, f32>(0xFF800000)
    }
    exp static get NAN: self {
        return bitcast<u32, f32>(0x7FC00000)
    }
    exp static get POS_MIN: self {
        return bitcast<u32, f32>(0x00800000)
    }
    exp static get NEG_MIN: self {
        return bitcast<u32, f32>(0x80800000)
    }
}

exp global primitive f64 : floating = "f64" {
    exp const __SIZE_OF: usize = 8
    exp const __V_KIND: ValueKind = .Value
    exp const __ALIGN_OF: usize = 8
    exp const __NAME: str = "f64"

    exp static get MAX: self {
        return bitcast<u64, f64>(0x7FEFFFFFFFFFFFFF)
    }
    exp static get MIN: self {
        return bitcast<u64, f64>(0xFFEFFFFFFFFFFFFF)
    }
    exp static get EPSILON: self {
        return bitcast<u64, f64>(0x3CB0000000000000)
    }
    exp static get POS_INF: self {
        return bitcast<u64, f64>(0x7FF0000000000000)
    }
    exp static get NEG_INF: self {
        return bitcast<u64, f64>(0xFFF0000000000000)
    }
    exp static get NAN: self {
        return bitcast<u64, f64>(0x7FF8000000000000)
    }
    exp static get POS_MIN: self {
        return bitcast<u64, f64>(0x0010000000000000)
    }
    exp static get NEG_MIN: self {
        return bitcast<u64, f64>(0x8010000000000000)
    }
}
