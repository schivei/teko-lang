/**
 * @returns the size of the type `T` in bytes.
 */
exp global fn sizeof<T: __type>(_:T = zero()): usize {
    return T::__SIZE_OF
}

/**
 * @returns the alignment of the type `T` in bytes.
 */
exp global fn alignof<T: __type>(_:T = zero()): usize {
    return T::__ALIGN_OF
}

/**
 * @returns the name of the type `T` as a string.
 */
exp global fn nameof<T: __type>(_:T = zero()): str {
    return T::__NAME
}

/**
 * @returns the value of type `U` resulting from a bitcast of the value of type `T`.
 */
exp global extern fn bitcast<T: __type, U: __type>(value: T): U {
    if sizeof<T>() != sizeof<U>() {
        panic("bitcast: size of source and destination types must be equal");
    }

    IR {
        %r = BITCAST %0 to {nameof<U>()}
        return %r;
    }
}

/**
 * @returns a zero-initialized value of type `T`.
 */
exp global extern fn zero<T>(): T {
    IR {
        %r = ZERO {nameof<T>()}
        return %r;
    }
}
