/**
 * @returns the size of the type `T` in bytes.
 */
exp global fn sizeof<T: __type>(): usize {
    return T::__SIZE_OF
}

/**
 * @returns the alignment of the type `T` in bytes.
 */
exp global fn alignof<T: __type>(): usize {
    return T::__ALIGN_OF
}

/**
 * @returns the name of the type `T` as a string.
 */
exp global fn nameof<T: __type>(): str {
    return T::__NAME
}

/**
 * @returns the value of type `U` resulting from a bitcast of the value of type `T`.
 */
exp global ir bitcast<T: __type, U: __type>(value: T): U where T::__SIZE_OF == U::__SIZE_OF {
    %r = BITCAST %0 to {U::__NAME};
    return %r;
}

/**
 * @returns a zero-initialized value of type `T`.
 */
exp global ir zero<T: __type>(): T {
    %r = ZERO {T::__NAME};
    return %r;
}

/**
 * @returns the offset of the field `field` within the type `T` in bytes.
 */
exp global ir offset_of<T: __type, F: __type>(field: F): usize {
    %r = OFFSET_OF {T::__NAME}, {F::__NAME};
    return %r;
}

/**
 * @returns a copy of the value of type `T`.
 */
exp global ir copy<T: __type>(value: T): T {
    %r = COPY %0;
    return %r;
}

/**
 * @returns a cleared (zero-initialized) value of type `T` after dropping the original value.
 */
exp global ir clear<T: __type>(value: T): T {
    DROP %0;
    %r = ZERO {T::__NAME};
    return %r;
}

exp global ir convert<T: __type, U: __type>(value: T): U where T::__SIZE_OF == U::__SIZE_OF {
    %r = CONVERT %0 to {U::__NAME};
    return %r;
}
