exp global enum Encoding {
    ASCII,
    UTF8,
    UTF8_BOM,
    UTF16,
    UTF16_BOM,
    UTF32,
    UTF32_BOM,
    ISO_8859_1,
    ISO_8859_15,
    WINDOWS_1252
} {
    fn bom(): []byte {
        match self {
            self::UTF8_BOM => [0xEF, 0xBB, 0xBF],
            self::UTF16_BOM => [0xFF, 0xFE],
            self::UTF32_BOM => [0xFF, 0xFE, 0x00, 0x00],
            _ => []
        }
    }

    pub fn string(bytes: []byte): str {
        var bom = self.bom()
        var chars: [bytes.len - bom.len]char = []
        var i: usize = bom.len

        loop i < bytes.len {
            var ch, len = decode_char(bytes, i)
            chars[i - bom.len] = ch
            i += len
        }

        return str::new(chars, self)
    }

    pub fn bytes(s: str): []byte {
        var bom: []byte = self.bom()
        var result: [s.len * 4 + bom.len]byte = bom
        var i: usize = bom.len;
        loop c in s {
            var bc = self.bytes(c)

            if bc.len == 0 {
                continue
            }

            if bc.len == 1 {
                result[i] = bc[0] to byte
            }

            if bc.len == 2 {
                result[i] = bc[0] to byte
                result[i+1] = bc[1] to byte
            }

            if bc.len == 3 {
                result[i] = bc[0] to byte
                result[i+1] = bc[1] to byte
                result[i+2] = bc[2] to byte
            }

            if bc.len == 4 {
                result[i] = bc[0] to byte
                result[i+1] = bc[1] to byte
                result[i+2] = bc[2] to byte
                result[i+3] = bc[3] to byte
            }
            
            i += bc.len
        }

        return result[0..i]
    }

    fn decode_char(bytes: []byte, index: usize): (char, usize) {
        match self {
            self::UTF8 => decode_utf8_char(bytes, index),
            self::UTF8_BOM => decode_utf8_char(bytes, index),
            self::UTF16 => decode_utf16_char(bytes, index),
            self::UTF16_BOM => decode_utf16_char(bytes, index),
            self::UTF32 => decode_utf32_char(bytes, index),
            self::UTF32_BOM => decode_utf32_char(bytes, index),
            self::ISO_8859_1 => decode_iso_8859_1_char(bytes, index),
            self::ISO_8859_15 => decode_iso_8859_15_char(bytes, index),
            self::WINDOWS_1252 => decode_windows_1252_char(bytes, index),
            _ => decode_ascii_char(bytes, index)
        }
    }

    fn bytes(chr: char): []byte {
        if chr == 0 {
            return []
        }

        match self {
            self::UTF8 => utf8_bytes(chr),
            self::UTF16 => utf16_bytes(chr),
            self::UTF32 => utf32_bytes(chr),
            self::ISO_8859_1 => iso_8859_1_bytes(chr),
            self::ISO_8859_15 => iso_8859_15_bytes(chr),
            self::WINDOWS_1252 => windows_1252_bytes(chr),
            _ => ascii_bytes(chr)
        }
    }

    fn ascii_bytes(chr: char): []byte {
        if chr > 0x7F {
            var bytes: [4]byte = []
            var value = chr
            var i: usize = 0;
            loop value > 0 {
                bytes[i] = (value & 0x7F) to byte
                value >>= 7
                i++
            }
            return bytes[0..i]
        }

        return [(chr & 0x7F) to byte]
    }

    fn utf8_bytes(chr: char): []byte {
        if chr <= 0x7F {
            return [(chr & 0x7F) to byte]
        } else if chr <= 0x7FF {
            return [
                (0xC0 | ((chr >> 6) & 0x1F)) to byte,
                (0x80 | (chr & 0x3F)) to byte
            ]
        } else if chr <= 0xFFFF {
            return [
                (0xE0 | ((chr >> 12) & 0x0F)) to byte,
                (0x80 | ((chr >> 6) & 0x3F)) to byte,
                (0x80 | (chr & 0x3F)) to byte
            ]
        } else {
            return [
                (0xF0 | ((chr >> 18) & 0x07)) to byte,
                (0x80 | ((chr >> 12) & 0x3F)) to byte,
                (0x80 | ((chr >> 6) & 0x3F)) to byte,
                (0x80 | (chr & 0x3F)) to byte
            ]
        }
    }

    fn utf16_bytes(chr: char): []byte {
        return [
            (chr & 0xFF) to byte,
            ((chr >> 8) & 0xFF) to byte
        ]
    }

    fn utf32_bytes(chr: char): []byte {
        return [
            (chr & 0xFF) to byte,
            ((chr >> 8) & 0xFF) to byte,
            ((chr >> 16) & 0xFF) to byte,
            ((chr >> 24) & 0xFF) to byte
        ]
    }

    fn iso_8859_1_bytes(chr: char): []byte {
        return [(chr & 0xFF) to byte]
    }

    fn iso_8859_15_bytes(chr: char): []byte {
        return [(chr & 0xFF) to byte]
    }

    fn windows_1252_bytes(chr: char): []byte {
        return [(chr & 0xFF) to byte]
    }

    fn decode_utf8_char(bytes: []byte, index: usize): (char, usize) {
        var first_byte = bytes[index] to u8
        if first_byte <= 0x7F {
            return (first_byte to char, index + 1)
        } else if (first_byte & 0xE0) == 0xC0 {
            var second_byte = bytes[index + 1] to u8
            var char_value = ((first_byte & 0x1F) << 6) | (second_byte & 0x3F)
            return (char_value to char, index + 2)
        } else if (first_byte & 0xF0) == 0xE0 {
            var second_byte = bytes[index + 1] to u8
            var third_byte = bytes[index + 2] to u8
            var char_value = ((first_byte & 0x0F) << 12) | ((second_byte & 0x3F) << 6) | (third_byte & 0x3F)
            return (char_value to char, index + 3)
        } else if (first_byte & 0xF8) == 0xF0 {
            var second_byte = bytes[index + 1] to u8
            var third_byte = bytes[index + 2] to u8
            var fourth_byte = bytes[index + 3] to u8
            var char_value = ((first_byte & 0x07) << 18) | ((second_byte & 0x3F) << 12) | ((third_byte & 0x3F) << 6) | (fourth_byte & 0x3F)
            return (char_value to char, index + 4)
        } else {
            return (0xFFFD to char, index + 1)
        }
    }

    fn decode_utf16_char(bytes: []byte, index: usize): (char, usize) {
        var first_unit = (bytes[index] to u8) | ((bytes[index + 1] to u8) << 8)
        if first_unit >= 0xD800 && first_unit <= 0xDBFF {
            var second_unit = (bytes[index + 2] to u8) | ((bytes[index + 3] to u8) << 8)
            var char_value = 0x10000 + (((first_unit - 0xD800) << 10) | (second_unit - 0xDC00))
            return (char_value to char, index + 4)
        } else {
            return (first_unit to char, index + 2)
        }
    }

    fn decode_utf32_char(bytes: []byte, index: usize): (char, usize) {
        var char_value = (bytes[index] to u8) | ((bytes[index + 1] to u8) << 8) | ((bytes[index + 2] to u8) << 16) | ((bytes[index + 3] to u8) << 24)
        return (char_value to char, index + 4)
    }

    fn decode_ascii_char(bytes: []byte, index: usize): (char, usize) {
        var char_value = bytes[index] to u8
        return (char_value to char, index + 1)
    }

    fn decode_iso_8859_1_char(bytes: []byte, index: usize): (char, usize) {
        var char_value = bytes[index] to u8
        return (char_value to char, index + 1)
    }

    fn decode_iso_8859_15_char(bytes: []byte, index: usize): (char, usize) {
        var char_value = bytes[index] to u8
        return (char_value to char, index + 1)
    }

    fn decode_windows_1252_char(bytes: []byte, index: usize): (char, usize) {
        var char_value = bytes[index] to u8
        return (char_value to char, index + 1)
    }
}