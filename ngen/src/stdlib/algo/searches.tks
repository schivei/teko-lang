use teko::stdlib::math
use teko::stdlib::collections

exp fn linear_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var i: usize = 0
    loop i < arr.len {
        if arr[i] == target {
            return (true, i)
        }
        i = i + 1
    }
    (false, 0)
}

exp fn binary_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var low: usize = 0
    var high: usize = arr.len - 1
    loop low <= high {
        var mid: usize = (low + high) / 2
        if arr[mid] == target {
            return (true, mid)
        } else if arr[mid] < target {
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    (false, 0)
}

exp fn ternary_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var low: usize = 0
    var high: usize = arr.len - 1
    loop low <= high {
        var third: usize = (high - low) / 3
        var mid1: usize = low + third
        var mid2: usize = high - third
        if arr[mid1] == target {
            return (true, mid1)
        } else if arr[mid2] == target {
            return (true, mid2)
        } else if target < arr[mid1] {
            high = mid1 - 1
        } else if target > arr[mid2] {
            low = mid2 + 1
        } else {
            low = mid1 + 1
            high = mid2 - 1
        }
    }
    (false, 0)
}

exp fn jump_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var n: usize = arr.len
    var step: usize = 1
    loop step * step < n {
        step = step + 1
    }
    var prev: usize = 0
    loop arr[min(step, n) - 1] < target {
        prev = step
        step = step + 1
        if prev >= n {
            return (false, 0)
        }
    }
    loop prev < min(step, n) {
        if arr[prev] == target {
            return (true, prev)
        }
        prev = prev + 1
    }
    (false, 0)
}

exp fn interpolation_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var low: usize = 0
    var high: usize = arr.len - 1
    loop low <= high && target >= arr[low] && target <= arr[high] {
        if low == high {
            if arr[low] == target {
                return (true, low)
            }
            return (false, 0)
        }
        var pos: usize = low + ((target - arr[low]) * (high - low)) / (arr[high] - arr[low])
        if arr[pos] == target {
            return (true, pos)
        } else if arr[pos] < target {
            low = pos + 1
        } else {
            high = pos - 1
        }
    }
    (false, 0)
}

exp fn fibonacci_search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var n: usize = arr.len
    var fibMMm2: usize = 0
    var fibMMm1: usize = 1
    var fibM: usize = fibMMm2 + fibMMm1
    loop fibM < n {
        fibMMm2 = fibMMm1
        fibMMm1 = fibM
        fibM = fibMMm2 + fibMMm1
    }
    var offset: isize = -1
    loop fibM > 1 {
        var i: usize = min(offset + fibMMm2, n - 1)
        if arr[i] < target {
            fibM = fibMMm1
            fibMMm1 = fibMMm2
            fibMMm2 = fibM - fibMMm1
            offset = i
        } else if arr[i] > target {
            fibM = fibMMm2
            fibMMm1 = fibMMm1 - fibMMm2
            fibMMm2 = fibM - fibMMm1
        } else {
            return (true, i)
        }
    }
    if fibMMm1 == 1 && offset + 1 < n && arr[offset + 1] == target {
        return (true, offset + 1)
    }
    (false, 0)
}

exp fn search<T: __type>(arr: Collection<T>, target: T): (bool, usize) {
    var len: usize = arr.len
    if len == 0 {
        return (false, 0)
    }
    
    if len <= u8::MAX {
        return linear_search(arr, target)
    }

    if arr is SortedCollection<T> {
        return binary_search(arr, target)
    }

    linear_search(arr, target)
}
