/**
 * Class representing an iterator for a collection.
 *
 * @template T The type of the elements returned by the iterator.
 */
exp class Iterator<T> {
    _initialized: bool
    _current: usize
    _collection: Collection<T>

    exp fn new(collection: Collection<T>): self {
        .{ _initialized = false, _current = 0, _collection = collection }
    }

    /**
     * Checks if the iterator has more elements.
     *
     * @return `true` if the iterator has more elements, `false` otherwise.
     */
    exp fn has_next(): bool {
        if _collection.len == 0 {
            return false
        }

        if !_initialized {
            _initialized = true
        }

        _collection.len > _current
    }

    /**
     * Returns the next element in the iteration.
     *
     * @return The next element in the iteration.
     */
    exp fn next(): T {
        if !self.has_next() {
            panic("No more elements in the iterator")
        }

        if !_initialized {
            _initialized = true
        } else {
            _current++
        }

        _collection.get_at(_current)
    }
    
    /**
     * Returns the next element in the iteration without advancing the iterator.
     *
     * @return The next element in the iteration.
     */
    exp fn peek(): T {
        _collection.get_at(_current)
    }
    
    /**
     * Resets the iterator to the initial position.
     */
    exp fn reset() {
        _current = 0
        _initialized = false
    }
}