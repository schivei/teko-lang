/**
 * Interface for collection types that can be indexed and iterated over.
 *
 * Provides methods for accessing elements by index and iterating through the collection.
 */
exp interface Collection<T> : Indexer<usize, T> {
    /**
     * Returns the number of elements in the collection.
     *
     * @return The length of the collection.
     */
    get len: usize

    /**
     * Checks if the array contains the specified element.
     *
     * @param sub The element to search for.
     * @return `true` if the element is found, `false` otherwise.
     */
    fn contains(sub: T): bool

    /**
     * Returns an iterator for the collection.
     *
     * @return An iterator for the collection.
     */
    fn iterator(): Iterator<T> {
        Iterator<T>.new(self)
    }
}
