/**
 * Interface representing an indexer for a collection.
 *
 * @template TKey The type of the index key.
 * @template TValue The type of the value.
 */
exp type Indexer<TKey, TValue> = interface {
    /**
     * Gets the element at the specified index.
     *
     * Desugared form: `collection[index]`
     *
     * @param index The index of the element to retrieve.
     * @return The element at the specified index.
     */
    pub fn get_at(index: TKey): TValue

    /**
     * Sets the element at the specified index.
     *
     * Desugared form: `collection[index] = value`
     *
     * @param index The index of the element to set.
     * @param value The value to set at the specified index.
     */
    pub fn set_at(index: TKey, value: TValue)
}
