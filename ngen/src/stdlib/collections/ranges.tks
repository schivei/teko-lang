/**
 * Interface representing a range of values.
 *
 * @template T The type of the start and end values of the range.
 */
exp interface Range<T> {
    /**
     * Returns a slice of the range starting at the specified index with the specified length.
     *
     * Desugared form of slicing the range using the start index and length `[start..count]`.
     *
     * @param start The starting index of the slice.
     * @param count The length of the slice.
     * @return A new range representing the specified slice.
     */
    fn slice(start: usize, count: usize): self
}
