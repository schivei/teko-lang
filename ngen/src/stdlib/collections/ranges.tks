/**
 * Interface representing a range of values.
 *
 * @template T The type of the start and end values of the range.
 */
exp interface Range<T> {
    /**
     * Returns the start value of the range.
     *
     * @return The start value of the range.
     */
    fn start(): T
    
    /**
     * Returns the end value of the range.
     *
     * @return The end value of the range.
     */
    fn end(): T
}
