exp struct Slice<T: __type> : Collection<T> {
    _ptr: uptr
    _len: usize

    exp get len: usize {
        return self._len
    }

    exp static fn new<T: __type>(collection: Collection<T>): self {
        return .{
            _ptr: uptr::unwrap(collection),
            _len: collection.len
        }
    }

    exp static fn new<T: __type>(collection: Collection<T>, start: usize, count: usize): self {
        return .{
            _ptr: T::__SIZE_OF * start + uptr::unwrap(collection),
            _len: count
        }
    }

    exp fn to_array<const N: usize>(): [N]T {
        var arr: [N]T = zero()
        loop i in 0..N {
            arr[i] = get_at(i)
        }
        return arr
    }

    exp arena fn get_at(index: usize): T {
        return @slot.load<T>(self._ptr + index * T::__SIZE_OF)
    }

    exp arena fn set_at(index: usize, value: T) {
        @slot.store<T>(self._ptr + index * T::__SIZE_OF, value)
    }
}