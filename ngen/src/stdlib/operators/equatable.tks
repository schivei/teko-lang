exp global Equatable = interface {
    /**
     * Checks if the current instance is equal to another instance.
     * 
     * Desugared form of the equality operator `==`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is equal to the other instance, `false` otherwise.
     */
    fn equal(other: self): bool;

    /**
     * Checks if the current instance is not equal to another instance.
     * 
     * Desugared form of the inequality operator `!=`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is not equal to the other instance, `false` otherwise.
     */
    fn not_equal(other: self): bool;

    /**
     * Compares the current instance with another instance.
     * 
     * Desugared form of the comparison operator `<=>`.
     *
     * @param other The instance to compare with.
     * @return A negative integer if the current instance is less than the other instance, zero if they are equal, and a positive integer if the current instance is greater than the other instance.
     */
    fn compare(other: self): i32;

    /**
     * Checks if the current instance is less than another instance.
     * 
     * Desugared form of the less-than operator `<`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is less than the other instance, `false` otherwise.
     */
    fn less_than(other: self): bool;

    /**
     * Checks if the current instance is less than or equal to another instance.
     * 
     * Desugared form of the less-than-or-equal-to operator `<=`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is less than or equal to the other instance, `false` otherwise.
     */
    fn less_than_or_equal(other: self): bool;

    /**
     * Checks if the current instance is greater than another instance.
     * 
     * Desugared form of the greater-than operator `>`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is greater than the other instance, `false` otherwise.
     */
    fn greater_than(other: self): bool;

    /**
     * Checks if the current instance is greater than or equal to another instance.
     * 
     * Desugared form of the greater-than-or-equal-to operator `>=`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is greater than or equal to the other instance, `false` otherwise.
     */
    fn greater_than_or_equal(other: self): bool;

    /**
     * Checks if the current instance is between two other instances.
     * 
     * Desugared form of the between operator.
     *
     * @param lower The lower bound instance.
     * @param upper The upper bound instance.
     * @return `true` if the current instance is between the lower and upper instances, `false` otherwise.
     */
    fn between(lower: self, upper: self): bool;
}