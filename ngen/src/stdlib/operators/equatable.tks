/**
 * Interface for types that can be checked for equality.
 * 
 * Provides methods for checking equality and inequality between instances of the type.
 */
exp interface Equatable {
    /**
     * Checks if the current instance is equal to another instance.
     * 
     * Desugared form of the equality operator `==`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is equal to the other instance, `false` otherwise.
     */
    fn equal(other: self): bool;

    /**
     * Checks if the current instance is not equal to another instance.
     * 
     * Desugared form of the inequality operator `!=`.
     *
     * @param other The instance to compare with.
     * @return `true` if the current instance is not equal to the other instance, `false` otherwise.
     */
    fn not_equal(other: self): bool;
}