exp interface BitAnd {
    /**
     * Performs a bitwise AND operation between the current instance and another instance.
     *
     * Desugared form of the bitwise AND operator `&`.
     *
     * @param other The instance to perform the bitwise AND operation with.
     * @return A new instance resulting from the bitwise AND operation.
     */
    fn bitwise_and(other: self): self;
}

exp interface BitOr {
    /**
     * Performs a bitwise OR operation between the current instance and another instance.
     *
     * Desugared form of the bitwise OR operator `|`.
     *
     * @param other The instance to perform the bitwise OR operation with.
     * @return A new instance resulting from the bitwise OR operation.
     */
    fn bitwise_or(other: self): self;
}

exp interface BitXor {
    /**
     * Performs a bitwise XOR operation between the current instance and another instance.
     *
     * Desugared form of the bitwise XOR operator `^`.
     *
     * @param other The instance to perform the bitwise XOR operation with.
     * @return A new instance resulting from the bitwise XOR operation.
     */
    fn bitwise_xor(other: self): self;
}

exp interface BitNot {
    /**
     * Performs a bitwise NOT operation on the current instance.
     *
     * Desugared form of the bitwise NOT operator `~`.
     *
     * @return A new instance resulting from the bitwise NOT operation.
     */
    fn bitwise_not(): self;
}

exp global ir operator_bitwise_and(lhs: __type, rhs: __type) {
    %r = BAND %0, %1
}
exp global ir operator_bitwise_or(lhs: __type, rhs: __type) {
    %r = BOR %0, %1
}
exp global ir operator_bitwise_xor(lhs: __type, rhs: __type) {
    %r = BXOR %0, %1
}
exp global ir operator_bitwise_not(lhs: __type) {
    %r = BNOT %0
}
