/**
 * An interface for types that can be converted from one type to another.
 *
 * @tparam T The target type.
 */
exp interface Convertible<T: __type> {
    /**
     * Converts a value from the source type to the target type.
     *
     * Desugared implicit conversion from the source type to the target type.
     *
     * @param value The value to convert.
     * @return The converted value.
     */
    fn convert(): T
}
