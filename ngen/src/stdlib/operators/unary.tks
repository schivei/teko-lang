exp interface Unary {
    /**
     * Performs a unary negation operation on the current instance.
     *
     * Desugared form of the unary negation operator `-`.
     *
     * @return A new instance resulting from the unary negation operation.
     */
    fn unary_negation(): self;

    /**
     * Performs a unary plus operation on the current instance.
     *
     * Desugared form of the unary plus operator `+`.
     *
     * @return A new instance resulting from the unary plus operation.
     */
    fn unary_plus(): self;

    /**
     * Performs a logical NOT operation on the current instance.
     *
     * Desugared form of the logical NOT operator `!`.
     *
     * @return A new instance resulting from the logical NOT operation.
     */
    fn logical_not(): self;
}

exp global ir operator_unary_negation(operand: __type) {
    %r = NEG %0
}
exp global ir operator_unary_plus(operand: __type) {
    %r = ADD %0, 0
}
exp global ir operator_logical_not(operand: __type) {
    %r = NOT %0
}