/**
 * The Adder interface defines a contract for types that support addition operations.
 * It provides a method for adding two instances of the type together.
 */
exp interface Adder {
    /**
     * Performs an addition operation between the current instance and another instance.
     *
     * Desugared form of the addition operator `+`.
     *
     * @param other The instance to perform the addition operation with.
     * @return A new instance resulting from the addition operation.
     */
    fn add(other: self): self;
}

/**
 * The Subtracter interface defines a contract for types that support subtraction operations.
 * It provides a method for subtracting one instance of the type from another.
 */
exp interface Subtracter {
    /**
     * Performs a subtraction operation between the current instance and another instance.
     *
     * Desugared form of the subtraction operator `-`.
     *
     * @param other The instance to perform the subtraction operation with.
     * @return A new instance resulting from the subtraction operation.
     */
    fn subtract(other: self): self;
}

/**
 * The Multiplier interface defines a contract for types that support multiplication operations.
 * It provides a method for multiplying two instances of the type together.
 */
exp interface Multiplier {
    /**
     * Performs a multiplication operation between the current instance and another instance.
     *
     * Desugared form of the multiplication operator `*`.
     *
     * @param other The instance to perform the multiplication operation with.
     * @return A new instance resulting from the multiplication operation.
     */
    fn multiply(other: self): self;
}

/**
 * The Divider interface defines a contract for types that support division operations.
 * It provides a method for dividing one instance of the type by another.
 */
exp interface Divider {
    /**
     * Performs a division operation between the current instance and another instance.
     *
     * Desugared form of the division operator `/`.
     *
     * @param other The instance to perform the division operation with.
     * @return A new instance resulting from the division operation.
     */
    fn divide(other: self): self;
}

/**
 * The Moduler interface defines a contract for types that support modulo operations.
 * It provides a method for performing the modulo operation between two instances of the type.
 */
exp interface Moduler {
    /**
     * Performs a modulo operation between the current instance and another instance.
     *
     * Desugared form of the modulo operator `%`.
     *
     * @param other The instance to perform the modulo operation with.
     * @return A new instance resulting from the modulo operation.
     */
    fn modulo(other: self): self;
}

/**
 * The Exponentiator interface defines a contract for types that support exponentiation operations.
 * It provides a method for performing the exponentiation operation between two instances of the type.
 */
exp interface Exponentiator {
    /**
     * Performs an exponentiation operation between the current instance and another instance.
     *
     * Desugared form of the exponentiation operator `**`.
     *
     * @param other The instance to perform the exponentiation operation with.
     * @return A new instance resulting from the exponentiation operation.
     */
    fn exponentiate(other: self): self;
}
