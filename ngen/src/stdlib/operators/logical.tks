exp global interface Logical {
    fn and(other: self): bool {
        operator_log_and(self, other)
    }

    fn or(other: self): bool {
        operator_log_or(self, other)
    }
}

exp global ir operator_log_and(lhs: __type, rhs: __type) {
    %r = AND %0, %1
}
exp global ir operator_log_or(lhs: __type, rhs: __type) {
    %r = OR %0, %1
}