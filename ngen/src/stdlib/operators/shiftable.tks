/**
 * Interface for types that support bitwise shift operations.
 * 
 * Provides methods for shifting the bits of an instance to the left or right by a specified amount.
 */
exp interface Shiftable {
    /**
     * Shifts the bits of the current instance to the left by the specified amount.
     *
     * Desugared form of the left shift operator `<<`.
     *
     * @param amount The number of positions to shift the bits to the left.
     * @return A new instance with the bits shifted to the left.
     */
    fn shift_left(amount: self): self {
        operator_shift_left(self, amount)
    }

    /**
     * Shifts the bits of the current instance to the right by the specified amount.
     *
     * Desugared form of the right shift operator `>>`.
     *
     * @param amount The number of positions to shift the bits to the right.
     * @return A new instance with the bits shifted to the right.
     */
    fn shift_right(amount: self): self {
        operator_shift_right(self, amount)
    }
}

exp global ir operator_shift_left(lhs: __type, rhs: __type) {
    %r = SHL %0, %1
}
exp global ir operator_shift_right(lhs: __type, rhs: __type) {
    %r = SHR %0, %1
}