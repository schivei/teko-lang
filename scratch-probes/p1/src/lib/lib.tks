exp type Shape = interface { fn area(): i64 }
exp type Circle = class & Shape {
    pub r: i64
    pub static fn make(x: i64): Circle { .{ r = x } }
    pub fn area(): i64 { self.r }
}
exp type Square = class & Shape {
    pub s: i64
    pub static fn make(x: i64): Square { .{ s = x } }
    pub fn area(): i64 { self.s }
}
exp fn mk_circle(x: i64): Shape { Circle::make(x) }
exp fn mk_square(x: i64): Shape { Square::make(x) }
exp fn pick(sh: Shape): i64 { match sh { Circle as c => c.r; Square as sq => sq.s; _ => 0 } }
