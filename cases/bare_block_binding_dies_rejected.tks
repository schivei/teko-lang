/**
 * reads_dead_block_binding — REJECTED (0.3.1 §6): a binding declared inside a bare `{ … }` block is
 * scoped to that block and dies at its closing brace, so it is NOT visible afterwards. Reading `y`
 * after the block must fail the checker with `undefined name: y`, proving the scope boundary the
 * block introduces.
 *
 * @return never — REJECTED by the checker (the name is out of scope after the block)
 */
fn reads_dead_block_binding(): i64 {
    { var y = 1 }
