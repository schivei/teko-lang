/**
 * text_byteview_roundtrip_probe — regression for the two 0.3.1.0 BYTE-VIEW escape hatches
 * `teko::text::bytes_of_str`/`teko::text::str_from_utf8` (`scope.tks`'s doc-comment: moved off
 * `teko::str::`, which stays home to the character/codepoint surface). A MULTI-BYTE string — an
 * accented letter (2-byte) PLUS an emoji (4-byte) — so a length/boundary bug cannot hide behind an
 * all-ASCII fixture: this is exactly the shape these two functions exist for (B.36).
 *
 * @return 0 on success; a distinct non-zero code names which half diverged
 */
fn text_byteview_roundtrip_probe(): i32 {
    var s: str = "café🐝"
    var bs: []byte = teko::text::bytes_of_str(s)
    if bs.len != 9 { return 1 }   // c-a-f-é(2)-🐝(4) = 1+1+1+2+4 = 9 bytes
    var s2: str | error = teko::text::str_from_utf8(bs)
    match s2 {
        str as r => { if r != s { return 2 } }
        error => return 3
    }
    0
}

exit(text_byteview_roundtrip_probe())
