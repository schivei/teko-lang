/**
 * AliasFieldS — an alias of `str`: the 0.3.1.0 raiz-A crumb-R0 regression
 * (`docs/memory/raiz-comum-dos-degraus-0.3.1.0.md` §7-quater.3-bis). Before R0,
 * `typeexpr_is_fat` (the layout predicate) asked the ANNOTATION `AliasFieldS` — a `NamedType`
 * matching neither its `[]T` nor its bare-`str` arm — while `is_fat_type` (the store predicate)
 * asked the field VALUE's RESOLVED type, always `str`: two answers for the layout of the SAME
 * field.
 */
type AliasFieldS = str

/**
 * AliasFieldH — the struct the regression is measured on: the aliased field FIRST, a plain `i32`
 * sibling SECOND — exactly the byte range `field_layout_size`'s 8-vs-16-byte disagreement let the
 * fat field's length half spill into.
 */
type AliasFieldH = struct { s: AliasFieldS; n: i32 }

/**
 * alias_field_probe — build `AliasFieldH` with a 5-byte string and `n = 41` (a value distinct
 * from the string's length, so the two halves can never be mistaken for each other), then assert
 * every half reads back correctly.
 *
 * @return 0 on success; a distinct non-zero code names which half diverged
 */
fn alias_field_probe(): i32 {
    var h = AliasFieldH { s = "abcde"; n = 41 }
    if h.n != 41 { return 1 }
    if h.s.len != 5 { return 2 }
    if h.s != "abcde" { return 3 }
    0
}

exit(alias_field_probe())
