use teko::str as tstr

/**
 * join_via_alias — 0.3.1.0 builtin-qualifier validation: a `use`-declared ALIAS
 * (`use teko::str as tstr`) does NOT make a builtin callable under its aliased short name — `use`
 * is a checker no-op for value-level (call) references today (`UseDecl` is passed through
 * verbatim in `src/checker/typer.tks`'s item pass), so `tstr::concat(...)` carries a qualifier
 * `builtin_qualifier_ok` rejects exactly like an entirely invented one. Teaching `use` to resolve
 * a builtin under an alias is a separate, larger increment — deliberately out of scope here
 * (docs/memory/colisao-use-str-0.3.1.md).
 *
 * @return never — REJECTED by the checker before codegen ever runs
 */
fn join_via_alias() -> str {
    tstr::concat("a", "b")
}

join_via_alias()
