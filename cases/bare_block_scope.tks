/**
 * compute — proves a bare `{ }` block opens a lexical scope (0.3.1 §6, the region-as-scope
 * replacement for the retired manual `Arena`). The inner `y` lives ONLY inside the block, while
 * the outer `var x`, written from inside the block, survives the block's exit — so the value read
 * back after the closing brace is `1 + 2`. This is the owner's canonical §6 repro.
 *
 * @return 3 — the outer `x` (1) plus the block-local `y` (2), read after the block's region drops
 */
fn compute(): i64 {
    var x = 1
    { var y = 2; x = x + y }
    x
}

exit(compute() to i32)
