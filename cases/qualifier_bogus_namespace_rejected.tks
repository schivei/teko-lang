/**
 * qualifier_bogus_namespace_rejected — 0.3.1.0 builtin-qualifier validation
 * (docs/memory/colisao-use-str-0.3.1.md §7). A call through an INVENTED namespace
 * (`bogus_namespace::str`, never declared by any `use` or module) used to type-check with NO
 * diagnostic at all — `builtin_fn` (`src/checker/scope.tks`) matches a call by its LAST path
 * segment only, discarding everything before it — and only failed later, by accident, at
 * `cc`/`ld`, because the generated call had no real C symbol to bind. The SAME dispatch mechanism
 * resolves the 495+ product call sites spelled `teko::str::concat(...)`, so a silent qualifier is
 * not a corner case — it is the exact mechanism the whole corpus leans on. `builtin_qualifier_ok`
 * now gates every builtin match: only a bare callee or one rooted at `teko::` may resolve.
 *
 * @return never — REJECTED by the checker before codegen ever runs
 */
fn read_bogus_bytes(): str {
    var b: []byte = [b'h', b'i']
    bogus_namespace::str(b)
}

read_bogus_bytes()
