type cls = class {
    pub name: str

    pub fn new(name: str) -> cls {
        cls { name = name }
    }
}

fn func0(a: i32, b: u64) -> cls {
    cls::new($"{a}-${b}")
}

fn func1(ref c: cls) {
    c.name = c.name ~ "."
}

fn func2() -> i64 {
    let a: i32 = 100
    mut b: u64 = 0
    mut cc: cls = cls::new("start")

    loop mut i in 0..10 {
        if i % 2 == 0 {
            let c = func0(a, b * 1)
            b++
            cc = c
        } else {
            cc.name = cc.name ~ $"{i}"
        }
    }

    if cc.name != "100-49" { return 1 }
    func1(cc)
    if cc.name != "100-49." { return 2 }
    0
}

exit(func2())
