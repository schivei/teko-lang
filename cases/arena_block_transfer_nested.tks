/**
 * cls — a heap class value whose `name` is accumulated across nested scopes and then mutated
 * through a `ref` parameter; the subject whose survival across branch-to-outer transfer this
 * fixture pins.
 */
type cls = class {
    /** the accumulated name string, built in-loop and appended through a `ref` afterwards. */
    pub name: str

    /**
     * new — construct a `cls` holding an initial name.
     *
     * @param name  the initial name string
     * @return      the constructed class value
     */
    pub fn new(name: str): cls {
        cls { name = name }
    }
}

/**
 * func0 — build a fresh `cls` inside the loop's even branch, formatting its name from the fixed
 * hundreds component and the running counter.
 *
 * @param a  the fixed hundreds component
 * @param b  the running counter that advances every even iteration
 * @return   a new `cls` named `"{a}-{b}"`
 */
fn func0(a: i32, b: u64): cls {
    cls::new($"{a}-{b}")
}

/**
 * func1 — append a terminator to the carried value THROUGH a `ref`, proving the post-loop mutation
 * reaches the very object the loop transferred into the outer binding.
 *
 * @param c  the class value to mutate in place
 */
fn func1(ref c: cls) {
    c.name = c.name ~ "."
}

/**
 * build_name — create a class value in a nested if-branch inside a range loop, transfer it into an
 * outer binding, mutate it in the odd branch, then append through a `ref` after the loop. The
 * returned string ("100-49.") can only arise if BOTH the branch-to-outer transfer and the
 * ref-mutation across nested scopes held.
 *
 * @return the accumulated name after transfer and ref-mutation
 */
fn build_name(): str {
    var a: i32 = 100
    var b: u64 = 0
    var cc: cls = cls::new("start")

    loop var i in 0..10 {
        if i % 2 == 0 {
            var c = func0(a, b * 1)
            b++
            cc = c
        } else {
            cc.name = cc.name ~ $"{i}"
        }
    }

    func1(cc)
    cc.name
}

println(build_name())
