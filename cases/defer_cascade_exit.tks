/**
 * cascade_exit — the owner's four-level nested-scope defer cascade (function, loop body,
 * `match` arm, `if` body — 2026-07-29), exited by an unqualified `exit`: its own ARGUMENT is
 * evaluated AFTER all four levels replay (the W15/#defer-nas-saidas fix's ordering), so the
 * reported exit code is itself the LIFO proof — the SAME total as the `return` cascade.
 *
 * @return never — the process exits with 20203 (`& 0xFF` on the OS exit-code byte)
 */
fn cascade_exit() -> i64 {
    mut acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    exit((acc) to i32)
                }
            }
            _ => { }
        }
    }
    return acc
}

cascade_exit()
eprintln("unreachable: cascade_exit always exits")
