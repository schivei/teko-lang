/**
 * cascade_panic — the owner's four-level nested-scope defer cascade (function, loop body,
 * `match` arm, `if` body — 2026-07-29), exited by an unqualified `panic`: before W15/
 * #defer-nas-saidas `panic` was a CALL, not a keyword, so none of the ten pre-existing
 * `replay_defers` sites ever fired it. `eprintln` (stderr, unbuffered) marks each level — a
 * `println` probe would lie, `abort()` never flushes a buffered stream.
 */
fn cascade_panic() {
    defer { eprintln("L1") }
    loop {
        defer { eprintln("L2") }
        match 1 {
            1 => {
                defer { eprintln("L3") }
                if true {
                    defer { eprintln("L4") }
                    panic("defer_cascade_panic")
                }
            }
            _ => { }
        }
    }
}

cascade_panic()
