/**
 * uses_block_as_value — REJECTED (0.3.1 §6, form A only): a bare `{ … }` is a STATEMENT that opens
 * a lexical scope, never a value-producing block-expression (form B). Using it in expression
 * position (`var r = { 1 }`) must still fail to parse — the parser reaches the `{` where it expects
 * an expression and reports `expected an expression`, exactly as before the statement form landed.
 *
 * @return never — REJECTED at parse time before the checker ever runs
 */
fn uses_block_as_value(): i64 {
    var r = { 1 }
    r
}

exit(uses_block_as_value() to i32)
