/**
 * cascade_return — four `defer` levels deep (function, loop body, `match` arm, `if` body — the
 * owner's own nested-cascade ask, 2026-07-29), exited by `return`: every level fires, LIFO.
 * `+10000` (if) then `+100` (arm) then `*2` (loop) then `+1` (fn) = `((1+10000)+100)*2+1`.
 *
 * @return 20203
 */
fn cascade_return(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    return acc
                }
            }
            _ => { }
        }
    }
    return acc
}

/**
 * cascade_break — the SAME cascade, exited by `break`: fires the if/arm/loop levels
 * immediately, leaving the function level to fire at the explicit `return` after the loop — the
 * SAME total, split across two firing sites.
 *
 * @return 20203
 */
fn cascade_break(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        match 1 {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    break
                }
            }
            _ => { }
        }
    }
    return acc
}

/**
 * cascade_continue — the SAME cascade, TWO iterations: the first ends in `continue` (fires
 * if/arm/loop, NOT the function level — the function has not exited); the second ends in
 * `break` (fires if/arm/loop again); the explicit `return` after the loop fires the function
 * level exactly ONCE.
 *
 * @return 60605
 */
fn cascade_continue(): i64 {
    var acc: i64 = 1
    var n = 0
    defer { acc = acc + 1 }
    loop {
        defer { acc = acc * 2 }
        n = n + 1
        match n {
            1 => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    continue
                }
            }
            _ => {
                defer { acc = acc + 100 }
                if true {
                    defer { acc = acc + 10000 }
                    break
                }
            }
        }
    }
    return acc
}

/**
 * double_defer_same_scope_lifo — TWO `defer` in the SAME block fire in REVERSE declaration
 * order: `*10` (declared second, fires first) then `+1` (declared first, fires second) —
 * `(1*10)+1`, distinguishable from the declaration-order result `(1+1)*10 = 20`.
 *
 * @return 11
 */
fn double_defer_same_scope_lifo(): i64 {
    var acc: i64 = 1
    defer { acc = acc + 1 }
    defer { acc = acc * 10 }
    return acc
}

var bad = 0
if cascade_return() != 20203 { if bad == 0 { bad = 1 } }
if cascade_break() != 20203 { if bad == 0 { bad = 2 } }
if cascade_continue() != 60605 { if bad == 0 { bad = 3 } }
if double_defer_same_scope_lifo() != 11 { if bad == 0 { bad = 4 } }
exit(bad)
